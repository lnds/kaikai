# A closure specialisation pastes `[n, n]` with its argument substituted at
# both reads. An Int outside the immediate range is a heap box, so each copy
# must take its own reference.

fn dup_int(n: Int) : [Int] = [n, n]

fn rounds(i: Int, total: Int) : Int =
  if i == 0 {
    total
  } else {
    let big = 4611686018427387904 + i
    let xs = list.flat_map([big, big + 1], dup_int)
    let ys = list.flat_map([big + 2], n => [n, n, n])
    rounds(i - 1, total + list_length(xs) + list_length(ys))
  }

fn main() : Unit / Stdout {
  let big = 4611686018427387904 + 1
  Stdout.print("#{list_length(list.flat_map([big], dup_int))}")
  Stdout.print("#{rounds(50, 0)}")
}
