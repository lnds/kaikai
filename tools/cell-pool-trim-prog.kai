# Several workers each build and drop a large working set of 48-byte cells
# (records, no lists), round after round, idling in between.
# tools/cell-pool-trim-gate.sh counts the cells each idle gives back.

import spawn
import time

type Pt = { a: Int, b: Int }

fn fill(arr: Array[Pt], i: Int, n: Int) : Unit / Mutable =
  if i < n {
    arr[i] := Pt { a: i, b: i + 1 }
    fill(arr, i + 1, n)
  }

fn churn(n: Int) : Int = {
  let arr = array_make(n, Pt { a: 0, b: 0 })
  fill(arr, 0, n)
  arr[n - 1].b
}

fn peak() : Int / Spawn = {
  nursery { n ->
    let fs = [1..2] | (i => n.spawn(() => churn(600000 + i)))
    fs | (f => n.await(f)) |> sum()
  }
}

fn rounds(k: Int) : Int / Spawn + Stderr + Clock = {
  if k == 0 { 0 } else {
    let r = peak()
    Stderr.eprint("peak #{r}\n")
    sleep(seconds(1))
    Stderr.eprint("idle\n")
    sleep(seconds(1))
    rounds(k - 1)
  }
}

fn main() : Int / Spawn + Stderr + Clock = rounds(6)
