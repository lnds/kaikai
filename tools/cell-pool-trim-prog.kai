# Several workers each churn a large live set, then the program idles.
# tools/cell-pool-trim-gate.sh samples the process RSS at each marker.

import spawn
import time

fn churn(n: Int) : Int = {
  let xs = [1..n] | (i => i + 1)
  let ys = xs | (i => i * 2)
  length(ys) + length(xs)
}

fn peak() : Int / Spawn = {
  nursery { n ->
    let fs = [1..8] | (i => n.spawn(() => churn(400000 + i)))
    fs | (f => n.await(f)) |> sum()
  }
}

fn main() : Int / Spawn + Stdout + Clock = {
  let r = peak()
  Stdout.print("peak #{r}")
  sleep(seconds(2))
  Stdout.print("idle")
  sleep(seconds(1))
  0
}
