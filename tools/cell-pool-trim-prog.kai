# Several workers each churn a large live set, then the program idles.
# tools/cell-pool-trim-gate.sh samples the process RSS at each marker.

import spawn
import time

fn churn(n: Int) : Int = {
  let xs = [1..n] | (i => i + 1)
  let ys = xs | (i => i * 2)
  length(ys) + length(xs)
}

fn peak() : Int / Spawn = {
  nursery { n ->
    let fs = [1..8] | (i => n.spawn(() => churn(400000 + i)))
    fs | (f => n.await(f)) |> sum()
  }
}

fn rounds(k: Int) : Int / Spawn + Stderr + Clock = {
  if k == 0 { 0 } else {
    let r = peak()
    Stderr.eprint("peak #{r}\n")
    sleep(seconds(1))
    Stderr.eprint("idle\n")
    sleep(seconds(1))
    rounds(k - 1)
  }
}

fn main() : Int / Spawn + Stderr + Clock = rounds(5)
