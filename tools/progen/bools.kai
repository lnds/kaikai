#[doc("`Bool` expressions: comparisons, connectives, list predicates, structural equality.")]

import blocks
import leaf
import model
import rng
import shapes

fn compare(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let op = rng.choose(k, 1, ["<", ">", "<=", ">=", "==", "!="], "<")
  "(#{g(cx, TInt, d - 1, rng.sub(k, 1))} #{op} #{g(cx, TInt, d - 1, rng.sub(k, 2))})"
}

fn logic(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let p = g(cx, TBool, d - 1, rng.sub(k, 3))
  match rng.pick(k, 2, 3) {
    0 -> "(#{p} and #{g(cx, TBool, d - 1, rng.sub(k, 4))})"
    1 -> "(#{p} or #{g(cx, TBool, d - 1, rng.sub(k, 4))})"
    _ -> "(not #{p})"
  }
}

fn of_list(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let xs = g(cx, TList, d - 1, rng.sub(k, 5))
  match rng.pick(k, 3, 5) {
    0 -> "is_empty(#{xs})"
    1 -> "any(#{xs}, #{blocks.lambda(g, cx, TBool, d, rng.sub(k, 6))})"
    2 -> "all(#{xs}, #{blocks.lambda(g, cx, TBool, d, rng.sub(k, 6))})"
    3 -> "contains(#{xs}, #{g(cx, TInt, d - 1, rng.sub(k, 7))})"
    _ -> "(#{xs} == #{g(cx, TList, d - 1, rng.sub(k, 7))})"
  }
}

# Equality on the derived `Eq` of the record and the sum, or a `Bool` field read.
fn of_data(g: Gen, cx: Cx, d: Int, k: Int) : String = match rng.pick(k, 4, 3), model.fields_of(
  cx,
  TBool
) {
  0, [name, ...] -> "(#{g(cx, TRec, d - 1, rng.sub(k, 8))}).#{name}"
  1, _ -> "(#{g(cx, TSum, d - 1, rng.sub(k, 8))} != #{g(cx, TSum, d - 1, rng.sub(k, 9))})"
  _, _ -> "(#{g(cx, TRec, d - 1, rng.sub(k, 8))} == #{g(cx, TRec, d - 1, rng.sub(k, 9))})"
}

#[doc("A `Bool` expression.")]
pub fn gen(g: Gen, cx: Cx, d: Int, k: Int) : String = match rng.pick(k, 0, 9) {
  0 -> leaf.gen(cx, TBool, k)
  1 -> compare(g, cx, d, k)
  2 -> compare(g, cx, d, k)
  3 -> compare(g, cx, d, k)
  4 -> logic(g, cx, d, k)
  5 -> of_list(g, cx, d, k)
  6 -> of_data(g, cx, d, k)
  _ -> shapes.gen(g, cx, TBool, d, k)
}
