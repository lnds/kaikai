#[doc("Expression forms that can produce a value of any type: a conditional, a match, a call.")]

import blocks
import matches
import model
import rng

fn cond(g: Gen, cx: Cx, ty: Ty, d: Int, k: Int) : String {
  let guard = g(cx, TBool, d - 1, rng.sub(k, 3))
  "(if #{guard} { #{blocks.body(g, cx, ty, d, rng.sub(k, 4))} } else { #{blocks.body(g, cx, ty, d, rng.sub(k, 5))} })"
}

# Plain, piped into its first parameter, or piped into its last through a placeholder.
fn spell_call(name: String, args: [String], style: Int) : String = match args, style {
  [a, ...rest], 0 -> "(#{a} |> #{model.apply(name, rest)})"
  [_, _, ...], 1 -> {
    let n = list.length(args) - 1
    "(#{rng.at(args, n, "")} |> #{model.apply(name, take(args, n) ++ ["_"])})"
  }
  _, _ -> model.apply(name, args)
}

# With nothing to call, a conditional stands in.
fn call(g: Gen, cx: Cx, ty: Ty, d: Int, k: Int) : String = match model.callable(cx, ty) {
  [] -> cond(g, cx, ty, d, k)
  sigs -> {
    let s = rng.choose(k, 40, sigs, Sig { name: "", params: [], ret: ty })
    let args = map_indexed(s.params, (i, t) => g(cx, t, d - 1, rng.sub(k, 50 + i)))
    spell_call(s.name, args, rng.pick(k, 41, 4))
  }
}

#[doc("An expression of type `ty` in one of the forms every type shares.")]
pub fn gen(g: Gen, cx: Cx, ty: Ty, d: Int, k: Int) : String = match rng.pick(k, 42, 7) {
  0 -> cond(g, cx, ty, d, k)
  1 -> matches.on_sum(g, cx, ty, d, k)
  2 -> matches.on_list(g, cx, ty, d, k)
  3 -> matches.on_int(g, cx, ty, d, k)
  _ -> call(g, cx, ty, d, k)
}
