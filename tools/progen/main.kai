#[doc("progen: prints a random, well-typed, terminating kaikai program for a seed. The same seed always prints the same program.")]

import os.args
import program

fn usage() : Int / Stderr {
  Stderr.eprint("usage: progen <seed> [depth]")
  2
}

fn emit(seed: String, depth: String) : Int / Stdout + Stderr =
  match string.to_int(seed), string.to_int(depth) {
    Some(s), Some(d) if s >= 0 and d >= 1 -> {
      Stdout.print(program.render(s, d))
      0
    }
    _, _ -> usage()
  }

fn main() : Int / Stdout + Stderr + Env = match args.argv() {
  [seed] -> emit(seed, "3")
  [seed, depth] -> emit(seed, depth)
  _ -> usage()
}
