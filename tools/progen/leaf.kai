#[doc("Expressions with no sub-expression to generate: a name in scope or a literal. Where every generator bottoms out.")]

import model
import rng

#[doc("A name of type `ty` in scope, or a literal of that type.")]
pub fn gen(cx: Cx, ty: Ty, k: Int) : String {
  let names = model.vars(cx, ty)
  if rng.chance(k, 0, 2, 3) and (not is_empty(names)) {
    rng.choose(k, 1, names, "")
  } else {
    literal(cx, ty, k)
  }
}

#[doc("A literal of type `ty`.")]
pub fn literal(cx: Cx, ty: Ty, k: Int) : String = match ty {
  TInt -> int(k)
  TBool -> if rng.chance(k, 2, 1, 2) { "true" } else { "false" }
  TList -> ints(k)
  TRec -> record(cx, k)
  TSum -> variant(cx, k)
  TFn -> function(cx, k)
}

# A negative literal is spelled as a subtraction: a line may never start with `-`.
fn int(k: Int) : String {
  let n = rng.pick(k, 3, 12)
  if rng.chance(k, 4, 1, 5) { "(0 - #{n})" } else { "#{n}" }
}

fn ints(k: Int) : String = match rng.pick(k, 5, 4) {
  0 -> "[#{int(rng.sub(k, 1))}]"
  1 -> "[#{int(rng.sub(k, 1))}, #{int(rng.sub(k, 2))}, #{int(rng.sub(k, 3))}]"
  2 -> "[#{rng.pick(k, 6, 3)}..#{rng.pick(k, 7, 4) + 3}]"
  _ -> "[#{int(rng.sub(k, 1))}, #{int(rng.sub(k, 2))}]"
}

fn record(cx: Cx, k: Int) : String {
  let inits =
    map_indexed(cx.fields, (i, f) => "#{f.name}: #{literal(cx, f.ty, rng.sub(k, 10 + i))}")
  "Rec { #{string.join(inits, ", ")} }"
}

fn variant(cx: Cx, k: Int) : String {
  let c = rng.choose(k, 8, cx.ctors, Ctor { name: "Ca", args: [] })
  model.apply(c.name, map_indexed(c.args, (i, t) => literal(cx, t, rng.sub(k, 20 + i))))
}

fn unary(s: Sig) : Bool = s.params == [TInt] and s.ret == TInt

# A function value is a lambda or a top-level function named without a call.
fn function(cx: Cx, k: Int) : String {
  let named = cx.fns |? unary | (s => s.name)
  if rng.chance(k, 9, 1, 2) and (not is_empty(named)) {
    rng.choose(k, 10, named, "")
  } else {
    "((n) => (n + #{rng.pick(k, 11, 9)}))"
  }
}
