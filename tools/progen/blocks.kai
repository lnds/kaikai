#[doc("Block bodies and lambdas: where a generated program introduces names, and where it shadows them.")]

import model
import rng

#[doc("The inside of a `{ }`: an expression of type `ty`, sometimes after a `let` that may shadow an outer name.")]
pub fn body(g: Gen, cx: Cx, ty: Ty, d: Int, k: Int) : String =
  if rng.chance(k, 20, 1, 3) {
    let name = rng.choose(k, 21, model.local_names(), "x")
    let bound = model.any_ty(k, 22)
    let init = g(cx, bound, d - 1, rng.sub(k, 20))
    "let #{name} = #{init}; #{g(model.bind(cx, name, bound), ty, d - 1, rng.sub(k, 21))}"
  } else {
    g(cx, ty, d - 1, rng.sub(k, 22))
  }

#[doc("A one-parameter lambda over an `Int`, returning `ret`; its parameter may shadow an outer name.")]
pub fn lambda(g: Gen, cx: Cx, ret: Ty, d: Int, k: Int) : String {
  let p = rng.choose(k, 23, model.local_names(), "x")
  let inner = model.bind(cx, p, TInt)
  if rng.chance(k, 24, 1, 3) {
    "((#{p}) => { #{body(g, inner, ret, d, rng.sub(k, 23))} })"
  } else {
    "((#{p}) => #{g(inner, ret, d - 1, rng.sub(k, 24))})"
  }
}
