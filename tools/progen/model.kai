#[doc("The typed universe of a generated program: its types, its declarations, and the scope a generator sees.")]

import rng

#[doc("A type a generated expression can have. `TRec` and `TSum` are the program's one record and one sum; `TFn` is `(Int) -> Int`.")]
#[derive(Eq)]
pub type Ty = TInt | TBool | TList | TRec | TSum | TFn

#[doc("A field of the program's record type.")]
pub type Field = { name: String, ty: Ty }

#[doc("A constructor of the program's sum type.")]
pub type Ctor = { name: String, args: [Ty] }

#[doc("A top-level function a generated expression may call.")]
pub type Sig = { name: String, params: [Ty], ret: Ty }

#[doc("A name in scope and its type.")]
pub type Bind = { name: String, ty: Ty }

#[doc("What a generator sees: the declared types, the callable functions, and the bindings in scope, innermost first.")]
pub type Cx = { fields: [Field], ctors: [Ctor], fns: [Sig], env: [Bind] }

#[doc("Generates an expression of a type in a scope, at most `d` levels deep, from key `k`.")]
pub type Gen = (Cx, Ty, Int, Int) -> String

#[doc("The source spelling of a type.")]
pub fn ty_name(t: Ty) : String = match t {
  TInt -> "Int"
  TBool -> "Bool"
  TList -> "[Int]"
  TRec -> "Rec"
  TSum -> "Sum"
  TFn -> "(Int) -> Int"
}

#[doc("Names a `let`, a parameter, or a lambda may bind: the record's fields and the global constants are among them, so a binding can shadow either.")]
pub fn local_names() : [String] = ["x", "y", "z", "w", "n", "k0", "k1", "v", "acc"]

#[doc("A type for choice `slot` of key `k`, data types likelier than functions.")]
pub fn any_ty(k: Int, slot: Int) : Ty =
  rng.choose(k, slot, [TInt, TInt, TInt, TBool, TList, TList, TRec, TSum, TFn], TInt)

#[doc("A type that is not a function, for choice `slot` of key `k`.")]
pub fn data_ty(k: Int, slot: Int) : Ty =
  rng.choose(k, slot, [TInt, TInt, TBool, TList, TList, TRec, TSum], TInt)

#[doc("The scope with `name` bound to `ty`, shadowing any outer binding of that name.")]
pub fn bind(cx: Cx, name: String, ty: Ty) : Cx =
  Cx { ...cx, env: [Bind { name: name, ty: ty }, ...cx.env] }

#[doc("The scope with each of `names` bound to the type at its position.")]
pub fn bind_all(cx: Cx, names: [String], tys: [Ty]) : Cx = match names, tys {
  [n, ...ns], [t, ...ts] -> bind_all(bind(cx, n, t), ns, ts)
  _, _ -> cx
}

#[doc("The names of type `ty` a reference would reach: a shadowed binding is not among them.")]
pub fn vars(cx: Cx, ty: Ty) : [String] = visible(cx.env, ty, [])

fn visible(env: [Bind], ty: Ty, seen: [String]) : [String] = match env {
  [] -> []
  [b, ...rest] -> {
    let outer = visible(rest, ty, [b.name, ...seen])
    if b.ty == ty and (not contains(seen, b.name)) { [b.name, ...outer] } else { outer }
  }
}

#[doc("The callable functions returning `ty`.")]
pub fn callable(cx: Cx, ty: Ty) : [Sig] = cx.fns |? (s => s.ret == ty)

#[doc("The record's fields of type `ty`.")]
pub fn fields_of(cx: Cx, ty: Ty) : [String] = cx.fields |? (f => f.ty == ty) | (f => f.name)

#[doc("`name(a, b)`, or the bare name when there are no arguments.")]
pub fn apply(name: String, args: [String]) : String = match args {
  [] -> name
  _ -> "#{name}(#{string.join(args, ", ")})"
}

#[doc("Pattern binders for a payload of these types, by position.")]
pub fn binders(tys: [Ty]) : [String] = map_indexed(tys, (i, t) => rng.at(["a", "b", "c"], i, "e"))
