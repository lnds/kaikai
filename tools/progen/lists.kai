#[doc("`[Int]` expressions. Every form that can lengthen a list truncates its result, so list lengths stay bounded however deep the expression is.")]

import blocks
import leaf
import model
import rng
import shapes

fn built(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let a = g(cx, TInt, d - 1, rng.sub(k, 1))
  let b = g(cx, TInt, d - 1, rng.sub(k, 2))
  if rng.chance(k, 1, 1, 2) {
    "[#{a}, #{b}]"
  } else {
    "[#{a}, #{b}, #{g(cx, TInt, d - 1, rng.sub(k, 3))}]"
  }
}

# The stage is a lambda, a closure in scope, or a top-level function named bare.
fn piped(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let xs = g(cx, TList, d - 1, rng.sub(k, 4))
  match rng.pick(k, 2, 4) {
    0 -> "(#{xs} | #{g(cx, TFn, d - 1, rng.sub(k, 5))})"
    1 -> "(#{xs} | #{blocks.lambda(g, cx, TInt, d, rng.sub(k, 5))})"
    2 -> "(#{xs} |? #{blocks.lambda(g, cx, TBool, d, rng.sub(k, 5))})"
    _ ->
      "(#{xs} | #{blocks.lambda(g, cx, TInt, d, rng.sub(k, 5))} |? #{blocks.lambda(g, cx, TBool, d, rng.sub(k, 6))})"
  }
}

fn grown(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let xs = g(cx, TList, d - 1, rng.sub(k, 7))
  let cap = rng.pick(k, 3, 8) + 2
  match rng.pick(k, 4, 3) {
    0 -> "take((#{xs} ++ #{g(cx, TList, d - 1, rng.sub(k, 8))}), #{cap})"
    1 ->
      "take((#{xs} || ((x) => [x, #{g(model.bind(cx, "x", TInt), TInt, d - 1, rng.sub(k, 8))}])), #{cap})"
    _ -> "take([#{g(cx, TInt, d - 1, rng.sub(k, 8))}, ...#{xs}], #{cap})"
  }
}

fn reshaped(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let xs = g(cx, TList, d - 1, rng.sub(k, 9))
  match rng.pick(k, 5, 5) {
    0 -> "reverse(#{xs})"
    1 -> "drop(#{xs}, #{rng.pick(k, 6, 3)})"
    2 -> "sort(#{xs})"
    3 -> "(#{xs} |> take(#{rng.pick(k, 6, 4)}))"
    _ -> "(#{xs} |> list.reverse)"
  }
}

#[doc("An `[Int]` expression.")]
pub fn gen(g: Gen, cx: Cx, d: Int, k: Int) : String = match rng.pick(k, 0, 10) {
  0 -> leaf.gen(cx, TList, k)
  1 -> built(g, cx, d, k)
  2 -> piped(g, cx, d, k)
  3 -> piped(g, cx, d, k)
  4 -> piped(g, cx, d, k)
  5 -> grown(g, cx, d, k)
  6 -> reshaped(g, cx, d, k)
  _ -> shapes.gen(g, cx, TList, d, k)
}
