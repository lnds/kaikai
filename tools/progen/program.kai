#[doc("A whole program from a seed: declarations, functions, and a `main` that prints what it computes and a checksum over all of it.")]

import decls
import expr
import fndefs
import model
import rng

const HASH : String = "#"

fn interpolated(e: String) : String = "#{HASH}{#{e}}"

fn label(ty: Ty) : String = match ty {
  TInt -> "int"
  TBool -> "bool"
  TList -> "list"
  TRec -> "rec"
  TSum -> "sum"
  TFn -> "fn"
}

# Structured values print through their derived `Show` half the time, through the checksum otherwise.
fn shown(name: String, ty: Ty, k: Int) : String = match ty {
  TInt -> name
  TBool -> name
  TFn -> "#{name}(3)"
  _ -> if rng.chance(k, 3, 1, 2) { name } else { decls.hash(ty, name) }
}

fn statement(cx: Cx, name: String, ty: Ty, i: Int, d: Int, k: Int) : [String] = [
  "  let #{name} = #{expr.gen(cx, ty, d, rng.sub(k, 1))}",
  "  Stdout.print(\"s#{i} #{label(ty)}=#{interpolated(shown(name, ty, k))}\")",
  "  let chk = #{decls.mix("chk", decls.hash(ty, name))}"
]

# Each statement binds a name the later ones can read, and may shadow an earlier one.
fn statements(cx: Cx, i: Int, n: Int, d: Int, k: Int) : [String] =
  if i >= n {
    []
  } else {
    let name = rng.choose(k, 1, model.local_names(), "x")
    let ty = model.any_ty(k, 2)
    statement(cx, name, ty, i, d, k)
      ++ statements(model.bind(cx, name, ty), i + 1, n, d, rng.sub(k, 2))
  }

fn entry(cx: Cx, d: Int, k: Int) : String {
  let body = statements(cx, 0, rng.pick(k, 0, 5) + 4, d, k)
  "fn main() : Unit / Stdout = {\n  let chk = 17\n#{string.join(body, "\n")}\n  Stdout.print(\"checksum=#{interpolated("chk")}\")\n}"
}

# The functions declared before `s`: the only ones its body may call.
fn before(sigs: [Sig], s: Sig) : [Sig] = take_while(sigs, o => o.name != s.name)

fn functions(base: Cx, d: Int, k: Int) : (Cx, [String]) {
  let keys = [0..(rng.pick(k, 0, 5) + 1)] | (i => rng.sub(k, i))
  let sigs = map_indexed(keys, fndefs.sig)
  let texts = zip_with(
    sigs,
    keys,
    (s, key) => fndefs.render(expr.gen, Cx { ...base, fns: before(sigs, s) }, s, d, key)
  )
  (Cx { ...base, fns: sigs }, texts)
}

#[doc("The source of the program for `seed`, with expressions at most `d` levels deep.")]
pub fn render(seed: Int, d: Int) : String {
  let k = rng.sub(seed, 0)
  let globals = [Bind { name: "k0", ty: TInt }, Bind { name: "k1", ty: TInt }]
  let base = Cx {
    fields: decls.fields(rng.sub(k, 1)),
    ctors: decls.ctors(rng.sub(k, 2)),
    fns: [],
    env: globals
  }
  let fs = functions(base, d, rng.sub(k, 3))
  string.join(
    [
      "# progen seed #{seed} depth #{d}",
      decls.types(base),
      "const k0 : Int = #{rng.pick(k, 1, 20)}\nconst k1 : Int = #{rng.pick(k, 2, 20)}",
      decls.hashers(base),
      ...fs.snd,
      entry(fs.fst, d, rng.sub(k, 4))
    ],
    "\n\n"
  )
}
