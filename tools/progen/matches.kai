#[doc("`match` expressions over a sum, a list, or an `Int`. Every match is exhaustive: a refutable or guarded arm is always followed by one that takes the rest.")]

import blocks
import model
import rng

fn arm(g: Gen, cx: Cx, pat: String, ty: Ty, d: Int, k: Int) : String =
  "#{pat} -> { #{blocks.body(g, cx, ty, d, k)} }"

fn guarded(g: Gen, cx: Cx, pat: String, ty: Ty, d: Int, k: Int) : String =
  arm(g, cx, "#{pat} if #{g(cx, TBool, d - 1, rng.sub(k, 6))}", ty, d, rng.sub(k, 7))

# An arm present only some of the time, with the separator it needs.
fn sometimes(on: Bool, text: String) : String = if on { "#{text}; " } else { "" }

# The record's first field is always an `Int`; the rest are bound by punning.
fn narrow_record(cx: Cx, k: Int) : (String, Cx) = match cx.fields {
  [] -> ("_", cx)
  [f, ...rest] -> {
    let names = rest | (r => r.name)
    let fields = ["#{f.name}: #{rng.pick(k, 30, 4)}", ...names]
    ("{ #{string.join(fields, ", ")} }", model.bind_all(cx, names, rest | (r => r.ty)))
  }
}

# A pattern for one payload that only some values match, and the scope it binds.
fn narrow(cx: Cx, ty: Ty, k: Int) : (String, Cx) = match ty {
  TInt -> ("#{rng.pick(k, 30, 4)}", cx)
  TBool -> ("true", cx)
  TList -> ("[h, ...t]", model.bind_all(cx, ["h", "t"], [TInt, TList]))
  TRec -> narrow_record(cx, k)
  _ -> ("p", model.bind(cx, "p", ty))
}

fn narrowed(g: Gen, cx: Cx, c: Ctor, ty: Ty, d: Int, k: Int) : String = match c.args {
  [] -> ""
  [first, ...rest] -> {
    let n = narrow(cx, first, k)
    let tail = model.binders(c.args) |> drop(1)
    "#{arm(g, model.bind_all(n.snd, tail, rest), model.apply(c.name, [n.fst, ...tail]), ty, d, rng.sub(k, 9))}; "
  }
}

# The arms covering one constructor: sometimes a refutable or guarded arm first, always a total one.
fn ctor_arms(g: Gen, cx: Cx, c: Ctor, ty: Ty, d: Int, k: Int) : String {
  let names = model.binders(c.args)
  let pat = model.apply(c.name, names)
  let inner = model.bind_all(cx, names, c.args)
  let total = arm(g, inner, pat, ty, d, rng.sub(k, 8))
  match rng.pick(k, 31, 4) {
    0 -> "#{narrowed(g, cx, c, ty, d, k)}#{total}"
    1 -> "#{sometimes(not is_empty(c.args), guarded(g, inner, pat, ty, d, rng.sub(k, 9)))}#{total}"
    _ -> total
  }
}

#[doc("A match on a value of the sum type, with nested patterns and guards.")]
pub fn on_sum(g: Gen, cx: Cx, ty: Ty, d: Int, k: Int) : String {
  let arms = map_indexed(cx.ctors, (i, c) => ctor_arms(g, cx, c, ty, d, rng.sub(k, 40 + i)))
  "(match #{g(cx, TSum, d - 1, rng.sub(k, 10))} { #{string.join(arms, "; ")} })"
}

#[doc("A match on a list by its shape.")]
pub fn on_list(g: Gen, cx: Cx, ty: Ty, d: Int, k: Int) : String {
  let inner = model.bind_all(cx, ["h", "t"], [TInt, TList])
  let empty = arm(g, cx, "[]", ty, d, rng.sub(k, 11))
  let one = sometimes(
    rng.chance(k, 32, 1, 3),
    arm(g, model.bind(cx, "h", TInt), "[h]", ty, d, rng.sub(k, 12))
  )
  let some =
    sometimes(rng.chance(k, 33, 1, 3), guarded(g, inner, "[h, ...t]", ty, d, rng.sub(k, 13)))
  let rest = arm(g, inner, "[h, ...t]", ty, d, rng.sub(k, 14))
  "(match #{g(cx, TList, d - 1, rng.sub(k, 15))} { #{empty}; #{one}#{some}#{rest} })"
}

#[doc("A match on an `Int` by literal, range, and guard, closed by a catch-all.")]
pub fn on_int(g: Gen, cx: Cx, ty: Ty, d: Int, k: Int) : String {
  let inner = model.bind(cx, "m", TInt)
  let lit =
    sometimes(rng.chance(k, 34, 2, 3), arm(g, cx, "#{rng.pick(k, 35, 3)}", ty, d, rng.sub(k, 16)))
  let range = sometimes(
    rng.chance(k, 36, 1, 2),
    arm(g, cx, "3..#{rng.pick(k, 37, 9) + 3}", ty, d, rng.sub(k, 17))
  )
  let tested = sometimes(rng.chance(k, 38, 1, 2), guarded(g, inner, "m", ty, d, rng.sub(k, 18)))
  let rest = if rng.chance(k, 39, 1, 2) {
    arm(g, inner, "m", ty, d, rng.sub(k, 19))
  } else {
    arm(g, cx, "_", ty, d, rng.sub(k, 19))
  }
  "(match #{g(cx, TInt, d - 1, rng.sub(k, 25))} { #{lit}#{range}#{tested}#{rest} })"
}
