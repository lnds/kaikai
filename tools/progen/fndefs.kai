#[doc("Top-level functions. A function calls only those declared before it, and recurses only down a list, so every program terminates.")]

import model
import rng

# Core builtins the generated expressions never call: a function may take one of these names.
const HOMONYMS : [String] = ["last", "min", "max", "product", "nth", "concat", "init", "tail"]

# 0: fold down a list; 1: rebuild a list; 2: clause-block; otherwise an expression body.
fn kind(k: Int) : Int = rng.pick(k, 0, 6)

fn name(i: Int, k: Int) : String =
  if rng.chance(k, 1, 1, 4) { rng.at(HOMONYMS, i, "f#{i}") } else { "f#{i}" }

#[doc("The signature of function `i`, from its key.")]
pub fn sig(i: Int, k: Int) : Sig = match kind(k) {
  0 -> Sig { name: name(i, k), params: [TList, TInt], ret: TInt }
  1 -> Sig { name: name(i, k), params: [TList, model.data_ty(k, 2)], ret: TList }
  2 -> Sig { name: name(i, k), params: [TInt], ret: model.data_ty(k, 2) }
  _ -> Sig {
    name: name(i, k),
    params: take(
      [model.any_ty(k, 3), model.any_ty(k, 4), model.any_ty(k, 5)],
      rng.pick(k, 6, 3) + 1
    ),
    ret: model.data_ty(k, 2)
  }
}

fn header(s: Sig, names: [String]) : String {
  let params = zip_with(names, s.params, (n, t) => "#{n}: #{model.ty_name(t)}")
  "fn #{s.name}(#{string.join(params, ", ")}) : #{model.ty_name(s.ret)}"
}

# What a function returns is reduced, so values stay bounded across any chain of calls.
fn capped(ty: Ty, e: String) : String = match ty {
  TInt -> "(#{e} % 100003)"
  TList -> "take(#{e}, 12)"
  _ -> e
}

fn fold_fn(g: Gen, cx: Cx, s: Sig, d: Int, k: Int) : String {
  let inner = model.bind_all(cx, ["xs", "acc", "h", "t"], [TList, TInt, TInt, TList])
  let step = capped(TInt, g(inner, TInt, d, rng.sub(k, 1)))
  "#{header(s, ["xs", "acc"])} = match xs {\n  [] -> acc\n  [h, ...t] -> #{s.name}(t, #{step})\n}"
}

fn build_fn(g: Gen, cx: Cx, s: Sig, d: Int, k: Int) : String {
  let inner =
    model.bind_all(cx, ["xs", "v", "h", "t"], [TList, rng.at(s.params, 1, TInt), TInt, TList])
  let item = capped(TInt, g(inner, TInt, d, rng.sub(k, 1)))
  "#{header(s, ["xs", "v"])} = match xs {\n  [] -> []\n  [h, ...t] -> [#{item}, ...#{s.name}(t, v)]\n}"
}

fn clause_fn(g: Gen, cx: Cx, s: Sig, d: Int, k: Int) : String {
  let outer = model.bind(cx, "n", TInt)
  let inner = model.bind(outer, "m", TInt)
  let zero = capped(s.ret, g(outer, s.ret, d, rng.sub(k, 1)))
  let guard = g(inner, TBool, d - 1, rng.sub(k, 2))
  let some = capped(s.ret, g(inner, s.ret, d, rng.sub(k, 3)))
  let rest = capped(s.ret, g(outer, s.ret, d, rng.sub(k, 4)))
  "#{header(s, ["n"])} {\n  case 0 -> #{zero}\n  case m when #{guard} -> #{some}\n  case _ -> #{rest}\n}"
}

fn plain_fn(g: Gen, cx: Cx, s: Sig, d: Int, k: Int) : String {
  let pool = model.local_names()
  let first = rng.pick(k, 7, list.length(pool))
  let names = map_indexed(s.params, (i, t) => rng.at(pool, (first + i) % list.length(pool), "x"))
  "#{header(s, names)} = #{capped(s.ret, g(model.bind_all(cx, names, s.params), s.ret, d, rng.sub(k, 1)))}"
}

#[doc("The declaration of the function with signature `s`, from the key that chose the signature.")]
pub fn render(g: Gen, cx: Cx, s: Sig, d: Int, k: Int) : String = match kind(k) {
  0 -> fold_fn(g, cx, s, d, k)
  1 -> build_fn(g, cx, s, d, k)
  2 -> clause_fn(g, cx, s, d, k)
  _ -> plain_fn(g, cx, s, d, k)
}
