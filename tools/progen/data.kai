#[doc("Expressions of the program's record type, its sum type, and its function type.")]

import blocks
import leaf
import model
import rng
import shapes

fn inits(g: Gen, cx: Cx, d: Int, k: Int) : [String] =
  map_indexed(cx.fields, (i, f) => g(cx, f.ty, d - 1, rng.sub(k, 10 + i)))

fn named(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let pairs = zip_with(cx.fields, inits(g, cx, d, k), (f, e) => "#{f.name}: #{e}")
  "Rec { #{string.join(pairs, ", ")} }"
}

# A spread copies a record in scope and overrides its first field.
fn spread(g: Gen, cx: Cx, d: Int, k: Int) : String = match model.vars(cx, TRec), cx.fields {
  [r, ...], [f, ...] -> "Rec { ...#{r}, #{f.name}: #{g(cx, f.ty, d - 1, rng.sub(k, 1))} }"
  _, _ -> named(g, cx, d, k)
}

#[doc("An expression of the record type.")]
pub fn record(g: Gen, cx: Cx, d: Int, k: Int) : String = match rng.pick(k, 0, 8) {
  0 -> leaf.gen(cx, TRec, k)
  1 -> named(g, cx, d, k)
  2 -> named(g, cx, d, k)
  3 -> "Rec { #{string.join(inits(g, cx, d, k) | ((e) => "(#{e})"), ", ")} }"
  4 -> spread(g, cx, d, k)
  _ -> shapes.gen(g, cx, TRec, d, k)
}

fn built(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let c = rng.choose(k, 1, cx.ctors, Ctor { name: "Ca", args: [] })
  model.apply(c.name, map_indexed(c.args, (i, t) => g(cx, t, d - 1, rng.sub(k, 20 + i))))
}

#[doc("An expression of the sum type.")]
pub fn variant(g: Gen, cx: Cx, d: Int, k: Int) : String = match rng.pick(k, 0, 6) {
  0 -> leaf.gen(cx, TSum, k)
  1 -> built(g, cx, d, k)
  2 -> built(g, cx, d, k)
  3 -> built(g, cx, d, k)
  _ -> shapes.gen(g, cx, TSum, d, k)
}

#[doc("An expression of type `(Int) -> Int`: mostly a closure over the names in scope.")]
pub fn function(g: Gen, cx: Cx, d: Int, k: Int) : String = match rng.pick(k, 0, 6) {
  0 -> leaf.gen(cx, TFn, k)
  1 -> shapes.gen(g, cx, TFn, d, k)
  _ -> blocks.lambda(g, cx, TInt, d, k)
}
