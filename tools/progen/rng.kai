#[doc("A splittable pseudo-random source: a key hashes to its choices and to its child keys, so no state is threaded and a seed means the same program on every machine.")]

# Every intermediate stays below 2^62: the arithmetic never depends on overflow.
const MODULUS : Int = 2147483647

fn step(x: Int) : Int = (x * 48271 + 11) % MODULUS

#[doc("The key of child `i` of the node keyed `k`; distinct `i` give unrelated keys.")]
pub fn sub(k: Int, i: Int) : Int {
  let a = step((k % MODULUS + (i + 1) * 1000003) % MODULUS)
  step((a * a % MODULUS + a) % MODULUS)
}

#[doc("A number in `[0, n)` for choice `slot` of key `k`.")]
pub fn pick(k: Int, slot: Int, n: Int) : Int = sub(k, 1000 + slot) / 16 % n

#[doc("True `num` times out of `den` for choice `slot` of key `k`.")]
pub fn chance(k: Int, slot: Int, num: Int, den: Int) : Bool = pick(k, slot, den) < num

#[doc("An element of `xs` for choice `slot` of key `k`, or `fallback` when `xs` is empty.")]
pub fn choose[a](k: Int, slot: Int, xs: [a], fallback: a) : a = match xs {
  [] -> fallback
  _ -> at(xs, pick(k, slot, list.length(xs)), fallback)
}

#[doc("Element `i` of `xs`, or `fallback` past its end.")]
pub fn at[a](xs: [a], i: Int, fallback: a) : a = match nth(xs, i) {
  Some(x) -> x
  None -> fallback
}
