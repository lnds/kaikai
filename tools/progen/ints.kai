#[doc("`Int` expressions. Products and powers reduce their operands first, so no value a program computes nears the `Int` range.")]

import blocks
import leaf
import model
import rng
import shapes

# Divisors and moduli are non-zero literals: a generated program never traps.
fn arith(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let a = g(cx, TInt, d - 1, rng.sub(k, 1))
  let b = g(cx, TInt, d - 1, rng.sub(k, 2))
  let p = rng.pick(k, 1, 9) + 2
  match rng.pick(k, 2, 8) {
    0 -> "(#{a} + #{b})"
    1 -> "(#{a} - #{b})"
    2 -> "((#{a} % #{p + 90}) * (#{b} % #{p}))"
    3 -> "(#{a} % #{p})"
    4 -> "(#{a} / #{p})"
    5 -> "(#{a} / (0 - #{p}))"
    6 -> "((#{a} % 7) ^ (#{b} % 4))"
    _ -> "(#{a} + #{b})"
  }
}

fn fold(g: Gen, cx: Cx, xs: String, d: Int, k: Int) : String {
  let inner = model.bind(model.bind(cx, "acc", TInt), "x", TInt)
  let step = g(inner, TInt, d - 1, rng.sub(k, 3))
  "foldl(#{xs}, #{g(cx, TInt, d - 1, rng.sub(k, 4))}, (acc, x) => (#{step} % 10007))"
}

fn first(g: Gen, cx: Cx, xs: String, d: Int, k: Int) : String {
  let some = g(model.bind(cx, "h", TInt), TInt, d - 1, rng.sub(k, 5))
  "(match head(#{xs}) { Some(h) -> #{some}; None -> #{g(cx, TInt, d - 1, rng.sub(k, 6))} })"
}

fn of_list(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let xs = g(cx, TList, d - 1, rng.sub(k, 7))
  match rng.pick(k, 3, 8) {
    0 -> "length(#{xs})"
    1 -> "sum(#{xs})"
    2 -> "(#{xs} |> list.length)"
    3 -> "(#{xs} |> sum)"
    4 -> fold(g, cx, xs, d, k)
    5 -> "count(#{xs}, #{blocks.lambda(g, cx, TBool, d, rng.sub(k, 8))})"
    6 -> first(g, cx, xs, d, k)
    _ -> "(#{fold(g, cx, xs, d, k)} |> ((v) => v))"
  }
}

fn field(g: Gen, cx: Cx, d: Int, k: Int) : String = match model.fields_of(cx, TInt) {
  [] -> leaf.gen(cx, TInt, k)
  names -> "(#{g(cx, TRec, d - 1, rng.sub(k, 9))}).#{rng.choose(k, 4, names, "")}"
}

# A function value applied directly or through the apply pipe.
fn applied(g: Gen, cx: Cx, d: Int, k: Int) : String {
  let f = g(cx, TFn, d - 1, rng.sub(k, 10))
  let arg = g(cx, TInt, d - 1, rng.sub(k, 11))
  if rng.chance(k, 5, 1, 2) { "#{f}(#{arg})" } else { "(#{arg} |> #{f})" }
}

#[doc("An `Int` expression.")]
pub fn gen(g: Gen, cx: Cx, d: Int, k: Int) : String = match rng.pick(k, 0, 12) {
  0 -> leaf.gen(cx, TInt, k)
  1 -> arith(g, cx, d, k)
  2 -> arith(g, cx, d, k)
  3 -> arith(g, cx, d, k)
  4 -> of_list(g, cx, d, k)
  5 -> of_list(g, cx, d, k)
  6 -> field(g, cx, d, k)
  7 -> applied(g, cx, d, k)
  8 -> applied(g, cx, d, k)
  _ -> shapes.gen(g, cx, TInt, d, k)
}
