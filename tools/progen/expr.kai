#[doc("The generator every form recurses through: an expression of a requested type, well-typed by construction.")]

import bools
import data
import ints
import leaf
import lists
import model

#[doc("An expression of type `ty` in scope `cx`, at most `d` levels deep, from key `k`.")]
pub fn gen(cx: Cx, ty: Ty, d: Int, k: Int) : String =
  if d <= 0 {
    leaf.gen(cx, ty, k)
  } else {
    match ty {
      TInt -> ints.gen(gen, cx, d, k)
      TBool -> bools.gen(gen, cx, d, k)
      TList -> lists.gen(gen, cx, d, k)
      TRec -> data.record(gen, cx, d, k)
      TSum -> data.variant(gen, cx, d, k)
      TFn -> data.function(gen, cx, d, k)
    }
  }
