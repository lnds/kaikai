#[doc("The program's type declarations, and the functions that fold a value of each type into the checksum.")]

import model
import rng

fn plain(k: Int, slot: Int) : Ty = rng.choose(k, slot, [TInt, TBool, TList], TInt)

#[doc("The record's fields: two to four, the first always an `Int`.")]
pub fn fields(k: Int) : [Field] = take(
  [
    Field { name: "x", ty: TInt },
    Field { name: "y", ty: plain(k, 1) },
    Field { name: "z", ty: plain(k, 2) },
    Field { name: "w", ty: plain(k, 3) }
  ],
  rng.pick(k, 0, 3) + 2
)

#[doc("The sum's constructors: two to four, each with a payload drawn from a fixed set of shapes.")]
pub fn ctors(k: Int) : [Ctor] {
  let payloads = [[], [TInt], [TInt, TBool], [TList], [TRec], [TBool, TRec], [TInt, TInt, TList]]
  let names = take(["Ca", "Cb", "Cc", "Cd"], rng.pick(k, 4, 3) + 2)
  map_indexed(names, (i, name) => Ctor { name: name, args: rng.choose(k, 10 + i, payloads, []) })
}

#[doc("The `type` declarations of the record and the sum.")]
pub fn types(cx: Cx) : String {
  let fs = cx.fields | (f => "#{f.name}: #{model.ty_name(f.ty)}")
  let cs = cx.ctors | (c => model.apply(c.name, map(c.args, model.ty_name)))
  "#[derive(Eq, Show)]\ntype Rec = { #{string.join(fs, ", ")} }\n\n#[derive(Eq, Show)]\ntype Sum = #{string.join(cs, " | ")}"
}

#[doc("An `Int` expression that folds the value of expression `e`, of type `ty`, to a bounded number.")]
pub fn hash(ty: Ty, e: String) : String = match ty {
  TInt -> "(#{e} % 1000003)"
  TBool -> "h_bool(#{e})"
  TList -> "h_list(#{e})"
  TRec -> "h_rec(#{e})"
  TSum -> "h_sum(#{e})"
  TFn -> "(#{e}(5) % 1000003)"
}

#[doc("An `Int` expression mixing hash `h` into accumulator `acc`; it stays below the modulus, so it never overflows.")]
pub fn mix(acc: String, h: String) : String = "((#{acc} * 31 + #{h}) % 1000000007)"

fn sum_arm(i: Int, c: Ctor) : String {
  let names = model.binders(c.args)
  let hashes = zip_with(c.args, names, hash)
  "  #{model.apply(c.name, names)} -> #{foldl(hashes, "#{i + 1}", mix)}"
}

#[doc("The checksum functions `h_bool`, `h_list`, `h_rec`, and `h_sum`.")]
pub fn hashers(cx: Cx) : String {
  let rec = foldl(cx.fields, "7", (acc, f) => mix(acc, hash(f.ty, "r.#{f.name}")))
  string.join(
    [
      "fn h_bool(b: Bool) : Int = if b { 1 } else { 2 }",
      "fn h_list(xs: [Int]) : Int = foldl(xs, 7, (acc, x) => #{mix("acc", hash(TInt, "x"))})",
      "fn h_rec(r: Rec) : Int = #{rec}",
      "fn h_sum(s: Sum) : Int = match s {\n#{string.join(map_indexed(cx.ctors, sum_arm), "\n")}\n}"
    ],
    "\n\n"
  )
}
