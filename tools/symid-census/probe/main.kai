# What `--check-written-eq` must report: the gate runs it on this file and
# fails unless every function named `cmp_*` is reported and no `ok_*` is.

import compiler.written
import compiler.ast

type Row = { name: Written, n: Int }
type Deep = { row: Row, binder: Binder }

fn has[T](xs: [T], x: T) : Bool = match xs {
  [] -> false
  [y, ...rest] -> y == x or has(rest, x)
}

fn cmp_direct(a: Written, b: Written) : Bool = a == b
fn cmp_field(a: Row, b: Row) : Bool = a != b
fn cmp_nested(a: Deep, b: Deep) : Bool = a == b
fn cmp_binder(a: Binder, b: Binder) : Bool = a == b
fn cmp_ref(a: DeclRef, b: DeclRef) : Bool = a == b
fn cmp_generic(ws: [Written], w: Written) : Bool = has(ws, w)

fn ok_ints(a: Int, b: Int) : Bool = a == b
fn ok_empty(ws: [Written]) : Bool = ws == []
fn ok_ids(a: SymId, b: SymId) : Bool = sym_raw(a) == sym_raw(b)

fn main() : Unit / Console = {
  let w = written("x")
  let row = Row { name: w, n: 1 }
  let b = binder_written("x")
  let deep = Deep { row: row, binder: b }
  let r = ref_written("x")
  let names = cmp_direct(w, w) and not cmp_field(row, row) and cmp_nested(deep, deep)
                and cmp_binder(b, b) and cmp_ref(r, r) and cmp_generic([w], w)
  let rest = ok_ints(1, 1) and not ok_empty([w]) and ok_ids(sym_none(), sym_none())
  if names and rest { print("ok") } else { print("no") }
}
