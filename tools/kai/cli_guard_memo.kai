#[doc("""
A package's per-file checks, memoised by everything they read.

A check's diagnostics and status are a function of its inputs: the
compiler binary, its arguments, the entry's source, the interface of
every module the entry imports (`kaic2 --guard-interfaces`: the module
without the bodies a caller cannot see), the core modules and the `KAI`
environment the compiler sees. A memo entry under the package's user
cache replays them byte for byte.

An imported module's body is outside that key, so only a clean check
that names no other source is kept under it. Any other check is kept
under a key over the full source of every imported module, which the
interface entry points to: a failure or a warning that came from an
imported body never outlives the edit that changes it.

`KAI_GUARD_MEMO=0` turns the memo off; `KAI_GUARD_MEMO=shadow` also runs
the check on every hit and fails the run on any difference.
""")]

import os.env
import cli_fs
import cli_memo_key
import cli_plan
import cli_proc
import cli_sys

#[doc("The variable a parent run sets to the compiler binary's digest, so its children need not hash it again.")]
pub const TOOLCHAIN_ENV : String = "KAI_GUARD_TOOLCHAIN"

#[doc("The variable a parent run sets to the digest of the core modules and their imports, which every check of the run reads alike.")]
pub const CORE_ENV : String = "KAI_GUARD_CORE"

const FORMAT : String = "kai-guard-memo 3"

#[doc("""
Run the check `argv`, whose last element is the entry the user knows as
`shown`, leaving its stderr in `err` with the entry renamed to `shown`:
from its memo entry on a hit, by running it otherwise. Returns its status.
""")]
pub fn guarded(argv: [String], shown: String, err: String) : Int / Env + File + Ffi {
  let mode = env.get("KAI_GUARD_MEMO").unwrap_or("")
  let dir = memo_dir(argv)
  if mode == "0" or dir == "" {
    fresh(argv, shown, err)
  } else {
    match keys_of(argv, shown, err) {
      None -> fresh(argv, shown, err)
      Some(keys) -> memoised(mode, ("#{dir}/#{keys.fst}", "#{dir}/#{keys.snd}"), argv, shown, err)
    }
  }
}

#[doc("The digest of the compiler binary at `kaic2`, as 64 hex digits.")]
pub fn toolchain_digest(kaic2: String) : String / Ffi {
  cli_sys.sha_reset()
  let _ = cli_sys.sha_file(kaic2)
  cli_sys.sha_hex()
}

#[doc("The digest of the core modules `kaic2` loads and their import closure, by path and content.")]
pub fn core_digest(kaic2: String, scratch: String) : String / File + Ffi {
  let listing = cli_proc.capture(
    [kaic2, "--guard-core-inputs"],
    cli_plan.kaic2_spawn([], "", "/dev/null"),
    "#{scratch}/core-inputs"
  )
  cli_sys.sha_reset()
  cli_memo_key.field(int_to_string(listing.fst))
  cli_memo_key.lines(listing.snd) |> foreach(l => cli_memo_key.feed_input(l))
  cli_sys.sha_hex()
}

# A memo entry: a check's status and stderr, a pointer to the entry under
# the full-source key, or nothing usable.
type Found = Found(Int, String) | Full | Missing

# `entries` is the entry under the interface key and the one under the
# full-source key.
fn memoised(mode: String, entries: (String, String), argv: [String], shown: String, err: String) : Int / Env + File + Ffi =
  match load(entries.fst) {
    Found(rc, text) -> replay(mode, (rc, text), argv, shown, err)
    Full -> match load(entries.snd) {
      Found(rc, text) -> replay(mode, (rc, text), argv, shown, err)
      _               -> record(entries, argv, shown, err)
    }
    Missing -> record(entries, argv, shown, err)
  }

fn replay(mode: String, hit: (Int, String), argv: [String], shown: String, err: String) : Int / File + Ffi =
  if mode == "shadow" {
    shadow(hit, fresh(argv, shown, err), shown, err)
  } else {
    let _ = write_file(err, hit.snd)
    hit.fst
  }

fn record(entries: (String, String), argv: [String], shown: String, err: String) : Int / File + Ffi {
  let rc = fresh(argv, shown, err)
  if cli_sys.pending_signal() == 0 {
    let text = cli_fs.read_or_empty(err)
    if rc == 0 and own_report(text, shown) {
      store(entries.fst, "#{rc}\n#{string_length(text)}\n#{text}")
    } else {
      store(entries.snd, "#{rc}\n#{string_length(text)}\n#{text}")
      store(entries.fst, "full\n")
    }
  }
  rc
}

fn fresh(argv: [String], shown: String, err: String) : Int / File + Ffi {
  let rc = cli_proc.run(argv, cli_plan.kaic2_spawn([], "/dev/null", err))
  let entry = list.last(argv).unwrap_or(shown)
  if entry != shown { cli_plan.rewrite_paths(err, entry, shown) }
  rc
}

fn shadow(hit: (Int, String), rc: Int, shown: String, err: String) : Int / File + Ffi =
  if hit.fst == rc and hit.snd == cli_fs.read_or_empty(err) {
    rc
  } else {
    let _ = write_file(err, "#{cli_fs.read_or_empty(err)}kai: guard memo differs from the check of #{shown} (memo status #{hit.fst}, check status #{rc})\n")
    if rc == 0 { 1 } else { rc }
  }

# The memo lives beside the parse cache of the package the check runs in.
fn memo_dir(argv: [String]) : String =
  match cli_memo_key.user_cache_dir(argv) {
    "" -> ""
    d -> "#{d}/guards"
  }

fn store(entry: String, body: String) : Unit / File + Ffi {
  let _ = cli_fs.mkdir_p(cli_fs.dirname(entry))
  let part = "#{entry}.#{cli_sys.getpid()}.part"
  match write_file(part, "#{FORMAT}\n#{body}") {
    Ok(_) -> {
      let _ = file_rename(part, entry)
    }
    Err(_) -> ()
  }
}

# Every line naming a `.kai` source names the entry the user knows as `shown`.
fn own_report(text: String, shown: String) : Bool =
  list.all(cli_memo_key.lines(text), l => string.index_of(l, ".kai:").is_none() or string.index_of(l, "#{shown}:").is_some())

# An entry that does not parse, or whose stderr is not the length it
# records, is a miss.
fn load(entry: String) : Found / File =
  match read_file(entry) {
    Err(_) -> Missing
    Ok(s) -> match line_off(s) {
      Some(h) if h.fst == FORMAT -> if h.snd == "full\n" { Full } else { status_and_text(h.snd) }
      _ -> Missing
    }
  }

fn status_and_text(s: String) : Found =
  match line_off(s) {
    None -> Missing
    Some(r) -> match line_off(r.snd) {
      None -> Missing
      Some(n) -> match (string.to_int(r.fst), string.to_int(n.fst)) {
        (Some(rc), Some(len)) if len == string_length(n.snd) -> Found(rc, n.snd)
        _ -> Missing
      }
    }
  }

# The first line of `s` and what follows it.
fn line_off(s: String) : Option[(String, String)] =
  string.index_of(s, "\n").map(i => (string_slice(s, 0, i), string_slice(s, i + 1, string_length(s) - i - 1)))

# The key over the interfaces of the entry's imports, and the one over
# their full source.
fn keys_of(argv: [String], shown: String, err: String) : Option[(String, String)] / Env + File + Ffi {
  let entry = list.last(argv).unwrap_or("")
  let flags = list.take(argv, list.length(argv) - 1)
  let listing = cli_proc.capture(
    flags ++ ["--guard-interfaces", entry],
    cli_plan.kaic2_spawn([], "", "/dev/null"),
    "#{err}.inputs"
  )
  if listing.fst != 0 {
    None
  } else {
    let kaic2 = list.head(argv).unwrap_or("")
    let tool = match env.get(TOOLCHAIN_ENV) { Some(d) -> d  None -> toolchain_digest(kaic2) }
    let core = match env.get(CORE_ENV) { Some(d) -> d  None -> core_digest(kaic2, cli_fs.dirname(err)) }
    let imports = cli_memo_key.lines(listing.snd)
    let env_fields = cli_memo_key.kai_env()
    let key = (full) => {
      cli_sys.sha_reset()
      cli_sys.sha_str("#{FORMAT}\n#{tool}\n#{core}\n")
      argv |> foreach(a => cli_memo_key.field(if a == entry { shown } else { a }))
      cli_memo_key.feed_file("<entry>", entry)
      imports |> foreach(l => if full { cli_memo_key.feed_source(l) } else { cli_memo_key.feed_interface(l) })
      env_fields |> foreach(v => cli_memo_key.field(v))
      cli_sys.sha_hex()
    }
    Some((key(false), key(true)))
  }
}
