#[doc("The `[native]` table's `pkg-config` names, answered by the host's pkg-config at build time.")]

import cli_caches
import cli_err
import cli_nativedeps
import cli_proc

fn pc_query(
  tool: String,
  n: Native,
  what: String,
  tmp: String
) : Result[Native, Int] / Stderr + File + Ffi {
  let quiet = cli_proc.Spawn { ...cli_proc.inherit(), err: "#{tmp}/pkg-config.err" }
  let r = cli_proc.capture([tool, "--#{what}", n.value], quiet, "#{tmp}/pkg-config.out")
  if r.fst == 0 {
    Ok(Native { ...n, kind: "pc-#{what}", value: string.trim(r.snd) })
  } else {
    cli_err.fail(
      "#{cli_nativedeps.declarer(n)} declares pkg-config '#{n.value}', but #{tool} cannot resolve it (no usable #{n.value}.pc on PKG_CONFIG_PATH)",
      1
    )
  }
}

fn pc_answers(
  tool: String,
  pcs: [Native],
  tmp: String
) : Result[[Native], Int] / Stderr + File + Ffi =
  match pcs {
    [] -> Ok([])
    [n, ...rest] -> {
      let c = pc_query(tool, n, "cflags", tmp)!
      let l = pc_query(tool, n, "libs", tmp)!
      let more = pc_answers(tool, rest, tmp)!
      Ok([c, l, ...more])
    }
  }

#[doc("Answer every declared pkg-config name with its `--cflags` and `--libs`; fails naming the package and the `.pc` it cannot resolve.")]
pub fn resolve(info: [Native], tmp: String) : Result[[Native], Int] / Stderr + Env + File + Ffi {
  let pcs = info |? (n => n.kind == "pc")
  let tool = cli_caches.env_or("PKG_CONFIG", "pkg-config")
  if list.is_empty(pcs) {
    Ok(info)
  } else if cli_proc.which(tool) |> is_none() {
    pcs
      |> foreach(
        n => Stderr.eprint(
          "kai: error: #{cli_nativedeps.declarer(n)} declares pkg-config '#{n.value}' (#{n.value}.pc), but '#{tool}' cannot be found."
        )
      )
    Stderr.eprint(
      "kai: hint: install it (macOS: brew install pkgconf; Debian/Ubuntu: apt install pkg-config), or point PKG_CONFIG at one."
    )
    Err(2)
  } else {
    let answers = pc_answers(tool, pcs, tmp)!
    Ok(info ++ answers)
  }
}
