#[doc("`kai env`: the resolved installation, the contract every `kai-<verb>` plugin reads.")]

import cli_layout

#[doc("The variables `kai env` prints and a plugin inherits, in print order.")]
pub fn entries(l: Layout) : [(String, String)] / Env + Ffi = [
  ("KAIKAI_HOME", cli_layout.home(l)),
  ("KAI_STDLIB", l.stdlib),
  ("KAI_TOOLCHAIN_ID", cli_layout.toolchain_id(l))
]

fn usage() : String = """usage: kai env [<name>...]

Print the installation kai resolves, one NAME=value per line; with
names, print only their values, one per line. A 'kai-<command>' plugin
starts with these variables already exported.

Variables:
  KAIKAI_HOME       Install prefix (the checkout root in a dev tree).
  KAI_STDLIB        Stdlib root the compiler resolves imports against.
  KAI_TOOLCHAIN_ID  Compiler identity, <mtime>-<size>; keys the caches."""

fn lookup(es: [(String, String)], name: String) : Option[String] =
  es.find_map(e => if e.fst == name { Some(e.snd) } else { None })

fn print_values(es: [(String, String)], names: [String]) : Int / Stdout + Stderr =
  match names.find(n => lookup(es, n).is_none()) {
    Some(n) -> {
      Stderr.eprint(
        "kai: error: unknown variable '#{n}' (known: KAIKAI_HOME, KAI_STDLIB, KAI_TOOLCHAIN_ID)"
      )
      2
    }
    None -> {
      names |> foreach(n => Stdout.print(lookup(es, n).unwrap_or("")))
      0
    }
  }

#[doc("Run `kai env [<name>...]` and return the exit status.")]
pub fn run(l: Layout, args: [String]) : Int / Stdout + Stderr + Env + Ffi =
  match args {
    [a, ..._] if a == "-h" or a == "--help" -> {
      Stdout.print(usage())
      0
    }
    [] -> {
      entries(l) |> foreach(e => Stdout.print("#{e.fst}=#{e.snd}"))
      0
    }
    names -> print_values(entries(l), names)
  }
