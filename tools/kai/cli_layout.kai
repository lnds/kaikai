#[doc("Resolves the kaikai installation this kai runs from: a dev checkout or an installed prefix.")]

import os.env
import path
import cli_sys

#[doc("A resolved installation: its root, whether it is a dev checkout, and the paths every verb builds against.")]
pub type Layout = { root: String, dev: Bool, kaic2: String, stdlib: String }

# The binary sits two directories below the root in both layouts:
# `<root>/tools/kai/kai` in a checkout, `<root>/libexec/kaikai/kai` installed.
fn root_of(exe: String) : String {
  let abs = if path.is_absolute(exe) { exe } else { abspath(exe) }
  path.dirname(path.dirname(path.dirname(abs)))
}

fn nonempty_env(name: String) : Option[String] / Env =
  match env.get(name) {
    Some(v) if v != "" -> Some(v)
    _ -> None
  }

fn detect(root: String) : Option[Layout] / Ffi {
  let dev = cli_sys.is_dir("#{root}/stage0") and cli_sys.is_dir("#{root}/stdlib")
  let installed = cli_sys.is_exec("#{root}/libexec/kaikai/kaic2")
    and cli_sys.is_dir("#{root}/share/kaikai/stdlib")
  if dev {
    Some(Layout { root, dev: true, kaic2: "#{root}/stage2/kaic2", stdlib: "#{root}/stdlib" })
  } else if installed {
    Some(Layout {
      root,
      dev: false,
      kaic2: "#{root}/libexec/kaikai/kaic2",
      stdlib: "#{root}/share/kaikai/stdlib"
    })
  } else {
    None
  }
}

#[doc("Resolve the installation around the executable `exe`; `KAI_STDLIB` overrides the stdlib root.")]
pub fn resolve(exe: String) : Result[Layout, String] / Env + Ffi {
  let root = root_of(exe)
  match detect(root) {
    Some(l) -> Ok(Layout { ...l, stdlib: nonempty_env("KAI_STDLIB").unwrap_or(l.stdlib) })
    None -> Err(root)
  }
}

#[doc("Install prefix: the root, or `KAIKAI_HOME` when a dev checkout names another one.")]
pub fn home(l: Layout) : String / Env + Ffi =
  match nonempty_env("KAIKAI_HOME") {
    Some(h) if h != l.root and (not cli_sys.is_exec("#{l.root}/libexec/kaikai/kaic2")) -> h
    _ -> l.root
  }

#[doc("Toolchain id: the compiler's mtime and size, `<secs>-<bytes>`; empty when it cannot be stat'ed.")]
pub fn toolchain_id(l: Layout) : String / Ffi {
  let m = cli_sys.mtime(l.kaic2)
  let s = cli_sys.size(l.kaic2)
  if m < 0 or s < 0 { "" } else { "#{m}-#{s}" }
}

# Mirrors shell command substitution, which drops every trailing newline.
fn chomp(s: String) : String =
  if string.ends_with(s, "\n") { chomp(string_slice(s, 0, string_length(s) - 1)) } else { s }

#[doc("A toolchain metadata file (`VERSION`, `EDITION`) from the root or `share/kaikai`, or `unknown`.")]
pub fn meta(l: Layout, name: String) : String / File =
  match read_file("#{l.root}/#{name}") {
    Ok(s) -> chomp(s)
    Err(_) -> match read_file("#{l.root}/share/kaikai/#{name}") {
      Ok(s) -> chomp(s)
      Err(_) -> "unknown"
    }
  }
