#[doc("Running a `wasm32-wasi` module on the WASI runtime found on `PATH`.")]

import os.env
import cli_err
import cli_proc

const RUNTIME : String = "wasmtime"

#[doc("The directories a module may reach, `:`-separated; the current directory when unset.")]
pub const DIRS_VAR : String = "KAI_WASI_DIRS"

#[doc("The WASI runtime on `PATH`, or an error naming what to install.")]
pub fn runtime() : Result[String, Int] / Stderr + Env + Ffi =
  match cli_proc.which(RUNTIME) {
    Some(p) -> Ok(p)
    None -> cli_err.die(
      "kai run --target=wasm32-wasi needs `#{RUNTIME}` on PATH (https://wasmtime.dev); `kai build --target=wasm32-wasi` produces the module without it"
    )
  }

fn preopens() : [String] / Env {
  let dirs = match env.get(DIRS_VAR) {
    Some(d) if d != "" -> string.split(d, ":") |> list.filter(x => x != "")
    _ -> ["."]
  }
  dirs | (d => "--dir=#{d}")
}

#[doc("Run `wasm` on `runtime` with `args`, the environment and the preopened directories; the program's status.")]
pub fn run_module(runtime: String, wasm: String, args: [String]) : Int / Env + Ffi =
  cli_proc.run(
    [runtime, "run", "-S", "inherit-env", ...preopens()] ++ ["--", wasm] ++ args,
    cli_proc.inherit()
  )
