#[doc("The `kai` command: core verbs run here; any other verb runs `kai-<verb>` from PATH.")]

import os.env
import cli_build
import cli_env
import cli_layout
import cli_plugin
import cli_sys
import cli_toolchain
import cli_usage

# Core verbs the bin/kai wrapper still serves itself. A plugin never shadows one.
const WRAPPER_VERBS : [String] = [
  "test", "bench", "check", "typecheck", "lint", "fmt", "migrate",
  "mutate", "watch", "init", "fetch", "install", "add", "update", "upgrade", "show",
  "lsp", "info", "doc", "--version", "-V"
]

fn plugin_for(verb: String) : Option[String] / Env + Ffi =
  if WRAPPER_VERBS.contains(verb) { None } else { cli_plugin.find(verb) }

fn unknown(l: Layout, verb: String) : Int / Stderr + File {
  Stderr.eprint("kai: error: unknown command: #{verb}")
  Stderr.eprint(cli_usage.text(l))
  2
}

# The verbs that compile: the deep-recursing compiler needs a 32 MiB stack, and
# every child resolves the stdlib this kai does.
fn core(
  l: Layout,
  args: [String],
  verb: (Toolchain, [String]) -> Result[Int, Int] / e
) : Int / Env + File + Ffi + e {
  cli_sys.raise_stack(33554432)
  let _ = env.set("KAIKAI_STDLIB_PATH", l.stdlib)
  match verb(cli_toolchain.resolve(l), args) {
    Ok(code) -> code
    Err(code) -> code
  }
}

# The runtime prints these reports at exit; they belong to the user's program, not to kai.
fn quiet_exit_reports() : Unit / Env {
  let _ = env.unset("KAI_TRACE_RC")
  let _ = env.unset("KAI_PROFILE_RC")
}

fn dispatch(l: Layout, argv: [String]) : Int / Stdout + Stderr + Env + File + Ffi =
  match argv {
    [] -> {
      Stderr.eprint(cli_usage.text(l))
      2
    }
    [v, ..._] if v == "help" or v == "-h" or v == "--help" -> {
      Stdout.print(cli_usage.text(l))
      0
    }
    ["env", ...rest] -> cli_env.run(l, rest)
    ["build", ...rest] -> core(l, rest, cli_build.build)
    ["run", ...rest] -> core(l, rest, cli_build.run)
    [v, ...rest] -> match plugin_for(v) {
      Some(prog) -> cli_plugin.launch(l, prog, rest)
      None -> unknown(l, v)
    }
  }

fn main() : Int / Stdout + Stderr + Env + File + Ffi =
  match cli_layout.resolve(program_name()) {
    Ok(l) -> {
      let code = dispatch(l, Env.args())
      quiet_exit_reports()
      code
    }
    Err(root) -> {
      Stderr.eprint("kai: error: cannot find kaikai installation under #{root}")
      Stderr.eprint(
        "  expected dev layout (stage0/, stdlib/) or installed layout (libexec/kaikai/, share/kaikai/)"
      )
      2
    }
  }
