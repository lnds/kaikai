#[doc("Where the binary memo keeps its entries, and how a binary moves in and out of one.")]

import cli_guard_memo
import cli_memo_key
import cli_proc
import cli_sys

#[doc("The memo directory: the package's user cache, else the shared core cache, or empty when the build has neither.")]
pub fn dir(flags: [String]) : String =
  match cli_memo_key.user_cache_dir(flags) {
    "" -> under(core_cache_dir(flags))
    d -> under(d)
  }

fn under(d: String) : String = if d == "" { "" } else { "#{d}/bins" }

fn core_cache_dir(flags: [String]) : String =
  match flags {
    [] -> ""
    ["--core-cache-dir", d, ..._] -> d
    [_, ...rest] -> core_cache_dir(rest)
  }

#[doc("""
The compiler's digest. Hashing the compiler costs more than a warm
build, so the digest is kept in `dir` under the compiler's mtime and
size, the identity every cache of the compiler is already keyed by.
""")]
pub fn toolchain_digest(dir: String, kaic2: String) : String / File + Ffi {
  let id = "#{cli_sys.mtime(kaic2)}-#{cli_sys.size(kaic2)} "
  let file = "#{dir}/toolchain"
  match read_file(file) {
    Ok(s) if string.starts_with(s, id) -> string_slice(s, string_length(id), string_length(s))
    _ -> stored(file, id, cli_guard_memo.toolchain_digest(kaic2))
  }
}

fn stored(file: String, id: String, d: String) : String / File + Ffi {
  let part = "#{file}.#{cli_sys.getpid()}.part"
  if write_file(part, "#{id}#{d}").is_ok() { let _ = file_rename(part, file) }
  d
}

#[doc("""
Put the binary `from` at `to`. A run's binary sits in a scratch
directory nothing writes again, so it shares the file: macOS assesses
every new executable file on its first exec, which costs more than a
warm build, and a link to a file already run is not new. A test
binary's path is rewritten by later builds, so it gets a copy.
""")]
pub fn put(verb: String, from: String, to: String) : Bool / Ffi =
  (verb == "run" and quiet(["ln", "-f", from, to])) or copied(from, to)

#[doc("Copy `from` to `to`.")]
pub fn copied(from: String, to: String) : Bool / Ffi = quiet(["cp", from, to])

#[doc("Run `argv` with its output discarded; whether it succeeded.")]
pub fn quiet(argv: [String]) : Bool / Ffi =
  cli_proc.run(argv, cli_proc.Spawn { ...cli_proc.inherit(), out: "/dev/null", err: "/dev/null" }) == 0
