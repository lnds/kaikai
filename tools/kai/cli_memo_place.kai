#[doc("Where the binary memo keeps its entries, and how a binary moves in and out of one.")]

import os.env
import cli_fs
import cli_guard_memo
import cli_memo_key
import cli_sys

#[doc("The memo directory: the package's user cache, else the shared core cache, or empty when the build has neither.")]
pub fn dir(flags: [String]) : String =
  match cli_memo_key.user_cache_dir(flags) {
    "" -> under(core_cache_dir(flags))
    d -> under(d)
  }

fn under(d: String) : String = if d == "" { "" } else { "#{d}/bins" }

fn core_cache_dir(flags: [String]) : String =
  match flags {
    [] -> ""
    ["--core-cache-dir", d, ..._] -> d
    [_, ...rest] -> core_cache_dir(rest)
  }

#[doc("""
The compiler's digest. Hashing the compiler costs more than a warm
build, so the digest is kept in `dir` under the compiler's mtime and
size, the identity every cache of the compiler is already keyed by.
""")]
pub fn toolchain_digest(dir: String, kaic2: String) : String / File + Ffi {
  let id = "#{cli_sys.mtime(kaic2)}-#{cli_sys.size(kaic2)} "
  let file = "#{dir}/toolchain"
  match read_file(file) {
    Ok(s) if string.starts_with(s, id) -> string_slice(s, string_length(id), string_length(s))
    _ -> stored(file, id, cli_guard_memo.toolchain_digest(kaic2))
  }
}

#[doc("""
The digest of the core modules and their imports, by path and content.
Which sources those are depends on the compiler alone, so the listing is
kept in `dir` under the compiler's identity, and each source is read
through `file_digests`: a warm build asks the compiler nothing and reads
no core source.
""")]
pub fn core_digest(dir: String, kaic2: String, scratch: String) : String / File + Ffi {
  let sources = core_sources(dir, kaic2, scratch)
  let digests = file_digests(dir, sources | (l => string.drop_prefix(l, "-").unwrap_or(l)))
  cli_sys.sha_reset()
  list.zip(sources, digests) |> foreach(sd => cli_memo_key.field("#{sd.fst} #{sd.snd}"))
  cli_sys.sha_hex()
}

# One line per core source, a `-` path for one that does not exist.
fn core_sources(dir: String, kaic2: String, scratch: String) : [String] / File + Ffi {
  let id = "#{cli_sys.mtime(kaic2)}-#{cli_sys.size(kaic2)}"
  let file = "#{dir}/core-sources"
  match read_file(file) {
    Ok(s) -> match cli_memo_key.lines(s) {
      [was, ...sources] -> if was == id { sources } else { core_asked(file, id, kaic2, scratch) }
      _ -> core_asked(file, id, kaic2, scratch)
    }
    Err(_) -> core_asked(file, id, kaic2, scratch)
  }
}

# A listing the compiler failed to give is not kept, and digests apart
# from any it gives.
fn core_asked(file: String, id: String, kaic2: String, scratch: String) : [String] / File + Ffi {
  let listing = cli_guard_memo.core_listing(kaic2, scratch)
  let sources = cli_memo_key.lines(listing.snd)
  if listing.fst != 0 {
    ["-failed #{int_to_string(listing.fst)}", ...sources]
  } else {
    let part = "#{file}.#{cli_sys.getpid()}.part"
    if cli_fs.mkdir_p(cli_fs.dirname(file)) and write_file(part, string.join([id, ...sources], "\n")).is_ok() {
      let _ = file_rename(part, file)
    }
    sources
  }
}

#[doc("""
The content digest of each of `files`, in order, empty for one that is
not a file. A digest is kept in `dir` under what told the file's state
apart when it was read, so a runtime header or a library is read once
and not on every build; a file written in the last two seconds is read
every time. The digests kept for other files stay.
""")]
pub fn file_digests(dir: String, files: [String]) : [String] / File + Ffi {
  let store = "#{dir}/files"
  let kept = match read_file(store) {
    Ok(s) -> cli_memo_key.lines(s)
    Err(_) -> []
  }
  let rows = files | (f => digest_row(kept, f))
  if list.any(rows, r => r.taken and r.settled) {
    let others = kept |? (l => not list.any(files, f => string.starts_with(l, "#{f}\t")))
    let part = "#{store}.#{cli_sys.getpid()}.part"
    if cli_fs.mkdir_p(dir) and write_file(part, string.join(others ++ (rows |? (r => r.settled) | (r => r.line)), "\n")).is_ok() {
      let _ = file_rename(part, store)
    }
  }
  rows | (r => r.digest)
}

# One file's digest: the kept `line` (path, state, digest), whether it was
# `taken` now, and whether the file is `settled` enough to keep it.
type DigestRow = { line: String, digest: String, taken: Bool, settled: Bool }

# The state is taken before the file is read, so a write in between leaves
# a state that no longer matches.
fn digest_row(kept: [String], f: String) : DigestRow / Ffi =
  if f == "" or not cli_sys.is_file(f) {
    DigestRow { line: "", digest: "", taken: false, settled: false }
  } else {
    let head = "#{f}\t#{cli_sys.stat_id(f)}\t"
    match list.find(kept, l => string.starts_with(l, head)) {
      Some(l) -> DigestRow { line: l, digest: string_slice(l, string_length(head), string_length(l)), taken: false, settled: true }
      None -> {
        cli_sys.sha_reset()
        cli_memo_key.field(int_to_string(cli_sys.size(f)))
        let _ = cli_sys.sha_file(f)
        let d = cli_sys.sha_hex()
        DigestRow { line: "#{head}#{d}", digest: d, taken: true, settled: cli_sys.settled(f) }
      }
    }
  }

fn stored(file: String, id: String, d: String) : String / File + Ffi {
  let part = "#{file}.#{cli_sys.getpid()}.part"
  if write_file(part, "#{id}#{d}").is_ok() { let _ = file_rename(part, file) }
  d
}

#[doc("""
Put the binary `from` at `to`. A run's binary sits in a scratch
directory nothing writes again, so it shares the file: macOS assesses
every new executable file on its first exec, which costs more than a
warm build, and a link to a file already run is not new. A test
binary's path is rewritten by later builds, so it gets a copy.
""")]
pub fn put(verb: String, from: String, to: String) : Bool / Ffi =
  (verb == "run" and cli_sys.link_file(from, to)) or cli_sys.same_bytes(from, to) or copied(from, to)

#[doc("Start keeping the compiler diagnostics a build replays, in a file under `tmp`; its path. `stop_diags` stops.")]
pub fn record_diags(tmp: String) : String / Ffi {
  let f = "#{tmp}/bin-memo.err"
  let _ = cli_sys.remove_tree(f)
  cli_sys.tee_compile_stderr(f)
  f
}

#[doc("Stop what `record_diags` started.")]
pub fn stop_diags() : Unit / Ffi = cli_sys.tee_compile_stderr("")

#[doc("Put the diagnostics `record_diags` kept into the entry being staged in `part`, when the build printed any.")]
pub fn keep_diags(diags: String, part: String) : Bool / Ffi =
  (not cli_sys.is_file(diags)) or copied(diags, "#{part}/err")

#[doc("Print the diagnostics kept in `entry`, as the build that made it printed them.")]
pub fn replay_diags(entry: String) : Unit / Ffi = cli_sys.copy_to_stderr("#{entry}/err")

#[doc("True when `KAI_BIN_MEMO=0`, or when the run asks for cache statistics, which describe a compile.")]
pub fn off() : Bool / Env =
  env.get("KAI_BIN_MEMO").unwrap_or("") == "0" or (STATS_ENV |> list.any(v => env.get(v).unwrap_or("") == "1"))

const STATS_ENV : [String] = ["KAI_CORE_CACHE_STATS", "KAI_MODULAR_STATS"]

#[doc("Copy `from` to `to`.")]
pub fn copied(from: String, to: String) : Bool / Ffi = cli_sys.copy_file(from, to)
