#[doc("What the build memos key on: length-prefixed fields, files by size and bytes, and the `KAI` environment, fed into one running digest.")]

import os.env
import cli_sys

#[doc("Feed `s`, length-prefixed so no two splits of the same bytes digest alike.")]
pub fn field(s: String) : Unit / Ffi = cli_sys.sha_str("#{string_length(s)}:#{s}")

#[doc("Feed the file `file` under `label`: its size, then its bytes.")]
pub fn feed_file(label: String, file: String) : Unit / Ffi {
  field(label)
  field(int_to_string(cli_sys.size(file)))
  let _ = cli_sys.sha_file(file)
}

#[doc("Feed one line of a `kaic2 --guard-inputs` listing: a source, or a `-` path that does not exist yet.")]
pub fn feed_input(line: String) : Unit / Ffi =
  if string.starts_with(line, "-") { field("missing #{line}") } else { feed_file(line, line) }

#[doc("The non-empty lines of `s`.")]
pub fn lines(s: String) : [String] = string.split(s, "\n") |? (l => l != "")

#[doc("The package's user cache directory named in `argv`, or empty.")]
pub fn user_cache_dir(argv: [String]) : String =
  match argv {
    [] -> ""
    ["--user-cache-dir", d, ..._] -> d
    [_, ...rest] -> user_cache_dir(rest)
  }

#[doc("""
The `KAI*` variables the compiler reads, as sorted `NAME=value` lines.
`KAI_TEST_*` belong to the test binaries and the runner and carry per-run
paths; `KAI_GUARD_*` and `KAI_BIN_MEMO` steer the memos themselves, and
the compiler binary is keyed on its own.
""")]
pub fn kai_env() : [String] / Env =
  env.entries()
    |? (p => string.starts_with(p.fst, "KAI")
      and (not string.starts_with(p.fst, "KAI_TEST_"))
      and (not string.starts_with(p.fst, "KAI_GUARD_"))
      and p.fst != "KAI_BIN_MEMO")
    | (p => "#{p.fst}=#{p.snd}")
    |> list.sort
