#[doc("""
The generated `kai_ffi.h`: the C typedefs of a program's `extern "C" type`
structs, which a hand-written C source includes to name the same types.
The compile writes it as a by-product under the build's scratch dir, and
its directory joins the include path of the C sources the build compiles
by hand.
""")]

import cli_sys

const NAME : String = "kai_ffi.h"

#[doc("The scratch directory that holds the header of a build.")]
pub fn dir_for(tmp: String) : String = "#{tmp}/ffi-header"

#[doc("The kaic2 flag that has a compile write the header into `dir`.")]
pub fn flag(dir: String) : [String] = ["--ffi-header-out", "#{dir}/#{NAME}"]

#[doc("The include flags of the header a compile wrote into `dir`; none when `dir` is empty or the program declared no struct.")]
pub fn include(dir: String) : [String] / Ffi =
  if dir != "" and cli_sys.is_file("#{dir}/#{NAME}") { ["-I", dir] } else { [] }

#[doc("The header's path inside `dir`.")]
pub fn path_in(dir: String) : String = "#{dir}/#{NAME}"
