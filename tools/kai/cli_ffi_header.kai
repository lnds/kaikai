#[doc("""
The generated `kai_ffi.h`: the C typedefs of a program's `extern "C" type`
structs, which a hand-written C source includes to name the same types.
It is written per build, under the build's scratch dir, and put on the
include path of the C sources the build compiles by hand.
""")]

import cli_fs
import cli_proc
import cli_sys

const NAME : String = "kai_ffi.h"

#[doc("Whether any of `files` names the generated header.")]
pub fn mentioned_in(files: [String]) : Bool / File + Ffi =
  files |> list.any(f => string_contains(cli_fs.read_or_empty(f), NAME))

#[doc("The scratch directory that holds the header of the build writing `out`.")]
pub fn dir_for(tmp: String, out: String) : String = "#{tmp}/ffi-#{cli_fs.basename(out)}"

#[doc("The header's path inside `dir`.")]
pub fn path_in(dir: String) : String = "#{dir}/#{NAME}"

#[doc("Write the header into `dir` by running `argv` (kaic2 `--emit=ffi-header`); `dir`, or empty when kaic2 fails or the program declares no struct.")]
pub fn generate(argv: [String], dir: String) : String / File + Ffi {
  let header = path_in(dir)
  let quiet = cli_proc.Spawn {
    ...cli_proc.inherit(),
    out: header,
    err: "/dev/null",
    unset: ["KAI_TRACE_RC"]
  }
  if cli_fs.mkdir_p(dir) and cli_proc.run(argv, quiet) == 0 and cli_sys.size(header) > 0 {
    dir
  } else {
    let _ = file_delete(header)
    ""
  }
}
