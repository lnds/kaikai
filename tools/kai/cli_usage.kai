#[doc("The top-level `kai` help text and the `--version` banner.")]

import cli_fs
import cli_layout
import cli_proc
import cli_sys

#[doc("The text `kai help` prints: banner, commands, and environment knobs.")]
pub fn text(l: Layout) : String / File {
  let v = cli_layout.meta(l, "VERSION")
  string.join(
    [
      " _      _ _      _",
      "| |____(_) |____(_)    kaikai #{v}",
      "| / / _` | / / _` |    a statically typed functional language",
      "|_\\_\\__,_|_\\_\\__,_|    effects | fibers | protocols",
      "",
      "usage: kai <command> [args...]",
      "",
      "Commands:",
      "  build [<spec>] [-o <out>]     Compile a kaikai package or file. With no",
      "                                <spec> the cwd package's entry point is used.",
      "  run   [<spec>] [args...]      Build and execute; forwards remaining args.",
      "  test  [<spec>|./...]          Compile with --test and run. './...' walks",
      "                                every kai.toml under cwd.",
      "  bench [--iters N] [<spec>]    Compile with --bench and run.",
      "  check [<spec>]                Compile with --prop-check and run property",
      "                                blocks (issue #44).",
      "  typecheck [<spec>]            Front-end only: report type/effect errors",
      "                                and stop. No codegen, no link — the fast",
      "                                edit-loop answer. JSON report flags ride",
      "                                here (see 'kai typecheck --help').",
      "  lint  [<spec>] [--json]       Clippy-style linter over the typed AST;",
      "                                flags suspect-but-valid code. Warnings",
      "                                only — never blocks a build.",
      "  fmt   [<spec>] [--check]      Pretty-print kaikai source canonically",
      "                                (--width N sets the line width).",
      "  migrate [<file>] [--write]    Rewrite source across an edition bump",
      "                                (dry-run by default; --write applies).",
      "  mutate [<spec>] [--limit N]   Mutation testing: break one construct at",
      "                                a time and report what the suite did not",
      "                                notice. --oracle sets the command that",
      "                                judges a mutant (default 'kai test').",
      "  watch [<spec>]                Recompile + run on every save (live demo).",
      "  init  <name>                  Create a kai.toml manifest in the cwd.",
      "  add   <source>[@<ref>]        Fetch a dep and append it to kai.toml.",
      "  fetch                         Resolve dependencies (git fetch + lock).",
      "  install [<spec>] [--force]    Build a package and install its binary",
      "                                into $KAIKAI_HOME/bin. <spec> is '.' or",
      "                                a git source; --list shows what is",
      "                                installed. With no <spec> it still",
      "                                resolves dependencies (deprecated —",
      "                                use 'kai fetch').",
      "  update [<name>]               Re-fetch deps; refresh kai.lock.",
      "  upgrade                       Self-update the compiler to the latest",
      "                                release (curl|sh installs). Defers to",
      "                                'brew upgrade kaikai' on brew installs.",
      "  show                          Print the parsed kai.toml.",
      "  lsp                           Language Server (JSON-RPC over stdio).",
      "  info [<topic>] [--json]       Reference pages (man/info style). Run",
      "                                'kai info' for the topic list, or",
      "                                'kai info syntax' for the one-page",
      "                                cheat sheet of forms kaikai has.",
      "  doc  [<module>[.<symbol>]]    Read stdlib docs. 'kai doc' lists",
      "                                modules; 'kai doc <module>' lists its",
      "                                items; 'kai doc <module>.<symbol>'",
      "                                shows a symbol's signature + doc.",
      "  help                          Show this help.",
      "  env [<name>...]               Print the resolved install: KAIKAI_HOME,",
      "                                KAI_STDLIB and KAI_TOOLCHAIN_ID.",
      "  --version                     Print version and demo baseline.",
      "",
      "A <spec> is one of: a path to a .kai file (legacy file mode), '.' or",
      "omitted (the current directory's package, read from kai.toml), or",
      "'./<sub>' where <sub> is a directory carrying its own kai.toml.",
      "",
      "Run 'kai <command> --help' for command-specific options. Any other",
      "<command> runs 'kai-<command>' from PATH with the 'kai env' variables",
      "exported.",
      "",
      "Environment:",
      "  CC               C compiler to invoke (default: cc).",
      "  CFLAGS           Extra flags passed to CC. `.c` sources listed here",
      "                   (FFI shims) are compiled into the final link.",
      "  KAI_BACKEND      Default backend (c|native) for `kai build` /",
      "                   `kai run` when --backend is not passed. Overridden by",
      "                   --backend; defaults to `native` (the in-process libLLVM",
      "                   path — no clang, no .ll text — since the Lane 1.5 flip).",
      "                   `c` is the portable C-text backend, the bootstrap path",
      "                   and parity oracle. A kaic2 built without libLLVM cannot",
      "                   run `native`: the implicit default degrades to `c` with",
      "                   a note, but an explicit `native` here errors.",
      "  KAI_NATIVE_OPT   Optimisation level for the native backend's in-process",
      "                   LLVM pipeline: 0|1|2|3|s|z (default: 2). Set by",
      "                   `--debug` (0) / `--release` (2); the C backend",
      "                   ignores it.",
      "  KAI_NATIVE_CORE_OBJ  Set to 0 to disable the native core-object cache",
      "                   (the content-addressed prebuilt stdlib-core object a",
      "                   native build links instead of re-emitting the core).",
      "                   On by default whenever the shared core cache is active;",
      "                   KAI_CORE_CACHE=0 disables it along with the rest.",
      "  KAI_NATIVE_DEAD_STRIP  Set to 0 to keep unreferenced functions in a",
      "                   native binary (skip the link-time dead-strip). On by",
      "                   default; `--debug` builds always skip it.",
      "  KAI_STDLIB       Override the stdlib root directory (default: auto-detected",
      "                   from the script's location — share/kaikai/stdlib if installed,",
      "                   stdlib/ if running from a dev checkout).",
      "  KAI_INCLUDE      Override the runtime.h include directory (default: auto-",
      "                   detected — share/kaikai/include if installed, stage0/ if dev).",
      "",
      "See README.md and docs/ for the language reference.",
      "Project home: https://kaikai-lang.org"
    ],
    "\n"
  )
}

# Whether native builds inline the runtime bitcode, so a pasted `--version` carries it.
fn p2_state(t: Toolchain, tmp: String) : String / File + Ffi {
  let gen = "#{t.layout.root}/tools/gen-runtime-bc.sh"
  if t.llvm_bc != "" and t.inline_bc == "" {
    "degraded (runtime_inline.bc missing: native builds lose the core-object cache; --emit=native-modular skips runtime inlining)"
  } else if t.llvm_bc != "" {
    "active"
  } else if cli_sys.is_exec(gen) and needs_regen(gen, tmp) {
    "optout (bitcode not generated; run: make KAI_LLVM=1 kaic2)"
  } else {
    "optout (no clang 18; brew install llvm@18 / apt-get install clang-18)"
  }
}

fn needs_regen(gen: String, tmp: String) : Bool / File + Ffi {
  let sp = cli_proc.Spawn { ...cli_proc.inherit(), err: "/dev/null" }
  let out = cli_proc.capture([gen, "--status"], sp, "#{tmp}/p2-status").snd
  string.drop_suffix(out, "\n").unwrap_or(out) == "optout needs-regen"
}

#[doc("`kai --version`: version, edition, demos baseline and the native P2 state.")]
pub fn version(t: Toolchain, args: [String]) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi {
  let l = t.layout
  cli_fs.with_scratch(tmp => {
    Stdout.print("kaikai #{cli_layout.meta(l, "VERSION")} - #{cli_layout.meta(l, "EDITION")} (stage 2, self-hosted)")
    Stdout.print("demos baseline: #{cli_layout.meta_or(l, "demos/baseline.txt", "?")}")
    Stdout.print("native p2:      #{p2_state(t, tmp)}")
    Stdout.print("home:           https://kaikai-lang.org")
    Ok(0)
  })
}
