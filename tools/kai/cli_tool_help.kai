#[doc("Help texts of the source-tool verbs: `kai lint`, `kai fmt`, `kai migrate`, `kai watch`, `kai mutate`, `kai lsp`, `kai doc`, `kai info`.")]

#[doc("The text `kai lint --help` prints.")]
pub fn lint_text() : String =
  string.join(
    [
      "usage: kai lint [--json] [<spec>]",
      "",
      "Run the Clippy-style linter over a kaikai source: flag suspicious-but-",
      "valid code the compiler core stays silent about. Reuses the typed AST +",
      "effect rows the compiler already produces; it never changes what",
      "compiles. Warnings only — kai lint always exits 0, so a lint never",
      "blocks a build.",
      "",
      "<spec> is a .kai file or a package ('.' / './<sub>'). A package with",
      "an entry point is linted once from that entry; a package without one",
      "— a library — is linted module by module.",
      "",
      "Rules:",
      "  discard_pure_value          point_free_nudge",
      "  and_then_to_map_nudge       match_option_to_combinator",
      "  redundant_if_bool           redundant_match_catchall",
      "  dead_code_unused_priv       effect_over_declared",
      "  effect_ffi_without_extern   list_concat_literal_to_spread",
      "",
      "  Run `kai info lint` for what each one flags and why.",
      "",
      "Output:",
      "  default   <file>:<line>:<col>: warning: <message> [<rule>]",
      "  --json    a JSON array of {file, line, col, rule, severity, message}",
      "",
      "Options:",
      "  --json       Emit findings as JSON instead of human-readable text.",
      "  -h, --help   Show this help.",
      "",
      "Examples:",
      "  kai lint src/main.kai",
      "  kai lint .",
      "  kai lint --json src/main.kai"
    ],
    "\n"
  )

#[doc("The text `kai fmt --help` prints.")]
pub fn fmt_text() : String =
  string.join(
    [
      "usage: kai fmt [--width N] <file.kai>            # rewrite file in place",
      "       kai fmt [--width N] [. | ./<pkg>]         # rewrite the whole package",
      "       kai fmt [--width N] --check <target>      # exit 0 if formatted, 1 if not",
      "       kai fmt [--width N] --stdin               # read stdin -> formatted to stdout",
      "",
      "Pretty-print kaikai source canonically. The formatter is gofmt-style:",
      "one output, idempotent, and it lays code out against a line width:",
      "a construct that fits on its line stays there, one that does not",
      "breaks at its own points (after `=`, one argument per line, one",
      "pipe stage per line), and a line break the author already wrote at",
      "one of those points is kept.",
      "",
      "Scope: the full language surface — effects, handlers, protocols,",
      "impls, units, dim types, refinements, axioms, generic fn / type",
      "parameters, var, and parametric effect rows all format. A file is",
      "refused only when it does not parse.",
      "",
      "Options:",
      "  --width N    Line width in columns. Defaults to the `width` key of",
      "               the package's kai.toml `[fmt]` table, else 100.",
      "  --check      Do not modify the file. Exit 0 if already formatted; 1",
      "               otherwise. Print the formatted output to stdout when",
      "               different (single file), or the list of files that",
      "               would change (package form).",
      "  --stdin      Read kaikai source from stdin; write formatted source",
      "               to stdout. The file form (kai fmt <file>) rewrites the",
      "               file in place; this form is for editor integrations.",
      "  -h, --help   Show this help.",
      "",
      "A package form (`.`, `./<pkg>`, or no argument) formats every .kai",
      "file the package owns — sibling modules covered by the package root",
      "plus the tests/ sibling — not just the entry point.",
      "",
      "Examples:",
      "  kai fmt stage2/compiler.kai",
      "  kai fmt              # every .kai file in the current package",
      "  kai fmt --check .    # list unformatted files; exit 1 if any",
      "  kai fmt --check src/foo.kai && echo OK",
      "  cat src/foo.kai | kai fmt --stdin > /tmp/foo-fmt.kai"
    ],
    "\n"
  )

#[doc("The text `kai migrate --help` prints.")]
pub fn migrate_text() : String =
  string.join(
    [
      "usage: kai migrate [--from <edition>] [--to <edition>] [--write] <file.kai>",
      "",
      "Rewrite a package's source from one edition's surface to the next,",
      "applying each mechanical breaking change the edition bump introduced",
      "(renames, signature shifts). It is an AST rewrite through the parser +",
      "the fmt-writer, so it never corrupts code: the output is reparsed",
      "before anything is written, and a change with no automatic rule is",
      "reported as 'manual: ...' rather than silently dropped.",
      "",
      "Safe by default — dry-run: the migrated source is printed to stdout and",
      "NO file is touched. Pass --write to rewrite the file in place. Running",
      "--write twice is a byte-stable no-op (idempotent): --write also stamps",
      "the target edition into kai.toml, so the second run resolves --from to",
      "the new edition and applies no rules.",
      "",
      "Editions default to the current edition (from kai.toml or EDITION) as",
      "--from and its successor as --to. Only hanga-roa -> orongo is supported.",
      "",
      "Options:",
      "  --from <edition>   Source edition (default: package/repo edition).",
      "  --to <edition>     Target edition (default: the successor edition).",
      "  --write            Apply the rewrite in place instead of dry-run.",
      "  -h, --help         Show this help.",
      "",
      "Examples:",
      "  kai migrate src/main.kai                 # dry-run: print migrated source",
      "  kai migrate --write src/main.kai         # apply in place",
      "  kai migrate --from hanga-roa --to orongo src/main.kai"
    ],
    "\n"
  )

#[doc("The text `kai watch --help` prints.")]
pub fn watch_text() : String =
  string.join(
    [
      "usage: kai watch <file.kai> [args...]",
      "",
      "Watch a kaikai source file and recompile + run it on every save.",
      "Useful for live demos: edit in one pane, see output in the other.",
      "",
      "Behavior:",
      "  - On entry, the file is compiled and run once.",
      "  - On each save, the screen prints a timestamped header followed by",
      "    the compile result. Build errors keep the watch loop alive.",
      "  - Press Ctrl+C to exit.",
      "",
      "Backend:",
      "  - If fswatch is on PATH, kai uses it (one event per save).",
      "  - Otherwise, kai falls back to a 500 ms mtime poll. Install",
      "    fswatch (brew install fswatch) for lower latency.",
      "",
      "Options:",
      "  -h, --help   Show this help.",
      "",
      "Examples:",
      "  kai watch demo.kai",
      "  kai watch examples/minimal/hello.kai"
    ],
    "\n"
  )

#[doc("The text `kai mutate --help` prints.")]
pub fn mutate_text() : String =
  string.join(
    [
      "usage: kai mutate [<spec>] [--oracle <cmd>] [--module <file>] [--operator <name>]",
      "                  [--limit <n>] [--list] [--json]",
      "",
      "Break the code on purpose and ask whether anything notices.",
      "",
      "kai mutate rewrites one construct at a time — a dropped `match` arm, a",
      "shifted comparison, a swapped connective — and runs an oracle against",
      "each mutant. A mutant the oracle rejects is KILLED: something noticed. A",
      "mutant that survives is a hole in the suite, reported with its file,",
      "line, operator and diff.",
      "",
      "Mutations come from the AST, never a text scan: a rewritten string",
      "literal or comment is noise. Each mutant is the original source with one",
      "token span replaced, so its diff against the parent is the mutation and",
      "nothing else.",
      "",
      "The oracle is any command that exits 0 when the code is healthy. The",
      "default is `kai test`, which suits a package with `test` blocks; a",
      "codebase whose real suite is a fixture corpus or a script points",
      "--oracle at that instead.",
      "",
      "Operators, in the order they are applied:",
      "  arm        drop a match arm — a case that stops being handled",
      "  compare    shift a comparison boundary (`>=` -> `>`)",
      "  connect    swap a boolean connective (`and` -> `or`)",
      "  negate     invert a condition (`if c` -> `if not c`)",
      "  literal    perturb a literal (`0` -> `1`)",
      "  call       elide a call, keeping its argument (`f(x)` -> `x`)",
      "",
      "Output:",
      "  SURVIVED   the oracle accepted the mutant — a hole worth a fixture",
      "  killed     the oracle rejected it, as it should",
      "  compile    the mutant did not build; a kill, but the least",
      "             interesting kind, so it is counted separately",
      "",
      "Reported as survivors, never as a percentage: a survivor is actionable,",
      "a score is a number nobody acts on.",
      "",
      "Equivalent mutants — ones that mean exactly what the original meant and",
      "so can never be killed — are suppressed via",
      "tools/mutate-known-equivalent.txt, keyed `<file>:<line>:<operator>` with",
      "a written reason after a `#`. An entry with no reason is an error, not a",
      "suppression.",
      "",
      "Options:",
      "  --oracle <cmd>     Command judged by exit code; 0 = healthy. Default `kai test`.",
      "  --module <file>    Mutate only this file. Default: every module the package owns.",
      "  --operator <name>  Apply only this operator. Repeatable.",
      "  --limit <n>        Stop after n mutants. Useful for a first look.",
      "  --list             List the mutation sites and exit; run nothing.",
      "  --json             Machine-readable output.",
      "  -h, --help         Show this help.",
      "",
      "Cost: every mutant re-runs the oracle. When the oracle rebuilds a",
      "compiler that is minutes per mutant, so start with --limit and a single",
      "--module — survivors are found long before a full run finishes.",
      "",
      "Examples:",
      "  kai mutate",
      "  kai mutate --limit 20 --operator arm",
      "  kai mutate --module src/parser.kai --oracle './run-tests.sh'"
    ],
    "\n"
  )

#[doc("The text `kai lsp --help` prints.")]
pub fn lsp_text() : String =
  string.join(
    [
      "usage: kai lsp",
      "",
      "Run the Language Server. Speaks LSP JSON-RPC over stdio (issue",
      "#447). Editors should spawn this as their language server for",
      "kaikai sources. v1 surface:",
      "",
      "  initialize / initialized / shutdown / exit",
      "  textDocument/didOpen, didChange, didClose (Full sync)",
      "  textDocument/hover",
      "",
      "Each hover spawns a kaic2 --library-mode subprocess; expect 5-15 ms",
      "latency on macOS. See docs/lsp.md for editor configuration.",
      "",
      "Environment:",
      "  KAILSP_KAIC2     Override the kaic2 binary path used for probes."
    ],
    "\n"
  )

#[doc("The text `kai doc --help` prints.")]
pub fn doc_text() : String =
  string.join(
    [
      "usage: kai doc                       List stdlib modules with a synopsis.",
      "       kai doc <module>              List a module's pub items + synopses.",
      "       kai doc <module>.<symbol>     Show a symbol's signature + full doc.",
      "",
      "Examples:",
      "  kai doc string.split",
      "  kai doc stream.fold",
      "  kai doc stream",
      "  kai doc",
      "  kai doc geo                        A package module (declared in kai.toml).",
      "  kai doc geo.area",
      "",
      "Docs come from the #[doc(...)] attributes in the source, extracted by the",
      "compiler (kaic2 --doc-json). A <module> is resolved against the stdlib",
      "first (string, stream, map, or a relative path like core/string, fs/path),",
      "then — when a kai.toml is in scope — against the current package and its",
      "dependencies, so a module you import via kai.toml is documentable the same",
      "way. The bare-no-args list shows stdlib modules only."
    ],
    "\n"
  )

#[doc("The text `kai info --help` prints, naming the topic directory `dir`.")]
pub fn info_text(dir: String) : String =
  string.join(
    [
      "usage: kai info                    List available topics.",
      "       kai info <topic>            Show the topic page (man/info style).",
      "       kai info <topic> --json     Same content, structured JSON output.",
      "       kai info --list             Topic names only, one per line.",
      "       kai info -k <keyword>       Search topic names, NAME lines, and page bodies.",
      "",
      "Topics live in #{dir} (override with KAIKAI_INFO_PATH).",
      "",
      "For language semantics and ecosystem, this is the entry point. The",
      "quickref of every form kaikai actually has is at:",
      "",
      "  kai info syntax",
      "",
      "To look up ONE symbol's signature + doc (the cheapest reference",
      "read), use 'kai doc <module>.<symbol>' instead of a topic page."
    ],
    "\n"
  )
