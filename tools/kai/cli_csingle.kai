#[doc("""
The single-TU C path: one `.c` printed from KIR, compiled and linked
with the runtime.
""")]

import cli_plan
import cli_budget

#[doc("Build through the single-TU C emit: kaic2 prints one `.c` from KIR, compiled and linked in one step.")]
pub fn build(p: Plan) : Result[Unit, Int] / Stderr + Env + File + Ffi {
  let t = p.t
  let out_c = "#{p.job.tmp}/out.c"
  let err = "#{out_c}.err"
  let rc = cli_budget.run(cli_plan.kaic2(p, [], p.job.src), cli_plan.kaic2_spawn([], out_c, err))
  cli_plan.replay(err)
  if rc != 0 {
    Err(rc)
  } else {
    let p = cli_plan.with_objects(p)!
    let argv = cli_plan.runtime_cc(t)
      ++ t.cflags
      ++ ["-I", t.inc_c, "-I", t.inc, out_c]
      ++ p.native_objs
      ++ ["-o", p.job.out, "-lm", ...p.libs]
    cli_plan.link(p, argv, "C backend")
  }
}
