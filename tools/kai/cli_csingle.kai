#[doc("""
The single-unit C path: one `.c` printed from KIR against the runtime's
declarations, compiled alone and linked with the cached runtime owner object.
""")]

import cli_plan
import cli_budget
import cli_err
import cli_native
import cli_proc

#[doc("Build through the single-unit C emit: kaic2 prints one `.c` that includes the runtime declarations, which is compiled and linked with the runtime owner object.")]
pub fn build(p: Plan) : Result[Unit, Int] / Stderr + Env + File + Ffi {
  let t = p.t
  let out_c = "#{p.job.tmp}/out.c"
  let out_o = "#{p.job.tmp}/out.o"
  let err = "#{out_c}.err"
  let rc = cli_budget.run(cli_plan.kaic2(p, ["--emit=c-owner"], p.job.src), cli_plan.kaic2_spawn([], out_c, err))
  cli_plan.replay(err)
  if rc != 0 {
    Err(rc)
  } else {
    let argv = cli_plan.runtime_cc(t)
      ++ t.cflags_compile
      ++ ["-DKAI_SEPARATE_COMPILATION=1", "-I", t.inc_c, "-I", t.inc]
      ++ ["-c", out_c, "-o", out_o]
    if cli_budget.run(argv, cli_proc.inherit()) != 0 {
      cli_err.die("C backend compile failed")
    } else {
      cli_native.modular_link(p, [out_o], ["-DKAI_SEPARATE_COMPILATION=1", "-DKAI_RUNTIME_OWNER=1"])
    }
  }
}
