#[doc("Environment knobs and the per-user cache directories the build reads and writes.")]

import os.env

#[doc("`${name:-dflt}`: the variable's value, or `dflt` when it is unset or empty.")]
pub fn env_or(name: String, dflt: String) : String / Env =
  match env.get(name) {
    Some(v) if v != "" -> v
    _ -> dflt
  }

# `$XDG_CACHE_HOME/kai/<sub>`, else the platform cache dir.
fn platform_root(sub: String, os: String) : String / Env {
  let home = env_or("HOME", "")
  match env.get("XDG_CACHE_HOME") {
    Some(x) if x != "" -> "#{x}/kai/#{sub}"
    _ ->
      if os == "Darwin" { "#{home}/Library/Caches/kai/#{sub}" } else { "#{home}/.cache/kai/#{sub}" }
  }
}

#[doc("Cache directory `kai/<sub>`: the `override` variable when set, else the platform default.")]
pub fn root(override: String, sub: String, os: String) : String / Env =
  env_or(override, platform_root(sub, os))
