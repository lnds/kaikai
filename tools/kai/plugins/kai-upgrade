#!/bin/sh
# kai-upgrade — the `kai upgrade` plugin: rustup-style self-update.
#
# Updates a ~/.kaikai/ install in place from the latest GitHub release.
# Coexists with Homebrew: a brew-managed kai (a prefix under a Cellar) is
# refused with a pointer to `brew upgrade`, never touched. Distinct from
# `kai update`, which refreshes package dependencies.
#
# `kai` runs it with KAIKAI_HOME set to the prefix it resolved for itself;
# that prefix is the one upgraded. Run directly, it upgrades the prefix it
# ships in (three directories up in both layouts).

set -eu

ROOT="${KAIKAI_HOME:-$(cd "$(dirname "$0")/../../.." && pwd)}"

die() {
  echo "kai: error: $*" >&2
  exit 2
}

read_version() {
  if [ -f "$ROOT/VERSION" ]; then
    cat "$ROOT/VERSION"
  elif [ -f "$ROOT/share/kaikai/VERSION" ]; then
    cat "$ROOT/share/kaikai/VERSION"
  else
    echo "unknown"
  fi
}

# GNU-style "<hash>  <file>" → hash only; tool varies by OS.
upgrade_sha256_of() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    die "no sha256 tool (shasum or sha256sum) found"
  fi
}

# Base URL of the static release manifest. KAIKAI_DIST_BASE points the
# whole resolve+download path at a mirror. The default is the release
# assets of the newest non-draft release, which GitHub repoints on every
# publish — the manifest ships with the tarballs it describes, so the two
# can never disagree. This is github.com, not api.github.com: no API
# quota is charged.
upgrade_dist_base() {
  printf '%s\n' "${KAIKAI_DIST_BASE:-https://github.com/kaikailang-org/kaikai/releases/latest/download}"
}

# Fetch latest.json and print "<tag>\t<url>\t<sha256>" for $1 (platform).
# Silent on any failure — this is the preferred path, not the only one;
# the caller falls back to the GitHub API. Keeping it quiet means an old
# release with no manifest published yet upgrades exactly as before.
upgrade_manifest_entry() {
  platform="$1"
  json="$2"
  curl -fsSL --max-time 20 -o "$json" "$(upgrade_dist_base)/latest.json" 2>/dev/null || return 1

  m_tag="$(tr -d ' \n\r\t' <"$json" | sed -n 's/.*"tag":"\(v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)".*/\1/p')"
  [ -n "$m_tag" ] || return 1

  # Isolate the requested platform's object before reading its fields,
  # so a sibling platform's url/sha256 can never be picked up instead.
  entry="$(tr -d ' \n\r\t' <"$json" \
    | sed -n 's/.*"'"$platform"'":{\([^}]*\)}.*/\1/p')"
  [ -n "$entry" ] || return 1

  m_url="$(printf '%s' "$entry" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')"
  m_sha="$(printf '%s' "$entry" | sed -n 's/.*"sha256":"\([0-9a-f]\{64\}\)".*/\1/p')"
  [ -n "$m_url" ] && [ -n "$m_sha" ] || return 1

  printf '%s\t%s\t%s\n' "$m_tag" "$m_url" "$m_sha"
}

# Resolve the newest release tag from the GitHub tags API. Tags are
# created by every `cz bump`, so they always exist — unlike
# releases/latest, which 404s until someone publishes a Release.
# $UPGRADE_HDR holds curl's response headers; on failure the reason
# (network|ratelimit|notag) is written to $UPGRADE_HDR.err so the caller
# can diagnose across the command-substitution subshell.
upgrade_latest_tag() {
  url="https://api.github.com/repos/kaikailang-org/kaikai/tags?per_page=100"
  token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
  if [ -n "$token" ]; then
    body="$(curl -sSL -H "Authorization: Bearer $token" -D "$UPGRADE_HDR" "$url" 2>/dev/null)" || { printf 'network' >"$UPGRADE_HDR.err"; return 1; }
  else
    body="$(curl -sSL -D "$UPGRADE_HDR" "$url" 2>/dev/null)" || { printf 'network' >"$UPGRADE_HDR.err"; return 1; }
  fi

  status="$(sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' "$UPGRADE_HDR" | tail -n1)"
  remaining="$(sed -n 's/^[Xx]-[Rr]ate[Ll]imit-[Rr]emaining:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$UPGRADE_HDR" | tail -n1)"
  if [ "$status" = "403" ] || [ "$status" = "429" ] || [ "$remaining" = "0" ] \
     || printf '%s' "$body" | grep -qi 'rate limit'; then
    printf 'ratelimit' >"$UPGRADE_HDR.err"
    return 1
  fi

  # tr splits objects onto their own lines first: sed's greedy `.*`
  # would otherwise grab the *last* tag when the JSON is minified.
  tag="$(printf '%s' "$body" | tr ',' '\n' \
    | sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\(v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)".*/\1/p' \
    | head -n1)"
  if [ -z "$tag" ]; then
    printf 'notag' >"$UPGRADE_HDR.err"
    return 1
  fi
  printf '%s\n' "$tag"
}

# Release-tarball platform token, "<os>-<arch>".
#
# The token MUST match what scripts/build-release.sh names the tarball,
# which derives it from `uname -s | tr A-Z a-z` and a raw `uname -m` on
# the release runner. That is why aarch64 does NOT fold into arm64 here:
# a Linux arm64 runner would name its tarball linux-aarch64, so folding
# would build a URL that 404s. Only Darwin's arm64/aarch64 spelling is
# normalised, and only to arm64 — the name macOS runners actually emit.
# tools/test-release-platforms.sh asserts both sides agree.
#
# Prints the token on success. On an unsupported platform it prints the
# reason to STDOUT and returns 1, so the caller's `$(...)` capture holds
# a usable message.
upgrade_platform() {
  _up_os="$(uname -s)"; _up_arch="$(uname -m)"
  case "$_up_os" in
    Darwin) _up_os_name="darwin" ;;
    Linux)  _up_os_name="linux" ;;
    *) printf 'unsupported OS %s — kaikai publishes macOS and Linux tarballs\n' "$_up_os"; return 1 ;;
  esac
  case "$_up_os_name-$_up_arch" in
    darwin-arm64|darwin-aarch64) _up_arch_name="arm64" ;;
    linux-x86_64)                _up_arch_name="x86_64" ;;
    *) printf 'unsupported platform %s-%s — no kaikai tarball is published for it\n' "$_up_os_name" "$_up_arch"; return 1 ;;
  esac
  printf '%s-%s\n' "$_up_os_name" "$_up_arch_name"
}

# True (0) when $1 (dotted X.Y.Z) is strictly greater than $2.
upgrade_version_gt() {
  [ "$1" = "$2" ] && return 1
  newer="$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n1)"
  [ "$newer" = "$1" ]
}

cmd_upgrade() {
  case "${1:-}" in
    -h|--help)
      cat <<EOF
usage: kai upgrade

Self-update the kaikai compiler to the latest GitHub release.

Updates a curl|sh install under \$KAIKAI_HOME (default ~/.kaikai) in
place: resolves the latest release, and if it is newer than the running
version, downloads + verifies + replaces the binaries. If already
current, says so and exits.

The version is resolved from latest.json, published as an asset of the
newest release, which costs no GitHub API quota; the GitHub tags API is
the fallback when that manifest is unreachable or predates a release.

Environment:
  KAIKAI_DIST_BASE   base URL serving latest.json (default: the newest
                     release's assets) — point it at a mirror
  GITHUB_TOKEN       lifts the 60/h API limit on the fallback path

A Homebrew-managed install is left untouched — run \`brew upgrade
kaikai\` for that. This is distinct from \`kai update\`, which refreshes
package dependencies declared in kai.toml.
EOF
      return 0 ;;
    -*) die "unknown flag: $1 (see 'kai upgrade --help')" ;;
    ?*) die "kai upgrade takes no arguments (got: $1)" ;;
  esac

  command -v curl >/dev/null 2>&1 || die "kai upgrade requires curl"
  command -v tar  >/dev/null 2>&1 || die "kai upgrade requires tar"

  # Homebrew coexistence: brew installs under a Cellar; refuse and defer
  # to brew.
  self="$ROOT/bin/kai"
  case "$self" in
    */Cellar/kaikai/*|*/Cellar/*)
      echo "kai is installed via Homebrew ($self)." >&2
      echo "Run 'brew upgrade kaikai' to update it." >&2
      return 0 ;;
  esac

  platform="$(upgrade_platform)" || die "$platform"

  prefix="$ROOT"
  if [ ! -w "$prefix" ]; then
    die "cannot write to install prefix $prefix — not a curl|sh install?"
  fi

  tmp="$(mktemp -d "${TMPDIR:-/tmp}/kaikai-upgrade.XXXXXX")"
  trap 'rm -rf "$tmp"' EXIT INT TERM

  echo "==> checking for updates" >&2

  # Preferred path: the static manifest, which costs no API quota. It
  # also carries the tarball URL and its sha256, so a manifest hit skips
  # the separate .sha256 download too. GitHub stays as the fallback for
  # releases published before the manifest existed, or a mirror without one.
  #
  # `|| true` is load-bearing under `set -e`: a plain assignment whose
  # command substitution exits non-zero terminates the shell right here,
  # making every error branch below unreachable.
  tarball_url=""
  want=""
  entry=""
  entry="$(upgrade_manifest_entry "$platform" "$tmp/latest.json")" || true
  if [ -n "$entry" ]; then
    tag="$(printf '%s' "$entry" | cut -f1)"
    tarball_url="$(printf '%s' "$entry" | cut -f2)"
    want="$(printf '%s' "$entry" | cut -f3)"
  else
    UPGRADE_HDR="$tmp/tags.hdr"
    tag=""
    tag="$(upgrade_latest_tag)" || true
    if [ -z "$tag" ]; then
      case "$(cat "$UPGRADE_HDR.err" 2>/dev/null)" in
        network)   die "cannot reach $(upgrade_dist_base) or github.com — check your network connection" ;;
        ratelimit) die "GitHub API rate limit reached (60/h unauthenticated). Retry in a few minutes, or set GITHUB_TOKEN." ;;
        *)         die "could not find a release tag matching v<major>.<minor>.<patch> on GitHub" ;;
      esac
    fi
  fi
  latest="${tag#v}"
  current="$(read_version)"

  if ! upgrade_version_gt "$latest" "$current"; then
    echo "kai is up to date (version $current)." >&2
    return 0
  fi

  echo "==> upgrading kaikai $current -> $latest" >&2
  tarball="kaikai-$tag-$platform.tar.gz"
  if [ -z "$tarball_url" ]; then
    tarball_url="https://github.com/kaikailang-org/kaikai/releases/download/$tag/$tarball"
  fi

  curl -fsSL -o "$tmp/$tarball" "$tarball_url" \
    || die "failed to download $tarball from $tarball_url"

  # Only fetched when the manifest did not already supply the digest.
  if [ -z "$want" ]; then
    curl -fsSL -o "$tmp/$tarball.sha256" "$tarball_url.sha256" \
      || die "failed to download $tarball.sha256"
    want="$(awk '{print $1}' "$tmp/$tarball.sha256")"
  fi

  echo "==> verifying checksum" >&2
  got="$(upgrade_sha256_of "$tmp/$tarball")"
  if [ "$want" != "$got" ]; then
    die "checksum mismatch for $tarball (expected $want, got $got) — aborting upgrade"
  fi

  echo "==> installing $latest to $prefix" >&2
  mkdir -p "$tmp/unpack"
  tar -xzf "$tmp/$tarball" -C "$tmp/unpack"
  top="$tmp/unpack/kaikai-$tag-$platform"
  [ -d "$top" ] || top="$(find "$tmp/unpack" -mindepth 1 -maxdepth 1 -type d | head -n1)"
  [ -d "$top" ] || die "unexpected tarball layout: no top-level directory"
  [ -x "$top/bin/kai" ] || die "tarball missing bin/kai"

  # Swap contents in place. Replace bin/libexec/share wholesale so a
  # removed file from the old version does not linger — but bin/ and
  # share/ are shared with `kai install`, so user binaries and the
  # completions installed packages dropped are carried across the wipe.
  # The ledger, not the directory listing, is what says which binaries
  # are the user's; for completions it is the directory itself, since
  # the toolchain ships none of the three.
  upgrade_stash="$tmp/stash-bin"
  mkdir -p "$upgrade_stash"
  upgrade_comp_stash="$tmp/stash-share"
  mkdir -p "$upgrade_comp_stash"
  [ -d "$prefix/share" ] && ( cd "$prefix/share" \
    && tar -cf - zsh bash-completion fish 2>/dev/null ) \
    | ( cd "$upgrade_comp_stash" && tar -xf - 2>/dev/null ) || :
  upgrade_ledger="$prefix/.kai-installed"
  if [ -f "$upgrade_ledger" ]; then
    while IFS="$(printf '\t')" read -r stash_name _ _; do
      [ -n "$stash_name" ] || continue
      if [ -e "$prefix/bin/$stash_name" ]; then
        cp -p "$prefix/bin/$stash_name" "$upgrade_stash/$stash_name" 2>/dev/null || :
      fi
    done < "$upgrade_ledger"
  fi

  for d in bin libexec share; do
    if [ -d "$top/$d" ]; then
      rm -rf "$prefix/$d"
      (cd "$top" && tar -cf - "$d") | (cd "$prefix" && tar -xf -)
    fi
  done

  mkdir -p "$prefix/share"
  ( cd "$upgrade_comp_stash" && tar -cf - . 2>/dev/null ) \
    | ( cd "$prefix/share" && tar -xf - 2>/dev/null ) || :

  # Restore user binaries the new toolchain does not itself provide. A
  # name that has since become a toolchain binary is dropped rather than
  # shadowing it; the ledger entry stays so `--list` still reports it.
  for stashed in "$upgrade_stash"/*; do
    [ -e "$stashed" ] || continue
    stash_name="$(basename "$stashed")"
    if [ -e "$prefix/bin/$stash_name" ]; then
      echo "kai: warning: installed binary '$stash_name' is now shipped by the toolchain; keeping the toolchain's" >&2
      continue
    fi
    cp -p "$stashed" "$prefix/bin/$stash_name" 2>/dev/null || :
  done
  for f in README.md LICENSE; do
    [ -f "$top/$f" ] && cp "$top/$f" "$prefix/$f"
  done

  echo "==> upgraded to kaikai $latest" >&2
  "$prefix/bin/kai" --version >&2 || true
}

cmd_upgrade "$@"
