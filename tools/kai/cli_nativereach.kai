#[doc("Which `[native.<module>]` tables join a build: those whose module the build imports, as kaic2 lists it.")]

import cli_manifest
import cli_nativedeps
import cli_proc
import cli_sys
import cli_toolchain

fn has_module_tables(info: [Native]) : Bool = info |> list.any(n => n.module != "")

#[doc("The declarations the build of `src` keeps, deduplicated; kaic2 is asked with `flags` what the build imports only when a module table is declared.")]
pub fn in_build(
  t: Toolchain,
  info: [Native],
  flags: [String],
  src: String,
  tmp: String
) : Result[[Native], Int] / Stderr + File + Ffi =
  if not has_module_tables(info) {
    Ok(cli_nativedeps.dedupe(info, []))
  } else {
    let err = "#{tmp}/guard-inputs.err"
    let quiet = cli_proc.Spawn { ...cli_proc.inherit(), err: err, unset: ["KAI_TRACE_RC"] }
    let argv = [t.layout.kaic2, ...flags] ++ ["--guard-inputs", src]
    let r = cli_proc.capture(argv, quiet, "#{tmp}/guard-inputs.out")
    if r.fst != 0 {
      if cli_sys.size(err) > 0 { cli_sys.copy_to_stderr(err) }
      Err(r.fst)
    } else {
      let listed = string.split(r.snd, "\n") |? (l => l != "" and (not string.starts_with(l, "-")))
      Ok(cli_nativedeps.dedupe(reached(info, [abspath(src), ...listed]), []))
    }
  }

# Every `[native]` declaration, and a `[native.<module>]` one when `reads` holds that module's file.
fn reached(info: [Native], reads: [String]) : [Native] / File + Ffi {
  let dirs = info |? (n => n.kind == "dir")
  info |? (n => n.module == "" or list.any(module_files(dirs, n), f => (reads |> contains(f))))
}

# A module path names a file relative to the package, under its entry's
# directory or its root; physical, as kaic2 lists what it reads.
fn module_files(dirs: [Native], n: Native) : [String] / File + Ffi {
  let rel = "#{string.replace(n.module, ".", "/")}.kai"
  dirs
    |? (d => d.pkg == n.pkg)
    || (d => [cli_manifest.source_root(d.value), d.value])
    | (root => abspath("#{root}/#{rel}"))
}
