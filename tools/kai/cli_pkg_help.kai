#[doc("Help texts of the package verbs: `kai init`, `kai fetch`, `kai install`, `kai add`, `kai update`, `kai show`.")]

#[doc("The text `kai init --help` prints.")]
pub fn init_text() : String =
  string.join(
    [
      "usage: kai init <name>",
      "",
      "Write a stub kai.toml in the current directory with the given",
      "package name and version 0.1.0. Errors out if kai.toml already",
      "exists."
    ],
    "\n"
  )

#[doc("The text `kai fetch --help` prints.")]
pub fn fetch_text() : String =
  string.join(
    [
      "usage: kai fetch",
      "",
      "Read kai.toml in the current directory (or the nearest ancestor),",
      "resolve dependencies, and write kai.lock. Git sources are cloned",
      "into the package cache; local-path deps resolve through the",
      "manifest.",
      "",
      "'kai run' and 'kai build' fetch automatically when the lockfile is",
      "missing or stale, so this is only needed to prefetch (CI) or to",
      "regenerate a lockfile without building."
    ],
    "\n"
  )

#[doc("The text `kai install --help` prints.")]
pub fn install_text() : String =
  string.join(
    [
      "usage: kai install [<spec>] [--force]",
      "       kai install --list",
      "",
      "Build a package and install its binary into $KAIKAI_HOME/bin",
      "(default ~/.kaikai/bin), the directory the installer already put on",
      "your PATH.",
      "",
      "Specs:",
      "  .                             the package in the current directory",
      "  github.com/owner/repo         a git source, at its default branch",
      "  github.com/owner/repo@v1.2.0  a git source, at a tag/branch/SHA",
      "",
      "The binary is named after the manifest's `name`, not the source URL,",
      "so 'kai install github.com/owner/thing' yields 'thing'.",
      "",
      "Options:",
      "  --force     replace an already-installed binary of the same name",
      "  --list      print what this prefix has installed, then exit",
      "",
      "A package that declares a [completions] table in its kai.toml also",
      "gets its shell completions installed under $KAIKAI_HOME/share, and",
      "the line your shell needs is printed if it is not wired up yet:",
      "",
      "  [completions]",
      "  zsh  = \"completions/_foo\"",
      "  bash = \"completions/foo.bash\"",
      "  fish = \"completions/foo.fish\"",
      "",
      "Names shipped by the kaikai toolchain are refused. To resolve a",
      "package's dependencies without installing anything, use 'kai fetch'."
    ],
    "\n"
  )

#[doc("The text `kai add --help` prints.")]
pub fn add_text() : String =
  string.join(
    [
      "usage: kai add <source>[@<ref>]",
      "",
      "Fetch a dependency, add it to kai.toml, and update kai.lock.",
      "",
      "Source forms:",
      "  github.com/owner/repo@v1.0      shorthand (string-form)",
      "  github.com/owner/repo           ref defaults to HEAD/main",
      "  ../local-thing                  local path override",
      "",
      "Examples:",
      "  kai add github.com/lnds/manutara@v0.1",
      "  kai add github.com/lnds/kohau",
      "",
      "Cache: $KAIKAI_CACHE or ~/.cache/kai/pkg/."
    ],
    "\n"
  )

#[doc("The text `kai update --help` prints.")]
pub fn update_text() : String =
  string.join(
    [
      "usage: kai update [<name>]",
      "",
      "Re-fetch the named dependency (or all of them if no name given)",
      "and refresh kai.lock with the latest commit on the declared ref."
    ],
    "\n"
  )

#[doc("The text `kai show --help` prints.")]
pub fn show_text() : String =
  string.join(
    [
      "usage: kai show",
      "",
      "Read kai.toml in the current directory (or the nearest ancestor)",
      "and print its parsed contents."
    ],
    "\n"
  )
