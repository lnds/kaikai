#[doc("`kai build` and `kai run`: flags, the output name, the scratch dir, and the report modes that stop after the typer.")]

import os.env
import cli_build_help
import cli_caches
import cli_compile
import cli_err
import cli_fs
import cli_manifest
import cli_native
import cli_plan
import cli_proc
import cli_spec
import cli_sys
import cli_toolchain
import cli_wasi
import cli_wasm

type Opts = {
  spec: String,
  out: String,
  report: String,
  backend: String,
  target: String,
  opt: String,
  mode: String,
  strict: Bool,
  help: Bool
}

fn no_opts() : Opts =
  Opts {
    spec: "",
    out: "",
    report: "",
    backend: "",
    target: "",
    opt: "",
    mode: "",
    strict: false,
    help: false
  }

# Flags `build` and `run` share; `None` when `a` is not one of them.
fn common_flag(
  a: String,
  rest: [String],
  o: Opts
) : Option[Result[(Opts, [String]), Int]] / Stderr =
  if string.starts_with(a, "--backend=") {
    Some(
      cli_compile.backend_name(string.drop_prefix(a, "--backend=") ?? "")
        | (b => (Opts { ...o, backend: b }, rest))
    )
  } else if a == "--backend" {
    match rest {
      [] -> Some(cli_err.die("--backend needs an argument (c|native)"))
      [v, ...more] -> Some(cli_compile.backend_name(v) | (b => (Opts { ...o, backend: b }, more)))
    }
  } else if a == "--debug" {
    Some(Ok((Opts { ...o, opt: "0", mode: "debug" }, rest)))
  } else if a == "--release" {
    Some(Ok((Opts { ...o, opt: "2", mode: "release" }, rest)))
  } else {
    None
  }

# What `build` reports instead of a binary, and how holes count; `None` when `a` is neither.
fn report_flag(
  a: String,
  rest: [String],
  o: Opts
) : Option[Result[(Opts, [String]), Int]] / Stderr =
  if a == "--strict-holes" {
    Some(Ok((Opts { ...o, strict: true }, rest)))
  } else if not (cli_compile.REPORT_FLAGS |> contains(a)) {
    None
  } else if o.report != "" {
    Some(cli_err.die("report-mode flags are mutually exclusive"))
  } else {
    Some(Ok((Opts { ...o, report: a }, rest)))
  }

fn target_name(v: String) : Result[String, Int] / Stderr =
  if cli_wasm.is_target(v) {
    Ok(v)
  } else {
    cli_err.die("--target must be '#{cli_wasm.TARGET}' or '#{cli_wasm.WASI}' (got: #{v})")
  }

# `--target` for `build` and `run`; `None` when `a` is not it.
fn target_flag(
  a: String,
  rest: [String],
  o: Opts
) : Option[Result[(Opts, [String]), Int]] / Stderr =
  if string.starts_with(a, "--target=") {
    Some(target_name(string.drop_prefix(a, "--target=") ?? "") | (v => (Opts { ...o, target: v }, rest)))
  } else if a == "--target" {
    match rest {
      [] -> Some(cli_err.die("--target needs an argument (#{cli_wasm.TARGET}|#{cli_wasm.WASI})"))
      [v, ...more] -> Some(target_name(v) | (n => (Opts { ...o, target: n }, more)))
    }
  } else {
    None
  }

fn build_flag(a: String, rest: [String], o: Opts) : Result[(Opts, [String]), Int] / Stderr =
  if a == "-o" {
    match rest {
      [] -> cli_err.die("-o needs an argument")
      [v, ...more] -> Ok((Opts { ...o, out: v }, more))
    }
  } else if string.starts_with(a, "-") {
    let flag = target_flag(a, rest, o)
      |> or_else(() => report_flag(a, rest, o))
      |> or_else(() => common_flag(a, rest, o))
    flag |> unwrap_or_else(() => cli_err.die("unknown flag: #{a} (see 'kai build --help')"))
  } else if o.spec != "" {
    cli_err.die("only one input supported")
  } else {
    Ok((Opts { ...o, spec: a }, rest))
  }

fn parse_build(args: [String], o: Opts) : Result[Opts, Int] / Stderr =
  match args {
    [] -> Ok(o)
    [a, ..._] if a == "-h" or a == "--help" -> Ok(Opts { ...o, help: true })
    [a, ...rest] -> {
      let next = build_flag(a, rest, o)!
      parse_build(next.snd, next.fst)
    }
  }

# `run` stops at `--` or at its first non-flag, the spec; the rest goes to the program.
fn parse_run(args: [String], o: Opts) : Result[(Opts, [String]), Int] / Stderr =
  match args {
    [] -> Ok((o, []))
    [a, ..._] if a == "-h" or a == "--help" -> Ok((Opts { ...o, help: true }, []))
    ["--", ...rest] -> Ok((o, rest))
    [a, ...rest] if string.starts_with(a, "-") -> {
      let next = (target_flag(a, rest, o)
        |> or_else(() => common_flag(a, rest, o))
        |> unwrap_or_else(() => cli_err.die("unknown flag: #{a} (see 'kai run --help')")))!
      parse_run(next.snd, next.fst)
    }
    _ -> Ok((o, args))
  }

fn strict_flag(o: Opts) : [String] = if o.strict { ["--strict-holes"] } else { [] }

fn export_profile(o: Opts) : Unit / Env + Ffi {
  cli_caches.default_native_jobs(cli_sys.ncpu())
  let _ = env.set("KAI_NATIVE_OPT", if o.opt == "" {
    cli_caches.env_or("KAI_NATIVE_OPT", "2")
  } else {
    o.opt
  })
  let _ = env.set("KAI_BUILD_MODE", if o.mode == "" { "default" } else { o.mode })
}

# Named after the package (Go-style), placed in a sub-package's own dir.
fn default_out(src: String) : String / File + Ffi {
  let manifest = (cli_fs.dir_of(src) || (d => cli_manifest.find_dir(d))) ?? ""
  let base = cli_fs.basename(src)
  let stem = if base == ".kai" { base } else { string.drop_suffix(base, ".kai") ?? base }
  let name = cli_manifest.package_name(manifest) ?? stem
  if manifest != "" and manifest != cli_sys.cwd() { "#{manifest}/#{name}" } else { name }
}

fn entry(spec: String, verb: String) : Result[String, Int] / Stderr + File + Ffi {
  let src = cli_spec.resolve(spec, "building", false)!
  if src == "" { cli_err.die("missing input file (see 'kai #{verb} --help')") } else { Ok(src) }
}

fn report(
  t: Toolchain,
  src: String,
  o: Opts
) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi =
  if o.out != "" {
    cli_err.die("#{o.report} does not produce a binary; drop -o <out>")
  } else if o.backend != "" {
    cli_err.die("#{o.report} is independent of --backend; drop the flag")
  } else {
    cli_fs.with_scratch(tmp => cli_compile.report(t, src, [o.report, ...strict_flag(o)], tmp))
  }

fn ensure_out_dir(out: String) : Result[Unit, Int] / Stderr + File + Ffi {
  let dir = cli_fs.dirname(out)
  if cli_fs.mkdir_p(dir) {
    Ok(())
  } else {
    cli_err.die("cannot create output directory '#{dir}' for -o '#{out}'")
  }
}

fn build_binary(t: Toolchain, src: String, o: Opts) : Result[Int, Int] / Stderr + Env + File + Ffi {
  let b = cli_compile.resolve_backend(o.backend)!
  export_profile(o)
  let out = if o.out == "" { default_out(src) } else { o.out }
  ensure_out_dir(out)!
  if o.target == "" {
    cli_fs.with_scratch(
      tmp => build_in(
        t,
        b,
        cli_plan.Job { src, tmp, out, verb: "build", extra: strict_flag(o) },
        o.mode
      )
    )
  } else {
    build_wasm(t, src, out, o)
  }
}

fn wasm_in(
  t: Toolchain,
  w: Toolchain,
  b: Backend,
  job: Job,
  base: String
) : Result[Int, Int] / Stderr + Env + File + Ffi {
  cli_compile.compile(w, b, job)!
  if w.target == cli_wasm.TARGET {
    cli_wasm.write_page(t.layout, base, package_js(t, job.src, job.tmp)!)!
  }
  Ok(0)
}

fn js_paths(dirs: [String]) : [String] / File =
  match dirs {
    [] -> []
    [d, ...rest] -> match cli_manifest.js_module(d) {
      Some(m) -> ["#{d}/#{m}", ...js_paths(rest)]
      None -> js_paths(rest)
    }
  }

# Dependencies first, the entry package last: later modules win a name they share.
fn package_js(
  t: Toolchain,
  src: String,
  tmp: String
) : Result[[String], Int] / Stderr + Env + File + Ffi {
  let manifest = (cli_fs.dir_of(src) || (d => cli_manifest.find_dir(d))) ?? ""
  if manifest == "" {
    Ok([])
  } else {
    let roots = if cli_manifest.has_dependencies(manifest) {
      cli_pkg.dep_roots(t, cli_pkg.ensure_kaipkg(t)!, manifest, true, tmp)
    } else {
      []
    }
    Ok(js_paths((roots | (r => r.snd)) ++ [manifest]))
  }
}

# WebAssembly builds through either backend; the C one stays the default.
fn build_wasm(
  t: Toolchain,
  src: String,
  out: String,
  o: Opts
) : Result[Int, Int] / Stderr + Env + File + Ffi {
  let w = cli_wasm.configure(t, o.target)!
  let base = string.drop_suffix(out, ".wasm") ?? out
  let job = cli_plan.Job {
    src,
    tmp: "",
    out: "#{base}.wasm",
    verb: "build",
    extra: strict_flag(o)
  }
  let chosen = if o.backend != "" { o.backend } else { cli_caches.env_or("KAI_BACKEND", "") }
  cli_fs.with_scratch(
    tmp => wasm_in(t, w, wasm_backend(w, chosen, tmp), cli_plan.Job { ...job, tmp: tmp }, base)
  )
}

# The native backend unless the user chose one or this kaic2 cannot emit the target.
fn wasm_backend(w: Toolchain, chosen: String, tmp: String) : Backend / Env + File + Ffi =
  if chosen != "" {
    cli_plan.Backend { name: chosen, explicit: true }
  } else if cli_native.lacks_llvm(w, tmp) {
    cli_plan.Backend { name: "c", explicit: false }
  } else {
    cli_plan.Backend { name: "native", explicit: false }
  }

# `--release` strips the linked binary; a missing `strip` only leaves it larger.
fn build_in(
  t: Toolchain,
  b: Backend,
  job: Job,
  mode: String
) : Result[Int, Int] / Stderr + Env + File + Ffi {
  cli_compile.compile(t, b, job)!
  if mode == "release" and cli_sys.is_file(job.out) {
    let _ =
      cli_proc.run(["strip", job.out], cli_proc.Spawn { ...cli_proc.inherit(), err: "/dev/null" })
  }
  Ok(0)
}

#[doc("`kai build [<spec>] [-o <out>] [flags]`: the exit status.")]
pub fn build(t: Toolchain, args: [String]) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi {
  let o = parse_build(args, no_opts())!
  if o.help {
    Stdout.print(cli_build_help.build())
    Ok(0)
  } else {
    let src = entry(o.spec, "build")!
    if o.report != "" {
      let _ = cli_compile.resolve_backend(o.backend)!
      export_profile(o)
      report(t, src, o)
    } else {
      build_binary(t, src, o)
    }
  }
}

fn run_spec(args: [String]) : Result[(String, [String]), Int] / Stderr + File + Ffi =
  match args {
    [] -> entry("", "run") | (s => (s, []))
    [a, ...rest] if cli_spec.is_package(a) -> entry(a, "run") | (s => (s, rest))
    [a, ...rest] -> Ok((a, rest))
  }

fn run_in(
  t: Toolchain,
  b: Backend,
  src: String,
  args: [String],
  tmp: String
) : Result[Int, Int] / Stderr + Env + File + Ffi {
  let base = cli_fs.basename(src)
  let bin = "#{tmp}/#{string.drop_suffix(base, ".kai") ?? base}"
  cli_compile.compile(t, b, cli_plan.Job { src, tmp, out: bin, verb: "run", extra: [] })!
  Ok(cli_proc.run([bin, ...args], cli_proc.inherit()))
}

# Builds the module in `tmp` and runs it on the runtime found on `PATH`.
fn run_wasi(
  t: Toolchain,
  src: String,
  args: [String],
  o: Opts,
  tmp: String
) : Result[Int, Int] / Stderr + Env + File + Ffi {
  let runtime = cli_wasi.runtime()!
  let base = cli_fs.basename(src)
  let wasm = "#{tmp}/#{string.drop_suffix(base, ".kai") ?? base}.wasm"
  build_wasm(t, src, wasm, Opts { ...o, out: wasm })!
  Ok(cli_wasi.run_module(runtime, wasm, args))
}

#[doc("The optimisation level `kai run` builds at on both backends: 0 with `--debug`, 2 with `--release`, else 1.")]
pub fn run_opt_level(args: [String]) : String = match args {
  ["--debug", ..._] -> "0"
  ["--release", ..._] -> "2"
  [a, ...rest] if string.starts_with(a, "-") and a != "--" -> run_opt_level(rest)
  _ -> "1"
}

#[doc("`kai run [flags] [<spec>] [args...]`: build to a scratch binary, run it with the args, and return its status.")]
pub fn run(t: Toolchain, args: [String]) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi {
  let parsed = parse_run(args, no_opts())!
  let o = parsed.fst
  if o.help {
    Stdout.print(cli_build_help.run())
    Ok(0)
  } else {
    let spec = run_spec(parsed.snd)!
    let b = cli_compile.resolve_backend(o.backend)!
    export_profile(o)
    if o.target == cli_wasm.WASI {
      cli_fs.with_scratch(tmp => run_wasi(t, spec.fst, spec.snd, o, tmp))
    } else if o.target != "" {
      cli_err.die("kai run supports --target=#{cli_wasm.WASI}; a browser module is served, not run (kai info wasm)")
    } else {
      cli_fs.with_scratch(tmp => run_in(t, b, spec.fst, spec.snd, tmp))
    }
  }
}
