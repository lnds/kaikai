#[doc("`kai lsp`: hand stdio to the kai-lsp language server, pointed at this toolchain's compiler.")]

import os.env
import cli_caches
import cli_err
import cli_pkg
import cli_sys
import cli_toolchain
import cli_tool_help

# Shipped in an installed prefix, built on first use in a checkout.
fn server(t: Toolchain) : Result[String, Int] / Stderr + File + Ffi {
  let root = t.layout.root
  if not t.layout.dev {
    let bin = "#{root}/libexec/kaikai/kai-lsp"
    if cli_sys.is_exec(bin) {
      Ok(bin)
    } else {
      cli_err.die("kai-lsp binary missing at #{bin} — installation is corrupt")
    }
  } else {
    let bin = "#{root}/tools/kai-lsp/kai-lsp"
    cli_pkg.build_helper(t, "tools/kai-lsp", "#{root}/tools/kai-lsp/main.kai", bin).map(u => bin)
  }
}

#[doc("`kai lsp`: replace kai with the language server; returns only when it cannot start.")]
pub fn lsp_verb(t: Toolchain, args: [String]) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi =
  match args {
    [a, ..._] if a == "-h" or a == "--help" -> {
      Stdout.print(cli_tool_help.lsp_text())
      Ok(0)
    }
    _ -> {
      cli_toolchain.ensure_built(t)!
      let bin = server(t)!
      if cli_caches.env_or("KAILSP_KAIC2", "") == "" { let _ = env.set("KAILSP_KAIC2", t.layout.kaic2) }
      cli_sys.argv_push(bin)
      args |> foreach(a => cli_sys.argv_push(a))
      cli_err.fail("cannot run #{bin}: #{cli_sys.exec(bin)}", 126)
    }
  }
