#[doc("POSIX primitives the kai CLI binds from its C shim (`cli_sys.c`).")]

#[doc("Modification time of `path` in seconds since the epoch, or -1 when it cannot be stat'ed.")]
extern "C"("kaicli_mtime") pub fn mtime(path: String) : Int / Ffi

#[doc("Size of `path` in bytes, or -1 when it cannot be stat'ed.")]
extern "C"("kaicli_size") pub fn size(path: String) : Int / Ffi

#[doc("True when `path` names a directory.")]
extern "C"("kaicli_is_dir") pub fn is_dir(path: String) : Bool / Ffi

#[doc("True when `path` names a non-directory the process may execute.")]
extern "C"("kaicli_is_exec") pub fn is_exec(path: String) : Bool / Ffi

#[doc("Append one argument to the argv the next `exec` passes.")]
extern "C"("kaicli_argv_push") pub fn argv_push(arg: String) : Unit / Ffi

#[doc("Replace the process with `path`; returns the reason only when that fails.")]
extern "C"("kaicli_exec") pub fn exec(path: String) : String / Ffi
