#[doc("POSIX primitives the kai CLI binds from its C shim (`cli_sys.c`).")]

#[doc("Modification time of `path` in seconds since the epoch, or -1 when it cannot be stat'ed.")]
extern "C"("kaicli_mtime") pub fn mtime(path: String) : Int / Ffi

#[doc("Size of `path` in bytes, or -1 when it cannot be stat'ed.")]
extern "C"("kaicli_size") pub fn size(path: String) : Int / Ffi

#[doc("True when `path` names a directory.")]
extern "C"("kaicli_is_dir") pub fn is_dir(path: String) : Bool / Ffi

#[doc("True when `path` names a regular file.")]
extern "C"("kaicli_is_file") pub fn is_file(path: String) : Bool / Ffi

#[doc("True when `path` names a non-directory the process may execute.")]
extern "C"("kaicli_is_exec") pub fn is_exec(path: String) : Bool / Ffi

#[doc("Append one argument to the argv the next `spawn` or `exec` passes.")]
extern "C"("kaicli_argv_push") pub fn argv_push(arg: String) : Unit / Ffi

#[doc("Set `name` in the next spawned child's environment only.")]
extern "C"("kaicli_child_setenv") pub fn child_setenv(name: String, value: String) : Unit / Ffi

#[doc("Remove `name` from the next spawned child's environment only.")]
extern "C"("kaicli_child_unsetenv") pub fn child_unsetenv(name: String) : Unit / Ffi

#[doc("Replace the process with `path`; returns the reason only when that fails.")]
extern "C"("kaicli_exec") pub fn exec(path: String) : String / Ffi

#[doc("Start the pushed argv (PATH-searched) in `dir` with stdout/stderr sent to the named files (empty inherits, `&2` joins stderr). Returns a handle for `wait`, or -1.")]
extern "C"("kaicli_spawn") pub fn spawn(dir: String, out: String, err: String) : Int / Ffi

#[doc("Wait for a spawned child: its exit code, or 128 + the signal that killed it; -1 when unobservable.")]
extern "C"("kaicli_wait") pub fn wait(child: Int) : Int / Ffi

#[doc("Catch SIGINT/SIGTERM/SIGHUP so kai outlives an interrupted child and can clean up.")]
extern "C"("kaicli_defer_signals") pub fn defer_signals() : Unit / Ffi

#[doc("The last deferred signal, or 0 when none arrived.")]
extern "C"("kaicli_pending_signal") pub fn pending_signal() : Int / Ffi

#[doc("Create a private directory from a mkdtemp template (`...XXXXXX`); empty on failure.")]
extern "C"("kaicli_mkdtemp") pub fn mkdtemp(template: String) : String / Ffi

#[doc("Remove `path` and everything below it, without following symlinks.")]
extern "C"("kaicli_remove_tree") pub fn remove_tree(path: String) : Unit / Ffi

#[doc("Write a file's exact bytes to stderr, as `cat path >&2`.")]
extern "C"("kaicli_copy_to_stderr") pub fn copy_to_stderr(path: String) : Unit / Ffi

#[doc("The working directory as the invoking shell reports it (logical `$PWD` when valid).")]
extern "C"("kaicli_cwd") pub fn cwd() : String / Ffi

#[doc("Raise the soft stack limit to `bytes`, inherited by every child; failures are ignored.")]
extern "C"("kaicli_raise_stack") pub fn raise_stack(bytes: Int) : Unit / Ffi

#[doc("Operating system name, as `uname -s` prints it.")]
extern "C"("kaicli_uname_s") pub fn uname_s() : String / Ffi

#[doc("Machine hardware name, as `uname -m` prints it.")]
extern "C"("kaicli_uname_m") pub fn uname_m() : String / Ffi

#[doc("Sleep `secs` seconds.")]
extern "C"("kaicli_sleep") pub fn sleep(secs: Int) : Unit / Ffi

#[doc("This process's id.")]
extern "C"("kaicli_getpid") pub fn getpid() : Int / Ffi

#[doc("Online CPU count.")]
extern "C"("kaicli_ncpu") pub fn ncpu() : Int / Ffi

#[doc("Start a new SHA-256 digest.")]
extern "C"("kaicli_sha_reset") pub fn sha_reset() : Unit / Ffi

#[doc("Feed a string's bytes to the digest.")]
extern "C"("kaicli_sha_str") pub fn sha_str(s: String) : Unit / Ffi

#[doc("Feed a file's bytes to the digest; false when it cannot be read.")]
extern "C"("kaicli_sha_file") pub fn sha_file(path: String) : Bool / Ffi

#[doc("Finish the digest and return it as 64 lowercase hex digits.")]
extern "C"("kaicli_sha_hex") pub fn sha_hex() : String / Ffi
