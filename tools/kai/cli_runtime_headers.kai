#[doc("The header set behind `runtime.h`: the umbrella and every header it includes by a quoted path, which the build caches key on.")]

import cli_file_digest
import cli_fs
import cli_hash
import cli_sys

fn quoted(line: String) : Option[String] =
  if string.starts_with(line, "#include \"") {
    let rest = string_slice(line, 10, string_length(line))
    match string.index_of(rest, "\"") {
      Some(i) -> Some(string_slice(rest, 0, i))
      None -> None
    }
  } else {
    None
  }

fn visit(file: String, seen: [String]) : [String] / File + Ffi =
  if list.any(seen, s => s == file) or (not cli_sys.is_file(file)) {
    seen
  } else {
    match read_file(file) {
      Ok(text) -> string.split(text, "\n")
        |> list.foldl(
          seen ++ [file],
          (acc, l) => match quoted(l) {
            Some(inc) -> visit("#{cli_fs.dirname(file)}/#{inc}", acc)
            None -> acc
          }
        )
      Err(_) -> seen ++ [file]
    }
  }

#[doc("The paths of `runtime.h` under `inc` and of every header it pulls in, each once, in include order; empty when `inc` has none.")]
pub fn files(inc: String) : [String] / File + Ffi = visit("#{inc}/runtime.h", [])

#[doc("A key part standing for the header set under `inc` by the content digest of each file, kept in `dir`; read it before any digest begins.")]
pub fn kept(dir: String, inc: String) : cli_hash.Part / File + Ffi {
  let fs = files(inc)
  let ds = cli_file_digest.of(dir, fs)
  cli_hash.Text(string.join(list.zip(fs, ds) |> list.map(fd => "#{fd.fst} #{fd.snd}\n"), ""))
}
