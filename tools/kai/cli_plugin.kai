#[doc("Go-style plugin dispatch: a verb outside the core set runs `kai-<verb>` from PATH.")]

import os.env
import cli_env
import cli_layout
import cli_sys

# A verb that looks like a flag or a path never names a plugin.
fn plugin_name(verb: String) : Bool =
  verb != "" and (not string.starts_with(verb, "-")) and (not string_contains(verb, "/"))

# POSIX PATH semantics: an empty entry is the current directory.
fn candidate(dir: String, verb: String) : String =
  if dir == "" { "./kai-#{verb}" } else { "#{dir}/kai-#{verb}" }

#[doc("The first executable `kai-<verb>` on PATH, if any.")]
pub fn find(verb: String) : Option[String] / Env + Ffi =
  if not plugin_name(verb) {
    None
  } else {
    let dirs = string.split(env.get("PATH").unwrap_or(""), ":")
    dirs | (d => candidate(d, verb)) |> find_exec
  }

fn find_exec(paths: [String]) : Option[String] / Ffi =
  match paths {
    [] -> None
    [p, ...ps] -> if cli_sys.is_exec(p) { Some(p) } else { find_exec(ps) }
  }

fn export(e: (String, String)) : Unit / Env {
  let _ = env.set(e.fst, e.snd)
}

#[doc("Replace kai with the plugin at `prog`, exporting the `kai env` variables; returns only on failure.")]
pub fn launch(l: Layout, prog: String, args: [String]) : Int / Stderr + Env + Ffi {
  cli_env.entries(l) |> foreach(export)
  cli_sys.argv_push(prog)
  args |> foreach(a => cli_sys.argv_push(a))
  let reason = cli_sys.exec(prog)
  Stderr.eprint("kai: error: cannot run #{prog}: #{reason}")
  126
}
