#[doc("Path arguments shared by the multi-path source verbs (`kai fmt`, `kai migrate`): sort, dedup, existence check, package members.")]

import cli_blocks
import cli_compile
import cli_err
import cli_fs
import cli_sys

#[doc("The paths in sorted order with duplicates dropped.")]
pub fn sorted_unique(xs: [String]) : [String] = dedup(list.sort(xs))

fn dedup(xs: [String]) : [String] =
  match xs {
    [a, b, ...rest] if a == b -> dedup([b] ++ rest)
    [a, ...rest] -> [a] ++ dedup(rest)
    [] -> []
  }

fn exists(spec: String, status: Int, verb: String) : Result[Int, Int] / Stderr + Ffi =
  if cli_sys.is_dir(spec) or cli_sys.is_file(spec) {
    Ok(status)
  } else {
    cli_compile.not_found(spec, verb)
  }

#[doc("Fail on the first path that is neither a file nor a directory, before any is touched.")]
pub fn require_all(specs: [String], verb: String) : Result[Int, Int] / Stderr + Ffi =
  cli_blocks.fold_files(specs, 0, (s, st) => exists(s, st, verb))

#[doc("A package directory argument without its trailing slash, which must carry its own `kai.toml`.")]
pub fn sub_package_dir(spec: String) : Result[String, Int] / Stderr + Ffi {
  let dir = string.drop_suffix(spec, "/") ?? spec
  if cli_sys.is_file("#{dir}/kai.toml") {
    Ok(dir)
  } else {
    cli_err.die("#{spec} has no kai.toml — sub-packages must declare their own manifest")
  }
}

#[doc("Every source file a package owns plus its `tests/` siblings, relative to `root`; fails when there are none.")]
pub fn members(root: String, verb: String) : Result[[String], Int] / Stderr + File + Ffi {
  let abs = cli_fs.absolute(root)
  let tests = cli_blocks.tests_of(abs, abs) | (p => string.drop_prefix(p, "#{abs}/") ?? p)
  let files = cli_blocks.source_files(abs) ++ tests
  if list.is_empty(files) {
    cli_err.die("no .kai files found in #{root} (see 'kai #{verb} --help')")
  } else {
    Ok(files)
  }
}
