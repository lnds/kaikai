#[doc("Child processes for the kai CLI: spawn with cwd, redirections and per-child environment; PATH lookup.")]

import os.env
import cli_sys

#[doc("How to start a child: working directory, stdout/stderr files (empty inherits), an fd 3 to append to (empty: none), environment changes.")]
pub type Spawn = {
  dir: String,
  out: String,
  err: String,
  fd3: String,
  set: [(String, String)],
  unset: [String]
}

#[doc("A child that inherits everything from kai.")]
pub fn inherit() : Spawn = Spawn { dir: "", out: "", err: "", fd3: "", set: [], unset: [] }

#[doc("Start `argv` (argv[0] is PATH-searched) as described by `sp`; a handle for `cli_sys.wait`, or -1 when it cannot start.")]
pub fn start(argv: [String], sp: Spawn) : Int / Ffi {
  argv |> foreach(a => cli_sys.argv_push(a))
  sp.set |> foreach(e => cli_sys.child_setenv(e.fst, e.snd))
  sp.unset |> foreach(n => cli_sys.child_unsetenv(n))
  if sp.fd3 != "" { cli_sys.child_fd3(sp.fd3) }
  cli_sys.spawn(sp.dir, sp.out, sp.err)
}

#[doc("Run `argv` to completion: its exit status, 128 + signal when killed, 127 when it cannot start.")]
pub fn run(argv: [String], sp: Spawn) : Int / Ffi {
  let pid = start(argv, sp)
  if pid < 0 { 127 } else { cli_sys.wait(pid) }
}

#[doc("Run `argv` with stdout captured through `file`; the status and what it printed.")]
pub fn capture(argv: [String], sp: Spawn, file: String) : (Int, String) / File + Ffi {
  let rc = run(argv, Spawn { ...sp, out: file })
  let text = match read_file(file) {
    Ok(s) -> s
    Err(_) -> ""
  }
  (rc, text)
}

#[doc("Shell word splitting on blanks: the fields of an unquoted `$VAR`.")]
pub fn words(s: String) : [String] =
  string.split(string.replace(string.replace(s, "\t", " "), "\n", " "), " ")
    |? (w => w != "")

#[doc("`command -v`: a name with a `/` is checked as given, anything else is searched on PATH.")]
pub fn which(name: String) : Option[String] / Env + Ffi =
  if name == "" {
    None
  } else if string_contains(name, "/") {
    if cli_sys.is_exec(name) { Some(name) } else { None }
  } else {
    string.split(env.get("PATH").unwrap_or(""), ":")
      |> list.find_map(d => {
        let p = if d == "" { name } else { "#{d}/#{name}" }
        if cli_sys.is_exec(p) { Some(p) } else { None }
      })
  }

fn cut(cs: [Char], sep: Char) : ([Char], [Char]) {
  let body = list.drop_while(cs, c => c == sep)
  let word = list.take_while(body, c => c != sep)
  (word, list.drop(body, list.length(word)))
}

fn fields_loop(cs: [Char], sep: Char, n: Int) : [String] =
  if n <= 1 {
    let rest = list.drop_while(cs, c => c == sep)
    [string.from_chars(list.reverse(list.drop_while(list.reverse(rest), c => c == sep)))]
  } else {
    let w = cut(cs, sep)
    [string.from_chars(w.fst), ...fields_loop(w.snd, sep, n - 1)]
  }

#[doc("`IFS=<sep> read -r v1 … vn` for a blank separator: runs of it split, the last field keeps the rest.")]
pub fn read_fields(line: String, sep: Char, n: Int) : [String] = fields_loop(string.chars(line), sep, n)
