#[doc("`kai init`, `kai fetch`, `kai add`, `kai update`, `kai show`: kai-pkg run against the package the cwd belongs to.")]

import cli_err
import cli_fs
import cli_manifest
import cli_pkg
import cli_pkg_help
import cli_proc
import cli_sys

# `-h`/`--help` prints the verb's help; any other leading flag is unknown.
fn leading_flag(
  verb: String,
  text: String,
  args: [String]
) : Option[Result[Int, Int]] / Stdout + Stderr =
  match args {
    [a, ..._] if a == "-h" or a == "--help" -> {
      Stdout.print(text)
      Some(Ok(0))
    }
    [a, ..._] if string.starts_with(a, "-") ->
      Some(cli_err.die("unknown flag: #{a} (see 'kai #{verb} --help')"))
    _ -> None
  }

fn missing(args: [String]) : Bool =
  match args {
    [] -> true
    [a, ..._] -> a == ""
  }

# kai-pkg `sub` in the nearest directory holding a kai.toml, with the package cache it shares with builds.
fn in_package(t: Toolchain, sub: [String]) : Result[Int, Int] / Stderr + Env + File + Ffi {
  let here = cli_sys.cwd()
  match cli_manifest.find_dir(here) {
    None -> cli_err.die("no kai.toml found in #{here} or any parent directory")
    Some(dir) -> {
      let kaipkg = cli_pkg.ensure_kaipkg(t)!
      let cache = cli_pkg.cache_root(t)
      let _ = cli_fs.mkdir_p(cache)
      let sp =
        cli_proc.Spawn { ...cli_proc.inherit(), dir: dir, set: [("KAIKAI_CACHE_ROOT", cache)] }
      Ok(cli_proc.run([kaipkg, ...sub], sp))
    }
  }
}

#[doc("`kai init <name>`: a stub kai.toml in the cwd.")]
pub fn init_verb(
  t: Toolchain,
  args: [String]
) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi =
  match leading_flag("init", cli_pkg_help.init_text(), args) {
    Some(r) -> r
    None if missing(args) -> cli_err.die("missing package name (see 'kai init --help')")
    None if cli_sys.is_file("kai.toml") ->
      cli_err.die("kai.toml already exists in #{cli_sys.cwd()}")
    None -> {
      let kaipkg = cli_pkg.ensure_kaipkg(t)!
      Ok(cli_proc.run([kaipkg, "init", ...args], cli_proc.inherit()))
    }
  }

#[doc("`kai fetch`: resolve the package's dependencies and write kai.lock.")]
pub fn fetch_verb(
  t: Toolchain,
  args: [String]
) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi =
  match leading_flag("fetch", cli_pkg_help.fetch_text(), args) {
    Some(r) -> r
    None -> in_package(t, ["install"])
  }

#[doc("`kai add <source>[@<ref>]`: fetch a dependency and record it in kai.toml and kai.lock.")]
pub fn add_verb(
  t: Toolchain,
  args: [String]
) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi =
  match leading_flag("add", cli_pkg_help.add_text(), args) {
    Some(r) -> r
    None if missing(args) -> cli_err.die("missing source argument (see 'kai add --help')")
    None -> in_package(t, ["add", ...args])
  }

#[doc("`kai update [<name>]`: re-fetch dependencies and refresh kai.lock.")]
pub fn update_verb(
  t: Toolchain,
  args: [String]
) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi =
  match leading_flag("update", cli_pkg_help.update_text(), args) {
    Some(r) -> r
    None -> in_package(t, ["update", ...args])
  }

#[doc("`kai show`: print the parsed kai.toml of the package the cwd belongs to.")]
pub fn show_verb(
  t: Toolchain,
  args: [String]
) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi =
  match leading_flag("show", cli_pkg_help.show_text(), args) {
    Some(r) -> r
    None -> in_package(t, ["show"])
  }
