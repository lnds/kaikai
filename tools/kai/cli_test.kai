#[doc("`kai test`: compile the entry and every test file with `--test`, run them, aggregate the status; `./...` walks every package below.")]

import os.env
import cli_blocks
import cli_caches
import cli_compile
import cli_err
import cli_fs
import cli_group
import cli_manifest
import cli_prebuild
import cli_proc
import cli_sys
import cli_test_help

# `--json` and `--only` shape how the runners report and what they run, not how they compile; `jobs` 0 is one per CPU.
type TestOpts = {
  json: Bool,
  only: [String],
  backend: String,
  jobs: Int,
  extra: [String],
  help: Bool
}

fn add_only(o: TestOpts, v: String) : TestOpts = TestOpts { ...o, only: o.only ++ [v] }

fn with_jobs(o: TestOpts, v: String) : Result[TestOpts, Int] / Stderr =
  match string.to_int(v) {
    Some(n) if n > 0 -> Ok(TestOpts { ...o, jobs: n })
    _ -> cli_err.die("--jobs must be a positive integer (got: #{v})")
  }

fn with_backend(o: TestOpts, v: String) : Result[TestOpts, Int] / Stderr =
  cli_compile.backend_name(v).map(b => TestOpts { ...o, backend: b })

const VALUED : [String] = ["--only", "--backend", "-j", "--jobs"]

fn missing(a: String) : String =
  match a {
    "--only" -> "--only needs an argument (see 'kai test --help')"
    "--backend" -> "--backend needs an argument (c|native)"
    _ -> "#{a} needs an argument (a job count)"
  }

# `--key=value` reads as `--key value` for the flags that take one.
fn split_valued(a: String) : [String] =
  match string.index_of(a, "=") {
    Some(i) if VALUED.contains(string_slice(a, 0, i)) ->
      [string_slice(a, 0, i), string_slice(a, i + 1, string_length(a) - i - 1)]
    _ -> [a]
  }

fn valued(o: TestOpts, flag: String, v: String) : Result[TestOpts, Int] / Stderr =
  match flag {
    "--only" -> Ok(add_only(o, v))
    "--backend" -> with_backend(o, v)
    _ -> with_jobs(o, v)
  }

fn parse(args: [String], o: TestOpts) : Result[(TestOpts, [String]), Int] / Stderr =
  match args {
    [] -> Ok((o, []))
    [a, ..._] if a == "-h" or a == "--help" -> Ok((TestOpts { ...o, help: true }, []))
    ["--json", ...rest] -> parse(rest, TestOpts { ...o, json: true })
    [a] if VALUED.contains(a) -> cli_err.die(missing(a))
    [a, v, ...rest] if VALUED.contains(a) -> parse(rest, valued(o, a, v)!)
    ["--", ...rest] -> Ok((o, rest))
    [a, ...rest] if split_valued(a) != [a] -> parse(split_valued(a) ++ rest, o)
    [a, ...rest] if string.starts_with(a, "-") ->
      parse(rest, TestOpts { ...o, extra: o.extra ++ [a] })
    _ -> Ok((o, args))
  }

fn label_of(dir: String) : String / File + Ffi =
  match cli_manifest.package_name(dir) {
    Some(n) -> "#{n} (#{dir})"
    None -> dir
  }

# Visit one package: `(ran, failed)` so far, updated. The run inherits the walk's selection and logs.
fn visit(
  t: Toolchain,
  flags: [String],
  acc: (Int, Bool),
  dir: String
) : (Int, Bool) / Stderr + File + Ffi {
  let label = label_of(dir)
  let rel = cli_manifest.entry(dir)
  if cli_sys.pending_signal() != 0 {
    acc
  } else if (not cli_sys.is_file("#{dir}/#{rel}")) and list.is_empty(cli_blocks.test_files(dir)) {
    Stderr.eprint("== kai test SKIP #{label} (no #{rel}, no *_test.kai)")
    acc
  } else {
    Stderr.eprint("== kai test #{label}")
    let pkg = string.drop_prefix(dir, "./").unwrap_or(dir)
    let rc = cli_proc.run(["#{t.layout.root}/bin/kai", "test", ...flags], cli_proc.Spawn {
      ...cli_proc.inherit(),
      dir: dir,
      set: [("KAI_TEST_PACKAGE", pkg)]
    })
    if rc != 0 { Stderr.eprint("== FAIL #{label}") }
    let next = (acc.fst + 1, acc.snd or rc != 0)
    next
  }
}

# `kai test ./...`: every directory below the cwd carrying a kai.toml, each in its own `kai test`; one verdict over them all.
fn recursive(
  t: Toolchain,
  o: TestOpts,
  flags: [String],
  logs: (String, String)
) : Int / Stdout + Stderr + File + Ffi {
  let here = cli_sys.cwd()
  let dirs = dir_walk(".")
    |? (p => cli_fs.basename(p) == "kai.toml")
    |> list.sort
    | (p => cli_fs.dirname(p))
  if list.is_empty(dirs) {
    Stderr.eprint("kai: no kai.toml found under #{here}")
    1
  } else {
    walked(o, logs, here, dirs |> list.foldl((0, false), (acc, d) => visit(t, flags, acc, d)))
  }
}

# The walk's verdict over `(ran, failed)`: `--only` and `--json` settle here, once for every package.
fn walked(
  o: TestOpts,
  logs: (String, String),
  here: String,
  r: (Int, Bool)
) : Int / Stdout + Stderr + File + Ffi =
  if r.fst == 0 {
    Stderr.eprint("kai: no buildable packages found under #{here}")
    1
  } else {
    let status = verdict(o, logs, if r.snd { 1 } else { 0 })
    if status == 0 { Stderr.eprint("kai: all package tests passed (#{r.fst} package(s))") }
    status
  }

fn log_file(tmp: String, name: String) : String / File {
  let f = "#{tmp}/#{name}"
  let _ = write_file(f, "")
  f
}

fn jobs_of(o: TestOpts) : Int / Ffi = if o.jobs > 0 { o.jobs } else { cli_sys.ncpu() }

fn jobs_flag(o: TestOpts) : [String] =
  if o.jobs > 0 { ["--jobs", int_to_string(o.jobs)] } else { [] }

fn tests_dir_step(o: TestOpts, tmp: String, tf: String) : Step =
  cli_blocks.Build(cli_blocks.Runner {
    src: tf,
    out: "#{tmp}/#{cli_fs.stem(tf)}-t",
    header: if o.json { "" } else { "== kai test #{tf}" }
  })

# The entry, then its `tests/` sibling, then the package's unreachable test files.
fn run_all(t: Toolchain, b: Backend, o: TestOpts, src: String, root: String, tmp: String) : Result[
  Int,
  Int
] / Stderr + Env + File + Ffi {
  let pass = cli_blocks.Pass { kind: "test", flag: "--test", extra: o.extra }
  let entry_status = if src == "" {
    0
  } else {
    let entry = cli_blocks.Runner { src, out: "#{tmp}/#{cli_fs.stem(src)}-t", header: "" }
    cli_compile.compile(t, b, cli_blocks.runner_job(pass, entry, tmp))!
    cli_blocks.run_binary(src, entry.out, tmp)
  }
  let tests = cli_blocks.tests_of(if src == "" { root } else { cli_fs.dirname(src) })
  let pkg = if root == "" {
    []
  } else {
    cli_blocks.package_steps(root, src, pass, not list.is_empty(tests), tmp)
  }
  let steps = (tests | (tf => tests_dir_step(o, tmp, tf))) ++ pkg
  cli_prebuild.run(t, b, pass, jobs_of(o), steps, entry_status, tmp, src != "")
}

# A selection that matched nothing is a caller error, whatever the output format.
fn verdict(o: TestOpts, logs: (String, String), status: Int) : Int / Stdout + Stderr + File + Ffi {
  let only = string.join(o.only, "\n") != ""
  if logs.fst != "" and o.json { cli_sys.copy_to_stdout(logs.fst) }
  let json_miss = logs.fst != ""
    and only
    and (not (string.split(cli_fs.read_or_empty(logs.fst), "\n")
      |> list.any(l => string.starts_with(l, "{\"type\":\"test\""))))
  let ran_miss = logs.snd != ""
    and (not (string.split(cli_fs.read_or_empty(logs.snd), "\n") |> list.any(l => ran_line(l))))
  if json_miss or ran_miss {
    Stderr.eprint("kai: no test matched --only")
    1
  } else {
    status
  }
}

# `^ +(ok|FAIL) `: a per-block line of the runner.
fn ran_line(l: String) : Bool {
  let t = string.from_chars(string.chars(l) |> list.drop_while(c => c == ' '))
  string.starts_with(l, " ") and (string.starts_with(t, "ok ") or string.starts_with(t, "FAIL "))
}

# The record log under `--json`, the ran log under a text `--only`; both exported so every runner — nested `kai test` runs included — reports into them.
fn open_logs(o: TestOpts, tmp: String) : (String, String) / Env + File {
  let json_log = if o.json { log_file(tmp, "json.log") } else { "" }
  let ran_log =
    if string.join(o.only, "\n") != "" and (not o.json) { log_file(tmp, "ran.log") } else { "" }
  if json_log != "" { let _ = env.set("KAI_TEST_JSON_LOG", json_log) }
  if ran_log != "" { let _ = env.set("KAI_TEST_RAN_LOG", ran_log) }
  let logs = (json_log, ran_log)
  logs
}

fn run_suite(
  t: Toolchain,
  o: TestOpts,
  rest: [String],
  tmp: String
) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi {
  let logs = open_logs(o, tmp)
  let b = cli_compile.resolve_backend(o.backend)!
  cli_caches.default_native_jobs(jobs_of(o))
  let rec = (if o.backend == "" { [] } else { ["--backend", o.backend] }) ++ jobs_flag(o)
  match rest {
    [s, ..._] if s == "./..." or s == "..." -> Ok(recursive(t, o, rec ++ o.extra, logs))
    _ -> {
      let target = cli_blocks.target(rest, "test")!
      let status = run_all(t, b, o, target.fst, target.snd, tmp)!
      Ok(verdict(o, logs, status))
    }
  }
}

fn suite(
  t: Toolchain,
  o: TestOpts,
  rest: [String]
) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi =
  if o.help {
    Stdout.print(cli_test_help.test_text())
    Ok(0)
  } else {
    # A package run inside a `./...` walk keeps the walk's selection.
    if cli_caches.env_or("KAI_TEST_PACKAGE", "") == "" {
      let _ = env.set("KAI_TEST_ONLY", string.join(o.only, "\n"))
    }
    if o.json { let _ = env.set("KAI_TEST_JSON", "1") }
    cli_fs.with_scratch(tmp => run_suite(t, o, rest, tmp))
  }

#[doc("`kai test [options] [<spec>|./...]`: the aggregate exit status.")]
pub fn test_verb(
  t: Toolchain,
  args: [String]
) : Result[Int, Int] / Stdout + Stderr + Env + File + Ffi {
  let parsed =
    parse(args, TestOpts { json: false, only: [], backend: "", jobs: 0, extra: [], help: false })!
  let o = parsed.fst
  match cli_caches.env_or(cli_group.BUILD_ONLY, "") {
    "" -> suite(t, o, parsed.snd)
    out -> cli_group.build_only(t, o.backend, o.extra, parsed.snd, out)
  }
}
