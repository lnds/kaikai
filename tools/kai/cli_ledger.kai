#[doc("""
The install prefix `kai install` writes binaries to and its ledger,
`<prefix>/.kai-installed`: one `<name>\\t<source>\\t<ref>` line per binary
the user installed, which `kai upgrade` carries across a toolchain swap.
""")]

import cli_fs
import cli_layout
import cli_sys

#[doc("The ledger of the prefix `kai install` targets.")]
pub fn path(l: Layout) : String / Env + Ffi = "#{cli_layout.home(l)}/.kai-installed"

# The ledger's lines; a final newline ends the last one rather than opening another.
fn lines(l: Layout) : [String] / Env + File + Ffi {
  let content = cli_fs.read_or_empty(path(l))
  let parts = string.split(content, "\n")
  if content == "" {
    []
  } else if string.ends_with(content, "\n") {
    list.init(parts).unwrap_or([])
  } else {
    parts
  }
}

fn owns(line: String, name: String) : Bool = string.starts_with(line, "#{name}\t")

#[doc("Record `name` as installed from `source` at `ref`, replacing any earlier entry; the ledger stays byte-sorted.")]
pub fn record(l: Layout, name: String, source: String, ref: String) : Unit / Env + File + Ffi {
  let file = path(l)
  let _ = cli_fs.mkdir_p(cli_fs.dirname(file))
  let kept = lines(l) |? (x => not owns(x, name))
  let sorted = list.sort(kept ++ ["#{name}\t#{source}\t#{ref}"])
  let part = "#{file}.tmp.#{cli_sys.getpid()}"
  let _ = write_file(part, string.join(sorted | (x => "#{x}\n"), ""))
  let _ = file_rename(part, file)
}

fn listed(line: String) : [String] =
  match string.split(line, "\t") |? (f => f != "") {
    [n, src, ...ref] -> ["#{n}\t#{src}@#{string.join(ref, "\t")}"]
    [n] -> ["#{n}\t@"]
    [] -> []
  }

#[doc("`kai install --list`: each installed binary as `<name>\\t<source>@<ref>`.")]
pub fn listing(l: Layout) : Unit / Stdout + Stderr + Env + File + Ffi {
  if cli_fs.read_or_empty(path(l)) == "" {
    Stderr.eprint("kai: no packages installed")
  } else {
    lines(l) || listed |> foreach(x => Stdout.print(x))
  }
}

#[doc("What a release installs under `bin/` and `libexec/kaikai/`, by name, whether or not this prefix has it yet.")]
pub const TOOLCHAIN_NAMES : [String] = ["kai", "kaic2", "kai-pkg", "kai-lsp", "kai-upgrade", "plugins"]

fn entries(dir: String) : [String] / File + Ffi =
  if cli_sys.is_dir(dir) { dir_list_dir(dir) } else { [] }

#[doc("""
Names a user package may not claim: the toolchain's own binaries, and
whatever else already sits in the prefix's `bin/` and `libexec/kaikai/`
that the ledger does not record as the user's.
""")]
pub fn reserved(l: Layout) : [String] / Env + File + Ffi {
  let prefix = cli_layout.home(l)
  let ledger = lines(l)
  let present = entries("#{prefix}/bin") ++ entries("#{prefix}/libexec/kaikai")
  TOOLCHAIN_NAMES ++ (present |? (n => not (ledger |> list.any(x => owns(x, n)))))
}
