#[doc("Package specs: `.` or nothing (the cwd package), a directory (a sub-package with its own kai.toml), or a `.kai` file.")]

import cli_err
import cli_manifest
import cli_sys

# The entry a manifest names; a library (no entry file) resolves to empty when `optional`.
fn entry_of(
  dir: String,
  shown: String,
  action: String,
  optional: Bool
) : Result[String, Int] / Stderr + File + Ffi {
  let rel = cli_manifest.entry(dir)
  let path = "#{dir}/#{rel}"
  if not cli_sys.is_file(path) {
    let manifest = if shown == "" { "kai.toml" } else { "#{dir}/kai.toml" }
    if optional {
      Ok("")
    } else {
      cli_err.die("#{manifest} declares entry = '#{rel}' but #{path} does not exist")
    }
  } else {
    let label = if shown == "" { rel } else { path }
    match cli_manifest.package_name(dir) {
      Some(n) -> Stderr.eprint("kai: #{action} package '#{n}' (entry point: #{label})")
      None -> Stderr.eprint("kai: using #{label} as entry point")
    }
    Ok(path)
  }
}

# Without a manifest in the cwd: `./main.kai`, else the only `.kai` file there, else nothing.
fn legacy() : String / Stderr + File + Ffi =
  if cli_sys.is_file("./main.kai") {
    Stderr.eprint("kai: using ./main.kai as entry point")
    "./main.kai"
  } else {
    let kais = dir_list_dir(".")
      |? (f => string.ends_with(f, ".kai")
        and (not string.starts_with(f, "."))
        and cli_sys.is_file(f))
    match kais {
      [only] -> {
        Stderr.eprint("kai: using ./#{only} as entry point (only .kai file in cwd)")
        "./#{only}"
      }
      _ -> ""
    }
  }

fn cwd_package(action: String, optional: Bool) : Result[String, Int] / Stderr + File + Ffi {
  let here = cli_sys.cwd()
  match cli_manifest.find_dir(here) {
    Some(m) if m == here -> entry_of(m, "", action, optional)
    _ -> Ok(legacy())
  }
}

fn sub_package(
  spec: String,
  action: String,
  optional: Bool
) : Result[String, Int] / Stderr + File + Ffi {
  let rel = string.drop_prefix(spec, "./").unwrap_or(spec)
  let sub = string.drop_suffix(rel, "/").unwrap_or(rel)
  if not cli_sys.is_file("#{sub}/kai.toml") {
    cli_err.die("#{spec} has no kai.toml — sub-packages must declare their own manifest")
  } else {
    entry_of(sub, sub, action, optional)
  }
}

#[doc("Whether `spec` names a package rather than a file: nothing, `.`, or a directory on disk.")]
pub fn is_package(spec: String) : Bool / Ffi = spec == "" or spec == "." or cli_sys.is_dir(spec)

#[doc("""
Resolve a spec to its entry file, announcing an inferred one on stderr
with `action` (`building`, …). Empty when nothing can be inferred, or
for a library when `optional` (the block runners need no entry).
""")]
pub fn resolve(
  spec: String,
  action: String,
  optional: Bool
) : Result[String, Int] / Stderr + File + Ffi =
  if spec == "" or spec == "." {
    cwd_package(action, optional)
  } else if cli_sys.is_dir(spec) {
    sub_package(spec, action, optional)
  } else if string.ends_with(spec, ".kai") {
    Ok(spec)
  } else {
    cli_err.die("expected a .kai file, '.', or a package directory (got: #{spec})")
  }
