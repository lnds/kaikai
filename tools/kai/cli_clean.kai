#[doc("`kai clean`: delete the package's `.kai-cache` and, with `--cache`, the shared build caches.")]

import cli_gc
import cli_manifest
import cli_sys

fn usage() : String = """usage: kai clean [--package] [--cache]

Delete cached build products and print how much that freed.

  --package   The cwd package's .kai-cache (the default with no flag).
  --cache     The shared caches under the user cache directory
              (compiled modules, core blobs, native objects, fetched
              dependencies); the next build refills what it needs."""

fn has(args: [String], flag: String) : Bool = args |> list.any(a => a == flag)

fn package_dir() : String / Ffi = cli_manifest.find_dir(cli_sys.cwd()) ?? cli_sys.cwd()

#[doc("Run `kai clean`; the process status.")]
pub fn run(args: [String]) : Int / Stdout + Stderr + Env + File + Ffi =
  match args |? (a => a != "--package" and a != "--cache") {
    [] -> {
      if has(args, "--cache") {
        cli_gc.clean_shared(cli_sys.uname_s())
      }
      if list.is_empty(args) or has(args, "--package") {
        cli_gc.clean_package(package_dir())
      }
      0
    }
    [h, ..._] if h == "--help" or h == "-h" -> {
      Stdout.print(usage())
      0
    }
    [bad, ..._] -> {
      Stderr.eprint("kai: error: unknown flag for clean: #{bad}")
      Stderr.eprint(usage())
      2
    }
  }
