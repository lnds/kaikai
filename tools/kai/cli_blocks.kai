#[doc("""
Package-wide block discovery for `kai test`, `kai check` and `kai bench`.

The entry build reaches only its import graph, and files holding blocks
are leaves nothing imports, so every unreachable `*_test.kai` a package
owns compiles and runs as its own runner binary.

A build runs the blocks of its root alone: every file of a package that
declares blocks is the root of one runner, so a module's blocks run once,
under its own file, however many files import it. A module imported from
the stdlib or from a dependency never adds its blocks to a run.
""")]

import os.env
import cli_caches
import cli_compile
import cli_err
import cli_fs
import cli_manifest
import cli_plan
import cli_proc
import cli_spec
import cli_sys
import cli_toolchain

fn is_hidden(rel: String) : Bool =
  string.starts_with(rel, ".") and string_contains(rel, "/") or string_contains(rel, "/.")

# A nested package (its own kai.toml) owns what sits below it; so does a `tests/` dir, unless `tests` counts them in.
fn owned(root: String, d: String, tests: Bool) : Bool / Ffi =
  if d == "." {
    true
  } else if cli_sys.is_file("#{root}/#{d}/kai.toml")
    or (not tests) and cli_fs.basename(d) == "tests" {
    false
  } else {
    owned(root, cli_fs.dirname(d), tests)
  }

# Every `.kai` file under `root` outside nested packages and hidden dirs, root-relative and sorted.
fn kai_files(root: String, tests: Bool) : [String] / File + Ffi =
  dir_walk(root)
    |? (p => string.ends_with(p, ".kai"))
    | (p => string.drop_prefix(p, "#{root}/").unwrap_or(p))
    |> list.sort
    |? (rel => (not is_hidden(rel)) and owned(root, cli_fs.dirname(rel), tests))

#[doc("Every `.kai` file package `root` owns, root-relative and sorted; nested packages, `tests/` and hidden dirs excluded.")]
pub fn source_files(root: String) : [String] / File + Ffi = kai_files(root, false)

fn tests_dir_files(dir: String) : [String] / File + Ffi =
  if cli_sys.is_dir(dir) {
    list.sort(dir_list_dir(dir) |? (f => string.ends_with(f, ".kai")))
      | (f => "#{dir}/#{f}")
      |? (p => cli_sys.is_file(p))
  } else {
    []
  }

#[doc("The `*_test.kai` files package `root` owns plus its `tests/*.kai`: what an entry-less run compiles.")]
pub fn test_files(root: String) : [String] / File + Ffi =
  (source_files(root) |? (rel => string.ends_with(rel, "_test.kai")))
    ++ tests_dir_files("#{root}/tests")

#[doc("`kai test`'s `tests/` directories: the sibling of the entry and, when the manifest of package `root` sits elsewhere, the one beside it. Their `.kai` files, sorted within each.")]
pub fn tests_of(entry_dir: String, root: String) : [String] / File + Ffi =
  if root == "" or cli_fs.absolute(root) == cli_fs.absolute(entry_dir) {
    tests_dir_files("#{entry_dir}/tests")
  } else {
    tests_dir_files("#{entry_dir}/tests") ++ tests_dir_files("#{root}/tests")
  }

#[doc("True when some line of `file` opens a `kind` block: `^\\s*<kind>\\s+\"`.")]
pub fn declares(file: String, kind: String) : Bool / File =
  string.split(cli_fs.read_or_empty(file), "\n")
    |> list.any(
      l => match string.drop_prefix(string.trim_left(l), kind) {
        Some(rest) -> (string.starts_with(rest, " ") or string.starts_with(rest, "\t"))
          and string.starts_with(string.trim_left(rest), "\"")
        None -> false
      }
    )

fn ident_prefix(cs: [Char]) : [Char] =
  match cs {
    [c, ...rest] if char.is_alnum(c) or c == '.' -> [c, ...ident_prefix(rest)]
    _ -> []
  }

# The module an `import` line names, when its file sits under `root`.
fn import_target(root: String, l: String) : [String] / Ffi {
  let rest = string.drop_prefix(string.trim_left(l), "import").unwrap_or("")
  let spaced = string.starts_with(rest, " ") or string.starts_with(rest, "\t")
  let cs = string.chars(string.trim_left(rest))
  let starts = match cs {
    [c, ..._] -> char.is_alpha(c)
    [] -> false
  }
  let m = string.from_chars(ident_prefix(cs))
  let rel = "#{string.replace(string.drop_suffix(m, ".").unwrap_or(m), ".", "/")}.kai"
  if spaced and starts and cli_sys.is_file("#{root}/#{rel}") { [rel] } else { [] }
}

# `import <mod>` lines naming a module file under `root`, as root-relative paths.
fn local_imports(root: String, file: String) : [String] / File + Ffi =
  string.split(cli_fs.read_or_empty("#{root}/#{file}"), "\n") || (l => import_target(root, l))

fn closure(root: String, frontier: [String], seen: [String]) : [String] / File + Ffi =
  match frontier {
    [] -> seen
    _ -> {
      let next = frontier
        || (f => local_imports(root, f))
        |> list.foldl(
          [],
          (acc, r) => if seen.contains(r) or acc.contains(r) { acc } else { acc ++ [r] }
        )
      closure(root, next, seen ++ next)
    }
  }

#[doc("The package root a spec names when a manifest governs it (arming package-wide discovery), else empty.")]
pub fn package_root(spec: String) : String / Ffi =
  if spec == "" or spec == "." {
    if cli_sys.is_file("kai.toml") { "." } else { "" }
  } else if cli_sys.is_dir(spec) {
    let rel = string.drop_prefix(spec, "./").unwrap_or(spec)
    let sub = string.drop_suffix(rel, "/").unwrap_or(rel)
    if cli_sys.is_file("#{sub}/kai.toml") { sub } else { "" }
  } else {
    ""
  }

fn append_file(from: String, to: String) : Unit / File {
  let _ = write_file(to, cli_fs.read_or_empty(to) ++ cli_fs.read_or_empty(from))
}

# The file part of a block's id: relative to the cwd when under it, else as given; a `kai test ./...` walk leads it with the package's dir.
fn test_id(file: String) : String / Env + Ffi {
  let rel = string.drop_prefix(cli_fs.absolute(file), "#{cli_sys.cwd()}/").unwrap_or(file)
  match cli_caches.env_or("KAI_TEST_PACKAGE", ".") {
    "." -> rel
    dir -> "#{dir}/#{rel}"
  }
}

#[doc("""
Run one runner binary built from `file`, with `KAI_TEST_FILE` naming it
as block ids spell it. Under `KAI_TEST_JSON_LOG` its record stream (fd 3)
appends to that log and its stdout joins stderr; under `KAI_TEST_RAN_LOG`
its stderr is also kept there.
""")]
pub fn run_binary(file: String, bin: String, tmp: String) : Int / Env + File + Ffi =
  run_binary_in(file, bin, tmp, "")

#[doc("`run_binary` for a grouped binary: `homes` (when not empty) is the run order of `file`'s own build, as `KAI_TEST_HOMES`.")]
pub fn run_binary_in(
  file: String,
  bin: String,
  tmp: String,
  homes: String
) : Int / Env + File + Ffi {
  let base = cli_proc.Spawn {
    ...cli_proc.inherit(),
    set: [("KAI_TEST_FILE", test_id(file))]
      ++ (if homes == "" { [] } else { [("KAI_TEST_HOMES", homes)] }),
    unset: ["KAI_TEST_PACKAGE"]
  }
  let json = cli_caches.env_or("KAI_TEST_JSON_LOG", "")
  let ran = cli_caches.env_or("KAI_TEST_RAN_LOG", "")
  if json != "" {
    cli_proc.run([bin], cli_proc.Spawn { ...base, out: "&2", fd3: json })
  } else if ran != "" {
    let err = "#{tmp}/runner.err"
    let rc = cli_proc.run([bin], cli_proc.Spawn { ...base, err: err })
    cli_sys.copy_to_stderr(err)
    append_file(err, ran)
    rc
  } else {
    cli_proc.run([bin], base)
  }
}

#[doc("One discovery pass: what kind of block, the flag that compiles it, and the kaic2 flags forwarded after it.")]
pub type Pass = { kind: String, flag: String, extra: [String] }

#[doc("A runner binary to build from `src` into `out` and run, announced by `header` (empty: silently).")]
pub type Runner = { src: String, out: String, header: String }

#[doc("One step of a pass, in run order: build and run a runner, or print a warning.")]
pub type Step = Build(Runner) | Warn(String)

#[doc("The files of the package `src` belongs to: every file of the package that governs it, its `tests/` too; with no package, the modules it imports from its own directory.")]
pub fn own_files(src: String) : [String] / File + Ffi {
  let dir = cli_fs.absolute(cli_fs.dirname(src))
  match cli_manifest.find_dir(dir) {
    Some(pkg) -> kai_files(pkg, true) | (rel => "#{pkg}/#{rel}")
    None -> {
      let entry = cli_fs.basename(src)
      closure(dir, [entry], [entry]) | (rel => "#{dir}/#{rel}")
    }
  }
}

#[doc("The source files of the package `src` belongs to that `src` never imports, as absolute paths; none outside a package.")]
pub fn unreached_files(src: String) : [String] / File + Ffi =
  match cli_manifest.find_dir(cli_fs.absolute(cli_fs.dirname(src))) {
    Some(pkg) -> {
      let entry = string.drop_prefix(cli_fs.absolute(src), "#{pkg}/").unwrap_or(cli_fs.basename(src))
      let reached = closure(pkg, [entry], [entry])
      source_files(pkg) |? (rel => not reached.contains(rel)) | (rel => "#{pkg}/#{rel}")
    }
    None -> []
  }

# A test or check run also generates the law checks of the impls it owns.
fn runs_in(file: String, kind: String) : Bool / File =
  declares(file, kind) or (kind == "test" or kind == "check") and declares_impl(file)

fn declares_impl(file: String) : Bool / File =
  string.split(cli_fs.read_or_empty(file), "\n")
    |> list.any(
      l => match string.drop_prefix(string.trim_left(l), "impl") {
        Some(rest) -> string.starts_with(rest, " ") or string.starts_with(rest, "[")
        None -> false
      }
    )

#[doc("Set for the whole of a `kai test --coverage` run: its builds probe the package's lines and its runners report them.")]
pub const COVERAGE_ENV : String = "KAI_TEST_COVERAGE"

#[doc("The files a coverage build of `src` probes: the package's own sources, its tests left out.")]
pub fn covered_files(src: String) : [String] / File + Ffi {
  let files = match cli_manifest.find_dir(cli_fs.absolute(cli_fs.dirname(src))) {
    Some(pkg) -> source_files(pkg) | (rel => "#{pkg}/#{rel}")
    None -> own_files(src)
  }
  files |? (f => not string.ends_with(f, "_test.kai"))
}

#[doc("The kaic2 flags probing the files `covered_files(src)` names under a coverage run, the root `src` among them when it is one; none otherwise.")]
pub fn cover_flags(src: String) : [String] / Env + File + Ffi =
  if cli_caches.env_or(COVERAGE_ENV, "") == "" {
    []
  } else {
    let root = cli_fs.absolute(src)
    covered_files(src) || (f => [if f == root { "--cover-root" } else { "--cover" }, f])
  }

#[doc("The kaic2 job that builds runner `r` for `pass`, with `tmp` as its scratch dir.")]
pub fn runner_job(pass: Pass, r: Runner, tmp: String) : Job / Env + File + Ffi =
  cli_plan.Job {
    src: r.src,
    tmp,
    out: r.out,
    verb: pass.kind,
    extra: [pass.flag, ...pass.extra, ...cover_flags(r.src)]
  }

#[doc("Fold `step` over `items` from `status`, stopping early once an interrupt is pending.")]
pub fn fold_files[a, e](
  items: [a],
  status: Int,
  step: (a, Int) -> Result[Int, Int] / e
) : Result[Int, Int] / Ffi + e =
  match items {
    [] -> Ok(status)
    _ if cli_sys.pending_signal() != 0 -> Ok(status)
    [f, ...rest] -> {
      let next = step(f, status)!
      fold_files(rest, next, step)
    }
  }

#[doc("Run binary `bin` built from `src`: its status when it failed, else `status`.")]
pub fn ran(src: String, bin: String, tmp: String, status: Int) : Int / Env + File + Ffi =
  ran_in(src, bin, tmp, "", status)

#[doc("`ran` through `run_binary_in`.")]
pub fn ran_in(
  src: String,
  bin: String,
  tmp: String,
  homes: String,
  status: Int
) : Int / Env + File + Ffi {
  let rc = run_binary_in(src, bin, tmp, homes)
  if rc != 0 { rc } else { status }
}

fn take_step(t: Toolchain, b: Backend, pass: Pass, tmp: String, s: Step, status: Int) : Result[
  Int,
  Int
] / Stderr + Env + File + Ffi =
  match s {
    Warn(msg) -> {
      Stderr.eprint(msg)
      Ok(status)
    }
    Build(r) -> {
      if r.header != "" { Stderr.eprint(r.header) }
      cli_compile.compile(t, b, runner_job(pass, r, tmp))!
      Ok(ran(r.src, r.out, tmp, status))
    }
  }

#[doc("Take `steps` in order, building each runner in place: the last failing status, else `status`.")]
pub fn run_steps(
  t: Toolchain,
  b: Backend,
  pass: Pass,
  steps: [Step],
  status: Int,
  tmp: String
) : Result[Int, Int] / Stderr + Env + File + Ffi =
  fold_files(steps, status, (s, st) => take_step(t, b, pass, tmp, s, st))

fn announce(pass: Pass, rel: String) : String / Env =
  if cli_caches.env_or("KAI_TEST_JSON", "") == "" { "== kai #{pass.kind} #{rel}" } else { "" }

fn module_runner(root: String, pass: Pass, tmp: String, rel: String) : Step / Env {
  let stem = string.drop_suffix(rel, ".kai").unwrap_or(rel)
  let out = "#{tmp}/#{string.replace(stem, "/", "_")}-r"
  Build(Runner { src: "#{root}/#{rel}", out, header: announce(pass, rel) })
}

fn discovered(
  root: String,
  entry: String,
  imported: [String],
  pass: Pass,
  tmp: String,
  rel: String
) : [Step] / Env + File + Ffi =
  if rel == entry or (not runs_in("#{root}/#{rel}", pass.kind)) {
    []
  } else if string.ends_with(rel, "_test.kai") or imported.contains(rel) {
    [module_runner(root, pass, tmp, rel)]
  } else {
    [
      Warn(
        "kai: warning: #{rel} declares #{pass.kind} blocks but is not reachable from the entry point; rename it to *_test.kai (or move it under tests/) so package #{pass.kind} runs include it"
      )
    ]
  }

#[doc("""
The steps for every unreachable `*_test.kai` of package `root` holding
`pass.kind` blocks, binaries under `tmp`; `src` is the entry (empty for
a library). Ends with a warning when no file of the package declares
such blocks (`found` covers the entry side).
""")]
pub fn package_steps(
  root: String,
  src: String,
  pass: Pass,
  found: Bool,
  tmp: String
) : [Step] / Env + File + Ffi {
  let root_abs = cli_fs.absolute(root)
  let entry = if src == "" {
    ""
  } else {
    string.drop_prefix(cli_fs.absolute(src), "#{root_abs}/").unwrap_or(src)
  }
  let files = source_files(root_abs)
  let any = found or (files |> list.any(rel => declares("#{root_abs}/#{rel}", pass.kind)))
  let imported = kai_files(root_abs, true) || (f => local_imports(root_abs, f))
  let steps = files || (rel => discovered(root_abs, entry, imported, pass, tmp, rel))
  if any {
    steps
  } else {
    steps ++ [Warn("kai: warning: no #{pass.kind} blocks found in this package")]
  }
}

#[doc("Run every unreachable `*_test.kai` of package `root` holding `pass.kind` blocks (see `package_steps`): the last failing status, else `status`.")]
pub fn run_package(
  t: Toolchain,
  b: Backend,
  root: String,
  src: String,
  pass: Pass,
  status: Int,
  found: Bool
) : Result[Int, Int] / Stderr + Env + File + Ffi {
  let tmp = cli_fs.scratch_dir()
  let r = run_steps(t, b, pass, package_steps(root, src, pass, found, tmp), status, tmp)
  let _ = cli_sys.remove_tree(tmp)
  r
}

fn entry_of(spec: String, verb: String) : Result[(String, String), Int] / Stderr + File + Ffi {
  let src = cli_spec.resolve(spec, "building", true)!
  let root = package_root(spec)
  if src == "" and root == "" {
    cli_err.die("missing input file (see 'kai #{verb} --help')")
  } else {
    Ok((src, root))
  }
}

#[doc("The runners' target: `(entry, package root)`, either empty — a package spec resolves both, any other spec is the entry as given.")]
pub fn target(rest: [String], verb: String) : Result[(String, String), Int] / Stderr + File + Ffi {
  let spec = match rest {
    [s, ..._] -> s
    [] -> ""
  }
  if cli_spec.is_package(spec) {
    entry_of(spec, verb)
  } else {
    Ok((spec, ""))
  }
}

#[doc("Build the entry, if any, with `pass.flag` into `<tmp>/<stem>-<tag>` and run it as is, then the package's runners: the aggregate status.")]
pub fn run_entry(
  t: Toolchain,
  b: Backend,
  target: (String, String),
  pass: Pass,
  tag: String,
  tmp: String
) : Result[Int, Int] / Stderr + Env + File + Ffi {
  let src = target.fst
  let entry = if src == "" {
    (0, false)
  } else {
    let bin = "#{tmp}/#{cli_fs.stem(src)}-#{tag}"
    cli_compile.compile(t, b, runner_job(pass, Runner { src, out: bin, header: "" }, tmp))!
    (cli_proc.run([bin], cli_proc.inherit()), declares(src, pass.kind))
  }
  if target.snd == "" {
    Ok(entry.fst)
  } else {
    run_package(t, b, target.snd, src, pass, entry.fst, entry.snd)
  }
}
