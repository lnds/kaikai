#[doc("A resolved build: the pieces every backend path shares — kaic2 invocation, diagnostics, runtime owner object, link.")]

import cli_caches
import cli_err
import cli_fs
import cli_ffi_header
import cli_gc
import cli_hash
import cli_nativedeps
import cli_budget
import cli_proc
import cli_runtime_headers
import cli_sys
import cli_toolchain
import cli_wasm

#[doc("The codegen backend, and whether a flag or `KAI_BACKEND` chose it (an implicit native degrades on a C-only kaic2).")]
pub type Backend = { name: String, explicit: Bool }

#[doc("One build request: entry file, scratch dir, output binary, the verb naming it in messages, extra kaic2 flags.")]
pub type Job = { src: String, tmp: String, out: String, verb: String, extra: [String] }

#[doc("A build once the package around the entry file is resolved: its manifest dir (empty: none), the kaic2 flags before the entry, and the native dependencies.")]
pub type Plan = {
  t: Toolchain,
  job: Job,
  src_dir: String,
  manifest: String,
  flags: [String],
  native: [Native],
  native_objs: [String],
  libs: [String],
  native_info: [Native],
  ffi_dir: String
}

#[doc("Optimisation level for the runtime owner object; `tools/tls-hoist-gate.sh --owner` gates its thread-locals at this level.")]
pub const OWNER_OPT : String = "-O2"

#[doc("Why a build stops when a program object names the scheduler's thread-local.")]
pub const SCHEDULER_TLS_READ : String =
  "a program object reads the scheduler thread-local `kai_worker`; only the runtime owner's `kai_worker_here` may"

# macOS ships `nm` as an `xcrun` shim that costs several times the scan itself; the developer
# directory's own binary reads the same symbols.
fn nm_tool() : String / Env + Ffi =
  if cli_proc.which("nm") == Some("/usr/bin/nm") {
    let dev = cli_caches.env_or("DEVELOPER_DIR", "/Applications/Xcode.app/Contents/Developer")
    let tools = [
      "#{dev}/Toolchains/XcodeDefault.xctoolchain/usr/bin/nm",
      "#{dev}/usr/bin/nm",
      "/Library/Developer/CommandLineTools/usr/bin/nm"
    ]
    (tools |> find(c => cli_sys.is_exec(c))) ?? "nm"
  } else {
    "nm"
  }

#[doc("""
True when one of `objs` names `kai_worker`. Only `kai_worker_here` reads it: a
program frame that did could keep its address across a context switch.
""")]
pub fn reads_scheduler_tls(p: Plan, objs: [String]) : Bool / File + Env + Ffi =
  if p.t.target != "" or (cli_proc.which("nm") |> is_some()) {
    cli_proc.capture(
      [if p.t.target == "" { nm_tool() } else { cli_wasm.nm(p.t) }, ...objs],
      cli_proc.Spawn { ...cli_proc.inherit(), err: "/dev/null" },
      "#{p.job.tmp}/nm.out"
    ).snd
      |> string.split("\n")
      |> list.any(l => string.ends_with(l, " kai_worker") or string.ends_with(l, " _kai_worker"))
  } else {
    false
  }

#[doc("The kaic2 argv for `entry`: the emit flags, the plan's flags, the job's extra flags, then the entry.")]
pub fn kaic2(p: Plan, emit: [String], entry: String) : [String] =
  [p.t.layout.kaic2, ...emit]
    ++ p.flags
    ++ (if p.t.target == "" { [] } else { ["--target=#{p.t.target}"] })
    ++ p.job.extra
    ++ (if p.ffi_dir == "" { [] } else { cli_ffi_header.flag(p.ffi_dir) })
    ++ [entry]

#[doc("How kaic2 runs: `KAI_TRACE_RC` removed (the trace belongs to the user's program), `set` added, output to the named files.")]
pub fn kaic2_spawn(set: [(String, String)], out: String, err: String) : Spawn =
  cli_proc.Spawn { ...cli_proc.inherit(), out: out, err: err, set: set, unset: ["KAI_TRACE_RC"] }

#[doc("The C compiler as a command: `$CC` split into words.")]
pub fn cc(t: Toolchain) : [String] = cli_proc.words(t.cc)

# The compiler's executable: the first word of `$CC`, looked up on `$PATH` when it has no slash.
fn cc_exe(t: Toolchain) : String / Env + File + Ffi {
  let w = list.head(cc(t)) ?? ""
  if string_contains(w, "/") {
    w
  } else {
    let hit = string.split(cli_caches.env_or("PATH", ""), ":")
      |> list.map(d => "#{d}/#{w}")
      |> find(f => cli_sys.is_exec(f))
    hit ?? w
  }
}

fn store_cc_identity(dir: String, memo: String, version: String) : Unit / File + Ffi {
  let part = "#{memo}.#{cli_sys.getpid()}"
  if version != "" and cli_fs.mkdir_p(dir) {
    let stored = match write_file(part, version) {
      Ok(_) -> file_rename(part, memo) |> is_ok()
      Err(_) -> false
    }
    if not stored {
      let _ = file_delete(part)
    }
  }
}

#[doc("""
The compiler's identity: what `$CC --version` prints, kept per executable stat so a build
spawns the compiler only when it changed on disk.
""")]
pub fn cc_identity(t: Toolchain) : String / Env + File + Ffi {
  let dir = cli_caches.root("KAI_CC_ID_CACHE_DIR", "cc-id", t.os)
  let exe = cc_exe(t)
  let key = cli_hash.digest([
    cli_hash.lines([t.cc, exe, cli_sys.stat_id(exe), cli_sys.stat_id("/var/db/xcode_select_link")])
  ])
  let memo = "#{dir}/#{key}"
  if cli_gc.refresh(memo) {
    cli_fs.read_or_empty(memo)
  } else {
    let tmp = cli_fs.scratch_dir()
    let version = if tmp == "" {
      ""
    } else {
      let v = cli_proc.capture(
        cc(t) ++ ["--version"],
        cli_proc.Spawn { ...cli_proc.inherit(), err: "/dev/null" },
        "#{tmp}/version"
      ).snd
      let _ = cli_sys.remove_tree(tmp)
      v
    }
    store_cc_identity(dir, memo, version)
    version
  }
}

fn forces_header(w: String) : Bool =
  ["-include", "--include", "-imacros", "--imacros"] |> list.any(f => string.starts_with(w, f))

#[doc("The head of a C compile that includes `runtime.h`. When `$CFLAGS` forces a header in, the runtime's feature-test block goes first, so that header cannot fix the libc feature set before it.")]
pub fn runtime_cc(t: Toolchain) : [String] =
  if t.cflags |> list.any(forces_header) {
    cc(t) ++ ["-DKAI_RUNTIME_FEATURES_ONLY", "-include", "#{t.inc_c}/runtime.h"]
  } else {
    cc(t)
  }

#[doc("Replace the path kaic2 was handed with the user's own in a captured diagnostics file.")]
pub fn rewrite_paths(file: String, from: String, to: String) : Unit / File =
  match read_file(file) {
    Ok(s) if s != "" -> {
      let _ = write_file(file, string.replace(s, from, to))
    }
    _ -> ()
  }

#[doc("Replay a captured stderr file, when it holds anything.")]
pub fn replay(file: String) : Unit / Ffi =
  if cli_sys.size(file) > 0 { cli_sys.copy_to_stderr(file) }

#[doc("True when a captured file names the sentinel a kaic2 without libLLVM prints for a native emit.")]
pub fn c_only(err_file: String) : Bool / File =
  string_contains(cli_fs.read_or_empty(err_file), "not built into this compiler")

#[doc("The plan with its `[native]` sources compiled: they follow the compile, so they may include the `kai_ffi.h` it wrote.")]
pub fn with_objects(p: Plan) : Result[Plan, Int] / Stderr + Env + File + Ffi =
  if list.is_empty(p.native_info) {
    Ok(p)
  } else {
    let dir = if list.is_empty(cli_ffi_header.include(p.ffi_dir)) { "" } else { p.ffi_dir }
    Ok(Plan { ...p, native_objs: cli_nativedeps.objects(p.t, p.native_info, dir, p.job.tmp)! })
  }

#[doc("Run a link line; on failure name the `[native]` causes and fail with `<what> link failed`.")]
pub fn link(p: Plan, argv: [String], what: String) : Result[Unit, Int] / Stderr + Env + File + Ffi =
  if cli_budget.run(argv ++ cli_ffi_header.include(p.ffi_dir), cli_proc.inherit()) == 0 {
    Ok(())
  } else {
    cli_nativedeps.link_hint(p.native)
    cli_err.die("#{what} link failed")
  }

#[doc("""
The runtime owner object for `src` compiled with `defs`, cached under the
native-modular cache by content; empty when the cache or the compile fails
(the caller then compiles the runtime into its link line).
""")]
pub fn runtime_obj(t: Toolchain, src: String, defs: [String]) : String / Env + File + Ffi {
  let dir = "#{cli_caches.root("KAI_NATIVE_MODULAR_CACHE_DIR", "nmodular", t.os)}/runtime"
  let made = cli_fs.mkdir_p(dir)
  let headers = [cli_runtime_headers.kept(dir, t.inc_c)]
    ++ (if t.inc != t.inc_c { [cli_runtime_headers.kept(dir, t.inc)] } else { [] })
  let head = cli_hash.lines([
    t.cc,
    string.join(t.cflags_compile, " "),
    OWNER_OPT,
    string.join(defs, " "),
    cli_toolchain.host(t),
    cc_identity(t)
  ])
  let obj = "#{dir}/#{cli_hash.digest([head, cli_hash.Bytes(src), ...headers])}.o"
  let part = "#{obj}.#{cli_sys.getpid()}"
  let argv = runtime_cc(t)
    ++ t.cflags_compile
    ++ [OWNER_OPT, ...defs]
    ++ ["-I", t.inc_c, "-I", t.inc, "-c", src, "-o", part]
  if not made {
    ""
  } else if cli_gc.refresh(obj) {
    obj
  } else if cli_budget.run(argv, cli_proc.Spawn { ...cli_proc.inherit(), err: "/dev/null" }) == 0
    and (file_rename(part, obj) |> is_ok()) {
    obj
  } else {
    let _ = file_delete(part)
    ""
  }
}

#[doc("The lines of a file as words — the object list kaic2 prints, one path per line.")]
pub fn listed(file: String) : [String] / File = cli_proc.words(cli_fs.read_or_empty(file))

#[doc("The nonce of a marker stream (`//KAIDELIM:<nonce>` on line 1), or empty for plain output.")]
pub fn nonce(text: String) : String {
  let first = list.head(string.split(text, "\n")) ?? ""
  string.drop_prefix(first, "//KAIDELIM:") ?? ""
}

# One `//KAIFILE:<nonce>::<name>` section: its lines, each newline-terminated; none, no file.
fn write_section(dir: String, piece: String, last: Bool) : Unit / File =
  match string.index_of(piece, "\n") {
    None -> ()
    Some(i) -> {
      let body = string_slice(piece, i + 1, string_length(piece) - i - 1)
      let text = if last and string.ends_with(body, "\n") { body } else { body ++ "\n" }
      if body != "" or (not last) {
        let _ = write_file("#{dir}/#{string_slice(piece, 0, i)}", text)
      }
    }
  }

#[doc("Carve a marker stream into its files under `dir`: each `//KAIFILE:<nonce>::<name>` line opens the next file.")]
pub fn split_stream(text: String, n: String, dir: String) : Unit / File {
  let pieces = list.drop(string.split(text, "\n//KAIFILE:#{n}::"), 1)
  let last = list.length(pieces) - 1
  list.enumerate(pieces) |> foreach(p => write_section(dir, p.snd, p.fst == last))
}
