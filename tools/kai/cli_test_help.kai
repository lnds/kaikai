#[doc("Help texts of the dev-loop verbs: `kai test`, `kai bench`, `kai check`, `kai typecheck`.")]

#[doc("The text `kai test --help` prints.")]
pub fn test_text() : String =
  string.join(
    [
      "usage: kai test [options] [<spec>|./...]",
      "",
      "Compile a kaikai source with --test enabled and run the test binary.",
      "<spec> follows the same rules as `kai build` (a .kai file, '.', a",
      "'./<sub>' sub-package, or omitted for the cwd package). The special",
      "spec './...' walks the cwd subtree and runs `kai test` for every",
      "directory that carries its own kai.toml — exit code is the OR of",
      "every sub-run, so CI fails the moment any package's tests do.",
      "",
      "The compiler emits a main that runs every 'test \"...\" { ... }' block",
      "defined in the entry point and reports the result. In package mode",
      "(a kai.toml governs the spec), every '*_test.kai' file the package",
      "owns also runs as its own test binary, whether or not anything",
      "imports it, and so does every '*.kai' file under a sibling 'tests/'",
      "directory. The aggregate exit code is the OR of every run. A file",
      "declaring test blocks that the package build cannot see raises a",
      "warning naming it, as does a package with no test blocks at all.",
      "",
      "Tests defined inside the auto-loaded core stdlib modules are dropped",
      "at load time (issue #318) so the count reflects only the user's tests.",
      "",
      "Options:",
      "  -h, --help                Show this help.",
      "  --json                    Report results as NDJSON on stdout: one",
      "                            {\"type\":\"test\",...} record per block, then a",
      "                            {\"type\":\"summary\",...}. Everything else the",
      "                            run writes goes to stderr.",
      "  --only <id>               Run only the named block. Repeatable. <id> is",
      "                            '<file>:<test name>', exactly as --json emits",
      "                            it. The exit code covers the selected set.",
      "  --include-prelude-tests   Also run test blocks defined inside the",
      "                            auto-loaded core stdlib modules (legacy).",
      "",
      "Examples:",
      "  kai test                                   # cwd package (+ tests/)",
      "  kai test ./...                             # every package under cwd",
      "  kai test stage2/tests/test_lex.kai",
      "  kai test demos/poker/poker.kai",
      "  kai test --json .",
      "  kai test --only 'tests/planner_test.kai:orders cheap sites first'",
      "  kai test --include-prelude-tests demos/poker/poker.kai"
    ],
    "\n"
  )

#[doc("The text `kai bench --help` prints.")]
pub fn bench_text() : String =
  string.join(
    [
      "usage: kai bench [--iters N] [<spec>]",
      "",
      "Compile a kaikai source with --bench enabled and run the bench binary.",
      "<spec> follows the same rules as `kai build` (a .kai file, '.', a",
      "'./<sub>' sub-package, or omitted for the cwd package). In package",
      "mode every '*_test.kai' file the package owns also runs, whether or",
      "not anything imports it — the same discovery `kai test` does. A file",
      "declaring bench blocks the build cannot see raises a warning naming",
      "it, as does a package with no bench blocks at all.",
      "",
      "The compiler emits a main that runs every 'bench \"...\" { ... }' block",
      "under clock_gettime(CLOCK_MONOTONIC). For each block the runner does",
      "KAI_BENCH_WARMUP untimed iterations followed by KAI_BENCH_ITERS timed",
      "iterations, then prints:",
      "",
      "  <name>: <N> iter / median <X> ns / MAD <Y> ns / mean <Z> ns / range [<lo>, <hi>]",
      "",
      "Iteration count precedence: --iters CLI flag > KAI_BENCH_ITERS env var",
      "> compiled-in default (1000). Warmup is controlled by KAI_BENCH_WARMUP",
      "(default 50).",
      "",
      "Options:",
      "  --iters N    Run N timed iterations per block (overrides",
      "               KAI_BENCH_ITERS for this invocation).",
      "  -h, --help   Show this help.",
      "",
      "Examples:",
      "  kai bench examples/stdlib/bench_basic.kai",
      "  kai bench --iters 5000 examples/stdlib/bench_basic.kai",
      "  KAI_BENCH_WARMUP=100 kai bench examples/stdlib/bench_basic.kai"
    ],
    "\n"
  )

#[doc("The text `kai check --help` prints.")]
pub fn check_text() : String =
  string.join(
    [
      "usage: kai check [--backend=c|native] [<spec>]",
      "",
      "Compile a kaikai source with --prop-check enabled and run the",
      "property-check binary. <spec> follows the same rules as `kai build`",
      "(a .kai file, '.', a './<sub>' sub-package, or omitted for the cwd",
      "package). In package mode every '*_test.kai' file the package owns",
      "also runs, whether or not anything imports it — the same discovery",
      "`kai test` does. A file declaring check blocks the build cannot see",
      "raises a warning naming it, as does a package with no check blocks",
      "at all.",
      "",
      "The compiler emits a main that runs every",
      "'check \"...\" [with p: T, ...] { body }' block KAI_CHECK_ITERS times",
      "(default 100), generating fresh random values for the with-clause",
      "params on each iteration via the runtime arbitrary[T] helpers.",
      "",
      "Per-block output:",
      "  <desc>: 100 iter, OK",
      "  <desc>: counterexample at iter <N>: p=<v>, q=<v>, ...",
      "",
      "Followed by a 'P/T checks passed' summary; exit 1 if any block",
      "recorded a counterexample.",
      "",
      "check v1 (issue #44): supported with-clause types are Int, Bool,",
      "Char, String, and lists of those primitives. Other types raise a",
      "panic at runtime. Shrinking is deferred to v1.x; protocol-based",
      "generators (impl Arbitrary for T) defer to v2 post-protocol",
      "maturity.",
      "",
      "Options:",
      "  --backend=c|native  Backend (default: native, as for build/run/test).",
      "  -h, --help          Show this help.",
      "",
      "Examples:",
      "  kai check examples/stdlib/check_basic.kai"
    ],
    "\n"
  )

#[doc("The text `kai typecheck --help` prints.")]
pub fn typecheck_text() : String =
  string.join(
    [
      "usage: kai typecheck [<spec>] [<report-flag>]",
      "",
      "Typecheck only — the fastest \"does this compile?\" answer. Runs the",
      "full compiler front-end (lex, parse, resolve, HM + effect-row",
      "inference, kind/unit machinery, protocol-dispatch validation) and",
      "stops: no monomorphisation, no codegen, no link, no binary. Exit 0",
      "on a well-typed program; on any front-end error, the exit code and",
      "diagnostics are identical to what 'kai build' would report.",
      "",
      "Scope (honest limits): errors that only surface in later phases are",
      "NOT covered — monomorphisation-time errors (e.g. a protocol bound",
      "violated at a concrete instantiation) and backend subset gaps. A",
      "typecheck-clean program can still fail a full build there.",
      "",
      "Imports are resolved and sibling modules typechecked the same way a",
      "build's front-end does, with the same module search paths.",
      "",
      "<spec> is a .kai file or a package ('.' / './<sub>'). A package with",
      "an entry point is checked once from that entry; a package without one",
      "— a library — is checked module by module.",
      "",
      "Report flags (mutually exclusive; same mounts as 'kai build'):",
      "  --diags-json         structured diagnostics as JSON",
      "  --holes / --holes-json / --holes-scope / --holes-json-scope",
      "                       typed-hole reports",
      "  --effects-json       per-fn effects + handlers as JSON",
      "  --effect-holes-json  typed effect-hole resolutions as JSON",
      "",
      "Options:",
      "  -h, --help   Show this help.",
      "",
      "Examples:",
      "  kai typecheck main.kai",
      "  kai typecheck .",
      "  kai typecheck main.kai --diags-json"
    ],
    "\n"
  )
