#[doc("Content keys for the build caches: SHA-256 over text and file bytes, fed in order.")]

import cli_file_digest
import cli_sys

#[doc("One piece of a cache key: literal text, or the bytes of a file (skipped when unreadable, as `cat` would).")]
pub type Part = Text(String) | Bytes(String)

fn feed(h: cli_sys.Sha, p: Part) : Unit / Ffi =
  match p {
    Text(s) -> cli_sys.sha_str(h, s)
    Bytes(f) -> {
      let _ = cli_sys.sha_file(h, f)
    }
  }

#[doc("SHA-256 of the concatenated parts, as lowercase hex.")]
pub fn digest(parts: [Part]) : String / Ffi {
  let h = cli_sys.sha_new()
  parts |> foreach(p => feed(h, p))
  cli_sys.sha_hex(h)
}

#[doc("The lines of `xs`, each ended by a newline — `printf '%s\\n' ...`.")]
pub fn lines(xs: [String]) : Part = Text(string.join(xs |> list.map(x => x ++ "\n"), ""))

#[doc("A part standing for `file` by its content digest, kept in `dir` while the file's state is unchanged; read it before any digest begins.")]
pub fn kept(dir: String, file: String) : Part / File + Ffi {
  let d = list.head(cli_file_digest.of(dir, [file])) ?? ""
  Text("#{file} #{d}\n")
}
