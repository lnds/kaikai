#[doc("Filesystem helpers for the kai CLI: logical paths as a shell resolves them, mkdir -p, copies, scratch dirs.")]

import os.env
import path
import cli_sys

# `cd -L` semantics: `.` and empty segments drop, `..` pops lexically.
fn normalize(p: String) : String {
  let kept = string.split(p, "/")
    |> list.foldl([], (acc, seg) => {
      if seg == "" or seg == "." {
        acc
      } else if seg == ".." {
        match acc {
          [] -> []
          [_, ...rest] -> rest
        }
      } else {
        [seg, ...acc]
      }
    })
  "/" ++ string.join(list.reverse(kept), "/")
}

#[doc("Absolute logical form of `p` against the shell's working directory, `..` resolved lexically.")]
pub fn absolute(p: String) : String / Ffi =
  if path.is_absolute(p) { normalize(p) } else { normalize("#{cli_sys.cwd()}/#{p}") }

#[doc("`$(cd \"$(dirname p)\" && pwd)`: the logical absolute directory holding `p`, if it exists.")]
pub fn dir_of(p: String) : Option[String] / Ffi {
  let d = absolute(dirname(p))
  if cli_sys.is_dir(d) { Some(d) } else { None }
}

#[doc("`dirname` as the shell utility prints it: `.` for a bare name.")]
pub fn dirname(p: String) : String {
  let d = path.dirname(p)
  if d == "" { "." } else { d }
}

#[doc("The last component of `p`.")]
pub fn basename(p: String) : String = path.basename(p)

#[doc("`mkdir -p`: create `p` and any missing parents; true when it is a directory afterwards.")]
pub fn mkdir_p(p: String) : Bool / File + Ffi =
  if cli_sys.is_dir(p) {
    true
  } else {
    let parent = path.dirname(p)
    let _ = if parent != "" and parent != p { mkdir_p(parent) } else { true }
    let _ = dir_create_dir(p)
    cli_sys.is_dir(p)
  }

#[doc("Copy a file's bytes; false on failure.")]
pub fn copy(from: String, to: String) : Bool / File =
  match read_file(from) {
    Ok(s) -> match write_file(to, s) {
      Ok(_) -> true
      Err(_) -> false
    }
    Err(_) -> false
  }

#[doc("The file's contents, or empty when it cannot be read.")]
pub fn read_or_empty(p: String) : String / File =
  match read_file(p) {
    Ok(s) -> s
    Err(_) -> ""
  }

#[doc("A fresh private scratch directory under `$TMPDIR` (else /tmp), as `mktemp -d` makes; empty on failure.")]
pub fn scratch_dir() : String / Env + Ffi {
  let base = match env.get("TMPDIR") {
    Some(t) if t != "" -> t
    _ -> "/tmp"
  }
  let trimmed =
    if string.ends_with(base, "/") { string_slice(base, 0, string_length(base) - 1) } else { base }
  cli_sys.mkdtemp("#{trimmed}/tmp.XXXXXXXXXX")
}
