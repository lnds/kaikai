#[doc("Failures: a message already reported on stderr, carried up as the exit status.")]

#[doc("Report `kai: error: <msg>` on stderr and fail with status 2.")]
pub fn die[a](msg: String) : Result[a, Int] / Stderr {
  Stderr.eprint("kai: error: #{msg}")
  Err(2)
}

#[doc("Report `kai: error: <msg>` on stderr and fail with `code`.")]
pub fn fail[a](msg: String, code: Int) : Result[a, Int] / Stderr {
  Stderr.eprint("kai: error: #{msg}")
  Err(code)
}
