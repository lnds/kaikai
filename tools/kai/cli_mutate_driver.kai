#[doc("""
What `kai mutate` offers an external driver: the site catalogue as NDJSON and one mutant's source.

Both are read-only: nothing is built, no oracle runs, no file is written.
""")]

import cli_compile
import cli_fs
import cli_proc
import cli_sys
import cli_toolchain

#[doc("A compiler run whose output is data: an RC trace must not leak into it, and its stderr goes to `err`.")]
pub fn gen_spawn(out: String, err: String) : Spawn =
  cli_proc.Spawn { ...cli_proc.inherit(), out: out, err: err, unset: ["KAI_TRACE_RC"] }

#[doc("The compiler, with module `f`'s own directory and the stdlib on its search path.")]
pub fn kaic2(t: Toolchain, f: String) : [String] / Ffi =
  [t.layout.kaic2, "--path", cli_fs.dir_of(f).unwrap_or("."), "--path", t.layout.stdlib]

#[doc("One mutation site as `kaic2 --mutate-list` prints it.")]
pub type Site = { id: String, op: String, line: String, col: String, desc: String }

# `while IFS=<tab> read -r …`: an unterminated last line is never read.
fn site_lines(text: String) : [Site] =
  list.take(string.split(text, "\n"), list.length(string.split(text, "\n")) - 1)
    | (l => match cli_proc.read_fields(l, '\t', 5) {
      [id, op, line, col, desc] -> Site { id, op, line, col, desc }
      _ -> Site { id: "", op: "", line: "", col: "", desc: "" }
    })

#[doc("The mutation sites of module `f`, in catalogue order; `None` when it does not parse.")]
pub fn sites(t: Toolchain, f: String, tmp: String) : Option[[Site]] / File + Ffi {
  let out = "#{tmp}/sites"
  if cli_proc.run(kaic2(t, f) ++ ["--mutate-list", f], gen_spawn(out, "/dev/null")) != 0 {
    None
  } else {
    Some(site_lines(cli_fs.read_or_empty(out)))
  }
}

# The compiler prints a JSON array with one record per line; string escapes keep newlines out of a record.
fn records(array: String) : [String] {
  let body = string.drop_prefix(string.trim(array), "[").unwrap_or("")
  let inner = string.drop_suffix(body, "]").unwrap_or("")
  if string.trim(inner) == "" { [] } else { string.split(inner, ",\n ") }
}

#[doc("The site records of module `f`, one JSON object each, in catalogue order.")]
pub fn site_records(t: Toolchain, f: String, tmp: String) : [String] / File + Ffi {
  let out = "#{tmp}/sites.json"
  if cli_proc.run(kaic2(t, f) ++ ["--mutate-list-json", f], gen_spawn(out, "/dev/null")) != 0 {
    []
  } else {
    records(cli_fs.read_or_empty(out))
  }
}

#[doc("`kai mutate --apply <id> --module <f>`: the source of `f` with site `id` spliced in, on stdout; nonzero when the site does not exist.")]
pub fn apply(t: Toolchain, f: String, id: String) : Result[Int, Int] / Stderr + Ffi =
  if cli_sys.is_file(f) {
    Ok(cli_proc.run(kaic2(t, f) ++ ["--mutate-apply", id, f], gen_spawn("", "")))
  } else {
    cli_compile.not_found(f, "mutate")
  }
