#[doc("Byte-exact file plumbing and the wall clock, bound from the C shim `cli_io.c`.")]

#[doc("`cat > path`: all of stdin into a fresh file; false on failure.")]
extern "C"("kaicli_stdin_to") pub fn stdin_to(path: String) : Bool / Ffi

#[doc("Copy a binary's exact bytes and permission bits; false on failure.")]
extern "C"("kaicli_copy_exec") pub fn copy_exec(from: String, to: String) : Bool / Ffi

#[doc("Send this process's stderr to a fresh `path`; the handle `stderr_restore` takes, or -1.")]
extern "C"("kaicli_stderr_to") pub fn stderr_to(path: String) : Int / Ffi

#[doc("Put back the stderr a `stderr_to` replaced.")]
extern "C"("kaicli_stderr_restore") pub fn stderr_restore(saved: Int) : Unit / Ffi

#[doc("Sleep `ms` milliseconds.")]
extern "C"("kaicli_msleep") pub fn msleep(ms: Int) : Unit / Ffi

#[doc("Seconds since the epoch, as `date +%s`.")]
extern "C"("kaicli_epoch") pub fn epoch() : Int / Ffi

#[doc("The local time of day as `HH:MM:SS`.")]
extern "C"("kaicli_local_hms") pub fn local_hms() : String / Ffi
