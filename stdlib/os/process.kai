#[doc("""
Surface helpers on top of the `Process` effect. Module path:
`import os.process`; qualified calls land as `process.start(...)`.

Standard fds inherit from the parent by default; the piped variants
(`start_piped`, `pipe_to`, `pipe_from`, `pipe_errs`) attach pipes to
some of them instead. Only `pipe_errs` captures stderr.

POSIX only.
""")]

#[doc("""
Start a child process via `fork(2)` + `execvp(3)`. Returns an
opaque `Child` carrying the OS pid; standard fds inherit from the
parent (use `start_piped` / `pipe_to` / `pipe_from` to attach
pipes instead). Panics if the fork or exec fails.
""")]
pub fn start(cmd: String, args: [String]) : Child / Process =
  Process.start(cmd, args)

#[doc("""
Start a child with BOTH stdin and stdout attached to pipes, for
driving a filter (`sort`, `wc`, ...). stderr inherits. Write with
`write_stdin`, then `close_stdin` so the child sees EOF, then drain
with `read_all` / `read_stdout` before `wait`.
""")]
pub fn start_piped(cmd: String, args: [String]) : Result[Child, String] / Process =
  Process.start_piped(cmd, args, true, true, false)

#[doc("""
Start a child with only its stdin piped; stdout and stderr inherit.
The pager shape: `pipe_to("less", ["-r"])`, `write_stdin` the
content, then `wait` (which closes the pipe so the pager sees EOF).
A pager quit early by the user surfaces as `Err` on the next
`write_stdin`, never as a fatal SIGPIPE.
""")]
pub fn pipe_to(cmd: String, args: [String]) : Result[Child, String] / Process =
  Process.start_piped(cmd, args, true, false, false)

#[doc("""
Start a child with only its stdout piped; stdin and stderr inherit.
The capture shape: `pipe_from("git", ["rev-parse", "HEAD"])`, then
`read_all` for the output, then `wait` for the exit status.
""")]
pub fn pipe_from(cmd: String, args: [String]) : Result[Child, String] / Process =
  Process.start_piped(cmd, args, false, true, false)

#[doc("""
Start a child with stdout AND stderr piped; stdin inherits. The
supervisor shape: read the child's output with `read_stdout` and its
diagnostics with `read_stderr`, then `wait` for the exit status.
A child that fills one pipe while the parent blocks draining the
other deadlocks; when either stream may exceed the OS pipe capacity,
drain each from its own fiber.
""")]
pub fn pipe_errs(cmd: String, args: [String]) : Result[Child, String] / Process =
  Process.start_piped(cmd, args, false, true, true)

#[doc("""
Write every byte of `data` to a piped child's stdin. `Err` when the
child's stdin is not piped, or with the OS error when the write
fails — a reader that already exited yields `Err("Broken pipe")`,
never a fatal SIGPIPE. A full pipe parks the fiber until the pipe
accepts more, so a child that stops reading its stdin blocks only the
writing fiber; the rest of the program keeps running.
""")]
pub fn write_stdin(c: Child, data: String) : Result[Unit, String] / Process =
  Process.write_stdin(c, data)

#[doc("""
Close a piped child's stdin so it sees EOF. Idempotent — closing an
already-closed end is `Ok(())`. Required before draining a filter
that reads stdin to exhaustion (`sort`, `wc`, ...).
""")]
pub fn close_stdin(c: Child) : Result[Unit, String] / Process =
  Process.close_stdin(c)

#[doc("""
Read one chunk (up to 64 KiB) from a piped child's stdout. `Ok("")`
is EOF. Loop until EOF — or use `read_all` — to drain output larger
than the OS pipe capacity without deadlocking the child. While the
pipe is empty the calling fiber parks; other fibers keep running.
""")]
pub fn read_stdout(c: Child) : Result[String, String] / Process =
  Process.read_stdout(c)

#[doc("""
Read one chunk (up to 64 KiB) from a child's stderr, piped by
`pipe_errs`. `Ok("")` is EOF; `Err` when stderr is not piped. Parks
the calling fiber while the pipe is empty, like `read_stdout`.
""")]
pub fn read_stderr(c: Child) : Result[String, String] / Process =
  Process.read_stderr(c)

#[doc("""
Drain a piped child's stdout to EOF and return everything read.
Safe for output of any size: it reads chunk by chunk, so the child
is never blocked on a full pipe. For a filter fed via `write_stdin`,
call `close_stdin` first or the child never reaches EOF.
""")]
pub fn read_all(c: Child) : Result[String, String] / Process =
  read_all_go(c, "")

fn read_all_go(c: Child, acc: String) : Result[String, String] / Process =
  match Process.read_stdout(c) {
    Err(e) -> Err(e)
    Ok(s)  ->
      if string_length(s) == 0 { Ok(acc) }
      else { read_all_go(c, string_concat(acc, s)) }
  }

#[doc("""
Wait for a child process to terminate and return its exit status
as an `Exit` variant (`Exited(code)` or `Signaled(signo)`).
Returns `Err(strerror)` if `waitpid` itself fails (e.g. ECHILD if
the child was already reaped). Parks the calling fiber, not the OS thread.

For a piped child this is `pclose`-shaped: any pipe ends still open
are closed first, so a pager or filter fed via `write_stdin` sees
EOF without an explicit `close_stdin`. Drain piped output BEFORE
waiting — a child still writing when its reader disappears
takes a SIGPIPE instead of blocking forever.
""")]
pub fn wait(c: Child) : Result[Exit, String] / Process =
  Process.wait(c)

#[doc("""
Send a POSIX signal to a child process via `kill(pid, sig)`,
lifting the libc errno to `Err(strerror)` on failure (e.g. ESRCH
if the child was already reaped, EPERM on permission denial).

`sig` is the raw POSIX signo (e.g. 9 for SIGKILL, 15 for SIGTERM,
2 for SIGINT); see `signal(7)` for the full list.
""")]
pub fn kill(c: Child, sig: Int) : Result[Unit, String] / Process =
  Process.kill(c, sig)

#[doc("""
Terminate the current process with the given exit code via libc
`_exit(code)` (NOT `exit(3)`), so stdio buffers are NOT flushed;
`print` everything you want printed before calling this.

The op never resumes (return type `Nothing`) and Cancel handlers
do NOT run — this is a hard kill of the current process.
""")]
pub fn exit(code: Int) : Nothing / Process =
  Process.exit(code)
