#[doc("""
Regex pattern syntax: the AST, the recursive-descent parser and the AST dump.
""")]


# ---- Types ----

#[doc("""
A single character range inside a class. `lo == hi` represents a
single-character match. The class itself stores a list of ranges
plus a `negated` flag.
""")]
pub type CharRange = CR(Char, Char)

#[doc("""
Anchor positions: start-of-input or end-of-input. No multiline
mode, so ^/$ are absolute.
""")]
pub type Anchor = AnchorStart | AnchorEnd

#[doc("""
Pattern AST. The parser produces this; it lowers to an NFA.

RxClass(ranges, negated): matches any char in ranges (or, when
negated, any char NOT in ranges). Built-in classes (\\d \\w \\s)
desugar to the corresponding RxClass at parse time. `.` desugars
to a "any char except newline" class.

RxConcat([]) is the empty sequence (matches empty string).
RxAlt is at least 2 alternatives by construction; single-arm
alternation is collapsed to the inner expression.

RxRepeat(inner, min, max_opt): min..max bounded repeat. {n}
becomes RxRepeat(inner, n, Some(n)); {n,} becomes RxRepeat(inner,
n, None); {n,m} becomes RxRepeat(inner, n, Some(m)). The simpler
RxStar/RxPlus/RxOpt forms are kept for clarity in the NFA pass.

RxGroup(id, inner): capture group with 1-based id. Non-capturing
groups (?:...) parse to inner directly without an RxGroup wrap.
""")]
pub type RxAst
  = RxChar(Char)
  | RxAny
  | RxClass([CharRange], Bool)
  | RxAnchor(Anchor)
  | RxConcat([RxAst])
  | RxAlt([RxAst])
  | RxStar(RxAst)
  | RxPlus(RxAst)
  | RxOpt(RxAst)
  | RxRepeat(RxAst, Int, Option[Int])
  | RxGroup(Int, RxAst)

#[doc("""
Parser carries the input string, current position, and a
monotonically-increasing capture-group counter. The counter is
advanced when a `(...)` (non-`?:`) is opened, so groups are
numbered in source order.
""")]
pub type RxParseState = { input: String, pos: Int, n: Int, group_id: Int }

#[doc("""
Parser result wrapper. `r = None` means the parse failed and the
`err_msg` field describes what went wrong; `r = Some(ast)` is the
successful parse paired with the consumed state.
""")]
pub type RxParseError = { msg: String, pos: Int }
#[doc("A regex-parser result: the consumed parse state plus either the parsed AST (`r`) or a parse error (`err`).")]
pub type PRx = { st: RxParseState, r: Option[RxAst], err: Option[RxParseError] }

fn rx_ok(st: RxParseState, ast: RxAst) : PRx =
  PRx { st: st, r: Some(ast), err: None }

fn rx_err(st: RxParseState, msg: String) : PRx =
  PRx { st: st, r: None, err: Some(RxParseError { msg: msg, pos: st.pos }) }

# ---- Parse-state helpers ----

fn rx_state_init(input: String) : RxParseState =
  RxParseState { input: input, pos: 0, n: string_length(input), group_id: 0 }

fn rx_at_end(st: RxParseState) : Bool = st.pos >= st.n

# Positions are byte offsets that always sit on a codepoint boundary.
fn rx_cp_at(s: String, i: Int) : Char = int_to_char(string_cp_at(s, i))

# Byte offset following the codepoint at `i`, which must be inside the input.
fn rx_next_pos(s: String, i: Int) : Int = i + string_cp_len(s, i)

fn rx_peek(st: RxParseState) : Option[Char] =
  if rx_at_end(st) { None } else { Some(rx_cp_at(st.input, st.pos)) }

fn rx_peek_at(st: RxParseState, off: Int) : Option[Char] =
  if st.pos + off >= st.n { None } else { Some(rx_cp_at(st.input, st.pos + off)) }

fn rx_advance(st: RxParseState) : RxParseState =
  RxParseState { input: st.input, pos: rx_next_pos(st.input, st.pos), n: st.n, group_id: st.group_id }

fn rx_advance_n(st: RxParseState, k: Int) : RxParseState =
  RxParseState { input: st.input, pos: st.pos + k, n: st.n, group_id: st.group_id }

fn rx_bump_group(st: RxParseState) : RxParseState =
  RxParseState { input: st.input, pos: st.pos, n: st.n, group_id: st.group_id + 1 }

# ---- Public entry point ----

#[doc("""
Parse a pattern string into an RxAst. Returns Result so callers
can handle malformed patterns explicitly. The error form carries
a message and the byte offset at which parsing failed.
""")]
pub fn parse_pattern(pattern: String) : Result[RxAst, RxParseError] = {
  let st0 = rx_state_init(pattern)
  let r = rx_parse_alt(st0)
  match r.r {
    None -> match r.err {
      Some(e) -> Err(e)
      None    -> Err(RxParseError { msg: "regex parse failed", pos: r.st.pos })
    }
    Some(ast) ->
      if not rx_at_end(r.st) {
        Err(RxParseError { msg: "trailing characters after regex", pos: r.st.pos })
      } else if ast_cost(ast) > rx_max_cost() {
        Err(RxParseError { msg: "pattern too large: more than 1000000 nodes after repeats", pos: string_length(pattern) })
      } else { Ok(ast) }
  }
}

fn rx_max_cost() : Int = 1000000

type RxCostItem = { node: RxAst, mult: Int }

#[doc("""
Counts the nodes `a` expands to, each node once per copy its enclosing
repeats make; patterns above 1000000 are rejected by `parse_pattern`.
Counting stops once past that limit, so the result is exact only below it.
""")]
fn ast_cost(a: RxAst) : Int = rx_cost_loop([RxCostItem { node: a, mult: 1 }], 0)

# One loop over an explicit work list: nesting costs list cells, not frames.
fn rx_cost_loop(work: [RxCostItem], total: Int) : Int = match work {
  []            -> total
  [it, ...rest] ->
    if total > rx_max_cost() { total }
    else { rx_cost_loop(rx_cost_push(rx_kids(it.node), rx_kid_mult(it.node, it.mult), rest), total + it.mult) }
}

fn rx_kids(a: RxAst) : [RxAst] = match a {
  RxChar(_)       -> []
  RxAny           -> []
  RxClass(_, _)   -> []
  RxAnchor(_)     -> []
  RxConcat(xs)    -> xs
  RxAlt(xs)       -> xs
  RxStar(x)       -> [x]
  RxPlus(x)       -> [x]
  RxOpt(x)        -> [x]
  RxGroup(_, x)   -> [x]
  RxRepeat(x, _, _) -> [x]
}

# A repeat compiles `hi` copies of its child, or `lo + 1` when unbounded.
fn rx_kid_mult(a: RxAst, mult: Int) : Int = match a {
  RxRepeat(_, lo, hi) -> rx_scale(mult, match hi { Some(h) -> h None -> lo + 1 })
  _                   -> mult
}

fn rx_cost_push(xs: [RxAst], mult: Int, rest: [RxCostItem]) : [RxCostItem] = match xs {
  []           -> rest
  [x, ...more] -> rx_cost_push(more, mult, [RxCostItem { node: x, mult: mult }, ...rest])
}

# `mult * copies`, saturating just above the limit so it cannot overflow.
fn rx_scale(mult: Int, copies: Int) : Int =
  if mult * copies > rx_max_cost() { rx_max_cost() + 1 } else { mult * copies }

# ---- Top-down recursive descent ----
#
# Grammar (informal):
#   alt    ::= concat ("|" concat)*
#   concat ::= atom*
#   atom   ::= primary quantifier?
#   primary ::= group | class | "." | anchor | escape | char
#   group  ::= "(" "?:"? alt ")"
#   class  ::= "[" "^"? class_item* "]"
#
# Each rx_parse_* takes an RxParseState and returns a PRx. The
# parser is greedy; quantifiers attach to the most recent atom only
# (no quantifier-on-empty).

# Alternatives and concatenation items of the level being parsed are
# newest first; an open group parks its enclosing level in an `RxFrame`.
type RxFrame = { gid: Int, noncap: Bool, alts: [RxAst], items: [RxAst] }

fn rx_parse_alt(st: RxParseState) : PRx = rx_parse_loop(st, [], [], [])

# One tail-recursive driver for alt, concat and group: nesting depth costs
# list cells, not stack frames. A parse error returns as found, unwrapped.
fn rx_parse_loop(st: RxParseState, stack: [RxFrame], alts: [RxAst], items: [RxAst]) : PRx =
  match rx_peek(st) {
    Some('|') -> rx_parse_loop(rx_advance(st), stack, [rx_concat_of(items), ...alts], [])
    Some(')') -> match stack {
      []             -> rx_ok(st, rx_alt_of([rx_concat_of(items), ...alts]))
      [fr, ...outer] -> {
        let inner = rx_alt_of([rx_concat_of(items), ...alts])
        let grouped = if fr.noncap { inner } else { RxGroup(fr.gid, inner) }
        let r = rx_apply_quantifier(rx_advance(st), grouped)
        match r.r {
          None     -> r
          Some(at) -> rx_parse_loop(r.st, outer, fr.alts, [at, ...fr.items])
        }
      }
    }
    None -> match stack {
      [] -> rx_ok(st, rx_alt_of([rx_concat_of(items), ...alts]))
      _  -> rx_err(st, "expected `)` to close group")
    }
    Some('(') -> {
      let st1 = rx_advance(st)
      let noncap = match rx_peek(st1) {
        Some('?') -> match rx_peek_at(st1, 1) { Some(':') -> true _ -> false }
        _         -> false
      }
      let st2 = if noncap { rx_advance_n(st1, 2) } else { rx_bump_group(st1) }
      rx_parse_loop(st2, [RxFrame { gid: st2.group_id, noncap: noncap, alts: alts, items: items }, ...stack], [], [])
    }
    Some(_) -> {
      let r = rx_parse_atom(st)
      match r.r {
        None     -> r
        Some(at) -> rx_parse_loop(r.st, stack, alts, [at, ...items])
      }
    }
  }

# `alts` is never empty: a level always contributes its concatenation.
fn rx_alt_of(alts: [RxAst]) : RxAst = match alts {
  [a] -> a
  _   -> RxAlt(list_reverse(alts))
}

# No items is the empty concatenation, which the general arm builds too.
fn rx_concat_of(items: [RxAst]) : RxAst = match items {
  [x] -> x
  _   -> RxConcat(list_reverse(items))
}

# An atom is a primary expression optionally followed by a single
# quantifier. Quantifiers do not stack (`a**` is rejected) — that
# is the user's job to write `(a*)*` if they want the meaning.
fn rx_parse_atom(st: RxParseState) : PRx = {
  let r = rx_parse_primary(st)
  match r.r {
    None -> r
    Some(p) -> rx_apply_quantifier(r.st, p)
  }
}

fn rx_apply_quantifier(st: RxParseState, p: RxAst) : PRx = match rx_peek(st) {
  Some('*') -> rx_ok(rx_advance(st), RxStar(p))
  Some('+') -> rx_ok(rx_advance(st), RxPlus(p))
  Some('?') -> rx_ok(rx_advance(st), RxOpt(p))
  Some('{') -> rx_parse_repeat(rx_advance(st), p)
  _         -> rx_ok(st, p)
}

# Largest count a `{n}`, `{n,}` or `{n,m}` quantifier accepts.
fn rx_max_repeat() : Int = 1000

fn rx_repeat_too_big(st: RxParseState) : PRx =
  rx_err(st, "repeat count exceeds 1000")

# {n}, {n,}, {n,m}. Reject malformed forms (`{}`, `{,5}`,
# `{2,1}`) and counts above the limit.
fn rx_parse_repeat(st: RxParseState, p: RxAst) : PRx = {
  let rn = rx_parse_int(st)
  match rn.r_int {
    None     -> rx_err(rn.st, "expected count after `{`")
    Some(lo) -> if lo > rx_max_repeat() { rx_repeat_too_big(rn.st) } else { rx_parse_repeat_tail(rn.st, p, lo) }
  }
}

# After `{lo`: `}`, or `,` and an optional upper bound.
fn rx_parse_repeat_tail(st: RxParseState, p: RxAst, lo: Int) : PRx = match rx_peek(st) {
  None      -> rx_err(st, "unterminated `{`")
  Some('}') -> rx_ok(rx_advance(st), RxRepeat(p, lo, Some(lo)))
  Some(',') -> rx_parse_repeat_upper(rx_advance(st), p, lo)
  Some(_)   -> rx_err(st, "expected `,` or `}` after count")
}

fn rx_parse_repeat_upper(st: RxParseState, p: RxAst, lo: Int) : PRx = match rx_peek(st) {
  None      -> rx_err(st, "unterminated `{`")
  Some('}') -> rx_ok(rx_advance(st), RxRepeat(p, lo, None))
  Some(_)   -> {
    let rh = rx_parse_int(st)
    match rh.r_int {
      None     -> rx_err(rh.st, "expected count or `}` after `,`")
      Some(hi) ->
        if hi > rx_max_repeat() { rx_repeat_too_big(rh.st) }
        else if hi < lo { rx_err(rh.st, "repeat count {n,m}: m < n") }
        else { match rx_peek(rh.st) {
          Some('}') -> rx_ok(rx_advance(rh.st), RxRepeat(p, lo, Some(hi)))
          _         -> rx_err(rh.st, "expected `}` to close repeat")
        } }
    }
  }
}

# Parse a base-10 integer of one or more digits. Returns the
# advanced state and the parsed value (or None if no digits).
# The value saturates just above the repeat limit, so long digit runs
# cannot overflow.
type RxIntParse = { st: RxParseState, r_int: Option[Int] }

fn rx_parse_int(st: RxParseState) : RxIntParse =
  rx_parse_int_loop(st, 0, false)

fn rx_parse_int_loop(st: RxParseState, acc: Int, any: Bool) : RxIntParse = match rx_peek(st) {
  Some(c) ->
    if char.is_digit(c) {
      let d = char_to_int(c) - char_to_int('0')
      rx_parse_int_loop(rx_advance(st), if acc > rx_max_repeat() { acc } else { acc * 10 + d }, true)
    } else { rx_int_done(st, acc, any) }
  None -> rx_int_done(st, acc, any)
}

fn rx_int_done(st: RxParseState, acc: Int, any: Bool) : RxIntParse =
  RxIntParse { st: st, r_int: if any { Some(acc) } else { None } }

# A primary expression is one of: group, class, anchor, ".", escape,
# or a literal char.
fn rx_parse_primary(st: RxParseState) : PRx = match rx_peek(st) {
  None       -> rx_err(st, "unexpected end of pattern")
  Some('[')  -> rx_parse_class(rx_advance(st))
  Some('.')  -> rx_ok(rx_advance(st), RxAny)
  Some('^')  -> rx_ok(rx_advance(st), RxAnchor(AnchorStart))
  Some('$')  -> rx_ok(rx_advance(st), RxAnchor(AnchorEnd))
  Some('\\') -> rx_parse_escape(rx_advance(st))
  Some(c)    ->
    if rx_is_meta(c) { rx_err(st, "unexpected metacharacter in primary position") }
    else { rx_ok(rx_advance(st), RxChar(c)) }
}

# `)` and `|` never reach here: the parse loop consumes them first.
fn rx_is_meta(c: Char) : Bool = match c {
  '*' -> true
  '+' -> true
  '?' -> true
  '{' -> true
  '}' -> true
  ']' -> true
  _   -> false
}

# `[` already consumed. Parse optional `^` then class items until
# closing `]`.
fn rx_parse_class(st: RxParseState) : PRx = {
  let neg = match rx_peek(st) { Some('^') -> true _ -> false }
  let st1 = if neg { rx_advance(st) } else { st }
  rx_parse_class_loop(st1, [], neg)
}

fn rx_parse_class_loop(st: RxParseState, acc: [CharRange], neg: Bool) : PRx = match rx_peek(st) {
  None      -> rx_err(st, "unterminated character class")
  Some(']') ->
    if list.is_empty(acc) { rx_err(st, "empty character class") }
    else { rx_ok(rx_advance(st), RxClass(list_reverse(acc), neg)) }
  Some(_)   -> {
    let r = rx_parse_class_atom(st)
    match r.r_range {
      None      -> rx_err(r.st, "malformed character class")
      Some(rng) -> rx_parse_class_loop(r.st, [rng, ...acc], neg)
    }
  }
}

type RxRangeParse = { st: RxParseState, r_range: Option[CharRange] }

type RxCharParse = { st: RxParseState, r_char: Option[Char] }

# One class member char: a literal or an escape. `None` at end of input
# or after a dangling backslash.
fn rx_class_char(st: RxParseState) : RxCharParse = match rx_peek(st) {
  None       -> RxCharParse { st: st, r_char: None }
  Some('\\') -> rx_parse_escape_char(rx_advance(st))
  Some(c)    -> RxCharParse { st: rx_advance(st), r_char: Some(c) }
}

# A class atom: a single char, or a range `a-z` (a trailing `-` before
# `]` is a literal).
fn rx_parse_class_atom(st: RxParseState) : RxRangeParse = {
  let first = rx_class_char(st)
  match first.r_char {
    None     -> RxRangeParse { st: first.st, r_range: None }
    Some(lo) -> rx_class_range_tail(first.st, lo)
  }
}

fn rx_class_range_tail(st: RxParseState, lo: Char) : RxRangeParse = match rx_peek(st) {
  Some('-') -> match rx_peek_at(st, 1) {
    Some(']') -> RxRangeParse { st: st, r_range: Some(CR(lo, lo)) }
    Some(_)   -> rx_class_range_hi(rx_advance(st), lo)
    None      -> RxRangeParse { st: st, r_range: None }
  }
  _ -> RxRangeParse { st: st, r_range: Some(CR(lo, lo)) }
}

fn rx_class_range_hi(st: RxParseState, lo: Char) : RxRangeParse = {
  let last = rx_class_char(st)
  match last.r_char {
    None     -> RxRangeParse { st: last.st, r_range: None }
    Some(hi) ->
      if char_to_int(hi) < char_to_int(lo) { RxRangeParse { st: last.st, r_range: None } }
      else { RxRangeParse { st: last.st, r_range: Some(CR(lo, hi)) } }
  }
}

# `\d` `\w` `\s` desugar to classes and `\D` `\W` `\S` negate them;
# `\n` `\t` `\r` are control chars; any other escaped char is itself.
fn rx_escape_ast(c: Char) : RxAst = match c {
  'd' -> RxClass([CR('0', '9')], false)
  'D' -> RxClass([CR('0', '9')], true)
  'w' -> RxClass(rx_word_ranges(), false)
  'W' -> RxClass(rx_word_ranges(), true)
  's' -> RxClass(rx_space_ranges(), false)
  'S' -> RxClass(rx_space_ranges(), true)
  _   -> RxChar(rx_escape_char(c))
}

fn rx_escape_char(c: Char) : Char = match c {
  'n' -> '\n'
  't' -> '\t'
  'r' -> '\r'
  _   -> c
}

# `\` already consumed.
fn rx_parse_escape(st: RxParseState) : PRx = match rx_peek(st) {
  None    -> rx_err(st, "trailing backslash")
  Some(c) -> rx_ok(rx_advance(st), rx_escape_ast(c))
}

# Word characters per Perl/POSIX ASCII: [A-Za-z0-9_].
fn rx_word_ranges() : [CharRange] =
  [CR('A', 'Z'), CR('a', 'z'), CR('0', '9'), CR('_', '_')]

# Whitespace: space, tab, newline, carriage-return.
fn rx_space_ranges() : [CharRange] =
  [CR(' ', ' '), CR('\t', '\t'), CR('\n', '\n'), CR('\r', '\r')]

# Inside a class an escape resolves to a single char: `[\d]` is the
# literal `d`; digits are written `[0-9]`.
fn rx_parse_escape_char(st: RxParseState) : RxCharParse = match rx_peek(st) {
  None    -> RxCharParse { st: st, r_char: None }
  Some(c) -> RxCharParse { st: rx_advance(st), r_char: Some(rx_escape_char(c)) }
}

# ---- AST inspection helpers (debug / dump) ----
#
# Render an RxAst as a compact tree string for fixtures and
# debugging. Char values use `Show[Char]` for natural ASCII output
# (`Ch(a)` instead of `Ch(97)`).

#[doc("Renders a regex AST as a compact tree string (the debug/fixture format).")]
pub fn ast_show(a: RxAst) : String =
  string_concat_all(list_reverse(rx_show_loop([ShowAst(a)], [])))

# Pending output of `ast_show`: a node still to render, or final text.
type RxShow = ShowAst(RxAst) | ShowText(String)

# Work-stack driver: nodes expand in place, so nesting costs list cells,
# not stack frames. `out` holds the emitted pieces newest first.
fn rx_show_loop(work: [RxShow], out: [String]) : [String] = match work {
  []              -> out
  [item, ...rest] -> match item {
    ShowText(t) -> rx_show_loop(rest, [t, ...out])
    ShowAst(a)  -> match a {
      RxChar(c) -> rx_show_loop(rest, ["Ch(#{c})", ...out])
      RxAny     -> rx_show_loop(rest, ["Any", ...out])
      RxClass(rs, neg) ->
        rx_show_loop(rest, [string_concat_all(["Cls(", if neg { "^" } else { "" }, ranges_show(rs), ")"]), ...out])
      RxAnchor(an) -> rx_show_loop(rest, [match an { AnchorStart -> "Start" AnchorEnd -> "End" }, ...out])
      RxConcat(xs) -> rx_show_loop([ShowText("Cat("), ...rx_show_list(list_reverse(xs), [ShowText(")"), ...rest], false)], out)
      RxAlt(xs)    -> rx_show_loop([ShowText("Alt("), ...rx_show_list(list_reverse(xs), [ShowText(")"), ...rest], false)], out)
      RxStar(x)    -> rx_show_loop([ShowText("Star("), ShowAst(x), ShowText(")"), ...rest], out)
      RxPlus(x)    -> rx_show_loop([ShowText("Plus("), ShowAst(x), ShowText(")"), ...rest], out)
      RxOpt(x)     -> rx_show_loop([ShowText("Opt("), ShowAst(x), ShowText(")"), ...rest], out)
      RxRepeat(x, lo, hi_opt) -> {
        let hi_s = match hi_opt {
          Some(h) -> int_to_string(h)
          None    -> "*"
        }
        rx_show_loop([ShowText("Rep("), ShowAst(x), ShowText(string_concat_all([",", int_to_string(lo), ",", hi_s, ")"])), ...rest], out)
      }
      RxGroup(id, x) ->
        rx_show_loop([ShowText(string_concat_all(["Grp(", int_to_string(id), ","])), ShowAst(x), ShowText(")"), ...rest], out)
    }
  }
}

# `rev` is the children last first; each is consed before `acc`, with a comma
# between neighbours.
fn rx_show_list(rev: [RxAst], acc: [RxShow], sep: Bool) : [RxShow] = match rev {
  []           -> acc
  [x, ...more] -> rx_show_list(more, [ShowAst(x), ...if sep { [ShowText(","), ...acc] } else { acc }], true)
}

#[doc("Renders class ranges as a comma-separated list, single chars bare and spans as `lo-hi`.")]
pub fn ranges_show(rs: [CharRange]) : String = string_concat_all(list_reverse(rx_ranges_parts(rs, [])))

fn rx_ranges_parts(rs: [CharRange], acc: [String]) : [String] = match rs {
  []           -> acc
  [r]          -> [rx_range_show(r), ...acc]
  [r, ...rest] -> rx_ranges_parts(rest, [",", rx_range_show(r), ...acc])
}

fn rx_range_show(r: CharRange) : String = match r {
  CR(lo, hi) ->
    if char_to_int(lo) == char_to_int(hi) { "#{lo}" }
    else { "#{lo}-#{hi}" }
}

