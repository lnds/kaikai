#[doc("The page's `localStorage` as the `Storage` effect installed by `web.run`.")]

extern "js"("kai.storage_has") fn js_has(key: String) : Bool / Js

extern "js"("localStorage.getItem") fn js_get(key: String) : String / Js

extern "js"("localStorage.setItem") fn js_set(key: String, value: String) : Unit / Js

extern "js"("localStorage.removeItem") fn js_remove(key: String) : Unit / Js

#[doc("Persistent string storage keyed by string.")]
pub effect Storage {
  get(key: String) : Option[String]
  set(key: String, value: String) : Unit
  remove(key: String) : Unit
}

fn lookup(key: String) : Option[String] / Js = if js_has(key) { Some(js_get(key)) } else { None }

#[doc("Runs `body` with `Storage` answered by `localStorage`.")]
pub fn with_storage[R, e](body: () -> R / Storage + e) : R / Js + e {
  handle {
    body()
  } with Storage {
    get(key, resume) -> resume(lookup(key))
    set(key, value, resume) -> {
      js_set(key, value)
      resume(())
    }
    remove(key, resume) -> {
      js_remove(key)
      resume(())
    }
    return(x) -> x
  }
}
