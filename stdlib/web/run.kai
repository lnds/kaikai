#[doc("The installer for the browser stdlib: `web.run { … }` answers `Dom`, `Timer`, `Fetch` and `Storage` with the page.")]

import web.dom
import web.fetch
import web.storage
import web.timer

#[doc("Runs `body` with `Dom`, `Timer`, `Fetch` and `Storage` answered by the page. The row needs `Js`, so a program using these effects builds only for the browser target.")]
pub fn run[r, e](
  body: () -> r / dom.Dom + timer.Timer + fetch.Fetch + storage.Storage + e
) : r / Js + Ffi + Clock + e =
  dom.with_dom(() => timer.with_timer(() => fetch.with_fetch(() => storage.with_storage(body))))
