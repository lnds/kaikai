#[doc("Parking on the page: the one call that suspends a fiber until the host has something for it.")]

extern "C" fn kai_web_wait_event() : Unit / Ffi

#[doc("Parks the calling fiber until the page posts an event or settles a request, then returns; callers re-check what they wait for.")]
pub fn park() : Unit / Ffi = kai_web_wait_event()
