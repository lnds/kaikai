#[doc("""
The page's document as the `Dom` effect installed by `web.run`: querying and building nodes,
a 2D canvas, and events delivered as values. Nothing in JavaScript calls back into the
program: `listen` asks the host to queue events of a kind, and `next_event` parks the
calling fiber until one arrives.
""")]

import web.wait

extern "js" pub opaque Node

extern "js" pub opaque Ctx2d

extern "js" pub opaque Image

extern "js"("document.querySelector") fn js_query(selector: String) : Node / Js

extern "js"("kai.is_null") fn js_is_null(n: Node) : Bool / Js

extern "js"("document.createElement") fn js_create(tag: String) : Node / Js

extern "js"(".appendChild") fn js_append(parent: Node, child: Node) : Unit / Js

extern "js"(".remove") fn js_remove(n: Node) : Unit / Js

extern "js"(".textContent=") fn js_set_text(n: Node, s: String) : Unit / Js

extern "js"(".setAttribute") fn js_set_attr(n: Node, name: String, value: String) : Unit / Js

extern "js"("kai.set_style") fn js_set_style(n: Node, name: String, value: String) : Unit / Js

extern "js"("kai.listen") fn js_listen(n: Node, kind: String) : Unit / Js

extern "js"("kai.next_event") fn js_next() : Bool / Js

extern "js"("kai.event_kind") fn js_kind() : String / Js

extern "js"("kai.event_key") fn js_key() : String / Js

extern "js"("kai.event_x") fn js_x() : I32 / Js

extern "js"("kai.event_y") fn js_y() : I32 / Js

extern "js"("kai.event_target") fn js_target() : Node / Js

extern "js"(".getContext") fn js_context(n: Node, kind: String) : Ctx2d / Js

extern "js"(".fillStyle=") fn js_fill_style(c: Ctx2d, css: String) : Unit / Js

extern "js"(".strokeStyle=") fn js_stroke_style(c: Ctx2d, css: String) : Unit / Js

extern "js"(".font=") fn js_font(c: Ctx2d, css: String) : Unit / Js

extern "js"(".fillRect") fn js_fill_rect(c: Ctx2d, x: I32, y: I32, w: I32, h: I32) : Unit / Js

extern "js"(".clearRect") fn js_clear_rect(c: Ctx2d, x: I32, y: I32, w: I32, h: I32) : Unit / Js

extern "js"(".beginPath") fn js_begin_path(c: Ctx2d) : Unit / Js

extern "js"(".arc") fn js_arc(c: Ctx2d, x: Real, y: Real, r: Real, from: Real, to: Real) : Unit / Js

extern "js"(".fill") fn js_fill(c: Ctx2d) : Unit / Js

extern "js"(".stroke") fn js_stroke(c: Ctx2d) : Unit / Js

extern "js"(".fillText") fn js_fill_text(c: Ctx2d, s: String, x: I32, y: I32) : Unit / Js

extern "js"("kai.image_new") fn js_image_new(w: I32, h: I32) : Image / Js

extern "js"("kai.image_set") fn js_image_set(img: Image, i: I32, rgba: Int) : Unit / Js

extern "js"("kai.image_get") fn js_image_get(img: Image, i: I32) : Int / Js

extern "js"("kai.raw_put_pixels") fn js_put_pixels(
  c: Ctx2d,
  rgba: String,
  w: I32,
  h: I32,
  x: I32,
  y: I32
) : Unit / Js

extern "js"(".putImageData") fn js_put_image(c: Ctx2d, img: Image, x: I32, y: I32) : Unit / Js

extern "js"(".getImageData") fn js_get_image(c: Ctx2d, x: I32, y: I32, w: I32, h: I32) : Image / Js

#[doc("A delivered event: its `kind` (`click`, `keydown`, …, or a `Timer.every` kind), the `key` of a keyboard event, the pointer position `x`, `y` within the target, and the `target` node (a placeholder for ticks).")]
pub type Event = { kind: String, key: String, x: Int, y: Int, target: Node }

#[doc("The document and the 2D canvas. Colours are CSS strings; `pixel` values are `0xRRGGBBAA`; `put_pixels` draws a whole `w * h * 4` RGBA buffer with one copy to the page.")]
pub effect Dom {
  query(selector: String) : Option[Node]
  create(tag: String) : Node
  append(parent: Node, child: Node) : Unit
  remove(n: Node) : Unit
  set_text(n: Node, text: String) : Unit
  set_attr(n: Node, name: String, value: String) : Unit
  set_style(n: Node, name: String, value: String) : Unit
  listen(n: Node, kind: String) : Unit
  next_event() : Event
  poll_event() : Option[Event]
  context_2d(canvas: Node) : Ctx2d
  set_fill_style(c: Ctx2d, css: String) : Unit
  set_stroke_style(c: Ctx2d, css: String) : Unit
  set_font(c: Ctx2d, css: String) : Unit
  fill_rect(c: Ctx2d, x: Int, y: Int, w: Int, h: Int) : Unit
  clear_rect(c: Ctx2d, x: Int, y: Int, w: Int, h: Int) : Unit
  begin_path(c: Ctx2d) : Unit
  arc(c: Ctx2d, x: Real, y: Real, r: Real, from: Real, to: Real) : Unit
  fill(c: Ctx2d) : Unit
  stroke(c: Ctx2d) : Unit
  fill_text(c: Ctx2d, text: String, x: Int, y: Int) : Unit
  new_image(w: Int, h: Int) : Image
  set_pixel(img: Image, index: Int, pixel: Int) : Unit
  put_image_data(c: Ctx2d, img: Image, x: Int, y: Int) : Unit
  put_pixels(c: Ctx2d, rgba: Array[Byte], w: Int, h: Int, x: Int, y: Int) : Unit
  get_image_data(c: Ctx2d, x: Int, y: Int, w: Int, h: Int) : Image
  get_pixel(img: Image, index: Int) : Int
}

fn found(n: Node) : Option[Node] / Js = if js_is_null(n) { None } else { Some(n) }

fn current() : Event / Js =
  Event { kind: js_kind(), key: js_key(), x: js_x(), y: js_y(), target: js_target() }

fn poll() : Option[Event] / Js = if js_next() { Some(current()) } else { None }

fn await_event() : Event / Js + Ffi =
  match poll() {
    Some(e) -> e
    None -> {
      wait.park()
      await_event()
    }
  }

#[doc("Runs `body` with `Dom` answered by the page's document.")]
pub fn with_dom[R, e](body: () -> R / Dom + e) : R / Js + Ffi + e {
  handle {
    body()
  } with Dom {
    query(selector, resume) -> resume(found(js_query(selector)))
    create(tag, resume) -> resume(js_create(tag))
    append(parent, child, resume) -> {
      js_append(parent, child)
      resume(())
    }
    remove(n, resume) -> {
      js_remove(n)
      resume(())
    }
    set_text(n, text, resume) -> {
      js_set_text(n, text)
      resume(())
    }
    set_attr(n, name, value, resume) -> {
      js_set_attr(n, name, value)
      resume(())
    }
    set_style(n, name, value, resume) -> {
      js_set_style(n, name, value)
      resume(())
    }
    listen(n, kind, resume) -> {
      js_listen(n, kind)
      resume(())
    }
    next_event(resume) -> resume(await_event())
    poll_event(resume) -> resume(poll())
    context_2d(canvas, resume) -> resume(js_context(canvas, "2d"))
    set_fill_style(c, css, resume) -> {
      js_fill_style(c, css)
      resume(())
    }
    set_stroke_style(c, css, resume) -> {
      js_stroke_style(c, css)
      resume(())
    }
    set_font(c, css, resume) -> {
      js_font(c, css)
      resume(())
    }
    fill_rect(c, x, y, w, h, resume) -> {
      js_fill_rect(c, x, y, w, h)
      resume(())
    }
    clear_rect(c, x, y, w, h, resume) -> {
      js_clear_rect(c, x, y, w, h)
      resume(())
    }
    begin_path(c, resume) -> {
      js_begin_path(c)
      resume(())
    }
    arc(c, x, y, r, from, to, resume) -> {
      js_arc(c, x, y, r, from, to)
      resume(())
    }
    fill(c, resume) -> {
      js_fill(c)
      resume(())
    }
    stroke(c, resume) -> {
      js_stroke(c)
      resume(())
    }
    fill_text(c, text, x, y, resume) -> {
      js_fill_text(c, text, x, y)
      resume(())
    }
    new_image(w, h, resume) -> resume(js_image_new(w, h))
    set_pixel(img, index, pixel, resume) -> {
      js_image_set(img, index, pixel)
      resume(())
    }
    put_image_data(c, img, x, y, resume) -> {
      js_put_image(c, img, x, y)
      resume(())
    }
    put_pixels(c, rgba, w, h, x, y, resume) -> {
      js_put_pixels(c, bytes_get_string(rgba, 0, w * h * 4), w, h, x, y)
      resume(())
    }
    get_image_data(c, x, y, w, h, resume) -> resume(js_get_image(c, x, y, w, h))
    get_pixel(img, index, resume) -> resume(js_image_get(img, index))
    return(x) -> x
  }
}
