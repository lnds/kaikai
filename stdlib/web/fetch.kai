#[doc("HTTP requests from the page as the `Fetch` effect installed by `web.run`; a request parks the calling fiber while the page's `fetch` runs.")]

import encoding.json
import encoding.json_bind
import web.wait

extern "js"("kai.fetch_start") fn js_start(url: String) : I32 / Js

extern "js"("kai.fetch_done") fn js_done(id: I32) : Bool / Js

extern "js"("kai.fetch_ok") fn js_ok(id: I32) : Bool / Js

extern "js"("kai.fetch_status") fn js_status(id: I32) : I32 / Js

extern "js"("kai.fetch_body") fn js_body(id: I32) : String / Js

#[doc("The settled answer of a request: its HTTP `status` (0 when the request failed before one), whether it is 2xx, and the body, or the failure message.")]
pub type Response = { status: Int, ok: Bool, body: String }

#[doc("Issue a GET and wait for the answer.")]
pub effect Fetch {
  get(url: String) : Response
}

fn settle(id: Int) : Response / Js + Ffi =
  if js_done(id) {
    Response { status: js_status(id), ok: js_ok(id), body: js_body(id) }
  } else {
    wait.park()
    settle(id)
  }

#[doc("Runs `body` with `Fetch` answered by the page's `fetch`.")]
pub fn with_fetch[R, e](body: () -> R / Fetch + e) : R / Js + Ffi + e {
  handle {
    body()
  } with Fetch {
    get(url, resume) -> resume(settle(js_start(url)))
    return(x) -> x
  }
}

#[doc("The body of `url` as text; `Err` carries the status or the failure message for a non-2xx answer.")]
pub fn get_text(url: String) : Result[String, String] / Fetch {
  let r = Fetch.get(url)
  if r.ok { Ok(r.body) } else { Err("#{r.status}: #{r.body}") }
}

#[doc("The body of `url` parsed as JSON.")]
pub fn get_json(url: String) : Result[json_bind.JsonValue, String] / Fetch =
  match get_text(url) {
    Ok(text) -> match json.json_decode(text) {
      Some(v) -> Ok(v)
      None -> Err("invalid JSON from #{url}")
    }
    Err(e) -> Err(e)
  }

#[doc("The HTTP status of a GET of `url`, 0 when the request failed before an answer.")]
pub fn status(url: String) : Int / Fetch = Fetch.get(url).status
