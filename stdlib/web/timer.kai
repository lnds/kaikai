#[doc("Time on the page: the clock, sleeping, animation frames and periodic ticks, as the `Timer` effect installed by `web.run`.")]

import time
import web.wait

extern "js"("Date.now") fn js_now() : Int / Js

extern "js"("kai.frame_request") fn js_frame_request() : Unit / Js

extern "js"("kai.frame_time") fn js_frame_time() : Real / Js

extern "js"("kai.interval") fn js_interval(ms: I32, kind: String) : Unit / Js

#[doc("Time and waiting on a page. `animation_frame` resolves on the next `requestAnimationFrame` with its timestamp in milliseconds; `every` posts an event of `kind` to `Dom.next_event` each `ms` milliseconds.")]
pub effect Timer {
  now_ms() : Int
  sleep_ms(ms: Int) : Unit
  animation_frame() : Real
  every(ms: Int, kind: String) : Unit
}

fn frame_wait() : Real / Js + Ffi {
  let t = js_frame_time()
  if t >= 0.0 {
    t
  } else {
    wait.park()
    frame_wait()
  }
}

fn frame() : Real / Js + Ffi {
  js_frame_request()
  frame_wait()
}

#[doc("Runs `body` with `Timer` answered by the page: `Date.now`, the clock's sleep, `requestAnimationFrame` and `setInterval`.")]
pub fn with_timer[r, e](body: () -> r / Timer + e) : r / Js + Ffi + Clock + e {
  handle {
    body()
  } with Timer {
    now_ms(resume) -> resume(js_now())
    sleep_ms(ms, resume) -> {
      sleep(millis(ms))
      resume(())
    }
    animation_frame(resume) -> resume(frame())
    every(ms, kind, resume) -> {
      js_interval(ms, kind)
      resume(())
    }
    return(x) -> x
  }
}
