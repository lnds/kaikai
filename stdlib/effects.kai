#[doc("""
Atomic effect catalog — the builtin capabilities the runtime ships a
default handler for, declared in surface kaikai.

Auto-loaded as part of the core stdlib set, so user code names these
effects (`Stdout.print`, `File.read_file`, ...) without an import.
Each runtime-backed op bridges to its C entry through a `default { }`
clause of the form `$extern_handler("kai_default_<eff>_<op>")`.

Networking (`NetTcp` / `NetUdp` / `NetDns`) lives with its surface
helpers in `net/`; concurrency and OS-process effects live in
`effects/concurrent.kai` and `effects/os.kai`.
""")]

# ---- Console / IO leaves ----

#[doc("""
Write a line to standard output. `is_tty` reports whether the stream
is a terminal (`isatty(3)` on fd 1) — the standard gate for ANSI
colour, false under a pipe or redirection. The default handler
bridges to the runtime stdout writer.
""")]
pub effect Stdout {
  print(s: String) : Unit
  is_tty() : Bool
  default {
    print(s, resume)  -> $extern_handler("kai_default_stdout_print")
    is_tty(resume)    -> $extern_handler("kai_default_stdout_is_tty")
  }
}

#[doc("""
Write a line to standard error. `is_tty` reports whether the stream
is a terminal (`isatty(3)` on fd 2). The default handler bridges to
the runtime stderr writer.
""")]
pub effect Stderr {
  eprint(s: String) : Unit
  is_tty() : Bool
  default {
    eprint(s, resume) -> $extern_handler("kai_default_stderr_eprint")
    is_tty(resume)    -> $extern_handler("kai_default_stderr_is_tty")
  }
}

#[doc("""
Read from standard input. `read_line` returns `None` at EOF;
`read_bytes(n)` reads up to `n` raw bytes (a short read is the
end-of-stream signal). `is_tty` reports whether the stream is a
terminal (`isatty(3)` on fd 0). The default handler bridges to the
runtime stdin reader.
""")]
pub effect Stdin {
  read_line() : Option[String]
  read_bytes(n: Int) : String
  is_tty() : Bool
  default {
    read_line(resume)     -> $extern_handler("kai_default_stdin_read_line")
    read_bytes(n, resume) -> $extern_handler("kai_default_stdin_read_bytes")
    is_tty(resume)        -> $extern_handler("kai_default_stdin_is_tty")
  }
}

#[doc("""
The FFI capability tag carried by every `extern "C"` signature. It
declares no ops — the type-level name exists so public signatures can
mention `/ Ffi` honestly. Codegen routes FFI calls around the effect
dispatcher entirely.
""")]
pub effect Ffi {}

#[doc("""
The JavaScript capability tag carried by every `extern "js"` signature. It
declares no ops and has no default handler: a program whose `main` reaches it
builds only for a target with a JavaScript host.
""")]
pub effect Js {}

# ---- Process environment ----

#[doc("""
Read and mutate the process environment, plus read the argv list.
Writes (`set_var` / `unset_var`) return `Result[Unit, String]`
(Ok-first). The default handler bridges each op to its runtime
entry.
""")]
pub effect Env {
  args() : [String]
  get(name: String) : Option[String]
  set_var(name: String, value: String) : Result[Unit, String]
  unset_var(name: String) : Result[Unit, String]
  vars() : [Pair[String, String]]
  default {
    args(resume)                -> $extern_handler("kai_default_env_args")
    get(name, resume)           -> $extern_handler("kai_default_env_get")
    set_var(name, value, resume)-> $extern_handler("kai_default_env_set_var")
    unset_var(name, resume)     -> $extern_handler("kai_default_env_unset_var")
    vars(resume)                -> $extern_handler("kai_default_env_vars")
  }
}

# ---- File IO ----

# The `Perm` habitants of the file API. The capability is what the
# code declared at open time, not the OS's runtime permission on the
# file — runtime failures still ride each op's `Result`.
pub perm read
pub perm write

#[doc("""
Opaque file handle the chunked `File` ops return and consume, carrying
its capability as a `Perm` habitant: `open_read` mints
`FileHandle<read>`, `open_write` mints `FileHandle<read + write>`, and
each op requires only the capability it uses, so writing through a
read-only handle is a compile-time type mismatch. The `fd` field is
the OS file descriptor; the runtime reads it by name, so the field
name is load-bearing.
""")]
pub type FileHandle = { fd: Int }

#[doc("""
Mint a `FileHandle` carrying whatever capability the context requires.
For handler implementations and test doubles — the handler is the
authority granting the capability, so the perm is chosen by the
resume's expected type, not checked here.
""")]
pub fn file_handle[p: Perm](fd: Int) : FileHandle<p> = __attach_unit(FileHandle { fd: fd })

#[doc("""
Read and write files, in bulk (`fs.file`) or in
chunks over a capability-carrying `FileHandle`. `read_chunk` returns
`Ok("")` at EOF. Errors ride `Result` (Ok-first). The default handler
bridges each op to the runtime's thread-pooled IO.
""")]
pub effect File {
  read_file(path: String) : Result[String, String]
  write_file(path: String, contents: String) : Result[Unit, String]
  open_read(path: String) : Result[FileHandle<read>, String]
  read_chunk(h: FileHandle<read>, max: Int) : Result[String, String]
  open_write(path: String) : Result[FileHandle<read + write>, String]
  write_chunk(h: FileHandle<write>, data: String) : Result[Unit, String]
  close_file(h: FileHandle) : Unit
  default {
    read_file(path, resume)       -> $extern_handler("kai_default_file_read_file")
    write_file(path, contents, resume) -> $extern_handler("kai_default_file_write_file")
    open_read(path, resume)       -> $extern_handler("kai_default_file_open_read")
    read_chunk(h, max, resume)    -> $extern_handler("kai_default_file_read_chunk")
    open_write(path, resume)      -> $extern_handler("kai_default_file_open_write")
    write_chunk(h, data, resume)  -> $extern_handler("kai_default_file_write_chunk")
    close_file(h, resume)         -> $extern_handler("kai_default_file_close_file")
  }
}

# ---- Randomness ----

#[doc("""
Non-cryptographic randomness. `int_range(lo, hi)` is uniform in
`[lo, hi)`; the default handler exits when `lo >= hi`. It seeds a PCG32
generator per thread from the OS CSPRNG. Use `SecureRandom` for
security-sensitive draws.
""")]
pub effect Random {
  int_range(lo: Int, hi: Int) : Int
  default {
    int_range(lo, hi, resume) -> $extern_handler("kai_default_random_int_range")
  }
}

#[doc("""
Cryptographically-secure randomness, deliberately separate from
`Random` so a test handler stubbing `Random` cannot weaken
security-sensitive paths. `int_range` is uniform-inclusive;
`bytes(n)` draws `n` bytes (as `[Int]` in `[0, 255]`). The default
handler bridges to the OS CSPRNG (getrandom / arc4random).
""")]
pub effect SecureRandom {
  int_range(min: Int, max: Int) : Int
  bytes(n: Int) : [Int]
  default {
    int_range(min, max, resume) -> $extern_handler("kai_default_securerandom_int_range")
    bytes(n, resume)            -> $extern_handler("kai_default_securerandom_bytes")
  }
}

# ---- Logging ----

#[doc("""
Leveled structured logging. The default handler writes each message
to stderr in `[ISO8601Z] LEVEL message` form. Install a `Log`
handler to capture or filter output.
""")]
pub effect Log {
  debug(msg: String) : Unit
  info(msg: String) : Unit
  warn(msg: String) : Unit
  error(msg: String) : Unit
  default {
    debug(msg, resume) -> $extern_handler("kai_default_log_debug")
    info(msg, resume)  -> $extern_handler("kai_default_log_info")
    warn(msg, resume)  -> $extern_handler("kai_default_log_warn")
    error(msg, resume) -> $extern_handler("kai_default_log_error")
  }
}

# ---- Mutation ----

#[doc("""
Observable mutation of `Array` cells and `Ref` references. Each op
carries its own element generic so one handler instance serves every
type. `var x = init` sugar and bare-builtin array writes route here;
the default handler wraps the runtime's array/ref primitives.

`array_set` / `array_grow` return the (mutated) `Array` to keep
`xs = array_set(xs, i, v)` chains typing — the runtime mutates in
place and hands the same array back.
""")]
pub effect Mutable {
  array_make[T](n: Int, init: T) : Array[T]
  array_length[T](a: Array[T]) : Int
  array_get[T](a: Array[T], i: Int) : T
  array_set[T](a: Array[T], i: Int, v: T) : Array[T]
  array_grow[T](a: Array[T], n: Int, init: T) : Array[T]
  ref_make[T](init: T) : Ref[T]
  ref_get[T](r: Ref[T]) : T
  ref_set[T](r: Ref[T], v: T) : Unit
  default {
    array_make(n, init, resume)    -> $extern_handler("kai_default_mutable_array_make")
    array_length(a, resume)        -> $extern_handler("kai_default_mutable_array_length")
    array_get(a, i, resume)        -> $extern_handler("kai_default_mutable_array_get")
    array_set(a, i, v, resume)     -> $extern_handler("kai_default_mutable_array_set")
    array_grow(a, n, init, resume) -> $extern_handler("kai_default_mutable_array_grow")
    ref_make(init, resume)         -> $extern_handler("kai_default_mutable_ref_make")
    ref_get(r, resume)             -> $extern_handler("kai_default_mutable_ref_get")
    ref_set(r, v, resume)          -> $extern_handler("kai_default_mutable_ref_set")
  }
}

# ---- Effect aliases ----

#[doc("The combined console capability — `Stdout + Stderr + Stdin`.")]
pub type Console = Stdout + Stderr + Stdin

#[doc("The full IO capability — `Console + Env + File`.")]
pub type Io = Console + Env + File

# ---- Runtime file primitives ----

#[doc("The absolute form of `path`.")]
extern "kai"("kai_core_abspath") pub fn abspath(path: String) : String
#[doc("The entries of the directory `path`; empty on a read error.")]
extern "kai"("kai_core_dir_list_dir") pub fn dir_list_dir(path: String) : [String] / File
#[doc("Creates the directory `path`.")]
extern "kai"("kai_core_dir_create_dir") pub fn dir_create_dir(path: String) : Result[Unit, String] / File
#[doc("Removes the empty directory `path`.")]
extern "kai"("kai_core_dir_remove_dir") pub fn dir_remove_dir(path: String) : Result[Unit, String] / File
#[doc("Every file under the directory `path`, recursively.")]
extern "kai"("kai_core_dir_walk") pub fn dir_walk(path: String) : [String] / File
#[doc("The `[size, mtime_secs, mtime_nanos, is_dir, is_file]` of `path`, following symlinks.")]
extern "kai"("kai_core_file_metadata") pub fn file_metadata(path: String) : Result[[Int], String] / File
#[doc("The process working directory.")]
extern "kai"("kai_core_dir_current_dir") pub fn dir_current_dir() : Result[String, String] / File
#[doc("`$TMPDIR` when set and non-empty, else `/tmp`.")]
extern "kai"("kai_core_dir_temp_dir") pub fn dir_temp_dir() : String / File

# ---- Runtime console, process and file primitives ----

#[doc("Writes `s` and a newline to standard output.")]
extern "kai"("kai_core_print") pub fn print(s: String) : Unit / Stdout
#[doc("Writes `s` and a newline to standard error.")]
extern "kai"("kai_core_eprint") pub fn eprint(s: String) : Unit / Stderr
#[doc("Writes `s` to standard output with no newline.")]
extern "kai"("kai_core_write_stdout") pub fn write_stdout(s: String) : Unit / Stdout
#[doc("The command-line arguments, program name excluded.")]
extern "kai"("kai_core_args") pub fn args() : [String] / Env
#[doc("The program's `argv[0]`.")]
extern "kai"("kai_core_program_name") pub fn program_name() : String
#[doc("The program's `argv[0]`, reachable where a wrapper shadows `program_name`.")]
extern "kai"("kai_core_program_name") pub fn core_program_name() : String
#[doc("The directory the compiler loaded the standard library from.")]
extern "kai"("kai_core_stdlib_path") pub fn stdlib_path() : String

# Internal spellings of the file operations; `fs.file` is the public surface.
#[doc("The contents of the file at `path`; the implementation of `fs.file.read`.")]
extern "kai"("kai_core_read_file") pub fn __file_read(path: String) : Result[String, String] / File
#[doc("Writes `contents` to the file at `path`; the implementation of `fs.file.write`.")]
extern "kai"("kai_core_write_file") pub fn __file_write(path: String, contents: String) : Result[Unit, String] / File
#[doc("Appends to the file at `path`; the implementation of `fs.file.append`.")]
extern "kai"("kai_core_file_append") pub fn __file_append(path: String, contents: String) : Result[Unit, String] / File
#[doc("True when `path` exists; the implementation of `fs.file.exists`.")]
extern "kai"("kai_core_file_exists") pub fn __file_exists(path: String) : Bool / File
#[doc("Removes the file at `path`; the implementation of `fs.file.delete`.")]
extern "kai"("kai_core_file_delete") pub fn __file_delete(path: String) : Result[Unit, String] / File
#[doc("Renames `from` to `to`; the implementation of `fs.file.rename`.")]
extern "kai"("kai_core_file_rename") pub fn __file_rename(from: String, to: String) : Result[Unit, String] / File
#[doc("The bytes of the file at `path`; the implementation of `fs.file.read_bytes`.")]
extern "kai"("kai_core_file_read_bytes") pub fn __file_read_bytes(path: String) : Result[Array[Byte], String] / File
#[doc("Writes `data` to the file at `path`; the implementation of `fs.file.write_bytes`.")]
extern "kai"("kai_core_file_write_bytes") pub fn __file_write_bytes(path: String, data: Array[Byte]) : Result[Unit, String] / File
#[doc("The next line of standard input.")]
extern "kai"("kai_core_read_line") pub fn read_line() : Result[String, String] / Stdin
#[doc("Up to `n` bytes of standard input; a short read is end of stream.")]
extern "kai"("kai_core_read_bytes") pub fn read_bytes(n: Int) : String / Stdin
