#[doc("""
Fixed-point rendering of a `Real`, the function behind the `#{x:.N}`
interpolation spec.

The exact binary value is rounded half-to-even in Int128 arithmetic, so the
result is `printf("%.*f")` for every finite magnitude below 2^127.
""")]

fn wide(n: Int) : Int128 = int_to_int128(n)

fn pow2_61() : Real = 2305843009213693952.0

# `a` is a non-negative whole Real below 2^127: its value is split into
# 32-bit pieces so every step is an exact Real or Int operation.
fn whole_of(a: Real) : Int128 = {
  let two64 = pow2_61() * 8.0
  let two32 = 4294967296.0
  let hi = real_to_int(a / two64)
  let r = a - int_to_real(hi) * two64
  let mid = real_to_int(r / two32)
  let lo = real_to_int(r - int_to_real(mid) * two32)
  wide(hi) * wide(4294967296) * wide(4294967296) + wide(mid) * wide(4294967296) + wide(lo)
}

fn pow10_wide(n: Int) : Int128 = if n <= 0 { wide(1) } else { wide(10) * pow10_wide(n - 1) }

# Decimal digits of `m / den`, `n` of them: (scaled value, remainder).
fn frac_digits(m: Int128, den: Int128, n: Int, scaled: Int128) : Pair[Int128, Int128] =
  if n == 0 { Pair { fst: scaled, snd: m } }
  else {
    let r = m * wide(10)
    frac_digits(r % den, den, n - 1, scaled * wide(10) + r / den)
  }

fn is_odd(n: Int128) : Bool = n % wide(2) == wide(1)

# Rounds the exact binary value half-to-even, as `printf("%.*f")` does.
fn fixed_digits(a: Real, d: Int) : String = {
  let ip = if a >= pow2_61() { a } else { int_to_real(real_to_int(a)) }
  let f = a - ip
  let den = wide(2305843009213693952) * wide(2305843009213693952)
  let m = whole_of(f * pow2_61() * pow2_61())
  let whole = whole_of(ip)
  let cut = frac_digits(m, den, d, wide(0))
  let twice = cut.snd * wide(2)
  let odd = if d == 0 { is_odd(whole) } else { is_odd(cut.fst) }
  let up = twice > den or (twice == den and odd)
  let scaled0 = if up { cut.fst + wide(1) } else { cut.fst }
  let carry = scaled0 >= pow10_wide(d)
  let scaled = if carry { scaled0 - pow10_wide(d) } else { scaled0 }
  let whole2 = if carry { whole + wide(1) } else { whole }
  let w = int128_to_string(whole2)
  if d == 0 { w }
  else { string_concat(w, string_concat(".", string.pad_left(int128_to_string(scaled), d, '0'))) }
}

#[doc("""
`x` rendered with exactly `digits` places after the point, rounding its
exact binary value half-to-even (`string.fixed(2.675, 2) == "2.67"`,
`string.fixed(0.125, 2) == "0.12"`), as `printf("%.*f")` does. `digits`
is clamped to `0..18`. NaN, infinities and magnitudes from 2^127 up
render as `show` does.
""")]
pub fn fixed(x: Real, digits: Int) : String =
  if real_is_nan(x) or real_is_inf(x) or x >= 170141183460469231731687303715884105728.0 or x <= 0.0 - 170141183460469231731687303715884105728.0 {
    real_to_string(x)
  } else {
    let d = if digits < 0 { 0 } else if digits > 18 { 18 } else { digits }
    let body = fixed_digits(if x < 0.0 { 0.0 - x } else { x }, d)
    if x < 0.0 { string_concat("-", body) } else { body }
  }

#[doc("Centres `s` in `width` bytes with `fill`; the extra byte of an odd gap goes on the right.")]
pub fn pad_center(s: String, width: Int, fill: Char) : String {
  let gap = width - string_length(s)
  if gap <= 0 { s }
  else { string.pad_right(string.pad_left(s, string_length(s) + gap / 2, fill), width, fill) }
}

#[doc("Left-pads `s` with `0` to at least `width` bytes, keeping a leading `-` in front (`pad_zero(\"-42\", 5) == \"-0042\"`).")]
pub fn pad_zero(s: String, width: Int) : String =
  if string.starts_with(s, "-") { string_concat("-", string.pad_left(string_slice(s, 1, string_length(s) - 1), width - 1, '0')) }
  else { string.pad_left(s, width, '0') }
