#[doc("""
Decimal digits to a magnitude in subquadratic time: runs of up to
`leaf_digits` fold nine digits per limb step, longer runs join
`hi * 10^k + lo` over the cached powers of ten.
""")]

import math.bits
import math.bigint_limbs.{mag_add, mag_muladd_limb}
import math.bigint_karatsuba.{mag_mul_fast}
import math.bigint_pow10.{chunk_base, leaf_digits, parse_split_digits, zero_mag, split_level, pow10_chain, pow10_at}

type DigitRun = { value: Int, mult: Int, next: Int, bad: Bool }

# Up to nine digits of `s` from `i`: their value, the power of ten they
# span and the index after them. Any non-digit ends the run with `bad`.
fn digit_run(s: String, i: Int, n: Int, value: Int, mult: Int) : DigitRun =
  if mult >= chunk_base() or i >= n { DigitRun { value: value, mult: mult, next: i, bad: false } }
  else {
    let d = digit_at(s, i)
    if d >= 0 and d <= 9 { digit_run(s, i + 1, n, value * 10 + d, mult * 10) }
    else { DigitRun { value: value, mult: mult, next: i, bad: true } }
  }

# The digit at `i`, or -1 when it is not a decimal digit.
fn digit_at(s: String, i: Int) : Int = match char_at(s, i) {
  Some(c) -> char_to_int(c) - char_to_int('0')
  None -> 0 - 1
}

# Folds the digits `[i, n)` of `s` into `acc`; the flag is false when a
# non-digit stopped the fold.
fn fold_digits(s: String, i: Int, n: Int, acc: Array[Int]) : Pair[Array[Int], Bool] = {
  let run = digit_run(s, i, n, 0, 1)
  let acc1 = mag_muladd_limb(acc, run.mult, run.value)
  if run.bad or run.next >= n { Pair { fst: acc1, snd: not run.bad } }
  else { fold_digits(s, run.next, n, acc1) }
}

fn join_halves(high: Pair[Array[Int], Bool], low: Pair[Array[Int], Bool], p: Array[Int]) : Pair[Array[Int], Bool] =
  if not high.snd { high }
  else if not low.snd { low }
  else { Pair { fst: mag_add(mag_mul_fast(high.fst, p), low.fst), snd: true } }

fn digits_value(s: String, lo: Int, hi: Int, powers: [Array[Int]]) : Pair[Array[Int], Bool] =
  if hi - lo <= leaf_digits() { fold_digits(s, lo, hi, zero_mag()) }
  else { digits_split(s, lo, hi, powers, split_level(hi - lo)) }

fn digits_split(s: String, lo: Int, hi: Int, powers: [Array[Int]], j: Int) : Pair[Array[Int], Bool] = {
  let cut = hi - leaf_digits() * bit_shl(1, j)
  join_halves(digits_value(s, lo, cut, powers), digits_value(s, cut, hi, powers), pow10_at(powers, j))
}

#[doc("The magnitude of the decimal digits `[lo, hi)` of `s` and whether every character was a digit.")]
pub fn mag_from_digits(s: String, lo: Int, hi: Int) : Pair[Array[Int], Bool] =
  if hi - lo <= parse_split_digits() { fold_digits(s, lo, hi, zero_mag()) }
  else { digits_value(s, lo, hi, pow10_chain(split_level(hi - lo) + 1)) }
