#[doc("""
Karatsuba multiplication of magnitudes: schoolbook below a limb
threshold, three half-size products above it. Unbalanced operands split
the longer one only.
""")]

import math.bigint_limbs.{sig_len, mag_add, mag_sub, mag_mul}
import math.bigint_shift.{mag_slice, mag_add_shifted}

fn karatsuba_threshold() : Int = 24

#[doc("Product of two magnitudes, subquadratic above the Karatsuba threshold. The result may carry high zero limbs; the caller canonicalizes.")]
pub fn mag_mul_fast(a: Array[Int], b: Array[Int]) : Array[Int] = {
  let na = sig_len(a)
  let nb = sig_len(b)
  if na < nb { mul_ordered(b, a, nb, na) } else { mul_ordered(a, b, na, nb) }
}

fn mul_ordered(a: Array[Int], b: Array[Int], na: Int, nb: Int) : Array[Int] =
  if nb < karatsuba_threshold() { mag_mul(a, b) }
  else {
    let h = (na + 1) / 2
    if nb <= h { mul_split_long(a, b, na, h) }
    else { mul_split_both(a, b, na, nb, h) }
  }

fn mul_split_long(a: Array[Int], b: Array[Int], na: Int, h: Int) : Array[Int] =
  mag_add_shifted(
    mag_mul_fast(mag_slice(a, 0, h), b),
    mag_mul_fast(mag_slice(a, h, na), b),
    h)

fn mul_split_both(a: Array[Int], b: Array[Int], na: Int, nb: Int, h: Int) : Array[Int] = {
  let a0 = mag_slice(a, 0, h)
  let a1 = mag_slice(a, h, na)
  let b0 = mag_slice(b, 0, h)
  let b1 = mag_slice(b, h, nb)
  let z0 = mag_mul_fast(a0, b0)
  let z2 = mag_mul_fast(a1, b1)
  let zm = mag_mul_fast(mag_add(a0, a1), mag_add(b0, b1))
  let z1 = mag_sub(mag_sub(zm, z0), z2)
  mag_add_shifted(mag_add_shifted(z0, z1, h), z2, 2 * h)
}
