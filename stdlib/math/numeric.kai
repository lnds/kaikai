#[doc("""
Single-dispatch numeric protocol. Every op dispatches on its first
argument, so `abs(x)` routes to `Numeric for Int` or `Numeric for Real`
by that argument's type. `zero` / `one` are the additive /
multiplicative identities (resolved through the expected return type at
the call site). Domain-specific, hence it lives under math/ alongside
its impls rather than in protocols.kai.

The ring's operations are the operator protocols': a ring is
`Numeric + Add + Mul` — `zero` with `add`, `one` with `mul` — which is
what `list.sum` / `list.product` ask of their element. The typer does NOT
verify the ring axioms (associativity, distributivity); they are the
implementor's contract, like `Ord` being a total order by convention.
""")]

# ---- Numeric protocol --------------------------------------------

pub protocol Numeric {
  zero() : Self
  one() : Self
  abs(x: Self) : Self
  sign(x: Self) : Int
  pow_int(base: Self, exp: Int) : Self
  clamp(x: Self, lo: Self, hi: Self) : Self
}

# ---- Int impl ----------------------------------------------------

# Tail-recursive accumulator for Int.pow_int. Internal.
fn int_pow_int_loop(base: Int, e: Int, acc: Int) : Int {
  if e == 0 { acc }
  else { int_pow_int_loop(base, e - 1, acc * base) }
}

impl Numeric for Int {
  fn zero() : Int = 0
  fn one() : Int = 1

  fn abs(x: Int) : Int =
    if x < 0 { 0 - x } else { x }

  fn sign(x: Int) : Int =
    if x < 0 { 0 - 1 } else { if x > 0 { 1 } else { 0 } }

  fn pow_int(base: Int, exp: Int) : Int =
    if exp < 0 { 0 } else { int_pow_int_loop(base, exp, 1) }

  fn clamp(x: Int, lo: Int, hi: Int) : Int =
    if lo > hi { x }
    else { if x < lo { lo } else { if x > hi { hi } else { x } } }
}

# ---- Real impl ---------------------------------------------------

# Tail-recursive accumulator for Real.pow_int. Internal.
fn real_pow_int_loop(base: Real, e: Int, acc: Real) : Real {
  if e == 0 { acc }
  else { real_pow_int_loop(base, e - 1, acc * base) }
}

impl Numeric for Real {
  fn zero() : Real = 0.0
  fn one() : Real = 1.0

  fn abs(x: Real) : Real =
    if x < 0.0 { 0.0 - x } else { x }

  fn sign(x: Real) : Int =
    if x < 0.0 { 0 - 1 } else { if x > 0.0 { 1 } else { 0 } }

  fn pow_int(base: Real, exp: Int) : Real =
    if exp < 0 { 0.0 } else { real_pow_int_loop(base, exp, 1.0) }

  fn clamp(x: Real, lo: Real, hi: Real) : Real =
    if lo > hi { x }
    else { if x < lo { lo } else { if x > hi { hi } else { x } } }
}

