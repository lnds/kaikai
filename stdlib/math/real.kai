#[doc("""
Real (floating-point) helpers not covered by the Numeric protocol:
the constants `real_pi` / `real_e` / `real_tau`, the two-arg `min` /
`max`, and rounding (`trunc`, `floor`, `ceil`, `round`,
`round_half_even`, `round_to`), all generic over `Real<u>`.
(`abs`, `sign`, `pow_int`, `clamp` live in `Numeric for Real`.)

Rounding is built on the truncating `real_to_int` runtime builtin
and is bounded-precision: an Int64 holds numbers up to ~9.22e18, so
values past that point round to 0.

libm bindings (`real_sqrt`, `real_sin`, `real_pow`, …) are global
core primitives, not wrapped here. Domain handling is
pass-through: `real_sqrt(0.0 - 1.0)` is NaN, `real_log(0.0)` is
-Inf; use `real_is_nan` / `real_is_inf` to inspect.
""")]

# ---- Constants ---------------------------------------------------

#[doc("π to 18 significant digits (≥ IEEE 754 double precision).")]
pub const real_pi : Real = 3.141592653589793238

#[doc("Euler's number e to 18 significant digits.")]
pub const real_e : Real = 2.718281828459045235

#[doc("""
τ = 2π to 18 significant digits. The "circle constant"; some find
it more natural than π for angle work (e.g. `real_tau / 4` for a
quarter turn).
""")]
pub const real_tau : Real = 6.283185307179586477

# ---- min / max ---------------------------------------------------
# These coexist with `list.min(xs)` / `int.min(a, b)`. Qualify call
# sites (`real.min(a, b)`) where the bare name is ambiguous.

#[doc("Returns the smaller of two reals.")]
pub fn min(a: Real, b: Real) : Real = if a < b { a } else { b }

#[doc("Returns the larger of two reals.")]
pub fn max(a: Real, b: Real) : Real = if a > b { a } else { b }

# ---- Rounding ----------------------------------------------------
# Each export erases the unit, rounds the bare Real, and re-tags it;
# both intrinsics are identities at runtime.

fn trunc_real(x: Real) : Real = int_to_real(real_to_int(x))

fn floor_real(x: Real) : Real = {
  let t = trunc_real(x)
  if x < 0.0 and x != t { t - 1.0 } else { t }
}

fn ceil_real(x: Real) : Real = {
  let t = trunc_real(x)
  if x > 0.0 and x != t { t + 1.0 } else { t }
}

fn round_real(x: Real) : Real =
  if x >= 0.0 { trunc_real(x + 0.5) }
  else { trunc_real(x - 0.5) }

# `f == ±0.5` is exact: halves are binary fractions.
fn round_half_even_real(x: Real) : Real = {
  let t = trunc_real(x)
  let f = x - t
  if f > 0.5         { t + 1.0 }
  else if f < (0.0 - 0.5) { t - 1.0 }
  else if f == 0.5 {
    if real_to_int(t) % 2 == 0 { t } else { t + 1.0 }
  }
  else if f == (0.0 - 0.5) {
    if real_to_int(t) % 2 == 0 { t } else { t - 1.0 }
  }
  else { t }
}

#[doc("Truncate toward zero. `real.trunc(3.7) == 3.0`, `real.trunc(-3.7) == -3.0`.")]
pub fn trunc[u: Measure](x: Real<u>) : Real<u> = __attach_unit(trunc_real(__strip_unit(x)))

#[doc("Round toward negative infinity. `real.floor(3.7) == 3.0`, `real.floor(-3.7) == -4.0`.")]
pub fn floor[u: Measure](x: Real<u>) : Real<u> = __attach_unit(floor_real(__strip_unit(x)))

#[doc("Round toward positive infinity. Mirror of real.floor.")]
pub fn ceil[u: Measure](x: Real<u>) : Real<u> = __attach_unit(ceil_real(__strip_unit(x)))

#[doc("""
Round half-away-from-zero (the "schoolbook" rule). 0.5 → 1.0,
-0.5 → -1.0. A local `fn round` shadows this export; qualify
(`real.round`) where that matters.
""")]
pub fn round[u: Measure](x: Real<u>) : Real<u> = __attach_unit(round_real(__strip_unit(x)))

#[doc("""
Round half-to-even (banker's rounding, IEEE 754 default): ties
break toward the even integer, so a long stream of midpoints does
not bias the sum. 0.5 → 0.0, 1.5 → 2.0, 2.5 → 2.0, -2.5 → -2.0.
""")]
pub fn round_half_even[u: Measure](x: Real<u>) : Real<u> =
  __attach_unit(round_half_even_real(__strip_unit(x)))

#[doc("""
Round half-away-from-zero to `decimals` places; a negative `decimals`
rounds to tens, hundreds, …. `real.round_to(3.14159, 2) == 3.14`,
`real.round_to(1234.0, -2) == 1200.0`.
""")]
pub fn round_to[u: Measure](x: Real<u>, decimals: Int) : Real<u> = {
  let bare = __strip_unit(x)
  let scale = real_pow(10.0, int_to_real(if decimals < 0 { 0 - decimals } else { decimals }))
  let r = if decimals < 0 { round_real(bare / scale) * scale }
          else { round_real(bare * scale) / scale }
  __attach_unit(r)
}


# ---- Fixed-point rendering ---------------------------------------

fn pow10_int(n: Int) : Int = if n <= 0 { 1 } else { 10 * pow10_int(n - 1) }

fn zero_pad(s: String, width: Int) : String =
  if string_length(s) >= width { s } else { zero_pad(string_concat("0", s), width) }

#[doc("""
`x` rendered with exactly `digits` places after the point, rounded
half-to-even on the scaled value (`real.to_fixed(2.5, 0) == "2"`,
`real.to_fixed(3.14159, 2) == "3.14"`). `digits` is clamped to `0..18`.
Bounded-precision like the other rounding functions: a scaled value past
the Int64 range is not representable. NaN and infinities render as
`show` does.
""")]
pub fn to_fixed(x: Real, digits: Int) : String =
  if real_is_nan(x) or real_is_inf(x) { real_to_string(x) }
  else {
    let d = if digits < 0 { 0 } else if digits > 18 { 18 } else { digits }
    let p = pow10_int(d)
    let n = real_to_int(round_half_even_real(x * int_to_real(p)))
    let mag = if n < 0 { 0 - n } else { n }
    let sign = if n < 0 { "-" } else { "" }
    let whole = string_concat(sign, int_to_string(mag / p))
    if d == 0 { whole }
    else { string_concat(whole, string_concat(".", zero_pad(int_to_string(mag % p), d))) }
  }
