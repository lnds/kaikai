#[doc("""
Magnitude to decimal digits in subquadratic time: values wider than
`leaf_digits` divide by cached powers of ten and render both halves,
zero-padding the low one; short values divide by 10^9 repeatedly.
""")]

import math.bits
import math.bigint_limbs.{sig_len, mag_divmod_limb}
import math.bigint_division.{mag_divmod}
import math.bigint_pow10.{chunk_base, leaf_digits, render_split_limbs, pow10_chain, pow10_at}

# Digits of a nonzero magnitude by repeated division by 10^9; `parts`
# holds the nine-digit groups already taken, most significant first.
fn leaf_loop(mag: Array[Int], parts: [String]) : String = {
  let qr = mag_divmod_limb(mag, chunk_base())
  if sig_len(qr.fst) == 0 {
    string_concat_all([int_to_string(qr.snd), ...parts])
  } else {
    let digits = int_to_string(qr.snd)
    leaf_loop(qr.fst, [string_slice("000000000", 0, 9 - string_length(digits)), digits, ...parts])
  }
}

fn leaf_text(x: Array[Int], width: Int, pad: Bool) : String = {
  let body = if sig_len(x) == 0 { "" } else { leaf_loop(x, []) }
  if pad { string.repeat("0", width - string_length(body)) ++ body } else { body }
}

# Text of `x < 10^(leaf_digits * 2^j)`, zero-padded to that width when
# `pad`. A zero high half leaves the low half unpadded.
fn render(x: Array[Int], j: Int, pad: Bool, powers: [Array[Int]]) : String =
  if j == 0 or sig_len(x) <= leaf_limbs() { leaf_text(x, leaf_digits() * bit_shl(1, j), pad) }
  else {
    let qr = mag_divmod(x, pow10_at(powers, j - 1))
    render(qr.fst, j - 1, pad, powers) ++ render(qr.snd, j - 1, pad or sig_len(qr.fst) > 0, powers)
  }

# Limbs that hold any value below 10^leaf_digits.
fn leaf_limbs() : Int = leaf_digits() * 10381 / 100000 + 1

# Smallest `j` with `leaf_digits * 2^j` at least the digit count of `n` limbs.
fn render_level(n: Int) : Int = render_level_from(n * 32 * 30103 / 100000 + 1, 0)

fn render_level_from(digits: Int, j: Int) : Int =
  if leaf_digits() * bit_shl(1, j) >= digits { j } else { render_level_from(digits, j + 1) }

#[doc("The base-10 digits of the nonzero magnitude `mag`, without leading zeros.")]
pub fn mag_to_decimal(mag: Array[Int]) : String = {
  let n = sig_len(mag)
  if n <= render_split_limbs() { leaf_text(mag, 0, false) }
  else {
    let j = render_level(n)
    render(mag, j, false, pow10_chain(j))
  }
}
