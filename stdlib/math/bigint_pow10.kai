#[doc("""
Powers of ten for the decimal conversions: the leaf width, the size
thresholds below which the plain nine-digits-per-step loops win, and the
chain of `10^(leaf_digits * 2^j)` the splits cut at.
""")]

import math.bits
import math.bigint_karatsuba.{mag_mul_fast}

#[doc("The base of one conversion step: 10^9, the largest power of ten below 2^31.")]
pub fn chunk_base() : Int = 1000000000

# The leaf holds 9 * 2^leaf_doublings digits.
fn leaf_doublings() : Int = 9

#[doc("The digit width of the smallest split piece.")]
pub fn leaf_digits() : Int = 9 * bit_shl(1, leaf_doublings())

#[doc("Digit count above which parsing splits instead of folding nine digits at a time.")]
pub fn parse_split_digits() : Int = 24000

#[doc("Limb count above which rendering splits instead of dividing by 10^9 repeatedly.")]
pub fn render_split_limbs() : Int = 7000

#[doc("The magnitude zero as a one-limb array.")]
pub fn zero_mag() : Array[Int] = array_make(1, 0)

#[doc("Largest `j` with `leaf_digits * 2^j < len`; requires `len > leaf_digits`.")]
pub fn split_level(len: Int) : Int = split_level_from(len, 0)

fn split_level_from(len: Int, j: Int) : Int =
  if leaf_digits() * bit_shl(1, j + 1) < len { split_level_from(len, j + 1) }
  else { j }

#[doc("The powers `10^(leaf_digits * 2^j)` for `j` below `levels`, ascending.")]
pub fn pow10_chain(levels: Int) : [Array[Int]] = pow10_from(pow10_leaf(base_mag(), leaf_doublings()), levels)

fn base_mag() : Array[Int] = {
  let m = array_make(1, 0)
  m[0] := chunk_base()
  m
}

fn pow10_leaf(p: Array[Int], doublings: Int) : Array[Int] =
  if doublings <= 0 { p } else { pow10_leaf(mag_mul_fast(p, p), doublings - 1) }

fn pow10_from(p: Array[Int], left: Int) : [Array[Int]] =
  if left <= 0 { [] } else { [p, ...pow10_from(mag_mul_fast(p, p), left - 1)] }

#[doc("The power at index `j` of a chain from `pow10_chain`.")]
pub fn pow10_at(powers: [Array[Int]], j: Int) : Array[Int] = match powers {
  [p, ...rest] -> if j == 0 { p } else { pow10_at(rest, j - 1) }
  [] -> zero_mag()
}
