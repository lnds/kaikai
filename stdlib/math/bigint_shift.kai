#[doc("""
Positional helpers on base-2^32 magnitudes: limb slices, shifted adds
and bit shifts. Every helper builds and returns its own buffer, so the
`Mutable` demand is masked.
""")]

import math.bigint_limbs.{sig_len, limb_lo, limb_hi}
import math.bits
import loop

#[doc("The limbs `[lo, hi)` of `a` as a fresh magnitude; positions past the end of `a` read as zero.")]
pub fn mag_slice(a: Array[Int], lo: Int, hi: Int) : Array[Int] = {
  let top = if hi < array_length(a) { hi } else { array_length(a) }
  let n = top - lo
  let out = array_make(if n <= 0 { 1 } else { n }, 0)
  var i := 0
  while { i < n } {
    out[i] := a[lo + i]
    i := i + 1
  }
  out
}

#[doc("`x + y * 2^(32k)`. The result may carry a high zero limb; the caller canonicalizes.")]
pub fn mag_add_shifted(x: Array[Int], y: Array[Int], k: Int) : Array[Int] = {
  let nx = sig_len(x)
  let ny = sig_len(y)
  let top = if ny == 0 { 0 } else { ny + k }
  let n = if nx > top { nx } else { top }
  let out = array_make(n + 1, 0)
  var i := 0
  var carry := 0
  while { i < n } {
    let xv = if i < nx { x[i] } else { 0 }
    let yv = if i >= k and i - k < ny { y[i - k] } else { 0 }
    let s = xv + yv + carry
    out[i] := limb_lo(s)
    carry := limb_hi(s)
    i := i + 1
  }
  out[n] := carry
  out
}

#[doc("`a` shifted left by `s` bits, `s` in `[0, 31]`. The result carries one extra high limb.")]
pub fn mag_shl_bits(a: Array[Int], s: Int) : Array[Int] = {
  let n = sig_len(a)
  let out = array_make(n + 1, 0)
  var i := 0
  var carry := 0
  while { i < n } {
    let v = bit_shl(a[i], s)
    out[i] := limb_lo(bit_or(limb_lo(v), carry))
    carry := limb_hi(v)
    i := i + 1
  }
  out[n] := carry
  out
}

#[doc("`a` shifted right by `s` bits, `s` in `[0, 31]`.")]
pub fn mag_shr_bits(a: Array[Int], s: Int) : Array[Int] = {
  let n = sig_len(a)
  let out = array_make(if n <= 0 { 1 } else { n }, 0)
  var i := 0
  while { i < n } {
    let next = if i + 1 < n { a[i + 1] } else { 0 }
    out[i] := limb_lo(bit_or(bit_ushr(a[i], s), bit_shl(next, 32 - s)))
    i := i + 1
  }
  out
}

#[doc("The left shift in `[0, 31]` that sets the top bit of the nonzero limb `top`.")]
pub fn limb_norm_shift(top: Int) : Int = norm_shift_from(top, 0)

fn norm_shift_from(top: Int, s: Int) : Int =
  if top >= bit_shl(1, 31) { s } else { norm_shift_from(top * 2, s + 1) }
