#[doc("""
stdlib/encoding/json.kai — JSON encoder + decoder.

Pure functional. Operates on a small algebraic data type
(`JsonValue`) and `String`. No effects.

`JsonValue` is declared in `stdlib/encoding/json_bind.kai`, alongside
the runtime `#[derive(Json)]` lowers onto. This module is the dynamic
half — text in, tree out — over the same tree.

Coverage of RFC 8259:
  - null, true, false: yes
  - numbers: integers (`JNum`) and reals (`JReal`). Integers are
    parsed when the lexeme has no `.` / `e` / `E`; otherwise the
    full RFC 8259 number grammar (fraction + exponent) is parsed
    into a `Real` via the core `string_to_real`. Leading zeros yield
    `None`. A `JReal` encodes with a fraction or exponent so it decodes
    back as a `JReal`.
  - strings: full escape table (`\\"`, `\\\\`, `\\/`, `\\b`, `\\f`, `\\n`,
    `\\r`, `\\t`, `\\uXXXX`); the decoder folds `\\uXXXX` to a UTF-8
    byte sequence (1–3 bytes for the basic multilingual plane) and
    handles surrogate pairs `\\uD8xx\\uDCxx` for non-BMP codepoints
    (emojis, supplementary CJK, etc.) emitting the corresponding
    4-byte UTF-8 sequence. Lone or invalid surrogates yield `None`,
    as does a raw control character (below U+0020) inside a string.
    The encoder emits raw UTF-8 bytes for non-ASCII characters,
    which is RFC 8259 §8.1 compliant for JSON exchanged between
    systems.
  - arrays: yes
  - objects: yes; key ordering preserved on encode/decode.

Public surface:

  pub fn json_encode(v: JsonValue) : String
  pub fn json_decode(s: String) : Option[JsonValue]
  pub fn json_decode_report(s: String) : Result[JsonValue, JsonParseError]

`json_decode_report` accepts exactly what `json_decode` accepts and says
where it stopped when it rejects.
""")]

import encoding.json_bind
import encoding.json_lex

# ---- Encoder -----------------------------------------------------

# Escape a String per RFC 8259 §7: the standard escapes for the seven
# required characters plus any control character below U+0020. Runs of
# bytes that need no escape are sliced whole and joined once at the end.
fn json_escape(s: String) : String =
  string_concat_all(list_reverse(json_escape_loop(s, 0, 0, [])))

fn json_escape_loop(s: String, i: Int, run: Int, parts: [String]) : [String] = {
  if i >= string_length(s) { json_flush(s, run, i, parts) }
  else {
    let b = string_byte_at_int(s, i)
    if b < 32 or b == 34 or b == 92 {
      json_escape_loop(s, i + 1, i + 1,
        [json_escape_char(b), ...json_flush(s, run, i, parts)])
    } else { json_escape_loop(s, i + 1, run, parts) }
  }
}

# Only called for a quote, a backslash or a control byte; every other byte is
# emitted verbatim (raw UTF-8 round-trips per RFC 8259 §8.1).
fn json_escape_char(b: Int) : String = match b {
  34 -> "\\\""
  92 -> "\\\\"
  10 -> "\\n"
  13 -> "\\r"
  9  -> "\\t"
  _  -> string_concat("\\u00", json_hex_byte(b))
}

# Lowercase hex of a byte, for `\u00XX`.
fn json_hex_byte(n: Int) : String =
  string_slice("0123456789abcdef", (n / 16) % 16, 1) ++ string_slice("0123456789abcdef", n % 16, 1)

#[doc("Serialises a `JsonValue` to a compact JSON string (RFC 8259, no insignificant whitespace).")]
pub fn json_encode(v: JsonValue) : String = json_encode_at(v, 0)

# Nesting deeper than this switches to the work-stack driver below.
const JSON_ENC_DEPTH : Int = 32

fn json_encode_at(v: JsonValue, depth: Int) : String =
  if depth >= JSON_ENC_DEPTH { string_concat_all(list_reverse(json_encode_loop([json_enc_item(v)], []))) }
  else { match v {
    JNull       -> "null"
    JBool(b)    -> if b { "true" } else { "false" }
    JNum(n)     -> int_to_string(n)
    JReal(r)    -> json_real_text(r)
    JStr(s)     -> string_concat(string_concat("\"", json_escape(s)), "\"")
    JArr(xs)    -> string_concat(string_concat("[", json_join_elems(xs, depth + 1, [])), "]")
    JObj(ps)    -> string_concat(string_concat("{", json_join_members(ps, depth + 1, [])), "}")
  } }

# Elements rendered at `depth`, comma-joined.
fn json_join_elems(xs: [JsonValue], depth: Int, acc: [String]) : String = match xs {
  []           -> string.join(list_reverse(acc), ",")
  [x, ...rest] -> json_join_elems(rest, depth, [json_encode_at(x, depth), ...acc])
}

fn json_join_members(ps: [Pair[String, JsonValue]], depth: Int, acc: [String]) : String = match ps {
  []           -> string.join(list_reverse(acc), ",")
  [p, ...rest] -> json_join_members(rest, depth, [json_encode_pair(p, depth), ...acc])
}

fn json_encode_pair(p: Pair[String, JsonValue], depth: Int) : String =
  string_concat(
    string_concat(string_concat("\"", json_escape(p.fst)), "\":"),
    json_encode_at(p.snd, depth))

# A real whose text reads as an integer gets `.0`, so it decodes back as a real.
fn json_real_text(r: Real) : String = {
  let t = real_to_string(r)
  if string_contains(t, ".") or string_contains(t, "e") or string_contains(t, "n") { t }
  else { string_concat(t, ".0") }
}

# Pending output of the encoder: final text, or a container still to expand.
type JEnc = EncText(String) | EncArr([JsonValue]) | EncObj([Pair[String, JsonValue]])

fn json_enc_item(v: JsonValue) : JEnc = match v {
  JNull    -> EncText("null")
  JBool(b) -> EncText(if b { "true" } else { "false" })
  JNum(n)  -> EncText(int_to_string(n))
  JReal(r) -> EncText(json_real_text(r))
  JStr(s)  -> EncText(string_concat(string_concat("\"", json_escape(s)), "\""))
  JArr(xs) -> EncArr(xs)
  JObj(ps) -> EncObj(ps)
}

# Work-stack driver: `work` is the output still to emit, `out` the emitted
# pieces newest first. Containers expand in place, so stack use is constant
# however deep the value nests.
fn json_encode_loop(work: [JEnc], out: [String]) : [String] = match work {
  [] -> out
  [item, ...rest] -> match item {
    EncText(t) -> json_encode_loop(rest, [t, ...out])
    EncArr(xs) -> json_encode_loop(json_enc_elems(list_reverse(xs), [EncText("]"), ...rest], false), ["[", ...out])
    EncObj(ps) -> json_encode_loop(json_enc_members(list_reverse(ps), [EncText("}"), ...rest]), ["{", ...out])
  }
}

# `rev` is the elements last first; each is consed before `acc`, with a comma
# between neighbours.
fn json_enc_elems(rev: [JsonValue], acc: [JEnc], sep: Bool) : [JEnc] = match rev {
  []           -> acc
  [x, ...more] -> json_enc_elems(more, [json_enc_item(x), ...json_enc_comma(acc, sep)], true)
}

# The comma between members rides on the key text of every member but the first.
fn json_enc_members(rev: [Pair[String, JsonValue]], acc: [JEnc]) : [JEnc] = match rev {
  []           -> acc
  [p, ...more] -> json_enc_members(more,
    [EncText(string_concat(string_concat(match more { [] -> "\"" _ -> ",\"" }, json_escape(p.fst)), "\":")),
     json_enc_item(p.snd), ...acc])
}

fn json_enc_comma(acc: [JEnc], sep: Bool) : [JEnc] =
  if sep { [EncText(","), ...acc] } else { acc }

# ---- Decoder -----------------------------------------------------
#
# Recursive-descent parser over a (String, Int) pair: the input and a
# cursor. Helpers return `Result[JParse, JFail]`; on success the value plus
# the cursor right after the consumed token, on failure the byte offset
# where parsing could not continue and why. Whitespace is skipped before
# every token; trailing garbage after the top-level value is an error.

# Skip ASCII whitespace (space, tab, CR, LF) starting at `i`.
fn json_skip_ws(s: String, i: Int) : Int = {
  if i >= string_length(s) { i }
  else { match char_at(s, i) {
    None    -> i
    Some(c) -> if c == ' ' or c == '\t' or c == '\n' or c == '\r' {
                 json_skip_ws(s, i + 1)
               } else { i }
  } }
}

# Match a literal at the cursor: returns the new cursor on match,
# or None.
fn json_match_lit(s: String, i: Int, lit: String) : Option[Int] = {
  let ll = string_length(lit)
  if i + ll > string_length(s) { None }
  else if string_slice(s, i, ll) == lit { Some(i + ll) }
  else { None }
}

# A pending container frame on the iterative parser's explicit
# stack. ArrFrame accumulates an array's items; ObjFrame
# accumulates an object's key/value pairs plus the (optional)
# key whose value is currently being parsed.
type JFrame
  = ArrFrame([JsonValue])
  | ObjFrame([Pair[String, JsonValue]], Option[String])

#[doc("""
Parses `s` as one JSON value, returning `None` on malformed input; the
same grammar as `json_decode_report`, which says where it stopped.
Leading and trailing whitespace is skipped; any other trailing text is
rejected. Nesting depth is bounded by memory, not by the stack.
""")]
pub fn json_decode(s: String) : Option[JsonValue] = match json_scan(s) {
  Err(_) -> None
  Ok(r)  -> json_finish(s, r)
}

fn json_finish(s: String, r: JParse) : Option[JsonValue] =
  if json_complete(s, r) { Some(r.v) } else { None }

#[doc("""
Parses `s` like `json_decode`, reporting where it stopped on failure.

`offset` is the 0-based byte offset of the token the parser could not
accept: the offending byte, the backslash opening a bad escape, the
digit position of a bad number, or the input length when the text ends
early. `line` is 1-based and counts `\\n`; `column` is 1-based and counts
Unicode characters (not bytes) from the start of the line. `reason` is a
short message such as `expected ',' or ']'`.
""")]
pub fn json_decode_report(s: String) : Result[JsonValue, JsonParseError] = match json_scan(s) {
  Err(f) -> Err(json_locate(s, f, 0, 1, 1))
  Ok(r)  -> if json_complete(s, r) { Ok(r.v) }
            else { Err(json_locate(s, JFail { at: json_skip_ws(s, r.i), why: "trailing characters after value" }, 0, 1, 1)) }
}

# The parse both entry points share: one value, then the caller checks `json_complete`.
fn json_scan(s: String) : Result[JParse, JFail] =
  json_loop(s, json_skip_ws(s, 0), [], ModeValue)

fn json_complete(s: String, r: JParse) : Bool = json_skip_ws(s, r.i) == string_length(s)

#[doc("Where a decode stopped: 0-based byte `offset`, 1-based `line` and character `column`, and a short `reason`.")]
pub type JsonParseError = {
  line: Int,
  column: Int,
  offset: Int,
  reason: String,
}

# Walks the bytes before the failure: `\n` opens a line, a continuation byte
# (0x80..0xBF) does not start a character.
fn json_locate(s: String, f: JFail, i: Int, line: Int, col: Int) : JsonParseError = {
  if i >= f.at {
    JsonParseError { line: line, column: col, offset: f.at, reason: f.why }
  } else {
    let b = string_byte_at_int(s, i)
    if b == 10 { json_locate(s, f, i + 1, line + 1, 1) }
    else if b >= 0x80 and b < 0xC0 { json_locate(s, f, i + 1, line, col) }
    else { json_locate(s, f, i + 1, line, col + 1) }
  }
}

# ---- Iterative driver ---------------------------------------------
#
# An explicit stack of pending container frames keeps nesting off the fiber
# stack. The loop is a single self-tail call so TCO folds it into one frame;
# mutual tail recursion is not folded, so each step is a plain function that
# returns the next state instead of calling back into the loop.

type JMode
  = ModeValue
  | ModeAfterValue(JsonValue)
  | ModeObjKey

type JStep
  = StepGo(Int, [JFrame], JMode)
  | StepDone(JParse)
  | StepFail(JFail)

fn json_loop(s: String, i: Int, stack: [JFrame], mode: JMode) : Result[JParse, JFail] =
  match json_step(s, i, stack, mode) {
    StepGo(i2, stack2, mode2) -> json_loop(s, i2, stack2, mode2)
    StepDone(r)               -> Ok(r)
    StepFail(f)               -> Err(f)
  }

fn json_step(s: String, i: Int, stack: [JFrame], mode: JMode) : JStep = match mode {
  ModeValue         -> json_step_value(s, i, stack)
  ModeAfterValue(v) -> json_step_after(s, i, stack, v)
  ModeObjKey        -> json_step_key(s, i, stack)
}

fn json_leaf(r: Result[JParse, JFail], stack: [JFrame]) : JStep = match r {
  Err(f) -> StepFail(f)
  Ok(p)  -> StepGo(p.i, stack, ModeAfterValue(p.v))
}

# Parses a value at `i`: a leaf completes at once, a container opens a frame.
fn json_step_value(s: String, i: Int, stack: [JFrame]) : JStep = {
  let j = json_skip_ws(s, i)
  match char_at(s, j) {
    Some('{') -> match char_at(s, json_skip_ws(s, j + 1)) {
      Some('}') -> StepGo(json_skip_ws(s, j + 1) + 1, stack, ModeAfterValue(JObj([])))
      _         -> StepGo(json_skip_ws(s, j + 1), [ObjFrame([], None), ...stack], ModeObjKey)
    }
    Some('[') -> match char_at(s, json_skip_ws(s, j + 1)) {
      Some(']') -> StepGo(json_skip_ws(s, j + 1) + 1, stack, ModeAfterValue(JArr([])))
      _         -> StepGo(json_skip_ws(s, j + 1), [ArrFrame([]), ...stack], ModeValue)
    }
    Some('"') -> json_leaf(json_parse_string(s, j), stack)
    Some('t') -> json_leaf(json_parse_bool(s, j), stack)
    Some('f') -> json_leaf(json_parse_bool(s, j), stack)
    Some('n') -> json_leaf(json_parse_null(s, j), stack)
    Some('-') -> json_leaf(json_parse_number(s, j), stack)
    Some(c)   -> if char.is_digit(c) { json_leaf(json_parse_number(s, j), stack) }
                 else { StepFail(json_stuck(s, j, "unexpected character")) }
    None      -> StepFail(json_stuck(s, j, "unexpected character"))
  }
}

# Feeds the finished value `v` to the top frame. Frames build head-first and
# reverse on close, which keeps both space and time linear in the result.
fn json_step_after(s: String, i: Int, stack: [JFrame], v: JsonValue) : JStep = {
  let j = json_skip_ws(s, i)
  match stack {
    [] -> StepDone(JParse { v: v, i: i })
    [ArrFrame(acc), ...rest] -> match char_at(s, j) {
      Some(',') -> StepGo(json_skip_ws(s, j + 1), [ArrFrame([v, ...acc]), ...rest], ModeValue)
      Some(']') -> StepGo(j + 1, rest, ModeAfterValue(JArr(list_reverse([v, ...acc]))))
      _         -> StepFail(json_stuck(s, j, "expected ',' or ']'"))
    }
    [ObjFrame(acc, Some(k)), ...rest] -> match char_at(s, j) {
      Some(',') -> StepGo(json_skip_ws(s, j + 1), [ObjFrame([Pair { fst: k, snd: v }, ...acc], None), ...rest], ModeObjKey)
      Some('}') -> StepGo(j + 1, rest, ModeAfterValue(JObj(list_reverse([Pair { fst: k, snd: v }, ...acc]))))
      _         -> StepFail(json_stuck(s, j, "expected ',' or '}'"))
    }
    _ -> StepFail(json_stuck(s, j, "unexpected value"))
  }
}

# Reads `"key":` and records the key on the top object frame.
fn json_step_key(s: String, i: Int, stack: [JFrame]) : JStep = {
  let j = json_skip_ws(s, i)
  match char_at(s, j) {
    Some('"') -> match json_parse_string(s, j) {
      Err(f) -> StepFail(f)
      Ok(p)  -> json_step_colon(s, p, stack)
    }
    _ -> StepFail(json_stuck(s, j, "expected object key"))
  }
}

# `p` is the parsed key; the cursor must sit on `:`.
fn json_step_colon(s: String, p: JParse, stack: [JFrame]) : JStep = {
  let c = json_skip_ws(s, p.i)
  match char_at(s, c) {
    Some(':') -> match stack {
      [ObjFrame(acc, _), ...rest] -> StepGo(json_skip_ws(s, c + 1), [ObjFrame(acc, Some(json_key_text(p.v))), ...rest], ModeValue)
      _ -> StepFail(json_stuck(s, c, "unexpected key"))
    }
    _ -> StepFail(json_stuck(s, c, "expected ':'"))
  }
}

fn json_key_text(v: JsonValue) : String = match v {
  JStr(k) -> k
  _       -> ""
}

fn json_parse_null(s: String, i: Int) : Result[JParse, JFail] =
  json_need(json_match_lit(s, i, "null"), i, "invalid literal") || j => jp_ok(JNull, j)

fn json_parse_bool(s: String, i: Int) : Result[JParse, JFail] = match json_match_lit(s, i, "true") {
  Some(j) -> jp_ok(JBool(true), j)
  None    -> json_need(json_match_lit(s, i, "false"), i, "invalid literal") || j => jp_ok(JBool(false), j)
}

# ---- Drilling helpers ---------------------------------------------
#
# Lookups return `None` when the key or index is absent, or the value
# is not an object / array, so a present `null` is `Some(JNull)`.
# Chain them with `||`; the leaf `as_*` extractors take the unwrapped
# value.

#[doc("Looks up `key` in a JSON object, returning `Some(value)` or `None` on a miss or a non-object.")]
pub fn get(v: JsonValue, key: String) : Option[JsonValue] = match v {
  JObj(pairs) -> json_pairs_get(pairs, key)
  _           -> None
}

fn json_pairs_get(pairs: [Pair[String, JsonValue]], key: String) : Option[JsonValue] = match pairs {
  []           -> None
  [p, ...rest] -> if p.fst == key { Some(p.snd) } else { json_pairs_get(rest, key) }
}

#[doc("Indexes element `i` of a JSON array, returning `Some(value)` or `None` when out of range or not an array.")]
pub fn at(v: JsonValue, i: Int) : Option[JsonValue] = match v {
  JArr(items) -> json_nth(items, i)
  _           -> None
}

fn json_nth(xs: [JsonValue], i: Int) : Option[JsonValue] = match xs {
  []           -> None
  [x, ...rest] -> if i == 0 { Some(x) } else { json_nth(rest, i - 1) }
}

# Primitive extractors. Each returns `None` when the underlying
# variant does not match the requested kind; `as_real` accepts
# both JReal and JNum (widening to Real), and `as_int` accepts
# JNum only (rejecting JReal because the caller asked for a
# lossless integer).

#[doc("Extracts the string when `v` is a JSON string, otherwise `None`.")]
pub fn as_string(v: JsonValue) : Option[String] = match v {
  JStr(s) -> Some(s)
  _       -> None
}

#[doc("Extracts the integer when `v` is a JSON integer, otherwise `None` (a JSON real is rejected).")]
pub fn as_int(v: JsonValue) : Option[Int] = match v {
  JNum(n) -> Some(n)
  _       -> None
}

#[doc("Extracts the value as a `Real` when `v` is a JSON real or integer, otherwise `None`.")]
pub fn as_real(v: JsonValue) : Option[Real] = match v {
  JReal(r) -> Some(r)
  JNum(n)  -> Some(int_to_real(n))
  _        -> None
}

#[doc("Extracts the boolean when `v` is a JSON bool, otherwise `None`.")]
pub fn as_bool(v: JsonValue) : Option[Bool] = match v {
  JBool(b) -> Some(b)
  _        -> None
}
