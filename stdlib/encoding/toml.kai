#[doc("""
TOML decoder/encoder for a subset — enough for the package manifest
and lockfile, not RFC 1.0.0 complete. Pure functional, no effects;
operates on the `TomlValue` ADT and `String`.

Supported:
  - Comments: `# ...` to end-of-line.
  - Scalar values: basic strings (`"..."` with `\"`, `\\`, `\n`,
    `\r`, `\t` escapes), integers, floats, `true` / `false`.
  - Tables `[name]` and arrays of tables `[[name]]`. A header is a
    dotted key path of bare or quoted segments (`[a.b]`,
    `[a."b.c"]`) and nests: it creates the tables it passes through,
    and a path through an array of tables enters its last element.
  - Array values `["a", "b"]`, single- or multi-line, with comments
    and a trailing comma allowed inside the brackets.
  - Single-line inline tables `{ key = "v", key2 = "w" }`.
  - Bare keys: `[A-Za-z0-9_-]+`.

A table defined twice, a key set twice in one table, and a header
over a key that is not a table reject the document.

Numbers take an optional `-` or `+` sign. A number is a float when
the digits are followed by a fractional part (`0.8`), an exponent
(`1e6`, `5e+22`, `6.626e-34`), or both; a digit is required on each
side of the `.` and after the exponent marker. `inf` and `nan` are
not decoded, and `_` digit separators are not accepted in any
number.

Out of scope: dotted and quoted keys left of `=`, datetimes,
literal and multi-line strings, `inf` / `nan`, `_` digit separators.

A document the subset cannot read is still rejected whole, as TOML
requires — but `decode_report` names the line and key the parse
stopped on, so a caller can point at the offending entry instead of
calling the file malformed without saying where.

A local `fn decode` / `fn round_trip` shadows the export; qualify
(`toml.decode(s)`) where that matters.
""")]

# ---- AST ---------------------------------------------------------

#[doc("A decoded TOML value: string, bool, integer, float, array, or table.")]
pub type TomlValue
  = TStr(String)
  | TBool(Bool)
  | TInt(Int)
  | TReal(Real)
  | TArr([TomlValue])
  | TTbl([Pair[String, TomlValue]])

#[doc("Where a decode stopped: 1-based `line`, the bare `key` on that line (empty for a header or a stray line), and a short `reason`.")]
pub type TomlError = {
  line: Int,
  key: String,
  reason: String,
}

# ---- Parser state ------------------------------------------------
# Single linear pass. Each `key = value` lands in `root` at once, in
# the table the last header's path names (`[]`: the root itself).
# Tables under construction are indexed by a hash-ordered tree, so a
# lookup or an insert does not scan the table.

type Pairs = [Pair[String, TomlValue]]

# `ix` finds a key's value; `keys` lists the keys, newest first;
# `def` marks a table a `[header]` has opened.
type WTbl = { ix: Ix, keys: [String], def: Bool }

# An array of tables keeps its last element open for edits and the
# earlier ones as finished values, newest first; the flag says they
# are all tables.
type WVal = WLeaf(TomlValue) | WTab(WTbl) | WAot(Bool, [TomlValue], WTbl)

# Search tree ordered by the key's hash; the hash spreads keys, so it
# stays shallow without rebalancing.
type Ix = IxNil | IxNode(Int, String, WVal, Ix, Ix)

type TomlSt = {
  s: String,
  i: Int,
  root: WTbl,
  hdr: [String],
}

# ---- Decoder entry ------------------------------------------------

#[doc("Parses TOML source into a root `TTbl`, returning `None` on malformed input. Supports `[table]` and `[[array-of-tables]]` headers.")]
pub fn decode(src: String) : Option[TomlValue] = {
  match decode_report(src) {
    Ok(v)  -> Some(v)
    Err(_) -> None
  }
}

#[doc("Parses TOML source like `decode`, reporting the line and key the parse stopped on instead of a bare `None`.")]
pub fn decode_report(src: String) : Result[TomlValue, TomlError] = {
  let st0 = TomlSt { s: src, i: 0, root: wt_empty(), hdr: [] }
  match toml_parse_lines(st0) {
    Err(off) -> Err(toml_error_at(src, off))
    Ok(st)   -> Ok(TTbl(wt_finish(st.root, st.root.keys, [])))
  }
}

#[doc("Renders a `TomlError` as a one-line diagnostic, e.g. `line 5: key threshold: unsupported or malformed value`.")]
pub fn error_message(e: TomlError) : String = {
  let loc = string_concat("line ", int_to_string(e.line))
  let named = if e.key == "" { loc }
              else { string_concat(loc, string_concat(": key ", e.key)) }
  string_concat(named, string_concat(": ", e.reason))
}

# Describe the line starting at byte offset `off`. A bare key
# followed by `=` names the entry; anything else (a header, a stray
# line) reports the position alone.
fn toml_error_at(s: String, off: Int) : TomlError = {
  let key_end = toml_scan_bare_key(s, off)
  let is_kv = key_end > off and toml_char_is(s, toml_skip_inline_ws_at(s, key_end), '=')
  TomlError {
    line: toml_line_of(s, 0, off, 1),
    key: if is_kv { string_slice(s, off, key_end - off) } else { "" },
    reason: if is_kv { "unsupported or malformed value, or a repeated key" }
            else if toml_char_is(s, off, '[') { "malformed, repeated or conflicting table header" }
            else { "unsupported or malformed line" },
  }
}

fn toml_line_of(s: String, i: Int, off: Int, line: Int) : Int = {
  if i >= off { line }
  else { match char_at(s, i) {
    None    -> line
    Some(c) -> toml_line_of(s, i + 1, off, if c == '\n' { line + 1 } else { line })
  } }
}

fn wt_empty() : WTbl = WTbl { ix: IxNil, keys: [], def: false }

fn ix_find(t: Ix, h: Int, key: String) : Option[WVal] = match t {
  IxNil -> None
  IxNode(h2, k, v, l, r) ->
    if h == h2 and k == key { Some(v) }
    else if h < h2 { ix_find(l, h, key) }
    else { ix_find(r, h, key) }
}

fn ix_insert(t: Ix, h: Int, key: String, v: WVal) : Ix = match t {
  IxNil -> IxNode(h, key, v, IxNil, IxNil)
  IxNode(h2, k, x, l, r) ->
    if h == h2 and k == key { IxNode(h2, k, v, l, r) }
    else if h < h2 { IxNode(h2, k, x, ix_insert(l, h, key, v), r) }
    else { IxNode(h2, k, x, l, ix_insert(r, h, key, v)) }
}

# The raw FNV hash orders similar keys badly; reducing it modulo a prime
# spreads them.
fn ix_hash(key: String) : Int = string_hash(key) % 999999937

fn wt_get(t: WTbl, key: String) : Option[WVal] = ix_find(t.ix, ix_hash(key), key)

fn wt_put(t: WTbl, key: String, v: WVal) : WTbl = {
  let keys = match wt_get(t, key) { None -> [key, ...t.keys]  Some(_) -> t.keys }
  WTbl { ...t, ix: ix_insert(t.ix, ix_hash(key), key, v), keys: keys }
}

# Rejects a table that repeats a key.
fn wt_of_pairs(ps: Pairs, acc: WTbl) : Option[WTbl] = match ps {
  []           -> Some(acc)
  [p, ...rest] -> match wt_get(acc, p.fst) {
    None    -> wt_of_pairs(rest, wt_put(acc, p.fst, WLeaf(p.snd)))
    Some(_) -> None
  }
}

fn wt_finish(t: WTbl, keys: [String], acc: Pairs) : Pairs = match keys {
  []           -> acc
  [k, ...rest] -> match wt_get(t, k) {
    None    -> wt_finish(t, rest, acc)
    Some(v) -> {
      let x = match v {
        WLeaf(x) -> x
        WTab(c)  -> TTbl(wt_finish(c, c.keys, []))
        WAot(_, before, last) -> TArr(list_reverse([TTbl(wt_finish(last, last.keys, [])), ...before]))
      }
      wt_finish(t, rest, [Pair { fst: k, snd: x }, ...acc])
    }
  }
}

# A literal table or array of tables, entered by a header, becomes
# editable; a missing key becomes an empty table.
fn wt_enter(v: Option[WVal]) : Option[WVal] = match v {
  None -> Some(WTab(wt_empty()))
  Some(WLeaf(TTbl(ps))) -> wt_of_pairs(ps, wt_empty()).map(c => WTab(c))
  Some(WLeaf(TArr(xs))) -> match list_reverse(xs) {
    [TTbl(ps), ...before] -> wt_of_pairs(ps, wt_empty()).map(c => WAot(all_tables(before), before, c))
    _ -> None
  }
  _ -> v
}

# Rebuild the table at `path` below `t` with `f`; an array of tables is
# entered at its last element.
fn wt_edit(t: WTbl, path: [String], f: (WTbl) -> Option[WTbl]) : Option[WTbl] =
  match path {
    [] -> f(t)
    [k, ...rest] -> match wt_enter(wt_get(t, k)) {
      Some(WTab(c)) -> wt_edit(c, rest, f).map(nc => wt_put(t, k, WTab(nc)))
      Some(WAot(all, before, last)) -> wt_edit(last, rest, f).map(nl => wt_put(t, k, WAot(all, before, nl)))
      _ -> None
    }
  }

# `g` rebuilds the table holding the path's last key, given that key.
fn wt_edit_last(t: WTbl, path: [String], g: (WTbl, String) -> Option[WTbl]) : Option[WTbl] =
  match list_reverse(path) {
    []         -> None
    [k, ...up] -> wt_edit(t, list_reverse(up), tb => g(tb, k))
  }

#[doc("Looks up key `k` in a TOML table's pair list, returning its value or `None`.")]
pub fn pairs_get(ps: [Pair[String, TomlValue]], k: String)
                  : Option[TomlValue] = {
  match ps {
    []      -> None
    [p, ...rest] -> if p.fst == k { Some(p.snd) }
                    else { pairs_get(rest, k) }
  }
}

#[doc("Replace or append (k, v) in pairs, preserving insertion order.")]
pub fn pairs_set(ps: [Pair[String, TomlValue]], k: String, v: TomlValue)
                  : [Pair[String, TomlValue]] = {
  toml_pairs_set_loop(ps, k, v, [], false)
}

fn toml_pairs_set_loop(ps: Pairs, k: String,
                       v: TomlValue, acc: Pairs,
                       found: Bool)
                       : Pairs = {
  match ps {
    [] -> if found { list_reverse(acc) }
          else { list_reverse([Pair { fst: k, snd: v }, ...acc]) }
    [p, ...rest] -> {
      if p.fst == k {
        toml_pairs_set_loop(rest, k, v,
          [Pair { fst: k, snd: v }, ...acc], true)
      } else {
        toml_pairs_set_loop(rest, k, v, [p, ...acc], found)
      }
    }
  }
}

# ---- Line loop ----------------------------------------------------

# `Err` carries the byte offset of the line that stopped the parse,
# which `toml_error_at` turns into a user-facing location.
fn toml_parse_lines(st: TomlSt) : Result[TomlSt, Int] = {
  let st1 = toml_skip_ws_and_comments(st)
  if st1.i >= string_length(st1.s) { Ok(st1) }
  else { match char_at(st1.s, st1.i) {
    None -> Ok(st1)
    Some(c) -> {
      if c == '[' { match toml_parse_header(st1) {
        None      -> Err(st1.i)
        Some(st2) -> toml_parse_lines(st2)
      } }
      else if char.is_alpha(c) or char.is_digit(c) or c == '-' { match toml_parse_kv(st1) {
        None      -> Err(st1.i)
        Some(st2) -> toml_parse_lines(st2)
      } }
      else { Err(st1.i) }
    }
  } }
}

# ---- Whitespace / comments / EOL ----------------------------------

fn toml_is_inline_ws(c: Char) : Bool = c == ' ' or c == '\t'

fn toml_is_eol(c: Char) : Bool = c == '\n' or c == '\r'

# Skip inline whitespace, full-line comments, and blank lines.
# Stops at the first character that begins a token (key or `[`).
fn toml_skip_ws_and_comments(st: TomlSt) : TomlSt = {
  if st.i >= string_length(st.s) { st }
  else { match char_at(st.s, st.i) {
    None    -> st
    Some(c) -> {
      if toml_is_inline_ws(c) or toml_is_eol(c) {
        toml_skip_ws_and_comments(toml_advance(st))
      } else if c == '#' {
        toml_skip_ws_and_comments(toml_skip_to_eol(st))
      } else { st }
    }
  } }
}

fn toml_skip_to_eol(st: TomlSt) : TomlSt = {
  if st.i >= string_length(st.s) { st }
  else { match char_at(st.s, st.i) {
    None    -> st
    Some(c) -> if toml_is_eol(c) { st } else { toml_skip_to_eol(toml_advance(st)) }
  } }
}

# After a value, demand: optional inline ws, optional `#` comment,
# then EOL or EOF. Returns the new state on success, None on
# trailing-garbage error.
fn toml_demand_eol(st: TomlSt) : Option[TomlSt] = {
  let st1 = toml_skip_inline_ws_at_st(st)
  if st1.i >= string_length(st1.s) { Some(st1) }
  else { match char_at(st1.s, st1.i) {
    None    -> Some(st1)
    Some(c) -> {
      if c == '#' { Some(toml_skip_to_eol(st1)) }
      else if toml_is_eol(c) { Some(toml_advance(st1)) }
      else { None }
    }
  } }
}

fn toml_advance(st: TomlSt) : TomlSt = toml_jump(st, 1)

# ---- Headers: [a.b] and [[a.b]] -----------------------------------

fn toml_parse_header(st: TomlSt) : Option[TomlSt] = {
  let is_arr = toml_char_is(st.s, st.i + 1, '[')
  let close = if is_arr { "]]" } else { "]" }
  let n = string_length(close)
  toml_parse_key_path(toml_jump(st, n), []).and_then(
    p => {
      let at = p.fst.i
      if at + n > string_length(st.s) or string_slice(st.s, at, n) != close { None }
      else {
        let opened = if is_arr { toml_open_array_table(p.fst, p.snd) }
                     else { toml_open_table(p.fst, p.snd) }
        opened.and_then(o => toml_demand_eol(toml_jump(o, n)))
      }
    }
  )
}

# `a . "b.c"`: bare or quoted segments joined by `.`.
fn toml_parse_key_path(st: TomlSt, acc: [String]) : Option[Pair[TomlSt, [String]]] =
  match toml_parse_key_segment(toml_skip_inline_ws_at_st(st)) {
    None -> None
    Some(p) -> {
      let st2 = toml_skip_inline_ws_at_st(p.fst)
      let path = [p.snd, ...acc]
      if toml_char_is(st2.s, st2.i, '.') { toml_parse_key_path(toml_jump(st2, 1), path) }
      else { Some(Pair { fst: st2, snd: list_reverse(path) }) }
    }
  }

fn toml_parse_key_segment(st: TomlSt) : Option[Pair[TomlSt, String]] =
  if toml_char_is(st.s, st.i, '"') {
    toml_parse_string(st).and_then(
      p => match p.snd {
        TStr(k) -> Some(Pair { fst: p.fst, snd: k })
        _       -> None
      }
    )
  } else {
    let end = toml_scan_bare_key(st.s, st.i)
    if end == st.i { None }
    else { Some(Pair { fst: toml_jump(st, end - st.i), snd: string_slice(st.s, st.i, end - st.i) }) }
  }

fn toml_open_table(st: TomlSt, path: [String]) : Option[TomlSt] =
  wt_edit_last(st.root, path, (t, k) => match wt_get(t, k) {
    None -> Some(wt_put(t, k, WTab(WTbl { ...wt_empty(), def: true })))
    Some(WTab(c)) -> if c.def { None } else { Some(wt_put(t, k, WTab(WTbl { ...c, def: true }))) }
    Some(WLeaf(TTbl(ps))) -> wt_of_pairs(ps, wt_empty()).map(c => wt_put(t, k, WTab(WTbl { ...c, def: true })))
    Some(_) -> None
  }).map(r => TomlSt { ...st, root: r, hdr: path })

# Each `[[path]]` element starts fresh: the tables defined below the
# previous one may be defined again.
fn toml_open_array_table(st: TomlSt, path: [String]) : Option[TomlSt] =
  wt_edit_last(st.root, path, (t, k) => match wt_get(t, k) {
    None -> Some(wt_put(t, k, WAot(true, [], wt_empty())))
    Some(WAot(true, before, last)) ->
      Some(wt_put(t, k, WAot(true, [TTbl(wt_finish(last, last.keys, [])), ...before], wt_empty())))
    Some(WLeaf(TArr(xs))) -> if all_tables(xs) {
      Some(wt_put(t, k, WAot(true, list_reverse(xs), wt_empty())))
    } else { None }
    Some(_) -> None
  }).map(r => TomlSt { ...st, root: r, hdr: path })

fn toml_skip_inline_ws_at(s: String, i: Int) : Int = {
  if i >= string_length(s) { i }
  else { match char_at(s, i) {
    None    -> i
    Some(c) -> if toml_is_inline_ws(c) { toml_skip_inline_ws_at(s, i + 1) } else { i }
  } }
}

# ---- Bare keys ----------------------------------------------------

fn toml_scan_bare_key(s: String, i: Int) : Int = {
  if i >= string_length(s) { i }
  else { match char_at(s, i) {
    None    -> i
    Some(c) -> if char.is_alnum(c) or c == '-' or c == '_' { toml_scan_bare_key(s, i + 1) }
               else { i }
  } }
}

# ---- key = value --------------------------------------------------

fn toml_parse_kv(st: TomlSt) : Option[TomlSt] = {
  let key_end = toml_scan_bare_key(st.s, st.i)
  let eq = toml_skip_inline_ws_at(st.s, key_end)
  if key_end == st.i or not toml_char_is(st.s, eq, '=') { None }
  else {
    let key = string_slice(st.s, st.i, key_end - st.i)
    let at_val = TomlSt { ...st, i: toml_skip_inline_ws_at(st.s, eq + 1) }
    toml_parse_value(at_val).and_then(p => {
      toml_demand_eol(p.fst).and_then(e => {
        wt_edit(e.root, e.hdr, t => match wt_get(t, key) {
          None    -> Some(wt_put(t, key, WLeaf(p.snd)))
          Some(_) -> None
        }).map(r => TomlSt { ...e, root: r })
      })
    })
  }
}

# ---- Values ------------------------------------------------------
#
# Returns Pair(state-after-value, value). The caller threads state
# through demand_eol + install_kv.

fn toml_parse_value(st: TomlSt) : Option[Pair[TomlSt, TomlValue]] = {
  if st.i >= string_length(st.s) { None }
  else { char_at(st.s, st.i).and_then(
    c => {
      if c == '"' { toml_parse_string(st) }
      else if c == '[' { toml_parse_array(toml_jump(st, 1), []) }
      else if c == '{' { toml_parse_inline_table(st) }
      else if c == 't' or c == 'f' {
        let word = if c == 't' { "true" } else { "false" }
        let n = string_length(word)
        if st.i + n <= string_length(st.s) and string_slice(st.s, st.i, n) == word {
          Some(Pair { fst: toml_jump(st, n), snd: TBool(c == 't') })
        } else { None }
      }
      else if toml_is_sign_at(st.s, st.i) or char.is_digit(c) {
        toml_parse_number(st)
      }
      else { None }
    }
  ) }
}

# A number is an integer unless a fractional or exponent part
# follows its digits, in which case it is a float. A fraction is `.`
# and at least one digit; an exponent is `e` or `E`, an optional sign
# and at least one digit. `string_to_real` reads the `-` itself, so a
# leading `+` is dropped.
fn toml_parse_number(st: TomlSt) : Option[Pair[TomlSt, TomlValue]] = {
  let s = st.s
  let int_start = if toml_is_sign_at(s, st.i) { st.i + 1 } else { st.i }
  let int_end = toml_digits_end(s, int_start)
  let frac_digits = toml_digits_end(s, int_end + 1)
  let frac_end = if toml_char_is(s, int_end, '.') and frac_digits > int_end + 1 { frac_digits } else { int_end }
  let exp_start = if toml_is_sign_at(s, frac_end + 1) { frac_end + 2 } else { frac_end + 1 }
  let exp_digits = toml_digits_end(s, exp_start)
  let has_exp = (toml_char_is(s, frac_end, 'e') or toml_char_is(s, frac_end, 'E')) and exp_digits > exp_start
  let end = if has_exp { exp_digits } else { frac_end }
  if int_end == int_start { None }
  else if end == int_end {
    string_to_int(string_slice(s, int_start, int_end - int_start)).map(
      m => Pair {
        fst: toml_jump(st, int_end - st.i),
        snd: TInt(if toml_char_is(s, st.i, '-') { 0 - m } else { m })
      }
    )
  } else {
    let from = if toml_char_is(s, st.i, '+') { st.i + 1 } else { st.i }
    string_to_real(string_slice(s, from, end - from)).map(
      r => Pair { fst: toml_jump(st, end - st.i), snd: TReal(r) }
    )
  }
}

fn toml_is_sign_at(s: String, i: Int) : Bool =
  toml_char_is(s, i, '-') or toml_char_is(s, i, '+')

fn toml_char_is(s: String, i: Int, c: Char) : Bool = {
  match char_at(s, i) {
    None    -> false
    Some(x) -> x == c
  }
}

fn toml_digits_end(s: String, i: Int) : Int = {
  if i >= string_length(s) { i }
  else { match char_at(s, i) {
    None    -> i
    Some(c) -> if char.is_digit(c) { toml_digits_end(s, i + 1) } else { i }
  } }
}

fn toml_jump(st: TomlSt, n: Int) : TomlSt =
  TomlSt { ...st, i: st.i + n }

# ---- Strings (basic, single-line) ---------------------------------

fn toml_parse_string(st: TomlSt) : Option[Pair[TomlSt, TomlValue]] =
  toml_parse_string_loop(st, st.i + 1, st.i + 1, [])

# `run` starts the pending stretch of plain characters; `parts` holds
# the decoded pieces, newest first.
fn toml_parse_string_loop(st: TomlSt, i: Int, run: Int, parts: [String])
                          : Option[Pair[TomlSt, TomlValue]] = {
  if i >= string_length(st.s) { None }
  else { match char_at(st.s, i) {
    None    -> None
    Some(c) -> {
      if c == '"' {
        let done = toml_flush(st.s, run, i, parts)
        Some(Pair { fst: TomlSt { ...st, i: i + 1 }, snd: TStr(string_concat_all(list_reverse(done))) })
      } else if c == '\\' {
        match toml_escape(char_at(st.s, i + 1)) {
          None      -> None
          Some(esc) -> toml_parse_string_loop(st, i + 2, i + 2,
                         [esc, ...toml_flush(st.s, run, i, parts)])
        }
      } else if toml_is_eol(c) { None }
      else { toml_parse_string_loop(st, i + 1, run, parts) }
    }
  } }
}

# Prepends the slice `s[from, to)` to `parts` when it is non-empty.
fn toml_flush(s: String, from: Int, to: Int, parts: [String]) : [String] =
  if to > from { [string_slice(s, from, to - from), ...parts] } else { parts }

fn toml_escape(c: Option[Char]) : Option[String] = match c {
  Some('"')  -> Some("\"")
  Some('\\') -> Some("\\")
  Some('n')  -> Some("\n")
  Some('r')  -> Some("\r")
  Some('t')  -> Some("\t")
  _          -> None
}

# ---- Arrays ["a", "b"] --------------------------------------------
#
# Newlines and comments may separate elements, so a value list can
# span lines. Trailing comma accepted. Elements recurse through
# toml_parse_value, so arrays nest.

fn toml_parse_array(st: TomlSt, acc: [TomlValue]) : Option[Pair[TomlSt, TomlValue]] = {
  let st1 = toml_skip_ws_and_comments(st)
  if toml_char_is(st1.s, st1.i, ']') {
    Some(Pair { fst: toml_jump(st1, 1), snd: TArr(list_reverse(acc)) })
  } else {
    match toml_parse_value(st1) {
      None    -> None
      Some(p) -> {
        let st2 = toml_skip_ws_and_comments(p.fst)
        let more = [p.snd, ...acc]
        if toml_char_is(st2.s, st2.i, ']') {
          Some(Pair { fst: toml_jump(st2, 1), snd: TArr(list_reverse(more)) })
        } else if toml_char_is(st2.s, st2.i, ',') { toml_parse_array(toml_jump(st2, 1), more) }
        else { None }
      }
    }
  }
}

# ---- Inline tables { key = "v", k2 = "w" } ------------------------
#
# Single-line. No trailing comma. Values may not themselves be
# inline tables (this subset prohibits nesting).

fn toml_parse_inline_table(st: TomlSt) : Option[Pair[TomlSt, TomlValue]] = {
  # Cursor at `{`. Step over.
  let st1 = toml_jump(st, 1)
  let st2 = toml_skip_inline_ws_at_st(st1)
  char_at(st2.s, st2.i).and_then(
    c => if c == '}' {
      Some(Pair { fst: toml_jump(st2, 1), snd: TTbl([]) })
    } else { toml_parse_inline_pairs(st2, []) }
  )
}

fn toml_skip_inline_ws_at_st(st: TomlSt) : TomlSt = {
  let j = toml_skip_inline_ws_at(st.s, st.i)
  TomlSt { ...st, i: j }
}

fn toml_parse_inline_pairs(st: TomlSt, acc: Pairs) : Option[Pair[TomlSt, TomlValue]] = {
  let key_end = toml_scan_bare_key(st.s, st.i)
  let eq = toml_skip_inline_ws_at(st.s, key_end)
  if key_end == st.i or not toml_char_is(st.s, eq, '=') { None }
  else {
    let key = string_slice(st.s, st.i, key_end - st.i)
    let at_val = TomlSt { ...st, i: toml_skip_inline_ws_at(st.s, eq + 1) }
    toml_parse_inline_value(at_val).and_then(p => {
      let more = [Pair { fst: key, snd: p.snd }, ...acc]
      toml_inline_after_value(toml_skip_inline_ws_at_st(p.fst), more)
    })
  }
}

# After a pair: `,` continues, `}` closes.
fn toml_inline_after_value(st: TomlSt, acc: Pairs) : Option[Pair[TomlSt, TomlValue]] =
  if toml_char_is(st.s, st.i, ',') {
    toml_parse_inline_pairs(toml_skip_inline_ws_at_st(toml_jump(st, 1)), acc)
  } else if toml_char_is(st.s, st.i, '}') {
    Some(Pair { fst: toml_jump(st, 1), snd: TTbl(list_reverse(acc)) })
  } else { None }

# Inline-table value: a regular value but no `[` or `{` (no nesting).
fn toml_parse_inline_value(st: TomlSt) : Option[Pair[TomlSt, TomlValue]] =
  if toml_char_is(st.s, st.i, '[') or toml_char_is(st.s, st.i, '{') { None }
  else { toml_parse_value(st) }

# ---- Encoder ------------------------------------------------------
# Round-trips the parser's subset to a canonical form: scalar keys
# first, then `[name]` tables, then `[[name]]` arrays-of-tables. One
# key per line; original formatting and comments are NOT preserved.

#[doc("Serialises a `TomlValue` to canonical TOML text (one key per line, no comments or original formatting preserved).")]
pub fn encode(v: TomlValue) : String = {
  match v {
    TTbl(ps) -> toml_enc_doc_loop(ps, [], [])
    _        -> toml_enc_scalar(v)
  }
}

# Encode a top-level table. Walks the pairs in order; scalar pairs
# go directly, table pairs become `[name]` sections, array-of-table
# pairs become `[[name]]` sections (one per element).
# `scalars` and `sections` hold the rendered pieces, newest first.
fn toml_enc_doc_loop(ps: Pairs, scalars: [String], sections: [String]) : String =
  match ps {
    [] -> {
      let sc = string_concat_all(list_reverse(scalars))
      let se = string_concat_all(list_reverse(sections))
      if sc == "" { se }
      else if se == "" { sc }
      else { string_concat_all([sc, "\n", se]) }
    }
    [p, ...rest] -> match p.snd {
      TTbl(t) -> toml_enc_doc_loop(rest, scalars, [toml_enc_table("[", "]\n", p.fst, t), ...sections])
      TArr(xs) -> if all_tables(xs) {
        toml_enc_doc_loop(rest, scalars, [string_concat_all(list.map(xs, (x) => match x {
          TTbl(t) -> toml_enc_table("[[", "]]\n", p.fst, t)
          _       -> ""
        })), ...sections])
      } else { toml_enc_doc_loop(rest, [toml_enc_scalar_line(p.fst, p.snd), ...scalars], sections) }
      _ -> toml_enc_doc_loop(rest, [toml_enc_scalar_line(p.fst, p.snd), ...scalars], sections)
    }
  }

fn all_tables(xs: [TomlValue]) : Bool = {
  match xs {
    [] -> true
    [x, ...rest] -> match x {
      TTbl(_) -> all_tables(rest)
      _       -> false
    }
  }
}

fn toml_enc_scalar_line(k: String, v: TomlValue) : String =
  string_concat_all([k, " = ", toml_enc_scalar(v), "\n"])

# Inside a [section], scalars are flat; nested tables become inline
# tables (the parser only accepts one section level deep).
fn toml_enc_table(open: String, close: String, name: String, ps: Pairs) : String =
  string_concat_all([open, name, close,
    string_concat_all(list.map(ps, (p) => toml_enc_scalar_line(p.fst, p.snd))), "\n"])

# Encode a single value as it appears on the right-hand side of
# `key = ...`. Inline tables and arrays are single-line.
fn toml_enc_scalar(v: TomlValue) : String = {
  match v {
    TStr(s)  -> string_concat_all(["\"", string_concat_all(list_reverse(toml_enc_str_escape(s, 0, 0, []))), "\""])
    TBool(b) -> if b { "true" } else { "false" }
    TInt(n)  -> int_to_string(n)
    TReal(r) -> toml_enc_real(r)
    TArr(xs) -> string_concat_all(["[", string.join(list.map(xs, toml_enc_scalar), ", "), "]"])
    TTbl(ps) -> string_concat_all(["{ ", string.join(list.map(ps,
                  (p) => string_concat_all([p.fst, " = ", toml_enc_scalar(p.snd)])), ", "), " }"])
  }
}

# A TOML float needs a `.` or an exponent; `real_to_string` drops
# both for integral values, which would re-decode as an integer.
fn toml_enc_real(r: Real) : String = {
  if real_is_nan(r) { "nan" }
  else if real_is_inf(r) { if r < 0.0 { "-inf" } else { "inf" } }
  else {
    let s = real_to_string(r)
    if toml_has_real_mark(s, 0) { s } else { string_concat(s, ".0") }
  }
}

fn toml_has_real_mark(s: String, i: Int) : Bool = {
  if i >= string_length(s) { false }
  else { match char_at(s, i) {
    None    -> false
    Some(c) -> if c == '.' or c == 'e' or c == 'E' { true }
               else { toml_has_real_mark(s, i + 1) }
  } }
}

fn toml_enc_str_escape(s: String, i: Int, run: Int, parts: [String]) : [String] = {
  if i >= string_length(s) { toml_flush(s, run, i, parts) }
  else { match char_at(s, i) {
    None    -> toml_flush(s, run, i, parts)
    Some(c) -> {
      let esc =
        if c == '"'      { "\\\"" }
        else if c == '\\' { "\\\\" }
        else if c == '\n' { "\\n" }
        else if c == '\r' { "\\r" }
        else if c == '\t' { "\\t" }
        else { "" }
      if esc == "" { toml_enc_str_escape(s, i + 1, run, parts) }
      else { toml_enc_str_escape(s, i + 1, i + 1, [esc, ...toml_flush(s, run, i, parts)]) }
    }
  } }
}

#[doc("Round-trip helper: parse → encode for tests + lockfile rewriting.")]
pub fn round_trip(src: String) : Option[String] = {
  decode(src).map(v => encode(v))
}
