#[doc("""
RE2-style regular expressions.

Pure kaikai NFA set-of-states simulation: one pass over the input,
with a new thread entering at each position until a match is found.
RE2-compatible subset:
  - Char literals + escapes (\\d \\w \\s . \\n \\t \\\\ \\/).
  - Character classes [abc], [^abc], [a-z], [0-9].
  - Anchors ^ $.
  - Greedy quantifiers * + ? {n} {n,} {n,m}.
  - Groups (...) capturing, (?:...) non-capturing.
  - Alternation a|b.

Matching is by codepoint; match offsets are byte offsets. Repeat
counts above 1000 and inverted class ranges are compile errors.

Out of scope: backreferences, lookaround, Unicode property
classes, non-greedy quantifiers, named captures, inline flags.

`regexp.match` does not exist — `match` is a keyword; the operation
is `find`. Bare names like `compile` / `split` are heavily shadowed,
so call sites should use the qualified form.
""")]


import regexp.engine
import regexp.syntax

# Positions are byte offsets that always sit on a codepoint boundary.
fn rx_cp_at(s: String, i: Int) : Char = int_to_char(string_cp_at(s, i))

# Byte offset following the codepoint at `i`; past the end it moves one byte.
fn rx_next_pos(s: String, i: Int) : Int =
  if i >= string_length(s) { i + 1 } else { i + string_cp_len(s, i) }

# ====================================================================
# NFA simulation (set-of-states, leftmost-longest)
# ====================================================================
#
# Pike-style simulator. Each *thread* is a (state_id, captures) pair.
# At every input position we run an ε-closure over the active set,
# then consume one input char with TChar / TClass / TAny edges. The
# threadset is deduped by state_id (first thread to reach a given
# state wins — gives the leftmost-longest semantics RE2 promises).
#
# Capture tracking: each thread carries an immutable map
# `[Capture]` where Capture is `(group_id, start, end)`. TGroupOpen
# bumps the start; TGroupClose bumps the end. Group 0 is reserved
# for the whole-match span and is initialised when the seed thread
# is built.
#
# leftmost-longest: the start closest to the left that matches wins,
# and among its matches the longest.

#[doc("""
Captured span. `start == -1` means the group has not opened yet
along this thread; `end == -1` means it opened but did not close.
""")]
pub type Capture = { group_id: Int, start: Int, end: Int }

#[doc("A successful match: the matched span (byte offsets `start`..`end`) and its capture groups.")]
pub type Match = { start: Int, end: Int, groups: [Capture] }

# Thread record: which NFA state and the per-thread capture stack.
type Thread = { state_id: Int, captures: [Capture] }

fn rx_capture_close(caps: [Capture], gid: Int, pos: Int) : [Capture] =
  rx_capture_set(caps, gid, -1, pos, false)

fn rx_capture_set(caps: [Capture], gid: Int, start_v: Int, end_v: Int, is_open: Bool) : [Capture] =
  rx_capture_set_loop(caps, gid, start_v, end_v, is_open, [])

# `before` holds the captures already passed, newest first.
fn rx_capture_set_loop(caps: [Capture], gid: Int, start_v: Int, end_v: Int, is_open: Bool,
                       before: [Capture]) : [Capture] = match caps {
  [] -> rx_caps_rebuild(before,
    if is_open { [Capture { group_id: gid, start: start_v, end: end_v }] }
    else       { [Capture { group_id: gid, start: -1, end: end_v }] })
  [c, ...rest] ->
    if c.group_id == gid {
      let new_c = if is_open {
        Capture { group_id: gid, start: start_v, end: c.end }
      } else {
        Capture { group_id: gid, start: c.start, end: end_v }
      }
      rx_caps_rebuild(before, [new_c, ...rest])
    } else {
      rx_capture_set_loop(rest, gid, start_v, end_v, is_open, [c, ...before])
    }
}

# Puts `before` (newest first) back in front of `tail`, oldest first.
fn rx_caps_rebuild(before: [Capture], tail: [Capture]) : [Capture] = match before {
  []           -> tail
  [c, ...more] -> rx_caps_rebuild(more, [c, ...tail])
}

# ---- Search ----

# The input, the NFA and its states indexed by id.
type RxSim = { nfa: Nfa, tbl: Vec[NfaState], input: String, n: Int }

fn rx_sim(nfa: Nfa, input: String) : RxSim =
  RxSim { nfa: nfa, tbl: rx_fill_table(nfa.states, vec_make(rx_max_id(nfa.states, 0) + 1, NfaState { id: -1, transitions: [], accept: false })), input: input, n: string_length(input) }

fn rx_max_id(states: [NfaState], best: Int) : Int = match states {
  []           -> best
  [s, ...rest] -> rx_max_id(rest, if s.id > best { s.id } else { best })
}

fn rx_fill_table(states: [NfaState], tbl: Vec[NfaState]) : Vec[NfaState] = match states {
  []           -> tbl
  [s, ...rest] -> rx_fill_table(rest, vec_set(tbl, s.id, s))
}

#[doc("""
Simulate `nfa` over `input`. Returns Some(Match) at the leftmost
position with the longest extent, or None if no match exists.
""")]
pub fn simulate(nfa: Nfa, input: String) : Option[Match] = rx_search(rx_sim(nfa, input), 0)

# Leftmost-longest match starting at or after `from_pos`, in one pass:
# a fresh thread enters at every position until some thread accepts, and
# threads that started later than the best match are dropped. A thread
# that started earlier keeps running, since it would win if it accepts.
fn rx_search(sim: RxSim, from_pos: Int) : Option[Match] =
  if from_pos > sim.n { None }
  else { rx_search_loop(sim, from_pos, [], None, vec_make(vec_length(sim.tbl), -1)) }

# `stepped` holds the threads already advanced to `pos`, before their
# ε-closure; `seen` stamps the states the closure at `pos` has reached.
fn rx_search_loop(sim: RxSim, pos: Int, stepped: [Thread], best: Option[Match],
                  seen: Vec[Int]) : Option[Match] = {
  let seed = match best {
    None    -> [Thread { state_id: sim.nfa.start, captures: [Capture { group_id: 0, start: pos, end: -1 }] }]
    Some(_) -> []
  }
  let old = rx_closure(sim, stepped, [], [], seen, pos)
  let fresh = rx_closure(sim, seed, [], [], old.seen, pos)
  let cl = RxClosed { threads: list_append(old.threads, fresh.threads), seen: fresh.seen }
  let best1 = match rx_pick_accept(sim, cl.threads, pos) {
    None    -> best
    Some(h) -> match best {
      None    -> Some(h)
      Some(b) -> if h.start <= b.start { Some(h) } else { best }
    }
  }
  let live = match best1 {
    None    -> cl.threads
    Some(b) -> rx_started_by(cl.threads, b.start)
  }
  let done = match best1 {
    Some(_) -> list.is_empty(live)
    None    -> false
  }
  if pos >= sim.n or done { best1 }
  else {
    rx_search_loop(sim, rx_next_pos(sim.input, pos), rx_step(sim, live, rx_cp_at(sim.input, pos), []), best1, cl.seen)
  }
}

fn rx_started_by(threads: [Thread], start: Int) : [Thread] =
  rx_started_by_loop(threads, start, [])

fn rx_started_by_loop(threads: [Thread], start: Int, kept: [Thread]) : [Thread] = match threads {
  []           -> list_reverse(kept)
  [t, ...rest] -> if rx_match_start(t.captures) <= start { rx_started_by_loop(rest, start, [t, ...kept]) }
                  else { rx_started_by_loop(rest, start, kept) }
}

# The first thread in an accept state, as a Match closed at `end_pos`.
fn rx_pick_accept(sim: RxSim, threads: [Thread], end_pos: Int) : Option[Match] = match threads {
  []           -> None
  [t, ...rest] ->
    if vec_get(sim.tbl, t.state_id).accept {
      let caps = rx_capture_close(t.captures, 0, end_pos)
      Some(Match { start: rx_match_start(caps), end: end_pos, groups: caps })
    } else { rx_pick_accept(sim, rest, end_pos) }
}

fn rx_match_start(caps: [Capture]) : Int = match caps {
  [] -> 0
  [c, ...rest] -> if c.group_id == 0 { c.start } else { rx_match_start(rest) }
}

# ---- ε-closure ----
#
# Expand the threadset over zero-width transitions:
# TEpsilon, TGroupOpen, TGroupClose, TAnchor (when satisfied at pos).
# Anchors that don't match at the current position simply don't
# expand — the thread stays where it is, but no new edge fires.
#
# Dedup: when a thread arrives at a state that already has a
# representative in the closure, the *first* representative wins.
# Pike-style. This keeps the threadset bounded by the number of
# NFA states.

type RxClosed = { threads: [Thread], seen: Vec[Int] }

# Breadth-first worklist, the queue being `front` then `back` reversed:
# pop a thread, if its state is not yet in the closure add it and queue
# its zero-width neighbours. Order is preserved so leftmost-priority is
# naturally the seed order. `closure` is newest first.
fn rx_closure(sim: RxSim, front: [Thread], back: [Thread], closure: [Thread],
              seen: Vec[Int], pos: Int) : RxClosed = match front {
  [] -> match back {
    [] -> RxClosed { threads: list_reverse(closure), seen: seen }
    _  -> rx_closure(sim, list_reverse(back), [], closure, seen, pos)
  }
  [t, ...rest] ->
    if vec_get(seen, t.state_id) == pos { rx_closure(sim, rest, back, closure, seen, pos) }
    else {
      let trs = vec_get(sim.tbl, t.state_id).transitions
      rx_closure(sim, rest, rx_zero_width_targets(trs, t.captures, sim.n, pos, back), [t, ...closure],
                 vec_set(seen, t.state_id, pos), pos)
    }
}

# Pushes `xs` onto the reversed list `acc`, first element deepest.
fn rx_push_all(xs: [Thread], acc: [Thread]) : [Thread] = match xs {
  []           -> acc
  [x, ...rest] -> rx_push_all(rest, [x, ...acc])
}

# Push every zero-width transition's target onto the reversed list
# `acc` as a new thread, updating captures appropriately. TAnchor only
# contributes when the anchor condition holds at `pos`.
fn rx_zero_width_targets(trs: [NfaTransition], caps: [Capture],
                          n: Int, pos: Int, acc: [Thread]) : [Thread] = match trs {
  [] -> acc
  [t, ...rest] -> {
    let mine = match t {
      TEpsilon(dst) -> [Thread { state_id: dst, captures: caps }]
      TGroupOpen(gid, dst) ->
        [Thread { state_id: dst, captures: rx_capture_set(caps, gid, pos, -1, true) }]
      TGroupClose(gid, dst) ->
        [Thread { state_id: dst, captures: rx_capture_close(caps, gid, pos) }]
      TAnchor(an, dst) -> match an {
        AnchorStart -> if pos == 0 { [Thread { state_id: dst, captures: caps }] } else { [] }
        AnchorEnd   -> if pos >= n { [Thread { state_id: dst, captures: caps }] } else { [] }
      }
      _ -> []
    }
    rx_zero_width_targets(rest, caps, n, pos, rx_push_all(mine, acc))
  }
}

# ---- Step ----
#
# For each thread, try every consuming transition (TChar / TClass /
# TAny) against the current character. Order is preserved so the next
# ε-closure dedup keeps leftmost priority.

fn rx_step(sim: RxSim, threads: [Thread], c: Char, acc: [Thread]) : [Thread] = match threads {
  [] -> list_reverse(acc)
  [t, ...rest] -> {
    let trs = vec_get(sim.tbl, t.state_id).transitions
    rx_step(sim, rest, c, rx_step_thread(trs, t.captures, c, acc))
  }
}

fn rx_step_thread(trs: [NfaTransition], caps: [Capture], c: Char, acc: [Thread]) : [Thread] = match trs {
  [] -> acc
  [t, ...rest] -> {
    let mine = match t {
      TChar(ch, dst) ->
        if ch == c { [Thread { state_id: dst, captures: caps }] } else { [] }
      TClass(ranges, neg, dst) ->
        if rx_class_matches(ranges, c) != neg { [Thread { state_id: dst, captures: caps }] }
        else { [] }
      TAny(dst) ->
        # `.` matches any char EXCEPT newline (Perl/RE2 default).
        if c == '\n' { [] } else { [Thread { state_id: dst, captures: caps }] }
      _ -> []
    }
    rx_step_thread(rest, caps, c, rx_push_all(mine, acc))
  }
}

fn rx_class_matches(ranges: [CharRange], c: Char) : Bool = match ranges {
  [] -> false
  [r, ...rest] -> match r {
    CR(lo, hi) ->
      if char_to_int(c) >= char_to_int(lo) and char_to_int(c) <= char_to_int(hi) { true }
      else { rx_class_matches(rest, c) }
  }
}

# ====================================================================
# Public API
# ====================================================================
#
# Opaque `Regex` carrier wrapping a compiled `Nfa`. The lowercase
# name is the public surface; the parser/NFA/simulator types stay
# exported for power users (debugging, custom drivers) but are not
# expected to be touched by typical code.

#[doc("An opaque compiled regular expression, wrapping its NFA. Build one with `compile`.")]
pub type Regex = R(Nfa)

#[doc("""
Compile a pattern string. The error variant carries a
human-readable message — the caller does not need to know about
RxParseError's internals.
""")]
pub fn compile(pattern: String) : Result[Regex, String] =
  match parse_pattern(pattern) {
    Err(e) -> match e {
      RxParseError { msg: m, pos: p } ->
        Err(string_concat_all(["regex parse error at ", int_to_string(p), ": ", m]))
    }
    Ok(ast) -> Ok(R(compile_nfa(ast)))
  }

#[doc("Find the first (leftmost-longest) match of `re` in `s`.")]
pub fn find(re: Regex, s: String) : Option[Match] = match re {
  R(nfa) -> simulate(nfa, s)
}

#[doc("""
Find every non-overlapping match. Zero-width matches advance the
scan cursor by one character so we don't loop forever on
patterns like `a*` against `bbb`.
""")]
pub fn find_all(re: Regex, s: String) : [Match] = match re {
  R(nfa) -> rx_find_all_loop(rx_sim(nfa, s), 0, [])
}

fn rx_find_all_loop(sim: RxSim, from_pos: Int, acc: [Match]) : [Match] = {
  if from_pos > sim.n { list_reverse(acc) }
  else { match rx_search(sim, from_pos) {
    None -> list_reverse(acc)
    Some(m) -> {
      rx_find_all_loop(sim, rx_after(sim, m), [m, ...acc])
    }
  } }
}

# Where the scan resumes after `m`: its end, or the next codepoint when
# the match is empty.
fn rx_after(sim: RxSim, m: Match) : Int =
  if m.end > m.start { m.end } else { rx_next_pos(sim.input, m.start) }

#[doc("""
Replace every non-overlapping match with `replacement`. The
replacement supports `$0` (whole match) and `$1`..`$9` (numbered
groups). Use `$$` for a literal `$`.
""")]
pub fn replace(re: Regex, s: String, replacement: String) : String = match re {
  R(nfa) -> string_concat_all(list_reverse(rx_replace_loop(rx_sim(nfa, s), replacement, 0, [])))
}

# `parts` holds the output pieces, newest first.
fn rx_replace_loop(sim: RxSim, repl: String, from_pos: Int, parts: [String]) : [String] = {
  if from_pos > sim.n { parts }
  else { match rx_search(sim, from_pos) {
    None -> [string_slice(sim.input, from_pos, sim.n - from_pos), ...parts]
    Some(m) -> {
      # Source [from_pos..m.start) verbatim, then the expanded
      # replacement. Advance to m.end (or +1 on a zero-width match).
      let prefix = string_slice(sim.input, from_pos, m.start - from_pos)
      let parts1 = [string_concat_all(list_reverse(rx_expand_loop(repl, 0, string_length(repl), m, sim.input, []))), prefix, ...parts]
      let next = rx_after(sim, m)
      # Zero-width: also copy the skipped char so it is not lost.
      let parts2 = if m.end == m.start and m.start < sim.n {
        [string_slice(sim.input, m.start, next - m.start), ...parts1]
      } else { parts1 }
      rx_replace_loop(sim, repl, next, parts2)
    }
  } }
}

# Expand $N back-references in `repl` against the captured groups.
# `$$` -> literal `$`. Unknown groups expand to the empty string
# (mirrors most engines' lenient behaviour). Works byte by byte, which
# keeps multibyte text intact.
fn rx_expand_loop(repl: String, i: Int, n: Int, m: Match, src: String, parts: [String]) : [String] =
  if i >= n { parts }
  else { match char_at(repl, i) {
    None      -> parts
    Some('$') -> rx_expand_ref(repl, i + 1, n, m, src, parts)
    Some(c)   -> rx_expand_loop(repl, i + 1, n, m, src, [int_to_byte_string(char_to_int(c)), ...parts])
  } }

# `i` is the offset just after a `$`.
fn rx_expand_ref(repl: String, i: Int, n: Int, m: Match, src: String, parts: [String]) : [String] =
  if i >= n { ["$", ...parts] }
  else { match char_at(repl, i) {
    None      -> ["$", ...parts]
    Some('$') -> rx_expand_loop(repl, i + 1, n, m, src, ["$", ...parts])
    Some(c)   ->
      if char.is_digit(c) {
        let gid = char_to_int(c) - char_to_int('0')
        rx_expand_loop(repl, i + 1, n, m, src, [rx_group_span(m.groups, gid, src), ...parts])
      } else {
        rx_expand_loop(repl, i + 1, n, m, src, [int_to_byte_string(char_to_int(c)), "$", ...parts])
      }
  } }

# Look up a captured span by group id. Missing or never-closed
# groups expand to the empty string.
fn rx_group_span(caps: [Capture], gid: Int, src: String) : String = match caps {
  [] -> ""
  [c, ...rest] ->
    if c.group_id == gid {
      if c.start >= 0 and c.end >= 0 and c.end >= c.start {
        string_slice(src, c.start, c.end - c.start)
      } else { "" }
    } else { rx_group_span(rest, gid, src) }
}

#[doc("""
Split `s` at every non-overlapping match of `re`. The match
itself is excluded from the output (mirrors Python `re.split`).
An empty match also cuts, so `"abc"` split by `"x*"` yields
`["", "a", "b", "c", ""]`. Leading and trailing empty segments are
kept.
""")]
pub fn split(re: Regex, s: String) : [String] = match re {
  R(nfa) -> rx_split_loop(rx_sim(nfa, s), 0, 0, [])
}

# `seg` is where the current segment starts; `from_pos` where the scan resumes.
fn rx_split_loop(sim: RxSim, seg: Int, from_pos: Int, acc: [String]) : [String] = {
  if from_pos > sim.n { rx_split_done(sim, seg, acc) }
  else { match rx_search(sim, from_pos) {
    None    -> rx_split_done(sim, seg, acc)
    Some(m) -> rx_split_loop(sim, m.end, rx_after(sim, m), [string_slice(sim.input, seg, m.start - seg), ...acc])
  } }
}

fn rx_split_done(sim: RxSim, seg: Int, acc: [String]) : [String] =
  list_reverse([string_slice(sim.input, seg, sim.n - seg), ...acc])

#[doc("""
The runtime carrier of the `~r/pattern/` regex sigil, which the
compiler desugars to `compile_or_panic("pattern")`.

By the time it runs the parser has already accepted the literal, so
an `Err` from `compile` means the supported-subset doc and the
engine disagree — a compiler bug worth crashing on, not a
recoverable error worth threading through `Result`.
""")]
pub fn compile_or_panic(pattern: String) : Regex = match compile(pattern) {
  Err(msg) -> panic(string_concat("invalid regex sigil: ", msg))
  Ok(re)   -> re
}

#[doc("""
The predicate-pure refinement-side primitive. Returns true iff the
*entire* string `s` matches `re` (full match, not substring). The
typical use is `String where matches ~r/^[a-z]+$/`; the parser's
refinement-predicate sugar elides the `self` receiver so the source
reads identically to the spec.
""")]
pub fn matches(s: String, re: Regex) : Bool = match find(re, s) {
  None    -> false
  Some(m) -> m.start == 0 and m.end == string_length(s)
}
