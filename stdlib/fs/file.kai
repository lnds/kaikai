#[doc("""
File-level wrappers on top of the core `read_file` / `write_file`
builtins. Module path: `import fs.file`.

Bare `read_file` / `write_file` stay bound to the `Result`-returning
core builtins; the wrappers here are the panicking, ergonomic
surface, reached qualified (`file.read`).
""")]

import time

#[doc("""
Read the entire file at `path` and return its contents as a
`String`. Panics on any I/O failure (file missing, permission
denied, read short). Use the core `read_file(path)` directly
when you want to handle errors.
""")]
pub fn read(path: String) : String / File =
  match read_file(path) {
    Ok(s) -> s
    Err(e) -> panic(string_concat("file.read: ", e))
  }

#[doc("""
Write `content` to `path`, overwriting any existing contents.
Panics on any I/O failure. Use the core `write_file(path, c)`
directly when you want to handle errors.
""")]
pub fn write(path: String, content: String) : Unit / File =
  match write_file(path, content) {
    Ok(_)  -> ()
    Err(_) -> panic("file.write: write failed")
  }

#[doc("""
Append `content` to the end of `path`. Creates the file when it
does not exist. Opens with `O_APPEND` and writes only `content`, so the
cost does not grow with the file and each call lands at the end even
with several writers. Panics on any I/O failure.
""")]
pub fn append(path: String, content: String) : Unit / File =
  match file_append(path, content) {
    Ok(_)  -> ()
    Err(_) -> panic("file.append: write failed")
  }

# The wrappers (`exists`/`delete`/`rename`) call the `file_`-prefixed
# core builtins directly without self-recursing, since the short
# wrapper names do not shadow the prefixed builtins.

#[doc("True when `path` exists on the filesystem.")]
pub fn exists(path: String) : Bool / File =
  file_exists(path)

#[doc("Deletes the file at `path`, returning `Err(message)` on failure.")]
pub fn delete(path: String) : Result[Unit, String] / File =
  file_delete(path)

#[doc("Renames (or moves) `from` to `to`, returning `Err(message)` on failure.")]
pub fn rename(from: String, to: String) : Result[Unit, String] / File =
  file_rename(from, to)

#[doc("""
Read the file at `path` as a raw `Array[Byte]` buffer, returning
`Err(message)` on failure.

Round-trips arbitrary bytes (including 0x00 and 0xFF) that the
String-based `read_file` cannot carry through interpolation.
""")]
pub fn read_bytes(path: String) : Result[Array[Byte], String] / File =
  file_read_bytes(path)

#[doc("Writes the raw byte buffer to `path` (truncating any existing file), returning `Err(message)` on failure.")]
pub fn write_bytes(path: String, buf: Array[Byte]) : Result[Unit, String] / File =
  file_write_bytes(path, buf)

#[doc("Size in bytes, modification time and kind of a file, as reported by the OS.")]
pub type FileMetadata = { size: Int, modified: WallTime, is_dir: Bool, is_file: Bool }

#[doc("The metadata of `path`, following symlinks; `Err` names the path and the OS reason.")]
pub fn metadata(path: String) : Result[FileMetadata, String] / File =
  match file_metadata(path) {
    Ok([size, secs, nanos, dir, file]) -> Ok(FileMetadata {
      size: size,
      modified: WallTime { secs: secs, nanos: nanos },
      is_dir: dir == 1,
      is_file: file == 1
    })
    Ok(_)  -> Err("file.metadata: malformed runtime reply")
    Err(e) -> Err(e)
  }
