#[doc("""
Directory operations on top of the `File` effect. Module path:
`import fs.dir`.

`list_dir` / `walk` are total over `[String]`: a read error (path
missing, permission denied) returns the empty list rather than
raising. `walk` reports only regular files: symlinks of every kind
are skipped and never followed, and directories are not reported.
`list_entries` carries each entry's kind and returns `Err` when the
directory cannot be read; `walk_with` returns the entries themselves.
""")]

#[doc("What a directory entry is, as the OS reports it without following links.")]
pub type EntryKind = EntryFile | EntryDir | EntrySymlink | EntryOther

#[doc("A directory entry: its `name`, its `path` (the listed directory joined with `name`) and its `kind`.")]
pub type DirEntry = { name: String, path: String, kind: EntryKind }

#[doc("Lists a directory's entries with their kind, taken from the directory read and without following links (excluding `.` and `..`); `Err` carries the OS reason.")]
pub fn list_entries(path: String) : Result[[DirEntry], String] / File =
  match dir_list_entries(path) {
    Ok(raw) -> Ok(raw | (r => decode_entry(path, r)))
    Err(e) -> Err(e)
  }

fn decode_entry(dir: String, raw: String) : DirEntry {
  let name = string.slice(raw, 1, string.length(raw) - 1)
  let kind = match string.slice(raw, 0, 1) {
    "f" -> EntryFile
    "d" -> EntryDir
    "l" -> EntrySymlink
    _ -> EntryOther
  }
  let full = if string.ends_with(dir, "/") { dir ++ name } else { dir ++ "/" ++ name }
  DirEntry { name: name, path: full, kind: kind }
}

#[doc("Lists a directory's entries (excluding `.` and `..`); returns `[]` on a read error, so use `list_entries` to see the error.")]
pub fn list_dir(path: String) : [String] / File =
  dir_list_dir(path)

#[doc("Creates a directory with mode 0755, returning `Err(message)` on failure.")]
pub fn create_dir(path: String) : Result[Unit, String] / File =
  dir_create_dir(path)

#[doc("Removes an empty directory, returning `Err(message)` on failure.")]
pub fn remove_dir(path: String) : Result[Unit, String] / File =
  dir_remove_dir(path)

#[doc("Recursively lists regular files under `path`, depth-first; every symlink is skipped and none is followed; unreadable directories are dropped and `[]` is returned for an unreadable root, so use `walk_with` to see the errors.")]
pub fn walk(path: String) : [String] / File =
  dir_walk(path)

#[doc("""
Recursively lists the entries under `path`, depth-first, skipping every
directory for which `descend` returns false. `descend` sees each real
directory entry once; a skipped directory is not read.

A symbolic link is never followed: a link to a directory is not
descended into and is not reported as a directory. Every other
entry that is not a directory, symlinks of any target included
(dangling ones too), is returned as a `DirEntry` with its own path
and kind, so a caller tells links apart without another lstat.

Every directory that cannot be read, the root included, comes back as
one `Err("<dir>: <OS reason>")` and the walk goes on with its siblings.
""")]
pub fn walk_with[e](
  path: String,
  descend: (DirEntry) -> Bool / e
) : [Result[DirEntry, String]] / File + e =
  walk_dirs([path], descend, [])

fn walk_dirs[e](
  pending: [String],
  descend: (DirEntry) -> Bool / e,
  acc: [Result[DirEntry, String]]
) : [Result[DirEntry, String]] / File + e =
  match pending {
    [] -> list_reverse(acc)
    [d, ...rest] -> match list_entries(d) {
      Err(msg) -> walk_dirs(rest, descend, [Err(msg), ...acc])
      Ok(entries) -> scan_entries(entries, descend, rest, acc, [])
    }
  }

fn scan_entries[e](
  entries: [DirEntry],
  descend: (DirEntry) -> Bool / e,
  rest: [String],
  acc: [Result[DirEntry, String]],
  subdirs: [String]
) : [Result[DirEntry, String]] / File + e =
  match entries {
    [] -> walk_dirs(list_append(list_reverse(subdirs), rest), descend, acc)
    [en, ...more] -> match en.kind {
      EntryDir -> if descend(en) {
        scan_entries(more, descend, rest, acc, [en.path, ...subdirs])
      } else {
        scan_entries(more, descend, rest, acc, subdirs)
      }
      _ -> scan_entries(more, descend, rest, [Ok(en), ...acc], subdirs)
    }
  }

#[doc("The process working directory; `Err` carries the OS reason.")]
pub fn current() : Result[String, String] / File =
  dir_current_dir()

#[doc("The directory for temporary files: `$TMPDIR` when set and non-empty, else `/tmp`.")]
pub fn temp_dir() : String / File =
  dir_temp_dir()
