#[doc("""
Path helpers. Module path: `import fs.path`.

The `path_*` helpers (`path_join`, `path_dirname`, `path_basename`,
`path_ext`, `path_strip_ext`, `path_split`, `path_is_absolute`) live
in `stdlib/path.kai`, which is auto-loaded so every program has them
as flat names. Callers reach them as `path.join(a, b)` (qualified) or
`path_join(a, b)` (flat); both resolve to the same implementation.

`normalize` lives here and is compiled only when `fs.path` is imported.
""")]

# End (exclusive) of the component starting at `i`.
fn component_end(s: String, i: Int, n: Int) : Int =
  if i >= n or string_byte_at_int(s, i) == 47 { i } else { component_end(s, i + 1, n) }

# `stack` holds the kept components, innermost first.
fn normalize_loop(s: String, i: Int, n: Int, stack: [String], abs: Bool) : [String] =
  if i >= n {
    stack
  } else if string_byte_at_int(s, i) == 47 {
    normalize_loop(s, i + 1, n, stack, abs)
  } else {
    let j = component_end(s, i, n)
    let comp = string_slice(s, i, j - i)
    let next = if comp == "." {
      stack
    } else if comp == ".." {
      match stack {
        [] -> if abs { [] } else { [".."] }
        [top, ...rest] -> if top == ".." { ["..", ...stack] } else { rest }
      }
    } else {
      [comp, ...stack]
    }
    normalize_loop(s, j, n, next, abs)
  }

#[doc("""
Lexical clean-up of `p`, with no file system access: repeated `/` collapse,
`.` is dropped and `..` cancels the component before it. A `..` with
nothing to cancel stays in a relative path and is dropped at the root of an
absolute one. `normalize("") == "."`, `normalize("//a//b/") == "/a/b"`,
`normalize("a/../..") == ".."`, `normalize("/../a") == "/a"`.

It can differ from `file.canonicalize` when a component is a symlink,
because `a/link/..` is not `a` once `link` points elsewhere.
""")]
pub fn normalize(p: String) : String {
  let abs = string.starts_with(p, "/")
  let parts = list_reverse(normalize_loop(p, 0, string_length(p), [], abs))
  let body = string_join(parts, "/")
  if abs {
    string_concat("/", body)
  } else if string_length(body) == 0 {
    "."
  } else {
    body
  }
}
