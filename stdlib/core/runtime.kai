#[doc("core.runtime — collection and mailbox primitives the runtime implements.")]

#[doc("An empty array.")]
extern "kai"("kai_core_array_empty") pub fn array_empty[a]() : Array[a]
#[doc("True when `a` and `b` are the same array.")]
extern "kai"("kai_core_array_same") pub fn array_same[a](a: Array[a], b: Array[a]) : Bool

#[doc("Delivers `m` to the mailbox `p`.")]
extern "kai"("kai_core_mailbox_send") pub fn mailbox_send[a](p: Pid[a], m: a) : Unit
#[doc("The next message of the mailbox `p`, waiting for one.")]
extern "kai"("kai_core_mailbox_recv") pub fn mailbox_recv[a](p: Pid[a]) : a
#[doc("The next message of `p`, or None after `ns` nanoseconds.")]
extern "kai"("kai_core_mailbox_recv_timeout") pub fn mailbox_recv_timeout[a](p: Pid[a], ns: Int) : Option[a]
#[doc("Releases the mailbox `p`.")]
extern "kai"("kai_core_mailbox_free") pub fn mailbox_free[a](p: Pid[a]) : Unit
#[doc("Makes the fiber `f` the owner of the mailbox `p`.")]
extern "kai"("kai_core_mailbox_assign_owner") pub fn mailbox_assign_owner[a, b](p: Pid[a], f: Fiber[b]) : Unit

#[doc("Folds `xs` into `init` with `f`, left to right.")]
extern "kai"("kai_core_reduce") pub fn reduce[a, b, e](xs: [a], init: b, f: (b, a) -> b / e) : b / e
#[doc("Applies `f` to `x`; the entry the derived JSON shapes call.")]
extern "kai"("kai_core___deep_apply1") pub fn __deep_apply1[a, b, e](x: a, f: (a) -> b / e) : b / e
#[doc("Applies `f` to `x` and `y`; the entry the derived JSON shapes call.")]
extern "kai"("kai_core___deep_apply2") pub fn __deep_apply2[a, b, c, e](x: a, y: b, f: (a, b) -> c / e) : c / e
