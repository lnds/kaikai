#[doc("""core.char_unicode — case folding beyond ASCII, over the alphabets whose
upper/lower mapping is a uniform codepoint offset: Latin-1 Supplement, Latin
Extended-A, Greek, and Cyrillic.

`core.char` folds ASCII only. These functions extend that to the scripts
where the mapping is 1:1 and offset-uniform, which covers most European text
without carrying a Unicode table.

What they deliberately do NOT handle: full case folding, where one character
maps to several (`ß` → `ss`), and context-sensitive mapping, where the result
depends on position in the word (Greek final sigma `Σ` → `ς` at word end,
`σ` elsewhere — these map `Σ` to `σ` unconditionally). Text that needs either
wants a real Unicode implementation, not this.""")]

# Uppercase Latin-1 letters are `lower - 32`, but the range is not contiguous:
# 0xD7 (multiplication sign) sits between the letters and is not one.
const LATIN1_UPPER_LO : Int = 0xC0
const LATIN1_UPPER_HI : Int = 0xDE
const LATIN1_LOWER_LO : Int = 0xE0
const LATIN1_LOWER_HI : Int = 0xFE
const LATIN1_TIMES    : Int = 0xD7
const LATIN1_DIVIDE   : Int = 0xF7

# Latin Extended-A pairs even/odd (0x100 'Ā' / 0x101 'ā', …) through 0x177.
const LATIN_EXT_A_LO : Int = 0x100
const LATIN_EXT_A_HI : Int = 0x177

const GREEK_UPPER_LO : Int = 0x391
const GREEK_UPPER_HI : Int = 0x3A9
const GREEK_LOWER_LO : Int = 0x3B1
const GREEK_LOWER_HI : Int = 0x3C9
# 0x3A2 is unassigned — the gap where final sigma's uppercase would be.
const GREEK_GAP : Int = 0x3A2
# Final sigma lowercases to itself but uppercases to the one sigma.
const GREEK_FINAL_SIGMA : Int = 0x3C2
const GREEK_SIGMA       : Int = 0x3A3

# Cyrillic runs in two blocks: 0x400–0x40F pairs with 0x450–0x45F (offset 80),
# and 0x410–0x42F with 0x430–0x44F (offset 32).
const CYR_EXT_UPPER_LO : Int = 0x400
const CYR_EXT_UPPER_HI : Int = 0x40F
const CYR_EXT_LOWER_LO : Int = 0x450
const CYR_EXT_LOWER_HI : Int = 0x45F
const CYR_UPPER_LO : Int = 0x410
const CYR_UPPER_HI : Int = 0x42F
const CYR_LOWER_LO : Int = 0x430
const CYR_LOWER_HI : Int = 0x44F

const ASCII_CASE_GAP : Int = 32
const CYR_EXT_GAP    : Int = 80

fn in_range(n: Int, lo: Int, hi: Int) : Bool = n >= lo and n <= hi

#[doc("True for an uppercase letter in the covered scripts (including ASCII).")]
pub fn is_upper(c: Char) : Bool = {
  let n = char_to_int(c)
  in_range(n, 0x41, 0x5A)
    or (in_range(n, LATIN1_UPPER_LO, LATIN1_UPPER_HI) and n != LATIN1_TIMES)
    or (in_range(n, LATIN_EXT_A_LO, LATIN_EXT_A_HI) and n % 2 == 0)
    or (in_range(n, GREEK_UPPER_LO, GREEK_UPPER_HI) and n != GREEK_GAP)
    or in_range(n, CYR_EXT_UPPER_LO, CYR_EXT_UPPER_HI)
    or in_range(n, CYR_UPPER_LO, CYR_UPPER_HI)
}

#[doc("True for a lowercase letter in the covered scripts (including ASCII).")]
pub fn is_lower(c: Char) : Bool = {
  let n = char_to_int(c)
  in_range(n, 0x61, 0x7A)
    or (in_range(n, LATIN1_LOWER_LO, LATIN1_LOWER_HI) and n != LATIN1_DIVIDE)
    or (in_range(n, LATIN_EXT_A_LO, LATIN_EXT_A_HI) and n % 2 == 1)
    or in_range(n, GREEK_LOWER_LO, GREEK_LOWER_HI)
    or n == GREEK_FINAL_SIGMA
    or in_range(n, CYR_EXT_LOWER_LO, CYR_EXT_LOWER_HI)
    or in_range(n, CYR_LOWER_LO, CYR_LOWER_HI)
}

#[doc("Lowercases a letter in the covered scripts; anything else passes through. Final sigma is left alone — it is already lowercase.")]
pub fn to_lower(c: Char) : Char = {
  let n = char_to_int(c)
  if in_range(n, 0x41, 0x5A) { int_to_char(n + ASCII_CASE_GAP) }
  else if in_range(n, LATIN1_UPPER_LO, LATIN1_UPPER_HI) and n != LATIN1_TIMES {
    int_to_char(n + ASCII_CASE_GAP)
  }
  else if in_range(n, LATIN_EXT_A_LO, LATIN_EXT_A_HI) and n % 2 == 0 {
    int_to_char(n + 1)
  }
  else if in_range(n, GREEK_UPPER_LO, GREEK_UPPER_HI) and n != GREEK_GAP {
    int_to_char(n + ASCII_CASE_GAP)
  }
  else if in_range(n, CYR_EXT_UPPER_LO, CYR_EXT_UPPER_HI) { int_to_char(n + CYR_EXT_GAP) }
  else if in_range(n, CYR_UPPER_LO, CYR_UPPER_HI) { int_to_char(n + ASCII_CASE_GAP) }
  else { c }
}

#[doc("Uppercases a letter in the covered scripts; anything else passes through. Final sigma uppercases to the one sigma, so the mapping is not round-trip.")]
pub fn to_upper(c: Char) : Char = {
  let n = char_to_int(c)
  if in_range(n, 0x61, 0x7A) { int_to_char(n - ASCII_CASE_GAP) }
  else if in_range(n, LATIN1_LOWER_LO, LATIN1_LOWER_HI) and n != LATIN1_DIVIDE {
    int_to_char(n - ASCII_CASE_GAP)
  }
  else if in_range(n, LATIN_EXT_A_LO, LATIN_EXT_A_HI) and n % 2 == 1 {
    int_to_char(n - 1)
  }
  else if n == GREEK_FINAL_SIGMA { int_to_char(GREEK_SIGMA) }
  else if in_range(n, GREEK_LOWER_LO, GREEK_LOWER_HI) { int_to_char(n - ASCII_CASE_GAP) }
  else if in_range(n, CYR_EXT_LOWER_LO, CYR_EXT_LOWER_HI) { int_to_char(n - CYR_EXT_GAP) }
  else if in_range(n, CYR_LOWER_LO, CYR_LOWER_HI) { int_to_char(n - ASCII_CASE_GAP) }
  else { c }
}

test "ASCII still folds" {
  assert to_lower('A') == 'a'
  assert to_upper('z') == 'Z'
  assert to_lower('7') == '7'
}

test "Greek folds both ways" {
  assert to_lower('Α') == 'α'
  assert to_lower('Ω') == 'ω'
  assert to_upper('β') == 'Β'
  assert is_upper('Γ')
  assert is_lower('γ')
}

test "final sigma is lowercase and uppercases to sigma" {
  assert is_lower('ς')
  assert to_lower('ς') == 'ς'
  assert to_upper('ς') == 'Σ'
  assert to_lower('Σ') == 'σ'
}

test "Cyrillic folds across both blocks" {
  assert to_lower('А') == 'а'
  assert to_lower('Я') == 'я'
  assert to_upper('ё') == 'Ё'
  assert to_lower('Ё') == 'ё'
}

test "Latin-1 folds, and its non-letters do not" {
  assert to_lower('À') == 'à'
  assert to_upper('ñ') == 'Ñ'
  assert to_lower('×') == '×'
  assert to_upper('÷') == '÷'
  assert not is_upper('×')
  assert not is_lower('÷')
}

test "Latin Extended-A pairs even with odd" {
  assert to_lower('Ā') == 'ā'
  assert to_upper('ā') == 'Ā'
}

test "eszett has no single-char uppercase, so it passes through" {
  assert to_upper('ß') == 'ß'
}
