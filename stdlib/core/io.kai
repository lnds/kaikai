#[doc("core.io — I/O helpers and the explicit discard.")]

#[doc("Writes `s` to standard output via the `print` builtin, which appends a trailing newline.")]
pub fn println(s: String) : Unit / Stdout = print(s)

#[doc("Discards `x`: the explicit way to drop a value, as in `xs | f |> ignore`.")]
pub fn ignore[a](x: a) : Unit = ()
