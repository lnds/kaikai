#[doc("""
HTTP/1.1 over the NetTcp effect — client plus minimal server-side
helpers. `import net.http`, reached qualified (`http.get(url)`):
short names like `get` / `put` / `delete` / `request` are ambiguous
bare against `map.get` / `file.delete`.

Scope: HTTP/1.1 only, plaintext `http://` (`https://` is rejected at
parse time with a clear error — there is no TLS). Chunked transfer
decoding is supported on responses; bodies otherwise read by
`Content-Length`, or until peer close when absent. Each `request`
opens a fresh `Conn`, sends, reads, and closes — no keep-alive,
no compression, no cookies.

Every network-touching helper carries `/ NetTcp + Cancel`. The
NetTcp default handler is fully blocking, so a Cancel raised
mid-call cannot interrupt a syscall in flight; the row stays
declared so the surface is forward-compatible. `NetTcp.connect`
runs the host string through `getaddrinfo(3)`, so both numeric
IPv4 and hostnames work.
""")]

import net.tcp

# ---- types --------------------------------------------------------

#[doc("""
Parsed URL — `http://host[:port][/path]`. `port` is filled in from
the scheme default (80) when the URL omits it. `path` always begins
with `/`; an empty path component is normalised to `/`.
""")]
pub type HttpUrl = { scheme: String, host: String, port: Int, path: String }

#[doc("Authority split — `host[:port]` decomposed for connect.")]
pub type HttpHostPort = { host: String, port: Int }

#[doc("""
One header line — `name: value` with the value already trimmed
of surrounding whitespace per RFC 7230 §3.2.4.
""")]
pub type HttpHeader = { name: String, value: String }

#[doc("""
HTTP request. `method` is the uppercase verb; `headers` are appended
after the auto-emitted `Host` and `Content-Length`; `body` is the
raw request body (empty for GET / DELETE).

`url` differs by side: for outbound requests it is the absolute URL
`request` parses for the connect target and request-line path; for
inbound requests parsed by `parse_request` it is just the
request-line path (the absolute URL never travels on the wire).
""")]
pub type Request  = { method: String, url: String,
                      headers: [HttpHeader], body: String }

#[doc("""
Inbound response. `status` is the integer status code; `headers` is
the parsed header block in receive order; `body` is read by
`Content-Length` when set, otherwise drained until the peer closes.
""")]
pub type Response = { status: Int,
                      headers: [HttpHeader], body: String }

# ---- string helpers ----------------------------------------------

fn http_string_to_bytes_loop(s: String, i: Int, n: Int, acc: [Int]) : [Int] =
  if i >= n { list_reverse(acc) }
  else { match char_at(s, i) {
    Some(c) -> http_string_to_bytes_loop(s, i + 1, n, [char_to_int(c), ...acc])
    None    -> list_reverse(acc)
  } }

#[doc("Encodes a String to its bytes, one `Int` (0-255) per byte.")]
pub fn string_to_bytes(s: String) : [Int] =
  http_string_to_bytes_loop(s, 0, string_length(s), [])

fn http_byte_to_str(b: Int) : String = int_to_byte_string(b)

#[doc("Decodes a byte list (one `Int` per byte) back into a String.")]
pub fn bytes_to_string(bs: [Int]) : String =
  string_concat_all(list.map(bs, http_byte_to_str))

fn http_after(s: String, at: Int) : String =
  string_slice(s, at, string_length(s) - at)

# ---- URL parsing -------------------------------------------------

fn http_min_offset(a: Int, b: Int) : Int =
  if a < 0 { b } else if b < 0 { a } else if a < b { a } else { b }

# Offset where the authority ends: the first '/', '?' or '#', or -1.
fn http_authority_end(rest: String) : Int =
  http_min_offset(http_min_offset(string_find(rest, "/"), string_find(rest, "?")),
                  string_find(rest, "#"))

# An empty port selects the scheme default.
fn http_parse_port(text: String) : Result[Int, String] =
  if string_length(text) == 0 { Ok(80) }
  else { match string_to_int(text) {
    Some(p) if p >= 1 and p <= 65535 -> Ok(p)
    _ -> Err(string_concat_all(["parse_url: invalid port '", text, "'"]))
  } }

fn http_build_url(auth: String, tail: String) : Result[HttpUrl, String] = {
  let i = string_find(auth, ":")
  let host = if i < 0 { auth } else { string_slice(auth, 0, i) }
  let path = if string_length(tail) == 0 { "/" }
             else if string.starts_with(tail, "/") { tail }
             else { string_concat("/", tail) }
  match http_parse_port(if i < 0 { "" } else { http_after(auth, i + 1) }) {
    Err(e) -> Err(e)
    Ok(port) ->
      if string_length(host) == 0 { Err("parse_url: empty host") }
      else { Ok(HttpUrl { scheme: "http", host: host, port: port, path: path }) }
  }
}

fn http_parse_http_url(rest: String) : Result[HttpUrl, String] = {
  let at = http_authority_end(rest)
  if at < 0 { http_build_url(rest, "") }
  else { http_build_url(string_slice(rest, 0, at), http_after(rest, at)) }
}

#[doc("""
Minimal URL parser: `http://<host>[:<port>][/<path>]`.
`https://` is recognised so the error message can name TLS
specifically; any other scheme is reported as unsupported.
""")]
pub fn parse_url(s: String) : Result[HttpUrl, String] = {
  let i = string_find(s, "://")
  let scheme = if i < 0 { "" } else { string_slice(s, 0, i) }
  if i < 0 { Err("parse_url: missing scheme separator '://' in URL") }
  else if scheme == "http" { http_parse_http_url(http_after(s, i + 3)) }
  else if scheme == "https" {
    Err("parse_url: https:// requires TLS, which is not in net.http v1 (see stdlib/net/http.kai header)")
  }
  else {
    Err(string_concat_all(["parse_url: unsupported scheme '", scheme, "' (only http:// is supported in v1)"]))
  }
}

# ---- request serialiser -------------------------------------------

fn http_format_header(h: HttpHeader) : String =
  string_concat_all([h.name, ": ", h.value, "\r\n"])

fn http_format_headers(hs: [HttpHeader]) : String =
  string_concat_all(list.map(hs, http_format_header))

# Bare host when the port is the default, `host:port` otherwise.
fn http_host_header(u: HttpUrl) : String =
  if u.port == 80 { u.host }
  else { string_concat_all([u.host, ":", int_to_string(u.port)]) }

fn http_content_length_line(body: String) : String =
  string_concat_all(["Content-Length: ", int_to_string(string_length(body)), "\r\n"])

fn http_serialize_for(req: Request, u: HttpUrl) : String =
  string_concat_all([
    req.method, " ", u.path, " HTTP/1.1\r\n",
    "Host: ", http_host_header(u), "\r\n",
    http_content_length_line(req.body),
    http_format_headers(req.headers), "\r\n", req.body
  ])

#[doc("""
Serialise a `Request` to wire bytes (HTTP/1.1 framing). The
emitted block is:
  <METHOD> <PATH> HTTP/1.1\r\n
  Host: <authority>\r\n
  Content-Length: <body.len>\r\n
  <user header lines>
  \r\n
  <body>
`Host` and `Content-Length` are auto-emitted; user headers are
appended verbatim. `Connection: close` is not emitted — the read
loop drains until peer close, and adding the header would surprise
callers who supplied their own.
""")]
pub fn serialize_request(req: Request) : String =
  match parse_url(req.url) {
    Err(e) -> string_concat("INVALID_URL: ", e)
    Ok(u)  -> http_serialize_for(req, u)
  }

# ---- message parsing ---------------------------------------------

# Start line, the remaining head lines, and everything after the blank line.
type HttpHead = { start: String, lines: [String], body: String }

fn http_split_head(raw: String, ctx: String) : Result[HttpHead, String] = {
  let i = string_find(raw, "\r\n\r\n")
  if i < 0 {
    Err(string_concat_all([ctx, ": missing header/body separator (\\r\\n\\r\\n)"]))
  } else { match string_split(string_slice(raw, 0, i), "\r\n") {
    [] -> Err(string_concat(ctx, ": empty header block"))
    [start, ...lines] -> Ok(HttpHead { start: start, lines: lines, body: http_after(raw, i + 4) })
  } }
}

fn http_parse_status_line(line: String) : Result[Int, String] =
  match string_split(line, " ") {
    [_proto, code, ..._reason] -> match string_to_int(code) {
      Some(n) -> Ok(n)
      None    -> Err(string_concat("parse_response: bad status code: ", code))
    }
    _ -> Err(string_concat("parse_response: malformed status line: ", line))
  }

# Parse `Name: Value`, trimming the value. A line without `:` or with
# an empty name is a parse error, not a silent drop.
fn http_parse_header_line(line: String, ctx: String) : Result[HttpHeader, String] = {
  let i = string_find(line, ":")
  if i < 0 { Err(string_concat_all([ctx, ": header missing ':': ", line])) }
  else if i == 0 { Err(string_concat_all([ctx, ": empty header name: ", line])) }
  else {
    Ok(HttpHeader { name: string_slice(line, 0, i), value: string.trim(http_after(line, i + 1)) })
  }
}

fn http_parse_header_lines_loop(lines: [String], ctx: String, acc: [HttpHeader])
    : Result[[HttpHeader], String] = match lines {
  [] -> Ok(list_reverse(acc))
  [l, ...rest] -> match http_parse_header_line(l, ctx) {
    Err(e) -> Err(e)
    Ok(h)  -> http_parse_header_lines_loop(rest, ctx, [h, ...acc])
  }
}

fn http_parse_header_lines(lines: [String], ctx: String) : Result[[HttpHeader], String] =
  http_parse_header_lines_loop(lines, ctx, [])

#[doc("""
Look up a header by name. Case-sensitive — callers use canonical
names (`Content-Length`, `Content-Type`).
""")]
pub fn header_lookup(hs: [HttpHeader], name: String) : Option[String] = match hs {
  [] -> None
  [h, ...rest] -> if h.name == name { Some(h.value) } else { header_lookup(rest, name) }
}

fn http_content_length(hs: [HttpHeader]) : Option[Int] = match header_lookup(hs, "Content-Length") {
  Some(v) -> string_to_int(v)
  None    -> None
}

# The first `n` bytes of `body`; everything when `n` exceeds its length.
fn http_clamp_body(body: String, n: Int) : String =
  if n <= 0 { "" } else { string_slice(body, 0, n) }

fn http_frame_body(hs: [HttpHeader], body: String) : String =
  match http_content_length(hs) {
    Some(n) -> http_clamp_body(body, n)
    None    -> body
  }

fn http_is_chunked(hs: [HttpHeader]) : Bool = match header_lookup(hs, "Transfer-Encoding") {
  Some(v) -> string.to_lower(v) == "chunked"
  None    -> false
}

# Chunked wins over Content-Length; with neither, the body is everything
# after the blank line (recv already drained to peer close).
fn http_response_body(hs: [HttpHeader], body_all: String) : String =
  if http_is_chunked(hs) { dechunk_body(body_all) } else { http_frame_body(hs, body_all) }

fn http_build_response(head: HttpHead, code: Int) : Result[Response, String] =
  match http_parse_header_lines(head.lines, "parse_response") {
    Err(e) -> Err(e)
    Ok(hs) -> Ok(Response { status: code, headers: hs, body: http_response_body(hs, head.body) })
  }

#[doc("""
Parse a complete HTTP/1.1 response: status line + headers +
body. Length comes from `Content-Length`, else everything after
the blank line. A `Transfer-Encoding: chunked` response is
dechunked, so `body` holds the decoded payload.
""")]
pub fn parse_response(raw: String) : Result[Response, String] =
  match http_split_head(raw, "parse_response") {
    Err(e) -> Err(e)
    Ok(head) -> match http_parse_status_line(head.start) {
      Err(e)   -> Err(e)
      Ok(code) -> http_build_response(head, code)
    }
  }

# ---- chunked transfer encoding ------------------------------------
#
# A chunked body is a sequence of `<hex-length>\r\n<data>\r\n` frames
# followed by a `0\r\n\r\n` terminator.

fn http_find_crlf(s: String, i: Int, n: Int) : Int =
  if i + 1 >= n { -1 }
  else if string_cp_at(s, i) == 13 and string_cp_at(s, i + 1) == 10 { i }
  else { http_find_crlf(s, i + 1, n) }

# Hex digits before any `;` extension; 0 when malformed.
fn http_chunk_size(line: String) : Int = {
  let semi = string_find(line, ";")
  let digits = if semi < 0 { line } else { string_slice(line, 0, semi) }
  match string.to_int_radix(string.trim(digits), 16) {
    Some(n) -> n
    None    -> 0
  }
}

# `parts` holds the decoded chunks, newest first; a frame that cannot be
# decoded ends the stream.
fn http_dechunk_loop(s: String, pos: Int, parts: [String]) : String = {
  let crlf = http_find_crlf(s, pos, string_length(s))
  let size = if crlf < 0 { 0 } else { http_chunk_size(string_slice(s, pos, crlf - pos)) }
  if size > 0 { http_dechunk_loop(s, crlf + 2 + size + 2, [string_slice(s, crlf + 2, size), ...parts]) }
  else { string_concat_all(list_reverse(parts)) }
}

#[doc("Decodes an HTTP chunked-transfer body into a single contiguous string.")]
pub fn dechunk_body(s: String) : String = http_dechunk_loop(s, 0, [])

# ---- network surface ---------------------------------------------

# Reverse-prepend `chunk` onto `acc` (callers list_reverse once at the
# end), avoiding an O(n) `list_append` per chunk.
fn http_recv_all_prepend(chunk: [Int], acc: [Int]) : [Int] = match chunk {
  [] -> acc
  [b, ...rest] -> http_recv_all_prepend(rest, [b, ...acc])
}

# Drain a Conn in 4096-byte chunks until the peer closes or recv fails.
fn http_recv_all_loop(c: Conn, acc: [Int]) : [Int] / NetTcp + Cancel =
  match NetTcp.recv(c, 4096) {
    Err(_) -> list_reverse(acc)
    Ok([]) -> list_reverse(acc)
    Ok(chunk) -> http_recv_all_loop(c, http_recv_all_prepend(chunk, acc))
  }

fn http_failure(body: String) : Response = Response { status: 0, headers: [], body: body }

fn http_exchange(req: Request, u: HttpUrl, c: Conn) : Response / NetTcp + Cancel = {
  let _   = NetTcp.send(c, string_to_bytes(http_serialize_for(req, u)))
  let raw = bytes_to_string(http_recv_all_loop(c, []))
  NetTcp.close(c)
  match parse_response(raw) {
    Ok(r)  -> r
    Err(e) -> http_failure(e)
  }
}

#[doc("""
Lower-level builder: opens a fresh Conn to the URL's host:port,
writes the serialised request, drains the response, closes, and
parses. Errors at any layer collapse to a synthetic Response with
status `0` and the error in `body`, so callers see the failure
without a Result wrapper on every call; callers needing per-step
diagnostics use `NetTcp.*` directly.
""")]
pub fn request(req: Request) : Response / NetTcp + Cancel =
  match parse_url(req.url) {
    Err(e) -> http_failure(e)
    Ok(u)  -> match NetTcp.connect(u.host, u.port) {
      Err(e) -> http_failure(string_concat("connect: ", e))
      Ok(c)  -> http_exchange(req, u, c)
    }
  }

fn http_simple(method: String, url: String, body: String) : Request =
  Request { method: method, url: url, headers: [], body: body }

#[doc("""
Issues a GET request to `url` with no extra headers and returns the response.

A convenience constructor over `request`; callers that need custom
headers build a `Request` and call `request` directly. `post` / `put`
/ `delete` mirror this for their methods.
""")]
pub fn get(url: String) : Response / NetTcp + Cancel =
  request(http_simple("GET", url, ""))

#[doc("Issues a POST request to `url` carrying `body`, with no extra headers.")]
pub fn post(url: String, body: String) : Response / NetTcp + Cancel =
  request(http_simple("POST", url, body))

#[doc("Issues a PUT request to `url` carrying `body`, with no extra headers.")]
pub fn put(url: String, body: String) : Response / NetTcp + Cancel =
  request(http_simple("PUT", url, body))

#[doc("Issues a DELETE request to `url` with no extra headers.")]
pub fn delete(url: String) : Response / NetTcp + Cancel =
  request(http_simple("DELETE", url, ""))

# ---- server side --------------------------------------------------

# Carrier for request-line parts; callers receive a `Request`.
type HttpReqLine = { method: String, path: String }

# Strict: `METHOD SP PATH SP HTTP/1.1` and nothing else. Callers wrap the
# Err in a 400 Bad Request.
fn http_parse_request_line(line: String) : Result[HttpReqLine, String] =
  match string_split(line, " ") {
    [m, p, "HTTP/1.1"] -> Ok(HttpReqLine { method: m, path: p })
    [_, _, proto] -> Err(string_concat_all(["parse_request: unsupported protocol '", proto, "' (v1 accepts HTTP/1.1 only)"]))
    _ -> Err(string_concat("parse_request: malformed request line: ", line))
  }

fn http_build_request(head: HttpHead, rl: HttpReqLine) : Result[Request, String] =
  match http_parse_header_lines(head.lines, "parse_request") {
    Err(e) -> Err(e)
    Ok(hs) -> Ok(Request { method: rl.method, url: rl.path, headers: hs, body: head.body })
  }

# Request with the body still holding everything after the blank line.
fn http_parse_request_unframed(raw: String) : Result[Request, String] =
  match http_split_head(raw, "parse_request") {
    Err(e) -> Err(e)
    Ok(head) -> match http_parse_request_line(head.start) {
      Err(e) -> Err(e)
      Ok(rl) -> http_build_request(head, rl)
    }
  }

fn http_with_body(r: Request, body: String) : Request =
  Request { method: r.method, url: r.url, headers: r.headers, body: body }

#[doc("""
Parse a complete HTTP/1.1 request: request line + headers + body.
Body length is read from `Content-Length`; an absent header means
an empty body. `Request.url` is the request-line path — the
absolute URL is never on the wire.
""")]
pub fn parse_request(raw: String) : Result[Request, String] =
  match http_parse_request_unframed(raw) {
    Err(e) -> Err(e)
    Ok(r)  -> Ok(http_with_body(r, http_frame_body(r.headers, r.body)))
  }

#[doc("""
Status code → reason phrase. Codes outside the table fall through
to "OK" so the wire stays well-formed — the status code carries
the semantics, the reason phrase is informational.
""")]
pub fn status_reason(code: Int) : String = match code {
  201 -> "Created"
  202 -> "Accepted"
  204 -> "No Content"
  301 -> "Moved Permanently"
  302 -> "Found"
  304 -> "Not Modified"
  400 -> "Bad Request"
  401 -> "Unauthorized"
  403 -> "Forbidden"
  404 -> "Not Found"
  405 -> "Method Not Allowed"
  409 -> "Conflict"
  500 -> "Internal Server Error"
  502 -> "Bad Gateway"
  503 -> "Service Unavailable"
  _   -> "OK"
}

#[doc("""
Serialise a `Response` to wire bytes (HTTP/1.1 framing). Emitted
block:
  HTTP/1.1 <status> <reason>\r\n
  Content-Length: <body.len>\r\n
  <user header lines>
  \r\n
  <body>
`Content-Length` is auto-emitted; user headers are appended
verbatim. Callers wanting `Connection: close` add it to
`resp.headers` themselves.
""")]
pub fn serialize_response(resp: Response) : String =
  string_concat_all([
    "HTTP/1.1 ", int_to_string(resp.status), " ", status_reason(resp.status), "\r\n",
    http_content_length_line(resp.body),
    http_format_headers(resp.headers), "\r\n", resp.body
  ])

#[doc("""
Read a full HTTP/1.1 request off `conn`, capped at `max_bytes` to
prevent unbounded header buffering. Loops `NetTcp.recv` until
either (a) the separator `\r\n\r\n` is seen and enough bytes follow
to cover `Content-Length`, (b) the peer closes (`Ok([])`), or
(c) `max_bytes` would be exceeded — returning Err so the caller can
answer 413.
""")]
pub fn read_request(conn: Conn, max_bytes: Int) : Result[Request, String] / NetTcp =
  http_read_request_loop(conn, [], 0, max_bytes)

# Peer closed: Ok only when `Content-Length` is unusable, since a numeric
# length would already have completed the request or left it truncated.
fn http_finish_on_close(acc_rev: [Int]) : Result[Request, String] =
  match parse_request(bytes_to_string(list_reverse(acc_rev))) {
    Ok(r) if http_content_length(r.headers) == None -> Ok(r)
    _ -> Err("read_request: peer closed before request complete")
  }

# Some(req) once the buffer holds a complete request; None to recv more.
fn http_request_ready(acc_rev: [Int]) : Option[Request] =
  match http_parse_request_unframed(bytes_to_string(list_reverse(acc_rev))) {
    Err(_) -> None
    Ok(r)  -> match header_lookup(r.headers, "Content-Length") {
      None    -> Some(r)
      Some(v) -> match string_to_int(v) {
        Some(n) if string_length(r.body) >= n -> Some(http_with_body(r, http_clamp_body(r.body, n)))
        _ -> None
      }
    }
  }

fn http_read_more(conn: Conn, acc_rev: [Int], have: Int, max_bytes: Int)
    : Result[Request, String] / NetTcp =
  match NetTcp.recv(conn, 4096) {
    Err(e) -> Err(string_concat("read_request: ", e))
    Ok([]) -> http_finish_on_close(acc_rev)
    Ok(chunk) -> http_read_request_loop(conn, http_recv_all_prepend(chunk, acc_rev),
                                        have + list_length(chunk), max_bytes)
  }

fn http_read_request_loop(conn: Conn, acc_rev: [Int], have: Int, max_bytes: Int)
    : Result[Request, String] / NetTcp =
  if have > max_bytes {
    Err(string_concat_all(["read_request: exceeded max_bytes=", int_to_string(max_bytes)]))
  } else { match http_request_ready(acc_rev) {
    Some(req) -> Ok(req)
    None      -> http_read_more(conn, acc_rev, have, max_bytes)
  } }

# ---- redirect following -------------------------------------------

#[doc("""
Knobs for `follow`'s redirect handling:
  - `max_redirects`: hard cap on hops before `follow` returns
    `Err("too many redirects (max <N>)")`.
  - `follow_3xx`: status codes that trigger a follow.
  - `rewrite_post_to_get_on_303`: a POST hitting a 303 follows as a
    GET with no body.
  - `preserve_method_307_308`: a 307 / 308 follow preserves the
    method and body.
""")]
pub type RedirectPolicy = {
  max_redirects: Int,
  follow_3xx: [Int],
  rewrite_post_to_get_on_303: Bool,
  preserve_method_307_308: Bool,
}

#[doc("""
Sane defaults in one place — every convenience wrapper threads
the result through `follow`. Callers who want a custom
policy build a `RedirectPolicy { … }` literal directly.
""")]
pub fn default_redirect_policy() : RedirectPolicy = RedirectPolicy {
  max_redirects: 10,
  follow_3xx: [301, 302, 303, 307, 308],
  rewrite_post_to_get_on_303: true,
  preserve_method_307_308: true,
}

# Absolute-path and network-path references resolve against `orig`;
# anything else is returned as written.
fn http_resolve_redirect_url(orig_url: String, loc: String) : String =
  match parse_url(orig_url) {
    Err(_) -> loc
    Ok(u)  ->
      if string.starts_with(loc, "//") { string_concat_all([u.scheme, ":", loc]) }
      else if string.starts_with(loc, "/") {
        string_concat_all([u.scheme, "://", u.host, ":", int_to_string(u.port), loc])
      } else { loc }
  }

fn http_same_origin(from: String, to: String) : Bool =
  match parse_url(from) {
    Err(_) -> false
    Ok(a) -> match parse_url(to) {
      Err(_) -> false
      Ok(b) -> a.scheme == b.scheme and a.port == b.port
        and string.to_lower(a.host) == string.to_lower(b.host)
    }
  }

fn http_redirect_header(h: HttpHeader, same_origin: Bool) : Bool = {
  let name = string.to_lower(h.name)
  let credential = name == "authorization" or name == "proxy-authorization"
    or name == "cookie" or name == "cookie2"
  name != "host" and (same_origin or not credential)
}

fn http_redirect_headers(hs: [HttpHeader], same_origin: Bool) : [HttpHeader] =
  list.filter(hs, (h) => http_redirect_header(h, same_origin))

# POST becomes GET on 301 / 302 and, per policy, 303; 307 / 308 and every
# other method keep the verb.
fn http_redirect_method(orig: Request, status: Int, policy: RedirectPolicy) : String =
  if orig.method == "POST"
     and (status == 301 or status == 302 or (status == 303 and policy.rewrite_post_to_get_on_303)) {
    "GET"
  } else { orig.method }

fn http_build_next_request(orig: Request, status: Int, loc: String,
                           policy: RedirectPolicy) : Request = {
  let method  = http_redirect_method(orig, status, policy)
  let new_url = http_resolve_redirect_url(orig.url, loc)
  Request {
    method: method,
    url: new_url,
    headers: http_redirect_headers(orig.headers, http_same_origin(orig.url, new_url)),
    body: if method == "GET" { "" } else { orig.body }
  }
}

fn http_follow_hop(req: Request, resp: Response, policy: RedirectPolicy, n_redirects: Int)
    : Result[Response, String] / NetTcp + Cancel =
  match header_lookup(resp.headers, "Location") {
    None -> Err(string_concat_all([
      "redirect missing Location header at status ", int_to_string(resp.status)
    ]))
    Some(loc) -> http_follow_loop(http_build_next_request(req, resp.status, loc, policy),
                                  policy, n_redirects + 1)
  }

# One hop per call. `n_redirects` is the index of the current request,
# compared against `max_redirects` before issuing so a policy of 0 still
# lets the initial request through.
fn http_follow_loop(req: Request, policy: RedirectPolicy, n_redirects: Int)
    : Result[Response, String] / NetTcp + Cancel =
  if n_redirects > policy.max_redirects {
    Err(string_concat_all(["too many redirects (max ", int_to_string(policy.max_redirects), ")"]))
  } else {
    let resp = request(req)
    if list.contains(policy.follow_3xx, resp.status) {
      http_follow_hop(req, resp, policy, n_redirects)
    } else { Ok(resp) }
  }

#[doc("""
Public entry point — issue the request and follow 3xx redirects
until either a non-3xx status is reached, the `Location` header
is missing, or `policy.max_redirects` is exceeded. The bare
`request` keeps its single-call semantics so existing call
sites are unaffected.

Redirects preserve Authorization, Proxy-Authorization, Cookie and
Cookie2 only within the same origin (scheme, ASCII-case-insensitive
host, effective port). All occurrences are removed on an origin change,
including mixed-case header names; later hops never restore them.
Host overrides are removed on every redirect so the next request uses
its destination authority. Other headers are preserved. This is not a
cookie jar or a policy for application-specific secret headers.
Absolute HTTP URLs, absolute paths and network-path references are
supported; other relative references retain the existing error behavior.
""")]
pub fn follow(req: Request, policy: RedirectPolicy)
    : Result[Response, String] / NetTcp + Cancel =
  http_follow_loop(req, policy, 0)

#[doc("""
Like `get`, but follows 3xx redirects per the default policy and returns a `Result`.

A convenience wrapper over `follow`; callers needing custom headers or
a non-default policy build a `Request` and call `follow` directly.
`post_follow` / `put_follow` / `delete_follow` mirror this for their methods.
""")]
pub fn get_follow(url: String) : Result[Response, String] / NetTcp + Cancel =
  follow(http_simple("GET", url, ""), default_redirect_policy())

#[doc("Like `post`, but follows 3xx redirects per the default policy and returns a `Result`.")]
pub fn post_follow(url: String, body: String)
    : Result[Response, String] / NetTcp + Cancel =
  follow(http_simple("POST", url, body), default_redirect_policy())

#[doc("Like `put`, but follows 3xx redirects per the default policy and returns a `Result`.")]
pub fn put_follow(url: String, body: String)
    : Result[Response, String] / NetTcp + Cancel =
  follow(http_simple("PUT", url, body), default_redirect_policy())

#[doc("Like `delete`, but follows 3xx redirects per the default policy and returns a `Result`.")]
pub fn delete_follow(url: String) : Result[Response, String] / NetTcp + Cancel =
  follow(http_simple("DELETE", url, ""), default_redirect_policy())

test "redirect origin uses host case and effective port" {
  assert(http_same_origin("http://EXAMPLE.test/a", "http://example.test:80/b"))
  assert(not http_same_origin("http://example.test/a", "http://example.test:81/a"))
  assert(not http_same_origin("http://example.test/a", "http://sub.example.test/a"))
  assert(not http_same_origin("http://example.test/a", "https://example.test/a"))
  assert(not http_same_origin("http://example.test/a", "invalid"))
  assert(not http_same_origin("invalid", "http://example.test/a"))
  assert(http_same_origin("http://example.test/a", "http://EXAMPLE.test/b"))
}
