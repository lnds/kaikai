#[doc("""
The `NetTcp` effect plus the small pure helpers that fall out of its
op set. `import net.tcp`. IPv4 only, blocking ops.

Bytes move either as `[Int]` (each element in `[0, 255]`; the runtime
truncates higher bits) through `send` / `recv` / `recv_timeout`, or as
an `Array[Byte]` through `send_bytes` / `recv_bytes` /
`recv_bytes_timeout`, which allocate one buffer instead of a cons per
byte.
`Result[a, e]` is Ok-first; user code matches `Ok(c)` / `Err(msg)`.
""")]

#[doc("Opaque TCP connection handle. The `fd` is the OS socket descriptor, read by the runtime.")]
pub type Conn = { priv fd: Int }

#[doc("""
Opaque TCP listener handle. `port` is the kernel-assigned port, read
back via `local_port` when the caller bound to port 0.
""")]
pub type Listener = { priv fd: Int, port: Int }

#[doc("""
Byte-level TCP networking. `connect` / `listen` / `accept` open
handles; `send` / `recv` move `[Int]` byte lists; `close` releases a
connection. `recv_timeout` reads with a deadline, returning `None`
when `nanos` elapses before any byte arrives so a slow peer cannot
park a fiber forever. `send_bytes`, `recv_bytes` and
`recv_bytes_timeout` are the `Array[Byte]` counterparts of `send`,
`recv` and `recv_timeout`; an empty array from `recv_bytes` is a clean
peer close. The default handler bridges each op to the runtime's
blocking sockets.
""")]
pub effect NetTcp {
  connect(host: String, port: Int) : Result[Conn, String]
  listen(host: String, port: Int) : Result[Listener, String]
  accept(l: Listener) : Result[Conn, String]
  send(c: Conn, data: [Int]) : Result[Int, String]
  recv(c: Conn, max: Int) : Result[[Int], String]
  recv_timeout(c: Conn, max: Int, nanos: Int) : Option[Result[[Int], String]]
  send_bytes(c: Conn, data: Array[Byte]) : Result[Int, String]
  recv_bytes(c: Conn, max: Int) : Result[Array[Byte], String]
  recv_bytes_timeout(c: Conn, max: Int, nanos: Int) : Option[Result[Array[Byte], String]]
  close(c: Conn) : Unit
  default {
    connect(host, port, resume) -> $extern_handler("kai_default_nettcp_connect")
    listen(host, port, resume) -> $extern_handler("kai_default_nettcp_listen")
    accept(l, resume) -> $extern_handler("kai_default_nettcp_accept")
    send(c, data, resume) -> $extern_handler("kai_default_nettcp_send")
    recv(c, max, resume) -> $extern_handler("kai_default_nettcp_recv")
    recv_timeout(c, max, ns, resume) -> $extern_handler("kai_default_nettcp_recv_timeout")
    send_bytes(c, data, resume) -> $extern_handler("kai_default_nettcp_send_bytes")
    recv_bytes(c, max, resume) -> $extern_handler("kai_default_nettcp_recv_bytes")
    recv_bytes_timeout(c, max, ns, resume) -> $extern_handler("kai_default_nettcp_recv_bytes_timeout")
    close(c, resume) -> $extern_handler("kai_default_nettcp_close")
  }
}

#[doc("""
Read back the local port a Listener is bound to — useful when the
caller passed `port = 0` to `NetTcp.listen` so the kernel picks a
free port.
""")]
pub fn local_port(l: Listener) : Int = l.port
