#[doc("The positions a frame's emitters bracket, keyed by source position, and their lookups.")]

import compiler.ast
import compiler.util
import compiler.marks
import compiler.unwind_binders

#[doc("A position the emitter brackets: a call that can unwind (keyed also by its callee's spelling) with the binders it registers, a `match` whose arms hold such a call, a `handle` with the outer binders that survive it, a native landing pad (an expression that can trap, keyed like a call, with the binders its pad releases), or a `!` with the binders its early return releases.")]
pub type UnwSite = UnwCall(Int, Int, String, [String]) | UnwMatch(Int, Int) | UnwHandle(Int, Int, [String]) | UnwPad(Int, Int, String, [String]) | UnwExit(Int, Int, [String])

#[doc("True when the `match` at `(line, col)` has an arm holding a call that can unwind.")]
pub fn unw_match_at(sites: [UnwSite], line: Int, col: Int) : Bool = match sites {
  [] -> false
  [s, ...rest] -> match s {
    UnwMatch(l, c) -> (l == line and c == col) or unw_match_at(rest, line, col)
    _ -> unw_match_at(rest, line, col)
  }
}

#[doc("The spelling a call site is keyed by.")]
pub fn unw_callee_key(f: Expr) : String = match f.kind {
  EVar(n)        -> n
  ESym(_, _, n)  -> n
  EModCall(m, n) -> concat_all([m, ".", n])
  EMark(m)       -> mark_name(m)
  _              -> ""
}

#[doc("`sites` with `s`; a site already at its position keeps the names both share.")]
pub fn unw_add(s: UnwSite, sites: [UnwSite]) : [UnwSite] = match s {
  UnwCall(l, c, k, ns) -> match unw_call_at(sites, l, c, k) {
    None     -> [s, ...sites]
    Some(ps) -> [UnwCall(l, c, k, unw_inter(ns, ps)), ...sites]
  }
  UnwHandle(l, c, ns) -> match unw_handle_names(sites, l, c) {
    None     -> [s, ...sites]
    Some(ps) -> [UnwHandle(l, c, unw_inter(ns, ps)), ...sites]
  }
  UnwPad(l, c, k, ns) -> match unw_pad_at(sites, l, c, k) {
    None     -> [s, ...sites]
    Some(ps) -> [UnwPad(l, c, k, unw_inter(ns, ps)), ...sites]
  }
  UnwMatch(_, _) -> [s, ...sites]
  UnwExit(l, c, ns) -> match unw_exit_at(sites, l, c) {
    None     -> [s, ...sites]
    Some(ps) -> [UnwExit(l, c, unw_inter(ns, ps)), ...sites]
  }
}

#[doc("The names the early return of the `!` at `(line, col)` releases, if there is one.")]
pub fn unw_exit_at(sites: [UnwSite], line: Int, col: Int) : Option[[String]] = match sites {
  [] -> None
  [s, ...rest] -> match s {
    UnwExit(l, c, ns) -> if l == line and c == col { Some(ns) } else { unw_exit_at(rest, line, col) }
    _ -> unw_exit_at(rest, line, col)
  }
}

#[doc("The names registered at the call site keyed `(line, col, key)`, if there is one.")]
pub fn unw_call_at(sites: [UnwSite], line: Int, col: Int, key: String) : Option[[String]] = match sites {
  [] -> None
  [s, ...rest] -> match s {
    UnwCall(l, c, k, ns) -> if l == line and c == col and k == key { Some(ns) } else { unw_call_at(rest, line, col, key) }
    _ -> unw_call_at(rest, line, col, key)
  }
}

#[doc("The names the landing pad keyed `(line, col, key)` releases, if there is one.")]
pub fn unw_pad_at(sites: [UnwSite], line: Int, col: Int, key: String) : Option[[String]] = match sites {
  [] -> None
  [s, ...rest] -> match s {
    UnwPad(l, c, k, ns) -> if l == line and c == col and k == key { Some(ns) } else { unw_pad_at(rest, line, col, key) }
    _ -> unw_pad_at(rest, line, col, key)
  }
}

#[doc("True when `s` releases on a path of its own (a landing pad or an early return) rather than bracketing.")]
pub fn unw_is_pad(s: UnwSite) : Bool = match s {
  UnwPad(_, _, _, _) -> true
  UnwExit(_, _, _)   -> true
  _ -> false
}

#[doc("True when `s` is the early return of a `!`.")]
pub fn unw_is_exit(s: UnwSite) : Bool = match s {
  UnwExit(_, _, _) -> true
  _ -> false
}

#[doc("The sites `new` minus the names `drop`, added to `acc`.")]
pub fn unw_merge(new: [UnwSite], drop: [String], acc: [UnwSite]) : [UnwSite] = match new {
  [] -> acc
  [s, ...rest] -> unw_merge(rest, drop, unw_add(us_minus(s, drop), acc))
}

fn us_minus(s: UnwSite, drop: [String]) : UnwSite = match drop {
  [] -> s
  _  -> match s {
    UnwCall(l, c, k, ns) -> UnwCall(l, c, k, unw_minus(ns, drop))
    UnwHandle(l, c, ns)  -> UnwHandle(l, c, unw_minus(ns, drop))
    UnwPad(l, c, k, ns)  -> UnwPad(l, c, k, unw_minus(ns, drop))
    UnwMatch(_, _)       -> s
    UnwExit(l, c, ns)    -> UnwExit(l, c, unw_minus(ns, drop))
  }
}
