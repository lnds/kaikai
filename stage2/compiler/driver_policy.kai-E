#[doc("""
What the mode, the backend and the cache options of a run decide: which
passes run, which artifacts are written, and how much of the core is
cut.
""")]

import compiler.util
import compiler.verdicts
import compiler.ast_decl
import compiler.ast_ids
import compiler.symtab
import compiler.diag_file
import compiler.user_cache
import compiler.typed_cut
import compiler.edition
import compiler.infer_glue
import compiler.infer_state
import compiler.diag_type_text
import compiler.infer_dump
import compiler.type_scope_check
import compiler.site_ids
import compiler.infer_holes_json
import compiler.core_cut
import compiler.module_table
import compiler.core_types
import compiler.modules_paths
import compiler.ncore_index
import compiler.doc_attr
import compiler.driver_cli
import compiler.ast
import compiler.expr_positions
import compiler.handler_alias

#[doc("Whether the mode runs the protocol law checks.")]
pub(pkg) fn wants_law_checks(m: Mode) : Bool = match mode_program(m) {
  MPropCheck -> true
  MTest      -> true
  _          -> false
}

#[doc("A build whose binary starts the runner of its test, bench or check blocks.")]
pub(pkg) fn runs_blocks(m: Mode) : Bool = match mode_program(m) {
  MTest      -> true
  MBench     -> true
  MPropCheck -> true
  _          -> false
}

#[doc("""
Typecheck-only: ride the build arm's front-end (same proto registry,
head-owner cache, kind theories, post-typer validations) and stop
before monomorphisation, so diagnostics are identical to a build's
front-end by construction.
""")]
pub(pkg) fn is_check_mode(m: Mode) : Bool = match m {
  MCheck     -> true
  MDiagsJson -> true
  _          -> false
}

#[doc("`--diags-json` names the file its document reports on.")]
pub(pkg) fn diags_json_file(m: Mode, path: String) : Option[String] = match m {
  MDiagsJson -> Some(path)
  _          -> None
}

#[doc("""
A stage that stops before the resolver exits with its count alone, so
under `--diags-json` its document is printed here.
""")]
pub(pkg) fn close_front(m: Mode, path: String, rc: Int) : Int / Console =
  if rc == 0 { 0 } else { vd_exit(diags_json_file(m, path), [vd_count(rc)]) }

#[doc("""
Hole/effect report modes ride the build arm's front-end for the same
reason --check does: the legacy infer_program entry carries no
head-owner cache, protocol registry, or kind theories, so it rejects
programs the build accepts (e.g. convention-pipe dispatch).
""")]
pub(pkg) fn is_report_mode(m: Mode) : Bool = match m {
  MHoles          -> true
  MHolesJson      -> true
  MHolesScope     -> true
  MHolesJsonScope -> true
  MEffectsJson    -> true
  MEffectHolesJson -> true
  MExplain        -> true
  MDumpTyconIds   -> true
  MCheckTypeIds   -> true
  MCheckFieldTypes -> true
  _ -> false
}

#[doc("""
`hidden` holds the top-level declarations the root file cannot reach, which
a hole report must not offer.
""")]
pub(pkg) fn run_report_dump(m: Mode, df: DiagFiles, hidden: [SymId], tp: TypedProgram, tab: SymTab,
      doc_items: [DocItem]) : Int / Console + File = {
  let path = df_root(df)
  match m {
    MHoles          -> dump_holes(path, tp, tab, hidden, false)
    MHolesJson      -> dump_holes_json(path, tp, tab, doc_items, hidden, false)
    MHolesScope     -> dump_holes(path, tp, tab, hidden, true)
    MHolesJsonScope -> dump_holes_json(path, tp, tab, doc_items, hidden, true)
    MEffectsJson    -> dump_effects_json(df, tp, tab)
    MEffectHolesJson -> dump_effect_holes_json(path, tp, tab)
    MExplain        -> dump_explain(df, tp)
    MDumpTyconIds   -> dump_tycon_ids(tp.decls, tab, root_module_name(path))
    MCheckTypeIds   -> check_type_ids(tp.decls, tab)
    MCheckFieldTypes -> check_field_types(tp.decls, tab)
    _ -> 0
  }
}

#[doc("Print each law-check note to stderr.")]
pub(pkg) fn emit_law_check_notes(ns: [String]) : Unit / Console = match ns {
  [] -> ()
  [n, ...rest] -> { eprint(n); emit_law_check_notes(rest) }
}

#[doc("""
Pruning makes the core program-dependent, so it runs only where the
compile writes no cache entry keyed without the program. The report
modes stay whole: they list what is in scope, reached or not.
""")]
pub(pkg) fn core_prunes(mode: Mode, backend: Backend, cc: CoreCacheOpt, core_hit: Option[String]) : Bool =
  core_cut_mode(mode) and not cc.full_core
    and (not core_cache_writes(backend, cc) or core_hit_reusable(backend, core_hit))

fn core_cut_mode(mode: Mode) : Bool = match mode {
  MDefault   -> true
  MTest      -> true
  MBench     -> true
  MPropCheck -> true
  MBatchList -> true
  MCheck     -> true
  MDiagsJson -> true
  _          -> false
}

#[doc("""
Whether this compile writes a core artifact keyed by the core sources and
the toolchain rather than by what it typed. The native arm is the
condition its writer tests. The C backends and native-modular are not one: each partition is keyed by its
own projected KIR, so a pruned core publishes under its own keys. The
typed cut is not one either: its blobs are keyed by the decls each module
was typed with, so a pruned module publishes under its own key.
""")]
pub(pkg) fn core_cache_writes(backend: Backend, cc: CoreCacheOpt) : Bool = match backend {
  BkC             -> false
  BkNative        -> native_core_cached(cc)
  BkCModular      -> false
  BkNativeModular -> false
  BkCOwner        -> false
}

#[doc("""
The directory the typed cut publishes module blobs into; empty when the
cut is off. Builds ride the project cache only; the front-end-only modes
also ride the shared core-cache directory.
""")]
pub(pkg) fn typed_cut_dir(mode: Mode, user_cache: Bool, cc: CoreCacheOpt, path: String) : String =
  if user_cache { tcut_cache_dir(cc.proj_dir, path) }
  else if is_check_mode(mode) or is_report_mode(mode) { cc.dir }
  else { "" }

#[doc("With cache statistics on, report whether the core was pruned and how many functions were dropped.")]
pub(pkg) fn prune_note(stats: Bool, prunes: Bool, cut: CoreCut) : Unit / Console =
  if not stats { () }
  else if not prunes { eprint("kaic2: core-prune: off") }
  else { match cut { CoreCut(_, d, _) -> eprint("kaic2: core-prune: dropped #{list_length(d)} core functions") } }

#[doc("A build whose core artifact the cache already holds writes nothing: a native core object.")]
pub(pkg) fn core_hit_reusable(backend: Backend, core_hit: Option[String]) : Bool = match backend {
  BkNative -> is_some(core_hit)
  _        -> false
}

#[doc("The key a cached native core object is looked up by before typing; empty when there are no core sources.")]
pub(pkg) fn native_core_pre(cc: CoreCacheOpt, edition: Option[Edition], srcs: String) : String =
  if srcs == "" { "" } else { ncore_pre_key(cc.toolchain, edition_key_text(edition), llvm_backend_tag(), srcs, cc.inputs) }

#[doc("The cached native core object the pre-typing key names, when the index holds one.")]
pub(pkg) fn native_core_hit(cc: CoreCacheOpt, pre: String) : Option[String] / File =
  if pre == "" { None } else { ncore_index_lookup(cc.dir, pre) }

#[doc("Whether this run can cache the native core object: it needs a cache directory, a toolchain id and an LLVM backend.")]
pub(pkg) fn native_core_cached(cc: CoreCacheOpt) : Bool =
  cc.dir != "" and cc.toolchain != "" and llvm_backend_tag() != ""

#[doc("""
The imported modules whose unreached functions are dropped like the
core's: the ones loaded from outside the root file's directory, so a
library goes and the program's own modules keep every diagnostic. A
module the compiler writes calls into by identity stays whole.
""")]
pub(pkg) fn prunable_modules(root_path: String, mods: [ModuleEntry]) : [String] = {
  let home = abspath(dir_of(root_path)) ++ "/"
  let pinned = core_special_homes()
  map(filter(mods, (m) => match m { ME(n, _, p, _, _) -> not starts_with(abspath(p), home) and not list_has(pinned, n) }),
      (m) => match m { ME(n, _, _, _, _) -> n })
}

#[doc("The cut of the core taken before the front end walks it, as the option asks; none when it is off or would not pay.")]
pub(pkg) fn early_cut(ec: EarlyCut, core: [Decl], libs: [Decl], tab: SymTab, keep_unw: Bool) : Option[PreCut] / Mutable = match ec {
  EcOff -> None
  EcOn  -> Some(core_precut(core, libs, tab, keep_unw))
}

#[doc("""
A compile that starts over with every core body in place, and why.
""")]
pub(pkg) fn early_cut_note(stats: Bool, names: [String]) : Unit / Console =
  if stats { eprint("kaic2: core-precut: whole core (#{string_join(names, ", ")})") } else { () }

#[doc("Report an internal error of the core cut and return the failing exit code.")]
pub(pkg) fn core_cut_fail(what: String, names: [String]) : Int / Console = {
  eprint(concat_all(["kaic2: internal error: the compile ", what, if list_length(names) == 0 { "" } else { ": " ++ string_join(names, ", ") }]))
  1
}

#[doc("Print a note for each `handle` of the root file that runs on a stack segment; returns the typer's error count.")]
fn dump_explain(df: DiagFiles, tp: TypedProgram) : Int / Console = {
  let root = df_root(df)
  each(tp.decls, (d) => if decl_diag_file(d, df) == root { explain_decl(root, d) } else { () })
  tp.errs
}

fn explain_decl(file: String, d: Decl) : Unit / Console = match decl_body(d) {
  Some(b) -> explain_expr(file, b)
  None    -> ()
}

fn explain_expr(file: String, e: Expr) : Unit / Console = {
  match e.kind {
    EIntrinsic(InSegHandle, args_) -> note(file, e, args_)
    _ -> ()
  }
  each(xp_positions(e), (p) => match p { XP(_, x) -> explain_expr(file, x) })
}

fn note(file: String, at: Expr, args_: [Expr]) : Unit / Console = match args_ {
  [esc, why, ..._] -> {
    let reason = match why.kind { EStr(span, _) -> strip_string_quotes(span)  _ -> "" }
    let leaves = match esc.kind { EBool(true) -> "; the continuation can leave its clause"  _ -> "" }
    print("#{file}:#{at.line}:#{at.col}: note: this `handle` runs its body on a stack segment: #{reason}#{leaves}")
  }
  _ -> ()
}

fn decl_body(d: Decl) : Option[Expr] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _)    -> Some(body)
  DTest(_, body, _, _, _)                 -> Some(body)
  _ -> None
}
