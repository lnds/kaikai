#[doc("""
The symbol a lowered function is emitted under.

A `KFn` is the unit it was lowered from and carries no text. A pass or an
emitter that needs the symbol asks for it here: the function registry
spells a declared function, and a lifted body is spelled from the unit
around it and its place in that unit.

The operations of the KIR name a callee by its symbol, so an index of
functions is keyed by this text; `KSymFn` is a row of such an index.
""")]

import compiler.ast
import compiler.util
import compiler.written
import compiler.symtab
import compiler.spec_names
import compiler.fnreg
import compiler.infer_index
import compiler.fn_csym
import compiler.enc_unit
import compiler.emit_shared
import compiler.kir

#[doc("What spells a lowered function: the function registry by declaration, and the symbol table and specialisation names for a function the registry does not hold.")]
pub type KNames = { tab: SymTab, specs: SpecNames, reg: NameIndex[EFn] }

#[doc("The names of the program `kp`.")]
pub fn kp_names(kp: KProgram) : KNames = KNames { tab: kp.tab, specs: kp.specs, reg: kp.reg }

#[doc("The symbol the unit `u` is emitted under.")]
pub fn unit_sym(nm: KNames, u: EncUnit) : String = match u {
  EuNone                -> ""
  EuFn(f)               -> fn_unit_sym(nm, f)
  EuRunner(k, mo, l, c) -> runner_enc_fn(k, mo, l, c).sym
  EuLam(o, l, c)        -> lam_symbol_at(unit_sym(nm, o), l, c)
  EuClause(o, l, c, w)  -> user_clause_sym(unit_sym(nm, o), l, c, w)
  EuFinally(o, l, c)    -> user_cleanup_sym(unit_sym(nm, o), l, c)
}

# A function no registry entry holds is spelled without a module, as a
# call of it is.
fn fn_unit_sym(nm: KNames, f: FnId) : String = match registered(idx_chain_sym(nm.reg, fnid_sym(f)), f) {
  Some(e) -> efn_c_sym(e)
  None    -> written_text(fn_emit_name(nm.tab, nm.specs, f))
}

fn registered(chain: [EFn], f: FnId) : Option[EFn] = match chain {
  []           -> None
  [e, ...rest] -> if fnid_eq(efn_sym(e), f) { Some(e) } else { registered(rest, f) }
}

#[doc("The symbol of the wrapper an `extern` function emitted as `csym` is called through.")]
pub fn ffi_wrapper_of(csym: String) : String = cat2("__ffi_", csym)

#[doc("The symbol the lowered function `f` is emitted under.")]
pub fn kfn_sym(nm: KNames, f: KFn) : String = match f.kind {
  KFnFfi(_, _, _) -> ffi_wrapper_of(unit_sym(nm, f.unit))
  _               -> unit_sym(nm, f.unit)
}

#[doc("A lowered function under the symbol it is emitted as: a row of an index keyed by symbol.")]
pub type KSymFn = { sym: String, f: KFn }

#[doc("The functions `fns`, each under its symbol.")]
pub fn ksym_fns(nm: KNames, fns: [KFn]) : [KSymFn] = map(fns, (f) => KSymFn { sym: kfn_sym(nm, f), f: f })
