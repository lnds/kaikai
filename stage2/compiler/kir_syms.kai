#[doc("KIR symbols, primitive ops and reachability: how a function is named, which prims exist and what a program reaches.")]

import compiler.ast_ids
import compiler.emit_shared_fv
import compiler.emit_shared_syms
import compiler.enc_unit
import compiler.fn_index
import compiler.fnreg
import compiler.infer_index
import compiler.kir
import compiler.operators
import compiler.spec_names
import compiler.symtab
import compiler.util
import compiler.vec_raw
import compiler.written

#[doc("The spelling of a primitive.")]
pub(pkg) fn kprim_text(p: PrimOp) : String = match p {
  KpBin(op)                      -> binop_text(op)
  KpUn(op)                       -> kprim_un_text(op)
  KpRawBin(s, op)                -> cat2(kprim_raw_prefix(s, op), binop_text(op))
  KpRawUn(op)                    -> kprim_raw_un_text(op)
  KpIntToReal                    -> "sitofp"
  KpRealToInt                    -> "fptosi"
  KpBox(s)                       -> cat2(kprim_scalar_text(s), ".box")
  KpUnbox(s)                     -> cat2(kprim_scalar_text(s), ".unbox")
  KpField                        -> "kai_op_field"
  KpFieldAt                      -> "kai_op_field_at"
  KpFieldBorrow                  -> "kai_op_field_borrow"
  KpFieldTake                    -> "kai_op_field_take"
  KpFieldTakeDupAt               -> "kai_op_field_take_dup_at"
  KpFieldUntake                  -> "kaix_field_untake"
  KpStateTake                    -> "kaix_clause_state_take"
  KpEqRaw                        -> "kai_eq_raw"
  KpTagEq                        -> "kai_tag_eq"
  KpNil                          -> "kai_nil"
  KpCons                         -> "kai_cons"
  KpArenaCons                    -> "kai_arena_cons"
  KpIsCons                       -> "kai_is_cons_b"
  KpIsNil                        -> "kai_is_nil_b"
  KpListAppend                   -> "kai_core_list_append"
  KpStringConcat                 -> "kai_core_string_concat"
  KpPanic                        -> "kai_core_panic"
  KpRange                        -> "kai_range"
  KpRangeStep                    -> "kai_range_step"
  KpVecRead(b)                   -> cat2("vec.read.", kprim_vec_bits_text(b))
  KpVecReadField(b)              -> cat2("vec.read.field.", kprim_vec_bits_text(b))
  KpVecReadFieldBoxed            -> "vec.read.field.boxed"
  KpVecPush(b)                   -> cat2("vec.write.push.", kprim_vec_bits_text(b))
  KpVecSet(b)                    -> cat2("vec.write.set.", kprim_vec_bits_text(b))
  KpVecPushRec                   -> "vec.write.push.rec"
  KpVecSetRec                    -> "vec.write.set.rec"
  KpVecPushRecRaw                -> "kai_vec_push_rec_raw"
  KpVecSetRecRaw                 -> "kai_vec_set_rec_raw"
  KpAssertCheck                  -> "kai_assert_check"
  KpAssertCheckWithValue         -> "kai_assert_check_with_value"
  KpCovHit                       -> "kai_cov_hit"
  KpResumeFramesRun              -> "kai_resume_frames_run"
  KpResumeFramePush              -> "kai_resume_frame_push"
  KpSegHandle                    -> "kai_seg_handle"
  KpSegRequest                   -> "kai_seg_request"
  KpUnwFiber                     -> "kai_unw_fiber"
  KpUnwPush                      -> "kai_unw_push"
  KpUnwPushReg                   -> "kai_unw_push_reg"
  KpUnwPushState                 -> "kai_unw_push_state"
  KpUnwPop                       -> "kai_unw_pop"
  KpPadOpen                      -> "kai_pad_open"
  KpPadClose                     -> "kai_pad_close"
  KpFixedVecLit(elem, n)         -> kprim_fixed_vec_text("__fixed_vec_lit", elem, n)
  KpFixedVecMaterialize(elem, n) -> kprim_fixed_vec_text("__fixed_vec_materialize", elem, n)
  KpFixedVecGet(r, elem, n)      -> kprim_fixed_vec_text(kprim_vec_read_stem(r), elem, n)
}

fn kprim_vec_bits_text(b: VecBits) : String = match b {
  VbInt  -> "i64"
  VbReal -> "f64"
}

# Negation is not spelled `-`: that is the two-operand subtraction.
fn kprim_un_text(op: UnOp) : String = match op {
  UoNeg -> "neg"
  UoNot -> "not"
}

fn kprim_raw_un_text(op: UnOp) : String = match op {
  UoNeg -> "fneg"
  UoNot -> "bnot"
}

# Bool has two families: `band` / `bor`, and the `b1` comparisons.
fn kprim_raw_prefix(s: RawScalar, op: BinOp) : String = match s {
  RwReal   -> "f"
  RwInt    -> "i"
  RwBool   -> if binop_is_logical(op) { "b" } else { "b1" }
  RwChar   -> "ch"
  RwByte   -> "u8"
  RwInt32  -> "i32"
  RwUInt32 -> "u32"
  RwUInt64 -> "u64"
  RwInt128 -> "i128"
}

fn kprim_scalar_text(s: RawScalar) : String = match s {
  RwReal   -> "real"
  RwInt    -> "int"
  RwBool   -> "bool"
  RwChar   -> "char"
  RwByte   -> "byte"
  RwInt32  -> "int32"
  RwUInt32 -> "uint32"
  RwUInt64 -> "uint64"
  RwInt128 -> "int128"
}

fn kprim_scalar_type_name(s: RawScalar) : String = match s {
  RwReal   -> "Real"
  RwInt    -> "Int"
  RwBool   -> "Bool"
  RwChar   -> "Char"
  RwByte   -> "Byte"
  RwInt32  -> "Int32"
  RwUInt32 -> "UInt32"
  RwUInt64 -> "UInt64"
  RwInt128 -> "Int128"
}

fn kprim_vec_read_stem(r: KVecRead) : String =
  concat_all([if r.heap { "__fixed_vec_dget" } else { "__fixed_vec_get" },
              if r.raw { "raw" } else { "" },
              if r.dyn { "_dyn" } else { "" }])

fn kprim_fixed_vec_text(stem: String, elem: RawScalar, n: Int) : String =
  concat_all([stem, "@", kprim_scalar_type_name(elem), "@", int_to_string(n)])

#[doc("The register slot a raw scalar lives in.")]
pub(pkg) fn raw_scalar_slot(s: RawScalar) : KSlot = match s {
  RwReal   -> SReal
  RwInt    -> SInt64
  RwBool   -> SBool
  RwChar   -> SChar
  RwByte   -> SByte
  RwInt32  -> SInt32T
  RwUInt32 -> SUInt32
  RwUInt64 -> SUInt64
  RwInt128 -> SInt128
}

#[doc("The raw slot a bare word of kind `b` rides.")]
pub(pkg) fn vec_bits_slot(b: VecBits) : KSlot = match b {
  VbInt  -> SInt64
  VbReal -> SReal
}

# The runtime's per-field kind char (kai_vec_kind_tag).
fn vb_kind(b: VecBits) : String = match b {
  VbInt  -> "i"
  VbReal -> "r"
}

# The last operand tells the runtime the read owns its vec, so a trap pays
# the reference the unwind would skip.
#[doc("The read of `rd` over the lowered vec `vv` and raw index `iv`; `owned` when the caller releases the vec after it.")]
pub(pkg) fn vec_raw_read_op(rd: VecRawRead, vv: KVal, iv: KVal, owned: Bool) : KOp = match rd.col {
  Some(c) -> match c {
    VecCol(fidx, n) -> KPrim(KpVecReadField(rd.bits), [vv, iv, KIntV(fidx), KIntV(n), vec_own(owned)])
  }
  None -> KPrim(KpVecRead(rd.bits), [vv, iv, vec_own(owned)])
}

#[doc("The read of column `c` as the box its buffer tag builds, for a field the bare-word paths do not carry; operands as in `vec_raw_read_op`.")]
pub(pkg) fn vec_boxed_field_op(c: VecCol, vv: KVal, iv: KVal, owned: Bool) : KOp = match c {
  VecCol(fidx, _) -> KPrim(KpVecReadFieldBoxed, [vv, iv, KIntV(fidx), vec_own(owned)])
}

fn vec_own(owned: Bool) : KVal = KIntV(if owned { 1 } else { 0 })

#[doc("One record field on its way into a REC carrier: name, word kind, lowered raw value.")]
pub(pkg) type VecField = VecField(String, VecBits, KVal)

#[doc("`vec_push(v, Rec{..})` over raw fields: the vec, then the kind string, then (value, name) pairs.")]
pub(pkg) fn vec_push_rec_op(vv: KVal, fs: [VecField]) : KOp =
  KPrim(KpVecPushRec, [vv, KStrV(vf_kinds(fs)), ...vf_pairs(fs)])

#[doc("`vec_set(v, i, Rec{..})` over raw fields: the vec, the raw index, the kind string, then the values.")]
pub(pkg) fn vec_set_rec_op(vv: KVal, iv: KVal, fs: [VecField]) : KOp =
  KPrim(KpVecSetRec, [vv, iv, KStrV(vf_kinds(fs)), ...vf_vals(fs)])

#[doc("`vec_push(v, x)` of one raw scalar.")]
pub(pkg) fn vec_push_scalar_op(b: VecBits, vv: KVal, xv: KVal) : KOp =
  KPrim(KpVecPush(b), [vv, xv])

#[doc("`vec_set(v, i, x)` of one raw scalar at a raw index.")]
pub(pkg) fn vec_set_scalar_op(b: VecBits, vv: KVal, iv: KVal, xv: KVal) : KOp =
  KPrim(KpVecSet(b), [vv, iv, xv])

fn vf_kinds(fs: [VecField]) : String = match fs {
  []           -> ""
  [f, ...rest] -> match f { VecField(_, b, _) -> cat2(vb_kind(b), vf_kinds(rest)) }
}

fn vf_pairs(fs: [VecField]) : [KVal] = match fs {
  []           -> []
  [f, ...rest] -> match f { VecField(nm, _, v) -> [v, KStrV(nm), ...vf_pairs(rest)] }
}

fn vf_vals(fs: [VecField]) : [KVal] = match fs {
  []           -> []
  [f, ...rest] -> match f { VecField(_, _, v) -> [v, ...vf_vals(rest)] }
}

#[doc("What spells a lowered function: the function registry by declaration, and the symbol table and specialisation names for a function the registry does not hold.")]
pub(pkg) type KNames = { tab: SymTab, specs: SpecNames, reg: NameIndex[EFn] }

#[doc("The names of the program `kp`.")]
pub(pkg) fn kp_names(kp: KProgram) : KNames = KNames { tab: kp.tab, specs: kp.specs, reg: kp.reg }

#[doc("The symbol the unit `u` is emitted under.")]
pub(pkg) fn unit_sym(nm: KNames, u: EncUnit) : String = match u {
  EuNone                -> ""
  EuFn(f)               -> fn_unit_sym(nm, f)
  EuRunner(k, mo, l, c) -> runner_enc_fn(k, mo, l, c).sym
  EuLam(o, l, c)        -> lam_symbol_at(unit_sym(nm, o), l, c)
  EuClause(o, l, c, w)  -> user_clause_sym(unit_sym(nm, o), l, c, w)
  EuFinally(o, l, c)    -> user_cleanup_sym(unit_sym(nm, o), l, c)
}

# A function no registry entry holds is spelled without a module, as a
# call of it is.
fn fn_unit_sym(nm: KNames, f: FnId) : String = match registered(idx_chain_sym(nm.reg, fnid_sym(f)), f) {
  Some(e) -> efn_c_sym(e)
  None    -> user_sym_of(written_text(fn_emit_name(nm.tab, nm.specs, f)))
}

fn registered(chain: [EFn], f: FnId) : Option[EFn] = match chain {
  []           -> None
  [e, ...rest] -> if fnid_eq(efn_sym(e), f) { Some(e) } else { registered(rest, f) }
}

#[doc("The symbol of the wrapper an `extern` function emitted as `csym` is called through.")]
pub(pkg) fn ffi_wrapper_of(csym: String) : String = cat2("__ffi_", csym)

#[doc("The symbol the lowered function `f` is emitted under.")]
pub(pkg) fn kfn_sym(nm: KNames, f: KFn) : String = match f.kind {
  KFnFfi(_, _, _) -> ffi_wrapper_of(unit_sym(nm, f.unit))
  _               -> unit_sym(nm, f.unit)
}

#[doc("A lowered function under the symbol it is emitted as: a row of an index keyed by symbol.")]
pub(pkg) type KSymFn = { sym: String, f: KFn }

#[doc("The functions `fns`, each under its symbol.")]
pub(pkg) fn ksym_fns(nm: KNames, fns: [KFn]) : [KSymFn] = map(fns, (f) => KSymFn { sym: kfn_sym(nm, f), f: f })

# compiler/kir_reach.kai — the KIR fns a program can reach from its roots.
#
# LLVM keeps every external-linkage definition it is handed, so an imported
# module the program never calls still pays its full optimise + codegen and is
# only discarded by the linker. This pass drops those fns before emission.
#
# A symbol reaches a fn through a direct or tail call, a closure (a lifted
# lambda's own symbol, or `c_user_thunk_sym` of a named fn), a handler install
# (the site's clause and return thunks), a `finally` thunk, or a prim spelled
# like a fn. A dropped fn is neither defined nor declared, so a reference this
# walk missed fails the build instead of running.

fn export_sym(e: KExport) : String = e.sym

#[doc("The program restricted to the fns reachable from the entry point, the `pinned` symbols, and every fn `is_root` accepts. Fn order is preserved.")]
pub(pkg) fn kir_reachable(kp: KProgram, is_root: (KFn) -> Bool, pinned: [String]) : KProgram = {
  let rows = ksym_fns(kp_names(kp), kp.fns)
  let by_name = kreach_index(rows, idx_empty())
  let seeds = list_append(filter(rows, (r) => is_root(r.f) or r.f.entry), kreach_resolve_all(by_name, list_append(pinned, map(kp.exports, export_sym)), []))
  let live = kreach_walk(seeds, by_name, kp.handlers, idx_empty())
  KProgram { types: kp.types, fns: map(filter(rows, (r) => kreach_has(live, r.sym)), (r) => r.f),
             handlers: kp.handlers, install_order: kp.install_order,
             defaults: kp.defaults, runner_defaults: kp.runner_defaults,
             synth_defaults: kp.synth_defaults, regions: kp.regions, runners: kp.runners, exports: kp.exports,
             entry: kp.entry, tab: kp.tab, specs: kp.specs, reg: kp.reg, ids: kp.ids, reuse_tags: kp.reuse_tags }
}

# ---- symbol → fn ------------------------------------------------------

# Each fn is indexed under its own symbol and its closure-thunk symbol.
fn kreach_index(fns: [KSymFn], ix: NameIndex[KSymFn]) : NameIndex[KSymFn] = match fns {
  [] -> ix
  [r, ...rest] -> kreach_index(rest, idx_prepend(idx_prepend(ix, r.sym, r), c_user_thunk_sym(r.sym), r))
}

fn kreach_lookup(ix: NameIndex[KSymFn], name: String) : Option[KSymFn] =
  kreach_pick(idx_chain(ix, name), name)

fn kreach_pick(chain: [KSymFn], name: String) : Option[KSymFn] = match chain {
  [] -> None
  [r, ...rest] ->
    if r.sym == name or c_user_thunk_sym(r.sym) == name { Some(r) } else { kreach_pick(rest, name) }
}

fn kreach_resolve_all(ix: NameIndex[KSymFn], names: [String], acc: [KSymFn]) : [KSymFn] = match names {
  [] -> acc
  [n, ...rest] -> match kreach_lookup(ix, n) {
    Some(f) -> kreach_resolve_all(ix, rest, [f, ...acc])
    None    -> kreach_resolve_all(ix, rest, acc)
  }
}

# ---- live set ---------------------------------------------------------

fn kreach_has(live: NameIndex[String], sym: String) : Bool = list_has(idx_chain(live, sym), sym)

fn kreach_walk(work: [KSymFn], ix: NameIndex[KSymFn], hs: [KHandlerDecl], live: NameIndex[String]) : NameIndex[String] = match work {
  [] -> live
  [r, ...rest] ->
    if kreach_has(live, r.sym) { kreach_walk(rest, ix, hs, live) }
    else {
      let next = kreach_resolve_all(ix, kreach_refs_blocks(r.f.blocks, hs, []), rest)
      kreach_walk(next, ix, hs, idx_prepend(live, r.sym, r.sym))
    }
}

# ---- references -------------------------------------------------------

fn kreach_refs_blocks(bs: [KBlock], hs: [KHandlerDecl], acc: [String]) : [String] = match bs {
  [] -> acc
  [b, ...rest] -> kreach_refs_blocks(rest, hs, kreach_refs_term(b.term, kreach_refs_stmts(b.stmts, hs, acc)))
}

fn kreach_refs_stmts(ss: [KStmt], hs: [KHandlerDecl], acc: [String]) : [String] = match ss {
  [] -> acc
  [s, ...rest] -> kreach_refs_stmts(rest, hs, kreach_refs_stmt(s, hs, acc))
}

fn kreach_refs_stmt(s: KStmt, hs: [KHandlerDecl], acc: [String]) : [String] = match s {
  KLet(_, _, op, _)            -> kreach_refs_op(op, hs, acc)
  KDo(op, _)                   -> kreach_refs_op(op, hs, acc)
  KInstall(_, site, _, _, _, _) -> kreach_site_thunks(hs, site, acc)
  KSetCleanup(_, _, thunk, _)  -> [thunk, ...acc]
  _                            -> acc
}

fn kreach_refs_op(op: KOp, hs: [KHandlerDecl], acc: [String]) : [String] = match op {
  KCall(sym, _)       -> [sym, ...acc]
  KClosure(sym, _, _) -> [sym, ...acc]
  KPrim(p, _)         -> [kprim_text(p), ...acc]
  KSetjmp(_, site)    -> kreach_site_thunks(hs, site, acc)
  _                   -> acc
}

fn kreach_refs_term(t: KTerm, acc: [String]) : [String] = match t {
  _                    -> acc
}

# The clause and return thunks of the handler installed at `site`.
fn kreach_site_thunks(hs: [KHandlerDecl], site: String, acc: [String]) : [String] = match hs {
  [] -> acc
  [h, ...rest] ->
    if h.sym == site { kreach_op_thunks(h.op_thunks, kreach_ret_thunk(h.ret_thunk, acc)) }
    else { kreach_site_thunks(rest, site, acc) }
}

fn kreach_ret_thunk(rt: Option[String], acc: [String]) : [String] = match rt {
  Some(sym) -> [sym, ...acc]
  None      -> acc
}

fn kreach_op_thunks(ts: [KOpThunk], acc: [String]) : [String] = match ts {
  [] -> acc
  [KOT(_, sym, _), ...rest] -> kreach_op_thunks(rest, [sym, ...acc])
}

#[doc("The symbols `f` refers to: every callee, closure body, handler thunk and cleanup it names.")]
pub(pkg) fn kfn_refs(f: KFn, hs: [KHandlerDecl]) : [String] = kreach_refs_blocks(f.blocks, hs, [])
