#[doc("""
A set of function identities, asked by id.

A pass that stamps a property on some functions builds the set once and
asks it per function: walking the list per function is quadratic over a
program.
""")]

import compiler.ast
import compiler.infer_index

#[doc("A set of function identities.")]
pub type FnSet = { ix: NameIndex[FnId] }

#[doc("The set of the identities `fs`.")]
pub fn fn_set_of(fs: [FnId]) : FnSet = FnSet { ix: fs_add(fs, idx_empty()) }

#[doc("True when `set` holds `f`.")]
pub fn fn_set_has(set: FnSet, f: FnId) : Bool = fs_in(idx_chain_sym(set.ix, fnid_sym(f)), f)

fn fs_add(fs: [FnId], ix: NameIndex[FnId]) : NameIndex[FnId] = match fs {
  []           -> ix
  [f, ...rest] -> fs_add(rest, idx_prepend_sym(ix, fnid_sym(f), f))
}

fn fs_in(chain: [FnId], f: FnId) : Bool = match chain {
  []           -> false
  [g, ...rest] -> fnid_eq(g, f) or fs_in(rest, f)
}
