# compiler/fmt_body.kai — which bodies an arrow lambda may print bare.
#
# The parser reads an arrow lambda's body with `parse_or`, one rung
# below the pipes. A body whose own top node is a pipe therefore ends
# the lambda at the pipe token instead of running through it, and the
# remaining stages re-associate as siblings of the enclosing pipe —
# silently, since the result often still type-checks. Reprinting such a
# body bare changes what the program computes, so it takes parentheses.
#
# A pure query over the AST; nothing here emits.

import compiler.ast

#[doc("True when an arrow lambda's body must be parenthesised to reparse as the same expression: its top node binds looser than the `parse_or` rung the body is read at.")]
pub fn lam_body_needs_parens(body: Expr) : Bool = match body.kind {
  EPipe(_, _) -> true
  EMapPipe(_, _) -> true
  EFlatMapPipe(_, _) -> true
  EFilterPipe(_, _) -> true
  _ -> false
}
