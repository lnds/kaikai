#[doc("""
`kai migrate`: the rules, the scan over a package, the types they share and the walk that applies them.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.file_ops
import compiler.symtab
import compiler.util.{list_is_empty}
import compiler.emit_shared_alias.{map_expr_kind}

# --- rewrite pass over decls ------------------------------------------

#[doc("Rewrite every expression body in a parsed program under the active rule set. Declarations with no expression body pass through unchanged.")]
pub(pkg) fn migrate_decls(decls: [Decl]) : [Decl] = map(decls, mig_decl)

# The `Result` type-argument flip is positional, so it is involutive:
# a second application undoes the first. Convergence comes from the
# source edition, not from the type's shape — only a tongariki package
# gets the flip, and migrating it makes it orongo. The call renames
# below are shape-recognisable and stay idempotent on their own, so
# they run under every edition.
#[doc("Rewrite every expression body under the call-rename rules only, leaving type annotations untouched. Used when the source edition already carries the Ok-first `Result` order.")]
pub(pkg) fn migrate_decls_renames_only(decls: [Decl]) : [Decl] = map(decls, mig_decl_renames)

fn mig_decl_renames(d: Decl) : Decl = decl_map_bodies(d, (body) => mig_expr(false, body))

fn mig_decl(d: Decl) : Decl = decl_map_inner(d, mig_decl_leaf)

fn mig_decl_leaf(d: Decl) : Decl = match d {
  DFn(p, f, tp, ps, rt, row, body, l, c, nlp, ncp, mo) -> DFn(p, f, tp, mig_params(ps), mig_ty_opt(rt), row, mig_expr(true, body), l, c, nlp, ncp, mo)
  DTest(desc, body, l, c, mo) -> DTest(desc, mig_expr(true, body), l, c, mo)
  DBench(desc, body, l, c, mo) -> DBench(desc, mig_expr(true, body), l, c, mo)
  DCheck(desc, ps, body, l, c, mo) -> DCheck(desc, mig_params(ps), mig_expr(true, body), l, c, mo)
  DConst(p, s, t, body, mo, l, c, nl, nc) -> DConst(p, s, mig_ty(t), mig_expr(true, body), mo, l, c, nl, nc)
  DImpl(pn, ta, tgt, ds, l, c, tps, isym) -> DImpl(pn, mig_tys(ta), mig_ty(tgt), migrate_decls(ds), l, c, tps, isym)
  DType(p, s, tp, body, l, c, nl, nc, mo, slots) -> DType(p, s, tp, mig_type_body(body), l, c, nl, nc, mo, slots)
  DEffect(p, s, tp, ops, dfl, l, c, nl, nc, mo) -> DEffect(p, s, tp, map(ops, mig_effect_op), dfl, l, c, nl, nc, mo)
  DProtocol(p, s, tp, ops, l, c, nl, nc, mo) -> DProtocol(p, s, tp, map(ops, mig_proto_op), l, c, nl, nc, mo)
  _ -> d
}

# --- report pass over decls -------------------------------------------

#[doc("Collect the migration report events across a whole program.")]
pub(pkg) fn migrate_scan_decls(decls: [Decl]) : [MigRep] = reduce(map(decls, scan_decl), [], cat_reps)

fn scan_decl(d: Decl) : [MigRep] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _, _, _) -> scan_expr(body)
  DTest(_, body, _, _, _) -> scan_expr(body)
  DBench(_, body, _, _, _) -> scan_expr(body)
  DCheck(_, _, body, _, _, _) -> scan_expr(body)
  DConst(_, _, _, body, _, _, _, _, _) -> scan_expr(body)
  DImpl(_, _, _, ds, _, _, _, _) -> migrate_scan_decls(ds)
  DDerive(_, inner, _, _) -> scan_decl(inner)
  DUnstable(inner, _, _) -> scan_decl(inner)
  DProtoLaws(_, inner, _, _, _) -> scan_decl(inner)
  DImplAxiom(_, inner, _, _, _) -> scan_decl(inner)
  DConstructor(inner, _, _) -> scan_decl(inner)
  DDoc(_, _, inner, _, _) -> scan_decl(inner)
  DAttr(_, inner, _, _) -> scan_decl(inner)
  _ -> []
}

# --- type-flip counting -----------------------------------------------

#[doc("Total number of `Result[_, _]` annotations the type flip rewrites across a whole program.")]
pub(pkg) fn migrate_type_flip_count(decls: [Decl]) : Int = sum_ints(map(decls, decl_flip_count))

fn sum_ints(ns: [Int]) : Int = reduce(ns, 0, add2)
fn add2(a: Int, b: Int) : Int = a + b

fn decl_flip_count(d: Decl) : Int = match d {
  DFn(_, _, _, ps, rt, _, body, _, _, _, _, _) -> add2(add2(mig_params_flips(ps), mig_ty_opt_flips(rt)), expr_flip_count(body))
  DConst(_, _, t, body, _, _, _, _, _) -> add2(mig_ty_flips(t), expr_flip_count(body))
  DCheck(_, ps, body, _, _, _) -> add2(mig_params_flips(ps), expr_flip_count(body))
  DTest(_, body, _, _, _) -> expr_flip_count(body)
  DBench(_, body, _, _, _) -> expr_flip_count(body)
  DImpl(_, ta, tgt, ds, _, _, _, _) -> add2(add2(sum_ints(map(ta, mig_ty_flips)), mig_ty_flips(tgt)), migrate_type_flip_count(ds))
  DType(_, _, _, body, _, _, _, _, _, _) -> type_body_flip_count(body)
  DEffect(_, _, _, ops, _, _, _, _, _, _) -> sum_ints(map(ops, effect_op_flip_count))
  DProtocol(_, _, _, ops, _, _, _, _, _) -> sum_ints(map(ops, proto_op_flip_count))
  DDerive(_, inner, _, _) -> decl_flip_count(inner)
  DUnstable(inner, _, _) -> decl_flip_count(inner)
  DProtoLaws(_, inner, _, _, _) -> decl_flip_count(inner)
  DImplAxiom(_, inner, _, _, _) -> decl_flip_count(inner)
  DConstructor(inner, _, _) -> decl_flip_count(inner)
  DDoc(_, _, inner, _, _) -> decl_flip_count(inner)
  DAttr(_, inner, _, _) -> decl_flip_count(inner)
  _ -> 0
}

fn type_body_flip_count(b: TypeBody) : Int = match b {
  TBAlias(t) -> mig_ty_flips(t)
  TBRecord(fds) -> sum_ints(map(fds, field_flip_count))
  TBSum(vs) -> sum_ints(map(vs, variant_flip_count))
  TBEffectAlias(_) -> 0
}

fn field_flip_count(fd: FieldDecl) : Int = match fd {
  FD(_, _, t, _, _, _) -> mig_ty_flips(t)
}

fn variant_flip_count(v: Variant) : Int = match v {
  Var(_, vts, _, _) -> sum_ints(map(vts, mig_ty_flips))
}

fn effect_op_flip_count(op: EffectOp) : Int = match op {
  EffOp(_, _, ps, ret, _, _) -> add2(mig_params_flips(ps), mig_ty_flips(ret))
}

fn proto_op_flip_count(op: ProtoOp) : Int = match op {
  POp(_, _, ps, ret, _, _) -> add2(mig_params_flips(ps), mig_ty_flips(ret))
}

# --- report rendering -------------------------------------------------

#[doc("Render the `manual:` reports as one diagnostic block, one line per report, or the empty string when the rule set applied cleanly.")]
pub(pkg) fn migrate_manual_report(reps: [MigRep]) : String = match mig_manuals(reps) {
  [] -> ""
  ms -> "migrate: #{int_to_string(list_length(ms))} change(s) need manual attention:\n#{manual_lines(ms)}"
}

fn manual_lines(ms: [MigrateManual]) : String = match ms {
  [] -> ""
  [MM(l, c, msg)] -> "  manual: #{int_to_string(l)}:#{int_to_string(c)} — #{msg}\n"
  [MM(l, c, msg), ...rest] -> "  manual: #{int_to_string(l)}:#{int_to_string(c)} — #{msg}\n#{manual_lines(rest)}"
}

fn with_kind(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

# A `<module>.<method>(...)` call is `ECall(EField(EName(mod), method),
# args)` when `mod` is an unresolved name (the shape migrate sees for
# an unimported module) and `ECall(EModCall(mod, method), args)` once
# the resolver has bound `mod` to an imported module (core modules
# like `array` are pre-bound, so they arrive as EModCall even before
# the user imports anything). Both spell the same surface call, so the
# rule set must see through both.
fn call_mod_method(callee: Expr) : Option[Pair[String, String]] = match callee.kind {
  EField(obj, method) -> call_mod_method_field(obj, method)
  EModCall(m, method) -> Some(Pair { fst: written_text(m), snd: written_text(method) })
  _ -> None
}

fn call_mod_method_field(obj: Expr, method: String) : Option[Pair[String, String]] = match obj.kind {
  EName(m) -> Some(Pair { fst: written_text(m), snd: method })
  _ -> None
}

#[doc("A call site the resolver left bound to nothing: a bare core file operation, at its line and column.")]
pub(pkg) type CoreSite = CSite(Int, Int)

fn is_core_site(sites: [CoreSite], callee: Expr) : Bool = match sites {
  [] -> false
  [CSite(l, c), ...rest] -> if l == callee.line and c == callee.col { true } else { is_core_site(rest, callee) }
}

fn qualify_file_op(sites: [CoreSite], callee: Expr) : Expr = match callee.kind {
  EName(w) -> match lookup_file_op(file_op_pairs(), written_text(w)) {
    Some(m) -> if is_core_site(sites, callee) { with_kind(callee, EField(with_kind(callee, EName(written("file"))), m)) } else { callee }
    None -> callee
  }
  _ -> callee
}

fn qualify_expr(sites: [CoreSite], e: Expr) : Expr = {
  let k = map_expr_kind(e.kind, (x) => qualify_expr(sites, x))
  match k {
    ECall(callee, cargs) -> with_kind(e, ECall(qualify_file_op(sites, callee), cargs))
    _ -> with_kind(e, k)
  }
}

#[doc("Rewrite each call of a core file operation, as the resolver found them, to `file.<op>`; a name the file binds itself or imports is never in `sites`.")]
pub(pkg) fn mig_qualify_file_ops(sites: [CoreSite], decls: [Decl]) : [Decl] =
  map(decls, (d) => decl_map_bodies(d, (body) => qualify_expr(sites, body)))

# A qualified call of a file operation: the program already needs `import fs.file`.
fn is_qualified_file_op(mm: Pair[String, String]) : Bool =
  mm.fst == "file" and has_file_method(file_op_pairs(), mm.snd)

fn has_file_method(ps: [Pair[String, String]], m: String) : Bool = match ps {
  [] -> false
  [p, ...rest] -> if p.snd == m { true } else { has_file_method(rest, m) }
}

#[doc("Add `import fs.file` after the last import (or after any leading module doc) when the program does not already import it.")]
pub(pkg) fn mig_ensure_file_import(decls: [Decl]) : [Decl] =
  if list_is_empty(filter(decls, is_file_import)) { insert_file_import(decls) } else { decls }

fn is_file_import(d: Decl) : Bool = match d {
  DImport(IkPath(p), _, _) -> p == "fs.file"
  DImport(IkAlias(p, _), _, _) -> p == "fs.file"
  _ -> false
}

fn insert_file_import(ds: [Decl]) : [Decl] = {
  let last_imp = last_import_index(ds)
  let at = if last_imp >= 0 { last_imp + 1 } else { leading_doc_count(ds, 0) }
  let line = match nth(ds, last_imp) { Some(d) -> import_line(d) + 1  None -> 0 }
  list_append(take(ds, at), [DImport(IkPath("fs.file"), line, 1), ...drop(ds, at)])
}

fn import_line(d: Decl) : Int = match d {
  DImport(_, l, _) -> l
  _ -> 0
}

fn last_import_index(ds: [Decl]) : Int = last_import_loop(ds, 0, -1)

fn last_import_loop(ds: [Decl], i: Int, acc: Int) : Int = match ds {
  [] -> acc
  [d, ...rest] -> match d {
    DImport(_, _, _) -> last_import_loop(rest, i + 1, i)
    _ -> last_import_loop(rest, i + 1, acc)
  }
}

fn leading_doc_count(ds: [Decl], n: Int) : Int = match ds {
  [] -> n
  [d, ...rest] -> match d {
    DModuleDoc(_, _, _, _) -> leading_doc_count(rest, n + 1)
    _ -> n
  }
}

fn rename_callee(callee: Expr, new_method: String) : Expr = match callee.kind {
  EField(obj, _) -> with_kind(callee, EField(obj, new_method))
  _ -> callee
}

# --- rewrite pass: Expr -> Expr, no state -----------------------------

# Apply the rule set to one already-child-walked call, renaming the
# callee in place when a rule matches (manual-only and no-match cases
# leave the node untouched — the scan pass reports the manual ones).
fn mig_apply_call(ft: Bool, e: Expr, callee: Expr, cargs: [Expr]) : Expr = match call_mod_method(callee) {
  None -> with_kind(e, ECall(callee, cargs))
  Some(mm) -> match migrate_rule_for(mm.fst, mm.snd) {
    Some(CRl(new_method)) -> with_kind(e, ECall(rename_callee(callee, new_method), cargs))
    None -> with_kind(e, ECall(callee, cargs))
  }
}

#[doc("Walk one expression, rewriting every call the rule set renames. Children are walked before the node, so a rewrite never cascades into a freshly-produced node.")]
pub(pkg) fn mig_expr(ft: Bool, e: Expr) : Expr = match e.kind {
  ECall(callee, cargs) -> mig_apply_call(ft, e, mig_expr(ft, callee), map(cargs, (x) => mig_expr(ft, x)))
  EField(obj, f) -> with_kind(e, EField(mig_expr(ft, obj), f))
  EIndex(o, i) -> with_kind(e, EIndex(mig_expr(ft, o), mig_expr(ft, i)))
  EBinop(op, l, r) -> with_kind(e, EBinop(op, mig_expr(ft, l), mig_expr(ft, r)))
  EUnop(op, x) -> with_kind(e, EUnop(op, mig_expr(ft, x)))
  EBang(x) -> with_kind(e, EBang(mig_expr(ft, x)))
  EPipe(l, r) -> with_kind(e, EPipe(mig_expr(ft, l), mig_expr(ft, r)))
  EDispatchPipe(op, l, r) -> with_kind(e, EDispatchPipe(op, mig_expr(ft, l), mig_expr(ft, r)))
  EIf(c, t, eo) -> with_kind(e, EIf(mig_expr(ft, c), mig_expr(ft, t), mig_expr_opt(ft, eo)))
  EMatch(scrut, arms) -> with_kind(e, EMatch(mig_expr(ft, scrut), mig_arms(ft, arms)))
  ELambda(ps, body) -> with_kind(e, ELambda(mig_params_if(ft, ps), mig_expr(ft, body)))
  ERecordLit(r, fields) -> with_kind(e, ERecordLit(r, mig_fields(ft, fields)))
  EList(elems) -> with_kind(e, EList(mig_elems(ft, elems)))
  ERange(lo, hi, step) -> with_kind(e, ERange(mig_expr(ft, lo), mig_expr(ft, hi), mig_expr_opt(ft, step)))
  EBlock(stmts, tail) -> with_kind(e, EBlock(mig_stmts(ft, stmts), mig_expr_opt(ft, tail)))
  ELitUnit(inner, u) -> with_kind(e, ELitUnit(mig_expr(ft, inner), u))
  EIntrinsic(name, iargs) -> with_kind(e, EIntrinsic(name, map(iargs, (x) => mig_expr(ft, x))))
  ESurface(sf) -> with_kind(e, ESurface(surface_map(sf, (x) => mig_expr(ft, x))))
  EHandle(body, eff, ta, io, al, cls, ro) ->
    with_kind(e, EHandle(mig_expr(ft, body), eff, ta, mig_expr_opt(ft, io), al, mig_clauses(ft, cls), mig_hreturn(ft, ro)))
  _ -> e
}

fn mig_expr_opt(ft: Bool, eo: Option[Expr]) : Option[Expr] = match eo {
  None -> None
  Some(x) -> Some(mig_expr(ft, x))
}

# These list walks delegate to the `map` core prim rather than
# recursing with a local list-match. kaic1 miscompiles a list-match
# fed by an AST constructor's 2nd-field binder (`ECall(_, args)` etc.)
# into a runtime non-exhaustive panic; `map` runs in the runtime, so
# the arg list is iterated by trap-free code. This mirrors how
# desugar.kai walks call arguments.
fn mig_fields(ft: Bool, fs: [FieldInit]) : [FieldInit] = map(fs, (x) => mig_field(ft, x))

fn mig_field(ft: Bool, fi: FieldInit) : FieldInit = match fi {
  FI(n, x) -> FI(n, mig_expr(ft, x))
}

fn mig_elems(ft: Bool, es: [ListElem]) : [ListElem] = map(es, (x) => mig_elem(ft, x))

fn mig_elem(ft: Bool, el: ListElem) : ListElem = match el {
  ElPlain(x) -> ElPlain(mig_expr(ft, x))
  ElSpread(x) -> ElSpread(mig_expr(ft, x))
}

fn mig_stmts(ft: Bool, ss: [Stmt]) : [Stmt] = map(ss, (x) => mig_stmt(ft, x))

fn mig_stmt(ft: Bool, s: Stmt) : Stmt = match s {
  SLet(p, t, x) -> SLet(p, mig_ty_opt_if(ft, t), mig_expr(ft, x))
  SExprStmt(x) -> SExprStmt(mig_expr(ft, x))
  SVar(n, t, x, l, c) -> SVar(n, mig_ty_opt_if(ft, t), mig_expr(ft, x), l, c)
  SAssert(x, mo) -> SAssert(mig_expr(ft, x), mig_expr_opt(ft, mo))
  SIndexAssign(a, i, v, l, c) -> SIndexAssign(mig_expr(ft, a), mig_expr(ft, i), mig_expr(ft, v), l, c)
  SAssign(a, v, l, c) -> SAssign(mig_expr(ft, a), mig_expr(ft, v), l, c)
  SUse(n, l, c) -> SUse(n, l, c)
}

fn mig_arms(ft: Bool, arms: [Arm]) : [Arm] = map(arms, (x) => mig_arm(ft, x))

fn mig_arm(ft: Bool, a: Arm) : Arm = match a {
  Arm(p, g, body) -> Arm(p, mig_expr_opt(ft, g), mig_expr(ft, body))
}

fn mig_clauses(ft: Bool, cls: [HClause]) : [HClause] = map(cls, (x) => mig_clause(ft, x))

fn mig_clause(ft: Bool, c: HClause) : HClause = match c {
  HC(n, ps, b, l, col) -> HC(n, ps, mig_expr(ft, b), l, col)
}

fn mig_hreturn(ft: Bool, ro: Option[HReturn]) : Option[HReturn] = match ro {
  None -> None
  Some(HR(n, b, l, c)) -> Some(HR(n, mig_expr(ft, b), l, c))
}

#[doc("A rewrite the migrator could not apply automatically, pinned to a source line with a human-readable pointer.")]
pub(pkg) type MigrateManual = MM(Int, Int, String)   # line, col, message

type CallRule = CRl(String)

# The four collection constructors renamed to the uniform `from` verb.
# `array` is deliberately absent: its rename dropped the `default`
# sentinel argument, so it is not an arity-preserving rename and is
# reported manually instead (see `migrate_manual_for_call`).
fn from_verb_pairs() : [Pair[String, String]] = [
  Pair { fst: "map",     snd: "from_pairs" },
  Pair { fst: "hashmap", snd: "from_pairs" },
  Pair { fst: "set",     snd: "from_list"  },
  Pair { fst: "hashset", snd: "from_list"  }
]

fn lookup_from_verb(ps: [Pair[String, String]], m: String, meth: String) : Bool = match ps {
  [] -> false
  [p, ...rest] -> if p.fst == m and p.snd == meth { true } else { lookup_from_verb(rest, m, meth) }
}

# The name-coherence renames: each `(module, old-method) -> new-method`
# canonicalises a name that means the same thing as an existing one.
# `fold` -> `foldl` unifies the left-fold spelling across every
# collection; `len` -> `length` folds the string_builder outlier into
# the sequence-length name.
fn coherence_pairs() : [Pair[Pair[String, String], String]] = [
  Pair { fst: Pair { fst: "stream",         snd: "fold" }, snd: "foldl"  },
  Pair { fst: Pair { fst: "map",            snd: "fold" }, snd: "foldl"  },
  Pair { fst: Pair { fst: "string_builder", snd: "len"  }, snd: "length" }
]

fn lookup_coherence(ps: [Pair[Pair[String, String], String]], m: String, meth: String) : Option[CallRule] = match ps {
  [] -> None
  [p, ...rest] -> if p.fst.fst == m and p.fst.snd == meth { Some(CRl(p.snd)) } else { lookup_coherence(rest, m, meth) }
}

fn migrate_rule_for(modname: String, method: String) : Option[CallRule] =
  if lookup_from_verb(from_verb_pairs(), modname, method) {
    Some(CRl("from"))
  } else {
    lookup_coherence(coherence_pairs(), modname, method)
  }

fn migrate_manual_for_call(modname: String, method: String, argc: Int, line: Int, col: Int) : Option[MigrateManual] =
  if is_array_sentinel(modname, method, argc) {
    Some(MM(line, col, "array.#{method} dropped its `default` argument in Orongo; remove it by hand once you confirm the element slot is inferred correctly"))
  } else {
    None
  }

fn is_array_sentinel(modname: String, method: String, argc: Int) : Bool =
  if modname == "array" {
    if argc == 2 {
      if method == "from" { true } else { method == "copy" }
    } else { false }
  } else { false }

#[doc("One migration report event: an automatic rename (counted), or a change that needs a human, pinned to its source pointer.")]
pub(pkg) type MigRep = MRRename | MRFileOp | MRManual(MigrateManual)

# Flatten a list of per-element report lists via the `reduce` prim,
# which runs in the runtime — so no AST 2nd-field binder ever feeds a
# bundle-local list-match, the shape kaic1 miscompiles. Callers map
# their (typed) child list to `[[MigRep]]` with the generic `map` prim
# first; `flatten_reps` is monomorphic because kaic1 does not support
# type parameters on bundle functions.
fn flatten_reps(xss: [[MigRep]]) : [MigRep] = reduce(xss, [], cat_reps)

#[doc("Append two report-event lists — the reducer used to flatten per-element scans.")]
pub(pkg) fn cat_reps(acc: [MigRep], x: [MigRep]) : [MigRep] = list_append(acc, x)

# --- report derivation ------------------------------------------------

#[doc("The number of automatic rewrites in an event list.")]
pub(pkg) fn mig_count_renames(reps: [MigRep]) : Int = list_length(filter(reps, is_rename))

fn is_rename(r: MigRep) : Bool = match r {
  MRRename -> true
  _ -> false
}

#[doc("The number of qualified `fs.file` operation calls in an event list.")]
pub(pkg) fn mig_file_op_count(reps: [MigRep]) : Int = list_length(filter(reps, is_file_op))

fn is_file_op(r: MigRep) : Bool = match r {
  MRFileOp -> true
  _ -> false
}

#[doc("The `manual:` pointers in an event list, in source order.")]
pub(pkg) fn mig_manuals(reps: [MigRep]) : [MigrateManual] =
  reduce(map(reps, rep_manual), [], cat_manuals)

fn cat_manuals(acc: [MigrateManual], x: [MigrateManual]) : [MigrateManual] = list_append(acc, x)

fn rep_manual(r: MigRep) : [MigrateManual] = match r {
  MRManual(m) -> [m]
  _ -> []
}

# --- scan pass: Expr -> [MigRep] --------------------------------------

# Scan a callee for nested calls. For a module-qualified head
# (`EField(EName(mod), m)`) this reduces to scanning `EName`, which
# yields no events, so it never double-counts the head that
# `scan_call_head` already handled.
fn scan_callee(callee: Expr) : [MigRep] = scan_expr(callee)

# Report events for the call node itself (rename or manual), given the
# already-computed arg count. The recursive scan of the arguments is
# emitted by the ECall arm, so this handles only the head.
fn scan_call_head(e: Expr, callee: Expr, argc: Int) : [MigRep] = match call_mod_method(callee) {
  None -> []
  Some(mm) -> if is_qualified_file_op(mm) { [MRFileOp] } else { scan_head_rule(e, mm, argc) }
}

fn scan_head_rule(e: Expr, mm: Pair[String, String], argc: Int) : [MigRep] = match migrate_rule_for(mm.fst, mm.snd) {
  Some(CRl(_)) -> [MRRename]
  None -> scan_head_manual(e, mm, argc)
}

fn scan_head_manual(e: Expr, mm: Pair[String, String], argc: Int) : [MigRep] =
  match migrate_manual_for_call(mm.fst, mm.snd, argc, e.line, e.col) {
    Some(man) -> [MRManual(man)]
    None -> []
  }

#[doc("Collect the migration report events for one expression.")]
pub(pkg) fn scan_expr(e: Expr) : [MigRep] = match e.kind {
  ECall(callee, cargs) ->
    list_append(list_append(scan_call_head(e, callee, list_length(cargs)), scan_callee(callee)),
                flatten_reps(map(cargs, scan_expr)))
  EField(obj, _) -> scan_expr(obj)
  EIndex(o, i) -> list_append(scan_expr(o), scan_expr(i))
  EBinop(_, l, r) -> list_append(scan_expr(l), scan_expr(r))
  EUnop(_, x) -> scan_expr(x)
  EBang(x) -> scan_expr(x)
  EPipe(l, r) -> list_append(scan_expr(l), scan_expr(r))
  EDispatchPipe(_, l, r) -> list_append(scan_expr(l), scan_expr(r))
  EIf(c, t, eo) -> list_append(list_append(scan_expr(c), scan_expr(t)), scan_opt(eo))
  EMatch(scrut, arms) -> list_append(scan_expr(scrut), flatten_reps(map(arms, scan_arm)))
  ELambda(_, body) -> scan_expr(body)
  ERecordLit(_, fields) -> flatten_reps(map(fields, scan_field))
  EList(elems) -> flatten_reps(map(elems, scan_elem))
  ERange(lo, hi, step) -> list_append(list_append(scan_expr(lo), scan_expr(hi)), scan_opt(step))
  EBlock(stmts, tail) -> list_append(flatten_reps(map(stmts, scan_stmt)), scan_opt(tail))
  ELitUnit(inner, _) -> scan_expr(inner)
  EIntrinsic(_, iargs) -> flatten_reps(map(iargs, scan_expr))
  ESurface(sf) -> flatten_reps(map(surface_children(sf), scan_expr))
  EHandle(body, _, _, io, _, cls, ro) ->
    list_append(list_append(scan_expr(body), scan_opt(io)), list_append(flatten_reps(map(cls, scan_clause)), scan_hreturn(ro)))
  _ -> []
}

# --- per-child scanners (map/flat_map prims iterate, no list-match) ----

fn scan_opt(eo: Option[Expr]) : [MigRep] = match eo {
  None -> []
  Some(x) -> scan_expr(x)
}

fn scan_arm(a: Arm) : [MigRep] = match a {
  Arm(_, g, body) -> list_append(scan_opt(g), scan_expr(body))
}

fn scan_field(fi: FieldInit) : [MigRep] = match fi {
  FI(_, x) -> scan_expr(x)
}

fn scan_elem(el: ListElem) : [MigRep] = match el {
  ElPlain(x) -> scan_expr(x)
  ElSpread(x) -> scan_expr(x)
}

fn scan_stmt(s: Stmt) : [MigRep] = match s {
  SLet(_, _, x) -> scan_expr(x)
  SExprStmt(x) -> scan_expr(x)
  SVar(_, _, x, _, _) -> scan_expr(x)
  SAssert(x, mo) -> list_append(scan_expr(x), scan_opt(mo))
  SIndexAssign(a, i, v, _, _) -> list_append(list_append(scan_expr(a), scan_expr(i)), scan_expr(v))
  SAssign(a, v, _, _) -> list_append(scan_expr(a), scan_expr(v))
  SUse(_, _, _) -> []
}

fn scan_clause(c: HClause) : [MigRep] = match c {
  HC(_, _, b, _, _) -> scan_expr(b)
}

fn scan_hreturn(ro: Option[HReturn]) : [MigRep] = match ro {
  None -> []
  Some(HR(_, b, _, _)) -> scan_expr(b)
}

#[doc("Rewrite one type annotation, flipping the two arguments of every `Result[a, b]` (recursively through lists, functions, dimensioned, refinement, and row-argument types).")]
pub(pkg) fn mig_ty(t: TypeExpr) : TypeExpr =
  with_tkind(t, mig_tykind(t.tkind))

fn with_tkind(t: TypeExpr, k: TyKind) : TypeExpr = mk_ty(k, t.line, t.col)

# The list-arg flip stays inside the fn that destructured `TyName`:
# handing a variant's `[TypeExpr]` slot to a helper that re-matches it
# corrupts under kaic1 (bundle miscompile), so `mig_result_args` runs
# the `[a, b]` match on the already-`map`ped fresh list right here.
fn mig_tykind(k: TyKind) : TyKind = match k {
  TyName(r, targs) ->
    if ref_is_result(r) { TyName(r, mig_result_args(map(targs, mig_ty))) }
    else { TyName(r, map(targs, mig_ty)) }
  TyParam(p, targs) -> TyParam(p, map(targs, mig_ty))
  TyList(el) -> TyList(mig_ty(el))
  TyFn(ps, ret, row) -> TyFn(map(ps, mig_ty), mig_ty(ret), mig_row(row))
  TyDim(base, u) -> TyDim(mig_ty(base), u)
  TyRefine(base, pred, al) -> TyRefine(mig_ty(base), pred, al)
  TyRow(row) -> TyRow(mig_row(row))
  TySurface(ts) -> match ts {
    TsTuple(tys) -> TySurface(TsTuple(map(tys, mig_ty)))
    TsUnitSpan(raw, inner) -> TySurface(TsUnitSpan(raw, mig_ty(inner)))
  }
}

# Parser output spells a type; only a resolved reference has an id to ask.
fn ref_is_result(r: DeclRef) : Bool = match r {
  DrWritten(None, n)    -> written_text(n) == "Result"
  DrWritten(Some(_), _) -> false
  DrSym(s)              -> core_ty_is(s, CtResult)
}

# Flip a two-element list; any other arity passes through. The input is
# a fresh runtime list (post-`map`), so this list-match is safe.
fn mig_result_args(ts: [TypeExpr]) : [TypeExpr] = match ts {
  [a, b] -> [b, a]
  _ -> ts
}

fn mig_row(row: RowExpr) : RowExpr = match row {
  REmpty -> REmpty
  RClosed(ls) -> RClosed(map(ls, mig_row_label))
  ROpen(tail, ls) -> ROpen(tail, map(ls, mig_row_label))
}

fn mig_row_label(l: RowLabel) : RowLabel = match l {
  RL(r, targs) -> RL(r, map(targs, mig_ty))
}

#[doc("Flip Result in an optional type annotation, leaving `None` untouched.")]
pub(pkg) fn mig_ty_opt(to: Option[TypeExpr]) : Option[TypeExpr] = match to {
  None -> None
  Some(t) -> Some(mig_ty(t))
}

#[doc("Flip Result in every parameter's declared type, preserving name/line/col/borrow.")]
pub(pkg) fn mig_params(ps: [Param]) : [Param] = map(ps, mig_param)

fn mig_param(p: Param) : Param =
  Param { binder: p.binder, ptype: mig_ty_opt(p.ptype),
          pline: p.pline, pcol: p.pcol, pborrow: p.pborrow }

fn mig_ty_opt_if(flip: Bool, to: Option[TypeExpr]) : Option[TypeExpr] =
  if flip { mig_ty_opt(to) } else { to }

fn mig_params_if(flip: Bool, ps: [Param]) : [Param] =
  if flip { mig_params(ps) } else { ps }

#[doc("Flip Result in a list of type arguments (impl tparam-args, ctor arg types).")]
pub(pkg) fn mig_tys(ts: [TypeExpr]) : [TypeExpr] = map(ts, mig_ty)

#[doc("Flip Result inside a type body: record field types, sum variant argument types, and alias targets.")]
pub(pkg) fn mig_type_body(b: TypeBody) : TypeBody = match b {
  TBAlias(t) -> TBAlias(mig_ty(t))
  TBRecord(fds) -> TBRecord(map(fds, mig_field_decl))
  TBSum(vs) -> TBSum(map(vs, mig_variant))
  TBEffectAlias(ls) -> TBEffectAlias(ls)
}

fn mig_field_decl(fd: FieldDecl) : FieldDecl = match fd {
  FD(pub_, name, t, attrs, nl, nc) -> FD(pub_, name, mig_ty(t), attrs, nl, nc)
}

fn mig_variant(v: Variant) : Variant = match v {
  Var(name, vargs, nl, nc) -> Var(name, mig_tys(vargs), nl, nc)
}

#[doc("Flip Result in an effect op's parameter and return types.")]
pub(pkg) fn mig_effect_op(op: EffectOp) : EffectOp = match op {
  EffOp(name, tps, ps, ret, l, c) -> EffOp(name, tps, mig_params(ps), mig_ty(ret), l, c)
}

#[doc("Flip Result in a protocol op's parameter and return types.")]
pub(pkg) fn mig_proto_op(op: ProtoOp) : ProtoOp = match op {
  POp(name, tps, ps, ret, l, c) -> POp(name, tps, mig_params(ps), mig_ty(ret), l, c)
}

# --- flip counter (report honesty) ------------------------------------
# Count every two-argument `Result[_, _]` a flip visits, so the driver
# reports the real number of annotation rewrites rather than only the
# call renames.

#[doc("Count the two-argument `Result` annotations inside one type (each is one flip).")]
pub(pkg) fn mig_ty_flips(t: TypeExpr) : Int = mig_tykind_flips(t.tkind)

fn mig_tykind_flips(k: TyKind) : Int = match k {
  TyName(r, targs) -> add_int(result_here(r, targs), sum_flips(map(targs, mig_ty_flips)))
  TyParam(_, targs) -> sum_flips(map(targs, mig_ty_flips))
  TyList(el) -> mig_ty_flips(el)
  TyFn(ps, ret, row) -> add_int(add_int(sum_flips(map(ps, mig_ty_flips)), mig_ty_flips(ret)), mig_row_flips(row))
  TyDim(base, _) -> mig_ty_flips(base)
  TyRefine(base, _, _) -> mig_ty_flips(base)
  TyRow(row) -> mig_row_flips(row)
  TySurface(ts) -> match ts {
    TsTuple(tys) -> sum_flips(map(tys, mig_ty_flips))
    TsUnitSpan(_, inner) -> mig_ty_flips(inner)
  }
}

fn result_here(r: DeclRef, targs: [TypeExpr]) : Int =
  if ref_is_result(r) { if list_length(targs) == 2 { 1 } else { 0 } } else { 0 }

fn mig_row_flips(row: RowExpr) : Int = match row {
  REmpty -> 0
  RClosed(ls) -> sum_flips(map(ls, mig_row_label_flips))
  ROpen(_, ls) -> sum_flips(map(ls, mig_row_label_flips))
}

fn mig_row_label_flips(l: RowLabel) : Int = match l {
  RL(_, targs) -> sum_flips(map(targs, mig_ty_flips))
}

fn add_int(a: Int, b: Int) : Int = a + b
fn sum_flips(ns: [Int]) : Int = reduce(ns, 0, add_int)

#[doc("Count Result flips in an optional annotation.")]
pub(pkg) fn mig_ty_opt_flips(to: Option[TypeExpr]) : Int = match to {
  None -> 0
  Some(t) -> mig_ty_flips(t)
}

#[doc("Count Result flips across a parameter list.")]
pub(pkg) fn mig_params_flips(ps: [Param]) : Int = sum_flips(map(ps, mig_param_flips))

fn mig_param_flips(p: Param) : Int = mig_ty_opt_flips(p.ptype)

# Count Result flips in type annotations that live inside an expression
# body — `let`/`var` annotations and lambda parameter types. Mirrors the
# rewrite walk's descent so the report count matches what changed.
#[doc("Count Result flips in the type annotations nested inside one expression body.")]
pub(pkg) fn expr_flip_count(e: Expr) : Int = match e.kind {
  EBlock(stmts, tail) -> add_int(sum_flips(map(stmts, stmt_flip_count)), opt_flip_count(tail))
  ELambda(ps, body) -> add_int(mig_params_flips(ps), expr_flip_count(body))
  EIf(c, t, eo) -> add_int(add_int(expr_flip_count(c), expr_flip_count(t)), opt_flip_count(eo))
  EMatch(scrut, arms) -> add_int(expr_flip_count(scrut), sum_flips(map(arms, arm_flip_count)))
  ECall(callee, cargs) -> add_int(expr_flip_count(callee), sum_flips(map(cargs, expr_flip_count)))
  EField(obj, _) -> expr_flip_count(obj)
  EIndex(o, i) -> add_int(expr_flip_count(o), expr_flip_count(i))
  EBinop(_, l, r) -> add_int(expr_flip_count(l), expr_flip_count(r))
  EUnop(_, x) -> expr_flip_count(x)
  EBang(x) -> expr_flip_count(x)
  EPipe(l, r) -> add_int(expr_flip_count(l), expr_flip_count(r))
  EDispatchPipe(_, l, r) -> add_int(expr_flip_count(l), expr_flip_count(r))
  ERecordLit(_, fields) -> sum_flips(map(fields, field_init_flip_count))
  EList(elems) -> sum_flips(map(elems, elem_flip_count))
  ERange(lo, hi, step) -> add_int(add_int(expr_flip_count(lo), expr_flip_count(hi)), opt_flip_count(step))
  ELitUnit(inner, _) -> expr_flip_count(inner)
  EIntrinsic(_, iargs) -> sum_flips(map(iargs, expr_flip_count))
  ESurface(sf) -> sum_flips(map(surface_children(sf), expr_flip_count))
  _ -> 0
}

fn opt_flip_count(eo: Option[Expr]) : Int = match eo {
  None -> 0
  Some(x) -> expr_flip_count(x)
}

fn stmt_flip_count(s: Stmt) : Int = match s {
  SLet(_, t, x) -> add_int(mig_ty_opt_flips(t), expr_flip_count(x))
  SVar(_, t, x, _, _) -> add_int(mig_ty_opt_flips(t), expr_flip_count(x))
  SExprStmt(x) -> expr_flip_count(x)
  SAssert(x, mo) -> add_int(expr_flip_count(x), opt_flip_count(mo))
  SIndexAssign(a, i, v, _, _) -> add_int(add_int(expr_flip_count(a), expr_flip_count(i)), expr_flip_count(v))
  SAssign(a, v, _, _) -> add_int(expr_flip_count(a), expr_flip_count(v))
  SUse(_, _, _) -> 0
}

fn arm_flip_count(a: Arm) : Int = match a {
  Arm(_, g, body) -> add_int(opt_flip_count(g), expr_flip_count(body))
}

fn field_init_flip_count(fi: FieldInit) : Int = match fi {
  FI(_, x) -> expr_flip_count(x)
}

fn elem_flip_count(el: ListElem) : Int = match el {
  ElPlain(x) -> expr_flip_count(x)
  ElSpread(x) -> expr_flip_count(x)
}
