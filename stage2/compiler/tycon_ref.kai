#[doc("""
The nominal type a written reference names.

A written type or record name carries a `DeclRef`: the declaration it was
resolved to, or the text the source wrote. The declaration decides
whenever it is known; a written qualifier is resolved through its module;
an unqualified, unresolved name climbs the reader's ladder.
""")]

import compiler.ast
import compiler.written
import compiler.tycon_scheme_home

#[doc("`tsh_tycon` for a reference `r`: the declaration it denotes, whatever the reader declares under the same name; the reader's ladder when it denotes none.")]
pub fn tsh_tycon_at(v: TyHomeView, r: DeclRef, args: [Ty]) : Ty = match r {
  DrSym(s)        -> TyCon(s, args)
  DrWritten(_, n) -> {
    let s = tsh_ref_sym(v, r)
    if sym_raw(s) < 0 { tsh_tycon(v, written_text(n), args) } else { TyCon(s, args) }
  }
}

#[doc("The declaration a reference denotes without the reader's ladder: the one it carries, or the one its written qualifier's module declares under its name.")]
pub fn tsh_ref_sym(v: TyHomeView, r: DeclRef) : SymId = match r {
  DrSym(s)              -> s
  DrWritten(None, _)    -> sym_none()
  DrWritten(Some(q), n) -> match v { THV(hs, _) -> tsh_decl_sym(hs, Some(written_text(q)), written_text(n)) }
}
