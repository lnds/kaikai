#[doc("""
The nominal type a written reference names.

A written type or record name carries a `DeclRef`: the declaration it was
resolved to, or the qualifier the source wrote. The declaration decides
whenever it is known; a written qualifier is resolved through its module;
an unqualified, unresolved name climbs the reader's ladder.
""")]

import compiler.ast
import compiler.tycon_scheme_home

#[doc("`tsh_tycon` for a written reference `r`: the declaration it denotes, whatever the reader declares under the same name; the reader's ladder when it denotes none.")]
pub fn tsh_tycon_at(v: TyHomeView, r: DeclRef, nm: String, args: [Ty]) : Ty = {
  let s = tsh_ref_sym(v, r, nm)
  if sym_raw(s) < 0 { tsh_tycon(v, nm, args) } else { TyCon(tsh_sym_slot(v, nm, s), nm, args, s) }
}

#[doc("The declaration a written reference denotes: the one it carries, or the one its written qualifier's module declares under `nm`.")]
pub fn tsh_ref_sym(v: TyHomeView, r: DeclRef, nm: String) : SymId = match r {
  DrSym(s)              -> s
  DrWritten(None, _)    -> sym_none()
  DrWritten(Some(q), _) -> match v { THV(hs, _) -> tsh_decl_sym(hs, Some(q), nm) }
}
