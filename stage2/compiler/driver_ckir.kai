#[doc("The C backend: the program lowered to KIR, then printed as one C translation unit.")]

import compiler.driver_cli
import compiler.driver_mono
import compiler.emit_native_core
import compiler.emit_shared_syms
import compiler.fnreg
import compiler.kir_c_fn
import compiler.kir_c_modular
import compiler.kir_c_prog
import compiler.kir_inline
import compiler.kir_lower_fns
import compiler.kir_tail
import compiler.util

pub(pkg) fn emit_ckir(req: Req, cx: PerceusRun) : Int / Console + File + Mutable {
  let batch_out = req.batch_out
  let bmode = cx.prev.bmode
  let emit_tab = cx.prev.prev.emit_tab
  let entry = cx.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.entry
  let perceus_decls = cx.perceus_decls
  let proto_reg = cx.prev.prev.prev.proto_reg
  let raw_arm_binders = cx.prev.raw_arm_binders
  let region_marks = cx.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.region_marks
  let specs = cx.prev.prev.specs
  let stamp_ids = cx.prev.prev.prev.prev.prev.prev.prev.prev.stamp_ids
  let target_mod_name = cx.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.prev.target_mod_name
  let nfns = register_fn_decls(perceus_decls, emit_tab, specs, entry)
  let nvariants = register_variants(perceus_decls, emit_tab)
  let lowered = lower_to_kir(perceus_decls, emit_tab, specs, proto_reg.ids, region_marks, nfns, nvariants, Some(target_mod_name), raw_arm_binders, false, stamp_ids, entry)
  let kp = ncore_prune_unreachable(kir_tail_program(kir_inline_program(lowered), target_mod_name), perceus_decls, nfns, bmode, [])
  let ps = KcFnPrinters { def: kc_fn_def, proto: kc_fn_proto, thunk: kc_fn_thunk }
  let out = match req.backend {
    BkCKirModular -> kc_modular_stream(kc_program_modular(kp, ps, bmode, perceus_decls, nfns, nvariants), cat2("k748x", int_to_string(string_length(req.src))))
    _             -> kc_program(kp, ps, bmode, perceus_decls, nfns, nvariants)
  }
  match batch_out {
    Some(op) -> match write_file(op, cat2(out, "\n")) {
      Ok(_)  -> 0
      Err(e) -> { eprint("kaic2: cannot write `#{op}`: #{e}"); 1 }
    }
    None -> { print(out); 0 }
  }
}
