#[doc("""
The references a KIR linearity ledger still owes, reported by the
registers that name them.
""")]

import compiler.util
import compiler.kir_lin_state

#[doc("Every object still holding an owned reference, as a leak.")]
pub fn kls_leaks(st: LinSt) : [LinV] = kls_owing(st, st.creds, (o) => true, "leak")

#[doc("True when a register in `live` names object `o`.")]
pub fn kls_named_live(xs: [(String, Int)], o: Int, live: [String]) : Bool =
  any(xs, (kv) => match kv { (k, oo) -> oo == o and list_has(live, k) })

#[doc("The objects of `cs` still owed and picked by `pick`, as violations of `kind`.")]
pub fn kls_owing(st: LinSt, cs: [(Int, Int)], pick: (Int) -> Bool, kind: String) : [LinV] = match cs {
  []                -> []
  [(o, c), ...rest] -> {
    let tl = kls_owing(st, rest, pick, kind)
    if c > 0 and c < UNTRACKED and pick(o) { [LinV(kind, kls_label(st.names, o)), ...tl] } else { tl }
  }
}

# The first three registers naming `o`, sorted.
fn kls_label(xs: [(String, Int)], o: Int) : String = {
  let ns = kls_sort(map(filter(xs, (kv) => match kv { (_, oo) -> oo == o }), (kv) => match kv { (k, _) -> k }))
  match ns {
    [] -> "?"
    _  -> string_join(kls_first3(ns), ",")
  }
}

fn kls_first3(xs: [String]) : [String] = match xs {
  [a, b, c, ..._] -> [a, b, c]
  _               -> xs
}

#[doc("`xs` in ascending order.")]
pub fn kls_sort(xs: [String]) : [String] = match xs {
  []           -> []
  [x, ...rest] -> kls_insert(x, kls_sort(rest))
}

fn kls_insert(x: String, ys: [String]) : [String] = match ys {
  []           -> [x]
  [y, ...rest] -> if string_lt(x, y) { [x, y, ...rest] } else { [y, ...kls_insert(x, rest)] }
}
