#[doc("""
The identities the late passes can read: each `SymId` the program's own
functions carry into unbox and into Perceus, and each one a `KPerform`
carries out of the KIR lowering, decoded against the symbol table. Core
modules are left out.

A line is `<stage> <fn> <written>#<id> <decl>@<home>`, the written name
carrying `/<k>` when it names the k-th specialisation. The written name
is what the tree spells; the declaration and home are what the id
decodes to, so an id that survives but names another declaration shows
up as a mismatch instead of passing silently.

An `efn` line is one registry entry, `efn <written>#<id> <decl>@<home>
<class>`, its signature class read back through the id alone —
so a specialisation that shared its template's identity would report
the template's class.
""")]

import compiler.ast
import compiler.expr_positions
import compiler.symtab
import compiler.kir
import compiler.fnreg
import compiler.fn_index
import compiler.effect_instance

type SdRef = SdRef(SymId, Int, String)

#[doc("One line per resolved reference in the bodies of the functions outside the `core` modules, tagged with `stage`.")]
pub fn symid_decl_lines(stage: String, tab: SymTab, core: [String], ds: [Decl]) : [String] = match ds {
  []           -> []
  [d, ...rest] -> sd_decl(stage, tab, core, d) ++ symid_decl_lines(stage, tab, core, rest)
}

#[doc("One line per `KPerform` in the functions outside the `core` modules, with the effect id it carries.")]
pub fn symid_kir_lines(tab: SymTab, core: [String], kp: KProgram) : [String] = sd_kfns(tab, core, kp.fns)

fn sd_decl(stage: String, tab: SymTab, core: [String], d: Decl) : [String] = match d {
  DFn(_, n, _, _, _, _, body, _, _, mo, _) ->
    if sd_is_user(mo, core) { map(list_reverse(sd_refs(body, [])), (r) => sd_ref_line(stage, n, tab, r)) } else { [] }
  _ -> []
}

fn sd_is_user(mo: Option[String], core: [String]) : Bool = match mo {
  None    -> true
  Some(m) -> not sd_has(core, m)
}

fn sd_has(xs: [String], x: String) : Bool = match xs {
  []           -> false
  [h, ...rest] -> h == x or sd_has(rest, x)
}

fn sd_refs(e: Expr, acc: [SdRef]) : [SdRef] = match e.kind {
  ESym(s, inst, n) -> if sym_is_local(s) { acc } else { [SdRef(s, inst, n), ...acc] }
  EHandle(_, en, hs, _, _, _, _, _) ->
    sd_refs_ps(xp_positions(e), [SdRef(hs, spec_none(), string_concat("with ", en)), ...acc])
  _          -> sd_refs_ps(xp_positions(e), acc)
}

fn sd_refs_ps(ps: [XPos], acc: [SdRef]) : [SdRef] = match ps {
  []                  -> acc
  [XP(_, c), ...rest] -> sd_refs_ps(rest, sd_refs(c, acc))
}

fn sd_ref_line(stage: String, fname: String, tab: SymTab, r: SdRef) : String = match r {
  SdRef(s, inst, n) -> sd_line(stage, fname, sd_written(n, inst), tab, s)
}

# A specialisation decodes to its template, so the line names which instance.
fn sd_written(n: String, inst: Int) : String =
  if inst == spec_none() { n } else { concat_all([n, "/", int_to_string(inst)]) }

fn sd_line(stage: String, fname: String, written: String, tab: SymTab, s: SymId) : String =
  concat_all([stage, " ", fname, " ", sd_ref(written, tab, s)])

fn sd_ref(written: String, tab: SymTab, s: SymId) : String =
  concat_all([written, "#", int_to_string(sym_raw(s)), " ", sym_name(tab, s), "@", sym_home(tab, s)])

#[doc("One line per function, type, effect and protocol outside the `core` modules, with the identity its own declaration carries: `own <kind> <name>#<id> <decl>@<home>`. This is what the KIR lowering reads off the declaration stream, so a declaration stripped of its id on the way shows as `#-1`.")]
pub fn symid_own_lines(tab: SymTab, core: [String], ds: [Decl]) : [String] = match ds {
  []           -> []
  [d, ...rest] -> sd_own(tab, core, d) ++ symid_own_lines(tab, core, rest)
}

fn sd_own(tab: SymTab, core: [String], d: Decl) : [String] = match d {
  DFn(_, n, _, _, _, _, _, _, _, mo, fid) ->
    if sd_is_user(mo, core) { [sd_line("own", "fn", n, tab, fnid_sym(fid))] } else { [] }
  DType(_, n, _, _, _, _, mo, _, s) ->
    if sd_is_user(mo, core) { [sd_line("own", "type", n, tab, s)] } else { [] }
  DEffect(_, n, _, _, _, _, _, mo, s) ->
    if sd_is_user(mo, core) { [sd_line("own", "effect", n, tab, s)] } else { [] }
  DProtocol(_, n, _, _, _, _, mo, s) ->
    if sd_is_user(mo, core) { [sd_line("own", "protocol", n, tab, s)] } else { [] }
  _ -> []
}

#[doc("One line per registry entry of the functions outside the `core` modules that carries an identity.")]
pub fn symid_efn_lines(tab: SymTab, core: [String], fns: [EFn]) : [String] = sd_efns(tab, core, fnx_build(fns), fns)

fn sd_efns(tab: SymTab, core: [String], fx: FnIndex, fns: [EFn]) : [String] = match fns {
  []           -> []
  [e, ...rest] -> sd_efn(tab, core, fx, e) ++ sd_efns(tab, core, fx, rest)
}

fn sd_efn(tab: SymTab, core: [String], fx: FnIndex, e: EFn) : [String] = match e {
  EFn(n, _, mo, _, fid) ->
    if sd_is_user(mo, core) and sym_raw(fnid_sym(fid)) >= 0 {
      [concat_all(["efn ", sd_ref(sd_written(n, fnid_inst(fid)), tab, fnid_sym(fid)), " ", sd_class(fnx_ufn_sig_sym(fx, fid))])]
    } else { [] }
}

# `raw=<one bit per param>><ret bit>`, a set bit being a raw scalar slot.
fn sd_class(sig: Option[UFnSig]) : String = match sig {
  Some(US(_, rt, mask)) -> concat_all(["raw=", sd_bits(mask), ">", if ty_is_unboxable_t(rt) { "1" } else { "0" }])
  None                  -> "boxed"
}

fn sd_bits(bs: [Bool]) : String = match bs {
  []           -> ""
  [b, ...rest] -> cat2(if b { "1" } else { "0" }, sd_bits(rest))
}

fn sd_kfns(tab: SymTab, core: [String], fns: [KFn]) : [String] = match fns {
  []           -> []
  [f, ...rest] ->
    (if sd_is_user(f.mo, core) { sd_blocks(tab, f.sym, f.blocks) } else { [] }) ++ sd_kfns(tab, core, rest)
}

fn sd_blocks(tab: SymTab, fname: String, bs: [KBlock]) : [String] = match bs {
  []           -> []
  [b, ...rest] -> sd_stmts(tab, fname, b.stmts) ++ sd_blocks(tab, fname, rest)
}

fn sd_stmts(tab: SymTab, fname: String, ss: [KStmt]) : [String] = match ss {
  []           -> []
  [s, ...rest] -> sd_stmt(tab, fname, s) ++ sd_stmts(tab, fname, rest)
}

fn sd_stmt(tab: SymTab, fname: String, s: KStmt) : [String] = match s {
  KLet(_, _, op, _) -> sd_op(tab, fname, op)
  KDo(op, _)        -> sd_op(tab, fname, op)
  _                 -> []
}

fn sd_op(tab: SymTab, fname: String, op: KOp) : [String] = match op {
  KPerform(eff, s, o, _) -> [sd_line("kperform", fname, concat_all([inst_key_eff(eff), ".", o]), tab, s)]
  _                      -> []
}
