#[doc("""
Drops and tails of match arms: arm binder drops, borrowed scrutinees and self tail calls, and the interprocedural borrow map built from them.
""")]

import compiler.ast
import compiler.ret_slots
import compiler.expr_positions
import compiler.perceus_payer
import compiler.perceus_exit_drops
import compiler.borrow_infer
import compiler.perceus_reads
import compiler.self_call
import compiler.symtab
import compiler.perceus_borrow
import compiler.perceus_linear
import compiler.consume_index
import compiler.fnreg

#[doc("Whether a self tail call's arguments may be hoisted, and the fn's borrowed boxed slots, whose bare reads the hoist keeps in place.")]
pub type PcsHoist = { ok: Bool, bpos: [Int] }

#[doc("""
The arm binders' payers. An arm binder takes its birth ref at bind time
(`kai_incref` in `emit_pat_binds`); when no read hands it on, a drop
between the body's statements and its tail releases it. A binder read in
the tail cannot take that drop — it would fire before the read — and a
non-block body that is itself a self-tail-call cannot be wrapped without
hiding the call from `tcrec_rewrite_decls`.

Runs after `pcs_rewrite_expr`, so it sees the dup-wrapped reads, and
before `pcs_recognise_reuse_expr`, so the reuse rewrite sees the drops.
The read table plus the binders the rewrite moves on every read. A
move-at-last-use binder is not one: the paths that skip its last read
still owe a drop. A forced binder's dup'd read is paid
by the guard-fail and goto planters, never here: an arm drop planted for it
would read, to the branch payer, as its single read.
`boxed_bpos` gates the after-args drop: a reference bound in a borrowed
self slot would lose the borrow strip's view of it.
`borrow_only` binders are released on arm entry (`perceus_rethread`); an
arm re-checks its own, since two scopes may bind one name.
""")]
pub type PcsArmCx = { uses: UseIx, moved: [Binder], boxed_bpos: [Int], borrow_only: [Binder],
                  borrowed: [Binder], bmap: BorrowMap, forced: [Binder] }

pub(pkg) fn pcs_collect_arm_drops(bound: [Binder], ln: Int, cl: Int, body: Expr, opt_g: Option[Expr],
                         cx: PcsArmCx, pre_tail: Bool, acc: [Stmt]) : [Stmt] = match bound {
  [] -> list_reverse(acc)
  [nm, ...rest] -> {
    let acc1 =
      if pre_tail and pcs_name_in_body_tail(nm, body) { acc }
      else if pcs_guard_has_bare_read(nm, opt_g) { acc }
      else if pcs_pays(pcs_arm_payer(nm.id, cx.uses, pcs_has(cx.moved, nm.id), pcs_has(cx.forced, nm.id)), PyExit) {
        [pcs_make_drop_stmt(nm.id, ln, cl), ...acc]
      } else { acc }
    pcs_collect_arm_drops(rest, ln, cl, body, opt_g, cx, pre_tail, acc1)
  }
}

fn pcs_guard_has_bare_read(nm: Binder, opt_g: Option[Expr]) : Bool = match opt_g {
  None    -> false
  Some(g) -> pcs_has_bare_read(nm, g)
}

pub(pkg) fn pcs_arm_tail_drop_body(body: Expr, bound: [Binder], ln: Int, cl: Int,
                          opt_g: Option[Expr], uses: UseIx, fn_name: SelfRef, hoist: PcsHoist, tab: SymTab) : Expr =
  match body.kind {
    EBlock(stmts, opt_tail) -> match opt_tail {
      Some(t) -> match pcs_collect_arm_tail_drops(bound, ln, cl, body, opt_g, uses, []) {
        []    -> body
        drops -> {
          let t1 = if pcs_is_self_tail_call(t, fn_name) { pcs_distribute_dead_drops(t, drops, fn_name, hoist, [], bound, tab) }
                   else { pcs_arm_ret_wrap(t, drops) }
          Expr { kind: EBlock(stmts, Some(t1)), line: body.line, col: body.col, ty: body.ty, mode: body.mode,  site: body.site }
        }
      }
      None -> body
    }
    _ -> body
  }

fn pcs_collect_arm_tail_drops(bound: [Binder], ln: Int, cl: Int, body: Expr,
                              opt_g: Option[Expr], uses: UseIx, acc: [Stmt]) : [Stmt] =
  match bound {
    [] -> list_reverse(acc)
    [nm, ...rest] -> {
      let acc1 =
        if not pcs_name_in_body_tail(nm, body) { acc }
        # A bare read anywhere in the arm is a move: it pays the birth ref
        # on its own path, so a distributed drop would release it twice.
        # Only a binder whose every read keeps its dup is orphaned. A bare
        # guard read is the same move one edge earlier.
        else if pcs_has_bare_read(nm, body) { acc }
        else if pcs_guard_has_bare_read(nm, opt_g) { acc }
        else if pcs_read_count(nm.id, uses) >= 1 and not pcs_uses_have_in_lam(uses, nm.id) {
          [pcs_make_drop_stmt(nm.id, ln, cl), ...acc]
        } else { acc }
      pcs_collect_arm_tail_drops(rest, ln, cl, body, opt_g, uses, acc1)
    }
  }

fn pcs_has_bare_read(nm: Binder, e: Expr) : Bool = match e.kind {
  ELocal(u)             -> local_eq(u, nm.id)
  ECall(f, xs)          -> match f.kind {
    EMark(MkDup) -> false
    _ -> pcs_has_bare_read(nm, f) or pcs_hbr_list(nm, xs)
  }
  ELambda(_, body)      -> pcs_name_in_expr(nm, body)
  _                     -> pcs_hbr_ps(nm, xp_positions(e))
}

fn pcs_hbr_ps(nm: Binder, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> pcs_has_bare_read(nm, c) or pcs_hbr_ps(nm, rest)
}

fn pcs_hbr_list(nm: Binder, xs: [Expr]) : Bool = match xs {
  []           -> false
  [h, ...rest] -> pcs_has_bare_read(nm, h) or pcs_hbr_list(nm, rest)
}

pub(pkg) fn pcs_inject_arm_drops(body: Expr, drops: [Stmt], fn_name: SelfRef, hoist: PcsHoist, who: [Binder], tab: SymTab) : Expr {
  match body.kind {
    EBlock(stmts, opt_tail) ->
      Expr { kind: EBlock(list_append(stmts, drops), opt_tail),
             line: body.line, col: body.col, ty: body.ty, mode: body.mode,  site: body.site }
    _ -> {
      if pcs_is_self_tail_call(body, fn_name) {
        pcs_distribute_dead_drops(body, drops, fn_name, hoist, [], who, tab)
      }
      else { pcs_arm_ret_wrap(body, drops) }
    }
  }
}

pub(pkg) fn pcs_return_binder_paid(nm: Binder, body: Expr, uses: UseIx, forced: [Binder], ln: Int, cl: Int) : Expr =
  if pcs_pays(pcs_arm_payer(nm.id, uses, false, pcs_has(forced, nm.id)), PyExit) {
    pcs_arm_ret_wrap(body, [pcs_make_drop_stmt(nm.id, ln, cl)])
  } else { body }

# `{ let __pcs_arm_ret = body; drops; __pcs_arm_ret }`: the TRMC rewrite
# peels this exact shape and replants its drops.
fn pcs_arm_ret_wrap(body: Expr, drops: [Stmt]) : Expr = {
  let ret_let = SLet(Pattern { pkind: PBind(ret_slot_binder(RsArm)), line: body.line, col: body.col }, None, body)
  let tail = Expr { kind: ELocal(ret_slot_local(RsArm)), line: body.line, col: body.col, ty: body.ty, mode: body.mode,  site: body.site }
  Expr { kind: EBlock([ret_let, ...drops], Some(tail)), line: body.line, col: body.col, ty: body.ty, mode: body.mode,  site: body.site }
}

# Close each tail leaf of `body` for `drops`: the goto skips every exit.
# A self-tail-call leaf drops a binder it never mentions before the call,
# and one it reads only through dups after the hoisted args (`hoist.ok`),
# since the borrow strip may later turn a dup into a bare read the goto
# ledger takes for a move; a binder with a bare read pays on its own path.
# A modulo-cons leaf is left to the TRMC rewrite. A value leaf releases,
# after its value is built, every binder it does not move except those in
# `held`, the binders a nested scope declares. `who` lists the binders the
# drops release.
fn pcs_distribute_dead_drops(body: Expr, drops: [Stmt], fn_name: SelfRef, hoist: PcsHoist, held: [Binder], who: [Binder], tab: SymTab) : Expr =
  Expr { kind: pcs_dd_kind(body.kind, body.line, body.col, body.ty, body.mode, drops, fn_name, hoist, held, who, tab),
         line: body.line, col: body.col, ty: body.ty, mode: body.mode,  site: body.site }

fn pcs_dd_kind(k: ExprKind, ln: Int, cl: Int, ty: Option[Ty], mode: ValueMode, drops: [Stmt], fn_name: SelfRef,
               hoist: PcsHoist, held: [Binder], who: [Binder], tab: SymTab) : ExprKind {
  match k {
    EIf(c, t, opt_e) ->
      EIf(c, pcs_distribute_dead_drops(t, drops, fn_name, hoist, held, who, tab),
          match opt_e { None -> None Some(e) -> Some(pcs_distribute_dead_drops(e, drops, fn_name, hoist, held, who, tab)) })
    EMatch(s, arms) -> EMatch(s, pcs_dd_arms(arms, drops, fn_name, hoist, held, who, tab))
    EBlock(stmts, opt_tail) -> match opt_tail {
      Some(t) ->
        if ppd_is_hoist_block(stmts) { pcs_dd_hoisted(Expr { kind: k, line: ln, col: cl, ty: ty, mode: mode , site: 0 }, drops, hoist, who) }
        else { EBlock(stmts, Some(pcs_dd_scoped(t, drops, fn_name, hoist, held, ppd_let_names(stmts), who, tab))) }
      None    -> k
    }
    _ -> pcs_dd_leaf(Expr { kind: k, line: ln, col: cl, ty: ty, mode: mode , site: 0 }, drops, fn_name, hoist, held, who, tab)
  }
}

fn pcs_dd_leaf(leaf: Expr, drops: [Stmt], fn_name: SelfRef, hoist: PcsHoist, held: [Binder], who: [Binder], tab: SymTab) : ExprKind =
  if pcs_is_self_tail_call(leaf, fn_name) { pcs_dd_goto_leaf(leaf, drops, hoist, who) }
  else if pcs_is_modcons_leaf(leaf, fn_name, tab) { leaf.kind }
  else {
    match filter(pcs_unmoved_names(drops, leaf, who), (nm) => not pcs_has(held, nm.id)) {
      []    -> leaf.kind
      names -> ppd_bind_then(leaf, ppd_drops(names, leaf.line, leaf.col)).kind
    }
  }

fn pcs_dd_goto_leaf(leaf0: Expr, drops: [Stmt], hoist: PcsHoist, who: [Binder]) : ExprKind = {
  let leaf = pcs_dd_pay_paths(drops, leaf0, who)
  let owed = if hoist.ok { filter(drops, (d) => pcs_drop_owed_in(d, leaf, who)) } else { [] }
  let paid = match owed { [] -> leaf  _ -> ppd_hoist_then(leaf, owed, hoist.bpos) }
  match pcs_drops_dead_in(drops, leaf, who) {
    []   -> paid.kind
    dead -> EBlock(dead, Some(paid))
  }
}

fn pcs_dd_arms(arms: [Arm], drops: [Stmt], fn_name: SelfRef, hoist: PcsHoist, held: [Binder], who: [Binder], tab: SymTab) : [Arm] = match arms {
  []           -> []
  [a, ...rest] -> match a {
    Arm(pat, opt_g, body) ->
      [Arm(pat, opt_g, pcs_dd_scoped(body, drops, fn_name, hoist, held, prc_pat_bindings(pat, []), who, tab)),
       ...pcs_dd_arms(rest, drops, fn_name, hoist, held, who, tab)]
  }
}

# The binder a drop releases, of those in `who`: the statement names it by
# identity alone.
fn pcs_drop_binder(d: Stmt, who: [Binder]) : Option[Binder] = match ppd_drop_name(d) {
  Some(l) -> pcs_binder_of(who, l)
  None    -> None
}

fn pcs_binder_of(bs: [Binder], l: LocalId) : Option[Binder] = match bs {
  []           -> None
  [b, ...rest] -> if local_eq(b.id, l) { Some(b) } else { pcs_binder_of(rest, l) }
}

# The binders of `drops` the leaf does not move.
fn pcs_unmoved_names(drops: [Stmt], leaf: Expr, who: [Binder]) : [Binder] = match drops {
  []           -> []
  [d, ...rest] -> {
    let tl = pcs_unmoved_names(rest, leaf, who)
    match pcs_drop_binder(d, who) {
      Some(nm) -> if pcs_has_bare_read(nm, leaf) { tl } else { [nm, ...tl] }
      None     -> tl
    }
  }
}

# Under a scope binding `names`: a rebound name would make a leaf read the
# inner binder, not the dropped one, so no drop moves past the leaf's reads.
fn pcs_dd_scoped(body: Expr, drops: [Stmt], fn_name: SelfRef, hoist: PcsHoist, held: [Binder],
                 names: [Binder], who: [Binder], tab: SymTab) : Expr =
  pcs_distribute_dead_drops(body, drops, fn_name,
                            PcsHoist { ok: hoist.ok and not any(drops, (d) => ppd_drop_among(d, names)), bpos: hoist.bpos },
                            list_append(names, held), who, tab)

# A self-call whose arguments an inner scope already hoisted: the argument
# lets are part of the leaf, so its reads there count, and an owed drop
# runs after the last of them.
fn pcs_dd_hoisted(blk: Expr, drops: [Stmt], hoist: PcsHoist, who: [Binder]) : ExprKind = {
  let paid = pcs_dd_pay_paths(drops, blk, who)
  let owed = if hoist.ok { filter(drops, (d) => pcs_drop_owed_in(d, paid, who)) } else { [] }
  let after = match paid.kind {
    EBlock(ss, t) -> EBlock(list_append(ss, owed), t)
    k             -> k
  }
  match pcs_drops_dead_in(drops, paid, who) {
    []   -> after
    dead -> EBlock(dead, Some(Expr { kind: after, line: blk.line, col: blk.col, ty: blk.ty, mode: blk.mode,  site: blk.site }))
  }
}

# A binder the leaf moves on some of its paths only: the alternatives inside
# the leaf that skip the move release it on entry.
fn pcs_dd_pay_paths(drops: [Stmt], leaf: Expr, who: [Binder]) : Expr = match drops {
  []           -> leaf
  [d, ...rest] -> pcs_dd_pay_paths(rest, match pcs_drop_binder(d, who) {
    Some(nm) -> if pcs_has_bare_read(nm, leaf) { pbl_paid(nm, leaf) } else { leaf }
    None     -> leaf
  }, who)
}

fn pcs_drop_owed_in(d: Stmt, leaf: Expr, who: [Binder]) : Bool = match pcs_drop_binder(d, who) {
  Some(nm) -> pcs_mentions(nm, leaf) and not pcs_has_bare_read(nm, leaf)
  None     -> false
}

# Drops whose binder the leaf never mentions, closure captures included —
# only those may run before the leaf's argument evaluation.
fn pcs_drops_dead_in(drops: [Stmt], leaf: Expr, who: [Binder]) : [Stmt] = match drops {
  [] -> []
  [d, ...rest] -> {
    let tl = pcs_drops_dead_in(rest, leaf, who)
    match pcs_drop_binder(d, who) {
      Some(nm) -> if pcs_mentions(nm, leaf) { tl } else { [d, ...tl] }
      None     -> tl
    }
  }
}

pub(pkg) fn pcs_is_self_tail_call(e: Expr, fn_name: SelfRef) : Bool {
  match e.kind {
    ECall(callee, _) -> is_self_callee(callee, fn_name)
    # A `match`, `if`, or `block` body may itself host a self-tail-call
    # in a tail-leaf position. Wrapping such a body in `__pcs_arm_ret`
    # would hide that call from `tcrec_rewrite_decls` and emit a real
    # recursive C call — same regression #342 worked around. Recurse
    # into tail-leaves and decline to wrap when any leaf is a
    # self-tail-call.
    EMatch(_, arms) -> pcs_arms_have_self_tail(arms, fn_name)
    EIf(_, t, opt_e) -> {
      if pcs_is_self_tail_call(t, fn_name) { true }
      else {
        match opt_e {
          None -> false
          Some(e2) -> pcs_is_self_tail_call(e2, fn_name)
        }
      }
    }
    EBlock(_, opt_tail) -> match opt_tail {
      None -> false
      Some(t) -> pcs_is_self_tail_call(t, fn_name)
    }
    _ -> false
  }
}

fn pcs_arms_have_self_tail(arms: [Arm], fn_name: SelfRef) : Bool {
  match arms {
    [] -> false
    [a, ...rest] -> match a {
      Arm(_, _, body) ->
        if pcs_is_self_tail_call(body, fn_name) { true }
        else { pcs_arms_have_self_tail(rest, fn_name) }
    }
  }
}

# True iff `nm` appears in the part of `body` a pre-tail drop would precede:
# the tail of a block (the whole block when a self-call hoist built it —
# its temps carry the call's args), or all of a non-block body.
fn pcs_name_in_body_tail(nm: Binder, body: Expr) : Bool = match body.kind {
  EBlock(stmts, opt_tail) ->
    if ppd_is_hoist_block(stmts) { pcs_mentions(nm, body) }
    else { match opt_tail { None -> false  Some(t) -> pcs_mentions(nm, t) } }
  _ -> pcs_mentions(nm, body)
}

# A match scrutinee is borrowed when it is the bare read of a borrowed
# param (`match p { ... }`, `p` in `borrowed`) or already wrapped in
# `__perceus_borrow`. Such a scrutinee frees no cell, so its arm binders
# must never be moved by the reuse-model arm-skip / goto-tail passes.
fn pcs_scrut_is_borrowed(scr: Expr, borrowed: [Binder]) : Bool = match scr.kind {
  ELocal(l) -> pcs_has(borrowed, l)
  ECall(f, args_) -> match f.kind {
    EMark(MkBorrow) -> true
    _               -> false
  }
  _ -> false
}

pub(pkg) fn pcs_list_union(xs: [Binder], ys: [Binder]) : [Binder] = match ys {
  []           -> xs
  [y, ...rest] -> if pcs_has(xs, y.id) { pcs_list_union(xs, rest) }
                  else { pcs_list_union([y, ...xs], rest) }
}

# Issue #817 — cons-cascade safety for a goto-tail arm whose binders are
# candidates to move. The #3 `kai_decref(_scr)` frees the matched cons
# cell when its rc reaches 1 and cascades `decref` to every slot. Moving a
# binder strips the dup that held the cell's rc above 1, so the cascade
# fires; if a SIBLING binder is then consumed (moved) somewhere OTHER than
# inside the self-tail-call's args, the cascade double-consumes it — and a
# read-after (an inner `match p.ptype`) is a use-after-free. `filter`'s
# head `h` is consumed only inside the cons that IS a self-call arg → safe;
# `vpa_sig_params`'s `p` is consumed by `match p.ptype` outside the call →
# unsafe. A binder's last use being inside a self-call arg (a move there,
# balanced by the cascade) is safe; outside it is not. Borrow-only reads
# never consume, so they do not block (a `field_read` that dups, or a use
# that is not the binder's last use, leaves the birth ref for the cascade).
fn pcs_cons_cascade_safe(binders: [Binder], body: Expr, self_name: SelfRef, uses: UseIx) : Bool =
  pcs_ccs_all(binders, body, self_name, uses)

fn pcs_ccs_all(binders: [Binder], body: Expr, self_name: SelfRef, uses: UseIx) : Bool = match binders {
  []           -> true
  [nm, ...rest] -> {
    let ok = match last_use_for(nm.id, uses) {
      # The binder's last (ownership-transferring) read. Safe iff it sits
      # inside a self-tail-call's args (moved there, the cascade balances)
      # OR the binder is read at most once total AND that read is a borrow
      # the cascade reclaims. Conservative: require the last use to be
      # inside the self-call.
      LuAt(ll, lc) -> pcs_pos_in_self_call(self_name, ll, lc, body)
      LuUnused     -> true   # never read → cascade reclaims, no extra consume
      LuBlocked    -> false  # captured in a lambda → opaque, do not move
    }
    if ok { pcs_ccs_all(rest, body, self_name, uses) } else { false }
  }
}

# True iff `(ll, lc)` lands inside an argument of a `self_name(...)` call
# in `body`. Descends through the whole body; when it enters a call of
# the fn itself it checks whether the position is within
# any arg's span (any sub-expression carrying that exact line/col).
fn pcs_pos_in_self_call(self_name: SelfRef, ll: Int, lc: Int, e: Expr) : Bool =
  pcs_pisc_kind(self_name, ll, lc, e.kind)

# Issue #817 — every tail leaf of `e` is a DIRECT self-tail-call
# `self_name(...)` (recurses through EIf / EMatch / EBlock tails). This is
# the goto-lowered shape (tcrec): the arm's `kai_decref(_scr)` is
# pre-injected SHALLOW before the body (issue #309/#817), so the matched
# cons cell is freed before the body reads the deconstructed binders, and
# moving a binder transfers a ref the cell no longer cascades into. The
# mirror of emit_c's `tcrec_tail_always_sentinel`; duplicated here to keep
# the perceus pass free of an emit dependency. A non-self call, a normal
# value tail, or a ctor-rebuild fails — keeping regexp's NB_Frag arms
# (legacy match-exit, recursive decref) and balance's ctor-rebuild
# (cons-overwrite reuse) out of this set.
fn pcs_arm_all_tails_self_call(self_name: SelfRef, e: Expr) : Bool = pcs_atsc_kind(self_name, e.kind)

fn pcs_atsc_kind(self_name: SelfRef, k: ExprKind) : Bool = match k {
  # A direct self-call by bare name (pre-resolution) OR by module-
  # qualified name (`EModCall("list", "filter_loop")`, after the resolver
  # qualifies stdlib fns) — mirror of emit_c's `tcrec_tail_always_sentinel`
  # which handles both. Without the EModCall arm, a resolved fn's self-
  # call falls through and the goto-tail-move never fires for it.
  ECall(f, _) -> is_self_callee(f, self_name)
  EIf(_, t, opt_e) ->
    pcs_arm_all_tails_self_call(self_name, t) and
    (match opt_e { None -> false Some(e2) -> pcs_arm_all_tails_self_call(self_name, e2) })
  EMatch(_, arms) -> pcs_atsc_arms(self_name, arms)
  # Issue #817 — a block with NO leading statements: `{ recur(...) }`. A
  # block WITH statements (`{ let e1 = match p.ptype; recur(...) }`, the
  # `vpa_sig_params` shape) is rejected — a leading `SLet` / inner-match
  # may CONSUME a sibling binder before the goto, and the #3
  # `kai_decref(_scr)` cascade then double-consumes it (UAF). Only a body
  # that flows STRAIGHT to the self-call (no intervening consume) is
  # goto-tail-move safe. `filter`'s `if p(h) { recur } else { recur }` has
  # no such block; `map`/`flat_map`/`reverse` likewise.
  EBlock(stmts, opt_tail) -> match stmts {
    [] -> match opt_tail { None -> false Some(t) -> pcs_arm_all_tails_self_call(self_name, t) }
    _  -> false
  }
  _ -> false
}

# A non-empty `match` whose every arm tail is a direct self-call. Empty
# arms (degenerate) → false (no tail is a self-call to guard).
fn pcs_atsc_arms(self_name: SelfRef, arms: [Arm]) : Bool = match arms {
  []           -> false
  [Arm(_, _, b), ...rest] ->
    pcs_arm_all_tails_self_call(self_name, b) and pcs_atsc_arms_rest(self_name, rest)
}

fn pcs_atsc_arms_rest(self_name: SelfRef, arms: [Arm]) : Bool = match arms {
  []           -> true
  [Arm(_, _, b), ...rest] ->
    pcs_arm_all_tails_self_call(self_name, b) and pcs_atsc_arms_rest(self_name, rest)
}

pub(pkg) fn pcs_collect_goto_tail_moves(self_name: SelfRef, e: Expr, bmap: BorrowMap, uses: UseIx, cmap: ConsumeIndex, borrowed: [Binder], tab: SymTab) : [Binder] / Console =
  pcs_gtm_kind(self_name, e.kind, bmap, uses, cmap, borrowed, tab)

fn pcs_gtm_kind(self_name: SelfRef, k: ExprKind, bmap: BorrowMap, uses: UseIx, cmap: ConsumeIndex, borrowed: [Binder], tab: SymTab) : [Binder] / Console = match k {
  EMatch(s, arms) ->
    # Same borrowed-scrutinee inhibition as the arm-skip cascade: a
    # borrowed scrutinee frees no cell, so its arm binders must not move.
    if pcs_scrut_is_borrowed(s, borrowed) {
      pcs_collect_goto_tail_moves(self_name, s, bmap, uses, cmap, borrowed, tab)
    } else {
      pcs_list_union(pcs_collect_goto_tail_moves(self_name, s, bmap, uses, cmap, borrowed, tab),
                     pcs_gtm_arms(self_name, arms, bmap, uses, cmap, borrowed, tab))
    }
  EIf(c, t, opt_e) ->
    pcs_list_union(pcs_collect_goto_tail_moves(self_name, c, bmap, uses, cmap, borrowed, tab),
      pcs_list_union(pcs_collect_goto_tail_moves(self_name, t, bmap, uses, cmap, borrowed, tab),
                     match opt_e { None -> [] Some(e2) -> pcs_collect_goto_tail_moves(self_name, e2, bmap, uses, cmap, borrowed, tab) }))
  EBlock(stmts, tail) ->
    pcs_list_union(pcs_gtm_stmts(self_name, stmts, bmap, uses, cmap, borrowed, tab),
                   match tail { None -> [] Some(e) -> pcs_collect_goto_tail_moves(self_name, e, bmap, uses, cmap, borrowed, tab) })
  # A lambda body is a different call frame — a self-tail-call inside it
  # is NOT a goto-tail of the enclosing fn (`pcs_atsc_kind` returns false
  # at ELambda for the same reason). The rewriter also zeroes
  # `move_last_set` on lambda entry. Do NOT descend; the binders here are
  # captures, not goto-tail arm-binders of `self_name`.
  ELambda(_, _) -> []
  _ -> []
}

fn pcs_gtm_arms(self_name: SelfRef, arms: [Arm], bmap: BorrowMap, uses: UseIx, cmap: ConsumeIndex, borrowed: [Binder], tab: SymTab) : [Binder] / Console = match arms {
  []           -> []
  [a, ...rest] -> match a {
    Arm(pat, opt_g, body) -> {
      let nested = pcs_collect_goto_tail_moves(self_name, body, bmap, uses, cmap, borrowed, tab)
      let pb = prc_pat_bindings(pat, [])
      let here = match opt_g {
        # Issue #817 — additionally require cons-cascade safety: the #3
        # `kai_decref(_scr)` frees the matched cons cell when its rc hits
        # 1 and CASCADES `decref` to ALL its slots. Moving a binder strips
        # the dup that kept the cell's rc above 1, so the cascade fires —
        # and if ANY sibling binder is CONSUMED outside the self-tail-call
        # (e.g. `vpa_sig_params`'s `match p.ptype` consumes `p`), the
        # cascade double-consumes it (and the inner-match reads it after)
        # → UAF. Block the whole pattern's move when that holds.
        None    -> {
          let pure_tail = pcs_arm_all_tails_self_call(self_name, body)
          let safe = pure_tail and pcs_cons_cascade_safe(pb, body, self_name, uses)
          if safe { pcs_branch_aware_skip_locals_b(pb, body, bmap, cmap, borrowed, tab) } else { [] }
        }
        Some(_) -> []
      }
      pcs_list_union(pcs_list_union(here, nested),
                     pcs_gtm_arms(self_name, rest, bmap, uses, cmap, borrowed, tab))
    }
  }
}

fn pcs_gtm_stmts(self_name: SelfRef, stmts: [Stmt], bmap: BorrowMap, uses: UseIx, cmap: ConsumeIndex, borrowed: [Binder], tab: SymTab) : [Binder] / Console = match stmts {
  []           -> []
  [s, ...rest] -> {
    let here = match s {
      SLet(_, _, e)       -> pcs_collect_goto_tail_moves(self_name, e, bmap, uses, cmap, borrowed, tab)
      SVar(_, _, e, _, _) -> pcs_collect_goto_tail_moves(self_name, e, bmap, uses, cmap, borrowed, tab)
      SExprStmt(e)        -> pcs_collect_goto_tail_moves(self_name, e, bmap, uses, cmap, borrowed, tab)
      _                   -> []
    }
    pcs_list_union(here, pcs_gtm_stmts(self_name, rest, bmap, uses, cmap, borrowed, tab))
  }
}

pub(pkg) fn pcs_collect_safe_arm_binders(self_name: SelfRef, e: Expr, bmap: BorrowMap, uses: UseIx) : [Binder] / Console =
  pcs_sab_kind(self_name, e.kind, bmap, uses)

fn pcs_sab_kind(self_name: SelfRef, k: ExprKind, bmap: BorrowMap, uses: UseIx) : [Binder] / Console = match k {
  EMatch(s, arms) ->
    pcs_list_union(pcs_collect_safe_arm_binders(self_name, s, bmap, uses),
                   pcs_sab_arms(self_name, arms, bmap, uses))
  EIf(c, t, opt_e) ->
    pcs_list_union(pcs_collect_safe_arm_binders(self_name, c, bmap, uses),
      pcs_list_union(pcs_collect_safe_arm_binders(self_name, t, bmap, uses),
                     match opt_e { None -> [] Some(e2) -> pcs_collect_safe_arm_binders(self_name, e2, bmap, uses) }))
  EBlock(stmts, tail) ->
    pcs_list_union(pcs_sab_stmts(self_name, stmts, bmap, uses),
                   match tail { None -> [] Some(e) -> pcs_collect_safe_arm_binders(self_name, e, bmap, uses) })
  # Lambda body = different frame; do not descend (mirror of
  # `pcs_gtm_kind` / `pcs_atsc_kind`).
  ELambda(_, _) -> []
  _ -> []
}

fn pcs_sab_arms(self_name: SelfRef, arms: [Arm], bmap: BorrowMap, uses: UseIx) : [Binder] / Console = match arms {
  []           -> []
  [a, ...rest] -> match a {
    Arm(pat, opt_g, body) -> {
      let nested = pcs_collect_safe_arm_binders(self_name, body, bmap, uses)
      let pb = prc_pat_bindings(pat, [])
      let here = match opt_g {
        None -> {
          let pure_tail = pcs_arm_all_tails_self_call(self_name, body)
          let safe = pure_tail and pcs_cons_cascade_safe(pb, body, self_name, uses)
          if safe { pb } else { [] }
        }
        Some(_) -> []
      }
      pcs_list_union(pcs_list_union(here, nested),
                     pcs_sab_arms(self_name, rest, bmap, uses))
    }
  }
}

fn pcs_sab_stmts(self_name: SelfRef, stmts: [Stmt], bmap: BorrowMap, uses: UseIx) : [Binder] / Console = match stmts {
  []           -> []
  [s, ...rest] -> {
    let here = match s {
      SLet(_, _, e)       -> pcs_collect_safe_arm_binders(self_name, e, bmap, uses)
      SVar(_, _, e, _, _) -> pcs_collect_safe_arm_binders(self_name, e, bmap, uses)
      SExprStmt(e)        -> pcs_collect_safe_arm_binders(self_name, e, bmap, uses)
      _                   -> []
    }
    pcs_list_union(here, pcs_sab_stmts(self_name, rest, bmap, uses))
  }
}

# Walk a fn body, collecting EVERY guard-less match arm's pattern binders
# that pass the borrow-aware branch-aware safety check over THAT arm's body.
# Precomputed once in perceus_decl_b (where the borrow map is in scope) and
# unioned into the global skip-set, so pcs_rewrite_arms need not thread the
# borrow map through all 59 rewrite call sites. A binder is added only when
# it passes the check in its own arm body (max-path<=1 borrow-aware,
# consumed-on-every-path, all-consumers-linear); the three conditions ARE
# Koka's per-branch ownership reconcile and are sound on their own.
pub(pkg) fn pcs_collect_arm_skip_binders(self_name: SelfRef, tl: Bool, e: Expr, bmap: BorrowMap, cmap: ConsumeIndex, borrowed: [Binder], tab: SymTab) : [Binder] =
  pcs_collect_arm_skip_kind(self_name, tl, e.kind, bmap, cmap, borrowed, tab)

fn pcs_collect_arm_skip_kind(self_name: SelfRef, tl: Bool, k: ExprKind, bmap: BorrowMap, cmap: ConsumeIndex, borrowed: [Binder], tab: SymTab) : [Binder] = match k {
  EMatch(s, arms) ->
    # A borrowed scrutinee has NO reuse (rule 5): its cell belongs to the
    # caller, so the arm-top steal that arm-moves rely on never fires.
    # Moving a binder of such an arm would take ownership of a cell the
    # caller still holds — a use-after-free. Inhibit the arm-move for a
    # match over a borrowed param; still descend the scrutinee.
    if pcs_scrut_is_borrowed(s, borrowed) {
      pcs_collect_arm_skip_binders(self_name, false, s, bmap, cmap, borrowed, tab)
    } else {
      # The scrutinee descends as NON-toplevel (its own matches are nested).
      # The arms keep `tl`: arms of the fn-body's first match are toplevel; arms
      # reached after descending through a nested match are not.
      pcs_list_union(pcs_collect_arm_skip_binders(self_name, false, s, bmap, cmap, borrowed, tab),
                     pcs_collect_arm_skip_arms(self_name, tl, arms, bmap, cmap, borrowed, tab))
    }
  _ -> pcs_collect_arm_skip_ps(self_name, tl, xp_positions_kind(k), bmap, cmap, borrowed, tab)
}

fn pcs_collect_arm_skip_ps(self_name: SelfRef, tl: Bool, ps: [XPos], bmap: BorrowMap, cmap: ConsumeIndex, borrowed: [Binder], tab: SymTab) : [Binder] = match ps {
  []                  -> []
  [XP(_, c), ...rest] ->
    pcs_list_union(pcs_collect_arm_skip_binders(self_name, tl, c, bmap, cmap, borrowed, tab),
                   pcs_collect_arm_skip_ps(self_name, tl, rest, bmap, cmap, borrowed, tab))
}

fn pcs_collect_arm_skip_arms(self_name: SelfRef, tl: Bool, arms: [Arm], bmap: BorrowMap, cmap: ConsumeIndex, borrowed: [Binder], tab: SymTab) : [Binder] = match arms {
  []           -> []
  [a, ...rest] -> match a {
    Arm(pat, opt_g, body) -> {
      # Descend into the body for NESTED matches — those are never toplevel.
      let nested = pcs_collect_arm_skip_binders(self_name, false, body, bmap, cmap, borrowed, tab)
      # Move this arm's binders when emit disposes the scrutinee via a reuse-
      # model that does NOT cascade into the moved child:
      #  (1) self-rec modulo-cons (`self(...)` in a ctor slot) → TRMC arm-top
      #      reuse (insert_loop). Sound at ANY depth: the arm-top steals the
      #      matched cell, which IS the cell the TRMC step rebuilds.
      #  (2) cons-overwrite — reconstructs the SAME ctor it matched in tail
      #      position → emit's try_reuse_variant_arm overwrites _scr in place.
      #      Sound ONLY at the fn-body's TOP-LEVEL match (`tl`): there the
      #      reused cell IS the cell the result replaces. In a NESTED match over
      #      a binder (gap3's `match l { Node(ll,..) -> match ll { ... } }`) the
      #      reused cell is the INNER scrutinee (ll) but the result replaces the
      #      OUTER node (l) — the in-place overwrite builds a self-referential
      #      cycle (gap3 stack-overflows in `size`). Hence the `tl` gate.
      let reuse_shape = pcs_arm_self_modulo_cons(self_name, body, tab) or
                        (tl and pcs_arm_cons_overwrite(pat, body, tab))
      let here = match opt_g {
        None    ->
          if reuse_shape {
            pcs_branch_aware_skip_locals_b(prc_pat_bindings(pat, []), body, bmap, cmap, borrowed, tab)
          } else { [] }
        Some(_) -> []
      }
      pcs_list_union(pcs_list_union(here, nested),
                     pcs_collect_arm_skip_arms(self_name, tl, rest, bmap, cmap, borrowed, tab))
    }
  }
}

# True iff the arm matched `PVariant(C, ...)` and reconstructs the SAME ctor C
# in every tail position — the cons-overwrite reuse shape emit's
# try_reuse_variant_arm fires on (overwrites _scr in place via kai_check_unique,
# which does NOT cascade into moved children). This is balance_left/right: it
# matches `RBNode(...)` and rebuilds `RBNode(...)` in each tail. Moving the
# arm's binders is sound because emit reuses the matched cell rather than
# decref-ing it recursively. A tail that rebuilds a DIFFERENT ctor (or calls a
# non-reuse fn) fails, keeping regexp's NB_Frag arms out.
fn pcs_arm_cons_overwrite(pat: Pattern, body: Expr, tab: SymTab) : Bool = match pat.pkind {
  PVariant(r, _) -> pcs_arm_tails_rebuild_ctor(ref_sym(r), body, tab)
  _              -> false
}

# Every tail leaf of `body` is an ECall to the ctor `cname`.
fn pcs_arm_tails_rebuild_ctor(cname: SymId, e: Expr, tab: SymTab) : Bool = pcs_tails_ctor_kind(cname, e.kind, tab)

fn pcs_tails_ctor_kind(cname: SymId, k: ExprKind, tab: SymTab) : Bool = match k {
  EIf(_, t, opt_e) ->
    pcs_arm_tails_rebuild_ctor(cname, t, tab) and
    (match opt_e { None -> false Some(e2) -> pcs_arm_tails_rebuild_ctor(cname, e2, tab) })
  EBlock(_, opt_tail) -> match opt_tail { None -> false Some(e) -> pcs_arm_tails_rebuild_ctor(cname, e, tab) }
  EMatch(_, arms) -> pcs_tails_ctor_arms(cname, arms, tab)
  ECall(f, xs) -> match f.kind {
    # Rebuild of the same ctor AND every slot is "simple" — a bare binder, a
    # scalar, or a NESTED ctor of simples — NEVER a fn call that derives a slot
    # from a binder (`desugar_interp_expr(c)`). emit's try_reuse_variant_arm
    # overwrites _scr's slots IN PLACE; if a new slot is computed FROM an old
    # slot (the desugar shape), the overwrite corrupts the binder before the
    # call reads it → a self-referential cycle (the desugar_interp self-host
    # infinite recursion). balance's slots are direct ctors of binders, so they
    # are safe. Restricting to simple slots keeps cons-overwrite to the
    # balance-shaped arms only.
    ESym(s, _) -> sym_raw(s) >= 0 and sym_same(s, cname) and pcs_all_slots_simple(xs, tab)
    _          -> false
  }
  _ -> false
}

# A slot is "simple" if writing it in place cannot read a binder that an
# earlier in-place write already clobbered: bare EVar, scalar literal, dup of a
# binder, or a ctor whose own slots are all simple. A non-ctor fn call is NOT
# simple (it may read a binder that derives the donor's slots).
fn pcs_all_slots_simple(xs: [Expr], tab: SymTab) : Bool = match xs {
  []           -> true
  [h, ...rest] -> pcs_slot_simple(h, tab) and pcs_all_slots_simple(rest, tab)
}

# A slot of a cons-overwrite rebuild is "simple" iff it is a bare binder, a
# scalar, or a dup of a binder — NOT a NESTED ctor that embeds a pointer
# binder. A nested ctor (`Node(Node(lll,...), lk, Node(lr,...))`) makes the
# rebuild NON-BIJECTIVE: the in-place overwrite (kai_check_unique) writes the
# donor's slot 0 to a NEW node that borrows the donor's OLD children, and emit
# does not dup those borrowed children → over-decref → a corrupted (cyclic)
# tree (gap3_balance_minimal stack-overflows in `size`). The rb-tree's balance
# rotations have exactly this nested shape and CORRECTLY fall to fresh-alloc
# (emit emits no kai_check_unique there); the RSS win comes from the FLAT
# rebuilds (recolor / the 3-arm `kai_check_unique` case) + the TRMC arm-top
# reuse of insert_loop, not the rotations. Restricting cons-overwrite to flat
# rebuilds keeps gap3 correct and loses nothing the rotations gave.
fn pcs_slot_simple(e: Expr, tab: SymTab) : Bool = match e.kind {
  ELocal(_)         -> true
  ESym(_, _)        -> true
  EInt(_, _)        -> true
  EReal(_, _)       -> true
  EIntLit(_)        -> true
  EDecimalLit(_)    -> true
  EFixed(_, _)      -> true
  EBool(_)       -> true
  EChar(_)       -> true
  EUnit          -> true
  EStr(_, _)     -> true
  ECall(f, xs)   -> match f.kind {
    # A dup of a binder is flat. A NULLARY ctor (Red/Black/Leaf, no slots) is
    # flat. A ctor WITH slots embeds children → non-bijective → NOT simple.
    EMark(MkDup) -> true
    _            -> pcs_callee_is_ctor(tab, f) and pcs_all_slots_simple(xs, tab)
  }
  _ -> false
}

fn pcs_tails_ctor_arms(cname: SymId, arms: [Arm], tab: SymTab) : Bool = match arms {
  []           -> true
  [a, ...rest] -> match a { Arm(_, _, b) -> pcs_arm_tails_rebuild_ctor(cname, b, tab) and pcs_tails_ctor_arms(cname, rest, tab) }
}

pub(pkg) fn pcs_guard_close_births(g: Expr, bound: [Binder]) : Expr {
  let drops = pcs_guard_fail_drops(bound, g, [])
  match drops {
    [] -> g
    [_, ...__] -> {
      let f = Expr { kind: EBool(false), line: g.line, col: g.col,
                     ty: g.ty, mode: MBoxed,  site: g.site }
      let blk = Expr { kind: EBlock(drops, Some(f)), line: g.line, col: g.col,
                       ty: g.ty, mode: MBoxed,  site: g.site }
      Expr { kind: EBinop(BoOr, g, blk), line: g.line, col: g.col,
             ty: g.ty, mode: MBoxed,  site: g.site }
    }
  }
}

fn pcs_guard_fail_drops(bound: [Binder], g: Expr, acc: [Stmt]) : [Stmt] = match bound {
  [] -> list_reverse(acc)
  [nm, ...rest] -> {
    let acc1 =
      if pcs_has_bare_read(nm, g) { acc }
      else { [pcs_make_guard_drop_stmt(nm.id, g.line, g.col), ...acc] }
    pcs_guard_fail_drops(rest, g, acc1)
  }
}

fn pcs_make_guard_drop_stmt(l: LocalId, ln: Int, cl: Int) : Stmt =
  SExprStmt(Expr {
    kind: ECall(
      Expr { kind: EMark(MkGuardDrop), line: ln, col: cl,
             ty: None, mode: MUnknown , site: 0 },
      [Expr { kind: ELocal(l), line: ln, col: cl,
              ty: None, mode: MUnknown , site: 0 }]
    ),
    line: ln, col: cl, ty: None, mode: MUnknown
  , site: 0 })

pub(pkg) fn pcs_build_borrow_map(decls: [Decl], seed: [BorrowEntry], tab: SymTab) : BorrowMap =
  bv_build(pcs_borrow_decls(decls, tab, []), seed)

pub(pkg) fn pcs_planned_borrow_map(decls: [Decl]) : BorrowMap =
  bv_build(pcs_planned_decls(decls, []), [])

fn pcs_borrow_decls(decls: [Decl], tab: SymTab, acc: [BorrowDecl]) : [BorrowDecl] = match decls {
  []           -> list_reverse(acc)
  [d, ...rest] -> match d {
    DFn(is_pub, fsym, _, params, _, _, body, _, _, _) ->
      pcs_borrow_decls(rest, tab, [BD(fsym, pcs_borrowed_positions(is_pub, SelfRef(fsym), params, body, tab)), ...acc])
    _ -> pcs_borrow_decls(rest, tab, acc)
  }
}

fn pcs_planned_decls(decls: [Decl], acc: [BorrowDecl]) : [BorrowDecl] = match decls {
  []           -> list_reverse(acc)
  [d, ...rest] -> match d {
    DFn(_, fsym, _, params, _, _, _, _, _, _) -> {
      let pos = pcs_borrow_positions(map(params, (p) => p.binder), pcs_explicit_borrow_names(params), 0)
      pcs_planned_decls(rest, [BD(fsym, pos), ...acc])
    }
    _ -> pcs_planned_decls(rest, acc)
  }
}

# An extern shim's marker body references no param, which the inspection
# walk would read as "borrowed"; the shim consumes every input.
fn pcs_borrowed_positions(is_pub: Bool, me: SelfRef, params: [Param], body: Expr, tab: SymTab) : [Int] =
  if body_is_extern(body) { [] }
  else {
    let pnames = map(params, (p) => p.binder)
    pcs_borrow_positions(pnames, pcs_borrow_params_hybrid(is_pub, me, params, pnames, body, tab), 0)
  }

# Hybrid borrow decision (issue #1127). A `pub` function's borrow-ness is
# ABI: only the parameters explicitly marked `^` are borrowed, never
# inferred — no silent public-boundary flip. A non-`pub` function borrows
# the union of its explicit `^` marks and the relaxed inference
# (borrow_infer_params), the whole-bundle view making inference safe.
#
# CLOSURE params now participate in the EFFECTIVE (codegen) borrow set
# (issue #1130): a `f(args)` through a borrowed function-typed param routes
# to `kai_apply_borrow` / `kaix_apply_borrow`, which invoke without
# consuming the closure, so borrowing a called closure is sound (the caller
# keeps the ref and drops after last use, per rule 1). Before #1130 the
# runtime call variant did not exist, so `pcs_closure_param_names` was
# subtracted here to keep the closure owned — that subtraction is gone.
pub(pkg) fn pcs_borrow_params_hybrid(is_pub: Bool, me: SelfRef, params: [Param],
                            pnames: [Binder], body: Expr, tab: SymTab) : [Binder] = {
  let explicit = pcs_explicit_borrow_names(params)
  if is_pub { explicit }
  else { bbe_keep_borrowed(tab, me, pnames, pcs_list_union(explicit, borrow_infer_params(tab, me, pnames, body)), body) }
}

pub(pkg) fn pcs_explicit_borrow_names(params: [Param]) : [Binder] = match params {
  []           -> []
  [p, ...rest] ->
    if p.pborrow { [p.binder, ...pcs_explicit_borrow_names(rest)] }
    else { pcs_explicit_borrow_names(rest) }
}

pub(pkg) fn pcs_borrow_positions(pnames: [Binder], bset: [Binder], i: Int) : [Int] = match pnames {
  []           -> []
  [p, ...rest] ->
    if pcs_has(bset, p.id) { [i, ...pcs_borrow_positions(rest, bset, i + 1)] }
    else { pcs_borrow_positions(rest, bset, i + 1) }
}
