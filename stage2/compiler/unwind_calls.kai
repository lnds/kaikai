#[doc("""
Whether a call can unwind. A fn is judged by its declared row; one whose
row is open with nothing that can unwind does so only through what its
arguments bring. A perform by its effect; a closure by its type.
""")]

import compiler.ast
import compiler.util
import compiler.expr_positions
import compiler.expr_exists
import compiler.marks
import compiler.chars
import compiler.unwind_clauses
import compiler.unwind_cx
import compiler.borrow_view
import compiler.core_prims
import compiler.perceus
import compiler.symtab_build
import compiler.decl_names

# Whether an argument of type `t` can bring an effect that unwinds: a
# closure whose row can, a value that can carry a closure, an unknown.
fn ue_carries(t: Option[Ty], ucx: UnwCx) : Bool = match t {
  Some(x) -> ue_ty_carries(x, ucx)
  None    -> true
}

fn ue_ty_carries(t: Ty, ucx: UnwCx) : Bool = match t {
  TyFnT(_, _, _)          -> unw_ty_unwinds(Some(t), ucx)
  TyListT(a)              -> ue_ty_carries(a, ucx)
  TyCon(_, n, args, _)    -> list_has(ucx.carriers, unw_bare_effect(n)) or ue_tys_carry(args, ucx) or unw_effect_unwinds(n, ucx)
  TyDimT(a, _)            -> ue_ty_carries(a, ucx)
  TyRefineT(a, _)         -> ue_ty_carries(a, ucx)
  TyUnion(ts)             -> ue_tys_carry(ts, ucx)
  TyVarT(_)               -> true
  TyAny                   -> true
  TyShapeApp(_, _)        -> true
  _                       -> false
}

fn ue_tys_carry(ts: [Ty], ucx: UnwCx) : Bool = match ts {
  [] -> false
  [t, ...rest] -> ue_ty_carries(t, ucx) or ue_tys_carry(rest, ucx)
}

fn ue_args_carry(xs: [Expr], ucx: UnwCx) : Bool = match xs {
  [] -> false
  [x, ...rest] -> ue_arg_carries(x, ucx) or ue_args_carry(rest, ucx)
}

# A lambda literal brings what its body can do, whatever its row says; a
# mark around an argument changes who owns it, not what it can do.
fn ue_arg_carries(x: Expr, ucx: UnwCx) : Bool = match x.kind {
  ELambda(_, body) -> unw_scan(body, ucx)
  ECall(g, [y]) -> match g.kind {
    EMark(_) -> ue_arg_carries(y, ucx)
    _        -> ue_carries(x.ty, ucx)
  }
  _ -> ue_carries(x.ty, ucx)
}

# ---- the scan --------------------------------------------------------------

#[doc("Whether `e` holds a `!` it runs in place.")]
pub fn unw_has_exit(e: Expr) : Bool = xp_exists(e, true, xp_is_bang)

#[doc("Whether any call `e` makes in place may unwind, or a `!` in it may return early; a lambda or clause body runs in its own frame.")]
pub fn unw_scan(e: Expr, ucx: UnwCx) : Bool = unw_scan_node(e, ucx) or ue_scan_ps(xp_positions(e), ucx)

#[doc("Whether `e` itself, not its children, is a call that may unwind or a `!`.")]
pub fn unw_scan_node(e: Expr, ucx: UnwCx) : Bool = match e.kind {
  EBang(_)     -> true
  ECall(f, xs) -> ue_call(f, xs, [], true, ucx)
  _ -> false
}

fn ue_scan_ps(ps: [XPos], ucx: UnwCx) : Bool = match ps {
  [] -> false
  [XP(r, c), ...rest] -> (xrole_inline(r) and unw_scan(c, ucx)) or ue_scan_ps(rest, ucx)
}

#[doc("""
True when the call of `f` on `xs` can unwind. A callee named in `locals`
is a closure, judged by its type; a fn by its declared row; a perform by
its effect. Tail-call sentinels and marks other than the borrowing
indirect call are not calls.
""")]
pub fn unw_call_unwinds(f: Expr, xs: [Expr], locals: [String], ucx: UnwCx) : Bool = ue_call(f, xs, locals, false, ucx)

# `scan` also judges a fn callee by its type, which covers a closure the
# scan cannot tell from a fn: it must answer yes wherever the walk does.
fn ue_call(f: Expr, xs: [Expr], locals: [String], scan: Bool, ucx: UnwCx) : Bool = match f.kind {
  EMark(MkApplyBorrow) -> match xs {
    [clo, ..._] -> unw_ty_unwinds(clo.ty, ucx)
    []          -> false
  }
  EMark(_) -> false
  EVar(n) ->
    if list_has(locals, n) { unw_ty_unwinds(f.ty, ucx) }
    else if ue_is_perform(n) { unw_effect_unwinds(ue_head(n, 0), ucx) }
    else { ue_fn(f, 0 - 1, n, xs, scan, ucx) }
  ESym(s, inst, n) ->
    if ue_is_perform(n) { unw_effect_unwinds(ue_head(n, 0), ucx) }
    else { ue_fn(f, unw_fn_class(bv_fid_key(FnId(s, inst)), ucx), n, xs, scan, ucx) }
  EModCall(m, n) ->
    if ue_is_effect_name(m) { unw_effect_unwinds(m, ucx) }
    else { ue_fn(f, unw_fn_class(bv_fid_key(fnid_decl(sym_derive(NCFn, n, m))), ucx), n, xs, scan, ucx) }
  _ -> unw_ty_unwinds(f.ty, ucx)
}

#[doc("The binders read bare at a position the callee `f` borrows: the call hands none of them over, so they stay pending past it.")]
pub fn unw_lent_reads(f: Expr, xs: [Expr], ucx: UnwCx) : [String] = match ue_borrowed_slots(f, ucx) {
  [] -> []
  bs -> ue_reads_at(xs, bs, 0)
}

# Perceus names a `_borrow` prim only where the caller keeps its reference.
fn ue_borrowed_slots(f: Expr, ucx: UnwCx) : [Int] = match ue_callee_key(f) {
  Some(k) -> unw_fn_borrows(k, ucx)
  None    -> match f.kind {
    EVar(_) -> if core_is_borrow_sibling(pcs_callee_key(f)) { [0] } else { [] }
    _       -> []
  }
}

fn ue_callee_key(f: Expr) : Option[String] = match f.kind {
  ESym(s, inst, n)  -> if ue_is_perform(n) { None } else { Some(bv_fid_key(FnId(s, inst))) }
  EModCall(m, n)    -> if ue_is_effect_name(m) { None } else { Some(bv_fid_key(fnid_decl(sym_derive(NCFn, n, m)))) }
  _ -> None
}

fn ue_reads_at(xs: [Expr], bs: [Int], i: Int) : [String] = match xs {
  [] -> []
  [x, ...rest] -> match x.kind {
    EVar(n) -> if list_has_int(bs, i) { [n, ...ue_reads_at(rest, bs, i + 1)] } else { ue_reads_at(rest, bs, i + 1) }
    _ -> ue_reads_at(rest, bs, i + 1)
  }
}

fn list_has_int(xs: [Int], x: Int) : Bool = match xs {
  [] -> false
  [y, ...rest] -> y == x or list_has_int(rest, x)
}

# A fn is judged by the class `c` of its declared row; a bare spelling is
# a local or a builtin, with no declared row. The scan cannot tell a local
# closure from a fn, so it also asks the callee's type.
fn ue_fn(f: Expr, c: Int, n: String, xs: [Expr], scan: Bool, ucx: UnwCx) : Bool =
  if c == 1 { true }
  else if c == 2 { ue_args_carry(xs, ucx) }
  else if c == 0 or ue_internal(n) { false }
  else { scan and unw_ty_unwinds(f.ty, ucx) }

# A `__`-prefixed callee is a compiler-internal form, never a call.
fn ue_internal(n: String) : Bool = string_byte_at_int(n, 0) == 95 and string_byte_at_int(n, 1) == 95

# `E.op` performs E.
fn ue_is_perform(n: String) : Bool = unw_last_dot(n) >= 0 and ue_is_effect_name(n)

fn ue_head(n: String, i: Int) : String =
  if i >= string_length(n) { n }
  else if string_byte_at_int(n, i) == 46 { string_slice(n, 0, i) }
  else { ue_head(n, i + 1) }

# A qualifier spelled with a capital is an effect, so the call is a perform.
fn ue_is_effect_name(m: String) : Bool = match char_at(m, 0) {
  Some(c) -> ch_is_upper(c)
  None    -> false
}
