# compiler/exhaust.kai — whether a match's arms cover every value.
#
# Maranget's usefulness test over the arms' pattern matrix: the match is
# exhaustive when an all-wildcard row is useless after the arms, and the
# search for that row yields a witness, a value no arm matches. A guarded
# arm covers nothing. Only Bool literals complete a column, so a match over
# an Int, a Char, a String or a Real needs a catch-all. A column the
# constructor table cannot place answers `XUnknown`: the check may miss a
# gap, never invent one.

import compiler.ast
import compiler.ast_ids
import compiler.ast_ids
import compiler.util
import compiler.parse_type_decls
import compiler.parse_types

#[doc("A constructor of a sum type: its id and how a witness spells it with wildcard payload.")]
pub(pkg) type XSib = XSib(SymId, String)

#[doc("Every constructor of the type a constructor belongs to, or `None` when it cannot be placed; asked only for a column that needs it.")]
pub(pkg) type XCtors = XCtors((SymId) -> Option[[XSib]])

#[doc("A coverage verdict: every value covered, a witness per column of a missed value, or undecidable.")]
pub(pkg) type XVerdict = XCovered | XMissing([String]) | XUnknown

#[doc("Whether coverage needs the matrix: an unguarded catch-all, or unguarded arms that each test only a constructor, settle it without one.")]
pub(pkg) fn x_needs_matrix(arms: [Arm]) : Bool = not x_any_catch_all(arms) and not x_all_flat(arms)

fn x_any_catch_all(arms: [Arm]) : Bool = match arms {
  [] -> false
  [Arm(p, g, _), ...rest] -> (x_unguarded(g) and x_irrefutable(p)) or x_any_catch_all(rest)
}

fn x_all_flat(arms: [Arm]) : Bool = match arms {
  [] -> true
  [Arm(p, g, _), ...rest] -> x_unguarded(g) and x_flat(p) and x_all_flat(rest)
}

fn x_unguarded(g: Option[Expr]) : Bool = match g {
  None    -> true
  Some(e) -> match e.kind { EBool(true) -> true  _ -> false }
}

fn x_irrefutable(p: Pattern) : Bool = match p.pkind {
  PWild         -> true
  PBind(_)      -> true
  PHole(_)      -> true
  PAs(_, inner) -> x_irrefutable(inner)
  PRecord(fs)   -> x_fields_irrefutable(fs)
  _             -> false
}

fn x_all_irrefutable(ps: [Pattern]) : Bool = match ps {
  [] -> true
  [p, ...rest] -> x_irrefutable(p) and x_all_irrefutable(rest)
}

fn x_fields_irrefutable(fs: [PField]) : Bool = match fs {
  [] -> true
  [PField(_, sub, _), ...rest] -> x_irrefutable(sub) and x_fields_irrefutable(rest)
}

# A pattern the constructor check decides alone: a constructor over
# irrefutable payload, `[]`, `[_, ..._]`, or a union narrowing.
fn x_flat(p: Pattern) : Bool = match p.pkind {
  PAs(_, inner)             -> x_flat(inner)
  PVariant(_, subs)         -> x_all_irrefutable(subs)
  PVariantRecord(_, fs)     -> x_fields_irrefutable(fs)
  PList([], None)           -> true
  PList([], Some(_))        -> true
  PList([h], Some(_))       -> x_irrefutable(h)
  PNarrow(_, _)             -> true
  _                         -> x_irrefutable(p)
}

#[doc("The coverage of a match's arms over its scrutinee.")]
pub(pkg) fn x_match_verdict(arms: [Arm], tab: XCtors) : XVerdict =
  x_useful(x_rows(arms, []), 1, tab)

# The arms that cover what their pattern matches, one single-column row each.
fn x_rows(arms: [Arm], acc: [[Pattern]]) : [[Pattern]] = match arms {
  [] -> list_reverse(acc)
  [Arm(p, None, _), ...rest] -> x_rows(rest, [[p], ...acc])
  [Arm(p, Some(g), _), ...rest] -> match g.kind {
    EBool(true) -> x_rows(rest, [[p], ...acc])
    _           -> x_rows(rest, acc)
  }
}

# Some vector of `n` values matches no row of `rows`.
fn x_useful(rows: [[Pattern]], n: Int, tab: XCtors) : XVerdict =
  if n == 0 { match rows { [] -> XMissing([])  _ -> XCovered } }
  else {
    let keys = x_column_keys(rows, [])
    match x_signature(keys, rows, tab) {
      XSigComplete     -> x_split(keys, rows, n, tab, XCovered)
      XSigOpen(absent) -> x_prepend(absent, x_useful(x_default(rows, []), n - 1, tab))
      XSigUnknown      -> XUnknown
    }
  }

fn x_prepend(w: String, v: XVerdict) : XVerdict = match v {
  XMissing(ws) -> XMissing([w, ...ws])
  _            -> v
}

# A column's constructors: a complete signature, or an open one with a
# witness for a value none of them heads.
type XSig = XSigComplete | XSigOpen(String) | XSigUnknown

fn x_signature(keys: [XKey], rows: [[Pattern]], tab: XCtors) : XSig =
  if x_any_head(rows, xh_is_odd) { XSigUnknown }
  else if x_any_head(rows, xh_is_lit) { XSigOpen("_") }
  else { x_keys_signature(keys, tab) }

# The column's type is the one its first key belongs to.
fn x_keys_signature(keys: [XKey], tab: XCtors) : XSig = match keys {
  [] -> XSigOpen("_")
  [k, ..._] -> match k {
    XKRecord      -> XSigComplete
    XKUnit        -> XSigComplete
    XKNil         -> x_list_signature(keys)
    XKCons        -> x_list_signature(keys)
    XKTrue        -> x_bool_signature(keys)
    XKFalse       -> x_bool_signature(keys)
    XKVariant(c)  -> x_variant_signature(c, keys, tab)
  }
}

fn x_list_signature(keys: [XKey]) : XSig = x_first_absent([XKNil, XKCons], ["[]", "[_, ..._]"], keys)

fn x_bool_signature(keys: [XKey]) : XSig = x_first_absent([XKTrue, XKFalse], ["true", "false"], keys)

fn x_first_absent(need: [XKey], spell: [String], keys: [XKey]) : XSig = match (need, spell) {
  ([k, ...ks], [s, ...ss]) -> if xk_has(keys, k) { x_first_absent(ks, ss, keys) } else { XSigOpen(s) }
  _                        -> XSigComplete
}

fn x_variant_signature(c: SymId, keys: [XKey], tab: XCtors) : XSig = match x_siblings(c, tab) {
  None -> XSigUnknown
  Some(sibs) ->
    if x_keys_among(keys, sibs) { x_absent_sibling(sibs, keys) } else { XSigUnknown }
}

fn x_keys_among(keys: [XKey], sibs: [XSib]) : Bool = match keys {
  [] -> true
  [XKVariant(c), ...rest] -> x_sib_has(sibs, c) and x_keys_among(rest, sibs)
  _ -> false
}

fn x_sib_has(sibs: [XSib], c: SymId) : Bool = match sibs {
  [] -> false
  [XSib(s, _), ...rest] -> sym_raw(s) == sym_raw(c) or x_sib_has(rest, c)
}

fn x_absent_sibling(sibs: [XSib], keys: [XKey]) : XSig = match sibs {
  [] -> XSigComplete
  [XSib(c, spelled), ...rest] ->
    if xk_has(keys, XKVariant(c)) { x_absent_sibling(rest, keys) } else { XSigOpen(spelled) }
}

fn x_siblings(c: SymId, tab: XCtors) : Option[[XSib]] = match tab {
  XCtors(lookup) -> lookup(c)
}

# The name a witness writes a variant key with: its own wildcard
# spelling, up to the payload.
fn x_key_name(k: XKey, tab: XCtors) : String = match k {
  XKVariant(c) -> match x_siblings(c, tab) {
    Some(sibs) -> x_sib_name(sibs, c)
    None       -> "_"
  }
  _ -> ""
}

fn x_sib_name(sibs: [XSib], c: SymId) : String = match sibs {
  [] -> "_"
  [XSib(s, spelled), ...rest] ->
    if sym_raw(s) != sym_raw(c) { x_sib_name(rest, c) }
    else {
      let i = string_index_of_char(spelled, '(')
      if i < 0 { spelled } else { string_slice(spelled, 0, i) }
    }
}

fn x_any_head(rows: [[Pattern]], pred: (XHead) -> Bool) : Bool = match rows {
  [] -> false
  [r, ...rest] -> pred(xh_row_head(r)) or x_any_head(rest, pred)
}

# The distinct constructor keys heading the rows, in first-seen order.
fn x_column_keys(rows: [[Pattern]], acc: [XKey]) : [XKey] = match rows {
  [] -> list_reverse(acc)
  [r, ...rest] -> match xh_row_head(r) {
    XCon(k, _) -> if xk_has(acc, k) { x_column_keys(rest, acc) } else { x_column_keys(rest, [k, ...acc]) }
    _          -> x_column_keys(rest, acc)
  }
}

# A complete signature: a value is missed iff it is missed under some
# constructor of the column.
fn x_split(keys: [XKey], rows: [[Pattern]], n: Int, tab: XCtors, seen: XVerdict) : XVerdict =
  match keys {
    [] -> seen
    [k, ...rest] -> match x_under(k, rows, n, tab) {
      XMissing(ws) -> XMissing(ws)
      XUnknown     -> x_split(rest, rows, n, tab, XUnknown)
      XCovered     -> x_split(rest, rows, n, tab, seen)
    }
  }

# The rows specialised to constructor `k`, with a missed vector's leading
# sub-witnesses folded back under `k`.
fn x_under(k: XKey, rows: [[Pattern]], n: Int, tab: XCtors) : XVerdict = {
  let names = xh_column_fields(k, rows)
  let arity = xh_arity(k, rows, names)
  if arity < 0 { XUnknown }
  else {
    match x_useful(xh_specialize(k, arity, names, rows), arity + n - 1, tab) {
      XMissing(ws) -> XMissing([xh_spell(k, x_key_name(k, tab), names, xh_take(ws, arity)), ...xh_drop(ws, arity)])
      v            -> v
    }
  }
}

# The rows headed by a wildcard, the head dropped.
fn x_default(rows: [[Pattern]], acc: [[Pattern]]) : [[Pattern]] = match rows {
  [] -> list_reverse(acc)
  [r, ...rest] -> match xh_row_head(r) {
    XAny -> x_default(rest, [xh_row_tail(r), ...acc])
    _    -> x_default(rest, acc)
  }
}

# the pattern-matrix rows of the coverage check: a row's head as a constructor
# key, the specialisation of the rows to one key, and the spelling of a
# witness built from a key.

#[doc("The constructor a row head tests: a record, the unit value, the empty list, a cons cell, a Bool literal, or a variant by its constructor's id (a named record or tuple pattern: its type's).")]
type XKey = XKRecord | XKUnit | XKNil | XKCons | XKTrue | XKFalse | XKVariant(SymId)

#[doc("A row head: a wildcard, a constructor key with its sub-patterns, a literal of an unbounded type, or an unmodelled shape.")]
type XHead = XAny | XCon(XKey, XSubs) | XLit | XOdd

#[doc("A constructor's sub-patterns, positional or by field name.")]
pub(pkg) type XSubs = XPos([Pattern]) | XNamed([PField])

#[doc("The head of a pattern.")]
fn xh_head(p: Pattern) : XHead = match p.pkind {
  PWild                     -> XAny
  PBind(_)                  -> XAny
  PHole(_)                  -> XAny
  PAs(_, inner)             -> xh_head(inner)
  PVariant(r, subs)         -> xh_named_head(r, XPos(subs))
  PVariantRecord(r, fs)     -> xh_named_head(r, XNamed(fs))
  PRecord(fs)               -> XCon(XKRecord, XNamed(fs))
  PList(pats, rest)         -> xh_list_head(pats, rest, p)
  PLit(lit)                 -> xh_lit_head(lit)
  _                         -> XOdd
}

# A reference nothing settled names no constructor the table could place.
fn xh_named_head(r: DeclRef, subs: XSubs) : XHead =
  if ref_resolved(r) { XCon(XKVariant(ref_sym(r)), subs) } else { XOdd }

fn xh_list_head(pats: [Pattern], rest: Option[Binder], p: Pattern) : XHead = match pats {
  [] -> match rest { Some(_) -> XAny  None -> XCon(XKNil, XPos([])) }
  [h, ...t] -> XCon(XKCons, XPos([h, Pattern { pkind: PList(t, rest), line: p.line, col: p.col }]))
}

fn xh_lit_head(lit: Expr) : XHead = match lit.kind {
  EBool(true)  -> XCon(XKTrue, XPos([]))
  EBool(false) -> XCon(XKFalse, XPos([]))
  EUnit        -> XCon(XKUnit, XPos([]))
  _            -> XLit
}

#[doc("True when `a` and `b` are the same key.")]
fn xk_eq(a: XKey, b: XKey) : Bool = match a {
  XKRecord     -> match b { XKRecord -> true  _ -> false }
  XKUnit       -> match b { XKUnit -> true  _ -> false }
  XKNil        -> match b { XKNil -> true  _ -> false }
  XKCons       -> match b { XKCons -> true  _ -> false }
  XKTrue       -> match b { XKTrue -> true  _ -> false }
  XKFalse      -> match b { XKFalse -> true  _ -> false }
  XKVariant(x) -> match b { XKVariant(y) -> sym_raw(x) == sym_raw(y)  _ -> false }
}

#[doc("True when `k` is one of `keys`.")]
fn xk_has(keys: [XKey], k: XKey) : Bool = match keys {
  []           -> false
  [h, ...rest] -> xk_eq(h, k) or xk_has(rest, k)
}

#[doc("The head of a row's first column; an empty row is a wildcard.")]
fn xh_row_head(row: [Pattern]) : XHead = match row {
  [p, ..._] -> xh_head(p)
  []        -> XAny
}

#[doc("A row without its first column.")]
fn xh_row_tail(row: [Pattern]) : [Pattern] = match row {
  [_, ...t] -> t
  []        -> []
}

#[doc("Whether a head is an unmodelled shape.")]
fn xh_is_odd(h: XHead) : Bool = match h { XOdd -> true  _ -> false }

#[doc("Whether a head is a literal of an unbounded type.")]
fn xh_is_lit(h: XHead) : Bool = match h { XLit -> true  _ -> false }

#[doc("Every field name the rows headed by `k` name, in first-seen order; empty for a positional key.")]
fn xh_column_fields(k: XKey, rows: [[Pattern]]) : [String] = list_reverse(xh_fields_acc(k, rows, []))

fn xh_fields_acc(k: XKey, rows: [[Pattern]], acc: [String]) : [String] = match rows {
  [] -> acc
  [r, ...rest] -> match xh_row_head(r) {
    XCon(k2, XNamed(fs)) -> xh_fields_acc(k, rest, if xk_eq(k2, k) { xh_add_fields(fs, acc) } else { acc })
    _                    -> xh_fields_acc(k, rest, acc)
  }
}

fn xh_add_fields(fs: [PField], acc: [String]) : [String] = match fs {
  [] -> acc
  [PField(f, _, _), ...rest] -> xh_add_fields(rest, if list_has(acc, f) { acc } else { [f, ...acc] })
}

#[doc("How many sub-columns key `k` opens: its field count when named, its payload length when positional, -1 when its rows disagree.")]
fn xh_arity(k: XKey, rows: [[Pattern]], names: [String]) : Int = match rows {
  [] -> list_length(names)
  [r, ...rest] -> match xh_row_head(r) {
    XCon(k2, XPos(ps)) ->
      if not xk_eq(k2, k) { xh_arity(k, rest, names) }
      else if list_is_empty(names) { list_length(ps) }
      else { 0 - 1 }
    _ -> xh_arity(k, rest, names)
  }
}

#[doc("The rows headed by `k` or a wildcard, the head replaced by its `arity` sub-patterns.")]
fn xh_specialize(k: XKey, arity: Int, names: [String], rows: [[Pattern]]) : [[Pattern]] = match rows {
  [] -> []
  [r, ...rest] -> match xh_row_head(r) {
    XAny -> [list_append(xh_wilds(arity), xh_row_tail(r)), ...xh_specialize(k, arity, names, rest)]
    XCon(k2, subs) ->
      if xk_eq(k2, k) { [list_append(xh_subs(subs, names), xh_row_tail(r)), ...xh_specialize(k, arity, names, rest)] }
      else { xh_specialize(k, arity, names, rest) }
    _ -> xh_specialize(k, arity, names, rest)
  }
}

fn xh_subs(subs: XSubs, names: [String]) : [Pattern] = match subs {
  XPos(ps)   -> ps
  XNamed(fs) -> map(names, (f) => xh_field_or_wild(f, fs))
}

fn xh_field_or_wild(f: String, fs: [PField]) : Pattern = match fs {
  [] -> xh_wild()
  [PField(g, sub, _), ...rest] -> if g == f { sub } else { xh_field_or_wild(f, rest) }
}

fn xh_wild() : Pattern = Pattern { pkind: PWild, line: 0, col: 0 }

fn xh_wilds(n: Int) : [Pattern] = if n <= 0 { [] } else { [xh_wild(), ...xh_wilds(n - 1)] }

#[doc("The first `n` elements of `xs`.")]
fn xh_take(xs: [String], n: Int) : [String] = match xs {
  [x, ...rest] -> if n <= 0 { [] } else { [x, ...xh_take(rest, n - 1)] }
  []           -> []
}

#[doc("`xs` without its first `n` elements.")]
fn xh_drop(xs: [String], n: Int) : [String] = match xs {
  [_, ...rest] -> if n <= 0 { xs } else { xh_drop(rest, n - 1) }
  []           -> []
}

#[doc("The source spelling of key `k` over the witnesses of its sub-columns; `cn` is the name a variant key's constructor is written with.")]
fn xh_spell(k: XKey, cn: String, names: [String], ws: [String]) : String = match k {
  XKCons        -> xh_spell_cons(ws)
  XKRecord      -> xh_spell_fields("", names, ws)
  XKVariant(c)  -> xh_spell_variant(c, cn, names, ws)
  XKUnit        -> "()"
  XKNil         -> "[]"
  XKTrue        -> "true"
  XKFalse       -> "false"
}

fn xh_spell_variant(c: SymId, cn: String, names: [String], ws: [String]) : String =
  if xh_is_tuple(c, ws) and not list_is_empty(names) { concat_all(["(", join_with(ws, ", "), ")"]) }
  else if not list_is_empty(names) { xh_spell_fields(concat_all([cn, " "]), names, ws) }
  else if list_is_empty(ws) { cn }
  else { concat_all([cn, "(", join_with(ws, ", "), ")"]) }

fn xh_is_tuple(c: SymId, ws: [String]) : Bool = match tuple_type_for_arity(list_length(ws)) {
  Some(t) -> sym_raw(ref_sym(tuple_type_ref(t))) == sym_raw(c)
  None    -> false
}

fn xh_spell_fields(prefix: String, names: [String], ws: [String]) : String =
  concat_all([prefix, "{ ", join_with(xh_field_pairs(names, ws), ", "), " }"])

fn xh_field_pairs(names: [String], ws: [String]) : [String] = match (names, ws) {
  ([f, ...fs], [w, ...rest]) -> [concat_all([f, ": ", w]), ...xh_field_pairs(fs, rest)]
  _                          -> []
}

# `[h, ...t]`, folding a tail witness that is itself a list into one list.
fn xh_spell_cons(ws: [String]) : String = match ws {
  [h, t] ->
    if t == "[]" { concat_all(["[", h, "]"]) }
    else if string_slice(t, 0, 1) == "[" { concat_all(["[", h, ", ", string_slice(t, 1, string_length(t))]) }
    else { concat_all(["[", h, ", ...", t, "]"]) }
  _ -> "[..]"
}
