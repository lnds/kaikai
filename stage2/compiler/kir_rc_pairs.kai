#[doc("Cancel a `dup` of a register against a later `drop` of it when only other registers' dups and drops separate them.")]

import compiler.kir

#[doc("`kp` with each block's cancelling dup/drop pairs removed.")]
pub(pkg) fn kir_rc_pairs_program(kp: KProgram) : KProgram =
  KProgram { ...kp, fns: map(kp.fns, f => kfn_with_blocks(f, map(f.blocks, rcp_block))) }

fn rcp_block(b: KBlock) : KBlock = KBlock { ...b, stmts: rcp_stmts(b.stmts, []) }

fn rcp_stmts(ss: [KStmt], acc: [KStmt]) : [KStmt] = match ss {
  [] -> list_reverse(acc)
  [s, ...rest] -> match s {
    KRC(KDup(KVar(x)), _) -> match rcp_cancel(rest, x, []) {
      Some(rest1) -> rcp_stmts(rest1, acc)
      None -> rcp_stmts(rest, [s, ...acc])
    }
    _ -> rcp_stmts(rest, [s, ...acc])
  }
}

# Only reference counts move inside the window, and their net effect does not
# depend on order: the cells freed are the same either way.
fn rcp_cancel(ss: [KStmt], x: String, skipped: [KStmt]) : Option[[KStmt]] = match ss {
  [] -> None
  [s, ...rest] -> match s {
    KRC(KDrop(KVar(y)), _) ->
      if y == x {
        Some(list_append(list_reverse(skipped), rest))
      } else {
        rcp_cancel(rest, x, [s, ...skipped])
      }
    KRC(KDup(KVar(y)), _) -> if y == x { None } else { rcp_cancel(rest, x, [s, ...skipped]) }
    _ -> None
  }
}
