fn compile_source(path: String, mode: Mode, backend: Backend, strict_holes: Bool, search_paths: [String], src: String, core_decls: [Decl], core_mods: [ModuleEntry], core_segs: [CoreSegment], core_rows: [NEnt], package_name: String, unstable_optins: [String], edition: Option[Edition], user_cache: Bool, batch_out: Option[String], core_cache: CoreCacheOpt, test_roots: [String], test_own: [String], cover: CoverSpec, test_plan: String, kir_verify: String, inputs_out: String, ffi_out: String, quiet: Bool) : Int / Console + File + Mutable {

  let tokens = tokenize(src)
  let lexed = lex_diags(path, src, tokens)
  let lex_errs = if list_is_empty(lexed) { 0 } else { 1 }
  let json = diags_json_file(mode, path)
  match mode {
    MTokens -> {
      dump_tokens(src, tokens)
      lex_errs
    }
    MHelp -> { usage(); 0 }
    MUsageError -> { usage(); 2 }
    _ -> {
      if lex_errs != 0 { vd_exit(json, [Verdict(lex_errs, lexed)]) }
      else {
        # The root file's declarations are homed at the build target.
        let target_mod_name = root_module_name(path)
        let roots = roots_of(target_mod_name, map(test_roots, (r) => module_home(r, core_mods)))
        # What the binary starts; every pass below is handed this one id.
        let entry = entry_id(target_mod_name, runs_blocks(mode))
        let parsed = parse_program(path, src, tokens, target_mod_name)
        # The root file's own names, for the stages that stop before the
        # program's table exists.
        let own_tab = st_of_entries(parsed.names)
        match parsed.decls {
          None -> vd_exit(json, [Verdict(1, parse_diags(parsed))])
          Some(own_decls) -> match mode {
            # `kai fmt`. Pretty-print right after parse, before any
            # desugaring runs, so the formatted output
            # mirrors the source as written (`var x = 1` stays
            # `var x = 1`, not its handle-State desugaring). Short-
            # circuit before the heavy semantic pipeline. MFmt prints
            # to stdout; MFmtCheck prints iff different and exits 1.
            MFmt(width) -> {
              let cmts = collect_comments(src, tokens)
              print(fmt_program(own_decls, own_tab, cmts, tokens, src, width))
              0
            }
            MFmtCheck(width) -> {
              let cmts = collect_comments(src, tokens)
              let formatted = fmt_program(own_decls, own_tab, cmts, tokens, src, width)
              # fmt_program strips the final newline (MFmt relies on
              # print to re-add it); compare against the canonical
              # on-disk shape, which carries exactly one.
              if string_concat_all([formatted, "\n"]) == src { 0 } else { print(formatted); 1 }
            }
            # `kai migrate`. Same parse-then-fmt path as MFmt, with the
            # rule set applied to the decls in between. The migrated
            # source goes to stdout (bin/kai owns the safe write-back);
            # the `manual:` report goes to stderr. Guards the never-
            # emit-non-parsing invariant: the output is reparsed and,
            # on failure, nothing is printed and the run fails.
            MMigrate -> {
              let cmts = collect_comments(src, tokens)
              run_migrate(path, src, own_decls, own_tab, cmts, edition)
            }
            # `kai mutate`. Same parse-then-stop shape as MFmt, but the
            # output is the site catalogue rather than source. The
            # mutant itself (MMutateApply) is the original source with
            # one token span rewritten — never a re-print, so a mutant
            # differs from its parent by the mutation and nothing else.
            MMutateList -> {
              # `print` ends a line, so an empty catalogue must print nothing, not one empty record.
              let sites = mutate_sites(own_decls, own_tab)
              if not list_is_empty(sites) { print(mut_sites_text(path, sites)) }
              0
            }
            MMutateListJson -> {
              print(mut_sites_json(path, imported_module_path(path, search_paths), mutate_sites(own_decls, own_tab), tokens, src))
              0
            }
            MListTests(label) -> {
              let text = tlist_text(label, own_decls)
              if text != "" { print(text) }
              0
            }
            MMutateApply(i) -> run_mutate_apply(path, src, tokens, own_decls, own_tab, i)
            _ -> {
            # Strip `#[doc(...)]` wrappers into the doc side table right
            # after parse — only `kai fmt` (above)
            # sees them downstream. The root file's single module doc
            # stays in the stream so the typer can lift it into
            # `TypedProgram.module_doc`; a second module-position doc
            # is a typed error counted in the aggregator below.
            let docs = doc_strip_collect(path, src, own_decls)
            let doc_errs = docs.errs
            let doc_decls = docs.decls
            # Report any `import ?name` holes BEFORE expand_imports
            # walks the decls. The hole is inert
            # for module loading (process_imports treats IkHole as
            # a no-op), but we want the diagnostic to fire even
            # when the hole is the only import-related issue.
            let import_hole_vd = vd_render(import_hole_diags(path, doc_decls,
                                                             dir_of(path),
                                                             search_paths))
            let own_decls_no_holes = strip_import_holes(doc_decls, [])
            # expand_imports returns both the flat decl list and the
            # module table; rqc_decls then walks every body and
            # rewrites `EField(EName(mod), fn)` to `EModCall(mod, fn)`
            # when `mod` is in the module table and not shadowed
            # locally. Core-module paths feed into the resolver's
            # `visited` set so `import encoding.toml`
            # (or any other core-loaded module) does not load the
            # same file twice.
            let core_paths = collect_module_origins(core_mods, [])
            let blocks = if runs_blocks(mode) { BlocksOwn(canon_paths(test_own)) } else { BlocksAll }
            let expanded = expand_imports(path, src, tokens, search_paths, own_decls_no_holes, core_paths, core_mods, core_segs,
                                          if user_cache { tcut_cache_dir(core_cache.proj_dir, path) } else { "" },
                                          test_roots, blocks, inputs_out)
            match expanded {
              EP_Mod(_, mods, _, _, _, scopes, _, _, _, _) ->
                if test_plan != "" { let _w = write_file(test_plan, tplan_text(scopes, mods)) }
            }
            # Dissolve the parser's surface-fidelity nodes (contract
            # clauses, `ensure where`, `:=` writes, anonymous rest
            # binders, impl tparams) into their semantic lowerings.
            # Runs on the flat post-import list so imported modules are
            # covered; only `kai fmt` / `kai migrate` (which short-
            # circuit above) ever see the surface shapes.
            # Kept un-lowered for `--ast`: the dump must show the
            # surface forms (tparam bounds, block lambdas, contracts)
            # or an AST-equality gate over it is blind to their loss.
            let surface_decls = match expanded { EP_Mod(ds, _, _, _, _, _, _, _, _, _) -> ds }
            # The program's one symbol table: the rows the parser minted
            # for every loaded file, with the core builtins. A pass that
            # mints declarations hands its rows up and the table is
            # extended; ids are derived, so none moves.
            let tab0 = st_program(list_append(core_rows,
              list_append(match expanded { EP_Mod(_, _, _, _, _, _, _, rows, _, _) -> rows }, parsed.names)),
              target_mod_name, core_mod_names(core_mods, []))
            let nsrcs = native_core_srcs(backend, core_cache, core_mod_names(core_mods, []))
            let npre = native_core_pre(core_cache, edition, nsrcs)
            let cpre = cmod_core_pre(backend, core_cache, edition)
            let core_hit = match backend { BkCModular -> cmod_core_hit(mode, core_cache, cpre)  _ -> native_core_hit(core_cache, npre) }
            let prunes = core_prunes(mode, backend, core_cache, core_hit)
            let core_decls_whole = core_decls
            let core_segs_whole = core_segs
            let surface_decls_whole = surface_decls
            let lib_mods = if prunes { prunable_modules(path, match expanded { EP_Mod(_, mt, _, _, _, _, _, _, _, _) -> mt }) } else { [] }
            let lib_fns = list_append(core_decls, precut_lib_fns(surface_decls, lib_mods))
            let pcut = if prunes { early_cut(core_cache.early_cut, lib_fns, tab0, cmod_plain(backend, mode)) } else { None }
            let emptied = match pcut { Some(pc) -> precut_emptied(pc, lib_fns)  None -> [] }
            let _pn = if core_cache.stats and is_some(pcut) { eprint("kaic2: core-precut: emptied #{list_length(emptied)} core functions") } else { () }
            let core_decls = match pcut { Some(pc) -> precut_decls(pc, core_decls)  None -> core_decls }
            let surface_decls = match pcut { Some(pc) -> precut_imported(pc, lib_mods, surface_decls)  None -> surface_decls }
            let core_segs = match pcut {
              Some(pc) -> map(core_segs, (s) => match s { PSeg(m, ds) -> PSeg(m, precut_decls(pc, ds)) })
              None     -> core_segs
            }
            # Bounds are stripped by the lowering below; keep them for the
            # monomorphiser, keyed by declaration once the symbols exist.
            let surface_fn_bounds = list_append(collect_surface_bounds(core_decls, tab0),
                                                collect_surface_bounds(surface_decls, tab0))
            let expanded_decls_raw0 = tparam_bind_decls(surface_lower_decls(surface_decls, tab0))
            # Unwrap `laws`/`axiom` protocol/impl wrappers to their bare
            # decls before any Decl walker runs, recording the law
            # registry — the `lower_axioms` discipline. No later pass sees
            # the wrapper variant.
            let stripped_laws = strip_law_wrappers(expanded_decls_raw0)
            let expanded_decls_raw = cover_decls(if runs_blocks(mode) { cover } else { cover_none() },
                                                 match expanded { EP_Mod(_, _, _, _, sg, _, _, _, _, _) -> sg },
                                                 match expanded { EP_Mod(_, mt, _, _, _, _, _, _, _, _) -> mt },
                                                 strip_sl_decls(stripped_laws))
            let n_imports_raw = match expanded { EP_Mod(_, _, n, _, _, _, _, _, _, _) -> n }
            # Count of import-resolution failures (e.g.
            # `import nothing_here` whose file is missing on the search
            # path). Folded into the exit-code aggregator below.
            let import_resolve_vd = match expanded { EP_Mod(_, _, _, v, _, _, _, _, _, _) -> v }
            # Register the target file itself in the module table under
            # its own basename, mirroring what `load_core_file` does for
            # core files. Without this, an intrinsic test block
            # inside `stdlib/core/option.kai` cannot say
            # `option.map(o, f)` — rqc rejects the qualifier when only
            # core files are registered. Tag the target's DFns with
            # `module_origin = Some(<basename>)` (skipping only the entry
            # point, which stays in the root unit) so
            # `add_decls_loop` registers them under the qualified key
            # `<mod>::<fname>`, matching the core path. This makes
            # self-qualified calls inside the target route through the
            # qualified env without depending on bare-name shadow
            # ordering.
            let target_exports = collect_pub_exports(expanded_decls_raw, tab0, [])
            let target_unstable = collect_unstable_exports(expanded_decls_raw, tab0, [])
            let target_me = ME(target_mod_name, target_exports, path, target_unstable)
            let expanded_decls = tag_target_decls_module_origin(expanded_decls_raw, target_mod_name, entry)
            # Free-fn protocol bounds for the root file. Stdlib/core
            # bounded aggregates already dispatch their op via a `_loop`
            # helper, so the existing post-mono validator covers them;
            # only root-file fns whose body never dispatches the bound
            # need this check. Re-key to the target module the same way
            # `tag_target_decls_module_origin` re-keys the decls, so the
            # records match the monomorphiser's `mo`.
            let fn_bounds = rekey_fn_bounds(parsed.fn_bounds, target_mod_name)
            # Every core file is also registered as a module under
            # its basename, so qualified calls into the stdlib
            # (`list.take(xs, n)`, `string.trim(s)`) resolve without an
            # explicit `import list`. Core entries come first so an
            # `import` of a same-named module can still shadow with rule
            # B. The target's own ME comes last so its bare name shadows
            # any same-named core (intentional: the file is
            # "itself").
            let module_table = list_append(
              list_append(core_mods, match expanded { EP_Mod(_, mt, _, _, _, _, _, _, _, _) -> mt }),
              [target_me])
            # The pre-typer passes walk one flat stream holding every
            # imported module's decls, so a diagnostic takes its file
            # from the decl it is walking, not from the root path.
            let diag_ctx = if quiet { df_quieted(diag_files(module_files(module_table, []), path)) }
                           else { diag_files(module_files(module_table, []), path) }
            # Run rqc on the core decls with the same module table
            # the main file uses, so `list.foo` calls inside a core
            # file reach the EField->EModCall rewrite (otherwise the
            # typer rejects them as "undefined name `list`"). Entries
            # are collected before any core file is parsed so
            # cross-core qualified calls (e.g. `set.kai` calling
            # `list.length`) resolve.
            # Rewrite qualified types `mod.T` to bare `T` (validated
            # against module_table) before rqc walks the bodies. Runs
            # before rqc so the qualifier-strip is
            # complete before the EField->EModCall rewrite hits the
            # same expressions. The companion `qtchk_decls` pass
            # reports the heads that fail validation; `qualtype_decls`
            # leaves those unresolvable.
            # DConst now survives as DConst through the whole pipeline
            # (no lowering to a disguised zero-arg fn). `qualtype_decl`
            # handles the DConst arm directly, so the const reaches the
            # qualified-type rewrite, the typer, and emit as a const.
            # Core decls arrive parsed (possibly cache-restored), so
            # they carry surface nodes too.
            # The imported half of the stream resolves per segment: an
            # alias belongs to the file that wrote it, so a consumer
            # binding the same module under another name cannot displace
            # it. `module_table` stays the fallback for the names every
            # file sees without importing them (auto-loaded cores).
            let mod_scopes = match expanded { EP_Mod(_, _, _, _, _, sc, _, _, _, _) -> sc }
            let seg_marks = match expanded { EP_Mod(_, _, _, _, sg, _, _, _, _, _) -> sg }
            let mod_tabs = mtabs_build(mod_scopes, module_table)
            let mod_imps = scope_imports(mod_scopes, module_table)
            let core_decls_l = tparam_bind_decls(surface_lower_decls(core_decls, tab0))
            let sel_imports = sel_with_ctors(match expanded { EP_Mod(_, _, _, _, _, _, si, _, _, _) -> si },
                                             mod_scopes, module_table, expanded_decls, tab0, target_mod_name)
            let pkg_picks = package_picks(list_append(match expanded { EP_Mod(_, _, _, _, _, _, _, rows, _, _) -> rows }, parsed.names),
                                          module_table, path, target_mod_name)
            let sym_views = fv_build(mod_imps,
                                     sel_imports, mod_scopes, module_table,
                                     core_mod_names(core_mods, []),
                                     target_mod_name, pkg_picks)
            # Every effect reference is settled to its declaration here, while
            # a qualified head or perform still carries its qualifier; two
            # modules declaring the same effect name each get a home-spelled one.
            let es_coll = es_collect(list_append(core_decls_l, expanded_decls), tab0, target_mod_name)
            let eff_scoped = es_segmented(seg_marks, expanded_decls,
              mod_tabs, target_mod_name, tab0, sym_views)
            let core_es = es_core_decls(core_decls_l, mod_tabs,
              target_mod_name, tab0, sym_views)
            # Likewise two modules declaring the same nominal type: each
            # gets a home-spelled one, and a qualified `m.T` picks the
            # home while the qualifier is still written.
            let ts_eff_names = effect_names_of(list_append(core_es, eff_scoped), tab0)
            let ts_coll = ts_collect(list_append(core_es, eff_scoped), tab0, target_mod_name, ts_eff_names)
            # A bare type two imports both export is an error, decided
            # against the symbol table before the ladder respells the
            # declarations: past this point the use site no longer
            # spells what the author wrote.
            let ty_scope_vd = vd_render(tschk_segmented(seg_marks, eff_scoped, tab0, sym_views,
              target_mod_name, diag_ctx))
            let scoped_decls = ts_segmented(seg_marks, eff_scoped, ts_coll,
              mod_tabs, mod_imps, target_mod_name, core_mod_names(core_mods, []), sel_imports)
            let eff_scope_vd = vd_render(eschk_segmented(seg_marks, scoped_decls, es_coll,
              mod_tabs, target_mod_name, tab0, sym_views, diag_ctx))
            let pat_qual_vd = vd_render(list_append(pqchk_decls(core_es, module_table, diag_ctx),
                                                    pqchk_segmented(seg_marks, scoped_decls, mod_tabs, diag_ctx)))
            let qh_vd = vd_render(list_append(qhchk_decls(core_es, module_table, diag_ctx),
                                              qhchk_segmented(seg_marks, scoped_decls, mod_tabs, diag_ctx)))
            let qualtype_vd = vd_render(list_append(qtchk_decls(core_es, tab0, module_table, diag_ctx),
                                                    qtchk_segmented(seg_marks, scoped_decls, tab0, mod_tabs, diag_ctx)))
            let qt_core_q = qualtype_decls(core_es, tab0, [qualtype_list_mark(), ...module_table])
            let qt_expanded_q = qualtype_segmented(seg_marks, scoped_decls, tab0, mod_tabs, mod_imps)
            # A qualified union member is re-pointed to a constructor of
            # the module it names.
            let tab1 = st_extend(tab0, list_append(qt_core_q.rows, qt_expanded_q.rows))
            let qt_core = qh_decls(qt_core_q.decls, module_table)
            let qt_expanded = qh_segmented(seg_marks, qt_expanded_q.decls, mod_tabs)
            # Key each free read of a colliding const name to the
            # module that owns it (the per-module scoping type_scope
            # applies to type names, on the value side). Runs
            # before rqc so a qualified uppercase const read is keyed
            # before the variant-ctor collapse drops its module. The
            # collision table spans both streams — core, imports and
            # root all share the value namespace.
            let cs_coll = nu_const_coll(list_append(qt_core, qt_expanded), tab1,
                                            target_mod_name)
            # The effect ops rqc may defer to when a qualifier loses in
            # the module table but names an effect's op (`Stdout.print`
            # beside a user module `Stdout`).
            let rqc_fx = rqc_collect_fx(list_append(qt_core, qt_expanded), tab1)
            # A bare function or constructor name two modules both export
            # keys to the home the reading module can actually see. The
            # table spans both streams, like the const one; only the
            # import segments carry a viewpoint, since a core decl reads
            # its own home first and the root sees every import.
            let vs_coll = vs_collect(list_append(qt_core, qt_expanded), tab1, target_mod_name)
            let vs_expanded = vs_segmented(seg_marks, qt_expanded, vs_coll, mod_tabs,
                                           mod_imps, target_mod_name,
                                           core_mod_names(core_mods, []))
            let qualified_core = rqc_decls(nu_scope_const_decls(qt_core, cs_coll, target_mod_name, mtabs_build([], module_table)), module_table, rqc_fx, diag_ctx)
            let qualified_decls = rqc_segmented(seg_marks, nu_scope_const_decls(vs_expanded, cs_coll, target_mod_name, mod_tabs), mod_tabs, rqc_fx, diag_ctx)
            let missing_exports = list_append(mexp_decls(qualified_core, module_table, diag_ctx, target_mod_name, pkg_picks),
              mexp_segmented(seg_marks, qualified_decls, mod_tabs, target_mod_name, diag_ctx, pkg_picks))
            # Emit warnings for consumed `#unstable` exports the user
            # hasn't opted into. Runs over the user
            # decls only (cores are part of the stdlib and the
            # consumer never owns them, but stdlib has no unstable
            # decls today; including the core here keeps the
            # behaviour consistent if that ever changes).
            if quiet { () } else {
              unstable_check_decls(qualified_decls, module_table,
                                   package_name, unstable_optins, diag_ctx)
            }
            # Mangle non-`pub` core DType names
            # (`crypto.hash::SplitN`, `regexp::NB_FragR`, etc.) so
            # the variant-table lookup cannot collide with a
            # user-side redeclaration of the same bare name. The
            # `core_segs` accumulator from `load_core_files`
            # carries the per-file `(mod_name, decls)` split that
            # the post-`load` flatten erases — we use it to
            # establish each core decl's home module
            # unambiguously, since `DType` has no `module_origin`
            # field of its own and the streaming
            # `decl_home_hint_reset` heuristic would carry the
            # previous core's home into a DType at the head of
            # the next file. The root-file decls
            # (`qualified_decls`) are left untouched: they cannot
            # reference a mangled core private type (those
            # names are not exported) and the user is free to
            # redeclare the same bare name.
            let qualified_core_mangled =
              mangle_core_segments(qualified_core, tab1, core_segs,
                                         list_length(qualified_core))
            let merged_raw = list_append(qualified_core_mangled, qualified_decls)
            # `pub` enforcement at module + core boundaries. After
            # `rqc_decls` has rewritten every
            # `EField(EName(mod), fn)` into `EModCall(mod, fn)`
            # (which carries qualified-export gating via
            # `me_has_export`), the remaining bare-name references
            # are unqualified lookups. The validator consumes
            # per-module segments with explicit homes: the core
            # per-file split, the resolver's per-import marks, and
            # the root file — no streaming home heuristics.
            #
            # Split `qualified_decls` into the imports-via-`import`
            # head (first n_imports_raw entries) and the root-file
            # tail (own decls, untagged-or-target-tagged).
            let imports_decls = pae_take(qualified_decls, n_imports_raw)
            let root_only_decls = pae_drop(qualified_decls, n_imports_raw)
            # Segment views of the post-rqc streams: core segment
            # lengths come from `core_segs` (rqc rewrites decls
            # 1:1), import boundaries from the resolver's marks.
            let import_seg_marks = match expanded { EP_Mod(_, _, _, _, sg, _, _, _, _, _) -> sg }
            let pa_segs = list_append(
              pa_reseg(core_segs, qualified_core),
              list_append(
                pa_import_segs(import_seg_marks, imports_decls),
                [PSeg(target_mod_name, root_only_decls)]))
            # Reject two `type T = ...` with the same name in the
            # root file, and the reserved builtin type names. A name
            # that merely collides with a core / imported module is
            # NOT rejected — that is shadowing, resolved at the merge
            # point where a local decl drops the core one.
            # Runs before the pub-access walk for the same reason the
            # fn-shadow check does: a redeclared builtin type makes every
            # stdlib annotation naming it look like a private-access
            # violation on the user's module.
            let type_name_coll = validate_type_name_collisions_decls(
              root_only_decls, tab1, path)
            let pub_access_vd =
              if type_name_coll != [] { vd_count(0) }
              else { vd_render(validate_pub_access(pa_segs, tab1, list_append(fn_bounds, surface_fn_bounds), target_mod_name, core_mod_names(core_mods, []), diag_ctx, pkg_picks)) }
            # Reject two `fn foo` decls in the same root file. Mirrors
            # the type check above. The resolver's `register_one`
            # prepends blindly so a second `fn foo` would otherwise
            # silently shadow the first.
            let fn_name_coll = validate_fn_name_collisions_decls(
              root_only_decls, tab1, path)
            # Same shape for `effect`, `const`, `axiom`.
            # `register_one` prepends each kind blindly into the env,
            # so a second decl silently shadows the first. Walks the
            # root file only — cross-module shadowing is gated by
            # `pub` + `use` and remains permitted.
            #
            # The const-name collision check walks the raw root decls
            # (DConst survives unlowered now, but the raw split is the
            # established input and mirrors the post-rqc split).
            let root_only_decls_raw = pae_drop(expanded_decls_raw, n_imports_raw)
            let effect_name_coll = validate_effect_name_collisions_decls(
              root_only_decls, tab1, path)
            let const_name_coll = validate_const_name_collisions_decls(
              root_only_decls_raw, tab1, path)
            let axiom_name_coll = validate_axiom_name_collisions_decls(
              root_only_decls, tab1, path)
            # A builtin is declared only by a module that may, judged by
            # the file each declaration was read from: the root by its own
            # path, an import by its entry's, never through a module name a
            # user file can share with one of them.
            let import_files = diag_files(module_files(match expanded { EP_Mod(_, mt, _, _, _, _, _, _, _, _) -> mt }, []), path)
            let kai_decl_vd = vd_render(list_append(
              kai_builtin_decl_diags(qualified_core_mangled, tab1, diag_files(module_files(core_mods, []), path), declares_kai_builtins),
              kai_builtin_decl_diags(qualified_decls, tab1, import_files, declares_kai_builtins)))
            # Synthesise `__ref_pred_X` fn for every
            # `type X = Base where pred` so match-arm narrowing
            # `p : X` resolves cleanly (parse_optional_arm_refine
            # emits an ECall to this name).
            let ref_synth = synthesize_refine_pred_fns(merged_raw, tab1, target_mod_name)
            let merged_raw_synth_ref = ref_synth.decls
            let tab2 = st_extend(tab1, ref_synth.rows)
            let ref_pred_fns = refine_pred_fn_syms(merged_raw, tab1)
            # Rewrite `PNarrow(name, T)` where `T` is a
            # refinement-type alias back into `PBind(name)` +
            # `__ref_pred_T(name)` guard so match-arm narrowing keeps
            # working under the unified parser path. Non-alias
            # `PNarrow` survives for the typer's union-component check.
            let narrow_aliases = collect_refine_alias_ids(merged_raw_synth_ref)
            let merged_raw_synth = lower_pattern_narrow_decls(merged_raw_synth_ref, tab2, sym_views, target_mod_name, narrow_aliases)
            # Lower DAxiom → DFn(body=todo!) before any other Decl
            # walker runs. Subsequent passes (alias resolution,
            # builtin injection, desugars, typer) see only ordinary
            # fns and never need to handle the DAxiom variant.
            let opaques = lower_extern_opaques(lower_axioms(merged_raw_synth, target_mod_name), target_mod_name)
            # The record each opaque handle lowered to.
            let tab3 = st_extend(tab2, opaques.rows)
            let extern_scope = ExternScope(tab3, sym_views, target_mod_name, roots)
            let merged_pre_kinds = settle_extern_structs(opaques.decls, extern_scope)
            # Kind resolution + unit hygiene, done up front so every later
            # pass sees a stream with habitant symbols already qualified
            # (`m` -> `Metric$m`) and no `DKind`/`DUseKind` catalog decls.
            # The rewrite makes the abelian engine isolate habitants
            # across kinds; the validator then reports every still-bare
            # `<sym>` that is undeclared or ambiguous. The kind registry
            # comes from the `DKind` decls kept in the merged stream (they
            # are stripped here). Runs before alias expansion, so alias
            # names pass through bare for the later expansion pass.
            let kind_reg = kind_reg_from_decls(merged_pre_kinds)
            # Habitant declaration sites with exact per-module homes,
            # stamped at the declaration boundary. A `unit` name is
            # module-scoped: resolution prefers a module's own
            # declaration and separates same-kind homonyms declared by
            # different modules.
            let usites = nu_unit_sites(merged_pre_kinds, target_mod_name)
            let hab_view = hab_view_of(mod_imps,
                                       core_mod_names(core_mods, []), target_mod_name)
            let kind_ctx_a = resolve_kinds_ctx(merged_pre_kinds, kind_reg, usites, hab_view)
            let merged_kr = resolve_kinds_decls_in(kind_ctx_a, merged_pre_kinds, usites, target_mod_name)
            let kind_ctx = build_kind_ctx(merged_kr, tab3, kind_reg, usites, hab_view)
            # Atomic (kind, theory) pairs, captured before the catalog
            # decls are stripped; the typer's unit formation and
            # unify_dim dispatch on the theory of each habitant's kind.
            let kind_theories = atomic_kind_theories(merged_kr)
            let unit_ref_vd = vd_render(validate_unit_refs_decls(merged_kr, PScope(tab3, sym_views, target_mod_name), unit_scope(kind_ctx), diag_ctx))
            # Habitant-declaration rules: closed-set atoms are
            # engine-known, closed kinds admit no habitant decls, and
            # measure payloads land only on measure-carrying kinds.
            let hab_decl_vd = vd_render(validate_habitant_decls(merged_kr, kind_reg, diag_ctx))
            # A kind names one unification algebra and an introducer is
            # habitant-declaration syntax; neither has a use site a
            # qualifier reaches, so the duplicate is rejected here —
            # before `strip_kind_decls` removes the declarations.
            let kind_home_vd = vd_render(validate_kind_homes(merged_kr, diag_ctx))
            # Shape-application formation: arity-1, no composition.
            let shape_ref_vd = vd_render(validate_shape_refs_decls(merged_kr, diag_ctx))
            let merged_no_laws = strip_kind_decls(merged_kr)
            # Autogenerate `Functorial` property-checks for each lawful
            # Shape-protocol impl of a module whose blocks the build keeps,
            # injected only when the mode runs checks (`kai check` /
            # `kai test`): a dependency's impls are its own build's to check.
            # The witnesses come from the impl type's own constructors; an
            # `axiom` clause exempts.
            let law_reg = strip_sl_reg(stripped_laws)
            let gen_laws =
              if wants_law_checks(mode) {
                let kept = match expanded { EP_Mod(_, mods, _, _, _, scopes, _, _, _, _) -> bscope_kept(blocks, scopes, mods, test_roots) }
                gen_law_checks(merged_no_laws, PScope(tab3, sym_views, target_mod_name), law_reg, path, kept)
              }
              else { GL([], []) }
            let merged = list_append(merged_no_laws, gen_laws_decls(gen_laws))
            emit_law_check_notes(gen_laws_notes(gen_laws))
            # A nominal `pub type` whose ctor field uses an effect-row
            # variable it never declares panics the scheme builder; catch
            # it here with an unbound-row-var diagnostic.
            let nominal_row_diags = validate_nominal_row_vars_decls(merged, diag_ctx)
            # Collision check on `type T = A | B` declarations. Walks
            # every TBSum and reports any variant
            # name claimed implicitly by two different parents (with
            # neither parent pre-declaring the variant as its own
            # `type`).
            let union_collision_vd = vd_render(validate_union_collisions_decls(merged, tab3, diag_ctx))
            # At most one `#[constructor]` per constructed type. A second
            # marked fn returning the same type is rejected — arity/type
            # overloading is out (Tier 1 #3).
            let constructor_uniq_vd = vd_render(validate_constructor_uniqueness_decls(merged, PScope(tab3, sym_views, target_mod_name), diag_ctx))
            let variant_cap_vd = vd_render(validate_variant_capacity(merged, tab3, diag_ctx))
            # An extern type names one C layout, so a second declaration
            # under the same spelling has no reading that keeps both
            # correct — the duplicate is the defect, not an ambiguity.
            let extern_home_vd = vd_render(validate_extern_type_homes(merged, diag_ctx))
            # One C symbol has one signature. Two modules describing it
            # alike is the ordinary pattern; two describing it
            # differently emit contradictory prototypes no backend can
            # honour, and under separate compilation neither `cc` nor
            # the linker ever sees the two side by side.
            let extern_fn_vd = vd_render(validate_extern_fn_homes(merged, tab3, diag_ctx))
            # An extern signature names C types only: scalars, fixed-width
            # annotations, and the declared extern structs / opaques.
            let extern_type_diags = validate_extern_fn_types(merged, extern_scope, diag_ctx)
            # Closed effect aliases. Resolve every
            # `type Foo = Eff1 + Eff2 + ...` (and `type Foo = Eff`
            # single-name form) into a flat label set and rewrite every
            # DFn's RowExpr to substitute alias names. Builtin effect
            # injection runs *first* so the auto-injected
            # `type Console = Stdout + Stderr` alias participates in
            # alias resolution alongside user-declared aliases. Builtin
            # effect names still participate in the namespace whether or
            # not the file declared an `effect` for them. Cycles and
            # non-effect labels in alias bodies are fatal.
            let injected = inject_builtin_effects(merged)
            let declared_effs = effect_names_of(injected, tab3)
            let eff_names_for_alias = declared_effs
            let alias_cands = collect_alias_cands(injected, tab3, diag_ctx)
            let alias_res = resolve_alias_cands(alias_cands, tab3, path)
            let raw_decls_post_eff = expand_aliases_in_decls(injected, tab3, alias_res.aliases)
            # Expand transparent type aliases. `type Foo = T`
            # (single-component, name not an effect) is structural —
            # every TyName("Foo", args) rewrites to the alias body with
            # tparams substituted. Multi-component `type X = A | B`
            # (TBSum) keeps nominal-union semantics. Refinement-aliases
            # (`type Pos = Int where p`) expand to their inline
            # `TyRefine` form at every use site (the synthesised
            # `__ref_pred_X` fns and the pattern-narrow lowering have
            # already run). A copy carries the identities the alias's
            # own module gives its predicate.
            let raw_decls_settled = settle_alias_refinements(raw_decls_post_eff, tab3, sym_views, target_mod_name)
            let ta_table = collect_transparent_aliases(raw_decls_settled, tab3,
                                                        eff_names_for_alias, target_mod_name,
                                                        core_mod_names(core_mods, []))
            # Re-run effect-alias expansion after transparent type-alias
            # expansion. Transparent aliases parameterised by
            # a row variable (`type Foo[t, e] = ... / e`) may surface
            # effect-alias labels (e.g. `Console`) that the first pass
            # did not see, because the substituted name was carried in
            # the TPSubst as a TypeExpr argument rather than appearing
            # syntactically in the decl stream.
            let raw_decls_pre_pos0 =
              expand_aliases_in_decls(
                expand_ta_decls(raw_decls_settled, tab3, ta_table,
                                 alias_res.aliases),
                tab3, alias_res.aliases)
            # Alias expansion may have inserted bare unit symbols
            # (`Money[USD]` -> `Decimal<USD>`): re-qualify habitants
            # against the kind registry and re-validate, so an unknown
            # or ill-shaped alias argument diagnoses at its use site.
            # Gated on the first validation being clean to avoid
            # duplicate diagnostics.
            let kind_ctx_b = resolve_kinds_ctx(raw_decls_pre_pos0, kind_reg, usites, hab_view)
            let raw_decls_pre_pos = resolve_kinds_decls_in(kind_ctx_b, raw_decls_pre_pos0, usites, target_mod_name)
            let post_alias_unit_vd = if vd_failed([unit_ref_vd]) { vd_count(0) } else {
              vd_render(validate_unit_refs_decls_expanded(raw_decls_pre_pos, PScope(tab3, sym_views, target_mod_name), unit_scope(kind_ctx), diag_ctx))
            }
            # Refined parameters are checked on entry, now that every
            # refinement is the inline `TyRefine` form.
            let raw_decls_enforced = enforce_refinements_decls(raw_decls_pre_pos, tab3, ref_pred_fns)
            # Rewrite `T { v1, v2 }` (the parser plants nameless
            # positional fields) into `T { f1: v1, f2: v2 }`
            # using the record's declared field order. Runs before any
            # other pre-typer pass so no downstream walker observes a
            # nameless field. Reports unknown-record + arity
            # diagnostics; on errs > 0 we short-circuit before
            # invariants downstream can panic on the still-tagged AST.
            let pos_recs = typer_records(raw_decls_enforced, tab3)
            let pos_rec = desugar_pos_records_with(pos_recs, raw_decls_enforced, tab3, sym_views, target_mod_name, diag_ctx)
            let raw_decls_with_regions = pos_rec.decls
            let pos_rec_errs = pos_rec.errs
            if pos_rec_errs > 0 { pos_rec_errs } else {
            # Opt-in Perceus regions. Unwrap the `region { }` markers
            # (`ECall(EMark(MkRegion), [block])`) the parser emitted, as
            # the FIRST post-parse rewrite — before any other desugar
            # pass can choke on the unusual "block as a call argument"
            # shape (a marker that survives into a pass whose match
            # assumes call args are non-blocks panics with
            # "non-exhaustive match"). Records the region side table
            # (`region_marks`, consumed by the emitter for arena
            # lowering + deep-copy-out at the block border) and replaces
            # each marker with its bare block, so every downstream pass +
            # the typer + both emitters see an ordinary block. Regions
            # lower to ordinary RC alloc, so selfhost stays
            # byte-identical for non-region code; the escape policy is
            # deep-copy-out at emit, not compile-time rejection, so this
            # rewrite emits no diagnostics. Lexical — no resolved binders.
            let region_rw = rewrite_regions_decls(raw_decls_with_regions, diag_ctx)
            let raw_decls = region_rw.decls
            let region_marks = region_rw.regions
            # Pre-resolve desugar of `a[i]` and `a[i] := v` into the
            # underlying array_get / array_set calls. Runs before name
            # resolution so every downstream pass sees only the core
            # form.
            # Pre-resolve desugar of `var name = init` into
            # `handle { rest } with State[T](init) as name { ... }`.
            # Runs after the index desugar so any `a[i]` inside a
            # `var`'s init or its rest-of-block has already been
            # lowered to a call.
            let indexed_decls = split_resume_decls(desugar_index_decls(raw_decls))
            # Lower naked cell reads (`counter` → `counter.get()`) and
            # veto cell access from an escaping closure. Runs before the
            # SVar → State[T] rewrite, so the lowered `.get()` is a plain
            # call by the time `desugar_var_decls` decides stack-slot
            # specialisation. Short-circuit on error so downstream passes
            # never see a dangling cap read.
            let cell_low = lower_cell_reads_decls(indexed_decls, diag_ctx)
            if cell_low.errs > 0 { cell_low.errs } else {
            # Loop lowering (both backends): dissolve literal `while`/
            # `until`/`repeat` combinator calls into loop intrinsics so the
            # var→slot specialisation below sees no capturing closure. The
            # C emitter pastes the bodies into an inline `for (;;)`; the
            # KIR lowering builds the equivalent block loop, so the KIR
            # dump modes keep matching the native pipeline byte-for-byte.
            let loop_low_md = match mode { MDumpPurity -> false _ -> true }
            let loop_blocked = if loop_low_md { loop_blocked_names(cell_low.decls, tab3) } else { [] }
            let loop_low = if loop_low_md { lower_loop_intrinsics_with(loop_blocked, cell_low.decls) }
                           else { cell_low.decls }
            let var_decls = desugar_var_decls(loop_low)
            # `use Effect` desugar. Strips DUse / SUse and rewrites bare
            # `EName(op)` references into qualified
            # `EField(EName(eff), op)` form when the op belongs to an
            # effect open in scope. Runs after the index/var
            # desugars so SVar and SIndexAssign are already lowered;
            # runs before lower_protocols so protocol ops don't
            # conflict with effect ops in the open set.
            let use_res = desugar_use_decls(var_decls, tab3, sym_views, target_mod_name, path)
            let use_errs = use_res.errs
            let post_use_decls = use_res.decls
            # Lower protocols / impls / #[derive] into ordinary
            # top-level fns + a registry the post-inference rewrite
            # consumes. The registry-driven dispatch resolution runs
            # later, after `infer_program` populates `Expr.ty`.
            let lowered = lower_protocols(post_use_decls, diag_ctx, target_mod_name,
                                          core_mod_names(core_mods, []),
                                          mod_imps,
                                          PScope(tab3, sym_views, target_mod_name))
            if quiet { () } else {
              report_imports(ledger_note_derived(match expanded { EP_Mod(_, _, _, _, _, _, _, _, l, _) -> l }, lowered.minted, diag_ctx),
                             abspath(path))
            }
            # The dispatchers, lowered impl methods and derived functions
            # the lowering minted. The passes below take this binding, not
            # the same table read back out of a resolver result: `Mutable`
            # is masked only over a table this function built.
            let sym_tab = st_extend(tab3, lowered.rows)
            # Every `#{...}` hole still calls a mark: the protocols are
            # registered now, so each takes the `show` its home reaches.
            let interp_cores = core_mod_names(core_mods, [])
            # The protocol operations are the resolver's last rung: every
            # bare use, interpolations' included, reaches one through it.
            let callee_ops = proto_rungs(lowered.reg)
            let interp_dot_vd = vd_render(check_interp_dots(lowered.decls, diag_ctx))
            let interp_lifted = c_bounded_decls(backend, bang_hoist_decls(interp_show_decls(lowered.decls,
                                                     proto_core_show(lowered.reg, interp_cores),
                                                     interp_cores, target_mod_name)), sym_tab)
            let root_picks = nt_picks_of(sel_imports, "", module_table)
            let early_const_uses = nu_scan_consts(interp_lifted, sym_tab, target_mod_name, root_picks)
            # The cell set is now seeded from the `with State[T] as name`
            # handlers the var rewrite produced, and from the user's own.
            # Idempotent on a read already lowered to `name.get()`.
            let interp_cell = relower_cell_reads_decls(interp_lifted, diag_ctx)
            let interp_decls_pre = interp_cell.decls
            # Value-position const reads need no rewrite (a const IS a
            # value). The ONE ambiguous case is pattern position: a bare
            # const name parses as PVariant/PBind, so rewrite it to an
            # equality-guard arm (`__cv if __cv == NAME -> ...`).
            let pattern_consts = const_pattern_names(interp_decls_pre, sym_tab)
            let interp_decls_c = desugar_const_patterns_with(pattern_consts, interp_decls_pre)
            # Rewrite `lo..hi` interval patterns into a binder + comparison
            # guard, so the checker + lowering see a bind-with-guard arm
            # (refutable, catch-all still required) instead of a `PRange`.
            let interp_decls = desugar_range_patterns_decls(interp_decls_c)
            # Cap-binding nursery rewrite: expand `nursery { n -> body }`
            # by stripping `n` from the lambda param list and
            # rewriting `n.<spawn|await|select|cancel|...>` inside
            # `body` to `Spawn.<op>`. Mints a fresh BrandId per
            # nursery scope; the resulting `[BrandRec]` is the
            # registry the typer reads for sibling-nursery
            # brand-mismatch detection.
            let nursery_rw = rewrite_nursery_caps_decls(interp_decls, diag_ctx)
            let all_decls = nursery_rw.decls
            let brand_registry = nursery_rw.brands
            let brand_calls = nursery_rw.calls
            # Brand-mismatch check on the post-rewrite AST. Walks every
            # fn body with a brand-
            # attribution environment (binding name → brand) and
            # rejects sibling-nursery mismatches at consume sites
            # (`n.await(f)` / `n.cancel(f)` / `n.select(fs)`) where
            # `f`'s brand differs from the surrounding scope's.
            let nursery_brand_errs = if df_quiet(diag_ctx) { 0 }
                                     else { check_nursery_brand_mismatch_decls(all_decls, sym_tab, diag_ctx, brand_calls, brand_registry) }
            let proto_reg = lowered.reg
            let proto_errs = lowered.errs
            # The stage's verdicts in the order their exits are tried: the
            # first failing count is the exit status, and the document
            # carries what every pass collected, whichever fails first.
            let front_vds = [
              Verdict(doc_errs, docs.diags), eff_scope_vd, ty_scope_vd, interp_dot_vd,
              vd_count(interp_cell.errs), import_resolve_vd, Verdict(alias_res.errs, alias_res.diags),
              vd_count(use_errs), Verdict(proto_errs, lowered.diags), import_hole_vd,
              unit_ref_vd, hab_decl_vd, shape_ref_vd, post_alias_unit_vd,
              vd_rendered(nominal_row_diags), union_collision_vd, constructor_uniq_vd,
              variant_cap_vd, extern_home_vd, extern_fn_vd, vd_rendered(extern_type_diags),
              kind_home_vd, vd_count(nursery_brand_errs), qualtype_vd, pat_qual_vd]
            let back_vds = [
              qh_vd, vd_rendered(type_name_coll), pub_access_vd, vd_rendered(fn_name_coll),
              vd_rendered(effect_name_coll), vd_rendered(const_name_coll), vd_rendered(axiom_name_coll),
              kai_decl_vd]
            # The missing exports are rendered only once every earlier pass is clean.
            if vd_failed(front_vds) { vd_exit(json, list_append(front_vds, back_vds)) }
            else if missing_exports != [] { vd_exit(json, [vd_render(missing_exports), ...back_vds]) }
            else if vd_failed(back_vds) { vd_exit(json, back_vds) }
            else {
            let front_cx_of = () => CoreFrontCx { tab0: tab0, tab1: tab1, target: target_mod_name, module_table: module_table,
                                       mod_tabs: mod_tabs, core_tabs: mtabs_build([], module_table), sym_views: sym_views, cs_coll: cs_coll, rqc_fx: rqc_fx,
                                       diag_ctx: diag_ctx, mangle: mangle_core_plan(qualified_core, tab1, core_segs),
                                       tab2: tab2, tab3: tab3, sym_tab: sym_tab, file: path,
                                       narrow_aliases: narrow_aliases, kind_ctx_a: kind_ctx_a, kind_ctx_b: kind_ctx_b,
                                       effect_aliases: alias_res.aliases, ta_table: ta_table, ref_pred_fns: ref_pred_fns,
                                       recs: pos_recs, blocked: loop_blocked, loops: loop_low_md,
                                       show: proto_core_show(lowered.reg, interp_cores), cores: interp_cores,
                                       bound: (ds) => c_bounded_decls(backend, ds, sym_tab), consts: pattern_consts,
                                       ts_coll: ts_coll, vs_coll: vs_coll, mod_imps: mod_imps, sel_imports: sel_imports, entry: entry }
            let front = TyperFront { df: diag_ctx, views: sym_views, target: target_mod_name, roots: roots,
                                     kind_theories: kind_theories, edition: edition_or_oldest(edition),
                                     cycles: match expanded { EP_Mod(_, _, _, _, _, _, _, _, _, cy) -> cy } }
            match mode {
              MAst -> { dump_program(surface_decls, tab0); 0 }
              MTypes -> { dump_types(doc_decls, own_tab); 0 }
              MEnv -> { dump_env(build_ty_env(all_decls, sym_tab).env); 0 }
              MInfer -> {
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                if rd.errs != 0 { rd.errs } else { let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab); dump_infer(path, rd.decls, tin) }
              }
              MDumpTyped -> {
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                if rd.errs != 0 { rd.errs } else { let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab); dump_typed(path, rd.decls, tin) }
              }
              MDumpTypedCore -> {
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                if rd.errs != 0 { rd.errs } else { let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab); dump_typed_core(path, rd.decls, tin) }
              }
              MDumpMono -> {
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                if rd.errs != 0 { rd.errs } else { let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab); dump_mono(path, rd.decls, tin) }
              }
              MDumpMonoOut -> {
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                if rd.errs != 0 { rd.errs } else { let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab); dump_mono_out(path, rd.decls, tin) }
              }
              MDumpRawSafe -> {
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                if rd.errs != 0 { rd.errs } else { let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab); dump_rawsafe(path, rd.decls, tin) }
              }
              MDumpBorrowSafe -> {
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                if rd.errs != 0 { rd.errs } else { let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab); dump_borrowsafe(path, rd.decls, tin) }
              }
              MDumpLastUse -> {
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                if rd.errs != 0 { rd.errs } else { let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab); dump_last_use(path, rd.decls, tin) }
              }
              MDumpIntervals -> {
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                if rd.errs != 0 { rd.errs } else { let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab); dump_intervals(path, rd.decls, tin) }
              }
              MDumpCallElision -> {
                let rd = resolve_decls_stamped(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                let chk = rd.errs
                let all_decls = rd.decls
                if chk != 0 { chk } else {
                  let protos = stamped_view(front, lowered.reg, all_decls, sym_tab)
                  let fused = pub_loop_workers(tailfuse_decls(all_decls, sym_tab, target_mod_name), sym_tab, target_mod_name)
                  let typed_tab = st_extend(sym_tab, fused.rows)
                  let tin = typer_in(front, protos, all_decls, typed_tab)
                  let typed = tcut_infer_program(path, fused.decls, "", tin, tcut_no_defer(), false)
                  if typed.errs != 0 { typed.errs } else { dump_call_elision(path, typed.decls, typed_tab) }
                }
              }
              MCheckCoreFront -> {
                let cx = front_cx_of()
                let res = resolve_program_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                let lines = core_front_check(cx, core_decls_whole, filter(surface_decls_whole, (d) => cf_module(d) != ""), all_decls, res)
                let fused_rows = pub_loop_workers(tailfuse_decls(all_decls, sym_tab, target_mod_name), sym_tab, target_mod_name).rows
                eprint("core-front: fused or split #{int_to_string(list_length(fused_rows))}:")
                each(lines, (l) => print(l))
                let bad = list_length(filter(lines, (l) => string_index_of_char(l, '!') >= 0))
                eprint("core-front: #{int_to_string(list_length(filter(core_decls_whole, (d) => cf_module(d) != "")))} core functions, #{int_to_string(list_length(filter(surface_decls_whole, (d) => cf_module(d) != "")))} library functions, #{int_to_string(bad)} differ")
                match core_cache.early_cut { EcOff -> bad  EcOn -> 0 }
              }
              MDumpBrands -> {
                # No type-check needed: the brand registry is collected
                # at the cap-binding rewrite, before inference. Emit the
                # registry directly and exit 0 so fixtures can pin the
                # output as a golden file.
                dump_brands(brand_registry, brand_calls); 0
              }
              MDumpEvidenceObligations -> {
                # Deliberately NOT gated on the resolver: the collision
                # the dump must surface lives in programs the typer
                # mis-resolves or rejects (the #789 fixtures). The pass
                # runs inference itself to anchor op-call callees, then
                # detects collisions structurally by op name, so a
                # mis-resolved or partially-rejected program still dumps.
                # Exit 0 — analysis only, so fixtures can pin a golden.
                # The typer knows the entry point by id, so the declarations
                # are stamped first; a resolver error leaves them unstamped.
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab)
                dump_evidence_obligations(path, rd.decls, tin, entry, target_mod_name)
              }
              MDumpEvidenceArity -> {
                # Injection-arity histogram for the §A.3 ABI spike. Runs
                # the injection pass over the whole loaded program (self-
                # compile + stdlib when pointed at the compiler) and
                # reports the per-fn evidence-param count distribution.
                # Analysis only; exit 0.
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab)
                dump_evidence_arity(path, rd.decls, tin, entry)
              }
              MDocJson -> {
                # Docs are syntactic — dump the side table collected at
                # parse time, no typecheck needed.
                print(doc_module_json(path, docs.module_doc, docs.items, own_tab))
                0
              }
              MLibraryMode -> {
                # Library mode reuses the typer through `infer_program`
                # (same as the other JSON dumps) and
                # answers position-keyed queries against the typed
                # AST. Probes are read from `# @probe` comments in
                # the source so a fixture is self-describing.
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                if rd.errs != 0 { rd.errs } else { let tin = typer_in(front, stamped_view(front, lowered.reg, rd.decls, sym_tab), rd.decls, sym_tab); dump_library_mode(path, src, rd.decls, tin) }
              }
              MLint -> {
                # Lints read the typed AST, so a clean typecheck is the
                # precondition. A type-rejected program returns its error
                # count (it is not a valid build); a clean one runs the
                # lints and always exits 0 so a lint never blocks a build.
                # The typer reads what a build's does: a lint that rejected
                # a pipe the build accepts would be unusable on idiomatic code.
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                let chk = rd.errs
                let all_decls = rd.decls
                if chk != 0 { chk } else {
                  let tin = typer_in(front, stamped_view(front, lowered.reg, all_decls, sym_tab), all_decls, sym_tab)
                  run_lint(path, lint_owned_mods(expanded, test_own), all_decls, post_use_decls, surface_decls, tin)
                }
              }
              MLintJson -> {
                let rd = resolve_decls_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                let chk = rd.errs
                let all_decls = rd.decls
                if chk != 0 { chk } else {
                  let tin = typer_in(front, stamped_view(front, lowered.reg, all_decls, sym_tab), all_decls, sym_tab)
                  run_lint_json(path, lint_owned_mods(expanded, test_own), all_decls, post_use_decls, surface_decls, tin)
                }
              }
              _ -> {
                let rd = resolve_decls_stamped(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
                let chk = rd.errs
                let all_decls = rd.decls
                let stamped = stamped_registry(front, proto_reg, all_decls, sym_tab)
                let proto_reg = reg_with_walked(stamped.reg, walked_impls(stamped.reg.impls, lowered.derived, all_decls))
                let stamp_ids = stamp_targets(proto_reg.impls, lowered.derived, core_mod_names(core_mods, []))
                let cvr = if chk == 0 and cmod_plain(backend, mode) {
                            match core_cache.core_seed {
                              Some(CoreSeed(dg, sd)) -> CoreVariant { digest: dg, seed: sd }
                              None -> core_variant(all_decls, sym_tab, core_mod_names(core_mods, []))
                            }
                          } else { core_variant_none() }
                let cvar = cvr.digest
                let useed = match core_cache.core_seed { Some(CoreSeed(_, sd)) -> sd  None -> unw_seed_none() }
                let want_seed = chk == 0 and cvar != "" and is_none(core_cache.core_seed) and not core_cache.full_core
                                and is_none(cmod_core_pick(backend, mode, core_cache, cpre, cvar))
                                and not cmod_variant_known(core_cache, cpre, cvar)
                let in_place = want_seed and is_none(core_hit) and core_prunes(mode, backend, core_cache, Some(cpre))
                let seeded = if in_place {
                  compile_source(path, mode, backend, strict_holes, search_paths, "fn main() : Unit / Console {\n}\n",
                                 core_decls_whole, core_mods, core_segs_whole, core_rows, package_name, unstable_optins,
                                 edition, false, Some("/dev/null"),
                                 CoreCacheOpt { ...core_cache, full_core: true, core_seed: Some(CoreSeed(cvar, cvr.seed)) },
                                 [], [], cover, "", kir_verify, "", "", true)
                } else { 1 }
                let picked = cmod_core_pick(backend, mode, core_cache, cpre, cvar)
                let prunes = prunes or (in_place and seeded == 0 and is_some(picked))
                let lib_mods = if in_place and prunes { prunable_modules(path, match expanded { EP_Mod(_, mt, _, _, _, _, _, _, _, _) -> mt }) } else { lib_mods }
                let need_seed = want_seed and not in_place
                let no_variant = chk == 0 and prunes and cvar != "" and is_some(core_hit) and is_none(picked) and not need_seed
                let core_hit = match backend { BkCModular -> picked  _ -> core_hit }
                let pcut = if chk == 0 and prunes and not no_variant {
                             core_pool(all_decls, list_append(core_mod_names(core_mods, []), lib_mods), proto_reg, emptied, cmod_plain(backend, mode))
                           } else { pool_none(all_decls) }
                let cut = pcut.cut
                let missed = match cut { CoreCut(_, _, m) -> m }
                if chk != 0 { vd_exit(json, [Verdict(chk, rd.diags)]) }
                else if need_seed {
                  # The core TU set of this program's variant does not exist yet: compile the core alone,
                  # with the unwind knowledge the program would bring, then this program against it.
                  let seeded = compile_source(path, mode, backend, strict_holes, search_paths, "fn main() : Unit / Console {\n}\n",
                                              core_decls_whole, core_mods, core_segs_whole, core_rows, package_name, unstable_optins,
                                              edition, false, Some("/dev/null"),
                                              CoreCacheOpt { ...core_cache, full_core: true, core_seed: Some(CoreSeed(cvar, cvr.seed)) },
                                              [], [], cover, "", kir_verify, "", "", true)
                  let again = if seeded == 0 and cmod_variant_known(core_cache, cpre, cvar) { core_cache }
                              else { CoreCacheOpt { ...core_cache, full_core: true } }
                  compile_source(path, mode, backend, strict_holes, search_paths, src, core_decls_whole, core_mods,
                                 core_segs_whole, core_rows, package_name, unstable_optins, edition, user_cache, batch_out,
                                 again, test_roots, test_own, cover, test_plan, kir_verify, inputs_out, ffi_out, true)
                }
                else if no_variant {
                  early_cut_note(core_cache.stats, ["no core TU set recorded for this program's variant"])
                  compile_source(path, mode, backend, strict_holes, search_paths, src, core_decls_whole, core_mods,
                                 core_segs_whole, core_rows, package_name, unstable_optins, edition, user_cache, batch_out,
                                 CoreCacheOpt { ...core_cache, full_core: true }, test_roots, test_own, cover, test_plan, kir_verify, inputs_out, ffi_out, true)
                }
                else if list_length(missed) > 0 {
                  core_cut_fail("keeps a function the early cut emptied", core_cut_names(sym_tab, missed))
                }
                else {
                  # Build the per-compile head-owner cache once from the
                  # post-`expand_imports` decl stream + the
                  # full module table (cores + transitively imported +
                  # the target file itself). The typer threads this cache
                  # into `synth_pipe_dispatch` so any in-scope `pub type`
                  # whose declaring module exports the canonical
                  # `map / flat_map / filter` participates in `|`, `||`,
                  # `|?` automatically — no compiler change required when
                  # a downstream package adds a new pipe-eligible type.
                  prune_note(core_cache.stats, prunes, cut)
                  let whole_decls = all_decls
                  let all_decls = match cut { CoreCut(kept, _, _) -> kept }
                  let dropped = match cut { CoreCut(_, d, _) -> d }
                  let pruned = match dropped { [] -> false _ -> true }
                  let whole_decls = pcut.stream
                  # The typed blobs follow the sources, so an explicit
                  # project directory wins over the entry's own: the
                  # native paths compile a copy of the entry from an
                  # ephemeral object-cache dir, and deriving the cache
                  # from that copy publishes blobs nothing ever reads.
                  # With the project cache off, a typecheck-only run rides
                  # the shared core-cache directory: the blobs are
                  # content-addressed by a key folding the module's decls,
                  # its inherited interface hash and the cross-module
                  # context, so a toolchain-scoped directory serves them
                  # safely, and without it the stdlib core is re-inferred
                  # on every invocation. Restricted to the modes that stop
                  # at the front-end: a build publishes one blob per module
                  # and the whole-compiler selfhost pays that serialisation
                  # on every run for a cache it never reads back.
                  let tcut_dir = typed_cut_dir(mode, user_cache, core_cache, path)
                  # Mutual tail recursion is fused into one
                  # self-recursive function ahead of inference, so the
                  # synthesised dispatch is typed like any other body and
                  # the self-tail rewrite downstream turns the cycle into
                  # the goto-loop it already emits.
                  let fused = pub_loop_workers(tailfuse_decls(whole_decls, sym_tab, target_mod_name), sym_tab, target_mod_name)
                  let dm = if pruned { Some(demand_new(fused.decls, pcut, proto_reg, true)) } else { None }
                  let front_src = FrontSrc { cx_of: front_cx_of, core: core_decls_whole, libs: precut_lib_fns(surface_decls_whole, lib_mods),
                                             stream: whole_decls, held: pcut.held, env: rd.env }
                  let defer = TcDefer { demand: dm, order: fused.decls, stats: core_cache.stats, front: Some(front_src) }
                  # The fused functions are declarations the typer must name.
                  let typed_tab = st_extend(sym_tab, fused.rows)
                  let tin = typer_in(front, stamped.view, whole_decls, typed_tab)
                  let tout = tcut_infer_demand(path, fused.decls, tcut_dir, tin, defer, match mode { MDumpSymIds -> true _ -> false })
                  let typed_prog0 = match tout { TcOut(tp, _) -> tp }
                  let asked_bare = match tout { TcOut(_, ms) -> ms }
                  if list_length(asked_bare) > 0 {
                    core_cut_fail("asks for a function the early cut emptied", core_cut_names(sym_tab, asked_bare))
                  } else {
                  # Contracts are discharged against the typed calls, where a
                  # pipe is the call it spells.
                  let contract_vd = if typed_prog0.errs != 0 { vd_count(0) }
                                    else { vd_render(call_site_diags(path, typed_prog0.decls, typed_tab)) }
                  # Post-inference protocol-call rewrite. `Expr.ty` is
                  # populated for every node now, so each `op(x, ...)`
                  # call can be redirected to the matching
                  # `__pimpl_<P>_<T>_<op>` direct call. Sites with
                  # unknown types fall through and execute the
                  # dispatcher fn's panic at runtime.
                  let proto_reg = match dm { Some(x) -> demand_registry(proto_reg, x, typed_prog0.decls)  None -> proto_reg }
                  let typed_prog = resolve_protocol_calls(typed_prog0, proto_reg)
                  # Walk the post-rewrite AST and report any
                  # `__proto_<op>` call whose receiver type is concrete
                  # but has no matching impl. Polymorphic helpers whose
                  # receiver is a TyVar at this point keep the runtime
                  # fallthrough behaviour.
                  let dispatch_diags =
                    validate_resolved_protocols(typed_prog, typed_tab, proto_reg, diag_ctx)
                  # The pinned-region gate. A `region { }` bump-arena is
                  # a per-thread pointer; a fiber that parks inside one
                  # would resume on another OS thread with a stale arena
                  # pointer. Fail the compile if any region body can reach
                  # a suspending effect — the typed row already carries
                  # the transitive reach a syntactic scan would miss.
                  let region_yield_diags = region_yield_findings(typed_prog.decls, region_marks, path)
                  # #789 op-name collision diagnostic. The by-name handler
                  # walk binds the wrong evidence when an op name is shared
                  # by ≥2 effects and the call is not disambiguated; the
                  # typer's resolution record (`op_res`) flags those sites.
                  # Capability passing makes the collision impossible, so it
                  # is a compile error, not corruption (the soundness hole
                  # #789's tangential native fix left open).
                  let collision_errs =
                    check_op_collisions(path, typed_prog.op_res, typed_prog.decls, typed_tab)
                  # One table, one message, every class: a contested
                  # type reads like a contested function, and a bare
                  # name two modules both export is an error rather
                  # than a pick by registration order.
                  let name_errs =
                    nr_report_program_tab(diag_ctx, typed_prog.decls, target_mod_name,
                                      lowered.reg, early_const_uses,
                                      core_mod_names(core_mods, []),
                                      post_use_decls, root_picks, sym_tab,
                                      mtabs_of(mod_tabs, "").entries, typed_prog.diags)
                  # Unused local bindings in the root file's fns and in every
                  # runner block; warnings only.
                  report_unused_in_decls(path, module_table, typed_prog.decls)
                  let typed_vds = [Verdict(0, rd.diags), Verdict(typed_prog.errs, typed_prog.diags), contract_vd,
                                   vd_rendered(dispatch_diags), vd_rendered(region_yield_diags),
                                   vd_rendered(collision_errs), vd_rendered(name_errs)]
                  if vd_failed(typed_vds) { vd_exit(json, typed_vds) }
                  else {
                    let hole_errs = if strict_holes { strict_holes_check(path, all_decls, tin) } else { 0 }
                    if hole_errs != 0 { vd_exit(json, [...typed_vds, vd_count(hole_errs)]) }
                    else if is_check_mode(mode) {
                      let mf = mono_front(typed_prog, proto_reg,
                                 bounds_by_sym(typed_prog.decls, surface_fn_bounds, target_mod_name),
                                 PScope(typed_tab, sym_views, target_mod_name), target_mod_name, path, diag_ctx, true)
                      vd_exit(json, [...typed_vds, mf.verdict])
                    }
                    else if is_report_mode(mode) { run_report_dump(mode, diag_ctx, pa_hidden_from_root(pa_segs, sym_tab, target_mod_name), typed_prog, typed_tab, docs.items) }
                    else {
                      let mf = mono_front(typed_prog, proto_reg,
                                 bounds_by_sym(typed_prog.decls, surface_fn_bounds, target_mod_name),
                                          PScope(typed_tab, sym_views, target_mod_name), target_mod_name, path, diag_ctx, false)
                      # A constant's initialiser with locals of its own is a
                      # function from here on; its read pastes the call.
                      let const_inits = const_init_fns(mf.decls, typed_tab, target_mod_name)
                      let tcut = if pruned { core_typed_cut(const_inits.decls, core_mod_names(core_mods, []), proto_reg, match dm { Some(x) -> demand_dropped(dropped, x, typed_prog.decls)  None -> dropped }) } else { TypedCut(const_inits.decls, []) }
                      let mono_decls = match tcut { TypedCut(ds, _) -> ds }
                      # The names the backends spell: the table with the
                      # closure specialisations the front minted, and the
                      # emitted name of every specialised instance. The index
                      # is rebuilt here: one read out of a record is never
                      # local, and the emitters' `Mutable` is masked only
                      # over carriers this function built.
                      let emit_tab = st_extend(typed_tab, list_append(mf.rows, const_inits.rows))
                      let specs = spec_names_of(spec_names_rows(mf.specs))
                      # Per-function evidence obligations, computed pre-mono
                      # and re-keyed onto the specialised symbols. Codegen
                      # reads none of it: the result is exercised, not consumed.
                      let _ev_meta = reindex_evidence_params(
                        inject_evidence_params(mf.prog.decls, entry), mono_decls)
                      # In-process libLLVM native backend. Computed BEFORE
                      # unbox so the pass can gate raw-binder promotion on the
                      # backend: the native load-border is NOT total, so a
                      # kind-1 Int arm binder may go raw ONLY where the native
                      # re-boxes it (a raw-op operand or a same-ctor reuse
                      # slot); the C oracle's mode-slave border is total, so it
                      # keeps the wider promotion (#1110).
                      let unbox_native = match backend { BkNative -> true BkNativeModular -> true _ -> false }
                      # Scalar var cells: rewrite non-escaping scalar
                      # slots (`array_make(1, lit)`) to raw local cells
                      # so the unbox pass below marks arithmetic over
                      # their reads raw on both backends.
                      # Every reference to a declaration keeps its id through
                      # unbox and perceus. One spelling per local binder from
                      # here on: every ownership table below keys on the name.
                      let erase_ctx = SymErase(emit_tab, target_mod_name)
                      # Operands a sibling can unwind past are named, so
                      # the ownership passes see binders, not temporaries.
                      let cell_decls = rfh_hoist_decls(unw_name_operands(unique_binders_decls(promote_scalar_cells(sym_qualify_decls_in(erase_ctx, mono_decls))), emit_tab, useed))
                      # Unbox analysis. Runs between monomorphisation
                      # and perceus so the perceus pass sees post-unbox
                      # modes (it only inserts dup/drop on `MBoxed`
                      # nodes).
                      let ci_slots = build_ctor_int_slots(cell_decls, emit_tab)
                      let unboxed_decls = unbox_pass(cell_decls, emit_tab, specs, ci_slots, unbox_native, entry)
                      # The native-raw match-arm Int binders, decided ONCE here
                      # (same verdict as the unbox seed) and read by perceus +
                      # KIR-lowering so no phase re-derives rawness from the
                      # mutated body (#1229). Empty under the C backend.
                      let raw_arm_binders = if unbox_native { native_raw_arm_binders(unboxed_decls, ci_slots, fnx_build(register_fn_decls(unboxed_decls, emit_tab, specs, entry))) } else { [] }
                      let bmode = match mode_program(mode) {
                        MTest -> BMTest
                        MBench -> BMBench
                        MPropCheck -> BMCheck
                        _ -> BMBuild
                      }
                      # Read-only KIR dump (no binary emitted).
                      let use_kir = match mode { MEmitKir(_) -> true MEmitKirNoInline(_) -> true _ -> false }
                      let kir_inline_on = match mode { MEmitKirNoInline(_) -> false _ -> true }
                      # In-process libLLVM native backend.
                      let use_native = match backend { BkNative -> true _ -> false }
                      # In-process libLLVM native SEPARATE compilation
                      # (per-`KFn.mo` object + content-addressed cache).
                      let use_native_modular = match backend { BkNativeModular -> true _ -> false }
                      # Separate-compilation C path (per-module .c/.h).
                      let use_modular = match backend { BkCModular -> true _ -> false }
                      # Pipeline order: `perceus → tcrec`. Perceus runs
                      # first so the AST already carries explicit
                      # `__perceus_dup` / `__perceus_drop` nodes by the
                      # time tcrec plants its sentinels. Tcrec then
                      # descends into the perceus wrap
                      # (`EBlock([entry, SLet(__pcs_ret, body),
                      # exit_drops], Some(ELocal(__pcs_ret)))`) and
                      # operates on the inner body — the wrap stays
                      # intact, the goto fires before the wrap's exit
                      # drops, and the dropmask is computed from the same
                      # `uses` set perceus consumed. See
                      # `tcrec_unwrap_pcs_ret` for the shape detector.
                      # Coupling the order the other way forces tcrec to
                      # re-emulate perceus's exit-drop computation, so a
                      # change to one has to be mirrored in the other.
                      # Below the erasure a name is a C symbol to spell.
                      let post_perceus_decls = sym_erase_decls_in(erase_ctx, perceus_pass_in(unboxed_decls, emit_tab, specs, sym_views, target_mod_name, entry))
                      # TCO is mandatory on BOTH backends.
                      # `tcrec_rewrite_decls` is a pure AST→AST pre-pass
                      # that plants the `__kai_tcrec|...` self-tail-call
                      # sentinel; the C emitter lowers it to a goto-loop
                      # and the LLVM emitter to a br-loop
                      # (`llvm_emit_tcrec_goto`). Running it for both
                      # keeps the analysis (dropmask + tail-position)
                      # single-sourced.
                      # TRMC (modulo-cons cctx rewrite) also runs on both
                      # backends. The LLVM emitter lowers the
                      # `__kai_trmc|` step sentinel and the
                      # `__kai_trmc_apply` terminal sentinel to a cctx
                      # br-loop (`llvm_emit_trmc_goto` /
                      # `llvm_emit_trmc_apply`), carrying the constructor
                      # context in two prologue allocas (`%_kai_acc.res` /
                      # `%_kai_acc.hole`) via the `kaix_cctx_*` runtime
                      # shims. Passing `allow_trmc = true` unconditionally
                      # keeps the rewrite single-sourced so both backends
                      # get mandatory TCO on modulo-cons recursion.
                      # `cons_ok` enables TRMC for the BUILTIN cons idiom
                      # (`[h, ...self(t)]` / perceus reuse-cons). The
                      # C-text emitter lowers the cons step sentinel
                      # (`emit_trmc_cons_step`) and the KIR/native path
                      # carries a well-formed `KTrmcStep` (head value +
                      # back-edge rebinds; see `lower_trmc_step`) — both
                      # get the rewrite so modulo-cons recursion stays
                      # O(1)-stack.
                      let cons_ok = true
                      let perceus_decls = tcrec_rewrite_decls(post_perceus_decls, true, cons_ok, target_mod_name, emit_tab, specs)
                      let use_purity = match mode { MDumpPurity -> true _ -> false }
                      let use_symids = match mode { MDumpSymIds -> true _ -> false }
                      let _ffi_header = write_ffi_header(ffi_out, collect_extern_types(perceus_decls, emit_tab), emit_tab)
                      let misses = match tcut { TypedCut(_, ms) -> list_uniq(core_cut_names(emit_tab, ms)) }
                      if vd_failed([mf.verdict]) { vd_exit(None, [mf.verdict]) }
                      else if list_length(misses) > 0 { core_cut_fail("references a core function pruning dropped", misses) }
                      else if pruned and core_cache_writes(backend, core_cache)
                                     and not core_hit_reusable(backend, core_hit) {
                        core_cut_fail("would write a core cache entry from a pruned core", [])
                      }
                      else if match mode { MCheckSiteIds -> true _ -> false } { check_site_ids(perceus_decls, emit_tab) }
                      else if match mode { MCheckWrittenEq -> true _ -> false } { check_written_eq(mono_decls, emit_tab, specs) }
                      else if use_purity {
                        # Confirmed-purity side table over the same
                        # post-perceus / post-tcrec AST the backends stamp
                        # from. Read-only; emit no binary.
                        dump_purity_marks(purity_analyze(perceus_decls, entry), emit_tab, specs, target_mod_name); 0
                      }
                      else if use_symids {
                        let kp = kir_inline_program(lower_to_kir(perceus_decls, emit_tab, specs, proto_reg.ids, region_marks, register_fn_decls(perceus_decls, emit_tab, specs, entry),
                                                                 register_variants(perceus_decls, emit_tab), Some(target_mod_name), raw_arm_binders, false, stamp_ids, entry))
                        let core_names = core_mod_names(core_mods, [])
                        print(string_join(symid_decl_lines("unbox", emit_tab, specs, core_names, cell_decls)
                                          ++ symid_decl_lines("perceus", emit_tab, specs, core_names, unboxed_decls)
                                          ++ symid_own_lines(emit_tab, specs, core_names, perceus_decls)
                                          ++ symid_kir_lines(emit_tab, core_names, kp)
                                          ++ symid_efn_lines(emit_tab, core_names, register_fn_decls(perceus_decls, emit_tab, specs, entry))
                                          ++ ctor_site_lines(emit_tab, core_names, cell_decls), "\n"))
                        0
                      }
                      else if use_native {
                        # In-process libLLVM native backend. Lower to
                        # KIR (same preamble as the KIR dumper: the decls
                        # are post-perceus / post-tcrec; only the
                        # symbol/variant tables are rebuilt), build the
                        # module via the C API in memory, and emit a
                        # native object. The output path is `<source>.o`;
                        # the `bin/kai` wrapper (or the test harness)
                        # links it against the effects runtime to the
                        # final executable.
                        let nfns = register_fn_decls(perceus_decls, emit_tab, specs, entry)
                        let nvariants = register_variants(perceus_decls, emit_tab)
                        let ncore_names = core_mod_names(core_mods, [])
                        let kp = kir_lin_hook(ncore_prune_unreachable(kir_inline_program(lower_to_kir(perceus_decls, emit_tab, specs, proto_reg.ids, region_marks, nfns, nvariants, Some(target_mod_name), raw_arm_binders, true, stamp_ids, entry)),
                                                         perceus_decls, nfns, bmode, ncore_names), kir_verify)
                        let obj_path = native_object_in(core_cache.nmod_dir, path)
                        # Core-object split: with the shared core cache
                        # available (dir + toolchain id) and a backend tag
                        # that allows it (libLLVM present, not a debug
                        # build), emit user + core as two raw objects and
                        # reuse the content-addressed core object across
                        # builds. Any missing ingredient falls back to the
                        # whole-program single object. One path per line on
                        # stdout; the wrapper links every listed object.
                        # llvm_backend_tag() is called at each use, never
                        # bound to a shared let: the ownership pass
                        # mis-counts a let consumed in this condition and
                        # reused in the branch below, so the record would
                        # capture a freed (empty) tag and every backend-tag
                        # component (triple, opt level, bitcode ids) would
                        # silently drop out of the core-object key.
                        native_single_emit(kp, perceus_decls, nvariants, nfns, bmode, obj_path, path, ncore_names,
                                           if pruned { core_hit } else { None },
                                           NCoreCfg { dir: core_cache.dir, toolchain: core_cache.toolchain,
                                                      edition: edition_key_text(edition), tag: llvm_backend_tag(), srcs_hex: nsrcs,
                                                      stats: core_cache.stats, pre: npre })
                      }
                      else if use_native_modular {
                        # Native separate compilation: partition the KIR by
                        # `KFn.mo` into N content-addressed objects, reused by
                        # any build that projects the same partition, and print
                        # one object path per line for the wrapper to link.
                        let nfns = register_fn_decls(perceus_decls, emit_tab, specs, entry)
                        let nvariants = register_variants(perceus_decls, emit_tab)
                        let kp = kir_lin_hook(ncore_prune_unreachable(kir_inline_program(lower_to_kir(perceus_decls, emit_tab, specs, proto_reg.ids, region_marks, nfns, nvariants, Some(target_mod_name), raw_arm_binders, true, stamp_ids, entry)),
                                                         perceus_decls, nfns, bmode, core_mod_names(core_mods, [])), kir_verify)
                        let obj_dir = if core_cache.nmod_dir == "" { dir_of(path) } else { core_cache.nmod_dir }
                        let objs = build_native_modular(kp, perceus_decls, nvariants, nfns, bmode,
                                                        dir_of(path), Some(obj_dir), path)
                        match objs { [] -> 1 _ -> { print(string_join(objs, "\n")); 0 } }
                      }
                      else {
                        let out = if use_kir {
                          # Dump the KIR lowering, emit no binary.
                          emit_kir(perceus_decls, emit_tab, specs, region_marks, kir_inline_on, stamp_ids, entry)
                        } else if use_modular {
                          # Per-module .c/.h stream; the wrapper splits + links.
                          emit_modular_maybe_cached(path, src, perceus_decls, emit_tab, specs, proto_reg.ids, bmode, target_mod_name, entry, region_marks, core_cache, core_mods, edition, cpre, cvar, useed, if pruned { core_hit } else { None }, stamp_ids)
                        } else {
                          emit_program(path, src, perceus_decls, emit_tab, specs, proto_reg.ids, bmode, Some(target_mod_name), entry, region_marks, stamp_ids)
                        }
                        match batch_out {
                          # `print` appends a trailing newline; match it
                          # so a batch `.c` is byte-identical to the
                          # stdout-captured fork output.
                          Some(op) -> match write_file(op, cat2(out, "\n")) {
                            Ok(_)  -> 0
                            Err(e) -> { eprint("kaic2: cannot write `#{op}`: #{e}"); 1 }
                          }
                          None     -> { print(out); 0 }
                        }
                      }
                    }
                  }
                  }
                }
              }
            }
            }
            }
            }
            }
          }
        }
      }
    }
  }
}

# Internal batch driver. Loads (lexes + parses) the core module set
# ONCE and compiles every listed input against that shared
# `CoresLoaded`, so the core's lex + parse is paid a single time for
# the whole batch instead of once per file. The per-file typecheck and
# codegen still run fresh — only the core load is amortised — so each
# output is byte-identical to a standalone build. Each input's `.c` is
# written to its paired output (native writes its `.o` to
# `native_object_path(input)`). Returns the count of inputs that failed
# to compile; 0 means the whole batch is clean.
fn run_batch_list(listfile: String, opts: CliOptions) : Int / Console + File =
  match read_file(listfile) {
    Err(msg) -> { eprint("kaic2: #{listfile}: #{msg}"); 1 }
    Ok(content) -> {
      let entries = parse_batch_entries(content)
      match entries {
        [] -> 0
        [BE(first_in, _), ..._] ->
          match load_core(core_cache_dir_for(opts, first_in), opts.core_cache.stats) {
            None -> 1
            Some(pls) -> match pls {
              PLS(pds, pmods, psegs, prows) ->
                batch_compile_loop(entries, pds, pmods, psegs, prows, opts, 0)
            }
          }
      }
    }
  }

# Compile each entry against the shared cores. Failures accumulate
# into `nfail`; a per-file failure is reported but does not abort the
# batch, so the harness sees every result in one pass.
fn batch_compile_loop(entries: [BatchEntry], pds: [Decl], pmods: [ModuleEntry],
                       psegs: [CoreSegment], prows: [NEnt], opts: CliOptions,
                       nfail: Int) : Int / Console + File = match entries {
  [] -> nfail
  [BE(inp, outp), ...rest] -> {
    let rc = match read_file(inp) {
      Err(msg) -> { eprint("kaic2: #{inp}: #{msg}"); 1 }
      Ok(src) -> compile_source(inp, opts.mode, opts.backend, opts.strict_holes,
                                 opts.search_paths, src, pds, pmods, psegs, prows,
                                 opts.package_name, opts.unstable_optins,
                                 opts.edition, opts.user_cache, Some(outp),
                                 opts.core_cache, [], [], cover_none(), "", "", "", "", false)
    }
    let nfail1 = if rc == 0 { nfail } else { nfail + 1 }
    batch_compile_loop(rest, pds, pmods, psegs, prows, opts, nfail1)
  }
}

pub fn run(opts: CliOptions) : Int / Console + File {
  match opts.mode {
    MHelp -> { usage(); 0 }
    MUsageError -> { usage(); 2 }
    MVersion -> { print("kaic2 stage 2 (self-hosted)"); 0 }
    MBackendTag -> { print(llvm_backend_tag()); 0 }
    MBuiltinsDocJson -> dump_builtins_doc_json()
    MCacheRoundtrip -> match opts.path {
      None -> {
        eprint("kaic2: --cache-roundtrip-test requires a source .kai file")
        2
      }
      Some(p) -> cache_roundtrip_file(p)
    }
    MCacheTypedSelftest -> {
      let r = cache_typed_selftest()
      print(r)
      match char_at(r, 0) {
        Some('O') -> 0
        _         -> 1
      }
    }
    MResolveSymSelftest -> {
      let r = resolve_sym_selftest()
      print(r)
      match char_at(r, 0) {
        Some('O') -> 0
        _         -> 1
      }
    }
    MBuiltinNames -> { write_stdout(builtin_names_report()); 0 }
    MKaiBuiltins -> match load_core_files(kai_builtin_module_paths(), [], [], [], [], []) {
      Some(PLS(ds, _, _, rows)) -> { write_stdout(string_join(map(kai_builtin_manifest(ds, st_of_entries(rows)), (l) => cat2(l, "\n")), "")); 0 }
      None                -> 1
    }
    MBuiltinTable -> {
      let r = builtin_table_report()
      match char_at(r, 0) {
        Some('F') -> { eprint(r); 1 }
        _         -> { write_stdout(r); 0 }
      }
    }
    MSymtabSelftest -> {
      let r = symtab_selftest()
      print(r)
      match char_at(r, 0) {
        Some('O') -> 0
        _         -> 1
      }
    }
    MEmitCoreCache -> match opts.path {
      None -> {
        eprint("kaic2: --emit-core-cache requires a source .kai file")
        2
      }
      Some(p) -> emit_core_cache_for(p, opts.cache_sha)
    }
    MGuardInputs -> guard_listing(opts, false)
    MGuardInterfaces -> guard_listing(opts, true)
    MGuardCoreInputs -> {
      print_lines(uc_core_input_files(core_module_paths(), opts.search_paths))
      0
    }
    MBatchList -> match opts.path {
      None -> {
        eprint("kaic2: --batch-list requires a list-file argument")
        2
      }
      Some(lf) -> run_batch_list(lf, opts)
    }
    _ -> match opts.path {
      None -> { usage(); 2 }
      Some(p) -> {
        # The core module set (core/* + protocols + effects + array) is
        # loaded automatically from the compile-time `stdlib_path()`.
        # No `--core` flag, no driver assistance: every program
        # receives core. To swap which stdlib feeds the compiler,
        # rebuild with a different KAI_STDLIB_PATH macro.
        # The core cache directory comes from `--core-cache-dir`
        # (shared, bin/kai-resolved) or the legacy per-project
        # `.kai-cache` under `--user-cache`.
        let core_loaded = load_core(core_cache_dir_for(opts, p), opts.core_cache.stats)
        match core_loaded {
          None -> 1
          Some(pls) -> match pls {
            PLS(pds, pmods, psegs, prows) -> match read_file(p) {
              Ok(src) -> close_front(opts.mode, p, compile_source(p, opts.mode, opts.backend, opts.strict_holes, opts.search_paths, src, pds, pmods, psegs, prows, opts.package_name, opts.unstable_optins, opts.edition, opts.user_cache, None, opts.core_cache, opts.test_roots, opts.test_own, opts.cover, opts.test_plan, opts.kir_verify, opts.inputs_out, opts.ffi_out, false))
              Err(msg) -> { eprint("kaic2: #{p}: #{msg}"); 1 }
            }
          }
        }
      }
    }
  }
}
