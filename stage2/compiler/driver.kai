fn compile_source(path: String, mode: Mode, backend: Backend, strict_holes: Bool, search_paths: [String], src: String, core_decls: [Decl], core_mods: [ModuleEntry], core_segs: [CoreSegment], core_rows: [NEnt], package_name: String, unstable_optins: [String], edition: Option[Edition], user_cache: Bool, batch_out: Option[String], core_cache: CoreCacheOpt, test_roots: [String], test_own: [String], cover: CoverSpec, test_plan: String, kir_verify: String, inputs_out: String, ffi_out: String, quiet: Bool) : Int / Console + File + Mutable =
  compile_req(Req { path: path, mode: mode, backend: backend, strict_holes: strict_holes, search_paths: search_paths, src: src, core_decls: core_decls, core_mods: core_mods, core_segs: core_segs, core_rows: core_rows, package_name: package_name, unstable_optins: unstable_optins, edition: edition, user_cache: user_cache, batch_out: batch_out, core_cache: core_cache, test_roots: test_roots, test_own: test_own, cover: cover, test_plan: test_plan, kir_verify: kir_verify, inputs_out: inputs_out, ffi_out: ffi_out, quiet: quiet })

fn compile_req(req: Req) : Int / Console + File + Mutable = match stage_open(req) {
  Halt(code) -> code
  Go(opened) -> compile_front(req, stage_access(req, stage_scope(req, stage_tables(req, stage_precut(req, stage_load(req, opened))))))
}

fn compile_front(req: Req, accessed: Accessed) : Int / Console + File + Mutable = match stage_alias(req, stage_kinds(req, accessed)) {
  Halt(code) -> code
  Go(aliased) -> compile_lower(req, aliased)
}

fn compile_lower(req: Req, aliased: Aliased) : Int / Console + File + Mutable = match stage_region(req, aliased) {
  Halt(code) -> code
  Go(regioned) -> match stage_lower(req, regioned) {
    Halt(code) -> code
    Go(lowered) -> compile_ready(req, stage_ready(req, lowered))
  }
}

fn compile_ready(req: Req, ready: Ready) : Int / Console + File + Mutable =
  if is_dump_mode(req.mode) { run_dump_mode(req, ready) } else { compile_default(req, ready) }

fn compile_default(req: Req, ready: Ready) : Int / Console + File + Mutable = match stage_solve(req, stage_seed(req, stage_cvar(req, stage_stamp(req, ready)), compile_req), compile_req) {
  Halt(code) -> code
  Go(solved) -> match stage_infer(req, solved) {
    Halt(code) -> code
    Go(inferred) -> compile_checked(req, inferred)
  }
}

fn compile_checked(req: Req, inferred: InferRun) : Int / Console + File + Mutable = match stage_check(req, inferred) {
  Halt(code) -> code
  Go(checked) -> compile_mono(req, checked)
}

fn compile_mono(req: Req, checked: Checked) : Int / Console + File + Mutable = match stage_mono(req, checked) {
  Halt(code) -> code
  Go(monoed) -> stage_emit(req, stage_perceus(req, stage_unbox(req, monoed)))
}


# Internal batch driver. Loads (lexes + parses) the core module set
# ONCE and compiles every listed input against that shared
# `CoresLoaded`, so the core's lex + parse is paid a single time for
# the whole batch instead of once per file. The per-file typecheck and
# codegen still run fresh — only the core load is amortised — so each
# output is byte-identical to a standalone build. Each input's `.c` is
# written to its paired output (native writes its `.o` to
# `native_object_path(input)`). Returns the count of inputs that failed
# to compile; 0 means the whole batch is clean.
fn run_batch_list(listfile: String, opts: CliOptions) : Int / Console + File =
  match read_file(listfile) {
    Err(msg) -> { eprint("kaic2: #{listfile}: #{msg}"); 1 }
    Ok(content) -> {
      let entries = parse_batch_entries(content)
      match entries {
        [] -> 0
        [BE(first_in, _), ..._] ->
          match load_core(core_cache_dir_for(opts, first_in), opts.core_cache.stats) {
            None -> 1
            Some(pls) -> match pls {
              PLS(pds, pmods, psegs, prows) ->
                batch_compile_loop(entries, pds, pmods, psegs, prows, opts, 0)
            }
          }
      }
    }
  }

# Compile each entry against the shared cores. Failures accumulate
# into `nfail`; a per-file failure is reported but does not abort the
# batch, so the harness sees every result in one pass.
fn batch_compile_loop(entries: [BatchEntry], pds: [Decl], pmods: [ModuleEntry],
                       psegs: [CoreSegment], prows: [NEnt], opts: CliOptions,
                       nfail: Int) : Int / Console + File = match entries {
  [] -> nfail
  [BE(inp, outp), ...rest] -> {
    let rc = match read_file(inp) {
      Err(msg) -> { eprint("kaic2: #{inp}: #{msg}"); 1 }
      Ok(src) -> compile_source(inp, opts.mode, opts.backend, opts.strict_holes,
                                 opts.search_paths, src, pds, pmods, psegs, prows,
                                 opts.package_name, opts.unstable_optins,
                                 opts.edition, opts.user_cache, Some(outp),
                                 opts.core_cache, [], [], cover_none(), "", "", "", "", false)
    }
    let nfail1 = if rc == 0 { nfail } else { nfail + 1 }
    batch_compile_loop(rest, pds, pmods, psegs, prows, opts, nfail1)
  }
}

pub fn run(opts: CliOptions) : Int / Console + File {
  match opts.mode {
    MHelp -> { usage(); 0 }
    MUsageError -> { usage(); 2 }
    MVersion -> { print("kaic2 stage 2 (self-hosted)"); 0 }
    MBackendTag -> { print(llvm_backend_tag()); 0 }
    MBuiltinsDocJson -> dump_builtins_doc_json()
    MCacheRoundtrip -> with_source_path(opts, "--cache-roundtrip-test", "a source .kai file", (p) => cache_roundtrip_file(p))
    MCacheTypedSelftest -> selftest_exit(cache_typed_selftest())
    MResolveSymSelftest -> selftest_exit(resolve_sym_selftest())
    MBuiltinNames -> { write_stdout(builtin_names_report()); 0 }
    MKaiBuiltins -> run_kai_builtins()
    MBuiltinTable -> run_builtin_table()
    MSymtabSelftest -> selftest_exit(symtab_selftest())
    MEmitCoreCache -> with_source_path(opts, "--emit-core-cache", "a source .kai file", (p) => emit_core_cache_for(p, opts.cache_sha))
    MGuardInputs -> guard_listing(opts, false)
    MGuardInterfaces -> guard_listing(opts, true)
    MGuardCoreInputs -> {
      print_lines(uc_core_input_files(core_module_paths(), opts.search_paths))
      0
    }
    MBatchList -> with_source_path(opts, "--batch-list", "a list-file argument", (lf) => run_batch_list(lf, opts))
    _ -> match opts.path {
      None -> { usage(); 2 }
      Some(p) -> compile_path(opts, p)
    }
  }
}

fn with_source_path(opts: CliOptions, flag: String, what: String, k: (String) -> Int / Stdout + Stderr + Stdin + File) : Int / Console + File =
  match opts.path {
    None -> {
      eprint("kaic2: #{flag} requires #{what}")
      2
    }
    Some(p) -> k(p)
  }

fn selftest_exit(r: String) : Int / Console {
  print(r)
  match char_at(r, 0) {
    Some('O') -> 0
    _         -> 1
  }
}

fn run_kai_builtins() : Int / Console + File =
  match load_core_files(kai_builtin_module_paths(), [], [], [], [], []) {
    Some(PLS(ds, _, _, rows)) -> { write_stdout(string_join(map(kai_builtin_manifest(ds, st_of_entries(rows)), (l) => cat2(l, "\n")), "")); 0 }
    None                -> 1
  }

fn run_builtin_table() : Int / Console {
  let r = builtin_table_report()
  match char_at(r, 0) {
    Some('F') -> { eprint(r); 1 }
    _         -> { write_stdout(r); 0 }
  }
}

# The core module set (core/* + protocols + effects + array) is loaded
# automatically from the compile-time `stdlib_path()`: every program
# receives core, and rebuilding with another KAI_STDLIB_PATH swaps which
# stdlib feeds the compiler. The core cache directory comes from
# `--core-cache-dir` (shared, bin/kai-resolved) or the legacy per-project
# `.kai-cache` under `--user-cache`.
fn compile_path(opts: CliOptions, p: String) : Int / Console + File =
  match load_core(core_cache_dir_for(opts, p), opts.core_cache.stats) {
    None -> 1
    Some(PLS(pds, pmods, psegs, prows)) -> match read_file(p) {
      Ok(src) -> close_front(opts.mode, p, compile_source(p, opts.mode, opts.backend, opts.strict_holes, opts.search_paths, src, pds, pmods, psegs, prows, opts.package_name, opts.unstable_optins, opts.edition, opts.user_cache, None, opts.core_cache, opts.test_roots, opts.test_own, opts.cover, opts.test_plan, opts.kir_verify, opts.inputs_out, opts.ffi_out, false))
      Err(msg) -> { eprint("kaic2: #{p}: #{msg}"); 1 }
    }
  }
