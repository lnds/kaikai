#[doc("Mutation testing: splicing a mutant into its source and reporting what survived.")]

# compiler/mutate_splice.kai — turning a mutation site into source.
#
# The AST says WHAT to break and WHERE; this module rewrites exactly
# that span in the ORIGINAL source and leaves every other byte alone.
#
# The alternative — re-printing the mutated AST through the formatter —
# was measured and rejected: `stage2/compiler/perceus.kai` is 5918
# lines and formats to 7626, so a reprinted mutant would carry ~1700
# lines of cosmetic reflow around the one line that matters. A diff
# nobody can read is a diff nobody acts on, and an operator's effect
# must be the only difference between a mutant and its parent.
#
# Spans come from the token stream, which carries absolute byte offsets
# (`start` + `length`). A site's line/col locates its anchor token; the
# operator decides how far the span reaches from there.

import compiler.lex
import compiler.mutate
import compiler.util

# --- token lookup -----------------------------------------------------

# The first token at or after (line, col). Sites are anchored on a real
# token, so the equal case is the hit; the "after" case only carries a
# zero-width insertion whose anchor is the following token.
fn tok_at(toks: [Token], line: Int, col: Int) : Option[Token] {
  match toks {
    [] -> None
    [t, ...rest] ->
      if t.line == line and t.col == col { Some(t) }
      else { tok_at(rest, line, col) }
  }
}

fn toks_from(toks: [Token], line: Int, col: Int) : [Token] {
  match toks {
    [] -> []
    [t, ...rest] ->
      if t.line == line and t.col == col { toks } else { toks_from(rest, line, col) }
  }
}

fn tok_end(t: Token) : Int = t.start + t.length

# --- span model -------------------------------------------------------

type MutPoint = MPoint(Int, Int, Int)

fn mpoint_line(p: MutPoint) : Int = match p { MPoint(l, _, _) -> l }

fn mpoint_col(p: MutPoint) : Int = match p { MPoint(_, c, _) -> c }

fn mpoint_byte(p: MutPoint) : Int = match p { MPoint(_, _, b) -> b }

type MutEdit = MEdit(MutPoint, MutPoint, String)

fn medit_start(e: MutEdit) : MutPoint = match e { MEdit(a, _, _) -> a }

fn medit_end(e: MutEdit) : MutPoint = match e { MEdit(_, b, _) -> b }

fn medit_text(e: MutEdit) : String = match e { MEdit(_, _, t) -> t }

type MutRange = MRange(MutPoint, MutPoint)

fn point_before(t: Token) : MutPoint = MPoint(t.line, t.col, t.start)

# The position just past a token. Only a multi-line string literal
# spans a newline, so the column is recounted from the last one inside.
fn point_after(t: Token, src: String) : MutPoint =
  match last_newline(src, t.start, tok_end(t) - 1) {
    None -> MPoint(t.line, t.col + t.length, tok_end(t))
    Some(nl) -> MPoint(t.line + count_newlines(src, t.start, nl), tok_end(t) - nl, tok_end(t))
  }

fn last_newline(src: String, lo: Int, i: Int) : Option[Int] =
  if i < lo { None }
  else if char_at(src, i) == Some('\n') { Some(i) }
  else { last_newline(src, lo, i - 1) }

fn count_newlines(src: String, i: Int, hi: Int) : Int =
  if i > hi { 0 }
  else if char_at(src, i) == Some('\n') { 1 + count_newlines(src, i + 1, hi) }
  else { count_newlines(src, i + 1, hi) }

# --- per-operator span resolution -------------------------------------

fn mut_range_of(site: MutSite, toks: [Token], src: String) : Option[MutRange] {
  let rest = toks_from(toks, ms_line(site), ms_col(site))
  match rest {
    [] -> None
    [t, ..._] -> match ms_op(site) {
      MOpArm -> mut_arm_range(site, toks, t)
      MOpCall -> mut_call_range(site, toks, src, t)
      MOpNegate -> mut_cond_range(site, toks, src, t)
      MOpReturn -> mut_result_range(site, toks, src, t)
      # Comparison, connective and literal all rewrite one token, and
      # the anchor IS that token: a binop node's line/col point at the
      # operator, a literal's at the literal.
      _ -> Some(MRange(point_before(t), point_after(t, src)))
    }
  }
}

# An arm runs from its own pattern's first token up to where the NEXT
# arm's pattern begins, a boundary the site carries because a token scan
# cannot find it: nothing in the token stream distinguishes an arm
# boundary from a nested `match`, and two arms written on one line have
# no newline between them at all.
#
# Ending the span at the next arm's first token consumes the whitespace
# and newline between them, so the deletion leaves neither a blank line
# nor a stray indent.
fn mut_arm_range(site: MutSite, toks: [Token], first: Token) : Option[MutRange] =
  match mut_parse_pos(ms_end(site)) {
    None -> None
    Some(MPos2(l, c)) -> match tok_at(toks, l, c) {
      None -> None
      Some(nxt) -> Some(MRange(point_before(first), point_before(nxt)))
    }
  }

# `if c { … }` -> `if not (c) { … }`: one span covering the whole
# condition. The parentheses are not cosmetic — `not` binds tighter
# than every binary operator, so `not v == 0` reparses as
# `(not v) == 0` and the mutant fails to typecheck for a reason that
# has nothing to do with the mutation.
#
# The condition's extent comes from the `if` body's `{`, which the site
# carries: the AST is the only authority on where a condition stops,
# since the same token run could belong to a nested `if`. Ending on the
# LAST token before that brace keeps the trailing whitespace outside
# the span, so the closing paren lands against the condition.
fn mut_cond_range(site: MutSite, toks: [Token], src: String, first: Token) : Option[MutRange] =
  match mut_parse_pos(ms_end(site)) {
    None -> None
    Some(MPos2(l, c)) -> match mut_last_before(toks_from(toks, first.line, first.col), l, c, None) {
      None -> None
      Some(last) -> Some(MRange(point_before(first), point_after(last, src)))
    }
  }

# A function's result runs from its first token to the last one before
# whatever ends it: a closer of the enclosing group, the end of the file,
# or a line that starts no deeper than the declaration, which is the next
# item. The declaration is named by the site; its indent is that of the
# first token on its line.
fn mut_result_range(site: MutSite, toks: [Token], src: String, first: Token) : Option[MutRange] =
  match mut_parse_pos(ms_end(site)) {
    None -> None
    Some(MPos2(l, _)) -> mut_line_start(toks, l)
      || (head => mut_result_end(toks_from(toks, first.line, first.col), head.col, 0, None))
      | (last => MRange(point_before(first), point_after(last, src)))
  }

fn mut_line_start(toks: [Token], line: Int) : Option[Token] {
  match toks {
    [] -> None
    [t, ...more] -> if t.line == line { Some(t) } else { mut_line_start(more, line) }
  }
}

fn mut_result_end(toks: [Token], indent: Int, depth: Int, last: Option[Token]) : Option[Token] {
  match toks {
    [] -> last
    [t, ...more] -> {
      let d = depth + tok_depth_delta(t)
      if d < 0 { last }
      else if depth == 0 and t.kind == TkSemi { last }
      else if depth == 0 and t.kind == TkNewline and mut_next_at_or_before(more, indent) { last }
      else if t.kind == TkNewline { mut_result_end(more, indent, d, last) }
      else { mut_result_end(more, indent, d, Some(t)) }
    }
  }
}

# True when the first token after the blank run starts at or before
# `indent`, or when no token follows.
fn mut_next_at_or_before(toks: [Token], indent: Int) : Bool {
  match toks {
    [] -> true
    [t, ...more] ->
      if t.kind == TkNewline { mut_next_at_or_before(more, indent) }
      else if t.kind == TkEof { true }
      else { t.col <= indent }
  }
}

# The last token before (line, col), or None when the run reaches that
# position with nothing behind it.
fn mut_last_before(toks: [Token], line: Int, col: Int, last: Option[Token]) : Option[Token] {
  match toks {
    [] -> last
    [t, ...more] ->
      if t.line == line and t.col == col { last }
      else { mut_last_before(more, line, col, Some(t)) }
  }
}

# The AST keeps no span for parentheses, so a span that starts inside
# a group (`(a |> f).m()`, `(a == b) and c`) holds more `)` than `(`.
# The first token moves back over exactly that many `(` that precede it.
fn mut_widen(toks: [Token], first: Token, last: Token) : Token =
  mut_back_over(mut_prefix_rev(toks, first, []), 0 - mut_min_depth(toks_from(toks, first.line, first.col), last, 0, 0), first)

fn mut_prefix_rev(toks: [Token], first: Token, acc: [Token]) : [Token] {
  match toks {
    [] -> acc
    [t, ...more] ->
      if t.line == first.line and t.col == first.col { acc }
      else { mut_prefix_rev(more, first, [t, ...acc]) }
  }
}

fn mut_min_depth(toks: [Token], last: Token, depth: Int, low: Int) : Int {
  match toks {
    [] -> low
    [t, ...more] -> {
      let d = depth + tok_depth_delta(t)
      let lo = if d < low { d } else { low }
      if t.line == last.line and t.col == last.col { lo } else { mut_min_depth(more, last, d, lo) }
    }
  }
}

fn mut_back_over(rev: [Token], n: Int, cur: Token) : Token {
  if n <= 0 { cur }
  else {
    match rev {
      [t, ...more] -> if t.kind == TkLparen { mut_back_over(more, n - 1, t) } else { cur }
      [] -> cur
    }
  }
}

# A `line:col` cue as the walk encodes it. None for a malformed or
# empty key, which fails the site rather than mutating a guessed span.
type MutPos2 = MPos2(Int, Int)

fn mut_parse_pos(key: String) : Option[MutPos2] = {
  let i = string_index_of_char(key, ':')
  if i < 0 { None }
  else {
    let l = string_to_int(string_slice(key, 0, i))
    let c = string_to_int(string_slice(key, i + 1, string_length(key) - i - 1))
    match l {
      None -> None
      Some(lv) -> match c {
        None -> None
        Some(cv) -> Some(MPos2(lv, cv))
      }
    }
  }
}

# `f(x)` -> `x` and `r.m()` -> `r`: one span covering the whole call,
# from the callee's first token through the `)` that closes the call's
# own argument list, whose `(` the site names. Scanning from the
# callee's first token instead would stop at the first parenthesis pair
# of a nested call.
fn mut_call_range(site: MutSite, toks: [Token], src: String, first: Token) : Option[MutRange] =
  match mut_call_open(site, toks) {
    None -> None
    Some(open) -> match mut_call_close(toks_from(toks, open.line, open.col), 0, false) {
      None -> None
      Some(close) -> Some(MRange(point_before(mut_widen(toks, first, close)), point_after(close, src)))
    }
  }

fn mut_call_open(site: MutSite, toks: [Token]) : Option[Token] =
  match mut_parse_pos(ms_end(site)) {
    None -> None
    Some(MPos2(l, c)) -> tok_at(toks, l, c)
  }

fn tok_depth_delta(t: Token) : Int = match t.kind {
  TkLparen -> 1  TkLbracket -> 1  TkLbrace -> 1
  TkRparen -> 0 - 1  TkRbracket -> 0 - 1  TkRbrace -> 0 - 1
  _ -> 0
}

# The `)` closing this call, or None when the token run does not close.
# `opened` guards the callee tokens that precede the argument list so
# the scan does not stop before it begins.
fn mut_call_close(toks: [Token], depth: Int, opened: Bool) : Option[Token] {
  match toks {
    [] -> None
    [t, ...more] -> {
      let d = depth + tok_depth_delta(t)
      if opened and d == 0 { Some(t) }
      else if d < 0 { None }
      else { mut_call_close(more, d, opened or d > 0) }
    }
  }
}

# --- applying a mutation ----------------------------------------------

fn mut_edit_of(site: MutSite, toks: [Token], src: String) : Option[MutEdit] =
  match mut_range_of(site, toks, src) {
    None -> None
    Some(MRange(a, b)) ->
      Some(MEdit(a, b, mut_replacement(site, toks, src, mpoint_byte(a), mpoint_byte(b))))
  }

#[doc("The mutated source for one site: the original with the site's span replaced. None when the site cannot be resolved against the token stream.")]
pub(pkg) fn mut_apply(site: MutSite, toks: [Token], src: String) : Option[String] =
  match mut_edit_of(site, toks, src) {
    None -> None
    Some(ed) -> Some(mut_splice(src, ed))
  }

fn mut_splice(src: String, ed: MutEdit) : String = {
  let b = mpoint_byte(medit_end(ed))
  concat_all([string_slice(src, 0, mpoint_byte(medit_start(ed))), medit_text(ed),
              string_slice(src, b, string_length(src) - b)])
}

fn mut_span_text(src: String, a: Int, b: Int) : String =
  if b > a { string_slice(src, a, b - a) } else { "" }

# Call elision writes its argument (or, for a method call, its
# receiver) back and negation writes its condition back, both
# reconstructed from the original source so the mutant keeps the
# author's spelling. Every other operator's replacement is fixed by the
# site itself.
fn mut_replacement(site: MutSite, toks: [Token], src: String, a: Int, b: Int) : String =
  match ms_op(site) {
    MOpCall -> mut_call_value_text(site, toks, src, a, b)
    MOpNegate -> concat_all(["not (", mut_span_text(src, a, b), ")"])
    _ -> ms_to(site)
  }

fn mut_call_value_text(site: MutSite, toks: [Token], src: String, a: Int, b: Int) : String =
  match mut_parse_pos(ms_to(site)) {
    Some(MPos2(l, c)) -> match tok_at(toks, l, c) {
      Some(dot) -> mut_span_text(src, a, dot.start)
      None -> ""
    }
    None -> match mut_call_open(site, toks) {
      Some(open) -> mut_span_text(src, tok_end(open), b - 1)
      None -> ""
    }
  }

fn mut_site_line(idx: Int, file: String, site: MutSite) : String =
  join_with([int_to_string(idx), mut_op_name(ms_op(site)),
             int_to_string(ms_line(site)), int_to_string(ms_col(site)),
             mut_op_blurb(ms_op(site))], "\t")

#[doc("Render the whole site catalogue, one tab-separated record per line.")]
pub(pkg) fn mut_sites_text(file: String, sites: [MutSite]) : String =
  join_with(mut_numbered(sites, 0, []), "\n")

fn mut_numbered(sites: [MutSite], i: Int, acc: [String]) : [String] {
  match sites {
    [] -> list_reverse(acc)
    [s, ...rest] -> mut_numbered(rest, i + 1, list_append([mut_site_line(i, "", s)], acc))
  }
}

# --- JSON catalogue ---------------------------------------------------
#
# Beyond the anchor, each site carries what an external driver needs to
# diff, cache and suppress it without re-reading the source: the exact
# span, its text before and after, and a semantic key — enclosing
# declaration, operator, original text, ordinal — that survives edits
# elsewhere in the file.

# A site with its resolved edit. An unresolvable site has no edit and
# an empty original.
type MutRow = MRow(Int, MutSite, Option[MutEdit], String)

#[doc("Render the site catalogue as a JSON array, matching the `--lint-json` discipline. `module` qualifies each site's enclosing declaration.")]
pub(pkg) fn mut_sites_json(file: String, module: String, sites: [MutSite], toks: [Token], src: String) : String = {
  let rows = mut_rows(sites, toks, src, 0, [])
  let items = map(rows, (r) => mut_row_json(file, module, r, mut_ordinal(r, rows)))
  concat_all(["[", join_with(items, ",\n "), "]"])
}

fn mut_rows(sites: [MutSite], toks: [Token], src: String, i: Int, acc: [MutRow]) : [MutRow] {
  match sites {
    [] -> list_reverse(acc)
    [s, ...rest] -> mut_rows(rest, toks, src, i + 1, list_append([mut_row(i, s, toks, src)], acc))
  }
}

fn mut_row(i: Int, s: MutSite, toks: [Token], src: String) : MutRow =
  match mut_edit_of(s, toks, src) {
    None -> MRow(i, s, None, "")
    Some(ed) -> MRow(i, s, Some(ed),
                     mut_span_text(src, mpoint_byte(medit_start(ed)), mpoint_byte(medit_end(ed))))
  }

fn mrow_start(r: MutRow) : Int = match r {
  MRow(_, _, Some(ed), _) -> mpoint_byte(medit_start(ed))
  MRow(_, _, None, _) -> 0 - 1
}

# 1-based rank of a row among the rows sharing its enclosing
# declaration, operator and original text, in source order. Ties on the
# start byte (a call and the literal it wraps can both begin there) fall
# back to catalogue order.
fn mut_ordinal(r: MutRow, rows: [MutRow]) : Int =
  1 + list_length(filter(rows, (o) => mut_same_key(o, r) and mut_precedes(o, r)))

fn mut_same_key(a: MutRow, b: MutRow) : Bool = match a {
  MRow(_, sa, _, oa) -> match b {
    MRow(_, sb, _, ob) ->
      ms_scope(sa) == ms_scope(sb) and mut_op_name(ms_op(sa)) == mut_op_name(ms_op(sb)) and oa == ob
  }
}

fn mut_precedes(a: MutRow, b: MutRow) : Bool = match a {
  MRow(ia, _, _, _) -> match b {
    MRow(ib, _, _, _) ->
      mrow_start(a) < mrow_start(b) or (mrow_start(a) == mrow_start(b) and ia < ib)
  }
}

fn mut_row_json(file: String, module: String, r: MutRow, ordinal: Int) : String = match r {
  MRow(i, s, ed, orig) -> concat_all([
    "{\"id\": ", int_to_string(i),
    ", \"file\": ", json_quote(file),
    ", \"line\": ", int_to_string(ms_line(s)),
    ", \"col\": ", int_to_string(ms_col(s)),
    ", \"operator\": ", json_quote(mut_op_name(ms_op(s))),
    mut_edit_json(ed, orig),
    ", \"enclosing\": ", json_quote(concat_all([module, ".", ms_scope(s)])),
    ", \"ordinal\": ", int_to_string(ordinal),
    ", \"description\": ", json_quote(mut_op_blurb(ms_op(s))),
    "}"
  ])
}

# An unresolvable site keeps the new keys, as `null`, so every record
# has the same shape.
fn mut_edit_json(ed: Option[MutEdit], orig: String) : String = match ed {
  None -> ", \"start\": null, \"end\": null, \"original\": null, \"replacement\": null"
  Some(e) -> concat_all([
    ", \"start\": ", mut_point_json(medit_start(e)),
    ", \"end\": ", mut_point_json(medit_end(e)),
    ", \"original\": ", json_quote(orig),
    ", \"replacement\": ", json_quote(medit_text(e))
  ])
}

fn mut_point_json(p: MutPoint) : String =
  concat_all(["{\"line\": ", int_to_string(mpoint_line(p)),
              ", \"col\": ", int_to_string(mpoint_col(p)),
              ", \"byte\": ", int_to_string(mpoint_byte(p)), "}"])
