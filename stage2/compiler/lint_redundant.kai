#[doc("Lints for redundant code and for combinators that replace a hand-written match.")]

import compiler.ast
import compiler.ast_ids
import compiler.ast_ids
import compiler.expr_positions
import compiler.lint_idiom
import compiler.util
import compiler.symtab

# `LintFinding` is defined in `compiler.lint_idiom` and shared by every
# lint module; this file constructs the same `LF(rule, line, col, msg)`.

#[doc("The redundant_if_bool finding rooted at this node; children are visited by the caller's walk.")]
pub(pkg) fn redundant_findings(e: Expr) : [LintFinding] {
  match e.kind {
    EIf(_, t, Some(el)) -> if_bool_nudge(e, t, el)
    _                   -> []
  }
}

# Lowering expands a clause block or a multi-scrutinee match into one
# `EMatch` per column, and a column that only binds is a catch-all nobody
# wrote. Before lowering an `EMatch` is a `match` the source spells.
#[doc("The redundant_match_catchall findings in `e` and under it, in source order; `e` is an expression before surface lowering.")]
pub(pkg) fn catchall_findings(e: Expr) : [LintFinding] {
  let below = flat_map(xp_positions(e), (p) => match p { XP(_, x) -> catchall_findings(x) })
  match e.kind {
    EMatch(_, arms) -> list_append(catchall_nudge(e, arms), below)
    _               -> below
  }
}

# ---- redundant_if_bool -----------------------------------------------

# `if c { true } else { false }` is `c`; the inverse `if c { false }
# else { true }` is `not c`. Both branches must be the bare boolean
# literals (a block whose only value is `true`/`false`), so the rewrite
# drops the conditional with no change in meaning. An `if` without an
# else, or a branch that does anything beyond yielding the literal, is
# left alone.
fn if_bool_nudge(e: Expr, t: Expr, el: Expr) : [LintFinding] {
  if is_true_lit(t) and is_false_lit(el) { if_bool_finding(e, true) }
  else if is_false_lit(t) and is_true_lit(el) { if_bool_finding(e, false) }
  else { [] }
}

fn is_true_lit(e: Expr) : Bool {
  match branch_bool(e) {
    Some(b) -> b
    None    -> false
  }
}

fn is_false_lit(e: Expr) : Bool {
  match branch_bool(e) {
    Some(b) -> not b
    None    -> false
  }
}

# The two branches differ (one true, one false), so the form is
# redundant. `then=true` collapses to the condition; `then=false`
# collapses to its negation.
fn if_bool_finding(e: Expr, then_true: Bool) : [LintFinding] {
  let hint = if then_true { "the condition itself" } else { "`not` of the condition" }
  [LF("redundant_if_bool", e.line, e.col,
      concat_all(["if/else yields only boolean literals; use ", hint]))]
}

# The boolean value of a branch that is exactly a `true`/`false` literal,
# directly or as the sole tail of an otherwise-empty block. Any other
# shape returns None and stops the nudge.
fn branch_bool(e: Expr) : Option[Bool] {
  match e.kind {
    EBool(b)         -> Some(b)
    EBlock(ss, tail) -> block_bool(ss, tail)
    _                -> None
  }
}

fn block_bool(ss: [Stmt], tail: Option[Expr]) : Option[Bool] {
  match ss {
    [] -> match tail {
      Some(t) -> branch_bool(t)
      None    -> None
    }
    _  -> None
  }
}

# ---- redundant_match_catchall ----------------------------------------

# A `match` with a single unguarded arm whose pattern is `_` or a bare
# binding never destructures: `match e { _ -> body }` is `body`, and
# `match e { x -> body }` is `let x = e ... body`. Either way the
# `match` is ceremony around a direct expression. A literal/constructor
# pattern, a guard, or more than one arm all mean the match does real
# work and is left alone.
fn catchall_nudge(e: Expr, arms: [Arm]) : [LintFinding] {
  match arms {
    [Arm(p, None, _)] -> catchall_arm(e, p)
    _                 -> []
  }
}

fn catchall_arm(e: Expr, p: Pattern) : [LintFinding] {
  match p.pkind {
    PWild     -> [catchall_finding(e, "use the expression directly")]
    PBind(_)  -> [catchall_finding(e, "bind the scrutinee with `let`")]
    _         -> []
  }
}

fn catchall_finding(e: Expr, hint: String) : LintFinding =
  LF("redundant_match_catchall", e.line, e.col,
     concat_all(["match has a single catch-all arm; ", hint]))

# `LintFinding` is defined in `compiler.lint_idiom` and shared by every
# lint module; this file constructs the same `LF(rule, line, col, msg)`.

#[doc("match_option_to_combinator finding rooted at this node; the caller's walk visits children.")]
pub(pkg) fn combinator_findings(e: Expr) : [LintFinding] {
  match e.kind {
    EMatch(scr, arms) -> mo_nudge(e, scr, arms)
    _                 -> []
  }
}

#[doc("Whether `f` stands in `owner`'s body: a match whose arm ends in a self tail call keeps its shape (a combinator would lose the tail call), and the core library defines the combinators.")]
pub(pkg) fn combinator_finding_stands(tab: SymTab, owner: FnId, body: Expr, f: LintFinding) : Bool = match f {
  LF(rule, line, col, _) ->
    rule != "match_option_to_combinator"
      or not (sym_in_core(tab, fnid_sym(owner))
              or xp_exists(body, false, (x) => is_looping_match(fnid_sym(owner), line, col, x)))
}

fn is_looping_match(owner: SymId, line: Int, col: Int, x: Expr) : Bool = match x.kind {
  EMatch(_, arms) -> x.line == line and x.col == col and arms_tail_call(owner, arms)
  _               -> false
}

fn arms_tail_call(owner: SymId, arms: [Arm]) : Bool = match arms {
  []                  -> false
  [Arm(_, _, b), ...rest] -> tail_calls(owner, b) or arms_tail_call(owner, rest)
}

fn tail_calls(owner: SymId, e: Expr) : Bool = match e.kind {
  ECall(f, _) -> match f.kind {
    ESym(s, _) -> sym_same(s, owner)
    _          -> false
  }
  EIf(_, t, eo) -> tail_calls(owner, t) or (match eo {
    Some(x) -> tail_calls(owner, x)
    None    -> false
  })
  EMatch(_, arms) -> arms_tail_call(owner, arms)
  EBlock(_, Some(t)) -> tail_calls(owner, t)
  _ -> false
}

# A `match` over an `Option[T]` with exactly two unguarded arms — one
# `Some(bind)`, one `None` — that a single combinator expresses exactly.
# The scrutinee must be statically known to be an Option; an unknown or
# non-Option type stops the nudge.
fn mo_nudge(e: Expr, scr: Expr, arms: [Arm]) : [LintFinding] {
  if scr_is_option(scr) { two_arm_nudge(e, arms) } else { [] }
}

fn scr_is_option(scr: Expr) : Bool = ty_is_option(scr.ty)

fn ty_is_option(t: Option[Ty]) : Bool {
  match t {
    Some(TyCon(s, _)) -> core_ty_is(s, CtOption)
    _                 -> false
  }
}

# The two arms in either source order. Each must be unguarded; `Some`
# binds a single name, `None` is nullary. Any other arm shape (a guard,
# a literal, an as-pattern) means the match does work a combinator does
# not, so it is left alone.
fn two_arm_nudge(e: Expr, arms: [Arm]) : [LintFinding] {
  match arms {
    []            -> []
    [a1, ...rest] -> match rest {
      []          -> []
      [a2, ...tl] -> match tl {
        [] -> both_arms_nudge(e, a1, a2)
        _  -> []
      }
    }
  }
}

fn both_arms_nudge(e: Expr, a1: Arm, a2: Arm) : [LintFinding] {
  if mo_arm_unguarded(a1) and mo_arm_unguarded(a2) {
    ordered_nudge(e, mo_arm_pat(a1), mo_arm_body(a1), mo_arm_pat(a2), mo_arm_body(a2))
  } else { [] }
}

fn mo_arm_unguarded(a: Arm) : Bool {
  match a {
    Arm(_, g, _) -> match g {
      Some(_) -> false
      None    -> true
    }
  }
}

fn mo_arm_pat(a: Arm) : Pattern {
  match a {
    Arm(p, _, _) -> p
  }
}

fn mo_arm_body(a: Arm) : Expr {
  match a {
    Arm(_, _, b) -> b
  }
}

fn ordered_nudge(e: Expr, p1: Pattern, b1: Expr, p2: Pattern, b2: Expr) : [LintFinding] {
  match some_bind(p1) {
    Some(x) -> if is_none_pat(p2) { classify(e, x, b1, b2) } else { [] }
    None    -> match some_bind(p2) {
      Some(x) -> if is_none_pat(p1) { classify(e, x, b2, b1) } else { [] }
      None    -> []
    }
  }
}

# `some_body` is the `Some(x)` arm body, `none_body` the `None` arm body.
# Three value-equivalent rewrites, checked most-specific first:
#   Some(x) -> x          + None -> dflt  => unwrap_or(dflt)   (dflt trivial)
#   Some(x) -> Some(expr) + None -> None  => map((x) => expr)
#   Some(x) -> opt        + None -> None  => and_then((x) => opt)
fn classify(e: Expr, x: LocalId, some_body: Expr, none_body: Expr) : [LintFinding] {
  let iv = is_var(some_body, x)
  let tr = is_trivial(none_body)
  let ne = is_none_expr(none_body)
  let ws = wraps_some(some_body)
  let bo = body_is_option(some_body)
  if iv and tr { [mo_finding(e, "unwrap_or")] }
  else if ne and ws { [mo_finding(e, "map")] }
  else if ne and bo { [mo_finding(e, "and_then")] }
  else { [] }
}

fn mo_finding(e: Expr, combinator: String) : LintFinding =
  LF("match_option_to_combinator", e.line, e.col,
     concat_all(["manual match over Option; use ", combinator]))

# ---- pattern shape ---------------------------------------------------

# The binder of a `Some(name)` pattern, or None for any other shape.
# Only a single bare binder qualifies — a nested destructure is work a
# combinator's lambda parameter cannot stand in for.
fn some_bind(p: Pattern) : Option[LocalId] {
  match p.pkind {
    PVariant(r, subs) -> if sym_same(ref_sym(r), lint_core_ctor("Some")) { sole_bind(subs) } else { None }
    _                 -> None
  }
}

# The single sub-pattern's binder, or None unless there is exactly
# one and it is a bare binder.
fn sole_bind(subs: [Pattern]) : Option[LocalId] {
  match subs {
    []             -> None
    [sub, ...rest] -> match rest {
      [] -> bind_name(sub)
      _  -> None
    }
  }
}

fn bind_name(p: Pattern) : Option[LocalId] {
  match p.pkind {
    PBind(b) -> Some(b.id)
    _        -> None
  }
}

fn is_none_pat(p: Pattern) : Bool {
  match p.pkind {
    PVariant(r, subs) -> sym_same(ref_sym(r), lint_core_ctor("None")) and pats_empty(subs)
    _                 -> false
  }
}

fn pats_empty(subs: [Pattern]) : Bool {
  match subs {
    []        -> true
    [_, ..._] -> false
  }
}

# ---- expression shape ------------------------------------------------

fn is_var(e: Expr, x: LocalId) : Bool {
  match e.kind {
    ELocal(l) -> local_eq(l, x)
    _         -> false
  }
}

# A `None` value: a reference to the runtime's `None` constructor.
fn is_none_expr(e: Expr) : Bool {
  match e.kind {
    ESym(s, _) -> sym_same(s, lint_core_ctor("None"))
    _          -> false
  }
}

# A `Some(...)` construction: the callee is the `Some` constructor. The
# arity is fixed by the constructor (always one), so checking the callee
# is enough; the argument is reached by the combinator's lambda.
fn wraps_some(e: Expr) : Bool {
  match e.kind {
    ECall(c, _) -> mo_is_some_ctor(c)
    _           -> false
  }
}

fn mo_is_some_ctor(c: Expr) : Bool {
  match c.kind {
    ESym(s, _) -> sym_same(s, lint_core_ctor("Some"))
    _          -> false
  }
}

fn body_is_option(e: Expr) : Bool = ty_is_option(e.ty)

# A `None` default whose value is cheap and effect-free, so eager
# `unwrap_or` evaluation matches the match's lazy None arm. A literal,
# a variable, or a nullary constructor qualifies; a call or any computed
# expression does not (it might be `unwrap_or_else` territory, where the
# default must stay lazy).
fn is_trivial(e: Expr) : Bool {
  match e.kind {
    EInt(_, _)     -> true
    EReal(_, _)    -> true
    EIntLit(_)     -> true
    EDecimalLit(_) -> true
    EFixed(_, _)   -> true
    EBool(_)       -> true
    EChar(_)       -> true
    EStr(_, _)     -> true
    EUnit          -> true
    ELocal(_)      -> true
    ESym(_, _)     -> true
    EList(els)     -> mo_list_empty(els)
    _              -> false
  }
}

fn mo_list_empty(els: [ListElem]) : Bool {
  match els {
    []        -> true
    [_, ..._] -> false
  }
}

# `LintFinding` is defined in `compiler.lint_idiom` and shared by every
# lint module; this file constructs the same `LF(rule, line, col, msg)`.

#[doc("list_concat_literal_to_spread finding rooted at this node; the caller's walk visits children.")]
pub(pkg) fn spread_findings(e: Expr) : [LintFinding] {
  match e.kind {
    EBinop(BoConcat, lhs, _) -> concat_nudge(e, lhs)
    _                  -> []
  }
}

# Only a NON-EMPTY literal fires. `[] ++ xs` is just `xs` — the runtime
# shares the right operand, so there is no allocation to save; the fix
# is dropping the concat, not a spread. A literal on the right
# (`xs ++ [y]`) has no spelling that avoids copying `xs`, so it is not
# this lint's smell either.
fn concat_nudge(e: Expr, lhs: Expr) : [LintFinding] {
  match lhs.kind {
    EList(els) -> match els {
      [] -> []
      _  -> [LF("list_concat_literal_to_spread", e.line, e.col,
                "`[h] ++ t` builds an intermediate list; write `[h, ...t]`")]
    }
    _ -> []
  }
}
