#[doc("""
Write the typer's resolution back into the written types.

The typer decides which declaration every written type name denotes, and
type parameters are visible only there. Passes after it read written types
again (signature rows, handler instances, specialised signatures), so each
written name takes the identity of the type it resolved to. The walk pairs
a written type with its resolved one and stops where their shapes part
(an alias, a type parameter): an identity is copied, never guessed.
""")]

import compiler.ast
import compiler.util

#[doc("`te` with each written name carrying the declaration its resolved type `t` names.")]
pub fn stamp_te(te: TypeExpr, t: Ty, resolve: (TypeExpr) -> Ty) : TypeExpr = {
  let k = match te.tkind {
    TyName(r, n, args) -> match t {
      TyCon(_, _, targs, s) -> TyName(stamp_ref(r, s), n, stamp_tes(args, targs, resolve))
      _                     -> te.tkind
    }
    TyList(inner) -> match t {
      TyListT(x) -> TyList(stamp_te(inner, x, resolve))
      _          -> te.tkind
    }
    TyFn(ps, ret, row) -> match t {
      TyFnT(tps, tret, _) -> TyFn(stamp_tes(ps, tps, resolve), stamp_te(ret, tret, resolve), stamp_row_with(row, resolve))
      _                      -> te.tkind
    }
    TyDim(b, u) -> match t {
      TyDimT(tb, _) -> TyDim(stamp_te(b, tb, resolve), u)
      _             -> te.tkind
    }
    _ -> te.tkind
  }
  TypeExpr { tkind: k, line: te.line, col: te.col }
}

#[doc("Pairwise `stamp_te`; a length mismatch leaves the written types as they are.")]
pub fn stamp_tes(tes: [TypeExpr], ts: [Ty], resolve: (TypeExpr) -> Ty) : [TypeExpr] =
  if list_length(tes) != list_length(ts) { tes } else { stamp_zip(tes, ts, resolve) }

fn stamp_zip(tes: [TypeExpr], ts: [Ty], resolve: (TypeExpr) -> Ty) : [TypeExpr] = match tes {
  [] -> []
  [te, ...rest] -> match ts {
    [t, ...trest] -> [stamp_te(te, t, resolve), ...stamp_zip(rest, trest, resolve)]
    []            -> tes
  }
}

#[doc("`row` with each label's type arguments stamped by `resolve`, the resolver the signature was typed with.")]
pub fn stamp_row_with(row: RowExpr, resolve: (TypeExpr) -> Ty) : RowExpr = match row {
  REmpty       -> REmpty
  RClosed(ls)  -> if stamp_row_bare(ls) { row } else { RClosed(map(ls, (l) => stamp_label(l, resolve))) }
  ROpen(v, ls) -> if stamp_row_bare(ls) { row } else { ROpen(v, map(ls, (l) => stamp_label(l, resolve))) }
}

# A row whose labels take no type arguments has nothing to stamp.
fn stamp_row_bare(ls: [RowLabel]) : Bool = all(ls, (l) => match l { RL(_, args, _) -> list_is_empty(args) })

fn stamp_label(l: RowLabel, resolve: (TypeExpr) -> Ty) : RowLabel = match l {
  RL(e, args, s) -> RL(e, map(args, (a) => stamp_with(a, resolve)), s)
}

#[doc("`te` stamped by `resolve`.")]
pub fn stamp_with(te: TypeExpr, resolve: (TypeExpr) -> Ty) : TypeExpr = stamp_te(te, resolve(te), resolve)

fn stamp_ref(r: TyRef, s: SymId) : TyRef =
  if sym_raw(ty_ref_sym(r)) >= 0 or sym_raw(s) < 0 { r } else { ty_ref_stamp(r, s) }

#[doc("The declarations the written names in `te` resolve to, in order; unresolved names contribute nothing.")]
pub fn te_decl_ids(te: TypeExpr) : [Int] = match te.tkind {
  TyName(r, _, args) -> {
    let rest = flat_map(args, te_decl_ids)
    if sym_raw(ty_ref_sym(r)) >= 0 { [sym_raw(ty_ref_sym(r)), ...rest] } else { rest }
  }
  TyList(inner)  -> te_decl_ids(inner)
  TyFn(ps, r, _) -> list_append(flat_map(ps, te_decl_ids), te_decl_ids(r))
  TyDim(b, _)    -> te_decl_ids(b)
  _              -> []
}

