# Structural child-mapping over the AST.
#
# One `f: (Expr) -> Expr` applied to every direct sub-expression of a node,
# leaving the node's own shape alone. A pass that only cares about a handful
# of constructs gets its recursion for free instead of restating thirty arms
# it has no opinion about — and a new `ExprKind` variant is a compile error
# here, in one place, rather than a silently skipped subtree in each pass.
#
# `f` is pure: the mapper is used by passes that rewrite structure, not by
# ones that need to report while they walk.

import compiler.ast

pub fn prc_map_arm_exprs[e](a: Arm, f: (Expr) -> Expr / e) : Arm / e {
  match a {
    Arm(p, g, b) -> Arm(p, prc_map_opt_expr(g, f), f(b))
  }
}


pub fn prc_map_clause_exprs[e](c: HClause, f: (Expr) -> Expr / e) : HClause / e {
  match c {
    HC(n, ps, b, l, co) -> HC(n, ps, f(b), l, co)
  }
}


pub fn prc_map_elem_exprs[e](el: ListElem, f: (Expr) -> Expr / e) : ListElem / e {
  match el {
    ElPlain(x)  -> ElPlain(f(x))
    ElSpread(x) -> ElSpread(f(x))
  }
}


pub fn prc_map_expr_kind[e](k: ExprKind, f: (Expr) -> Expr / e) : ExprKind / e {
  match k {
    # Leaves: no sub-Expr to recurse into.
    EInt(_, _)        -> k
    EReal(_, _)       -> k
    EIntLit(_)        -> k
    EDecimalLit(_)    -> k
    EFixed(_, _)      -> k
    EBool(_)       -> k
    EChar(_)       -> k
    EStr(_, _)     -> k
    EUnit          -> k
    EName(_)       -> k
    EMark(_)       -> k
    ESym(_, _)     -> k
    ELocal(_)      -> k
    EOp(_)         -> k
    EUnder         -> k
    EPlaceholder   -> k
    EHole(_)       -> k
    ETodo(_)       -> k
    EExternBody(_, _) -> k
    EVariantsOf(_, _) -> k
    EModCall(_, _) -> k
    EIntrinsic(name, args_) -> EIntrinsic(name, map(args_, f))
    # Composites: apply f to every direct sub-Expr.
    ECall(callee, args_) -> ECall(f(callee), map(args_, f))
    EField(base, name)   -> EField(f(base), name)
    EIndex(a, b)         -> EIndex(f(a), f(b))
    EBinop(op, a, b)     -> EBinop(op, f(a), f(b))
    EUnop(op, x)         -> EUnop(op, f(x))
    EIf(c, t_, eo)       -> EIf(f(c), f(t_), prc_map_opt_expr(eo, f))
    EMatch(scr, arms)    -> EMatch(f(scr), map(arms, (a) => prc_map_arm_exprs(a, f)))
    ELambda(ps, b)       -> ELambda(ps, f(b))
    ERecordLit(r, fs)    -> ERecordLit(r, map(fs, (fi) => prc_map_field_exprs(fi, f)))
    EList(els)           -> EList(map(els, (el) => prc_map_elem_exprs(el, f)))
    ERange(a, b, opt_step) -> ERange(f(a), f(b), prc_map_opt_expr(opt_step, f))
    EBlock(stmts, tail)  -> EBlock(map(stmts, (s) => prc_map_stmt_exprs(s, f)),
                                    prc_map_opt_expr(tail, f))
    EPipe(a, b)          -> EPipe(f(a), f(b))
    EMapPipe(a, b)       -> EMapPipe(f(a), f(b))
    EFlatMapPipe(a, b)   -> EFlatMapPipe(f(a), f(b))
    EFilterPipe(a, b)    -> EFilterPipe(f(a), f(b))
    EHandle(body, eff, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) ->
      EHandle(f(body), eff, eff_tyargs,
              prc_map_opt_expr(init_opt, f), alias_opt,
              map(clauses, (c) => prc_map_clause_exprs(c, f)),
              prc_map_opt_return_exprs(ret_opt, f))
    ELitUnit(inner, u)   -> ELitUnit(f(inner), u)
    EBang(inner)         -> EBang(f(inner))
    ESurface(sf)         -> ESurface(surface_map(sf, f))
  }
}


pub fn prc_map_field_exprs[e](fi: FieldInit, f: (Expr) -> Expr / e) : FieldInit / e {
  match fi {
    FI(n, v) -> FI(n, f(v))
  }
}


pub fn prc_map_opt_expr[e](opt: Option[Expr], f: (Expr) -> Expr / e) : Option[Expr] / e {
  match opt {
    Some(e) -> Some(f(e))
    None    -> None
  }
}


pub fn prc_map_opt_return_exprs[e](opt: Option[HReturn], f: (Expr) -> Expr / e) : Option[HReturn] / e {
  match opt {
    Some(r) -> Some(prc_map_return_exprs(r, f))
    None    -> None
  }
}


pub fn prc_map_return_exprs[e](r: HReturn, f: (Expr) -> Expr / e) : HReturn / e {
  match r {
    HR(p, b, l, c) -> HR(p, f(b), l, c)
  }
}


pub fn prc_map_stmt_exprs[e](s: Stmt, f: (Expr) -> Expr / e) : Stmt / e {
  match s {
    SLet(p, ann, rhs)           -> SLet(p, ann, f(rhs))
    SAssert(c, m)               -> SAssert(f(c), prc_map_opt_expr(m, f))
    SExprStmt(x)                -> SExprStmt(f(x))
    SIndexAssign(b, i, v, l, c) -> SIndexAssign(f(b), f(i), f(v), l, c)
    SAssign(lhs, v, l, c)       -> SAssign(f(lhs), f(v), l, c)
    SVar(n, ty, rhs, l, c)      -> SVar(n, ty, f(rhs), l, c)
    # m7e §25: SUse has no sub-expression — pass through unchanged.
    SUse(n, l, c)               -> SUse(n, l, c)
  }
}


#[doc("Rebase a sub-tree parsed in its own coordinate space onto the enclosing source position.")]
# A fragment re-parsed on its own (a `#{...}` interpolation body) carries
# positions counted from the fragment's own origin, so a diagnostic anchored
# on one of its nodes would point at an unrelated place in the real file.
# Line 1 of the fragment sits at `line` and starts at `col`; later lines start
# at column 1 and only the line number shifts.
pub fn prc_rebase_expr(e: Expr, line: Int, col: Int) : Expr {
  let c = if e.line == 1 { col + e.col - 1 } else { e.col }
  Expr { kind: prc_map_expr_kind(e.kind, (x) => prc_rebase_expr(x, line, col)),
         line: line + e.line - 1, col: c, ty: e.ty, mode: e.mode , site: 0 }
}
