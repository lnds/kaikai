#[doc("""
Which types carry mutation an outside observer can witness.

`Array` and `Ref` carry a mutable cell directly; a record or a sum
carries one when a field or a variant payload reaches an `Array`/`Ref`
through any depth of type arguments (`HashMap`'s `buckets : Ref[..]`,
`HashSet`'s `inner : HashMap`). The carrier set is the transitive
closure over the program's records and sums, never a hard-coded
container list, so a new mutable-backed user type is classified without
touching this module.

Callers use it to answer observability questions: whether a `/ Mutable`
demand is local to its caller, and whether a value handed across a
fiber boundary would be mutated as a copy.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.core_builtins
import compiler.core_types
import compiler.type_home
import compiler.expr_positions
import compiler.modules_homes
import compiler.local_names
import compiler.fmt

#[doc("A nominal type, the declarations the types its values store name (a record's field types, every payload of a sum's variants, through type arguments and list elements), and whether one of them is a closure whose row carries `Mutable`.")]
pub(pkg) type CarrierShape = CarrierShape(SymId, [SymId], Bool)

#[doc("The nominal types whose mutation is observable to anyone sharing the value: every record or sum storing an `Array` or a `Ref`, directly or through another such type. `Array`/`Ref` seed the set. `mutating` is `mutating_type_names(shapes)`, which holds every such type, so only its shapes are scanned.")]
pub(pkg) fn cell_carrier_type_names(shapes: [CarrierShape], mutating: [SymId]) : [SymId] =
  shape_fixpoint(shapes_of(shapes, mutating), carrier_seeds(), false, 0)

fn shapes_of(shapes: [CarrierShape], keep: [SymId]) : [CarrierShape] = match shapes {
  []           -> []
  [s, ...rest] -> match s {
    CarrierShape(ty, _, _) -> if carrier_has(keep, ty) { [s, ...shapes_of(rest, keep)] } else { shapes_of(rest, keep) }
  }
}

#[doc("The nominal types whose values may reach a mutable cell: every record or sum storing an `Array`, a `Ref`, or a closure whose row carries `Mutable`, directly or through another such type. `Array`/`Ref` seed the set.")]
pub(pkg) fn mutating_type_names(shapes: [CarrierShape]) : [SymId] =
  shape_fixpoint(shapes, carrier_seeds(), true, 0)

fn carrier_seeds() : [SymId] = [core_ty_sym(CtRef), core_ty_sym(CtArray)]

# An absent id is no type, so it is in no set.
fn carrier_has(xs: [SymId], s: SymId) : Bool = match xs {
  []           -> false
  [x, ...rest] -> if sym_raw(s) >= 0 and sym_raw(x) == sym_raw(s) { true } else { carrier_has(rest, s) }
}

#[doc("The shape of a record, its field types read from the module declaring it. `v` is any view of the type-home table.")]
pub fn record_shape(v: TyHomeView, r: RecInfo) : CarrierShape = match r {
  RI(s, _, fields, mo) -> shape_of(tsh_at(v, mo), s, map(fields, field_type))
}

#[doc("The shape of the sum `s` module `mo` declares, its variant payloads read from that module. `v` is any view of the type-home table.")]
pub(pkg) fn sum_shape(v: TyHomeView, s: SymId, vs: [Variant], mo: Option[String]) : CarrierShape =
  shape_of(tsh_at(v, mo), s, variant_payloads(vs))

fn shape_of(v: TyHomeView, s: SymId, tes: [TypeExpr]) : CarrierShape =
  CarrierShape(s, tes_named(v, tes, []), tes_hold_mutable_fn(tes))

# The declarations `tes` name at their heads, in type arguments and in
# list elements. A type parameter names none.
fn tes_named(v: TyHomeView, tes: [TypeExpr], acc: [SymId]) : [SymId] = match tes {
  []           -> acc
  [t, ...rest] -> tes_named(v, rest, te_named(v, t, acc))
}

fn te_named(v: TyHomeView, te: TypeExpr, acc: [SymId]) : [SymId] = match te.tkind {
  TyName(r, targs) -> tes_named(v, targs, [stored_ref_sym(v, r), ...acc])
  TyParam(_, targs) -> tes_named(v, targs, acc)
  TyList(elem)     -> te_named(v, elem, acc)
  _                -> acc
}

# The type a stored reference names: its declaration once settled; while
# it is written, what the name denotes from `v`, the module declaring the
# type that stores it.
fn stored_ref_sym(v: TyHomeView, r: DeclRef) : SymId = match r {
  DrSym(s)        -> s
  DrWritten(_, _) -> head_decl(tsh_tycon_at(v, r, []))
}

fn head_decl(t: Ty) : SymId = match t {
  TyCon(s, _) -> s
  _           -> sym_none()
}

fn variant_payloads(vs: [Variant]) : [TypeExpr] = match vs {
  []           -> []
  [v, ...rest] -> match v {
    Var(_, tes, _, _) -> list_append(tes, variant_payloads(rest))
  }
}

#[doc("""
True iff a value of type `t` may reach a mutable cell its holder can observe.

Wider than `ty_carries_mutation`: a carrier may sit in any type argument
(`[Array[Int]]`, `Option[Array[Int]]`) or in a closure's captures when its
row carries `Mutable`.
""")]
pub(pkg) fn ty_may_carry_mutation(t: Ty, dmut: [SymId]) : Bool = match t {
  TyCon(s, args)       -> if carrier_has(dmut, s) { true } else { tys_may_carry_mutation(args, dmut) }
  TyListT(elem)        -> ty_may_carry_mutation(elem, dmut)
  TyFnT(_, _, row)     -> labels_name_mutable(row.labels)
  TyUnion(ts)          -> tys_may_carry_mutation(ts, dmut)
  TyRefineT(base, _, _)   -> ty_may_carry_mutation(base, dmut)
  # A type variable does not count: a callee holding a value only
  # parametrically can mutate it only through a callback it was handed,
  # and the pass classifies that callback where it is called.
  _                    -> false
}

fn tys_may_carry_mutation(ts: [Ty], dmut: [SymId]) : Bool = match ts {
  []           -> false
  [t, ...rest] -> if ty_may_carry_mutation(t, dmut) { true } else { tys_may_carry_mutation(rest, dmut) }
}

fn labels_name_mutable(labels: [Label]) : Bool = match labels {
  []           -> false
  [l, ...rest] -> if effect_is(l.sym, CeMutable) { true } else { labels_name_mutable(rest) }
}

#[doc("The nominal types whose values behave differently on another fiber: those of `cell_carrier_type_names`, plus every record or sum storing a `Seq` or a `Cont`.")]
pub(pkg) fn fiber_bound_type_names(shapes: [CarrierShape]) : [SymId] =
  shape_fixpoint(shapes, [...carrier_seeds(), core_decl_ty_id(CdSeq), core_ty_sym(CtCont)], false, 0)

#[doc("True iff a value of type `t` stores a type of `bound` at its head, in a type argument or in a list element. Fibers and actor handles are transparent: they move by reference.")]
pub(pkg) fn ty_holds_bound(t: Ty, bound: [SymId]) : Bool = match t {
  TyCon(s, args) ->
    if carrier_has(bound, s) { true }
    else if core_ty_is(s, CtFiber) or core_ty_is(s, CtPid) { false }
    else { any(args, (a) => ty_holds_bound(a, bound)) }
  TyListT(elem)   -> ty_holds_bound(elem, bound)
  TyRefineT(b, _, _) -> ty_holds_bound(b, bound)
  _               -> false
}

#[doc("True iff `t` carries mutation: head `Array`/`Ref`, or a record in `dmut`.")]
pub(pkg) fn ty_carries_mutation(t: Ty, dmut: [SymId]) : Bool =
  if ty_is_mutable_ref(t) { true }
  else { match t {
    TyCon(s, _) -> carrier_has(dmut, s)
    _           -> false
  } }

#[doc("""
True iff `s` is a core builtin that writes into the `Array[Byte]` it
takes first. It mutates only that argument: the source it copies from is
read, and Bytes are copied by value.
""")]
fn is_bytes_writer(s: SymId) : Bool =
  carrier_has([builtin_sym("bytes_blit"), builtin_sym("bytes_put_le"), builtin_sym("bytes_put_string")], s)

#[doc("The name prefix of a derived `BinSerialize` writer, `fn <prefix><T>(buf: BinBuf, self: T) : BinBuf / Mutable`.")]
pub(pkg) fn derived_writer_prefix() : String = "__binser_put_"

#[doc("""
True iff the callee `s` mutates only its first argument: a core bytes
writer, or a derived `BinSerialize` writer, which the compiler builds to
append to its buffer and only read the value it encodes. The derive
declares its writer as one, and `tab` holds that.
""")]
pub(pkg) fn writes_only_first_arg(tab: SymTab, s: SymId) : Bool =
  is_bytes_writer(s) or match sym_mint(tab, s) { NmBinWriter -> true  _ -> false }

#[doc("True iff `t` is `Array[_]` or `Ref[_]` — the heads that carry a cell directly.")]
fn ty_is_mutable_ref(t: Ty) : Bool = match t {
  TyCon(tcs, _) -> core_ty_is(tcs, CtArray) or core_ty_is(tcs, CtRef)
  _             -> false
}

# Iterate to a fixpoint so a type that only embeds another mutating
# type (HashSet -> HashMap -> Ref) is caught. Bounded by the shape count:
# each pass adds at least one type or stops. `fns` counts a closure
# field whose row names `Mutable` as a carrier.
fn shape_fixpoint(shapes: [CarrierShape], known: [SymId], fns: Bool, passes: Int) : [SymId] =
  if passes > list_length(shapes) { known }
  else {
    let next = shape_scan(shapes, known, fns, known)
    if list_length(next) == list_length(known) { known }
    else { shape_fixpoint(shapes, next, fns, passes + 1) }
  }

fn shape_scan(shapes: [CarrierShape], known: [SymId], fns: Bool, acc: [SymId]) : [SymId] = match shapes {
  []           -> acc
  [s, ...rest] -> match s {
    CarrierShape(ty, stored, mutable_fn) ->
      if carrier_has(acc, ty) { shape_scan(rest, known, fns, acc) }
      else if (fns and mutable_fn) or any_carrier(stored, known) { shape_scan(rest, known, fns, [ty, ...acc]) }
      else { shape_scan(rest, known, fns, acc) }
  }
}

fn any_carrier(stored: [SymId], known: [SymId]) : Bool = match stored {
  []           -> false
  [s, ...rest] -> if carrier_has(known, s) { true } else { any_carrier(rest, known) }
}

fn field_type(f: FieldDecl) : TypeExpr = match f {
  FD(_, _, te, _, _, _) -> te
}

# A closure whose row names `Mutable`, at the head, in a type argument or
# in a list element.
fn te_holds_mutable_fn(te: TypeExpr) : Bool = match te.tkind {
  TyName(_, targs) -> tes_hold_mutable_fn(targs)
  TyParam(_, targs) -> tes_hold_mutable_fn(targs)
  TyList(elem)     -> te_holds_mutable_fn(elem)
  TyFn(_, _, row)  -> row_expr_names_mutable(row)
  _                -> false
}

fn tes_hold_mutable_fn(tes: [TypeExpr]) : Bool = match tes {
  []           -> false
  [t, ...rest] -> if te_holds_mutable_fn(t) { true } else { tes_hold_mutable_fn(rest) }
}

fn row_expr_names_mutable(row: RowExpr) : Bool = match row {
  REmpty         -> false
  RClosed(ls)    -> row_labels_name_mutable(ls)
  ROpen(_, ls)   -> row_labels_name_mutable(ls)
}

fn row_labels_name_mutable(ls: [RowLabel]) : Bool = match ls {
  []           -> false
  [l, ...rest] -> match l {
    RL(r, _) -> if effect_is(ref_sym(r), CeMutable) { true } else { row_labels_name_mutable(rest) }
  }
}

#[doc("Every binder `body` binds to a closure it cannot see into, the parameters included.")]
pub(pkg) fn opaque_binders(params: [Param], body: Expr) : [LocalId] =
  ob_expr(body, param_ids(params, []))

#[doc("True iff calling `callee` runs a closure whose captures the caller cannot see.")]
pub(pkg) fn callee_is_opaque(callee: Expr, opaque: [LocalId]) : Bool = match callee.kind {
  ELocal(l)      -> ob_has(opaque, l)
  # A declaration is static, and so are an operation and a name the
  # typer has still to settle: neither is a binder.
  ESym(_, _)     -> false
  EOp(_)         -> false
  EName(_)       -> false
  EModCall(_, _) -> false
  ELambda(_, _)  -> false
  _              -> true
}

fn ob_has(ls: [LocalId], l: LocalId) : Bool = match ls {
  []           -> false
  [h, ...rest] -> local_eq(h, l) or ob_has(rest, l)
}

#[doc("True iff `e` is a function value the caller sees into or that captures nothing, so passing it cannot hand over a cell.")]
pub(pkg) fn fn_value_is_transparent(e: Expr, opaque: [LocalId]) : Bool = match e.ty {
  Some(t) -> match t {
    TyFnT(_, _, _) -> not callee_is_opaque(e, opaque)
    _              -> false
  }
  None -> false
}

#[doc("The call `lhs |> rhs` performs: `lhs` fills the first `_` of `rhs`'s arguments, else leads them; a bare `rhs` is applied to `lhs`.")]
pub(pkg) fn pipe_as_call(lhs: Expr, rhs: Expr) : Expr = match rhs.kind {
  ECall(callee, args_) ->
    if has_under(args_) { mk_expr(ECall(callee, fill_under(args_, lhs)), rhs.line, rhs.col) }
    else { mk_expr(ECall(callee, [lhs, ...args_]), rhs.line, rhs.col) }
  _ -> mk_expr(ECall(rhs, [lhs]), rhs.line, rhs.col)
}

fn has_under(es: [Expr]) : Bool = match es {
  []           -> false
  [e, ...rest] -> match e.kind {
    EUnder -> true
    _      -> has_under(rest)
  }
}

fn fill_under(es: [Expr], lhs: Expr) : [Expr] = match es {
  []           -> []
  [e, ...rest] -> match e.kind {
    EUnder -> [lhs, ...rest]
    _      -> [e, ...fill_under(rest, lhs)]
  }
}

fn param_ids(ps: [Param], acc: [LocalId]) : [LocalId] = match ps {
  []           -> acc
  [p, ...rest] -> param_ids(rest, [p.binder.id, ...acc])
}

fn pat_ids(pat: Pattern, acc: [LocalId]) : [LocalId] = foldl(pat_binders(pat, []), acc, (a, b) => [b.id, ...a])

fn ob_expr(e: Expr, acc: [LocalId]) : [LocalId] =
  ob_positions(xp_positions(e), ob_node(e.kind, acc))

fn ob_positions(ps: [XPos], acc: [LocalId]) : [LocalId] = match ps {
  []           -> acc
  [p, ...rest] -> match p {
    XP(_, c) -> ob_positions(rest, ob_expr(c, acc))
  }
}

# The binders a node introduces; `ob_expr` walks its sub-expressions.
fn ob_node(k: ExprKind, acc: [LocalId]) : [LocalId] = match k {
  EBlock(stmts, _)                 -> ob_stmts(stmts, acc)
  EMatch(_, arms)                  -> ob_arms(arms, acc)
  ELambda(ps, _)                   -> param_ids(ps, acc)
  EHandle(_, _, _, _, _, cls, ret) -> ob_return(ret, ob_clauses(cls, acc))
  _                                -> acc
}

fn ob_stmts(ss: [Stmt], acc: [LocalId]) : [LocalId] = match ss {
  []           -> acc
  [s, ...rest] -> ob_stmts(rest, ob_stmt(s, acc))
}

# A `let` naming a lambda literal or a static function stays transparent;
# one aliasing an opaque binder, or holding any other value, does not.
fn ob_stmt(s: Stmt, acc: [LocalId]) : [LocalId] = match s {
  SLet(pat, _, rhs)   -> if callee_is_opaque(rhs, acc) { pat_ids(pat, acc) } else { acc }
  SVar(b, _, _, _, _) -> [b.id, ...acc]
  _                   -> acc
}

fn ob_arms(arms: [Arm], acc: [LocalId]) : [LocalId] = match arms {
  []           -> acc
  [a, ...rest] -> match a {
    Arm(pat, _, _) -> ob_arms(rest, pat_ids(pat, acc))
  }
}

fn ob_clauses(cls: [HClause], acc: [LocalId]) : [LocalId] = match cls {
  []           -> acc
  [c, ...rest] -> match c {
    HC(_, ps, _, _, _) -> ob_clauses(rest, param_ids(ps, acc))
  }
}

fn ob_return(ret: Option[HReturn], acc: [LocalId]) : [LocalId] = match ret {
  Some(HR(b, _, _, _)) -> [b.id, ...acc]
  None                 -> acc
}

#[doc("`roots` are the containers a foreign carrier was stored into; `all` adds every binder read out of one, none of which is local.")]
pub(pkg) type Taint = { roots: [LocalId], all: [LocalId] }

type TtEnv = { locals: [LocalId], foreign: (Expr, [LocalId]) -> Bool }

#[doc("""
The taint of `body`'s `locals`. `foreign(v, live)` answers whether the stored
value `v` is a carrier not local to `live`, the locals still untainted.
""")]
pub(pkg) fn tainted_locals(body: Expr, locals: [LocalId], foreign: (Expr, [LocalId]) -> Bool) : Taint =
  tt_fixpoint(body, TtEnv { locals: locals, foreign: foreign }, Taint { roots: [], all: [] }, 0)

fn tt_fixpoint(body: Expr, env: TtEnv, t: Taint, passes: Int) : Taint = {
  let next = tt_expr(body, env, t)
  if list_length(next.all) == list_length(t.all) or passes > list_length(env.locals) { t }
  else { tt_fixpoint(body, env, next, passes + 1) }
}

fn tt_has(ls: [LocalId], l: LocalId) : Bool = any(ls, (h) => local_eq(h, l))

fn tt_live(env: TtEnv, t: Taint) : [LocalId] = filter(env.locals, (l) => not tt_has(t.all, l))

fn tt_add(env: TtEnv, ls: [LocalId], acc: [LocalId]) : [LocalId] =
  foldl(ls, acc, (a, l) => if tt_has(env.locals, l) and not tt_has(a, l) { [l, ...a] } else { a })

fn tt_add_roots(env: TtEnv, ls: [LocalId], t: Taint) : Taint =
  Taint { roots: tt_add(env, ls, t.roots), all: tt_add(env, ls, t.all) }

fn tt_add_derived(env: TtEnv, ls: [LocalId], t: Taint) : Taint =
  Taint { roots: t.roots, all: tt_add(env, ls, t.all) }

fn tt_mentions(e: Expr, set: [LocalId]) : Bool = match e.kind {
  ELocal(l) -> tt_has(set, l)
  _         -> tt_any_mentions(xp_positions(e), set)
}

fn tt_any_mentions(ps: [XPos], set: [LocalId]) : Bool = any(ps, (p) => match p { XP(_, c) -> tt_mentions(c, set) })

fn tt_mentioned(e: Expr, acc: [LocalId]) : [LocalId] = match e.kind {
  ELocal(l) -> [l, ...acc]
  _         -> foldl(xp_positions(e), acc, (a, p) => match p { XP(_, c) -> tt_mentioned(c, a) })
}

fn tt_expr(e: Expr, env: TtEnv, t: Taint) : Taint = match e.kind {
  ECall(callee, args_) -> tt_positions(xp_positions(e), env, tt_store(callee, args_, env, t))
  EBlock(stmts, tail)  -> tt_tail(tail, env, foldl(stmts, t, (a, s) => tt_stmt(s, env, a)))
  _                    -> tt_positions(xp_positions(e), env, t)
}

fn tt_tail(tail: Option[Expr], env: TtEnv, t: Taint) : Taint = match tail {
  Some(x) -> tt_expr(x, env, t)
  None    -> t
}

fn tt_positions(ps: [XPos], env: TtEnv, t: Taint) : Taint =
  foldl(ps, t, (a, p) => match p { XP(_, c) -> tt_expr(c, env, a) })

fn tt_stmt(s: Stmt, env: TtEnv, t: Taint) : Taint = match s {
  SLet(pat, _, rhs) -> {
    let t1 = tt_expr(rhs, env, t)
    if tt_mentions(rhs, t1.all) { tt_add_derived(env, map(pat_binders(pat, []), .id), t1) } else { t1 }
  }
  _ -> tt_positions(xp_stmt_positions(s), env, t)
}

fn tt_store(callee: Expr, args_: [Expr], env: TtEnv, t: Taint) : Taint =
  if is_builtin_ref(callee, CbArraySet) {
    match args_ {
      [dst, _, v] -> if env.foreign(v, tt_live(env, t)) { tt_add_roots(env, tt_mentioned(dst, []), t) } else { t }
      _           -> t
    }
  } else { t }

#[doc("A note anchored at a secondary span: line, column, message.")]
pub(pkg) type SpanNote = SN(Int, Int, String)

#[doc("The first demand the masking pass could not prove local, and the note naming where its target lost local provenance.")]
pub type MutBlame = MB(Expr, Option[SpanNote])

#[doc("The call where `e` stopped being provably local, following `let` bindings inside `body`.")]
pub(pkg) fn provenance_loss(body: Expr, e: Expr, nonlocal: (Expr) -> Bool) : Option[Expr] = match e.kind {
  ELocal(l) -> match let_rhs(body, l) {
    Some(rhs) -> if nonlocal(rhs) { provenance_loss(body, rhs, nonlocal) } else { None }
    None      -> None
  }
  # A call whose mutable arguments all trace to a further loss passes
  # the blame on; otherwise the call itself is where provenance ended.
  ECall(_, args_) -> match first_nonlocal(args_, nonlocal) {
    Some(a) -> match provenance_loss(body, a, nonlocal) {
      None  -> Some(e)
      found -> found
    }
    None -> Some(e)
  }
  _ -> None
}

fn first_nonlocal(es: [Expr], nonlocal: (Expr) -> Bool) : Option[Expr] = match es {
  []           -> None
  [h, ...rest] -> if nonlocal(h) { Some(h) } else { first_nonlocal(rest, nonlocal) }
}

#[doc("The right-hand side of the `let` that binds `l` inside `e`.")]
fn let_rhs(e: Expr, l: LocalId) : Option[Expr] = match e.kind {
  EBlock(ss, _) -> match stmts_let_rhs(ss, l) {
    None  -> positions_let_rhs(xp_positions(e), l)
    found -> found
  }
  _ -> positions_let_rhs(xp_positions(e), l)
}

fn stmts_let_rhs(ss: [Stmt], l: LocalId) : Option[Expr] = match ss {
  []           -> None
  [s, ...rest] -> match s {
    SLet(p, _, rhs) -> match p.pkind {
      PBind(b) -> if local_eq(b.id, l) { Some(rhs) } else { stmts_let_rhs(rest, l) }
      _        -> stmts_let_rhs(rest, l)
    }
    _ -> stmts_let_rhs(rest, l)
  }
}

fn positions_let_rhs(ps: [XPos], l: LocalId) : Option[Expr] = match ps {
  []                  -> None
  [XP(_, x), ...rest] -> match let_rhs(x, l) {
    None  -> positions_let_rhs(rest, l)
    found -> found
  }
}

#[doc("The note, anchored at `call`, saying a demand's `target` lost local provenance in that call.")]
pub(pkg) fn mut_via_note(tab: SymTab, names: LocalNames, target: Expr, call: Expr) : SpanNote {
  let t = fmt_expr_text(target, tab, names)
  let c = match call.kind {
    ECall(f, _) -> fmt_expr_text(f, tab, names)
    _           -> fmt_expr_text(call, tab, names)
  }
  SN(call.line, call.col, "`#{t}` has no provable local provenance: it comes from the call to `#{c}`")
}
