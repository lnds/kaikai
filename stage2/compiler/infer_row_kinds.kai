#[doc("Row-variable and union collection over type declarations, and the row binds of a signature.")]

import compiler.util
import compiler.chars
import compiler.diag
import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.diag_file
import compiler.kinds
import compiler.kind_theory
import compiler.handler_alias
import compiler.infer_index
import compiler.unit_walk
import compiler.type_home
import compiler.type_text
import compiler.infer_glue
import compiler.infer_env

# The element type a `|` / `||` / `|?` stage receives, read from the
# head's own combinator: its first parameter is the container, its second
# takes the element. Unifying the container binds only the combinator's
# fresh instantiation, which the call would bind the same way.
#[doc("Typer-internal type `PipeElem` shared across the infer modules.")]
pub type PipeElem = PE(Ty, Subst)


#[doc("Typer-internal helper `pipe_elem_ty` shared across the infer modules.")]
pub fn pipe_elem_ty(pe: Option[PipeElem]) : Option[Ty] = match pe {
  Some(PE(t, _)) -> Some(t)
  None           -> None
}


#[doc("infer: `TyEnv` — driver-facing type.")]
pub type TyEnv = { entries: [TyEntry], added: Int, fresh: Int, max_local: Int, unions: UnionTable,
               # `#[constructor]` bindings: constructed type -> fn.
               constructors: [CtorEntry],
               head_owners: [HeadOwnerEntry],
               # per-type effect-row-kind slot table (`compute_row_kind_slots`).
               # Lets annotation resolution (`inf_resolve_ty_rk`) wrap a
               # `T[..., e]` row slot in a carrier so a concrete-row
               # `let s : Stream[String, File + ReadFault]` annotation
               # unifies with the inferred carrier.
               row_kind: [RowKindEntry],
               # the whole-program type-home table (`tsh_homes`). Lets
               # any resolver reached from the env settle a written type
               # name, so the annotation side of a type agrees with
               # the constructor scheme and the record table.
               ty_homes: TyHomes,
               # the program's symbol table: the name of a declaration
               # for a diagnostic, and the ids of a name only the typer
               # can settle.
               tab: SymTab,
               # the declarations, constructors and effect operations
               # among `entries`, each under the id it binds, an
               # operation under its effect's. Every prepend to
               # `entries` prepends here too.
               index: NameIndex[TyEntry],
               # the constructors among the same entries, keyed by the
               # declaration of the sum each builds and by their own:
               # what exhaustiveness and constructor disambiguation query.
               vindex: VariantIndex[TyEntry],
               # the local binders among `entries`, by binder id.
               locals: NameIndex[TyEntry],
               # the program's nominal types whose values may reach a
               # mutable cell. Empty until `typecheck_module` attaches it.
               carriers: [SymId],
               # the scheme of a function the entries do not hold, built from its signature on the first ask.
               late: (SymId) -> Option[TyScheme] }


#[doc("infer: the empty typing environment.")]
pub fn ty_env_empty() : TyEnv = TyEnv { entries: [], added: 0, fresh: 0, max_local: 0, unions: ut_empty(), constructors: [], head_owners: [], row_kind: [], ty_homes: tsh_none(), tab: st_empty(), index: idx_empty(), vindex: vix_empty(), locals: idx_empty(), carriers: [], late: (s) => None }


# What a bare type name in the program being typed denotes.
#[doc("Typer-internal helper `env_home_view` shared across the infer modules.")]
pub fn env_home_view(env: TyEnv, mo: Option[String]) : TyHomeView = tsh_view(env.ty_homes, mo)


#[doc("infer: the scheme of the declaration, constructor or builtin `s`, or None when the environment binds none.")]
pub fn env_sym(env: TyEnv, s: SymId) : Option[TyScheme] =
  if sym_raw(s) < 0 { None } else { match env_sym_in(idx_chain_sym(env.index, s)) {
    Some(sc) -> Some(sc)
    None     -> env.late(s)
  } }


# The scheme of the local binder `l`; a binder nothing numbered binds none.
#[doc("Typer-internal helper `env_local` shared across the infer modules.")]
pub fn env_local(env: TyEnv, l: LocalId) : Option[TyScheme] =
  if local_raw(l) == 0 { None }
  else { match idx_chain_local(env.locals, l) {
    [e, ..._] -> Some(e.scheme)
    []        -> None
  } }


# The scheme of the operation `op` of the effect `eff` declares.
#[doc("Typer-internal helper `env_op` shared across the infer modules.")]
pub fn env_op(env: TyEnv, eff: SymId, op: Written) : Option[TyScheme] =
  if sym_raw(eff) < 0 { None } else { env_op_in(idx_chain_sym(env.index, eff), written_text(op)) }


# True when `eff` is an effect's declaration; one with no operation is still one.
#[doc("Typer-internal helper `env_has_effect` shared across the infer modules.")]
pub fn env_has_effect(env: TyEnv, eff: SymId) : Bool =
  st_valid(env.tab, eff) and ncls_same(sym_class(env.tab, eff), NCEffect)


# The constructors of the sum `sum` declares, newest first.
#[doc("Typer-internal helper `env_ctors` shared across the infer modules.")]
pub fn env_ctors(env: TyEnv, sum: SymId) : [TyEntry] = vix_chain(env.vindex, sum)


# Every function spelled `target` that a module other than the root
# declares and the environment binds, newest declaration first. The
# root's own is the resolver's to settle, never a candidate.
#[doc("Typer-internal helper `ty_env_collect_candidates` shared across the infer modules.")]
pub fn ty_env_collect_candidates(env: TyEnv, target: String) : [TyCandidate] =
  env_candidates(env, st_module_id(tsh_target(env.ty_homes)), st_candidates(env.tab, NCFn, target), [])


fn env_candidates(env: TyEnv, root: SymId, ss: [SymId], acc: [TyCandidate]) : [TyCandidate] = match ss {
  [] -> acc
  [s, ...rest] ->
    if sym_same(sym_owner(env.tab, s), root) { env_candidates(env, root, rest, acc) }
    else { match env_sym(env, s) {
      Some(sc) -> env_candidates(env, root, rest, [TyCandidate { scheme: sc, sym: s }, ...acc])
      None     -> env_candidates(env, root, rest, acc)
    } }
}


# The names of the constructors the environment binds: what an unknown
# variant is compared against for a suggestion.
#[doc("Typer-internal helper `env_ctor_names` shared across the infer modules.")]
pub fn env_ctor_names(env: TyEnv) : [String] =
  env_ctor_names_loop(env.tab, env.entries, [])


# A use of the type parameter `id` applied to `tas`: a shape carrier
# applied to its one argument is `s[A]`, any other bound parameter is
# its variable. One the binding does not hold is a name no declaration
# answers.
#[doc("Typer-internal helper `tparam_use` shared across the infer modules.")]
pub fn tparam_use(binds: [TPBind], id: TLocalId, tas: [Ty]) : Ty = match shape_tparam_lookup(binds, id) {
  Some(sid) -> match tas {
    [arg] -> TyShapeApp(sid, arg)
    _     -> tv(sid)
  }
  None -> match tpbind_lookup(binds, id) {
    Some(i) -> tv(i)
    None    -> TyCon(sym_none(), tas)
  }
}


# Build the per-type row-kind-slot table from the whole decl stream.
#[doc("Typer-internal helper `compute_row_kind_slots` shared across the infer modules.")]
pub fn compute_row_kind_slots(decls: [Decl]) : [RowKindEntry] {
  match decls {
    [] -> []
    [d, ...rest] -> match row_kind_entry_of(d) {
      Some(e) -> [e, ...compute_row_kind_slots(rest)]
      None    -> compute_row_kind_slots(rest)
    }
  }
}


fn row_kind_entry_of(d: Decl) : Option[RowKindEntry] = match d {
  DType(_, sid, tparams, body, _, _, _, _) -> {
    let row_names = row_names_of_typebody(body)
    match row_names {
      [] -> None
      _  -> Some(RKE(sid, row_kind_indices(tparams, row_names, 0)))
    }
  }
  _ -> None
}


# The parameters a type body uses in row position across all its ctor fields.
fn row_names_of_typebody(b: TypeBody) : [TLocalId] = match b {
  TBSum(vs)    -> row_names_of_variants(vs, [])
  TBRecord(fs) -> row_names_of_fields(fs, [])
  _            -> []
}


fn row_names_of_variants(vs: [Variant], acc: [TLocalId]) : [TLocalId] = match vs {
  [] -> acc
  [v, ...rest] -> match v {
    Var(_, vargs) -> row_names_of_variants(rest, cont_row_names_all(vargs, collect_rvars_in_typeexprs(vargs, acc)))
  }
}


#[doc("Typer-internal helper `row_names_of_fields` shared across the infer modules.")]
pub fn row_names_of_fields(fs: [FieldDecl], acc: [TLocalId]) : [TLocalId] = match fs {
  [] -> acc
  [f, ...rest] -> match f {
    FD(_, _, te, _) -> row_names_of_fields(rest, cont_row_names(te, collect_rvars_in_typeexpr(te, acc)))
  }
}


# Row variables a type passes as a continuation's row: `e` in `Cont[T, S, e]`.
fn cont_row_names(t: TypeExpr, acc: [TLocalId]) : [TLocalId] = match t.tkind {
  TyName(n, tas) -> cont_row_names_all(tas, match tas {
    [_, _, r] -> if ref_is_cont(n) { match r.tkind {
      TyParam(rn, []) -> if not tids_has(acc, rn) { [rn, ...acc] } else { acc }
      _ -> acc
    } } else { acc }
    _ -> acc
  })
  TyParam(_, tas) -> cont_row_names_all(tas, acc)
  TyList(inner) -> cont_row_names(inner, acc)
  TyFn(ps, ret, _) -> cont_row_names_all([ret, ...ps], acc)
  TyDim(base, _) -> cont_row_names(base, acc)
  TyRefine(base, _) -> cont_row_names(base, acc)
  TyRow(_) -> acc
  TySurface(ts) -> cont_row_names_all(tysurface_children(ts), acc)
}


#[doc("Typer-internal helper `cont_row_names_all` shared across the infer modules.")]
pub fn cont_row_names_all(ts: [TypeExpr], acc: [TLocalId]) : [TLocalId] = match ts {
  [] -> acc
  [t, ...rest] -> cont_row_names_all(rest, cont_row_names(t, acc))
}


# The zero-based positions in `tparams` of the parameters among `row_names`.
fn row_kind_indices(tparams: [TBinder], row_names: [TLocalId], i: Int) : [Int] = match tparams {
  [] -> []
  [n, ...rest] ->
    if tids_has(row_names, n.id) { [i, ...row_kind_indices(rest, row_names, i + 1)] }
    else { row_kind_indices(rest, row_names, i + 1) }
}


# The row variables a type body opens a row with and no parameter of the
# type binds: a tail, or a continuation's row, still written.
fn unbound_row_names(b: TypeBody) : [String] = match b {
  TBSum(vs)    -> unbound_rows_tes(flat_map(vs, (v) => match v { Var(_, vargs) -> vargs }), [])
  TBRecord(fs) -> unbound_rows_tes(map(fs, (f) => match f { FD(_, _, te, _) -> te }), [])
  _            -> []
}


fn unbound_rows_tes(ts: [TypeExpr], acc: [String]) : [String] = match ts {
  [] -> acc
  [t, ...rest] -> unbound_rows_tes(rest, unbound_rows_te(t, acc))
}


fn unbound_rows_te(t: TypeExpr, acc: [String]) : [String] = match t.tkind {
  TyName(n, tas) -> unbound_rows_tes(tas, match tas {
    [_, _, r] -> if ref_is_cont(n) { match r.tkind {
      TyName(rr, []) -> if is_implicit_tparam_candidate(ref_name(rr)) { unbound_row_add(acc, ref_name(rr)) } else { acc }
      _ -> acc
    } } else { acc }
    _ -> acc
  })
  TyParam(_, tas)   -> unbound_rows_tes(tas, acc)
  TyList(inner)     -> unbound_rows_te(inner, acc)
  TyFn(ps, ret, row) -> unbound_rows_row(row, unbound_rows_te(ret, unbound_rows_tes(ps, acc)))
  TyDim(base, _)    -> unbound_rows_te(base, acc)
  TyRefine(base, _) -> unbound_rows_te(base, acc)
  TyRow(row)        -> unbound_rows_row(row, acc)
  TySurface(ts)     -> unbound_rows_tes(tysurface_children(ts), acc)
}


fn unbound_rows_row(r: RowExpr, acc: [String]) : [String] = match r {
  ROpen(TpWritten(w), _) -> unbound_row_add(acc, written_text(w))
  _                      -> acc
}


fn unbound_row_add(acc: [String], n: String) : [String] =
  if list_has(acc, n) { acc } else { list_append(acc, [n]) }


# The row-kind slots of the type `r` names from `hv`, or [] if it
# declares none: a homonym declared elsewhere has slots of its own. The
# builtin `Cont[T, S, e]` carries its body's row in slot 2.
#[doc("Typer-internal helper `row_kind_slots_of` shared across the infer modules.")]
pub fn row_kind_slots_of(table: [RowKindEntry], r: DeclRef, hv: TyHomeView) : [Int] =
  rk_slots_by(table, te_ref_sym(hv, r))


fn rk_slots_by(table: [RowKindEntry], s: SymId) : [Int] =
  if core_ty_is(s, CtCont) { [2] } else { rk_slots_of_decl(table, s) }


fn rk_slots_of_decl(table: [RowKindEntry], s: SymId) : [Int] = match table {
  [] -> []
  [RKE(es, idxs), ...rest] ->
    if sym_raw(s) >= 0 and sym_raw(es) == sym_raw(s) { idxs } else { rk_slots_of_decl(rest, s) }
}


# Reject a nominal type whose ctor field uses an effect-row variable
# the type never declares as a tparam (`type Q[t] = Qq((t) -> Unit / e)`
# with `e` absent from `[t]`). Without this the scheme builder panics in
# `tpbind_id_of` — an unbound row var has no slot to thread through. The
# fix the user wants is to declare the row var: `type Q[t, e] = ...`.
#[doc("infer: `validate_nominal_row_vars_decls` — typer entry point invoked by the driver.")]
pub fn validate_nominal_row_vars_decls(decls: [Decl], df: DiagFiles) : [Diagnostic] / Console + File =
  validate_nominal_row_vars_loop(decls, df, [])


fn validate_nominal_row_vars_loop(decls: [Decl], df: DiagFiles, errs: [Diagnostic]) : [Diagnostic] / Console + File {
  match decls {
    [] -> list_reverse(errs)
    [d, ...rest] -> validate_nominal_row_vars_loop(rest, df, list_append(validate_nominal_row_vars_decl(d, decl_diag_file(d, df)), errs))
  }
}


fn validate_nominal_row_vars_decl(d: Decl, file: String) : [Diagnostic] / Console + File = match decl_transparent_inner(d) {
  Some(inner) -> validate_nominal_row_vars_decl(inner, file)
  None -> match d {
    DType(_, _, _, body, line, col, _, _) -> {
      let free = unbound_row_names(body)
      match free {
        [] -> []
        [name, ...__] -> {
          let d = mk_diag(SevError, file, line, col,
            concat_all(["unbound effect-row variable `", name,
              "` in type declaration — declare it as a type parameter ",
              "(`[..., ", name, "]`) so the carrier can thread the row"]), [])
          render_diag(d)
          [d]
        }
      }
    }
    _ -> []
  }
}


# Look up the type-var id assigned to a tparam in its TPBind list.
# A miss is a compiler bug: every id passed here comes from `tparams`,
# which `mk_tpbinds` binds in full — so panic rather than fabricate a
# bogus id that would leak an ungeneralised type-var into the scheme.
#[doc("Typer-internal helper `tpbind_id_of` shared across the infer modules.")]
pub fn tpbind_id_of(binds: [TPBind], id: TLocalId) : Int =
  match tpbind_any(binds, id) {
    Some(i) -> i
    None    -> panic("tpbind_id_of: tparam not in binds: #{tlocal_raw(id)}")
  }


# Return the ids in `xs` that are not present in `drop` (order-preserving).
# Used to separate a ctor's type-kind tparams from its row-kind ones.
#[doc("Typer-internal helper `names_excluding` shared across the infer modules.")]
pub fn names_excluding(xs: [TLocalId], drop: [TLocalId]) : [TLocalId] {
  match xs {
    [] -> []
    [h, ...rest] ->
      if tids_has(drop, h) { names_excluding(rest, drop) }
      else { [h, ...names_excluding(rest, drop)] }
  }
}


# Each component's module slot and identity come from the same view the
# constructor schemes are stamped from.
#[doc("Typer-internal helper `collect_unions` shared across the infer modules.")]
pub fn collect_unions(ds: [Decl], tab: SymTab, hv: TyHomeView) : [UnionInfo] =
  collect_unions_loop(ds, tab, [], hv)


fn collect_unions_loop(ds: [Decl], tab: SymTab, acc: [UnionInfo], hv: TyHomeView) : [UnionInfo] {
  match ds {
    [] -> list_reverse(acc)
    [d, ...rest] -> match decl_transparent_inner(d) {
      Some(inner) -> collect_unions_loop([inner, ...rest], tab, acc, hv)
      None -> match d {
        DType(_, tsym, _, body, line, col, mo, _) -> match body {
          TBSum(vs) -> {
            let comps = variants_to_component_tys(vs, tsh_at(hv, mo))
            collect_unions_loop(rest, tab, [UI(tsym, comps, line, col), ...acc], hv)
          }
          _ -> collect_unions_loop(rest, tab, acc, hv)
        }
        _ -> collect_unions_loop(rest, tab, acc, hv)
      }
    }
  }
}


# The same summary, one row per union in the same order, each carrying
# the type its declaration introduces.
#[doc("Typer-internal helper `collect_union_rows` shared across the infer modules.")]
pub fn collect_union_rows(ds: [Decl], tab: SymTab, hv: TyHomeView) : [UnionRow] =
  collect_union_rows_loop(ds, tab, [], hv)


fn collect_union_rows_loop(ds: [Decl], tab: SymTab, acc: [UnionRow], hv: TyHomeView) : [UnionRow] {
  match ds {
    [] -> list_reverse(acc)
    [d, ...rest] -> match decl_transparent_inner(d) {
      Some(inner) -> collect_union_rows_loop([inner, ...rest], tab, acc, hv)
      None -> match d {
        DType(_, tsym, _, body, line, col, mo, _) -> match body {
          TBSum(vs) -> {
            let row = UnionRow(TyCon(tsym, []), variants_to_component_tys(vs, tsh_at(hv, mo)), line, col)
            collect_union_rows_loop(rest, tab, [row, ...acc], hv)
          }
          _ -> collect_union_rows_loop(rest, tab, acc, hv)
        }
        _ -> collect_union_rows_loop(rest, tab, acc, hv)
      }
    }
  }
}


# Each variant becomes the type its name denotes from the declaring
# module: a declared type of that name, else the component the variant
# itself stands for. The variant payload is erased at the type level:
# the parent's TyCon-result is what makes payload-bearing variants
# type-check. Singleton unions collapse to the bare component (per
# `normalize_union`).
fn variants_to_component_tys(vs: [Variant], hv: TyHomeView) : [Ty] {
  match vs {
    [] -> []
    [v, ...rest] -> match v {
      Var(csym, _) -> [TyCon(tsh_variant_sym(hv, csym), []), ...variants_to_component_tys(rest, hv)]
    }
  }
}


# The names of the nominal types in `ts`, in order: what a pattern
# arm or a diagnostic names a component by.
fn ty_names(tab: SymTab, ts: [Ty]) : [String] {
  match ts {
    [] -> []
    [t, ...rest] -> match t {
      TyCon(s, _) -> [written_text(decl_name(tab, s)), ...ty_names(tab, rest)]
      _           -> ty_names(tab, rest)
    }
  }
}


# The names of the components the union `parent` declares.
#[doc("Typer-internal helper `union_component_names` shared across the infer modules.")]
pub fn union_component_names(tab: SymTab, unions: UnionTable, parent: SymId) : [String] =
  ty_names(tab, ut_components(unions, parent))


# collect all distinct row-variable names appearing in the
# row positions of a function declaration's signature: the outer
# return-row plus every nested `TyFn` row inside parameter types and
# the return type. Order of first occurrence is preserved so each
# decl gets a stable assignment of bound row-var ids.
#[doc("Typer-internal helper `collect_decl_rvars` shared across the infer modules.")]
pub fn collect_decl_rvars(d: Decl) : [TLocalId] {
  match d {
    DFn(_, _, _, params, opt_ret, rexpr, _, _, _, _) -> {
      let acc0 = collect_rvars_in_row(rexpr, [])
      let acc1 = collect_rvars_in_params(params, acc0)
      match opt_ret {
        Some(rty) -> collect_rvars_in_typeexpr(rty, acc1)
        None      -> acc1
      }
    }
    _ -> []
  }
}


# A tail no signature bound names no row variable.
fn collect_rvars_in_row(re: RowExpr, acc: [TLocalId]) : [TLocalId] {
  match re {
    ROpen(TpId(rv), _) -> tids_add(acc, rv)
    _ -> acc
  }
}


fn collect_rvars_in_params(ps: [Param], acc: [TLocalId]) : [TLocalId] {
  match ps {
    [] -> acc
    [p, ...rest] -> {
      let acc1 = match p.ptype {
        Some(te) -> collect_rvars_in_typeexpr(te, acc)
        None     -> acc
      }
      collect_rvars_in_params(rest, acc1)
    }
  }
}


fn collect_rvars_in_typeexpr(t: TypeExpr, acc: [TLocalId]) : [TLocalId] {
  match t.tkind {
    TyName(_, tas) -> collect_rvars_in_typeexprs(tas, acc)
    TyParam(_, tas) -> collect_rvars_in_typeexprs(tas, acc)
    TyList(inner)  -> collect_rvars_in_typeexpr(inner, acc)
    TyFn(ps, ret, rexpr) -> {
      let acc1 = collect_rvars_in_typeexprs(ps, acc)
      let acc2 = collect_rvars_in_typeexpr(ret, acc1)
      collect_rvars_in_row(rexpr, acc2)
    }
    # dimensioned base — recurse into the inner ty; the unit
    # itself never carries row variables.
    TyDim(base, _) -> collect_rvars_in_typeexpr(base, acc)
    # refinement predicates are pure (no effects, no rows);
    # only the base type can contribute row variables.
    TyRefine(base, _) -> collect_rvars_in_typeexpr(base, acc)
    # a compound row as a type argument can carry an open
    # tail (`Stream[Int, Stdout + f]`); collect `f` as a row variable
    # so the scheme binds it before alias substitution folds the row in.
    TyRow(row) -> collect_rvars_in_row(row, acc)
    TySurface(ts) -> collect_rvars_in_typeexprs(tysurface_children(ts), acc)
  }
}


#[doc("Typer-internal helper `collect_rvars_in_typeexprs` shared across the infer modules.")]
pub fn collect_rvars_in_typeexprs(ts: [TypeExpr], acc: [TLocalId]) : [TLocalId] {
  match ts {
    [] -> acc
    [t, ...rest] -> collect_rvars_in_typeexprs(rest, collect_rvars_in_typeexpr(t, acc))
  }
}


fn mk_rvbinds_loop(names: [TLocalId], i: Int, acc: [RVBind]) : [RVBind] {
  match names {
    [] -> list_reverse(acc)
    [n, ...rest] -> mk_rvbinds_loop(rest, i + 1, [RVB(n, i), ...acc])
  }
}


#[doc("Typer-internal helper `mk_rvbinds` shared across the infer modules.")]
pub fn mk_rvbinds(names: [TLocalId]) : [RVBind] = mk_rvbinds_loop(names, 0, [])


fn rvbind_ids_loop(binds: [RVBind], acc: [Int]) : [Int] {
  match binds {
    [] -> list_reverse(acc)
    [b, ...rest] -> match b {
      RVB(_, i) -> rvbind_ids_loop(rest, [i, ...acc])
    }
  }
}


#[doc("Typer-internal helper `rvbind_ids` shared across the infer modules.")]
pub fn rvbind_ids(binds: [RVBind]) : [Int] = rvbind_ids_loop(binds, [])


# walk a UnitExprT and replace each use of a unit-kind tparam the
# binding holds with its UVar(id). One it does not hold stays as it is.
#[doc("Typer-internal helper `unit_resolve_tparams` shared across the infer modules.")]
pub fn unit_resolve_tparams(u: UnitExprT, tpbinds: [TPBind]) : UnitExprT {
  match u {
    UOne -> u
    UVar(_) -> u
    USym(_) -> u
    UParam(p) -> match unit_tparam_lookup(tpbinds, p) {
      Some(id) -> UVar(id)
      None     -> u
    }
    UMul(a, b) -> UMul(unit_resolve_tparams(a, tpbinds), unit_resolve_tparams(b, tpbinds))
    UInv(a) -> UInv(unit_resolve_tparams(a, tpbinds))
    UPow(a, n) -> UPow(unit_resolve_tparams(a, tpbinds), n)
    UJoin(a, b) -> UJoin(unit_resolve_tparams(a, tpbinds), unit_resolve_tparams(b, tpbinds))
    UDims(us) -> UDims(units_resolve_tparams(us, tpbinds))
  }
}


fn units_resolve_tparams(us: [UnitExprT], tpbinds: [TPBind]) : [UnitExprT] = match us {
  [] -> []
  [u, ...rest] -> [unit_resolve_tparams(u, tpbinds), ...units_resolve_tparams(rest, tpbinds)]
}


# The unit variable of the unit-kind tparam `p`, if the binding holds it.
fn unit_tparam_lookup(binds: [TPBind], p: TLocalId) : Option[Int] {
  match binds {
    [] -> None
    [b, ...rest] -> match b {
      TPB(stored, id) -> {
        if tb_is_unit(stored) and tlocal_eq(stored.id, p) { Some(id) }
        else { unit_tparam_lookup(rest, p) }
      }
    }
  }
}


# The variable of the shape-kind tparam `p`, if the binding holds it.
fn shape_tparam_lookup(binds: [TPBind], p: TLocalId) : Option[Int] {
  match binds {
    [] -> None
    [b, ...rest] -> match b {
      TPB(stored, id) -> {
        if tb_is_shape(stored) and tlocal_eq(stored.id, p) { Some(id) }
        else { shape_tparam_lookup(rest, p) }
      }
    }
  }
}


# The binder the `var` desugar mints to pin a declared cell type.
#[doc("Typer-internal helper `pat_binds_var_ann` shared across the infer modules.")]
pub fn pat_binds_var_ann(p: Pattern) : Bool = pat_is_var_ann(p)


# predicate gating the elaboration of a phantom row
# variable on a fn signature lacking a `/` row clause. The entry point is
# excluded because `check_body_row`'s REmpty branch absorbs builtin
# effects there; adding a phantom row var would interfere with that
# special-case.
#[doc("Typer-internal helper `elaborate_phantom_row` shared across the infer modules.")]
pub fn elaborate_phantom_row(rexpr: RowExpr, entry: Bool) : Bool {
  match rexpr {
    REmpty -> not entry
    _      -> false
  }
}


# A root module's `main` types as the entry point it is when its file is
# built alone, whether or not this binary starts there.
#[doc("Typer-internal helper `decl_types_as_entry` shared across the infer modules.")]
pub fn decl_types_as_entry(hs: TyHomes, f: FnId) : Bool =
  is_root_main(tsh_roots(hs), f)


# A name is an implicit-tparam candidate if it begins with a
# lowercase letter. Builtin primitives (Int, Real, Bool, …) all
# start uppercase, so this naturally excludes them.
fn is_implicit_tparam_candidate(name: String) : Bool {
  if string_length(name) == 0 { false }
  else { match char_at(name, 0) {
    Some(c) -> ch_is_lower(c)
    None -> false
  } }
}


# Record a `#[constructor]` binding on the env. The inner `DFn`'s
# return type names the constructed type; the fn's own id is the call
# target. Entries accumulate (a duplicate is a second entry for the same
# type); `check_constructor_uniqueness` reports the second as an error
# later, where diagnostics are available.
#[doc("Typer-internal helper `register_constructor` shared across the infer modules.")]
pub fn register_constructor(env: TyEnv, inner: Decl, l: Int, c: Int) : TyEnv {
  match inner {
    DFn(_, fid, _, _, ret_opt, _, _, _, _, mo) -> match ret_opt {
      Some(ret_te) -> {
        let tsym = constructor_type_sym(ret_te, env_home_view(env, mo))
        if sym_raw(tsym) < 0 { env } else { ctor_add(env, CtorE(tsym, fnid_sym(fid)), l, c) }
      }
      None -> env
    }
    _ -> env
  }
}


#[doc("infer: the type a `#[constructor]` fn returning `te` constructs, as `hv` reads it; `sym_none()` when `te` names no declared type.")]
pub fn constructor_type_sym(te: TypeExpr, hv: TyHomeView) : SymId = match te.tkind {
  TyName(r, _) -> te_ref_sym(hv, r)
  _            -> sym_none()
}


fn ctor_add(env: TyEnv, entry: CtorEntry, l: Int, c: Int) : TyEnv =
  TyEnv { ...env, constructors: [entry, ...env.constructors] }


# Collect every `#[constructor]` binding in a decl stream. Used to
# seed a module's `ModuleEnvDelta` so downstream modules inherit the
# registry — the sugar resolves cross-module `Type(args)` calls.
#[doc("Typer-internal helper `collect_constructors` shared across the infer modules.")]
pub fn collect_constructors(ds: [Decl], homes: TyHomes, acc: [CtorEntry]) : [CtorEntry] {
  match ds {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DConstructor(DFn(_, fid, _, _, Some(ret_te), _, _, _, _, mo), _, _) -> {
        let tsym = constructor_type_sym(ret_te, tsh_view(homes, mo))
        if sym_raw(tsym) < 0 { collect_constructors(rest, homes, acc) }
        else { collect_constructors(rest, homes, [CtorE(tsym, fnid_sym(fid)), ...acc]) }
      }
      _ -> collect_constructors(rest, homes, acc)
    }
  }
}


# Look up the constructor binding for a type; newest-first, so the
# reported duplicate never masks the first-registered target.
#[doc("Typer-internal helper `constructor_lookup` shared across the infer modules.")]
pub fn constructor_lookup(cs: [CtorEntry], tsym: SymId) : Option[CtorEntry] {
  match cs {
    [] -> None
    [CtorE(t, f), ...rest] ->
      if sym_same(t, tsym) { Some(CtorE(t, f)) } else { constructor_lookup(rest, tsym) }
  }
}


# collect row-variable names appearing in `ROpen` tails
# inside an op's parameter types and return type. Mirrors
# `collect_decl_rvars` for fns but reads an EffectOp's pieces
# directly. The op's outer row is always empty (ops run inside a
# handler context), so only nested TyFn rows in param / ret types
# can introduce row variables.
#[doc("Typer-internal helper `collect_op_rvars` shared across the infer modules.")]
pub fn collect_op_rvars(params: [Param], ret: TypeExpr) : [TLocalId] {
  let acc0 = collect_rvars_in_params(params, [])
  collect_rvars_in_typeexpr(ret, acc0)
}


# same as `mk_rvbinds` but starts ids at `start`.
# Effects do not currently declare row params at the effect level,
# so the offset is 0 today; the parameter exists for symmetry with
# `mk_tpbinds_from` and to avoid silent breakage if effect-level
# row generics ever land.
#[doc("Typer-internal helper `mk_rvbinds_from` shared across the infer modules.")]
pub fn mk_rvbinds_from(names: [TLocalId], start: Int) : [RVBind] =
  mk_rvbinds_loop(names, start, [])


# The substitution is indexed directly by TyVar id, so apply_ty and
# occurs do O(1) lookups instead of walking an association list.
#
# ⚠️  Aliasing hazard. `Array[T]` is a provisional audited escape
# (see CLAUDE.md Tier 1 and docs/design.md "Memory model"): the
# mutation is not visible in the type. Every kaikai value otherwise
# pretends to be immutable, so the usual mental model —
# "Subst { slots: ... } builds a new record, the old subst is still
# valid" — is WRONG here. subst_extend mutates `s.slots` in place
# and returns a new Subst record that **aliases the same array**.
#
# The contract callers must obey:
#
#   1. Thread the substitution linearly. unify, st_set_sub,
#      mk_fresh_subst all do this already: extend it, pass it
#      forward, never look at the old value.
#   2. **Never fork** a Subst between two alternative trials and
#      compare results. Both trials will see each other's mutations
#      and the inference will silently corrupt. If you ever need
#      speculative unification (e.g. for typeclass resolution or
#      intersection types), this representation must change first.
#   3. Do not publish a Subst outside the inferencer's control flow
#      (no storing in long-lived records, no returning via Option,
#      no capturing in a closure that outlives the caller).
#
# When the `Mutable` effect lands, `array_set` should require it,
# and these informal rules become a type-level obligation.
#[doc("Typer-internal type `Subst` shared across the infer modules.")]
pub type Subst = {
  slots:     Array[Option[Ty]],
  row_slots: Array[Option[Row]],
  row_fresh: Int,
  # parallel slot table for unit unification variables (UVar).
  # Same opaque-mutable Array discipline as `slots`; never publish
  # outside the inferencer.
  unit_slots: Array[Option[UnitExprT]],
  unit_fresh: Int,
  # the atomic (kind, theory) pairs: unit formation and unify_dim
  # dispatch on the theory of each habitant's kind. Program-wide,
  # read-only after seeding.
  kind_theories: [KindTheory],
  # the kind each constrained unit var ranges over: seeded from the
  # decl's unit tparams and copied to fresh vars at instantiation.
  # A var absent here is unconstrained. The abelian pivot consults
  # this before binding, so a habitant of one kind cannot bind a
  # tparam declared over another.
  unit_var_kinds: [UVKind],
  # the declared type parameters of the fn being typed: inside its body
  # each is one unknown type, never bound to a concrete type or to
  # another of them.
  rigid: [RigidTv],
  # the declared row variables of the fn being typed: each is one unknown
  # row, never closed nor bound to a label-carrying row.
  rigid_rows: [Int]
}


#[doc("infer: a declared type parameter's var id, its binder (none for an op's own parameter, unnamed in its clause) and the fn declaring it, rigid inside that fn's body.")]
pub type RigidTv = RigidTv(Int, Option[TBinder], String)


#[doc("infer: a (unit-var id, kind name) constraint entry.")]
pub type UVKind = UVK(Int, String)


#[doc("Typer-internal helper `subst_empty` shared across the infer modules.")]
pub fn subst_empty() : Subst = Subst {
  slots:     array_make(64, None),
  row_slots: array_make(16, None),
  row_fresh: 0,
  unit_slots: array_make(16, None),
  unit_fresh: 0,
  kind_theories: [],
  unit_var_kinds: [],
  rigid: [],
  rigid_rows: []
}


#[doc("Typer-internal helper `subst_seed_kind_theories` shared across the infer modules.")]
pub fn subst_seed_kind_theories(s: Subst, kts: [KindTheory]) : Subst = Subst {
  slots: s.slots, row_slots: s.row_slots, row_fresh: s.row_fresh,
  unit_slots: s.unit_slots, unit_fresh: s.unit_fresh, kind_theories: kts,
  unit_var_kinds: s.unit_var_kinds, rigid: s.rigid, rigid_rows: s.rigid_rows
}


#[doc("Typer-internal helper `subst_unit_kind_lookup` shared across the infer modules.")]
pub fn subst_unit_kind_lookup(s: Subst, v: Int) : Option[String] =
  uvk_lookup(s.unit_var_kinds, v)


fn uvk_lookup(xs: [UVKind], v: Int) : Option[String] = match xs {
  [] -> None
  [h, ...rest] -> match h {
    UVK(id, k) -> if id == v { Some(k) } else { uvk_lookup(rest, v) }
  }
}


# Constrain unit var `v` to kind `k`. `""` (kind-agnostic) adds nothing.
#[doc("Typer-internal helper `subst_add_unit_kind` shared across the infer modules.")]
pub fn subst_add_unit_kind(s: Subst, v: Int, k: String) : Subst =
  if k == "" { s }
  else { Subst { slots: s.slots, row_slots: s.row_slots, row_fresh: s.row_fresh,
                 unit_slots: s.unit_slots, unit_fresh: s.unit_fresh,
                 kind_theories: s.kind_theories,
                 unit_var_kinds: [UVK(v, k), ...s.unit_var_kinds], rigid: s.rigid, rigid_rows: s.rigid_rows } }


#[doc("Typer-internal helper `subst_add_unit_kinds` shared across the infer modules.")]
pub fn subst_add_unit_kinds(s: Subst, ids: [Int], kinds: [String]) : Subst {
  match ids {
    [] -> s
    [i, ...irest] -> match kinds {
      [] -> s
      [k, ...krest] -> subst_add_unit_kinds(subst_add_unit_kind(s, i, k), irest, krest)
    }
  }
}


#[doc("Typer-internal helper `subst_lookup` shared across the infer modules.")]
pub fn subst_lookup(s: Subst, v: Int) : Option[Ty] {
  if v >= array_length(s.slots) { None }
  else { array_get(s.slots, v) }
}


#[doc("Typer-internal helper `subst_extend` shared across the infer modules.")]
pub fn subst_extend(s: Subst, v: Int, ty: Ty) : Subst / Mutable {
  let len = array_length(s.slots)
  let slots1 = if v >= len {
    let grown = if v + 1 > len * 2 { v + 1 } else { len * 2 }
    array_grow(s.slots, grown, None)
  } else { s.slots }
  let slots2 = array_set(slots1, v, Some(ty))
  Subst { slots: slots2, row_slots: s.row_slots, row_fresh: s.row_fresh,
          unit_slots: s.unit_slots, unit_fresh: s.unit_fresh,
          kind_theories: s.kind_theories, unit_var_kinds: s.unit_var_kinds, rigid: s.rigid, rigid_rows: s.rigid_rows }
}


#[doc("Typer-internal helper `subst_row_lookup` shared across the infer modules.")]
pub fn subst_row_lookup(s: Subst, v: Int) : Option[Row] {
  # tolerate sentinel negative ids that `row_of_expr_with_binds`
  # emits when a row variable name was not resolved (e.g. an alias body
  # whose row tparam remained after alias expansion). Treat as unbound
  # instead of paniccing in `array_get`.
  if v < 0 { None }
  else if v >= array_length(s.row_slots) { None }
  else { array_get(s.row_slots, v) }
}


#[doc("Typer-internal helper `subst_row_extend` shared across the infer modules.")]
pub fn subst_row_extend(s: Subst, v: Int, r: Row) : Subst / Mutable {
  # A negative id is the unresolved-row-variable sentinel, not a slot:
  # `subst_row_lookup` reads it as unbound, so binding it is a no-op
  # rather than a write below index 0.
  if v < 0 { s } else {
    let len = array_length(s.row_slots)
    let rs1 = if v >= len {
      let grown = if v + 1 > len * 2 { v + 1 } else { len * 2 }
      array_grow(s.row_slots, grown, None)
    } else { s.row_slots }
    let rs2 = array_set(rs1, v, Some(r))
    Subst { slots: s.slots, row_slots: rs2, row_fresh: s.row_fresh,
            unit_slots: s.unit_slots, unit_fresh: s.unit_fresh,
            kind_theories: s.kind_theories, unit_var_kinds: s.unit_var_kinds, rigid: s.rigid, rigid_rows: s.rigid_rows }
  }
}


# Allocate a fresh row variable id and bump the counter. Returned in
# a record because kaikai stage 2 has no tuples.
#[doc("Typer-internal type `FreshRow` shared across the infer modules.")]
pub type FreshRow = { id: Int, subst: Subst }


#[doc("Typer-internal helper `subst_fresh_row` shared across the infer modules.")]
pub fn subst_fresh_row(s: Subst) : FreshRow {
  let id = s.row_fresh
  let s1 = Subst { slots: s.slots, row_slots: s.row_slots, row_fresh: id + 1,
                   unit_slots: s.unit_slots, unit_fresh: s.unit_fresh,
                   kind_theories: s.kind_theories, unit_var_kinds: s.unit_var_kinds, rigid: s.rigid, rigid_rows: s.rigid_rows }
  FreshRow { id: id, subst: s1 }
}


# unit-var substitution. UVar(n) into the parallel `unit_slots`
# array. Same growth/lookup discipline as the type-var slots.
#[doc("Typer-internal helper `subst_unit_lookup` shared across the infer modules.")]
pub fn subst_unit_lookup(s: Subst, v: Int) : Option[UnitExprT] {
  if v >= array_length(s.unit_slots) { None }
  else { array_get(s.unit_slots, v) }
}

