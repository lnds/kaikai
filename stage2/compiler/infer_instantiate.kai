#[doc("infer: resolve a type under a tparam binding, each nominal head stamped from `hv`.")]
pub fn resolve_ty_with_tparams(t: TypeExpr, binds: [TPBind], hv: TyHomeView) : Ty {
  match t.tkind {
    TyParam(id, tas) -> tparam_use(binds, id, resolve_tas_with(tas, binds, hv))
    TyName(th, tas) -> match undeclared_ty_named(ref_name(th), SnValue) {
      Some(t) -> t
      None ->
        if ref_is_cont(th) { tsh_tycon_at(hv, th, cont_full_args(th, resolve_cont_tas_with(tas, binds, hv))) }
        else { tsh_tycon_at(hv, th, resolve_tas_with(tas, binds, hv)) }
    }
    TyList(inner) -> list_ty(resolve_ty_with_tparams(inner, binds, hv))
    TyFn(ps, ret, rexpr) -> TyFnT(map(ps, (p) => resolve_ty_with_tparams(p, binds, hv)),
                                  resolve_ty_with_tparams(ret, binds, hv),
                                  closed_row_with_tparams(rexpr, binds, hv))
    # dimensioned types in this lighter resolver — without unit
    # variables — leave a unit tparam as the symbol it is named. Real
    # generic-unit resolution lives in resolve_ty_with_binds below.
    TyDim(base, u) -> dim_collapse(resolve_ty_with_tparams(base, binds, hv), unit_canon(unit_named(u, binds_of(binds))))
    # preserve refinement on the semantic side.
    TyRefine(base, p) -> TyRefineT(resolve_ty_with_tparams(base, binds, hv), p)
    # a compound row reaching *type* position (not dissolved
    # by alias substitution) — resolve to no declaration so the
    # natural "unknown type" cascade reports it.
    TyRow(_) -> TyCon(sym_none(), [])
    TySurface(_) -> panic("resolve_ty_with_tparams: surface type not lowered")
  }
}


# A row variable here has no binding that survives instantiation, so the
# row closes on its declared labels: a fresh tail per read would let a
# stored closure's extra effects escape the reader's row.
fn closed_row_with_tparams(re: RowExpr, binds: [TPBind], hv: TyHomeView) : Row = match re {
  REmpty             -> inf_row_empty()
  RClosed(labels)    -> Row { labels: row_labels_of_rls_with_binds(labels, binds, [], hv), tail: None, display_alias: None }
  ROpen(_, labels)   -> Row { labels: row_labels_of_rls_with_binds(labels, binds, [], hv), tail: None, display_alias: None }
}


fn resolve_tas_with(tas: [TypeExpr], binds: [TPBind], hv: TyHomeView) : [Ty] =
  map(tas, (t) => resolve_ty_with_tparams(t, binds, hv))


fn resolve_cont_tas_with(tas: [TypeExpr], binds: [TPBind], hv: TyHomeView) : [Ty] = match tas {
  [a, s, e] -> [resolve_ty_with_tparams(a, binds, hv), resolve_ty_with_tparams(s, binds, hv), inf_resolve_row_arg(e, hv)]
  _ -> resolve_tas_with(tas, binds, hv)
}


# Resolve a TypeExpr under both the type-parameter and row-variable
# binding contexts. A `TyName(name, [])` is first looked up as a
# tparam; if not found, the builtin / user-type fallback applies.
#
# The row-kind table `rk` makes a `T[..., e]` slot the type declares
# row-kind resolve to a row carrier — a row var, a single concrete
# effect, or a compound row equally. With `rk = []` only ctor-field row
# vars (in `rbinds`) and literal compound rows resolve to carriers.
#
# Each nominal type's module slot comes from `hv`, so a signature's
# `TyCon` carries the same home the record table gives a literal.
#[doc("Typer-internal helper `resolve_ty_with_binds` shared across the infer modules.")]
pub fn resolve_ty_with_binds(t: TypeExpr, tpbinds: [TPBind], rbinds: [RVBind], rk: [RowKindEntry], hv: TyHomeView) : Ty {
  match t.tkind {
    # A shape tparam applied to its single type argument forms `s[A]`.
    # A bare `s` (no args) is the unapplied shape variable. More than
    # one arg is an arity violation caught by the formation validator.
    TyParam(id, tas) -> tparam_use(tpbinds, id, map(tas, (a) => resolve_ty_with_binds(a, tpbinds, rbinds, rk, hv)))
    TyName(th, tas) -> match undeclared_ty_named(ref_name(th), SnValue) {
      Some(t) -> t
      None -> tsh_tycon_at(hv, th,
                           cont_full_args(th, resolve_tycon_args(tas, row_kind_slots_of(rk, th, hv), 0, tpbinds, rbinds, rk, hv)))
    }
    TyList(inner) -> TyListT(resolve_ty_with_binds(inner, tpbinds, rbinds, rk, hv))
    TyFn(fps, fret, rexpr) ->
      TyFnT(map(fps, (p) => resolve_ty_with_binds(p, tpbinds, rbinds, rk, hv)),
            resolve_ty_with_binds(fret, tpbinds, rbinds, rk, hv),
            row_of_expr_with_binds(rexpr, tpbinds, rbinds, hv))
    # dimensioned base — resolve the inner Ty against tpbinds,
    # then walk the unit and rewrite each use of a unit tparam
    # (`[u: Measure]`) to UVar(id).
    TyDim(base, u) ->
      dim_collapse(resolve_ty_with_binds(base, tpbinds, rbinds, rk, hv),
                   unit_canon(unit_resolve_tparams(u, tpbinds)))
    # preserve refinement on the semantic side.
    TyRefine(base, p) -> TyRefineT(resolve_ty_with_binds(base, tpbinds, rbinds, rk, hv), p)
    # a compound row reaching *type* position (not dissolved
    # by alias substitution). Resolve to no declaration so the
    # natural "unknown type" cascade reports it.
    TyRow(_) -> TyCon(sym_none(), [])
    TySurface(_) -> panic("resolve_ty_with_binds: surface type not lowered")
  }
}


# Resolve a `TyCon`'s argument list, threading the parent type's
# row-kind slot indices: a slot whose index is in `idxs` resolves to a
# row carrier.
fn resolve_tycon_args(tas: [TypeExpr], idxs: [Int], i: Int,
                      tpbinds: [TPBind], rbinds: [RVBind], rk: [RowKindEntry], hv: TyHomeView) : [Ty] {
  match tas {
    [] -> []
    [a, ...rest] -> {
      let resolved = resolve_tycon_arg(a, list_has_int(idxs, i), tpbinds, rbinds, rk, hv)
      [resolved, ...resolve_tycon_args(rest, idxs, i + 1, tpbinds, rbinds, rk, hv)]
    }
  }
}


# Resolve a single `TyCon` argument slot. When `is_row` (the parent
# declares this slot row-kind) a row var, a single concrete effect, or
# a compound row all resolve to a carrier so the slot threads the
# effect row. A ctor-field row var also resolves to a carrier off
# `rbinds`, table-independent. The carrier shares its row-var id with
# the ctor field's `/ e`, so the head slot and the function row are the
# same generalised row var.
fn resolve_tycon_arg(t: TypeExpr, is_row: Bool, tpbinds: [TPBind], rbinds: [RVBind], rk: [RowKindEntry], hv: TyHomeView) : Ty {
  match t.tkind {
    TyParam(p, []) -> match inf_rvbind_lookup(rbinds, p) {
      Some(id) -> row_arg_carrier(row_with_tail(id))
      None     -> if is_row { inf_resolve_row_arg(t, hv) }
                  else { resolve_ty_with_binds(t, tpbinds, rbinds, rk, hv) }
    }
    TyName(_, []) ->
      if is_row { inf_resolve_row_arg(t, hv) }
      else { resolve_ty_with_binds(t, tpbinds, rbinds, rk, hv) }
    TyRow(rexpr) -> row_arg_carrier(row_of_expr_with_binds(rexpr, tpbinds, rbinds, hv))
    _ -> resolve_ty_with_binds(t, tpbinds, rbinds, rk, hv)
  }
}


# A parsed row whose open tail binds through `rbinds` and whose label
# ty_args (`Reader[T]`) resolve under the fn-level `tpbinds`.
#[doc("Typer-internal helper `row_of_expr_with_binds` shared across the infer modules.")]
pub fn row_of_expr_with_binds(re: RowExpr, tpbinds: [TPBind], rbinds: [RVBind], hv: TyHomeView) : Row {
  match re {
    REmpty -> inf_row_empty()
    RClosed(labels) -> Row {
      labels: row_labels_of_rls_with_binds(labels, tpbinds, rbinds, hv),
      tail: None,
      display_alias: None
    }
    ROpen(rv, labels) -> Row {
      labels: row_labels_of_rls_with_binds(labels, tpbinds, rbinds, hv),
      tail: match inf_rvbind_lookup(rbinds, tail_id(rv)) {
        Some(id) -> Some(id)
        None     -> Some(-1)
      },
      display_alias: None
    }
  }
}


#[doc("Typer-internal helper `row_labels_of_rls_with_binds` shared across the infer modules.")]
pub fn row_labels_of_rls_with_binds(ls: [RowLabel], tpbinds: [TPBind], rbinds: [RVBind],
                                hv: TyHomeView) : [Label] {
  match ls {
    [] -> []
    [rl, ...rest] -> match rl {
      RL(r, ts) -> [
        row_label(ref_sym(r), map(ts, (te) => resolve_ty_with_binds(te, tpbinds, rbinds, [], hv))),
        ...row_labels_of_rls_with_binds(rest, tpbinds, rbinds, hv)
      ]
    }
  }
}


# The declared type parameters among `binds`: a unit or shape parameter
# ranges over its own kind and stays flexible.
# An annotation written in a body: the enclosing fn's declared type
# parameters name their own vars there, as they do in its signature.
#[doc("Typer-internal helper `st_annot_ty` shared across the infer modules.")]
pub fn st_annot_ty(st: InferState, te: TypeExpr) : Ty = match rigid_binds(st.sub.rigid) {
  []    -> inf_resolve_ty_rk(te, st.env.row_kind, st_home_view(st))
  binds -> resolve_ty_with_binds(te, binds, [], st.env.row_kind, st_home_view(st))
}


# `start` must exceed every bound-var id in `vars`, otherwise the
# substitution would map a bound id to itself (e.g. `SB(0, TyVarT(0))`
# when env.fresh=0 and vars=[0]) and apply_ty would loop forever. By
# clamping up to `max(vars) + 1`, fresh vars never alias any bound id.
#[doc("Typer-internal helper `instantiate` shared across the infer modules.")]
pub fn instantiate(env: TyEnv, sc: TyScheme) : Instantiated {
  match sc {
    Scheme(vars, _, _, _, body) -> {
      let n = list_length(vars)
      let need = if n == 0 { 0 } else { max_id_loop(vars, 0) + 1 }
      let start = if env.fresh >= need { env.fresh } else { need }
      let env1 = TyEnv { ...env, fresh: start + n }
      let sub = mk_fresh_subst(vars, start)
      Instantiated { env: env1, ty: apply_ty(sub, body) }
    }
  }
}


# mark that the current body has performed an op
# of `eff` with the given type-arg instantiation. Labels with the same
# `eff` but non-unifiable ty_args are kept distinct so a body can perform
# e.g. `Reader[Int]` and `Reader[String]` and have both flow through.
#[doc("Typer-internal helper `st_add_label` shared across the infer modules.")]
pub fn st_add_label(st0: InferState, lab: Label, line: Int, col: Int) : InferState / Mutable {
  let j = st_join_label(st0, lab)
  let st = j.st
  if not j.added { st }
  else {
    InferState { ...st, eff_uses: [EU(lab, line, col), ...st.eff_uses] }
  }
}


# Unify a cell op's label ty_args against an existing same-cell label
# before `st_add_label`'s pure dedup drops one of them. The dedup treats a
# fresh tyvar as unifiable but never propagates the binding, so a fresh
# payload tyvar (a `State.get` return) would stay free unless the concrete
# arg an earlier op pinned (`State.set`'s value) is threaded here.
#
# Gated on the label's cell: a cell's ops all share one state type by
# construction of its handler, so forcing the unification is sound. Effects
# WITHOUT an alias may carry two independent instances in the row
# (`Actor[Request]` + `Actor[Reply]`); those key by concrete args
# and must NOT have their args cross-bound — the shallow-unifiable check is
# too lax a precondition for them (a free arg "unifies" with any concrete
# one). So only same-cell labels are threaded.
#[doc("Typer-internal helper `st_unify_dedup_label` shared across the infer modules.")]
pub fn st_unify_dedup_label(st: InferState, lab: Label, line: Int, col: Int) : InferState / Console + File + Mutable =
  if not label_is_aliased_cell(lab) { st }
  else {
    match find_unifiable_label_args(st.row, lab, st.sub) {
      Some(existing_args) -> st_unify_ty_args(st, existing_args, lab.ty_args, line, col)
      None                -> st
    }
  }


fn find_unifiable_label_args(row: [Label], target: Label, s: Subst) : Option[[Ty]] {
  match row {
    [] -> None
    [h, ...rest] ->
      if label_same(h, target) and labels_args_unify(h.ty_args, target.ty_args, s) {
        Some(h.ty_args)
      } else { find_unifiable_label_args(rest, target, s) }
  }
}


fn st_unify_ty_args(st: InferState, a: [Ty], b: [Ty], line: Int, col: Int) : InferState / Console + File + Mutable =
  match a {
    [] -> st
    [ah, ...arest] -> match b {
      [] -> st
      [bh, ...brest] ->
        st_unify_ty_args(st_unify(st, ah, bh, "shared effect label", line, col), arest, brest, line, col)
    }
  }


# Fold `st_add_label` over a list of labels. Used by `synth_call` to
# propagate every label the callee declared into the caller's row, so
# `inferred_main_row` sees effects reached transitively via helpers.
fn st_add_labels(st: InferState, labels: [Label], line: Int, col: Int) : InferState / Mutable = match labels {
  []           -> st
  [h, ...rest] -> st_add_labels(st_add_label(st, h, line, col), rest, line, col)
}


# Every label of a callee's row flows into the caller's row.
#[doc("Typer-internal helper `st_propagate_capability_labels` shared across the infer modules.")]
pub fn st_propagate_capability_labels(st: InferState, callee_ty: Ty,
                                   line: Int, col: Int) : InferState / Mutable {
  match callee_ty {
    TyFnT(_, _, row) -> st_add_row_tail(st_add_labels(st, capability_labels_only(row.labels), line, col), row.tail, line, col)
    _ -> st
  }
}


#[doc("Typer-internal helper `st_unify` shared across the infer modules.")]
pub fn st_unify(st: InferState, a: Ty, b: Ty, what: String, line: Int, col: Int) : InferState / Console + File + Mutable {


  match unify_env(st.env, a, b, st.sub) {
    Some(s2) -> st_set_sub(st, s2)
    None -> {
      let a1 = apply_ty(st.sub, a)
      let b1 = apply_ty(st.sub, b)
      # bounded subtyping for `T <: U` when `U`
      # is a `type U = A | B | ...` decl whose variants list contains
      # `T` as a component name. The upcast is the implicit promotion
      # described in `docs/unions-design.md` Decision 3 — a value of a
      # component type is usable wherever the union is expected. We
      # accept it after the symmetric `unify` failed, with no
      # substitution side-effects: the runtime layout is identical.
      if union_upcast_ok(st.env, a1, b1) { st }
      else { match rigid_either(st, a, b) {
        Some(RigidWhy(msg, help)) -> st_bump_err(st_help(st_push_diag(st, mk_diag(SevError, st.file, line, col, msg, [])), help))
        None -> {
        let d = mk_diag(SevError, st.file, line, col, "type mismatch in #{what}", [])
        st_bump_err(st_type_hint(st_union_aware_notes(st_push_diag(st, d), a1, b1), a1, b1))
        }
      } }
    }
  }
}


fn rigid_either(st: InferState, a: Ty, b: Ty) : Option[RigidWhy] / Mutable = match rigid_forced(st, a, b) {
  Some(w) -> Some(w)
  None    -> rigid_row_forced(st, a, b)
}


# A declared row variable stands for whatever effects the callers choose, so
# a pure function type cannot take its place: the unification that fails
# here succeeds once the declared rows are let go.
fn rigid_row_forced(st: InferState, a: Ty, b: Ty) : Option[RigidWhy] / Mutable = match st.sub.rigid_rows {
  [] -> None
  _  -> match unify_env(st.env, a, b, subst_with_rigid_rows(st.sub, [])) {
    None    -> None
    Some(_) -> Some(rigid_row_why(sig_row_name(st)))
  }
}


fn rigid_row_why(name: Option[String]) : RigidWhy = match name {
  Some(n) -> RigidWhy("a function that may perform effects is used where a pure function type is expected: the row variable `#{n}` declared on the enclosing function stands for any effects its callers choose",
                      "widen the expected function type with the row (`/ #{n}`), or handle the effect before this point")
  None    -> RigidWhy("a function that may perform effects is used where a pure function type is expected: a row variable declared on the enclosing function stands for any effects its callers choose",
                      "widen the expected function type with the row, or handle the effect before this point")
}


# The enclosing signature's row variable by its written name, when it declares exactly one.
fn sig_row_name(st: InferState) : Option[String] = match st.sig_rows {
  [RVB(n, _)] -> Some(tbs_text_of(st.sig_tps, n))
  _           -> None
}


fn rigid_forced(st: InferState, a: Ty, b: Ty) : Option[RigidWhy] / Mutable = match st.sub.rigid {
  [] -> None
  rs -> match unify_env(st.env, a, b, subst_with_rigid(st.sub, [])) {
    None     -> None
    Some(s2) -> rigid_first_bound(st, rs, rs, s2)
  }
}


fn rigid_first_bound(st: InferState, rs: [RigidTv], all: [RigidTv], s2: Subst) : Option[RigidWhy] = match rs {
  [] -> None
  [RigidTv(i, b, owner), ...rest] -> match apply_ty(s2, TyVarT(i)) {
    TyVarT(j) -> match rigid_named(all, j, i) {
      Some("") -> Some(rigid_text(rigid_name(b), owner, "another type parameter"))
      Some(o)  -> Some(rigid_text(rigid_name(b), owner, concat_all(["`", o, "`"])))
      None    -> rigid_first_bound(st, rest, all, s2)
    }
    t -> Some(rigid_text(rigid_name(b), owner, concat_all(["`", inf_ty_to_string_ow(st.env.tab, st.env.head_owners, t), "`"])))
  }
}


# Walk `callee_ty` and `arg_tys` in lockstep; return the 1-indexed
# position of the first argument whose type fails to unify against
# the corresponding parameter, or None if the mismatch is elsewhere
# (arity differs, or it's a return-type / row mismatch).
fn first_failing_arg(env: TyEnv, sub: Subst, callee_ty: Ty,
                       arg_tys: [Ty]) : Option[Int] / Mutable {
  match callee_ty {
    TyFnT(params, _ret, _row) -> {
      if list_length(params) == list_length(arg_tys) {
        first_failing_arg_loop(env, sub, params, arg_tys, 1)
      } else { None }
    }
    _ -> None
  }
}


fn first_failing_arg_loop(env: TyEnv, sub: Subst, params: [Ty],
                            args: [Ty], idx: Int) : Option[Int] / Mutable {
  match params {
    [] -> None
    [p, ...prest] -> match args {
      [] -> None
      [a, ...arest] -> {
        let p1 = apply_ty(sub, p)
        let a1 = apply_ty(sub, a)
        match unify_env(env, p1, a1, sub) {
          Some(_) -> first_failing_arg_loop(env, sub, prest, arest, idx + 1)
          None    -> if union_upcast_ok(env, p1, a1) {
            first_failing_arg_loop(env, sub, prest, arest, idx + 1)
          } else { Some(idx) }
        }
      }
    }
  }
}


# The notes under a "type mismatch in function call": the failing
# argument and the callee's signature.
fn call_mismatch_notes(env: TyEnv, sub: Subst, name_opt: Option[String],
                       callee_ty: Ty, arg_tys: [Ty], arg_exprs: [Expr],
                       file: String, line: Int, col: Int,
                       expected_shown: String) : [RelatedInfo] / Mutable {
  let resolved = apply_ty(sub, callee_ty)
  let failing = first_failing_arg(env, sub, resolved, arg_tys)
  let (al, ac) = arg_pos(arg_exprs, failing, line, col)
  let arg_notes = match failing {
    Some(idx) -> match name_opt {
      Some(nm) -> [ri_note(file, al, ac, "in argument #{int_to_string(idx)} of `#{nm}`")]
      None     -> [ri_note(file, al, ac, "in argument #{int_to_string(idx)}")]
    }
    None -> []
  }
  let sig_notes = match call_sig_note_text(env, name_opt, resolved, expected_shown) {
    Some(txt) -> [ri_note(file, line, col, txt)]
    None      -> []
  }
  list_append(arg_notes, sig_notes)
}


# A lone `.` argument is the identity function, which a caller who meant
# "the element" only learns from this help.
#[doc("Typer-internal helper `dot_identity_help` shared across the infer modules.")]
pub fn dot_identity_help(before: InferState, st: InferState, callee_ty: Ty,
                     arg_tys: [Ty], args_: [Expr]) : InferState / Console + Mutable =
  if st.errs == before.errs { st }
  else {
    let lone = match first_failing_arg(st.env, st.sub, apply_ty(st.sub, callee_ty), arg_tys) {
      Some(idx) -> match nth(args_, idx - 1) { Some(a) -> is_dot_identity(a)  None -> false }
      None      -> false
    }
    if lone { st_help(st, "a lone `.` argument is the function `(x) => x`; to call this once per element, make it a pipe stage (`xs | f(.)`) or name the element (`(x) => f(x)`)") }
    else { st }
  }


# Template 4 — when the callee's resolved type is a fn with
# a different parameter count than the call site supplied, emit a
# canonical "wrong number of arguments" diagnostic in place of the
# generic "type mismatch in function call". The arity check runs as
# a preflight before `st_unify` so we never produce both diagnostics
# for the same site.
#
# `arg_tys` is the list of inferred argument types at the call site.
# `callee_ty` is the callee's instantiated function type (typically
# `TyFnT(params, ret, row)` after `apply_ty`). When the callee is
# polymorphic and not yet resolved to a `TyFnT`, we fall through to
# the generic path.
fn arity_mismatch_of(sub: Subst, callee_ty: Ty, arg_tys: [Ty]) : Option[Int] {
  match apply_ty(sub, callee_ty) {
    TyFnT(params, _ret, _row) -> {
      let np = list_length(params)
      let na = list_length(arg_tys)
      if np == na { None } else { Some(np) }
    }
    _ -> None
  }
}


# Template 1 — wrapper around `st_unify` for call sites that
# want richer diagnostics. Preflights arity (Template 4) before
# delegating to `st_unify`; on failure, appends the argument-position
# + callee signature notes (Template 1) and the missing-effect notes
# (Template 5) when applicable.
#[doc("Typer-internal helper `st_unify_call` shared across the infer modules.")]
pub fn st_unify_call(st: InferState, callee: Expr, callee_ty: Ty,
                   arg_tys: [Ty], arg_exprs: [Expr], expected_fn_ty: Ty,
                   line: Int, col: Int) : InferState / Console + File + Mutable =
  st_unify_named(st, callee_display_name(st, callee), callee_ty, arg_tys, arg_exprs, expected_fn_ty, line, col)


# `st_unify_call` for a callee the notes name `who`: an operator has no
# callee node, only the text the user wrote.
#[doc("Typer-internal helper `st_unify_named` shared across the infer modules.")]
pub fn st_unify_named(st: InferState, who: Option[String], callee_ty: Ty,
                   arg_tys: [Ty], arg_exprs: [Expr], expected_fn_ty: Ty,
                   line: Int, col: Int) : InferState / Console + File + Mutable {
  let w = widen_call_args(st.env, st.sub, callee_ty, expected_fn_ty)
  unify_widened_call(st_set_sub(st, w.sub), who, callee_ty, arg_tys, arg_exprs, w.ty, line, col)
}

fn unify_widened_call(st: InferState, who: Option[String], callee_ty: Ty,
                      arg_tys: [Ty], arg_exprs: [Expr], expected_fn_ty: Ty,
                      line: Int, col: Int) : InferState / Console + File + Mutable {


  # Template 4 preflight: an arity mismatch produces a clearer
  # diagnostic than the generic "type mismatch in function call"
  # that `unify_list` would emit. We short-circuit so the caller's
  # error count still bumps and the rest of the pass keeps
  # progressing on the synthesised stub.
  let resolved_callee = apply_ty(st.sub, callee_ty)
  match arity_mismatch_of(st.sub, callee_ty, arg_tys) {
    Some(_np) -> {
      let d = build_wrong_arity_diag(st.env, st.file, who, resolved_callee, arg_tys, line, col)
      st_bump_err(st_push_diag(st, d))
    }
    None -> match rigid_row_call(st, who, callee_ty, arg_tys, arg_exprs, expected_fn_ty, line, col) {
      Some(st_row) -> st_row
      None -> {
      let pre_errs = st.errs
      let st1 = st_unify(st, callee_ty, expected_fn_ty, "function call", line, col)
      if st1.errs > pre_errs {
        # Mirrors the `expected:` note `st_unify` just attached, so the
        # trailing signature note can drop itself when it would repeat it.
        let expected_shown = inf_ty_to_string_ow(st1.env.tab, st1.env.head_owners, apply_ty(st1.sub, callee_ty))
        st_relate_all(st1, call_mismatch_notes(st1.env, st1.sub, who, callee_ty,
                                               arg_tys, arg_exprs, st1.file, line, col, expected_shown))
      } else { st1 }
      }
    }
  }
}


# The call whose argument is the effectful function a pure parameter rejects:
# names the argument, the parameter's pure type and the way out. A call that
# unifies keeps the substitution it built: the row slots are mutated in place,
# so discarding it would leave bindings behind the fresh-variable counter.
fn rigid_row_call(st: InferState, who: Option[String], callee_ty: Ty, arg_tys: [Ty], arg_exprs: [Expr], expected_fn_ty: Ty,
                  line: Int, col: Int) : Option[InferState] / Console + File + Mutable =
  if st.sub.rigid_rows == [] { None }
  else { match unify_env(st.env, callee_ty, expected_fn_ty, st.sub) {
    Some(s2) -> Some(st_set_sub(st, s2))
    None     -> rigid_row_rejection(st, who, callee_ty, arg_tys, arg_exprs, expected_fn_ty, line, col)
  } }


fn rigid_row_rejection(st: InferState, who: Option[String], callee_ty: Ty, arg_tys: [Ty], arg_exprs: [Expr], expected_fn_ty: Ty,
                       line: Int, col: Int) : Option[InferState] / Console + File + Mutable =
  match rigid_row_forced(st, callee_ty, expected_fn_ty) {
    None -> None
    Some(RigidWhy(msg, help)) -> {
      let resolved = apply_ty(st.sub, callee_ty)
      let idx = rigid_row_pure_arg(st, resolved, arg_tys)
      let notes = match idx {
        Some(i) -> [rigid_row_arg_note(st.env, who, resolved, i)]
        None    -> []
      }
      let (al, ac) = arg_pos(arg_exprs, idx, line, col)
      let rel = list_append(map(notes, (n) => ri_note(st.file, al, ac, n)), [ri_help(st.file, al, ac, help)])
      Some(st_bump_err(st_push_diag(st, mk_diag(SevError, st.file, al, ac, msg, rel))))
    }
  }


# Where the 1-indexed argument starts, else the call.
fn arg_pos(arg_exprs: [Expr], idx: Option[Int], line: Int, col: Int) : (Int, Int) = match idx {
  Some(i) -> match nth(arg_exprs, i - 1) {
    Some(a) -> (a.line, a.col)
    None    -> (line, col)
  }
  None -> (line, col)
}


fn rigid_row_pure_arg(st: InferState, callee_ty: Ty, arg_tys: [Ty]) : Option[Int] / Mutable =
  match first_failing_arg(st.env, st.sub, callee_ty, arg_tys) {
    Some(i) -> Some(i)
    None    -> match callee_ty {
      TyFnT(ps, _, _) -> first_pure_fn_param(ps, 1)
      _               -> None
    }
  }


fn first_pure_fn_param(ps: [Ty], idx: Int) : Option[Int] = match ps {
  []           -> None
  [p, ...rest] -> match p {
    TyFnT(_, _, row) -> if row.labels == [] and row.tail == None { Some(idx) } else { first_pure_fn_param(rest, idx + 1) }
    _                -> first_pure_fn_param(rest, idx + 1)
  }
}


fn rigid_row_arg_note(env: TyEnv, who: Option[String], callee_ty: Ty, idx: Int) : String = {
  let param = match callee_ty {
    TyFnT(ps, _, _) -> match nth(ps, idx - 1) {
      Some(p) -> concat_all([" is pure (`", inf_ty_to_string_ow(env.tab, env.head_owners, p), "`)"])
      None    -> " is pure"
    }
    _ -> " is pure"
  }
  match who {
    Some(nm) -> concat_all(["argument ", int_to_string(idx), " of `", nm, "`", param])
    None     -> concat_all(["argument ", int_to_string(idx), param])
  }
}


#[doc("Typer-internal helper `st_instantiate` shared across the infer modules.")]
pub fn st_instantiate(st: InferState, sc: TyScheme) : StTy / Mutable {
  let r = st_instantiate_report(st, sc)
  ty_res(r.st, r.ty)
}


#[doc("Typer-internal helper `st_instantiate_report` shared across the infer modules.")]
pub fn st_instantiate_report(st: InferState, sc: TyScheme) : TyInstRes / Mutable {
  match sc {
    Scheme(vars, rvars, uvars, ukinds, _) -> {
      let n = list_length(vars)
      let need = if n == 0 { 0 } else { max_id_loop(vars, 0) + 1 }
      let start = if st.env.fresh >= need { st.env.fresh } else { need }
      let inst = instantiate(st.env, sc)
      let fresh = range_ids(start, start + n)
      # also fresh-instantiate row vars. The temp substitution
      # rewrites each bound row-var id to a fresh one drawn from the
      # inferencer's row_fresh counter; we apply it once to the body
      # produced by `instantiate` (which rewrote type vars only) and
      # propagate the bumped row_fresh into the returned state.
      let st_env = st_set_env(st, inst.env)
      let mid = match rvars {
        [] -> TyInstRes { st: st_env, ty: inst.ty, fresh: fresh, unit_fresh: [] }
        _  -> {
          let frs = mk_fresh_row_subst(rvars, st_env.sub)
          let body1 = apply_ty(frs.temp, inst.ty)
          let st_out = st_set_sub(st_env, frs.sub)
          TyInstRes { st: st_out, ty: body1, fresh: fresh, unit_fresh: [] }
        }
      }
      # also fresh-instantiate unit-vars. Same shape as the
      # row-var step above but threaded through unit_slots.
      # capture the freshly-minted unit-var ids alongside
      # the type-var fresh ids so the call-site record can drive
      # per-unit specialisation downstream.
      match uvars {
        [] -> mid
        _  -> {
          let fus = mk_fresh_unit_subst(uvars, mid.st.sub)
          let body2 = apply_ty(fus.temp, mid.ty)
          # each fresh var inherits its scheme tparam's kind, so the
          # abelian pivot can refuse a cross-kind habitant bind.
          let sub2 = subst_add_unit_kinds(fus.sub, fus.fresh_ids, ukinds)
          let st_out2 = st_set_sub(mid.st, sub2)
          TyInstRes { st: st_out2, ty: body2, fresh: mid.fresh,
                      unit_fresh: fus.fresh_ids }
        }
      }
    }
  }
}


fn param_ty_or_fresh(st: InferState, pm: Param) : StTy {
  match pm.ptype {
    Some(te) -> ty_res(st, st_annot_ty(st, te))
    None     -> st_fresh_ty(st)
  }
}


fn add_infer_params_loop(st: InferState, ps: [Param], acc: [Ty]) : InferredParams {
  match ps {
    [] -> InferredParams { st: st, tys: list_reverse(acc) }
    [pm, ...rest] -> {
      let pr = param_ty_or_fresh(st, pm)
      let env2 = env_bind_local(pr.st.env, pm.binder, mono(pr.ty))
      let st2 = st_set_env(pr.st, env2)
      add_infer_params_loop(st2, rest, [pr.ty, ...acc])
    }
  }
}


#[doc("Typer-internal helper `add_infer_params` shared across the infer modules.")]
pub fn add_infer_params(st: InferState, ps: [Param]) : InferredParams = add_infer_params_loop(st, ps, [])


fn rec_field_tys(fs: [FieldDecl], binds: [TPBind], rbinds: [RVBind], rk: [RowKindEntry], hv: TyHomeView) : [FTy] {
  match fs {
    [] -> []
    [f, ...rest] -> match f {
      FD(_, nm, te, _) -> [FT(nm, rec_field_ty(te, binds, rbinds, rk, hv)), ...rec_field_tys(rest, binds, rbinds, rk, hv)]
    }
  }
}


# A record without a row-kind tparam keeps every field row closed on its
# declared labels.
fn rec_field_ty(te: TypeExpr, binds: [TPBind], rbinds: [RVBind], rk: [RowKindEntry], hv: TyHomeView) : Ty =
  match rbinds {
    [] -> resolve_ty_with_tparams(te, binds, hv)
    _  -> resolve_ty_with_binds(te, binds, rbinds, rk, hv)
  }


#[doc("Typer-internal helper `rec_instantiate` shared across the infer modules.")]
pub fn rec_instantiate(st: InferState, ri: RecInfo) : RecInst {
  match ri {
    RI(dsym, tps, fs, mo) -> {
      let start = st.env.fresh
      let n = list_length(tps)
      let env2 = advance_fresh(st.env, n)
      let binds = rec_tpbinds_loop(tps, start, 0, [])
      let rows = rec_row_binds(tps, row_names_of_fields(fs, []), st.sub, [])
      let flds = rec_field_tys(fs, binds, rows.binds, st.env.row_kind, env_home_view(st.env, mo))
      RecInst {
        st: st_set_sub(st_set_env(st, env2), rows.sub),
        result_ty: TyCon(dsym, rec_head_slots(tps, binds, rows.binds)),
        fields: flds
      }
    }
  }
}


# A read the resolver settled. The id names one declaration, so the
# scheme comes from it.
#[doc("Typer-internal helper `synth_sym_read` shared across the infer modules.")]
pub fn synth_sym_read(st: InferState, sy: SymId, e: Expr) : Inferred / Console + File + Mutable =
  match env_sym(st.env, sy) {
    Some(sc) -> {
      let r = st_instantiate_report(st, sc)
      let st2 = if r.fresh == [] and r.unit_fresh == [] { r.st }
                else { st_push_inst(r.st, CS(sy, e.line, e.col, r.fresh, r.unit_fresh, None)) }
      inferred_leaf(st2, r.ty, e)
    }
    None -> inferred_leaf(st, tag_union_ty(st, sy), e)
  }


# A read of a local binder.
# The effect a local's type is, when it is a capability.
#[doc("Typer-internal helper `cap_effect_of_local` shared across the infer modules.")]
pub fn cap_effect_of_local(st: InferState, l: LocalId) : Option[SymId] =
  match env_local(st.env, l) {
    Some(Scheme(_, _, _, _, ty)) -> match apply_ty(st.sub, ty) {
      TyCon(esym, _) -> if env_has_effect(st.env, esym) { Some(esym) } else { None }
      _              -> None
    }
    _ -> None
  }


# A lambda that reaches a capability bound outside it carries that capability's
# effect in its own row, so the closure cannot outlive the handler that provides it.
#[doc("Typer-internal helper `st_capture_label` shared across the infer modules.")]
pub fn st_capture_label(st: InferState, l: LocalId, line: Int, col: Int) : InferState / Mutable =
  if local_raw(l) <= 0 or local_raw(l) >= st.lam_floor { st }
  else { match env_local(st.env, l) {
    Some(Scheme(_, _, _, _, ty)) -> match apply_ty(st.sub, ty) {
      TyCon(esym, args) -> if env_has_effect(st.env, esym) { st_add_label(st, label_in_cell(esym, args, capture_cell()), line, col) } else { st }
      _                 -> st
    }
    _ -> st
  } }


#[doc("Typer-internal helper `synth_local_read` shared across the infer modules.")]
pub fn synth_local_read(st: InferState, l: LocalId, e: Expr) : Inferred / Console + File + Mutable =
  if names_clause_continuation(st, l) {
    let nm = local_name_in(st.env, l)
    let header = "`#{nm}` may only be called, not used as a value: it cannot escape its handler clause"
    let help_msg = "call the continuation directly, e.g. `#{nm}(v)`"
    let d = mk_diag(SevError, st.file, e.line, e.col, header, [ri_help(st.file, e.line, e.col, help_msg)])
    inferred_leaf(st_bump_err(st_push_diag(st, d)), TyAny, e)
  } else { match env_local(st.env, l) {
    Some(sc) -> {
      let r = st_instantiate_report(st, sc)
      inferred_leaf(st_capture_label(r.st, l, e.line, e.col), r.ty, e)
    }
    None -> inferred_leaf(st, TyAny, e)
  } }


# A mark types as the temporary the typer bound under its spelling, else
# as the primitive of that name.
#[doc("Typer-internal helper `synth_mark_read` shared across the infer modules.")]
pub fn synth_mark_read(st: InferState, m: Mark, e: Expr) : Inferred / Console + File + Mutable = {
  let l = local_minted(mark_name(m))
  match env_local(st.env, l) {
    Some(_) -> synth_local_read(st, l, e)
    None    -> synth_sym_read(st, builtin_sym(mark_name(m)), e)
  }
}


# An operation read as a value types as its declared scheme.
#[doc("Typer-internal helper `synth_op_read` shared across the infer modules.")]
pub fn synth_op_read(st: InferState, r: OpRef, e: Expr) : Inferred / Console + File + Mutable =
  match env_op(st.env, r.eff, r.op) {
    Some(sc) -> {
      let i = st_instantiate_report(st, sc)
      inferred_leaf(i.st, i.ty, e)
    }
    None -> inferred_leaf(st, TyAny, e)
  }


# The type is the one every dispatcher of `ss` has, so the call is typed
# whichever protocol answers. The end of the declaration is told of it.
#[doc("Typer-internal helper `op_unsettled` shared across the infer modules.")]
pub fn op_unsettled(st: InferState, ss: [SymId], line: Int, col: Int) : OpTyped / Mutable = {
  let c = op_common(st, ss, None)
  match c.ty {
    Some(t) -> OpTyped { st: st_push_deferred_hom(c.st, DOp(ss, t, line, col)), ty: c.ty }
    None    -> c
  }
}


# Each dispatcher's own type, unified. The state is past every
# instantiation whatever the answer.
fn op_common(st: InferState, ss: [SymId], ty: Option[Ty]) : OpTyped / Mutable = match ss {
  [] -> OpTyped { st: st, ty: ty }
  [s, ...rest] -> match env_sym(st.env, s) {
    None     -> OpTyped { st: st, ty: None }
    Some(sc) -> {
      let inst = st_instantiate_report(st, sc)
      match ty {
        None    -> op_common(inst.st, rest, Some(inst.ty))
        Some(t) -> match unify_env(inst.st.env, t, inst.ty, inst.st.sub) {
          Some(sub) -> op_common(st_set_sub(inst.st, sub), rest, ty)
          None      -> OpTyped { st: inst.st, ty: None }
        }
      }
    }
  }
}


# The one place the typer turns a written value name into an id. Every
# other site passes the name through and receives the declaration.
#
# A constructor is asked of the type first: when `expected` is a sum the
# name is looked up among that sum's own constructors, so a variant of a
# type the file never imports is reached and no homonym competes. A
# qualifier names its module, or the sum, outright; one that names
# neither leaves a constructor to the scope and a value to what the
# runtime builds. A bare name climbs the reader's scope over the classes
# `cs`: the nearest rung holding a candidate answers, alone or not at
# all. With no class to climb for, the type is the only voice.
#[doc("Typer-internal helper `settle_name` shared across the infer modules.")]
pub fn settle_name(st: InferState, q: Option[Written], w: Written, expected: Ty, cs: [NCls]) : Settled = {
  let name = written_text(w)
  match settle_list(ctors_of_type(st.env, ut_ty_sym(apply_ty(st.sub, expected)), name, 4)) {
    SetNone -> match q {
      None    -> settle_bare(st, name, cs)
      Some(m) -> match settle_qualified(st, written_text(m), name, cs) {
        SetNone -> if ncls_in(cs, NCFn) { settle_list(bound_syms(st.env, [builtin_sym(name)])) }
                   else { settle_bare(st, name, cs) }
        r       -> r
      }
    }
    r -> r
  }
}


# Core modules restating one name tie on a bare use. The expected function
# type picks the module owning its first parameter's head; otherwise the
# name's own default home answers. Never the order the modules were loaded in.
#[doc("Settles a tie between core declarations of a restated combinator read as a value: by the module owning the expected function type's first parameter, else the list module's.")]
pub fn settle_core_homonyms(st: InferState, expected: Ty, r: Settled) : Settled = match r {
  SetTie(ss) -> match sv_last_listed_core(st.env.tab, st_scope(st), ss) {
    None    -> r
    Some(_) -> match owner_of_expected_head(st, apply_ty(st.sub, expected), ss) {
      Some(s) -> SetOne(s)
      None    -> match bare_default_of(ss) {
        Some(s) -> SetOne(s)
        None    -> r
      }
    }
  }
  _ -> r
}


# type `variants[T]()` and validate T's shape.
# Constraints:
#   * T resolves to a TyCon (a named user-declared sum type).
#   * Every variant of T must be nullary (no payload).
# The first failure yields a single error; subsequent calls fall
# through to the TyAny stub so we don't cascade noise from one
# misuse.
#[doc("Typer-internal helper `synth_variants_of` shared across the infer modules.")]
pub fn synth_variants_of(st: InferState, ty_expr: TypeExpr, e: Expr) : Inferred / Console + File {


  let ty = st_annot_ty(st, ty_expr)
  match ty {
    TyCon(tsym, _) -> {
      let vc = check_variants_nullary(st.env, tsym)
      match vc {
        VCOk(ctors) -> {
          # Re-stamp the AST node with the constructors so codegen
          # has them without re-walking the env. Result type is
          # `[T]` (TyListT of TyCon).
          let result_ty = TyListT(TyCon(tsym, []))
          let resolved = with_ty(
            mk_expr(EVariantsOf(ty_expr, ctors), e.line, e.col),
            result_ty)
          mk_inferred(st, result_ty, resolved)
        }
        VCNotSum -> {
          let perr = mk_diag(SevError, st.file, e.line, e.col,
            "`variants[T]()` requires T to be a declared sum type", [])
          inferred_leaf(st_bump_err(st_help(st_note(st_push_diag(st, perr), "type: #{inf_ty_to_string(st.env.tab, ty)}"), "declare T as `type T = A | B | ...` or use a different builtin")), TyAny, e)
        }
        VCHasPayload(bad) -> {
          let bad_list = inf_join_with(map(bad, (c) => written_text(decl_name(st.env.tab, c))), ", ")
          let perr = mk_diag(SevError, st.file, e.line, e.col,
            "`variants[T]()` requires every variant of T to be nullary", [])
          inferred_leaf(st_bump_err(st_help(st_note(st_push_diag(st, perr), "variants of `#{decl_name(st.env.tab, tsym)}` with payload: #{bad_list}"), "`variants[T]()` lists the inhabitants of a closed sum; this is ill-defined when a variant carries arguments")), TyAny, e)
        }
      }
    }
    _ -> {
      let perr = mk_diag(SevError, st.file, e.line, e.col,
        "`variants[T]()` requires T to be a named user type", [])
      inferred_leaf(st_bump_err(st_help(st_note(st_push_diag(st, perr), "type: #{inf_ty_to_string(st.env.tab, ty)}"), "T must be a `type T = A | B | ...` declaration; built-ins (Int, String, [a], etc.) are not supported")), TyAny, e)
    }
  }
}


# Join `lab` into the row. A label that can only be one sibling IS that
# sibling: their arguments unify, so a type fixed later through either
# reaches both. A dedup that merely dropped `lab` would leave its own
# arguments unchecked against the row. Pinned instances that do not
# unify, or a label that could be any of several, stay separate labels.
#[doc("Typer-internal helper `st_join_label` shared across the infer modules.")]
pub fn st_join_label(st0: InferState, lab: Label) : LabelJoin / Mutable = {
  let st = st_set_row(st0, drop_phantom_twins(st0.row, lab))
  if label_is_phantom(lab) and any(st.row, (h) => label_same(h, lab)) { LabelJoin { st: st, added: false } }
  # Against a row that declares two instances it may be, an unpinned label
  # stays apart until a use pins it; joining a sibling would pick one by order.
  else if label_unpinned_among(st.decl_row, lab, st.sub) { LabelJoin { st: st_set_row(st, [lab, ...st.row]), added: true } }
  else { match filter(st.row, (h) => label_same(h, lab) and labels_args_unify(h.ty_args, lab.ty_args, st.sub)) {
    [twin] -> match unify_list(st.env, twin.ty_args, lab.ty_args, st.sub) {
      Some(s2) -> LabelJoin { st: st_set_sub(st, s2), added: false }
      None     -> LabelJoin { st: st_set_row(st, [lab, ...st.row]), added: true }
    }
    _ -> LabelJoin { st: st_set_row(st, [lab, ...st.row]), added: true }
  } }
}


#[doc("Typer-internal helper `st_add_bound_labels` shared across the infer modules.")]
pub fn st_add_bound_labels(st: InferState, t: Int, line: Int, col: Int) : InferState / Mutable = match subst_row_lookup(st.sub, t) {
  None    -> st
  Some(r) -> {
    let st1 = match r.labels {
      [] -> st
      ls -> st_add_labels(st, opt_labels_or(apply_labels_opt(st.sub, ls), ls), line, col)
    }
    match r.tail {
      Some(v) -> st_add_bound_labels(st1, v, line, col)
      None    -> st1
    }
  }
}


#[doc("Typer-internal helper `declared_candidates` shared across the infer modules.")]
pub fn declared_candidates(declared: [Label], target: Label, sub: Subst) : [Label] =
  filter(declared, (d) => label_same(d, target) and labels_args_unify(d.ty_args, target.ty_args, sub))


# `lab` has a part no use pinned yet and two declared instances could take it.
fn label_unpinned_among(declared: [Label], lab: Label, sub: Subst) : Bool =
  not label_is_phantom(lab) and any(lab.ty_args, (t) => ty_is_free_var(sub, apply_ty(sub, t)))
    and list_length(declared_candidates(declared, lab, sub)) > 1

