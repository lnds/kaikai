#[doc("Synthesis of call arguments, threading each declared parameter type through the walk.")]

import compiler.diag
import compiler.ast
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.unit_walk
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.infer_clause_holes
import compiler.infer_local_mutation
import compiler.infer_env_exhaust
import compiler.diag_type_text
import compiler.infer_apply
import compiler.infer_tparam_escape

#[doc("Synthesises each argument in order, threading the state through.")]
pub fn synth_many(st: InferState, es: [Expr]) : InferredList / Console + File + Mutable =
  synth_many_loop(st, es, [], [])

fn synth_many_loop(
  st: InferState,
  es: [Expr],
  tys: [Ty],
  exprs: [Expr]
) : InferredList / Console + File + Mutable = match es {
  [] -> InferredList { st: st, tys: list_reverse(tys), exprs: list_reverse(exprs) }
  [x, ...rest] -> {
    let r = w_synth(st, x)
    synth_many_loop(r.st, rest, [r.ty, ...tys], [r.expr, ...exprs])
  }
}

fn first_param_expected(st: InferState, param_tys: [Ty]) : Option[Ty] = match param_tys {
  [pt, ...] -> Some(apply_ty(st.sub, pt))
  _ -> None
}

fn vec_arg(st: InferState, x: Expr, exp: Option[Ty]) : Inferred / Console + File + Mutable =
  match exp {
    Some(et) -> w_check_against(st, x, et, "argument", x.line, x.col)
    None -> w_synth(st, x)
  }

fn lowered_arg(r: Inferred, exp: Option[Ty], st: InferState) : ExprTy =
  match exp {
    Some(et) -> maybe_lower_decimal_lit(r.expr, r.ty, et, mint_bigint_home(st.env))
    None -> ExprTy { expr: r.expr, ty: r.ty }
  }

# `synth_many` with the callee's declared params threaded per position.
# The expected type routes a Vec-context arg (literal / collect) through
# the bidirectional check, coins a dimensioned numeric literal to the
# parameter's declared carrier (`10.50<USD>` against `Decimal<USD>`), and
# names the record a bare literal head builds; every other arg keeps the
# plain synth path.
#[doc("Synthesises each argument against its declared parameter, lowering decimal literals to the parameter's carrier.")]
pub fn synth_many_vec_args(
  st: InferState,
  es: [Expr],
  param_tys: [Ty]
) : InferredList / Console + File + Mutable = synth_vec_args_loop(st, es, param_tys, [], [])

fn synth_vec_args_loop(
  st: InferState,
  es: [Expr],
  param_tys: [Ty],
  tys: [Ty],
  exprs: [Expr]
) : InferredList / Console + File + Mutable = match es {
  [] -> InferredList { st: st, tys: list_reverse(tys), exprs: list_reverse(exprs) }
  [x, ...rest] -> {
    let exp = first_param_expected(st, param_tys)
    let prest = params_after_first(param_tys)
    let r = vec_arg(st, x, exp)
    let lowered = lowered_arg(r, exp, st)
    synth_vec_args_loop(
      st_settle_arg(r.st, exp, lowered.ty, rest, prest),
      rest,
      prest,
      [lowered.ty, ...tys],
      [lowered.expr, ...exprs]
    )
  }
}

# `synth_many` with each argument's declared parameter in hand, where no
# other context rule applies: a record literal's head is asked of it.
#[doc("Synthesises each argument against its declared parameter type.")]
pub fn synth_many_expecting(
  st: InferState,
  es: [Expr],
  param_tys: [Ty]
) : InferredList / Console + File + Mutable = synth_expecting_loop(st, es, param_tys, [], [])

fn synth_expecting_loop(
  st: InferState,
  es: [Expr],
  param_tys: [Ty],
  tys: [Ty],
  exprs: [Expr]
) : InferredList / Console + File + Mutable = match es {
  [] -> InferredList { st: st, tys: list_reverse(tys), exprs: list_reverse(exprs) }
  [x, ...rest] -> {
    let exp = first_param_expected(st, param_tys)
    let r = vec_arg(st, x, exp)
    let prest = params_after_first(param_tys)
    synth_expecting_loop(
      st_settle_arg(r.st, exp, r.ty, rest, prest),
      rest,
      prest,
      [r.ty, ...tys],
      [r.expr, ...exprs]
    )
  }
}
