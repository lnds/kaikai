# Brand-transparency summaries for nursery fiber brands.
#
# A function is *brand-transparent* at parameter `i` when its result
# is syntactically the `i`-th parameter, so a branded fiber passed in
# comes back out unchanged. The brand-mismatch checker consults these
# summaries to follow a brand across a helper call instead of losing
# it at the call boundary.
#
# Transparency is decided on the resolved AST alone, keyed by the id of
# the function, so a homonym a call does not reach never lends its
# summary. Anything not provably a pass-through is opaque: the brand is
# not followed, and the checker warns rather than staying silent.

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.infer_index

# `BTOpaque` is the conservative default for every shape that is not
# provably a pass-through.
#[doc("Whether a function returns one of its parameters unchanged, and which one.")]
pub type BrandTransp = BTOpaque | BTParam(Int)

#[doc("A brand-transparency summary for one function: its id and which parameter (if any) it returns unchanged.")]
pub type BrandTranspRec = BTR(SymId, BrandTransp)

#[doc("Summarise every top-level fn as brand-transparent at a parameter index or opaque.")]
pub fn brand_transp_decls(ds: [Decl]) : [BrandTranspRec] {
  brand_transp_loop(ds, [])
}

fn brand_transp_loop(ds: [Decl], acc: [BrandTranspRec]) : [BrandTranspRec] {
  match ds {
    [] -> list_reverse(acc)
    [d, ...rest] -> brand_transp_loop(rest, brand_transp_decl(d, acc))
  }
}

fn brand_transp_decl(d: Decl, acc: [BrandTranspRec]) : [BrandTranspRec] {
  match d {
    DFn(_, fid, _, ps, _, _, body, _, _, _, _, _) ->
      [BTR(fnid_sym(fid), btr_transp_of_body(body, ps)), ...acc]
    _ -> acc
  }
}

# The result is the parameter index when the body reduces to a read of
# a parameter's binder. A rebinding is another binder, so a block whose
# tail reads the parameter's own id returns the argument.
fn btr_transp_of_body(body: Expr, ps: [Param]) : BrandTransp {
  match body.kind {
    ELocal(l) -> btr_param_index(ps, l, 0)
    EBlock(_, Some(t)) -> match t.kind {
      ELocal(l) -> btr_param_index(ps, l, 0)
      _         -> BTOpaque
    }
    _ -> BTOpaque
  }
}

fn btr_param_index(ps: [Param], l: LocalId, i: Int) : BrandTransp {
  match ps {
    [] -> BTOpaque
    [p, ...rest] -> if local_eq(p.binder.id, l) { BTParam(i) } else { btr_param_index(rest, l, i + 1) }
  }
}

# The summaries are read once per call site in the brand walk, so the
# table is bucketed by id rather than scanned. First-match wins, so a
# chain must keep table order: `idx_prepend_sym` builds newest-first,
# hence the back-to-front index build.
#[doc("Hash index from a function id to its brand-transparency summaries, in table order.")]
pub type BrandTranspIndex = { ix: NameIndex[BrandTranspRec] }

#[doc("Index brand-transparency summaries so a lookup does not scan them.")]
pub fn brand_transp_index(rs: [BrandTranspRec]) : BrandTranspIndex =
  BrandTranspIndex { ix: btr_add_rev(list_reverse(rs), idx_empty()) }

fn btr_add_rev(rev: [BrandTranspRec], ix: NameIndex[BrandTranspRec]) : NameIndex[BrandTranspRec] = match rev {
  []           -> ix
  [r, ...rest] -> match r {
    BTR(f, _) -> btr_add_rev(rest, idx_prepend_sym(ix, f, r))
  }
}

#[doc("Look up a function's brand-transparency summary by its id.")]
pub fn brand_transp_lookup(rs: BrandTranspIndex, f: SymId) : Option[BrandTransp] =
  match idx_chain_sym(rs.ix, f) {
    []                    -> None
    [BTR(_, t), ..._rest] -> Some(t)
  }

#[doc("Select the argument a brand-transparent callee returns, if the call supplies it.")]
pub fn transp_passthrough_arg(t: BrandTransp, args_: [Expr]) : Option[Expr] {
  match t {
    BTOpaque -> None
    BTParam(i) -> btr_nth_expr(args_, i)
  }
}

fn btr_nth_expr(xs: [Expr], i: Int) : Option[Expr] {
  match xs {
    [] -> None
    [h, ...rest] -> if i == 0 { Some(h) } else { btr_nth_expr(rest, i - 1) }
  }
}
