#[doc("The core builtins that reach the process, the console, the filesystem and libm.")]

import compiler.ast
import compiler.builtin_types
import compiler.builtin_sig

#[doc("The console and process builtins.")]
pub fn io_builtins() : [Builtin] = [
  # `exit` and `panic` never return: a polymorphic result unifies with any context.
  BF("print",             BRuntime, mono(fun_e([TyString], TyUnit, ["Stdout"]))),
  BF("eprint",            BRuntime, mono(fun_e([TyString], TyUnit, ["Stderr"]))),
  BF("write_stdout",      BRuntime, mono(fun_e([TyString], TyUnit, ["Stdout"]))),
  BF("panic",             BRuntime, poly([0], fun([TyString], tv(0)))),
  BF("exit",              BRuntime, poly([0], fun_e([TyInt], tv(0), ["Process"])))
]


#[doc("The Int/Real conversions and the libm bindings.")]
pub fn real_builtins() : [Builtin] = [
  BF("int_to_string",     BRuntime, mono(fun([TyInt], TyString))),
  BF("real_to_string",    BRuntime, mono(fun([TyReal], TyString))),
  BF("int_to_real",       BRuntime, mono(fun([TyInt], TyReal))),
  BF("real_to_int",       BRuntime, mono(fun([TyReal], TyInt))),
  BF("real_sqrt",         BRuntime, real1()),
  BF("real_cbrt",         BRuntime, real1()),
  BF("real_exp",          BRuntime, real1()),
  BF("real_log",          BRuntime, real1()),
  BF("real_log2",         BRuntime, real1()),
  BF("real_log10",        BRuntime, real1()),
  BF("real_sin",          BRuntime, real1()),
  BF("real_cos",          BRuntime, real1()),
  BF("real_tan",          BRuntime, real1()),
  BF("real_asin",         BRuntime, real1()),
  BF("real_acos",         BRuntime, real1()),
  BF("real_atan",         BRuntime, real1()),
  BF("real_sinh",         BRuntime, real1()),
  BF("real_cosh",         BRuntime, real1()),
  BF("real_tanh",         BRuntime, real1()),
  BF("real_signum",       BRuntime, real1()),
  BF("real_is_nan",       BRuntime, mono(fun([TyReal], TyBool))),
  BF("real_is_inf",       BRuntime, mono(fun([TyReal], TyBool))),
  BF("real_pow",          BRuntime, real2()),
  BF("real_atan2",        BRuntime, real2()),
  BF("real_rem",          BRuntime, real2())
]


#[doc("The process-environment and filesystem builtins.")]
pub fn fs_builtins() : [Builtin] = [
  BF("args",              BRuntime, mono(fun_e([], lst(TyString), ["Env"]))),
  # argv[0] is a pure read of a process-wide constant, so it carries no effect.
  BF("program_name",      BRuntime, mono(fun([], TyString))),
  # A stdlib wrapper spelled like the builtin it forwards to shadows it,
  # so this second spelling is the way in.
  BF("core_program_name", BRuntimeAs("kai_core_program_name"), mono(fun([], TyString))),
  BF("stdlib_path",       BRuntime, mono(fun([], TyString))),
  BF("abspath",           BRuntime, mono(fun([TyString], TyString))),
  BF("read_file",         BRuntime, mono(fun_e([TyString], res(TyString), ["File"]))),
  BF("write_file",        BRuntime, mono(fun_e([TyString, TyString], res(TyUnit), ["File"]))),
  BF("file_exists",       BRuntime, mono(fun_e([TyString], TyBool, ["File"]))),
  BF("file_delete",       BRuntime, mono(fun_e([TyString], res(TyUnit), ["File"]))),
  BF("file_rename",       BRuntime, mono(fun_e([TyString, TyString], res(TyUnit), ["File"]))),
  BF("file_read_bytes",   BRuntime, mono(fun_e([TyString], res(bytes()), ["File"]))),
  BF("file_write_bytes",  BRuntime, mono(fun_e([TyString, bytes()], res(TyUnit), ["File"]))),
  BF("dir_list_dir",      BRuntime, mono(fun_e([TyString], lst(TyString), ["File"]))),
  BF("dir_create_dir",    BRuntime, mono(fun_e([TyString], res(TyUnit), ["File"]))),
  BF("dir_remove_dir",    BRuntime, mono(fun_e([TyString], res(TyUnit), ["File"]))),
  BF("dir_walk",          BRuntime, mono(fun_e([TyString], lst(TyString), ["File"]))),
  BF("read_line",         BRuntime, mono(fun_e([], res(TyString), ["Stdin"]))),
  # A short read is end of stream: no Result wrapper.
  BF("read_bytes",        BRuntime, mono(fun_e([TyInt], TyString, ["Stdin"])))
]

