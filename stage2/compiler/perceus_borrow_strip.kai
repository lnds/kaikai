#[doc("""
Borrowed call slots: the dups a borrowing callee makes unnecessary are
stripped, and a container read only through borrowing prims is found.
""")]

import compiler.ast
import compiler.fnreg
import compiler.ast_map
import compiler.expr_positions
import compiler.perceus_payer
import compiler.perceus_lend_order
import compiler.consume_index
import compiler.fn_index
import compiler.borrow_map
import compiler.perceus_arg_reads
import compiler.core_builtins
import compiler.core_builtin_sets
import compiler.perceus_raw_slot
import compiler.perceus_reads
import compiler.perceus_body_reads
import compiler.perceus_move_sites
import compiler.name_ix
import compiler.symtab
import compiler.kinds
import compiler.ctor_ix
import compiler.perceus_preds
import compiler.perceus_move_lets

#[doc("""
A container read ONLY through borrowed-prim slots (never consumed by a
later owning use) has no consumer to release its ref. Borrowing every one
of its reads would leak it (and the drop-after-call wrap that would fix
that resets a raw sibling param's unbox scope in the C emitter). So such a
container keeps ALL its accesses CONSUMING — identical to the pre-borrow
behaviour: the runtime `array_get`/`array_length` decref reclaims it at
its final read, RC balances as before, no wrap.

The borrow WIN is the loop shape, where the container is re-threaded
through a consuming recursive call — there `borrowed` is discounted but
the consuming re-thread keeps `total > borrowed`, so the container is NOT
borrow-only and its `a[i]` reads ARE rewritten to the borrow variant.

Detection: a binder read outside lambdas, every such read a bare argument
in a borrowed slot, is read only through borrowed slots. `prim_bmap`
restricts to the seeded prims (a user borrow param, handled by the
scrutinee-wrap path, is not swept in); membership is the shadow gate.
""")]
pub fn pcs_collect_borrow_last_set(names: [Binder], body: Expr, prim_bmap: BorrowMap) : [Binder] = match names {
  [] -> []
  _  -> {
    let reads = pbr_slot_reads(body, (f) => pcs_borrow_lookup(prim_bmap, pcs_callee_key(f)))
    filter(names, (n) => pbr_only_lent(reads, n))
  }
}

#[doc("Borrowed parameter positions registered for the function `key`, or the empty list.")]
pub fn pcs_borrow_lookup(bmap: BorrowMap, key: FnId) : [Int] = bm_lookup(bmap, key)

#[doc("""
The slots `f` borrows, for a call that takes `nm` bare; no other call's
slots change what a walk tracking `nm` decides.
""")]
pub fn pcs_lent_slots(l: LocalId, f: Expr, xs: [Expr], bmap: BorrowMap) : [Int] =
  if pcs_any_arg_is_var(l, xs) { pcs_borrow_slots(bmap, f) } else { [] }

#[doc("An empty map answers no slot.")]
pub fn pcs_borrow_slots(bmap: BorrowMap, f: Expr) : [Int] = match bmap {
  BEmpty -> []
  _      -> bm_lookup(bmap, pcs_callee_key(f))
}

#[doc("""
Caller side: strip the __perceus_dup the rewrite put on an argument
that lands in a borrowed parameter slot of the callee. The callee
borrows (does not consume) so the caller need not dup → the incref is
removed. Uses the global borrow map keyed by callee identity; a raw param of
an unboxed callee is handled by `perceus_raw_slot.kai`.

`borrow_last` names are the containers whose sole use IS this borrow —
their prim access stays CONSUMING (no strip, no rename): the runtime
decref reclaims them in place, avoiding the exit-drop wrap that would
otherwise reset a raw sibling param's unbox scope. The borrow win lives
in the loop shape (container re-threaded, not last-use), which this
does not touch.
Context for the caller-side borrow strip.

`fns` — the function registry. A function passed by value in a borrowed
slot materialises a fresh `kai_closure` the callee borrows but no one
drops; it is marked `__perceus_owned_borrow` here for the emit to
balance after the call.

`no_wrap` — names whose bare (un-dup'd) reads are NOT owned moves even
at their last-use position: borrowed params (borrow-through), raw
scalars, the move/reuse binder sets, exit-dropped locals.

`raw_no_wrap` — the names of `no_wrap` whose bare read hands on no
reference in a raw slot either. A moved arm binder is not one: its move
delegates the release, and a raw slot takes a copy of the scalar.

`uses` — the rewrite's use records, so the strip can recognise a
SINGLE-use name: its one bare read is a MOVE by the dup predicate's
own rule, and in a borrowed slot that move has no taker — it is
marked `__perceus_owned_borrow` so the emit drops the ref after the
call. Multi-use names are never marked: their bare borrowed reads are
stripped dups (net-zero), and per-read reclassification is unsound
where sugar clones share one source position.
""")]
pub type StripCx = { bmap: BorrowMap, borrow_last: [Binder],
                 no_wrap: [Binder], raw_no_wrap: [Binder], uses: UseIx, fns: FnIndex, cores: SymSet }

#[doc("`e` with the dup stripped from each argument a borrowing callee slot takes.")]
pub fn pcs_strip_borrow_args_d(e: Expr, scx: StripCx) : Expr =
  Expr { kind: pcs_strip_borrow_kind(e.kind, scx),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn pcs_strip_borrow_kind(k: ExprKind, scx: StripCx) : ExprKind = match k {
  ECall(callee, args_) -> {
    let key = pcs_callee_key(callee)
    # The borrowing indirect call holds the closure it invokes in slot 0
    # without consuming it, so that slot must not take the dup-on-consume
    # while the rest keep the owned convention.
    if pcs_callee_borrows_slot0(callee) {
      let args2 = pcs_strip_args_at_d(args_, [0], 0, scx)
      ECall(pcs_strip_borrow_args_d(callee, scx), args2)
    } else {
    # A prim call whose container arg0 is its LAST borrowed use stays
    # consuming: suppress the dup strip and the rename so the runtime
    # decref reclaims the container. Earlier borrowed reads are rewritten.
    let keep_consuming = pcs_arg0_is_borrow_last(args_, scx.borrow_last) and
                         (match pcs_lending_form(callee) { Some(_) -> true None -> false })
    let positions = if keep_consuming { [] } else { pcs_borrow_lookup(scx.bmap, key) }
    let args2 = prs_mark_raw_moves(pcs_strip_args_at_d(args_, positions, 0, scx),
                                   prs_raw_arg_positions(callee, scx.fns), scx.raw_no_wrap, scx.uses)
    let callee2 = if keep_consuming { callee }
                  else { pcs_maybe_rename_borrow_prim(callee, positions) }
    ECall(pcs_strip_borrow_args_d(callee2, scx), args2)
    }
  }
  _ -> prc_map_expr_kind(k, (sub) => pcs_strip_borrow_args_d(sub, scx))
}

# The local arg0 reads, seeing through a dup wrap the rewrite may have
# placed. `None` if arg0 is not a (possibly dup-wrapped) bare local.
fn pcs_arg0_var_name(args_: [Expr]) : Option[LocalId] = match args_ {
  []          -> None
  [h, ...___] -> pcs_unwrap_dup_var(h)
}

fn pcs_unwrap_dup_var(e: Expr) : Option[LocalId] = match prc_peel_unit(e).kind {
  ELocal(l)       -> Some(l)
  ECall(f, inner) -> match f.kind {
    EMark(MkDup) -> match inner { [x] -> pcs_unwrap_dup_var(x) _ -> None }
    _            -> None
  }
  _ -> None
}

fn pcs_arg0_is_borrow_last(args_: [Expr], borrow_last: [Binder]) : Bool = match pcs_arg0_var_name(args_) {
  Some(l) -> pcs_has(borrow_last, l)
  None    -> false
}

fn pcs_maybe_rename_borrow_prim(callee: Expr, positions: [Int]) : Expr =
  if pcs_has_int(positions, 0) {
    match pcs_lending_form(callee) {
      Some(b) -> builtin_ref_at(b, callee)
      None    -> callee
    }
  } else { callee }

# The lending sibling of the builtin a callee names.
fn pcs_lending_form(callee: Expr) : Option[CoreBuiltin] = match builtin_ref(callee) {
  Some(b) -> builtin_lending_form(b)
  None    -> None
}

# A mark whose slot 0 holds a value it invokes rather than consumes.
fn pcs_callee_borrows_slot0(callee: Expr) : Bool = match callee.kind {
  EMark(MkApplyBorrow) -> true
  _                    -> false
}

#[doc("A callee's borrowed slots that take a boxed value.")]
pub fn pcs_boxed_borrow_slots(bmap: BorrowMap, fns: FnIndex, f: Expr) : [Int] = {
  let raw = prs_raw_arg_positions(f, fns)
  filter(pcs_borrow_slots(bmap, f), (i) => not pcs_has_int(raw, i))
}

#[doc("The function a callee expression names, by identity; the unresolved identity for a callee that names no declaration.")]
pub fn pcs_callee_key(callee: Expr) : FnId = match callee.kind {
  ESym(s, inst) -> FnId(s, inst)
  _             -> fnid_none()
}

#[doc("""
A callee that takes each argument slot for itself: a constructor. An
effect operation answers like one.
""")]
pub fn pcs_callee_is_ctor(tab: SymTab, f: Expr) : Bool = match f.kind {
  ESym(s, _) -> sym_is_ctor(tab, s)
  EOp(_)     -> true
  _          -> false
}

# For each arg: if its index is in `positions` (borrowed slot) and it is
# `__perceus_dup(x)`, strip to `x`. Recurse into every arg either way.
fn pcs_strip_args_at_d(args_: [Expr], positions: [Int], i: Int, scx: StripCx) : [Expr] = match args_ {
  []           -> []
  [a, ...rest] -> {
    let a1 = pcs_strip_borrow_args_d(a, scx)
    let borrowed_slot = pcs_has_int(positions, i)
    # Borrowed slot: strip the dup (callee borrows, no incref needed). A
    # freshly-materialised closure (a bare top-level fn name → kai_closure)
    # in a borrowed slot has no consumer, so the emit must drop its birth
    # ref after the call (#1130 rule 1): mark it `__perceus_owned_borrow`
    # for the emit to recognise. The mark is a plain arg wrapper (like
    # `__perceus_dup`), NOT an EBlock — the emit unwraps it and balances the
    # ref in a local C statement-expression, invisible to tcrec/TCO.
    # A bare read the rewrite classified as a MOVE takes the same mark:
    # its delegated release never happens in a borrowing callee.
    let a2 = if borrowed_slot {
               let s = pcs_strip_dup_wrap(a1)
               if pcs_arg_is_fn_ref(s, scx.fns, scx.cores) { prs_wrap_owned_borrow(s) }
               else if pcs_arg_is_owned_move(a1, scx) { prs_wrap_owned_borrow(s) }
               else if pcs_arg_is_owned_rvalue(s) { prs_wrap_owned_borrow(s) }
               else { s }
             }
             else { a1 }
    [a2, ...pcs_strip_args_at_d(rest, positions, i + 1, scx)]
  }
}

# A bare local argument (no dup wrap) holding a SINGLE-use value: the
# rewrite's dup rule moves a sole read raw, delegating the release to
# the callee — in a borrowed slot that transfer has no taker. Excludes
# `no_wrap` names (their bare reads balance elsewhere: borrow-through,
# skip/move sets, exit-dropped locals), lambda-blocked names, and
# unboxable-typed reads, which `prs_mark_raw_moves` handles at raw slots.
fn pcs_arg_is_owned_move(a: Expr, scx: StripCx) : Bool = match prc_peel_unit(a).kind {
  ELocal(l) ->
    if pcs_has(scx.no_wrap, l) { false }
    else if not pcs_fate_transfers(pcs_fate_of(l, scx.uses, false, false)) { false }
    else { match a.ty {
      Some(t) -> not (ty_is_unboxable_t(t) or ty_is_fixed_vec(t))
      None    -> false
    } }
  _ -> false
}

# A top-level fn or core builtin passed by value (the emit
# materialises a fresh `kai_closure`, like a lambda literal). A local/param
# is never marked — it is borrow-through or tracked, and dropping it would
# over-free.
fn pcs_arg_is_fn_ref(a: Expr, fns: FnIndex, cores: SymSet) : Bool = match a.kind {
  ESym(s, inst) -> match fnx_of_sym(fns, FnId(s, inst)) {
    Some(_) -> true
    None    -> sym_set_has(cores, s)
  }
  _             -> false
}

#[doc("True when the int list contains `t`.")]
pub fn pcs_has_int(xs: [Int], t: Int) : Bool = match xs {
  []           -> false
  [x, ...rest] -> if x == t { true } else { pcs_has_int(rest, t) }
}

#[doc("""
True iff every arg-slot use of `nm` in `e` lands in a CONSUMING param slot
of the callee (per cmap). ctor slots / match scrutinees / returns consume by
construction. A user-fn call whose slot for nm is NOT in the callee's
consume set → false (the callee borrows nm; moving it is unsound).
""")]
pub fn pcs_uses_only_consuming_slots(nm: Binder, e: Expr, cmap: ConsumeIndex, bm: BorrowMap, tab: SymTab) : Bool =
  pcs_consuming_slots_kind(nm, e.kind, cmap, bm, tab)

fn pcs_any_arg_is_lambda(xs: [Expr]) : Bool = match xs {
  []           -> false
  [h, ...rest] -> match h.kind { ELambda(_, _) -> true _ -> pcs_any_arg_is_lambda(rest) }
}

#[doc("True when `nm` is read in `e` outside a lambda.")]
pub fn pcs_name_in_expr(nm: Binder, e: Expr) : Bool = pcs_read_outside_lambda(nm, e)

fn pcs_name_in_exprs(nm: Binder, xs: [Expr]) : Bool = match xs {
  []           -> false
  [h, ...rest] -> pcs_name_in_expr(nm, h) or pcs_name_in_exprs(nm, rest)
}

fn pcs_consuming_slots_kind(nm: Binder, k: ExprKind, cmap: ConsumeIndex, bm: BorrowMap, tab: SymTab) : Bool = match k {
  ECall(f, xs) -> {
    # Higher-order conservatism: if ANY arg is a lambda, the call is a
    # higher-order combinator (map/filter/fold). The lambda may FIELD-READ
    # nm's elements (e.g. `map(args, (a) => desugar_interp_expr(a))` field-
    # reads each a), which the per-callee consume-map does not model — the
    # consume bit is about the LIST param, not its elements. Moving nm into
    # such a call corrupts the AST (the desugar_interp self-host infinite
    # recursion). Treat nm as non-consuming-safe whenever the call carries a
    # lambda arg, OR nm itself appears inside a lambda.
    if pcs_any_arg_is_lambda(xs) and (pcs_name_in_exprs(nm, xs) or pcs_name_in_expr(nm, f)) {
      false
    } else {
      pcs_consuming_slots_kind(nm, f.kind, cmap, bm, tab) and
        (if pcs_any_arg_is_var(nm.id, xs) { pcs_consuming_call_args(nm, f, xs, cmap, bm, tab) }
         else { pcs_consuming_args(nm, xs, [], false, 0, cmap, bm, tab) })
    }
  }
  EMatch(s, arms) -> {
    let s_ok = pcs_is_leaf_ref(s) or pcs_uses_only_consuming_slots(nm, s, cmap, bm, tab)
    s_ok and pcs_consuming_arms(nm, arms, cmap, bm, tab)
  }
  EField(x, _)    -> if pcs_is_leaf_ref(x) { not pcs_is_bare(nm.id, x) } else { pcs_uses_only_consuming_slots(nm, x, cmap, bm, tab) }
  EIndex(a, b)    -> (if pcs_is_leaf_ref(a) { not pcs_is_bare(nm.id, a) } else { pcs_uses_only_consuming_slots(nm, a, cmap, bm, tab) }) and
                      pcs_uses_only_consuming_slots(nm, b, cmap, bm, tab)
  # Intrinsics incref their args internally — no arg slot ever consumes.
  EIntrinsic(_, xs)   -> not pcs_name_in_exprs(nm, xs)
  ESurface(sf)        -> not pcs_name_in_exprs(nm, surface_children(sf))
  # Everything else scans its positions: a lambda capture is never
  # move-safe, an assert message blocks on mere presence (it only runs
  # on the aborting path), and the remaining roles apply the slot check.
  _ -> pcs_consuming_slots_ps(nm, xp_positions_kind(k), cmap, bm, tab)
}

#[doc("A reference read whole: a local or a declaration.")]
pub fn pcs_is_leaf_ref(e: Expr) : Bool = match e.kind {
  ELocal(_)  -> true
  ESym(_, _) -> true
  _          -> false
}

# The callee's slots matter only to a call that takes `nm` bare.
fn pcs_consuming_call_args(nm: Binder, f: Expr, xs: [Expr], cmap: ConsumeIndex, bm: BorrowMap, tab: SymTab) : Bool = {
  let key = pcs_callee_key(f)
  pcs_consuming_args(nm, xs, list_append(cix_lookup(cmap, key), pcs_borrow_lookup(bm, key)), pcs_callee_is_ctor(tab, f), 0, cmap, bm, tab)
}

fn pcs_consuming_slots_ps(nm: Binder, ps: [XPos], cmap: ConsumeIndex, bm: BorrowMap, tab: SymTab) : Bool = match ps {
  []                  -> true
  [XP(r, c), ...rest] ->
    (match r {
      XLam -> false
      XMsg -> not pcs_name_in_expr(nm, c)
      _    -> pcs_uses_only_consuming_slots(nm, c, cmap, bm, tab)
    }) and pcs_consuming_slots_ps(nm, rest, cmap, bm, tab)
}

fn pcs_consuming_args(nm: Binder, xs: [Expr], consumed: [Int], is_ctor: Bool, i: Int, cmap: ConsumeIndex, bm: BorrowMap, tab: SymTab) : Bool = match xs {
  []           -> true
  [h, ...rest] -> {
    let here = if pcs_is_bare(nm.id, h) { is_ctor or pcs_has_int(consumed, i) }
               else if pcs_is_leaf_ref(h) { true }
               else { pcs_uses_only_consuming_slots(nm, h, cmap, bm, tab) }
    here and pcs_consuming_args(nm, rest, consumed, is_ctor, i + 1, cmap, bm, tab)
  }
}

fn pcs_consuming_arms(nm: Binder, arms: [Arm], cmap: ConsumeIndex, bm: BorrowMap, tab: SymTab) : Bool = match arms {
  []           -> true
  [a, ...rest] -> match a {
    Arm(_, opt_g, b) ->
      (match opt_g { None -> true Some(g) -> pcs_uses_only_consuming_slots(nm, g, cmap, bm, tab) }) and
      pcs_uses_only_consuming_slots(nm, b, cmap, bm, tab) and pcs_consuming_arms(nm, rest, cmap, bm, tab)
  }
}

# The callee's consuming slots and whether it builds a constructor, as the
# last-use move check reads them.
fn pcs_slot_consumers(cmap: ConsumeIndex, tab: SymTab) : (Expr) -> ([Int], Bool) =
  (f) => (cix_lookup(cmap, pcs_callee_key(f)), pcs_callee_is_ctor(tab, f))

#[doc("The binders read twice or more whose last read lands in a consuming slot.")]
pub fn pcs_collect_move_last_set(binders: [Binder], body: Expr, uses: UseIx, cmap: ConsumeIndex, tab: SymTab) : [Binder] =
  match filter(binders, (nm) => pcs_read_count(nm.id, uses) >= 2) {
    []    -> []
    cands -> {
      let sites = pms_move_sites(body, pcs_slot_consumers(cmap, tab))
      filter(cands, (nm) => pcs_last_read_moves(nm.id, uses, sites))
    }
  }

fn pcs_last_read_moves(l: LocalId, uses: UseIx, sites: MoveSites) : Bool = match last_use_for(l, uses) {
  LuAt(ll, lc) -> pms_moves_at(sites, l, ll, lc)
  _            -> false
}

#[doc("One owning read on every path, every lend on that path over before it.")]
pub fn pcs_lends_end_first(nm: Binder, e: Expr, bmap: BorrowMap) : Bool =
  plo_moves_after_lends(nm, e, (f) => pcs_borrow_slots(bmap, f))

#[doc("""
Strip an outer dup wrap to expose the underlying expression, so a
post-perceus callee `dup(name)` reads as the pre-perceus `name`.
Returns the original expression unchanged when no wrap is present.
""")]
pub fn pcs_strip_dup_wrap(e: Expr) : Expr = match e.kind {
  ECall(callee, args_) -> match callee.kind {
    EMark(MkDup) -> match args_ {
      [inner] -> inner
      _       -> e
    }
    _ -> e
  }
  _ -> e
}

#[doc("""
Block-`let` binders whose single read transfers the birth ref. A `let`
owns what it binds (unlike an arm binder, which aliases the scrutinee
and needs the cons-cascade gate), so moving its lone read leaves no
orphan and needs no cascade analysis. Gates: exactly one plain read,
none in a lambda, the read unconditional (never behind a short-circuit or
branch edge, whose skipped path would leave the ref unpaid) and landing in
a consuming slot.
""")]
pub fn pcs_collect_move_last_lets(body: Expr, uses: UseIx, cmap: ConsumeIndex,
                              skip: [Binder], tab: SymTab) : [Binder] = match pcs_mll_expr(body, body, uses, cmap, skip, []) {
  []    -> []
  cands -> {
    let roles = pbr_role_reads(body)
    let sites = pms_move_sites(body, pcs_slot_consumers(cmap, tab))
    filter(cands, (nm) => pcs_mll_reached_once(nm, roles, uses, sites))
  }
}

fn pcs_mll_reached_once(nm: Binder, roles: NameIx[RoleRead], uses: UseIx, sites: MoveSites) : Bool =
  match pbr_roles_of(roles, nm) {
    (a, brc, blocked) -> a == 1 and brc == 0 and not blocked and pcs_last_read_moves(nm.id, uses, sites)
  }

#[doc("""
A user fn's borrowed positions; a borrowing prim keeps its own
consuming-last-use rule, so it lends no slot here.
""")]
pub fn pcs_user_borrow_slots(bmap: BorrowMap, callee: Expr) : [Int] = match pcs_lending_form(callee) {
  Some(_) -> []
  None    -> pcs_borrow_lookup(bmap, pcs_callee_key(callee))
}

#[doc("The positions of `bpos` whose parameter is not raw.")]
pub fn pcs_boxed_positions(bpos: [Int], params: [Param], raw: [Binder], i: Int) : [Int] = match params {
  []           -> []
  [p, ...rest] -> {
    let tl = pcs_boxed_positions(bpos, rest, raw, i + 1)
    if pcs_has_int(bpos, i) and not pcs_has(raw, p.binder.id) { [i, ...tl] } else { tl }
  }
}
