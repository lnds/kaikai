#[doc("""
Native effect lowering: handlers, operations, evidence and the landing pads an unwind enters.

Native landing pads: the blocks a trap's unwind enters on its way out of
a frame. A pad releases the boxed registers its `kai_pad_open` names and
resumes the unwind; every call emitted while it is open is an `invoke`
to it (`native_build_call`).

compiler/emit_native_fx.kai — effect-node emitters for the in-process
libLLVM native backend (KIR Lane 1.2 Parte B, effects subset 2a).

The pure walk (subset 1) aborted KInstall / KSetjmp / KPop / KPerform /
KResume / KFnClause via `nemit_unsupported`. This module fills them for
ONE-SHOT user handlers (no state, no `as`-alias, no builtin defaults yet).

The semantics are NOT invented here — they are PORTED from the
abandoned LLVM-text backend (`emit_llvm.kai`, parity lane #622), whose
`llvm_emit_handle` / `llvm_emit_op_dispatch` / `llvm_emit_clause_body`
are validated against the C-direct oracle. The translation is
string-`.ll` → C-API `kai_llvm_build_*`, the same mechanical shape the
pure walk used. The runtime contract (`kaix_evidence_*` / `kaix_cont_*`
/ `kai_jmpbuf_size` / `kaix_op_finish`) already ships in
`stage0/runtime_llvm.c`; only the `setjmp` itself the backend emits.

THE setjmp soundness rule (asu review): mem2reg must NOT run on a fn
containing a `setjmp` — a local written in the body path then read after
a longjmp would be register-promoted to a stale value (the LLVM analogue
of C99 §7.13.2.1 `volatile`). The native backend does NOT run mem2reg
today, so this is satisfied by construction. A future mem2reg lane MUST
exclude setjmp-bearing fns (the `examples/native/effect_discard.kai`
fixture is the regression guard — a resume-only fixture would false-green
the hazard since it never lands on the longjmp block).

Ev<Eff> layout (from the C-direct emit's `struct EvX`): a 3-field header
`{ handler_id (i64), env (ptr), state (ptr) }` then one op fn-ptr per op
in effect-declaration order, starting at field index 3. The walk builds
the Ev as a `[3 + nops x ptr]` alloca; the layout knowledge lives in the
`kaix_ev_*` runtime helpers, never as a struct-nominal type in IR.

compiler/emit_native_fx2.kai — the pass-2 effect-node emitters (the
install / setjmp / pop / perform / resume sequences) of the native
backend's effects subset. `emit_native_fx.kai` holds the pass-1 alloca
reservation + the handler-lookup helpers this module drives on.

Each emitter is a flat sequence of `kai_llvm_build_*` calls mirroring
the validated `emit_llvm.kai` shape (parity lane #622), but reading the
handle-frame allocas the pass-1 reservation registered (Ev / node /
jmp_buf / discard / cont) instead of emitting them inline — the walk's
"allocas only in entry" rule. All handles are captured in `let` bindings
(the handle-binder exclusion, `pcs_rhs_is_handle`) so the type-blind
kaic1 Perceus never drops a raw LLVM `Value*`.
""")]

import compiler.ast_ids
import compiler.core_types
import compiler.effect_instance
import compiler.emit_native_fn
import compiler.kir
import compiler.util

# Field index of the first op fn-ptr in an Ev blob (after the 3-field
# header handler_id / env / state).
pub fn nfx_op_base() : Int = 3

# --- handler lookup: op → clause-thunk symbol + field index ------------
#
# `KInstall(eff, sym, …)` names the handler decl; a `KPerform` names the
# effect and the op. Both resolve through the program's `[KHandlerDecl]`: the
# handler whose `sym` matches gives the op→thunk list (install side), and
# the op's position in that list gives its Ev field index (both sides).

pub fn nfx_find_handler(handlers: [KHandlerDecl], sym: String) : Option[KHandlerDecl] = match handlers {
  [] -> None
  [h, ...rest] -> if h.sym == sym { Some(h) } else { nfx_find_handler(rest, sym) }
}

pub fn nfx_find_handler_by_eff(handlers: [KHandlerDecl], esym: SymId) : Option[KHandlerDecl] = match handlers {
  [] -> None
  [h, ...rest] -> if sym_raw(h.eff_sym) == sym_raw(esym) { Some(h) } else { nfx_find_handler_by_eff(rest, esym) }
}

# The Ev field index of op `op` in `op_thunks` (nfx_op_base + position),
# or -1 if absent.
pub fn nfx_op_field(thunks: [KOpThunk], op: String, i: Int) : Int = match thunks {
  [] -> -1
  [KOT(nm, _, _), ...rest] -> if nm == op { nfx_op_base() + i } else { nfx_op_field(rest, op, i + 1) }
}

# --- register names for the install-frame allocas ----------------------
#
# KInstall reserves four allocas in the entry block (the walk's "allocas
# only in entry" rule): the Ev blob, the KaiEvidence node, the jmp_buf,
# and the discard slot. Each is registered in the ctx table under a name
# derived from the install-site SYM (`_kai_handler_<line>_<col>`), NOT the
# effect name: two nested handles of the SAME effect each own a distinct
# frame, so a per-effect name would dedup them onto one alloca and the
# second `kaix_evidence_push_with_jmp` would self-cycle the parent chain
# (`node->parent == node` → infinite lookup loop; refs #789). The `sym`
# mirrors emit_c's per-`({})` lexical `_node`/`_ev`/`_jmp`/`_discard`.

pub fn nfx_ev_reg(sym: String) : String = cat2("__ev_", sym)
pub fn nfx_node_reg(sym: String) : String = cat2("__node_", sym)
pub fn nfx_jmpbuf_reg(sym: String) : String = cat2("__jmpbuf_", sym)
# The clause-capture env array (mirror of emit_c's stack `_env` struct):
# one `ptr` slot per handle-union capture, filled by the install and
# pointed-to from Ev field 1. Stack-local to the install frame — sound
# under one-shot resume (the clauses run inside the handle's stmt-expr,
# which does not return until the body unwinds). A multi-shot / fiber-
# escaping resume would dangle this; the one-shot check in `kir_lower_fns`
# (`check_resume_one_shot`) is the structural guard that keeps it safe.
pub fn nfx_env_reg(sym: String) : String = cat2("__env_", sym)
# The discard slot is the value the longjmp lands with; the KIR discard
# block reads it as `KVar("__kai_discard_<sym>")` (kir_lower_walk.kai's
# `lower_handle_discard`), per install-SITE so nested same-effect handles
# do not clobber each other's landing value. This string MUST agree with
# that `KVar` name byte-for-byte.
pub fn nfx_discard_reg(sym: String) : String = cat2("__kai_discard_", sym)
# The KaiCont a KPerform allocates (one per fn body; this subset has a
# single perform per effectful fn).
pub fn nfx_cont_reg() : String = "__kai_cont"

# --- pass 1: reserve the install/perform allocas in the entry block ----
#
# `nemit_allocas` (emit_native_fn) covers the ordinary KIR registers
# (KLet/KStore binders). The effect frames need extra allocas the KIR does
# not name as registers; reserve them here, positioned at the entry head
# alongside the register allocas. Called from `nemit_fn_with` after
# `nemit_allocas`, before the param seed.

pub fn nemit_fx_allocas(ctx: Handle, f: KFn, handlers: [KHandlerDecl]) : Unit / Console = {
  nfx_alloca_blocks(ctx, handlers, f.blocks)
  # A clause's continuation is referenced as `KVar(kir_resume_reg())` (the
  # translator's fixed resume name), but the `PResume` param is collected
  # under its surface name (`resume`), so no resume alloca exists from
  # `collect_fn_specs`.
  # Reserve it here for a clause fn; the seed stores the LLVM `k` param into
  # it (see `nemit_seed_clause_params`). Both also need `__self`, which the
  # seed introduces without naming it as a KIR register.
  match f.kind {
    KFnClause -> { nfx_reserve_k(ctx); nfx_reserve_named(ctx, "__self") }
    # A cleanup has no `k` (it never resumes).
    KFnCleanup -> nfx_reserve_named(ctx, "__self")
    _ -> ()
  }
}

# Reserve the continuation register alloca for a clause body — a
# single boxed `ptr` cell the seed fills from the trailing LLVM param.
fn nfx_reserve_k(ctx: Handle) : Unit / Console = {
  let reg = kir_resume_reg()
  if native_ctx_reg_slot(ctx, reg) < 0 {
    let ka = llvm_build_alloca(native_ctx_b(ctx), native_ctx_ptrt(ctx), "k.addr")
    native_ctx_add_reg(ctx, reg, ka, 0)
    ()
  } else { () }
}

#[doc("Reserve a `ptr`-typed named register alloca in the entry head if absent (idempotent).")]
pub fn nfx_reserve_named(ctx: Handle, name: String) : Unit / Console = {
  if native_ctx_reg_slot(ctx, name) < 0 {
    let a = llvm_build_alloca(native_ctx_b(ctx), native_ctx_ptrt(ctx), cat2(name, ".addr"))
    native_ctx_add_reg(ctx, name, a, 0)
    ()
  } else { () }
}

fn nfx_alloca_blocks(ctx: Handle, handlers: [KHandlerDecl], bs: [KBlock]) : Unit / Console = match bs {
  [] -> ()
  [b, ...rest] -> { nfx_alloca_stmts(ctx, handlers, b.stmts); nfx_alloca_blocks(ctx, handlers, rest) }
}

fn nfx_alloca_stmts(ctx: Handle, handlers: [KHandlerDecl], ss: [KStmt]) : Unit / Console = match ss {
  [] -> ()
  [s, ...rest] -> { nfx_alloca_stmt(ctx, handlers, s); nfx_alloca_stmts(ctx, handlers, rest) }
}

# A KInstall reserves the Ev blob + node + jmp_buf + discard slot; a
# KLet/KDo whose op is a KPerform reserves the KaiCont. Everything else is
# a no-op for the alloca pass.
fn nfx_alloca_stmt(ctx: Handle, handlers: [KHandlerDecl], s: KStmt) : Unit / Console = match s {
  KInstall(_, sym, _, alias, env, _) -> { nfx_reserve_install(ctx, sym, nfx_find_handler(handlers, sym), list_length(env)); nfx_reserve_alias(ctx, alias) }
  KLet(_, _, op, _) -> nfx_alloca_op(ctx, op)
  KDo(op, _)        -> nfx_alloca_op(ctx, op)
  _                 -> ()
}

fn nfx_alloca_op(ctx: Handle, op: KOp) : Unit / Console = match op {
  KPerform(_, _, _, _, _) -> nfx_reserve_cont(ctx)
  _                 -> ()
}

# Reserve the four install-frame allocas, registered under per-install-SITE
# names (derived from `sym`, the handler-decl symbol — unique per `handle`
# site). The Ev blob is `[3 + nops x i64]` and the clause-capture env one
# slot per handle-union capture, both sized from the handler decl. The
# jmp_buf is runtime-sized via `kai_jmpbuf_size`. Each alloca is a `let`
# (handle-binder exclusion). Two nested handles of the same effect get
# distinct `sym`s → distinct allocas → distinct KaiEvidence nodes.
fn nfx_reserve_install(ctx: Handle, sym: String, h: Option[KHandlerDecl], env_slots: Int) : Unit / Console = {
  let p = native_ctx_ptrt(ctx)
  let cell = native_ctx_i64t(ctx)
  let evty = llvm_array_type(cell, nfx_op_base() + nfx_handler_ops(h))
  let ev = llvm_build_alloca(native_ctx_b(ctx), evty, cat2(nfx_ev_reg(sym), ".addr"))
  native_ctx_add_reg(ctx, nfx_ev_reg(sym), ev, -1)
  let node = llvm_build_alloca(native_ctx_b(ctx), llvm_array_type(cell, nfx_node_slots()), cat2(nfx_node_reg(sym), ".addr"))
  native_ctx_add_reg(ctx, nfx_node_reg(sym), node, -1)
  # Slot -1: a raw `Value*`, never an RC binder.
  let env = llvm_build_alloca(native_ctx_b(ctx), llvm_array_type(p, if env_slots > 1 { env_slots } else { 1 }), cat2(nfx_env_reg(sym), ".addr"))
  native_ctx_add_reg(ctx, nfx_env_reg(sym), env, -1)
  # `kai_jmpbuf_size() -> i64`: declare it i64-returning (NOT the all-boxed
  # `ptr()` `nemit_call0` assumes), then `alloca i8, i64 %size` — the array
  # count MUST be an integer, never a `ptr`.
  let jmpsz = ncall_sig0(ctx, "kai_jmpbuf_size", native_ctx_i64t(ctx))
  let jmpbuf = llvm_build_array_alloca(native_ctx_b(ctx), native_ctx_i32t(ctx), jmpsz, cat2(nfx_jmpbuf_reg(sym), ".addr"))
  native_ctx_add_reg(ctx, nfx_jmpbuf_reg(sym), jmpbuf, -1)
  # The discard slot is a single `ptr` cell, init NULL (the body path may
  # never longjmp; the discard block only loads it on the landing path).
  let disc = llvm_build_alloca(native_ctx_b(ctx), p, cat2(nfx_discard_reg(sym), ".addr"))
  native_ctx_add_reg(ctx, nfx_discard_reg(sym), disc, 0)
  let _s = llvm_build_store(native_ctx_b(ctx), llvm_const_null(p), disc)
  ()
}

# An install with no handler decl is refused at emit (`nemit_install`); one
# slot keeps its allocas well-formed until then.
fn nfx_handler_ops(h: Option[KHandlerDecl]) : Int = match h {
  Some(d) -> list_length(d.op_thunks)
  None    -> 1
}


# Reserve the id register of an aliased install (`with Eff as a`), `a`
# being the register the alias was bound to. It holds the freshly-minted
# handler_id (boxed) so an `op@a` perform resolves to THIS instance by id,
# not the innermost-by-name.
fn nfx_reserve_alias(ctx: Handle, alias: Option[String]) : Unit / Console = match alias {
  None -> ()
  Some(a) -> {
    let nm = nfx_alias_reg(a)
    if native_ctx_reg_slot(ctx, nm) < 0 {
      let al = llvm_build_alloca(native_ctx_b(ctx), native_ctx_ptrt(ctx), cat2(nm, ".addr"))
      native_ctx_add_reg(ctx, nm, al, 0)
      ()
    } else { () }
    # §6 named instances: also reserve the bare alias name as a first-class
    # capability VALUE — the evidence node itself, threadable into a call. A
    # `#<recv>` perform reads this register; the call site passes it as the
    # callee's capability parameter. Mirrors emit_c's `kai_<a> = &_node`.
    if native_ctx_reg_slot(ctx, a) < 0 {
      let cl = llvm_build_alloca(native_ctx_b(ctx), native_ctx_ptrt(ctx), cat2(a, ".cap.addr"))
      native_ctx_add_reg(ctx, a, cl, 0)
      ()
    } else { () }
  }
}

# The register an aliased install stashes its handler_id under, and an
# aliased perform reads back.
pub fn nfx_alias_reg(a: String) : String = kir_alias_id_reg(a)

# The KaiEvidence node buffer: `[11 x i64]` bounds sizeof(KaiEvidence), which
# `stage0/runtime_llvm.c` asserts.
pub(pkg) fn nfx_node_slots() : Int = 11

# Reserve the KaiCont an op dispatch initialises on the stack (`[8 x i32]`
# = 32 bytes = sizeof(KaiCont): status + env + fn + handler_id). One cont
# per fn body suffices for this one-shot subset (a second perform reuses
# it sequentially), so reserve at most once — `reg_slot` returns -1 when
# the register is absent (slot 0 marks it present).
fn nfx_reserve_cont(ctx: Handle) : Unit / Console = {
  if native_ctx_reg_slot(ctx, nfx_cont_reg()) < 0 {
    let cont = llvm_build_alloca(native_ctx_b(ctx), llvm_array_type(native_ctx_i32t(ctx), 8), cat2(nfx_cont_reg(), ".addr"))
    native_ctx_add_reg(ctx, nfx_cont_reg(), cont, 0)
    ()
  } else { () }
}

# --- KInstall: build the Ev blob + push the evidence -------------------
#
# Mirrors `emit_llvm.kai`'s install side: stamp `handler_id` (field 0) and
# each op fn-ptr (field 3 + i) into the Ev blob the pass-1 reservation
# alloca'd, then `kaix_evidence_push_with_jmp(node, eff, ev, jmp, discard)`
# so the op site can find the landing pad on a discard. `handlers` threads
# the program's handler decls so the op→clause-thunk map resolves.
pub fn nemit_install(ctx: Handle, eff: String, sym: String, init: Option[KVal], alias: Option[String],
                     env: [Option[String]], handlers: [KHandlerDecl]) : Unit / Console =
  match nfx_find_handler(handlers, sym) {
    None -> nemit_unsupported(ctx, cat2("KInstall: no handler decl for ", sym))
    Some(h) -> nemit_install_with(ctx, eff, sym, init, alias, env, h)
  }

# `eff` names the effect (the global string the runtime keys by-name lookups
# on); `sym` names the install SITE (which entry-block alloca holds THIS
# frame's Ev/node/jmp_buf/env). Two nested same-effect handles share `eff`
# but never `sym`, so each pushes its own KaiEvidence node (no #789 cycle).
fn nemit_install_with(ctx: Handle, eff: String, sym: String, init: Option[KVal], alias: Option[String],
                      env: [Option[String]], h: KHandlerDecl) : Unit / Console = {
  let ev = native_ctx_find_reg(ctx, nfx_ev_reg(sym))
  # handler_id = kaix_fresh_handler_id() : i64; store into Ev field 0.
  # (i64-returning — NOT the all-boxed `ptr()` `nemit_call0` assumes.)
  let hid = ncall_sig0(ctx, "kaix_fresh_handler_id", native_ctx_i64t(ctx))
  let _h0 = ncall_sig2(ctx, "kaix_ev_set_handler_id", native_ctx_voidt(ctx), native_ctx_ptrt(ctx), native_ctx_i64t(ctx), ev, hid)
  # Aliased install (`with Eff as a`): box the handler_id and stash it in
  # the alias's id register so an `op@a` perform resolves to THIS instance
  # by id.
  nemit_install_alias(ctx, alias, hid)
  # Stateful handler: seed the `state` slot (Ev field 2, byte 16) with the
  # `with Eff(init)` value. `kaix_clause_state_set(ev, init)` writes the
  # same offset a clause's `resume(v, ns)` later updates. Stateless
  # handlers carry no `init` — the slot stays NULL (subset 2a unchanged).
  nemit_install_state(ctx, ev, init)
  # Clause-capture env: fill the env array (one slot per handle-union
  # capture, loaded from the register the install names for it) and point
  # Ev field 1 (byte 8) at it. No captures => leave env NULL, the clause
  # prologue never reads it.
  nemit_install_env(ctx, sym, ev, env)
  # Each op fn-ptr at field (nfx_op_base + i): declare the clause thunk,
  # store its address with kaix_ev_set_op(ev, field, fn).
  nemit_install_ops(ctx, ev, h.op_thunks, 0)
  # Push the evidence with the jmp_buf + discard slot: the runtime stamps
  # node->handle_jmp / node->discard_slot so the op site can unwind.
  let node = native_ctx_find_reg(ctx, nfx_node_reg(sym))
  let jmpbuf = native_ctx_find_reg(ctx, nfx_jmpbuf_reg(sym))
  let disc = native_ctx_find_reg(ctx, nfx_discard_reg(sym))
  let effname = nemit_eff_label(ctx, eff)
  nemit_push_with_jmp(ctx, node, effname, ev, jmpbuf, disc)
  # §6 named instances: bind the bare alias name to the node as a first-class
  # capability value (mirror of emit_c's `kai_<a> = &_node`). `node` is the
  # alloca holding the KaiEvidence; storing it lets a `#<recv>` perform read it
  # and a call site pass the alias as a capability parameter.
  nemit_install_cap_value(ctx, alias, node)
}

fn nemit_install_cap_value(ctx: Handle, alias: Option[String], node: Handle) : Unit / Console = match alias {
  None    -> ()
  Some(a) -> nemit_store_reg(ctx, a, node)
}

# Seed the Ev `state` slot from the `with Eff(init)` value (stateful
# handlers only). `kaix_clause_state_set(ev, init)` writes byte 16 — the
# same slot the clauses' `resume(v, ns)` later updates. No init = no write.
fn nemit_install_state(ctx: Handle, ev: Handle, init: Option[KVal]) : Unit / Console = match init {
  None -> ()
  Some(iv) -> {
    let v = nemit_atom(ctx, iv)
    let _s = ncall_sig2(ctx, "kaix_clause_state_set", native_ctx_voidt(ctx), native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), ev, v)
    ()
  }
}

# Fill the clause-capture env array and point Ev field 1 at it. One slot
# per handle-union capture, in the order the clause prologue's
# `PEnvCapture(j)` indexes: slot `j` takes the register the install names
# for capture `j`, a BORROW (the dup lives on the clause read), or NULL
# for a capture not in scope at the install, which no clause that runs
# from here reads. No captures => leave Ev field 1 NULL.
fn nemit_install_env(ctx: Handle, sym: String, ev: Handle, slots: [Option[String]]) : Unit / Console = match slots {
  [] -> ()
  _  -> {
    let env = native_ctx_find_reg(ctx, nfx_env_reg(sym))
    nemit_install_env_fill(ctx, env, slots, 0)
    # `kaix_ev_set_env(ev, env)` writes byte 8 (Ev field 1).
    let _s = ncall_sig2(ctx, "kaix_ev_set_env", native_ctx_voidt(ctx), native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), ev, env)
    ()
  }
}

fn nemit_install_env_fill(ctx: Handle, env: Handle, slots: [Option[String]], j: Int) : Unit / Console = match slots {
  [] -> ()
  [c, ...rest] -> {
    let v = match c {
      Some(reg) -> nemit_load_reg(ctx, reg)
      None      -> llvm_const_null(native_ctx_ptrt(ctx))
    }
    let _s = ncall_sig3(ctx, "kaix_env_set", native_ctx_voidt(ctx),
                        native_ctx_ptrt(ctx), native_ctx_i64t(ctx), native_ctx_ptrt(ctx),
                        env, llvm_const_int(native_ctx_i64t(ctx), j), v)
    nemit_install_env_fill(ctx, env, rest, j + 1)
  }
}

# Box the freshly-minted handler_id and store it in the alias's id register
# (the alloca reserved by `nfx_reserve_alias`) for an aliased install. An
# `op@a` perform unboxes it to resolve THIS instance by id. No alias = skip.
fn nemit_install_alias(ctx: Handle, alias: Option[String], hid: Handle) : Unit / Console = match alias {
  None -> ()
  Some(a) -> {
    let boxed = ncall_sig1(ctx, "kaix_int", native_ctx_ptrt(ctx), native_ctx_i64t(ctx), hid)
    nemit_store_reg(ctx, nfx_alias_reg(a), boxed)
  }
}

# Store each op's thunk address into the Ev blob at its field index. Only
# the address is stored; the perform site builds the call's fn type. A
# runtime forwarder is declared with its C prototype, `ptr (ptr self,
# <args>, ptr k)`; a clause thunk this module defines keeps its definition.
fn nemit_install_ops(ctx: Handle, ev: Handle, thunks: [KOpThunk], i: Int) : Unit / Console = match thunks {
  [] -> ()
  [KOT(_, thunk_sym, n), ...rest] -> {
    let fnv = llvm_get_or_declare_fn(native_ctx_m(ctx), thunk_sym, llvm_fn_type_boxed(native_ctx_ptrt(ctx), n))
    let field = nfx_op_base() + i
    let _s = nemit_ev_set_op(ctx, ev, field, fnv)
    nemit_install_ops(ctx, ev, rest, i + 1)
  }
}

# `kaix_ev_set_op(ptr ev, i64 idx, ptr fn) -> void`. `pub` so the builtin
# default install (`emit_native_def`) stores op fn-ptrs through the same
# helper the user-handler install uses.
pub fn nemit_ev_set_op(ctx: Handle, ev: Handle, field: Int, fnv: Handle) : Handle / Console = {
  let p = native_ctx_ptrt(ctx)
  let ptb = llvm_buf_new(); llvm_buf_push(ptb, p); llvm_buf_push(ptb, native_ctx_i64t(ctx)); llvm_buf_push(ptb, p)
  let ab = llvm_buf_new(); llvm_buf_push(ab, ev); llvm_buf_push(ab, llvm_const_int(native_ctx_i64t(ctx), field)); llvm_buf_push(ab, fnv)
  ncall_finish(ctx, "kaix_ev_set_op", native_ctx_voidt(ctx), ptb, ab)
}

# `kaix_evidence_push_with_jmp(ptr node, i8* eff, ptr ev, ptr jmp, ptr discard) -> void`.
fn nemit_push_with_jmp(ctx: Handle, node: Handle, effname: Handle, ev: Handle, jmpbuf: Handle, disc: Handle) : Unit / Console = {
  let p = native_ctx_ptrt(ctx)
  let ptb = llvm_buf_new()
  llvm_buf_push(ptb, p); llvm_buf_push(ptb, p); llvm_buf_push(ptb, p); llvm_buf_push(ptb, p); llvm_buf_push(ptb, p)
  let ab = llvm_buf_new()
  llvm_buf_push(ab, node); llvm_buf_push(ab, effname); llvm_buf_push(ab, ev); llvm_buf_push(ab, jmpbuf); llvm_buf_push(ab, disc)
  let _r = ncall_finish(ctx, "kaix_evidence_push_with_jmp_l", native_ctx_voidt(ctx), ptb, ab)
  ()
}

# --- KPop: pop the evidence on the normal exit path --------------------
pub fn nemit_pop(ctx: Handle) : Unit / Console = {
  let _r = ncall_sig0(ctx, "kaix_evidence_pop", native_ctx_voidt(ctx)); ()
}

# `finally { }` — arm the site's cleanup thunk on its evidence node. The
# thunk takes the Ev as its `void *` env, so a stateful handler's cleanup
# reads the resource `initially` left in `state`.
pub fn nemit_set_cleanup(ctx: Handle, sym: String, thunk: String) : Unit / Console = {
  let node = native_ctx_find_reg(ctx, nfx_node_reg(sym))
  let ev = native_ctx_find_reg(ctx, nfx_ev_reg(sym))
  let p = native_ctx_ptrt(ctx)
  let fnv = nemit_declare_cleanup(ctx, thunk)
  let _r = ncall_sig3(ctx, "kaix_evidence_set_cleanup", native_ctx_voidt(ctx),
                      p, p, p, node, fnv, ev)
  ()
}

# The normal-exit run, before the pop. Unwind paths reach the same thunk
# through the evidence walk; `cleanup_done` keeps the pair idempotent.
pub fn nemit_run_cleanup(ctx: Handle, sym: String) : Unit / Console = {
  let node = native_ctx_find_reg(ctx, nfx_node_reg(sym))
  let _r = ncall_sig1(ctx, "kaix_evidence_run_cleanup", native_ctx_voidt(ctx),
                      native_ctx_ptrt(ctx), node)
  ()
}

#[doc("A handle's exit through its pending resume frames: the install site's node and the value they consume.")]
pub fn nemit_resume_frames_run(ctx: Handle, cargs: [KVal]) : Handle / Console = match cargs {
  [KStrV(sym), v] -> {
    let p = native_ctx_ptrt(ctx)
    ncall_sig2(ctx, "kaix_resume_frames_run", p, p, p, native_ctx_find_reg(ctx, nfx_node_reg(sym)), nemit_atom(ctx, v))
  }
  _ -> { nemit_unsupported(ctx, "kai_resume_frames_run takes the install site and a value"); nemit_null(ctx) }
}

# The evidence node a perform dispatches through. By-id for an aliased op
# (resolve THIS handler instance via the `__alias_id__<a>` sentinel). Else,
# when the enclosing fn's frame carries this effect, read its slot from `__evf`
# (the call site filled it with the right instance's node) — the C-direct
# `__evf[slot]` mirror. Else the ordinary by-name walk for a lexically-handled
# effect the frame does not carry.
fn nemit_perform_node(ctx: Handle, fib: Handle, cur_fn: String, eff: String, alias: Option[(String, String)]) : Handle / Console = {
  let p = native_ctx_ptrt(ctx)
  match alias {
    Some((a, shown)) -> {
      let boxed = nemit_load_reg(ctx, nfx_alias_reg(a))
      let id = ncall_sig1(ctx, "kaix_to_int", native_ctx_i64t(ctx), p, boxed)
      let node = ncall_sig1(ctx, "kaix_evidence_lookup_node_by_id", p, native_ctx_i64t(ctx), id)
      # NULL when the alias was performed on a child fiber that does not carry
      # it (a `var` cell does not cross a spawn). Guard into a clean diagnostic
      # instead of a NULL handler deref — the mirror of emit_c's by-id guard.
      let aname = llvm_build_global_string(native_ctx_b(ctx), shown)
      ncall_sig2(ctx, "kaix_evidence_require_reachable", p, p, p, node, aname)
    }
    None -> {
      let slot = native_ctx_frame_slot_index(ctx, cur_fn, eff)
      if slot >= 0 {
        # A slot read skips the walk, where the cooperative-cancel yield-point
        # hook lives; poll it here so a Cancel is delivered at this op.
        let _y = ncall_sig1(ctx, "kaix_cancel_poll", native_ctx_voidt(ctx), p, fib)
        nemit_evf_load_slot(ctx, cur_fn, slot)
      }
      else { nemit_perform_walk_node(ctx, eff) }
    }
  }
}

# The node for a perform with no caller frame slot: a lexical handler on the
# stack wins, falling back to the minted default node for a default-bearing
# effect (no longer pushed) — the mirror of emit_c's `lookup_or_default`. A
# non-default effect (no global) stays on the plain by-name walk.
fn nemit_perform_walk_node(ctx: Handle, key: String) : Handle / Console = {
  let p = native_ctx_ptrt(ctx)
  let effname = nemit_eff_label(ctx, key)
  let g = llvm_get_named_global(native_ctx_m(ctx), cat2("_kai_default_node_", inst_key_eff(key)))
  if llvm_handle_is_null(g) == 1 {
    # Bare walk: NULL when no handler is on this fiber's stack (a fiber-local op
    # in a spawned fiber that installed none). `kaix_evidence_require` reports it
    # instead of dereferencing the NULL node — the mirror of emit_c's guard.
    let node = ncall_sig1(ctx, "kaix_evidence_lookup_node_l", p, p, effname)
    ncall_sig2(ctx, "kaix_evidence_require", p, p, p, node, effname)
  } else {
    # A default global EXISTS for this effect's name in the module — but it may
    # be a zeroed node minted for a fiber-local effect that has no real default
    # (its handler slot is NULL). Guard the or_default result so such a node
    # reports `effect not handled in fiber` instead of segfaulting on the deref,
    # matching the C backend (which guards by the effect declaring a default, not
    # the global's presence).
    let node = ncall_sig2(ctx, "kaix_evidence_lookup_or_default_l", p, p, p, effname, g)
    ncall_sig2(ctx, "kaix_evidence_require", p, p, p, node, effname)
  }
}

# Load `__evf[slot]` — the node the call site stored at this effect's frame
# index. `__evf` (LLVM param 0) is the reserved register pointing at the
# caller-built `[N x ptr]` array; a GEP at `slot` then a load yields the
# `KaiEvidence *`. The array type is rebuilt from the fn's own slot count.
fn nemit_evf_load_slot(ctx: Handle, cur_fn: String, slot: Int) : Handle / Console = {
  let p = native_ctx_ptrt(ctx)
  let n = native_ctx_frame_slot_count(ctx, cur_fn)
  let arrty = llvm_array_type(p, n)
  let evf = nemit_load_reg(ctx, "__evf")
  let idx = llvm_const_int(native_ctx_i64t(ctx), slot)
  let slotptr = llvm_build_array_gep(native_ctx_b(ctx), arrty, evf, idx)
  llvm_build_load(native_ctx_b(ctx), p, slotptr)
}

# --- KPerform: dispatch an op to its handler clause --------------------
#
# Mirrors `llvm_emit_op_dispatch`: lookup the evidence node, read its
# handler (the Ev blob), init a one-shot KaiCont, set the in_dispatch
# guard, indirect-call the op fn-ptr at its field index, restore the
# guard, then `kaix_op_finish` (the folded discard test + unwind — on a
# discard it longjmps and does not return; otherwise yields the op result).
pub fn nemit_perform(ctx: Handle, cur_fn: String, eff: String, esym: SymId, op: String, via: KVia, cargs: [KVal], handlers: [KHandlerDecl]) : Handle / Console = {
  # A receiver is the register holding the evidence (a capability param or a
  # `with..as` value); an alias is the by-id lookup for a `var`/State/Reader
  # cell. A perform inside a `handle` of `eff` in this fn has that handler
  # for evidence, so the frame slot is not consulted.
  let slot_fn = match via { KvLexical -> ""  KvNamed -> ""  _ -> cur_fn }
  let eff_key = match via { KvNamed -> named_label(eff)  _ -> eff }
  let alias = match via { KvAlias(a, shown) -> Some((a, shown))  _ -> None }
  let recv = match via { KvRecv(r) -> Some(r)  _ -> None }
  match nfx_find_handler_by_eff(handlers, esym) {
    None -> { nemit_unsupported(ctx, cat2("KPerform: no handler for effect ", eff)); nemit_null(ctx) }
    Some(h) -> nemit_perform_with(ctx, slot_fn, eff_key, op, alias, recv, cargs, h)
  }
}

fn nemit_perform_with(ctx: Handle, cur_fn: String, eff: String, op: String, alias: Option[(String, String)], recv: Option[String], cargs: [KVal], h: KHandlerDecl) : Handle / Console = {
  let p = native_ctx_ptrt(ctx)
  let field = nfx_op_field(h.op_thunks, op, 0)
  # The fiber is read once: a frame never changes fiber.
  let fib = ncall_sig0(ctx, "kaix_dispatch_fiber", p)
  # 1. node = the capability register for a `#<recv>` op (read it directly), a
  # by-id lookup for an aliased op, the enclosing fn's frame slot when carried,
  # else the innermost-by-effect-name lookup; handler = node_handler(node).
  let node = match recv {
    Some(r) -> nemit_load_reg(ctx, r)
    None    -> nemit_perform_node(ctx, fib, cur_fn, eff, alias)
  }
  let handler = nemit_call1(ctx, "kaix_evidence_node_handler", node)
  # 2. cont = the reserved KaiCont alloca; init identity with handler_id.
  # `kaix_ev_handler_id(ptr) -> i64` (NOT a boxed ptr); `cont_init_identity`
  # takes the i64 hid as its second arg.
  let cont = native_ctx_find_reg(ctx, nfx_cont_reg())
  let hid = ncall_sig1(ctx, "kaix_ev_handler_id", native_ctx_i64t(ctx), p, handler)
  let _ci = ncall_sig2(ctx, "kaix_cont_init_identity", native_ctx_voidt(ctx), p, native_ctx_i64t(ctx), cont, hid)
  # 3. evaluate args BEFORE the in_dispatch flag (they may invoke the op).
  let argbuf = nemit_perform_argbuf(ctx, handler, cargs, cont)
  # 4. mark node in dispatch -> prev; load the op fn-ptr; indirect call.
  let prev = ncall_sig2(ctx, "kaix_disp_enter", p, p, p, fib, node)
  let opfn = ncall_sig2(ctx, "kaix_ev_op_at", p, p, native_ctx_i64t(ctx), handler, llvm_const_int(native_ctx_i64t(ctx), field))
  let r = nemit_perform_indirect(ctx, opfn, argbuf, list_length(cargs))
  let _il = ncall_sig2(ctx, "kaix_disp_leave", native_ctx_voidt(ctx), p, p, fib, prev)
  # 5. op_finish(node, cont, r): on a discard it longjmps (no return);
  # otherwise yields `r`. Folds the C-direct discard test + unwind so the
  # KIR block stays 1:1 with an LLVM block (no fresh op.cont/op.discard).
  nemit_op_finish(ctx, node, cont, r)
}

# Build the op-clause arg buffer: `self` (the Ev handler) first, then each
# materialised op arg, then the cont pointer last — the clause ABI
# `ptr (ptr self, <args>, ptr k)`.
fn nemit_perform_argbuf(ctx: Handle, handler: Handle, cargs: [KVal], cont: Handle) : Handle / Console = {
  let buf = llvm_buf_new()
  llvm_buf_push(buf, handler)
  nemit_perform_push_args(ctx, buf, cargs)
  llvm_buf_push(buf, cont)
  buf
}
fn nemit_perform_push_args(ctx: Handle, buf: Handle, cargs: [KVal]) : Unit / Console = match cargs {
  [] -> ()
  [a, ...rest] -> { let av = nemit_atom(ctx, a); llvm_buf_push(buf, av); nemit_perform_push_args(ctx, buf, rest) }
}

# Indirect call to the loaded op fn-ptr over the arg buffer. The fn type is
# `ptr (ptr self, <n args ptr>, ptr k)`: n+2 ptr params, ptr return. Built
# from a param-type buffer matching the arg buffer length.
fn nemit_perform_indirect(ctx: Handle, opfn: Handle, argbuf: Handle, nargs: Int) : Handle / Console = {
  let p = native_ctx_ptrt(ctx)
  let fnty = llvm_fn_type_boxed(p, nargs + 2)
  native_build_call(ctx, opfn, fnty, argbuf)
}

# `kaix_op_finish(ptr node, ptr cont, ptr op_r) -> ptr`.
fn nemit_op_finish(ctx: Handle, node: Handle, cont: Handle, r: Handle) : Handle / Console = {
  let p = native_ctx_ptrt(ctx)
  let ptb = llvm_buf_new(); llvm_buf_push(ptb, p); llvm_buf_push(ptb, p); llvm_buf_push(ptb, p)
  let ab = llvm_buf_new(); llvm_buf_push(ab, node); llvm_buf_push(ab, cont); llvm_buf_push(ab, r)
  ncall_finish(ctx, "kaix_op_finish", p, ptb, ab)
}

# --- KResumeOp: one-shot resume the continuation (expression form) ------
#
# `resume(v)` -> `kaix_cont_resume(k, v)`, YIELDING the resume result. NOT a
# `ret`: the resume is an expression-call (mirror of emit_c's
# `kai_cont_resume(k, <v>)`), so the clause body's normal `KRet` sequences it
# and a non-tail `let _ = resume(()) resume(())` runs BOTH calls — the
# second trips the runtime one-shot check (`status != UNRESUMED` → abort).
# `ncall_sig2` does NOT free its args, so the borrowed `k` (the clause param)
# and `v` keep the same RC the oracle's plain call does.
pub fn nemit_resume(ctx: Handle, k: KVal, v: KVal) : Handle / Console = {
  let kv = nemit_atom(ctx, k)
  let vv = nemit_atom(ctx, v)
  ncall_sig2(ctx, "kaix_cont_resume", native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), kv, vv)
}

# --- KResume2Op: stateful 2-arg resume `resume(v, new_state)` -----------
#
# `resume(v, ns)` -> replace `self->state` with `ns`, release the old
# state (the Ev owns it), then `kaix_cont_resume(k, v)`, YIELDING the
# result. Mirrors emit_c. The `__self` reg was registered by
# `nemit_seed_clause_params` (LLVM param 0). As with `nemit_resume`, the
# call is an expression, not a `ret`.
pub fn nemit_resume2(ctx: Handle, k: KVal, v: KVal, ns: KVal) : Handle / Console = {
  # LOAD the Ev value from the `__self` alloca (NOT the alloca address —
  # `kaix_clause_state_set` writes `(char*)self + 16`, so passing the
  # alloca slot would clobber this frame instead of the Ev's state).
  let self_v = nemit_load_reg(ctx, "__self")
  let nsv = nemit_atom(ctx, ns)
  let old = ncall_sig1(ctx, "kaix_clause_state_get", native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), self_v)
  let _s = ncall_sig2(ctx, "kaix_clause_state_set", native_ctx_voidt(ctx), native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), self_v, nsv)
  let _d = nemit_call1(ctx, "kaix_internal_drop", old)
  let kv = nemit_atom(ctx, k)
  let vv = nemit_atom(ctx, v)
  ncall_sig2(ctx, "kaix_cont_resume", native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), kv, vv)
}

#[doc("True when `op` opens a landing pad.")]
pub fn npad_is_open(op: KOp) : Bool = match op {
  KPrim(KpPadOpen, _) -> true
  _ -> false
}

#[doc("True when `op` closes a landing pad.")]
pub fn npad_is_close(op: KOp) : Bool = match op {
  KPrim(KpPadClose, _) -> true
  _ -> false
}

#[doc("Builds the pad named `reg` that releases the registers of `op`, and opens it.")]
pub fn nemit_pad_open(ctx: Handle, reg: String, op: KOp) : Unit / Console = match op {
  KPrim(_, regs) -> {
    let b = native_ctx_b(ctx)
    let fnval = native_ctx_fnval(ctx)
    let here = llvm_get_insert_block(b)
    let pad = llvm_append_block(native_ctx_m(ctx), fnval, "pad")
    llvm_position_at_end(b, pad)
    let lp = llvm_build_landingpad_cleanup(b)
    npad_release(ctx, regs)
    let _r = llvm_build_resume(b, lp)
    llvm_position_at_end(b, here)
    npad_arm(ctx, fnval)
    native_ctx_add_block(ctx, npad_label(reg), pad)
    native_ctx_set_pad(ctx, pad)
  }
  _ -> ()
}

#[doc("Reopens the pad enclosing the one `op` closes, or none.")]
pub fn nemit_pad_close(ctx: Handle, op: KOp) : Unit = match op {
  KPrim(_, [KVar(outer)]) -> native_ctx_set_pad(ctx, native_ctx_find_block(ctx, npad_label(outer)))
  _ -> native_ctx_set_pad(ctx, native_ctx_find_block(ctx, npad_label("")))
}

# The decrefs are plain calls: a pad never unwinds into another.
fn npad_release(ctx: Handle, regs: [KVal]) : Unit / Console = match regs {
  [] -> ()
  [v, ...rest] -> {
    match v {
      KVar(r) -> if native_ctx_reg_slot(ctx, r) == 0 { npad_decref(ctx, nemit_atom(ctx, v)) } else { () }
      _ -> ()
    }
    npad_release(ctx, rest)
  }
}

fn npad_decref(ctx: Handle, x: Handle) : Unit = {
  let pt = llvm_buf_new(); llvm_buf_push(pt, native_ctx_ptrt(ctx))
  let fnty = llvm_fn_type_n(native_ctx_voidt(ctx), pt); llvm_buf_free(pt)
  let fnv = llvm_get_or_declare_fn(native_ctx_m(ctx), "kaix_decref", fnty)
  let ab = llvm_buf_new(); llvm_buf_push(ab, x)
  let _c = llvm_build_call_n(native_ctx_b(ctx), fnv, fnty, ab)
  llvm_buf_free(ab)
}

fn npad_arm(ctx: Handle, fnval: Handle) : Unit = {
  let none = llvm_buf_new()
  let pfty = llvm_fn_type_n(native_ctx_i32t(ctx), none); llvm_buf_free(none)
  let pers = llvm_get_or_declare_fn(native_ctx_m(ctx), "__gcc_personality_v0", pfty)
  let _p = llvm_set_personality(fnval, pers)
  let _u = llvm_add_uwtable(fnval)
  ()
}

fn npad_label(reg: String) : String = string_concat("pad:", reg)
