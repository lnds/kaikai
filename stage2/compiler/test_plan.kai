#[doc("""
The run order of a grouped test build: for each module the root file
imports, the modules whose test blocks a build with that module as its
root would run, in the order it would load them.

A root loads its imports depth first, each module after the modules it
imports, so its blocks run in that post-order with its own last. A build
that loads several roots interleaves their orders, so the order is
recorded per root rather than read off the shared decl stream.
""")]

import compiler.modules
import compiler.module_table
import compiler.util

fn tplan_home_of(mods: [ModuleEntry], path: String) : Option[String] = match mt_lookup_origin(mods, path) {
  Some(ME(home, _, _, _)) -> Some(home)
  None -> None
}

# The files `owner`'s imports name, in the order it wrote them.
fn tplan_scope_of(scopes: [ModScope], owner: String) : [ModuleEntry] = match scopes {
  [] -> []
  [MScope(m, entries, _), ...rest] -> if m == owner { entries } else { tplan_scope_of(rest, owner) }
}

# A walk's visited homes and the post-order it has emitted so far.
type TPlanWalk = { seen: [String], order: [String] }

# Post-order over `home`'s imports: every module it reaches before it, each once.
fn tplan_visit(scopes: [ModScope], mods: [ModuleEntry], home: String, w: TPlanWalk) : TPlanWalk =
  if list_has(w.seen, home) { w }
  else {
    let inner = tplan_visit_all(scopes, mods, tplan_scope_of(scopes, home),
                                TPlanWalk { ...w, seen: [home, ...w.seen] })
    TPlanWalk { ...inner, order: list_append(inner.order, [home]) }
  }

fn tplan_visit_all(scopes: [ModScope], mods: [ModuleEntry], entries: [ModuleEntry], w: TPlanWalk) : TPlanWalk =
  match entries {
    [] -> w
    [ME(_, _, path, _), ...rest] -> match tplan_home_of(mods, path) {
      Some(h) -> tplan_visit_all(scopes, mods, rest, tplan_visit(scopes, mods, h, w))
      None -> tplan_visit_all(scopes, mods, rest, w)
    }
  }

fn tplan_line(scopes: [ModScope], mods: [ModuleEntry], root: ModuleEntry) : String = match root {
  ME(name, _, path, _) -> match tplan_home_of(mods, path) {
    Some(h) -> concat_all([name, "\t", string_join(tplan_order(scopes, mods, h), " "), "\n"])
    None -> ""
  }
}

#[doc("The modules a build rooted at `home` runs test blocks from, in run order, `home` last.")]
pub fn tplan_order(scopes: [ModScope], mods: [ModuleEntry], home: String) : [String] =
  tplan_visit(scopes, mods, home, TPlanWalk { seen: [], order: [] }).order

#[doc("One line per module the root file imports: its written name, a tab, then its run order space-separated.")]
pub fn tplan_text(scopes: [ModScope], mods: [ModuleEntry]) : String =
  concat_all(map(tplan_scope_of(scopes, ""), (root) => tplan_line(scopes, mods, root)))
