#[doc("""
Lexical shadowing of a function's evidence frame.

A `handle` of an effect inside a function makes that handler the evidence for
the ops performed in its body and for the calls made there, even when the
function's own row carries the effect in a frame slot. The shadow is an extra
entry beside the frame table, under the unit the `handle` stands in.
""")]

import compiler.evidence_frame
import compiler.effect_instance
import compiler.enc_unit

#[doc("Mark the effect instance `key` as handled by a `handle` lexically inside the unit `enc`.")]
pub fn frame_shadow(frames: EvFrames, enc: EncFn, key: InstKey) : EvFrames =
  EvFrames { shadows: [FSh(enc.unit, key), ...frames.shadows], ix: frames.ix }

#[doc("The frame slot of the instance `key` in the unit `enc` that an op or call here may use, or -1 when there is none or a lexical `handle` shadows it. A runner and a lifted body carry no frame.")]
pub fn frame_slot_here(frames: EvFrames, enc: EncFn, key: InstKey) : Int =
  if is_shadowed(frames.shadows, enc.unit, key) { 0 - 1 }
  else { frame_slot_index(frames, enc_fn_id(enc), key) }

fn is_shadowed(shadows: [FrameShadow], at: EncUnit, key: InstKey) : Bool = match shadows {
  []                   -> false
  [FSh(u, k), ...rest] -> (inst_keys_match(key, k) and unit_same(u, at)) or is_shadowed(rest, at, key)
}
