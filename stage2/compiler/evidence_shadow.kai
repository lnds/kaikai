#[doc("""
Lexical shadowing of a function's evidence frame.

A `handle` of an effect inside a function makes that handler the evidence for
the ops performed in its body and for the calls made there, even when the
function's own row carries the effect in a frame slot. The shadow is an extra
entry beside the frame table under a key that is not a C symbol.
""")]

import compiler.evidence_frame
import compiler.effect_instance

#[doc("Mark the effect instance `key` as handled by a `handle` lexically inside `fsym`.")]
pub fn frame_shadow(frames: EvFrames, fsym: String, key: String) : EvFrames =
  EvFrames { shadows: [FEF(shadow_key(fsym), [key]), ...frames.shadows], ix: frames.ix }

#[doc("The frame slot of the instance `key` in `fsym` that an op or call here may use, or -1 when there is none or a lexical `handle` shadows it.")]
pub fn frame_slot_here(frames: EvFrames, fsym: String, key: String) : Int =
  if is_shadowed(frames.shadows, shadow_key(fsym), key) { 0 - 1 }
  else { frame_slot_index(frames, fsym, key) }

fn is_shadowed(shadows: [FnEvidenceFrame], at: String, key: String) : Bool = match shadows {
  []           -> false
  [f, ...rest] -> match f {
    FEF(k, keys) -> (k == at and inst_key_index(keys, key) >= 0) or is_shadowed(rest, at, key)
  }
}

fn shadow_key(fsym: String) : String = string_concat("#handle:", fsym)
