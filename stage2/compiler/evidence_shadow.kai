#[doc("""
Lexical shadowing of a function's evidence frame.

A `handle` of an effect inside a function makes that handler the evidence for
the ops performed in its body and for the calls made there, even when the
function's own row carries the effect in a frame slot. The shadow is an extra
entry beside the frame table under a key that is not a C symbol.
""")]

import compiler.evidence_frame

#[doc("Mark `eff` as handled by a `handle` lexically inside `fsym`.")]
pub fn frame_shadow(frames: EvFrames, fsym: String, eff: String) : EvFrames =
  EvFrames { shadows: [FEF(shadow_key(fsym), [eff]), ...frames.shadows], ix: frames.ix }

#[doc("The frame slot of `eff` in `fsym` that an op or call here may use, or -1 when there is none or a lexical `handle` shadows it.")]
pub fn frame_slot_here(frames: EvFrames, fsym: String, eff: String) : Int =
  if is_shadowed(frames.shadows, shadow_key(fsym), eff) { 0 - 1 }
  else { frame_slot_index(frames, fsym, eff) }

fn is_shadowed(shadows: [FnEvidenceFrame], key: String, eff: String) : Bool = match shadows {
  []           -> false
  [f, ...rest] -> match f { FEF(k, effs) -> (k == key and has(effs, eff)) or is_shadowed(rest, key, eff) }
}

fn has(xs: [String], s: String) : Bool = match xs {
  []           -> false
  [x, ...rest] -> x == s or has(rest, s)
}

fn shadow_key(fsym: String) : String = string_concat("#handle:", fsym)
