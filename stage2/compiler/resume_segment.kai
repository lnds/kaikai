#[doc("""
Segmenting op clauses at their resume points and rewriting the handler declarations.
""")]

import compiler.ast
import compiler.written
import compiler.handler_alias
import compiler.resume_scan
import compiler.resume_split
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.infer_clause_holes
import compiler.anf_ops
import compiler.emit_shared
import compiler.parse_type_decls
import compiler.handle_presence

#[doc("What an op clause needs: its body, split where it resumes; a segment, why, and whether `resume` may leave the clause; or the shapes reported against it.")]
pub type ClauseNeed = CnInPlace(Expr) | CnSeg(String, Bool) | CnBad([RsBad])

fn clause_need(body: Expr, k: String) : ClauseNeed = match rs_escape(body, k) {
  Some(at) -> CnSeg(escape_reason(at, k), true)
  None -> match rs_unsplittable(body, k) {
    Some(b) -> CnSeg(bad_message(b), false)
    None    -> if rs_all_tail(body, k) { CnInPlace(body) } else { split_need(body, k) }
  }
}

fn split_need(body: Expr, k: String) : ClauseNeed = {
  let sp = sp_to(body, Cx { k: k, kn: KTail, tainted: [] }, Ss { n: 0, bad: [] })
  match list_reverse(sp.s.bad) {
    []   -> CnInPlace(sp.e)
    bads -> if any(bads, rs_is_twice) { CnBad(bads) } else { CnSeg(bad_message(list_head_bad(bads)), false) }
  }
}

fn list_head_bad(bs: [RsBad]) : RsBad = match bs {
  [b, ..._] -> b
  []        -> RsBad("", "", 0, 0)
}

fn bad_message(b: RsBad) : String = match b { RsBad(m, _, _, _) -> m }

fn escape_reason(at: Expr, k: String) : String = match at.kind {
  EName(_) -> "`#{k}` is used as a value"
  _       -> "`#{k}` is called from a lambda"
}

fn rs_bad_body(at: Expr, bads: [RsBad]) : Expr = match list_reverse(bads) {
  [last, ...before] ->
    mk_expr(EBlock(map(list_reverse(before), (b) => SExprStmt(rs_bad_marker(b))), Some(rs_bad_marker(last))), at.line, at.col)
  [] -> at
}

# --- where the continuation leaves the clause ---------------------------

fn rs_escape(e: Expr, k: String) : Option[Expr] = match e.kind {
  EName(n) -> if written_text(n) == k { Some(e) } else { None }
  ECall(f, xs) ->
    if rs_is_k_call(e, k) { rs_escape_in(xs, k) }
    else if rs_is_loop_callee(f) { rs_escape_in(map(xs, inline_body), k) }
    else { rs_escape_in([f, ...xs], k) }
  ELambda(ps, b) -> if binds(ps, k) { None } else { match rs_mention(b, k) {
    Some(_) -> Some(e)
    None    -> None
  } }
  EHandle(body, _, _, init, _, cs, ret) -> rs_escape_in(handle_parts(body, init, cs, ret, k), k)
  _ -> rs_escape_in(rs_children(e), k)
}

# A loop's lambda runs in place: what it does with `k` is what its body does.
fn inline_body(x: Expr) : Expr = match x.kind {
  ELambda([], b) -> b
  _              -> x
}

fn rs_escape_in(es: [Expr], k: String) : Option[Expr] = match es {
  [] -> None
  [x, ...rest] -> match rs_escape(x, k) {
    Some(hit) -> Some(hit)
    None      -> rs_escape_in(rest, k)
  }
}

# Any read of `k`, down to a binder that rebinds it.
fn rs_mention(e: Expr, k: String) : Option[Expr] = match e.kind {
  EName(n) -> if written_text(n) == k { Some(e) } else { None }
  ELambda(ps, b) -> if binds(ps, k) { None } else { rs_mention(b, k) }
  EHandle(body, _, _, init, _, cs, ret) -> rs_mention_in(handle_parts(body, init, cs, ret, k), k)
  _ -> rs_mention_in(rs_children(e), k)
}

fn rs_mention_in(es: [Expr], k: String) : Option[Expr] = match es {
  [] -> None
  [x, ...rest] -> match rs_mention(x, k) {
    Some(hit) -> Some(hit)
    None      -> rs_mention_in(rest, k)
  }
}

# A nested handle's parts that still see `k`: its clauses that rebind it are opaque.
fn handle_parts(body: Expr, init: Option[Expr], cs: [HClause], ret: Option[HReturn], k: String) : [Expr] = {
  let tail = match ret {
    Some(HR(p, b, _, _)) -> if written_text(p.name) == k { [] } else { [b] }
    None -> []
  }
  let head = match init { Some(i) -> [body, i] None -> [body] }
  [...head, ...clause_bodies_seeing(cs, k), ...tail]
}

fn clause_bodies_seeing(cs: [HClause], k: String) : [Expr] = match cs {
  [] -> []
  [HC(_, ps, b, _, _), ...rest] ->
    if binds(ps, k) { clause_bodies_seeing(rest, k) } else { [b, ...clause_bodies_seeing(rest, k)] }
}

# --- the handle ------------------------------------------------------------

#[doc("The pieces of a `handle` whose nested handles are already rewritten.")]
pub type HandleParts = { body: Expr, eff: DeclRef, tys: [TypeExpr], init: Option[Expr],
                         alias: Option[Binder], clauses: [HClause], ret: Option[HReturn] }

fn place_handle(h: HandleParts, at: Expr) : ExprKind = {
  let needs = map(h.clauses, clause_need_of)
  match first_seg(needs) {
    Some(why) -> segment_handle(h, why, at)
    None -> in_place(h, needs)
  }
}

fn clause_need_of(c: HClause) : ClauseNeed = match c {
  HC(n, ps, body, _, _) ->
    if is_lifecycle_clause(n) { CnInPlace(body) }
    else { match clause_continuation(ps) {
      Some(k) -> clause_need(body, written_text(k.name))
      None    -> CnInPlace(body)
    } }
}

type SegWhy = { reason: String, escapes: Bool }

fn first_seg(ns: [ClauseNeed]) : Option[SegWhy] = match ns {
  [] -> None
  [n, ...rest] -> match n {
    CnSeg(r, esc) -> Some(SegWhy { reason: r, escapes: esc or any_escapes(rest) })
    _ -> first_seg(rest)
  }
}

fn any_escapes(ns: [ClauseNeed]) : Bool = any(ns, (n) => match n {
  CnSeg(_, esc) -> esc
  _ -> false
})

fn in_place(h: HandleParts, needs: [ClauseNeed]) : ExprKind =
  EHandle(h.body, h.eff, h.tys, h.init, h.alias, zip_needs(h.clauses, needs), h.ret)

fn zip_needs(cs: [HClause], ns: [ClauseNeed]) : [HClause] = match cs {
  [] -> []
  [HC(n, ps, body, l, c), ...rest] -> match ns {
    [need, ...more] -> [HC(n, ps, need_body(need, body, l, c), l, c), ...zip_needs(rest, more)]
    [] -> cs
  }
}

fn need_body(n: ClauseNeed, body: Expr, l: Int, c: Int) : Expr = match n {
  CnInPlace(b) -> b
  CnBad(bads)  -> rs_bad_body(body, map(bads, (b) => at_clause(b, l, c)))
  CnSeg(_, _)  -> body
}

# A shape found without a position points at its clause.
fn at_clause(b: RsBad, l: Int, c: Int) : RsBad = match b {
  RsBad(m, h, bl, bc) -> if bl == 0 { RsBad(m, h, l, c) } else { RsBad(m, h, bl, bc) }
}

fn segment_handle(h: HandleParts, why: SegWhy, at: Expr) : ExprKind = {
  let ops = op_clauses(h.clauses)
  let fin = filter(h.clauses, is_lifecycle)
  let stateful = match h.init { Some(_) -> true  None -> false }
  let fwd = forwarders(ops, 0, stateful)
  let inner_ret = if stateful { map_opt_return(h.ret, state_out) } else { None }
  let inner = with_kind(at, EHandle(h.body, h.eff, h.tys, h.init, h.alias, [...fwd, ...fin], inner_ret))
  let thunk = with_kind(h.body, ELambda([], inner))
  let ret = if stateful { state_return_lambda(h.ret, at) } else { return_lambda(h.ret, at) }
  let cls = if stateful { map(ops, state_clause_lambda) } else { map(ops, (c) => clause_lambda(c, at)) }
  EIntrinsic(InSegHandle, [with_kind(at, EBool(why.escapes)), quoted(why.reason, at), thunk, ret, ...cls])
}

fn is_lifecycle(c: HClause) : Bool = match c { HC(n, _, _, _, _) -> is_lifecycle_clause(n) }

fn op_clauses(cs: [HClause]) : [HClause] = filter(cs, (c) => not is_lifecycle(c))

# `op(a0, …, k) -> k($seg_request(i, a0, …))`: the op reaches the handle.
# Stateful, the request carries the state and comes back as `(v, s)`.
fn forwarders(cs: [HClause], i: Int, stateful: Bool) : [HClause] = match cs {
  [] -> []
  [HC(n, ps, b, l, c), ...rest] -> {
    let args = fresh_params(list_length(ps) - 1, 0, b)
    let k = mk_name("__seg_k", l, c)
    let refs = map(args, (p) => mk_expr(EName(p.binder.name), l, c))
    let st = if stateful { [state_arg(l, c)] } else { [] }
    let req = mk_expr(EIntrinsic(InSegRequest, [mk_expr(mk_int_synth(i), l, c), ...refs, ...st]), l, c)
    let call = if stateful { state_resume(k, req) } else { mk_expr(ECall(k, [req]), l, c) }
    [HC(n, [...args, param("__seg_k", b)], call, l, c), ...forwarders(rest, i + 1, stateful)]
  }
}

fn fresh_params(n: Int, i: Int, at: Expr) : [Param] =
  if i >= n { [] } else { [param("__seg_a#{i}", at), ...fresh_params(n, i + 1, at)] }


fn clause_lambda(c: HClause, at: Expr) : Expr = match c {
  HC(_, ps, b, l, col) -> mk_expr(ELambda(ps, b), l, col)
}

# Without a return clause the handle's value is the body's: `()` stands for it.
fn return_lambda(ret: Option[HReturn], at: Expr) : Expr = match ret {
  Some(HR(p, b, l, c)) -> mk_expr(ELambda([param_of(p, b)], b), l, c)
  None -> with_kind(at, EUnit)
}

fn quoted(s: String, at: Expr) : Expr = with_kind(at, EStr("\"#{s}\"", false))

pub(pkg) fn param(name: String, at: Expr) : Param = param_of(binder_written(name), at)

fn param_of(b: Binder, at: Expr) : Param =
  Param { binder: b, ptype: None, pline: at.line, pcol: at.col, pborrow: false }

pub(pkg) fn binds(ps: [Param], k: String) : Bool = any(ps, (p) => written_text(p.binder.name) == k)

fn state_arg(l: Int, c: Int) : Expr = mk_name(var_cell_alias(), l, c)

fn state_resume(k: Expr, req: Expr) : Expr = {
  let pat = tuple_pat([mk_pat(PBind(binder_written("__seg_v")), req.line, req.col), mk_pat(PBind(binder_written("__seg_s")), req.line, req.col)], req)
  let call = with_kind(req, ECall(k, [mk_name("__seg_v", req.line, req.col), mk_name("__seg_s", req.line, req.col)]))
  with_kind(req, EBlock([SLet(pat, None, req)], Some(call)))
}

fn tuple_pat(ps: [Pattern], at: Expr) : Pattern = tuple_pat_of(ps, at.line, at.col)

fn tuple_lit(xs: [Expr], at: Expr) : Expr = tuple_lit_expr(xs, at.line, at.col)

fn map_opt_return(r: Option[HReturn], f: (HReturn) -> HReturn) : Option[HReturn] = match r {
  Some(x) -> Some(f(x))
  None -> None
}

fn state_out(r: HReturn) : HReturn = match r {
  HR(_, b, l, c) -> HR(binder_written("__seg_x"), tuple_lit([mk_name("__seg_x", l, c), mk_name(var_cell_alias(), l, c)], b), l, c)
}

fn state_return_lambda(ret: Option[HReturn], at: Expr) : Expr = match ret {
  Some(HR(p, b, l, c)) -> {
    let x = if written_text(p.name) == "_" { mk_pat(PWild, l, c) } else { mk_pat(PBind(p), l, c) }
    let unpack = SLet(tuple_pat([x, mk_pat(PBind(binder_written("__seg_st")), l, c)], b), None, mk_name("__seg_r", l, c))
    let body = with_kind(b, EBlock([unpack], Some(with_state(b))))
    mk_expr(ELambda([param("__seg_r", b)], body), l, c)
  }
  None -> with_kind(at, EUnit)
}

fn state_clause_lambda(cl: HClause) : Expr = match cl {
  HC(_, ps, b, l, c) -> {
    let k = match clause_continuation(ps) { Some(n) -> n  None -> binder_written("") }
    mk_expr(ELambda([...clause_op_args(ps), param("__seg_st", b), param_of(k, b)], with_state(keep_state(b, written_text(k.name)))), l, c)
  }
}

fn with_state(b: Expr) : Expr = with_kind(b, EIntrinsic(InSegState, [mk_name("__seg_st", b.line, b.col), b]))

fn keep_state(e: Expr, k: String) : Expr = match e.kind {
  ECall(f, [v]) -> if rs_is_k_call(e, k) {
    with_kind(e, ECall(f, [keep_state(v, k), mk_name("__seg_st", e.line, e.col)]))
  } else { with_kind(e, map_expr_kind(e.kind, (x) => keep_state(x, k))) }
  ELambda(ps, _) -> if binds(ps, k) { e } else { with_kind(e, map_expr_kind(e.kind, (x) => keep_state(x, k))) }
  EHandle(body, n, tys, init, alias, cs, ret) ->
    with_kind(e, EHandle(keep_state(body, k), n, tys, map_opt_expr(init, (x) => keep_state(x, k)), alias,
                         map(cs, (cl) => keep_state_clause(cl, k)), map_opt_return(ret, (r) => keep_state_return(r, k))))
  _ -> with_kind(e, map_expr_kind(e.kind, (x) => keep_state(x, k)))
}

fn keep_state_clause(cl: HClause, k: String) : HClause = match cl {
  HC(n, ps, b, l, c) -> if binds(ps, k) { cl } else { HC(n, ps, keep_state(b, k), l, c) }
}

fn keep_state_return(r: HReturn, k: String) : HReturn = match r {
  HR(p, b, l, c) -> if written_text(p.name) == k { r } else { HR(p, keep_state(b, k), l, c) }
}

pub(pkg) fn split_resume_decls(ds: [Decl]) : [Decl] = map(ds, rsd_decl)

fn rsd_decl(d: Decl) : Decl = match d {
  DFn(pub_, fid, tps, ps, ret, row, body, l, c, mo) -> DFn(pub_, fid, tps, ps, ret, row, rsd_body(body), l, c, mo)
  DTest(desc, body, l, c, mo)      -> DTest(desc, rsd_body(body), l, c, mo)
  DBench(desc, body, l, c, mo)     -> DBench(desc, rsd_body(body), l, c, mo)
  DCheck(desc, ps, body, l, c, mo) -> DCheck(desc, ps, rsd_body(body), l, c, mo)
  DImpl(p, tas, tgt, inner, l, c, tps, isym) -> DImpl(p, tas, tgt, map(inner, rsd_decl), l, c, tps, isym)
  DDerive(ns, inner, l, c)         -> DDerive(ns, rsd_decl(inner), l, c)
  DUnstable(inner, l, c)           -> DUnstable(rsd_decl(inner), l, c)
  DProtoLaws(thy, inner, l, c, mo) -> DProtoLaws(thy, rsd_decl(inner), l, c, mo)
  DImplAxiom(thy, inner, l, c, mo) -> DImplAxiom(thy, rsd_decl(inner), l, c, mo)
  DConstructor(inner, l, c)        -> DConstructor(rsd_decl(inner), l, c)
  DDoc(a, b, inner, l, c)          -> DDoc(a, b, rsd_decl(inner), l, c)
  DConst(pub_, csym, ty, init, mo, l, c) -> DConst(pub_, csym, ty, rsd_body(init), mo, l, c)
  DEffect(pub_, esym, tps, ops, dflt, l, c, mo) -> DEffect(pub_, esym, tps, ops, rsd_default(dflt), l, c, mo)
  _ -> d
}

fn rsd_default(dflt: Option[DefaultBlock]) : Option[DefaultBlock] = match dflt {
  Some(DBlk(cs, ret, l, c)) -> Some(DBlk(map(cs, rsd_default_clause), map_opt_return_exprs(ret, rsd_expr), l, c))
  None -> None
}

# A body that installs no handler is returned as is: the rebuild would cost
# every program, and almost none has a clause to split.
fn rsd_body(e: Expr) : Expr = if holds_handle(e) { rsd_expr(e) } else { e }

fn rsd_expr(e: Expr) : Expr = Expr { kind: rsd_kind(e), line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

# Handles nested in a clause are placed first; to the clause they are opaque.
fn rsd_kind(e: Expr) : ExprKind = match e.kind {
  EHandle(body, eff, tys, init, alias, cs, ret) -> {
    let parts = HandleParts { body: rsd_expr(body), eff: eff, tys: tys,
                              init: map_opt_expr(init, rsd_expr), alias: alias,
                              clauses: map(cs, rsd_clause), ret: map_opt_return_exprs(ret, rsd_expr) }
    place_handle(parts, e)
  }
  k -> map_expr_kind(k, rsd_expr)
}

fn rsd_clause(c: HClause) : HClause = match c {
  HC(n, ps, body, l, col) -> HC(n, ps, rsd_expr(body), l, col)
}

# A default clause is never split (it must resume in tail position), but a
# `handle` inside it is.
fn rsd_default_clause(c: HClause) : HClause = match c {
  HC(n, ps, body, l, col) -> {
    let body1 = rsd_expr(body)
    let tail_only = match clause_continuation(ps) {
      Some(k) -> rs_all_tail(body1, written_text(k.name))
      None    -> true
    }
    if tail_only { HC(n, ps, body1, l, col) }
    else { HC(n, ps, rs_bad_body(body1, [rs_default_nontail(l, col)]), l, col) }
  }
}
