#[doc("""
The collection of an index expression, typed once.

`coll[ix]` lowers to a getter call whose scheme types the whole read.
The typer walks `coll` first to pick the getter; the call is then typed
against a placeholder bound to that type, and the already-typed `coll`
is spliced back in its place. Walking `coll` a second time would report
every diagnostic inside it twice.
""")]

import compiler.ast
import compiler.ast_map

#[doc("The name the placeholder is bound under. It holds a space, so no source identifier can shadow or reach it.")]
pub fn ixc_name() : String = "index collection"

#[doc("A reference to the placeholder at `at`'s position, so a diagnostic about the argument points at the collection.")]
pub fn ixc_ref(at: Expr) : Expr = mk_ref(ixc_name(), at.line, at.col)

#[doc("`e` with every reference to the placeholder replaced by `typed`.")]
pub fn ixc_splice(e: Expr, typed: Expr) : Expr = match e.kind {
  EVar(n) -> if n == ixc_name() { typed } else { e }
  _ -> Expr { kind: prc_map_expr_kind(e.kind, (x) => ixc_splice(x, typed)),
              line: e.line, col: e.col, ty: e.ty, mode: e.mode }
}
