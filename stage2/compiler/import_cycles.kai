# compiler/import_cycles.kai — the groups of modules that import each other.

import compiler.util
import compiler.ast_decl
import compiler.modules_segments
import compiler.module_table
import compiler.driver_front

#[doc("The homes of each set of modules that import one another, members and sets ordered by file path so the answer does not depend on the order imports were discovered in.")]
pub(pkg) fn import_cycles(rs: ResolveState, mods: [ModuleEntry]) : [[String]] = {
  let edges = rs.rev_edges
  let files = sort(dedup_strings(flat_map(edges, (e) => match e { IE(a, b) -> [a, b] })))
  let ix = (p: String) => index_of_string(files, p)
  let es = map(edges, (e) => match e { IE(a, b) -> (ix(a), ix(b)) })
  let groups = scc_groups(list_length(files), es)
  map(groups, (g) => map(sort(map(g, (i) => nth_string(files, i))), (p) => home_of_file(mods, p)))
}

fn home_of_file(mods: [ModuleEntry], path: String) : String = match mods {
  [] -> ""
  [ME(home, _, origin, _, _), ...rest] -> if origin == path { home } else { home_of_file(rest, path) }
}

fn index_of_string(xs: [String], s: String) : Int = index_from(xs, s, 0)

fn index_from(xs: [String], s: String, i: Int) : Int = match xs {
  []         -> -1
  [x, ...rest] -> if x == s { i } else { index_from(rest, s, i + 1) }
}

fn nth_string(xs: [String], i: Int) : String = match xs {
  []         -> ""
  [x, ...rest] -> if i == 0 { x } else { nth_string(rest, i - 1) }
}

fn dedup_strings(xs: [String]) : [String] = foldl(xs, [], (acc, x) => if list_has(acc, x) { acc } else { [x, ...acc] })

type Chunk = Chunk(String, [Decl])

#[doc("The stream with the members of each import cycle made contiguous, in group order, at the place of the cycle's last member; a module that imports a cycle and sat among its members moves after them.")]
pub(pkg) fn cycles_reorder(rs: ResolveState, mods: [ModuleEntry], groups: [[String]], segs: [ImportSeg], decls: [Decl]) : ([ImportSeg], [Decl]) = {
  let chunks = chunks_of(segs, decls, [])
  let homes = map(chunks, (c) => match c { Chunk(h, _) -> h })
  let deps = home_deps(rs, mods, homes)
  let out = order_chunks(chunks, chunks, groups, deps, [], [], [])
  (map(out, (c) => match c { Chunk(h, ds) -> ISeg(h, list_length(ds)) }), flat_map(out, (c) => match c { Chunk(_, ds) -> ds }))
}

fn chunks_of(segs: [ImportSeg], decls: [Decl], acc: [Chunk]) : [Chunk] = match segs {
  [] -> list_reverse(acc)
  [ISeg(h, n), ...rest] -> chunks_of(rest, drop(decls, n), [Chunk(h, take(decls, n)), ...acc])
}

fn home_deps(rs: ResolveState, mods: [ModuleEntry], homes: [String]) : [(String, String)] =
  flat_map(rs.rev_edges, (e) => match e {
    IE(a, b) -> {
      let ha = home_of_file(mods, a)
      let hb = home_of_file(mods, b)
      if ha != hb and list_has(homes, ha) and list_has(homes, hb) { [(ha, hb)] } else { [] }
    }
  })

fn chunk_home(c: Chunk) : String = match c { Chunk(h, _) -> h }

fn group_of(groups: [[String]], h: String) : [String] = match groups {
  [] -> []
  [g, ...rest] -> if list_has(g, h) { g } else { group_of(rest, h) }
}

fn ready(deps: [(String, String)], emitted: [String], h: String) : Bool =
  all(deps, (d) => d.fst != h or list_has(emitted, d.snd))

fn order_chunks(all_chunks: [Chunk], items: [Chunk], groups: [[String]], deps: [(String, String)],
                emitted: [String], postponed: [Chunk], out: [Chunk]) : [Chunk] = match items {
  [] -> list_append(list_reverse(out), postponed)
  [c, ...rest] -> {
    let h = chunk_home(c)
    let g = group_of(groups, h)
    if list_is_empty(g) {
      if ready(deps, emitted, h) {
        let step = release(groups, deps, [h, ...emitted], postponed, [c, ...out], [])
        order_chunks(all_chunks, rest, groups, deps, step.emitted, step.postponed, step.out)
      } else { order_chunks(all_chunks, rest, groups, deps, emitted, list_append(postponed, [c]), out) }
    } else if any(rest, (r) => list_has(g, chunk_home(r))) {
      order_chunks(all_chunks, rest, groups, deps, emitted, postponed, out)
    } else {
      let members = filter_map_chunks(all_chunks, g)
      let step = release(groups, deps, list_append(g, emitted), postponed, list_append(list_reverse(members), out), [])
      order_chunks(all_chunks, rest, groups, deps, step.emitted, step.postponed, step.out)
    }
  }
}

type Released = { emitted: [String], postponed: [Chunk], out: [Chunk] }

fn release(groups: [[String]], deps: [(String, String)], emitted: [String], waiting: [Chunk], out: [Chunk], keep: [Chunk]) : Released = match waiting {
  [] -> Released { emitted: emitted, postponed: list_reverse(keep), out: out }
  [c, ...rest] -> if ready(deps, emitted, chunk_home(c)) {
    release(groups, deps, [chunk_home(c), ...emitted], list_append(list_reverse(keep), rest), [c, ...out], [])
  } else { release(groups, deps, emitted, rest, out, [c, ...keep]) }
}

fn filter_map_chunks(chunks: [Chunk], g: [String]) : [Chunk] =
  flat_map(g, (h) => filter(chunks, (c) => chunk_home(c) == h))

# strongly connected components of a graph over the node indices `0..n`,
# linear in nodes plus edges (Kosaraju). A component's member order is output
# wherever a caller numbers the members by it (tailfuse tags them), so it is
# fixed here: the reverse of the order a breadth-first walk from the
# component's lowest index dequeues them, each node counted once.

#[doc("The components of two or more members of the graph with `n` nodes and edges `es` (source, target), ordered by their lowest index. Members run in the reverse of the order a breadth-first walk from that index dequeues them, successors in edge order.")]
pub(pkg) fn scc_groups(n: Int, es: [(Int, Int)]) : [[Int]] {
  let succ = scc_adjacency(es, n)
  let pred = scc_adjacency(map(es, (e) => (e.snd, e.fst)), n)
  let comp = scc_component_ids(pred, scc_finish_order(succ, n), n)
  scc_groups_in(succ, comp, n)
}

# One successor list per node, in edge order.
fn scc_adjacency(es: [(Int, Int)], n: Int) : Array[[Int]] =
  scc_adj_fill(list_reverse(es), array_make(n, []))

fn scc_adj_fill(es: [(Int, Int)], adj: Array[[Int]]) : Array[[Int]] / Mutable = match es {
  [] -> adj
  [(a, b), ...rest] -> {
    let cur = array_get(adj, a)
    scc_adj_fill(rest, array_set(adj, a, [b, ...cur]))
  }
}

# Every node, latest-finishing first, of a depth-first walk over `succ`.
# Reads go through closures: handing the arrays themselves to a
# `/ Mutable` helper would make its writes the caller's effect.
fn scc_finish_order(succ: Array[[Int]], n: Int) : [Int] =
  scc_dfs_roots((v) => array_get(succ, v), 0, n, array_make(n, false), [])

fn scc_dfs_roots(succ: (Int) -> [Int], i: Int, n: Int, seen: Array[Bool], fin: [Int]) : [Int] / Mutable =
  if i >= n { fin }
  else if array_get(seen, i) { scc_dfs_roots(succ, i + 1, n, seen, fin) }
  else { match scc_dfs(succ, [(i, succ(i))], array_set(seen, i, true), fin) {
    (seen1, fin1) -> scc_dfs_roots(succ, i + 1, n, seen1, fin1)
  } }

# Each stack frame is an open node and the successors it has yet to try.
fn scc_dfs(succ: (Int) -> [Int], stack: [(Int, [Int])], seen: Array[Bool], fin: [Int]) : (Array[Bool], [Int]) / Mutable = match stack {
  [] -> (seen, fin)
  [(v, ws), ...rest] -> match ws {
    [] -> scc_dfs(succ, rest, seen, [v, ...fin])
    [w, ...more] ->
      if array_get(seen, w) { scc_dfs(succ, [(v, more), ...rest], seen, fin) }
      else { scc_dfs(succ, [(w, succ(w)), (v, more), ...rest], array_set(seen, w, true), fin) }
  }
}

# Each root of `order` claims, as one component, what it reaches over
# `pred` that no earlier root claimed.
fn scc_component_ids(pred: Array[[Int]], order: [Int], n: Int) : Array[Int] =
  scc_assign((v) => array_get(pred, v), order, array_make(n, 0 - 1), 0)

fn scc_assign(pred: (Int) -> [Int], order: [Int], comp: Array[Int], c: Int) : Array[Int] / Mutable = match order {
  [] -> comp
  [v, ...rest] ->
    if array_get(comp, v) >= 0 { scc_assign(pred, rest, comp, c) }
    else { scc_assign(pred, rest, scc_claim(pred, [v], comp, c), c + 1) }
}

fn scc_claim(pred: (Int) -> [Int], todo: [Int], comp: Array[Int], c: Int) : Array[Int] / Mutable = match todo {
  [] -> comp
  [v, ...rest] ->
    if array_get(comp, v) >= 0 { scc_claim(pred, rest, comp, c) }
    else { scc_claim(pred, list_append(pred(v), rest), array_set(comp, v, c), c) }
}

fn scc_groups_in(succ: Array[[Int]], comp: Array[Int], n: Int) : [[Int]] =
  scc_groups_at((v) => array_get(succ, v), (v) => array_get(comp, v), 0, n, array_make(n, false), [])

fn scc_groups_at(succ: (Int) -> [Int], comp: (Int) -> Int, i: Int, n: Int, done: Array[Bool], acc: [[Int]]) : [[Int]] / Mutable =
  if i >= n { list_reverse(acc) }
  else if array_get(done, i) { scc_groups_at(succ, comp, i + 1, n, done, acc) }
  else { match scc_bfs(succ, comp, comp(i), [i], [], done, []) {
    (ms, done1) -> scc_groups_at(succ, comp, i + 1, n, done1, if list_length(ms) >= 2 { [ms, ...acc] } else { acc })
  } }

# The queue is `front` plus reversed `back`. Staying inside component
# `c` keeps its members' dequeue order: a path that leaves it never
# comes back.
fn scc_bfs(succ: (Int) -> [Int], comp: (Int) -> Int, c: Int, front: [Int], back: [Int],
           done: Array[Bool], acc: [Int]) : ([Int], Array[Bool]) / Mutable = match front {
  [] -> if list_is_empty(back) { (acc, done) } else { scc_bfs(succ, comp, c, list_reverse(back), [], done, acc) }
  [v, ...rest] ->
    if array_get(done, v) or comp(v) != c { scc_bfs(succ, comp, c, rest, back, done, acc) }
    else { scc_bfs(succ, comp, c, rest, list_append(list_reverse(succ(v)), back), array_set(done, v, true), [v, ...acc]) }
}
