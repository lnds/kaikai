# compiler/home_spell.kai — the home-spelled name a contested declaration
# is keyed by, and the name the user wrote behind it.
#
# Two modules declaring the same name each get `<name>__<home>`; the
# suffix is an identifier piece so every symbol minted from the name
# stays one. Core and root declarations never carry it.

import compiler.util

#[doc("A module path as an identifier piece: dots become underscores.")]
pub fn hs_ident(home: String) : String = hs_ident_loop(home, 0, string_length(home), "")

fn hs_ident_loop(s: String, i: Int, n: Int, acc: String) : String =
  if i >= n { acc }
  else { match char_at(s, i) {
    Some(c) -> {
      let piece = if c == '.' { "_" } else { int_to_byte_string(char_to_int(c)) }
      hs_ident_loop(s, i + 1, n, string_concat(acc, piece))
    }
    None    -> acc
  } }

#[doc("`name` as declared by `home`: `Item__da`.")]
pub fn hs_spell(name: String, home: String) : String =
  concat_all([name, "__", hs_ident(home)])

#[doc("The name the user wrote for a declaration spelled by `hs_spell`: the home suffix removed when the declaration carries that home.")]
pub fn hs_display(name: String, mo: Option[String]) : String = match mo {
  None -> name
  Some(m) -> {
    let suffix = string_concat("__", hs_ident(m))
    let n = string_length(name)
    let k = string_length(suffix)
    if n > k and string_slice(name, n - k, k) == suffix { string_slice(name, 0, n - k) }
    else { name }
  }
}
