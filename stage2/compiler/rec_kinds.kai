#[doc("""
The slot kind of every field of a declared record.

A record cell stores a field declared `Int` or `Real` as a raw word and every
other field as a pointer. The kinds come from the declaration alone, so every
writer (literal, rebuild, runtime) and every reader of one record type agree
without looking at the cell.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.type_home
import compiler.scalar_ty

#[doc("The slot kinds of the record `s`'s fields in declaration order: 1 Int, 2 Real, 0 pointer. Empty for a record `recs` does not hold, and all pointers for one wider than the slot mask.")]
pub(pkg) fn rec_kinds_of(recs: [RecInfo], s: SymId) : [Int] = match rec_find(recs, s) {
  Some(RI(_, _, fs, _)) ->
    if list_length(fs) > raw_slot_cap() { repeat(0, list_length(fs)) } else { map(fs, rk_field_kind) }
  None -> []
}

fn rk_field_kind(f: FieldDecl) : Int = match f {
  FD(_, _, te, _, _, _) -> match te.tkind {
    TyName(r, targs) ->
      if list_length(targs) != 0 {
        0
      } else {
        match scalar_ty_named(ref_spelled(r)) {
          Some(TyInt) -> 1
          Some(TyReal) -> 2
          _ -> 0
        }
      }
    _ -> 0
  }
}

#[doc("The kind of slot `i` of the record `s`.")]
pub(pkg) fn rec_slot_kind(recs: [RecInfo], s: SymId, i: Int) : Int = rk_kind_at(rec_kinds_of(recs, s), i)

#[doc("The kind of the field `fname` of the record `s`; 0 when `s` declares no such field.")]
pub(pkg) fn rec_field_kind_named(recs: [RecInfo], s: SymId, fname: String) : Int =
  match rec_field_index(recs, s, fname) {
    Some(i) -> rec_slot_kind(recs, s, i)
    None -> 0
  }

fn rk_kind_at(ks: [Int], i: Int) : Int = match ks {
  [] -> 0
  [k, ...rest] -> if i == 0 { k } else { rk_kind_at(rest, i - 1) }
}
