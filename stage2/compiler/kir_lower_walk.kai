#[doc("The KIR lowering walk: expression dispatch, raw and boxed forms, loops, lists, records and vector reads and writes. Mutually recursive with kir_lower_stmts and kir_lower_calls.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.real_lit
import compiler.written
import compiler.symtab
import compiler.marks
import compiler.util
import compiler.fnreg
import compiler.rec_stamp
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.kir
import compiler.kir_lower
import compiler.unwind_pend
import compiler.kir_lower_reuse
import compiler.kir_lower_scalar
import compiler.kir_lower_exits
import compiler.kir_lower_raw
import compiler.vec_raw
import compiler.raw_border
import compiler.effect_instance
import compiler.kir_lower_stmts
import compiler.kir_lower_forms
import compiler.kir_lower_calls
import compiler.kir_lower_sig

# Lower an expression in BOXED position (the default — every value-bearing
# slot a call/record/list/return wants is a boxed `ptr`). MODE-SLAVE to the
# unbox pass (asu, Camino A): a `MUnboxed` Real node is a raw `f64` in a
# boxed context, so lower it RAW (`lower_expr_raw`) and BOX at the border
# (`real.box` → `kaix_real`). The boxed `KLet` carries `SBoxed`, identical
# to the oracle's `box_wrap(x.ty, raw)`. `MUnboxed` nodes outside the raw
# FORM set (see kir_lower_raw SCOPE) fall straight to the boxed dispatch.
# Non-`MUnboxed` nodes (the boxed families other lanes own) never enter
# the raw branch: purely additive.
pub fn lower_expr(x: Expr, st: LowerSt) : LRes / Console = match unw_pad_of(st.unw, x) {
  Some(ns) -> match lower_pad_begin(x, ns, st) { PadB(outer, st1) -> match lower_expr_unpadded(x, st1) {
    LRes(v, st2) -> LRes(v, lower_pad_end(x, outer, st2))
  } }
  None     -> lower_expr_unpadded(x, st)
}

fn lower_expr_unpadded(x: Expr, st: LowerSt) : LRes / Console =
  if kir_node_is_raw(x) {
    match lower_expr_raw(x, st) {
      LRes(rawv, st1) -> bind_op(st1, KPrim(kir_raw_box_prim(x.ty), [rawv]), kpos_of(x))
    }
  } else if fixed_vec_needs_materialize(x) { lower_fixed_vec_materialize(x, st) }
  else { lower_expr_boxed(x, st) }

# The boxed-position dispatch (the original `lower_expr` body). Reached
# either directly (non-raw node) or as the boxed fallback inside the raw
# path (`lower_expr_raw`'s box→raw border lowers boxed here then unboxes).
pub(pkg) fn lower_expr_boxed(x: Expr, st: LowerSt) : LRes / Console = match unw_pad_of(st.unw, x) {
  Some(ns) -> match lower_pad_begin(x, ns, st) { PadB(outer, st1) -> match lower_expr_boxed_unpadded(x, st1) {
    LRes(v, st2) -> LRes(v, lower_pad_end(x, outer, st2))
  } }
  None     -> lower_expr_boxed_unpadded(x, st)
}

fn lower_expr_boxed_unpadded(x: Expr, st: LowerSt) : LRes / Console = match x.kind {
  # Atoms: no statement, the literal IS the value.
  EInt(n, _) -> LRes(kir_int_atom(x, n), st)
  EReal(RealLit(r), _)  -> LRes(KRealV(r), st)
  EFixed(span, ty)      -> LRes(KFixedV(span, ty), st)
  EBool(b)           -> LRes(KBoolV(b), st)
  EChar(c)           -> LRes(KCharV(c), st)
  EStr(span, _)      -> LRes(KStrV(span), st)
  EUnit              -> LRes(KUnitV, st)
  EUnder             -> LRes(KUnitV, st)
  EPlaceholder       -> LRes(KUnitV, st)
  ELocal(l)          -> lower_local(l, st)
  ESym(s, inst)      -> lower_sym(FnId(s, inst), st)
  # In value position a mark reads the register an earlier pass bound under
  # its spelling — the match preamble's scrutinee alias. Without this the
  # donor of a reuse-in-place lowers to unit, the rebuild stops recognising
  # it, and the reuse is silently lost: no leak, just no reuse.
  EMark(m)           -> LRes(KVar(mark_name(m)), st)

  # A call / constructor / perceus mark / sentinel — the dense dispatch.
  # A fixed-width `Vec[t]<n>` intrinsic lowers inline (a flat header-less
  # aggregate), NOT to the dynamic `vec_*` chain — mirroring the C backend's
  # inline representation.
  ECall(f, cargs)    -> match lower_fixed_vec_call(x, f, cargs, st) {
    Some(r) -> r
    None -> match lower_vec_write_rec_fused(x, f, cargs, st) {
      Some(r) -> r
      None    -> lower_call(x, f, cargs, st)
    }
  }

  # `e.field` → a field read over the base atom. When `base.ty` resolves to
  # a known record, the field's slot is a compile-time constant (layout is
  # canonical, declaration order) → `kai_op_field_at` indexed load, skipping
  # the `kai_op_field` strcmp. Unknown / polymorphic base type keeps strcmp.
  # The read increfs the field; the base arrives OWNED (perceus dups non-last
  # reads, transfers single-use, ctors return rc=1) and is no longer reachable
  # through the result, so drop it to balance — the C oracle's `kai_decref(_b)`
  # after the field load.
  EField(base, fname) -> lower_field_boxed(x, base, fname, st)

  # Binary / unary operators → a KPrim over their operand atoms. The
  # specific runtime helper is the translator's concern.
  #
  # `and`/`or` are the exception: a KPrim evaluates BOTH operand atoms
  # before the helper runs, which destroys the short-circuit the surface
  # language guarantees — `f != 0 and n % f == 0` would divide by zero on
  # the very path the guard exists to prevent. (The C backend hides this:
  # it emits a `?:` around the RHS. The native backend calls `kaix_and`,
  # whose arguments are already materialised.) Route them through the
  # branch machinery instead: `a and b` is `if a { b } else { false }`,
  # `a or b` is `if a { true } else { b }`.
  EBinop(op, a, b)   -> lower_binop_boxed(x, op, a, b, st)
  EUnop(op, a)       -> {
    let ra = lower_expr(a, st)
    match ra { LRes(av, st1) -> bind_op(st1, KPrim(KpUn(op), [av]), kpos_of(x)) }
  }

  EIf(c, t, e_opt)   -> lower_if(x, c, t, e_opt, st)
  EMatch(scr, arms)  -> lower_match(x, scr, arms, st)
  EBlock(stmts, tail) -> lower_block(x, stmts, tail, st)

  # `[e0, e1, ..., ...spread]` → a cons/nil/append spine, reproducing the
  # C emitter's `emit_list_tail` shape (the oracle). Interpolation
  # desugars to `string_concat_all([parts])` long upstream, so closing
  # EList closes interpolation too.
  EList(elems)       -> lower_list(elems, kpos_of(x), st)

  # Unit-annotated literal (`1.0<USD>`) is codegen-erased to its inner.
  ELitUnit(inner, _) -> lower_expr(inner, st)

  # An unfilled hole / `todo!(msg)` lowers to a loud runtime panic stub
  # (mirror of the emitters: a binary with holes is runnable but aborts
  # on first reach). The message bundles the location like emit_c does.
  EHole(nm_opt)      -> lower_panic_stub(kir_hole_message(nm_opt, x), st)
  ETodo(msg)         -> lower_panic_stub(kir_quote(cat2("todo: ", msg)), st)
  EExternBody(_, _)  -> lower_panic_stub(kir_quote("extern body in expression position"), st)
  # Textual literals are minted away by the typer; reaching lowering is a
  # compiler bug.
  EIntLit(_)         -> lower_panic_stub(kir_quote("EIntLit reached lowering"), st)
  EDecimalLit(_)     -> lower_panic_stub(kir_quote("EDecimalLit reached lowering"), st)

  # `variants[T]()` — the typer baked the resolved nullary constructors in;
  # materialise them as a cons spine of nullary constructors.
  EVariantsOf(_, ctors) -> lower_variants_of(ctors, kpos_of(x), st)

  # A record literal `T { f: v, ... }` → a `kai_record(n, fields, names)`
  # allocation. Lower each field value (left-to-right), pairing with its
  # name; the translator builds the parallel value/name buffers.
  ERecordLit(_, fis) -> lower_record_lit(fis, rec_stamp_of(st.stamps, x.ty), kpos_of(x), st)

  # A range `lo..hi` / `lo..hi:step` → the runtime range builder.
  ERange(lo, hi, stp) -> lower_range(lo, hi, stp, kpos_of(x), st)

  # An inline lambda → a `KClosure` over its lifted-body thunk symbol
  # (`lam_symbol`), carrying its captures as atoms. The lifted body
  # itself is a separate `KFnLambda` (generated in `lower_to_kir`); here
  # we only build the closure value. The `LamInfo` is found by
  # (enclosing-fn, line, col) — the key the collector stamped.
  ELambda(_, _)      -> lower_lambda_ref(x, st)

  # An effect handler. Materialises the handler frame as a double fork
  # (install + setjmp-split + inline body + return clause), the same
  # block-building discipline as if/match (asu review). The clause bodies
  # are separate `KFnClause`s generated in `lower_to_kir`.
  EHandle(body, eff, tas, init_opt, alias_opt, clauses, ret_opt) ->
    lower_handle(x, body, inst_key_of_tes(ref_sym(eff), tas), init_opt, alias_opt, clauses, ret_opt, st)

  # Postfix `!` — Option/Result propagation. `expr!` unwraps the success
  # payload, or EARLY-RETURNS the whole `None`/`Err` from the enclosing fn
  # (mirror of emit_c's `emit_bang`). The discriminator (`Some` vs `Ok`) is
  # read from `inner.ty` via the shared `bang_success_variant`.
  EBang(inner)       -> lower_bang(x, inner, st)

  # A promoted var cell in boxed position: a read boxes the raw register
  # at its scalar type; a write stores the raw value and yields unit. A
  # loop intrinsic pastes its pred/body lambda bodies into an inline
  # block loop in the enclosing fn (the C emitter's `for (;;)` mirror).
  EIntrinsic(inm, iargs) -> lower_intrinsic_boxed(x, inm, iargs, st)

  # Forms the resolve / desugar / typer passes rewrite away before codegen
  # (every pipe → ECall, `EIndex` → call, `EUnder`/`EPlaceholder`
  # pattern-only). These never reach a post-perceus AST; lowering to unit
  # keeps the match exhaustive and mirrors the emitters' dead arms.
  EPipe(_, _)        -> LRes(KUnitV, st)
  EDispatchPipe(_, _, _) -> LRes(KUnitV, st)
  EIndex(_, _)       -> LRes(KUnitV, st)

  # Anything else reaching here is a node codegen DOES handle that the
  # lowering has not yet covered — a silent unit would mis-lower it (the
  # Lane 0 gap class). Trap it loudly during development so the next
  # unhandled family cannot slip through unnoticed (lane discipline).
  _ -> lower_unhandled(x, st)
}

# A known record base gives the field a compile-time slot (`kai_op_field_at`);
# otherwise the read goes by name. The base arrives owned and is not reachable
# through the result, so it is dropped after the read.
fn lower_field_boxed(x: Expr, base: Expr, fname: String, st: LowerSt) : LRes / Console =
  match lower_vec_get_field_fused(x, base, fname, st) {
    Some(r) -> r
    None -> match lower_expr(base, st) { LRes(bv, st1) ->
      match field_index_of(st1.recs, base.ty, fname) {
        Some(n) -> lower_field_read(st1, KPrim(KpFieldAt, [bv, KIntV(n)]), bv, kpos_of(x))
        None    -> lower_field_read(st1, KPrim(KpField, [bv, KStrV(fname)]), bv, kpos_of(x))
      } }
  }

# `and` / `or` short-circuit, so they lower as branches: a `KPrim` would
# evaluate both operand atoms before the helper runs.
fn lower_binop_boxed(x: Expr, op: BinOp, a: Expr, b: Expr, st: LowerSt) : LRes / Console = match op {
  BoAnd -> lower_if(x, a, b, Some(mk_typed_bool(false, x)), st)
  BoOr  -> lower_if(x, a, mk_typed_bool(true, x), Some(b), st)
  _     -> match lower_expr(a, st) { LRes(av, st1) ->
    match lower_expr(b, lower_flight_add(a, av, st1)) { LRes(bv, st2) -> {
      let st3 = lower_flight_end(st1, st2)
      match lower_consumed_pad(x, op, [(a, av), (b, bv)], st3) { PadB(outer, st4) ->
        match bind_op(st4, KPrim(binop_prim(op, a, st4), [av, bv]), kpos_of(x)) {
          LRes(v, st5) -> LRes(v, lower_pad_end(x, outer, st5))
        } }
    } } }
}

# A cell read boxes its raw register; a loop intrinsic pastes its predicate and
# body lambdas into an inline loop in the enclosing function.
fn lower_intrinsic_boxed(x: Expr, inm: Intrinsic, iargs: [Expr], st: LowerSt) : LRes / Console = match inm {
  InCellGet     -> bind_op(st, KPrim(kir_raw_box_prim(x.ty), [KVar(lower_cell_reg(iargs, st))]), kpos_of(x))
  InCellSet     -> lower_cell_set(x, inm, iargs, st)
  InLoopWhile   -> lower_loop_intrinsic(x, inm, iargs, st)
  InLoopUntil   -> lower_loop_intrinsic(x, inm, iargs, st)
  InLoopRepeat  -> lower_loop_intrinsic(x, inm, iargs, st)
  InResumeFrame -> lower_resume_frame(x, iargs, st)
  InSegHandle   -> lower_seg_handle(x, iargs, st)
  InSegRequest  -> lower_seg_request(x, iargs, st)
  InAbsent      -> LRes(KUnitV, st)
  InCovHit(s)   -> LRes(KUnitV, ls_emit(st, KDo(KPrim(KpCovHit, [KStrV(json_quote(s))]), kpos_of(x))))
  _             -> lower_unhandled(x, st)
}

# --- raw (unboxed) scalar lowering ----------------------------------------
#
# Lower `x` in RAW position: the result is a raw scalar register, not a
# boxed `ptr`. Mirror of the C oracle's `emit_expr_raw`: a `MUnboxed` node is
# natively raw; any other crosses the box→raw border (`raw_border.kai`). The
# mutual recursion with `lower_expr` is why this lives in the Expr-SCC.
pub(pkg) fn lower_expr_raw(x: Expr, st: LowerSt) : LRes / Console = match unw_pad_of(st.unw, x) {
  Some(ns) -> match lower_pad_begin(x, ns, st) { PadB(outer, st1) -> match lower_expr_raw_unpadded(x, st1) {
    LRes(v, st2) -> LRes(v, lower_pad_end(x, outer, st2))
  } }
  None     -> lower_expr_raw_unpadded(x, st)
}

fn lower_expr_raw_unpadded(x: Expr, st: LowerSt) : LRes / Console = {
  let xb = raw_operand(x)
  match xb.mode {
    MUnboxed -> lower_expr_raw_kind(xb, st)
    _        -> lower_scalar_unbox_border(xb, st)
  }
}

# Lower `x` raw at a KNOWN destination slot (a call arg at its param's raw
# slot). The border keys off the param's slot, not `x.ty`: an arg the typer
# left untyped would otherwise cross as a Real.
pub(pkg) fn lower_expr_raw_at(x: Expr, slot: KSlot, st: LowerSt) : LRes / Console = match unw_pad_of(st.unw, x) {
  Some(ns) -> match lower_pad_begin(x, ns, st) { PadB(outer, st1) -> match lower_expr_raw_at_unpadded(x, slot, st1) {
    LRes(v, st2) -> LRes(v, lower_pad_end(x, outer, st2))
  } }
  None     -> lower_expr_raw_at_unpadded(x, slot, st)
}

fn lower_expr_raw_at_unpadded(x: Expr, slot: KSlot, st: LowerSt) : LRes / Console = {
  let xb = raw_operand(x)
  match xb.mode {
    MUnboxed -> lower_expr_raw_kind(xb, st)
    _        -> lower_scalar_unbox_border_at(xb, slot, st)
  }
}

# The box→raw border at a KNOWN slot. A `SBoxed` slot is a lowering bug (a
# raw arg never targets a boxed param): lower plain boxed so the value is at
# least well-formed.
fn lower_scalar_unbox_border_at(x: Expr, slot: KSlot, st: LowerSt) : LRes / Console =
  match border_unbox_prim(slot) {
    Some(prim) -> lower_unbox_border(x, prim, slot, st)
    None       -> lower_expr_boxed(x, st)
  }

# The type-driven border. The type gate is load-bearing: a Bool crossing
# through `real.unbox` reads `as.r` off a Bool, which LLVM rejects.
fn lower_scalar_unbox_border(x: Expr, st: LowerSt) : LRes / Console =
  lower_scalar_unbox_border_at(x, border_slot_of(x.ty), st)

pub(pkg) fn lower_unbox_border(x: Expr, prim: PrimOp, slot: KSlot, st: LowerSt) : LRes / Console =
  lower_unbox_at(x, prim, slot, raw_border_owns(x), st)

# Unbox `x`'s boxed form through `prim`, releasing the box when it is owned.
pub(pkg) fn lower_unbox_at(x: Expr, prim: PrimOp, slot: KSlot, owned: Bool, st: LowerSt) : LRes / Console =
  match lower_expr_boxed(x, st) { LRes(bv, st1) -> lower_unbox_owned(x, bv, prim, slot, owned, st1) }

# The call result `bv` of `x`, unwrapped and released as the border does.
fn lower_unbox_value(x: Expr, bv: KVal, prim: PrimOp, slot: KSlot, st: LowerSt) : LRes / Console =
  lower_unbox_owned(x, bv, prim, slot, raw_border_owns(x), st)

fn lower_unbox_owned(x: Expr, bv: KVal, prim: PrimOp, slot: KSlot, owned: Bool, st: LowerSt) : LRes / Console =
  match bind_op_slot(st, KPrim(prim, [bv]), slot, kpos_of(x)) {
    LRes(rv, st2) -> if owned { LRes(rv, release_border_box(x, slot, bv, st2)) } else { LRes(rv, st2) }
  }

# The natively-raw forms (the `MUnboxed` kinds the unbox pass produces).
# Real arith / neg yield `SReal`; Int arith yields `SInt64`; comparison /
# logical yield `SBool`. A comparison routes to the f- or i-prim by OPERAND
# type. Anything else falls back to the type-driven box→raw border (a
# defensive unbox of its boxed form) — never a silent miscompile.
fn lower_expr_raw_kind(x: Expr, st: LowerSt) : LRes / Console = match x.kind {
  EReal(RealLit(r), _) -> LRes(KRealV(r), st)
  EInt(n, _) -> LRes(KIntV(n), st)
  EFixed(span, ty) -> LRes(KFixedV(span, ty), st)
  EBool(b)    -> LRes(KBoolV(b), st)
  EChar(c)    -> LRes(KCharV(c), st)
  ELocal(l)   -> lower_local(l, st)
  ELitUnit(inner, _) -> lower_expr_raw(inner, st)
  EBinop(op, a, b) -> lower_raw_arith(x, op, a, b, st)
  EUnop(op, a) -> lower_raw_unop(x, op, a, st)
  ECall(f, cargs) -> lower_raw_call(x, f, cargs, st)
  EField(_, _) -> match vec_raw_read(st.recs, x.kind, x.ty) {
    Some(rd) -> lower_vec_raw_read(x, rd, st)
    None     -> lower_scalar_unbox_border(x, st)
  }
  EBlock(stmts, tail) -> lower_raw_block(x, stmts, tail, st)
  EIntrinsic(inm, iargs) -> lower_raw_intrinsic(x, inm, iargs, st)
  # Only the forms above are admitted as raw; this arm is reached by recursion
  # on an operand the unbox pass left boxed.
  _ -> lower_scalar_unbox_border(x, st)
}

# Arith routes by the RESULT type, a comparison by the OPERAND type: routing
# by operator alone would send Int `+` down the Real `f+` path.
fn lower_raw_arith(x: Expr, op: BinOp, a: Expr, b: Expr, st: LowerSt) : LRes / Console =
  if kir_ty_is_real(x.ty) and kir_op_is_raw_freal_arith(op) {
    lower_raw_binop(x, KpRawBin(RwReal, op), SReal, a, b, st)
  }
  else if kir_ty_is_int(x.ty) and kir_op_is_raw_iint_arith(op) {
    lower_raw_binop(x, KpRawBin(RwInt, op), SInt64, a, b, st)
  }
  else if kir_ty_is_byte(x.ty) and kir_op_is_raw_iint_arith(op) {
    lower_raw_binop(x, KpRawBin(RwByte, op), SByte, a, b, st)
  }
  else if kir_ty_is_fixed_raw(x.ty) and kir_op_is_raw_iint_arith(op) {
    lower_raw_binop(x, KpRawBin(kir_fixed_raw_scalar(x.ty), op), kir_fixed_raw_slot(x.ty), a, b, st)
  }
  else if kir_op_is_raw_cmp(op) { lower_raw_cmp(x, op, a, b, st) }
  else if kir_op_is_raw_logical(op) { lower_raw_binop(x, KpRawBin(RwBool, op), SBool, a, b, st) }
  else { lower_scalar_unbox_border(x, st) }

fn lower_raw_cmp(x: Expr, op: BinOp, a: Expr, b: Expr, st: LowerSt) : LRes / Console =
  if kir_ty_is_int(a.ty) { lower_raw_binop(x, KpRawBin(RwInt, op), SBool, a, b, st) }
  else if kir_ty_is_byte(a.ty) { lower_raw_binop(x, KpRawBin(RwByte, op), SBool, a, b, st) }
  else if kir_ty_is_bool(a.ty) { lower_raw_binop(x, KpRawBin(RwBool, op), SBool, a, b, st) }
  else if kir_ty_is_char(a.ty) { lower_raw_binop(x, KpRawBin(RwChar, op), SBool, a, b, st) }
  else if kir_ty_is_fixed_raw(a.ty) { lower_raw_binop(x, KpRawBin(kir_fixed_raw_scalar(a.ty), op), SBool, a, b, st) }
  else { lower_raw_binop(x, KpRawBin(RwReal, op), SBool, a, b, st) }

# Unary `-` is raw only for Real: an Int `-x` has no raw form and crosses the
# border, since `fneg` over a boxed or i64 operand miscompiles.
fn lower_raw_unop(x: Expr, op: UnOp, a: Expr, st: LowerSt) : LRes / Console = match op {
  UoNeg ->
    if kir_ty_is_real(x.ty) {
      match lower_expr_raw(a, st) {
        LRes(av, st1) -> bind_op_slot(st1, KPrim(KpRawUn(UoNeg), [av]), SReal, kpos_of(x))
      }
    } else { lower_scalar_unbox_border(x, st) }
  UoNot -> match lower_expr_raw(a, st) {
    LRes(av, st1) -> bind_op_slot(st1, KPrim(KpRawUn(UoNot), [av]), SBool, kpos_of(x))
  }
}

# A call in raw position goes through the ordinary call dispatch, which binds
# the result at the callee's return slot; a boxed return is unbox-borrowed by
# the consumer. A fixed-vec read has no callee and lowers to the inline prim.
fn lower_raw_call(x: Expr, f: Expr, cargs: [Expr], st: LowerSt) : LRes / Console =
  if kir_is_scalar_conv(f, cargs) { lower_scalar_conv_raw(x, f, cargs, st) }
  else { match lower_fixed_vec_read_raw(x, f, cargs, st) {
    Some(r) -> r
    None    -> match vec_raw_read(st.recs, x.kind, x.ty) {
      Some(rd) -> lower_vec_raw_read(x, rd, st)
      None     -> lower_raw_call_result(x, f, lower_call(x, f, cargs, st))
    }
  } }

# A callee that returns a boxed scalar leaves it for the raw reader to unwrap
# and release; a raw-return callee already landed its register.
fn lower_raw_call_result(x: Expr, f: Expr, r: LRes) : LRes / Console = match r {
  LRes(v, st1) -> if call_returns_boxed(f, st1) {
    match border_unbox_prim(border_slot_of(x.ty)) {
      Some(prim) -> lower_unbox_value(x, v, prim, border_slot_of(x.ty), st1)
      None       -> r
    }
  } else { r }
}

fn call_returns_boxed(f: Expr, st: LowerSt) : Bool = match f.kind {
  ESym(s, inst) -> match ls_ctor_lay(st, s) {
    Some(_) -> false
    None    -> match ls_classify(st, FnId(s, inst)) {
      CkDirect -> match ret_slot_of_sig(ls_call_sig(st, FnId(s, inst))) { SBoxed -> true _ -> false }
      _        -> false
    }
  }
  ELocal(_) -> true
  _         -> false
}

# A plain block lowers its statements in its own scope and its tail at the raw
# slot; a region block lowers boxed and unbox-borrows at the border.
fn lower_raw_block(x: Expr, stmts: [Stmt], tail: Option[Expr], st: LowerSt) : LRes / Console =
  match stmts {
    [] -> match tail { Some(t) -> lower_expr_raw(t, st) None -> lower_scalar_unbox_border(x, st) }
    _  -> if block_is_region(st.regions, x.line, x.col) { lower_scalar_unbox_border(x, st) }
          else { lower_plain_block_at(x, stmts, tail, border_slot_of(x.ty), st) }
  }

# A promoted var cell reads as its raw register; the init forwards its literal.
fn lower_raw_intrinsic(x: Expr, inm: Intrinsic, iargs: [Expr], st: LowerSt) : LRes / Console = match inm {
  InCellGet  -> LRes(KVar(lower_cell_reg(iargs, st)), st)
  InCellInit -> match iargs {
    [init] -> lower_expr_raw(init, st)
    _      -> lower_scalar_unbox_border(x, st)
  }
  InAbsent   -> lower_absent_raw(x, st)
  _          -> lower_scalar_unbox_border(x, st)
}

# A zero of the slot's scalar type; a width with no immediate goes
# through the border from the boxed absent value.
fn lower_absent_raw(x: Expr, st: LowerSt) : LRes / Console = match border_slot_of(x.ty) {
  SInt64 -> LRes(KIntV(0), st)
  SBool  -> LRes(KBoolV(false), st)
  SReal  -> LRes(KRealV(0.0), st)
  _      -> lower_scalar_unbox_border(x, st)
}

# `a <op> b` raw binary op → one native instruction over two raw operands.
# Both operands lower raw (recursing through `lower_expr_raw`); the result
# register carries `slot` (SReal for arith, SBool for cmp/logical). No
# boxed `kaix_*` consume, so a multi-use operand never double-frees (the
# family's root bug).
fn lower_raw_binop(x: Expr, prim: PrimOp, slot: KSlot, a: Expr, b: Expr, st: LowerSt) : LRes / Console =
  match lower_expr_raw(a, st) { LRes(av, st1) ->
    match lower_expr_raw(b, st1) { LRes(bv, st2) ->
      bind_op_slot(st2, KPrim(prim, [av, bv]), slot, kpos_of(x))
    }
  }

# A declaration in value position resolves in this order:
#   1. nullary constructor (`None` / `Red`) → a `KCon`;
#   2. top-level `const` (`ANSWER`, `real_pi`) → its literal body INLINE (a
#      const is a literal with a name, not a function). This needs the
#      recursion into `lower_expr`, so it lives here, not in the base;
#   3. first-class fn value — a top-level fn OR a core builtin with a
#      runtime thunk (`int_to_string` passed to `map`) → a `KClosure`.
# Anything else reads a register spelled like the declaration, which the
# native walk aborts on as unbound.
fn lower_sym(fid: FnId, st: LowerSt) : LRes / Console = match ls_ctor_lay(st, fnid_sym(fid)) {
  Some(c) -> bind_op(st, KCon(c.name, c.tag, 0, [], false), KNoPos)
  None    -> match kir_const_body(st.consts, fnid_sym(fid)) {
    Some(body) -> lower_expr(body, st)
    None       -> match ls_fn_value(st, fid) {
      Some(FV(thunk, arity)) -> bind_op(st, KClosure(thunk, arity, []), KNoPos)
      None                   -> LRes(KVar(ls_fn_name(st, fid)), st)
    }
  }
}

# Lower a list of expressions left-to-right (Risk 2a), collecting atoms.
pub fn lower_exprs(xs: [Expr], st: LowerSt, acc: [KVal]) : LResMany / Console = match lower_exprs_flying(xs, st, acc) {
  LResMany(vs, st1) -> LResMany(vs, lower_flight_end(st, st1))
}

# Each value computed stays in flight while the later operands run.
fn lower_exprs_flying(xs: [Expr], st: LowerSt, acc: [KVal]) : LResMany / Console = match xs {
  [] -> LResMany(acc, st)
  [e, ...rest] -> match lower_expr(e, st) {
    LRes(v, st1) -> lower_exprs_flying(rest, lower_flight_next(e, v, rest == [], st1), list_append(acc, [v]))
  }
}

# P3: lower a self-tail-call's args at the DESTINATION param slots. When
# the recursing fn has a raw signature, an arg whose param is raw lowers
# RAW (`lower_expr_raw` → a raw register, NO trailing `int.box`); the
# native back-edge then re-stores it raw with no `kaix_int`/`kaix_int_field`
# round-trip (the per-iteration re-box that kept the boxed loop ~20× slower
# than C even after the params themselves went raw). A boxed param keeps
# the boxed `lower_expr`. With no raw signature (`None`) this is exactly
# `lower_exprs`. The arg's type equals its param's type (a well-typed tail
# call), so `lower_expr_raw` yields the param's scalar slot.
# Lower each arg at its PARAM's KSlot (`param_slot_for` — `mask[i]` AND the
# type mapping to a raw KIR slot). An arg lowers RAW only when the param's
# slot is raw (`SInt64`/`SReal`/`SBool`); a `SBoxed` param keeps the boxed
# `lower_expr`. This is stricter than the bare `mask[i]`: a `Char`/`Handle`
# param is `mask=true` (unboxable) yet maps to `SBoxed` (no raw KIR register
# form), so lowering it raw would `real.unbox` a boxed Char (a miscompile —
# native returned 0 vs C's 5 on a `Char` param). Using the slot keeps the arg
# repr in lockstep with the param the callee declares (`lower_params_sig`).
pub(pkg) fn lower_tcrec_args(xs: [Expr], sig: Option[UFnSig], st: LowerSt) : LResMany / Console =
  match lower_tcrec_args_idx(xs, tcrec_ptys_of(sig), tcrec_mask_of(sig), st, []) {
    LResMany(vs, st1) -> LResMany(vs, lower_flight_end(st, st1))
  }

fn lower_tcrec_args_idx(xs: [Expr], ptys: [Ty], mask: [Bool], st: LowerSt, acc: [KVal]) : LResMany / Console = match xs {
  [] -> LResMany(acc, st)
  [e, ...rest] -> {
    let pslot = param_slot_for(ptys, mask)
    let trest = match ptys {
      [_, ...r] -> r
      [] -> []
    }
    let mrest = match mask {
      [_, ...r] -> r
      [] -> []
    }
    match lower_tcrec_arg(e, pslot, list_length(acc), st) {
      LRes(v, st1) -> lower_tcrec_args_idx(rest, trest, mrest, lower_flight_next(e, v, rest == [], st1), list_append(acc, [v]))
    }
  }
}

# Lower the `i`-th arg at its PARAM's slot: a raw param slot crosses the
# box→raw border AT THAT SLOT (`lower_expr_raw_at` — exact, never inferred
# from the arg's `.ty`, which a generic fn's read may lack); a `SBoxed`
# param keeps the plain boxed `lower_expr`.
fn lower_tcrec_arg(e: Expr, pslot: KSlot, i: Int, st: LowerSt) : LRes / Console = match pslot {
  SBoxed -> lower_expr(e, st)
  _      -> if raw_border_owns_tail_arg(e, i) { lower_tail_slot_raw(e, pslot, st) }
            else { lower_expr_raw_at(e, pslot, st) }
}

# A hoisted argument read back from its slot at a raw param: the read
# consumes the slot's reference.
fn lower_tail_slot_raw(e: Expr, pslot: KSlot, st: LowerSt) : LRes / Console = match e.mode {
  MUnboxed -> lower_expr_raw_kind(e, st)
  _        -> match border_unbox_prim(pslot) {
    Some(prim) -> lower_unbox_at(e, prim, pslot, true, st)
    None       -> lower_expr_boxed(e, st)
  }
}
