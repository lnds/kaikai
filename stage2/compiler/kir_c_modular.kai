#[doc("The separately compiled C program as one marker-delimited stream, in the file protocol the C driver splits.")]

import compiler.kir_c_prog
import compiler.util

fn kcm_file(nonce: String, name: String, body: String) : String =
  concat_all(["//KAIFILE:", nonce, "::", name, "\n", body])

fn kcm_headers(nonce: String, tu: KcTu) : String =
  concat_all([
    kcm_file(nonce, cat2(cat2("kai_types_", tu.stem), ".h"), "/* generated by kaikai stage 2 */\n"),
    kcm_file(nonce, cat2(cat2("kai_decls_", tu.stem), ".h"), tu.header)
  ])

fn kcm_unit(nonce: String, tu: KcTu) : String =
  kcm_file(nonce, cat2(tu.stem, ".c"), concat_all(["/* generated by kaikai stage 2 */\n#include \"kai_decls_", tu.stem, ".h\"\n\n", tu.body, "\n"]))

#[doc("The stream of `m`: a line declaring the nonce, a types and a decls header per unit, then every unit's C text, each file introduced by a column-0 `//KAIFILE:` marker line.")]
pub fn kc_modular_stream(m: KcModular, nonce: String) : String =
  concat_all([
    concat_all(["//KAIDELIM:", nonce, "\n"]),
    concat_all(map(m.tus, (tu) => kcm_headers(nonce, tu))),
    concat_all(map(m.tus, (tu) => kcm_unit(nonce, tu)))
  ])
