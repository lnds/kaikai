#[doc("""
What a frame's code does with a pending binder: consume it, lend it to a
call, or mention it only inside a `handle`. Every test errs toward
"consumed", so a binder is never registered after it may be gone.
""")]

import compiler.ast
import compiler.expr_positions
import compiler.emit_tcrec_live
import compiler.unwind_binders

#[doc("The binders among `live` passed to `f` as owned-borrow arguments of `xs`: released only after the call returns, so held across it.")]
pub fn unw_lent(f: Expr, xs: [Expr], live: [LocalId]) : [LocalId] = uw_lent_at(f, xs, xs, 0, live)

fn uw_lent_at(f: Expr, all: [Expr], xs: [Expr], i: Int, live: [LocalId]) : [LocalId] = match xs {
  [] -> []
  [a, ...rest] -> {
    let more = uw_lent_at(f, all, rest, i + 1, live)
    match uw_owned_borrow_var(a) {
      Some(n) ->
        if unw_has(live, n) and not tcl_consumes(f, n) and not uw_consumed_besides(all, i, 0, n) { [n, ...more] }
        else { more }
      None -> more
    }
  }
}

fn uw_owned_borrow_var(a: Expr) : Option[LocalId] = match a.kind {
  ECall(g, [y]) -> match g.kind {
    EMark(MkOwnedBorrow) -> match y.kind {
      ELocal(l) -> Some(l)
      _         -> None
    }
    _ -> None
  }
  _ -> None
}

fn uw_consumed_besides(xs: [Expr], skip: Int, i: Int, n: LocalId) : Bool = match xs {
  [] -> false
  [x, ...rest] -> (i != skip and tcl_consumes(x, n)) or uw_consumed_besides(rest, skip, i + 1, n)
}

#[doc("`pend` without the binders `e` consumes or might consume: `pend` itself when it consumes none.")]
pub fn unw_filter(pend: [LocalId], e: Expr) : [LocalId] =
  if uw_any_consumed(pend, e) { uw_unconsumed(pend, e) } else { pend }

fn uw_any_consumed(pend: [LocalId], e: Expr) : Bool = match pend {
  [] -> false
  [p, ...rest] -> tcl_consumes(e, p) or uw_any_consumed(rest, e)
}

fn uw_unconsumed(pend: [LocalId], e: Expr) : [LocalId] = match pend {
  [] -> []
  [p, ...rest] -> if tcl_consumes(e, p) { uw_unconsumed(rest, e) } else { [p, ...uw_unconsumed(rest, e)] }
}

#[doc("`pend` without the binders statement `s` consumes, might consume or rebinds.")]
pub fn unw_filter_stmt(pend: [LocalId], s: Stmt) : [LocalId] =
  unw_minus(uw_filter_each(pend, stmt_exprs(s)), unw_stmt_binders(s))

fn uw_filter_each(pend: [LocalId], es: [Expr]) : [LocalId] = match es {
  [] -> pend
  [e, ...rest] -> uw_filter_each(unw_filter(pend, e), rest)
}

#[doc("The union of every list in `eaten` except the `i`-th.")]
pub fn unw_others(eaten: [[LocalId]], i: Int, j: Int) : [LocalId] = match eaten {
  [] -> []
  [e, ...rest] -> if i == j { unw_others(rest, i, j + 1) } else { unw_union(e, unw_others(rest, i, j + 1)) }
}

#[doc("The children of the positions `ps` that run inline.")]
pub fn unw_inline(ps: [XPos]) : [Expr] = match ps {
  [] -> []
  [XP(r, c), ...rest] -> if xrole_inline(r) { [c, ...unw_inline(rest)] } else { unw_inline(rest) }
}

#[doc("The binders of `xs` mentioned only in `h`'s inline code: never in its clauses, never elsewhere in `body`, never one of `jumps`.")]
pub fn unw_confined(xs: [LocalId], h: Expr, jumps: [LocalId], body: Expr) : [LocalId] = match xs {
  [] -> []
  [x, ...rest] -> {
    let tail = unw_confined(rest, h, jumps, body)
    let inside = uw_count(x, h, true)
    if not unw_has(jumps, x) and inside == uw_count(x, h, false) and inside == uw_count(x, body, false) {
      [x, ...tail]
    } else { tail }
  }
}

# Reads of `x` in `e`. `inline_only` skips lambda and clause bodies.
fn uw_count(x: LocalId, e: Expr, inline_only: Bool) : Int = match e.kind {
  ELocal(l) -> if local_eq(l, x) { 1 } else { 0 }
  _ -> uw_count_ps(x, xp_positions(e), inline_only)
}

fn uw_count_ps(x: LocalId, ps: [XPos], inline_only: Bool) : Int = match ps {
  [] -> 0
  [XP(r, c), ...rest] ->
    (if inline_only and not xrole_inline(r) { 0 } else { uw_count(x, c, inline_only) })
      + uw_count_ps(x, rest, inline_only)
}

#[doc("True when a call of `f` reads its operand without taking it: a dup, a borrow, a guard-fail drop.")]
pub fn unw_lending(f: Expr) : Bool = match f.kind {
  EMark(MkDup) -> true
  EMark(MkBorrow) -> true
  EMark(MkGuardDrop) -> true
  _ -> false
}
