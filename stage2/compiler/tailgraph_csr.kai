#[doc("""
Compressed adjacency rows over tail-call graph edges: the neighbours of
node `v` are `dst[off[v] .. off[v + 1]]`, in edge-list order.
""")]

import compiler.tailgraph

#[doc("Adjacency rows: `off` has one entry per node plus a final total, `dst` holds each row's neighbours contiguously.")]
pub type TgCsr = { off: Array[Int], dst: Array[Int] }

#[doc("The successor rows of `n` nodes over `es`. Each row keeps edge-list order, which a breadth-first walk's visit order depends on.")]
pub fn tg_csr(n: Int, es: [TgEdge]) : TgCsr {
  let g = TgCsr { off: array_make(n + 1, 0), dst: array_make(list_length(es), 0) }
  let _ = tg_count(g, es)
  let _ = tg_prefix(g, 1, n + 1)
  let _ = tg_fill(g, array_make(n, 0), es)
  g
}

#[doc("Every edge of `es` reversed, prepended onto `acc`.")]
pub fn tg_flip(es: [TgEdge], acc: [TgEdge]) : [TgEdge] = match es {
  [] -> acc
  [TgE(a, b), ...rest] -> tg_flip(rest, [TgE(b, a), ...acc])
  _ -> acc
}

fn tg_count(g: TgCsr, es: [TgEdge]) : TgCsr / Mutable = match es {
  [] -> g
  [TgE(a, _), ...rest] -> {
    g.off[a + 1] := g.off[a + 1] + 1
    tg_count(g, rest)
  }
  _ -> g
}

fn tg_prefix(g: TgCsr, k: Int, n: Int) : TgCsr / Mutable =
  if k >= n { g }
  else {
    g.off[k] := g.off[k] + g.off[k - 1]
    tg_prefix(g, k + 1, n)
  }

fn tg_fill(g: TgCsr, used: Array[Int], es: [TgEdge]) : TgCsr / Mutable = match es {
  [] -> g
  [TgE(a, b), ...rest] -> {
    g.dst[g.off[a] + used[a]] := b
    used[a] := used[a] + 1
    tg_fill(g, used, rest)
  }
  _ -> g
}
