#[doc("KIR inlining: slot renaming and the inliner that splices a callee body at its call site.")]

import compiler.util
import compiler.kir
import compiler.kir_syms
import compiler.kir_inline_beta
import compiler.ast_ids
import compiler.core_types

# compiler/kir_varslot.kai — canonical var-cell State handlers to slots.
#
# The desugar's var→slot specialisation bails when the cell escapes
# into a closure, so a `while { i < n } { … }` counter rides the full
# dispatched State handler. After the KIR inliner fuses the loop
# combinator and its lambdas back into the installing fn, the escape is
# gone but the handler remains. This pass finishes the job: a CANONICAL
# var-cell install (the desugar-minted get/set clause pair) whose alias
# id no longer leaves the fn rewrites to a mutable register — get is a
# dup + read, set a drop + store, the pop a final drop.
#
# Soundness rests on the same premise the desugar rewrite stands on: a
# var cell is addressable only through its alias id (`op@a` + the
# `__alias_id__a` register), never by an unaliased State perform from
# user code; any unaliased State perform in the program disables the
# pass. It also skips a sibling install bound to the same register, a
# non-get/set use of the alias, and an alias id an install's env carries
# into its clauses.

# One rewritable cell: install site sym, alias, the setjmp register
# that guards its landing pad.
type KvsCell = KVC(String, String)

#[doc("Rewrite every canonical, non-escaping var-cell State handler in the program to a mutable register (install→let, get→dup+read, set→drop+store, pop→final drop, landing pad→unreachable).")]
pub(pkg) fn kvs_program(kp: KProgram) : KProgram = {
  let canon = if kvs_program_unaliased(kp.fns) { [] } else { kvs_canonical_sites(kp.handlers, kvs_clauses(kp), []) }
  match canon {
    [] -> kp
    _  -> KProgram { types: kp.types,
                     fns: kvs_fn_loop(kp.fns, canon, []),
                     handlers: kp.handlers,
                     install_order: kp.install_order,
                     defaults: kp.defaults,
                     runner_defaults: kp.runner_defaults,
                     synth_defaults: kp.synth_defaults,
                     regions: kp.regions,
                     runners: kp.runners, exports: kp.exports, entry: kp.entry, tab: kp.tab, specs: kp.specs, reg: kp.reg, ids: kp.ids, reuse_tags: kp.reuse_tags }
  }
}

# --- Canonical-handler recognition --------------------------------------

# A var-cell handler is the desugar-minted State pair: a stateful `get`
# clause `dup c; resume(k, c)` over the var-cell alias's register `c`, a
# stateful `set` clause `resume2(k, (), v)` with or without a leading
# `dup v` (Perceus picks dup or move per site), no cross-clause captures.
# Anything else (a user State handler) is left alone.
# The clause bodies of the program, each under its symbol: an op thunk
# names its clause by it.
fn kvs_clauses(kp: KProgram) : [KSymFn] =
  ksym_fns(kp_names(kp), filter(kp.fns, (f) => match f.kind { KFnClause -> true  _ -> false }))

fn kvs_canonical_sites(hs: [KHandlerDecl], fns: [KSymFn], acc: [String]) : [String] = match hs {
  []           -> acc
  [h, ...rest] -> kvs_canonical_sites(rest, fns,
    if effect_is(h.eff_sym, CeState) and kvs_ops_canonical(h.op_thunks, fns) {
      [h.sym, ...acc]
    } else { acc })
}

fn kvs_ops_canonical(ops: [KOpThunk], fns: [KSymFn]) : Bool = match ops {
  [KOT(a, fa, _), KOT(b, fb, _)] ->
    match cell_op_named(a) {
      Some(CellGet) -> match cell_op_named(b) { Some(CellSet) -> kvs_get_canonical(fa, fns) and kvs_set_canonical(fb, fns)  _ -> false }
      Some(CellSet) -> match cell_op_named(b) { Some(CellGet) -> kvs_set_canonical(fa, fns) and kvs_get_canonical(fb, fns)  _ -> false }
      _             -> false
    }
  _ -> false
}

fn kvs_find_fn(fns: [KSymFn], sym: String) : Option[KFn] = match fns {
  []           -> None
  [r, ...rest] -> if r.sym == sym { Some(r.f) } else { kvs_find_fn(rest, sym) }
}

fn kvs_get_canonical(sym: String, fns: [KSymFn]) : Bool = match kvs_find_fn(fns, sym) {
  None    -> false
  Some(f) -> match f.blocks {
    [b] -> match b.stmts {
      [KBindSelfState(regs, _), KRC(KDup(KVar(s1)), _), KLet(t, _, KResumeOp(KVar(k), KVar(s2)), _)] ->
        kvs_is_cell_reg(regs, s1) and s2 == s1 and k == kir_resume_reg() and kvs_ret_is(b.term, t)
      _ -> false
    }
    _ -> false
  }
}

# The var cell alias is the last a clause binds (`clause_state_aliases`).
fn kvs_is_cell_reg(regs: [String], r: String) : Bool = match regs {
  []        -> false
  [c]       -> c == r
  [_, ...rest] -> kvs_is_cell_reg(rest, r)
}

fn kvs_set_canonical(sym: String, fns: [KSymFn]) : Bool = match kvs_find_fn(fns, sym) {
  None    -> false
  Some(f) -> match f.blocks {
    [b] -> match b.stmts {
      [KBindSelfState(_, _), KRC(KDup(KVar(d)), _), KLet(t, _, KResume2Op(KVar(k), KUnitV, KVar(v)), _)] ->
        d == v and kvs_set_resumes(f.params, k, v, b.term, t)
      [KBindSelfState(_, _), KLet(t, _, KResume2Op(KVar(k), KUnitV, KVar(v)), _)] ->
        kvs_set_resumes(f.params, k, v, b.term, t)
      _ -> false
    }
    _ -> false
  }
}

fn kvs_set_resumes(ps: [KParam], k: String, v: String, term: KTerm, t: String) : Bool =
  k == kir_resume_reg() and kvs_first_param_is(ps, v) and kvs_ret_is(term, t)

fn kvs_first_param_is(ps: [KParam], nm: String) : Bool = match ps {
  [p, ..._] -> p.name == nm
  []        -> false
}

fn kvs_ret_is(t: KTerm, nm: String) : Bool = match t {
  KRet(KVar(r), _) -> r == nm
  _                -> false
}

# --- Per-fn rewrite -------------------------------------------------------

fn kvs_fn_loop(fs: [KFn], canon: [String], acc: [KFn]) : [KFn] = match fs {
  []           -> list_reverse(acc)
  [f, ...rest] -> kvs_fn_loop(rest, canon, [kvs_fn(f, canon), ...acc])
}

fn kvs_fn(f: KFn, canon: [String]) : KFn = {
  let cells = kvs_admissible_cells(f.blocks, canon)
  match cells {
    [] -> f
    _  -> kfn_with_blocks(f, kvs_rewrite_cells(f.blocks, cells))
  }
}

# The fn's rewritable cells: a canonical install with no env, whose alias
# is unique among ALL of the fn's aliased installs, whose alias id register
# is never read as an atom (a closure capture, an install's env), and whose
# `@alias` performs are all get/0 or set/1 shapes.
fn kvs_admissible_cells(bs: [KBlock], canon: [String]) : [KvsCell] =
  kvs_filter_cells(kvs_installs(bs, []), bs, canon, [])

fn kvs_installs(bs: [KBlock], acc: [KvsCell]) : [KvsCell] = match bs {
  []           -> acc
  [b, ...rest] -> kvs_installs(rest, kvs_installs_stmts(b.stmts, acc))
}

fn kvs_installs_stmts(ss: [KStmt], acc: [KvsCell]) : [KvsCell] = match ss {
  []           -> acc
  [s, ...rest] -> kvs_installs_stmts(rest, match s {
    KInstall(_, site, Some(_), Some(a), [], _) -> [KVC(site, a), ...acc]
    _                                      -> acc
  })
}

fn kvs_filter_cells(installs: [KvsCell], bs: [KBlock], canon: [String], acc: [KvsCell]) : [KvsCell] = match installs {
  [] -> acc
  [KVC(site, a), ...rest] -> kvs_filter_cells(rest, bs, canon,
    if kvs_cell_admissible(site, a, rest, acc, bs, canon) { [KVC(site, a), ...acc] } else { acc })
}

fn kvs_cell_admissible(site: String, a: String, rest: [KvsCell], acc: [KvsCell], bs: [KBlock], canon: [String]) : Bool = {
  let unique = kvs_alias_count(rest, a) == 0 and kvs_alias_count(acc, a) == 0
  let clean = not kvs_alias_reg_used(bs, kir_alias_id_reg(a))
  list_has(canon, site) and unique and clean and kvs_performs_ok(bs, a)
}

fn kvs_alias_count(cells: [KvsCell], a: String) : Int = match cells {
  [] -> 0
  [KVC(_, b), ...rest] -> (if a == b { 1 } else { 0 }) + kvs_alias_count(rest, a)
}

# --- Condition scans ------------------------------------------------------

fn kvs_program_unaliased(fs: [KFn]) : Bool = match fs {
  []           -> false
  [f, ...rest] -> kvs_has_unaliased_state(f.blocks) or kvs_program_unaliased(rest)
}

fn kvs_has_unaliased_state(bs: [KBlock]) : Bool = match bs {
  []           -> false
  [b, ...rest] -> kvs_unaliased_stmts(b.stmts) or kvs_has_unaliased_state(rest)
}

fn kvs_unaliased_stmts(ss: [KStmt]) : Bool = match ss {
  []           -> false
  [s, ...rest] -> match s {
    KLet(_, _, KPerform(es, _, _, via, _), _) -> (effect_is(es, CeState) and not kvs_aliased(via)) or kvs_unaliased_stmts(rest)
    KDo(KPerform(es, _, _, via, _), _)        -> (effect_is(es, CeState) and not kvs_aliased(via)) or kvs_unaliased_stmts(rest)
    _                                         -> kvs_unaliased_stmts(rest)
  }
}

fn kvs_aliased(via: KVia) : Bool = match via {
  KvAlias(_, _) -> true
  _          -> false
}

# Every perform through the alias must be the exact get/set cell protocol; any other
# op or arity means the alias reaches something this rewrite does not
# model.
fn kvs_performs_ok(bs: [KBlock], a: String) : Bool = match bs {
  []           -> true
  [b, ...rest] -> kvs_performs_ok_stmts(b.stmts, a) and kvs_performs_ok(rest, a)
}

fn kvs_performs_ok_stmts(ss: [KStmt], a: String) : Bool = match ss {
  []           -> true
  [s, ...rest] -> kvs_perform_ok(s, a) and kvs_performs_ok_stmts(rest, a)
}

fn kvs_perform_ok(s: KStmt, a: String) : Bool = match s {
  KLet(_, _, KPerform(es, _, op, via, vargs), _) -> kvs_cell_op_ok(es, op, via, vargs, a)
  KDo(KPerform(es, _, op, via, vargs), _)        -> kvs_cell_op_ok(es, op, via, vargs, a)
  _                                              -> true
}

fn kvs_cell_op_ok(es: SymId, op: String, via: KVia, vargs: [KVal], a: String) : Bool =
  if not kvs_via_alias(via, a) { true }
  else { match cell_op_named(op) {
    Some(CellGet) -> effect_is(es, CeState) and list_length(vargs) == 0
    Some(CellSet) -> effect_is(es, CeState) and list_length(vargs) == 1
    _             -> false
  } }

fn kvs_via_alias(via: KVia, a: String) : Bool = match via {
  KvAlias(b, _) -> a == b
  _          -> false
}

# Any atom read of the alias-id register (a closure capture, a call
# arg, an RC op…) means the id escapes this fn's view.
fn kvs_alias_reg_used(bs: [KBlock], reg: String) : Bool = kir_reg_used(bs, reg, true)

# --- The rewrite ----------------------------------------------------------

fn kvs_cell_reg(site: String) : String = cat2("__vcell_", site)

fn kvs_cell_of_site(cells: [KvsCell], site: String) : Option[KvsCell] = match cells {
  [] -> None
  [KVC(s, a), ...rest] -> if s == site { Some(KVC(s, a)) } else { kvs_cell_of_site(rest, site) }
}

fn kvs_cell_of_alias(cells: [KvsCell], a: String) : Option[KvsCell] = match cells {
  [] -> None
  [KVC(s, b), ...rest] -> if b == a { Some(KVC(s, b)) } else { kvs_cell_of_alias(rest, a) }
}

# Two block passes: the statement rewrite collects the setjmp registers
# of rewritten cells; the terminator pass then folds their landing-pad
# condbrs and guts the now-unreachable unwind blocks (their statements
# reference the discard register only the setjmp emission creates).
fn kvs_rewrite_cells(bs: [KBlock], cells: [KvsCell]) : [KBlock] = {
  let sjregs = kvs_setjmp_regs(bs, cells, [])
  let uwlbls = kvs_unwind_labels(bs, sjregs, [])
  kvs_rewrite_blocks(bs, cells, sjregs, uwlbls, [])
}

fn kvs_setjmp_regs(bs: [KBlock], cells: [KvsCell], acc: [String]) : [String] = match bs {
  []           -> acc
  [b, ...rest] -> kvs_setjmp_regs(rest, cells, kvs_setjmp_regs_stmts(b.stmts, cells, acc))
}

fn kvs_setjmp_regs_stmts(ss: [KStmt], cells: [KvsCell], acc: [String]) : [String] = match ss {
  []           -> acc
  [s, ...rest] -> kvs_setjmp_regs_stmts(rest, cells, match s {
    KLet(t, _, KSetjmp(_, site), _) -> match kvs_cell_of_site(cells, site) {
      Some(_) -> [t, ...acc]
      None    -> acc
    }
    _ -> acc
  })
}

fn kvs_unwind_labels(bs: [KBlock], sjregs: [String], acc: [String]) : [String] = match bs {
  []           -> acc
  [b, ...rest] -> kvs_unwind_labels(rest, sjregs, match b.term {
    KCondBr(KVar(t), uw, _, _) -> if list_has(sjregs, t) { [uw, ...acc] } else { acc }
    _                          -> acc
  })
}

fn kvs_rewrite_blocks(bs: [KBlock], cells: [KvsCell], sjregs: [String], uwlbls: [String], acc: [KBlock]) : [KBlock] = match bs {
  []           -> list_reverse(acc)
  [b, ...rest] -> kvs_rewrite_blocks(rest, cells, sjregs, uwlbls,
    [if list_has(uwlbls, b.label) {
       KBlock { label: b.label, stmts: [], term: KUnreachable(KNoPos), region_id: b.region_id }
     } else {
       KBlock { label: b.label,
                stmts: kvs_rewrite_stmts(b.stmts, cells, sjregs, []),
                term: kvs_rewrite_term(b.term, sjregs),
                region_id: b.region_id }
     }, ...acc])
}

fn kvs_rewrite_term(t: KTerm, sjregs: [String]) : KTerm = match t {
  KCondBr(KVar(r), _, body, p) -> if list_has(sjregs, r) { KBr(body, p) } else { t }
  _                            -> t
}

# install → cell let; setjmp → dropped; pop → the cell's final drop,
# then unit in the cell so its unwind slot never reads a freed value;
# the state's unwind slot → the cell register's;
# bind-ev-state → dropped, with the handle exit's state release after
# it (the pop's drop pays it); get@a → dup + read; set@a → drop + store.
fn kvs_rewrite_stmts(ss: [KStmt], cells: [KvsCell], sjregs: [String], acc: [KStmt]) : [KStmt] = match ss {
  []           -> list_reverse(acc)
  [KBindEvState(_, site, [r], _), KRC(KDrop(KVar(c)), _), ...rest] if c == r and kvs_site_rewritten(cells, site) ->
    kvs_rewrite_stmts(rest, cells, sjregs, acc)
  [s, ...rest] -> kvs_rewrite_stmts(rest, cells, sjregs, match s {
    KInstall(_, site, Some(init), Some(_), _, p) -> match kvs_cell_of_site(cells, site) {
      Some(_) -> [KLet(kvs_cell_reg(site), SBoxed, KLitOp(init), p), ...acc]
      None    -> [s, ...acc]
    }
    KLet(t, _, KSetjmp(_, _), _) -> if list_has(sjregs, t) { acc } else { [s, ...acc] }
    KPop(_, site, p) -> match kvs_cell_of_site(cells, site) {
      Some(_) -> [KStore(kvs_cell_reg(site), KUnitV, p), KRC(KDrop(KVar(kvs_cell_reg(site))), p), ...acc]
      None    -> [s, ...acc]
    }
    KLet(f, slot, KPrim(KpUnwPushState, [KStrV(site), ...rest]), p) ->
      if kvs_site_rewritten(cells, site) {
        [KLet(f, slot, KPrim(KpUnwPushReg, [KStrV(kvs_cell_reg(site)), ...rest]), p), ...acc]
      } else { [s, ...acc] }
    KBindEvState(_, site, _, _) -> match kvs_cell_of_site(cells, site) {
      Some(_) -> acc
      None    -> [s, ...acc]
    }
    KLet(x, slot, KPerform(_, _, op, via, vargs), p) -> match kvs_perform_rewrite(cells, op, via, vargs) {
      KvsGet(cell) -> [KLet(x, slot, KLitOp(KVar(cell)), p), KRC(KDup(KVar(cell)), p), ...acc]
      KvsSet(cell, v) -> [KLet(x, slot, KLitOp(KUnitV), p), KStore(cell, v, p), KRC(KDrop(KVar(cell)), p), ...acc]
      KvsNoCell -> [s, ...acc]
    }
    KDo(KPerform(_, _, op, via, vargs), p) -> match kvs_perform_rewrite(cells, op, via, vargs) {
      KvsGet(_) -> acc
      KvsSet(cell, v) -> [KStore(cell, v, p), KRC(KDrop(KVar(cell)), p), ...acc]
      KvsNoCell -> [s, ...acc]
    }
    _ -> [s, ...acc]
  })
}

fn kvs_site_rewritten(cells: [KvsCell], site: String) : Bool = match kvs_cell_of_site(cells, site) {
  Some(_) -> true
  None    -> false
}

type KvsHit = KvsGet(String) | KvsSet(String, KVal) | KvsNoCell

fn kvs_perform_rewrite(cells: [KvsCell], op: String, via: KVia, vargs: [KVal]) : KvsHit = match via {
  KvAlias(a, _) -> match kvs_cell_of_alias(cells, a) {
    None -> KvsNoCell
    Some(KVC(site, _)) ->
      match cell_op_named(op) {
        Some(CellGet) -> KvsGet(kvs_cell_reg(site))
        _ -> match vargs {
          [v] -> KvsSet(kvs_cell_reg(site), v)
          _   -> KvsNoCell
        }
      }
  }
  _ -> KvsNoCell
}

# compiler/kir_inline.kai — small-function inlining on lowered KIR.
#
# Runs after `lower_to_kir`, so every pasted fragment carries the RC ops
# Perceus already placed (dup/drop are KIR statements here, not marks to
# re-derive) and the caller's TCO/TRMC shape is already fixed as typed
# terminators (`KTcrecGoto`/`KTrmcStep`/`KTrmcApply`) the paste never
# touches. Inlining is pure statement-level splicing: a `KLet(x, KCall)`
# site becomes a branch into an alpha-renamed clone of the callee's
# blocks whose `KRet v` terminators store `v` into `x` and branch to a
# join block holding the site's remaining statements.
#
# Template admission is deliberately narrow: a leaf `KFnNormal` (no
# program-fn calls, no effect ops, no handler frames, no regions) whose
# only terminators are ret/br/condbr/switch/unreachable and whose
# `KStore` targets are its own `KLet` binders. Reuse-in-place bodies
# (`KConReuse`/`KTokenSteal` + the runtime uniqueness helpers) admit
# under a HIGHER cost ceiling: they are the rotation-shaped class where
# cross-boundary RC/alloc fusion pays most, and they are structurally
# rare, so the extra code growth is bounded. The arm-top token family
# (`KArmTopReuse`/`KArmTokenFree`) never admits — it addresses the
# fn-wide `_arm_ru` register a paste cannot re-home. Everything the
# admission whitelists, the clone renames; the two lists must move
# together.

# Inline cost ceilings: a template admits when its total statement count
# is at most the ceiling of its class. Both at 0 disables the pass
# entirely (identity — the program is returned untouched, no walk runs).
fn kin_max_stmts() : Int = 16

fn kin_max_blocks() : Int = 8

fn kin_max_reuse_stmts() : Int = 128

fn kin_max_reuse_blocks() : Int = 32

fn kin_max_loop_stmts() : Int = 32

fn kin_max_loop_blocks() : Int = 8

# A processed block list plus the threaded per-fn site counter.
type KinBlksOut = KBO([KBlock], Int)

#[doc("Inlines admitted small functions into their KLet call sites across a lowered KProgram (direct calls first, then indirect-call beta reduction over the exposed KClosure sites); identity when the cost ceilings are 0.")]
pub(pkg) fn kir_inline_program(kp: KProgram) : KProgram =
  if kin_max_stmts() <= 0 and kin_max_reuse_stmts() <= 0 { kp }
  else {
    let nm    = kp_names(kp)
    let tmpls = kin_tmpls(kin_collect(kp.fns, nm, []))
    let fns1  = if tmpls.n == 0 { kp.fns } else { kin_fn_loop(kp.fns, nm, tmpls, []) }
    let lams  = kin_tmpls(kin_lam_collect(fns1, nm, []))
    let fns2  = if lams.n == 0 { fns1 } else { kin_beta_loop(fns1, lams, []) }
    kvs_program(KProgram { types: kp.types, fns: fns2,
               handlers: kp.handlers,
               install_order: kp.install_order,
               defaults: kp.defaults,
               runner_defaults: kp.runner_defaults,
               synth_defaults: kp.synth_defaults,
               regions: kp.regions,
               runners: kp.runners, exports: kp.exports, entry: kp.entry, tab: kp.tab, specs: kp.specs, reg: kp.reg, ids: kp.ids, reuse_tags: kp.reuse_tags })
  }

fn kin_beta_loop(fs: [KFn], lams: KinTmpls, acc: [KFn]) : [KFn] = match fs {
  []           -> list_reverse(acc)
  [f, ...rest] -> kin_beta_loop(rest, lams, [kin_beta_fn(f, lams), ...acc])
}

# --- Template admission --------------------------------------------------

fn kin_collect(fs: [KFn], nm: KNames, acc: [KinTmpl]) : [KinTmpl] = match fs {
  []           -> list_reverse(acc)
  [f, ...rest] -> kin_collect(rest, nm, if kin_admit(f) { [KT(kfn_sym(nm, f), f), ...acc] } else { acc })
}

fn kin_admit(f: KFn) : Bool = match f.kind {
  KFnNormal -> kin_shape_ok(f) and kin_size_ok(f.blocks) and kin_blocks_ok(f.blocks, kin_binders(f.blocks, []), false)
  _         -> false
}

# A donation-capable fn rides the hidden trailing donor-token param —
# fn-wide state a paste cannot re-home (the `_arm_ru` argument again),
# and its call sites carry the cross-call donation the inline would
# silently drop. Both stay calls.
fn kin_shape_ok(f: KFn) : Bool = not f.stateful and not kin_region_some(f.region_id) and not f.donor

# The ceiling of the template's class: loop templates (a pasted
# self-loop) are tightest, reuse-carrying bodies widest.
fn kin_size_ok(bs: [KBlock]) : Bool = {
  let loop_ = kin_has_tcrec(bs)
  let reuse = kin_has_reuse(bs)
  let maxb = if loop_ { kin_max_loop_blocks() }
             else if reuse { kin_max_reuse_blocks() } else { kin_max_blocks() }
  let maxs = if loop_ { kin_max_loop_stmts() }
             else if reuse { kin_max_reuse_stmts() } else { kin_max_stmts() }
  kin_within(bs, maxb, maxs)
}

fn kin_within(bs: [KBlock], maxb: Int, maxs: Int) : Bool =
  list_length(bs) >= 1 and list_length(bs) <= maxb and kin_count_stmts(bs, 0) <= maxs

#[doc("True when any block ends in a `KTcrecGoto` (the template is a self-loop the paste re-creates with local registers).")]
pub(pkg) fn kin_has_tcrec(bs: [KBlock]) : Bool = match bs {
  []           -> false
  [b, ...rest] -> match b.term {
    KTcrecGoto(_, _, _, _) -> true
    _                      -> kin_has_tcrec(rest)
  }
}

# Lambda templates for the beta pass: plain-tier ceilings, params only
# through `PDirect`/`PCapture` (an evidence- or resume-carrying lambda
# rides frame state a paste cannot re-home), no self-loop, performs
# admitted (the beta site re-checks each `op@a` against the closure's
# captures).
fn kin_lam_collect(fs: [KFn], nm: KNames, acc: [KinTmpl]) : [KinTmpl] = match fs {
  []           -> list_reverse(acc)
  [f, ...rest] -> kin_lam_collect(rest, nm, if kin_lam_admit(f) { [KT(kfn_sym(nm, f), f), ...acc] } else { acc })
}

fn kin_lam_admit(f: KFn) : Bool = match f.kind {
  KFnLambda -> kin_lam_admissible(f)
  _         -> false
}

fn kin_lam_admissible(f: KFn) : Bool = {
  let sized = kin_shape_ok(f) and kin_within(f.blocks, kin_max_blocks(), kin_max_stmts())
  let shaped = not kin_has_tcrec(f.blocks) and kin_lam_origins_ok(f.params)
  let body = kin_blocks_ok(f.blocks, kin_binders(f.blocks, []), true) and kin_lam_alias_shape_ok(f)
  sized and shaped and body
}

fn kin_lam_origins_ok(ps: [KParam]) : Bool = match ps {
  [] -> true
  [p, ...rest] -> match p.origin {
    PDirect(_)  -> kin_lam_origins_ok(rest)
    PCapture(_) -> kin_lam_origins_ok(rest)
    _           -> false
  }
}

fn kin_has_reuse(bs: [KBlock]) : Bool = match bs {
  []           -> false
  [b, ...rest] -> kin_stmts_have_reuse(b.stmts) or kin_has_reuse(rest)
}

fn kin_stmts_have_reuse(ss: [KStmt]) : Bool = match ss {
  []           -> false
  [s, ...rest] -> match s {
    KLet(_, _, op, _) -> kin_op_is_reuse(op) or kin_stmts_have_reuse(rest)
    KDo(op, _)        -> kin_op_is_reuse(op) or kin_stmts_have_reuse(rest)
    _                 -> kin_stmts_have_reuse(rest)
  }
}

fn kin_op_is_reuse(op: KOp) : Bool = match op {
  KConReuse(_, _, _, _, _) -> true
  KRecordReuse(_, _, _, _) -> true
  KTokenSteal(_, _)        -> true
  _                        -> false
}

fn kin_region_some(r: Option[Int]) : Bool = match r { Some(_) -> true  None -> false }

fn kin_count_stmts(bs: [KBlock], n: Int) : Int = match bs {
  []           -> n
  [b, ...rest] -> kin_count_stmts(rest, n + list_length(b.stmts))
}

fn kin_binders(bs: [KBlock], acc: [String]) : [String] = match bs {
  []           -> acc
  [b, ...rest] -> kin_binders(rest, kin_stmt_binders(b.stmts, acc))
}

fn kin_stmt_binders(ss: [KStmt], acc: [String]) : [String] = match ss {
  []           -> acc
  [s, ...rest] -> kin_stmt_binders(rest, match s {
    KLet(n, _, _, _) -> [n, ...acc]
    _                -> acc
  })
}

#[doc("Structural admission walk over a template's blocks: op/RC/term whitelists plus the KStore-binder rule; `performs` additionally admits KPerform (the lambda beta templates, which carry their alias checks separately).")]
pub(pkg) fn kin_blocks_ok(bs: [KBlock], binders: [String], performs: Bool) : Bool = match bs {
  []           -> true
  [b, ...rest] ->
    if kin_region_some(b.region_id) { false }
    else { kin_stmts_ok(b.stmts, binders, performs) and kin_term_ok(b.term) and kin_blocks_ok(rest, binders, performs) }
}

fn kin_stmts_ok(ss: [KStmt], binders: [String], performs: Bool) : Bool = match ss {
  []           -> true
  [s, ...rest] -> kin_stmt_ok(s, binders, performs) and kin_stmts_ok(rest, binders, performs)
}

# A `KStore` target must be a template-local `KLet` binder: a store to a
# param cannot be re-pointed at an argument atom (the atom may be a
# literal), and nothing else is assignable here.
fn kin_stmt_ok(s: KStmt, binders: [String], performs: Bool) : Bool = match s {
  KLet(_, _, op, _) -> kin_op_ok(op, performs)
  KDo(op, _)        -> kin_op_ok(op, performs)
  KRC(rc, _)        -> kin_rc_ok(rc)
  KStore(n, _, _)   -> list_has(binders, n)
  _                 -> false
}

# The op whitelist. Program-fn calls are rejected so templates stay
# leaf (no growth, no recursion fence needed); the whitelisted `kaix_`
# runtime helpers are not program fns, so they keep that property.
# Closures / handler frames carry non-local structure the paste does
# not re-derive. Reuse ops are local: their donor/token atoms are
# template binders or params, both of which the clone rewrites.
# `KPerform` admits only under `performs` (lambda beta templates): an
# unaliased op dispatches through the dynamic evidence stack, which is
# position-independent, and an `op@a` form is guarded by the alias-
# capture identity check in the beta admission.
fn kin_op_ok(op: KOp, performs: Bool) : Bool = match op {
  KPrim(_, _)              -> true
  KCon(_, _, _, _, _)      -> true
  KRecord(_, _, _)         -> true
  KProj(_, _)              -> true
  KProjBorrow(_, _)        -> true
  KProjKind(_, _, _)       -> true
  KTagOf(_)                -> true
  KLitOp(_)                -> true
  KConReuse(rk, _, _, _, _) -> kin_reuse_kind_ok(rk)
  KRecordReuse(_, _, _, _) -> true
  KTokenSteal(_, _)        -> true
  KCall(sym, _)            -> kin_call_ok(sym)
  KCallIndirect(_, _)        -> true
  KCallIndirectBorrow(_, _)  -> true
  KPerform(_, _, _, _, _)     -> performs
  _                        -> false
}

# `RkDonorVariant` rebuilds into the enclosing fn's hidden donor slot —
# fn-wide state, not a local atom (belt: a non-donor template should
# never carry one anyway).
fn kin_reuse_kind_ok(rk: KReuseKind) : Bool = match rk {
  RkDonorVariant -> false
  _              -> true
}

# Runtime RC/uniqueness helpers a reuse body calls directly. Leaf by
# construction (runtime symbols, not program fns).
fn kin_call_ok(sym: String) : Bool =
  sym == "kaix_check_unique" or sym == "kaix_incref_if_token_null" or sym == "kaix_take_slot"

# The RC family whose operands are local atoms. `KArmTopReuse` /
# `KArmTokenFree` are excluded: they read/write the fn-wide `_arm_ru`
# register, which only exists in a TRMC caller's frame.
fn kin_rc_ok(rc: KRCOp) : Bool = match rc {
  KDup(_)               -> true
  KDrop(_)              -> true
  KFreeToken(_)         -> true
  KIncrefIfShared(_, _) -> true
  KArmTake(_, _, _)     -> true
  _                     -> false
}

# `KTcrecGoto` admits: the clone re-creates the self-loop over the
# head-materialised param registers (see `kin_reloop_stmts`).
fn kin_term_ok(t: KTerm) : Bool = match t {
  KRet(_, _)             -> true
  KBr(_, _)              -> true
  KCondBr(_, _, _, _)    -> true
  KSwitch(_, _, _, _)    -> true
  KUnreachable(_)        -> true
  KTcrecGoto(_, _, _, _) -> true
  _                      -> false
}

# --- Caller walk ----------------------------------------------------------

fn kin_fn_loop(fs: [KFn], nm: KNames, tmpls: KinTmpls, acc: [KFn]) : [KFn] = match fs {
  []           -> list_reverse(acc)
  [f, ...rest] -> kin_fn_loop(rest, nm, tmpls, [kin_fn(f, kfn_sym(nm, f), tmpls), ...acc])
}

fn kin_fn(f: KFn, sym: String, tmpls: KinTmpls) : KFn = match kin_fn_blocks(f.blocks, tmpls, sym, 0, []) {
  KBO(bs, _) -> kfn_with_blocks(f, bs)
}

fn kin_fn_blocks(bs: [KBlock], tmpls: KinTmpls, caller: String, c: Int, acc: [KBlock]) : KinBlksOut = match bs {
  []           -> KBO(list_reverse(acc), c)
  [b, ...rest] -> match kin_block(b, tmpls, caller, c) {
    KBO(nbs, c2) -> kin_fn_blocks(rest, tmpls, caller, c2, kin_prepend_rev(nbs, acc))
  }
}

fn kin_prepend_rev(xs: [KBlock], acc: [KBlock]) : [KBlock] = match xs {
  []           -> acc
  [x, ...rest] -> kin_prepend_rev(rest, [x, ...acc])
}

fn kin_block(b: KBlock, tmpls: KinTmpls, caller: String, c: Int) : KinBlksOut =
  if kin_region_some(b.region_id) { KBO([b], c) }
  else { kin_scan(b.label, b.stmts, b.term, tmpls, caller, c, []) }

# Scan a block's statements for inline sites. On a hit the accumulated
# prefix closes as a head block branching into the clone, and the scan
# continues on the remainder as the join block — so several sites in one
# source block chain head → clone → join → clone → …
#
# A boxed param substitutes its argument atom directly. A RAW param
# (i64/f64/i1) is materialised ONCE in the head block as a `KLet` at the
# param's slot — the same single boxed→raw border the call ABI has
# (`nemit_arg_at_slot`) — so a boxed argument is not re-unboxed at every
# use inside the paste. The materialised register's name is exactly
# `param+sfx`, which is what the clone's fallback rename resolves an
# unbound param read to.
fn kin_scan(label: String, ss: [KStmt], term: KTerm, tmpls: KinTmpls,
            caller: String, c: Int, pre_rev: [KStmt]) : KinBlksOut = match ss {
  [] -> KBO([KBlock { label: label, stmts: list_reverse(pre_rev), term: term, region_id: None }], c)
  [s, ...rest] -> match kin_site(s, tmpls, caller) {
    Some(t) -> match s {
      KLet(x, slot, KCall(_, cargs), pos) -> {
        let sfx  = cat2("$in", int_to_string(c))
        # A loop template's params are all re-assigned by the pasted
        # back-edge, so every one materialises as a head register; a
        # straight-line template materialises only the raw ones.
        let loop_ = kin_has_tcrec(t.blocks)
        let sub  = KinSub { pargs: if loop_ { [] } else { kin_bind_boxed_args(t.params, cargs, []) },
                            sfx: sfx, params: t.params, entry: kin_entry_label(t) }
        let plets = kin_param_lets(t.params, cargs, sfx, loop_, pos, [])
        let join = cat2("Lj", sfx)
        let head = KBlock { label: label,
                            stmts: list_reverse([KLet(x, slot, KLitOp(kin_zero(slot)), pos), ...list_append(plets, pre_rev)]),
                            term: KBr(kin_lbl(sub, kin_entry_label(t)), pos),
                            region_id: None }
        let cloned = kin_clone_blocks(t.blocks, sub, x, join, [])
        match kin_scan(join, rest, term, tmpls, caller, c + 1, []) {
          KBO(tail, c2) -> KBO([head, ...list_append(cloned, tail)], c2)
        }
      }
      _ -> kin_scan(label, rest, term, tmpls, caller, c, [s, ...pre_rev])
    }
    None -> kin_scan(label, rest, term, tmpls, caller, c, [s, ...pre_rev])
  }
}

# The site filter: a `KLet`-bound saturated direct call to an admitted
# template other than the caller itself. An `SInt32` destination is the
# one register kind the raw-literal init cannot seed, so it stays a call.
fn kin_site(s: KStmt, tmpls: KinTmpls, caller: String) : Option[KFn] = match s {
  KLet(_, slot, KCall(sym, cargs), _) ->
    if sym == caller or kin_slot_is_i32(slot) { None }
    else { and_then(kin_tmpl_find(tmpls, sym), (f) => if list_length(f.params) == list_length(cargs) { Some(f) } else { None }) }
  _ -> None
}

fn kin_slot_is_i32(s: KSlot) : Bool = match s { SInt32 -> true  _ -> false }

fn kin_entry_label(f: KFn) : String = match f.blocks {
  [b, ..._] -> b.label
  []        -> ""
}
