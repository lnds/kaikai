#[doc("""
Owned operands named before a sibling that can unwind.

An abandoning handler, a delivered cancellation and an early `!` return
leave through frames that release only what the unwind walk registered:
binders (`unwind_pend`). A value an operand has already computed is a
temporary no frame holds, so `f(g(x), E.op())` would strand `g(x)`'s
result when `E.op` abandons. Before ownership is decided, such a
construct binds its operands up to the last one that can unwind
(`resume_anf`), and the values computed first become binders the walk
registers across it. A construct whose earlier operands hold no
reference stays as written.
""")]

import compiler.ast
import compiler.sym_read
import compiler.chars
import compiler.emit_shared
import compiler.expr_exists
import compiler.anf_ops
import compiler.resume_anf
import compiler.unwind_cx
import compiler.unwind_calls
import compiler.unwind_effects

#[doc("Bind, in every body of `ds`, the owned operands evaluated before a sibling that can unwind.")]
pub fn unw_name_operands(ds: [Decl]) : [Decl] = {
  let ucx = unw_cx_decls(ds)
  map(ds, (d) => uo_decl(d, ucx))
}

#[doc("True when `s` binds an operand this pass named.")]
pub fn unw_is_named_operand(s: Stmt) : Bool = match s {
  SLet(p, _, _) -> match p.pkind {
    PBind(n) -> string_starts_with_q(n, uo_prefix())
    _        -> false
  }
  _ -> false
}

fn uo_prefix() : String = "__unw_v"

fn uo_decl(d: Decl, ucx: UnwCx) : Decl = match d {
  DFn(pub_, n, tps, ps, ret, row, body, l, c, mo, fsym) -> DFn(pub_, n, tps, ps, ret, row, uo_body(body, uo_fn_cx(row, body, ucx)), l, c, mo, fsym)
  DTest(desc, body, l, c, mo)      -> DTest(desc, uo_body(body, uo_frame(ucx)), l, c, mo)
  DBench(desc, body, l, c, mo)     -> DBench(desc, uo_body(body, uo_frame(ucx)), l, c, mo)
  DCheck(desc, ps, body, l, c, mo) -> DCheck(desc, ps, uo_body(body, uo_frame(ucx)), l, c, mo)
  DImpl(p, tas, tgt, inner, l, c, tps, isym) -> DImpl(p, tas, tgt, map(inner, (i) => uo_decl(i, ucx)), l, c, tps, isym)
  _ -> d
}

# `exits_only` marks a fn whose declared row cannot unwind and that
# installs no handler: only its `!` leaves early (`unw_fn_frame`).
type UoCx = { ucx: UnwCx, exits_only: Bool }

fn uo_frame(ucx: UnwCx) : UoCx = UoCx { ucx: ucx, exits_only: false }

fn uo_fn_cx(row: RowExpr, body: Expr, ucx: UnwCx) : UoCx =
  UoCx { ucx: ucx, exits_only: unw_row_class(row, ucx) == 0 and not xp_exists(body, false, uo_is_handle) }

fn uo_is_handle(e: Expr) : Bool = match e.kind {
  EHandle(_, _, _, _, _, _, _, _) -> true
  _ -> false
}

fn uo_leaves(x: Expr, cx: UoCx) : Bool = if cx.exits_only { unw_has_exit(x) } else { unw_scan(x, cx.ucx) }

# A body with nothing that can leave early is returned as is: the rebuild
# would cost every program.
fn uo_body(e: Expr, cx: UoCx) : Expr =
  if xp_exists(e, false, (x) => unw_scan_node(x, cx.ucx)) { uo_expr(e, cx, 0).e } else { e }

# Children first, so a construct is judged on its operands as rewritten.
# A lambda or clause body is a frame of its own.
fn uo_expr(e: Expr, cx: UoCx, n: Int) : Anf = match e.kind {
  EBlock(ss, ot) -> {
    let rs = uo_stmts(ss, cx, n, [])
    let rt = uo_opt(ot, cx, rs.n)
    Anf { e: with_kind(e, EBlock(rs.ss, rt.o)), n: rt.n }
  }
  EIf(c, t, oe) -> {
    let r = uo_list([c, t], cx, n, [])
    let re = uo_opt(oe, cx, r.n)
    Anf { e: with_kind(e, EIf(uo_nth(r.xs, 0, c), uo_nth(r.xs, 1, t), re.o)), n: re.n }
  }
  EMatch(s, arms) -> {
    let rs = uo_expr(s, cx, n)
    let ra = uo_arms(arms, cx, rs.n, [])
    Anf { e: with_kind(e, EMatch(rs.e, ra.arms)), n: ra.n }
  }
  ELambda(ps, b) -> {
    let r = uo_expr(b, uo_frame(cx.ucx), n)
    Anf { e: with_kind(e, ELambda(ps, r.e)), n: r.n }
  }
  EHandle(body, eff, hs, tys, init, alias, cls, ret) -> {
    let ri = uo_opt(init, cx, n)
    let rb = uo_expr(body, cx, ri.n)
    let rc = uo_clauses(cls, uo_frame(cx.ucx), rb.n, [])
    let rr = uo_ret(ret, uo_frame(cx.ucx), rc.n)
    Anf { e: with_kind(e, EHandle(rb.e, eff, hs, tys, ri.o, alias, rc.cls, rr.o)), n: rr.n }
  }
  _ -> uo_pipe_or_ops(e, cx, n)
}

fn uo_pipe_or_ops(e: Expr, cx: UoCx, n: Int) : Anf = match e.kind {
  EPipe(a, b)        -> uo_pair(e, a, b, cx, n, (x, y) => EPipe(x, y))
  EMapPipe(a, b)     -> uo_pair(e, a, b, cx, n, (x, y) => EMapPipe(x, y))
  EFlatMapPipe(a, b) -> uo_pair(e, a, b, cx, n, (x, y) => EFlatMapPipe(x, y))
  EFilterPipe(a, b)  -> uo_pair(e, a, b, cx, n, (x, y) => EFilterPipe(x, y))
  _ -> match anf_operands(e) {
    Some(xs) -> {
      let r = uo_list(xs, cx, n, [])
      uo_name(anf_rebuild(e, r.xs), r.xs, cx, r.n)
    }
    None -> Anf { e: e, n: n }
  }
}

# A pasted loop body must stay a lambda literal, so an intrinsic keeps
# its operands in place.
fn uo_name(e: Expr, xs: [Expr], cx: UoCx, n: Int) : Anf = match e.kind {
  EIntrinsic(_, _) -> Anf { e: e, n: n }
  _ ->
    if uo_strands(xs, 0, picked_index(xs, (x) => uo_leaves(x, cx), true, 0, 0 - 1)) {
      match anf_bind_until(e, (x) => uo_leaves(x, cx), uo_prefix(), n) {
        Some(a) -> a
        None    -> Anf { e: e, n: n }
      }
    } else { Anf { e: e, n: n } }
}

# An operand before the one at `k` holds a reference of its own.
fn uo_strands(xs: [Expr], i: Int, k: Int) : Bool = match xs {
  [] -> false
  [x, ...rest] -> i < k and (uo_owned(x) or uo_strands(rest, i + 1, k))
}

# A boxed read counts: the ownership passes may dup it in place, and once
# the operands after it are bound it is read only when the construct runs.
fn uo_owned(x: Expr) : Bool = match x.kind {
  EModCall(_, _) -> false
  EInt(_, _)     -> false
  EIntLit(_)     -> false
  EBool(_)       -> false
  EUnit          -> false
  _ -> match x.ty {
    Some(TyUnit) -> false
    Some(t)      -> not ty_is_scalar(t)
    None         -> true
  }
}

fn uo_pair(e: Expr, a: Expr, b: Expr, cx: UoCx, n: Int, k: (Expr, Expr) -> ExprKind) : Anf = {
  let r = uo_list([a, b], cx, n, [])
  Anf { e: with_kind(e, k(uo_nth(r.xs, 0, a), uo_nth(r.xs, 1, b))), n: r.n }
}

fn uo_nth(xs: [Expr], i: Int, dflt: Expr) : Expr = match xs {
  [] -> dflt
  [x, ...rest] -> if i == 0 { x } else { uo_nth(rest, i - 1, dflt) }
}

type UoList = { xs: [Expr], n: Int }

fn uo_list(xs: [Expr], cx: UoCx, n: Int, acc: [Expr]) : UoList = match xs {
  [] -> UoList { xs: list_reverse(acc), n: n }
  [x, ...rest] -> {
    let r = uo_expr(x, cx, n)
    uo_list(rest, cx, r.n, [r.e, ...acc])
  }
}

type UoOpt = { o: Option[Expr], n: Int }

fn uo_opt(o: Option[Expr], cx: UoCx, n: Int) : UoOpt = match o {
  Some(x) -> {
    let r = uo_expr(x, cx, n)
    UoOpt { o: Some(r.e), n: r.n }
  }
  None -> UoOpt { o: None, n: n }
}

type UoStmts = { ss: [Stmt], n: Int }

fn uo_stmts(ss: [Stmt], cx: UoCx, n: Int, acc: [Stmt]) : UoStmts = match ss {
  [] -> UoStmts { ss: list_reverse(acc), n: n }
  [s, ...rest] -> match s {
    SLet(p, t, rhs) -> {
      let r = uo_expr(rhs, cx, n)
      uo_stmts(rest, cx, r.n, [SLet(p, t, r.e), ...acc])
    }
    SExprStmt(x) -> {
      let r = uo_expr(x, cx, n)
      uo_stmts(rest, cx, r.n, [SExprStmt(r.e), ...acc])
    }
    _ -> uo_stmts(rest, cx, n, [s, ...acc])
  }
}

type UoArms = { arms: [Arm], n: Int }

fn uo_arms(arms: [Arm], cx: UoCx, n: Int, acc: [Arm]) : UoArms = match arms {
  [] -> UoArms { arms: list_reverse(acc), n: n }
  [Arm(p, g, b), ...rest] -> {
    let rg = uo_opt(g, cx, n)
    let rb = if uo_rebuilds(p, g, b) { uo_operands_only(b, cx, rg.n) } else { uo_expr(b, cx, rg.n) }
    uo_arms(rest, cx, rb.n, [Arm(p, rg.o, rb.e), ...acc])
  }
}

# An arm whose value rebuilds the shape it matched may reuse the matched
# cell in place, and that lowering evaluates the rebuild's operands after
# it tests the cell: they stay in it.
fn uo_rebuilds(p: Pattern, g: Option[Expr], b: Expr) : Bool = match g {
  Some(_) -> false
  None    -> uo_rebuilds_shape(p, b)
}

fn uo_rebuilds_shape(p: Pattern, b: Expr) : Bool = match p.pkind {
  PList([_], Some(_)) -> match b.kind {
    EList([ElPlain(_), ElSpread(_)]) -> true
    _ -> false
  }
  PVariant(_, _, _)       -> uo_is_ctor_call(b)
  PVariantRecord(_, _, _) -> uo_is_ctor_call(b)
  PRecord(_) -> match b.kind {
    ERecordLit(_, _) -> true
    _ -> false
  }
  _ -> false
}

fn uo_is_ctor_call(b: Expr) : Bool = match b.kind {
  ECall(f, _) -> match sym_read_kind(f.kind) {
    EVar(c)        -> uo_upper(c)
    EModCall(_, c) -> uo_upper(c)
    _ -> false
  }
  _ -> false
}

fn uo_upper(c: String) : Bool = match char_at(c, 0) {
  Some(ch) -> ch_is_upper(ch)
  None     -> false
}

fn uo_operands_only(e: Expr, cx: UoCx, n: Int) : Anf = match anf_operands(e) {
  Some(xs) -> {
    let r = uo_list(xs, cx, n, [])
    Anf { e: anf_rebuild(e, r.xs), n: r.n }
  }
  None -> uo_expr(e, cx, n)
}

type UoCls = { cls: [HClause], n: Int }

fn uo_clauses(cls: [HClause], cx: UoCx, n: Int, acc: [HClause]) : UoCls = match cls {
  [] -> UoCls { cls: list_reverse(acc), n: n }
  [HC(nm, ps, b, l, c), ...rest] -> {
    let r = uo_expr(b, cx, n)
    uo_clauses(rest, cx, r.n, [HC(nm, ps, r.e, l, c), ...acc])
  }
}

type UoRet = { o: Option[HReturn], n: Int }

fn uo_ret(ret: Option[HReturn], cx: UoCx, n: Int) : UoRet = match ret {
  Some(HR(p, b, l, c)) -> {
    let r = uo_expr(b, cx, n)
    UoRet { o: Some(HR(p, r.e, l, c)), n: r.n }
  }
  None -> UoRet { o: None, n: n }
}
