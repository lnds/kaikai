#[doc("""
The emitted names of specialisations.

A specialisation is no symbol: it is its generic's id and an instance
index. The monomorphiser, which creates it, also decides the name it is
emitted under and files that name here; the emitters read it back by the
function's identity.
""")]

import compiler.ast
import compiler.written

#[doc("One specialisation and the name it is emitted under.")]
pub type SpecName = SpecName(FnId, Written)

#[doc("The specialisations of a program by identity: buckets over the generic's id.")]
pub type SpecNames = { rows: [SpecName], buckets: Array[[SpecName]], nb: Int }

#[doc("No specialisations.")]
pub fn spec_names_empty() : SpecNames = SpecNames { rows: [], buckets: array_make(0, []), nb: 0 }

#[doc("The table over `rows`.")]
pub fn spec_names_of(rows: [SpecName]) : SpecNames = {
  let nb = sn_nbuckets(list_length(rows), 16)
  SpecNames { rows: rows, buckets: sn_fill(rows, array_make(nb, []), nb), nb: nb }
}

#[doc("Every specialisation the table holds.")]
pub fn spec_names_rows(sn: SpecNames) : [SpecName] = sn.rows

#[doc("The name the specialisation `f` is emitted under, if the table holds it.")]
pub fn spec_name(sn: SpecNames, f: FnId) : Option[Written] =
  if sn.nb == 0 { None } else { sn_find(array_get(sn.buckets, sn_slot(f, sn.nb)), f) }

#[doc("The name the specialisation `f` is emitted under; the empty name when the table does not hold it.")]
pub fn spec_text(sn: SpecNames, f: FnId) : Written = match spec_name(sn, f) {
  Some(w) -> w
  None    -> written("")
}

fn sn_nbuckets(n: Int, nb: Int) : Int = if nb >= 2 * n { nb } else { sn_nbuckets(n, 2 * nb) }

fn sn_slot(f: FnId, nb: Int) : Int = (sym_raw(fnid_sym(f)) + fnid_inst(f) + 1) % nb

fn sn_fill(rows: [SpecName], a: Array[[SpecName]], nb: Int) : Array[[SpecName]] / Mutable = match rows {
  [] -> a
  [r, ...rest] -> match r {
    SpecName(f, _) -> {
      let i = sn_slot(f, nb)
      sn_fill(rest, array_set(a, i, [r, ...array_get(a, i)]), nb)
    }
  }
}

fn sn_find(rs: [SpecName], f: FnId) : Option[Written] = match rs {
  [] -> None
  [SpecName(g, w), ...rest] -> if fnid_eq(f, g) { Some(w) } else { sn_find(rest, f) }
}
