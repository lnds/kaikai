#[doc("The names a declaration is given at runtime: home spelling, contested-name resolution and specialisation mangling.")]

import compiler.util
import compiler.ast_ids
import compiler.written
import compiler.symtab

# compiler/home_spell.kai — the home-spelled name a contested declaration
# is emitted under.
#
# Two modules declaring the same name each get `<name>__<home>`; the
# suffix is an identifier piece so every symbol minted from the name
# stays one. `rt_name` decides which declarations carry it.

#[doc("A module path as an identifier piece: dots become underscores.")]
pub(pkg) fn hs_ident(home: String) : String = hs_ident_loop(home, 0, string_length(home), "")

fn hs_ident_loop(s: String, i: Int, n: Int, acc: String) : String =
  if i >= n { acc }
  else { match char_at(s, i) {
    Some(c) -> {
      let piece = if c == '.' { "_" } else { int_to_byte_string(char_to_int(c)) }
      hs_ident_loop(s, i + 1, n, string_concat(acc, piece))
    }
    None    -> acc
  } }

#[doc("`name` as declared by `home`: `Item__da`.")]
pub(pkg) fn hs_spell(name: String, home: String) : String =
  concat_all([name, "__", hs_ident(home)])

#[doc("The name the declaration `s` is emitted under: the one it was declared with, spelled with its home when another module declares an effect or a type of that name and the bare one is not this declaration's to keep. `tab` is the program's table, which knows its root and core modules.")]
pub(pkg) fn rt_name(tab: SymTab, s: SymId) : String = {
  let name = written_text(decl_name(tab, s))
  if rt_spelled_apart(tab, s) { hs_spell(name, written_text(sym_home(tab, s))) } else { name }
}

#[doc("The name a reference is emitted under: its declaration's once it is settled, the name the source wrote, without its qualifier, before.")]
pub(pkg) fn rt_ref_name(tab: SymTab, r: DeclRef) : String = match r {
  DrSym(s)        -> rt_name(tab, s)
  DrWritten(_, n) -> written_text(n)
}

# Only effects and types are told apart: no other class is keyed by its
# spelling below the resolver.
#[doc("True when the declaration `s` is emitted under a name spelled with its home: its bare name is another declaration's.")]
pub(pkg) fn rt_spelled_apart(tab: SymTab, s: SymId) : Bool =
  if not st_valid(tab, s) { false }
  else { match sym_class(tab, s) {
    NCEffect -> rt_effect_apart(tab, s, sym_homonyms(tab, s))
    NCType   -> sym_contested(tab, s) and not sym_in_root(tab, s) and not sym_in_core(tab, s)
    _        -> false
  } }

fn rt_effect_apart(tab: SymTab, s: SymId, homonyms: [SymId]) : Bool = match homonyms {
  [_, _, ..._] ->
    if sym_in_core(tab, s) { false }
    else { not sym_in_root(tab, s) or any(homonyms, (h) => sym_in_core(tab, h)) }
  _ -> false
}

#[doc("One specialisation and the name it is emitted under.")]
pub(pkg) type SpecName = SpecName(FnId, Written)

#[doc("The specialisations of a program by identity: buckets over the generic's id.")]
pub(pkg) type SpecNames = { rows: [SpecName], buckets: Array[[SpecName]], nb: Int }

#[doc("The table over `rows`.")]
pub(pkg) fn spec_names_of(rows: [SpecName]) : SpecNames = {
  let nb = sn_nbuckets(list_length(rows), 16)
  SpecNames { rows: rows, buckets: sn_fill(rows, array_make(nb, []), nb), nb: nb }
}

#[doc("Every specialisation the table holds.")]
pub(pkg) fn spec_names_rows(sn: SpecNames) : [SpecName] = sn.rows

#[doc("The name the specialisation `f` is emitted under, if the table holds it.")]
pub(pkg) fn spec_name(sn: SpecNames, f: FnId) : Option[Written] =
  if sn.nb == 0 { None } else { sn_find(array_get(sn.buckets, sn_slot(f, sn.nb)), f) }

#[doc("The name the specialisation `f` is emitted under; the empty name when the table does not hold it.")]
pub(pkg) fn spec_text(sn: SpecNames, f: FnId) : Written = match spec_name(sn, f) {
  Some(w) -> w
  None    -> written("")
}

fn sn_nbuckets(n: Int, nb: Int) : Int = if nb >= 2 * n { nb } else { sn_nbuckets(n, 2 * nb) }

fn sn_slot(f: FnId, nb: Int) : Int = (sym_raw(fnid_sym(f)) + fnid_inst(f) + 1) % nb

fn sn_fill(rows: [SpecName], a: Array[[SpecName]], nb: Int) : Array[[SpecName]] / Mutable = match rows {
  [] -> a
  [r, ...rest] -> match r {
    SpecName(f, _) -> {
      let i = sn_slot(f, nb)
      sn_fill(rest, array_set(a, i, [r, ...array_get(a, i)]), nb)
    }
  }
}

fn sn_find(rs: [SpecName], f: FnId) : Option[Written] = match rs {
  [] -> None
  [SpecName(g, w), ...rest] -> if fnid_eq(f, g) { Some(w) } else { sn_find(rest, f) }
}
