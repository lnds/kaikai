#[doc("Name resolution of expressions and patterns, the registration of what a module declares, and the settling of refinements.")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.effect_alias
import compiler.symtab
import compiler.resolve_state
import compiler.handler_alias
import compiler.resolve_env
import compiler.scope_view
import compiler.written
import compiler.name_report
import compiler.pipe_fusion
import compiler.modules_homes
import compiler.builtins
import compiler.refine_types
import compiler.operators
import compiler.fmt
import compiler.local_names
import compiler.expr_positions
import compiler.migrate

#[doc("True when the file's scope view reaches the declaration `s` under `name`.")]
pub(pkg) fn reached_in_view(rs: ResState, s: SymId, name: String) : Bool =
  sym_raw(s) >= 0 and sv_reaches(rs.view, sym_owner(rs.tab, s), name)

#[doc("""
The qualifier already names the home, so the function, constant or
constructor it reaches is one declaration. A name the table does not
hold keeps the qualified spelling.
""")]
pub(pkg) fn chk_modcall(e: Env, m: String, f: String, k: ExprKind) : ExprKind =
  if rs_recording(e.rs) {
    match rs_qualified_fn(e.rs, m, f) {
      Some(s) -> ESym(s, spec_none())
      None    -> match qualified_value(e.rs.tab, [NCConst, NCCtor], m, f) {
        Some(s) -> ESym(s, spec_none())
        None    -> k
      }
    }
  } else { k }

fn qualified_value(tab: SymTab, cs: [NCls], m: String, f: String) : Option[SymId] = match cs {
  [] -> None
  [c, ...rest] -> match ru_qualified_class(tab, c, m, f) {
    URSym(i) -> Some(SymId(i))
    _        -> qualified_value(tab, rest, m, f)
  }
}

# From here on a string is a literal, in an expression or in a pattern:
# every pass downstream reads `#{` as two characters. A span the lift
# left as text would lose its interpolation without a word, so it stops
# the build instead.
#[doc("Reports a string literal that still holds an interpolation: the lift should have removed it.")]
pub(pkg) fn chk_literal_str(e: Env, x: Expr) : Env / Console + File = match x.kind {
  EStr(span, _) -> if has_interp(span, 0, string_length(span)) { chk_unlifted_interp(e, x) } else { e }
  _             -> e
}

fn chk_unlifted_interp(e: Env, x: Expr) : Env / Console + File {
  let msg = "internal: an interpolated string reached name resolution as text"
  let d = mk_diag(SevError, e.file, x.line, x.col, msg, [])
  render_diag(d)
  env_mark_err(env_push_diag(e, d))
}

# Asked here, not in a scan of the source as written: an interpolation
# body is a tree only from the lift on, and every one reaches this walk.
#[doc("Reports a literal of a stdlib type written in a file that does not import the type's module.")]
pub(pkg) fn chk_literal_import(e: Env, x: Expr) : Env / Console + File =
  if not rs_recording(e.rs) { e }
  else { match suffix_import_diags(x, e.rs.view, e.file) {
    []        -> e
    [d, ..._] -> env_report_once(e, x, d)
  } }

# Every hole in a body has its `show` by now; one left under its mark
# sits where no body is lowered.
#[doc("Reports an interpolation written where none is rendered, as in a type's `where` predicate.")]
pub(pkg) fn chk_interp_mark(e: Env, x: Expr) : Env / Console + File = match x.kind {
  EMark(MkInterpShow) ->
    env_report_once(e, x, mk_diag(SevError, e.file, x.line, x.col, "an interpolated string cannot be written here",
                                  [ri_note(e.file, x.line, x.col, "a type's `where` predicate takes plain strings")]))
  _                   -> e
}

fn env_report_once(e: Env, x: Expr, d: Diagnostic) : Env / Console + File =
  if env_reported(e.diags, e.file, x.line, x.col, diag_text(d)) { e } else {
    render_diag(d)
    env_mark_err(env_push_diag(e, d))
  }

#[doc("""
Canonical Rust/Elm-style diagnostic. The error line stays terse; the
did-you-mean suggestion moves to a separate `help:` line and is
suppressed when no name is within Levenshtein distance 3.
""")]
pub(pkg) fn chk_unbound(e: Env, name: String, x: Expr) : Env / Console + File {
  let msg = unbound_msg(name)
  if env_reported(e.diags, e.file, x.line, x.col, msg) { e } else {
    let related = match unbound_hint(e, name) {
      Some(h) -> [ri_help(e.file, x.line, x.col, h)]
      None    -> []
    }
    let d = mk_diag(SevError, e.file, x.line, x.col, msg, related)
    if e.quiet { () } else { render_diag(d) }
    env_mark_err(env_push_diag(e, d))
  }
}

#[doc("The message reported for a name bound to nothing.")]
pub(pkg) fn unbound_msg(name: String) : String = "cannot find `#{name}` in this scope"

#[doc("The message of a diagnostic.")]
pub(pkg) fn diag_text(d: Diagnostic) : String = match d { D(_, _, _, _, m, _) -> m }

#[doc("""
A predicate is read where its type is written and again wherever a
check of it was planted, so one mistake in it is reported once.
""")]
pub(pkg) fn env_reported(ds: [Diagnostic], file: String, line: Int, col: Int, msg: String) : Bool = match ds {
  [] -> false
  [D(_, f, l, c, m, _), ...rest] ->
    (l == line and c == col and f == file and m == msg) or env_reported(rest, file, line, col, msg)
}

# A name that appears as a bare alias right-hand side has no
# constructor precisely because the declaration is an alias; the
# leading bar is what would have made it a sum. `region` is a keyword
# of the block form only. A parameter of a lambda a pipe ended is out of
# scope by grammar, and a nearby name would mislead. Anything else falls
# back to the did-you-mean, which stays silent past distance 3.
fn unbound_hint(e: Env, name: String) : Option[String] / File =
  if list_has(e.alias_heads, name) {
    Some("`type ... = #{name}` declares an alias, so `#{name}` is not a constructor — write `type ... = | #{name}` for a one-member sum")
  } else if name == "region" {
    Some("`region` is a block form, not a function — write `region { ... }`")
  } else if is_some(file_op_replacement(name)) {
    Some("`#{name}` is now `file.#{unwrap_or(file_op_replacement(name), name)}` — add `import fs.file`, or run `kai migrate`")
  } else {
    match cut_hint(e.cut_pipes, name, e.file) {
      Some(h) -> Some(h)
      None    -> near_hint(e, name)
    }
  }

fn near_hint(e: Env, name: String) : Option[String] = match closest_name(name, list_append(env_all_names(e), e.ghosts)) {
  Some(s) -> Some("a similar name exists in scope: `#{s}` (did you mean this?)")
  None    -> None
}

#[doc("The environment after a list of expressions was resolved.")]
pub(pkg) fn rx_envs(r: RExprs) : Env = match r { RExprs(e, _) -> e }

#[doc("The argument position a piped value takes: `0` when the stage writes `_`, else `1`.")]
pub(pkg) fn piped_slot(xs: [Expr]) : Int = match xs {
  [] -> 1
  [x, ...rest] -> match x.kind { EUnder -> 0  _ -> piped_slot(rest) }
}

# ---- calls ----

#[doc("What resolving a callee reads from the environment.")]
pub(pkg) fn env_call_cx(e: Env) : CallCx = CallCx(e.chain, e.rs, e.callees, e.larity)

#[doc("""
A dispatcher the type settles among several homes stays the written
name every one of them answers to.
""")]
pub(pkg) fn disp_ref(d: Disp) : ExprKind = match d {
  DispSym(s)        -> ESym(s, spec_none())
  DispWritten(name) -> EName(written(name))
}

#[doc("""
A name the core rung answered: the builtin's own row when the table
declares one, else the name as written.
""")]
pub(pkg) fn core_ref(e: Env, name: String, x: Expr) : Expr = match rs_builtin(e.rs, name) {
  Some(s) -> sym_ref(s, x)
  None    -> x
}

#[doc("An expression of kind `k` at the position and with the type of `x`.")]
pub(pkg) fn at(k: ExprKind, x: Expr) : Expr = Expr { kind: k, line: x.line, col: x.col, ty: x.ty, mode: x.mode,  site: x.site }

#[doc("A reference to the declaration `s`, standing where `x` stood.")]
pub(pkg) fn sym_ref(s: SymId, x: Expr) : Expr = at(ESym(s, spec_none()), x)

#[doc("Warns once, with a hint to rename or qualify, about a call the resolver left as written.")]
pub(pkg) fn warn_skip(e: Env, x: Expr, msg: String) : Env / Console + File =
  if env_reported(e.diags, e.file, x.line, x.col, msg) { e } else {
    let help = "rename one of the two, or qualify the call to name the one it means"
    let d = mk_diag(SevWarning, e.file, x.line, x.col, msg, [ri_help(e.file, x.line, x.col, help)])
    if e.quiet { () } else { render_diag(d) }
    env_push_diag(e, d)
  }

#[doc("""
The effect a reference names. A qualifier picks the module outright;
a bare name climbs the scope view like any other class. A reference
already settled keeps its declaration.
""")]
pub(pkg) fn chk_effect_sym(e: Env, r: DeclRef) : SymId = match r {
  DrSym(s)        -> s
  DrWritten(q, n) -> if rs_recording(e.rs) { rs_effect_sym(e.rs, ref_text(q, n)) } else { sym_none() }
}

#[doc("A reference as written: `q.n`, or `n` alone.")]
pub(pkg) fn ref_text(q: Option[Written], n: Written) : String = match q {
  Some(m) -> cat3(written_text(m), ".", written_text(n))
  None    -> written_text(n)
}

#[doc("""
The effect heading an op call `Eff.op` is settled the way a handler
head is. A name the value lookup left bare is not a value, and a local
binder of that name keeps it.
""")]
pub(pkg) fn chk_op_base(e: Env, b: Expr, op: String) : Expr = match b.kind {
  EName(n) -> if env_shadowed(e, written_text(n)) { b } else {
    match chk_op_head(e, written_text(n), op) {
      None    -> b
      Some(s) -> sym_ref(s, b)
    }
  }
  _ -> b
}

# Written on a row alias, the head is the component that declares the
# op: a row label and an evidence key must name an atomic effect.
fn chk_op_head(e: Env, head: String, op: String) : Option[SymId] = {
  let direct = chk_effect_sym(e, ref_written(head))
  if sym_raw(direct) >= 0 { Some(direct) }
  else {
    # A component was settled where the alias was written, so its own id
    # stands; only an unsettled one is resolved from here.
    match alias_op_owner(e.eff_ops, alias_components(e.row_aliases, head, 0), op) {
      None -> None
      Some(RL(r, _)) -> {
        let s = chk_effect_sym(e, r)
        if sym_raw(s) >= 0 { Some(s) } else { None }
      }
    }
  }
}

#[doc("A handler alias, if one was written, and the environment after it is bound.")]
pub(pkg) type RAlias = RAlias(Env, Option[Binder])

#[doc("""
A user alias is bound only when the surrounding scope reaches no binding
of that name: an outer `log` array must stay reachable from the clause
rather than being silently replaced by the state slot. No node declares
an alias, so its binder is the one minted under its name.
""")]
pub(pkg) fn bind_state_aliases(e: Env, outer: Env) : Env =
  bind_minted(e, clause_state_aliases((nm) => env_reaches(outer, nm)))

fn bind_minted(e: Env, keys: [String]) : Env = match keys {
  []             -> e
  [key, ...rest] -> bind_minted(env_with_chain(e, ch_bind_local(e.chain, key, local_minted(key))), rest)
}

# The name reaches another handler's state alias, which the innermost handler's own alias replaces.
fn env_reaches_alias(e: Env, nm: String) : Bool = match ch_lookup(e.chain, nm) {
  Some(BLocal(l)) -> clause_alias_is_written(l)
  _               -> false
}

#[doc("""
Announce every alias a clause reads that the enclosing scope takes
over, so the alias going dark is never a silent surprise. Emitted once
per handler, at the `handle` site, not once per clause.
""")]
pub(pkg) fn warn_shadowed_aliases(e: Env, names: [String], line: Int, col: Int) : Env / Console + File {
  match names {
    [] -> e
    [nm, ...rest] -> {
      let e1 = if env_reaches(e, nm) and not e.quiet and not env_reaches_alias(e, nm) {
        let d = mk_diag(SevWarning, e.file, line, col,
          "`#{nm}` inside this handler's clauses is the enclosing binding, not the handler state",
          [ri_note(e.file, line, col, "a stateful handler binds `#{nm}` as an alias of its state slot; an enclosing binding of that name takes precedence"),
           ri_help(e.file, line, col, "rename the enclosing binding to reach the handler state under `#{nm}`")])
        render_diag(d)
        env_push_diag(e, d)
      } else { e }
      warn_shadowed_aliases(e1, rest, line, col)
    }
  }
}

#[doc("Resolved handler clauses, and the environment after them.")]
pub(pkg) type RClauses = RClauses(Env, [HClause])

#[doc("Resolved parameters, and the environment with them bound.")]
pub(pkg) type RParams = RParams(Env, [Param])

#[doc("`ps` bound in `e`, in order.")]
pub(pkg) fn add_params(e: Env, ps: [Param]) : RParams = add_params_loop(e, ps, [])

fn add_params_loop(e: Env, ps: [Param], acc: [Param]) : RParams = match ps {
  [] -> RParams(e, list_reverse(acc))
  [p, ...rest] -> match env_bind(e, p.binder) {
    RBinder(e1, b1) ->
      add_params_loop(note_bound_arity(e1, b1.id, binder_arity(None, p.ptype)), rest, [Param { ...p, binder: b1 }, ...acc])
  }
}

#[doc("The local id of each parameter.")]
pub(pkg) fn param_ids(ps: [Param]) : [LocalId] = map(ps, (p) => p.binder.id)

#[doc("""
A binder whose definition fixes its arity records it, so a call of
another arity passes it over for the next binding of its name.
""")]
pub(pkg) fn note_arity(e: Env, pat: Pattern, a: Option[Int]) : Env = match pat.pkind {
  PBind(b) -> note_bound_arity(e, b.id, a)
  _        -> e
}

fn note_bound_arity(e: Env, l: LocalId, a: Option[Int]) : Env = match a {
  None    -> e
  Some(n) -> Env { ...e, larity: [LocalArity(l, n), ...e.larity] }
}

# ---- refinement predicates ----

# A refinement's predicate is an expression of the scope its type is
# written in, where `self` is the value the type constrains: a binder of
# the predicate, whatever the scope calls `self`.

#[doc("Resolved type expressions, and the environment after them.")]
pub(pkg) type RTys = RTys(Env, [TypeExpr])

#[doc("A resolved optional type annotation, and the environment after it.")]
pub(pkg) type ROptTy = ROptTy(Env, Option[TypeExpr])

#[doc("Resolved effect operations, and the environment after them.")]
pub(pkg) type REffOps = REffOps(Env, [EffectOp])

#[doc("Add every name in `names` to the current (top) scope of `e`.")]
pub(pkg) fn add_all(e: Env, names: [String]) : Env =
  reduce(names, e, (acc, n) => env_add_untyped(acc, n))

# ---- pattern bindings: number a pattern's binders and bind their names ----

#[doc("A resolved pattern, and the environment with its binders.")]
pub(pkg) type RPat = RPat(Env, Pattern)

#[doc("A resolved pattern kind, and the environment with its binders.")]
pub(pkg) type RPatKind = RPatKind(Env, PatKind)

#[doc("Resolved patterns, and the environment with their binders.")]
pub(pkg) type RPats = RPats(Env, [Pattern])

#[doc("Resolved pattern fields, and the environment with their binders.")]
pub(pkg) type RPFields = RPFields(Env, [PField])

#[doc("""
A pattern binds a name once: a second binder of it would shadow the
first with no equality checked between the two.
""")]
pub(pkg) fn chk_pat_repeats(e: Env, p: Pattern) : Env / Console + File = match first_repeat(pat_binder_names(p, []), []) {
  None    -> e
  Some(n) -> {
    let d = mk_diag(SevError, e.file, p.line, p.col, "duplicate binding in pattern: `#{n}`",
                    [ri_note(e.file, p.line, p.col, "binding `#{n}` already used elsewhere in this pattern"),
                     ri_help(e.file, p.line, p.col, "use a different name, or extract the equality with a guard: `MkPair(x, y) if x == y -> ...`")])
    render_diag(d)
    env_mark_err(env_push_diag(e, d))
  }
}

fn first_repeat(names: [String], seen: [String]) : Option[String] = match names {
  [] -> None
  [n, ...rest] -> if list_has(seen, n) { Some(n) } else { first_repeat(rest, [n, ...seen]) }
}

#[doc("`e` with the names the declaration `d` declares.")]
pub(pkg) fn register_one(e: Env, d: Decl) : Env {
  match d {
    DFn(_, fid, _, _, _, _, _, _, _, _) -> env_add_decl(e, fnid_sym(fid))
    DType(_, tsym, _, body, _, _, _, _) -> {
      let e1 = env_add_decl(e, tsym)
      match body {
        TBSum(variants) -> register_variants_env(e1, variants)
        TBAlias(t) -> match t.tkind {
          TyName(r, []) -> env_note_alias_head(e1, type_ref_text(e1, r))
          _ -> e1
        }
        TBEffectAlias(labels) ->
          if list_is_empty(labels) { e1 }
          else { Env { ...e1, row_aliases: [RA(env_sym_text(e1, tsym), map(labels, (l) => settle_label(e1, l))), ...e1.row_aliases] } }
        _ -> e1
      }
    }
    DTest(_, _, _, _, _) -> e
    DBench(_, _, _, _, _) -> e
    DCheck(_, _, _, _, _, _) -> e
    DImport(ik, _, _) -> register_import(e, ik)
    DEffect(_, esym, _, ops, _, _, _, _) -> {
      let e1 = env_add_decl(e, esym)
      Env { ...e1, eff_ops: [EO(esym, eff_op_names(ops, [])), ...e1.eff_ops] }
    }
    # stripped pre-resolve; never reaches register_one in practice.
    # No-op for completeness so the match stays exhaustive.
    DProtocol(_, _, _, _, _, _, _) -> e
    DImpl(_, _, _, _, _, _, _, _) -> e
    DDerive(_, _, _, _) -> e
    DUnstable(_, _, _) -> e
    DProtoLaws(_, inner, _, _, _) -> register_one(e, inner)  # stripped pre-resolve; defensive
    DImplAxiom(_, inner, _, _, _) -> register_one(e, inner)
    DConstructor(inner, _, _) -> register_one(e, inner)   # bind the marked fn name
    DUnit(_, _, _, _, _, _, _) -> e            # unit names live in their own namespace, validated at type-resolve time
    DUse(_, _, _) -> e                       # opened and dropped by the resolver
    DUseKind(_, _, _, _) -> e                # stripped by the kind-resolution pass before register_one runs
    DAxiom(_, _, name, _, _, _, _, _, _, _) -> env_add(e, name, NCFn)  # also rewritten to DFn by lower_axioms; case kept for completeness
    DConst(_, csym, _, _, _, _, _, _, _) -> env_add_decl(e, csym)
    DExternType(_, name, _, _, _, _) -> env_add(e, name, NCExternType)   # FFI v2: register the foreign type name so its references resolve
    DDoc(_, _, inner, _, _) -> register_one(e, inner)   # register the documented decl
    DAttr(_, inner, _, _) -> register_one(e, inner)
    DModuleDoc(_, _, _, _) -> e                          # doc text only, no names
    DTheory(_, _, _, _, _) -> e                             # catalog decl: no value binding
    DKind(_, _, _, _, _, _, _, _) -> e                         # catalog decl: no value binding
  }
}

fn register_variants_env(e: Env, vs: [Variant]) : Env {
  match vs {
    [] -> e
    [v, ...rest] -> match v {
      Var(csym, _) -> register_variants_env(env_add_decl(e, csym), rest)
    }
  }
}

# The name an alias's right-hand side spells, for the hint an unbound
# use of it earns.
fn type_ref_text(e: Env, r: DeclRef) : String = match r {
  DrWritten(q, n) -> ref_text(q, n)
  DrSym(s)        -> written_text(decl_name(e.rs.tab, s))
}

# A component that names an effect is settled from the alias's own
# home; one that names another alias stays written.
fn settle_label(e: Env, l: RowLabel) : RowLabel = match l {
  RL(DrWritten(q, n), ts) -> {
    let s = chk_effect_sym(e, DrWritten(q, n))
    if sym_raw(s) >= 0 { RL(DrSym(s), ts) } else { l }
  }
  _ -> l
}

# For imports we add just the surface name: the last segment of the
# dotted path, the alias, or each selected name. Stage 0 does the
# same; deeper module resolution is a stage 2 concern.
#[doc("Last dotted segment of an import path (`a.b.c` -> `c`).")]
pub(pkg) fn last_segment(path: String) : String {
  last_segment_loop(path, string_length(path) - 1, string_length(path))
}

fn last_segment_loop(s: String, i: Int, end: Int) : String {
  if i < 0 { string_slice(s, 0, end) }
  else {
    match char_at(s, i) {
      Some(c) -> if c == '.' { string_slice(s, i + 1, end - i - 1) }
                 else { last_segment_loop(s, i - 1, end) }
      None -> string_slice(s, 0, end)
    }
  }
}

fn register_import(e: Env, ik: ImportKind) : Env {
  match ik {
    IkPath(path) -> env_add(e, last_segment(path), NCModule)
    IkAlias(_, alias) -> env_add(e, alias, NCModule)
    IkSelective(_, names) -> add_all(e, names)
    # import holes don't bind anything in the value namespace — they
    # are diagnostic-only. Skip for env-binding purposes; the
    # symbol-index pass handles the diagnostic.
    IkHole(_) -> e
  }
}

# The alias's home, every function's arity, and the operations a
# protocol declares: one of those outranks a core function of its name.
type SettleCx = { rs: ResState, ct: CalleeTab, ops: [String], names: PredCx }

#[doc("`decls` with the predicate of every refinement alias settled in the alias's home. `tab` holds the declarations, `views` what each file sees, `target` names the root module.")]
pub(pkg) fn settle_alias_refinements(decls: [Decl], tab: SymTab, views: FileViews, target: String) : [Decl] =
  if not any(decls, is_refined_alias) { decls }
  else {
    let cx = SettleCx { rs: rs_on_views(tab, views, target, kai_unshadowed(core_names(), decls, tab)),
                        ct: ct_build(decls, target, []), ops: proto_op_labels(decls, []),
                        names: PredCx { tab: tab, views: views, decls: decls } }
    map(decls, (d) => decl_map_inner(d, (x) => settle_decl(x, cx)))
  }

fn is_refined_alias(d: Decl) : Bool = match decl_transparent_inner(d) {
  Some(inner) -> is_refined_alias(inner)
  None        -> match d {
    DType(_, _, _, TBAlias(t), _, _, _, _) -> tys_refined([t])
    _                                      -> false
  }
}

fn proto_op_labels(ds: [Decl], acc: [String]) : [String] = match ds {
  []           -> acc
  [d, ...rest] -> match decl_transparent_inner(d) {
    Some(inner) -> proto_op_labels([inner, ...rest], acc)
    None        -> match d {
      DProtocol(_, _, _, ops, _, _, _) ->
        proto_op_labels(rest, list_append(map(ops, (o) => match o { POp(n, _, _, _, _, _) -> n }), acc))
      _ -> proto_op_labels(rest, acc)
    }
  }
}

fn settle_decl(d: Decl, cx: SettleCx) : Decl = match d {
  DType(pb, t, tps, TBAlias(te), l, c, mo, xs) ->
    if not tys_refined([te]) { d }
    else {
      let at = SettleCx { ...cx, rs: rs_at_home(cx.rs, written_text(sym_home(cx.rs.tab, t))) }
      let scoped = map(tys_preds([te]), (p) => settle(p, at))
      match tys_with_preds([te], pn_settle_all(scoped, tys_bases([te]), at.rs.view, cx.names)) {
        [te1, ..._] -> DType(pb, t, tps, TBAlias(te1), l, c, mo, xs)
        []          -> d
      }
    }
  _ -> d
}

# Only the forms that bind nothing are walked, so every name met here is
# free in the predicate.
fn settle(e: Expr, cx: SettleCx) : Expr = match e.kind {
  EName(w)         -> settle_read(e, written_text(w), cx)
  ECall(f, xs)     -> settled(e, ECall(settle_callee(f, list_length(xs), cx), map(xs, (x) => settle(x, cx))))
  EBinop(op, a, b) -> settled(e, EBinop(op, settle(a, cx), settle(b, cx)))
  EUnop(op, x)     -> settled(e, EUnop(op, settle(x, cx)))
  EField(b, f)     -> settled(e, EField(settle(b, cx), f))
  EIndex(a, b)     -> settled(e, EIndex(settle(a, cx), settle(b, cx)))
  _                -> e
}

fn settled(e: Expr, k: ExprKind) : Expr = Expr { ...e, kind: k }

fn sym_read(e: Expr, s: SymId) : Expr = settled(e, ESym(s, spec_none()))

fn is_self(name: String) : Bool = name == written_text(pred_self_binder().name)

fn near(cx: SettleCx, name: String, fits: (SymId) -> Bool) : RsCall =
  rs_call_sym(cx.rs, name, sv_near_rungs(), fits)

# A name read as a value: the nearest declaration of it, unless a
# protocol operation outranks the far rungs.
fn settle_read(e: Expr, name: String, cx: SettleCx) : Expr =
  if is_self(name) { settled(e, ELocal(pred_self())) }
  else if list_has(cx.ops, name) and not near_answers(near(cx, name, (s) => true)) { e }
  else { match rs_decl_sym(cx.rs, name) {
    Some(s) -> sym_read(e, s)
    None    -> e
  } }

fn near_answers(c: RsCall) : Bool = match c {
  RsCall(RcNone, _) -> false
  _                 -> true
}

# A bare callee climbs the ladder with the call's arity.
fn settle_callee(f: Expr, n: Int, cx: SettleCx) : Expr = match f.kind {
  EName(w) -> {
    let name = written_text(w)
    if is_self(name) { settle_read(f, name, cx) }
    else { settle_call(f, name, (s) => ct_fits(cx.ct, s, n), cx) }
  }
  _ -> settle(f, cx)
}

fn settle_call(f: Expr, name: String, fits: (SymId) -> Bool, cx: SettleCx) : Expr =
  match near(cx, name, fits) {
    RsCall(RcSym(s), _) -> sym_read(f, s)
    RsCall(RcNone, _)   ->
      if list_has(cx.ops, name) { f }
      else { settle_far(f, name, rs_call_sym(cx.rs, name, [SvCores, SvAny], fits), cx) }
    _ -> f
  }

fn settle_far(f: Expr, name: String, c: RsCall, cx: SettleCx) : Expr = match c {
  RsCall(RcSym(s), _) -> sym_read(f, s)
  RsCall(RcCore, _)   -> match rs_builtin(cx.rs, name) {
    Some(s) -> sym_read(f, s)
    None    -> f
  }
  _ -> f
}

#[doc("A contract clause as its source wrote it, before the resolver runs. Every name in one is written text, so it prints with no table.")]
pub(pkg) fn pred_text(p: Expr) : String = fmt_expr_text(p, st_empty(), ln_with_expr(ln_empty(), p))

#[doc("A refinement predicate as its source wrote it. `tab` names the declarations it refers to and `locals` the binders it reads besides its own `self`.")]
pub(pkg) fn refine_pred_text(p: Expr, tab: SymTab, locals: LocalNames) : String =
  fmt_expr_text(p, tab, ln_with_binder(ln_with_expr(locals, p), pred_self_binder()))

#[doc("`acc` with the name of every binder `p` reads besides its own `self`, each asked of `name`.")]
pub(pkg) fn pred_local_names(p: Expr, name: (LocalId) -> Written, acc: LocalNames) : LocalNames = match p.kind {
  ELocal(l) -> if local_eq(l, pred_self()) { acc } else { ln_with_binder(acc, Binder { id: l, name: name(l) }) }
  _         -> pred_names_in(xp_positions(p), name, acc)
}

fn pred_names_in(xps: [XPos], name: (LocalId) -> Written, acc: LocalNames) : LocalNames = match xps {
  []                  -> acc
  [XP(_, c), ...rest] -> pred_names_in(rest, name, pred_local_names(c, name, acc))
}

# Build the help suffix for a single-ident requires predicate, or the
# empty string when no base type can be rendered. `ident` is the
# offending binding's name (already recovered by the single-ident
# detector); `pred` is the comparison Expr; `params` the fn's declared
# parameters. The result is appended to the contract-violation C string
# literal, so it is pre-escaped (newline as the two bytes backslash-n).
#[doc("Render the help-narrow suffix for a single-ident requires violation; empty string when the declared base type is not renderable.")]
pub(pkg) fn requires_help_line(ident: Written, pred: Expr, params: [Param]) : String {
  match param_base_type_name(ident, params) {
    None -> ""
    Some(base) -> match elide_pred_lhs(pred, ident) {
      None -> ""
      Some(rhs_text) -> concat_all([
        "\\n  = help: narrow `", escape_str_body_for_c(written_text(ident)),
        "` to `", escape_str_body_for_c(base),
        " where ", escape_str_body_for_c(rhs_text), "`"
      ])
    }
  }
}

# Find the parameter named `ident` and return its declared base type
# name, unwrapping a refined annotation to the underlying base. None
# when the param is unannotated or its base is not an atomic named type
# (the single-ident scalar shape never refers to a generic/fn/list base,
# so anything else falls through to piece-1).
fn param_base_type_name(ident: Written, params: [Param]) : Option[String] {
  match params {
    [] -> None
    [p, ...rest] ->
      if same_text(p.binder.name, ident) {
        match p.ptype {
          None -> None
          Some(t) -> base_ty_name(t)
        }
      } else { param_base_type_name(ident, rest) }
  }
}

# The base type name of a declared TypeExpr: the head of a TyName, or
# the base of a TyRefine (so a refined param still yields its base).
# Other shapes return None — they are not the atomic base the help line
# renders. Neither is a head a scope pass already settled: it has no
# spelling to suggest.
fn base_ty_name(t: TypeExpr) : Option[String] = match t.tkind {
  TyName(r, _) -> match r {
    DrWritten(None, n)    -> Some(written_text(n))
    DrWritten(Some(q), n) -> Some(concat_all([written_text(q), ".", written_text(n)]))
    DrSym(_)              -> None
  }
  TyRefine(base, _, _) -> base_ty_name(base)
  _ -> None
}

# Two names before the resolver: the same binder when they spell alike.
fn same_text(a: Written, b: Written) : Bool = written_text(a) == written_text(b)

# Drop the ident from the LHS of an `<ident> <cmp> <literal>` comparison
# and render the remaining `<cmp> <literal>` text (the self-elided
# refinement predicate). Handles either operand order. None when the
# shape is not the single-ident comparison this lane covers.
fn elide_pred_lhs(pred: Expr, ident: Written) : Option[String] = match pred.kind {
  EBinop(op, a, b) ->
    if expr_is_var(a, ident) and is_scalar_lit(b) {
      Some(concat_all([binop_text(op), " ", pred_text(b)]))
    } else if expr_is_var(b, ident) and is_scalar_lit(a) {
      # Mirror so the elided form keeps the literal on the right:
      # a `0.0 != b` predicate renders as `!= 0.0` under the flipped op.
      Some(concat_all([binop_text(flip_cmp(op)), " ", pred_text(a)]))
    } else { None }
  _ -> None
}

fn expr_is_var(e: Expr, name: Written) : Bool = match e.kind {
  EName(s) -> same_text(s, name)
  _ -> false
}

fn is_scalar_lit(e: Expr) : Bool = match e.kind {
  EInt(_, _)  -> true
  EReal(_, _) -> true
  EIntLit(_) -> true
  EDecimalLit(_) -> true
  EFixed(_, _) -> true
  EBool(_) -> true
  EChar(_) -> true
  _ -> false
}

# Flip a comparator so `<literal> OP <ident>` re-renders as
# `<ident> FLIP(OP) <literal>` — keeping the literal on the right of the
# elided predicate. `==` / `!=` are symmetric.
fn flip_cmp(op: BinOp) : BinOp = match op {
  BoLt -> BoGt
  BoLe -> BoGe
  BoGt -> BoLt
  BoGe -> BoLe
  _    -> op
}
