# compiler/fmt_names.kai — surface spelling of the pieces a signature
# keeps typed: a type parameter with its kind and bounds, a row's open
# tail, a unit expression.

import compiler.util
import compiler.ast
import compiler.written
import compiler.kinds
import compiler.tbinder

#[doc("A type parameter as the source spells it, kind or bounds included.")]
pub fn fmt_tparam(b: TBinder) : String = match b.kind {
  KUnit(k) -> string_concat_all([written_text(b.name), ": ", k])
  KShape   -> string_concat_all([written_text(b.name), ": Shape"])
  _        -> match b.bounds {
    [] -> written_text(b.name)
    bs -> string_concat_all([written_text(b.name), ": ", string_join(map(bs, fmt_bound), " + ")])
  }
}

fn fmt_bound(r: DeclRef) : String = match r {
  DrWritten(Some(q), n) -> string_concat_all([written_text(q), ".", written_text(n)])
  DrWritten(None, n)    -> written_text(n)
  DrSym(_)              -> "?"
}

#[doc("A row's open tail as the source spells it: a row variable's name, or `?` / `?name` for a hole.")]
pub fn fmt_row_tail(tail: TParamRef) : String = tail_written_text(tail)

# Emit a UnitExprT in surface form the parser accepts. This is
# stricter than `unit_expr_display` (which uses bare juxtaposition
# `kg m` for products); the parser only recognises `*`, `/` and `+`
# between unit terms (see `parse_unit_expr_rest`).
# Used by `fmt` for `unit` declarations and `<...>` literal/type
# annotations so the formatter's output re-parses cleanly.
#[doc("Render a unit expression in the surface form the parser accepts, with explicit `*`, `/` and `+`.")]
pub fn fmt_unit_expr_str(u: UnitExprT) : String = match u {
  UOne -> "1"
  USym(s) -> if kind_sym_is_qualified(s) {
    concat_all([kind_sym_kind(s), ".", kind_sym_bare(s)])
  } else { kind_sym_bare(s) }
  UMul(a, b) -> match b {
    UInv(bi) -> match a {
      UOne -> concat_all(["1/", fmt_unit_expr_str(bi)])
      _    -> concat_all([fmt_unit_expr_str(a), "/", fmt_unit_expr_str(bi)])
    }
    UOne -> fmt_unit_expr_str(a)
    _ -> match a {
      UOne          -> fmt_unit_expr_str(b)
      UInv(ai)      -> concat_all([fmt_unit_expr_str(b), "/", fmt_unit_expr_str(ai)])
      _             -> concat_all([fmt_unit_expr_str(a), "*", fmt_unit_expr_str(b)])
    }
  }
  UInv(a) -> concat_all(["1/", fmt_unit_expr_str(a)])
  UPow(a, n) -> concat_all([fmt_unit_expr_str(a), "^", int_to_string(n)])
  UJoin(a, b) -> concat_all([fmt_unit_expr_str(a), " + ", fmt_unit_expr_str(b)])
  UVar(n) -> cat2("?u", int_to_string(n))
  UDims(us) -> fmt_unit_exprs_str(us)
  UParam(_) -> "?"
}

fn fmt_unit_exprs_str(us: [UnitExprT]) : String = match us {
  [] -> ""
  [u] -> fmt_unit_expr_str(u)
  [u, ...rest] -> concat_all([fmt_unit_expr_str(u), ", ", fmt_unit_exprs_str(rest)])
}
