#[doc("The formatter's non-expression forms: types, effect rows, type parameters, parameter lists and patterns.")]

import compiler.util
import compiler.ast
import compiler.ast_ids
import compiler.ast_ids
import compiler.written
import compiler.fmt_writer
import compiler.fmt_shape
import compiler.fmt_layout
import compiler.fmt_expr

# `[T, U]` after an effect name or type name; nothing for an empty list.
pub(pkg) fn fmt_type_arg_list(ty_args: [TypeExpr], line: Int, s: FmtSt) : FmtSt =
  if list_is_empty(ty_args) { s } else { fmt_type_seq("[", "]", line, ty_args, s, (t) => t) }

#[doc("A delimited list of types: flat when it fits and the author kept it so, one type per line otherwise; `line` is the opener's source line.")]
pub(pkg) fn fmt_type_seq(open: String, close: String, line: Int, tys: [TypeExpr], s: FmtSt, tail: (FmtSt) -> FmtSt) : FmtSt {
  let style = SeqStyle { open: open, close: close, pad: false, fill: false, hug: false }
  fmt_seq(s, style, line, map(tys, (t) => SeqItem(t.line, (u) => fmt_type(t, u))), tail)
}

pub(pkg) fn fmt_tparams(tparams: [TBinder], s: FmtSt) : FmtSt {
  if list_is_empty(tparams) { s }
  else {
    let decoded = map(tparams, (t) => fmt_tparam(t))
    fmt_emit(s, string_concat_all(["[", string_join(decoded, ", "), "]"]))
  }
}

# `(p1, p2)` as a signature's parameter list: flat when it fits with
# what follows on the line, one parameter per line otherwise.
pub(pkg) fn fmt_param_seq(params: [Param], open_line: Int, s: FmtSt, tail: (FmtSt) -> FmtSt) : FmtSt {
  let style = SeqStyle { open: "(", close: ")", pad: false, fill: false, hug: false }
  fmt_seq(s, style, open_line, map(params, (p) => SeqItem(p.pline, (t) => fmt_param(p, t))), tail)
}

pub(pkg) fn fmt_params(params: [Param], s: FmtSt) : FmtSt {
  match params {
    [] -> s
    [p] -> fmt_param(p, s)
    [p, ...rest] -> {
      let s1 = fmt_param(p, s)
      let s2 = fmt_emit(s1, ", ")
      fmt_params(rest, s2)
    }
  }
}

fn fmt_param(p: Param, s: FmtSt) : FmtSt {
  # A borrowed param prints `^` hugging the name (`^t`, no space).
  let s0 = if p.pborrow { fmt_emit(s, "^") } else { s }
  let s1 = fmt_emit(s0, written_text(p.binder.name))
  match p.ptype {
    None -> s1
    Some(t) -> {
      let a = fmt_emit(s1, ": ")
      fmt_type(t, a)
    }
  }
}

#[doc("An effect row in suffix position, ` / E1 + E2`; nothing for an empty row.")]
pub(pkg) fn fmt_row(row: RowExpr, s: FmtSt) : FmtSt =
  if fmt_row_prints(row) { fmt_row_bare(row, fmt_emit(s, " / ")) } else { s }

pub(pkg) fn fmt_row_labels(ls: [RowLabel], s: FmtSt) : FmtSt {
  match ls {
    [] -> s
    [l] -> fmt_row_label(l, s)
    [l, ...rest] -> {
      let s1 = fmt_row_label(l, s)
      let s2 = fmt_emit(s1, " + ")
      fmt_row_labels(rest, s2)
    }
  }
}

fn fmt_row_label(rl: RowLabel, s: FmtSt) : FmtSt {
  match rl {
    RL(r, ty_args) -> fmt_type_arg_list(ty_args, fmt_first_type_line(ty_args), fmt_emit(s, fmt_ref_text(s, r)))
  }
}

# ---- types ----------------------------------------------------------

pub(pkg) fn fmt_type(t: TypeExpr, s: FmtSt) : FmtSt {
  match t.tkind {
    TyName(r, ty_args) -> fmt_type_arg_list(ty_args, t.line, fmt_emit(s, fmt_ref_text(s, r)))
    TyList(elem) -> {
      let s1 = fmt_emit(s, "[")
      let s2 = fmt_type(elem, s1)
      fmt_emit(s2, "]")
    }
    TyFn(params, ret, row) ->
      fmt_type_seq("(", ")", t.line, params, s, (u) => fmt_type_row(ret, row, fmt_emit(u, " -> ")))
    TyDim(base, u) -> {
      let s1 = fmt_type(base, s)
      let s2 = fmt_emit(s1, "<")
      let s3 = fmt_emit(s2, fmt_unit_expr_str(u))
      fmt_emit(s3, ">")
    }
    # The receiver elisions (`where >= 0`, `where matches p`) the parser
    # expands into an explicit `self` are restored.
    TyRefine(base, pred, _) -> {
      let s1 = fmt_type_grouped(base, s)
      let s2 = fmt_emit(s1, " where ")
      match fmt_refine_elision(base, pred) {
        Some(RE(lead, rhs)) -> fmt_expr(rhs, fmt_emit(s2, lead))
        None                -> fmt_expr(pred, s2)
      }
    }
    # A compound row as a type argument (`Stream[Int, Stdout + Fail]`).
    TyRow(row) -> fmt_row_bare(row, s)
    # Surface spellings print exactly what the author wrote.
    TySurface(ts) -> match ts {
      TsTuple(tys) -> fmt_type_seq("(", ")", t.line, tys, s, (u) => u)
      TsUnitSpan(raw, inner) -> match inner.tkind {
        TyDim(base, _) -> {
          let s1 = fmt_type(base, s)
          let s2 = fmt_emit(s1, "<")
          let s3 = fmt_emit(s2, raw)
          fmt_emit(s3, ">")
        }
        _ -> panic("kai fmt: TsUnitSpan without a dimensioned type")
      }
    }
    TyParam(_, _) -> panic("kai fmt: a numbered type parameter in a parsed tree")
  }
}

#[doc("A type followed by the effect row `row`, grouped when the row would otherwise bind inside the type.")]
pub(pkg) fn fmt_type_row(t: TypeExpr, row: RowExpr, s: FmtSt) : FmtSt =
  if fmt_row_prints(row) { fmt_row(row, fmt_type_grouped(t, s)) } else { fmt_type(t, s) }

fn fmt_row_prints(row: RowExpr) : Bool = match row {
  REmpty          -> false
  RClosed(labels) -> not list_is_empty(labels)
  ROpen(_, _)     -> true
}

# An arrow's return type and a refinement's predicate extend to the end
# of the type: a suffix after either binds inside it unless grouped.
fn fmt_type_grouped(t: TypeExpr, s: FmtSt) : FmtSt = match t.tkind {
  TyFn(_, _, _)  -> fmt_emit(fmt_type(t, fmt_emit(s, "(")), ")")
  TyRefine(_, _, _) -> fmt_emit(fmt_type(t, fmt_emit(s, "(")), ")")
  _              -> fmt_type(t, s)
}

# A row's labels and tail without the leading ` / `.
fn fmt_row_bare(row: RowExpr, s: FmtSt) : FmtSt {
  match row {
    REmpty -> s
    RClosed(labels) -> fmt_row_labels(labels, s)
    ROpen(tail, labels) ->
      if list_is_empty(labels) {
        fmt_emit(s, fmt_row_tail(tail))
      } else {
        let s1 = fmt_row_labels(labels, s)
        let s2 = fmt_emit(s1, " + ")
        fmt_emit(s2, fmt_row_tail(tail))
      }
  }
}

# ---- expressions ----------------------------------------------------

pub(pkg) fn fmt_hole(opt: Option[String], s: FmtSt) : FmtSt = match opt {
  None    -> fmt_emit(s, "?")
  Some(n) -> fmt_emit(s, string_concat_all(["?", n]))
}

pub(pkg) fn fmt_pat(p: Pattern, s: FmtSt) : FmtSt {
  match p.pkind {
    PWild -> fmt_emit(s, "_")
    PLit(e) -> fmt_expr(e, s)
    PRange(lo, hi) -> {
      let s1 = fmt_expr(lo, s)
      let s2 = fmt_emit(s1, "..")
      fmt_expr(hi, s2)
    }
    PBind(b) -> fmt_emit(s, written_text(b.name))
    PList(subs, rest) -> fmt_pat_list_form(subs, fmt_binder_opt_text(rest), s)
    PVariant(r, subs) -> fmt_pat_variant(fmt_ref_text(s, r), subs, s)
    PVariantRecord(r, fields) -> {
      let s1 = fmt_emit(s, fmt_ref_text(s, r))
      let s2 = fmt_emit(s1, " { ")
      let s3 = fmt_pfields(fields, s2)
      fmt_emit(s3, " }")
    }
    PRecord(fields) -> {
      let s1 = fmt_emit(s, "{ ")
      let s2 = fmt_pfields(fields, s1)
      fmt_emit(s2, " }")
    }
    PHole(opt) -> fmt_hole(opt, s)
    PAs(b, sub) -> {
      let s1 = fmt_emit(s, written_text(b.name))
      let s2 = fmt_emit(s1, " @ ")
      fmt_pat(sub, s2)
    }
    PNarrow(b, ty) -> {
      let s1 = fmt_emit(s, written_text(b.name))
      let s2 = fmt_emit(s1, " : ")
      fmt_type(ty, s2)
    }
    PSurface(ps) -> fmt_pat_surface(ps, s)
  }
}

# The rest pattern rides the same brackets as the element list, and
# only takes a separator when elements precede it.
fn fmt_pat_list_form(subs: [Pattern], rest: Option[String], s: FmtSt) : FmtSt {
  let s1 = fmt_emit(s, "[")
  let s2 = fmt_pat_list(subs, s1)
  fmt_emit(fmt_pat_rest(subs, rest, s2), "]")
}

fn fmt_binder_opt_text(o: Option[Binder]) : Option[String] = match o {
  None    -> None
  Some(b) -> Some(written_text(b.name))
}

fn fmt_pat_rest(subs: [Pattern], rest: Option[String], s: FmtSt) : FmtSt = match rest {
  None -> s
  Some(name) -> {
    let a = if list_is_empty(subs) { s } else { fmt_emit(s, ", ") }
    fmt_emit(a, string_concat_all(["...", name]))
  }
}

fn fmt_pat_variant(name: String, subs: [Pattern], s: FmtSt) : FmtSt {
  let s1 = fmt_emit(s, name)
  if list_is_empty(subs) {
    s1
  } else {
    let s2 = fmt_emit(s1, "(")
    let s3 = fmt_pat_list(subs, s2)
    fmt_emit(s3, ")")
  }
}

# Surface spellings print exactly what the author wrote.
fn fmt_pat_surface(ps: PatSurface, s: FmtSt) : FmtSt = match ps {
  PsTuple(pats) -> {
    let s1 = fmt_emit(s, "(")
    let s2 = fmt_pat_list(pats, s1)
    fmt_emit(s2, ")")
  }
  PsQualified(qual, sub) -> {
    let s1 = fmt_emit(s, qual)
    let s2 = fmt_emit(s1, ".")
    fmt_pat(sub, s2)
  }
  PsAs(name, sub) -> {
    let s1 = fmt_emit(s, name)
    let s2 = fmt_emit(s1, " as ")
    fmt_pat(sub, s2)
  }
  PsRefine(name, ty) -> {
    let s1 = fmt_emit(s, name)
    let s2 = fmt_emit(s1, " : ")
    fmt_type(ty, s2)
  }
  PsAnonRest(subs, wild) -> fmt_pat_list_form(subs, Some(if wild { "_" } else { "" }), s)
}

pub(pkg) fn fmt_pat_list(ps: [Pattern], s: FmtSt) : FmtSt {
  match ps {
    [] -> s
    [p] -> fmt_pat(p, s)
    [p, ...rest] -> {
      let s1 = fmt_pat(p, s)
      let s2 = fmt_emit(s1, ", ")
      fmt_pat_list(rest, s2)
    }
  }
}

fn fmt_pfields(fs: [PField], s: FmtSt) : FmtSt {
  match fs {
    [] -> s
    [f] -> fmt_pfield(f, s)
    [f, ...rest] -> {
      let s1 = fmt_pfield(f, s)
      let s2 = fmt_emit(s1, ", ")
      fmt_pfields(rest, s2)
    }
  }
}

fn fmt_pfield(pf: PField, s: FmtSt) : FmtSt {
  match pf {
    PField(name, sub, is_short) -> {
      if is_short {
        fmt_emit(s, name)
      } else {
        let s1 = fmt_emit(s, name)
        let s2 = fmt_emit(s1, ": ")
        fmt_pat(sub, s2)
      }
    }
  }
}

# ---- pipes ----------------------------------------------------------
