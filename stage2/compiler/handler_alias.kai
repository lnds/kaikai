# compiler/handler_alias.kai — the handler-state aliases a stateful handler's clauses bind and read.

import compiler.util
import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.expr_positions
import compiler.written
import compiler.diag

#[doc("The mint keys of the handler-state aliases a user writes; an enclosing binding of either name takes precedence inside the clauses.")]
pub(pkg) fn user_state_aliases() : [String] = ["state", "log"]

#[doc("True when `l` is a binder a clause body reads by a name the language gives it: a handler-state alias, or the canonical continuation.")]
pub(pkg) fn clause_alias_is_written(l: LocalId) : Bool =
  any([canonical_continuation(), ...user_state_aliases()], (key) => local_eq(l, local_minted(key)))

#[doc("The binder that pins the declared type of a `var` cell, for its initial value or a write minted at `line`:`col`. It is spelled after the cell and identified by where it is minted.")]
pub(pkg) fn var_ann_binder(cell: String, line: Int, col: Int) : Binder =
  Binder { id: local_minted(concat_all(["__var_ann@", int_to_string(line), ":", int_to_string(col)])),
           name: written(string_concat(cell, var_ann_suffix())) }

fn var_ann_suffix() : String = "__ann"

#[doc("True when the pattern is the binder `var_ann_binder` mints at the pattern's own position.")]
pub(pkg) fn pat_is_var_ann(p: Pattern) : Bool = match p.pkind {
  PBind(b) -> local_eq(b.id, var_ann_binder("", p.line, p.col).id)
  _        -> false
}

#[doc("The cell a `var_ann_binder` pins, as a diagnostic names it.")]
pub(pkg) fn var_ann_cell(b: Binder) : String = {
  let n = written_text(b.name)
  string_slice(n, 0, string_length(n) - string_length(var_ann_suffix()))
}

#[doc("The mint key of the alias a `var` cell's synthetic clauses reach their slot through; no enclosing binding takes it over.")]
pub(pkg) fn var_cell_alias() : String = "__var_cell"

#[doc("The keys of the aliases a stateful handler binds in its clauses. `bound_outside` says whether the enclosing scope already binds the alias of a key, in the caller's own terms: the written name for the resolver, the key's minted binder for a pass that tracks scope by id, the spelled name for an emitter.")]
pub(pkg) fn clause_state_aliases(bound_outside: (String) -> Bool) : [String] =
  list_append(filter(user_state_aliases(), (nm) => not bound_outside(nm)), [var_cell_alias()])

#[doc("The keys of the handler-state aliases a stateful handler actually binds, given the names the enclosing scope spells: the emitted locals or registers of a pass that tracks its scope by spelling.")]
fn live_state_aliases(stateful: Bool, local_scope: [String]) : [String] =
  if stateful { clause_state_aliases((key) => scope_spells(local_scope, key)) } else { [] }

fn scope_spells(scope: [String], key: String) : Bool = match scope {
  []           -> false
  [x, ...rest] -> x == key or scope_spells(rest, key)
}

#[doc("The keys of the state aliases a handle binds in its clauses: a handle carries state exactly when it has an initial value.")]
pub(pkg) fn handle_live_aliases(init_opt: Option[Expr], local_scope: [String]) : [String] = match init_opt {
  Some(_) -> live_state_aliases(true, local_scope)
  None    -> []
}

#[doc("The boxed binders a clause lends to raw operators, which read the payload and leave the box alone: its op arguments and, in a stateful handle, every state alias.")]
pub(pkg) fn clause_lent_names(params: [Param], init_opt: Option[Expr]) : [LocalId] =
  list_append(map(clause_op_args(params), (p) => p.binder.id), map(handle_live_aliases(init_opt, []), local_minted))

#[doc("The aliases `body` reads by name, of those a stateful clause binds, given which names the enclosing scope already binds. Asked by the resolver, of a body it has not resolved yet.")]
pub(pkg) fn seg_state_aliases(bound_outside: (String) -> Bool, body: Expr) : [String] =
  filter(user_state_aliases(), (nm) => not bound_outside(nm) and expr_mentions(nm, body))

#[doc("`body` with each alias in `names` bound to `s`, as the source would write it.")]
pub(pkg) fn seg_state_block(names: [String], s: Expr, body: Expr) : Expr =
  Expr { kind: EBlock(map(names, (nm) => SLet(mk_pat(PBind(binder_written(nm)), s.line, s.col), None, s)), Some(body)),
         line: body.line, col: body.col, ty: None, mode: body.mode,  site: body.site }

#[doc("The names in `names` that some clause or the return clause of a handler mentions, before the resolver has read them.")]
pub(pkg) fn aliases_read_by_clauses(names: [String], cs: [HClause], ret_opt: Option[HReturn]) : [String] =
  filter(names, (nm) => clauses_mention(nm, cs) or return_mentions(nm, ret_opt))

fn clauses_mention(nm: String, cs: [HClause]) : Bool = match cs {
  []                              -> false
  [HC(_, _, body, _, _), ...rest] -> expr_mentions(nm, body) or clauses_mention(nm, rest)
}

fn return_mentions(nm: String, ret_opt: Option[HReturn]) : Bool = match ret_opt {
  Some(HR(_, body, _, _)) -> expr_mentions(nm, body)
  None                    -> false
}

#[doc("True when `e` names `nm` anywhere inside it, before names are resolved.")]
pub(pkg) fn expr_mentions(nm: String, e: Expr) : Bool = match e.kind {
  EName(u) -> written_text(u) == nm
  _        -> positions_mention(nm, xp_positions(e))
}

fn positions_mention(nm: String, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> expr_mentions(nm, c) or positions_mention(nm, rest)
}

#[doc("True when `e` reads the local binder `l` anywhere inside it.")]
pub(pkg) fn expr_reads_local(l: LocalId, e: Expr) : Bool = match e.kind {
  ELocal(x) -> local_eq(x, l)
  _         -> positions_read(l, xp_positions(e))
}

fn positions_read(l: LocalId, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> expr_reads_local(l, c) or positions_read(l, rest)
}

#[doc("The mint key of the binder the typer gives every call of a clause's continuation, whatever the clause calls it.")]
pub(pkg) fn canonical_continuation() : String = "resume"

#[doc("A handler clause's op-argument params: every param but the continuation, which is always the last.")]
pub(pkg) fn clause_op_args(params: [Param]) : [Param] = match params {
  []           -> []
  [_]          -> []
  [p, ...rest] -> [p, ...clause_op_args(rest)]
}

#[doc("The binder a handler clause binds its continuation to: its last param, whatever it is called.")]
pub(pkg) fn clause_continuation(params: [Param]) : Option[Binder] = match params {
  []           -> None
  [p]          -> Some(p.binder)
  [_, ...rest] -> clause_continuation(rest)
}

#[doc("The continuation a read reaches: none, the enclosing clause's own, or that clause's from inside a lambda.")]
pub(pkg) type ClauseCont = CcNone | CcOwn(Binder) | CcInLambda(Binder)

#[doc("The continuation an op clause's body reaches.")]
pub(pkg) fn clause_cont_of(params: [Param]) : ClauseCont = match clause_continuation(params) {
  Some(k) -> CcOwn(k)
  None    -> CcNone
}

#[doc("The continuation a lambda body reaches: the clause's, from inside the lambda, unless one of the lambda's params is that binder.")]
pub(pkg) fn clause_cont_in_lambda(cc: ClauseCont, ps: [Param]) : ClauseCont = match cc {
  CcOwn(k)      -> if any(ps, (p) => local_eq(p.binder.id, k.id)) { CcNone } else { CcInLambda(k) }
  CcInLambda(k) -> if any(ps, (p) => local_eq(p.binder.id, k.id)) { CcNone } else { cc }
  CcNone        -> CcNone
}

#[doc("True when `l` is the binder of the continuation `cc` reaches.")]
pub(pkg) fn clause_cont_reaches(cc: ClauseCont, l: LocalId) : Bool = match cc {
  CcOwn(k)      -> local_eq(k.id, l)
  CcInLambda(k) -> local_eq(k.id, l)
  CcNone        -> false
}

#[doc("The ops of the handled effect declaration `d` that neither a clause in `clause_ops` nor a bridged default in `default_ops` covers, in declaration order.")]
pub(pkg) fn handler_missing_ops(d: Option[Decl], clause_ops: [String],
                           default_ops: [String]) : [String] = match d {
  Some(DEffect(_, _, _, ops, _, _, _, _)) -> hc_uncovered(hc_op_names(ops), clause_ops, default_ops)
  _ -> []
}

#[doc("Report a handle of `eff` that leaves `missing` without a clause; returns the diagnostic, if any.")]
pub(pkg) fn report_partial_handler(file: String, eff: String, missing: [String],
                              line: Int, col: Int) : [Diagnostic] / Console + File = match missing {
  [] -> []
  _  -> {
    let names = join_with(map(missing, (op) => "`#{op}`"), ", ")
    let d = mk_diag(SevError, file, line, col, "handler for `#{eff}` does not cover every op: missing #{names}",
                    [ri_note(file, line, col, "an op without a clause has no handler inside this `handle`; a clause is needed even when nothing calls it"),
                     ri_help(file, line, col, "add a clause for each missing op, e.g. `#{hc_first(missing)}(args, resume) -> resume(...)`")])
    [d]
  }
}

fn hc_op_names(ops: [EffectOp]) : [String] = match ops {
  []           -> []
  [o, ...rest] -> match o { EffOp(n, _, _, _, _, _) -> [n, ...hc_op_names(rest)] }
}

fn hc_uncovered(ops: [String], have: [String], dflt: [String]) : [String] = match ops {
  []           -> []
  [o, ...rest] ->
    if hc_has(have, o) or hc_has(dflt, o) { hc_uncovered(rest, have, dflt) }
    else { [o, ...hc_uncovered(rest, have, dflt)] }
}

fn hc_has(xs: [String], s: String) : Bool = match xs {
  []           -> false
  [x, ...rest] -> x == s or hc_has(rest, s)
}

fn hc_first(xs: [String]) : String = match xs {
  []      -> ""
  [x, ..._] -> x
}

#[doc("The `effect` declaration whose identity is `s`; None when `s` is unset or names no effect.")]
pub(pkg) fn effect_decl_of(s: SymId, decls: [Decl]) : Option[Decl] =
  if sym_raw(s) < 0 { None } else { edo_scan(sym_raw(s), decls) }

fn edo_scan(id: Int, ds: [Decl]) : Option[Decl] = match ds {
  [] -> None
  [d, ...rest] -> match d {
    DEffect(_, s, _, _, _, _, _, _) -> if sym_raw(s) == id { Some(d) } else { edo_scan(id, rest) }
    _ -> edo_scan(id, rest)
  }
}

#[doc("The `default { }` block an effect declaration carries; None when it carries none or is absent.")]
pub(pkg) fn effect_decl_default(d: Option[Decl]) : Option[DefaultBlock] = match d {
  Some(DEffect(_, _, _, _, defblk, _, _, _)) -> defblk
  _ -> None
}

#[doc("True when the declaration carries a `default { }` block whose every clause bridges to `$extern_handler` — the only shape codegen installs.")]
pub(pkg) fn effect_decl_default_all_extern(d: Option[Decl]) : Bool = match effect_decl_default(d) {
  Some(DBlk(clauses, _, _, _)) -> all_clauses_extern_handler(clauses)
  None -> false
}

#[doc("True when every clause body is a `$extern_handler` bridge.")]
fn all_clauses_extern_handler(cs: [HClause]) : Bool = match cs {
  [] -> true
  [HC(_, _, body, _, _), ...rest] -> match extern_handler_c_symbol(body) {
    None    -> false
    Some(_) -> all_clauses_extern_handler(rest)
  }
}

#[doc("The C symbol a `$extern_handler(\"c_symbol\")` body bridges to; None for any other body, a triple-quoted argument included.")]
pub(pkg) fn extern_handler_c_symbol(body: Expr) : Option[String] = match body.kind {
  EIntrinsic(InExternHandler, [a]) -> match a.kind {
    EStr(span, is_triple) -> if is_triple { None } else { Some(strip_string_quotes(span)) }
    _ -> None
  }
  _ -> None
}

#[doc("A string-literal span without its outer quotes; \"\" when shorter than two characters, the span unchanged when it is not quoted on both ends.")]
pub(pkg) fn strip_string_quotes(span: String) : String = {
  let n = string_length(span)
  if n < 2 { "" }
  else if char_at(span, 0) == Some('"') and char_at(span, n - 1) == Some('"') {
    string_slice(span, 1, n - 2)
  } else { span }
}

#[doc("True when `e` holds a `handle` anywhere inside it.")]
pub(pkg) fn holds_handle(e: Expr) : Bool = match e.kind {
  EInt(_, _)        -> false
  EReal(_, _)       -> false
  EFixed(_, _)      -> false
  EIntLit(_)        -> false
  EDecimalLit(_)    -> false
  EBool(_)          -> false
  EChar(_)          -> false
  EStr(_, _)        -> false
  EUnit             -> false
  EName(_)          -> false
  EMark(_)          -> false
  ESym(_, _)        -> false
  ELocal(_)         -> false
  EOp(_)            -> false
  EUnder            -> false
  EPlaceholder      -> false
  EHole(_)          -> false
  ETodo(_)          -> false
  EExternBody(_, _) -> false
  EVariantsOf(_, _) -> false
  EModCall(_, _)    -> false
  EHandle(_, _, _, _, _, _, _) -> true
  ECall(f, xs)       -> call_holds(f, xs)
  EField(b, _)       -> holds_handle(b)
  EIndex(a, b)       -> pair_holds(a, b)
  EBinop(_, a, b)    -> pair_holds(a, b)
  EUnop(_, x)        -> holds_handle(x)
  EIf(c, t, oe)      -> pair_holds(c, t) or opt_holds(oe)
  EMatch(s, arms)    -> scrutinee_holds(s, arms)
  ELambda(_, b)      -> holds_handle(b)
  ERecordLit(_, fs)  -> fields_hold(fs)
  EList(els)         -> elems_hold(els)
  ERange(a, b, os)   -> pair_holds(a, b) or opt_holds(os)
  EBlock(ss, ot)     -> block_holds(ss, ot)
  EPipe(a, b)        -> pair_holds(a, b)
  EDispatchPipe(_, a, b) -> pair_holds(a, b)
  EBang(x)           -> holds_handle(x)
  ELitUnit(x, _)     -> holds_handle(x)
  EIntrinsic(_, xs)  -> any_holds(xs)
  ESurface(sf)       -> any_holds(surface_children(sf))
}

fn pair_holds(a: Expr, b: Expr) : Bool = holds_handle(a) or holds_handle(b)

fn call_holds(f: Expr, xs: [Expr]) : Bool = holds_handle(f) or any_holds(xs)

fn scrutinee_holds(s: Expr, arms: [Arm]) : Bool = holds_handle(s) or arms_hold(arms)

fn block_holds(ss: [Stmt], ot: Option[Expr]) : Bool = stmts_hold(ss) or opt_holds(ot)

fn any_holds(xs: [Expr]) : Bool = match xs {
  []           -> false
  [x, ...rest] -> holds_handle(x) or any_holds(rest)
}

fn opt_holds(o: Option[Expr]) : Bool = match o {
  Some(x) -> holds_handle(x)
  None    -> false
}

fn arms_hold(arms: [Arm]) : Bool = match arms {
  []                      -> false
  [Arm(_, g, b), ...rest] -> opt_holds(g) or holds_handle(b) or arms_hold(rest)
}

fn fields_hold(fs: [FieldInit]) : Bool = match fs {
  []                  -> false
  [FI(_, v), ...rest] -> holds_handle(v) or fields_hold(rest)
}

fn elems_hold(els: [ListElem]) : Bool = match els {
  []                    -> false
  [ElPlain(x), ...rest]  -> holds_handle(x) or elems_hold(rest)
  [ElSpread(x), ...rest] -> holds_handle(x) or elems_hold(rest)
}

fn stmts_hold(ss: [Stmt]) : Bool = match ss {
  []           -> false
  [s, ...rest] -> stmt_holds(s) or stmts_hold(rest)
}

fn stmt_holds(s: Stmt) : Bool = match s {
  SLet(_, _, rhs)             -> holds_handle(rhs)
  SAssert(c, m)               -> holds_handle(c) or opt_holds(m)
  SExprStmt(x)                -> holds_handle(x)
  SIndexAssign(b, i, v, _, _) -> any_holds([b, i, v])
  SAssign(b, v, _, _)         -> pair_holds(b, v)
  SVar(_, _, rhs, _, _)       -> holds_handle(rhs)
  SUse(_, _, _)               -> false
}
