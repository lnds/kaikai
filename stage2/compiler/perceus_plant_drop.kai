# Per-path exit drops for a tail that holds a self-call.
#
# The post-tail wrap cannot release a binding when the tail is a
# self-tail-call — binding the call to a temporary would hide it from the
# TCO rewrite. Each tail path is closed individually instead: a direct
# self-call leaf hoists its arguments into temporaries, drops after that
# last read, and re-issues the call as the new block's tail (still a
# self-tail-call, so the goto survives); a plain-value leaf binds its
# value, drops, and yields. `None` declines the whole tail — the binding
# keeps its leak — when a path yields no expression. Partial planting is
# never attempted. A caller hoists only where `phg_keeps_marks` holds;
# `bpos`, the fn's borrowed boxed slots, keeps a bare read there in place.

import compiler.ast
import compiler.perceus_reads
import compiler.self_call
import compiler.ret_slots

pub fn ppd_plant(e: Expr, self_name: SelfRef, names: [Binder], bpos: [Int]) : Option[Expr] =
  if not ppd_has_self_call(e, self_name) { Some(ppd_wrap_leaf(e, names)) }
  else { ppd_plant_kind(e, self_name, names, bpos) }

fn ppd_plant_kind(e: Expr, self_name: SelfRef, names: [Binder], bpos: [Int]) : Option[Expr] = match e.kind {
  ECall(f, xs)    -> Some(ppd_hoist_with(e, f, xs, ppd_drops(names, e.line, e.col), bpos))
  EIf(c, t, oe)   -> ppd_plant_if(e, c, t, oe, self_name, names, bpos)
  EMatch(s, arms) -> match ppd_plant_arms(arms, self_name, names, bpos, []) {
    None        -> None
    Some(arms2) -> Some(ppd_rekind(e, EMatch(s, arms2)))
  }
  EBlock(bstmts, obt) -> ppd_plant_block(e, bstmts, obt, self_name, names, bpos)
  _ -> None
}

fn ppd_plant_if(e: Expr, c: Expr, t: Expr, oe: Option[Expr],
                self_name: SelfRef, names: [Binder], bpos: [Int]) : Option[Expr] = match oe {
  None     -> None
  Some(e2) -> ppd_both(ppd_plant(t, self_name, names, bpos), ppd_plant(e2, self_name, names, bpos),
                       (t2, e22) => ppd_rekind(e, EIf(c, t2, Some(e22))))
}

fn ppd_plant_block(e: Expr, bstmts: [Stmt], obt: Option[Expr],
                   self_name: SelfRef, names: [Binder], bpos: [Int]) : Option[Expr] = match obt {
  None -> None
  Some(bt) ->
    # An inner planting already hoisted this call's args: every read is
    # behind the temps, so these drops slot in before the tail. Hoisting
    # again would bind a temp to its own name inside one C scope.
    if ppd_is_hoist_block(bstmts) {
      Some(ppd_rekind(e, EBlock(list_append(bstmts, ppd_drops(names, e.line, e.col)), Some(bt))))
    }
    else { ppd_map(ppd_plant(bt, self_name, names, bpos),
                   (bt2) => ppd_rekind(e, EBlock(bstmts, Some(bt2)))) }
}

fn ppd_plant_arms(arms: [Arm], self_name: SelfRef, names: [Binder], bpos: [Int],
                  acc: [Arm]) : Option[[Arm]] = match arms {
  [] -> Some(list_reverse(acc))
  [a, ...rest] -> match a {
    Arm(pat, g, body) -> match ppd_plant(body, self_name, names, bpos) {
      None -> None
      Some(b2) -> ppd_plant_arms(rest, self_name, names, bpos, [Arm(pat, g, b2), ...acc])
    }
  }
}

fn ppd_map(o: Option[Expr], f: (Expr) -> Expr) : Option[Expr] = match o {
  None    -> None
  Some(x) -> Some(f(x))
}

fn ppd_both(a: Option[Expr], b: Option[Expr], f: (Expr, Expr) -> Expr) : Option[Expr] = match a {
  None    -> None
  Some(x) -> match b { None -> None  Some(y) -> Some(f(x, y)) }
}

fn ppd_rekind(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn ppd_wrap_leaf(e: Expr, names: [Binder]) : Expr = ppd_bind_then(e, ppd_drops(names, e.line, e.col))

#[doc("Bind `e`, run `stmts`, yield the value. The read keeps `e`'s type and mode, so an unboxed value binds a raw local.")]
pub fn ppd_bind_then(e: Expr, stmts: [Stmt]) : Expr = {
  let ret_let = SLet(mk_pat(PBind(ret_slot_binder(RsTail)), e.line, e.col), None, e)
  let ret_var = Expr { kind: ELocal(ret_slot_local(RsTail)), line: e.line, col: e.col,
                       ty: e.ty, mode: e.mode,  site: e.site }
  ppd_rekind(e, EBlock([ret_let, ...stmts], Some(ret_var)))
}

#[doc("A call with its args hoisted into temporaries and `stmts` run after the last one; unchanged when it is no call. A bare read in a slot of `bpos` stays in place.")]
pub fn ppd_hoist_then(call: Expr, stmts: [Stmt], bpos: [Int]) : Expr = match call.kind {
  ECall(f, xs) -> ppd_hoist_with(call, f, xs, stmts, bpos)
  _            -> call
}

#[doc("True when `d` is no drop, or drops a binder in `names`.")]
pub fn ppd_drop_among(d: Stmt, names: [Binder]) : Bool = match ppd_drop_name(d) {
  Some(l) -> pcs_has(names, l)
  None    -> true
}


# Bind the args left-to-right (evaluation order unchanged), drop after
# that last read, re-issue the call as the block tail. Each read carries
# the argument's type and mode — an unboxed argument binds a raw local.
# Temps are numbered densely over the hoisted args: `i` is the call
# position, `k` the next temp.
fn ppd_hoist_with(e: Expr, f: Expr, xs: [Expr], stmts: [Stmt], bpos: [Int]) : Expr {
  let call = ppd_rekind(e, ECall(f, ppd_hoist_reads(xs, bpos, 0, 0)))
  ppd_rekind(e, EBlock(list_append(ppd_hoist_lets(xs, bpos, 0, 0), stmts), Some(call)))
}

fn ppd_hoist_lets(xs: [Expr], bpos: [Int], i: Int, k: Int) : [Stmt] = match xs {
  []           -> []
  [a, ...rest] ->
    if ppd_stays(a, bpos, i) { ppd_hoist_lets(rest, bpos, i + 1, k) }
    else { [SLet(mk_pat(PBind(ret_slot_binder(ret_slot_tail_arg(a, k))), a.line, a.col), None, a),
            ...ppd_hoist_lets(rest, bpos, i + 1, k + 1)] }
}

fn ppd_hoist_reads(xs: [Expr], bpos: [Int], i: Int, k: Int) : [Expr] = match xs {
  []           -> []
  [a, ...rest] ->
    if ppd_stays(a, bpos, i) { [a, ...ppd_hoist_reads(rest, bpos, i + 1, k)] }
    else { [Expr { kind: ELocal(ret_slot_local(ret_slot_tail_arg(a, k))), line: a.line, col: a.col,
                   ty: a.ty, mode: a.mode,  site: a.site },
            ...ppd_hoist_reads(rest, bpos, i + 1, k + 1)] }
}

# A bare read in a borrowed boxed slot keeps, in place, the mark the later
# passes give it there; a read has no effect to order against its siblings.
fn ppd_stays(a: Expr, bpos: [Int], i: Int) : Bool = match a.kind {
  ELocal(_) -> any(bpos, (b) => b == i)
  _         -> false
}

# A block the planting pass built around a self-call: arg temps, drops,
# then the call as tail. Consumers that reason about "reads in the tail"
# must treat the whole block as the tail — the temps ARE the call's args.
pub fn ppd_is_hoist_block(stmts: [Stmt]) : Bool = match stmts {
  []           -> false
  [s, ...rest] -> match s {
    SLet(pat, _, _) -> ret_slot_binds_tail_arg(pat, 0) or ppd_is_hoist_block(rest)
    _               -> ppd_is_hoist_block(rest)
  }
}

pub fn ppd_drops(names: [Binder], ln: Int, cl: Int) : [Stmt] = match names {
  []           -> []
  [b, ...rest] -> [ppd_drop_stmt(b.id, ln, cl), ...ppd_drops(rest, ln, cl)]
}

#[doc("The binders a statement list declares, for shadowing checks.")]
pub fn ppd_let_names(stmts: [Stmt]) : [Binder] = match stmts {
  []           -> []
  [s, ...rest] -> match s {
    SLet(pat, _, _)     -> prc_pat_bindings(pat, ppd_let_names(rest))
    SVar(n, _, _, _, _) -> [n, ...ppd_let_names(rest)]
    _                   -> ppd_let_names(rest)
  }
}

#[doc("The binder a `__perceus_drop` statement releases, or `None` for any other statement.")]
pub fn ppd_drop_name(s: Stmt) : Option[LocalId] = match s {
  SExprStmt(e) -> match e.kind {
    ECall(callee, args_) -> match callee.kind {
      EMark(MkDrop) -> ppd_sole_var(args_)
      _             -> None
    }
    _ -> None
  }
  _ -> None
}

fn ppd_sole_var(args_: [Expr]) : Option[LocalId] = match args_ {
  [a] -> match a.kind {
    ELocal(l) -> Some(l)
    _         -> None
  }
  _ -> None
}

fn ppd_drop_stmt(b: LocalId, ln: Int, cl: Int) : Stmt =
  SExprStmt(mk_expr(
    ECall(mk_expr(EMark(MkDrop), ln, cl), [mk_local(b, ln, cl)]),
    ln, cl))

# A self-call anywhere in tail position, however deep the tails nest.
pub fn ppd_has_self_call(e: Expr, self_name: SelfRef) : Bool = match e.kind {
  ECall(f, _) -> is_self_callee(f, self_name)
  EBlock(_, opt_tail) -> match opt_tail {
    None    -> false
    Some(t) -> ppd_has_self_call(t, self_name)
  }
  EIf(_, t, oe) ->
    ppd_has_self_call(t, self_name) or
    (match oe { None -> false  Some(e2) -> ppd_has_self_call(e2, self_name) })
  EMatch(_, arms) -> ppd_arms_self_call(arms, self_name)
  _ -> false
}

#[doc("True when every tail position of `e`, however deep the tails nest, is a self-call.")]
pub fn ppd_all_tails_self_call(e: Expr, self_name: SelfRef) : Bool = match e.kind {
  ECall(f, _) -> is_self_callee(f, self_name)
  EBlock(_, opt_tail) -> match opt_tail {
    None    -> false
    Some(t) -> ppd_all_tails_self_call(t, self_name)
  }
  EIf(_, t, oe) ->
    ppd_all_tails_self_call(t, self_name) and
    (match oe { None -> false  Some(e2) -> ppd_all_tails_self_call(e2, self_name) })
  EMatch(_, arms) -> ppd_arms_all_self_call(arms, self_name)
  _ -> false
}

fn ppd_arms_all_self_call(arms: [Arm], self_name: SelfRef) : Bool = match arms {
  []           -> true
  [a, ...rest] -> match a {
    Arm(_, _, b) -> if ppd_all_tails_self_call(b, self_name) { ppd_arms_all_self_call(rest, self_name) } else { false }
  }
}

fn ppd_arms_self_call(arms: [Arm], self_name: SelfRef) : Bool = match arms {
  []           -> false
  [a, ...rest] -> match a {
    Arm(_, _, b) -> ppd_has_self_call(b, self_name) or ppd_arms_self_call(rest, self_name)
  }
}
