#[doc("""
Autogenerated property-checks for `Functorial` Shape protocols.

For every `impl P for T` whose protocol `P` declares a `Functorial`
theory and is not exempted by an `axiom` clause, this pass synthesises
`check` blocks that exercise the two functor laws on small, enumerated
`T[Int]` witnesses:

  - identity: `map(w, id)` reduces to the same scalar as `w`
  - fusion:   `map(map(w, f), g)` reduces to the same scalar as
              `map(w, g . f)`

Both sides are compared by folding to an `Int` via the impl's own
`foldl`, so no `Eq` instance for the container is required. The checks
run under `kai check` / `kai test` and dispatch `map`/`foldl` to the
impl through ordinary Shape-carrier dispatch.

Witnesses are built from `T`'s own constructors: a nullary constructor
seeds depth 0, and a `Ctor(elem, recursive)`-shaped constructor extends
it, matching cons-shaped containers. An impl whose type yields no
witness gets no check and a build note — never a silent pass.
""")]

import compiler.ast
import compiler.decl_text
import compiler.diag_file
import compiler.lex
import compiler.parse
import compiler.proto_resolve
import compiler.protos
import compiler.symtab
import compiler.util
import compiler.written

# A constructor classified for witness synthesis: its name, the
# positions carrying the element type (the container's own tparam), and
# the positions recursing into the container.
type CtorShape = CtS(String, [Int], [Int])   # name, elem-slots, rec-slots

#[doc("Append autogenerated `Functorial` law-checks to the decl stream. `ps` resolves each impl's protocol from the impl's own module; its table holds the stream's declarations.")]
pub fn gen_law_checks(decls: [Decl], ps: PScope, reg: LawReg, file: String) : GenLaws / Console =
  lc_gen_loop(lc_collect_impls(decls, ps, []), LcSrc(decls, ps_tab(ps)), reg, file, [], [])

#[doc("Result of law-check generation: the synthesised decls plus any build notes.")]
pub type GenLaws = GL([Decl], [String])

pub fn gen_laws_decls(g: GenLaws) : [Decl] = match g { GL(ds, _) -> ds }
pub fn gen_laws_notes(g: GenLaws) : [String] = match g { GL(_, ns) -> ns }

# ── impl gathering ──────────────────────────────────────────────────

# An impl as the law engine reads it: its module, the protocol its head
# denotes from there, the head of its target, and its own position, which
# is what an `axiom` clause exempts.
type ImplRef = { home: Option[String], proto: SymId, target: DeclRef, line: Int, col: Int }

# The decl stream the witnesses are read from, with the table naming it.
type LcSrc = LcSrc([Decl], SymTab)

fn lc_collect_impls(decls: [Decl], ps: PScope, acc: [ImplRef]) : [ImplRef] = match decls {
  [] -> list_reverse(acc)
  [d, ...rest] -> lc_collect_impls(rest, ps, lc_impl_of(d, ps, acc))
}

fn lc_impl_of(d: Decl, ps: PScope, acc: [ImplRef]) : [ImplRef] = match d {
  DImpl(pref, _, target, _, l, c, _, _) -> {
    let home = decl_home_module(d)
    [ImplRef { home: home, proto: ps_ref_proto(ps, pref, home), target: proto_type_ref(target), line: l, col: c }, ...acc]
  }
  _ -> acc
}

# The name a reference spells: what it wrote, or its declaration's.
fn lc_ref_text(tab: SymTab, r: DeclRef) : String = match r {
  DrWritten(_, n) -> written_text(n)
  DrSym(s)        -> written_text(decl_name(tab, s))
}

fn lc_gen_loop(impls: [ImplRef], src: LcSrc, reg: LawReg, file: String,
               acc: [Decl], notes: [String]) : GenLaws / Console = match impls {
  [] -> GL(list_reverse(acc), list_reverse(notes))
  [ir, ...rest] -> {
    let step = lc_gen_one(ir, src, reg, file, acc, notes)
    match step { GL(a2, n2) -> lc_gen_loop(rest, src, reg, file, a2, n2) }
  }
}

fn lc_gen_one(ir: ImplRef, src: LcSrc, reg: LawReg, file: String,
              acc: [Decl], notes: [String]) : GenLaws / Console =
  if not lc_wants_checks(reg, ir) { GL(acc, notes) }
  else {
    match src { LcSrc(_, tab) -> {
      let proto = written_text(decl_name(tab, ir.proto))
      let head = lc_ref_text(tab, ir.target)
      match lc_witnesses(src, ir.target) {
        [] -> GL(acc, [lc_skip_note(proto, head), ...notes])
        ws -> lc_parse_checks(lc_check_src(proto, head, ws), file, acc, notes)
      }
    } }
  }

fn lc_skip_note(proto: String, head: String) : String =
  concat_all(["kaic: no witness for `impl ", proto, " for ", head,
              "` — Functorial law-check skipped"])

fn lc_wants_checks(reg: LawReg, ir: ImplRef) : Bool =
  match law_theory_of(reg, ir.proto) {
    Some(thy) -> thy == "Functorial" and not law_impl_axiomed(reg, ir.home, ir.line, ir.col)
    None      -> false
  }

# ── witness synthesis ───────────────────────────────────────────────

# Enumerate a few `T[Int]` witnesses as source strings from `T`'s
# constructors. Depth 0 is a nullary ctor; each deeper witness wraps the
# previous in a cons-shaped ctor with fresh Int payloads.
fn lc_witnesses(src: LcSrc, target: DeclRef) : [String] = match src {
  LcSrc(decls, tab) -> match lc_first_nullary(lc_ctor_shapes(decls, tab, target)) {
    None    -> []
    Some(b) -> lc_witnesses_from_base(b, lc_first_cons(lc_ctor_shapes(decls, tab, target)))
  }
}

fn lc_witnesses_from_base(base: String, cs_opt: Option[CtorShape]) : [String] = match cs_opt {
  None    -> [base]
  Some(c) -> {
    let w1 = lc_apply_cons(c, 1, base)
    let w2 = lc_apply_cons(c, 2, w1)
    [base, w1, w2]
  }
}

fn lc_ctor_shapes(decls: [Decl], tab: SymTab, target: DeclRef) : [CtorShape] = match decls {
  [] -> []
  [d, ...rest] -> match lc_shapes_of_decl(d, tab, target) {
    []  -> lc_ctor_shapes(rest, tab, target)
    xs  -> xs
  }
}

fn lc_shapes_of_decl(d: Decl, tab: SymTab, target: DeclRef) : [CtorShape] = match d {
  DType(_, ts, tps, body, _, _, _, _) -> {
    let ty = LcTy(tab, ts, written_text(decl_name(tab, ts)))
    if lc_names(ty, target) { lc_shapes_of_body(body, ty, lc_first_tparam(tps)) } else { [] }
  }
  _ -> []
}

# A settled reference names the type by its id; one still written, by the name it wrote.
fn lc_names(ty: LcTy, r: DeclRef) : Bool = match ty {
  LcTy(_, ts, head) -> match r {
    DrSym(s)        -> sym_same(s, ts)
    DrWritten(_, n) -> written_text(n) == head
  }
}

# The type whose constructors are classified: its table, identity and name.
type LcTy = LcTy(SymTab, SymId, String)

fn lc_first_tparam(tps: [String]) : String = match tps {
  [tp, ..._] -> tp
  []         -> ""
}

fn lc_shapes_of_body(body: TypeBody, ty: LcTy, tparam: String) : [CtorShape] = match body {
  TBSum(vs) -> lc_shapes_of_variants(vs, ty, tparam, [])
  _         -> []
}

fn lc_shapes_of_variants(vs: [Variant], ty: LcTy, tparam: String,
                         acc: [CtorShape]) : [CtorShape] = match vs {
  [] -> list_reverse(acc)
  [v, ...rest] ->
    lc_shapes_of_variants(rest, ty, tparam, [lc_shape_of_variant(v, ty, tparam), ...acc])
}

fn lc_shape_of_variant(v: Variant, ty: LcTy, tparam: String) : CtorShape = match v {
  Var(ctor, vargs) -> {
    let tags = map(vargs, (a) => lc_arg_tag(a, ty, tparam))
    CtS(match ty { LcTy(tab, _, _) -> written_text(decl_name(tab, ctor)) },
        lc_positions(tags, 1, 0), lc_positions(tags, 2, 0))
  }
}

# 0 = neither, 1 = element (tparam), 2 = recursive (head).
fn lc_arg_tag(a: TypeExpr, ty: LcTy, tparam: String) : Int =
  if lc_te_is_tparam(a, tparam) { 1 }
  else { if lc_te_is_head(a, ty) { 2 } else { 0 } }

fn lc_positions(tags: [Int], want: Int, i: Int) : [Int] = match tags {
  [] -> []
  [t, ...rest] ->
    if t == want { [i, ...lc_positions(rest, want, i + 1)] }
    else { lc_positions(rest, want, i + 1) }
}

# A type parameter has no declaration: a reference to one is the name it wrote.
fn lc_te_is_tparam(te: TypeExpr, tparam: String) : Bool = match te.tkind {
  TyName(DrWritten(None, n), targs) -> written_text(n) == tparam and lc_te_empty(targs)
  _                                 -> false
}

fn lc_te_empty(xs: [TypeExpr]) : Bool = match xs {
  [] -> true
  _  -> false
}

fn lc_te_is_head(te: TypeExpr, ty: LcTy) : Bool = match te.tkind {
  TyName(r, _) -> lc_names(ty, r)
  TyList(_)    -> match ty { LcTy(_, _, head) -> head == "List" }
  _            -> false
}

fn lc_first_nullary(shapes: [CtorShape]) : Option[String] = match shapes {
  [] -> None
  [cs, ...rest] -> match lc_nullary_name(cs) {
    Some(cn) -> Some(cn)
    None     -> lc_first_nullary(rest)
  }
}

fn lc_nullary_name(cs: CtorShape) : Option[String] = match cs {
  CtS(cn, es, rs) -> if lc_len(es) == 0 and lc_len(rs) == 0 { Some(cn) } else { None }
}

# A usable cons ctor: exactly one element slot and one recursive slot.
fn lc_first_cons(shapes: [CtorShape]) : Option[CtorShape] = match shapes {
  [] -> None
  [cs, ...rest] -> if lc_is_cons(cs) { Some(cs) } else { lc_first_cons(rest) }
}

fn lc_is_cons(cs: CtorShape) : Bool = match cs {
  CtS(_, es, rs) -> lc_len(es) == 1 and lc_len(rs) == 1
}

fn lc_len(xs: [Int]) : Int = match xs {
  [] -> 0
  [_, ...r] -> 1 + lc_len(r)
}

# Build `Ctor(a0, a1)`: the element slot gets the Int literal `elem`, the
# recursive slot gets the inner witness. A cons ctor has exactly two
# slots; their order comes from the classified element position.
fn lc_apply_cons(cs: CtorShape, elem: Int, inner: String) : String = match cs {
  CtS(cn, es, _) -> {
    let e_first = lc_head_int(es) == 0
    let a0 = if e_first { int_to_string(elem) } else { inner }
    let a1 = if e_first { inner } else { int_to_string(elem) }
    concat_all([cn, "(", a0, ", ", a1, ")"])
  }
}

fn lc_head_int(xs: [Int]) : Int = match xs {
  [x, ..._] -> x
  []        -> 0
}

# ── check source emission ───────────────────────────────────────────

fn lc_check_src(proto: String, head: String, witnesses: [String]) : String =
  string_concat_all(lc_check_blocks(proto, head, witnesses, 0))

fn lc_check_blocks(proto: String, head: String, ws: [String], i: Int) : [String] = match ws {
  [] -> []
  [w, ...rest] ->
    [lc_identity_block(proto, head, w, i), lc_fusion_block(proto, head, w, i),
     ...lc_check_blocks(proto, head, rest, i + 1)]
}

fn lc_identity_block(proto: String, head: String, w: String, i: Int) : String =
  concat_all([
    "check \"Functorial.identity ", proto, " for ", head, " #", int_to_string(i), "\" {\n",
    "  let w = ", w, "\n",
    "  foldl(map(w, (a) => a), 0, (acc, x) => acc + x)",
    " == foldl(w, 0, (acc, x) => acc + x)\n",
    "}\n"
  ])

fn lc_fusion_block(proto: String, head: String, w: String, i: Int) : String =
  concat_all([
    "check \"Functorial.fusion ", proto, " for ", head, " #", int_to_string(i), "\" {\n",
    "  let w = ", w, "\n",
    "  let f = (x) => x + 3\n",
    "  let g = (x) => x * 2\n",
    "  foldl(map(map(w, f), g), 0, (acc, x) => acc + x)",
    " == foldl(map(w, (a) => g(f(a))), 0, (acc, x) => acc + x)\n",
    "}\n"
  ])

# ── re-parse into decls ─────────────────────────────────────────────

fn lc_parse_checks(src: String, file: String, acc: [Decl], notes: [String]) : GenLaws / Console {
  # The checks declare nothing, so the home their ids would derive from is immaterial.
  let parsed = parse_program(file, src, tokenize(src), file)
  match parsed.decls {
    Some(ds) -> GL(lc_append(acc, ds), notes)
    None     -> GL(acc, ["kaic: internal — generated Functorial law-check failed to parse", ...notes])
  }
}

fn lc_append(acc: [Decl], ds: [Decl]) : [Decl] = match ds {
  [] -> acc
  [d, ...rest] -> lc_append([d, ...acc], rest)
}
