#[doc("Constructors, accessors and traversals over the syntax tree: node builders, field-init encodings and the surface-form children and rebuild helpers.")]

import compiler.written
import compiler.real_lit
import compiler.escapes
import compiler.ast
import compiler.ast_ids

#[doc("The core type `c` applied to `args`.")]
pub(pkg) fn core_ty_con(c: CoreTy, args: [Ty]) : Ty = TyCon(core_ty_sym(c), args)

#[doc("Child types of a type-surface form; order is shared with `tysurface_rebuild`.")]
pub(pkg) fn tysurface_children(ts: TypeSurface) : [TypeExpr] = match ts {
  TsTuple(tys)         -> tys
  TsUnitSpan(_, inner) -> [inner]
}

#[doc("Rebuild a type-surface form from a transformed child list in `tysurface_children` order.")]
pub(pkg) fn tysurface_rebuild(ts: TypeSurface, xs: [TypeExpr]) : TypeSurface = match ts {
  TsTuple(_) -> TsTuple(xs)
  TsUnitSpan(raw, _) -> match xs {
    [inner, ..._] -> TsUnitSpan(raw, inner)
    _             -> panic("tysurface_rebuild: child list does not match the form")
  }
}

#[doc("Child patterns of a pattern-surface form; order is shared with `patsurface_rebuild`.")]
pub(pkg) fn patsurface_children(ps: PatSurface) : [Pattern] = match ps {
  PsTuple(pats)        -> pats
  PsQualified(_, sub)  -> [sub]
  PsAs(_, sub)         -> [sub]
  PsRefine(_, _)       -> []
  PsAnonRest(pats, _)  -> pats
}

#[doc("Rebuild a pattern-surface form from a transformed child list in `patsurface_children` order.")]
pub(pkg) fn patsurface_rebuild(ps: PatSurface, xs: [Pattern]) : PatSurface = match ps {
  PsTuple(_) -> PsTuple(xs)
  PsQualified(q, _) -> match xs {
    [sub, ..._] -> PsQualified(q, sub)
    _           -> panic("patsurface_rebuild: child list does not match the form")
  }
  PsAs(n, _) -> match xs {
    [sub, ..._] -> PsAs(n, sub)
    _           -> panic("patsurface_rebuild: child list does not match the form")
  }
  PsRefine(_, _) -> ps
  PsAnonRest(_, wild) -> PsAnonRest(xs, wild)
}

#[doc("Child expressions of a surface form, left to right; order is shared with `surface_rebuild`.")]
pub(pkg) fn surface_children(sf: SurfaceForm) : [Expr] = match sf {
  SfContract(reqs, enss, body) -> list_append(reqs, list_append(enss, [body]))
  SfEnsure(value, pred)        -> [value, pred]
  SfLamBlock(lam, _)           -> [lam]
  SfTuple(elems)               -> elems
  SfHandleInit(init)           -> [init]
  SfBigIntLit(_)               -> []
  SfMapLit(spread, flat)       -> match spread {
    Some(b) -> [b, ...flat]
    None    -> flat
  }
  SfSetLit(spread, elems)      -> match spread {
    Some(b) -> [b, ...elems]
    None    -> elems
  }
  SfRefMake(e)                 -> [e]
  SfDeref(target)              -> [target]
  SfMultiMatch(scruts, arms)   -> list_append(scruts, mmarms_children(arms))
  SfCaseBlock(arms)            -> mmarms_children(arms)
  SfFieldPun(value)            -> [value]
  SfSteppedRange(first, second, last) -> [first, second, last]
  SfEndlessRange(first, second) -> match second {
    Some(s) -> [first, s]
    None    -> [first]
  }
  SfLazy(bracket)              -> [bracket]
  SfInterp(_, _, _, holes)     -> holes
}

fn mmarms_children(arms: [MMArm]) : [Expr] = match arms {
  [] -> []
  [MMArm(_, guard, body), ...rest] -> match guard {
    Some(g) -> [g, body, ...mmarms_children(rest)]
    None    -> [body, ...mmarms_children(rest)]
  }
}

# Re-thread a flat child stream back through the arm list, consuming
# one expr per present guard and one per body.
fn mmarms_rebuild(arms: [MMArm], xs: [Expr]) : [MMArm] = match arms {
  [] -> []
  [MMArm(pats, guard, _), ...rest] -> match guard {
    Some(_) -> match xs {
      [g, b, ...more] -> [MMArm(pats, Some(g), b), ...mmarms_rebuild(rest, more)]
      _ -> panic("surface_rebuild: child list does not match the form")
    }
    None -> match xs {
      [b, ...more] -> [MMArm(pats, None, b), ...mmarms_rebuild(rest, more)]
      _ -> panic("surface_rebuild: child list does not match the form")
    }
  }
}

fn mmarm_map(a: MMArm, f: (Expr) -> Expr) : MMArm = match a {
  MMArm(pats, guard, body) -> MMArm(pats, sf_opt_map(guard, f), f(body))
}

#[doc("Rebuild a surface form from a transformed child list in `surface_children` order.")]
pub(pkg) fn surface_rebuild(sf: SurfaceForm, xs: [Expr]) : SurfaceForm = match sf {
  SfContract(reqs, enss, _) -> {
    let nr = list_length(reqs)
    let ne = list_length(enss)
    SfContract(sf_take(xs, nr), sf_take(sf_drop(xs, nr), ne),
               sf_last(sf_drop(xs, nr + ne)))
  }
  SfEnsure(_, _) -> match xs {
    [v, p, ..._] -> SfEnsure(v, p)
    _            -> panic("surface_rebuild: child list does not match the form")
  }
  SfLamBlock(_, trailing) -> match xs {
    [lam, ..._] -> SfLamBlock(lam, trailing)
    _           -> panic("surface_rebuild: child list does not match the form")
  }
  SfTuple(_) -> SfTuple(xs)
  SfHandleInit(_) -> match xs {
    [init, ..._] -> SfHandleInit(init)
    _            -> panic("surface_rebuild: child list does not match the form")
  }
  SfBigIntLit(_) -> sf
  SfMapLit(spread, _) -> match spread {
    Some(_) -> match xs {
      [b, ...rest] -> SfMapLit(Some(b), rest)
      _            -> panic("surface_rebuild: child list does not match the form")
    }
    None -> SfMapLit(None, xs)
  }
  SfSetLit(spread, _) -> match spread {
    Some(_) -> match xs {
      [b, ...rest] -> SfSetLit(Some(b), rest)
      _            -> panic("surface_rebuild: child list does not match the form")
    }
    None -> SfSetLit(None, xs)
  }
  SfRefMake(_) -> match xs {
    [e, ..._] -> SfRefMake(e)
    _         -> panic("surface_rebuild: child list does not match the form")
  }
  SfDeref(_) -> match xs {
    [target, ..._] -> SfDeref(target)
    _              -> panic("surface_rebuild: child list does not match the form")
  }
  SfMultiMatch(scruts, arms) -> {
    let n = list_length(scruts)
    SfMultiMatch(sf_take(xs, n), mmarms_rebuild(arms, sf_drop(xs, n)))
  }
  SfCaseBlock(arms) -> SfCaseBlock(mmarms_rebuild(arms, xs))
  SfFieldPun(_) -> match xs {
    [value, ..._] -> SfFieldPun(value)
    _             -> panic("surface_rebuild: child list does not match the form")
  }
  SfSteppedRange(_, _, _) -> match xs {
    [first, second, last, ..._] -> SfSteppedRange(first, second, last)
    _                           -> panic("surface_rebuild: child list does not match the form")
  }
  SfEndlessRange(_, _) -> match xs {
    [first]            -> SfEndlessRange(first, None)
    [first, s, ..._]   -> SfEndlessRange(first, Some(s))
    _                  -> panic("surface_rebuild: child list does not match the form")
  }
  SfLazy(_) -> match xs {
    [bracket, ..._] -> SfLazy(bracket)
    _               -> panic("surface_rebuild: child list does not match the form")
  }
  SfInterp(span, is_triple, parts, _) -> SfInterp(span, is_triple, parts, xs)
}

# Pure `f` only (kaic1 cannot compile a row-generic fn); an effectful
# walker recurses via `surface_children` / `surface_rebuild` instead.
#[doc("Apply a pure `f` to every child expression of a surface form.")]
pub(pkg) fn surface_map(sf: SurfaceForm, f: (Expr) -> Expr) : SurfaceForm = match sf {
  SfContract(reqs, enss, body) -> SfContract(map(reqs, f), map(enss, f), f(body))
  SfEnsure(value, pred)        -> SfEnsure(f(value), f(pred))
  SfLamBlock(lam, trailing)    -> SfLamBlock(f(lam), trailing)
  SfTuple(elems)               -> SfTuple(map(elems, f))
  SfHandleInit(init)           -> SfHandleInit(f(init))
  SfBigIntLit(_)               -> sf
  SfMapLit(spread, flat)       -> SfMapLit(sf_opt_map(spread, f), map(flat, f))
  SfSetLit(spread, elems)      -> SfSetLit(sf_opt_map(spread, f), map(elems, f))
  SfRefMake(e)                 -> SfRefMake(f(e))
  SfDeref(target)              -> SfDeref(f(target))
  SfMultiMatch(scruts, arms)   -> SfMultiMatch(map(scruts, f), map(arms, (a) => mmarm_map(a, f)))
  SfCaseBlock(arms)            -> SfCaseBlock(map(arms, (a) => mmarm_map(a, f)))
  SfFieldPun(value)            -> SfFieldPun(f(value))
  SfSteppedRange(first, second, last) -> SfSteppedRange(f(first), f(second), f(last))
  SfEndlessRange(first, second) -> SfEndlessRange(f(first), sf_opt_map(second, f))
  SfLazy(bracket)              -> SfLazy(f(bracket))
  SfInterp(span, is_triple, parts, holes) -> SfInterp(span, is_triple, parts, map(holes, f))
}

fn sf_opt_map(o: Option[Expr], f: (Expr) -> Expr) : Option[Expr] = match o {
  None -> None
  Some(e) -> Some(f(e))
}

fn sf_take(xs: [Expr], n: Int) : [Expr] =
  if n <= 0 { [] } else { match xs {
    [] -> []
    [x, ...rest] -> [x, ...sf_take(rest, n - 1)]
  } }

fn sf_drop(xs: [Expr], n: Int) : [Expr] =
  if n <= 0 { xs } else { match xs {
    [] -> []
    [_, ...rest] -> sf_drop(rest, n - 1)
  } }

fn sf_last(xs: [Expr]) : Expr = match xs {
  [x] -> x
  [_, ...rest] -> sf_last(rest)
  [] -> panic("surface_rebuild: child list does not match the form")
}

#[doc("The effect declaration a row label names, `sym_none()` while it is still written text.")]
pub(pkg) fn rl_sym(l: RowLabel) : SymId = match l { RL(r, _) -> ref_sym(r) }

# ---- small constructors ----
pub(pkg) fn mk_expr(k: ExprKind, line: Int, col: Int) : Expr =
  Expr { kind: k, line: line, col: col, ty: None, mode: MUnknown , site: 0 }

#[doc("The binders of an eta-expansion at a position: one fresh parameter per argument, named by that position.")]
pub(pkg) fn eta_binders(line: Int, col: Int, n: Int) : [Binder] =
  if n <= 0 { [] }
  else { [...eta_binders(line, col, n - 1),
          binder_minted(string_concat_all(["__eta_", int_to_string(line), "_", int_to_string(col), "_", int_to_string(n - 1)]))] }

#[doc("The lambda over `bs` that applies `callee` to them.")]
pub(pkg) fn mk_eta_lambda(callee: Expr, bs: [Binder], line: Int, col: Int) : Expr = {
  let params = map(bs, (b) => Param { binder: b, ptype: None, pline: line, pcol: col, pborrow: false })
  mk_expr(ELambda(params, mk_expr(ECall(callee, map(bs, (b) => mk_local(b.id, line, col))), line, col)), line, col)
}

#[doc("""
A reference to `name` the compiler synthesised, at the given position.

Every reference a pass mints goes through here rather than writing
`EVar` itself, so what a synthesised reference *is* stays one decision
in one place. A name minted below the resolver reaches no declaration
the resolver settled — the pass names a runtime primitive, a temporary
it just bound, or a specialisation it just created — so it carries no
id; the passes that mint a reference to something already resolved
build an `ESym` instead.
""")]
pub(pkg) fn mk_name(name: String, line: Int, col: Int) : Expr =
  mk_expr(EName(written(name)), line, col)

#[doc("A read of the local binder `l`.")]
pub(pkg) fn mk_local(l: LocalId, line: Int, col: Int) : Expr = mk_expr(ELocal(l), line, col)

#[doc("A reference to the declaration `s` itself.")]
pub(pkg) fn mk_sym(s: SymId, line: Int, col: Int) : Expr = mk_expr(ESym(s, spec_none()), line, col)

#[doc("The expressions a statement evaluates, in order.")]
pub(pkg) fn stmt_exprs(s: Stmt) : [Expr] = match s {
  SAssert(c, opt_m)           -> match opt_m { Some(m) -> [c, m]  None -> [c] }
  SExprStmt(e)                -> [e]
  SIndexAssign(b, i, v, _, _) -> [b, i, v]
  SAssign(b, v, _, _)         -> [b, v]
  SLet(_, _, rhs)             -> [rhs]
  SVar(_, _, rhs, _, _)       -> [rhs]
  SUse(_, _, _)               -> []
}

#[doc("An integer literal read from source, keeping its span so the base and digit separators survive a re-print.")]
pub(pkg) fn mk_int_lit(v: Int, span: String) : ExprKind = EInt(v, span)

#[doc("The value of an integer literal, negated or not; `None` for any other expression.")]
pub(pkg) fn try_int_literal(e: Expr) : Option[Int] = match e.kind {
  EInt(n, _) -> Some(n)
  EUnop(UoNeg, inner) -> match inner.kind {
    EInt(n, _) -> Some(0 - n)
    _          -> None
  }
  _ -> None
}

#[doc("A compiler-synthesised integer literal, with no source spelling to preserve.")]
pub(pkg) fn mk_int_synth(v: Int) : ExprKind = EInt(v, "")

#[doc("True when `ps` are the parameters of a point-free section, a lambda the author wrote with a leading dot.")]
pub(pkg) fn params_point_free(ps: [Param]) : Bool = match ps {
  [p] -> local_eq(p.binder.id, point_free_binder().id)
  _   -> false
}

#[doc("True when `e` is a `.` written alone as a call argument: the section `(x) => x`.")]
pub(pkg) fn is_dot_identity(e: Expr) : Bool = match e.kind {
  ELambda(ps, body) -> params_point_free(ps) and match body.kind {
    ELocal(l) -> local_eq(l, point_free_binder().id)
    _         -> false
  }
  _ -> false
}

#[doc("True when `ps` are the parameter of the lambda a `lhs |> f(_)` passes its left side through.")]
pub(pkg) fn params_pipe_apply(ps: [Param]) : Bool = match ps {
  [p] -> local_eq(p.binder.id, pipe_apply_binder().id)
  _   -> false
}

# Return a copy of `e` with its inferred type set. Used by `synth` to
# hand back a typed expression tree alongside its Ty. Downstream passes
# (emitter today ignores it; M3/M4 will consume) can traverse the tree
# and read `.ty` at each node without re-running inference.
pub(pkg) fn with_ty(e: Expr, t: Ty) : Expr =
  Expr { kind: e.kind, line: e.line, col: e.col, ty: Some(t), mode: e.mode,  site: e.site }

pub(pkg) fn mk_pat(k: PatKind, line: Int, col: Int) : Pattern = Pattern { pkind: k, line: line, col: col }

pub(pkg) fn mk_ty(k: TyKind, line: Int, col: Int) : TypeExpr = TypeExpr { tkind: k, line: line, col: col }

#[doc("The init of a positional field: no name, its value called by `MkFieldPos`.")]
pub(pkg) fn mk_field_pos(value: Expr) : FieldInit = FI("", field_marked(MkFieldPos, value))

#[doc("The init a `...src` spread occupies: no name, its source called by `MkFieldSpread`.")]
pub(pkg) fn mk_field_spread(src: Expr) : FieldInit = FI("", field_marked(MkFieldSpread, src))

fn field_marked(m: Mark, value: Expr) : Expr =
  mk_expr(ECall(mk_expr(EMark(m), value.line, value.col), [value]), value.line, value.col)

#[doc("The value of a positional field, or None when the field is of any other kind.")]
pub(pkg) fn field_pos_value(value: Expr) : Option[Expr] = match value.kind {
  ECall(f, [inner]) -> match f.kind {
    EMark(MkFieldPos) -> Some(inner)
    _ -> None
  }
  _ -> None
}

#[doc("The source a spread field copies from, or None when the field is of any other kind.")]
pub(pkg) fn field_spread_value(value: Expr) : Option[Expr] = match value.kind {
  ECall(f, [inner]) -> match f.kind {
    EMark(MkFieldSpread) -> Some(inner)
    _ -> None
  }
  _ -> None
}

#[doc("True when a field's value is a positional one.")]
pub(pkg) fn field_is_pos(value: Expr) : Bool = match field_pos_value(value) {
  Some(_) -> true
  None    -> false
}

#[doc("True when a field's value is the source of a spread.")]
pub(pkg) fn field_is_spread(value: Expr) : Bool = match field_spread_value(value) {
  Some(_) -> true
  None    -> false
}

#[doc("The expression the author wrote in a field's slot: a positional value or a spread source from under its mark, any other value as it is.")]
pub(pkg) fn field_written(value: Expr) : Expr = match field_spread_value(value) {
  Some(src) -> src
  None      -> match field_pos_value(value) {
    Some(v) -> v
    None    -> value
  }
}

#[doc("The init of a punned field `{ x }`: the field's own name, its value wrapped in `SfFieldPun` so the writer can restore the shorthand.")]
pub(pkg) fn mk_field_pun(name: String, value: Expr) : FieldInit =
  FI(name, mk_expr(ESurface(SfFieldPun(value)), value.line, value.col))

#[doc("The reference a punned field's value wraps, or None when the field was written out as `name: value`.")]
pub(pkg) fn field_pun_value(value: Expr) : Option[Expr] = match value.kind {
  ESurface(sf) -> match sf {
    SfFieldPun(inner) -> Some(inner)
    _ -> None
  }
  _ -> None
}

# ====================================================================
# Record table (issue #648) — moved from main.kai under issue #677
# phase 1m (desugar extraction). RecInfo is a shared AST-adjacent
# type: the positional-record desugar (compiler.desugar) consumes
# [RecInfo] in its pass signatures, and the typer threads the same
# table through inference. ast.kai is the only home both import
# without a lateral arrow.
# ====================================================================
