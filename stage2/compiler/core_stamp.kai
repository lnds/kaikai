#[doc("""
The line below which a core builtin is always its row.

The resolver writes the builtins a source file names as their rows, and
a pass that synthesises a call to one mints the row itself. A name that
still reaches here written, and spells a core builtin, is given the
builtin's row: a local is never a written name, so no binder can be
taken for one. This module goes when nothing above it leaves such a
name.
""")]

import compiler.ast
import compiler.ast_map
import compiler.decl_map
import compiler.expr_exists
import compiler.symtab
import compiler.core_syms
import compiler.written

#[doc("`ds` with every written name that spells a core builtin replaced by the builtin's row.")]
pub fn core_stamp_decls(tab: SymTab, ds: [Decl]) : [Decl] = map(ds, (d) => decl_map_bodies(d, (b) => cst_body(tab, b)))

# Most bodies leave no builtin written, and are returned as they are.
fn cst_body(tab: SymTab, body: Expr) : Expr =
  if xp_exists(body, false, (x) => cst_is_written_builtin(tab, x)) { cst_expr(tab, body) } else { body }

fn cst_is_written_builtin(tab: SymTab, e: Expr) : Bool = match e.kind {
  EName(n) -> sym_is_builtin(tab, builtin_sym(written_text(n)))
  _        -> false
}

fn cst_expr(tab: SymTab, e: Expr) : Expr =
  Expr { kind: cst_kind(tab, e.kind), line: e.line, col: e.col, ty: e.ty, mode: e.mode, site: e.site }

fn cst_kind(tab: SymTab, k: ExprKind) : ExprKind = match k {
  EName(n) -> {
    let s = builtin_sym(written_text(n))
    if sym_is_builtin(tab, s) { ESym(s, spec_none()) } else { k }
  }
  _ -> prc_map_expr_kind(k, (sub) => cst_expr(tab, sub))
}
