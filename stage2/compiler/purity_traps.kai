#[doc("""
Which functions cannot trap, over the post-perceus `[Decl]`.

A trap unwinds through every frame between it and the fiber pad, so a
function that can trap must not be `nounwind`. One that provably cannot
keeps the attribute: its body only reads values, builds them and does
scalar arithmetic that is not a division, and calls only functions that
cannot trap either. Anything else (a runtime builtin, an effect op, a
closure call, an index, an `assert`) is taken to trap.

The callee constraint is solved as a greatest fixed point over declaration
identities: every candidate whose own body is clean starts out trap-free
and is demoted while a callee is not, so a recursive group that never
traps keeps the attribute. A callee or a declaration without a resolved
identity is taken to trap, so a homonym never inherits the verdict.
""")]

import compiler.ast
import compiler.marks
import compiler.sym_read
import compiler.util
import compiler.expr_positions

type TCand = TCand(FnId, String, Option[String], Option[[FnId]])

#[doc("The emitted symbols (`<mo>__<name>`, or the bare name at the root) of the functions that cannot trap.")]
pub fn trapfree_syms(decls: [Decl]) : [String] = {
  let cands = tf_cands(decls, [])
  tf_syms(cands, tf_fix(cands, tf_seed(cands)))
}

fn tf_cands(decls: [Decl], acc: [TCand]) : [TCand] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DFn(_, name, _, _, _, _, body, _, _, mo, id) ->
      if sym_raw(fnid_sym(id)) < 0 { tf_cands(rest, acc) }
      else { tf_cands(rest, [TCand(id, name, mo, tf_scan(body, Some([]))), ...acc]) }
    _ -> tf_cands(rest, acc)
  }
}

fn tf_seed(cands: [TCand]) : [FnId] = match cands {
  [] -> []
  [TCand(id, _, _, local), ...rest] -> match local { Some(_) -> [id, ...tf_seed(rest)] None -> tf_seed(rest) }
}

fn tf_fix(cands: [TCand], free: [FnId]) : [FnId] = {
  let next = tf_keep(cands, free)
  if list_length(next) == list_length(free) { free } else { tf_fix(cands, next) }
}

fn tf_keep(cands: [TCand], free: [FnId]) : [FnId] = match cands {
  [] -> []
  [TCand(id, _, _, local), ...rest] ->
    if tf_has(free, id) and tf_callees_free(local, free) { [id, ...tf_keep(rest, free)] }
    else { tf_keep(rest, free) }
}

fn tf_callees_free(local: Option[[FnId]], free: [FnId]) : Bool = match local {
  None -> false
  Some(cs) -> all(cs, (c) => tf_has(free, c))
}

fn tf_has(ids: [FnId], id: FnId) : Bool = match ids {
  [] -> false
  [i, ...rest] -> fnid_eq(i, id) or tf_has(rest, id)
}

fn tf_syms(cands: [TCand], free: [FnId]) : [String] = match cands {
  [] -> []
  [TCand(id, n, mo, _), ...rest] -> if tf_has(free, id) { [tf_sym(n, mo), ...tf_syms(rest, free)] } else { tf_syms(rest, free) }
}

fn tf_sym(n: String, mo: Option[String]) : String = match mo {
  None -> n
  Some(m) -> concat_all([m, "__", n])
}

# `Some(callees)` while nothing in `e` traps but its calls of `callees`;
# `None` once something does.
fn tf_scan(e: Expr, acc: Option[[FnId]]) : Option[[FnId]] = match acc {
  None -> None
  Some(cs) -> match tf_node(e, cs) {
    None -> None
    Some(cs1) -> tf_children(xp_positions(e), Some(cs1))
  }
}

fn tf_children(ps: [XPos], acc: Option[[FnId]]) : Option[[FnId]] = match ps {
  [] -> acc
  [XP(r, c), ...rest] -> match r {
    XLam -> tf_children(rest, acc)
    _    -> tf_children(rest, tf_scan(c, acc))
  }
}

fn tf_node(e: Expr, cs: [FnId]) : Option[[FnId]] = match sym_read_kind(e.kind) {
  EBinop(op, _, _) -> if op == "/" or op == "%" { None } else { Some(cs) }
  ECall(f, _) -> tf_head(f, cs)
  EBlock(ss, _) -> if all(ss, (s) => tf_stmt_clean(s)) { Some(cs) } else { None }
  EIndex(_, _) -> None
  EBang(_) -> None
  EHandle(_, _, _, _, _, _, _, _) -> None
  EModCall(_, n) -> if tf_is_ctor(n) { Some(cs) } else { None }
  _ -> Some(cs)
}

fn tf_stmt_clean(s: Stmt) : Bool = match s {
  SLet(_, _, _) -> true
  SExprStmt(_) -> true
  SUse(_, _, _) -> true
  _ -> false
}

# A call of a resolved fn adds its identity; a spelled-only callee is not
# known, so it traps.
fn tf_head(f: Expr, cs: [FnId]) : Option[[FnId]] = match f.kind {
  ESym(s, inst, n) -> if tf_is_ctor(n) { Some(cs) } else if sym_raw(s) < 0 { None } else { Some([FnId(s, inst), ...cs]) }
  EVar(n) -> if tf_is_ctor(n) { Some(cs) } else { None }
  EMark(m) -> if tf_mark_clean(m) { Some(cs) } else { None }
  EModCall(_, n) -> if tf_is_ctor(n) { Some(cs) } else { None }
  _ -> None
}

# A dup or a reuse runs nothing that traps; a self-tail step runs this fn again.
fn tf_mark_clean(m: Mark) : Bool = match m {
  MkDup          -> true
  MkTcrecStep(_) -> true
  _              -> mark_is_reuse(m)
}

fn tf_is_ctor(n: String) : Bool = match char_at(n, 0) {
  Some(c) -> c >= 'A' and c <= 'Z'
  None -> false
}
