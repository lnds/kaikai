#[doc("The formatter's layout: line anchoring, width decisions and the measure of what fits.")]

# compiler/fmt_layout.kai — the width model behind `kai fmt`.
#
# The writer emits text directly, so a layout is decided before its
# text exists: each decision renders the candidate into a probe state,
# measures it, and keeps the render when it fits. Three shapes cover
# every construct the walker breaks — a body hanging off `=` / `->`, a
# delimited sequence, and an operator chain. Each takes the author's
# own line breaks as a signal: a break the source already has is kept,
# a line that fits is joined, a line that does not is broken at the
# shape's own points. Nothing here walks the AST: the walker passes
# emitters, and the only source fact read here is where a token sits.

import compiler.util
import compiler.lex
import compiler.ast
import compiler.fmt_writer
import compiler.fmt_shape

# ---- source lines -----------------------------------------------------

# An opening parenthesis is skipped: the writer adds and drops
# parentheses by precedence, so an expression written `(not x) and y`
# and printed `not x and y` must read as the same author break.
#[doc("Column of the first token on each source line, parentheses aside, indexed by line (0 for a line without tokens).")]
pub(pkg) fn fmt_line_starts(toks: [Token]) : Array[Int] =
  fmt_starts_fill(toks, array_make(fmt_last_line(toks, 0) + 2, 0))

fn fmt_last_line(toks: [Token], acc: Int) : Int = match toks {
  [] -> acc
  [t, ...rest] -> fmt_last_line(rest, if t.line > acc { t.line } else { acc })
}

fn fmt_starts_fill(toks: [Token], a: Array[Int]) : Array[Int] / Mutable = match toks {
  [] -> a
  [t, ...rest] ->
    if fmt_tok_is_layout(t.kind) or (array_get(a, t.line) > 0) { fmt_starts_fill(rest, a) }
    else { fmt_starts_fill(rest, array_set(a, t.line, t.col)) }
}

fn fmt_tok_is_layout(k: TokKind) : Bool = match k {
  TkNewline -> true
  TkEof -> true
  TkLparen -> true
  _ -> false
}

# ---- blank lines ------------------------------------------------------

# A source line is blank when no token occupies it. `TkNewline` is the
# line's own terminator and never counts. A token that spans lines (a
# triple-quoted string) is only known to end where the next token
# begins, so each token marks every line from its own up to the next
# token's: a line inside such a literal is occupied, not blank.
#[doc("True for each source line the author left empty, indexed by line.")]
pub(pkg) fn fmt_blank_lines(toks: [Token]) : Array[Int] =
  fmt_blank_fill(toks, array_make(fmt_last_line(toks, 0) + 2, 1))

fn fmt_blank_fill(toks: [Token], a: Array[Int]) : Array[Int] / Mutable = match toks {
  [] -> a
  [t, ...rest] -> match t.kind {
    TkNewline -> fmt_blank_fill(rest, a)
    TkEof -> fmt_blank_fill(rest, a)
    _ -> fmt_blank_fill(rest, fmt_blank_span(a, t.line, fmt_tok_last_line(t, rest)))
  }
}

# The last line this token occupies. A multi-line literal holds its own
# newlines inside its span, so the lexer emits no `TkNewline` for them:
# the next token of any kind — the newline closing the literal's last
# line included — is what bounds it.
fn fmt_tok_last_line(t: Token, rest: [Token]) : Int = match rest {
  [] -> t.line
  [n, ..._more] -> if n.line > t.line { n.line } else { t.line }
}

fn fmt_blank_span(a: Array[Int], line: Int, last: Int) : Array[Int] / Mutable =
  if line > last { a }
  else if line >= array_length(a) { a }
  else { fmt_blank_span(array_set(a, line, 0), line + 1, last) }

#[doc("True when the author left source line `line` empty.")]
pub(pkg) fn fmt_line_is_blank(s: FmtSt, line: Int) : Bool {
  let inside = (line > 0) and (line < array_length(s.blanks))
  inside and (array_get(s.blanks, line) == 1)
}

# ---- block closes -----------------------------------------------------

# For each source line, the line of the brace closing the innermost
# block that both opens at or before it and closes after it — the
# block a comment written on that line would sit inside. One linear
# pass with a brace stack; a block written entirely on one line spans
# no interior line and so claims none.
#[doc("Line of the brace closing the innermost block whose interior covers each source line, indexed by line (0 when no block does).")]
pub(pkg) fn fmt_close_lines(toks: [Token]) : Array[Int] =
  fmt_close_fill(toks, [], array_make(fmt_last_line(toks, 0) + 2, 0))

fn fmt_close_fill(toks: [Token], open: [Int], a: Array[Int]) : Array[Int] / Mutable = match toks {
  [] -> a
  [t, ...rest] -> match t.kind {
    TkLbrace -> fmt_close_fill(rest, [t.line, ...open], a)
    TkRbrace -> match open {
      [] -> fmt_close_fill(rest, open, a)
      [from, ...outer] -> fmt_close_fill(rest, outer, fmt_close_span(a, from + 1, t.line))
    }
    _ -> fmt_close_fill(rest, open, a)
  }
}

# The interior lines of a block run from just below its `{` to just
# above its `}`; a one-line block has none. Only a line with no nearer
# close recorded is written: a linear scan closes inner blocks first,
# so first-writer-wins keeps the innermost.
fn fmt_close_span(a: Array[Int], from: Int, close: Int) : Array[Int] / Mutable =
  if from >= close { a }
  else if from >= array_length(a) { a }
  else { fmt_close_span(fmt_close_keep(a, from, close), from + 1, close) }

fn fmt_close_keep(a: Array[Int], line: Int, close: Int) : Array[Int] / Mutable =
  if array_get(a, line) > 0 { a } else { array_set(a, line, close) }

#[doc("Line of the brace closing the innermost block whose interior covers source line `line`, or 0 when none does.")]
pub(pkg) fn fmt_close_line_at(s: FmtSt, line: Int) : Int {
  let inside = (line > 0) and (line < array_length(s.closes))
  if inside { array_get(s.closes, line) } else { 0 }
}

#[doc("True when the token at (line, col) opens its source line: the author broke the line right before it.")]
pub(pkg) fn fmt_starts_line(s: FmtSt, line: Int, col: Int) : Bool =
  ((line > 0) and (line < array_length(s.starts))) and (array_get(s.starts, line) == col)

fn fmt_expr_starts_line(s: FmtSt, e: Expr) : Bool {
  let head = fmt_leftmost(e)
  fmt_starts_line(s, head.line, head.col)
}

#[doc("True when the type's first token opens its source line.")]
pub(pkg) fn fmt_type_starts_line(s: FmtSt, t: TypeExpr) : Bool = fmt_starts_line(s, t.line, t.col)

#[doc("True when the author broke an operator chain: some operator, or the operand after it, opens a source line.")]
pub(pkg) fn fmt_chain_broken(s: FmtSt, links: [ChainOp[o]]) : Bool = match links {
  [] -> false
  [ChainOp(_, line, col, rhs), ...rest] ->
    (fmt_starts_line(s, line, col) or fmt_expr_starts_line(s, rhs)) or fmt_chain_broken(s, rest)
}

# ---- probes -----------------------------------------------------------

# A probe opened inside a dead one would restart its counters and
# re-render the whole subtree at every nesting level; nothing it could
# answer changes the enclosing verdict, so it does not run.
#[doc("Render `emit` from `s` when the result stays on the current line inside the width; None otherwise.")]
pub(pkg) fn fmt_try_flat(s: FmtSt, emit: (FmtSt) -> FmtSt) : Option[FmtSt] =
  if fmt_probe_dead(s) { None }
  else {
    let r = emit(fmt_probe_begin(s))
    if (r.row == 0) and (r.col <= r.width) { Some(fmt_probe_end(r, s)) } else { None }
  }

fn fmt_head_fits(s: FmtSt, emit: (FmtSt) -> FmtSt) : Bool =
  if fmt_probe_dead(s) { false }
  else {
    let r = emit(fmt_probe_begin(s))
    (if r.row == 0 { r.col } else { r.head_col }) <= r.width
  }

# `flat` then `tail`, when `flat` stays on the line and the first line
# of `tail` still fits after it; `otherwise` when either fails. The
# tail may break inside itself (a trailing block's body), which is why
# it is measured by its head alone.
fn fmt_flat_then(s: FmtSt, flat: (FmtSt) -> FmtSt, tail: (FmtSt) -> FmtSt, otherwise: (FmtSt) -> FmtSt) : FmtSt =
  match fmt_try_flat(s, flat) {
    Some(r) -> if fmt_head_fits(r, tail) { tail(r) } else { otherwise(s) }
    None -> otherwise(s)
  }

# ---- hanging body -----------------------------------------------------

# Preference order: the head line when the body fits there; its own
# line when it fits there whole; the head line when the body must
# break anyway and its first line still fits; its own line otherwise.
#[doc("A body after `=` / `->`: on the head line when it fits, on its own indented line otherwise; a break the author wrote (`broken`) is kept.")]
pub(pkg) fn fmt_hang(s: FmtSt, broken: Bool, body: (FmtSt) -> FmtSt) : FmtSt =
  if broken { fmt_hang_below(s, body) }
  else {
    match fmt_try_flat(s, (t) => body(fmt_emit(t, " "))) {
      Some(r) -> r
      None -> match fmt_try_flat(fmt_indent_in(fmt_newline(s)), body) {
        Some(r) -> fmt_indent_out(r)
        None ->
          if fmt_head_fits(s, (t) => body(fmt_emit(t, " "))) { body(fmt_emit(s, " ")) }
          else { fmt_hang_below(s, body) }
      }
    }
  }

fn fmt_hang_below(s: FmtSt, body: (FmtSt) -> FmtSt) : FmtSt =
  fmt_indent_out(body(fmt_indent_in(fmt_newline(s))))

# ---- delimited sequences ----------------------------------------------

#[doc("One element of a delimited sequence: the source line it opens on and its emitter.")]
pub(pkg) type SeqItem = SeqItem(Int, (FmtSt) -> FmtSt)

#[doc("How a sequence prints: its delimiters, whether the flat form pads inside them (`{ a }` vs `(a)`), whether broken items pack into rows (`fill`), and whether a block-like last item may hug the opener.")]
pub(pkg) type SeqStyle = { open: String, close: String, pad: Bool, fill: Bool, hug: Bool }

#[doc("A delimited sequence: flat when it fits and the author kept it on one line, else one item per line (rows when `fill`) with the closer on its own line; `tail` is what follows the closer on the same line and counts toward the fit.")]
pub(pkg) fn fmt_seq(s: FmtSt, st: SeqStyle, open_line: Int, items: [SeqItem], tail: (FmtSt) -> FmtSt) : FmtSt =
  match items {
    [] -> tail(fmt_emit(fmt_emit(s, st.open), st.close))
    _ ->
      if seq_author_broke(open_line, items) { seq_expanded(s, st, items, tail) }
      else {
        fmt_flat_then(s, (t) => seq_flat(t, st, items), tail,
                      (t) => if st.hug { seq_hugged(t, st, items, tail) } else { seq_expanded(t, st, items, tail) })
      }
  }

# The author broke the sequence when any item opens below everything
# before it. A synthetic item can carry an earlier position (the pipe
# placeholder's binder sits at its pipe's left operand), so the bar
# only ever rises.
fn seq_author_broke(prev_line: Int, items: [SeqItem]) : Bool = match items {
  [] -> false
  [SeqItem(line, _), ...rest] ->
    (line > prev_line) or seq_author_broke(if line > prev_line { line } else { prev_line }, rest)
}

fn seq_flat(s: FmtSt, st: SeqStyle, items: [SeqItem]) : FmtSt {
  let inner = if st.pad { " " } else { "" }
  let s1 = fmt_emit(fmt_emit(s, st.open), inner)
  let s2 = seq_flat_items(s1, items)
  fmt_emit(fmt_emit(s2, inner), st.close)
}

fn seq_flat_items(s: FmtSt, items: [SeqItem]) : FmtSt = match items {
  [] -> s
  [SeqItem(_, emit)] -> emit(s)
  [SeqItem(_, emit), ...rest] -> seq_flat_items(fmt_emit(emit(s), ", "), rest)
}

# `open a, b, LAST close`: the leading items flat on the opener's line,
# the last item breaking inside its own delimiters. Taken only when the
# leading items fit flat and the hugged first line fits.
fn seq_hugged(s: FmtSt, st: SeqStyle, items: [SeqItem], tail: (FmtSt) -> FmtSt) : FmtSt {
  let lead = (t) => seq_flat_items(fmt_emit(t, st.open), seq_init(items))
  let last = seq_last(items)
  let sep = match items { [_] -> ""  _ -> ", " }
  let hug = (t) => tail(fmt_emit(last(fmt_emit(lead(t), sep)), st.close))
  match fmt_try_flat(s, lead) {
    None -> seq_expanded(s, st, items, tail)
    Some(_) -> if fmt_head_fits(s, hug) { hug(s) } else { seq_expanded(s, st, items, tail) }
  }
}

fn seq_init(items: [SeqItem]) : [SeqItem] = match items {
  [] -> []
  [_] -> []
  [it, ...rest] -> [it, ...seq_init(rest)]
}

fn seq_last(items: [SeqItem]) : (FmtSt) -> FmtSt = match items {
  [] -> (t) => t
  [SeqItem(_, emit)] -> emit
  [_, ...rest] -> seq_last(rest)
}

fn seq_expanded(s: FmtSt, st: SeqStyle, items: [SeqItem], tail: (FmtSt) -> FmtSt) : FmtSt {
  let s1 = fmt_indent_in(fmt_newline(fmt_emit(s, st.open)))
  let s2 = if st.fill { seq_rows(s1, items, 0) } else { seq_lines(s1, items) }
  tail(fmt_emit(fmt_newline(fmt_indent_out(s2)), st.close))
}

# One item per line. A trailing comment stays with the item it ends,
# on whichever of the item's lines it sits: anything pending below the
# item's first line and above the next item's is the item's own. The
# last item only claims its first line — its closer's line is unknown,
# so a comment further down waits for the closer.
fn seq_lines(s: FmtSt, items: [SeqItem]) : FmtSt = match items {
  [] -> s
  [SeqItem(line, emit)] -> fmt_drain_trailing_on_line(emit(s), line)
  [SeqItem(line, emit), ...rest] ->
    seq_lines(fmt_newline(seq_item_trailing(fmt_emit(fmt_reserved(s, 1, emit), ","), line, rest)), rest)
}

fn seq_item_trailing(s: FmtSt, line: Int, rest: [SeqItem]) : FmtSt = match rest {
  [] -> fmt_drain_trailing_on_line(s, line)
  [SeqItem(next_line, _), ..._more] -> fmt_drain_trailing_between(s, line, next_line)
}

# Items packed into rows: a row breaks where the author broke it or
# where the next item would not fit. `high` is the highest line seen,
# the same rising bar `seq_author_broke` uses.
fn seq_rows(s: FmtSt, items: [SeqItem], high: Int) : FmtSt = match items {
  [] -> s
  [SeqItem(line, emit)] -> fmt_drain_trailing_on_line(emit(s), line)
  [SeqItem(line, emit), ...rest] -> {
    let s1 = fmt_emit(fmt_reserved(s, 1, emit), ",")
    let high1 = if line > high { line } else { high }
    seq_rows(seq_row_gap(s1, line, high1, rest), rest, high1)
  }
}

# The gap after a comma: a space when the next item (with its own
# comma) fits on the row and the author kept it there, else a newline.
# A trailing comment is drained only where the row ends: inline it
# would swallow the rest of the row.
fn seq_row_gap(s: FmtSt, line: Int, high: Int, rest: [SeqItem]) : FmtSt = match rest {
  [] -> s
  [SeqItem(next_line, emit), ...more] ->
    if next_line > high { fmt_newline(fmt_drain_trailing_between(s, line, next_line)) }
    else {
      let after = match more { [] -> "" _ -> "," }
      match fmt_try_flat(s, (t) => fmt_emit(emit(fmt_emit(t, " ")), after)) {
        Some(_) -> fmt_emit(s, " ")
        None -> fmt_newline(s)
      }
    }
}

# ---- operator chains --------------------------------------------------

#[doc("One link of an operator chain: the operator's text, the source line its operand opens on, and the operand's emitter.")]
pub(pkg) type ChainLink = Link(String, Int, (FmtSt) -> FmtSt)

#[doc("An operator chain: flat when it fits and the author kept it so, else one operand per line — operator leading each continuation line (or trailing the previous one when `leading` is false), continuation one level in; `tail` follows the last operand on its line.")]
pub(pkg) fn fmt_chain(s: FmtSt, first: (FmtSt) -> FmtSt, links: [ChainLink], leading: Bool, broken: Bool, tail: (FmtSt) -> FmtSt) : FmtSt =
  if broken { chain_expanded(s, first, links, leading, tail) }
  else { fmt_flat_then(s, (t) => chain_flat(first(t), links), tail, (t) => chain_expanded(t, first, links, leading, tail)) }

fn chain_flat(s: FmtSt, links: [ChainLink]) : FmtSt = match links {
  [] -> s
  [Link(op, _, rhs), ...rest] -> chain_flat(rhs(fmt_emit(s, concat_all([" ", op, " "]))), rest)
}

fn chain_expanded(s: FmtSt, first: (FmtSt) -> FmtSt, links: [ChainLink], leading: Bool, tail: (FmtSt) -> FmtSt) : FmtSt {
  let head = match links {
    [Link(op, _, _), ..._rest] -> if leading { first(s) } else { fmt_reserved(s, string_length(op) + 1, first) }
    [] -> first(s)
  }
  let s1 = fmt_indent_in(head)
  let s2 = chain_lines(s1, links, leading)
  tail(fmt_indent_out(s2))
}

# Comments above an operand come out above its line, before the
# operator that leads it.
fn chain_lines(s: FmtSt, links: [ChainLink], leading: Bool) : FmtSt = match links {
  [] -> s
  [Link(op, line, rhs), ...rest] -> {
    let s1 = if leading { fmt_emit(fmt_drain_before(fmt_newline(s), line), string_concat(op, " ")) }
             else { fmt_drain_before(fmt_newline(fmt_emit(s, string_concat(" ", op))), line) }
    let s2 = match rest {
      [] -> rhs(s1)
      [Link(next_op, _, _), ..._more] ->
        if leading { rhs(s1) } else { fmt_reserved(s1, string_length(next_op) + 1, rhs) }
    }
    chain_lines(s2, rest, leading)
  }
}

#[doc("Source lines of a type declaration's variants or record fields, in declaration order.")]
pub(pkg) type ElemLines = ElL([Int])

#[doc("Line of the `i`-th element, or 0 when unknown.")]
pub(pkg) fn elem_line_at(e: ElemLines, i: Int) : Int = match e {
  ElL(xs) -> elem_line_nth(xs, i)
}

# The 0 sentinel means "unknown": every caller falls back to the
# decl-level behaviour rather than anchoring against a guess.
fn elem_line_nth(xs: [Int], i: Int) : Int = match xs {
  [] -> 0
  [x, ...rest] -> if i <= 0 { x } else { elem_line_nth(rest, i - 1) }
}

#[doc("True when some element opens below every element (and the decl head, `head_line`) before it: the author laid the elements out one per line.")]
pub(pkg) fn elem_lines_broken(el: ElemLines, count: Int, head_line: Int) : Bool = elem_lines_broken_from(el, count, head_line, 0)

fn elem_lines_broken_from(el: ElemLines, count: Int, prev: Int, i: Int) : Bool =
  if i >= count { false }
  else {
    let line = elem_line_at(el, i)
    ((line > 0) and (line > prev)) or elem_lines_broken_from(el, count, if line > prev { line } else { prev }, i + 1)
  }

#[doc("Scan `tokens` for the type declaration opening at `line` and return its element lines.")]
pub(pkg) fn scan_elem_lines(tokens: [Token], line: Int) : ElemLines =
  ElL(anchor_reverse(anchor_from_type(tokens, line), []))

fn anchor_reverse(xs: [Int], acc: [Int]) : [Int] = match xs {
  [] -> acc
  [x, ...rest] -> anchor_reverse(rest, [x, ...acc])
}

fn anchor_from_type(tokens: [Token], line: Int) : [Int] = match tokens {
  [] -> []
  [t, ...rest] ->
    if anchor_is_type(t.kind) and (t.line >= line) {
      anchor_head(rest, 0)
    } else {
      anchor_from_type(rest, line)
    }
}

# Skip the type head (name, `[tparams]`, `<slots>`) up to the `=`,
# then pick the body shape: `{` opens a record, anything else a sum
# or alias. A record's `{` follows the `=`, so the `=` alone cannot
# discriminate — the token after it does.
fn anchor_head(tokens: [Token], depth: Int) : [Int] = match tokens {
  [] -> []
  [t, ...rest] -> {
    let k = t.kind
    if anchor_head_opens(k) {
      anchor_head(rest, depth + 1)
    } else if anchor_head_closes(k) {
      anchor_head(rest, depth - 1)
    } else if depth > 0 {
      anchor_head(rest, depth)
    } else if anchor_is_lbrace(k) {
      anchor_elems(rest, 0, [], true, true)
    } else if anchor_is_eq(k) {
      anchor_body(rest)
    } else if anchor_is_eof(k) {
      []
    } else {
      anchor_head(rest, depth)
    }
  }
}

# Dispatch on the first significant token after the body's `=`.
fn anchor_body(tokens: [Token]) : [Int] = match tokens {
  [] -> []
  [t, ...rest] -> {
    let k = t.kind
    if anchor_is_newline(k) {
      anchor_body(rest)
    } else if anchor_is_lbrace(k) {
      anchor_elems(rest, 0, [], true, true)
    } else {
      anchor_elems(tokens, 0, [], true, false)
    }
  }
}

# Walk one body, recording the line of each element's opening token.
# `want` marks that the next significant token opens an element;
# `rec` selects the record separator (`,` and a closing `}`) over the
# sum one (`|`, ending at a decl keyword).
fn anchor_elems(tokens: [Token], depth: Int, acc: [Int], want: Bool, rec: Bool) : [Int] = match tokens {
  [] -> acc
  [t, ...rest] ->
    if anchor_stops(t.kind, depth, rec) {
      acc
    } else if anchor_is_newline(t.kind) {
      anchor_elems(rest, depth, acc, want, rec)
    } else {
      anchor_elems(rest, depth + anchor_depth_delta(t.kind),
                   anchor_take(acc, t.line, want and not anchor_closes(t.kind)),
                   anchor_next_want(t.kind, depth, rec), rec)
    }
}

fn anchor_stops(k: TokKind, depth: Int, rec: Bool) : Bool =
  anchor_is_eof(k) or ((depth == 0) and anchor_body_ends(k, rec))

fn anchor_depth_delta(k: TokKind) : Int =
  if anchor_opens(k) { 1 } else if anchor_closes(k) { 0 - 1 } else { 0 }

# The token after a depth-0 separator opens the next element. A
# separator nested inside a payload belongs to that payload, not to
# the body being walked.
fn anchor_next_want(k: TokKind, depth: Int, rec: Bool) : Bool =
  (depth == 0) and anchor_is_sep(k, rec)

fn anchor_take(acc: [Int], line: Int, want: Bool) : [Int] =
  if want { [line, ...acc] } else { acc }

fn anchor_body_ends(k: TokKind, rec: Bool) : Bool =
  if rec { anchor_is_rbrace(k) } else { anchor_starts_decl(k) }

fn anchor_is_sep(k: TokKind, rec: Bool) : Bool =
  if rec { anchor_is_comma(k) } else { anchor_is_pipe(k) }

fn anchor_opens(k: TokKind) : Bool = match k {
  TkLparen -> true
  TkLbracket -> true
  TkLbrace -> true
  _ -> false
}

fn anchor_closes(k: TokKind) : Bool = match k {
  TkRparen -> true
  TkRbracket -> true
  TkRbrace -> true
  _ -> false
}

# `<` / `[` in the type head: habitant slots and type params.
fn anchor_head_opens(k: TokKind) : Bool = match k {
  TkLbracket -> true
  TkLt -> true
  _ -> false
}

fn anchor_head_closes(k: TokKind) : Bool = match k {
  TkRbracket -> true
  TkGt -> true
  _ -> false
}

fn anchor_is_type(k: TokKind) : Bool = match k { TkType -> true _ -> false }
fn anchor_is_eof(k: TokKind) : Bool = match k { TkEof -> true _ -> false }
fn anchor_is_newline(k: TokKind) : Bool = match k { TkNewline -> true _ -> false }
fn anchor_is_lbrace(k: TokKind) : Bool = match k { TkLbrace -> true _ -> false }
fn anchor_is_rbrace(k: TokKind) : Bool = match k { TkRbrace -> true _ -> false }
fn anchor_is_eq(k: TokKind) : Bool = match k { TkEq -> true _ -> false }
fn anchor_is_comma(k: TokKind) : Bool = match k { TkComma -> true _ -> false }
fn anchor_is_pipe(k: TokKind) : Bool = match k { TkPipe -> true _ -> false }

# Keywords that can only open a new top-level declaration, so a sum
# body has ended by the time one appears.
fn anchor_starts_decl(k: TokKind) : Bool = match k {
  TkPub -> true
  TkFn -> true
  TkType -> true
  TkTest -> true
  TkImport -> true
  TkEffect -> true
  TkProtocol -> true
  TkImpl -> true
  TkConst -> true
  TkTheory -> true
  _ -> false
}
