# Hash index over the function registry.
#
# `lookup_ufn_sig` answers "was this (name, module) classified as an
# unboxed-signature fn", and the unbox and Perceus walks ask once per
# decl and per call site, against one entry per top-level fn in the
# whole program. The index buckets the registry by bare name so the
# module test runs over one name's entries instead of all of them.
#
# The answer does not depend on order: the reader keeps the entry whose
# module matches exactly, and a (name, module) pair is registered once.
# A hash collision mixes foreign names into a chain; the reader re-tests
# both name and module, so it costs a comparison, never an answer.

import compiler.infer_index
import compiler.fnreg

#[doc("A function registry plus a hash index from bare name to the entries sharing it.")]
pub type FnIndex = { ix: NameIndex[EFn], sx: NameIndex[EFn], all: [EFn] }

#[doc("The index over an empty registry.")]
pub fn fnx_empty() : FnIndex = FnIndex { ix: idx_empty(), sx: idx_empty(), all: [] }

#[doc("Index a function registry so a signature lookup does not scan it.")]
pub fn fnx_build(fns: [EFn]) : FnIndex =
  FnIndex { ix: fnx_add(fns, idx_empty()), sx: fnx_add_sym(fns, idx_empty()), all: fns }

fn fnx_add(fns: [EFn], ix: NameIndex[EFn]) : NameIndex[EFn] = match fns {
  []           -> ix
  [f, ...rest] -> match f {
    EFn(n, _, _, _, _) -> fnx_add(rest, idx_prepend(ix, n, f))
  }
}

# The same registry keyed by the id each entry was declared under. A
# bucket holds one declaration, so the reader has nothing to
# disambiguate — the name index needs a `(name, module)` test precisely
# because a name bucket cannot tell two homonyms apart.
fn fnx_add_sym(fns: [EFn], ix: NameIndex[EFn]) : NameIndex[EFn] = match fns {
  []           -> ix
  [f, ...rest] -> match f {
    EFn(_, _, _, _, s) ->
      if fnx_stamped(s) { fnx_add_sym(rest, idx_prepend_sym(ix, s, f)) }
      else { fnx_add_sym(rest, ix) }
  }
}

fn fnx_stamped(s: SymId) : Bool = sym_raw(s) >= 0

#[doc("The unboxed-signature classification of the fn `s` declares, if it has one. The id answers alone: no name, no module, no tie to break.")]
pub fn fnx_ufn_sig_sym(fx: FnIndex, s: SymId) : Option[UFnSig] =
  fnx_sig_first(idx_chain_sym(fx.sx, s))

fn fnx_sig_first(chain: [EFn]) : Option[UFnSig] = match chain {
  []          -> None
  [f, ..._]   -> match f { EFn(_, _, _, sig, _) -> sig }
}

#[doc("The unboxed-signature classification of the fn declared as `name` by `mo`, if it has one.")]
pub fn fnx_ufn_sig(fx: FnIndex, name: String, mo: Option[String]) : Option[UFnSig] =
  fnx_sig_chain(idx_chain(fx.ix, name), name, mo)

fn fnx_sig_chain(chain: [EFn], name: String, mo: Option[String]) : Option[UFnSig] = match chain {
  []           -> None
  [f, ...rest] -> match f {
    EFn(n, _, m2, sig, _) ->
      if n == name and mo_eq(mo, m2) { sig } else { fnx_sig_chain(rest, name, mo) }
  }
}

#[doc("The whole registry, in its original order — for the readers that need order or every entry.")]
pub fn fnx_all(fx: FnIndex) : [EFn] = fx.all
