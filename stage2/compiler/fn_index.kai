#[doc("Per-function tables keyed by declaration identity: protocol bounds, C symbols, function sets, predicates and constructor indexes.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.symtab
import compiler.parse_fns
import compiler.written
import compiler.fnreg
import compiler.infer_index
import compiler.refine_types
import compiler.call_site_target
import compiler.builtins
import compiler.core_builtins
import compiler.vec_raw

# Hash index over the function registry.
#
# The unbox, Perceus and emit walks ask for a fn's entry or unboxed
# signature once per decl and per call site, against one entry per
# top-level fn in the whole program. The index buckets the registry by
# declaration so a lookup runs over one declaration's instances instead
# of every entry.
#
# A chain is newest-first, and two modules sharing a basename register
# one identity twice, so a reader states which of the two it answers.

#[doc("A function registry plus a hash index from a declaration to its entries, the declared core builtins among its fns, the declared effects, the raw core primitives, and whether Vec reads take the bare-word paths.")]
pub(pkg) type FnIndex = { sx: NameIndex[EFn], all: [EFn], kai: NameIndex[KaiBuiltin], effs: [SymId], raws: SymSet, vraw: VecRawCx }

#[doc("Index a function registry so a signature lookup does not scan it.")]
pub(pkg) fn fnx_build(fns: [EFn]) : FnIndex =
  FnIndex { sx: fnx_add_sym(fns, idx_empty()), all: fns, kai: idx_empty(), effs: [], raws: sym_set_empty(), vraw: VrOff }

# Without the declared builtins a call to one still reaches it, through
# the fn its declaration emits; with them the call binds the runtime symbol.
#[doc("Index the fns of the post-desugar decls `ds`, the declared core builtins among them included.")]
pub(pkg) fn fnx_build_decls(ds: [Decl], fns: [EFn]) : FnIndex = {
  let fx = fnx_build(fns)
  FnIndex { ...fx, kai: fnx_kai_index(list_reverse(kai_builtins(ds)), idx_empty()) }
}

#[doc("`fx` knowing the effects `ds` declares, so a perform is recognised by its effect's id.")]
pub(pkg) fn fnx_with_effects(fx: FnIndex, ds: [Decl]) : FnIndex = FnIndex { ...fx, effs: fnx_effect_ids(ds, []) }

#[doc("`fx` taking bare-word Vec reads over the records `ds` declares, so the unbox pass marks them raw.")]
pub(pkg) fn fnx_with_vec_raw(fx: FnIndex, ds: [Decl]) : FnIndex = FnIndex { ...fx, vraw: VrOn(collect_records(ds)) }

fn fnx_effect_ids(ds: [Decl], acc: [SymId]) : [SymId] = match ds {
  [] -> acc
  [DEffect(_, s, _, _, _, _, _, _), ...rest] -> fnx_effect_ids(rest, [s, ...acc])
  [_, ...rest] -> fnx_effect_ids(rest, acc)
}

#[doc("`fx` knowing the raw core primitives, so a call to one is recognised by its row's id.")]
pub(pkg) fn fnx_with_raw_prims(fx: FnIndex) : FnIndex = FnIndex { ...fx, raws: raw_prim_syms() }

#[doc("True when `s` is the row of a raw core primitive, in an index built to know them.")]
pub(pkg) fn fnx_is_raw_prim(fx: FnIndex, s: SymId) : Bool = sym_set_has(fx.raws, s)

#[doc("True when `s` is the id of a declared effect: a call whose callee carries it is a perform.")]
pub(pkg) fn fnx_is_effect(fx: FnIndex, s: SymId) : Bool = fnx_sym_in(fx.effs, sym_raw(s))

fn fnx_sym_in(ss: [SymId], id: Int) : Bool = match ss {
  [] -> false
  [h, ...rest] -> sym_raw(h) == id or fnx_sym_in(rest, id)
}

#[doc("The declared core builtin a call to `s` binds, or None when `s` names any other fn.")]
pub(pkg) fn fnx_kai(fx: FnIndex, s: FnId) : Option[KaiBuiltin] = fnx_kai_pick(idx_chain_sym(fx.kai, fnid_sym(s)), s)

fn fnx_kai_pick(chain: [KaiBuiltin], s: FnId) : Option[KaiBuiltin] = match chain {
  [] -> None
  [kb, ...rest] -> match kb {
    KB(f, _) -> if fnid_eq(f, s) { Some(kb) } else { fnx_kai_pick(rest, s) }
  }
}

fn fnx_kai_index(rev: [KaiBuiltin], ix: NameIndex[KaiBuiltin]) : NameIndex[KaiBuiltin] = match rev {
  [] -> ix
  [kb, ...rest] -> match kb { KB(f, _) -> fnx_kai_index(rest, idx_prepend_sym(ix, fnid_sym(f), kb)) }
}

# The registry keyed by the declaration each entry instantiates. A
# bucket holds one declaration and its specialisations, told apart by
# instance index.
fn fnx_add_sym(fns: [EFn], ix: NameIndex[EFn]) : NameIndex[EFn] = match fns {
  []           -> ix
  [f, ...rest] -> match f {
    EFn(_, _, _, _, s) ->
      if fnx_stamped(fnid_sym(s)) { fnx_add_sym(rest, idx_prepend_sym(ix, fnid_sym(s), f)) }
      else { fnx_add_sym(rest, ix) }
  }
}

fn fnx_stamped(s: SymId) : Bool = sym_raw(s) >= 0

#[doc("The unboxed-signature classification of the fn instance `s` names, if it has one. The id answers alone: no name, no module, no tie to break.")]
pub(pkg) fn fnx_ufn_sig_sym(fx: FnIndex, s: FnId) : Option[UFnSig] = match fnx_of_sym(fx, s) {
  Some(EFn(_, _, _, sig, _)) -> sig
  None -> None
}

#[doc("The declaration a reference carrying identity `s` reaches. A local carries none and a builtin's reaches no declaration, so two homonymous declarations never trade places here.")]
pub(pkg) fn fnx_callee(fx: FnIndex, s: FnId) : Option[EFn] = fnx_of_sym(fx, s)

#[doc("The registry entry for the fn instance `s`: the declaration itself or one of its specialisations.")]
pub(pkg) fn fnx_of_sym(fx: FnIndex, s: FnId) : Option[EFn] = fnx_inst(idx_chain_sym(fx.sx, fnid_sym(s)), s)

fn fnx_inst(chain: [EFn], s: FnId) : Option[EFn] = match chain {
  []           -> None
  [f, ...rest] -> if fnid_eq(efn_sym(f), s) { Some(f) } else { fnx_inst(rest, s) }
}

#[doc("The unboxed-signature classification of the declaration `fid` names.")]
pub(pkg) fn fnx_decl_sig(fx: FnIndex, fid: FnId) : Option[UFnSig] = fnx_ufn_sig_sym(fx, fid)

#[doc("The unboxed-signature classification of the fn a call head names. A bare spelling is a local, never a declaration.")]
pub(pkg) fn fnx_callee_sig(fx: FnIndex, callee: Expr) : Option[UFnSig] = match callee_fnid(callee) {
  Some(f) -> efn_sig_of(fnx_of_sym(fx, f))
  None    -> None
}

fn efn_sig_of(e: Option[EFn]) : Option[UFnSig] = match e {
  Some(EFn(_, _, _, sig, _)) -> sig
  None                       -> None
}

#[doc("The unboxed-signature classification of the first registry entry of the fn instance `s`: the one a scan of the registry in order finds.")]
pub(pkg) fn fnx_ufn_sig_first(fx: FnIndex, s: FnId) : Option[UFnSig] =
  fnx_sig_oldest(idx_chain_sym(fx.sx, fnid_sym(s)), s, None)

fn fnx_sig_oldest(chain: [EFn], s: FnId, found: Option[UFnSig]) : Option[UFnSig] = match chain {
  []           -> found
  [f, ...rest] -> match f {
    EFn(_, _, _, sig, id) -> fnx_sig_oldest(rest, s, if fnid_eq(id, s) { sig } else { found })
  }
}

#[doc("A bounded fn's declaration identity and its per-tparam protocol bounds.")]
pub(pkg) type SymBounds = SymBoundsEntry(SymId, [FnTPBound])

#[doc("Surface-stream bounds of every bounded free fn, keyed by (name, module origin); a root-file fn has origin `None`. `tab` holds the stream's declarations.")]
pub(pkg) fn collect_surface_bounds(ds: [Decl], tab: SymTab) : [FnBoundsRec] = surface_bounds_loop(ds, tab, [])

fn surface_bounds_loop(ds: [Decl], tab: SymTab, acc: [FnBoundsRec]) : [FnBoundsRec] = match ds {
  [] -> acc
  [d, ...rest] -> surface_bounds_loop(rest, tab, surface_bounds_of(d, tab, acc))
}

fn surface_bounds_of(d: Decl, tab: SymTab, acc: [FnBoundsRec]) : [FnBoundsRec] = match d {
  DFn(_, f, tps, _, _, _, _, _, _, mo) -> match fn_tp_bounds_of(tps) {
    [] -> acc
    bs -> [FBR(written_text(decl_name(tab, fnid_sym(f))), mo, bs), ...acc]
  }
  DDoc(_, _, inner, _, _) -> surface_bounds_of(inner, tab, acc)
  DAttr(_, inner, _, _)   -> surface_bounds_of(inner, tab, acc)
  _ -> acc
}

#[doc("Re-key surface bounds onto the `SymId` of the resolved fn decls they belong to.")]
pub(pkg) fn bounds_by_sym(ds: [Decl], recs: [FnBoundsRec], target_mod: String) : [SymBounds] =
  match recs {
    [] -> []
    _  -> sym_bounds_loop(ds, map(recs, (r) => rec_by_sym(r, target_mod)), [])
  }

# A surface record with no origin is a root-file fn, homed at the target.
fn rec_by_sym(r: FnBoundsRec, target_mod: String) : SymBounds = match r {
  FBR(n, mo, bs) -> SymBoundsEntry(sym_derive(NCFn, n, match mo { Some(m) -> m  None -> target_mod }), bs)
}

fn sym_bounds_loop(ds: [Decl], recs: [SymBounds], acc: [SymBounds]) : [SymBounds] = match ds {
  [] -> acc
  [d, ...rest] -> match d {
    DFn(_, f, tps, _, _, _, _, _, _, _) ->
      if list_length(tps) == 0 or sym_raw(fnid_sym(f)) < 0 { sym_bounds_loop(rest, recs, acc) }
      else {
        match bounds_of_sym(recs, fnid_sym(f)) {
          Some(bs) -> sym_bounds_loop(rest, recs, [SymBoundsEntry(fnid_sym(f), bs), ...acc])
          None     -> sym_bounds_loop(rest, recs, acc)
        }
      }
    _ -> sym_bounds_loop(rest, recs, acc)
  }
}

#[doc("The bounds recorded for the fn declared as `s`, or `None` when it has none.")]
pub(pkg) fn bounds_of_sym(tbl: [SymBounds], s: SymId) : Option[[FnTPBound]] = match tbl {
  [] -> None
  [SymBoundsEntry(t, bs), ...rest] -> if sym_raw(t) == sym_raw(s) { Some(bs) } else { bounds_of_sym(rest, s) }
}

#[doc("The C symbol, after the `kai_` prefix, of the fn declared as `name` by `mo`: `<mo>__<name>`, or the bare name outside a module.")]
pub(pkg) fn c_sym(name: String, mo: Option[String]) : String = match mo {
  None    -> name
  Some(m) -> string_concat(m, string_concat("__", name))
}

#[doc("`s` in the reserved `kaiu_` namespace, so no module or fn name reaches the runtime's `kai_*` / `kaix_*` symbols; `_`-led compiler-minted names stay as they are.")]
pub(pkg) fn user_sym_of(s: String) : String =
  if string_starts_with_q(s, "_") { s } else { string_concat("kaiu_", s) }

#[doc("The part of the user symbol `s` after its `kaiu_` namespace, from which the symbols derived from it (thunks, lambdas, clauses) are named under their own prefix.")]
pub(pkg) fn user_stem_of(s: String) : String =
  if string_starts_with_q(s, "kaiu_") { string_slice(s, 5, string_length(s) - 5) } else { s }

#[doc("The symbol the fn declared as `name` by `mo` is emitted under.")]
pub(pkg) fn user_fn_sym(name: String, mo: Option[String]) : String = user_sym_of(c_sym(name, mo))

#[doc("The emitted symbol of the registry entry `f`.")]
pub(pkg) fn efn_c_sym(f: EFn) : String = match f {
  EFn(n, _, mo, _, _) -> user_fn_sym(written_text(n), mo)
}

#[doc("A set of function identities.")]
pub(pkg) type FnSet = { ix: NameIndex[FnId] }

#[doc("The set of the identities `fs`.")]
pub(pkg) fn fn_set_of(fs: [FnId]) : FnSet = FnSet { ix: fs_add(fs, idx_empty()) }

#[doc("True when `set` holds `f`.")]
pub(pkg) fn fn_set_has(set: FnSet, f: FnId) : Bool = fs_in(idx_chain_sym(set.ix, fnid_sym(f)), f)

fn fs_add(fs: [FnId], ix: NameIndex[FnId]) : NameIndex[FnId] = match fs {
  []           -> ix
  [f, ...rest] -> fs_add(rest, idx_prepend_sym(ix, fnid_sym(f), f))
}

fn fs_in(chain: [FnId], f: FnId) : Bool = match chain {
  []           -> false
  [g, ...rest] -> fnid_eq(g, f) or fs_in(rest, f)
}

#[doc("The predicates of the types the signature of `d` writes: parameters and result, a const's annotation, a type's body, an effect's operations, and the same of an impl's methods.")]
pub(pkg) fn decl_preds(d: Decl) : [Expr] = tys_preds(sig_types(d))

#[doc("The predicates of the types `e` itself annotates: a lambda's parameters, a block's `let`s, a handler's type arguments.")]
pub(pkg) fn expr_preds(e: Expr) : [Expr] = match e.kind {
  ELambda(ps, _)                -> tys_preds(params_types(ps))
  EBlock(stmts, _)              -> tys_preds(stmts_types(stmts))
  EHandle(_, _, ta, _, _, _, _) -> tys_preds(ta)
  _                             -> []
}

fn sig_types(d: Decl) : [TypeExpr] = match decl_transparent_inner(d) {
  Some(inner) -> sig_types(inner)
  None        -> match d {
    DFn(_, _, _, ps, ret, _, _, _, _, _) -> list_append(params_types(ps), opt_types(ret))
    DCheck(_, ps, _, _, _, _)            -> params_types(ps)
    DConst(_, _, ta, _, _, _, _, _, _)         -> [ta]
    DType(_, _, _, body, _, _, _, _)     -> body_types(body)
    DEffect(_, _, _, ops, _, _, _, _)    -> flat_map(ops, op_types)
    DImpl(_, _, _, subs, _, _, _, _)     -> flat_map(subs, sig_types)
    _                                    -> []
  }
}

fn op_types(op: EffectOp) : [TypeExpr] = match op {
  EffOp(_, _, ps, ret, _, _) -> [ret, ...params_types(ps)]
}

fn opt_types(o: Option[TypeExpr]) : [TypeExpr] = match o {
  Some(t) -> [t]
  None    -> []
}

# Most blocks annotate nothing: no list is built for those.
fn stmts_types(ss: [Stmt]) : [TypeExpr] = match ss {
  []           -> []
  [s, ...rest] -> match s {
    SLet(_, Some(t), _) -> [t, ...stmts_types(rest)]
    _                   -> stmts_types(rest)
  }
}

#[doc("A program's constructor Int-slot flags, each under its constructor's id.")]
pub(pkg) type CtorIntIx = { ix: NameIndex[CtorIntSlots] }

#[doc("The index of `entries`, where the earliest entry of a constructor is the one it answers with.")]
pub(pkg) fn ctor_int_ix_of(entries: [CtorIntSlots]) : CtorIntIx =
  CtorIntIx { ix: cii_add(list_reverse(entries), idx_empty()) }

fn cii_add(rev: [CtorIntSlots], ix: NameIndex[CtorIntSlots]) : NameIndex[CtorIntSlots] = match rev {
  [] -> ix
  [CIS(c, flags), ...rest] -> cii_add(rest, idx_prepend_sym(ix, c, CIS(c, flags)))
}

#[doc("The flags registered for the constructor `s`, `None` when it has no entry.")]
pub(pkg) fn ctor_int_slots_of(cis: CtorIntIx, s: SymId) : Option[[Bool]] =
  if sym_raw(s) < 0 { None }
  else { match idx_chain_sym(cis.ix, s) {
    [CIS(_, flags), ..._] -> Some(flags)
    []                    -> None
  } }
