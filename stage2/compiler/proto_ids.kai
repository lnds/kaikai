#[doc("""
Protocol identity: the ids a protocol is known by, contested names and the operation index.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.symtab
import compiler.written
import compiler.ast_map
import compiler.diag
import compiler.util
import compiler.core_builtins

#[doc("The table that holds no generated function.")]
pub(pkg) fn pid_empty() : ProtoIds = ProtoIds { disps: IdLeaf, shared: [], homed: IdLeaf, impls: IdLeaf, walked: IdLeaf }

#[doc("The id of the generated function `name` homed at `home` (`None` for the root file, whose module is `root`).")]
pub(pkg) fn pid_fn_id(name: String, home: Option[String], root: String) : SymId =
  sym_derive(NCFn, name, match home { Some(m) -> m  None -> root })

#[doc("`ids` with the dispatcher `name` recorded for the operation `op` of arity `arity` that the protocol `proto` of `home` declares. A dispatcher another protocol of that home already generated gains `proto` as one more protocol sharing it.")]
pub(pkg) fn pid_note_disp(ids: ProtoIds, name: String, op: String, home: Option[String], arity: Int,
                     proto: SymId, root: String) : ProtoIds = {
  let s = pid_fn_id(name, home, root)
  let shared = [ProtoDisp(proto, s), ...ids.shared]
  if pid_is_disp(ids, s) { ProtoIds { ...ids, shared: shared } }
  else { ProtoIds { ...ids, disps: idt_put(ids.disps, sym_raw(s), DispInfo(name, op, home, arity, false)), shared: shared } }
}

#[doc("`ids` with `twin` recorded as the homed twin of the dispatcher `name` of `home`: the same operation and arity, answered by the protocols of `home` only.")]
pub(pkg) fn pid_note_homed(ids: ProtoIds, name: String, twin: String, home: Option[String], root: String) : ProtoIds = {
  let s = pid_fn_id(name, home, root)
  match pid_disp(ids, s) {
    Some(d) -> {
      let t = pid_fn_id(twin, home, root)
      ProtoIds { ...ids, disps: idt_put(ids.disps, sym_raw(t), DispInfo(twin, disp_op(d), home, disp_arity(d), true)),
                 homed: idt_put(ids.homed, sym_raw(s), t) }
    }
    None -> ids
  }
}

#[doc("`ids` over the impl entries `impls`: the table of a registry whose entries were lowered, renamed or rebuilt.")]
pub(pkg) fn pid_with_impls(ids: ProtoIds, impls: [ProtoImplReg], root: String) : ProtoIds =
  ProtoIds { ...ids, impls: pid_index_impls(impls, IdLeaf) }

#[doc("`ids` with `fs` recorded as the impl methods the structural compare stands in for: the runtime impl table holds no row for them.")]
pub(pkg) fn pid_with_walked(ids: ProtoIds, fs: [SymId]) : ProtoIds =
  ProtoIds { ...ids, walked: pid_index_walked(fs, IdLeaf) }

fn pid_index_walked(fs: [SymId], t: IdTree[Bool]) : IdTree[Bool] = match fs {
  [] -> t
  [f, ...rest] -> pid_index_walked(rest, idt_put(t, sym_raw(f), true))
}

fn pid_index_impls(impls: [ProtoImplReg], t: IdTree[ProtoImplReg]) : IdTree[ProtoImplReg] = match impls {
  [] -> t
  [p, ...rest] -> match p {
    PIR(_, _, _, f, _, _, _) -> pid_index_impls(rest, idt_put(t, sym_raw(f), p))
  }
}

# The first row put under a key keeps it.
fn idt_put(t: IdTree[a], k: Int, v: a) : IdTree[a] = match t {
  IdLeaf -> IdNode(IdLeaf, k, v, IdLeaf)
  IdNode(l, nk, nv, r) ->
    if k < nk { IdNode(idt_put(l, k, v), nk, nv, r) }
    else if k > nk { IdNode(l, nk, nv, idt_put(r, k, v)) }
    else { t }
}

fn idt_get(t: IdTree[a], k: Int) : Option[a] = match t {
  IdLeaf -> None
  IdNode(l, nk, nv, r) ->
    if k < nk { idt_get(l, k) }
    else if k > nk { idt_get(r, k) }
    else { Some(nv) }
}

#[doc("The operation a dispatcher stands for.")]
pub(pkg) fn disp_op(d: DispInfo) : String = match d { DispInfo(_, op, _, _, _) -> op }

#[doc("The home of a dispatcher and of the protocols that share it; `None` for the root file.")]
pub(pkg) fn disp_home(d: DispInfo) : Option[String] = match d { DispInfo(_, _, h, _, _) -> h }

fn disp_arity(d: DispInfo) : Int = match d { DispInfo(_, _, _, a, _) -> a }

#[doc("True when only the protocols of the dispatcher's home answer it.")]
pub(pkg) fn disp_homed(d: DispInfo) : Bool = match d { DispInfo(_, _, _, _, h) -> h }

#[doc("The homed twin of the dispatcher `s`, or `None` when it has none: `s` is no dispatcher, or one of the root file.")]
pub(pkg) fn pid_homed_twin(ids: ProtoIds, s: SymId) : Option[SymId] =
  if sym_raw(s) < 0 { None } else { idt_get(ids.homed, sym_raw(s)) }

#[doc("What the lowering recorded of the dispatcher whose id is `s`, or `None` when `s` is any other symbol.")]
pub(pkg) fn pid_disp(ids: ProtoIds, s: SymId) : Option[DispInfo] =
  if sym_raw(s) < 0 { None } else { idt_get(ids.disps, sym_raw(s)) }

#[doc("The registry entry of the impl method whose id is `s`, or `None` when `s` is any other symbol.")]
pub(pkg) fn pid_impl(ids: ProtoIds, s: SymId) : Option[ProtoImplReg] =
  if sym_raw(s) < 0 { None } else { idt_get(ids.impls, sym_raw(s)) }

#[doc("True when the structural compare stands in for the impl method `s`.")]
pub(pkg) fn pid_is_walked(ids: ProtoIds, s: SymId) : Bool = match idt_get(ids.walked, sym_raw(s)) {
  Some(_) -> true
  None    -> false
}

#[doc("True when `s` is the id of a dispatcher.")]
pub(pkg) fn pid_is_disp(ids: ProtoIds, s: SymId) : Bool = match pid_disp(ids, s) {
  Some(_) -> true
  None    -> false
}

#[doc("True when `s` is the id of an impl method.")]
pub(pkg) fn pid_is_impl(ids: ProtoIds, s: SymId) : Bool = match pid_impl(ids, s) {
  Some(_) -> true
  None    -> false
}

fn pid_no_disp(ids: ProtoIds) : Bool = match ids.disps {
  IdLeaf -> true
  _      -> false
}

fn pid_qualified_disp(ids: ProtoIds, m: Written, name: Written) : Option[DispInfo] =
  if pid_no_disp(ids) { None } else { pid_disp(ids, sym_derive(NCFn, written_text(name), written_text(m))) }

#[doc("True when the qualified reference `m.name` names a dispatcher.")]
pub(pkg) fn pid_qualified_is_disp(ids: ProtoIds, m: Written, name: Written) : Bool = match pid_qualified_disp(ids, m, name) {
  Some(_) -> true
  None    -> false
}

#[doc("The dispatcher a bare reference names by its id; `None` for anything else. A reference left between several is answered by any of them: they stand for one operation at one type.")]
pub(pkg) fn pid_bare_disp(ids: ProtoIds, f: Expr) : Option[DispInfo] = match f.kind {
  ESym(s, _)                     -> pid_disp(ids, s)
  EMark(MkProtoOp([s, ..._]))    -> pid_disp(ids, s)
  _                              -> None
}

fn pid_protos_of(ids: ProtoIds, s: SymId) : [SymId] = protos_sharing(ids.shared, s)

fn protos_sharing(ps: [ProtoDisp], s: SymId) : [SymId] = match ps {
  [] -> []
  [ProtoDisp(p, d), ...rest] -> if sym_raw(d) == sym_raw(s) { [p, ...protos_sharing(rest, s)] } else { protos_sharing(rest, s) }
}

fn pid_any_contest(ids: ProtoIds) : Bool = contest_among(ids, ids.shared)

fn contest_among(ids: ProtoIds, ps: [ProtoDisp]) : Bool = match ps {
  [] -> false
  [ProtoDisp(_, s), ...rest] -> any(rest, (p) => match p { ProtoDisp(_, t) -> same_op_apart(ids, s, t) }) or contest_among(ids, rest)
}

#[doc("True when the dispatchers `a` and `b` are one, or answer the same operation at the same arity from different homes.")]
pub(pkg) fn pid_same_op(ids: ProtoIds, a: SymId, b: SymId) : Bool =
  sym_raw(a) == sym_raw(b) or same_op_apart(ids, a, b)

fn same_op_apart(ids: ProtoIds, a: SymId, b: SymId) : Bool =
  sym_raw(a) != sym_raw(b) and match pid_disp(ids, a) {
    Some(d) -> pid_stands_at(ids, b, disp_op(d), disp_arity(d))
    None    -> false
  }

#[doc("The dispatcher a reference names, bare or qualified; `None` for anything else.")]
pub(pkg) fn pid_ref_disp(ids: ProtoIds, f: Expr) : Option[DispInfo] = match f.kind {
  EModCall(m, n) -> pid_qualified_disp(ids, m, n)
  _              -> pid_bare_disp(ids, f)
}

#[doc("The id of the dispatcher of the operation `op` the protocol `proto` declares, or `None` when it declares none.")]
pub(pkg) fn pid_op_disp(ids: ProtoIds, proto: SymId, op: String) : Option[SymId] =
  if sym_raw(proto) < 0 { None } else { pid_op_in(ids, ids.shared, proto, op) }

fn pid_op_in(ids: ProtoIds, ps: [ProtoDisp], proto: SymId, op: String) : Option[SymId] = match ps {
  [] -> None
  [ProtoDisp(p, s), ...rest] ->
    if sym_raw(p) == sym_raw(proto) and pid_stands_for(ids, s, op) { Some(s) } else { pid_op_in(ids, rest, proto, op) }
}

fn pid_stands_for(ids: ProtoIds, s: SymId, op: String) : Bool = match pid_disp(ids, s) {
  Some(d) -> disp_op(d) == op
  None    -> false
}

#[doc("The id of the dispatcher of the operation `op` at arity `arity` the protocol `proto` declares, or `None` when it declares none.")]
pub(pkg) fn pid_op_disp_at(ids: ProtoIds, proto: SymId, op: String, arity: Int) : Option[SymId] =
  if sym_raw(proto) < 0 { None } else { pid_op_at(ids, ids.shared, proto, op, arity) }

fn pid_op_at(ids: ProtoIds, ps: [ProtoDisp], proto: SymId, op: String, arity: Int) : Option[SymId] = match ps {
  [] -> None
  [ProtoDisp(p, s), ...rest] ->
    if sym_raw(p) == sym_raw(proto) and pid_stands_at(ids, s, op, arity) { Some(s) } else { pid_op_at(ids, rest, proto, op, arity) }
}

fn pid_stands_at(ids: ProtoIds, s: SymId, op: String, arity: Int) : Bool = match pid_disp(ids, s) {
  Some(d) -> disp_op(d) == op and disp_arity(d) == arity
  None    -> false
}

#[doc("A bare reference to the dispatcher `s`, born with its id; `None` when `s` is no dispatcher.")]
pub(pkg) fn pid_disp_ref(ids: ProtoIds, s: SymId) : Option[ExprKind] = match pid_disp(ids, s) {
  Some(_) -> Some(ESym(s, spec_none()))
  None    -> None
}

#[doc("A reference to the dispatcher `s` that only its home's protocols answer: its homed twin, born with its id. The dispatcher itself for one of the root file, which has no twin. `None` when `s` is no dispatcher.")]
pub(pkg) fn pid_disp_homed_ref(ids: ProtoIds, s: SymId) : Option[ExprKind] = match pid_homed_twin(ids, s) {
  Some(t) -> Some(ESym(t, spec_none()))
  None    -> pid_disp_ref(ids, s)
}

#[doc("A bare reference to the dispatcher of the operation `op` the protocol `proto` declares, or `None` when it declares none.")]
pub(pkg) fn pid_op_ref(ids: ProtoIds, proto: SymId, op: String) : Option[ExprKind] = match pid_op_disp(ids, proto, op) {
  Some(s) -> pid_disp_ref(ids, s)
  None    -> None
}

#[doc("What the typer reads of the protocol registry: the impl entries, and the generated functions by id.")]
pub(pkg) type ProtoView = { impls: [ProtoImplReg], ids: ProtoIds }

#[doc("The view of a program with no protocol.")]
pub(pkg) fn pv_empty() : ProtoView = ProtoView { impls: [], ids: pid_empty() }

#[doc("The typer's view of the registry `reg`.")]
pub(pkg) fn pv_of(reg: ProtocolReg) : ProtoView = ProtoView { impls: reg.impls, ids: reg.ids }

#[doc("The dispatchers the reference `f` stands between; `[]` for any other reference.")]
pub(pkg) fn contest_of(f: Expr) : [SymId] = match f.kind {
  EMark(MkProtoOp(ss)) -> ss
  _                    -> []
}

#[doc("The protocols behind the dispatchers `ss`, each once.")]
pub(pkg) fn contest_protocols(ids: ProtoIds, ss: [SymId]) : [SymId] = protocols_of(ids, ss, [])

fn protocols_of(ids: ProtoIds, ss: [SymId], acc: [SymId]) : [SymId] = match ss {
  []           -> list_reverse(acc)
  [s, ...rest] -> protocols_of(ids, rest, add_each(pid_protos_of(ids, s), acc))
}

fn add_each(ps: [SymId], acc: [SymId]) : [SymId] = match ps {
  []           -> acc
  [p, ...rest] -> add_each(rest, if any(acc, (x) => sym_raw(x) == sym_raw(p)) { acc } else { [p, ...acc] })
}

#[doc("The arity every dispatcher of `ss` declares, or `None` when they differ.")]
pub(pkg) fn contest_arity(ids: ProtoIds, ss: [SymId]) : Option[Int] = match ss {
  []           -> None
  [s, ...rest] -> match pid_disp(ids, s) {
    None    -> None
    Some(d) -> if all(rest, (x) => arity_is(ids, x, disp_arity(d))) { Some(disp_arity(d)) } else { None }
  }
}

fn arity_is(ids: ProtoIds, s: SymId, n: Int) : Bool = match pid_disp(ids, s) {
  Some(d) -> disp_arity(d) == n
  None    -> false
}

#[doc("The reference `f` as the function of `n` parameters that calls it: an operation read as a value is settled at that call.")]
pub(pkg) fn contest_as_function(f: Expr, n: Int) : Expr = {
  let bs = param_binders(f, 0, n)
  let ps = map(bs, (b) => Param { binder: b, ptype: None, pline: f.line, pcol: f.col, pborrow: false })
  let call = mk_expr(ECall(f, map(bs, (b) => mk_local(b.id, f.line, f.col))), f.line, f.col)
  mk_expr(ELambda(ps, call), f.line, f.col)
}

fn param_binders(f: Expr, i: Int, n: Int) : [Binder] =
  if i >= n { [] }
  else { [binder_minted("__op_#{f.line}_#{f.col}_#{i}__"), ...param_binders(f, i + 1, n)] }

#[doc("The report for an operation no type can settle: its name, and every protocol declaring it as `shown` spells them.")]
pub(pkg) fn contest_stranded_diag(file: String, line: Int, col: Int, ids: ProtoIds, ss: [SymId], shown: [String]) : Diagnostic = {
  let at = (msg) => DR(file, line, col, msg)
  match ss {
    [_] -> mk_diag(SevError, file, line, col,
      concat_all(["cannot tell which type's `", op_text(ids, ss), "` this is: nothing here fixes the type it builds"]),
      map(["help: annotate it, so the type is known where the operation is used",
           concat_all(["help: bind it to a typed `let` first: `let z: T = ", op_text(ids, ss), "()`, then pass `z` where it is used"])], at))
    _   -> mk_diag(SevError, file, line, col,
      concat_all(["cannot tell which protocol's `", op_text(ids, ss), "` this is: the type that receives it is never known here"]),
      map([concat_all(["note: protocol candidates: ", join_with(shown, ", ")]),
           "help: annotate the receiver, so its type is known where the operation is used"], at))
  }
}

# The operation the dispatchers stand for: one name, whichever is asked.
fn op_text(ids: ProtoIds, ss: [SymId]) : String = match ss {
  []       -> ""
  [s, ..._] -> match pid_disp(ids, s) {
    Some(d) -> disp_op(d)
    None    -> ""
  }
}

#[doc("`ds` with every call no specialisation settled turned into the panic that names its protocols. A program where no operation has two dispatchers is returned as it is.")]
pub(pkg) fn contest_strand_decls(ds: [Decl], tab: SymTab, ids: ProtoIds) : [Decl] =
  if not pid_any_contest(ids) { ds }
  else { map(ds, (d) => decl_map_bodies(d, (b) => strand(b, tab, ids))) }

fn strand(e: Expr, tab: SymTab, ids: ProtoIds) : Expr = {
  let mapped = Expr { ...e, kind: prc_map_expr_kind(e.kind, (x) => strand(x, tab, ids)) }
  match mapped.kind {
    ECall(f, _) -> match contest_of(f) {
      [] -> mapped
      ss -> stranded_call(mapped, tab, ids, ss)
    }
    _ -> mapped
  }
}

fn stranded_call(e: Expr, tab: SymTab, ids: ProtoIds, ss: [SymId]) : Expr = {
  let ret = match e.ty {
    Some(t) -> t
    None    -> TyAny
  }
  let names = map(contest_protocols(ids, ss), (p) => written_text(sym_name(tab, p)))
  let text = concat_all(["`", op_text(ids, ss), "` reached a receiver whose type was never known; ",
                         join_with(names, ", "), " declare it"])
  let msg = with_ty(mk_expr(EStr(concat_all(["\"", text, "\""]), false), e.line, e.col), TyString)
  let panic_ty = TyFnT([TyString], ret, Row { labels: [], tail: None, display_alias: None })
  Expr { ...e, kind: ECall(with_ty(builtin_mk(CbPanic, e.line, e.col), panic_ty), [msg]) }
}

#[doc("Fold `f` over every dispatcher id paired with a protocol it answers. A homed twin answers the protocols its dispatcher does.")]
pub(pkg) fn disp_protos_fold(ids: ProtoIds, acc: a, f: (a, SymId, SymId) -> a) : a = disp_fold_loop(ids, ids.shared, acc, f)

fn disp_fold_loop(ids: ProtoIds, ds: [ProtoDisp], acc: a, f: (a, SymId, SymId) -> a) : a = match ds {
  [] -> acc
  [ProtoDisp(p, s), ...rest] -> disp_fold_loop(ids, rest, match pid_homed_twin(ids, s) {
    Some(t) -> f(f(acc, s, p), t, p)
    None    -> f(acc, s, p)
  }, f)
}
