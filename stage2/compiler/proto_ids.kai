#[doc("""
The functions the protocol lowering generates, by id.

A protocol operation lowers to a dispatcher and an impl method to a
function of its own. Both are ordinary function declarations, so each
has the id the symbol table derives for its name and home. The lowering
records those ids as it mints the names, and a pass holding a callee
asks this table what it is: the answer is never read back out of a
spelling.

A dispatcher stands for an operation, not for one protocol: every
protocol of its home that declares the operation shares it, and all of
them declare it at the dispatcher's arity. A call of it reaches any
protocol that declares the operation, the caller's own first.

A dispatcher of a module has a homed twin: a second function of the same
signature that only the protocols of that home answer. A reference that
must not reach a protocol of another home, such as the `show` an
interpolation calls, names the twin, so the restriction is the
declaration it carries and no pass reads it off the reference's shape.

What the table knows of a dispatcher is filed under its id and holds
none: a reader that has the description came through the id.

A reference the resolver left to the type carries no id, and none of
these answers for it: the typer settles it on one dispatcher, and only
then does a pass ask the table.

The table holds no array, so it rides in the typer's state without
making that state a carrier of mutation.
""")]

import compiler.ast
import compiler.decl_names
import compiler.symtab_build
import compiler.written

#[doc("The table that holds no generated function.")]
pub fn pid_empty() : ProtoIds = ProtoIds { disps: IdLeaf, shared: [], homed: IdLeaf, impls: IdLeaf }

#[doc("The id of the generated function `name` homed at `home` (`None` for the root file, whose module is `root`).")]
pub fn pid_fn_id(name: String, home: Option[String], root: String) : SymId =
  sym_derive(NCFn, name, match home { Some(m) -> m  None -> root })

#[doc("`ids` with the dispatcher `name` recorded for the operation `op` of arity `arity` that the protocol `proto` of `home` declares. A dispatcher another protocol of that home already generated gains `proto` as one more protocol sharing it.")]
pub fn pid_note_disp(ids: ProtoIds, name: String, op: String, home: Option[String], arity: Int,
                     proto: SymId, root: String) : ProtoIds = {
  let s = pid_fn_id(name, home, root)
  let shared = [ProtoDisp(proto, s), ...ids.shared]
  if pid_is_disp(ids, s) { ProtoIds { ...ids, shared: shared } }
  else { ProtoIds { ...ids, disps: idt_put(ids.disps, sym_raw(s), DispInfo(name, op, home, arity, false)), shared: shared } }
}

#[doc("`ids` with `twin` recorded as the homed twin of the dispatcher `name` of `home`: the same operation and arity, answered by the protocols of `home` only.")]
pub fn pid_note_homed(ids: ProtoIds, name: String, twin: String, home: Option[String], root: String) : ProtoIds = {
  let s = pid_fn_id(name, home, root)
  match pid_disp(ids, s) {
    Some(d) -> {
      let t = pid_fn_id(twin, home, root)
      ProtoIds { ...ids, disps: idt_put(ids.disps, sym_raw(t), DispInfo(twin, disp_op(d), home, disp_arity(d), true)),
                 homed: idt_put(ids.homed, sym_raw(s), t) }
    }
    None -> ids
  }
}

#[doc("`ids` over the impl entries `impls`: the table of a registry whose entries were lowered, renamed or rebuilt.")]
pub fn pid_with_impls(ids: ProtoIds, impls: [ProtoImplReg], root: String) : ProtoIds =
  ProtoIds { ...ids, impls: pid_index_impls(impls, IdLeaf) }

fn pid_index_impls(impls: [ProtoImplReg], t: IdTree[ProtoImplReg]) : IdTree[ProtoImplReg] = match impls {
  [] -> t
  [p, ...rest] -> match p {
    PIR(_, _, _, f, _, _, _) -> pid_index_impls(rest, idt_put(t, sym_raw(f), p))
  }
}

# The first row put under a key keeps it.
fn idt_put(t: IdTree[a], k: Int, v: a) : IdTree[a] = match t {
  IdLeaf -> IdNode(IdLeaf, k, v, IdLeaf)
  IdNode(l, nk, nv, r) ->
    if k < nk { IdNode(idt_put(l, k, v), nk, nv, r) }
    else if k > nk { IdNode(l, nk, nv, idt_put(r, k, v)) }
    else { t }
}

fn idt_get(t: IdTree[a], k: Int) : Option[a] = match t {
  IdLeaf -> None
  IdNode(l, nk, nv, r) ->
    if k < nk { idt_get(l, k) }
    else if k > nk { idt_get(r, k) }
    else { Some(nv) }
}

#[doc("The name a dispatcher is declared with: emission text, and what a reference to it is written as.")]
pub fn disp_name(d: DispInfo) : String = match d { DispInfo(n, _, _, _, _) -> n }

#[doc("The operation a dispatcher stands for.")]
pub fn disp_op(d: DispInfo) : String = match d { DispInfo(_, op, _, _, _) -> op }

#[doc("The home of a dispatcher and of the protocols that share it; `None` for the root file.")]
pub fn disp_home(d: DispInfo) : Option[String] = match d { DispInfo(_, _, h, _, _) -> h }

#[doc("The arity of the operation a dispatcher stands for.")]
pub fn disp_arity(d: DispInfo) : Int = match d { DispInfo(_, _, _, a, _) -> a }

#[doc("True when only the protocols of the dispatcher's home answer it.")]
pub fn disp_homed(d: DispInfo) : Bool = match d { DispInfo(_, _, _, _, h) -> h }

#[doc("The homed twin of the dispatcher `s`, or `None` when it has none: `s` is no dispatcher, or one of the root file.")]
pub fn pid_homed_twin(ids: ProtoIds, s: SymId) : Option[SymId] =
  if sym_raw(s) < 0 { None } else { idt_get(ids.homed, sym_raw(s)) }

#[doc("What the lowering recorded of the dispatcher whose id is `s`, or `None` when `s` is any other symbol.")]
pub fn pid_disp(ids: ProtoIds, s: SymId) : Option[DispInfo] =
  if sym_raw(s) < 0 { None } else { idt_get(ids.disps, sym_raw(s)) }

#[doc("The registry entry of the impl method whose id is `s`, or `None` when `s` is any other symbol.")]
pub fn pid_impl(ids: ProtoIds, s: SymId) : Option[ProtoImplReg] =
  if sym_raw(s) < 0 { None } else { idt_get(ids.impls, sym_raw(s)) }

#[doc("True when `s` is the id of a dispatcher.")]
pub fn pid_is_disp(ids: ProtoIds, s: SymId) : Bool = match pid_disp(ids, s) {
  Some(_) -> true
  None    -> false
}

#[doc("True when `s` is the id of an impl method.")]
pub fn pid_is_impl(ids: ProtoIds, s: SymId) : Bool = match pid_impl(ids, s) {
  Some(_) -> true
  None    -> false
}

fn pid_no_disp(ids: ProtoIds) : Bool = match ids.disps {
  IdLeaf -> true
  _      -> false
}

#[doc("The dispatcher the qualified reference `m.name` names, or `None`: the function of that name the module `m` declares, when it is one.")]
pub fn pid_qualified_disp(ids: ProtoIds, m: Written, name: Written) : Option[DispInfo] =
  if pid_no_disp(ids) { None } else { pid_disp(ids, sym_derive(NCFn, written_text(name), written_text(m))) }

#[doc("True when the qualified reference `m.name` names a dispatcher.")]
pub fn pid_qualified_is_disp(ids: ProtoIds, m: Written, name: Written) : Bool = match pid_qualified_disp(ids, m, name) {
  Some(_) -> true
  None    -> false
}

#[doc("The dispatcher a bare reference names by its id; `None` for anything else.")]
pub fn pid_bare_disp(ids: ProtoIds, f: Expr) : Option[DispInfo] = match f.kind {
  ESym(s, _) -> pid_disp(ids, s)
  _          -> None
}

#[doc("The dispatcher a reference names, bare or qualified; `None` for anything else.")]
pub fn pid_ref_disp(ids: ProtoIds, f: Expr) : Option[DispInfo] = match f.kind {
  EModCall(m, n) -> pid_qualified_disp(ids, m, n)
  _              -> pid_bare_disp(ids, f)
}

#[doc("The id of the dispatcher of the operation `op` the protocol `proto` declares, or `None` when it declares none.")]
pub fn pid_op_disp(ids: ProtoIds, proto: SymId, op: String) : Option[SymId] =
  if sym_raw(proto) < 0 { None } else { pid_op_in(ids, ids.shared, proto, op) }

fn pid_op_in(ids: ProtoIds, ps: [ProtoDisp], proto: SymId, op: String) : Option[SymId] = match ps {
  [] -> None
  [ProtoDisp(p, s), ...rest] ->
    if sym_raw(p) == sym_raw(proto) and pid_stands_for(ids, s, op) { Some(s) } else { pid_op_in(ids, rest, proto, op) }
}

fn pid_stands_for(ids: ProtoIds, s: SymId, op: String) : Bool = match pid_disp(ids, s) {
  Some(d) -> disp_op(d) == op
  None    -> false
}

#[doc("The id of the dispatcher of the operation `op` at arity `arity` the protocol `proto` declares, or `None` when it declares none.")]
pub fn pid_op_disp_at(ids: ProtoIds, proto: SymId, op: String, arity: Int) : Option[SymId] =
  if sym_raw(proto) < 0 { None } else { pid_op_at(ids, ids.shared, proto, op, arity) }

fn pid_op_at(ids: ProtoIds, ps: [ProtoDisp], proto: SymId, op: String, arity: Int) : Option[SymId] = match ps {
  [] -> None
  [ProtoDisp(p, s), ...rest] ->
    if sym_raw(p) == sym_raw(proto) and pid_stands_at(ids, s, op, arity) { Some(s) } else { pid_op_at(ids, rest, proto, op, arity) }
}

fn pid_stands_at(ids: ProtoIds, s: SymId, op: String, arity: Int) : Bool = match pid_disp(ids, s) {
  Some(d) -> disp_op(d) == op and disp_arity(d) == arity
  None    -> false
}

#[doc("A bare reference to the dispatcher `s`, born with its id; `None` when `s` is no dispatcher.")]
pub fn pid_disp_ref(ids: ProtoIds, s: SymId) : Option[ExprKind] = match pid_disp(ids, s) {
  Some(_) -> Some(ESym(s, spec_none()))
  None    -> None
}

#[doc("A reference to the dispatcher `s` that only its home's protocols answer: its homed twin, born with its id. The dispatcher itself for one of the root file, which has no twin. `None` when `s` is no dispatcher.")]
pub fn pid_disp_homed_ref(ids: ProtoIds, s: SymId) : Option[ExprKind] = match pid_homed_twin(ids, s) {
  Some(t) -> Some(ESym(t, spec_none()))
  None    -> pid_disp_ref(ids, s)
}

#[doc("A bare reference to the dispatcher of the operation `op` the protocol `proto` declares, or `None` when it declares none.")]
pub fn pid_op_ref(ids: ProtoIds, proto: SymId, op: String) : Option[ExprKind] = match pid_op_disp(ids, proto, op) {
  Some(s) -> pid_disp_ref(ids, s)
  None    -> None
}

#[doc("What the typer reads of the protocol registry: the impl entries, and the generated functions by id.")]
pub type ProtoView = { impls: [ProtoImplReg], ids: ProtoIds }

#[doc("The view of a program with no protocol.")]
pub fn pv_empty() : ProtoView = ProtoView { impls: [], ids: pid_empty() }

#[doc("The typer's view of the registry `reg`.")]
pub fn pv_of(reg: ProtocolReg) : ProtoView = ProtoView { impls: reg.impls, ids: reg.ids }
