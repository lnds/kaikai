#[doc("""
Brands: the state the nursery-capability rewrite threads, the binders in scope with their brand, and the diagnostics of a brand used opaquely.
""")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.ast_ids
import compiler.brand_transp
import compiler.core_types
import compiler.written
import compiler.symtab

# A brand record carries everything `--dump-brands` and the brand-
# mismatch diagnostic need to surface. `bid` is the unique brand id;
# `cap_name` is the source-level name the user wrote (`n`, `outer`,
# etc.); `file/line/col` point at the lambda's `{` token (where the
# cap binder appears).
#[doc("A minted nursery brand (brand id, cap name, file, line, col) produced by the cap-binding rewrite.")]
pub(pkg) type BrandRec = BR(Int, String, String, Int, Int)

# Per-call attribution: every `n.<op>(args)` rewritten by this pass
# records its (file, line, col, brand_id, op_name) so the post-rewrite
# brand-mismatch check can tell which scope each call belongs to. The
# same registry feeds `--dump-brands`.
#[doc("A recorded nursery-cap consume site (file, line, col, brand id, op name) for brand-mismatch checking.")]
pub(pkg) type BrandCall = BC(String, Int, Int, Int, String)

# Lookup: did this call get rewritten by the cap-binding pass?
# Returns `Some((bid, op_name))` keyed on (file, line, col).
fn brand_call_lookup(calls: [BrandCall], file: String,
                       line: Int, col: Int) : Option[BrandCall] {
  match calls {
    [] -> None
    [c, ...rest] -> match c {
      BC(cf, cl, cc, _, _) ->
        if cf == file and cl == line and cc == col { Some(c) }
        else { brand_call_lookup(rest, file, line, col) }
    }
  }
}

#[doc("The record of the brand `bid`.")]
pub(pkg) fn brand_rec_lookup(brs: [BrandRec], bid: Int) : Option[BrandRec] {
  match brs {
    [] -> None
    [b, ...rest] -> match b {
      BR(b_id, _, _, _, _) ->
        if b_id == bid { Some(b) } else { brand_rec_lookup(rest, bid) }
    }
  }
}

pub(pkg) type BrandBinding = BB(LocalId, Int)

#[doc("""
The bindings plus the program-wide brand-transparency table, which
`expr_brand` consults to follow a brand through a pass-through
helper call.
""")]
pub(pkg) type BrandEnv = BEnv([BrandBinding], BrandTranspIndex, SymTab)

#[doc("An environment with no binding, the brand-transparency table `ts` and the table `tab` that names the functions it summarises.")]
pub(pkg) fn benv_with_transp(ts: BrandTranspIndex, tab: SymTab) : BrandEnv = BEnv([], ts, tab)

fn benv_transp(e: BrandEnv) : BrandTranspIndex {
  match e { BEnv(_, ts, _) -> ts }
}

fn benv_tab(e: BrandEnv) : SymTab {
  match e { BEnv(_, _, tab) -> tab }
}

fn benv_push(e: BrandEnv, l: LocalId, bid: Int) : BrandEnv {
  match e { BEnv(xs, ts, tab) -> BEnv([BB(l, bid), ...xs], ts, tab) }
}

fn benv_lookup(e: BrandEnv, l: LocalId) : Option[Int] {
  match e { BEnv(xs, _, _) -> benv_lookup_loop(xs, l) }
}

fn benv_lookup_loop(xs: [BrandBinding], l: LocalId) : Option[Int] {
  match xs {
    [] -> None
    [h, ...rest] -> match h {
      BB(n, b) -> if local_eq(n, l) { Some(b) } else { benv_lookup_loop(rest, l) }
    }
  }
}

#[doc("""
Look up the brand attribution of an expression. Recognises:
  - A rewritten `Spawn.spawn(args)` call (looks the call up in
    the registry by line:col).
  - A bare `EName(name)` binding (looks `name` up in the env).
  - Otherwise the expression has no brand attribution.

Returns `Some(bid)` when the brand can be determined statically.
The `None` case is intentionally permissive — a fiber that lost
its brand through a non-let path (e.g., a list element retrieved
by index, a record field) is treated as unbranded.
""")]
pub(pkg) fn expr_brand(e: Expr, env: BrandEnv, calls: [BrandCall]) : Option[Int] {
  match e.kind {
    ELocal(l) -> benv_lookup(env, l)
    ECall(callee, args_) -> match callee.kind {
      EField(base, op_name) -> match base.kind {
        ESym(eff_sym, _) ->
          if effect_is(eff_sym, CeSpawn) and op_name == "spawn" {
            match brand_call_lookup(calls, "", e.line, e.col) {
              Some(BC(_, _, _, bid, _)) -> Some(bid)
              # The registry stores file as recorded at rewrite. Try
              # without filtering on file (the brand check runs per
              # decl, all from the same source file).
              None -> brand_call_first_at(calls, e.line, e.col)
            }
          } else { None }
        _ -> None
      }
      # A call to a brand-transparent helper carries the brand of the
      # argument it returns, so `let g = id(f)` keeps `f`'s brand.
      ESym(f, _) -> transp_call_brand(f, args_, env, calls)
      _ -> None
    }
    _ -> None
  }
}

fn transp_call_brand(fname: SymId, args_: [Expr], env: BrandEnv,
                       calls: [BrandCall]) : Option[Int] {
  match brand_transp_lookup(benv_transp(env), fname) {
    None -> None
    Some(t) -> match transp_passthrough_arg(t, args_) {
      None -> None
      Some(arg) -> expr_brand(arg, env, calls)
    }
  }
}

#[doc("""
Match a call by (line, col) regardless of file — every call in
the registry comes from the file currently being checked.
""")]
pub(pkg) fn brand_call_first_at(calls: [BrandCall], line: Int, col: Int) : Option[Int] {
  match calls {
    [] -> None
    [c, ...rest] -> match c {
      BC(_, cl, cc, bid, _) ->
        if cl == line and cc == col { Some(bid) }
        else { brand_call_first_at(rest, line, col) }
    }
  }
}

# `--dump-brands`: print the brand registry plus per-call
# attributions in a deterministic, grep-friendly form. Mirrors
# `--dump-intervals`'s shape (one record per line, fixed column
# order) so fixtures can pin the output as a golden file.
#[doc("Debug dump of the nursery brand registry and call sites (driven by a dump flag in the driver).")]
pub(pkg) fn dump_brands(brs: [BrandRec], calls: [BrandCall]) : Unit / Console {
  print("# kaic2 --dump-brands")
  print("# brand allocations (one per `nursery { n -> ... }` site):")
  dump_brand_recs(brs)
  print("# call attributions (one per rewritten `n.<op>` site):")
  dump_brand_calls(calls)
}

fn dump_brand_recs(brs: [BrandRec]) : Unit / Console {
  match brs {
    [] -> ()
    [b, ...rest] -> match b {
      BR(bid, name, file, line, col) -> {
        print(concat_all(["brand ", int_to_string(bid),
                            " cap=", name,
                            " at=", file, ":",
                            int_to_string(line), ":",
                            int_to_string(col)]))
        dump_brand_recs(rest)
      }
    }
  }
}

fn dump_brand_calls(calls: [BrandCall]) : Unit / Console {
  match calls {
    [] -> ()
    [c, ...rest] -> match c {
      BC(file, line, col, bid, op_name) -> {
        print(concat_all(["call op=", op_name,
                            " brand=", int_to_string(bid),
                            " at=", file, ":",
                            int_to_string(line), ":",
                            int_to_string(col)]))
        dump_brand_calls(rest)
      }
    }
  }
}

#[doc("""
A branded fiber flowing into a call the checker cannot follow is
where brand tracking ends. Saying so turns a silent false negative
into an announced one: sibling-nursery misuse past this point is
not detected. Brand-transparent helpers are followed, so they do
not warn.
""")]
pub(pkg) fn warn_brand_opaque_call(callee: Expr, args_: [Expr], env: BrandEnv,
                            file: String, calls: [BrandCall],
                            brs: [BrandRec], acc: [Diagnostic]) : [Diagnostic] / Console + File {

  match callee.kind {
    ESym(f, _) -> match brand_transp_lookup(benv_transp(env), f) {
      Some(BTParam(_)) -> acc
      _ -> warn_branded_args(written_text(decl_name(benv_tab(env), f)), args_, env, file, calls, brs, acc)
    }
    _ -> acc
  }
}

fn warn_branded_args(fname: String, args_: [Expr], env: BrandEnv,
                       file: String, calls: [BrandCall],
                       brs: [BrandRec], acc: [Diagnostic]) : [Diagnostic] / Console + File {

  match args_ {
    [] -> acc
    [a, ...rest] -> {
      let acc1 = match expr_brand(a, env, calls) {
        Some(bid) -> [emit_brand_opaque_warning(file, a.line, a.col, bid, fname, brs), ...acc]
        None -> acc
      }
      warn_branded_args(fname, rest, env, file, calls, brs, acc1)
    }
  }
}

fn emit_brand_opaque_warning(file: String, line: Int, col: Int, bid: Int,
                               fname: String, brs: [BrandRec]) : Diagnostic / Console + File {

  let note = match brand_rec_lookup(brs, bid) {
    Some(BR(_, name, bf, bl, bc)) ->
      [ri_note(file, line, col, concat_all(["fiber carries brand from nursery `", name,
                                "` at ", bf, ":", int_to_string(bl), ":", int_to_string(bc)]))]
    None -> []
  }
  let help = ri_help(file, line, col, concat_all(["`", fname,
    "` does not return one of its parameters unchanged, so sibling-nursery misuse of the result is not detected"]))
  let d = mk_diag(SevWarning, file, line, col,
    concat_all(["branded fiber escapes brand tracking through `", fname, "`"]), [...note, help])
  render_diag(d)
  d
}

#[doc("The operation of the call recorded at `line:col`, empty when none is.")]
pub(pkg) fn call_op_name(calls: [BrandCall], line: Int, col: Int) : String {
  match calls {
    [] -> ""
    [c, ...rest] -> match c {
      BC(_, cl, cc, _, op) ->
        if cl == line and cc == col { op } else { call_op_name(rest, line, col) }
    }
  }
}

#[doc("""
Statement walk. SLet propagates brand attribution from RHS to
the bound name when the RHS expression has a brand. Other
binders (SVar, lambda params, match patterns) do not carry
brands today.
""")]
pub(pkg) type BrandStmtsRes = { env: BrandEnv, errs: [Diagnostic] }

#[doc("""
Bind a pattern's name(s) with brand attribution lifted from the
RHS. Today only PBind directly carries the brand; other patterns
strip the brand (matches consumer behaviour).
""")]
pub(pkg) fn bind_brand_pat(pat: Pattern, rhs: Expr, env: BrandEnv,
                    calls: [BrandCall]) : BrandEnv {
  match pat.pkind {
    PBind(n) -> match expr_brand(rhs, env, calls) {
      Some(bid) -> benv_push(env, n.id, bid)
      None -> env
    }
    _ -> env
  }
}

# Set of Spawn ops legal on a NurseryCap. Mirrors the `Spawn` effect
# in stdlib/effects/concurrent.kai. Update both lists in lockstep when
# a new Spawn op lands.
fn nursery_cap_op_names() : [String] =
  ["spawn", "await", "select", "cancel", "yield", "set_trap_exit", "cancel_all"]

#[doc("True when `name` is an operation a nursery capability offers.")]
pub(pkg) fn is_nursery_cap_op(name: String) : Bool =
  list_has(nursery_cap_op_names(), name)

#[doc("The active cap binders, innermost first, and the `nursery` function a call must name to bind one.")]
pub(pkg) type NCapStack = NCS([NCapBinding], SymId)
pub(pkg) type NCapBinding = NCB(LocalId, Int)   # (cap binder, brand_id)

#[doc("A stack with no capability binder, whose capabilities are bound by calls of `nursery`.")]
pub(pkg) fn ncs_empty(nursery: SymId) : NCapStack = NCS([], nursery)

#[doc("`s` with the binder `l` of brand `bid` innermost.")]
pub(pkg) fn ncs_push(s: NCapStack, l: LocalId, bid: Int) : NCapStack {
  match s { NCS(xs, n) -> NCS([NCB(l, bid), ...xs], n) }
}

#[doc("True when `f` is the `nursery` function the stack binds capabilities for.")]
pub(pkg) fn ncs_is_nursery(s: NCapStack, f: SymId) : Bool = match s { NCS(_, n) -> sym_raw(n) >= 0 and sym_same(n, f) }

#[doc("The innermost active brand id of the binder `l`, or None.")]
pub(pkg) fn ncs_lookup(s: NCapStack, l: LocalId) : Option[Int] {
  match s { NCS(xs, _) -> ncs_lookup_loop(xs, l) }
}

fn ncs_lookup_loop(xs: [NCapBinding], l: LocalId) : Option[Int] {
  match xs {
    [] -> None
    [h, ...rest] -> match h {
      NCB(n, b) -> if local_eq(n, l) { Some(b) } else { ncs_lookup_loop(rest, l) }
    }
  }
}

#[doc("""
The walker threads a brand counter so each visit produces a fresh
id. Side-effecting registry accumulation happens by returning the
growing list alongside the rewritten expression. `calls` records
per-call attributions so the post-rewrite brand-mismatch check can
tell which scope each `Spawn.<op>` call originated in.
""")]
pub(pkg) type BrandWalk = { bnext: Int, registry: [BrandRec], calls: [BrandCall] }

pub(pkg) type BrandAlloc = { bw: BrandWalk, bid: Int }

#[doc("A fresh brand for the binder `name`, recorded in the walk.")]
pub(pkg) fn bw_alloc(bw: BrandWalk, name: String, file: String,
             line: Int, col: Int) : BrandAlloc {
  let bid = bw.bnext
  BrandAlloc { bw: BrandWalk { bnext: bid + 1,
                    registry: [BR(bid, name, file, line, col),
                                ...bw.registry],
                    calls: bw.calls },
                bid: bid }
}

#[doc("The walk with the call at `line:col` attributed to the brand `bid`.")]
pub(pkg) fn bw_record_call(bw: BrandWalk, file: String, line: Int, col: Int,
                   bid: Int, op_name: String) : BrandWalk {
  BrandWalk { bnext: bw.bnext,
              registry: bw.registry,
              calls: [BC(file, line, col, bid, op_name), ...bw.calls] }
}

#[doc("A rewritten expression and the walk after it.")]
pub(pkg) type NurseryRwExpr = { expr: Expr, bw: BrandWalk }

#[doc("A rewritten expression kind and the walk after it.")]
pub(pkg) type NurseryRwKind = { kind: ExprKind, bw: BrandWalk }

#[doc("Rewritten expressions and the walk after them.")]
pub(pkg) type NurseryRwExprs   = { exprs: [Expr], bw: BrandWalk }
#[doc("A rewritten optional expression and the walk after it.")]
pub(pkg) type NurseryRwOpt     = { expr: Option[Expr], bw: BrandWalk }
#[doc("Rewritten statements, the capability stack they leave, and the walk after them.")]
pub(pkg) type NurseryRwStmts   = { stmts: [Stmt], s: NCapStack, bw: BrandWalk }
#[doc("Rewritten arms and the walk after them.")]
pub(pkg) type NurseryRwArms    = { arms: [Arm], bw: BrandWalk }
#[doc("Rewritten handler clauses and the walk after them.")]
pub(pkg) type NurseryRwClauses = { clauses: [HClause], bw: BrandWalk }
#[doc("A rewritten handler return and the walk after it.")]
pub(pkg) type NurseryRwRet     = { ret: Option[HReturn], bw: BrandWalk }
#[doc("Rewritten field initialisers and the walk after them.")]
pub(pkg) type NurseryRwFields  = { fields: [FieldInit], bw: BrandWalk }
#[doc("Rewritten list elements and the walk after them.")]
pub(pkg) type NurseryRwElems   = { elems: [ListElem], bw: BrandWalk }

#[doc("An argument list split at its last argument.")]
pub(pkg) type SplitLast = NoLast | HasLast([Expr], Expr)

#[doc("`args_` as all but the last argument, and the last.")]
pub(pkg) fn split_last_arg(args_: [Expr]) : SplitLast {
  match args_ {
    [] -> NoLast
    _  -> split_last_loop(args_, [])
  }
}

fn split_last_loop(args_: [Expr], acc: [Expr]) : SplitLast {
  match args_ {
    [] -> NoLast
    [h] -> HasLast(list_reverse(acc), h)
    [h, ...rest] -> split_last_loop(rest, [h, ...acc])
  }
}
