#[doc("""
Whether the holes of an interpolated string read a capability, scanned
over its source span.
""")]



# Scan a string-literal source span (quotes included) for a naked
# `name` cell-read inside any `#{...}` interpolation region. The interp
# body is not parsed at this pre-resolve stage, so the structural escape
# walk cannot see the read that `desugar_interp_decls` will later lift,
# and that the post-interp cell-read lowering will turn into
# `name.get()`. A pure lexical scan over the interp regions is enough —
# a match disables the array-slot specialisation and keeps the canonical
# `State[T] as name` handler (always correct, just less optimised), so
# the lifted `name.get()` still has the `as name` binder to resolve
# against. False positives only cost the cheaper lowering, never
# correctness, so the scan stays conservative.
pub fn interp_span_reads_cap(span: String, is_triple: Bool, name: String) : Bool {
  let n = string_length(span)
  let body_start = if is_triple { 3 } else { 1 }
  let body_end = if is_triple { n - 3 } else { n - 1 }
  if body_end <= body_start { false }
  else { icap_scan(span, body_start, body_end, name) }
}

# Walk the literal body looking for an interpolation opener `#{`. On a
# hit, scan the brace-balanced interp region for a naked `name`;
# otherwise advance one char. Mirrors `iscan_collect`'s opener detection
# without importing fnreg (which would form a desugar↔infer cycle).
fn icap_scan(span: String, i: Int, end: Int, name: String) : Bool {
  if i + 1 >= end { false }
  else {
    match char_at(span, i) {
      Some(c) -> {
        let nxt = match char_at(span, i + 1) { Some(c2) -> c2  None -> ' ' }
        if c == '#' and nxt == '{' {
          let expr_start = i + 2
          let expr_end = icap_expr_end(span, expr_start, end, 1)
          if icap_region_reads(span, expr_start, expr_end, name) { true }
          else {
            let next_i = if expr_end < end { expr_end + 1 } else { expr_end }
            icap_scan(span, next_i, end, name)
          }
        } else { icap_scan(span, i + 1, end, name) }
      }
      None -> false
    }
  }
}

# Return the index OF the `}` that closes an interp opened at `depth`.
# Mirrors `iscan_expr_end` in fnreg.kai — the closing brace at depth 1
# returns its own index, so the caller's `expr_end + 1` lands on the char
# after `}`. Returning `i + 1` here would overshoot by one and, for two
# adjacent `#{...}#{...}` regions, skip the opener of the second.
fn icap_expr_end(span: String, i: Int, end: Int, depth: Int) : Int {
  if depth == 0 or i >= end { i }
  else {
    match char_at(span, i) {
      Some(c) ->
        if c == '{' { icap_expr_end(span, i + 1, end, depth + 1) }
        else if c == '}' {
          if depth == 1 { i } else { icap_expr_end(span, i + 1, end, depth - 1) }
        }
        else { icap_expr_end(span, i + 1, end, depth) }
      None -> i
    }
  }
}

# True when a naked `name` cell-read appears in [start, end), delimited
# on both sides so `tallyx`/`xtally` do not match a read of `tally`. The
# char before must not be an identifier continuation (so `mytally` is
# skipped); the char after is checked by `dsg_matches_at`. A false
# positive (e.g. a field `r.tally` after a `.`) only forces the safe
# canonical handler, never miscompiles.
fn icap_region_reads(span: String, i: Int, end: Int, name: String) : Bool {
  if i >= end { false }
  else {
    let prev_cont = if i == 0 { false }
                    else { match char_at(span, i - 1) {
                      Some(pc) -> dsg_ident_cont(pc)  None -> false } }
    if not prev_cont and dsg_matches_at(span, i, end, name) { true }
    else { icap_region_reads(span, i + 1, end, name) }
  }
}

# True when `name` occurs at index `i` of `span` (bounded by `end`) and
# the character right after it is not an identifier continuation, so
# `tally` matches `tally` but not the prefix of `tallyx`.
fn dsg_matches_at(span: String, i: Int, end: Int, name: String) : Bool {
  let nn = string_length(name)
  if i + nn > end { false }
  else if not dsg_substr_eq(span, i, name, 0, nn) { false }
  else {
    match char_at(span, i + nn) {
      None    -> true
      Some(c) -> not dsg_ident_cont(c)
    }
  }
}

fn dsg_substr_eq(span: String, si: Int, name: String, ni: Int, nn: Int) : Bool {
  if ni >= nn { true }
  else { match char_at(span, si) {
    None -> false
    Some(sc) -> match char_at(name, ni) {
      None -> true
      Some(nc) -> if sc == nc { dsg_substr_eq(span, si + 1, name, ni + 1, nn) } else { false }
    }
  } }
}

# Identifier continuation: a letter, digit, or underscore. Kept local
# so the scan does not pull in compiler.chars.
fn dsg_ident_cont(c: Char) : Bool =
  (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or
  (c >= '0' and c <= '9') or c == '_'
