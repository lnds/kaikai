#[doc("""
How an owned match lets go of its scrutinee in each arm.

An arm binder is bound with a reference of its own while the scrutinee's
cell keeps its reference to the same value until the match ends, so inside
the arm no binder is unique and a write through one copies. Under a flat
constructor pattern every binder owns its value once bound, and the arm
reads the cell again only to rebuild into it.

When it does not, the arm takes the cell apart as it starts: a sole owner
hands its children to the binders and frees the shell alone, with no dup
and no cascade; a shared cell dups what the arm bound and loses one
reference. An arm that cannot take the cell apart still drops it first
when it hands a binder on. Both emitters ask here.
""")]

import compiler.ast
import compiler.ctor_ix
import compiler.emit_shared
import compiler.expr_exists
import compiler.kir_pat_alias
import compiler.perceus_reads
import compiler.trmc_exit_drops

#[doc("Where one arm of an owned match releases the scrutinee: at the exit of the match, by a drop as the arm starts, or taken apart as the arm starts.")]
pub type ScrRelease = ScrKept | ScrFreed | ScrTaken

#[doc("What taking a cell apart needs: the binders of its pointer slots, its slot kinds, and the mask of the pointer slots no binder took.")]
pub type ArmTake = ArmTake([Binder], [Int], Int)

#[doc("How the arm `pat -> body` of an owned match releases its scrutinee. `may_take` is false where the cell cannot be taken apart: behind a guard, which may still reject the arm, or inside a region.")]
pub fn arm_release(pat: Pattern, body: Expr, may_take: Bool) : ScrRelease = match pat.pkind {
  PVariant(_, subs) ->
    if arl_flat(subs) and not xp_exists(body, false, arl_needs_cell) { arl_how(subs, body, may_take) }
    else { ScrKept }
  _ -> ScrKept
}

#[doc("True when `r` leaves the scrutinee to the exit of the match.")]
pub fn scr_kept(r: ScrRelease) : Bool = match r {
  ScrKept -> true
  _       -> false
}

#[doc("The plan to take apart the cell a flat constructor pattern matched.")]
pub fn arm_take_plan(pat: Pattern, ix: CtorIx) : ArmTake = match pat.pkind {
  PVariant(_, subs) -> arl_plan(subs, arl_kinds(pat_slot_kinds(pat, ix)))
  _                 -> ArmTake([], [], 0)
}

# An unknown constructor stores every slot as a pointer.
fn arl_kinds(ks: Option[[Int]]) : [Int] = match ks {
  Some(xs) -> xs
  None     -> []
}

fn arl_plan(subs: [Pattern], ks: [Int]) : ArmTake =
  ArmTake(arl_ptr_binders(subs, ks, 0), ks, arl_mask(subs, ks, 0, 1))

fn arl_ptr_binders(subs: [Pattern], ks: [Int], i: Int) : [Binder] = match subs {
  []           -> []
  [p, ...rest] -> match p.pkind {
    PBind(b) -> if kind_at(ks, i) == 0 { [b, ...arl_ptr_binders(rest, ks, i + 1)] } else { arl_ptr_binders(rest, ks, i + 1) }
    _        -> arl_ptr_binders(rest, ks, i + 1)
  }
}

# One bit per slot: `bit` is the bit of slot `i`.
fn arl_mask(subs: [Pattern], ks: [Int], i: Int, bit: Int) : Int = match subs {
  []           -> 0
  [p, ...rest] -> match p.pkind {
    PWild -> (if kind_at(ks, i) == 0 { bit } else { 0 }) + arl_mask(rest, ks, i + 1, 2 * bit)
    _     -> arl_mask(rest, ks, i + 1, 2 * bit)
  }
}

fn arl_flat(subs: [Pattern]) : Bool = match subs {
  []           -> true
  [p, ...rest] -> match p.pkind {
    PBind(_) -> arl_flat(rest)
    PWild    -> arl_flat(rest)
    _        -> false
  }
}

# The mask holds one bit per slot, and a take with no binder gains nothing.
fn arl_how(subs: [Pattern], body: Expr, may_take: Bool) : ScrRelease =
  if may_take and list_length(subs) <= 30 and arl_binds(subs) { ScrTaken }
  else if arl_hands_on(subs, txd_wrap_drops(body)) { ScrFreed }
  else { ScrKept }

fn arl_binds(subs: [Pattern]) : Bool = match subs {
  []           -> false
  [p, ...rest] -> match p.pkind {
    PBind(_) -> true
    _        -> arl_binds(rest)
  }
}

# Some binder is not among the arm's own exit drops.
fn arl_hands_on(subs: [Pattern], drops: [Stmt]) : Bool = match subs {
  []           -> false
  [p, ...rest] -> arl_handed(p, drops) or arl_hands_on(rest, drops)
}

fn arl_handed(p: Pattern, drops: [Stmt]) : Bool = match p.pkind {
  PBind(b) -> not arl_dropped(b, drops)
  _        -> false
}

fn arl_dropped(b: Binder, drops: [Stmt]) : Bool = match drops {
  []           -> false
  [s, ...rest] -> any(stmt_exprs(s), (x) => pcs_mentions(b, x)) or arl_dropped(b, rest)
}

fn arl_needs_cell(e: Expr) : Bool = match e.kind {
  EMark(MkScrutinee) -> true
  EMark(MkTrmcApply) -> true
  ECall(f, _)        -> arl_steps(f)
  _                  -> false
}

fn arl_steps(f: Expr) : Bool = match f.kind {
  EMark(MkTrmcStep(_)) -> true
  _                    -> false
}
