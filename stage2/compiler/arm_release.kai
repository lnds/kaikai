#[doc("""
Whether an owned match hands its scrutinee back as an arm starts.

An arm binder is bound with a reference of its own while the scrutinee's
cell keeps its reference to the same value until the match ends, so inside
the arm no binder is unique and a write through one copies. Under a flat
constructor pattern every binder owns its value once bound, and the arm
reads the cell again only to rebuild into it. When it does not, the match
releases the cell before the body runs. Both emitters ask here.
""")]

import compiler.ast
import compiler.emit_shared
import compiler.expr_exists
import compiler.perceus

#[doc("True when the body of an arm never needs the scrutinee's cell: `pat` is a constructor over plain binders, and `body` neither rebuilds into the cell nor steps a modulo-cons loop through it.")]
pub fn arm_frees_scrutinee(pat: Pattern, body: Expr) : Bool = match pat.pkind {
  PVariant(_, _, subs) -> arl_flat(subs, false) and not xp_exists(body, false, arl_needs_cell)
  _                    -> false
}

# Plain binders and wildcards, with a binder among them.
fn arl_flat(subs: [Pattern], bound: Bool) : Bool = match subs {
  []           -> bound
  [p, ...rest] -> match p.pkind {
    PBind(_) -> arl_flat(rest, true)
    PWild    -> arl_flat(rest, bound)
    _        -> false
  }
}

fn arl_needs_cell(e: Expr) : Bool = match e.kind {
  EMark(MkScrutinee) -> true
  EMark(MkTrmcApply) -> true
  ECall(f, _)        -> arl_steps(f)
  _                  -> false
}

# A step sentinel is a bare callee; no other callee's key is built.
fn arl_steps(f: Expr) : Bool = match f.kind {
  EVar(_) -> es_trmc_is_step_sentinel(pcs_callee_key(f))
  _       -> false
}
