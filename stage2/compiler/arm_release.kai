#[doc("""
Whether an owned match hands its scrutinee back as an arm starts.

An arm binder is bound with a reference of its own while the scrutinee's
cell keeps its reference to the same value until the match ends, so inside
the arm no binder is unique and a write through one copies. Under a flat
constructor pattern every binder owns its value once bound, and the arm
reads the cell again only to rebuild into it. When it does not, and it
hands a binder on, the match releases the cell before the body runs.

An arm that releases every binder itself hands none on: an early release
would gain nothing, and each child would die by a release of its own
instead of inside the cell's. Both emitters ask here.
""")]

import compiler.ast
import compiler.emit_shared
import compiler.expr_exists
import compiler.perceus
import compiler.perceus_reads
import compiler.trmc_exit_drops

#[doc("True when the body of an arm gains from an early release of the scrutinee and never needs its cell: `pat` is a constructor over plain binders, `body` leaves one of them to a consumer, and it neither rebuilds into the cell nor steps a modulo-cons loop through it.")]
pub fn arm_frees_scrutinee(pat: Pattern, body: Expr) : Bool = match pat.pkind {
  PVariant(_, _, subs) ->
    arl_flat(subs) and arl_hands_on(subs, txd_wrap_drops(body)) and not xp_exists(body, false, arl_needs_cell)
  _ -> false
}

fn arl_flat(subs: [Pattern]) : Bool = match subs {
  []           -> true
  [p, ...rest] -> match p.pkind {
    PBind(_) -> arl_flat(rest)
    PWild    -> arl_flat(rest)
    _        -> false
  }
}

# Some binder is not among the arm's own exit drops.
fn arl_hands_on(subs: [Pattern], drops: [Stmt]) : Bool = match subs {
  []           -> false
  [p, ...rest] -> arl_handed(p, drops) or arl_hands_on(rest, drops)
}

fn arl_handed(p: Pattern, drops: [Stmt]) : Bool = match p.pkind {
  PBind(nm) -> not arl_dropped(nm, drops)
  _         -> false
}

fn arl_dropped(nm: String, drops: [Stmt]) : Bool = match drops {
  []           -> false
  [s, ...rest] -> any(stmt_exprs(s), (x) => pcs_mentions(nm, x)) or arl_dropped(nm, rest)
}

fn arl_needs_cell(e: Expr) : Bool = match e.kind {
  EMark(MkScrutinee) -> true
  EMark(MkTrmcApply) -> true
  ECall(f, _)        -> arl_steps(f)
  _                  -> false
}

# A step sentinel is a bare callee; no other callee's key is built.
fn arl_steps(f: Expr) : Bool = match f.kind {
  EVar(_) -> es_trmc_is_step_sentinel(pcs_callee_key(f))
  _       -> false
}
