#[doc("""
Native declaration environment: references, thunks, module keys and definitions.

What the bodies of a partition's functions reach outside themselves.

A partition's object depends on the declaration of each function it
calls or closes over, on the place of each operation it performs among
its effect's, and on each handler it installs. An indirect call carries
a value and names no symbol. Each reference is kept once, in the order
the bodies name it, so the text built from them is the same for the same
functions.

What a partition's object takes from the declaration of a function, and
its text for a cache key.

A partition defines its own functions and declares every other one. A
declaration is not just a symbol: it fixes the call ABI (the slots of
the signature, and an evidence frame when the function carries one) and
the attributes the optimiser may rely on at each call.

The emitter is handed the `NDeclEnv` the key was read from, so an
object cannot depend on an analysis its key did not see.

The cache key of a native-modular partition.

A partition's object is content-addressed: a hash of the text of
everything it is emitted from. That is the functions it defines, body
and declaration; the declaration of every function they call in another
partition; the operations, in order, of every effect they perform; the
handlers they install; and, for the partition that owns the program's
singletons, the text of those.

Keying on what a partition references, not on the whole program, keeps
the cache incremental: a body edited in one module re-emits that
module's partition alone, and so does a type, since a function's KIR
already spells the layout it uses. Nothing serialised can go stale: the
key text carries the shape of all the object depends on.

compiler/emit_native_def.kai — builtin/default effect-handler install
for the in-process libLLVM native backend. Fills
`kai_main_install_defaults` / `kai_main_teardown_defaults` so a program
that performs a BUILTIN effect (`Stdout.print`, the most common one)
finds its default handler at `main` and runs to parity with the
C-direct oracle.

There is ONE class of default at emit time. The builtin effects
(Stdout/Stderr/Stdin/…) are stdlib source `DEffect` decls
carrying an all-`$extern_handler` `default { }` block, the same shape
a user effect uses (Clock in stdlib/time.kai) — so `kir_default_handlers`
(kir_lower) resolves both through `find_effect_default_block`. The
resulting `[KDefault]` reaches us on `KProgram.defaults`, already in
install order; we never re-walk the AST.

The IR mirrors the C-direct emit (`default_setups_from_block`,
emit_c.kai) and the LLVM-text emit (`lvm_default_install_for_effect`,
emit_llvm.kai), translated to C-API `kai_llvm_build_*`. Per effect:
  - a MODULE-LEVEL Ev blob + KaiEvidence node (NOT entry-block allocas:
    the evidence stays pushed for the whole program, so it must outlive
    this fn's frame — the C-direct oracle uses `static EvStdout` for the
    same reason);
  - `kaix_fresh_handler_id()` stamped into the Ev header (field 0);
  - each op's `kaix_default_<eff>_<op>` forwarder stored at its field
    (`nfx_op_base` + position) via `kaix_ev_set_op`;
  - a `kaix_evidence_init_default_l(node, label, ev)` — NO jmp_buf, because a
    default ALWAYS resumes (no discard landing pad, unlike the user
    handler's `kaix_evidence_push_with_jmp_l` in emit_native_fx2).
Teardown pops in reverse install order so the evidence stack drains LIFO.

SOUNDNESS (handle discipline): every helper here that
returns a `Handle` (an LLVM `Value*`/`GlobalVariable*`) is listed in
stage1's `native_handle_fns()`. The module globals built by
`llvm_add_global_zeroed` are handles too; they are captured in `let`
bindings (the handle-binder exclusion) so kaic1's type-blind Perceus
never `kai_decref`s a raw LLVM pointer.
""")]

import compiler.ast_decl
import compiler.ast_ids
import compiler.effect_instance
import compiler.emit_native_fn
import compiler.emit_native_fx
import compiler.emit_shared_syms
import compiler.fn_index
import compiler.infer_index
import compiler.kir
import compiler.kir_dump
import compiler.kir_syms
import compiler.purity
import compiler.purity_traps
import compiler.spec_names
import compiler.symtab
import compiler.util

#[doc("What a set of functions reaches outside itself, each once and newest first: the symbols called or closed over, the effects performed, the handlers installed. `seen` indexes the symbols.")]
type NRefs = { seen: NameIndex[String], callees: [String], effects: [SymId], installs: [String] }

#[doc("The symbols the bodies of `fns` take as a value, each indexed under itself: a closure's thunk and a cleanup's.")]
fn nrefs_values(fns: [KFn]) : NameIndex[String] = nvals_fns(fns, idx_empty())

#[doc("Whether `sym` is among the symbols `vals` holds.")]
fn nrefs_valued(vals: NameIndex[String], sym: String) : Bool = list_has(idx_chain(vals, sym), sym)

#[doc("`vals` with `sym` held too.")]
fn nrefs_with_value(vals: NameIndex[String], sym: String) : NameIndex[String] =
  if nrefs_valued(vals, sym) { vals } else { idx_prepend(vals, sym, sym) }

fn nvals_fns(fns: [KFn], v: NameIndex[String]) : NameIndex[String] = match fns {
  [] -> v
  [f, ...rest] -> nvals_fns(rest, nvals_blocks(f.blocks, v))
}

fn nvals_blocks(bs: [KBlock], v: NameIndex[String]) : NameIndex[String] = match bs {
  [] -> v
  [b, ...rest] -> nvals_blocks(rest, nvals_stmts(b.stmts, v))
}

fn nvals_stmts(ss: [KStmt], v: NameIndex[String]) : NameIndex[String] = match ss {
  [] -> v
  [s, ...rest] -> nvals_stmts(rest, match s {
    KLet(_, _, KClosure(sym, _, _), _) -> nrefs_with_value(v, sym)
    KDo(KClosure(sym, _, _), _)        -> nrefs_with_value(v, sym)
    KSetCleanup(_, _, thunk, _)        -> nrefs_with_value(v, thunk)
    KLet(_, _, _, _)                   -> v
    KDo(_, _)                          -> v
    KRC(_, _)                          -> v
    KStore(_, _, _)                    -> v
    KInstall(_, _, _, _, _, _)         -> v
    KPop(_, _, _)                      -> v
    KBindEvState(_, _, _, _)           -> v
    KBindSelfState(_, _)               -> v
    KRunCleanup(_, _, _)               -> v
  })
}

#[doc("What the bodies of `fns` reach.")]
fn nrefs_of(fns: [KFn]) : NRefs = nrefs_fns(fns, NRefs { seen: idx_empty(), callees: [], effects: [], installs: [] })

#[doc("Whether the functions `r` was read from call or close over `sym`.")]
fn nrefs_calls(r: NRefs, sym: String) : Bool = list_has(idx_chain(r.seen, sym), sym)

fn nrefs_fns(fns: [KFn], r: NRefs) : NRefs = match fns {
  [] -> r
  [f, ...rest] -> nrefs_fns(rest, nrefs_blocks(f.blocks, r))
}

fn nrefs_blocks(bs: [KBlock], r: NRefs) : NRefs = match bs {
  [] -> r
  [b, ...rest] -> nrefs_blocks(rest, nrefs_stmts(b.stmts, r))
}

fn nrefs_stmts(ss: [KStmt], r: NRefs) : NRefs = match ss {
  [] -> r
  [s, ...rest] -> nrefs_stmts(rest, nrefs_stmt(s, r))
}

fn nrefs_stmt(s: KStmt, r: NRefs) : NRefs = match s {
  KLet(_, _, op, _)             -> nrefs_op(op, r)
  KDo(op, _)                    -> nrefs_op(op, r)
  KInstall(_, sym, _, _, _, _)  -> if list_has(r.installs, sym) { r } else { NRefs { ...r, installs: [sym, ...r.installs] } }
  KRC(_, _)                     -> r
  KStore(_, _, _)               -> r
  KPop(_, _, _)                 -> r
  KBindEvState(_, _, _, _)      -> r
  KBindSelfState(_, _)          -> r
  KSetCleanup(_, _, _, _)       -> r
  KRunCleanup(_, _, _)          -> r
}

fn nrefs_op(op: KOp, r: NRefs) : NRefs = match op {
  KCall(sym, _)            -> nrefs_callee(r, sym)
  KClosure(sym, _, _)      -> nrefs_callee(r, sym)
  KPerform(eff, _, _, _, _) -> if nrefs_has_eff(r.effects, eff) { r } else { NRefs { ...r, effects: [eff, ...r.effects] } }
  KCallIndirect(_, _)      -> r
  KCallIndirectBorrow(_, _) -> r
  KPrim(_, _)              -> r
  KCon(_, _, _, _, _)      -> r
  KRecord(_, _, _)         -> r
  KConReuse(_, _, _, _, _) -> r
  KRecordReuse(_, _, _, _) -> r
  KTokenSteal(_, _)        -> r
  KProj(_, _)              -> r
  KProjBorrow(_, _)        -> r
  KProjKind(_, _, _)       -> r
  KTagOf(_)                -> r
  KSetjmp(_, _)            -> r
  KResumeOp(_, _)          -> r
  KResume2Op(_, _, _)      -> r
  KLitOp(_)                -> r
}

fn nrefs_callee(r: NRefs, sym: String) : NRefs =
  if nrefs_calls(r, sym) { r }
  else { NRefs { ...r, seen: idx_prepend(r.seen, sym, sym), callees: [sym, ...r.callees] } }

fn nrefs_has_eff(es: [SymId], e: SymId) : Bool = match es {
  []           -> false
  [x, ...rest] -> if sym_same(x, e) { true } else { nrefs_has_eff(rest, e) }
}

#[doc("The analyses a declaration is emitted from: each function's evidence frame, the functions proven memory-clean, those that cannot trap, and the thunk symbols the program takes as a value.")]
pub type NDeclEnv = { frames: EvFrames, const_fns: FnSet, free_fns: FnSet, valued: NameIndex[String] }

#[doc("The declaration analyses of the program `kp` was lowered from.")]
pub fn ndecl_env(kp: KProgram, decls: [Decl]) : NDeclEnv =
  NDeclEnv { frames: frames_index(build_evidence_frames(decls, kp.entry)),
             const_fns: fn_set_of(purity_const_fns(purity_analyze(decls, kp.entry))),
             free_fns: fn_set_of(trapfree_fns(decls, kp.tab)),
             valued: ndecl_handler_thunks(kp.handlers, ndecl_runner_thunks(kp.runners, nrefs_values(kp.fns))) }

# The runner driver calls each block through its thunk.
fn ndecl_runner_thunks(rs: [KRunner], vals: NameIndex[String]) : NameIndex[String] = match rs {
  [] -> vals
  [r, ...rest] -> ndecl_runner_thunks(rest, nrefs_with_value(vals, c_user_thunk_sym(r.sym)))
}

# An install stores the thunk of each clause of its handler, and of its return.
fn ndecl_handler_thunks(hs: [KHandlerDecl], vals: NameIndex[String]) : NameIndex[String] = match hs {
  [] -> vals
  [h, ...rest] -> ndecl_handler_thunks(rest, ndecl_op_thunks(h.op_thunks, match h.ret_thunk {
    Some(sym) -> nrefs_with_value(vals, sym)
    None      -> vals
  }))
}

fn ndecl_op_thunks(ts: [KOpThunk], vals: NameIndex[String]) : NameIndex[String] = match ts {
  [] -> vals
  [KOT(_, sym, _), ...rest] -> ndecl_op_thunks(rest, nrefs_with_value(vals, sym))
}

#[doc("Whether the program takes `f` as a value, so the partition that defines it emits its thunk.")]
pub fn ndecl_thunked(kp: KProgram, env: NDeclEnv, f: KFn) : Bool =
  nrefs_valued(env.valued, c_user_thunk_sym(kfn_sym(kp_names(kp), f)))

#[doc("What another partition sees of `f`: its signature, the slots of its evidence frame, and the attributes its declaration carries.")]
fn ndecl_text(kp: KProgram, env: NDeclEnv, f: KFn) : String = {
  let fid = kfn_fid(f)
  concat_all([
    kir_dump_fn_sig_pub(kp_names(kp), f),
    " frame[", string_join(map(frame_slots_of(env.frames, fid), (k) => inst_key_text(kp.tab, k)), ","), "]",
    if fn_set_has(env.const_fns, fid) { " memory(none)" } else { "" },
    if fn_set_has(env.free_fns, fid) { " nounwind" } else { "" },
    "\n"
  ])
}

# The module-level Ev blob: a 3-field header (`handler_id` / `env` /
# `state`) then one op fn-ptr per op.
fn ndef_ev_slots(ops: [KDefOp]) : Int = nfx_op_base() + list_length(ops)
# The KaiEvidence node buffer. `[8 x ptr]` = 64 bytes ≥ sizeof(KaiEvidence)
# (~48 bytes: handler / handler_id / next / handle_jmp / discard_slot /
# label), matching the C-direct `static KaiEvidence` + the LLVM-text
# `[48 x i8]` node. The default path leaves `handle_jmp` / `discard_slot`
# NULL (a zero-init global), which is exactly what a never-discarding
# default needs.
fn ndef_node_slots() : Int = 8

# --- install: build the runtime-entry hook + per-effect push -----------

# Mint the `_kai_default_ev_<eff>` / `_kai_default_node_<eff>` module globals
# for every default in the SUPERSET (zero-init). The call site addresses a
# default-bearing slot through `_kai_default_node_<eff>`, so the global must
# exist before the fn bodies are walked — even for an effect main never
# installs (a dead-code path) so its reference still links.
#
# The linkage follows the TU role: whole-program keeps INTERNAL (byte-id with
# the pre-modular emitter); a modular OWNER defines the global EXTERNAL so a
# sibling object resolves it; a modular LEAF emits an EXTERNAL declaration
# (no initializer) referencing the owner's definition.
pub fn nemit_declare_default_globals_for(ctx: Handle, tab: SymTab, defaults: [KDefault], role: NModRole) : Unit / Console = match defaults {
  [] -> ()
  [KDef(esym, ops), ...rest] -> {
    let eff = rt_name(tab, esym)
    let evty = llvm_array_type(native_ctx_ptrt(ctx), ndef_ev_slots(ops))
    let ndty = llvm_array_type(native_ctx_ptrt(ctx), ndef_node_slots())
    let _ev = ndef_add_global(ctx, evty, cat2("_kai_default_ev_", eff), role)
    let _node = ndef_add_global(ctx, ndty, cat2("_kai_default_node_", eff), role)
    nemit_declare_default_globals_for(ctx, tab, rest, role)
  }
}

# The one default-global builder, dispatched on the TU role: internal zero-init
# (whole-program), external zero-init (modular owner), or external declaration
# (modular leaf).
fn ndef_add_global(ctx: Handle, ty: Handle, name: String, role: NModRole) : Handle = match role {
  NModWhole     -> llvm_add_global_zeroed(native_ctx_m(ctx), ty, name)
  NModRoot      -> llvm_add_global_extern_def(native_ctx_m(ctx), ty, name)
  NModLeaf      -> llvm_add_global_extern_decl(native_ctx_m(ctx), ty, name)
  NModSplitRoot -> llvm_add_global_extern_def(native_ctx_m(ctx), ty, name)
  NModSplitCore -> llvm_add_global_extern_decl(native_ctx_m(ctx), ty, name)
}

# Build `void kai_main_install_defaults()`: stamp the handler_id + op fn-ptrs
# into each installed default's Ev blob. The minted default is a frame-suppliable
# value, NOT a stack push — the call site fills a default-bearing slot with the
# global node directly, so there is no push/pop pair.
pub fn nemit_build_install_defaults(ctx: Handle, tab: SymTab, defaults: [KDefault]) : Unit / Console = {
  ndef_open_void_fn(ctx, "kai_main_install_defaults")
  ndef_install_each(ctx, tab, defaults)
  llvm_build_ret_void(native_ctx_b(ctx))
  ()
}

# Build `void kai_main_teardown_defaults()` — now empty: a frame-supplied
# default is never pushed, so there is nothing to pop. The symbol stays so the
# runtime entry that calls it needs no change.
pub fn nemit_build_teardown_defaults(ctx: Handle, defaults: [KDefault]) : Unit / Console = {
  ndef_open_void_fn(ctx, "kai_main_teardown_defaults")
  llvm_build_ret_void(native_ctx_b(ctx))
  ()
}

# Open a `void name()`: add the fn + an entry block, then position the ctx
# builder at its end. Mirrors `nemit_one_fn_thunk` (NOT `nemit_fn_with`):
# these hooks need NO register/block table, so they do NOT `begin_fn` —
# they only need the ctx builder positioned, which the shared `ncall_*`
# helpers (reading `native_ctx_b` / `native_ctx_m`) emit through. Calling
# `begin_fn` here frees the prior fn's reg/block tables out from under the
# walk, which is both unnecessary and unsafe.
fn ndef_open_void_fn(ctx: Handle, name: String) : Unit = {
  let m = native_ctx_m(ctx)
  let void_fn_ty = llvm_fn_type_0(native_ctx_voidt(ctx))
  let fnval = llvm_add_function(m, name, void_fn_ty)
  let entry = llvm_append_block(m, fnval, "entry")
  llvm_position_at_end(native_ctx_b(ctx), entry)
}

fn ndef_install_each(ctx: Handle, tab: SymTab, defaults: [KDefault]) : Unit / Console = match defaults {
  [] -> ()
  [d, ...rest] -> { ndef_install_one(ctx, tab, d); ndef_install_each(ctx, tab, rest) }
}

# Install one default handler: stamp handler_id + op fn-ptrs into the (already
# minted) Ev global and connect its node to the Ev. No push — the default rides
# the frame, not the stack; the call site addresses the node directly.
fn ndef_install_one(ctx: Handle, tab: SymTab, d: KDefault) : Unit / Console = match d {
  KDef(esym, ops) -> {
    let eff = rt_name(tab, esym)
    let p = native_ctx_ptrt(ctx)
    let ev = ndef_ev_global(ctx, eff)
    # handler_id (field 0) = kaix_fresh_handler_id() : i64.
    let hid = ncall_sig0(ctx, "kaix_fresh_handler_id", native_ctx_i64t(ctx))
    let _h0 = ncall_sig2(ctx, "kaix_ev_set_handler_id", native_ctx_voidt(ctx),
                         p, native_ctx_i64t(ctx), ev, hid)
    ndef_store_ops(ctx, ev, ops, 0)
    # Connect the node to the Ev without pushing it on the evidence stack.
    let node = ndef_node_global(ctx, eff)
    let effname = nemit_eff_label(ctx, eff)
    ndef_init_default(ctx, node, effname, ev)
  }
}

# `kaix_evidence_init_default_l(ptr node, i8* eff, ptr ev) -> void` — set the
# node's handler / eff_label, NULL the discard fields, no parent linkage.
fn ndef_init_default(ctx: Handle, node: Handle, effname: Handle, ev: Handle) : Unit / Console = {
  let p = native_ctx_ptrt(ctx)
  let ptb = llvm_buf_new(); llvm_buf_push(ptb, p); llvm_buf_push(ptb, p); llvm_buf_push(ptb, p)
  let ab = llvm_buf_new(); llvm_buf_push(ab, node); llvm_buf_push(ab, effname); llvm_buf_push(ab, ev)
  let _r = ncall_finish(ctx, "kaix_evidence_init_default_l", native_ctx_voidt(ctx), ptb, ab)
  ()
}

# The module-level Ev blob for `eff` — recovered by name from the global
# minted up front by `nemit_declare_default_globals_for`, so install and every
# call site agree on one `GlobalVariable*`. A handle (captured in a `let`).
fn ndef_ev_global(ctx: Handle, eff: String) : Handle =
  llvm_get_named_global(native_ctx_m(ctx), cat2("_kai_default_ev_", eff))

# The module-level KaiEvidence node for `eff`, recovered by name.
fn ndef_node_global(ctx: Handle, eff: String) : Handle =
  llvm_get_named_global(native_ctx_m(ctx), cat2("_kai_default_node_", eff))

# Store each op's `kaix_default_<eff>_<op>` forwarder address into the Ev
# blob at field (`nfx_op_base` + position). Reuses
# `nemit_ev_set_op` (`kaix_ev_set_op(ev, idx, fn) -> void`). Only the
# address is stored, but the declaration still carries the C prototype: a
# linker that checks signatures rejects any other.
fn ndef_store_ops(ctx: Handle, ev: Handle, ops: [KDefOp], i: Int) : Unit / Console = match ops {
  [] -> ()
  [KDOp(_, sym, n), ...rest] -> {
    let fnv = llvm_get_or_declare_fn(native_ctx_m(ctx), sym, llvm_fn_type_boxed(native_ctx_ptrt(ctx), n))
    let _s = nemit_ev_set_op(ctx, ev, nfx_op_base() + i, fnv)
    ndef_store_ops(ctx, ev, rest, i + 1)
  }
}

# --- perform side: synthetic handler decls for builtin dispatch --------
#
# A BUILTIN effect (Stdout) has NO user `KHandlerDecl`, so `nemit_perform`
# (emit_native_fx2) would abort on its `nfx_find_handler_by_eff` miss. But
# the dispatch is IDENTICAL once a handler exists: lookup_node → node_handler
# → ev_op_at(field) → indirect call → op_finish, with the op fn-ptr loaded
# from the Ev WE installed above. `nemit_perform` only needs the op's FIELD
# INDEX from `op_thunks`; the thunk symbol it records is never called
# (the runtime resolves the op fn-ptr from the installed Ev). So we hand
# `nemit_perform` a SYNTHETIC `KHandlerDecl` per default whose `op_thunks`
# carry the op names in declaration order — that alone makes the existing
# dispatch correct for builtins, with zero change to `nemit_perform`.
pub fn ndef_synth_handlers(tab: SymTab, defaults: [KDefault]) : [KHandlerDecl] = match defaults {
  [] -> []
  [KDef(esym, ops), ...rest] ->
    [KHandlerDecl { eff_sym: esym, sym: cat2("__default_", rt_name(tab, esym)),
                    op_thunks: ndef_op_thunks(ops), ret_thunk: None },
     ...ndef_synth_handlers(tab, rest)]
}

fn ndef_op_thunks(ops: [KDefOp]) : [KOpThunk] = match ops {
  [] -> []
  [KDOp(op, sym, n), ...rest] -> [KOT(op, sym, n), ...ndef_op_thunks(rest)]
}

#[doc("What every partition key of one build reads: the program, its declaration analyses, each function's declaration text by symbol, and the handler declarations the emitter resolves effects through.")]
pub type NKeyCtx = { kp: KProgram, env: NDeclEnv, decls: NameIndex[NKeyDecl], handlers: [KHandlerDecl] }

#[doc("A function's declaration text under its symbol. An index bucket holds every symbol that hashes alike, so each entry keeps its own and a lookup compares it.")]
pub type NKeyDecl = { sym: String, text: String }

#[doc("The key context of a build of `kp` under the declaration analyses `env`.")]
pub fn nmodkey_ctx(kp: KProgram, env: NDeclEnv) : NKeyCtx =
  NKeyCtx { kp: kp, env: env, decls: nmodkey_index(kp, env, kp_names(kp), kp.fns, idx_empty()),
            handlers: list_append(kp.handlers, ndef_synth_handlers(kp.tab, kp.synth_defaults)) }

fn nmodkey_index(kp: KProgram, env: NDeclEnv, nm: KNames, fns: [KFn], ix: NameIndex[NKeyDecl]) : NameIndex[NKeyDecl] = match fns {
  [] -> ix
  [f, ...rest] -> {
    let sym = kfn_sym(nm, f)
    nmodkey_index(kp, env, nm, rest, idx_prepend(ix, sym, NKeyDecl { sym: sym, text: ndecl_text(kp, env, f) }))
  }
}

# The declaration text of the program function emitted as `sym`, empty for a
# symbol the program does not define.
fn nmodkey_decl(c: NKeyCtx, sym: String) : String = nmodkey_decl_in(idx_chain(c.decls, sym), sym)

fn nmodkey_decl_in(ds: [NKeyDecl], sym: String) : String = match ds {
  []           -> ""
  [d, ...rest] -> if d.sym == sym { d.text } else { nmodkey_decl_in(rest, sym) }
}

#[doc("The declaration text of the program function `f`.")]
fn nmodkey_decl_of(c: NKeyCtx, f: KFn) : String = nmodkey_decl(c, kfn_sym(kp_names(c.kp), f))

# A defined function's declaration, marked when its thunk is emitted with it.
fn nmodkey_defined(c: NKeyCtx, f: KFn) : String =
  if ndecl_thunked(c.kp, c.env, f) { cat2("thunked ", nmodkey_decl_of(c, f)) } else { nmodkey_decl_of(c, f) }

#[doc("The content-addressed cache key of a partition that defines `define_fns`: a hash of those functions and their declarations, the declarations of the cross-TU callees they invoke, the operations of the effects they perform, the handlers they install, and `owned`, the text of what the partition emits that none of its functions names (empty for one that owns no singleton).")]
pub fn nmodkey_of(c: NKeyCtx, define_fns: [KFn], role_tag: String, owned: String) : String = {
  let nm = kp_names(c.kp)
  let refs = nrefs_of(define_fns)
  nmodkey_hash(concat_all([
    role_tag, "\n", owned, "\n",
    kir_dump_fns_pub(nm, define_fns),
    "; declares\n", concat_all(map(define_fns, (f) => nmodkey_defined(c, f))),
    "; externs\n", concat_all(map(list_reverse(refs.callees), (s) => nmodkey_decl(c, s))),
    "; effects\n", concat_all(map(list_reverse(refs.effects), (e) => nmodkey_effect_text(c, e))),
    "; handlers\n", concat_all(map(list_reverse(refs.installs), (h) => nmodkey_handler_text(c, h)))
  ]))
}

# A perform site reads the place of its operation among the effect's, off the
# handler the emitter finds for that effect.
fn nmodkey_effect_text(c: NKeyCtx, eff: SymId) : String = match nfx_find_handler_by_eff(c.handlers, eff) {
  Some(h) -> concat_all(["effect ", rt_name(c.kp.tab, eff), " [", string_join(map(h.op_thunks, nmodkey_op_name), ", "), "]\n"])
  None    -> ""
}

fn nmodkey_op_name(t: KOpThunk) : String = match t { KOT(op, _, _) -> op }

# An install site reads the whole declaration of its handler.
fn nmodkey_handler_text(c: NKeyCtx, sym: String) : String = match nfx_find_handler(c.handlers, sym) {
  Some(h) -> concat_all([
    "handler ", rt_name(c.kp.tab, h.eff_sym), " ", h.sym, " [", string_join(map(h.op_thunks, nmodkey_op_text), ", "), "] ",
    match h.ret_thunk { Some(r) -> r None -> "" }, "\n"
  ])
  None -> ""
}

fn nmodkey_op_text(t: KOpThunk) : String = match t {
  KOT(op, sym, arity) -> concat_all([op, "->", sym, "/", int_to_string(arity)])
}

#[doc("The key text of the split core, which calls into no other partition's analyses: a hash of the functions it defines and the signatures of the callees they invoke. Its sources are hashed beside this by its caller, and they are what its frames, attributes and effects derive from, so every program shares one core object.")]
pub fn nmodkey_core(kp: KProgram, core_fns: [KFn]) : String = {
  let nm = kp_names(kp)
  let refs = nrefs_of(core_fns)
  nmodkey_hash(concat_all([
    "splitcore\n", kir_dump_fns_pub(nm, core_fns),
    "; externs\n", concat_all(map(filter(kp.fns, (f) => nrefs_calls(refs, kfn_sym(nm, f))), (f) => cat2(kir_dump_fn_sig_pub(nm, f), "\n")))
  ]))
}

# A stable, platform-independent content hash (djb2 over the bytes), masked to
# 48 bits so it stays a compact decimal string and its accumulator never wraps
# differently between the C oracle and the native backend.
fn nmodkey_hash(s: String) : String = int_to_string(nmodkey_djb2(s, 0, string_length(s), 5381))
fn nmodkey_djb2(s: String, i: Int, n: Int, h: Int) : Int =
  if i >= n { h }
  else { nmodkey_djb2(s, i + 1, n, nmodkey_mask(h * 33 + char_to_int(char_at_or_zero(s, i)))) }

fn nmodkey_mask(h: Int) : Int = h % 281474976710656
