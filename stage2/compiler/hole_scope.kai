#[doc("""The part of a hole's scope a user can write at the hole.

A hole's scope is the typer's environment, which also binds what the
compiler declared for its own use (a protocol dispatcher, a hoisted
temporary): a user cannot write those. Nor can a top-level name private
to a foreign module.
""")]

import compiler.ast
import compiler.symtab
import compiler.handler_alias
import compiler.infer

#[doc("The hole's scope minus what the compiler declared for itself and the top-level declarations the root file cannot reach; `hidden` lists the latter, `tab` says who declared an entry.")]
pub fn hole_visible_scope(tab: SymTab, scope: [TyEntry], toplevel_len: Int, hidden: [SymId]) : [TyEntry] =
  hvs_loop(tab, scope, list_length(scope) - toplevel_len, hidden, [])

#[doc("The hole's local bindings (parameters and lets), minus the compiler's own.")]
pub fn hole_local_scope(tab: SymTab, scope: [TyEntry], toplevel_len: Int) : [TyEntry] =
  filter(drop_last_entries(scope, toplevel_len), (te) => key_is_source(tab, te.key))

# Locals come first; the trailing `toplevel_len` entries are the top level.
fn hvs_loop(tab: SymTab, es: [TyEntry], n_local: Int, hidden: [SymId], acc: [TyEntry]) : [TyEntry] =
  match es {
    [] -> list_reverse(acc)
    [te, ...rest] -> {
      let keep = key_is_source(tab, te.key) and (n_local > 0 or not key_hidden(hidden, te.key))
      hvs_loop(tab, rest, n_local - 1, hidden, if keep { [te, ...acc] } else { acc })
    }
  }

# A minted binder is the compiler's, but for the handler aliases a
# clause reads by the name the language gives them.
fn key_is_source(tab: SymTab, k: EnvKey) : Bool = match k {
  KSym(s)   -> not sym_internal(tab, s)
  KCtor(s)  -> not sym_internal(tab, s)
  KOp(s, _) -> not sym_internal(tab, s)
  KLocal(b) -> not local_is_minted(b.id) or clause_alias_is_written(b.id)
}

fn key_hidden(hidden: [SymId], k: EnvKey) : Bool = match k {
  KSym(s)   -> any(hidden, (h) => sym_same(h, s))
  KCtor(s)  -> any(hidden, (h) => sym_same(h, s))
  KOp(_, _) -> false
  KLocal(_) -> false
}
