#[doc("""The part of a hole's scope a user can write at the hole.

A hole's scope is the typer's environment, which also keys entries for its
own lookups: an effect operation under its identity (`#<id>.op`), type- and
module-qualified keys (`Color::Red`, `os::Exit::Signaled`, the
`T::__type_decl_arity_<N>__` sentinel), and compiler-generated helpers
(`__proto_show`). Source spells a qualifier with `.`, never `::`, so none of
these can be pasted. Nor can a top-level name private to a foreign module.
""")]

import compiler.util
import compiler.infer

#[doc("The hole's scope minus internal keys and the top-level names the root file cannot reach; `hidden` lists the latter.")]
pub fn hole_visible_scope(scope: [TyEntry], toplevel_len: Int, hidden: [String]) : [TyEntry] =
  hvs_loop(scope, list_length(scope) - toplevel_len, hidden, [])

#[doc("The hole's local bindings (parameters and lets), minus internal keys.")]
pub fn hole_local_scope(scope: [TyEntry], toplevel_len: Int) : [TyEntry] =
  filter(drop_last_entries(scope, toplevel_len), (te) => env_key_is_source(te.name))

# Locals come first; the trailing `toplevel_len` entries are the top level.
fn hvs_loop(es: [TyEntry], n_local: Int, hidden: [String], acc: [TyEntry]) : [TyEntry] =
  match es {
    [] -> list_reverse(acc)
    [te, ...rest] -> {
      let keep = env_key_is_source(te.name) and (n_local > 0 or not list_has(hidden, te.name))
      hvs_loop(rest, n_local - 1, hidden, if keep { [te, ...acc] } else { acc })
    }
  }

fn env_key_is_source(name: String) : Bool =
  not (char_at_or_zero(name, 0) == '#'
       or (char_at_or_zero(name, 0) == '_' and char_at_or_zero(name, 1) == '_')
       or env_key_has_qualifier(name, 0, string_length(name)))

fn env_key_has_qualifier(name: String, i: Int, n: Int) : Bool =
  if i + 1 >= n { false }
  else if char_at_or_zero(name, i) == ':' and char_at_or_zero(name, i + 1) == ':' { true }
  else { env_key_has_qualifier(name, i + 1, n) }
