#[doc("""The part of a hole's scope a user can write at the hole.

A hole's scope is the typer's environment, which also binds
compiler-generated helpers and temporaries (`__proto_show`): a user
cannot write those. Nor can a top-level name private to a foreign module.
""")]

import compiler.util
import compiler.symtab
import compiler.infer

#[doc("The hole's scope minus compiler-generated names and the top-level names the root file cannot reach; `hidden` lists the latter, `tab` spells an entry.")]
pub fn hole_visible_scope(tab: SymTab, scope: [TyEntry], toplevel_len: Int, hidden: [String]) : [TyEntry] =
  hvs_loop(tab, scope, list_length(scope) - toplevel_len, hidden, [])

#[doc("The hole's local bindings (parameters and lets), minus compiler-generated names.")]
pub fn hole_local_scope(tab: SymTab, scope: [TyEntry], toplevel_len: Int) : [TyEntry] =
  filter(drop_last_entries(scope, toplevel_len), (te) => name_is_source(env_key_text(tab, te.key)))

# Locals come first; the trailing `toplevel_len` entries are the top level.
fn hvs_loop(tab: SymTab, es: [TyEntry], n_local: Int, hidden: [String], acc: [TyEntry]) : [TyEntry] =
  match es {
    [] -> list_reverse(acc)
    [te, ...rest] -> {
      let name = env_key_text(tab, te.key)
      let keep = name_is_source(name) and (n_local > 0 or not list_has(hidden, name))
      hvs_loop(tab, rest, n_local - 1, hidden, if keep { [te, ...acc] } else { acc })
    }
  }

fn name_is_source(name: String) : Bool =
  not (char_at_or_zero(name, 0) == '_' and char_at_or_zero(name, 1) == '_')
