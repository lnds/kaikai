#[doc("""
The core and imported library functions a program cannot name, emptied before any pass walks them.

Every pass between the parser and the reachability cut walks the whole
core, though a program reaches a small part of it. This empties the body
of each core function no kept declaration spells: a name written in the
program, in a core declaration that is not a function, or in a kept core
function. The declaration stays, with its name, its place and its
signature, and the symbol table is left whole, so every name resolves to
what it always did and every diagnostic outside those bodies is unchanged.
The reachability cut then drops what was emptied; a function it keeps
after all means this cut was wrong, and the compile starts over without it.
""")]

import compiler.util
import compiler.ast
import compiler.written
import compiler.symtab
import compiler.expr_positions
import compiler.infer_index
import compiler.core_refs
import compiler.core_modules
import compiler.derive_mint
import compiler.core_protos
import compiler.core_reach
import compiler.unwind_effects
import compiler.chars

type PcSt = { tab: SymTab, fns: NameIndex[Decl], live: NameIndex[SymId], work: [Decl] }

#[doc("The core functions a program can name: the ones something in `user`, in a declaration of `core` that is not a function, or in another of them spells.")]
pub type PreCut = { tab: SymTab, live: NameIndex[SymId] }

#[doc("How much of the core the early cut empties: what the program cannot name, every function, or nothing.")]
pub type EarlyCut = EcReached | EcAll | EcOff

#[doc("The cut that empties every core function.")]
pub fn precut_all(tab: SymTab) : PreCut = PreCut { tab: tab, live: idx_empty() }

#[doc("True when the cut can save more than it costs: it walks all of `user` to spare the front end at most all of `core`.")]
pub fn precut_pays(core: [Decl], user: [Decl]) : Bool = list_length(user) < list_length(core)

#[doc("The functions of `ds` that belong to one of the modules `mods`: the imported library functions the cut may empty.")]
pub fn precut_lib_fns(ds: [Decl], mods: [String]) : [Decl] = filter(ds, (d) => pc_in_mods(d, mods))

#[doc("The declarations of `ds` that `precut_lib_fns` leaves out.")]
pub fn precut_rest(ds: [Decl], mods: [String]) : [Decl] = filter(ds, (d) => not pc_in_mods(d, mods))

#[doc("`ds` with the body of each function of `mods` the cut `pc` empties replaced by the unit value.")]
pub fn precut_imported(pc: PreCut, mods: [String], ds: [Decl]) : [Decl] =
  map(ds, (d) => if not pc_in_mods(d, mods) or pc_live(pc.live, pc_fn_sym(d)) { d } else { pc_stub(d) })

#[doc("The cut of `core` for the program `user`. `tab` names the declarations of both; `keep_unw` keeps the functions that feed the unwind analysis.")]
pub fn core_precut(core: [Decl], user: [Decl], tab: SymTab, keep_unw: Bool) : PreCut = {
  let st0 = PcSt { tab: tab, fns: pc_index(core, idx_empty()), live: idx_empty(), work: [] }
  let all = list_append(user, core)
  let lib = list_append(if any(all, pc_derives) { pc_lib_syms(core, tab, core_module_name(derive_lib_module())) } else { [] },
                        if any(all, pc_derives_json) { pc_lib_syms(core, tab, json_lib_home()) } else { [] })
  let unw = if keep_unw { map(filter(core, (d) => unw_feeds_analysis(pc_bare(d))), pc_fn_sym) } else { [] }
  let seeded = pc_syms(unw, pc_syms(lib, pc_fields(all, pc_core_fns(variants[CoreFn](), st0))))
  let st = pc_drain(pc_decls(filter(core, (d) => not pc_is_fn(d)), pc_decls(user, seeded)))
  PreCut { tab: tab, live: st.live }
}

#[doc("The functions of `core` the cut `pc` empties.")]
pub fn precut_emptied(pc: PreCut, core: [Decl]) : [SymId] =
  map(filter(core, (d) => pc_is_fn(d) and not pc_live(pc.live, pc_fn_sym(d))), pc_fn_sym)

#[doc("`core` with the body of each function the cut `pc` empties replaced by the unit value.")]
pub fn precut_decls(pc: PreCut, core: [Decl]) : [Decl] =
  map(core, (d) => if not pc_is_fn(d) or pc_live(pc.live, pc_fn_sym(d)) { d } else { pc_stub(d) })

fn pc_stub(d: Decl) : Decl = match d {
  DDoc(a, b, inner, l, c) -> DDoc(a, b, pc_stub(inner), l, c)
  DAttr(a, inner, l, c)   -> DAttr(a, pc_stub(inner), l, c)
  DFn(p, id, tbs, ps, ret, row, body, l, c, m) ->
    DFn(p, id, tbs, ps, ret, row, mk_expr(EUnit, body.line, body.col), l, c, m)
  _ -> d
}

fn pc_core_fns(cfs: [CoreFn], st: PcSt) : PcSt = match cfs {
  [] -> st
  [cf, ...rest] -> pc_core_fns(rest, match core_fn_id(cf) {
    Some(s) -> pc_sym(s, st)
    None    -> pc_name(core_fn_name(cf), st)
  })
}

# A derive's expansion reads the fields of its type and calls into the
# derive library, and none of that is written in the program.
fn pc_derives(d: Decl) : Bool = match d {
  DDerive(_, _, _, _)     -> true
  DDoc(_, _, inner, _, _) -> pc_derives(inner)
  DAttr(_, inner, _, _)   -> pc_derives(inner)
  _ -> false
}

# The Json derive writes calls into the JSON bind library by identity.
fn pc_derives_json(d: Decl) : Bool = match d {
  DDerive(ps, _, _, _)    -> list_has(ps, core_proto_name(CpJson))
  DDoc(_, _, inner, _, _) -> pc_derives_json(inner)
  DAttr(_, inner, _, _)   -> pc_derives_json(inner)
  _ -> false
}

fn pc_lib_syms(core: [Decl], tab: SymTab, home: String) : [SymId] = match st_module(tab, home) {
  None      -> []
  Some(lib) -> map(filter(core, (d) => pc_is_fn(d) and sym_owned_by(tab, pc_fn_sym(d), lib)), pc_fn_sym)
}

fn pc_fields(ds: [Decl], st: PcSt) : PcSt = match ds {
  [] -> st
  [d, ...rest] -> pc_fields(rest, match pc_typed(d) {
    DType(_, _, _, TBRecord(fs), _, _, _, _) -> pc_names(map(fs, (f) => match f { FD(_, n, _, _) -> n }), st)
    _ -> st
  })
}

fn pc_typed(d: Decl) : Decl = match d {
  DDerive(_, inner, _, _) -> pc_typed(inner)
  DDoc(_, _, inner, _, _) -> pc_typed(inner)
  DAttr(_, inner, _, _)   -> pc_typed(inner)
  _ -> d
}

fn pc_index(ds: [Decl], ix: NameIndex[Decl]) : NameIndex[Decl] = match ds {
  [] -> ix
  [d, ...rest] -> pc_index(rest, if pc_is_fn(d) { idx_prepend_sym(ix, pc_fn_sym(d), d) } else { ix })
}

fn pc_is_fn(d: Decl) : Bool = match pc_bare(d) {
  DFn(_, _, _, _, _, _, _, _, _, _) -> true
  _ -> false
}

fn pc_in_mods(d: Decl, mods: [String]) : Bool = match pc_bare(d) {
  DFn(_, _, _, _, _, _, _, _, _, Some(m)) -> list_has(mods, m)
  _ -> false
}

fn pc_fn_sym(d: Decl) : SymId = match pc_bare(d) {
  DFn(_, id, _, _, _, _, _, _, _, _) -> fnid_sym(id)
  _ -> sym_none()
}

# Only a function the reachability cut can drop is emptied: one under a
# marker that outlives the front end stays whole.
fn pc_bare(d: Decl) : Decl = match d {
  DDoc(_, _, inner, _, _) -> pc_bare(inner)
  DAttr(_, inner, _, _)   -> pc_bare(inner)
  _ -> d
}

fn pc_live(live: NameIndex[SymId], s: SymId) : Bool = match idx_chain_sym(live, s) {
  [] -> false
  _  -> true
}

fn pc_drain(st: PcSt) : PcSt = match st.work {
  [] -> st
  [d, ...rest] -> pc_drain(pc_decl(d, PcSt { ...st, work: rest }))
}

fn pc_decls(ds: [Decl], st: PcSt) : PcSt = match ds {
  [] -> st
  [d, ...rest] -> pc_decls(rest, pc_decl(d, st))
}

fn pc_decl(d: Decl, st: PcSt) : PcSt = pc_exprs(cr_decl_exprs(d), st)

fn pc_exprs(es: [Expr], st: PcSt) : PcSt = match es {
  [] -> st
  [e, ...rest] -> pc_exprs(rest, pc_expr(e, st))
}

fn pc_expr(e: Expr, st: PcSt) : PcSt = match e.kind {
  EName(n)       -> pc_name(written_text(n), st)
  ESym(s, _)     -> pc_sym(s, st)
  EModCall(_, n) -> pc_name(written_text(n), st)
  EField(_, n)   -> pc_positions(xp_positions(e), pc_name(n, st))
  EStr(s, _)     -> if string_contains(s, "\x23{") { pc_names(pc_words(chars(s), [], []), st) } else { st }
  _              -> pc_positions(xp_positions(e), st)
}

fn pc_positions(ps: [XPos], st: PcSt) : PcSt = match ps {
  [] -> st
  [XP(_, x), ...rest] -> pc_positions(rest, pc_expr(x, st))
}

# An interpolation hole is parsed later, so every word of the literal
# stands for a name it may hold.
fn pc_words(cs: [Char], cur: [Char], acc: [String]) : [String] = match cs {
  [] -> pc_flush(cur, acc)
  [c, ...rest] -> if ch_is_alnum(c) { pc_words(rest, [c, ...cur], acc) }
                  else { pc_words(rest, [], pc_flush(cur, acc)) }
}

fn pc_flush(cur: [Char], acc: [String]) : [String] = match cur {
  [] -> acc
  _  -> [from_chars(list_reverse(cur)), ...acc]
}

fn pc_names(ns: [String], st: PcSt) : PcSt = match ns {
  [] -> st
  [n, ...rest] -> pc_names(rest, pc_name(n, st))
}

fn pc_name(n: String, st: PcSt) : PcSt = pc_syms(st_by_name(st.tab, n), st)

fn pc_syms(ss: [SymId], st: PcSt) : PcSt = match ss {
  [] -> st
  [s, ...rest] -> pc_syms(rest, pc_sym(s, st))
}

fn pc_sym(s: SymId, st: PcSt) : PcSt =
  if pc_live(st.live, s) { st }
  else { match idx_chain_sym(st.fns, s) {
    [] -> st
    ds -> PcSt { ...st, live: idx_prepend_sym(st.live, s, s), work: list_append(ds, st.work) }
  } }
