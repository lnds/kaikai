# compiler/kir_pat_alias.kai — the single source of truth for which match
# arm binders are ALIASES of the scrutinee's storage and therefore need a
# structural incref (dup) in the native lowering.
#
# The C-direct oracle (`emit_pat_binds` in emit_c.kai) decides alias-ness as
# part of ONE textual walk: a binder reached with `is_alias=true` shares
# storage with the scrutinee (a variant pointer slot, a cons head/tail/rest)
# and is bound `kai_incref(scr)`; a binder reached with `is_alias=false`
# already owns its ref (a `kai_op_field` result, a freshly-boxed Real slot).
# The native backend re-derives that same discipline; before this module it
# did so with several ad-hoc collectors keyed by arm shape, each a partial
# re-implementation that drifted from the oracle as new arm shapes appeared.
#
# This module holds ONE recursive collector — `pat_alias_binders` — that
# mirrors `emit_pat_binds` at any depth, plus pure position predicates that
# PARTITION its result for the two reuse call-sites that need a subset. No
# consumer re-walks a pattern to decide alias-ness; they all read this set.

import compiler.ast
import compiler.emit_shared
import compiler.ctor_ix

# Pointer/scalar split of a variant slot kind: 0 = pointer, 1 = Int,
# 2 = Real. `pa_slot_needs_dup` maps kind to whether the native binder is a
# heap-box BORROW of the cell's storage (0) or an owned / no-RC read (1, 2).
# An enum slot maps to 0/pointer: its binder holds the immortal interned
# singleton, so the alias dup it gets is a runtime no-op — same net effect
# as the C oracle's alias-shaped enum bind.
fn pa_slot_kind(k: Int) : Int = if k == 3 { 0 } else { k }

#[doc("The pointer/scalar slot kinds of the constructor a pattern references, or [] when it references none.")]
pub fn pa_kinds(ix: CtorIx, r: DeclRef) : [Int] = match ctor_ix_row(ix, ref_sym(r)) {
  Some(EV(_, _, _, ks, _)) -> map(ks, pa_slot_kind)
  None                     -> []
}

#[doc("""
Every binder a match arm reaches over a heap-box BORROW path — the set the
native lowering must structurally dup so a consuming arm body cannot free a
slot the scrutinee still holds. This is the single mirror of that discipline;
all native alias-dup / reuse call-sites derive their sets from it, never
re-walking.

Descends PList (heads + `...rest`), PVariant slots that `pa_slot_needs_dup`
(pointer slots; Int is a tagged immediate and a Real slot's read mints an
owned box), and PAs (name + inner, inner always alias). Record and
variant-record fields are NOT descended: the field bind dups its own cell
binders and releases the field read (`bind_field_owned`), so they arrive owned.
""")]
pub fn pat_alias_binders(p: Pattern, ix: CtorIx) : [LocalId] = pab_pat(p, ix, [])

fn pab_pat(p: Pattern, ix: CtorIx, acc: [LocalId]) : [LocalId] = match p.pkind {
  PBind(b)      -> [b.id, ...acc]
  PNarrow(b, _) -> [b.id, ...acc]
  PAs(b, inner) -> pab_pat(inner, ix, [b.id, ...acc])
  PList(pats, opt_rest) -> {
    let a1 = match opt_rest {
      None    -> acc
      Some(b) -> [b.id, ...acc]
    }
    pab_pats(pats, ix, a1)
  }
  PVariant(r, subs) -> pab_variant_slots(subs, pa_kinds(ix, r), 0, ix, acc)
  _ -> acc
}

fn pab_pats(pats: [Pattern], ix: CtorIx, acc: [LocalId]) : [LocalId] = match pats {
  []           -> acc
  [hp, ...rest] -> pab_pats(rest, ix, pab_pat(hp, ix, acc))
}

fn pab_variant_slots(subs: [Pattern], ks: [Int], idx: Int, ix: CtorIx, acc: [LocalId]) : [LocalId] = match subs {
  []            -> acc
  [sp, ...rest] -> {
    let k = kind_at(ks, idx)
    let acc1 = if pa_slot_needs_dup(k) { pab_pat(sp, ix, acc) } else { acc }
    pab_variant_slots(rest, ks, idx + 1, ix, acc1)
  }
}

# A slot binder needs a structural dup iff the native reads it as a BORROW of
# storage the arm may consume — pointer slots (0) only. A Real slot (2) is a
# raw `.r` word under the full slot mask: its `KProj` read mints a fresh
# OWNED box (the C oracle's `kai_real(slot.r)`, `is_alias=false`), so a dup
# here would leak one box per read. Int (1) is a tagged immediate whose
# decref is a no-op.
fn pa_slot_needs_dup(k: Int) : Bool = k == 0

#[doc("""
The DIRECT-slot partition of `pat_alias_binders`: the alias binders bound as
a top-level cons slot (head `PBind`, `...rest`) or a top-level variant
pointer slot. These are the slots a dual-branch reuse binds per-branch (a
borrow in the unique branch, a dup in the shared branch); everything else in
the alias set is deconstructed and dup'd unconditionally outside the fork.
""")]
pub fn pat_direct_alias_slots(p: Pattern, ix: CtorIx) : [LocalId] = match p.pkind {
  PList(pats, opt_rest) -> {
    let heads = pa_list_direct_heads(pats, [])
    match opt_rest { None -> heads Some(b) -> [b.id, ...heads] }
  }
  PVariant(r, subs) -> pa_variant_direct_slots(subs, pa_kinds(ix, r), 0, [])
  PBind(b)  -> [b.id]
  PAs(b, _) -> [b.id]
  _         -> []
}

fn pa_list_direct_heads(pats: [Pattern], acc: [LocalId]) : [LocalId] = match pats {
  []            -> acc
  [hp, ...rest] -> match hp.pkind {
    PBind(b) -> pa_list_direct_heads(rest, [b.id, ...acc])
    _        -> pa_list_direct_heads(rest, acc)
  }
}

fn pa_variant_direct_slots(subs: [Pattern], ks: [Int], idx: Int, acc: [LocalId]) : [LocalId] = match subs {
  []            -> acc
  [sp, ...rest] -> {
    let k = kind_at(ks, idx)
    let acc1 = match sp.pkind {
      PBind(b) -> if k == 0 { [b.id, ...acc] } else { acc }
      _        -> acc
    }
    pa_variant_direct_slots(rest, ks, idx + 1, acc1)
  }
}

#[doc("""
The DECONSTRUCTED partition of `pat_alias_binders`: the alias set minus the
direct slots. In a dual-branch cons reuse these sub-binders are incref'd
UNCONDITIONALLY (in both branches, per the oracle's is_alias path), so they
leave the condbr; only the direct slots differ per branch.
""")]
pub fn pat_decon_alias_binders(p: Pattern, ix: CtorIx) : [LocalId] =
  binders_minus(pat_alias_binders(p, ix), pat_direct_alias_slots(p, ix))

fn binders_minus(all: [LocalId], drop: [LocalId]) : [LocalId] = match all {
  []           -> []
  [n, ...rest] -> if binder_among(drop, n) { binders_minus(rest, drop) } else { [n, ...binders_minus(rest, drop)] }
}

fn binder_among(xs: [LocalId], n: LocalId) : Bool = match xs {
  []           -> false
  [h, ...rest] -> if local_eq(h, n) { true } else { binder_among(rest, n) }
}

#[doc("""
The pointer slots of a variant pattern that no direct binder takes: the
children an arm-top reuse token must release when it steals a unique shell.
A `PBind` slot moves into its binder; any other pointer sub-pattern (`_`, a
nested pattern) leaves its child in the shell. Enum and scalar slots hold no
reference.
""")]
pub fn pat_unbound_ptr_slots(p: Pattern, ix: CtorIx) : [Int] = match p.pkind {
  PVariant(_, subs) -> match pat_slot_kinds(p, ix) {
    Some(ks) -> pa_unbound_slots(subs, ks, 0)
    None     -> []
  }
  _ -> []
}

#[doc("The slot kinds, as the cell stores them, of the constructor a variant pattern names; None for any other pattern or an unknown constructor.")]
pub fn pat_slot_kinds(p: Pattern, ix: CtorIx) : Option[[Int]] = match p.pkind {
  PVariant(r, subs) -> match ctor_ix_row(ix, ref_sym(r)) {
    Some(EV(_, _, ar, ks, _)) -> if ar == list_length(subs) { Some(ks) } else { None }
    None                      -> None
  }
  _ -> None
}

fn pa_unbound_slots(subs: [Pattern], ks: [Int], idx: Int) : [Int] = match subs {
  [] -> []
  [sp, ...rest] -> {
    let tail = pa_unbound_slots(rest, ks, idx + 1)
    match sp.pkind {
      PBind(_) -> tail
      _        -> if kind_at(ks, idx) == 0 { [idx, ...tail] } else { tail }
    }
  }
}
