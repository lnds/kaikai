#[doc("""
Site ids: the identity the unwinder keys each node it brackets by.

`sym_erase` gives every node of a declaration's bodies an id of its own
as it rebuilds them. A later pass that builds nodes or clones a subtree
renumbers the declaration it rewrote, so no two nodes of one declaration
share an id.
""")]

import compiler.ast
import compiler.ast_map
import compiler.decl_map

#[doc("The next site id of a declaration's counter.")]
pub fn site_next(sites: Array[Int]) : Int / Mutable = {
  let n = sites[0] + 1
  let _ = array_set(sites, 0, n)
  n
}

#[doc("True when the unwinder can key a node of kind `k`: a call, an index, an operator, a `match`, a `!` or a `handle`. An `assert`'s condition is keyed too, whatever its kind.")]
pub fn site_keyed(k: ExprKind) : Bool = match k {
  ECall(_, _)     -> true
  EIndex(_, _)    -> true
  EBinop(_, _, _) -> true
  EMatch(_, _)    -> true
  EBang(_)        -> true
  EHandle(_, _, _, _, _, _, _) -> true
  _ -> false
}

#[doc("`d` with every node of its bodies given a fresh site id.")]
pub fn site_renumber_decl(d: Decl) : Decl / Mutable = {
  let sites = array_make(1, 0)
  decl_map_bodies(d, (b) => sr_expr(sites, b))
}

fn sr_expr(sites: Array[Int], e: Expr) : Expr / Mutable = {
  let k = prc_map_expr_kind(e.kind, (sub) => sr_expr(sites, sub))
  Expr { ...e, kind: k, site: site_next(sites) }
}
