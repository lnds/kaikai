#[doc("""
Site ids: the identity the unwinder keys each node it brackets by.

`sym_erase` gives every node of a declaration's bodies an id of its own
as it rebuilds them. A later pass that builds nodes or clones a subtree
renumbers the declaration it rewrote, so no two nodes of one declaration
share an id.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_map
import compiler.symtab
import compiler.util
import compiler.expr_positions
import compiler.operators
import compiler.spec_names
import compiler.fnreg
import compiler.written
import compiler.diag
import compiler.diag_file
import compiler.type_text
import compiler.core_builtins

#[doc("The next site id of a declaration's counter.")]
fn site_next(sites: Array[Int]) : Int / Mutable = {
  let n = sites[0] + 1
  let _ = array_set(sites, 0, n)
  n
}

#[doc("True when the unwinder can key a node of kind `k`: a call, an index, an operator, a `match`, a `!` or a `handle`. An `assert`'s condition is keyed too, whatever its kind.")]
fn site_keyed(k: ExprKind) : Bool = match k {
  ECall(_, _)     -> true
  EIndex(_, _)    -> true
  EBinop(_, _, _) -> true
  EMatch(_, _)    -> true
  EBang(_)        -> true
  EHandle(_, _, _, _, _, _, _) -> true
  _ -> false
}

#[doc("`d` with every node of its bodies given a fresh site id.")]
pub(pkg) fn site_renumber_decl(d: Decl) : Decl / Mutable = {
  let sites = array_make(1, 0)
  decl_map_bodies(d, (b) => sr_expr(sites, b))
}

fn sr_expr(sites: Array[Int], e: Expr) : Expr / Mutable = {
  let k = prc_map_expr_kind(e.kind, (sub) => sr_expr(sites, sub))
  Expr { ...e, kind: k, site: site_next(sites) }
}

#[doc("Report each site-capable node that shares its site id with another of its declaration or carries none; the exit status is the number found. `tab` names the declaration a finding is in.")]
pub(pkg) fn check_site_ids(decls: [Decl], tab: SymTab) : Int / Console = {
  let found = flat_map(decls, (d) => sic_decl(d, tab))
  each(found, (m) => eprint(m))
  list_length(found)
}

fn sic_decl(d: Decl, tab: SymTab) : [String] = sic_bad(map(decl_bodies(d), (b) => SicAt(b, false)), decl_label(d, tab), [], [])

# A node to check, and whether it is keyed whatever its kind (an `assert`'s condition).
type SicAt = SicAt(Expr, Bool)

fn sic_bad(es: [SicAt], d: String, seen: [Int], acc: [String]) : [String] = match es {
  [] -> acc
  [SicAt(e, forced), ...rest] -> {
    # A forced visit checks the condition alone; its children come with
    # the block's ordinary walk.
    let next = if forced { rest } else { list_append(sic_kids(e), rest) }
    if not (forced or site_keyed(e.kind)) { sic_bad(next, d, seen, acc) }
    else if e.site <= 0 or list_has_int(seen, e.site) { sic_bad(next, d, seen, [sic_msg(d, e), ...acc]) }
    else { sic_bad(next, d, [e.site, ...seen], acc) }
  }
}

# The children of `e`, plus an `assert`'s condition again as keyed when its
# kind alone would not be.
fn sic_kids(e: Expr) : [SicAt] = list_append(sic_asserts(e), map(xp_positions(e), (p) => match p { XP(_, c) -> SicAt(c, false) }))

fn sic_asserts(e: Expr) : [SicAt] = match e.kind {
  EBlock(ss, _) -> flat_map(ss, (s) => match s { SAssert(c, _) -> if site_keyed(c.kind) { [] } else { [SicAt(c, true)] }  _ -> [] })
  _ -> []
}

fn list_has_int(xs: [Int], x: Int) : Bool = match xs {
  [] -> false
  [y, ...rest] -> y == x or list_has_int(rest, x)
}

fn sic_msg(d: String, e: Expr) : String =
  concat_all(["site id ", int_to_string(e.site), " not unique in ", d, " at ", int_to_string(e.line), ":", int_to_string(e.col)])

#[doc("What a finding calls the declaration `d`: a function by its name.")]
fn decl_label(d: Decl, tab: SymTab) : String = match decl_transparent_inner(d) {
  Some(inner) -> decl_label(inner, tab)
  None -> match d {
    DFn(_, fid, _, _, _, _, _, _, _, _) -> "#{decl_name(tab, fnid_sym(fid))}"
    _ -> "a declaration"
  }
}

#[doc("Report each field read the typer left untyped; the exit status is the number found. `tab` names the declaration a finding is in.")]
pub(pkg) fn check_field_types(decls: [Decl], tab: SymTab) : Int / Console = {
  let found = flat_map(decls, (d) => ftc_bad(decl_bodies(d), decl_label(d, tab), []))
  each(found, (m) => eprint(m))
  list_length(found)
}

fn ftc_bad(es: [Expr], d: String, acc: [String]) : [String] = match es {
  [] -> acc
  [e, ...rest] -> {
    let next = list_append(map(xp_positions(e), (p) => match p { XP(_, c) -> c }), rest)
    match ftc_untyped(e) {
      Some(f) -> ftc_bad(next, d, [ftc_msg(d, f, e), ...acc])
      None    -> ftc_bad(next, d, acc)
    }
  }
}

# The field `e` reads, when it is a read with no type.
fn ftc_untyped(e: Expr) : Option[String] = match e.kind {
  EField(_, f) -> match e.ty {
    Some(TyAny) -> Some(f)
    None        -> Some(f)
    _           -> None
  }
  _ -> None
}

fn ftc_msg(d: String, f: String, e: Expr) : String =
  concat_all(["untyped field .", f, " in ", d, " at ", int_to_string(e.line), ":", int_to_string(e.col)])

#[doc("Report each `==` or `!=` whose operand holds a `Written`; the exit status is the number found.")]
pub(pkg) fn check_written_eq(decls: [Decl], tab: SymTab, specs: SpecNames) : Int / Console = {
  let held = wec_close(decls, tab, [sym_raw(wec_written())])
  let found = flat_map(decls, (d) => wec_decl(d, tab, specs, held))
  each(found, (m) => eprint(m))
  list_length(found)
}

# The opaque type's own declaration.
fn wec_written() : SymId = sym_derive(NCType, "Written", "compiler__written")

# Every declared type reaching `Written` through its fields or payloads,
# by id.
fn wec_close(decls: [Decl], tab: SymTab, held: [Int]) : [Int] = {
  let more = wec_grow(decls, tab, held, held)
  if list_length(more) == list_length(held) { held } else { wec_close(decls, tab, more) }
}

fn wec_grow(ds: [Decl], tab: SymTab, held: [Int], acc: [Int]) : [Int] = match ds {
  [] -> acc
  [d, ...rest] -> match decl_transparent_inner(d) {
    Some(inner) -> wec_grow([inner, ...rest], tab, held, acc)
    None -> match d {
      DType(_, s, _, body, _, _, _, _) ->
        if wec_has(acc, sym_raw(s)) or not any(wec_body_types(body), (t) => wec_te_holds(t, tab, held)) { wec_grow(rest, tab, held, acc) }
        else { wec_grow(rest, tab, held, [sym_raw(s), ...acc]) }
      _ -> wec_grow(rest, tab, held, acc)
    }
  }
}

fn wec_body_types(b: TypeBody) : [TypeExpr] = match b {
  TBAlias(t)   -> [t]
  TBRecord(fs) -> map(fs, (f) => match f { FD(_, _, t, _) -> t })
  TBSum(vs)    -> flat_map(vs, (v) => match v { Var(_, ts) -> ts })
  _            -> []
}

fn wec_has(held: [Int], id: Int) : Bool = match held {
  [] -> false
  [i, ...rest] -> (id >= 0 and i == id) or wec_has(rest, id)
}

fn wec_te_holds(t: TypeExpr, tab: SymTab, held: [Int]) : Bool = match t.tkind {
  TyName(r, args)    -> wec_ref_holds(r, tab, held) or any(args, (a) => wec_te_holds(a, tab, held))
  TyParam(_, args)   -> any(args, (a) => wec_te_holds(a, tab, held))
  TyList(x)          -> wec_te_holds(x, tab, held)
  TyDim(x, _)        -> wec_te_holds(x, tab, held)
  TyRefine(x, _)     -> wec_te_holds(x, tab, held)
  _                  -> false
}

# A field type still written counts as every type its name can denote:
# the audit reports one comparison too many rather than miss one.
fn wec_ref_holds(r: DeclRef, tab: SymTab, held: [Int]) : Bool = match r {
  DrSym(s)        -> wec_has(held, sym_raw(s))
  DrWritten(_, n) -> any(st_type_candidates(tab, written_text(n)), (s) => wec_has(held, sym_raw(s)))
}

fn wec_ty_holds(t: Ty, held: [Int]) : Bool = match t {
  TyCon(s, args)       -> wec_has(held, sym_raw(s)) or any(args, (a) => wec_ty_holds(a, held))
  TyListT(x)           -> wec_ty_holds(x, held)
  TyDimT(x, _)         -> wec_ty_holds(x, held)
  TyRefineT(x, _)      -> wec_ty_holds(x, held)
  TyUnion(parts)       -> any(parts, (p) => wec_ty_holds(p, held))
  _                    -> false
}

fn wec_decl(d: Decl, tab: SymTab, specs: SpecNames, held: [Int]) : [String] = match decl_transparent_inner(d) {
  Some(inner) -> wec_decl(inner, tab, specs, held)
  None -> match d {
    DFn(_, f, _, _, _, _, body, _, _, mo)    -> wec_expr([body], wec_label("#{fn_emit_name(tab, specs, f)}", mo), held, [])
    DConst(_, s, _, body, mo, _, _)          -> wec_expr([body], wec_label(written_text(decl_name(tab, s)), mo), held, [])
    DTest(n, body, _, _, mo)                 -> wec_expr([body], wec_label(n, mo), held, [])
    DImpl(_, _, _, subs, _, _, _, _)         -> flat_map(subs, (s) => wec_decl(s, tab, specs, held))
    _ -> []
  }
}

fn wec_label(n: String, mo: Option[String]) : String = match mo {
  Some(m) -> concat_all([m, ".", n])
  None    -> n
}

fn wec_expr(es: [Expr], at: String, held: [Int], acc: [String]) : [String] = match es {
  [] -> acc
  [e, ...rest] -> {
    let next = list_append(map(xp_positions(e), (p) => match p { XP(_, c) -> c }), rest)
    if wec_compares(e, held) { wec_expr(next, at, held, [wec_msg(at, e), ...acc]) }
    else { wec_expr(next, at, held, acc) }
  }
}

fn wec_compares(e: Expr, held: [Int]) : Bool = match e.kind {
  EBinop(op, a, b) -> binop_is_equality(op) and not wec_empty_list(a) and not wec_empty_list(b)
                      and (wec_opt_holds(a.ty, held) or wec_opt_holds(b.ty, held))
  _                -> false
}

# `xs == []` asks whether there is an element; it compares none.
fn wec_empty_list(e: Expr) : Bool = match e.kind {
  EList([]) -> true
  _         -> false
}

fn wec_opt_holds(t: Option[Ty], held: [Int]) : Bool = match t {
  Some(x) -> wec_ty_holds(x, held)
  None    -> false
}

fn wec_msg(at: String, e: Expr) : String =
  concat_all(["written-eq ", at, " ", int_to_string(e.line), ":", int_to_string(e.col)])

#[doc("An error for every `extern \"kai\"` declaration in `ds` whose source file, resolved through `df`, `may_declare` rejects, and for every declaration of a builtin whose `_borrow` sibling the ownership passes pick by name.")]
pub(pkg) fn kai_builtin_decl_diags(ds: [Decl], tab: SymTab, df: DiagFiles, may_declare: (String) -> Bool) : [Diagnostic] = match ds {
  []           -> []
  [d, ...rest] -> match kai_decl_site(d, tab) {
    Some(site) -> list_append(kai_site_diags(site, decl_diag_file(d, df), may_declare), kai_builtin_decl_diags(rest, tab, df, may_declare))
    None       -> kai_builtin_decl_diags(rest, tab, df, may_declare)
  }
}

# The name and position of an `extern "kai"` declaration, lowered or not.
type KaiSite = KS(String, Int, Int)

fn kai_decl_site(d: Decl, tab: SymTab) : Option[KaiSite] = match d {
  DAxiom(_, Some(AbiKai), name, _, _, _, _, _, l, c) -> Some(KS(name, l, c))
  DFn(_, fid, _, _, _, _, body, l, c, _) -> match body.kind {
    EExternBody(AbiKai, _) -> Some(KS(written_text(decl_name(tab, fnid_sym(fid))), l, c))
    _                      -> None
  }
  DDoc(_, _, inner, _, _) -> kai_decl_site(inner, tab)
  DAttr(_, inner, _, _)   -> kai_decl_site(inner, tab)
  _                       -> None
}

# `may_declare` resolves the path, so it runs only at a declaration.
fn kai_site_diags(site: KaiSite, file: String, may_declare: (String) -> Bool) : [Diagnostic] = match site {
  KS(name, l, c) ->
    if not may_declare(file) {
      [mk_diag(SevError, file, l, c, cat3("`extern \"kai\" fn ", name, "` declares a runtime builtin, which only the core modules and `seq` may do"), [])]
    } else { match core_borrow_variant(name) {
      Some(b) -> [mk_diag(SevError, file, l, c, concat_all(["`extern \"kai\" fn ", name, "` cannot be declared: the ownership passes rewrite its calls to `", b, "` by name"]), [])]
      None    -> []
    } }
}

#[doc("One manifest line per `extern \"kai\"` declaration among the loaded decls `ds`: `<name> <symbol> <arity> <signature>`, the signature as written, row included.")]
pub(pkg) fn kai_builtin_manifest(ds: [Decl], tab: SymTab) : [String] = match ds {
  []           -> []
  [d, ...rest] -> match kai_manifest_line(d, tab) {
    Some(l) -> [l, ...kai_builtin_manifest(rest, tab)]
    None    -> kai_builtin_manifest(rest, tab)
  }
}

fn kai_manifest_line(d: Decl, tab: SymTab) : Option[String] = match d {
  DFn(_, fid, tps, ps, Some(ret), row, body, _, _, _) -> match body.kind {
    EExternBody(AbiKai, sym) ->
      Some(concat_all([written_text(decl_name(tab, fnid_sym(fid))), " ", sym, " ", int_to_string(list_length(ps)), " ",
                       kai_scheme_text(tab, tps, ps, ret, row)]))
    _ -> None
  }
  DDoc(_, _, inner, _, _) -> kai_manifest_line(inner, tab)
  DAttr(_, inner, _, _)   -> kai_manifest_line(inner, tab)
  _                       -> None
}

fn kai_scheme_text(tab: SymTab, tps: [TBinder], ps: [Param], ret: TypeExpr, row: RowExpr) : String = {
  let tp_s = match tbs_declared(tps) { [] -> "" ds -> concat_all(["[", join_with(tbs_texts(ds), ", "), "]"]) }
  let row_s = match row { REmpty -> "" _ -> cat2(" / ", row_text_in(tab, tps, row)) }
  concat_all([tp_s, "(", join_with(map(ps, (p) => kai_param_text(tab, tps, p)), ", "), ") : ", type_text_in(tab, tps, ret), row_s])
}

fn kai_param_text(tab: SymTab, tps: [TBinder], p: Param) : String = match p.ptype {
  Some(t) -> concat_all([written_text(p.binder.name), ": ", type_text_in(tab, tps, t)])
  None    -> written_text(p.binder.name)
}
