#[doc("""
A literal suffix that writes a stdlib type needs that type's module.

`19.99d` is a `Decimal` and `99n` a `BigInt`. Both types are declared in
the stdlib, not built in, so the file that writes the literal imports the
module, in any form: opened, picked from, or bound to a qualifier.
""")]

import compiler.ast
import compiler.diag
import compiler.symtab_build
import compiler.scope_view
import compiler.core_types
import compiler.name_hidden

#[doc("The error for the expression `e` when it is a suffixed literal whose type's module the file seeing `view` does not import; nothing for any other expression. `file` is the path the error names.")]
pub fn suffix_import_diags(e: Expr, view: ScopeView, file: String) : [Diagnostic] =
  match suffix_ty(e) {
    None    -> []
    Some(t) ->
      if sv_imports(view, st_module_id(core_decl_ty_home(t))) { [] }
      else { [nh_literal_import_diag(file, e.line, e.col, t)] }
  }

# The `n` suffix reaches here lowered to a call of the one function a
# file cannot name by id itself.
fn suffix_ty(e: Expr) : Option[CoreDeclTy] = match e.kind {
  EDecimalLit(_) -> Some(CdDecimal)
  ECall(f, _)    -> if is_bigint_literal_fn(f) { Some(CdBigInt) } else { None }
  _              -> None
}

fn is_bigint_literal_fn(f: Expr) : Bool = match f.kind {
  ESym(s, _) -> sym_raw(s) == sym_raw(core_bigint_literal_fn())
  _          -> false
}
