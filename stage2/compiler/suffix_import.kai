#[doc("""
A literal that writes a stdlib type needs that type's module.

`19.99d` is a `Decimal`, `99n` a `BigInt` and `lazy [1, 2]` a `Seq`. The
types are declared in the stdlib, not built in, so the file that writes
the literal imports the module, in any form: opened, picked from, or
bound to a qualifier.
""")]

import compiler.ast
import compiler.diag
import compiler.symtab_build
import compiler.scope_view
import compiler.core_types
import compiler.name_hidden

#[doc("The error for the expression `e` when it is a literal of a stdlib type whose module the file seeing `view` does not import; nothing for any other expression. `file` is the path the error names.")]
pub fn suffix_import_diags(e: Expr, view: ScopeView, file: String) : [Diagnostic] =
  match suffix_ty(e) {
    None    -> []
    Some(t) ->
      if sv_imports(view, st_module_id(core_decl_ty_home(t))) { [] }
      else { [nh_literal_import_diag(file, e.line, e.col, t)] }
  }

# The `n` suffix reaches here lowered to a call of the one function a
# file cannot name by id itself, and a `lazy [...]` as the marked parts
# it is built from: the one that opens the literal stands for it.
fn suffix_ty(e: Expr) : Option[CoreDeclTy] = match e.kind {
  EDecimalLit(_) -> Some(CdDecimal)
  ECall(f, _)    -> match f.kind {
    ESym(s, _)          -> if sym_raw(s) == sym_raw(core_bigint_literal_fn()) { Some(CdBigInt) } else { None }
    EMark(MkLazy(head)) -> if head { Some(CdSeq) } else { None }
    _                   -> None
  }
  _              -> None
}
