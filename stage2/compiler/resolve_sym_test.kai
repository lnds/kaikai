#[doc("""
Gates on what the resolver stamps into the tree.

The subject is the rewritten declaration stream, not a side table: a
resolved reference is an `ESym` carrying the id, and that is what every
pass downstream reads. Asserting against anything else would test a
transport the compiler no longer has.

Each property is the negation of a defect the string-keyed resolver
kept reproducing: a call reaches its declaration, a binder shadows one,
a local is never stamped as a declaration, two homes declaring one name
reach two different ids, and a root-file body walked after a module's
declarations resolves from the root, not from that module.
""")]

import compiler.ast
import compiler.diag_file
import compiler.resolve
import compiler.symtab
import compiler.scope_chain_test

# `pub fn <n>() = <body>`, homed in `mo`.
fn rst_fn(n: String, mo: Option[String], body: Expr) : Decl =
  DFn(true, n, [], [], None, REmpty, body, 0, 0, mo, fnid_none())

# `fn <n>(<p>) = <body>` — the parameter is what shadows.
fn rst_fn1(n: String, p: String, body: Expr) : Decl =
  DFn(true, n, [], [rst_param(p)], None, REmpty, body, 0, 0, None, fnid_none())

fn rst_param(p: String) : Param =
  Param { pname: p, ptype: None, pline: 0, pcol: 0, pborrow: false }

fn rst_var(n: String) : Expr = mk_ref(n, 0, 0)

# The resolution of a decl list whose untagged decls are homed in `root`.
fn rst_run(ds: [Decl]) : Resolution / Console + File =
  resolve_program(diag_files_flat("t.kai"), ds, "root")

fn rst_resolve(ds: [Decl]) : [Decl] / Console + File = rst_run(ds).decls

# The body of the declaration named `n`.
fn rst_body_of(ds: [Decl], n: String) : Option[Expr] = match ds {
  [] -> None
  [d, ...rest] -> match d {
    DFn(_, dn, _, _, _, _, body, _, _, _, fsym) ->
      if dn == n { Some(body) } else { rst_body_of(rest, n) }
    _ -> rst_body_of(rest, n)
  }
}

# The id a body's reference carries, or `None` when it stayed a spelling.
fn rst_sym_in(ds: [Decl], caller: String) : Option[SymId] =
  match rst_body_of(ds, caller) {
    None    -> None
    Some(b) -> match b.kind { ESym(s, _, _) -> Some(s)  _ -> None }
  }

fn rst_is_sym(o: Option[SymId]) : Bool = match o {
  Some(_) -> true
  None    -> false
}

# A call to a declaration carries its id.
fn rst_call_reaches_decl() : Bool / Console + File {
  let ds = rst_resolve([rst_fn("helper", None, mk_expr(EUnit, 0, 0)),
                        rst_fn("caller", None, rst_var("helper"))])
  rst_is_sym(rst_sym_in(ds, "caller"))
}

# A parameter shadows a declaration of the same name, so the use stays a
# spelling: a local is not a declaration any consumer indexes.
fn rst_binder_shadows_decl() : Bool / Console + File {
  let ds = rst_resolve([rst_fn("x", None, mk_expr(EUnit, 0, 0)),
                        rst_fn1("caller", "x", rst_var("x"))])
  rst_is_sym(rst_sym_in(ds, "caller")) == false
}

# Two homes each declaring `dup`, each calling it: a reader reaches the
# declaration its own home owns, and the two ids differ — which no
# spelling can say.
fn rst_home_decides() : Bool / Console + File {
  let ds = rst_resolve([rst_fn("dup", Some("alpha"), mk_expr(EUnit, 0, 0)),
                        rst_fn("ua", Some("alpha"), rst_var("dup")),
                        rst_fn("dup", Some("beta"), mk_expr(EUnit, 0, 0)),
                        rst_fn("ub", Some("beta"), rst_var("dup"))])
  rst_ids_differ(rst_sym_in(ds, "ua"), rst_sym_in(ds, "ub"))
}

fn rst_ids_differ(a: Option[SymId], b: Option[SymId]) : Bool = match a {
  None    -> false
  Some(x) -> match b {
    None    -> false
    Some(y) -> sym_raw(x) != sym_raw(y)
  }
}

# The home `caller`'s reference reaches, or `""` when it stayed a spelling.
fn rst_home_in(ds: [Decl], caller: String) : String / Console + File {
  let r = rst_run(ds)
  match rst_sym_in(r.decls, caller) {
    Some(s) -> sym_home(r.tab, s)
    None    -> ""
  }
}

# Untagged decls after a module's decls are the root file's: a root call
# reaches the root declaration even when that module declares a homonym.
fn rst_root_shadows_module() : Bool / Console + File =
  rst_home_in([rst_fn("add", Some("complex"), mk_expr(EUnit, 0, 0)),
               rst_fn("add", None, mk_expr(EUnit, 0, 0)),
               rst_fn("caller", None, rst_var("add"))], "caller") == "root"

# The inverse: a root call to a name only the module declares reaches it.
fn rst_root_reaches_module() : Bool / Console + File =
  rst_home_in([rst_fn("conj", Some("complex"), mk_expr(EUnit, 0, 0)),
               rst_fn("caller", None, rst_var("conj"))], "caller") == "complex"

# The walk must stamp something: a stream whose every reference stayed a
# spelling is the state the pipeline was in before it was wired.
fn rst_walk_stamps() : Bool / Console + File {
  let ds = rst_resolve([rst_fn("helper", None, mk_expr(EUnit, 0, 0)),
                        rst_fn("caller", None, rst_var("helper"))])
  rst_is_sym(rst_sym_in(ds, "caller"))
}

#[doc("Runs every resolver stamping gate. Returns a line starting `OK` on success, `FAIL:` otherwise.")]
pub fn resolve_sym_selftest() : String / Console + File =
  if scope_chain_selftest() != "" { "FAIL: " ++ scope_chain_selftest() }
  else if rst_walk_stamps() == false { "FAIL: the resolver stamped no reference" }
  else if rst_call_reaches_decl() == false { "FAIL: a call to a declaration was not stamped" }
  else if rst_binder_shadows_decl() == false { "FAIL: a parameter did not shadow the declaration" }
  else if rst_home_decides() == false { "FAIL: two homes resolved one name to one symbol" }
  else if rst_root_shadows_module() == false { "FAIL: a root call reached a module homonym, not the root declaration" }
  else if rst_root_reaches_module() == false { "FAIL: a root call did not reach the module declaration it names" }
  else { "OK resolve-sym (7 gates)" }
