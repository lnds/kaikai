#[doc("""
Gates on what the resolver writes into the tree.

The subject is the rewritten declaration stream, not a side table: a
resolved reference is an `ESym` carrying the declaration's id or an
`ELocal` carrying the binder's, and that is what every pass downstream
reads.

Each property is the negation of a defect the string-keyed resolver
kept reproducing: a call reaches its declaration, a binder shadows one,
a local is never read as a declaration, two homes declaring one name
reach two different ids, and a root-file body walked after a module's
declarations resolves from the root, not from that module.
""")]

import compiler.ast
import compiler.diag_file
import compiler.resolve
import compiler.symtab
import compiler.symtab_build
import compiler.decl_names
import compiler.core_syms
import compiler.scope_chain_test
import compiler.written

# A function a gate declares: its name, its home (`None` for the root
# file), its parameters and its body.
type RstFn = RstFn(String, Option[String], [String], Expr)

# `pub fn <n>() = <body>`, homed in `mo`.
fn rst_fn(n: String, mo: Option[String], body: Expr) : RstFn = RstFn(n, mo, [], body)

# `fn <n>(<p>) = <body>` — the parameter is what shadows.
fn rst_fn1(n: String, p: String, body: Expr) : RstFn = RstFn(n, None, [p], body)

fn rst_home(mo: Option[String]) : String = match mo {
  Some(m) -> m
  None    -> "root"
}

fn rst_id(n: String, mo: Option[String]) : SymId = sym_derive(NCFn, n, rst_home(mo))

fn rst_decl(f: RstFn) : Decl = match f {
  RstFn(n, mo, ps, body) ->
    DFn(true, fnid_decl(rst_id(n, mo)), [], map(ps, rst_param), None, REmpty, body, 0, 0, mo)
}

fn rst_row(f: RstFn) : NEnt = match f { RstFn(n, mo, _, _) -> NEnt(NCFn, n, rst_home(mo), true) }

fn rst_param(p: String) : Param =
  Param { binder: binder_written(p), ptype: None, pline: 0, pcol: 0, pborrow: false }

fn rst_var(n: String) : Expr = mk_name(n, 0, 0)

# The resolution of the functions `fs`, the untagged ones homed in `root`.
fn rst_run(fs: [RstFn]) : Resolution / Console + File =
  resolve_program_with(diag_files_flat("t.kai"), map(fs, rst_decl), st_program(map(fs, rst_row)), "root")

fn rst_resolve(fs: [RstFn]) : [Decl] / Console + File = rst_run(fs).decls

# The body of the function `s` declares.
fn rst_body_of(ds: [Decl], s: SymId) : Option[Expr] = match ds {
  [] -> None
  [d, ...rest] -> match d {
    DFn(_, fid, _, _, _, _, body, _, _, _) ->
      if sym_raw(fnid_sym(fid)) == sym_raw(s) { Some(body) } else { rst_body_of(rest, s) }
    _ -> rst_body_of(rest, s)
  }
}

# The declaration a body's reference names, or `None` when it names none.
fn rst_sym_in(ds: [Decl], caller: SymId) : Option[SymId] =
  match rst_body_of(ds, caller) {
    None    -> None
    Some(b) -> match b.kind { ESym(s, _) -> Some(s)  _ -> None }
  }

fn rst_is_sym(o: Option[SymId]) : Bool = match o {
  Some(_) -> true
  None    -> false
}

# A call to a declaration carries its id.
fn rst_call_reaches_decl() : Bool / Console + File {
  let ds = rst_resolve([rst_fn("helper", None, mk_expr(EUnit, 0, 0)),
                        rst_fn("caller", None, rst_var("helper"))])
  rst_is_sym(rst_sym_in(ds, rst_id("caller", None)))
}

# A parameter shadows a declaration of the same name: the use is a read
# of the binder, never a reference to the declaration.
fn rst_binder_shadows_decl() : Bool / Console + File {
  let ds = rst_resolve([rst_fn("x", None, mk_expr(EUnit, 0, 0)),
                        rst_fn1("caller", "x", rst_var("x"))])
  match rst_body_of(ds, rst_id("caller", None)) {
    Some(b) -> match b.kind { ELocal(_) -> true  _ -> false }
    None    -> false
  }
}

# Two homes each declaring `dup`, each calling it: a reader reaches the
# declaration its own home owns, and the two ids differ — which no
# spelling can say.
fn rst_home_decides() : Bool / Console + File {
  let ds = rst_resolve([rst_fn("dup", Some("alpha"), mk_expr(EUnit, 0, 0)),
                        rst_fn("ua", Some("alpha"), rst_var("dup")),
                        rst_fn("dup", Some("beta"), mk_expr(EUnit, 0, 0)),
                        rst_fn("ub", Some("beta"), rst_var("dup"))])
  rst_ids_differ(rst_sym_in(ds, rst_id("ua", Some("alpha"))), rst_sym_in(ds, rst_id("ub", Some("beta"))))
}

fn rst_ids_differ(a: Option[SymId], b: Option[SymId]) : Bool = match a {
  None    -> false
  Some(x) -> match b {
    None    -> false
    Some(y) -> sym_raw(x) != sym_raw(y)
  }
}

# The home the root function `caller`'s reference reaches, or `""` when it names no declaration.
fn rst_home_in(fs: [RstFn], caller: String) : String / Console + File {
  let r = rst_run(fs)
  match rst_sym_in(r.decls, rst_id(caller, None)) {
    Some(s) -> written_text(sym_home(r.tab, s))
    None    -> ""
  }
}

# Untagged decls after a module's decls are the root file's: a root call
# reaches the root declaration even when that module declares a homonym.
fn rst_root_shadows_module() : Bool / Console + File =
  rst_home_in([rst_fn("add", Some("complex"), mk_expr(EUnit, 0, 0)),
               rst_fn("add", None, mk_expr(EUnit, 0, 0)),
               rst_fn("caller", None, rst_var("add"))], "caller") == "root"

# The inverse: a root call to a name only the module declares reaches it.
fn rst_root_reaches_module() : Bool / Console + File =
  rst_home_in([rst_fn("conj", Some("complex"), mk_expr(EUnit, 0, 0)),
               rst_fn("caller", None, rst_var("conj"))], "caller") == "complex"

# The walk must resolve something: a stream whose every reference stayed
# written is the state the pipeline was in before it was wired.
fn rst_walk_stamps() : Bool / Console + File {
  let ds = rst_resolve([rst_fn("helper", None, mk_expr(EUnit, 0, 0)),
                        rst_fn("caller", None, rst_var("helper"))])
  rst_is_sym(rst_sym_in(ds, rst_id("caller", None)))
}

#[doc("Runs every resolver stamping gate. Returns a line starting `OK` on success, `FAIL:` otherwise.")]
pub fn resolve_sym_selftest() : String / Console + File =
  if scope_chain_selftest() != "" { "FAIL: " ++ scope_chain_selftest() }
  else if rst_walk_stamps() == false { "FAIL: the resolver resolved no reference" }
  else if rst_call_reaches_decl() == false { "FAIL: a call to a declaration does not carry its id" }
  else if rst_binder_shadows_decl() == false { "FAIL: a parameter did not shadow the declaration" }
  else if rst_home_decides() == false { "FAIL: two homes resolved one name to one symbol" }
  else if rst_root_shadows_module() == false { "FAIL: a root call reached a module homonym, not the root declaration" }
  else if rst_root_reaches_module() == false { "FAIL: a root call did not reach the module declaration it names" }
  else { "OK resolve-sym (7 gates)" }
