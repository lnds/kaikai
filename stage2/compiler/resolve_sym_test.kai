#[doc("""
In-process gates for the resolver's use table, run behind
`--resolve-sym-selftest`.

`symtab_test.kai` proves the table answers correctly when asked. These
gates prove the resolver actually asks: they run the real walk over a
real declaration stream and read what it recorded.

That distinction is the whole point. The table, its builder and the
recording entry point can all be correct and still be dead, because
nothing in the pipeline calls them — which is what they were. A gate
over the table alone cannot tell the two states apart; a gate over the
walk can.

The properties:

1. **A call to a top-level declaration resolves to its symbol.** The
   resolver seeds declarations and the core into its outermost scope,
   so a naive "is this name in scope" test reads every such use as
   shadowed and records `URLocal`. A use that reaches `URSym` is the
   evidence the depth test is live.
2. **A binder shadows the declaration it hides.** The same name, bound
   as a parameter, records `URLocal` — so the two answers come from the
   binding structure and not from the spelling.
3. **A use resolves inside its own home.** Two homes declaring one name
   each answer their own reader, decided by owner id.
""")]

import compiler.ast
import compiler.ast_map
import compiler.diag_file
import compiler.resolve
import compiler.resolve_stamp
import compiler.symtab
import compiler.symtab_build
import compiler.usetab

# `fn <n>() = <body>`, homed in `mo`.
fn rst_fn(n: String, mo: Option[String], body: Expr) : Decl =
  DFn(true, n, [], [], None, REmpty, body, 0, 0, mo)

# `fn <n>(<p>) = <body>` — the parameter is what shadows.
fn rst_fn1(n: String, p: String, body: Expr) : Decl =
  DFn(true, n, [], [rst_param(p)], None, REmpty, body, 0, 0, None)

fn rst_param(p: String) : Param =
  Param { pname: p, ptype: None, pline: 0, pcol: 0, pborrow: false }

fn rst_var(n: String) : Expr = mk_expr(EVar(n), 0, 0)

# The resolution of a decl stream whose untagged decls are homed in
# `root`, with recording on.
fn rst_resolve(ds: [Decl]) : UseTab / Console + File =
  resolve_program(diag_files_flat("t.kai"), ds, "root").uses

# What the walk recorded for the first use site naming `n`.
fn rst_res_of(t: UseTab, n: String, i: Int) : Option[UseRes] =
  if i >= ut_count(t) { None }
  else if ut_name(t, i) == n { Some(ut_res(t, i)) }
  else { rst_res_of(t, n, i + 1) }

fn rst_is_sym(r: Option[UseRes]) : Bool = match r {
  Some(URSym(_)) -> true
  _              -> false
}

fn rst_is_local(r: Option[UseRes]) : Bool = match r {
  Some(URLocal) -> true
  _             -> false
}

fn rst_sym_id(r: Option[UseRes]) : Option[Int] = match r {
  Some(URSym(i)) -> Some(i)
  _              -> None
}

# A bare call to a declared function must reach that declaration, not
# read as a local. This is the gate that fails when the resolver treats
# its own pre-registered declarations as binders.
fn rst_call_reaches_decl() : Bool / Console + File {
  let uses = rst_resolve([rst_fn("helper", None, mk_expr(EUnit, 0, 0)),
                          rst_fn("caller", None, rst_var("helper"))])
  rst_is_sym(rst_res_of(uses, "helper", 0))
}

# The same name bound as a parameter is a local, so the declaration it
# hides is not what the use names.
fn rst_binder_shadows_decl() : Bool / Console + File {
  let uses = rst_resolve([rst_fn("x", None, mk_expr(EUnit, 0, 0)),
                          rst_fn1("caller", "x", rst_var("x"))])
  rst_is_local(rst_res_of(uses, "x", 0))
}

# Two homes each declaring `dup`, each calling it: every use resolves,
# and a reader reaches the declaration its own home owns.
fn rst_home_decides() : Bool / Console + File {
  let uses = rst_resolve([rst_fn("dup", Some("alpha"), mk_expr(EUnit, 0, 0)),
                          rst_fn("ua", Some("alpha"), rst_var("dup")),
                          rst_fn("dup", Some("beta"), mk_expr(EUnit, 0, 0)),
                          rst_fn("ub", Some("beta"), rst_var("dup"))])
  rst_two_homes_differ(uses)
}

# Both uses spell `dup`; the ids must differ, which no spelling can say.
fn rst_two_homes_differ(t: UseTab) : Bool = match rst_sym_ids(t, "dup", 0, []) {
  [a, b] -> a != b
  _      -> false
}

fn rst_sym_ids(t: UseTab, n: String, i: Int, acc: [Int]) : [Int] =
  if i >= ut_count(t) { list_reverse(acc) }
  else if ut_name(t, i) == n {
    match rst_sym_id(Some(ut_res(t, i))) {
      Some(s) -> rst_sym_ids(t, n, i + 1, [s, ...acc])
      None    -> rst_sym_ids(t, n, i + 1, acc)
    }
  } else { rst_sym_ids(t, n, i + 1, acc) }

# The walk must record something: an empty table means the resolution
# never ran, the state the pipeline was in before it was wired.
fn rst_walk_records() : Bool / Console + File {
  let uses = rst_resolve([rst_fn("helper", None, mk_expr(EUnit, 0, 0)),
                          rst_fn("caller", None, rst_var("helper"))])
  ut_count(uses) > 0
}

# A call to a declaration must come out of the stamper carrying an id,
# and a binder must not. This is what separates a table that answers
# from one the tree actually reads.
fn rst_stamps_call() : Bool {
  let ds = [rst_fn("helper", None, mk_expr(EUnit, 0, 0)),
            rst_fn("caller", None, rst_var("helper"))]
  rst_body_is_sym(stamp_decls(ds, st_build(ds, "root"), "root"), "caller")
}

fn rst_stamps_not_binder() : Bool {
  let ds = [rst_fn("x", None, mk_expr(EUnit, 0, 0)),
            rst_fn1("caller", "x", rst_var("x"))]
  rst_body_is_sym(stamp_decls(ds, st_build(ds, "root"), "root"), "caller") == false
}

# The id a stamped reference carries must be the row that declares it,
# so the tree and the table agree rather than merely both existing.
fn rst_stamped_id_is_the_decl() : Bool {
  let ds = [rst_fn("helper", None, mk_expr(EUnit, 0, 0)),
            rst_fn("caller", None, rst_var("helper"))]
  let t = st_build(ds, "root")
  match rst_body_sym(stamp_decls(ds, t, "root"), "caller") {
    None    -> false
    Some(i) -> sym_name(t, i) == "helper" and sym_home(t, i) == "root"
  }
}

fn rst_body_is_sym(ds: [Decl], want: String) : Bool =
  match rst_body_sym(ds, want) { Some(_) -> true  None -> false }

fn rst_body_sym(ds: [Decl], want: String) : Option[SymId] = match ds {
  [] -> None
  [d, ...rest] -> match d {
    DFn(_, n, _, _, _, _, body, _, _, _) ->
      if n == want { rst_sym_of_expr(body) } else { rst_body_sym(rest, want) }
    _ -> rst_body_sym(rest, want)
  }
}

fn rst_sym_of_expr(e: Expr) : Option[SymId] = match e.kind {
  ESym(i, _) -> Some(i)
  _          -> None
}

#[doc("Runs every resolver use-table gate. Returns a line starting `OK` on success, `FAIL:` otherwise.")]
pub fn resolve_sym_selftest() : String / Console + File =
  if rst_walk_records() == false { "FAIL: the resolver recorded no use sites" }
  else if rst_call_reaches_decl() == false { "FAIL: a call to a declaration recorded as a local" }
  else if rst_binder_shadows_decl() == false { "FAIL: a parameter did not shadow the declaration" }
  else if rst_home_decides() == false { "FAIL: two homes resolved one name to one symbol" }
  else if rst_stamps_call() == false { "FAIL: a resolved call was not stamped with its identity" }
  else if rst_stamps_not_binder() == false { "FAIL: a binder was stamped as a declaration" }
  else if rst_stamped_id_is_the_decl() == false { "FAIL: a stamped id does not name its declaration" }
  else { "OK resolve-sym (7 gates)" }
