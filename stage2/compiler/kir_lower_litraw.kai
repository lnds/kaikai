import compiler.ast_ids
import compiler.ast
import compiler.kir
import compiler.kir_lower
import compiler.kir_lower_raw
import compiler.kir_lower_scalar
import compiler.kir_lower_sig

#[doc("A literal match's scrutinee read once as a raw scalar, with the scalar it carries.")]
pub(pkg) type LitRaw = LitRaw(RawScalar, KVal)

fn lit_scalar_of(t: Option[Ty]) : Option[RawScalar] =
  if kir_ty_is_int(t) {
    Some(RwInt)
  } else if kir_ty_is_char(t) {
    Some(RwChar)
  } else if kir_ty_is_byte(t) {
    Some(RwByte)
  } else if kir_ty_is_bool(t) {
    Some(RwBool)
  } else if kir_ty_is_real(t) {
    Some(RwReal)
  } else {
    None
  }

fn lit_fits(rw: RawScalar, lit: KVal) : Bool = match (rw, lit) {
  (RwInt, KIntV(_)) -> true
  (RwChar, KCharV(_)) -> true
  (RwBool, KBoolV(_)) -> true
  (RwReal, KRealV(_)) -> true
  (RwByte, KFixedV(_, _)) -> true
  _ -> false
}

#[doc("Unbox a primitive-typed scrutinee once, so each literal arm is a raw compare.")]
pub(pkg) fn lit_raw_scrut(scr: Expr, scrv: KVal, st: LowerSt) : (Option[LitRaw], LowerSt) =
  match lit_scalar_of(scr.ty) {
    None -> (None, st)
    Some(rw) -> match bind_op_slot(st, KPrim(KpUnbox(rw), [scrv]), border_slot_of(scr.ty), kpos_of(scr)) {
      LRes(rv, st1) -> (Some(LitRaw(rw, rv)), st1)
    }
  }

#[doc("Seal `condbr (raw ==) ? ok : fail` when the literal fits the raw scalar; None otherwise.")]
pub(pkg) fn lit_seal_raw_eq(
  raw: Option[LitRaw],
  lit: KVal,
  ok_lbl: String,
  fail_lbl: String,
  pos: KPos,
  st: LowerSt
) : Option[LowerSt] = match raw {
  Some(LitRaw(rw, rv)) ->
    if lit_fits(rw, lit) {
      match bind_op_slot(st, KPrim(KpRawBin(rw, BoEq), [rv, lit]), SBool, pos) {
        LRes(cond, st1) -> Some(ls_seal(st1, KCondBr(cond, ok_lbl, fail_lbl, pos), fail_lbl))
      }
    } else {
      None
    }
  None -> None
}
