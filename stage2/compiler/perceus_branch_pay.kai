#[doc("""
Branch payers for single-read binders.

A match-arm or `let` binder read exactly once, by a bare move, hands its
birth reference on at that read. When the read sits behind `if` / `match`
alternatives, a path through a sibling alternative never reaches it, so
each such alternative releases the binder on entry. The entry drop leaves
the alternative's own value, and any self-call in it, in tail position.

A binder qualifies when the read table has exactly one read of it,
outside any lambda.
""")]

import compiler.ast
import compiler.ast_map
import compiler.expr_positions
import compiler.infer
import compiler.perceus_payer
import compiler.perceus_reads
import compiler.sym_read
import compiler.util

type PbpCx = { pnames: [String], uses: [Use] }

#[doc("Release each qualifying arm and `let` binder on entry to the alternatives that skip its single read.")]
pub fn pbp_branch_drops(body: Expr, pnames: [String], uses: [Use]) : Expr =
  pbp_expr(body, PbpCx { pnames: pnames, uses: uses })

fn pbp_expr(e: Expr, cx: PbpCx) : Expr = {
  let k1 = prc_map_expr_kind(e.kind, (c) => pbp_expr(c, cx))
  pbp_rekind(e, match k1 {
    EMatch(s, arms) -> EMatch(s, map(arms, (a) => pbp_arm(a, cx)))
    EBlock(ss, ot)  -> pbp_block(ss, ot, cx)
    _               -> k1
  })
}

fn pbp_arm(a: Arm, cx: PbpCx) : Arm = match a {
  Arm(pat, og, body) -> Arm(pat, og, pbp_pay_all(prc_pat_bindings(pat, []), body, cx))
}

fn pbp_pay_all(names: [String], scope: Expr, cx: PbpCx) : Expr = match names {
  []            -> scope
  [nm, ...rest] -> pbp_pay_all(rest, pbp_pay(nm, scope, cx), cx)
}

fn pbp_block(ss: [Stmt], ot: Option[Expr], cx: PbpCx) : ExprKind = match ss {
  []           -> EBlock([], ot)
  [s, ...rest] -> match pbp_block(rest, ot, cx) {
    EBlock(rest1, ot1) -> pbp_let(s, rest1, ot1, cx)
    k                  -> k
  }
}

fn pbp_let(s: Stmt, rest: [Stmt], ot: Option[Expr], cx: PbpCx) : ExprKind = match pbp_let_owner(s) {
  None     -> EBlock([s, ...rest], ot)
  Some(nm) -> match pbp_pay(nm, mk_expr(EBlock(rest, ot), 0, 0), cx).kind {
    EBlock(rest1, ot1) -> EBlock([s, ...rest1], ot1)
    _                  -> EBlock([s, ...rest], ot)
  }
}

# A raw `let` carries no rc, so it has no birth reference to release.
fn pbp_let_owner(s: Stmt) : Option[String] = match s {
  SLet(pat, _, rhs) -> match pat.pkind {
    PBind(nm) -> if pbp_is_raw(rhs) { None } else { Some(nm) }
    _         -> None
  }
  _ -> None
}

fn pbp_is_raw(e: Expr) : Bool = match e.mode {
  MUnboxed -> true
  _        -> false
}

fn pbp_pay(nm: String, scope: Expr, cx: PbpCx) : Expr =
  if pbp_qualifies(nm, cx) {
    match pbp_plant(nm, scope) {
      PbPaid(e) -> e
      _         -> scope
    }
  } else { scope }

fn pbp_qualifies(nm: String, cx: PbpCx) : Bool =
  not name_is_unused_binder(nm) and not list_has(cx.pnames, nm) and pcs_read_once(nm, cx.uses)

# Planting outcome: the read is not a plain move reachable here, it is
# reached through plain positions only (nothing to release), or `e` rebuilt
# with the skipping alternatives paying on entry.
type PbpOut = PbDecline | PbSame | PbPaid(Expr)

# A short circuit, lambda, handler clause or assert message hides the path;
# a dup'd read leaves the birth reference owed; a guard read can fall
# through to a later arm. Each declines.
fn pbp_plant(nm: String, e: Expr) : PbpOut = match e.kind {
  EVar(u)         -> if u == nm { PbSame } else { PbDecline }
  EIf(c, t, oe)   -> pbp_plant_if(nm, e, c, t, oe)
  EMatch(s, arms) -> pbp_plant_match(nm, e, s, arms)
  ECall(f, _)     -> if pbp_is_dup(f) { PbDecline } else { pbp_plant_plain(nm, e) }
  _               -> pbp_plant_plain(nm, e)
}

# Through a plain position: rebuild only when something below was paid.
fn pbp_lift(o: PbpOut, f: (Expr) -> Expr) : PbpOut = match o {
  PbPaid(x) -> PbPaid(f(x))
  _         -> o
}

# Through an alternative: the siblings pay even when the path below is plain.
fn pbp_branch(o: PbpOut, alt: Expr, f: (Expr) -> Expr) : PbpOut = match o {
  PbDecline -> PbDecline
  PbSame    -> PbPaid(f(alt))
  PbPaid(x) -> PbPaid(f(x))
}

fn pbp_plant_plain(nm: String, e: Expr) : PbpOut = match pbp_reader(nm, xp_positions(e)) {
  Some(XP(XAll, c)) ->
    pbp_lift(pbp_plant(nm, c), (c1) => pbp_rekind(e, prc_map_expr_kind(e.kind, (x) => if pcs_mentions(nm, x) { c1 } else { x })))
  _ -> PbDecline
}

fn pbp_plant_if(nm: String, e: Expr, c: Expr, t: Expr, oe: Option[Expr]) : PbpOut =
  if pcs_mentions(nm, c) { pbp_lift(pbp_plant(nm, c), (c1) => pbp_rekind(e, EIf(c1, t, oe))) }
  else if pcs_mentions(nm, t) {
    pbp_branch(pbp_plant(nm, t), t, (t1) => pbp_rekind(e, EIf(c, t1, Some(pbp_entry_drop(nm, pbp_else(t, oe))))))
  }
  else { pbp_plant_else(nm, e, c, t, oe) }

fn pbp_plant_else(nm: String, e: Expr, c: Expr, t: Expr, oe: Option[Expr]) : PbpOut = match oe {
  Some(e1) -> pbp_branch(pbp_plant(nm, e1), e1, (e2) => pbp_rekind(e, EIf(c, pbp_entry_drop(nm, t), Some(e2))))
  None     -> PbDecline
}

fn pbp_else(t: Expr, oe: Option[Expr]) : Expr = match oe {
  Some(e1) -> e1
  None     -> Expr { kind: EUnit, line: t.line, col: t.col, ty: t.ty, mode: t.mode }
}

fn pbp_plant_match(nm: String, e: Expr, s: Expr, arms: [Arm]) : PbpOut =
  if pcs_mentions(nm, s) { pbp_lift(pbp_plant(nm, s), (s1) => pbp_rekind(e, EMatch(s1, arms))) }
  else if pbp_guards_mention(nm, arms) { PbDecline }
  else {
    match pbp_reading_body(nm, arms) {
      Some(b) -> pbp_branch(pbp_plant(nm, b), b, (b1) => pbp_rekind(e, EMatch(s, pbp_pay_arms(nm, arms, b1))))
      None    -> PbDecline
    }
  }

fn pbp_reading_body(nm: String, arms: [Arm]) : Option[Expr] = match arms {
  []                      -> None
  [Arm(_, _, b), ...rest] -> if pcs_mentions(nm, b) { Some(b) } else { pbp_reading_body(nm, rest) }
}

# The reading arm takes its planted body `b1`; every other arm releases on entry.
fn pbp_pay_arms(nm: String, arms: [Arm], b1: Expr) : [Arm] = map(arms, (a) => match a {
  Arm(p, og, b) -> Arm(p, og, if pcs_mentions(nm, b) { b1 } else { pbp_entry_drop(nm, b) })
})

fn pbp_guards_mention(nm: String, arms: [Arm]) : Bool = match arms {
  []                       -> false
  [Arm(_, og, _), ...rest] -> match og {
    Some(g) -> pcs_mentions(nm, g) or pbp_guards_mention(nm, rest)
    None    -> pbp_guards_mention(nm, rest)
  }
}

fn pbp_entry_drop(nm: String, alt: Expr) : Expr =
  Expr { kind: EBlock([pcs_make_drop_stmt(nm, alt.line, alt.col)], Some(alt)),
         line: alt.line, col: alt.col, ty: alt.ty, mode: alt.mode }

fn pbp_is_dup(f: Expr) : Bool = match sym_read_kind(f.kind) {
  EVar(c) -> c == "__perceus_dup"
  _       -> false
}

fn pbp_reader(nm: String, ps: [XPos]) : Option[XPos] = match ps {
  []                  -> None
  [XP(r, c), ...rest] -> if pcs_mentions(nm, c) { Some(XP(r, c)) } else { pbp_reader(nm, rest) }
}

fn pbp_rekind(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode }
