#[doc("""
Branch payers for binders read at most once per path.

A match-arm or `let` binder whose every read is a bare move, never two on
one path, hands its birth reference on at whichever read its path reaches.
A path that reaches none releases it on entry to the alternative that
skips the reads (`compiler.perceus_branch_plant`).

A binder qualifies when the read table has exactly one read of it outside
any lambda, or when the caller moves every read of it (`moved`). A param
qualifies when the caller names its read as the payer (`read_params`).
An arm binder whose one read is its own guard is not the body's to pay.
""")]

import compiler.ast
import compiler.ast_map
import compiler.expr_positions
import compiler.infer
import compiler.marks
import compiler.perceus_branch_plant
import compiler.perceus_reads

type PbpCx = { pnames: [Binder], uses: UseIx, moved: [Binder] }

#[doc("Release each qualifying arm binder, `let` binder and read-paid param on entry to the alternatives that skip all of its reads.")]
pub fn pbp_branch_drops(body: Expr, pnames: [Binder], uses: UseIx, moved: [Binder], read_params: [Binder]) : Expr =
  pbp_params(read_params, pbp_expr(body, PbpCx { pnames: pnames, uses: uses, moved: moved }))

fn pbp_params(ps: [Binder], body: Expr) : Expr = match ps {
  []           -> body
  [p, ...rest] -> pbp_params(rest, pbl_paid(p, body))
}

fn pbp_expr(e: Expr, cx: PbpCx) : Expr = {
  let k1 = prc_map_expr_kind(e.kind, (c) => pbp_expr(c, cx))
  pbp_rekind(e, match k1 {
    EMatch(s, arms) -> EMatch(s, map(arms, (a) => pbp_arm(a, cx)))
    EBlock(ss, ot)  -> pbp_block(ss, ot, cx)
    _               -> k1
  })
}

fn pbp_arm(a: Arm, cx: PbpCx) : Arm = match a {
  Arm(pat, og, body) -> Arm(pat, og, pbp_pay_all(pbp_body_owed(prc_pat_bindings(pat, []), og, cx), body, cx))
}

# A binder whose single read sits in its own arm's guard reaches the body
# already paid: a bare guard read moved it, a dup'd one left it to the arm drop.
fn pbp_body_owed(names: [Binder], og: Option[Expr], cx: PbpCx) : [Binder] = match og {
  None    -> names
  Some(g) -> filter(names, (nm) => not (pcs_read_once(nm.id, cx.uses) and pbp_reads(nm, g)))
}

# `pcs_mentions` minus the guard-fail drops already planted in the guard.
fn pbp_reads(nm: Binder, e: Expr) : Bool = match e.kind {
  ELocal(u)      -> local_eq(u, nm.id)
  EStr(span, t3) -> pcs_interp_ident_count(nm, span, t3) > 0
  ECall(f, _)    -> not pbp_is_drop(f) and pbp_reads_ps(nm, xp_positions(e))
  _              -> pbp_reads_ps(nm, xp_positions(e))
}

fn pbp_reads_ps(nm: Binder, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> pbp_reads(nm, c) or pbp_reads_ps(nm, rest)
}

fn pbp_is_drop(f: Expr) : Bool = match f.kind {
  EMark(m) -> mark_is_drop(m)
  _        -> false
}

fn pbp_pay_all(names: [Binder], scope: Expr, cx: PbpCx) : Expr = match names {
  []            -> scope
  [nm, ...rest] -> pbp_pay_all(rest, pbp_pay(nm, scope, cx), cx)
}

fn pbp_block(ss: [Stmt], ot: Option[Expr], cx: PbpCx) : ExprKind = match ss {
  []           -> EBlock([], ot)
  [s, ...rest] -> match pbp_block(rest, ot, cx) {
    EBlock(rest1, ot1) -> pbp_let(s, rest1, ot1, cx)
    k                  -> k
  }
}

fn pbp_let(s: Stmt, rest: [Stmt], ot: Option[Expr], cx: PbpCx) : ExprKind = match pbp_let_owner(s) {
  None     -> EBlock([s, ...rest], ot)
  Some(nm) -> match pbp_pay(nm, mk_expr(EBlock(rest, ot), 0, 0), cx).kind {
    EBlock(rest1, ot1) -> EBlock([s, ...rest1], ot1)
    _                  -> EBlock([s, ...rest], ot)
  }
}

# A raw `let` carries no rc, so it has no birth reference to release.
fn pbp_let_owner(s: Stmt) : Option[Binder] = match s {
  SLet(pat, _, rhs) -> match pat.pkind {
    PBind(nm) -> if pbp_is_raw(rhs) { None } else { Some(nm) }
    _         -> None
  }
  _ -> None
}

fn pbp_is_raw(e: Expr) : Bool = match e.mode {
  MUnboxed -> true
  _        -> false
}

fn pbp_pay(nm: Binder, scope: Expr, cx: PbpCx) : Expr =
  if pbp_qualifies(nm, cx) { pbl_paid(nm, scope) } else { scope }

fn pbp_qualifies(nm: Binder, cx: PbpCx) : Bool =
  not pcs_has(cx.pnames, nm.id) and
  (pcs_read_once(nm.id, cx.uses) or pcs_has(cx.moved, nm.id))

fn pbp_rekind(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
