# compiler/live_fns.kai -- the functions a typed program can run.
#
# A function runs when a decl that is not a function names it (the tests,
# constants and effect default handlers), when the entry point does, or
# when a running function does. A dispatcher picks an impl at run time, so one
# that runs reaches every impl of the operation it stands for. The answer
# reads only the bodies of functions that run, so a build that lowered the
# whole core and one that lowered only what the program reaches agree.

import compiler.ast
import compiler.written
import compiler.expr_positions
import compiler.infer_index
import compiler.proto_ids
import compiler.core_reach

#[doc("The decls of `decls` that can run: every decl that is not a function, the entry point `entry`, and each function they name, transitively. `ids` says which functions are dispatchers and impl methods.")]
pub fn live_decls(decls: [Decl], ids: ProtoIds, entry: SymId) : [Decl] = {
  let fns = filter(decls, lf_is_fn)
  let st0 = LfSt { live: idx_empty(), fns: lf_index(fns, idx_empty()), impls: lf_impls(fns, ids, idx_empty()), work: [] }
  let st = lf_drain(lf_decls(filter(decls, (d) => not lf_is_fn(d)), lf_ref(st0, fnid_decl(entry))))
  filter(decls, (d) => not lf_is_fn(d) or lf_in(st.live, lf_id(d)))
}

# `fns` holds each function under its declaration; `impls` each impl
# method under the dispatcher of the operation it implements.
type LfSt = { live: NameIndex[FnId], fns: NameIndex[Decl], impls: NameIndex[FnId], work: [Decl] }

fn lf_is_fn(d: Decl) : Bool = match d {
  DFn(_, _, _, _, _, _, _, _, _, _) -> true
  _ -> false
}

fn lf_id(d: Decl) : FnId = match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) -> fid
  _ -> fnid_none()
}

fn lf_index(fns: [Decl], ix: NameIndex[Decl]) : NameIndex[Decl] = match fns {
  [] -> ix
  [d, ...rest] -> lf_index(rest, idx_prepend_sym(ix, fnid_sym(lf_id(d)), d))
}

fn lf_impls(fns: [Decl], ids: ProtoIds, ix: NameIndex[FnId]) : NameIndex[FnId] = match fns {
  [] -> ix
  [d, ...rest] -> lf_impls(rest, ids, match lf_impl_disp(ids, fnid_sym(lf_id(d))) {
    Some(disp) -> idx_prepend_sym(ix, disp, lf_id(d))
    None       -> ix
  })
}

# The dispatcher that reaches the impl method `s`, or `None` when `s` is no impl method.
fn lf_impl_disp(ids: ProtoIds, s: SymId) : Option[SymId] = match pid_impl(ids, s) {
  Some(PIR(proto, _, op, _, _, _, _)) -> pid_op_disp(ids, proto, written_text(op))
  None                                -> None
}

fn lf_in(ix: NameIndex[FnId], f: FnId) : Bool = any(idx_chain_sym(ix, fnid_sym(f)), (g) => fnid_eq(g, f))

fn lf_ref(st: LfSt, f: FnId) : LfSt =
  if sym_raw(fnid_sym(f)) < 0 or lf_in(st.live, f) { st }
  else {
    LfSt { ...st, live: idx_prepend_sym(st.live, fnid_sym(f), f),
                  work: list_append(filter(idx_chain_sym(st.fns, fnid_sym(f)), (d) => fnid_eq(lf_id(d), f)), st.work) }
  }

fn lf_refs(st: LfSt, fs: [FnId]) : LfSt = match fs {
  [] -> st
  [f, ...rest] -> lf_refs(lf_ref(st, f), rest)
}

fn lf_drain(st: LfSt) : LfSt = match st.work {
  [] -> st
  [d, ...rest] -> lf_drain(lf_decls([d], LfSt { ...st, work: rest }))
}

# A function that runs and is a dispatcher reaches its operation's impls.
fn lf_decls(ds: [Decl], st: LfSt) : LfSt = match ds {
  [] -> st
  [d, ...rest] -> {
    let st1 = lf_exprs(cr_decl_exprs(d), st)
    lf_decls(rest, lf_refs(st1, idx_chain_sym(st1.impls, fnid_sym(lf_id(d)))))
  }
}

fn lf_exprs(es: [Expr], st: LfSt) : LfSt = match es {
  [] -> st
  [e, ...rest] -> lf_exprs(rest, lf_expr(e, st))
}

fn lf_expr(e: Expr, st: LfSt) : LfSt = match e.kind {
  ESym(s, inst) -> lf_ref(st, FnId(s, inst))
  _             -> lf_positions(xp_positions(e), st)
}

fn lf_positions(ps: [XPos], st: LfSt) : LfSt = match ps {
  [] -> st
  [XP(_, x), ...rest] -> lf_positions(rest, lf_expr(x, st))
}
