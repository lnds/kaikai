#[doc("The sites `kai migrate` rewrites through the resolver: the root file's calls of a core file operation name that the resolver bound to nothing, and its constants spelled against the naming convention with every use the resolver bound to them.")]

import compiler.ast
import compiler.ast_binders
import compiler.ast_decl
import compiler.ast_ids
import compiler.diag
import compiler.diag_file
import compiler.expr_positions
import compiler.migrate
import compiler.migrate_tparams
import compiler.parse_naming
import compiler.resolve_names
import compiler.symtab
import compiler.util
import compiler.written

#[doc("The positions in `file` where the resolver reported a bare file-operation name as unbound.")]
pub(pkg) fn migrate_core_sites(diags: [Diagnostic], file: String) : [CoreSite] =
  flat_map(diags, (d) => diag_site(d, file))

fn diag_site(d: Diagnostic, file: String) : [CoreSite] = match d {
  D(_, f, l, c, m, _) -> if f == file and is_unbound_file_op(m, file_op_names()) { [CSite(l, c)] } else { [] }
}

fn is_unbound_file_op(msg: String, names: [String]) : Bool = match names {
  [] -> false
  [n, ...rest] -> if msg == unbound_msg(n) { true } else { is_unbound_file_op(msg, rest) }
}

#[doc("A place the root file names a constant spelled against the naming convention: its line, column, name and the last segment of its home module. A declaration and every use the resolver bound to it are sites.")]
pub(pkg) type ConstSite = ConstSite(Int, Int, String, String)

#[doc("The declarations and uses, in the root file, of constants not spelled UPPER_SNAKE. A use is a site only when the resolver bound it to such a constant, so a homonym of another kind is never one.")]
pub(pkg) fn migrate_const_sites(decls: [Decl], tab: SymTab, root_mod: String) : [ConstSite] =
  flat_map(decls, (d) => if decl_in_root(d, root_mod) { decl_const_sites(d, tab) } else { [] })

fn decl_in_root(d: Decl, root_mod: String) : Bool = match decl_home_module(d) {
  None -> true
  Some(m) -> m == root_mod
}

fn decl_const_sites(d: Decl, tab: SymTab) : [ConstSite] = match decl_transparent_inner(d) {
  Some(inner) -> decl_const_sites(inner, tab)
  None -> list_append(const_head_site(d, tab), flat_map(decl_exprs(d), (e) => expr_const_sites(e, tab)))
}

fn const_head_site(d: Decl, tab: SymTab) : [ConstSite] = match d {
  DConst(_, s, _, _, _, l, c) -> bad_const_site(s, l, c, tab)
  _ -> []
}

fn bad_const_site(s: SymId, line: Int, col: Int, tab: SymTab) : [ConstSite] = {
  let name = written_text(sym_name(tab, s))
  if st_valid(tab, s) and name_bad(NkConst, name) { [ConstSite(line, col, name, last_segment(written_text(sym_name(tab, sym_owner(tab, s)))))] } else { [] }
}

fn last_segment(path: String) : String = last_segment_from(path, string_length(path))

fn last_segment_from(path: String, i: Int) : String = match char_at(path, i - 1) {
  None -> path
  Some('.') -> string_slice(path, i, string_length(path) - i)
  Some(_) -> last_segment_from(path, i - 1)
}

fn expr_const_sites(e: Expr, tab: SymTab) : [ConstSite] = {
  let here = match e.kind {
    ESym(s, _) -> if st_valid(tab, s) and ncls_same(sym_class(tab, s), NCConst) { bad_const_site(s, e.line, e.col, tab) } else { [] }
    _ -> []
  }
  list_append(here, flat_map(xp_positions(e), (p) => match p { XP(_, child) -> expr_const_sites(child, tab) }))
}

#[doc("The spans that respell each site's name in upper case, at the position the resolver recorded for it.")]
pub(pkg) fn const_spans(src: String, sites: [ConstSite]) : [Span] =
  flat_map(sites, (s) => site_spans(src, s))

#[doc("The source with `spans` applied, in offset order; two spans at one offset count once.")]
pub(pkg) fn respell(src: String, spans: [Span]) : String =
  respell_at(src, foldl(spans, [], insert_span), 0, [])

#[doc("The spans that respell the root file's uppercase type parameters: those the binding pass bound, never a spelling that merely matches.")]
pub(pkg) fn migrate_tparam_spans(decls: [Decl], tab: SymTab, root_mod: String, src: String) : [Span] =
  tparam_spans(src, flat_map(decls, (d) => if decl_in_root(d, root_mod) { decl_facts(d, tab) } else { [] }))

fn site_spans(src: String, s: ConstSite) : [Span] = match s {
  ConstSite(l, c, n, q) -> exact_ident_span(src, l, c, n, to_upper(n), q)
}

fn insert_span(xs: [Span], x: Span) : [Span] = match xs {
  [] -> [x]
  [Span(a, la, ra), ...rest] -> match x {
    Span(b, _, _) -> if b == a { xs } else if b < a { [x, ...xs] } else { [Span(a, la, ra), ...insert_span(rest, x)] }
  }
}

fn respell_at(src: String, spans: [Span], pos: Int, acc: [String]) : String = match spans {
  [] -> concat_all(list_reverse([string_slice(src, pos, string_length(src) - pos), ...acc]))
  [Span(a, n, repl), ...rest] -> respell_at(src, rest, a + n, [repl, string_slice(src, pos, a - pos), ...acc])
}
