#[doc("""
The name a declaration is emitted under, from its id.

Two modules may each declare an effect or a type `Item`. A node carries
the declaration's id and no name, so every emitter spells one, and the
pieces of a program that must meet — an evidence struct and the perform
that casts to it, a runtime label and the handler installed under it, an
impl symbol and the call that names it — meet only when each asks here.

A declaration nobody shares its name with is emitted under the name it
was declared with. A contested one is told apart by its home, `Item__da`,
unless the bare name is its own to keep: a core module's declaration
always keeps it, and so does a type of the root file. An effect of the
root file keeps it unless a core module declares the name too, because
the runtime binds the bare label to the core effect.

A diagnostic prints the declared name, never this one.
""")]

import compiler.ast
import compiler.written
import compiler.decl_names
import compiler.symtab
import compiler.decl_text
import compiler.home_spell

#[doc("The name the declaration `s` is emitted under: the one it was declared with, spelled with its home when another module declares an effect or a type of that name and the bare one is not this declaration's to keep. `tab` is the program's table, which knows its root and core modules.")]
pub fn rt_name(tab: SymTab, s: SymId) : String = {
  let name = written_text(decl_name(tab, s))
  if rt_told_apart(tab, s, name) { hs_spell(name, written_text(sym_home(tab, s))) } else { name }
}

#[doc("The name a reference is emitted under: its declaration's once it is settled, the name the source wrote, without its qualifier, before.")]
pub fn rt_ref_name(tab: SymTab, r: DeclRef) : String = match r {
  DrSym(s)        -> rt_name(tab, s)
  DrWritten(_, n) -> written_text(n)
}

# Only effects and types are told apart: no other class is keyed by its
# spelling below the resolver.
fn rt_told_apart(tab: SymTab, s: SymId, name: String) : Bool =
  if not st_valid(tab, s) { false }
  else { match sym_class(tab, s) {
    NCEffect -> rt_effect_apart(tab, s, st_candidates(tab, NCEffect, name))
    NCType   -> sym_contested(tab, s) and not sym_in_root(tab, s) and not sym_in_core(tab, s)
    _        -> false
  } }

fn rt_effect_apart(tab: SymTab, s: SymId, homonyms: [SymId]) : Bool = match homonyms {
  [_, _, ..._] ->
    if sym_in_core(tab, s) { false }
    else { not sym_in_root(tab, s) or any(homonyms, (h) => sym_in_core(tab, h)) }
  _ -> false
}
