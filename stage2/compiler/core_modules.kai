#[doc("""
The core modules the compiler treats specially: the ones whose functions
a pass recognises or inserts.

A module is itself a symbol, so its identity is the id the symbol table
derives for it. A pass holding a module's `SymId`, or the home a
qualified call or a declaration's origin carries, asks `module_is` /
`home_is` which of them it is; no other module spells one of these names
to decide which module it has in hand.

A qualifier the source wrote names no module until its file's imports
resolve it, and a pass reading one reads text.
""")]

import compiler.ast
import compiler.symtab_build

#[doc("A core module the compiler treats specially, named without building its spelling.")]
pub type CoreModule = CmList | CmProtocols | CmLoop

#[doc("The name the core module `m` is homed under.")]
pub fn core_module_name(m: CoreModule) : String = match m {
  CmList      -> "list"
  CmProtocols -> "protocols"
  CmLoop      -> "loop"
}

#[doc("The identity of the core module `m`: the id the symbol table gives its module symbol.")]
pub fn core_module_id(m: CoreModule) : SymId = st_module_id(core_module_name(m))

#[doc("True when the module symbol `s` is the core module `m`. An absent id is no module.")]
pub fn module_is(s: SymId, m: CoreModule) : Bool =
  sym_raw(s) >= 0 and sym_raw(s) == sym_raw(core_module_id(m))

#[doc("True when the module homed at `home` is the core module `m`.")]
pub fn home_is(home: String, m: CoreModule) : Bool = module_is(st_module_id(home), m)

#[doc("True when `a` and `b` are the same core module.")]
pub fn core_module_same(a: CoreModule, b: CoreModule) : Bool =
  sym_raw(core_module_id(a)) == sym_raw(core_module_id(b))
