#[doc("""
Writing rows into a symbol table's buffers, and moving a whole table
into fresh ones.

A table grows by moving: its rows are read out and refilled into larger
buffers, and an extension starts from a moved copy so the table it
extends is left as it was. Each row keeps its id, because an id is a
function of its key and never of the slot it sits in.

The rows are read into a list before any write, so the buffers written
are born in the move: a caller that hands `st_refill` a fresh table
keeps `Mutable` masked.
""")]

import compiler.decl_names
import compiler.symtab
import compiler.written

#[doc("A copy of `t` in fresh buffers with `cap` slots. `cap` is a power of two at least twice `t`'s count.")]
pub fn st_moved(t: SymTab, cap: Int) : SymTab = st_refill(st_rows_of(t), st_fresh(cap, t.root, t.cores))

#[doc("Writes the row `id` into the empty slot `i` and threads it onto its name's chain.")]
pub fn st_fill_slot(t: SymTab, i: Int, id: Int, cls: NCls, name: Written, owner: Int,
      exp: Bool) : SymTab / Mutable {
  let b = st_slot(written_text(name), t.cap)
  SymTab { count: t.count + 1,
           cap: t.cap,
           ids: array_set(t.ids, i, id),
           names: array_set(t.names, i, name),
           owners: array_set(t.owners, i, owner),
           classes: array_set(t.classes, i, cls),
           exported: array_set(t.exported, i, exp),
           buckets: array_set(t.buckets, b, [id, ...array_get(t.buckets, b)]),
           root: t.root,
           cores: t.cores }
}

#[doc("One row read out of a table: `StRow(id, class, name, owner, exported)`.")]
pub type StRow = StRow(Int, NCls, Written, Int, Bool)

#[doc("Every row of `t`, in bucket order with each name chain oldest first, so refilling them keeps `st_by_name` in declaration order.")]
pub fn st_rows_of(t: SymTab) : [StRow] = st_rows(t, t.cap - 1, [])

fn st_rows(t: SymTab, b: Int, acc: [StRow]) : [StRow] =
  if b < 0 { acc }
  else { st_rows(t, b - 1, st_chain_rows(t, array_get(t.buckets, b), acc)) }

fn st_chain_rows(t: SymTab, chain: [Int], acc: [StRow]) : [StRow] = match chain {
  [] -> acc
  [id, ...rest] -> st_chain_rows(t, rest, [st_row_of(t, id, st_probe(t, id, id % t.cap)), ...acc])
}

fn st_row_of(t: SymTab, id: Int, i: Int) : StRow =
  StRow(id, array_get(t.classes, i), array_get(t.names, i),
        array_get(t.owners, i), array_get(t.exported, i))

#[doc("Writes `rows` into `u`, which has room for all of them.")]
pub fn st_refill(rows: [StRow], u: SymTab) : SymTab / Mutable = match rows {
  [] -> u
  [StRow(id, cls, name, owner, exp), ...rest] ->
    st_refill(rest, st_fill_slot(u, st_probe(u, id, id % u.cap), id, cls, name, owner, exp))
}
