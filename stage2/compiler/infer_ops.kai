# Infer a pipe / combinator function argument. A lambda stage takes the
# stage's element type before its body is walked, so a body that pipes or
# calls its parameter sees the element type, not an open variable. The
# parameter is recorded for the length of the body.
fn synth_pipe_rhs(st: InferState, rhs: Expr, pop: PipeOp, container: Ty, elem: Option[Ty]) : Inferred / Console + File + Mutable =
  match rhs.kind {
    ELambda(ps, body) -> match elem {
      Some(et) -> {
        let r = synth_lambda_expecting(with_stage_param(st, ps, pop, container, et), ps, body, [et], rhs.line, rhs.col)
        mk_inferred(InferState { ...r.st, stage_params: st.stage_params }, r.ty, r.expr)
      }
      None     -> w_synth(st, rhs)
    }
    _ -> w_synth(st, rhs)
  }

fn with_stage_param(st: InferState, ps: [Param], pop: PipeOp, container: Ty, elem: Ty) : InferState =
  match ps {
    [p] -> InferState { ...st, stage_params: [StageParam { id: p.binder.id, pop: pop, container: container, elem: elem }, ...st.stage_params] }
    _   -> st
  }


#[doc("Typer-internal helper `synth_pipe` shared across the infer modules.")]
pub fn synth_pipe(st: InferState, lhs: Expr, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let att = try_fuse_terminal_fold(st, lhs, rhs, line, col)
  match att.fused {
    Some(inf) -> inf
    None      -> synth_pipe_plain(att.st, lhs, rhs, line, col)
  }
}


# The callee of a pipe stage. A name the resolver left for the typer,
# one several modules declare (`filter` of both `option` and `list`), is
# narrowed by the piped value's type: under the pipe rewrite that value
# is the callee's first argument. A settled callee, and one with a single
# candidate, is read as any callee is.
fn synth_pipe_callee(st: InferState, f: Expr, lhs_ty: Ty) : Inferred / Console + File + Mutable = match f.kind {
  EName(nm) -> {
    let candidates = bare_fn_candidates(st, nm)
    if list_length(candidates) < 2 { synth_callee(st, f) }
    else { match pick_by_first_arg(st, candidates, apply_ty(st.sub, lhs_ty), f.line, f.col) {
      FaNone -> synth_callee(st, f)
      FaTie(st_t, ss) -> inferred_leaf(report_name_tie(st_t, nm, ss, true, f.line, f.col), TyAny, f)
      FaOne(pick) -> mk_inferred(pick_inst(pick, f.line, f.col), pick.inst_ty, with_ty(pick_ref(pick, f.line, f.col), pick.inst_ty))
    } }
  }
  _ -> w_synth(st, f)
}


fn synth_pipe_plain(st: InferState, lhs: Expr, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let rl = w_synth(st, lhs)
  let res = match rhs.kind {
    ECall(f, pa) -> match pipe_defer(rl, f, pa, line, col) {
      Some(inf) -> PipeRes { st: inf.st, ty: inf.ty, call: inf.expr }
      None      -> synth_pipe_args(rl, f, pa, line, col)
    }
    _ -> {
      let rf = synth_pipe_callee(rl.st, rhs, rl.ty)
      let rv = st_fresh_ty(rf.st)
      let fr = subst_fresh_row(rv.st.sub)
      let st_fresh = st_set_sub(rv.st, fr.subst)
      let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
      let expected = TyFnT([rl.ty], rv.ty, expected_row)
      let st_unif = st_unify(st_fresh, rf.ty, expected, "pipe call", line, col)
      let st2 = st_propagate_capability_labels(st_unif, apply_ty(st_unif.sub, rf.ty), line, col)
      match refine_call(st2, rf.expr, rf.ty, [rl.expr], [rl.ty], apply_ty(st2.sub, rv.ty)) {
        RefCall(st3, ty) -> PipeRes { st: st3, ty: ty, call: mk_expr(ECall(rf.expr, [rl.expr]), line, col) }
      }
    }
  }
  mk_inferred(res.st, res.ty, with_ty(res.call, res.ty))
}


# A bare homonym piped a receiver whose head is not known yet waits for
# it, as a direct call does.
fn pipe_defer(rl: Inferred, f: Expr, pa: [Expr], line: Int, col: Int) : Option[Inferred] / Console + File + Mutable =
  match f.kind {
    EName(nm) -> {
      let candidates = bare_fn_candidates(rl.st, nm)
      if list_length(candidates) < 2 { None }
      else { hom_try_defer(rl.st, nm, candidates, apply_ty(rl.st.sub, rl.ty), rl.expr, pa, f, line, col) }
    }
    _ -> None
  }


# The receiver is settled against the callee's first parameter before the
# other arguments are walked, as a direct call settles each earlier argument.
fn synth_pipe_args(rl: Inferred, f: Expr, pa: [Expr], line: Int, col: Int) : PipeRes / Console + File + Mutable = {
  let rf = synth_pipe_callee(rl.st, f, rl.ty)
  let params = fn_param_tys(rf.st, rf.ty)
  let rest_params = params_after_first(params)
  let first = match params {
    [p, ..._] -> Some(p)
    []        -> None
  }
  let ra = synth_many_expecting(st_settle_arg(rf.st, first, rl.ty, pa, rest_params), pa, rest_params)
  let rv = st_fresh_ty(ra.st)
  let fr = subst_fresh_row(rv.st.sub)
  let st_fresh = st_set_sub(rv.st, fr.subst)
  let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
  let expected = TyFnT([rl.ty, ...ra.tys], rv.ty, expected_row)
  let st_unif = st_unify(st_fresh, rf.ty, expected, "pipe call", line, col)
  let st2 = st_propagate_capability_labels(st_unif, apply_ty(st_unif.sub, rf.ty), line, col)
  match refine_call(st2, rf.expr, rf.ty, [rl.expr, ...ra.exprs], [rl.ty, ...ra.tys], apply_ty(st2.sub, rv.ty)) {
    RefCall(st3, ty) -> PipeRes { st: st3, ty: ty, call: mk_expr(ECall(rf.expr, [rl.expr, ...ra.exprs]), line, col) }
  }
}

# head-owner cache.
#
# `synth_pipe_dispatch` rewrites `xs | f`, `xs || f`, and `xs |? p`
# into a qualified call against the module that owns the LHS's head
# type — `List → list.map`, `MyBox → mypkg.mybox.map`, etc.
#
# Earlier this was a hardcoded `if head == "List" { Some("list") }`
# table that knew exactly one entry. That made any downstream package
# wishing to participate in `|` (ahu.stream.Source[T], henua.EventBus,
# manutara stream/sink types, …) require a recompile of `kaic2`.
# Unacceptable for a downstream-package ecosystem.
#
# Why convention beats annotation/protocol here:
#   * Operator protocols (`+`-style) require the op's signature to fit
#     `(Self, X) -> Y` shapes a protocol can express. `map`'s shape is
#     `F[A] -> (A -> B) -> F[B]` — higher-kinded. CLAUDE.md bans HKT in
#     the typer; protocols cannot express it.
#   * Effect rows in operator-protocol ops are also banned, but `map`
#     against an effectful function carries the function's effect row
#     into its own signature — protocols would have to admit row-poly
#     ops, which they don't.
#   * Annotations (`#pipe_dispatch`) cost a parser change and a new
#     visible concept for ~5 stdlib + future package decls. Convention
#     is free at the surface, costs ~70 LOC inside the compiler, and
#     mirrors how qualified-name resolution already works for
#     `EModCall`-driven calls.
#
# The cache shape: `[HOE(head type, [module_path])]`. A single-element
# `module_path` list is the dispatchable case; a multi-element list is
# ambiguous and the typer reports the modules at the use site so the
# user can pick `mod.T` annotation or rename one of the conflicting
# `pub type T` declarations.
#
# Canonical signatures package authors must follow for their `pub type T`
# to participate in `|` / `||` / `|?` (the LHS receiver is always the
# first argument; the function/predicate is second; the return wraps
# the same head type):
#
#   pub fn map[A, B, e](xs: T[A], f: (A) -> B / e) : T[B] / e
#   pub fn flat_map[A, B, e](xs: T[A], f: (A) -> T[B] / e) : T[B] / e
#   pub fn filter[A, e](xs: T[A], p: (A) -> Bool / e) : T[A] / e
#
# A head carrying an `(element, row)` parameter list — `Stream[t, e]`,
# the streaming carrier whose effect row is a type parameter — also
# rides the pipes: dispatch is by the head type (arity-agnostic), and the
# whole LHS type unifies against the canonical receiver, so the row
# slot threads via the row carrier (`row_arg_carrier`). The element
# unifies against the first slot; the row threads as `e`.
#
# A package that ships `map` with a swapped argument order or a missing
# row var still surfaces the standard call-inference signature mismatch
# — the typer does not need a separate diagnostic for "your map shape
# is wrong". (An extra *type* parameter that is NOT the trailing
# effect-row slot still mismatches; only the legitimate `(element, row)`
# shape is accepted.)
#
# Construction: linear over `(decls, modules)`, called once per
# `compile_source` invocation right before `infer_program`
# runs the typer over the same decl stream. Lookup at each pipe call
# site is `find_head_owner` walking the cache; it is a small linear
# list (one entry per `pub type` across all modules in scope) and the
# constant-factor cost dominates over a hash map until the program
# crosses ~hundreds of pub types — hello-world programs sit at <50.


#[doc("Typer-internal helper `synth_pipe_dispatch` shared across the infer modules.")]
pub fn synth_pipe_dispatch(st: InferState, pop: PipeOp, lhs: Expr, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let rl = w_synth(st, lhs)
  let lhs_ty = apply_ty(rl.st.sub, rl.ty)
  match inf_ty_head_name(rl.st.env.tab, lhs_ty) {
    None       -> pipe_error(rl, pop, rhs, pipe_unresolved_head_msg(pipe_op_core_fn(pop)), line, col)
    Some(head) -> pipe_by_head(rl, lhs_ty, head, pop, rhs, line, col)
  }
}

fn pipe_unresolved_head_msg(cf: CoreFn) : String =
  concat_all([core_fn_name(cf), "-pipe requires a concrete head type on the left-hand side; got an unresolved type variable. ",
              "Annotate the LHS or restructure the pipeline."])

fn pipe_error(rl: Inferred, pop: PipeOp, rhs: Expr, msg: String, line: Int, col: Int) : Inferred / Console + File + Mutable {
  let perr = mk_diag(SevError, rl.st.file, line, col, msg, [])
  render_diag(perr)
  let root = with_ty(mk_expr(EDispatchPipe(pop, rl.expr, rhs), line, col), TyAny)
  mk_inferred(st_bump_err(st_push_diag(rl.st, perr)), TyAny, root)
}

fn pipe_by_head(rl: Inferred, lhs_ty: Ty, head: String, pop: PipeOp, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let hsym = ty_head_sym(lhs_ty)
  match pipe_rejection_reason(hsym, pop) {
    Some(msg) -> pipe_error(rl, pop, rhs, msg, line, col)
    None      -> match find_head_owner(rl.st.env, hsym) {
      HLNone          -> pipe_error(rl, pop, rhs, concat_all(["no module declaring type `", head, "` is in scope"]), line, col)
      HLAmbiguous(ms) -> pipe_error(rl, pop, rhs, pipe_ambiguous_msg(rl.st.env.tab, head, ms), line, col)
      HLOk(owner)     ->
        if st_valid(rl.st.env.tab, owner) { pipe_through_owner(rl, lhs_ty, hsym, head, owner, pop, rhs, line, col) }
        else { pipe_error(rl, pop, rhs, concat_all(["no module declaring type `", head, "` is in scope"]), line, col) }
    }
  }
}

fn pipe_ambiguous_msg(tab: SymTab, head: String, mods: [SymId]) : String =
  concat_all(["ambiguous head type `", head, "` — ", join_modules_for_diag(map(mods, (m) => "#{sym_name(tab, m)}")),
              " all declare it. Use qualified type annotation."])

# The module's own `op` when it declares one; a `Shape`-protocol impl provides the
# op through its dispatcher; otherwise the runtime primitive of that name answers,
# and the call-inference signature mismatch reports it.
fn pipe_callee_kind(qualified: Option[SymId], op: String, proto_disp: Option[ExprKind]) : ExprKind =
  match qualified {
    Some(s) -> ESym(s, spec_none())
    None    -> match proto_disp {
      Some(k) -> k
      None    -> ESym(builtin_sym(op), spec_none())
    }
  }

# A user `pub type` whose module ships no canonical op is reported; the seeded
# `List` head stays silent and routes through the primitive.
fn pipe_missing_op_state(rl: Inferred, hsym: SymId, head: String, owner: SymId, op: String, has_proto_op: Bool, line: Int, col: Int) : InferState / Console + File + Mutable =
  if core_ty_is(hsym, CtList) or has_proto_op { rl.st }
  else {
    let perr = mk_diag(SevError, rl.st.file, line, col,
      pipe_missing_op_msg(rl.st.env.tab, hsym, head, owner, op), [])
    render_diag(perr)
    st_bump_err(st_push_diag(rl.st, perr))
  }

fn pipe_missing_op_msg(tab: SymTab, hsym: SymId, head: String, owner: SymId, op: String) : String =
  if core_ty_is(hsym, CtArray) { "`#{head}` has no `#{op}`; pipe over `array.to_list(a)` instead" }
  else { "module `#{sym_name(tab, owner)}` declares `#{head}` but does not export `#{op}`" }

fn pipe_through_owner(rl: Inferred, lhs_ty: Ty, hsym: SymId, head: String, owner: SymId, pop: PipeOp, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let cf = pipe_op_core_fn(pop)
  let op = core_fn_name(cf)
  let qualified = env_module_fn(rl.st.env, owner, op)
  let proto_disp = pipe_op_dispatcher(rl.st.protos, lhs_ty, op)
  let callee_kind = pipe_callee_kind(qualified, op, proto_disp)
  let st_after_diag = match qualified {
    Some(_) -> rl.st
    None    -> pipe_missing_op_state(rl, hsym, head, owner, op, is_some(proto_disp), line, col)
  }
  let rc = w_synth(st_after_diag, with_ty(mk_expr(callee_kind, line, col), TyAny))
  pipe_apply(rl, rc, lhs_ty, callee_kind, cf, owner, op, qualified, pop, rhs, line, col)
}

fn pipe_apply(rl: Inferred, rc: Inferred, lhs_ty: Ty, callee_kind: ExprKind, cf: CoreFn, owner: SymId, op: String, qualified: Option[SymId], pop: PipeOp, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let pe = pipe_elem_from_callee(rc.st.env, rc.st.sub, rc.ty, lhs_ty)
  let st_pe = match pe {
    Some(PE(_, s)) -> st_set_sub(rc.st, s)
    None           -> rc.st
  }
  let elem = pipe_elem_ty(pe)
  let rf = each_stage_checked(pop, synth_pipe_rhs(st_pe, rhs, pop, apply_ty(st_pe.sub, lhs_ty), elem), line, col)
  let rv = st_fresh_ty(rf.st)
  let ret = match pop {
    PoEach -> TyUnit
    _      -> rv.ty
  }
  let fr = subst_fresh_row(rv.st.sub)
  let st_fresh = st_set_sub(rv.st, fr.subst)
  let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
  let expected = TyFnT([rl.ty, rf.ty], ret, expected_row)
  let pipe_callee = mk_expr(callee_kind, line, col)
  let st2 = match pipe_stage_wants_container(st_fresh.env, st_fresh.sub, rl.ty, rf.ty, elem) {
    Some(param) -> {
      emit_pipe_wants_apply(st_fresh, pop, rhs, param, elem, line, col)
      st_bump_err(st_fresh)
    }
    None -> st_unify_named(st_fresh, pipe_callee_shown(st_fresh, owner, op, qualified, pipe_callee), rc.ty, [rl.ty, rf.ty], expected, line, col)
  }
  match refine_call(st2, pipe_callee, rc.ty, [rl.expr, rf.expr], [rl.ty, rf.ty], apply_ty(st2.sub, ret)) {
    RefCall(st3, ty) -> {
      let fused = try_fuse_map_pipe(st3, cf, rc.expr, rl.expr, rf.expr, ty, line, col)
      mk_inferred(fused.st, ty, fused.root)
    }
  }
}


fn try_fuse_terminal_fold(st: InferState, lhs: Expr, rhs0: Expr, line: Int, col: Int) : FuseAttempt / Console + File + Mutable = {
  let rhs = if pipe_fusion_head(lhs) { terminal_settled(st, rhs0) } else { rhs0 }
  match pipe_fusion_as_terminal_fold(st.protos.ids, lhs, rhs) {
    None     -> FuseAttempt { st: st, fused: None }
    Some(ff) -> fuse_gated(st, ff, rhs, line, col)
  }
}

fn fuse_gated(st: InferState, ff: FusedFold, rhs: Expr, line: Int, col: Int) : FuseAttempt / Console + File + Mutable = {
  let g = fuse_terminal_gate(st, ff)
  if g.ok { fuse_rewrite(st, g.st, ff, rhs, line, col) } else { FuseAttempt { st: g.st, fused: None } }
}

# The peek advances the fresh-tvar counter and binds in the shared substitution,
# so the rewrite is walked from the state the peek returns: reusing the old one
# would mint the peek's already-bound ids again.
fn fuse_rewrite(st: InferState, st_gate: InferState, ff: FusedFold, rhs: Expr, line: Int, col: Int) : FuseAttempt / Console + File + Mutable =
  match fuse_source_is_protocol_seq(st_gate, ff) {
    FSP(st_after, is_seq, of_chars) -> {
      let proto_foldl = pipe_fusion_proto_foldl(st.protos.ids, rhs)
      if of_chars or fuse_owner_mismatch(ff, proto_foldl, is_seq) { FuseAttempt { st: st_after, fused: None } }
      else {
        let rewrite = if is_seq { pipe_fusion_generic_fold_rewrite(ff, proto_foldl, line, col) } else { pipe_fusion_fold_rewrite(ff, line, col) }
        FuseAttempt { st: st_after, fused: Some(w_synth(st_after, rewrite)) }
      }
    }
  }


fn fuse_source_is_protocol_seq(st: InferState, ff: FusedFold) : FuseSeqPeek / Console + File + Mutable =
  fuse_source_peek(st, ff.source)


#[doc("Typer-internal helper `fuse_source_peek` shared across the infer modules.")]
pub fn fuse_source_peek(st: InferState, source: Expr) : FuseSeqPeek / Console + File + Mutable {
  let r = w_synth(st, source)
  let src_ty = apply_ty(r.st.sub, r.ty)
  let head_ok = not core_ty_is(ty_head_sym(src_ty), CtList) and pipe_op_has_impl(st.protos.impls, src_ty, "foldl")
  let of_chars = pipe_fusion_head(source) and ty_is_char_list(src_ty)
  FSP(st_restore_deferred_fields(r.st, st.deferred_fields, st.deferred_homs), head_ok, of_chars)
}


# An explicit `foldl` keeps the Mutable-masked purity gate — its stage
# and combine still run, only reordered. An implicit terminal (`sum`,
# `product`, `length`) rewrites to a target with a row-less stage
# parameter — and `length` drops the stages — so it demands strictly
# empty labels.
fn fuse_terminal_gate(st: InferState, ff: FusedFold) : FuseGate / Console + File + Mutable =
  match ff.term {
    TermFoldl(_, combine) -> {
      let g = fuse_all_raw(st, ff.stages, false)
      if g.ok { fuse_raw(g.st, combine, false) } else { g }
    }
    _ -> fuse_all_raw(st, ff.stages, true)
  }


#[doc("Typer-internal helper `fuse_all_raw` shared across the infer modules.")]
pub fn fuse_all_raw(st: InferState, closures: [Expr], strict: Bool) : FuseGate / Console + File + Mutable =
  match closures {
    [] -> FuseGate { st: st, ok: true }
    [c, ...rest] -> {
      let g = fuse_raw(st, c, strict)
      if g.ok { fuse_all_raw(g.st, rest, strict) } else { g }
    }
  }


# Synthesise a raw stage/combine closure solely to read its effect row.
# The typed node is discarded — only the verdict and the threaded state
# are kept. The probe's `deferred_fields` are rolled back: a stage body
# `(r) => r.field` with an unannotated `r` synthesised in isolation defers
# the field against a receiver tyvar that this probe never pins (only the
# re-synthesised rewrite call binds the real stage param to the element
# type). Left in the worklist, that orphan receiver drains to a spurious
# "annotation needed". The fresh-tvar counter and substitution still ride
# forward — rewinding those would re-mint ids the probe already bound.
fn fuse_raw(st: InferState, closure: Expr, strict: Bool) : FuseGate / Console + File + Mutable {
  let r = w_synth(st, closure)
  let ok = if strict { fuse_row_strict(r.st.sub, r.expr) }
           else { fuse_stage_pure(r.st.sub, r.expr) }
  FuseGate { st: st_restore_deferred_fields(r.st, st.deferred_fields, st.deferred_homs), ok: ok }
}


#[doc("Typer-internal helper `synth_field` shared across the infer modules.")]
pub fn synth_field(st: InferState, obj: Expr, fnm: String, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let r = w_synth(st, obj)
  let applied = apply_ty(r.st.sub, r.ty)
  # A unit or a refinement wraps the record that carries the fields.
  let carrier = ty_dispatch_head(applied)
  match carrier {
    TyCon(tsym, _) -> match rec_pick(r.st.recs, tsym) {
      None -> field_non_record_or_partial_app(r.st, r.expr, applied, fnm, line, col)
      Some(ri) -> {
        let inst = rec_instantiate(r.st, ri)
        let st1 = st_unify(inst.st, inst.result_ty, carrier, "record field access", line, col)
        match fty_find(inst.fields, fnm) {
          Some(t) -> {
            let ty = apply_ty(st1.sub, t)
            mk_inferred(st1, ty, field_root(r.expr, fnm, line, col, ty))
          }
          None -> {
            let perr = mk_diag(SevError, st.file, line, col, "no field '#{fnm}' on #{decl_name(st.env.tab, tsym)}#{field_hint(inst.fields, fnm)}", [])
            render_diag(perr)
            mk_inferred(st_bump_err(st_push_diag(st1, perr)), TyAny, field_root(r.expr, fnm, line, col, TyAny))
          }
        }
      }
    }
    # the receiver's type is still an unbound tyvar — the
    # canonical case is the payload of a generic effect op (`Some(b) ->
    # b.id` where `b : ?a` and `?a` is only pinned to the row's `Box`
    # later by `check_body_row`). We cannot read the field yet:
    # the `_` fallback below is exactly the wrong guess —
    # it produces a bogus diagnostic. Defer instead — record a
    # constraint keyed on the receiver tyvar, stamp the access with a
    # FRESH result tyvar (not TyAny, so downstream uses stay connected),
    # and let `infer_decl` resolve it once the receiver settles. This is
    # purely a timing fix in the field-access path; it touches neither
    # effect-row inference nor the field read of resolved receivers.
    TyVarT(recv_id) -> {
      let fr = st_fresh_ty(r.st)
      let res_id = ty_var_id(fr.ty)
      let st1 = st_push_deferred_field(fr.st, DFd(recv_id, fnm, res_id, line, col, false))
      mk_inferred(st1, fr.ty, field_root(r.expr, fnm, line, col, fr.ty))
    }
    _ -> field_non_record_or_partial_app(r.st, r.expr, applied, fnm, line, col)
  }
}


# `e1[e2]` dispatches on the container's inferred
# type. `Map[K, V]` lowers to `map.get(coll, ix)` and `HashMap[K, V]`
# to `hashmap.get(coll, ix)` (both return `Option[V]`); any
# other container — including unresolved type variables — falls back
# to `array_get(coll, ix)` so the unifier produces the existing
# "expected `Array[T]`" error message at the call site. The chosen
# callee's scheme types the arguments, the result AND the effect row —
# `hashmap_get`'s `/ Mutable` included. `coll` is walked exactly once:
# the call is typed against a placeholder (`compiler.index_coll`).
#
# Design note (not a smell — kept as a closed 3-case dispatch on
# purpose): a smell audit flagged the `name == "Map"` test as wanting
# an `Index` protocol. It does not. kaikai has exactly three indexable
# containers (Array, Map, HashMap), and the language bans
# type-class-style resolution — a closed compile-time dispatch is
# precisely what is preferred over a resolution mechanism. An `Index`
# protocol
# would not remove a hardcode, it would move it (the proto name + the
# builtin impls) across more sites and route every `[]` through the
# proto impl-table at runtime. Worse, it would degrade this error:
# the Array fallback for an unresolved type var is deliberate, and a
# protocol over `?t` can only emit a generic "no `Index` impl" or
# re-hardcode the Array bias inside the resolver.
#[doc("Typer-internal helper `synth_index` shared across the infer modules.")]
pub fn synth_index(st: InferState, coll: Expr, ix: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let probe = w_synth(st, coll)
  let coll_ty = apply_ty(probe.st.sub, probe.ty)
  let ph = ixc_ref(coll)
  match coll_ty {
    TyCon(tcs, _) ->
      if core_ty_is(tcs, CtVec) { synth_vec_index(probe, coll_ty, ph, ix, line, col) }
      else { synth_on_coll(probe, coll_ty, ECall(index_getter(coll_ty, line, col), [ph, ix]), line, col) }
    TyDimT(TyCon(tcs, _), _) -> if core_ty_is(tcs, CtVec) { synth_dim_vec_index(probe, coll_ty, ph, ix, line, col) } else { index_array_get(probe, coll_ty, ph, ix, line, col) }
    _ -> index_array_get(probe, coll_ty, ph, ix, line, col)
  }
}


fn index_array_get(probe: Inferred, coll_ty: Ty, ph: Expr, ix: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable =
  synth_on_coll(probe, coll_ty, ECall(builtin_mk(CbArrayGet, line, col), [ph, ix]), line, col)


# A fixed-width vec (`Vec[T]<n>`) reads inline: a static literal index is a bare
# struct field load with the bound proved at compile time.
fn synth_dim_vec_index(probe: Inferred, coll_ty: Ty, ph: Expr, ix: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable =
  if ty_is_fixed_vec(coll_ty) { synth_fixed_vec_index(probe.st, probe.expr, ix, coll_ty, line, col) }
  else { synth_vec_index(probe, coll_ty, mk_expr(ECall(builtin_mk(CbDetachUnit, line, col), [ph]), line, col), ix, line, col) }


# Types the read `k`, whose collection is the placeholder, against the
# probe's type for it, then splices the probe's typed collection back.
fn synth_on_coll(probe: Inferred, t: Ty, k: ExprKind, line: Int,
      col: Int) : Inferred / Console + File + Mutable {
  let st1 = st_set_env(probe.st, env_bind_local(probe.st.env, binder_minted(ixc_name()), mono(t)))
  let r = w_synth(st1, mk_expr(k, line, col))
  mk_inferred(st_restore_entries(probe.st, r.st), r.ty, ixc_splice(r.expr, probe.expr))
}


# `xs[i]` on a Vec reads the element; `xs[a..b]` (inclusive, like the
# range literal) is the O(1) slice — the same view `[h, ...t]` binds.
fn synth_vec_index(probe: Inferred, t: Ty, coll: Expr, ix: Expr,
                   line: Int, col: Int) : Inferred / Console + File + Mutable =
  match ix.kind {
    ERange(a, b, None) -> synth_on_coll(probe, t, vec_slice_block(coll, a, b, line, col), line, col)
    ERange(_, _, Some(_)) -> {
      let perr = mk_diag(SevError, probe.st.file, line, col, "a stepped range cannot slice a Vec — a slice is one contiguous view", [])
      render_diag(perr)
      mk_inferred(st_bump_err(st_push_diag(probe.st, perr)), TyAny, with_ty(mk_expr(EIndex(probe.expr, ix), line, col), TyAny))
    }
    _ -> synth_on_coll(probe, t, ECall(builtin_mk(CbVecGet, line, col), [coll, ix]), line, col)
  }


# `v[k]` on a fixed-width `Vec[e]<n>`: a static literal index in range
# lowers to `__fixed_vec_get` — a bare struct field load, the bound
# proved here at compile time so no runtime check is emitted. Out of
# range is a compile error (strictly better than the dynamic vec's
# runtime trap). A dynamic index lowers to `__fixed_vec_get_dyn`, the
# same inline field load behind a bounds check against the static `n`.
fn synth_fixed_vec_index(st: InferState, coll: Expr, ix: Expr, coll_ty: Ty,
                         line: Int, col: Int) : Inferred / Console + File + Mutable {
  let n = fixed_vec_n(coll_ty)
  let elem = fixed_vec_elem(coll_ty)
  match ix.kind {
    EInt(k, _) ->
      if k >= 0 and k < n {
        fixed_vec_index_node(st, coll, ix, MkFixedVecGet, elem, line, col)
      } else {
        let perr = mk_diag(SevError, st.file, line, col,
          concat_all(["index ", int_to_string(k), " is out of range for a fixed-width `Vec` of length ", int_to_string(n)]), [])
        render_diag(perr)
        mk_inferred(st_bump_err(st_push_diag(st, perr)), elem, with_ty(mk_expr(EIndex(coll, ix), line, col), elem))
      }
    _ -> {
      let ir = w_check_against(st, ix, TyInt, "index", ix.line, ix.col)
      fixed_vec_index_node(ir.st, coll, ir.expr, MkFixedVecGetDyn, elem, line, col)
    }
  }
}


#[doc("Typer-internal helper `synth_binop` shared across the infer modules.")]
pub fn synth_binop(st: InferState, op: BinOp, l: Expr, r: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let rl = w_synth(st, l)
  let rr = w_synth(rl.st, r)
  synth_binop_typed(op, rl, rr, line, col)
}


fn synth_binop_typed(op: BinOp, rl: Inferred, rr: Inferred, line: Int, col: Int) : Inferred / Console + File + Mutable =
  if binop_eq(op, BoConcat) { synth_concat(rr.st, rl.ty, rl.expr, rr.ty, rr.expr, line, col) }
  else if binop_is_logical(op) { binop_logical(op, rl, rr, line, col) }
  else if binop_is_equality(op) or binop_is_ordering(op) { binop_compare(op, rl, rr, line, col) }
  else if binop_eq(op, BoMod) { binop_mod(op, rl, rr, line, col) }
  else if binop_eq(op, BoMul) or binop_eq(op, BoDiv) { binop_mul_div(op, rl, rr, line, col) }
  else if binop_eq(op, BoPow) { synth_dim_pow(rr.st, rl.ty, rl.expr, rr.ty, rr.expr, line, col) }
  else { binop_add_sub(op, rl, rr, line, col) }


fn binop_logical(op: BinOp, rl: Inferred, rr: Inferred, line: Int, col: Int) : Inferred / Console + File + Mutable {
  let s1 = st_unify(rr.st, rl.ty, TyBool, "boolean operator", line, col)
  let s2 = st_unify(s1, rr.ty, TyBool, "boolean operator", line, col)
  mk_inferred(s2, TyBool, binop_root(op, rl.expr, rr.expr, line, col, TyBool))
}


# Equality and ordering keep the structural builtin form; the protocol resolver
# rewrites to the custom impl once the operand type is concrete.
fn binop_compare(op: BinOp, rl: Inferred, rr: Inferred, line: Int, col: Int) : Inferred / Console + File + Mutable {
  let s1 = st_unify(rr.st, rl.ty, rr.ty, "comparison", line, col)
  mk_inferred(s1, TyBool, binop_root(op, rl.expr, rr.expr, line, col, TyBool))
}


fn binop_dispatch(op: BinOp, rl: Inferred, rr: Inferred, lty: Ty, rty: Ty, line: Int, col: Int) : Inferred / Console + File + Mutable =
  synth_binop_proto(rr.st, op, rl.expr, lty, rr.expr, rty, line, col)


# Primitive `Int % Int` keeps the unify-and-emit path; concrete non-primitive
# operands and `Real % Real` go through the `Rem` protocol.
fn binop_mod(op: BinOp, rl: Inferred, rr: Inferred, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let lty = apply_ty(rr.st.sub, rl.ty)
  let rty = apply_ty(rr.st.sub, rr.ty)
  if binop_should_dispatch_proto(lty, rty) or binop_dispatch_proto_heterogeneous(rr.st, op, lty, rty) or (ty_is_real_head(lty) and ty_is_real_head(rty)) {
    binop_dispatch(op, rl, rr, lty, rty, line, col)
  } else if ty_is_var_head(lty) or ty_is_var_head(rty) {
    binop_mod_generic(op, rl, rr, line, col)
  } else { binop_mod_fixed(op, rl, rr, lty, rty, line, col) }
}


# A generic operand keeps its type; the protocol rewrite after monomorphisation reaches `Rem`.
fn binop_mod_generic(op: BinOp, rl: Inferred, rr: Inferred, line: Int, col: Int) : Inferred / Console + File + Mutable {
  let s1 = st_unify(rr.st, rl.ty, rr.ty, "arithmetic operator '%'", line, col)
  let ty = apply_ty(s1.sub, rl.ty)
  mk_inferred(s1, ty, binop_root(op, rl.expr, rr.expr, line, col, ty))
}


# `T % T` over a same-width fixed integer keeps the width wrap; everything else unifies with `Int`.
fn binop_mod_fixed(op: BinOp, rl: Inferred, rr: Inferred, lty: Ty, rty: Ty, line: Int, col: Int) : Inferred / Console + File + Mutable {
  let modt = fixed_mod_result(lty, rty)
  let s1 = st_unify(rr.st, rl.ty, modt, "integer arithmetic", line, col)
  let s2 = st_unify(s1, rr.ty, modt, "integer arithmetic", line, col)
  mk_inferred(s2, modt, binop_root(op, rl.expr, rr.expr, line, col, modt))
}


# Two concrete non-numeric heads take the `Mul`/`Div` protocol; dimensioned
# operands of the same head combine their units first, the rest combine units
# in `synth_dim_mul_div`.
fn binop_mul_div(op: BinOp, rl: Inferred, rr: Inferred, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let lty = apply_ty(rr.st.sub, rl.ty)
  let rty = apply_ty(rr.st.sub, rr.ty)
  if binop_should_dispatch_proto(lty, rty) {
    if binop_same_head_dimmed(lty, rty) { synth_binop_proto_dim_mul(rr.st, op, rl.expr, lty, rr.expr, rty, line, col) }
    else { binop_dispatch(op, rl, rr, lty, rty, line, col) }
  } else if binop_dispatch_proto_heterogeneous(rr.st, op, lty, rty) { binop_dispatch(op, rl, rr, lty, rty, line, col) }
  else { synth_dim_mul_div(rr.st, op, rl.ty, rl.expr, rr.ty, rr.expr, line, col) }
}


fn arith_what(op: BinOp) : String = string_concat("arithmetic operator '", string_concat(binop_text(op), "'"))


# `+` / `-` demand unit equality, and dispatch to a protocol only for concrete non-primitive operands.
fn binop_add_sub(op: BinOp, rl: Inferred, rr: Inferred, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let lty = apply_ty(rr.st.sub, rl.ty)
  let rty = apply_ty(rr.st.sub, rr.ty)
  if binop_should_dispatch_proto(lty, rty) {
    let st_d = if binop_same_head_dimmed(lty, rty) { st_unify(rr.st, rl.ty, rr.ty, arith_what(op), line, col) } else { rr.st }
    synth_binop_proto(st_d, op, rl.expr, lty, rr.expr, rty, line, col)
  } else if binop_dispatch_proto_heterogeneous(rr.st, op, lty, rty) { binop_dispatch(op, rl, rr, lty, rty, line, col) }
  else {
    let s1 = st_unify(rr.st, rl.ty, rr.ty, arith_what(op), line, col)
    let s2 = st_check_arith_string(s1, op, rl.ty, line, col)
    let ty = apply_ty(s2.sub, rl.ty)
    mk_inferred(s2, ty, binop_root(op, rl.expr, rr.expr, line, col, ty))
  }
}


# Build a call of the operator protocol's dispatcher on `[l, r]` and walk
# it through `synth_call`. The lower-protocols pass has already
# generated the dispatcher (when the matching protocol is declared); the
# post-inference rewrite then redirects to the impl.
fn synth_binop_proto(st: InferState, op: BinOp, le: Expr, lt: Ty,
                      re: Expr, rt: Ty,
                      line: Int, col: Int) : Inferred / Console + File + Mutable {


  match binop_check_against_impl(st, op, lt, rt, line, col) {
    BinopImpl(st_h, declared) ->
      binop_impl_result(synth_call(st_h, binop_dispatcher_ref(st_h.protos.ids, binop_proto(op), line, col), [le, re], line, col), declared)
  }
}


# `*` / `/` over dimensioned protocol operands: combine the units the
# way the primitive dim path does, run the Module formation guard on
# the combined unit, dispatch to the impl on the bare carriers, and
# stamp the combined unit back onto the impl's result. `USD·USD` dies
# in the guard; `Decimal<USD> · Decimal` keeps the habitant; a full
# cancellation (`USD/USD`) yields the bare carrier.
fn synth_binop_proto_dim_mul(st: InferState, op: BinOp,
                             le: Expr, lt: Ty, re: Expr, rt: Ty,
                             line: Int, col: Int) : Inferred / Console + File + Mutable {
  let ls = ty_split_dim(lt, st.sub)
  let rs = ty_split_dim(rt, st.sub)
  let combined = if binop_eq(op, BoMul) { UMul(ls.dim, rs.dim) }
                 else { UMul(ls.dim, UInv(rs.dim)) }
  let s1 = st_check_atomic_unit(st, op, combined, line, col)
  # The units are the combined-unit rule's business, already checked
  # above; the impl sees the bare carriers.
  let inf = synth_binop_proto(s1, op, le, ls.base, re, rs.base, line, col)
  let base = (ty_split_dim(inf.ty, inf.st.sub)).base
  let ty = dim_collapse(base, unit_canon(combined))
  mk_inferred(inf.st, ty, with_ty(inf.expr, ty))
}


#[doc("Typer-internal helper `synth_unop` shared across the infer modules.")]
pub fn synth_unop(st: InferState, op: UnOp, x: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let r = w_synth(st, x)
  match op {
    UoNot -> {
      let s1 = st_unify(r.st, r.ty, TyBool, "logical 'not'", line, col)
      let root = with_ty(mk_expr(EUnop(op, r.expr), line, col), TyBool)
      mk_inferred(s1, TyBool, root)
    }
    UoNeg ->
      if ty_negates(apply_ty(r.st.sub, r.ty)) {
        let root = with_ty(mk_expr(EUnop(op, r.expr), line, col), r.ty)
        mk_inferred(r.st, r.ty, root)
      } else { synth_call(r.st, op_dispatcher_ref(r.st.protos.ids, CpNeg, neg_proto_method(), line, col), [r.expr], line, col) }
  }
}


#[doc("Typer-internal helper `synth_range` shared across the infer modules.")]
pub fn synth_range(st: InferState, lo: Expr, hi: Expr, stp: Option[Expr], line: Int, col: Int) : Inferred / Console + File + Mutable {
  let rl = w_synth(st, lo)
  if range_of_chars(apply_ty(rl.st.sub, rl.ty), hi) { synth_char_range(st, rl, lo, hi, stp, line, col) }
  else {
    let s1 = st_unify(rl.st, TyInt, rl.ty, "range start", line, col)
    let rh = w_synth(s1, hi)
    let s2 = st_unify(rh.st, TyInt, rh.ty, "range end", line, col)
    match stp {
      None -> {
        let root = with_ty(mk_expr(ERange(rl.expr, rh.expr, None), line, col), TyListT(TyInt))
        mk_inferred(s2, TyListT(TyInt), root)
      }
      Some(se) -> {
        let rs_ = w_synth(s2, se)
        let s3 = st_unify(rs_.st, TyInt, rs_.ty, "range step", line, col)
        let root = with_ty(mk_expr(ERange(rl.expr, rh.expr, Some(rs_.expr)), line, col), TyListT(TyInt))
        mk_inferred(s3, TyListT(TyInt), root)
      }
    }
  }
}


# A range of Chars is the range of their code points, each mapped back:
# `map([code(lo)..code(hi)], int_to_char)`. The three elements are held to
# Char first, so a mix is reported against the range and not against the
# rewrite; `peek` is the start, already read once to choose this path.
fn synth_char_range(st: InferState, peek: Inferred, lo: Expr, hi: Expr, stp: Option[Expr],
                    line: Int, col: Int) : Inferred / Console + File + Mutable {
  let s1 = st_unify(peek.st, TyChar, peek.ty, "range start", line, col)
  let rh = w_synth(s1, hi)
  let s2 = st_unify(rh.st, TyChar, rh.ty, "range end", line, col)
  let s3 = char_range_second(s2, stp, line, col)
  if s3.errs > st.errs { inferred_leaf(s3, TyListT(TyChar), mk_expr(EList([]), line, col)) }
  else {
    let codes = mk_expr(ERange(char_code(lo), char_code(hi), inf_map_opt_expr(stp, char_step)), line, col)
    let back = mk_sym(builtin_sym("int_to_char"), line, col)
    w_synth(st_restore_deferred_fields(s3, st.deferred_fields, st.deferred_homs),
          mk_expr(ECall(mk_sym(builtin_sym("map"), line, col), [codes, back]), line, col))
  }
}
