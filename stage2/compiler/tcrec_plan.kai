#[doc("Decisions of the self-tail-call and modulo-cons back-edges that every backend prints: which parameters are released, how a slot is laid.")]

#[doc("2 raised to `n`; 1 for `n <= 0`.")]
pub(pkg) fn tcrec_pow2(n: Int) : Int =
  if n <= 0 { 1 } else { 2 * tcrec_pow2(n - 1) }

#[doc("True when bit `i` of `mask` is set.")]
pub(pkg) fn tcrec_bit_set(mask: Int, i: Int) : Bool = (mask / tcrec_pow2(i)) % 2 == 1

#[doc("True when the back-edge releases the old value of parameter `i`: it holds a reference and the drop mask has its bit.")]
pub(pkg) fn tcrec_param_dropped(dropmask: Int, boxed: Bool, i: Int) : Bool = boxed and tcrec_bit_set(dropmask, i)

#[doc("How a variant slot is laid, from its payload kind number.")]
pub(pkg) type TrmcSlotClass = SlotInt | SlotReal | SlotEnum | SlotPtr

#[doc("The layout class of a slot of payload kind `kind`: 1 Int, 2 Real, 3 Enum, anything else a pointer.")]
pub(pkg) fn trmc_slot_class(kind: Int) : TrmcSlotClass =
  if kind == 1 { SlotInt } else if kind == 2 { SlotReal } else if kind == 3 { SlotEnum } else { SlotPtr }

#[doc("The `KaiVarSlot` field a slot of class `c` is stored through.")]
pub(pkg) fn trmc_slot_class_field(c: TrmcSlotClass) : String = match c {
  SlotInt  -> ".i64"
  SlotEnum -> ".i64"
  SlotReal -> ".r"
  SlotPtr  -> ".ptr"
}
