# compiler/evidence_frame.kai — the per-function evidence-frame ABI.
#
# One hidden frame pointer per function whose row demands an effect — a
# Koka-style evidence vector whose slots the call site fills per its own
# supplier classification. The perform site reads its slot by index instead
# of the by-name walk; the walk stays live as the retreatable fallback.
#
# Frame slots are derived from the ROW, not from local op calls: a pure
# forwarder (`mid() : T / E` whose body only calls a callee that performs E)
# has no dotted op call, yet its row demands E and it must thread evidence to
# its callee. The frame ABI is a property of the row's distinct effect
# labels — exactly the param set the signature carries.
#
# Every declared effect rides the frame, builtin-default ones included: the
# default-bearing property no longer decides whether an effect uses the frame,
# only which supplier fills its slot (a startup-minted default node when no
# lexical handler is in scope). `frame_effect_is_carried` draws the line.

import compiler.ast
import compiler.entry
import compiler.evidence
import compiler.infer_index
import compiler.effect_instance
import compiler.core_effects

# The distinct effect-instance keys a function's row demands, in canonical
# (row, deduped) order — the slot layout caller and callee agree on. Keyed
# by the function's emitted symbol so both the perform site (its own frame)
# and the call site (the callee's frame) resolve the same layout.
pub type FnEvidenceFrame = FEF(String, [String])

#[doc("evidence-frame: per function, the distinct effect labels its row demands, in canonical slot order, keyed by emitted symbol. The entry point `entry` carries no frame.")]
pub fn build_evidence_frames(decls: [Decl], entry: SymId) : [FnEvidenceFrame] =
  build_frames_loop(decls, decls, entry, [])

fn build_frames_loop(all: [Decl], ds: [Decl], entry: SymId, acc: [FnEvidenceFrame]) : [FnEvidenceFrame] = match ds {
  []           -> list_reverse(acc)
  [d, ...rest] -> match d {
    # The entry point is the root of the transport: it has no caller to fill a
    # frame, and its row effects are satisfied by the startup defaults the
    # `main` wrapper installs (found via the live walk). So it never takes
    # a frame param — an empty slot list keeps its performs on the walk.
    DFn(_, fname, _, _, _, row, _, _, _, mo, fid) -> {
      let slots = if is_entry(entry, fid) { [] } else { frame_carried_slots(all, d, row) }
      build_frames_loop(all, rest, entry, [FEF(frame_c_sym(fname, mo), slots), ...acc])
    }
    _ -> build_frames_loop(all, rest, entry, acc)
  }
}

# The emitted C symbol — keyed to match `EmitCtx.cur_enc_fn` so a perform
# site finds its own frame. Mirrors `emit_shared.c_sym` (which lives later
# in the bundle, so it cannot be imported here without a cycle).
fn frame_c_sym(name: String, mo: Option[String]) : String = match mo {
  None    -> name
  Some(m) -> string_concat(m, string_concat("__", name))
}

# The slot layout: distinct effect labels in the row, KEPT when the effect is
# a declared effect (every one rides the frame; the supplier is decided per
# call site, not whether it takes a slot).
fn frame_carried_slots(decls: [Decl], d: Decl, row: RowExpr) : [String] = {
  let ls = frame_row_labels(row)
  frame_keep_carried(row_label_keys(d, ls), ls, decls, [])
}

fn frame_row_labels(row: RowExpr) : [RowLabel] = match row {
  REmpty       -> []
  RClosed(ls)  -> ls
  ROpen(_, ls) -> ls
}

fn frame_keep_carried(keys: [String], ls: [RowLabel], decls: [Decl], seen: [String]) : [String] = match keys {
  []           -> []
  [k, ...krest] -> match ls {
    []           -> []
    [l, ...lrest] ->
      if frame_has(seen, k) { frame_keep_carried(krest, lrest, decls, seen) }
      else if frame_effect_is_carried(rl_sym(l), decls) { [k, ...frame_keep_carried(krest, lrest, decls, [k, ...seen])] }
      else { frame_keep_carried(krest, lrest, decls, [k, ...seen]) }
  }
}

# A frame-carried effect: declared as an `effect` whose evidence is transportable
# by value. A builtin-default IO effect (`Stdout`/`File`/`Clock`/`Mutable` …)
# rides the frame; the `default {}` property decides only which supplier fills
# the slot. The exception is an effect whose evidence the scheduler installs
# per-fiber (cancel_pad, link-set, mailbox, nursery) — transporting it would
# carry a parent's handler across a `spawn`, where capabilities must not cross.
# Those stay on the dynamic walk so a perform inside a fiber binds the fiber's
# own disposition. `Ffi` declares no ops and is routed around the dispatcher.
#[doc("evidence-frame: true when an effect's evidence is transportable by value; false for an effect the scheduler installs per-fiber (it stays on the dynamic walk so it does not cross a spawn).")]
pub fn frame_effect_is_carried(s: SymId, decls: [Decl]) : Bool =
  frame_is_declared_effect(s, decls) and not frame_is_fiber_local(s)

fn frame_is_declared_effect(s: SymId, decls: [Decl]) : Bool = match decls {
  []           -> false
  [d, ...rest] -> match d {
    DEffect(_, _, _, _, _, _, _, _, es) -> if sym_raw(s) >= 0 and sym_raw(es) == sym_raw(s) { true } else { frame_is_declared_effect(s, rest) }
    _ -> frame_is_declared_effect(s, rest)
  }
}

# Effects whose evidence the scheduler installs per-fiber, so it must not ride a
# frame slot (that would transport a parent's handler across a `spawn`).
fn frame_is_fiber_local(s: SymId) : Bool =
  effect_is_any(s, [CeCancel, CeLink, CeMonitor, CeSpawn, CeActor])

#[doc("evidence-frame: the frame table indexed by emitted symbol, plus the lexical `handle` shadows the body being emitted has entered.")]
pub type EvFrames = { shadows: [FnEvidenceFrame], ix: NameIndex[FnEvidenceFrame] }

#[doc("evidence-frame: index a frame table by emitted symbol; of a symbol listed twice, the first frame answers.")]
pub fn frames_index(frames: [FnEvidenceFrame]) : EvFrames =
  EvFrames { shadows: [], ix: frames_ix(list_reverse(frames), idx_empty()) }

fn frames_ix(rev: [FnEvidenceFrame], ix: NameIndex[FnEvidenceFrame]) : NameIndex[FnEvidenceFrame] = match rev {
  []           -> ix
  [f, ...rest] -> match f { FEF(n, _) -> frames_ix(rest, idx_prepend(ix, n, f)) }
}

#[doc("evidence-frame: slot index of an effect instance in a function's frame, or -1 when the frame does not carry it (perform falls back to the walk).")]
pub fn frame_slot_index(frames: EvFrames, fsym: String, key: String) : Int =
  match frame_lookup(frames, fsym) {
    Some(slots) -> inst_key_index(slots, key)
    None        -> 0 - 1
  }

#[doc("evidence-frame: the ordered slot labels of a function's frame (its ABI arity), or [] when the symbol is unknown.")]
pub fn frame_slots_of(frames: EvFrames, fsym: String) : [String] =
  match frame_lookup(frames, fsym) {
    Some(slots) -> slots
    None        -> []
  }

fn frame_lookup(frames: EvFrames, fsym: String) : Option[[String]] = frame_chain(idx_chain(frames.ix, fsym), fsym)

# A hash collision mixes foreign symbols into a chain, so each entry is
# re-tested against `fsym`.
fn frame_chain(chain: [FnEvidenceFrame], fsym: String) : Option[[String]] = match chain {
  []           -> None
  [f, ...rest] -> match f { FEF(n, slots) -> if n == fsym { Some(slots) } else { frame_chain(rest, fsym) } }
}

fn frame_has(xs: [String], s: String) : Bool = match xs {
  []           -> false
  [h, ...rest] -> if h == s { true } else { frame_has(rest, s) }
}
