#[doc("""
Dispatch errors found inside a specialisation reported where the user caused them.
A specialisation of a template the user did not write fails because of the instantiation that asked for it: the error moves to that call, and a note points at the failing site.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.expr_positions
import compiler.impl_identity
import compiler.proto_ids
import compiler.protos_calls
import compiler.proto_unresolved
import compiler.symtab
import compiler.type_text
import compiler.diag_file
import compiler.diag
import compiler.util
import compiler.package_id

type Site = Site(Int, Int, FnId)

#[doc("The dispatch diagnostics of `ds`, each one found in a declaration outside the package of `root_file` moved to the nearest call inside the package that instantiates that declaration, when there is one.")]
pub(pkg) fn dispatch_diags_at_user_sites(ds: [Decl], tab: SymTab, reg: ProtocolReg, df: DiagFiles,
                                         root_file: String, plan: PkgPlan) : [Diagnostic] / Console + File =
  dedup_diags(finalize_diags(blame_decls(ds, ds, tab, reg, df, root_file, plan, [])), [])

fn blame_decls(all: [Decl], ds: [Decl], tab: SymTab, reg: ProtocolReg, df: DiagFiles, root_file: String, plan: PkgPlan,
               acc: [Diagnostic]) : [Diagnostic] / Console + File = match ds {
  [] -> acc
  [d, ...rest] -> {
    let found = list_append(validate_resolved_decls([d], tab, reg, df, []), unresolved_dispatch_diags([d], reg, df))
    let moved = map(found, (x) => blame_one(all, d, x, tab, reg, df, root_file, plan))
    blame_decls(all, rest, tab, reg, df, root_file, plan, list_append(list_reverse(moved), acc))
  }
}

fn blame_one(all: [Decl], d: Decl, x: Diagnostic, tab: SymTab, reg: ProtocolReg, df: DiagFiles,
             root_file: String, plan: PkgPlan) : Diagnostic / File = match x {
  D(sev, file, line, col, msg, related) ->
    if in_root_package(file, root_file, plan) { x } else { match d {
      DFn(_, fid, _, _, _, _, _, _, _, _) -> match instantiating_site(all, [fid], df, root_file, plan, 8) {
        Some((at, Site(l, c, via))) -> D(sev, decl_diag_file(at, df), l, c, msg, [DR(file, line, col, required_by(tab, reg, fnid_sym(via))), ...related])
        None -> x
      }
      _ -> x
    } }
}

fn required_by(tab: SymTab, reg: ProtocolReg, s: SymId) : String = match pid_impl(reg.ids, s) {
  Some(PIR(proto, target, _, _, _, _, _)) ->
    concat_all(["required by `impl ", dh_text(tab, DhSym(proto)), " for ", ref_display(tab, target), "`"])
  None -> concat_all(["required by `", dh_text(tab, DhSym(s)), "`"])
}

fn in_root_package(file: String, root_file: String, plan: PkgPlan) : Bool = file == root_file or pkg_same(pkg_of(plan, file), pkg_of(plan, root_file))

# The first call inside the root package, searching callers outward from `targets`, that reaches one of them.
# A check-only run leaves call sites on the generic, so a level with no exact caller matches by symbol.
fn instantiating_site(all: [Decl], targets: [FnId], df: DiagFiles, root_file: String, plan: PkgPlan, depth: Int) : Option[(Decl, Site)] / File =
  if depth == 0 or targets == [] { None } else {
    let exact = callers_of(all, targets, true)
    let callers = if exact == [] { callers_of(all, targets, false) } else { exact }
    let loose = exact == []
    match find(callers, (c) => in_root_package(decl_diag_file(c, df), root_file, plan)) {
      Some(c) -> match c {
        DFn(_, _, _, _, _, _, body, _, _, _) -> first_ref(body, targets, not loose) |> map((st) => (c, st))
        _ -> None
      }
      None -> instantiating_site(all, flat_map(callers, (c) => match c { DFn(_, fid, _, _, _, _, _, _, _, _) -> [fid]  _ -> [] }),
                              df, root_file, plan, depth - 1)
    }
  }

fn callers_of(all: [Decl], targets: [FnId], exact: Bool) : [Decl] = filter(all, (c) => match c {
  DFn(_, _, _, _, _, _, body, _, _, _) -> is_some(first_ref(body, targets, exact))
  _ -> false
})

fn first_ref(e: Expr, targets: [FnId], exact: Bool) : Option[Site] = match e.kind {
  ESym(s, k) -> find(targets, (t) => if exact { fnid_eq(t, FnId(s, k)) } else { sym_raw(fnid_sym(t)) == sym_raw(s) }) |> map((t) => Site(e.line, e.col, t))
  _ -> first_ref_in(xp_positions(e), targets, exact)
}

fn first_ref_in(ps: [XPos], targets: [FnId], exact: Bool) : Option[Site] = match ps {
  [] -> None
  [XP(_, c), ...rest] -> match first_ref(c, targets, exact) {
    Some(s) -> Some(s)
    None    -> first_ref_in(rest, targets, exact)
  }
}

fn dedup_diags(ds: [Diagnostic], seen: [Diagnostic]) : [Diagnostic] = match ds {
  [] -> list_reverse(seen)
  [D(sev, f, l, c, m, rel), ...rest] ->
    if any(seen, (x) => match x { D(_, f2, l2, c2, m2, _) -> f2 == f and l2 == l and c2 == c and m2 == m }) { dedup_diags(rest, seen) }
    else { dedup_diags(rest, [D(sev, f, l, c, m, rel), ...seen]) }
}
