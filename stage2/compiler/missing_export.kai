#[doc("""
The qualified reads that name no export of their module.

The qualified rewrite keeps `mod.fname` as `EModCall(mod, fname)` even
when the imported `mod` does not export `fname`, so no later pass takes
`mod` for an unbound value. This walk reports each such read once, as a
diagnostic, before the typer runs. Each import segment is checked
against the module table of the file it came from. A read keyed to the
reader's own module is not one: a module reads its own private names.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_decl
import compiler.symtab
import compiler.fn_index
import compiler.diag
import compiler.diag_file
import compiler.expr_positions
import compiler.module_table
import compiler.modules
import compiler.modules_segments
import compiler.name_uses
import compiler.written
import compiler.scope_view

#[doc("One diagnostic per qualified read of a name its module does not export, over an import-segmented stream.")]
pub fn mexp_segmented(
  segs: [ImportSeg],
  decls: [Decl],
  tabs: ModTables,
  target_mod: String,
  df: DiagFiles,
  pkgs: [PkgPick]
) : [Diagnostic] = mexp_segments(segs, decls, tabs, target_mod, df, pkgs, [])

fn mexp_segments(
  segs: [ImportSeg],
  decls: [Decl],
  tabs: ModTables,
  target_mod: String,
  df: DiagFiles,
  pkgs: [PkgPick],
  chunks: [[Diagnostic]]
) : [Diagnostic] = match segs {
  [] ->
    concat(
      list_reverse([mexp_decls(decls, mtabs_of(tabs, "").entries, df, target_mod, pkgs), ...chunks])
    )
  [ISeg(home, n), ...rest] -> {
    let chunk = mexp_decls(seg_take(decls, n), mtabs_of(tabs, home).entries, df, target_mod, pkgs)
    mexp_segments(rest, seg_drop(decls, n), tabs, target_mod, df, pkgs, [chunk, ...chunks])
  }
}

#[doc("One diagnostic per qualified read of a name its module does not export, against one module table; `target` is the root module.")]
pub fn mexp_decls(
  ds: [Decl],
  mt: [ModuleEntry],
  df: DiagFiles,
  target: String,
  pkgs: [PkgPick]
) : [Diagnostic] =
  mexp_loop(ds, MexCx { mt: mt, file: "", home: target, pkgs: pkgs }, df, target, [])

type MexCx = { mt: [ModuleEntry], file: String, home: String, pkgs: [PkgPick] }

fn mexp_loop(
  ds: [Decl],
  cx: MexCx,
  df: DiagFiles,
  target: String,
  chunks: [[Diagnostic]]
) : [Diagnostic] = match ds {
  [] -> concat(list_reverse(chunks))
  [d, ...rest] -> {
    let cx1 = MexCx {
      mt: cx.mt,
      file: decl_diag_file(d, df),
      home: nu_reader_home(d, cx.home, target),
      pkgs: cx.pkgs
    }
    mexp_loop(rest, cx1, df, target, [
      mexp_exprs(list_append(decl_preds(d), decl_exprs(d)), cx1),
      ...chunks
    ])
  }
}

fn mexp_exprs(es: [Expr], cx: MexCx) : [Diagnostic] = flat_map(es, e => mexp_expr(e, cx))

fn mexp_expr(e: Expr, cx: MexCx) : [Diagnostic] = match e.kind {
  EModCall(m, f) -> mexp_read(written_text(m), written_text(f), cx, e)
  ELambda(_, _) -> mexp_annotated(e, cx)
  EBlock(_, _) -> mexp_annotated(e, cx)
  EHandle(_, _, _, _, _, _, _) -> mexp_annotated(e, cx)
  _ -> mexp_positions(xp_positions(e), cx)
}

# A form that annotates types: their predicates are read as well.
fn mexp_annotated(e: Expr, cx: MexCx) : [Diagnostic] = match expr_preds(e) {
  [] -> mexp_positions(xp_positions(e), cx)
  ps -> list_append(mexp_exprs(ps, cx), mexp_positions(xp_positions(e), cx))
}

fn mexp_positions(ps: [XPos], cx: MexCx) : [Diagnostic] = flat_map(
  ps,
  p => match p {
    XP(_, e) -> mexp_expr(e, cx)
  }
)

fn mexp_read(m: String, f: String, cx: MexCx, e: Expr) : [Diagnostic] =
  if m == cx.home {
    []
  } else {
    match mt_lookup_member(cx.mt, m, f) {
      Some(me) -> if me_has_export(me, f) {
        if me_hides(me, f, pkgs_root(cx.pkgs, st_module_id(cx.home))) {
          [
            mk_diag(
              SevError,
              cx.file,
              e.line,
              e.col,
              "`#{m}.#{f}` is `pub(pkg)` in module `#{m}`, which belongs to another package; declare it `pub` there to use it from here",
              []
            )
          ]
        } else {
          []
        }
      } else {
        [mk_diag(SevError, cx.file, e.line, e.col, missing_export_msg(m, f, me_exports(me)), [])]
      }
      None -> []
    }
  }
