#[doc("""
The module table: what an `import` binds and how a written qualifier
reaches the module, its exports and its home.
""")]

import compiler.util
import compiler.diag
import compiler.infer_index

# ModuleEntry records the surface name a user wrote on an
# `import` line, the public names that file exports, and the
# absolute path the file was loaded from. The resolver collects one
# per import in expand_imports; later passes use
# the table to disambiguate `mod.fn` qualified calls from
# record-field projections.
#
# `name` is the surface form: the last segment of `IkPath("a.b.c")`
# (=> `c`), the alias from `IkAlias`, or the last segment of
# `IkSelective`. `exports` is the list of pub fn / pub type / pub
# effect / pub protocol names declared in the imported file's
# top-level (non-import) decls. Selective imports do NOT pre-filter
# this list — concat semantics still bring every public decl
# into the unqualified scope, so the qualified surface mirrors that.
pub(pkg) type ModuleEntry = ME(String, [String], String, [String])

#[doc("The module bound to `name` in this file's qualifier table, if any.")]
pub(pkg) fn mt_lookup(mt: [ModuleEntry], name: String) : Option[ModuleEntry] {
  match mt {
    [] -> None
    [me, ...rest] -> match me {
      ME(mn, _, _, _) -> if mn == name { Some(me) } else { mt_lookup(rest, name) }
    }
  }
}

#[doc("The names the module exports.")]
pub(pkg) fn me_exports(me: ModuleEntry) : [String] = match me { ME(_, exs, _, _) -> exs }

#[doc("True when the module exports `fn_name` at its top level.")]
pub(pkg) fn me_has_export(me: ModuleEntry, fn_name: String) : Bool = match me {
  ME(_, exports, _, _) -> list_has(exports, fn_name)
}

# Returns true when `fn_name` is in the module's unstable
# export list. Callers use this from EField -> EModCall rewriting to
# decide whether to emit the unstable-consumer warning.
#[doc("True when the module marks `fn_name` unstable.")]
pub(pkg) fn me_export_is_unstable(me: ModuleEntry, fn_name: String) : Bool = match me {
  ME(_, _, _, unstable) -> list_has(unstable, fn_name)
}

#[doc("The marker a module entry's unstable list holds for an export that reaches the modules of its package alone; no source name has a colon, so no export is mistaken for one.")]
pub(pkg) fn pkg_marker(root: String, name: String) : String = string_concat_all(["pkg:", root, ":", name])

#[doc("Whether the module entry keeps `name` from a reader in the package `root`: it is exported to a package other than that one.")]
pub(pkg) fn me_hides(me: ModuleEntry, name: String, root: String) : Bool = match me {
  ME(_, _, _, marks) -> marks_hide(marks, name, root)
}

#[doc("Whether some marker in `marks` keeps `name` from a reader in the package `root`.")]
fn marks_hide(marks: [String], name: String, root: String) : Bool =
  not list_is_empty(marks) and any(marks, (m) => starts_with(m, "pkg:") and ends_with(m, string_concat(":", name))
                                                  and not starts_with(m, string_concat_all(["pkg:", root, ":"])))

#[doc("The exports a module shows an importer: all of them to a module of its own package, the rest to another.")]
pub(pkg) fn me_exports_for(exports: [String], marks: [String], root: String) : [String] =
  if list_is_empty(marks) { exports } else { filter(exports, (n) => not marks_hide(marks, n, root)) }

# Collect the absolute origin path of every ModuleEntry
# in `mes`. Used to pre-seed the import resolver's `visited` set with
# the paths of every `--core` file so a user `import` of the same
# module is a no-op instead of a duplicate-symbol link error.
pub(pkg) fn collect_module_origins(mes: [ModuleEntry], acc: [String]) : [String] = match mes {
  [] -> list_reverse(acc)
  [me, ...rest] -> match me {
    ME(_, _, origin, _) -> collect_module_origins(rest, [origin, ...acc])
  }
}

#[doc("Project the module table onto the (module, file) pairs diagnostic attribution needs.")]
pub fn module_files(mes: [ModuleEntry], acc: [ModFile]) : [ModFile] = match mes {
  [] -> list_reverse(acc)
  [me, ...rest] -> match me {
    ME(name, _, origin, _) -> module_files(rest, [MF(name, origin), ...acc])
  }
}

# Find an already-registered entry by the file it was loaded from.
# A file reached twice under two surface names owns one set of
# exports; the second importer re-keys those exports under its own
# binding rather than re-reading the file.
pub(pkg) fn mt_lookup_origin(mt: [ModuleEntry], path: String) : Option[ModuleEntry] {
  match mt {
    [] -> None
    [me, ...rest] -> match me {
      ME(_, _, origin, _) -> if origin == path { Some(me) } else { mt_lookup_origin(rest, path) }
    }
  }
}

# The import bindings one file wrote, keyed by the module that wrote
# them. An import alias is scoped to its file: two files may bind the
# same module under different names, and neither name is visible in
# the other. The empty module name owns the root file's imports.
#
# A scope entry is keyed by the name its file wrote, which under an
# alias is not the name the module's decls were tagged with. Only these
# per-file entries may carry an alias — the global table stays keyed by
# tagged names, or `me_emit_name` could not tell the two apart.
#
# The third slot lists the written names a plain `import m` bound. Only
# those open their module's names bare in the file; an alias or a
# selective import binds the qualifier alone.
pub(pkg) type ModScope = MScope(String, [ModuleEntry], [String])

# The qualifier table a decl from `home` resolves through: that
# module's own imports, else the global table. The fallback carries
# the names every file sees without importing them (auto-loaded core
# modules), which no per-file import list records.
#
# Alias entries come first, so a written name resolves to the file its
# own module meant. They keep that file's origin path, which is what
# lets `me_emit_name` recover the name codegen minted symbols under.
#
# A global entry under a name the file binds to another file is left
# out: the file's binding already answers that name, and counting the
# global one would let another file's import make this file's qualifier
# contested. One for the same file stays: it is the last entry of that
# file, the one `me_emit_name` reads the minted name from.
pub(pkg) fn ms_scope_table(scopes: [ModScope], home: String, global: [ModuleEntry]) : [ModuleEntry] =
  match scopes {
    [] -> global
    [MScope(m, mt, _), ...rest] ->
      if m == home {
        let ix = mt_by_name(mt, idx_empty())
        list_append(mt, filter(global, (g) => not mt_binds_elsewhere(ix, g)))
      }
      else { ms_scope_table(rest, home, global) }
  }

fn me_name(me: ModuleEntry) : String = match me { ME(n, _, _, _) -> n }

fn mt_by_name(mt: [ModuleEntry], ix: NameIndex[ModuleEntry]) : NameIndex[ModuleEntry] = match mt {
  [] -> ix
  [me, ...rest] -> mt_by_name(rest, idx_prepend(ix, me_name(me), me))
}

fn mt_binds_elsewhere(ix: NameIndex[ModuleEntry], g: ModuleEntry) : Bool = match g {
  ME(name, _, origin, _) -> mt_rebinds(idx_chain(ix, name), name, origin)
}

# Buckets are keyed by hash, so each entry re-tests the name.
fn mt_rebinds(xs: [ModuleEntry], name: String, origin: String) : Bool = match xs {
  [] -> false
  [ME(n, _, o, _), ...rest] -> (n == name and o != origin) or mt_rebinds(rest, name, origin)
}

#[doc("The module a read of `q.member` goes through: of the modules bound to `q`, the first that exports `member`, else the first.")]
pub(pkg) fn mt_lookup_member(mt: [ModuleEntry], q: String, member: String) : Option[ModuleEntry] =
  match mt_rivals(mt, q, member) {
    [me, ..._] -> Some(me)
    []         -> mt_lookup(mt, q)
  }

#[doc("Every distinct module bound to `q` that exports `member`, in binding order; two or more make `q.member` ambiguous.")]
fn mt_rivals(mt: [ModuleEntry], q: String, member: String) : [ModuleEntry] =
  mt_rivals_loop(mt, q, member, [])

fn mt_rivals_loop(mt: [ModuleEntry], q: String, member: String, acc: [ModuleEntry]) : [ModuleEntry] = match mt {
  [] -> list_reverse(acc)
  [me, ...rest] -> match me {
    ME(n, exports, origin, _) ->
      if n == q and list_has(exports, member) and not me_origin_in(acc, origin) {
        mt_rivals_loop(rest, q, member, [me, ...acc])
      } else { mt_rivals_loop(rest, q, member, acc) }
  }
}

fn me_origin_in(mes: [ModuleEntry], origin: String) : Bool = match mes {
  []            -> false
  [ME(_, _, o, _), ...rest] -> o == origin or me_origin_in(rest, origin)
}

#[doc("`mt_lookup_member`, warning at the read when several modules bound to `q` export `member`.")]
pub(pkg) fn mt_lookup_member_at(mt: [ModuleEntry], q: String, member: String, file: String, line: Int, col: Int) : Option[ModuleEntry] / Console + File {
  mt_warn_rivals(mt, q, member, file, line, col)
  mt_lookup_member(mt, q, member)
}

#[doc("The home of the module a read of `q.member` goes through, or `q` when no module is bound to it.")]
pub(pkg) fn mt_member_home(mt: [ModuleEntry], q: String, member: String) : String = match mt_lookup_member(mt, q, member) {
  Some(me) -> me_emit_name(mt, me, q)
  None     -> q
}

#[doc("`mt` without its first binding of `q`: the bindings left once one import named `q` has claimed its own.")]
pub(pkg) fn mt_drop_first(mt: [ModuleEntry], q: String) : [ModuleEntry] = match mt {
  []            -> []
  [me, ...rest] -> if me_name(me) == q { rest } else { [me, ...mt_drop_first(rest, q)] }
}

#[doc("Warn that `q.member` names a member several modules bound to `q` export, at the read; the first binding answers.")]
fn mt_warn_rivals(mt: [ModuleEntry], q: String, member: String, file: String, line: Int, col: Int) : Unit / Console + File =
  match mt_rival_diag(mt, q, member, file, line, col) {
    Some(d) -> render_diag(d)
    None    -> ()
  }

#[doc("The warning `mt_warn_rivals` renders, or `None` when at most one module bound to `q` exports `member`.")]
pub(pkg) fn mt_rival_diag(mt: [ModuleEntry], q: String, member: String, file: String, line: Int, col: Int) : Option[Diagnostic] =
  match mt_rivals(mt, q, member) {
    [a, b, ...more] -> mt_rival_homes_diag(map([a, b, ...more], (me) => home_path(me_emit_name(mt, me, q))), q, member, file, line, col)
    _ -> None
  }

fn mt_rival_homes_diag(homes: [String], q: String, member: String, file: String, line: Int, col: Int) : Option[Diagnostic] =
  match homes {
    [first, second, ...rest] ->
      Some(mk_diag(SevWarning, file, line, col,
        concat_all(["`", q, ".", member, "` is exported by more than one module bound to `", q, "`: ",
                    join_with([first, second, ...rest], ", ")]),
        [ri_help(file, line, col, concat_all(["this resolves to `", first, "`; to reach another, bind it under its own name: `import ", second, " as ", q, "2`"]))]))
    _ -> None
  }

#[doc("The name codegen minted the symbols of `me` under: the last entry of its file in `mt`, else `written`.")]
pub(pkg) fn me_emit_name(mt: [ModuleEntry], me: ModuleEntry, written: String) : String =
  match me {
    ME(_, _, origin, _) -> me_last_name_for_origin(mt, origin, written)
  }

#[doc("How the reader whose table is `mt` names the module homed at `home`: the reader's own binding for that module's file, else the module's import path.")]
pub(pkg) fn mt_spell_home(mt: [ModuleEntry], home: String) : String = match mt_lookup(mt, home) {
  Some(ME(_, _, origin, _)) -> me_first_name_for_origin(mt, origin, home_path(home))
  None                      -> home_path(home)
}

fn me_first_name_for_origin(mt: [ModuleEntry], origin: String, dflt: String) : String = match mt {
  []                        -> dflt
  [ME(n, _, o, _), ...rest] -> if o == origin { n } else { me_first_name_for_origin(rest, origin, dflt) }
}

# A home spells its import path's `.` as `__`.
fn home_path(home: String) : String = home_path_loop(home, 0, string_length(home), "")

fn home_path_loop(s: String, i: Int, n: Int, acc: String) : String =
  if i >= n { acc }
  else if i + 1 < n and string_slice(s, i, 2) == "__" { home_path_loop(s, i + 2, n, string_concat(acc, ".")) }
  else { home_path_loop(s, i + 1, n, string_concat(acc, string_slice(s, i, 1))) }

#[doc("The last name `mt` binds the file at `origin` under, else `acc`.")]
pub(pkg) fn me_last_name_for_origin(mt: [ModuleEntry], origin: String, acc: String) : String =
  match mt {
    [] -> acc
    [ME(n, _, o, _), ...rest] ->
      me_last_name_for_origin(rest, origin, if o == origin { n } else { acc })
  }

#[doc("The tagged module name behind a written qualifier: the name codegen keys symbols by, recovering the global tag when `written` is a per-file alias. `written` itself when the table has no such entry.")]
pub(pkg) fn mt_tagged_name(mt: [ModuleEntry], written: String) : String =
  match mt_lookup(mt, written) {
    Some(me) -> me_emit_name(mt, me, written)
    None     -> written
  }

#[doc("`fname` when the module exports it.")]
pub(pkg) fn me_lookup_export(me: ModuleEntry, fname: String) : Option[String] = match me {
  ME(_, exports, _, _) ->
    if list_has(exports, fname) { Some(fname) } else { None }
}

#[doc("A module's qualifier table: its entries in resolution order, with the names its own file binds and the program-wide ones indexed.")]
pub(pkg) type ModTable = { entries: [ModuleEntry], own: NameIndex[ModuleEntry], shared: NameIndex[ModuleEntry] }

#[doc("A home and the table it reads.")]
pub(pkg) type HomeTable = HT(String, ModTable)

#[doc("The qualifier table of each module of a program, and the one a home with no scope of its own reads.")]
pub(pkg) type ModTables = { homes: NameIndex[HomeTable], rest: ModTable }

#[doc("The table of every scope of `scopes` over the program-wide `global`.")]
pub(pkg) fn mtabs_build(scopes: [ModScope], global: [ModuleEntry]) : ModTables = {
  let shared = mtabs_index(list_reverse(global), idx_empty())
  ModTables { homes: mtabs_homes(list_reverse(scopes), global, shared, idx_empty()),
              rest: ModTable { entries: global, own: idx_empty(), shared: shared } }
}

# Both indexes are filled last entry first, so a chain reads in table order.
fn mtabs_homes(scopes: [ModScope], global: [ModuleEntry], shared: NameIndex[ModuleEntry],
      acc: NameIndex[HomeTable]) : NameIndex[HomeTable] = match scopes {
  [] -> acc
  [s, ...rest] -> match s {
    MScope(m, mt, _) -> {
      let t = ModTable { entries: ms_scope_table([s], m, global),
                         own: mtabs_index(list_reverse(mt), idx_empty()), shared: shared }
      mtabs_homes(rest, global, shared, idx_prepend(acc, m, HT(m, t)))
    }
  }
}

fn mtabs_index(mes: [ModuleEntry], ix: NameIndex[ModuleEntry]) : NameIndex[ModuleEntry] = match mes {
  [] -> ix
  [me, ...rest] -> match me {
    ME(n, _, _, _) -> mtabs_index(rest, idx_prepend(ix, n, me))
  }
}

#[doc("The qualifier table the module `home` reads.")]
pub(pkg) fn mtabs_of(tabs: ModTables, home: String) : ModTable =
  mtabs_pick(idx_chain(tabs.homes, home), home, tabs.rest)

fn mtabs_pick(xs: [HomeTable], home: String, dflt: ModTable) : ModTable = match xs {
  [] -> dflt
  [HT(m, t), ...rest] -> if m == home { t } else { mtabs_pick(rest, home, dflt) }
}

# A program-wide entry is left out of a table only under a name the file
# binds itself, so the first match of either index is the table's first.
#[doc("The module bound to `name` in the table, if any: what `mt_lookup` answers over its entries.")]
pub(pkg) fn mtab_lookup(t: ModTable, name: String) : Option[ModuleEntry] =
  match mt_lookup(idx_chain(t.own, name), name) {
    Some(me) -> Some(me)
    None     -> mt_lookup(idx_chain(t.shared, name), name)
  }

#[doc("The tagged module name behind a written qualifier: what `mt_tagged_name` answers over the table's entries.")]
pub(pkg) fn mtab_tagged_name(t: ModTable, written: String) : String =
  match mtab_lookup(t, written) {
    Some(me) -> me_emit_name(t.entries, me, written)
    None     -> written
  }

#[doc("The home of the user module imported as `mod_path`, given the core modules' homes.")]
pub(pkg) fn module_home(mod_path: String, cores: [ModuleEntry]) : String {
  let h = path_home(mod_path)
  match mt_lookup(cores, h) {
    Some(_) -> string_concat("local__", h)
    None    -> h
  }
}

fn path_home(mod_path: String) : String = path_home_loop(mod_path, 0, string_length(mod_path), "")

fn path_home_loop(s: String, i: Int, n: Int, acc: String) : String =
  if i >= n { acc }
  else { match char_at(s, i) {
    Some(c) -> path_home_loop(s, i + 1, n, string_concat(acc, if c == '.' { "__" } else { int_to_byte_string(char_to_int(c)) }))
    None    -> acc
  } }

#[doc("The file other than `path` already homed at `home`: two files that would mint one set of symbols.")]
pub(pkg) fn home_taken_by(mods: [ModuleEntry], home: String, path: String) : Option[String] =
  match mt_lookup(mods, home) {
    Some(ME(_, _, origin, _)) -> if origin == path { None } else { Some(origin) }
    None                      -> None
  }

#[doc("Report two files that map to one home, at the import that reached the second.")]
pub(pkg) fn report_home_clash(file: String, line: Int, col: Int, first: String, second: String) : Unit / Console + File {
  diag_error(file, line, col, concat_all(["modules `", first, "` and `", second, "` would mint the same symbols"]))
  diag_help("rename one of the two files")
}

#[doc("A module's name paired with the file that declares it.")]
pub type ModFile = MF(String, String)

#[doc("Module files indexed by module name; a module listed twice answers with its first file.")]
pub(pkg) type ModFiles = ModFiles(NameIndex[ModFile])

#[doc("Index the (module, file) pairs `mfs`.")]
pub(pkg) fn mod_files(mfs: [ModFile]) : ModFiles = ModFiles(mf_index(list_reverse(mfs), idx_empty()))

#[doc("The index with no module.")]
pub(pkg) fn mod_files_none() : ModFiles = ModFiles(idx_empty())

#[doc("The file that declares module `m`, or `dflt` when no pair names it.")]
pub(pkg) fn mod_file_or(fs: ModFiles, m: String, dflt: String) : String = match fs {
  ModFiles(ix) -> mf_first(idx_chain(ix, m), m, dflt)
}

fn mf_index(mfs: [ModFile], ix: NameIndex[ModFile]) : NameIndex[ModFile] = match mfs {
  [] -> ix
  [mf, ...rest] -> match mf { MF(name, _) -> mf_index(rest, idx_prepend(ix, name, mf)) }
}

# Buckets are keyed by hash, so each pair re-tests the name.
fn mf_first(mfs: [ModFile], m: String, dflt: String) : String = match mfs {
  [] -> dflt
  [MF(name, path), ...rest] -> if name == m { path } else { mf_first(rest, m, dflt) }
}
