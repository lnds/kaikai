#[doc("""
Exit drops: per-path drops around a tail that holds a self call, post-tail drops of block locals, and the hoist gate.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ret_slots
import compiler.perceus_payer
import compiler.perceus_reads
import compiler.trmc_self_call
import compiler.ast_map
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state

pub(pkg) fn pcs_force_opaque_exit_drops(e: Expr, opaque_lets: [Binder], uses: UseIx) : Expr / Console = match opaque_lets {
  [] -> e
  _  -> Expr { kind: pcs_fed_kind(e.kind, opaque_lets, uses), line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
}

fn pcs_fed_kind(k: ExprKind, opaque_lets: [Binder], uses: UseIx) : ExprKind / Console = match k {
  EBlock(stmts, tail) -> {
    # The normal exit-drop pass already drops a handle whose last use is
    # in the block (not the tail) and read >= 2 times. The handles left
    # without a drop are exactly those whose last use is in the tail OR
    # read once — those get a drop here, complementary, never doubled.
    let bound = pcs_fed_block_handles(stmts, opaque_lets, tail, uses, [])
    let drops = pcs_fed_make_drops(bound)
    match tail {
      Some(t) -> {
        # A handle's last use may be in the tail; bind the tail value, drop
        # the handles, then return it.
        match drops {
          [] -> EBlock(pcs_fed_stmts(stmts, opaque_lets, uses), Some(pcs_force_opaque_exit_drops(t, opaque_lets, uses)))
          _  -> {
            let t1 = pcs_force_opaque_exit_drops(t, opaque_lets, uses)
            let ret_let = SLet(mk_pat(PBind(ret_slot_binder(RsOpaque)), t1.line, t1.col), None, t1)
            # The read carries the tail's type and mode: an unboxed tail binds a
            # raw local, and a `ty: None` read would emit the boxed name for it.
            let ret_var = Expr { kind: ELocal(ret_slot_local(RsOpaque)), line: t1.line, col: t1.col,
                                 ty: t1.ty, mode: t1.mode,  site: t1.site }
            EBlock(list_append(pcs_fed_stmts(stmts, opaque_lets, uses), list_append([ret_let], drops)), Some(ret_var))
          }
        }
      }
      None -> EBlock(list_append(pcs_fed_stmts(stmts, opaque_lets, uses), drops), None)
    }
  }
  EIf(c, t, oe) -> EIf(c, pcs_force_opaque_exit_drops(t, opaque_lets, uses),
                       match oe { None -> None Some(e2) -> Some(pcs_force_opaque_exit_drops(e2, opaque_lets, uses)) })
  _ -> k
}

# Handles bound by a `let` in these stmts that the normal exit-drop pass
# leaves undropped — i.e. last-use-in-tail or read-once. (A handle read
# >= 2 times whose last use is NOT in the tail already gets the normal
# exit-drop, so it is excluded to avoid a double-free.)
fn pcs_fed_block_handles(stmts: [Stmt], opaque_lets: [Binder], tail: Option[Expr], uses: UseIx, acc: [Binder]) : [Binder] / Console = match stmts {
  []           -> acc
  [s, ...rest] -> match s {
    SLet(pat, _, _) -> match pat.pkind {
      PBind(nm) ->
        if pcs_has(opaque_lets, nm.id) and pcs_fed_needs_drop(nm, tail, uses) {
          pcs_fed_block_handles(rest, opaque_lets, tail, uses, [nm, ...acc])
        } else { pcs_fed_block_handles(rest, opaque_lets, tail, uses, acc) }
      _ -> pcs_fed_block_handles(rest, opaque_lets, tail, uses, acc)
    }
    _ -> pcs_fed_block_handles(rest, opaque_lets, tail, uses, acc)
  }
}

# A handle needs the force-drop here iff it is read >= 2 times AND its
# last use is in the tail. That is the one shape the normal exit-drop
# skips (for TCO) while still dup'ing every read — leaving the birth ref
# orphaned. A read-once handle is moved raw into its single shim call (the
# shim consumes the birth ref), so it needs no drop.
fn pcs_fed_needs_drop(nm: Binder, tail: Option[Expr], uses: UseIx) : Bool / Console =
  pcs_read_count(nm.id, uses) >= 2 and pcs_name_in_tail(nm, tail)

fn pcs_fed_make_drops(names: [Binder]) : [Stmt] = match names {
  []           -> []
  [nm, ...rest] -> [pcs_make_drop_stmt(nm.id, 0, 0), ...pcs_fed_make_drops(rest)]
}

# Recurse into each statement's sub-expressions (handles bound in inner
# blocks get their own drop there).
fn pcs_fed_stmts(stmts: [Stmt], opaque_lets: [Binder], uses: UseIx) : [Stmt] / Console = match stmts {
  []           -> []
  [s, ...rest] -> [pcs_fed_stmt(s, opaque_lets, uses), ...pcs_fed_stmts(rest, opaque_lets, uses)]
}

fn pcs_fed_stmt(s: Stmt, opaque_lets: [Binder], uses: UseIx) : Stmt / Console = match s {
  SLet(p, t, e)       -> SLet(p, t, pcs_force_opaque_exit_drops(e, opaque_lets, uses))
  SExprStmt(e)        -> SExprStmt(pcs_force_opaque_exit_drops(e, opaque_lets, uses))
  _                   -> s
}

pub(pkg) fn pcs_collect_block_let_exit_drops(stmts: [Stmt], uses: UseIx, opt_tail: Option[Expr],
                                     move_last_set: [Binder], force_set: [Binder],
                                     acc: [Stmt]) : [Stmt] {
  match stmts {
    [] -> list_reverse(acc)
    [s, ...rest] -> {
      let acc1 = match s {
        SLet(pat, _, rhs) -> match pat.pkind {
          PBind(nm) -> {
            let in_block = pcs_has(prc_pat_bindings_skip_raw(pat, rhs, []), nm.id)
            let payer = pcs_let_payer(nm.id, rhs, uses, pcs_has(move_last_set, nm.id), pcs_has(force_set, nm.id))
            if in_block and pcs_pays(payer, PyExit) and not pcs_name_in_tail(nm, opt_tail) {
              [pcs_make_drop_stmt(nm.id, pat.line, pat.col), ...acc]
            } else { acc }
          }
          PWild -> acc
          _ -> pcs_drop_stmts(pcs_let_exit_paid(pcs_let_pat_elide(pat, uses), uses, opt_tail, move_last_set, force_set),
                              pat.line, pat.col, acc)
        }
        _ -> acc
      }
      pcs_collect_block_let_exit_drops(rest, uses, opt_tail, move_last_set, force_set, acc1)
    }
  }
}

pub(pkg) fn pcs_let_pat_elide(pat: Pattern, uses: UseIx) : Pattern = match pat.pkind {
  PBind(_) -> pat
  _        -> pcs_pat_elide(pat, pcs_arm_elide_names(pat, uses, []))
}

# The binders of a destructuring `let` the block exit pays: each holds a
# bind-time reference, owed like an arm binder's.
fn pcs_let_exit_paid(pat: Pattern, uses: UseIx, opt_tail: Option[Expr],
                     move_last_set: [Binder], force_set: [Binder]) : [Binder] =
  filter(prc_pat_bindings(pat, []), (nm) => {
    pcs_pays(pcs_arm_payer(nm.id, uses, pcs_has(move_last_set, nm.id), pcs_has(force_set, nm.id)), PyExit)
      and not pcs_name_in_tail(nm, opt_tail)
  })

fn pcs_drop_stmts(names: [Binder], ln: Int, cl: Int, acc: [Stmt]) : [Stmt] = match names {
  [] -> acc
  [nm, ...rest] -> pcs_drop_stmts(rest, ln, cl, [pcs_make_drop_stmt(nm.id, ln, cl), ...acc])
}

fn pcs_name_in_tail(nm: Binder, opt_tail: Option[Expr]) : Bool = match opt_tail {
  None    -> false
  Some(e) -> pcs_mentions(nm, e)
}

pub(pkg) fn pcs_arm_elide_names(pat: Pattern, uses: UseIx, acc: [Binder]) : [Binder] = match pat.pkind {
  PBind(nm) ->
    if not pcs_unread(nm.id, uses) { acc } else { [nm, ...acc] }
  PList(ps, _)             -> pcs_aen_list(ps, uses, acc)
  PVariant(_, ps)          -> pcs_aen_list(ps, uses, acc)
  PVariantRecord(_, fs)    -> pcs_aen_list(map(fs, (f) => match f { PField(_, p, _) -> p }), uses, acc)
  PRecord(fs)              -> pcs_aen_list(map(fs, (f) => match f { PField(_, p, _) -> p }), uses, acc)
  PAs(_, inner)            -> pcs_arm_elide_names(inner, uses, acc)
  _                        -> acc
}

fn pcs_aen_list(ps: [Pattern], uses: UseIx, acc: [Binder]) : [Binder] = match ps {
  []           -> acc
  [p, ...rest] -> pcs_aen_list(rest, uses, pcs_arm_elide_names(p, uses, acc))
}

pub(pkg) fn pcs_pat_elide(pat: Pattern, elide: [Binder]) : Pattern = match elide {
  []         -> pat
  [_, ...__] -> Pattern { pkind: pcs_pat_elide_kind(pat.pkind, elide),
                          line: pat.line, col: pat.col }
}

fn pcs_pat_elide_kind(k: PatKind, elide: [Binder]) : PatKind = match k {
  PBind(nm)             -> if pcs_has(elide, nm.id) { PWild } else { k }
  PList(ps, rest)       -> PList(map(ps, (p) => pcs_pat_elide(p, elide)), rest)
  PVariant(cn, ps)      -> PVariant(cn, map(ps, (p) => pcs_pat_elide(p, elide)))
  PVariantRecord(cn, fs) -> PVariantRecord(cn, pcs_pe_fields(fs, elide))
  PRecord(fs)           -> PRecord(pcs_pe_fields(fs, elide))
  PAs(nm, inner)        -> PAs(nm, pcs_pat_elide(inner, elide))
  PWild                 -> k
  PLit(_)               -> k
  PRange(_, _)          -> k
  PHole(_)              -> k
  PNarrow(_, _)         -> k
  PSurface(_)           -> k
}

fn pcs_pe_fields(fs: [PField], elide: [Binder]) : [PField] =
  map(fs, (f) => match f { PField(n, p, sh) -> PField(n, pcs_pat_elide(p, elide), sh) })

# Per-path exit drops for a tail that holds a self-call.
#
# The post-tail wrap cannot release a binding when the tail is a
# self-tail-call — binding the call to a temporary would hide it from the
# TCO rewrite. Each tail path is closed individually instead: a direct
# self-call leaf hoists its arguments into temporaries, drops after that
# last read, and re-issues the call as the new block's tail (still a
# self-tail-call, so the goto survives); a plain-value leaf binds its
# value, drops, and yields. `None` declines the whole tail — the binding
# keeps its leak — when a path yields no expression. Partial planting is
# never attempted. A caller hoists only where `phg_keeps_marks` holds;
# `bpos`, the fn's borrowed boxed slots, keeps a bare read there in place.


fn ppd_plant(e: Expr, self_name: SelfRef, names: [Binder], bpos: [Int]) : Option[Expr] =
  if not ppd_has_self_call(e, self_name) { Some(ppd_wrap_leaf(e, names)) }
  else { ppd_plant_kind(e, self_name, names, bpos) }

fn ppd_plant_kind(e: Expr, self_name: SelfRef, names: [Binder], bpos: [Int]) : Option[Expr] = match e.kind {
  ECall(f, xs)    -> Some(ppd_hoist_with(e, f, xs, ppd_drops(names, e.line, e.col), bpos))
  EIf(c, t, oe)   -> ppd_plant_if(e, c, t, oe, self_name, names, bpos)
  EMatch(s, arms) -> match ppd_plant_arms(arms, self_name, names, bpos, []) {
    None        -> None
    Some(arms2) -> Some(ppd_rekind(e, EMatch(s, arms2)))
  }
  EBlock(bstmts, obt) -> ppd_plant_block(e, bstmts, obt, self_name, names, bpos)
  _ -> None
}

fn ppd_plant_if(e: Expr, c: Expr, t: Expr, oe: Option[Expr],
                self_name: SelfRef, names: [Binder], bpos: [Int]) : Option[Expr] = match oe {
  None     -> None
  Some(e2) -> ppd_both(ppd_plant(t, self_name, names, bpos), ppd_plant(e2, self_name, names, bpos),
                       (t2, e22) => ppd_rekind(e, EIf(c, t2, Some(e22))))
}

fn ppd_plant_block(e: Expr, bstmts: [Stmt], obt: Option[Expr],
                   self_name: SelfRef, names: [Binder], bpos: [Int]) : Option[Expr] = match obt {
  None -> None
  Some(bt) ->
    # An inner planting already hoisted this call's args: every read is
    # behind the temps, so these drops slot in before the tail. Hoisting
    # again would bind a temp to its own name inside one C scope.
    if ppd_is_hoist_block(bstmts) {
      Some(ppd_rekind(e, EBlock(list_append(bstmts, ppd_drops(names, e.line, e.col)), Some(bt))))
    }
    else { ppd_map(ppd_plant(bt, self_name, names, bpos),
                   (bt2) => ppd_rekind(e, EBlock(bstmts, Some(bt2)))) }
}

fn ppd_plant_arms(arms: [Arm], self_name: SelfRef, names: [Binder], bpos: [Int],
                  acc: [Arm]) : Option[[Arm]] = match arms {
  [] -> Some(list_reverse(acc))
  [a, ...rest] -> match a {
    Arm(pat, g, body) -> match ppd_plant(body, self_name, names, bpos) {
      None -> None
      Some(b2) -> ppd_plant_arms(rest, self_name, names, bpos, [Arm(pat, g, b2), ...acc])
    }
  }
}

fn ppd_map(o: Option[Expr], f: (Expr) -> Expr) : Option[Expr] = match o {
  None    -> None
  Some(x) -> Some(f(x))
}

fn ppd_both(a: Option[Expr], b: Option[Expr], f: (Expr, Expr) -> Expr) : Option[Expr] = match a {
  None    -> None
  Some(x) -> match b { None -> None  Some(y) -> Some(f(x, y)) }
}

fn ppd_rekind(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn ppd_wrap_leaf(e: Expr, names: [Binder]) : Expr = ppd_bind_then(e, ppd_drops(names, e.line, e.col))

pub(pkg) fn ppd_bind_then(e: Expr, stmts: [Stmt]) : Expr = {
  let ret_let = SLet(mk_pat(PBind(ret_slot_binder(RsTail)), e.line, e.col), None, e)
  let ret_var = Expr { kind: ELocal(ret_slot_local(RsTail)), line: e.line, col: e.col,
                       ty: e.ty, mode: e.mode,  site: e.site }
  ppd_rekind(e, EBlock([ret_let, ...stmts], Some(ret_var)))
}

pub(pkg) fn ppd_hoist_then(call: Expr, stmts: [Stmt], bpos: [Int]) : Expr = match call.kind {
  ECall(f, xs) -> ppd_hoist_with(call, f, xs, stmts, bpos)
  _            -> call
}

pub(pkg) fn ppd_drop_among(d: Stmt, names: [Binder]) : Bool = match ppd_drop_name(d) {
  Some(l) -> pcs_has(names, l)
  None    -> true
}


# Bind the args left-to-right (evaluation order unchanged), drop after
# that last read, re-issue the call as the block tail. Each read carries
# the argument's type and mode — an unboxed argument binds a raw local.
# Temps are numbered densely over the hoisted args: `i` is the call
# position, `k` the next temp.
fn ppd_hoist_with(e: Expr, f: Expr, xs: [Expr], stmts: [Stmt], bpos: [Int]) : Expr {
  let call = ppd_rekind(e, ECall(f, ppd_hoist_reads(xs, bpos, 0, 0)))
  ppd_rekind(e, EBlock(list_append(ppd_hoist_lets(xs, bpos, 0, 0), stmts), Some(call)))
}

fn ppd_hoist_lets(xs: [Expr], bpos: [Int], i: Int, k: Int) : [Stmt] = match xs {
  []           -> []
  [a, ...rest] ->
    if ppd_stays(a, bpos, i) { ppd_hoist_lets(rest, bpos, i + 1, k) }
    else { [SLet(mk_pat(PBind(ret_slot_binder(ret_slot_tail_arg(a, k))), a.line, a.col), None, a),
            ...ppd_hoist_lets(rest, bpos, i + 1, k + 1)] }
}

fn ppd_hoist_reads(xs: [Expr], bpos: [Int], i: Int, k: Int) : [Expr] = match xs {
  []           -> []
  [a, ...rest] ->
    if ppd_stays(a, bpos, i) { [a, ...ppd_hoist_reads(rest, bpos, i + 1, k)] }
    else { [Expr { kind: ELocal(ret_slot_local(ret_slot_tail_arg(a, k))), line: a.line, col: a.col,
                   ty: a.ty, mode: a.mode,  site: a.site },
            ...ppd_hoist_reads(rest, bpos, i + 1, k + 1)] }
}

# A bare read in a borrowed boxed slot keeps, in place, the mark the later
# passes give it there; a read has no effect to order against its siblings.
fn ppd_stays(a: Expr, bpos: [Int], i: Int) : Bool = match a.kind {
  ELocal(_) -> any(bpos, (b) => b == i)
  _         -> false
}

# A block the planting pass built around a self-call: arg temps, drops,
# then the call as tail. Consumers that reason about "reads in the tail"
# must treat the whole block as the tail — the temps ARE the call's args.
pub(pkg) fn ppd_is_hoist_block(stmts: [Stmt]) : Bool = match stmts {
  []           -> false
  [s, ...rest] -> match s {
    SLet(pat, _, _) -> ret_slot_binds_tail_arg(pat, 0) or ppd_is_hoist_block(rest)
    _               -> ppd_is_hoist_block(rest)
  }
}

pub(pkg) fn ppd_drops(names: [Binder], ln: Int, cl: Int) : [Stmt] = match names {
  []           -> []
  [b, ...rest] -> [ppd_drop_stmt(b.id, ln, cl), ...ppd_drops(rest, ln, cl)]
}

pub(pkg) fn ppd_let_names(stmts: [Stmt]) : [Binder] = match stmts {
  []           -> []
  [s, ...rest] -> match s {
    SLet(pat, _, _)     -> prc_pat_bindings(pat, ppd_let_names(rest))
    SVar(n, _, _, _, _) -> [n, ...ppd_let_names(rest)]
    _                   -> ppd_let_names(rest)
  }
}

pub(pkg) fn ppd_drop_name(s: Stmt) : Option[LocalId] = match s {
  SExprStmt(e) -> match e.kind {
    ECall(callee, args_) -> match callee.kind {
      EMark(MkDrop) -> ppd_sole_var(args_)
      _             -> None
    }
    _ -> None
  }
  _ -> None
}

fn ppd_sole_var(args_: [Expr]) : Option[LocalId] = match args_ {
  [a] -> match a.kind {
    ELocal(l) -> Some(l)
    _         -> None
  }
  _ -> None
}

fn ppd_drop_stmt(b: LocalId, ln: Int, cl: Int) : Stmt =
  SExprStmt(mk_expr(
    ECall(mk_expr(EMark(MkDrop), ln, cl), [mk_local(b, ln, cl)]),
    ln, cl))

# A self-call anywhere in tail position, however deep the tails nest.
pub(pkg) fn ppd_has_self_call(e: Expr, self_name: SelfRef) : Bool = match e.kind {
  ECall(f, _) -> is_self_callee(f, self_name)
  EBlock(_, opt_tail) -> match opt_tail {
    None    -> false
    Some(t) -> ppd_has_self_call(t, self_name)
  }
  EIf(_, t, oe) ->
    ppd_has_self_call(t, self_name) or
    (match oe { None -> false  Some(e2) -> ppd_has_self_call(e2, self_name) })
  EMatch(_, arms) -> ppd_arms_self_call(arms, self_name)
  _ -> false
}

pub(pkg) fn ppd_all_tails_self_call(e: Expr, self_name: SelfRef) : Bool = match e.kind {
  ECall(f, _) -> is_self_callee(f, self_name)
  EBlock(_, opt_tail) -> match opt_tail {
    None    -> false
    Some(t) -> ppd_all_tails_self_call(t, self_name)
  }
  EIf(_, t, oe) ->
    ppd_all_tails_self_call(t, self_name) and
    (match oe { None -> false  Some(e2) -> ppd_all_tails_self_call(e2, self_name) })
  EMatch(_, arms) -> ppd_arms_all_self_call(arms, self_name)
  _ -> false
}

fn ppd_arms_all_self_call(arms: [Arm], self_name: SelfRef) : Bool = match arms {
  []           -> true
  [a, ...rest] -> match a {
    Arm(_, _, b) -> if ppd_all_tails_self_call(b, self_name) { ppd_arms_all_self_call(rest, self_name) } else { false }
  }
}

fn ppd_arms_self_call(arms: [Arm], self_name: SelfRef) : Bool = match arms {
  []           -> false
  [a, ...rest] -> match a {
    Arm(_, _, b) -> ppd_has_self_call(b, self_name) or ppd_arms_self_call(rest, self_name)
  }
}

# Post-tail exit drops for let-bound block locals.
#
# `pcs_collect_block_let_exit_drops` splices a binding's `__perceus_drop`
# between a block's trailing statements and its tail, which leaves it unable
# to release a binding the TAIL still reads: the drop would have to run after
# the tail value exists. Such a binding keeps a `__perceus_dup` on every read
# and gets no release at all, so its birth ref is orphaned and everything
# reachable from it stays live — the list of fiber handles a nursery scope
# hands to `await` is the shape where that grows without bound.
#
# This pass closes the gap from the other side of the tail: bind the tail
# value to a temporary, drop there, yield the temporary. It runs over the
# rewritten body and fires only on bindings that carry no drop yet, so the
# two passes can never release the same binding twice.
#
# A tail holding a self-call cannot take that wrap — it would hide the call
# from the TCO rewrite and turn a loop into unbounded stack growth. Those
# tails go to `ppd_plant` (perceus_plant_drop), which closes each path
# individually, hoisting a self-call's args so the drop lands after the
# last read with the call still in tail position. A bare read in a
# borrowed boxed slot of the function stays in place; the hoist is
# declined when such a slot holds any other reference: a hoisted temp
# there would lose the argument's ownership marking.


pub(pkg) fn ptd_tail_exit_drops(e: Expr, self_name: SelfRef, uses: UseIx,
                           move_last_set: [Binder], forced: [Binder],
                           self_bpos: [Int]) : Expr =
  ptd_expr(e, self_name, uses, move_last_set, forced, self_bpos)

fn ptd_expr(e: Expr, self_name: SelfRef, uses: UseIx, mls: [Binder],
            forced: [Binder], sbp: [Int]) : Expr =
  Expr { kind: ptd_kind(e.kind, self_name, uses, mls, forced, sbp),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn ptd_kind(k: ExprKind, self_name: SelfRef, uses: UseIx, mls: [Binder],
            forced: [Binder], sbp: [Int]) : ExprKind = match k {
  EBlock(stmts, opt_tail) -> ptd_block(stmts, opt_tail, self_name, uses, mls, forced, sbp)
  _ -> prc_map_expr_kind(k, (x) => ptd_expr(x, self_name, uses, mls, forced, sbp))
}

fn ptd_block(stmts: [Stmt], opt_tail: Option[Expr], self_name: SelfRef,
             uses: UseIx, mls: [Binder], forced: [Binder], sbp: [Int]) : ExprKind {
  let stmts1 = map(stmts, (s) => ptd_stmt(s, self_name, uses, mls, forced, sbp))
  match opt_tail {
    None    -> EBlock(stmts1, None)
    Some(t) -> {
      let t1 = ptd_expr(t, self_name, uses, mls, forced, sbp)
      let orphans = ptd_orphans(stmts, uses, mls, forced, [])
      if ppd_has_self_call(t, self_name) { ptd_selfcall_tail(stmts1, t1, self_name, orphans, sbp) }
      else { ptd_wrap(stmts1, t1, orphans) }
    }
  }
}

fn ptd_selfcall_tail(stmts1: [Stmt], t1: Expr, self_name: SelfRef,
                     orphans: [Binder], sbp: [Int]) : ExprKind =
  if ptd_plant_ok(orphans, t1, self_name, sbp) {
    match ppd_plant(t1, self_name, orphans, sbp) {
      Some(t2) -> EBlock(stmts1, Some(t2))
      None     -> EBlock(stmts1, Some(t1))
    }
  } else { EBlock(stmts1, Some(t1)) }

fn ptd_plant_ok(orphans: [Binder], t1: Expr, self_name: SelfRef, sbp: [Int]) : Bool = match orphans {
  []         -> false
  [_, ...__] -> phg_keeps_marks(t1, self_name, sbp)
}

# The drops fire after the tail value is in hand, so the block still yields it.
fn ptd_wrap(stmts: [Stmt], tail: Expr, names: [Binder]) : ExprKind = match names {
  []        -> EBlock(stmts, Some(tail))
  [_, ...__] -> {
    let ret_let = SLet(mk_pat(PBind(ret_slot_binder(RsTail)), tail.line, tail.col), None, tail)
    # The read carries the tail's type and mode: an unboxed tail binds a raw
    # local, and a `ty: None` read would emit the boxed name for it.
    let ret_var = Expr { kind: ELocal(ret_slot_local(RsTail)), line: tail.line, col: tail.col,
                         ty: tail.ty, mode: tail.mode,  site: tail.site }
    EBlock(list_append(stmts, [ret_let, ...ppd_drops(names, tail.line, tail.col)]),
           Some(ret_var))
  }
}

# A binding needs the post-tail drop when every read dups it
# (`pcs_fate`) and it carries no drop yet, which for a block-local is
# exactly the tail-position case the block-exit collector declines. A
# `let` perceus itself synthesised is absent from `uses` and reads as
# never-read, so only a residual fate counts here.
fn ptd_orphans(stmts: [Stmt], uses: UseIx, mls: [Binder], forced: [Binder],
               acc: [Binder]) : [Binder] = match stmts {
  []           -> list_reverse(acc)
  [s, ...rest] -> {
    let acc1 = match s {
      # An unboxed binder is a raw C scalar with no refcount: dropping it
      # would name a boxed alias that does not exist.
      SLet(pat, _, rhs) -> match rhs.mode {
        MUnboxed -> acc
        _        -> match pat.pkind {
          PBind(b) ->
            if ptd_needs_drop(b.id, stmts, uses, mls, forced) { [b, ...acc] } else { acc }
          _ -> list_append(list_reverse(ptd_pat_orphans(pat, stmts, uses, mls, forced)), acc)
        }
      }
      _ -> acc
    }
    ptd_orphans(rest, uses, mls, forced, acc1)
  }
}

fn ptd_pat_orphans(pat: Pattern, stmts: [Stmt], uses: UseIx, mls: [Binder],
                   forced: [Binder]) : [Binder] =
  filter(prc_pat_bindings(pat, []), (b) => ptd_needs_drop(b.id, stmts, uses, mls, forced))

fn ptd_needs_drop(nm: LocalId, stmts: [Stmt], uses: UseIx, mls: [Binder],
                  forced: [Binder]) : Bool =
  if ptd_has_drop(nm, stmts) { false }
  else { pcs_fate_residual(pcs_fate_of(nm, uses, pcs_has(mls, nm), pcs_has(forced, nm))) }

# `pcs_append_drops` puts its drops at the top level of the same block, so a
# shallow scan sees every drop that could already cover `nm`.
fn ptd_has_drop(nm: LocalId, stmts: [Stmt]) : Bool = match stmts {
  []           -> false
  [s, ...rest] -> match s {
    SExprStmt(e) -> ptd_is_drop_of(nm, e) or ptd_has_drop(nm, rest)
    _            -> ptd_has_drop(nm, rest)
  }
}

fn ptd_is_drop_of(nm: LocalId, e: Expr) : Bool = match e.kind {
  ECall(f, args_) -> match f.kind {
    EMark(MkDrop) -> ptd_args_read(args_, nm)
    _             -> false
  }
  _ -> false
}

fn ptd_args_read(args_: [Expr], nm: LocalId) : Bool = match args_ {
  [a] -> match a.kind { ELocal(n) -> local_eq(n, nm)  _ -> false }
  _   -> false
}

fn ptd_stmt(s: Stmt, self_name: SelfRef, uses: UseIx, mls: [Binder],
            forced: [Binder], sbp: [Int]) : Stmt = match s {
  SLet(p, t, rhs) -> SLet(p, t, ptd_expr(rhs, self_name, uses, mls, forced, sbp))
  SExprStmt(e)    -> SExprStmt(ptd_expr(e, self_name, uses, mls, forced, sbp))
  _               -> s
}

pub(pkg) fn phg_keeps_marks(e: Expr, self_name: SelfRef, bpos: [Int]) : Bool = match bpos {
  [] -> true
  _  -> phg_tails_keep(e, self_name, bpos)
}

fn phg_tails_keep(e: Expr, self_name: SelfRef, bpos: [Int]) : Bool = match e.kind {
  ECall(f, xs)       -> not is_self_callee(f, self_name) or phg_args_keep(xs, bpos, 0)
  # An inner planting checked the call it hoisted.
  EBlock(stmts, obt) -> ppd_is_hoist_block(stmts) or phg_opt_keeps(obt, self_name, bpos)
  EIf(_, t, oe)      -> phg_tails_keep(t, self_name, bpos) and phg_opt_keeps(oe, self_name, bpos)
  EMatch(_, arms)    -> all(arms, (a) => match a { Arm(_, _, b) -> phg_tails_keep(b, self_name, bpos) })
  _                  -> true
}

fn phg_opt_keeps(oe: Option[Expr], self_name: SelfRef, bpos: [Int]) : Bool = match oe {
  None    -> true
  Some(e) -> phg_tails_keep(e, self_name, bpos)
}

fn phg_args_keep(xs: [Expr], bpos: [Int], i: Int) : Bool = match xs {
  []           -> true
  [a, ...rest] -> (phg_unmarked(a) or not any(bpos, (b) => b == i)) and phg_args_keep(rest, bpos, i + 1)
}

# A bare read stays in place; an immediate Int, a Bool, unit and an absent
# slot hold no reference. The bound sits well inside the immediate range.
fn phg_unmarked(a: Expr) : Bool = match a.kind {
  ELocal(_)               -> true
  EInt(v, sfx)            -> sfx == "" and v > 0 - 1073741824 and v < 1073741824
  EBool(_)                -> true
  EUnit                   -> true
  EIntrinsic(InAbsent, _) -> true
  _                       -> false
}
