#[doc("KIR lowering of constructor application and in-place reuse of a matched constructor's cell. Mutually recursive with kir_lower_walk, kir_lower_stmts, kir_lower_calls and kir_lower_forms.")]

import compiler.ast
import compiler.ast_ids
import compiler.ast_ids
import compiler.ctor_ix
import compiler.emit_shared_syms
import compiler.infer_env
import compiler.infer_glue
import compiler.infer_state
import compiler.kinds
import compiler.kir
import compiler.kir_lower
import compiler.kir_lower_calls
import compiler.kir_lower_forms
import compiler.kir_lower_reuse
import compiler.kir_lower_walk
import compiler.perceus_read_walk
import compiler.real_lit
import compiler.rec_stamp
import compiler.symtab
import compiler.written
import compiler.kir_lower_sig

# A reuse mark over (scr, rbld...): donor scrutinee + rebuild. The mark is
# the authoritative reuse-kind tag — perceus stamped it from the pattern
# shape — so each reuse routes to its own move-semantics runtime helper.
# The record form needs its rebuild's field NAMES, so it decodes the
# `ERecordLit` into a `KRecordReuse`; the variant/cons forms share the
# slot-init `KConReuse`.
pub(pkg) fn lower_reuse(x: Expr, m: Mark, cargs: [Expr], st: LowerSt) : LRes / Console = match cargs {
  [scr, ...rbld] ->
    # Under a live region the donor is never reused in place: the rebuild
    # bump-allocates a fresh cell in the arena (`KCon` carries `in_region`),
    # and the old donor dies wholesale with the arena — no `KConReuse`, no
    # per-node RC. The donor is a scrutinee alias (`__pcs_scr`), not an owned
    # ref, so it needs no lowering here; the match's exit drop reclaims it
    # (a no-op on the arena's immortal-rc cells).
    if st.in_region { lower_reuse_fresh(x, rbld, st) }
    else { match lower_expr(scr, st) { LRes(donor, st1) ->
      match m {
        MkReuseRecord -> lower_reuse_record(x, donor, rbld, st1)
        _             -> lower_reuse_rebuild(x, reuse_kind_of(m), donor, rbld, st1)
      } } }
  _ -> LRes(KUnitV, st)
}

# The region rebuild: lower the reconstruction expression as an ordinary ctor.
# `st.in_region` is live, so the `KCon`/cons/record it emits routes to the
# arena — a fresh bump-alloc, no donor reuse. The rebuild is always a single
# expression (a ctor call or a record literal), the same shape perceus wraps.
fn lower_reuse_fresh(x: Expr, rbld: [Expr], st: LowerSt) : LRes / Console = match rbld {
  [one] -> lower_expr(one, st)
  _     -> LRes(KUnitV, st)
}

# A single-element rebuild whose head is a constructor is a variant reuse;
# otherwise it is a cons reuse (`reuse_cons` passes head+tail directly).
# The constructor is the one its callee's id names. Perceus never emits a
# reuse over a non-ctor `ECall`, so the cons layout is correct for cons and
# unreachable for anything else.
fn lower_reuse_rebuild(x: Expr, rk: KReuseKind, donor: KVal, rbld: [Expr], st: LowerSt) : LRes / Console = match rbld {
  [one] -> match one.kind {
    ECall(cf, cas) -> match cf.kind {
      ESym(s, _)       -> match ls_ctor_lay(st, s) {
        Some(c) -> lower_reuse_con(x, rk, donor, c, cas, st)
        None    -> lower_reuse_cons(x, rk, donor, rbld, st)
      }
      _ -> lower_reuse_cons(x, rk, donor, rbld, st)
    }
    _ -> lower_reuse_cons(x, rk, donor, rbld, st)
  }
  _ -> lower_reuse_cons(x, rk, donor, rbld, st)
}

fn lower_reuse_cons(x: Expr, rk: KReuseKind, donor: KVal, rbld: [Expr], st: LowerSt) : LRes / Console =
  lower_reuse_con(x, rk, donor, ctor_lay_cons(), rbld, st)

# native variant reuse leak (#872). Two backend-distinct reuse shapes:
#
#  - FLAT (bijective) rebuild — every rebuild slot is a direct top-level kept
#    child or a scalar. `KConReuse` reuses the donor cell IN PLACE. A SHARED
#    donor fresh-allocs and keeps a borrowed reference to each kept child, which
#    the match-exit `kai_decref(donor)` cascade would free — so emit one
#    `kai_incref_if_shared(donor, child)` per embedded use (multiset). A unique
#    donor moves its children in place (no incref). This is half A of #872.
#
#  - NESTED (non-bijective) rebuild — a rebuild slot is a fresh sub-ctor that
#    embeds GRAND-children of a deconstructed inner cell (the rb-tree rotation
#    `Node(_, Node(Red, lx, ..), ..) -> Node(.., Node(.., lx, ..), ..)`). The C
#    oracle reuses BOTH the outer cell and the inner cell (Koka 2-of-3 token
#    reuse). Native mirrors it with a dual-branch fork
#    (`lower_reuse_nested_dual`) when the arm's slot plan is available
#    (`st.rnested`): the UNIQUE branch steals the inner cell's shell through
#    the outer's slot, settles the per-slot RC (kir_lower_reuse), donates the
#    token to the first same-arity sub-ctor and overwrites the outer in
#    place; the SHARED branch — and any arm whose pattern the plan does not
#    cover — keeps the fresh-alloc path (`lower_reuse_nested_fresh`): fresh
#    outer + one unconditional `dup` per embedded borrowed leaf (multiset),
#    the match-exit `kai_decref(donor)` cascade reclaiming donor + inner +
#    originals.
# The shared-donor incref of each kept child must precede `lower_exprs`: a
# rebuild arg that CONSUMES a kept child (`inc(l)`, `ins(l, ..)`) reuses it
# in place inside the call, so the incref has to land BEFORE the call runs —
# else the call mutates the donor's still-live child. Emitting it after the
# args (as the old `emit_reuse_gc_increfs(.., st1)` did) protected only
# children embedded by reference, not children threaded through a call. The
# nested-rotation path keeps its own ordering (the dup precedes nothing it
# consumes — `KCon` fresh-allocs).
fn lower_reuse_con(x: Expr, rk: KReuseKind, donor: KVal, c: CtorLay, cargs: [Expr], st: LowerSt) : LRes / Console = {
  let nested = reuse_kind_is_variant(rk) and reuse_has_nested_ctor(cargs, st)
  if nested and rh_held(st) { lower_reuse_nested_fresh(x, c, cargs, st) }
  else if nested {
    match st.rnested.rot {
      RNI(oarity, nslot, n_inner, directs, grands) ->
        # In-place overwrite requires the donor and rebuilt ctor to share an
        # arity; a mismatch keeps the fresh path (the shared branch would be
        # taken inside `kaix_variant_reuse_at` anyway, but the inner steal
        # must not run against a donor the rebuild cannot absorb).
        if list_length(cargs) == oarity {
          lower_reuse_nested_dual(x, donor, c, cargs, nslot, n_inner, directs, grands, st)
        } else { lower_reuse_nested_fresh(x, c, cargs, st) }
      RNInone -> lower_reuse_nested_fresh(x, c, cargs, st)
    }
  } else if reuse_kind_is_variant(rk) {
    # A held scrutinee's exit would release the inner cells the flat fork
    # settles; that arm keeps the fresh path.
    match st.rnested.cells {
      [] -> lower_reuse_flat_fork(x, donor, c, cargs, st)
      _  -> if rh_held(st) { lower_reuse_nested_fresh(x, c, cargs, st) }
            else { lower_reuse_flat_fork(x, donor, c, cargs, st) }
    }
  } else {
    lower_reuse_dual(x, rk, donor, c, cargs, st)
  }
}

# Flat variant reuse (no nested sub-ctor). The kept-binder increfs are
# unconditional (`kaix_incref_if_shared` — a no-op on a unique donor) and
# the args lower ONCE before the fork; the branches share the atoms, so
# nothing evaluates or dups twice. The fork exists only so the UNIQUE
# branch can take the exit-drop-neutralised MOVE (`RkVariantMove`, no
# survive-the-drop incref — the C oracle's `_r = _scr; _scr = NULL`); the
# SHARED branch fresh-allocs and leaves the donor for the match-exit
# cascade, exactly the old single-body shim's else path.
fn lower_reuse_flat_fork(x: Expr, donor: KVal, c: CtorLay, cargs: [Expr], st: LowerSt) : LRes / Console =
  match ls_fresh_reg(st) { LSReg(rjoin, st0) -> {
    let pos = kpos_of(x)
    # Capture the arm's slot plan and uses BEFORE the args lower: a nested
    # match inside a rebuild arg re-sets `rnested`/`reuse_gc` per inner arm
    # and nothing restores them for the rest of this arm, so reading them
    # after `lower_exprs` settles against the WRONG pattern's plan (an
    # inner arm's slot 0 projected out of the outer donor — over-release).
    let plan = st0.rnested
    let uses = reuse_taken_uses(st0.locals, cargs, st0.reuse_gc)
    let held = rh_held(st0)
    let st_gc = if held { emit_reuse_gc_increfs(donor, rh_repeats(uses), pos, rh_own(rh_take_slots(donor, lid_uniq(uses), pos, st0), lid_uniq(uses))) }
                else { emit_reuse_gc_increfs(donor, kc_uses_outside_cells(uses, plan.cells), pos, st0) }
    # The inner cells settle before the args: an arg may consume a taken
    # binder beneath one, and lend an untaken one.
    match kc_cells_own(plan.cells, donor, uses, pos, st_gc) { CellOwn(st_own, cell_drops) ->
    match lower_kinds_held(cargs, c.kinds, 0, held, RhHolds { regs: [], st: st_own }, [], pos) { LResMany(avs, st_args) -> {
      let st1 = kc_drop_regs(cell_drops, pos, st_args)
      let st_decl = ls_emit(st1, KLet(rjoin, SBoxed, KLitOp(KUnitV), pos))
      match bind_op(st_decl, KCall("kaix_check_unique", [donor]), pos) { LRes(uv, st_u) ->
        match three_labels(st_u) { LSL3(l_uniq, l_shared, l_join, st_l) -> {
          let st_fork = ls_seal(st_l, KCondBr(uv, l_uniq, l_shared, pos), l_uniq)
          # The move overwrite pays no old slot; a donor child the rebuild
          # does not re-embed (wildcard / unused binder) still carries the
          # donor's claim and must be dropped by projection before the
          # overwrite.
          let st_paid = rn_flat_unique_drops(plan.flat, donor, uses, pos, st_fork)
          let st_ub = match bind_op(st_paid, KConReuse(RkVariantMove, donor, c.name, c.tag, typed_inits(avs, c)), pos) { LRes(ru, st_u2) ->
            ls_seal(ls_emit(reuse_neutralise_exit_drop(st_u2, pos), KStore(rjoin, ru, pos)), KBr(l_join, pos), l_shared) }
          let st_sb = match bind_op(st_ub, KCon(c.name, c.tag, c.mask, typed_inits(avs, c), st_ub.in_region), pos) { LRes(rs, st_s2) ->
            ls_seal(ls_emit(st_s2, KStore(rjoin, rs, pos)), KBr(l_join, pos), l_join) }
          LRes(KVar(rjoin), st_sb)
        } } }
    } } }
  } }

# The fresh-alloc nested rebuild: fresh outer + one unconditional dup per
# embedded borrowed leaf; the match-exit `decref(donor)` reclaims
# donor + inner + originals. The shared branch of the dual fork below, and
# the whole rebuild for arms the slot plan does not cover.
fn lower_reuse_nested_fresh(x: Expr, c: CtorLay, cargs: [Expr], st0: LowerSt) : LRes / Console = {
  let leaves = reuse_gc_uses(st0.locals, cargs, st0.reuse_gc)
  let st = if rh_held(st0) { rh_own(st0, lid_uniq(leaves)) } else { st0 }
  # The first nested sub-ctor consumes the cross-call donor (inner stage
  # off — there is no stolen shell on the fresh path). The donor's
  # uniqueness is independent of this scrutinee's, so the shared branch
  # still absorbs the caller's shell — the C backend's shared-branch site.
  # The leaf dups precede the args: an arg call may consume a borrowed leaf.
  match lower_reuse_args_donate(cargs, c.kinds, "", 0, true, false,
                                emit_reuse_leaf_dups(leaves, kpos_of(x), st), []) { LResDon(avs, _, st1) ->
    bind_op(st1, reuse_fresh_op(RkVariant, c, avs, st1), kpos_of(x)) }
}

# The dual-branch nested rotation reuse (mirrors emit_c's Koka 2-of-3 token
# reuse: outer `_scr` overwrite + `_ru_inner` donation). Arm binds are
# borrows, so the UNIQUE branch owns every old reference of the donated
# outer shell and — conditionally, via the steal — of the inner cell:
#   1. project the inner cell and steal its shell (`KTokenSteal`; null when
#      the inner is shared, after its non-recursive rc--);
#   2. settle the RC per slot plan (`rn_direct_acct` / `rn_grand_acct`) so
#      each embedded use owns exactly one reference;
#   3. lower the rebuild args, donating the token to the first same-arity
#      sub-ctor (`KConAt` rebuilds into the shell; a null token falls back
#      to a fresh alloc inside the runtime); an undonated token is freed;
#   4. overwrite the outer in place (`KConReuse` — its incref balances the
#      match-exit drop).
# The SHARED branch is the fresh path. Args are lowered TWICE (textual
# duplication, evaluated once — the branches are mutually exclusive),
# exactly like `lower_reuse_dual` below.
fn lower_reuse_nested_dual(x: Expr, donor: KVal, c: CtorLay, cargs: [Expr],
                           nslot: Int, n_inner: Int, directs: [RNSlot], grands: [RNSlot],
                           st: LowerSt) : LRes / Console =
  match ls_fresh_reg(st) { LSReg(rjoin, st0) -> {
    let pos = kpos_of(x)
    let uses = reuse_gc_uses(st0.locals, cargs, st0.reuse_gc)
    let st_decl = ls_emit(st0, KLet(rjoin, SBoxed, KLitOp(KUnitV), pos))
    match bind_op(st_decl, KCall("kaix_check_unique", [donor]), pos) { LRes(uv, st_u) ->
      match three_labels(st_u) { LSL3(l_uniq, l_shared, l_join, st_l) -> {
        let st_fork = ls_seal(st_l, KCondBr(uv, l_uniq, l_shared, pos), l_uniq)
        let st_ub = if nslot < 0 { lower_reuse_flat_unique(donor, c, cargs, directs, uses, rjoin, l_join, l_shared, pos, st_fork) }
                    else { lower_reuse_steal_unique(donor, c, cargs, nslot, n_inner, directs, grands, uses, rjoin, l_join, l_shared, pos, st_fork) }
        # SHARED: the fresh path, joined into `rjoin`.
        let st_sb = match lower_reuse_nested_fresh(x, c, cargs, st_ub) { LRes(rs, st_s) ->
          ls_seal(ls_emit(st_s, KStore(rjoin, rs, pos)), KBr(l_join, pos), l_join) }
        LRes(KVar(rjoin), st_sb)
      } } }
  } }

# A flat pattern (the recolor-wrap shape) has no inner cell: only the outer
# overwrite applies, and the rebuild cell consumes the cross-call donor.
fn lower_reuse_flat_unique(donor: KVal, c: CtorLay, cargs: [Expr], directs: [RNSlot], uses: [LocalId],
                           rjoin: String, l_join: String, l_shared: String, pos: KPos, st_fork: LowerSt) : LowerSt / Console = {
  let st_a = rn_direct_acct(directs, donor, uses, pos, st_fork)
  match lower_reuse_args_donate(cargs, c.kinds, "", 0, true, false, st_a, []) { LResDon(avs_u, _, st_d) ->
    match bind_op(st_d, KConReuse(RkVariantMove, donor, c.name, c.tag, typed_inits(avs_u, c)), pos) { LRes(ru, st_u2) ->
      ls_seal(ls_emit(reuse_neutralise_exit_drop(st_u2, pos), KStore(rjoin, ru, pos)), KBr(l_join, pos), l_shared) } }
}

# Steal the inner shell, settle the RC per slot plan, rebuild donating the
# token, then overwrite the outer in place. The inner cell and token travel as
# register names (a fresh `KVar` per use): reusing one KVal atom across helper
# calls miscompiles under the stage1-built compiler.
fn lower_reuse_steal_unique(donor: KVal, c: CtorLay, cargs: [Expr], nslot: Int, n_inner: Int,
                            directs: [RNSlot], grands: [RNSlot], uses: [LocalId],
                            rjoin: String, l_join: String, l_shared: String, pos: KPos, st_fork: LowerSt) : LowerSt / Console =
  match ls_fresh_reg(st_fork) { LSReg(innerreg, st_r1) ->
    match ls_fresh_reg(st_r1) { LSReg(tokreg, st_r) -> {
      let st_i = ls_emit(st_r, KLet(innerreg, SBoxed, KProj(donor, nslot), pos))
      let st_t = ls_emit(st_i, KLet(tokreg, SBoxed, KTokenSteal(KVar(innerreg), n_inner), pos))
      let st_a = rn_grand_acct(grands, innerreg, tokreg, uses, pos,
                   rn_direct_acct(directs, donor, uses, pos, st_t))
      match lower_reuse_args_donate(cargs, c.kinds, tokreg, n_inner, false, false, st_a, []) {
        LResDon(avs_u, donated, st_d) -> {
          let st_f = if donated { st_d } else { ls_emit(st_d, KRC(KFreeToken(KVar(tokreg)), pos)) }
          match bind_op(st_f, KConReuse(RkVariantMove, donor, c.name, c.tag, typed_inits(avs_u, c)), pos) { LRes(ru, st_u2) ->
            ls_seal(ls_emit(reuse_neutralise_exit_drop(st_u2, pos), KStore(rjoin, ru, pos)), KBr(l_join, pos), l_shared) }
        } }
    } } }

# Lower the rebuild args, donating the inner token to the FIRST top-level
# sub-ctor whose arity matches the stolen shell (`RkTokenVariant`), and the
# fn's CROSS-CALL donor token to the NEXT sub-ctor (`RkDonorVariant` — the
# fresh cell the caller's donated shell pays for; degrades to a fresh alloc
# when no donor arrived). Exactly one consumer each; the caller frees an
# undonated inner token, the fn exit frees an unconsumed donor. `tokreg` is
# the inner token's register name (fresh `KVar` per use); `donated = true`
# at entry disables the inner stage (the fresh path, which has no stolen
# shell). Returns the INNER-donation flag only.
fn lower_reuse_args_donate(es: [Expr], ks: [Int], tokreg: String, n_inner: Int, donated: Bool,
                           ddone: Bool, st: LowerSt, acc: [KVal]) : LResDon / Console = match es {
  [] -> LResDon(acc, donated, st)
  [e, ...rest] -> match donate_ctor(e, n_inner, donated, st) {
    Some(c2) -> lower_donate_token(e, c2, rest, ks, tokreg, n_inner, donated, ddone, st, acc)
    None -> match donor_ctor(e, donated and not ddone, st) {
      Some(c3) -> lower_donate_donor(e, c3, rest, ks, tokreg, n_inner, donated, ddone, st, acc)
      None -> lower_donate_plain(e, rest, ks, tokreg, n_inner, donated, ddone, st, acc)
    }
  }
}

fn lower_donate_token(e: Expr, c2: CtorLay, rest: [Expr], ks: [Int], tokreg: String, n_inner: Int, donated: Bool,
                      ddone: Bool, st: LowerSt, acc: [KVal]) : LResDon / Console = match e.kind {
  ECall(_, cas) -> match lower_kinds_vals(cas, c2.kinds, 0, st, []) { LResMany(avs, st1) -> {
    let tokv = KVar(tokreg)
    match bind_op(st1, KConReuse(RkTokenVariant, tokv, c2.name, c2.tag, typed_inits(avs, c2)), kpos_of(e)) { LRes(v, st2) ->
      lower_reuse_args_donate(rest, ks, tokreg, n_inner, true, ddone, st2, list_append(acc, [v])) }
  } }
  _ -> lower_donate_plain(e, rest, ks, tokreg, n_inner, donated, ddone, st, acc)
}

fn lower_donate_donor(e: Expr, c3: CtorLay, rest: [Expr], ks: [Int], tokreg: String, n_inner: Int, donated: Bool,
                      ddone: Bool, st: LowerSt, acc: [KVal]) : LResDon / Console = match e.kind {
  ECall(_, cas) -> match lower_kinds_vals(cas, c3.kinds, 0, st, []) { LResMany(avs, st1) ->
    match bind_op(st1, KConReuse(RkDonorVariant, KUnitV, c3.name, c3.tag, typed_inits(avs, c3)), kpos_of(e)) { LRes(v, st2) ->
      lower_reuse_args_donate(rest, ks, tokreg, n_inner, donated, true, st2, list_append(acc, [v])) } }
  _ -> lower_donate_plain(e, rest, ks, tokreg, n_inner, donated, ddone, st, acc)
}

fn lower_donate_plain(e: Expr, rest: [Expr], ks: [Int], tokreg: String, n_inner: Int, donated: Bool,
                      ddone: Bool, st: LowerSt, acc: [KVal]) : LResDon / Console =
  match lower_at_kind(e, kind_at(ks, list_length(acc)), st) { LRes(v, st1) ->
    lower_reuse_args_donate(rest, ks, tokreg, n_inner, donated, ddone, st1, list_append(acc, [v])) }

# Args lowered at their slot kinds `ks`: a kind-1 Int slot lowers raw, as
# `lower_ctor_args` does, since the emitter reads that word without
# consuming the box a boxed value would bring.
# `ks` must come from the entry the rebuild's tag uses: its type's home here, arity in `lower_ctor_args`.
pub(pkg) fn lower_kinds_vals(es: [Expr], ks: [Int], i: Int, st: LowerSt, acc: [KVal]) : LResMany / Console = match es {
  [] -> LResMany(acc, st)
  [e, ...rest] -> match lower_at_kind(e, kind_at(ks, i), st) {
    LRes(v, st1) -> lower_kinds_vals(rest, ks, i + 1, st1, list_append(acc, [v]))
  }
}

# `lower_kinds_vals` that, under `held`, registers each operand value a
# later operand could strand until the last one has run.
fn lower_kinds_held(es: [Expr], ks: [Int], i: Int, held: Bool, h: RhHolds, acc: [KVal], pos: KPos) : LResMany / Console = match es {
  [] -> LResMany(acc, rh_release(h, pos))
  [e, ...rest] -> match lower_at_kind(e, kind_at(ks, i), h.st) {
    LRes(v, st1) -> {
      let h1 = RhHolds { regs: h.regs, st: st1 }
      lower_kinds_held(rest, ks, i + 1, held, if held { rh_hold(e, v, kind_at(ks, i), rest != [], pos, h1) } else { h1 }, list_append(acc, [v]), pos)
    }
  }
}

fn lower_at_kind(e: Expr, k: Int, st: LowerSt) : LRes / Console =
  if k == 1 { lower_expr_raw_at(e, SInt64, st) } else { lower_expr(e, st) }

# The genuine dual-branch reuse (mirrors emit_c's emit_match_arm_reuse_cons /
# _variant). The single-body `kai_reuse_or_alloc_*` shim cannot mirror C's
# per-branch binding mode: the UNIQUE branch binds the DIRECT scrutinee slots
# BORROW (no incref) and rebuilds in place (store RAW, no decref of the old
# slot — the borrow gave up no ownership), while the SHARED branch binds them
# OWNED (dup) and fresh-allocs. Borrow-no-incref and store-raw-no-decref are
# the two halves of one saving and must go together — mixing an owned bind
# with a raw store leaks, a borrow bind with a decref-store double-frees. The
# DECONSTRUCTED sub-binders were already dup'd unconditionally by the caller
# (they are incref'd in both branches, per the oracle's is_alias path), so the
# fork manages only the direct slots (`st.reuse_gc`). The body's rebuild args
# are lowered TWICE (textual duplication, evaluated once — the branches are
# mutually exclusive), exactly as C interpolates h_new_c/t_new_c in both arms.
fn lower_reuse_dual(x: Expr, rk: KReuseKind, donor: KVal, c: CtorLay, cargs: [Expr], st: LowerSt) : LRes / Console =
  match ls_fresh_reg(st) { LSReg(rjoin, st0) -> {
    let pos = kpos_of(x)
    # A direct slot the rebuild does not take has no owner once overwritten:
    # the unique branch drops it, the shared branch does not dup it.
    let uses = reuse_taken_uses(st.locals, cargs, st.reuse_gc)
    let taken = lid_uniq(reuse_taken_binders(st.reuse_gc, uses))
    let held = rh_held(st)
    let st_decl = ls_emit(st0, KLet(rjoin, SBoxed, KLitOp(KUnitV), pos))
    match bind_op(st_decl, KCall("kaix_check_unique", [donor]), pos) { LRes(uv, st_u) ->
      match three_labels(st_u) { LSL3(l_uniq, l_shared, l_join, st_l) -> {
        let st_fork0 = ls_seal(st_l, KCondBr(uv, l_uniq, l_shared, pos), l_uniq)
        let st_fork = if held { rh_own(rh_take_slots(donor, taken, pos, st_fork0), taken) } else { st_fork0 }
        # UNIQUE: direct slots stay borrows (no dup); rebuild; reuse in place.
        let st_ub = match lower_kinds_held(cargs, c.kinds, 0, held, RhHolds { regs: [], st: st_fork }, [], pos) { LResMany(avs_u, st_u0) -> {
          let st_u1 = rn_flat_unique_drops(st.rnested.flat, donor, uses, pos, st_u0)
          match bind_op(st_u1, KConReuse(rk, donor, c.name, c.tag, typed_inits(avs_u, c)), pos) { LRes(ru, st_u2) ->
            ls_seal(ls_emit(st_u2, KStore(rjoin, ru, pos)), KBr(l_join, pos), l_shared) } } }
        # SHARED: dup the direct slots (owned), rebuild, fresh-alloc. A cons
        # rebuild allocates a real KAI_CONS cell (`kai_cons`) — `Cons` is the
        # builtin list ctor, not a registered variant, so a `KCon` here would
        # build a variant-shaped cell whose `as.cons` reads are garbage.
        let st_sd = emit_direct_dups(reuse_taken_binders(st.reuse_gc, uses), pos, st_ub)
        let st_sb = match lower_kinds_held(cargs, c.kinds, 0, held, RhHolds { regs: [], st: st_sd }, [], pos) { LResMany(avs_s, st_s1) ->
          match bind_op(st_s1, reuse_fresh_op(rk, c, avs_s, st_s1), pos) { LRes(rs, st_s2) ->
            ls_seal(ls_emit(st_s2, KStore(rjoin, rs, pos)), KBr(l_join, pos), l_join) } }
        LRes(KVar(rjoin), st_sb)
      } } }
  } }

# The record-reuse rebuild is an `ERecordLit` (perceus wraps it directly);
# decode its (name, value) field inits into a `KRecordReuse` so the backend
# donates the unique scrutinee cell via `kaix_reuse_or_alloc_record` (which
# carries the parallel name array `kai_record` needs). A malformed rebuild
# (not an `ERecordLit`) cannot arise — perceus only wraps record literals —
# so fall back to unit defensively.
fn lower_reuse_record(x: Expr, donor: KVal, rbld: [Expr], st: LowerSt) : LRes / Console = match rbld {
  [one] -> match one.kind {
    ERecordLit(_, fis) -> match lower_field_inits(fis, st, []) { RecPlan(pairs, st1) ->
      bind_op(st1, KRecordReuse(donor, pairs, record_kept_mask(fis, 0, 0), rec_stamp_of(st.stamps, one.ty)), kpos_of(x)) }
    _ -> LRes(KUnitV, st)
  }
  _ -> LRes(KUnitV, st)
}

# --- Constructors / direct calls ---------------------------------------

# Lower a ctor call, each arg AT ITS SLOT: a kind-1 Int slot lowers its arg RAW
# (`lower_expr_raw_at SInt64` — no trailing `int.box`, so a raw `k` flows
# straight into the `.i64` word instead of `int.box(k)` then unbox), everything
# else boxed. Mirror of `lower_tcrec_args` for the ctor-arg ABI: the slot init
# `SIInt64`/`SIBoxed` matches the arg's lowered repr, so the emitter never
# re-boxes a raw scalar just to store it raw again (the rb-tree hot-path box).
pub(pkg) fn lower_ctor_call(x: Expr, c: CtorLay, cargs: [Expr], st: LowerSt) : LRes / Console =
  match lower_ctor_args(cargs, c.kinds, st, []) { LCtorInits(inits, st1) ->
    bind_op(lower_flight_end(st, st1), KCon(c.name, c.tag, c.mask, inits, st1.in_region), kpos_of(x)) }

fn lower_ctor_args(cargs: [Expr], ks: [Int], st: LowerSt, acc: [KSlotInit]) : LCtorInits / Console =
  match cargs {
    [] -> LCtorInits(acc, st)
    [e, ...rest] -> {
      let trest = match ks {
        [_, ...r] -> r
        [] -> []
      }
      let k = kind_at(ks, 0)
      # A user-ctor kind-1 Int slot lowers RAW; a kind-2 Real / kind-3 enum
      # slot lowers boxed but is WRAPPED at its kind so the emitter stores the
      # raw f64 bits / immediate tag word; builtins + boxed slots stay boxed.
      if k == 1 {
        match lower_expr_raw_at(e, SInt64, st) { LRes(v, st1) ->
          lower_ctor_args(rest, trest, st1, list_append(acc, [SIInt64(v)])) }
      } else if k == 2 {
        match lower_expr(e, st) { LRes(v, st1) ->
          lower_ctor_args(rest, trest, st1, list_append(acc, [SIReal(v)])) }
      } else if k == 3 {
        # Literal-ctor peephole (the C `{.i64 = tag}` mirror): a bare nullary
        # user-ctor arg (`Red`) contributes its tag as an immediate — no
        # singleton load + tag re-read. Anything else lowers boxed and the
        # emitter takes the tag at the border (`kaix_take_enum`).
        match lower_enum_slot_arg(e, st) { LRes(v, st1) ->
          lower_ctor_args(rest, trest, st1, list_append(acc, [SIEnum(v)])) }
      } else {
        match lower_expr(e, st) { LRes(v, st1) ->
          lower_ctor_args(rest, trest, lower_flight_next(e, v, rest == [], st1), list_append(acc, [SIBoxed(v)])) }
      }
    }
  }

# An enum-slot ctor arg. A NULLARY user ctor lowers to its tag immediate
# (`KIntV`); everything else lowers boxed (the emitter's `kaix_take_enum`
# reads whatever tag it carries).
fn lower_enum_slot_arg(e: Expr, st: LowerSt) : LRes / Console = match e.kind {
  ESym(s, _) -> match ctor_ix_row(st.ctor_ix, s) {
    Some(EV(ar, _, tag, _)) ->
      if ar == 0 and tag >= user_variant_tag_base() { LRes(KIntV(tag), st) }
      else { lower_expr(e, st) }
    None -> lower_expr(e, st)
  }
  _ -> lower_expr(e, st)
}
