#[doc("The rendering of surface types, rows and units as source-like text, and the stamping of the typer's resolution back into written types.")]

import compiler.util
import compiler.ast
import compiler.ast_ids
import compiler.ast_ids
import compiler.kinds
import compiler.written
import compiler.symtab
import compiler.ast_build

#[doc("Render a type for a reader, effect rows of arrow types included. A type parameter prints as `_`: `type_text_in` names it.")]
pub(pkg) fn type_text(tab: SymTab, t: TypeExpr) : String = type_text_in(tab, [], t)

#[doc("`type_text` under the type parameters `tps` in scope: each prints by the name its binder carries.")]
pub(pkg) fn type_text_in(tab: SymTab, tps: [TBinder], t: TypeExpr) : String =
  tt_type(t, TtFmt { tab: tab, sym: kind_sym_bare, param: (id) => tparam_display(tps, id) })

#[doc("Render a type as an identity key: `type_text` with kind-qualified unit symbols kept distinct and a type parameter spelled from its id.")]
pub(pkg) fn type_key(tab: SymTab, t: TypeExpr) : String = tt_type(t, TtFmt { tab: tab, sym: kind_sym_mangle, param: tparam_key })

#[doc("Render a row as an identity key: a type parameter is spelled from its id, so renaming one does not change the key.")]
pub(pkg) fn row_key(tab: SymTab, r: RowExpr) : String =
  tt_row(r, TtFmt { tab: tab, sym: kind_sym_mangle, param: tparam_key })

#[doc("Render a row for display under the type parameters `tps` in scope.")]
pub(pkg) fn row_text_in(tab: SymTab, tps: [TBinder], r: RowExpr) : String =
  tt_row(r, TtFmt { tab: tab, sym: kind_sym_bare, param: (id) => tparam_display(tps, id) })

#[doc("Render one effect-row label with its type arguments, `E` or `E[T, U]`.")]
pub(pkg) fn row_label_text(tab: SymTab, l: RowLabel) : String =
  tt_label(l, TtFmt { tab: tab, sym: kind_sym_bare, param: (id) => tparam_display([], id) })

#[doc("Render a unit expression for a reader, e.g. `kg m/s^2`.")]
pub(pkg) fn unit_text(u: UnitExprT) : String = tt_unit(u, kind_sym_bare, (id) => tparam_display([], id))

#[doc("Render a unit expression as an identity key, kind qualifiers kept C-safe.")]
pub(pkg) fn unit_key(u: UnitExprT) : String = tt_unit(u, kind_sym_mangle, tparam_key)

#[doc("How a reference prints: its declaration's name once it is settled, the name the source wrote, qualifier included, before.")]
pub(pkg) fn ref_display(tab: SymTab, r: DeclRef) : String = match r {
  DrSym(s)              -> written_text(decl_name(tab, s))
  DrWritten(None, n)    -> written_text(n)
  DrWritten(Some(q), n) -> concat_all([written_text(q), ".", written_text(n)])
}

#[doc("The name of what a reference names: its declaration's once it is settled, the name the source wrote, without its qualifier, before.")]
pub(pkg) fn ref_decl_name(tab: SymTab, r: DeclRef) : String = match r {
  DrSym(s)        -> written_text(decl_name(tab, s))
  DrWritten(_, n) -> written_text(n)
}

# The table a settled name is read from, how a unit symbol is spelled,
# and how a type parameter is.
type TtFmt = { tab: SymTab, sym: (String) -> String, param: (TLocalId) -> String }

fn tt_type(t: TypeExpr, f: TtFmt) : String =
  match t.tkind {
    TyName(r, [])      -> ref_display(f.tab, r)
    TyName(r, ts)      -> concat_all([ref_display(f.tab, r), "[", tt_types(ts, f), "]"])
    TyParam(id, [])    -> tt_param(f, id)
    TyParam(id, ts)    -> concat_all([tt_param(f, id), "[", tt_types(ts, f), "]"])
    TyList(inner)      -> concat_all(["[", tt_type(inner, f), "]"])
    TyFn(ps, ret, row) -> concat_all(["(", tt_types(ps, f), ") -> ", tt_ret(ret, row, f)])
    TyDim(base, u)     -> concat_all([tt_type(base, f), "<", tt_unit(u, f.sym, f.param), ">"])
    TyRefine(base, _)  -> concat_all([tt_type(base, f), " where <pred>"])
    TyRow(row)         -> tt_row(row, f)
    TySurface(ts)      -> match ts {
      TsTuple(tys)         -> concat_all(["(", tt_types(tys, f), ")"])
      TsUnitSpan(_, inner) -> tt_type(inner, f)
    }
  }

fn tt_param(f: TtFmt, id: TLocalId) : String = {
  let p = f.param
  p(id)
}

fn tt_tail(f: TtFmt, t: TParamRef) : String = match t {
  TpId(id) -> tt_param(f, id)
  _        -> tail_written_text(t)
}

fn tt_types(ts: [TypeExpr], f: TtFmt) : String =
  join_with(map(ts, (t) => tt_type(t, f)), ", ")

fn tt_ret(ret: TypeExpr, row: RowExpr, f: TtFmt) : String =
  if tt_row_prints(row) { concat_all([tt_grouped(ret, f), " / ", tt_row(row, f)]) }
  else { tt_type(ret, f) }

# An arrow's return and a refinement's predicate extend to the end of the
# type: a row after either binds inside it unless grouped.
fn tt_grouped(t: TypeExpr, f: TtFmt) : String =
  match t.tkind {
    TyFn(_, _, _)  -> concat_all(["(", tt_type(t, f), ")"])
    TyRefine(_, _) -> concat_all(["(", tt_type(t, f), ")"])
    _              -> tt_type(t, f)
  }

fn tt_row_prints(row: RowExpr) : Bool =
  match row {
    REmpty          -> false
    RClosed(labels) -> labels != []
    ROpen(_, _)     -> true
  }

fn tt_row(r: RowExpr, f: TtFmt) : String =
  match r {
    REmpty              -> ""
    RClosed(labels)     -> tt_labels(labels, f)
    ROpen(tail, [])     -> tt_tail(f, tail)
    ROpen(tail, labels) -> concat_all([tt_labels(labels, f), " + ", tt_tail(f, tail)])
  }

fn tt_labels(ls: [RowLabel], f: TtFmt) : String =
  join_with(map(ls, (l) => tt_label(l, f)), " + ")

fn tt_label(l: RowLabel, f: TtFmt) : String =
  match l {
    RL(r, [])    -> ref_display(f.tab, r)
    RL(r, targs) -> concat_all([ref_display(f.tab, r), "[", tt_types(targs, f), "]"])
  }

# Multiplication renders as a space (`kg m`), division as `/` with no
# spaces (`m/s`), powers as `^n`; `UOne` factors are dropped.
fn tt_unit(u: UnitExprT, sym: (String) -> String, par: (TLocalId) -> String) : String =
  match u {
    UOne        -> "1"
    USym(s)     -> sym(s)
    UParam(p)   -> par(p)
    UMul(a, b)  -> tt_unit_mul(a, b, sym, par)
    UInv(a)     -> concat_all(["1/", tt_unit(a, sym, par)])
    UPow(a, n)  -> concat_all([tt_unit(a, sym, par), "^", int_to_string(n)])
    UJoin(a, b) -> concat_all([tt_unit(a, sym, par), " + ", tt_unit(b, sym, par)])
    UVar(n)     -> cat2("?u", int_to_string(n))
    UDims(us)   -> join_with(map(us, (x) => tt_unit(x, sym, par)), ", ")
  }

fn tt_unit_mul(a: UnitExprT, b: UnitExprT, sym: (String) -> String, par: (TLocalId) -> String) : String =
  match b {
    UInv(b_inner) -> match a {
      UOne -> concat_all(["1/", tt_unit(b_inner, sym, par)])
      _    -> concat_all([tt_unit(a, sym, par), "/", tt_unit(b_inner, sym, par)])
    }
    UOne -> tt_unit(a, sym, par)
    _ -> match a {
      UOne          -> tt_unit(b, sym, par)
      UInv(a_inner) -> concat_all([tt_unit(b, sym, par), "/", tt_unit(a_inner, sym, par)])
      _             -> concat_all([tt_unit(a, sym, par), " ", tt_unit(b, sym, par)])
    }
  }

fn stamp_te(te: TypeExpr, t: Ty, resolve: (TypeExpr) -> Ty) : TypeExpr = {
  let k = match te.tkind {
    TyName(r, args) -> match t {
      TyCon(s, targs) -> TyName(stamp_ref(r, s), stamp_tes(args, targs, resolve))
      _               -> te.tkind
    }
    TyParam(p, args) -> match t {
      TyCon(_, targs) -> TyParam(p, stamp_tes(args, targs, resolve))
      _               -> te.tkind
    }
    TyList(inner) -> match t {
      TyListT(x) -> TyList(stamp_te(inner, x, resolve))
      _          -> te.tkind
    }
    TyFn(ps, ret, row) -> match t {
      TyFnT(tps, tret, _) -> TyFn(stamp_tes(ps, tps, resolve), stamp_te(ret, tret, resolve), stamp_row_with(row, resolve))
      _                      -> te.tkind
    }
    TyDim(b, u) -> match t {
      TyDimT(tb, _) -> TyDim(stamp_te(b, tb, resolve), u)
      _             -> te.tkind
    }
    _ -> te.tkind
  }
  TypeExpr { tkind: k, line: te.line, col: te.col }
}

#[doc("Pairwise `stamp_te`; a length mismatch leaves the written types as they are.")]
pub(pkg) fn stamp_tes(tes: [TypeExpr], ts: [Ty], resolve: (TypeExpr) -> Ty) : [TypeExpr] =
  if list_length(tes) != list_length(ts) { tes } else { stamp_zip(tes, ts, resolve) }

fn stamp_zip(tes: [TypeExpr], ts: [Ty], resolve: (TypeExpr) -> Ty) : [TypeExpr] = match tes {
  [] -> []
  [te, ...rest] -> match ts {
    [t, ...trest] -> [stamp_te(te, t, resolve), ...stamp_zip(rest, trest, resolve)]
    []            -> tes
  }
}

#[doc("`row` with each label's type arguments stamped by `resolve`, the resolver the signature was typed with.")]
pub(pkg) fn stamp_row_with(row: RowExpr, resolve: (TypeExpr) -> Ty) : RowExpr = match row {
  REmpty       -> REmpty
  RClosed(ls)  -> if stamp_row_bare(ls) { row } else { RClosed(map(ls, (l) => stamp_label(l, resolve))) }
  ROpen(v, ls) -> if stamp_row_bare(ls) { row } else { ROpen(v, map(ls, (l) => stamp_label(l, resolve))) }
}

# A row whose labels take no type arguments has nothing to stamp.
fn stamp_row_bare(ls: [RowLabel]) : Bool = all(ls, (l) => match l { RL(_, args) -> list_is_empty(args) })

fn stamp_label(l: RowLabel, resolve: (TypeExpr) -> Ty) : RowLabel = match l {
  RL(e, args) -> RL(e, map(args, (a) => stamp_with(a, resolve)))
}

#[doc("`ps` with each written parameter type stamped by `resolve`.")]
pub(pkg) fn stamp_params(ps: [Param], resolve: (TypeExpr) -> Ty) : [Param] =
  map(ps, (p) => Param { ...p, ptype: stamp_opt(p.ptype, resolve) })

#[doc("A written type, when there is one, stamped by `resolve`.")]
pub(pkg) fn stamp_opt(o: Option[TypeExpr], resolve: (TypeExpr) -> Ty) : Option[TypeExpr] = match o {
  Some(te) -> Some(stamp_with(te, resolve))
  None     -> None
}

fn stamp_with(te: TypeExpr, resolve: (TypeExpr) -> Ty) : TypeExpr = stamp_te(te, resolve(te), resolve)

fn stamp_ref(r: DeclRef, s: SymId) : DeclRef =
  if ref_resolved(r) or sym_raw(s) < 0 { r } else { DrSym(s) }

#[doc("The declarations the written names in `te` resolve to, in order; unresolved names contribute nothing.")]
pub(pkg) fn te_decl_ids(te: TypeExpr) : [Int] = match te.tkind {
  TyName(r, args) -> {
    let rest = flat_map(args, te_decl_ids)
    if ref_resolved(r) { [sym_raw(ref_sym(r)), ...rest] } else { rest }
  }
  TyParam(_, args) -> flat_map(args, te_decl_ids)
  TyList(inner)  -> te_decl_ids(inner)
  TyFn(ps, r, _) -> list_append(flat_map(ps, te_decl_ids), te_decl_ids(r))
  TyDim(b, _)    -> te_decl_ids(b)
  _              -> []
}

#[doc("The name a type parameter was written with: for a diagnostic, a dump or an emitted symbol.")]
pub(pkg) fn tb_text(b: TBinder) : String = written_text(b.name)

#[doc("True when the parameter ranges over a unit kind's habitants.")]
pub(pkg) fn tb_is_unit(b: TBinder) : Bool = match b.kind {
  KUnit(_) -> true
  _        -> false
}

#[doc("True when the parameter ranges over arity-1 constructors.")]
pub(pkg) fn tb_is_shape(b: TBinder) : Bool = match b.kind {
  KShape -> true
  _      -> false
}

#[doc("True for a row variable a signature uses without declaring it: it holds no position among the type arguments.")]
pub(pkg) fn tb_is_row(b: TBinder) : Bool = match b.kind {
  KRow           -> true
  KRowHole(_, _) -> true
  _              -> false
}

#[doc("True for a row hole (`/ ?e`): a row parameter no name reaches.")]
pub(pkg) fn tb_is_hole(b: TBinder) : Bool = match b.kind {
  KRowHole(_, _) -> true
  _              -> false
}

#[doc("True for a plain type-kind parameter.")]
pub(pkg) fn tb_is_type(b: TBinder) : Bool = match b.kind {
  KType -> true
  _     -> false
}

#[doc("The unit kind a parameter ranges over, empty for any other parameter.")]
pub(pkg) fn tb_unit_kind(b: TBinder) : String = match b.kind {
  KUnit(k) -> k
  _        -> ""
}

#[doc("The parameter without its protocol bounds.")]
pub(pkg) fn tb_unbounded(b: TBinder) : TBinder =
  TBinder { id: b.id, name: b.name, kind: b.kind, bounds: [], implicit: b.implicit }

#[doc("The parameters the source listed in `[...]`.")]
pub(pkg) fn tbs_declared(tps: [TBinder]) : [TBinder] = filter(tps, (b) => not b.implicit)

#[doc("The parameters that hold a position among a declaration's type arguments: all but the undeclared row variables.")]
pub(pkg) fn tbs_positional(tps: [TBinder]) : [TBinder] = filter(tps, (b) => not tb_is_row(b))

#[doc("The parameter numbered `id`, if the list binds it.")]
pub(pkg) fn tbs_find(tps: [TBinder], id: TLocalId) : Option[TBinder] = match tps {
  []           -> None
  [b, ...rest] -> if tlocal_eq(b.id, id) { Some(b) } else { tbs_find(rest, id) }
}

#[doc("True when the list binds the parameter numbered `id`.")]
pub(pkg) fn tbs_has(tps: [TBinder], id: TLocalId) : Bool = match tbs_find(tps, id) {
  Some(_) -> true
  None    -> false
}

#[doc("The ids of the parameters, in order.")]
pub(pkg) fn tbs_ids(tps: [TBinder]) : [TLocalId] = map(tps, (b) => b.id)

#[doc("The written names of the parameters, in order: for a diagnostic or a dump.")]
pub(pkg) fn tbs_texts(tps: [TBinder]) : [String] = map(tps, tb_text)

#[doc("True when `ids` holds `id`.")]
pub(pkg) fn tids_has(ids: [TLocalId], id: TLocalId) : Bool = match ids {
  []           -> false
  [x, ...rest] -> if tlocal_eq(x, id) { true } else { tids_has(rest, id) }
}

#[doc("`ids` with `id` appended unless it is already there.")]
pub(pkg) fn tids_add(ids: [TLocalId], id: TLocalId) : [TLocalId] =
  if tids_has(ids, id) { ids } else { list_append(ids, [id]) }

#[doc("A spelling made from a parameter's id alone: a key, or a dispatch head, that tells two parameters apart whatever they are called. C-safe, and lowercase-initial so no declared type shares it.")]
pub(pkg) fn tparam_key(id: TLocalId) : String = {
  let n = tlocal_raw(id)
  if n >= 0 { string_concat("tparam", int_to_string(n)) } else { string_concat("tparamm", int_to_string(0 - n)) }
}

#[doc("A use of the parameter `b` as a type, at a position.")]
pub(pkg) fn tb_use(b: TBinder, line: Int, col: Int) : TypeExpr = mk_ty(TyParam(b.id, []), line, col)

#[doc("The name of the parameter numbered `id` among `tps`, or a placeholder when the list does not bind it: for a diagnostic or a dump.")]
pub(pkg) fn tbs_text_of(tps: [TBinder], id: TLocalId) : String = match tbs_find(tps, id) {
  Some(b) -> tb_text(b)
  None    -> "?"
}

#[doc("A row tail as the source spells it while it is still written: a row variable's name, `?` or `?name` for a hole. A numbered tail has no spelling of its own.")]
pub(pkg) fn tail_written_text(t: TParamRef) : String = match t {
  TpWritten(n)          -> written_text(n)
  TpHole(None, _, _)    -> "?"
  TpHole(Some(n), _, _) -> string_concat("?", n)
  TpId(_)               -> "_"
}

#[doc("How a type parameter prints: by the name its binder among `tps` carries, `_` when none of them binds it.")]
pub(pkg) fn tparam_display(tps: [TBinder], id: TLocalId) : String = match tbs_find(tps, id) {
  Some(b) -> if tb_is_hole(b) { string_concat("?", tb_text(b)) } else { tb_text(b) }
  None    -> "_"
}

#[doc("How a row tail prints under the parameters `tps`.")]
pub(pkg) fn tail_display(tps: [TBinder], t: TParamRef) : String = match t {
  TpId(id) -> tparam_display(tps, id)
  _        -> tail_written_text(t)
}

#[doc("The row parameter a tail names, the unnumbered id while it is still written.")]
pub(pkg) fn tail_id(t: TParamRef) : TLocalId = match t {
  TpId(id) -> id
  _        -> tlocal_none()
}
