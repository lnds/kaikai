#[doc("""
The single rendering of a surface `TypeExpr`, `RowExpr` and `UnitExprT`
as source-like text.

Diagnostics, dumps and codegen keys all read types through here, so an
arrow's effect row and a label's type arguments print everywhere or
nowhere. The one legitimate variation is how a unit symbol is spelled:
`*_text` drops its kind qualifier for a reader (`Metric$m` -> `m`), while
`*_key` keeps it C-safe (`Metric_k_m`) for callers that use the string
as an identity, where two kinds' `m` must stay distinct.
""")]

import compiler.util
import compiler.ast
import compiler.kinds

#[doc("Render a type for a reader, effect rows of arrow types included.")]
pub fn type_text(t: TypeExpr) : String = tt_type(t, TtFmt { sym: kind_sym_bare, lab: tt_same })

#[doc("Render a type as an identity key: `type_text` with kind-qualified unit symbols kept distinct.")]
pub fn type_key(t: TypeExpr) : String = tt_type(t, TtFmt { sym: kind_sym_mangle, lab: tt_same })

#[doc("Render an effect row's labels and tail as `A + B[T] + e`, without the leading ` / `.")]
pub fn row_text(r: RowExpr) : String = tt_row(r, TtFmt { sym: kind_sym_bare, lab: tt_same })

#[doc("Render one effect-row label with its type arguments, `E` or `E[T, U]`.")]
pub fn row_label_text(l: RowLabel) : String = tt_label(l, TtFmt { sym: kind_sym_bare, lab: tt_same })

#[doc("Render a unit expression for a reader, e.g. `kg m/s^2`.")]
pub fn unit_text(u: UnitExprT) : String = tt_unit(u, kind_sym_bare)

#[doc("Render a unit expression as an identity key, kind qualifiers kept C-safe.")]
pub fn unit_key(u: UnitExprT) : String = tt_unit(u, kind_sym_mangle)

#[doc("Render a type for a reader, each effect label's name passed through `lab`.")]
pub fn type_text_with(t: TypeExpr, lab: (String) -> String) : String =
  tt_type(t, TtFmt { sym: kind_sym_bare, lab: lab })

fn tt_same(n: String) : String = n

# How a unit symbol and an effect label are spelled.
type TtFmt = { sym: (String) -> String, lab: (String) -> String }

fn tt_type(t: TypeExpr, f: TtFmt) : String =
  match t.tkind {
    TyName(n, [])      -> n
    TyName(n, ts)      -> concat_all([n, "[", tt_types(ts, f), "]"])
    TyList(inner)      -> concat_all(["[", tt_type(inner, f), "]"])
    TyFn(ps, ret, row) -> concat_all(["(", tt_types(ps, f), ") -> ", tt_ret(ret, row, f)])
    TyDim(base, u)     -> concat_all([tt_type(base, f), "<", tt_unit(u, f.sym), ">"])
    TyRefine(base, _)  -> concat_all([tt_type(base, f), " where <pred>"])
    TyRow(row)         -> tt_row(row, f)
    TySurface(ts)      -> match ts {
      TsTuple(tys)         -> concat_all(["(", tt_types(tys, f), ")"])
      TsUnitSpan(_, inner) -> tt_type(inner, f)
    }
  }

fn tt_types(ts: [TypeExpr], f: TtFmt) : String =
  join_with(map(ts, (t) => tt_type(t, f)), ", ")

fn tt_ret(ret: TypeExpr, row: RowExpr, f: TtFmt) : String =
  if tt_row_prints(row) { concat_all([tt_grouped(ret, f), " / ", tt_row(row, f)]) }
  else { tt_type(ret, f) }

# An arrow's return and a refinement's predicate extend to the end of the
# type: a row after either binds inside it unless grouped.
fn tt_grouped(t: TypeExpr, f: TtFmt) : String =
  match t.tkind {
    TyFn(_, _, _)  -> concat_all(["(", tt_type(t, f), ")"])
    TyRefine(_, _) -> concat_all(["(", tt_type(t, f), ")"])
    _              -> tt_type(t, f)
  }

fn tt_row_prints(row: RowExpr) : Bool =
  match row {
    REmpty          -> false
    RClosed(labels) -> labels != []
    ROpen(_, _)     -> true
  }

fn tt_row(r: RowExpr, f: TtFmt) : String =
  match r {
    REmpty              -> ""
    RClosed(labels)     -> tt_labels(labels, f)
    ROpen(tail, [])     -> tail
    ROpen(tail, labels) -> concat_all([tt_labels(labels, f), " + ", tail])
  }

fn tt_labels(ls: [RowLabel], f: TtFmt) : String =
  join_with(map(ls, (l) => tt_label(l, f)), " + ")

fn tt_label(l: RowLabel, f: TtFmt) : String =
  match l {
    RL(n, [], _)    -> f.lab(n)
    RL(n, targs, _) -> concat_all([f.lab(n), "[", tt_types(targs, f), "]"])
  }

# Multiplication renders as a space (`kg m`), division as `/` with no
# spaces (`m/s`), powers as `^n`; `UOne` factors are dropped.
fn tt_unit(u: UnitExprT, sym: (String) -> String) : String =
  match u {
    UOne        -> "1"
    USym(s)     -> sym(s)
    UMul(a, b)  -> tt_unit_mul(a, b, sym)
    UInv(a)     -> concat_all(["1/", tt_unit(a, sym)])
    UPow(a, n)  -> concat_all([tt_unit(a, sym), "^", int_to_string(n)])
    UJoin(a, b) -> concat_all([tt_unit(a, sym), " + ", tt_unit(b, sym)])
    UVar(n)     -> cat2("?u", int_to_string(n))
    UDims(us)   -> join_with(map(us, (x) => tt_unit(x, sym)), ", ")
  }

fn tt_unit_mul(a: UnitExprT, b: UnitExprT, sym: (String) -> String) : String =
  match b {
    UInv(b_inner) -> match a {
      UOne -> concat_all(["1/", tt_unit(b_inner, sym)])
      _    -> concat_all([tt_unit(a, sym), "/", tt_unit(b_inner, sym)])
    }
    UOne -> tt_unit(a, sym)
    _ -> match a {
      UOne          -> tt_unit(b, sym)
      UInv(a_inner) -> concat_all([tt_unit(b, sym), "/", tt_unit(a_inner, sym)])
      _             -> concat_all([tt_unit(a, sym), " ", tt_unit(b, sym)])
    }
  }
