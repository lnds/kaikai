#[doc("The `|>` hint for a pipe stage lambda that hands its parameter, an element, to a call that wants the whole container.")]

import compiler.diag
import compiler.ast
import compiler.ast_ids
import compiler.operators
import compiler.util
import compiler.infer_state
import compiler.infer_apply
import compiler.infer_unify_rows
import compiler.infer_handle_walk

#[doc("Replaces the mismatch `after` reports with the `|>` hint when an argument of the call is a recorded stage parameter the callee would accept whole.")]
pub fn stage_container_hint(before: InferState, after: InferState, callee_ty: Ty, arg_exprs: [Expr]) : InferState / Mutable =
  match before.stage_params {
    [] -> after
    sps -> if after.errs > before.errs { hint_args(before, after, apply_ty(after.sub, callee_ty), arg_exprs, sps) } else { after }
  }

fn hint_args(before: InferState, st: InferState, callee_ty: Ty, args_: [Expr], sps: [StageParam]) : InferState / Mutable =
  match callee_ty {
    TyFnT(params, _, _) -> hint_each(before, st, params, args_, sps)
    _ -> st
  }

fn hint_each(before: InferState, st: InferState, params: [Ty], args_: [Expr], sps: [StageParam]) : InferState / Mutable =
  match params {
    [] -> st
    [p, ...prest] -> match args_ {
      [] -> st
      [a, ...arest] -> match stage_param_of(a, sps) {
        Some(sp) -> match unify_env(st.env, apply_ty(st.sub, p), sp.container, st.sub) {
          Some(_) -> primary_hint(before, st, sp, a)
          None -> hint_each(before, st, prest, arest, sps)
        }
        None -> hint_each(before, st, prest, arest, sps)
      }
    }
  }

fn stage_param_of(a: Expr, sps: [StageParam]) : Option[StageParam] =
  match a.kind {
    ELocal(l) -> find_stage_param(l, sps)
    _ -> None
  }

fn find_stage_param(l: LocalId, sps: [StageParam]) : Option[StageParam] =
  match sps {
    [] -> None
    [sp, ...rest] -> if local_eq(sp.id, l) { Some(sp) } else { find_stage_param(l, rest) }
  }

# The mismatch the call reported is a symptom: the error is the stage taking the element.
fn primary_hint(before: InferState, st: InferState, sp: StageParam, arg: Expr) : InferState = {
  let tab = st.env.tab
  let msg = concat_all(["`", pipe_op_text(sp.pop), "` is element-wise; the stage takes `",
                        inf_ty_to_string(tab, apply_ty(st.sub, sp.container)), "`, not `",
                        inf_ty_to_string(tab, apply_ty(st.sub, sp.elem)), "`"])
  let d = mk_diag(SevError, st.file, arg.line, arg.col, msg,
                  [ri_help(st.file, arg.line, arg.col, "did you mean `|>` (apply to the whole value)?")])
  let kept = drop(st.diags, list_length(st.diags) - list_length(before.diags))
  InferState { ...st, diags: [d, ...kept], errs: before.errs + 1 }
}
