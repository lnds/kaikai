#[doc("The `|>` hint for a pipe stage lambda that hands its parameter, an element, to a call that wants the whole container.")]

import compiler.diag
import compiler.ast
import compiler.ast_ids
import compiler.operators
import compiler.util
import compiler.infer_state
import compiler.infer_apply
import compiler.infer_unify_rows
import compiler.infer_handle_walk

#[doc("Adds the container hint to the mismatch `after` reports when an argument of the call is a recorded stage parameter the callee would accept whole.")]
pub fn stage_container_hint(before: InferState, after: InferState, callee_ty: Ty, arg_exprs: [Expr]) : InferState / Console + File + Mutable =
  match before.stage_params {
    [] -> after
    sps -> if after.errs > before.errs { hint_args(after, apply_ty(after.sub, callee_ty), arg_exprs, sps) } else { after }
  }

fn hint_args(st: InferState, callee_ty: Ty, args_: [Expr], sps: [StageParam]) : InferState / Console + File + Mutable =
  match callee_ty {
    TyFnT(params, _, _) -> hint_each(st, params, args_, sps)
    _ -> st
  }

fn hint_each(st: InferState, params: [Ty], args_: [Expr], sps: [StageParam]) : InferState / Console + File + Mutable =
  match params {
    [] -> st
    [p, ...prest] -> match args_ {
      [] -> st
      [a, ...arest] -> match stage_param_of(a, sps) {
        Some(sp) -> match unify_env(st.env, apply_ty(st.sub, p), sp.container, st.sub) {
          Some(_) -> emit_hint(st, sp)
          None -> hint_each(st, prest, arest, sps)
        }
        None -> hint_each(st, prest, arest, sps)
      }
    }
  }

fn stage_param_of(a: Expr, sps: [StageParam]) : Option[StageParam] =
  match a.kind {
    ELocal(l) -> find_stage_param(l, sps)
    _ -> None
  }

fn find_stage_param(l: LocalId, sps: [StageParam]) : Option[StageParam] =
  match sps {
    [] -> None
    [sp, ...rest] -> if local_eq(sp.id, l) { Some(sp) } else { find_stage_param(l, rest) }
  }

fn emit_hint(st: InferState, sp: StageParam) : InferState / Console + File {
  let tab = st.env.tab
  let note = concat_all(["`", pipe_op_text(sp.pop), "` is element-wise; the stage takes `",
                         inf_ty_to_string(tab, apply_ty(st.sub, sp.container)), "`, not `",
                         inf_ty_to_string(tab, apply_ty(st.sub, sp.elem)), "`"])
  let help = "did you mean `|>` (apply to the whole value)?"
  diag_note(note)
  diag_help(help)
  match st.diags {
    [D(sev, file, line, col, msg, related), ...rest] ->
      InferState { ...st, diags: [D(sev, file, line, col, msg, list_append(related, [ri_note(file, line, col, note), ri_note(file, line, col, concat_all(["help: ", help]))])), ...rest] }
    _ -> st
  }
}
