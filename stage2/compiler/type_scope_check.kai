#[doc("""
The root file's ambiguous bare type names, decided by the symbol table.

A bare type two imports both export is an error naming both candidates,
the same error a contested constant or effect already gets. The name
ladder that settles a contested reference leaves such a use as written
— no home won — and the typer would then report a name it cannot place.

The decision is taken here instead, before any of that: the use site
resolves against the file's scope view, and two candidates on one rung
are reported as the ambiguity they are, naming the homes the user must
choose between.

The same walk reports a bare type, effect or pattern constructor the
file reaches only through a module it never imported, and a type name
nothing declares.
""")]

import compiler.util
import compiler.ast
import compiler.modules
import compiler.diag_file
import compiler.expr_positions
import compiler.decl_names
import compiler.name_report
import compiler.symtab
import compiler.symtab_build
import compiler.scope_view
import compiler.scope_file
import compiler.name_hidden
import compiler.diag
import compiler.written
import compiler.scalar_ty
import compiler.kinds
import compiler.tparam_bounds
import compiler.chars

# The scan's fixed inputs: the table every name resolves against, the
# view of the file being scanned, the type parameters the enclosing
# signature binds — a bound parameter is not a declaration any module
# contests — the unit-kind slots of every type, and what the position
# being read makes of a name nothing declares.
type TsChk = { tab: SymTab, view: ScopeView, file: String, tps: [String], units: [TsUnits], pos: TsPos }

# The unit-kind parameter slots of one type declaration.
type TsUnits = TsU(SymId, [Int])

# A type position, the whole body of a `type T = X`, or an argument slot
# its head declares unit-kind: there a name with no type meaning is a
# habitant, which the unit passes judge.
type TsPos = TsType | TsAlias | TsUnitArg

#[doc("The error for every bare type name the scope view of the file that wrote it leaves contested, in source order. `decls` is the segmented stream `segs` marks the imported files of; `views` index `tab`.")]
pub fn tschk_segmented(segs: [ImportSeg], decls: [Decl], tab: SymTab, views: FileViews,
      target: String, df: DiagFiles) : [Diagnostic] =
  tschk_segs(segs, decls, tab, views, target, df, tschk_unit_decls(decls, target, []), [])

fn tschk_unit_decls(ds: [Decl], target: String, acc: [TsUnits]) : [TsUnits] = match ds {
  [] -> acc
  [d, ...rest] -> match decl_transparent_inner(d) {
    Some(inner) -> tschk_unit_decls([inner, ...rest], target, acc)
    None -> match d {
      DType(_, dsym, tps, _, _, _, _, _) -> match tschk_unit_idxs(tps, 0) {
        []   -> tschk_unit_decls(rest, target, acc)
        idxs -> tschk_unit_decls(rest, target, [TsU(dsym, idxs), ...acc])
      }
      _ -> tschk_unit_decls(rest, target, acc)
    }
  }
}

fn tschk_unit_idxs(tps: [String], i: Int) : [Int] = match tps {
  [] -> []
  [t, ...rest] ->
    if tp_kind_is_unit(t) { [i, ...tschk_unit_idxs(rest, i + 1)] } else { tschk_unit_idxs(rest, i + 1) }
}

# The unit-kind slots of the type a bare head `n` resolves to.
fn tschk_unit_slots(n: String, cx: TsChk) : [Int] = match cx.units {
  [] -> []
  us -> match sv_resolve(cx.tab, cx.view, NCType, n) {
    SvSym(s) -> tschk_units_of(us, s)
    _        -> []
  }
}

fn tschk_units_of(us: [TsUnits], s: SymId) : [Int] = match us {
  [] -> []
  [TsU(d, idxs), ...rest] -> if sym_raw(d) == sym_raw(s) { idxs } else { tschk_units_of(rest, s) }
}

# A name is contested only against what the file that wrote it can see,
# so each segment is judged under its own home's view and reported
# against its own source file; the root's decls follow the marks.
fn tschk_segs(segs: [ImportSeg], decls: [Decl], tab: SymTab, views: FileViews,
      target: String, df: DiagFiles, units: [TsUnits], errs: [Diagnostic]) : [Diagnostic] = match segs {
  [] -> ts_and(errs, tschk_decls(decls, tschk_cx(tab, views, target, target, df, units), []))
  [ISeg(home, n), ...rest] -> {
    let seg_errs = tschk_decls(seg_take(decls, n),
                               tschk_cx(tab, views, home, target, df, units), [])
    tschk_segs(rest, seg_drop(decls, n), tab, views, target, df, units, ts_and(errs, seg_errs))
  }
}

fn tschk_cx(tab: SymTab, views: FileViews, home: String, target: String,
      df: DiagFiles, units: [TsUnits]) : TsChk {
  let file = if home == target { df_root(df) }
             else { df_file_of(df, home) }
  TsChk { tab: tab, view: fv_of(views, st_module_id(home)), file: file, tps: [], units: units, pos: TsType }
}

fn tschk_decls(ds: [Decl], cx: TsChk, errs: [Diagnostic]) : [Diagnostic] = match ds {
  [] -> errs
  [d, ...rest] -> tschk_decls(rest, cx, ts_and(errs, tschk_decl(d, cx)))
}

fn tschk_decl(d: Decl, cx0: TsChk) : [Diagnostic] = match d {
  DFn(_, _, tps, ps, ret, row, body, l, c, _) -> {
    let cx = tschk_bind(cx0, tps)
    ts_and(tschk_params(ps, cx), ts_and(tschk_ty_opt(ret, cx), ts_and(tschk_row(row, l, c, cx), tschk_expr(body, cx))))
  }
  DConst(_, _, ty, body, _, _, _) -> ts_and(tschk_ty(ty, cx0), tschk_expr(body, cx0))
  DTest(_, body, _, _, _)      -> tschk_expr(body, cx0)
  DBench(_, body, _, _, _)     -> tschk_expr(body, cx0)
  DCheck(_, ps, body, _, _, _) -> ts_and(tschk_params(ps, cx0), tschk_expr(body, cx0))
  DType(_, _, tps, body, _, _, _, _) -> tschk_tbody(body, tschk_bind(cx0, tps))
  DEffect(_, _, tps, ops, _, _, _, _) -> tschk_ops(ops, tschk_bind(cx0, tps))
  DAxiom(_, _, _, _, tps, ps, ret, _, _, _) -> {
    let cx = tschk_bind(cx0, tps)
    ts_and(tschk_params(ps, cx), tschk_ty(ret, cx))
  }
  DImpl(_, tas, fty, subs, _, _, tps, _) -> {
    let cx = tschk_bind(cx0, tps)
    ts_and(tschk_tys(tas, cx), ts_and(tschk_ty(fty, cx), tschk_decls(subs, cx, [])))
  }
  DDerive(_, inner, _, _)       -> tschk_decl(inner, cx0)
  DUnstable(inner, _, _)        -> tschk_decl(inner, cx0)
  DProtoLaws(_, inner, _, _, _) -> tschk_decl(inner, cx0)
  DImplAxiom(_, inner, _, _, _) -> tschk_decl(inner, cx0)
  DConstructor(inner, _, _)     -> tschk_decl(inner, cx0)
  DDoc(_, _, inner, _, _)       -> tschk_decl(inner, cx0)
  DAttr(_, inner, _, _)         -> tschk_decl(inner, cx0)
  _ -> []
}

# A stored parameter carries its kind and bounds; the name a signature
# writes is what is left without them.
fn tschk_bind(cx: TsChk, tps: [String]) : TsChk =
  TsChk { ...cx, tps: list_append(cx.tps, map(tps, (t) => tp_strip_kind(tp_strip_bounds(t)))) }

fn tschk_at(cx: TsChk, pos: TsPos) : TsChk = TsChk { ...cx, pos: pos }

# Below the name a position was entered for, every name is a type again.
fn tschk_in(cx: TsChk) : TsChk = match cx.pos {
  TsType -> cx
  _      -> tschk_at(cx, TsType)
}

fn tschk_ops(ops: [EffectOp], cx0: TsChk) : [Diagnostic] = match ops {
  [] -> []
  [EffOp(_, tps, ps, ret, _, _), ...rest] -> {
    let cx = tschk_bind(cx0, tps)
    ts_and(tschk_params(ps, cx), ts_and(tschk_ty(ret, cx), tschk_ops(rest, cx0)))
  }
}

fn tschk_tbody(b: TypeBody, cx: TsChk) : [Diagnostic] = match b {
  TBAlias(t)   -> match t.tkind {
    TyName(_, []) -> tschk_ty(t, tschk_at(cx, TsAlias))
    _                -> tschk_ty(t, cx)
  }
  TBRecord(fs) -> tschk_fields(fs, cx)
  TBSum(vs)    -> tschk_variants(vs, cx)
  TBEffectAlias(ls) -> tschk_labels(ls, 0, 0, cx)
}

fn tschk_fields(fs: [FieldDecl], cx: TsChk) : [Diagnostic] = match fs {
  [] -> []
  [FD(_, _, t, _), ...rest] -> ts_and(tschk_ty(t, cx), tschk_fields(rest, cx))
}

fn tschk_variants(vs: [Variant], cx: TsChk) : [Diagnostic] = match vs {
  [] -> []
  [Var(_, ts), ...rest] -> ts_and(tschk_tys(ts, cx), tschk_variants(rest, cx))
}

fn tschk_params(ps: [Param], cx: TsChk) : [Diagnostic] = match ps {
  [] -> []
  [p, ...rest] -> ts_and(tschk_ty_opt(p.ptype, cx), tschk_params(rest, cx))
}

fn tschk_ty_opt(o: Option[TypeExpr], cx: TsChk) : [Diagnostic] = match o {
  None    -> []
  Some(t) -> tschk_ty(t, cx)
}

fn tschk_ty(t: TypeExpr, cx0: TsChk) : [Diagnostic] = {
  let cx = tschk_in(cx0)
  match t.tkind {
    TyName(DrWritten(None, n), []) -> tschk_name(written_text(n), t.line, t.col, cx0)
    TyName(DrWritten(None, n), ts) ->
      ts_and(tschk_name(written_text(n), t.line, t.col, cx), tschk_args(ts, tschk_unit_slots(written_text(n), cx), 0, cx))
    TyName(_, ts)       -> tschk_tys(ts, cx)
    TyList(x)        -> tschk_ty(x, cx)
    TyFn(ps, r, row) -> ts_and(tschk_tys(ps, cx), ts_and(tschk_ty(r, cx), tschk_row(row, t.line, t.col, cx)))
    TyDim(x, _)      -> tschk_ty(x, cx)
    TyRefine(x, _)   -> tschk_ty(x, cx)
    _ -> []
  }
}

fn tschk_args(ts: [TypeExpr], units: [Int], i: Int, cx: TsChk) : [Diagnostic] = match ts {
  [] -> []
  [t, ...rest] ->
    ts_and(tschk_ty(t, if any(units, (u) => u == i) { tschk_at(cx, TsUnitArg) } else { cx }), tschk_args(rest, units, i + 1, cx))
}

fn tschk_tys(ts: [TypeExpr], cx: TsChk) : [Diagnostic] = match ts {
  [] -> []
  [t, ...rest] -> ts_and(tschk_ty(t, cx), tschk_tys(rest, cx))
}

# A row label carries no position of its own; the enclosing one stands in.
fn tschk_row(r: RowExpr, l: Int, c: Int, cx: TsChk) : [Diagnostic] = match r {
  REmpty       -> []
  RClosed(ls)  -> tschk_labels(ls, l, c, cx)
  ROpen(_, ls) -> tschk_labels(ls, l, c, cx)
}

fn tschk_labels(ls: [RowLabel], l: Int, c: Int, cx: TsChk) : [Diagnostic] = match ls {
  [] -> []
  [RL(r, ts), ...rest] ->
    ts_and(tschk_hidden_ref(r, [NCEffect, NCType], l, c, cx), ts_and(tschk_tys(ts, cx), tschk_labels(rest, l, c, cx)))
}

# An annotation inside a body reaches the same report as one in a
# signature. `xp_positions` carries the walk to every sub-expression;
# the arms here name only the positions that hold a type.
fn tschk_expr(e: Expr, cx: TsChk) : [Diagnostic] =
  ts_and(tschk_here(e, cx), tschk_children(xp_positions(e), cx))

fn tschk_here(e: Expr, cx: TsChk) : [Diagnostic] = match e.kind {
  ELambda(ps, _)        -> tschk_params(ps, cx)
  EVariantsOf(t, _)     -> tschk_ty(t, cx)
  EBlock(ss, _)         -> tschk_stmts(ss, cx)
  EMatch(_, arms)       -> tschk_arms(arms, cx)
  EHandle(_, r, ts, _, _, _, _) -> ts_and(tschk_hidden_ref(r, [NCEffect, NCType], e.line, e.col, cx), tschk_tys(ts, cx))
  ERecordLit(DrWritten(None, n), _) -> tschk_record_lit(written_text(n), e.line, e.col, cx)
  _ -> []
}

fn tschk_stmts(ss: [Stmt], cx: TsChk) : [Diagnostic] = match ss {
  [] -> []
  [SLet(p, t, _), ...rest] ->
    ts_and(tschk_pat(p, cx), ts_and(tschk_ty_opt(t, cx), tschk_stmts(rest, cx)))
  [_, ...rest] -> tschk_stmts(rest, cx)
}

fn tschk_arms(arms: [Arm], cx: TsChk) : [Diagnostic] = match arms {
  [] -> []
  [Arm(p, _, _), ...rest] -> ts_and(tschk_pat(p, cx), tschk_arms(rest, cx))
}

# A narrowing pattern names a type; every other position only holds
# sub-patterns.
fn tschk_pat(p: Pattern, cx: TsChk) : [Diagnostic] = match p.pkind {
  PNarrow(_, t)              -> tschk_ty(t, cx)
  PVariant(r, subs)          -> ts_and(tschk_hidden_ref(r, [NCCtor], p.line, p.col, cx), tschk_pats(subs, cx))
  PVariantRecord(r, fs)      -> ts_and(tschk_hidden_ref(r, [NCCtor], p.line, p.col, cx), tschk_pfields(fs, cx))
  PRecord(fs)                -> tschk_pfields(fs, cx)
  PList(subs, _)             -> tschk_pats(subs, cx)
  PAs(_, inner)              -> tschk_pat(inner, cx)
  PSurface(ps)               -> tschk_pats(patsurface_children(ps), cx)
  _ -> []
}

fn tschk_pats(ps: [Pattern], cx: TsChk) : [Diagnostic] = match ps {
  [] -> []
  [p, ...rest] -> ts_and(tschk_pat(p, cx), tschk_pats(rest, cx))
}

fn tschk_pfields(fs: [PField], cx: TsChk) : [Diagnostic] = match fs {
  [] -> []
  [PField(_, sub, _), ...rest] -> ts_and(tschk_pat(sub, cx), tschk_pfields(rest, cx))
}

fn tschk_children(ps: [XPos], cx: TsChk) : [Diagnostic] = match ps {
  [] -> []
  [XP(_, child), ...rest] -> ts_and(tschk_expr(child, cx), tschk_children(rest, cx))
}

# A record literal names a record type, or a constructor whose payload is
# a record: a name neither class declares builds nothing.
fn tschk_record_lit(n: String, l: Int, c: Int, cx: TsChk) : [Diagnostic] =
  match split_dotted_qualifier(n) {
    Some(_) -> []
    None ->
      if any([NCType, NCExternType, NCCtor], (k) => not list_is_empty(st_candidates(cx.tab, k, n))) { [] }
      else { [nh_unknown_type_diag(cx.file, l, c, n, false)] }
  }

# A qualifier IS the choice, and a type parameter is bound by its own
# signature rather than declared by a module: neither can be contested.
fn tschk_name(n: String, l: Int, c: Int, cx: TsChk) : [Diagnostic] =
  if list_has(cx.tps, n) { [] }
  else { match split_dotted_qualifier(n) {
    Some(_) -> []
    None -> match sv_resolve(cx.tab, cx.view, NCType, n) {
      SvAmbig(ss) -> [nr_ambiguous_diag(cx.file, l, c, NCType, n, tschk_homes(cx.tab, ss, []), "", [])]
      SvSym(s) -> if sv_reaches(cx.view, sym_owner(cx.tab, s), n) { [] }
                  else { tschk_unseen(n, [NCType, NCExternType], l, c, cx) }
      SvNone   -> match cx.pos {
        TsUnitArg -> tschk_unseen(n, [NCExternType], l, c, cx)
        TsAlias   -> tschk_undeclared(n, l, c, cx, true)
        TsType    -> tschk_undeclared(n, l, c, cx, false)
      }
      _ -> tschk_unseen(n, [NCType, NCExternType], l, c, cx)
    }
  } }

# A name no type declaration answers: a foreign type the file does not
# import is reported as hidden, and a name nothing gives a meaning as unknown.
fn tschk_undeclared(n: String, l: Int, c: Int, cx: TsChk, alias: Bool) : [Diagnostic] = {
  let hidden = tschk_unseen(n, [NCExternType], l, c, cx)
  if not list_is_empty(hidden) or tschk_denotes(n, cx) { hidden }
  else { [nh_unknown_type_diag(cx.file, l, c, n, alias)] }
}

# What a bare name can denote with no type declaration behind it: a
# scalar, a core type, an implicit type or row parameter (any lowercase
# name), or a declaration of a class that shares the type namespace — a
# union component is named by its constructor alone.
fn tschk_denotes(n: String, cx: TsChk) : Bool =
  is_core_type(n) or tschk_lower(n) or tschk_scalar(n)
    or any([NCEffect, NCExternType, NCKind, NCProtocol, NCCtor], (k) => not list_is_empty(st_candidates(cx.tab, k, n)))

fn tschk_scalar(n: String) : Bool = match undeclared_ty_named(n, SnValue) {
  Some(_) -> true
  None    -> false
}

fn tschk_lower(n: String) : Bool = match char_at(n, 0) {
  Some(ch) -> ch_is_lower(ch)
  None     -> false
}

# A core type's name the file sees no declaration of names the core type.
fn tschk_unseen(n: String, cs: [NCls], l: Int, c: Int, cx: TsChk) : [Diagnostic] =
  if is_core_type(n) { [] } else { tschk_hidden(n, cs, l, c, cx) }

# Only a reference written bare can be hidden: a settled one names its
# declaration, and a qualified one went through its qualifier.
fn tschk_hidden_ref(r: DeclRef, cs: [NCls], l: Int, c: Int, cx: TsChk) : [Diagnostic] = match r {
  DrWritten(None, n) -> tschk_hidden(written_text(n), cs, l, c, cx)
  _                  -> []
}

# A bare name the file reaches only through a module it never imported.
# A qualified name went through its qualifier, and is settled already.
fn tschk_hidden(n: String, cs: [NCls], l: Int, c: Int, cx: TsChk) : [Diagnostic] =
  match sv_hidden(cx.tab, cx.view, cs, n) {
    [] -> []
    ss -> match split_dotted_qualifier(n) {
      Some(_) -> []
      None    -> [nh_diag(cx.tab, cx.view, ss, cx.file, l, c, n)]
    }
  }

fn ts_and(a: [Diagnostic], b: [Diagnostic]) : [Diagnostic] = match a {
  [] -> b
  _  -> match b {
    [] -> a
    _  -> list_append(a, b)
  }
}

fn tschk_homes(t: SymTab, ss: [SymId], acc: [String]) : [String] = match ss {
  [] -> list_reverse(acc)
  [s, ...rest] -> tschk_homes(t, rest, [written_text(sym_home(t, s)), ...acc])
}
