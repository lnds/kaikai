#[doc("""
An `extern "C" type` as the record it is to the typer: its literals, its
patterns and its field reads are typed from the fields it declares.

Only the typer reads these. A backend lays a record out from the
declared records alone, and reads an extern struct's fields by name.
""")]

import compiler.ast
import compiler.decl_names
import compiler.symtab
import compiler.symtab_build

#[doc("The id of the extern struct module `mo` (`None` = the root file) declares as `name`, or None when the table holds no such declaration.")]
pub fn extern_struct_sym(tab: SymTab, name: String, mo: Option[String]) : Option[SymId] =
  find(st_candidates(tab, NCExternType, name), (s) => match mo {
    Some(m) -> sym_same(sym_owner(tab, s), st_module_id(m))
    None    -> sym_in_root(tab, s)
  })

#[doc("A record entry for every `extern \"C\" type` of the decl stream; `tab` holds their declarations.")]
pub fn extern_records(ds: [Decl], tab: SymTab) : [RecInfo] = extern_records_loop(ds, tab, [])

fn extern_records_loop(ds: [Decl], tab: SymTab, acc: [RecInfo]) : [RecInfo] = match ds {
  [] -> acc
  [d, ...rest] -> match decl_transparent_inner(d) {
    Some(inner) -> extern_records_loop([inner, ...rest], tab, acc)
    None        -> extern_records_loop(rest, tab, extern_record(d, tab, acc))
  }
}

fn extern_record(d: Decl, tab: SymTab, acc: [RecInfo]) : [RecInfo] = match d {
  DExternType(_, name, ETStruct(fields), _, _, mo) -> match extern_struct_sym(tab, name, mo) {
    Some(s) -> [RI(s, [], fields, mo), ...acc]
    None    -> acc
  }
  _ -> acc
}
