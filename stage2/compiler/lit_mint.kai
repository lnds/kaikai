# Context-driven numeric-literal minting. When an annotation (or a `d`
# suffix) fixes a concrete numeric carrier, a literal is coined to that
# carrier at fold time from its source lexeme, exactly -- trailing zeros
# and arbitrary precision survive because the digits, not a lossy f64,
# drive the fold.
#
# The lattice is closed and by lexical shape:
#   integer `5`   -> Int, Int32, UInt32, UInt64, Int128, Byte,
#                    Decimal, DecimalBig, BigInt, Real
#   point   `0.2` -> Real, Decimal, DecimalBig  (never an integer type)
# A magnitude past the target carrier is a fold-time error, not a wrap.
#
# The unifier stays the authority: minting only PROPOSES a rewrite whose
# type equals the concrete expected, and the caller lets unification
# confirm it. When the expected type is still a variable, minting yields
# `MintNone` and the literal falls back to its shape default, so
# principality is preserved (an integer literal defaults to `Int`, a
# point literal to `Real`, and unifies) -- no "coinable-from-integer"
# obligation ever travels.

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.real_lit
import compiler.core_types
import compiler.call_site_target

# `Int128` positive maximum, `2^127 - 1` (39 digits). A minted magnitude
# above this overflows the `Decimal`/`Int128` carrier.
fn int128_max_digits() : String = "170141183460469231731687303715884105727"

pub type MintResult
  = MintOk(Expr)
  # The literal was coined to the concrete carrier.

  # The concrete carrier rejects this literal (wrong shape, or magnitude
  # past the carrier). Carries the diagnostic message.
  | MintErr(String)
  # No concrete carrier in context; the caller keeps the literal's
  # shape default and unifies.
  | MintNone

#[doc("Coin a numeric literal `value` to the concrete carrier `target`, with `bh` the home of the module declaring `BigInt`, or report why it cannot. `MintNone` means the target is not a concrete numeric carrier -- fall back to shape-default inference.")]
pub fn mint_literal(value: Expr, target: Ty, bh: String) : MintResult =
  match value.kind {
    EInt(n, span) -> mint_int(n, span, value, target, bh)
    EIntLit(span) -> mint_big_int(span, value, target, bh)
    EReal(_, span) -> mint_point(span, value, target, bh)
    EDecimalLit(span) -> mint_decimal_suffix(span, value)
    EUnop(UoNeg, inner) -> mint_negated(inner, value, target, bh)
    _ -> MintNone
  }

# `-<literal>` mints the literal and negates it on its carrier, so the
# sign never forces the literal to its shape default.
fn mint_negated(inner: Expr, value: Expr, target: Ty, bh: String) : MintResult =
  match inner.kind {
    EDecimalLit(_) -> MintNone
    _ -> match mint_literal(inner, target, bh) {
      MintOk(m) -> negate_minted(m, value, target)
      other -> other
    }
  }

fn negate_minted(m: Expr, value: Expr, target: Ty) : MintResult = match target {
  TyByte -> MintErr(unsigned_from_negative_error())
  TyUInt32 -> MintErr(unsigned_from_negative_error())
  TyUInt64 -> MintErr(unsigned_from_negative_error())
  TyCon(s, _) -> match core_decl_ty_of(s) {
    Some(c) -> MintOk(
      with_ty(
        mk_expr(
          ECall(mk_expr(home_fn_ref(core_decl_ty_home(c), "neg"), value.line, value.col), [m]),
          value.line,
          value.col
        ),
        carrier_ty(c)
      )
    )
    None -> MintNone
  }
  _ -> MintOk(with_ty(mk_expr(EUnop(UoNeg, m), value.line, value.col), target))
}

# An integer literal that fits i64. Every carrier in the lattice accepts
# it; the fold is exact because `n` is the exact value.
fn mint_int(n: Int, span: String, value: Expr, target: Ty, bh: String) : MintResult {
  let ds = int_digits_of(n, span)
  match target {
    TyInt -> MintOk(with_ty(value, TyInt))
    TyInt32 -> MintOk(mk_fixed(ds, TyInt32, value))
    TyUInt32 -> MintOk(mk_fixed(ds, TyUInt32, value))
    TyUInt64 -> MintOk(mk_fixed(ds, TyUInt64, value))
    TyInt128 -> MintOk(mk_fixed(ds, TyInt128, value))
    TyByte -> mint_byte(n, value)
    TyReal -> MintOk(mk_real(real_of_digits(ds, n), ds, value))
    TyCon(s, _) -> mint_int_carrier(ds, core_decl_ty_of(s), value, bh)
    _ -> MintNone
  }
}

fn real_of_digits(ds: String, n: Int) : Real = match string_to_real(ds) {
  Some(r) -> r
  None -> int_to_real(n)
}

# The exact decimal digits of an integer literal; a hex or binary spelling past i64 has no `n` to read them from.
fn int_digits_of(n: Int, span: String) : String =
  if span_radix(span, 0) == 10 {
    int_to_dec_string(n)
  } else {
    radix_span_digits(span, 0, string_length(span))
  }

fn mint_int_carrier(ds: String, c: Option[CoreDeclTy], value: Expr, bh: String) : MintResult =
  match c {
    Some(CdDecimal) -> mint_decimal_span(ds, 0, value)
    Some(CdDecimalBig) -> MintOk(mk_decimal_big_lit(ds, 0, value, bh))
    Some(CdBigInt) -> MintOk(mk_bigint_lit(ds, value, bh))
    Some(CdSeq) -> MintNone
    None -> MintNone
  }

fn mint_byte(n: Int, value: Expr) : MintResult =
  if n >= 0 and n <= 255 {
    MintOk(with_ty(mk_expr(mk_int_synth(n), value.line, value.col), TyByte))
  } else {
    MintErr("Byte literal out of range 0..255")
  }

# An integer literal past i64 (`EIntLit`). Only the arbitrary-precision
# carriers and `Int128` accept it; a fixed carrier is an out-of-range
# error keyed to the same escape hatch the parser used to name.
fn mint_big_int(span: String, value: Expr, target: Ty, bh: String) : MintResult =
  match target {
    TyInt128 -> mint_int128_span(int_span_digits(span), value)
    TyCon(s, _) -> mint_big_carrier(span, core_decl_ty_of(s), value, bh)
    _ -> MintErr(lit_mint_int_range_error(span))
  }

fn mint_big_carrier(span: String, c: Option[CoreDeclTy], value: Expr, bh: String) : MintResult =
  match c {
    Some(CdBigInt) -> MintOk(mk_bigint_lit(int_span_digits(span), value, bh))
    Some(CdDecimalBig) -> MintOk(mk_decimal_big_lit(int_span_digits(span), 0, value, bh))
    Some(CdDecimal) -> mint_decimal_span(int_span_digits(span), 0, value)
    Some(CdSeq) -> MintErr(lit_mint_int_range_error(span))
    None -> MintErr(lit_mint_int_range_error(span))
  }

fn mint_int128_span(span: String, value: Expr) : MintResult =
  if dec_overflows_int128(span) {
    MintErr(int128_range_error())
  } else {
    MintOk(mk_fixed(span, TyInt128, value))
  }

# A point literal (`EReal`). Only Real and the two decimal carriers
# accept it -- an integer carrier rejects the fractional form outright so
# `let n: Int = 0.2` (and `3.0`) is an error, never a truncation.
fn mint_point(span: String, value: Expr, target: Ty, bh: String) : MintResult =
  match target {
    TyReal -> MintOk(with_ty(value, TyReal))
    TyCon(s, _) -> mint_point_carrier(span, core_decl_ty_of(s), value, bh)
    TyInt -> MintErr(int_from_point_error())
    TyInt32 -> MintErr(int_from_point_error())
    TyUInt32 -> MintErr(int_from_point_error())
    TyUInt64 -> MintErr(int_from_point_error())
    TyInt128 -> MintErr(int_from_point_error())
    TyByte -> MintErr(int_from_point_error())
    _ -> MintNone
  }

fn mint_point_carrier(span: String, c: Option[CoreDeclTy], value: Expr, bh: String) : MintResult =
  match c {
    Some(CdDecimal) ->
      mint_with_parts(span, parts => mint_decimal_span(parts.raw, parts.scale, value))
    Some(CdDecimalBig) -> mint_with_parts(
      span,
      parts => MintOk(mk_decimal_big_lit(parts.raw, parts.scale, value, bh))
    )
    _ -> MintNone
  }

fn mint_with_parts(span: String, k: (DecSpanParts) -> MintResult) : MintResult =
  match dec_parts_of_span(span) {
    Some(parts) -> k(parts)
    None -> MintErr(literal_exponent_error())
  }

# The `d` suffix (`19.99d`, `42d`) always targets `Decimal`: the suffix
# supplies the carrier, whatever type is expected.
fn mint_decimal_suffix(span: String, value: Expr) : MintResult =
  mint_with_parts(span, parts => mint_decimal_span(parts.raw, parts.scale, value))

# Build a `Decimal { raw, scale }` from a raw-digit magnitude string,
# erroring when the magnitude overflows the `Int128` carrier.
fn mint_decimal_span(raw_digits: String, scale: Int, value: Expr) : MintResult =
  if dec_overflows_int128(raw_digits) {
    MintErr(decimal_range_error())
  } else {
    MintOk(mk_decimal_lit(raw_digits, scale, value))
  }

# ---- carrier node builders ----

# The carrier `c` as a minted literal's type: its declaration, by id.
fn carrier_ty(c: CoreDeclTy) : Ty = TyCon(core_decl_ty_id(c), [])

fn mk_fixed(digits: String, ty: Ty, value: Expr) : Expr =
  with_ty(mk_expr(EFixed(digits, ty), value.line, value.col), ty)

fn mk_real(r: Real, span: String, value: Expr) : Expr =
  with_ty(mk_expr(EReal(RealLit(r), span), value.line, value.col), TyReal)

# `Decimal { raw: <Int128>, scale: <Int> }`. The raw rides an EFixed so
# a magnitude above 2^63 survives the 64-bit decode.
fn mk_decimal_lit(raw_digits: String, scale: Int, value: Expr) : Expr {
  let raw = mk_fixed(raw_digits, TyInt128, value)
  let scale_lit = mk_expr(mk_int_synth(scale), value.line, value.col)
  let fields = [FI("raw", raw), FI("scale", scale_lit)]
  with_ty(
    mk_expr(ERecordLit(DrSym(core_decl_ty_id(CdDecimal)), fields), value.line, value.col),
    carrier_ty(CdDecimal)
  )
}

# `DecimalBig { raw: <BigInt>, scale: <Int> }`. The raw is a
# `bigint.from_literal` call so an unbounded magnitude folds exactly.
fn mk_decimal_big_lit(raw_digits: String, scale: Int, value: Expr, bh: String) : Expr {
  let raw = mk_bigint_lit(raw_digits, value, bh)
  let scale_lit = mk_expr(mk_int_synth(scale), value.line, value.col)
  let fields = [FI("raw", raw), FI("scale", scale_lit)]
  with_ty(
    mk_expr(ERecordLit(DrSym(core_decl_ty_id(CdDecimalBig)), fields), value.line, value.col),
    carrier_ty(CdDecimalBig)
  )
}

fn mk_bigint_lit(digits: String, value: Expr, bh: String) : Expr =
  with_ty(mk_bigint_call(digits, value, bh), carrier_ty(CdBigInt))

# `from_literal("<digits>")` of the module `bh` that declares `BigInt`,
# the same call the `n` suffix desugars to. Minting runs after the
# resolver, so the callee is that home's declaration, by id.
fn mk_bigint_call(digits: String, value: Expr, bh: String) : Expr {
  let s_lit = mk_expr(EStr(quote_digits(digits), false), value.line, value.col)
  let callee = mk_expr(home_fn_ref(bh, "from_literal"), value.line, value.col)
  mk_expr(ECall(callee, [s_lit]), value.line, value.col)
}

fn quote_digits(digits: String) : String =
  string_concat(string_concat("\"", digits), "\"")

# ---- lexeme decode (exact, string-based) ----

pub type DecSpanParts = { raw: String, scale: Int }

# Decode a decimal, radix or exponent-form lexeme into (raw-digit
# magnitude, scale). The lexeme's own fractional length less its exponent
# is the scale, floored at 0 by appending zeros, so `0.20` yields scale 2
# and `1.5e3` yields raw 1500: the digits, not a re-stringified f64,
# drive the result. `None` when the exponent is out of range.
fn dec_parts_of_span(span: String) : Option[DecSpanParts] {
  let n = string_length(span)
  let neg = match char_at(span, 0) {
    Some(c) -> c == '-'
    None -> false
  }
  let start = if neg { 1 } else { 0 }
  if span_radix(span, start) != 10 {
    Some(DecSpanParts { raw: with_sign(neg, radix_span_digits(span, start, n)), scale: 0 })
  } else {
    let epos = span_find_exp(span, start, n)
    let dot = span_find_dot(span, start, epos)
    let int_end = if dot < 0 { epos } else { dot }
    let frac_digits = if dot < 0 { "" } else { collect_digits(span, dot + 1, epos) }
    let mag = strip_leading_zeros(string_concat(collect_digits(span, start, int_end), frac_digits))
    apply_exponent(neg, mag, string_length(frac_digits), exp_value(span, epos, n))
  }
}

fn exp_limit() : Int = 4096

fn apply_exponent(neg: Bool, mag: String, frac_len: Int, exp: Int) : Option[DecSpanParts] =
  if exp > exp_limit() or exp < 0 - exp_limit() {
    None
  } else if exp >= frac_len and (not mag_is_zero(mag)) {
    Some(DecSpanParts { raw: with_sign(neg, string_concat(mag, zeros(exp - frac_len))), scale: 0 })
  } else if exp >= frac_len {
    Some(DecSpanParts { raw: "0", scale: 0 })
  } else {
    Some(DecSpanParts { raw: with_sign(neg, mag), scale: frac_len - exp })
  }

fn mag_is_zero(mag: String) : Bool = string_length(mag) == 1 and digit_at(mag, 0) == 0

fn zeros(k: Int) : String = if k <= 0 { "" } else { string_concat("0", zeros(k - 1)) }

fn span_find_exp(s: String, i: Int, n: Int) : Int =
  if i >= n {
    n
  } else {
    match char_at(s, i) {
      None -> n
      Some(c) -> if c == 'e' or c == 'E' { i } else { span_find_exp(s, i + 1, n) }
    }
  }

# The signed exponent written after the `e` at `epos`; 0 when there is none.
fn exp_value(s: String, epos: Int, n: Int) : Int =
  if epos >= n {
    0
  } else {
    match char_at(s, epos + 1) {
      Some('-') -> 0 - exp_digits(s, epos + 2, n, 0)
      Some('+') -> exp_digits(s, epos + 2, n, 0)
      _ -> exp_digits(s, epos + 1, n, 0)
    }
  }

# Saturates past the limit so an absurd exponent cannot overflow the accumulator.
fn exp_digits(s: String, i: Int, n: Int, acc: Int) : Int =
  if i >= n or acc > exp_limit() {
    acc
  } else {
    match char_at(s, i) {
      Some(c) -> if c >= '0' and c <= '9' {
        exp_digits(s, i + 1, n, acc * 10 + (char_to_int(c) - char_to_int('0')))
      } else {
        exp_digits(s, i + 1, n, acc)
      }
      None -> acc
    }
  }

# 16 for a `0x`/`0X` prefix at `i`, 2 for `0b`/`0B`, else 10.
fn span_radix(s: String, i: Int) : Int =
  match char_at(s, i) {
    Some('0') -> match char_at(s, i + 1) {
      Some('x') -> 16
      Some('X') -> 16
      Some('b') -> 2
      Some('B') -> 2
      _ -> 10
    }
    _ -> 10
  }

fn radix_digit(c: Char) : Int =
  if c >= '0' and c <= '9' {
    char_to_int(c) - char_to_int('0')
  } else if c >= 'a' and c <= 'f' {
    char_to_int(c) - char_to_int('a') + 10
  } else {
    char_to_int(c) - char_to_int('A') + 10
  }

# Exact decimal digits of the magnitude of a `0x`/`0b` literal over `[i, n)`, however wide.
fn radix_span_digits(s: String, i: Int, n: Int) : String =
  strip_leading_zeros(radix_digits_loop(s, i + 2, n, span_radix(s, i), "0"))

fn radix_digits_loop(s: String, i: Int, n: Int, base: Int, acc: String) : String =
  if i >= n {
    acc
  } else {
    match char_at(s, i) {
      None -> acc
      Some('_') -> radix_digits_loop(s, i + 1, n, base, acc)
      Some(c) -> radix_digits_loop(s, i + 1, n, base, dec_mul_add(acc, base, radix_digit(c)))
    }
  }

# `s * base + d` over a decimal digit string.
fn dec_mul_add(s: String, base: Int, d: Int) : String =
  dec_mul_add_loop(s, string_length(s), base, d, "")

fn dec_mul_add_loop(s: String, i: Int, base: Int, carry: Int, acc: String) : String =
  if i <= 0 {
    if carry == 0 { acc } else { string_concat(int_to_dec_string(carry), acc) }
  } else {
    let v = digit_at(s, i - 1) * base + carry
    dec_mul_add_loop(s, i - 1, base, v / 10, string_concat(int_to_dec_string(v % 10), acc))
  }

fn digit_at(s: String, i: Int) : Int = match char_at(s, i) {
  Some(c) -> char_to_int(c) - char_to_int('0')
  None -> 0
}

#[doc("The exact decimal digits of an integer literal span of any width, whatever its base; `_` separators and leading zeros dropped.")]
pub(pkg) fn int_span_digits(span: String) : String =
  if span_radix(span, 0) == 10 {
    strip_leading_zeros(collect_digits(span, 0, string_length(span)))
  } else {
    radix_span_digits(span, 0, string_length(span))
  }

fn with_sign(neg: Bool, mag: String) : String =
  if neg and (not mag_is_zero(mag)) { string_concat("-", mag) } else { mag }

fn span_find_dot(s: String, i: Int, n: Int) : Int =
  if i >= n {
    0 - 1
  } else {
    match char_at(s, i) {
      None -> 0 - 1
      Some(c) -> if c == '.' { i } else { span_find_dot(s, i + 1, n) }
    }
  }

# Collect digit characters over `[i, n)`, dropping `_` separators.
fn collect_digits(s: String, i: Int, n: Int) : String =
  collect_digits_loop(s, i, n, "")

fn collect_digits_loop(s: String, i: Int, n: Int, acc: String) : String =
  if i >= n {
    acc
  } else {
    match char_at(s, i) {
      None -> acc
      Some(c) -> if c == '_' {
        collect_digits_loop(s, i + 1, n, acc)
      } else {
        collect_digits_loop(s, i + 1, n, string_concat(acc, "#{c}"))
      }
    }
  }

# Drop leading zeros so a length compare orders by real magnitude;
# an all-zero string collapses to "0".
fn strip_leading_zeros(s: String) : String {
  let n = string_length(s)
  let stripped = strip_zeros_loop(s, 0, n)
  if string_length(stripped) == 0 { "0" } else { stripped }
}

fn strip_zeros_loop(s: String, i: Int, n: Int) : String =
  if i >= n {
    ""
  } else {
    match char_at(s, i) {
      None -> ""
      Some(c) -> if c == '0' {
        strip_zeros_loop(s, i + 1, n)
      } else {
        string_slice(s, i, n - i)
      }
    }
  }

# True when the significant-digit magnitude of `raw_digits` exceeds the
# `Int128` positive maximum.
fn dec_overflows_int128(raw_digits: String) : Bool {
  let mag = strip_leading_zeros(
    collect_digits(
      raw_digits,
      sign_offset(raw_digits),
      string_length(raw_digits)
    )
  )
  mag_str_gt(mag, int128_max_digits())
}

fn sign_offset(s: String) : Int =
  match char_at(s, 0) {
    Some(c) -> if c == '-' { 1 } else { 0 }
    None -> 0
  }

# `a > b` for two significant-digit magnitude strings: longer wins,
# else compare lexicographically.
fn mag_str_gt(a: String, b: String) : Bool {
  let la = string_length(a)
  let lb = string_length(b)
  if la != lb { la > lb } else { mag_lex_gt(a, b, 0, la) }
}

fn mag_lex_gt(a: String, b: String, i: Int, n: Int) : Bool =
  if i >= n {
    false
  } else {
    match char_at(a, i) {
      None -> false
      Some(ca) -> match char_at(b, i) {
        None -> true
        Some(cb) ->
          if char_to_int(ca) > char_to_int(cb) {
            true
          } else if char_to_int(ca) < char_to_int(cb) {
            false
          } else {
            mag_lex_gt(a, b, i + 1, n)
          }
      }
    }
  }

fn int_to_dec_string(n: Int) : String = int_to_string(n)

# ---- diagnostics ----

#[doc("The out-of-Int-range diagnostic for a bare past-i64 integer literal, naming the `n` / `bigint.from_string` escape hatch.")]
pub fn lit_mint_int_range_error(span: String) : String =
  if span_radix(span, 0) != 10 {
    "hex/binary literal exceeds 64 bits; Int is 64-bit — use bigint.from_string"
  } else {
    string_concat(
      "integer literal out of Int range; use a BigInt literal ",
      string_concat(span, "n or bigint.from_string")
    )
  }

fn literal_exponent_error() : String = "literal exponent out of range"

fn int128_range_error() : String =
  "integer literal exceeds Int128 range; annotate `: BigInt` or `: DecimalBig`"

fn decimal_range_error() : String =
  "literal exceeds Decimal range; annotate `: DecimalBig` or drop `d`"

fn unsigned_from_negative_error() : String =
  "a negative literal cannot be coerced to an unsigned type"

fn int_from_point_error() : String =
  "a point literal cannot be coerced to an integer type; drop the fraction or annotate a decimal type"
