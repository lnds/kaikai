# compiler/closure_spec_capture.kai — the guards that keep a pasted
# closure body's names on the binders they were written against.
#
# Below the resolver a local binder is known by its spelling alone, so
# pasting one body into another's scope can rebind a name either way: a
# declaration the closure reads lands under a callee binder, or an
# argument lands under a binder the closure introduces. A function, a
# constructor and an effect are reached by their id whatever is in scope;
# any other declaration is spelled bare and takes the nearest binder.

import compiler.ast
import compiler.expr_positions
import compiler.symtab
import compiler.decl_names
import compiler.interp_span
import compiler.closure_spec_ast

#[doc("True when the closure's body reads a declaration a callee binder could hide: one that is not a function, a constructor or an effect, or whatever an interpolated string names.")]
pub fn closure_reads_hideable(tab: SymTab, ca: ClosureArg) : Bool = reads_hideable(tab, cs_closure_body(ca))

fn reads_hideable(tab: SymTab, e: Expr) : Bool = match e.kind {
  ESym(s, _, _)  -> not sym_is_local(s) and class_hideable(sym_class(tab, s))
  EStr(span, t3) -> interpolates(span, t3)
  _              -> any(xp_positions(e), (p) => match p { XP(_, c) -> reads_hideable(tab, c) })
}

fn class_hideable(c: NCls) : Bool = match c {
  NCFn     -> false
  NCCtor   -> false
  NCEffect -> false
  _        -> true
}

fn interpolates(span: String, is_triple: Bool) : Bool = match isp_parts(span, is_triple) {
  [] -> false
  _  -> true
}

#[doc("True when the body introduces a binder of its own, so an expression pasted into it could be rebound.")]
pub fn body_binds(e: Expr) : Bool =
  binds_here(e.kind) or any(xp_positions(e), (p) => match p { XP(_, c) -> body_binds(c) })

fn binds_here(k: ExprKind) : Bool = match k {
  ELambda(_, _)                   -> true
  EMatch(_, _)                    -> true
  EHandle(_, _, _, _, _, _, _, _) -> true
  ESurface(_)                     -> true
  EBlock(ss, _)                   -> any(ss, stmt_binds)
  _                               -> false
}

fn stmt_binds(s: Stmt) : Bool = match s {
  SLet(_, _, _)       -> true
  SVar(_, _, _, _, _) -> true
  SUse(_, _, _)       -> true
  _                   -> false
}

#[doc("True when the expression reads no name and runs nothing: a literal, the same wherever it is pasted and however often.")]
pub fn arg_is_literal(a: Expr) : Bool = match a.kind {
  EInt(_, _)     -> true
  EReal(_, _)    -> true
  EBool(_)       -> true
  EChar(_)       -> true
  EUnit          -> true
  EStr(span, t3) -> not interpolates(span, t3)
  _              -> false
}
