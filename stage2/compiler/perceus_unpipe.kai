#[doc("""
Apply-pipes rewritten to the calls they denote, ahead of Perceus.

The typer keeps `lhs |> f(args)` as a pipe node, but every Perceus
decision indexed by argument slot (borrowed, consumed, raw) reads a
call's argument list. Left as a pipe, the call's own args sit one slot
off from the callee's parameters. Rewriting the pipe to `f(lhs, args)`
before any analysis keeps the slots aligned, and the post-Perceus passes
see the same calls Perceus balanced.
""")]

import compiler.ast
import compiler.ast_map

#[doc("Rewrites every apply-pipe into a named callee to the equivalent call, in each body Perceus rewrites.")]
pub fn pcs_unpipe_decls(decls: [Decl]) : [Decl] = map(decls, pcs_unpipe_decl)

fn pcs_unpipe_decl(d: Decl) : Decl = match d {
  DFn(is_pub, name, tparams, params, opt_ret, row, body, ln, cl, mo, fsym) ->
    DFn(is_pub, name, tparams, params, opt_ret, row, pcs_unpipe(body), ln, cl, mo, fsym)
  DTest(desc, body, ln, cl, mo)      -> DTest(desc, pcs_unpipe(body), ln, cl, mo)
  DBench(desc, body, ln, cl, mo)     -> DBench(desc, pcs_unpipe(body), ln, cl, mo)
  DCheck(desc, ps, body, ln, cl, mo) -> DCheck(desc, ps, pcs_unpipe(body), ln, cl, mo)
  _ -> d
}

fn pcs_unpipe(e: Expr) : Expr =
  Expr { kind: pcs_unpipe_kind(prc_map_expr_kind(e.kind, pcs_unpipe)),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode }

# The callee shapes the lowering treats as a call; any other rhs is a
# value applied indirectly and stays a pipe.
fn pcs_unpipe_kind(k: ExprKind) : ExprKind = match k {
  EPipe(lhs, rhs) -> match rhs.kind {
    ECall(f, args_) -> ECall(f, [lhs, ...args_])
    EVar(_)         -> ECall(rhs, [lhs])
    ESym(_, _, _)   -> ECall(rhs, [lhs])
    EModCall(_, _)  -> ECall(rhs, [lhs])
    _               -> k
  }
  _ -> k
}
