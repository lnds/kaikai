#[doc("""
C text for the unwind-stack brackets (`unwind_pend.kai`): a call that
can exit non-locally registers the frame's pending references for its
extent, a `match` its scrutinee slot, a `handle` the references that
outlive it plus its state slot.

A bracket is one push and one pop on the fiber's unwind stack. A frame
never changes fiber, so its C function looks the fiber up once, on its
first push, and the pop reuses it.
""")]

import compiler.util

#[doc("`call` bracketed by a push of the C locals `vars`; unchanged when there are none.")]
pub fn euw_call(call: String, vars: [String]) : String = match vars {
  [] -> call
  _  -> concat_all([euw_push_open("_uwf", vars), "__auto_type _uwr = ", call, "; kai_unw_pop(_uwf); _uwr; })"])
}

#[doc("`call` (a borrowing closure call) bracketed with the closure `clo` registered too, released after it returns.")]
pub fn euw_call_drop(call: String, vars: [String], clo: String) : String =
  concat_all([euw_push_open("_uwf", [clo, ...vars]), "__auto_type _uwr = ", call,
              "; kai_unw_pop(_uwf); kai_decref(", clo, "); _uwr; })"])

fn euw_push_open(f: String, vars: [String]) : String =
  concat_all(["({ KaiFiber *", f, " = kai_unw_push_c(&_uwfb, (KaiValue *[]){", join_with(vars, ", "), "}, ",
              int_to_string(list_length(vars)), "); "])

#[doc("`s` followed by the fiber cache a C function's brackets share; `s` when the frame has no bracket.")]
pub fn euw_with_fiber(bracketed: Bool, s: String) : String =
  if bracketed { cat2(s, "KaiFiber *_uwfb = NULL; (void) _uwfb;\n    ") } else { s }

#[doc("The statement registering slot `lv` (an lvalue) under the fiber local `f`.")]
pub fn euw_slot_push(f: String, lv: String) : String =
  concat_all(["KaiFiber *", f, " = kai_unw_push_c(&_uwfb, &", lv, ", 1); "])

#[doc("The statement registering the C locals `vars` under the fiber local `f`; empty when there are none.")]
pub fn euw_vars_push(f: String, vars: [String]) : String = match vars {
  [] -> ""
  _  -> concat_all(["KaiFiber *", f, " = kai_unw_push_c(&_uwfb, (KaiValue *[]){", join_with(vars, ", "), "}, ",
                    int_to_string(list_length(vars)), "); "])
}

#[doc("The statement popping the entry pushed under `f`.")]
pub fn euw_pop(f: String) : String = concat_all(["kai_unw_pop(", f, "); "])
