# compiler/region.kai — opt-in Perceus regions: surface recognition, plus
# the signature-brand predicate both backends route ctors off.
#
# The parser lowers `region { ... }` to the marker
# `ECall(EMark(MkRegion), [block])` where `block` is an `EBlock`. `region`
# is not a fn, not an effect, and not a lexer keyword: the marker exists
# only between parse and this pass, which rewrites it to `ERegionBlk(block)`.
# The node is the region's identity, so the lowering finds a region by what
# the tree says, never by a position: the block inside lowers to arena
# allocation with deep-copy-out; every other block is an ordinary RC block.
#
# Escape semantics are deep-copy-out, not rejection. A value allocated in
# the region's arena that crosses the block boundary is copied out with
# rc = 1 by the emitters, so this pass emits no diagnostics.
#
# Pre-typer, a sibling of the nursery rewrite, lexical only.

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.ast_map
import compiler.core_types
import compiler.fnreg

# ---- rewrite -------------------------------------------------------

#[doc("The declarations with every `region { }` marker rewritten to an `ERegionBlk` node.")]
pub fn rewrite_regions_decls(decls: [Decl]) : [Decl] = map(decls, rw_decl)

fn rw_decl(d: Decl) : Decl = match d {
  DFn(p_, f, tps, ps, ret, row, body, l, c, nl, nc, mo) ->
    DFn(p_, f, tps, ps, ret, row, rw_expr(body), l, c, nl, nc, mo)
  DTest(desc, body, l, c, mo) -> DTest(desc, rw_expr(body), l, c, mo)
  DBench(desc, body, l, c, mo) -> DBench(desc, rw_expr(body), l, c, mo)
  DCheck(desc, ps, body, l, c, mo) -> DCheck(desc, ps, rw_expr(body), l, c, mo)
  DImpl(pname, proto_args, target, ms, l, c, tps, isym) ->
    DImpl(pname, proto_args, target, map(ms, rw_decl), l, c, tps, isym)
  DDerive(names, inner, l, c) -> DDerive(names, rw_decl(inner), l, c)
  DUnstable(inner, l, c) -> DUnstable(rw_decl(inner), l, c)
  DProtoLaws(thy, inner, l, c, mo) -> DProtoLaws(thy, rw_decl(inner), l, c, mo)
  DImplAxiom(thy, inner, l, c, mo) -> DImplAxiom(thy, rw_decl(inner), l, c, mo)
  DConstructor(inner, l, c) -> DConstructor(rw_decl(inner), l, c)
  _ -> d
}

fn rw_expr(e: Expr) : Expr = match region_marker_of(e) {
  Some(rm) -> Expr {
    kind: ERegionBlk(rw_expr(rm.block)),
    line: e.line,
    col: e.col,
    ty: e.ty,
    mode: e.mode,
    site: e.site
  }
  None -> Expr {
    kind: prc_map_expr_kind(e.kind, rw_expr),
    line: e.line,
    col: e.col,
    ty: e.ty,
    mode: e.mode,
    site: e.site
  }
}

# The recognised region marker: the block body plus the region's binder
# name (empty for the bare form).
type RegionMarker = { block: Expr, name: Written }

# Two shapes:
#   bare   `ECall(EMark(MkRegion), [block])`              — name = ""
#   named  `ECall(EMark(MkRegion), [ELambda([r], block)])` — name = "r"
fn region_marker_of(e: Expr) : Option[RegionMarker] = match e.kind {
  ECall(callee, call_args) -> match callee.kind {
    EMark(MkRegion) -> region_marker_arg(call_args)
    _ -> None
  }
  _ -> None
}

fn region_marker_arg(call_args: [Expr]) : Option[RegionMarker] = match call_args {
  [arg] -> match arg.kind {
    ELambda(ps, body) -> match ps {
      [p0] -> Some(RegionMarker { block: body, name: p0.binder.name })
      _ -> None
    }
    _ -> Some(RegionMarker { block: arg, name: written("") })
  }
  _ -> None
}

# --- Region-brand detection (shared by both backends) ------------------
#
# A fn whose signature carries a region-branded aggregate allocates its
# ctors in the ambient arena: `tree_insert(t: Tree<r>) : Tree<r>` bump-
# allocates its `Node(...)` in whatever arena is live at the call, even
# though the ctor sits outside the `region { }` lexically. Routing keys on
# the SIGNATURE types — a surface `Tree<r>` survives monomorphisation
# (mono rewrites the mangle, not the written type), whereas the tparam
# list is emptied by mono and the per-ctor brand does not survive the unit
# normaliser. The C backend reads the same predicate inline (`in_region`);
# the native backend consults it to flag each `KCon`.

#[doc("True when a fn's signature (a param or its return) carries a region-branded aggregate.")]
pub fn fn_has_region_brand(params: [Param], ret_opt: Option[TypeExpr]) : Bool =
  if any_param_region(params) {
    true
  } else {
    match ret_opt {
      Some(te) -> te_is_region_branded(te)
      None -> false
    }
  }

fn any_param_region(params: [Param]) : Bool = match params {
  [] -> false
  [p, ...rest] -> match p.ptype {
    Some(te) -> if te_is_region_branded(te) { true } else { any_param_region(rest) }
    None -> any_param_region(rest)
  }
}

#[doc("True when a surface type is a region brand (`TyDim` over a base `ty_region_brandable` accepts).")]
pub fn te_is_region_branded(te: TypeExpr) : Bool = match te.tkind {
  TyDim(base, _) -> match base.tkind {
    TyName(_, _) -> ty_region_brandable(resolve_ty(base))
    _ -> true
  }
  _ -> false
}

#[doc("True when a `<..>` brand on the resolved type `base` names a region: `base` is a list or a nominal head other than a numeric carrier (`Tree<r>`, not `Real<m>` or `Decimal<USD>`).")]
pub fn ty_region_brandable(base: Ty) : Bool = match base {
  TyCon(s, _) -> match core_decl_ty_of(s) {
    Some(t) -> not core_decl_ty_is_numeric(t)
    None -> true
  }
  TyListT(_) -> true
  _ -> false
}
