#[doc("""
How the ownership passes recognise a fn's calls of itself.

A declared fn is recognised by its `FnId`: a call that spells the same
name but resolves to another declaration, a core `filter` called from a
user `filter`, is not a self-call. A specialisation's own calls carry its
instance. A fn the compiler synthesises has no declaration identity and
is only ever called by its reserved name.
""")]

import compiler.ast

#[doc("The fn whose own calls a pass looks for: its identity and its name.")]
pub type SelfRef = SelfRef(FnId, String)

#[doc("True when `callee` calls the fn `me` names.")]
pub fn is_self_callee(callee: Expr, me: SelfRef) : Bool = match me {
  SelfRef(id, name) ->
    if sym_raw(fnid_sym(id)) < 0 { spells_self(callee.kind, name) }
    else { match callee.kind { ESym(s, inst, _) -> fnid_eq(FnId(s, inst), id)  _ -> false } }
}

fn spells_self(k: ExprKind, name: String) : Bool = match k {
  ESym(_, _, c)  -> c == name
  EVar(c)        -> c == name
  EModCall(_, c) -> c == name
  _              -> false
}

#[doc("The name of the fn `me` names.")]
pub fn self_ref_name(me: SelfRef) : String = match me { SelfRef(_, name) -> name }
