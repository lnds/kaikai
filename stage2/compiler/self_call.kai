#[doc("""
How the compiler's passes recognise a fn's calls of itself.

A fn is recognised by its `FnId`: a call that spells the same name but
resolves to another declaration, a core `filter` called from a user
`filter`, is not a self-call. A specialisation's own calls carry its
instance.
""")]

import compiler.ast

#[doc("The fn whose own calls a pass looks for: its identity and its name.")]
pub type SelfRef = SelfRef(FnId, String)

#[doc("True when `callee` calls the fn `me` names.")]
pub fn is_self_callee(callee: Expr, me: SelfRef) : Bool = match me {
  SelfRef(id, _) -> sym_raw(fnid_sym(id)) >= 0 and match callee.kind {
    ESym(s, inst, _) -> fnid_eq(FnId(s, inst), id)
    _                -> false
  }
}

#[doc("The name of the fn `me` names.")]
pub fn self_ref_name(me: SelfRef) : String = match me { SelfRef(_, name) -> name }
