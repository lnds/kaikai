pub(pkg) fn is_dump_mode(mode: Mode) : Bool = match mode {
  MAst -> true
  MTypes -> true
  MEnv -> true
  MInfer -> true
  MDumpTyped -> true
  MDumpTypedCore -> true
  MDumpMono -> true
  MDumpMonoOut -> true
  MDumpRawSafe -> true
  MDumpBorrowSafe -> true
  MDumpLastUse -> true
  MDumpIntervals -> true
  MDumpCallElision -> true
  MCheckCoreFront -> true
  MDumpBrands -> true
  MDumpEvidenceObligations -> true
  MDumpEvidenceArity -> true
  MDocJson -> true
  MLibraryMode -> true
  MLint -> true
  MLintJson -> true
  MMigrate -> true
  _ -> false
}

#[doc("The stage after which a dump mode reads the pipeline.")]
pub(pkg) type DumpCut = | CutReady | CutStamp | CutInfer

pub(pkg) fn dump_cut(mode: Mode) : DumpCut = match mode {
  MAst -> CutReady
  MTypes -> CutReady
  MEnv -> CutReady
  MDocJson -> CutReady
  MCheckCoreFront -> CutReady
  MDumpBrands -> CutStamp
  MDumpEvidenceObligations -> CutStamp
  MDumpEvidenceArity -> CutStamp
  MLibraryMode -> CutStamp
  MLint -> CutStamp
  MLintJson -> CutStamp
  MMigrate -> CutStamp
  _ -> CutInfer
}

fn mode_check_core_front(req: Req, cx: Ready) : Int / Console + File + Mutable {
  let all_decls = cx.lowered.all_decls
  let callee_ops = cx.lowered.callee_ops
  let core_cache = req.core_cache
  let core_decls_whole = cx.cutrun.core_decls_whole
  let diag_ctx = cx.tablesrun.diag_ctx
  let front = cx.ready.front
  let front_cx_of = cx.ready.front_cx_of
  let held_impls = cx.lowered.held_impls
  let emptied_impls = cx.lowered.emptied_impls
  let surface_decls_whole = cx.cutrun.surface_decls_whole
  let sym_tab = cx.lowered.sym_tab
  let sym_views = cx.tablesrun.sym_views
  let target_mod_name = root_module_name(req.path)
  let cx = front_cx_of()
  let res = resolve_program_views(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops)
  let lines = core_front_check(cx, core_decls_whole, filter(surface_decls_whole, (d) => cf_module(d) != ""), held_impls, emptied_impls, all_decls, res)
  let fused_rows = pub_loop_workers(tailfuse_decls(all_decls, sym_tab, target_mod_name), sym_tab, target_mod_name).rows
  eprint("core-front: fused or split #{int_to_string(list_length(fused_rows))}:")
  each(lines, (l) => print(l))
  let bad = list_length(filter(lines, (l) => string_index_of_char(l, '!') >= 0))
  eprint("core-front: #{int_to_string(list_length(filter(core_decls_whole, (d) => cf_module(d) != "")))} core functions, #{int_to_string(list_length(filter(surface_decls_whole, (d) => cf_module(d) != "")))} library functions, #{int_to_string(bad)} differ")
  match core_cache.early_cut { EcOff -> bad  EcOn -> 0 }
}

fn mode_doc_json(req: Req, cx: Ready) : Int / Console + File + Mutable {
  let docs = cx.loaded.docs
  let own_tab = cx.opened.own_tab
  let path = req.path
  # Docs are syntactic — dump the side table collected at
  # parse time, no typecheck needed.
  print(doc_module_json(path, docs.module_doc, docs.items, own_tab))
  0
}

fn typer_in_stamped(cx: StampRun) : TyperIn =
  typer_in(cx.ready.front, cx.stamprun.stamped.view, cx.stamprun.all_decls, cx.lowered.sym_tab)

fn mode_dump_evidence_obligations(req: Req, cx: StampRun) : Int / Console + File + Mutable =
  dump_evidence_obligations(req.path, cx.stamprun.all_decls, typer_in_stamped(cx), entry_id(root_module_name(req.path), runs_blocks(req.mode)), root_module_name(req.path))

fn mode_dump_evidence_arity(req: Req, cx: StampRun) : Int / Console + File + Mutable =
  dump_evidence_arity(req.path, cx.stamprun.all_decls, typer_in_stamped(cx), entry_id(root_module_name(req.path), runs_blocks(req.mode)))

fn mode_library_mode(req: Req, cx: StampRun) : Int / Console + File + Mutable =
  if cx.stamprun.chk != 0 { cx.stamprun.chk } else { dump_library_mode(req.path, req.src, cx.stamprun.all_decls, cx.cutrun.surface_decls, typer_in_stamped(cx)) }

fn mode_lint(req: Req, cx: StampRun) : Int / Console + File + Mutable =
  if cx.stamprun.chk != 0 { cx.stamprun.chk }
  else { run_lint(req.path, lint_owned_mods(cx.loaded.expanded, req.test_own), cx.stamprun.all_decls, cx.lowered.post_use_decls, cx.cutrun.surface_decls, typer_in_stamped(cx)) }

fn mode_lint_json(req: Req, cx: StampRun) : Int / Console + File + Mutable =
  if cx.stamprun.chk != 0 { cx.stamprun.chk }
  else { run_lint_json(req.path, lint_owned_mods(cx.loaded.expanded, req.test_own), cx.stamprun.all_decls, cx.lowered.post_use_decls, cx.cutrun.surface_decls, typer_in_stamped(cx)) }

#[doc("`kai migrate`: the rule set applied to the file as written, with each file-operation call decided by what the resolver bound it to; the migrated source goes to stdout and the `manual:` report to stderr.")]
fn mode_migrate(req: Req, cx: StampRun) : Int / Console + File + Mutable = {
  let cmts = collect_comments(req.src, cx.opened.tokens)
  let sites = migrate_core_sites(cx.stamprun.rd.diags, req.path)
  let consts = migrate_const_sites(cx.stamprun.all_decls, cx.lowered.sym_tab, root_module_name(req.path))
  let imports = migrate_import_sites(cx.opened.own_decls, cx.lowered.sym_tab, root_scope_table(cx.loaded.expanded))
  let headers = migrate_impl_header_spans(cx.opened.own_decls, req.src)
  let found = list_append(list_append(list_append(const_spans(req.src, consts), import_spans(req.src, imports)), headers),
                          migrate_tparam_spans(cx.stamprun.all_decls, cx.lowered.sym_tab, root_module_name(req.path), req.src))
  match respell(req.src, found) {
    Err(why) -> { eprint("migrate: internal error — #{why}; aborting (no file written)"); 1 }
    Ok(lowered) ->
      if lowered == req.src { run_migrate(req.path, req.src, cx.opened.own_decls, cx.opened.own_tab, cmts, req.edition, sites, false) }
      else { run_migrate_respelled(req.path, lowered, req.edition, sites) }
  }
}

#[doc("Runs the dump of a mode that reads the program after the front end.")]
pub(pkg) fn run_dump_ready(req: Req, cx: Ready) : Int / Console + File + Mutable = match req.mode {
  MAst -> { dump_program(cx.cutrun.surface_decls, cx.loaded.tab0); 0 }
  MTypes -> { dump_types(cx.loaded.doc_decls, cx.opened.own_tab); 0 }
  MEnv -> { dump_env(build_ty_env(cx.lowered.all_decls, cx.lowered.sym_tab).env); 0 }
  MDocJson -> mode_doc_json(req, cx)
  MCheckCoreFront -> mode_check_core_front(req, cx)
  _ -> 0
}

#[doc("Runs the dump of a mode that reads the program once its names are resolved and stamped.")]
pub(pkg) fn run_dump_stamp(req: Req, cx: StampRun) : Int / Console + File + Mutable = match req.mode {
  MDumpBrands -> { dump_brands(cx.stamprun.nursery_brands, cx.stamprun.nursery_calls); 0 }
  MDumpEvidenceObligations -> mode_dump_evidence_obligations(req, cx)
  MDumpEvidenceArity -> mode_dump_evidence_arity(req, cx)
  MLibraryMode -> mode_library_mode(req, cx)
  MLint -> mode_lint(req, cx)
  MLintJson -> mode_lint_json(req, cx)
  MMigrate -> mode_migrate(req, cx)
  _ -> 0
}

#[doc("Runs the dump of a mode that reads the typed program.")]
pub(pkg) fn run_dump_infer(req: Req, cx: InferRun) : Int / Console + File + Mutable = {
  let tp = cx.inferrun.typed_prog0
  let tab = cx.inferrun.typed_tab
  match req.mode {
    MDumpCallElision -> if tp.errs != 0 { tp.errs } else { dump_call_elision(req.path, tp.decls, tab) }
    _ -> {
      each(tp.diags, render_diag)
      match req.mode {
        MInfer -> dump_infer(req.path, tp, tab)
        MDumpTyped -> dump_typed(req.path, tp, tab)
        MDumpTypedCore -> dump_typed_core(req.path, tp, tab)
        MDumpMono -> dump_mono(req.path, tp, tab)
        MDumpMonoOut -> dump_mono_out(req.path, tp, tab)
        MDumpRawSafe -> dump_rawsafe(req.path, tp, tab)
        MDumpBorrowSafe -> dump_borrowsafe(req.path, tp, tab)
        MDumpLastUse -> dump_last_use(req.path, tp, tab)
        MDumpIntervals -> dump_intervals(req.path, tp, tab)
        _ -> 0
      }
    }
  }
}

fn root_scope_table(ep: ExpandedProgram) : [ModuleEntry] = match ep {
  EP_Mod(_, mods, _, _, _, scopes, _, _, _, _) -> ms_scope_table(scopes, "", mods)
}
