#[doc("""
`protocol`, `theory` and `impl` declarations.
""")]

import compiler.util
import compiler.diag
import compiler.lex_tokens
import compiler.ast
import compiler.decl_names
import compiler.parse_state
import compiler.parse_types
import compiler.parse_fns

# A law set is verified by generated property checks, not by a unifier: a
# law set and a theory are separate namespaces.
fn is_protocol_law(name: String) : Bool = name == "Functorial"

fn unknown_protocol_law_msg(name: String) : String =
  concat_all(["unknown protocol law `", name, "` — the law sets are: Functorial"])

fn is_upper_name(p: Parser, t: Token) : Bool = tk_is(t.kind, TkIdent) and is_upper_ident(p.src, t)

fn opt_type_params(p: Parser) : PTParams / Console =
  if p_at(p, TkLbracket) { parse_type_params_loop(p_advance_nl(p), []) }
  else { PTParams { p: p, r: Some([]) } }

fn theory_prop_menu() : [String] =
  ["assoc", "commut", "idempotent", "inverse", "identity", "measure", "rows"]

fn unknown_theory_prop_msg(prop: String) : String {
  let base = concat_all(["unknown theory property `", prop,
                         "` — the closed menu is assoc, commut, idempotent, inverse, identity, measure, rows"])
  match closest_name(prop, theory_prop_menu()) {
    Some(sug) -> concat_all([base, " (did you mean `", sug, "`?)"])
    None      -> base
  }
}

#[doc("Parses `theory Name = { prop, ... }` or `theory Name = builtin`; `t` anchors the declaration.")]
pub fn parse_theory_decl(p: Parser, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) { err_d(p_error(p, id, "expected theory name after `theory`")) }
  else if not is_upper_ident(p.src, id) { err_d(p_error(p, id, "theory name must start with an uppercase letter")) }
  else {
    let p1 = p_eat(p_advance(p), TkEq, "expected `=` after theory name — a theory is `theory Name = { prop, ... }` or `theory Name = builtin`")
    if p_failed(p1) { err_d(p1) } else { parse_theory_body(p1, tok_source(p.src, id), t) }
  }
}

# `builtin` is contextual: only directly after a theory's `=`.
fn parse_theory_body(p: Parser, name: String, t: Token) : PDecl / Console {
  let b = p_peek(p)
  if tk_is(b.kind, TkIdent) and tok_source(p.src, b) == "builtin" {
    ok_d(p_advance(p), DTheory(name, [theory_builtin_marker()], t.line, t.col, None))
  } else if not p_at(p, TkLbrace) {
    err_d(p_error_here(p, "expected `{` or `builtin` after `=` in a `theory` declaration"))
  } else {
    theory_props(p_advance(p), [], name, t)
  }
}

fn theory_props(p: Parser, acc: [String], name: String, t: Token) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  let id = p_peek(p0)
  let prop = tok_source(p0.src, id)
  if p_at(p0, TkRbrace) { ok_d(p_advance(p0), DTheory(name, list_reverse(acc), t.line, t.col, None)) }
  else if not tk_is(id.kind, TkIdent) { err_d(p_error(p0, id, "expected a property name inside `theory { ... }`")) }
  else if not list_has(theory_prop_menu(), prop) { err_d(p_error(p0, id, unknown_theory_prop_msg(prop))) }
  else { theory_prop_end(p_advance_nl(p0), [prop, ...acc], name, t) }
}

fn theory_prop_end(p: Parser, acc: [String], name: String, t: Token) : PDecl / Console {
  if p_at(p, TkComma) { theory_props(p_advance(p), acc, name, t) }
  else if p_at(p, TkRbrace) { ok_d(p_advance(p), DTheory(name, list_reverse(acc), t.line, t.col, None)) }
  else { err_d(p_error_here(p, "expected `,` or `}` in a `theory` property list")) }
}

type ProtoHead = { at: Parser, name: String, is_pub: Bool, tparams: [TBinder], law: String, t: Token }

#[doc("Parses `protocol P[T] : Law { op(params) : Ret ... }`; the first parameter may be typed `Self`.")]
pub fn parse_protocol_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not is_upper_name(p, id) { err_d(p_error(p, id, "expected an uppercase protocol name")) }
  else {
    let tps = opt_type_params(p_advance(p))
    match tps.r {
      None -> err_d(tps.p)
      Some(tparams) -> protocol_law(tps.p, ProtoHead { at: p, name: tok_source(p.src, id), is_pub: is_pub, tparams: tparams, law: "", t: t })
    }
  }
}

# `: Law` after the type parameters; an unknown law is rejected (the catalog is closed).
fn protocol_law(p: Parser, h: ProtoHead) : PDecl / Console {
  let pn = p_skip_newlines(p)
  let p1 = p_advance_nl(pn)
  let th = p_peek(p1)
  let law = tok_source(p1.src, th)
  if not p_at(pn, TkColon) { protocol_body(pn, h) }
  else if not is_upper_name(p1, th) { err_d(p_error_here(p1, "expected a protocol law after `:`")) }
  else if not is_protocol_law(law) { err_d(p_error(p1, th, unknown_protocol_law_msg(law))) }
  else { protocol_body(p_skip_newlines(p_advance(p1)), ProtoHead { ...h, law: law }) }
}

fn protocol_body(p: Parser, h: ProtoHead) : PDecl / Console {
  let pb = p_eat(p, TkLbrace, "expected `{` to start protocol body")
  if p_failed(pb) { err_d(pb) } else { protocol_ops(p_advance_nl(p), [], h) }
}

fn protocol_ops(p: Parser, acc: [ProtoOp], h: ProtoHead) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  let id = p_peek(p0)
  if p_at(p0, TkRbrace) { protocol_done(p_advance(p0), list_reverse(acc), h) }
  else if not tk_is(id.kind, TkIdent) { err_d(p_error(p0, id, "expected operation name")) }
  else {
    let tps = opt_type_params(p_advance(p0))
    match tps.r {
      None -> err_d(tps.p)
      Some(op_tparams) -> protocol_op_params(tps.p, id, op_tparams, acc, h)
    }
  }
}

fn protocol_done(p: Parser, ops: [ProtoOp], h: ProtoHead) : PDecl {
  let proto = DProtocol(h.is_pub, p_sym(h.at, NCProtocol, h.name), h.tparams, ops, h.t.line, h.t.col, None)
  let rows = [p_ent(h.at, NCProtocol, h.name, h.is_pub)]
  if h.law == "" { ok_dn(p, proto, rows) }
  else { ok_dn(p, DProtoLaws(h.law, proto, h.t.line, h.t.col, None), rows) }
}

fn protocol_op_params(p: Parser, id: Token, op_tparams: [TBinder], acc: [ProtoOp], h: ProtoHead) : PDecl / Console {
  let pa = p_eat(p, TkLparen, "expected `(` after operation name")
  if p_failed(pa) { err_d(pa) }
  else {
    let params = parse_fn_params(p_skip_newlines(pa), [])
    match params.r {
      None -> err_d(params.p)
      Some(ps) -> protocol_op_ret(p_skip_newlines(params.p), id, op_tparams, ps, acc, h)
    }
  }
}

fn protocol_op_ret(p: Parser, id: Token, op_tparams: [TBinder], params: [Param], acc: [ProtoOp], h: ProtoHead) : PDecl / Console {
  let pc = p_eat(p, TkColon, "expected `:` before operation return type")
  if p_failed(pc) { err_d(pc) }
  else {
    let rt = parse_type(pc)
    match rt.r {
      None -> err_d(rt.p)
      Some(ty) -> protocol_ops(rt.p, [POp(tok_source(p.src, id), op_tparams, params, ty, id.line, id.col), ...acc], h)
    }
  }
}

#[doc("Parses `impl[u: Measure] P[A] for T { fn op(args) = body ... }`; an impl tparam list is prepended to each method's own.")]
pub fn parse_impl_decl(p: Parser, t: Token) : PDecl / Console {
  let tps =
    if p_at(p, TkLbracket) { parse_impl_type_params_loop(p_advance_nl(p), []) }
    else { PTParams { p: p, r: Some([]) } }
  match tps.r {
    None -> err_d(tps.p)
    Some(tparams) -> impl_head(p_skip_newlines(tps.p), p, t, tparams)
  }
}

type ImplHead = { at: Parser, t: Token, tparams: [TBinder], pname: DeclRef, args: [TypeExpr], target: TypeExpr }

fn impl_head(p: Parser, at: Parser, t: Token, tparams: [TBinder]) : PDecl / Console {
  let id = p_peek(p)
  if not at_type_head(p, id) { err_d(p_error(p, id, "expected an uppercase protocol name after `impl`")) }
  else {
    let pq = parse_qualified_head_name(p, id)
    let args =
      if p_at(pq.p, TkLbracket) { parse_type_list(p_advance(pq.p), TkRbracket, "expected `,` or `]` in impl protocol arguments", []) }
      else { PTypes { p: pq.p, r: Some([]) } }
    match args.r {
      None -> err_d(args.p)
      Some(proto_args) -> impl_for(p_skip_newlines(args.p), at, t, tparams, pq.dref, proto_args)
    }
  }
}

fn impl_for(p: Parser, at: Parser, t: Token, tparams: [TBinder], pname: DeclRef, args: [TypeExpr]) : PDecl / Console {
  let pf = p_eat(p, TkFor, "expected `for` after protocol name in `impl`")
  if p_failed(pf) { err_d(pf) }
  else {
    let target = parse_type(p_skip_newlines(pf))
    match target.r {
      None -> err_d(target.p)
      Some(ty) -> impl_body(p_skip_newlines(target.p), ImplHead { at: at, t: t, tparams: tparams, pname: pname, args: args, target: ty })
    }
  }
}

fn impl_body(p: Parser, h: ImplHead) : PDecl / Console {
  let pb = p_eat(p, TkLbrace, "expected `{` to start impl body")
  if p_failed(pb) { err_d(pb) } else { impl_methods(p_skip_newlines(pb), impl_scope(h.at.home, h.t.line, h.t.col), [], [], h) }
}

# `scope` is the impl block's: a method is declared in it, not in the module's function
# namespace, so two impls' `show` are two symbols.
fn impl_methods(p: Parser, scope: String, acc: [Decl], racc: [NEnt], h: ImplHead) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) {
    let impl_d = DImpl(h.pname, h.args, h.target, list_reverse(acc), h.t.line, h.t.col, h.tparams, sym_none())
    trailing_axiom(p_advance(p0), impl_d, list_reverse(racc), h.t)
  } else if not p_at(p0, TkFn) {
    err_d(p_error_here(p0, "expected `fn` to start an impl method"))
  } else {
    let dr = parse_fn_decl(p_advance(p0), false, p_peek(p0))
    match dr.r {
      None -> err_d(dr.p)
      Some(d) -> impl_method_next(dr, d, scope, acc, racc, h)
    }
  }
}

fn impl_method_next(dr: PDecl, d: Decl, scope: String, acc: [Decl], racc: [NEnt], h: ImplHead) : PDecl / Console =
  match dr.names {
    [NEnt(_, op, _, _, _)] -> impl_methods(dr.p, scope, [impl_method(d, op, scope), ...acc], [method_ent(op, scope), ...racc], h)
    _ -> panic("parse: an impl method without its entry")
  }

# The function `d`, read as a module's, re-identified as the method `op` of the impl block `scope`.
fn impl_method(d: Decl, op: String, scope: String) : Decl = match d {
  DFn(is_pub, _, tps, ps, ret, row, body, l, c, mo) ->
    DFn(is_pub, fnid_decl(method_sym(op, scope)), tps, ps, ret, row, body, l, c, mo)
  _ -> d
}

# `axiom` also starts a top-level declaration, so a trailing `axiom <Law>` is claimed only
# when a known law name follows; otherwise `axiom` stays for the declaration parser.
fn trailing_axiom(p: Parser, impl_d: Decl, rows: [NEnt], t: Token) : PDecl / Console {
  let pn = p_skip_newlines(p)
  let p1 = p_advance_nl(pn)
  let th = p_peek(p1)
  if p_at(pn, TkAxiom) and is_upper_name(p1, th) and is_protocol_law(tok_source(p1.src, th)) {
    ok_dn(p_advance(p1), DImplAxiom(tok_source(p1.src, th), impl_d, t.line, t.col, None), rows)
  } else {
    ok_dn(p, impl_d, rows)
  }
}
