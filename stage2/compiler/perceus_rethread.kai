#[doc("""
Arm binders of a borrowed parameter that are only ever borrowed.

A match on a borrowed parameter binds children the caller's root keeps
alive for the whole call. When every read of such a binder is an argument
in a borrowed, reference-counted slot, nothing downstream needs its
bind-time reference: the arm releases it on entry and every read borrows.
That includes a self-tail-call re-threading the parameter, whose goto has
no after-call point where a moved reference could be paid.

Only binders a variant or list pattern projects qualify — the binds both
backends take a reference for.
""")]

import compiler.ast
import compiler.util
import compiler.sym_read
import compiler.expr_positions
import compiler.fnreg
import compiler.infer.{list_has_int}

#[doc("The arm binders of `body`'s matches on a `borrowed` parameter whose every read is an argument in a borrowed slot; `slots` gives a callee's borrowed positions.")]
pub fn prt_borrow_only_binders(body: Expr, borrowed: [String], slots: (Expr) -> [Int]) : [String] =
  prt_walk(body, borrowed, slots, [])

fn prt_walk(e: Expr, borrowed: [String], slots: (Expr) -> [Int], acc: [String]) : [String] = {
  let here = match e.kind {
    EMatch(s, arms) -> if prt_scr_is_param(s, borrowed) { prt_arms(arms, slots, acc) } else { acc }
    _               -> acc
  }
  prt_walk_ps(xp_positions(e), borrowed, slots, here)
}

fn prt_walk_ps(ps: [XPos], borrowed: [String], slots: (Expr) -> [Int], acc: [String]) : [String] = match ps {
  []                  -> acc
  [XP(_, c), ...rest] -> prt_walk_ps(rest, borrowed, slots, prt_walk(c, borrowed, slots, acc))
}

#[doc("True when `s` is the bare read of a `borrowed` parameter.")]
pub fn prt_scr_is_param(s: Expr, borrowed: [String]) : Bool = match s.kind {
  EVar(nm) -> list_has(borrowed, nm)
  _        -> false
}

fn prt_arms(arms: [Arm], slots: (Expr) -> [Int], acc: [String]) : [String] = match arms {
  []           -> acc
  [a, ...rest] -> match a {
    Arm(pat, opt_g, body) -> prt_arms(rest, slots, list_append(acc, prt_arm_borrow_only(pat, opt_g, body, slots)))
  }
}

#[doc("The binders one arm of a match on a borrowed parameter only ever borrows. Reads may carry a Perceus dup.")]
pub fn prt_arm_borrow_only(pat: Pattern, opt_g: Option[Expr], body: Expr, slots: (Expr) -> [Int]) : [String] =
  filter(prt_projected(pat, []), (nm) => prt_qualifies(nm, opt_g, body, slots))

fn prt_qualifies(nm: String, opt_g: Option[Expr], body: Expr, slots: (Expr) -> [Int]) : Bool = {
  let in_guard = match opt_g { Some(g) -> prt_mentions(nm, g) > 0  None -> false }
  let borrows = prt_borrows(nm, body, slots)
  not in_guard and borrows > 0 and borrows == prt_mentions(nm, body)
}

# Binders a variant or list pattern projects, through nested variant and
# list sub-patterns only.
fn prt_projected(p: Pattern, acc: [String]) : [String] = match p.pkind {
  PVariant(_, _, subs) -> prt_subs(subs, acc)
  PList(subs, _)       -> prt_subs(subs, acc)
  _                    -> acc
}

fn prt_subs(subs: [Pattern], acc: [String]) : [String] = match subs {
  []           -> acc
  [p, ...rest] -> prt_subs(rest, match p.pkind {
    PBind(nm) -> [nm, ...acc]
    _         -> prt_projected(p, acc)
  })
}

# Reads of `nm` that are a whole argument in a borrowed slot and carry a
# reference-counted type.
fn prt_borrows(nm: String, e: Expr, slots: (Expr) -> [Int]) : Int = match e.kind {
  ECall(f, xs) -> {
    let here = match sym_read_kind(f.kind) {
      EVar(_) -> prt_borrowed_args(nm, xs, slots(f), 0)
      _       -> 0
    }
    here + prt_borrows_ps(nm, xp_positions(e), slots)
  }
  _ -> prt_borrows_ps(nm, xp_positions(e), slots)
}

fn prt_borrows_ps(nm: String, ps: [XPos], slots: (Expr) -> [Int]) : Int = match ps {
  []                  -> 0
  [XP(r, c), ...rest] ->
    (if xrole_inline(r) { prt_borrows(nm, c, slots) } else { 0 }) + prt_borrows_ps(nm, rest, slots)
}

fn prt_borrowed_args(nm: String, xs: [Expr], bpos: [Int], i: Int) : Int = match xs {
  []           -> 0
  [a, ...rest] -> {
    let here = if prt_arg_var(a) == nm and list_has_int(bpos, i) and prt_is_rc(a.ty) { 1 } else { 0 }
    here + prt_borrowed_args(nm, rest, bpos, i + 1)
  }
}

fn prt_arg_var(a: Expr) : String = match a.kind {
  EVar(u)      -> u
  ECall(f, xs) -> match xs {
    [x] -> if prt_is_dup(f) { prt_arg_var(x) } else { "" }
    _   -> ""
  }
  _ -> ""
}

fn prt_is_dup(f: Expr) : Bool = match f.kind {
  EMark(MkDup) -> true
  _            -> false
}

fn prt_is_rc(ty: Option[Ty]) : Bool = match ty {
  Some(t) -> not ty_is_unboxable_t(t)
  None    -> false
}

# Every mention of `nm`: reads, lambda captures and interpolation spans.
fn prt_mentions(nm: String, e: Expr) : Int = match e.kind {
  EVar(u)      -> if u == nm { 1 } else { 0 }
  EStr(span, _) -> if string_contains(span, nm) { 1 } else { 0 }
  _            -> prt_mentions_ps(nm, xp_positions(e))
}

fn prt_mentions_ps(nm: String, ps: [XPos]) : Int = match ps {
  []                  -> 0
  [XP(_, c), ...rest] -> prt_mentions(nm, c) + prt_mentions_ps(nm, rest)
}
