#[doc("""
Where a self tail call's arguments may be hoisted into slots.

The borrow strip and the goto ledger read an argument in a borrowed boxed
slot where it is written: a dup to strip, a binder lent or handed over.
Bound to a slot first, a reference there loses that marking. A value that
holds no reference has none to lose, and a bare read is not hoisted
(`ppd_hoist_with`) and keeps its mark in place, so only another reference
in such a slot keeps the arguments in place.
""")]

import compiler.ast
import compiler.self_call
import compiler.perceus_plant_drop

#[doc("True when no self tail call of `e` passes a reference in a slot of `bpos`, the fn's borrowed boxed slots.")]
pub fn phg_keeps_marks(e: Expr, self_name: SelfRef, bpos: [Int]) : Bool = match bpos {
  [] -> true
  _  -> phg_tails_keep(e, self_name, bpos)
}

fn phg_tails_keep(e: Expr, self_name: SelfRef, bpos: [Int]) : Bool = match e.kind {
  ECall(f, xs)       -> not is_self_callee(f, self_name) or phg_args_keep(xs, bpos, 0)
  # An inner planting checked the call it hoisted.
  EBlock(stmts, obt) -> ppd_is_hoist_block(stmts) or phg_opt_keeps(obt, self_name, bpos)
  EIf(_, t, oe)      -> phg_tails_keep(t, self_name, bpos) and phg_opt_keeps(oe, self_name, bpos)
  EMatch(_, arms)    -> all(arms, (a) => match a { Arm(_, _, b) -> phg_tails_keep(b, self_name, bpos) })
  _                  -> true
}

fn phg_opt_keeps(oe: Option[Expr], self_name: SelfRef, bpos: [Int]) : Bool = match oe {
  None    -> true
  Some(e) -> phg_tails_keep(e, self_name, bpos)
}

fn phg_args_keep(xs: [Expr], bpos: [Int], i: Int) : Bool = match xs {
  []           -> true
  [a, ...rest] -> (phg_unmarked(a) or not any(bpos, (b) => b == i)) and phg_args_keep(rest, bpos, i + 1)
}

# A bare read stays in place; an immediate Int, a Bool, unit and an absent
# slot hold no reference. The bound sits well inside the immediate range.
fn phg_unmarked(a: Expr) : Bool = match a.kind {
  ELocal(_)               -> true
  EInt(v, sfx)            -> sfx == "" and v > 0 - 1073741824 and v < 1073741824
  EBool(_)                -> true
  EUnit                   -> true
  EIntrinsic(InAbsent, _) -> true
  _                       -> false
}
