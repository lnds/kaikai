#[doc("""
`--dump-tycon-ids`: the declaration each nominal type in the root
file's typed bodies denotes.

One block per root function: `fn <name>`, then every distinct nominal
type its body's expressions carry, as `<type>  <Name>@<home>`. The
declaration is read off the type's identity and rendered through the
program's own type declarations, so the output names no positional id
and stays stable across unrelated edits. A union component no type
declares names its constructor, printed `<Name>@<home> (constructor)`.
A type whose identity names no declaration prints `-`; the root file's
home prints as `(root)`.
""")]

import compiler.ast
import compiler.expr_positions
import compiler.infer
import compiler.util
import compiler.decl_names
import compiler.symtab_build

#[doc("Print the declaration behind every nominal type in the root file's typed function bodies; `target` is the root module.")]
pub fn dump_tycon_ids(decls: [Decl], target: String) : Int / Console {
  let names = tid_decl_names(decls, target, map(core_type_names(), (n) => TidName(sym_raw(core_type_sym(n)), string_concat(n, "@core"))))
  tid_decls(decls, names)
  0
}

# One type declaration: its identity and how the dump renders it.
type TidName = TidName(Int, String)

fn tid_decl_names(ds: [Decl], target: String, acc: [TidName]) : [TidName] = match ds {
  [] -> acc
  [d, ...rest] -> match decl_transparent_inner(d) {
    Some(inner) -> tid_decl_names([inner, ...rest], target, acc)
    None -> match d {
      DType(_, nm, _, body, _, _, mo, _, s) ->
        tid_decl_names(rest, target, tid_ctor_names(body, mo, target,
          [TidName(sym_raw(s), concat_all([nm, "@", tid_home(mo)])), ...acc]))
      _ -> tid_decl_names(rest, target, acc)
    }
  }
}

# A type declaration is listed before its constructors, so an id both
# could answer reads as the type.
fn tid_ctor_names(body: TypeBody, mo: Option[String], target: String, acc: [TidName]) : [TidName] = match body {
  TBSum(vs) -> list_append(acc, map(vs, (v) => match v {
    Var(n, _) -> TidName(sym_raw(sym_derive(NCCtor, n, tid_owner(mo, target))),
                         concat_all([n, "@", tid_home(mo), " (constructor)"]))
  }))
  _ -> acc
}

fn tid_owner(mo: Option[String], target: String) : String = match mo {
  Some(m) -> m
  None    -> target
}

fn tid_home(mo: Option[String]) : String = match mo {
  Some(m) -> m
  None -> "(root)"
}

fn tid_render(names: [TidName], s: SymId) : String =
  if sym_raw(s) < 0 { "-" } else { tid_lookup(names, sym_raw(s)) }

fn tid_lookup(names: [TidName], id: Int) : String = match names {
  [] -> concat_all(["#", int_to_string(id), "?"])
  [TidName(i, r), ...rest] -> if i == id { r } else { tid_lookup(rest, id) }
}

fn tid_decls(ds: [Decl], names: [TidName]) : Unit / Console = match ds {
  [] -> ()
  [d, ...rest] -> {
    match d {
      DFn(_, nm, _, _, _, _, body, _, _, None, _) -> tid_fn(nm, body, names)
      _ -> ()
    }
    tid_decls(rest, names)
  }
}

fn tid_fn(nm: String, body: Expr, names: [TidName]) : Unit / Console {
  print(concat_all(["fn ", nm]))
  tid_print(list_reverse(tid_expr(body, [])), names)
}

# A nominal type met in a body: its printed form and its identity.
type TidSeen = TidSeen(String, SymId)

fn tid_print(seen: [TidSeen], names: [TidName]) : Unit / Console = match seen {
  [] -> ()
  [TidSeen(t, s), ...rest] -> {
    print(concat_all(["  ", t, "  ", tid_render(names, s)]))
    tid_print(rest, names)
  }
}

# Newest first; the caller reverses into first-appearance order.
fn tid_expr(e: Expr, acc: [TidSeen]) : [TidSeen] {
  let here = match e.ty {
    Some(t) -> if is_op_callee(e) { acc } else { tid_ty(t, acc) }
    None -> acc
  }
  tid_children(xp_positions(e), here)
}

# An op's callee carries the effect instance it performs, not a nominal type.
fn is_op_callee(e: Expr) : Bool = match e.kind {
  EName(n)       -> string_index_of_char(n, '.') >= 0 and is_con(e.ty)
  ESym(_, _, n) -> string_index_of_char(n, '.') >= 0 and is_con(e.ty)
  _             -> false
}

fn is_con(t: Option[Ty]) : Bool = match t {
  Some(TyCon(_, _, _, _)) -> true
  _ -> false
}

fn tid_children(ps: [XPos], acc: [TidSeen]) : [TidSeen] = match ps {
  [] -> acc
  [XP(_, c), ...rest] -> tid_children(rest, tid_expr(c, acc))
}

fn tid_ty(t: Ty, acc: [TidSeen]) : [TidSeen] = match t {
  TyCon(_, _, args, s) -> tid_tys(args, tid_add(acc, TidSeen(inf_ty_to_string(t), s)))
  TyListT(inner) -> tid_ty(inner, acc)
  TyFnT(ps, ret, _) -> tid_ty(ret, tid_tys(ps, acc))
  TyDimT(base, _) -> tid_ty(base, acc)
  TyRefineT(base, _) -> tid_ty(base, acc)
  _ -> acc
}

fn tid_tys(ts: [Ty], acc: [TidSeen]) : [TidSeen] = match ts {
  [] -> acc
  [t, ...rest] -> tid_tys(rest, tid_ty(t, acc))
}

fn tid_add(acc: [TidSeen], x: TidSeen) : [TidSeen] =
  if tid_has(acc, x) { acc } else { [x, ...acc] }

fn tid_has(acc: [TidSeen], x: TidSeen) : Bool = match acc {
  [] -> false
  [TidSeen(t, s), ...rest] -> match x {
    TidSeen(xt, xs) ->
      if t == xt and sym_raw(s) == sym_raw(xs) { true } else { tid_has(rest, x) }
  }
}
