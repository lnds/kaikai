#[doc("The module a declaration's surface comes from, and the names a pattern or parameter list binds.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.diag
import compiler.module_table
import compiler.written
import compiler.modules_paths
import compiler.util

# When a DFn carries `mo = Some(m)`, switch the running home to
# `m`. When it carries `mo = None` (root-file decl after the
# pub-only `tag_target_decls_module_origin`), reset to
# `target_mod` — the last seen tagged DFn was in a core, and
# the present untagged DFn marks the start of the root file.
pub(pkg) fn decl_home_hint_reset(d: Decl, cur_mod: String, target_mod: String) : String =
  match d {
    DFn(_, _, _, _, _, _, _, _, _, _, _, mo) -> match mo {
      Some(m) -> m
      None    -> target_mod
    }
    # DAxiom is the bare-form `extern "C" fn` / `axiom` shape that
    # `lower_axioms` rewrites to DFn later. It carries no
    # `module_origin` field, so a root-file DAxiom (e.g. `extern
    # "C" fn abs(n: Int) : Int / Ffi` inside an examples/effects
    # fixture) would otherwise inherit the last core's home.
    # Reset to `target_mod` instead — this is symmetric to the
    # DFn(None) reset above and matches the codegen's
    # `tag_target_decls_module_origin` carve-out.
    DAxiom(_, _, _, _, _, _, _, _, _, _) -> target_mod
    # A protocol carries its own stamp, like DFn: `None` marks a
    # root-file declaration, resetting the running home.
    DProtocol(_, _, _, _, _, _, _, _, mo) -> match mo {
      Some(m) -> m
      None    -> target_mod
    }
    # Every other form that carries its own `module_origin` slot resets
    # from it directly, exactly like `DFn` — a form with no explicit
    # case here silently inherited the PREVIOUS decl's home, which is
    # only ever right by accident (`decl_names.kai`'s `nt_home` reads
    # every one of these slots; this walker owes the same reads).
    DType(_, _, _, _, _, _, _, _, mo, _)   -> match mo { Some(m) -> m  None -> target_mod }
    DEffect(_, _, _, _, _, _, _, _, _, mo) -> match mo { Some(m) -> m  None -> target_mod }
    DKind(_, _, _, _, _, _, _, mo)   -> match mo { Some(m) -> m  None -> target_mod }
    DUnit(_, _, _, _, _, _, mo)      -> match mo { Some(m) -> m  None -> target_mod }
    DConst(_, _, _, _, mo, _, _, _, _)     -> unwrap_or(mo, target_mod)
    DExternType(_, _, _, _, _, mo)      -> match mo { Some(m) -> m  None -> target_mod }
    DTest(_, _, _, _, mo)            -> match mo { Some(m) -> m  None -> target_mod }
    DBench(_, _, _, _, mo)           -> match mo { Some(m) -> m  None -> target_mod }
    DCheck(_, _, _, _, _, mo)        -> match mo { Some(m) -> m  None -> target_mod }
    DDerive(_, inner, _, _)         -> decl_home_hint_reset(inner, cur_mod, target_mod)
    DUnstable(inner, _, _)          -> decl_home_hint_reset(inner, cur_mod, target_mod)
    DProtoLaws(_, inner, _, _, _)      -> decl_home_hint_reset(inner, cur_mod, target_mod)
    DImplAxiom(_, inner, _, _, _)      -> decl_home_hint_reset(inner, cur_mod, target_mod)
    DConstructor(inner, _, _)       -> decl_home_hint_reset(inner, cur_mod, target_mod)
    DImpl(_, _, _, sub_decls, _, _, _, _) -> impl_home_hint_reset(sub_decls, cur_mod, target_mod)
    _ -> cur_mod
  }

fn impl_home_hint_reset(ms: [Decl], cur_mod: String, target_mod: String) : String =
  match ms {
    [] -> cur_mod
    [m, ...rest] -> match m {
      DFn(_, _, _, _, _, _, _, _, _, _, _, mo) -> match mo {
        Some(mm) -> mm
        None     -> target_mod
      }
      _ -> impl_home_hint_reset(rest, cur_mod, target_mod)
    }
  }

# `take` / `drop` from `stdlib/core/list.kai` are not available
# while building stage 1 (stage 0 has no core); use these
# decl-list-specific helpers instead.
pub(pkg) fn pae_take(xs: [Decl], n: Int) : [Decl] = match xs {
  [] -> []
  [h, ...t] -> if n <= 0 { [] } else { [h, ...pae_take(t, n - 1)] }
}

pub(pkg) fn pae_drop(xs: [Decl], n: Int) : [Decl] = match xs {
  [] -> []
  [h, ...t] -> if n <= 0 { [h, ...t] } else { pae_drop(t, n - 1) }
}

# A per-decl home attribution paired with a flag distinguishing
# anchored entries (the decl itself carried `module_origin =
# Some(m)`) from derived entries (a non-DFn that inherited its
# home from the running `cur_mod`). The flag is what
# stops a later anchor from propagating across an unrelated
# already-anchored module — see `propagate_home_back`.
pub(pkg) type HomeAnchor = HA(String, Bool)

#                    home    anchored

# For each decl in `ds`, return the home module it should be
# attributed to. Algorithm: scan left-to-right; when a DFn/DAxiom
# with `mo=Some(m)` lands, retroactively assign `m` to every
# preceding derived (non-anchored) decl that was attributed to
# the running `cur_mod` and update the running home to `m`. The
# result is a list of homes in source order — one per decl.
#
# Without the anchored flag, a transitive import chain
# `consumer -> mid -> leaf` would mis-attribute every decl of `leaf`
# to `mid`. When `leaf`'s decls land first (process_imports recurses
# depth-first), they anchor under `leaf`; when `mid`'s first explicit
# DFn arrives later, `propagate_home_back` walks back replacing every
# preceding entry that still reads `cur_mod`. Since `cur_mod` stayed
# at `leaf` after the last `leaf` DFn (the new `mid` non-DFn DTypes
# inherit `leaf`), the back-propagation overruns `mid`'s own DTypes
# AND every previously-anchored `leaf` DFn. The flag stops the walk
# at the first anchored entry, preserving `leaf`'s attributions.
pub(pkg) fn imports_home_anchors(ds: [Decl], target_mod: String, cur_mod: String,
                          acc: [HomeAnchor]) : [HomeAnchor] = match ds {
  [] -> list_reverse(acc)
  [d, ...rest] -> {
    let hint = decl_home_hint_reset(d, cur_mod, target_mod)
    # If this decl explicitly carries `Some(m)`, propagate `m`
    # backward to any prior derived entries still tagged with the
    # previous `cur_mod` (so a DType at the head of the import
    # inherits the first DFn's mod). Anchored entries — those
    # whose own decl had `module_origin = Some(_)` — are never
    # overwritten.
    let explicit = decl_explicit_home(d)
    let acc1 = match explicit {
      Some(m) -> propagate_home_back(acc, cur_mod, m, [])
      None    -> acc
    }
    let mine = match explicit {
      Some(m) -> HA(m, true)
      None    -> HA(hint, false)
    }
    imports_home_anchors(rest, target_mod, ha_home(mine), [mine, ...acc1])
  }
}

pub(pkg) fn ha_home(h: HomeAnchor) : String = match h { HA(m, _) -> m }

fn decl_explicit_home(d: Decl) : Option[String] = match d {
  DFn(_, _, _, _, _, _, _, _, _, _, _, mo) -> mo
  # Root-file DTypes also carry `module_origin = Some(_)`
  # after `tag_target_decl`, so use them as home anchors too — a
  # leading DType in the root file does not have a DFn ahead of it
  # to seed the propagate_home_back walk, and the home should not
  # leak in from the last imported core segment.
  DType(_, _, _, _, _, _, _, _, mo, _) -> mo
  DProtocol(_, _, _, _, _, _, _, _, mo) -> mo
  DDerive(_, inner, _, _)         -> decl_explicit_home(inner)
  DUnstable(inner, _, _)          -> decl_explicit_home(inner)
  DProtoLaws(_, inner, _, _, _)      -> decl_explicit_home(inner)
  DImplAxiom(_, inner, _, _, _)      -> decl_explicit_home(inner)
  DConstructor(inner, _, _)       -> decl_explicit_home(inner)
  DImpl(_, _, _, sub_decls, _, _, _, _) -> impl_first_fn_home(sub_decls)
  _ -> None
}

fn impl_first_fn_home(ms: [Decl]) : Option[String] = match ms {
  [] -> None
  [m, ...rest] -> match m {
    DFn(_, _, _, _, _, _, _, _, _, _, _, mo) -> mo
    _ -> impl_first_fn_home(rest)
  }
}

# Walk `acc` (reversed source order — newest first) and replace
# every derived (non-anchored) running entry equal to `prev` with
# `new`, stopping at the first anchored entry OR the first entry
# whose home already differs. Anchored entries belong to a module
# that already locked in its attribution and must never be
# rewritten. Returns the list still in reversed order.
fn propagate_home_back(acc: [HomeAnchor], prev: String, new: String,
                         done: [HomeAnchor]) : [HomeAnchor] = match acc {
  [] -> done
  [h, ...rest] -> match h {
    HA(m, anchored) ->
      if anchored or m != prev {
        append_reverse_ha(done, [h, ...rest])
      } else {
        propagate_home_back(rest, prev, new, [HA(new, false), ...done])
      }
  }
}

fn append_reverse_ha(a: [HomeAnchor], b: [HomeAnchor]) : [HomeAnchor] = match a {
  [] -> b
  [h, ...rest] -> append_reverse_ha(rest, [h, ...b])
}

#[doc("What a qualified head is checked against: the module table of the file that wrote it, and that file.")]
pub(pkg) type QtCx = { mt: [ModuleEntry], file: String }

#[doc("The diagnostics of one read of `mod.ty`, pushed onto `acc`: the rival-module warning, then the error when `mod` names no import or does not export `ty`.")]
pub(pkg) fn qtchk_site(mod: String, ty: String, cx: QtCx, line: Int, col: Int, acc: [Diagnostic]) : [Diagnostic] = {
  let seen = match mt_rival_diag(cx.mt, mod, ty, cx.file, line, col) {
    Some(w) -> [w, ...acc]
    None    -> acc
  }
  match mt_lookup_member(cx.mt, mod, ty) {
    None     -> [qt_diag_unknown_mod(mod, ty, cx.file, line, col), ...seen]
    Some(me) ->
      if me_has_export(me, ty) { seen }
      else { [qt_diag_missing_type(mod, ty, me_exports(me), cx.file, line, col), ...seen] }
  }
}

fn qtchk_ref(r: DeclRef, cx: QtCx, line: Int, col: Int, acc: [Diagnostic]) : [Diagnostic] = match r {
  DrWritten(Some(q), n) -> qtchk_site(written_text(q), written_text(n), cx, line, col, acc)
  _                     -> acc
}

#[doc("The diagnostics of the qualified heads inside `te`, pushed onto `acc`.")]
pub(pkg) fn qtchk_te(te: TypeExpr, cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match te.tkind {
  TyName(r, targs)     -> qtchk_ref(r, cx, te.line, te.col, qtchk_tes(targs, cx, acc))
  TyList(inner)        -> qtchk_te(inner, cx, acc)
  TyFn(ps, ret, row)   -> qtchk_row(row, cx, qtchk_te(ret, cx, qtchk_tes(ps, cx, acc)))
  TyDim(base, _)       -> qtchk_te(base, cx, acc)
  TyRefine(base, pred, _) -> qtchk_expr(pred, cx, qtchk_te(base, cx, acc))
  TyRow(row)           -> qtchk_row(row, cx, acc)
  TySurface(ts)        -> qtchk_tes(tysurface_children(ts), cx, acc)
  TyParam(_, targs)    -> qtchk_tes(targs, cx, acc)
}

#[doc("`qtchk_te` over a list.")]
pub(pkg) fn qtchk_tes(tes: [TypeExpr], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match tes {
  []           -> acc
  [t, ...rest] -> qtchk_tes(rest, cx, qtchk_te(t, cx, acc))
}

#[doc("`qtchk_te` over an optional annotation.")]
pub(pkg) fn qtchk_te_opt(o: Option[TypeExpr], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match o {
  None     -> acc
  Some(te) -> qtchk_te(te, cx, acc)
}

#[doc("The diagnostics of the qualified heads inside the labels of an effect row.")]
pub(pkg) fn qtchk_row(re: RowExpr, cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match re {
  REmpty       -> acc
  RClosed(ls)  -> qtchk_labels(ls, cx, acc)
  ROpen(_, ls) -> qtchk_labels(ls, cx, acc)
}

fn qtchk_labels(ls: [RowLabel], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match ls {
  []                   -> acc
  [RL(_, ts), ...rest] -> qtchk_labels(rest, cx, qtchk_tes(ts, cx, acc))
}

#[doc("The diagnostics of the qualified heads inside a parameter list's annotations.")]
pub(pkg) fn qtchk_params(ps: [Param], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match ps {
  []           -> acc
  [p, ...rest] -> qtchk_params(rest, cx, qtchk_te_opt(p.ptype, cx, acc))
}

# Every variant is named: a new one is a compile error here, not a
# position the check leaves unread.
#[doc("The diagnostics of the qualified heads inside `e`: its annotations, narrows and record literals.")]
pub(pkg) fn qtchk_expr(e: Expr, cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match e.kind {
  ERecordLit(r, fs)     -> qtchk_ref(r, cx, e.line, e.col, qtchk_inits(fs, cx, acc))
  EBlock(ss, tail)      -> qtchk_expr_opt(tail, cx, qtchk_stmts(ss, cx, acc))
  EMatch(scr, arms)     -> qtchk_arms(arms, cx, qtchk_expr(scr, cx, acc))
  EVariantsOf(te, _)    -> qtchk_te(te, cx, acc)
  ELambda(ps, b)        -> qtchk_expr(b, cx, qtchk_params(ps, cx, acc))
  EHandle(body, _, tys, init, _, cs, ret) ->
    qtchk_hreturn_opt(ret, cx, qtchk_hclauses(cs, cx,
      qtchk_expr_opt(init, cx, qtchk_tes(tys, cx, qtchk_expr(body, cx, acc)))))
  EIntrinsic(_, xs)     -> qtchk_exprs(xs, cx, acc)
  ESurface(sf)          -> qtchk_exprs(surface_children(sf), cx, acc)
  ECall(f, xs)          -> qtchk_exprs(xs, cx, qtchk_expr(f, cx, acc))
  EField(x, _)          -> qtchk_expr(x, cx, acc)
  EIndex(a, b)          -> qtchk_expr(b, cx, qtchk_expr(a, cx, acc))
  EBinop(_, a, b)       -> qtchk_expr(b, cx, qtchk_expr(a, cx, acc))
  EUnop(_, x)           -> qtchk_expr(x, cx, acc)
  EIf(c, t_, eo)        -> qtchk_expr_opt(eo, cx, qtchk_expr(t_, cx, qtchk_expr(c, cx, acc)))
  EList(els)            -> qtchk_elems(els, cx, acc)
  ERange(a, b, st)      -> qtchk_expr_opt(st, cx, qtchk_expr(b, cx, qtchk_expr(a, cx, acc)))
  EPipe(a, b)           -> qtchk_expr(b, cx, qtchk_expr(a, cx, acc))
  EDispatchPipe(_, a, b) -> qtchk_expr(b, cx, qtchk_expr(a, cx, acc))
  ELitUnit(inner, _)    -> qtchk_expr(inner, cx, acc)
  EBang(inner)          -> qtchk_expr(inner, cx, acc)
  EInt(_, _)            -> acc
  EReal(_, _)           -> acc
  EIntLit(_)            -> acc
  EDecimalLit(_)        -> acc
  EFixed(_, _)          -> acc
  EBool(_)              -> acc
  EChar(_)              -> acc
  EStr(_, _)            -> acc
  EUnit                 -> acc
  EName(_)              -> acc
  EMark(_)              -> acc
  ESym(_, _)            -> acc
  ELocal(_)             -> acc
  EOp(_)                -> acc
  EUnder                -> acc
  EPlaceholder          -> acc
  EHole(_)              -> acc
  ETodo(_)              -> acc
  EExternBody(_, _)     -> acc
  EModCall(_, _)        -> acc
}

fn qtchk_exprs(es: [Expr], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match es {
  []           -> acc
  [h, ...rest] -> qtchk_exprs(rest, cx, qtchk_expr(h, cx, acc))
}

fn qtchk_expr_opt(o: Option[Expr], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match o {
  None    -> acc
  Some(x) -> qtchk_expr(x, cx, acc)
}

fn qtchk_inits(fs: [FieldInit], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match fs {
  []                  -> acc
  [FI(_, v), ...rest] -> qtchk_inits(rest, cx, qtchk_expr(v, cx, acc))
}

fn qtchk_elems(els: [ListElem], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match els {
  []           -> acc
  [h, ...rest] -> qtchk_elems(rest, cx, match h {
    ElPlain(e)  -> qtchk_expr(e, cx, acc)
    ElSpread(e) -> qtchk_expr(e, cx, acc)
  })
}

fn qtchk_arms(arms: [Arm], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match arms {
  [] -> acc
  [Arm(pat, g, body), ...rest] ->
    qtchk_arms(rest, cx, qtchk_expr(body, cx, qtchk_expr_opt(g, cx, qtchk_pat(pat, cx, acc))))
}

fn qtchk_pat(pat: Pattern, cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match pat.pkind {
  PNarrow(_, te)        -> qtchk_te(te, cx, acc)
  PVariant(_, subs)     -> qtchk_pats(subs, cx, acc)
  PVariantRecord(_, fs) -> qtchk_pfields(fs, cx, acc)
  PRecord(fs)           -> qtchk_pfields(fs, cx, acc)
  PList(subs, _)        -> qtchk_pats(subs, cx, acc)
  PAs(_, inner)         -> qtchk_pat(inner, cx, acc)
  _                     -> acc
}

fn qtchk_pats(ps: [Pattern], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match ps {
  []           -> acc
  [p, ...rest] -> qtchk_pats(rest, cx, qtchk_pat(p, cx, acc))
}

fn qtchk_pfields(fs: [PField], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match fs {
  []                           -> acc
  [PField(_, sub, _), ...rest] -> qtchk_pfields(rest, cx, qtchk_pat(sub, cx, acc))
}

fn qtchk_stmts(ss: [Stmt], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match ss {
  []           -> acc
  [s, ...rest] -> qtchk_stmts(rest, cx, qtchk_stmt(s, cx, acc))
}

fn qtchk_stmt(s: Stmt, cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match s {
  SLet(pat, ty, e)            -> qtchk_expr(e, cx, qtchk_te_opt(ty, cx, qtchk_pat(pat, cx, acc)))
  SVar(_, ty, init, _, _)     -> qtchk_expr(init, cx, qtchk_te_opt(ty, cx, acc))
  SAssert(c, m)               -> qtchk_expr_opt(m, cx, qtchk_expr(c, cx, acc))
  SExprStmt(e)                -> qtchk_expr(e, cx, acc)
  SIndexAssign(a, i, v, _, _) -> qtchk_expr(v, cx, qtchk_expr(i, cx, qtchk_expr(a, cx, acc)))
  SAssign(l, v, _, _)         -> qtchk_expr(v, cx, qtchk_expr(l, cx, acc))
  SUse(_, _, _)               -> acc
}

fn qtchk_hclauses(cs: [HClause], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match cs {
  [] -> acc
  [HC(_, ps, body, _, _), ...rest] -> qtchk_hclauses(rest, cx, qtchk_expr(body, cx, qtchk_params(ps, cx, acc)))
}

fn qtchk_hreturn_opt(o: Option[HReturn], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match o {
  None                    -> acc
  Some(HR(_, body, _, _)) -> qtchk_expr(body, cx, acc)
}

#[doc("True when a name starts with an ASCII uppercase letter.")]
pub(pkg) fn name_starts_upper(name: String) : Bool = match char_at(name, 0) {
  Some(c) -> c >= 'A' and c <= 'Z'
  None    -> false
}

# The module name an EModCall must carry: the one the module's decls
# were tagged with, which is what codegen keys symbols by. A file
# reached under an alias appears in the table more than once, sharing
# an origin path; the tagged name is the one on the entry the resolver
# registered globally, which per-file alias entries are prepended to.
# Scanning from the end finds it regardless of how many aliases name
# the same file.
#[doc("The modules each file opens with a plain `import m`, as tagged module names, keyed by the importing file's tagged name (`\"\"` = root). An alias or a selective import binds a qualifier or picks names, and opens nothing.")]
pub(pkg) fn scope_imports(scopes: [ModScope], global: [ModuleEntry]) : [ModImports] = match scopes {
  [] -> []
  [MScope(owner, mes, opens), ...rest] ->
    [MImp(owner, scope_tagged_names(mes, opens, global)), ...scope_imports(rest, global)]
}

fn scope_tagged_names(mes: [ModuleEntry], opens: [String], global: [ModuleEntry]) : [String] = match mes {
  [] -> []
  [ME(written, _, origin, _, _), ...rest] ->
    if list_has(opens, written) {
      [me_last_name_for_origin(global, origin, written), ...scope_tagged_names(rest, opens, global)]
    } else { scope_tagged_names(rest, opens, global) }
}

# Collect the binders introduced by a pattern. Used by SLet,
# match-arm patterns, and variant-record / record patterns.
pub(pkg) fn pat_binders(pat: Pattern, acc: [Binder]) : [Binder] = match pat.pkind {
  PWild           -> acc
  PLit(_)         -> acc
  PRange(_, _)    -> acc
  PBind(b)        -> [b, ...acc]
  PList(subs, opt_rest) -> {
    let acc1 = pat_binders_list(subs, acc)
    match opt_rest { Some(b) -> [b, ...acc1] None -> acc1 }
  }
  PVariant(_, subs)        -> pat_binders_list(subs, acc)
  PVariantRecord(_, fs)    -> pat_binders_pfields(fs, acc)
  PRecord(fs)              -> pat_binders_pfields(fs, acc)
  PHole(_)                 -> acc
  PAs(b, inner)            -> pat_binders(inner, [b, ...acc])
  PNarrow(b, _)            -> [b, ...acc]
  PSurface(sp)             -> pat_binders_list(patsurface_children(sp), acc)
}

fn pat_binders_list(ps: [Pattern], acc: [Binder]) : [Binder] = match ps {
  [] -> acc
  [p, ...rest] -> pat_binders_list(rest, pat_binders(p, acc))
}

fn pat_binders_pfields(fs: [PField], acc: [Binder]) : [Binder] = match fs {
  [] -> acc
  [f, ...rest] -> match f {
    PField(_, sub, _) -> pat_binders_pfields(rest, pat_binders(sub, acc))
  }
}

#[doc("The names the binders of a pattern were written with, ahead of `acc`: what a pass that runs before the resolver tracks its scope by.")]
pub(pkg) fn pat_binder_names(pat: Pattern, acc: [String]) : [String] =
  list_append(map(pat_binders(pat, []), (b) => written_text(b.name)), acc)

pub(pkg) fn fn_param_names(params: [Param]) : [String] = match params {
  [] -> []
  [p, ...rest] -> [written_text(p.binder.name), ...fn_param_names(rest)]
}
