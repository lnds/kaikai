#[doc("Dead-code lint: dead_code_unused_priv. A private root-file function never referenced anywhere in the file is dead code the compiler does not warn about; pub functions and `main` are always considered reachable.")]

import compiler.ast
import compiler.expr_positions

# `LintFinding` is defined in `compiler.lint_idiom` and shared by every
# lint module.

#[doc("dead_code_unused_priv findings over a typed program's root-file decls; one finding per unreferenced private function. `declared` lists the top-level fn names the source actually declares — a lowered decl absent from it was synthesised and is exempt.")]
pub fn deadcode_findings(decls: [Decl], declared: [String]) : [LintFinding] {
  let used = collect_used(decls, [])
  scan_unused(decls, used, declared, [])
}

# ---- the declared set ------------------------------------------------
#
# Names of fns the source declares at top level, read off the AST as the
# parser produced it (before protocol lowering synthesises its own).
# Attribute wrappers are transparent; an `impl`/`derive` body is not
# descended into, because its methods are not top-level declarations.

#[doc("Top-level fn names a source AST declares, seeing through attribute wrappers. Methods inside `impl` / `derive` are excluded: they are lowered into top-level DFns but the user never declared them as such.")]
pub fn deadcode_declared_fns(decls: [Decl]) : [String] =
  declared_loop(decls, [])

fn declared_loop(decls: [Decl], acc: [String]) : [String] {
  match decls {
    []           -> acc
    [d, ...rest] -> declared_loop(rest, declared_in_decl(d, acc))
  }
}

fn declared_in_decl(d: Decl, acc: [String]) : [String] {
  match d {
    DFn(_, name, _, _, _, _, _, _, _, _, _) -> [name, ...acc]
    DUnstable(inner, _, _)               -> declared_in_decl(inner, acc)
    DConstructor(inner, _, _)            -> declared_in_decl(inner, acc)
    DDoc(_, _, inner, _, _)              -> declared_in_decl(inner, acc)
    _                                    -> acc
  }
}

# ---- the reference set -----------------------------------------------
#
# Every name mentioned in any decl body (a call, a bare reference, a
# qualified call). A private function whose name is absent from this set
# is referenced nowhere and is dead.

fn collect_used(decls: [Decl], acc: [String]) : [String] {
  match decls {
    []           -> acc
    [d, ...rest] -> collect_used(rest, used_in_decl(d, acc))
  }
}

fn used_in_decl(d: Decl, acc: [String]) : [String] {
  match d {
    DFn(_, _, _, _, _, _, body, _, _, _, _) -> names_in_expr(body, acc)
    _                                    -> acc
  }
}

# Accumulate every referenced name in an expression tree. A bare `EVar`,
# a resolved `ESym` and a qualified `EModCall` all name something.
fn names_in_expr(e: Expr, acc: [String]) : [String] =
  names_in_positions(xp_positions(e), name_here(e, acc))

fn name_here(e: Expr, acc: [String]) : [String] {
  match e.kind {
    EVar(n)        -> [n, ...acc]
    ESym(_, n)     -> [n, ...acc]
    EModCall(_, n) -> [n, ...acc]
    _              -> acc
  }
}

fn names_in_positions(xs: [XPos], acc: [String]) : [String] {
  match xs {
    []                  -> acc
    [XP(_, x), ...rest] -> names_in_positions(rest, names_in_expr(x, acc))
  }
}

# ---- the unused scan -------------------------------------------------

fn scan_unused(decls: [Decl], used: [String], declared: [String],
                acc: [LintFinding]) : [LintFinding] {
  match decls {
    []           -> list_reverse(acc)
    [d, ...rest] -> scan_unused(rest, used, declared, dc_decl(d, used, declared, acc))
  }
}

# A private root-file function (mo = None, not pub, not `main`) whose name
# never appears in the reference set is dead code. pub functions are
# reachable from other modules; `main` is the entry point.
fn dc_decl(d: Decl, used: [String], declared: [String], acc: [LintFinding]) : [LintFinding] {
  match d {
    DFn(is_pub, name, _, _, _, _, _, line, col, mo, _) ->
      if dc_is_dead(is_pub, name, mo, used, declared) {
        [LF("dead_code_unused_priv", line, col,
            concat_all(["private function `", name, "` is never used; remove it or export it"])), ...acc]
      } else { acc }
    _ -> acc
  }
}

# The lint runs on the lowered AST, where an `impl`/`derive` method has
# already become a top-level `__pimpl_*` DFn indistinguishable from a
# private fn. Requiring the name in `declared` — the fn names the source
# text itself declares at top level — is what keeps the two apart: the
# remedies the message proposes only exist for a fn the user wrote.
fn dc_is_dead(is_pub: Bool, name: String, mo: Option[String],
               used: [String], declared: [String]) : Bool =
  is_root(mo) and not is_pub and name != "main" and mem(name, declared) and not mem(name, used)

fn is_root(mo: Option[String]) : Bool {
  match mo {
    None    -> true
    Some(_) -> false
  }
}

fn mem(name: String, xs: [String]) : Bool {
  match xs {
    []           -> false
    [x, ...rest] -> if x == name { true } else { mem(name, rest) }
  }
}
