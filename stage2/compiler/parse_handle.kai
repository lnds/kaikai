#[doc("`handle` expressions and their operation and lifecycle clauses.")]

import compiler.util
import compiler.lex_tokens
import compiler.ast
import compiler.parse_state
import compiler.parse_types
import compiler.parse_stmt

type HandleHead = { t: Token, body: Expr, eff: DeclRef, tyargs: [TypeExpr] }

type ClauseAcc = { ops: [HClause], ret: Option[HReturn], prelude: [Stmt] }

#[doc("Parses a `handle` expression after the keyword.")]
pub fn parse_handle(p: Parser, t: Token) : PExpr / Console =
  if not p_at(p, TkLbrace) { fail_e(p, "expected `{` to start handle body") }
  else {
    let b = parse_block(p, p_peek(p))
    match b.r {
      None -> b
      Some(body) -> handle_with(p_skip_newlines(b.p), t, body)
    }
  }

fn handle_with(p: Parser, t: Token, body: Expr) : PExpr / Console {
  let p1 = p_eat(p, TkWith, "expected `with` after handle body")
  let eff_t = p_peek(p1)
  if p_failed(p1) { err_e(p1) }
  else if not tk_is(eff_t.kind, TkIdent) { fail_e_at(p1, eff_t, "expected effect name after `with`") }
  else { handle_effect(p1, eff_t, t, body) }
}

#[doc("Parses an optional `[T, ...]` argument list after an effect name.")]
pub fn parse_opt_row_args(p: Parser) : PRowArgs / Console =
  if p_at(p, TkLbracket) { parse_row_label_args(p_advance_nl(p), []) }
  else { PRowArgs { p: p, r: Some([]) } }

fn handle_effect(p: Parser, eff_t: Token, t: Token, body: Expr) : PExpr / Console {
  let q = parse_qualified_head_name(p, eff_t)
  let a = parse_opt_row_args(q.p)
  match a.r {
    None -> err_e(a.p)
    Some(tyargs) -> handle_init(a.p, HandleHead { t: t, body: body, eff: q.dref, tyargs: tyargs })
  }
}

fn handle_init(p: Parser, h: HandleHead) : PExpr / Console {
  let init = parse_handler_state_init(p)
  if init.has_init and is_none(init.r) { err_e(init.p) } else { handle_clause_block(init, h) }
}

fn parse_handler_state_init(p: Parser) : PInit / Console =
  if not p_at(p, TkLparen) { PInit { p: p, r: None, has_init: false } }
  else {
    let ie = p_expr(p_advance_nl(p))
    match ie.r {
      None -> PInit { p: ie.p, r: None, has_init: true }
      Some(ix) -> {
        let pc = p_eat(p_skip_newlines(ie.p), TkRparen, "expected `)` after handler-state initializer")
        PInit { p: pc, r: if p_failed(pc) { None } else { Some(ix) }, has_init: true }
      }
    }
  }

fn handle_clause_block(init: PInit, h: HandleHead) : PExpr / Console {
  let alias = parse_handle_alias(init.p)
  let p4 = p_skip_newlines(alias.p)
  let p5 = p_eat(p4, TkLbrace, "expected `{` to start handler clauses")
  if p_failed(p5) { err_e(p5) }
  else {
    let cr = parse_handle_clauses(p_skip_newlines(p5), [], None, [])
    match cr.r {
      None -> err_e(cr.p)
      Some(_) -> finish_handle(p4, h, init, alias.r, cr)
    }
  }
}

fn parse_handle_alias(p: Parser) : PAlias / Console =
  if not p_at(p, TkAs) { PAlias { p: p, r: None } }
  else {
    let p1 = p_advance(p)
    let nt = p_peek(p1)
    if tk_is(nt.kind, TkIdent) { PAlias { p: p_advance(p1), r: Some(binder_written(tok_source(p1.src, nt))) } }
    else { PAlias { p: p_error(p1, nt, "expected alias name after `as`"), r: None } }
  }

fn parse_clause_params(p: Parser, acc: [Param]) : PParams / Console {
  let t = p_peek(p)
  if p_at(p, TkRparen) { PParams { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else if not tk_is(t.kind, TkIdent) { PParams { p: p_error(p, t, "expected parameter name"), r: None } }
  else {
    let ty = parse_optional_type(p_advance(p))
    let pm = Param { binder: binder_written(tok_source(p.src, t)), ptype: ty.r, pline: t.line, pcol: t.col, pborrow: false }
    clause_params_next(p_skip_newlines(ty.p), [pm, ...acc])
  }
}

fn clause_params_next(p: Parser, acc: [Param]) : PParams / Console =
  if p_at(p, TkComma) { parse_clause_params(p_advance_nl(p), acc) }
  else if p_at(p, TkRparen) { PParams { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else { PParams { p: p_error_here(p, "expected `,` or `)` in parameter list"), r: None } }

#[doc("""
Parses the clauses of a handler block up to its `}`. `var` / `let` may
open the block (collected into the prelude) but never follow an
operation clause.
""")]
pub fn parse_handle_clauses(p: Parser, acc: [HClause], rret: Option[HReturn], prelude: [Stmt]) : PClauses / Console =
  clauses_loop(p, ClauseAcc { ops: acc, ret: rret, prelude: prelude })

fn clauses_loop(p: Parser, a: ClauseAcc) : PClauses / Console {
  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) {
    PClauses { p: p_advance(p0), clauses: list_reverse(a.ops), return_clause: a.ret,
               prelude: list_reverse(a.prelude), r: Some(true) }
  } else {
    clause_at(p0, a)
  }
}

fn clause_fail(p: Parser, t: Token, msg: String) : PClauses / Console = pclauses_err(p_error(p, t, msg))

fn clause_at(p: Parser, a: ClauseAcc) : PClauses / Console {
  let id_t = p_peek(p)
  if tk_is(id_t.kind, TkVar) or tk_is(id_t.kind, TkLet) { prelude_clause(p, id_t, a) }
  else if not tk_is(id_t.kind, TkIdent) { clause_fail(p, id_t, "expected operation name in handler") }
  else if is_lifecycle_at(p, id_t) { lifecycle_clause(p, id_t, a) }
  else { op_clause(p, id_t, a) }
}

fn prelude_clause(p: Parser, id_t: Token, a: ClauseAcc) : PClauses / Console =
  match a.ops {
    [] -> {
      let sr = if tk_is(id_t.kind, TkVar) { parse_var(p, id_t) } else { parse_let(p, id_t) }
      match sr.r {
        None -> pclauses_err(sr.p)
        Some(s) -> clauses_loop(sr.p, ClauseAcc { ...a, prelude: [s, ...a.prelude] })
      }
    }
    _ -> clause_fail(p, id_t, "`var` and `let` must precede all operation clauses inside a handler")
  }

fn op_clause(p: Parser, id_t: Token, a: ClauseAcc) : PClauses / Console {
  let p1 = p_eat(p_advance(p), TkLparen, "expected `(` after operation name")
  if p_failed(p1) { pclauses_err(p1) }
  else {
    let ps = parse_clause_params(p_skip_newlines(p1), [])
    match ps.r {
      None -> pclauses_err(ps.p)
      Some(params) -> op_clause_body(p_skip_newlines(ps.p), id_t, params, a)
    }
  }
}

fn op_clause_body(p: Parser, id_t: Token, params: [Param], a: ClauseAcc) : PClauses / Console {
  let p1 = p_eat(p, TkArrow, "expected `->` after operation parameters")
  if p_failed(p1) { pclauses_err(p1) }
  else {
    let rb = p_expr(p_skip_newlines(p1))
    match rb.r {
      None -> pclauses_err(rb.p)
      Some(body) -> op_clause_done(rb.p, p, id_t, params, body, a)
    }
  }
}

fn op_clause_done(p: Parser, at: Parser, id_t: Token, params: [Param], body: Expr, a: ClauseAcc) : PClauses / Console {
  let name = tok_source(at.src, id_t)
  if name != "return" {
    clauses_loop(p, ClauseAcc { ...a, ops: [HC(ChOp(name), params, body, id_t.line, id_t.col), ...a.ops] })
  } else {
    match params {
      [pp] -> clauses_loop(p, ClauseAcc { ...a, ret: Some(HR(pp.binder, body, id_t.line, id_t.col)) })
      _ -> clause_fail(at, id_t, "return clause takes exactly one parameter")
    }
  }
}

fn is_lifecycle_at(p: Parser, id_t: Token) : Bool =
  is_some(clause_lifecycle_of_word(tok_source(p.src, id_t))) and p_at(p_advance_nl(p), TkLbrace)

fn lifecycle_clause(p: Parser, id_t: Token, a: ClauseAcc) : PClauses / Console {
  let name = tok_source(p.src, id_t)
  let head = match clause_lifecycle_of_word(name) {
    Some(h) -> h
    None -> ChOp(name)
  }
  let p1 = p_advance_nl(p)
  let rb = parse_block(p1, p_peek(p1))
  match rb.r {
    None -> pclauses_err(rb.p)
    Some(body) ->
      if lifecycle_seen(a.ops, head) { clause_fail(p, id_t, concat_all(["duplicate `", name, "` clause in handler"])) }
      else { clauses_loop(rb.p, ClauseAcc { ...a, ops: [HC(head, [], body, id_t.line, id_t.col), ...a.ops] }) }
  }
}

fn lifecycle_seen(ops: [HClause], head: ClauseHead) : Bool =
  any(ops, (c) => match c {
    HC(ChOp(_), _, _, _, _) -> false
    HC(h, _, _, _, _) -> clause_head_word(h) == clause_head_word(head)
  })

fn is_initially(c: HClause) : Bool = match c {
  HC(ChInitially, _, _, _, _) -> true
  _ -> false
}

fn finish_handle(p: Parser, h: HandleHead, init: PInit, alias: Option[Binder], cr: PClauses) : PExpr / Console {
  let init_cl = find(cr.clauses, is_initially)
  match init_cl {
    Some(_) if init.has_init -> fail_e_at(p, h.t, "a handler takes either `(init)` or `initially { }`, not both")
    _ -> {
      let eff_init = match init_cl {
        Some(HC(_, _, ib, il, ic)) -> Some(mk_expr(ESurface(SfHandleInit(ib)), il, ic))
        None -> init.r
      }
      let ops = filter(cr.clauses, (c) => not is_initially(c))
      let e = expr_at(EHandle(h.body, h.eff, h.tyargs, eff_init, alias, ops, cr.return_clause), h.t)
      ok_e(cr.p, match cr.prelude {
        [] -> e
        _ -> expr_at(EBlock(cr.prelude, Some(e)), h.t)
      })
    }
  }
}
