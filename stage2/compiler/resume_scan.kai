#[doc("""
Scanning of op clauses for resumes and the A-normal form that exposes them.
""")]

import compiler.util
import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.written
import compiler.core_refs
import compiler.expr_positions
import compiler.infer_glue
import compiler.infer_state
import compiler.anf_ops

pub(pkg) fn rs_children(e: Expr) : [Expr] = map(xp_positions(e), (p) => match p { XP(_, x) -> x })

fn opt_list(o: Option[Expr]) : [Expr] = match o {
  Some(e) -> [e]
  None    -> []
}

fn clause_body(c: HClause) : Expr = match c { HC(_, _, b, _, _) -> b }

fn ret_body(r: Option[HReturn]) : Option[Expr] = match r {
  Some(HR(_, b, _, _)) -> Some(b)
  None                 -> None
}

fn rs_at(e: Expr) : Expr = match e.kind {
  ECall(f, _) -> f
  _           -> e
}

pub(pkg) fn rs_is_k_call(e: Expr, k: String) : Bool = match e.kind {
  ECall(f, _) -> match f.kind { EName(n) -> written_text(n) == k  _ -> false }
  _           -> false
}

pub(pkg) fn rs_find_k(e: Expr, k: String) : Option[Expr] =
  if rs_is_k_call(e, k) { Some(e) }
  else { match e.kind {
    ELambda(_, _) -> None
    EHandle(_, _, _, _, _, _, _) -> None
    _ -> rs_find_k_in(rs_children(e), k)
  } }

pub(pkg) fn rs_find_k_in(es: [Expr], k: String) : Option[Expr] = match es {
  [] -> None
  [x, ...rest] -> match rs_find_k(x, k) {
    Some(hit) -> Some(hit)
    None      -> rs_find_k_in(rest, k)
  }
}

pub(pkg) fn rs_has_k(e: Expr, k: String) : Bool = match rs_find_k(e, k) {
  Some(_) -> true
  None    -> false
}

fn rs_stmts_have_k(ss: [Stmt], k: String) : Bool =
  any(ss, (s) => any(stmt_exprs(s), (x) => rs_has_k(x, k)))

pub(pkg) fn rs_closes_over(e: Expr, names: [String]) : Bool = match e.kind {
  ELambda(_, b) -> match rs_find_ref(b, names) {
    Some(_) -> true
    None    -> false
  }
  _ -> any(rs_children(e), (x) => rs_closes_over(x, names))
}

pub(pkg) fn rs_find_ref(e: Expr, names: [String]) : Option[Expr] = match e.kind {
  EName(n) -> if list_has(names, written_text(n)) { Some(e) } else { None }
  _       -> rs_find_ref_in(rs_children(e), names)
}

fn rs_find_ref_in(es: [Expr], names: [String]) : Option[Expr] = match es {
  [] -> None
  [x, ...rest] -> match rs_find_ref(x, names) {
    Some(hit) -> Some(hit)
    None      -> rs_find_ref_in(rest, names)
  }
}

#[doc("A shape the split cannot express: the error, a hint, and where.")]
pub type RsBad = RsBad(String, String, Int, Int)

pub(pkg) fn rs_unsplittable(e: Expr, k: String) : Option[RsBad] = match e.kind {
  EHandle(_, _, _, _, _, _, _) -> match rs_deep_k(e, k) {
    Some(c) -> Some(RsBad("`resume` is called inside a `handle` nested in its clause",
                          "the resumed body would have to run under the inner handler; call `resume` outside it", rs_at(c).line, rs_at(c).col))
    None    -> None
  }
  ECall(f, xs) ->
    if rs_is_loop_callee(f) {
      match rs_deep_k_in(xs, k) {
        Some(c) -> Some(RsBad("`resume` is called inside a loop",
                              "the continuation is one-shot; compute the value in the loop and resume once after it", rs_at(c).line, rs_at(c).col))
        None    -> None
      }
    } else { rs_unsplittable_in([f, ...xs], k) }
  _ -> rs_unsplittable_in(rs_children(e), k)
}

fn rs_unsplittable_in(es: [Expr], k: String) : Option[RsBad] = match es {
  [] -> None
  [x, ...rest] -> match rs_unsplittable(x, k) {
    Some(b) -> Some(b)
    None    -> rs_unsplittable_in(rest, k)
  }
}


pub(pkg) fn rs_is_loop_callee(f: Expr) : Bool = match f.kind {
  EName(n)       -> rs_is_loop_name(written_text(n))
  EModCall(q, n) -> home_is(written_text(q), CmLoop) and rs_is_loop_name(written_text(n))
  EField(b, n)   -> match b.kind { EName(q) -> written_text(q) == "loop" and rs_is_loop_name(n)  _ -> false }
  _              -> false
}

fn rs_is_loop_name(n: String) : Bool = n == "while" or n == "until" or n == "repeat"

# Unlike `rs_find_k`, sees through lambdas and nested handles, down to a
# binder that rebinds `k`.
fn rs_deep_k(e: Expr, k: String) : Option[Expr] =
  if rs_is_k_call(e, k) { Some(e) }
  else { match e.kind {
    ELambda(ps, b) -> if any(ps, (p) => written_text(p.binder.name) == k) { None } else { rs_deep_k(b, k) }
    EHandle(body, _, _, init, _, cs, ret) ->
      rs_deep_k_in([body, ...opt_list(init), ...rs_clauses_keeping(cs, k), ...opt_list(ret_body(ret))], k)
    _ -> rs_deep_k_in(rs_children(e), k)
  } }

fn rs_clauses_keeping(cs: [HClause], k: String) : [Expr] = match cs {
  [] -> []
  [HC(_, ps, b, _, _), ...rest] ->
    if any(ps, (p) => written_text(p.binder.name) == k) { rs_clauses_keeping(rest, k) } else { [b, ...rs_clauses_keeping(rest, k)] }
}

fn rs_deep_k_in(es: [Expr], k: String) : Option[Expr] = match es {
  [] -> None
  [x, ...rest] -> match rs_deep_k(x, k) {
    Some(hit) -> Some(hit)
    None      -> rs_deep_k_in(rest, k)
  }
}

pub(pkg) fn rs_clauses_push_frames(cs: [HClause]) : Bool = any(cs, (c) => rs_pushes_frame(clause_body(c)))

# A nested handle's frames are its own; a lambda never pushes one.
fn rs_pushes_frame(e: Expr) : Bool = match e.kind {
  EIntrinsic(InResumeFrame, _) -> true
  EIntrinsic(_, xs) -> any(xs, rs_pushes_frame)
  EHandle(_, _, _, _, _, _, _) -> false
  ELambda(_, _) -> false
  _ -> any(rs_children(e), rs_pushes_frame)
}

pub(pkg) fn rs_all_tail(e: Expr, k: String) : Bool =
  if not rs_has_k(e, k) { true }
  else if rs_is_k_call(e, k) { not rs_has_k_in(rs_children(e), k) }
  else { match e.kind {
    EBlock(ss, tail) -> not rs_stmts_have_k(ss, k) and opt_all_tail(tail, k)
    EIf(c, t, eo) -> not rs_has_k(c, k) and rs_all_tail(t, k) and opt_all_tail(eo, k)
    EMatch(scr, arms) -> not rs_has_k(scr, k) and all(arms, (a) => arm_all_tail(a, k))
    _ -> false
  } }

fn rs_has_k_in(es: [Expr], k: String) : Bool = match rs_find_k_in(es, k) {
  Some(_) -> true
  None    -> false
}

fn opt_all_tail(o: Option[Expr], k: String) : Bool = match o {
  Some(x) -> rs_all_tail(x, k)
  None    -> true
}

fn arm_all_tail(a: Arm, k: String) : Bool = match a {
  Arm(_, Some(g), b) -> not rs_has_k(g, k) and rs_all_tail(b, k)
  Arm(_, None, b)    -> rs_all_tail(b, k)
}

# --- diagnostics ----------------------------------------------------------

pub(pkg) fn rs_twice(at: Expr) : RsBad =
  RsBad(twice_message(), "the continuation is one-shot", rs_at(at).line, rs_at(at).col)

fn twice_message() : String = "`resume` may be called twice on one path"

pub(pkg) fn rs_is_twice(b: RsBad) : Bool = match b { RsBad(m, _, _, _) -> m == twice_message() }

pub(pkg) fn rs_in_guard(at: Expr) : RsBad =
  RsBad("`resume` is called in a match guard", "resume in the arm's body instead", rs_at(at).line, rs_at(at).col)

pub(pkg) fn rs_unsplittable_at(at: Expr) : RsBad =
  RsBad("`resume` is called where the clause cannot be split", "bind its result with `let` first", rs_at(at).line, rs_at(at).col)

pub(pkg) fn rs_var_after(v: Expr) : RsBad = {
  let name = match v.kind {
    EName(n) -> string_concat(string_concat("`", written_text(n)), "`")
    _       -> "a name"
  }
  RsBad(string_concat(name, " is a `var` of the clause, read after a non-tail `resume`"),
        "the code after `resume` runs when the handle exits, outside the var's block; read it into a `let` before resuming",
        v.line, v.col)
}

pub(pkg) fn rs_default_nontail(l: Int, c: Int) : RsBad =
  RsBad("a default handler's clause must call `resume` in tail position",
        "a default handler has no `handle` exit to run the code after `resume` at", l, c)

pub(pkg) fn rs_bad_marker(b: RsBad) : Expr = match b {
  RsBad(msg, help, l, c) -> mk_expr(EIntrinsic(InResumeBad, [rs_quoted(msg, l, c), rs_quoted(help, l, c)]), l, c)
}

fn rs_quoted(s: String, l: Int, c: Int) : Expr = mk_expr(EStr(string_concat(string_concat("\"", s), "\""), false), l, c)

#[doc("A node with its resuming operand bound in a block, and the next fresh-name counter.")]
pub type Anf = { e: Expr, n: Int }

pub(pkg) fn anf_resuming_operand(e: Expr, k: String, n: Int) : Option[Anf] = bind_picked(e, (x) => rs_has_k(x, k), false, Fresh { prefix: "__resume_v", minted: false }, n)

pub(pkg) fn anf_bind_until(e: Expr, pick: (Expr) -> Bool, prefix: String, n: Int) : Option[Anf] = bind_picked(e, pick, true, Fresh { prefix: prefix, minted: true }, n)

# How a fresh binder is made: written, for the resolver to number, or
# minted, in a body it has already numbered.
type Fresh = { prefix: String, minted: Bool }

fn bind_picked(e: Expr, pick: (Expr) -> Bool, last: Bool, prefix: Fresh, n: Int) : Option[Anf] = match anf_operands_of(e, pick) {
  Some(Ops(xs, rebuild)) -> {
    let h = hoist_until(xs, picked_index(xs, pick, last, 0, 0 - 1), prefix, n, [], [])
    Some(Anf { e: with_kind(e, EBlock(h.lets, Some(with_kind(e, rebuild(h.vals))))), n: h.n })
  }
  None -> None
}

pub(pkg) fn picked_index(xs: [Expr], pick: (Expr) -> Bool, last: Bool, i: Int, found: Int) : Int = match xs {
  [] -> found
  [x, ...rest] ->
    if not pick(x) { picked_index(rest, pick, last, i + 1, found) }
    else if last { picked_index(rest, pick, last, i + 1, i) }
    else { i }
}

type Hoisted = { lets: [Stmt], vals: [Expr], n: Int }

# Operands before the picked one, at `at`, are bound in order so they
# still run first; the picked one is bound last; the rest stay in place.
fn hoist_until(xs: [Expr], at: Int, prefix: Fresh, n: Int, lets: [Stmt], vals: [Expr]) : Hoisted = match xs {
  [] -> Hoisted { lets: list_reverse(lets), vals: list_reverse(vals), n: n }
  [x, ...rest] ->
    if at == 0 {
      let v = fresh(prefix, n)
      Hoisted { lets: list_reverse([let_of(v, x), ...lets]),
                vals: list_append(list_reverse([ref_of(v, x), ...vals]), rest), n: n + 1 }
    } else if anf_is_atom(x) { hoist_until(rest, at - 1, prefix, n, lets, [x, ...vals]) }
    else { hoist_until(rest, at - 1, prefix, n + 1, [let_of(fresh(prefix, n), x), ...lets], [ref_of(fresh(prefix, n), x), ...vals]) }
}

fn fresh(f: Fresh, n: Int) : Binder = {
  let key = string_concat(f.prefix, int_to_string(n))
  if f.minted { binder_minted(key) } else { binder_written(key) }
}

fn let_of(v: Binder, x: Expr) : Stmt = SLet(Pattern { pkind: PBind(v), line: x.line, col: x.col }, None, x)

# The read keeps the operand's type, so a pass after the typer sees it typed.
fn ref_of(v: Binder, x: Expr) : Expr = {
  let kind = if local_is_minted(v.id) { ELocal(v.id) } else { EName(v.name) }
  Expr { kind: kind, line: x.line, col: x.col, ty: x.ty, mode: x.mode,  site: x.site }
}
