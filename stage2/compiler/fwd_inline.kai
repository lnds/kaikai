# compiler/fwd_inline.kai — trivial-forwarder inlining.
#
# A module export whose body only forwards its params, in order, to a
# runtime primitive — `pub fn push(v, x) = vec_push(v, x)` — hides the
# primitive behind a call frame and a boxing boundary, so every
# downstream analysis keyed on the primitive's call shape (raw element
# fusion, borrow reads, consumer linearity) misses the module spelling
# and the qualified surface silently costs more than the builtin one.
# This pass rewrites each saturated call to such a forwarder, found by
# its id, into the direct primitive call.
#
# Runs post-typer (Expr.ty stamped, protocol calls resolved), pre-
# monomorph, on both backends. Soundness fences:
#   - the forwarder body is exactly `prim(p1, …, pn)`: its own params,
#     in order, each exactly once, no borrowed (`^`) param;
#   - the callee is a runtime primitive: a core builtin's row (a bare
#     name is a local, never one);
#   - the forwarder declares no effect row;
#   - only saturated `ECall` sites rewrite — a forwarder passed as a
#     value keeps the wrapper fn.

import compiler.ast
import compiler.desugar
import compiler.infer
import compiler.call_site_target
import compiler.sym_read
import compiler.symtab
import compiler.core_syms

# One inlinable forwarder: its id, the primitive's callee as its body
# spells it, arity.
type FwdEntry = FW(SymId, ExprKind, Int)

#[doc("Rewrites every saturated qualified call to a trivial forwarder (a pub module fn whose body just forwards its params, in order, to a runtime primitive) into the direct primitive call, so the module surface hits the same fused/raw paths as the builtin spelling.")]
pub fn inline_trivial_forwarders(typed: TypedProgram, tab: SymTab) : TypedProgram = {
  let fwds = fwd_collect(typed.decls, tab, [])
  match fwds {
    [] -> typed
    _  -> TypedProgram {
      decls: map(typed.decls, (d) => fwd_rw_decl(d, fwds)),
      errs: typed.errs,
      insts: typed.insts,
      holes: typed.holes,
      row_holes: typed.row_holes,
      core_len: typed.core_len,
      toplevel_len: typed.toplevel_len,
      module_doc: typed.module_doc,
      diags: typed.diags,
      op_res: typed.op_res
    }
  }
}

fn fwd_collect(decls: [Decl], tab: SymTab, acc: [FwdEntry]) : [FwdEntry] = match decls {
  []           -> acc
  [d, ...rest] -> fwd_collect(rest, tab, fwd_add(d, tab, acc))
}

fn fwd_add(d: Decl, tab: SymTab, acc: [FwdEntry]) : [FwdEntry] = match d {
  DFn(is_pub, _, _, params, _, row, body, _, _, mo, fsym) -> match mo {
    Some(_) ->
      if is_pub and fwd_row_is_empty(row) {
        match fwd_prim_of(tab, params, body) {
          Some(prim) -> [FW(fnid_sym(fsym), prim, list_length(params)), ...acc]
          None       -> acc
        }
      } else { acc }
    None -> acc
  }
  _ -> acc
}

fn fwd_row_is_empty(row: RowExpr) : Bool = match row {
  REmpty -> true
  _      -> false
}

# The primitive's callee when `body` is exactly `prim(p1, …, pn)` over
# `params` in declaration order and `prim` is a core builtin's row.
fn fwd_prim_of(tab: SymTab, params: [Param], body: Expr) : Option[ExprKind] = match body.kind {
  ECall(callee, args_) ->
    if fwd_is_prim(tab, callee.kind) and fwd_args_are_params(params, args_) { Some(callee.kind) }
    else { None }
  _ -> None
}

fn fwd_is_prim(tab: SymTab, k: ExprKind) : Bool = match k {
  # A unit coercion is no call at run time: nothing to forward to.
  ESym(s, _, _) -> sym_is_builtin(tab, s) and not sym_is_unit_coercion(s)
  _             -> false
}

fn fwd_args_are_params(params: [Param], args_: [Expr]) : Bool = match params {
  [] -> match args_ { [] -> true _ -> false }
  [p, ...prest] -> match args_ {
    []            -> false
    [a, ...arest] -> match sym_local_kind(a.kind) {
      EName(nm) -> nm == p.pname and not p.pborrow and fwd_args_are_params(prest, arest)
      _        -> false
    }
  }
}

fn fwd_rw_decl(d: Decl, fwds: [FwdEntry]) : Decl = match d {
  DFn(is_pub, n, tps, ps, ret, row, body, l, c, mo, fsym) ->
    DFn(is_pub, n, tps, ps, ret, row, fwd_rw_expr(body, fwds), l, c, mo, fsym)
  DTest(desc, body, l, c, mo)      -> DTest(desc, fwd_rw_expr(body, fwds), l, c, mo)
  DBench(desc, body, l, c, mo)     -> DBench(desc, fwd_rw_expr(body, fwds), l, c, mo)
  DCheck(desc, ps, body, l, c, mo) -> DCheck(desc, ps, fwd_rw_expr(body, fwds), l, c, mo)
  _ -> d
}

fn fwd_rw_expr(e: Expr, fwds: [FwdEntry]) : Expr = {
  let k = match fwd_try_call(e.kind, fwds) {
    Some(hit) -> hit
    None      -> dsg_map_expr_kind(e.kind, (sub) => fwd_rw_expr(sub, fwds))
  }
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
}

# A call whose callee is a collected forwarder at matching arity → the
# direct primitive call. Args recurse either way.
fn fwd_try_call(k: ExprKind, fwds: [FwdEntry]) : Option[ExprKind] = match k {
  ECall(callee, args_) -> match fwd_callee_prim(callee, fwds, list_length(args_)) {
    Some(prim) -> Some(ECall(
      Expr { kind: prim, line: callee.line, col: callee.col,
             ty: callee.ty, mode: callee.mode,  site: callee.site },
      map(args_, (a) => fwd_rw_expr(a, fwds))))
    None -> None
  }
  _ -> None
}

# A specialisation is not the forwarder its template is.
fn fwd_callee_prim(callee: Expr, fwds: [FwdEntry], arity: Int) : Option[ExprKind] = match callee_fnid(callee) {
  Some(f) -> if fnid_inst(f) == spec_none() { fwd_lookup_sym(fwds, fnid_sym(f), arity) } else { None }
  None    -> None
}

fn fwd_lookup_sym(fwds: [FwdEntry], s: SymId, arity: Int) : Option[ExprKind] = match fwds {
  []           -> None
  [e, ...rest] -> match e {
    FW(id, prim, a) ->
      if sym_raw(id) == sym_raw(s) and a == arity { Some(prim) } else { fwd_lookup_sym(rest, s, arity) }
  }
}
