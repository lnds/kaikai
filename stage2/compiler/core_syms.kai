#[doc("""
Identity for what the core gives every program without a declaration.

A runtime builtin has no `fn` in any module, so no walk over
declarations finds it. Each still gets a row of its own, homed at the
reserved core home under the `NCBuiltin` class: a reference the resolver
leaves to the core carries that id, and a pass below asks the table what
it holds instead of comparing the name against a list.

The class keeps a builtin out of the function namespace. A module that
declares `fn print` competes with nothing: the ladder climbs the modules
a file sees, and the builtin answers only when none of them does.
""")]

import compiler.ast
import compiler.decl_names
import compiler.symtab
import compiler.symtab_build
import compiler.core_prims
import compiler.native_prims
import compiler.builtin_types
import compiler.builtins

#[doc("The id of the core builtin named `name`.")]
pub fn builtin_sym(name: String) : SymId = sym_derive(NCBuiltin, name, core_type_home())

#[doc("One entry per core builtin: every row of the builtin table, each `_borrow` sibling, and the native primitives.")]
pub fn core_entries() : [NEnt] =
  list_append(map(core_ctor_names(), (n) => NEnt(NCCtor, n, core_type_home(), true)),
              map(list_append(core_table_names(builtin_table()), native_prim_names()),
                  (n) => NEnt(NCBuiltin, n, core_type_home(), true)))

# The constructors of the types no declaration spells.
fn core_ctor_names() : [String] = ["Some", "None", "Ok", "Err"]

fn core_table_names(bs: [Builtin]) : [String] = match bs {
  [] -> []
  [BF(name, _, _), ...rest] -> match core_borrow_variant(name) {
    Some(b) -> [name, b, ...core_table_names(rest)]
    None    -> [name, ...core_table_names(rest)]
  }
}

#[doc("The symbol table for the entries `rows` of a program, with the core builtins declared too.")]
pub fn st_program(rows: [NEnt]) : SymTab =
  st_of_entries(list_append(core_entries(), rows))

#[doc("True when `s` is a core builtin's row in `t`.")]
pub fn sym_is_builtin(t: SymTab, s: SymId) : Bool = match sym_class(t, s) {
  NCBuiltin -> st_valid(t, s)
  _         -> false
}

#[doc("A unit coercion: the identity at run time, a change of dimension to the typer.")]
pub type UnitCoercion = UcStrip | UcAttach | UcDetach

#[doc("The builtin a unit coercion is spelled as.")]
pub fn unit_coercion_name(u: UnitCoercion) : String = match u {
  UcStrip  -> "__strip_unit"
  UcAttach -> "__attach_unit"
  UcDetach -> "__detach_unit"
}

#[doc("The unit coercion `s` is the row of, or `None` for any other symbol.")]
pub fn unit_coercion_of(s: SymId) : Option[UnitCoercion] =
  if sym_raw(s) < 0 { None }
  else if cs_is(s, UcStrip) { Some(UcStrip) }
  else if cs_is(s, UcAttach) { Some(UcAttach) }
  else if cs_is(s, UcDetach) { Some(UcDetach) }
  else { None }

#[doc("True when `s` is the row of a unit coercion.")]
pub fn sym_is_unit_coercion(s: SymId) : Bool = match unit_coercion_of(s) {
  Some(_) -> true
  None    -> false
}

fn cs_is(s: SymId, u: UnitCoercion) : Bool = sym_raw(s) == sym_raw(builtin_sym(unit_coercion_name(u)))
