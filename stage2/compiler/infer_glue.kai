#[doc("Small typer helpers shared by the infer modules: AST maps, type equality and mangling, last-use lookup.")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.pipe_fusion
import compiler.infer_index
import compiler.enc_unit
import compiler.unit_walk
import compiler.type_home
import compiler.desugar_record_lit

#[doc("Typer-internal helper `inf_collect_op_to_eff` shared across the infer modules.")]
pub fn inf_collect_op_to_eff(decls: [Decl]) : [OpToEff] {
  match decls {
    [] -> []
    [d, ...rest] -> match d {
      DEffect(_, esym, _, ops, _, _, _, _) ->
        list_append(inf_ops_to_eff_pairs(esym, ops),
                    inf_collect_op_to_eff(rest))
      _ -> inf_collect_op_to_eff(rest)
    }
  }
}


fn inf_indent_of(depth: Int) : String {
  if depth == 0 { "" } else { string_concat("  ", inf_indent_of(depth - 1)) }
}


#[doc("infer: print one indented line of a typed-AST dump.")]
pub fn inf_emit_line(depth: Int, s: String) : Unit / Console = print("#{inf_indent_of(depth)}#{s}")


#[doc("infer: join strings with a separator, the typer-side alias of `string_join`.")]
pub fn inf_join_with(xs: [String], sep: String) : String = string_join(xs, sep)


#[doc("infer: last-use position of a binder across a use list.")]
pub fn inf_last_use_for(nm: LocalId, uses: [Use]) : LU =
  inf_last_use_for_loop(nm, uses, false, -1, -1)


fn inf_last_use_for_loop(nm: LocalId, uses: [Use], blocked: Bool,
                         mx_line: Int, mx_col: Int) : LU =
  match uses {
    [] ->
      if blocked { LUBlocked(nm) }
      else if mx_line < 0 { LUUnused(nm) }
      else { LUAt(nm, mx_line, mx_col) }
    [U(uname, ln, cl, in_lam), ...rest] ->
      if not local_eq(uname, nm) { inf_last_use_for_loop(nm, rest, blocked, mx_line, mx_col) }
      else if in_lam { inf_last_use_for_loop(nm, rest, true, mx_line, mx_col) }
      else if ln > mx_line or (ln == mx_line and cl > mx_col) { inf_last_use_for_loop(nm, rest, blocked, ln, cl) }
      else { inf_last_use_for_loop(nm, rest, blocked, mx_line, mx_col) }
  }


fn inf_mangle_ty(tab: SymTab, t: Ty) : String {
  match t {
    TyInt    -> "Int"
    TyReal   -> "Real"
    TyBool   -> "Bool"
    TyString -> "String"
    TyChar   -> "Char"
    TyUnit   -> "Unit"
    TyByte     -> "Byte"
    TyInt32    -> "Int32"
    TyUInt32   -> "UInt32"
    TyUInt64   -> "UInt64"
    TyInt128   -> "Int128"
    TyHandle   -> "Handle"
    TyListT(inner) -> concat_all(["L_", inf_mangle_ty(tab, inner), "_E"])
    TyFnT(ps, ret, _) -> concat_all([
      "F_", inf_join_with(map(ps, (p) => inf_mangle_ty(tab, p)), "_"),
      "_R_", inf_mangle_ty(tab, ret), "_E"
    ])
    TyCon(csym, tas) -> {
      let cname = written_text(decl_name(tab, csym))
      match tas {
        [] -> cname
        [_h, ..._rest] -> concat_all([cname, "_O_",
                                    inf_join_with(map(tas, (a) => inf_mangle_ty(tab, a)), "_"),
                                    "_C"])
      }
    }
    TyVarT(_) -> "TVAR"
    # a resolved shape app is erased to its constructor before mangling;
    # an unresolved one signals a bug, flagged like `TVAR`.
    TyShapeApp(_, arg) -> concat_all(["SVAR_", inf_mangle_ty(tab, arg)])
    TyAny     -> "Any"
    # units are erased at codegen time. The mangled name for a
    # dimensioned type is the same as its base type's mangle — so a
    # call like `f(1.0<USD>)` and a call `f(1.0)` mangle into the same
    # specialisation. This is the codegen-erasure invariant manifest
    # at the mangler level.
    TyDimT(base, _) -> inf_mangle_ty(tab, base)
    # refinements erase like units. `Int where >= 0` and
    # `Int` mangle the same — they share monomorphisations and
    # protocol-impl dispatch entries.
    TyRefineT(base, _) -> inf_mangle_ty(tab, base)
    # mangle a union as `U_<part1>_<part2>_..._E`
    # using the canonical component order. The leading `U_` and
    # trailing `_E` bracket the spec the same way `L_..._E` brackets
    # a list, so distinct unions never collide with each other or
    # with primitive mangles even when their component manglings
    # rearrange. The arm keeps the walker exhaustive without `_`
    # fallbacks that would mask future bugs.
    TyUnion(parts) -> concat_all(["U_",
                                  inf_join_with(map(parts, (p) => inf_mangle_ty(tab, p)), "_"),
                                  "_E"])
  }
}


# The primitive constructors, listed so every consumer of "which type
# names does the language own" reads one source. Adding a primitive to
# `Ty` without extending this list leaves the name redeclarable.
fn inf_primitive_tys() : [Ty] =
  [TyInt, TyReal, TyBool, TyString, TyChar, TyUnit, TyByte,
   TyInt32, TyUInt32, TyUInt64, TyInt128, TyHandle]


#[doc("The type names the language reserves for its primitives.")]
pub fn primitive_type_names() : [String] =
  map(inf_primitive_tys(), (t) => inf_mangle_ty(st_empty(), t))


fn inf_map_arm_exprs(a: Arm, f: (Expr) -> Expr) : Arm {
  match a {
    Arm(p, g, b) -> Arm(p, inf_map_opt_expr(g, f), f(b))
  }
}


fn inf_map_clause_exprs(c: HClause, f: (Expr) -> Expr) : HClause {
  match c {
    HC(n, ps, b, l, co) -> HC(n, ps, f(b), l, co)
  }
}


fn inf_map_elem_exprs(el: ListElem, f: (Expr) -> Expr) : ListElem {
  match el {
    ElPlain(x)  -> ElPlain(f(x))
    ElSpread(x) -> ElSpread(f(x))
  }
}


#[doc("Typer-internal helper `inf_map_expr_kind` shared across the infer modules.")]
pub fn inf_map_expr_kind(k: ExprKind, f: (Expr) -> Expr) : ExprKind {
  match k {
    # Leaves: no sub-Expr to recurse into.
    EInt(_, _)        -> k
    EReal(_, _)       -> k
    EIntLit(_)        -> k
    EDecimalLit(_)    -> k
    EFixed(_, _)      -> k
    EBool(_)       -> k
    EChar(_)       -> k
    EStr(_, _)     -> k
    EUnit          -> k
    EName(_)        -> k
    EMark(_)        -> k
    ESym(_, _)     -> k
    ELocal(_)      -> k
    EOp(_)         -> k
    EUnder         -> k
    EPlaceholder   -> k
    EHole(_)       -> k
    ETodo(_)       -> k
    EExternBody(_, _) -> k
    # `EVariantsOf(TypeExpr, [SymId])` carries no sub-Expr (only a
    # TypeExpr and the constructor ids, neither of which the
    # visitor traverses). Same shape as EHole/ETodo for the
    # purposes of the structural recursion.
    EVariantsOf(_, _) -> k
    # qualified module call carries no sub-Exprs, so `f` has nothing to apply.
    EModCall(_, _) -> k
    # intrinsic args ARE sub-Exprs, so the visitor recurs.
    EIntrinsic(name, args_) -> EIntrinsic(name, map(args_, f))
    ESurface(sf) -> ESurface(surface_map(sf, f))
    # Composites: apply f to every direct sub-Expr.
    ECall(callee, args_) -> ECall(f(callee), map(args_, f))
    EField(base, name)   -> EField(f(base), name)
    EIndex(a, b)         -> EIndex(f(a), f(b))
    EBinop(op, a, b)     -> EBinop(op, f(a), f(b))
    EUnop(op, x)         -> EUnop(op, f(x))
    EIf(c, t_, eo)       -> EIf(f(c), f(t_), inf_map_opt_expr(eo, f))
    EMatch(scr, arms)    -> EMatch(f(scr), map(arms, (a) => inf_map_arm_exprs(a, f)))
    ELambda(ps, b)       -> ELambda(ps, f(b))
    ERecordLit(rh, fs) -> ERecordLit(rh, map(fs, (fi) => inf_map_field_exprs(fi, f)))
    EList(els)           -> EList(map(els, (el) => inf_map_elem_exprs(el, f)))
    ERange(a, b, opt_step) -> ERange(f(a), f(b), inf_map_opt_expr(opt_step, f))
    EBlock(stmts, tail)  -> EBlock(map(stmts, (s) => inf_map_stmt_exprs(s, f)),
                                    inf_map_opt_expr(tail, f))
    EPipe(a, b)          -> EPipe(f(a), f(b))
    EDispatchPipe(op, a, b) -> EDispatchPipe(op, f(a), f(b))
    EHandle(body, eff, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) ->
      EHandle(f(body), eff, eff_tyargs,
              inf_map_opt_expr(init_opt, f), alias_opt,
              map(clauses, (c) => inf_map_clause_exprs(c, f)),
              inf_map_opt_return_exprs(ret_opt, f))
    ELitUnit(inner, u)   -> ELitUnit(f(inner), u)
    EBang(inner)         -> EBang(f(inner))
  }
}


fn inf_map_field_exprs(fi: FieldInit, f: (Expr) -> Expr) : FieldInit {
  match fi {
    FI(n, v) -> FI(n, f(v))
  }
}


#[doc("Typer-internal helper `inf_map_opt_expr` shared across the infer modules.")]
pub fn inf_map_opt_expr(opt: Option[Expr], f: (Expr) -> Expr) : Option[Expr] {
  match opt {
    Some(e) -> Some(f(e))
    None    -> None
  }
}


fn inf_map_opt_return_exprs(opt: Option[HReturn], f: (Expr) -> Expr) : Option[HReturn] {
  match opt {
    Some(r) -> Some(inf_map_return_exprs(r, f))
    None    -> None
  }
}


fn inf_map_return_exprs(r: HReturn, f: (Expr) -> Expr) : HReturn {
  match r {
    HR(p, b, l, c) -> HR(p, f(b), l, c)
  }
}


fn inf_map_stmt_exprs(s: Stmt, f: (Expr) -> Expr) : Stmt {
  match s {
    SLet(p, ann, rhs)           -> SLet(p, ann, f(rhs))
    SAssert(c, m)               -> SAssert(f(c), inf_map_opt_expr(m, f))
    SExprStmt(x)                -> SExprStmt(f(x))
    SIndexAssign(b, i, v, l, c) -> SIndexAssign(f(b), f(i), f(v), l, c)
    SAssign(b, v, l, c) -> SAssign(f(b), f(v), l, c)
    SVar(n, ty, rhs, l, c)      -> SVar(n, ty, f(rhs), l, c)
    # SUse has no sub-expression — pass through unchanged.
    SUse(n, l, c)               -> SUse(n, l, c)
  }
}


fn inf_ops_to_eff_pairs(eff: SymId, ops: [EffectOp]) : [OpToEff] {
  match ops {
    [] -> []
    [op, ...rest] -> match op {
      EffOp(op_name, _, _, _, _, _) ->
        [OEFP(written(op_name), eff), ...inf_ops_to_eff_pairs(eff, rest)]
    }
  }
}


#[doc("Typer-internal helper `inf_proto_dispatch_tag_prefix` shared across the infer modules.")]
pub fn inf_proto_dispatch_tag_prefix() : String = "__kai_proto_dispatch__:"


#[doc("Typer-internal helper `inf_proto_dispatcher_name` shared across the infer modules.")]
pub fn inf_proto_dispatcher_name(op: String) : String = concat_all(["__proto_", op])


# The name a type reference still spells: a type parameter, a scalar, a
# type nothing settled. A settled reference spells none.
#[doc("Typer-internal helper `ref_name` shared across the infer modules.")]
pub fn ref_name(r: DeclRef) : String = match r {
  DrWritten(_, w) -> written_text(w)
  DrSym(_)        -> ""
}


#[doc("Typer-internal helper `ref_is_cont` shared across the infer modules.")]
pub fn ref_is_cont(r: DeclRef) : Bool = core_ty_is(ref_sym(r), CtCont) or is_cont_name(ref_name(r))


# The declaration a type reference names from `hv`: its own once
# settled, the reader's ladder while it is written.
#[doc("Typer-internal helper `te_ref_sym` shared across the infer modules.")]
pub fn te_ref_sym(hv: TyHomeView, r: DeclRef) : SymId = match r {
  DrSym(s)        -> s
  DrWritten(_, w) -> tsh_sym(hv, written_text(w))
}


#[doc("Typer-internal helper `inf_row_empty` shared across the infer modules.")]
pub fn inf_row_empty() : Row = Row {
  labels:        [],
  tail:          None,
  display_alias: None
}


# The label a written row names: the effect and its type arguments.
#[doc("Typer-internal helper `row_label` shared across the infer modules.")]
pub fn row_label(eff: SymId, ty_args: [Ty]) : Label = Label { sym: eff, ty_args: ty_args, cell: local_none() }


#[doc("Typer-internal helper `inf_rvbind_lookup` shared across the infer modules.")]
pub fn inf_rvbind_lookup(binds: [RVBind], id: TLocalId) : Option[Int] {
  match binds {
    [] -> None
    [b, ...rest] -> match b {
      RVB(n, i) -> if tlocal_eq(n, id) { Some(i) } else { inf_rvbind_lookup(rest, id) }
    }
  }
}


fn inf_starts_with_loop(s: String, prefix: String, i: Int) : Bool {
  let pn = string_length(prefix)
  if i >= pn { true }
  else { match char_at(s, i) {
    None -> false
    Some(sc) -> match char_at(prefix, i) {
      None -> true
      Some(pc) -> if sc == pc { inf_starts_with_loop(s, prefix, i + 1) } else { false }
    }
  } }
}


#[doc("Typer-internal helper `inf_string_starts_with_q` shared across the infer modules.")]
pub fn inf_string_starts_with_q(s: String, prefix: String) : Bool =
  inf_starts_with_loop(s, prefix, 0)


#[doc("True for a type variable or `Any`: a type that adopts whatever it meets.")]
pub fn ty_is_flexible(t: Ty) : Bool = match t {
  TyVarT(_) -> true
  TyAny -> true
  _ -> false
}

#[doc("Each primitive scalar type has its own rank; every other type is -1.")]
pub fn scalar_rank(t: Ty) : Int = match t {
  TyInt -> 0
  TyReal -> 1
  TyBool -> 2
  TyString -> 3
  TyChar -> 4
  TyUnit -> 5
  TyByte -> 6
  TyInt32 -> 7
  TyUInt32 -> 8
  TyUInt64 -> 9
  TyInt128 -> 10
  TyHandle -> 11
  _ -> -1
}

#[doc("Structural equality on resolved types; refinements and units compare by their base.")]
pub fn inf_ty_eq(a: Ty, b: Ty) : Bool = match (a, b) {
  (TyVarT(x), TyVarT(y)) -> x == y
  (TyListT(x), TyListT(y)) -> inf_ty_eq(x, y)
  (TyFnT(aps, ar, _), TyFnT(bps, br, _)) -> inf_ty_list_eq(aps, bps) and inf_ty_eq(ar, br)
  (TyCon(sa, aa), TyCon(sb, ba)) -> sym_same(sa, sb) and inf_ty_list_eq(aa, ba)
  (TyDimT(x, _), TyDimT(y, _)) -> inf_ty_eq(x, y)
  (TyRefineT(x, _), TyRefineT(y, _)) -> inf_ty_eq(x, y)
  (TyShapeApp(asv, x), TyShapeApp(bsv, y)) -> asv == bsv and inf_ty_eq(x, y)
  (TyUnion(x), TyUnion(y)) -> inf_ty_list_eq(x, y)
  (TyAny, TyAny) -> true
  _ -> scalar_rank(a) >= 0 and scalar_rank(a) == scalar_rank(b)
}


# A lone named parameter the body calls a method on needs its type before
# the body is walked; any other keeps the parameter open, so a stage that
# takes the whole container still reaches the `|>` hint.
#[doc("Typer-internal helper `stage_param_is_receiver` shared across the infer modules.")]
pub fn stage_param_is_receiver(ps: [Param], body: Expr) : Bool = match ps {
  [p] -> stage_receiver_of(p.binder.id, body)
  _   -> false
}


#[doc("Typer-internal helper `inf_ty_head_name` shared across the infer modules.")]
pub fn inf_ty_head_name(tab: SymTab, t: Ty) : Option[String] {
  match t {
    TyInt          -> Some("Int")
    TyReal         -> Some("Real")
    TyBool         -> Some("Bool")
    TyChar         -> Some("Char")
    TyString       -> Some("String")
    TyUnit         -> Some("Unit")
    TyByte           -> Some("Byte")
    TyInt32          -> Some("Int32")
    TyUInt32         -> Some("UInt32")
    TyUInt64         -> Some("UInt64")
    TyInt128         -> Some("Int128")
    TyHandle         -> Some("Handle")
    TyListT(_)     -> Some("List")
    TyCon(s, _) -> Some(written_text(decl_name(tab, s)))
    # a dimensioned value dispatches on the underlying base
    # type's head — `Decimal<USD>` → `Decimal`, mirroring the
    # `proto_type_name` collapse on the syntactic side.
    TyDimT(base, _) -> inf_ty_head_name(tab, base)
    # refinements are transparent for protocol dispatch
    # — `Int where >= 0` and `Int` resolve to the same `impl`.
    TyRefineT(base, _) -> inf_ty_head_name(tab, base)
    TyVarT(_)      -> None
    # an unresolved shape app has no concrete head — dispatch is post-mono.
    TyShapeApp(_, _) -> None
    TyFnT(_, _, _) -> None
    TyAny          -> None
    # a union has no single head type, so
    # protocol dispatch declines — the resolver forbids
    # `impl P for Union` declarations; here we just signal
    # "no canonical head" the same way TyVarT does so callers fall
    # back to the diagnostic path.
    TyUnion(_)     -> None
  }
}


fn inf_ty_list_eq(a: [Ty], b: [Ty]) : Bool =
  match a {
    [] -> match b { [] -> true _ -> false }
    [ah, ...arest] -> match b {
      [] -> false
      [bh, ...brest] -> if inf_ty_eq(ah, bh) { inf_ty_list_eq(arest, brest) } else { false }
    }
  }


# Recognise the row-arg carrier (`TyFnT([], TyUnit, row)`) a `TyCon`
# slot uses to thread an effect row, so diagnostics show the slot as the
# row itself (`Stream[String, File + ReadFault]`) rather than the carrier
# function (`Stream[String, () -> Unit / File + ReadFault]`).
#[doc("Typer-internal helper `inf_row_carrier_of` shared across the infer modules.")]
pub fn inf_row_carrier_of(t: Ty) : Option[Row] = match t {
  TyFnT(ps, ret, row) -> match ps {
    [] -> match ret { TyUnit -> Some(row) _ -> None }
    _  -> None
  }
  _ -> None
}


#[doc("infer: `OpToEff` — typer/effect support type.")]
#[derive(BinSerialize)]
pub type OpToEff = OEFP(Written, SymId)


#[doc("infer: `label_to_rl_zero` — typer/effect support type.")]
pub fn label_to_rl_zero(lab: Label) : RowLabel = RL(DrSym(lab.sym), [])


#[doc("infer: `HandleFrame` — typer/effect support type.")]
pub type HandleFrame = HF(SymId, [String], [String], Int, Int)


#[doc("infer: a record field's declaration, the module declaring its record, and the record's identity.")]
pub type FieldDeclWithHome = FDH(FieldDecl, Option[String], SymId)


#[doc("infer: `Use` — typer/effect support type.")]
pub type Use = U(LocalId, Int, Int, Bool)   # binder, line, col, in_lambda


#[doc("infer: `LU` — typer/effect support type.")]
pub type LU
  = LUAt(LocalId, Int, Int)            # last-use position
  | LUBlocked(LocalId)                 # closure capture blocks last
  | LUUnused(LocalId)                  # never referenced


#[doc("Typer-internal helper `inferred_main_row` shared across the infer modules.")]
pub fn inferred_main_row(performed: [Label]) : RowExpr {
  match performed {
    [] -> REmpty
    _  -> RClosed(map(performed, label_to_rl_zero))
  }
}


# What the field-privacy walk reads: the table that names a record, and
# the reading module's view.
#[doc("Typer-internal type `PrivCx` shared across the infer modules.")]
pub type PrivCx = { tab: SymTab, home: TyHomeView }


#[doc("Typer-internal helper `field_recs_of` shared across the infer modules.")]
pub fn field_recs_of(decls: [Decl]) : FieldRecs = field_recs(list_reverse(decls), idx_empty())


#[doc("Every record declaration under its identity: a field access reads the one declaration its record type names instead of walking the whole program.")]
pub type FieldRecs = NameIndex[FieldRec]


#[doc("One record declaration: its identity, fields and declaring module.")]
pub type FieldRec = FRec(SymId, [FieldDecl], Option[String])


#[doc("Typer-internal helper `field_recs` shared across the infer modules.")]
pub fn field_recs(rev_decls: [Decl], ix: FieldRecs) : FieldRecs = match rev_decls {
  [] -> ix
  [d, ...rest] -> match d {
    DType(_, dsym, _, TBRecord(fields), _, _, decl_mo, _) ->
      field_recs(rest, idx_prepend_sym(ix, dsym, FRec(dsym, fields, decl_mo)))
    _ -> field_recs(rest, ix)
  }
}


# A record type that names no declaration has no field to judge.
#[doc("Typer-internal helper `lookup_record_field` shared across the infer modules.")]
pub fn lookup_record_field(all_decls: FieldRecs, rec_sym: SymId, fname: String)
                         : Option[FieldDeclWithHome] =
  if sym_raw(rec_sym) < 0 { None } else { field_in_recs(idx_chain_sym(all_decls, rec_sym), fname) }


fn field_in_recs(rs: [FieldRec], fname: String) : Option[FieldDeclWithHome] = match rs {
  [] -> None
  [FRec(dsym, fields, decl_mo), ...rest] -> match find_field_in_decls(fields, fname) {
    Some(fd) -> Some(FDH(fd, decl_mo, dsym))
    None     -> field_in_recs(rest, fname)
  }
}


#[doc("Typer-internal helper `find_field_in_decls` shared across the infer modules.")]
pub fn find_field_in_decls(fields: [FieldDecl], target: String) : Option[FieldDecl] =
  match fields {
    []           -> None
    [f, ...rest] -> match f {
      FD(_, n, _, _) -> if n == target { Some(f) } else { find_field_in_decls(rest, target) }
    }
  }


#[doc("Typer-internal helper `record_carrier_of` shared across the infer modules.")]
pub fn record_carrier_of(ty: Option[Ty]) : Option[SymId] =
  match ty {
    None     -> None
    Some(t)  -> record_carrier_t(t)
  }


fn record_carrier_t(t: Ty) : Option[SymId] = match t {
  TyCon(tsym, _) -> Some(tsym)
  TyRefineT(inner, _) -> record_carrier_t(inner)
  TyDimT(inner, _)    -> record_carrier_t(inner)
  _ -> None
}


#[doc("Typer-internal helper `walk_priv_field_inits` shared across the infer modules.")]
pub fn walk_priv_field_inits(file: String, cx: PrivCx,
                           all_decls: FieldRecs, rec_sym: SymId,
                           fis: [FieldInit], line: Int, col: Int,
                           acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match fis {
    []           -> acc
    [FI(fname, _), ...rest] -> {
      let n = match lookup_record_field(all_decls, rec_sym, fname) {
        None -> []
        Some(FDH(fd, decl_mo, dsym)) -> {
          let rec_name = written_text(decl_name(cx.tab, rec_sym))
          if field_hidden(cx.home, rec_name, dsym, fd) {
            let d = priv_construct_diag(file, line, col, fname, rec_name, decl_mo)
            render_diag(d)
            [d]
          } else { [] }
        }
      }
      walk_priv_field_inits(file, cx, all_decls, rec_sym, rest,
                             line, col, list_append(n, acc))
    }
  }
}


