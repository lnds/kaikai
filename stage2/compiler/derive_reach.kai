#[doc("""
How far a derived impl's field type reaches impls of the derived protocol.

A container impl that bounds a type argument by the protocol
(`impl[T : Eq] Eq for [T]`) needs the protocol on that argument too, so a
field of type `[(Int, String)]` needs `Eq` on `List` and on `Pair`. The
walk follows exactly the arguments each impl bounds, and names the first
head it cannot reach together with the heads above it.
""")]

import compiler.modules
import compiler.parse
import compiler.util

#[doc("A type expression as protocol dispatch sees it: each node's head name and its type arguments.")]
pub type HeadTree = HT(String, [HeadTree])

#[doc("An impl of a protocol for a head, keyed `P/Head`, with the positions of the head's type arguments the impl bounds by that protocol.")]
pub type ImplReach = IR(String, [Int])

#[doc("The key naming protocol `pname`'s impl for `head`.")]
pub fn reach_key(pname: String, head: String) : String = concat_all([pname, "/", head])

#[doc("The reach of `impl[tps] pname for target`: the target arguments that are type parameters bounded by `pname`.")]
pub fn impl_reach(pname: String, target: HeadTree, tps: [String]) : ImplReach = match target {
  HT(head, args) -> IR(reach_key(pname, head), bounded_positions(args, bounded_names(tps, pname, []), 0))
}

#[doc("The reach of a derived `pname` on a type with parameters `tps`: the derive bounds every plain parameter.")]
pub fn derived_reach(pname: String, tname: String, tps: [String]) : ImplReach =
  IR(reach_key(pname, tname), plain_positions(tps, 0))

#[doc("The heads from `t` down to the first one with no impl of `pname`; empty when every head the impls reach has one.")]
pub fn missing_path(pname: String, t: HeadTree, reach: [ImplReach], builtin: (String) -> Bool) : [String] =
  match t {
    HT(head, args) ->
      if builtin(head) { [] }
      else { match find_reach(reach, reach_key(pname, head)) {
        None     -> [head]
        Some(ps) -> match first_missing(pname, args, ps, 0, reach, builtin) {
          []    -> []
          below -> [head, ...below]
        }
      } }
  }

#[doc("A missing path spelled as the type it walks: `[List, Pair]` is `List[Pair]`.")]
pub fn path_type(path: [String]) : String = match path {
  []           -> ""
  [h]          -> h
  [h, ...rest] -> concat_all([h, "[", path_type(rest), "]"])
}

fn first_missing(pname: String, args: [HeadTree], ps: [Int], i: Int,
                 reach: [ImplReach], builtin: (String) -> Bool) : [String] = match args {
  []           -> []
  [a, ...rest] -> {
    let here = if list_has_int(ps, i) { missing_path(pname, a, reach, builtin) } else { [] }
    match here {
      [] -> first_missing(pname, rest, ps, i + 1, reach, builtin)
      _  -> here
    }
  }
}

fn find_reach(reach: [ImplReach], key: String) : Option[[Int]] = match reach {
  []           -> None
  [r, ...rest] -> match r {
    IR(k, ps) -> if k == key { Some(ps) } else { find_reach(rest, key) }
  }
}

fn bounded_positions(args: [HeadTree], names: [String], i: Int) : [Int] = match args {
  []           -> []
  [a, ...rest] -> {
    let tail = bounded_positions(rest, names, i + 1)
    match a {
      HT(n, []) -> if list_has(names, n) { [i, ...tail] } else { tail }
      _         -> tail
    }
  }
}

# A stored type parameter is its name, then an optional `#`-introduced
# kind and `#b:`-introduced bound list.
fn bounded_names(tps: [String], pname: String, acc: [String]) : [String] = match tps {
  []            -> acc
  [tp, ...rest] ->
    if list_has(map(tp_bounds_of(tp), dotted_bare), pname) { bounded_names(rest, pname, [tp_name(tp), ...acc]) }
    else { bounded_names(rest, pname, acc) }
}

# Only a plain parameter takes the derive's bound; a kinded one is not a
# value the protocol ranges over.
fn plain_positions(tps: [String], i: Int) : [Int] = match tps {
  []            -> []
  [tp, ...rest] ->
    if string_index_of_char(tp, '#') < 0 { [i, ...plain_positions(rest, i + 1)] }
    else { plain_positions(rest, i + 1) }
}

fn tp_name(tp: String) : String = {
  let i = string_index_of_char(tp, '#')
  if i < 0 { tp } else { string_slice(tp, 0, i) }
}

fn list_has_int(xs: [Int], n: Int) : Bool = match xs {
  []           -> false
  [x, ...rest] -> if x == n { true } else { list_has_int(rest, n) }
}
