#[doc("""
A `Ref` read by its own write hands its value over.

`r := f(a, @r, b)` reads the cell with a reference while the cell keeps its
own, so a callee that needs a unique value (`vec.set`, `vec.push`) copies it
on every write. When nothing evaluated after the read can observe the cell,
the read leaves with the cell's reference (`ref_take`) and the store
(`ref_store`) fills the cell again.

Reading or writing any `Ref` is a `Mutable` op, so code that performs no op
cannot see the cell; with no op in between, no handler, `finally` or
cancellation runs either. The store is lowered with the take because an op's
cancellation poll would otherwise run while the cell holds the placeholder.
The rows read are the call sites' own, before any masking of `Mutable` at a
function boundary.
""")]

import compiler.ast
import compiler.ast_ids
import compiler.core_builtins
import compiler.core_types
import compiler.expr_positions
import compiler.util
import compiler.written

#[doc("`e` as a `ref_store` of the call it stores when it is a `Ref` write whose read can leave with the cell's reference; any other expression unchanged.")]
pub fn take_ref_write(e: Expr) : Expr = match e.kind {
  ECall(setter, [c, v]) -> match rft_ref_local(setter, "ref_set", c) {
    Some(l) -> match rft_take(l, v) {
      Some(v2) -> Expr { ...e, kind: ECall(builtin_ref_at(CbRefStore, setter), [c, v2]) }
      None -> e
    }
    None -> e
  }
  _ -> e
}

# The binder `c` reads when `setter` is the ambient `Mutable` op `name` applied to a local read.
fn rft_ref_local(setter: Expr, name: String, c: Expr) : Option[LocalId] = match setter.kind {
  EOp(r) -> if effect_is(r.eff, CeMutable) and written_text(r.op) == name and rft_ambient(r.via) {
    rft_local(c)
  } else {
    None
  }
  _ -> None
}

fn rft_ambient(v: OpVia) : Bool = match v {
  ViaAmbient -> true
  _ -> false
}

fn rft_local(c: Expr) : Option[LocalId] = match c.kind {
  ELocal(l) -> Some(l)
  _ -> None
}

# `v` with the one read of the cell turned into a take; `None` when `v` is not a call
# whose operands after that read, and the call itself, are free of ops.
fn rft_take(l: LocalId, v: Expr) : Option[Expr] = match v.kind {
  ECall(f, xs) -> if rft_count(l, v) == 1 {
    rft_take_args(l, v, f, [], xs)
  } else {
    None
  }
  _ -> None
}

fn rft_take_args(l: LocalId, v: Expr, f: Expr, before: [Expr], rest: [Expr]) : Option[Expr] =
  match rest {
    [] -> None
    [x, ...after] -> match rft_get(l, x) {
      Some(g) -> if rft_callee_free(f, list_append(before, [x, ...after])) and rft_all_free(after) {
        Some(Expr { ...v, kind: ECall(f, list_append(list_append(before, [rft_take_of(g)]), after)) })
      } else {
        None
      }
      None -> rft_take_args(l, v, f, list_append(before, [x]), after)
    }
  }

# The read itself: a call of `ref_get` on the binder.
fn rft_get(l: LocalId, x: Expr) : Option[Expr] = match x.kind {
  ECall(g, [c]) ->
    and_then(rft_ref_local(g, "ref_get", c), l2 => if local_eq(l, l2) { Some(x) } else { None })
  _ -> None
}

fn rft_take_of(g: Expr) : Expr = match g.kind {
  ECall(callee, xs) -> Expr { ...g, kind: ECall(builtin_ref_at(CbRefTake, callee), xs) }
  _ -> g
}

fn rft_count(l: LocalId, e: Expr) : Int {
  let here = match e.kind {
    ELocal(l2) -> if local_eq(l, l2) { 1 } else { 0 }
    _ -> 0
  }
  foldl(
    xp_positions(e),
    here,
    (acc, p) => match p {
      XP(_, c) -> acc + rft_count(l, c)
    }
  )
}

fn rft_all_free(es: [Expr]) : Bool = match es {
  [] -> true
  [x, ...rest] -> rft_free(x) and rft_all_free(rest)
}

# Evaluating `e` performs no op. A lambda body or handler clause runs only
# when called, and a call's own row says whether it can run an op.
fn rft_free(e: Expr) : Bool = rft_node_free(e) and rft_positions_free(xp_positions(e))

fn rft_node_free(e: Expr) : Bool = match e.kind {
  EOp(_) -> false
  ECall(f, xs) -> rft_callee_free(f, xs)
  _ -> true
}

fn rft_positions_free(ps: [XPos]) : Bool = match ps {
  [] -> true
  [XP(r, c), ...rest] -> rft_role_free(r, c) and rft_positions_free(rest)
}

fn rft_role_free(r: XRole, c: Expr) : Bool = match r {
  XLam -> true
  XCl -> false
  _ -> rft_free(c)
}

# A callee whose type carries an empty row. An open tail is free only for a
# declared function none of whose operands has a function type: the tail then
# is the instantiation's own, never a row variable of the enclosing signature.
fn rft_callee_free(f: Expr, xs: [Expr]) : Bool = match f.kind {
  EOp(_) -> false
  _ -> match f.ty {
    Some(TyFnT(_, _, row)) -> list_is_empty(row.labels) and rft_tail_free(f, row.tail, xs)
    _ -> false
  }
}

fn rft_tail_free(f: Expr, tail: Option[Int], xs: [Expr]) : Bool = match tail {
  None -> true
  Some(_) -> match f.kind {
    ESym(_, _) -> all(xs, x => rft_plain(x.ty))
    _ -> false
  }
}

fn rft_plain(t: Option[Ty]) : Bool = match t {
  Some(ty) -> not rft_has_fn(ty)
  None -> false
}

fn rft_has_fn(t: Ty) : Bool = match t {
  TyFnT(_, _, _) -> true
  TyListT(a) -> rft_has_fn(a)
  TyCon(_, args) -> any(args, rft_has_fn)
  TyDimT(a, _) -> rft_has_fn(a)
  TyRefineT(a, _, _) -> rft_has_fn(a)
  TyUnion(ts) -> any(ts, rft_has_fn)
  TyVarT(_) -> true
  TyAny -> true
  _ -> false
}
