#[doc("""
Per-declaration Perceus: the declaration rewrite, the pass over the program and the capability test it resolves against.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.fnreg
import compiler.ast_map
import compiler.expr_positions
import compiler.perceus_borrow
import compiler.perceus_lend
import compiler.perceus_payer
import compiler.perceus_exit_drops
import compiler.fn_index
import compiler.borrow_infer
import compiler.symtab
import compiler.core_builtins
import compiler.perceus_reads
import compiler.perceus_read_walk
import compiler.trmc_self_call
import compiler.perceus_reuse
import compiler.perceus_arm
import compiler.perceus
import compiler.perceus_linear
import compiler.perceus_take
import compiler.perceus_state
import compiler.scope_view
import compiler.spec_names
import compiler.written

# True iff the fn is a UFn whose EVERY param lowers raw (all mask bits
# true). Only these take the simplified empty-param-scope Perceus path;
# a mixed signature (some boxed param) needs the full borrow/move/exit
# discipline and falls through to the boxed branch.
fn prc_is_all_raw_ufn_decl(fns: FnIndex, fid: FnId) : Bool {
  match fnx_decl_sig(fns, fid) {
    Some(US(_, _, mask)) -> prc_mask_all_true(mask)
    None                 -> false
  }
}

fn prc_mask_all_true(mask: [Bool]) : Bool = match mask {
  []           -> true
  [m, ...rest] -> if m { prc_mask_all_true(rest) } else { false }
}

# All `let`-bound names in a body (PBind SLets), so a locally-built array
# read only through `a[i]` is caught by the borrow-last analysis too.
fn pcs_let_binder_names(e: Expr, acc: [Binder]) : [Binder] = pcs_lbn_kind(e.kind, acc)

# Names of parameters whose declared type is a function type (`(a) -> b`).
# A closure the runtime consumes at call_ind — excluded from the effective
# borrow set until a borrowing call variant exists.
fn pcs_closure_param_names(params: [Param]) : [Binder] = match params {
  []           -> []
  [p, ...rest] ->
    if pcs_param_is_fn_type(p) { [p.binder, ...pcs_closure_param_names(rest)] }
    else { pcs_closure_param_names(rest) }
}

fn pcs_param_is_fn_type(p: Param) : Bool = match p.ptype {
  Some(t) -> match t.tkind { TyFn(_, _, _) -> true _ -> false }
  None    -> false
}

# The borrowed set restricted to function-typed params (the only ones a
# `f(args)` callee can name).
fn pcs_borrowed_closure_names(borrowed: [Binder], params: [Param]) : [Binder] =
  pcs_strs_inter(borrowed, pcs_closure_param_names(params))

fn pcs_params_minus(params: [Param], borrowed: [Binder]) : [Param] = match params {
  []           -> []
  [p, ...rest] ->
    if pcs_has(borrowed, p.binder.id) { pcs_params_minus(rest, borrowed) }
    else { [p, ...pcs_params_minus(rest, borrowed)] }
}

# Issue #817 — the arm-binders whose LAST use lands in a consuming slot,
# safe to move-at-last-use (`pcs_is_non_last` consults this set). For each
# such binder the cons/ctor at its last read takes its birth ref instead
# of a dup, closing the `list.filter`-over-heap leak. Computed here (body
# + cmap + uses in scope) and threaded into the rewrite as `move_last_set`.
# Restricted to binders with >= 2 non-lam uses: a single-use binder
# already transfers raw via the `count >= 2` fallback being false, so it
# needs no entry; the leak is specific to the multi-use shape (predicate
# read + cons read) where the conservative dup orphans the birth ref.
# Binders in `xs` not present in `ys`.
fn pcs_strs_minus(xs: [Binder], ys: [Binder]) : [Binder] = match xs {
  []           -> []
  [h, ...rest] -> if pcs_has(ys, h.id) { pcs_strs_minus(rest, ys) } else { [h, ...pcs_strs_minus(rest, ys)] }
}

# Issue #817 — every match-arm pattern binder bound anywhere in `body`,
# the candidate set for `pcs_collect_move_last_set`. (Params are excluded
# — they ride `skip_set` / the goto dropmask, not the move-at-last-use
# path; a param's last use being a move would already be handled by the
# branch-aware skip-set.)
fn pcs_all_arm_binders(e: Expr, acc: [Binder]) : [Binder] = match e.kind {
  EMatch(s, arms) -> pcs_all_arm_binders_arms(arms, pcs_all_arm_binders(s, acc))
  _               -> pcs_all_arm_binders_ps(xp_positions(e), acc)
}

fn pcs_all_arm_binders_ps(ps: [XPos], acc: [Binder]) : [Binder] = match ps {
  []                  -> acc
  [XP(_, c), ...rest] -> pcs_all_arm_binders_ps(rest, pcs_all_arm_binders(c, acc))
}

fn pcs_all_arm_binders_arms(arms: [Arm], acc: [Binder]) : [Binder] = match arms {
  []           -> acc
  [Arm(pat, _, body), ...rest] ->
    pcs_all_arm_binders_arms(rest, pcs_all_arm_binders(body, prc_pat_bindings(pat, acc)))
}

#[doc("The body of a declaration that owns no boxed parameter, with its reference counting made explicit.")]
fn pcs_paramless_body(body: Expr, uses: UseIx, me: SelfRef, raw_params: [Binder], opaque_ret_fns: [FnId], bmap: BorrowMap,
                      prim_bmap: BorrowMap, fns: FnIndex, cores: SymSet, tab: SymTab) : Expr / Console = {
  # Boxed locals whose single read a short circuit may skip take
  # the same force-dup + exit-drop treatment as the mixed path.
  let branchy_lets = pcs_branchy_let_binders(body, me, uses, [])
  let lend_lets = pcs_lend_move_lets(body, uses, pcs_collect_opaque_let_binders(body, opaque_ret_fns, []), bmap)
  let new_body0 = pcs_rewrite_expr(body, [], uses, lend_lets, branchy_lets, bmap, lend_lets)
  # A local whose last read sits in the tail needs a post-tail release: every
  # read of a multi-use local can land in a borrowed slot and orphan the birth ref.
  let new_body = ptd_tail_exit_drops(new_body0, me, uses, lend_lets, branchy_lets, [])
  let arm_dropped = pcs_arm_drop_pass(new_body, me, PcsArmCx { uses: uses, moved: [], boxed_bpos: [], borrow_only: [],
                                                                 borrowed: [], bmap: bm_empty(), forced: branchy_lets }, tab)
  let branch_paid = pbp_branch_drops(arm_dropped, raw_params, uses, [], [])
  let reused_body = pcs_recognise_reuse_expr(branch_paid, tab)
  # Without the caller-side strip a bare last-use arg is a move no borrowing callee releases.
  let borrow_last = pcs_collect_borrow_last_set(pcs_let_binder_names(body, []), body, prim_bmap)
  let scx = StripCx { bmap: bmap, borrow_last: borrow_last,
                      no_wrap: lend_lets, raw_no_wrap: lend_lets, uses: uses, fns: fns, cores: cores }
  pcs_strip_borrow_args_d(reused_body, scx)
}

pub(pkg) fn perceus_decl_b(d: Decl, fns: FnIndex, bmap: BorrowMap, cmap: ConsumeIndex, opaque_ret_fns: [FnId],
                  prim_bmap: BorrowMap, caps: CapScope, cores: SymSet, tab: SymTab) : Decl / Console {

  match d {
    DFn(is_pub, fsym, tparams, params, opt_ret, row, body, ln, cl, mo) -> {
      let me = SelfRef(fsym)
      # An extern shim owns its args (it frees or passes on every boxed
      # input), so unused-param drops here would double-free.
      if body_is_extern(body) { d }
      # Phase 3 unboxing — UFn params are raw C scalars (`int64_t`
      # etc.) with no reference count, so they carry NO dup/drop
      # obligation: they must stay out of the Perceus scope (a dup
      # against `kai_<pname>` would name a non-existent boxed alias)
      # and never receive an unused-param drop.
      #
      # Issue #703 — but the *body* of a UFn can still bind boxed
      # locals (`let v = A([..])`), and the match emitter consumes
      # (`kai_decref(_scr)`) its scrutinee on every match exit. A
      # boxed local read by ≥ 2 matches therefore needs the same
      # dup-at-non-last-read + exit-drop discipline as any other
      # block-local. The previous code skipped Perceus for the
      # *entire* UFn body, so the second `match v` dispatched on a
      # freed chunk → "non-exhaustive match" (C honored the missing
      # dup; LLVM happened not to). The fix runs the body rewrite
      # with an EMPTY param scope (mirroring DTest below): in-body
      # SLet bindings enter the scope during the walk and get their
      # dups + exit drops, while the raw params stay untouched and
      # take no param drops (no boxed params to reclaim).
      else if prc_is_all_raw_ufn_decl(fns, fsym) {
        let body_borrow = pcs_paramless_body(body, pcs_use_index(body, []), me, map(params, (p) => p.binder), opaque_ret_fns, bmap, prim_bmap, fns, cores, tab)
        DFn(is_pub, fsym, tparams, params, opt_ret, row, pst_take_state(body_borrow), ln, cl, mo)
      }
      else {
        # Boxed and MIXED-signature fns share this path. A mixed-sig fn
        # (e.g. `insert_loop(t: RBTree, k: Int, v: Int)`) has BOXED params
        # (the tree `t`) that need the full borrow + arm-top-move + exit-
        # drop discipline — skipping it (the old all-UFn branch) left the
        # boxed children un-dup'd in the shared branch and un-dropped at
        # exit, leaking the spine (rb-tree: reuse 19.6M→6.2M, 19.3M
        # leaked). The RAW params carry no rc and must NOT be dup'd/dropped
        # (#709 corruption), so they join the skip-set and are excluded
        # from the unused-param drops below — exactly like a borrowed param.
        # Capability params carry evidence, not RC'd data: out of the scope
        # (no use is a dup/move candidate) AND into the raw set (no unused-
        # param drop) — the same no-rc treatment as an unboxed scalar.
        let cap_pnames = pcap_param_names(caps, mo, params)
        let raw_pnames = pcs_list_union(prc_raw_param_names(fns, fsym, params), cap_pnames)
        let pnames = pcs_strs_minus(map(params, (p) => p.binder), cap_pnames)
        let uses = pcs_use_index_in(body, pnames, pcs_strs_minus(pnames, raw_pnames), (f) => prs_raw_arg_positions(f, fns))
        # Borrow inference (Koka). A borrowed param is inspect-only:
        # the body reads it WITHOUT dup (so it must be in the skip-set,
        # never dup'd) and its match scrutinee is wrapped in
        # __perceus_borrow so emit_match skips the exit decref → the
        # callee never touches the param's RC. The caller side
        # (pcs_strip_borrow_args) strips the __perceus_dup on the matching
        # argument → no incref is paid either. Net: zero RC on the
        # inspected param, which is exactly the 37%-of-wall traffic the
        # rb-tree spends on is_red / comparisons.
        let borrowed = pcs_borrow_params_hybrid(is_pub, me, params, pnames, body, tab)
        # Issue #599 — branch-aware skip-set: params read <= 1 time per
        # path transfer ownership raw (no dup). Borrowed params join the
        # skip-set too (they are never dup'd) — union the two.
        # Plus the arm-binder per-path move set (Koka Parc per-branch
        # ownership): pattern binders of SELF-RECURSIVE MODULO-CONS arms whose
        # max-path count (borrow-aware, discounting is_red(l)) is <= 1,
        # consumed-on-every-path, all-consumers-linear. Restricted to
        # self-rec-modulo-cons arms because emit disposes only those via the
        # borrow-model (arm-top reuse); a non-self-rec arm keeps the legacy
        # emit and moving its binders would double-free (the regexp UAF). This
        # is the half that lets insert_loop's Black arm move l/r instead of
        # spuriously dup'ing them — the ~8.8-nodes-per-insert spine leak.
        # Binder names are unique per fn, so each arm's gate decides for its
        # own binders only.
        let arm_moves = pcs_collect_arm_skip_binders(me, true, body, bmap, cmap, borrowed, tab)
        # Issue #817 — goto-tail arm-binders (read once per branch, consumed
        # on every path, consuming slot): moved on EVERY use, the
        # `list.filter`/`map` `kai_t` (tail) case. Distinct from `arm_moves`
        # (reuse-in-place); this is the free-cell-then-goto model.
        let goto_moves = pcs_collect_goto_tail_moves(me, body, bmap, uses, cmap, borrowed, tab)
        let skip_set0 = pcs_list_union(
          pcs_list_union(
            pcs_list_union(
              pcs_list_union(pcs_params_moved_raw(pnames, body, uses, bmap, pcs_list_union(raw_pnames, borrowed)), borrowed),
              arm_moves),
            goto_moves),
          raw_pnames)
        # Koka Parc `ownedInScope`: owned sibling params read once-per-path in
        # a top-level match, moved at their single use with the exit drop
        # replaced by a branch-local drop in the arms that never read them.
        let owned_moves = pcs_owned_scope_move_params(pnames, body, skip_set0, bmap, cmap, borrowed, tab)
        let skip_set = pcs_list_union(skip_set0, owned_moves)
        # Issue #817 — arm-binders whose LAST use lands in a consuming slot
        # but which are NOT in `skip_set` (so the conservative dup orphans
        # the birth ref: the `list.filter`-over-heap leak). `pcs_is_non_last`
        # moves the last read of these, keeping earlier reads dup'd.
        # Excluded from `skip_set` (which moves ALL reads); this set moves
        # only the last one.
        # Issue #817 — move-at-last-use candidates. RESTRICTED to binders
        # that live in a goto-tail arm whose cons cascade is SAFE (the
        # `filter` `h` shape: a guard-less `[h, ...t] -> if p(h) { recur }`
        # with no leading SLet / inner-match consuming a sibling). Only
        # there does the #3 `kai_decref(_scr)` shallow-decref guarantee no
        # cascade double-consume. A binder outside such an arm is left to
        # its conservative dup (no leak win lost beyond filter/map/flat_map,
        # which all have this shape). Then minus `skip_set` (already
        # moved on every use).
        # `safe_arm_binders` ⊆ `pcs_all_arm_binders` (both walk the same
        # tree; the safe set only adds the cascade gate), so the inter
        # never drops a safe binder the candidate set lacks.
        let safe_arm_binders = pcs_collect_safe_arm_binders(me, body, bmap, uses)
        # Params whose sole consumer is a borrow-discounted re-thread
        # (#1126). They must not dup on any read (the borrow read is
        # stripped; the single re-thread transfers raw), yet — unlike a
        # skip_set param — they DO keep their exit drop, because the base
        # arm that never re-threads owns the container and must free it.
        let borrow_move_params = pcs_collect_borrow_move_last_params(
          me, pnames, body, uses, bmap, borrowed, skip_set)
        # Arm binders of a borrowed param read only in borrowed slots: released
        # as their arm starts, every read a borrow.
        let borrow_only = prt_borrow_only_binders(body, borrowed, (c) => pcs_user_borrow_slots(bmap, c))
        let move_last0 = pcs_strs_minus(
          pcs_list_union(
            pcs_strs_inter(
              pcs_collect_move_last_set(pcs_all_arm_binders(body, []), body, uses, cmap, tab),
              safe_arm_binders),
            pcs_collect_move_last_lets(body, uses, cmap, skip_set, tab)),
          pcs_list_union(skip_set, borrow_only))
        # Let-bound opaque handles whose birth ref needs an end-of-scope
        # drop (each shim call consumes a dup; the birth ref is released
        # here, even when the last use is in tail position).
        let opaque_lets = pcs_collect_opaque_let_binders(body, opaque_ret_fns, [])
        # Lets lent and then handed over: bare on every read, paid by the
        # owning one, so they join both the moved set and the payers' set.
        let lend_lets = pcs_lend_move_lets(body, uses, pcs_list_union(skip_set, opaque_lets), bmap)
        let move_last_set = pcs_list_union(move_last0, lend_lets)
        # `rewrite_skip_set` suppresses the dup wrap for #1126 borrow-move
        # params too, so the re-thread transfers raw. The exit-drop set
        # (`skip_set`) deliberately excludes them: the base arm still frees
        # the container. Keep the two sets distinct.
        let moved0 = pcs_list_union(pcs_list_union(skip_set, borrow_move_params), lend_lets)
        # Arm binders read at most once per path move on every read; the
        # branch payer releases them on the alternatives that skip them.
        let path_moves = ppm_path_moves(body, uses, pcs_list_union(moved0, pnames), borrowed,
          (nm, b) => pcs_max_paths_in_expr(nm, b) <= 1 and pcs_all_consumers_linear(nm, b) and
                     pcs_uses_only_consuming_slots(nm, b, cmap, bm_empty(), tab),
          (f) => pcs_borrow_slots(bmap, f),
          (nm, b) => pcs_let_lends_then_moves(nm, b, bmap))
        let rewrite_skip_set = pcs_list_union(moved0, path_moves)
        # Single-use params whose only read sits on some-but-not-all paths:
        # forced to dup at the read (force_set) and released by a forced
        # exit drop, so the paths that skip the read stay balanced.
        let branchy_single = pcs_branchy_single_use_params(me, fsym, pnames, body, uses, rewrite_skip_set, tab)
        # Arm binders in the same shape (sole read behind a short-circuit
        # edge of their own arm — an `and`/`or` guard/arg RHS): forced to
        # dup too. Their payers are the arm-drop and guard-fail planters,
        # which re-derive from the rewritten arm (a dup'd-only binder
        # plants).
        let branchy_arms = pcs_branchy_arm_binders(body, me, uses, rewrite_skip_set, [])
        # Block-let binders in the same shape: forced to dup too, paid by
        # the block-exit collector (statement reads) or the post-tail
        # pass (tail reads).
        let branchy_lets = pcs_branchy_let_binders(body, me, uses,
                                                   pcs_list_union(rewrite_skip_set, pnames))
        let force_all = pcs_list_union(pcs_list_union(branchy_single, branchy_arms), branchy_lets)
        # The exit drop keeps the #1126 borrow-move params: only their
        # re-thread moves, and the base path still owns the container.
        let psets = PcsParamSets { moved: skip_set, forced: force_all }
        let new_body0 = pcs_rewrite_expr(body, pnames, uses, rewrite_skip_set, force_all, bmap, move_last_set)
        let new_body1 = pcs_force_opaque_exit_drops(new_body0, opaque_lets, uses)
        # The block-exit collector below declines a binding whose last read
        # sits in the tail (the drop would have to run after the tail value
        # exists). `ptd_tail_exit_drops` releases exactly those. The fn's own
        # boxed borrowed positions gate the self-call arg hoist: a reference
        # hoisted into a temp for a borrowed slot would lose its ownership
        # marking. A raw slot carries none.
        let boxed_bpos = pcs_boxed_positions(pcs_borrow_lookup(bmap, fsym), params, raw_pnames, 0)
        let new_body = ptd_tail_exit_drops(new_body1, me, uses, move_last_set, branchy_lets, boxed_bpos)
        let arm_dropped = pcs_arm_drop_pass(new_body, me,
                                            PcsArmCx { uses: uses, moved: rewrite_skip_set, boxed_bpos: boxed_bpos,
                                                      borrow_only: borrow_only, borrowed: borrowed, bmap: bmap,
                                                      forced: force_all }, tab)
        # A param its read pays is released on the paths that skip the read.
        let read_paid = pcs_strs_minus(pcs_names_paid_by(pnames, uses, psets, PyRead),
                                       pcs_list_union(borrowed, raw_pnames))
        let branch_paid = pbp_branch_drops(arm_dropped, pnames, uses, path_moves, read_paid)
        # Every owned position a borrowed binder reaches takes a dup, before
        # reuse recognition turns a ctor or cons literal into a reuse cell.
        let owned_body = pop_own_positions(branch_paid, pcs_strs_minus(borrowed, raw_pnames),
                                           (f) => pcs_borrow_slots(bmap, f))
        let reused_body = pcs_recognise_reuse_expr_b(owned_body, borrowed, tab)
        # Borrowed params carry no exit obligation — exclude from the
        # unused-param drop. Raw params (mixed-sig) likewise carry no rc,
        # so they must not receive an unused-param drop either.
        let drop_params = pcs_params_minus(pcs_params_minus(params, borrowed), raw_pnames)
        # Issue #1120 — a param used ONLY in a borrowed-prim slot (`a[i]`).
        # Its container access stays CONSUMING (the strip below keeps the
        # dup + the `array_get` symbol) so the runtime decref reclaims it —
        # no exit-drop wrap, which would reset a raw sibling param's unbox
        # scope in the emitter. The borrow win is the loop shape (container
        # re-threaded, not last-use), which this exclusion leaves untouched.
        # Params AND locally-bound arrays read only through `a[i]` (never
        # consumed) keep all their accesses consuming; a container with a
        # later consuming use (the loop re-thread) is NOT borrow-only and its
        # reads ARE rewritten to the borrow variant. A borrowed param holds no
        # reference for the runtime to reclaim, so it is never one of them.
        let bl_names = pcs_list_union(pnames, pcs_let_binder_names(body, []))
        let borrow_last = pcs_strs_minus(pcs_collect_borrow_last_set(bl_names, body, prim_bmap), borrowed)
        let body_with_drops = pcs_wrap_param_drops(reused_body, drop_params, uses, psets)
        # Callee flip: wrap borrowed scrutinees so emit_match skips the
        # decref. Caller flip: strip __perceus_dup on borrowed-slot args,
        # keeping the last-use of a borrow-only container consuming.
        let body_borrow_scr = pcs_wrap_borrow_scrutinees(body_with_drops, borrowed)
        # Closure flip (#1130): route `f(args)` through a borrowed
        # function-typed param to the borrowing indirect call. `borrowed`
        # is in the skip-set (never dup'd); the borrowing call does not
        # consume, so the closure's exit drop frees it exactly once.
        let borrowed_closures = pcs_borrowed_closure_names(borrowed, params)
        let body_borrow_call = pcs_wrap_borrow_calls(body_borrow_scr, borrowed_closures)
        # Bare-move detection: names whose bare reads are NOT owned moves —
        # the skip/move/reuse sets (union already includes borrowed + raw
        # params) plus the exit-dropped opaque locals and force-dup'd
        # branchy singles.
        let no_wrap = pcs_list_union(pcs_list_union(pcs_list_union(rewrite_skip_set, opaque_lets), branchy_single),
                                     borrow_only)
        let scx = StripCx { bmap: bmap, borrow_last: borrow_last,
                            no_wrap: no_wrap, raw_no_wrap: pcs_strs_minus(no_wrap, pcs_strs_minus(
                              pcs_list_union(pcs_list_union(path_moves, goto_moves), arm_moves),
                              pcs_list_union(pcs_list_union(opaque_lets, borrow_only), branchy_single))),
                            uses: uses, fns: fns, cores: cores }
        let body_borrow = pcs_strip_borrow_args_d(body_borrow_call, scx)
        let self_bpos = pcs_borrow_positions(map(params, (p) => p.binder), pcs_strs_minus(borrowed, raw_pnames), 0)
        let body_lent = plt_lend_binders(body_borrow, me, self_bpos, borrowed,
                                         (f) => pcs_boxed_borrow_slots(bmap, fns, f))
        let body_taken = pst_take_state(ptk_take_fields(body_lent, pcs_strs_minus(pcs_strs_minus(pnames, borrowed), raw_pnames)))
        DFn(is_pub, fsym, tparams, bbe_stamp_borrowed(params, pcs_strs_minus(borrowed, raw_pnames), raw_pnames),
            opt_ret, row, body_taken, ln, cl, mo)
      }
    }
    DTest(desc, body, ln, cl, mo) ->
      DTest(desc, pcs_paramless_body(body, pcs_use_index(body, []), SelfRef(fnid_none()), [], opaque_ret_fns, bmap, prim_bmap, fns, cores, tab), ln, cl, mo)
    DBench(desc, body, ln, cl, mo) ->
      DBench(desc, pcs_paramless_body(body, pcs_use_index(body, []), SelfRef(fnid_none()), [], opaque_ret_fns, bmap, prim_bmap, fns, cores, tab), ln, cl, mo)
    # check v1 (issue #44): with-clause params behave like fn params
    # for Perceus — collected as known external bindings so dup/drop
    # discipline accounts for them. The emitter wraps each iter in a
    # function that defines the param locals and drops them at iter
    # boundary.
    #
    # Issue #697: unlike a fn param, a check-param is NOT owned by the
    # body — the generated check loop owns it. The loop drops it in
    # iter_drops/tail_drops, and the shrinker re-evaluates the same
    # body against the SAME param value across iterations. So the body
    # must BORROW its params: every read dups, last-use included, and
    # the body never consumes/drops them. Passing `pnames` as the
    # `force_set` makes `pcs_is_non_last` always-dup them — the same
    # treatment `state`/`log` get, and for the same alias-not-owned
    # reason. Without it, a single-use param (`string_length(s)`)
    # transfers raw to a decref-aware consumer that frees it, then the
    # loop's own drop double-frees (heap-use-after-free → SIGTRAP).
    DCheck(desc, ps, body, ln, cl, mo) -> {
      let pnames = map(ps, (p) => p.binder)
      let uses = pcs_use_index(body, pnames)
      let skip_set = pcs_branch_aware_skip_params(pnames, body, bmap)
      let new_body = pcs_rewrite_expr(body, pnames, uses, skip_set, pnames, bmap, [])
      let reused_body = pcs_recognise_reuse_expr(new_body, tab)
      DCheck(desc, ps, reused_body, ln, cl, mo)
    }
    _ -> d
  }
}

# ---- issue #118 — Perceus reuse-in-place recogniser ----
#
# Walks the post-`pcs_rewrite_expr` AST looking for match arms whose
# body rebuilds a constructor of the same shape as the arm's pattern.
# When found, the rebuild is rewritten to call one of the magic
# `__perceus_reuse_*` helpers; the emitter (`emit_call_expr`) lowers
# those to runtime hooks that branch on the consumed cell's RC at
# each invocation: rewrite-in-place when unique, fall back to
# `kai_<shape>` when shared.
#
# The synthetic identifier `__pcs_scr` is the recogniser's hand-off
# to the emitter — it lowers to the literal C local `_scr` that
# `emit_match_default` introduces for every match. The match exit
# always `kai_decref(_scr)`s; the runtime helpers `kai_incref` the
# reused cell so it survives the decref, leaving the caller with a
# unique-RC result.
#
# v1 patterns (audit §1):
#   - cons:    Arm(PList([_], Some(t)), None, EList([ElPlain(_), ElSpread(_)]))
#   - variant: Arm(PVariant(_, ps), None, ECall(EName(C), args))
#                where length(args) == length(ps)
#   - record:  Arm(PRecord(_), None, ERecordLit(_, fis))
#                where the literal has the same field count
#
# Out of v1 scope: PVariantRecord (named-field variants), guards,
# blocks before the rebuild, multi-cons rebuilds (e.g. `[a, b, ...c]
# -> [a', b', ...c']` rewrites only the outermost cons), arms whose
# body recurses through a let-binding (those would need a follow-up
# pass). The runtime `rc == 1` guard makes every fall-through case
# safe — a missed recognition is a missed optimisation, not a bug.

fn pcs_recognise_reuse_expr(e: Expr, tab: SymTab) : Expr = pcs_recognise_reuse_expr_b(e, [], tab)

# A `let` owns what it binds, as a param does: its one owning read per path
# hands the reference on once every lend of it is over.
fn pcs_lend_move_lets(body: Expr, uses: UseIx, skip: [Binder], bmap: BorrowMap) : [Binder] =
  plo_lend_move_lets(body, uses, skip, (nm, scope) => pcs_let_lends_then_moves(nm, scope, bmap))

fn pcs_let_lends_then_moves(nm: Binder, scope: Expr, bmap: BorrowMap) : Bool =
  pcs_lends_end_first(nm, scope, bmap) and
  pcs_all_consumers_linear(nm, scope) and
  pcs_consumed_b_expr(nm, scope, bmap)

# Names present in BOTH lists.
fn pcs_strs_inter(xs: [Binder], ys: [Binder]) : [Binder] = match xs {
  []           -> []
  [h, ...rest] -> if pcs_has(ys, h.id) { [h, ...pcs_strs_inter(rest, ys)] } else { pcs_strs_inter(rest, ys) }
}

fn pcs_arm_drop_pass(e: Expr, fn_name: SelfRef, cx: PcsArmCx, tab: SymTab) : Expr = {
  let k1 = prc_map_expr_kind(e.kind, (c) => pcs_arm_drop_pass(c, fn_name, cx, tab))
  let k2 = match k1 {
    EMatch(scr, arms) -> {
      let on_param = prt_scr_is_param(scr, cx.borrowed)
      EMatch(scr, map(arms, (a) => pcs_arm_drops_of(a, fn_name, cx, on_param, tab)))
    }
    _                 -> k1
  }
  Expr { kind: k2, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
}

fn pcs_arm_drops_of(a: Arm, fn_name: SelfRef, cx: PcsArmCx, on_param: Bool, tab: SymTab) : Arm = match a {
  Arm(pat0, g_rw, body1) -> {
    # For a block body the drop sits between statements and tail, so a
    # tail read must be skipped; a non-block body is wrapped and runs first.
    let pre_tail = pcs_body_is_block_with_tail(body1)
    # A never-read plain `PBind` is elided to `_` instead of paid: no
    # bind-incref is emitted, and a bare ctor rebuild stays visible to the
    # reuse recogniser.
    let elide = pcs_arm_elide_names(pat0, cx.uses, [])
    let pat = pcs_pat_elide(pat0, elide)
    let bound_all = pcs_strs_minus(prc_pat_bindings(pat0, []), elide)
    let entry = if on_param {
      pcs_strs_inter(prt_arm_borrow_only(pat0, g_rw, body1, (c) => pcs_user_borrow_slots(cx.bmap, c)), cx.borrow_only)
    } else { [] }
    let bound = pcs_strs_minus(bound_all, entry)
    let drops = pcs_collect_arm_drops(bound, pat.line, pat.col, body1, g_rw, cx, pre_tail, [])
    let hoist = PcsHoist { ok: phg_keeps_marks(body1, fn_name, cx.boxed_bpos), bpos: cx.boxed_bpos }
    let body2 = match drops {
      [] -> body1
      [_, ...__] -> pcs_inject_arm_drops(body1, drops, fn_name, hoist, bound, tab)
    }
    let body3 = pcs_arm_tail_drop_body(body2, bound, pat.line, pat.col, g_rw, cx.uses, fn_name, hoist, tab)
    let body4 = match entry {
      [] -> body3
      _  -> Expr { kind: EBlock(map(entry, (nm) => pcs_make_drop_stmt(nm.id, pat.line, pat.col)), Some(body3)),
                   line: body3.line, col: body3.col, ty: body3.ty, mode: body3.mode,  site: body3.site }
    }
    # A falsy guard leaves the arm without running the body or its exits.
    let g1 = match g_rw {
      None    -> None
      Some(g) -> Some(pcs_guard_close_births(g, bound_all))
    }
    Arm(pat, g1, body4)
  }
}

fn pcs_body_is_block_with_tail(body: Expr) : Bool {
  match body.kind {
    EBlock(_, opt_tail) -> match opt_tail {
      None -> false
      Some(_) -> true
    }
    _ -> false
  }
}

# ---- m5 — basic Perceus (m5 #1, walker scaffold) ----
#
# Walks the post-mono `[Decl]` and (eventually) inserts `kai_dup` /
# `kai_decref` calls at non-last / last-use positions per the Koka
# Perceus paper. m5 #1 wires the slot; the body is identity. m5 #2
# computes per-binding last-use positions; m5 #3 emits drops at
# end-of-scope; m5 #4 emits dups at non-last uses; m5 #5 measures.
#
# Operates on values, not types. Under uniform boxing every
# `KaiValue *` has the same RC shape, so a single drop/dup discipline
# applies across instantiations — the m4c retrofit blocking real
# monomorphisation does not block this pass.
#
# Reads the source AST as the IR. The emitter consumes whatever this
# function returns; selfhost convergence remains the gate.

# For each `DFn` the pass collects the in-scope reads once (`pcs_use_index`),
# then rewrites the body so every read that does not hand its binder's birth
# ref on is wrapped in `__perceus_dup`. The drops that release what no read
# hands on are planted where `compiler.perceus_payer` names the payer.


pub(pkg) fn perceus_pass_in(decls: [Decl], tab: SymTab, specs: SpecNames, views: FileViews,
      root: String, entry: SymId) : [Decl] / Console {

  let fns = fnx_build(register_fn_decls(decls, tab, specs, entry))
  # Borrow inference pre-pass (Koka pre-Parc): per-fn borrowed param
  # positions, consumed by BOTH sides of the flip (callee wraps the
  # borrowed scrutinee in __perceus_borrow so emit_match skips its exit
  # decref; caller strips the __perceus_dup on args in borrowed slots).
  # Read-only prims (array_get/array_length) join the borrow map so the
  # caller strips the container dup and the path counter charges 0 —
  # reusing the whole borrow pipeline. A prim is keyed by its row's
  # identity like any declaration, so a user fn spelled like a prim never
  # reads the prim's row; the same entry gates the callee rename.
  let prim_bmap = pcs_seed_prim_borrows()
  let bmap = pcs_build_borrow_map(decls, prim_bmap, tab)
  # Consume-map (Koka Borrowed dual): per-fn CONSUMED param positions. A caller
  # may MOVE a binder into a consuming slot; a non-consuming slot (field-read
  # callee like regexp nb_add_transition) must keep the caller's ref.
  let cmap = pcs_build_consume_map(decls, cix_empty(), tab)
  # The `extern "C" fn` shims whose return type is an opaque handle.
  # A `let h = f(...)` with such an `f` binds a handle box that must move
  # at its last consuming use (the shim there decrefs the box); otherwise
  # it is dup'd at every use and the birth ref never reaches zero.
  let opaque_names = pcs_collect_opaque_names(decls, [])
  let opaque_ret_fns = pcs_collect_opaque_ret_fns(decls, opaque_names, [])
  let caps = pcap_scope(decls, tab, views, root)
  let prim_bm = bm_of(prim_bmap)
  let cores = bound_builtin_syms()
  map(decls, (d) => perceus_decl_b(d, fns, bmap, cmap, opaque_ret_fns, prim_bm, caps, cores, tab))
}

# The `extern "C" fn` shims whose return type is an opaque handle.
fn pcs_collect_opaque_ret_fns(decls: [Decl], opaque_names: [SymId], acc: [FnId]) : [FnId] = match decls {
  []           -> acc
  [d, ...rest] -> match d {
    DFn(_, fsym, _, _, opt_ret, _, body, _, _, _) ->
      if body_is_ffi_extern(body) and pcs_ret_is_opaque(opt_ret, opaque_names) {
        pcs_collect_opaque_ret_fns(rest, opaque_names, [fsym, ...acc])
      } else { pcs_collect_opaque_ret_fns(rest, opaque_names, acc) }
    _ -> pcs_collect_opaque_ret_fns(rest, opaque_names, acc)
  }
}

fn pcs_ret_is_opaque(opt_ret: Option[TypeExpr], opaque_names: [SymId]) : Bool = match opt_ret {
  Some(t) -> match t.tkind { TyName(r, _) -> pcs_has_sym(opaque_names, ref_sym(r)) _ -> false }
  None    -> false
}

fn pcs_has_sym(ss: [SymId], s: SymId) : Bool = match ss {
  []           -> false
  [h, ...rest] -> (sym_raw(s) >= 0 and sym_same(h, s)) or pcs_has_sym(rest, s)
}

# The types declared `extern "C" opaque`, recovered from the
# one-`__ffi_handle`-field records they lower to. Every boxed FFI input
# is consumed (the shim decrefs each after the extern returns).
fn pcs_collect_opaque_names(decls: [Decl], acc: [SymId]) : [SymId] = match decls {
  []           -> acc
  [d, ...rest] -> match d {
    DType(_, tsym, _, TBRecord(fields), _, _, _, _) ->
      if pcs_is_ffi_opaque_record(fields) { pcs_collect_opaque_names(rest, [tsym, ...acc]) }
      else { pcs_collect_opaque_names(rest, acc) }
    _ -> pcs_collect_opaque_names(rest, acc)
  }
}

fn pcs_is_ffi_opaque_record(fields: [FieldDecl]) : Bool = match fields {
  [FD(_, fname, _, _)] -> fname == "__ffi_handle"
  _ -> false
}

# Seed the borrow map with the read-only prims. One map entry gates BOTH
# the caller-dup strip and the callee rename, so a strip-without-rename
# (double free) or rename-without-strip (leak) is impossible.
fn pcs_seed_prim_borrows() : [BorrowEntry] = map(lending_builtins(), (b) => BwE(fnid_decl(builtin_id(b)), [0]))

#[doc("What the capability test resolves against: the program's symbol table, its per-file views, the root module, and the effects and types the declarations declare.")]
pub type CapScope = { tab: SymTab, views: FileViews, root: String,
                      effects: [SymId], types: [SymId] }

fn pcap_scope(decls: [Decl], tab: SymTab, views: FileViews,
      root: String) : CapScope =
  CapScope { tab: tab, views: views, root: root,
             effects: pcap_declared(decls, true, []),
             types: pcap_declared(decls, false, []) }

fn pcap_param_names(c: CapScope, mo: Option[String],
      params: [Param]) : [Binder] =
  pcap_names(c, fv_of(c.views, st_module_id(pcap_home(c, mo))), params)

fn pcap_home(c: CapScope, mo: Option[String]) : String = match mo {
  Some(m) -> m
  None    -> c.root
}

fn pcap_names(c: CapScope, v: ScopeView, params: [Param]) : [Binder] =
  match params {
    [] -> []
    [p, ...rest] ->
      if pcap_is_cap(c, v, p.ptype) { [p.binder, ...pcap_names(c, v, rest)] }
      else { pcap_names(c, v, rest) }
  }

fn pcap_is_cap(c: CapScope, v: ScopeView, t: Option[TypeExpr]) : Bool =
  match t {
    Some(te) -> match te.tkind {
      TyName(r, _) -> pcap_names_effect(c, v, r)
      _            -> false
    }
    None -> false
  }

fn pcap_names_effect(c: CapScope, v: ScopeView, r: DeclRef) : Bool = match r {
  DrSym(s) ->
    if st_valid(c.tab, s) { pcap_effect(c.tab, s) }
    else { pcap_has(c.effects, s) and not pcap_has(c.types, s) }
  DrWritten(_, n) -> match sv_resolve_any(c.tab, v, [NCEffect, ...type_classes()], written_text(n)) {
    SvSym(s)     -> pcap_effect(c.tab, s)
    SvPrivate(s) -> pcap_effect(c.tab, s)
    SvAmbig(ss)  -> pcap_all_effects(c.tab, ss)
    SvNone       -> false
  }
}

fn pcap_effect(t: SymTab, s: SymId) : Bool = ncls_same(sym_class(t, s), NCEffect)

# Two declarations on one rung leave the annotation contested. Only when
# every candidate is an effect is there no value type it could mean.
fn pcap_all_effects(t: SymTab, ss: [SymId]) : Bool = match ss {
  [] -> true
  [s, ...rest] -> pcap_effect(t, s) and pcap_all_effects(t, rest)
}

fn pcap_has(ss: [SymId], s: SymId) : Bool = match ss {
  []           -> false
  [h, ...rest] -> (sym_raw(s) >= 0 and sym_same(h, s)) or pcap_has(rest, s)
}

fn pcap_declared(decls: [Decl], effects: Bool, acc: [SymId]) : [SymId] =
  match decls {
    [] -> acc
    [d, ...rest] -> match d {
      DEffect(_, s, _, _, _, _, _, _) ->
        pcap_declared(rest, effects, if effects { [s, ...acc] } else { acc })
      DType(_, s, _, _, _, _, _, _) ->
        pcap_declared(rest, effects, if effects { acc } else { [s, ...acc] })
      _ -> pcap_declared(rest, effects, acc)
    }
  }
