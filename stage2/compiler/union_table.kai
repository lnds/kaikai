#[doc("""
The components of each union, keyed by the union's declaration.

`type U = A | B` lists nominal types. The typer asks two questions of
that list: which types a union names, and which unions name a type.
Both are answered by declaration id, so two modules that each declare a
`U`, or an `A`, are never read as one. A row keeps the union's spelling
only for the diagnostics that show it.

The rows are also kept in the order a module sees them: its own first,
then each module typed before it, newest first. A diagnostic that names
one parent of a component names the nearest.
""")]

import compiler.ast
import compiler.infer_index

#[doc("One union declaration: the name a diagnostic shows, its identity, its components in declaration order, and the position of the declaration.")]
pub type UnionRow = UnionRow(String, SymId, [Ty], Int, Int)

#[doc("The unions a module sees, nearest first, and the same rows keyed by the union's id.")]
pub type UnionTable = { rows: [UnionRow], by_parent: NameIndex[UnionRow] }

#[doc("A table with no unions.")]
pub fn ut_empty() : UnionTable = UnionTable { rows: [], by_parent: idx_empty() }

#[doc("`t` with the rows of one more module, which read nearer than every row `t` already holds.")]
pub fn ut_add(t: UnionTable, block: [UnionRow]) : UnionTable =
  UnionTable { rows: list_append(block, t.rows), by_parent: ut_index(list_reverse(block), t.by_parent) }

# Reversed, so the first row of a block ends up newest in its bucket.
fn ut_index(rev: [UnionRow], ix: NameIndex[UnionRow]) : NameIndex[UnionRow] = match rev {
  [] -> ix
  [r, ...rest] -> match r {
    UnionRow(_, s, _, _, _) -> ut_index(rest, if sym_raw(s) < 0 { ix } else { idx_prepend_sym(ix, s, r) })
  }
}

#[doc("The components of the union `parent` declares, in declaration order; empty when `parent` declares no union.")]
pub fn ut_components(t: UnionTable, parent: SymId) : [Ty] =
  if sym_raw(parent) < 0 { [] }
  else { match idx_chain_sym(t.by_parent, parent) {
    [UnionRow(_, _, comps, _, _), ..._] -> comps
    []                                  -> []
  } }

#[doc("True when the union `parent` declares lists the nominal type `comp`.")]
pub fn ut_lists(t: UnionTable, parent: SymId, comp: SymId) : Bool =
  sym_raw(comp) >= 0 and ut_has(ut_components(t, parent), comp)

#[doc("Every union that lists the nominal type `comp`, nearest first.")]
pub fn ut_parents(t: UnionTable, comp: SymId) : [UnionRow] =
  if sym_raw(comp) < 0 { [] }
  else { filter(t.rows, (r) => match r { UnionRow(_, _, comps, _, _) -> ut_has(comps, comp) }) }

#[doc("The identity of the nominal type `t`, or `sym_none()` for any other type.")]
pub fn ut_ty_sym(t: Ty) : SymId = match t {
  TyCon(_, _, _, s) -> s
  _                 -> sym_none()
}

#[doc("The name a diagnostic shows for the union of `r`.")]
pub fn ut_row_shown(r: UnionRow) : String = match r { UnionRow(n, _, _, _, _) -> n }

#[doc("The identity of the union of `r`.")]
pub fn ut_row_sym(r: UnionRow) : SymId = match r { UnionRow(_, s, _, _, _) -> s }

fn ut_has(comps: [Ty], comp: SymId) : Bool = match comps {
  [] -> false
  [c, ...rest] -> if sym_raw(ut_ty_sym(c)) == sym_raw(comp) { true } else { ut_has(rest, comp) }
}
