#[doc("Which slots of a unique cell a rebuild leaves holding their word, and which rebuild cell keeps the most of them.")]

import compiler.ast
import compiler.ast_ids
import compiler.emit_shared_syms

#[doc("""
The slots of `cargs`, all but `hole`, whose word a unique cell matched by
`subs` (slot kinds `tys`) already holds: the slot's own binder, or the nullary
constructor its pattern matched in a non-pointer slot.
""")]
pub fn pat_kept_slots(subs: [Pattern], tys: [Int], cargs: [Expr], hole: Int) : [Int] =
  list_reverse(kept_slots(subs, tys, cargs, hole, 0, []))

#[doc("""
The arg of `cargs` to move into the unique cell matched by `subs` instead of
the outer rebuild: a constructor call (`is_ctor`) of the outer's arity that
keeps more slots in place than the outer does. None keeps the outer.
""")]
pub fn flat_host_slot(subs: [Pattern], tys: [Int], cargs: [Expr], is_ctor: (Expr) -> Bool) : Option[
  Int
] =
  host_go(subs, tys, cargs, list_length(cargs), is_ctor, kept_count(subs, tys, cargs), 0, None)

fn host_go(
  subs: [Pattern],
  tys: [Int],
  es: [Expr],
  n: Int,
  is_ctor: (Expr) -> Bool,
  best: Int,
  i: Int,
  pick: Option[Int]
) : Option[Int] = match es {
  [] -> pick
  [e, ...rest] -> {
    let k = match e.kind {
      ECall(_, cas) ->
        if list_length(cas) == n and is_ctor(e) { kept_count(subs, tys, cas) } else { 0 - 1 }
      _ -> 0 - 1
    }
    if k > best {
      host_go(subs, tys, rest, n, is_ctor, k, i + 1, Some(i))
    } else {
      host_go(subs, tys, rest, n, is_ctor, best, i + 1, pick)
    }
  }
}

fn kept_count(subs: [Pattern], tys: [Int], cargs: [Expr]) : Int =
  list_length(kept_slots(subs, tys, cargs, 0 - 1, 0, []))

fn kept_slots(subs: [Pattern], tys: [Int], cargs: [Expr], hole: Int, i: Int, acc: [Int]) : [Int] =
  match cargs {
    [] -> acc
    [a, ...rest] -> {
      let keep = i != hole and slot_holds(nth(subs, i), kind_at(tys, i), a)
      kept_slots(subs, tys, rest, hole, i + 1, if keep { [i, ...acc] } else { acc })
    }
  }

# A pointer slot under a nullary pattern is released by the capture, so only
# a binder keeps a pointer slot's word. A dup moves the same word.
fn slot_holds(s: Option[Pattern], kind: Int, a: Expr) : Bool = match s {
  Some(p) -> match p.pkind {
    PBind(b) -> reads_local(a, b.id)
    PVariant(r, []) -> kind != 0 and names_sym(a, ref_sym(r))
    _ -> false
  }
  None -> false
}

fn names_sym(a: Expr, c: SymId) : Bool = match a.kind {
  ESym(s, _) -> sym_same(s, c)
  _ -> false
}

fn reads_local(a: Expr, id: LocalId) : Bool = match a.kind {
  ELocal(l) -> local_eq(l, id)
  ECall(f, [inner]) -> match f.kind {
    EMark(MkDup) -> reads_local(inner, id)
    _ -> false
  }
  _ -> false
}
