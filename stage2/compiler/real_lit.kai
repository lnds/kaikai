# compiler/real_lit.kai — a Real literal and its exact text.
#
# The short text of a Real names it only when reading that text back gives
# the same bits. Everything that hands a Real to a C compiler, a cache key
# or a cache blob goes through here.

import compiler.util

#[doc("The value of a Real literal. Its codec writes `real_exact_text`, so a restored literal has the bits the source wrote.")]
pub type RealLit = RealLit(Real)

impl BinSerialize for RealLit {
  fn to_bytes(self: RealLit) : Array[Byte] = match self {
    RealLit(r) -> to_bytes(real_exact_text(r))
  }
  fn from_bytes(buf: Array[Byte], pos: Int) : Result[BinCursor[RealLit], String] = {
    let e = bin_string_end(buf, pos)
    if e < 0 { Err(bin_end_error(e)) }
    else {
      match string_to_real(bin_string_at(buf, pos)) {
        Some(r) -> Ok(BinCursor { value: RealLit(r), pos: e })
        None    -> Err("RealLit: payload is not a Real")
      }
    }
  }
}

#[doc("Text that C and `string_to_real` read back as exactly `r`: the short decimal when it round-trips, else a C99 hex float.")]
pub fn real_exact_text(r: Real) : String {
  let short = real_to_string(r)
  if real_text_reads_as(short, r) { short } else { real_hex_text(r) }
}

# Bits, not `==`: `0.0 == -0.0` and a NaN equals nothing.
fn real_text_reads_as(s: String, r: Real) : Bool = match string_to_real(s) {
  Some(v) -> real_bits(v) == real_bits(r)
  None    -> false
}

# A non-finite Real has no hex form; its short text already names it.
fn real_hex_text(r: Real) : String {
  let bits = real_bits(r)
  let sign = if bits < 0 { "-" } else { "" }
  let exp = bit_and(bit_ushr(bits, 52), 0x7FF)
  let frac = real_hex_frac(bit_and(bits, 0xFFFFFFFFFFFFF), 12, "")
  if exp == 0x7FF { real_to_string(r) }
  else if exp == 0 { concat_all([sign, "0x0.", frac, "p-1022"]) }
  else { concat_all([sign, "0x1.", frac, "p", int_to_string(exp - 1023)]) }
}

# The 52 fraction bits as 13 hex digits, most significant first.
fn real_hex_frac(frac: Int, i: Int, acc: String) : String =
  if i < 0 { acc }
  else { real_hex_frac(frac, i - 1, cat2(acc, json_hex_digit(bit_and(bit_ushr(frac, 4 * i), 15)))) }
