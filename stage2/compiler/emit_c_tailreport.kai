#[doc("The tail calls of a program that the C backend leaves as calls, reported on stderr.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.call_site_target
import compiler.core_builtins
import compiler.emit_c_ctx
import compiler.emit_c_dropmask
import compiler.emit_c_tailjump
import compiler.enc_unit
import compiler.fn_index
import compiler.fnreg
import compiler.region
import compiler.ret_slots
import compiler.unwind_pend
import compiler.emit_reuse
import compiler.symtab
import compiler.tail_plan
import compiler.tail_pos
import compiler.tail_report
import compiler.util
import compiler.written

# One tail call that stays a call: where it sits, the function it sits in, what it calls, and why.
type TrMiss = { caller: FnId, callee: Option[FnId], line: Int, col: Int, why: TailWhy }

#[doc("Print one warning for each tail call of the module being built that stays a call between functions on a cycle of direct calls: a call between functions that never call back grows no stack.")]
pub(pkg) fn tail_report_decls(decls: [Decl], entry: SymId, cx: EmitCtx) : Unit / Console = {
  let misses = flat_map(decls, (d) => tr_misses(d, entry, cx))
  match misses {
    [] -> ()
    _  -> tr_print(misses, tailplan_cyclic(decls), cx)
  }
}

fn tr_misses(d: Decl, entry: SymId, cx: EmitCtx) : [TrMiss] / Console = match d {
  DFn(_, fid, tparams, params, ret, row, body, _, _, mo) ->
    if list_is_empty(tparams) and not is_entry(entry, fid) and tr_homed(mo, cx) {
      let here = tr_fn_ctx(cx, fid, params, ret, row, body)
      let inner = tr_inner(body)
      list_append(flat_map(tail_leaves(inner), (leaf) => tr_leaf(fid, leaf, false, here)),
                  flat_map(tr_checked_leaves(inner), (leaf) => tr_leaf(fid, leaf, true, here)))
    } else { [] }
  _ -> []
}

# The context the body of `fid` is emitted in, as far as a jump depends on it.
fn tr_fn_ctx(cx: EmitCtx, fid: FnId, params: [Param], ret: Option[TypeExpr], row: RowExpr, body: Expr) : EmitCtx / Console = {
  let enc = enc_of_fn(fid, "")
  let pids = param_local_ids(params)
  let frame = unw_fn_frame(cx.unw, enc.unit, Some(row), unw_param_seeds(params, fnx_ufn_sig_first(cx.fx, fid), cx.unw.ucx), pids, body)
  EmitCtx { ...cx, cur_enc_fn: enc, unw: frame, in_region: cx.in_region or fn_has_region_brand(params, ret), rd_active: rd_is_capable(fid, cx.rd_capable) }
}

# The leaves of a body whose result is checked by a postcondition before it returns: `{ let r = body; assert ..; r }`.
fn tr_checked_leaves(body: Expr) : [Expr] = match body.kind {
  EBlock(stmts, Some(t)) -> match t.kind {
    ELocal(x) -> if any(stmts, tr_is_check) { tr_let_leaves(stmts, x) } else { [] }
    _         -> []
  }
  _ -> []
}

fn tr_is_check(s: Stmt) : Bool = match s {
  SAssert(_, _) -> true
  _             -> false
}

fn tr_let_leaves(stmts: [Stmt], x: LocalId) : [Expr] = match stmts {
  [] -> []
  [SLet(p, _, rhs), ...rest] -> match p.pkind {
    PBind(b) -> if local_eq(b.id, x) { tail_leaves(rhs) } else { tr_let_leaves(rest, x) }
    _        -> tr_let_leaves(rest, x)
  }
  [_, ...rest] -> tr_let_leaves(rest, x)
}

# The body Perceus wrapped in its result slot, unwrapped.
fn tr_inner(body: Expr) : Expr = match body.kind {
  EBlock(stmts, Some(t)) -> match t.kind {
    ELocal(l) -> if ret_slot_id_is_fn(l) {
      match tcrec_find_pcs_ret_let(stmts, []) {
        Some(TcrecPcsTriple(_, inner, _)) -> inner
        None                              -> body
      }
    } else { body }
    _ -> body
  }
  _ -> body
}

# A function with no home of its own belongs to the module being built.
fn tr_homed(mo: Option[String], cx: EmitCtx) : Bool = match mo {
  None    -> true
  Some(h) -> match cx.root_mod {
    Some(t) -> h == t
    None    -> false
  }
}

fn tr_leaf(caller: FnId, leaf: Expr, checked: Bool, cx: EmitCtx) : [TrMiss] = match leaf.kind {
  ECall(f, xs) -> match f.kind {
    EMark(MkTailStep(s)) -> match xs {
      [call] -> match tail_verdict(call, s, tr_arity(call), tr_raw(caller, cx), cx) {
        TjCall(why) -> [TrMiss { caller: caller, callee: Some(s.fid), line: leaf.line, col: leaf.col, why: why }]
        _           -> []
      }
      _ -> []
    }
    EMark(MkApplyBorrow) -> [TrMiss { caller: caller, callee: None, line: leaf.line, col: leaf.col, why: TwClosure }]
    EMark(_) -> []
    ESym(_, _) -> match callee_fnid(f) {
      Some(g) ->
        if is_none(fnx_callee(cx.fx, g)) or (fnid_eq(g, caller) and not checked) or tr_surrounded(leaf, cx) { [] }
        else { [TrMiss { caller: caller, callee: Some(g), line: leaf.line, col: leaf.col,
                         why: if checked { TwCheck } else { TwBorrow } }] }
      None    -> []
    }
    ECall(_, _) -> [TrMiss { caller: caller, callee: None, line: leaf.line, col: leaf.col, why: TwClosure }]
    ELocal(_) -> [TrMiss { caller: caller, callee: None, line: leaf.line, col: leaf.col, why: TwClosure }]
    _ -> []
  }
  _ -> []
}

# A call inside an unwind bracket, a region or a donating function is not in tail position.
fn tr_surrounded(call: Expr, cx: EmitCtx) : Bool = cx.in_region or cx.rd_active or unw_bracketed(cx.unw, call, (n) => emit_unw_local(n, cx))

fn tr_arity(call: Expr) : Int = match call.kind {
  ECall(_, xs) -> list_length(xs)
  _            -> 0
}

fn tr_raw(caller: FnId, cx: EmitCtx) : Bool = match fnx_ufn_sig_first(cx.fx, caller) {
  Some(US(_, rt, _)) -> ty_is_unboxable_t(rt)
  None               -> false
}

fn tr_print(misses: [TrMiss], cyclic: SymSet, cx: EmitCtx) : Unit / Console = match misses {
  [] -> ()
  [m, ...rest] -> {
    if sym_set_has(cyclic, fnid_sym(m.caller)) and tr_on_cycle(m, cyclic) {
      eprint(tailreport_text(tr_name(m.caller, cx), tr_callee(m.callee, cx), m.line, m.col, m.why))
    } else { () }
    tr_print(rest, cyclic, cx)
  }
}

fn tr_on_cycle(m: TrMiss, cyclic: SymSet) : Bool = match m.callee {
  Some(g) -> sym_set_has(cyclic, fnid_sym(g))
  None    -> true
}

fn tr_name(f: FnId, cx: EmitCtx) : String = tailreport_declared(sym_name(cx.tab, fnid_sym(f)))

fn tr_callee(g: Option[FnId], cx: EmitCtx) : String = match g {
  Some(f) -> tailreport_fn(tr_name(f, cx))
  None    -> "a closure"
}
