#[doc("""
Dispatch identity for protocols, derived from the symbol table.

A protocol name is not a package-global key. Two modules may each
declare `P`, and an impl of one must not land in the other's impl
table. When a name is contested the key spells the home into it, so
each declaration mangles and keys apart — the `unit_spell` rule,
protocol edition.

Two homes keep the bare spelling. The root file has no module to
qualify with, and the stdlib cores are what the runtime impl table and
both backends key by: a core protocol's id is fixed, so respelling one
would rename a symbol the runtime already knows.

Contestedness is a property of the whole table, not of the declarations
after the current one, so the walk compares every declaring home
against the first one found.
""")]

import compiler.util
import compiler.ast
import compiler.symtab
import compiler.scope_view
import compiler.decl_names
import compiler.modules

#[doc("The dispatch key of the protocol symbol `s`: `<home>__<name>` when the name is contested and the home is a non-core module, the bare name otherwise.")]
pub fn pk_of(t: SymTab, v: ScopeView, s: SymId) : String {
  let name = sym_name(t, s)
  let owner = sym_owner(t, s)
  if pk_bare_home(t, v, owner) or not pk_contested(t, name) { name }
  else { concat_all([sym_name(t, owner), "__", name]) }
}

# The root file (no module to qualify with) and the cores (keyed by the
# runtime under their fixed bare ids) never take a spelled key.
fn pk_bare_home(t: SymTab, v: ScopeView, owner: SymId) : Bool =
  not st_valid(t, owner) or sv_is_core(v, owner)

# Contested = at least two distinct homes declare the name.
fn pk_contested(t: SymTab, name: String) : Bool =
  pk_two_homes(t, st_candidates(t, NCProtocol, name))

fn pk_two_homes(t: SymTab, cands: [SymId]) : Bool = match cands {
  []        -> false
  [s, ...rest] -> pk_other_home(t, rest, sym_owner(t, s))
}

fn pk_other_home(t: SymTab, cands: [SymId], h: SymId) : Bool = match cands {
  [] -> false
  [s, ...rest] ->
    if sym_raw(sym_owner(t, s)) == sym_raw(h) { pk_other_home(t, rest, h) }
    else { true }
}


#[doc("One dispatch key per protocol the table declares, keyed by the home the registry uses (`None` = the root file).")]
pub fn pk_table(t: SymTab, v: ScopeView, root: String) : [ProtoKey] =
  pk_rows(t, v, root, 0, [])

fn pk_rows(t: SymTab, v: ScopeView, root: String, i: Int,
      acc: [ProtoKey]) : [ProtoKey] =
  if i >= st_count(t) { list_reverse(acc) }
  else {
    let s = SymId(i)
    if pk_is_protocol(t, s) {
      pk_rows(t, v, root, i + 1, [pk_row(t, v, s, root), ...acc])
    } else { pk_rows(t, v, root, i + 1, acc) }
  }

fn pk_is_protocol(t: SymTab, s: SymId) : Bool =
  ncls_same(sym_class(t, s), NCProtocol)

fn pk_row(t: SymTab, v: ScopeView, s: SymId, root: String) : ProtoKey {
  let home = sym_name(t, sym_owner(t, s))
  PKey(sym_name(t, s), if home == root { None } else { Some(home) },
       pk_of(t, v, s))
}
