#[doc("""
The shapes a resolved pattern comes back in, and the check that a
pattern binds no name twice.
""")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.modules_binders
import compiler.resolve_env

#[doc("Add every name in `names` to the current (top) scope of `e`.")]
pub fn add_all(e: Env, names: [String]) : Env =
  reduce(names, e, (acc, n) => env_add_untyped(acc, n))

# ---- pattern bindings: number a pattern's binders and bind their names ----

#[doc("A resolved pattern, and the environment with its binders.")]
pub type RPat = RPat(Env, Pattern)

#[doc("A resolved pattern kind, and the environment with its binders.")]
pub type RPatKind = RPatKind(Env, PatKind)

#[doc("Resolved patterns, and the environment with their binders.")]
pub type RPats = RPats(Env, [Pattern])

#[doc("Resolved pattern fields, and the environment with their binders.")]
pub type RPFields = RPFields(Env, [PField])

#[doc("""
A pattern binds a name once: a second binder of it would shadow the
first with no equality checked between the two.
""")]
pub fn chk_pat_repeats(e: Env, p: Pattern) : Env / Console + File = match first_repeat(pat_binder_names(p, []), []) {
  None    -> e
  Some(n) -> {
    let d = mk_diag(SevError, e.file, p.line, p.col, "duplicate binding in pattern: `#{n}`",
                    [ri_note(e.file, p.line, p.col, "binding `#{n}` already used elsewhere in this pattern"),
                     ri_help(e.file, p.line, p.col, "use a different name, or extract the equality with a guard: `MkPair(x, y) if x == y -> ...`")])
    render_diag(d)
    env_mark_err(env_push_diag(e, d))
  }
}

fn first_repeat(names: [String], seen: [String]) : Option[String] = match names {
  [] -> None
  [n, ...rest] -> if list_has(seen, n) { Some(n) } else { first_repeat(rest, [n, ...seen]) }
}
