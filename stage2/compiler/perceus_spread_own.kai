# A list spread consumes its operand, exactly like a ctor slot: a trailing
# `[..., ...xs]` stores it as the list's tail, a middle one hands it to
# `kai_core_list_append`, which releases it.
#
# The one operand shape that arrives without a reference of its own is a
# BORROWED binder read bare: the function never owned it, so perceus leaves
# its rc alone. Consuming that read releases a reference the caller still
# owns, and the caller's next read of the borrowed value is a use-after-free.
#
# This pass dups those reads, and only those, before reuse recognition turns
# a cons literal into a reuse cell whose tail slot consumes the same way.

import compiler.ast
import compiler.ast_map
import compiler.perceus_let_own

#[doc("Dup every bare read of a `borrowed` binder that a list spread yields as its operand.")]
pub fn pso_own_spreads(e: Expr, borrowed: [String]) : Expr = match borrowed {
  []         -> e
  [_, ...__] -> pso_expr(e, borrowed)
}

fn pso_expr(e: Expr, borrowed: [String]) : Expr =
  Expr { kind: pso_kind(e.kind, borrowed), line: e.line, col: e.col,
         ty: e.ty, mode: e.mode }

fn pso_kind(k: ExprKind, borrowed: [String]) : ExprKind = match prc_map_expr_kind(k, (x) => pso_expr(x, borrowed)) {
  EList(els) -> EList(map(els, (el) => pso_elem(el, borrowed)))
  k1         -> k1
}

fn pso_elem(el: ListElem, borrowed: [String]) : ListElem = match el {
  ElSpread(x) -> ElSpread(plo_value(x, borrowed))
  ElPlain(_)  -> el
}
