#[doc("Atomic expressions, collection literals and record or variant aggregates.")]

import compiler.util
import compiler.lex
import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.builtins
import compiler.real_lit
import compiler.parse_state
import compiler.parse_lexical
import compiler.parse_types
import compiler.parse_stmt
import compiler.parse_control
import compiler.written
import compiler.symtab

fn call_args_sep(p: Parser, acc: [Expr]) : PArgs / Console =
  if p_at(p, TkComma) { call_args_loop(p_advance_nl(p), acc) }
  else if p_at(p, TkRparen) { ok_args(p_advance(p), list_reverse(acc)) }
  else { err_args(p_error_here(p, "expected `,` or `)` in call arguments")) }

fn call_args_loop(p: Parser, acc: [Expr]) : PArgs / Console {
  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRparen) { ok_args(p_advance(p0), list_reverse(acc)) }
  else {
    let r = p_expr(p0)
    match r.r {
      None -> err_args(r.p)
      Some(e) -> call_args_sep(p_skip_newlines(r.p), [e, ...acc])
    }
  }
}

#[doc("Parses call arguments after an opening `(`, through the closing `)`.")]
pub fn parse_call_args(p: Parser) : PArgs / Console {
  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRparen) { ok_args(p_advance(p0), []) } else { call_args_loop(p0, []) }
}

# An adjacent `<` (no space) after a literal opens a unit annotation; a spaced one is a comparison.
fn lit_unit_annotation(p: Parser, lit: Expr, t: Token) : PExpr / Console {
  let ru = parse_unit_expr(p_advance_nl(p))
  match ru.r {
    None -> err_e(ru.p)
    Some(u) -> {
      let p3 = p_eat(p_skip_newlines(ru.p), TkGt, "expected `>` to close the unit annotation on a literal")
      if p_failed(p3) { err_e(p3) } else { ok_e(p3, expr_at(ELitUnit(lit, u), t)) }
    }
  }
}

fn try_lit_unit_annotation(p: Parser, lit: Expr, t: Token) : PExpr / Console {
  let nxt = p_peek(p)
  if tk_is(nxt.kind, TkLt) and nxt.start == t.start + t.length { lit_unit_annotation(p, lit, t) }
  else { ok_e(p, lit) }
}

# A decimal literal past i64 stays an `EIntLit` so an annotation can mint it to a wider carrier.
#[doc("Parses an integer literal, with an optional adjacent unit annotation.")]
pub fn parse_int_atom(p: Parser, t: Token) : PExpr / Console {
  let span = tok_source(p.src, t)
  if not int_lit_overflows(span) {
    try_lit_unit_annotation(p_advance(p), expr_at(mk_int_lit(decode_int(span), span), t), t)
  } else if has_base_prefix(span) {
    fail_e_at(p_advance(p), t, "hex/binary literal exceeds 64 bits; Int is 64-bit — use bigint.from_string")
  } else {
    ok_e(p_advance(p), expr_at(EIntLit(span), t))
  }
}

#[doc("Parses a real literal, with an optional adjacent unit annotation.")]
pub fn parse_real_atom(p: Parser, t: Token) : PExpr / Console {
  let span = tok_source(p.src, t)
  match decode_real(span) {
    Some(r) -> try_lit_unit_annotation(p_advance(p), expr_at(EReal(RealLit(r), span), t), t)
    None -> fail_e_at(p, t, real_range_error())
  }
}

fn span_without_suffix(p: Parser, t: Token) : String {
  let span = tok_source(p.src, t)
  string_slice(span, 0, string_length(span) - 1)
}

#[doc("Parses a `<num>d` decimal literal; the typer folds the exact value.")]
pub fn parse_decimal_atom(p: Parser, t: Token) : PExpr =
  ok_e(p_advance(p), expr_at(EDecimalLit(span_without_suffix(p, t)), t))

#[doc("Parses a `<int>n` big integer literal, kept as written for surface lowering.")]
pub fn parse_bigint_atom(p: Parser, t: Token) : PExpr =
  ok_e(p_advance(p), expr_at(ESurface(SfBigIntLit(span_without_suffix(p, t))), t))

# `<digits>i` is `complex.mk(0.0, <digits>)`.
#[doc("Parses an imaginary literal `<num>i`.")]
pub fn parse_complex_atom(p: Parser, t: Token) : PExpr / Console {
  let im_span = span_without_suffix(p, t)
  match decode_real(im_span) {
    None -> fail_e_at(p, t, real_range_error())
    Some(im) -> {
      let zero = expr_at(EReal(RealLit(0.0), "0.0"), t)
      let im_e = expr_at(EReal(RealLit(im), im_span), t)
      let callee = expr_at(EField(mk_name("complex", t.line, t.col), "mk"), t)
      ok_e(p_advance(p), expr_at(ECall(callee, [zero, im_e]), t))
    }
  }
}

fn intrinsic_call(args: PArgs, name: String, t: Token) : PExpr =
  match args.r {
    None -> err_e(args.p)
    Some(xs) -> ok_e(args.p, expr_at(EIntrinsic(intrinsic_of_name(name), xs), t))
  }

# Arity and argument shape are checked by the typer.
#[doc("Parses a `$name(args)` intrinsic call at the `$`.")]
pub fn parse_intrinsic(p: Parser, t: Token) : PExpr / Console {
  let p1 = p_advance(p)
  let id = p_peek(p1)
  if not tk_is(id.kind, TkIdent) {
    fail_e_at(p1, id, "expected an intrinsic name after `$` (e.g. `$extern_handler(\"sym\")`)")
  } else {
    let p2 = p_eat(p_advance(p1), TkLparen, "expected `(` to start the intrinsic argument list — write `$NAME(args)`")
    if p_failed(p2) { err_e(p2) } else { intrinsic_call(parse_call_args(p2), tok_source(p1.src, id), t) }
  }
}

fn char_is_quote(s: String, i: Int) : Bool =
  match char_at(s, i) {
    Some(c) -> c == '"'
    None -> false
  }

fn is_triple_quoted(span: String) : Bool =
  string_length(span) >= 6 and char_is_quote(span, 0) and char_is_quote(span, 1) and char_is_quote(span, 2)

fn todo_message(p: Parser, st: Token, t: Token) : PExpr / Console {
  let span = tok_source(p.src, st)
  let body_end = string_length(span) - 1
  if is_triple_quoted(span) { fail_e_at(p, st, "`todo!` does not accept triple-quoted strings") }
  else if has_interp(span, 1, body_end) {
    fail_e_at(p, st, "`todo!` message must be a plain string literal (no interpolation)")
  } else {
    let p3 = p_eat(p_advance_nl(p), TkRparen, "expected `)` after `todo!` message")
    if p_failed(p3) { err_e(p3) } else { ok_e(p3, expr_at(ETodo(string_slice(span, 1, body_end - 1)), t)) }
  }
}

# The message is a plain string so `--holes-json` and the runtime panic agree on one static value.
#[doc("Parses `todo!(\"msg\")` at the `todo!` token.")]
pub fn parse_todo_bang(p: Parser, t: Token) : PExpr / Console {
  let p1 = p_advance(p)
  if not p_at(p1, TkLparen) { fail_e(p1, "expected `(` after `todo!`") }
  else {
    let p2 = p_advance_nl(p1)
    let st = p_peek(p2)
    if not tk_is(st.kind, TkString) {
      fail_e_at(p2, st, "`todo!` requires a literal string message: `todo!(\"...\")`")
    } else { todo_message(p2, st, t) }
  }
}

fn variants_close(p: Parser, ty: TypeExpr, t: Token) : PExpr / Console {
  let p1 = p_eat(p_skip_newlines(p), TkRbracket, "expected `]` after type in `variants[T]`")
  let p2 = p_eat(p1, TkLparen, "expected `()` after `variants[T]`")
  let p3 = p_eat(p2, TkRparen, "`variants[T]()` does not accept arguments")
  if p_failed(p3) { err_e(p3) } else { ok_e(p3, expr_at(EVariantsOf(ty, []), t)) }
}

#[doc("Parses `variants[T]()` at the `[`.")]
pub fn parse_variants_of(p: Parser, t: Token) : PExpr / Console {
  let r = parse_type(p_advance_nl(p))
  match r.r {
    None -> err_e(r.p)
    Some(ty) -> variants_close(r.p, ty, t)
  }
}

# The marker wraps the block directly (not a thunk) so it stays inline until the region pass unwraps it.
fn region_call(arg: Expr, t: Token) : Expr =
  expr_at(ECall(expr_at(EMark(MkRegion), t), [arg]), t)

fn named_region(binder: RegionBinder, t: Token) : PExpr / Console {
  let r = parse_lambda_block_body(binder.p, t)
  match r.r {
    None -> err_e(r.p)
    Some(body) -> {
      let lam = expr_at(ELambda([param_at(binder_written(binder.name), t)], body), t)
      ok_e(r.p, region_call(lam, t))
    }
  }
}

fn unnamed_region(p: Parser, t: Token) : PExpr / Console {
  let r = parse_block(p, t)
  match r.r {
    None -> err_e(r.p)
    Some(block) -> ok_e(r.p, region_call(block, t))
  }
}

# Only a single identifier followed by `->` names a region; patterns and parameter lists do not.
fn region_binder_name(p: Parser) : Option[RegionBinder] =
  if not p_at(p, TkIdent) { None }
  else {
    let p1 = p_advance(p)
    if p_at(p1, TkArrow) { Some(RegionBinder { p: p_advance(p1), name: tok_source(p.src, p_peek(p)) }) }
    else { None }
  }

#[doc("Parses `region { ... }` or `region { r -> ... }` at the `{`.")]
pub fn parse_region(p: Parser, t: Token) : PExpr / Console =
  match region_binder_name(p_advance_nl(p)) {
    Some(binder) -> named_region(binder, t)
    None -> unnamed_region(p, t)
  }

fn ensure_close(p: Parser, value: Expr, t: Token) : PExpr / Console {
  let p3 = p_eat(p_skip_newlines(p), TkRparen, "expected `)` after value in `ensure(...)`")
  if p_failed(p3) { err_e(p3) }
  else if not p_at(p3, TkWhere) {
    ok_e(p3, expr_at(ECall(mk_name("ensure", t.line, t.col), [value]), t))
  } else {
    let pr = parse_refinement_predicate(p_advance_nl(p3), t.line, t.col)
    match pr.r {
      None -> err_e(pr.p)
      Some(pred) -> ok_e(pr.p, expr_at(ESurface(SfEnsure(value, pred)), t))
    }
  }
}

# Without a `where` suffix `ensure(v)` stays an ordinary call, so a user function of that name works.
#[doc("Parses `ensure(value) where pred` at the `(`.")]
pub fn parse_ensure_primary(p: Parser, t: Token) : PExpr / Console {
  let rv = p_expr(p_advance_nl(p))
  match rv.r {
    None -> err_e(rv.p)
    Some(value) -> ensure_close(rv.p, value, t)
  }
}

#[doc("Parses a list or range literal.")]
pub fn parse_list_or_range(p: Parser, t: Token) : PExpr / Console = {
  let p1 = p_advance_nl(p)
  if p_at(p1, TkRbracket) { ok_e(p_advance(p1), expr_at(EList([]), t)) }
  else { list_elem(p1, [], t) }
}

# The first element of a list that is not a spread may open a range: `[first..last]`.
fn list_elem(p: Parser, acc: [ListElem], t: Token) : PExpr / Console = {
  let spread = p_at(p, TkEllipsis)
  let r = p_expr(if spread { p_advance(p) } else { p })
  match r.r {
    None -> r
    Some(e) -> {
      let p1 = p_skip_newlines(r.p)
      if list_is_empty(acc) and not spread and p_at(p1, TkDotDot) { range_end(p, p1, e, t) }
      else { list_rest(r.p, [if spread { ElSpread(e) } else { ElPlain(e) }, ...acc], t) }
    }
  }
}

fn list_rest(p: Parser, acc: [ListElem], t: Token) : PExpr / Console = {
  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbracket) { list_done(p_advance(p0), acc, t) }
  else if p_at(p0, TkDotDot) { stepped_range(p0, acc, t) }
  else if p_at(p0, TkComma) { list_after_comma(p_advance_nl(p0), acc, t) }
  else { fail_e(p0, "expected `,` or `]` in list") }
}

fn list_after_comma(p: Parser, acc: [ListElem], t: Token) : PExpr / Console =
  if p_at(p, TkRbracket) { list_done(p_advance(p), acc, t) } else { list_elem(p, acc, t) }

fn list_done(p: Parser, acc: [ListElem], t: Token) : PExpr = ok_e(p, expr_at(EList(list_reverse(acc)), t))

#[doc("Parses a `lazy` sequence literal.")]
pub fn parse_lazy(p: Parser, t: Token) : PExpr / Console = {
  let p1 = p_advance(p)
  if not p_at(p1, TkLbracket) {
    fail_e(p1, "`lazy` opens a lazy sequence and takes a list or a range — write `lazy [...]`")
  } else {
    lazy_bracket(restore_rl(p.allow_record_lit, parse_list_or_range(p_with_record_lit(p1, true), p_peek(p1))), t)
  }
}

fn lazy_bracket(r: PExpr, t: Token) : PExpr / Console =
  match r.r {
    None -> r
    Some(bracket) ->
      if spread_before_last(bracket) {
        fail_e_at(r.p, t, "a spread in `lazy [...]` is the rest of the sequence, so it comes last — write `lazy [a, ...rest]`")
      } else { ok_e(r.p, expr_at(ESurface(SfLazy(bracket)), t)) }
  }

fn spread_before_last(bracket: Expr) : Bool = match bracket.kind {
  EList(elems) -> any(drop(list_reverse(elems), 1), (el) => match el { ElSpread(_) -> true ElPlain(_) -> false })
  _            -> false
}

# `[first..last]`: `p0` is at `first` and `p1` at the `..` after it.
fn range_end(p0: Parser, p1: Parser, first: Expr, t: Token) : PExpr / Console = {
  let pe = p_advance_nl(p1)
  if p_at(pe, TkRbracket) { ok_e(p_advance(pe), expr_at(ESurface(SfEndlessRange(first, None)), t)) }
  else { range_last(p0, p1, first, p_expr(pe), t) }
}

fn range_last(p0: Parser, p1: Parser, first: Expr, r: PExpr, t: Token) : PExpr / Console =
  match r.r {
    None -> r
    Some(last) -> {
      let p2 = p_skip_newlines(r.p)
      if p_at(p2, TkRbracket) { ok_e(p_advance(p2), expr_at(ERange(first, last, None), t)) }
      else if p_at(p2, TkDotDot) { err_e(reject_trailing_step(p0, p1, p2, first)) }
      else { fail_e(p2, "expected `]` at end of range") }
    }
  }

# `[from..to..step]` is not a form: the error spells the stepped range the author meant.
fn reject_trailing_step(p0: Parser, p1: Parser, p2: Parser, first: Expr) : Parser / Console = {
  let r = p_expr(p_advance_nl(p2))
  match r.r {
    None -> r.p
    Some(step) -> p_error_here(p2, trailing_step_msg(p0, p1, p2, r.p, first, step))
  }
}

fn trailing_step_msg(p0: Parser, p1: Parser, p2: Parser, pe: Parser, first: Expr, step: Expr) : String = {
  let from = src_between(p0, p1, 0)
  let second = match lit_pair(first, step) {
    Some(q) -> int_to_string(q.a + q.b)
    None    -> concat_all([from, " + ", src_between(p2, pe, 2)])
  }
  concat_all(["a stepped range is written `[first, second..last]`, its step being `second - first`",
              " — write `[", from, ", ", second, "..", src_between(p1, p2, 2), "]`"])
}

# `[first, second..last]`: `p` is at the `..` and `acc` holds the elements before it, newest first.
fn stepped_range(p: Parser, acc: [ListElem], t: Token) : PExpr / Console = match acc {
  [ElPlain(second), ElPlain(first)] -> {
    let pe = p_advance_nl(p)
    if p_at(pe, TkRbracket) { stepped_range_at(pe, first, second, None, t) }
    else { stepped_last(p_expr(pe), first, second, t) }
  }
  _ -> fail_e(p, "a stepped range takes exactly two elements before `..` — write `[first, second..last]`")
}

fn stepped_last(r: PExpr, first: Expr, second: Expr, t: Token) : PExpr / Console =
  match r.r {
    None -> r
    Some(last) -> {
      let p1 = p_skip_newlines(r.p)
      if p_at(p1, TkRbracket) { stepped_range_at(p1, first, second, Some(last), t) }
      else { fail_e(p1, "expected `]` at end of range") }
    }
  }

# `p` is at the `]` closing a stepped range; with no `last` it is endless.
fn stepped_range_at(p: Parser, first: Expr, second: Expr, last: Option[Expr], t: Token) : PExpr / Console =
  match literal_step(first, second) {
    Some(0) -> fail_e_at(p, t, "the first two elements of a stepped range must differ: their difference is the step, and a step of zero never ends")
    _       -> ok_e(p_advance(p), expr_at(ESurface(match last {
      Some(hi) -> SfSteppedRange(first, second, hi)
      None     -> SfEndlessRange(first, Some(second))
    }), t))
  }

#[doc("Parses the rest of an index after its first expression, allowing a range.")]
pub fn parse_index_range(p: Parser, first: Expr) : PExpr / Console = {
  let p1 = p_skip_newlines(p)
  if p_at(p1, TkDotDot) { index_to(p_expr(p_advance_nl(p1)), first) } else { ok_e(p, first) }
}

fn index_to(r: PExpr, first: Expr) : PExpr / Console =
  match r.r {
    None -> r
    Some(to) -> {
      let p2 = p_skip_newlines(r.p)
      if p_at(p2, TkDotDot) { index_step(p_expr(p_advance_nl(p2)), first, to) }
      else { ok_e(p2, mk_expr(ERange(first, to, None), first.line, first.col)) }
    }
  }

fn index_step(r: PExpr, first: Expr, to: Expr) : PExpr =
  match r.r {
    None -> r
    Some(step) -> ok_e(r.p, mk_expr(ERange(first, to, Some(step)), first.line, first.col))
  }

#[doc("""
A list has an end: `r` is the bracket `p` opens, and a range without
one is an error that spells the lazy sequence it is.
""")]
pub fn reject_endless(p: Parser, r: PExpr) : PExpr / Console = match r.r {
  None    -> r
  Some(e) -> match e.kind {
    ESurface(SfEndlessRange(_, _)) ->
      fail_e_at(r.p, p_peek(p), concat_all(["a list has an end; a range without one is a lazy sequence — write `lazy ", src_between(p, r.p, 0), "`"]))
    _ -> r
  }
}

fn src_between(a: Parser, b: Parser, skip: Int) : String {
  let lo = p_peek(a).start + skip
  trim(string_slice(a.src, lo, p_peek(b).start - lo))
}

type LitPair = { a: Int, b: Int }

fn lit_pair(x: Expr, y: Expr) : Option[LitPair] = match try_int_literal(x) {
  Some(a) -> match try_int_literal(y) {
    Some(b) -> Some(LitPair { a: a, b: b })
    None    -> None
  }
  None -> None
}

#[doc("The step of a stepped range whose leading elements fix it: two Int literals, two Char literals, or `second` written as the name `first` plus a literal.")]
pub fn literal_step(first: Expr, second: Expr) : Option[Int] = match first.kind {
  EChar(a) -> match second.kind {
    EChar(b) -> Some(char_to_int(b) - char_to_int(a))
    _        -> None
  }
  EName(_) -> name_step(first, second)
  _ -> match lit_pair(first, second) {
    Some(q) -> Some(q.b - q.a)
    None    -> None
  }
}

fn name_step(first: Expr, second: Expr) : Option[Int] = match second.kind {
  EBinop(BoAdd, base, k) -> if same_name(first, base) { try_int_literal(k) } else { None }
  _                      -> None
}

fn same_name(a: Expr, b: Expr) : Bool = match a.kind {
  EName(x) -> match b.kind {
    EName(y) -> written_text(x) == written_text(y)
    _        -> false
  }
  _ -> false
}

type RecLit = { ty: DeclRef, tok: Token }
type RecMode = RmNamed | RmSpread | RmPositional

#[doc("Parses a record literal after its type name.")]
pub fn parse_record_lit(p: Parser, type_name: DeclRef, tname: Token) : PExpr / Console {
  let rc = RecLit { ty: type_name, tok: tname }
  let p1 = p_advance_nl(p)
  if p_at(p1, TkRbrace) { rec_closed(p_advance(p1), [], rc) }
  else if p_at(p1, TkEllipsis) { rec_spread_first(p_advance_nl(p1), rc) }
  else if starts_named(p1) { rec_named_loop(p1, [], rc) }
  else { rec_pos_loop(p1, [], rc) }
}

# A bare ident followed by `:`, `,` or `}` starts the named form (`{ x, y }` puns); anything else is
# positional, and `desugar_pos_records_decls` names the fields later.
fn starts_named(p: Parser) : Bool = {
  let follow = p_peek1(p).kind
  tk_is(p_peek(p).kind, TkIdent) and (tk_is(follow, TkColon) or tk_is(follow, TkComma) or tk_is(follow, TkRbrace))
}

fn rec_closed(p: Parser, acc: [FieldInit], rc: RecLit) : PExpr =
  ok_e(p, expr_at(ERecordLit(rc.ty, list_reverse(acc)), rc.tok))

fn rec_loop(mode: RecMode, p: Parser, acc: [FieldInit], rc: RecLit) : PExpr / Console =
  match mode {
    RmNamed -> rec_named_loop(p, acc, rc)
    RmSpread -> rec_spread_loop(p, acc, rc)
    RmPositional -> rec_pos_loop(p, acc, rc)
  }

fn rec_item_end(p: Parser, acc: [FieldInit], mode: RecMode, rc: RecLit, msg: String) : PExpr / Console = {
  let p1 = p_skip_newlines(p)
  if p_at(p1, TkComma) { rec_loop(mode, p_advance_nl(p1), acc, rc) }
  else if p_at(p1, TkRbrace) { rec_closed(p_advance(p1), acc, rc) }
  else { fail_e(p1, msg) }
}

fn rec_field_value(p1: Parser, fname: String, acc: [FieldInit], mode: RecMode, rc: RecLit) : PExpr / Console = {
  let r = p_expr(p_advance_nl(p1))
  match r.r {
    None -> r
    Some(val) -> rec_item_end(r.p, [FI(fname, val), ...acc], mode, rc, "expected `,` or `}` in record literal")
  }
}

# `T { ...src, x: 10 }`: the spread comes first, and only named overrides may follow.
fn rec_spread_first(p: Parser, rc: RecLit) : PExpr / Console = {
  let r = p_expr(p)
  match r.r {
    None -> r
    Some(src) -> rec_spread_end(p_skip_newlines(r.p), [mk_field_spread(src)], rc)
  }
}

fn rec_spread_end(p: Parser, acc: [FieldInit], rc: RecLit) : PExpr / Console =
  if p_at(p, TkRbrace) { rec_closed(p_advance(p), acc, rc) }
  else if p_at(p, TkComma) { rec_spread_loop(p_advance_nl(p), acc, rc) }
  else { fail_e(p, "expected `,` or `}` after `...` source in record literal") }

fn rec_spread_loop(p: Parser, acc: [FieldInit], rc: RecLit) : PExpr / Console = {
  let p0 = p_skip_newlines(p)
  let tk = p_peek(p0)
  if p_at(p0, TkRbrace) { rec_closed(p_advance(p0), acc, rc) }
  else if p_at(p0, TkEllipsis) { fail_e(p0, "record literal admits a single `...` spread; remove the second one") }
  else if not tk_is(tk.kind, TkIdent) {
    fail_e(p0, "expected named field override (`x: expr`) after `...` in record literal")
  }
  else { rec_override(p_advance(p0), tok_source(p0.src, tk), acc, rc) }
}

fn rec_override(p1: Parser, fname: String, acc: [FieldInit], rc: RecLit) : PExpr / Console =
  if p_at(p1, TkColon) { rec_field_value(p1, fname, acc, RmSpread, rc) }
  else {
    fail_e(p1, "spread record overrides must use named field syntax `x: expr`; pun shorthand is not allowed after `...`")
  }

fn rec_pos_loop(p: Parser, acc: [FieldInit], rc: RecLit) : PExpr / Console = {
  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) { rec_closed(p_advance(p0), acc, rc) }
  else if p_at(p0, TkIdent) and tk_is(p_peek1(p0).kind, TkColon) {
    fail_e(p0, "expected positional or all-named record fields, found mixed forms")
  }
  else { rec_pos_item(p_expr(p0), acc, rc) }
}

fn rec_pos_item(r: PExpr, acc: [FieldInit], rc: RecLit) : PExpr / Console =
  match r.r {
    None -> r
    Some(val) -> rec_item_end(r.p, [mk_field_pos(val), ...acc], RmPositional, rc,
                              "expected `,` or `}` in positional record literal")
  }

fn rec_named_loop(p: Parser, acc: [FieldInit], rc: RecLit) : PExpr / Console = {
  let p0 = p_skip_newlines(p)
  let tk = p_peek(p0)
  if tk_is(tk.kind, TkEllipsis) {
    fail_e(p0, "`...` must be the first item in a record literal — found a field before the spread")
  }
  else if tk_is(tk.kind, TkRbrace) { rec_closed(p_advance(p0), acc, rc) }
  else if not tk_is(tk.kind, TkIdent) { fail_e(p0, "expected field name in record literal") }
  else { rec_named_field(p_advance(p0), tk, acc, rc) }
}

# `{ x, y }` puns to `{ x: x, y: y }`, the value wrapped in `SfFieldPun` so the writer restores it.
fn rec_named_field(p1: Parser, tk: Token, acc: [FieldInit], rc: RecLit) : PExpr / Console = {
  let fname = tok_source(p1.src, tk)
  if p_at(p1, TkColon) { rec_field_value(p1, fname, acc, RmNamed, rc) }
  else if p_at(p1, TkComma) { rec_named_loop(p_advance_nl(p1), [rec_pun(fname, tk), ...acc], rc) }
  else if p_at(p_skip_newlines(p1), TkRbrace) {
    rec_closed(p_advance(p_skip_newlines(p1)), [rec_pun(fname, tk), ...acc], rc)
  }
  else { fail_e(p1, "expected `:`, `,`, or `}` after field name in record literal") }
}

fn rec_pun(fname: String, tk: Token) : FieldInit = mk_field_pun(fname, mk_name(fname, tk.line, tk.col))

type Coll = CollMap | CollSet

#[doc("Parses a `%{...}` map or `%[...]` set literal.")]
pub fn parse_collection_lit(p: Parser, t: Token) : PExpr / Console = {
  let after = p_peek1(p).kind
  if tk_is(after, TkLbrace) { coll_start(CollMap, p_advance(p_advance(p)), t) }
  else if tk_is(after, TkLbracket) { coll_start(CollSet, p_advance(p_advance(p)), t) }
  else { fail_e(p, "expected expression") }
}

fn coll_close(c: Coll) : TokKind = match c {
  CollMap -> TkRbrace
  CollSet -> TkRbracket
}

fn coll_close_text(c: Coll) : String = match c {
  CollMap -> "}"
  CollSet -> "]"
}

fn coll_noun(c: Coll) : String = match c {
  CollMap -> "map"
  CollSet -> "set"
}

fn coll_sep_msg(c: Coll, base: Option[Expr]) : String = match base {
  None    -> "expected `,` or `#{coll_close_text(c)}` in #{coll_noun(c)} literal"
  Some(_) -> "expected `,` or `#{coll_close_text(c)}` after `...` source in #{coll_noun(c)} literal"
}

fn coll_spread_msg(c: Coll, base: Option[Expr]) : String = match base {
  None    -> "#{coll_noun(c)} literal admits a single `...` spread, and it must come first"
  Some(_) -> "#{coll_noun(c)} literal admits a single `...` spread; remove the second one"
}

# `acc` holds the items newest first: a map pushes each entry's value before its key.
fn coll_done(c: Coll, base: Option[Expr], p: Parser, acc: [Expr], t: Token) : PExpr = {
  let items = list_reverse(acc)
  ok_e(p, expr_at(ESurface(match c {
    CollMap -> SfMapLit(base, items)
    CollSet -> SfSetLit(base, items)
  }), t))
}

fn coll_start(c: Coll, p: Parser, t: Token) : PExpr / Console = {
  let p0 = p_skip_newlines(p)
  if p_at(p0, coll_close(c)) { coll_done(c, None, p_advance(p0), [], t) }
  else if p_at(p0, TkEllipsis) { coll_spread(c, p_expr(p_advance_nl(p0)), t) }
  else { coll_item(c, None, p0, [], t) }
}

fn coll_spread(c: Coll, r: PExpr, t: Token) : PExpr / Console =
  match r.r {
    None -> r
    Some(base) -> coll_after(c, Some(base), r.p, [], t)
  }

fn coll_item(c: Coll, base: Option[Expr], p: Parser, acc: [Expr], t: Token) : PExpr / Console = {
  let r = match c {
    CollMap -> map_entry(p, acc)
    CollSet -> set_elem(p, acc)
  }
  match r.r {
    None -> err_e(r.p)
    Some(acc1) -> coll_after(c, base, r.p, acc1, t)
  }
}

# After an item: the closer ends, `,` continues, a second spread is an error.
fn coll_after(c: Coll, base: Option[Expr], p: Parser, acc: [Expr], t: Token) : PExpr / Console = {
  let p0 = p_skip_newlines(p)
  if p_at(p0, coll_close(c)) { coll_done(c, base, p_advance(p0), acc, t) }
  else if p_at(p0, TkComma) { coll_next(c, base, p_advance_nl(p0), acc, t) }
  else { fail_e(p0, coll_sep_msg(c, base)) }
}

fn coll_next(c: Coll, base: Option[Expr], p: Parser, acc: [Expr], t: Token) : PExpr / Console =
  if p_at(p, coll_close(c)) { coll_done(c, base, p_advance(p), acc, t) }
  else if p_at(p, TkEllipsis) { fail_e(p, coll_spread_msg(c, base)) }
  else { coll_item(c, base, p, acc, t) }

fn map_entry(p: Parser, acc: [Expr]) : PArgs / Console = {
  let rk = p_expr(p)
  match rk.r {
    None -> err_args(rk.p)
    Some(key) -> map_value(p_skip_newlines(rk.p), key, acc)
  }
}

fn map_value(p1: Parser, key: Expr, acc: [Expr]) : PArgs / Console =
  if p_at(p1, TkColon) { map_value_end(p_expr(p_advance_nl(p1)), key, acc) }
  else { err_args(p_error_here(p1, "set element in map literal: use a set literal `%[ ]`, or write `key: value`")) }

fn map_value_end(rv: PExpr, key: Expr, acc: [Expr]) : PArgs =
  match rv.r {
    None -> err_args(rv.p)
    Some(val) -> ok_args(rv.p, [val, key, ...acc])
  }

fn set_elem(p: Parser, acc: [Expr]) : PArgs / Console = {
  let r = p_expr(p)
  match r.r {
    None -> err_args(r.p)
    Some(e) -> set_elem_end(r, e, acc)
  }
}

fn set_elem_end(r: PExpr, e: Expr, acc: [Expr]) : PArgs / Console = {
  let p1 = p_skip_newlines(r.p)
  if p_at(p1, TkColon) { err_args(p_error_here(p1, "key:value pair in set literal: use a map literal `%{ }`")) }
  else { ok_args(r.p, [e, ...acc]) }
}
