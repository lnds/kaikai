#[doc("""
Reading a reference below the resolver, where a pass asks what a name
is spelled rather than which declaration it is.

`ESym` and `EVar` are the same question to such a pass: both name
something, and the table it consults — a borrow set, a use map, a C
symbol — is keyed by the spelling. Rather than every one of those
matches growing a second arm that duplicates the first, the kind is
normalised once on the way in.

This is deliberately NOT the place to consume identity. A pass that
must know WHICH declaration a name reaches reads the `SymId` directly;
routing that question through here would throw the answer away.
""")]

import compiler.ast

#[doc("The kind as a name-reading pass sees it: a resolved reference reads as the plain name it carries.")]
pub fn sym_read_kind(k: ExprKind) : ExprKind = match k {
  ESym(_, n) -> EVar(n)
  _          -> k
}

#[doc("The expression as a name-reading pass sees it, with a resolved reference read as its plain name. The node keeps its type, position and mode.")]
pub fn sym_read_expr(e: Expr) : Expr = match e.kind {
  ESym(_, n) -> Expr { kind: EVar(n), line: e.line, col: e.col, ty: e.ty, mode: e.mode }
  _          -> e
}

#[doc("The name a reference spells, or `None` when the expression is not one.")]
pub fn sym_read_name(k: ExprKind) : Option[String] = match k {
  EVar(n)    -> Some(n)
  ESym(_, n) -> Some(n)
  _          -> None
}
