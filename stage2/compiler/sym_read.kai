#[doc("""
TEMPORARY. What is left of the pass that read a resolved reference as a
spelling.

A reference carries no spelling any more, so nothing here can answer.
Every function returns `SymReadGone`, which fits no match: each call is
to be rewritten to read the id forms (`ESym`, `ELocal`, `EOp`) directly,
and this module deleted.
""")]

import compiler.ast

#[doc("TEMPORARY. The answer of a function that can no longer answer.")]
pub type SymReadGone = | SymReadGone

#[doc("TEMPORARY. Match on `k` itself: `ESym(s, inst)`, `ELocal(l)`, `EOp(r)`.")]
pub fn sym_read_kind(k: ExprKind) : SymReadGone = SymReadGone

#[doc("TEMPORARY. See `sym_read_kind`.")]
pub fn sym_read_expr(e: Expr) : SymReadGone = SymReadGone

#[doc("TEMPORARY. See `sym_read_kind`.")]
pub fn sym_read_name(k: ExprKind) : SymReadGone = SymReadGone

#[doc("TEMPORARY. A local read is `ELocal(l)`.")]
pub fn sym_local_kind(k: ExprKind) : SymReadGone = SymReadGone

#[doc("TEMPORARY. A local read is `ELocal(l)`; nothing needs respelling.")]
pub fn sym_locals_read(e: Expr) : SymReadGone = SymReadGone

#[doc("TEMPORARY. See `sym_locals_read`.")]
pub fn sym_locals_read_decls(ds: [Decl]) : SymReadGone = SymReadGone
