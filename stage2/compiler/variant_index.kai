#[doc("""
The constructors of each sum, keyed by declaration.

`TyEnv.index` buckets an entry by the last `::`-segment of its name,
which is the constructor (`Red`, `Color::Red` and `m::Color::Red` all
bucket under `Red`). The exhaustiveness walker and the constructor
disambiguation ask the opposite question — "which constructors does
this type declare?" — so that index cannot serve them.

This index buckets a constructor under the declaration id of the type
it builds, and again under its own. A bucket holds one declaration, so
two types spelled alike never share one and no reader re-filters by
name or arity.

The typing environment stores entries by name, and a module's delta
serialises them that way, so a constructor is recognised here by the
key it was registered under: `<Type>::<Constructor>`. The payload is
generic so this module stays below `infer.kai`, which owns the entry.
""")]

import compiler.ast
import compiler.infer_index

#[doc("The constructors of every sum, newest first under the sum's declaration, and each under its own.")]
pub type VariantIndex[a] = { by_sum: NameIndex[a], by_ctor: NameIndex[a] }

#[doc("The empty variant index.")]
pub fn vix_empty() : VariantIndex[a] = VariantIndex { by_sum: idx_empty(), by_ctor: idx_empty() }

#[doc("Index `payload` under the sum `sum` declares and under the constructor `ctor`; an absent `ctor` is reachable through its sum alone.")]
pub fn vix_prepend(vx: VariantIndex[a], sum: SymId, ctor: SymId, payload: a) : VariantIndex[a] =
  VariantIndex { by_sum: idx_prepend_sym(vx.by_sum, sum, payload),
                 by_ctor: if sym_raw(ctor) < 0 { vx.by_ctor } else { idx_prepend_sym(vx.by_ctor, ctor, payload) } }

#[doc("The constructors of the sum `sum` declares, newest first; empty for an absent id.")]
pub fn vix_chain(vx: VariantIndex[a], sum: SymId) : [a] =
  if sym_raw(sum) < 0 { [] } else { idx_chain_sym(vx.by_sum, sum) }

#[doc("What is registered under the constructor `ctor`, newest first; empty for an absent id.")]
pub fn vix_of_ctor(vx: VariantIndex[a], ctor: SymId) : [a] =
  if sym_raw(ctor) < 0 { [] } else { idx_chain_sym(vx.by_ctor, ctor) }
