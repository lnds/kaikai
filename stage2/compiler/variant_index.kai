# compiler/variant_index.kai -- return-tycon index over the typing
# environment's variant entries.
#
# `TyEnv.index` buckets an entry by the last `::`-segment of its NAME,
# which is the CONSTRUCTOR (`Red`, `Color::Red` and `m::Color::Red` all
# bucket under `Red`). The exhaustiveness walker asks the opposite
# question -- "which entries construct `Color`?" -- so that index cannot
# serve it, and the walker used to scan the whole entry list per query.
#
# This index buckets the same entries by their scheme's RETURN tycon,
# which is exactly the walker's query key. Membership is the only thing
# narrowed: the returned chain is the entries-order subsequence of
# candidates, and the walker re-applies its full predicate (uppercase,
# dot/`::` shape, arity pin, sentinel boundary) over it, so the accepted
# set is unchanged.
#
# The payload is generic so this module stays below `infer.kai`, which
# owns `TyEntry`; the caller supplies each entry's bucket key.

import compiler.infer_index

#[doc("Index from a return-tycon name to the entries constructing it.")]
pub type VariantIndex[a] = { ix: NameIndex[a] }

#[doc("The empty variant index.")]
pub fn vix_empty() : VariantIndex[a] = VariantIndex { ix: idx_empty() }

#[doc("Index `payload` under the type its scheme constructs.")]
pub fn vix_prepend(vx: VariantIndex[a], key: Option[String], payload: a) : VariantIndex[a] =
  match key {
    Some(k) -> VariantIndex { ix: idx_prepend(vx.ix, k, payload) }
    None    -> vx
  }

#[doc("Entries whose return tycon is `tycon`, newest-first.")]
pub fn vix_chain(vx: VariantIndex[a], tycon: String) : [a] =
  idx_chain(vx.ix, tycon)

#[doc("Type name closed by a `<tname>::__type_decl_arity_<N>__` sentinel.")]
pub fn vix_marker_target(name: String) : Option[String] = {
  let i = vix_marker_sep(name, 0)
  if i < 0 { None } else { Some(string_slice(name, 0, i)) }
}

# Index of the `::` opening the arity-marker suffix, or -1. Matching the
# whole tag (not just a `::__` prefix) keeps an unrelated `Mod::__helper`
# key out of the type's bucket.
fn vix_marker_sep(name: String, i: Int) : Int = {
  let n = string_length(name)
  if i + 2 >= n { -1 }
  else if vix_marker_starts_at(name, i, n) { i }
  else { vix_marker_sep(name, i + 1) }
}

fn vix_marker_starts_at(name: String, i: Int, n: Int) : Bool = {
  let sep = vix_at(name, i) == ':' and vix_at(name, i + 1) == ':'
  if sep { vix_is_marker_tag(string_slice(name, i + 2, n - (i + 2))) } else { false }
}

# `__type_decl_arity_<N>__`, with at least one digit.
fn vix_is_marker_tag(tag: String) : Bool = {
  let head = "__type_decl_arity_"
  let hn = string_length(head)
  let tn = string_length(tag)
  if tn < hn + 3 { false }
  else if string_slice(tag, 0, hn) != head { false }
  else { string_slice(tag, tn - 2, 2) == "__" }
}

fn vix_at(s: String, i: Int) : Char = match char_at(s, i) {
  Some(c) -> c
  None    -> ' '
}
