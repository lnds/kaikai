#[doc("""
A set of names that answers whether a span of source text spells one of
them, reading the source in place.

Slicing a word out to look it up would intern every word scanned, and
walking the whole name list per word is quadratic over a file.
""")]

import compiler.util

#[doc("Names bucketed by first byte, last byte and length, so a span is compared only with the names it could equal.")]
pub type SpanNames = { cap: Int, slots: Array[[String]] }

#[doc("The set holding `names`.")]
pub fn span_names(names: [String]) : SpanNames = {
  let cap = 4 * list_length(names) + 16
  SpanNames { cap: cap, slots: sn_fill(array_make(cap, []), cap, names) }
}

fn sn_fill(slots: Array[[String]], cap: Int, names: [String]) : Array[[String]] / Mutable = match names {
  []           -> slots
  [n, ...rest] -> {
    let len = string_length(n)
    let b = sn_slot(char_at_or_zero(n, 0), char_at_or_zero(n, len - 1), len, cap)
    let chain = array_get(slots, b)
    if list_has(chain, n) { sn_fill(slots, cap, rest) }
    else { sn_fill(array_set(slots, b, [n, ...chain]), cap, rest) }
  }
}

fn sn_slot(first: Char, last: Char, len: Int, cap: Int) : Int =
  (char_to_int(first) * 61 + char_to_int(last) * 13 + len * 7) % cap

#[doc("True when the `len` bytes of `src` at `start` spell a name of `set`.")]
pub fn span_names_has(set: SpanNames, src: String, start: Int, len: Int) : Bool =
  span_in(src, start, len,
          array_get(set.slots, sn_slot(char_at_or_zero(src, start), char_at_or_zero(src, start + len - 1), len, set.cap)))

#[doc("True when the `len` bytes of `src` at `start` spell one of `names`.")]
pub fn span_in(src: String, start: Int, len: Int, names: [String]) : Bool = match names {
  []           -> false
  [n, ...rest] -> span_eq(src, start, len, n) or span_in(src, start, len, rest)
}

fn span_eq(src: String, start: Int, len: Int, name: String) : Bool =
  len == string_length(name) and span_eq_loop(src, start, name, 0, len)

fn span_eq_loop(src: String, start: Int, name: String, i: Int, n: Int) : Bool =
  if i >= n { true }
  else if char_at_or_zero(src, start + i) == char_at_or_zero(name, i) { span_eq_loop(src, start, name, i + 1, n) }
  else { false }
