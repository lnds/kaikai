# Call-argument passing: masked argument lists, owned-borrow plans and evidence-frame call sequences.

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.builtins
import compiler.core_builtins
import compiler.core_types
import compiler.effect_instance
import compiler.emit_c_ctx
import compiler.emit_c_rawtypes
import compiler.emit_reuse
import compiler.emit_seq
import compiler.emit_shared_syms
import compiler.emit_tcrec_live
import compiler.fn_index
import compiler.fnreg
import compiler.handler_alias
import compiler.local_names
import compiler.marks
import compiler.protos_derive_binser
import compiler.resolve_names
import compiler.spec_names
