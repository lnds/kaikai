#[doc("""
The call rewrite that routes protocol calls to their dispatchers, and the check for calls still reaching one.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_binders
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.operators
import compiler.core_refs
import compiler.impl_identity
import compiler.proto_ids
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.diag_type_text
import compiler.protos_find_impl
import compiler.proto_resolve
import compiler.protos_registry
import compiler.protos_derive_check
import compiler.protos
import compiler.symtab
import compiler.diag_file
import compiler.diag

# AST-functor family mirror (`proto_map_*`) — copied verbatim from the
# `inf_map_*` family in compiler/infer.kai.
fn proto_map_arm_exprs(a: Arm, f: (Expr) -> Expr) : Arm {
  match a {
    Arm(p, g, b) -> Arm(p, proto_map_opt_expr(g, f), f(b))
  }
}

fn proto_map_clause_exprs(c: HClause, f: (Expr) -> Expr) : HClause {
  match c {
    HC(n, ps, b, l, co) -> HC(n, ps, f(b), l, co)
  }
}

fn proto_map_elem_exprs(el: ListElem, f: (Expr) -> Expr) : ListElem {
  match el {
    ElPlain(x)  -> ElPlain(f(x))
    ElSpread(x) -> ElSpread(f(x))
  }
}

fn proto_map_field_exprs(fi: FieldInit, f: (Expr) -> Expr) : FieldInit {
  match fi {
    FI(n, v) -> FI(n, f(v))
  }
}

fn proto_map_opt_expr(opt: Option[Expr], f: (Expr) -> Expr) : Option[Expr] {
  match opt {
    Some(e) -> Some(f(e))
    None    -> None
  }
}

fn proto_map_opt_return_exprs(opt: Option[HReturn], f: (Expr) -> Expr) : Option[HReturn] {
  match opt {
    Some(r) -> Some(proto_map_return_exprs(r, f))
    None    -> None
  }
}

fn proto_map_return_exprs(r: HReturn, f: (Expr) -> Expr) : HReturn {
  match r {
    HR(p, b, l, c) -> HR(p, f(b), l, c)
  }
}

fn proto_map_stmt_exprs(s: Stmt, f: (Expr) -> Expr) : Stmt {
  match s {
    SLet(p, ann, rhs)           -> SLet(p, ann, f(rhs))
    SAssert(c, m)               -> SAssert(f(c), proto_map_opt_expr(m, f))
    SExprStmt(x)                -> SExprStmt(f(x))
    SIndexAssign(b, i, v, l, c) -> SIndexAssign(f(b), f(i), f(v), l, c)
    SAssign(b, v, l, c) -> SAssign(f(b), f(v), l, c)
    SVar(n, ty, rhs, l, c)      -> SVar(n, ty, f(rhs), l, c)
    SUse(n, l, c)               -> SUse(n, l, c)
  }
}

fn proto_map_expr_kind(k: ExprKind, f: (Expr) -> Expr) : ExprKind {
  match k {
    EInt(_, _)        -> k
    EReal(_, _)       -> k
    EIntLit(_)        -> k
    EDecimalLit(_)    -> k
    EFixed(_, _)      -> k
    EBool(_)       -> k
    EChar(_)       -> k
    EStr(_, _)     -> k
    EUnit          -> k
    EName(_)        -> k
    EMark(_)        -> k
    ESym(_, _)      -> k
    ELocal(_)       -> k
    EOp(_)          -> k
    EUnder         -> k
    EPlaceholder   -> k
    EHole(_)       -> k
    ETodo(_)       -> k
    EExternBody(_, _) -> k
    EVariantsOf(_, _) -> k
    EModCall(_, _) -> k
    EIntrinsic(name, args_) -> EIntrinsic(name, map(args_, f))
    ESurface(sf) -> ESurface(surface_map(sf, f))
    ECall(callee, args_) -> ECall(f(callee), map(args_, f))
    EField(base, name)   -> EField(f(base), name)
    EIndex(a, b)         -> EIndex(f(a), f(b))
    EBinop(op, a, b)     -> EBinop(op, f(a), f(b))
    EUnop(op, x)         -> EUnop(op, f(x))
    EIf(c, t_, eo)       -> EIf(f(c), f(t_), proto_map_opt_expr(eo, f))
    EMatch(scr, arms)    -> EMatch(f(scr), map(arms, (a) => proto_map_arm_exprs(a, f)))
    ELambda(ps, b)       -> ELambda(ps, f(b))
    ERecordLit(rh, fs)   -> ERecordLit(rh, map(fs, (fi) => proto_map_field_exprs(fi, f)))
    EList(els)           -> EList(map(els, (el) => proto_map_elem_exprs(el, f)))
    ERange(a, b, opt_step) -> ERange(f(a), f(b), proto_map_opt_expr(opt_step, f))
    EBlock(stmts, tail)  -> EBlock(map(stmts, (s) => proto_map_stmt_exprs(s, f)),
                                    proto_map_opt_expr(tail, f))
    EPipe(a, b)          -> EPipe(f(a), f(b))
    EDispatchPipe(op, a, b) -> EDispatchPipe(op, f(a), f(b))
    EHandle(body, eff, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) ->
      EHandle(f(body), eff, eff_tyargs,
              proto_map_opt_expr(init_opt, f), alias_opt,
              map(clauses, (c) => proto_map_clause_exprs(c, f)),
              proto_map_opt_return_exprs(ret_opt, f))
    ELitUnit(inner, u)   -> ELitUnit(f(inner), u)
    EBang(inner)         -> EBang(f(inner))
  }
}

#[doc("Pass B: rewrite every resolved `op(x, ...)` to its matching impl fn across the typed program.")]
pub(pkg) fn resolve_protocol_calls(typed: TypedProgram, reg: ProtocolReg) : TypedProgram {
  TypedProgram {
    decls: map(typed.decls, (d) => resolve_protocol_calls_decl(d, reg)),
    errs: typed.errs,
    insts: typed.insts,
    holes: typed.holes,
    row_holes: typed.row_holes,
    core_len: typed.core_len,
    toplevel_len: typed.toplevel_len,
    module_doc: typed.module_doc,
    diags: typed.diags,
    op_res: typed.op_res
  }
}

#[doc("Per-decl hook of pass B; the N2 monomorph lane imports this to rewrite during monomorphisation.")]
pub(pkg) fn resolve_protocol_calls_decl(d: Decl, reg: ProtocolReg) : Decl {
  # The decl's own module scopes which protocols its calls may
  # dispatch against (`proto_visible_from`); tests and benches are
  # root-file constructs and see everything.
  match d {
    DFn(pub_, fid, tps, ps, ret, row, body, l, c, nlp, ncp, mo) ->
      DFn(pub_, fid, tps, ps, ret, row,
          resolve_protocol_calls_expr(body, reg, mo), l, c, nlp, ncp, mo)
    DTest(desc, body, l, c, mo) ->
      DTest(desc, resolve_protocol_calls_expr(body, reg, None), l, c, mo)
    DBench(desc, body, l, c, mo) ->
      DBench(desc, resolve_protocol_calls_expr(body, reg, None), l, c, mo)
    DCheck(desc, ps, body, l, c, mo) ->
      DCheck(desc, ps, resolve_protocol_calls_expr(body, reg, None), l, c, mo)
    DConst(pub_, s, ty, body, mo, l, c, nl, nc) ->
      DConst(pub_, s, ty, resolve_protocol_calls_expr(body, reg, mo), mo, l, c, nl, nc)
    _ -> d
  }
}

fn resolve_protocol_calls_expr(e: Expr, reg: ProtocolReg,
                                 cm: Option[String]) : Expr {
  let new_kind = resolve_protocol_calls_kind(e.kind, reg, cm,
                                               e.ty, e.line, e.col)
  # Issue #180: a `Real + Complex` binop was typed by the generic
  # dispatcher as `Self` (the LHS head, Real) — wrong, the heterogeneous
  # `impl Add[Complex] for Real` returns `Complex`. The rewrite above
  # has now redirected the call to that impl's `__pimpl_*` symbol; read
  # the impl's declared return head and, when it differs from the node's
  # dispatcher-derived type, correct it. This runs before unboxing, so
  # the unbox pass then sees `Complex` (boxed) instead of `Real`
  # (unboxed) and emits a `KaiValue*` record load rather than reading
  # the Complex record as a raw `double`. The impl's return IS the
  # promotion target (Int -> Real -> Complex); no type hierarchy is
  # needed beyond what the impl already declares.
  let new_ty = proto_rewrite_corrected_ty(new_kind, e.ty, reg)
  Expr { kind: new_kind, line: e.line, col: e.col, ty: new_ty, mode: e.mode,  site: e.site }
}

# When `kind` is a call of an impl that declares a return head differing
# from `cur_ty`, return the impl's return type. Otherwise return `cur_ty`
# unchanged.
fn proto_rewrite_corrected_ty(kind: ExprKind, cur_ty: Option[Ty], reg: ProtocolReg) : Option[Ty] {
  match kind {
    ECall(callee, _) -> match prc_callee_impl(callee, reg) {
      None -> cur_ty
      Some(p) -> if prc_ret_is(p, cur_ty) { cur_ty } else { pir_ret_ty(p) }
    }
    _ -> cur_ty
  }
}

# True when `cur` is headed by the impl method's declared return head.
fn prc_ret_is(p: ProtoImplReg, cur: Option[Ty]) : Bool = match p {
  PIR(_, _, _, _, _, rh, _) -> match cur {
    Some(t) -> match ty_disp_head(t) {
      Some(h) -> dh_ref_is(rh, h)
      None    -> false
    }
    None -> false
  }
}

# The impl a callee names: the entry its id was generated from.
fn prc_callee_impl(callee: Expr, reg: ProtocolReg) : Option[ProtoImplReg] = match callee.kind {
  ESym(s, _) -> pid_impl(reg.ids, s)
  _          -> None
}

fn resolve_protocol_calls_kind(k: ExprKind, reg: ProtocolReg,
                                cm: Option[String],
                                ret_ty: Option[Ty],
                                line: Int, col: Int) : ExprKind {
  match k {
    # The only kind that needs special handling: a typed `ECall` whose
    # callee resolves to a registered protocol op + args[0].ty matches
    # a registered impl gets rewritten to `__pimpl_<P>_<T>_<op>`. All
    # other kinds recurse purely structurally — there is no scope
    # bookkeeping at this stage.
    ECall(callee, args_) -> {
      let new_args = map(args_, (a) => resolve_protocol_calls_expr(a, reg, cm))
      let new_callee = match callee.kind {
        ESym(_, _) -> callee
        _          -> resolve_protocol_calls_expr(callee, reg, cm)
      }
      # Issue #180: pass the call's inferred return type so dispatchers
      # whose only Self informant is the return position (e.g.
      # `from(x) : Self` against a `let x : T = from(...)` annotation)
      # can resolve `Self` from that pin.
      let rewritten = try_rewrite_proto_call_with_ret(new_callee, new_args,
                                                       reg, cm, ret_ty)
      match rewritten {
        Some(rk) -> rk
        None     -> match prc_structural_eq(reg, new_callee, new_args, cm) {
          Some(rk) -> rk
          None     -> ECall(new_callee, new_args)
        }
      }
    }
    # Binops are sugar for Eq.eq / Ord.cmp / the operator protocols. In a
    # generic body the typer leaves them as the builtin EBinop; here, with
    # concrete operand types (post-monomorph per spec), rewrite to the
    # custom impl when the left operand's type carries one. Fully
    # structural types (no custom impl — the common case, e.g. the
    # compiler's own Expr/Stmt) keep the builtin EBinop unchanged.
    EBinop(op, l, r) -> {
      let nl = resolve_protocol_calls_expr(l, reg, cm)
      let nr = resolve_protocol_calls_expr(r, reg, cm)
      prc_rewrite_cmp_binop(op, nl, nr, reg)
    }
    # A dispatcher taken as a value is the impl its parameter types select.
    ESym(_, _) -> prc_rewrite_bare_ref(k, ret_ty, reg, cm, line, col)
    # A negation the typer left builtin over a type then unknown.
    EUnop(UoNeg, x) -> {
      let nx = resolve_protocol_calls_expr(x, reg, cm)
      match prc_neg_impl(reg, nx.ty) {
        Some(p) -> ECall(pimpl_ref(p, nx), [nx])
        None    -> EUnop(UoNeg, nx)
      }
    }
    _ -> proto_map_expr_kind(k, (sub) => resolve_protocol_calls_expr(sub, reg, cm))
  }
}

# `eq(a, b)` over a data type with no `Eq` impl is its structural `==`; it
# applies only while `Eq` is the sole protocol declaring `eq`.
fn prc_structural_eq(reg: ProtocolReg, callee: Expr, args_: [Expr], cm: Option[String]) : Option[ExprKind] =
  pid_ref_disp(reg.ids, callee) |> and_then((row) => structural_eq_call(reg, row, args_, cm))

fn structural_eq_call(reg: ProtocolReg, row: DispInfo, args_: [Expr], cm: Option[String]) : Option[ExprKind] = match args_ {
  [a, b] -> match a.ty {
    Some(TyCon(_, _)) ->
      if disp_op(row) == "eq" and list_length(proto_call_cands(reg, row, cm)) == 1 { Some(EBinop(BoEq, a, b)) } else { None }
    _ -> None
  }
  _ -> None
}

fn prc_rewrite_bare_ref(k: ExprKind, ty: Option[Ty], reg: ProtocolReg, cm: Option[String],
                        line: Int, col: Int) : ExprKind = match ty {
  Some(TyFnT(ps, ret, _)) -> {
    let args_ = map(ps, (p) => prc_mk_ty(EUnit, line, col, Some(p)))
    match try_rewrite_proto_call_with_ret(prc_mk_ty(k, line, col, ty), args_, reg, cm, Some(ret)) {
      Some(ECall(impl_ref, _)) -> impl_ref.kind
      _                        -> k
    }
  }
  _ -> k
}

# The `Neg` impl of the operand's type; a unit or a refinement on it
# does not change which impl serves it.
fn prc_neg_impl(reg: ProtocolReg, t: Option[Ty]) : Option[ProtoImplReg] = match t {
  Some(TyDimT(inner, _))    -> prc_neg_impl(reg, Some(inner))
  Some(TyRefineT(inner, _, _)) -> prc_neg_impl(reg, Some(inner))
  _                         -> prc_cmp_impl(reg, CpNeg, neg_proto_method(), t)
}

# Rewrite a binop to a custom-impl call when the left operand's type has
# one. `==`/`!=` → Eq.eq (`!=` wraps in `not`); `<`/`>`/`<=`/`>=` →
# Ord.cmp reduced to Bool against 0; `+ - * / %` → the operator
# protocol's op. An operand type with no custom impl keeps the builtin
# EBinop (which lowers to kai_op_eq_v / direct compare / arithmetic).
fn prc_op_impl(reg: ProtocolReg, bp: BinopProto, t: Option[Ty]) : Option[ProtoImplReg] =
  match op_proto_core(bp) {
    Some(cp) -> prc_cmp_impl(reg, cp, op_proto_method(bp), t)
    None     -> None
  }

# An ordering left builtin is reported at its operator; a rewrite would fail inside the container's impl.
fn prc_ord_blocked(reg: ProtocolReg, ty: Option[Ty]) : Bool = match ty {
  Some(t) -> is_some(ord_blocker((s) => prc_reg_has_impl(reg, core_proto_id(CpOrd), DhSym(s)), t))
  None    -> false
}

fn prc_rewrite_cmp_binop(op: BinOp, l: Expr, r: Expr, reg: ProtocolReg) : ExprKind {
  if binop_is_equality(op) {
    match prc_op_impl(reg, BpEq, l.ty) {
      None -> EBinop(op, l, r)
      Some(p) -> {
        let call = ECall(pimpl_ref(p, l), [l, r])
        if binop_eq(op, BoEq) { call } else { EUnop(UoNot, prc_mk_ty(call, l.line, l.col, Some(TyBool))) }
      }
    }
  } else if binop_is_ordering(op) {
    match prc_op_impl(reg, BpOrd, l.ty) {
      None -> EBinop(op, l, r)
      Some(p) -> if prc_ord_blocked(reg, l.ty) { EBinop(op, l, r) } else {
        let cmpcall = prc_mk_ty(ECall(pimpl_ref(p, l), [l, r]), l.line, l.col, Some(TyInt))
        let zero = prc_mk_ty(mk_int_synth(0), l.line, l.col, Some(TyInt))
        EBinop(op, cmpcall, zero)
      }
    }
  } else {
    match prc_arith_impl(reg, binop_proto(op), l.ty, r.ty) {
      Some(p) -> ECall(pimpl_ref(p, l), [l, r])
      None    -> EBinop(op, l, r)
    }
  }
}

# The operator protocol's impl a generic arithmetic binop reaches once
# monomorphisation made its operands concrete: both operands share a head
# with a custom impl of the homogeneous protocol (`impl Add for T` or
# `impl Add[T] for T`). A primitive operand has no head and keeps the
# builtin; a mixed-type binop was already rewritten by the typer.
fn prc_arith_impl(reg: ProtocolReg, bp: BinopProto, lt: Option[Ty], rt: Option[Ty]) : Option[ProtoImplReg] =
  match bp {
    BpEq   -> None
    BpOrd  -> None
    BpNone -> None
    _ -> match prc_con_head(lt) {
      None -> None
      Some(s) -> if not prc_same_head(rt, s) { None } else { match op_proto_core(bp) {
        None     -> None
        Some(cp) -> {
          let proto = core_proto_id(cp)
          find(impl_pool(reg, proto, DhSym(s)), (p) => prc_homogeneous(p, proto, op_proto_method(bp), DhSym(s)))
        }
      } }
    }
  }

fn prc_con_head(t: Option[Ty]) : Option[SymId] = match t {
  Some(TyCon(s, _))        -> Some(s)
  Some(TyDimT(inner, _))   -> prc_con_head(Some(inner))
  Some(TyRefineT(inner, _, _)) -> prc_con_head(Some(inner))
  _                        -> None
}

fn prc_same_head(t: Option[Ty], s: SymId) : Bool = match t {
  Some(TyCon(ts, _))        -> sym_raw(s) >= 0 and sym_raw(ts) == sym_raw(s)
  Some(TyDimT(inner, _))    -> prc_same_head(Some(inner), s)
  Some(TyRefineT(inner, _, _)) -> prc_same_head(Some(inner), s)
  _                         -> false
}

fn prc_homogeneous(p: ProtoImplReg, proto: SymId, opname: String, h: DispHead) : Bool = match p {
  PIR(_, _, op, _, args, _, _) ->
    pir_of_proto(p, proto) and prc_label_is(op, opname) and pir_serves(p, h) and is_homogeneous_args(args, h)
}

# Build an Expr with an explicit type annotation. `mk_expr` defaults
# `ty` to None; the cmp rewrite pins TyBool / TyInt so downstream
# passes see concrete types.
fn prc_mk_ty(k: ExprKind, line: Int, col: Int, ty: Option[Ty]) : Expr =
  Expr { kind: k, line: line, col: col, ty: ty, mode: MUnknown , site: 0 }

# The `impl proto` entry serving the operand's root type, by the type's
# identity. `None` when the type is fully structural (no custom impl)
# or unresolved → keep the builtin. v1 checks the root type only; a
# contained field with a custom impl is a documented follow-up (the
# compiler's own comparisons are all fully structural, so root-only
# suffices for self-host correctness).
fn prc_cmp_impl(reg: ProtocolReg, cp: CoreProto, opname: String,
                ty: Option[Ty]) : Option[ProtoImplReg] = match ty {
  None -> None
  Some(t) -> match t {
    TyCon(s, _) -> {
      let proto = core_proto_id(cp)
      find_impl_for(impl_pool(reg, proto, DhSym(s)), proto, DhSym(s), opname)
    }
    _ -> None
  }
}

# True iff `reg` holds an `impl proto for head` entry. The index
# narrows the scan to the `(proto, head)` bucket; the same membership
# predicate then runs over that short list (or the full table when the
# index is the unbuilt placeholder), so the answer is unchanged.
#[doc("True iff `reg` holds an `impl proto` entry for the receiver `h` (user or derive-synthesised); O(1) via the impl index when built.")]
pub(pkg) fn prc_reg_has_impl(reg: ProtocolReg, proto: SymId, h: DispHead) : Bool =
  prc_impls_has(impl_pool(reg, proto, h), proto, h)

fn prc_impls_has(impls: [ProtoImplReg], proto: SymId, h: DispHead) : Bool {
  match impls {
    [] -> false
    [pir, ...rest] ->
      if pir_of_proto(pir, proto) and pir_serves(pir, h) { true }
      else { prc_impls_has(rest, proto, h) }
  }
}

fn try_rewrite_proto_call_with_ret(callee: Expr, args_: [Expr],
                                     reg: ProtocolReg,
                                     cm: Option[String],
                                     ret_ty: Option[Ty]) : Option[ExprKind] {
  match try_rewrite_proto_call(callee, args_, reg, cm) {
    Some(rk) -> Some(rk)
    None -> {
      # Last-ditch: recover Self from the return type's Self position.
      match ret_ty {
        None -> None
        Some(ty) -> match pid_bare_disp(reg.ids, callee) {
          Some(row) -> {
            let opname = disp_op(row)
            # Issue #546: a return-typed op (`from(x) : Self`) may
            # also be declared by more than one protocol. Try each
            # candidate against its own return-derived Self type.
            # Decline while any argument's type is still unresolved
            # (no head) — dispatching then would be premature.
            match args_disp_heads(args_) {
              None -> None
              Some(_) ->
                try_rewrite_ret_candidates(proto_call_cands(reg, row, cm), callee, args_, reg, cm, opname, ty)
            }
          }
          None -> None
        }
      }
    }
  }
}

# Only a dispatcher is dispatched: the resolver turned every use that
# reaches a protocol operation into one, so a local or a declaration
# that shares an operation's spelling never reaches the impl table.
fn try_rewrite_proto_call(callee: Expr, args_: [Expr],
                            reg: ProtocolReg,
                            cm: Option[String]) : Option[ExprKind] {
  # With heterogeneous P[A] dispatch the receiver is not always args[0]:
  # every argument is a candidate Self, and the impl is the one whose
  # arg-name list matches the others.
  match pid_bare_disp(reg.ids, callee) {
    Some(row) -> try_rewrite_proto_candidates(proto_call_cands(reg, row, cm), callee, args_, reg, cm, disp_op(row))
    None      -> None
  }
}

# The protocols a call of the dispatcher `row` may reach. A homed twin is
# answered by its home's protocols only: the interpolation sugar's `show`
# never reaches a user protocol that declares a `show`. Any other
# dispatcher stands for its operation in every protocol declaring it,
# since a bare call carries no protocol and the receiver's type decides;
# the caller's own protocols rank first, as the scope chain ranks them.
fn proto_call_cands(reg: ProtocolReg, row: DispInfo, cm: Option[String]) : [ProtoOpReg] = {
  let all = proto_ops_lookup_all(reg, disp_op(row))
  if disp_homed(row) { pcof_matching(all, disp_home(row)) } else { proto_cands_own_first(all, cm) }
}

# Issue #546: try each protocol declaring `opname` in registry order,
# returning the first whose impl table has an entry for the receiver
# type. Candidates whose Self appears only in the return position carry
# no arg-borne Self information, so they are skipped here and left to
# the `_with_ret` wrapper. Returning `None` when no candidate matches
# preserves the prior single-protocol behaviour (residual dispatcher
# kept for the polymorphic / no-impl paths).
fn try_rewrite_proto_candidates(cands: [ProtoOpReg], callee: Expr,
                                 args_: [Expr], reg: ProtocolReg,
                                 cm: Option[String],
                                 opname: String) : Option[ExprKind] = {
  let ms = proto_matches_for(cands, args_, reg, cm, opname)
  # Two homes serving the same receiver at the head tier: the call
  # stays a dispatcher and `validate_proto_call_at` names them.
  if proto_matches_ambiguous(ms) { None }
  else { match ms {
    [] -> None
    [PMatch(_, _, p), ..._] ->
      Some(ECall(pimpl_ref(p, callee), args_))
  } }
}

# m12.8.x phase 2 (Bug 5): post-rewrite validation. After
# `resolve_protocol_calls` has rewritten every dispatchable
# `__proto_<op>(receiver, ...)` call into the matching
# `__pimpl_<P>_<T>_<op>` direct call, walk the typed AST and report
# any *remaining* dispatcher-shaped calls whose receiver type is
# concrete but has no impl. This is the compile-time error the
# `m12_8_y_postfix_no_impl` and similar negative fixtures expect.
# Calls whose receiver is still a TyVar (the polymorphic-helper
# fallthrough case the m12.8 v1 deliberately allowed) keep the
# dispatcher panic at runtime.
#[doc("Post-rewrite static-coherence check over the whole typed program.")]
pub(pkg) fn validate_resolved_protocols(typed: TypedProgram, tab: SymTab, reg: ProtocolReg,
                                df: DiagFiles) : [Diagnostic] / Console + File =
  finalize_diags(validate_resolved_decls(typed.decls, tab, reg, df, []))

#[doc("Post-rewrite static-coherence check over a decl list (used after monomorphisation). Each diagnostic names the file that declares its decl.")]
pub(pkg) fn validate_resolved_decls(ds: [Decl], tab: SymTab, reg: ProtocolReg,
                            df: DiagFiles, errs: [Diagnostic]) : [Diagnostic] / Console + File {
  match ds {
    [] -> errs
    [d, ...rest] -> {
      let file = decl_diag_file(d, df)
      # The decl's module scopes which protocols may clear its
      # residual dispatcher calls, mirroring the rewrite.
      let e1 = match d {
        DFn(_, _, _, _, _, _, body, _, _, _, _, mo) ->
          validate_resolved_expr(body, reg, tab, mo, file, errs)
        DTest(_, body, _, _, _) ->
          validate_resolved_expr(body, reg, tab, None, file, errs)
        DBench(_, body, _, _, _) ->
          validate_resolved_expr(body, reg, tab, None, file, errs)
        DCheck(_, _, body, _, _, _) ->
          validate_resolved_expr(body, reg, tab, None, file, errs)
        _ -> errs
      }
      validate_resolved_decls(rest, tab, reg, df, e1)
    }
  }
}

fn validate_resolved_expr(e: Expr, reg: ProtocolReg, tab: SymTab, cm: Option[String], file: String,
                           errs: [Diagnostic]) : [Diagnostic] / Console + File {

  let e1 = validate_proto_call_at(e, reg, tab, cm, file, errs)
  let e2 = validate_ret_dispatched_value(e, reg, cm, file, e1)
  validate_resolved_kind(e.kind, reg, tab, cm, file, e2)
}

fn validate_ret_dispatched_value(e: Expr, reg: ProtocolReg, cm: Option[String], file: String,
                                 errs: [Diagnostic]) : [Diagnostic] / Console + File = match e.kind {
  ESym(_, _) -> match pid_bare_disp(reg.ids, e) {
    Some(row) -> if any_ret_dispatched(proto_call_cands(reg, row, cm), reg) {
      let d = mk_diag(SevError, file, e.line, e.col,
        "`" ++ disp_op(row) ++ "` dispatches on its return type and is used as a value whose type does not fix it; annotate the expected type or wrap it in a lambda", [])
      push_diag(errs, d)
    } else { errs }
    None -> errs
  }
  _ -> errs
}

#[doc("True when a protocol declaring the dispatcher's operation fixes `Self` only through the return type.")]
pub(pkg) fn disp_dispatches_on_return(reg: ProtocolReg, row: DispInfo) : Bool =
  any_ret_dispatched(proto_call_cands(reg, row, None), reg)

fn any_ret_dispatched(cands: [ProtoOpReg], reg: ProtocolReg) : Bool = any(cands, (po) => match po {
  POR(psym, _, params, ret, _, _, _, _) -> proto_op_self_only_in_return(params, ret, proto_shape_carriers_at(reg.tparams, psym))
})

fn validate_resolved_opt(o: Option[Expr], reg: ProtocolReg, tab: SymTab, cm: Option[String], file: String,
                          errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match o {
    Some(e) -> validate_resolved_expr(e, reg, tab, cm, file, errs)
    None    -> errs
  }
}

fn validate_resolved_exprs(es: [Expr], reg: ProtocolReg, tab: SymTab, cm: Option[String], file: String,
                            errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match es {
    [] -> errs
    [e, ...rest] -> {
      let e1 = validate_resolved_expr(e, reg, tab, cm, file, errs)
      validate_resolved_exprs(rest, reg, tab, cm, file, e1)
    }
  }
}

fn validate_resolved_arms(arms: [Arm], reg: ProtocolReg, tab: SymTab, cm: Option[String], file: String,
                           errs: [Diagnostic]) : [Diagnostic] / Console + File =
  validate_arms_loop(arms_without_narrow_copies(arms), reg, tab, cm, file, errs)

fn validate_arms_loop(arms: [Arm], reg: ProtocolReg, tab: SymTab, cm: Option[String], file: String,
                      errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match arms {
    [] -> errs
    [a, ...rest] -> match a {
      Arm(_, g, b) -> {
        let e1 = validate_resolved_opt(g, reg, tab, cm, file, errs)
        let e2 = validate_resolved_expr(b, reg, tab, cm, file, e1)
        validate_arms_loop(rest, reg, tab, cm, file, e2)
      }
    }
  }
}

fn validate_resolved_stmts(ss: [Stmt], reg: ProtocolReg, tab: SymTab, cm: Option[String], file: String,
                            errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match ss {
    [] -> errs
    [s, ...rest] -> {
      let e1 = match s {
        SLet(_, _, rhs) -> validate_resolved_expr(rhs, reg, tab, cm, file, errs)
        SAssert(c, m) -> {
          let x = validate_resolved_expr(c, reg, tab, cm, file, errs)
          validate_resolved_opt(m, reg, tab, cm, file, x)
        }
        SExprStmt(x) -> validate_resolved_expr(x, reg, tab, cm, file, errs)
        SIndexAssign(b, i, v, _, _) -> {
          let x = validate_resolved_expr(b, reg, tab, cm, file, errs)
          let y = validate_resolved_expr(i, reg, tab, cm, file, x)
          validate_resolved_expr(v, reg, tab, cm, file, y)
        }
        SAssign(b, v, _, _) -> {
          let x = validate_resolved_expr(b, reg, tab, cm, file, errs)
          validate_resolved_expr(v, reg, tab, cm, file, x)
        }
        SVar(_, _, rhs, _, _) -> validate_resolved_expr(rhs, reg, tab, cm, file, errs)
        # m7e §25: SUse has no expression to validate.
        SUse(_, _, _) -> errs
      }
      validate_resolved_stmts(rest, reg, tab, cm, file, e1)
    }
  }
}

fn validate_resolved_clauses(cs: [HClause], reg: ProtocolReg, tab: SymTab, cm: Option[String],
                              file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match cs {
    [] -> errs
    [c, ...rest] -> match c {
      HC(_, _, b, _, _) -> {
        let e1 = validate_resolved_expr(b, reg, tab, cm, file, errs)
        validate_resolved_clauses(rest, reg, tab, cm, file, e1)
      }
    }
  }
}

fn validate_resolved_opt_return(o: Option[HReturn], reg: ProtocolReg, tab: SymTab, cm: Option[String],
                                 file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match o {
    Some(r) -> match r { HR(_, b, _, _) -> validate_resolved_expr(b, reg, tab, cm, file, errs) }
    None -> errs
  }
}

fn validate_resolved_fields(fs: [FieldInit], reg: ProtocolReg, tab: SymTab, cm: Option[String],
                             file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match fs {
    [] -> errs
    [f, ...rest] -> match f {
      FI(_, v) -> {
        let e1 = validate_resolved_expr(v, reg, tab, cm, file, errs)
        validate_resolved_fields(rest, reg, tab, cm, file, e1)
      }
    }
  }
}

fn validate_resolved_list_elems(els: [ListElem], reg: ProtocolReg, tab: SymTab, cm: Option[String],
                                 file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match els {
    [] -> errs
    [el, ...rest] -> {
      let e1 = match el {
        ElPlain(x)  -> validate_resolved_expr(x, reg, tab, cm, file, errs)
        ElSpread(x) -> validate_resolved_expr(x, reg, tab, cm, file, errs)
      }
      validate_resolved_list_elems(rest, reg, tab, cm, file, e1)
    }
  }
}

fn validate_resolved_kind(k: ExprKind, reg: ProtocolReg, tab: SymTab, cm: Option[String], file: String,
                           errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match k {
    ECall(c, args_) -> {
      let e1 = match c.kind {
        ESym(_, _) -> errs
        _          -> validate_resolved_expr(c, reg, tab, cm, file, errs)
      }
      validate_resolved_exprs(args_, reg, tab, cm, file, e1)
    }
    EBlock(ss, t) -> {
      let e1 = validate_resolved_stmts(ss, reg, tab, cm, file, errs)
      validate_resolved_opt(t, reg, tab, cm, file, e1)
    }
    EIf(c, t_, eo) -> {
      let e1 = validate_resolved_expr(c, reg, tab, cm, file, errs)
      let e2 = validate_resolved_expr(t_, reg, tab, cm, file, e1)
      validate_resolved_opt(eo, reg, tab, cm, file, e2)
    }
    EBinop(_, a, b) -> {
      let e1 = validate_resolved_expr(a, reg, tab, cm, file, errs)
      validate_resolved_expr(b, reg, tab, cm, file, e1)
    }
    EUnop(_, x) -> validate_resolved_expr(x, reg, tab, cm, file, errs)
    EHandle(body, _, _, init_opt, _, clauses, ret_opt) -> {
      let e1 = validate_resolved_expr(body, reg, tab, cm, file, errs)
      let e2 = validate_resolved_opt(init_opt, reg, tab, cm, file, e1)
      let e3 = validate_resolved_clauses(clauses, reg, tab, cm, file, e2)
      validate_resolved_opt_return(ret_opt, reg, tab, cm, file, e3)
    }
    ELambda(_, b) -> validate_resolved_expr(b, reg, tab, cm, file, errs)
    EMatch(scr, arms) -> {
      let e1 = validate_resolved_expr(scr, reg, tab, cm, file, errs)
      validate_resolved_arms(arms, reg, tab, cm, file, e1)
    }
    EPipe(a, b) -> {
      let e1 = validate_resolved_expr(a, reg, tab, cm, file, errs)
      validate_resolved_expr(b, reg, tab, cm, file, e1)
    }
    EDispatchPipe(_, a, b) -> {
      let e1 = validate_resolved_expr(a, reg, tab, cm, file, errs)
      validate_resolved_expr(b, reg, tab, cm, file, e1)
    }
    EField(base, _) -> validate_resolved_expr(base, reg, tab, cm, file, errs)
    EIndex(a, b) -> {
      let e1 = validate_resolved_expr(a, reg, tab, cm, file, errs)
      validate_resolved_expr(b, reg, tab, cm, file, e1)
    }
    ERecordLit(_, fields) -> validate_resolved_fields(fields, reg, tab, cm, file, errs)
    EList(elems) -> validate_resolved_list_elems(elems, reg, tab, cm, file, errs)
    ERange(a, b, opt_step) -> {
      let e1 = validate_resolved_expr(a, reg, tab, cm, file, errs)
      let e2 = validate_resolved_expr(b, reg, tab, cm, file, e1)
      validate_resolved_opt(opt_step, reg, tab, cm, file, e2)
    }
    EBang(inner) -> validate_resolved_expr(inner, reg, tab, cm, file, errs)
    ELitUnit(inner, _) -> validate_resolved_expr(inner, reg, tab, cm, file, errs)
    _ -> errs
  }
}
