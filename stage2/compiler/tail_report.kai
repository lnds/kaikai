#[doc("The wording of the warning about a tail call that stays a call, the same on every backend.")]

import compiler.written

#[doc("The warning that `callee` is called in tail position in `caller` at `line`, `column` (0 when unknown) and is not a guaranteed tail call, for `why`.")]
pub(pkg) fn tailreport_text(caller: String, callee: String, line: Int, column: Int, why: TailWhy) : String =
  string_concat_all(["warning: ", callee, " is called in tail position in `", caller, "`", tailreport_where(line, column),
                     " but not as a guaranteed tail call: ", tailreport_why_text(why)])

#[doc("A function as the report names it.")]
pub(pkg) fn tailreport_fn(declared: String) : String = string_concat_all(["`", declared, "`"])

#[doc("What the user wrote for a function name: a specialisation is named `module__fn__cspec__…`, so the function it was made from is the segment before the suffix.")]
pub(pkg) fn tailreport_declared(name: Written) : String = {
  let text = written_text(name)
  let head = unwrap_or(nth(split(text, "__cspec__"), 0), text)
  let base = unwrap_or(nth(split(head, "__mono__"), 0), head)
  unwrap_or(last(split(base, "__")), base)
}

fn tailreport_where(line: Int, column: Int) : String =
  if line <= 0 { "" } else { string_concat_all([" (line ", int_to_string(line), ", column ", int_to_string(column), ")"]) }

#[doc("Why a tail call is no guaranteed tail call.")]
pub(pkg) type TailWhy = TwClosure | TwNotPlain | TwResult | TwParams | TwBorrow | TwCheck

#[doc("The reason `w` as the report words it.")]
pub(pkg) fn tailreport_why_text(w: TailWhy) : String = match w {
  TwClosure  -> "the call goes through a closure"
  TwNotPlain -> "the callee is not a plain declared function"
  TwResult   -> "the result changes representation between the callee and the caller"
  TwParams   -> "the callee takes other parameters than the caller"
  TwBorrow   -> "the callee borrows an argument the caller releases after the call"
  TwCheck    -> "a postcondition is checked after the call returns"
}
