#[doc("""
What a `use` opens: the effects by owner, and the opens a file declares.
""")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.decl_names
import compiler.desugar_record_lit

#[doc("Per-effect op table built once per program.")]
pub type EffOps = EffOps(SymId, [String])

#[doc("""
The op table, and the scope a `use` name is settled in: the root
file's, whose bodies are the only ones rewritten.
""")]
pub type UseScope = { ops: [EffOps], sc: DsgScope }

# The effect a `use` names; `sym_none()` when it names none.
fn use_effect(ux: UseScope, name: String) : SymId = dsg_written_sym(ux.sc, NCEffect, name)

#[doc("""
`opens` with the effect a block-level `use` names; a name that settles
to no effect opens nothing.
""")]
pub fn use_open(ux: UseScope, name: String, opens: [SymId]) : [SymId] = {
  let eff = use_effect(ux, name)
  if sym_raw(eff) >= 0 { [eff, ...opens] } else { opens }
}

#[doc("""
Look up the effects that own a given op name within the active
opens. Callers handle zero-/one-/many-result cases.
""")]
pub fn use_owners_of(table: [EffOps], opens: [SymId], op_name: String) : [SymId] =
  use_owners_of_loop(table, opens, op_name, [])

fn use_owners_of_loop(table: [EffOps], opens: [SymId], op_name: String,
                        acc: [SymId]) : [SymId] {
  match opens {
    [] -> list_reverse(acc)
    [eff, ...rest] -> {
      let owns = match use_eff_lookup(table, eff) {
        Some(ops) -> list_has(ops, op_name)
        None      -> false
      }
      if owns { use_owners_of_loop(table, rest, op_name, [eff, ...acc]) }
      else    { use_owners_of_loop(table, rest, op_name, acc) }
    }
  }
}

fn use_eff_lookup(table: [EffOps], target: SymId) : Option[[String]] {
  match table {
    [] -> None
    [h, ...rest] -> match h {
      EffOps(n, ops) -> if sym_raw(n) == sym_raw(target) { Some(ops) } else { use_eff_lookup(rest, target) }
    }
  }
}

#[doc("The effects a `use` opens and the error count so far.")]
pub type UseOpens = { opens: [SymId], errs: Int }

#[doc("""
The effects the file-level `use` names open, in order; a name that
settles to no declared effect is reported and opens nothing.
""")]
pub fn use_file_opens(names: [String], ux: UseScope, file: String,
                    acc: [SymId], errs: Int) : UseOpens / Console + File {


  match names {
    [] -> UseOpens { opens: list_reverse(acc), errs: errs }
    [name, ...rest] -> {
      let eff = use_effect(ux, name)
      match use_eff_lookup(ux.ops, eff) {
        Some(_) -> use_file_opens(rest, ux, file, [eff, ...acc], errs)
        None    -> {
          diag_error(file, 0, 0, "`use #{name}`: no effect named `#{name}` is in scope")
          diag_help("declare the effect (`effect #{name} { ... }`) or import the module that declares it")
          use_file_opens(rest, ux, file, acc, errs + 1)
        }
      }
    }
  }
}
