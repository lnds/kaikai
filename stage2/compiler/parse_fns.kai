#[doc("""
Function and constant declarations: heads, parameters, type parameters and bodies.
""")]

import compiler.lex_tokens
import compiler.ast
import compiler.decl_names
import compiler.tbinder
import compiler.parse_state
import compiler.parse_types
import compiler.parse_stmt
import compiler.parse_expr
import compiler.parse_kinds
import compiler.parse_contracts

type ConstHead = { p0: Parser, is_pub: Bool, name: String, t: Token }

type FnHead = {
  p0: Parser,
  fname: String,
  is_pub: Bool,
  t: Token,
  tparams: [TBinder],
  params: [Param],
  ret: Option[TypeExpr],
  row: RowExpr
}

fn params_err(p: Parser) : PParams = PParams { p: p, r: None }

#[doc("Parses a `const NAME : T = expr` declaration after its keyword.")]
pub fn parse_const_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) {
    err_d(p_error(p, id, "expected constant name after `const`"))
  } else {
    let p2 = p_eat(p_advance_nl(p), TkColon, "expected `:` after constant name (`const NAME : T = expr`)")
    if p_failed(p2) { err_d(p2) }
    else { const_type(parse_type(p_skip_newlines(p2)), ConstHead { p0: p, is_pub: is_pub, name: tok_source(p.src, id), t: t }) }
  }
}

fn const_type(rt: PTy, c: ConstHead) : PDecl / Console =
  match rt.r {
    None -> err_d(rt.p)
    Some(ty) -> {
      let p4 = p_eat(p_skip_newlines(rt.p), TkEq, "expected `=` in constant declaration")
      if p_failed(p4) { err_d(p4) } else { const_value(parse_expr(p_skip_newlines(p4)), c, ty) }
    }
  }

fn const_value(re: PExpr, c: ConstHead, ty: TypeExpr) : PDecl / Console =
  match re.r {
    None -> err_d(re.p)
    Some(body) ->
      ok_dn(re.p, DConst(c.is_pub, p_sym(c.p0, NCConst, c.name), ty, body, None, c.t.line, c.t.col),
            [p_ent(c.p0, NCConst, c.name, c.is_pub)])
  }

#[doc("Parses a `fn` declaration after its keyword.")]
pub fn parse_fn_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) { err_d(p_error(p, id, "expected function name")) }
  else if is_upper_ident(p.src, id) { err_d(p_error(p, id, "function names must start with a lowercase letter")) }
  else {
    let p1 = p_advance(p)
    let tr = if p_at(p1, TkLbracket) { parse_impl_type_params_loop(p_advance_nl(p1), []) }
             else { PTParams { p: p1, r: Some([]) } }
    match tr.r {
      None -> err_d(tr.p)
      Some(tparams) -> fn_params(tr.p, FnHead { p0: p, fname: tok_source(p.src, id), is_pub: is_pub, t: t,
                                                tparams: tparams, params: [], ret: None, row: REmpty })
    }
  }
}

fn fn_params(p: Parser, h: FnHead) : PDecl / Console =
  if not p_at(p, TkLparen) { fail_d(p, "expected `(` after function name") }
  else {
    let pr = parse_fn_params(p_advance_nl(p), [])
    match pr.r {
      None -> err_d(pr.p)
      Some(params) -> fn_ret(p_skip_newlines(pr.p), FnHead { ...h, params: params })
    }
  }

fn fn_ret(p: Parser, h: FnHead) : PDecl / Console {
  let ret_r = parse_optional_type(p)
  if p_failed(ret_r.p) and not p_failed(p) { err_d(ret_r.p) }
  else {
    let row_r = parse_row_suffix(ret_r.p)
    fn_body(row_r.p, FnHead { ...h, ret: ret_r.r, row: row_r.r })
  }
}

fn fn_body(p: Parser, h: FnHead) : PDecl / Console {
  let attr_p = reject_fn_attribute(p_skip_newlines(p))
  let cc = parse_contracts_loop(p_skip_newlines(attr_p), [], [])
  let p4 = p_skip_newlines(cc.p)
  match p_peek(p4).kind {
    TkEq -> finish_fn_decl(h, cc, parse_expr(p_advance_nl(p4)))
    TkLbrace -> finish_fn_decl(h, cc, brace_body(p4, h.params))
    _ -> fail_d(p4, "expected `=` or `{` to start function body")
  }
}

fn fail_d(p: Parser, msg: String) : PDecl / Console = err_d(p_error_here(p, msg))

fn brace_body(p: Parser, params: [Param]) : PExpr / Console {
  let after_lbrace = p_skip_newlines_and_semis(p_advance(p))
  if p_at(after_lbrace, TkCase) { parse_clause_block(after_lbrace, params, p_peek(p)) }
  else { parse_block(p, p_peek(p)) }
}

fn finish_fn_decl(h: FnHead, cc: Contracts, rb: PExpr) : PDecl / Console =
  match rb.r {
    None -> err_d(rb.p)
    Some(body) -> {
      let name = p_sym(h.p0, NCFn, h.fname)
      let dfn = DFn(h.is_pub, fnid_decl(name), h.tparams, h.params, h.ret, h.row,
                    contract_surface(body, cc, h.t), h.t.line, h.t.col, None)
      ok_d_fn(rb.p, dfn, fn_tp_bounds_of(h.tparams), [p_ent(h.p0, NCFn, h.fname, h.is_pub)])
    }
  }

#[doc("Parses a function parameter list after its opening parenthesis.")]
pub fn parse_fn_params(p: Parser, acc: [Param]) : PParams / Console =
  if p_at(p, TkRparen) { PParams { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else { params_group(p, [], acc) }

# A leading `^` borrows that name only; the others in a `a, b: T` group share the type.
fn params_group(p: Parser, pending: [PendName], acc: [Param]) : PParams / Console {
  let borrow = p_at(p, TkCaret)
  let p0 = if borrow { p_advance(p) } else { p }
  let t = p_peek(p0)
  if not tk_is(t.kind, TkIdent) {
    params_err(p_error(p0, t, "expected parameter name after `^`"))
  } else {
    let pending1 = [PendName { nm: tok_source(p0.src, t), nline: t.line, ncol: t.col, pborrow: borrow }, ...pending]
    let p1 = p_advance(p0)
    match p_peek(p1).kind {
      TkComma -> params_group(p_advance_nl(p1), pending1, acc)
      TkColon -> params_group_type(parse_type(p_advance(p1)), pending1, acc)
      TkRparen -> params_err(p_error_here(p1, "parameter group has no type annotation"))
      _ -> params_err(p_error_here(p1, "expected `,`, `:` or `)` in parameter list"))
    }
  }
}

fn params_group_type(rt: PTy, pending: [PendName], acc: [Param]) : PParams / Console =
  match rt.r {
    None -> params_err(rt.p)
    Some(ty) -> {
      let acc1 = close_param_group(list_reverse(pending), ty, acc)
      let p2 = p_skip_newlines(rt.p)
      match p_peek(p2).kind {
        TkComma -> parse_fn_params(p_advance_nl(p2), acc1)
        TkRparen -> PParams { p: p_advance(p2), r: Some(list_reverse(acc1)) }
        _ -> params_err(p_error_here(p2, "expected `,` or `)` in parameter list"))
      }
    }
  }

#[doc("The parser state paired with the result of parsing a type-parameter list.")]
pub type PTParams = { p: Parser, r: Option[[TBinder]] }

fn tparam_kind(p: Parser, bounded: Bool) : PKindBounds / Console =
  if bounded { parse_optional_kind_or_bounds(p) }
  else {
    let kr = parse_optional_kind_annotation(p)
    PKindBounds { p: kr.p, kind: kr.kind, bounds: [] }
  }

fn parse_tparams(p: Parser, acc: [TBinder], bounded: Bool) : PTParams / Console {
  let t = p_peek(p)
  if not tk_is(t.kind, TkIdent) {
    PTParams { p: p_error(p, t, "expected type parameter name"), r: None }
  } else {
    let kb = tparam_kind(p_advance_nl(p), bounded)
    let stored = tbinder_written(tok_source(p.src, t), kb.kind, map(kb.bounds, ref_written))
    tparams_sep(p_skip_newlines(kb.p), [stored, ...acc], bounded)
  }
}

fn tparams_sep(p: Parser, acc: [TBinder], bounded: Bool) : PTParams / Console =
  match p_peek(p).kind {
    TkComma -> parse_tparams(p_advance_nl(p), acc, bounded)
    TkRbracket -> PTParams { p: p_advance(p), r: Some(list_reverse(acc)) }
    _ -> PTParams { p: p_error_here(p, "expected `,` or `]` after type parameter"), r: None }
  }

#[doc("Parses the type parameters of a declaration, each with an optional kind annotation.")]
pub fn parse_type_params_loop(p: Parser, acc: [TBinder]) : PTParams / Console = parse_tparams(p, acc, false)

#[doc("Parses type parameters that may also carry protocol bounds: `T : Show + Eq`.")]
pub fn parse_impl_type_params_loop(p: Parser, acc: [TBinder]) : PTParams / Console = parse_tparams(p, acc, true)

#[doc("Protocol bounds of each type-kind tparam of a fn, keyed by position among the type-kind tparams.")]
pub fn fn_tp_bounds_of(tps: [TBinder]) : [FnTPBound] = fn_tp_bounds_loop(tps, 0, [])

fn fn_tp_bounds_loop(tps: [TBinder], idx: Int, acc: [FnTPBound]) : [FnTPBound] =
  match tps {
    [] -> list_reverse(acc)
    [tp, ...rest] ->
      if tb_is_unit(tp) { fn_tp_bounds_loop(rest, idx, acc) }
      else { fn_tp_bounds_loop(rest, idx + 1, match tp.bounds { [] -> acc  bs -> [FTB(idx, bs), ...acc] }) }
  }

#[doc("Parses comma-separated types up to `closer`, accepting a trailing comma; `msg` is the error for any other token.")]
pub fn parse_type_list(p: Parser, closer: TokKind, msg: String, acc: [TypeExpr]) : PTypes / Console {
  let p0 = p_skip_newlines(p)
  if p_at(p0, closer) { PTypes { p: p_advance(p0), r: Some(list_reverse(acc)) } }
  else {
    let r = parse_type(p0)
    match r.r {
      None -> PTypes { p: r.p, r: None }
      Some(ty) -> type_list_sep(p_skip_newlines(r.p), closer, msg, [ty, ...acc])
    }
  }
}

fn type_list_sep(p: Parser, closer: TokKind, msg: String, acc: [TypeExpr]) : PTypes / Console =
  if p_at(p, TkComma) { parse_type_list(p_advance(p), closer, msg, acc) }
  else if p_at(p, closer) { PTypes { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else { PTypes { p: p_error_here(p, msg), r: None } }
