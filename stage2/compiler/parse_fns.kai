#[doc("Function, effect and protocol declarations.")]

import compiler.lex_tokens
import compiler.ast
import compiler.decl_names
import compiler.tbinder
import compiler.parse_state
import compiler.parse_types
import compiler.parse_stmt
import compiler.parse_expr
import compiler.parse_control
import compiler.util
import compiler.diag

type ConstHead = { p0: Parser, is_pub: Bool, name: String, t: Token }

type FnHead = {
  p0: Parser,
  fname: String,
  is_pub: Bool,
  t: Token,
  tparams: [TBinder],
  params: [Param],
  ret: Option[TypeExpr],
  row: RowExpr
}

fn params_err(p: Parser) : PParams = PParams { p: p, r: None }

#[doc("Parses a `const NAME : T = expr` declaration after its keyword.")]
pub fn parse_const_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) {
    err_d(p_error(p, id, "expected constant name after `const`"))
  } else {
    let p2 = p_eat(p_advance_nl(p), TkColon, "expected `:` after constant name (`const NAME : T = expr`)")
    if p_failed(p2) { err_d(p2) }
    else { const_type(parse_type(p_skip_newlines(p2)), ConstHead { p0: p, is_pub: is_pub, name: tok_source(p.src, id), t: t }) }
  }
}

fn const_type(rt: PTy, c: ConstHead) : PDecl / Console =
  match rt.r {
    None -> err_d(rt.p)
    Some(ty) -> {
      let p4 = p_eat(p_skip_newlines(rt.p), TkEq, "expected `=` in constant declaration")
      if p_failed(p4) { err_d(p4) } else { const_value(parse_expr(p_skip_newlines(p4)), c, ty) }
    }
  }

fn const_value(re: PExpr, c: ConstHead, ty: TypeExpr) : PDecl / Console =
  match re.r {
    None -> err_d(re.p)
    Some(body) ->
      ok_dn(re.p, DConst(c.is_pub, p_sym(c.p0, NCConst, c.name), ty, body, None, c.t.line, c.t.col),
            [p_ent(c.p0, NCConst, c.name, c.is_pub)])
  }

#[doc("Parses a `fn` declaration after its keyword.")]
pub fn parse_fn_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) { err_d(p_error(p, id, "expected function name")) }
  else if is_upper_ident(p.src, id) { err_d(p_error(p, id, "function names must start with a lowercase letter")) }
  else {
    let p1 = p_advance(p)
    let tr = if p_at(p1, TkLbracket) { parse_impl_type_params_loop(p_advance_nl(p1), []) }
             else { PTParams { p: p1, r: Some([]) } }
    match tr.r {
      None -> err_d(tr.p)
      Some(tparams) -> fn_params(tr.p, FnHead { p0: p, fname: tok_source(p.src, id), is_pub: is_pub, t: t,
                                                tparams: tparams, params: [], ret: None, row: REmpty })
    }
  }
}

fn fn_params(p: Parser, h: FnHead) : PDecl / Console =
  if not p_at(p, TkLparen) { fail_d(p, "expected `(` after function name") }
  else {
    let pr = parse_fn_params(p_advance_nl(p), [])
    match pr.r {
      None -> err_d(pr.p)
      Some(params) -> fn_ret(p_skip_newlines(pr.p), FnHead { ...h, params: params })
    }
  }

fn fn_ret(p: Parser, h: FnHead) : PDecl / Console {
  let ret_r = parse_optional_type(p)
  if p_failed(ret_r.p) and not p_failed(p) { err_d(ret_r.p) }
  else {
    let row_r = parse_row_suffix(ret_r.p)
    fn_body(row_r.p, FnHead { ...h, ret: ret_r.r, row: row_r.r })
  }
}

fn fn_body(p: Parser, h: FnHead) : PDecl / Console {
  let attr_p = reject_fn_attribute(p_skip_newlines(p))
  let cc = parse_contracts_loop(p_skip_newlines(attr_p), [], [])
  let p4 = p_skip_newlines(cc.p)
  match p_peek(p4).kind {
    TkEq -> finish_fn_decl(h, cc, parse_expr(p_advance_nl(p4)))
    TkLbrace -> finish_fn_decl(h, cc, brace_body(p4, h.params))
    _ -> fail_d(p4, "expected `=` or `{` to start function body")
  }
}

fn fail_d(p: Parser, msg: String) : PDecl / Console = err_d(p_error_here(p, msg))

fn brace_body(p: Parser, params: [Param]) : PExpr / Console {
  let after_lbrace = p_skip_newlines_and_semis(p_advance(p))
  if p_at(after_lbrace, TkCase) { parse_clause_block(after_lbrace, params, p_peek(p)) }
  else { parse_block(p, p_peek(p)) }
}

fn finish_fn_decl(h: FnHead, cc: Contracts, rb: PExpr) : PDecl / Console =
  match rb.r {
    None -> err_d(rb.p)
    Some(body) -> {
      let name = p_sym(h.p0, NCFn, h.fname)
      let dfn = DFn(h.is_pub, fnid_decl(name), h.tparams, h.params, h.ret, h.row,
                    contract_surface(body, cc, h.t), h.t.line, h.t.col, None)
      ok_d_fn(rb.p, dfn, fn_tp_bounds_of(h.tparams), [p_ent(h.p0, NCFn, h.fname, h.is_pub)])
    }
  }

#[doc("Parses a function parameter list after its opening parenthesis.")]
pub fn parse_fn_params(p: Parser, acc: [Param]) : PParams / Console =
  if p_at(p, TkRparen) { PParams { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else { params_group(p, [], acc) }

# A leading `^` borrows that name only; the others in a `a, b: T` group share the type.
fn params_group(p: Parser, pending: [PendName], acc: [Param]) : PParams / Console {
  let borrow = p_at(p, TkCaret)
  let p0 = if borrow { p_advance(p) } else { p }
  let t = p_peek(p0)
  if not tk_is(t.kind, TkIdent) {
    params_err(p_error(p0, t, "expected parameter name after `^`"))
  } else {
    let pending1 = [PendName { nm: tok_source(p0.src, t), nline: t.line, ncol: t.col, pborrow: borrow }, ...pending]
    let p1 = p_advance(p0)
    match p_peek(p1).kind {
      TkComma -> params_group(p_advance_nl(p1), pending1, acc)
      TkColon -> params_group_type(parse_type(p_advance(p1)), pending1, acc)
      TkRparen -> params_err(p_error_here(p1, "parameter group has no type annotation"))
      _ -> params_err(p_error_here(p1, "expected `,`, `:` or `)` in parameter list"))
    }
  }
}

fn params_group_type(rt: PTy, pending: [PendName], acc: [Param]) : PParams / Console =
  match rt.r {
    None -> params_err(rt.p)
    Some(ty) -> {
      let acc1 = close_param_group(list_reverse(pending), ty, acc)
      let p2 = p_skip_newlines(rt.p)
      match p_peek(p2).kind {
        TkComma -> parse_fn_params(p_advance_nl(p2), acc1)
        TkRparen -> PParams { p: p_advance(p2), r: Some(list_reverse(acc1)) }
        _ -> params_err(p_error_here(p2, "expected `,` or `)` in parameter list"))
      }
    }
  }

#[doc("The parser state paired with the result of parsing a type-parameter list.")]
pub type PTParams = { p: Parser, r: Option[[TBinder]] }

fn tparam_kind(p: Parser, bounded: Bool) : PKindBounds / Console =
  if bounded { parse_optional_kind_or_bounds(p) }
  else {
    let kr = parse_optional_kind_annotation(p)
    PKindBounds { p: kr.p, kind: kr.kind, bounds: [] }
  }

fn parse_tparams(p: Parser, acc: [TBinder], bounded: Bool) : PTParams / Console {
  let t = p_peek(p)
  if not tk_is(t.kind, TkIdent) {
    PTParams { p: p_error(p, t, "expected type parameter name"), r: None }
  } else {
    let kb = tparam_kind(p_advance_nl(p), bounded)
    let stored = tbinder_written(tok_source(p.src, t), kb.kind, map(kb.bounds, ref_written))
    tparams_sep(p_skip_newlines(kb.p), [stored, ...acc], bounded)
  }
}

fn tparams_sep(p: Parser, acc: [TBinder], bounded: Bool) : PTParams / Console =
  match p_peek(p).kind {
    TkComma -> parse_tparams(p_advance_nl(p), acc, bounded)
    TkRbracket -> PTParams { p: p_advance(p), r: Some(list_reverse(acc)) }
    _ -> PTParams { p: p_error_here(p, "expected `,` or `]` after type parameter"), r: None }
  }

#[doc("Parses the type parameters of a declaration, each with an optional kind annotation.")]
pub fn parse_type_params_loop(p: Parser, acc: [TBinder]) : PTParams / Console = parse_tparams(p, acc, false)

#[doc("Parses type parameters that may also carry protocol bounds: `T : Show + Eq`.")]
pub fn parse_impl_type_params_loop(p: Parser, acc: [TBinder]) : PTParams / Console = parse_tparams(p, acc, true)

#[doc("Protocol bounds of each type-kind tparam of a fn, keyed by position among the type-kind tparams.")]
pub fn fn_tp_bounds_of(tps: [TBinder]) : [FnTPBound] = fn_tp_bounds_loop(tps, 0, [])

fn fn_tp_bounds_loop(tps: [TBinder], idx: Int, acc: [FnTPBound]) : [FnTPBound] =
  match tps {
    [] -> list_reverse(acc)
    [tp, ...rest] ->
      if tb_is_unit(tp) { fn_tp_bounds_loop(rest, idx, acc) }
      else { fn_tp_bounds_loop(rest, idx + 1, match tp.bounds { [] -> acc  bs -> [FTB(idx, bs), ...acc] }) }
  }

#[doc("Parses comma-separated types up to `closer`, accepting a trailing comma; `msg` is the error for any other token.")]
pub fn parse_type_list(p: Parser, closer: TokKind, msg: String, acc: [TypeExpr]) : PTypes / Console {
  let p0 = p_skip_newlines(p)
  if p_at(p0, closer) { PTypes { p: p_advance(p0), r: Some(list_reverse(acc)) } }
  else {
    let r = parse_type(p0)
    match r.r {
      None -> PTypes { p: r.p, r: None }
      Some(ty) -> type_list_sep(p_skip_newlines(r.p), closer, msg, [ty, ...acc])
    }
  }
}

fn type_list_sep(p: Parser, closer: TokKind, msg: String, acc: [TypeExpr]) : PTypes / Console =
  if p_at(p, TkComma) { parse_type_list(p_advance(p), closer, msg, acc) }
  else if p_at(p, closer) { PTypes { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else { PTypes { p: p_error_here(p, msg), r: None } }

type EffHead = { p: Parser, is_pub: Bool, t: Token, name: String, tparams: [TBinder] }

type PEffectOps = { p: Parser, r: Option[[EffectOp]] }

#[doc("Parses an optional `[T, ...]` type-parameter list.")]
pub fn parse_opt_type_params(p: Parser) : PTParams / Console =
  if p_at(p, TkLbracket) { parse_type_params_loop(p_advance_nl(p), []) }
  else { PTParams { p: p, r: Some([]) } }

#[doc("Parses `effect Eff[T, ...] { op(params) : Ret ... [default { clauses }] }`.")]
pub fn parse_effect_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) { err_d(p_error(p, id, "expected effect name")) }
  else {
    let tp = parse_opt_type_params(p_skip_newlines(p_advance(p)))
    match tp.r {
      None -> err_d(tp.p)
      Some(tparams) -> effect_body(p_skip_newlines(tp.p), EffHead { p: p, is_pub: is_pub, t: t, name: tok_source(p.src, id), tparams: tparams })
    }
  }
}

fn effect_decl(h: EffHead, ops: [EffectOp], default: Option[DefaultBlock], p: Parser) : PDecl =
  ok_dn(p, DEffect(h.is_pub, p_sym(h.p, NCEffect, h.name), h.tparams, ops, default, h.t.line, h.t.col, None),
        [p_ent(h.p, NCEffect, h.name, h.is_pub)])

fn effect_body(p: Parser, h: EffHead) : PDecl / Console {
  let p1 = p_eat(p, TkLbrace, "expected `{` to start effect body")
  if p_failed(p1) { err_d(p1) }
  else {
    let ops = parse_effect_ops(p_skip_newlines(p1), [])
    match ops.r {
      None -> err_d(ops.p)
      Some(xs) -> effect_after_ops(ops.p, h, xs)
    }
  }
}

fn effect_after_ops(p: Parser, h: EffHead, ops: [EffectOp]) : PDecl / Console {
  let after = p_skip_newlines(p)
  let id_t = p_peek(after)
  if tk_is(id_t.kind, TkIdent) and tok_source(after.src, id_t) == "default" { effect_default(after, id_t, h, ops) }
  else { effect_decl(h, ops, None, p) }
}

fn effect_default(after: Parser, id_t: Token, h: EffHead, ops: [EffectOp]) : PDecl / Console {
  let p1 = p_eat(p_advance_nl(after), TkLbrace, "expected `{` after `default`")
  if p_failed(p1) { err_d(p1) }
  else {
    let cr = parse_handle_clauses(p_skip_newlines(p1), [], None, [])
    match cr.r {
      None -> err_d(cr.p)
      Some(_) -> {
        let p2 = p_eat(p_skip_newlines(cr.p), TkRbrace, "expected `}` to close effect body after `default` block")
        if p_failed(p2) { err_d(p2) }
        else { effect_decl(h, ops, Some(DBlk(cr.clauses, cr.return_clause, id_t.line, id_t.col)), p2) }
      }
    }
  }
}

fn ops_err(p: Parser, t: Token, msg: String) : PEffectOps / Console = PEffectOps { p: p_error(p, t, msg), r: None }

fn ops_failed(p: Parser) : PEffectOps = PEffectOps { p: p, r: None }

fn parse_effect_ops(p: Parser, acc: [EffectOp]) : PEffectOps / Console {
  let p0 = p_skip_newlines(p)
  let id = p_peek(p0)
  if p_at(p0, TkRbrace) { PEffectOps { p: p_advance(p0), r: Some(list_reverse(acc)) } }
  else if not tk_is(id.kind, TkIdent) { ops_err(p0, id, "expected operation name") }
  else if is_upper_ident(p0.src, id) { ops_err(p0, id, "effect operation names must start with a lowercase letter") }
  else if tok_source(p0.src, id) == "default" and p_at(p_advance_nl(p0), TkLbrace) {
    PEffectOps { p: p0, r: Some(list_reverse(acc)) }
  } else {
    parse_effect_op(p0, id, acc)
  }
}

fn parse_effect_op(p: Parser, id: Token, acc: [EffectOp]) : PEffectOps / Console {
  let tp = parse_opt_type_params(p_advance(p))
  match tp.r {
    None -> ops_failed(tp.p)
    Some(tparams) -> effect_op_sig(tp.p, id, tparams, acc)
  }
}

fn effect_op_sig(p: Parser, id: Token, tparams: [TBinder], acc: [EffectOp]) : PEffectOps / Console {
  let p1 = p_eat(p, TkLparen, "expected `(` after operation name")
  if p_failed(p1) { ops_failed(p1) }
  else {
    let ps = parse_fn_params(p_skip_newlines(p1), [])
    match ps.r {
      None -> ops_failed(ps.p)
      Some(params) -> effect_op_ret(p_skip_newlines(ps.p), id, tparams, params, acc)
    }
  }
}

fn effect_op_ret(p: Parser, id: Token, tparams: [TBinder], params: [Param], acc: [EffectOp]) : PEffectOps / Console {
  let p1 = p_eat(p, TkColon, "expected `:` before operation return type")
  if p_failed(p1) { ops_failed(p1) }
  else {
    let rt = parse_type(p1)
    match rt.r {
      None -> ops_failed(rt.p)
      Some(ty) -> parse_effect_ops(rt.p, [EffOp(tok_source(p.src, id), tparams, params, ty, id.line, id.col), ...acc])
    }
  }
}

#[doc("""
Parses the labels of an effect alias after the first `+`; `acc` holds the
labels so far in reverse. Whether each label names a declared effect is a
resolve-time check.
""")]
pub fn parse_effect_alias_body(p: Parser, acc: [RowLabel], is_pub: Bool, name: String, tparams: [TBinder], slots: [String], t: Token) : PDecl / Console {
  let hd = p_peek(p)
  if not at_type_head(p, hd) { err_d(p_error(p, hd, "expected uppercase effect name in effect alias")) }
  else {
    let qn = parse_qualified_head_name(p, hd)
    let a = parse_opt_row_args(qn.p)
    match a.r {
      None -> err_d(a.p)
      Some(targs) -> {
        let acc1 = [RL(qn.dref, targs), ...acc]
        if p_at(a.p, TkPlus) { parse_effect_alias_body(p_advance(a.p), acc1, is_pub, name, tparams, slots, t) }
        else {
          ok_dn(a.p, DType(is_pub, p_sym(p, NCType, name), tparams, TBEffectAlias(list_reverse(acc1)), t.line, t.col, None, slots),
                [p_ent(p, NCType, name, is_pub)])
        }
      }
    }
  }
}

#[doc("The label a parsed alias body turns out to head, when a `+` follows it.")]
pub fn effect_alias_head(p: Parser, ty: TypeExpr) : Option[RowLabel] =
  match ty.tkind {
    TyName(DrWritten(q, n), targs) if p_at(p, TkPlus) -> Some(RL(DrWritten(q, n), targs))
    _ -> None
  }

# A law set is verified by generated property checks, not by a unifier: a
# law set and a theory are separate namespaces.
fn is_protocol_law(name: String) : Bool = name == "Functorial"

fn unknown_protocol_law_msg(name: String) : String =
  concat_all(["unknown protocol law `", name, "` — the law sets are: Functorial"])

fn is_upper_name(p: Parser, t: Token) : Bool = tk_is(t.kind, TkIdent) and is_upper_ident(p.src, t)

fn opt_type_params(p: Parser) : PTParams / Console =
  if p_at(p, TkLbracket) { parse_type_params_loop(p_advance_nl(p), []) }
  else { PTParams { p: p, r: Some([]) } }

fn theory_prop_menu() : [String] =
  ["assoc", "commut", "idempotent", "inverse", "identity", "measure", "rows"]

fn unknown_theory_prop_msg(prop: String) : String {
  let base = concat_all(["unknown theory property `", prop,
                         "` — the closed menu is assoc, commut, idempotent, inverse, identity, measure, rows"])
  match closest_name(prop, theory_prop_menu()) {
    Some(sug) -> concat_all([base, " (did you mean `", sug, "`?)"])
    None      -> base
  }
}

#[doc("Parses `theory Name = { prop, ... }` or `theory Name = builtin`; `t` anchors the declaration.")]
pub fn parse_theory_decl(p: Parser, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) { err_d(p_error(p, id, "expected theory name after `theory`")) }
  else if not is_upper_ident(p.src, id) { err_d(p_error(p, id, "theory name must start with an uppercase letter")) }
  else {
    let p1 = p_eat(p_advance(p), TkEq, "expected `=` after theory name — a theory is `theory Name = { prop, ... }` or `theory Name = builtin`")
    if p_failed(p1) { err_d(p1) } else { parse_theory_body(p1, tok_source(p.src, id), t) }
  }
}

# `builtin` is contextual: only directly after a theory's `=`.
fn parse_theory_body(p: Parser, name: String, t: Token) : PDecl / Console {
  let b = p_peek(p)
  if tk_is(b.kind, TkIdent) and tok_source(p.src, b) == "builtin" {
    ok_d(p_advance(p), DTheory(name, [theory_builtin_marker()], t.line, t.col, None))
  } else if not p_at(p, TkLbrace) {
    err_d(p_error_here(p, "expected `{` or `builtin` after `=` in a `theory` declaration"))
  } else {
    theory_props(p_advance(p), [], name, t)
  }
}

fn theory_props(p: Parser, acc: [String], name: String, t: Token) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  let id = p_peek(p0)
  let prop = tok_source(p0.src, id)
  if p_at(p0, TkRbrace) { ok_d(p_advance(p0), DTheory(name, list_reverse(acc), t.line, t.col, None)) }
  else if not tk_is(id.kind, TkIdent) { err_d(p_error(p0, id, "expected a property name inside `theory { ... }`")) }
  else if not list_has(theory_prop_menu(), prop) { err_d(p_error(p0, id, unknown_theory_prop_msg(prop))) }
  else { theory_prop_end(p_advance_nl(p0), [prop, ...acc], name, t) }
}

fn theory_prop_end(p: Parser, acc: [String], name: String, t: Token) : PDecl / Console {
  if p_at(p, TkComma) { theory_props(p_advance(p), acc, name, t) }
  else if p_at(p, TkRbrace) { ok_d(p_advance(p), DTheory(name, list_reverse(acc), t.line, t.col, None)) }
  else { err_d(p_error_here(p, "expected `,` or `}` in a `theory` property list")) }
}

type ProtoHead = { at: Parser, name: String, is_pub: Bool, tparams: [TBinder], law: String, t: Token }

#[doc("Parses `protocol P[T] : Law { op(params) : Ret ... }`; the first parameter may be typed `Self`.")]
pub fn parse_protocol_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not is_upper_name(p, id) { err_d(p_error(p, id, "expected an uppercase protocol name")) }
  else {
    let tps = opt_type_params(p_advance(p))
    match tps.r {
      None -> err_d(tps.p)
      Some(tparams) -> protocol_law(tps.p, ProtoHead { at: p, name: tok_source(p.src, id), is_pub: is_pub, tparams: tparams, law: "", t: t })
    }
  }
}

# `: Law` after the type parameters; an unknown law is rejected (the catalog is closed).
fn protocol_law(p: Parser, h: ProtoHead) : PDecl / Console {
  let pn = p_skip_newlines(p)
  let p1 = p_advance_nl(pn)
  let th = p_peek(p1)
  let law = tok_source(p1.src, th)
  if not p_at(pn, TkColon) { protocol_body(pn, h) }
  else if not is_upper_name(p1, th) { err_d(p_error_here(p1, "expected a protocol law after `:`")) }
  else if not is_protocol_law(law) { err_d(p_error(p1, th, unknown_protocol_law_msg(law))) }
  else { protocol_body(p_skip_newlines(p_advance(p1)), ProtoHead { ...h, law: law }) }
}

fn protocol_body(p: Parser, h: ProtoHead) : PDecl / Console {
  let pb = p_eat(p, TkLbrace, "expected `{` to start protocol body")
  if p_failed(pb) { err_d(pb) } else { protocol_ops(p_advance_nl(p), [], h) }
}

fn protocol_ops(p: Parser, acc: [ProtoOp], h: ProtoHead) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  let id = p_peek(p0)
  if p_at(p0, TkRbrace) { protocol_done(p_advance(p0), list_reverse(acc), h) }
  else if not tk_is(id.kind, TkIdent) { err_d(p_error(p0, id, "expected operation name")) }
  else {
    let tps = opt_type_params(p_advance(p0))
    match tps.r {
      None -> err_d(tps.p)
      Some(op_tparams) -> protocol_op_params(tps.p, id, op_tparams, acc, h)
    }
  }
}

fn protocol_done(p: Parser, ops: [ProtoOp], h: ProtoHead) : PDecl {
  let proto = DProtocol(h.is_pub, p_sym(h.at, NCProtocol, h.name), h.tparams, ops, h.t.line, h.t.col, None)
  let rows = [p_ent(h.at, NCProtocol, h.name, h.is_pub)]
  if h.law == "" { ok_dn(p, proto, rows) }
  else { ok_dn(p, DProtoLaws(h.law, proto, h.t.line, h.t.col, None), rows) }
}

fn protocol_op_params(p: Parser, id: Token, op_tparams: [TBinder], acc: [ProtoOp], h: ProtoHead) : PDecl / Console {
  let pa = p_eat(p, TkLparen, "expected `(` after operation name")
  if p_failed(pa) { err_d(pa) }
  else {
    let params = parse_fn_params(p_skip_newlines(pa), [])
    match params.r {
      None -> err_d(params.p)
      Some(ps) -> protocol_op_ret(p_skip_newlines(params.p), id, op_tparams, ps, acc, h)
    }
  }
}

fn protocol_op_ret(p: Parser, id: Token, op_tparams: [TBinder], params: [Param], acc: [ProtoOp], h: ProtoHead) : PDecl / Console {
  let pc = p_eat(p, TkColon, "expected `:` before operation return type")
  if p_failed(pc) { err_d(pc) }
  else {
    let rt = parse_type(pc)
    match rt.r {
      None -> err_d(rt.p)
      Some(ty) -> protocol_ops(rt.p, [POp(tok_source(p.src, id), op_tparams, params, ty, id.line, id.col), ...acc], h)
    }
  }
}

#[doc("Parses `impl[u: Measure] P[A] for T { fn op(args) = body ... }`; an impl tparam list is prepended to each method's own.")]
pub fn parse_impl_decl(p: Parser, t: Token) : PDecl / Console {
  let tps =
    if p_at(p, TkLbracket) { parse_impl_type_params_loop(p_advance_nl(p), []) }
    else { PTParams { p: p, r: Some([]) } }
  match tps.r {
    None -> err_d(tps.p)
    Some(tparams) -> impl_head(p_skip_newlines(tps.p), p, t, tparams)
  }
}

type ImplHead = { at: Parser, t: Token, tparams: [TBinder], pname: DeclRef, args: [TypeExpr], target: TypeExpr }

fn impl_head(p: Parser, at: Parser, t: Token, tparams: [TBinder]) : PDecl / Console {
  let id = p_peek(p)
  if not at_type_head(p, id) { err_d(p_error(p, id, "expected an uppercase protocol name after `impl`")) }
  else {
    let pq = parse_qualified_head_name(p, id)
    let args =
      if p_at(pq.p, TkLbracket) { parse_type_list(p_advance(pq.p), TkRbracket, "expected `,` or `]` in impl protocol arguments", []) }
      else { PTypes { p: pq.p, r: Some([]) } }
    match args.r {
      None -> err_d(args.p)
      Some(proto_args) -> impl_for(p_skip_newlines(args.p), at, t, tparams, pq.dref, proto_args)
    }
  }
}

fn impl_for(p: Parser, at: Parser, t: Token, tparams: [TBinder], pname: DeclRef, args: [TypeExpr]) : PDecl / Console {
  let pf = p_eat(p, TkFor, "expected `for` after protocol name in `impl`")
  if p_failed(pf) { err_d(pf) }
  else {
    let target = parse_type(p_skip_newlines(pf))
    match target.r {
      None -> err_d(target.p)
      Some(ty) -> impl_body(p_skip_newlines(target.p), ImplHead { at: at, t: t, tparams: tparams, pname: pname, args: args, target: ty })
    }
  }
}

fn impl_body(p: Parser, h: ImplHead) : PDecl / Console {
  let pb = p_eat(p, TkLbrace, "expected `{` to start impl body")
  if p_failed(pb) { err_d(pb) } else { impl_methods(p_skip_newlines(pb), impl_scope(h.at.home, h.t.line, h.t.col), [], [], h) }
}

# `scope` is the impl block's: a method is declared in it, not in the module's function
# namespace, so two impls' `show` are two symbols.
fn impl_methods(p: Parser, scope: String, acc: [Decl], racc: [NEnt], h: ImplHead) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) {
    let impl_d = DImpl(h.pname, h.args, h.target, list_reverse(acc), h.t.line, h.t.col, h.tparams, sym_none())
    trailing_axiom(p_advance(p0), impl_d, list_reverse(racc), h.t)
  } else if not p_at(p0, TkFn) {
    err_d(p_error_here(p0, "expected `fn` to start an impl method"))
  } else {
    let dr = parse_fn_decl(p_advance(p0), false, p_peek(p0))
    match dr.r {
      None -> err_d(dr.p)
      Some(d) -> impl_method_next(dr, d, scope, acc, racc, h)
    }
  }
}

fn impl_method_next(dr: PDecl, d: Decl, scope: String, acc: [Decl], racc: [NEnt], h: ImplHead) : PDecl / Console =
  match dr.names {
    [NEnt(_, op, _, _, _)] -> impl_methods(dr.p, scope, [impl_method(d, op, scope), ...acc], [method_ent(op, scope), ...racc], h)
    _ -> panic("parse: an impl method without its entry")
  }

# The function `d`, read as a module's, re-identified as the method `op` of the impl block `scope`.
fn impl_method(d: Decl, op: String, scope: String) : Decl = match d {
  DFn(is_pub, _, tps, ps, ret, row, body, l, c, mo) ->
    DFn(is_pub, fnid_decl(method_sym(op, scope)), tps, ps, ret, row, body, l, c, mo)
  _ -> d
}

# `axiom` also starts a top-level declaration, so a trailing `axiom <Law>` is claimed only
# when a known law name follows; otherwise `axiom` stays for the declaration parser.
fn trailing_axiom(p: Parser, impl_d: Decl, rows: [NEnt], t: Token) : PDecl / Console {
  let pn = p_skip_newlines(p)
  let p1 = p_advance_nl(pn)
  let th = p_peek(p1)
  if p_at(pn, TkAxiom) and is_upper_name(p1, th) and is_protocol_law(tok_source(p1.src, th)) {
    ok_dn(p_advance(p1), DImplAxiom(tok_source(p1.src, th), impl_d, t.line, t.col, None), rows)
  } else {
    ok_dn(p, impl_d, rows)
  }
}
