#[doc("""
What monomorphisation checks about a specialisation: structural equality
of the types two instantiations were made at, a type or unit variable
left in a spec body, the declaration-level instantiation a call inside a
generic stands for, and the protocol bounds of each instantiation.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.fn_index
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.infer_env_exhaust
import compiler.infer_dump_text
import compiler.infer_env_schemes
import compiler.type_home
import compiler.monomorph_polys
import compiler.monomorph_subst
import compiler.monomorph_mangle
import compiler.protos_derive_check

#[doc("Location of the first TyVarT/UVar leak found in a spec body: source line, column, and the rendered offending type.")]
pub type LeakLoc = MLeakAt(Int, Int, String)

#[doc("One m4c Phase 3 invariant violation: spec name, leak count, and the optional first-leak location.")]
pub type MLeakRecord = MLeakRec(String, Int, Option[LeakLoc])

# ---- m4c — monomorphise (m4c #4 + Phase 3 body subst, 2026-04-29) ----
#
# Sits between `infer_program` and `perceus_pass` in the pipeline.
# Given a TypedProgram (post-inference, with `Expr.ty` populated and
# all `ResolvedCS` known), produce the `[Decl]` shape the next pass
# walks.
#
# Phase 1 (376d3f3) — clause-info plumbing — prefixes embedded
# `EHandle` clause symbols with the enclosing fn's post-monomorph
# name so per-spec clauses don't collide.
# Phase 2 minimal (c27a1fe) — generate one cloned DFn per distinct
# `(name, tys, units)` tuple, with the mangled symbol.
# Phase 2 full (7768e04) — pre-mono walker `rewrite_callsites_decls`
# retargets every concrete-tuple call site at the call's source
# position; specs inherit the rewritten body via structural sharing.
# Phase 3 (this lane) — body type substitution. Each cloned spec's
# body is freshly built (no longer shared) and every `Expr.ty`
# carrying the impl-level uvars or tparam type-vars gets replaced
# by the concrete spec tuple. This:
#   1. Lets `unit_name(x)` and `__strip_unit(x)` read the call-site
#      unit instead of the parametric `UVar(_)` — removes the
#      `try_rewrite_show_dim_real` workaround entirely.
#   2. Resolves polymorphic flow-through. A spec body's call to
#      another polymorphic helper now sees concrete tys (the
#      tparam was substituted) so the per-spec call-site rewrite
#      retargets to the matching specialisation, not back to the
#      polymorphic original.
# Phase 4 — generic prune (drop the original polymorphic DFn when
# every reference has been redirected). Still deferred.
#
# Tuples carry both `[Ty]` (type-tparam tuple) and `[UnitExprT]`
# (unit-tparam tuple). Two `Show<Real<u>>` call sites with `u :=
# USD` and `u := EUR` therefore key into distinct specialisations
# even though their type-tparam tuple is empty.

#[doc("""
---- m4c Phase 3 invariant: no leftover TyVarT / UVar in specs ----

Walks the post-monomorphise `[Decl]` and reports any specialised
DFn (one whose name carries the `__mono__` / `__umono__` mangling
infix) whose body still references a `TyVarT` or `UVar` in any
`Expr.ty`. A leak here means body subst missed a node — the spec
would behave like a polymorphic copy at the consumer side. Returns
the count of leaks for diagnostics.
Per-spec invariant: walk a specialised DFn body counting only
`TyVarT(n)` / `UVar(n)` whose `n` is in the spec's substitution
domain (i.e., would have been replaced by `subst_decl` if the
walker reached that node). Free typer tyvars whose ids fall
outside both lists are unrelated artefacts (clause answer types
the typer left open, etc.) and do not count as leaks.
The first leak of a spec body: its position and the offending type.
""")]
pub type LeakTy = LeakTy(Int, Int, Ty)

#[doc("How many variables of the spec's own substitution domain are left in its body.")]
pub fn count_spec_leaks(body: Expr, atv: [Int], auv: [Int]) : Int =
  count_tyvar_in_expr(body, atv, auv, 0)

#[doc("The first variable of the spec's own substitution domain left in its body.")]
pub fn first_spec_leak(body: Expr, atv: [Int], auv: [Int]) : Option[LeakTy] =
  find_first_leak_in_expr(body, atv, auv)

# Locate the first leak in a spec body. Allowed lists scope the check
# to the spec's own substitution domain (typer-introduced free tyvars
# whose ids fall outside both lists are ignored).
fn find_first_leak_in_expr(e: Expr, atv: [Int], auv: [Int]) : Option[LeakTy] {
  match e.ty {
    Some(t) -> if count_tyvar_in_ty(t, atv, auv) > 0 {
      Some(LeakTy(e.line, e.col, t))
    } else { find_first_leak_in_kind(e.kind, atv, auv) }
    None -> find_first_leak_in_kind(e.kind, atv, auv)
  }
}

fn find_first_leak_in_kind(k: ExprKind, atv: [Int], auv: [Int]) : Option[LeakTy] = match k {
  ECall(callee, args_) -> leak_or_args(find_first_leak_in_expr(callee, atv, auv), args_, atv, auv)
  EField(base, _) -> find_first_leak_in_expr(base, atv, auv)
  EIndex(a, b) -> leak_in_both(a, b, atv, auv)
  EBinop(_, a, b) -> leak_in_both(a, b, atv, auv)
  EUnop(_, x) -> find_first_leak_in_expr(x, atv, auv)
  EIf(c, t_, eo) -> leak_or_opt(leak_in_both(c, t_, atv, auv), eo, atv, auv)
  EMatch(scr, arms) -> leak_or_arms(find_first_leak_in_expr(scr, atv, auv), arms, atv, auv)
  ELambda(_, b) -> find_first_leak_in_expr(b, atv, auv)
  ELitUnit(inner, _) -> find_first_leak_in_expr(inner, atv, auv)
  EBang(inner) -> find_first_leak_in_expr(inner, atv, auv)
  EBlock(stmts, tail) -> leak_or_opt(find_first_leak_in_stmts(stmts, atv, auv), tail, atv, auv)
  EPipe(a, b) -> leak_in_both(a, b, atv, auv)
  EDispatchPipe(_, a, b) -> leak_in_both(a, b, atv, auv)
  ERange(a, b, opt_step) -> leak_or_opt(leak_in_both(a, b, atv, auv), opt_step, atv, auv)
  ERecordLit(_, fs) -> find_first_leak_in_fields(fs, atv, auv)
  EList(els) -> find_first_leak_in_elems(els, atv, auv)
  EHandle(body, _, _, init_opt, _, clauses, ret_opt) ->
    leak_or_clauses(leak_or_opt(find_first_leak_in_expr(body, atv, auv), init_opt, atv, auv), clauses, ret_opt, atv, auv)
  _ -> None
}

# The `leak_or_*` family: `first` when it found a leak, else the first
# leak of what follows it in source order.
fn leak_or_expr(first: Option[LeakTy], e: Expr, atv: [Int], auv: [Int]) : Option[LeakTy] = match first {
  Some(l) -> Some(l)
  None    -> find_first_leak_in_expr(e, atv, auv)
}

fn leak_or_opt(first: Option[LeakTy], o: Option[Expr], atv: [Int], auv: [Int]) : Option[LeakTy] = match first {
  Some(l) -> Some(l)
  None    -> find_first_leak_in_opt(o, atv, auv)
}

fn leak_or_args(first: Option[LeakTy], args: [Expr], atv: [Int], auv: [Int]) : Option[LeakTy] = match first {
  Some(l) -> Some(l)
  None    -> find_first_leak_in_args(args, atv, auv)
}

fn leak_or_arms(first: Option[LeakTy], arms: [Arm], atv: [Int], auv: [Int]) : Option[LeakTy] = match first {
  Some(l) -> Some(l)
  None    -> find_first_leak_in_arms(arms, atv, auv)
}

fn leak_or_stmts(first: Option[LeakTy], stmts: [Stmt], atv: [Int], auv: [Int]) : Option[LeakTy] = match first {
  Some(l) -> Some(l)
  None    -> find_first_leak_in_stmts(stmts, atv, auv)
}

fn leak_or_clauses(first: Option[LeakTy], cs: [HClause], ret: Option[HReturn], atv: [Int], auv: [Int]) : Option[LeakTy] = match first {
  Some(l) -> Some(l)
  None    -> find_first_leak_in_clauses_then_ret(cs, ret, atv, auv)
}

fn leak_in_both(a: Expr, b: Expr, atv: [Int], auv: [Int]) : Option[LeakTy] =
  leak_or_expr(find_first_leak_in_expr(a, atv, auv), b, atv, auv)

fn find_first_leak_in_opt(o: Option[Expr], atv: [Int], auv: [Int]) : Option[LeakTy] = match o {
  Some(e) -> find_first_leak_in_expr(e, atv, auv)
  None    -> None
}

fn find_first_leak_in_args(args: [Expr], atv: [Int], auv: [Int]) : Option[LeakTy] = match args {
  []           -> None
  [a, ...rest] -> leak_or_args(find_first_leak_in_expr(a, atv, auv), rest, atv, auv)
}

fn find_first_leak_in_arms(arms: [Arm], atv: [Int], auv: [Int]) : Option[LeakTy] = match arms {
  []                      -> None
  [Arm(_, g, b), ...rest] ->
    leak_or_arms(leak_or_expr(find_first_leak_in_opt(g, atv, auv), b, atv, auv), rest, atv, auv)
}

fn find_first_leak_in_fields(fs: [FieldInit], atv: [Int], auv: [Int]) : Option[LeakTy] {
  match fs {
    [] -> None
    [f, ...rest] -> match f {
      FI(_, v) -> match find_first_leak_in_expr(v, atv, auv) {
        Some(l) -> Some(l) None -> find_first_leak_in_fields(rest, atv, auv)
      }
    }
  }
}

fn find_first_leak_in_elems(els: [ListElem], atv: [Int], auv: [Int]) : Option[LeakTy] {
  match els {
    [] -> None
    [el, ...rest] -> {
      let r = match el {
        ElPlain(x)  -> find_first_leak_in_expr(x, atv, auv)
        ElSpread(x) -> find_first_leak_in_expr(x, atv, auv)
      }
      match r {
        Some(l) -> Some(l) None -> find_first_leak_in_elems(rest, atv, auv)
      }
    }
  }
}

fn find_first_leak_in_stmts(stmts: [Stmt], atv: [Int], auv: [Int]) : Option[LeakTy] = match stmts {
  []           -> None
  [s, ...rest] -> leak_or_stmts(find_first_leak_in_stmt(s, atv, auv), rest, atv, auv)
}

fn find_first_leak_in_stmt(s: Stmt, atv: [Int], auv: [Int]) : Option[LeakTy] = match s {
  SLet(_, _, rhs) -> find_first_leak_in_expr(rhs, atv, auv)
  SAssert(c, m) -> leak_or_opt(find_first_leak_in_expr(c, atv, auv), m, atv, auv)
  SExprStmt(x) -> find_first_leak_in_expr(x, atv, auv)
  SIndexAssign(b, i, v, _, _) -> leak_or_expr(leak_in_both(b, i, atv, auv), v, atv, auv)
  SAssign(b, v, _, _) -> leak_in_both(b, v, atv, auv)
  SVar(_, _, rhs, _, _) -> find_first_leak_in_expr(rhs, atv, auv)
  SUse(_, _, _) -> None
}

fn find_first_leak_in_clauses_then_ret(cs: [HClause], ret: Option[HReturn], atv: [Int], auv: [Int]) : Option[LeakTy] {
  match find_first_leak_in_clauses(cs, atv, auv) {
    Some(l) -> Some(l)
    None -> match ret {
      Some(r) -> match r { HR(_, b, _, _) -> find_first_leak_in_expr(b, atv, auv) }
      None -> None
    }
  }
}

fn find_first_leak_in_clauses(cs: [HClause], atv: [Int], auv: [Int]) : Option[LeakTy] {
  match cs {
    [] -> None
    [c, ...rest] -> match c {
      HC(_, _, b, _, _) -> match find_first_leak_in_expr(b, atv, auv) {
        Some(l) -> Some(l) None -> find_first_leak_in_clauses(rest, atv, auv)
      }
    }
  }
}

#[doc("""
Cross each concrete instantiation tuple with the declared protocol
bounds of the decl it specialises. A bound `T: P` on the type-kind
tparam at index `idx` is satisfied iff the concrete `tys[idx]` head has
an impl of `P` (user or synthesised-from-derive, both in `reg.impls`)
or a structural builtin impl. The bounds ride the generic's own tparams.
A direct call resolves its span from `tp.insts`; a tuple mono discovered
transitively has no inst, so the error falls back to the callee decl's
own line/col.
""")]
pub fn check_fn_bounds(tuples: [MonoTuple], fn_bounds: [SymBounds],
                   insts: InstIndex, polys: PolyIx, reg: ProtocolReg, env: EqEnv,
                   acc: [BoundViolation]) : [BoundViolation] = match tuples {
  []                       -> list_reverse(acc)
  [MT(s, tys, _), ...rest] ->
    check_fn_bounds(rest, fn_bounds, insts, polys, reg, env,
                    check_inst_bounds(s, tys, fn_bounds, insts, polys, reg, env, acc))
}

fn check_inst_bounds(s: SymId, tys: [Ty], fn_bounds: [SymBounds], insts: InstIndex, polys: PolyIx,
                     reg: ProtocolReg, env: EqEnv, acc: [BoundViolation]) : [BoundViolation] =
  match lookup_poly_fn_sym(poly_ix_fns(polys), s) {
    Some(DFn(_, _, _, _, _, _, _, ln, cl, dmo)) -> match bounds_of_sym(fn_bounds, s) {
      None       -> acc
      Some(ftbs) -> {
        let loc = inst_loc_or(insts, s, tys, ln, cl)
        let fmo = home_or_target(dmo, polys)
        check_tuple_bounds(ftbs, tys, s, fmo, reg, env, loc, acc)
      }
    }
    _ -> acc
  }

#[doc("The call that instantiated `mt` of the generic `d`, or the generic's own position when no call names it.")]
pub fn mono_inst_loc(insts: InstIndex, d: Decl, mt: MonoTuple) : LineCol = match d {
  DFn(_, _, _, _, _, _, _, ln, cl, _) -> match mt { MT(s, tys, _) -> inst_loc_or(insts, s, tys, ln, cl) }
  _ -> MoLC(0, 0)
}

fn home_or_target(dmo: Option[String], polys: PolyIx) : Option[String] = match dmo {
  Some(m) -> Some(m)
  None    -> Some(poly_ix_target(polys))
}

fn inst_loc_or(insts: InstIndex, s: SymId, tys: [Ty], ln: Int, cl: Int) : LineCol =
  match inst_loc_for(insts, s, tys) {
    MoLC(0, 0) -> MoLC(ln, cl)
    lc         -> lc
  }

# Line/col of the resolved call site instantiating `s` at `tys`.
# The typer's insts carry the caller's span; a transitive tuple mono
# discovered later has no inst here → 0:0.
fn inst_loc_for(insts: InstIndex, s: SymId, tys: [Ty]) : LineCol =
  inst_loc_loop(iix_chain(insts, s), tys)

fn inst_loc_loop(insts: [ResolvedCS], tys: [Ty]) : LineCol {
  match insts {
    [] -> MoLC(0, 0)
    [cs, ...rest] -> match cs {
      RCS(_, line, col, itys, _, _) ->
        if ty_list_eq(itys, tys) { MoLC(line, col) }
        else { inst_loc_loop(rest, tys) }
    }
  }
}

#[doc("""
Synthesise a ResolvedCS for a call to a polymorphic DFn by
walking the impl's formal param types in parallel with the actual
args' `Expr.ty` and extracting bindings for both type-tparam ids
(TyVarT) and unit-tparam ids (UVar). Returns None if we cannot
resolve the impl's scheme or any arg lacks a `.ty` annotation.
""")]
pub fn synthesize_inst_for_decl(d: Decl, args_: [Expr], ret_ty: Option[Ty], line: Int, col: Int) : Option[ResolvedCS] = match d {
  DFn(_, fid, tparams, _, _, _, _, _, _, _) -> match fn_scheme_of_decl(d, [], tsh_none()) {
    Some(Scheme(_, _, _, _, TyFnT(formal_pts, formal_ret, _))) ->
      # An arity mismatch means the call cannot be this generic.
      if list_length(formal_pts) != list_length(args_) { None }
      else { synthesize_inst(fid, tparam_id_split(tparams), formal_pts, formal_ret, args_, ret_ty, line, col) }
    _ -> None
  }
  _ -> None
}

# A return-only tparam (a collect's element type in `Vec[b]`) is grounded
# from the call site's resolved return type, unified in the same binding
# set the args pin; an unresolved `ret_ty` adds no binding. An unbound
# type-tparam means the formal shape did not unify with the actual
# argument types, so this is not an instantiation of the generic: it is
# declined rather than defaulted to `TyAny`.
fn synthesize_inst(fid: FnId, split: TParamSplit, formal_pts: [Ty], formal_ret: Ty, args_: [Expr],
                   ret_ty: Option[Ty], line: Int, col: Int) : Option[ResolvedCS] = {
  let bindings = extract_bindings_from_ret(formal_ret, formal_pts, ret_ty,
                    extract_bindings_args(formal_pts, args_,
                      SubstBindings { tvars: [], uvars: [] }))
  match collect_subst_tys(split.tvars, bindings.tvars) {
    None      -> None
    Some(tys) -> Some(RCS(fnid_sym(fid), line, col, tys, collect_subst_units(split.uvars, bindings.uvars), None))
  }
}

#[doc("True when two type lists are equal element by element.")]
pub fn ty_list_eq(a: [Ty], b: [Ty]) : Bool =
  match a {
    [] -> match b { [] -> true _ -> false }
    [ah, ...arest] -> match b {
      [] -> false
      [bh, ...brest] -> if ty_eq(ah, bh) { ty_list_eq(arest, brest) } else { false }
    }
  }

# `ty_eq` is a structural equality on resolved types. Conservative:
# `TyVarT` only matches itself by id; refinements / units erase at
# the type level (units distinguished separately in MonoTuple's
# `[UnitExprT]` field, refinements stay erased per Tier 1's
# value-only refinement semantics).
fn ty_eq(a: Ty, b: Ty) : Bool = ty_eq_bare(ty_unrefined(a), ty_unrefined(b))

fn ty_eq_bare(a: Ty, b: Ty) : Bool = {
  let ca = ty_scalar_code(a)
  if ca > 0 { ca == ty_scalar_code(b) } else { ty_eq_applied(a, b) }
}

# A distinct positive code for each type that takes no argument, 0 for
# one that does.
fn ty_scalar_code(t: Ty) : Int = match t {
  TyInt    -> 1
  TyReal   -> 2
  TyBool   -> 3
  TyChar   -> 4
  TyString -> 5
  TyUnit   -> 6
  TyByte   -> 7
  TyInt32  -> 8
  TyUInt32 -> 9
  TyUInt64 -> 10
  TyInt128 -> 11
  TyHandle -> 12
  TyAny    -> 13
  TyVarT(_)         -> 0
  TyListT(_)        -> 0
  TyFnT(_, _, _)    -> 0
  TyCon(_, _)       -> 0
  TyDimT(_, _)      -> 0
  TyRefineT(_, _)   -> 0
  TyShapeApp(_, _)  -> 0
  TyUnion(_)        -> 0
}

fn ty_eq_applied(a: Ty, b: Ty) : Bool = match a {
  TyVarT(ai)          -> ty_eq_var(ai, b)
  TyListT(ai)         -> ty_eq_list(ai, b)
  TyFnT(aps, ar, _)   -> ty_eq_fn(aps, ar, b)
  TyCon(sa, atas)     -> ty_eq_con(sa, atas, b)
  TyDimT(ab, _)       -> ty_eq_dim(ab, b)
  TyRefineT(ab, _)    -> ty_eq(ab, b)
  TyShapeApp(asv, aa) -> ty_eq_shape(asv, aa, b)
  TyUnion(aps)        -> ty_eq_union(aps, b)
  _                   -> false
}

fn ty_eq_var(ai: Int, b: Ty) : Bool = match b { TyVarT(bi) -> ai == bi  _ -> false }

fn ty_eq_list(ai: Ty, b: Ty) : Bool = match b { TyListT(bi) -> ty_eq(ai, bi)  _ -> false }

fn ty_eq_fn(aps: [Ty], ar: Ty, b: Ty) : Bool = match b {
  TyFnT(bps, br, _) -> ty_list_eq(aps, bps) and ty_eq(ar, br)
  _                 -> false
}

# A nominal type is its declaration: this keys specialisations, and
# `tuple.Pair` must not share a spec with a user `Pair`.
fn ty_eq_con(sa: SymId, atas: [Ty], b: Ty) : Bool = match b {
  TyCon(sb, btas) -> sym_same(sa, sb) and ty_list_eq(atas, btas)
  _               -> false
}

fn ty_eq_dim(ab: Ty, b: Ty) : Bool = match b { TyDimT(bb, _) -> ty_eq(ab, bb)  _ -> false }

fn ty_eq_shape(asv: Int, aa: Ty, b: Ty) : Bool = match b {
  TyShapeApp(bsv, ba) -> asv == bsv and ty_eq(aa, ba)
  _                   -> false
}

# Two unions are equal iff their canonical component lists are
# point-wise equal; a union that bypassed normalisation is rejected
# here, and that bypass is the bug.
fn ty_eq_union(aps: [Ty], b: Ty) : Bool = match b { TyUnion(bps) -> ty_list_eq(aps, bps)  _ -> false }
