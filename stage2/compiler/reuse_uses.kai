#[doc("""
Which scrutinee binders a reuse rebuild reads, shared by both backends.

A reuse arm donates the matched cell and overwrites its slots. A slot whose
binder the rebuild takes keeps its old child alive through that read; any
other slot's old child has no surviving owner once it is overwritten, so
the unique branch must release it. Both emitters decide that from the same
read set.
""")]

import compiler.ast
import compiler.local_names
import compiler.ast_map
import compiler.infer
import compiler.perceus_reads
import compiler.perceus_read_walk
import compiler.name_ix

#[doc("""
The multiset of reads of the binders `gc` the rebuild args reach, whatever
shape carries them (a call arg, a nested ctor, a match scrutinee, an `if`
branch, a block tail). `pcs_use_index` is the walker perceus's own dup
discipline runs on; `ns` names the binders `gc`.
""")]
pub fn reuse_gc_uses(ns: LocalNames, cargs: [Expr], gc: [LocalId]) : [LocalId] / Console = match gc {
  [] -> []
  _  -> ru_exprs(cargs, gc, map(gc, (l) => Binder { id: l, name: ln_text(ns, l) }), [])
}

#[doc("The reads of the binders `gc` in `cargs` that take a reference: a read lent to a borrowing call takes none.")]
pub fn reuse_taken_uses(ns: LocalNames, cargs: [Expr], gc: [LocalId]) : [LocalId] / Console =
  reuse_gc_uses(ns, map(cargs, reuse_unlent), gc)

#[doc("`e` with every read under `__perceus_borrow` erased: a lent read takes no reference.")]
pub fn reuse_unlent(e: Expr) : Expr = match e.kind {
  ECall(f, _) -> match f.kind {
    EMark(MkBorrow) -> Expr { ...e, kind: EUnit }
    _               -> ru_map(e)
  }
  _ -> ru_map(e)
}

fn ru_map(e: Expr) : Expr = Expr { ...e, kind: prc_map_expr_kind(e.kind, reuse_unlent) }

fn ru_exprs(es: [Expr], gc: [LocalId], scope: [Binder], acc: [LocalId]) : [LocalId] / Console = match es {
  []           -> acc
  [e, ...rest] -> {
    let ix = pcs_use_index(e, scope)
    ru_exprs(rest, gc, scope, ru_names(gc, ix, acc))
  }
}

# The collector grows its scope with lambda params, so it indexes their
# reads too: only the donor binders' reads count, one entry per read.
fn ru_names(gc: [LocalId], ix: UseIx, acc: [LocalId]) : [LocalId] = match gc {
  []           -> acc
  [g, ...rest] -> ru_names(rest, ix, ru_reads_of(g, ni_bucket_id(ix, local_raw(g)), acc))
}

fn ru_reads_of(g: LocalId, us: [Read], acc: [LocalId]) : [LocalId] = match us {
  [] -> acc
  [Rd(l, _, _, _, _), ...rest] -> ru_reads_of(g, rest, if local_eq(l, g) { [g, ...acc] } else { acc })
}

#[doc("The binders among `gc` that the rebuild takes (`uses` lists its taking reads).")]
pub fn reuse_taken_binders(gc: [LocalId], uses: [LocalId]) : [LocalId] = filter(gc, (n) => any(uses, (u) => local_eq(u, n)))
