#[doc("""
What a handle's clauses capture from the frame that installs it.

A handle is one site: its enclosing unit and its position. Each of its
clauses lifts to a function of its own and reads what it captures from
one env the install fills, so the install and every clause agree on one
order: the union of the clauses' captures, first occurrence first.

A capture is a local or an alias, told apart by its id. Two binders of
one spelling are two captures, and the install reads each from wherever
its own binder lives.
""")]

import compiler.ast
import compiler.emit_shared
import compiler.enc_unit

#[doc("True when both captures take the same local's value, or the same alias's handler id.")]
pub fn capture_same(a: Capture, b: Capture) : Bool = match a {
  CapLocal(x) -> match b { CapLocal(y) -> local_eq(x, y)  CapAlias(_) -> false }
  CapAlias(x) -> match b { CapAlias(y) -> local_eq(x, y)  CapLocal(_) -> false }
}

#[doc("The position of `c` among `caps`, or -1 when it is not one of them.")]
pub fn capture_index(caps: [Capture], c: Capture) : Int = capture_index_from(caps, c, 0)

fn capture_index_from(caps: [Capture], c: Capture, i: Int) : Int = match caps {
  []          -> 0 - 1
  [h, ...rest] -> if capture_same(h, c) { i } else { capture_index_from(rest, c, i + 1) }
}

#[doc("Every capture of `a` that `b` lacks, in order, then `b`.")]
pub fn merge_capture_set(a: [Capture], b: [Capture]) : [Capture] = match a {
  []          -> b
  [h, ...rest] ->
    if any(b, (x) => capture_same(x, h)) { merge_capture_set(rest, b) }
    else { [h, ...merge_capture_set(rest, b)] }
}

#[doc("The union of the captures of every clause of the handle at `(hline, hcol)` inside the unit `enc`: the layout of its env.")]
pub fn handle_captures_at(cls: [ClauseInfo], enc: EncFn, hline: Int, hcol: Int) : [Capture] = match cls {
  [] -> []
  [CI(line, col, _, _, _, _, _, enc_fn, caps, _, _), ...rest] ->
    if line == hline and col == hcol and enc_same(enc_fn, enc) {
      merge_capture_set(caps, handle_captures_at(rest, enc, hline, hcol))
    } else { handle_captures_at(rest, enc, hline, hcol) }
}
