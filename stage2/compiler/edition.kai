#[doc("""
The language editions the compiler knows.

An edition reaches the compiler as text, from `--edition <name>`, and
leaves it as text, in a diagnostic or a cache key. Between the two it
is an `Edition` constructor: `edition_of_name` is the one place the
text is read, and a gate keyed on an edition is a comparison of ranks.
""")]

#[doc("A language edition, oldest first.")]
pub type Edition = EdTongariki | EdHangaRoa | EdOrongo

#[doc("The edition a name spells, or `None` when it spells none.")]
pub fn edition_of_name(n: String) : Option[Edition] = match n {
  "tongariki" -> Some(EdTongariki)
  "hanga-roa" -> Some(EdHangaRoa)
  "orongo"    -> Some(EdOrongo)
  _           -> None
}

#[doc("The name an edition is selected by.")]
pub fn edition_name(e: Edition) : String = match e {
  EdTongariki -> "tongariki"
  EdHangaRoa  -> "hanga-roa"
  EdOrongo    -> "orongo"
}

#[doc("The position of an edition in release order, for `>=` gates.")]
pub fn edition_rank(e: Edition) : Int = match e {
  EdTongariki -> 0
  EdHangaRoa  -> 1
  EdOrongo    -> 2
}

#[doc("True when `have` is `target` or a later edition.")]
pub fn edition_at_least(have: Edition, target: Edition) : Bool =
  edition_rank(have) >= edition_rank(target)

#[doc("The edition a build runs under: the declared one, or the oldest when none was declared.")]
pub fn edition_or_oldest(declared: Option[Edition]) : Edition = match declared {
  Some(e) -> e
  None    -> EdTongariki
}

#[doc("The text a declared edition contributes to a cache key: its name, or empty when none was declared.")]
pub fn edition_key_text(declared: Option[Edition]) : String = match declared {
  Some(e) -> edition_name(e)
  None    -> ""
}
