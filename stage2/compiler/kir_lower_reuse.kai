import compiler.unwind_pend
import compiler.util
import compiler.written
import compiler.kir_lower_sig

# compiler/kir_lower_reuse.kai — nested (non-bijective) variant rotation
# reuse: the pattern-side slot plan and the unique-branch RC accounting.
#
# A rotation arm (`Node(_, Node(Red, lx, ..), ..) -> Node(.., Node(.., lx,
# ..), ..)`) deconstructs one INNER cell and rebuilds through fresh
# sub-ctors. When the donor is unique the dual-branch lowering
# (kir_lower_walk) donates BOTH shells — the outer by in-place overwrite,
# the inner via a stolen reuse token consumed by the first same-arity
# sub-ctor (Koka's 2-of-3 rotation reuse; the C oracle's `_ru_inner`).
# This module computes the per-slot plan from the arm pattern and settles
# the unique branch's RC before the rebuild args run.

# Result of scanning the direct slots for the single nested sub-ctor.
type RNFind = RNFound(Int, DeclRef, [Pattern]) | RNMulti | RNNone

# Slot classification accumulator; `RNBail` = an unsupported sub-pattern
# shape appeared, the whole arm keeps the fresh-alloc path.
type RNPlan = RNOk([RNSlot]) | RNBail

#[doc("""
Slot plan of a nested-rebuild variant reuse arm. `RNI` with a non-negative
`nslot` when the pattern deconstructs exactly ONE nested sub-ctor (the
rotation shape: outer overwrite + inner token donation); `RNI` with
`nslot = -1` when the pattern is flat but the rebuild nests (the
recolor-wrap shape: outer overwrite only). `RNInone` when any slot is an
unsupported sub-pattern shape — the rebuild then keeps the fresh-alloc
path. Tagged-immediate (Int) slots carry no plan entry. A single-head cons
arm plans its two direct slots flat: a head that is not a plain binder
(wildcard or deconstructed) has no binder the rebuild can take.
""")]
pub(pkg) fn pat_reuse_nested(p: Pattern, ix: CtorIx) : ReuseNested = match p.pkind {
  PVariant(r, subs)      -> rn_plan_variant(r, subs, ix)
  PList(elems, opt_rest) -> rn_plan_cons(elems, opt_rest)
  _                      -> RNInone
}

#[doc("A reuse arm's slot plans: the rotation plan, and the direct slots and inner cells a flat rebuild settles.")]
pub(pkg) fn pat_reuse_plan(p: Pattern, ix: CtorIx) : ReusePlan = {
  let rot = pat_reuse_nested(p, ix)
  let cells = reuse_pattern_cells(p, ix)
  ReusePlan { rot: rot, flat: rn_plan_flat_directs(p, cells, rot, ix), cells: cells }
}

fn rn_plan_flat_directs(p: Pattern, cells: [(Int, ReuseCell)], rot: ReuseNested, ix: CtorIx) : [RNSlot] = match p.pkind {
  PVariant(r, subs) ->
    match rn_slots(subs, pa_kinds(ix, r), 0, map(cells, (ic) => match ic { (i, _) -> i }), RNOk([])) {
      RNOk(directs) -> directs
      RNBail        -> []
    }
  _ -> rn_directs(rot)
}

# Nested list patterns inside a variant slot are a native lowering gap, so
# the head and rest are taken apart here, not in the `PList` pattern.
fn rn_plan_cons(elems: [Pattern], opt_rest: Option[Binder]) : ReuseNested = match elems {
  [hp] -> rn_cons_rest(rn_cons_head(hp), opt_rest)
  _    -> RNInone
}

fn rn_cons_rest(head: RNSlot, opt_rest: Option[Binder]) : ReuseNested = match opt_rest {
  Some(rest) -> RNI(2, 0 - 1, 0, [head, RNBind(1, rest.id)], [])
  None       -> RNInone
}

fn rn_cons_head(hp: Pattern) : RNSlot = match hp.pkind {
  PBind(b) -> RNBind(0, b.id)
  _        -> RNDrop(0)
}

fn rn_plan_variant(r: DeclRef, subs: [Pattern], ix: CtorIx) : ReuseNested = {
  let ks = pa_kinds(ix, r)
  match rn_find_nested(subs, 0) {
    RNFound(nslot, iref, isubs) -> rn_plan_rotation(subs, ks, nslot, iref, isubs, ix)
    RNMulti -> RNInone
    RNNone  -> rn_plan_flat(subs, ks)
  }
}

# The rotation shape: outer plan minus the nested slot + inner plan.
fn rn_plan_rotation(subs: [Pattern], ks: [Int], nslot: Int,
                    iref: DeclRef, isubs: [Pattern], ix: CtorIx) : ReuseNested = {
  let iks = pa_kinds(ix, iref)
  match rn_slots(subs, ks, 0, [nslot], RNOk([])) {
    RNOk(directs) -> match rn_slots(isubs, iks, 0, [], RNOk([])) {
      RNOk(grands) -> RNI(rn_arity(subs, ks), nslot,
                          rn_arity(isubs, iks), directs, grands)
      RNBail       -> RNInone
    }
    RNBail -> RNInone
  }
}

# The recolor-wrap shape: flat pattern, outer overwrite only.
fn rn_plan_flat(subs: [Pattern], ks: [Int]) : ReuseNested =
  match rn_slots(subs, ks, 0, [], RNOk([])) {
    RNOk(directs) -> RNI(rn_arity(subs, ks), 0 - 1, 0, directs, [])
    RNBail        -> RNInone
  }

# A ctor's arity: its registered payload count, pattern length if unknown.
fn rn_arity(subs: [Pattern], ks: [Int]) : Int =
  match ks { [] -> list_length(subs) _ -> list_length(ks) }

# Find the single nested sub-ctor slot (a PVariant with payload slots).
# A nullary ctor literal (`Red`) is a plain slot, not a nested cell.
fn rn_find_nested(subs: [Pattern], i: Int) : RNFind = match subs {
  []            -> RNNone
  [sp, ...rest] -> match sp.pkind {
    PVariant(iref, isubs) ->
      if list_length(isubs) > 0 {
        match rn_find_nested(rest, i + 1) {
          RNNone -> RNFound(i, iref, isubs)
          _      -> RNMulti
        }
      } else { rn_find_nested(rest, i + 1) }
    _ -> rn_find_nested(rest, i + 1)
  }
}

# Classify each slot into the RC plan, but for the `skips` slots (inner
# cells, settled on their own). Int
# slots are tagged immediates (no RC); a live binder plans `RNBind`, any
# binderless heap-box slot plans `RNDrop` (disposal by projection — a
# nullary-singleton or immediate drop is a runtime no-op).
fn rn_slots(subs: [Pattern], ks: [Int], i: Int, skips: [Int], acc: RNPlan) : RNPlan = match acc {
  RNBail      -> RNBail
  RNOk(sofar) -> match subs {
    []            -> RNOk(sofar)
    [sp, ...rest] -> {
      let k = kind_at(ks, i)
      rn_slots(rest, ks, i + 1, skips, rn_slot_add(sp, k, i, skips, sofar))
    }
  }
}

fn rn_slot_add(sp: Pattern, k: Int, i: Int, skips: [Int], sofar: [RNSlot]) : RNPlan =
  if k == 1 or contains(skips, i) { RNOk(sofar) }
  else { match sp.pkind {
    PBind(b)  -> RNOk([RNBind(i, b.id), ...sofar])
    PWild     -> RNOk([RNDrop(i), ...sofar])
    PLit(_)   -> RNOk([RNDrop(i), ...sofar])
    PVariant(_, isubs2) ->
      if list_length(isubs2) == 0 { RNOk([RNDrop(i), ...sofar]) } else { RNBail }
    _ -> RNBail
  } }

#[doc("""
Unique-branch RC settlement for the outer (direct) slots. The donated
shell's old references are owned by the rebuild: an embedded binder keeps
its first use for free (`uses-1` extra dups), an unused binder is dropped,
and a binderless slot's old value is dropped by projection. Runs before
the rebuild args so a consuming arg sees settled counts.
""")]
pub(pkg) fn rn_direct_acct(slots: [RNSlot], donor: KVal, uses: [LocalId], pos: KPos, st: LowerSt) : LowerSt = match slots {
  [] -> st
  [RNBind(_, nm), ...rest] -> {
    let k = rn_uses_of(uses, nm)
    let st1 = if k == 0 { ls_emit(st, KRC(KDrop(rn_reg(st, nm)), pos)) }
              else { rn_extra_dups(nm, k - 1, pos, st) }
    rn_direct_acct(rest, donor, uses, pos, st1)
  }
  [RNDrop(i), ...rest] ->
    match ls_fresh_reg(st) { LSReg(greg, st0) -> {
      let st1 = ls_emit(st0, KLet(greg, SBoxed, KProj(donor, i), pos))
      rn_direct_acct(rest, donor, uses, pos, ls_emit(st1, KRC(KDrop(KVar(greg)), pos)))
    } }
}

#[doc("""
Unique-branch RC settlement for the inner (grand) slots. Ownership of the
inner cell's old references is conditional on the steal: a non-null token
means they MOVED here, a null token (shared inner) means they did not. The
token-null incref makes every path own exactly one, then embedded binders
follow the direct rule and binderless slots are dropped by projection.
The inner cell and token travel as REGISTER NAMES (a fresh `KVar` per
use), never as one KVal reused across calls — the stage1-built compiler
miscompiles that shape.
""")]
pub(pkg) fn rn_grand_acct(slots: [RNSlot], innerreg: String, tokreg: String, uses: [LocalId], pos: KPos, st: LowerSt) : LowerSt = match slots {
  [] -> st
  [RNBind(_, nm), ...rest] -> {
    let k = rn_uses_of(uses, nm)
    match bind_op(st, KCall("kaix_incref_if_token_null", [KVar(tokreg), rn_reg(st, nm)]), pos) { LRes(_, st1) -> {
      let st2 = if k == 0 { ls_emit(st1, KRC(KDrop(rn_reg(st1, nm)), pos)) }
                else { rn_extra_dups(nm, k - 1, pos, st1) }
      rn_grand_acct(rest, innerreg, tokreg, uses, pos, st2)
    } }
  }
  [RNDrop(j), ...rest] ->
    match ls_fresh_reg(st) { LSReg(greg, st0) -> {
      let st1 = ls_emit(st0, KLet(greg, SBoxed, KProj(KVar(innerreg), j), pos))
      match bind_op(st1, KCall("kaix_incref_if_token_null", [KVar(tokreg), KVar(greg)]), pos) { LRes(_, st2) ->
        rn_grand_acct(rest, innerreg, tokreg, uses, pos, ls_emit(st2, KRC(KDrop(KVar(greg)), pos))) }
    } }
}

#[doc("""
Unique-branch payment of the donor slots a FLAT variant rebuild does not
re-embed. The in-place move overwrites every slot without decref-ing the
old children; a re-embedded child's claim transfers with the move, but a
wildcard / unused-binder slot's old child keeps the donor's claim with no
surviving owner — one leaked cell per reuse. Drops those by projection
(borrow read + drop) before the overwrite. Re-embedded binders are left
alone: their per-use accounting (`kaix_incref_if_shared`) already balances.
""")]
pub(pkg) fn rn_flat_unique_drops(slots: [RNSlot], donor: KVal, uses: [LocalId], pos: KPos, st: LowerSt) : LowerSt = match slots {
  [] -> st
  [RNBind(i, nm), ...rest] ->
    rn_flat_unique_drops(rest, donor, uses, pos,
      if rn_uses_of(uses, nm) == 0 { rn_proj_drop(donor, i, pos, st) } else { st })
  [RNDrop(i), ...rest] ->
    rn_flat_unique_drops(rest, donor, uses, pos, rn_proj_drop(donor, i, pos, st))
}

#[doc("The direct slots of a reuse plan, empty when the arm has none.")]
pub(pkg) fn rn_directs(rn: ReuseNested) : [RNSlot] = match rn {
  RNI(_, _, _, ds, _) -> ds
  RNInone             -> []
}

fn rn_proj_drop(donor: KVal, i: Int, pos: KPos, st: LowerSt) : LowerSt =
  match ls_fresh_reg(st) { LSReg(greg, st0) -> {
    let st1 = ls_emit(st0, KLet(greg, SBoxed, KProj(donor, i), pos))
    ls_emit(st1, KRC(KDrop(KVar(greg)), pos))
  } }

# Multiset count of `nm` among the rebuild's scrutinee-binder uses.
fn rn_uses_of(uses: [LocalId], nm: LocalId) : Int = match uses {
  []            -> 0
  [u, ...rest]  -> if local_eq(u, nm) { 1 + rn_uses_of(rest, nm) } else { rn_uses_of(rest, nm) }
}

# The binder's active register (through any shadow rename), as an atom.
fn rn_reg(st: LowerSt, nm: LocalId) : KVal = KVar(ls_reg_of(st, nm))

# Emit `n` unconditional dups of a binder (its extra embedded uses).
fn rn_extra_dups(nm: LocalId, n: Int, pos: KPos, st: LowerSt) : LowerSt =
  if n <= 0 { st }
  else { rn_extra_dups(nm, n - 1, pos, ls_emit(st, KRC(KDup(rn_reg(st, nm)), pos))) }

#[doc("The lowering state after the inner cells are settled, and the registers to drop once the rebuild's args have run.")]
pub(pkg) type CellOwn = CellOwn(LowerSt, [String])

#[doc("Settle `cells`, the inner cells beneath `donor`'s slots, for either donor.")]
pub(pkg) fn kc_cells_own(cells: [(Int, ReuseCell)], donor: KVal, uses: [LocalId], pos: KPos, st: LowerSt) : CellOwn =
  kc_cells_go(cells, donor, uses, pos, CellOwn(st, []))

#[doc("""
The uses of binders outside `cells`. A taken binder beneath a cell ends
with exactly one reference whatever its uses, so it must not also take
the donor's per-use shared incref.
""")]
pub(pkg) fn kc_uses_outside_cells(uses: [LocalId], cells: [(Int, ReuseCell)]) : [LocalId] = {
  let owned = flat_map(cells, (ic) => match ic { (_, c) -> kc_cell_names(c) })
  filter(uses, (u) => not lid_has(owned, u))
}

#[doc("Drop each register `regs` names.")]
pub(pkg) fn kc_drop_regs(regs: [String], pos: KPos, st: LowerSt) : LowerSt = match regs {
  []           -> st
  [r, ...rest] -> kc_drop_regs(rest, pos, ls_emit(st, KRC(KDrop(KVar(r)), pos)))
}

fn kc_cells_go(cells: [(Int, ReuseCell)], donor: KVal, uses: [LocalId], pos: KPos, acc: CellOwn) : CellOwn = match cells {
  [] -> acc
  [(i, c), ...rest] -> match acc { CellOwn(st, ds) -> match ls_fresh_reg(st) { LSReg(creg, st0) -> {
    let st1 = ls_emit(ls_emit(st0, KLet(creg, SBoxed, KProj(donor, i), pos)), KRC(KIncrefIfShared(donor, KVar(creg)), pos))
    kc_cells_go(rest, donor, uses, pos, kc_cell_own(c, creg, uses, pos, CellOwn(st1, ds)))
  } } }
}

# `creg` holds an owned reference to the cell.
fn kc_cell_own(c: ReuseCell, creg: String, uses: [LocalId], pos: KPos, acc: CellOwn) : CellOwn = match c {
  ReuseCell(n, kids) -> match acc { CellOwn(st, ds) -> match ls_fresh_reg(st) { LSReg(tok, st0) -> {
    let st1 = ls_emit(st0, KLet(tok, SBoxed, KTokenSteal(KVar(creg), n), pos))
    match kc_kids_own(kids, creg, tok, uses, pos, CellOwn(st1, ds)) { CellOwn(st2, ds2) ->
      CellOwn(ls_emit(st2, KRC(KFreeToken(KVar(tok)), pos)), ds2) }
  } } }
}

fn kc_kids_own(kids: [CellKid], creg: String, tok: String, uses: [LocalId], pos: KPos, acc: CellOwn) : CellOwn = match kids {
  []             -> acc
  [kid, ...rest] -> kc_kids_own(rest, creg, tok, uses, pos, kc_kid_own(kid, creg, tok, uses, pos, acc))
}

fn kc_kid_own(kid: CellKid, creg: String, tok: String, uses: [LocalId], pos: KPos, acc: CellOwn) : CellOwn = match acc {
  CellOwn(st, ds) -> match kid {
    KidBind(j, nm) ->
      if lid_has(uses, nm) { CellOwn(kc_own_if_shared(tok, KVar(ls_reg_of(st, nm)), pos, st), ds) }
      else { kc_kid_drop_later(j, creg, tok, pos, st, ds) }
    KidDrop(j) -> kc_kid_drop_later(j, creg, tok, pos, st, ds)
    KidCell(j, c) -> match kc_kid_slot(j, creg, tok, pos, st) { LSReg(g, st1) ->
      kc_cell_own(c, g, uses, pos, CellOwn(st1, ds)) }
  }
}

fn kc_kid_drop_later(j: Int, creg: String, tok: String, pos: KPos, st: LowerSt, ds: [String]) : CellOwn =
  match kc_kid_slot(j, creg, tok, pos, st) { LSReg(g, st1) -> CellOwn(st1, [g, ...ds]) }

# Slot `j` of the stolen cell, as an owned reference: moved when the token
# holds the shell, incref'd when the cell stayed shared.
fn kc_kid_slot(j: Int, creg: String, tok: String, pos: KPos, st: LowerSt) : LSReg =
  match ls_fresh_reg(st) { LSReg(g, st0) ->
    LSReg(g, kc_own_if_shared(tok, KVar(g), pos, ls_emit(st0, KLet(g, SBoxed, KProj(KVar(creg), j), pos)))) }

fn kc_own_if_shared(tok: String, v: KVal, pos: KPos, st: LowerSt) : LowerSt =
  match bind_op(st, KCall("kaix_incref_if_token_null", [KVar(tok), v]), pos) { LRes(_, st1) -> st1 }

fn kc_cell_names(c: ReuseCell) : [LocalId] = match c {
  ReuseCell(_, kids) -> flat_map(kids, (kid) => match kid {
    KidBind(_, nm) -> [nm]
    KidDrop(_)     -> []
    KidCell(_, c2) -> kc_cell_names(c2)
  })
}

#[doc("True when the enclosing match registered its scrutinee: a rebuild here can be left by an exit that releases the cell.")]
pub(pkg) fn rh_held(st: LowerSt) : Bool = st.mscr != "" and unw_mreg(st.unw, st.mscr) != ""

#[doc("`st` with the arm binders `names` owned, so the sites that hold them register them.")]
pub(pkg) fn rh_own(st: LowerSt, names: [LocalId]) : LowerSt =
  if st.unw.arms == [] or names == [] { st } else { ls_with_unw(st, unw_owning(st.unw, names)) }

#[doc("Take each child `names` binds out of `donor`, once per name: a unique cell clears the slot, a shared one increfs the child.")]
pub(pkg) fn rh_take_slots(donor: KVal, names: [LocalId], pos: KPos, st: LowerSt) : LowerSt = match names {
  [] -> st
  [n, ...rest] -> match bind_op(st, KCall("kaix_take_slot", [donor, KVar(ls_reg_of(st, n))]), pos) {
    LRes(_, st1) -> rh_take_slots(donor, rest, pos, st1)
  }
}

#[doc("The registrations a rebuild holds: each push register with the temp it registers.")]
pub(pkg) type RhHolds = { regs: [(String, String)], st: LowerSt }

#[doc("Hold `v`, the value of operand `e` of kind `k`, when a later operand runs and no binder already holds it.")]
pub(pkg) fn rh_hold(e: Expr, v: KVal, k: Int, later: Bool, pos: KPos, h: RhHolds) : RhHolds = match v {
  KVar(r) -> if later and k != 1 and not unw_bare_read(e) { rh_push(r, pos, h) } else { h }
  _       -> h
}

fn rh_push(r: String, pos: KPos, h: RhHolds) : RhHolds = match ls_fresh_reg(h.st) {
  LSReg(f, st1) -> {
    let st2 = ls_emit(st1, KLet(f, SBoxed, KPrim(KpUnwPushReg, [KStrV(r), KVar(unw_fib(st1.unw))]), pos))
    RhHolds { regs: [(f, r), ...h.regs], st: ls_set_tcpend(st2, tcl_hold(st2.tcpend, f, r)) }
  }
}

#[doc("Pop every registration `h` holds, once the last operand has run.")]
pub(pkg) fn rh_release(h: RhHolds, pos: KPos) : LowerSt = rh_pops(h.regs, pos, h.st)

fn rh_pops(regs: [(String, String)], pos: KPos, st: LowerSt) : LowerSt = match regs {
  [] -> st
  [(f, r), ...rest] -> {
    let st1 = ls_emit(st, KDo(KPrim(KpUnwPop, [KVar(f)]), pos))
    rh_pops(rest, pos, ls_set_tcpend(st1, tcl_unhold(st1.tcpend, f, r)))
  }
}

#[doc("The occurrences in `xs` after each name's first: what a taken slot leaves for the per-use incref.")]
pub(pkg) fn rh_repeats(xs: [LocalId]) : [LocalId] = rh_repeats_go(xs, [])

fn rh_repeats_go(xs: [LocalId], seen: [LocalId]) : [LocalId] = match xs {
  [] -> []
  [x, ...rest] -> if lid_has(seen, x) { [x, ...rh_repeats_go(rest, seen)] } else { rh_repeats_go(rest, [x, ...seen]) }
}

#[doc("The state a pad or bracket opened over, restored when it closes; `None` when nothing opened.")]
pub(pkg) type PadB = PadB(Option[UnwPadOpen], LowerSt)

#[doc("Opens, before lowering `x`, a landing pad releasing the admitted binders among `names` not already released.")]
pub(pkg) fn lower_pad_begin(x: Expr, names: [LocalId], st: LowerSt) : PadB = {
  let outer = st.unw.pad
  let own = filter(lp_union(map(unw_admit(st.unw, names), (n) => ls_reg_of(st, n)), outer.flight), (r) => not list_has(outer.regs, r))
  match own {
    [] -> PadB(None, st)
    _  -> {
      lp_disjoint(own, outer.pushed, "a pad releases a register a bracket holds", x, st)
      let regs = lp_union(outer.regs, own)
      match ls_fresh_reg(st) { LSReg(pr, st1) -> {
        let st2 = ls_emit(st1, KLet(pr, SBoxed, KPrim(KpPadOpen, map(regs, (r) => KVar(r))), kpos_of(x)))
        PadB(Some(outer), ls_with_unw(st2, unw_with_pad(st2.unw, UnwPadOpen { reg: pr, regs: regs, pushed: outer.pushed, flight: outer.flight })))
      } }
    }
  }
}

#[doc("Closes, after lowering `x`, the pad `lower_pad_begin` opened, reopening the one around it.")]
pub(pkg) fn lower_pad_end(x: Expr, outer: Option[UnwPadOpen], st: LowerSt) : LowerSt = match outer {
  None -> st
  Some(o) -> {
    let back = if o.reg == "" { [] } else { [KVar(o.reg)] }
    let st1 = ls_emit(st, KDo(KPrim(KpPadClose, back), kpos_of(x)))
    ls_with_unw(st1, unw_with_pad(st1.unw, o))
  }
}

#[doc("`st` with the registers `held` pushed by a bracket around `x`, asserting no open pad releases them; returns the pad state to restore.")]
pub(pkg) fn lower_bracket_begin(x: Expr, held: [String], st: LowerSt) : PadB = {
  let outer = st.unw.pad
  lp_disjoint(held, outer.regs, "a bracket holds a register a pad releases", x, st)
  PadB(Some(outer), ls_with_unw(st, unw_with_pad(st.unw, UnwPadOpen { reg: outer.reg, regs: outer.regs, pushed: lp_union(outer.pushed, held), flight: lp_minus(outer.flight, held) })))
}

#[doc("`st` with the bracket `lower_bracket_begin` pushed popped from the pad state.")]
pub(pkg) fn lower_bracket_end(outer: Option[UnwPadOpen], st: LowerSt) : LowerSt = match outer {
  None -> st
  Some(o) -> ls_with_unw(st, unw_with_pad(st.unw, o))
}

#[doc("`st` with `v`, the value the operand `x` computed, in flight until its parent takes it, when it holds a reference of its own.")]
pub(pkg) fn lower_flight_add(x: Expr, v: KVal, st: LowerSt) : LowerSt = match v {
  KVar(r) -> if lp_owned_temp(x, st) { lp_with_flight(st, lp_union(st.unw.pad.flight, [r])) } else { st }
  _ -> st
}

#[doc("`st` with `v` in flight while the operands after `x` run; the last operand runs with nothing after it.")]
pub(pkg) fn lower_flight_next(x: Expr, v: KVal, last: Bool, st: LowerSt) : LowerSt =
  if last { st } else { lower_flight_add(x, v, st) }

#[doc("The values in flight that neither an open pad nor a bracket already releases.")]
pub(pkg) fn lower_flight_free(st: LowerSt) : [String] = {
  let p = st.unw.pad
  lp_minus(lp_minus(p.flight, p.regs), p.pushed)
}

#[doc("Opens, before the operator `op` of `x` runs, a landing pad that also releases the operand references it consumes, when it compares values that are not scalars: the runtime holds them while the type's own implementation runs, and a trap there leaves through no pad of its own.")]
pub(pkg) fn lower_consumed_pad(x: Expr, op: BinOp, operands: [(Expr, KVal)], st: LowerSt) : PadB = match lp_consumed(operands, st) {
  [] -> PadB(None, st)
  extra -> if binop_is_comparison(op) and st.unw.traps and unw_op_traps(op, lp_first(operands, x)) {
    let outer = st.unw.pad
    match ls_fresh_reg(st) { LSReg(pr, st1) -> {
      let regs = list_append(lp_union(outer.regs, lp_minus(outer.flight, outer.pushed)), extra)
      let st2 = ls_emit(st1, KLet(pr, SBoxed, KPrim(KpPadOpen, map(regs, (r) => KVar(r))), kpos_of(x)))
      PadB(Some(outer), ls_with_unw(st2, unw_with_pad(st2.unw, UnwPadOpen { reg: pr, regs: regs, pushed: outer.pushed, flight: outer.flight })))
    } }
  } else { PadB(None, st) }
}

fn lp_first(operands: [(Expr, KVal)], dflt: Expr) : Expr = match operands {
  [(e, _), ..._] -> e
  [] -> dflt
}

# The operand registers holding a reference of their own that the
# operator takes: a dup of a binder, or a value an operand computed.
fn lp_consumed(operands: [(Expr, KVal)], st: LowerSt) : [String] = match operands {
  [] -> []
  [(e, v), ...rest] -> match v {
    KVar(r) -> if lp_is_dup(e) or lp_owned_temp(e, st) { [r, ...lp_consumed(rest, st)] } else { lp_consumed(rest, st) }
    _ -> lp_consumed(rest, st)
  }
}

fn lp_is_dup(e: Expr) : Bool = match e.kind {
  ECall(f, [_]) -> match f.kind {
    EMark(MkDup) -> true
    _            -> false
  }
  _ -> false
}

#[doc("`st` with the register `r` in flight: a value the frame owns that no binder holds, until `lower_flight_land` takes it out.")]
pub(pkg) fn lower_flight_hold(r: String, st: LowerSt) : LowerSt = lp_with_flight(st, lp_union(st.unw.pad.flight, [r]))

#[doc("`st` with the register `r` no longer in flight.")]
pub(pkg) fn lower_flight_land(r: String, st: LowerSt) : LowerSt = lp_with_flight(st, lp_minus(st.unw.pad.flight, [r]))

#[doc("`st` with the values in flight back to those of `before`, once their parent has taken them.")]
pub(pkg) fn lower_flight_end(before: LowerSt, st: LowerSt) : LowerSt = lp_with_flight(st, before.unw.pad.flight)

fn lp_with_flight(st: LowerSt, fl: [String]) : LowerSt = {
  let p = st.unw.pad
  ls_with_unw(st, unw_with_pad(st.unw, UnwPadOpen { reg: p.reg, regs: p.regs, pushed: p.pushed, flight: fl }))
}

# A fresh reference: a call's result or a value built in place. A bare
# read hands over a binder the walk already tracks, a dup is that same
# register, and a compiler form may lend.
fn lp_owned_temp(x: Expr, st: LowerSt) : Bool = match x.mode {
  MUnboxed -> false
  _ -> match x.ty {
    Some(t) -> if ty_is_scalar(t) { false } else { lp_fresh(x, st) }
    None -> false
  }
}

fn lp_fresh(x: Expr, st: LowerSt) : Bool = match x.kind {
  ECall(f, xs)          -> lp_owning_call(f, xs, st)
  EBinop(_, _, _)       -> true
  ERecordLit(_, _)      -> not st.in_region
  EList([_, ..._])      -> not st.in_region
  _                     -> false
}

fn lp_owning_call(f: Expr, xs: [Expr], st: LowerSt) : Bool = match f.kind {
  ELocal(_)      -> true
  EOp(_)         -> true
  ESym(s, _)     -> match builtin_of(s) {
    Some(b) -> lp_owning_kind(classify_builtin(b))
    None    -> true
  }
  EMark(MkOwnedBorrow) -> match xs {
    [inner] -> lp_fresh(inner, st)
    _       -> false
  }
  EMark(m)       -> mark_is_reuse(m) or mark_is_prim(m)
  _              -> false
}

fn lp_owning_kind(k: CalleeKind) : Bool = match k {
  CkDirect -> true
  _        -> false
}

fn lp_disjoint(a: [String], b: [String], what: String, x: Expr, st: LowerSt) : Unit = match a {
  [] -> ()
  [r, ...rest] -> if list_has(b, r) {
    panic(concat_all(["kir: ", what, ": ", r, " in fn ", st.enc_fn.sym, " at ", int_to_string(x.line), ":", int_to_string(x.col)]))
  } else { lp_disjoint(rest, b, what, x, st) }
}

fn lp_minus(a: [String], b: [String]) : [String] = filter(a, (r) => not list_has(b, r))

#[doc("The registers of `a` and then those of `b` not in `a`.")]
pub(pkg) fn lp_union(a: [String], b: [String]) : [String] = match b {
  [] -> a
  [r, ...rest] -> lp_union(if list_has(a, r) { a } else { list_append(a, [r]) }, rest)
}

# True iff ANY tail leaf of `body` is a `MkTrmcStep` modulo-cons step
# (the C oracle's `trmc_body_has_step`). Such an arm's scrutinee cell is reused
# in place by a TRMC step on at least one path; the arm-top reuse token model
# (`KArmTopReuse`) captures the consumed cell once at the arm top so the step
# reuses it (or frees it on a non-step tail like `balance_left(ins(l,..),..)`).
# A pure self-tcrec body is NOT a step (its callee is `MkTcrecStep`).
pub(pkg) fn body_has_trmc_step(body: Expr) : Bool = match body.kind {
  ECall(f, _) -> match f.kind { EMark(MkTrmcStep(_)) -> true  _ -> false }
  EIf(_, t, oe) -> body_has_trmc_step(t) or match oe { None -> false Some(e) -> body_has_trmc_step(e) }
  EMatch(_, arms) -> arms_have_trmc_step(arms)
  EBlock(_, ot) -> match ot { None -> false Some(e) -> body_has_trmc_step(e) }
  _ -> false
}

fn arms_have_trmc_step(arms: [Arm]) : Bool = match arms {
  []                         -> false
  [Arm(_, _, body), ...rest] -> if body_has_trmc_step(body) { true } else { arms_have_trmc_step(rest) }
}

# A reference to a declared fn is a direct call, whatever intrinsic shares
# its name.
pub(pkg) fn ls_classify(st: LowerSt, fid: FnId) : CalleeKind = match fnx_of_sym(st.fx, fid) {
  Some(_) -> CkDirect
  None    -> match builtin_of(fnid_sym(fid)) {
    Some(b) -> classify_builtin(b)
    None    -> CkDirect
  }
}

pub(pkg) type RCKind = KDupMk | KDropMk

pub(pkg) fn reuse_kind_of(m: Mark) : KReuseKind = match m {
  MkReuseCons -> RkCons
  _           -> RkVariant
}

# Rebuild args + the lowered atoms, plus whether the inner token was donated.
pub(pkg) type LResDon = LResDon([KVal], Bool, LowerSt)

# The constructor the call `e` builds: the one its callee's id names.
fn ctor_of_call(e: Expr, st: LowerSt) : Option[CtorLay] = match e.kind {
  ECall(cf, _) -> match cf.kind {
    ESym(s, _) -> ls_ctor_lay(st, s)
    _          -> None
  }
  _ -> None
}

# The ctor of a rebuild arg that can absorb the CROSS-CALL donor: any
# nested sub-ctor call, once the inner token has been placed (`ready`) and
# while the donor is unconsumed. No arity filter — the donor's arity is the
# caller's, checked at runtime by `kai_variant_at` (fresh alloc on
# mismatch), exactly the C backend's rewrite of the first remaining fresh
# cell.
pub(pkg) fn donor_ctor(e: Expr, ready: Bool, st: LowerSt) : Option[CtorLay] =
  if not ready { None }
  else { match e.kind {
    ECall(_, cas) -> if list_length(cas) > 0 { ctor_of_call(e, st) } else { None }
    _ -> None
  } }

# The ctor of a rebuild arg that can absorb the inner token: a direct
# ctor call of the stolen shell's arity, while the token is still available.
pub(pkg) fn donate_ctor(e: Expr, n_inner: Int, donated: Bool, st: LowerSt) : Option[CtorLay] =
  if donated { None }
  else { match e.kind {
    ECall(_, cas) -> if list_length(cas) == n_inner { ctor_of_call(e, st) } else { None }
    _ -> None
  } }

# Neutralise the enclosing match's exit drop after a UNIQUE-branch in-place
# move: the rewritten cell IS the result (`RkVariantMove` returns it at
# rc==1, no survive-the-drop incref), so rebind the exit-drop register to
# unit — the C oracle's `_r = _scr; _scr = NULL`. The shared branch leaves
# the register live, and a borrowed match (`mscr` empty) emits nothing.
pub(pkg) fn reuse_neutralise_exit_drop(st: LowerSt, pos: KPos) : LowerSt =
  if st.mscr == "" { st } else { ls_emit(st, KStore(st.mscr, KUnitV, pos)) }

# The shared branch's fresh allocation: a real cons cell for a cons rebuild
# (`Cons` is the builtin list ctor, not a registered variant), a variant
# ctor otherwise.
pub(pkg) fn reuse_fresh_op(rk: KReuseKind, c: CtorLay, avs: [KVal], st: LowerSt) : KOp = match rk {
  RkCons -> KPrim(KpCons, avs)
  _      -> KCon(c.name, c.tag, c.mask, typed_inits(avs, c), st.in_region)
}

# Dup each direct scrutinee slot (head `PBind` / `...rest`) for the shared
# branch, resolving through any active shadow like `emit_reuse_gc_increfs`.
pub(pkg) fn emit_direct_dups(directs: [LocalId], pos: KPos, st: LowerSt) : LowerSt = match directs {
  []           -> st
  [n, ...rest] -> emit_direct_dups(rest, pos, ls_emit(st, KRC(KDup(KVar(ls_reg_of(st, n))), pos)))
}

pub(pkg) fn reuse_kind_is_variant(rk: KReuseKind) : Bool = match rk { RkVariant -> true RkCons -> false RkTokenVariant -> false RkDonorVariant -> false RkVariantMove -> true }

# True iff any rebuild arg is a nested ctor call (the non-bijective rotation
# shape). Such a rebuild embeds grand-children of a deconstructed inner cell.
pub(pkg) fn reuse_has_nested_ctor(cargs: [Expr], st: LowerSt) : Bool = match cargs {
  []           -> false
  [e, ...rest] -> if expr_is_ctor_call(e, st) { true } else { reuse_has_nested_ctor(rest, st) }
}

fn expr_is_ctor_call(e: Expr, st: LowerSt) : Bool = match ctor_of_call(e, st) {
  Some(_) -> true
  None    -> false
}

# Emit one `KIncrefIfShared(donor, KVar(reg))` per binder in `uses` (a multiset:
# a binder embedded twice appears twice). Order vs the reuse op is irrelevant —
# nothing mutates the donor between, so each helper's `check_unique` agrees with
# the reuse op's own (asu sign-off). Names only, never the donor itself.
pub(pkg) fn emit_reuse_gc_increfs(donor: KVal, uses: [LocalId], pos: KPos, st: LowerSt) : LowerSt = match uses {
  []           -> st
  # A shadowed kept child increfs the register the rebuild actually read.
  [n, ...rest] -> emit_reuse_gc_increfs(donor, rest, pos,
      ls_emit(st, KRC(KIncrefIfShared(donor, KVar(ls_reg_of(st, n))), pos)))
}

# Unconditional `dup` per embedded borrowed leaf for the FRESH-alloc nested path
# (multiset). The whole outer is fresh-allocated, so each embedded scrutinee
# child needs its own ref; the match-exit `kai_decref(donor)` cascade then frees
# the donor + inner + the original child refs, leaving the dup as the result's.
pub(pkg) fn emit_reuse_leaf_dups(uses: [LocalId], pos: KPos, st: LowerSt) : LowerSt = match uses {
  []           -> st
  [n, ...rest] -> emit_reuse_leaf_dups(rest, pos, ls_emit(st, KRC(KDup(KVar(ls_reg_of(st, n))), pos)))
}

# Per-slot ctor-arg lowering result: the slot inits + threaded state.
pub(pkg) type LCtorInits = LCtorInits([KSlotInit], LowerSt)

# An owned-borrow temp computed in place is held by no binder, so across a
# call that can unwind it is registered for the call's extent; one that only
# renames a binder is not, since the binder is registered already.
pub(pkg) type ObHeld = { reg: String, st: LowerSt }

pub(pkg) fn ob_held(x: Expr, cargs: [Expr], avs: [KVal], st: LowerSt) : ObHeld = match unw_call_of(st.unw, x) {
  None -> ObHeld { reg: "", st: st }
  Some(_) -> match ob_marked_vals(cargs, avs) {
    [] -> ObHeld { reg: "", st: st }
    vs -> match ls_fresh_reg(st) { LSReg(f, st0) ->
      ObHeld { reg: f, st: ls_emit(st0, KLet(f, SBoxed, KPrim(KpUnwPush, [KVar(unw_fib(st0.unw)), ...vs]), kpos_of(x))) } }
  }
}

fn ob_renames(c: Expr) : Bool = match c.kind {
  ECall(_, [inner]) -> unw_bare_read(inner)
  _                 -> false
}

pub(pkg) fn ob_release(h: ObHeld, r: LRes) : LRes = match r {
  LRes(v, st) -> if h.reg == "" { r } else { LRes(v, ls_emit(st, KDo(KPrim(KpUnwPop, [KVar(h.reg)]), KNoPos))) }
}

fn ob_marked_vals(cargs: [Expr], avs: [KVal]) : [KVal] = match (cargs, avs) {
  ([c, ...crest], [v, ...vrest]) -> {
    let more = ob_marked_vals(crest, vrest)
    match v { KVar(_) -> if ob_is_marked(c) and not ob_renames(c) { [v, ...more] } else { more } _ -> more }
  }
  _ -> []
}

# An owned value in a borrowed slot: the callee borrows it and no binder
# holds it, so the caller releases the birth ref right after the call. The
# mark lowers to its inner value and the call site emits the drop, which
# must follow the call op — before it is a UAF.
pub(pkg) fn ob_is_marked(a: Expr) : Bool = match a.kind {
  ECall(callee, _) -> match callee.kind {
    EMark(MkOwnedBorrow) -> true
    _                    -> false
  }
  _ -> false
}

# A String literal lowers to an atom each use materialises afresh, so a marked
# one is bound to a register: the call and its drop must see one value.
pub(pkg) fn ob_pin_literals(cargs: [Expr], avs: [KVal], st: LowerSt, acc: [KVal]) : LResMany = match cargs {
  [c, ...crest] -> match avs {
    [v, ...vrest] ->
      if ob_is_marked(c) and ob_is_str(v) {
        match ls_fresh_reg(st) { LSReg(reg, st0) ->
          ob_pin_literals(crest, vrest, ls_emit(st0, KLet(reg, SBoxed, KLitOp(v), kpos_of(c))), [KVar(reg), ...acc]) }
      } else { ob_pin_literals(crest, vrest, st, [v, ...acc]) }
    [] -> LResMany(list_reverse(acc), st)
  }
  [] -> LResMany(list_append(list_reverse(acc), avs), st)
}

fn ob_is_str(v: KVal) : Bool = match v {
  KStrV(_) -> true
  _        -> false
}

pub(pkg) fn ob_drop_after(r: LRes, cargs: [Expr], avs: [KVal], pos: KPos) : LRes = match r {
  LRes(v, st) -> LRes(v, ob_drop_go(st, cargs, avs, pos))
}

fn ob_drop_go(st: LowerSt, cargs: [Expr], avs: [KVal], pos: KPos) : LowerSt = match cargs {
  []           -> st
  [c, ...crest] -> match avs {
    []           -> st
    [v, ...vrest] -> {
      let st1 = if ob_is_marked(c) { ls_emit(st, KRC(KDrop(v), pos)) } else { st }
      ob_drop_go(st1, crest, vrest, pos)
    }
  }
}

# KIR spells its spine: the constructor's run-time name, or the word a
# dump shows for a builtin cons.
pub(pkg) fn trmc_spine(sp: TrmcSpine, st: LowerSt) : KSpine = match sp {
  TsCtor(c) -> KSpineCtor(written_text(decl_name(st.tab, c)))
  _         -> KSpineCons(trmc_spine_word(sp))
}

pub(pkg) fn trmc_spine_lay(sp: TrmcSpine, st: LowerSt) : Option[CtorLay] = match trmc_spine_ctor(sp) {
  Some(c) -> ls_ctor_lay(st, c)
  None    -> None
}

# The ctor args minus the hole slot, in slot order — the real head value(s)
# the backend uses to build the spine cell (NULL plugged at the hole).
pub(pkg) fn trmc_drop_nth(xs: [Expr], hole: Int, i: Int, acc: [Expr]) : [Expr] = match xs {
  [] -> acc
  [a, ...rest] ->
    if i == hole { trmc_drop_nth(rest, hole, i + 1, acc) }
    else         { trmc_drop_nth(rest, hole, i + 1, list_append(acc, [a])) }
}

# The self-call's arguments, read from the hole-slot ctor arg. The producer
# always plants the self call there; any other shape (or an
# out-of-range hole) yields no rebinds, matching the C oracle's `_ -> []`.
pub(pkg) fn trmc_self_args(xs: [Expr], hole: Int) : [Expr] = match xs {
  [] -> []
  [a, ...rest] ->
    if hole == 0 { match a.kind { ECall(_, sa) -> sa _ -> [] } }
    else         { trmc_self_args(rest, hole - 1) }
}

# True iff the trmc-apply leaf is a variant con-reuse of the match scrutinee
# — the shape that increfs the donor and so needs the exit drop the terminal
# RET skips.
pub(pkg) fn trmc_apply_leaf_reuses_scr(leaf: Expr) : Bool = match leaf.kind {
  ECall(cf, _) -> match cf.kind { EMark(MkReuseVariant) -> true _ -> false }
  _            -> false
}
