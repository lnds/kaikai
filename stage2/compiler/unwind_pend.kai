#[doc("""
Owned references a frame holds across a call that can exit non-locally.

A handler clause that discards `resume`, a delivered cancellation and a
fiber trap leave through `longjmp`, skipping every release the frames
between the jump and its landing pad still owed. Each such frame
registers, around a call that can unwind, the binders it owns and has
not yet handed on; the runtime releases what lies above the landing
pad's mark.

The pending set is the goto-tail ledger's (`emit_tcrec_live`) applied to
a different jump: a binder enters when its birth reference exists and
leaves at the first mention that might consume it. The filter only ever
removes entries, so a stale entry under-releases (a bounded leak), never
over-releases. Both emitters read the sites computed here.

Sites are keyed by source position within one frame. Two sites that
share a position keep the intersection of their names.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.emit_shared_fv
import compiler.emit_shared_proto
import compiler.emit_tcrec_live
import compiler.enc_unit
import compiler.expr_positions
import compiler.fnreg
import compiler.modules_homes
import compiler.operators
import compiler.unwind_clauses
import compiler.util

#[doc("""
A frame's sites plus the context that computes them, threaded through an
emitter. `arms` are the match-arm binders the sites may name; one is
registered only once the emitter has bound it with its own reference
(`own`). `scr` asks the next `match` to register its scrutinee, and stays
set for the arms of one that did; `mstack` holds the enclosing native
matches that registered theirs. `bound` are the frame's binders, which tell a call
through a local closure from a call to a fn. `fib` is the native
register holding the frame's fiber cache, absent until the lowering
makes one. `traps` asks for the native landing pads; `pad` is the open
one, if any.
""")]
pub(pkg) type UnwFrame = { ucx: UnwCx, sites: [UnwSite], bound: [LocalId], arms: [LocalId], own: [LocalId], scr: Bool, mstack: [UnwM], fib: Option[String], traps: Bool, pad: UnwPadOpen }

#[doc("An open landing pad: the register naming it and every register it releases, the enclosing pads' included; `pushed` are the registers the enclosing brackets hold; `flight` the owned operand values computed and not yet taken by their parent, which every pad opened meanwhile releases too.")]
pub(pkg) type UnwPadOpen = { reg: String, regs: [String], pushed: [String], flight: [String] }

fn up_no_pad() : UnwPadOpen = UnwPadOpen { reg: "", regs: [], pushed: [], flight: [] }

#[doc("A native match's registered scrutinee: its exit-drop register and the pushing fiber register.")]
pub(pkg) type UnwM = UnwM(String, String)

#[doc("A frame with no sites, carrying `ucx` for the frames nested in it.")]
pub(pkg) fn unw_frame_none(ucx: UnwCx) : UnwFrame = UnwFrame { ucx: ucx, sites: [], bound: [], arms: [], own: [], scr: false, mstack: [], fib: None, traps: false, pad: up_no_pad() }

#[doc("`u` asking every frame nested in it for the native landing pads.")]
pub(pkg) fn unw_with_traps(u: UnwFrame) : UnwFrame =
  UnwFrame { ucx: u.ucx, sites: u.sites, bound: u.bound, arms: u.arms, own: u.own, scr: u.scr, mstack: u.mstack, fib: u.fib, traps: true, pad: u.pad }

#[doc("`u` with the landing pad `p` open.")]
pub(pkg) fn unw_with_pad(u: UnwFrame, p: UnwPadOpen) : UnwFrame =
  UnwFrame { ucx: u.ucx, sites: u.sites, bound: u.bound, arms: u.arms, own: u.own, scr: u.scr, mstack: u.mstack, fib: u.fib, traps: u.traps, pad: p }

#[doc("A frame with nothing to register under `u`'s context: `u` itself when it is one.")]
pub(pkg) fn unw_blank(u: UnwFrame) : UnwFrame = if up_blank(u) { u } else { up_keep_traps(unw_frame_none(u.ucx), u.traps) }

fn up_keep_traps(u: UnwFrame, traps: Bool) : UnwFrame = if traps { unw_with_traps(u) } else { u }

fn up_blank(u: UnwFrame) : Bool = match u.fib {
  Some(_) -> false
  None    -> not u.scr and list_length(u.sites) == 0 and list_length(u.arms) == 0
             and list_length(u.own) == 0 and list_length(u.mstack) == 0 and u.pad.reg == ""
}

#[doc("""
The frame of the unit `enc`, declared with `row`, or `None`
for one without a declaration: the typer holds a body to its row, so a fn
whose row cannot unwind and that installs no handler makes no call that
can.
""")]
pub(pkg) fn unw_fn_frame(u: UnwFrame, enc: EncUnit, row: Option[RowExpr], seeds: [LocalId], params: [LocalId], body: Expr) : UnwFrame / Console =
  match row {
    Some(r) -> if not u.traps and unw_row_class(r, u.ucx) == 0 and not unit_in(u.ucx.handles, enc) { up_exits_only(u, seeds, params, body) }
               else { unw_frame(u, seeds, params, body) }
    None -> unw_frame(u, seeds, params, body)
  }

# A frame that cannot unwind keeps only its early returns: its calls are
# never bracketed.
fn up_exits_only(u: UnwFrame, seeds: [LocalId], params: [LocalId], body: Expr) : UnwFrame =
  if not unw_has_exit(body) { unw_blank(u) }
  else {
    let f = unw_frame(u, seeds, params, body)
    UnwFrame { ucx: f.ucx, sites: filter(f.sites, (s) => unw_is_exit(s)), bound: f.bound, arms: f.arms, own: f.own, scr: f.scr, mstack: f.mstack, fib: f.fib, traps: f.traps, pad: f.pad }
  }

#[doc("The frame of `body` with owned entry binders `seeds` among its params `params`.")]
pub(pkg) fn unw_frame(u: UnwFrame, seeds: [LocalId], params: [LocalId], body: Expr) : UnwFrame =
  if not u.traps and not unw_scan(body, u.ucx) { unw_blank(u) }
  else {
    let ucx = u.ucx
    let bound = unw_binders(body, params)
    let banned = unw_dups(bound, [], [])
    UnwFrame { ucx: ucx, sites: unw_walk(ucx, unw_minus(seeds, banned), bound, banned, params, body, u.traps), bound: bound,
               arms: unw_minus(unw_arm_binders(body, []), banned), own: [], scr: false, mstack: [], fib: None,
               traps: u.traps, pad: up_no_pad() }
  }

#[doc("The binders among `names` the emitter may register: a match-arm binder only once its arm owns it.")]
pub(pkg) fn unw_admit(u: UnwFrame, names: [LocalId]) : [LocalId] = match names {
  [] -> []
  [n, ...rest] ->
    if unw_has(u.arms, n) and not unw_has(u.own, n) { unw_admit(u, rest) }
    else { [n, ...unw_admit(u, rest)] }
}

#[doc("True when the call `x` registers pending references around itself: some name its site holds is still owned and boxed. A call with nothing held is no bracketed call.")]
pub(pkg) fn unw_bracketed(u: UnwFrame, x: Expr, boxed: (LocalId) -> Bool) : Bool = match unw_call_of(u, x) {
  Some(names) -> unw_held(u, names, boxed) != []
  None        -> false
}

#[doc("The binders among `names` a site registers or releases: the admitted ones that `boxed` accepts.")]
pub(pkg) fn unw_held(u: UnwFrame, names: [LocalId], boxed: (LocalId) -> Bool) : [LocalId] = filter(unw_admit(u, names), boxed)

#[doc("`u` with the arm binders `names` owned by the arm being emitted.")]
pub(pkg) fn unw_owning(u: UnwFrame, names: [LocalId]) : UnwFrame =
  if u.arms == [] { u } else { UnwFrame { ucx: u.ucx, sites: u.sites, bound: u.bound, arms: u.arms, own: list_append(names, u.own), scr: u.scr, mstack: u.mstack, fib: u.fib, traps: u.traps, pad: u.pad } }

#[doc("`u` with its fiber held in native register `f`.")]
pub(pkg) fn unw_with_fib(u: UnwFrame, f: String) : UnwFrame =
  UnwFrame { ucx: u.ucx, sites: u.sites, bound: u.bound, arms: u.arms, own: u.own, scr: u.scr, mstack: u.mstack, fib: Some(f), traps: u.traps, pad: u.pad }

#[doc("The native register holding `u`'s fiber cache.")]
pub(pkg) fn unw_fib(u: UnwFrame) : String = match u.fib {
  Some(f) -> f
  None    -> ""
}

#[doc("`u` asking (or not) the next `match` to register its scrutinee.")]
pub(pkg) fn unw_with_scr(u: UnwFrame, b: Bool) : UnwFrame =
  UnwFrame { ucx: u.ucx, sites: u.sites, bound: u.bound, arms: u.arms, own: u.own, scr: b, mstack: u.mstack, fib: u.fib, traps: u.traps, pad: u.pad }

#[doc("`u` recording that the match dropping `sd` registered its scrutinee under fiber register `f`.")]
pub(pkg) fn unw_mpush(u: UnwFrame, sd: String, f: String) : UnwFrame =
  UnwFrame { ucx: u.ucx, sites: u.sites, bound: u.bound, arms: u.arms, own: u.own, scr: u.scr, mstack: [UnwM(sd, f), ...u.mstack], fib: u.fib, traps: u.traps, pad: u.pad }

#[doc("`u` without the record of the match dropping `sd`; unchanged when that match registered nothing.")]
pub(pkg) fn unw_mpop(u: UnwFrame, sd: String) : UnwFrame = match u.mstack {
  [UnwM(d, _), ...rest] ->
    if d == sd { UnwFrame { ucx: u.ucx, sites: u.sites, bound: u.bound, arms: u.arms, own: u.own, scr: u.scr, mstack: rest, fib: u.fib, traps: u.traps, pad: u.pad } } else { u }
  _ -> u
}

#[doc("The fiber register the match dropping `sd` pushed its scrutinee under; empty when it pushed nothing.")]
pub(pkg) fn unw_mreg(u: UnwFrame, sd: String) : String = match u.mstack {
  [UnwM(d, f), ..._] -> if d == sd { f } else { "" }
  _ -> ""
}

#[doc("The params a fn owns on entry: not borrowed, not raw under its unboxed signature, not a capability.")]
pub(pkg) fn unw_param_seeds(params: [Param], sig: Option[UFnSig], ucx: UnwCx) : [LocalId] = match sig {
  Some(US(_, _, mask)) -> uw_seeds_masked(params, mask, ucx)
  None                 -> uw_seeds_masked(params, [], ucx)
}

fn uw_seeds_masked(params: [Param], mask: [Bool], ucx: UnwCx) : [LocalId] = match params {
  [] -> []
  [p, ...rest] -> {
    let raw = match mask {
      [m, ..._] -> m
      []        -> false
    }
    let mrest = match mask {
      [_, ...r] -> r
      []        -> []
    }
    let tail = uw_seeds_masked(rest, mrest, ucx)
    if raw or p.pborrow or unw_is_cap_param(ucx, p.ptype) { tail } else { [p.binder.id, ...tail] }
  }
}

#[doc("The params a handler clause owns: every op argument; the continuation is always last.")]
pub(pkg) fn unw_clause_seeds(c: ClauseInfo) : [LocalId] = match c {
  CI(_, _, _, _, cps, _, _, _, _, _, _) -> uw_all_but_last(cps)
}

fn uw_all_but_last(ps: [Param]) : [LocalId] = match ps {
  []           -> []
  [_]          -> []
  [p, ...rest] -> [p.binder.id, ...uw_all_but_last(rest)]
}

#[doc("The binders registered at the call `x`, if it is a site; a call that cannot unwind never is, even where one that can shares its position and callee.")]
pub(pkg) fn unw_call_of(u: UnwFrame, x: Expr) : Option[[LocalId]] = match u.sites {
  [] -> None
  _  -> if up_brackets(u, x) { unw_call_names(u.sites, x) } else { None }
}

#[doc("The binders the landing pad at `x` releases, if `x` has one; a call that can unwind is bracketed instead, never padded.")]
pub(pkg) fn unw_pad_of(u: UnwFrame, x: Expr) : Option[[LocalId]] = match u.sites {
  [] -> None
  _  -> if up_brackets(u, x) { None } else { unw_pad_names(u.sites, x) }
}

fn up_brackets(u: UnwFrame, x: Expr) : Bool = match x.kind {
  ECall(f, xs) -> unw_call_unwinds(f, xs, u.bound, u.ucx)
  _ -> false
}

#[doc("The binders registered at the call `x` (an `ECall`), if it is a site.")]
fn unw_call_names(sites: [UnwSite], x: Expr) : Option[[LocalId]] = match sites {
  [] -> None
  _  -> match x.kind {
    ECall(_, _) -> unw_call_at(sites, x.site)
    _ -> None
  }
}

#[doc("A node the emitter brackets, keyed by its site id: a call that can unwind with the binders it registers, a `match` whose arms hold such a call, a `handle` with the outer binders that survive it, a native landing pad (an expression that can trap) or the pad around an `assert` (keyed by its condition) with the binders the pad releases, or a `!` with the binders its early return releases.")]
pub(pkg) type UnwSite = UnwCall(Int, [LocalId]) | UnwMatch(Int) | UnwHandle(Int, [LocalId]) | UnwPad(Int, [LocalId]) | UnwAssert(Int, [LocalId]) | UnwExit(Int, [LocalId])

#[doc("True when the `match` with site id `site` has an arm holding a call that can unwind.")]
pub(pkg) fn unw_match_at(sites: [UnwSite], site: Int) : Bool = match sites {
  [] -> false
  [s, ...rest] -> match s {
    UnwMatch(k) -> k == site or unw_match_at(rest, site)
    _ -> unw_match_at(rest, site)
  }
}

#[doc("`sites` with `s`. A node is one site: the walk registering the same node twice must register the same binders, or the emitters would release one set where the other is pending.")]
fn unw_add(s: UnwSite, sites: [UnwSite]) : [UnwSite] = match unw_same(sites, s) {
  None     -> [s, ...sites]
  Some(ps) -> if unw_same_names(us_names(s), ps) { sites }
              else { panic(concat_all(["unwind site ", int_to_string(us_site(s)), " registered twice with different binders"])) }
}

fn unw_same_names(a: [LocalId], b: [LocalId]) : Bool =
  list_length(a) == list_length(b) and list_length(unw_inter(a, b)) == list_length(a)

# The names the site of the same kind and node as `s` already holds.
fn unw_same(sites: [UnwSite], s: UnwSite) : Option[[LocalId]] = match sites {
  [] -> None
  [x, ...rest] -> if us_kind(x) == us_kind(s) and us_site(x) == us_site(s) { Some(us_names(x)) } else { unw_same(rest, s) }
}

fn us_kind(s: UnwSite) : Int = match s {
  UnwCall(_, _) -> 0  UnwMatch(_) -> 1  UnwHandle(_, _) -> 2  UnwPad(_, _) -> 3  UnwAssert(_, _) -> 4  UnwExit(_, _) -> 5
}

fn us_site(s: UnwSite) : Int = match s {
  UnwCall(k, _) -> k  UnwMatch(k) -> k  UnwHandle(k, _) -> k  UnwPad(k, _) -> k  UnwAssert(k, _) -> k  UnwExit(k, _) -> k
}

fn us_names(s: UnwSite) : [LocalId] = match s {
  UnwCall(_, ns) -> ns  UnwMatch(_) -> []  UnwHandle(_, ns) -> ns  UnwPad(_, ns) -> ns  UnwAssert(_, ns) -> ns  UnwExit(_, ns) -> ns
}

fn us_with(s: UnwSite, ns: [LocalId]) : UnwSite = match s {
  UnwCall(k, _)   -> UnwCall(k, ns)
  UnwMatch(_)     -> s
  UnwHandle(k, _) -> UnwHandle(k, ns)
  UnwPad(k, _)    -> UnwPad(k, ns)
  UnwAssert(k, _) -> UnwAssert(k, ns)
  UnwExit(k, _)   -> UnwExit(k, ns)
}

fn unw_names_of(sites: [UnwSite], kind: Int, site: Int) : Option[[LocalId]] = match sites {
  [] -> None
  [s, ...rest] -> if us_kind(s) == kind and us_site(s) == site { Some(us_names(s)) } else { unw_names_of(rest, kind, site) }
}

#[doc("The names the early return of the `!` with site id `site` releases, if there is one.")]
pub(pkg) fn unw_exit_at(sites: [UnwSite], site: Int) : Option[[LocalId]] = unw_names_of(sites, 5, site)

#[doc("The names registered at the call with site id `site`, if there is one.")]
fn unw_call_at(sites: [UnwSite], site: Int) : Option[[LocalId]] = unw_names_of(sites, 0, site)

#[doc("The names the landing pad of the node with site id `site` releases, if there is one.")]
fn unw_pad_at(sites: [UnwSite], site: Int) : Option[[LocalId]] = unw_names_of(sites, 3, site)

#[doc("The names the landing pad around the `assert` whose condition has site id `site` releases, if there is one.")]
pub(pkg) fn unw_assert_at(sites: [UnwSite], site: Int) : Option[[LocalId]] = unw_names_of(sites, 4, site)

#[doc("The names pending at the `handle` with site id `site` that outlive it, if it is a site.")]
pub(pkg) fn unw_handle_at(sites: [UnwSite], site: Int) : Option[[LocalId]] = unw_names_of(sites, 2, site)

#[doc("True when `s` releases on a path of its own (a landing pad or an early return) rather than bracketing.")]
fn unw_is_pad(s: UnwSite) : Bool = match s {
  UnwPad(_, _)    -> true
  UnwAssert(_, _) -> true
  UnwExit(_, _)   -> true
  _ -> false
}

#[doc("True when `s` is the early return of a `!`.")]
pub(pkg) fn unw_is_exit(s: UnwSite) : Bool = match s {
  UnwExit(_, _) -> true
  _ -> false
}

#[doc("The sites `new` minus the names `drop`, added to `acc`.")]
fn unw_merge(new: [UnwSite], drop: [LocalId], acc: [UnwSite]) : [UnwSite] = match new {
  [] -> acc
  [s, ...rest] -> unw_merge(rest, drop, unw_add(us_minus(s, drop), acc))
}

fn us_minus(s: UnwSite, drop: [LocalId]) : UnwSite = match drop {
  [] -> s
  _  -> us_with(s, unw_minus(us_names(s), drop))
}

#[doc("True when a call through `f` can trap: every call but the compiler's marks. A name calls a declared fn or a closure, whatever its spelling.")]
fn unw_call_traps(f: Expr) : Bool = match f.kind {
  EMark(MkApplyBorrow) -> true
  EMark(_)             -> false
  _                    -> true
}

#[doc("True when the binary operator `op` on the operand `a` can trap: integer division and remainder, and any operator but concatenation and the logical ones on a value that is not a scalar, which calls the type's own implementation.")]
pub(pkg) fn unw_op_traps(op: BinOp, a: Expr) : Bool =
  binop_is_division(op) or (up_dispatches(op) and not up_scalar(a.ty))

fn up_dispatches(op: BinOp) : Bool = match op {
  BoConcat -> false
  BoAnd    -> false
  BoOr     -> false
  _        -> true
}

fn up_scalar(t: Option[Ty]) : Bool = match t {
  Some(x) -> ty_is_scalar(x)
  None    -> true
}

#[doc("The binders the landing pad at `x` releases, if `x` has one; only a node that can trap has one, whatever shares its position.")]
fn unw_pad_names(sites: [UnwSite], x: Expr) : Option[[LocalId]] = match sites {
  [] -> None
  _  -> if up_trap_kind(x) { unw_pad_at(sites, x.site) } else { None }
}

fn up_trap_kind(x: Expr) : Bool = match x.kind {
  ECall(_, _)     -> true
  EIndex(_, _)    -> true
  EBinop(_, _, _) -> true
  _               -> false
}

#[doc("The binders among `live` passed to `f` as owned-borrow arguments of `xs`: released only after the call returns, so held across it.")]
fn unw_lent(f: Expr, xs: [Expr], live: [LocalId]) : [LocalId] = uw_lent_at(f, xs, xs, 0, live)

fn uw_lent_at(f: Expr, all: [Expr], xs: [Expr], i: Int, live: [LocalId]) : [LocalId] = match xs {
  [] -> []
  [a, ...rest] -> {
    let more = uw_lent_at(f, all, rest, i + 1, live)
    match uw_owned_borrow_var(a) {
      Some(n) ->
        if unw_has(live, n) and not tcl_consumes(f, n) and not uw_consumed_besides(all, i, 0, n) { [n, ...more] }
        else { more }
      None -> more
    }
  }
}

fn uw_owned_borrow_var(a: Expr) : Option[LocalId] = match a.kind {
  ECall(g, [y]) -> match g.kind {
    EMark(MkOwnedBorrow) -> match y.kind {
      ELocal(l) -> Some(l)
      _         -> None
    }
    _ -> None
  }
  _ -> None
}

fn uw_consumed_besides(xs: [Expr], skip: Int, i: Int, n: LocalId) : Bool = match xs {
  [] -> false
  [x, ...rest] -> (i != skip and tcl_consumes(x, n)) or uw_consumed_besides(rest, skip, i + 1, n)
}

#[doc("`pend` without the binders `e` consumes or might consume: `pend` itself when it consumes none.")]
fn unw_filter(pend: [LocalId], e: Expr) : [LocalId] =
  if uw_any_consumed(pend, e) { uw_unconsumed(pend, e) } else { pend }

fn uw_any_consumed(pend: [LocalId], e: Expr) : Bool = match pend {
  [] -> false
  [p, ...rest] -> tcl_consumes(e, p) or uw_any_consumed(rest, e)
}

fn uw_unconsumed(pend: [LocalId], e: Expr) : [LocalId] = match pend {
  [] -> []
  [p, ...rest] -> if tcl_consumes(e, p) { uw_unconsumed(rest, e) } else { [p, ...uw_unconsumed(rest, e)] }
}

#[doc("`pend` without the binders statement `s` consumes, might consume or rebinds.")]
fn unw_filter_stmt(pend: [LocalId], s: Stmt) : [LocalId] =
  unw_minus(uw_filter_each(pend, stmt_exprs(s)), unw_stmt_binders(s))

fn uw_filter_each(pend: [LocalId], es: [Expr]) : [LocalId] = match es {
  [] -> pend
  [e, ...rest] -> uw_filter_each(unw_filter(pend, e), rest)
}

#[doc("The union of every list in `eaten` except the `i`-th.")]
fn unw_others(eaten: [[LocalId]], i: Int, j: Int) : [LocalId] = match eaten {
  [] -> []
  [e, ...rest] -> if i == j { unw_others(rest, i, j + 1) } else { unw_union(e, unw_others(rest, i, j + 1)) }
}

#[doc("The binders of `xs` mentioned only in `h`'s inline code: never in its clauses, never elsewhere in `body`, never one of `jumps`.")]
fn unw_confined(xs: [LocalId], h: Expr, jumps: [LocalId], body: Expr) : [LocalId] = match xs {
  [] -> []
  [x, ...rest] -> {
    let tail = unw_confined(rest, h, jumps, body)
    let inside = uw_count(x, h, true)
    if not unw_has(jumps, x) and inside == uw_count(x, h, false) and inside == uw_count(x, body, false) {
      [x, ...tail]
    } else { tail }
  }
}

# Reads of `x` in `e`. `inline_only` skips lambda and clause bodies.
fn uw_count(x: LocalId, e: Expr, inline_only: Bool) : Int = match e.kind {
  ELocal(l) -> if local_eq(l, x) { 1 } else { 0 }
  _ -> uw_count_ps(x, xp_positions(e), inline_only)
}

fn uw_count_ps(x: LocalId, ps: [XPos], inline_only: Bool) : Int = match ps {
  [] -> 0
  [XP(r, c), ...rest] ->
    (if inline_only and not xrole_inline(r) { 0 } else { uw_count(x, c, inline_only) })
      + uw_count_ps(x, rest, inline_only)
}

#[doc("True when a call of `f` reads its operand without taking it: a dup, a borrow, a guard-fail drop.")]
fn unw_lending(f: Expr) : Bool = match f.kind {
  EMark(MkDup) -> true
  EMark(MkBorrow) -> true
  EMark(MkGuardDrop) -> true
  _ -> false
}

# `banned` holds a binder bound twice in the frame: a mention cannot say
# which binding it reads, so neither is ever registered. `locals` are
# every binder of the frame, the test for a call through a local closure.
# `jumps` are the params a tail-call goto may release without naming them.
type UwFx = { ucx: UnwCx, banned: [LocalId], locals: [LocalId], body: Expr, jumps: [LocalId], traps: Bool }

type UwR = { pend: [LocalId], sites: [UnwSite] }

#[doc("The sites of the frame `body`: `pend` its owned entry binders, `bound` every binder it introduces, `banned` those bound twice; `traps` adds the native landing pads.")]
fn unw_walk(ucx: UnwCx, pend: [LocalId], bound: [LocalId], banned: [LocalId], params: [LocalId], body: Expr, traps: Bool) : [UnwSite] = {
  let fx = UwFx { ucx: ucx, banned: banned, locals: bound, body: body,
                  jumps: if tcl_has_goto(body) { params } else { [] }, traps: traps }
  uw_expr(body, pend, [], fx, []).sites
}

# Returns the pending set after `e` and the sites found inside it.
fn uw_expr(e: Expr, pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = match e.kind {
  EBlock(ss, ot) -> uw_block(ss, ot, pend, z, fx, sites)
  EIf(c, t, oe) -> uw_if(c, t, oe, pend, z, fx, sites)
  EMatch(s, arms) -> uw_match(e, s, arms, pend, z, fx, sites)
  EHandle(body, _, _, oi, _, _, oret) -> uw_handle(e, body, oi, oret, pend, z, fx, sites)
  ELambda(_, _) -> UwR { pend: pend, sites: sites }
  EIntrinsic(name, xs) ->
    if unw_is_loop(name) { uw_loop(e, xs, pend, z, fx, sites) }
    else { uw_nary(e, pend, z, fx, sites) }
  ECall(f, xs) ->
    if unw_call_unwinds(f, xs, fx.locals, fx.ucx) { uw_site(e, f, xs, pend, z, fx, sites) }
    else if unw_lending(f) { UwR { pend: unw_filter(pend, e), sites: uw_nary(e, pend, z, fx, sites).sites } }
    else if fx.traps and unw_call_traps(f) { uw_pad_op(e, Some(UwLends(f, xs)), pend, z, fx, sites) }
    else { uw_merged(uw_args(e, f, xs, pend, z, fx), sites) }
  _ -> uw_leaf(e, pend, z, fx, sites)
}

# A call's operands, walked; a binder read bare where the callee borrows
# is still the frame's once the call returns.
fn uw_args(e: Expr, f: Expr, xs: [Expr], pend: [LocalId], z: [LocalId], fx: UwFx) : UwR = {
  let r = uw_nary(e, pend, z, fx, [])
  match unw_lent_reads(f, xs, fx.ucx) {
    []   -> r
    lent -> UwR { pend: unw_union(r.pend, unw_inter(lent, pend)), sites: r.sites }
  }
}

fn uw_merged(r: UwR, sites: [UnwSite]) : UwR = UwR { pend: r.pend, sites: unw_merge(r.sites, [], sites) }

fn uw_leaf(e: Expr, pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = match e.kind {
  EBang(inner) -> uw_exit(e, inner, pend, z, fx, sites)
  _ -> if fx.traps and uw_op_traps(e) { uw_pad_op(e, None, pend, z, fx, sites) } else { uw_nary(e, pend, z, fx, sites) }
}

fn uw_op_traps(e: Expr) : Bool = match e.kind {
  EIndex(_, _)     -> true
  EBinop(op, a, _) -> unw_op_traps(op, a)
  _                -> false
}

fn uw_if(c: Expr, t: Expr, oe: Option[Expr], pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = {
  let rc = uw_expr(c, pend, z, fx, sites)
  let rt = uw_expr(t, rc.pend, z, fx, rc.sites)
  match oe {
    None -> UwR { pend: unw_inter(rc.pend, rt.pend), sites: rt.sites }
    Some(el) -> {
      let re = uw_expr(el, rc.pend, z, fx, rt.sites)
      UwR { pend: unw_inter(rt.pend, re.pend), sites: re.sites }
    }
  }
}

fn uw_match(e: Expr, s: Expr, arms: [Arm], pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = {
  let rs = uw_expr(s, pend, z, fx, sites)
  let ra = uw_arms(arms, unw_scr_owned(s), rs.pend, z, fx, rs.sites, None)
  let after = match ra.pend { Some(p) -> p None -> rs.pend }
  UwR { pend: after, sites: uw_scope_site(e, rs.sites, ra.sites) }
}

# A call that can unwind registers what is live across it and not handed
# to it, and the emitter adds the closure it calls through a local; a site
# inside its operands leaves those names to this one.
fn uw_site(e: Expr, f: Expr, xs: [Expr], pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = {
  let live = unw_minus(pend, z)
  let r = uw_args(e, f, xs, pend, z, fx)
  let held = unw_minus(unw_union(unw_inter(live, r.pend), unw_lent(f, xs, live)), fx.banned)
  UwR { pend: r.pend, sites: unw_add(UnwCall(e.site, held), unw_merge(r.sites, unw_union(held, uw_local_callee(f, fx)), sites)) }
}

fn uw_local_callee(f: Expr, fx: UwFx) : [LocalId] = match f.kind {
  ELocal(l) -> if unw_has(fx.locals, l) { [l] } else { [] }
  _         -> []
}

# An expression that can trap releases what is live across it through a
# landing pad, and what a call only lends; with a bracket in its operands
# it has none.
fn uw_pad_op(e: Expr, lends: Option[UwLends], pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = {
  let live = unw_minus(pend, z)
  let r = match lends {
    Some(UwLends(f, xs)) -> uw_args(e, f, xs, pend, z, fx)
    None -> uw_nary(e, pend, z, fx, [])
  }
  if uw_all_pads(r.sites) {
    let lent = match lends { Some(UwLends(f, xs)) -> unw_lent(f, xs, live) None -> [] }
    let held = unw_minus(unw_union(unw_inter(live, r.pend), lent), fx.banned)
    UwR { pend: r.pend, sites: unw_add(UnwPad(e.site, held), unw_merge(r.sites, held, sites)) }
  } else { UwR { pend: r.pend, sites: unw_merge(r.sites, [], sites) } }
}

type UwLends = UwLends(Expr, [Expr])

# A `!` that returns early releases what the frame still owns past it.
fn uw_exit(e: Expr, inner: Expr, pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = {
  let live = unw_minus(pend, z)
  let r = uw_expr(inner, pend, z, fx, [])
  let held = unw_minus(unw_inter(live, r.pend), fx.banned)
  UwR { pend: r.pend, sites: unw_add(UnwExit(e.site, held), unw_merge(r.sites, [], sites)) }
}

fn uw_all_pads(ss: [UnwSite]) : Bool = match ss {
  [] -> true
  [s, ...rest] -> unw_is_pad(s) and uw_all_pads(rest)
}

# Children run left to right: each child is walked once, and a site
# inside it then drops what an earlier sibling consumed. A sibling that
# is a bare read hands its reference over only when the parent runs. A
# child that is not run inline (a lambda, a clause) is judged by its reads.
# Removing a name from a site set commutes with every step that builds it,
# so dropping it afterwards is the same as never letting it in.
fn uw_nary(e: Expr, pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = match xp_positions(e) {
  [] -> UwR { pend: unw_filter(pend, e), sites: sites }
  ps -> {
    let rs = uw_walk_children(ps, pend, z, fx)
    let eaten = map(rs, (r) => unw_minus(pend, r.pend))
    UwR { pend: unw_minus(pend, unw_others(eaten, -1, 0)), sites: uw_join(ps, rs, eaten, [], sites) }
  }
}

fn uw_walk_children(ps: [XPos], pend: [LocalId], z: [LocalId], fx: UwFx) : [UwR] = match ps {
  [] -> []
  [XP(r, c), ...rest] -> [uw_child(r, c, pend, z, fx), ...uw_walk_children(rest, pend, z, fx)]
}

fn uw_child(r: XRole, c: Expr, pend: [LocalId], z: [LocalId], fx: UwFx) : UwR = match r {
  XLam -> UwR { pend: pend, sites: [] }
  XCl  -> UwR { pend: unw_filter(pend, c), sites: [] }
  _    -> uw_expr(c, pend, z, fx, [])
}

# `gone` holds what the earlier siblings consumed.
fn uw_join(ps: [XPos], rs: [UwR], eaten: [[LocalId]], gone: [LocalId], acc: [UnwSite]) : [UnwSite] = match (ps, rs, eaten) {
  ([XP(_, c), ...ps2], [r, ...rs2], [e, ...es2]) ->
    uw_join(ps2, rs2, es2, if unw_bare_read(c) { gone } else { unw_union(gone, e) }, unw_merge(r.sites, gone, acc))
  _ -> acc
}

fn uw_block(ss: [Stmt], ot: Option[Expr], pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = match ss {
  [] -> match ot {
    None    -> UwR { pend: pend, sites: sites }
    Some(t) -> uw_expr(t, pend, z, fx, sites)
  }
  [s, ...rest] -> {
    let r = uw_stmt(s, pend, z, fx, sites)
    let after = uw_block(rest, ot, r.pend, z, fx, r.sites)
    UwR { pend: unw_minus(after.pend, unw_stmt_binders(s)), sites: after.sites }
  }
}

fn uw_stmt(s: Stmt, pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = match s {
  SLet(pat, _, rhs) -> {
    let r = uw_expr(rhs, pend, z, fx, sites)
    UwR { pend: unw_union(r.pend, uw_owned_let(pat, rhs, fx)), sites: r.sites }
  }
  SExprStmt(x) -> uw_expr(x, pend, z, fx, sites)
  SAssert(c, _) -> if fx.traps { uw_assert(s, c, pend, z, fx, sites) } else { uw_stmt_generic(s, pend, z, fx, sites) }
  _ -> uw_stmt_generic(s, pend, z, fx, sites)
}

fn uw_stmt_generic(s: Stmt, pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR =
  uw_stmt_nary(xp_positions(Expr { kind: EBlock([s], None), line: 0, col: 0, ty: None, mode: MUnknown , site: 0 }),
                    pend, z, fx, sites, s)

# A failed `assert` leaves the frame like a trap.
fn uw_assert(s: Stmt, c: Expr, pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = {
  let live = unw_minus(pend, z)
  let r = uw_stmt_generic(s, pend, z, fx, [])
  if uw_all_pads(r.sites) {
    let held = unw_minus(unw_inter(live, r.pend), fx.banned)
    UwR { pend: r.pend, sites: unw_add(UnwAssert(c.site, held), unw_merge(r.sites, held, sites)) }
  } else { UwR { pend: r.pend, sites: unw_merge(r.sites, [], sites) } }
}

fn uw_stmt_nary(ps: [XPos], pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite], s: Stmt) : UwR = {
  let rs = uw_walk_children(ps, pend, z, fx)
  let eaten = map(rs, (r) => unw_minus(pend, r.pend))
  UwR { pend: unw_minus(unw_filter_stmt(pend, s), unw_others(eaten, -1, 0)), sites: uw_join(ps, rs, eaten, [], sites) }
}

# A boxed `let` binder holds its birth reference: every binding perceus
# tracks has one, and a raw rhs keeps the binder out of its scope. A
# destructuring one binds each name with a reference of its own.
fn uw_owned_let(pat: Pattern, rhs: Expr, fx: UwFx) : [LocalId] = match pat.pkind {
  PBind(b) -> match rhs.mode {
    MUnboxed -> []
    _        -> if unw_has(fx.banned, b.id) { [] } else { [b.id] }
  }
  _ -> unw_minus(unw_destructured(pat), fx.banned)
}

# An owned match's arm binders hold the reference the bind took for the
# arm body; a guard runs before an emitter's arm-specific binds are
# settled, so they are not pending there.
fn uw_arms(arms: [Arm], owned: Bool, pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite], acc: Option[[LocalId]]) : UwArms = match arms {
  [] -> UwArms { pend: acc, sites: sites }
  [Arm(pat, og, body), ...rest] -> {
    let bs = pat_binders(pat, [])
    let rg = match og {
      None    -> UwR { pend: pend, sites: sites }
      Some(g) -> uw_expr(g, pend, z, fx, sites)
    }
    let seeded = if owned { unw_union(rg.pend, unw_minus(unw_rc_binders(bs), fx.banned)) } else { rg.pend }
    let rb = uw_expr(body, seeded, z, fx, rg.sites)
    let out = unw_minus(rb.pend, map(bs, (b) => b.id))
    let acc2 = match acc { None -> Some(out) Some(p) -> Some(unw_inter(p, out)) }
    uw_arms(rest, owned, pend, z, fx, rb.sites, acc2)
  }
}

type UwArms = { pend: Option[[LocalId]], sites: [UnwSite] }

# A `handle` is a landing pad inside the frame. A binder pending at the
# handle that nothing inside it consumes outlives it: it goes in the
# handle's own entry, below the pad's mark, released only by an exit
# that passes the handle. Inside, a binder is registered only when every
# mention of it lies in the handle's inline code: an exit landing here
# abandons its last use, and nothing after the handle releases it.
fn uw_handle(e: Expr, body: Expr, oi: Option[Expr], oret: Option[HReturn],
             pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = {
  let live = unw_minus(pend, z)
  let survive = unw_minus(unw_filter(live, e), fx.banned)
  let inner = unw_confined(unw_minus(live, survive), e, fx.jumps, fx.body)
  let zh = unw_union(z, survive)
  let ri = match oi {
    None    -> UwR { pend: inner, sites: sites }
    Some(i) -> uw_expr(i, inner, zh, fx, sites)
  }
  let rb = uw_expr(body, ri.pend, zh, fx, ri.sites)
  let rr = match oret {
    None                 -> rb
    Some(HR(_, b, _, _)) -> uw_expr(b, rb.pend, zh, fx, rb.sites)
  }
  UwR { pend: unw_filter(pend, e), sites: unw_add(UnwHandle(e.site, survive), rr.sites) }
}

# A match scope is a site only when an arm holds a call that can unwind:
# the emitter then registers the scrutinee for the arms' extent.
fn uw_scope_site(e: Expr, before: [UnwSite], after: [UnwSite]) : [UnwSite] =
  if uw_brackets(after) == uw_brackets(before) { after }
  else if unw_match_at(after, e.site) { after }
  else { [UnwMatch(e.site), ...after] }

fn uw_brackets(ss: [UnwSite]) : Int = match ss {
  [] -> 0
  [s, ...rest] -> if unw_is_pad(s) { uw_brackets(rest) } else { 1 + uw_brackets(rest) }
}

# A pasted loop body runs in this frame, once per iteration: a binder the
# loop consumes anywhere may already be gone, and one bound inside lives
# for one iteration.
fn uw_loop(e: Expr, xs: [Expr], pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : UwR = {
  let kept = unw_filter(pend, e)
  UwR { pend: kept, sites: uw_loop_parts(xs, kept, z, fx, sites) }
}

fn uw_loop_parts(xs: [Expr], pend: [LocalId], z: [LocalId], fx: UwFx, sites: [UnwSite]) : [UnwSite] = match xs {
  [] -> sites
  [x, ...rest] -> {
    let b = match x.kind { ELambda(_, body) -> body _ -> x }
    uw_loop_parts(rest, pend, z, fx, uw_expr(b, pend, z, fx, sites).sites)
  }
}

#[doc("How a call that can unwind reaches its closure callee: the call consumes the frame's reference, or borrows a dup of it.")]
pub(pkg) type UnwCallee = UnwTransfer(LocalId) | UnwDup(LocalId)

#[doc("The closure a call goes through: a local, or a dup of one, in callee position that `bound` accepts.")]
pub(pkg) fn unw_callee_of(f: Expr, bound: (LocalId) -> Bool) : Option[UnwCallee] = match f.kind {
  ELocal(n) -> if bound(n) { Some(UnwTransfer(n)) } else { None }
  ECall(g, xs) -> match g.kind {
    EMark(MkDup) -> match xs {
      [inner] -> match inner.kind {
        ELocal(n) -> if bound(n) { Some(UnwDup(n)) } else { None }
        _ -> None
      }
      _ -> None
    }
    _ -> None
  }
  _ -> None
}

#[doc("The callee local as an expression positioned like `f`.")]
pub(pkg) fn unw_callee_var(f: Expr, n: LocalId) : Expr =
  Expr { kind: ELocal(n), line: f.line, col: f.col, ty: f.ty, mode: f.mode, site: f.site }

#[doc("`names` with the callee the call consumes in front.")]
pub(pkg) fn unw_callee_held(names: [LocalId], clo: Option[UnwCallee]) : [LocalId] = match clo {
  Some(UnwTransfer(n)) -> [n, ...names]
  _                    -> names
}
