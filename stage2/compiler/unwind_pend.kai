#[doc("""
Owned references a frame holds across a call that can exit non-locally.

A handler clause that discards `resume`, a delivered cancellation and a
fiber trap leave through `longjmp`, skipping every release the frames
between the jump and its landing pad still owed. Each such frame
registers, around a call that can unwind, the binders it owns and has
not yet handed on; the runtime releases what lies above the landing
pad's mark.

The pending set is the goto-tail ledger's (`emit_tcrec_live`) applied to
a different jump: a binder enters when its birth reference exists and
leaves at the first mention that might consume it. The filter only ever
removes entries, so a stale entry under-releases (a bounded leak), never
over-releases. Both emitters read the sites computed here.

Sites are keyed by source position within one frame. Two sites that
share a position keep the intersection of their names.
""")]

import compiler.ast
import compiler.util
import compiler.emit_shared
import compiler.emit_tcrec_live
import compiler.unwind_cx
import compiler.unwind_calls
import compiler.unwind_walk
import compiler.unwind_sites
import compiler.unwind_binders
import compiler.fnreg

#[doc("""
A frame's sites plus the context that computes them, threaded through an
emitter. `arms` are the match-arm binders the sites may name; one is
registered only once the emitter has bound it with its own reference
(`own`), which a reuse arm never does. `scr` asks the next `match` to
register its scrutinee; `mstack` holds the enclosing native matches that
registered theirs. `fib` is the native register holding the frame's
fiber cache, absent until the lowering makes one.
""")]
pub type UnwFrame = { ucx: UnwCx, sites: [UnwSite], arms: [String], own: [String], scr: Bool, mstack: [UnwM], fib: Option[String] }

#[doc("A native match's registered scrutinee: its exit-drop register and the pushing fiber register.")]
pub type UnwM = UnwM(String, String)

#[doc("A frame with no sites, carrying `ucx` for the frames nested in it.")]
pub fn unw_frame_none(ucx: UnwCx) : UnwFrame = UnwFrame { ucx: ucx, sites: [], arms: [], own: [], scr: false, mstack: [], fib: None }

#[doc("A frame with nothing to register under `u`'s context: `u` itself when it is one.")]
pub fn unw_blank(u: UnwFrame) : UnwFrame = if up_blank(u) { u } else { unw_frame_none(u.ucx) }

fn up_blank(u: UnwFrame) : Bool = match u.fib {
  Some(_) -> false
  None    -> not u.scr and list_length(u.sites) == 0 and list_length(u.arms) == 0
             and list_length(u.own) == 0 and list_length(u.mstack) == 0
}

#[doc("""
The frame of fn `enc` declared with `row`, or `None` for one without a
declaration: the typer holds a body to its row, so a fn whose row cannot
unwind and that installs no handler makes no call that can.
""")]
pub fn unw_fn_frame(u: UnwFrame, enc: String, row: Option[RowExpr], seeds: [String], params: [String], body: Expr) : UnwFrame / Console =
  match row {
    Some(r) -> if unw_row_class(r, u.ucx) == 0 and not list_has(u.ucx.handles, enc) { unw_blank(u) }
               else { unw_frame(u, seeds, params, body) }
    None -> unw_frame(u, seeds, params, body)
  }

#[doc("The frame of `body` with owned entry binders `seeds` among its params `params`.")]
pub fn unw_frame(u: UnwFrame, seeds: [String], params: [String], body: Expr) : UnwFrame =
  if not unw_scan(body, u.ucx) { unw_blank(u) }
  else {
    let ucx = u.ucx
    let bound = unw_binders(body, params)
    let banned = unw_dups(bound, [], [])
    UnwFrame { ucx: ucx, sites: unw_walk(ucx, unw_minus(seeds, banned), bound, banned, params, body),
               arms: unw_minus(unw_arm_binders(body, []), banned), own: [], scr: false, mstack: [], fib: None }
  }

#[doc("The names among `names` the emitter may register: a match-arm binder only once its arm owns it.")]
pub fn unw_admit(u: UnwFrame, names: [String]) : [String] = match names {
  [] -> []
  [n, ...rest] ->
    if list_has(u.arms, n) and not list_has(u.own, n) { unw_admit(u, rest) }
    else { [n, ...unw_admit(u, rest)] }
}

#[doc("`u` with the arm binders `names` owned by the arm being emitted.")]
pub fn unw_owning(u: UnwFrame, names: [String]) : UnwFrame =
  if u.arms == [] { u } else { UnwFrame { ucx: u.ucx, sites: u.sites, arms: u.arms, own: list_append(names, u.own), scr: u.scr, mstack: u.mstack, fib: u.fib } }

#[doc("`u` with its fiber held in native register `f`.")]
pub fn unw_with_fib(u: UnwFrame, f: String) : UnwFrame =
  UnwFrame { ucx: u.ucx, sites: u.sites, arms: u.arms, own: u.own, scr: u.scr, mstack: u.mstack, fib: Some(f) }

#[doc("The native register holding `u`'s fiber cache.")]
pub fn unw_fib(u: UnwFrame) : String = match u.fib {
  Some(f) -> f
  None    -> ""
}

#[doc("`u` asking (or not) the next `match` to register its scrutinee.")]
pub fn unw_with_scr(u: UnwFrame, b: Bool) : UnwFrame =
  UnwFrame { ucx: u.ucx, sites: u.sites, arms: u.arms, own: u.own, scr: b, mstack: u.mstack, fib: u.fib }

#[doc("`u` recording that the match dropping `sd` registered its scrutinee under fiber register `f`.")]
pub fn unw_mpush(u: UnwFrame, sd: String, f: String) : UnwFrame =
  UnwFrame { ucx: u.ucx, sites: u.sites, arms: u.arms, own: u.own, scr: u.scr, mstack: [UnwM(sd, f), ...u.mstack], fib: u.fib }

#[doc("`u` without the record of the match dropping `sd`; unchanged when that match registered nothing.")]
pub fn unw_mpop(u: UnwFrame, sd: String) : UnwFrame = match u.mstack {
  [UnwM(d, _), ...rest] ->
    if d == sd { UnwFrame { ucx: u.ucx, sites: u.sites, arms: u.arms, own: u.own, scr: u.scr, mstack: rest, fib: u.fib } } else { u }
  _ -> u
}

#[doc("The fiber register the match dropping `sd` pushed its scrutinee under; empty when it pushed nothing.")]
pub fn unw_mreg(u: UnwFrame, sd: String) : String = match u.mstack {
  [UnwM(d, f), ..._] -> if d == sd { f } else { "" }
  _ -> ""
}

#[doc("The params a fn owns on entry: not borrowed, not raw under its unboxed signature, not a capability.")]
pub fn unw_param_seeds(params: [Param], sig: Option[UFnSig], ucx: UnwCx) : [String] = match sig {
  Some(US(_, _, mask)) -> uw_seeds_masked(params, mask, ucx)
  None                 -> uw_seeds_masked(params, [], ucx)
}

fn uw_seeds_masked(params: [Param], mask: [Bool], ucx: UnwCx) : [String] = match params {
  [] -> []
  [p, ...rest] -> {
    let raw = match mask {
      [m, ..._] -> m
      []        -> false
    }
    let mrest = match mask {
      [_, ...r] -> r
      []        -> []
    }
    let tail = uw_seeds_masked(rest, mrest, ucx)
    if raw or p.pborrow or unw_is_cap_param(ucx, p.ptype) { tail } else { [p.pname, ...tail] }
  }
}

#[doc("The params a handler clause owns: every op argument; the continuation is always last.")]
pub fn unw_clause_seeds(c: ClauseInfo) : [String] = match c {
  CI(_, _, _, _, cps, _, _, _, _, _, _) -> uw_all_but_last(cps)
}

fn uw_all_but_last(ps: [Param]) : [String] = match ps {
  []           -> []
  [_]          -> []
  [p, ...rest] -> [p.pname, ...uw_all_but_last(rest)]
}

#[doc("The binders registered at the call `x` (an `ECall`), if it is a site.")]
pub fn unw_call_names(sites: [UnwSite], x: Expr) : Option[[String]] = match sites {
  [] -> None
  _  -> match x.kind {
    ECall(f, _) -> unw_call_at(sites, x.line, x.col, unw_callee_key(f))
    _ -> None
  }
}

#[doc("The binders pending at the `handle` at `(line, col)` that outlive it, if it is a site.")]
pub fn unw_handle_names(sites: [UnwSite], line: Int, col: Int) : Option[[String]] = match sites {
  [] -> None
  [s, ...rest] -> match s {
    UnwHandle(l, c, ns) -> if l == line and c == col { Some(ns) } else { unw_handle_names(rest, line, col) }
    _ -> unw_handle_names(rest, line, col)
  }
}
