# compiler/protos.kai — m12.8 single-dispatch protocols.
#
# Named `protos`, not `protocols`: the module binding is the last
# dotted segment, and `protocols` is already reserved by the implicit
# stdlib core (`stdlib/protocols.kai`, the user-facing Show / Eq /
# Ord / Hash impls). Importing `compiler.protocols` resolves to that
# already-registered stdlib module instead of this file, hiding the AST
# variant namespace and producing ~330 "unknown variant" errors. The
# flat bundle masks the clash (one global namespace); the modular kaic2
# build exposes it — the N1/N3 "modular build exposes what the bundle
# hides" lesson, here landing on the module name itself.
#
# Extracted from main.kai under issue #677 Phase 1p, promoted ahead of
# the N2 monomorph lane: the abandoned monomorph-extract lane discovered
# ~537 LOC / 31 fns of protocol-resolve coupling (`monomorphise` calls
# `resolve_protocol_calls_decl`) that the original section analysis #692
# missed. Mirroring that surface meant duplicating the whole protocol
# module; pre-sinking only the `resolve_*` fns would have split one
# cohesive domain. The integrator decision: extract the protocol system
# whole first, then re-run N2 importing it downward.
#
# What this module owns — the complete m12.8 single-dispatch protocol
# system, three contiguous sub-sections that share the same domain:
#
#   A. Definition + lowering (pre-resolve desugar). Expands
#      `#[derive(P)]` into synthetic `impl P for T`, validates the
#      orphan + single-impl-per-pair rules, lowers each `impl` method
#      into one ordinary `__pimpl_<P>_<TypeMangled>_<op>` DFn, emits a
#      stub *dispatcher* DFn per protocol op (so the typer resolves
#      `op(x, ...)` polymorphically), and drops the DProtocol / DImpl /
#      DDerive nodes from the decl stream. Entry: `lower_protocols`.
#
#   B. Post-inference protocol-call rewrite. After inference has
#      attached types, `resolve_protocol_calls` (+ `_decl`) replaces
#      every `op(x, ...)` with a direct call to the matching impl fn;
#      calls no impl matches survive and surface the dispatcher's
#      runtime panic (the v1 fall-back). `validate_resolved_protocols`
#      catches the static unresolved cases at compile time.
#
#   C. Post-Core REOPEN — Eric level 2 rep-invariant verifiers
#      (`validate_typer_invariants`): structural checks over the typed
#      program guarding the AST representation invariants the typer is
#      expected to maintain.
#
# Coherence is purely compile-time: orphan + duplicate-impl checks run
# in (A), and dispatch is `O(1)` (linear scan over a flat impl list
# small enough to be `O(1)` in practice).
#
# The protocol-registry types (ProtoOpReg, ProtoTPReg, ProtoImplReg,
# ProtoOriginReg, ProtocolReg) were sunk into compiler/ast.kai in issue
# #677 phase 1n0 — they cross into the infer public surface and are
# produced by this block, so ast.kai is their shared downward home.
# This module only *uses* them.
#
# Public surface:
#   - `lower_protocols` — pass (A) entry, called from the driver.
#   - `proto_rungs` — the protocol operations as the resolver's last
#     rung; which call reaches a dispatcher is the resolver's decision.
#   - `proto_dispatcher_name` — the `__proto_<op>` name builder, called
#     by the interp-desugar pass (still in main) to stringify `#{...}`.
#   - `resolve_protocol_calls` / `resolve_protocol_calls_decl` — pass
#     (B) entry; `_decl` is the per-decl hook the N2 monomorph lane will
#     import (the coupling that re-sequenced this lane).
#   - `validate_resolved_protocols` / `validate_resolved_decls` — the
#     post-rewrite static-coherence check (full program + per-decl).
#   - `validate_typer_invariants` — pass (C) entry, called from the
#     driver after inference.
#   - `string_to_lower_ascii` — ASCII lowercaser; the LLVM/C emitter
#     (still in main) lowercases effect names with it.
#
# Bundle order: ... infer, fnreg, unbox, perceus, **protos**, main.
# Imports compiler.ast for the AST nodes + Proto*Reg types + `mk_expr` /
# `mk_pat` / `mk_ty`, compiler.diag for `diag_error`, compiler.util for
# `concat_all` / `list_has`, compiler.modules for `fn_param_names` /
# `decl_home_hint_reset`, compiler.infer for `TypedProgram` /
# `arg_names_match`. The AST-functor family (`proto_map_expr_kind`),
# `proto_join_with`, and the dispatcher-marker builder
# (`proto_mk_dispatch_body`) are mirrored downward glue with the
# `proto_*` prefix, copied verbatim from the canonical definitions still
# resident in main / infer (single consumer each here ⇒ mirror, not sink,
# per the phase-1m `dsg_` discipline).

import compiler.ast
import compiler.operators
import compiler.core_refs
import compiler.core_protos
import compiler.type_text
import compiler.diag_file
import compiler.home_dup
import compiler.kinds
import compiler.diag
import compiler.util
import compiler.fnreg
import compiler.impl_index
import compiler.impl_identity
import compiler.scope_view
import compiler.modules
import compiler.proto_key
import compiler.proto_resolve
import compiler.proto_orphan
import compiler.home_spell
import compiler.decl_names
import compiler.name_report
import compiler.proto_rank
import compiler.infer
import compiler.layout_derive
import compiler.layout_validate
import compiler.json_shape
import compiler.json_derive
import compiler.derive_generic
import compiler.derive_reach
import compiler.resolve_callee
import compiler.symtab_build
import compiler.mutation_carriers
import compiler.core_effects

# ====================================================================
# Law wrappers (`laws <Theory>` / `axiom <Theory>`).
#
# The parser emits `DProtoLaws(theory, DProtocol, …)` and
# `DImplAxiom(theory, DImpl, …)` wrappers. `strip_law_wrappers` unwraps
# them to the bare protocol/impl and records the associations, so no
# downstream pass ever sees the wrapper — the same discipline
# `lower_axioms` uses for `DAxiom`. The law engine reads the registry to
# autogenerate per-impl property checks (except impls marked `axiom`).
# ====================================================================

# `protocol_name -> theory` and the impls exempted by `axiom <Theory>`.
# Both are keyed by the declaring module: an exemption written in one
# module must not exempt an unrelated impl in another, and law-checking
# is verification, so a bare key is a silent bypass of it.
pub type LawReg = LR([ProtoLaw], [AxiomImpl])
pub type ProtoLaw = PL(Option[String], String, String)          # home, protocol, theory
pub type AxiomImpl = AI(Option[String], String, String, String) # home, protocol, type-head, theory

pub fn law_reg_protocols(r: LawReg) : [ProtoLaw] = match r { LR(ps, _) -> ps }
pub fn law_reg_axioms(r: LawReg) : [AxiomImpl] = match r { LR(_, xs) -> xs }

#[doc("The theory a protocol declared by `home` declares its ops obey via `laws`, if any.")]
pub fn law_theory_of(r: LawReg, home: Option[String], proto: String) : Option[String] =
  law_theory_loop(law_reg_protocols(r), home, proto)

fn law_theory_loop(ps: [ProtoLaw], home: Option[String], proto: String) : Option[String] = match ps {
  [] -> None
  [PL(h, p, thy), ...rest] ->
    if p == proto and home_eq(h, home) { Some(thy) }
    else { law_theory_loop(rest, home, proto) }
}

#[doc("True when `impl P for <head>` declared by `home` is exempted from law-checks by an `axiom` clause.")]
pub fn law_impl_axiomed(r: LawReg, home: Option[String], proto: String, head: String) : Bool =
  law_axiom_loop(law_reg_axioms(r), home, proto, head)

fn law_axiom_loop(xs: [AxiomImpl], home: Option[String], proto: String, head: String) : Bool = match xs {
  [] -> false
  [AI(h, p, t, _), ...rest] ->
    if p == proto and t == head and home_eq(h, home) { true }
    else { law_axiom_loop(rest, home, proto, head) }
}

#[doc("""
Unwrap every `DProtoLaws` / `DImplAxiom` wrapper to its bare inner decl,
returning the flattened decl stream and the law registry. Runs before
any other Decl walker so downstream passes see only plain
protocols/impls, mirroring `lower_axioms`.
""")]
pub fn strip_law_wrappers(decls: [Decl]) : StrippedLaws =
  strip_law_loop(decls, [], [], [])

pub type StrippedLaws = SL([Decl], LawReg)

pub fn strip_sl_decls(s: StrippedLaws) : [Decl] = match s { SL(ds, _) -> ds }
pub fn strip_sl_reg(s: StrippedLaws) : LawReg = match s { SL(_, r) -> r }

fn strip_law_loop(decls: [Decl], acc: [Decl], laws: [ProtoLaw],
                  axioms: [AxiomImpl]) : StrippedLaws = match decls {
  [] -> SL(list_reverse(acc), LR(list_reverse(laws), list_reverse(axioms)))
  [d, ...rest] -> match d {
    DProtoLaws(thy, DProtocol(a, name, b, c, l, cc, mo, _), _, _, _) ->
      strip_law_loop(rest, [DProtocol(a, name, b, c, l, cc, mo, sym_none()), ...acc],
                     [PL(mo, name, thy), ...laws], axioms)
    DImplAxiom(thy, DImpl(pname, pa, target, ms, l, cc, tps, _), _, _, amo) ->
      strip_law_loop(rest, [DImpl(pname, pa, target, ms, l, cc, tps, sym_none()), ...acc],
                     laws, [AI(amo, dotted_bare(pname), proto_type_name(target), thy), ...axioms])
    _ -> strip_law_loop(rest, [d, ...acc], laws, axioms)
  }
}

# ====================================================================
# Downward glue mirrors (proto_ prefix) — copied verbatim from the
# canonical definitions still resident in main / infer. Mirrored rather
# than sunk because each has a single consumer in this module.
# ====================================================================

fn proto_join_with(xs: [String], sep: String) : String = string_join(xs, sep)

# Mirror of `mk_proto_dispatch_body` (main) — builds the ETodo
# dispatcher marker. The `"__kai_proto_dispatch__:"` prefix MUST stay
# byte-identical: the desugar + emitter sides read it back.
fn proto_mk_dispatch_body(pname: String, opname: String, line: Int, col: Int) : Expr =
  mk_expr(ETodo(concat_all(["__kai_proto_dispatch__:", pname, ":", opname])), line, col)

# AST-functor family mirror (`proto_map_*`) — copied verbatim from the
# `inf_map_*` family in compiler/infer.kai.
fn proto_map_arm_exprs(a: Arm, f: (Expr) -> Expr) : Arm {
  match a {
    Arm(p, g, b) -> Arm(p, proto_map_opt_expr(g, f), f(b))
  }
}

fn proto_map_clause_exprs(c: HClause, f: (Expr) -> Expr) : HClause {
  match c {
    HC(n, ps, b, l, co) -> HC(n, ps, f(b), l, co)
  }
}

fn proto_map_elem_exprs(el: ListElem, f: (Expr) -> Expr) : ListElem {
  match el {
    ElPlain(x)  -> ElPlain(f(x))
    ElSpread(x) -> ElSpread(f(x))
  }
}

fn proto_map_field_exprs(fi: FieldInit, f: (Expr) -> Expr) : FieldInit {
  match fi {
    FI(n, v) -> FI(n, f(v))
  }
}

fn proto_map_opt_expr(opt: Option[Expr], f: (Expr) -> Expr) : Option[Expr] {
  match opt {
    Some(e) -> Some(f(e))
    None    -> None
  }
}

fn proto_map_opt_return_exprs(opt: Option[HReturn], f: (Expr) -> Expr) : Option[HReturn] {
  match opt {
    Some(r) -> Some(proto_map_return_exprs(r, f))
    None    -> None
  }
}

fn proto_map_return_exprs(r: HReturn, f: (Expr) -> Expr) : HReturn {
  match r {
    HR(p, b, l, c) -> HR(p, f(b), l, c)
  }
}

fn proto_map_stmt_exprs(s: Stmt, f: (Expr) -> Expr) : Stmt {
  match s {
    SLet(p, ann, rhs)           -> SLet(p, ann, f(rhs))
    SAssert(c, m)               -> SAssert(f(c), proto_map_opt_expr(m, f))
    SExprStmt(x)                -> SExprStmt(f(x))
    SIndexAssign(b, i, v, l, c) -> SIndexAssign(f(b), f(i), f(v), l, c)
    SAssign(b, v, l, c) -> SAssign(f(b), f(v), l, c)
    SVar(n, ty, rhs, l, c)      -> SVar(n, ty, f(rhs), l, c)
    SUse(n, l, c)               -> SUse(n, l, c)
  }
}

fn proto_map_expr_kind(k: ExprKind, f: (Expr) -> Expr) : ExprKind {
  match k {
    EInt(_, _)        -> k
    EReal(_, _)       -> k
    EIntLit(_)        -> k
    EDecimalLit(_)    -> k
    EFixed(_, _)      -> k
    EBool(_)       -> k
    EChar(_)       -> k
    EStr(_, _)     -> k
    EUnit          -> k
    EVar(_)        -> k
    EMark(_)        -> k
    ESym(_, _, _)        -> k
    EUnder         -> k
    EPlaceholder   -> k
    EHole(_)       -> k
    ETodo(_)       -> k
    EExternBody(_, _) -> k
    EVariantsOf(_, _) -> k
    EModCall(_, _) -> k
    EIntrinsic(name, args_) -> EIntrinsic(name, map(args_, f))
    ESurface(sf) -> ESurface(surface_map(sf, f))
    ECall(callee, args_) -> ECall(f(callee), map(args_, f))
    EField(base, name)   -> EField(f(base), name)
    EIndex(a, b)         -> EIndex(f(a), f(b))
    EBinop(op, a, b)     -> EBinop(op, f(a), f(b))
    EUnop(op, x)         -> EUnop(op, f(x))
    EIf(c, t_, eo)       -> EIf(f(c), f(t_), proto_map_opt_expr(eo, f))
    EMatch(scr, arms)    -> EMatch(f(scr), map(arms, (a) => proto_map_arm_exprs(a, f)))
    ELambda(ps, b)       -> ELambda(ps, f(b))
    ERecordLit(rh, name, fs) -> ERecordLit(rh, name, map(fs, (fi) => proto_map_field_exprs(fi, f)))
    EList(els)           -> EList(map(els, (el) => proto_map_elem_exprs(el, f)))
    ERange(a, b, opt_step) -> ERange(f(a), f(b), proto_map_opt_expr(opt_step, f))
    EBlock(stmts, tail)  -> EBlock(map(stmts, (s) => proto_map_stmt_exprs(s, f)),
                                    proto_map_opt_expr(tail, f))
    EPipe(a, b)          -> EPipe(f(a), f(b))
    EMapPipe(a, b)       -> EMapPipe(f(a), f(b))
    EFlatMapPipe(a, b)   -> EFlatMapPipe(f(a), f(b))
    EFilterPipe(a, b)    -> EFilterPipe(f(a), f(b))
    EHandle(body, eff_name, hsym, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) ->
      EHandle(f(body), eff_name, hsym, eff_tyargs,
              proto_map_opt_expr(init_opt, f), alias_opt,
              map(clauses, (c) => proto_map_clause_exprs(c, f)),
              proto_map_opt_return_exprs(ret_opt, f))
    ELitUnit(inner, u)   -> ELitUnit(f(inner), u)
    EBang(inner)         -> EBang(f(inner))
  }
}

# ====================================================================
# m12.8 — single-dispatch protocols (body)
# ====================================================================

fn proto_reg_empty() : ProtocolReg =
  ProtocolReg { ops: [], impls: [], op_names: [], tparams: [], origins: [],
                dkeys: [], impl_index: impl_index_empty(), cores: [], imports: [], root: "" }

# m12.8: the type-mangling used in the impl-fn name. Walks a
# TypeExpr, collapsing it down to the head TyName (so `Money[u]`,
# `Money[USD]`, and `Money` all map to `Money`). Lists collapse to
# `List`. This gives a single impl per type-constructor — polymorphic
# impls cover all instantiations, mirroring the spec's "monomorphises
# per concrete instantiation just like any generic function" note.
#[doc("The single-dispatch head name of a `TypeExpr` (`Money[USD]` → `Money`, `[T]` → `List`).")]
pub fn proto_type_name(te: TypeExpr) : String {
  match te.tkind {
    TyName(_, name, _) -> name
    TyList(_)       -> "List"
    TyFn(_, _, _)   -> "Fn"
    # m12.5: `Decimal<USD>` and friends collapse to the base
    # constructor (`Decimal`); the unit annotation is invisible to
    # protocol dispatch (which is single-dispatch on the head TyName,
    # exactly as the spec describes for `impl Show for Money[u: Measure]`).
    TyDim(base, _)  -> proto_type_name(base)
    # m12.6.a: refinements collapse to the underlying base for protocol
    # dispatch — `Int where >= 0` and `Int` resolve to the same `impl`.
    TyRefine(base, _) -> proto_type_name(base)
    # issue #772: a compound row is never a protocol-dispatch head; it
    # only appears as a type argument. Return a name no `impl` matches.
    TyRow(_) -> "Row"
    TySurface(_) -> panic("proto_type_name: surface type not lowered")
  }
}

fn proto_mangled_fn(proto: String, type_name: String, op: String) : String =
  concat_all(["__pimpl_", proto, "_", type_name, "_", op])

# Issue #180: heterogeneous-aware mangling. The legacy un-parametrised
# form `impl Show for Int` (arg_names == []) keeps the original
# `__pimpl_<P>_<T>_<op>` symbol. The homogeneous parametrised form
# `impl Add[Complex] for Complex` (arg_names == [type_name]) also keeps
# it (so it stays interchangeable with the un-parametrised form). Only
# heterogeneous impls (e.g. `impl Add[Real] for Complex`) get a
# `__a_<arg_name>...` suffix that disambiguates the dispatch table.
fn proto_impl_mangled_with_args(proto: String, type_name: String,
                                  op: String, arg_names: [String]) : String {
  let needs_suffix = match arg_names {
    [] -> false
    [a] -> a != type_name
    _  -> true
  }
  if needs_suffix {
    concat_all(["__pimpl_", proto, "_", type_name, "_", op,
                "__a_", arg_names_mangle(arg_names)])
  } else {
    proto_mangled_fn(proto, type_name, op)
  }
}

fn arg_names_mangle(args: [String]) : String = match args {
  [] -> ""
  [a] -> a
  [a, ...rest] -> concat_all([a, "_", arg_names_mangle(rest)])
}

# m12.8: kaikai-side name for the *dispatcher* function the lower
# pass synthesises for each protocol op. Prefixing with `__proto_`
# keeps the emitted C symbol (`kai___proto_<op>`) clear of runtime
# helpers like `kai_op_eq`, `kai_to_string`, `kai_op_lt` etc. that share
# common short names with protocol ops.
#[doc("kaikai name of the polymorphic dispatcher DFn for protocol op `op` (`__proto_<op>`).")]
pub fn proto_dispatcher_name(op: String) : String = concat_all(["__proto_", op])

#[doc("True when `name` is a synthesised protocol dispatcher (`__proto_<op>`).")]
pub fn is_proto_dispatcher_name(name: String) : Bool =
  strip_proto_dispatcher_prefix(name) != name

# A decl's home canonicalised the way the registry stores it: the
# root file's module name becomes `None`, matching the rest of the
# root file's untagged decls.
fn proto_mo_of(home: String, target_mod: String) : Option[String] =
  if home == target_mod { None } else { Some(home) }

# Register every DProtocol decl the program declares. The op list
# becomes the universe of "names that look like ordinary fn calls but
# really need protocol dispatch". Each entry carries its declaring
# module's `module_origin` stamp so two same-named protocols never
# share one identity.
fn collect_proto_decls(ds: [Decl], reg: ProtocolReg, ps: PScope) : ProtocolReg {
  match ds {
    [] -> reg
    [d, ...rest] -> match d {
      DProtocol(is_pub, name, tparams, ops, _, _, mo, _) -> {
        let psym = ps_decl_sym(ps, name, mo)
        let reg1 = ProtocolReg {
          ops: reg.ops, impls: reg.impls, op_names: reg.op_names,
          tparams: [PTPR(name, tparams, mo, psym), ...reg.tparams],
          origins: [PrOR(name, mo, is_pub, psym), ...reg.origins],
          dkeys: reg.dkeys,
          impl_index: reg.impl_index,
          cores: reg.cores, imports: reg.imports, root: reg.root
        }
        collect_proto_decls(rest, register_proto_ops(reg1, name, mo, psym, ops), ps)
      }
      DDerive(_, inner, _, _) ->
        collect_proto_decls([inner, ...rest], reg, ps)
      DUnstable(inner, _, _) ->
        collect_proto_decls([inner, ...rest], reg, ps)
      DProtoLaws(_, inner, _, _, _) ->
        collect_proto_decls([inner, ...rest], reg, ps)
      DImplAxiom(_, inner, _, _, _) ->
        collect_proto_decls([inner, ...rest], reg, ps)
      DConstructor(inner, _, _) ->
        collect_proto_decls([inner, ...rest], reg, ps)
      _ -> collect_proto_decls(rest, reg, ps)
    }
  }
}

# `psym` is the protocol's own identity, read from the table the scope
# resolves against: an impl's written protocol name resolves to the same id.
fn register_proto_ops(reg: ProtocolReg, proto: String, mo: Option[String],
                      psym: SymId, ops: [ProtoOp]) : ProtocolReg {
  match ops {
    [] -> reg
    [op, ...rest] -> match op {
      POp(opname, _, params, ret, line, col) -> {
        let entry = POR(proto, opname, params, ret, line, col, mo, psym)
        let names1 =
          if list_has(reg.op_names, opname) { reg.op_names }
          else { [opname, ...reg.op_names] }
        let reg1 = ProtocolReg {
          ops: [entry, ...reg.ops],
          impls: reg.impls,
          op_names: names1,
          tparams: reg.tparams,
          origins: reg.origins,
          dkeys: reg.dkeys,
          impl_index: reg.impl_index,
          cores: reg.cores, imports: reg.imports, root: reg.root
        }
        register_proto_ops(reg1, proto, mo, psym, rest)
      }
    }
  }
}

fn proto_op_lookup(reg: ProtocolReg, name: String) : Option[ProtoOpReg] {
  proto_op_lookup_loop(reg.ops, name)
}

fn proto_op_lookup_loop(ops: [ProtoOpReg], target: String) : Option[ProtoOpReg] {
  match ops {
    [] -> None
    [op, ...rest] -> match op {
      POR(_, name, _, _, _, _, _, _) ->
        if name == target { Some(op) } else { proto_op_lookup_loop(rest, target) }
    }
  }
}

# Issue #546: two protocols may declare an op with the same name
# (`protocol Speak { sound(x: Self) }` + `protocol Move { sound(x: Self) }`).
# kaikai resolves protocol ops by bare name, so the call site `sound(x)`
# carries no protocol — only the receiver's type disambiguates. The
# single-result `proto_op_lookup` above fixes the protocol to whichever
# was declared first, which makes the static rewrite search impls in the
# wrong protocol and leave a misdispatched residual. `proto_ops_lookup_all`
# returns EVERY POR matching the name (registry order) so the rewrite can
# try each candidate protocol and pick the one with an impl for the
# receiver type.
fn proto_ops_lookup_all(reg: ProtocolReg, name: String) : [ProtoOpReg] =
  proto_ops_lookup_all_loop(reg.ops, name)

#[doc("The core module declaring a protocol with op `opname`, or `None`. The interpolation sugar binds `#{...}` to that `Show`, never to a user protocol that happens to declare `show`.")]
pub fn proto_core_op_home(reg: ProtocolReg, opname: String,
                          cores: [String]) : Option[String] =
  pcoh_loop(proto_ops_lookup_all(reg, opname), cores)

fn pcoh_loop(ops: [ProtoOpReg], cores: [String]) : Option[String] = match ops {
  [] -> None
  [POR(_, _, _, _, _, _, mo, _), ...rest] -> match mo {
    Some(m) -> if list_has(cores, m) { mo } else { pcoh_loop(rest, cores) }
    None    -> pcoh_loop(rest, cores)
  }
}

fn proto_ops_lookup_all_loop(ops: [ProtoOpReg], target: String) : [ProtoOpReg] {
  match ops {
    [] -> []
    [op, ...rest] -> match op {
      POR(_, name, _, _, _, _, _, _) ->
        if name == target { [op, ...proto_ops_lookup_all_loop(rest, target)] }
        else { proto_ops_lookup_all_loop(rest, target) }
    }
  }
}

# Validate: the orphan rule, single-impl-per-(P,T) coherence, and that
# the impl's protocol name resolves to a protocol its module can see.
fn validate_impls(ds: [Decl], homes: [HomeAnchor], df: DiagFiles,
                  reg: ProtocolReg, target_mod: String,
                  ps: PScope) : [Diagnostic] =
  list_reverse(validate_impls_loop(ds, homes, df, reg, target_mod, ps,
                                   OrphanScope(ps, nt_type_spellings(ds, target_mod)), [], []))

fn validate_impls_loop(ds: [Decl], homes: [HomeAnchor], df: DiagFiles,
                       reg: ProtocolReg, target_mod: String,
                       ps: PScope, os: OrphanScope, seen: [String],
                       acc: [Diagnostic]) : [Diagnostic] {
  match ds {
    [] -> acc
    [d, ...rest] -> match homes {
      [] -> acc
      [h, ...hrest] -> match d {
      DImpl(pspell, proto_args, target, _, line, col, _, isym) -> {
        let file = decl_diag_file(d, df)
        let tname = proto_type_name(target)
        let pname = dotted_bare(pspell)
        let from = proto_mo_of(ha_home(h), target_mod)
        let res = ps_resolve(ps, pspell, from)
        # Issue #180: duplicate-impl key includes the proto-arg names so
        # `impl Add[Real] for Complex` and `impl Add[Complex] for Complex`
        # coexist. Legacy `impl P for T` (proto_args == []) maps to the
        # homogeneous default `[T]` for keying. The resolved protocol's
        # home leads the key: two modules implementing their own `P`
        # for same-named types are not duplicates.
        let arg_names = match proto_args {
          [] -> [tname]
          _  -> map(proto_args, proto_type_name)
        }
        let mo_key = match res {
          PkHome(Some(m)) -> m
          _ -> ""
        }
        let key = concat_all([mo_key, "!", pname, "/", impl_target_key(ps, tname, from), "[",
                              arg_names_mangle(arg_names), "]"])
        let proto_home = match res {
          PkHome(ph) -> Some(proto_home_name(ph, target_mod))
          _ -> None
        }
        let orphan = OrphanImpl { pspell: pspell, proto_home: proto_home, args: proto_args,
                                  target: target, from: from,
                                  impl_mod: proto_home_name(from, target_mod) }
        let acc1 = match orphan_error(os, orphan) {
          Some(msg) -> [proto_err(file, line, col, msg), ...acc]
          None -> acc
        }
        let acc2 =
          if list_has(seen, key) {
            [proto_err(file, line, col, concat_all(["duplicate impl: `impl ", pname, " for ", tname,
                             "` already exists in this compilation unit"])), ...acc1]
          } else { acc1 }
        let acc3 = match res {
          PkHome(_) -> acc2
          PkPrivate(m) ->
            [proto_err(file, line, col, concat_all(["protocol `", pname, "` is declared in module `", m,
                             "` but is not `pub`"])), ...acc2]
          PkUnknown -> [proto_err(file, line, col, concat_all(["unknown protocol `", pname, "` in `impl`"])), ...acc2]
          PkAmbiguous(cands) ->
            [nr_ambiguous_diag(file, line, col, NCProtocol, pname,
                               map(cands, (c) => proto_home_name(c, target_mod)), "", []), ...acc2]
        }
        let seen1 = if list_has(seen, key) { seen } else { [key, ...seen] }
        validate_impls_loop(rest, hrest, df, reg, target_mod, ps, os, seen1, acc3)
      }
      DDerive(_, inner, _, _) ->
        validate_impls_loop([inner, ...rest], homes, df, reg, target_mod, ps, os, seen, acc)
      DUnstable(inner, _, _) ->
        validate_impls_loop([inner, ...rest], homes, df, reg, target_mod, ps, os, seen, acc)
      DProtoLaws(_, inner, _, _, _) ->
        validate_impls_loop([inner, ...rest], homes, df, reg, target_mod, ps, os, seen, acc)
      DImplAxiom(_, inner, _, _, _) ->
        validate_impls_loop([inner, ...rest], homes, df, reg, target_mod, ps, os, seen, acc)
      DConstructor(inner, _, _) ->
        validate_impls_loop([inner, ...rest], homes, df, reg, target_mod, ps, os, seen, acc)
      _ -> validate_impls_loop(rest, hrest, df, reg, target_mod, ps, os, seen, acc)
      }
    }
  }
}

fn proto_err(file: String, line: Int, col: Int, msg: String) : Diagnostic =
  mk_diag(SevError, file, line, col, msg, [])

# A registry home as a diagnostic names it: the root file by its module name.
fn proto_home_name(mo: Option[String], target_mod: String) : String = match mo {
  Some(m) -> m
  None    -> target_mod
}

# Issue #535 — impl method validation against protocol declaration.
#
# Three failure shapes the dispatch resolver previously accepted silently:
#   1. missing required method — `impl P for T { fn foo(...) }` when `P`
#      also declares `bar`. Calls to `bar(t)` get the dispatcher stub and
#      panic at runtime.
#   2. signature mismatch — `impl P for T` whose `foo` returns or accepts
#      a type the protocol does not declare. Calls would type-check on
#      the wrong shape and corrupt downstream inference.
#   3. arity mismatch — `impl P for T`'s `foo` has fewer params than
#      `protocol P` declares. Extra arguments at the call site silently
#      drop.
#
# Implementation strategy:
#   - Required-method check: per protocol, collect every op name; per
#     impl, verify each is provided. Reports one error per missing op.
#   - Arity check: param-count comparison. The protocol's first param
#     position is `Self` by convention; the impl provides the concrete
#     type. Counts must match.
#   - Signature check (conservative, v1): compare param types and return
#     type by *head-name* via `proto_type_name` after Self substitution.
#     This collapses `Real<u>` and `Real` to the same head, `[T]` and
#     `[Int]` to `List`, etc. — matching what the dispatch mangling does
#     today. Deep structural / refinement comparison is deferred to a
#     follow-up that wires the typer's unifier into pre-typer
#     validation. Head-name comparison is enough to flag the bug-class
#     fixtures (`String` vs `Int`, etc.) without breaking polymorphic
#     stdlib impls whose tparams are not visible here.
#
# Unknown protocol names are silently skipped — `validate_impls_loop`
# above already reports those.

fn validate_impl_methods(ds: [Decl], homes: [HomeAnchor], df: DiagFiles,
                         reg: ProtocolReg, target_mod: String,
                         ps: PScope) : [Diagnostic] =
  list_reverse(validate_impl_methods_loop(ds, homes, df, reg, target_mod, ps, []))

fn validate_impl_methods_loop(ds: [Decl], homes: [HomeAnchor], df: DiagFiles,
                              reg: ProtocolReg, target_mod: String,
                              ps: PScope, acc: [Diagnostic]) : [Diagnostic] {
  match ds {
    [] -> acc
    [d, ...rest] -> match homes {
      [] -> acc
      [h, ...hrest] -> match d {
      DImpl(pspell, proto_args, target, methods, line, col, _, isym) -> {
        let file = decl_diag_file(d, df)
        let tname = proto_type_name(target)
        let pname = dotted_bare(pspell)
        # The impl checks against the protocol its own module resolves
        # `pname` to — never a same-named protocol of an unrelated
        # module. Unresolved names were already reported by
        # `validate_impls`; skip them here.
        let from = proto_mo_of(ha_home(h), target_mod)
        let psym = ps_proto_sym(ps, pspell, from)
        let proto_ops = proto_scope_ops(reg.ops, psym)
        if proto_ops == [] {
          validate_impl_methods_loop(rest, hrest, df, reg, target_mod, ps, acc)
        } else {
          # Protocol tparams substitute against the impl's bracket
          # arguments. Legacy `impl P for T` (`proto_args == []`) is
          # treated as the homogeneous default: every protocol tparam
          # collapses to the target head. Heterogeneous
          # `impl P[Real, Int] for T` aligns positionally.
          let proto_tps = proto_scope_tparams(reg.tparams, psym)
          let arg_heads = match proto_args {
            [] -> []
            _  -> map(proto_args, proto_type_name)
          }
          let all_op_names = proto_op_names(proto_ops, [])
          let e1 = check_missing_methods(proto_ops, methods, pname, tname,
                                         all_op_names,
                                         file, line, col, acc)
          let e2 = check_impl_methods(methods, proto_ops, pname, tname, target,
                                       proto_tps, arg_heads, file, e1)
          validate_impl_methods_loop(rest, hrest, df, reg, target_mod, ps, e2)
        }
      }
      DDerive(_, inner, _, _) ->
        validate_impl_methods_loop([inner, ...rest], homes, df, reg, target_mod, ps, acc)
      DUnstable(inner, _, _) ->
        validate_impl_methods_loop([inner, ...rest], homes, df, reg, target_mod, ps, acc)
      DProtoLaws(_, inner, _, _, _) ->
        validate_impl_methods_loop([inner, ...rest], homes, df, reg, target_mod, ps, acc)
      DImplAxiom(_, inner, _, _, _) ->
        validate_impl_methods_loop([inner, ...rest], homes, df, reg, target_mod, ps, acc)
      DConstructor(inner, _, _) ->
        validate_impl_methods_loop([inner, ...rest], homes, df, reg, target_mod, ps, acc)
      _ -> validate_impl_methods_loop(rest, hrest, df, reg, target_mod, ps, acc)
      }
    }
  }
}

fn proto_op_names(ops: [ProtoOpReg], acc: [String]) : [String] {
  match ops {
    [] -> acc
    [op, ...rest] -> match op {
      POR(_, name, _, _, _, _, _, _) -> proto_op_names(rest, [name, ...acc])
    }
  }
}

# Shape 1: every protocol op must have a matching method in the impl.
fn check_missing_methods(proto_ops: [ProtoOpReg], methods: [Decl],
                         pname: String, tname: String,
                         all_op_names: [String],
                         file: String, line: Int, col: Int,
                         acc: [Diagnostic]) : [Diagnostic] {
  match proto_ops {
    [] -> acc
    [op, ...rest] -> match op {
      POR(_, opname, _, _, _, _, _, _) -> {
        let acc1 =
          if impl_has_method(methods, opname) { acc }
          else {
            [mk_diag(SevError, file, line, col,
               concat_all(["impl `", pname, " for ", tname,
                           "` is missing required method `", opname, "`"]),
               [ri_note(file, line, col,
                  concat_all(["protocol `", pname, "` declares operations: ",
                              proto_join_with(all_op_names, ", ")]))]), ...acc]
          }
        check_missing_methods(rest, methods, pname, tname, all_op_names,
                              file, line, col, acc1)
      }
    }
  }
}

fn impl_has_method(methods: [Decl], opname: String) : Bool {
  match methods {
    [] -> false
    [d, ...rest] -> match d {
      DFn(_, name, _, _, _, _, _, _, _, _, fsym) ->
        if name == opname { true } else { impl_has_method(rest, opname) }
      _ -> impl_has_method(rest, opname)
    }
  }
}

# Shapes 2 + 3: walk each impl method; if it matches a protocol op,
# check arity and signature compatibility. Methods that match no
# protocol op are reported as unknown.
fn check_impl_methods(methods: [Decl], proto_ops: [ProtoOpReg],
                      pname: String, tname: String, target: TypeExpr,
                      proto_tps: [String], arg_heads: [String],
                      file: String, acc: [Diagnostic]) : [Diagnostic] {
  match methods {
    [] -> acc
    [d, ...rest] -> match d {
      DFn(_, op_name, _, params, ret_opt, _, _, line, col, _, fsym) -> {
        let acc1 = match find_proto_op(proto_ops, op_name) {
          None ->
            [proto_err(file, line, col,
               concat_all(["impl `", pname, " for ", tname,
                           "` declares method `", op_name,
                           "` which is not an operation of protocol `", pname, "`"])), ...acc]
          Some(op) -> match op {
            POR(_, _, proto_params, proto_ret, _, _, _, _) -> {
              let pa = list_length(params)
              let pp = list_length(proto_params)
              let e_ar =
                if pa == pp { acc }
                else {
                  [proto_err(file, line, col,
                     concat_all(["impl method `", op_name, "` in `", pname, " for ", tname,
                                 "` has arity ", int_to_string(pa),
                                 " but protocol declares arity ", int_to_string(pp)])), ...acc]
                }
              if pa == pp {
                check_sig_heads(params, proto_params, ret_opt, proto_ret,
                                op_name, pname, tname, target,
                                proto_tps, arg_heads,
                                file, line, col, e_ar)
              } else { e_ar }
            }
          }
        }
        check_impl_methods(rest, proto_ops, pname, tname, target,
                           proto_tps, arg_heads, file, acc1)
      }
      _ -> check_impl_methods(rest, proto_ops, pname, tname, target,
                              proto_tps, arg_heads, file, acc)
    }
  }
}

fn find_proto_op(ops: [ProtoOpReg], target: String) : Option[ProtoOpReg] {
  match ops {
    [] -> None
    [op, ...rest] -> match op {
      POR(_, name, _, _, _, _, _, _) ->
        if name == target { Some(op) } else { find_proto_op(rest, target) }
    }
  }
}

# Compare an impl signature against the protocol's. `Self` in the
# protocol substitutes to the impl target; each protocol tparam `Ai`
# substitutes to `arg_heads[i]` (or the target when `arg_heads == []`,
# the homogeneous default per the lower_impls rule). Parameters are
# compared structurally, so two instantiations of one constructor are
# distinguished; the return below compares head names only, except a
# function type, which has no meaningful head and compares structurally.
# Unannotated impl params (`ptype == None`) are not checked — the
# typer infers them; a pre-typer pass has no signal to compare against.
fn check_sig_heads(impl_params: [Param], proto_params: [Param],
                   impl_ret_opt: Option[TypeExpr], proto_ret: TypeExpr,
                   op_name: String, pname: String, tname: String,
                   target: TypeExpr,
                   proto_tps: [String], arg_heads: [String],
                   file: String, line: Int, col: Int,
                   acc: [Diagnostic]) : [Diagnostic] {
  let e_params = check_sig_param_heads(impl_params, proto_params, tname, target,
                                        proto_tps, arg_heads,
                                        op_name, pname, file, acc)
  # Return-type check applies only when the impl is homogeneous w.r.t.
  # the protocol's tparams. Heterogeneous impls (`impl P[Other] for T`
  # with Other != T) often produce a *promoted* result type that the
  # protocol's `Self` return cannot express — stdlib's
  # `impl Add[Complex] for Real { fn add(...) : Complex }` is the
  # canonical case. Validating the return there requires a protocol-
  # level `Result` tparam or HKT, both out of scope for v1. The
  # parameter-position checks above still catch genuine signature
  # drift (wrong `self`/`rhs` types) — the leak here is only when
  # the impl rewrites the return shape for a known good reason.
  if heterogeneous_impl(arg_heads, tname) { e_params }
  else { match impl_ret_opt {
    None -> e_params
    Some(impl_ret) -> {
      let ok = match proto_ret.tkind {
        TyFn(_, _, _) -> sig_type_matches(impl_ret, sig_subst(proto_ret, tname, target, proto_tps, arg_heads))
        _ -> proto_type_name(impl_ret) == sig_head_subst(proto_ret, tname, proto_tps, arg_heads)
      }
      if ok { e_params }
      else {
        [proto_err(file, line, col,
           concat_all(["impl method `", op_name, "` in `", pname, " for ", tname,
                       "` returns `", proto_type_text(impl_ret, file),
                       "` but protocol declares return type `",
                       sig_ret_display(proto_ret, tname, target, proto_tps, arg_heads, file), "`"])),
         ...e_params]
      }
    }
  } }
}

# A row label the file's own effect was home-spelled for reads back as
# the name its source wrote.
fn proto_type_text(t: TypeExpr, file: String) : String =
  type_text_with(t, (n) => hs_display(n, Some(module_name_of_path(file))))

fn sig_ret_display(t: TypeExpr, tname: String, target: TypeExpr,
                   proto_tps: [String], arg_heads: [String], file: String) : String =
  match t.tkind {
    TyFn(_, _, _) -> proto_type_text(sig_subst(t, tname, target, proto_tps, arg_heads), file)
    _ -> sig_head_subst(t, tname, proto_tps, arg_heads)
  }

# An impl is heterogeneous iff it carries explicit bracket args and
# at least one of them differs from the target head. Legacy un-
# parametrised impls (`arg_heads == []`) are homogeneous by
# definition. Same-as-target args (`impl Add[Complex] for Complex`)
# round-trip through the homogeneous default, so they are not
# heterogeneous either.
fn heterogeneous_impl(arg_heads: [String], tname: String) : Bool {
  match arg_heads {
    [] -> false
    [h, ...rest] -> if h != tname { true } else { heterogeneous_impl(rest, tname) }
  }
}

fn check_sig_param_heads(impl_ps: [Param], proto_ps: [Param], tname: String,
                         target: TypeExpr,
                         proto_tps: [String], arg_heads: [String],
                         op_name: String, pname: String,
                         file: String, acc: [Diagnostic]) : [Diagnostic] {
  match impl_ps {
    [] -> acc
    [ip, ...irest] -> match proto_ps {
      [] -> acc
      [pp, ...prest] -> {
        let acc1 = match ip.ptype {
          None -> acc
          Some(it) -> match pp.ptype {
            None -> acc
            Some(pt) -> {
              let ps = sig_subst(pt, tname, target, proto_tps, arg_heads)
              if sig_type_matches(it, ps) { acc }
              else {
                [proto_err(file, ip.pline, ip.pcol,
                   concat_all(["impl method `", op_name, "` in `", pname, " for ", tname,
                               "`: parameter `", ip.pname,
                               "` has type `", proto_type_text(it, file),
                               "` but protocol declares `", proto_type_text(ps, file), "`"])), ...acc]
              }
            }
          }
        }
        check_sig_param_heads(irest, prest, tname, target,
                              proto_tps, arg_heads,
                              op_name, pname, file, acc1)
      }
    }
  }
}

# Structural comparison of an impl parameter against its substituted
# protocol counterpart. Arguments are compared at depth, so two
# instantiations of the same constructor (`Pair[String, Bool]` vs
# `Pair[Int, Bool]`) do not compare equal. Either side left
# argument-free stays permissive and matches on the head alone,
# preserving the pre-existing tolerance for unresolved variables.
fn sig_type_matches(impl_t: TypeExpr, proto_t: TypeExpr) : Bool {
  match proto_t.tkind {
    TyName(_, pn, pargs) -> match impl_t.tkind {
      TyName(_, inm, iargs) ->
        if pn != inm { false }
        else if pargs == [] or iargs == [] { true }
        else { sig_types_match(iargs, pargs) }
      _ -> proto_type_name(impl_t) == pn
    }
    TyList(pinner) -> match impl_t.tkind {
      TyList(iinner) -> sig_type_matches(iinner, pinner)
      _ -> false
    }
    TyFn(pps, pret, prow) -> match impl_t.tkind {
      TyFn(ips, iret, irow) ->
        sig_types_match(ips, pps) and sig_type_matches(iret, pret) and sig_rows_match(irow, prow)
      _ -> false
    }
    _ -> proto_type_name(impl_t) == proto_type_name(proto_t)
  }
}

# Two closed rows match when their label sets do.
fn sig_rows_match(ir: RowExpr, pr: RowExpr) : Bool =
  # Compatibility with an open row is undecided, so it is not rejected.
  row_is_open(ir) or row_is_open(pr)
    or (sig_labels_within(row_labels_of(ir), row_labels_of(pr), true)
      and sig_labels_within(row_labels_of(pr), row_labels_of(ir), false))

fn row_is_open(r: RowExpr) : Bool = match r { ROpen(_, _) -> true  _ -> false }

fn row_labels_of(r: RowExpr) : [RowLabel] =
  match r { REmpty -> []  RClosed(ls) -> ls  ROpen(_, ls) -> ls }

# Every label of `xs` has a counterpart in `ys`; `xs_impl` says which side is the impl's.
fn sig_labels_within(xs: [RowLabel], ys: [RowLabel], xs_impl: Bool) : Bool =
  match xs {
    [] -> true
    [x, ...rest] -> sig_label_in(x, ys, xs_impl) and sig_labels_within(rest, ys, xs_impl)
  }

fn sig_label_in(x: RowLabel, ys: [RowLabel], x_impl: Bool) : Bool =
  match ys {
    [] -> false
    [y, ...rest] ->
      (if x_impl { sig_label_matches(x, y) } else { sig_label_matches(y, x) })
        or sig_label_in(x, rest, x_impl)
  }

fn sig_label_matches(i: RowLabel, p: RowLabel) : Bool =
  match i {
    RL(inm, iargs, isym) -> match p {
      RL(pnm, pargs, psym) ->
        eff_ref_same(inm, isym, pnm, psym) and (pargs == [] or iargs == [] or sig_types_match(iargs, pargs))
    }
  }

fn sig_types_match(its: [TypeExpr], pts: [TypeExpr]) : Bool {
  match pts {
    [] -> match its { [] -> true  _ -> false }
    [p, ...prest] -> match its {
      [] -> false
      [i, ...irest] -> if sig_type_matches(i, p) { sig_types_match(irest, prest) } else { false }
    }
  }
}

# Structural counterpart of `sig_head_subst`: `Self` becomes the whole
# impl target (arguments included), and a protocol tparam becomes its
# aligned bracket argument. A tparam applied to arguments (`s[Int]`
# with `s := Chain`) substitutes at the head and keeps its arguments,
# yielding `Chain[Int]` — the Shape-carrier form.
fn sig_subst(t: TypeExpr, tname: String, target: TypeExpr,
             proto_tps: [String], arg_heads: [String]) : TypeExpr {
  match t.tkind {
    TyName(th, n, targs) -> {
      let sargs = map(targs, (a) => sig_subst(a, tname, target, proto_tps, arg_heads))
      if n == "Self" {
        match targs { [] -> target  _ -> mk_ty(TyName(th, proto_type_name(target), sargs), t.line, t.col) }
      } else {
        match tparam_subst(n, proto_tps, arg_heads, tname) {
          Some(h) -> mk_ty(TyName(th, h, sargs), t.line, t.col)
          None    -> mk_ty(TyName(th, n, sargs), t.line, t.col)
        }
      }
    }
    TyList(inner) -> mk_ty(TyList(sig_subst(inner, tname, target, proto_tps, arg_heads)), t.line, t.col)
    TyFn(ps, ret, row) -> {
      let sps = map(ps, (p) => sig_subst(p, tname, target, proto_tps, arg_heads))
      let sret = sig_subst(ret, tname, target, proto_tps, arg_heads)
      mk_ty(TyFn(sps, sret, sig_subst_row(row, tname, target, proto_tps, arg_heads)), t.line, t.col)
    }
    _ -> t
  }
}

fn sig_subst_row(r: RowExpr, tname: String, target: TypeExpr,
                 proto_tps: [String], arg_heads: [String]) : RowExpr {
  let sub = (l: RowLabel) => match l {
    RL(n, args, s) -> RL(n, map(args, (a) => sig_subst(a, tname, target, proto_tps, arg_heads)), s)
  }
  match r {
    REmpty -> REmpty
    RClosed(ls) -> RClosed(map(ls, sub))
    ROpen(tail, ls) -> ROpen(tail, map(ls, sub))
  }
}

# Substitute `Self` and protocol tparams against the impl target +
# bracket args, then collapse to the head name. Anything that doesn't
# bind (free tparam outside the protocol's own list, etc.) falls
# through to the standard `proto_type_name` collapse — head-name
# comparison is intentionally permissive about unresolved variables.
fn sig_head_subst(t: TypeExpr, tname: String,
                  proto_tps: [String], arg_heads: [String]) : String {
  match t.tkind {
    TyName(_, n, _) ->
      if n == "Self" { tname }
      else { match tparam_subst(n, proto_tps, arg_heads, tname) {
        Some(h) -> h
        None    -> proto_type_name(t)
      } }
    _ -> proto_type_name(t)
  }
}

# Position-aligned lookup: `proto_tps[i]` -> `arg_heads[i]`. When
# `arg_heads == []` (legacy un-parametrised impl), every protocol
# tparam falls back to the target head — the homogeneous default
# encoded in `lower_impls`. A tparam's stored name may carry a kind
# marker (`s#Shape`); the surface name is compared, so a `[s: Shape]`
# carrier binds `s := <target head>` exactly as a bare `[a]` does.
fn tparam_subst(n: String, tps: [String], heads: [String],
                tname: String) : Option[String] {
  match tps {
    [] -> None
    [t, ...trest] -> match heads {
      [] -> if tp_strip_kind(t) == n { Some(tname) } else { tparam_subst(n, trest, [], tname) }
      [h, ...hrest] ->
        if tp_strip_kind(t) == n { Some(h) } else { tparam_subst(n, trest, hrest, tname) }
    }
  }
}

# Walk every DImpl and (a) lower its methods into top-level DFns,
# (b) record (P, T) -> impl_fn_name in the registry. The fn body is
# the impl's original body verbatim; we only rename the function and
# leave the typer to do its work on the result.
fn lower_impls(ds: [Decl], reg: ProtocolReg, ps: PScope, acc_fns: [Decl]) : LowerImplsRes {
  match ds {
    [] -> LowerImplsRes { reg: reg, fns: list_reverse(acc_fns) }
    [d, ...rest] -> match d {
      DImpl(pspell, proto_args, target, methods, _, _, _, isym) -> {
        let tname = proto_type_name(target)
        let pname = dotted_bare(pspell)
        # Issue #180: derive the per-impl proto-arg name list. Empty
        # input list = legacy form, treated as `Ai = Self` (= [tname]).
        let arg_names = match proto_args {
          [] -> []
          _  -> map(proto_args, proto_type_name)
        }
        # The impl's dispatch key: resolve the head from the impl's own
        # module, then spell it. Unresolved protocols keep the bare
        # name — `validate_impls` has already reported them.
        let from = impl_home_of(methods)
        let psym = ps_proto_sym(ps, pspell, from)
        let key = proto_key_of(reg.dkeys, pname, psym)
        let r = lower_impl_methods(key, psym, tname, arg_names, from, methods, reg, acc_fns)
        lower_impls(rest, r.reg, ps, r.fns)
      }
      DDerive(_, inner, _, _) -> lower_impls([inner, ...rest], reg, ps, acc_fns)
      DUnstable(inner, _, _) -> lower_impls([inner, ...rest], reg, ps, acc_fns)
      DProtoLaws(_, inner, _, _, _) -> lower_impls([inner, ...rest], reg, ps, acc_fns)
      DImplAxiom(_, inner, _, _, _) -> lower_impls([inner, ...rest], reg, ps, acc_fns)
      DConstructor(inner, _, _) -> lower_impls([inner, ...rest], reg, ps, acc_fns)
      _ -> lower_impls(rest, reg, ps, acc_fns)
    }
  }
}

# The declaration a duplicate check compares: what the impl's module
# sees under the target's name. Every impl resolves in the same table,
# so the ids compare with each other; they never meet a `TyCon`'s.
fn impl_target_key(ps: PScope, tname: String, from: Option[String]) : String =
  match sv_resolve(ps_tab(ps), ps_view(ps, from), NCType, tname) {
    SvSym(s) -> concat_all([tname, "#", int_to_string(sym_raw(s))])
    _        -> tname
  }

# The module an impl block lives in, read off its first method's
# origin stamp (the cascade tags every method with the enclosing
# module; root-file methods carry none).
fn impl_home_of(methods: [Decl]) : Option[String] =
  match methods {
    [] -> None
    [d, ...rest] -> match d {
      DFn(_, _, _, _, _, _, _, _, _, mo, fsym) -> mo
      _ -> impl_home_of(rest)
    }
  }

type LowerImplsRes = { reg: ProtocolReg, fns: [Decl] }

# `acc_fns` accumulates in reverse; the caller list_reverses on
# return. `pkey` is the impl's protocol dispatch key, not necessarily
# the surface name — mangling and the PIR entry both carry it. `psym`
# is that protocol's identity, which decides whose impl the entry is.
fn lower_impl_methods(pkey: String, psym: SymId, tname: String, arg_names: [String],
                      home: Option[String], methods: [Decl],
                      reg: ProtocolReg, acc_fns: [Decl]) : LowerImplsRes {
  match methods {
    [] -> LowerImplsRes { reg: reg, fns: acc_fns }
    [d, ...rest] -> match d {
      DFn(_, op_name, tparams, params, ret, row, body, line, col, mo, fsym) -> {
        # Issue #180: only the heterogeneous case (Ai != Self) augments
        # the mangled name. The default-Self form keeps the legacy
        # mangling so `impl Add for Complex` and `impl Add[Complex] for
        # Complex` produce the same impl-fn name.
        let mangled = proto_impl_mangled_with_args(pkey, tname, op_name, arg_names)
        let new_fn = DFn(false, mangled, tparams, params, ret, row, body, line, col, mo, fnid_none())
        let ret_head = match ret { Some(rte) -> proto_type_name(rte)  None -> tname }
        let entry = PIR(pkey, tname, op_name, mangled, arg_names, ret_head, home, sym_none(), psym)
        let reg1 = ProtocolReg {
          ops: reg.ops,
          impls: [entry, ...reg.impls],
          op_names: reg.op_names,
          tparams: reg.tparams,
          origins: reg.origins,
          dkeys: reg.dkeys,
          impl_index: reg.impl_index,
          cores: reg.cores, imports: reg.imports, root: reg.root
        }
        lower_impl_methods(pkey, psym, tname, arg_names, home, rest, reg1, [new_fn, ...acc_fns])
      }
      _ -> lower_impl_methods(pkey, psym, tname, arg_names, home, rest, reg, acc_fns)
    }
  }
}

# Generate one stub-dispatcher DFn per protocol op so the resolver
# and typer can treat `op(x, ...)` as a regular polymorphic call.
# The body panics; the post-inference rewrite redirects every reach-
# able call to the matching `__pimpl_*` function.
#
# Issue #597 boundary tagging: each dispatcher inherits the home
# module of the originating DProtocol via `reg.origins`. Root-file
# protocols still resolve to `mo = None`, so root-file selfhost
# stays byte-identical. Core protocols (the common case in
# `stdlib/protocols.kai`) now produce dispatchers tagged with the
# core's basename so a cache loader can partition post-cascade
# decls back into their original core/user segments.
fn generate_dispatchers(reg: ProtocolReg) : [Decl] =
  generate_dispatchers_loop(reg.ops, op_arities_from_ops(reg.ops), [])

fn generate_dispatchers_loop(ops: [ProtoOpReg], arities: [OpAr],
                                acc: [Decl]) : [Decl] {
  match ops {
    [] -> acc
    [op, ...rest] -> match op {
      POR(pname, opname, params, ret, line, col, mo, _) -> {
        # Dedup by the arity-resolved dispatcher NAME, not the bare op
        # name: an arity-ambiguous op (`f/1` + `f/2`) yields two
        # distinct dispatcher names, so both survive; same-arity
        # collisions still collapse to one shared dispatcher.
        let disp = proto_dispatcher_name_at(arities, opname, list_length(params))
        let already = dispatcher_named_in_acc(acc, disp, mo)
        if already { generate_dispatchers_loop(rest, arities, acc) }
        else {
          let stub = make_dispatcher_fn(pname, opname, disp, params, ret, line, col, mo)
          generate_dispatchers_loop(rest, arities, [stub, ...acc])
        }
      }
    }
  }
}

# One dispatcher per (name, home): two modules declaring the same op
# each get their own, so a call narrows by receiver among distinct
# signatures instead of meeting whichever module registered first.
fn dispatcher_named_in_acc(ds: [Decl], want: String, mo: Option[String]) : Bool {
  match ds {
    [] -> false
    [d, ...rest] -> match d {
      DFn(_, n, _, _, _, _, _, _, _, dmo, fsym) ->
        if n == want and mo_eq(dmo, mo) { true }
        else { dispatcher_named_in_acc(rest, want, mo) }
      _ -> dispatcher_named_in_acc(rest, want, mo)
    }
  }
}

# `disp_name` is the arity-resolved dispatcher symbol (may carry an
# `__a<N>` suffix); `opname` is the original op name, kept for the
# dispatch tag so the post-inference rewrite and emit resolve the impl
# by the protocol's true op name.
fn make_dispatcher_fn(pname: String, opname: String, disp_name: String,
                       params: [Param], ret: TypeExpr, line: Int, col: Int,
                       mo: Option[String]) : Decl {
  let new_params = map(params, dispatcher_substitute_self_param)
  let new_ret = substitute_self_in_type(ret)
  let body = make_dispatcher_body(pname, opname, new_ret, line, col)
  DFn(true, disp_name, [], new_params, Some(new_ret),
      REmpty, body, line, col, mo, fnid_none())
}

# Synthesises an `ETodo` body tagged `__kai_proto_dispatch__:<P>:<op>`.
# The typer keeps treating the dispatcher as a regular polymorphic fn
# (ETodo is the same magic shape `body_is_ffi_extern` uses for FFI
# shims, see `proto_dispatch_tag` above). When the C / LLVM emit
# encounters this body, it generates a runtime-dispatch shim that
# looks up the matching `__pimpl_*` in the impl-table by
# `(proto_id, head_tag(self))` and tail-calls it — option C from
# `docs/protocols.md`. Post-inference rewrite still redirects every
# monomorphic call site directly to `__pimpl_<P>_<T>_<op>`, so the
# runtime lookup only runs when the type stays polymorphic past mono
# (e.g. inside the body of `impl[T : Show] Show for [T]`).
fn make_dispatcher_body(pname: String, opname: String, ret: TypeExpr,
                          line: Int, col: Int) : Expr =
  proto_mk_dispatch_body(pname, opname, line, col)

fn dispatcher_substitute_self_param(p: Param) : Param {
  match p.ptype {
    None -> p
    Some(te) -> Param { pname: p.pname, ptype: Some(substitute_self_in_type(te)),
                         pline: p.pline, pcol: p.pcol, pborrow: p.pborrow }
  }
}

fn substitute_self_in_type(te: TypeExpr) : TypeExpr {
  TypeExpr {
    tkind: substitute_self_in_kind(te.tkind),
    line: te.line, col: te.col
  }
}

fn substitute_self_in_kind(k: TyKind) : TyKind {
  match k {
    # `targs` (not `args`) — `args` is a core function name and the
    # stage-1 resolver does not let the pattern binding shadow the
    # core reference inside the body.
    TyName(th, name, targs) -> {
      let new_name = if name == "Self" { "proto_self" } else { name }
      TyName(th, new_name, map(targs, substitute_self_in_type))
    }
    TyList(inner) -> TyList(substitute_self_in_type(inner))
    TyFn(ps, ret, row) ->
      TyFn(map(ps, substitute_self_in_type), substitute_self_in_type(ret), row)
    # m12.5: substitute under the dimensioned base; the unit
    # expression is leaf data with no `Self` reference (units come
    # from the global unit table, not from the protocol's tparam).
    TyDim(base, u) -> TyDim(substitute_self_in_type(base), u)
    # m12.6.a: predicates do not contain TypeExpr nodes that mention
    # Self, so the predicate is left intact.
    TyRefine(base, p) -> TyRefine(substitute_self_in_type(base), p)
    # issue #772: a compound row carries effect labels, not `Self` —
    # passed through unchanged, matching the `TyFn` row above.
    TyRow(row) -> TyRow(row)
    TySurface(ts) ->
      TySurface(tysurface_rebuild(ts, map(tysurface_children(ts), substitute_self_in_type)))
  }
}

# Validate, before expansion, that every `#[derive(P)]` of Eq, Hash or
# Show can be discharged: each field type must reach an impl of `P`
# (explicit, derived, or builtin) through every type argument a container
# impl bounds by `P`, so `[(Int, String)]` needs `P` on `List` and `Pair`.
fn validate_derives(ds: [Decl], df: DiagFiles) : [Diagnostic] / Console =
  list_reverse(validate_derives_loop(ds, df, collect_impl_reach(ds, []), []))

fn collect_impl_reach(ds: [Decl], acc: [ImplReach]) : [ImplReach] {
  match ds {
    [] -> acc
    [d, ...rest] -> match d {
      DImpl(pname, _, target, _, _, _, tps, _) ->
        collect_impl_reach(rest, [impl_reach(dotted_bare(pname), head_tree(target), tps), ...acc])
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tname, tps, _, _, _, _, _, _) ->
          collect_impl_reach(rest, list_append(map(names, (n) => derived_reach(dotted_bare(n), tname, tps)), acc))
        _ -> collect_impl_reach(rest, acc)
      }
      DUnstable(inner, _, _) ->
        collect_impl_reach([inner, ...rest], acc)
      DProtoLaws(_, inner, _, _, _) ->
        collect_impl_reach([inner, ...rest], acc)
      DImplAxiom(_, inner, _, _, _) ->
        collect_impl_reach([inner, ...rest], acc)
      DConstructor(inner, _, _) ->
        collect_impl_reach([inner, ...rest], acc)
      _ -> collect_impl_reach(rest, acc)
    }
  }
}

fn head_tree(te: TypeExpr) : HeadTree = HT(proto_type_name(te), map(te_type_args(te), head_tree))

fn te_type_args(te: TypeExpr) : [TypeExpr] = match te.tkind {
  TyName(_, _, args)   -> args
  TyList(elem)      -> [elem]
  TyDim(base, _)    -> te_type_args(base)
  TyRefine(base, _) -> te_type_args(base)
  _                 -> []
}

# Builtin impls bundled with kaikai for primitive types, kept in
# sync with stdlib/protocols.kai. The validator treats these as
# always available so users do not have to redeclare `impl Eq for
# Int` in every fixture that derives Eq on a sum carrying Ints.
#[doc("True iff kaikai bundles a structural builtin impl of the core protocol `p` for primitive head `tname` (Eq/Show/Ord/Hash over Int/Real/String/... and fixed-width ints).")]
pub fn derive_builtin_impl(p: CoreProto, tname: String) : Bool = match p {
  CpEq ->
    list_has(["Int", "Real", "Bool", "String", "Char", "Unit"], tname) or is_fixed_width_name(tname)
  CpHash ->
    list_has(["Int", "Real", "String", "Bool", "Char"], tname) or is_fixed_width_name(tname)
  CpShow ->
    list_has(["Int", "Real", "Bool", "String", "Unit", "Char"], tname) or is_fixed_width_name(tname)
  CpOrd -> is_fixed_width_name(tname)
  _     -> false
}

# A `#[derive]` entry read once: the bare name it prints as and the
# generator that name picks. The bare name alone picks it, whatever
# protocol the entry resolves to: the impl a generator builds keeps the
# entry as written and resolves like a hand-written one.
type DeriveGen = DeriveGen(String, CoreProto)

fn derive_gen(pspell: String) : Option[CoreProto] = core_proto_named(dotted_bare(pspell))

fn derive_gens(names: [String]) : [DeriveGen] = match names {
  []           -> []
  [n, ...rest] -> match derive_gen(n) {
    Some(g) -> [DeriveGen(dotted_bare(n), g), ...derive_gens(rest)]
    None    -> derive_gens(rest)
  }
}

# True when the written protocol name `pspell` picks the generator `g`.
# A derive checks its fields against impls the same way: an impl
# provides for a generator when its written protocol name spells it.
fn spells_gen(pspell: String, g: CoreProto) : Bool = match derive_gen(pspell) {
  Some(p) -> core_proto_same(p, g)
  None    -> false
}

fn derives_gen(names: [String], g: CoreProto) : Bool = match names {
  []           -> false
  [n, ...rest] -> spells_gen(n, g) or derives_gen(rest, g)
}

fn validate_derives_loop(ds: [Decl], df: DiagFiles, reach: [ImplReach], errs: [Diagnostic]) : [Diagnostic] / Console {
  match ds {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, line, col) -> {
        let file = decl_diag_file(d, df)
        let errs1 = validate_derive_decl(map(names, dotted_bare), inner, file, reach, line, col, errs)
        validate_derives_loop(rest, df, reach, errs1)
      }
      DUnstable(inner, _, _) ->
        validate_derives_loop([inner, ...rest], df, reach, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derives_loop([inner, ...rest], df, reach, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derives_loop([inner, ...rest], df, reach, errs)
      DConstructor(inner, _, _) ->
        validate_derives_loop([inner, ...rest], df, reach, errs)
      _ -> validate_derives_loop(rest, df, reach, errs)
    }
  }
}

# Where a derive reports: the file and position of its declaration.
type DeriveSite = DS(String, Int, Int)

fn validate_derive_decl(names: [String], inner: Decl, file: String, reach: [ImplReach],
                        dline: Int, dcol: Int, errs: [Diagnostic]) : [Diagnostic] / Console = match inner {
  DType(_, tname, tps, body, _, _, _, _, _) -> {
    let fields = derive_field_types(body)
    let own = list_append(map(names, (n) => derived_reach(n, tname, tps)), param_reach(names, tps))
    validate_derive_protos(filter(derive_gens(names), derive_reach_checked), tname, fields,
                           list_append(own, reach), DS(file, dline, dcol), errs)
  }
  _ -> errs
}

fn derive_reach_checked(d: DeriveGen) : Bool = match d {
  DeriveGen(_, g) -> match g {
    CpEq   -> true
    CpHash -> true
    CpShow -> true
    _      -> false
  }
}

# A field typed by a parameter the derive bounds is covered by that bound.
fn param_reach(names: [String], tps: [String]) : [ImplReach] = match names {
  []          -> []
  [n, ...rest] ->
    list_append(map(derive_bound_params(tps), (tp) => IR(reach_key(n, tp), [])), param_reach(rest, tps))
}

# Each field a derived impl reads, labelled the way a diagnostic names it.
type DeriveField = DFld(String, TypeExpr)

fn derive_field_types(body: TypeBody) : [DeriveField] = match body {
  TBSum(variants)  -> variant_fields(variants)
  TBRecord(fields) -> map(fields, record_field)
  _                -> []
}

fn variant_fields(vs: [Variant]) : [DeriveField] = match vs {
  []           -> []
  [v, ...rest] -> match v {
    Var(vname, vargs) -> list_append(variant_args(vname, vargs, 0), variant_fields(rest))
  }
}

fn variant_args(vname: String, vargs: [TypeExpr], i: Int) : [DeriveField] = match vargs {
  []            -> []
  [te, ...rest] ->
    [DFld(concat_all(["variant `", vname, "` field #", int_to_string(i)]), te),
     ...variant_args(vname, rest, i + 1)]
}

fn record_field(f: FieldDecl) : DeriveField = match f {
  FD(_, fname, te, _) -> DFld(concat_all(["field `", fname, "`"]), te)
}

fn validate_derive_protos(gens: [DeriveGen], tname: String, fields: [DeriveField],
                          reach: [ImplReach], site: DeriveSite, errs: [Diagnostic]) : [Diagnostic] / Console = match gens {
  []           -> errs
  [d, ...rest] ->
    validate_derive_protos(rest, tname, fields, reach, site,
                           validate_derive_fields(d, tname, fields, reach, site, errs))
}

fn validate_derive_fields(d: DeriveGen, tname: String, fields: [DeriveField],
                          reach: [ImplReach], site: DeriveSite, errs: [Diagnostic]) : [Diagnostic] / Console = match fields {
  []           -> errs
  [f, ...rest] -> match f {
    DFld(what, te) -> match d { DeriveGen(pname, g) -> {
      let path = missing_path(pname, head_tree(te), reach, (h) => derive_builtin_impl(g, h))
      let errs1 = match path {
        [] -> errs
        _  -> {
          [report_derive_missing(pname, tname, what, path, site), ...errs]
        }
      }
      validate_derive_fields(d, tname, rest, reach, site, errs1)
    } }
  }
}

fn last_head(path: [String]) : String = match path {
  []           -> ""
  [h]          -> h
  [_, ...rest] -> last_head(rest)
}

# A derive error, printed on the single line the derive diagnostics use.
fn derive_error(file: String, line: Int, col: Int, msg: String) : Diagnostic / Console = {
  eprint(concat_all([file, ":", int_to_string(line), ":", int_to_string(col), ": error: ", msg]))
  mk_diag(SevError, file, line, col, msg, [])
}

fn report_derive_missing(pname: String, tname: String, what: String, path: [String],
                         site: DeriveSite) : Diagnostic / Console = match site {
  DS(file, line, col) -> {
    let head = last_head(path)
    let lacks = concat_all(["no `impl ", pname, " for ", head, "` in this compilation unit"])
    let tail = match path {
      [_] -> concat_all([" which has ", lacks])
      _   -> concat_all(["; `", head, "` has ", lacks])
    }
    derive_error(file, line, col, concat_all([
      "cannot derive `", pname, "` for `", tname, "`: ", what,
      " has type `", path_type(path), "`", tail]))
  }
}

# Phase 1: expand each `DDerive(names, type_decl)` into its wrapped
# DType followed by one synthetic DImpl per derived protocol.
# DProtocol and ordinary DImpl decls pass through unchanged so the
# next pass can collect them.
# The decl stream with every `#[derive]` expanded, and the impls the
# derives minted on their own.
type Expanded = Expanded([Decl], [Decl])

fn expand_derives(ds: [Decl], target_mod: String) : Expanded =
  expand_derives_loop(ds, target_mod, collect_binser_types(ds, false, []), [], [])

# `writers` names every type deriving BinSerialize: a field of one of
# them is encoded by its writer instead of a fresh `to_bytes` array.
fn expand_derives_loop(ds: [Decl], target_mod: String, writers: [String], acc: [Decl], minted: [Decl]) : Expanded {
  match ds {
    [] -> Expanded(list_reverse(acc), minted)
    [d, ...rest] -> match d {
      DDerive(names, inner, l, c) -> {
        let home = decl_type_home(inner, target_mod)
        let derived = map(derive_impls_for(names, inner, home, writers),
                          (dd) => stamp_derived_home(dd, home, l, c))
        expand_derives_loop(rest, target_mod, writers,
                            list_append([inner, ...list_reverse(derived)], acc),
                            list_append(derived, minted))
      }
      DUnstable(inner, _, _) ->
        expand_derives_loop([inner, ...rest], target_mod, writers, acc, minted)
      # Every other wrapper stays: the `#[constructor]` registry is
      # collected in the typer, so unwrapping it would lose it.
      _ -> expand_derives_loop(rest, target_mod, writers, [d, ...acc], minted)
    }
  }
}

# Phase 2: drop every DProtocol / DImpl from the decl stream after
# the impl-lowering pass has copied their content into ordinary
# DFns. DDerive nodes have already been replaced by `expand_derives`.
fn strip_protocols(ds: [Decl]) : [Decl] = strip_protocols_loop(ds, [])

fn strip_protocols_loop(ds: [Decl], acc: [Decl]) : [Decl] {
  match ds {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DProtocol(_, _, _, _, _, _, _, _) -> strip_protocols_loop(rest, acc)
      DImpl(_, _, _, _, _, _, _, isym)     -> strip_protocols_loop(rest, acc)
      DDerive(_, _, _, _)      -> strip_protocols_loop(rest, acc)
      _ -> strip_protocols_loop(rest, [d, ...acc])
    }
  }
}

# Generate structural impls for #derive(P, ...) on the wrapped
# DType. Walks the type body and synthesises one DImpl per derived
# protocol. Records produce field-by-field ops; sum types produce
# variant-by-variant match arms. Each synthesised impl body invokes
# the protocol's own ops on the inner fields, so the fields' types
# must already implement the same protocol — checked transitively
# by the typer / resolver after lowering.
# `shown` is the name the user wrote: what a derived `show` prints and
# what a synthesised shim is called, behind any home spelling.
type DerivedType = { tname: String, tps: [String], shown: String, body: TypeBody, writers: [String] }

fn derive_impls_for(names: [String], dt: Decl, home: Option[String], writers: [String]) : [Decl] {
  match dt {
    DType(_, tname, tps, body, line, col, _, _, _) ->
      derive_impls_loop(names, DerivedType { tname: tname, tps: tps, shown: hs_display(tname, home),
                                             body: body, writers: writers }, line, col, [])
    _ -> []
  }
}

# The bare name picks the generator; the impl keeps the spelling as
# written (`m.P`) so it resolves against that module's protocol.
fn derive_impls_loop(names: [String], dt: DerivedType, line: Int, col: Int, acc: [Decl]) : [Decl] {
  match names {
    [] -> list_reverse(acc)
    [pspell, ...rest] -> {
      let generated = match derive_gen(pspell) {
        Some(g) -> derive_impl_for_protocol(g, dt, line, col)
        None    -> []
      }
      let ds = map(generated,
                   (dd) => derive_generalize(impl_with_pname(dd, pspell), pspell, dt.tname, dt.tps))
      derive_impls_loop(rest, dt, line, col, list_append(list_reverse(ds), acc))
    }
  }
}

fn impl_with_pname(d: Decl, pspell: String) : Decl = match d {
  DImpl(_, pargs, target, ms, l, c, tps, isym) -> DImpl(pspell, pargs, target, ms, l, c, tps, isym)
  _ -> d
}

# Everything a derive synthesises — the impl's methods and any
# top-level shim — belongs to the module declaring the type, exactly
# as if written there by hand. The impl itself sits at the attribute,
# where a diagnostic about it points.
fn stamp_derived_home(d: Decl, mo: Option[String], al: Int, ac: Int) : Decl = match d {
  DImpl(p, pargs, target, ms, _, _, tps, isym) ->
    DImpl(p, pargs, target, map(ms, (m) => stamp_derived_home(m, mo, al, ac)), al, ac, tps, isym)
  DFn(p, n, tps, ps, ret, row, body, l, c, _, fsym) ->
    DFn(p, n, tps, ps, ret, row, body, l, c, mo, fsym)
  _ -> d
}

# Root-file types are stamped with the target module; root fns are
# not. The synthesised fns follow the fn convention.
fn decl_type_home(d: Decl, target_mod: String) : Option[String] = match d {
  DType(_, _, _, _, _, _, mo, _, _) -> match mo {
    Some(m) -> proto_mo_of(m, target_mod)
    None    -> None
  }
  _ -> None
}

# Synthesise zero or more decls for `#derive(P) type T = ...`. v1
# supports `Show`, `Eq`, `Hash`, `Ord`, and `BinSerialize` on records
# and sum types. The returned list is empty when the (P, body)
# combination is unsupported (the resolver / typer surfaces that as
# "no impl"). Most protocols return a single `DImpl`; `BinSerialize`
# additionally returns a top-level `<tname>_from_bytes` shim because
# v1 single-dispatch cannot route a return-type-only call (issue
# #459 §"Two design routes" + the `Serialize` prologue in
# `stdlib/protocols.kai`).
fn derive_impl_for_protocol(g: CoreProto, dt: DerivedType, line: Int, col: Int) : [Decl] {
  let tname = dt.tname
  let shown = dt.shown
  let body = dt.body
  match g {
    CpShow         -> option_to_list(derive_show_impl(tname, shown, body, line, col))
    CpEq           -> option_to_list(derive_eq_impl(tname, body, line, col))
    CpHash         -> option_to_list(derive_hash_impl(tname, body, line, col))
    CpOrd          -> option_to_list(derive_ord_impl(tname, body, line, col))
    CpBinSerialize -> derive_binserialize_impl(tname, shown, body, dt.writers, line, col)
    CpLayout       -> derive_layout_impl(tname, shown, body, line, col)
    CpJson         -> derive_json_impl(tname, shown, body, line, col)
    _              -> []
  }
}

fn option_to_list(o: Option[Decl]) : [Decl] = match o {
  None    -> []
  Some(d) -> [d]
}

fn derive_show_impl(tname: String, shown: String, body: TypeBody, line: Int, col: Int) : Option[Decl] {
  match body {
    TBRecord(fields) -> {
      let body_expr = derive_show_record_body(shown, fields, line, col)
      Some(make_derived_impl("Show", tname, "show",
        [Param { pname: "x", ptype: Some(mk_ty(TyName(ty_ref_none(), tname, []), line, col)),
                 pline: line, pcol: col, pborrow: false }],
        mk_ty(TyName(ty_ref_none(), "String", []), line, col),
        body_expr, line, col))
    }
    TBSum(variants) -> {
      let body_expr = derive_show_sum_body(variants, line, col)
      Some(make_derived_impl("Show", tname, "show",
        [Param { pname: "x", ptype: Some(mk_ty(TyName(ty_ref_none(), tname, []), line, col)),
                 pline: line, pcol: col, pborrow: false }],
        mk_ty(TyName(ty_ref_none(), "String", []), line, col),
        body_expr, line, col))
    }
    _ -> None
  }
}

fn derive_show_record_body(tname: String, fields: [FieldDecl], line: Int, col: Int) : Expr {
  let parts = derive_show_record_parts(tname, fields, line, col)
  mk_expr(ECall(mk_ref("string_concat_all", line, col),
                [mk_expr(EList(map(parts, (e: Expr) => ElPlain(e))), line, col)]),
          line, col)
}

fn derive_show_record_parts(tname: String, fields: [FieldDecl], line: Int, col: Int) : [Expr] {
  let head = mk_expr(EStr(concat_all(["\"", tname, " { \""]), false), line, col)
  let body_parts = derive_show_field_parts(fields, line, col, true)
  let tail = mk_expr(EStr("\" }\"", false), line, col)
  list_append([head, ...body_parts], [tail])
}

fn derive_show_field_parts(fields: [FieldDecl], line: Int, col: Int, first: Bool) : [Expr] {
  match fields {
    [] -> []
    [fd, ...rest] -> match fd {
      FD(_, name, _, _) -> {
        let prefix_s = if first { concat_all(["\"", name, ": \""]) }
                       else { concat_all(["\", ", name, ": \""]) }
        let prefix = mk_expr(EStr(prefix_s, false), line, col)
        let access = mk_expr(EField(mk_ref("x", line, col), name), line, col)
        let call = mk_expr(ECall(mk_ref("show", line, col), [access]), line, col)
        list_append([prefix, call], derive_show_field_parts(rest, line, col, false))
      }
    }
  }
}

fn derive_show_sum_body(variants: [Variant], line: Int, col: Int) : Expr {
  let scrut = mk_ref("x", line, col)
  let arms = map(variants, (v) => derive_show_sum_arm(v, line, col))
  mk_expr(EMatch(scrut, arms), line, col)
}

fn derive_show_sum_arm(v: Variant, line: Int, col: Int) : Arm {
  match v {
    Var(name, vargs) -> {
      let pat_subs = derive_sum_pat_subs(vargs, 0, line, col)
      let pat = mk_pat(PVariant(None, name, pat_subs), line, col)
      let body = derive_show_sum_arm_body(name, vargs, line, col)
      Arm(pat, None, body)
    }
  }
}

fn derive_sum_pat_subs(vargs: [TypeExpr], i: Int, line: Int, col: Int) : [Pattern] {
  match vargs {
    [] -> []
    [_, ...rest] ->
      [mk_pat(PBind(concat_all(["a", int_to_string(i)])), line, col),
       ...derive_sum_pat_subs(rest, i + 1, line, col)]
  }
}

fn derive_show_sum_arm_body(name: String, vargs: [TypeExpr], line: Int, col: Int) : Expr {
  match vargs {
    [] -> mk_expr(EStr(concat_all(["\"", name, "\""]), false), line, col)
    _  -> {
      let head = mk_expr(EStr(concat_all(["\"", name, "(\""]), false), line, col)
      let tail = mk_expr(EStr("\")\"", false), line, col)
      let calls = derive_sum_arg_show_calls(vargs, 0, line, col, true)
      let parts = list_append([head, ...calls], [tail])
      mk_expr(ECall(mk_ref("string_concat_all", line, col),
                    [mk_expr(EList(map(parts, (e: Expr) => ElPlain(e))), line, col)]),
              line, col)
    }
  }
}

fn derive_sum_arg_show_calls(vargs: [TypeExpr], i: Int, line: Int, col: Int, first: Bool) : [Expr] {
  match vargs {
    [] -> []
    [_, ...rest] -> {
      let prefix = if first { mk_expr(EStr("\"\"", false), line, col) }
                   else { mk_expr(EStr("\", \"", false), line, col) }
      let av = mk_ref(concat_all(["a", int_to_string(i)]), line, col)
      let call = mk_expr(ECall(mk_ref("show", line, col), [av]), line, col)
      list_append([prefix, call], derive_sum_arg_show_calls(rest, i + 1, line, col, false))
    }
  }
}

fn derive_eq_impl(tname: String, body: TypeBody, line: Int, col: Int) : Option[Decl] {
  match body {
    TBRecord(fields) -> {
      let body_expr = derive_eq_record_body(fields, line, col)
      Some(make_derived_impl("Eq", tname, "eq",
        [Param { pname: "a", ptype: Some(mk_ty(TyName(ty_ref_none(), tname, []), line, col)),
                 pline: line, pcol: col, pborrow: false },
         Param { pname: "b", ptype: Some(mk_ty(TyName(ty_ref_none(), tname, []), line, col)),
                 pline: line, pcol: col, pborrow: false }],
        mk_ty(TyName(ty_ref_none(), "Bool", []), line, col),
        body_expr, line, col))
    }
    TBSum(variants) -> {
      let body_expr = derive_eq_sum_body(variants, line, col)
      Some(make_derived_impl("Eq", tname, "eq",
        [Param { pname: "a", ptype: Some(mk_ty(TyName(ty_ref_none(), tname, []), line, col)),
                 pline: line, pcol: col, pborrow: false },
         Param { pname: "b", ptype: Some(mk_ty(TyName(ty_ref_none(), tname, []), line, col)),
                 pline: line, pcol: col, pborrow: false }],
        mk_ty(TyName(ty_ref_none(), "Bool", []), line, col),
        body_expr, line, col))
    }
    _ -> None
  }
}

fn derive_eq_record_body(fields: [FieldDecl], line: Int, col: Int) : Expr {
  match fields {
    [] -> mk_expr(EBool(true), line, col)
    [fd, ...rest] -> derive_eq_record_chain(fd, rest, line, col)
  }
}

fn derive_eq_record_chain(head: FieldDecl, rest: [FieldDecl], line: Int, col: Int) : Expr {
  match head {
    FD(_, name, _, _) -> {
      let l_access = mk_expr(EField(mk_ref("a", line, col), name), line, col)
      let r_access = mk_expr(EField(mk_ref("b", line, col), name), line, col)
      let call = mk_expr(ECall(mk_ref("eq", line, col), [l_access, r_access]),
                         line, col)
      match rest {
        [] -> call
        [next, ...more] -> {
          let tail_e = derive_eq_record_chain(next, more, line, col)
          mk_expr(EBinop(BoAnd, call, tail_e), line, col)
        }
      }
    }
  }
}

# m12.8.x: `#derive(Eq)` on a sum type. Outer-match on `a`, one arm
# per variant; each arm rematches `b` for the same variant
# (returning `eq(la_0, lb_0) and eq(la_1, lb_1) and ...`) with a
# wildcard arm returning `false`. Empty sums (no variants) are
# defensive; the parser does not produce them today.
fn derive_eq_sum_body(variants: [Variant], line: Int, col: Int) : Expr {
  match variants {
    [] -> mk_expr(EBool(false), line, col)
    _  -> {
      let scrut = mk_ref("a", line, col)
      let arms = map(variants, (v) => derive_eq_sum_outer_arm(v, line, col))
      mk_expr(EMatch(scrut, arms), line, col)
    }
  }
}

fn derive_eq_sum_outer_arm(v: Variant, line: Int, col: Int) : Arm {
  match v {
    Var(name, vargs) -> {
      let pat_subs = derive_eq_sum_pat_subs("la_", vargs, 0, line, col)
      let pat = mk_pat(PVariant(None, name, pat_subs), line, col)
      let inner = derive_eq_sum_inner_match(name, vargs, line, col)
      Arm(pat, None, inner)
    }
  }
}

fn derive_eq_sum_inner_match(name: String, vargs: [TypeExpr], line: Int, col: Int) : Expr {
  let scrut = mk_ref("b", line, col)
  let pat_subs = derive_eq_sum_pat_subs("lb_", vargs, 0, line, col)
  let match_pat = mk_pat(PVariant(None, name, pat_subs), line, col)
  let body = derive_eq_sum_field_chain(vargs, 0, line, col)
  let arm_match = Arm(match_pat, None, body)
  let arm_wild  = Arm(mk_pat(PWild, line, col), None,
                      mk_expr(EBool(false), line, col))
  mk_expr(EMatch(scrut, [arm_match, arm_wild]), line, col)
}

fn derive_eq_sum_pat_subs(prefix: String, vargs: [TypeExpr], i: Int,
                           line: Int, col: Int) : [Pattern] {
  match vargs {
    [] -> []
    [_, ...rest] ->
      [mk_pat(PBind(concat_all([prefix, int_to_string(i)])), line, col),
       ...derive_eq_sum_pat_subs(prefix, rest, i + 1, line, col)]
  }
}

fn derive_eq_sum_field_chain(vargs: [TypeExpr], i: Int, line: Int, col: Int) : Expr {
  match vargs {
    [] -> mk_expr(EBool(true), line, col)
    [_, ...rest] -> {
      let l = mk_ref(concat_all(["la_", int_to_string(i)]), line, col)
      let r = mk_ref(concat_all(["lb_", int_to_string(i)]), line, col)
      let call = mk_expr(ECall(mk_ref("eq", line, col), [l, r]), line, col)
      match rest {
        [] -> call
        _  -> {
          let tail = derive_eq_sum_field_chain(rest, i + 1, line, col)
          mk_expr(EBinop(BoAnd, call, tail), line, col)
        }
      }
    }
  }
}

fn derive_hash_impl(tname: String, body: TypeBody, line: Int, col: Int) : Option[Decl] {
  match body {
    TBRecord(fields) -> {
      let body_expr = derive_hash_record_body(fields, line, col)
      Some(make_derived_impl("Hash", tname, "hash",
        [Param { pname: "x", ptype: Some(mk_ty(TyName(ty_ref_none(), tname, []), line, col)),
                 pline: line, pcol: col, pborrow: false }],
        mk_ty(TyName(ty_ref_none(), "Int", []), line, col),
        body_expr, line, col))
    }
    TBSum(variants) -> {
      let body_expr = derive_hash_sum_body(variants, line, col)
      Some(make_derived_impl("Hash", tname, "hash",
        [Param { pname: "x", ptype: Some(mk_ty(TyName(ty_ref_none(), tname, []), line, col)),
                 pline: line, pcol: col, pborrow: false }],
        mk_ty(TyName(ty_ref_none(), "Int", []), line, col),
        body_expr, line, col))
    }
    _ -> None
  }
}

fn derive_hash_record_body(fields: [FieldDecl], line: Int, col: Int) : Expr {
  match fields {
    [] -> mk_expr(mk_int_synth(0), line, col)
    [fd, ...rest] -> derive_hash_record_chain(fd, rest, line, col)
  }
}

fn derive_hash_record_chain(head: FieldDecl, rest: [FieldDecl], line: Int, col: Int) : Expr {
  match head {
    FD(_, name, _, _) -> {
      let access = mk_expr(EField(mk_ref("x", line, col), name), line, col)
      let call = mk_expr(ECall(mk_ref("hash", line, col), [access]), line, col)
      match rest {
        [] -> call
        [next, ...more] -> {
          let tail_e = derive_hash_record_chain(next, more, line, col)
          let mul = mk_expr(EBinop(BoMul, call, mk_expr(mk_int_synth(31), line, col)), line, col)
          mk_expr(EBinop(BoAdd, mul, tail_e), line, col)
        }
      }
    }
  }
}

# m12.8.x: `#derive(Hash)` on a sum type. Match on the value, one arm
# per variant; each arm seeds the running accumulator with the
# variant's 1-based tag and folds in `hash(field)` using the same
# `acc * 31 + h` combination the record helper uses, so two values
# that are eq via the derived Eq hash to the same Int.
fn derive_hash_sum_body(variants: [Variant], line: Int, col: Int) : Expr {
  match variants {
    [] -> mk_expr(mk_int_synth(0), line, col)
    _  -> {
      let scrut = mk_ref("x", line, col)
      let arms = derive_hash_sum_arms(variants, 1, line, col)
      mk_expr(EMatch(scrut, arms), line, col)
    }
  }
}

fn derive_hash_sum_arms(vs: [Variant], tag: Int, line: Int, col: Int) : [Arm] {
  match vs {
    [] -> []
    [v, ...rest] ->
      [derive_hash_sum_arm(v, tag, line, col),
       ...derive_hash_sum_arms(rest, tag + 1, line, col)]
  }
}

fn derive_hash_sum_arm(v: Variant, tag: Int, line: Int, col: Int) : Arm {
  match v {
    Var(name, vargs) -> {
      let pat_subs = derive_eq_sum_pat_subs("h_", vargs, 0, line, col)
      let pat = mk_pat(PVariant(None, name, pat_subs), line, col)
      let body = derive_hash_sum_arm_body(vargs, tag, line, col)
      Arm(pat, None, body)
    }
  }
}

fn derive_hash_sum_arm_body(vargs: [TypeExpr], tag: Int, line: Int, col: Int) : Expr {
  let head = mk_expr(mk_int_synth(tag), line, col)
  derive_hash_sum_chain(head, vargs, 0, line, col)
}

fn derive_hash_sum_chain(acc: Expr, vargs: [TypeExpr], i: Int,
                          line: Int, col: Int) : Expr {
  match vargs {
    [] -> acc
    [_, ...rest] -> {
      let v = mk_ref(concat_all(["h_", int_to_string(i)]), line, col)
      let h = mk_expr(ECall(mk_ref("hash", line, col), [v]), line, col)
      let mul = mk_expr(EBinop(BoMul, acc, mk_expr(mk_int_synth(31), line, col)), line, col)
      let next = mk_expr(EBinop(BoAdd, mul, h), line, col)
      derive_hash_sum_chain(next, rest, i + 1, line, col)
    }
  }
}

# m12.8.z: `#derive(Ord)` synthesises three methods to satisfy the
# stdlib `protocol Ord { cmp, min, max }`:
#
#   - `cmp(a, b) : Int` — the load-bearing comparator. Records are
#     lexicographic (compare each field in declaration order, return
#     the first non-zero); sum types are variants-by-position with a
#     payload-lexicographic tie-breaker inside the same variant.
#   - `min(a, b) : Self` — `if cmp(a, b) <= 0 { a } else { b }`,
#     derived from the synthesised `cmp` above.
#   - `max(a, b) : Self` — `if cmp(a, b) >= 0 { a } else { b }`.
#
# `cmp` delegates to each field/payload's own `cmp`, so the typer
# transitively rejects the derive if any sub-component lacks an
# `Ord` impl — naming the missing call site in the diagnostic.
# `min` and `max` only call the just-synthesised `cmp`, so they
# carry no extra requirement on sub-types.
fn derive_ord_impl(tname: String, body: TypeBody, line: Int, col: Int) : Option[Decl] {
  match body {
    TBRecord(fields) ->
      Some(derive_ord_make_impl(tname, derive_ord_record_body(fields, line, col), line, col))
    TBSum(variants) ->
      Some(derive_ord_make_impl(tname, derive_ord_sum_body(variants, line, col), line, col))
    _ -> None
  }
}

# Build the three-method `impl Ord for T` given a ready-to-use `cmp`
# body expression. Factored out so the record / sum arms above share
# the impl assembly, and so `min` / `max` are produced in one place.
fn derive_ord_make_impl(tname: String, cmp_body: Expr, line: Int, col: Int) : Decl {
  let self_ty = mk_ty(TyName(ty_ref_none(), tname, []), line, col)
  let int_ty = mk_ty(TyName(ty_ref_none(), "Int", []), line, col)
  let params2 = [
    Param { pname: "a", ptype: Some(self_ty), pline: line, pcol: col, pborrow: false },
    Param { pname: "b", ptype: Some(self_ty), pline: line, pcol: col, pborrow: false }
  ]
  let cmp_method = DFn(false, "cmp", [], params2, Some(int_ty), REmpty,
                          cmp_body, line, col, None, fnid_none())
  # Body of min: `if cmp(a, b) <= 0 { a } else { b }`.
  # Body of max: `if cmp(a, b) >= 0 { a } else { b }`.
  let a_var = mk_ref("a", line, col)
  let b_var = mk_ref("b", line, col)
  let zero = mk_expr(mk_int_synth(0), line, col)
  let cmp_call_min = mk_expr(ECall(mk_ref("cmp", line, col),
                                       [a_var, b_var]), line, col)
  let cmp_call_max = mk_expr(ECall(mk_ref("cmp", line, col),
                                       [a_var, b_var]), line, col)
  let min_body = mk_expr(EIf(
    mk_expr(EBinop(BoLe, cmp_call_min, zero), line, col),
    a_var, Some(b_var)), line, col)
  let max_body = mk_expr(EIf(
    mk_expr(EBinop(BoGe, cmp_call_max, zero), line, col),
    a_var, Some(b_var)), line, col)
  let min_method = DFn(false, "min", [], params2, Some(self_ty), REmpty,
                          min_body, line, col, None, fnid_none())
  let max_method = DFn(false, "max", [], params2, Some(self_ty), REmpty,
                          max_body, line, col, None, fnid_none())
  DImpl("Ord", [], self_ty, [cmp_method, min_method, max_method], line, col, [], sym_none())
}

fn derive_ord_record_body(fields: [FieldDecl], line: Int, col: Int) : Expr {
  match fields {
    [] -> mk_expr(mk_int_synth(0), line, col)
    [fd, ...rest] -> derive_ord_record_chain(fd, rest, 0, line, col)
  }
}

fn derive_ord_record_chain(head: FieldDecl, rest: [FieldDecl], idx: Int,
                            line: Int, col: Int) : Expr {
  match head {
    FD(_, name, _, _) -> {
      let l_access = mk_expr(EField(mk_ref("a", line, col), name), line, col)
      let r_access = mk_expr(EField(mk_ref("b", line, col), name), line, col)
      let cmp_call = mk_expr(ECall(mk_ref("cmp", line, col),
                                    [l_access, r_access]),
                             line, col)
      match rest {
        [] -> cmp_call
        [next, ...more] -> {
          let cvar = concat_all(["c", int_to_string(idx)])
          let pat = mk_pat(PBind(cvar), line, col)
          let let_stmt = SLet(pat, None, cmp_call)
          let cond = mk_expr(EBinop(BoNe, mk_ref(cvar, line, col),
                                          mk_expr(mk_int_synth(0), line, col)),
                             line, col)
          let then_e = mk_ref(cvar, line, col)
          let else_e = derive_ord_record_chain(next, more, idx + 1, line, col)
          let if_e = mk_expr(EIf(cond, then_e, Some(else_e)), line, col)
          mk_expr(EBlock([let_stmt], Some(if_e)), line, col)
        }
      }
    }
  }
}

fn derive_ord_sum_body(variants: [Variant], line: Int, col: Int) : Expr {
  let scrut = mk_ref("a", line, col)
  let arms = derive_ord_sum_outer_arms(variants, variants, 0, line, col)
  mk_expr(EMatch(scrut, arms), line, col)
}

fn derive_ord_sum_outer_arms(remaining: [Variant], all_variants: [Variant],
                              idx: Int, line: Int, col: Int) : [Arm] {
  match remaining {
    [] -> []
    [v, ...rest] -> {
      let arm = derive_ord_sum_outer_arm(v, all_variants, idx, line, col)
      [arm, ...derive_ord_sum_outer_arms(rest, all_variants, idx + 1, line, col)]
    }
  }
}

fn derive_ord_sum_outer_arm(outer_v: Variant, all_variants: [Variant],
                             outer_idx: Int, line: Int, col: Int) : Arm {
  match outer_v {
    Var(name, vargs) -> {
      let outer_pat_subs = derive_ord_sum_pat_subs(vargs, "a", 0, line, col)
      let outer_pat = mk_pat(PVariant(None, name, outer_pat_subs), line, col)
      let inner = derive_ord_sum_inner_match(outer_v, outer_idx,
                                              all_variants, line, col)
      Arm(outer_pat, None, inner)
    }
  }
}

# Like `derive_sum_pat_subs`, but lets the caller pick the binder
# prefix so the inner match can use `b0/b1/...` instead of `a0/a1/...`.
fn derive_ord_sum_pat_subs(vargs: [TypeExpr], prefix: String, i: Int,
                            line: Int, col: Int) : [Pattern] {
  match vargs {
    [] -> []
    [_, ...rest] ->
      [mk_pat(PBind(concat_all([prefix, int_to_string(i)])), line, col),
       ...derive_ord_sum_pat_subs(rest, prefix, i + 1, line, col)]
  }
}

fn derive_ord_sum_inner_match(outer_v: Variant, outer_idx: Int,
                               all_variants: [Variant], line: Int, col: Int) : Expr {
  let scrut = mk_ref("b", line, col)
  let arms = derive_ord_sum_inner_arms(outer_v, outer_idx, all_variants,
                                        0, line, col)
  mk_expr(EMatch(scrut, arms), line, col)
}

# Generates the inner-match arms for one outer variant. For each
# variant in the type's declaration, with index `idx`:
#   - idx <  outer_idx → that variant comes earlier in declaration
#                         order, so `cmp(outer, that) == 1`. Emit an
#                         explicit `Variant(_, _, ...) -> 1` arm.
#   - idx == outer_idx → same variant: emit `Variant(b0, b1, ...) ->
#                         <payload chain>`. After the self arm, fold
#                         every later variant under a single
#                         `_ -> -1` wildcard and stop.
fn derive_ord_sum_inner_arms(outer_v: Variant, outer_idx: Int,
                              variants: [Variant], idx: Int,
                              line: Int, col: Int) : [Arm] {
  match variants {
    [] -> []
    [v, ...rest] -> {
      if idx < outer_idx {
        let arm = derive_ord_sum_wild_arm(v, 1, line, col)
        [arm, ...derive_ord_sum_inner_arms(outer_v, outer_idx, rest,
                                            idx + 1, line, col)]
      } else if idx == outer_idx {
        let self_arm = derive_ord_sum_self_arm(outer_v, line, col)
        match rest {
          [] -> [self_arm]
          _  -> [self_arm, derive_ord_sum_default_arm(-1, line, col)]
        }
      } else {
        # Defensive: outer_idx is always within bounds, so this
        # branch is unreachable. Returning [] keeps the recursion
        # well-typed without an extra `panic`.
        []
      }
    }
  }
}

# `Variant(_, _, ...) -> <int>` — used for variants on the "wrong"
# side of the outer-vs-inner comparison.
fn derive_ord_sum_wild_arm(v: Variant, ret: Int, line: Int, col: Int) : Arm {
  match v {
    Var(name, vargs) -> {
      let pats = derive_ord_sum_wild_pats(vargs, line, col)
      let pat = mk_pat(PVariant(None, name, pats), line, col)
      Arm(pat, None, mk_expr(mk_int_synth(ret), line, col))
    }
  }
}

fn derive_ord_sum_wild_pats(vargs: [TypeExpr], line: Int, col: Int) : [Pattern] {
  match vargs {
    [] -> []
    [_, ...rest] ->
      [mk_pat(PWild, line, col),
       ...derive_ord_sum_wild_pats(rest, line, col)]
  }
}

# `_ -> <int>` — covers every variant after the outer's position.
fn derive_ord_sum_default_arm(ret: Int, line: Int, col: Int) : Arm {
  Arm(mk_pat(PWild, line, col), None, mk_expr(mk_int_synth(ret), line, col))
}

# `Variant(b0, b1, ...) -> <payload chain>` — the same-variant case.
# Payloads are compared field-by-field in declaration order; the
# first non-zero `cmp` wins.
fn derive_ord_sum_self_arm(v: Variant, line: Int, col: Int) : Arm {
  match v {
    Var(name, vargs) -> {
      let inner_pat_subs = derive_ord_sum_pat_subs(vargs, "b", 0, line, col)
      let pat = mk_pat(PVariant(None, name, inner_pat_subs), line, col)
      let body = derive_ord_payload_chain(vargs, 0, line, col)
      Arm(pat, None, body)
    }
  }
}

fn derive_ord_payload_chain(vargs: [TypeExpr], idx: Int,
                             line: Int, col: Int) : Expr {
  match vargs {
    [] -> mk_expr(mk_int_synth(0), line, col)
    [_, ...rest] -> {
      let av = mk_ref(concat_all(["a", int_to_string(idx)]), line, col)
      let bv = mk_ref(concat_all(["b", int_to_string(idx)]), line, col)
      let cmp_call = mk_expr(ECall(mk_ref("cmp", line, col), [av, bv]),
                             line, col)
      match rest {
        [] -> cmp_call
        _  -> {
          let cvar = concat_all(["p", int_to_string(idx)])
          let pat = mk_pat(PBind(cvar), line, col)
          let let_stmt = SLet(pat, None, cmp_call)
          let cond = mk_expr(EBinop(BoNe, mk_ref(cvar, line, col),
                                          mk_expr(mk_int_synth(0), line, col)),
                             line, col)
          let then_e = mk_ref(cvar, line, col)
          let else_e = derive_ord_payload_chain(rest, idx + 1, line, col)
          let if_e = mk_expr(EIf(cond, then_e, Some(else_e)), line, col)
          mk_expr(EBlock([let_stmt], Some(if_e)), line, col)
        }
      }
    }
  }
}

fn make_derived_impl(pname: String, tname: String, opname: String,
                      params: [Param], ret: TypeExpr, body: Expr,
                      line: Int, col: Int) : Decl {
  let method = DFn(false, opname, [], params, Some(ret), REmpty, body, line, col, None, fnid_none())
  DImpl(pname, [], mk_ty(TyName(ty_ref_none(), tname, []), line, col), [method], line, col, [], sym_none())
}

# `#[derive(BinSerialize)]` for records and sum types: the impl, the
# type's writer, and a top-level `<lower(tname)>_from_bytes` shim.
# Decoding calls `__pimpl_BinSerialize_<Head>_from_bytes` directly:
# single dispatch picks the impl from the first argument, which for
# `from_bytes(buf, pos)` is the buffer.
fn derive_binserialize_impl(tname: String, shown: String, body: TypeBody,
                              writers: [String], line: Int, col: Int) : [Decl] {
  match body {
    TBRecord(fields) -> {
      let put = derive_binser_put_record(mk_ref("buf", line, col), fields, 0, writers, line, col)
      let from_b = derive_binser_record_from_bytes(tname, fields, line, col)
      derive_binser_decls(tname, shown, put, from_b, line, col)
    }
    TBSum(variants) -> {
      let put = derive_binser_put_sum(variants, writers, line, col)
      let from_b = derive_binser_sum_from_bytes(tname, variants, line, col)
      derive_binser_decls(tname, shown, put, from_b, line, col)
    }
    _ -> []
  }
}

fn derive_binser_decls(tname: String, shown: String, put: Expr, from_b: Expr,
                        line: Int, col: Int) : [Decl] =
  [make_binser_impl(tname, derive_binser_to_bytes(tname, line, col), from_b, line, col),
   derive_binser_put_fn(tname, put, line, col),
   derive_binser_shim(tname, shown, line, col)]

# `bin_buf_bytes(<writer>(bin_buf_new(), self))`: the writer over a fresh
# buffer. The masking pass keeps this pure because a derived writer
# mutates only its buffer (`writes_only_first_arg`).
fn derive_binser_to_bytes(tname: String, line: Int, col: Int) : Expr {
  let fresh = binser_call("bin_buf_new", [], line, col)
  let put = binser_call(binser_put_name(tname), [fresh, mk_ref("self", line, col)], line, col)
  binser_call("bin_buf_bytes", [put], line, col)
}

# `fn <writer>(buf: BinBuf, self: T) : BinBuf / Mutable` appends `self`
# to `buf`. Nested derived values are written into the same buffer, so
# encoding a recursive value is linear in its size.
fn derive_binser_put_fn(tname: String, body: Expr, line: Int, col: Int) : Decl {
  let buf_ty = mk_ty(TyName(ty_ref_none(), "BinBuf", []), line, col)
  let self_ty = mk_ty(TyName(ty_ref_none(), tname, []), line, col)
  let params = [Param { pname: "buf", ptype: Some(buf_ty), pline: line, pcol: col, pborrow: false },
                Param { pname: "self", ptype: Some(self_ty), pline: line, pcol: col, pborrow: false }]
  DFn(false, binser_put_name(tname), [], params, Some(buf_ty),
      RClosed([core_effect_row_label(CeMutable)]), body, line, col, None, fnid_none())
}

fn binser_put_name(tname: String) : String = concat_all([derived_writer_prefix(), tname])

fn binser_call(name: String, args: [Expr], line: Int, col: Int) : Expr =
  mk_expr(ECall(mk_ref(name, line, col), args), line, col)

# `impl BinSerialize for T { fn to_bytes ... fn from_bytes ... }`
#
# Uses `Array[Byte]` for the buffer carrier so `from_bytes` reads land
# on O(1) `array_get` — the substrate the Phase A cache (#452)
# requires, per the #487 refactor. `Byte` is a first-class nominal
# primitive after Lane 4 + PR #476; the previous `Byte = Int`
# transparent alias is gone. `byte_to_int` / `int_to_byte` are the
# explicit conversions when interoperating with `Int` data.
fn make_binser_impl(tname: String, to_b: Expr, from_b: Expr,
                     line: Int, col: Int) : Decl {
  let self_ty = mk_ty(TyName(ty_ref_none(), tname, []), line, col)
  let byte_arr = mk_ty(TyName(ty_ref_none(), "Array", [mk_ty(TyName(ty_ref_none(), "Byte", []), line, col)]), line, col)
  let int_ty = mk_ty(TyName(ty_ref_none(), "Int", []), line, col)
  let str_ty = mk_ty(TyName(ty_ref_none(), "String", []), line, col)
  let cur_ty = mk_ty(TyName(ty_ref_none(), "BinCursor", [self_ty]), line, col)
  let res_ty = mk_ty(TyName(ty_ref_none(), "Result", [cur_ty, str_ty]), line, col)
  let to_params = [Param { pname: "self", ptype: Some(self_ty),
                            pline: line, pcol: col, pborrow: false }]
  let from_params = [Param { pname: "buf", ptype: Some(byte_arr),
                              pline: line, pcol: col, pborrow: false },
                     Param { pname: "pos", ptype: Some(int_ty),
                              pline: line, pcol: col, pborrow: false }]
  let to_method = DFn(false, "to_bytes", [], to_params, Some(byte_arr),
                      REmpty, to_b, line, col, None, fnid_none())
  let from_method = DFn(false, "from_bytes", [], from_params, Some(res_ty),
                        REmpty, from_b, line, col, None, fnid_none())
  DImpl("BinSerialize", [], self_ty, [to_method, from_method], line, col, [], sym_none())
}

# `fn <lower(tname)>_from_bytes(buf: Array[Byte], pos: Int)
#       : Result[BinCursor[T], String]`
# wrapping the mangled per-impl name. The shim decouples the user's
# call site from the dispatcher's first-arg constraint and gives the
# diagnostic stack a stable function name when the decode fails.
fn derive_binser_shim(tname: String, shown: String, line: Int, col: Int) : Decl {
  let self_ty = mk_ty(TyName(ty_ref_none(), tname, []), line, col)
  let byte_arr = mk_ty(TyName(ty_ref_none(), "Array", [mk_ty(TyName(ty_ref_none(), "Byte", []), line, col)]), line, col)
  let int_ty = mk_ty(TyName(ty_ref_none(), "Int", []), line, col)
  let str_ty = mk_ty(TyName(ty_ref_none(), "String", []), line, col)
  let cur_ty = mk_ty(TyName(ty_ref_none(), "BinCursor", [self_ty]), line, col)
  let res_ty = mk_ty(TyName(ty_ref_none(), "Result", [cur_ty, str_ty]), line, col)
  let params = [Param { pname: "buf", ptype: Some(byte_arr),
                         pline: line, pcol: col, pborrow: false },
                Param { pname: "pos", ptype: Some(int_ty),
                         pline: line, pcol: col, pborrow: false }]
  let mangled = proto_mangled_fn("BinSerialize", tname, "from_bytes")
  let body = mk_expr(ECall(mk_ref(mangled, line, col),
                            [mk_ref("buf", line, col),
                             mk_ref("pos", line, col)]),
                     line, col)
  DFn(true, concat_all([string_to_lower_ascii(shown), "_from_bytes"]),
      [], params, Some(res_ty), REmpty, body, line, col, None, fnid_none())
}

# Lowercase every ASCII byte of `tname` so the shim name
# (`<lower(tname)>_from_bytes`) is a valid all-lowercase identifier
# even for types like `Point`, `MyAST`, or `IntMaybe`. We do NOT
# insert underscores between cased segments — the simple form
# `intmaybe_from_bytes`, `myast_from_bytes` is unambiguous and
# avoids tangling with the snake_case convention enforced
# elsewhere by the resolver. Non-ASCII bytes pass through.
#[doc("ASCII-only lowercaser; used by the emitter to fold effect names.")]
pub fn string_to_lower_ascii(s: String) : String =
  string_to_lower_ascii_loop(s, 0, string_length(s), "")

fn string_to_lower_ascii_loop(s: String, i: Int, n: Int, acc: String) : String = {
  if i >= n { acc }
  else { match char_at(s, i) {
    None    -> acc
    Some(c) -> {
      let nc = char_to_int(c)
      let lc = if nc >= 65 and nc <= 90 { int_to_char(nc + 32) } else { c }
      string_to_lower_ascii_loop(s, i + 1, n, string_concat(acc, "#{lc}"))
    }
  } }
}

# --- field writers / decoders ---------------------------------------
#
# A field of a derived type is written by that type's writer; `[T]`,
# `Option[T]` and `Char` go through the `bin_buf_*` combinators (their
# heads have no usable single-dispatch impl); anything else appends its
# `to_bytes`. Decoding mirrors this through
# `__pimpl_BinSerialize_<Head>_from_bytes` and the `bin_*_from_bytes`
# combinators, recursing into element types so `[[Int]]` stacks lambdas.
#
# The lambda lifter keys each lambda by its `(line, col)` and a derive
# only has the type's position, so every synthesised lambda gets its own
# column: 16 per field (callers), 8 per nesting depth, and offsets 1 / 5
# for writer / decoder lambdas.
fn derive_binser_put(acc: Expr, v: Expr, ftype: TypeExpr, writers: [String],
                      line: Int, col: Int) : Expr =
  derive_binser_put_at(acc, v, ftype, writers, line, col, 0)

fn derive_binser_put_at(acc: Expr, v: Expr, ftype: TypeExpr, writers: [String],
                         line: Int, col: Int, depth: Int) : Expr {
  match ftype.tkind {
    TyList(elem) -> derive_binser_put_via("bin_buf_put_list", acc, v, elem, writers, line, col, depth)
    _ -> match binser_option_elem(ftype) {
      Some(elem) -> derive_binser_put_via("bin_buf_put_option", acc, v, elem, writers, line, col, depth)
      None       -> derive_binser_put_leaf(acc, v, ftype, writers, line, col)
    }
  }
}

# The element of a written `Option[elem]`.
fn binser_option_elem(ftype: TypeExpr) : Option[TypeExpr] = match ftype.tkind {
  TyName(_, _, [elem]) -> match resolve_ty(ftype) {
    TyCon(_, _, _, s) -> if core_ty_is(s, CtOption) { Some(elem) } else { None }
    _                 -> None
  }
  _ -> None
}

# What a field dispatches on: its resolved type under any unit or refinement.
fn binser_leaf_ty(t: Ty) : Ty = match t {
  TyDimT(b, _)    -> binser_leaf_ty(b)
  TyRefineT(b, _) -> binser_leaf_ty(b)
  _               -> t
}

# `<comb>(acc, v, (__bw, __bx) => <write __bx of type elem into __bw>)`.
fn derive_binser_put_via(comb: String, acc: Expr, v: Expr, elem: TypeExpr, writers: [String],
                          line: Int, col: Int, depth: Int) : Expr {
  let lcol = col + depth * 8 + 1
  let bw = Param { pname: "__bw", ptype: None, pline: line, pcol: lcol, pborrow: false }
  let bx = Param { pname: "__bx", ptype: None, pline: line, pcol: lcol, pborrow: false }
  let body = derive_binser_put_at(mk_ref("__bw", line, lcol), mk_ref("__bx", line, lcol),
                                  elem, writers, line, col, depth + 1)
  binser_call(comb, [acc, v, mk_expr(ELambda([bw, bx], body), line, lcol)], line, col)
}

# A primitive leaf is written straight into the buffer. Any other head
# appends its mangled per-type encoder, not the `to_bytes` dispatcher:
# inside a combinator's lambda the monomorpher does not carry the
# instantiated type to the dispatcher call.
fn derive_binser_put_leaf(acc: Expr, v: Expr, ftype: TypeExpr, writers: [String],
                           line: Int, col: Int) : Expr {
  let head = proto_type_name(ftype)
  if list_has(writers, head) {
    binser_call(binser_put_name(head), [acc, v], line, col)
  } else {
    match binser_prim_writer(binser_leaf_ty(resolve_ty(ftype))) {
      Some(w) -> binser_call(w, [acc, v], line, col)
      None    -> {
        let enc = proto_mangled_fn("BinSerialize", head, "to_bytes")
        binser_call("bin_buf_put", [acc, binser_call(enc, [v], line, col)], line, col)
      }
    }
  }
}

fn binser_prim_writer(leaf: Ty) : Option[String] = match leaf {
  TyInt    -> Some("bin_buf_put_int")
  TyString -> Some("bin_buf_put_string")
  TyBool   -> Some("bin_buf_put_bool")
  TyReal   -> Some("bin_buf_put_real")
  TyChar   -> Some("bin_buf_put_char")
  _        -> None
}

fn derive_binser_decode_call(buf_e: Expr, pos_e: Expr, ftype: TypeExpr,
                               line: Int, col: Int) : Expr =
  derive_binser_decode_call_at(buf_e, pos_e, ftype, line, col, 0)

fn derive_binser_decode_call_at(buf_e: Expr, pos_e: Expr, ftype: TypeExpr,
                                  line: Int, col: Int, depth: Int) : Expr {
  match ftype.tkind {
    TyList(elem) -> {
      let lcol = col + depth * 8 + 5
      let bparam = Param { pname: "__bb", ptype: None, pline: line, pcol: lcol, pborrow: false }
      let pparam = Param { pname: "__bp", ptype: None, pline: line, pcol: lcol, pborrow: false }
      let bvar = mk_ref("__bb", line, lcol)
      let pvar = mk_ref("__bp", line, lcol)
      let body = derive_binser_decode_call_at(bvar, pvar, elem, line, col,
                                                depth + 1)
      let dec_lam = mk_expr(ELambda([bparam, pparam], body), line, lcol)
      mk_expr(ECall(mk_ref("bin_list_from_bytes", line, col),
                    [buf_e, pos_e, dec_lam]), line, col)
    }
    TyName(_, _, _) -> match binser_option_elem(ftype) {
      Some(elem) -> {
        let lcol = col + depth * 8 + 5
        let bparam = Param { pname: "__bb", ptype: None, pline: line, pcol: lcol, pborrow: false }
        let pparam = Param { pname: "__bp", ptype: None, pline: line, pcol: lcol, pborrow: false }
        let bvar = mk_ref("__bb", line, lcol)
        let pvar = mk_ref("__bp", line, lcol)
        let body = derive_binser_decode_call_at(bvar, pvar, elem, line, col,
                                                  depth + 1)
        let dec_lam = mk_expr(ELambda([bparam, pparam], body), line, lcol)
        mk_expr(ECall(mk_ref("bin_option_from_bytes", line, col),
                      [buf_e, pos_e, dec_lam]), line, col)
      }
      None -> match resolve_ty(ftype) {
        TyChar -> mk_expr(ECall(mk_ref("bin_char_from_bytes", line, col),
                                [buf_e, pos_e]), line, col)
        _      -> derive_binser_decode_mangled(buf_e, pos_e, ftype, line, col)
      }
    }
    _ -> derive_binser_decode_mangled(buf_e, pos_e, ftype, line, col)
  }
}

fn derive_binser_decode_mangled(buf_e: Expr, pos_e: Expr, ftype: TypeExpr,
                                  line: Int, col: Int) : Expr {
  let mangled = proto_mangled_fn("BinSerialize",
                                   proto_type_name(ftype), "from_bytes")
  mk_expr(ECall(mk_ref(mangled, line, col), [buf_e, pos_e]), line, col)
}

# --- record writer --------------------------------------------------
#
# Each field's writer receives the buffer the previous field's returned.
fn derive_binser_put_record(acc: Expr, fields: [FieldDecl], idx: Int, writers: [String],
                             line: Int, col: Int) : Expr {
  match fields {
    [] -> acc
    [fd, ...rest] -> match fd {
      FD(_, name, ftype, _) -> {
        let fcol = col + idx * 16
        let v = mk_expr(EField(mk_ref("self", line, fcol), name), line, fcol)
        derive_binser_put_record(derive_binser_put(acc, v, ftype, writers, line, fcol),
                                 rest, idx + 1, writers, line, col)
      }
    }
  }
}

# --- field decoders -------------------------------------------------
#
# Field K at cursor `posK` is either a primitive leaf, validated with
# `let eK = bin_<t>_end(buf, posK)` and read in place by `bin_<t>_at`
# when the value is built, or any other type, matched out of
# `__pimpl_BinSerialize_<Tk>_from_bytes(buf, posK)` into `pK`.
fn derive_binser_field_guard(ftype: TypeExpr, idx: Int, pos_e: Expr, then_e: Expr,
                               line: Int, fcol: Int, col: Int) : Expr {
  let buf_e = mk_ref("buf", line, fcol)
  match binser_prim_reader(ftype) {
    Some(r) -> {
      let evar = binser_end_var(idx)
      let end_e = binser_call(binser_prim_end(r), [buf_e, pos_e], line, col)
      let bad = mk_expr(EBinop(BoLt, mk_ref(evar, line, col), mk_expr(mk_int_synth(0), line, col)), line, col)
      let err = binser_call("Err", [binser_call("bin_end_error", [mk_ref(evar, line, col)], line, col)], line, col)
      let bind = SLet(mk_pat(PBind(evar), line, col), None, end_e)
      mk_expr(EBlock([bind], Some(mk_expr(EIf(bad, err, Some(then_e)), line, col))), line, col)
    }
    None -> derive_binser_match_result(derive_binser_decode_call(buf_e, pos_e, ftype, line, fcol),
                                       binser_cursor_var(idx), then_e, line, col)
  }
}

# The cursor just past field `idx`.
fn derive_binser_field_next(ftype: TypeExpr, idx: Int, line: Int, col: Int) : Expr =
  match binser_prim_reader(ftype) {
    Some(_) -> mk_ref(binser_end_var(idx), line, col)
    None    -> mk_expr(EField(mk_ref(binser_cursor_var(idx), line, col), "pos"), line, col)
  }

# The decoded value of field `idx`, which starts at `pos_e`.
fn derive_binser_field_value(ftype: TypeExpr, idx: Int, pos_e: Expr, line: Int, col: Int) : Expr =
  match binser_prim_reader(ftype) {
    Some(r) -> binser_call(binser_prim_at(r), [mk_ref("buf", line, col), pos_e], line, col)
    None    -> mk_expr(EField(mk_ref(binser_cursor_var(idx), line, col), "value"), line, col)
  }

# The values of `ftypes`, the first starting at `pos_e`.
fn derive_binser_field_values(ftypes: [TypeExpr], idx: Int, pos_e: Expr,
                                line: Int, col: Int) : [Expr] =
  match ftypes {
    [] -> []
    [ft, ...rest] ->
      [derive_binser_field_value(ft, idx, pos_e, line, col),
       ...derive_binser_field_values(rest, idx + 1, derive_binser_field_next(ft, idx, line, col), line, col)]
  }

fn binser_cursor_var(idx: Int) : String = concat_all(["p", int_to_string(idx)])

fn binser_end_var(idx: Int) : String = concat_all(["__e", int_to_string(idx)])

# A primitive leaf's reader family (`Char` reads its codepoint through
# `Int`'s validator). `Real` decodes through its impl: its payload can
# fail to parse after it validates.
type BinPrim = BpInt | BpBool | BpString | BpChar

fn binser_prim_reader(ftype: TypeExpr) : Option[BinPrim] =
  match ftype.tkind {
    TyName(_, _, []) -> match resolve_ty(ftype) {
      TyInt    -> Some(BpInt)
      TyBool   -> Some(BpBool)
      TyString -> Some(BpString)
      TyChar   -> Some(BpChar)
      _        -> None
    }
    _ -> None
  }

fn binser_prim_word(r: BinPrim) : String = match r {
  BpInt    -> "int"
  BpBool   -> "bool"
  BpString -> "string"
  BpChar   -> "char"
}

fn binser_prim_end(r: BinPrim) : String = match r {
  BpChar -> "bin_int_end"
  _      -> concat_all(["bin_", binser_prim_word(r), "_end"])
}

fn binser_prim_at(r: BinPrim) : String = concat_all(["bin_", binser_prim_word(r), "_at"])

# --- record decoder -------------------------------------------------
#
# The field-decoder chain, ending in
# `Ok(BinCursor { value: T { f1: <value 0>, ... }, pos: <cursor N> })`.
#
# Empty record short-circuits to `Ok((T {}, pos))` so the empty-fields
# case still emits a valid impl.
fn derive_binser_record_from_bytes(tname: String, fields: [FieldDecl],
                                     line: Int, col: Int) : Expr {
  let pos0 = mk_ref("pos", line, col)
  match fields {
    [] -> derive_binser_record_ok_value(tname, [], pos0, line, col)
    _  -> derive_binser_record_decode_chain(tname, fields, fields, 0, pos0,
                                              line, col)
  }
}

# `remaining` walks left-to-right; `all_fields` is captured so the
# final `Ok` builder can construct the record literal in declaration
# order. `pos_e` is the cursor of the field at `idx`.
fn derive_binser_record_decode_chain(tname: String, remaining: [FieldDecl],
                                       all_fields: [FieldDecl], idx: Int,
                                       pos_e: Expr, line: Int, col: Int) : Expr {
  match remaining {
    [] -> derive_binser_record_ok_value(tname, all_fields, pos_e, line, col)
    [fd, ...rest] -> match fd {
      FD(_, _, ftype, _) -> {
        let then_e = derive_binser_record_decode_chain(tname, rest, all_fields, idx + 1,
                                                        derive_binser_field_next(ftype, idx, line, col),
                                                        line, col)
        # One column inside the field's writer slot, so writer and
        # decoder lambdas of one field stay distinct.
        derive_binser_field_guard(ftype, idx, pos_e, then_e, line, col + idx * 16 + 1, col)
      }
    }
  }
}

fn derive_binser_record_ok_value(tname: String, fields: [FieldDecl],
                                   pos_e: Expr, line: Int, col: Int) : Expr {
  let vals = derive_binser_field_values(map(fields, field_decl_type), 0, mk_ref("pos", line, col), line, col)
  let rec_e = mk_expr(ERecordLit(ty_ref_none(), tname, derive_binser_field_inits(fields, vals)), line, col)
  binser_ok_cursor(rec_e, pos_e, line, col)
}

fn derive_binser_field_inits(fields: [FieldDecl], vals: [Expr]) : [FieldInit] =
  match fields {
    [FD(_, name, _, _), ...rest] -> match vals {
      [v, ...vs] -> [FI(name, v), ...derive_binser_field_inits(rest, vs)]
      []         -> []
    }
    _ -> []
  }

fn field_decl_type(fd: FieldDecl) : TypeExpr = match fd { FD(_, _, t, _) -> t }

# `Ok(BinCursor { value: value_e, pos: pos_e })`.
fn binser_ok_cursor(value_e: Expr, pos_e: Expr, line: Int, col: Int) : Expr {
  let cur_e = mk_expr(ERecordLit(ty_ref_none(), "BinCursor", [FI("value", value_e), FI("pos", pos_e)]), line, col)
  binser_call("Ok", [cur_e], line, col)
}

# Wrap an `Err(m) -> Err(m); Ok(pvar) -> then_e` match around a
# Result-producing decode call.
fn derive_binser_match_result(call: Expr, pvar: String, then_e: Expr,
                                line: Int, col: Int) : Expr {
  let err_pat = mk_pat(PVariant(None, "Err", [mk_pat(PBind("m"), line, col)]),
                        line, col)
  let err_arm = Arm(err_pat, None,
                    mk_expr(ECall(mk_ref("Err", line, col),
                                  [mk_ref("m", line, col)]),
                            line, col))
  let ok_pat = mk_pat(PVariant(None, "Ok", [mk_pat(PBind(pvar), line, col)]),
                       line, col)
  let ok_arm = Arm(ok_pat, None, then_e)
  mk_expr(EMatch(call, [err_arm, ok_arm]), line, col)
}

# --- sum writer -----------------------------------------------------
#
# `match self { Vk(p0, ..) -> <payload written after bin_buf_byte(buf, k)> }`:
# the variant's declaration index as a one-byte tag, then its payload.
fn derive_binser_put_sum(variants: [Variant], writers: [String], line: Int, col: Int) : Expr {
  match variants {
    [] -> mk_ref("buf", line, col)
    _  -> mk_expr(EMatch(mk_ref("self", line, col),
                         derive_binser_put_arms(variants, 0, writers, line, col)), line, col)
  }
}

fn derive_binser_put_arms(variants: [Variant], idx: Int, writers: [String],
                           line: Int, col: Int) : [Arm] {
  match variants {
    [] -> []
    [v, ...rest] ->
      [derive_binser_put_arm(v, idx, writers, line, col),
       ...derive_binser_put_arms(rest, idx + 1, writers, line, col)]
  }
}

# Each variant takes a 256-column window so lambdas in different
# variants land at distinct positions.
fn derive_binser_put_arm(v: Variant, idx: Int, writers: [String],
                          line: Int, col: Int) : Arm {
  match v {
    Var(name, vargs) -> {
      let pat = mk_pat(PVariant(None, name, derive_binser_sum_pat_subs(vargs, "p", 0, line, col)),
                       line, col)
      let tag = binser_call("bin_buf_byte", [mk_ref("buf", line, col),
                                             mk_expr(mk_int_synth(idx), line, col)], line, col)
      Arm(pat, None, derive_binser_put_payload(tag, vargs, 0, writers, line, col + idx * 256))
    }
  }
}

fn derive_binser_sum_pat_subs(vargs: [TypeExpr], prefix: String, i: Int,
                                line: Int, col: Int) : [Pattern] {
  match vargs {
    [] -> []
    [_, ...rest] ->
      [mk_pat(PBind(concat_all([prefix, int_to_string(i)])), line, col),
       ...derive_binser_sum_pat_subs(rest, prefix, i + 1, line, col)]
  }
}

fn derive_binser_put_payload(acc: Expr, vargs: [TypeExpr], i: Int, writers: [String],
                              line: Int, col: Int) : Expr {
  match vargs {
    [] -> acc
    [vt, ...rest] -> {
      let fcol = col + i * 16
      let v = mk_ref(concat_all(["p", int_to_string(i)]), line, fcol)
      derive_binser_put_payload(derive_binser_put(acc, v, vt, writers, line, fcol),
                                rest, i + 1, writers, line, col)
    }
  }
}

# --- sum decoder ----------------------------------------------------
#
# `let __tag = bin_tag_at(buf, pos)
#  if __tag < 0 { Err(bin_end_error(__tag)) }
#  else if __tag == 0 { <decode V0 payload> }
#  ...
#  else { Err("BinSerialize <tname>: invalid tag") }`
#
# Each per-variant payload chain is the record-field chain, ending in
# the variant's constructor call.
fn derive_binser_sum_from_bytes(tname: String, variants: [Variant],
                                  line: Int, col: Int) : Expr {
  let tag_e = binser_call("bin_tag_at", [mk_ref("buf", line, col), mk_ref("pos", line, col)], line, col)
  let inner_pos = mk_expr(EBinop(BoAdd, mk_ref("pos", line, col),
                                       mk_expr(mk_int_synth(1), line, col)),
                           line, col)
  let chain = derive_binser_sum_tag_chain(tname, variants, 0, inner_pos,
                                            line, col)
  let bad = mk_expr(EBinop(BoLt, mk_ref("__tag", line, col), mk_expr(mk_int_synth(0), line, col)), line, col)
  let err = binser_call("Err", [binser_call("bin_end_error", [mk_ref("__tag", line, col)], line, col)], line, col)
  let bind = SLet(mk_pat(PBind("__tag"), line, col), None, tag_e)
  mk_expr(EBlock([bind], Some(mk_expr(EIf(bad, err, Some(chain)), line, col))), line, col)
}

fn derive_binser_sum_tag_chain(tname: String, variants: [Variant], idx: Int,
                                  start_pos: Expr, line: Int, col: Int) : Expr {
  match variants {
    [] -> mk_expr(ECall(mk_ref("Err", line, col),
                         [mk_expr(EStr(concat_all(
                            ["\"BinSerialize ", tname, ": invalid tag\""]),
                            false), line, col)]),
                   line, col)
    [v, ...rest] -> {
      let cond = mk_expr(EBinop(BoEq, mk_ref("__tag", line, col),
                                       mk_expr(mk_int_synth(idx), line, col)),
                          line, col)
      # The variant's writer window, shifted by half so writer and
      # decoder lambdas of one variant stay distinct.
      let vcol = col + idx * 256 + 128
      let then_e = derive_binser_sum_payload_decode(tname, v, start_pos,
                                                      line, vcol)
      let else_e = derive_binser_sum_tag_chain(tname, rest, idx + 1,
                                                  start_pos, line, col)
      mk_expr(EIf(cond, then_e, Some(else_e)), line, col)
    }
  }
}

# Same shape as record-decode chain, but the final `Ok` builds a
# constructor call instead of a record literal.
fn derive_binser_sum_payload_decode(tname: String, v: Variant,
                                      start_pos: Expr, line: Int, col: Int) : Expr {
  match v {
    Var(name, vargs) -> match vargs {
      [] -> binser_ok_cursor(mk_ref(name, line, col), start_pos, line, col)
      _  -> derive_binser_sum_decode_chain(name, vargs, vargs, 0, start_pos, start_pos,
                                             line, col)
    }
  }
}

fn derive_binser_sum_decode_chain(vname: String, remaining: [TypeExpr],
                                    all_vargs: [TypeExpr], idx: Int, start_pos: Expr,
                                    pos_e: Expr, line: Int, col: Int) : Expr {
  match remaining {
    [] -> {
      let args = derive_binser_field_values(all_vargs, 0, start_pos, line, col)
      binser_ok_cursor(binser_call(vname, args, line, col), pos_e, line, col)
    }
    [vt, ...rest] -> {
      let then_e = derive_binser_sum_decode_chain(vname, rest, all_vargs, idx + 1, start_pos,
                                                   derive_binser_field_next(vt, idx, line, col),
                                                   line, col)
      derive_binser_field_guard(vt, idx, pos_e, then_e, line, col + idx * 16 + 1, col)
    }
  }
}

# Pre-expansion validator for `#derive(BinSerialize)`. Same shape as
# `validate_derive_ord`: collect every type that has — or will have —
# a BinSerialize impl, then reject any derive whose fields/payloads
# reference a type outside that set. The type itself is whitelisted
# (recursive types are legal). The user gets a typer-time message
# pointing at the offending field instead of the dispatcher's
# generic runtime panic.
fn validate_derive_binserialize(decls: [Decl], df: DiagFiles) : [Diagnostic] / Console {

  let providers = collect_binser_types(decls, true, [])
  list_reverse(validate_derive_binser_loop(decls, df, providers, []))
}

# Types deriving BinSerialize, plus with `impls` those with a
# hand-written impl.
fn collect_binser_types(decls: [Decl], impls: Bool, acc: [String]) : [String] {
  match decls {
    [] -> acc
    [d, ...rest] -> match d {
      DImpl(pname, _, target, _, _, _, _, isym) ->
        if impls and spells_gen(pname, CpBinSerialize) {
          collect_binser_types(rest, impls, [proto_type_name(target), ...acc])
        } else {
          collect_binser_types(rest, impls, acc)
        }
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tname, _, _, _, _, _, _, _) ->
          if derives_gen(names, CpBinSerialize) {
            collect_binser_types(rest, impls, [tname, ...acc])
          } else {
            collect_binser_types(rest, impls, acc)
          }
        _ -> collect_binser_types(rest, impls, acc)
      }
      DUnstable(inner, _, _) ->
        collect_binser_types([inner, ...rest], impls, acc)
      DProtoLaws(_, inner, _, _, _) ->
        collect_binser_types([inner, ...rest], impls, acc)
      DImplAxiom(_, inner, _, _, _) ->
        collect_binser_types([inner, ...rest], impls, acc)
      DConstructor(inner, _, _) ->
        collect_binser_types([inner, ...rest], impls, acc)
      _ -> collect_binser_types(rest, impls, acc)
    }
  }
}

fn validate_derive_binser_loop(decls: [Decl], df: DiagFiles,
                                 providers: [String], errs: [Diagnostic]) : [Diagnostic] / Console {

  match decls {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tname, _, body, line, col, _, _, _) ->
          if derives_gen(names, CpBinSerialize) {
            let file = decl_diag_file(d, df)
            let errs1 = validate_derive_binser_body(file, tname, body,
                                                     providers, line, col, errs)
            validate_derive_binser_loop(rest, df, providers, errs1)
          } else {
            validate_derive_binser_loop(rest, df, providers, errs)
          }
        _ -> validate_derive_binser_loop(rest, df, providers, errs)
      }
      DUnstable(inner, _, _) ->
        validate_derive_binser_loop([inner, ...rest], df, providers, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derive_binser_loop([inner, ...rest], df, providers, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derive_binser_loop([inner, ...rest], df, providers, errs)
      DConstructor(inner, _, _) ->
        validate_derive_binser_loop([inner, ...rest], df, providers, errs)
      _ -> validate_derive_binser_loop(rest, df, providers, errs)
    }
  }
}

fn validate_derive_binser_body(file: String, tname: String, body: TypeBody,
                                 providers: [String], line: Int, col: Int,
                                 errs: [Diagnostic]) : [Diagnostic] / Console {

  match body {
    TBRecord(fields) -> validate_derive_binser_fields(file, tname, fields,
                                                        providers, line, col, errs)
    TBSum(variants) -> validate_derive_binser_variants(file, tname, variants,
                                                         providers, line, col, errs)
    _ -> errs
  }
}

fn validate_derive_binser_fields(file: String, tname: String,
                                   fields: [FieldDecl], providers: [String],
                                   line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {

  match fields {
    [] -> errs
    [fd, ...rest] -> match fd {
      FD(_, fname, ftype, _) -> {
        let errs1 = validate_derive_binser_one(file, tname, fname, "field",
                                                 ftype, providers, line, col, errs)
        validate_derive_binser_fields(file, tname, rest, providers,
                                        line, col, errs1)
      }
    }
  }
}

fn validate_derive_binser_variants(file: String, tname: String,
                                     variants: [Variant], providers: [String],
                                     line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {

  match variants {
    [] -> errs
    [v, ...rest] -> match v {
      Var(vname, vargs) -> {
        let errs1 = validate_derive_binser_payload(file, tname, vname, vargs, 0,
                                                     providers, line, col, errs)
        validate_derive_binser_variants(file, tname, rest, providers,
                                          line, col, errs1)
      }
    }
  }
}

fn validate_derive_binser_payload(file: String, tname: String, vname: String,
                                    vargs: [TypeExpr], idx: Int,
                                    providers: [String], line: Int, col: Int,
                                    errs: [Diagnostic]) : [Diagnostic] / Console {

  match vargs {
    [] -> errs
    [vt, ...rest] -> {
      let label = concat_all([vname, " payload #", int_to_string(idx)])
      let errs1 = validate_derive_binser_one(file, tname, label, "variant",
                                               vt, providers, line, col, errs)
      validate_derive_binser_payload(file, tname, vname, rest, idx + 1,
                                       providers, line, col, errs1)
    }
  }
}

fn validate_derive_binser_one(file: String, tname: String, fname: String,
                                kind: String, ftype: TypeExpr,
                                providers: [String], line: Int, col: Int,
                                errs: [Diagnostic]) : [Diagnostic] / Console {
  let head = proto_type_name(ftype)
  if head == tname {
    errs
  } else if list_has(providers, head) {
    errs
  } else if binser_builtin_impl(ftype) {
    errs
  } else if binser_collection_head(ftype) {
    # `List` and `Option` route through `bin_list_*` / `bin_option_*`
    # combinators emitted by the derive. Validate that the element
    # type still has a usable impl/derive, recursively.
    validate_derive_binser_collection_elem(file, tname, fname, kind, ftype,
                                             head, providers, line, col, errs)
  } else {
    let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(BinSerialize)]` for `", tname,
      "`: no `BinSerialize` impl for ", kind, " `", fname, "` of type `", head,
      "` (declare `impl BinSerialize for ", head,
      "` or `#[derive(BinSerialize)]` on `", head, "`)"]))
    [derr, ...errs]
  }
}

fn binser_collection_head(ftype: TypeExpr) : Bool = match binser_leaf_ty(resolve_ty(ftype)) {
  TyListT(_)        -> true
  TyCon(_, _, _, s) -> core_ty_is(s, CtList) or core_ty_is(s, CtOption)
  _                 -> false
}

# Pre-expansion validator for `#[derive(Layout)]`. `derive_layout_impl`
# returns no decls when the record is not Layout-bearing, so without this
# pass the omission surfaces only as a missing `to_bytes` at the first
# call site. Walks the original decl stream and reports each offending
# field with the remedy that applies to it.
fn validate_derive_layout(decls: [Decl], df: DiagFiles) : [Diagnostic] / Console =
  list_reverse(validate_derive_layout_loop(decls, df, []))

fn validate_derive_layout_loop(decls: [Decl], df: DiagFiles,
                                 errs: [Diagnostic]) : [Diagnostic] / Console {
  match decls {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tname, _, body, line, col, _, _, _) ->
          if derives_gen(names, CpLayout) {
            let file = decl_diag_file(d, df)
            let errs1 = validate_derive_layout_body(file, tname, body,
                                                     line, col, errs)
            validate_derive_layout_loop(rest, df, errs1)
          } else {
            validate_derive_layout_loop(rest, df, errs)
          }
        _ -> validate_derive_layout_loop(rest, df, errs)
      }
      DUnstable(inner, _, _) ->
        validate_derive_layout_loop([inner, ...rest], df, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derive_layout_loop([inner, ...rest], df, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derive_layout_loop([inner, ...rest], df, errs)
      DConstructor(inner, _, _) ->
        validate_derive_layout_loop([inner, ...rest], df, errs)
      _ -> validate_derive_layout_loop(rest, df, errs)
    }
  }
}

fn validate_derive_layout_body(file: String, tname: String, body: TypeBody,
                                 line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match body {
    TBRecord(fields) -> match fields {
      [] -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Layout)]` for `", tname,
          "`: a Layout record needs at least one field"]))
        [derr, ...errs]
      }
      _ -> validate_derive_layout_fields(file, tname, fields, line, col, errs)
    }
    _ -> {
      let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Layout)]` for `", tname,
        "`: Layout applies to records, not sum types"]))
      [derr, ...errs]
    }
  }
}

fn validate_derive_layout_fields(file: String, tname: String,
                                   fields: [FieldDecl], line: Int, col: Int,
                                   errs: [Diagnostic]) : [Diagnostic] / Console {
  match fields {
    [] -> errs
    [fd, ...rest] -> {
      let errs1 = validate_derive_layout_one(file, tname, fd, line, col, errs)
      validate_derive_layout_fields(file, tname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_layout_one(file: String, tname: String, fd: FieldDecl,
                                line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  let rej = layout_reject_of(fd)
  if layout_reject_is_err(rej) {
    match fd {
      FD(_, fname, ftype, _) -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Layout)]` for `", tname,
          "`: field `", fname, "` of type `", layout_head_name(ftype),
          "` is not Layout-bearing: ", layout_reject_why(rej)]))
        [derr, ...errs]
      }
    }
  } else { errs }
}

# Pre-expansion validator for `#[derive(Json)]`. Same shape as the
# Layout one: `derive_json_impl` returns no decls when a field has no
# JSON denotation, so without this pass the omission surfaces only as a
# missing `to_json` at the first call site.
fn validate_derive_json(decls: [Decl], df: DiagFiles) : [Diagnostic] / Console =
  list_reverse(validate_derive_json_loop(decls, df, []))

fn validate_derive_json_loop(decls: [Decl], df: DiagFiles,
                              errs: [Diagnostic]) : [Diagnostic] / Console {
  match decls {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tname, _, body, line, col, _, _, _) ->
          if derives_gen(names, CpJson) {
            let file = decl_diag_file(d, df)
            let errs1 = validate_derive_json_body(file, tname, body, line, col, errs)
            validate_derive_json_loop(rest, df, errs1)
          } else {
            validate_derive_json_loop(rest, df, errs)
          }
        _ -> validate_derive_json_loop(rest, df, errs)
      }
      DUnstable(inner, _, _) ->
        validate_derive_json_loop([inner, ...rest], df, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derive_json_loop([inner, ...rest], df, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derive_json_loop([inner, ...rest], df, errs)
      DConstructor(inner, _, _) ->
        validate_derive_json_loop([inner, ...rest], df, errs)
      _ -> validate_derive_json_loop(rest, df, errs)
    }
  }
}

fn validate_derive_json_body(file: String, tname: String, body: TypeBody,
                              line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match body {
    TBRecord(fields) -> match fields {
      [] -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
          "`: a Json record needs at least one field"]))
        [derr, ...errs]
      }
      _ -> validate_derive_json_fields(file, tname, fields, line, col, errs)
    }
    TBSum(variants) -> match variants {
      [] -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
          "`: a Json sum needs at least one variant"]))
        [derr, ...errs]
      }
      _ -> validate_derive_json_variants(file, tname, variants, line, col, errs)
    }
    _ -> {
      let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
        "`: Json applies to records and sum types, not type aliases"]))
      [derr, ...errs]
    }
  }
}

# Each variant payload must be JSON-bindable. The adjacently-tagged
# envelope encodes the payload under `value`, so an unbindable payload
# type is reported the same way an unbindable record field is.
fn validate_derive_json_variants(file: String, tname: String, variants: [Variant],
                                  line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match variants {
    [] -> errs
    [v, ...rest] -> {
      let errs1 = validate_derive_json_variant(file, tname, v, line, col, errs)
      validate_derive_json_variants(file, tname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_json_variant(file: String, tname: String, v: Variant,
                                 line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match v {
    Var(vname, vargs) -> validate_derive_json_payload(file, tname, vname, vargs, line, col, errs)
  }
}

fn validate_derive_json_payload(file: String, tname: String, vname: String,
                                 vargs: [TypeExpr], line: Int, col: Int,
                                 errs: [Diagnostic]) : [Diagnostic] / Console {
  match vargs {
    [] -> errs
    [t, ...rest] -> {
      let errs1 = match json_field_reject(t) {
        None -> errs
        Some(why) -> {
          let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
            "`: variant `", vname, "` payload of type `", json_head_name(t),
            "` is not JSON-bindable: ", why]))
          [derr, ...errs]
        }
      }
      validate_derive_json_payload(file, tname, vname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_json_fields(file: String, tname: String, fields: [FieldDecl],
                                line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match fields {
    [] -> errs
    [fd, ...rest] -> {
      let errs1 = validate_derive_json_one(file, tname, fd, line, col, errs)
      validate_derive_json_fields(file, tname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_json_one(file: String, tname: String, fd: FieldDecl,
                             line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match fd {
    FD(_, fname, ftype, attrs) ->
      # A `#[json(skip)]` field never touches the wire, so its type need
      # not be JSON-bindable — but decode must be able to reconstruct it,
      # which requires a `#[json(default)]` or an `Option` type.
      if field_attr_json_skip(attrs) {
        let has_default = match field_attr_json_default(attrs) { Some(_) -> true None -> false }
        if has_default or json_head_is_option(ftype) { errs }
        else {
          let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
            "`: field `", fname, "` carries `#[json(skip)]` but has no `#[json(default)]` and is not `Option` — decode cannot reconstruct a skipped field"]))
          [derr, ...errs]
        }
      } else { match json_field_reject(ftype) {
        None -> errs
        Some(why) -> {
          let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
            "`: field `", fname, "` of type `", json_head_name(ftype),
            "` is not JSON-bindable: ", why]))
          [derr, ...errs]
        }
      } }
  }
}

# `TyList(elem)` and `Option[elem]` are valid only when `elem` is
# itself a builtin, a collection (recursive case for `[[Foo]]`), or a
# provider in scope. Anything else is reported as missing — but the
# message names the *element* type, not the outer `List`/`Option`,
# because the user's mental model is "BinSerialize for Foo is what
# I need to add".
fn validate_derive_binser_collection_elem(file: String, tname: String,
                                            fname: String, kind: String,
                                            ftype: TypeExpr, head: String,
                                            providers: [String], line: Int,
                                            col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  let elem_opt = binser_collection_elem(ftype)
  match elem_opt {
    None -> {
      # `Option` without a type arg, or other malformed shape. Report
      # against the outer head so the user knows the shape is wrong.
      let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(BinSerialize)]` for `", tname,
        "`: ", kind, " `", fname, "` has shape `", head,
        "` without an element type"]))
      [derr, ...errs]
    }
    Some(elem) -> validate_derive_binser_one(file, tname, fname, kind, elem,
                                                providers, line, col, errs)
  }
}

fn binser_collection_elem(ftype: TypeExpr) : Option[TypeExpr] {
  match ftype.tkind {
    TyList(elem) -> Some(elem)
    _            -> binser_option_elem(ftype)
  }
}

# Atomic types with hand-written impls in stdlib/protocols.kai.
# Mirrors `derive_builtin_impl` for Eq/Hash/Show; kept separate to
# avoid coupling BinSerialize's whitelist to the protocols that
# pre-existed it. `Byte` rides the `Int` impl by virtue of Lane 4's
# nominal-but-byte-castable design. `Char` rides a hand-written
# `bin_char_*` pair the derive routes to directly.
fn binser_builtin_impl(ftype: TypeExpr) : Bool = match binser_leaf_ty(resolve_ty(ftype)) {
  TyInt    -> true
  TyReal   -> true
  TyBool   -> true
  TyString -> true
  TyByte   -> true
  TyChar   -> true
  _        -> false
}

# m12.8.z: pre-expansion validation for `#derive(Ord)`. Walks the
# decl stream once to collect every type that has — or will have
# after derivation — an `Ord` impl, then rejects any
# `#derive(Ord) type T` whose fields/payloads reference a type that
# does not appear in that set. The `T` itself is whitelisted to
# allow recursive types. Parametric type heads (`List`, `Option`,
# `Result`, `Fn`) collapse to their constructor name via
# `proto_type_name`, so a field of type `[Int]` looks like `List`
# in the providers set — and unless `impl Ord for List` is
# declared, the derive is rejected.
fn validate_derive_ord(decls: [Decl], df: DiagFiles) : [Diagnostic] / Console {

  let providers = collect_ord_providers(decls, [])
  list_reverse(validate_derive_ord_loop(decls, df, providers, []))
}

fn collect_ord_providers(decls: [Decl], acc: [String]) : [String] {
  match decls {
    [] -> acc
    [d, ...rest] -> match d {
      DImpl(pname, _, target, _, _, _, _, isym) ->
        if spells_gen(pname, CpOrd) {
          collect_ord_providers(rest, [proto_type_name(target), ...acc])
        } else {
          collect_ord_providers(rest, acc)
        }
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tname, _, _, _, _, _, _, _) ->
          if derives_gen(names, CpOrd) {
            collect_ord_providers(rest, [tname, ...acc])
          } else {
            collect_ord_providers(rest, acc)
          }
        _ -> collect_ord_providers(rest, acc)
      }
      DUnstable(inner, _, _) ->
        collect_ord_providers([inner, ...rest], acc)
      DProtoLaws(_, inner, _, _, _) ->
        collect_ord_providers([inner, ...rest], acc)
      DImplAxiom(_, inner, _, _, _) ->
        collect_ord_providers([inner, ...rest], acc)
      DConstructor(inner, _, _) ->
        collect_ord_providers([inner, ...rest], acc)
      _ -> collect_ord_providers(rest, acc)
    }
  }
}

fn validate_derive_ord_loop(decls: [Decl], df: DiagFiles,
                              providers: [String], errs: [Diagnostic]) : [Diagnostic] / Console {

  match decls {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tname, tps, body, line, col, _, _, _) ->
          if derives_gen(names, CpOrd) {
            let file = decl_diag_file(d, df)
            let own = list_append(derive_bound_params(tps), providers)
            let errs1 = validate_derive_ord_body(file, tname, body, own,
                                                  line, col, errs)
            validate_derive_ord_loop(rest, df, providers, errs1)
          } else {
            validate_derive_ord_loop(rest, df, providers, errs)
          }
        _ -> validate_derive_ord_loop(rest, df, providers, errs)
      }
      DUnstable(inner, _, _) ->
        validate_derive_ord_loop([inner, ...rest], df, providers, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derive_ord_loop([inner, ...rest], df, providers, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derive_ord_loop([inner, ...rest], df, providers, errs)
      DConstructor(inner, _, _) ->
        validate_derive_ord_loop([inner, ...rest], df, providers, errs)
      _ -> validate_derive_ord_loop(rest, df, providers, errs)
    }
  }
}

fn validate_derive_ord_body(file: String, tname: String, body: TypeBody,
                              providers: [String], line: Int, col: Int,
                              errs: [Diagnostic]) : [Diagnostic] / Console {

  match body {
    TBRecord(fields) -> validate_derive_ord_fields(file, tname, fields,
                                                     providers, line, col, errs)
    TBSum(variants) -> validate_derive_ord_variants(file, tname, variants,
                                                      providers, line, col, errs)
    # Aliases / effect-aliases never reach derive — `derive_ord_impl`
    # returns None for them and the existing pipeline handles the
    # resulting "no impl" surface elsewhere. Nothing to validate here.
    _ -> errs
  }
}

fn validate_derive_ord_fields(file: String, tname: String,
                                fields: [FieldDecl], providers: [String],
                                line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {

  match fields {
    [] -> errs
    [fd, ...rest] -> match fd {
      FD(_, fname, ftype, _) -> {
        let errs1 = validate_derive_ord_one(file, tname, fname, "field",
                                              ftype, providers, line, col, errs)
        validate_derive_ord_fields(file, tname, rest, providers, line, col, errs1)
      }
    }
  }
}

fn validate_derive_ord_variants(file: String, tname: String,
                                  variants: [Variant], providers: [String],
                                  line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {

  match variants {
    [] -> errs
    [v, ...rest] -> match v {
      Var(vname, vargs) -> {
        let errs1 = validate_derive_ord_payload(file, tname, vname, vargs, 0,
                                                  providers, line, col, errs)
        validate_derive_ord_variants(file, tname, rest, providers, line, col, errs1)
      }
    }
  }
}

fn validate_derive_ord_payload(file: String, tname: String, vname: String,
                                 vargs: [TypeExpr], idx: Int,
                                 providers: [String], line: Int, col: Int,
                                 errs: [Diagnostic]) : [Diagnostic] / Console {

  match vargs {
    [] -> errs
    [vt, ...rest] -> {
      let label = concat_all([vname, " payload #", int_to_string(idx)])
      let errs1 = validate_derive_ord_one(file, tname, label, "variant",
                                            vt, providers, line, col, errs)
      validate_derive_ord_payload(file, tname, vname, rest, idx + 1,
                                    providers, line, col, errs1)
    }
  }
}

fn validate_derive_ord_one(file: String, tname: String, fname: String,
                             kind: String, ftype: TypeExpr,
                             providers: [String], line: Int, col: Int,
                             errs: [Diagnostic]) : [Diagnostic] / Console {
  let head = proto_type_name(ftype)
  if head == tname {
    errs
  } else if list_has(providers, head) {
    errs
  } else {
    let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Ord)]` for `", tname,
      "`: no `Ord` impl for ", kind, " `", fname, "` of type `", head,
      "` (declare `impl Ord for ", head, "` or `#[derive(Ord)]` on `", head, "`)"]))
    [derr, ...errs]
  }
}

# Top-level entry point. Hands the post-desugar decl stream back
# with protocols / impls lowered into ordinary fn decls, plus a
# threaded ProtocolReg the post-inference rewrite consumes.
#[doc("Result of pass A: the decl stream with impls lowered, the threaded ProtocolReg, an error count, and the symbols of the impls `#[derive]` minted.")]
pub type LoweredProtocols = { decls: [Decl], reg: ProtocolReg, errs: Int, diags: [Diagnostic], derived: [String] }

#[doc("Pass A: expand #[derive], validate coherence, lower impls + emit dispatchers, strip protocol decls. `cores` names the stdlib core modules, whose protocols keep their bare dispatch identity; `imports` is each file's direct import list, the scope a bare protocol head resolves through.")]
pub fn lower_protocols(decls: [Decl], df: DiagFiles,
                     target_mod: String, cores: [String],
                     imports: [ModImports], ps: PScope) : LoweredProtocols / Console + File {

  # Step 0 — m12.8.x: validate `#derive(Eq/Hash)` on sum types: every
  # variant field's head type must already have an impl reachable in
  # this compilation unit. Reported errors short-circuit the typer
  # via `proto_errs > 0` in the driver.
  let pre_diags = validate_derives(decls, df)
  # Step 0b — m12.8.z: validate `#derive(Ord)` against available
  # impls *before* expansion. The synthesised `cmp` body delegates
  # to `cmp` on each field type, and the post-inference rewrite
  # silently routes missing-impl calls to the dispatcher's runtime
  # `panic` (a v1 tradeoff explained in §"resolve_protocol_calls").
  # That fallback is acceptable for hand-written impls but a poor
  # user experience for derived ones, where the field-level cause
  # isn't surfaced. This pass walks the original decl stream
  # (DDerive nodes still intact) and emits a clear typer-time error
  # naming the offending field/payload.
  let derive_diags = list_append(validate_derive_ord(decls, df),
                     list_append(validate_derive_binserialize(decls, df),
                     list_append(validate_derive_layout(decls, df),
                                 validate_derive_json(decls, df))))
  # Step 1 — expand `#derive(...)` annotations into synthetic DImpl
  # decls so subsequent steps see all impls uniformly.
  let exp = expand_derives(decls, target_mod)
  let expanded = match exp { Expanded(ds, _) -> ds }
  # Step 2 — collect every protocol op into the registry, each entry
  # tagged with its declaring module's home. The same home-anchor
  # stream also scopes the impl validations below, so it is computed
  # once here.
  let homes = imports_home_anchors(expanded, target_mod, target_mod, [])
  let reg0 = reg_with_scope(collect_proto_decls(expanded, proto_reg_empty(), ps), cores, imports, ps)
  # Step 3 — coherence: orphan + duplicate-impl + protocol-visibility
  # validation. Needs `reg0.origins` to resolve each impl's protocol
  # name from its own module.
  let coh_diags = validate_impls(expanded, homes, df, reg0, target_mod, ps)
  each(coh_diags, render_diag)
  # Step 3b — issue #535: validate each impl block against its
  # protocol's declared operations (missing methods, wrong arity,
  # head-name signature mismatch), resolved against the protocol the
  # impl's own module sees — never a same-named one elsewhere.
  let impl_diags = validate_impl_methods(expanded, homes, df, reg0, target_mod, ps)
  each(impl_diags, render_diag)
  let diags = list_append(pre_diags, list_append(derive_diags, list_append(coh_diags, impl_diags)))
  let errs = list_length(diags)
  # Step 4 — lower each DImpl method into a top-level DFn (mangled
  # name) and record the (P, T) -> impl_fn entry in the registry.
  let lower_res = lower_impls(expanded, reg0, ps, [])
  # Step 5 — synthesise one dispatcher fn per protocol op so the
  # typer can resolve the call as ordinary polymorphic dispatch; the
  # post-inference rewrite redirects each reachable call to the
  # matching `__pimpl_*` direct call.
  let dispatchers = generate_dispatchers(lower_res.reg)
  # Step 6 — drop DProtocol / DImpl / DDerive from the decl stream.
  let stripped = strip_protocols(expanded)
  # Two homonymous types' impls mint one symbol; the root entry's is
  # respelled so every impl function keeps a name of its own.
  let renames = impl_symbol_renames(lower_res.reg.impls, target_mod)
  let final_decls = decls_with_renames(list_append(stripped, list_append(lower_res.fns, dispatchers)), renames)
  # Index the now-final impl table once; the post-inference rewrite's
  # per-spec scans consult it instead of walking `reg.impls` linearly.
  let indexed_reg = reg_with_impl_index(reg_with_renames(lower_res.reg, renames))
  let derived = match exp { Expanded(_, ds) -> derived_impl_syms(ds, reg0, ps, renames) }
  LoweredProtocols { decls: final_decls, reg: indexed_reg, errs: errs, diags: diags, derived: derived }
}

# The symbols the derived impls mint, spelled as the final registry spells them.
fn derived_impl_syms(minted: [Decl], reg0: ProtocolReg, ps: PScope, renames: [ImplRename]) : [String] = match minted {
  [] -> []
  _  -> map((lower_impls(minted, reg_without_impls(reg0), ps, [])).reg.impls, (p) => impl_renamed(renames, pir_sym(p)))
}

fn reg_without_impls(reg: ProtocolReg) : ProtocolReg =
  ProtocolReg { ops: reg.ops, impls: [], op_names: reg.op_names,
                tparams: reg.tparams, origins: reg.origins, dkeys: reg.dkeys,
                impl_index: reg.impl_index, cores: reg.cores,
                imports: reg.imports, root: reg.root }

# Attach a freshly-built `ImplIndex` to a finalised registry. The impl
# table is immutable past this point, so the index built here serves
# every subsequent lookup.
fn reg_with_impl_index(reg: ProtocolReg) : ProtocolReg =
  ProtocolReg { ops: reg.ops, impls: reg.impls, op_names: reg.op_names,
                tparams: reg.tparams, origins: reg.origins,
                dkeys: reg.dkeys,
                impl_index: build_impl_index(reg.impls), cores: reg.cores,
                imports: reg.imports, root: reg.root }

# Dispatch identity comes from the symbol table: the protocols the
# stream declares, keyed by whether the table holds a second home for
# the same name.
fn reg_with_scope(reg: ProtocolReg, cores: [String],
                  imports: [ModImports], ps: PScope) : ProtocolReg =
  ProtocolReg { ops: reg.ops, impls: reg.impls, op_names: reg.op_names,
                tparams: reg.tparams, origins: reg.origins,
                dkeys: pk_table(ps_tab(ps), ps_view(ps, None), ps_root(ps)),
                impl_index: reg.impl_index, cores: cores, imports: imports, root: ps_root(ps) }

#[doc("A protocol operation's (name, arity): what names its dispatcher.")]
pub type OpAr = OpAr(String, Int)

#[doc("The protocol rung of the resolver's ladder: each operation the registry holds, with its arity, its dispatcher, its protocol's home and whether that protocol is exported.")]
pub fn proto_rungs(reg: ProtocolReg) : [ProtoRung] = {
  let ars = op_arities_from_ops(reg.ops)
  map(reg.ops, (op) => match op {
    POR(_, name, params, _, _, _, mo, psym) -> {
      let n = list_length(params)
      ProtoRung(name, n, proto_dispatcher_name_at(ars, name, n), mo, psc_is_pub(reg.origins, psym))
    }
  })
}

#[doc("Project the registry's protocol ops into their (name, arity) pairs.")]
pub fn op_arities_from_ops(ops: [ProtoOpReg]) : [OpAr] {
  match ops {
    [] -> []
    [op, ...rest] -> match op {
      POR(_, name, params, _, _, _, _, _) ->
        [OpAr(name, list_length(params)), ...op_arities_from_ops(rest)]
    }
  }
}

# True when `target` is declared by two protocols at DIFFERENT arities
# (`P { f(x) }` + `Q { f(a, b) }`). A single `__proto_f` dispatcher
# cannot carry two incompatible signatures, so the rename + dispatcher
# generation switch to arity-suffixed names (`__proto_f__a1`) for such
# a name. Same-arity collisions (the common case — `Ring.add` vs
# `Add.add`, both arity 2) keep the unsuffixed `__proto_<op>` and the
# runtime impl-table disambiguates by `head_tag(self)`.
fn op_name_arity_ambiguous(arities: [OpAr], target: String) : Bool =
  op_name_arity_ambiguous_loop(arities, target, -1)

fn op_name_arity_ambiguous_loop(arities: [OpAr], target: String,
                                  seen: Int) : Bool {
  match arities {
    [] -> false
    [a, ...rest] -> match a {
      OpAr(name, ar) ->
        if name == target {
          if seen >= 0 and ar != seen { true }
          else { op_name_arity_ambiguous_loop(rest, target, ar) }
        } else {
          op_name_arity_ambiguous_loop(rest, target, seen)
        }
    }
  }
}

# Dispatcher name for an op call resolved at a known arity. Unsuffixed
# `__proto_<op>` unless the name is arity-ambiguous, in which case the
# arity is appended so the two protocols' ops land on distinct
# dispatchers. Keeping the unsuffixed form for the common case is what
# preserves the selfhost byte-id.
fn proto_dispatcher_name_at(arities: [OpAr], op: String, arity: Int) : String {
  if op_name_arity_ambiguous(arities, op) {
    concat_all(["__proto_", op, "__a", int_to_string(arity)])
  } else {
    proto_dispatcher_name(op)
  }
}

# ====================================================================
# m12.8 — post-inference protocol-call rewrite
# ====================================================================
#
# Once `infer_program` has populated `Expr.ty` on every node, walk
# the typed AST and replace every reachable
#
#   ECall(EVar("op"), [arg0, arg1, ...])
#
# (where `op` is a registered protocol op AND `arg0.ty` resolves to
# a concrete type-constructor name `T`) with
#
#   ECall(EVar("__pimpl_<P>_<T>_<op>"), [arg0, arg1, ...])
#
# The rewrite is purely syntactic — every callee already has a body
# in scope (lower_protocols emitted it), so the call links normally.
# Calls whose `arg0.ty` is unknown OR for which no impl exists fall
# through and execute the dispatcher fn's `panic` at runtime; the
# spec wants a compile-time error there but the v1 keeps the runtime
# fallback so partial programs (typed holes, generic helpers without
# concrete dispatch info) still build.

#[doc("Pass B: rewrite every resolved `op(x, ...)` to its matching impl fn across the typed program.")]
pub fn resolve_protocol_calls(typed: TypedProgram, reg: ProtocolReg) : TypedProgram {
  TypedProgram {
    decls: map(typed.decls, (d) => resolve_protocol_calls_decl(d, reg)),
    errs: typed.errs,
    insts: typed.insts,
    holes: typed.holes,
    row_holes: typed.row_holes,
    core_len: typed.core_len,
    toplevel_len: typed.toplevel_len,
    module_doc: typed.module_doc,
    diags: typed.diags,
    op_res: typed.op_res
  }
}

#[doc("Per-decl hook of pass B; the N2 monomorph lane imports this to rewrite during monomorphisation.")]
pub fn resolve_protocol_calls_decl(d: Decl, reg: ProtocolReg) : Decl {
  # The decl's own module scopes which protocols its calls may
  # dispatch against (`proto_visible_from`); tests and benches are
  # root-file constructs and see everything.
  match d {
    DFn(pub_, n, tps, ps, ret, row, body, l, c, mo, fsym) ->
      DFn(pub_, n, tps, ps, ret, row,
          resolve_protocol_calls_expr(body, reg, mo), l, c, mo, fsym)
    DTest(desc, body, l, c, mo) ->
      DTest(desc, resolve_protocol_calls_expr(body, reg, None), l, c, mo)
    DBench(desc, body, l, c, mo) ->
      DBench(desc, resolve_protocol_calls_expr(body, reg, None), l, c, mo)
    DCheck(desc, ps, body, l, c, mo) ->
      DCheck(desc, ps, resolve_protocol_calls_expr(body, reg, None), l, c, mo)
    _ -> d
  }
}

fn resolve_protocol_calls_expr(e: Expr, reg: ProtocolReg,
                                 cm: Option[String]) : Expr {
  let new_kind = resolve_protocol_calls_kind(e.kind, reg, cm,
                                               e.ty, e.line, e.col)
  # Issue #180: a `Real + Complex` binop was typed by the generic
  # dispatcher as `Self` (the LHS head, Real) — wrong, the heterogeneous
  # `impl Add[Complex] for Real` returns `Complex`. The rewrite above
  # has now redirected the call to that impl's `__pimpl_*` symbol; read
  # the impl's declared return head and, when it differs from the node's
  # dispatcher-derived type, correct it. This runs before unboxing, so
  # the unbox pass then sees `Complex` (boxed) instead of `Real`
  # (unboxed) and emits a `KaiValue*` record load rather than reading
  # the Complex record as a raw `double`. The impl's return IS the
  # promotion target (Int -> Real -> Complex); no type hierarchy is
  # needed beyond what the impl already declares.
  let new_ty = proto_rewrite_corrected_ty(new_kind, e.ty, reg)
  Expr { kind: new_kind, line: e.line, col: e.col, ty: new_ty, mode: e.mode,  site: e.site }
}

# When `kind` is a call of an impl that declares a return head differing
# from `cur_ty`, return the impl's return type. Otherwise return `cur_ty`
# unchanged.
fn proto_rewrite_corrected_ty(kind: ExprKind, cur_ty: Option[Ty], reg: ProtocolReg) : Option[Ty] {
  match kind {
    ECall(callee, _) -> match prc_callee_impl(callee, reg) {
      None -> cur_ty
      Some(p) -> {
        let cur_head = match cur_ty {
          Some(t) -> match ty_head_name(t) { Some(n) -> n  None -> "" }
          None    -> ""
        }
        if pir_ret_head(p) == cur_head { cur_ty } else { pir_ret_ty(p) }
      }
    }
    _ -> cur_ty
  }
}

# The impl a callee names by its symbol, unique per impl.
fn prc_callee_impl(callee: Expr, reg: ProtocolReg) : Option[ProtoImplReg] = match callee.kind {
  EVar(sym)       -> prc_impl_named(reg, sym)
  ESym(s, _, sym) -> if sym_is_local(s) { None } else { prc_impl_named(reg, sym) }
  _               -> None
}

fn prc_impl_named(reg: ProtocolReg, sym: String) : Option[ProtoImplReg] =
  pir_by_sym(if ii_built(reg.impl_index) { ii_sym_bucket(reg.impl_index, sym) } else { reg.impls }, sym)

# The registered impl whose fn symbol is `sym`; none when `sym` is not
# an impl symbol. Impl symbols are unique, so the first hit is the one.
fn pir_by_sym(impls: [ProtoImplReg], sym: String) : Option[ProtoImplReg] {
  match impls {
    [] -> None
    [it, ...rest] -> if pir_sym(it) == sym { Some(it) } else { pir_by_sym(rest, sym) }
  }
}

fn resolve_protocol_calls_kind(k: ExprKind, reg: ProtocolReg,
                                cm: Option[String],
                                ret_ty: Option[Ty],
                                line: Int, col: Int) : ExprKind {
  match k {
    # The only kind that needs special handling: a typed `ECall` whose
    # callee resolves to a registered protocol op + args[0].ty matches
    # a registered impl gets rewritten to `__pimpl_<P>_<T>_<op>`. All
    # other kinds recurse purely structurally — there is no scope
    # bookkeeping at this stage.
    ECall(callee, args_) -> {
      let new_args = map(args_, (a) => resolve_protocol_calls_expr(a, reg, cm))
      let new_callee = resolve_protocol_calls_expr(callee, reg, cm)
      # Issue #180: pass the call's inferred return type so dispatchers
      # whose only Self informant is the return position (e.g.
      # `from(x) : Self` against a `let x : T = from(...)` annotation)
      # can resolve `Self` from that pin.
      let rewritten = try_rewrite_proto_call_with_ret(new_callee, new_args,
                                                       reg, cm, ret_ty)
      match rewritten {
        Some(rk) -> rk
        None     -> ECall(new_callee, new_args)
      }
    }
    # Binops are sugar for Eq.eq / Ord.cmp / the operator protocols. In a
    # generic body the typer leaves them as the builtin EBinop; here, with
    # concrete operand types (post-monomorph per spec), rewrite to the
    # custom impl when the left operand's type carries one. Fully
    # structural types (no custom impl — the common case, e.g. the
    # compiler's own Expr/Stmt) keep the builtin EBinop unchanged.
    EBinop(op, l, r) -> {
      let nl = resolve_protocol_calls_expr(l, reg, cm)
      let nr = resolve_protocol_calls_expr(r, reg, cm)
      prc_rewrite_cmp_binop(op, nl, nr, reg)
    }
    _ -> proto_map_expr_kind(k, (sub) => resolve_protocol_calls_expr(sub, reg, cm))
  }
}

# Rewrite a binop to a custom-impl call when the left operand's type has
# one. `==`/`!=` → Eq.eq (`!=` wraps in `not`); `<`/`>`/`<=`/`>=` →
# Ord.cmp reduced to Bool against 0; `+ - * / %` → the operator
# protocol's op. An operand type with no custom impl keeps the builtin
# EBinop (which lowers to kai_op_eq_v / direct compare / arithmetic).
fn prc_op_impl(reg: ProtocolReg, bp: BinopProto, t: Option[Ty]) : Option[ProtoImplReg] =
  match op_proto_core(bp) {
    Some(cp) -> prc_cmp_impl(reg, cp, op_proto_method(bp), t)
    None     -> None
  }

fn prc_rewrite_cmp_binop(op: BinOp, l: Expr, r: Expr, reg: ProtocolReg) : ExprKind {
  if binop_is_equality(op) {
    match prc_op_impl(reg, BpEq, l.ty) {
      None -> EBinop(op, l, r)
      Some(p) -> {
        let call = ECall(pimpl_ref(reg, p, l), [l, r])
        if binop_eq(op, BoEq) { call } else { EUnop(UoNot, prc_mk_ty(call, l.line, l.col, Some(TyBool))) }
      }
    }
  } else if binop_is_ordering(op) {
    match prc_op_impl(reg, BpOrd, l.ty) {
      None -> EBinop(op, l, r)
      Some(p) -> {
        let cmpcall = prc_mk_ty(ECall(pimpl_ref(reg, p, l), [l, r]), l.line, l.col, Some(TyInt))
        let zero = prc_mk_ty(mk_int_synth(0), l.line, l.col, Some(TyInt))
        EBinop(op, cmpcall, zero)
      }
    }
  } else {
    match prc_arith_impl(reg, binop_proto(op), l.ty, r.ty) {
      Some(p) -> ECall(pimpl_ref(reg, p, l), [l, r])
      None    -> EBinop(op, l, r)
    }
  }
}

# The operator protocol's impl a generic arithmetic binop reaches once
# monomorphisation made its operands concrete: both operands share a head
# with a custom impl of the homogeneous protocol (`impl Add for T` or
# `impl Add[T] for T`). A primitive operand has no head and keeps the
# builtin; a mixed-type binop was already rewritten by the typer.
fn prc_arith_impl(reg: ProtocolReg, bp: BinopProto, lt: Option[Ty], rt: Option[Ty]) : Option[ProtoImplReg] =
  match bp {
    BpEq   -> None
    BpOrd  -> None
    BpNone -> None
    _ -> match prc_con_head(lt) {
      None -> None
      Some(DispHead(n, hs)) -> if not prc_same_head(rt, n, hs) { None } else { match op_proto_core(bp) {
        None     -> None
        Some(cp) -> {
          let proto = core_proto_id(cp)
          find(impl_pool(reg, proto, n), (p) => prc_homogeneous(p, proto, op_proto_method(bp), DispHead(n, hs)))
        }
      } }
    }
  }

fn prc_con_head(t: Option[Ty]) : Option[DispHead] = match t {
  Some(TyCon(_, n, _, s)) -> Some(DispHead(n, s))
  _                       -> None
}

fn prc_same_head(t: Option[Ty], n: String, s: SymId) : Bool = match t {
  Some(TyCon(_, tn, _, ts)) -> tn == n and sym_compat(ts, s)
  _                         -> false
}

fn prc_homogeneous(p: ProtoImplReg, proto: SymId, opname: String, h: DispHead) : Bool = match p {
  PIR(_, _, op, _, args, _, _, _, _) ->
    pir_of_proto(p, proto) and op == opname and pir_serves(p, h) and match args {
      []  -> true
      [a] -> a == dh_name(h)
      _   -> false
    }
}

# Build an Expr with an explicit type annotation. `mk_expr` defaults
# `ty` to None; the cmp rewrite pins TyBool / TyInt so downstream
# passes see concrete types.
fn prc_mk_ty(k: ExprKind, line: Int, col: Int, ty: Option[Ty]) : Expr =
  Expr { kind: k, line: line, col: col, ty: ty, mode: MUnknown , site: 0 }

# The `impl proto` entry serving the operand's root type, by the type's
# identity. `None` when the type is fully structural (no custom impl)
# or unresolved → keep the builtin. v1 checks the root type only; a
# contained field with a custom impl is a documented follow-up (the
# compiler's own comparisons are all fully structural, so root-only
# suffices for self-host correctness).
fn prc_cmp_impl(reg: ProtocolReg, cp: CoreProto, opname: String,
                ty: Option[Ty]) : Option[ProtoImplReg] = match ty {
  None -> None
  Some(t) -> match t {
    TyCon(_, name, _, s) -> {
      let proto = core_proto_id(cp)
      find_impl_for(impl_pool(reg, proto, name), proto, DispHead(name, s), opname)
    }
    _ -> None
  }
}

# True iff `reg` holds an `impl proto for head` entry. The index
# narrows the scan to the `(proto, head)` bucket; the same membership
# predicate then runs over that short list (or the full table when the
# index is the unbuilt placeholder), so the answer is unchanged.
#[doc("True iff `reg` holds an `impl proto` entry for the receiver `h` (user or derive-synthesised); O(1) via the impl index when built.")]
pub fn prc_reg_has_impl(reg: ProtocolReg, proto: SymId, h: DispHead) : Bool =
  prc_impls_has(impl_pool(reg, proto, dh_name(h)), proto, h)

fn prc_impls_has(impls: [ProtoImplReg], proto: SymId, h: DispHead) : Bool {
  match impls {
    [] -> false
    [pir, ...rest] ->
      if pir_of_proto(pir, proto) and pir_serves(pir, h) { true }
      else { prc_impls_has(rest, proto, h) }
  }
}

# m12.8.x phase 2 (Bug 5): post-rewrite validation. After
# `resolve_protocol_calls` has rewritten every dispatchable
# `__proto_<op>(receiver, ...)` call into the matching
# `__pimpl_<P>_<T>_<op>` direct call, walk the typed AST and report
# any *remaining* dispatcher-shaped calls whose receiver type is
# concrete but has no impl. This is the compile-time error the
# `m12_8_y_postfix_no_impl` and similar negative fixtures expect.
# Calls whose receiver is still a TyVar (the polymorphic-helper
# fallthrough case the m12.8 v1 deliberately allowed) keep the
# dispatcher panic at runtime.
#[doc("Post-rewrite static-coherence check over the whole typed program.")]
pub fn validate_resolved_protocols(typed: TypedProgram, reg: ProtocolReg,
                                df: DiagFiles) : [Diagnostic] / Console + File =
  finalize_diags(validate_resolved_decls(typed.decls, reg, df, []))

#[doc("Post-rewrite static-coherence check over a decl list (used after monomorphisation). Each diagnostic names the file that declares its decl.")]
pub fn validate_resolved_decls(ds: [Decl], reg: ProtocolReg,
                            df: DiagFiles, errs: [Diagnostic]) : [Diagnostic] / Console + File {
  match ds {
    [] -> errs
    [d, ...rest] -> {
      let file = decl_diag_file(d, df)
      # The decl's module scopes which protocols may clear its
      # residual dispatcher calls, mirroring the rewrite.
      let e1 = match d {
        DFn(_, _, _, _, _, _, body, _, _, mo, fsym) ->
          validate_resolved_expr(body, reg, mo, file, errs)
        DTest(_, body, _, _, _) ->
          validate_resolved_expr(body, reg, None, file, errs)
        DBench(_, body, _, _, _) ->
          validate_resolved_expr(body, reg, None, file, errs)
        DCheck(_, _, body, _, _, _) ->
          validate_resolved_expr(body, reg, None, file, errs)
        _ -> errs
      }
      validate_resolved_decls(rest, reg, df, e1)
    }
  }
}

fn validate_resolved_expr(e: Expr, reg: ProtocolReg, cm: Option[String], file: String,
                           errs: [Diagnostic]) : [Diagnostic] / Console + File {


  let e1 = validate_proto_call_at(e, reg, cm, file, errs)
  validate_resolved_kind(e.kind, reg, cm, file, e1)
}

fn validate_resolved_opt(o: Option[Expr], reg: ProtocolReg, cm: Option[String], file: String,
                          errs: [Diagnostic]) : [Diagnostic] / Console + File {


  match o {
    Some(e) -> validate_resolved_expr(e, reg, cm, file, errs)
    None    -> errs
  }
}

fn validate_resolved_exprs(es: [Expr], reg: ProtocolReg, cm: Option[String], file: String,
                            errs: [Diagnostic]) : [Diagnostic] / Console + File {


  match es {
    [] -> errs
    [e, ...rest] -> {
      let e1 = validate_resolved_expr(e, reg, cm, file, errs)
      validate_resolved_exprs(rest, reg, cm, file, e1)
    }
  }
}

fn validate_resolved_arms(arms: [Arm], reg: ProtocolReg, cm: Option[String], file: String,
                           errs: [Diagnostic]) : [Diagnostic] / Console + File {


  match arms {
    [] -> errs
    [a, ...rest] -> match a {
      Arm(_, g, b) -> {
        let e1 = validate_resolved_opt(g, reg, cm, file, errs)
        let e2 = validate_resolved_expr(b, reg, cm, file, e1)
        validate_resolved_arms(rest, reg, cm, file, e2)
      }
    }
  }
}

fn validate_resolved_stmts(ss: [Stmt], reg: ProtocolReg, cm: Option[String], file: String,
                            errs: [Diagnostic]) : [Diagnostic] / Console + File {


  match ss {
    [] -> errs
    [s, ...rest] -> {
      let e1 = match s {
        SLet(_, _, rhs) -> validate_resolved_expr(rhs, reg, cm, file, errs)
        SAssert(c, m) -> {
          let x = validate_resolved_expr(c, reg, cm, file, errs)
          validate_resolved_opt(m, reg, cm, file, x)
        }
        SExprStmt(x) -> validate_resolved_expr(x, reg, cm, file, errs)
        SIndexAssign(b, i, v, _, _) -> {
          let x = validate_resolved_expr(b, reg, cm, file, errs)
          let y = validate_resolved_expr(i, reg, cm, file, x)
          validate_resolved_expr(v, reg, cm, file, y)
        }
        SAssign(b, v, _, _) -> {
          let x = validate_resolved_expr(b, reg, cm, file, errs)
          validate_resolved_expr(v, reg, cm, file, x)
        }
        SVar(_, _, rhs, _, _) -> validate_resolved_expr(rhs, reg, cm, file, errs)
        # m7e §25: SUse has no expression to validate.
        SUse(_, _, _) -> errs
      }
      validate_resolved_stmts(rest, reg, cm, file, e1)
    }
  }
}

fn validate_resolved_clauses(cs: [HClause], reg: ProtocolReg, cm: Option[String],
                              file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File {


  match cs {
    [] -> errs
    [c, ...rest] -> match c {
      HC(_, _, b, _, _) -> {
        let e1 = validate_resolved_expr(b, reg, cm, file, errs)
        validate_resolved_clauses(rest, reg, cm, file, e1)
      }
    }
  }
}

fn validate_resolved_opt_return(o: Option[HReturn], reg: ProtocolReg, cm: Option[String],
                                 file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File {


  match o {
    Some(r) -> match r { HR(_, b, _, _) -> validate_resolved_expr(b, reg, cm, file, errs) }
    None -> errs
  }
}

fn validate_resolved_fields(fs: [FieldInit], reg: ProtocolReg, cm: Option[String],
                             file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File {


  match fs {
    [] -> errs
    [f, ...rest] -> match f {
      FI(_, v) -> {
        let e1 = validate_resolved_expr(v, reg, cm, file, errs)
        validate_resolved_fields(rest, reg, cm, file, e1)
      }
    }
  }
}

fn validate_resolved_list_elems(els: [ListElem], reg: ProtocolReg, cm: Option[String],
                                 file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File {


  match els {
    [] -> errs
    [el, ...rest] -> {
      let e1 = match el {
        ElPlain(x)  -> validate_resolved_expr(x, reg, cm, file, errs)
        ElSpread(x) -> validate_resolved_expr(x, reg, cm, file, errs)
      }
      validate_resolved_list_elems(rest, reg, cm, file, e1)
    }
  }
}

fn validate_resolved_kind(k: ExprKind, reg: ProtocolReg, cm: Option[String], file: String,
                           errs: [Diagnostic]) : [Diagnostic] / Console + File {


  match k {
    ECall(c, args_) -> {
      let e1 = validate_resolved_expr(c, reg, cm, file, errs)
      validate_resolved_exprs(args_, reg, cm, file, e1)
    }
    EBlock(ss, t) -> {
      let e1 = validate_resolved_stmts(ss, reg, cm, file, errs)
      validate_resolved_opt(t, reg, cm, file, e1)
    }
    EIf(c, t_, eo) -> {
      let e1 = validate_resolved_expr(c, reg, cm, file, errs)
      let e2 = validate_resolved_expr(t_, reg, cm, file, e1)
      validate_resolved_opt(eo, reg, cm, file, e2)
    }
    EBinop(_, a, b) -> {
      let e1 = validate_resolved_expr(a, reg, cm, file, errs)
      validate_resolved_expr(b, reg, cm, file, e1)
    }
    EUnop(_, x) -> validate_resolved_expr(x, reg, cm, file, errs)
    EHandle(body, _, _, _, init_opt, _, clauses, ret_opt) -> {
      let e1 = validate_resolved_expr(body, reg, cm, file, errs)
      let e2 = validate_resolved_opt(init_opt, reg, cm, file, e1)
      let e3 = validate_resolved_clauses(clauses, reg, cm, file, e2)
      validate_resolved_opt_return(ret_opt, reg, cm, file, e3)
    }
    ELambda(_, b) -> validate_resolved_expr(b, reg, cm, file, errs)
    EMatch(scr, arms) -> {
      let e1 = validate_resolved_expr(scr, reg, cm, file, errs)
      validate_resolved_arms(arms, reg, cm, file, e1)
    }
    EPipe(a, b) -> {
      let e1 = validate_resolved_expr(a, reg, cm, file, errs)
      validate_resolved_expr(b, reg, cm, file, e1)
    }
    EMapPipe(a, b) -> {
      let e1 = validate_resolved_expr(a, reg, cm, file, errs)
      validate_resolved_expr(b, reg, cm, file, e1)
    }
    EFlatMapPipe(a, b) -> {
      let e1 = validate_resolved_expr(a, reg, cm, file, errs)
      validate_resolved_expr(b, reg, cm, file, e1)
    }
    EFilterPipe(a, b) -> {
      let e1 = validate_resolved_expr(a, reg, cm, file, errs)
      validate_resolved_expr(b, reg, cm, file, e1)
    }
    EField(base, _) -> validate_resolved_expr(base, reg, cm, file, errs)
    EIndex(a, b) -> {
      let e1 = validate_resolved_expr(a, reg, cm, file, errs)
      validate_resolved_expr(b, reg, cm, file, e1)
    }
    ERecordLit(_, _, fields) -> validate_resolved_fields(fields, reg, cm, file, errs)
    EList(elems) -> validate_resolved_list_elems(elems, reg, cm, file, errs)
    ERange(a, b, opt_step) -> {
      let e1 = validate_resolved_expr(a, reg, cm, file, errs)
      let e2 = validate_resolved_expr(b, reg, cm, file, e1)
      validate_resolved_opt(opt_step, reg, cm, file, e2)
    }
    EBang(inner) -> validate_resolved_expr(inner, reg, cm, file, errs)
    ELitUnit(inner, _) -> validate_resolved_expr(inner, reg, cm, file, errs)
    _ -> errs
  }
}

fn validate_proto_call_at(e: Expr, reg: ProtocolReg, cm: Option[String], file: String,
                           errs: [Diagnostic]) : [Diagnostic] / Console + File {


  match e.kind {
    ECall(callee, args_) -> match validate_dispatcher_callee(callee) {
      Some(name) -> {
        let opname = strip_proto_dispatcher_prefix(name)
        # Only inspect calls that survived the rewrite as
        # `__proto_<op>(...)` (the prefix-strip yields a different
        # name) AND whose op is one of our registered protocol ops.
        if name == opname { errs }
        else if not list_has(reg.op_names, opname) { errs }
        else {
          match args_ {
            [] -> errs
            [self_arg, ..._rest_args] -> match self_arg.ty {
              None -> errs
              Some(ty) -> match ty_disp_head(ty) {
                None -> errs
                # Collision-aware: an impl under ANY protocol declaring
                # `opname` clears the call (the bare name carries no
                # protocol, so `Ring.add` and `Add.add` are both valid
                # targets for `add`).
                Some(h) -> match find_impl_any_proto(reg, opname, h, cm) {
                  Some(_) -> validate_dispatch_unique(e, args_, reg, cm, opname, file, errs)
                  None -> {
                    let pname = first_proto_of_op(reg, opname)
                    let d = mk_diag(SevError, file, e.line, e.col,
                      concat_all(["no impl of `", pname,
                                  "` for type `", dh_name(h),
                                  "` (operation `", opname, "`)"]), [])
                    render_diag(d)
                    push_diag(errs, d)
                  }
                }
              }
            }
          }
        }
      }
      None -> errs
    }
    _ -> errs
  }
}

# A residual call with an impl in reach was left by the rewrite for one
# reason: more than one protocol serves the receiver.
fn validate_dispatch_unique(e: Expr, args_: [Expr], reg: ProtocolReg, cm: Option[String],
                            opname: String, file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File {
  let ms = proto_matches_for(proto_cands_own_first(proto_ops_lookup_all(reg, opname), cm),
                             args_, reg, cm, opname)
  if proto_matches_ambiguous(ms) {
    let d = ambiguous_proto_call_diag(file, e.line, e.col, opname, first_proto_of_op(reg, opname), ms)
    render_diag(d)
    push_diag(errs, d)
  } else { errs }
}

# A residual dispatcher call names its dispatcher bare or, when the
# typer picked among same-named dispatchers, module-qualified.
fn validate_dispatcher_callee(callee: Expr) : Option[String] = match callee.kind {
  EVar(name)        -> Some(name)
  ESym(_, _, name)     -> Some(name)
  EModCall(_, name) -> Some(name)
  _                 -> None
}

# ====================================================================
# m12.8.x post-Core REOPEN — Eric level 2: rep invariant verifiers
# ====================================================================
#
# Three walkers verify properties that should hold over the
# post-resolve typed AST. Each is a structural fold over Decl /
# Expr / Stmt / Arm / HClause / HReturn, accumulating an error
# count and (for invariant (b)) a lexical scope set. Diagnostics
# go to stderr via `diag_error`. Errors increment the count, so
# `compile_source` can fail the compile when any invariant breaks.
#
# These complement (not replace) the per-pass audits done in
# `7bd5a68`. They catch a class of bug at the boundary between
# passes — when one pass produces an AST node that violates an
# invariant the next pass assumes — without requiring a shared
# AST visitor refactor (deferred per CLAUDE.md "no premature
# abstraction").
#
# Invariants:
#   (a) Every Expr post-finalise has `Some(_)` ty annotation.
#       Catches the "discarded typed body" pattern (`10a1e7b`):
#       a pass that builds a new Expr from a sub-expr produced by
#       `synth` MUST use the typed sub-expr, not the original
#       (untyped) one. The original has `None` ty on its internal
#       nodes; finalise leaves `None` in place; this walker fires.
#   (b) Every `EVar(__proto_X)` reference has `X` outside every
#       enclosing binder. Catches the "scope-blind protocol
#       rename" pattern (`257b247`).
#   (c) Every `ELambda` whose `.ty` is `TyFnT` has an open row
#       tail. Catches the "closed lambda row" pattern (`b528655`).
#
# Wired into `compile_source` after `validate_resolved_protocols`,
# before perceus / monomorph / emit.

#[doc("Pass C: Eric level-2 rep-invariant verifier over the typed program.")]
pub fn validate_typer_invariants(typed: TypedProgram, file: String) : Int / Console + File =


  validate_inv_decls(typed.decls, file, 0)

fn validate_inv_decls(ds: [Decl], file: String, errs: Int) : Int / Console + File {


  match ds {
    [] -> errs
    [d, ...rest] -> {
      let e1 = match d {
        DFn(_, _, _, ps, _, _, body, _, _, _, fsym) -> {
          let bound0 = inv_param_names(ps, [])
          validate_inv_expr(body, file, bound0, errs)
        }
        DTest(_, body, _, _, _) ->
          validate_inv_expr(body, file, [], errs)
        DBench(_, body, _, _, _) ->
          validate_inv_expr(body, file, [], errs)
        DCheck(_, ps, body, _, _, _) -> {
          let bound0 = inv_param_names(ps, [])
          validate_inv_expr(body, file, bound0, errs)
        }
        _ -> errs
      }
      validate_inv_decls(rest, file, e1)
    }
  }
}

fn inv_param_names(ps: [Param], acc: [String]) : [String] {
  match ps {
    [] -> acc
    [p, ...rest] -> inv_param_names(rest, [p.pname, ...acc])
  }
}

# Mirrors `bind_pat`/`pat_bindings` shape — accumulates pattern-
# bound names into a [String] for invariant (b)'s scope check.
fn inv_pat_names(p: Pattern, acc: [String]) : [String] {
  match p.pkind {
    PWild         -> acc
    PLit(_)       -> acc
    PRange(_, _)  -> acc
    PBind(name)   -> [name, ...acc]
    PList(pats, opt_rest) -> {
      let a = inv_pats_names(pats, acc)
      match opt_rest { Some(r) -> [r, ...a] None -> a }
    }
    PVariant(_, _, subs)     -> inv_pats_names(subs, acc)
    PVariantRecord(_, _, fs) -> inv_pfields_names(fs, acc)
    PRecord(fs)              -> inv_pfields_names(fs, acc)
    PHole(_)                 -> acc
    PAs(name, sub)           -> inv_pat_names(sub, [name, ...acc])
    PNarrow(name, _)         -> [name, ...acc]
    PSurface(sp)             -> inv_pats_names(patsurface_children(sp), acc)
  }
}

fn inv_pats_names(ps: [Pattern], acc: [String]) : [String] {
  match ps {
    [] -> acc
    [p, ...rest] -> inv_pats_names(rest, inv_pat_names(p, acc))
  }
}

fn inv_pfields_names(fs: [PField], acc: [String]) : [String] {
  match fs {
    [] -> acc
    [pf, ...rest] -> match pf {
      PField(_, sub, _) -> inv_pfields_names(rest, inv_pat_names(sub, acc))
    }
  }
}

fn validate_inv_expr(e: Expr, file: String, bound: [String], errs: Int) : Int / Console + File {


  # Invariant (a) — "every Expr has Some(ty) post-finalise" — was
  # too strict: post-typer rewrite passes (`try_rewrite_proto_call`,
  # the AST splicer in `desugar_interp`, etc.) construct fresh
  # `mk_expr(...)` nodes whose `ty` is None
  # by design — the rewriters are syntactic and have no typer
  # substitution to apply. A useful (a) needs a "this node was
  # constructed by a post-typer pass" tracker that today does not
  # exist. Deferred until that tracker is justified — the original
  # bug class (`10a1e7b`, discarded typed clause body) is already
  # covered by the audit done in `7bd5a68`.
  let e_bc = validate_inv_kind(e.kind, e.ty, file, e.line, e.col, bound, errs)
  validate_inv_subexprs(e.kind, file, bound, e_bc)
}

fn validate_inv_kind(k: ExprKind, ty: Option[Ty], file: String,
                      line: Int, col: Int, bound: [String], errs: Int) : Int / Console + File {


  match k {
    EVar(name) -> {
      let opname = strip_proto_dispatcher_prefix(name)
      # Invariant (b): every `EVar(__proto_X)` reference has `X`
      # outside every enclosing binder. Catches the scope-blind
      # `rename_proto_calls` pattern (`257b247`).
      # Only check references that are dispatcher-shaped
      # (`__proto_X`); a bare user identifier whose name happens to
      # match a binder is fine.
      if name == opname { errs }
      else if list_has(bound, opname) {
        diag_error(file, line, col,
          concat_all(["rep invariant (b): protocol-dispatcher reference `",
                      name, "` shadows local binder `", opname,
                      "` in scope (rename pass missed scope tracking)"]))
        errs + 1
      } else { errs }
    }
    # Invariant (c) — "every `synth_lambda`-produced TyFnT has open
    # row tail" — was attempted as a post-finalise check on
    # ELambda's `.ty`. It over-fires: unification can legitimately
    # bind a fresh open row var to a closed row when the call site
    # expects a closed row (e.g., `list_sort_by`'s `cmp: (a, a) ->
    # Int` declares no row). Post-finalise we cannot distinguish
    # "the row was closed by default at construction" from "the row
    # was closed by unification to a concrete callee type". The
    # check belongs at the construction site (inside `synth_lambda`,
    # as an assertion on `lam_row.tail`), not as a post-hoc walker.
    # Keep audit at the construction site as the real defense; this
    # walker exits early on ELambda.
    _ -> errs
  }
}

fn validate_inv_subexprs(k: ExprKind, file: String, bound: [String], errs: Int) : Int / Console + File {


  match k {
    ECall(c, xs) -> {
      let e1 = validate_inv_expr(c, file, bound, errs)
      validate_inv_exprs(xs, file, bound, e1)
    }
    EField(b, _) -> validate_inv_expr(b, file, bound, errs)
    EIndex(a, b) -> {
      let e1 = validate_inv_expr(a, file, bound, errs)
      validate_inv_expr(b, file, bound, e1)
    }
    EBinop(_, a, b) -> {
      let e1 = validate_inv_expr(a, file, bound, errs)
      validate_inv_expr(b, file, bound, e1)
    }
    EUnop(_, x) -> validate_inv_expr(x, file, bound, errs)
    EIf(c, t_, eo) -> {
      let e1 = validate_inv_expr(c, file, bound, errs)
      let e2 = validate_inv_expr(t_, file, bound, e1)
      match eo { Some(b) -> validate_inv_expr(b, file, bound, e2) None -> e2 }
    }
    EMatch(scr, arms) -> {
      let e1 = validate_inv_expr(scr, file, bound, errs)
      validate_inv_arms(arms, file, bound, e1)
    }
    ELambda(ps, body) -> {
      let bound1 = inv_param_names(ps, bound)
      validate_inv_expr(body, file, bound1, errs)
    }
    ERecordLit(_, _, fis) -> validate_inv_fields(fis, file, bound, errs)
    EList(els) -> validate_inv_list_elems(els, file, bound, errs)
    ERange(a, b, sopt) -> {
      let e1 = validate_inv_expr(a, file, bound, errs)
      let e2 = validate_inv_expr(b, file, bound, e1)
      match sopt { Some(s) -> validate_inv_expr(s, file, bound, e2) None -> e2 }
    }
    EBlock(stmts, tail) -> {
      let r = validate_inv_block(stmts, file, bound, errs)
      match tail { Some(t) -> validate_inv_expr(t, file, r.bound, r.errs) None -> r.errs }
    }
    EPipe(a, b) -> {
      let e1 = validate_inv_expr(a, file, bound, errs)
      validate_inv_expr(b, file, bound, e1)
    }
    EMapPipe(a, b) -> {
      let e1 = validate_inv_expr(a, file, bound, errs)
      validate_inv_expr(b, file, bound, e1)
    }
    EFlatMapPipe(a, b) -> {
      let e1 = validate_inv_expr(a, file, bound, errs)
      validate_inv_expr(b, file, bound, e1)
    }
    EFilterPipe(a, b) -> {
      let e1 = validate_inv_expr(a, file, bound, errs)
      validate_inv_expr(b, file, bound, e1)
    }
    EHandle(body, _, _, _, init_opt, alias_opt, clauses, ret_opt) -> {
      let e0 = match init_opt { Some(ie) -> validate_inv_expr(ie, file, bound, errs) None -> errs }
      let bound_body = match alias_opt { Some(a) -> [a, ...bound] None -> bound }
      let e1 = validate_inv_expr(body, file, bound_body, e0)
      let e2 = validate_inv_clauses(clauses, file, bound, e1)
      match ret_opt {
        Some(r) -> match r {
          HR(p, b, _, _) -> validate_inv_expr(b, file, [p, ...bound], e2)
        }
        None -> e2
      }
    }
    EBang(inner) -> validate_inv_expr(inner, file, bound, errs)
    ELitUnit(inner, _) -> validate_inv_expr(inner, file, bound, errs)
    _ -> errs
  }
}

fn validate_inv_exprs(xs: [Expr], file: String, bound: [String], errs: Int) : Int / Console + File {


  match xs {
    [] -> errs
    [h, ...rest] -> validate_inv_exprs(rest, file, bound,
                                          validate_inv_expr(h, file, bound, errs))
  }
}

fn validate_inv_arms(arms: [Arm], file: String, bound: [String], errs: Int) : Int / Console + File {


  match arms {
    [] -> errs
    [a, ...rest] -> match a {
      Arm(p, g, b) -> {
        let bound1 = inv_pat_names(p, bound)
        let e1 = match g { Some(gx) -> validate_inv_expr(gx, file, bound1, errs) None -> errs }
        let e2 = validate_inv_expr(b, file, bound1, e1)
        validate_inv_arms(rest, file, bound, e2)
      }
    }
  }
}

fn validate_inv_fields(fs: [FieldInit], file: String, bound: [String], errs: Int) : Int / Console + File {


  match fs {
    [] -> errs
    [f, ...rest] -> match f {
      FI(_, v) -> validate_inv_fields(rest, file, bound,
                                          validate_inv_expr(v, file, bound, errs))
    }
  }
}

fn validate_inv_list_elems(els: [ListElem], file: String, bound: [String],
                              errs: Int) : Int / Console + File {


  match els {
    [] -> errs
    [el, ...rest] -> {
      let e1 = match el {
        ElPlain(x)  -> validate_inv_expr(x, file, bound, errs)
        ElSpread(x) -> validate_inv_expr(x, file, bound, errs)
      }
      validate_inv_list_elems(rest, file, bound, e1)
    }
  }
}

type InvBlockRes = { errs: Int, bound: [String] }

fn validate_inv_block(stmts: [Stmt], file: String, bound: [String],
                         errs: Int) : InvBlockRes / Console + File {


  match stmts {
    [] -> InvBlockRes { errs: errs, bound: bound }
    [s, ...rest] -> match s {
      SLet(p, _, rhs) -> {
        let e1 = validate_inv_expr(rhs, file, bound, errs)
        let bound1 = inv_pat_names(p, bound)
        validate_inv_block(rest, file, bound1, e1)
      }
      SVar(name, _, rhs, _, _) -> {
        let e1 = validate_inv_expr(rhs, file, bound, errs)
        validate_inv_block(rest, file, [name, ...bound], e1)
      }
      SAssert(c, m) -> {
        let e1 = validate_inv_expr(c, file, bound, errs)
        let e2 = match m { Some(mx) -> validate_inv_expr(mx, file, bound, e1) None -> e1 }
        validate_inv_block(rest, file, bound, e2)
      }
      SExprStmt(x) -> {
        let e1 = validate_inv_expr(x, file, bound, errs)
        validate_inv_block(rest, file, bound, e1)
      }
      SAssign(b, v, _, _) -> {
        let e1 = validate_inv_expr(b, file, bound, errs)
        let e3 = validate_inv_expr(v, file, bound, e1)
        validate_inv_block(rest, file, bound, e3)
      }
      SIndexAssign(b, i, v, _, _) -> {
        let e1 = validate_inv_expr(b, file, bound, errs)
        let e2 = validate_inv_expr(i, file, bound, e1)
        let e3 = validate_inv_expr(v, file, bound, e2)
        validate_inv_block(rest, file, bound, e3)
      }
      # m7e §25: SUse has no expression and binds nothing.
      SUse(_, _, _) -> validate_inv_block(rest, file, bound, errs)
    }
  }
}

fn validate_inv_clauses(cs: [HClause], file: String, bound: [String],
                          errs: Int) : Int / Console + File {


  match cs {
    [] -> errs
    [c, ...rest] -> match c {
      HC(_, ps, b, _, _) -> {
        let bound1 = inv_param_names(ps, bound)
        let e1 = validate_inv_expr(b, file, bound1, errs)
        validate_inv_clauses(rest, file, bound, e1)
      }
    }
  }
}

# Issue #341 Form 1: recover the concrete dispatch head from a
# return-typed op against the inferred return `Ty`. Three cases by how
# many times `Self` occurs in the declared return:
#
#   0 — the op's declared return is a concrete type (`op() : Int` for a
#       `protocol P { op() : Int }` whose impl target is keyed by that
#       head). The dispatch head is the inferred return's head directly,
#       preserving the pre-#341 `ty_head_name(ret_ty)` behaviour.
#   1 — `Self` appears once, possibly NESTED: `default() : Self` reads
#       the inferred head; `from_string(s) : Result[Self, String]` aligns
#       `Result[Self, String]` against `Result[Int, String]` and reads
#       the head at Self's position (`Int`).
#   >1 — a multi-Self return (`(Self, Self)`) has no single dispatch
#       head, so we decline and leave the runtime dispatcher in place.
#
# Returns None when the shapes do not align (the inferred return is
# still a tyvar, or a structural mismatch the unifier would have
# already rejected).
fn self_head_in_ret(declared: TypeExpr, inferred: Ty) : Option[DispHead] {
  let n = te_self_count(declared)
  if n == 0 { ty_disp_head(inferred) }
  else if n == 1 { align_self_head(declared, inferred) }
  else { None }
}

# Count the `Self` mentions in a declared return TypeExpr. Used to gate
# `self_head_in_ret` to the single-Self case.
fn te_self_count(te: TypeExpr) : Int = te_kind_self_count(te.tkind)

fn te_kind_self_count(k: TyKind) : Int {
  match k {
    TyName(_, name, targs) ->
      (if name == "Self" { 1 } else { 0 }) + te_list_self_count(targs)
    TyList(inner) -> te_self_count(inner)
    TyFn(ps, r, _) -> te_list_self_count(ps) + te_self_count(r)
    TyDim(base, _) -> te_self_count(base)
    TyRefine(base, _) -> te_self_count(base)
    # issue #772: a compound row carries effect labels, never `Self`.
    TyRow(_) -> 0
    TySurface(ts) -> te_list_self_count(tysurface_children(ts))
  }
}

fn te_list_self_count(tes: [TypeExpr]) : Int = match tes {
  [] -> 0
  [t, ...rest] -> te_self_count(t) + te_list_self_count(rest)
}

# Parallel walk of a declared TypeExpr (carrying `Self`) against the
# inferred concrete Ty, returning `ty_head_name` of the inferred type
# at the position the declared shape names `Self`. The two shapes are
# the same constructor at every step (the typer already unified them),
# so the walk pairs children positionally and recurses until it lands
# on the `Self` leaf.
fn align_self_head(declared: TypeExpr, inferred: Ty) : Option[DispHead] {
  match declared.tkind {
    TyName(_, name, targs) ->
      if name == "Self" { ty_disp_head(inferred) }
      else { align_self_in_args(targs, ty_con_args(inferred)) }
    TyList(inner) -> {
      match inferred {
        TyListT(elem) -> align_self_head(inner, elem)
        _             -> None
      }
    }
    TyDim(base, _)    -> align_self_head(base, ty_strip_dim(inferred))
    TyRefine(base, _) -> align_self_head(base, ty_strip_refine(inferred))
    TyFn(_, _, _)     -> None
    # issue #772: a compound row is never a `Self`-bearing position.
    TyRow(_)          -> None
    TySurface(_)      -> panic("align_self_head: surface type not lowered")
  }
}

# Walk paired declared/inferred argument lists; the one carrying `Self`
# (guaranteed unique by the `te_self_count == 1` gate) yields the head.
fn align_self_in_args(decls: [TypeExpr], infs: [Ty]) : Option[DispHead] {
  match decls {
    [] -> None
    [d, ...drest] -> {
      match infs {
        []           -> None
        [i, ...irest] ->
          if te_self_count(d) == 1 { align_self_head(d, i) }
          else { align_self_in_args(drest, irest) }
      }
    }
  }
}

# The type arguments of a constructor-headed inferred Ty, in the same
# positional order the declared `TyName(_, targs)` enumerates them.
# Non-constructor types (a still-unresolved tyvar) yield `[]`, so the
# paired walk runs dry and the caller declines.
# `tas` (not `args`): a binding named `args` resolves to the core
# `args()` CLI-arguments builtin, not the bound pattern variable
# (the param-shadow trap), silently returning a closure here.
fn ty_con_args(t: Ty) : [Ty] {
  match t {
    TyCon(_, _, tas, _)   -> tas
    TyListT(elem)      -> [elem]
    TyDimT(base, _)    -> ty_con_args(base)
    TyRefineT(base, _) -> ty_con_args(base)
    _                  -> []
  }
}

fn ty_strip_dim(t: Ty) : Ty = match t {
  TyDimT(base, _) -> base
  _               -> t
}

fn ty_strip_refine(t: Ty) : Ty = match t {
  TyRefineT(base, _) -> base
  _                  -> t
}

# Issue #180: variant accepting the call's surrounding return type so
# `from(x) : Self`-style ops can resolve Self via the expected type
# rather than the (absent) Self argument. Falls back to the legacy
# arg-driven dispatch when ret_ty is None or Self is informed by args.
#
# Issue #341 Form 1: Self may sit NESTED in the return type
# (`from_string(s) : Result[Self, String]`), so the candidate-specific
# Self head is recovered per op via `self_head_in_ret` rather than from
# the outermost `ty_head_name(ret_ty)` (which would read `Result`).
fn try_rewrite_proto_call_with_ret(callee: Expr, args_: [Expr],
                                     reg: ProtocolReg,
                                     cm: Option[String],
                                     ret_ty: Option[Ty]) : Option[ExprKind] {
  match try_rewrite_proto_call(callee, args_, reg, cm) {
    Some(rk) -> Some(rk)
    None -> {
      # Last-ditch: recover Self from the return type's Self position.
      match ret_ty {
        None -> None
        Some(ty) -> match proto_callee_kind(callee.kind) {
          EVar(name) -> {
            let opname = strip_proto_dispatcher_prefix(name)
            if name == opname or not list_has(reg.op_names, opname) { None }
            else {
              # Issue #546: a return-typed op (`from(x) : Self`) may
              # also be declared by more than one protocol. Try each
              # candidate against its own return-derived Self type.
              # Decline while any argument's type is still unresolved
              # (no head) — dispatching then would be premature.
              match args_disp_heads(args_) {
                None -> None
                Some(_) ->
                  try_rewrite_ret_candidates(proto_cands_own_first(proto_ops_lookup_all(reg, opname), cm),
                                             callee, args_, reg, cm, opname, ty)
              }
            }
          }
          _ -> None
        }
      }
    }
  }
}

# Issue #546: the return-typed-Self counterpart of
# `try_rewrite_proto_candidates`. Walks every protocol declaring
# `opname` and returns the first whose impl table matches the
# return-derived Self + the other args. Each candidate recovers its own
# Self head from its declared return type aligned against `ret_ty`
# (issue #341 Form 1), so a nested-Self return (`Result[Self, String]`)
# dispatches correctly. `None` when no candidate matches, preserving
# the prior behaviour.
fn try_rewrite_ret_candidates(cands: [ProtoOpReg], callee: Expr,
                               args_: [Expr], reg: ProtocolReg,
                               cm: Option[String],
                               opname: String, ret_ty: Ty) : Option[ExprKind] {
  match cands {
    [] -> None
    [po, ...rest] -> match po {
      POR(_, _, params, ret_te, _, _, pmo, pkey) ->
        # Arity guard: skip a candidate whose arity differs from the
        # call (an arity-ambiguous name reaches both protocols' POR).
        if list_length(params) != list_length(args_) {
          try_rewrite_ret_candidates(rest, callee, args_, reg, cm, opname, ret_ty)
        }
        # A protocol the calling module cannot see is not a dispatch
        # candidate for its bare calls.
        else if not proto_visible_from(reg.origins, pkey, pmo, cm) {
          try_rewrite_ret_candidates(rest, callee, args_, reg, cm, opname, ret_ty)
        }
        # Only ops whose Self is informed SOLELY by the return position
        # are dispatched here. When Self also appears in a parameter
        # (`show(x: Self) : String`), arg-driven dispatch in
        # `try_rewrite_proto_call` owns it; second-guessing via the
        # return head would misroute a no-impl receiver (e.g. `Bare`
        # with no `impl Show`) onto an unrelated impl whose head happens
        # to equal the concrete return head (`String`).
        else if not proto_op_self_only_in_return(params, ret_te,
                       proto_shape_carriers_at(reg.tparams, pkey)) {
          try_rewrite_ret_candidates(rest, callee, args_, reg, cm, opname, ret_ty)
        } else {
          match self_head_in_ret(ret_te, ret_ty) {
            None -> try_rewrite_ret_candidates(rest, callee, args_, reg, cm,
                                               opname, ret_ty)
            Some(self_head) ->
              match find_impl_by_recv(impl_pool(reg, pkey, dh_name(self_head)), pkey, opname, self_head) {
                Some(p) -> {
                  let new_callee = pimpl_ref(reg, p, callee)
                  Some(ECall(new_callee, args_))
                }
                None -> try_rewrite_ret_candidates(rest, callee, args_, reg, cm,
                                                   opname, ret_ty)
              }
          }
        }
    }
  }
}

# Only a dispatcher is dispatched: the resolver turned every use that
# reaches a protocol operation into one, so a local or a declaration
# that shares an operation's spelling never reaches the impl table.
fn proto_callee_kind(k: ExprKind) : ExprKind = match k {
  ESym(s, _, n) -> if sym_is_local(s) { k } else { EVar(n) }
  _             -> k
}

fn try_rewrite_proto_call(callee: Expr, args_: [Expr],
                            reg: ProtocolReg,
                            cm: Option[String]) : Option[ExprKind] {
  match proto_callee_kind(callee.kind) {
    EVar(name) -> {
      let opname = strip_proto_dispatcher_prefix(name)
      if name == opname or not list_has(reg.op_names, opname) { None }
      else {
        # Issue #180: with heterogeneous P[A] dispatch, the receiver
        # is no longer always args[0]. We need to consider every
        # argument as a candidate Self and find the impl whose
        # arg-name list matches the OTHER arguments.
        #
        # Issue #546: when two protocols declare an op with the same
        # name, the bare-name call site carries no protocol — only the
        # receiver type disambiguates. Iterate every protocol declaring
        # this op and pick the first that has an impl for the receiver.
        # The caller's own protocol ranks first: with a contested name,
        # a module's bare call binds its own declaration, exactly as
        # The scope chain resolves the name for impl validation.
        try_rewrite_proto_candidates(proto_cands_own_first(proto_ops_lookup_all(reg, opname), cm),
                                     callee, args_, reg, cm, opname)
      }
    }
    # `m.__proto_op`: the interpolation sugar's `show`, homed at the core
    # protocol. The qualifier selects the protocols declared by `m`.
    EModCall(m, name) -> {
      let opname = strip_proto_dispatcher_prefix(name)
      if name == opname or not list_has(reg.op_names, opname) { None }
      else {
        try_rewrite_proto_candidates(pcof_matching(proto_ops_lookup_all(reg, opname), Some(m)),
                                     callee, args_, reg, cm, opname)
      }
    }
    _ -> None
  }
}

# Issue #546: try each protocol declaring `opname` in registry order,
# returning the first whose impl table has an entry for the receiver
# type. Candidates whose Self appears only in the return position carry
# no arg-borne Self information, so they are skipped here and left to
# the `_with_ret` wrapper. Returning `None` when no candidate matches
# preserves the prior single-protocol behaviour (residual dispatcher
# kept for the polymorphic / no-impl paths).
fn try_rewrite_proto_candidates(cands: [ProtoOpReg], callee: Expr,
                                 args_: [Expr], reg: ProtocolReg,
                                 cm: Option[String],
                                 opname: String) : Option[ExprKind] = {
  let ms = proto_matches_for(cands, args_, reg, cm, opname)
  # Two homes serving the same receiver at the head tier: the call
  # stays a dispatcher and `validate_proto_call_at` names them.
  if proto_matches_ambiguous(ms) { None }
  else { match ms {
    [] -> None
    [PMatch(_, _, p), ..._] ->
      Some(ECall(pimpl_ref(reg, p, callee), args_))
  } }
}

# The impl function a dispatched call reaches, by its identity.
fn pimpl_ref(reg: ProtocolReg, p: ProtoImplReg, at: Expr) : Expr = {
  let home = match p { PIR(_, _, _, _, _, _, mo, _, _) -> match mo { Some(m) -> m  None -> reg.root } }
  mk_expr(ESym(sym_derive(NCFn, pir_sym(p), home), spec_none(), pir_sym(p)), at.line, at.col)
}

# The protocols among `cands` whose impl table serves `args_`, ranked
# (proto_rank). A candidate is skipped when its arity differs from the
# call, when the calling module cannot see it, or when `Self` (or the
# `Shape` carrier) informs dispatch from the return position alone —
# the `_with_ret` wrapper owns that shape.
fn proto_matches_for(cands: [ProtoOpReg], args_: [Expr], reg: ProtocolReg,
                     cm: Option[String], opname: String) : [ProtoMatch] =
  proto_ranked_matches(cands, cm, reg.cores, (po) => proto_serves(po, args_, reg, cm, opname))

fn proto_serves(po: ProtoOpReg, args_: [Expr], reg: ProtocolReg,
                cm: Option[String], opname: String) : Option[ProtoImplReg] = match po {
  POR(_, _, params, ret, _, _, pmo, psym) -> {
    let skip = list_length(params) != list_length(args_) or
               not proto_visible_from(reg.origins, psym, pmo, cm) or
               proto_op_self_only_in_return(params, ret,
                 proto_shape_carriers_at(reg.tparams, psym))
    if skip { None }
    else { find_proto_impl_for_args(reg, psym, opname, args_) }
  }
}

# True when the arguments carry no dispatch information: `Self` (or the
# protocol's `Shape` carrier) appears in the return position alone, or
# the op takes no arguments at all. Such ops resolve against the
# surrounding expected type. An op with arguments that names `Self`
# nowhere dispatches on them like any other.
fn proto_op_self_only_in_return(params: [Param], ret: TypeExpr,
                                carriers: [String]) : Bool {
  let in_params = list_any(params, (p) => match p.ptype {
    Some(te) -> te_mentions_self_or_carrier(te, carriers)
    None -> false
  })
  not in_params and (te_mentions_self_or_carrier(ret, carriers) or list_length(params) == 0)
}

# The surface names of a protocol's `Shape`-kind tparams — the dispatch
# carriers whose applied form `s[A]` a call resolves against, mirroring
# how `Self` informs an ordinary protocol's dispatch.
# Two same-named protocols may declare different tparam lists, so a
# dispatch candidate reads its own, never the first-registered
# homonym's.
fn proto_shape_carriers_at(tps: [ProtoTPReg], psym: SymId) : [String] =
  shape_carrier_names(proto_scope_tparams(tps, psym), [])

# True when a protocol quantifies over a `Shape` carrier — dispatch is
# single on the container, so a two-arg op is not heterogeneous.
fn proto_is_shape_carrier_at(tps: [ProtoTPReg], psym: SymId) : Bool =
  match proto_shape_carriers_at(tps, psym) { [] -> false _ -> true }

fn proto_has_tparams_at(tps: [ProtoTPReg], psym: SymId) : Bool =
  match proto_scope_tparams(tps, psym) { [] -> false _ -> true }

fn shape_carrier_names(names: [String], acc: [String]) : [String] = match names {
  [] -> list_reverse(acc)
  [n, ...rest] ->
    if tp_kind_is_shape(n) { shape_carrier_names(rest, [tp_strip_kind(n), ...acc]) }
    else { shape_carrier_names(rest, acc) }
}

fn list_any(xs: [Param], f: (Param) -> Bool) : Bool = match xs {
  [] -> false
  [x, ...rest] -> if f(x) { true } else { list_any(rest, f) }
}

fn te_mentions_self(te: TypeExpr) : Bool = te_kind_mentions_self(te.tkind)

fn te_kind_mentions_self(k: TyKind) : Bool {
  match k {
    TyName(_, name, targs) ->
      if name == "Self" { true }
      else { te_list_mentions_self(targs) }
    TyList(inner) -> te_mentions_self(inner)
    TyFn(ps, r, _) -> te_list_mentions_self(ps) or te_mentions_self(r)
    TyDim(base, _) -> te_mentions_self(base)
    TyRefine(base, _) -> te_mentions_self(base)
    # issue #772: a compound row carries effect labels, never `Self`.
    TyRow(_) -> false
    TySurface(ts) -> te_list_mentions_self(tysurface_children(ts))
  }
}

# As `te_mentions_self` but also treats a `Shape`-carrier head as a
# dispatch informant: `xs: s[A]` with `s` the protocol carrier makes the
# op arg-dispatched, exactly as `xs: Self` would.
fn te_mentions_self_or_carrier(te: TypeExpr, carriers: [String]) : Bool =
  te_kind_mentions_self_or_carrier(te.tkind, carriers)

fn te_kind_mentions_self_or_carrier(k: TyKind, carriers: [String]) : Bool {
  match k {
    TyName(_, name, targs) ->
      if name == "Self" or list_has(carriers, name) { true }
      else { te_list_mentions_self_or_carrier(targs, carriers) }
    TyList(inner) -> te_mentions_self_or_carrier(inner, carriers)
    TyFn(ps, r, _) -> te_list_mentions_self_or_carrier(ps, carriers) or
                      te_mentions_self_or_carrier(r, carriers)
    TyDim(base, _) -> te_mentions_self_or_carrier(base, carriers)
    TyRefine(base, _) -> te_mentions_self_or_carrier(base, carriers)
    TyRow(_) -> false
    TySurface(ts) -> te_list_mentions_self_or_carrier(tysurface_children(ts), carriers)
  }
}

fn te_list_mentions_self_or_carrier(tes: [TypeExpr], carriers: [String]) : Bool = match tes {
  [] -> false
  [t, ...rest] -> if te_mentions_self_or_carrier(t, carriers) { true }
                  else { te_list_mentions_self_or_carrier(rest, carriers) }
}

fn te_list_mentions_self(tes: [TypeExpr]) : Bool = match tes {
  [] -> false
  [t, ...rest] -> if te_mentions_self(t) { true } else { te_list_mentions_self(rest) }
}

# Issue #180: walk the impl table looking for the impl whose
# (receiver, [arg names]) matches the typed argument expressions.
# Pass 1 honours the proto-arg list on the impl entry — this catches
# both the homogeneous default (arg_names=[] treated as [recv]) AND
# heterogeneous matches (`impl Add[Real] for Complex`). Pass 2 (only
# for 2-arg binops) flips the receiver and tries the mirror impl.
# Beyond two args (single-dispatch ops with multiple non-receiver
# parameters like `pow_int(self, exp)`), only Pass 1 with
# `arg_names_match` against [recv] applies — `find_impl_legacy`
# does that. The legacy `find_impl_for` (no arg-name filter) is
# kept around for unrelated callers.
# The impl candidates a `(proto, recv)` lookup must consider: the
# `(proto, recv)` bucket when the index is built, else the whole table.
# Every `find_impl_*` filter keys on `t == recv`, so the bucket holds
# exactly the entries the linear scan would not skip, in the same order.
fn impl_pool(reg: ProtocolReg, proto: SymId, recv: String) : [ProtoImplReg] =
  if ii_built(reg.impl_index) { ii_key_bucket(reg.impl_index, proto, recv) }
  else { reg.impls }

# `pkey` is the protocol's identity: it keys the impl table and the
# protocol's own tparam list — a contested name must not read a
# homonym's.
fn find_proto_impl_for_args(reg: ProtocolReg, pkey: SymId, opname: String,
                             args_: [Expr]) : Option[ProtoImplReg] {
  # A `Shape`-carrier protocol dispatches single, on the container arg;
  # its ops carry ordinary function parameters (`map(xs, f)`) whose types
  # have no dispatch head. Read the head from the first container-typed
  # argument and ignore the rest, so a function arg does not veto the
  # lookup the way `args_disp_heads` (all-or-nothing) would.
  if proto_is_shape_carrier_at(reg.tparams, pkey) {
    match first_container_head(args_) {
      None -> None
      Some(a) -> find_impl_homogeneous(impl_pool(reg, pkey, dh_name(a)), pkey, opname, a)
    }
  } else {
  match args_disp_heads(args_) {
    None -> None
    Some(ns) -> match ns {
      [] -> None
      [a] -> find_impl_homogeneous(impl_pool(reg, pkey, dh_name(a)), pkey, opname, a)
      [a, b] -> {
        # A `Shape` carrier is the single dispatch container, NOT a
        # heterogeneous proto-arg — its ops (`map(xs, f)`) take an
        # ordinary function as the second parameter, so dispatch stays
        # single on the container `a`.
        let proto_takes_args = proto_has_tparams_at(reg.tparams, pkey) and
                               not proto_is_shape_carrier_at(reg.tparams, pkey)
        if not proto_takes_args {
          # Single-dispatch op whose second parameter is part of the
          # op shape (`Numeric.pow_int(Self, Int)` etc.). Only the
          # homogeneous (recv=a) lookup applies; the second arg is
          # not a proto-arg.
          find_impl_homogeneous(impl_pool(reg, pkey, dh_name(a)), pkey, opname, a)
        } else {
          # Pass 1a: heterogeneous (recv=a, proto_args=[b]) — covers
          #          `impl Add[Real] for Complex` for Complex + Real.
          # Pass 1b: homogeneous (recv=a) — covers `impl Add for
          #          Complex` for Complex + Complex.
          match find_impl_with_args(impl_pool(reg, pkey, dh_name(a)), pkey, opname, a, [b]) {
            Some(hit) -> Some(hit)
            None -> {
              match find_impl_homogeneous(impl_pool(reg, pkey, dh_name(a)), pkey, opname, a) {
                Some(hit) ->
                  if dh_same(a, b) { Some(hit) }
                  else { find_impl_with_args(impl_pool(reg, pkey, dh_name(b)), pkey, opname, b, [a]) }
                None -> find_impl_with_args(impl_pool(reg, pkey, dh_name(b)), pkey, opname, b, [a])
              }
            }
          }
        }
      }
      [a, ..._rest] -> find_impl_homogeneous(impl_pool(reg, pkey, dh_name(a)), pkey, opname, a)
    }
  }
  }
}

# The dispatch head of the first argument that carries a concrete type
# constructor (a container), skipping function-typed and unresolved
# args. This is the dispatch receiver for a `Shape`-carrier op.
fn first_container_head(args_: [Expr]) : Option[DispHead] = match args_ {
  [] -> None
  [e, ...rest] -> match e.ty {
    Some(ty) -> match ty_disp_head(ty) {
      Some(h) -> Some(h)
      None    -> first_container_head(rest)
    }
    None -> first_container_head(rest)
  }
}

# Find the impl entry whose `arg_names` is empty (legacy default) or
# is exactly `[recv]` (homogeneous parametrised form). Heterogeneous
# entries are skipped.
fn find_impl_homogeneous(impls: [ProtoImplReg], pname: SymId,
                          opname: String, recv: DispHead) : Option[ProtoImplReg] {
  match impls {
    [] -> None
    [it, ...rest] -> match it {
      PIR(_, _, o, _, ans, _, _, _, _) ->
        if pir_of_proto(it, pname) and o == opname and pir_serves(it, recv) and
           is_homogeneous_args(ans, dh_name(recv)) {
          Some(it)
        } else {
          find_impl_homogeneous(rest, pname, opname, recv)
        }
    }
  }
}

fn is_homogeneous_args(reg_args: [String], recv: String) : Bool = match reg_args {
  [] -> true
  [a] -> a == recv
  _ -> false
}

# The dispatch head of every argument, or None when any is unresolved.
fn args_disp_heads(args_: [Expr]) : Option[[DispHead]] = match args_ {
  [] -> Some([])
  [e, ...rest] -> match e.ty {
    None -> None
    Some(ty) -> match ty_disp_head(ty) {
      None -> None
      Some(h) -> match args_disp_heads(rest) {
        None -> None
        Some(hs) -> Some([h, ...hs])
      }
    }
  }
}

# The receiver's identity decides the impl; the proto-args still match
# by head name.
fn find_impl_with_args(impls: [ProtoImplReg], pname: SymId, opname: String,
                        recv: DispHead, args: [DispHead]) : Option[ProtoImplReg] {
  match impls {
    [] -> None
    [it, ...rest] -> match it {
      PIR(_, _, o, _, ans, _, _, _, _) ->
        if pir_of_proto(it, pname) and o == opname and pir_serves(it, recv) and
           arg_names_match(ans, dh_name(recv), dh_names(args)) {
          Some(it)
        } else {
          find_impl_with_args(rest, pname, opname, recv, args)
        }
    }
  }
}

# Issue #341 Form 1: receiver-only impl lookup for a return-typed op
# whose Self lives in the return position (`from_string(s) : Result[
# Self, String]`). `find_impl_with_args` cannot serve here — its
# `arg_names_match` treats the lone non-Self argument as the receiver
# (so `["String"]` would have to equal recv `"Int"`, which never
# holds). The op's params are genuine non-Self arguments already
# unified by the typer; single-dispatch v1 keys each impl uniquely on
# `(protocol, op, Self-type)`, so matching on those three is sound.
fn find_impl_by_recv(impls: [ProtoImplReg], pname: SymId, opname: String,
                      recv: DispHead) : Option[ProtoImplReg] {
  match impls {
    [] -> None
    [it, ...rest] -> match it {
      PIR(_, _, o, _, _, _, _, _, _) ->
        if pir_of_proto(it, pname) and o == opname and pir_serves(it, recv) { Some(it) }
        else { find_impl_by_recv(rest, pname, opname, recv) }
    }
  }
}

# Strip the `__proto_` dispatcher prefix the rename pass attaches.
# Names without the prefix pass through unchanged (so tests that
# bypass renaming still resolve).
# Stable partition: candidates homed in the calling module first,
# everyone else in their existing order. Only reorders when the
# caller's module itself declares the op's protocol.
fn proto_cands_own_first(cands: [ProtoOpReg],
                         cm: Option[String]) : [ProtoOpReg] = match cm {
  None -> cands
  Some(_) ->
    list_append(pcof_matching(cands, cm), pcof_rest(cands, cm))
}

fn pcof_matching(cands: [ProtoOpReg], cm: Option[String]) : [ProtoOpReg] =
  match cands {
    [] -> []
    [po, ...rest] -> match po {
      POR(_, _, _, _, _, _, pmo, _) ->
        if mo_eq(pmo, cm) { [po, ...pcof_matching(rest, cm)] }
        else { pcof_matching(rest, cm) }
    }
  }

fn pcof_rest(cands: [ProtoOpReg], cm: Option[String]) : [ProtoOpReg] =
  match cands {
    [] -> []
    [po, ...rest] -> match po {
      POR(_, _, _, _, _, _, pmo, _) ->
        if mo_eq(pmo, cm) { pcof_rest(rest, cm) }
        else { [po, ...pcof_rest(rest, cm)] }
    }
  }

fn strip_proto_dispatcher_prefix(name: String) : String {
  let pfx = "__proto_"
  let n_pfx = string_length(pfx)
  if string_length(name) <= n_pfx { name }
  else if string_slice(name, 0, n_pfx) == pfx {
    strip_arity_suffix(string_slice(name, n_pfx, string_length(name) - n_pfx))
  }
  else { name }
}

# Drop the `__a<N>` arity suffix an arity-ambiguous dispatcher carries
# (`f__a1` -> `f`). Scans the trailing digit run, then checks the `__a`
# marker right before it. Names without the shape pass through, so an
# op literally named `x__a` (no digits) is untouched.
fn strip_arity_suffix(name: String) : String {
  let n = string_length(name)
  let digit_start = scan_trailing_digits(name, n)
  let marker = "__a"
  let m = string_length(marker)
  if digit_start < n and digit_start >= m and
     string_slice(name, digit_start - m, m) == marker {
    string_slice(name, 0, digit_start - m)
  } else { name }
}

# Index of the first char of the trailing digit run (== `n` when the
# last char is not a digit). Walks backward from `n`.
fn scan_trailing_digits(s: String, n: Int) : Int {
  if n <= 0 { 0 }
  else {
    match char_at(s, n - 1) {
      Some(c) -> if c >= '0' and c <= '9' { scan_trailing_digits(s, n - 1) }
                 else { n }
      None -> n
    }
  }
}

# Map an inferred Ty back to its canonical "head-constructor" name —
# the same mangling proto_type_name applies on the impl side. Lists,
# Option, Result, and primitive builtins get their canonical names;
# user-defined records / sums use TyCon's name.
#[doc("The dispatch receiver a type presents: its head name and the identity of the declaration it names.")]
pub fn ty_disp_head(t: Ty) : Option[DispHead] = match ty_head_name(t) {
  Some(n) -> Some(DispHead(n, ty_head_sym(t)))
  None    -> None
}

#[doc("Root head name of a Ty for impl-table lookup (Int, List, the TyCon name, ...); None for tyvars/unions and other non-nominal heads.")]
pub fn ty_head_name(t: Ty) : Option[String] {
  match t {
    TyInt          -> Some("Int")
    TyReal         -> Some("Real")
    TyBool         -> Some("Bool")
    TyChar         -> Some("Char")
    TyString       -> Some("String")
    TyUnit         -> Some("Unit")
    TyByte           -> Some("Byte")
    TyInt32          -> Some("Int32")
    TyUInt32         -> Some("UInt32")
    TyUInt64         -> Some("UInt64")
    TyInt128         -> Some("Int128")
    TyHandle         -> Some("Handle")
    TyListT(_)     -> Some("List")
    TyCon(_, name, _, _) -> Some(name)
    # m12.5: a dimensioned value dispatches on the underlying base
    # type's head — `Decimal<USD>` → `Decimal`, mirroring the
    # `proto_type_name` collapse on the syntactic side.
    TyDimT(base, _) -> ty_head_name(base)
    # m12.6.x #1: refinements are transparent for protocol dispatch
    # — `Int where >= 0` and `Int` resolve to the same `impl`.
    TyRefineT(base, _) -> ty_head_name(base)
    TyVarT(_)      -> None
    # an unresolved shape app has no concrete head; dispatch is post-mono
    # once the shape var binds to a constructor, exactly like `TyVarT`.
    TyShapeApp(_, _) -> None
    TyFnT(_, _, _) -> None
    TyAny          -> None
    # issue #187 phase 1: a union has no single head type, so
    # protocol dispatch declines — Phase 2's resolver is what
    # forbids `impl P for Union` declarations; here we just signal
    # "no canonical head" the same way TyVarT does so callers fall
    # back to the diagnostic path.
    TyUnion(_)     -> None
  }
}

# Collision-aware: `opname` may be declared by several protocols
# (`add` by `Add[a]` and a user `Ring`). Returns an impl when ANY
# declaring protocol VISIBLE from `cm` has one for `tname`, so the
# post-rewrite validator does not fix the protocol to the wrong one
# and flag a spurious "no impl". Returns the owning protocol name
# alongside.
fn find_impl_any_proto(reg: ProtocolReg, opname: String,
                        recv: DispHead, cm: Option[String]) : Option[ImplHit] =
  find_impl_any_proto_loop(proto_ops_lookup_all(reg, opname), reg, opname, recv, cm)

#[doc("A resolved impl hit: the owning protocol and the impl fn symbol.")]
pub type ImplHit = ImplHit(String, String)

fn find_impl_any_proto_loop(cands: [ProtoOpReg], reg: ProtocolReg,
                             opname: String, recv: DispHead,
                             cm: Option[String]) : Option[ImplHit] {
  match cands {
    [] -> None
    [po, ...rest] -> match po {
      POR(pname, _, _, _, _, _, pmo, pkey) -> {
        if not proto_visible_from(reg.origins, pkey, pmo, cm) {
          find_impl_any_proto_loop(rest, reg, opname, recv, cm)
        } else {
          match find_impl_for(impl_pool(reg, pkey, dh_name(recv)), pkey, recv, opname) {
            Some(p) -> Some(ImplHit(pname, pir_sym(p)))
            None -> find_impl_any_proto_loop(rest, reg, opname, recv, cm)
          }
        }
      }
    }
  }
}

# First protocol name declaring `opname` (for diagnostics only).
fn first_proto_of_op(reg: ProtocolReg, opname: String) : String {
  match proto_ops_lookup_all(reg, opname) {
    [] -> "?"
    [po, ..._rest] -> match po { POR(pn, _, _, _, _, _, _, _) -> pn }
  }
}

fn find_impl_for(impls: [ProtoImplReg], pname: SymId, recv: DispHead,
                  opname: String) : Option[ProtoImplReg] {
  match impls {
    [] -> None
    [it, ...rest] -> match it {
      PIR(_, _, op, _, _, _, _, _, _) ->
        if pir_of_proto(it, pname) and op == opname and pir_serves(it, recv) { Some(it) }
        else { find_impl_for(rest, pname, recv, opname) }
    }
  }
}

# Which protocol a call may dispatch against, and what the registry
# holds for the one it picked. These read the registry's own tables by
# the protocol's identity, which the scope chain decided. An absent
# identity is no protocol and matches no row.

fn psc_same(a: SymId, b: SymId) : Bool = sym_raw(a) >= 0 and sym_raw(a) == sym_raw(b)

#[doc("The ops of the protocol `psym`, in declaration order.")]
pub fn proto_scope_ops(ops: [ProtoOpReg], psym: SymId) : [ProtoOpReg] =
  psc_ops_loop(ops, psym, [])

fn psc_ops_loop(ops: [ProtoOpReg], psym: SymId,
                acc: [ProtoOpReg]) : [ProtoOpReg] = match ops {
  [] -> acc
  [op, ...rest] -> match op {
    POR(_, _, _, _, _, _, _, s) ->
      if psc_same(s, psym) {
        psc_ops_loop(rest, psym, [op, ...acc])
      } else { psc_ops_loop(rest, psym, acc) }
  }
}

#[doc("The tparam names of the protocol `psym`; `[]` for monomorphic protocols.")]
pub fn proto_scope_tparams(tps: [ProtoTPReg], psym: SymId) : [String] = match tps {
  [] -> []
  [PTPR(_, names, _, s), ...rest] ->
    if psc_same(s, psym) { names }
    else { proto_scope_tparams(rest, psym) }
}

#[doc("The dispatch key the protocol `psym` spells its impl symbols with; `pname` when no protocol answers to `psym`.")]
pub fn proto_key_of(dkeys: [ProtoKey], pname: String, psym: SymId) : String = match dkeys {
  [] -> pname
  [PKey(_, _, k, s), ...rest] ->
    if psc_same(s, psym) { k }
    else { proto_key_of(rest, pname, psym) }
}

# A module sees its own protocols, root-file ones, and exported foreign
# ones. The root file sees every protocol.
#[doc("True when the protocol `psym`, declared by `home`, is a legal dispatch candidate for a call inside module `cm` (`None` = root file).")]
pub fn proto_visible_from(origins: [ProtoOriginReg], psym: SymId,
                          home: Option[String],
                          cm: Option[String]) : Bool = match cm {
  None -> true
  Some(_) -> match home {
    None -> true
    Some(_) ->
      if mo_eq(home, cm) { true } else { psc_is_pub(origins, psym) }
  }
}

fn psc_is_pub(origins: [ProtoOriginReg], psym: SymId) : Bool = match origins {
  [] -> false
  [PrOR(_, _, p, s), ...rest] ->
    if psc_same(s, psym) { p }
    else { psc_is_pub(rest, psym) }
}
