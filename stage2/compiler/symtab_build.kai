#[doc("""
Builds the symbol table from the entries a program declares.

Each entry declares its home's module symbol and then itself. Ids are
derived from the entry, so the table is a function of the set of
entries: reordering them or adding an unrelated declaration moves no id.

The entries come from the parser, which files one per declaration and
per constructor as it reads each name, and from every pass that creates
a declaration. A declaration node holds no name, so the stream is never
walked to recover one; `nt_collect` reads a stream's rows back from a
table that already holds them.

The buffers are sized before the fill. A pass that adds declarations
extends the table rather than rebuilding it, and a table that would
pass half load doubles first; either way the rows move into fresh
buffers and no id changes. `Mutable` is masked at each entry point: the
arrays are born there and nothing outside observes a write.
""")]

import compiler.decl_names
import compiler.symtab
import compiler.symtab_move
import compiler.ast
import compiler.written

#[doc("The symbol table for the entries `es` of a program whose root file is the module `target` and whose core modules are `cores`. `target` is declared even when nothing is homed there.")]
pub fn st_build(es: [NEnt], target: String, cores: [String]) : SymTab =
  st_fill(es, st_put_module(st_fresh(stb_pow2(4 * list_length(es) + 2, 8), st_module_id(target),
                                     map(cores, st_module_id)), target))

#[doc("The symbol table for an already-collected entry stream, of no program: every entry plus the module symbol of its home.")]
pub fn st_of_entries(es: [NEnt]) : SymTab =
  st_fill(es, st_with_cap(stb_pow2(4 * list_length(es), 8)))

#[doc("`t` with every entry of `es` declared too; a key `t` already holds changes nothing. `t` itself is left as it was.")]
pub fn st_extend(t: SymTab, es: [NEnt]) : SymTab =
  st_fill(es, st_refill(st_rows_of(t), st_fresh(t.cap, t.root, t.cores)))

# Each entry can bring a new module along, so `2n` rows at half load.
fn stb_pow2(n: Int, c: Int) : Int = if c >= n { c } else { stb_pow2(n, c * 2) }

fn st_fill(es: [NEnt], t: SymTab) : SymTab / Mutable = match es {
  [] -> t
  [NEnt(cls, name, home, exp, mint), ...rest] -> st_fill(rest, st_declare(t, cls, name, home, exp, mint))
}

# A key `t` already holds is the same symbol and changes nothing. A
# method is keyed by its impl block's scope and owned by that block's module.
fn st_declare(t: SymTab, cls: NCls, name: String, home: String,
      exp: Bool, mint: NMint) : SymTab / Mutable {
  let owner = match cls {
    NCMethod -> impl_scope_module(home)
    _        -> home
  }
  st_put(st_put_module(t, owner), cls, name, home, sym_raw(st_module_id(owner)), exp, mint)
}

fn st_put_module(t: SymTab, home: String) : SymTab / Mutable = st_put(t, NCModule, home, "", 0 - 1, true, NmSource)

#[doc("The id of the module symbol named `name`, the same whether or not a table holds it yet.")]
pub fn st_module_id(name: String) : SymId = sym_derive(NCModule, name, "")

#[doc("The id a table gives the declaration of `name`, of class `cls`, homed at `home`.")]
pub fn sym_derive(cls: NCls, name: String, home: String) : SymId = sym_derive_word(ncls_word(cls), name, home)

fn st_put(t: SymTab, cls: NCls, name: String, home: String, owner: Int,
      exp: Bool, mint: NMint) : SymTab / Mutable =
  if t.cap == 0 { st_put(st_grow(t), cls, name, home, owner, exp, mint) }
  else { st_put_at(t, sym_raw(sym_derive(cls, name, home)), cls, name, owner, exp, mint) }

fn st_put_at(t: SymTab, id: Int, cls: NCls, name: String, owner: Int,
      exp: Bool, mint: NMint) : SymTab / Mutable {
  let i = st_probe(t, id, id % t.cap)
  let held = array_get(t.ids, i) >= 0
  if held and st_same_key(t, i, cls, name, owner) { t }
  else if held { panic("symbol table: #{name} and #{array_get(t.names, i)} derive one id") }
  else if 2 * (t.count + 1) > t.cap { st_put_at(st_grow(t), id, cls, name, owner, exp, mint) }
  else { st_fill_slot(t, i, id, cls, written(name), owner, exp, mint) }
}

fn st_grow(t: SymTab) : SymTab = st_moved(t, stb_pow2(2 * t.cap, 8))

# Owners are themselves derived ids, so equal owners mean equal homes.
fn st_same_key(t: SymTab, i: Int, cls: NCls, name: String, owner: Int) : Bool =
  written_text(array_get(t.names, i)) == name and array_get(t.owners, i) == owner and
  ncls_same(array_get(t.classes, i), cls)

#[doc("The rows `tab` holds for what `decls` declares, in stream order: each declaration, and after a sum type its constructors. A declaration `tab` does not hold contributes nothing. `target` is the root file's module, the home of a form that carries a name and no origin.")]
pub fn nt_collect(decls: [Decl], tab: SymTab, target: String) : [NEnt] =
  ntc_loop(decls, tab, target, [])

fn ntc_loop(ds: [Decl], tab: SymTab, target: String, acc: [NEnt]) : [NEnt] = match ds {
  []           -> list_reverse(acc)
  [d, ...rest] -> ntc_loop(rest, tab, target, ntc_one(d, tab, target, acc))
}

fn ntc_one(d: Decl, tab: SymTab, target: String, acc: [NEnt]) : [NEnt] = match decl_transparent_inner(d) {
  Some(inner) -> ntc_one(inner, tab, target, acc)
  None -> match d {
    # A specialisation is no symbol: only the declaration itself has a row.
    DFn(_, f, _, _, _, _, _, _, _, _) ->
      if fnid_inst(f) == spec_none() { ntc_sym(tab, fnid_sym(f), acc) } else { acc }
    DConst(_, s, _, _, _, _, _)       -> ntc_sym(tab, s, acc)
    DEffect(_, s, _, _, _, _, _, _)   -> ntc_sym(tab, s, acc)
    DProtocol(_, s, _, _, _, _, _)    -> ntc_sym(tab, s, acc)
    DType(_, s, _, body, _, _, _, _)  -> ntc_variants(body, tab, ntc_sym(tab, s, acc))
    DKind(p, n, _, _, _, _, _, mo)    -> [NEnt(NCKind, n, ntc_home(mo, target), p, NmSource), ...acc]
    DUnit(p, n, _, _, _, _, mo)       -> [NEnt(NCUnit, n, ntc_home(mo, target), p, NmSource), ...acc]
    DExternType(n, _, _, _, mo)       -> [NEnt(NCExternType, n, ntc_home(mo, target), true, NmSource), ...acc]
    DAxiom(p, _, n, _, _, _, _, _, _, _) -> [NEnt(NCFn, n, target, p, NmSource), ...acc]
    _ -> acc
  }
}

fn ntc_home(mo: Option[String], target: String) : String = match mo {
  Some(m) -> m
  None    -> target
}

fn ntc_sym(tab: SymTab, s: SymId, acc: [NEnt]) : [NEnt] = match st_ent(tab, s) {
  Some(e) -> [e, ...acc]
  None    -> acc
}

fn ntc_variants(b: TypeBody, tab: SymTab, acc: [NEnt]) : [NEnt] = match b {
  TBSum(vs) -> ntc_variant_loop(vs, tab, acc)
  _         -> acc
}

fn ntc_variant_loop(vs: [Variant], tab: SymTab, acc: [NEnt]) : [NEnt] = match vs {
  []                   -> acc
  [Var(c, _), ...rest] -> ntc_variant_loop(rest, tab, ntc_sym(tab, c, acc))
}

#[doc("The protocol rows of `decls`, for a consumer that only sees the stream after the lowering replaced each `DProtocol` with dispatchers.")]
pub fn nt_protocols(decls: [Decl], tab: SymTab, target: String) : [NEnt] =
  nt_only(nt_collect(decls, tab, target), NCProtocol)
