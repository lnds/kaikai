#[doc("""
Builds the symbol table from a declaration stream.

Ids are assigned in stream order, so the table is a function of the
decl list alone — the same program always yields the same ids, which is
what lets a downstream artifact key on them.

The stream itself comes from `nt_collect`, the walker that already
knows every declaration form's home and every name class a form
contributes (a `type` contributes the habitant AND its constructors).
Reusing it keeps one walker authoritative: a new declaration form
teaches `nt_collect` once and both consumers learn it.

The buffers are sized before the fill, so the build is two passes over
the entries and allocates each column exactly once. `Mutable` is masked
at the entry point: the arrays are born inside it and nothing outside
observes a write.
""")]

import compiler.name_table
import compiler.symtab

#[doc("The symbol table for `decls`, whose untagged declarations belong to `target`.")]
pub fn st_build(decls: [Decl], target: String) : SymTab =
  st_of_entries(nt_collect(decls, target))

#[doc("The symbol table for an already-collected entry stream.")]
pub fn st_of_entries(es: [NEnt]) : SymTab {
  let n = list_length(es)
  let nb = st_nbuckets_build()
  st_fill(es, 0, SymTab { count: n,
                          names: array_make(n, ""),
                          homes: array_make(n, ""),
                          classes: array_make(n, NCFn),
                          scopes: array_make(n, ScProgram),
                          exported: array_make(n, false),
                          buckets: array_make(nb, []),
                          nbuckets: nb })
}

# Must agree with symtab's own bucket count: a table filled against one
# modulus and read against another loses every entry.
fn st_nbuckets_build() : Int = 32768

fn st_fill(es: [NEnt], i: Int, t: SymTab) : SymTab / Mutable = match es {
  [] -> t
  [e, ...rest] -> st_fill(rest, i + 1, st_put(t, i, e))
}

fn st_put(t: SymTab, i: Int, e: NEnt) : SymTab / Mutable = match e {
  NEnt(cls, name, home, exp) -> {
    let s = st_slot(name, t.nbuckets)
    SymTab { count: t.count,
             names: array_set(t.names, i, name),
             homes: array_set(t.homes, i, home),
             classes: array_set(t.classes, i, cls),
             scopes: array_set(t.scopes, i, ScHome(home)),
             exported: array_set(t.exported, i, exp),
             buckets: array_set(t.buckets, s, [i, ...array_get(t.buckets, s)]),
             nbuckets: t.nbuckets }
  }
}
