# compiler/const_scope.kai — module scoping for top-level const reads.
#
# Each decl's free reads of a colliding const name (see
# const_scope_table) rewrite to `EModCall(home, name)`: its own
# module's const first, else the first exported one of another
# module. Root reads stay bare — root consts carry no module_origin,
# and the emitters resolve a bare const read root-first. Lexically
# bound names are never rewritten (const_scope_walk).

import compiler.ast
import compiler.modules
import compiler.const_scope_table
import compiler.const_scope_walk

#[doc("Rewrite free reads of colliding const names to `EModCall(home, name)`, resolving each against the reading decl's own module first. Runs before rqc: a qualified `mod.CONST` read is keyed here, before the uppercase collapse can drop its module. `scopes`/`global_mt` give each decl its segment module table, so a qualifier written as a per-file import alias keys under its tagged name; pass empty tables when the stream's qualifiers are already tagged.")]
pub fn cs_scope_decls(decls: [Decl], coll: [CSEntry], target: String,
      scopes: [ModScope], global_mt: [ModuleEntry]) : [Decl] =
  if list_length(coll) == 0 { decls }
  else { cs_decls_loop(decls, coll, target, target, scopes, global_mt, []) }

fn cs_decls_loop(ds: [Decl], coll: [CSEntry], cur: String, target: String,
      scopes: [ModScope], global_mt: [ModuleEntry], acc: [Decl]) : [Decl] = match ds {
  [] -> list_reverse(acc)
  [d, ...rest] -> {
    let home = cs_reader_home(d, cur, target)
    let seg = if home == target { "" } else { home }
    let cx = CSCtx { coll: coll, home: home, target: target, free: true,
                     mt: ms_table(scopes, seg, global_mt) }
    cs_decls_loop(rest, coll, home, target, scopes, global_mt, [cs_decl(d, cx), ...acc])
  }
}

fn cs_decl(d: Decl, cx: CSCtx) : Decl = match d {
  DFn(p, n, tps, ps, ret, row, body, l, c, mo) ->
    DFn(p, n, tps, ps, ret, row, cs_expr(body, cs_params(ps, []), cx), l, c, mo)
  DConst(p, n, ty, body, mo, l, c) -> DConst(p, n, ty, cs_expr(body, [], cx), mo, l, c)
  DTest(n, body, l, c, mo)  -> DTest(n, cs_expr(body, [], cx), l, c, mo)
  DBench(n, body, l, c, mo) -> DBench(n, cs_expr(body, [], cx), l, c, mo)
  DCheck(n, ps, body, l, c, mo) -> DCheck(n, ps, cs_expr(body, cs_params(ps, []), cx), l, c, mo)
  DEffect(p, n, tps, ops, dblk, l, c, mo) -> match dblk {
    Some(DBlk(hcs, ret, bl, bc)) ->
      DEffect(p, n, tps, ops,
              Some(DBlk(cs_hclauses(hcs, [], cx), cs_hreturn_opt(ret, [], cx), bl, bc)),
              l, c, mo)
    None -> d
  }
  DImpl(pn, tas, fty, subs, l, c, ss) -> DImpl(pn, tas, fty, cs_sub_decls(subs, cx), l, c, ss)
  DDerive(ps, inner, l, c)    -> DDerive(ps, cs_decl(inner, cx), l, c)
  DUnstable(inner, l, c)      -> DUnstable(cs_decl(inner, cx), l, c)
  DProtoLaws(t, inner, l, c, mo)  -> DProtoLaws(t, cs_decl(inner, cx), l, c, mo)
  DImplAxiom(t, inner, l, c, mo)  -> DImplAxiom(t, cs_decl(inner, cx), l, c, mo)
  DConstructor(inner, l, c)   -> DConstructor(cs_decl(inner, cx), l, c)
  DDoc(r, t, inner, l, c)     -> DDoc(r, t, cs_decl(inner, cx), l, c)
  DAttr(r, inner, l, c)       -> DAttr(r, cs_decl(inner, cx), l, c)
  _ -> d
}

fn cs_sub_decls(ds: [Decl], cx: CSCtx) : [Decl] = match ds {
  [] -> []
  [d, ...rest] -> [cs_decl(d, cx), ...cs_sub_decls(rest, cx)]
}
