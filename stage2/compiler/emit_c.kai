# ====================================================================

# ---- BuildMode (build-wrapper selection, consumed by emit_program) ----

# `BuildMode` now lives in `emit_shared` so both the C-direct and the
# native backends import it without one depending on the other.

# Lane linus-a (Lane A of docs/stage2-quality-km-audit-2026-05-29.md):
# the emit walker used to thread five companion arguments through every
# recursive call — `lcs` (the binders in lexical scope), `fns` (the EFn registry),
# `variants` (the EVar registry), `lams` (collected lambdas) and `cls`
# (collected clause-infos). That data clump appeared in ~74 signatures
# and ~250 call-sites; adding any sixth piece of emit context meant
# touching all of them. `EmitCtx` bundles the five into one record so the
# walker passes a single `cx`. The only field that varies as the walker
# descends is `lcs` (each body/arm/clause extends the lexical scope); the
# other four are invariant for a whole `emit_program` run, so they are
# built once at entry. `emit_ctx_with_lcs` rebuilds the record with a new
# `lcs` for those descent points — semantically identical to the old
# `..., new_lcs, fns, variants, lams, cls` argument shuffle.
# `borrowed`: pattern binders the enclosing arm-top reuse bound BORROW (read
# from `_scr`'s slots without an incref, Koka insert_loop model). A
# `__perceus_dup` over such a binder lowers to a MOVE (the bare name, no
# kai_internal_dup): perceus inserted the dup assuming an owned bind, but the
# arm-top took ownership of the shell and the children move into the rebuild;
# the redundant dup is what kept the descent tree shared (rc>=2) and the
# reuse inert. Empty in every non-arm-top context → no behaviour change.
# `hoisted` carries, during emission of one match's arms, the set of
# `_scr` slot indices whose `.ptr` sub-deref has been hoisted to a C
# local `_hs<i>` at the top of the match's `do {}`. emit_pat_test /
# emit_pat_binds read it: when the sub-scrutinee of slot i off `_scr`
# is requested and i is hoisted, they spell `_hs<i>` instead of
# re-emitting `kai_var_slots(_scr)[i].ptr`. This shares the dependent
# load `slot[i].ptr->...` across the separate `if`-arms of a nested
# match (balance_left/right's rotations), which clang cannot CSE across
# branches. Empty outside a hoisting match. See emit_hoist_subderefs.
# `reuse_donor` carries, while emitting an arm-top-reuse body, the donor
# cell's constructor and its positional sub-pattern binders (`local_none()`
# for a slot with no usable PBind). A TRMC step that rebuilds the SAME ctor into
# `_arm_ru` (the donated scrutinee shell) can then SKIP the store of slot i
# when its rebuild arg is exactly the binder bound off slot i of the donor:
# the value is already in the cell (kai_drop_reuse_token hands back the
# shell intact). Writes only the changed slots (the TRMC hole + any
# permuted/transformed slot) — Koka's `_con->field = ...` single-store
# shape. None outside an arm-top-reuse body → every slot is written, the
# prior behaviour.
type ReuseDonor = ReuseDonor(SymId, [LocalId])

# `kind1_raw` — i64-inline (Lane B): the set of binders currently in
# scope that are bound to a kind-1 Int slot and emitted as the raw
# `int64_t kair_<nm>` (the bind is uniform across all routes). A read of a
# binder in this set is `kair_<nm>` when MUnboxed and `kai_int(kair_<nm>)` when
# MBoxed; a store of such a binder into a kind-1 slot is the raw
# `kair_<nm>` directly (no kai_take_int round-trip). Scoped per arm: each
# match arm body sees its own binders; the set is set entering the body
# and not inherited by sibling arms.
type EmitCtx = { lcs: [LocalId], fns: [EFn], fx: FnIndex, variants: [VariantEntry], lams: [LamInfo], cls: [ClauseInfo],
                 regions: [RegionMark], in_region: Bool, borrowed: [LocalId],
                 hoisted: [Int], reuse_donor: Option[ReuseDonor], kind1_raw: [LocalId],
                 # A const is a literal with a name. The emit catalogue
                 # carries every top-level const so a const read
                 # materialises as its literal body inline —
                 # no global, no boxing, no call. Same role `fns` /
                 # `variants` play for their idents.
                 consts: [Decl],
                 # Every effect decl, so a perform / handle / default-install
                 # site can read an effect's `module_origin` and
                 # mint the module-qualified evidence name (`ev_name`). Two
                 # same-name effects from different modules thus emit and
                 # reference distinct `Ev` structs.
                 effs: [Decl],
                 # The extern-type registry (struct field layouts +
                 # opaque names), collected once from the pre-lowering
                 # decls. The FFI shim emitter keys off it to unwrap a
                 # record into a C struct / pass an opaque void*.
                 ffi_reg: [ExternTypeReg],
                 # The post-monomorph, module-mangled symbol of the fn /
                 # lambda whose body is currently being emitted. Passed to
                 # `find_lam` so a nested ELambda resolves to ITS module's
                 # LamInfo, not a same-(line,col) lambda from another module
                 # (the multi-module emit puts both in one `lams` list).
                 cur_enc_fn: String,
                 # The record table. An `EField` whose base type resolves to a
                 # known record lowers to a constant-index read (`field_index_of`
                 # + the desugar-canonicalised declaration-order layout) instead
                 # of the `kai_op_field` strcmp. Collected once from the decls.
                 recs: [RecInfo],
                 # Head tags of the stamped record types (`rec_stamp`).
                 stamps: [RecStamp],
                 # The core builtins' rows keyed by id, built once at emit
                 # entry: a call finds the row of the builtin its callee
                 # names without rebuilding or walking a table.
                 core_ix: CoreIx,
                 # The variant table's rows keyed by constructor id, built
                 # once at emit entry: a constructor site finds its row by
                 # the id it carries.
                 ctor_ix: CtorIx,
                 # The per-function evidence-frame ABI: each
                 # function's USER-effect slot layout, keyed by emitted
                 # symbol. The perform site reads its own frame's slot for
                 # an effect (falling back to the by-name walk when the
                 # frame does not carry it); a call site fills the callee's
                 # frame from its own supplier classification. Built once at
                 # emit entry, threaded borrowed.
                 evf: EvFrames,
                 # True while emitting the body of a donation-capable fn
                 # (one that took a hidden `_donor` reuse-token param). The
                 # reuse-variant arm emit reads this to route its fresh-alloc
                 # rebuild cells through `_donor` — see emit_reuse_donate.kai.
                 rd_active: Bool,
                 # Names of every donation-capable top-level fn, pre-scanned
                 # once. A call site consults it (with a live arm token, i.e.
                 # `reuse_donor` set) to donate that token across the call.
                 rd_capable: [String],
                 # Pending releases the tcrec goto-tail path must emit before
                 # jumping: enclosing owned match scrutinee aliases plus
                 # not-yet-consumed arm-binder increfs (emit_tcrec_live ledger).
                 tcpend: [TclEntry],
                 # The current frame's unwind sites (unwind_pend.kai).
                 unw: UnwFrame,
                 # The program's root file basename, as tag_target_decl stamps
                 # it on the root's own `pub` decls: a root EFn carries either
                 # spelling (mo=None for non-pub, mo=Some(root_mod) for pub).
                 root_mod: Option[String],
                 # Where a name is spelled from: a declaration's in the symbol
                 # table, a specialisation's in the monomorphiser's table, a
                 # local's among the binders of the declaration being emitted.
                 tab: SymTab, specs: SpecNames, locals: LocalNames }

# Install a module-rotated EFn table for a body emitted from a side
# table (a lifted lambda, a handler clause), where there is no Decl for
# the caller to read `mo` off. Without it the body's bare calls resolve
# against the unrotated global table and can reach another module's
# homonym.
fn emit_ctx_with_fns(cx: EmitCtx, f: [EFn]) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: f, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: cx.borrowed,
            hoisted: cx.hoisted, reuse_donor: cx.reuse_donor, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

fn emit_ctx_with_lcs(cx: EmitCtx, l: [LocalId]) : EmitCtx =
  EmitCtx { lcs: l, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: cx.borrowed,
            hoisted: cx.hoisted, reuse_donor: cx.reuse_donor, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# Enter a declaration: its binders spell the locals of everything emitted
# under it.
fn emit_ctx_with_locals(cx: EmitCtx, ns: LocalNames) : EmitCtx = EmitCtx { ...cx, locals: ns }

fn emit_ctx_with_evf(cx: EmitCtx, evf: EvFrames) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: cx.borrowed,
            hoisted: cx.hoisted, reuse_donor: cx.reuse_donor, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# Set the enclosing-fn key (entering a fn or lambda body). `find_lam`
# keys on this + (line, col) so a nested ELambda resolves to its own
# module's LamInfo, never a same-position lambda from another module.
fn emit_ctx_with_enc_fn(cx: EmitCtx, ef: String) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: cx.borrowed,
            hoisted: cx.hoisted, reuse_donor: cx.reuse_donor, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: ef, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# Set/clear the arena-routing flag for a region body.
fn emit_ctx_with_in_region(cx: EmitCtx, b: Bool) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: b, borrowed: cx.borrowed,
            hoisted: cx.hoisted, reuse_donor: cx.reuse_donor, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# Set the borrowed-binder set for an arm-top reuse body.
fn emit_ctx_with_borrowed(cx: EmitCtx, b: [LocalId]) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: b,
            hoisted: cx.hoisted, reuse_donor: cx.reuse_donor, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# Replace the tcrec pending-release ledger (entering a match arm body /
# refining across a branch point).
fn emit_ctx_with_unw(cx: EmitCtx, u: UnwFrame) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: cx.borrowed,
            hoisted: cx.hoisted, reuse_donor: cx.reuse_donor, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: u, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# The C locals among `names` that hold a boxed reference here.
fn emit_unw_vars(names: [LocalId], cx: EmitCtx) : [String] = emit_unw_boxed(unw_admit(cx.unw, names), cx)

fn emit_unw_boxed(names: [LocalId], cx: EmitCtx) : [String] = match names {
  [] -> []
  [n, ...rest] ->
    if locals_have(cx.lcs, n) and not emit_ctx_kind1_raw_has(cx, n) { [c_local(emit_local_text(cx, n)), ...emit_unw_boxed(rest, cx)] }
    else { emit_unw_boxed(rest, cx) }
}

# The match at `x` registers its owned scrutinee when an arm holds a call
# that can unwind.
fn emit_unw_scr_at(x: Expr, cx: EmitCtx) : EmitCtx = {
  let want = unw_match_at(cx.unw.sites, x.site)
  if want == cx.unw.scr { cx } else { emit_ctx_with_unw(cx, unw_with_scr(cx.unw, want)) }
}

fn emit_unw_scr_off(cx: EmitCtx) : EmitCtx =
  if cx.unw.scr { emit_ctx_with_unw(cx, unw_with_scr(cx.unw, false)) } else { cx }

# An arm that bound its pattern with increfs owns those binders.
fn emit_unw_owning(pat: Pattern, cx: EmitCtx) : EmitCtx =
  if cx.unw.arms == [] { cx } else { emit_ctx_with_unw(cx, unw_owning(cx.unw, tcp_rc_binders(pat, cx))) }

# A destructuring `let` increfs each binder it binds.
fn emit_unw_let_owned(s: Stmt, cx: EmitCtx) : [LocalId] = match s {
  SLet(pat, _, _) -> if unw_destructured(pat) == [] { [] } else { tcp_rc_binders(pat, cx) }
  _ -> []
}

fn emit_unw_own(names: [LocalId], cx: EmitCtx) : EmitCtx =
  if names == [] or cx.unw.arms == [] { cx } else { emit_ctx_with_unw(cx, unw_owning(cx.unw, names)) }

# The owned scrutinee slot of a match its arms can unwind out of: the push
# after `_scr` is bound, the pop before its exit decref, and the arms'
# ledger entry so a goto out of the match pops too. The arms keep `scr`
# set: a reuse arm must not leave a moved child in the registered cell.
type UnwScr = { push: String, pop: String, cx: EmitCtx }

fn emit_unw_scr(want: Bool, cx: EmitCtx) : UnwScr =
  if want {
    let held = emit_ctx_with_unw(cx, unw_with_scr(cx.unw, true))
    UnwScr { push: euw_slot_push("_uwm", "_scr"), pop: euw_pop("_uwm"),
             cx: emit_ctx_with_tcpend(held, list_append(cx.tcpend, [tcl_unw_entry("_uwm")])) }
  } else { UnwScr { push: "", pop: "", cx: cx } }

# A call that can unwind registers the frame's pending references for its
# extent. A closure it calls through a local is invoked borrowed and
# registered too: the consuming call would hold the frame's reference
# where no unwind can reach it.
fn emit_unw_call(src: String, x: Expr, f: Expr, args_e: [Expr], cx: EmitCtx) : String / Console =
  match unw_call_of(cx.unw, x) {
    None -> emit_call_expr(src, f, args_e, cx)
    Some(names) -> {
      let vars = emit_unw_vars(names, cx)
      match emit_unw_closure(f, cx) {
        Some(UcTransfer(n)) ->
          euw_call_drop(emit_mark_call(src, MkApplyBorrow, [emit_unw_var(f, n), ...args_e], cx), vars, c_local(emit_local_text(cx, n)))
        Some(UcDup(n)) -> euw_call(emit_mark_call(src, MkApplyBorrow, [emit_unw_var(f, n), ...args_e], cx), vars)
        None -> euw_call(emit_call_expr(src, f, args_e, cx), vars)
      }
    }
  }

type UnwClosure = UcTransfer(LocalId) | UcDup(LocalId)

fn emit_unw_closure(f: Expr, cx: EmitCtx) : Option[UnwClosure] = match f.kind {
  ELocal(n) -> if emit_unw_local(n, cx) { Some(UcTransfer(n)) } else { None }
  ECall(g, xs) -> match g.kind {
    EMark(MkDup) -> match xs {
      [inner] -> match inner.kind {
        ELocal(n) -> if emit_unw_local(n, cx) { Some(UcDup(n)) } else { None }
        _ -> None
      }
      _ -> None
    }
    _ -> None
  }
  _ -> None
}

fn emit_unw_local(n: LocalId, cx: EmitCtx) : Bool =
  locals_have(cx.lcs, n) and not emit_ctx_kind1_raw_has(cx, n)

fn emit_unw_var(f: Expr, n: LocalId) : Expr = Expr { kind: ELocal(n), line: f.line, col: f.col, ty: f.ty, mode: f.mode,  site: f.site }

fn emit_ctx_with_tcpend(cx: EmitCtx, l: [TclEntry]) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: cx.borrowed,
            hoisted: cx.hoisted, reuse_donor: cx.reuse_donor, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: l, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# Refine the ledger across an already-evaluated expression — a no-op
# (and no scan) when the ledger is empty, the overwhelmingly common case.
fn emit_ctx_tcpend_after(cx: EmitCtx, e: Expr) : EmitCtx = match cx.tcpend {
  [] -> cx
  _  -> emit_ctx_with_tcpend(cx, tcl_filter(cx.tcpend, e))
}

fn emit_ctx_tcpend_after_stmts(cx: EmitCtx, ss: [Stmt]) : EmitCtx = match cx.tcpend {
  [] -> cx
  _  -> emit_ctx_with_tcpend(cx, tcl_filter_stmts(cx.tcpend, ss))
}

# Set/clear the hoisted-slot set (entering/leaving a match that hoists).
fn emit_ctx_with_hoisted(cx: EmitCtx, h: [Int]) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: cx.borrowed,
            hoisted: h, reuse_donor: cx.reuse_donor, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# Set the donation-active flag (entering/leaving a `_donor`-taking body).
fn emit_ctx_with_rd_active(cx: EmitCtx, a: Bool) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: cx.borrowed,
            hoisted: cx.hoisted, reuse_donor: cx.reuse_donor, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: a, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# Set/clear the reuse-donor (entering/leaving an arm-top-reuse body).
fn emit_ctx_with_reuse_donor(cx: EmitCtx, d: Option[ReuseDonor]) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: cx.borrowed,
            hoisted: cx.hoisted, reuse_donor: d, kind1_raw: cx.kind1_raw, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# i64-inline (Lane B): set the kind-1 raw-bound binder set for an arm
# body. Entering a match arm whose pattern binds kind-1 Int slots, the
# bind adds those binders so local reads + slot stores in the body pick the
# raw `kair_<nm>` form. Replaced (not extended) per arm so sibling arms
# and outer scopes do not see this arm's binders.
fn emit_ctx_with_kind1_raw(cx: EmitCtx, ks: [LocalId]) : EmitCtx =
  EmitCtx { lcs: cx.lcs, fns: cx.fns, fx: cx.fx, variants: cx.variants, lams: cx.lams, cls: cx.cls,
            regions: cx.regions, in_region: cx.in_region, borrowed: cx.borrowed,
            hoisted: cx.hoisted, reuse_donor: cx.reuse_donor, kind1_raw: ks, consts: cx.consts, effs: cx.effs, ffi_reg: cx.ffi_reg, cur_enc_fn: cx.cur_enc_fn, recs: cx.recs, stamps: cx.stamps, core_ix: cx.core_ix, ctor_ix: cx.ctor_ix, evf: cx.evf, rd_active: cx.rd_active, rd_capable: cx.rd_capable, tcpend: cx.tcpend, unw: cx.unw, root_mod: cx.root_mod, tab: cx.tab, specs: cx.specs, locals: cx.locals }

# True when `l` is a kind-1 raw-bound binder in the current arm scope.
fn emit_ctx_kind1_raw_has(cx: EmitCtx, l: LocalId) : Bool = locals_have(cx.kind1_raw, l)

# The top-level consts of a program, kept for `EmitCtx.consts` so a
# const read materialises as its literal body inline.
fn const_decls_only(decls: [Decl]) : [Decl] = match decls {
  [] -> []
  [d, ...rest] -> match d {
    DConst(_, _, _, _, _, _, _) -> [d, ...const_decls_only(rest)]
    _ -> const_decls_only(rest)
  }
}

# The effect decls only, for the EmitCtx `effs` catalogue an evidence-
# naming site consults to read an effect's `module_origin`.
fn effect_decls_only(decls: [Decl]) : [Decl] = match decls {
  [] -> []
  [d, ...rest] -> match d {
    DEffect(_, _, _, _, _, _, _, _) -> [d, ...effect_decls_only(rest)]
    _ -> effect_decls_only(rest)
  }
}

# The module that declares the effect `s`, which qualifies the name of its
# evidence struct; None for the root's and for an effect no decl declares.
fn eff_mo(effs: [Decl], s: SymId) : Option[String] = match effect_decl_of(s, effs) {
  Some(DEffect(_, _, _, _, _, _, _, mo)) -> mo
  _ -> None
}

# The literal body of the const `s` in the emit catalogue; None when `s`
# is no top-level const.
fn const_body_of(consts: [Decl], s: SymId) : Option[Expr] = match consts {
  [] -> None
  [d, ...rest] -> match d {
    DConst(_, cs, _, body, _, _, _) ->
      if sym_raw(s) >= 0 and sym_same(cs, s) { Some(body) } else { const_body_of(rest, s) }
    _ -> const_body_of(rest, s)
  }
}

# True when a block at (line, col) is a recorded `region { }`.
fn emit_block_is_region(cx: EmitCtx, line: Int, col: Int) : Bool =
  emit_region_marks_has(cx.regions, line, col)

fn emit_region_marks_has(ms: [RegionMark], line: Int, col: Int) : Bool {
  match ms {
    [] -> false
    [m, ...rest] ->
      if rmark_line(m) == line and rmark_col(m) == col { true }
      else { emit_region_marks_has(rest, line, col) }
  }
}

# True when a resolved type carries a region brand: a `TyDimT` whose
# base is a heap-allocated user aggregate (a nominal `TyCon` or a list),
# not a numeric carrier. Measure/Currency brand numeric heads
# (`TyDimT(TyReal, m)`, `Decimal<USD>`); a region brands an aggregate
# (`Tree<r>` = `TyDimT(TyCon("Tree"), r)`). Routing a ctor of such a
# type to the arena is what makes `insert[r]`'s `Node(...)` bump-allocate
# in `r` even across a fn boundary — the by-type routing that lexical
# `in_region` cannot reach. Safe when no arena is live: the arena ctors
# fall back to the RC ctor when `kai_arena_current()` is NULL.
fn ty_has_region_brand(ty: Ty) : Bool = match ty {
  TyDimT(base, _) -> match base {
    TyCon(s, _) -> not ty_is_numeric_carrier(s)
    TyListT(_)        -> true
    _                 -> false
  }
  _ -> false
}

fn ty_is_numeric_carrier(s: SymId) : Bool = match core_decl_ty_of(s) {
  Some(_) -> true
  None    -> false
}

# The signature-brand predicate (`fn_has_region_brand`) and
# `te_is_region_branded` live in `compiler.region`, shared with the native
# lowering so both backends route region ctors off ONE verdict.

# Region-brand routing for a ctor whose resolved type is `ty`: an
# aggregate branded with a region bump-allocates in the current arena.
# Combines with the lexical `in_region` flag — either lands the ctor in
# the arena.
fn emit_ctx_route_brand(cx: EmitCtx, ty_opt: Option[Ty]) : EmitCtx =
  match ty_opt {
    Some(ty) -> if ty_has_region_brand(ty) { emit_ctx_with_in_region(cx, true) } else { cx }
    None     -> cx
  }

# The C cons constructor a region-lexical site emits: arena-bump inside
# a region body, ordinary RC otherwise.
fn emit_cons_ctor(cx: EmitCtx) : String = if cx.in_region { "kai_arena_cons(" } else { "kai_cons(" }

# Record literal constructor — bump-arena `kai_arena_record` in-region, else
# RC-heap `kai_record`. Both take `(int n, KaiValue **fields, const char
# **names)`; the C array-literal args decay to those pointer types identically,
# so the swap is behaviour-identical outside a region.
fn emit_record_ctor(cx: EmitCtx) : String = if cx.in_region { "kai_arena_record(" } else { "kai_record(" }

# N-ary variant constructor — bump-arena `kai_arena_variant` in-region, else
# RC-heap `kai_variant_u`. Both take `(tag, name, n, mask, slots)` in the same
# order. NULLARY variants are shared singletons and are NOT routed (they must
# stay on the RC heap, never the arena — the arena free would dangle the shared
# singleton).
fn emit_variant_ctor(cx: EmitCtx) : String = if cx.in_region { "kai_arena_variant(" } else { "kai_variant_u(" }

# Issue #452 Phase A.0 step 3: `core_caches` is parallel to
# `cores`. Each slot is either "" (no cache, force re-parse from
# source) or a path to a .kab file produced by --emit-core-cache.
# `--core <src>` appends "" to keep the arrays aligned;
# `--core-cache <src> <cache>` appends <cache>. Length is always
# equal to length of `cores`.
# `cache_sha` carries the optional sha256 hex (64 chars) used when
# emitting a cache via --emit-core-cache; empty string means write
# the all-zero placeholder.

# ====================================================================

# issue #381: warn on unused local `let` and pattern bindings.
#
# Policy (validated in the issue body):
#   - Local `let name = …` whose `name` is never referenced inside its
#     lexical scope: warn.
#   - Pattern binding (e.g. `Some(v) -> body` without `v` in body): warn.
#   - Function parameter unused: never warn (interface / protocol /
#     contract with caller).
#   - Any binder whose name starts with `_` (including `__`-prefixed
#     compiler-internal names like `__cv_*`, `__pcs_ret`): never warn.
#     The silence covers `__`-prefixed names because every desugar
#     that synthesises locals uses that namespace.
#
# The walker runs post-typer / pre-monomorphise. Running pre-mono avoids duplicate diagnostics
# from per-spec body copies; running post-typer means the AST has
# already been resolved (no spurious "use" via alias names).
#
# Reference detection uses `fv_expr` with empty `own`, which yields every
# local read reachable from the sub-AST: a read carries its binder's id, so
# a re-binding of the name never takes over another binder's reads.

fn name_is_silenced(name: String) : Bool {
  match char_at(name, 0) {
    Some(c0) -> c0 == '_'
    None -> false
  }
}

# Collect (name, line, col) triples for every binder a pattern
# introduces. Uses the pattern's own line/col — for destructuring
# patterns (`(x, y)`, `Some(v)`) all sub-binders share the outer
# pattern's location, which is the closest stable anchor stage 1
# preserves.

# Collect (name, line, col) triples for every binder a pattern
# introduces. Uses the pattern's own line/col — for destructuring
# patterns (`(x, y)`, `Some(v)`) all sub-binders share the outer
# pattern's location, which is the closest stable anchor stage 1
# preserves.
type UBind = UB(Binder, Int, Int)

fn pat_ubinds(pat: Pattern, acc: [UBind]) : [UBind] {
  let line = pat.line
  let col = pat.col
  match pat.pkind {
    PWild -> acc
    PLit(_) -> acc
    PRange(_, _) -> acc
    PBind(b) -> [UB(b, line, col), ...acc]
    PList(pats, opt_rest) -> {
      let acc1 = pat_ubinds_loop(pats, acc)
      match opt_rest {
        Some(rb) -> [UB(rb, line, col), ...acc1]
        None -> acc1
      }
    }
    PVariant(_, subs) -> pat_ubinds_loop(subs, acc)
    PVariantRecord(_, fields) -> pfield_ubinds_loop(fields, acc)
    PRecord(fields) -> pfield_ubinds_loop(fields, acc)
    PHole(_) -> acc
    PAs(b, sub) -> pat_ubinds(sub, [UB(b, line, col), ...acc])
    PNarrow(b, _) -> [UB(b, line, col), ...acc]
    PSurface(sp) -> pat_ubinds_loop(patsurface_children(sp), acc)
  }
}

fn pat_ubinds_loop(ps: [Pattern], acc: [UBind]) : [UBind] {
  match ps {
    [] -> acc
    [p, ...rest] -> pat_ubinds_loop(rest, pat_ubinds(p, acc))
  }
}

fn pfield_ubinds_loop(fs: [PField], acc: [UBind]) : [UBind] {
  match fs {
    [] -> acc
    [f, ...rest] -> match f {
      PField(_, sub, _) -> pfield_ubinds_loop(rest, pat_ubinds(sub, acc))
    }
  }
}

# The binders under test enclose the code that reads them.
fn ubind_scope(ubs: [UBind]) : FvOuter = fv_outer_of(map(ubs, ubind_binder))

fn ubind_binder(u: UBind) : Binder = match u {
  UB(b, _, _) -> b
}

fn report_unused_ubinds(file: String, ubs: [UBind], refs: [LocalId]) : Unit / Console + File {

  match ubs {
    [] -> ()
    [u, ...rest] -> match u {
      UB(b, line, col) -> {
        if name_is_silenced(written_text(b.name)) { () }
        else if locals_have(refs, b.id) { () }
        else {
          diag_warning(file, line, col,
            concat_all(["unused binding `", written_text(b.name), "`"]))
          diag_help("prefix with `_` to mark as intentionally unused")
        }
        report_unused_ubinds(file, rest, refs)
      }
    }
  }
}

#[doc("Walk a decl looking for unused local bindings: the root file's own, and every block's in the file that declares it (`mods` maps a module to its file). Skips parameter names entirely — interface compliance, protocol dispatch, and axiom signatures all justify silent unused params.")]
pub fn report_unused_in_decls(file: String, mods: [ModuleEntry], decls: [Decl]) : Unit / Console + File {

  match decls {
    [] -> ()
    [d, ...rest] -> {
      report_unused_in_decl(file, mods, d)
      report_unused_in_decls(file, mods, rest)
    }
  }
}

fn block_file(file: String, mods: [ModuleEntry], mo: Option[String]) : String = match mo {
  None -> file
  Some(m) -> match mt_lookup(mods, m) {
    Some(ME(_, _, path, _)) -> path
    None -> file
  }
}

fn report_unused_in_decl(file: String, mods: [ModuleEntry], d: Decl) : Unit / Console + File {

  match d {
    DFn(_, _, _, _, _, _, body, _, _, mo) -> match mo {
      None    -> report_unused_in_expr(file, body)
      Some(_) -> ()
    }
    DTest(_, body, _, _, mo)       -> report_unused_in_expr(block_file(file, mods, mo), body)
    DBench(_, body, _, _, mo)      -> report_unused_in_expr(block_file(file, mods, mo), body)
    DCheck(_, _, body, _, _, mo)   -> report_unused_in_expr(block_file(file, mods, mo), body)
    _ -> ()
  }
}

fn report_unused_in_expr(file: String, e: Expr) : Unit / Console + File {

  match e.kind {
    EInt(_, _)  -> ()
    EReal(_, _) -> ()
    EIntLit(_) -> ()
    EDecimalLit(_) -> ()
    EFixed(_, _) -> ()
    EBool(_) -> ()
    EChar(_) -> ()
    EStr(_, _) -> ()
    EUnit -> ()
    EName(_) -> ()
    EMark(_) -> ()
    ESym(_, _) -> ()
    ELocal(_) -> ()
    EOp(_) -> ()
    EUnder -> ()
    EPlaceholder -> ()
    EHole(_) -> ()
    ETodo(_) -> ()
    EExternBody(_, _) -> ()
    EVariantsOf(_, _) -> ()
    EModCall(_, _) -> ()
    EIntrinsic(_, args_) -> report_unused_in_exprs(file, args_)
    ESurface(sf) -> report_unused_in_exprs(file, surface_children(sf))
    ECall(f, xs) -> {
      report_unused_in_expr(file, f)
      report_unused_in_exprs(file, xs)
    }
    EField(base, _) -> report_unused_in_expr(file, base)
    EIndex(a, b) -> {
      report_unused_in_expr(file, a)
      report_unused_in_expr(file, b)
    }
    EBinop(_, a, b) -> {
      report_unused_in_expr(file, a)
      report_unused_in_expr(file, b)
    }
    EUnop(_, x) -> report_unused_in_expr(file, x)
    EIf(c, t, eo) -> {
      report_unused_in_expr(file, c)
      report_unused_in_expr(file, t)
      match eo { Some(b) -> report_unused_in_expr(file, b) None -> () }
    }
    EMatch(scr, arms) -> {
      report_unused_in_expr(file, scr)
      report_unused_in_arms(file, arms)
    }
    ELambda(_, body) -> report_unused_in_expr(file, body)
    ERecordLit(_, fs) -> report_unused_in_field_inits(file, fs)
    EList(els) -> report_unused_in_list_elems(file, els)
    ERange(a, b, opt) -> {
      report_unused_in_expr(file, a)
      report_unused_in_expr(file, b)
      match opt { Some(s) -> report_unused_in_expr(file, s) None -> () }
    }
    EBlock(stmts, tail) -> report_unused_in_block(file, stmts, tail)
    EPipe(a, b) -> {
      report_unused_in_expr(file, a)
      report_unused_in_expr(file, b)
    }
    EMapPipe(a, b) -> {
      report_unused_in_expr(file, a)
      report_unused_in_expr(file, b)
    }
    EFlatMapPipe(a, b) -> {
      report_unused_in_expr(file, a)
      report_unused_in_expr(file, b)
    }
    EFilterPipe(a, b) -> {
      report_unused_in_expr(file, a)
      report_unused_in_expr(file, b)
    }
    EBang(inner) -> report_unused_in_expr(file, inner)
    ELitUnit(inner, _) -> report_unused_in_expr(file, inner)
    EHandle(body, _, _, init_opt, _, clauses, ret_opt) -> {
      report_unused_in_expr(file, body)
      match init_opt { Some(i) -> report_unused_in_expr(file, i) None -> () }
      report_unused_in_hclauses(file, clauses)
      match ret_opt {
        Some(r) -> match r { HR(_, b, _, _) -> report_unused_in_expr(file, b) }
        None -> ()
      }
    }
  }
}

fn report_unused_in_exprs(file: String, es: [Expr]) : Unit / Console + File {

  match es {
    [] -> ()
    [h, ...rest] -> {
      report_unused_in_expr(file, h)
      report_unused_in_exprs(file, rest)
    }
  }
}

fn report_unused_in_arms(file: String, arms: [Arm]) : Unit / Console + File {

  match arms {
    [] -> ()
    [a, ...rest] -> match a {
      Arm(pat, opt_g, body) -> {
        # An arm's pattern binders are visible in the (optional)
        # guard and the body. Collect references from both, then
        # warn on any binder absent from the union.
        let ubs = pat_ubinds(pat, [])
        let scope = ubind_scope(ubs)
        let refs0 = match opt_g {
          Some(g) -> fv_expr(g, [], scope, [])
          None    -> []
        }
        let refs = capture_locals(fv_expr(body, [], scope, refs0))
        report_unused_ubinds(file, ubs, refs)
        match opt_g { Some(g) -> report_unused_in_expr(file, g) None -> () }
        report_unused_in_expr(file, body)
        report_unused_in_arms(file, rest)
      }
    }
  }
}

fn report_unused_in_field_inits(file: String, fs: [FieldInit]) : Unit / Console + File {

  match fs {
    [] -> ()
    [f, ...rest] -> match f {
      FI(_, e) -> {
        report_unused_in_expr(file, e)
        report_unused_in_field_inits(file, rest)
      }
    }
  }
}

fn report_unused_in_list_elems(file: String, els: [ListElem]) : Unit / Console + File {

  match els {
    [] -> ()
    [el, ...rest] -> {
      match el {
        ElPlain(e)  -> report_unused_in_expr(file, e)
        ElSpread(e) -> report_unused_in_expr(file, e)
      }
      report_unused_in_list_elems(file, rest)
    }
  }
}

fn report_unused_in_hclauses(file: String, cs: [HClause]) : Unit / Console + File {

  match cs {
    [] -> ()
    [c, ...rest] -> match c {
      HC(_, _, body, _, _) -> {
        report_unused_in_expr(file, body)
        report_unused_in_hclauses(file, rest)
      }
    }
  }
}

# Walk a block in source order. For each `SLet(pat, _, rhs)`:
#   1. Recurse into `rhs` (its body cannot reference the pattern's
#      binders — they aren't in scope yet).
#   2. Compute the locals read in the rest of the block (subsequent
#      stmts + optional tail).
#   3. Warn on any pat-binder absent from that read set.
fn report_unused_in_block(file: String, stmts: [Stmt], tail: Option[Expr]) : Unit / Console + File {
  let bound = ru_binders(stmts, [])
  let tail_reads = match tail {
    Some(t) -> ru_mark(idx_empty(), capture_locals(fv_expr(t, [], fv_outer_of(bound), [])))
    None    -> idx_empty()
  }
  ru_walk(file, stmts, ru_live_after(list_reverse(stmts), bound, idx_empty(), []), tail_reads, tail)
}

# The block's binders, the latest statement's first.
fn ru_binders(stmts: [Stmt], acc: [Binder]) : [Binder] = match stmts {
  [] -> acc
  [SLet(pat, _, _), ...rest] -> ru_binders(rest, pat_bindings(pat, acc))
  [SVar(b, _, _, _, _), ...rest] -> ru_binders(rest, [b, ...acc])
  [_, ...rest] -> ru_binders(rest, acc)
}

# `bound` holds the binders of `s` and of the statements before it: those
# before it are what `s` itself can read.
fn ru_bound_before(s: Stmt, bound: [Binder]) : [Binder] = match s {
  SLet(pat, _, _)     -> ru_drop(bound, list_length(pat_bindings(pat, [])))
  SVar(_, _, _, _, _) -> ru_drop(bound, 1)
  _                   -> bound
}

fn ru_drop(bs: [Binder], n: Int) : [Binder] =
  if n <= 0 { bs } else { match bs {
    []           -> []
    [_, ...rest] -> ru_drop(rest, n - 1)
  } }

# A binder read after a statement.
type RuLive = RuRead(LocalId)

# The reads after each statement, in block order. Walking from the end,
# the reads after a statement are its own reads plus those after the next
# one, so the block is scanned once.
fn ru_live_after(rev: [Stmt], bound: [Binder], live: NameIndex[RuLive],
                 acc: [NameIndex[RuLive]]) : [NameIndex[RuLive]] / Console =
  match rev {
    [] -> acc
    [s, ...earlier] -> {
      let before = ru_bound_before(s, bound)
      ru_live_after(earlier, before, ru_step(live, fv_outer_of(before), s), [live, ...acc])
    }
  }

fn ru_step(live: NameIndex[RuLive], scope: FvOuter, s: Stmt) : NameIndex[RuLive] / Console = match s {
  SLet(_, _, rhs) -> ru_mark(live, capture_locals(fv_expr(rhs, [], scope, [])))
  SVar(_, _, rhs, _, _) -> ru_mark(live, capture_locals(fv_expr(rhs, [], scope, [])))
  _ -> ru_mark(live, capture_locals(fv_stmt(s, [], scope, [])))
}

fn ru_mark(live: NameIndex[RuLive], ls: [LocalId]) : NameIndex[RuLive] = match ls {
  [] -> live
  [l, ...rest] -> ru_mark(idx_prepend_local(live, l, RuRead(l)), rest)
}

# A bucket also holds the binders that hash alike, so the entry is matched by id.
fn ru_read(chain: [RuLive], l: LocalId) : Bool = match chain {
  [] -> false
  [RuRead(n), ...rest] -> local_eq(n, l) or ru_read(rest, l)
}

# The tail is checked without the block's later bindings in scope, so its
# reads count for every binder of the block.
fn ru_used(ubs: [UBind], live: NameIndex[RuLive], tail_reads: NameIndex[RuLive]) : [LocalId] = match ubs {
  [] -> []
  [UB(b, _, _), ...rest] ->
    if ru_read(idx_chain_local(live, b.id), b.id) or ru_read(idx_chain_local(tail_reads, b.id), b.id) {
      [b.id, ...ru_used(rest, live, tail_reads)]
    } else {
      ru_used(rest, live, tail_reads)
    }
}

fn ru_walk(file: String, stmts: [Stmt], lives: [NameIndex[RuLive]], tail_reads: NameIndex[RuLive],
           tail: Option[Expr]) : Unit / Console + File =
  match stmts {
    [] -> match tail {
      Some(t) -> report_unused_in_expr(file, t)
      None    -> ()
    }
    [s, ...rest] -> match lives {
      [] -> ()
      [live, ...more] -> {
        ru_stmt(file, s, live, tail_reads)
        ru_walk(file, rest, more, tail_reads, tail)
      }
    }
  }

fn ru_stmt(file: String, s: Stmt, live: NameIndex[RuLive], tail_reads: NameIndex[RuLive]) : Unit / Console + File =
  match s {
    SLet(pat, _, rhs) -> {
      report_unused_in_expr(file, rhs)
      let ubs = pat_ubinds(pat, [])
      report_unused_ubinds(file, ubs, ru_used(ubs, live, tail_reads))
    }
    SVar(_, _, rhs, _, _) -> report_unused_in_expr(file, rhs)
    SAssert(c, opt_m) -> {
      report_unused_in_expr(file, c)
      match opt_m { Some(m) -> report_unused_in_expr(file, m) None -> () }
    }
    SExprStmt(x) -> report_unused_in_expr(file, x)
    SIndexAssign(b, i, v, _, _) -> {
      report_unused_in_expr(file, b)
      report_unused_in_expr(file, i)
      report_unused_in_expr(file, v)
    }
    SAssign(b, v, _, _) -> {
      report_unused_in_expr(file, b)
      report_unused_in_expr(file, v)
    }
    SUse(_, _, _) -> ()
  }

# ---- expression emission ----

# The written name of the local `l`, for the C identifiers spelled from it.
fn emit_local_text(cx: EmitCtx, l: LocalId) : String = written_text(ln_text(cx.locals, l))

# The C identifier of the local `l`.
fn c_local_of(cx: EmitCtx, l: LocalId) : String = c_local(emit_local_text(cx, l))

# The name a binder is spelled with where it is declared.
fn binder_text(b: Binder) : String = written_text(b.name)

fn binder_ids(bs: [Binder]) : [LocalId] = map(bs, (b) => b.id)

# A region's value leaves as a deep copy; the block still owns the value
# itself, released after the copy (a no-op on an arena cell, which the pop
# frees with the rest).
fn region_copy_out(value_c: String) : String =
  concat_all(["KaiValue *__rin = ", value_c, "; KaiValue *__rout = kai_deep_copy_out(__rin); kai_decref(__rin);"])

# A constructor in value position reads its seeded singleton by tag.
fn emit_nullary_read(row: VariantEntry) : String = match row {
  EV(_, name, _, _, tag) -> concat_all(["kai_nullary_fast(", int_to_string(tag), ", \"", name, "\")"])
}

# A function or a builtin in value position: the closure of its thunk.
fn emit_ident_value(fid: FnId, cx: EmitCtx) : String = match fnx_callee(cx.fx, fid) {
  Some(EFn(n, ar, mo, _, _)) ->
    cat5("kai_closure(&", c_user_thunk_sym(c_sym(written_text(n), mo)), ", ", int_to_string(ar), ", 0, NULL)")
  None -> match core_ix_boxed(cx.core_ix, fnid_sym(fid)) {
    Some(ep) -> match ep {
      EP(_, cname, ar) ->
        cat5("kai_closure(&_", cname, "_thunk, ", int_to_string(ar), ", 0, NULL)")
    }
    None -> c_local(emit_fn_text(cx.tab, cx.specs, fid))
  }
}

# Emit a raw string literal's *body* as a C string literal. For now this
# only handles hello-style cases: no #{...} interpolation, no \u{HHHH},
# the escapes that kaikai and C share are passed through unchanged.
# Later milestones extend this to full interpolation.

# Emit a raw string literal's *body* as a C string literal. For now this
# only handles hello-style cases: no #{...} interpolation, no \u{HHHH},
# the escapes that kaikai and C share are passed through unchanged.
# Later milestones extend this to full interpolation.
fn emit_string_lit_body(span: String) : String {
  # span includes opening and closing quotes; C literal syntax matches.
  span
}

# m7d §23: pick the runtime helper a `++` lowers to. The typer
# pins the binop's result type to `String` or `[T]`; anything else
# means we lost the annotation somewhere upstream.

# m7d §23: pick the runtime helper a `++` lowers to. The typer
# pins the binop's result type to `String` or `[T]`; anything else
# means we lost the annotation somewhere upstream.
fn concat_helper_of(opt_ty: Option[Ty]) : String {
  match opt_ty {
    Some(t) -> match t {
      TyString    -> "kai_core_string_concat"
      TyListT(_)  -> "kai_core_list_append"
      _           -> "kai_core_string_concat /* m7d §23: unexpected type */"
    }
    None -> "kai_core_string_concat /* m7d §23: missing type */"
  }
}

fn binop_cname(op: BinOp) : Option[String] = match op {
  BoAdd    -> Some("kai_op_add")
  BoSub    -> Some("kai_op_sub")
  BoMul    -> Some("kai_op_mul")
  BoDiv    -> Some("kai_op_div")
  BoMod    -> Some("kai_op_mod")
  BoPow    -> Some("kai_op_pow_int")
  BoLt     -> Some("kai_op_lt")
  BoGt     -> Some("kai_op_gt")
  BoLe     -> Some("kai_op_le")
  BoGe     -> Some("kai_op_ge")
  BoEq     -> Some("kai_op_eq_v")
  BoNe     -> Some("kai_op_ne_v")
  BoConcat -> None
  BoAnd    -> None
  BoOr     -> None
}

fn unop_cname(op: UnOp) : String = match op {
  UoNeg -> "kai_op_neg"
  UoNot -> "kai_op_boolnot"
}

fn emit_arg_vals(src: String, args_e: [Expr], cx: EmitCtx) : [String] / Console =
  map(args_e, (a) => emit_expr(src, a, cx))

# `<apply>fc, n, (KaiValue *[]){args})`, the callee evaluated before its args.
fn emit_apply_seq(apply: String, fc: String, args: [String]) : String {
  let q = seq_operands([fc, ...args])
  match seq_refs(q) {
    [rf, ...ra] -> seq_wrap(q, concat_all([apply, rf, ", ", int_to_string(list_length(ra)),
                                           ", (KaiValue *[]){", join_with(ra, ", "), "})"]))
    [] -> "kai_unit() /* apply: no callee */"
  }
}

# Mixed-param lane (issue #440 follow-up) — marshal each call argument
# per the callee's raw mask: a raw slot emits `emit_expr_raw` (a raw
# scalar passed by value, no box), a boxed slot emits `emit_expr` (the
# normal boxed `KaiValue *` path, with Perceus's dup/drop intact). The
# mask comes from the callee's UFnSig; args past the mask (defensive)
# default to raw, matching the all-raw signature shape.
fn emit_arg_vals_masked(src: String, args_e: [Expr], mask: [Bool], ptys: [Ty], cx: EmitCtx) : [String] / Console =
  emit_call_args_masked_each(src, args_e, mask, ptys, cx, [])

fn emit_call_args_masked_each(src: String, args_e: [Expr], mask: [Bool], ptys: [Ty], cx: EmitCtx, acc: [String]) : [String] / Console {
  match args_e {
    [] -> list_reverse(acc)
    [a, ...rest] -> {
      let is_raw = match mask {
        [m, ..._] -> m
        [] -> true
      }
      let mrest = match mask {
        [_, ...r] -> r
        [] -> []
      }
      let entry =
        if is_raw { emit_expr_raw(src, arg_typed_by_param(a, ptys), cx) }
        else { emit_expr(src, a, cx) }
      emit_call_args_masked_each(src, rest, mrest, list_tail_or_nil(ptys), cx, [entry, ...acc])
    }
  }
}

# An arg whose type is not a concrete scalar (a capture read in a
# specialised lambda keeps its type variable) crosses into a raw param at
# the param's type, never a guessed one.
fn arg_typed_by_param(a: Expr, ptys: [Ty]) : Expr = match ptys {
  [t, ..._] -> match a.ty {
    Some(at) -> if ty_is_unboxable_t(at) { a } else { Expr { ...a, ty: Some(t) } }
    None     -> Expr { ...a, ty: Some(t) }
  }
  []        -> a
}

fn list_tail_or_nil(ts: [Ty]) : [Ty] = match ts {
  [_, ...r] -> r
  []        -> []
}

# Wrap a UFn call result only when the return is raw; a boxed-return
# UFn already yields a `KaiValue *`, so wrapping would double-box.
fn ufn_call_result(rt: Ty, raw_call: String) : String =
  if ty_is_unboxable_t(rt) { box_wrap(Some(rt), raw_call) } else { raw_call }

# KIR Lane 1: marshal a raw-core C-API call's arguments per the
# prim's declared param types. An unboxable param (`TyHandle` → raw
# `void *`, Int/Bool/Char/Real → raw scalar) crosses raw; a boxed param
# (notably `String`) crosses as a `KaiValue *` (the C forwarder reads it
# with `kai_str_data`). This mirrors `param_raw_mask` for UFns but reads
# the RP's static type list rather than an EFn signature.
fn rp_arg_mask(ptys: [Ty]) : [Bool] = match ptys {
  [] -> []
  [t, ...rest] -> [ty_is_unboxable_t(t), ...rp_arg_mask(rest)]
}

# Emit a raw-core call: `cname(<marshalled args>)`. The result is a
# raw scalar consumed in MUnboxed context (no `box_wrap`).
fn emit_rcore_call(src: String, cname: String, ptys: [Ty], args_e: [Expr], cx: EmitCtx) : String / Console =
  seq_call(cat2(cname, "("), emit_arg_vals_masked(src, args_e, rp_arg_mask(ptys), ptys, cx), ")")


# m8.x bug #12: emit `KaiValue *_op_arg_<i> = <expr>; ` for each
# arg of an op call. The args are evaluated *before* the
# `in_dispatch` flag is set, so any inner op call to the same
# handler still finds the live node.

# m8.x bug #12: emit `KaiValue *_op_arg_<i> = <expr>; ` for each
# arg of an op call. The args are evaluated *before* the
# `in_dispatch` flag is set, so any inner op call to the same
# handler still finds the live node.
fn emit_op_arg_bindings(src: String, args_e: [Expr], i: Int,
                          cx: EmitCtx) : String / Console {

  match args_e {
    [] -> ""
    [a, ...rest] -> {
      let expr_c = emit_expr(src, a, cx)
      let head = concat_all(["KaiValue *_op_arg_", int_to_string(i), " = ", expr_c, "; "])
      let tail = emit_op_arg_bindings(src, rest, i + 1, cx)
      string_concat(head, tail)
    }
  }
}

# Comma-separated list `_op_arg_0, _op_arg_1, ...` that gets
# spliced into the dispatch call site after `_ev_op`.

# Comma-separated list `_op_arg_0, _op_arg_1, ...` that gets
# spliced into the dispatch call site after `_ev_op`.
fn emit_op_arg_pass_list(args_e: [Expr], i: Int) : String {
  match args_e {
    [] -> ""
    [_, ...rest] -> {
      let head = concat_all(["_op_arg_", int_to_string(i)])
      match rest {
        [] -> head
        _  -> concat_all([head, ", ", emit_op_arg_pass_list(rest, i + 1)])
      }
    }
  }
}

# Build the `{.ptr = X0}, {.ptr = X1}, ...` slot-list string from a
# list of arg expressions. Used by the boxed (non-Phase 2) variant
# constructor path where every slot is a pointer.

# Build the `{.ptr = X0}, {.ptr = X1}, ...` slot-list string from a
# list of arg expressions. Used by the boxed (non-Phase 2) variant
# constructor path where every slot is a pointer.
fn emit_slot_ops(src: String, args_e: [Expr], cx: EmitCtx) : SeqOps / Console =
  seq_map_refs(seq_operands(emit_arg_vals(src, args_e, cx)), arg_str_as_slot)

# Wrap an already-rendered argument expression as a single boxed slot
# literal. Used by pipe lowering where the LHS expression is
# pre-rendered before being concatenated with the rest.

# Wrap an already-rendered argument expression as a single boxed slot
# literal. Used by pipe lowering where the LHS expression is
# pre-rendered before being concatenated with the rest.
fn arg_str_as_slot(arg_str: String) : String =
  string_concat("{.ptr = ", string_concat(arg_str, "}"))

fn emit_variant_call(tag: Int, name: String, n_args: Int,
                        slots: SeqOps, cx: EmitCtx) : String {
  let tag_str = int_to_string(tag)
  if n_args == 0 {
    concat_all(["kai_variant_u(", tag_str, ", \"", name, "\", 0, 0, NULL)"])
  } else {
    seq_wrap(slots, concat_all([
      emit_variant_ctor(cx), tag_str, ", \"", name, "\", ", int_to_string(n_args),
      ", 0, (KaiVarSlot[]){", seq_joined(slots), "})"
    ]))
  }
}

# Build the `slot_mask` value for a payload type list. 2 bits per
# slot, LSB-first. Returns 0 for any list with > 16 slots (mask
# exhausts the 32-bit field — falls back to all-pointer layout).
# Phase 2 — slot position scaler. kinds are 0/1/2 and slot fields
# are disjoint 2-bit windows, so addition is the same as bitwise OR
# (no carry-in). We avoid `bit_or` / `<<` because the stage 1
# compiler does not parse the bit-intrinsic surface; stage 2 builds
# the mask with plain arithmetic so the bootstrap chain works.

# ====================================================================
# Monomorphic node representation (Koka mould) — flat struct per ctor
# ====================================================================
#
# Today every sum-type node is a generic `KaiValue` (40 B header +
# `slots[]`): reading a field is a tag-check + a generic slot decode
# (~3 loads), and `is_red` measured 122 samples on the rb-tree bench.
# Koka instead emits a flat C struct PER CONSTRUCTOR — fields by name,
# the colour an immediate, `is_red` one compare. See the C Koka
# generates for the same `type tree` in docs/monomorphic-node-*.md.
#
# This block emits, for any `type T = C0(..) | C1(..) | ...`, a
# declaration mirroring Koka's `struct kk_<mod>_<Ctor>`:
#
#   struct kaiu_ty_T { int32_t rc; int32_t tag; };          /* base */
#   struct kaiu_ty_T__C1 {
#     struct kaiu_ty_T _base;     /* rc/tag prefix — RC walker reads it */
#     <field 0 of C1>;             /* flat, in its slot, no slots[] */
#     ...
#   };
#
# The base prefix is layout-compatible with `KaiValue`'s first two
# words (rc, tag), so the generic RC header can still read the count.
# The C type of each field comes from the ctor's slot kind:
#   1 (Int)  -> int64_t      (tagged immediate, == Koka kk_integer_t)
#   2 (Real) -> double
#   3 (Enum) -> int32_t      (immediate tag, == Koka uint8_t colour)
#   0 (ptr)  -> KaiValue *   (a child node / boxed value)
#
# v1 is ADDITIVE: these structs are emitted but not yet constructed /
# matched / dropped against. They let us SEE the representation (and
# diff it against Koka) before the construction + match + drop +
# generic-runtime reconciliation lands. Nothing reads them yet, so the
# wall is unchanged until the consumers are switched over.

# The C type of one payload field, from its slot kind.
fn mono_field_ctype(k: Int) : String = {
  if k == 1 { "int64_t" }
  else if k == 2 { "double" }
  else if k == 3 { "int32_t" }
  else { "KaiValue *" }
}

# Emit the field lines for one constructor's payload (`f0, f1, ...`).
fn mono_ctor_fields(ks: [Int], i: Int) : String = match ks {
  [] -> ""
  [k, ...rest] -> concat_all([
    "  ", mono_field_ctype(k), " f", int_to_string(i), ";\n",
    mono_ctor_fields(rest, i + 1)
  ])
}

# Emit one constructor struct: the base prefix followed by flat fields.
# Nullary constructors get no struct (they are immediate enum tags,
# like Koka's `kk_datatype_from_tag`); only payload-carrying ctors do.
fn mono_ctor_struct(tyname: String, v: Variant, tab: SymTab, ctors: CtorIx) : String = match v {
  Var(c, tys) ->
    if list_length(tys) == 0 { "" }
    else { concat_all([
      "struct kaiu_ty_", tyname, "__", written_text(decl_name(tab, c)), " {\n",
      "  struct kaiu_ty_", tyname, " _base;\n",
      mono_ctor_fields(mono_ctor_kinds(ctors, c, tys), 0),
      "};\n"
    ]) }
}

# A ctor the variant table lays out no row of this arity for (a name a
# builtin claims) lays every field as a pointer.
fn mono_ctor_kinds(ctors: CtorIx, c: SymId, tys: [TypeExpr]) : [Int] =
  match ctor_ix_row(ctors, c) {
    Some(EV(_, _, ar, ks, _)) -> if ar == list_length(tys) { ks } else { map(tys, (_t) => 0) }
    None                      -> map(tys, (_t) => 0)
  }

fn mono_ctor_structs(tyname: String, vs: [Variant], tab: SymTab, ctors: CtorIx) : String = match vs {
  [] -> ""
  [v, ...rest] -> concat_all([
    mono_ctor_struct(tyname, v, tab, ctors),
    mono_ctor_structs(tyname, rest, tab, ctors)
  ])
}

# Emit the base struct + per-ctor structs for one `DType T = TBSum(vs)`.
# `tyname` is the module-qualified C symbol (`c_sym`), so a private
# core type and a user type that share a bare name (e.g. regexp's
# `NB_FragR` and a user `NB_FragR`) get distinct struct names —
# `kaiu_ty_regexp__NB_FragR` vs `kaiu_ty_NB_FragR` — instead of
# colliding on `struct kaiu_ty_NB_FragR` (a clang redefinition).
# `srcname` is the unqualified name, used only in the diff comment so
# it still reads as `type NB_FragR`.
fn mono_sum_decl(tyname: String, srcname: String, vs: [Variant], tab: SymTab, ctors: CtorIx) : String =
  concat_all([
    "/* monomorphic node repr for `type ", srcname, "` (Koka mould) */\n",
    "struct kaiu_ty_", tyname, " { int32_t rc; int32_t tag; };\n",
    mono_ctor_structs(tyname, vs, tab, ctors)
  ])

# Walk all decls and emit the flat struct declarations for every
# user sum type. Records / aliases / effect aliases are skipped — only
# `TBSum` carries constructors. Threaded into `emit_program` alongside
# the effect/env struct declarations. The struct name is minted via
# `c_sym(name, mo)` — the same module-qualifier the function symbols
# use (`kai_regexp__rx_ok`) — so homonymous types from different
# modules never collide on the same C struct name.
pub fn mono_sum_decls(decls: [Decl], tab: SymTab, ctors: CtorIx) : String = match decls {
  [] -> ""
  [d, ...rest] -> {
    let here = match d {
      DType(_, ts, _, body, _, _, mo, _) -> match body {
        TBSum(vs) -> {
          let name = rt_name(tab, ts)
          mono_sum_decl(c_sym(name, mo), name, vs, tab, ctors)
        }
        _ -> ""
      }
      _ -> ""
    }
    concat_all([here, mono_sum_decls(rest, tab, ctors)])
  }
}

# Build the `slot_mask` value for a payload type list. 2 bits per
# `variant_slot_pos` / `variant_slot_mask` / `variant_has_primitive_slot`
# moved to `emit_shared` (single source shared with the native backend).

# Emit a single `KaiVarSlot` initialiser for arg `e` against payload
# type `te`. For pointer slots: `{.ptr = <boxed>}`. For Int/Real: pass
# the boxed value through `kai_take_int` / `kai_take_real` so the
# ephemeral box (e.g. a freshly-allocated `kai_int(7)`) gets
# released, and the raw scalar lands in the typed slot. Singleton
# Ints survive the decref because their rc is pinned at INT32_MAX.

# Emit a single `KaiVarSlot` initialiser for arg `e` against payload
# type `te`. For pointer slots: `{.ptr = <boxed>}`. For Int/Real: pass
# the boxed value through `kai_take_int` / `kai_take_real` so the
# ephemeral box (e.g. a freshly-allocated `kai_int(7)`) gets
# released, and the raw scalar lands in the typed slot. Singleton
# Ints survive the decref because their rc is pinned at INT32_MAX.
# If `e` is a nullary-constructor literal (`Red`, `Black`, …), return its
# immediate variant tag. A nullary ctor surfaces either as a reference
# or as a zero-arg call of one, and answers from its row.
fn nullary_ctor_tag(e: Expr, cx: EmitCtx) : Option[Int] = match e.kind {
  ECall(callee, args_) -> match args_ {
    [] -> ctor_ref_tag(callee, cx)
    _  -> None
  }
  _ -> ctor_ref_tag(e, cx)
}

fn ctor_ref_tag(e: Expr, cx: EmitCtx) : Option[Int] = match ctor_ix_site(cx.ctor_ix, e) {
  Some(row) -> Some(ctor_row_tag(row))
  None      -> None
}

# i64-inline (Lane B): emit the RAW int64 form to store into a kind-1 Int
# slot, avoiding the kai_take_int(kai_int(...)) round-trip wherever the
# value is already raw. Three raw sources, one boxed fallback:
#   - a kind-1 raw binder (set membership): `kair_<nm>` directly.
#   - any MUnboxed Expr (raw param `kair_<p>`, raw literal, raw arith):
#     `emit_expr_raw` yields the int64 form with no box.
#   - otherwise (a boxed Int from a generic call / record field): the
#     value really is a tagged `KaiValue *`, so `kai_take_int` unpacks it.
# The boxed fallback is the ONLY route that may see a tagged pointer, and
# it desugars it correctly — no tagged value ever lands raw in `.i64`.
fn store_raw_int(src: String, e: Expr, cx: EmitCtx) : String / Console {
  match e.kind {
    ELocal(l) ->
      if emit_ctx_kind1_raw_has(cx, l) { concat_all(["kair_", emit_local_text(cx, l)]) }
      else { match e.mode { MUnboxed -> emit_expr_raw(src, e, cx) _ -> concat_all(["kai_take_int(", emit_expr(src, e, cx), ")"]) } }
    _ -> match e.mode { MUnboxed -> emit_expr_raw(src, e, cx) _ -> concat_all(["kai_take_int(", emit_expr(src, e, cx), ")"]) }
  }
}

fn emit_variant_slot_init(src: String, e: Expr, k: Int,
                          cx: EmitCtx) : String / Console {
  if k == 1 {
    # i64-inline (Lane B) store peephole: when the value is a kind-1 raw
    # binder read in MUnboxed mode (rb-tree re-store of a key/value field),
    # write `kair_<nm>` directly — no kai_take_int(kai_int(kair)) round-trip.
    # Gated on MODE (the unbox pass output), not ty: a boxed Int (mode
    # MBoxed) with ty Int must still go through kai_take_int, else a tagged
    # pointer lands in `.i64`. That MODE-vs-ty distinction is the corruption
    # the earlier attempts hit.
    store_raw_int(src, e, cx)
  } else if k == 2 {
    concat_all(["kai_take_real(", emit_expr(src, e, cx), ")"])
  } else if k == 3 {
    # Enum slot: store the immediate variant_tag. When `e` is a nullary
    # ctor literal (`Red`/`Black`), emit the tag DIRECTLY — skip the
    # `kai_take_enum(kai_variant_u(tag,"Red",0,0,NULL))` round-trip that
    # allocates the singleton box only to read its tag and release it.
    # This is the enum analogue of the tagged-Int direct read (#741): the
    # field IS the tag, so a literal ctor is a plain integer store. A
    # non-literal enum expr (a bound variable of enum type) still routes
    # through kai_take_enum to read whatever tag it carries.
    match nullary_ctor_tag(e, cx) {
      Some(tag) -> int_to_string(tag)
      None      -> concat_all(["kai_take_enum(", emit_expr(src, e, cx), ")"])
    }
  } else {
    emit_expr(src, e, cx)
  }
}

fn variant_slot_field(k: Int) : String =
  if k == 1 or k == 3 { ".i64" } else if k == 2 { ".r" } else { ".ptr" }

# The slot initializers of a typed variant ctor, values sequenced left to
# right. An arity mismatch against the decl (the typer rejects it earlier)
# falls back to pointer slots to keep the C compilable.
fn emit_variant_slot_init_list(src: String, args_e: [Expr], tys: [Int],
                               cx: EmitCtx) : SeqOps / Console {
  let q = seq_operands(emit_variant_slot_vals(src, args_e, tys, cx))
  match q {
    SeqOps(binds, refs) -> SeqOps(binds, variant_slot_inits(refs, variant_slot_fields(args_e, tys, cx)))
  }
}

fn emit_variant_slot_vals(src: String, args_e: [Expr], tys: [Int], cx: EmitCtx) : [String] / Console =
  match args_e {
    [] -> []
    [e, ...rest_e] -> match tys {
      []             -> [emit_expr(src, e, cx), ...emit_variant_slot_vals(src, rest_e, [], cx)]
      [t, ...rest_t] -> [emit_variant_slot_init(src, e, t, cx), ...emit_variant_slot_vals(src, rest_e, rest_t, cx)]
    }
  }

fn variant_slot_fields(args_e: [Expr], tys: [Int], cx: EmitCtx) : [String] = match args_e {
  [] -> []
  [_, ...rest_e] -> match tys {
    []             -> [".ptr", ...variant_slot_fields(rest_e, [], cx)]
    [t, ...rest_t] -> [variant_slot_field(t), ...variant_slot_fields(rest_e, rest_t, cx)]
  }
}

fn variant_slot_inits(refs: [String], fields: [String]) : [String] = match refs {
  [] -> []
  [r, ...rest] -> match fields {
    []             -> [concat_all(["{.ptr = ", r, "}"]), ...variant_slot_inits(rest, [])]
    [f, ...rest_f] -> [concat_all(["{", f, " = ", r, "}"]), ...variant_slot_inits(rest, rest_f)]
  }
}

# Phase 2 entry point for variant construction. When the variant has
# at least one primitive payload slot, emit `kai_variant_u` with a
# typed slot literal and a populated mask. Otherwise return None so
# the caller falls back to the legacy `kai_variant` path.

# Phase 2 entry point for variant construction. When the variant has
# at least one primitive payload slot, emit `kai_variant_u` with a
# typed slot literal and a populated mask. Otherwise return None so
# the caller falls back to the legacy `kai_variant` path.
fn emit_variant_call_typed(tag: Int, name: String, args_e: [Expr],
                           tys: [Int], src: String, cx: EmitCtx) : Option[String] / Console {
  if variant_has_primitive_slot(tys) {
    let n = list_length(args_e)
    let mask = variant_slot_mask(tys)
    let slots = emit_variant_slot_init_list(src, args_e, tys, cx)
    let tag_str = int_to_string(tag)
    # Outside a region, a primitive-slot ctor goes through the inlined
    # `kai_variant_u_fast(tag, n, slots)`: alloc + slot stores only. Its
    # tag→name/mask is registered once at startup (kai_register_payload_
    # ctors), so the body carries no register and the inliner folds it
    # into the caller — the Koka kk_alloc + field-stores shape. In a
    # region the arena ctor owns the alloc (cells die with the arena, not
    # via RC) and keeps the full (tag,name,n,mask,slots) call shape.
    if cx.in_region {
      Some(seq_wrap(slots, concat_all([
        emit_variant_ctor(cx), tag_str, ", \"", name, "\", ", int_to_string(n),
        ", ", int_to_string(mask),
        ", (KaiVarSlot[]){", seq_joined(slots), "})"
      ])))
    } else {
      Some(seq_wrap(slots, concat_all([
        "kai_variant_u_fast(", tag_str, ", ", int_to_string(n),
        ", (KaiVarSlot[]){", seq_joined(slots), "})"
      ])))
    }
  } else {
    None
  }
}

# Lower a reuse-variant rebuild given the constructor's row + arg
# expressions. Typed-payload ctors
# (issue #440) still route to the
# alloc-fresh `kai_variant_u`: `kai_reuse_or_alloc_variant` writes
# `slots[i].ptr` and assumes `slot_mask == 0`, which would mismatch
# the typed extract (`slots[i].i64`). Reuse-for-typed-cells is a
# follow-up lane.
# A region rebuild that would otherwise reuse-in-place: bump-allocate a
# fresh cell in the current arena. Mirrors the two `emit_variant_call_typed`
# shapes — typed slots + mask when the variant has a primitive payload,
# boxed slots otherwise — but always `kai_arena_variant`.
fn emit_arena_variant_rebuild(src: String, tag: Int, cname: String, cargs: [Expr], n: Int,
                              tys_opt: Option[[Int]], has_prim: Bool,
                              cx: EmitCtx) : String / Console {
  let tag_str = int_to_string(tag)
  if has_prim {
    match tys_opt {
      Some(ts) -> {
        let mask = variant_slot_mask(ts)
        let slots = emit_variant_slot_init_list(src, cargs, ts, cx)
        seq_wrap(slots, concat_all([
          "kai_arena_variant(", tag_str, ", \"", cname, "\", ", int_to_string(n),
          ", ", int_to_string(mask), ", (KaiVarSlot[]){", seq_joined(slots), "})"
        ]))
      }
      None -> "kai_unit() /* arena reuse: typed lookup vanished */"
    }
  } else {
    let slots = emit_slot_ops(src, cargs, cx)
    seq_wrap(slots, concat_all([
      "kai_arena_variant(", tag_str, ", \"", cname, "\", ", int_to_string(n),
      ", 0, (KaiVarSlot[]){", seq_joined(slots), "})"
    ]))
  }
}

fn emit_reuse_variant_body(src: String, row: VariantEntry, cargs: [Expr],
                           cx: EmitCtx) : String / Console { match row { EV(_, cname, ar, ks, tag) -> {
  let n = list_length(cargs)
  let tys_opt = if ar == n { Some(ks) } else { None }
  let tag_str = int_to_string(tag)
  let has_prim = match tys_opt {
    Some(ts) -> variant_has_primitive_slot(ts)
    None     -> false
  }
  # In a region, reuse-in-place is off (arena cells carry the immortal
  # sentinel rc, so `kai_check_unique` returns 0 and no rebuild recycles
  # them); the ctor bump-allocates fresh in the arena and the whole
  # region frees at once. Route the rebuild to the arena ctor instead of
  # `kai_variant_reuse_at` / `kai_reuse_or_alloc_variant`, both of which
  # target the RC heap.
  if cx.in_region {
    emit_arena_variant_rebuild(src, tag, cname, cargs, n, tys_opt, has_prim, cx)
  } else if has_prim {
    match tys_opt {
      Some(ts) -> {
        let mask = variant_slot_mask(ts)
        let slots = emit_variant_slot_init_list(src, cargs, ts, cx)
        # Koka reuse-in-place for typed cells too (the rb-tree's RBNode
        # carries Int slots). kai_variant_reuse_at donates the consumed
        # match scrutinee `_scr` when unique (move semantics), else
        # allocates fresh — it writes the full KaiVarSlot words so the
        # primitive `.i64`/`.r` slots are stored correctly, unlike the
        # old kai_reuse_or_alloc_variant which assumed mask==0.
        seq_wrap(slots, concat_all([
          "kai_variant_reuse_at(_scr, ", tag_str, ", \"", cname, "\", ", int_to_string(n),
          ", ", int_to_string(mask),
          ", (KaiVarSlot[]){", seq_joined(slots), "})"
        ]))
      }
      None -> emit_mark_bad(MkReuseVariant, "typed lookup vanished")
    }
  } else if n == 0 {
    concat_all([
      "kai_reuse_or_alloc_variant(_scr, ", tag_str, ", \"", cname,
      "\", 0, 0, NULL)"
    ])
  } else {
    let slots = emit_slot_ops(src, cargs, cx)
    seq_wrap(slots, concat_all([
      "kai_reuse_or_alloc_variant(_scr, ", tag_str, ", \"", cname,
      "\", ", int_to_string(n),
      ", 0, (KaiVarSlot[]){", seq_joined(slots), "})"
    ]))
  }
} } }

fn emit_call_expr(src: String, f: Expr, args_e: [Expr], cx: EmitCtx) : String / Console =
  match f.kind {
    # A mark in callee position names no C symbol: it asks for a
    # lowering the mark itself decides. A tail step keeps the arguments
    # of the call it replaces, so it takes the named path for what that
    # path does to them.
    EMark(m) -> if mark_is_tail_step(m) { emit_call_expr_named(src, f, args_e, cx) }
                else { emit_mark_call(src, m, args_e, cx) }
    _        -> emit_call_expr_named(src, f, args_e, cx)
  }

# The C a mark lowers to. A mark the C backend does not lower reaches
# here only if a pass planted one this emitter never learned; naming it
# beats emitting a call to a symbol that does not exist.
fn emit_mark_call(src: String, m: Mark, args_e: [Expr], cx: EmitCtx) : String / Console =
  match m {
    # Both drop marks lower to the runtime decref, which returns unit so
    # the call site still type-checks as a value.
    MkGuardDrop -> match args_e {
      [a] -> concat_all(["kai_internal_drop(", emit_expr(src, a, cx), ")"])
      _   -> "kai_unit() /* guard drop: arity mismatch */"
    }
    MkDrop -> match args_e {
      [a] -> concat_all(["kai_internal_drop(", emit_expr(src, a, cx), ")"])
      _   -> "kai_unit() /* drop: arity mismatch */"
    }
    MkBorrow -> match args_e {
      [a] -> emit_expr(src, a, cx)
      _   -> "kai_unit() /* borrow: arity mismatch */"
    }
    # A borrowing indirect call: slot 0 is invoked without being consumed
    # (no closure decref), so the caller keeps the ref and drops after its
    # last use. The remaining args keep the owned convention.
    MkApplyBorrow -> match args_e {
      [fv, ...rest] -> emit_apply_seq("kai_apply_borrow(", emit_expr(src, fv, cx), emit_arg_vals(src, rest, cx))
      _ -> "kai_unit() /* apply borrow: expected closure + args */"
    }
    # A non-modulo-cons tail leaf: plug the leaf value into the open cctx
    # hole and return the spine root.
    MkTrmcApply -> match args_e {
      [leaf] -> concat_all([
        "kai_cctx_apply_linear(_kai_acc, ", emit_expr(src, leaf, cx), ")"
      ])
      _ -> "kai_unit() /* trmc apply: arity mismatch */"
    }
    # Normally the enclosing call emits the closure plus the drop-after,
    # having seen this mark on one of its args. Reaching here means a
    # rarer path (a pipe splice) did not capture it as such an arg, so
    # emit the inner value and skip the drop — a bounded leak, never a
    # miscompile.
    MkOwnedBorrow -> match args_e {
      [g] -> emit_expr(src, g, cx)
      _   -> "kai_unit() /* owned borrow: arity mismatch */"
    }
    # A dup lowers to the runtime incref, which hands its operand back.
    MkDup -> match args_e {
      [a] -> concat_all(["kai_internal_dup(", emit_expr(src, a, cx), ")"])
      _   -> emit_mark_bad(m, "arity mismatch")
    }
    MkReuseCons    -> emit_reuse_cons_call(src, m, args_e, cx)
    MkReuseRecord  -> emit_reuse_record_call(src, m, args_e, cx)
    MkReuseVariant -> emit_reuse_variant_call(src, m, args_e, cx)
    _ -> concat_all(["kai_unit() /* no lowering for mark ", mark_name(m), " */"])
  }

# A mark call the emitter cannot lower, named in the C it leaves behind.
fn emit_mark_bad(m: Mark, why: String) : String =
  concat_all(["kai_unit() /* ", mark_name(m), ": ", why, " */"])

# Reuse-in-place for a cons cell: `(scr, head, tail)` inside a
# `match SCRUT { [h, ...t] -> ... }` arm body. The scrutinee mark lowers
# to the match emitter's local `_scr`. The runtime helper reads
# `_scr->rc`: when unique it rewrites the cell in place and increfs it so
# it survives the `kai_decref(_scr)` at match exit; otherwise it falls
# back to `kai_cons` and leaves `_scr` for the match exit to reclaim.
fn emit_reuse_cons_call(src: String, m: Mark, args_e: [Expr], cx: EmitCtx) : String / Console =
  match args_e {
    [_scr, h, t] -> seq_call("kai_reuse_or_alloc_cons(_scr, ",
                             [emit_expr(src, h, cx), emit_expr(src, t, cx)], ")")
    _ -> emit_mark_bad(m, "arity mismatch (expected 3 args)")
  }

# Reuse-in-place for a record cell: `(scr, {field: val, ...})` where the
# literal is a same-arity rebuild. Its field exprs and names are forwarded
# in the shape `kai_record` expects.
fn emit_reuse_record_call(src: String, m: Mark, args_e: [Expr], cx: EmitCtx) : String / Console =
  match args_e {
    [_scr, lit] -> match lit.kind {
      ERecordLit(_, fis) -> {
        let n = list_length(fis)
        let vals  = seq_operands(map(fis, (fi) => emit_field_init_val(src, fi, cx)))
        let names = join_with(map(fis, emit_field_init_name), ", ")
        emit_rec_stamp(seq_wrap(vals, concat_all([
          "kai_reuse_or_alloc_record(_scr, ",
          int_to_string(n),
          ", (KaiValue *[]){", seq_joined(vals), "}, (const char *[]){", names, "}, ",
          int_to_string(record_kept_mask(fis, 0, 0)), "ULL)"
        ])), rec_stamp_of(cx.stamps, lit.ty))
      }
      _ -> emit_mark_bad(m, "2nd arg must be a record literal")
    }
    _ -> emit_mark_bad(m, "arity mismatch (expected 2 args)")
  }

# Reuse-in-place for a variant cell: `(scr, Ctor(args...))` where the
# second arg is a constructor call of the same arity.
fn emit_reuse_variant_call(src: String, m: Mark, args_e: [Expr], cx: EmitCtx) : String / Console =
  match args_e {
    [_scr, ctor] -> match ctor.kind {
      ECall(cf, cargs) -> match ctor_ix_site(cx.ctor_ix, cf) {
        Some(row) -> emit_reuse_variant_body(src, row, cargs, cx)
        None      -> emit_mark_bad(m, "2nd arg must be a variant constructor call")
      }
      _ -> emit_mark_bad(m, "2nd arg must be a variant constructor call")
    }
    _ -> emit_mark_bad(m, "arity mismatch (expected 2 args)")
  }

fn emit_call_expr_named(src: String, f: Expr, args_e: [Expr], cx: EmitCtx) : String / Console {

  # issue #1130 rule 1 — drop-after-call for a freshly materialised closure
  # in a borrowed slot. perceus marks such an arg `__perceus_owned_borrow(g)`;
  # the callee borrows it (never drops), so the caller balances its birth ref
  # AFTER the call. Wrap the whole call in a local C statement-expression:
  # each marked arg is bound to a temp, the call runs, then each temp is
  # decref'd. This is invisible to tcrec/TCO (the ref never existed in the
  # AST — it is born here as `kai_closure`), unlike an AST-level EBlock wrap.
  if emit_args_have_owned_borrow(args_e) {
    emit_call_with_owned_borrow_drops(src, f, args_e, cx)
  } else {

  # Phase 3 unboxing — when the callee resolves to a UFn (raw C
  # signature), emit the call against raw args and wrap the
  # result with `kai_int` / `kai_bool` / `kai_char` / `kai_real`
  # so the boxed-context caller still sees a `KaiValue *`. This
  # short-circuits the regular dispatch chain (variant / core /
  # closure-thunk fallback) because UFns are exclusively
  # user-declared top-level fns: a let-bound closure is a local
  # read, whatever it is named, and keeps the boxed call site.
  # Vec raw fuse: `vec_push(v, Rec{..})` / `vec_set(v, i, Rec{..})` on
  # an inline-record carrier move the unpacked scalar fields straight
  # into the buffer — the record is never allocated. The uniqueness
  # decision stays inside the runtime helper.
  match emit_vec_write_rec_fused(src, f, args_e, cx) {
    Some(s) -> s
    None ->
      match emit_ufn_boxed_call(src, f, args_e, cx) {
        Some(s) -> s
        None    -> emit_call_expr_default(src, f, args_e, cx)
      }
  }
  }
}

fn emit_args_have_owned_borrow(args_e: [Expr]) : Bool = match args_e {
  []           -> false
  [a, ...rest] -> if emit_is_owned_borrow(a) { true } else { emit_args_have_owned_borrow(rest) }
}

fn emit_is_owned_borrow(a: Expr) : Bool = match a.kind {
  ECall(callee, _) -> match callee.kind {
    EMark(MkOwnedBorrow) -> true
    _                    -> false
  }
  _ -> false
}

# Unwrap `__perceus_owned_borrow(g)` to `g` (the fn-name / closure expr).
fn emit_owned_borrow_inner(a: Expr) : Expr = match a.kind {
  ECall(_, inner) -> match inner { [x] -> x  _ -> a }
  _               -> a
}

# `({ KaiValue *kaiv_bcN = <clo>; ...; KaiValue *_bcr = <call with kaiv_bcN>;
#     kai_decref(kaiv_bcN); ...; _bcr; })`. Each `__perceus_owned_borrow` arg
# is materialised into a temp `bcN` (a binder minted under that key, so its
# read re-emits as the `kaiv_bcN` local), the call runs borrowing them, then
# each temp is dropped — the birth ref the callee did not consume.
fn emit_call_with_owned_borrow_drops(src: String, f: Expr, args_e: [Expr], cx: EmitCtx) : String / Console {
  let hold = emit_ob_hold(f, args_e, emit_ctx_declaring(cx, emit_ob_names(args_e, 0)))
  let binds = emit_ob_binds(src, args_e, 0, cx)
  let call_args = emit_ob_rewrite_args(args_e, 0)
  let call = match emit_ufn_boxed_call(src, f, call_args, hold.cx) {
    Some(s) -> s
    None    -> emit_call_expr_default(src, f, call_args, hold.cx)
  }
  let drops = emit_ob_drops(args_e, 0)
  concat_all(["({ ", binds, hold.push, "KaiValue *_bcr = ", call, "; ", hold.pop, drops, "_bcr; })"])
}

# An owned-borrow temp computed in place is held by no binder, so across a
# call that can unwind it is registered for the call's extent; an early
# return out of the call's operands pops it and releases the temps. A temp
# that only renames a binder is not: the binder is registered already.
type ObHold = { push: String, pop: String, cx: EmitCtx }

fn emit_ob_hold(f: Expr, args_e: [Expr], cx: EmitCtx) : ObHold = match emit_ob_fresh(args_e, 0) {
  [] -> ObHold { push: "", pop: "", cx: cx }
  names -> if cx.unw.sites != [] and unw_call_unwinds(f, args_e, cx.unw.bound, cx.unw.ucx) {
    let vars = map(names, c_local)
    let pend = list_append(list_append(cx.tcpend, [tcl_unw_entry("_uwo")]), map(vars, tcl_scr_entry))
    ObHold { push: euw_vars_push("_uwo", vars), pop: euw_pop("_uwo"), cx: emit_ctx_with_tcpend(cx, pend) }
  } else { ObHold { push: "", pop: "", cx: cx } }
}

fn emit_ob_fresh(args_e: [Expr], i: Int) : [String] = match args_e {
  []           -> []
  [a, ...rest] -> {
    let more = emit_ob_fresh(rest, i + 1)
    if emit_is_owned_borrow(a) and not unw_bare_read(emit_owned_borrow_inner(a)) { [cat2("bc", int_to_string(i)), ...more] } else { more }
  }
}

fn emit_ob_names(args_e: [Expr], i: Int) : [String] = match args_e {
  []           -> []
  [a, ...rest] -> {
    let more = emit_ob_names(rest, i + 1)
    if emit_is_owned_borrow(a) { [concat_all(["bc", int_to_string(i)]), ...more] } else { more }
  }
}

fn emit_ob_binds(src: String, args_e: [Expr], i: Int, cx: EmitCtx) : String / Console = match args_e {
  []           -> ""
  [a, ...rest] -> {
    let more = emit_ob_binds(src, rest, i + 1, cx)
    if emit_is_owned_borrow(a) {
      concat_all(["KaiValue *", c_local(cat2("bc", int_to_string(i))), " = ",
                  emit_expr(src, emit_owned_borrow_inner(a), cx), "; ", more])
    } else { more }
  }
}

# Replace each `__perceus_owned_borrow(g)` arg with a read of its temp
# `bcN`; leave the rest untouched.
fn emit_ob_rewrite_args(args_e: [Expr], i: Int) : [Expr] = match args_e {
  []           -> []
  [a, ...rest] -> {
    let a2 = if emit_is_owned_borrow(a) {
               Expr { kind: ELocal(local_minted(concat_all(["bc", int_to_string(i)]))),
                      line: a.line, col: a.col, ty: a.ty, mode: a.mode,  site: a.site }
             } else { a }
    [a2, ...emit_ob_rewrite_args(rest, i + 1)]
  }
}

fn emit_ob_drops(args_e: [Expr], i: Int) : String = match args_e {
  []           -> ""
  [a, ...rest] -> {
    let more = emit_ob_drops(rest, i + 1)
    if emit_is_owned_borrow(a) {
      concat_all(["kai_decref(", c_local(cat2("bc", int_to_string(i))), "); ", more])
    } else { more }
  }
}

# Phase 3 unboxing — try to emit the call as a raw-call boxed
# (`kai_<T>(callee(raw_args))`). Returns None when the callee
# does not resolve to a UFn; the caller falls back to the
# original boxed-only dispatch.

# Phase 3 unboxing — try to emit the call as a raw-call boxed
# (`kai_<T>(callee(raw_args))`). Returns None when the callee
# does not resolve to a UFn; the caller falls back to the
# original boxed-only dispatch.
fn emit_ufn_boxed_call(src: String, f: Expr, args_e: [Expr], cx: EmitCtx) : Option[String] / Console =
  match fnx_callee(cx.fx, ec_callee_sym(f)) {
    Some(EFn(n, _, mo, Some(US(ptys, rt, mask)), _)) -> {
      let raw_call = emit_user_call_seq(c_sym(written_text(n), mo), emit_arg_vals_masked(src, args_e, mask, ptys, cx), cx)
      Some(ufn_call_result(rt, raw_call))
    }
    _ -> None
  }


# A raw-core C-API call yields a raw scalar (a `void *` handle, `int64_t`
# or unit), so it is emitted inline with per-param-marshalled args, never
# a boxed round-trip that would read a `void *` as an Int.
fn emit_raw_rcore(src: String, callee_e: Expr, args_e: [Expr], cx: EmitCtx) : Option[String] / Console =
  match core_ix_raw(cx.core_ix, fnid_sym(ec_callee_sym(callee_e))) {
    Some(RP(_, cname, ptys, _)) -> Some(emit_rcore_call(src, cname, ptys, args_e, cx))
    None                        -> None
  }

fn ec_unit_coercion(f: Expr) : Bool = match builtin_ref(f) {
  Some(b) -> builtin_is_unit_coercion(b)
  None    -> false
}

fn ec_declared(cx: EmitCtx, f: Expr) : Bool = match fnx_of_sym(cx.fx, ec_callee_sym(f)) {
  Some(_) -> true
  None    -> false
}

# The function a callee references, none for any other callee.
fn ec_callee_sym(f: Expr) : FnId = match f.kind {
  ESym(s, inst) -> FnId(s, inst)
  _             -> fnid_none()
}

# A callee that references a constructor builds the cell its row lays out.
fn emit_call_expr_default(src: String, f: Expr, args_e: [Expr], cx: EmitCtx) : String / Console =
  match ctor_ix_site(cx.ctor_ix, f) {
    Some(row) -> emit_ctor_call(src, row, args_e, cx)
    None      -> emit_callee_call(src, f, args_e, cx)
  }

# Typed slots where the row has a primitive one, boxed slots otherwise.
fn emit_ctor_call(src: String, row: VariantEntry, args_e: [Expr], cx: EmitCtx) : String / Console = match row {
  EV(_, name, _, tys, tag) -> match emit_variant_call_typed(tag, name, args_e, tys, src, cx) {
    Some(s) -> s
    None    -> emit_variant_call(tag, name, list_length(args_e), emit_slot_ops(src, args_e, cx), cx)
  }
}

# m7a #6d: `resume(v)` lowers to a runtime call that performs
# the one-shot status check, flips the status, and tail-calls
# the continuation's `fn` (currently kai_cont_identity, until
# the full CPS transform reifies the rest of the caller's
# body). Doc C §*resume representation*.
fn emit_resume_call(src: String, args_e: [Expr], cx: EmitCtx) : String / Console =
  match args_e {
    [a] -> concat_all([
      "kai_cont_resume(k, ", emit_expr(src, a, cx), ")"
    ])
    # 2-arg resume `resume(v, new_state)`: the Ev owns its state, so
    # the new state replaces the old one, which is released only
    # after `ns` is evaluated (it may be built from `state`).
    [a, ns] -> concat_all([
      "({ KaiValue *_rv = ", emit_expr(src, a, cx),
      "; KaiValue *_os = self->state; self->state = ", emit_expr(src, ns, cx),
      "; kai_decref(_os); kai_cont_resume(k, _rv); })"
    ])
    _   -> "kai_unit() /* resume: arity mismatch (expected 1 or 2 args) */"
  }

# A local in callee position holds a closure, or is the clause's
# continuation.
fn emit_local_call(src: String, l: LocalId, args_e: [Expr], cx: EmitCtx) : String / Console =
  if local_eq(l, local_minted(canonical_continuation())) { emit_resume_call(src, args_e, cx) }
  else { emit_apply_seq("kai_apply(", c_local_of(cx, l), emit_arg_vals(src, args_e, cx)) }

fn emit_callee_call(src: String, f: Expr, args_e: [Expr], cx: EmitCtx) : String / Console {
  # Each branch emits the arguments it needs itself: emitting them up front
  # for a branch that spells them its own way emits every nested argument
  # twice per level, which is exponential in the nesting depth.
  match f.kind {
    ESym(s, inst) -> {
      # A reference to a declared fn calls it, whatever builtin
      # or intrinsic shares its row.
      if ec_declared(cx, f) {
        emit_sym_call(src, FnId(s, inst), args_e, cx)
      } else if ec_unit_coercion(f) {
        # typer-internal unit erasure/tagging (`Real<u>` -> `Real`,
        # `Decimal` <-> `Decimal<c>`). At runtime all three are
        # identity — units carry no representation, so the lowered
        # call is exactly the inner expression. (`__strip_unit` is
        # the Real-specific legacy spelling the parametric Show impl
        # in stdlib/protocols.kai uses.)
        match args_e {
          [a] -> emit_expr(src, a, cx)
          _   -> "kai_unit() /* unit tag intrinsic: expected 1 arg */"
        }
      } else if is_builtin_ref(f, CbUnitName) {
        # m12.8.x phase 2 (Gap 1, partial): compile-time reflection
        # on the dimensioned argument. Inlines the canonical unit
        # symbol as a String literal. Reads the arg's `.ty` (which
        # the typed-AST finalisation pass populated with the fully
        # substituted type). When the unit is still a UVar (e.g.
        # the protocol-impl-generic case) or the arg type is bare
        # `Real` with no dimension, an empty string literal is
        # emitted instead of failing — keeps user code that calls
        # `unit_name` defensively well-defined.
        match args_e {
          [a] -> {
            let nm = unit_name_of_ty(a.ty)
            concat_all(["kai_str(\"", nm, "\")"])
          }
          _ -> "kai_unit() /* unit_name: expected 1 arg */"
        }
      } else if is_builtin_ref(f, CbBitAnd) {
        # m13: bit ops are compiler intrinsics — each lowers inline to
        # the matching C operator. The shape is consistent across the
        # binary ops: read both KaiInts, apply the operator on `as.i`,
        # box the result, decref the inputs. Refcounting matches
        # `kai_op_add` in stage0/runtime.h: caller hands us values we own
        # and must release exactly once.
        match args_e {
          [a, b] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_b = ", emit_expr(src, b, cx),
            "; KaiValue *_r = kai_int(kai_intf(_a) & kai_intf(_b)); ",
            "kai_decref(_a); kai_decref(_b); _r; })"
          ])
          _ -> "kai_unit() /* bit_and: expected 2 args */"
        }
      } else if is_builtin_ref(f, CbBitOr) {
        match args_e {
          [a, b] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_b = ", emit_expr(src, b, cx),
            "; KaiValue *_r = kai_int(kai_intf(_a) | kai_intf(_b)); ",
            "kai_decref(_a); kai_decref(_b); _r; })"
          ])
          _ -> "kai_unit() /* bit_or: expected 2 args */"
        }
      } else if is_builtin_ref(f, CbBitXor) {
        match args_e {
          [a, b] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_b = ", emit_expr(src, b, cx),
            "; KaiValue *_r = kai_int(kai_intf(_a) ^ kai_intf(_b)); ",
            "kai_decref(_a); kai_decref(_b); _r; })"
          ])
          _ -> "kai_unit() /* bit_xor: expected 2 args */"
        }
      } else if is_builtin_ref(f, CbBitNot) {
        # Unary: a single `~`. Refcount matches `bit_count`.
        match args_e {
          [a] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_r = kai_int(~ kai_intf(_a)); ",
            "kai_decref(_a); _r; })"
          ])
          _ -> "kai_unit() /* bit_not: expected 1 arg */"
        }
      } else if is_builtin_ref(f, CbBitShl) {
        # Shifted-out bits wrap (`Int` wrapping discipline, computed in
        # `uint64_t`); the count is masked to `& 63` so every shift is
        # defined C. Same discipline across the shift family below.
        match args_e {
          [a, b] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_b = ", emit_expr(src, b, cx),
            "; KaiValue *_r = kai_int((int64_t)((uint64_t) kai_intf(_a) << (kai_intf(_b) & 63))); ",
            "kai_decref(_a); kai_decref(_b); _r; })"
          ])
          _ -> "kai_unit() /* bit_shl: expected 2 args */"
        }
      } else if is_builtin_ref(f, CbBitShr) {
        # Arithmetic shift: signed `>>` preserves the sign bit. The
        # contrast with `bit_ushr` rests on `kai_intf(_a)` staying
        # `int64_t`.
        match args_e {
          [a, b] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_b = ", emit_expr(src, b, cx),
            "; KaiValue *_r = kai_int(kai_intf(_a) >> (kai_intf(_b) & 63)); ",
            "kai_decref(_a); kai_decref(_b); _r; })"
          ])
          _ -> "kai_unit() /* bit_shr: expected 2 args */"
        }
      } else if is_builtin_ref(f, CbBitUshr) {
        # Logical shift: cast through `uint64_t` to zero-fill, then
        # back to `int64_t` so the result fits the KaiInt slot.
        match args_e {
          [a, b] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_b = ", emit_expr(src, b, cx),
            "; KaiValue *_r = kai_int((int64_t)(((uint64_t) kai_intf(_a)) >> (kai_intf(_b) & 63))); ",
            "kai_decref(_a); kai_decref(_b); _r; })"
          ])
          _ -> "kai_unit() /* bit_ushr: expected 2 args */"
        }
      } else if is_builtin_ref(f, CbBitCount) {
        # `__builtin_popcountll` is GCC/Clang. Cast through `uint64_t`
        # so the count semantics don't depend on signed-bit handling.
        match args_e {
          [a] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_r = kai_int((int64_t) __builtin_popcountll((uint64_t) kai_intf(_a))); ",
            "kai_decref(_a); _r; })"
          ])
          _ -> "kai_unit() /* bit_count: expected 1 arg */"
        }
      } else if is_builtin_ref(f, CbBitTest) {
        # Returns Bool — boxed via `kai_bool`.
        match args_e {
          [a, b] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_b = ", emit_expr(src, b, cx),
            "; KaiValue *_r = kai_bool(((kai_intf(_a) >> (kai_intf(_b) & 63)) & 1) != 0); ",
            "kai_decref(_a); kai_decref(_b); _r; })"
          ])
          _ -> "kai_unit() /* bit_test: expected 2 args */"
        }
      } else if is_builtin_ref(f, CbBitSet) {
        match args_e {
          [a, b] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_b = ", emit_expr(src, b, cx),
            "; KaiValue *_r = kai_int(kai_intf(_a) | (int64_t)((uint64_t)1 << (kai_intf(_b) & 63))); ",
            "kai_decref(_a); kai_decref(_b); _r; })"
          ])
          _ -> "kai_unit() /* bit_set: expected 2 args */"
        }
      } else if is_builtin_ref(f, CbBitClear) {
        match args_e {
          [a, b] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_b = ", emit_expr(src, b, cx),
            "; KaiValue *_r = kai_int(kai_intf(_a) & ~(int64_t)((uint64_t)1 << (kai_intf(_b) & 63))); ",
            "kai_decref(_a); kai_decref(_b); _r; })"
          ])
          _ -> "kai_unit() /* bit_clear: expected 2 args */"
        }
      } else if is_builtin_ref(f, CbBitToggle) {
        match args_e {
          [a, b] -> concat_all([
            "({ KaiValue *_a = ", emit_expr(src, a, cx),
            "; KaiValue *_b = ", emit_expr(src, b, cx),
            "; KaiValue *_r = kai_int(kai_intf(_a) ^ (int64_t)((uint64_t)1 << (kai_intf(_b) & 63))); ",
            "kai_decref(_a); kai_decref(_b); _r; })"
          ])
          _ -> "kai_unit() /* bit_toggle: expected 2 args */"
        }
      } else {
        emit_sym_call(src, FnId(s, inst), args_e, cx)
      }
    }
    EOp(r) -> {
        # m7a #6c/#6d/#6e: op call `Eff.op(args)`. Look up the
        # innermost EvEff node, allocate a KaiCont on the stack
        # (identity continuation for one-shot resume), and indirect-
        # call the op fn ptr. After the clause returns, if it never
        # called resume (status stays UNRESUMED), pop the evidence
        # and longjmp to the enclosing handle's setjmp landing pad
        # — Doc A §*Discarding the continuation*. The default
        # handlers (m7a #7) always resume, so the longjmp branch is
        # a no-op for them; the node's handle_jmp is NULL there.
        let eff_n = rt_name(cx.tab, r.eff)
        # The Ev STRUCT type is module-qualified (`ev_name`) so two
        # same-name effects from different modules emit distinct C
        # structs. The runtime IDENTITY label is the instance key (`Eff` or
        # `Eff[args]`): the evidence stack and the frame slots are keyed by it.
        let eff_evn = ev_name_of(cx.tab, cx.effs, r.eff)
        let eff_idn = inst_key_of_callee(eff_n, f.ty)
        let op_n = written_text(r.op)
        # §6 named instances: a capability-parameter op call `c.op` goes
        # through `ViaRecv`. The evidence is the parameter `kaiv_<recv>`
        # itself (a `KaiEvidence *`), not a by-name walk — distinct capability
        # params resolve to distinct nodes by parameter position.
        # m7b #15 (compiler integration, scope-limited): a perform on an
        # `as`-bound cell goes through `ViaAlias`: dispatch via the handle's
        # local `kaiv_alias_<alias>_id` (kai_evidence_lookup_node_by_id);
        # otherwise the standard innermost-by-name lookup.
        # Capability-passing dispatch. When the enclosing fn's
        # evidence frame carries this effect (a transported user effect),
        # read the slot directly: the call site filled it with the right
        # instance's node, so no walk, no name lookup. Otherwise the legacy
        # paths stay live: by-id for an alias-tagged op, else the
        # innermost-by-name walk. Under KAI_EVIDENCE_FRAME_ONLY the walk
        # fallback is compiled out so a frame-carried effect MUST resolve
        # through its slot — the oracle that falsifies a wrong transport.
        let evf_slot = frame_slot_here(cx.evf, cx.cur_enc_fn, eff_idn)
        let walk_c = match r.via {
          ViaAlias(a) -> {
            # By-id resolves an aliased cell/capability. NULL means it was
            # performed on a child fiber that does not carry the alias (a
            # `var` cell does not cross a spawn). Guard the NULL into a clean
            # diagnostic instead of a `_node_op->handler` deref segfault.
            let alias_n = emit_local_text(cx, a)
            concat_all(["kai_evidence_require_reachable(kai_evidence_lookup_node_by_id(",
                        c_alias_id(alias_n), "), \"", alias_n, "\")"])
          }
          _ -> if effect_declares_default(cx.effs, r.eff) {
            # No caller frame here (a direct perform in a frameless fn such as
            # `main`): a lexical handler on the stack wins, else the minted
            # default node — the default is no longer on the stack for the walk.
            concat_all(["kai_evidence_lookup_or_default(\"", eff_idn,
                        "\", &_kai_default_node_", string_to_lower_ascii(eff_n), ")"])
          } else {
            # Bare walk: NULL when no handler is on this fiber's stack — a
            # fiber-local op (Actor/Cancel/…) performed in a spawned fiber whose
            # body installed none. `kai_evidence_require` reports it instead of
            # dereferencing the NULL node (the spawn evidence clone used to mask
            # this by inheriting the parent's handler across the spawn).
            concat_all(["kai_evidence_require(kai_evidence_lookup_node(\"", eff_idn,
                        "\"), \"", eff_idn, "\")"])
          }
        }
        let lookup_c = match r.via {
          # Capability value: the evidence is the node this local holds —
          # a `KaiEvidence *` param or the `&_node` an alias prologue binds.
          # The param ABI carries it as a `KaiValue *` scalar, so cast back.
          ViaRecv(x) -> concat_all(["((KaiEvidence *) ", c_local_of(cx, x), ")"])
          _ -> if evf_slot >= 0 { concat_all(["__evf[", int_to_string(evf_slot), "]"]) } else { walk_c }
        }
        # m8.x bug #12: mark the handler's evidence node as
        # in-dispatch across the clause invocation. The
        # `kai_evidence_lookup_node` walk skips flagged nodes, so
        # a recursive `Eff.op(...)` inside the clause resolves to
        # the *outer* handler and not back into ourselves.
        #
        # Args MUST be evaluated *before* the flag is set — they
        # may themselves invoke the same op (e.g.
        # `State.set(State.get() + 1)` evaluates `State.get()`
        # while constructing `set`'s argument). Setting the flag
        # before the args would make the inner `lookup_node` walk
        # past the live handler and crash. Bind each arg to a
        # `_op_arg_<i>` C local first; then flip the flag right
        # before invoking the clause.
        let arg_bindings = emit_op_arg_bindings(src, args_e, 0, cx)
        let arg_passes   = emit_op_arg_pass_list(args_e, 0)
        let pass_str     = match args_e {
          [] -> ""
          _  -> cat2(", ", arg_passes)
        }
        # A frame-slot read skips `kai_evidence_lookup_node`, where the
        # cooperative-cancel yield-point hook lives, so a Cancel requested while
        # this fiber was parked would never be delivered at the next op. Fire the
        # hook explicitly before a slot-resolved perform (the walk path already
        # runs it inside the lookup).
        # The fiber is read once: it is the same before and after the args.
        let fib_c = "KaiFiber *_disp_fib = kai_current_fiber(); "
        let yield_chk = if evf_slot >= 0 { cat2(fib_c, "kai_cancel_poll(_disp_fib); ") } else { "" }
        let fib_late = if evf_slot >= 0 { "" } else { fib_c }
        concat_all([
          "({ ", yield_chk, "KaiEvidence *_node_op = ", lookup_c, "; ",
          eff_evn, " *_ev_op = (", eff_evn, " *) _node_op->handler; ",
          "KaiCont _k; kai_cont_init_identity(&_k, _ev_op->handler_id); ",
          arg_bindings,
          fib_late,
          "KaiEvidence *_saved_disp = _disp_fib->in_dispatch_node; ",
          "_disp_fib->in_dispatch_node = _node_op; ",
          "KaiValue *_op_r = _ev_op->", op_n, "(_ev_op", pass_str, ", &_k); ",
          "_disp_fib->in_dispatch_node = _saved_disp; ",
          "if (_k.status == KAI_CONT_UNRESUMED && _node_op->handle_jmp != NULL) { ",
            "*_node_op->discard_slot = _op_r; ",
            "kai_evidence_unwind_to(_node_op); ",
            "_longjmp(*_node_op->handle_jmp, 1); ",
          "} ",
          "_op_r; })"
        ])
    }
    ELocal(l) -> emit_local_call(src, l, args_e, cx)
    # A modulo-cons site: `args_e` are the original ctor args, the one at
    # the step's hole being the self-call. Builds the cell with an open
    # hole, extends the cctx, rebinds the params and jumps.
    EMark(MkTrmcStep(s)) -> emit_trmc_step(src, s, args_e, cx)
    # A self-tail-call site: the rebind+goto block. `emit_fn_body` plants
    # the label it jumps to.
    EMark(MkTcrecStep(s)) -> tcrec_emit_goto(src, s.sym, s.dropmask, s.params, args_e, cx)
    _ -> emit_apply_seq("kai_apply(", emit_expr(src, f, cx), emit_arg_vals(src, args_e, cx))
  }
}

# A reference reaches the `fn` it resolved to, or the builtin whose row it
# carries: the id decides, never a spelling.
fn emit_sym_call(src: String, fid: FnId, args_e: [Expr], cx: EmitCtx) : String / Console =
  match fnx_callee(cx.fx, fid) {
    Some(EFn(n, _, mo, _, efid)) -> emit_fn_call_seq(efid, c_sym(written_text(n), mo), emit_arg_vals(src, args_e, cx), cx)
    # A raw core prim is checked before the boxed row: its args
    # marshal raw per the prim's param types and its result is raw.
    None -> match core_ix_raw(cx.core_ix, fnid_sym(fid)) {
      Some(RP(_, cname, ptys, _)) -> emit_rcore_call(src, cname, ptys, args_e, cx)
      None -> match core_ix_boxed(cx.core_ix, fnid_sym(fid)) {
        Some(ep) -> match ep {
          EP(_, cname, _) -> seq_call(cat2(cname, "("), emit_arg_vals(src, args_e, cx), ")")
        }
        None -> emit_apply_seq("kai_apply(", c_local(emit_fn_text(cx.tab, cx.specs, fid)), emit_arg_vals(src, args_e, cx))
      }
    }
  }

# True when the effect `s` declares a `default { }` block.
fn effect_declares_default(effs: [Decl], s: SymId) : Bool = match effect_decl_default(effect_decl_of(s, effs)) {
  Some(_) -> true
  None    -> false
}

# Fill the callee's evidence frame at the call site and prepend
# it to the user args. For each of the callee's slots, the value is what
# THIS caller resolves for that effect (its own supplier classification):
#   - the caller forwards it (the effect is in the caller's frame) →
#     `__evf[caller_idx]`;
#   - the effect has a `default {}` and no lexical handler here → the
#     startup-minted default node `&_kai_default_node_<eff>`;
#   - otherwise the caller has it lexically (a `handle` in scope) →
#     `kai_evidence_lookup_node("E")`, the node live at this point.
fn emit_evf_call_arg(slots: [String], call_args: String, cx: EmitCtx) : String = match slots {
  [] -> call_args
  _  -> {
    let frame = if evf_forwards_prefix(slots, 0, cx) { "__evf" }
                else { concat_all(["(KaiEvidence *[]){", emit_evf_slots(slots, cx), "}"]) }
    if call_args == "" { frame } else { concat_all([frame, ", ", call_args]) }
  }
}

# Every callee slot i is the caller's slot i: the callee gets the caller's own
# frame instead of a copy. A frame is never written after the call fills it,
# and each copy is a stack slot of its own in every recursive frame.
fn evf_forwards_prefix(slots: [String], i: Int, cx: EmitCtx) : Bool = match slots {
  [] -> true
  [eff, ...rest] -> frame_slot_here(cx.evf, cx.cur_enc_fn, eff) == i and evf_forwards_prefix(rest, i + 1, cx)
}

fn emit_evf_slots(slots: [String], cx: EmitCtx) : String =
  join_with(map(slots, (eff) => emit_evf_one_slot(eff, cx)), ", ")

fn emit_evf_one_slot(eff: String, cx: EmitCtx) : String = {
  let caller_idx = frame_slot_here(cx.evf, cx.cur_enc_fn, eff)
  if caller_idx >= 0 { concat_all(["__evf[", int_to_string(caller_idx), "]"]) }
  else { evf_terminal_slot(eff, cx) }
}

# A slot the caller does not forward: a lexical handler on the stack wins (the
# walk finds it), falling back to the minted default node for a default-bearing
# effect (no longer pushed). A non-default effect stays on the plain walk, whose
# NULL result (no handler on this fiber — the walk crossed a spawn) is reported
# by `kai_evidence_require` instead of stored as a NULL slot the perform derefs.
fn evf_terminal_slot(key: String, cx: EmitCtx) : String = evf_thunk_slot(key, cx.effs, cx.tab)

# Emit a direct user-fn call `kai_<csym>(<frame?><args>)`, prepending the
# evidence frame when the callee carries one. The single funnel every
# user-fn call site routes through, so the frame is filled consistently;
# a frameless callee (`frame_slots_of` empty) reduces to the legacy form.
# A declared core builtin is called as a `builtin_table` row is: its
# runtime symbol, the args owned, no evidence frame and no donor token.
fn emit_fn_call_seq(fid: FnId, csym: String, vals: [String], cx: EmitCtx) : String = match fnx_kai(cx.fx, fid) {
  Some(kb) -> emit_kai_call_seq(kb, vals)
  None     -> emit_user_call_seq(csym, vals, cx)
}

fn emit_kai_call_seq(kb: KaiBuiltin, vals: [String]) : String = seq_call(cat2(kai_builtin_csym(kb), "("), vals, ")")

fn emit_user_call_seq(csym: String, vals: [String], cx: EmitCtx) : String {
  let q = seq_operands(vals)
  seq_wrap(q, emit_user_call(csym, seq_joined(q), cx))
}

fn emit_user_call(csym: String, call_args: String, cx: EmitCtx) : String = {
  # A donation-capable callee has a trailing `_donor` param; EVERY call to
  # it must fill that slot. A call inside an arm-top-reuse body (a live
  # `_arm_ru` token, signalled by `reuse_donor`) MOVES the token into the
  # slot instead of letting the arm epilogue free it; every other call to a
  # capable callee passes a null token; a non-capable callee is unchanged.
  # The move is always sound — whichever consumer runs first wins, the rest
  # see null and fresh-alloc — so no tail-position analysis is needed here.
  if rd_is_capable(csym, cx.rd_capable) {
    match cx.reuse_donor {
      Some(_) -> rd_wrap_call(cat5(c_user_sym(csym), "(", emit_evf_call_arg(frame_slots_of(cx.evf, csym), call_args, cx), ")", ""))
      None    -> cat5(c_user_sym(csym), "(", rd_join_null_donor(emit_evf_call_arg(frame_slots_of(cx.evf, csym), call_args, cx)), ")", "")
    }
  } else {
    cat5(c_user_sym(csym), "(", emit_evf_call_arg(frame_slots_of(cx.evf, csym), call_args, cx), ")", "")
  }
}

# Join a frame ARGUMENT (already a `(KaiEvidence *[]){...}` value, or "") to
# the user args — the value-side analogue of `evf_join_params`.
fn evf_join_args(frame_arg: String, rest: String) : String =
  if frame_arg == "" { rest }
  else if rest == "" { frame_arg }
  else { concat_all([frame_arg, ", ", rest]) }

# The frame value a thunk passes: a default-bearing slot from its minted
# default node, else the live by-name walk (the thunk has no caller frame; the
# node live at the indirect call is the ≤1-handler-correct one). Empty when the
# callee carries no frame.
fn emit_evf_thunk_frame(slots: [String], effs: [Decl], tab: SymTab) : String = match slots {
  [] -> ""
  _  -> concat_all(["(KaiEvidence *[]){", join_with(map(slots, (e) => evf_thunk_slot(e, effs, tab)), ", "), "}"])
}

fn evf_thunk_slot(key: String, effs: [Decl], tab: SymTab) : String = {
  let eff = inst_key_eff(key)
  if effect_has_default_block(eff, effs, tab) {
    concat_all(["kai_evidence_lookup_or_default(\"", key,
                "\", &_kai_default_node_", string_to_lower_ascii(eff), ")"])
  } else { evf_require_walk(key) }
}

# A non-default frame slot resolved by the dynamic walk: `kai_evidence_require`
# turns a NULL result (no handler for `eff` on this fiber — a spawned fiber
# whose body installed none) into the `effect not handled in fiber` diagnostic,
# matching the perform-site walk path, instead of a NULL slot that segfaults
# when the op call derefs `_node_op->handler`. `Ffi` is exempt: it declares no
# ops and is routed around the dispatcher, so its slot node legitimately carries
# a NULL handler the FFI shim never dereferences — the bare lookup, not the
# guard, preserves that.
fn evf_require_walk(eff: String) : String =
  if eff == "Ffi" { concat_all(["kai_evidence_lookup_node(\"", eff, "\")"]) }
  else {
    concat_all(["kai_evidence_require(kai_evidence_lookup_node(\"", eff,
                "\"), \"", eff, "\")"])
  }

fn emit_range_expr(src: String, from: Expr, to: Expr, opt_step: Option[Expr],
                   cx: EmitCtx) : String / Console {

  let a = emit_expr(src, from, cx)
  let b = emit_expr(src, to, cx)
  match opt_step {
    None -> seq_call("kai_range(", [a, b], ")")
    Some(s) -> seq_call("kai_range_step(", [a, b, emit_expr(src, s, cx)], ")")
  }
}

# ---- list literal emission ----

# Every element is sequenced at one level, then the spine is built from
# the refs: nesting a statement expression per cons would multiply the
# bracket depth of a long literal.
fn emit_list_tail(src: String, elems: [ListElem], cx: EmitCtx) : String / Console {
  let q = seq_operands(emit_list_elem_vals(src, elems, cx))
  seq_wrap(q, emit_list_spine(elems, seq_refs(q), emit_cons_ctor(cx)))
}

fn emit_list_elem_vals(src: String, elems: [ListElem], cx: EmitCtx) : [String] / Console = match elems {
  [] -> []
  [el, ...rest] -> {
    let x = match el { ElPlain(e) -> e ElSpread(e) -> e }
    [emit_expr(src, x, cx), ...emit_list_elem_vals(src, rest, cx)]
  }
}

# Cons cells built lexically inside a `region { }` bump-allocate into the
# arena; outside, ordinary RC `kai_cons` (`cons_c`). A spread consumes its
# operand like a ctor slot: a trailing one becomes the tail as is, a middle
# one is released by `kai_core_list_append`.
fn emit_list_spine(elems: [ListElem], refs: [String], cons_c: String) : String = match elems {
  [] -> "kai_nil()"
  [el, ...rest] -> match refs {
    [r, ...rrest] -> match el {
      ElPlain(_) -> match rest {
        [] -> concat_all([cons_c, r, ", kai_nil())"])
        _  -> concat_all([cons_c, r, ", ", emit_list_spine(rest, rrest, cons_c), ")"])
      }
      ElSpread(_) -> match rest {
        [] -> r
        _  -> concat_all(["kai_core_list_append(", r, ", ", emit_list_spine(rest, rrest, cons_c), ")"])
      }
    }
    [] -> "kai_nil() /* list: element/ref arity */"
  }
}

fn emit_list_expr(src: String, elems: [ListElem], cx: EmitCtx) : String / Console =

  emit_list_tail(src, elems, cx)

# ---- record literal emission ----

fn emit_field_init_val(src: String, fi: FieldInit, cx: EmitCtx) : String / Console {

  match fi { FI(_, val) -> emit_expr(src,val, cx) }
}

fn emit_field_init_name(fi: FieldInit) : String {
  match fi { FI(name, _) -> cat3("\"", name, "\"") }
}

# ---- Vec raw element fusion ----------------------------------------
#
# The classifier verdict lives in vec_raw.kai (one classifier for both
# backends); these emit the C for the three fused shapes. In-region
# code keeps the boxed path (arena field boxes must not reach the
# raw helpers' decref).

# `vec_get(v, i).f` / `vec_get_borrow(v, i).f` on a REC carrier →
# `kai_vec_get_field(_borrow)`: no record is built. An owned vec in the
# borrowing form's slot has no other taker, so the helper releases it.
fn emit_vec_get_field_fused(src: String, base: Expr, fname: String, cx: EmitCtx) : Option[String] / Console =
  if cx.in_region { None } else {
    match vec_field_read(cx.recs, base, fname) {
      None     -> None
      Some(fr) -> {
        let g = fr.get
        let fidx = match fr.col { VecCol(k, _) -> int_to_string(k) }
        let vi = concat_all([emit_expr(src, g.v, cx), ", ", emit_expr(src, g.i, cx), ", ", fidx])
        if g.borrows { Some(concat_all(["kai_vec_get_field_borrow(", vi, if emit_is_owned_borrow(g.v) { ", 1)" } else { ", 0)" }])) }
        else { Some(cat3("kai_vec_get_field(", vi, ")")) }
      }
    }
  }

# `vec_push(v, Rec{..})` / `vec_set(v, i, Rec{..})` on a REC carrier →
# `kai_vec_push_rec_raw` / `kai_vec_set_rec_raw` with the unpacked
# field values (compound literals, the __perceus_reuse_record idiom).
# Field order is the desugar-canonicalised declaration order — the
# same layout bet the constant-index record read makes.
fn emit_vec_write_rec_fused(src: String, f: Expr, args_e: [Expr], cx: EmitCtx) : Option[String] / Console = match f.kind {
  ESym(_, _) -> {
    if is_builtin_ref(f, CbVecPush) and not cx.in_region {
      match args_e {
        [v, lit] -> match lit.kind {
          ERecordLit(_, fis) ->
            if vec_elem_is_rec_carrier(cx.recs, lit.ty) {
              let q = seq_operands([emit_expr(src, v, cx), ...map(fis, (fi) => emit_field_init_val(src, fi, cx))])
              let names = join_with(map(fis, emit_field_init_name), ", ")
              match seq_refs(q) {
                [rv, ...rf] -> Some(seq_wrap(q, concat_all([
                  "kai_vec_push_rec_raw(", rv, ", ", int_to_string(list_length(fis)),
                  ", (KaiValue *[]){", join_with(rf, ", "), "}, (const char *[]){", names, "})"
                ])))
                [] -> None
              }
            } else { None }
          _ -> None
        }
        _ -> None
      }
    } else if is_builtin_ref(f, CbVecSet) and not cx.in_region {
      match args_e {
        [v, i, lit] -> match lit.kind {
          ERecordLit(_, fis) ->
            if vec_elem_is_rec_carrier(cx.recs, lit.ty) {
              let q = seq_operands([emit_expr(src, v, cx), emit_expr(src, i, cx),
                                    ...map(fis, (fi) => emit_field_init_val(src, fi, cx))])
              match seq_refs(q) {
                [rv, ri, ...rf] -> Some(seq_wrap(q, concat_all([
                  "kai_vec_set_rec_raw(", rv, ", ", ri, ", ", int_to_string(list_length(fis)),
                  ", (KaiValue *[]){", join_with(rf, ", "), "})"
                ])))
                _ -> None
              }
            } else { None }
          _ -> None
        }
        _ -> None
      }
    } else { None }
  }
  _ -> None
}

# A stamped record's construction wrapped in `kai_rec_stamp`; an untagged
# one is emitted unchanged.
fn emit_rec_stamp(c: String, tag: Int) : String =
  if tag == 0 { c } else { concat_all(["kai_rec_stamp(", c, ", ", int_to_string(tag), ")"]) }

fn emit_record_lit(src: String, fields: [FieldInit], cx: EmitCtx) : String / Console {

  let n = list_length(fields)
  let vals = seq_operands(map(fields, (fi) => emit_field_init_val(src, fi, cx)))
  let names = join_with(map(fields, emit_field_init_name), ", ")
  seq_wrap(vals, concat_all([
    emit_record_ctor(cx), int_to_string(n),
    ", (KaiValue *[]){", seq_joined(vals), "}, (const char *[]){", names, "})"
  ]))
}

# ---- match: pattern test + bind emission ----

# `root` holds while `scr` is the match's own scrutinee, not a cell
# reached from it: only the scrutinee's slots are hoisted.
fn emit_pat_test(src: String, pat: Pattern, scr: String, root: Bool, cx: EmitCtx) : String / Console {

  match pat.pkind {
    PWild -> "1"
    PBind(_) -> "1"
    # A `PRange` is desugared to a binder + comparison guard before emit,
    # so it never reaches here; treat it as always-matching defensively.
    PRange(_, _) -> "1"
    PLit(e) -> emit_pat_test_lit(src, e, scr, cx)
    PList(pats, opt_rest) -> emit_pat_test_list(src, pats, opt_rest, scr, cx)
    PVariant(r, subs) -> emit_pat_test_variant(src, r, subs, scr, root, cx)
    PVariantRecord(r, fields) -> emit_pat_test_variant_record(src, r, fields, scr, cx)
    PRecord(fields) -> emit_pat_test_record(src, fields, scr, cx)
    PHole(_) -> "1"
    # m7d §14: `name @ sub` matches iff `sub` matches; the binding
    # is performed by emit_pat_binds.
    PAs(_, sub) -> emit_pat_test(src, sub, scr, root, cx)
    # issue #187 phase 3: PNarrow is rewritten to PAs+PVariant in
    # synth_match before codegen runs; this arm only fires if a
    # `match` outside the typer's scope reaches codegen with a raw
    # narrowing pattern. Treat as unconditional match (no test).
    PNarrow(_, _) -> "1"
    PSurface(_) -> panic("emit_pat_test: surface pattern not lowered")
  }
}

# `kai_op_eq` borrows both operands, and a String, Real or fixed-width
# literal is a fresh box the test must release.
fn emit_pat_test_lit(src: String, e: Expr, scr: String, cx: EmitCtx) : String / Console =
  match e.kind {
    EStr(_, _)   -> emit_pat_test_boxed_lit(src, e, scr, cx)
    EReal(_, _)  -> emit_pat_test_boxed_lit(src, e, scr, cx)
    EFixed(_, _) -> emit_pat_test_boxed_lit(src, e, scr, cx)
    _            -> concat_all(["kai_op_eq(", scr, ", ", emit_expr(src, e, cx), ")"])
  }

fn emit_pat_test_boxed_lit(src: String, e: Expr, scr: String, cx: EmitCtx) : String / Console =
  concat_all(["({ KaiValue *_pl = ", emit_expr(src, e, cx), "; int _pe = kai_op_eq(", scr,
              ", _pl); kai_decref(_pl); _pe; })"])

fn emit_pat_test_list(src: String, pats: [Pattern], opt_rest: Option[Binder],
                      scr: String, cx: EmitCtx) : String / Console {

  let n_fixed = list_length(pats)
  let has_rest = match opt_rest { Some(_) -> true None -> false }
  # kai_seq_norm materialises ONE cell of a lazy range in place (and
  # passes every other value through, NULL included), so the tag test
  # that follows always sees a real KAI_NIL/KAI_CONS. Every list test
  # must run behind it: a raw `->tag` read on a KAI_RANGE misreads.
  if n_fixed == 0 and not has_rest {
    concat_all(["(kai_seq_norm(", scr, ") && ", scr, "->tag == KAI_NIL)"])
  } else {
    cat3("(", emit_pat_test_list_loop(src, pats, has_rest, scr, 0, n_fixed, cx), ")")
  }
}

fn emit_pat_test_list_loop(src: String, pats: [Pattern], has_rest: Bool,
                            cur: String, i: Int, n_fixed: Int,
                            cx: EmitCtx) : String / Console {

  if i >= n_fixed {
    if has_rest { "1" }
    else { concat_all(["kai_seq_norm(", cur, ") && ", cur, "->tag == KAI_NIL"]) }
  } else {
    let head = cat2(cur, "->as.cons.head")
    let tail = cat2(cur, "->as.cons.tail")
    let pi = list_nth(pats, i)
    let head_test = emit_pat_test(src, pi, head, false, cx)
    let cons_guard = concat_all(["kai_seq_norm(", cur, ") && ", cur, "->tag == KAI_CONS"])
    concat_all([
      cons_guard, " && ", head_test, " && ",
      emit_pat_test_list_loop(src, pats, has_rest, tail, i + 1, n_fixed, cx)
    ])
  }
}

fn list_nth(xs: [Pattern], i: Int) : Pattern {
  match xs {
    [] -> mk_pat(PWild, 0, 0)
    [h, ...rest] -> if i == 0 { h } else { list_nth(rest, i - 1) }
  }
}

# Issue #688 — emit the variant-name dispatch as either
# `scr->variant_tag == N` (when the constructor is registered
# under the atom-style global convention, docs/variant-tags.md) or
# `strcmp(scr->as.var.variant_name, "Name") == 0` (synthetic fallback).
# Used by emit_pat_test_variant, emit_pat_test_variant_record, and
# emit_bang to keep the three sites in sync.

# Issue #688 — emit the variant-name dispatch as either
# `scr->variant_tag == N` (when the constructor is registered
# under the atom-style global convention, docs/variant-tags.md) or
# `strcmp(scr->as.var.variant_name, "Name") == 0` (synthetic fallback).
# Used by emit_pat_test_variant, emit_pat_test_variant_record, and
# emit_bang to keep the three sites in sync.
# `known` is None only for a name the table never registered, which is
# where the strcmp fallback belongs.
fn emit_tag_test_at(scr: String, name: String, tag: Int, known: Option[Int]) : String =
  match known {
    Some(_) -> concat_all([
      scr, "->tag == KAI_VARIANT && ",
      scr, "->variant_tag == ", int_to_string(tag)
    ])
    None -> concat_all([
      scr, "->tag == KAI_VARIANT && strcmp(kai_variant_name_of(",
      scr, "->variant_tag), \"", name, "\") == 0"
    ])
  }

# The row of the constructor a pattern names.
fn pat_ctor_row(cx: EmitCtx, r: DeclRef) : Option[VariantEntry] = ctor_ix_row(cx.ctor_ix, ref_sym(r))

# The slot kinds of the constructor a pattern destructures with `arity`
# sub-patterns: they decide each slot's read kind, so they come from the
# row of the constructor the pattern names and from no homonym's.
fn pat_ctor_kinds(cx: EmitCtx, r: DeclRef, arity: Int) : Option[[Int]] = match pat_ctor_row(cx, r) {
  Some(EV(_, _, ar, ks, _)) -> if ar == arity { Some(ks) } else { None }
  None                      -> None
}

fn pat_ctor_tag(cx: EmitCtx, r: DeclRef) : Int = match pat_ctor_row(cx, r) {
  Some(row) -> ctor_row_tag(row)
  None      -> 0
}

# The tag test of the constructor a pattern names.
fn emit_ctor_tag_test(scr: String, r: DeclRef, cx: EmitCtx) : String = match pat_ctor_row(cx, r) {
  Some(EV(_, name, _, _, tag)) -> emit_tag_test_at(scr, name, tag, Some(tag))
  None                         -> emit_tag_test_at(scr, decl_ref_text(cx.tab, r), 0, None)
}

fn emit_variant_tag_test(scr: String, home: Option[String], name: String,
                            variants: [VariantEntry]) : String {
  match evar_find_tag_opt_in(variants, home, name) {
    Some(t) -> concat_all([
      scr, "->tag == KAI_VARIANT && ",
      scr, "->variant_tag == ", int_to_string(t)
    ])
    None -> concat_all([
      scr, "->tag == KAI_VARIANT && strcmp(kai_variant_name_of(",
      scr, "->variant_tag), \"", name, "\") == 0"
    ])
  }
}

fn emit_pat_test_variant(src: String, r: DeclRef,
                         subs: [Pattern], scr: String, root: Bool, cx: EmitCtx) : String / Console {

  let base = concat_all(["(", scr, " && ", emit_ctor_tag_test(scr, r, cx)])
  let tys = match pat_ctor_kinds(cx, r, list_length(subs)) {
    Some(ts) -> ts
    None     -> []
  }
  cat3(base, emit_pat_test_variant_subs(src, subs, tys, scr, root, 0, cx), ")")
}

# A boxed view of slot `i` for a pattern test: the alias for a pointer slot,
# a `kai_int` immediate for an Int slot, and for a Real slot a fresh box the
# test must release (a Real literal compares the raw slot instead).
fn slot_read_for_test(scr: String, i: Int, tys: [Int]) : String {
  let k = kind_at(tys, i)
  if k == 1 {
    concat_all(["kai_int(", "kai_var_slots(", scr, ")[", int_to_string(i), "].i64)"])
  } else if k == 2 {
    concat_all(["kai_real(", "kai_var_slots(", scr, ")[", int_to_string(i), "].r)"])
  } else {
    concat_all(["kai_var_slots(", scr, ")[", int_to_string(i), "].ptr"])
  }
}

# Enum-slot pattern test (slot kind == ENUM): the slot stores the
# immediate variant_tag of an all-nullary sum value. A ctor sub-pattern
# (`Red`) tests `slots[i].i64 == <tag>` directly — one integer compare,
# no pointer deref. PWild / PBind bind no constraint. A PLit / nested
# pattern over an enum slot is impossible (the type is nullary-only).
fn emit_enum_slot_test(scr: String, i: Int, sp: Pattern, cx: EmitCtx) : String =
  match sp.pkind {
    PVariant(r, _) ->
      concat_all(["kai_var_slots(", scr, ")[", int_to_string(i), "].i64 == ",
                  int_to_string(pat_ctor_tag(cx, r))])
    PWild -> "1"
    PBind(_) -> "1"
    PAs(_, sub) -> emit_enum_slot_test(scr, i, sub, cx)
    _ -> "1"
  }

# The C expression for the pointer sub-cell at slot `i` off `scr`. When
# `scr` is the match scrutinee (`root`) and slot i has been hoisted to a
# local (cx.hoisted), spell the local `_hs<i>` — sharing the dependent
# load across the separate `if`-arms. Otherwise the inline slot deref.
fn sub_scr_expr(scr: String, root: Bool, i: Int, cx: EmitCtx) : String =
  if root and hoist_slot_member(cx.hoisted, i) {
    concat_all(["_hs", int_to_string(i)])
  } else {
    concat_all(["kai_var_slots(", scr, ")[", int_to_string(i), "].ptr"])
  }

fn emit_pat_test_variant_subs(src: String, subs: [Pattern], tys: [Int], scr: String, root: Bool, i: Int,
                              cx: EmitCtx) : String / Console {

  match subs {
    [] -> ""
    [sp, ...rest] -> {
      # Issue #440 Phase 2 — primitive slots are stored as raw
      # scalars. For sub-pattern testing we emit a typed slot read
      # that the underlying boxed pat-test machinery can consume.
      # PWild / PBind / PAs do not touch the value so the read is
      # never evaluated for them; PLit reads the slot (and the
      # boxed temp is decref'd inline by the comparator chain).
      let k = kind_at(tys, i)
      # Enum slot (k==3): the slot holds the immediate variant_tag, so
      # test it directly as an i64 comparison — no pointer deref, no
      # re-box. This is the load-bearing win (e.g. is_red on a Color
      # field). PWild/PBind over an enum slot contribute no test.
      let t =
        if k == 3 {
          emit_enum_slot_test(scr, i, sp, cx)
        } else if k == 2 and pat_is_real_lit(sp) {
          emit_real_slot_lit_test(scr, i, sp)
        } else {
          let sub_scr =
            if k == 0 {
              sub_scr_expr(scr, root, i, cx)
            } else {
              slot_read_for_test(scr, i, tys)
            }
          emit_pat_test(src, sp, sub_scr, false, cx)
        }
      concat_all([" && ", t, emit_pat_test_variant_subs(src, rest, tys, scr, root, i + 1, cx)])
    }
  }
}

fn pat_is_real_lit(p: Pattern) : Bool = match p.pkind {
  PLit(e) -> match e.kind { EReal(_, _) -> true  _ -> false }
  _       -> false
}

# A Real slot holds the raw double: compare it in place, with no box on
# either side.
fn emit_real_slot_lit_test(scr: String, i: Int, p: Pattern) : String = match p.pkind {
  PLit(e) -> match e.kind {
    EReal(r, _) -> concat_all(["(kai_var_slots(", scr, ")[", int_to_string(i), "].r == ", real_to_string(r), ")"])
    _           -> "0"
  }
  _       -> "0"
}

fn emit_pat_test_record(src: String, fields: [PField], scr: String,
                        cx: EmitCtx) : String / Console {

  let base = concat_all(["(", scr, " && ", scr, "->tag == KAI_RECORD"])
  cat3(base, emit_pat_test_record_fields(src, fields, scr, cx), ")")
}

fn emit_pat_test_record_fields(src: String, fields: [PField], scr: String,
                               cx: EmitCtx) : String / Console {

  match fields {
    [] -> ""
    [pf, ...rest] -> match pf {
      PField(name, sub, _) -> {
        # m5.x §4b: pat_test only reads the field's tag / value — use
        # the borrowing variant so a failing arm doesn't leak one ref
        # per field tested. emit_pat_binds (below, line 8334) still
        # uses kai_op_field; matched arms keep owned bindings.
        let tmp = concat_all(["kai_op_field_borrow(", scr, ", \"", name, "\")"])
        let t = emit_pat_test(src, sub, tmp, false, cx)
        concat_all([" && (", t, ")", emit_pat_test_record_fields(src, rest, scr, cx)])
      }
    }
  }
}

fn emit_pat_test_variant_record(src: String, r: DeclRef,
                                 fields: [PField], scr: String,
                                 cx: EmitCtx) : String / Console {

  # Variant with record destructuring: first check the variant tag,
  # then read record fields via kai_op_field on the scrutinee itself
  # because the emit side stores records directly in variants.
  # Issue #688 — atom-style global tag dispatch.
  let base = concat_all(["(", scr, " && ", emit_ctor_tag_test(scr, r, cx)])
  cat3(base, emit_pat_test_record_fields(src, fields, scr, cx), ")")
}

# `is_alias` = the scrutinee shares storage with its producer (variant args,
# cons head/tail). PBind/PAs emit `kai_incref(scr)` so the binding has its
# own owned reference. When false, scr is already owned (top-level _scr /
# _letv from a transferred RHS, or `kai_op_field` which already increfs its
# return) and the binding takes the ref directly. The producer-side incref
# is the prerequisite for runtime-flip exit drops: a multi-use param
# decref'd at exit must not free a value still pointed at by the original
# scrutinee's variant slot — landed in the m5.x runtime flip
# (atomic A+B+C+D, 2026-04-28); see `git log` if archaeology is needed.

# `is_alias` = the scrutinee shares storage with its producer (variant args,
# cons head/tail). PBind/PAs emit `kai_incref(scr)` so the binding has its
# own owned reference. When false, scr is already owned (top-level _scr /
# _letv from a transferred RHS, or `kai_op_field` which already increfs its
# return) and the binding takes the ref directly. The producer-side incref
# is the prerequisite for runtime-flip exit drops: a multi-use param
# decref'd at exit must not free a value still pointed at by the original
# scrutinee's variant slot — landed in the m5.x runtime flip
# (atomic A+B+C+D, 2026-04-28); see `git log` if archaeology is needed.
fn emit_pat_binds(src: String, pat: Pattern, scr: String, root: Bool, is_alias: Bool,
                  cx: EmitCtx) : String {
  match pat.pkind {
    PWild ->
      # #293 Phase 2.3/2.4: when scr is an owned (non-alias) ref the
      # value would otherwise leak. Drop it. For alias paths the
      # parent's decref reclaims it.
      if is_alias { "" }
      else { concat_all(["kai_decref(", scr, "); "]) }
    PLit(_) -> ""
    PRange(_, _) -> ""
    PBind(b) -> emit_binder_bind(b, scr, is_alias)
    PList(pats, opt_rest) -> emit_pat_binds_list(src, pats, opt_rest, scr, 0, cx)
    # Issue #440 Phase 2 — the variant bind helper reads each slot with
    # the kind the constructor's row gives it.
    PVariant(r, subs) -> {
      let tys = match pat_ctor_kinds(cx, r, list_length(subs)) {
        Some(ts) -> ts
        None     -> []
      }
      emit_pat_binds_variant(src, subs, tys, scr, root, 0, cx)
    }
    PVariantRecord(_, fields) -> emit_pat_binds_record(src, fields, scr, cx)
    PRecord(fields) -> emit_pat_binds_record(src, fields, scr, cx)
    PHole(_) -> ""
    # m7d §14: bind the as-name to the whole scrutinee, then descend
    # into the inner pattern's bindings on the same scrutinee. The
    # bound name follows the outer is_alias; the sub-pattern always
    # treats scr as alias because the as-bound name is now sharing
    # storage with the sub-bindings even when scr was originally owned.
    PAs(b, sub) -> cat2(emit_binder_bind(b, scr, is_alias), emit_pat_binds(src, sub, scr, root, true, cx))
    # issue #187 phase 3: defensive arm; PNarrow is rewritten to
    # PAs+PVariant before codegen. If reached, bind the name like
    # PBind so the body sees the scrutinee under its narrow name.
    PNarrow(b, _) -> emit_binder_bind(b, scr, is_alias)
    PSurface(_) -> panic("emit_pat_binds: surface pattern not lowered")
  }
}

# The C local of a binder, bound to `scr`: with its own reference when
# `scr` shares storage with its producer.
fn emit_binder_bind(b: Binder, scr: String, is_alias: Bool) : String =
  if is_alias { concat_all(["KaiValue *", c_local(binder_text(b)), " = kai_incref(", scr, "); "]) }
  else { concat_all(["KaiValue *", c_local(binder_text(b)), " = ", scr, "; "]) }

fn emit_pat_binds_list(src: String, pats: [Pattern], opt_rest: Option[Binder],
                       cur: String, i: Int, cx: EmitCtx) : String {
  match pats {
    [] -> match opt_rest {
      Some(b) -> emit_binder_bind(b, cur, true)
      None -> ""
    }
    [p, ...rest] -> {
      let head = cat2(cur, "->as.cons.head")
      let tail = cat2(cur, "->as.cons.tail")
      # cons.head / cons.tail are aliases of cur's storage.
      cat2(emit_pat_binds(src, p, head, false, true, cx),
           emit_pat_binds_list(src, rest, opt_rest, tail, i + 1, cx))
    }
  }
}

# i64-inline (Lane B): collect the binders that a pattern binds onto
# kind-1 Int slots — the SAME set the bind routes emit as `kair_<nm>` and
# the body's local reads + slot stores must look up in cx.kind1_raw. Built
# off the pattern + the ctor registry, so the arm body and the bind agree
# by construction (one collector, no per-route rescan). Recurses into
# nested PVariant sub-patterns (rb-tree balance rotation shape).
fn pat_kind1_binders(pat: Pattern, cx: EmitCtx, acc: [LocalId]) : [LocalId] = match pat.pkind {
  PVariant(r, subs) -> {
    let tys = match pat_ctor_kinds(cx, r, list_length(subs)) { Some(t) -> t None -> [] }
    pat_kind1_binders_subs(subs, tys, 0, cx, acc)
  }
  # A list pattern's fixed sub-patterns can themselves be PVariants with
  # kind-1 Int fields (`[Cmt(cl, _, t, _), ...rest]` — the fmt comment
  # drain shape). The cons-head bind emits kair_ for those, so they must
  # join the set too. The rest binder is a list (always boxed) — skip.
  PList(subs, _) -> pat_kind1_binders_list(subs, cx, acc)
  # A record field is projected boxed via `kai_op_field` (never a kind-1
  # slot itself), but its sub-pattern can be a PVariant with a kind-1 Int
  # field — `[Pair { fst: _, snd: JNum(n) }]`, the JSON probe shape. The
  # field bind emits `kair_n` for that nested variant, so `n` must join
  # the set or the body reads the undeclared boxed `kai_n`. Recurse into
  # each field's sub-pattern; a direct PBind field stays boxed (the `_ ->`
  # arm ignores it), exactly matching the field bind route.
  PRecord(fields)            -> pat_kind1_binders_fields(fields, cx, acc)
  PVariantRecord(_, fields) -> pat_kind1_binders_fields(fields, cx, acc)
  # `name @ pat` and `name : T` narrowings: recurse into the inner pat.
  PAs(_, inner)  -> pat_kind1_binders(inner, cx, acc)
  _ -> acc
}

fn pat_kind1_binders_list(subs: [Pattern], cx: EmitCtx, acc: [LocalId]) : [LocalId] = match subs {
  [] -> acc
  [sp, ...rest] -> pat_kind1_binders_list(rest, cx, pat_kind1_binders(sp, cx, acc))
}

fn pat_kind1_binders_fields(fields: [PField], cx: EmitCtx, acc: [LocalId]) : [LocalId] = match fields {
  [] -> acc
  [pf, ...rest] -> match pf {
    PField(_, sub, _) -> pat_kind1_binders_fields(rest, cx, pat_kind1_binders(sub, cx, acc))
  }
}

fn pat_kind1_binders_subs(subs: [Pattern], tys: [Int], i: Int, cx: EmitCtx, acc: [LocalId]) : [LocalId] =
  match subs {
    [] -> acc
    [sp, ...rest] -> {
      let acc1 = if kind_at(tys, i) == 1 { list_append(binder_ids(kind1_slot_binders(sp)), acc) }
                 else { pat_kind1_binders(sp, cx, acc) }
      pat_kind1_binders_subs(rest, tys, i + 1, cx, acc1)
    }
  }

# The binders of a sub-pattern on a kind-1 Int slot, each declared as the
# raw `kair_<nm>`. The single decision both the bind route and the scope
# collector read; a literal or wildcard binds nothing.
fn kind1_slot_binders(sp: Pattern) : [Binder] = match sp.pkind {
  PBind(b)       -> [b]
  PAs(b, inner)  -> [b, ...kind1_slot_binders(inner)]
  _ -> []
}

fn kind1_slot_decls(bs: [Binder], scr: String, i: Int) : String = match bs {
  [] -> ""
  [b, ...rest] -> concat_all(["int64_t kair_", binder_text(b), " = kai_var_slots(", scr, ")[", int_to_string(i),
                              "].i64; (void) kair_", binder_text(b), "; ", kind1_slot_decls(rest, scr, i)])
}

fn emit_pat_binds_variant(src: String, subs: [Pattern], tys: [Int], scr: String, root: Bool, i: Int,
                          cx: EmitCtx) : String {
  match subs {
    [] -> ""
    [sp, ...rest] -> {
      # Issue #440 Phase 2 — read each slot in the shape its kind
      # dictates. Pointer slots stay aliased to the cell's storage
      # (no RC bump on the read; the binding decides whether to
      # incref). Primitive slots (Int / Real) emit a freshly-boxed
      # owning temporary so the bind machinery can treat them
      # uniformly. The owning shape (is_alias=false) lets the bind
      # consume the temp without leaking — kai_incref skipped, no
      # decref needed at arm exit because no extra ref was taken.
      let k = kind_at(tys, i)
      if k == 0 {
        let sub_scr = sub_scr_expr(scr, root, i, cx)
        # variant arg slot is alias of scr's storage.
        cat2(emit_pat_binds(src, sp, sub_scr, false, true, cx),
             emit_pat_binds_variant(src, rest, tys, scr, root, i + 1, cx))
      } else if k == 3 {
        # Enum slot: re-intern the immediate tag into its singleton
        # KaiValue*. The singleton is immortal (rc==INT32_MAX), so the
        # binding is alias-shaped — PBind needs no incref, PWild no
        # decref (decref of an immortal is a no-op either way).
        let sub_scr = concat_all(["kai_enum_slot_box(", "kai_var_slots(", scr, ")[", int_to_string(i), "].i64)"])
        cat2(emit_pat_binds(src, sp, sub_scr, false, true, cx),
             emit_pat_binds_variant(src, rest, tys, scr, root, i + 1, cx))
      } else if pat_binds_nothing(sp) {
        # Scalar slot (Int / Real) whose sub-pattern binds nothing
        # (PWild or `_`-prefixed PBind). An unboxed scalar carries no
        # RC, so there is nothing to box-then-release: emit no read at
        # all. Pre-FAM this was a marginal `kai_decref(kai_int(...))`
        # (immediate under tagged-Int, but still two calls); post-FAM,
        # with malloc no longer the bottleneck, eliding it removes
        # ~18M no-op calls from the rb-tree's is_red hot path.
        emit_pat_binds_variant(src, rest, tys, scr, root, i + 1, cx)
      } else if k == 1 {
        # The raw read takes no ref: a kind-1 slot carries no RC.
        let bs = kind1_slot_binders(sp)
        cat2(kind1_slot_decls(bs, scr, i),
             emit_pat_binds_variant(src, rest, tys, scr, root, i + 1,
                                    emit_ctx_with_kind1_raw(cx, list_append(binder_ids(bs), cx.kind1_raw))))
      } else {
        let sub_scr = concat_all(["kai_real(", "kai_var_slots(", scr, ")[", int_to_string(i), "].r)"])
        # The primitive slot read allocates a fresh boxed temp; the
        # bind owns it (is_alias=false) so PBind takes the ref
        # directly without an incref, PWild releases it, etc.
        cat2(emit_pat_binds(src, sp, sub_scr, false, false, cx),
             emit_pat_binds_variant(src, rest, tys, scr, root, i + 1, cx))
      }
    }
  }
}

# True iff a sub-pattern binds no name and reads no value. Such a
# pattern over an unboxed scalar slot needs no slot read emitted at all (the scalar has
# no RC to release). PLit is NOT included: a literal slot pattern is a
# TEST, handled on the test side, and reaches emit_pat_binds as "" only
# after the test matched — here we only gate the bind read.
fn pat_binds_nothing(p: Pattern) : Bool = match p.pkind {
  PWild -> true
  _     -> false
}

fn emit_pat_binds_record(src: String, fields: [PField], scr: String,
                          cx: EmitCtx) : String {
  match fields {
    [] -> ""
    [pf, ...rest] -> match pf {
      PField(name, sub, _) -> {
        # #293 Phase 1.3 — nested destructuring needs a temp drop on
        # the intermediate field. See the matching comment in
        # stage1/compiler.kai's emit_pat_binds_record for the rationale.
        if pat_is_destructuring(sub) {
          let tname = concat_all(["_pf_", int_to_string(sub.line), "_",
                                    int_to_string(sub.col)])
          let inner = emit_pat_binds(src, sub, tname, false, true, cx)
          cat2(
            concat_all([
              "KaiValue *", tname, " = kai_op_field(", scr, ", \"", name, "\"); ",
              inner, "kai_decref(", tname, "); "
            ]),
            emit_pat_binds_record(src, rest, scr, cx)
          )
        } else {
          let tmp = concat_all(["kai_op_field(", scr, ", \"", name, "\")"])
          # kai_op_field returns an incref'd value; child is owned.
          cat2(emit_pat_binds(src, sub, tmp, false, false, cx),
               emit_pat_binds_record(src, rest, scr, cx))
        }
      }
    }
  }
}

fn pat_is_destructuring(p: Pattern) : Bool {
  match p.pkind {
    PBind(_) -> false
    PWild -> false
    PLit(_) -> false
    PRange(_, _) -> false
    PRecord(_) -> true
    PVariant(_, _) -> true
    PVariantRecord(_, _) -> true
    PList(_, _) -> true
    PNarrow(_, _) -> false
    PAs(_, sub) -> pat_is_destructuring(sub)
    PHole(_) -> false
    PSurface(_) -> panic("pat_is_destructuring: surface pattern not lowered")
  }
}

fn emit_match_arms(src: String, arms: [Arm], owned: Bool, scr_alias: Option[String], scr_ty: Option[Ty], cx: EmitCtx) : String / Console =

  concat_all(map(arms, (a) => emit_match_arm(src, a, owned, scr_alias, scr_ty, cx)))

# A catch-all body over a raw-scalar scrutinee may read the binder in
# either form: perceus-dup'd reads resolve boxed (`kaiv_`), bare
# single-use reads keep their unbox seed and resolve raw (`kair_`).
# The switch fast path declares both; the if-chain must mirror it or a
# bare read hits an undeclared `kair_<name>`. Whichever form the body
# skips is `(void)`-silenced.
fn pbind_raw_alias(pat: Pattern, scr: String, scr_ty: Option[Ty]) : String =
  match pat.pkind {
    PBind(b) ->
      if not scr_ty_raw_scalar(scr_ty) { "" }
      else {
        concat_all([raw_c_type(scr_ty), " kair_", binder_text(b), " = ",
                    unbox_boxed_scalar(scr, scr_ty), "; (void) kair_", binder_text(b), "; "])
      }
    _ -> ""
  }

fn scr_ty_raw_scalar(opt_ty: Option[Ty]) : Bool = match opt_ty {
  Some(t) -> scr_ty_raw_scalar_t(t)
  None -> false
}

fn scr_ty_raw_scalar_t(t: Ty) : Bool = match t {
  TyReal -> true
  TyDimT(inner, _) -> if ty_is_fixed_vec(t) { false } else { scr_ty_raw_scalar_t(inner) }
  TyRefineT(inner, _) -> scr_ty_raw_scalar_t(inner)
  _ -> ty_is_integral_raw(Some(t))
}

# Issue #209 — detect a cons reuse-arm whose body is the synthetic
# `__perceus_reuse_cons(__pcs_scr, h_new, t_new)` produced by
# `pcs_recognise_reuse_*`. When detected, the arm is emitted via the
# dual-path layout in `emit_match_arm_reuse_cons` instead of the
# default incref-the-binds layout: the unique branch borrows head/tail
# (no incref) so the recursive consumer sees the children at their
# actual RC, enabling spine-deep reuse instead of one-cell-only.

# Issue #209 — detect a cons reuse-arm whose body is the synthetic
# `__perceus_reuse_cons(__pcs_scr, h_new, t_new)` produced by
# `pcs_recognise_reuse_*`. When detected, the arm is emitted via the
# dual-path layout in `emit_match_arm_reuse_cons` instead of the
# default incref-the-binds layout: the unique branch borrows head/tail
# (no incref) so the recursive consumer sees the children at their
# actual RC, enabling spine-deep reuse instead of one-cell-only.
fn try_reuse_cons_arm(pat: Pattern, body: Expr) : Option[ReuseConsArm] {
  match pat.pkind {
    PList(pats, opt_rest) -> match opt_rest {
      Some(rest_b) -> match pats {
        [head_pat] -> match body.kind {
          ECall(callee, call_args) -> match callee.kind {
            EMark(MkReuseCons) -> match call_args {
              [_scr_arg, h_new, t_new] -> Some(ReuseConsArm(head_pat, rest_b, h_new, t_new))
              _ -> None
            }
            _ -> None
          }
          _ -> None
        }
        _ -> None
      }
      None -> None
    }
    _ -> None
  }
}

type ReuseConsArm = ReuseConsArm(Pattern, Binder, Expr, Expr)

# The binders a cons reuse arm owns in both branches: each direct slot the
# rebuild takes, and a deconstructed head's sub-binders.
fn cons_arm_owned(head_pat: Pattern, rest: LocalId, taken: [LocalId], cx: EmitCtx) : [LocalId] = {
  let direct = filter(cons_direct_binders(head_pat, rest), (n) => locals_have(taken, n))
  match head_pat.pkind {
    PBind(_) -> direct
    PWild    -> direct
    _        -> list_append(tcp_rc_binders(head_pat, cx), direct)
  }
}

# Register the rebuild temp `t` under the fiber local `f` while later operands run.
fn reuse_hold(held: Bool, f: String, t: String) : String = if held { euw_slot_push(f, t) } else { "" }

fn reuse_release(held: Bool, f: String) : String = if held { euw_pop(f) } else { "" }

# `cx` for the operands after a held temp `t`: an early return pops its
# registration and releases it.
fn reuse_held_cx(cx: EmitCtx, f: String, t: String) : EmitCtx = emit_ctx_with_tcpend(cx, tcl_hold(cx.tcpend, f, t))

# A deconstructed head binds its sub-binders owned in both branches.
fn cons_slot_bind(src: String, head_pat: Pattern, slot: String, read: Bool, own: Bool, cx: EmitCtx) : String = match head_pat.pkind {
  PBind(hb) -> if read { reuse_slot_decl(binder_text(hb), concat_all(["_scr->as.cons.", slot]), own) } else { "" }
  PWild     -> ""
  _         -> emit_pat_binds(src, head_pat, concat_all(["_scr->as.cons.", slot]), false, true, cx)
}

# Emit a single reuse-arm with the dual-path layout. Pre-condition: the
# scrutinee value is in the C local `_scr`, and the test
# `_scr->tag == KAI_CONS` already passed (encoded by `emit_pat_test`).
#
# Unique branch (kai_check_unique(_scr) == 1):
#   - bind head/tail by *borrow* (no incref). The body's consumer of
#     each binding (e.g. `f(h)`, `recur(t)`) sees the child at its
#     real RC — typically 1 for a fresh spine — so the recursive call
#     also enters its own unique branch. This is what amplifies the
#     reuse from "outermost cell only" to L-per-call.
#   - evaluate `h_new` / `t_new` (which consume the borrowed binds).
#     After this point the slots `_scr->cons.{head,tail}` point at
#     freed memory, so the path is committed.
#   - overwrite the slots in place, incref `_scr` so it survives the
#     match-exit `kai_decref(_scr)`, return `_scr`.
#
# Fallback branch (cell shared, not unique):
#   - bind head/tail by `kai_incref` (the standard pat-binds path).
#   - evaluate `h_new` / `t_new` and allocate a fresh cell via
#     `kai_cons`. The original `_scr` and its children remain intact;
#     match exit's `kai_decref(_scr)` reclaims them normally.
#
# The body's `h_new` / `t_new` are emitted under bindings keyed on the
# pattern names (head_pat's PBind, rest_name); each branch issues its
# own bindings before the same body emit, so the body code is
# duplicated textually but evaluated exactly once at runtime.

# Emit a single reuse-arm with the dual-path layout. Pre-condition: the
# scrutinee value is in the C local `_scr`, and the test
# `_scr->tag == KAI_CONS` already passed (encoded by `emit_pat_test`).
#
# Unique branch (kai_check_unique(_scr) == 1):
#   - bind head/tail by *borrow* (no incref). The body's consumer of
#     each binding (e.g. `f(h)`, `recur(t)`) sees the child at its
#     real RC — typically 1 for a fresh spine — so the recursive call
#     also enters its own unique branch. This is what amplifies the
#     reuse from "outermost cell only" to L-per-call.
#   - evaluate `h_new` / `t_new` (which consume the borrowed binds).
#     After this point the slots `_scr->cons.{head,tail}` point at
#     freed memory, so the path is committed.
#   - overwrite the slots in place, incref `_scr` so it survives the
#     match-exit `kai_decref(_scr)`, return `_scr`.
#
# Fallback branch (cell shared, not unique):
#   - bind head/tail by `kai_incref` (the standard pat-binds path).
#   - evaluate `h_new` / `t_new` and allocate a fresh cell via
#     `kai_cons`. The original `_scr` and its children remain intact;
#     match exit's `kai_decref(_scr)` reclaims them normally.
#
# The body's `h_new` / `t_new` are emitted under bindings of the
# pattern's binders (head_pat's PBind, the rest); each branch issues its
# own bindings before the same body emit, so the body code is
# duplicated textually but evaluated exactly once at runtime.
fn emit_match_arm_reuse_cons(src: String, arm_lcs: [LocalId], rca: ReuseConsArm,
                             cx: EmitCtx) : String / Console {

  match rca {
    ReuseConsArm(head_pat, rest_b, h_new, t_new) -> {
      let rest_name = binder_text(rest_b)
      # i64-inline (Lane B): a cons head pattern can be a PVariant with
      # kind-1 Int fields (the AST list-walk shape: `[Node(_, k, _), ...rest]`).
      # The head bind emits kair_ for those; the new-head/tail body must see
      # them in cx.kind1_raw.
      let arm_cx0 = emit_ctx_with_kind1_raw(emit_ctx_with_lcs(cx, arm_lcs),
                                            list_append(cx.kind1_raw, pat_kind1_binders(head_pat, cx, [])))
      # A direct slot the rebuild does not take has no owner once overwritten:
      # the unique branch releases it and the shared branch does not incref
      # it. A slot read only by a lent read stays bound, as a borrow.
      let direct = cons_direct_binders(head_pat, rest_b.id)
      let read = reuse_gc_uses(cx.locals, [h_new, t_new], direct)
      let taken = reuse_taken_uses(cx.locals, [h_new, t_new], direct)
      let head_read = match head_pat.pkind { PBind(hb) -> locals_have(read, hb.id) _ -> false }
      let head_taken = match head_pat.pkind { PBind(hb) -> locals_have(taken, hb.id) _ -> false }
      let rest_taken = locals_have(taken, rest_b.id)
      let head_borrow = cons_slot_bind(src, head_pat, "head", head_read, false, cx)
      let head_owned = cons_slot_bind(src, head_pat, "head", head_read, head_taken, cx)
      let tail_borrow = cons_rest_bind(rest_name, locals_have(read, rest_b.id), false)
      let tail_owned = cons_rest_bind(rest_name, locals_have(read, rest_b.id), rest_taken)
      let old_drops = cons_untaken_drops(head_taken, rest_taken)
      # With the scrutinee registered, an exit out of the rebuild releases
      # the cell: each taken child belongs to its binder alone, and a head
      # computed first is held across the tail.
      let held = cx.unw.scr
      let hold_h = held and not unw_bare_read(h_new)
      let arm_cx = if held { emit_unw_own(cons_arm_owned(head_pat, rest_b.id, taken, cx), arm_cx0) } else { arm_cx0 }
      let clears = if held { cons_taken_clears(head_taken, rest_taken) } else { "" }
      let h_new_c = emit_expr(src, h_new, arm_cx)
      let t_new_c = emit_expr(src, t_new, if hold_h { reuse_held_cx(arm_cx, "_uwh", "_h_new") } else { arm_cx })
      let h_tmp2 = if hold_h { "_h_new" } else { "_h_new2" }
      concat_all([
        "if (kai_check_unique(_scr)) { ",
        head_borrow, tail_borrow, clears,
        "KaiValue *_h_new = ", h_new_c, "; ", reuse_hold(hold_h, "_uwh", "_h_new"),
        "KaiValue *_t_new = ", t_new_c, "; ", reuse_release(hold_h, "_uwh"),
        old_drops,
        "_scr->as.cons.head = _h_new; _scr->as.cons.tail = _t_new; ",
        "kai_rc_count_reuse(); ",
        # Unique (rc==1): move the rewritten cell out and null `_scr` so the
        # match-exit decref no-ops. Saves an incref + a real decrement.
        "_r = _scr; _scr = NULL; ",
        "} else { ",
        head_owned, tail_owned,
        "KaiValue *", h_tmp2, " = ", h_new_c, "; ", reuse_hold(hold_h, "_uwh", h_tmp2),
        "KaiValue *_t_new2 = ", t_new_c, "; ", reuse_release(hold_h, "_uwh"),
        "_r = kai_cons(", h_tmp2, ", _t_new2); ",
        "}"
      ])
    }
  }
}

# Phase 1.B.3 — 1:1 variant reuse arm. Mirrors `try_reuse_cons_arm`
# generalised to N typed slots. Detects an arm whose pattern is
# `PVariant(C, subs)` and whose body is `__perceus_reuse_variant(_scr,
# C(args))` rebuilding the SAME ctor name + arity. That is the shape the
# cons dual-path generalises safely (the matched cell maps directly onto
# the rebuilt cell, slot-for-slot). The recolor case in insert_loop
# (`RBNode(c,l,k0,v,r)`) and balance's default arm match; the rotation
# ---- Coupled arm-top reuse (Koka bind-borrow + drop_reuse) ----
#
# The TRMC descent (insert_loop) was leaking/never-reusing the scrutinee:
# kaikai bound each child with kai_incref (owned) and the TRMC step fresh-
# alloc'd. That shares the whole tree (every node rc>=2 -> never unique ->
# reuse inert). Koka instead, at the TOP of the arm:
#   - binds the children BORROW (no incref),
#   - decides reuse once: if unique, take the shell as a token (children
#     MOVE into the rebuild); if shared, dup the kept children + decref the
#     shell (non-recursive).
# All sub-paths (TRMC step + balance call) then use the children as owned.
#
# This recogniser fires for a match arm whose pattern is a PVariant the
# arm consumes and whose body contains a TRMC step (the hot insert_loop
# shape). The arm-top emits borrow binds + the is_unique decision; the
# TRMC step reuses `_arm_ru` (threaded via the donor flag) instead of
# fresh-allocating. Non-matching arms fall through to the owned path.

# A pattern slot is a pointer child (needs dup in the shared branch) iff its
# slot kind is boxed (0) and it has a live binder.
# pub: shared with the LLVM backend's arm-top reuse (llvm-c-parity lane).
pub fn arm_ptr_binders(subs: [Pattern], tys: [Int], i: Int) : [Binder] =
  match subs {
    [] -> []
    [sp, ...rest] -> {
      let k = kind_at(tys, i)
      let here = match sp.pkind {
        PBind(b) -> if k == 0 { [b] } else { [] }
        _         -> []
      }
      list_append(here, arm_ptr_binders(rest, tys, i + 1))
    }
  }

# Emit the kai_incref calls for the shared branch: dup each kept pointer
# child so it has an owning ref independent of the (about-to-be-decref'd)
# shell. Koka's `else { dup(l); dup(r); ...; decref(t); }`.
fn arm_shared_dups(binders: [Binder]) : String =
  match binders {
    [] -> ""
    [b, ...rest] -> concat_all(["kai_incref(", c_local(binder_text(b)), "); ", arm_shared_dups(rest)])
  }

# True iff `e` is a bare read of a borrowed binder (cx.borrowed). Used to
# turn a `__perceus_dup` over such a binder into a move.
fn expr_is_borrowed_binder(e: Expr, borrowed: [LocalId]) : Bool =
  match e.kind {
    ELocal(l) -> locals_have(borrowed, l)
    _         -> false
  }

# Arm-top reuse plan: the consumed PVariant's constructor, its payload tys,
# the pointer-slot binders (dup in shared branch), and the scrutinee arity.
type ArmTopReuse = ArmTopReuse(SymId, [Pattern], [Int], [Binder], Int, [Int])

# Detect a match arm eligible for the coupled arm-top reuse: a PVariant the
# arm consumes, whose body contains a TRMC step (the hot insert_loop shape).
# The pattern's typed payload is read from its constructor's row so the
# borrow binds and the shared-branch dups know each slot's kind. We require
# at least one pointer binder (otherwise there is nothing to keep alive and
# the owned path is fine).
# An arm is eligible for arm-top reuse ONLY when EVERY tail branch consumes
# the captured `_arm_ru` token. A branch that tail-calls an external fn
# (e.g. `balance_left(insert_loop(...), ...)`) does NOT touch the token, yet
# the arm-top already dropped `_scr` and MOVED the borrow-bound children:
# that branch then double-frees / reads moved children (the OOM/panic at
# scale). So we require every tail leaf to be either a TRMC step or a
# constructor rebuild (cctx_apply of a Ctor) — both consume the donated
# cell. The recolor arm (`RBNode(Red, insert_loop(l), ...)` etc.) qualifies;
# the balance arm does not and falls through to the owned path.
fn arm_all_tails_consume_token(e: Expr, ctors: CtorIx) : Bool = arm_tail_consumes_kind(e.kind, ctors)

fn arm_tail_consumes_kind(k: ExprKind, ctors: CtorIx) : Bool = match k {
  EIf(_, t, opt_e) ->
    arm_all_tails_consume_token(t, ctors) and
    (match opt_e { None -> false Some(e2) -> arm_all_tails_consume_token(e2, ctors) })
  EBlock(_, opt_tail) -> match opt_tail { None -> false Some(e) -> arm_all_tails_consume_token(e, ctors) }
  EMatch(_, arms) -> arm_tail_consumes_arms(arms, ctors)
  # A tail ECall is acceptable ONLY if it is a TRMC step or a TRMC
  # apply of a constructor rebuild (the token is consumed building the node).
  # Any other call (balance_left, …) does NOT consume the token → reject.
  ECall(f, xs) -> match f.kind {
    EMark(MkTrmcStep(_)) -> true
    EMark(MkTrmcApply) -> arm_apply_is_ctor(xs, ctors)
    _ -> false
  }
  _ -> false
}

fn arm_tail_consumes_arms(arms: [Arm], ctors: CtorIx) : Bool = match arms {
  []           -> true
  [a, ...rest] -> match a { Arm(_, _, b) -> arm_all_tails_consume_token(b, ctors) and arm_tail_consumes_arms(rest, ctors) }
}

# A TRMC apply whose leaf is a constructor call consumes the token (the
# node is rebuilt with kai_variant_at(_arm_ru, ...)).
fn arm_apply_is_ctor(xs: [Expr], ctors: CtorIx) : Bool = match xs {
  [leaf] -> match leaf.kind {
    ECall(cf, _) -> ctor_ix_names(ctors, cf)
    _ -> false
  }
  _ -> false
}

fn try_arm_top_reuse(pat: Pattern, body: Expr, cx: EmitCtx) : Option[ArmTopReuse] {
  # The Koka borrow-bind + is_unique-gated dispose model coordinates the move
  # of a deconstructed child: bind borrow (no incref); decide once at the arm
  # top — unique → steal the shell as a reuse-token (children move raw);
  # shared → dup kept children + non-recursive decref. The token is consumed
  # by a downstream kai_variant_at (TRMC step) or freed (kai_reuse_free).
  #
  # Eligibility is the TRMC body (the shell-dispose machinery — acc_decl +
  # the fn-wide `_arm_ru` slot — is wired only there) AND perceus having
  # MOVED ≥1 ptr binder. Generalising the borrow model to *every*
  # deconstructing arm is the right Koka shape (asu confirmed) but needs the
  # acc_decl / `_arm_ru` plumbing lifted out of the TRMC-only path first; until
  # then a non-TRMC arm keeps the legacy incref-bind path, and perceus must
  # NOT mark its binders as moved (pcs_arm_eligible_for_move keeps the two in
  # lock-step — moving a binder whose arm uses the legacy emit double-frees).
  if not trmc_body_has_step(body) { None }
  else {
    match pat.pkind {
      PVariant(r, subs) -> match pat_ctor_kinds(cx, r, list_length(subs)) {
        Some(tys) ->
          if list_length(tys) == list_length(subs) {
            let ptr_binders = arm_ptr_binders(subs, tys, 0)
            match ptr_binders {
              [] -> None
              _  -> Some(ArmTopReuse(ref_sym(r), subs, tys, ptr_binders, list_length(subs),
                                     pat_unbound_ptr_slots(pat, cx.ctor_ix)))
            }
          } else { None }
        None -> None
      }
      _ -> None
    }
  }
}

# Read perceus's signature directly from the AST: a ptr binder that
# perceus MOVED appears in the body as a bare read in a transfer
# position (NOT wrapped in `__perceus_dup`). Those are exactly the binders
# the arm-top must dup in the shared branch (so the move has an owning ref
# when the shell is shared). A binder still wrapped in `__perceus_dup`
# everywhere keeps its own incref and must NOT be dup'd again here. This is
# "perceus signs, emit transcribes" — we never recompute the branch-aware
# analysis (which would diverge on the post-dup AST and OOM); we read the
# decision perceus already baked into the tree.
fn arm_binder_is_moved(l: LocalId, body: Expr) : Bool =
  arm_binder_has_bare_use(l, body) and not arm_binder_only_dup_wrapped(l, body)

# True if `l` is read bare somewhere a value is transferred
# (ctor slot / call arg) — i.e. perceus did not wrap that use in a dup.
fn arm_binder_has_bare_use(l: LocalId, e: Expr) : Bool =
  arm_bare_use_kind(l, e.kind)

fn arm_bare_use_kind(l: LocalId, k: ExprKind) : Bool = match k {
  ELocal(u)          -> local_eq(u, l)
  ECall(f, xs)       -> arm_call_bare_use(l, f, xs)
  EIf(c, t, opt_e)   -> arm_binder_has_bare_use(l, c) or arm_binder_has_bare_use(l, t) or
                         (match opt_e { None -> false Some(e2) -> arm_binder_has_bare_use(l, e2) })
  EMatch(s, arms)    -> arm_binder_has_bare_use(l, s) or arm_bare_use_arms(l, arms)
  EBlock(stmts, tl)  -> arm_bare_use_stmts(l, stmts) or (match tl { None -> false Some(e) -> arm_binder_has_bare_use(l, e) })
  EBinop(_, a, b)    -> arm_binder_has_bare_use(l, a) or arm_binder_has_bare_use(l, b)
  EUnop(_, x)        -> arm_binder_has_bare_use(l, x)
  EField(x, _)       -> arm_binder_has_bare_use(l, x)
  EIndex(a, b)       -> arm_binder_has_bare_use(l, a) or arm_binder_has_bare_use(l, b)
  ERecordLit(_, fis) -> arm_bare_use_fields(l, fis)
  EList(els)         -> arm_bare_use_elems(l, els)
  _                  -> false
}

# In a call, a bare read of `l` directly as an arg is a moved use UNLESS
# the call is a dup of `l` (that arg is a dup, not a move).
fn arm_call_bare_use(l: LocalId, f: Expr, xs: [Expr]) : Bool = match f.kind {
  EMark(MkDup) -> false
  _ -> arm_binder_has_bare_use(l, f) or arm_bare_use_seq(l, xs)
}

fn arm_bare_use_seq(l: LocalId, es: [Expr]) : Bool = match es {
  []           -> false
  [h, ...rest] -> arm_binder_has_bare_use(l, h) or arm_bare_use_seq(l, rest)
}
fn arm_bare_use_arms(l: LocalId, arms: [Arm]) : Bool = match arms {
  []           -> false
  [a, ...rest] -> match a { Arm(_, _, b) -> arm_binder_has_bare_use(l, b) or arm_bare_use_arms(l, rest) }
}
fn arm_bare_use_stmts(l: LocalId, stmts: [Stmt]) : Bool = match stmts {
  []           -> false
  [s, ...rest] -> arm_bare_use_stmt(l, s) or arm_bare_use_stmts(l, rest)
}
fn arm_bare_use_stmt(l: LocalId, s: Stmt) : Bool = match s {
  SLet(_, _, e)        -> arm_binder_has_bare_use(l, e)
  SVar(_, _, e, _, _)  -> arm_binder_has_bare_use(l, e)
  SExprStmt(e)         -> arm_binder_has_bare_use(l, e)
  _                    -> false
}
fn arm_bare_use_fields(l: LocalId, fis: [FieldInit]) : Bool = match fis {
  []           -> false
  [fi, ...rest] -> match fi { FI(_, v) -> arm_binder_has_bare_use(l, v) or arm_bare_use_fields(l, rest) }
}
fn arm_bare_use_elems(l: LocalId, els: [ListElem]) : Bool = match els {
  []           -> false
  [el, ...rest] -> arm_bare_use_elem(l, el) or arm_bare_use_elems(l, rest)
}
fn arm_bare_use_elem(l: LocalId, el: ListElem) : Bool = match el {
  ElPlain(e)  -> arm_binder_has_bare_use(l, e)
  ElSpread(e) -> arm_binder_has_bare_use(l, e)
}

# Conservative stub: we only need the bare-use signal; the AND with this
# is satisfied by the bare-use walk skipping dup-wrapped occurrences.
fn arm_binder_only_dup_wrapped(_l: LocalId, _body: Expr) : Bool = false

# Filter ptr_binders to those perceus moved (have a bare use in the body).
# pub: shared with the LLVM backend's arm-top reuse (llvm-c-parity lane) so
# the move/dup decision is read off perceus's AST signature, not recomputed.
pub fn arm_moved_binders(binders: [Binder], body: Expr) : [Binder] = match binders {
  []           -> []
  [h, ...rest] ->
    if arm_binder_is_moved(h.id, body) { [h, ...arm_moved_binders(rest, body)] }
    else { arm_moved_binders(rest, body) }
}

# Emit the coupled arm-top reuse block (Koka insert_loop shape):
#   1. BORROW binds: each child read straight from _scr's slots, no incref
#      (PBind ptr slot -> `kaiv_<nm> = _scr->slots[i].ptr`; Int/Real ->
#       freshly-boxed value temp like the owned path).
#   2. arm-top decision: `KaiReuse _arm_ru = kai_drop_reuse_token(_scr, n)`.
#      If null (shared) dup the kept pointer children so they outlive the
#      shell's non-recursive decref. If non-null (unique) the children MOVE.
#   3. the body (TRMC step) reuses `_arm_ru` via kai_variant_at instead of
#      fresh-allocating; it dup's children as before, which the move/dup
#      from step 1+2 balances.
# The match exit does NOT decref _scr here (the TRMC goto jumps out, and the
# arm-top already consumed the arm's ownership of the shell).
fn emit_arm_top_reuse(src: String, atr: ArmTopReuse, body: Expr,
                      arm_cx: EmitCtx, cx: EmitCtx) : String / Console {
  match atr {
    ArmTopReuse(atr_ctor, subs, tys, ptr_binders, n, unbound) -> {
      # Transcribe perceus's signature: dup in the shared branch EXACTLY the
      # ptr binders perceus MOVED (bare use in the body, no __perceus_dup).
      # Reading the decision off the AST (not recomputing the branch-aware
      # analysis) is what avoids the pre/post-dup divergence that OOM'd.
      let moved = arm_moved_binders(ptr_binders, body)
      let borrow_binds = emit_arm_borrow_binds(src, subs, tys, 0, cx)
      let shared_dups  = arm_shared_dups(moved)
      # Single-store TRMC reuse: record the donor cell's ctor + positional
      # binders so a TRMC step rebuilding the SAME ctor into `_arm_ru`
      # can skip the store of a slot whose value is already in the donated
      # shell (Koka's `_con->field = ...` single-store). The donor IS `_scr`
      # (kai_drop_reuse_token hands back the shell intact when unique), so a
      # slot bound off `_scr[i]` and re-placed at position i in the rebuild
      # needs no write. Set only for the body emission of THIS arm.
      let tok_cx = emit_ctx_with_tcpend(arm_cx, list_append(arm_cx.tcpend, [tcl_tok_entry()]))
      let donor_cx = emit_ctx_with_reuse_donor(tok_cx, Some(ReuseDonor(atr_ctor, arm_donor_binders(subs, 0))))
      let body_c = emit_expr(src, body, donor_cx)
      # Linear reuse-token disposal (Koka ParcReuse): the token captured
      # at the arm top is consumed by a `kai_variant_at(_arm_ru, ...)`
      # TRMC step (which resets `_arm_ru = kai_reuse_null` then `goto`s out,
      # never reaching this tail) OR — for a tail that does NOT host a
      # same-size rebuild here (the balance arm: `balance_left(insert_loop(
      # l,...), ..., r)` allocates its node inside balance_left's own frame,
      # and the recolor `RBNode(Black, l, k, v, r)` apply that fresh-allocs)
      # — it survives unconsumed and MUST be dropped, else the stolen Black
      # cell leaks. `kai_reuse_free` frees the cell only; the children were
      # already moved into owned binders the body still uses. This replaces
      # the old `arm_all_tails_consume_token` gate that rejected such arms.
      concat_all([
        borrow_binds,
        "KaiReuse _arm_ru = kai_drop_reuse_token(_scr, ", int_to_string(n), "); ",
        "if (_arm_ru == kai_reuse_null) { ", shared_dups, "} ",
        concat_all(map(unbound, arm_unbound_slot_drop)),
        # The token-steal consumed the shell's ownership (Koka: a cell that
        # becomes a reuse-token is no longer a live RC value). Neutralise the
        # match-exit `kai_decref(_scr)` so it does not double-dispose the cell
        # we either rebuilt into (kai_variant_at) or freed (kai_reuse_free).
        # In the SHARED branch kai_drop_reuse_token already did the
        # non-recursive rc-- and returned null, so the shell needs no further
        # decref either — nulling _scr is correct on both paths. The Red arm
        # got away without this because every tail `goto`s out before the
        # exit decref; the Black arm has a returning (balance) tail that
        # reaches it.
        "_scr = NULL; ",
        "_r = ", body_c, "; ",
        "if (_arm_ru != kai_reuse_null) { kai_reuse_free(_arm_ru); _arm_ru = kai_reuse_null; } "
      ])
    }
  }
}

# The positional binder of each donor sub-pattern: a PBind's
# (the C local `kaiv_<nm>` it binds off slot i), or `local_none()` for any
# other sub-pattern (PWild, nested PVariant, literal) — those have no plain
# binder a rebuild arg could read, so their slot is never skipped. Used by
# the single-store TRMC reuse to recognise `arg i == binder i`.
fn arm_donor_binders(subs: [Pattern], i: Int) : [LocalId] = match subs {
  []            -> []
  [sp, ...rest] -> {
    let here = match sp.pkind { PBind(b) -> b.id _ -> local_none() }
    [here, ...arm_donor_binders(rest, i + 1)]
  }
}

# Borrow binds for the arm-top model: a PBind pointer slot is aliased WITHOUT
# incref (the move/dup decision is taken at the arm top, not here); Int/Real
# slots box a fresh owning value (same as the owned path — primitives carry
# no RC so there is no sharing concern). Any other pointer sub-pattern binds
# its nested names as the owned path does, with their own reference.
fn emit_arm_borrow_binds(src: String, subs: [Pattern], tys: [Int], i: Int,
                         cx: EmitCtx) : String {
  match subs {
    [] -> ""
    [sp, ...rest] -> {
      let k = kind_at(tys, i)
      let slot = concat_all(["kai_var_slots(_scr)[", int_to_string(i), "]"])
      let here = match sp.pkind {
        PBind(b) -> {
          let nm = binder_text(b)
          if k == 1 { concat_all(["int64_t kair_", nm, " = ", slot, ".i64; (void) kair_", nm, "; "]) }
          else if k == 2 { concat_all(["KaiValue *", c_local(nm), " = kai_real(", slot, ".r); "]) }
          else if k == 3 { concat_all(["KaiValue *", c_local(nm), " = kai_enum_slot_box(", slot, ".i64); "]) }
          else { concat_all(["KaiValue *", c_local(nm), " = ", slot, ".ptr; "]) }
        }
        _ -> if k == 0 { emit_pat_binds(src, sp, concat_all([slot, ".ptr"]), false, true, cx) } else { "" }
      }
      cat2(here, emit_arm_borrow_binds(src, rest, tys, i + 1, cx))
    }
  }
}

# A stolen shell hands its children to the arm, but only PBind slots move
# into binders; every other pointer child is released here on the unique
# path, or nothing would ever drop it. A shared shell keeps them.
fn arm_unbound_slot_drop(i: Int) : String =
  concat_all(["if (_arm_ru != kai_reuse_null) { kai_decref(kai_var_slots(_arm_ru)[",
              int_to_string(i), "].ptr); } "])

# The sub-patterns, the constructor's row, the rebuild's args and the slot kinds.
type ReuseVariantArm = ReuseVariantArm([Pattern], VariantEntry, [Expr], [Int])

# Detect a 1:1 variant reuse arm. The arm body, post-perceus, is the
# sentinel `__perceus_reuse_variant(_scr, C(args))`. We match the
# pattern ctor against the rebuilt ctor (same constructor + arity) and pull
# the payload types from its row. Mirrors the working extractor in
# emit_call_value (the `__perceus_reuse_variant` branch) exactly — the
# body IS the sentinel ECall here (the recogniser wraps the arm-tail
# directly, and emit_match_arm receives that tail as `body`).
fn try_reuse_variant_arm(pat: Pattern, body: Expr, cx: EmitCtx) : Option[ReuseVariantArm] {
  match pat.pkind {
    PVariant(pr, subs) -> match body.kind {
      ECall(scallee, sargs) -> match scallee.kind {
        EMark(MkReuseVariant) -> match sargs {
          [_scr_arg, ctor] -> match reuse_ctor_id(cx.ctor_ix, ctor) {
            Some(bctor) -> match ctor.kind {
              ECall(_cf, cargs) ->
                if reuse_same_ctor(pr, bctor) and
                   list_length(subs) == list_length(cargs) {
                  match ctor_ix_row(cx.ctor_ix, bctor) {
                    Some(row) -> match row {
                      EV(_, _, _, tys, _) ->
                        if list_length(tys) == list_length(subs) {
                          Some(ReuseVariantArm(subs, row, cargs, tys))
                        } else { None }
                    }
                    None -> None
                  }
                } else { None }
              _ -> None
            }
            None -> None
          }
          _ -> None
        }
        _ -> None
      }
      _ -> None
    }
    _ -> None
  }
}

# True iff every binder bound by the arm pattern is used EXACTLY ONCE
# across the rebuild's ctor args — the linearity that makes a borrow-pure
# (move, no incref) unique branch sound for a non-bijective rebuild. If a
# binder is used twice, moving it without an incref leaves one use
# dangling (UAF); if zero times, it leaks. The rb-tree balance rotations
# are linear (each of lx,kx,vx,rx,ky,vy,ry appears once in the result), so
# the outer + inner cells move with zero RC traffic — Koka's borrow model.
# A non-linear arm falls back to the incref-then-old-drop path (correct,
# just an incref/decref pair per kept child).
fn rv_arm_is_linear(subs: [Pattern], cargs: [Expr]) : Bool =
  rv_all_used_once(binder_ids(pat_binders_list_local(subs, [])), cargs)

fn pat_binders_list_local(ps: [Pattern], acc: [Binder]) : [Binder] = match ps {
  [] -> acc
  [p, ...rest] -> pat_binders_list_local(rest, pat_binders(p, acc))
}

fn rv_all_used_once(binders: [LocalId], cargs: [Expr]) : Bool = match binders {
  [] -> true
  [l, ...rest] ->
    if rv_count_uses_args(l, cargs, 0) == 1 { rv_all_used_once(rest, cargs) }
    else { false }
}

# Count bare reads of `l` across a list of expressions.
fn rv_count_uses_args(l: LocalId, es: [Expr], acc: Int) : Int = match es {
  []          -> acc
  [e, ...rest] -> rv_count_uses_args(l, rest, acc + rv_count_uses(l, e))
}

fn rv_count_uses(l: LocalId, e: Expr) : Int = match e.kind {
  ELocal(u)          -> if local_eq(u, l) { 1 } else { 0 }
  ECall(f, xs)       -> rv_count_uses(l, f) + rv_count_uses_args(l, xs, 0)
  EIf(c, t, oe)      -> rv_count_uses(l, c) + rv_count_uses(l, t) +
                        (match oe { None -> 0 Some(x) -> rv_count_uses(l, x) })
  EMatch(s, arms)    -> rv_count_uses(l, s) + rv_count_uses_arms(l, arms, 0)
  EBlock(stmts, tl)  -> rv_count_uses_stmts(l, stmts, 0) +
                        (match tl { None -> 0 Some(x) -> rv_count_uses(l, x) })
  EBinop(_, a, b)    -> rv_count_uses(l, a) + rv_count_uses(l, b)
  EUnop(_, x)        -> rv_count_uses(l, x)
  EField(x, _)       -> rv_count_uses(l, x)
  EIndex(a, b)       -> rv_count_uses(l, a) + rv_count_uses(l, b)
  ERecordLit(_, fis) -> rv_count_uses_fields(l, fis, 0)
  EList(els)         -> rv_count_uses_elems(l, els, 0)
  _                  -> 0
}
fn rv_count_uses_arms(l: LocalId, arms: [Arm], acc: Int) : Int = match arms {
  []          -> acc
  [a, ...rest] -> match a { Arm(_, _, b) -> rv_count_uses_arms(l, rest, acc + rv_count_uses(l, b)) }
}
fn rv_count_uses_stmts(l: LocalId, ss: [Stmt], acc: Int) : Int = match ss {
  []          -> acc
  [s, ...rest] -> rv_count_uses_stmts(l, rest, acc + rv_count_uses_stmt(l, s))
}
fn rv_count_uses_stmt(l: LocalId, s: Stmt) : Int = match s {
  SLet(_, _, e)       -> rv_count_uses(l, e)
  SVar(_, _, e, _, _) -> rv_count_uses(l, e)
  SExprStmt(e)        -> rv_count_uses(l, e)
  _                   -> 0
}
fn rv_count_uses_fields(l: LocalId, fis: [FieldInit], acc: Int) : Int = match fis {
  []          -> acc
  [fi, ...rest] -> match fi { FI(_, v) -> rv_count_uses_fields(l, rest, acc + rv_count_uses(l, v)) }
}
fn rv_count_uses_elems(l: LocalId, els: [ListElem], acc: Int) : Int = match els {
  []          -> acc
  [el, ...rest] -> rv_count_uses_elems(l, rest, acc + rv_count_uses_elem(l, el))
}
fn rv_count_uses_elem(l: LocalId, el: ListElem) : Int = match el {
  ElPlain(e)  -> rv_count_uses(l, e)
  ElSpread(e) -> rv_count_uses(l, e)
}

# Emit the 1:1 variant reuse arm, mirroring emit_match_arm_reuse_cons.
# Unique branch: borrow-bind each slot (ptr: no incref; prim: raw .i64/.r
# copy), eval the new ctor args (which consume the borrowed binds via the
# perceus-inserted dup/drop), overwrite slots in place WITHOUT decref-ing
# the old pointer slots (transferred). Fallback: owned binds + fresh ctor.
fn emit_match_arm_reuse_variant(src: String, arm_lcs: [LocalId], rva: ReuseVariantArm,
                                cx: EmitCtx) : String / Console {
  match rva {
    ReuseVariantArm(subs, EV(_, cname, _, _, tag), cargs, tys) -> {
      # The reuse binds emit kind-1 Int slots, at any depth, as raw
      # `kair_<nm>`; the rebuild must see those names in cx.kind1_raw.
      let k1 = pat_kind1_binders_subs(subs, tys, 0, cx, [])
      let arm_cx0 = emit_ctx_with_kind1_raw(emit_ctx_with_lcs(cx, arm_lcs),
                                            list_append(cx.kind1_raw, k1))
      let taken = reuse_taken_uses(cx.locals, cargs, binder_ids(pat_binders_list_local(subs, [])))
      # With the scrutinee registered (a flat rebuild only), an exit out of
      # the rebuild releases the cell: each taken child belongs to its binder
      # alone, and each operand computed is held across the later ones.
      let held = cx.unw.scr
      let arm_cx = if held { emit_unw_own(rv_taken_binders(subs, tys, 0, taken), arm_cx0) } else { arm_cx0 }
      let n = list_length(subs)
      let mask = variant_slot_mask(tys)
      let tag_str = int_to_string(tag)
      # Non-bijective rebuild: a new ctor slot is a NESTED ctor that embeds a
      # pointer child of `_scr` (the rb-tree rotation / gap3 shape:
      # `Node(Node(lll,...), lk, Node(lr,...))`). Borrow-binding such children
      # then overwriting `_scr` in place ALIASES them — emit does not dup them,
      # so the reused cell ends up referencing its own former descendants → a
      # CYCLE (gap3 stack-overflows in `size`). For that shape the unique
      # branch must OWN (incref) its children so the rebuild copies references
      # instead of aliasing. A bijective (flat) rebuild keeps the cheap borrow
      # binds. Detected structurally: any carg is a ctor-call with >0 args.
      let nonbij = rv_any_nested_ctor(cargs, cx.ctor_ix)
      # Borrow-pure unique branch (Koka move model): when the rebuild is
      # LINEAR — every bound child used exactly once in the result — the
      # flat children of the outer cell MOVE (no incref) and the outer
      # cell's old slots are NOT decref'd (transferred). This elides the
      # incref/decref pair per kept child that the non-linear path needs.
      # A non-linear non-bijective rebuild keeps the safe owned path
      # (incref the kept children, decref the old slots before overwrite).
      let lin = rv_arm_is_linear(subs, cargs)
      let borrow_pure = nonbij and lin
      # unique-branch binds: borrow (move) when bijective OR borrow-pure;
      # owned (incref) only on the non-linear non-bijective path.
      let borrow_binds = rv_slot_binds(src, subs, tys, 0, (not nonbij) or borrow_pure, cx)
      let owned_binds  = rv_slot_binds(src, subs, tys, 0, false, cx)
      # The new-ctor-arg expressions reference the pattern binders
      # (`kaiv_<nm>`), so they MUST be emitted under `arm_cx` (lcs
      # extended with the binder names). Emitting under the bare `cx`
      # resolved a binder named like a stdlib fn (e.g. `tail`) to the
      # GLOBAL fn closure instead of the local bind — the latent
      # corruption the cell free-list surfaced.
      let new_temps0   = rv_new_temps(src, cargs, tys, 0, held, arm_cx)
      let overwrites   = rv_overwrites(cargs, tys, 0)
      let fresh_q      = emit_variant_slot_init_list(src, cargs, tys, arm_cx)
      let fresh_rhs    = seq_wrap(fresh_q, concat_all([
                           "kai_variant_u(", tag_str, ", \"", cname, "\", ", int_to_string(n),
                           ", ", int_to_string(mask), ", (KaiVarSlot[]){", seq_joined(fresh_q), "})"]))
      # Non-bijective unique branch owns (incref'd) its children, so the OLD
      # pointer slots of `_scr` (which still reference those children) must be
      # decref'd before they are overwritten — else the old reference leaks.
      # The temps are computed first (they read the now-owned children), so the
      # decref is safe to emit before the overwrites. A bijective rebuild
      # transfers (borrow binds) and must NOT decref.
      # Borrow-pure: every flat child MOVED, so the outer cell's old ptr
      # slots are transferred, not owned — NO decref (else double-free).
      # Non-linear non-bijective: children were incref'd, so the old slots
      # must be decref'd before overwrite. Bijective: borrow-transfer, no drop,
      # except a flat slot the rebuild does not take: its old child has no
      # owner once overwritten.
      let old_drops = if nonbij and not borrow_pure { rv_old_slot_drops(subs, tys, 0) }
                      else { rv_untaken_slot_drops(subs, tys, 0, taken) }
      # Second reuse token (Koka ParcReuse 2-of-3 rotation reuse): the first
      # deconstructed inner cell, when unique, is donated to the first
      # same-arity sub-ctor of the rebuilt body via kai_variant_at. Every
      # deconstructed inner cell, at any depth, is settled once: unique, its
      # children move and its shell is freed (or kept as the token); shared,
      # its taken binders are dup'd and it is decref'd.
      let nslot = if nonbij { rv_first_nested_slot(subs, tys, 0) } else { 0 - 1 }
      let has_inner = nslot >= 0
      let settles = rv_slot_settles(cx.locals, subs, tys, nslot, taken, cx.ctor_ix)
      # Donate the captured inner token to the first same-arity sub-ctor of
      # the body. `new_temps` references `kai_variant_u(tag,"C",n,` for the
      # nested rebuild slots; rewrite the first such occurrence to consume
      # `_ru_inner` via kai_variant_at (falls back to a fresh alloc when the
      # token is null, so a non-unique inner is still correct).
      # Consume the token atomically: the donated kai_variant_at reads
      # `_ru_inner` and NULLs it in the same comma-expression, so the
      # post-rebuild `inner_drop` does NOT free a cell that was reused
      # (the double-use that corrupts the tree). `_ru_tmp` is declared
      # alongside `_ru_inner` (rv_cell_settle). When the token was null
      # (inner shared) kai_variant_at fresh-allocs and the NULL is a no-op.
      # The nested rebuild slot is emitted by emit_variant_call_typed as
      # `kai_variant_u_fast(tag, n, (KaiVarSlot[]){...})` (the non-region
      # primitive-slot path) — NOT the slow `kai_variant_u(tag,"C",n,mask,`
      # form. The donate needle must match what emit_expr actually emits;
      # the old needle (kai_variant_u) never fired since the fast lowering
      # landed, so the captured `_ru_inner` was always dropped via
      # inner_drop instead of donated — every balance rotation fresh-alloc'd
      # both Black children (the 590K-vs-100K alloc gap). kai_variant_at
      # needs (at, tag, name, n, mask, slots); kai_variant_u_fast carries
      # only (tag, n, slots), so the repl re-injects name+mask. Falls back
      # to a fresh alloc when the token is null (inner shared).
      let donate_needle = concat_all(["kai_variant_u_fast(", tag_str, ", ",
                                       int_to_string(n), ", "])
      let donate_repl = concat_all(["kai_variant_at((_ru_tmp = _ru_inner, ",
                                    "_ru_inner = kai_reuse_null, _ru_tmp), ", tag_str,
                                    ", \"", cname, "\", ", int_to_string(n), ", ",
                                    int_to_string(mask), ", "])
      let new_temps1 = if has_inner { replace_first(new_temps0, donate_needle, donate_repl) }
                       else { new_temps0 }
      # Interprocedural donation: when this fn took a `_donor` reuse token,
      # the unique-branch third rebuild cell (a fresh `kai_variant_u_fast`
      # left after the inner-token donation) consumes `_donor` instead of
      # allocating — the parent shell the caller donated across the call
      # boundary (emit_reuse_donate.kai). site 0 = unique branch.
      let new_temps = if cx.rd_active { rd_donate(new_temps1, tag, cname, n, mask, 0) }
                      else { new_temps1 }
      # Shared branch (`_scr` not unique) still holds the parent `_donor`
      # (its uniqueness is independent of the child), so its nested fresh
      # alloc consumes it too — else a balance call on a shared child leaves
      # the donor unconsumed (measured 1.79 freed/insert without this).
      # site 1 = shared branch; distinct temp so no lvalue aliases.
      let fresh_rhs_d = if cx.rd_active { rd_donate(fresh_rhs, tag, cname, n, mask, 1) }
                        else { fresh_rhs }
      # If the inner token was captured but no sub-ctor consumed it (the
      # rebuild had no same-arity nested ctor), free the cell so it does
      # not leak (Koka drops an unconsumed Available token). After a
      # successful donation `_ru_inner` is already null, so this is a no-op.
      let inner_drop = if has_inner {
        "if (_ru_inner != kai_reuse_null) { kai_reuse_free(_ru_inner); } "
      } else { "" }
      # The `_donor_tmpK` scratch is declared at each branch block top (site
      # 0 unique, site 1 shared); it may not live inside the shared branch's
      # `(KaiVarSlot[]){...}` initializer where the rewrite lands.
      let uniq_tmp = if cx.rd_active and new_temps != new_temps1 { rd_tmp_decl(0) } else { "" }
      let shared_temps = if held and cx.rd_active { rd_donate(new_temps1, tag, cname, n, mask, 1) }
                         else { new_temps1 }
      let shared_tmp = if cx.rd_active and (fresh_rhs_d != fresh_rhs or shared_temps != new_temps1) { rd_tmp_decl(1) } else { "" }
      concat_all([
        "if (kai_check_unique(_scr)) { ", uniq_tmp,
        borrow_binds, if held { rv_taken_slot_clears(subs, tys, 0, taken) } else { "" },
        settles, new_temps, rv_temp_pops(cargs, tys, 0, held), old_drops, overwrites,
        "_scr->variant_tag = ", tag_str, "; ",
        "_scr->var_n_args = ", int_to_string(list_length(tys)), "; ",
        # No per-rebuild slotmask register: the rewritten tag's mask is
        # stamped once at startup (kai_register_payload_ctors, now keyed on
        # the correct tag) and the table is keyed on tag not cell, so this
        # was redundant. Safe ONLY now that the startup table is correct —
        # before 2dc66fb it stamped the wrong tag and THIS register was the
        # only thing keeping the mask right. The reuse arm fires millions of
        # times.
        inner_drop,
        # Reuse-in-place is unique (rc==1): the rewritten cell IS the result,
        # so move it (no incref) and null `_scr` to neutralise the match-exit
        # `kai_decref(_scr)` — the same trick emit_arm_top_reuse uses after a
        # token steal. Saves an incref + a real 2->1 decrement per reuse.
        "kai_rc_count_reuse(); _r = _scr; _scr = NULL; ",
        "} else { ", shared_tmp,
        owned_binds,
        # Shared branch: `_scr` stays live and its slot keeps the reference
        # to the inner cell, so the inner must NOT be dropped here — the
        # donor's own drop cascade revisits that slot later (dropping it
        # here over-releases: use-after-free once the donor dies). The
        # grand-child binds are borrows off the still-live inner; dup each
        # kept boxed grand-child before the fresh rebuild embeds it.
        rv_slot_leaf_dups(cx.locals, subs, tys, taken, cx.ctor_ix),
        if held { rv_fresh_from_temps(shared_temps, rv_temp_pops(cargs, tys, 0, held), tag_str, cname, tys) }
        else { cat3("_r = ", fresh_rhs_d, "; ") },
        "}"
      ])
    }
  }
}

# Bind each slot for a reuse arm. borrow=true → unique branch. A nested
# cell's binders are always borrowed; rv_cell_settle decides their ownership.
fn rv_slot_binds(src: String, subs: [Pattern], tys: [Int], i: Int, borrow: Bool, cx: EmitCtx) : String {
  match subs {
    [] -> ""
    [sp, ...rest] -> {
      let k = kind_at(tys, i)
      let slot = concat_all(["kai_var_slots(_scr)[", int_to_string(i), "]"])
      let here = match sp.pkind {
        PWild -> ""
        PBind(b) ->
          if k == 0 and not borrow { concat_all(["KaiValue *", c_local(binder_text(b)), " = kai_incref(", slot, ".ptr); "]) }
          else { rv_bind(binder_text(b), k, slot) }
        _ -> if reuse_is_cell(sp, k) { rv_cell_binds(sp, sub_scr_expr("_scr", true, i, cx), cx.ctor_ix) } else { "" }
      }
      cat2(here, rv_slot_binds(src, rest, tys, i + 1, borrow, cx))
    }
  }
}

# Eval each new ctor arg into `_rv<i>` BEFORE any overwrite. Pointer
# slots: boxed KaiValue*. Primitive slots: extract the raw scalar via
# kai_take_int/kai_take_real (the arg is a boxed kai_int from the bind).
fn rv_new_temps(src: String, cargs: [Expr], tys: [Int], i: Int, held: Bool, cx: EmitCtx) : String / Console {
  match cargs {
    [] -> ""
    [e, ...rest] -> {
      let k = kind_at(tys, i)
      let here =
        if k == 1 {
          # i64-inline (Lane B): reuse-rebuild new-temp for a kind-1 slot.
          # When the source is a kind-1 raw binder (set membership), read
          # `kair_<nm>` directly — no kai_take_int(kai_int(kair)) round-trip.
          # This is the rb-tree balance/insert hot path: ky/vy/kx/vx/k/v
          # field re-stores. Gated on membership, not mode (the ctor-arg
          # context leaves the read MBoxed). Other sources keep kai_take_int.
          concat_all(["int64_t _rv", int_to_string(i), " = ", store_raw_int(src, e, cx), "; "])
        }
        else if k == 2 { concat_all(["double _rv", int_to_string(i), " = kai_take_real(", emit_expr(src, e, cx), "); "]) }
        else if k == 3 {
          # Enum slot in a reuse rebuild. When the source is a nullary
          # ctor literal (Red/Black), emit its tag DIRECTLY instead of
          # `kai_take_enum(kai_variant_u(tag,"Red",0,0,NULL))` — the same
          # round-trip short-circuit emit_variant_slot_init already does
          # for the fresh-construction path. Measured: this round-trip was
          # 47M instructions (11.6%) of the rb-tree bench under callgrind —
          # every balance/insert rebuild re-mints the Red/Black singleton
          # just to read back a tag the emitter knows as a constant.
          match nullary_ctor_tag(e, cx) {
            Some(tag) -> concat_all(["int64_t _rv", int_to_string(i), " = ", int_to_string(tag), "; "])
            None      -> concat_all(["int64_t _rv", int_to_string(i), " = kai_take_enum(", emit_expr(src, e, cx), "); "])
          }
        }
        else { concat_all(["KaiValue *_rv", int_to_string(i), " = ", emit_expr(src, e, cx), "; "]) }
      let tmp = cat2("_rv", int_to_string(i))
      if rv_holds(held, e, k, rest) {
        cat3(here, reuse_hold(true, rv_hold_reg(i), tmp), rv_new_temps(src, rest, tys, i + 1, held, reuse_held_cx(cx, rv_hold_reg(i), tmp)))
      } else { cat2(here, rv_new_temps(src, rest, tys, i + 1, held, cx)) }
    }
  }
}

# Overwrite each slot from its `_rv<i>` temp. Pointer slots written
# WITHOUT decref of the old (transferred via the borrow bind).
fn rv_overwrites(cargs: [Expr], tys: [Int], i: Int) : String {
  match cargs {
    [] -> ""
    [_e, ...rest] -> {
      cat2(concat_all(["kai_var_slots(_scr)[", int_to_string(i), "]", rv_slot_field(kind_at(tys, i)), " = _rv", int_to_string(i), "; "]),
           rv_overwrites(rest, tys, i + 1))
    }
  }
}

# True iff any new ctor arg is a NESTED ctor call with at least one arg — the
# non-bijective shape that embeds a pointer child of the reused cell.
fn rv_any_nested_ctor(cargs: [Expr], ctors: CtorIx) : Bool = match cargs {
  []           -> false
  [e, ...rest] -> {
    let here = match e.kind {
      ECall(f, xs) -> ctor_ix_names(ctors, f) and rv_nonempty(xs)
      _ -> false
    }
    here or rv_any_nested_ctor(rest, ctors)
  }
}

fn rv_nonempty(xs: [Expr]) : Bool = match xs { [] -> false _ -> true }

# Replace the FIRST textual occurrence of `needle` in `hay` with `repl`.
# Used to donate the inner reuse token to the first matching sub-ctor of
# the rebuilt body (`kai_variant_u(tag,"C",n,` → `kai_variant_at(tok,
# tag,"C",n,`). Any cell of the same arity is a valid Koka reuse target,
# so the first textual match is sound. Returns `hay` unchanged when the
# needle is absent (token then stays unconsumed and is dropped).
fn replace_first(hay: String, needle: String, repl: String) : String {
  let at = find_substring(hay, needle, 0)
  let hn = string_length(hay)
  if at >= hn { hay }
  else {
    let nn = string_length(needle)
    concat_all([string_slice(hay, 0, at), repl,
                string_slice(hay, at + nn, hn - (at + nn))])
  }
}

# Decref every OLD pointer slot of `_scr` before the non-bijective overwrite
# (the unique branch owns/incref'd its children, so the old refs must be
# released). Primitive slots (tagged Int / Real) carry no RC → skipped.
#
# A slot whose sub-pattern is a NESTED ctor was already deconstructed and
# its inner cell decref'd inside `rv_slot_binds` (the balance rotation
# shape). Decref-ing it again here would double-free it, so such slots
# are skipped — `subs` lets us recognise them positionally.
fn rv_old_slot_drops(subs: [Pattern], tys: [Int], i: Int) : String = match tys {
  []          -> ""
  [k, ...rest] -> {
    let sub_nested = match subs {
      [sp, ..._] -> match sp.pkind { PBind(_) -> false PWild -> false _ -> true }
      []         -> false
    }
    let srest = match subs {
      [_, ...sr] -> sr
      []         -> []
    }
    let here = if k == 0 and not sub_nested {
      concat_all(["kai_decref(kai_var_slots(_scr)[", int_to_string(i), "].ptr); "])
    } else { "" }
    cat2(here, rv_old_slot_drops(srest, rest, i + 1))
  }
}

# The kept-child claim a recognised variant rebuild owes when it fires.
# The generic reuse arm extracts each pointer binder WITH incref; a rebuild
# arg that re-embeds the binder in ITS OWN slot then hits the runtime alias
# guard (old == new skips the old-slot decref, correct for `Some(f(e))`
# where `f` consumed the binder's ref) and the donor's claim on that child
# is never paid — one leaked ref per reuse. Emits the compensating decrefs,
# guarded at the call site on the donor's pre-rebuild uniqueness (`_rq`):
# the shared fallback fresh-allocs and the match-exit cascade pays there.
# Empty when no slot re-embeds diagonally or the reuse can never fire.
fn reuse_kept_pay(pat: Pattern, body: Expr, cx: EmitCtx) : String =
  if cx.in_region { "" }
  else { match pat.pkind {
    PVariant(pr, subs) -> match body.kind {
      ECall(scallee, sargs) -> match scallee.kind {
        EMark(MkReuseVariant) -> match sargs {
          [_scr_arg, ctor] -> match reuse_ctor_id(cx.ctor_ix, ctor) {
            Some(bctor) -> match ctor.kind {
              ECall(_cf, cargs) -> match pat_ctor_row(cx, pr) {
                Some(EV(_, _, _, ptys, _)) ->
                  if reuse_fire_iff_unique(bctor, ptys, cx) {
                    reuse_kept_drops(subs, cargs, ptys, 0, cx)
                  } else { "" }
                None -> ""
              }
              _ -> ""
            }
            None -> ""
          }
          _ -> ""
        }
        _ -> ""
      }
      _ -> ""
    }
    _ -> ""
  } }

# True iff the emitted rebuild's runtime reuse fires EXACTLY when the donor
# is unique, making `kai_check_unique` the complete fire predicate. The
# typed path (`kai_variant_reuse_at`) always qualifies: the arm's tag test
# and the recogniser's arity match pin its other gates. The all-boxed path
# (`kai_reuse_or_alloc_variant`) additionally requires the DONOR's slot
# mask to be 0 — a primitive-slotted donor never fires there, so nothing
# needs paying.
fn reuse_fire_iff_unique(bctor: SymId, ptys: [Int], cx: EmitCtx) : Bool = {
  let has_prim = match ctor_ix_row(cx.ctor_ix, bctor) {
    Some(EV(_, _, _, bts, _)) -> variant_has_primitive_slot(bts)
    None                      -> false
  }
  if has_prim { true } else { variant_slot_mask(ptys) == 0 }
}

# One `kai_decref` per pointer binder re-embedded in its own slot: the
# rebuild arg at index i is a bare read (or a `__perceus_dup`) of the
# pattern binder bound at the same index. Cross-slot moves are excluded —
# the runtime pays those (old != new decrefs the old child).
fn reuse_kept_drops(subs: [Pattern], cargs: [Expr], ptys: [Int], i: Int,
                    cx: EmitCtx) : String = match subs {
  [] -> ""
  [sp, ...srest] -> {
    let crest = match cargs {
      [_, ...cr] -> cr
      []         -> []
    }
    let k = kind_at(ptys, i)
    let here = match sp.pkind {
      PBind(b) ->
        if k == 0 and reuse_carg_reads(cargs, b.id) {
          concat_all(["kai_decref(", c_local(binder_text(b)), "); "])
        } else { "" }
      _ -> ""
    }
    cat2(here, reuse_kept_drops(srest, crest, ptys, i + 1, cx))
  }
}

# The head of `cargs` is a bare read of `l` or a dup wrap of it.
fn reuse_carg_reads(cargs: [Expr], l: LocalId) : Bool = match cargs {
  [c, ..._] -> match c.kind {
    ELocal(u) -> local_eq(u, l)
    ECall(df, dargs) -> match df.kind {
      EMark(MkDup) ->
        match dargs { [inner] -> match inner.kind { ELocal(u) -> local_eq(u, l) _ -> false } _ -> false }
      _ -> false
    }
    _ -> false
  }
  [] -> false
}

# A ctor under a live region never reuses a cell in place — it bump-allocates
# fresh so the arena frees it wholesale. So the reuse-arm dual-path (whose
# fallback branch would fresh-alloc on the RC heap and reintroduce per-node
# RC) is suppressed under a region, dropping every arm to the plain ctor path
# (which routes through the arena ctor when `in_region`).
fn reuse_cons_arm_here(pat: Pattern, body: Expr, cx: EmitCtx) : Option[ReuseConsArm] =
  if cx.in_region { None } else { try_reuse_cons_arm(pat, body) }

# Under a registered scrutinee only a flat rebuild keeps the dual layout: a
# rotation moves grand-children out of an inner cell the registered one
# still reaches, so it takes the owned path.
fn reuse_variant_arm_here(pat: Pattern, body: Expr, cx: EmitCtx) : Option[ReuseVariantArm] =
  if cx.in_region { None } else {
    match try_reuse_variant_arm(pat, body, cx) {
      Some(ReuseVariantArm(subs, row, cargs, tys)) ->
        if cx.unw.scr and not rv_flat_arm(subs, cargs, cx.ctor_ix) { None } else { Some(ReuseVariantArm(subs, row, cargs, tys)) }
      None -> None
    }
  }

fn rv_flat_arm(subs: [Pattern], cargs: [Expr], ctors: CtorIx) : Bool =
  not rv_any_nested_ctor(cargs, ctors) and all(subs, (sp) => match sp.pkind { PBind(_) -> true PWild -> true _ -> false })

# An arm nested in an arm-top body leaves the enclosing token in place: its
# steps rebuild into that cell.
fn arm_top_reuse_here(pat: Pattern, body: Expr, cx: EmitCtx) : Option[ArmTopReuse] =
  if cx.in_region or arm_top_token_held(cx) { None } else { try_arm_top_reuse(pat, body, cx) }

fn arm_top_token_held(cx: EmitCtx) : Bool = match cx.reuse_donor { Some(_) -> true  None -> false }

# The start of an arm's result assignment. An arm that releases its scrutinee
# first leaves the slot empty for the exit decref of the match.
fn arm_result_open(rel: ScrRelease) : String = match rel {
  ScrFreed -> "kai_decref(_scr); _scr = NULL; _r = "
  _        -> "_r = "
}

# A guard may still reject its arm, and a region frees its cells itself:
# neither takes the cell apart.
fn arm_scr_release(owned: Bool, guarded: Bool, pat: Pattern, body: Expr, cx: EmitCtx) : ScrRelease =
  if owned { arm_release(pat, body, not guarded and not cx.in_region) } else { ScrKept }

# The binders of an arm that takes its scrutinee apart alias its slots: the
# take gives each its reference.
fn arm_binds(src: String, pat: Pattern, scr_ty: Option[Ty], rel: ScrRelease, cx: EmitCtx) : String = match rel {
  ScrTaken -> arm_take_binds(src, arm_subs(pat), arm_take_plan(pat, cx.ctor_ix), cx)
  _        -> cat2(emit_pat_binds(src, pat, "_scr", true, true, cx), pbind_raw_alias(pat, "_scr", scr_ty))
}

fn arm_take_binds(src: String, subs: [Pattern], t: ArmTake, cx: EmitCtx) : String = match t {
  ArmTake(bs, ks, mask) ->
    concat_all([emit_arm_borrow_binds(src, subs, ks, 0, cx), arm_take_test(mask),
                arm_shared_dups(bs), "} _scr = NULL; "])
}

fn arm_take_test(mask: Int) : String =
  if mask == 0 { "if (!kai_arm_take(_scr, 0u)) { " }
  else { concat_all(["if (!kai_arm_take(_scr, ", int_to_string(mask), "u)) { "]) }

fn arm_subs(pat: Pattern) : [Pattern] = match pat.pkind {
  PVariant(_, subs) -> subs
  _                 -> []
}

fn emit_match_arm(src: String, a: Arm, owned: Bool, scr_alias: Option[String], scr_ty: Option[Ty], cx: EmitCtx) : String / Console {

  match a {
    Arm(pat, opt_guard, body) -> {
      let pt = emit_pat_test(src, pat, "_scr", true, cx)
      # The arm's guard and body see this pattern's binders as locals.
      let arm_lcs = list_append(cx.lcs, pat_local_ids(pat))
      # i64-inline (Lane B): the arm body sees this pattern's kind-1 Int
      # binders as raw `kair_<nm>` locals. Add them to cx.kind1_raw so the
      # body's local reads + slot stores pick the raw form. Replaced per arm
      # (not inherited by siblings) — `emit_ctx_with_kind1_raw` overwrites.
      let arm_cx = emit_ctx_with_kind1_raw(emit_ctx_with_lcs(cx, arm_lcs),
                                           list_append(cx.kind1_raw, pat_kind1_binders(pat, cx, [])))
      # Reuse-arm dual-path emit. Only viable when there is no guard (a
      # guard might reject the unique branch after we already committed to
      # overwriting `_scr`'s slots); a live region additionally forces every
      # arm off the reuse path (see `reuse_*_here`).
      match opt_guard {
        None -> match reuse_cons_arm_here(pat, body, cx) {
          Some(rca) -> {
            let arm_body = emit_match_arm_reuse_cons(src, arm_lcs, rca, cx)
            concat_all(["    if (", pt, ") { ", arm_body, " break; }\n"])
          }
          None -> match reuse_variant_arm_here(pat, body, cx) {
            Some(rva) -> {
              let arm_body = emit_match_arm_reuse_variant(src, arm_lcs, rva, cx)
              concat_all(["    if (", pt, ") { ", arm_body, " break; }\n"])
            }
          None -> match arm_top_reuse_here(pat, body, cx) {
            Some(atr) ->
              concat_all(["    if (", pt, ") { ",
                          emit_arm_top_reuse(src, atr, body, arm_cx, cx),
                          " break; }\n"])
            None -> {
            # _scr is shared across all match arms — subsequent arms re-read
            # it after this one's pat_test/guard rejects, and a guard inside
            # this arm may consume the binding (e.g. const-pattern desugar's
            # `__cv_NAME == NAME()`). Treat as alias so PBind increfs.
            let rel = arm_scr_release(owned, false, pat, body, cx)
            let binds = arm_binds(src, pat, scr_ty, rel, cx)
            # A tcrec goto in the body leaves every enclosing match
            # statement-expression, skipping the post-do-while
            # `kai_decref(_scr)` releases and this arm's bind-increfs.
            # The ledger carries them down to the goto site, which
            # emits the skipped releases just before the jump.
            # Once released the scrutinee leaves the ledger: no goto owes it.
            let body_c = emit_expr(src, body, tcp_arm_body_cx(emit_unw_owning(pat, arm_cx),
                                                               if scr_kept(rel) { scr_alias } else { None }, pat, body, cx))
            # A reuse-variant rebuild that keeps a child in its own slot
            # (`MErr(e, ys) -> MVal(e + 1, ys)`) leaves the donor's claim
            # on that child unpaid when the reuse fires: the binder was
            # extracted WITH incref, and the runtime alias guard skips the
            # old-slot decref precisely because old == new. Capture the
            # donor's uniqueness BEFORE the rebuild mutates it and pay the
            # skipped claim after; the shared fallback stays balanced (the
            # match-exit cascade pays the donor's claims there).
            let pay = reuse_kept_pay(pat, body, cx)
            if pay == "" {
              concat_all(["    if (", pt, ") { ", binds, arm_result_open(rel), body_c, "; break; }\n"])
            } else {
              concat_all(["    if (", pt, ") { ", binds,
                          "int _rq = kai_check_unique(_scr); _r = ", body_c,
                          "; if (_rq) { ", pay, "} break; }\n"])
            }
          }
          }
          }
        }
        Some(g) -> {
          let binds = cat2(emit_pat_binds(src, pat, "_scr", true, true, cx),
                           pbind_raw_alias(pat, "_scr", scr_ty))
          let rel = arm_scr_release(owned, true, pat, body, cx)
          let bcx = emit_ctx_tcpend_after(tcp_arm_body_cx(emit_unw_owning(pat, arm_cx),
                                                          if scr_kept(rel) { scr_alias } else { None }, pat, body, cx), g)
          let body_c = emit_expr(src, body, bcx)
          let gc = emit_expr(src, g, arm_cx)
          concat_all([
            "    if (", pt, ") { ", binds,
            "if (kai_op_truthy(", gc, ")) { ", arm_result_open(rel), body_c, "; break; } }\n"
          ])
        }
      }
    }
  }
}

fn pat_lit_raw(p: Pattern) : String {
  match p.pkind {
    PLit(lit) -> match lit.kind {
      EInt(n, _) -> cat2(int_to_string(n), "LL")
      EBool(b) -> if b { "1" } else { "0" }
      EChar(c) -> int_to_string(char_to_int(c))
      EFixed(span, _) -> int_to_string(decode_int(span))
      _ -> "0LL /* pat_lit_raw: unexpected lit */"
    }
    _ -> "0LL /* pat_lit_raw: not a literal pattern */"
  }
}

# Lower a `match` whose scrutinee is `MUnboxed` and whose arms
# are all literal-or-wild into a C `switch`. The wildcard /
# bind arm becomes the `default:` clause; if no wildcard is
# present, `default:` panics with "non-exhaustive match".
fn emit_match_switch(src: String, scrut: Expr, arms: [Arm], cx: EmitCtx) : String / Console {

  # A `__perceus_borrow` wrap is transparent here: a raw scalar carries
  # no RC, so the borrow marker only needs stripping (the boxed paths
  # instead use it to skip the exit decref).
  let scr = match match_borrow_inner(scrut) { Some(inner) -> inner  None -> scrut }
  let raw = emit_expr_raw(src, scr, cx)
  let cty = raw_c_type(scrut.ty)
  concat_all([
    "({ ", cty, " _scr = ", raw, "; KaiValue *_r = kai_unit(); switch (_scr) {\n",
    emit_switch_arms(src, arms, cty, scrut.ty, emit_ctx_tcpend_after(cx, scr), false),
    "} _r; })"
  ])
}

fn emit_switch_arms(src: String, arms: [Arm], scr_cty: String, scr_ty: Option[Ty], cx: EmitCtx, saw_default: Bool) : String / Console {

  match arms {
    [] -> if saw_default { "" }
          else { "    default: kai_core_panic(kai_str(\"non-exhaustive match\")); break;\n" }
    [a, ...rest] -> match a {
      Arm(p, _, body) -> {
        # Each arm's body sees the scrutinee binding as a local
        # when the pattern is a `PBind`.
        let arm_lcs = list_append(cx.lcs, pat_local_ids(p))
        let body_c = emit_expr(src, body, emit_ctx_with_lcs(cx, arm_lcs))
        match p.pkind {
          PWild -> {
            let head = concat_all(["    default: _r = ", body_c, "; break;\n"])
            cat2(head, emit_switch_arms(src, rest, scr_cty, scr_ty, cx, true))
          }
          # Issue #91 — `PBind(name)` catch-all binds the raw
          # scalar `_scr` as `kair_<name>` for the body. Body
          # reads of `name` resolve raw via the env extension
          # in `unbox_arm_with_scr`.
          #
          # BUT the unbox pass declines to mark `name` MUnboxed when it
          # appears in a string interpolation (`#{name}`) — interp wants
          # a boxed `KaiValue *`. Such a body reads `kaiv_<name>`, not
          # `kair_<name>` (the beer_song `verse` failure: `"#{m} bottles"`
          # over `match n { .. m -> .. }` → undeclared `kai_m`). Declare
          # BOTH: the raw `kair_<name>` and a boxed `kaiv_<name>` re-boxed
          # from it, so the body resolves with either prefix. The boxed
          # box is owned locally and dropped at block exit; the raw needs
          # no drop. `(void)` casts silence unused-var warnings when the
          # body happens to use only one form.
          PBind(b) -> {
            let name = binder_text(b)
            # Declare the raw binder AND a boxed alias. The body resolves
            # `name` to `kair_<name>` (raw) for unboxed uses and to
            # `kaiv_<name>` (boxed) for uses the unbox pass kept boxed —
            # notably string interpolation (`#{name}`), which declines raw
            # marking (beer_song `verse`: `"#{m}.."` over `match n{..m->..}`).
            # The boxed alias is created with rc=1 and CONSUMED by the
            # boxed consumer (interp's show/concat decref their args), so
            # no local decref is emitted. Perceus dups it for multi-use.
            let boxed_decl = concat_all([
              "KaiValue *", c_local(name), " = ",
              box_wrap(scr_ty, concat_all(["kair_", name])), "; "])
            let head = concat_all([
              "    default: { ", scr_cty, " kair_", name, " = _scr; ",
              boxed_decl,
              "(void) kair_", name, "; (void) ", c_local(name), "; _r = ",
              body_c, "; } break;\n"
            ])
            cat2(head, emit_switch_arms(src, rest, scr_cty, scr_ty, cx, true))
          }
          _ -> {
            # PLit literal arm.
            let head = concat_all(["    case ", pat_lit_raw(p), ": _r = ", body_c, "; break;\n"])
            cat2(head, emit_switch_arms(src, rest, scr_cty, scr_ty, cx, saw_default))
          }
        }
      }
    }
  }
}

fn cty_for_bind(opt_ty: Option[Ty]) : String = raw_c_type(opt_ty)

fn emit_match_expr(src: String, scrut: Expr, arms: [Arm], cx: EmitCtx) : String / Console {

  # Tier 2.5 M5 — match scrutinee fast path. When the scrutinee is
  # `MUnboxed` (raw int / char) and every arm is a literal-or-wild
  # pattern of the same unboxable type with no guard, lower the
  # match to a C `switch` on the raw scalar. Avoids the `_scr`
  # boxed alias + per-arm `kai_op_eq(...)` chain. The Real-unboxing
  # extension restricts this fast path to integral scrutinee types
  # — `double` is not a valid `switch` operand in C, so a raw Real
  # scrutinee routes through the boxed path (re-boxing once at the
  # boundary).
  match scrut.mode {
    MUnboxed -> {
      if ty_is_integral_raw(scrut.ty) and arms_all_literal_or_wild(arms) and arms_pbind_safe_for_fast_path(arms) {
        emit_match_switch(src, scrut, arms, emit_unw_scr_off(cx))
      } else {
        emit_match_default(src, scrut, arms, cx)
      }
    }
    _ -> emit_match_default(src, scrut, arms, cx)
  }
}

# Detect a borrowed scrutinee: perceus wraps `match p { ... }` as
# `match __perceus_borrow(p) { ... }` when `p` is an inferred-borrowed
# param (inspect-only, arms escape nothing). The match then BORROWS the
# scrutinee — it reads it without owning it, so it must NOT decref it on
# exit (the owner up the call stack reclaims it). Returns the inner
# scrutinee expr when the wrap is present.
fn match_borrow_inner(scrut: Expr) : Option[Expr] = match scrut.kind {
  ECall(callee, args_) -> match callee.kind {
    EMark(MkBorrow) -> match args_ { [inner] -> Some(inner)  _ -> None }
    _               -> None
  }
  _ -> None
}

# ====================================================================
# Sub-deref hoisting (cross-arm CSE) — the match decision-tree lever
# ====================================================================
#
# A nested match like balance_left/right's rotations emits each arm as a
# separate `if (...)`, and every arm re-dereferences the same sub-cell
# off `_scr` from scratch: `kai_var_slots(_scr)[1].ptr->variant_tag`,
# `kai_var_slots(kai_var_slots(_scr)[1].ptr)[k].ptr`, ... The dependent
# pointer loads cannot be CSE'd by clang across the separate branches
# (measured: -O3 does not share them; 18 double-indirections in the
# rb-tree insert_loop). Koka emits a decision tree that reads each
# sub-cell once. We get the same effect with a minimal, single-pass
# peephole (no column selection — Tier 1 fast-compile stays intact):
# hoist `_scr`'s nested-deref slots to C locals `_hs<i>` at the top of
# the match, then have the per-arm tests/binds read `_hs<i>`.
#
# SOUNDNESS (load-bearing): the hoisted load is guarded by the shared
# ctor's tag. `_scr` may be a SMALLER sibling ctor (nullary arm,
# catch-all arm, or a non-exhaustive match), and variant blocks are
# sized by arity, so an unguarded `kai_var_slots(_scr)[i]` reads past
# the block's end; a sibling with enough slots may still carry a
# primitive (non-pointer) payload at i. Guarding on the exact ctor tag
# makes the load legal for every scrutinee: arms of that ctor read the
# real slot, any other value yields NULL and its arm test fails first.
# We only hoist slot i when some arm's sub-pattern at i is itself a
# PVariant (a nested deref worth sharing) and slot i is a pointer slot.
# The hoist is a borrow (read, no incref) — RC balance is unchanged.

# The outer ctor name shared by all arms, if they are all PVariant of
# one ctor with no guard. None otherwise (mixed ctors, wildcard arms,
# guards) — in which case we do not hoist.
# The shared ctor as the slot readers need it: its id and the arity the
# arms destructure it with.
type SharedCtor = SC(SymId, Int)

fn arms_shared_ctor(arms: [Arm]) : Option[SharedCtor] =
  arms_shared_ctor_loop(arms, None)

# Fold the arms, tracking the one ctor shared by all PAYLOAD-carrying
# arms. A nullary PVariant (RBLeaf) or a PWild/PBind catch-all does NOT
# constrain the ctor: those arms never read a hoisted slot, and the tag
# guard on the hoisted load keeps the load itself legal when they match.
# Any pattern guard disables hoisting.
fn arms_shared_ctor_loop(arms: [Arm], acc: Option[SharedCtor]) : Option[SharedCtor] = match arms {
  [] -> acc
  [a, ...rest] -> match a { Arm(p, g, _) -> match g {
    Some(_) -> None
    None    -> match p.pkind {
      PVariant(r, subs) ->
        if list_length(subs) == 0 {
          arms_shared_ctor_loop(rest, acc)
        } else {
          match acc {
            None -> arms_shared_ctor_loop(rest, Some(SC(ref_sym(r), list_length(subs))))
            Some(SC(s0, _)) -> if sym_same(ref_sym(r), s0) { arms_shared_ctor_loop(rest, acc) } else { None }
          }
        }
      PWild    -> arms_shared_ctor_loop(rest, acc)
      PBind(_) -> arms_shared_ctor_loop(rest, acc)
      _        -> None
    }
  } }
}

# Slots (positions in the shared-ctor payload) that some arm derefs with
# a nested PVariant sub-pattern AND that are pointer slots. Those are the
# ones worth hoisting. Walks all arms, unions the positions.
fn nested_deref_slots(arms: [Arm], tys: [Int]) : [Int] =
  nested_deref_slots_loop(arms, tys, [])

fn nested_deref_slots_loop(arms: [Arm], tys: [Int], acc: [Int]) : [Int] =
  match arms {
    [] -> acc
    [a, ...rest] -> match a { Arm(p, _, _) -> match p.pkind {
      PVariant(_, subs) -> nested_deref_slots_loop(rest, tys,
                             arm_nested_slots(subs, tys, 0, acc))
      _ -> nested_deref_slots_loop(rest, tys, acc)
    } }
  }

fn arm_nested_slots(subs: [Pattern], tys: [Int], i: Int, acc: [Int]) : [Int] =
  match subs {
    [] -> acc
    [sp, ...rest] -> {
      let k = kind_at(tys, i)
      let acc2 = match sp.pkind {
        # nested PVariant on a pointer slot (k==0): worth hoisting.
        PVariant(_, _) -> if k == 0 and not hoist_slot_member(acc, i) { [i, ...acc] } else { acc }
        _ -> acc
      }
      arm_nested_slots(rest, tys, i + 1, acc2)
    }
  }

fn hoist_slot_member(xs: [Int], n: Int) : Bool = match xs {
  [] -> false
  [h, ...rest] -> if h == n { true } else { hoist_slot_member(rest, n) }
}

# Emit the `_hs<i>` declarations for each hoisted slot, at the top of
# the match `do {}`. The load is tag-guarded (see SOUNDNESS above); the
# shared ctor always has a row because the hoist set is non-empty only
# when `match_hoist_slots` found it in the same index.
fn emit_hoist_decls(slots: [Int], arms: [Arm], cx: EmitCtx) : String = match slots {
  [] -> ""
  _  -> match arms_shared_ctor(arms) {
    None -> ""
    Some(SC(s, _)) -> match ctor_ix_row(cx.ctor_ix, s) {
      None      -> ""
      Some(row) -> emit_hoist_decls_loop(slots, ctor_row_tag(row))
    }
  }
}

fn emit_hoist_decls_loop(slots: [Int], tag: Int) : String = match slots {
  [] -> ""
  [i, ...rest] -> concat_all([
    "KaiValue *_hs", int_to_string(i),
    " = (_scr->tag == KAI_VARIANT && _scr->variant_tag == ", int_to_string(tag),
    ") ? kai_var_slots(_scr)[", int_to_string(i), "].ptr : NULL; ",
    emit_hoist_decls_loop(rest, tag)
  ])
}

# True when the arm list ends in an unconditional catch-all (a PWild or
# PBind pattern with no guard): the match can never fall through, so the
# trailing `non-exhaustive match` panic is dead code. Emitting it anyway
# leaves a call to a noreturn cold fn in the body, which can inhibit the C
# compiler from inlining small predicates (is_red: `match t { RBNode(Red,
# ...) -> true; _ -> false }` stayed a non-inline `static int`, 10.9M
# instructions / 4.6% of the rb-tree bench called 2× per Black node).
# Dropping the dead panic lets clang fold it into insert_loop's dispatch.
fn arms_have_catchall(arms: [Arm]) : Bool = match arms {
  []           -> false
  [a]          -> match a { Arm(p, g, _) -> match g {
                    Some(_) -> false   # guarded: can fall through
                    None    -> match p.pkind { PWild -> true PBind(_) -> true _ -> false }
                  } }
  [_, ...rest] -> arms_have_catchall(rest)
}

fn match_tail_panic(arms: [Arm]) : String =
  if arms_have_catchall(arms) { "" }
  else { "    kai_core_panic(kai_str(\"non-exhaustive match\"));\n" }

# Compute the hoistable slot set for a match, applying the soundness
# gate. Returns [] unless every arm is a PVariant of one shared ctor
# (no guards / wildcards), in which case it returns that ctor's nested-
# deref pointer slots. Empty → no hoisting, cx unchanged downstream.
fn match_hoist_slots(arms: [Arm], cx: EmitCtx) : [Int] =
  match arms_shared_ctor(arms) {
    None -> []
    Some(SC(s, ar)) -> match ctor_ix_row(cx.ctor_ix, s) {
      Some(EV(_, _, _, tys, _)) -> if list_length(tys) == ar { nested_deref_slots(arms, tys) } else { [] }
      None                      -> []
    }
  }

fn locals_have(ls: [LocalId], l: LocalId) : Bool = any(ls, (x) => local_eq(x, l))

fn pat_local_ids(pat: Pattern) : [LocalId] = map(pat_binders(pat, []), (b) => b.id)

fn param_local_ids(params: [Param]) : [LocalId] = map(params, (p) => p.binder.id)

# The innermost binder in scope emitted under `name`. Two binders spelled
# alike are one C variable.
fn emit_scope_spelled(cx: EmitCtx, name: String) : Option[LocalId] = scope_spelled_loop(cx, cx.lcs, name, None)

fn scope_spelled_loop(cx: EmitCtx, ls: [LocalId], name: String, found: Option[LocalId]) : Option[LocalId] = match ls {
  []           -> found
  [l, ...rest] -> scope_spelled_loop(cx, rest, name, if emit_local_text(cx, l) == name { Some(l) } else { found })
}

# `ns` with the C locals the emitter declares under `keys`: no node
# declares them, so their binders are the ones minted from the keys.
fn locals_declaring(ns: LocalNames, keys: [String]) : LocalNames = match keys {
  []           -> ns
  [k, ...rest] -> locals_declaring(ln_with_binder(ns, binder_minted(k)), rest)
}

# The binders of the declaration a lambda or a clause sits in, with the
# ones a clause body reads and no node declares: the handler-state
# aliases and the continuation.
fn emit_body_locals(ns: LocalNames) : LocalNames =
  locals_declaring(ns, list_append(user_state_aliases(), [var_cell_alias(), canonical_continuation()]))

# `cx` with the C locals the emitter declares under `keys` in scope.
fn emit_ctx_declaring(cx: EmitCtx, keys: [String]) : EmitCtx =
  EmitCtx { ...cx, lcs: list_append(cx.lcs, map(keys, local_minted)), locals: locals_declaring(cx.locals, keys) }

# The handler-state aliases a stateful clause declares, given the names the
# C scope around it already spells: declaring one of those again would
# redeclare the C local.
fn clause_live_aliases(stateful: Bool, spelled: (String) -> Bool) : [String] =
  if stateful { clause_state_aliases(spelled) } else { [] }

# The name the function instance `f` is emitted under: its declaration's,
# or its specialisation's.
fn emit_fn_text(tab: SymTab, specs: SpecNames, f: FnId) : String =
  if fnid_inst(f) == spec_none() { written_text(decl_name(tab, fnid_sym(f))) }
  else { written_text(spec_text(specs, f)) }

fn emit_match_default(src: String, scrut: Expr, arms: [Arm], cx: EmitCtx) : String / Console {

  # Borrowed scrutinee: emit the inner value and SKIP the exit decref —
  # the callee does not own the value (Koka borrow). This is the
  # callee side of borrow inference; the caller side strips the matching
  # __perceus_dup so no incref is paid either → net-zero RC on the
  # inspected param.
  let want = cx.unw.scr
  let cx = emit_unw_scr_off(cx)
  match match_borrow_inner(scrut) {
    Some(inner) -> {
      let sc = emit_expr(src, inner, cx)
      let cx1 = emit_ctx_tcpend_after(cx, inner)
      let hs = match_hoist_slots(arms, cx1)
      let arm_cx = emit_ctx_with_hoisted(cx1, hs)
      concat_all([
        "({ KaiValue *_scr = ", sc, "; KaiValue *_r = kai_unit(); do {\n",
        emit_hoist_decls(hs, arms, cx1),
        emit_match_arms(src, arms, false, None, inner.ty, arm_cx),
        match_tail_panic(arms),
        "} while (0); _r; })"   # NO kai_decref(_scr) — borrowed
      ])
    }
    None -> emit_match_default_owned(src, scrut, arms, want, cx)
  }
}

# True when any arm body can reach a tcrec/TRMC goto or an early return —
# the gate for declaring this match's scrutinee-release alias.
fn match_arms_have_sentinel(arms: [Arm], cx: EmitCtx) : Bool = match arms {
  [] -> false
  [a, ...rest] -> match a {
    Arm(_, _, body) ->
      if tcrec_body_has_sentinel(body) or emit_exits_in(body, cx) { true } else { match_arms_have_sentinel(rest, cx) }
  }
}

# Whether `body` holds a `!`; only a frame with an early return is scanned.
fn emit_exits_in(body: Expr, cx: EmitCtx) : Bool = any(cx.unw.sites, (s) => unw_is_exit(s)) and tcl_has_bang(body)

# This pattern's RC-carrying binders: every bound name except raw
# kind-1 scalars and `_`-prefixed names (which bind no C local).
fn tcp_rc_binders(pat: Pattern, cx: EmitCtx) : [LocalId] =
  tcp_rc_binders_loop(pat_local_ids(pat), pat_kind1_binders(pat, cx, []))

fn tcp_rc_binders_loop(all: [LocalId], raw: [LocalId]) : [LocalId] = match all {
  [] -> []
  [n, ...rest] ->
    if locals_have(raw, n) { tcp_rc_binders_loop(rest, raw) }
    else { [n, ...tcp_rc_binders_loop(rest, raw)] }
}

# Ledger entering a non-reuse arm body: enclosing pending entries plus
# this match's scrutinee alias plus this pattern's RC binders — only
# when the body can actually reach a goto. A goto-free body never reads
# the ledger, so it is cleared to skip the branch-refinement scans.
fn tcp_arm_body_cx(arm_cx: EmitCtx, scr_alias: Option[String], pat: Pattern,
                   body: Expr, cx: EmitCtx) : EmitCtx =
  if tcrec_body_has_sentinel(body) or emit_exits_in(body, cx) {
    let with_scr = match scr_alias {
      Some(a) -> list_append(arm_cx.tcpend, [tcl_scr_entry(a)])
      None    -> arm_cx.tcpend
    }
    emit_ctx_with_tcpend(arm_cx, tcl_push_binders(cx.locals, with_scr, tcp_rc_binders(pat, cx)))
  } else { match arm_cx.tcpend {
    [] -> arm_cx
    _  -> emit_ctx_with_tcpend(arm_cx, [])
  } }

fn tcp_scr_alias_decl(scr_alias: Option[String]) : String = match scr_alias {
  Some(a) -> concat_all(["KaiValue *", a, " = _scr; (void) ", a, "; "])
  None    -> ""
}

fn tcp_new_scr_alias(arms: [Arm], cx: EmitCtx) : Option[String] =
  if match_arms_have_sentinel(arms, cx) {
    Some(cat2("_kai_tcs", int_to_string(tcl_scr_count(cx.tcpend))))
  } else { None }

# match-raw unboxing (asu design). Lower a `match` whose result is a
# raw scalar — `_r` has the native C type (`raw_c_type(ty)`), each arm
# assigns the raw body directly (no `kai_int`/`kai_intf` round-trip).
# The scrutinee stays boxed (a variant) and is consumed (decref) on the
# owned path, BORROWED (no decref) when perceus wrapped it. Soundness:
# `_r` is initialised to a raw zero so a non-exhaustive match (which
# also emits a `panic` tail) never reads an uninitialised scalar (C UB).
# Reuse/RC arm paths do NOT apply here — a scalar arm body builds no
# constructor — so the arm shape is the simple `if (test) { binds; _r =
# <raw body>; break; }`.
fn emit_match_raw(src: String, scrut: Expr, arms: [Arm], ty: Option[Ty], cx: EmitCtx) : String / Console {
  # Scrutinee-raw fast path takes precedence: when the SCRUTINEE is a
  # raw integral and the arms are literal/wildcard, the existing
  # `emit_match_switch` lowers to a C `switch (_scr)` (a separate, older
  # optimisation on a DIFFERENT axis — see `emit_match_expr`). Its `_r`
  # is boxed, so unbox it back to the raw result the caller wants — this
  # reproduces the pre-match-raw behaviour exactly (preserving the
  # `unbox_phase2_match` switch fixture). Only a BOXED scrutinee (a
  # variant) routes through the result-raw arms below.
  match scrut.mode {
    MUnboxed ->
      if ty_is_integral_raw(scrut.ty) and arms_all_literal_or_wild(arms) and arms_pbind_safe_for_fast_path(arms) {
        unbox_take_scalar(emit_match_switch(src, scrut, arms, emit_unw_scr_off(cx)), ty)
      } else {
        emit_match_raw_arms(src, scrut, arms, ty, cx)
      }
    _ -> emit_match_raw_arms(src, scrut, arms, ty, cx)
  }
}

# The result-raw match body: each arm assigns the raw scalar into a raw
# `_r`. Used when the scrutinee is boxed (a variant) or a non-fast-path
# raw scrutinee.
fn emit_match_raw_arms(src: String, scrut: Expr, arms: [Arm], ty: Option[Ty], cx: EmitCtx) : String / Console {
  let rty = raw_c_type(ty)
  let want = cx.unw.scr
  let cx = emit_unw_scr_off(cx)
  match match_borrow_inner(scrut) {
    Some(inner) -> {
      let sc = emit_expr(src, inner, cx)
      let cx1 = emit_ctx_tcpend_after(cx, inner)
      concat_all([
        "({ KaiValue *_scr = ", sc, "; ", rty, " _r = ", raw_zero(ty), "; do {\n",
        emit_match_arms_raw(src, arms, None, inner.ty, cx1),
        match_tail_panic(arms),
        "} while (0); _r; })"   # NO kai_decref(_scr) — borrowed
      ])
    }
    None -> {
      let sc = emit_expr(src, scrut, cx)
      let cx1 = emit_ctx_tcpend_after(cx, scrut)
      let us = emit_unw_scr(want, cx1)
      let scr_alias = tcp_new_scr_alias(arms, cx1)
      concat_all([
        "({ KaiValue *_scr = ", sc, "; ", us.push, tcp_scr_alias_decl(scr_alias),
        rty, " _r = ", raw_zero(ty), "; do {\n",
        emit_match_arms_raw(src, arms, scr_alias, scrut.ty, us.cx),
        match_tail_panic(arms),
        "} while (0); ", us.pop, "kai_decref(_scr); _r; })"
      ])
    }
  }
}

# A raw zero of the match's result type — the safe initialiser for `_r`
# (the exhaustivity tail-panic makes it unreachable, but C must see an
# init to avoid UB on a hypothetically-incomplete match).
fn raw_zero(ty: Option[Ty]) : String = match ty {
  Some(t) -> match t {
    TyReal -> "0.0"
    TyDimT(inner, _)    -> raw_zero(Some(inner))
    TyRefineT(inner, _) -> raw_zero(Some(inner))
    _ -> "0"
  }
  None -> "0"
}

# `scr_alias` is Some for an owned scrutinee whose arms can reach a
# tcrec goto — the ledger entry a goto uses to release the `_scr` ref
# whose post-`do/while` decref it skips. The borrowed branch passes
# None: there is no post-loop decref to mirror, and releasing a borrow
# would be a UAF.
fn emit_match_arms_raw(src: String, arms: [Arm], scr_alias: Option[String], scr_ty: Option[Ty], cx: EmitCtx) : String / Console = match arms {
  [] -> ""
  [a, ...rest] -> cat2(emit_match_arm_raw(src, a, scr_alias, scr_ty, cx), emit_match_arms_raw(src, rest, scr_alias, scr_ty, cx))
}

# One raw arm: `if (test) { binds; _r = <raw body>; break; }`, plus the
# guarded variant. Mirrors the no-reuse path of `emit_match_arm` but
# emits the body via `emit_expr_raw` into a raw `_r`. Pattern binders
# (incl. kind-1 raw Int slots) are bound exactly as the boxed path does,
# so an arm reading a payload sees the same `kair_<n>` / `kaiv_<n>` locals.
fn emit_match_arm_raw(src: String, a: Arm, scr_alias: Option[String], scr_ty: Option[Ty], cx: EmitCtx) : String / Console = match a {
  Arm(pat, opt_guard, body) -> {
    let pt = emit_pat_test(src, pat, "_scr", true, cx)
    let arm_lcs = list_append(cx.lcs, pat_local_ids(pat))
    let arm_cx0 = emit_unw_owning(pat, emit_ctx_with_kind1_raw(emit_ctx_with_lcs(cx, arm_lcs),
                                          list_append(cx.kind1_raw, pat_kind1_binders(pat, cx, []))))
    let arm_cx = tcp_arm_body_cx(arm_cx0, scr_alias, pat, body, cx)
    let binds = cat2(emit_pat_binds(src, pat, "_scr", true, true, cx),
                     pbind_raw_alias(pat, "_scr", scr_ty))
    # A divergent arm (`panic`/`exit`) never assigns `_r` — emit the
    # call boxed (it aborts) and `break`. Without this, `emit_expr_raw`
    # on a `panic` (whose result is a polymorphic tyvar, not raw) would
    # fall to the boxed-then-unbox fallback and try to read `_r`.
    if arm_body_diverges(body) {
      let body_b = emit_expr(src, body, arm_cx)
      match opt_guard {
        None    -> concat_all(["    if (", pt, ") { ", binds, body_b, "; break; }\n"])
        Some(g) -> {
          let gc = emit_expr_raw(src, g, arm_cx)
          concat_all(["    if (", pt, ") { ", binds, "if (", gc, ") { ", body_b, "; break; } }\n"])
        }
      }
    } else {
      # A goto in the body releases the skipped `_scr` decrefs and
      # bind-increfs via the ledger `tcp_arm_body_cx` seeded above.
      match opt_guard {
        None    -> {
          let body_c = emit_expr_raw(src, body, arm_cx)
          concat_all(["    if (", pt, ") { ", binds, "_r = ", body_c, "; break; }\n"])
        }
        Some(g) -> {
          let gc = emit_expr_raw(src, g, arm_cx)
          let body_c = emit_expr_raw(src, body, emit_ctx_tcpend_after(arm_cx, g))
          concat_all(["    if (", pt, ") { ", binds, "if (", gc, ") { _r = ", body_c, "; break; } }\n"])
        }
      }
    }
  }
}

fn emit_match_default_owned(src: String, scrut: Expr, arms: [Arm], want: Bool, cx: EmitCtx) : String / Console {

  let sc = emit_expr(src,scrut, cx)
  # m5.x flip Phase 3 closeout (original 9fe6f6d shape, restored after
  # §4b landed): consume the scrutinee linearly. `_scr` takes the value
  # `sc` returns and is decrefed on exit. Multi-read let-bound names
  # arrive pre-wrapped in `__perceus_dup` from the perceus_pass EStr +
  # AST rewrite, so a bare read of the binding is single-use by the
  # time the match sees it; the match decref consumes the ref it owns
  # without touching the producer's slot.
  let hs = match_hoist_slots(arms, cx)
  let cx1 = emit_ctx_tcpend_after(cx, scrut)
  let us = emit_unw_scr(want, emit_ctx_with_hoisted(cx1, hs))
  let scr_alias = tcp_new_scr_alias(arms, cx1)
  concat_all([
    "({ KaiValue *_scr = ", sc, "; ", us.push, tcp_scr_alias_decl(scr_alias),
    "KaiValue *_r = kai_unit(); do {\n",
    emit_hoist_decls(hs, arms, cx1),
    emit_match_arms(src, arms, true, scr_alias, scrut.ty, us.cx),
    match_tail_panic(arms),
    "} while (0); ", us.pop, "kai_decref(_scr); _r; })"
  ])
}

# issue #779 — multi-statement EBlock with a raw tail. The sibling of
# `emit_match_raw`: the unbox pass (`decide_mode_aware` EBlock arm) marks
# `EBlock(stmts != [], Some(tail))` MUnboxed when the tail is raw and the
# interleaved statements are RC-only (SLet / SExprStmt — the post-perceus
# `__pcs_ret` wrap shape). Here we emit the statements through the SAME
# path the boxed EBlock arm uses (`emit_block_stmts` — drops/dups threaded
# byte-for-byte) and emit only the TAIL raw, into the statement-expression
# value slot. No `kai_int(...)` box on the result, no `(...)->as.i` unwrap
# — which for a `TyHandle` (raw `void *`) would corrupt the pointer.
#
# The statements run for their effects only (the block's value is the
# tail); making the tail raw never moves a drop, so the Perceus RC
# discipline is unchanged. A region block (deep-copy-out) is a different
# lowering — the caller already excludes it, but the unbox pass never
# marks one raw.
fn emit_block_raw(src: String, stmts: [Stmt], tail: Expr, cx: EmitCtx) : String / Console {
  let drops = block_unused_lets(stmts, Some(tail))
  let stmt_acc = emit_block_stmts(src, stmts, drops, cx)
  let stmt_out = match stmt_acc { EBSA(_, t, _, _) -> t }
  let tail_c = emit_expr_raw(src, tail,
                             emit_ctx_tcpend_after_stmts(emit_ctx_after_block_stmts(cx, stmt_acc), stmts))
  cat4("({ ", stmt_out, tail_c, "; })")
}

# escape_str_body_for_c / esc_body_loop moved to compiler/util.kai
# (issue #677 phase 1h H1a). Per issue #311, triple-quote string spans
# carry unescaped chars (newline, tab, `"`) the C preprocessor can't
# handle; the helper walks the body once emitting a C-escape per
# problem char.

# Decode the literal here rather than splicing the span into C: the C
# compiler's escape table is not kaikai's, and the length must be
# explicit so an embedded NUL survives `strlen`.
fn emit_decoded_str_lit(span: String, body_start: Int, body_end: Int) : String {
  match esc_decode_body(span, body_start, body_end) {
    EscBad(_, _) -> cat3("kai_str(", span, ")")
    EscOk(bytes, _) ->
      concat_all(["kai_str_from_bytes(\"", c_encode_bytes(bytes), "\", ",
                  int_to_string(string_length(bytes)), ")"])
  }
}

# A string is a literal by the time it is emitted: the lift turned every
# interpolation into calls before name resolution.
fn emit_string_lit(span: String, is_triple: Bool) : String = {
  let q = if is_triple { 3 } else { 1 }
  emit_decoded_str_lit(span, q, string_length(span) - q)
}

# ---- lambda collection + emission ----
#
# We pre-walk the program building a list of LamInfo entries; each entry
# gets a unique id and records the lambda's params, its free variables
# (its closure captures), and its body. At emit time the lambda
# expression is replaced with `kai_closure(&lam_symbol, arity,
# n_caps, captures)`; the body is emitted as a separate function later.

# A handle is identified by `(enc_fn, line, col)`, never by position
# alone: two modules share a position, and so do two specialisations of
# one generic fn. Keying this union on position alone merged unrelated
# handles' captures into one env struct.
fn handle_captures_at(cls: [ClauseInfo], enc: String, hline: Int, hcol: Int) : [Capture] {
  match cls {
    [] -> []
    [c, ...rest] -> {
      let k = clause_parts(c)
      if k.line == hline and k.col == hcol and k.enc_fn == enc {
        merge_capture_set(k.caps, handle_captures_at(rest, enc, hline, hcol))
      } else {
        handle_captures_at(rest, enc, hline, hcol)
      }
    }
  }
}

# A recorded clause by field: the one place this file reads `CI`'s layout.
type ClauseParts = { line: Int, col: Int, eff: SymId, head: ClauseHead, params: [Param], body: Expr,
                     stateful: Bool, enc_fn: String, caps: [Capture] }

fn clause_parts(c: ClauseInfo) : ClauseParts = match c {
  CI(line, col, _, head, params, body, stateful, enc_fn, caps, _, eff) ->
    ClauseParts { line: line, col: col, eff: eff, head: head, params: params, body: body,
                  stateful: stateful, enc_fn: enc_fn, caps: caps }
}

fn capture_same(a: Capture, b: Capture) : Bool = match a {
  CapLocal(x) -> match b { CapLocal(y) -> local_eq(x, y)  CapAlias(_) -> false }
  CapAlias(x) -> match b { CapAlias(y) -> local_eq(x, y)  CapLocal(_) -> false }
}

# The captured locals: a captured handler id is no value binder.
fn capture_locals(caps: [Capture]) : [LocalId] = match caps {
  []                      -> []
  [CapLocal(l), ...rest]  -> [l, ...capture_locals(rest)]
  [CapAlias(_), ...rest]  -> capture_locals(rest)
}

# The name a capture rides the env struct under.
fn capture_text(ns: LocalNames, c: Capture) : String = match c {
  CapLocal(l) -> written_text(ln_text(ns, l))
  CapAlias(a) -> cat2("__alias_id__", written_text(ln_text(ns, a)))
}

# The evidence struct of the effect `s` declares.
fn ev_name_of(tab: SymTab, effs: [Decl], s: SymId) : String =
  ev_name(rt_name(tab, s), eff_mo(effs, s))

# Stable-order union of two capture lists. Order matters because the
# install side (`emit_handle_env_assigns`) and the read side
# (`emit_clause_env_prologue`) must walk the same struct fields in
# the same sequence; we lean on the C struct's field order to align
# both.
fn merge_capture_set(a: [Capture], b: [Capture]) : [Capture] {
  match a {
    [] -> b
    [h, ...rest] -> {
      if any(b, (x) => capture_same(x, h)) { merge_capture_set(rest, b) }
      else { [h, ...merge_capture_set(rest, b)] }
    }
  }
}

# R9: stable C symbol for a handle's env struct. Built from the same
# (enc_fn, line, col) triple as the clause-fn names; both ends mint
# matching identifiers off the matching `ClauseInfo` so the cast in
# the clause prologue resolves to the same type the install site
# allocated. `enc_fn` is the post-monomorph fn / lambda symbol.

# R9: stable C symbol for a handle's env struct. Built from the same
# (enc_fn, line, col) triple as the clause-fn names; both ends mint
# matching identifiers off the matching `ClauseInfo` so the cast in
# the clause prologue resolves to the same type the install site
# allocated.
fn handle_env_struct_name(enc_fn: String, line: Int, col: Int) : String =
  handler_scoped_sym("env", enc_fn, line, col)

fn emit_lam_arg_reads(params: [Param], i: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] -> concat_all([
      "    KaiValue *", c_local(written_text(p.binder.name)), " = args[", int_to_string(i), "];\n",
      emit_lam_arg_reads(rest, i + 1)
    ])
  }
}

fn emit_lam_cap_reads(caps: [Capture], i: Int, ns: LocalNames) : String {
  match caps {
    [] -> ""
    [c, ...rest] -> {
      let read_line = match c {
        # A captured handler id: unpack the kai_int back to a
        # KaiHandlerId so the tagged-op emit
        # (`kai_evidence_lookup_node_by_id(kai_alias_<a>_id)`)
        # finds the local in scope.
        # The capture is a boxed handler-id (kai_int), which under the
        # Koka tagged-Int representation is an IMMEDIATE, not a heap
        # pointer — read it via kai_intf (understands both forms), not
        # `->as.i` which would deref the tagged value and segv.
        CapAlias(a) -> concat_all([
          "    KaiHandlerId ", c_alias_id(written_text(ln_text(ns, a))),
          " = (KaiHandlerId) kai_intf(self->as.clo.captures[",
          int_to_string(i),
          "]);\n"
        ])
        CapLocal(l) -> concat_all([
          "    KaiValue *", c_local(written_text(ln_text(ns, l))), " = self->as.clo.captures[", int_to_string(i), "];\n"
        ])
      }
      concat_all([read_line, emit_lam_cap_reads(rest, i + 1, ns)])
    }
  }
}

# Every param is owned by the invocation (kai_apply hands ownership per
# call, #298) yet a closure body only ever DUPs its reads — `in_lam`
# forces a `__perceus_dup` on every EVar and a nested-closure capture
# rides `kai_closure`'s own incref — so the birth ref of each param is
# never consumed and leaks one box per call. Release it after the body.
# Captures are NOT dropped here: the closure owns them (donated once at
# construction, released in the KAI_CLOSURE destructor); a per-call drop
# would UAF after the first of N invocations.
fn emit_lam_param_decrefs(params: [Param]) : String = match params {
  []           -> ""
  [p, ...rest] -> concat_all(["    kai_decref(", c_local(written_text(p.binder.name)), ");\n", emit_lam_param_decrefs(rest)])
}

fn emit_lam_helper(src: String, l: LamInfo, cx: EmitCtx) : String / Console {

  match l {
    LamInfo(_, _, _, _, params, caps, body, _) -> {
      # The captures are declared by the enclosing declaration, so the
      # body spells its locals from that declaration's binders.
      let cx = EmitCtx { ...cx, locals: emit_body_locals(lam_locals(l)) }
      let arg_reads = emit_lam_arg_reads(params, 0)
      let cap_reads = emit_lam_cap_reads(caps, 0, cx.locals)
      # Lambda body sees its params + captures as locals — same
      # contract as `emit_fn_body` for top-level fn params. Its enc_fn
      # is its own lam_symbol (the same key the collector stamped), so
      # an ELambda nested inside this body resolves to its own LamInfo.
      let pnames = param_local_ids(params)
      let body_lcs = list_append(list_append(cx.lcs, pnames), capture_locals(caps))
      let frame = unw_frame(cx.unw, pnames, pnames, body)
      let lam_cx = emit_ctx_with_unw(emit_ctx_with_lcs(cx, body_lcs), frame)
      let body_c = emit_expr(src, body, emit_ctx_with_enc_fn(lam_cx, lam_symbol(l)))
      let tail = match params {
        [] -> concat_all(["    return ", body_c, ";\n}\n\n"])
        _  -> concat_all([
          "    KaiValue *_lam_ret = ", body_c, ";\n",
          emit_lam_param_decrefs(params),
          "    return _lam_ret;\n}\n\n"
        ])
      }
      concat_all([
        "static KaiValue *", lam_symbol(l),
        "(KaiValue *self, KaiValue **args, int n) {\n",
        euw_with_fiber(frame.sites != [], "    (void) self; (void) n;\n    "),
        arg_reads, cap_reads, tail
      ])
    }
  }
}

fn emit_lam_helpers(src: String, lams: [LamInfo], tab: SymTab, specs: SpecNames, fns: [EFn], fx: FnIndex, variants: [VariantEntry], cls: [ClauseInfo], consts: [Decl], effs: [Decl], recs: [RecInfo], stamps: [RecStamp], core_ix: CoreIx, ctor_ix: CtorIx, evf: EvFrames, root_mod: Option[String], ucx: UnwCx) : String / Console = {
  # Lambda/closure bodies carry the evidence-frame table so a call site
  # inside one fills a frame-carrying callee's evidence (the by-name walk
  # stays the fallback for any effect the frame does not carry).
  concat_all(map(lams, (l) => emit_lam_helper(src, l, EmitCtx { tab: tab, specs: specs, locals: ln_empty(), lcs: [], fns: fns, fx: fx, variants: variants, lams: lams, cls: cls,
                                                                regions: [], in_region: false, borrowed: [], hoisted: [], reuse_donor: None, kind1_raw: [], consts: consts, effs: effs, ffi_reg: [], cur_enc_fn: "", recs: recs, stamps: stamps, core_ix: core_ix, ctor_ix: ctor_ix, evf: evf, rd_active: false, rd_capable: [], tcpend: [], unw: unw_frame_none(ucx), root_mod: root_mod })))
}

fn emit_one_lam_forward(l: LamInfo) : String =
  concat_all(["static KaiValue *", lam_symbol(l), "(KaiValue *, KaiValue **, int);\n"])

fn emit_lam_forward_decls(lams: [LamInfo]) : String =
  concat_all(map(lams, emit_one_lam_forward))

# m7a #6c — clause body emission. Each HClause becomes a top-level
# C function whose name encodes the EHandle's source position plus
# the op name (collisions are impossible since two distinct HCs
# either belong to different handles or carry different op names).
# The signature matches the EvE field type pinned in #6a:
#   `static KaiValue *_kai_clause_<line>_<col>_<op>(EvE *self, args..., KaiCont *k)`.
# `resume` is the surface convention for the trailing param and is
# never part of the C signature — the body uses `resume(v)` as
# direct-style identity (m7a #6c only). m7a #6d will replace this
# with a reified continuation closure.

fn emit_clause_sig(c: ClauseInfo, effs: [Decl], tab: SymTab) : String {
  let k = clause_parts(c)
  let op_name = clause_head_word(k.head)
  let op_args = op_args_only(k.params)
  let arg_str = match op_args {
    [] -> ""
    _  -> cat2(", ", join_with(map(op_args, (pm) => cat2("KaiValue *", c_local(written_text(pm.binder.name)))), ", "))
  }
  concat_all([
    "static KaiValue *", user_clause_sym(k.enc_fn, k.line, k.col, op_name),
    "(", ev_name_of(tab, effs, k.eff), " *self", arg_str, ", KaiCont *k)"
  ])
}

fn emit_clause_forward(c: ClauseInfo, effs: [Decl], tab: SymTab) : String = {
  let k = clause_parts(c)
  if is_lifecycle_clause(k.head) {
    cat2(emit_cleanup_sig(k.enc_fn, k.line, k.col), ";\n")
  } else { cat2(emit_clause_sig(c, effs, tab), ";\n") }
}

fn emit_clause_forwards(cs: [ClauseInfo], effs: [Decl], tab: SymTab) : String =
  concat_all(map(cs, (c) => emit_clause_forward(c, effs, tab)))

# R9: per-handle env typedefs. One typedef per (line, col, enc_fn)
# triple, covering the union of every clause's captures. Emitted at
# top level (ahead of the clause forwards) so the install-site
# allocation in `emit_handle` and the read-side cast in
# `emit_clause_env_prologue` both resolve to the same struct type.
# Uses a "first occurrence wins" walk: the first ClauseInfo we meet
# for a (line, col) pair owns the typedef, later ones for the same
# handle skip emission. Captures are unioned across all clauses of
# the matching handle so the struct layout covers every clause body.

# R9: per-handle env typedefs. One typedef per (line, col, enc_fn)
# triple, covering the union of every clause's captures. Emitted at
# top level (ahead of the clause forwards) so the install-site
# allocation in `emit_handle` and the read-side cast in
# `emit_clause_env_prologue` both resolve to the same struct type.
# Uses a "first occurrence wins" walk: the first ClauseInfo we meet
# for a (line, col) pair owns the typedef, later ones for the same
# handle skip emission. Captures are unioned across all clauses of
# the matching handle so the struct layout covers every clause body.
fn emit_handle_env_typedefs(cs: [ClauseInfo]) : String =
  emit_handle_env_typedefs_loop(cs, [])

fn emit_handle_env_typedefs_loop(cs: [ClauseInfo], seen: [String]) : String {
  match cs {
    [] -> ""
    [c, ...rest] -> {
      let k = clause_parts(c)
      let key = handle_env_struct_name(k.enc_fn, k.line, k.col)
      if list_has(seen, key) {
        emit_handle_env_typedefs_loop(rest, seen)
      } else {
        let caps = handle_captures_at(cs, k.enc_fn, k.line, k.col)
        let decl = match caps {
          [] -> ""
          _ -> emit_handle_env_typedef(key, emit_body_locals(clause_locals(c)), caps)
        }
        concat_all([decl, emit_handle_env_typedefs_loop(rest, [key, ...seen])])
      }
    }
  }
}

fn emit_handle_env_typedef(env_name: String, ns: LocalNames, caps: [Capture]) : String =
  concat_all([
    "typedef struct ", env_name, " ", env_name, ";\n",
    "struct ", env_name, " {\n",
    emit_handle_env_typedef_fields(ns, caps),
    "};\n\n"
  ])

fn emit_handle_env_typedef_fields(ns: LocalNames, caps: [Capture]) : String {
  match caps {
    [] -> ""
    [c, ...rest] -> concat_all([
      "    KaiValue *", c_local(capture_text(ns, c)), ";\n",
      emit_handle_env_typedef_fields(ns, rest)
    ])
  }
}

# m7b #11: stateful-clause prologue. `state` and `log` are aliases of
# `self->state`. Both names are bound (the two are aliases of the same
# slot — the spec uses `state` for `State[T]` and `log` for `Writer[W]`,
# but at this layer they read the same field). The clause body is then
# emitted unchanged: any `state` / `log` reference falls through the
# normal ident lookup and resolves to the local C alias.

# Stateful-clause prologue. `state` and `log` are aliases of
# `self->state`: the spec uses `state` for `State[T]` and `log` for
# `Writer[W]`.
fn clause_state_prologue(stateful: Bool) : String =
  concat_all(map(clause_live_aliases(stateful, (key) => false),
                 (nm) => "    KaiValue *#{c_local(nm)} = self->state;\n"))

# The captures and the body of a stateful clause sit in a C block of
# their own. A capture is a binding around the handler: where one is
# spelled like a state alias, the body reads the capture, which that
# block declares over the alias.
fn clause_env_scope(stateful: Bool, env_prologue: String, ret: String) : String =
  if stateful and env_prologue != "" { concat_all(["    {\n", env_prologue, ret, "    }\n"]) }
  else { concat_all([env_prologue, ret]) }

# Signature of the `finally` thunk. Emitted `static`; modular linkage
# strips the keyword from definition and prototype alike. Returns the
# block's value, which the runtime drops.
fn emit_cleanup_sig(enc_fn: String, line: Int, col: Int) : String =
  concat_all(["static KaiValue *", user_cleanup_sym(enc_fn, line, col), "(void *_self)"])

# `finally` compiles to a `void(void *)` thunk instead of an op clause:
# it takes no args, resumes nothing, and returns nothing. The `void *`
# is the handler's `Ev`, so a stateful handler's cleanup reads the
# resource `initially` put in `state`.
fn emit_cleanup_thunk(src: String, c: ClauseInfo, cx: EmitCtx) : String / Console {

  let k = clause_parts(c)
  let ns = emit_body_locals(clause_locals(c))
  let scx = emit_ctx_declaring(EmitCtx { ...cx, locals: ns }, clause_live_aliases(k.stateful, (key) => false))
  let body_c = emit_expr(src, k.body, emit_ctx_with_lcs(scx, list_append(scx.lcs, capture_locals(k.caps))))
  let evn = ev_name_of(cx.tab, cx.effs, k.eff)
  let self_bind = concat_all([
    "    ", evn, " *self = (", evn, " *) _self; (void) self;\n"
  ])
  concat_all([
    emit_cleanup_sig(k.enc_fn, k.line, k.col), " {\n",
    self_bind,
    clause_state_prologue(k.stateful),
    clause_env_scope(k.stateful, emit_clause_env_prologue(ns, k.enc_fn, k.line, k.col, k.caps),
                     concat_all(["    return ", body_c, ";\n"])),
    "}\n\n"
  ])
}

fn emit_clause_body(src: String, c: ClauseInfo, cx: EmitCtx) : String / Console {

  if is_lifecycle_clause(clause_parts(c).head) { emit_cleanup_thunk(src, c, cx) }
  else { emit_op_clause_body(src, c, cx) }
}

fn emit_op_clause_body(src: String, c: ClauseInfo, cx: EmitCtx) : String / Console {

  let k = clause_parts(c)
  let ns = emit_body_locals(clause_locals(c))
  # Clause body sees `self` and `k` (always), the state aliases, the
  # clause's params (params come into scope through the surrounding
  # handle's lcs), and every capture that travels through `self->env`.
  let scx = emit_ctx_declaring(EmitCtx { ...cx, locals: ns },
                               list_append(["self", "k"], clause_live_aliases(k.stateful, (key) => false)))
  let owned = unw_clause_seeds(c)
  let frame = unw_frame(cx.unw, owned, owned, k.body)
  let body_cx = emit_ctx_with_unw(emit_ctx_with_lcs(scx, list_append(scx.lcs, capture_locals(k.caps))), frame)
  let body_c = emit_expr_in_clause(src, k.body, body_cx, k.stateful)
  let env_prologue = emit_clause_env_prologue(ns, k.enc_fn, k.line, k.col, k.caps)
  concat_all([
    emit_clause_sig(c, cx.effs, cx.tab), " {\n",
    euw_with_fiber(frame.sites != [], "    (void) self; (void) k;\n    "),
    clause_state_prologue(k.stateful),
    clause_env_scope(k.stateful, env_prologue, concat_all(["    return ", body_c, ";\n"])),
    "}\n\n"
  ])
}

# Rebind each capture from the handle's env struct into a clause-local
# of the same name. The env borrows the enclosing binder for the handle's
# extent, so the local is a borrow too: Perceus dups every read of a
# capture, as it does a lambda's, and the enclosing scope releases it.
fn emit_clause_env_prologue(ns: LocalNames, enc_fn: String, line: Int, col: Int,
                             caps: [Capture]) : String {
  match caps {
    [] -> ""
    _ -> {
      let env_name = handle_env_struct_name(enc_fn, line, col)
      concat_all([
        "    ", env_name, " *_env = (", env_name, " *) self->env;\n",
        emit_clause_env_reads(ns, caps)
      ])
    }
  }
}

fn emit_clause_env_reads(ns: LocalNames, caps: [Capture]) : String {
  match caps {
    [] -> ""
    [c, ...rest] -> concat_all([
      clause_env_read(ns, c),
      emit_clause_env_reads(ns, rest)
    ])
  }
}

# Wrapper around `emit_expr` that flips the in-clause flag, so that
# `resume(v, ns)` lowers to a state-write before the resume call.
# Defined further below near emit_expr.

# Wrapper around `emit_expr` that flips the in-clause flag, so that
# `resume(v, ns)` lowers to a state-write before the resume call.
# Defined further below near emit_expr.
fn emit_expr_in_clause(src: String, e: Expr, cx: EmitCtx, stateful: Bool) : String / Console =

  emit_expr(src, e, cx)

fn emit_clause_bodies(src: String, cs: [ClauseInfo], cx: EmitCtx) : String / Console = {
  concat_all(map(cs, (c) => emit_clause_body(src, c, emit_ctx_with_enc_fn(cx, clause_sym(c)))))
}

# m7c-d — emit each clause as a top-level LLVM function. Mirrors
# `emit_clause_body`/`emit_clause_sig` from the C backend. The
# function takes `(EvX *self, %KaiValue* %arg1, ..., i8* %k)`
# and returns `%KaiValue*`. Inside, `self` and `k` are bound as
# locals (literal register names `%self` / `%k` so the resume
# handler in `llvm_emit_call` can reference `%k` directly). For
# stateful clauses we load `self->state` once into a local
# `%kai_state` (also bound as `%kai_log`) so the body can
# reference `state`/`log` like any other ident.

# m7c-d — emit each clause as a top-level LLVM function. Mirrors
# `emit_clause_body`/`emit_clause_sig` from the C backend. The
# function takes `(EvX *self, %KaiValue* %arg1, ..., i8* %k)`
# and returns `%KaiValue*`. Inside, `self` and `k` are bound as
# locals (literal register names `%self` / `%k` so the resume
# handler in `llvm_emit_call` can reference `%k` directly). For
# stateful clauses we load `self->state` once into a local
# `%kai_state` (also bound as `%kai_log`) so the body can
# reference `state`/`log` like any other ident.
fn emit_one_closure_cap(c: Capture, cx: EmitCtx) : String = match c {
  CapAlias(a) -> concat_all(["kai_int((int64_t) ", c_alias_id(emit_local_text(cx, a)), ")"])
  CapLocal(l) ->
    # A kind-1 raw binder has no boxed `kai_<c>` local; re-box its raw
    # alias for the capture array, mirroring the box-on-use read.
    if emit_ctx_kind1_raw_has(cx, l) { cat3("kai_int(kair_", emit_local_text(cx, l), ")") }
    else { c_local(emit_local_text(cx, l)) }
}

fn emit_closure_caps(caps: [Capture], cx: EmitCtx) : String =
  join_with(map(caps, (c) => emit_one_closure_cap(c, cx)), ", ")

fn emit_lambda_ref(x: Expr, cx: EmitCtx) : String {
  match find_lam(cx.lams, cx.cur_enc_fn, x.line, x.col) {
    None -> "kai_unit() /* lambda: missing info */"
    Some(l) -> match l {
      LamInfo(_, _, _, _, params, caps, _, _) -> {
        let arity = list_length(params)
        let n_caps = list_length(caps)
        if n_caps == 0 {
          concat_all([
            "kai_closure(&", lam_symbol(l),
            ", ", int_to_string(arity), ", 0, NULL)"
          ])
        } else {
          concat_all([
            "kai_closure(&", lam_symbol(l),
            ", ", int_to_string(arity), ", ", int_to_string(n_caps),
            ", (KaiValue *[]){", emit_closure_caps(caps, cx), "})"
          ])
        }
      }
    }
  }
}

# ---- full emit_expr (with lambda support) ----

# C type used for a raw local of an unboxable type. Matches the
# `as.*` field widths in `KaiValue` (see runtime.h).

# C type used for a raw local of an unboxable type. Matches the
# `as.*` field widths in `KaiValue` (see runtime.h).
fn raw_c_type(opt_ty: Option[Ty]) : String {
  match opt_ty {
    Some(t) -> match t {
      TyInt  -> "int64_t"
      TyReal -> "double"
      TyBool -> "int"
      TyChar -> "uint32_t"
      TyByte -> "uint8_t"
      TyInt32  -> "int32_t"
      TyUInt32 -> "uint32_t"
      TyUInt64 -> "uint64_t"
      TyInt128 -> "__int128"
      # KIR Lane 1: an LLVM C-API handle is a raw opaque pointer.
      TyHandle -> "void *"
      # A fixed-width `Vec[e]<n>` is a flat by-value C aggregate, not a
      # boxed `KaiValue *`: no RC header, no `{len,cap}`, no heap block.
      TyDimT(_, _)        -> if ty_is_fixed_vec(t) { fixed_vec_cname(t) }
                             else { match t { TyDimT(inner, _) -> raw_c_type(Some(inner)) _ -> "int64_t" } }
      TyRefineT(inner, _) -> raw_c_type(Some(inner))
      _ -> "int64_t /* raw_c_type: unexpected ty */"
    }
    None -> "int64_t /* raw_c_type: missing ty */"
  }
}

# The C typedef name of a fixed-width `Vec[e]<n>`: `KaiFixedVec_<elem>_<n>`,
# one distinct type per element mangle and length. Callers gate on
# `ty_is_fixed_vec`.
fn fixed_vec_cname(t: Ty) : String =
  concat_all(["KaiFixedVec_", mangle_ty(fixed_vec_elem(t)), "_", int_to_string(fixed_vec_n(t))])

# One element out of a fixed-width vec, in raw position. The inline
# aggregate is the representation of a binder the unbox pass marked
# `MUnboxed`; a fixed-vec-TYPED value that is boxed (a parameter, a
# call result) has already crossed the border and is a dynamic heap
# vec, so its slot is reached through the runtime. Both forms are a
# bare typed load — no RC either way, which is what Perceus assumes
# for this read.
fn emit_fixed_vec_get(src: String, coll: Expr, ix: Expr, cx: EmitCtx) : String / Console =
  emit_fixed_vec_read(src, coll, fixed_vec_idx_c(ix, src, cx), cx)

# The same read with the subscript already gated against the static length.
fn emit_fixed_vec_get_dyn(src: String, coll: Expr, ix: Expr, cx: EmitCtx) : String / Console =
  emit_fixed_vec_read(src, coll, fixed_vec_dyn_idx_c(coll, ix, src, cx), cx)

fn fixed_vec_arity_mismatch(m: Mark) : String =
  concat_all(["0 /* ", mark_name(m), ": arity mismatch */"])

# A boxed fixed vec is a heap `Vec` the read consumes, like `vec_get`.
fn emit_fixed_vec_read(src: String, coll: Expr, ixc: String, cx: EmitCtx) : String / Console =
  match coll.mode {
    MUnboxed -> concat_all(["(", emit_expr_raw(src, coll, cx), ").a[", ixc, "]"])
    _ -> {
      let et = raw_c_type(Some(fixed_vec_elem_of(coll.ty)))
      concat_all(["({ KaiValue *_fv = ", emit_expr_boxed(src, coll, cx), "; ", et,
                  " _fx = *(", et, " *) kai_vec_raw_slot(_fv, ", ixc, "); kai_decref(_fv); _fx; })"])
    }
  }

# The element type behind a fixed-vec-typed node; `TyInt` keeps the
# load well-formed when the type is absent.
fn fixed_vec_elem_of(opt_t: Option[Ty]) : Ty = match opt_t {
  Some(t) -> fixed_vec_elem(t)
  None    -> TyInt
}


# The include-guarded `typedef struct { <elem> a[n]; } <cname>;` for a
# fixed-width vec, emitted at the first local declaration of that type.
# The `#ifndef`/`#define` guard is preprocessor-global (block scope does
# not apply), so a later declaration of the same `(elem, n)` skips it.
fn fixed_vec_typedef(t: Ty) : String {
  let cname = fixed_vec_cname(t)
  concat_all([
    "\n#ifndef ", cname, "_DEFINED\n#define ", cname, "_DEFINED\n",
    "typedef struct { ", raw_c_type(Some(fixed_vec_elem(t))), " a[",
    int_to_string(fixed_vec_n(t)), "]; } ", cname, ";\n#endif\n"
  ])
}

# Pre-declare each fixed-vec `typedef` the program references, once, in
# the shared types header. A fixed vec surfaces wherever a
# `__fixed_vec_lit` is emitted (a let RHS, a materialised argument, a
# nested literal), so the whole decl tree is scanned by node `.ty`. The
# collector accumulates ready-rendered (include-guarded) typedef strings,
# deduplicated, so this only concatenates them.
pub fn collect_fixed_vec_typedefs(decls: [Decl]) : String =
  concat_all(cfv_decls(decls, []))

fn cfv_decls(decls: [Decl], acc: [String]) : [String] = match decls {
  []           -> acc
  [d, ...rest] -> cfv_decls(rest, cfv_decl(d, acc))
}

fn cfv_decl(d: Decl, acc: [String]) : [String] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _) -> cfv_expr(body, acc)
  DTest(_, body, _, _, _)     -> cfv_expr(body, acc)
  DBench(_, body, _, _, _)    -> cfv_expr(body, acc)
  DCheck(_, _, body, _, _, _) -> cfv_expr(body, acc)
  _ -> acc
}

# Register this node's fixed-vec type (if any), then recurse into children.
fn cfv_expr(e: Expr, acc: [String]) : [String] {
  let acc1 = match e.ty {
    Some(t) -> if ty_is_fixed_vec(t) { cfv_add(t, acc) } else { acc }
    None    -> acc
  }
  cfv_children(e.kind, acc1)
}

fn cfv_add(t: Ty, acc: [String]) : [String] {
  let td = fixed_vec_typedef(t)
  if list_has(acc, td) { acc } else { [td, ...acc] }
}

fn cfv_list(es: [Expr], acc: [String]) : [String] = match es {
  []           -> acc
  [h, ...rest] -> cfv_list(rest, cfv_expr(h, acc))
}

fn cfv_children(k: ExprKind, acc: [String]) : [String] = match k {
  ECall(callee, args_) -> cfv_list(args_, cfv_expr(callee, acc))
  EIntrinsic(_, args_) -> cfv_list(args_, acc)
  ESurface(sf) -> cfv_list(surface_children(sf), acc)
  EField(base, _)      -> cfv_expr(base, acc)
  EIndex(a, b)         -> cfv_expr(b, cfv_expr(a, acc))
  EBinop(_, a, b)      -> cfv_expr(b, cfv_expr(a, acc))
  EUnop(_, x)          -> cfv_expr(x, acc)
  EIf(c, t, eo)        -> {
    let a1 = cfv_expr(t, cfv_expr(c, acc))
    match eo { Some(b) -> cfv_expr(b, a1) None -> a1 }
  }
  EMatch(scr, arms)    -> cfv_arms(arms, cfv_expr(scr, acc))
  ELambda(_, body)     -> cfv_expr(body, acc)
  ERecordLit(_, fs)    -> cfv_fields(fs, acc)
  EList(els)           -> cfv_elems(els, acc)
  ERange(a, b, opt)    -> {
    let a1 = cfv_expr(b, cfv_expr(a, acc))
    match opt { Some(s) -> cfv_expr(s, a1) None -> a1 }
  }
  EBlock(stmts, tail)  -> {
    let a1 = cfv_stmts(stmts, acc)
    match tail { Some(t) -> cfv_expr(t, a1) None -> a1 }
  }
  EPipe(a, b)          -> cfv_expr(b, cfv_expr(a, acc))
  EMapPipe(a, b)       -> cfv_expr(b, cfv_expr(a, acc))
  EFlatMapPipe(a, b)   -> cfv_expr(b, cfv_expr(a, acc))
  EFilterPipe(a, b)    -> cfv_expr(b, cfv_expr(a, acc))
  EBang(inner)         -> cfv_expr(inner, acc)
  ELitUnit(inner, _)   -> cfv_expr(inner, acc)
  EHandle(body, _, _, init_opt, _, clauses, ret_opt) -> {
    let a1 = cfv_expr(body, acc)
    let a2 = match init_opt { Some(i) -> cfv_expr(i, a1) None -> a1 }
    let a3 = cfv_clauses(clauses, a2)
    match ret_opt { Some(r) -> match r { HR(_, b, _, _) -> cfv_expr(b, a3) }  None -> a3 }
  }
  _ -> acc
}

fn cfv_arms(arms: [Arm], acc: [String]) : [String] = match arms {
  []           -> acc
  [a, ...rest] -> match a {
    Arm(_, og, body) -> {
      let a1 = match og { Some(g) -> cfv_expr(g, acc) None -> acc }
      cfv_arms(rest, cfv_expr(body, a1))
    }
  }
}

fn cfv_fields(fs: [FieldInit], acc: [String]) : [String] = match fs {
  []           -> acc
  [f, ...rest] -> match f { FI(_, e) -> cfv_fields(rest, cfv_expr(e, acc)) }
}

fn cfv_elems(els: [ListElem], acc: [String]) : [String] = match els {
  []            -> acc
  [el, ...rest] -> match el {
    ElPlain(e)  -> cfv_elems(rest, cfv_expr(e, acc))
    ElSpread(e) -> cfv_elems(rest, cfv_expr(e, acc))
  }
}

fn cfv_stmts(ss: [Stmt], acc: [String]) : [String] = match ss {
  []           -> acc
  [s, ...rest] -> match s {
    SLet(_, _, e)        -> cfv_stmts(rest, cfv_expr(e, acc))
    SVar(_, _, e, _, _)  -> cfv_stmts(rest, cfv_expr(e, acc))
    SAssert(e, og)       -> {
      let a1 = cfv_expr(e, acc)
      let a2 = match og { Some(g) -> cfv_expr(g, a1) None -> a1 }
      cfv_stmts(rest, a2)
    }
    SExprStmt(e)         -> cfv_stmts(rest, cfv_expr(e, acc))
    SIndexAssign(a, b, c, _, _) -> cfv_stmts(rest, cfv_expr(c, cfv_expr(b, cfv_expr(a, acc))))
    SAssign(a, c, _, _)  -> cfv_stmts(rest, cfv_expr(c, cfv_expr(a, acc)))
    SUse(_, _, _)        -> cfv_stmts(rest, acc)
  }
}

fn cfv_clauses(cs: [HClause], acc: [String]) : [String] = match cs {
  []           -> acc
  [c, ...rest] -> match c { HC(_, _, body, _, _) -> cfv_clauses(rest, cfv_expr(body, acc)) }
}

# The C index of a fixed-vec static read. The typer validated it as a
# literal in range, so a bare `EInt` renders as a plain integer; any
# other shape falls back to the raw emit (defensive — unreachable in v1).
fn fixed_vec_idx_c(ix: Expr, src: String, cx: EmitCtx) : String / Console =
  match ix.kind {
    EInt(k, _) -> int_to_string(k)
    _       -> emit_expr_raw(src, ix, cx)
  }

# The C subscript of a fixed-vec dynamic read: the raw index gated by
# `kai_fixed_vec_idx` against the length carried by the collection's
# type. The gate traps out of range and returns the index.
fn fixed_vec_dyn_idx_c(coll: Expr, ix: Expr, src: String, cx: EmitCtx) : String / Console {
  let n = match coll.ty { Some(t) -> fixed_vec_n(t)  None -> 0 }
  concat_all(["kai_fixed_vec_idx((int64_t)(", emit_expr_raw(src, ix, cx), "), ",
              int_to_string(n), "LL)"])
}

# Materialise a fixed-width vec (`raw`, a pure C local) into a dynamic
# heap `Vec`: a pre-sized `vec_reserve` filled by one boxed `vec_push`
# per element. Crosses the fixed→dynamic boundary at a boxed border.
fn materialize_fixed_vec(t: Ty, raw: String) : String {
  let n = fixed_vec_n(t)
  let elem = fixed_vec_elem(t)
  let base = concat_all(["kai_core_vec_reserve(kai_int(", int_to_string(n), "LL))"])
  materialize_fixed_vec_push(base, raw, elem, 0, n)
}

fn materialize_fixed_vec_push(acc: String, raw: String, elem: Ty, i: Int, n: Int) : String {
  if i >= n { acc }
  else {
    let elem_box = box_wrap(Some(elem), concat_all(["(", raw, ").a[", int_to_string(i), "]"]))
    let push = concat_all(["kai_core_vec_push(", acc, ", ", elem_box, ")"])
    materialize_fixed_vec_push(push, raw, elem, i + 1, n)
  }
}

# Wrap a raw C scalar into its boxed `KaiValue *` form. Picks the
# constructor by `ty`. `kai_int` / `kai_bool` / `kai_char` are the
# Phase 1 cache-aware constructors so small ints and chars stay
# allocation-free at the boundary.

# Wrap a raw C scalar into its boxed `KaiValue *` form. Picks the
# constructor by `ty`. `kai_int` / `kai_bool` / `kai_char` are the
# Phase 1 cache-aware constructors so small ints and chars stay
# allocation-free at the boundary.
fn box_wrap(opt_ty: Option[Ty], raw: String) : String {
  match opt_ty {
    Some(t) -> match t {
      TyInt  -> cat3("kai_int(",  raw, ")")
      TyReal -> cat3("kai_real(", raw, ")")
      TyBool -> cat3("kai_bool(", raw, ")")
      TyChar -> cat3("kai_char(", raw, ")")
      TyByte -> cat3("kai_byte(", raw, ")")
      TyInt32  -> cat3("kai_int32(",  raw, ")")
      TyUInt32 -> cat3("kai_uint32(", raw, ")")
      TyUInt64 -> cat3("kai_uint64(", raw, ")")
      TyInt128 -> cat3("kai_int128(", raw, ")")
      # A `TyHandle` rides a boxed slot as an immediate (tag bit set, no
      # allocation), so any dup/drop Perceus plants on it is a no-op. A bare
      # pointer there is RC'd like a heap cell and corrupts the LLVM object.
      TyHandle -> cat3("kai_handle_box(", raw, ")")
      # A fixed-width `Vec[e]<n>` crossing to a boxed border (a `Vec`
      # parameter, a record field) materialises into a dynamic heap vec:
      # the flat inline layout is copied out element by element. The `raw`
      # C expression is a pure local (`kair_x`), so re-reading its fields
      # is side-effect-free.
      TyDimT(_, _)        -> if ty_is_fixed_vec(t) { materialize_fixed_vec(t, raw) }
                             else { match t { TyDimT(inner, _) -> box_wrap(Some(inner), raw) _ -> cat3("kai_int(", raw, ")") } }
      TyRefineT(inner, _) -> box_wrap(Some(inner), raw)
      _ -> cat3("kai_int(", raw, ") /* box_wrap: unexpected ty */")
    }
    None -> cat3("kai_int(", raw, ") /* box_wrap: missing ty */")
  }
}

# Unbox a boxed `KaiValue *` into its raw C scalar. Used at the
# `MBoxed → MUnboxed` boundary inside arithmetic operands.

# Unbox a boxed `KaiValue *` into its raw C scalar. Used at the
# `MBoxed → MUnboxed` boundary inside arithmetic operands.
# True when a raw EBinop is Int `+`/`-`/`*` and must therefore wrap in
# two's complement (kaikai's documented Int semantics). The emitter
# renders these via a uint64_t round-trip so the wrap is well-defined
# C; `/` and `%` are excluded here (they route through the checked helper,
# see `raw_int_divmod_is_checked`) and Real `+`/`-`/`*` are excluded by the
# TyInt gate. See the EBinop arm in emit_kind_raw.
# True iff the optional type is Int (or an Int newtype/refinement). Shared
# by the wrapping-arith gate and the direct-Int-comparison fast path.
fn ty_opt_is_int(opt_ty: Option[Ty]) : Bool = match opt_ty {
  Some(t) -> match t {
    TyInt -> true
    TyDimT(inner, _)    -> match inner { TyInt -> true _ -> false }
    TyRefineT(inner, _) -> match inner { TyInt -> true _ -> false }
    _ -> false
  }
  None -> false
}

# True when the optional type is one of the fixed-width integer
# primitives (Byte included). They share the raw-arithmetic wrapping
# discipline with `Int`; the cast width differs (per `raw_signed_c_type`).
fn ty_opt_is_fixed_width(opt_ty: Option[Ty]) : Bool = match opt_ty {
  Some(t) -> match t {
    TyByte -> true
    TyInt32 -> true   TyUInt32 -> true
    TyUInt64 -> true  TyInt128 -> true
    _ -> false
  }
  None -> false
}

fn raw_arith_is_wrapping_int(op: BinOp, opt_ty: Option[Ty]) : Bool {
  let is_wrap_op = match op {
    BoAdd -> true
    BoSub -> true
    BoMul -> true
    _     -> false
  }
  is_wrap_op and (ty_opt_is_int(opt_ty) or ty_opt_is_fixed_width(opt_ty))
}

# True when a raw EBinop is an `Int`/`Byte`/`Int32`/`UInt32`/`UInt64`
# `/`/`%` — those route through the trapping helper rather than a bare
# `a / b`, so a zero divisor traps clean. The unsigned widths use the
# `kai_udiv_chk`/`kai_umod_chk` pair (`ty_opt_is_checked_unsigned`); the
# signed ones use `kai_idiv_chk`/`kai_imod_chk`. Int128 div stays boxed
# (`kai_fixed_div`).
fn raw_int_divmod_is_checked(op: BinOp, opt_ty: Option[Ty]) : Bool {
  binop_is_division(op) and
  (ty_opt_is_int(opt_ty) or ty_opt_is_byte(opt_ty) or
   ty_opt_is_int32(opt_ty) or ty_opt_is_checked_unsigned(opt_ty))
}

fn ty_opt_is_byte(opt_ty: Option[Ty]) : Bool = match opt_ty {
  Some(t) -> match t {
    TyByte -> true
    TyRefineT(inner, _) -> match inner { TyByte -> true _ -> false }
    _ -> false
  }
  None -> false
}

fn ty_opt_is_int32(opt_ty: Option[Ty]) : Bool = match opt_ty {
  Some(t) -> match t {
    TyInt32 -> true
    TyRefineT(inner, _) -> match inner { TyInt32 -> true _ -> false }
    _ -> false
  }
  None -> false
}

# UInt32/UInt64 `/`/`%` route through the UNSIGNED checked helper. Their
# operands widen (zext) into the u64 helper; only the zero divisor traps.
fn ty_opt_is_checked_unsigned(opt_ty: Option[Ty]) : Bool = match opt_ty {
  Some(t) -> match t {
    TyUInt32 -> true   TyUInt64 -> true
    TyRefineT(inner, _) -> match inner { TyUInt32 -> true  TyUInt64 -> true  _ -> false }
    _ -> false
  }
  None -> false
}

# The signed/unsigned C scalar type a raw integer slot computes in.
# `Int` and unknown default to `int64_t`; the fixed-width primitives
# pick their exact width. The unsigned form drives the two's-complement
# wrap (defined C, no UBSan trap); the signed form is the cast back.
fn raw_signed_c_type(opt_ty: Option[Ty]) : String = match opt_ty {
  Some(TyByte)   -> "uint8_t"
  Some(TyInt32)  -> "int32_t"
  Some(TyUInt32) -> "uint32_t"
  Some(TyUInt64) -> "uint64_t"
  Some(TyInt128) -> "__int128"
  Some(TyDimT(inner, _))    -> raw_signed_c_type(Some(inner))
  Some(TyRefineT(inner, _)) -> raw_signed_c_type(Some(inner))
  _ -> "int64_t"
}

fn raw_unsigned_c_type(opt_ty: Option[Ty]) : String = match opt_ty {
  Some(TyByte)   -> "uint8_t"
  Some(TyInt32)  -> "uint32_t"
  Some(TyUInt32) -> "uint32_t"
  Some(TyUInt64) -> "uint64_t"
  Some(TyInt128) -> "unsigned __int128"
  Some(TyDimT(inner, _))    -> raw_unsigned_c_type(Some(inner))
  Some(TyRefineT(inner, _)) -> raw_unsigned_c_type(Some(inner))
  _ -> "uint64_t"
}

# A fixed-width literal as a raw C scalar. Int32/UInt32 fit the
# compiler's 64-bit decode and cast directly. UInt64 and Int128 may hold
# values above 2^63 (which overflow `decode_int`), so they parse their
# textual span at runtime via `kai_i128_parse` and cast to the width.
fn fixed_raw_c_lit(span: String, ty: Ty) : String = match ty {
  TyByte   -> cat3("((uint8_t)", int_to_string(decode_int(span)), ")")
  TyInt32  -> cat3("((int32_t)", int_to_string(decode_int(span)), "LL)")
  TyUInt32 -> cat3("((uint32_t)", int_to_string(decode_int(span)), "ULL)")
  TyUInt64 -> cat3("((uint64_t)kai_i128_parse(\"", span, "\"))")
  TyInt128 -> cat3("kai_i128_parse(\"", span, "\")")
  _        -> cat2(int_to_string(decode_int(span)), "LL")
}

# A fixed-width literal as a boxed KaiValue (constructor call).
fn fixed_box_c_lit(span: String, ty: Ty) : String = match ty {
  TyByte   -> cat3("kai_byte((uint8_t)", int_to_string(decode_int(span)), ")")
  TyInt32  -> cat3("kai_int32((int32_t)", int_to_string(decode_int(span)), "LL)")
  TyUInt32 -> cat3("kai_uint32((uint32_t)", int_to_string(decode_int(span)), "ULL)")
  TyUInt64 -> cat3("kai_uint64((uint64_t)kai_i128_parse(\"", span, "\"))")
  TyInt128 -> cat3("kai_int128(kai_i128_parse(\"", span, "\"))")
  _        -> cat3("kai_int(", int_to_string(decode_int(span)), "LL)")
}

# C operator for a comparison op, when both operands are Int and the
# comparison can lower to a direct `kai_intf(a) <op> kai_intf(b)` instead of
# the boxed kai_op dispatch (type-test + boxed-bool + truthy + decref).
# `==`/`!=` are included: structural equality over two statically-Int
# operands IS the numeric comparison, so no Eq dispatch is lost.
fn int_cmp_c_op(op: BinOp) : Option[String] = match op {
  BoLt -> Some("<")
  BoGt -> Some(">")
  BoLe -> Some("<=")
  BoGe -> Some(">=")
  BoEq -> Some("==")
  BoNe -> Some("!=")
  _    -> None
}

# Gate for the direct-Int-comparison fast path: an order comparison whose
# both operands are statically Int.
fn is_int_order_cmp(op: BinOp, a: Expr, b: Expr) : Bool = int_cmp_raw(op, a, b)

# Is `e` itself a direct Int order-comparison (`k < kx`, …)? Used by the
# `if`/match-guard lowering to emit a RAW C bool predicate and use the C
# ternary directly, instead of `kai_op_truthy(kai_bool(...))` — the box and
# the un-box cancel. General over every `if cmp { }` where both sides are
# statically Int, the rb-tree descent being the load-bearing case (3 such
# comparisons per node visited).
fn expr_is_int_order_cmp(e: Expr) : Bool = match e.kind {
  EBinop(op, a, b) -> is_int_order_cmp(op, a, b)
  _ -> false
}

# Emit a direct Int order-comparison as a RAW C bool (no `kai_bool` box).
# Caller has already gated on `expr_is_int_order_cmp(e)`. Mirrors the boxed
# path's operand reads (emit_expr_raw, non-consuming) but yields the bare
# `(_la <op> _lb)` predicate the C `if`/`?:` consumes with no RC traffic.
fn emit_int_order_cmp_raw(src: String, e: Expr, cx: EmitCtx) : String / Console =
  match e.kind {
    EBinop(op, a, b) -> {
      let c_op = match int_cmp_c_op(op) { Some(o) -> o None -> "<" }
      concat_all([
        "({ int64_t _la = ", emit_expr_raw(src, a, cx),
        "; int64_t _lb = ", emit_expr_raw(src, b, cx),
        "; (_la ", c_op, " _lb); })"
      ])
    }
    _ -> "0 /* emit_int_order_cmp_raw: not a comparison */"
  }

fn unbox_field_for(opt_ty: Option[Ty]) : String {
  match opt_ty {
    Some(t) -> match t {
      TyInt  -> "->as.i"
      TyReal -> "->as.r"
      TyBool -> "->as.b"
      TyChar -> "->as.c"
      TyByte -> "->as.byte_val"
      TyInt32  -> "->as.i32"
      TyUInt32 -> "->as.u32"
      TyUInt64 -> "->as.u64"
      # Int128 has no single alignment-safe field suffix (its value spans
      # two 8-byte halves); the raw path reads it via `kai_i128_load` in
      # `unbox_boxed_scalar`, which intercepts TyInt128 before this point.
      # The low half keeps any stray emit a valid (if lossy) C expression
      # rather than a reference to the removed `->as.i128` field.
      TyInt128 -> "->as.i128_halves[0]"
      TyDimT(inner, _)    -> unbox_field_for(Some(inner))
      TyRefineT(inner, _) -> unbox_field_for(Some(inner))
      _ -> "->as.i /* unbox: unexpected ty */"
    }
    None -> "->as.i /* unbox: missing ty */"
  }
}

# The raw C scalar form of `x`, whose `ty` is unboxable. A `MUnboxed` node
# is natively raw; any other crosses the box→raw border (`raw_border.kai`).
fn emit_expr_raw(src: String, x: Expr, cx: EmitCtx) : String / Console {
  # The unbox reads the OUTER `x.ty`: a stripped dup's inner read often has
  # no `ty`, and an untyped unbox reads the payload as an Int.
  let xb = raw_border_strip_dup(x)
  # A kind-1 raw-bound binder is always the `kair_` local, whatever mode
  # verdict this use carries.
  match xb.kind {
    ELocal(l) ->
      if emit_ctx_kind1_raw_has(cx, l) { cat2("kair_", emit_local_text(cx, l)) }
      else { emit_expr_raw_split(src, xb, x, cx) }
    _ -> emit_expr_raw_split(src, xb, x, cx)
  }
}

fn emit_expr_raw_split(src: String, xb: Expr, x: Expr, cx: EmitCtx) : String / Console {
  match xb.mode {
    MUnboxed -> emit_kind_raw(src, xb, cx)
    _        -> unbox_border(emit_expr_boxed(src, xb, cx), xb, x.ty)
  }
}

# The raw payload of `node`'s boxed C form: an owned temporary is consumed,
# a variable read borrows.
fn unbox_border(boxed: String, node: Expr, opt_ty: Option[Ty]) : String =
  if raw_border_owns(node) { unbox_take_scalar(boxed, opt_ty) }
  else { unbox_boxed_scalar(boxed, opt_ty) }

# Reads the payload and releases the box. Bool and Byte boxes are immortal,
# so their plain read owes no release.
fn unbox_take_scalar(boxed: String, opt_ty: Option[Ty]) : String = match opt_ty {
  Some(t) -> match t {
    TyInt    -> cat3("kai_take_int(", boxed, ")")
    TyReal   -> cat3("kai_take_real(", boxed, ")")
    TyChar   -> cat3("kai_take_char(", boxed, ")")
    TyInt32  -> cat3("kai_take_int32(", boxed, ")")
    TyUInt32 -> cat3("kai_take_uint32(", boxed, ")")
    TyUInt64 -> cat3("kai_take_uint64(", boxed, ")")
    TyInt128 -> cat3("kai_take_int128(", boxed, ")")
    TyDimT(inner, _)    -> if ty_is_fixed_vec(t) { unbox_boxed_scalar(boxed, opt_ty) }
                           else { unbox_take_scalar(boxed, Some(inner)) }
    TyRefineT(inner, _) -> unbox_take_scalar(boxed, Some(inner))
    _ -> unbox_boxed_scalar(boxed, opt_ty)
  }
  None -> unbox_boxed_scalar(boxed, opt_ty)
}

# Borrow-reads a raw scalar out of a boxed C expression, leaving its RC
# untouched. An Int may be a tagged immediate, so it reads via `kai_intf`.
fn unbox_boxed_scalar(boxed: String, opt_ty: Option[Ty]) : String {
  match opt_ty {
    Some(t) -> match t {
      TyInt  -> cat3("kai_intf(", boxed, ")")
      # A boxed `TyHandle` is the immediate `box_wrap` built, never a heap
      # cell: clear the tag bit, no `->as.i` deref.
      TyHandle -> cat3("kai_handle_unbox(", boxed, ")")
      # An Int128 box stores its value in two 8-byte halves, never a bare
      # `->as.i128` (that field carries a 16-byte alignment requirement the
      # 8-byte-aligned KaiValue does not meet — a misaligned read segfaults
      # on Linux/-O2). Read it through the alignment-agnostic load helper.
      TyInt128 -> cat3("kai_i128_load(", boxed, ")")
      TyDimT(inner, _)    -> unbox_boxed_scalar(boxed, Some(inner))
      TyRefineT(inner, _) -> unbox_boxed_scalar(boxed, Some(inner))
      _ -> cat3("(", boxed, cat2(")", unbox_field_for(opt_ty)))
    }
    None -> cat3("kai_intf(", boxed, ")")
  }
}

# Unroll `b ^ n` into `n` repeated multiplications. Caller has already
# gated `n` to `[0, 64]` and `base_c` is a pure raw C expression
# (literal / EVar / pure raw arith), so duplication is safe. Only the
# non-fixed-width Int shape reaches here. The factors multiply in
# `uint64_t` and cast back so an overflowing power wraps (defined C)
# like the sibling `*`. Squaring would emit fewer factors but produces
# the same constant-folded code under any optimizer; the linear form
# keeps the emitted IR easy to grep for in regression tests.
fn emit_pow_unroll(base_c: String, n: Int) : String {
  match n {
    0 -> "1LL"
    1 -> cat3("(", base_c, ")")
    _ -> cat3("((int64_t)(", emit_pow_unroll_loop(base_c, n, ""), "))")
  }
}

fn emit_pow_unroll_loop(base_c: String, k: Int, acc: String) : String {
  match k {
    0 -> acc
    1 -> {
      if acc == "" { cat3("(uint64_t)(", base_c, ")") }
      else { concat_all([acc, " * (uint64_t)(", base_c, ")"]) }
    }
    _ -> {
      let next = if acc == "" { cat3("(uint64_t)(", base_c, ")") }
                 else { concat_all([acc, " * (uint64_t)(", base_c, ")"]) }
      emit_pow_unroll_loop(base_c, k - 1, next)
    }
  }
}

fn emit_kind_raw(src: String, x: Expr, cx: EmitCtx) : String / Console {

  match x.kind {
    EInt(n, _) -> cat2(int_to_string(n), "LL")
    EFixed(span, ty) -> fixed_raw_c_lit(span, ty)
    EReal(r, _) -> real_c_lit(real_to_string(r))
    EBool(b) -> if b { "1" } else { "0" }
    EChar(c) -> int_to_string(char_to_int(c))
    ELocal(l) -> cat2("kair_", emit_local_text(cx, l))
    EBinop(op, a, b) ->
      if raw_arith_is_wrapping_int(op, x.ty) {
        # Int and fixed-width `+`/`-`/`*` wrap in two's complement by
        # design (matches the boxed `kai_op_*` path). Compute in the
        # unsigned of the width and cast back so the wrap is well-defined
        # C (6.3.1.3) rather than signed-overflow UB that
        # `-fsanitize=undefined` flags — reachable the moment a hash mix
        # (`acc * 31`) overflows. Real `*`/`+` keep the plain form; Int
        # `/`/`%` route through the checked helper (handled below).
        let st = raw_signed_c_type(x.ty)
        let ut = raw_unsigned_c_type(x.ty)
        let q = seq_operands([emit_expr_raw(src, a, cx), emit_expr_raw(src, b, cx)])
        match seq_refs(q) {
          [ra, rb] -> seq_wrap(q, concat_all(["((", st, ")((", ut, ")(", ra,
                                              ") ", raw_op_str(op), " (", ut, ")(", rb, ")))"]))
          _ -> "0 /* raw wrap: operand arity */"
        }
      } else if raw_int_divmod_is_checked(op, x.ty) {
        # Raw `/`/`%` trap on a zero divisor (and the signed helper on
        # INT64_MIN/-1) instead of the bare `a / b` the hardware would run
        # as UB. Signed widths widen into the signed i64 helper; unsigned
        # widths (UInt32/UInt64) into the u64 one — the operand promotes
        # (sext/zext) at the call and the result truncates back at its slot.
        let checked = if ty_opt_is_checked_unsigned(x.ty) {
          if binop_eq(op, BoDiv) { "kai_udiv_chk(" } else { "kai_umod_chk(" }
        } else {
          if binop_eq(op, BoDiv) { "kai_idiv_chk(" } else { "kai_imod_chk(" }
        }
        seq_call(checked, [emit_expr_raw(src, a, cx), emit_expr_raw(src, b, cx)], ")")
      } else if op_is_raw_arith(op) or op_is_raw_cmp(op) or op_is_raw_logical(op) {
        # Only the left operand is ever hoisted, so `&&`/`||` keep short-circuiting.
        seq_infix(emit_expr_raw(src, a, cx), raw_op_str(op), emit_expr_raw(src, b, cx))
      } else if binop_eq(op, BoPow) {
        # Issue #90 — integer power, exponent is a compile-time
        # literal in `[0, 64]` (gated by `pow_exp_is_inlinable`).
        # Unroll into repeated multiplications. Base is pure raw
        # (no calls) so duplication is safe.
        let n = match try_eval_int(b) { Some(v) -> v None -> 0 }
        let base_c = emit_expr_raw(src, a, cx)
        emit_pow_unroll(base_c, n)
      } else {
        # Conservative fallback: boxed expression then unbox.
        let boxed = emit_expr_boxed(src, x, cx)
        unbox_border(boxed, x, x.ty)
      }
    EUnop(op, inner) -> match op {
      # Integer negation wraps (`-Int.MIN` is `Int.MIN`): compute in
      # the unsigned width and cast back, like the wrapping binops.
      # Real keeps the plain form.
      UoNeg ->
        if ty_opt_is_int(x.ty) or ty_opt_is_fixed_width(x.ty) {
          let st = raw_signed_c_type(x.ty)
          let ut = raw_unsigned_c_type(x.ty)
          concat_all(["((", st, ")(0 - (", ut, ")(",
                      emit_expr_raw(src, inner, cx), ")))"])
        } else {
          cat3("(-", emit_expr_raw(src, inner, cx), ")")
        }
      UoNot -> cat3("(!", emit_expr_raw(src, inner, cx), ")")
    }
    # Phase 3 unboxing — when the callee resolves to a UFn, emit
    # the raw call inline (`<callee>(<raw args>)`) so the result
    # stays a raw scalar without a kai_int wrap-and-unwrap. The
    # tcrec step is special — it always lowers to the
    # `goto`-block which `tcrec_emit_goto` already produces in raw
    # form when the surrounding fn is UFn. Other callees fall back
    # to the boxed-then-unbox boundary form.
    ECall(callee_e, args_e) -> match callee_e.kind {
      # A fixed-width `Vec[e]<n>` literal: a flat by-value C aggregate
      # `(<cname>){ .a = { e0, e1, ... } }`, no heap block, no header.
      EMark(MkFixedVecLit) ->
        seq_call(concat_all(["(", raw_c_type(x.ty), "){ .a = { "]),
                 map(args_e, (e) => emit_expr_raw(src, e, cx)), " } }")
      # Static-index read into a fixed vec. The index is a compile-time
      # literal and the bound was proved by the typer, so neither form
      # emits a runtime check.
      EMark(MkFixedVecGet) -> match args_e {
        [coll, ix] -> emit_fixed_vec_get(src, coll, ix, cx)
        _ -> fixed_vec_arity_mismatch(MkFixedVecGet)
      }
      # Dynamic-index read: the same read, the subscript gated by
      # `kai_fixed_vec_idx` against the static length.
      EMark(MkFixedVecGetDyn) -> match args_e {
        [coll, ix] -> emit_fixed_vec_get_dyn(src, coll, ix, cx)
        _ -> fixed_vec_arity_mismatch(MkFixedVecGetDyn)
      }
      EMark(MkTcrecStep(s)) -> tcrec_emit_goto(src, s.sym, s.dropmask, s.params, args_e, cx)
      ESym(_, _) ->
        match emit_raw_rcore(src, callee_e, args_e, cx) {
          Some(s) -> s
          None -> match emit_ufn_raw_call_at(src, x, callee_e, args_e, cx) {
          Some(s) -> s
          None    -> {
            let boxed = emit_expr_boxed(src, x, cx)
            unbox_border(boxed, x, x.ty)
          }
        } }
      _ -> match emit_ufn_raw_call_at(src, x, callee_e, args_e, cx) {
        Some(s) -> s
        None    -> {
          let boxed = emit_expr_boxed(src, x, cx)
          unbox_border(boxed, x, x.ty)
        }
      }
    }
    # Phase 3 unboxing — `if cond { a } else { b }` where every
    # branch is itself emit-raw-able lowers to the C ternary
    # `(cond ? a : b)`. Caller has already gated `x.mode = MUnboxed`
    # via `decide_mode`'s EIf clause (not yet enabled — kept boxed
    # for now). Defensive: when present, both arms must agree on
    # type and the cond must be raw-bool.
    EIf(cnd, ath, opt_eth) -> match opt_eth {
      Some(eth) -> {
        let cnd_c = emit_expr_raw(src, cnd, cx)
        let bcx = emit_ctx_tcpend_after(cx, cnd)
        let a_c = emit_expr_raw(src, ath, bcx)
        let b_c = emit_expr_raw(src, eth, bcx)
        concat_all(["(", cnd_c, " ? ", a_c, " : ", b_c, ")"])
      }
      None -> {
        let boxed = emit_expr_boxed(src, x, cx)
        unbox_border(boxed, x, x.ty)
      }
    }
    # Phase 3 unboxing — single-tail EBlock with no preceding
    # statements simply wraps a raw tail expression. Emit the
    # tail directly without the surrounding `({ ... })`.
    EBlock(stmts, opt_tail) -> match stmts {
      [] -> match opt_tail {
        Some(t) -> emit_expr_raw(src, t, cx)
        None -> {
          let boxed = emit_expr_boxed(src, x, cx)
          unbox_border(boxed, x, x.ty)
        }
      }
      # issue #779 — a multi-statement block with a raw tail (the unbox
      # pass marked it MUnboxed). Emit the statements then the raw tail
      # directly via `emit_block_raw`, dropping the box-then-unbox round-
      # trip. A region block (deep-copy-out) routes through the boxed
      # fallback — the unbox pass never marks one raw, so this is purely
      # defensive.
      _ -> match opt_tail {
        Some(t) ->
          if emit_block_is_region(cx, x.line, x.col) {
            let boxed = emit_expr_boxed(src, x, cx)
            unbox_border(boxed, x, x.ty)
          } else {
            emit_block_raw(src, stmts, t, cx)
          }
        None -> {
          let boxed = emit_expr_boxed(src, x, cx)
          unbox_border(boxed, x, x.ty)
        }
      }
    }
    # match-raw unboxing (asu design): a `match` whose result is
    # unboxable and whose every arm body is raw (marked MUnboxed by the
    # unbox pass) lowers with a RAW `_r` — each arm assigns the native
    # scalar directly, no `kai_int(...)` box then `kai_intf(...)` unbox.
    # The scrutinee axis is orthogonal (typically a boxed variant); only
    # the result is raw.
    EMatch(scr, arms) -> emit_match_raw(src, scr, arms, x.ty, emit_unw_scr_at(x, cx))
    # A promoted var cell: the read is the raw mutable local itself;
    # the init forwards its (literal) raw form.
    EIntrinsic(i, iargs) -> match i {
      InCellGet  -> cat2("kair_", emit_local_text(cx, cell_ref_local(iargs)))
      InCellInit -> match iargs {
        [init] -> emit_expr_raw(src, init, cx)
        _      -> "0 /* malformed cell init */"
      }
      InAbsent   -> "0"
      _ -> {
        let boxed = emit_expr_boxed(src, x, cx)
        unbox_border(boxed, x, x.ty)
      }
    }
    _ -> {
      # Anything else: emit boxed and unwrap. The unbox_pass should
      # not have marked these MUnboxed in the first place — defensive.
      let boxed = emit_expr_boxed(src, x, cx)
      unbox_border(boxed, x, x.ty)
    }
  }
}

# Phase 3 unboxing — when the callee `f` resolves to a UFn entry
# in the EFn table, emit the call against raw args without any
# `kai_<T>` wrap. Returns None when the callee is not a UFn. The
# caller (emit_kind_raw ECall arm) falls back to the boxed-then-
# unbox boundary form.

# Phase 3 unboxing — when the callee `f` resolves to a UFn entry
# in the EFn table, emit the call against raw args without any
# `kai_<T>` wrap. Returns None when the callee is not a UFn. The
# caller (emit_kind_raw ECall arm) falls back to the boxed-then-
# unbox boundary form.
# A raw call that can unwind registers the frame's pending references for
# its extent, as the boxed call does.
fn emit_ufn_raw_call_at(src: String, x: Expr, f: Expr, args_e: [Expr], cx: EmitCtx) : Option[String] / Console =
  match emit_ufn_raw_call(src, f, args_e, cx) {
    Some(call) -> match unw_call_of(cx.unw, x) {
      Some(names) -> Some(euw_call(call, emit_unw_vars(names, cx)))
      None        -> Some(call)
    }
    None -> None
  }

fn emit_ufn_raw_call(src: String, f: Expr, args_e: [Expr], cx: EmitCtx) : Option[String] / Console {

  match f.kind {
    ESym(s, inst) -> match fnx_callee(cx.fx, FnId(s, inst)) {
      # Mixed-param lane: only take the raw-call path when the callee
      # RETURNS raw (a raw context cannot consume a boxed result).
      # Args are still marshalled per the mask — boxed params pass
      # `KaiValue *`, raw params pass scalars.
      Some(EFn(n, _, mo, Some(US(ptys, rt, mask)), _)) ->
        if ty_is_unboxable_t(rt) {
          Some(emit_ufn_raw_call_go(src, f, c_sym(written_text(n), mo), args_e, mask, ptys, rt, cx))
        } else { None }
      _ -> None
    }
    _ -> None
  }
}

# Raw-return UFn call: plain when no arg carries the
# `__perceus_owned_borrow` mark; else bind each marked arg to a temp,
# call, and drop the temps after — the raw-context mirror of
# emit_call_with_owned_borrow_drops.
fn emit_ufn_raw_call_go(src: String, f: Expr, sym: String, args_e: [Expr], mask: [Bool], ptys: [Ty], rt: Ty, cx: EmitCtx) : String / Console {
  if emit_args_have_owned_borrow(args_e) {
    let hold = emit_ob_hold(f, args_e, emit_ctx_declaring(cx, emit_ob_names(args_e, 0)))
    let binds = emit_ob_binds(src, args_e, 0, cx)
    let raw_vals = emit_arg_vals_masked(src, emit_ob_rewrite_args(args_e, 0), mask, ptys, hold.cx)
    let drops = emit_ob_drops(args_e, 0)
    concat_all(["({ ", binds, hold.push, raw_c_type(Some(rt)), " _bcr = ", emit_user_call_seq(sym, raw_vals, hold.cx), "; ", hold.pop, drops, "_bcr; })"])
  } else {
    emit_user_call_seq(sym, emit_arg_vals_masked(src, args_e, mask, ptys, cx), cx)
  }
}

fn emit_expr(src: String, x: Expr, cx: EmitCtx) : String / Console {

  match x.mode {
    MUnboxed -> {
      # MUnboxed → MBoxed boundary: emit raw and wrap.
      let raw = emit_expr_raw(src, x, cx)
      box_wrap(x.ty, raw)
    }
    _ -> emit_expr_boxed(src, x, cx)
  }
}

# A declaration in value position: a constructor reads its seeded
# singleton, a function or a builtin its thunk's closure. A const has no
# storage: its initialiser is materialised inline at the use site, so the
# unbox pass treats a literal one exactly like the literal it stands for.
# An initialiser pasted here declares no local: one that does reached
# this pass as a call to its own function.
fn emit_sym_value(src: String, fid: FnId, cx: EmitCtx) : String / Console =
  match ctor_ix_row(cx.ctor_ix, fnid_sym(fid)) {
    Some(row) -> emit_nullary_read(row)
    None      -> match const_body_of(cx.consts, fnid_sym(fid)) {
      Some(body) -> emit_expr(src, body, cx)
      None       -> emit_ident_value(fid, cx)
    }
  }

# A local read in boxed position. A raw-bound binder is boxed on use from
# its raw alias, by the read's type: a raw `let` may hold a Bool or a
# Char, not only a kind-1 Int.
fn emit_local_value(l: LocalId, ty: Option[Ty], cx: EmitCtx) : String = {
  let name = emit_local_text(cx, l)
  if emit_ctx_kind1_raw_has(cx, l) {
    match ty { None -> cat3("kai_int(kair_", name, ")")  Some(_) -> box_wrap(ty, cat2("kair_", name)) }
  } else { c_local(name) }
}

fn emit_expr_boxed(src: String, x: Expr, cx: EmitCtx) : String / Console {

  match x.kind {
    ESym(s, inst) -> emit_sym_value(src, FnId(s, inst), cx)
    ELocal(l) -> emit_local_value(l, x.ty, cx)
    # A perform's callee is consumed by its call.
    EOp(_) -> "kai_core_panic(kai_str(\"unreachable: effect operation in value position\"))"
    EMark(m) -> c_local(mark_name(m))
    # Fix B (bidirectional list literals): when an Int literal is
    # checked against a Byte-context (e.g. inside `let bs: [Byte] = [65, 66]`),
    # the typer rewrites the node's ty to TyByte. Emit a Byte
    # constructor directly rather than `kai_int`. The 0..255 range
    # check has already happened at type-check time.
    EInt(n, _) -> match x.ty {
      Some(TyByte) -> cat3("kai_byte((uint8_t)", int_to_string(n), ")")
      _            -> cat3("kai_int(", int_to_string(n), "LL)")
    }
    EFixed(span, ty) -> fixed_box_c_lit(span, ty)
    EReal(r, _)     -> cat3("kai_real(", real_to_string(r), ")")
    # Textual literals are minted away by the typer; reaching emit is a bug.
    EIntLit(_)   -> panic("emit_expr_boxed: EIntLit must be minted before emit")
    ESurface(_)  -> panic("emit_expr_boxed: ESurface must be lowered before emit")
    EDecimalLit(_) -> panic("emit_expr_boxed: EDecimalLit must be minted before emit")
    EBool(b)     -> if b { "kai_bool(1)" } else { "kai_bool(0)" }
    EChar(c)     -> cat3("kai_char(", int_to_string(char_to_int(c)), ")")
    EStr(span, is_triple) -> emit_string_lit(span, is_triple)
    EUnit        -> "kai_unit()"
    EName(_)     -> panic("emit_expr_boxed: EName must be resolved before emit")
    EUnder       -> "kai_unit() /* _ */"
    EPlaceholder -> "kai_unit() /* placeholder */"
    ECall(f, args_e) -> emit_unw_call(src, x, f, args_e, emit_ctx_route_brand(cx, x.ty))
    EField(base, fname) -> {
      # #293 Phase 1.2 — record field access RC discipline.
      # `base` is owned by the time it lands here: perceus_pass wraps
      # non-last reads of in-scope EVar in __perceus_dup, single-use
      # reads transfer their ref, and ctor/call expressions return
      # rc=1. The field read increfs the field, so the base is no
      # longer reachable through the result. Drop it to balance.
      # A known record base reads by constant index (`kai_op_field_at`,
      # the desugar-canonicalised layout); else the `kai_op_field`
      # strcmp. Identical RC contract either way.
      #
      # Vec raw fuse: `vec_get(v, i).f` on an inline-record carrier
      # loads the scalar column directly — no boxed record is built,
      # so there is no base to drop. The helper's RC contract on
      # (v, i) matches the vec_get variant it replaces.
      match emit_vec_get_field_fused(src, base, fname, cx) {
        Some(code) -> code
        None -> {
      let b = emit_expr(src, base, cx)
      match field_index_of(cx.recs, base.ty, fname) {
        Some(n) -> concat_all([
          "({ KaiValue *_b = ", b,
          "; KaiValue *_f = kai_op_field_at(_b, ", int_to_string(n), "); kai_decref(_b); _f; })"
        ])
        None -> concat_all([
          "({ KaiValue *_b = ", b,
          "; KaiValue *_f = kai_op_field(_b, \"", fname, "\"); kai_decref(_b); _f; })"
        ])
      }
        }
      }
    }
    EIndex(_, _) -> "kai_unit() /* index: not used by bootstrap examples */"
    EBinop(op, a, b) -> {
      if binop_eq(op, BoAnd) {
        # m5.x flip Phase 3 closeout: `_a` is freshly allocated in
        # most call sites; under the runtime flip it would otherwise
        # leak — `kai_op_truthy` is non-consuming (the LLVM short-
        # circuit phi needs the value alive on the skip path) and
        # the C ternary returns either `<RHS>` or `kai_bool(0)`,
        # both fresh, so `_a` is never reused. Drop it via the
        # comma operator inside each branch.
        concat_all([
          "({ KaiValue *_a = ", emit_expr(src, a, cx),
          "; KaiValue *_r = kai_op_truthy(_a) ? ", emit_expr(src, b, cx),
          " : kai_bool(0); kai_decref(_a); _r; })"
        ])
      } else if binop_eq(op, BoOr) {
        concat_all([
          "({ KaiValue *_a = ", emit_expr(src, a, cx),
          "; KaiValue *_r = kai_op_truthy(_a) ? kai_bool(1) : ", emit_expr(src, b, cx), "; kai_decref(_a); _r; })"
        ])
      } else if binop_eq(op, BoConcat) {
        # m7d §23: lower `a ++ b` to either `string_concat(a, b)` or
        # `list_append(a, b)` depending on the binop's typed result.
        # The typer pins `x.ty` to `String` or `[T]` before we get
        # here; an untyped `++` is a typer bug we surface as a panic
        # stub so it shows up in fixtures.
        seq_call(cat2(concat_helper_of(x.ty), "("),
                 [emit_expr(src, a, cx), emit_expr(src, b, cx)], ")")
      } else if is_int_order_cmp(op, a, b) {
        # Direct Int order-comparison: both operands are Int, so skip the
        # boxed kai_op_lt/gt/le/ge (type-dispatch + boxed bool + truthy +
        # decref) and compare the raw values inline.
        #
        # Read each operand with `emit_expr_raw`: a raw param (`kair_k`)
        # emits the bare `int64_t` (no box, no unbox), a tagged slot value
        # reads through `kai_intf` (tagged-safe, no consume). This replaces
        # the old `kai_take_int(emit_expr(...))` which re-boxed a raw param
        # (`kai_take_int(kai_int(kair_k))`) and dup'd-then-took a tagged
        # value — box/unbox that cancelled. Ownership: emit_expr_raw does
        # NOT consume, so the operands' owning binders drop them at arm
        # exit exactly once (the prior dup+take was net-zero RC anyway).
        let c_op = match int_cmp_c_op(op) { Some(o) -> o None -> "<" }
        concat_all([
          "({ int64_t _la = ", emit_expr_raw(src, a, cx),
          "; int64_t _lb = ", emit_expr_raw(src, b, cx),
          "; kai_bool(_la ", c_op, " _lb); })"
        ])
      } else {
        match binop_cname(op) {
          Some(cn) -> seq_call(cat2(cn, "("), [emit_expr(src, a, cx), emit_expr(src, b, cx)], ")")
          None -> cat3("kai_unit() /* unknown binop: ", binop_text(op), " */")
        }
      }
    }
    EUnop(op, inner) -> concat_all([unop_cname(op), "(", emit_expr(src, inner, cx), ")"])
    EIf(c, a, opt_b) -> {
      # Tier 2.5 M4 — if the condition is already raw bool, skip
      # the `kai_op_truthy` wrapper and use the C ternary directly.
      # Issue #82: when the cond is boxed, capture it in a local and
      # decref after the ternary. `kai_op_truthy` is non-consuming
      # (the LLVM short-circuit phi keeps lhs alive on the skip path,
      # so the runtime predicate cannot blindly consume), and the
      # branches return either the then- or else-arm fresh value —
      # never `_c` itself — so dropping `_c` after the ternary is
      # safe and balances the fresh allocation that fed it.
      # A direct Int order-comparison condition (`if k < kx { }`) is a raw
      # C bool — emit it inline and use the C ternary, skipping the
      # `kai_op_truthy(kai_bool(...))` box/un-box round-trip. This fires
      # even though the comparison's `.mode` is MBoxed (the typer pins its
      # result type to Bool but does not unbox the node), so it must be
      # checked before the mode split. Load-bearing on the rb-tree descent.
      if expr_is_int_order_cmp(c) {
        let cc = emit_int_order_cmp_raw(src, c, cx)
        let bcx = emit_ctx_tcpend_after(cx, c)
        let tc = emit_expr(src, a, bcx)
        let ec = match opt_b {
          Some(eb) -> emit_expr(src, eb, bcx)
          None -> "kai_unit()"
        }
        concat_all(["(", cc, " ? ", tc, " : ", ec, ")"])
      } else { match c.mode {
        MUnboxed -> {
          let cc = emit_expr_raw(src, c, cx)
          let bcx = emit_ctx_tcpend_after(cx, c)
          let tc = emit_expr(src, a, bcx)
          let ec = match opt_b {
            Some(eb) -> emit_expr(src, eb, bcx)
            None -> "kai_unit()"
          }
          concat_all(["(", cc, " ? ", tc, " : ", ec, ")"])
        }
        _ -> {
          let cb = emit_expr(src, c, cx)
          let bcx = emit_ctx_tcpend_after(cx, c)
          let tc = emit_expr(src, a, bcx)
          let ec = match opt_b {
            Some(eb) -> emit_expr(src, eb, bcx)
            None -> "kai_unit()"
          }
          concat_all([
            "({ KaiValue *_c = ", cb,
            "; KaiValue *_r = kai_op_truthy(_c) ? ", tc, " : ", ec,
            "; kai_decref(_c); _r; })"
          ])
        }
      } }
    }
    EMatch(scr, arms) -> emit_match_expr(src, scr, arms, emit_unw_scr_at(x, cx))
    ELambda(_, _) -> emit_lambda_ref(x, cx)
    ERecordLit(_, fields) -> emit_rec_stamp(emit_record_lit(src, fields, emit_ctx_route_brand(cx, x.ty)), rec_stamp_of(cx.stamps, x.ty))
    EList(elems) -> emit_list_expr(src, elems, emit_ctx_route_brand(cx, x.ty))
    ERange(a, b, opt_step) -> emit_range_expr(src, a, b, opt_step, cx)
    EBlock(stmts, opt_final) -> {
      # A block recorded as a `region { }` lowers to a bump-arena scope.
      # `bcx` carries in_region = true so constructors lexically inside the
      # body bump-allocate into the arena; the block's value is deep-copied
      # OUT of the arena (rc=1) BEFORE the arena is freed (copy-before-pop is
      # load-bearing), so it survives. A non-region block emits the ordinary
      # statement-expression.
      let is_region = emit_block_is_region(cx, x.line, x.col)
      let bcx = if is_region { emit_ctx_with_in_region(cx, true) } else { cx }
      match stmts {
        [] -> match opt_final {
          Some(fe) ->
            if is_region {
              concat_all(["({ kai_arena_push(); ", region_copy_out(emit_expr(src, fe, bcx)),
                          " kai_arena_pop(); __rout; })"])
            } else { emit_expr(src, fe, cx) }
          None ->
            if is_region { "({ kai_arena_push(); kai_arena_pop(); kai_unit(); })" }
            else { "kai_unit()" }
        }
        _ -> {
          # m5 #3 — drops for unused let-bindings whose RHS is a
          # fresh allocation. See `block_unused_lets`. The set is
          # computed once per block so each let-binding's drop
          # decision considers all subsequent stmts and the trailing
          # final expression.
          let drops = block_unused_lets(stmts, opt_final)
          # Fold over stmts threading the scope: each `SLet(pat, _, _)`
          # extends `lcs` with `pat`'s binders for the later stmts and
          # the final expression.
          let stmt_acc = emit_block_stmts(src, stmts, drops, bcx)
          let stmt_out = match stmt_acc { EBSA(_, t, _, _) -> t }
          let block_cx = emit_ctx_after_block_stmts(cx, stmt_acc)
          if is_region {
            let final_in = match opt_final {
              Some(fe) -> emit_expr(src, fe, emit_ctx_with_in_region(block_cx, true))
              None -> "kai_unit()"
            }
            concat_all(["({ kai_arena_push(); ", stmt_out, " ", region_copy_out(final_in),
                        " kai_arena_pop(); __rout; })"])
          } else {
            let final_out = match opt_final {
              Some(fe) -> cat2(emit_expr(src, fe,
                                         emit_ctx_tcpend_after_stmts(block_cx, stmts)),
                               "; ")
              None -> "kai_unit(); "
            }
            cat4("({ ", stmt_out, final_out, "})")
          }
        }
      }
    }
    # The typer rewrites every pipe into the call it spells, so these arms
    # only keep the match exhaustive; reaching one is a typer bug.
    EPipe(_, _)        -> "kai_core_panic(kai_str(\"unreachable: EPipe survived typer\"))"
    EMapPipe(_, _)     -> "kai_core_panic(kai_str(\"unreachable: EMapPipe survived typer\"))"
    EFlatMapPipe(_, _) -> "kai_core_panic(kai_str(\"unreachable: EFlatMapPipe survived typer\"))"
    EFilterPipe(_, _)  -> "kai_core_panic(kai_str(\"unreachable: EFilterPipe survived typer\"))"
    EHole(nm_opt) -> {
      # Unfilled holes are runtime-panicky but syntactically valid:
      # the checker reports them and emission leaves a panic stub,
      # so a binary with holes is runnable — it just aborts loudly
      # on first reach.
      #
      # The panic message bundles location + inferred type + label
      # so the user (or an LLM driving the codebase) sees *what*
      # they have to fill in, not just "?":
      #
      #   unfilled hole: ?name at line 12 col 34, expected (Int) -> String
      #
      # When the hole is anonymous, we omit the `?<name>` segment.
      # When the typer never pinned a type (rare), we omit the type
      # segment. Location is always available because EHole carries
      # the parser-recorded line/col. The message stays ASCII so it
      # rides safely through the C `"..."` literal we emit below
      # (kaikai has no C-string escaper today).
      let label = match nm_opt { Some(nm) -> cat2("?", nm)  None -> "?" }
      let ty_seg = match x.ty {
        None    -> ""
        Some(t) -> cat2(", expected ", ty_to_string(cx.tab, t))
      }
      let loc = concat_all([" at line ", int_to_string(x.line), " col ", int_to_string(x.col)])
      let msg = concat_all(["unfilled hole: ", label, loc, ty_seg])
      concat_all(["kai_core_panic(kai_str(\"", msg, "\"))"])
    }
    ETodo(msg) -> {
      # m7d §1: `todo!(msg)` lowers to the same panic path as a hole
      # but with the user-supplied message, prefixed `todo: ` so the
      # binary's abort tag matches the source-form intent.
      let full = cat2("todo: ", msg)
      concat_all(["kai_core_panic(kai_str(\"", full, "\"))"])
    }
    # An extern-fn body is intercepted at the DFn level and replaced by
    # a shim; reaching it as an ordinary expression is a compiler bug.
    EExternBody(_, _) -> concat_all(["kai_core_panic(kai_str(\"extern body in expression position\"))"])
    EBang(inner) -> emit_bang(src, x, inner, cx)
    EHandle(body, eff, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) ->
      emit_handle(src, body, ref_sym(eff), inst_key_of_tes(rt_ref_name(cx.tab, eff), eff_tyargs), init_opt, alias_opt,
                  clauses, ret_opt, x.line, x.col, x.site, cx)
    # m12.5: codegen erasure — `1.0<USD>` emits the same C as `1.0`.
    # Units are typer-only; the generated value carries no unit tag.
    ELitUnit(inner, _) -> emit_expr(src, inner, cx)
    # m7e §11: `variants[T]()`. The typer baked the resolved
    # constructors into the AST node (synth_variants_of); here we
    # materialise them as a kai_cons spine of nullary constructors. Each
    # variant was validated as nullary at typing time.
    EVariantsOf(_, ctors) -> emit_variants_of_list(ctors, cx)
    # The resolver settles every qualified reference, so none reaches the
    # emitter; an unsettled one spells the C local of its name.
    EModCall(_, fname) -> c_local(written_text(fname))
    # A loop intrinsic emits an inline C loop: its cond/body lambdas are
    # pasted into the enclosing frame, so cell slots and locals are read
    # directly (no closure, no combinator call). Any other intrinsic in
    # value position should never reach emit_expr_boxed — the typer
    # rejects them outside the clause-body context where Stage 4 codegen
    # recognises them and emits a bridge.
    EIntrinsic(i, args_) -> match i {
      InLoopWhile   -> emit_loop_intrinsic(src, i, args_, cx)
      InLoopUntil   -> emit_loop_intrinsic(src, i, args_, cx)
      InLoopRepeat  -> emit_loop_intrinsic(src, i, args_, cx)
      InCellSet     -> emit_cell_set(src, i, args_, cx)
      InCellGet     -> box_wrap(x.ty, cat2("kair_", emit_local_text(cx, cell_ref_local(args_))))
      InResumeFrame -> emit_resume_frame(src, args_, cx)
      InSegHandle   -> emit_seg_handle(src, args_, cx)
      InSegRequest  -> emit_seg_request(src, args_, cx)
      InAbsent      -> "kai_unit()"
      _ -> cat3("kai_unit() /* unreachable: intrinsic $", intrinsic_name(i), " in value position */")
    }
  }
}

# The clause's tail after a non-tail `resume`, deferred to the handle's exit.
fn emit_resume_frame(src: String, args_: [Expr], cx: EmitCtx) : String / Console = match args_ {
  [f] -> cat3("kai_resume_frame_push(", emit_expr(src, f, cx), ")")
  _   -> "kai_unit() /* resume_frame: expected 1 arg */"
}

# A handle on a stack segment: the runtime runs the body thunk and calls the
# return and clause closures, consuming each.
fn emit_seg_handle(src: String, args_: [Expr], cx: EmitCtx) : String / Console = match args_ {
  [_, _, body, ret, ...cls] ->
    concat_all(["kai_seg_handle(", emit_expr(src, body, cx), ", ", seg_return(src, ret, cx), ", ",
                int_to_string(list_length(cls)), ", ", emit_value_array(src, cls, cx), ")"])
  _ -> "kai_unit() /* seg_handle: malformed */"
}

fn seg_return(src: String, ret: Expr, cx: EmitCtx) : String / Console = match ret.kind {
  EUnit -> "NULL"
  _     -> emit_expr(src, ret, cx)
}

fn emit_seg_request(src: String, args_: [Expr], cx: EmitCtx) : String / Console = match args_ {
  [ix, ...xs] -> match ix.kind {
    EInt(i, _) -> concat_all(["kai_seg_request(", int_to_string(i), ", ", int_to_string(list_length(xs)), ", ",
                              emit_value_array(src, xs, cx), ")"])
    _ -> "kai_unit() /* seg_request: malformed */"
  }
  [] -> "kai_unit() /* seg_request: malformed */"
}

fn emit_value_array(src: String, xs: [Expr], cx: EmitCtx) : String / Console = match xs {
  [] -> "(KaiValue *[]){ NULL }"
  _  -> concat_all(["(KaiValue *[]){ ", join(map(xs, (x) => emit_expr(src, x, cx)), ", "), " }"])
}

# ---- loop intrinsics (C-backend loop lowering) ----------------------
#
# RC inside the pasted bodies was computed under the closure discipline
# (in-lam reads dup, the outer frame keeps ownership and its exit drop),
# which is exactly the per-iteration balance an inline loop needs; the
# closure's create-incref / drop-decref pair vanishes together with the
# closure.

fn emit_loop_intrinsic(src: String, i: Intrinsic, args_: [Expr], cx: EmitCtx) : String / Console {

  match emit_loop_core(src, i, args_, cx) {
    Some(core) -> concat_all(["({ ", core, " kai_unit(); })"])
    None       -> emit_loop_bad(i)
  }
}

# The loop's C statement core (no value). Shared by the expression form
# (which appends the `kai_unit()` result) and the statement-discard form
# (which drops it — a loop's value is always unit).
fn emit_loop_core(src: String, i: Intrinsic, args_: [Expr], cx: EmitCtx) : Option[String] / Console {

  match i {
    InLoopWhile -> match args_ {
      [_, cnd, body] -> Some(concat_all([
        "for (;;) { ", emit_loop_cond_break(src, cnd, cx, false),
        " ", emit_loop_body_stmt(src, body, cx), " }"
      ]))
      _ -> None
    }
    InLoopUntil -> match args_ {
      [_, cnd, body] -> Some(concat_all([
        "for (;;) { ", emit_loop_body_stmt(src, body, cx),
        " ", emit_loop_cond_break(src, cnd, cx, true), " }"
      ]))
      _ -> None
    }
    InLoopRepeat -> match args_ {
      [_, n, body] -> Some(concat_all([
        "{ int64_t _lk = ", emit_loop_count(src, n, cx),
        "; for (; _lk > 0; _lk--) { ", emit_loop_body_stmt(src, body, cx),
        " } }"
      ]))
      _ -> None
    }
    _ -> None
  }
}

fn emit_loop_bad(i: Intrinsic) : String =
  cat3("kai_unit() /* malformed loop intrinsic $", intrinsic_name(i), " */")

# A promoted var cell's write: assign the raw mutable local. A raw
# value stores directly; a boxed value is unwrapped and consumed (the
# store owns it, and a raw local carries no RC to hand it to).
fn emit_cell_set(src: String, i: Intrinsic, args_: [Expr], cx: EmitCtx) : String / Console {

  let cell = cat2("kair_", emit_local_text(cx, cell_ref_local(args_)))
  match args_ {
    [_, v] -> match v.mode {
      MUnboxed -> concat_all(["({ ", cell, " = (", emit_expr_raw(src, v, cx), "); kai_unit(); })"])
      _ -> concat_all([
        "({ KaiValue *_cv = ", emit_expr(src, v, cx), "; ", cell, " = ",
        unbox_boxed_scalar("_cv", v.ty), "; kai_decref(_cv); kai_unit(); })"
      ])
    }
    _ -> cat3("kai_unit() /* malformed cell set $", intrinsic_name(i), " */")
  }
}

# The loop's condition check. `stop_when_true` selects the `until`
# polarity (exit when the predicate holds) vs `while` (exit when it
# stops holding). Mirrors the EIf condition tiers: raw int-order
# comparison, raw (unboxed) bool, then the boxed truthy path.
fn emit_loop_cond_break(src: String, cnd: Expr, cx: EmitCtx, stop_when_true: Bool) : String / Console {

  let cb = match cnd.kind { ELambda(_, b) -> b _ -> cnd }
  let neg = if stop_when_true { "" } else { "!" }
  if expr_is_int_order_cmp(cb) {
    concat_all(["if (", neg, "(", emit_int_order_cmp_raw(src, cb, cx), ")) break;"])
  } else { match cb.mode {
    MUnboxed -> concat_all(["if (", neg, "(", emit_expr_raw(src, cb, cx), ")) break;"])
    _ -> concat_all([
      "{ KaiValue *_lc = ", emit_expr(src, cb, cx),
      "; if (", neg, "kai_op_truthy(_lc)) { kai_decref(_lc); break; } kai_decref(_lc); }"
    ])
  } }
}

fn emit_loop_body_stmt(src: String, body: Expr, cx: EmitCtx) : String / Console {

  let bb = match body.kind { ELambda(_, b) -> b _ -> body }
  emit_stmt_discard_or_drop(src, bb, cx)
}

# --- statement-position discard ---------------------------------------
#
# A value-discarded expression (an SExprStmt, a loop body) emitted as a
# plain C statement: no discarded-value materialisation, no `kai_unit()`
# tails, no bind+decref of the unit singleton. Forms that cannot drop
# their value structurally return None and keep the bind+decref path,
# which preserves the owned-box release.

fn emit_expr_discard(src: String, x: Expr, cx: EmitCtx) : Option[String] / Console {

  match x.kind {
    EUnit -> Some("")
    EIntrinsic(i, args_) -> match i {
      InCellSet -> Some(emit_cell_set_discard(src, i, args_, cx))
      _         -> if is_loop_intrinsic(i) { emit_loop_core(src, i, args_, cx) } else { None }
    }
    EIf(c, t, e_opt) -> Some(emit_if_discard(src, c, t, e_opt, cx))
    EBlock(stmts, opt_final) ->
      if emit_block_is_region(cx, x.line, x.col) { None }
      else { emit_block_discard(src, stmts, opt_final, cx) }
    _ -> None
  }
}

fn emit_stmt_discard_or_drop(src: String, x: Expr, cx: EmitCtx) : String / Console {

  match emit_expr_discard(src, x, cx) {
    Some(s) -> s
    None ->
      if expr_is_perceus_drop_call(x) {
        cat3("{ KaiValue *_ = ", emit_expr(src, x, cx), "; (void) _; } ")
      } else {
        cat3("{ KaiValue *_ = ", emit_expr(src, x, cx), "; kai_decref(_); } ")
      }
  }
}

# A discarded cell write: assign the raw local, no unit materialisation.
fn emit_cell_set_discard(src: String, i: Intrinsic, args_: [Expr], cx: EmitCtx) : String / Console {

  let cell = cat2("kair_", emit_local_text(cx, cell_ref_local(args_)))
  match args_ {
    [_, v] -> match v.mode {
      MUnboxed -> concat_all([cell, " = (", emit_expr_raw(src, v, cx), "); "])
      _ -> concat_all([
        "{ KaiValue *_cv = ", emit_expr(src, v, cx), "; ", cell, " = ",
        unbox_boxed_scalar("_cv", v.ty), "; kai_decref(_cv); } "
      ])
    }
    _ -> cat3("/* malformed cell set $", intrinsic_name(i), " */ ")
  }
}

# A discarded `if`: a plain C `if` statement, each branch discarding its
# own value. Same condition tiers as the expression form (raw Int cmp,
# raw bool, boxed truthy); the boxed cond's decref moves before the
# branches — safe, `kai_op_truthy` is non-consuming and the branches
# never reference the condition value.
fn emit_if_discard(src: String, c: Expr, t: Expr, e_opt: Option[Expr], cx: EmitCtx) : String / Console {

  let bcx = emit_ctx_tcpend_after(cx, c)
  let tc = emit_stmt_discard_or_drop(src, t, bcx)
  let ec = match e_opt {
    Some(eb) -> concat_all([" else { ", emit_stmt_discard_or_drop(src, eb, bcx), "}"])
    None -> ""
  }
  if expr_is_int_order_cmp(c) {
    concat_all(["if (", emit_int_order_cmp_raw(src, c, cx), ") { ", tc, "}", ec, " "])
  } else { match c.mode {
    MUnboxed -> concat_all(["if (", emit_expr_raw(src, c, cx), ") { ", tc, "}", ec, " "])
    _ -> concat_all([
      "{ KaiValue *_c = ", emit_expr(src, c, cx),
      "; int _ct = kai_op_truthy(_c); kai_decref(_c); if (_ct) { ", tc, "}", ec, " } "
    ])
  } }
}

# A discarded non-region block: emit the statements and discard the tail
# in place. The lcs threading mirrors the expression form's block arm.
fn emit_block_discard(src: String, stmts: [Stmt], opt_final: Option[Expr], cx: EmitCtx) : Option[String] / Console {

  match stmts {
    [] -> match opt_final {
      Some(fe) -> Some(emit_stmt_discard_or_drop(src, fe, cx))
      None     -> Some("")
    }
    _ -> {
      let drops = block_unused_lets(stmts, opt_final)
      let stmt_acc = emit_block_stmts(src, stmts, drops, cx)
      let stmt_out = match stmt_acc { EBSA(_, t, _, _) -> t }
      let final_out = match opt_final {
        Some(fe) -> emit_stmt_discard_or_drop(src, fe,
                      emit_ctx_tcpend_after_stmts(emit_ctx_after_block_stmts(cx, stmt_acc), stmts))
        None -> ""
      }
      Some(cat4("{ ", stmt_out, final_out, "} "))
    }
  }
}

fn emit_loop_count(src: String, n: Expr, cx: EmitCtx) : String / Console {

  match n.mode {
    MUnboxed -> cat3("(", emit_expr_raw(src, n, cx), ")")
    _ -> cat3("({ KaiValue *_ln = ", emit_expr(src, n, cx),
              "; int64_t _lnv = kai_intf(_ln); kai_decref(_ln); _lnv; })")
  }
}

# m7e §11: emit a `[V0, V1, ..., Vn]` C list of nullary variant
# constructors. Mirrors emit_list_tail's cons-spine shape; uses the
# same kai_variant signature emit_ident_value uses for a bare
# nullary constructor reference.

# m7e §11: emit a `[V0, V1, ..., Vn]` C list of nullary variant
# constructors. Mirrors emit_list_tail's cons-spine shape; uses the
# same kai_variant signature emit_ident_value uses for a bare
# nullary constructor reference.
fn emit_variants_of_list(ctors: [SymId], cx: EmitCtx) : String {
  match ctors {
    [] -> "kai_nil()"
    [c, ...rest] -> {
      # A constructor the index lays out no row for keeps tag 0, as an
      # unregistered name did.
      let row = match ctor_ix_row(cx.ctor_ix, c) {
        Some(r) -> r
        None    -> EV(None, written_text(decl_name(cx.tab, c)), 0, [], 0)
      }
      match row {
        EV(_, n, _, _, tag) -> concat_all([
          "kai_cons(kai_variant_u(", int_to_string(tag),
          ", \"", n, "\", 0, 0, NULL), ",
          emit_variants_of_list(rest, cx), ")"
        ])
      }
    }
  }
}

# m7e §13 — lower `expr!` to a statement-expression that evaluates
# `inner`, returns the success payload, or short-circuits the
# enclosing C function with an early `return`. The discriminator
# (`Some` vs `Ok`) is chosen from `inner.ty`, which the typer
# stamped to `Option[_]` or `Result[_, _]` after substitution. Any
# other shape here is a typer bug — we fall back to a panic stub
# rather than emit silently-wrong C.

# m7e §13 — lower `expr!` to a statement-expression that evaluates
# `inner`, returns the success payload, or short-circuits the
# enclosing C function with an early `return`. The discriminator
# (`Some` vs `Ok`) is chosen from `inner.ty`, which the typer
# stamped to `Option[_]` or `Result[_, _]` after substitution. Any
# other shape here is a typer bug — we fall back to a panic stub
# rather than emit silently-wrong C.
fn emit_bang(src: String, x: Expr, inner: Expr, cx: EmitCtx) : String / Console {

  let inner_c = emit_expr(src, inner, cx)
  let success = bang_success_variant(inner.ty)
  let binders = match unw_exit_at(cx.unw.sites, x.site) {
    Some(ns) -> concat_all(map(emit_unw_vars(ns, cx), (v) => concat_all(["kai_decref(", v, "); "])))
    None     -> ""
  }
  let owed = cat2(binders, tcl_exit_drops(cx.tcpend))
  match success {
    Some(name) -> concat_all([
      "({ KaiValue *_b = ", inner_c, "; ",
      "if (!(_b && ", emit_variant_tag_test("_b", None, name, cx.variants), ")) { ", owed, "return _b; } ",
      "KaiValue *_p = kai_incref(kai_var_slots(_b)[0].ptr); kai_decref(_b); _p; })"
    ])
    None -> concat_all([
      "kai_core_panic(kai_str(\"internal: `!` on non-Option/Result reached emitter\"))"
    ])
  }
}

# `var`/State/Reader cells dispatch strictly by-id (`@<name>`); the typer
# never tags their ops with the `#<name>` capability-value path. So the
# `kai_<name> = &_node` alias node a `#` dispatch would read is dead for
# them, and emitting it collides with the user's own `kai_<name>` (a return
# param or the stateful prologue's `kai_state`/`kai_log`) inside one block.
fn alias_is_byid_cell(hsym: SymId) : Bool = effect_is(hsym, CeState) or effect_is(hsym, CeReader)

fn emit_handle(src: String, body: Expr, hsym: SymId, key: String, init_opt: Option[Expr],
               alias_opt: Option[Binder],
               clauses: [HClause],
               ret_opt: Option[HReturn], hline: Int, hcol: Int, hsite: Int,
               cx: EmitCtx) : String / Console {

  let body_c = emit_expr(src, body, emit_ctx_with_evf(cx, frame_shadow(cx.evf, cx.cur_enc_fn, key)))
  # The install site's own enclosing fn IS the handle's enc_fn — the
  # collector stamped `cur_enc_fn` on every clause it recorded here — so
  # the clause symbols resolve without a position lookup that would match
  # a homonymous handle in another module.
  let enc = cx.cur_enc_fn
  let assigns = emit_clause_assignments(clauses, enc, hline, hcol)
  # R9: gather every name any clause body of this handle captures
  # from the surrounding scope. Filtered against `lcs` so a name that
  # is *not* in scope at the install site (e.g. a top-level fn that
  # `fv_expr` already excluded via `globals` — defensive) does not
  # produce an undefined assign.
  let env_caps = list_filter_in(handle_captures_at(cx.cls, enc, hline, hcol), cx.lcs)
  let env_alloc = emit_handle_env_alloc(cx.locals, env_caps, enc, hline, hcol)
  let env_assign = emit_handle_env_ev_assign(env_caps)
  # An `as`-bound capability is exposed two ways inside the handle prologue:
  # `kaiv_alias_<a>_id` (the `_ev.handler_id`) backs the by-id dispatch a
  # `var`/State/Reader cell uses (`kai_evidence_lookup_node_by_id`, tag `@<a>`);
  # `kai_<a>` (the node `&_node` itself) backs the §6 capability dispatch a user
  # effect's named instance uses (`a.op(...)`, `f(a)`). The typer tags an op with
  # `@` or `#`; a by-id cell never gets `#`, so its `kai_<a>` node is dead — and
  # emitting it collides with the user's own `kai_<a>` (a return param or the
  # stateful prologue's `kai_state`/`kai_log`). Emit the node only for non-cells.
  let alias_id_c = match alias_opt {
    Some(b) -> {
      let a = written_text(b.name)
      let id_bind = concat_all(["KaiHandlerId ", c_alias_id(a), " = _ev.handler_id; "])
      if alias_is_byid_cell(hsym) { id_bind }
      else { concat_all([id_bind, "KaiValue *", c_local(a), " = (KaiValue *) &_node; "]) }
    }
    None -> ""
  }
  let init_c = match init_opt {
    Some(ie) -> concat_all(["_ev.state = ", emit_expr(src, ie, cx), "; "])
    None     -> ""
  }
  let stateful = match init_opt { Some(_) -> true None -> false }
  let exit = match ret_opt {
    Some(r) -> match r {
      HR(rb, rexpr, _, _) -> {
        # A stateful handler's return clause sees the state aliases too
        # (so `return(x) -> (x, state)` works). The clause is emitted
        # inline in the enclosing function, so an alias whose name is
        # already an enclosing local keeps that local: redeclaring it
        # would shadow the user's binding in the same C block.
        let live = clause_live_aliases(stateful, (key) => is_some(emit_scope_spelled(cx, key)))
        let prologue = concat_all(map(live, (nm) => "KaiValue *#{c_local(nm)} = _ev.state; "))
        let rcx = EmitCtx { ...cx, locals: locals_declaring(cx.locals, live) }
        HandleExit {
          decl: "KaiValue *_hr; ",
          normal: concat_all(["{ KaiValue *", c_local(written_text(rb.name)), " = _body_result; ", prologue,
                              "_hr = ", emit_expr(src, rexpr, rcx), "; } "]),
          discard: "_hr = _discard; ",
          merge: ""
        }
      }
    }
    None -> HandleExit { decl: "", normal: "", discard: "_body_result = _discard; ",
                         merge: "KaiValue *_hr = _body_result; " }
  }
  # Below the landing pad's mark: the references that outlive the handle
  # and the state slot, released only by an exit that passes the handle.
  let uw = emit_unw_handle(hsite, stateful, cx)
  # The Ev owns its final state; both exits (normal and discard) meet
  # here, after the return clause has read it.
  let frames_c = if rs_clauses_push_frames(clauses) { "_hr = kai_resume_frames_run(&_node, _hr); " } else { "" }
  let ret_c = concat_all([exit.merge, frames_c, uw.pop, if stateful { "kai_decref(_ev.state); " } else { "" }, "_hr;"])
  # If a clause discards `resume`, the op-call site unwinds the evidence
  # past this handle's node and longjmps here; the discarded value is
  # the handle's result as is, so the return clause does not run.
  # Push uses the *_with_jmp variant so the op site can find the
  # jmp via the looked-up KaiEvidence node.
  # issue #501: `_discard` is volatile-qualified because it is a local
  # automatic written between `setjmp` and `longjmp` (the op-call
  # discard branch stores the clause's return value into
  # `*_node->discard_slot`, which aliases `&_discard`). Per C99
  # §7.13.2.1 such a local has indeterminate value after `longjmp`
  # unless it has volatile-qualified type — under `-O2` the else
  # branch otherwise reads a stale NULL and the consumer segfaults.
  # `_setjmp`, not `setjmp`: saving the signal mask is a syscall per handle
  # entry on macOS, and nothing restores a mask through a handle's jump.
  let evn = ev_name_of(cx.tab, cx.effs, hsym)
  # `finally { }`: armed on the node so every unwind path runs it, and
  # called explicitly on the normal exit (which never touches the node).
  # `cleanup_done` makes the pair idempotent when both fire.
  let fin_c = match find_finally_clause(clauses) {
    Some(_) -> {
      let thunk = user_cleanup_sym(enc, hline, hcol)
      Cleanup {
        arm: concat_all(["kai_evidence_set_cleanup(&_node, &", thunk, ", (void *) &_ev); "]),
        run: concat_all(["kai_evidence_run_cleanup(&_node); "])
      }
    }
    None -> Cleanup { arm: "", run: "" }
  }
  concat_all([
    "({ ", evn, " _ev = {0}; ",
    "_ev.handler_id = kai_fresh_handler_id(); ",
    assigns,
    uw.vars,
    init_c,
    uw.state,
    env_alloc,
    env_assign,
    "KaiEvidence _node; ",
    "jmp_buf _jmp; ",
    "KaiValue * volatile _discard = NULL; ",
    "KaiValue *_body_result; ",
    exit.decl,
    alias_id_c,
    "if (_setjmp(_jmp) == 0) { ",
      "kai_evidence_push_with_jmp(&_node, \"", key, "\", &_ev, &_jmp, (KaiValue **) &_discard); ",
      fin_c.arm,
      "_body_result = ", body_c, "; ",
      fin_c.run,
      "kai_evidence_pop(); ",
      exit.normal,
    "} else { ",
      exit.discard,
    "} ",
    ret_c,
    " })"
  ])
}

type Cleanup = { arm: String, run: String }

# Where a handle's two exits meet. Only the normal exit passes through
# the return clause; a discarded value is the handle's result as is.
type HandleExit = { decl: String, normal: String, discard: String, merge: String }

type UnwHandleC = { vars: String, state: String, pop: String }

fn emit_unw_handle(hsite: Int, stateful: Bool, cx: EmitCtx) : UnwHandleC =
  match unw_handle_at(cx.unw.sites, hsite) {
    None -> UnwHandleC { vars: "", state: "", pop: "" }
    Some(names) -> {
      let vars = emit_unw_vars(names, cx)
      let pop_vars = match vars { [] -> "" _ -> euw_pop("_uwh") }
      if stateful {
        UnwHandleC { vars: euw_vars_push("_uwh", vars), state: euw_slot_push("_uws", "_ev.state"),
                     pop: cat2(euw_pop("_uws"), pop_vars) }
      } else {
        UnwHandleC { vars: euw_vars_push("_uwh", vars), state: "", pop: pop_vars }
      }
    }
  }

# The lifecycle `finally { }` only — an op clause that happens to be named
# `finally` is not one.
fn find_finally_clause(cs: [HClause]) : Option[HClause] {
  match cs {
    [] -> None
    [c, ...rest] -> match c {
      HC(h, _, _, _, _) ->
        if is_lifecycle_clause(h) { Some(c) }
        else { find_finally_clause(rest) }
    }
  }
}

# R9: keep only the captures that are actually in scope at the install
# site. `handle_captures_at` returns the union of every clause's
# `fv_expr` result; `lcs` is the list of locals visible to
# `emit_handle`. The install code reads each capture as a local
# `kai_<name>` to populate the env struct, so a binder not in `lcs`
# would expand to an undeclared identifier.
fn list_filter_in(caps: [Capture], lcs: [LocalId]) : [Capture] {
  match caps {
    [] -> []
    [h, ...rest] ->
      if env_cap_in_scope(lcs, h) { [h, ...list_filter_in(rest, lcs)] }
      else { list_filter_in(rest, lcs) }
  }
}

# R9 install side: allocate one env struct per handle (zero-init,
# stack-allocated inside the handle's stmt-expression), populate one
# field per capture, and stash a `void *` pointer in `_ev.env`. Empty
# when the handle has no captures — the EvE's `env` slot stays NULL
# and clause prologues never read it. The emitted env-struct typedef
# is minted once per (line, col) pair by `emit_handle_env_typedefs`
# at top level, and lives ahead of every clause forward in the
# generated C.

# R9 install side: allocate one env struct per handle (zero-init,
# stack-allocated inside the handle's stmt-expression), populate one
# field per capture, and stash a `void *` pointer in `_ev.env`. Empty
# when the handle has no captures — the EvE's `env` slot stays NULL
# and clause prologues never read it. The emitted env-struct typedef
# is minted once per (line, col) pair by `emit_handle_env_typedefs`
# at top level, and lives ahead of every clause forward in the
# generated C.
fn emit_handle_env_alloc(ns: LocalNames, caps: [Capture], enc_fn: String,
                          hline: Int, hcol: Int) : String {
  match caps {
    [] -> ""
    _ -> {
      let env_name = handle_env_struct_name(enc_fn, hline, hcol)
      concat_all([
        env_name, " _env = {0}; ",
        emit_handle_env_field_assigns(ns, caps)
      ])
    }
  }
}

fn emit_handle_env_field_assigns(ns: LocalNames, caps: [Capture]) : String {
  match caps {
    [] -> ""
    [c, ...rest] -> concat_all([
      "_env.", c_local(capture_text(ns, c)), " = ", handle_env_field_value(ns, c), "; ",
      emit_handle_env_field_assigns(ns, rest)
    ])
  }
}

# A handler-id capture rides the env boxed, like a lambda's.
fn handle_env_field_value(ns: LocalNames, c: Capture) : String = match c {
  CapAlias(a) -> concat_all(["kai_int((int64_t) ", c_alias_id(written_text(ln_text(ns, a))), ")"])
  CapLocal(l) -> c_local(written_text(ln_text(ns, l)))
}

fn clause_env_read(ns: LocalNames, c: Capture) : String = match c {
  CapAlias(a) -> concat_all(["    KaiHandlerId ", c_alias_id(written_text(ln_text(ns, a))),
                             " = (KaiHandlerId) kai_intf(_env->", c_local(capture_text(ns, c)), ");\n"])
  CapLocal(_) -> concat_all(["    KaiValue *", c_local(capture_text(ns, c)), " = _env->", c_local(capture_text(ns, c)), ";\n"])
}

# An `@<a>` tag only exists under the handle binding `kai_alias_<a>_id`.
fn env_cap_in_scope(lcs: [LocalId], c: Capture) : Bool = match c {
  CapAlias(_) -> true
  CapLocal(l) -> locals_have(lcs, l)
}

fn emit_handle_env_ev_assign(caps: [Capture]) : String {
  match caps {
    [] -> ""
    _  -> "_ev.env = (void *) &_env; "
  }
}

# Install code mints `_ev.<op> = &<clause_sym>;`, which must name the C
# function emitted for the clause body. Both ends mint via
# `user_clause_sym(enc, ...)` off the SAME enclosing fn: the collector
# stamps it on each `ClauseInfo`, and the install site passes its own.
fn emit_clause_assignments(cs: [HClause],
                           enc: String, hline: Int, hcol: Int) : String {
  match cs {
    [] -> ""
    [c, ...rest] -> match c {
      HC(head, _, _, _, _) ->
        # `finally` is not an op: it has no `Ev` slot and is wired to the
        # evidence node instead.
        if is_lifecycle_clause(head) {
          emit_clause_assignments(rest, enc, hline, hcol)
        } else {
          let op_name = clause_head_word(head)
          concat_all([
            "_ev.", op_name, " = &", user_clause_sym(enc, hline, hcol, op_name), "; ",
            emit_clause_assignments(rest, enc, hline, hcol)
          ])
        }
    }
  }
}

fn expr_is_perceus_drop_call(x: Expr) : Bool {
  match x.kind {
    ECall(callee, _) -> match callee.kind {
      EMark(m) -> mark_is_drop(m)
      _ -> false
    }
    _ -> false
  }
}

fn emit_stmt(src: String, s: Stmt, cx: EmitCtx) : String / Console {

  match s {
    SLet(pat, _, rhs) -> emit_let_stmt_with_drops(src, pat, rhs, [], cx)
    SAssert(cond, opt_msg) -> emit_assert_stmt(src, cond, opt_msg, cx)
    # A discarded expression emits as a plain C statement where the form
    # allows (cell writes, ifs, blocks, loops — no unit materialisation),
    # else binds and decrefs the discarded value. `__perceus_drop` skips
    # even the decref: `kai_internal_drop` returns the unit singleton.
    SExprStmt(x) -> emit_stmt_discard_or_drop(src, x, cx)
    # m7b #6: index-assign desugars away pre-resolve; this arm is dead
    # code in normal compilation but keeps the match exhaustive.
    SIndexAssign(_, _, _, _, _) -> "/* SIndexAssign: should have been desugared */ "
    SAssign(_, _, _, _) -> "/* SAssign: should have been lowered */ "
    # m7b #5: `var name = init` desugars away pre-resolve; this arm
    # is dead code in normal compilation but keeps the match exhaustive.
    SVar(_, _, _, _, _) -> "/* SVar: should have been desugared */ "
    # m7e §25: `use Effect` stmt desugars away pre-resolve. Dead code
    # in normal compilation; emit a comment for debug visibility.
    SUse(_, _, _) -> "/* SUse: should have been desugared */ "
  }
}

# m14 v1.x — fold over a block's stmts threading the local-name
# scope. After each `SLet(pat, _, _)`, the pattern's binders are
# appended to `lcs` so subsequent stmts (and the trailing final
# expression) see them as locals. Other stmt forms (`SAssert`,
# `SExprStmt`, dead `SVar` / `SUse` / `SIndexAssign`) are scope-
# neutral. The accumulated `lcs` and the raw-declared subset are returned
# alongside the concatenated C output so the caller can scope the final
# expression with both.
type EmitBlockStmtsAcc = EBSA([LocalId], String, [LocalId], [LocalId])

# Re-scope `cx` to a finished block's statement scope: the locals it bound
# AND the subset of them declared raw (`kair_`). The trailing expression of
# a block reads both, so applying only `lcs` sends a raw binder's read to a
# `kaiv_` that was never declared.
fn emit_ctx_after_block_stmts(cx: EmitCtx, acc: EmitBlockStmtsAcc) : EmitCtx =
  match acc { EBSA(l, _, k, own) -> emit_unw_own(own, emit_ctx_with_kind1_raw(emit_ctx_with_lcs(cx, l), k)) }

fn emit_block_stmts(src: String, stmts: [Stmt], drops: [LocalId],
                    cx: EmitCtx) : EmitBlockStmtsAcc / Console =
  emit_block_stmts_loop(src, stmts, drops, cx, "", [])

fn emit_block_stmts_loop(src: String, stmts: [Stmt], drops: [LocalId],
                          cx: EmitCtx,
                          acc: String, own: [LocalId]) : EmitBlockStmtsAcc / Console = match stmts {

  [] -> EBSA(cx.lcs, acc, cx.kind1_raw, own)
  [s, ...rest] -> {
    let out = emit_stmt_with_drops(src, s, drops, cx)
    let lcs1 = match s {
      SLet(pat, _, _) -> list_append(cx.lcs, pat_local_ids(pat))
      _ -> cx.lcs
    }
    let k1 = stmt_kind1_raw_after(s, cx.kind1_raw, cx)
    let mine = emit_unw_let_owned(s, cx)
    emit_block_stmts_loop(src, rest, drops, emit_unw_own(mine, emit_ctx_with_kind1_raw(emit_ctx_with_lcs(cx, lcs1), k1)),
                          string_concat(acc, out), list_append(mine, own))
  }
}

# The raw binders in scope after `s`: a `let` binder declared `kair_<nm>`
# (an MUnboxed rhs, or a kind-1 slot of a destructuring pattern) has no
# boxed `kaiv_<nm>` local, so later reads resolve through `kind1_raw`
# exactly as an arm binder does. Every other binder the `let` introduces
# is a real `kaiv_<nm>`; an outer raw one it shadows is another binder.
fn stmt_kind1_raw_after(s: Stmt, ks: [LocalId], cx: EmitCtx) : [LocalId] = match s {
  SLet(pat, _, rhs) -> match pat.pkind {
    PBind(b) -> match rhs.mode {
      MUnboxed -> if locals_have(ks, b.id) { ks } else { [b.id, ...ks] }
      _        -> list_drop_local(ks, b.id)
    }
    _ -> pat_kind1_binders(pat, cx, list_drop_locals(ks, pat_local_ids(pat)))
  }
  _ -> ks
}

fn list_drop_locals(ls: [LocalId], targets: [LocalId]) : [LocalId] = match targets {
  [] -> ls
  [t, ...rest] -> list_drop_locals(list_drop_local(ls, t), rest)
}

fn list_drop_local(ls: [LocalId], target: LocalId) : [LocalId] = match ls {
  [] -> []
  [n, ...rest] ->
    if local_eq(n, target) { list_drop_local(rest, target) }
    else { [n, ...list_drop_local(rest, target)] }
}

# m5 #3 — emit_stmt variant that consults the per-block drop set.
# Only `SLet` is augmented; the other stmt forms route through the
# original `emit_stmt` path. The set is the result of
# `block_unused_lets`, so a name only appears here when it is safe
# to decref immediately after the let.

# m5 #3 — emit_stmt variant that consults the per-block drop set.
# Only `SLet` is augmented; the other stmt forms route through the
# original `emit_stmt` path. The set is the result of
# `block_unused_lets`, so a name only appears here when it is safe
# to decref immediately after the let.
fn emit_stmt_with_drops(src: String, s: Stmt, drops: [LocalId],
                        cx: EmitCtx) : String / Console {

  match s {
    SLet(pat, _, rhs) ->
      emit_let_stmt_with_drops(src, pat, rhs, drops, cx)
    _ -> emit_stmt(src, s, cx)
  }
}

fn emit_let_stmt_with_drops(src: String, pat: Pattern, rhs: Expr,
                             drops: [LocalId],
                             cx: EmitCtx) : String / Console {

  match pat.pkind {
    # Tier 2.5 — raw scalar binding. The unbox pass marked the
    # rhs `MUnboxed`, which means this binding is stored as a raw
    # C scalar (no `KaiValue *`). RC bookkeeping does not apply
    # — the local lives on the C stack and dies at block exit.
    PBind(b) -> {
      let name = written_text(b.name)
      # A binder in scope spelled like this one is the same C variable.
      let shadows = locals_have(cx.lcs, b.id) or is_some(emit_scope_spelled(cx, name))
      match rhs.mode {
        MUnboxed -> {
          let raw = emit_expr_raw(src, rhs, cx)
          let cty = raw_c_type(rhs.ty)
          # A shadowing `let x = f(x)`: the C declarator puts the new `kair_x`
          # in scope inside its own initializer, so evaluate into a temp first.
          if shadows {
            let tmp = shadow_tmp(name, pat)
            concat_all([cty, " ", tmp, " = ", raw, "; ", cty, " kair_", name, " = ", tmp, "; "])
          } else { concat_all([cty, " kair_", name, " = ", raw, "; "]) }
        }
        _ -> {
          let rhs_c = emit_expr(src, rhs, cx)
          let bind = if shadows {
            let tmp = shadow_tmp(name, pat)
            concat_all(["KaiValue *", tmp, " = ", rhs_c, "; KaiValue *", c_local(name), " = ", tmp, "; "])
          } else { concat_all(["KaiValue *", c_local(name), " = ", rhs_c, "; "]) }
          if locals_have(drops, b.id) {
            cat2(bind, concat_all(["kai_decref(", c_local(name), "); "]))
          } else {
            bind
          }
        }
      }
    }
    # `let _ = expr` discards the value: a plain C statement where the
    # form allows (a cell write, an if, a block — no unit
    # materialisation), else bind + decref (#293 Phase 2.1: emit_expr
    # returns an owned reference, so the discard site decrefs).
    PWild -> emit_stmt_discard_or_drop(src, rhs, cx)
    _ -> {
      # Binds land in the enclosing block so the names stay in scope for
      # its rest; the binds incref (alias=true) and the composite drops.
      let rhs_c = emit_expr(src, rhs, cx)
      let tmp = concat_all(["_letv_", int_to_string(pat.line), "_",
                              int_to_string(pat.col)])
      let binds = emit_pat_binds(src, pat, tmp, false, true, cx)
      concat_all(["KaiValue *", tmp, " = ", rhs_c, "; ", binds, "kai_decref(", tmp, "); "])
    }
  }
}

# A unique C temp for a shadowing `let`'s RHS — the (line, col) suffix
# disambiguates nested shadows, the same scheme the destructuring-let temp
# (`_letv_<line>_<col>`) uses. The leading `_shadow_` cannot collide with a
# surface binder's `kair_`/`kai_` name.
fn shadow_tmp(name: String, pat: Pattern) : String =
  concat_all(["_shadow_", name, "_", int_to_string(pat.line), "_", int_to_string(pat.col)])

fn emit_assert_stmt(src: String, cond: Expr, opt_msg: Option[Expr],
                    cx: EmitCtx) : String / Console {

  # kai_assert_check consults kai_test_in_progress at runtime and either
  # aborts (outside a test) or longjmps to the test harness (inside one),
  # so the emitter doesn't need to know whether it's in test mode.
  # m12.6.x #8: when opt_msg is a literal string (e.g. the contract-
  # desugar's "requires violated at line N"), embed its span as a C
  # literal so the panic shows the contract context instead of the
  # generic "assertion failed". Non-literal msgs fall back to the
  # generic — runtime evaluation of an arbitrary Expr to a C string
  # would need a kai_to_cstring helper that doesn't exist.
  # cond is emitted EXACTLY once; `cc` is reused for both the plain and
  # the value-carrying call. Never re-emit a sub-expression (a second
  # emit_expr would double-evaluate side effects and double-decref under
  # Perceus).
  let cc = emit_expr(src, cond, cx)
  let msg_lit = match opt_msg {
    Some(m) -> match m.kind {
      EStr(span, false) -> span
      _ -> "\"assertion failed\""
    }
    None -> "\"assertion failed\""
  }
  match assert_reported_binding(cond, opt_msg) {
    # The value is captured BEFORE the condition: the comparison helpers
    # consume the binding's local, and C leaves argument order unspecified.
    Some(CtrId(l, idnode, lit)) -> {
      let ident = emit_local_text(cx, l)
      concat_all(["({ KaiValue *_av = ", emit_contract_value_arg(ident, idnode, lit), "; ",
                  "kai_assert_check_with_value(", cc, ", ", msg_lit, ", ",
                  reported_binding_span(ident), ", _av); }); "])
    }
    None -> concat_all(["kai_assert_check(", cc, ", ", msg_lit, "); "])
  }
}

# Build the owned `KaiValue*` value argument for
# `kai_assert_check_with_value`. The helper CONSUMES `val`, so:
#   - boxed local  → `kai_incref(kai_<ident>)` transfers a fresh ref the
#     helper consumes, leaving the local's own ref (and any Perceus drop)
#     untouched.
#   - raw-unboxed local → `box_wrap` mints a fresh `kai_real`/`kai_int`
#     box from the raw scalar `kair_<ident>`.
# The *repr* (which local name exists) comes from the ident node's own
# `mode` — the exact value `emit_expr` consults for this same node, so
# the two agree on `kair_` vs `kai_`. The literal's `ty` is the box-type
# oracle for the raw case (a dup-wrapped ident node's `ty` may be blank,
# the literal's never is). A boxed local in a raw comparison (e.g. a
# `Char` param compared via a raw `!=`) still reads from `kai_<ident>`
# because the binding's storage is boxed regardless of the comparison's
# lowering.
fn emit_contract_value_arg(ident: String, idnode: Expr, lit: Expr) : String {
  match idnode.mode {
    MUnboxed -> box_wrap(lit.ty, cat2("kair_", ident))
    _        -> cat3("kai_incref(", c_local(ident), ")")
  }
}

# ---- declaration emission ----

# m7a #6a: emit the `Ev<Eff>` struct per `effect Eff { ops }` decl,
# per docs/effects-impl.md §*Surface-to-runtime mapping*. Each op
# becomes a plain function-pointer field with `*Self` as the implicit
# first argument, the surface op args next, and a trailing `KaiCont
# *k` (the reified continuation). m7a #6a only emits the type; m7a
# #6b populates an EvE at handle entry, m7a #6c calls through it.

# m7a #6a: emit the `Ev<Eff>` struct per `effect Eff { ops }` decl,
# per docs/effects-impl.md §*Surface-to-runtime mapping*. Each op
# becomes a plain function-pointer field with `*Self` as the implicit
# first argument, the surface op args next, and a trailing `KaiCont
# *k` (the reified continuation). m7a #6a only emits the type; m7a
# #6b populates an EvE at handle entry, m7a #6c calls through it.
fn emit_op_fn_ptr_args(params: [Param]) : String {
  match params {
    [] -> ""
    _  -> cat2(", ", join_with(map(params, (pm) => cat2("KaiValue *", c_local(written_text(pm.binder.name)))), ", "))
  }
}

# The C struct/identity name for an effect's evidence. Module-
# qualified like a type's `c_sym`, so two same-name effects from
# different modules (two same-named user effects) emit
# distinct `Ev` structs and register/look up under distinct names.
# The single source of truth for the name — struct def, the perform
# cast + runtime lookup, the clause fn param, and the default install
# all route through this so they stay in lockstep.
pub fn ev_name(name: String, mo: Option[String]) : String =
  string_concat("Ev", c_sym(name, mo))

fn emit_op_fn_ptr(ev_n: String, op: EffectOp) : String {
  match op {
    EffOp(op_name, _, params, _, _, _) ->
      concat_all([
        "    KaiValue *(*", op_name, ")(", ev_n, " *self",
        emit_op_fn_ptr_args(params),
        ", KaiCont *k);\n"
      ])
  }
}

# The runtime dispatches a user `Cancel` clause itself, so the builtin
# Cancel's evidence is the runtime's own struct: the clause is then
# called through its exact function type.
fn emit_effect_struct(d: Decl, tab: SymTab) : String {
  match d {
    DEffect(_, esym, _tparams, ops, _, _, _, mo) -> {
      let evn = ev_name(rt_name(tab, esym), mo)
      let fields = concat_all(map(ops, (op) => emit_op_fn_ptr(evn, op)))
      if effect_is(esym, CeCancel) { concat_all(["typedef KaiRtEvCancel ", evn, ";\n\n"]) }
      else { concat_all([
        "typedef struct ", evn, " ", evn, ";\n",
        "struct ", evn, " {\n",
        "    KaiHandlerId handler_id;\n",
        "    void *env;\n",
        # m7b #11: every Ev struct carries a `state` slot for parameter-
        # ised handlers (`with State[T](init)` / `with Writer[W]([])`).
        # Stateless handlers leave it NULL — cost is one pointer per
        # handler instance; benefit is a uniform clause-body shape.
        "    KaiValue *state;\n",
        fields,
        "};\n\n"
      ]) }
    }
    _ -> ""
  }
}

fn effect_struct_decls(decls: [Decl], tab: SymTab) : String =
  concat_all(map(decls, (d) => emit_effect_struct(d, tab)))

# m7c-a — LLVM equivalent of `emit_effect_struct`. Emits an
# `%EvX = type { i64, i8*, %KaiValue*, fn-ptrs... }` where the
# leading three fields mirror the C layout (handler_id, env,
# state slot) and each op contributes one function pointer.
# Doc C §m7c assumes the LLVM backend uses the same on-the-heap
# layout as the C backend so the runtime helpers can see both
# without translation.

# m7c-a — LLVM equivalent of `emit_effect_struct`. Emits an
# `%EvX = type { i64, i8*, %KaiValue*, fn-ptrs... }` where the
# leading three fields mirror the C layout (handler_id, env,
# state slot) and each op contributes one function pointer.
# Doc C §m7c assumes the LLVM backend uses the same on-the-heap
# layout as the C backend so the runtime helpers can see both
# without translation.
fn emit_param_list(params: [Param]) : String {
  match params {
    [] -> "void"
    _ -> join_with(map(params, (pm) => cat2("KaiValue *", c_local(written_text(pm.binder.name)))), ", ")
  }
}

# Phase 3 unboxing — emit the raw parameter list for a UFn.
# Each parameter is a raw C scalar named `kair_<pname>`, which is what
# an MUnboxed read of the param spells.
fn emit_param_list_unboxed(params: [Param], param_tys: [Ty]) : String {
  match params {
    [] -> "void"
    _ -> join_with(emit_param_list_unboxed_each(params, param_tys, []), ", ")
  }
}

fn emit_param_list_unboxed_each(params: [Param], tys: [Ty], acc: [String]) : [String] {
  match params {
    [] -> list_reverse(acc)
    [p, ...rest] -> {
      let pty = match tys {
        [t, ...trest] -> t
        []            -> param_ty(p)
      }
      let trest = match tys {
        [_, ...r] -> r
        []        -> []
      }
      let entry = concat_all([raw_c_type(Some(pty)), " kair_", written_text(p.binder.name)])
      emit_param_list_unboxed_each(rest, trest, [entry, ...acc])
    }
  }
}

# The hidden evidence-frame param. A fn whose row demands a
# transported user effect takes `KaiEvidence **__evf` as its FIRST param
# (the Koka evidence vector); the call site fills each slot. Empty when the
# fn carries no transported effect (the legacy by-name walk serves it).
fn evf_param_decl(slots: [String]) : String = match slots {
  [] -> ""
  _  -> "KaiEvidence **__evf"
}

# Prepend the frame param to a C param list, joining with the user params.
fn evf_join_params(frame_decl: String, rest: String) : String =
  if frame_decl == "" { rest }
  else if rest == "void" { frame_decl }
  else { concat_all([frame_decl, ", ", rest]) }

fn emit_fn_signature_evf(name: String, params: [Param], slots: [String]) : String =
  cat5("static KaiValue *", c_user_sym(name), "(", evf_join_params(evf_param_decl(slots), emit_param_list(params)), ")")

fn emit_fn_signature(name: String, params: [Param]) : String =
  cat5("static KaiValue *", c_user_sym(name), "(", emit_param_list(params), ")")

# Phase 3 unboxing — raw signature for a UFn. Return type is the
# raw C scalar matching `ret_ty`; param list mints `kair_<name>`
# locals typed to each `param_ty`.

# Phase 3 unboxing — raw signature for a UFn. Return type is the
# raw C scalar matching `ret_ty`; param list mints `kair_<name>`
# locals typed to each `param_ty`.
fn emit_fn_signature_unboxed(name: String, params: [Param], sig: UFnSig) : String =
  emit_fn_signature_unboxed_evf(name, params, sig, [])

# Same as above but with the evidence-frame param prepended (the
# pointer is orthogonal to arg/return unboxing — it rides as the first arg).
fn emit_fn_signature_unboxed_evf(name: String, params: [Param], sig: UFnSig, slots: [String]) : String =
  match sig {
    US(pts, rt, mask) -> concat_all([
      "static ", ufn_ret_c_type(rt),
      " ", c_user_sym(name), "(", evf_join_params(evf_param_decl(slots), emit_param_list_masked(params, pts, mask, [])), ")"
    ])
  }

# Return-type C string for a (possibly mixed) UFn: raw scalar when the
# return ty is unboxable, else `KaiValue *` (boxed return — e.g.
# `balance(...) : RBTree`). Mixed-param lane (issue #440 follow-up).
fn ufn_ret_c_type(rt: Ty) : String =
  if ty_is_unboxable_t(rt) { raw_c_type(Some(rt)) } else { "KaiValue *" }

# True iff the UFn's return lowers to a raw scalar (vs a boxed
# `KaiValue *`). Drives the body's `return` form and the call-site
# box_wrap decision.
fn ufn_ret_is_raw(sig: UFnSig) : Bool = match sig { US(_, rt, _) -> ty_is_unboxable_t(rt) }

# Per-param C parameter list honouring the raw mask: raw slots emit
# `<scalar> kair_<p>`, boxed slots emit `KaiValue *kai_<p>`. The two
# name prefixes (`kair_` vs `kai_`) match what the body's EVar reads
# resolve to (unbox pass marks only raw params MUnboxed).
fn emit_param_list_masked(params: [Param], tys: [Ty], mask: [Bool], acc: [String]) : String {
  match params {
    [] -> match acc { [] -> "void" _ -> join_with(list_reverse(acc), ", ") }
    [p, ...rest] -> {
      let pty = match tys {
        [t, ..._] -> t
        [] -> param_ty(p)
      }
      let trest = match tys {
        [_, ...r] -> r
        [] -> []
      }
      let is_raw = match mask {
        [m, ..._] -> m
        [] -> true
      }
      let mrest = match mask {
        [_, ...r] -> r
        [] -> []
      }
      let entry =
        if is_raw { concat_all([raw_c_type(Some(pty)), " kair_", written_text(p.binder.name)]) }
        else { concat_all(["KaiValue *", c_local(written_text(p.binder.name))]) }
      emit_param_list_masked(rest, trest, mrest, [entry, ...acc])
    }
  }
}

fn emit_fn_forward(d: Decl, tab: SymTab, specs: SpecNames, fx: FnIndex, frames: EvFrames, capable: [String], const_syms: [String]) : String {
  match d {
    DFn(_, fid, _, params, _, _, body, _, _, mo) -> {
      let sym = c_sym(emit_fn_text(tab, specs, fid), mo)
      let slots = frame_slots_of(frames, sym)
      # Match the definition's `_donor` suffix so the forward decl agrees —
      # keyed on the SAME capable set the def and call site use.
      let sig = rd_splice_param(match fnx_ufn_sig_first(fx, fid) {
        Some(us) -> emit_fn_signature_unboxed_evf(sym, params, us, slots)
        None     -> emit_fn_signature_evf(sym, params, slots)
      }, rd_is_capable(sym, capable))
      cat2(purity_const_prefix(sym, const_syms), cat2(sig, ";\n"))
    }
    _ -> ""
  }
}

# `KAI_CONST ` when the confirmation table proved this fn memory-clean,
# else empty. The prefix must be IDENTICAL on the forward decl and the
# definition (both go through this helper on the same `c_sym`), so `cc`
# never sees a mismatched declaration.
fn purity_const_prefix(sym: String, const_syms: [String]) : String =
  if ec_name_present(const_syms, sym) { "KAI_CONST " } else { "" }

fn ec_name_present(xs: [String], t: String) : Bool = match xs {
  [] -> false
  [h, ...rest] -> if h == t { true } else { ec_name_present(rest, t) }
  _ -> false
}

fn emit_thunk_forward(d: Decl, tab: SymTab, specs: SpecNames) : String {
  match d {
    DFn(_, fid, _, _, _, _, _, _, _, mo) ->
      cat3("static KaiValue *", c_user_thunk_sym(c_sym(emit_fn_text(tab, specs, fid), mo)), "(KaiValue *, KaiValue **, int);\n")
    _ -> ""
  }
}

fn emit_fn_body(src: String, d: Decl, cx: EmitCtx, body_fns_pre: [EFn], const_syms: [String]) : String / Console {

  match d {
    DFn(_, fid, tps, params, ret_ty_opt, row, body, _, _, mo) -> {
      let name = emit_fn_text(cx.tab, cx.specs, fid)
      let opt_sig = fnx_ufn_sig_first(cx.fx, fid)
      let evf_slots = frame_slots_of(cx.evf, c_sym(name, mo))
      # Interprocedural reuse donation: a fn whose body rebuilds a variant
      # through a reuse arm takes a hidden `_donor` reuse-token param so an
      # out-of-line caller holding a live unconsumed token can donate it
      # instead of freeing it (emit_reuse_donate.kai). The `_donor` ABI is
      # keyed on `cx.rd_capable` — the SAME set the call site consults — so
      # definition, forward decl, thunk and call site never disagree. Under
      # separate compilation the set is empty (a cross-TU call cannot see the
      # body), so no fn takes `_donor` and every call site omits it.
      let rd_cap = rd_is_capable(c_sym(name, mo), cx.rd_capable)
      let sig = cat2(purity_const_prefix(c_sym(name, mo), const_syms), rd_splice_param(match opt_sig {
        Some(us) -> emit_fn_signature_unboxed_evf(c_sym(name, mo), params, us, evf_slots)
        None     -> emit_fn_signature_evf(c_sym(name, mo), params, evf_slots)
      }, rd_cap))
      # m12.7.x FFI v1: a `[<extern_c>]` axiom lowered into a DFn
      # whose body is the magic ETodo tag. Emit the FFI shim instead
      # of the standard body — the shim unboxes each parameter to
      # the matching C scalar, calls the extern symbol, and re-boxes
      # the return value. The shim does its own `extern` forward decl
      # inline so callers don't need a separate header pass.
      if is_some(body_kai_builtin(body)) {
        emit_kai_forwarder_body(sig, body, params)
      } else if body_is_ffi_extern(body) {
        # Issue #261: the C-side symbol is either the override
        # baked into the body's tag or the kaikai identifier.
        # A signature mentioning a struct / opaque / fixed-width type
        # takes the extended shim (struct unwrap + re-box, opaque void*,
        # width casts); a purely-scalar signature stays on the basic
        # shim.
        let csym = ffi_extern_symbol_of(body, name)
        if ffi_sig_uses_v2(params, ret_ty_opt, cx.ffi_reg, cx.tab) {
          emit_ffi_v2_shim_body(sig, csym, params, ret_ty_opt, cx.ffi_reg, cx.tab)
        } else {
          emit_ffi_shim_body(sig, csym, params, ret_ty_opt, cx.tab)
        }
      } else if body_is_proto_dispatch(body) {
        # Option C: runtime dispatch shim. Look up the matching
        # `__pimpl_*` in the impl-table and tail-call it. See
        # `make_dispatcher_body` and docs/protocols.md §Codegen sketch.
        emit_proto_dispatch_shim_c(sig, proto_dispatch_parts(body), params, ret_ty_opt)
      } else {
        # Seed the scope with the fn's parameters.
        let pids = param_local_ids(params)
        let body_lcs = list_append(cx.lcs, pids)
        let locals = ln_of_decl(d)
        # Same-module preference: when this DFn lives in a module,
        # rotate the EFn table so entries from that same module come
        # first AND prune any root-file shadow of a name the module
        # redefines (#748). The rotation lets a recursive call inside
        # `loop.repeat` resolve to `loop.repeat` over a sibling
        # `list.repeat`; the prune is what stops `efn_pick_root` from
        # grabbing the USER's `fn sum` shadow for `list.sum`'s internal
        # `sum(t)` — so the self-call mangles to `kai_list__sum`, the
        # user's stays `kai_sum`, and the two link cleanly.
        let body_fns = body_fns_pre
        # Body sees the extended lexical scope and the module-rotated
        # EFn table; the other three context fields are unchanged.
        # `cur_enc_fn` becomes THIS fn's mangled symbol so a nested
        # ELambda in the body resolves to its own module's LamInfo.
        # A region-polymorphic fn (a `Tree<r>` param or return) allocates
        # its aggregates in the ambient arena: its ctors bump-allocate in
        # `kai_arena_current()`, which is the region's arena during the
        # dynamic extent of the `region { r -> }` that called it, and
        # NULL (→ RC fallback) otherwise. Routing keys on the SIGNATURE
        # types (which survive mono), not the tparam list (emptied by
        # mono) nor the per-ctor `.ty` (the brand does not survive the
        # unit normaliser on every ctor), so every ctor in the body routes.
        let body_in_region = cx.in_region or fn_has_region_brand(params, ret_ty_opt)
        let frame = unw_fn_frame(cx.unw, c_sym(name, mo), Some(row), unw_param_seeds(params, opt_sig, cx.unw.ucx), pids, body)
        let body_cx = EmitCtx { ...cx, locals: locals, lcs: body_lcs, fns: body_fns, in_region: body_in_region,
                                hoisted: [], reuse_donor: None, kind1_raw: [], cur_enc_fn: c_sym(name, mo),
                                rd_active: rd_cap, tcpend: [], unw: frame }
        # Phase 3 unboxing — UFn body emits a raw return expression
        # whose value is the raw scalar matching `ret_ty`. The
        # body's `mode` is set by `unbox_pass`/`ufn_promote_calls`;
        # `emit_expr_raw` handles the MBoxed→raw boundary if the
        # body somehow stayed boxed (defensive for partial
        # promotions). The TCO sentinel goto path stays compatible:
        # `tcrec_emit_goto` writes `goto _kai_<sym>_entry;` which
        # ignores the surrounding return-expression shape.
        # TRMC: a step sentinel needs the cctx accumulator declared
        # before the entry label (mirror Koka's wrapper seeding
        # kk_cctx_empty once — kaikai's single-fn-with-entry-label gets
        # it for free with a local declaration).
        # `_arm_ru` is the reuse token the arm-top (emit_arm_top_reuse)
        # captures from `_scr` when the consumed node is unique. Declared
        # fn-wide and null by default so the TRMC step can reference it
        # unconditionally — a fn whose arms have no arm-top reuse leaves it
        # null and the step fresh-allocs, exactly the old behaviour.
        let acc_decl = if trmc_body_has_step(body) {
          "KaiCctx _kai_acc = kai_cctx_empty();\n    KaiReuse _arm_ru = kai_reuse_null;\n    "
        } else { "" }
        match opt_sig {
          Some(usig) -> {
            # Mixed-param lane: a UFn with a RAW return emits its body
            # raw (`emit_expr_raw`); a UFn with a BOXED return (e.g.
            # `balance(...) : RBTree` — raw k/v params, boxed result)
            # emits the body boxed (`emit_expr`), exactly like a non-UFn
            # return. The raw params still travel raw inside the body;
            # only the returned value is a `KaiValue *`.
            let is_raw = ufn_ret_is_raw(usig)
            let body_c0 =
              if is_raw {
                emit_expr_raw(src, body, body_cx)
              } else {
                emit_expr(src, body, body_cx)
              }
            # Free a donated token no arm consumed, after the result is
            # computed. A capable body never has a TRMC goto (it rebuilds
            # via pcs_ret, not a self-tail step), so wrapping is safe.
            let body_c = rd_wrap_body(body_c0, not is_raw, rd_cap and not tcrec_body_has_sentinel(body))
            let label = if tcrec_body_has_sentinel(body) {
              concat_all([tcrec_emit_param_ptrs_masked(params, usig, 0),
                          "\n    ", c_user_entry_label(c_sym(name, mo)), ":;\n    "])
            } else { "" }
            concat_all([sig, " {\n    ", euw_with_fiber(frame.sites != [], acc_decl), label, "return ", body_c, ";\n}\n\n"])
          }
          None -> {
            let body_c0 = emit_expr(src, body, body_cx)
            let body_c = rd_wrap_body(body_c0, true, rd_cap and not tcrec_body_has_sentinel(body))
            # Issue #37: when `tcrec_rewrite_decl` planted at least one
            # `__kai_tcrec|...` self-tail-call sentinel inside `body`,
            # plant the matching `_kai_<c_sym>_entry:;` label *before*
            # the `return ({ ... });` so the goto inside the
            # statement-expression has a target.
            let label = if tcrec_body_has_sentinel(body) {
              concat_all([tcrec_emit_param_ptrs(params, 0),
                          "\n    ", c_user_entry_label(c_sym(name, mo)), ":;\n    "])
            } else { "" }
            concat_all([sig, " {\n    ", euw_with_fiber(frame.sites != [], acc_decl), label, "return ", body_c, ";\n}\n\n"])
          }
        }
      }
    }
    _ -> ""
  }
}

# FFI v1: the C body of a scalar `extern "C" fn`. The shim
# - forward-declares the extern symbol with the call site's C ABI types,
# - unboxes each kaikai parameter into its C-side equivalent,
# - calls the extern, releases the input args, and
# - boxes the return value back into a `KaiValue *` (or `kai_unit()`
#   for a `void`-returning extern).
#
# Boundary type translation:
#   Int  ↔ int64_t    Real ↔ double      Bool ↔ int
#   Char ↔ int32_t    String ↔ const char *    Unit ↔ void (return only)
# Anything else surfaces as an `#error` so the C compiler flags it
# at build time — silently emitting a wrong shim would be worse than
# refusing the cast.
fn emit_ffi_shim_body(sig: String, name: String, params: [Param],
                      ret_ty_opt: Option[TypeExpr], tab: SymTab) : String {
  let ret_kind = ffi_ret_kind_of(ret_ty_opt, tab)
  # Forward-declare the extern symbol with the C ABI types the call site
  # uses (`extern <ret> sym(<params>);`), so `cc` compiles the call
  # without an implicit declaration. The declaration IS the binding
  # contract: a user binding a libc symbol must declare a type whose C
  # mapping matches the system header, or `cc` rejects the redeclaration
  # at compile time — the binding is honoured literally, not silently
  # reconciled. A `FfiRetUnknown` signature emits an `#error` body
  # instead, so it gets no declaration.
  let extern_decl = ffi_v1_extern_decl(name, params, ret_kind, tab)
  let arg_setup = ffi_emit_arg_setup(params, tab, 0)
  let arg_list = ffi_emit_arg_list(params, 0)
  let call_expr = concat_all([name, "(", arg_list, ")"])
  let arg_decrefs = ffi_emit_arg_decrefs(params, 0)
  let body = match ret_kind {
    FfiRetUnit -> concat_all([
      arg_setup,
      "    ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_unit();\n"
    ])
    FfiRetInt -> concat_all([
      arg_setup,
      "    int64_t _kai_ffi_ret = (int64_t) ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_int(_kai_ffi_ret);\n"
    ])
    FfiRetReal -> concat_all([
      arg_setup,
      "    double _kai_ffi_ret = (double) ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_real(_kai_ffi_ret);\n"
    ])
    FfiRetBool -> concat_all([
      arg_setup,
      "    int _kai_ffi_ret = (int) ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_bool(_kai_ffi_ret != 0);\n"
    ])
    FfiRetChar -> concat_all([
      arg_setup,
      "    int32_t _kai_ffi_ret = (int32_t) ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_char((uint32_t) _kai_ffi_ret);\n"
    ])
    FfiRetString -> concat_all([
      arg_setup,
      "    const char *_kai_ffi_ret = ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_str(_kai_ffi_ret == NULL ? \"\" : _kai_ffi_ret);\n"
    ])
    # Struct / opaque / fixed-width kinds never reach the basic shim —
    # a signature using one routes to `emit_ffi_v2_shim_body`. Belt for
    # exhaustiveness.
    FfiRetFixed(_)    -> ffi_v1_v2_kind_error("fixed-width")
    FfiRetFixedVal(_) -> ffi_v1_v2_kind_error("fixed-width")
    FfiRetStruct(n)  -> ffi_v1_v2_kind_error(n)
    FfiRetForeign(n) -> ffi_v1_v2_kind_error(n)
    FfiRetUnknown(t) -> concat_all([
      "#error \"FFI return type `", t,
      "` is not supported in m12.7.x — use Int / Real / Bool / String / Char / Unit\"\n"
    ])
  }
  concat_all([extern_decl, sig, " {\n", body, "}\n\n"])
}

# Forward declaration for an `extern "C"` scalar symbol: `extern <ret>
# sym(<params>);` over the C ABI types the shim's call site uses. A
# `FfiRetUnknown` return yields the empty string — that signature emits
# an `#error` body, so a declaration would only add noise.
fn ffi_v1_extern_decl(name: String, params: [Param], ret_kind: FfiRetKind, tab: SymTab) : String =
  match ret_kind {
    FfiRetUnknown(_) -> ""
    _ -> concat_all(["extern ", ffi_c_ret_type_str(ret_kind), " ", name,
                     "(", ffi_c_param_list(params, tab), ");\n"])
  }

# A struct / opaque / fixed-width kind reaching the basic scalar shim
# is a routing bug (`ffi_sig_uses_v2` should have sent it to
# `emit_ffi_v2_shim_body`). Emit a `#error` naming the offending type
# so the C compile fails loud.
fn ffi_v1_v2_kind_error(name: String) : String =
  concat_all(["#error \"FFI v2 type `", name,
              "` reached the v1 scalar shim — internal routing bug\"\n"])

# Option C: runtime-dispatch shim body for `__proto_<op>`. Looks up
# the matching `__pimpl_*` in the impl-table by `(proto_id,
# head_tag(self))` and tail-calls it.
#
# The shim signature must match the dispatcher's kaikai signature
# byte-for-byte — `sig` already encodes that. The first parameter is
# always `Self`-shaped (the receiver carries the dispatch tag); we
# read its head tag and look up.
#
# If the lookup misses (no impl registered for the receiver's runtime
# head), panic with a useful message. The validator pass
# (`validate_resolved_protocols`) catches the static cases at compile
# time; reaching the panic at runtime means either (a) a user wrote a
# polymorphic helper without the required `T : P` bound and the bound
# was not enforced at instantiation, or (b) impl-table corruption.

# Option C: runtime-dispatch shim body for `__proto_<op>`. Looks up
# the matching `__pimpl_*` in the impl-table by `(proto_id,
# head_tag(self))` and tail-calls it.
#
# The shim signature must match the dispatcher's kaikai signature
# byte-for-byte — `sig` already encodes that. The first parameter is
# always `Self`-shaped (the receiver carries the dispatch tag); we
# read its head tag and look up.
#
# If the lookup misses (no impl registered for the receiver's runtime
# head), panic with a useful message. The validator pass
# (`validate_resolved_protocols`) catches the static cases at compile
# time; reaching the panic at runtime means either (a) a user wrote a
# polymorphic helper without the required `T : P` bound and the bound
# was not enforced at instantiation, or (b) impl-table corruption.
# The fn a declared core builtin's declaration emits, so the builtin is a
# value through its thunk: it hands its owned args to the runtime symbol.
fn emit_kai_forwarder_body(sig: String, body: Expr, params: [Param]) : String =
  concat_all([sig, " {\n    return ", ffi_extern_symbol_of(body, ""), "(",
              join_with(map(params, (p) => c_local(written_text(p.binder.name))), ", "), ");\n}\n\n"])

fn emit_proto_dispatch_shim_c(sig: String, parts: ProtoDispatchParts,
                                params: [Param],
                                ret_ty_opt: Option[TypeExpr]) : String {
  match parts {
    PDP(pname, opname) -> {
      let proto_id_c = match pdp_core(parts) {
        Some(cp) -> stdlib_proto_id_c(cp)
        None     -> concat_all(["-1 /* unknown protocol ", pname,
                                " — user protocols not supported in v1 */"])
      }
      let op_id_c = int_to_string(pdp_op_id_int(parts))
      let arity = list_length(params)
      let miss_msg = concat_all(["no impl of ", pname, ".", opname,
                                  " for runtime head (arity 0 op: caller must annotate Self)"])
      if arity == 0 {
        # Arity-0 ops (`Default.default() : Self`) cannot be runtime-
        # dispatched: there is no value to derive the head tag from,
        # and Self is meant to be pinned by the caller's annotation
        # so the monomorphiser resolves the impl statically. Reaching
        # this body means the validator missed an unresolved call —
        # panic with the diagnostic and never call back into the
        # impl-table.
        concat_all([
          sig, " {\n",
          "    fprintf(stderr, \"panic: ", miss_msg, "\\n\");\n",
          "    kai_exit(1);\n",
          "}\n\n"
        ])
      } else {
        let cast = proto_dispatch_cast(arity)
        let arg_list = proto_dispatch_arg_list(params, 0)
        let head_param = match params {
          [p, ..._] -> written_text(p.binder.name)
          []        -> "self"
        }
        concat_all([
          sig, " {\n",
          "    int32_t _kai_head = kai_head_tag(", c_local(head_param), ");\n",
          "    void *_kai_fn_p = kai_lookup_impl(", proto_id_c, ", ", op_id_c, ", _kai_head);\n",
          "    if (_kai_fn_p == NULL) {\n",
          "        fprintf(stderr, \"panic: no impl of ", pname, ".", opname,
                  " for runtime head %d\\n\", (int) _kai_head);\n",
          "        kai_exit(1);\n",
          "    }\n",
          "    return ", cast, "_kai_fn_p)(", arg_list, ");\n",
          "}\n\n"
        ])
      }
    }
  }
}

# The KAI_PROTO_* C constant the runtime impl table numbers a core
# protocol with.
fn stdlib_proto_id_c(p: CoreProto) : String = match p {
  CpShow         -> "KAI_PROTO_SHOW"
  CpEq           -> "KAI_PROTO_EQ"
  CpOrd          -> "KAI_PROTO_ORD"
  CpHash         -> "KAI_PROTO_HASH"
  CpSerialize    -> "KAI_PROTO_SERIALIZE"
  CpBinSerialize -> "KAI_PROTO_BIN_SERIALIZE"
  CpDefault      -> "KAI_PROTO_DEFAULT"
  CpAdd          -> "KAI_PROTO_ADD"
  CpSub          -> "KAI_PROTO_SUB"
  CpMul          -> "KAI_PROTO_MUL"
  CpDiv          -> "KAI_PROTO_DIV"
  CpRem          -> "KAI_PROTO_REM"
  CpNumeric      -> "KAI_PROTO_NUMERIC"
  CpLayout       -> "KAI_PROTO_LAYOUT"
  CpJson         -> "KAI_PROTO_JSON"
}

# Build the C cast prefix for indirect call of a dispatcher of N
# params. All params and the return are `KaiValue *`. The caller emits
# the closing `)` after the cast and the arg list:
# `return ((KaiValue *(*)(KaiValue *)) _kai_fn_p)(kai_a);`

# Build the C cast prefix for indirect call of a dispatcher of N
# params. All params and the return are `KaiValue *`. The caller emits
# the closing `)` after the cast and the arg list:
# `return ((KaiValue *(*)(KaiValue *)) _kai_fn_p)(kai_a);`
fn proto_dispatch_cast(arity: Int) : String {
  let args = proto_dispatch_kaivalueptr_list(arity, 0)
  concat_all(["((KaiValue *(*)(", args, ")) "])
}

fn proto_dispatch_kaivalueptr_list(arity: Int, i: Int) : String {
  if i >= arity { "" }
  else if i == 0 { concat_all(["KaiValue *", proto_dispatch_kaivalueptr_list(arity, i + 1)]) }
  else { concat_all([", KaiValue *", proto_dispatch_kaivalueptr_list(arity, i + 1)]) }
}

# Emit the kaikai params as a C call-arg list `kai_p0, kai_p1, ...`.

# Emit the kaikai params as a C call-arg list `kai_p0, kai_p1, ...`.
fn proto_dispatch_arg_list(params: [Param], i: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let head = if i == 0 { c_local(written_text(p.binder.name)) }
                 else { cat2(", ", c_local(written_text(p.binder.name))) }
      concat_all([head, proto_dispatch_arg_list(rest, i + 1)])
    }
  }
}

fn ffi_c_ret_type_str(k: FfiRetKind) : String {
  match k {
    FfiRetUnit -> "void"
    FfiRetInt -> "int64_t"
    FfiRetReal -> "double"
    FfiRetBool -> "int"
    FfiRetChar -> "int32_t"
    FfiRetString -> "const char *"
    # FFI v2 kinds never reach these v1 helpers (the v2 shim path owns
    # them); the body is `#error`, never compiled. Belt for exhaustiveness.
    FfiRetFixed(_)    -> "void"
    FfiRetFixedVal(_) -> "void"
    FfiRetStruct(_)  -> "void"
    FfiRetForeign(_) -> "void"
    FfiRetUnknown(_) -> "void"  # body is `#error`, never compiled
  }
}

fn ffi_c_param_type_str(p: Param, tab: SymTab) : String {
  match p.ptype {
    None -> "/* missing type */ void *"
    Some(t) -> match ffi_kind_of_ty(t, tab) {
      FfiRetInt -> "int64_t"
      FfiRetReal -> "double"
      FfiRetBool -> "int"
      FfiRetChar -> "int32_t"
      FfiRetString -> "const char *"
      FfiRetUnit -> "/* Unit param not supported */ void *"
      FfiRetFixed(_)    -> "/* v2 fixed-width — v2 shim path */ void *"
      FfiRetFixedVal(_) -> "/* v2 fixed-width — v2 shim path */ void *"
      FfiRetStruct(_)  -> "/* v2 struct — v2 shim path */ void *"
      FfiRetForeign(_) -> "/* v2 opaque — v2 shim path */ void *"
      FfiRetUnknown(_) -> "/* unsupported FFI param */ void *"
    }
  }
}

fn ffi_c_param_list(params: [Param], tab: SymTab) : String {
  match params {
    [] -> "void"
    _ -> join_with(map(params, (p) => ffi_c_param_type_str(p, tab)), ", ")
  }
}

# Emit a sequence of local C bindings that unbox each kaikai
# parameter into the matching C scalar. The shim stores the inputs
# in `_kai_ffi_argN` so they survive across the extern call long
# enough for the caller to release the boxed inputs after the call.

# Emit a sequence of local C bindings that unbox each kaikai
# parameter into the matching C scalar. The shim stores the inputs
# in `_kai_ffi_argN` so they survive across the extern call long
# enough for the caller to release the boxed inputs after the call.
fn ffi_emit_arg_setup(params: [Param], tab: SymTab, i: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let kind = match p.ptype {
        None -> FfiRetUnknown("missing")
        Some(t) -> ffi_kind_of_ty(t, tab)
      }
      let arg_name = concat_all(["_kai_ffi_arg", int_to_string(i)])
      let stmt = match kind {
        FfiRetInt -> concat_all([
          "    int64_t ", arg_name, " = kai_intf(", c_local(written_text(p.binder.name)), ");\n"
        ])
        FfiRetReal -> concat_all([
          "    double ", arg_name, " = ", c_local(written_text(p.binder.name)), "->as.r;\n"
        ])
        FfiRetBool -> concat_all([
          "    int ", arg_name, " = ", c_local(written_text(p.binder.name)), "->as.b ? 1 : 0;\n"
        ])
        FfiRetChar -> concat_all([
          "    int32_t ", arg_name, " = (int32_t) ", c_local(written_text(p.binder.name)), "->as.c;\n"
        ])
        FfiRetString -> concat_all([
          "    const char *", arg_name, " = ", c_local(written_text(p.binder.name)), "->as.s.bytes;\n"
        ])
        FfiRetUnit -> concat_all([
          "    /* Unit FFI arg #", int_to_string(i), " elided */\n"
        ])
        # FFI v2 kinds are handled by the v2 shim path, never here.
        FfiRetFixed(_)    -> ffi_v1_v2_kind_error("fixed-width")
        FfiRetFixedVal(_) -> ffi_v1_v2_kind_error("fixed-width")
        FfiRetStruct(n)  -> ffi_v1_v2_kind_error(n)
        FfiRetForeign(n) -> ffi_v1_v2_kind_error(n)
        FfiRetUnknown(t) -> concat_all([
          "#error \"FFI arg type `", t, "` is not supported\"\n"
        ])
      }
      cat2(stmt, ffi_emit_arg_setup(rest, tab, i + 1))
    }
  }
}

fn ffi_emit_arg_list(params: [Param], i: Int) : String {
  match params {
    [] -> ""
    [_, ...rest] -> {
      let head = concat_all(["_kai_ffi_arg", int_to_string(i)])
      match rest {
        [] -> head
        _ -> concat_all([head, ", ", ffi_emit_arg_list(rest, i + 1)])
      }
    }
  }
}

# After the extern returns we must release the boxed kaikai inputs;
# the calling convention hands ownership to the callee.

# After the extern returns we must release the boxed kaikai inputs;
# the calling convention hands ownership to the callee.
fn ffi_emit_arg_decrefs(params: [Param], i: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] -> cat2(
      concat_all(["    kai_decref(", c_local(written_text(p.binder.name)), ");\n"]),
      ffi_emit_arg_decrefs(rest, i + 1)
    )
  }
}

fn emit_param_args(params: [Param]) : String =
  join_with(map(params, (pm) => c_local(written_text(pm.binder.name))), ", ")

fn emit_param_reads(params: [Param], start: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] ->
      cat2(
        concat_all(["    KaiValue *", c_local(written_text(p.binder.name)), " = args[", int_to_string(start), "];\n"]),
        emit_param_reads(rest, start + 1))
  }
}

fn emit_fn_thunk(d: Decl, tab: SymTab, specs: SpecNames, fx: FnIndex, frames: EvFrames, effs: [Decl], capable: [String]) : String {
  match d {
    DFn(_, fid, _, params, opt_ret, _, body, _, _, mo) -> {
      let sym = c_sym(emit_fn_text(tab, specs, fid), mo)
      # A donation-capable fn has a trailing `_donor` param; the indirect
      # (closure) entry has no live token to donate, so it passes null.
      # Keyed on the same capable set as the def/forward/call site.
      let rd_arg = if rd_is_capable(sym, capable) { concat_all([", ", rd_null_arg()]) } else { "" }
      let hdr = concat_all([
        "static KaiValue *", c_user_thunk_sym(sym),
        "(KaiValue *self, KaiValue **args, int n) {\n    (void) self; (void) n;\n"
      ])
      # KIR Lane 1: a fn whose signature mentions `TyHandle` is a
      # native-backend internal (it threads raw LLVM C-API pointers).
      # A handle cannot ride the boxed thunk ABI (`KaiValue **args`)
      # without `->as.i`-corrupting the pointer, and such a fn is never
      # a first-class value (no `kai_apply` / closure over it). Emit a
      # panic stub so the symbol still resolves but an accidental
      # indirect call is loud, not silent corruption.
      if sig_has_handle(params, opt_ret) {
        concat_all([hdr,
          "    (void) args;\n",
          "    kai_core_panic(kai_str(\"native-backend fn called indirectly (handle thunk)\"));\n",
          "    return kai_unit();\n}\n\n"])
      } else {
      # Phase 3 unboxing — when the named fn is a UFn, the thunk
      # marshals each boxed `args[i]` into the matching raw scalar
      # via `->as.X` and wraps the raw return in `kai_<T>` so the
      # closure-call indirection (`kai_apply` / `kai_closure`)
      # still hands back a `KaiValue *`. This is the dispatch
      # bridge between the boxed first-class-fn world and the
      # raw direct-call world.
      # A thunk is the indirect (closure) entry; it has no
      # caller frame, so it fills the callee's frame from the live evidence
      # stack (a walk per slot — the ≤1-handler-correct node at the call).
      let thunk_frame = emit_evf_thunk_frame(frame_slots_of(frames, sym), effs, tab)
      match fnx_ufn_sig_first(fx, fid) {
        Some(US(pts, rt, mask)) -> {
          # Mixed-param lane: raw slots unbox `args[i]` to `kair_<p>`,
          # boxed slots bind `kai_<p> = args[i]` straight (the fn
          # consumes the ref). The call mixes `kair_`/`kai_` per mask
          # and the result wraps only if the return is raw.
          let arg_unbox = emit_thunk_unbox_args_masked(params, pts, mask, 0)
          let arg_list = emit_thunk_arg_list_masked(params, mask, 0)
          let call_raw = concat_all([c_user_sym(sym), "(", evf_join_args(thunk_frame, arg_list), rd_arg, ")"])
          let body = concat_all([
            arg_unbox,
            "    return ", ufn_call_result(rt, call_raw), ";\n}\n\n"
          ])
          concat_all([hdr, body])
        }
        None -> {
          let param_reads = emit_param_reads(params, 0)
          let named_args = emit_param_args(params)
          let call = concat_all(["    return ", c_user_sym(sym), "(", evf_join_args(thunk_frame, named_args), rd_arg, ");\n}\n\n"])
          concat_all([hdr, param_reads, call])
        }
      }
      }
    }
    _ -> ""
  }
}

# KIR Lane 1: true when a fn signature mentions `TyHandle` in any param
# or the return. Such a fn is native-backend internal and gets a panic
# thunk (a handle cannot ride the boxed thunk ABI).
fn sig_has_handle(params: [Param], opt_ret: Option[TypeExpr]) : Bool =
  params_have_handle(params) or match opt_ret {
    Some(rty) -> ty_is_handle(resolve_ty(rty))
    None      -> false
  }

fn params_have_handle(params: [Param]) : Bool = match params {
  [] -> false
  [p, ...rest] -> if ty_is_handle(param_ty(p)) { true } else { params_have_handle(rest) }
}

fn ty_is_handle(t: Ty) : Bool = match t {
  TyHandle -> true
  _        -> false
}

# Phase 3 unboxing — emit per-param `<raw_ty> kair_<name> = args[i]->as.X;`
# bindings inside a UFn thunk. The boxed arg slot is dropped as soon
# as the raw scalar is read; the caller (`kai_apply`) owns its
# argument array's references but the thunk takes ownership of each
# slot as it consumes it (matching the boxed thunk's
# `KaiValue *kai_<n> = args[i]; ...; kai_decref(...)` discipline).

# Phase 3 unboxing — emit per-param `<raw_ty> kair_<name> = args[i]->as.X;`
# bindings inside a UFn thunk. The boxed arg slot is dropped as soon
# as the raw scalar is read; the caller (`kai_apply`) owns its
# argument array's references but the thunk takes ownership of each
# slot as it consumes it (matching the boxed thunk's
# `KaiValue *kai_<n> = args[i]; ...; kai_decref(...)` discipline).
fn emit_thunk_unbox_args(params: [Param], tys: [Ty], i: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let pty = match tys {
        [t, ...trest] -> t
        []            -> param_ty(p)
      }
      let trest = match tys {
        [_, ...r] -> r
        []        -> []
      }
      let ix = int_to_string(i)
      let line = concat_all([
        "    ", raw_c_type(Some(pty)), " kair_", written_text(p.binder.name),
        " = ", unbox_boxed_scalar(concat_all(["args[", ix, "]"]), Some(pty)), ";\n",
        "    kai_decref(args[", ix, "]);\n"
      ])
      cat2(line, emit_thunk_unbox_args(rest, trest, i + 1))
    }
  }
}

fn emit_thunk_raw_arg_list(params: [Param], i: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let head = concat_all(["kair_", written_text(p.binder.name)])
      match rest {
        [] -> head
        _  -> concat_all([head, ", ", emit_thunk_raw_arg_list(rest, i + 1)])
      }
    }
  }
}

# Mixed-param thunk: raw slots unbox `args[i]` into `<raw> kair_<p>`
# (consuming the boxed arg via decref); boxed slots bind
# `KaiValue *kai_<p> = args[i]` straight (the called fn takes the ref,
# no decref here — matching the boxed thunk's ownership transfer).
fn emit_thunk_unbox_args_masked(params: [Param], tys: [Ty], mask: [Bool], i: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let pty = match tys {
        [t, ..._] -> t
        [] -> param_ty(p)
      }
      let trest = match tys {
        [_, ...r] -> r
        [] -> []
      }
      let is_raw = match mask {
        [m, ..._] -> m
        [] -> true
      }
      let mrest = match mask {
        [_, ...r] -> r
        [] -> []
      }
      let ix = int_to_string(i)
      let line =
        if is_raw {
          # Read via `unbox_boxed_scalar` (kai_intf for Int) NOT a raw
          # `->as.i`: a thunk arg may be a TAGGED immediate Int (no heap
          # header), and `->as.i` would dereference the tag bits and
          # segfault (the chain-thunk crash, address=0xb = tagged 11).
          # kai_decref is already tagged-safe (no-op on immediates).
          concat_all([
            "    ", raw_c_type(Some(pty)), " kair_", written_text(p.binder.name),
            " = ", unbox_boxed_scalar(concat_all(["args[", ix, "]"]), Some(pty)), ";\n",
            "    kai_decref(args[", ix, "]);\n"
          ])
        } else {
          concat_all(["    KaiValue *", c_local(written_text(p.binder.name)), " = args[", ix, "];\n"])
        }
      cat2(line, emit_thunk_unbox_args_masked(rest, trest, mrest, i + 1))
    }
  }
}

# Mixed-param thunk arg list: `kair_<p>` for raw slots, `kai_<p>` for
# boxed slots, in declaration order.
fn emit_thunk_arg_list_masked(params: [Param], mask: [Bool], i: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let is_raw = match mask {
        [m, ..._] -> m
        [] -> true
      }
      let mrest = match mask {
        [_, ...r] -> r
        [] -> []
      }
      let head = if is_raw { concat_all(["kair_", written_text(p.binder.name)]) } else { c_local(written_text(p.binder.name)) }
      match rest {
        [] -> head
        _  -> concat_all([head, ", ", emit_thunk_arg_list_masked(rest, mrest, i + 1)])
      }
    }
  }
}

# ---- top-level passes ----

fn fn_forward_decls(decls: [Decl], tab: SymTab, specs: SpecNames, fx: FnIndex, capable: [String], const_syms: [String], entry: SymId) : String = {
  let frames = frames_index(build_evidence_frames(decls, tab, specs, entry))
  concat_all(map(decls, (d) => emit_fn_forward(d, tab, specs, fx, frames, capable, const_syms)))
}

# Drop from the donation-capable set any fn whose body carries a TRMC
# self-tail step (its leftover-`_donor` free rides a return wrap a `goto`
# would skip — a leak) or a raw unboxed return (the wrap casts through
# `int64_t`, truncating a `double`/pointer). A reuse-variant-rotation fn is
# neither, so this is a soundness fence over `rd_scan_capable`, not a live
# behaviour change. Keyed on the module-mangled `c_sym` like the set itself.
fn rd_donatable_filter(capable: [String], decls: [Decl], tab: SymTab, specs: SpecNames, fx: FnIndex) : [String] =
  filter(capable, (csym) => rd_donatable_ok(csym, decls, tab, specs, fx))

fn rd_donatable_ok(csym: String, decls: [Decl], tab: SymTab, specs: SpecNames, fx: FnIndex) : Bool = match decls {
  []           -> true
  [d, ...rest] -> match d {
    DFn(_, fid, _, _, _, _, body, _, _, mo) ->
      if c_sym(emit_fn_text(tab, specs, fid), mo) == csym {
        not tcrec_body_has_sentinel(body) and not rd_decl_ret_is_raw(fid, fx)
      } else { rd_donatable_ok(csym, rest, tab, specs, fx) }
    _ -> rd_donatable_ok(csym, rest, tab, specs, fx)
  }
}

fn rd_decl_ret_is_raw(fid: FnId, fx: FnIndex) : Bool =
  match fnx_ufn_sig_first(fx, fid) { Some(us) -> ufn_ret_is_raw(us) None -> false }

fn thunk_forward_decls(decls: [Decl], tab: SymTab, specs: SpecNames) : String =
  concat_all(map(decls, (d) => emit_thunk_forward(d, tab, specs)))

fn fn_bodies(src: String, decls: [Decl], cx: EmitCtx, const_syms: [String]) : String / Console + Mutable =
  sb_build(fn_bodies_loop(src, decls, cx, const_syms, sb_new()))

fn fn_bodies_loop(src: String, decls: [Decl], cx: EmitCtx, const_syms: [String], b: SB) : SB / Console + Mutable = match decls {
  [] -> b
  [d, ...rest] -> match d {
    DFn(_, _, _, _, _, _, _, _, _, _) -> {
      let b1 = sb_append(sb_append(b, emit_fn_body(src, d, cx, cx.fns, const_syms)), emit_fn_thunk(d, cx.tab, cx.specs, cx.fx, cx.evf, cx.effs, cx.rd_capable))
      fn_bodies_loop(src, rest, cx, const_syms, b1)
    }
    _ -> fn_bodies_loop(src, rest, cx, const_syms, b)
  }
}

# ---- test function emission (always emitted; only called from int main
#      when test_mode is on) ----

fn emit_test_fn(src: String, id: Int, desc_span: String, body: Expr, line: Int,
                cx: EmitCtx, test_enc: String) : String / Console {

  # desc_span is the raw source of the description including its quotes,
  # so it's already a valid C string literal. We wrap the body in
  # setjmp/longjmp: kai_assert_check inside the body can longjmp us out
  # on failure, and the test still counts as a tried test.
  # `test_enc` is the runner symbol the collector stamped on this test's
  # lambdas, so `find_lam` resolves them (a test body's lambda otherwise
  # looked up under the wrong enc_fn → "non-callable").
  let body_cx = EmitCtx { ...cx, locals: ln_with_expr(ln_empty(), body), hoisted: [], reuse_donor: None, kind1_raw: [], cur_enc_fn: test_enc }
  let body_c = emit_expr(src, body, body_cx)
  concat_all([
    "static void _kai_test_", int_to_string(id), "(void) {\n",
    "    if (!kai_test_selected(kai_test_file(), ", desc_span, ")) return;\n",
    "    long long _t0 = kai_test_now_ns();\n",
    "    kai_test_line(", int_to_string(line), ");\n",
    "    kai_test_begin(", desc_span, ");\n",
    "    if (setjmp(kai_test_jmp) == 0) {\n",
    "        kai_test_in_progress = 1;\n",
    "        KaiValue *_body = ", body_c, ";\n",
    "        kai_decref(_body);\n",
    "        kai_test_in_progress = 0;\n",
    "        kai_test_pass();\n",
    "    } else {\n",
    "        kai_test_in_progress = 0;\n",
    "        kai_test_unreported_fail();\n",
    "    }\n",
    "    kai_test_suite_ns += kai_test_now_ns() - _t0;\n",
    "}\n\n"
  ])
}


fn emit_one_test(src: String, cx: EmitCtx,
                 id_d: DeclWithId) : String / Console {

  match id_d {
    DWI(id, d) -> match d {
      DTest(desc_span, body, tl, tc, mo) ->
        emit_test_fn(src, id, desc_span, body, tl, cx, runner_enc_fn("test", mo, tl, tc))
      _ -> ""
    }
  }
}

# Helper pair to zip index with decl for clean iteration.

# Helper pair to zip index with decl for clean iteration.
type DeclWithId = DWI(Int, Decl)

fn number_tests_loop(decls: [Decl], id: Int, acc: [DeclWithId]) : [DeclWithId] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DTest(_, _, _, _, _) -> number_tests_loop(rest, id + 1, [DWI(id, d), ...acc])
      _ -> number_tests_loop(rest, id, acc)
    }
  }
}

fn number_tests(decls: [Decl]) : [DeclWithId] =
  number_tests_loop(decls, 0, [])


fn emit_all_tests(src: String, decls: [Decl], cx: EmitCtx,
                  target_origin: Option[String]) : String / Console {

  let numbered = number_tests(decls)
  let rcx = cx
  concat_all(map(numbered, (dwi) => emit_one_test(src, rcx, dwi)))
}


# Register every test block with the module it comes from, then drive them.
fn test_register_list(decls: [Decl]) : String =
  concat_all([concat_all(map(number_tests(decls), test_register_line)), "    kai_test_drive();\n"])

fn test_register_line(dwi: DeclWithId) : String = match dwi {
  DWI(id, DTest(_, _, _, _, mo)) -> concat_all([
    "    kai_test_register(_kai_test_", int_to_string(id), ", NULL, NULL, 0, \"",
    match mo { Some(m) -> m None -> "" }, "\");\n"
  ])
  _ -> ""
}

# ---- bench function emission (always emitted; only called from int main
#      when bench_mode is on) ----
#
# bench v1.x (issue #437): each bench body runs in two phases —
# KAI_BENCH_WARMUP untimed iterations to reduce JIT/cache effects on
# the timed window, then KAI_BENCH_ITERS timed iterations whose
# per-iteration nanoseconds are recorded into the runtime sample
# buffer. Both knobs are env vars (read once via kai_bench_iters() /
# kai_bench_warmup() in runtime.h) so users can override at runtime
# without recompiling. On exit kai_bench_finalize sorts the samples
# and prints median + MAD + mean + range. Like test, we do NOT install
# a setjmp landing pad — an assertion failure inside a bench should
# panic the process, since timing aborted code is meaningless.

fn emit_bench_fn(src: String, id: Int, desc_span: String, body: Expr,
                 cx: EmitCtx, bench_enc: String) : String / Console {

  let body_cx = EmitCtx { ...cx, locals: ln_with_expr(ln_empty(), body), hoisted: [], reuse_donor: None, kind1_raw: [], cur_enc_fn: bench_enc }
  let body_c = emit_expr(src, body, body_cx)
  concat_all([
    "static void _kai_bench_", int_to_string(id), "(void) {\n",
    "    int _kai_bench_iters = kai_bench_iters();\n",
    "    int _kai_bench_warmup = kai_bench_warmup();\n",
    "    int _kai_bench_w;\n",
    "    int _kai_bench_i;\n",
    "    long long _kai_bench_a;\n",
    "    long long _kai_bench_b;\n",
    "    kai_bench_ensure_capacity(_kai_bench_iters);\n",
    "    for (_kai_bench_w = 0; _kai_bench_w < _kai_bench_warmup; _kai_bench_w++) {\n",
    "        KaiValue *_body = ", body_c, ";\n",
    "        kai_decref(_body);\n",
    "    }\n",
    "    for (_kai_bench_i = 0; _kai_bench_i < _kai_bench_iters; _kai_bench_i++) {\n",
    "        _kai_bench_a = kai_bench_now_ns();\n",
    "        KaiValue *_body = ", body_c, ";\n",
    "        _kai_bench_b = kai_bench_now_ns();\n",
    "        kai_decref(_body);\n",
    "        kai_bench_record(_kai_bench_i, _kai_bench_b - _kai_bench_a);\n",
    "    }\n",
    "    kai_bench_finalize(", desc_span, ", _kai_bench_iters);\n",
    "}\n\n"
  ])
}

fn bench_decls(decls: [Decl]) : [Decl] =
  filter(decls, (d) => match d { DBench(_, _, _, _, _) -> true _ -> false })

fn emit_one_bench(src: String, cx: EmitCtx,
                  id_d: DeclWithId) : String / Console {

  match id_d {
    DWI(id, d) -> match d {
      DBench(desc_span, body, bl, bc, mo) ->
        emit_bench_fn(src, id, desc_span, body, cx, runner_enc_fn("bench", mo, bl, bc))
      _ -> ""
    }
  }
}

fn number_benches_loop(decls: [Decl], id: Int, acc: [DeclWithId]) : [DeclWithId] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DBench(_, _, _, _, _) -> number_benches_loop(rest, id + 1, [DWI(id, d), ...acc])
      _ -> number_benches_loop(rest, id, acc)
    }
  }
}

fn number_benches(decls: [Decl]) : [DeclWithId] =
  number_benches_loop(decls, 0, [])

fn emit_all_benches(src: String, decls: [Decl], cx: EmitCtx,
                    target_origin: Option[String]) : String / Console {

  let numbered = number_benches(decls)
  let rcx = cx
  concat_all(map(numbered, (dwi) => emit_one_bench(src, rcx, dwi)))
}

fn bench_count(decls: [Decl]) : Int = list_length(bench_decls(decls))

fn bench_call_list(n: Int, i: Int) : String {
  if i >= n { "" }
  else {
    concat_all(["    _kai_bench_", int_to_string(i), "();\n", bench_call_list(n, i + 1)])
  }
}

# ---- check function emission (always emitted; only called from int main
#      when check_mode is on) ----
#
# check v1 (issue #44): mirrors the test/bench pipelines above. Each
# check body is wrapped in a fixed-N (=KAI_CHECK_ITERS, 100) loop.
# Each iteration:
#
#   1. Records the description in the runtime via kai_check_begin
#      (only on iter 0).
#   2. Resets the counterexample buffer.
#   3. Generates a fresh value for every with-clause param via
#      kai_arbitrary_<T>() and records it for the counterexample.
#   4. Evaluates the body. The body must produce a Bool. true keeps
#      the loop running; false records a counterexample at the
#      current iter index and breaks early.
#
# After the loop, kai_check_pass / kai_check_fail prints the
# per-block result.
#
# The C-level local for each param is `kaiv_<name>`, which is what the
# body's read of the param spells. The lcs passed to emit_expr lists
# every with-clause param.

# Picks the runtime arbitrary-helper name for a parameter type. v1
# supports primitives (Int / Bool / Char / String) and lists of those
# primitives. Anything else collapses to a panic stub so the failure
# is loud rather than silent — protocol-based / structural derivation
# lands in v1.x and v2.

# Picks the runtime arbitrary-helper name for a parameter type. v1
# supports primitives (Int / Bool / Char / String) and lists of those
# primitives. Anything else collapses to a panic stub so the failure
# is loud rather than silent — protocol-based / structural derivation
# lands in v1.x and v2.
fn check_arbitrary_for_ty(ty: TypeExpr, tab: SymTab) : String = match resolve_ty(ty) {
  TyListT(elem) -> match check_scalar_word(elem) {
    Some(w) -> concat_all(["kai_arbitrary_list_", w, "()"])
    None    -> check_arbitrary_panic(check_ty_label(ty, tab))
  }
  t -> match check_scalar_word(t) {
    Some(w) -> concat_all(["kai_arbitrary_", w, "()"])
    None    -> check_arbitrary_panic(check_ty_label(ty, tab))
  }
}

# The word the runtime's generator and shrinker names spell a scalar with.
fn check_scalar_word(t: Ty) : Option[String] = match t {
  TyInt    -> Some("int")
  TyBool   -> Some("bool")
  TyChar   -> Some("char")
  TyString -> Some("string")
  _        -> None
}

# How the "no generator" panic names a parameter type.
fn check_ty_label(ty: TypeExpr, tab: SymTab) : String = match ty.tkind {
  TyName(r, _) -> decl_ref_text(tab, r)
  TyList(inner) -> match inner.tkind {
    TyName(r, _) -> concat_all(["[", decl_ref_text(tab, r), "]"])
    _            -> "[<complex>]"
  }
  _ -> "<complex>"
}

# The name a reference names: its declaration's once resolved, the written
# one before.
fn decl_ref_text(tab: SymTab, r: DeclRef) : String = match r {
  DrSym(s)        -> written_text(decl_name(tab, s))
  DrWritten(_, n) -> written_text(n)
}

fn check_arbitrary_panic(label: String) : String =
  concat_all([
    "kai_core_panic(kai_str(\"check v1: no generator for type ",
    label,
    " — supported types are Int, Bool, Char, String, and lists of those\"))"
  ])

# Picks the runtime shrink-helper names for a parameter type. Returns
# a list of strategy names. Lists have two strategies (drop-head, then
# shrink-head); scalars have one. Empty list means no shrink for this
# type — the runner will skip the param. Issue #438.

# Picks the runtime shrink-helper names for a parameter type. Returns
# a list of strategy names. Lists have two strategies (drop-head, then
# shrink-head); scalars have one. Empty list means no shrink for this
# type — the runner will skip the param. Issue #438.
fn check_shrink_for_ty(ty: TypeExpr) : [String] {
  match resolve_ty(ty) {
    TyListT(elem) -> match check_scalar_word(elem) {
      Some(w) -> [concat_all(["kai_shrink_list_", w]), concat_all(["kai_shrink_list_", w, "_head"])]
      None    -> []
    }
    t -> match check_scalar_word(t) {
      Some(w) -> [concat_all(["kai_shrink_", w])]
      None    -> []
    }
  }
}

fn emit_check_param_drops(params: [Param]) : String {
  match params {
    [] -> ""
    [p, ...rest] -> concat_all([
      "        kai_decref(", c_local(written_text(p.binder.name)), ");\n",
      emit_check_param_drops(rest)
    ])
  }
}

# After a counterexample is detected, the failing param values are
# captured in C locals named kai_<name> and we want to keep them alive
# beyond the per-iter loop's scope. The original loop already drops on
# every successful iter and breaks BEFORE dropping on failure, so the
# captured values still hold rc=1 — we just stop treating them as
# loop-scoped. Issue #438.
#
# Re-evaluating the body for shrinking is done by inlining body_c
# again — the params are read through the same C locals. Cost is one
# extra body emission per param-strategy at compile time and zero at
# steady-state runtime (the inlined re-eval only fires when a check
# actually fails, so passing checks pay nothing).

# Emits one strategy attempt: try kai_shrink_<helper>(kai_<param>); if
# it produces a non-NULL candidate AND the body still fails with that
# candidate swapped in, accept it (decref the previous value, keep the
# candidate as the new param), set _progressed=1, and break out of the
# strategy chain. Otherwise restore and decref the candidate.

# Emits one strategy attempt: try kai_shrink_<helper>(kai_<param>); if
# it produces a non-NULL candidate AND the body still fails with that
# candidate swapped in, accept it (decref the previous value, keep the
# candidate as the new param), set _progressed=1, and break out of the
# strategy chain. Otherwise restore and decref the candidate.
fn emit_shrink_attempt(pname: String, helper: String, body_c: String) : String =
  concat_all([
    "        if (!_progressed) {\n",
    "            KaiValue *_cand = ", helper, "(", c_local(pname), ");\n",
    "            if (_cand != NULL) {\n",
    "                KaiValue *_save = ", c_local(pname), ";\n",
    "                ", c_local(pname), " = _cand;\n",
    "                KaiValue *_body = ", body_c, ";\n",
    "                int _ok = kai_op_truthy(_body);\n",
    "                kai_decref(_body);\n",
    "                if (!_ok) {\n",
    "                    kai_decref(_save);\n",
    "                    _progressed = 1;\n",
    "                } else {\n",
    "                    ", c_local(pname), " = _save;\n",
    "                    kai_decref(_cand);\n",
    "                }\n",
    "            }\n",
    "        }\n"
  ])

# All strategies for one param, in order.

# All strategies for one param, in order.
fn emit_shrink_attempts_for_param(pname: String, helpers: [String], body_c: String) : String {
  match helpers {
    [] -> ""
    [h, ...rest] -> concat_all([
      emit_shrink_attempt(pname, h, body_c),
      emit_shrink_attempts_for_param(pname, rest, body_c)
    ])
  }
}

# All shrink attempts across every param in the with-clause. The
# enclosing round flag (_progressed) short-circuits subsequent attempts
# once any candidate sticks, so we always greedily restart from the
# first param after each accepted shrink — that matches QuickCheck's
# greedy strategy and keeps the iter budget focused on the most-
# productive prefix of params.

# All shrink attempts across every param in the with-clause. The
# enclosing round flag (_progressed) short-circuits subsequent attempts
# once any candidate sticks, so we always greedily restart from the
# first param after each accepted shrink — that matches QuickCheck's
# greedy strategy and keeps the iter budget focused on the most-
# productive prefix of params.
fn emit_shrink_attempts(params: [Param], body_c: String) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let helpers = match p.ptype {
        Some(t) -> check_shrink_for_ty(t)
        None -> []
      }
      concat_all([
        emit_shrink_attempts_for_param(written_text(p.binder.name), helpers, body_c),
        emit_shrink_attempts(rest, body_c)
      ])
    }
  }
}

# Re-records every param into the cx buffer (used after shrinking to
# rebuild the buffer with shrunk values).

# Re-records every param into the cx buffer (used after shrinking to
# rebuild the buffer with shrunk values).
fn emit_check_param_rerecord(params: [Param]) : String {
  match params {
    [] -> ""
    [p, ...rest] -> concat_all([
      "    kai_check_record_param(\"", written_text(p.binder.name), "\", ", c_local(written_text(p.binder.name)), ");\n",
      emit_check_param_rerecord(rest)
    ])
  }
}

# Drops every param at function-tail scope (no leading indent variant
# of emit_check_param_drops).

# Drops every param at function-tail scope (no leading indent variant
# of emit_check_param_drops).
fn emit_check_param_drops_tail(params: [Param]) : String {
  match params {
    [] -> ""
    [p, ...rest] -> concat_all([
      "    kai_decref(", c_local(written_text(p.binder.name)), ");\n",
      emit_check_param_drops_tail(rest)
    ])
  }
}

# Forward declares each param at function scope so the per-iter loop
# assigns into them and the post-loop shrink section can reference
# the surviving values. Initialised to NULL so the no-failure path
# leaves nothing to drop.

# Forward declares each param at function scope so the per-iter loop
# assigns into them and the post-loop shrink section can reference
# the surviving values. Initialised to NULL so the no-failure path
# leaves nothing to drop.
fn emit_check_param_decls(params: [Param]) : String {
  match params {
    [] -> ""
    [p, ...rest] -> concat_all([
      "    KaiValue *", c_local(written_text(p.binder.name)), " = NULL;\n",
      emit_check_param_decls(rest)
    ])
  }
}

# Emits the per-iter param init that ASSIGNS (not declares) into the
# function-scope locals so the post-loop shrink section can see them.

# Emits the per-iter param init that ASSIGNS (not declares) into the
# function-scope locals so the post-loop shrink section can see them.
fn emit_check_param_inits_assign(params: [Param], tab: SymTab) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let tyc = match p.ptype {
        Some(t) -> check_arbitrary_for_ty(t, tab)
        None -> check_arbitrary_panic("<missing>")
      }
      concat_all([
        "        ", c_local(written_text(p.binder.name)), " = ", tyc, ";\n",
        "        kai_check_record_param(\"", written_text(p.binder.name), "\", ", c_local(written_text(p.binder.name)), ");\n",
        emit_check_param_inits_assign(rest, tab)
      ])
    }
  }
}

fn emit_check_fn(src: String, id: Int, desc_span: String, params: [Param], body: Expr,
                 cx: EmitCtx, check_enc: String) : String / Console {

  let lcs2 = list_append(param_local_ids(params), cx.lcs)
  let body_cx = EmitCtx { ...cx, locals: ln_with_expr(ln_with_params(ln_empty(), params), body), lcs: lcs2,
                          hoisted: [], reuse_donor: None, kind1_raw: [], cur_enc_fn: check_enc }
  let body_c = emit_expr(src, body, body_cx)
  # Issue #438: hoist param locals to function scope so the post-loop
  # shrink section can keep mutating them. The per-iter loop now
  # assigns into them (not redeclares) and only drops on the OK path —
  # on failure the values survive so the shrinker can use them as the
  # starting point.
  let decls = emit_check_param_decls(params)
  let inits = emit_check_param_inits_assign(params, cx.tab)
  let iter_drops = emit_check_param_drops(params)
  let tail_drops = emit_check_param_drops_tail(params)
  let attempts = emit_shrink_attempts(params, body_c)
  let rerecord = emit_check_param_rerecord(params)
  concat_all([
    "static void _kai_check_", int_to_string(id), "(void) {\n",
    "    kai_check_begin(", desc_span, ");\n",
    "    int _kai_check_i;\n",
    "    int _kai_check_failed_at = -1;\n",
    decls,
    "    for (_kai_check_i = 0; _kai_check_i < KAI_CHECK_ITERS; _kai_check_i++) {\n",
    "        kai_check_cx_reset();\n",
    inits,
    "        KaiValue *_body = ", body_c, ";\n",
    "        int _ok = kai_op_truthy(_body);\n",
    "        kai_decref(_body);\n",
    "        if (!_ok) { _kai_check_failed_at = _kai_check_i; break; }\n",
    iter_drops,
    "    }\n",
    "    if (_kai_check_failed_at >= 0) {\n",
    "        kai_check_cx_save_orig();\n",
    "        int _kai_shrink_budget = kai_check_shrink_iters_limit();\n",
    "        int _kai_shrink_i;\n",
    "        for (_kai_shrink_i = 0; _kai_shrink_i < _kai_shrink_budget; _kai_shrink_i++) {\n",
    "            int _progressed = 0;\n",
    attempts,
    "            if (!_progressed) break;\n",
    "        }\n",
    "        kai_check_cx_reset();\n",
    rerecord,
    "        kai_check_fail_shrunk(_kai_check_failed_at);\n",
    tail_drops,
    "    }\n",
    "    else { kai_check_pass(KAI_CHECK_ITERS); }\n",
    "}\n\n"
  ])
}

fn check_decls(decls: [Decl]) : [Decl] =
  filter(decls, (d) => match d { DCheck(_, _, _, _, _, _) -> true _ -> false })

fn emit_one_check(src: String, cx: EmitCtx,
                  id_d: DeclWithId) : String / Console {

  match id_d {
    DWI(id, d) -> match d {
      DCheck(desc_span, ps, body, cl, cc, mo) ->
        emit_check_fn(src, id, desc_span, ps, body, cx, runner_enc_fn("check", mo, cl, cc))
      _ -> ""
    }
  }
}

fn number_checks_loop(decls: [Decl], id: Int, acc: [DeclWithId]) : [DeclWithId] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DCheck(_, _, _, _, _, _) -> number_checks_loop(rest, id + 1, [DWI(id, d), ...acc])
      _ -> number_checks_loop(rest, id, acc)
    }
  }
}

fn number_checks(decls: [Decl]) : [DeclWithId] =
  number_checks_loop(decls, 0, [])

fn emit_all_checks(src: String, decls: [Decl], cx: EmitCtx,
                   target_origin: Option[String]) : String / Console {

  let numbered = number_checks(decls)
  let rcx = cx
  concat_all(map(numbered, (dwi) => emit_one_check(src, rcx, dwi)))
}

fn check_count(decls: [Decl]) : Int = list_length(check_decls(decls))

fn check_call_list(n: Int, i: Int) : String {
  if i >= n { "" }
  else {
    concat_all(["    _kai_check_", int_to_string(i), "();\n", check_call_list(n, i + 1)])
  }
}

# The C symbol key of the function the binary starts, when a function is.
fn entry_csym(fns: [EFn], entry: SymId) : Option[String] = match fns {
  [] -> None
  [EFn(n, _, mo, _, f), ...rest] ->
    if is_entry(entry, f) { Some(c_sym(written_text(n), mo)) } else { entry_csym(rest, entry) }
}

# Option C runtime infrastructure — emit the impl-table + variant->head
# tables and a registration call before user main.
#
# Walks every DFn whose name starts with `__pimpl_` and synthesises a
# `KaiImplEntry { .proto_id = …, .head_tag = …, .fn = &kai_<sym> }`
# row. The protocol name and target type name are parsed back out of
# the mangled symbol (`__pimpl_<P>_<T>_<op>` and the heterogeneous
# variant `__pimpl_<P>_<T>_<op>__a_<args>`). User protocols / user types
# emit an `-1` slot that the runtime hashmap ignores; v1 supports the
# stdlib heads/protos pinned in `docs/variant-tags.md`.
#
# `kai_variant_to_head` is rebuilt the same way: every entry in
# `variants` (the global EVar table) gets its head tag derived from
# the constructor->sum mapping in the user's declarations.

# Option C runtime infrastructure — emit the impl-table + variant->head
# tables and a registration call before user main.
#
# Walks every DFn whose name starts with `__pimpl_` and synthesises a
# `KaiImplEntry { .proto_id = …, .head_tag = …, .fn = &kai_<sym> }`
# row. The protocol name and target type name are parsed back out of
# the mangled symbol (`__pimpl_<P>_<T>_<op>` and the heterogeneous
# variant `__pimpl_<P>_<T>_<op>__a_<args>`). User protocols / user types
# emit an `-1` slot that the runtime hashmap ignores; v1 supports the
# stdlib heads/protos pinned in `docs/variant-tags.md`.
#
# Emit `{tag, "name", mask}` rows for every constructor that carries a
# primitive slot — exactly the ctors the emitter lowers to
# `kai_variant_u_fast`, which no longer registers its own tag→name/mask.
# Walks the whole EVar table so the startup registration covers every
# such ctor regardless of where it is constructed. A ctor with no
# primitive slot is skipped (it goes through kai_variant_u, which still
# self-registers). The mask matches the construction site exactly
# (variant_slot_mask over the same payload tys).
fn emit_payload_ctor_rows(variants: [VariantEntry]) : String = match variants {
  []           -> ""
  [v, ...rest] -> match v {
    # The tag is the LAST field, not the arity that precedes it: reading
    # the arity as the tag stamps the mask under the wrong tag and leaves
    # the real tag's mask all-pointer, so the drop walker decrefs an
    # int/enum slot as if it were a pointer.
    EV(_, nm, _, tys, tag) ->
      if variant_has_primitive_slot(tys) {
        concat_all([
          "{", int_to_string(tag), ", \"", nm, "\", ",
          int_to_string(variant_slot_mask(tys)), "}, ",
          emit_payload_ctor_rows(rest)
        ])
      } else { emit_payload_ctor_rows(rest) }
  }
}

# `kai_variant_to_head` is registered as flattened (tag, head) pairs —
# tags are sparse (name-keyed), so the runtime builds the dense lookup.
fn emit_proto_runtime_tables(decls: [Decl], tab: SymTab, specs: SpecNames, variants: [VariantEntry], fns: [EFn], ids: ProtoIds, ctors: CtorIx, entry: SymId) : String {
  let impl_rows = collect_pimpl_rows(decls, fns, tab, ids, [])
  let v2h       = collect_variant_to_head(variants, decls, tab)
  let n_impl    = list_length(impl_rows)
  let n_v2h     = list_length(v2h)
  let impl_arr  = emit_impl_table_array(impl_rows, decls, tab)
  let v2h_arr   = emit_variant_to_head_array(v2h)
  # Boxed shims for the unboxed builtin impls registered in the table,
  # emitted before the table so `&kai_<csym>__boxed` resolves. The raw
  # pimpls they call are forward-declared with the other fn bodies.
  let shim_defs = emit_impl_shim_defs(impl_rows, [])
  let fwds      = concat_all([emit_pimpl_forwards(impl_rows, []), shim_defs])
  let reuse_tags  = reusable_tags(decls, ids, ctors, entry)
  let n_reuse     = list_length(reuse_tags)
  let reuse_arr   = emit_reuse_tag_array(reuse_tags)
  # Payload-ctor startup registration — name+mask for every primitive-slot
  # ctor, so kai_variant_u_fast carries no per-call register and inlines.
  let pctor_vars = filter_primitive_slot_ctors(variants)
  let n_pctor    = list_length(pctor_vars)
  let pctor_rows = emit_payload_ctor_rows(variants)
  let pctor_arr  = if n_pctor == 0 { "{-1, \"\", 0}" } else { pctor_rows }
  concat_all([
    fwds,
    "static const int32_t _kai_variant_to_head_pairs[] = {",
    v2h_arr,
    "};\n",
    "static const KaiImplEntry _kai_impl_table_entries[] = {",
    impl_arr,
    "};\n",
    "static const int32_t _kai_reusable_tags_tbl[] = {",
    reuse_arr,
    "};\n",
    "static const KaiPayloadCtor _kai_payload_ctors_tbl[] = {",
    pctor_arr,
    "};\n",
    "static void _kai_register_proto_tables(void) {\n",
    "    kai_register_variant_head_pairs(_kai_variant_to_head_pairs, ",
    int_to_string(n_v2h), ");\n",
    "    kai_register_impls(_kai_impl_table_entries, ",
    int_to_string(n_impl), ");\n",
    "    kai_register_reusable_tags(_kai_reusable_tags_tbl, ",
    int_to_string(n_reuse), ");\n",
    "    kai_register_payload_ctors(_kai_payload_ctors_tbl, ",
    int_to_string(n_pctor), ");\n",
    "}\n\n"
  ])
}

# Filter the EVar table to ctors carrying a primitive slot — the ones
# lowered to kai_variant_u_fast and needing startup name/mask registration.
fn filter_primitive_slot_ctors(variants: [VariantEntry]) : [VariantEntry] = match variants {
  []           -> []
  [v, ...rest] -> match v {
    EV(_, _, _, tys, _) ->
      if variant_has_primitive_slot(tys) {
        [v, ...filter_primitive_slot_ctors(rest)]
      } else { filter_primitive_slot_ctors(rest) }
  }
}

# A zero-length array initialiser is illegal in C99, so emit a single
# `-1` sentinel when no reuse ctors exist. `kai_register_reusable_tags`
# is then called with n=0 and never reads the slot; and even if it did,
# `-1` is out of range and ignored.
fn emit_reuse_tag_array(tags: [Int]) : String = match tags {
  []           -> "-1"
  [t, ...rest] -> concat_all([int_to_string(t), ", ", emit_reuse_tag_array_loop(rest)])
}

fn emit_reuse_tag_array_loop(tags: [Int]) : String = match tags {
  []           -> ""
  [t, ...rest] -> concat_all([int_to_string(t), ", ", emit_reuse_tag_array_loop(rest)])
}

fn emit_impl_table_array(rows: [PimplRow], decls: [Decl], tab: SymTab) : String =
  emit_impl_table_array_loop(rows, decls, tab, "")

fn emit_impl_table_array_loop(rows: [PimplRow], decls: [Decl], tab: SymTab, acc: String) : String {
  match rows {
    [] -> acc
    [pr, ...rest] -> match pr {
      PR(csym, p, t, _, _, op, home, _) -> {
        # The runtime calls a table entry as `KaiValue*(KaiValue*, …)` and
        # hands every argument owned. A raw-ABI impl, or one that borrows a
        # param, would misread or leak them, so it registers its shim.
        let fn_sym = if pimpl_row_needs_adapter(pr) {
          concat_all([c_user_sym(csym), "__boxed"])
        } else {
          concat_all([c_user_sym(csym)])
        }
        let line = concat_all(["\n    { .proto_id = ", stdlib_proto_id_c(p),
                                ", .op_id = ", stdlib_proto_op_id_c(p, op),
                                ", .head_tag = ", stdlib_head_tag_c(home, t, decls, tab),
                                ", .fn = (void *) &", fn_sym, " },"])
        emit_impl_table_array_loop(rest, decls, tab, concat_all([acc, line]))
      }
    }
  }
}

# The runtime head-tag C constant of an impl's target, which a lowered
# impl symbol carries as a spelling.
fn stdlib_head_tag_c(home: Option[String], tname: String, decls: [Decl], tab: SymTab) : String = match rt_head_named(tname) {
  Some(h) -> rt_head_c(h)
  None -> {
    # User-declared record/sum type: dense head tag (>= 20). -1 only when
    # the name names no record/sum decl (truly unknown).
    let ut = impl_target_head_tag(home, tname, decls, tab)
    if ut >= 0 { concat_all([int_to_string(ut), " /* user type: ", tname, " */"]) }
    else { concat_all(["-1 /* unknown type: ", tname, " */"]) }
  }
}

fn rt_head_c(h: RtHead) : String = match h {
  RhUnit        -> "KAI_HEAD_UNIT"
  RhBool        -> "KAI_HEAD_BOOL"
  RhInt         -> "KAI_HEAD_INT"
  RhReal        -> "KAI_HEAD_REAL"
  RhChar        -> "KAI_HEAD_CHAR"
  RhString      -> "KAI_HEAD_STRING"
  RhList        -> "KAI_HEAD_LIST"
  RhArray       -> "KAI_HEAD_ARRAY"
  RhByte        -> "KAI_HEAD_BYTE"
  RhVec         -> "KAI_HEAD_VEC"
  RhOption      -> "KAI_HEAD_OPTION"
  RhResult      -> "KAI_HEAD_RESULT"
  RhSignal      -> "KAI_HEAD_SIGNAL"
  RhProcessExit -> "KAI_HEAD_PROCESS_EXIT"
}

fn emit_variant_to_head_array(xs: [Int]) : String =
  emit_v2h_loop(xs, "")

fn emit_v2h_loop(xs: [Int], acc: String) : String {
  match xs {
    [] -> acc
    [v, ...rest] -> emit_v2h_loop(rest, concat_all([acc, " ", int_to_string(v), ","]))
  }
}

# Forward declarations for every `__pimpl_*` whose address we take in
# the impl table. These names are static fns in the same translation
# unit; the regular fwd block already declares them, but the impl
# table is emitted before user main and must be sure the names are
# in scope. Re-emitting the forwards is cheap and idempotent.

# Forward declarations for every `__pimpl_*` whose address we take in
# the impl table. These names are static fns in the same translation
# unit; the regular fwd block already declares them, but the impl
# table is emitted before user main and must be sure the names are
# in scope. Re-emitting the forwards is cheap and idempotent.
fn emit_pimpl_forwards(rows: [PimplRow], _seen: [String]) : String =
  emit_pimpl_forwards_loop(rows, [])

fn emit_pimpl_forwards_loop(rows: [PimplRow], seen: [String]) : String {
  match rows {
    [] -> ""
    [PR(csym, _, _, _, _, _, _, _), ...rest] ->
      if list_has(seen, csym) {
        emit_pimpl_forwards_loop(rest, seen)
      } else {
        concat_all(["/* impl-table address-of for &", c_user_sym(csym), " */\n",
                     emit_pimpl_forwards_loop(rest, [csym, ...seen])])
      }
  }
}

# Emit one shim `KaiValue *kai_<csym>__boxed(KaiValue *a0, …)` per impl
# row that needs an adapter. The dispatch sites incref the args and
# require the entry to consume them: the shim unboxes and decrefs raw
# args, boxes a raw return, and drops the args the impl borrows.
fn emit_impl_shim_defs(rows: [PimplRow], seen: [String]) : String {
  match rows {
    [] -> ""
    [pr, ...rest] -> match pr {
      PR(csym, _, _, arity, sig, _, _, lent) ->
        if list_has(seen, csym) or not pimpl_row_needs_adapter(pr) {
          emit_impl_shim_defs(rest, seen)
        } else {
          let shim = match sig {
            Some(US(pts, rt, mask)) -> emit_one_impl_shim(csym, pts, rt, mask, lent)
            None -> emit_impl_shim_body(csym, arity, "", concat_all([c_user_sym(csym), "(", shim_names("a", arity, 0), ")"]), lent)
          }
          concat_all([shim, emit_impl_shim_defs(rest, [csym, ...seen])])
        }
    }
  }
}

# Emit a single boxed shim. `pts` are the param tys, `rt` the return
# ty, `mask` the per-param raw flags (mixed-param lane). For each param:
#   - RAW slot: read `a_i->as.X` into `r_i`, decref `a_i` (consume), pass
#     `r_i` to the pimpl.
#   - BOXED slot: pass `a_i` straight through (the pimpl param is also
#     `KaiValue *`); the pimpl consumes the reference, matching the
#     dispatch contract (caller increfs args before calling).
# The return is boxed via `box_wrap` only when `rt` is unboxable; a
# boxed-return mixed pimpl already yields a `KaiValue *`, so wrapping it
# (e.g. with `kai_int`) would corrupt it — the `Complex add(self, rhs)`
# case that produced `kai_int(<KaiValue*>)`.
fn emit_one_impl_shim(csym: String, pts: [Ty], rt: Ty, mask: [Bool], lent: [Int]) : String {
  let unbox  = emit_shim_unbox_args_masked(pts, mask, 0)
  let args   = emit_shim_arg_list_masked(pts, mask, 0)
  let call   = concat_all([c_user_sym(csym), "(", args, ")"])
  let ret    = if ty_is_unboxable_t(rt) { box_wrap(Some(rt), call) } else { call }
  emit_impl_shim_body(csym, list_length(pts), unbox, ret, lent)
}

# Arity 0 spells `(void)`: an empty `()` is a K&R unspecified-args
# prototype, not the zero-arg shape the dispatcher casts the slot to.
fn emit_impl_shim_body(csym: String, arity: Int, unbox: String, ret: String, lent: [Int]) : String {
  let params = if arity == 0 { "void" } else { shim_names("KaiValue *a", arity, 0) }
  let tail = match lent {
    [] -> concat_all(["    return ", ret, ";\n"])
    _  -> concat_all(["    KaiValue *_r = ", ret, ";\n", emit_shim_drops(lent), "    return _r;\n"])
  }
  concat_all(["static KaiValue *", c_user_sym(csym), "__boxed(", params, ") {\n", unbox, tail, "}\n\n"])
}

# `<prefix>0, <prefix>1, …` up to `n`.
fn shim_names(prefix: String, n: Int, i: Int) : String =
  if i >= n { "" }
  else if i == n - 1 { cat2(prefix, int_to_string(i)) }
  else { concat_all([prefix, int_to_string(i), ", ", shim_names(prefix, n, i + 1)]) }

fn emit_shim_drops(lent: [Int]) : String = match lent {
  [] -> ""
  [i, ...rest] -> concat_all(["    kai_decref(a", int_to_string(i), ");\n", emit_shim_drops(rest)])
}

# `<raw_ty> r0 = a0->as.X; kai_decref(a0); …` per param. Decref consumes
# the boxed arg, matching the runtime dispatch contract (caller increfs
# a/b; impl owns + drops both).
fn emit_shim_unbox_args(pts: [Ty], i: Int) : String {
  match pts {
    [] -> ""
    [t, ...rest] -> {
      let ix = int_to_string(i)
      let line = concat_all([
        "    ", raw_c_type(Some(t)), " r", ix,
        " = ", unbox_boxed_scalar(concat_all(["a", ix]), Some(t)), ";\n",
        "    kai_decref(a", ix, ");\n"
      ])
      concat_all([line, emit_shim_unbox_args(rest, i + 1)])
    }
  }
}

# `r0, r1, …` — the raw scalar locals passed to the raw pimpl.
fn emit_shim_raw_arg_list(pts: [Ty], i: Int) : String {
  match pts {
    [] -> ""
    [_, ...rest] -> {
      let head = concat_all(["r", int_to_string(i)])
      match rest {
        [] -> head
        _  -> concat_all([head, ", ", emit_shim_raw_arg_list(rest, i + 1)])
      }
    }
  }
}

# Mask-aware unbox: a RAW param i reads `a_i->as.X` into `r_i` and
# decrefs `a_i` (consume). A BOXED param emits nothing here — it is
# passed straight through to the pimpl, which consumes the reference.
fn emit_shim_unbox_args_masked(pts: [Ty], mask: [Bool], i: Int) : String {
  match pts {
    [] -> ""
    [t, ...rest] -> {
      let is_raw = match mask {
        [m, ..._] -> m
        [] -> true
      }
      let mrest = match mask {
        [_, ...r] -> r
        [] -> []
      }
      let ix = int_to_string(i)
      let line = if is_raw {
        concat_all([
          "    ", raw_c_type(Some(t)), " r", ix,
          " = ", unbox_boxed_scalar(concat_all(["a", ix]), Some(t)), ";\n",
          "    kai_decref(a", ix, ");\n"
        ])
      } else { "" }
      concat_all([line, emit_shim_unbox_args_masked(rest, mrest, i + 1)])
    }
  }
}

# Mask-aware arg list: RAW param i passes `r_i` (the unboxed local),
# BOXED param i passes `a_i` (the original pointer) straight through.
fn emit_shim_arg_list_masked(pts: [Ty], mask: [Bool], i: Int) : String {
  match pts {
    [] -> ""
    [_, ...rest] -> {
      let is_raw = match mask {
        [m, ..._] -> m
        [] -> true
      }
      let mrest = match mask {
        [_, ...r] -> r
        [] -> []
      }
      let head = if is_raw { concat_all(["r", int_to_string(i)]) }
                 else { concat_all(["a", int_to_string(i)]) }
      match rest {
        [] -> head
        _  -> concat_all([head, ", ", emit_shim_arg_list_masked(rest, mrest, i + 1)])
      }
    }
  }
}

# Eager-seed every USER nullary constructor's singleton into the runtime's
# tag->singleton table (kai_enum_by_tag, via kai_nullary_install inside
# kai_variant_u). The enum-as-int slot store (`{.i64 = tag}`, emitted by
# emit_variant_slot_init / the TRMC rebuild for a literal nullary ctor)
# writes only the tag — it does NOT build the singleton — so a later
# `kai_enum_slot_box(slot.i64)` READ depends on the table already holding
# that tag. Lazy population was fine when the FIRST touch of a ctor was a
# kai_variant_u construction, but the direct-tag store can now be the
# first touch (rb-tree Red/Black), and a self-hosted-compiler enum could
# be slot-read before any construction — kai_enum_by_tag[tag] would be
# NULL and the read would return kai_unit(), corrupting behaviour (the
# selfhost is_digit divergence). Seeding user nullary ctors at main entry
# makes the direct store sound regardless of construction order. Building
# each singleton is one cached kai_variant_u; immortal, so no leak.
#
# Builtin nullary (tag < user base: None, Sig*) are NOT seeded — matching
# the native path: they are never an i64-inline enum slot and kai_nullary_fast
# self-installs them on first use, so eagerly minting their immortal singletons
# in a program that never touches them only inflates the KAI_TRACE_RC `leaked`
# baseline by the seed count.
fn emit_nullary_enum_seed(variants: [VariantEntry]) : String = match variants {
  [] -> ""
  [EV(_, nm, ar, _, tag), ...rest] ->
    if ar == 0 and tag >= user_variant_tag_base() {
      concat_all([
        "    kai_variant_u(", int_to_string(tag), ", \"", nm, "\", 0, 0, NULL);\n",
        emit_nullary_enum_seed(rest)
      ])
    } else { emit_nullary_enum_seed(rest) }
}

fn emit_main_wrapper(decls: [Decl], tab: SymTab, specs: SpecNames, ids: ProtoIds, ctors: CtorIx,
                     bmode: BuildMode, variants: [VariantEntry], fns: [EFn], entry: SymId) : String {
  let proto_tables = emit_proto_runtime_tables(decls, tab, specs, variants, fns, ids, ctors, entry)
  let proto_init   = concat_all(["    _kai_register_proto_tables();\n", emit_nullary_enum_seed(variants)])
  match bmode {
    BMTest  -> emit_runner_main(decls, tab, proto_tables, proto_init, test_register_list(decls), "kai_test_summary")
    BMBench -> emit_runner_main(decls, tab, proto_tables, proto_init, bench_call_list(bench_count(decls), 0), "kai_bench_summary")
    BMCheck -> emit_runner_main(decls, tab, proto_tables, proto_init, check_call_list(check_count(decls), 0), "kai_check_summary")
    BMBuild -> match entry_csym(fns, entry) {
      None -> ""
      Some(start) -> {
        # m7a #7: install default handlers around the entry point only for
        # the builtin effects that appear in its row. The push/pop
        # pair is syntactically balanced (Doc C §*Per-fiber isolation*);
        # pop runs even if the entry point returns. Pops are emitted in
        # reverse-push order so the evidence stack stays LIFO-balanced.
        #
        # Issue #115: the shim block below is emitted at file scope,
        # before `int main()`. Each shim has the typed signature
        # matching the EvX struct field and forwards to the runtime
        # void-self function. Setup assigns shim addresses without a
        # cast, so UBSan's `-fsanitize=function` (Linux clang's
        # `-fsanitize=undefined`, absent from Apple clang's default)
        # sees matching types at every dispatch through `_ev_op->op`.
        # Issue #308: drop any effect name whose decl is user-supplied
        # (line/col != 0). The default-handler emit assumes the builtin
        # EvX layout — emitting it for a user `effect Log { ... }` shape
        # produces invalid C against the user's struct.
        # Issue #531: install the base-installable defaults
        # (`Mutable`) UNCONDITIONALLY — present at the bottom of the
        # evidence stack even when `Mutable` is absent from main's row.
        # This is what lets the typer mask `Mutable` for any local
        # mutable value (Array / Ref / HashMap) without the dispatch
        # site segfaulting on a missing handler. `ensure_unconditional_
        # defaults` dedups, so a `/ Mutable` already in main's row stays
        # a single push/pop pair.
        # An extern-default effect a lexical handler absorbed from main's
        # row still needs its default node so a spawned fiber (empty
        # evidence, parent handler does not cross the boundary) resolves to
        # the default instead of dereferencing a zero-init node.
        let main_row = ensure_unconditional_defaults(
          add_missing_effects(
            default_effects_absorbed_by_handler(decls),
            cmt_row_effects_without_default_handler(main_row_labels(decls, entry), decls)))
        let shims    = default_shims_for(main_row, decls, tab)
        let setup    = default_setups_for(main_row, decls, tab)
        concat_all([
          shims,
          proto_tables,
          "int main(int argc, char **argv) {\n",
          "    kai_set_args(argc, argv);\n",
          proto_init,
          setup,
          "    KaiValue *_result = kai_sched_bootstrap(", c_user_sym(start), ");\n",
          "    int _status = kai_main_exit_status(_result);\n",
          "    kai_decref(_result);\n",
          "    return _status;\n",
          "}\n"
        ])
      }
    }
  }
}

# A runner entry calls each block directly, outside `kai_main`, so it
# stamps the same default nodes a program entry would for every effect a
# block may perform.
fn emit_runner_main(decls: [Decl], tab: SymTab, proto_tables: String, proto_init: String,
                    calls: String, summary: String) : String = {
  let row = runner_entry_row(decls)
  concat_all([
    default_shims_for(row, decls, tab),
    proto_tables,
    "int main(int argc, char **argv) {\n",
    "    kai_set_args(argc, argv);\n",
    proto_init,
    default_setups_for(row, decls, tab),
    calls,
    "    return ", summary, "();\n",
    "}\n"
  ])
}

fn default_shims_from_block(eff: SymId, decls: [Decl], tab: SymTab) : String =
  match find_effect_default_block(eff, decls) {
    None         -> ""
    Some(defblk) -> match defblk {
      DBlk(clauses, _, _, _) -> {
        let eff_name = rt_name(tab, eff)
        let evn = ev_name(eff_name, default_block_owner_mo(eff, decls))
        concat_all(map(clauses, (c) => default_shim_from_clause(eff_name, evn, c)))
      }
    }
  }

# The minted default is a frame-suppliable value, not a stack push: the
# call site fills a default-bearing slot with `&_kai_default_node_<eff>`. The
# Ev blob and node are file-scope globals (`emit_default_node_globals`) so any
# call site can address them; this only stamps the handler_id and op fn-ptrs
# at startup. No `kai_evidence_push` — the walk still resolves a lexical handler
# pushed above, but the default itself rides the frame.
fn default_setups_from_block(eff: SymId, decls: [Decl], tab: SymTab) : String =
  match find_effect_default_block(eff, decls) {
    None         -> ""
    Some(defblk) -> match defblk {
      DBlk(clauses, _, _, _) -> {
        let eff_name = rt_name(tab, eff)
        let eff_lc = string_to_lower_ascii(eff_name)
        concat_all([
          "    _kai_default_ev_", eff_lc, ".handler_id = kai_fresh_handler_id();\n",
          concat_all(map(clauses, (c) => default_setup_assign_from_clause(eff_name, c))),
          "    kai_evidence_init_default(&_kai_default_node_", eff_lc,
            ", \"", eff_name, "\", &_kai_default_ev_", eff_lc, ");\n"
        ])
      }
    }
  }

# File-scope `_kai_default_ev_<eff>` / `_kai_default_node_<eff>` definitions for
# every effect whose decl carries a `default {}` block — the superset, not just
# main's row, so a call site in a never-installed (dead-code) path still links.
# External linkage (one definition in the root TU, `extern` in the shared
# header) so a call site in any module TU addresses the same node. Zero-init;
# the per-program setup stamps handler_id + op fn-ptrs only for installed effects.
fn emit_default_node_globals(decls: [Decl], tab: SymTab) : String =
  concat_all(map(decls, (d) => default_node_global_for(d, decls, false, tab)))

# The `extern` declarations of the same globals, for the shared decls header.
fn emit_default_node_extern_decls(decls: [Decl], tab: SymTab) : String =
  concat_all(map(decls, (d) => default_node_global_for(d, decls, true, tab)))

fn default_node_global_for(d: Decl, decls: [Decl], ext: Bool, tab: SymTab) : String = match d {
  DEffect(_, esym, _, _, defblk, _, _, _) -> match defblk {
    Some(_) -> {
      let eff_name = rt_name(tab, esym)
      let eff_lc = string_to_lower_ascii(eff_name)
      let mo = default_block_owner_mo(esym, decls)
      let kw = if ext { "extern " } else { "" }
      concat_all([
        kw, ev_name(eff_name, mo), " _kai_default_ev_", eff_lc, ";\n",
        kw, "KaiEvidence _kai_default_node_", eff_lc, ";\n"
      ])
    }
    None -> ""
  }
  _ -> ""
}

# `rt` is an effect's emitted name, as an evidence-frame slot key holds it.
fn effect_has_default_block(rt: String, decls: [Decl], tab: SymTab) : Bool =
  any(collect_effect_ids(decls), (s) => rt_name(tab, s) == rt and
    (match find_effect_default_block(s, decls) { None -> false  Some(_) -> true }))

# The bridge to a runtime C handler. An op argument reaches the handler as an
# OWNED reference (the call site hands one over per op arg), and the shim is
# where that reference is released: the C bodies borrow their args and incref
# whatever they retain, so without the release here the argument is orphaned.
fn default_shim_from_clause(eff_name: String, ev_n: String, c: HClause) : String =
  match c {
    HC(head, params, body, _, _) -> {
      let op_name = clause_head_word(head)
      let csym_opt = extern_handler_c_symbol(body)
      match csym_opt {
        None        -> ""
        Some(csym_name) -> {
          let visible = op_args_only(params)
          let arg_decls = concat_all(map(visible, (p) => concat_all([", KaiValue *", c_local(written_text(p.binder.name))])))
          let arg_pass  = concat_all(map(visible, (p) => cat2(", ", c_local(written_text(p.binder.name)))))
          let releases  = concat_all(map(visible, (p) => concat_all(["    kai_decref(", c_local(written_text(p.binder.name)), ");\n"])))
          concat_all([
            "static KaiValue *_kai_default_", string_to_lower_ascii(eff_name),
              "_", op_name, "_shim(", ev_n, " *self",
              arg_decls, ", KaiCont *k) {\n",
            "    KaiValue *_op_r = ", csym_name, "(self", arg_pass, ", k);\n",
            releases,
            "    return _op_r;\n",
            "}\n"
          ])
        }
      }
    }
  }

# Build the per-clause field assignment line for the setup block:
#     _kai_default_ev_<eff_lc>.<op> = &_kai_default_<eff_lc>_<op>_shim;
# Returns "" when the clause is not an extern_handler bridge.

# Build the per-clause field assignment line for the setup block:
#     _kai_default_ev_<eff_lc>.<op> = &_kai_default_<eff_lc>_<op>_shim;
# Returns "" when the clause is not an extern_handler bridge.
fn default_setup_assign_from_clause(eff_name: String, c: HClause) : String =
  match c {
    HC(head, _, body, _, _) -> match extern_handler_c_symbol(body) {
      None    -> ""
      Some(_) -> {
        let op_name = clause_head_word(head)
        let eff_lc = string_to_lower_ascii(eff_name)
        concat_all([
          "    _kai_default_ev_", eff_lc, ".", op_name,
          " = &_kai_default_", eff_lc, "_", op_name, "_shim;\n"
        ])
      }
    }
  }

# Every effect of `main_row` whose declaration carries a `default { }`
# block bridged through `$extern_handler` is set up from that block.
fn default_setups_for(main_row: [SymId], decls: [Decl], tab: SymTab) : String =
  concat_all(map(default_install_order(main_row, tab), (eff) => default_setups_from_block(eff, decls, tab)))

# The effects of `main_row` in install order: the builtin defaults in the
# runtime's order, then the others in row order. It orders emitted text,
# so it reads each effect's run-time name.
fn default_install_order(main_row: [SymId], tab: SymTab) : [SymId] = {
  let builtins = builtin_default_install_order()
  list_append(default_builtins_in(builtins, main_row, tab),
              filter(main_row, (s) => not list_has(builtins, rt_name(tab, s))))
}

fn default_builtins_in(order: [String], main_row: [SymId], tab: SymTab) : [SymId] = match order {
  [] -> []
  [name, ...rest] -> list_append(default_row_named(main_row, name, tab), default_builtins_in(rest, main_row, tab))
}

fn default_row_named(main_row: [SymId], name: String, tab: SymTab) : [SymId] = match main_row {
  [] -> []
  [s, ...rest] -> if rt_name(tab, s) == name { [s] } else { default_row_named(rest, name, tab) }
}

# Push order for default handlers — mirrors the historic hardcoded
# arrangement so push/pop stays balanced and selfhost stays
# byte-identical. Pops in `default_pops_for` walk this list in
# reverse.

# Push order for default handlers — mirrors the historic hardcoded
# arrangement so push/pop stays balanced and selfhost stays
# byte-identical. Pops in `default_pops_for` walk this list in
# reverse.
fn builtin_default_install_order() : [String] =
  ["Stdout", "Stderr", "Stdin", "Env", "File", "Clock",
   "Random", "SecureRandom", "NetTcp", "NetDns", "Signal", "Process", "Log",
   "Mutable", "Cancel", "Link", "Monitor", "Spawn"]

# Issue #115: aggregate the typed shim definitions for every
# default handler that `default_setups_for` will install. Emitted
# at file scope before `int main()` so the shim addresses are in
# scope when the setup block assigns them. The pair-wise
# correspondence with `default_setups_for` is load-bearing — the
# setup expects `_kai_default_<eff>_<op>_shim` to be defined for
# every effect in `main_row`, and a missing shim shows up as a
# C compile error before the binary is produced (and well before
# UBSan would otherwise catch the type mismatch at runtime).

# Issue #115: aggregate the typed shim definitions for every
# default handler that `default_setups_for` will install. Emitted
# at file scope before `int main()` so the shim addresses are in
# scope when the setup block assigns them. The pair-wise
# correspondence with `default_setups_for` is load-bearing — the
# setup expects `_kai_default_<eff>_<op>_shim` to be defined for
# every effect in `main_row`, and a missing shim shows up as a
# C compile error before the binary is produced (and well before
# UBSan would otherwise catch the type mismatch at runtime).
fn default_shims_for(main_row: [SymId], decls: [Decl], tab: SymTab) : String =
  concat_all(map(default_install_order(main_row, tab), (eff) => default_shims_from_block(eff, decls, tab)))


fn desugar_op_calls_decls(ds: [Decl], effs: [SymId]) : [Decl] =
  map(ds, (d) => desugar_op_calls_decl(d, effs))

fn desugar_op_calls_decl(d: Decl, effs: [SymId]) : Decl {
  match d {
    DFn(pub_, fid, tps, ps, ret, row, body, l, c, mo) ->
      DFn(pub_, fid, tps, ps, ret, row, desugar_op_calls_expr(body, effs), l, c, mo)
    DTest(desc, body, l, c, mo) ->
      DTest(desc, desugar_op_calls_expr(body, effs), l, c, mo)
    DBench(desc, body, l, c, mo) ->
      DBench(desc, desugar_op_calls_expr(body, effs), l, c, mo)
    DCheck(desc, params, body, l, c, mo) ->
      DCheck(desc, params, desugar_op_calls_expr(body, effs), l, c, mo)
    _ -> d
  }
}

fn desugar_op_calls_expr(e: Expr, effs: [SymId]) : Expr =
  Expr { kind: desugar_op_calls_kind(e.kind, effs),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn desugar_op_calls_callee(callee: Expr, effs: [SymId]) : Expr {
  match callee.kind {
    EField(base, op_name) -> match base.kind {
      ESym(s, _) ->
        if any(effs, (e) => sym_same(e, s)) {
          mk_expr(EOp(OpRef { eff: s, op: written(op_name), via: ViaAmbient }), callee.line, callee.col)
        } else { desugar_op_calls_expr(callee, effs) }
      _ -> desugar_op_calls_expr(callee, effs)
    }
    _ -> desugar_op_calls_expr(callee, effs)
  }
}

fn desugar_op_calls_kind(k: ExprKind, effs: [SymId]) : ExprKind {
  match k {
    # The only kind that needs special handling: a callee still spelled
    # `Eff.op` on an effect's own id becomes the ambient perform of
    # that operation. Everything else recurses via the shared visitor.
    ECall(callee, args_) ->
      ECall(desugar_op_calls_callee(callee, effs),
            map(args_, (a) => desugar_op_calls_expr(a, effs)))
    _ -> map_expr_kind(k, (sub) => desugar_op_calls_expr(sub, effs))
  }
}

# Pre-typer recursion over `EIndex` and `SIndexAssign`. The pass no
# longer rewrites either form (issue #128 moved the dispatch to the
# typer so `Map[K, V]` and `Array[T]` can pick different lowerings).
# What the pass *does* do is walk every body so any sugar layered
# above this one — `EBlock` rewrites, var-cell desugar — sees the
# stmts in their original shape; an unmodified visitor would miss
# the `SIndexAssign` arm because it survives the typer too.

# Pre-typer recursion over `EIndex` and `SIndexAssign`. The pass no
# longer rewrites either form (issue #128 moved the dispatch to the
# typer so `Map[K, V]` and `Array[T]` can pick different lowerings).
# What the pass *does* do is walk every body so any sugar layered
# above this one — `EBlock` rewrites, var-cell desugar — sees the
# stmts in their original shape; an unmodified visitor would miss
# the `SIndexAssign` arm because it survives the typer too.
#[doc("Pre-typer recursion over `EIndex` and `SIndexAssign`. The pass no longer rewrites either form (issue #128 moved the dispatch to the typer so `Map[K, V]` and `Array[T]` can pick…")]
pub fn desugar_index_decls(ds: [Decl]) : [Decl] = map(ds, desugar_index_decl)

fn desugar_index_decl(d: Decl) : Decl {
  match d {
    DFn(pub_, fid, tps, ps, ret, row, body, l, c, mo) ->
      DFn(pub_, fid, tps, ps, ret, row, desugar_index_expr(body), l, c, mo)
    DTest(desc, body, l, c, mo) -> DTest(desc, desugar_index_expr(body), l, c, mo)
    DBench(desc, body, l, c, mo) -> DBench(desc, desugar_index_expr(body), l, c, mo)
    DCheck(desc, params, body, l, c, mo) -> DCheck(desc, params, desugar_index_expr(body), l, c, mo)
    _ -> d
  }
}

fn desugar_index_expr(e: Expr) : Expr =
  Expr { kind: desugar_index_kind(e.kind, e.line, e.col),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn desugar_index_opt(opt: Option[Expr]) : Option[Expr] {
  match opt {
    Some(e) -> Some(desugar_index_expr(e))
    None    -> None
  }
}

fn desugar_index_stmts(ss: [Stmt]) : [Stmt] = map(ss, desugar_index_stmt)

fn desugar_index_stmt(s: Stmt) : Stmt {
  match s {
    SLet(pat, ann, rhs) -> SLet(pat, ann, desugar_index_expr(rhs))
    SAssert(c, m) -> SAssert(desugar_index_expr(c), desugar_index_opt(m))
    SExprStmt(x) -> SExprStmt(desugar_index_expr(x))
    # issue #128: SIndexAssign now flows through to the typer, which
    # dispatches on the container's inferred type (Array → array_set
    # call; Map → typed error). Sub-exprs still recurse so any nested
    # sugars below this layer are picked up.
    SIndexAssign(b, i, v, line, col) ->
      SIndexAssign(desugar_index_expr(b), desugar_index_expr(i),
                   desugar_index_expr(v), line, col)
    SAssign(b, v, line, col) ->
      SAssign(desugar_index_expr(b), desugar_index_expr(v), line, col)
    # m7b #5: pass through; the var-desugar pass below transforms SVar
    # into a `handle ... with State[T](init)` form. Until that pass runs
    # we still need to recurse into `init` so any nested `a[i]` inside
    # the initialiser is rewritten.
    SVar(n, ty, rhs, l, c) -> SVar(n, ty, desugar_index_expr(rhs), l, c)
    # m7e §25: SUse pass through.
    SUse(n, l, c) -> SUse(n, l, c)
  }
}

fn desugar_index_kind(k: ExprKind, line: Int, col: Int) : ExprKind {
  match k {
    # issue #128: EIndex now flows through to the typer, which
    # dispatches by the container's inferred type (Array → array_get
    # call; Map → map_get call returning Option[V]). The pass still
    # walks sub-expressions because EBlock stmt-bodies carry the
    # SIndexAssign variant we now also leave intact.
    EBlock(stmts, tail) -> EBlock(desugar_index_stmts(stmts),
                                   desugar_index_opt(tail))
    _ -> map_expr_kind(k, desugar_index_expr)
  }
}

fn proto_dispatch_tag() : String = "__kai_proto_dispatch__"

fn mk_proto_dispatch_body(pname: String, opname: String, line: Int, col: Int) : Expr =
  mk_expr(ETodo(concat_all([proto_dispatch_tag_prefix(), pname, ":", opname])), line, col)

# Everything the re-parsed body of a `#{...}` span must inherit from
# its environment. The lift parses that span long after the whole-
# program passes ran, so each table a pass consumed has to reach the
# sub-tree through this record: the reading decl's segmented module
# table (import aliases are per file) rides in `cs.mt`, the const
# collision context is keyed by the decl's home. Growing the inherited
# environment means growing this record, not another parameter thread.
# `locals` holds the names lexically bound where the span sits. The
# fragment is parsed with no surrounding scope, so without it the
# qualified-call resolver reads `pa.Node` against the module table and
# a local `pa` that shadows module `pa` loses its projection.
type InterpCtx = { file: String, cs: CSCtx, show: Option[ExprKind],
                   ts: Option[TSCtx], es: Option[ESCtx], locals: [String] }

#[doc("Emit-layer entry point desugar_interp_decls. `show` names the dispatcher of the core `Show` every `#{...}` calls: user code reaches it through its home, so only that home's protocols answer; `None` leaves the op a bare name. `cores` names the core modules, whose own interpolations reach it bare — they are typed before that module's dispatchers exist. `ts_coll`/`es_coll` are the contested type/effect tables the freshly-parsed interp fragments respell against.")]
pub fn desugar_interp_decls(ds: [Decl],
      global_mt: [ModuleEntry], scopes: [ModScope], coll: [NEnt],
      ts_coll: [TSEntry], es_coll: [ESEntry], tab: SymTab, views: FileViews,
      target: String, file: String, show: Option[ShowRef],
      cores: [String]) : [Decl] / Console + File =
  desugar_interp_decls_loop(ds, global_mt, scopes,
                            coll, ts_coll, es_coll, tab, views,
                            scope_imports(scopes, global_mt),
                            target, file, show, cores, target, [])

fn desugar_interp_decls_loop(ds: [Decl],
      global_mt: [ModuleEntry], scopes: [ModScope], coll: [NEnt],
      ts_coll: [TSEntry], es_coll: [ESEntry], tab: SymTab, views: FileViews, imps: [ModImports],
      target: String, file: String, show: Option[ShowRef], cores: [String],
      cur: String, acc: [Decl]) : [Decl] / Console + File {

  match ds {
    [] -> list_reverse(acc)
    [d, ...rest] -> {
      let home = nu_reader_home(d, cur, target)
      let seg = if home == target { "" } else { home }
      let cx = InterpCtx { file: file,
                           cs: CSCtx { coll: coll, home: home, target: target,
                                       free: false,
                                       mt: ms_table(scopes, seg, global_mt) },
                           show: interp_show_from(show, list_has(cores, home)),
                           ts: if list_length(ts_coll) == 0 { None }
                               else { Some(ts_ctx(ts_coll, home, target, cores, scopes, global_mt, imps, [])) },
                           es: if list_length(es_coll) == 0 { None }
                               else { Some(es_ctx(es_coll, home, target, cores, scopes, global_mt, tab, views)) },
                           locals: [] }
      desugar_interp_decls_loop(rest, global_mt, scopes,
                                coll, ts_coll, es_coll, tab, views, imps,
                                target, file, show, cores, home,
                                [desugar_interp_decl(d, cx), ...acc])
    }
  }
}

# `cx` with `names` added to the lexical scope the spans below sit in.
fn interp_bind(cx: InterpCtx, names: [String]) : InterpCtx =
  InterpCtx { file: cx.file,
              cs: cx.cs, show: cx.show, ts: cx.ts, es: cx.es,
              locals: list_append(names, cx.locals) }

# The lift runs on parser output, where a binder is the name it was
# written with.
fn interp_param_names(ps: [Param]) : [String] = map(ps, (p) => written_text(p.binder.name))

fn interp_pat_names(pat: Pattern) : [String] = map(pat_bindings(pat, []), (b) => written_text(b.name))

# Every declaration form the resolver walks is lifted, so no span
# reaches it as text.
fn desugar_interp_decl(d: Decl, cx: InterpCtx) : Decl / Console + File =
  decl_map_inner(d, (x) => desugar_interp_leaf(x, cx))

fn desugar_interp_leaf(d: Decl, cx: InterpCtx) : Decl / Console + File {

  match d {
    DConst(p, s, ty, body, mo, l, c) ->
      DConst(p, s, ty, desugar_interp_expr(body, cx), mo, l, c)
    DFn(p, fid, tps, ps, ret, row, body, l, c, mo) ->
      DFn(p, fid, tps, ps, ret, row,
          desugar_interp_expr(body, interp_bind(cx, interp_param_names(ps))), l, c, mo)
    DTest(desc, body, l, c, mo) ->
      DTest(desc, desugar_interp_expr(body, cx), l, c, mo)
    DBench(desc, body, l, c, mo) ->
      DBench(desc, desugar_interp_expr(body, cx), l, c, mo)
    DCheck(desc, ps, body, l, c, mo) ->
      DCheck(desc, ps,
             desugar_interp_expr(body, interp_bind(cx, interp_param_names(ps))), l, c, mo)
    _ -> d
  }
}

fn desugar_interp_expr(e: Expr, cx: InterpCtx) : Expr / Console + File =

  Expr { kind: desugar_interp_kind(e.kind, cx, e.line, e.col),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn desugar_interp_kind(k: ExprKind, cx: InterpCtx,
                        line: Int, col: Int) : ExprKind / Console + File {

  match k {
    # An EStr with `#{...}` interpolation lifts into a
    # `string_concat_all([...])` call so the typer sees the interp
    # body's typed expressions and protocol ops route through the
    # user's `impl Show for T`.
    EStr(span, is_triple) -> {
      let n = string_length(span)
      let body_start = if is_triple { 3 } else { 1 }
      let body_end = if is_triple { n - 3 } else { n - 1 }
      if has_interp(span, body_start, body_end) {
        lift_interp_string(span, body_start, body_end, cx, line, col)
      } else { k }
    }
    ECall(c, args_) -> ECall(desugar_interp_expr(c, cx),
                              map(args_, (a) => desugar_interp_expr(a, cx)))
    # Inlined from `map_expr_kind` for issue #528 (effect-row propagation
    # blocked by stage 1's lack of row polymorphism on function-param types).
    EInt(_, _)        -> k
    EReal(_, _)       -> k
    EIntLit(_)        -> k
    EDecimalLit(_)    -> k
    EFixed(_, _)      -> k
    EBool(_)       -> k
    EChar(_)       -> k
    EUnit          -> k
    EName(_)        -> k
    EMark(_)        -> k
    ESym(_, _)      -> k
    ELocal(_)       -> k
    EOp(_)          -> k
    EUnder         -> k
    EPlaceholder   -> k
    EHole(_)       -> k
    ETodo(_)       -> k
    EExternBody(_, _) -> k
    EVariantsOf(_, _) -> k
    EModCall(_, _) -> k
    EIntrinsic(name, args_) ->
      EIntrinsic(name, map(args_, (a) => desugar_interp_expr(a, cx)))
    ESurface(sf) ->
      ESurface(surface_rebuild(sf, map(surface_children(sf), (a) => desugar_interp_expr(a, cx))))
    EField(base, name)   -> EField(desugar_interp_expr(base, cx), name)
    EIndex(a, b)         -> EIndex(desugar_interp_expr(a, cx),
                                    desugar_interp_expr(b, cx))
    EBinop(op, a, b)     -> EBinop(op, desugar_interp_expr(a, cx),
                                        desugar_interp_expr(b, cx))
    EUnop(op, x)         -> EUnop(op, desugar_interp_expr(x, cx))
    EIf(c, t_, eo)       -> EIf(desugar_interp_expr(c, cx),
                                  desugar_interp_expr(t_, cx),
                                  desugar_interp_expr_opt(eo, cx))
    EMatch(scr, arms)    -> EMatch(desugar_interp_expr(scr, cx),
                                     desugar_interp_arms(arms, cx))
    ELambda(ps, b)       -> ELambda(ps, desugar_interp_expr(b, interp_bind(cx, interp_param_names(ps))))
    ERecordLit(rh, fs)   -> ERecordLit(rh, desugar_interp_fields_init(fs, cx))
    EList(els)           -> EList(desugar_interp_list_elems(els, cx))
    ERange(a, b, opt_step) -> ERange(desugar_interp_expr(a, cx),
                                       desugar_interp_expr(b, cx),
                                       desugar_interp_expr_opt(opt_step, cx))
    EBlock(stmts, tail)  -> match desugar_interp_block(stmts, cx, []) {
      IBlk(ss, cx1) -> EBlock(ss, desugar_interp_expr_opt(tail, cx1))
    }
    EPipe(a, b)          -> EPipe(desugar_interp_expr(a, cx),
                                    desugar_interp_expr(b, cx))
    EMapPipe(a, b)       -> EMapPipe(desugar_interp_expr(a, cx),
                                       desugar_interp_expr(b, cx))
    EFlatMapPipe(a, b)   -> EFlatMapPipe(desugar_interp_expr(a, cx),
                                            desugar_interp_expr(b, cx))
    EFilterPipe(a, b)    -> EFilterPipe(desugar_interp_expr(a, cx),
                                           desugar_interp_expr(b, cx))
    EHandle(body, eff, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) ->
      EHandle(desugar_interp_expr(body, cx), eff, eff_tyargs,
              desugar_interp_expr_opt(init_opt, cx), alias_opt,
              desugar_interp_hclauses(clauses, cx),
              desugar_interp_hreturn_opt(ret_opt, cx))
    ELitUnit(inner, u)   -> ELitUnit(desugar_interp_expr(inner, cx), u)
    EBang(inner)         -> EBang(desugar_interp_expr(inner, cx))
  }
}

# Issue #528 helpers for `desugar_interp_kind` — direct walkers that
# replace the `map_expr_kind` HOF call. Stage 1 cannot parse row
# polymorphism on function-param types.
fn desugar_interp_expr_opt(opt: Option[Expr], cx: InterpCtx) : Option[Expr] / Console + File = match opt {
  None    -> None
  Some(x) -> Some(desugar_interp_expr(x, cx))
}

fn desugar_interp_arms(arms: [Arm], cx: InterpCtx) : [Arm] / Console + File = match arms {
  []           -> []
  [h, ...rest] -> [desugar_interp_arm(h, cx), ...desugar_interp_arms(rest, cx)]
}

fn desugar_interp_arm(a: Arm, cx: InterpCtx) : Arm / Console + File = match a {
  Arm(pat, guard_opt, body) -> {
    let cxa = interp_bind(cx, interp_pat_names(pat))
    Arm(pat,
        desugar_interp_expr_opt(guard_opt, cxa),
        desugar_interp_expr(body, cxa))
  }
}

fn desugar_interp_fields_init(fs: [FieldInit], cx: InterpCtx) : [FieldInit] / Console + File = match fs {
  []           -> []
  [h, ...rest] -> [desugar_interp_field_init(h, cx),
                   ...desugar_interp_fields_init(rest, cx)]
}

fn desugar_interp_field_init(fi: FieldInit, cx: InterpCtx) : FieldInit / Console + File = match fi {
  FI(name, e) -> FI(name, desugar_interp_expr(e, cx))
}

fn desugar_interp_list_elems(els: [ListElem], cx: InterpCtx) : [ListElem] / Console + File = match els {
  []           -> []
  [h, ...rest] -> [desugar_interp_list_elem(h, cx),
                   ...desugar_interp_list_elems(rest, cx)]
}

fn desugar_interp_list_elem(el: ListElem, cx: InterpCtx) : ListElem / Console + File = match el {
  ElPlain(e)  -> ElPlain(desugar_interp_expr(e, cx))
  ElSpread(e) -> ElSpread(desugar_interp_expr(e, cx))
}

# A block's statements bind left to right: each `let` / `var` is in
# scope for the spans that follow it, and for the block's tail.
type IBlk = IBlk([Stmt], InterpCtx)

fn desugar_interp_block(ss: [Stmt], cx: InterpCtx, acc: [Stmt]) : IBlk / Console + File = match ss {
  []           -> IBlk(list_reverse(acc), cx)
  [h, ...rest] -> desugar_interp_block(rest, interp_stmt_binds(h, cx),
                                       [desugar_interp_stmt(h, cx), ...acc])
}

fn interp_stmt_binds(s: Stmt, cx: InterpCtx) : InterpCtx = match s {
  SLet(p, _, _)       -> interp_bind(cx, interp_pat_names(p))
  SVar(b, _, _, _, _) -> interp_bind(cx, [written_text(b.name)])
  _ -> cx
}

fn desugar_interp_stmt(s: Stmt, cx: InterpCtx) : Stmt / Console + File = match s {
  SLet(p, ann, rhs) -> SLet(p, ann, desugar_interp_expr(rhs, cx))
  SAssert(e, msg_opt) -> SAssert(desugar_interp_expr(e, cx),
                                  desugar_interp_expr_opt(msg_opt, cx))
  SExprStmt(e) -> SExprStmt(desugar_interp_expr(e, cx))
  SIndexAssign(arr, idx, rhs, ln, cl) ->
    SIndexAssign(desugar_interp_expr(arr, cx),
                  desugar_interp_expr(idx, cx),
                  desugar_interp_expr(rhs, cx), ln, cl)
  SAssign(lhs, rhs, ln, cl) ->
    SAssign(desugar_interp_expr(lhs, cx),
             desugar_interp_expr(rhs, cx), ln, cl)
  SVar(name, ann, rhs, ln, cl) -> SVar(name, ann, desugar_interp_expr(rhs, cx), ln, cl)
  SUse(_, _, _) -> s
}

fn desugar_interp_hclauses(cs: [HClause], cx: InterpCtx) : [HClause] / Console + File = match cs {
  []           -> []
  [h, ...rest] -> [desugar_interp_hclause(h, cx),
                   ...desugar_interp_hclauses(rest, cx)]
}

fn desugar_interp_hclause(c: HClause, cx: InterpCtx) : HClause / Console + File = match c {
  HC(op_name, ps, body, ln, cl) ->
    HC(op_name, ps, desugar_interp_expr(body, interp_bind(cx, interp_param_names(ps))), ln, cl)
}

fn desugar_interp_hreturn_opt(opt: Option[HReturn], cx: InterpCtx) : Option[HReturn] / Console + File = match opt {
  None    -> None
  Some(r) -> Some(desugar_interp_hreturn(r, cx))
}

fn desugar_interp_hreturn(r: HReturn, cx: InterpCtx) : HReturn / Console + File = match r {
  HR(b, body, ln, cl) -> HR(b, desugar_interp_expr(body, interp_bind(cx, [written_text(b.name)])), ln, cl)
}

fn lift_interp_string(span: String, body_start: Int, body_end: Int,
                       cx: InterpCtx, line: Int, col: Int) : ExprKind / Console + File {

  let parts = iscan_collect(span, body_end,
                             IScan { parts: [], lit_start: body_start, i: body_start })
  # `body_start` chars of the literal's opening delimiter sit before the body.
  let part_exprs = interp_parts_to_exprs(parts, InterpPos { line: line, col: col + body_start },
                                          cx, line, col)
  ECall(mk_name("string_concat_all", line, col),
        [mk_expr(EList(map(part_exprs, (e: Expr) => ElPlain(e))), line, col)])
}

# Where a part begins in the real source.
type InterpPos = { line: Int, col: Int }

# Advance a position over `s`, which a triple-quoted literal may spread
# across several lines; a newline resets the column rather than extending it.
fn interp_pos_advance(p: InterpPos, s: String, i: Int) : InterpPos {
  if i >= string_length(s) { p }
  else {
    let nxt = match char_at(s, i) {
      Some('\n') -> InterpPos { line: p.line + 1, col: 1 }
      _          -> InterpPos { line: p.line, col: p.col + 1 }
    }
    interp_pos_advance(nxt, s, i + 1)
  }
}

# Walk the parts in source order so each interpolated expression is rebased
# onto the position it really occupies. A literal advances by its own text;
# an interpolation advances by its body plus the `#{` and `}` around it.
fn interp_parts_to_exprs(parts: [IPart], pos: InterpPos, cx: InterpCtx,
                          line: Int, col: Int) : [Expr] / Console + File {
  match parts {
    [] -> []
    [p, ...rest] -> {
      let e = interp_part_to_expr(p, pos, cx, line, col)
      let next = match p {
        IpLit(piece, _) -> interp_pos_advance(pos, piece, 0)
        # `#{` before the body, `}` after it.
        IpExp(src) -> {
          let after = interp_pos_advance(InterpPos { line: pos.line, col: pos.col + 2 }, src, 0)
          InterpPos { line: after.line, col: after.col + 1 }
        }
      }
      [e, ...interp_parts_to_exprs(rest, next, cx, line, col)]
    }
  }
}

# Effect scoping runs before type scoping, mirroring the driver order.
fn interp_scope_frag(e: Expr, cx: InterpCtx) : Expr = {
  let e1 = match cx.es { Some(esc) -> es_expr_scoped(e, esc)  None -> e }
  let e2 = match cx.ts { Some(tsc) -> ts_expr_scoped(e1, tsc)  None -> e1 }
  # A qualified handler head (`with m.E`) reaches the typer bare, the
  # same shape the whole-program pass produces for a head written
  # outside a span.
  qh_expr(e2, cx.cs.mt)
}

fn interp_part_to_expr(p: IPart, pos: InterpPos, cx: InterpCtx,
                        line: Int, col: Int) : Expr / Console + File {

  match p {
    IpLit(_, raw_quoted) -> mk_expr(EStr(raw_quoted, false), line, col)
    IpExp(expr_src) -> {
      # The body starts past the `#{` that opens it.
      let body = InterpPos { line: pos.line, col: pos.col + 2 }
      let inner = match parse_interp_expr(expr_src) {
        # The freshly-parsed sub-expression must go through the early
        # whole-program rewrites it missed while locked in a string
        # span; every one is idempotent on already-rewritten trees:
        #
        # - `interp_scope_frag` respells contested type/effect names,
        #   so a qualified `m.T` picks its home (`T__m`) and matches
        #   every other use site. Runs first, mirroring the driver's
        #   pass order.
        # - the const-keying pass keys a qualified read of a colliding
        #   pub const before rqc collapses its uppercase form to a
        #   bare EVar (the variant-ctor rule). Free reads are left
        #   alone (`free` off): the driver re-runs the full pass over
        #   the lifted stream, where lexical scope is tracked.
        # - the qualified-call resolver keeps `list.sum(xs)` and other
        #   `mod.fn(args)` shapes from surfacing to the typer as an
        #   unresolved EField on a module-name EVar. The table is the
        #   reading decl's segmented one, so a per-file import alias
        #   resolves here just as it does outside the span.
        Some(e) -> desugar_interp_expr(
                     rqc_expr(nu_const_expr(interp_scope_frag(surface_lower_expr(prc_rebase_expr(e, body.line, body.col)), cx),
                                     cx.locals, cx.cs),
                              cx.locals, cx.cs.mt, [], cx.file),
                     cx)
        None    -> mk_expr(EStr("\"\"", false), line, col)
      }
      mk_expr(ECall(mk_expr(interp_show_callee(cx), line, col), [inner]), line, col)
    }
  }
}

# The dispatcher a `#{...}` calls. User code names it through its home:
# a qualified reference dispatches among that home's protocols only, so a
# user protocol with a `show` op never captures the interpolation, not
# even inside its own module. A bare reference to the same dispatcher
# would dispatch among every protocol declaring `show`, which is what a
# core module's own interpolation means.
fn interp_show_from(show: Option[ShowRef], in_core: Bool) : Option[ExprKind] = match show {
  Some(ShowRef(homed, bare)) -> Some(if in_core { bare } else { homed })
  None                       -> None
}

# With no core `Show` the op stays the name any protocol declaring `show`
# answers to.
fn interp_show_callee(cx: InterpCtx) : ExprKind = match cx.show {
  Some(k) -> k
  None    -> EName(written(proto_dispatcher_name("show")))
}

# ====================================================================
# Separate compilation (issue #748): per-module .h/.c emission.
# ====================================================================
#
# `emit_program` (below) is the single-translation-unit path — the
# default, and the ONLY path the bootstrap / selfhost chain exercises,
# so it stays byte-identical. `emit_program_modular` is the additive
# opt-in path used by `kai build` on USER programs (driver flag
# `--emit=c-modular`). It reuses every section emitter unchanged but
# PARTITIONS `decls` by module-origin (`mo`) and emits, per module, a
# `.c` translation unit; plus a per-TU pair of header slices every `.c`
# includes:
#
#   kai_types_<stem>.h — `#include "runtime.h"` + the struct/typedef/
#                        effect-env definitions the TU references.
#   kai_decls_<stem>.h — the function/thunk/lambda/clause prototypes the
#                        TU references, over the whole program, so any
#                        cross-module call resolves at compile time.
#
# The slices are projections of the whole-program header text, computed
# in `emit_slices` by identifier reference, so a declaration added in
# one module re-keys only the TUs that reference it — the lever that
# lets the wrapper's per-.o cache survive type/fn additions.
#
# Each `<mod>.c` carries only ITS module's fn bodies (mo-filtered).
# Lambdas, clause bodies, tests, benches, checks and the `main`
# wrapper all land in the root TU (`__root__.c`): LamInfo/ClauseInfo
# carry no `mo` (collect_decls flattens away the parent decl's origin),
# so routing them to root is the link-safe choice (no duplicate symbol,
# no missing definition). Sealing the real parent-mo into LamInfo /
# ClauseInfo is a follow-up with its own fixture.
#
# Output is one String with file markers the `bin/kai` wrapper splits:
#   //KAIDELIM:<nonce>        (line 1 — declares the marker nonce)
#   //KAIFILE:<nonce>::<name> (column 0 — starts file <name>)
# The nonce is derived per compile from the program text length so the
# marker cannot collide with emitted C by construction.

#[doc("Collect the distinct module names (Some(m)) appearing across decls, root excluded. Order: first-seen.")]
fn distinct_module_origins(decls: [Decl]) : [String] =
  distinct_module_origins_loop(decls, [])

fn distinct_module_origins_loop(decls: [Decl], acc: [String]) : [String] = match decls {
  [] -> list_reverse(acc)
  [d, ...rest] -> match modular_home(d) {
    Some(m) -> if list_has(acc, m) { distinct_module_origins_loop(rest, acc) }
               else                { distinct_module_origins_loop(rest, [m, ...acc]) }
    None    -> distinct_module_origins_loop(rest, acc)
  }
}

#[doc("Keep only the decls whose modular home equals `mo` (Some(m) for a module TU, None for the root TU).")]
fn decls_of_origin(decls: [Decl], mo: Option[String]) : [Decl] =
  decls_of_origin_loop(decls, mo, [])

fn decls_of_origin_loop(decls: [Decl], mo: Option[String], acc: [Decl]) : [Decl] = match decls {
  [] -> list_reverse(acc)
  [d, ...rest] -> if origin_eq(modular_home(d), mo) { decls_of_origin_loop(rest, mo, [d, ...acc]) }
                  else                              { decls_of_origin_loop(rest, mo, acc) }
}

# A monomorphised instance homes to its generic's module, but WHICH
# instances exist follows the whole program's call sites, so module TUs
# carrying them would be program-dependent — unsound for a core-TU cache
# keyed on core sources alone. Instances emit in the root TU; module TUs
# see their prototypes through the identifier-keyed decls slices.
fn modular_home(d: Decl) : Option[String] = match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) ->
    if fnid_inst(fid) != spec_none() { None } else { home_tu(d) }
  _ -> home_tu(d)
}

fn origin_eq(a: Option[String], b: Option[String]) : Bool = match a {
  None    -> match b { None -> true  Some(_) -> false }
  Some(x) -> match b { None -> false Some(y) -> x == y }
}

#[doc("Sanitise a module-origin into a C-source filename stem. Root -> `__root__`; a module `m` -> `m` with dots replaced by `_` (e.g. `geo.shapes` -> `geo_shapes`).")]
fn tu_stem(mo: Option[String]) : String = match mo {
  None    -> "__root__"
  Some(m) -> dots_to_underscores(m)
}

fn dots_to_underscores(s: String) : String = dots_to_underscores_loop(s, 0, string_length(s), "")
fn dots_to_underscores_loop(s: String, i: Int, n: Int, acc: String) : String =
  if i >= n { acc }
  else {
    let c = string_slice(s, i, 1)
    let c2 = if c == "." { "_" } else { c }
    dots_to_underscores_loop(s, i + 1, n, string_concat(acc, c2))
  }

#[doc("A per-module C translation unit: filename stem + the `.c` text (without the shared-header includes, which the wrapper-level assembly prepends).")]
type CModuleTU = { stem: String, body: String }

#[doc("Issue #748 — separate-compilation entry point. Emits the program as N per-module translation units plus two shared headers, joined into one marker-delimited String the `bin/kai` wrapper splits into files. Reuses every `emit_program` section emitter; the only new work is partitioning `decls` by module-origin.")]
pub fn emit_program_modular(file: String, src: String, raw_decls: [Decl], tab: SymTab, specs: SpecNames, ids: ProtoIds, bmode: BuildMode, target_origin: Option[String], entry: SymId, regions: [RegionMark], stamp_ids: [SymId]) : String / Console + Mutable =
  match emit_program_modular_cached(file, src, raw_decls, tab, specs, ids, bmode, target_origin, entry, regions, [], [], stamp_ids) {
    EMO(stream, _) -> stream
  }

#[doc("The c-modular emitter's result: the marker-delimited stream plus the freshly emitted bodies of the cache-eligible TUs (for the emit cache's write path; empty when none were eligible).")]
pub type EmitModularOut = EMO(String, [CTU])

#[doc("As `emit_program_modular`, with the core emit cache threaded through: TUs whose stem appears in `cached` splice the cached body instead of emitting; freshly emitted TUs whose module origin appears in `cacheable` are returned for the caller to persist.")]
pub fn emit_program_modular_cached(file: String, src: String, raw_decls: [Decl], tab: SymTab, specs: SpecNames, ids: ProtoIds, bmode: BuildMode, target_origin: Option[String], entry: SymId, regions: [RegionMark], cached: [CTU], cacheable: [String], stamp_ids: [SymId]) : EmitModularOut / Console + Mutable {

  let alias_resolved = rewrite_alias_decls(raw_decls)
  let decls = desugar_op_calls_decls(alias_resolved, collect_effect_ids(alias_resolved))
  let fns = register_fn_decls(decls, tab, specs, entry)
  let variants = register_variants(decls, tab)
  let st = collect_decls(decls, lc_new(tab, specs))
  let lams = st.lams
  let clauses_info = st.clauses
  let ctor_ix = ctor_ix_build(variants, decls, tab, target_origin)

  # ---- kai_types.h : runtime + every struct/typedef (shared) --------
  let mono_structs = mono_sum_decls(decls, tab, ctor_ix)
  let eff_structs = effect_struct_decls(decls, tab)
  let env_structs = emit_handle_env_typedefs(clauses_info)
  # C struct typedefs for every `extern "C" type`, so a struct-by-value
  # shim can name `struct __kai_ffi_<Name>`.
  let ffi_structs = emit_ffi_struct_typedefs(collect_extern_types(decls, tab), tab)
  let fixed_vec_tds = collect_fixed_vec_typedefs(decls)
  let types_h = concat_all([
    "/* generated by kaikai stage 2 — shared types header */\n",
    "#ifndef KAI_TYPES_H\n#define KAI_TYPES_H\n",
    "#include \"runtime.h\"\n\n",
    mono_structs, eff_structs, env_structs, ffi_structs, fixed_vec_tds,
    "\n#endif /* KAI_TYPES_H */\n"
  ])

  # ---- kai_decls.h : every prototype, whole program (shared) ---------
  # Donation rides separate compilation on one invariant: the SAME capable
  # set drives the shared forward decls, every TU's defs, and every call
  # site (a non-donating caller passes the null token), so the `_donor`
  # ABI agrees across `.o` files. Capability is per-fn (scanned from the
  # callee's own body), so a cached core TU's body is stable for fixed
  # core sources; the cache directory is toolchain-scoped, so an emitter
  # change can never mix ABIs with cached entries.
  # `KAI_CONST` purity does not change the ABI and needs no such care.
  let fx = fnx_build_decls(decls, fns)
  let rd_cap_set = rd_donatable_filter(rd_scan_capable(decls, tab, specs), decls, tab, specs, fx)
  let const_syms = purity_const_syms(purity_analyze(decls, entry), tab, specs)
  let clause_fwd = emit_clause_forwards(clauses_info, effect_decls_only(decls), tab)
  let fwd = fn_forward_decls(decls, tab, specs, fx, rd_cap_set, const_syms, entry)
  let thunk_fwd = thunk_forward_decls(decls, tab, specs)
  let lam_fwd = emit_lam_forward_decls(lams)
  let default_ev_extern = emit_default_node_extern_decls(effect_decls_only(decls), tab)
  let decls_h = concat_all([
    "/* generated by kaikai stage 2 — shared declarations header */\n",
    "#ifndef KAI_DECLS_H\n#define KAI_DECLS_H\n",
    "#include \"kai_types.h\"\n\n",
    clause_fwd, fwd, "\n", thunk_fwd, "\n", lam_fwd, "\n", default_ev_extern, "\n",
    "\n#endif /* KAI_DECLS_H */\n"
  ])

  # ---- per-module .c translation units ------------------------------
  let core_ix = core_ix_build()
  # The cx carries the same capable set as the shared forward decls above;
  # every TU (root and module) emits defs, thunks, and call sites keyed on
  # it, which is what keeps the `_donor` ABI link-consistent across `.o`s.
  let cx = EmitCtx { lcs: [], fns: fns, fx: fx, variants: variants, lams: lams, cls: clauses_info,
                     regions: regions, in_region: false, borrowed: [], hoisted: [], reuse_donor: None, kind1_raw: [], consts: const_decls_only(decls), effs: effect_decls_only(decls), ffi_reg: collect_extern_types(decls, tab), cur_enc_fn: "", recs: collect_records(decls), stamps: rec_stamps(decls, stamp_ids), core_ix: core_ix, ctor_ix: ctor_ix, evf: frames_index(build_evidence_frames(decls, tab, specs, entry)), rd_active: false, rd_capable: rd_cap_set, tcpend: [], unw: unw_frame_none(unw_cx(decls, clauses_info)), root_mod: target_origin, tab: tab, specs: specs, locals: ln_empty() }
  # Root TU: root-file fn bodies + ALL lambdas/clauses + tests/benches/
  # checks + the main wrapper. Lambdas and clauses have no mo, so they
  # ride root — link-safe and complete.
  let root_decls = decls_of_origin(decls, None)
  let root_bodies = fn_bodies(src, root_decls, cx, const_syms)
  let lam_bodies = emit_lam_helpers(src, lams, tab, specs, fns, cx.fx, variants, clauses_info, const_decls_only(decls), effect_decls_only(decls), collect_records(decls), cx.stamps, core_ix, cx.ctor_ix, cx.evf, cx.root_mod, cx.unw.ucx)
  let clause_bodies = emit_clause_bodies(src, clauses_info, cx)
  let tests = emit_all_tests(src, decls, cx, target_origin)
  let benches = emit_all_benches(src, decls, cx, target_origin)
  let checks = emit_all_checks(src, decls, cx, target_origin)
  let main_wr = emit_main_wrapper(decls, tab, specs, ids, ctor_ix, bmode, variants, fns, entry)
  # One definition of each default-block effect's evidence globals, in the root
  # TU; module TUs see them via the `extern` decls in the shared header.
  let default_ev_defs = emit_default_node_globals(effect_decls_only(decls), tab)
  let root_tu = CModuleTU { stem: "__root__",
    body: concat_all([default_ev_defs, root_bodies, lam_bodies, clause_bodies, tests, benches, checks, main_wr]) }
  # Module TUs: one per distinct module-origin, carrying only that
  # module's fn bodies. `fn_bodies` carries the `Console` effect, so we
  # fold with an explicit loop rather than `map` (which is pure).
  let mod_names = distinct_module_origins(decls)
  let mto = emit_module_tus_loop(src, decls, mod_names, cx, const_syms,
                                 cached, cacheable, [], [])
  let mod_tus = match mto { MTO(tus, _) -> tus }
  let fresh_tus = match mto { MTO(_, fresh) -> fresh }
  let all_tus = [root_tu, ...mod_tus]

  # ---- assemble the marker-delimited multi-file stream --------------
  # Cross-module symbols need EXTERNAL linkage to resolve across the
  # per-module `.o` files; the shared emitters write every top-level def
  # `static` (the single-TU contract), so rewrite the prototypes and TU
  # bodies here. types_h carries only typedefs, so it is left as-is.
  let nonce = modular_marker_nonce(src)
  let ext_decls_h = externalize_modular_linkage(decls_h)
  let ext_tus = map(all_tus, (tu) => CModuleTU { stem: tu.stem, body: externalize_modular_linkage(tu.body) })
  let slice_in = map(ext_tus, (tu) => SliceTU { stem: tu.stem, body: tu.body })
  let sliced = slice_headers(types_h, ext_decls_h, slice_in)
  EMO(assemble_modular_output(nonce, sliced, ext_tus), fresh_tus)
}

# Module TU loop result: the TUs in document order plus the freshly
# emitted cache-eligible bodies.
type ModTusOut = MTO([CModuleTU], [CTU])

#[doc("Build one CModuleTU per module name, each carrying that module's mo-filtered fn bodies; a stem present in `cached` splices the cached body instead of emitting. Explicit loop (not map) because `fn_bodies` carries the Console effect.")]
fn emit_module_tus_loop(src: String, decls: [Decl], mod_names: [String], cx: EmitCtx, const_syms: [String], cached: [CTU], cacheable: [String], acc: [CModuleTU], acc_fresh: [CTU]) : ModTusOut / Console + Mutable = match mod_names {
  [] -> MTO(list_reverse(acc), list_reverse(acc_fresh))
  [m, ...rest] -> {
    let stem = tu_stem(Some(m))
    match ec_find(cached, stem) {
      Some(body) ->
        emit_module_tus_loop(src, decls, rest, cx, const_syms, cached,
                             cacheable,
                             [CModuleTU { stem: stem, body: body }, ...acc],
                             acc_fresh)
      None -> {
        let body = fn_bodies(src, decls_of_origin(decls, Some(m)), cx, const_syms)
        let tu = CModuleTU { stem: stem, body: body }
        let fresh1 = if list_has(cacheable, m) { [CTU(stem, body), ...acc_fresh] }
                     else { acc_fresh }
        emit_module_tus_loop(src, decls, rest, cx, const_syms, cached,
                             cacheable, [tu, ...acc], fresh1)
      }
    }
  }
}

# Per-compile marker nonce embedded in the `//KAIFILE:` split markers.
# The real anti-collision guarantee is the COLUMN-0 anchor the wrapper's
# awk uses (`index($0, pfx) == 1`): emitted C lines start with
# indentation or a C token, never with `//KAIFILE:<nonce>::` at column 0,
# so a stream line is a marker iff it begins exactly with the prefix. The
# nonce (a per-compile digit string from the source length) is a second
# layer that makes an accidental column-0 `//KAIFILE:` in a multi-line
# string literal astronomically unlikely to also carry this compile's
# nonce — it is NOT a cryptographic guarantee, just defence in depth on
# top of the column-0 anchor.
#[doc("Per-compile marker nonce for the `//KAIFILE:` split markers; defence-in-depth on top of the column-0 anchor the wrapper relies on.")]
fn modular_marker_nonce(src: String) : String =
  string_concat("k748x", int_to_string(string_length(src)))

#[doc("Join the per-TU header slices + per-module .c TUs into one marker-delimited String. Line 1 declares the nonce; each file is introduced by a column-0 `//KAIFILE:<nonce>::<name>` line. Every .c #includes its own kai_decls_<stem>.h (which pulls in kai_types_<stem>.h).")]
fn assemble_modular_output(nonce: String, sliced: [SlicedHeaders], tus: [CModuleTU]) : String {
  let head = concat_all(["//KAIDELIM:", nonce, "\n"])
  let h_parts = concat_all(map(sliced, (sh) => concat_all([
    "//KAIFILE:", nonce, "::kai_types_", sh.stem, ".h\n", sh.types_h,
    "//KAIFILE:", nonce, "::kai_decls_", sh.stem, ".h\n", sh.decls_h
  ])))
  let c_parts = concat_all(map(tus, (tu) => concat_all([
    "//KAIFILE:", nonce, "::", tu.stem, ".c\n",
    "/* generated by kaikai stage 2 */\n",
    "#include \"kai_decls_", tu.stem, ".h\"\n\n",
    tu.body, "\n"
  ])))
  concat_all([head, h_parts, c_parts])
}

#[doc("Emit-layer entry point emit_program")]
pub fn emit_program(file: String, src: String, raw_decls: [Decl], tab: SymTab, specs: SpecNames, ids: ProtoIds, bmode: BuildMode, target_origin: Option[String], entry: SymId, regions: [RegionMark], stamp_ids: [SymId]) : String / Console + Mutable {

  # A callee still spelled `Eff.op` becomes the perform the emitter
  # dispatches through the evidence.
  let alias_resolved = rewrite_alias_decls(raw_decls)
  let decls = desugar_op_calls_decls(alias_resolved, collect_effect_ids(alias_resolved))
  let fns = register_fn_decls(decls, tab, specs, entry)
  let variants = register_variants(decls, tab)
  let st = collect_decls(decls, lc_new(tab, specs))
  let lams = st.lams
  let clauses_info = st.clauses
  let ctor_ix = ctor_ix_build(variants, decls, tab, target_origin)
  let extern_types = collect_extern_types(decls, tab)
  let ffi_header_inc = if has_ffi_struct(extern_types) { string_concat("#include \"", string_concat(ffi_header_name(), "\"\n\n")) } else { "" }
  let header = concat_all(["/* generated by kaikai stage 2 */\n#include \"runtime.h\"\n", ffi_header_inc, "\n"])
  # Monomorphic node representation (Koka mould): flat struct per sum
  # ctor. v1 additive — emitted but not yet constructed/matched against,
  # so this is layout-visible (diffable vs Koka's C) with zero behaviour
  # change until the consumers switch over.
  let mono_structs = mono_sum_decls(decls, tab, ctor_ix)
  let eff_structs = effect_struct_decls(decls, tab)
  # R9: env typedefs come after the EvE structs (no dependency between
  # them — env structs are pure plain-old-data, EvE has the void *env)
  # but before the clause forwards (whose bodies cast `self->env` to
  # the env type) and before the install-site stmt-expressions emitted
  # inside fn bodies.
  let env_structs = emit_handle_env_typedefs(clauses_info)
  # C struct typedefs for every `extern "C" type`. When present they go to
  # a SHARED `kai_ffi.h` (so a hand-written shim names the same type), and
  # `out.c` includes it (`ffi_header_inc` above) rather than inlining them.
  let ffi_structs = emit_ffi_struct_typedefs(extern_types, tab)
  # Single-TU compilation: the donation-capable set is the whole program, so
  # the `_donor` ABI is consistent across def / forward / thunk / call site.
  # Excludes any fn whose body carries a TRMC self-tail step (the leftover
  # `_donor` free rides a return-value wrap that a `goto` bypasses → a leak)
  # or a raw (unboxed) return (the wrap casts through `int64_t`, truncating a
  # `double`/pointer). A reuse-variant-rotation fn is neither today, so the
  # filter is a soundness fence, not a live change. Computed once, threaded
  # to the forward decls and the emit context.
  let fx = fnx_build_decls(decls, fns)
  let rd_cap_set = rd_donatable_filter(rd_scan_capable(decls, tab, specs), decls, tab, specs, fx)
  # Confirmed-purity symbols (#1139): the emitted `c_sym` of every fn
  # whose lowered body is memory-clean, so the signature helper prefixes
  # `KAI_CONST`. Computed once over the same decls the native backend
  # sees; empty under separate compilation is fine (a cross-TU caller
  # keeps the barrier). Same set drives the forward decl and the body.
  let const_syms = purity_const_syms(purity_analyze(decls, entry), tab, specs)
  let clause_fwd = emit_clause_forwards(clauses_info, effect_decls_only(decls), tab)
  let fwd = fn_forward_decls(decls, tab, specs, fx, rd_cap_set, const_syms, entry)
  let thunk_fwd = thunk_forward_decls(decls, tab, specs)
  let lam_fwd = emit_lam_forward_decls(lams)
  # Top-level emission runs with an empty lexical scope; each fn /
  # lambda / clause / test body seeds its own scope from the params
  # (and captures, where applicable) before recursing into the body.
  # m4c #4: `clauses_info` (built above) is the side table threaded
  # through the emit walker so install code (`emit_clause_assignments`)
  # can look up the enclosing fn name stamped at collect time on each
  # `ClauseInfo` and mint matching prefixed C symbols.
  let cls = clauses_info
  # Lane linus-a: the four invariant context fields are built once here
  # and bundled with an empty top-level lexical scope. Each fn / lambda /
  # clause / test body seeds its own scope from its params before
  # recursing, so the entry `lcs` is `[]`.
  let core_ix = core_ix_build()
  let cx = EmitCtx { lcs: [], fns: fns, fx: fx, variants: variants, lams: lams, cls: cls,
                     regions: regions, in_region: false, borrowed: [], hoisted: [], reuse_donor: None, kind1_raw: [], consts: const_decls_only(decls), effs: effect_decls_only(decls), ffi_reg: collect_extern_types(decls, tab), cur_enc_fn: "", recs: collect_records(decls), stamps: rec_stamps(decls, stamp_ids), core_ix: core_ix, ctor_ix: ctor_ix, evf: frames_index(build_evidence_frames(decls, tab, specs, entry)), rd_active: false, rd_capable: rd_cap_set, tcpend: [], unw: unw_frame_none(unw_cx(decls, clauses_info)), root_mod: target_origin, tab: tab, specs: specs, locals: ln_empty() }
  let bodies = fn_bodies(src, decls, cx, const_syms)
  let lam_bodies = emit_lam_helpers(src, lams, tab, specs, fns, cx.fx, variants, cls, const_decls_only(decls), effect_decls_only(decls), collect_records(decls), cx.stamps, core_ix, cx.ctor_ix, cx.evf, cx.root_mod, cx.unw.ucx)
  let clause_bodies = emit_clause_bodies(src, clauses_info, cx)
  let tests = emit_all_tests(src, decls, cx, target_origin)
  let benches = emit_all_benches(src, decls, cx, target_origin)
  let checks = emit_all_checks(src, decls, cx, target_origin)
  let main_wr = emit_main_wrapper(decls, tab, specs, ids, ctor_ix, bmode, variants, fns, entry)
  # The FFI `typedef`s live in `out.c` only when there is no extern struct
  # (then `ffi_structs` is "" and this is byte-identical to before); with a
  # struct they ride the shared `kai_ffi.h` instead, so `out.c` here omits
  # them (it `#include`s the header) and the whole program ships as a
  # marker stream the wrapper splits into `kai_ffi.h` + `out.c`.
  # Default-block evidence globals are defined ahead of the fn bodies so a
  # call site supplying a default-bearing slot addresses an already-declared
  # symbol (single-TU: one definition, file scope).
  let default_ev_defs = emit_default_node_globals(effect_decls_only(decls), tab)
  let fixed_vec_tds = collect_fixed_vec_typedefs(decls)
  let out_c = concat_all([header, mono_structs, eff_structs, env_structs, fixed_vec_tds, clause_fwd, fwd, "\n", thunk_fwd, "\n", lam_fwd, "\n", default_ev_defs, "\n", bodies, lam_bodies, clause_bodies, tests, benches, checks, main_wr])
  if has_ffi_struct(extern_types) { emit_ffi_header_stream(src, ffi_structs, out_c) }
  else { out_c }
}

#[doc("The shared FFI header filename a struct-by-value shim `#include`s.")]
pub fn ffi_header_name() : String = "kai_ffi.h"

# True when the registry holds at least one `extern "C" type` STRUCT (an
# opaque crosses as `void *` and needs no typedef, so it does not trigger
# the shared header).
fn has_ffi_struct(reg: [ExternTypeReg]) : Bool = match reg {
  [] -> false
  [e, ...rest] -> match e { ExtStruct(_, _) -> true  ExtOpaque(_) -> has_ffi_struct(rest) }
}

# Wrap the FFI typedefs + `out.c` in the marker stream the `bin/kai`
# wrapper splits (same `//KAIDELIM` / `//KAIFILE` scheme as the modular
# path). Only emitted when a struct-by-value extern type is present, so the
# default single-TU output stays byte-identical and selfhost-safe.
fn emit_ffi_header_stream(src: String, ffi_structs: String, out_c: String) : String {
  let nonce = modular_marker_nonce(src)
  concat_all([
    "//KAIDELIM:", nonce, "\n",
    "//KAIFILE:", nonce, "::", ffi_header_name(), "\n",
    "/* generated by kaikai stage 2 — shared FFI struct header */\n",
    "#ifndef KAI_FFI_H\n#define KAI_FFI_H\n#include <stdint.h>\n\n",
    ffi_structs,
    "\n#endif /* KAI_FFI_H */\n",
    "//KAIFILE:", nonce, "::out.c\n",
    out_c
  ])
}

fn expand_aliases_in_row(re: RowExpr, tab: SymTab, aliases: [AliasResult]) : RowExpr {
  match re {
    REmpty -> REmpty
    RClosed(labels) -> RClosed(dedup_row_labels(tab, expand_row_labels(labels, aliases)))
    ROpen(rv, labels) -> ROpen(rv, dedup_row_labels(tab, expand_row_labels(labels, aliases)))
  }
}

# m7b #1 — alias expansion. Aliases (`type Io = Console + Stdin + ...`)
# only resolve plain non-parametric names; if the user wrote
# `Reader[Int]` we leave the label alone since aliases over
# parameterised effects (`type DbReader = Reader[DbConfig]`) are
# out of scope for m7b #11. Bare names that match an alias expand
# into a list of bare-name labels.

# m7b #1 — alias expansion. Aliases (`type Io = Console + Stdin + ...`)
# only resolve plain non-parametric names; if the user wrote
# `Reader[Int]` we leave the label alone since aliases over
# parameterised effects (`type DbReader = Reader[DbConfig]`) are
# out of scope for m7b #11. Bare names that match an alias expand
# into a list of bare-name labels.
fn expand_row_labels(ls: [RowLabel], aliases: [AliasResult]) : [RowLabel] {
  match ls {
    [] -> []
    [l, ...rest] -> match l {
      # An alias is named by what the label writes.
      RL(DrWritten(None, name), []) -> {
        let here = match find_alias(aliases, written_text(name)) {
          Some(expanded) -> expanded
          None -> [l]
        }
        list_append(here, expand_row_labels(rest, aliases))
      }
      # A settled label is an effect, and no alias is registered with
      # type args: both pass through unchanged.
      _ -> [l, ...expand_row_labels(rest, aliases)]
    }
  }
}

fn row_arg_key(tab: SymTab, te: TypeExpr) : String =
  concat_all([type_key(tab, te), "@", join_with(map(te_decl_ids(te), int_to_string), ",")])

fn dedup_row_labels(tab: SymTab, ls: [RowLabel]) : [RowLabel] {
  dedup_row_labels_loop(tab, ls, [], [])
}

# What a label still written spells; nothing once it is settled.
fn row_label_spelled(r: DeclRef) : String = match r {
  DrSym(_)              -> ""
  DrWritten(None, n)    -> written_text(n)
  DrWritten(Some(q), n) -> concat_all([written_text(q), ".", written_text(n)])
}

fn dedup_row_labels_loop(tab: SymTab, ls: [RowLabel], seen: [String], acc: [RowLabel]) : [RowLabel] {
  match ls {
    [] -> list_reverse(acc)
    [h, ...rest] -> match h {
      RL(r, targs) -> {
        # Key by declaration and args, each arg with the declarations it
        # names: two homonymous effects, `Actor[Request]` and
        # `Actor[Reply]`, or two types spelled alike, all survive. A label
        # nothing settled keys by its spelling.
        let key = concat_all([row_label_spelled(r), "#", int_to_string(sym_raw(ref_sym(r))), "[", join_with(map(targs, (t) => row_arg_key(tab, t)), ","), "]"])
        if list_has(seen, key) {
          dedup_row_labels_loop(tab, rest, seen, acc)
        } else {
          dedup_row_labels_loop(tab, rest, [key, ...seen], [h, ...acc])
        }
      }
    }
  }
}

fn expand_aliases_in_decl(d: Decl, tab: SymTab, aliases: [AliasResult]) : Decl {
  match d {
    DFn(p, fid, tps, params, ret, rexpr, body, l, c, mo) ->
      DFn(p, fid, tps, params, ret, expand_aliases_in_row(rexpr, tab, aliases), body, l, c, mo)
    _ -> d
  }
}

#[doc("Emit-layer entry point expand_aliases_in_decls")]
pub fn expand_aliases_in_decls(decls: [Decl], tab: SymTab, aliases: [AliasResult]) : [Decl] {
  match decls {
    [] -> []
    [d, ...rest] -> [expand_aliases_in_decl(d, tab, aliases),
                     ...expand_aliases_in_decls(rest, tab, aliases)]
  }
}

# === issue #376: transparent type aliases for `type Foo = T` ===
#
# Restores the alias contract from `docs/kaikai-minimal.md`: when the
# RHS of a `type Foo = T` declaration is a single TypeExpr (no `|`),
# `Foo` is interchangeable with `T` in every type position. The
# regression introduced by issue #187 (sum/union unification) treated
# these as nominal one-component unions, breaking
# `type Age = Int`, `type Env = [(String, Real)]`, etc.
#
# Rule: single-component (`TBAlias`) bodies that are NOT effect aliases
# are expanded structurally.
#   - Effect aliases: `type Console = Stdout + Stderr` (`TBEffectAlias`)
#     plus the single-name form `type Foo = SomeEffect` already
#     resolved as effect by `resolve_alias_cands`. Filtered by name.
#   - Refinement aliases (`type Pos = Int where p`) expand to the
#     inline `TyRefine(Int, p)` form at every use site (closes #449
#     and #505). The `__ref_pred_X` synth fn and the pattern-narrow
#     lowering run on the raw decl stream before the expansion
#     fires, so they still bind against the alias name; expansion
#     only rewrites the `TyName("X", [])` uses that survive in
#     signatures and bindings.
# Multi-component `type X = A | B` (`TBSum`) keeps #187 semantics.
#
# The expansion is iterative: each pass walks every TypeExpr in the
# decl stream and rewrites a `TyName(name, args)` whose `name` is a
# transparent alias into the alias body, substituting the alias's
# tparams. Aliases that mention other aliases on their RHS resolve
# transitively via repeated passes until a fixpoint or a cycle bound
# is hit. A simple iteration cap (length of the alias table) bounds
# work under cycles; cycle errors are reported by the caller via the
# `infer_program` cascade if any TyCon survives.

# The type scope pass settles a reference to an alias of any module
# but the root and the cores to the alias's id. A reference it leaves
# written can therefore only name a root or a core alias, which is what
# keeps a module's alias from expanding a homonym another file writes.
#[doc("A transparent type alias: its declaration, its type parameters, the type it expands to, and whether a reference still written can name it (the root's and a core's can; any other is reached by its id alone).")]
pub type TAEntry = TAE(SymId, [String], TypeExpr, Bool)

# The entries and the table their names are read from.
type TAScope = { tab: SymTab, entries: [TAEntry] }

#[doc("The transparent aliases `decls` declares. `eff_names` are the written names of the effects, `target` the root's home and `cores` the core modules' homes.")]
pub fn collect_transparent_aliases(decls: [Decl], tab: SymTab, eff_names: [String],
                                    target: String, cores: [String]) : [TAEntry] =
  collect_transparent_aliases_loop(decls, tab, eff_names, ta_modules(tab, [target, ...cores]), [])

fn ta_modules(tab: SymTab, homes: [String]) : [SymId] = match homes {
  [] -> []
  [h, ...rest] -> match st_module(tab, h) {
    Some(m) -> [m, ...ta_modules(tab, rest)]
    None    -> ta_modules(tab, rest)
  }
}

fn collect_transparent_aliases_loop(decls: [Decl], tab: SymTab, eff_names: [String],
                                     bare: [SymId], acc: [TAEntry]) : [TAEntry] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> {
      let here = transparent_alias_of_decl(d, tab, eff_names, bare)
      let acc1 = match here {
        Some(e) -> [e, ...acc]
        None -> acc
      }
      collect_transparent_aliases_loop(rest, tab, eff_names, bare, acc1)
    }
  }
}

fn transparent_alias_of_decl(d: Decl, tab: SymTab, eff_names: [String], bare: [SymId]) : Option[TAEntry] {
  match decl_transparent_inner(d) {
    Some(inner) -> transparent_alias_of_decl(inner, tab, eff_names, bare)
    None -> match d {
      DType(_, tsym, tparams, body, _, _, _, _) -> match body {
        # A refinement alias (`type Pos = Int where p`) expands to its
        # inline `TyRefine(Int, p)` at every use site: the predicate fn
        # and the pattern-narrow lowering have already run on the raw
        # declarations.
        TBAlias(t) ->
          if ta_names_effect(tab, t, eff_names) { None }
          else { Some(TAE(tsym, tparams, t, any(bare, (m) => sym_owned_by(tab, tsym, m)))) }
        _ -> None
      }
      _ -> None
    }
  }
}

# A single-name body naming an effect is an effect alias, which the
# row pass expands.
fn ta_names_effect(tab: SymTab, t: TypeExpr, eff_names: [String]) : Bool = match t.tkind {
  TyName(DrSym(s), []) -> match sym_class(tab, s) {
    NCEffect -> st_valid(tab, s)
    _        -> false
  }
  TyName(DrWritten(None, n), []) -> list_has(eff_names, written_text(n))
  _ -> false
}

# An entry only answers a use site of the same arity: `type Box = Int`
# must not capture the core's `Option[Int]`, and `type Money[t]` must
# not capture a bare `Money`. A mismatched expansion would substitute a
# wrong-length argument list into the body.
fn ta_lookup(table: TAScope, r: DeclRef, nargs: Int) : Option[TAEntry] = match r {
  DrSym(s)              -> ta_lookup_in(table.entries, [s], nargs, false)
  DrWritten(None, n)    -> ta_lookup_in(table.entries, st_candidates(table.tab, NCType, written_text(n)), nargs, true)
  DrWritten(Some(_), _) -> None
}

# The first entry of arity `nargs` one of `ids` declares. `spelled`: the
# reference is still written, and reaches only an entry a name can.
fn ta_lookup_in(es: [TAEntry], ids: [SymId], nargs: Int, spelled: Bool) : Option[TAEntry] = match ids {
  [] -> None
  _  -> match es {
    [] -> None
    [e, ...rest] -> match e {
      TAE(s, tps, _, bare) ->
        if list_length(tps) == nargs and (bare or not spelled) and any(ids, (c) => sym_same(c, s)) { Some(e) }
        else { ta_lookup_in(rest, ids, nargs, spelled) }
    }
  }
}

# Substitute tparams in a body TypeExpr with the supplied args. The
# tparam map associates each declared tparam name with the
# instantiation TypeExpr at the use site.

# Substitute tparams in a body TypeExpr with the supplied args. The
# tparam map associates each declared tparam name with the
# instantiation TypeExpr at the use site.
type TPSubst = TPS(String, TypeExpr)

fn build_tp_subst(tparams: [String], args: [TypeExpr]) : [TPSubst] {
  match tparams {
    [] -> []
    [p, ...prest] -> match args {
      [] -> []
      [a, ...arest] -> [TPS(p, a), ...build_tp_subst(prest, arest)]
    }
  }
}

fn tp_subst_lookup(subst: [TPSubst], name: String) : Option[TypeExpr] {
  match subst {
    [] -> None
    [s, ...rest] -> match s {
      TPS(n, te) -> if n == name { Some(te) } else { tp_subst_lookup(rest, name) }
    }
  }
}

# A type parameter has no declaration: a reference names one by what it
# writes.
fn tp_subst_ref(subst: [TPSubst], r: DeclRef) : Option[TypeExpr] = match r {
  DrWritten(None, n) -> tp_subst_lookup(subst, written_text(n))
  _                  -> None
}

fn apply_tp_subst_te(te: TypeExpr, subst: [TPSubst]) : TypeExpr {
  match te.tkind {
    TyName(r, targs) -> {
      let targs1 = apply_tp_subst_te_list(targs, subst)
      match tp_subst_ref(subst, r) {
        Some(rep) -> if targs1 == [] { rep }
                     else {
                       # `Predicate[T] = (T) -> Bool` instantiated with
                       # `Predicate[Int]` plain-name lookup substitutes
                       # `T` itself, not a TyName-with-args. Higher-kinded
                       # aliases are out of scope; the type-args-on-tparam
                       # case is not supported and falls through.
                       TypeExpr { tkind: TyName(r, targs1), line: te.line, col: te.col }
                     }
        None -> TypeExpr { tkind: TyName(r, targs1), line: te.line, col: te.col }
      }
    }
    TyList(inner) ->
      TypeExpr { tkind: TyList(apply_tp_subst_te(inner, subst)),
                  line: te.line, col: te.col }
    TyFn(ps, ret, row) ->
      TypeExpr { tkind: TyFn(apply_tp_subst_te_list(ps, subst),
                              apply_tp_subst_te(ret, subst),
                              apply_tp_subst_row(row, subst)),
                  line: te.line, col: te.col }
    TyDim(base, u) ->
      TypeExpr { tkind: TyDim(apply_tp_subst_te(base, subst),
                              apply_tp_subst_unit(u, subst)),
                  line: te.line, col: te.col }
    TyRefine(base, p) ->
      TypeExpr { tkind: TyRefine(apply_tp_subst_te(base, subst), p),
                  line: te.line, col: te.col }
    # issue #772: a compound row carried as a type argument inside an
    # alias body — substitute tparams inside any parameterised labels.
    TyRow(row) ->
      TypeExpr { tkind: TyRow(apply_tp_subst_row(row, subst)),
                  line: te.line, col: te.col }
    TySurface(ts) ->
      TypeExpr { tkind: TySurface(tysurface_rebuild(ts, apply_tp_subst_te_list(tysurface_children(ts), subst))),
                  line: te.line, col: te.col }
  }
}

# Substitute an alias's unit-kind tparams inside a unit expression
# (`type Money[c: Currency] = Decimal<c>` instantiated at `Money[USD]`).
# The inserted symbol stays bare: the driver re-resolves and
# re-validates the expanded stream, so habitants qualify and unknown
# arguments diagnose there, and a tparam argument stays a tparam.
fn apply_tp_subst_unit(u: UnitExprT, subst: [TPSubst]) : UnitExprT {
  match u {
    UOne -> u
    UVar(_) -> u
    USym(s) -> match tp_subst_unit_lookup(subst, s) {
      Some(rep) -> rep
      None -> u
    }
    UMul(a, b) -> UMul(apply_tp_subst_unit(a, subst), apply_tp_subst_unit(b, subst))
    UJoin(a, b) -> UJoin(apply_tp_subst_unit(a, subst), apply_tp_subst_unit(b, subst))
    UInv(a) -> UInv(apply_tp_subst_unit(a, subst))
    UPow(a, n) -> UPow(apply_tp_subst_unit(a, subst), n)
    UDims(us) -> UDims(apply_tp_subst_units(us, subst))
  }
}

fn apply_tp_subst_units(us: [UnitExprT], subst: [TPSubst]) : [UnitExprT] {
  match us {
    [] -> []
    [u, ...rest] -> [apply_tp_subst_unit(u, subst), ...apply_tp_subst_units(rest, subst)]
  }
}

fn tp_subst_unit_lookup(subst: [TPSubst], sym: String) : Option[UnitExprT] {
  match subst {
    [] -> None
    [s, ...rest] -> match s {
      TPS(stored, te) ->
        if tp_kind_is_unit(stored) and tp_strip_kind(stored) == sym {
          match te.tkind {
            TyName(DrWritten(None, arg), []) -> Some(USym(written_text(arg)))
            _ -> None
          }
        } else { tp_subst_unit_lookup(rest, sym) }
    }
  }
}

fn apply_tp_subst_te_list(tes: [TypeExpr], subst: [TPSubst]) : [TypeExpr] {
  match tes {
    [] -> []
    [t, ...rest] -> [apply_tp_subst_te(t, subst), ...apply_tp_subst_te_list(rest, subst)]
  }
}

# Apply a tparam substitution to a RowExpr. When a tparam name appears
# as the row variable (`ROpen("e", labels)`), replace the tail with the
# substituted TypeExpr, treating an uppercase `TyName(NN, [])` argument
# as a single effect label (`labels + [RL(NN, [])]`, closed). Lowercase
# `TyName(nm, [])` is treated as another row variable name. Any more
# complex replacement (e.g. `TyName("Foo", [Int])`) leaves the row
# unchanged — that case is rejected by `resolve_ty_with_binds` later
# with a normal "unknown row variable" diagnostic instead of a panic.
#
# Closes #624 (alias with row variable + concrete row annotation): the
# alias body `() -> Option[t] / e` instantiated at `Foo[Int, Console]`
# now rewrites the row to `RClosed([Console])`, where before the
# substitution skipped the row entirely and downstream resolve produced
# a row tail of `Some(-1)` that paniced in `subst_row_lookup`.

# Apply a tparam substitution to a RowExpr. When a tparam name appears
# as the row variable (`ROpen("e", labels)`), replace the tail with the
# substituted TypeExpr, treating an uppercase `TyName(NN, [])` argument
# as a single effect label (`labels + [RL(NN, [])]`, closed). Lowercase
# `TyName(nm, [])` is treated as another row variable name. Any more
# complex replacement (e.g. `TyName("Foo", [Int])`) leaves the row
# unchanged — that case is rejected by `resolve_ty_with_binds` later
# with a normal "unknown row variable" diagnostic instead of a panic.
#
# Closes #624 (alias with row variable + concrete row annotation): the
# alias body `() -> Option[t] / e` instantiated at `Foo[Int, Console]`
# now rewrites the row to `RClosed([Console])`, where before the
# substitution skipped the row entirely and downstream resolve produced
# a row tail of `Some(-1)` that paniced in `subst_row_lookup`.
fn apply_tp_subst_row(r: RowExpr, subst: [TPSubst]) : RowExpr {
  match r {
    REmpty -> REmpty
    RClosed(labels) -> RClosed(apply_tp_subst_rls(labels, subst))
    ROpen(rv, labels) -> {
      let labels1 = apply_tp_subst_rls(labels, subst)
      match tp_subst_lookup(subst, rv) {
        None -> ROpen(rv, labels1)
        Some(rep) -> match rep.tkind {
          # A row variable is written lowercase; anything else names an
          # effect.
          TyName(r, []) -> match r {
            DrWritten(None, nm) ->
              if name_first_is_upper(written_text(nm)) {
                RClosed(label_concat_rls(labels1, [RL(r, [])]))
              } else {
                ROpen(written_text(nm), labels1)
              }
            _ -> RClosed(label_concat_rls(labels1, [RL(r, [])]))
          }
          # issue #772: a compound row argument (`Stdout + Fail`,
          # `Stdout + f`) arrives as a `TyRow` carrier; fold its labels
          # and tail into the alias row at the substitution point. This
          # is where `TyRow` is dissolved — it never survives past here.
          TyRow(arg_row) -> fuse_row_arg(labels1, arg_row)
          _ -> ROpen(rv, labels1)
        }
      }
    }
  }
}

fn apply_tp_subst_rls(ls: [RowLabel], subst: [TPSubst]) : [RowLabel] {
  match ls {
    [] -> []
    [rl, ...rest] -> match rl {
      RL(r, ts) -> [
        RL(r, apply_tp_subst_te_list(ts, subst)),
        ...apply_tp_subst_rls(rest, subst)
      ]
    }
  }
}

fn label_concat_rls(a: [RowLabel], b: [RowLabel]) : [RowLabel] {
  match a {
    [] -> b
    [h, ...rest] -> [h, ...label_concat_rls(rest, b)]
  }
}

fn name_first_is_upper(s: String) : Bool {
  match char_at(s, 0) {
    Some(c) -> c >= 'A' and c <= 'Z'
    None -> false
  }
}

# Single-step expansion of a TypeExpr against the alias table. Returns
# the rewritten TypeExpr. Recursion bound by `fuel` caps cycles.

# Single-step expansion of a TypeExpr against the alias table. Returns
# the rewritten TypeExpr. Recursion bound by `fuel` caps cycles.
fn expand_ta_te(te: TypeExpr, table: TAScope, aliases: [AliasResult], fuel: Int) : TypeExpr {
  if fuel <= 0 { te }
  else { match te.tkind {
    TyName(r, targs) -> {
      let targs1 = expand_ta_te_list(targs, table, aliases, fuel)
      match ta_lookup(table, r, list_length(targs)) {
        Some(TAE(_, tparams, body, _)) -> {
          let subst = build_tp_subst(tparams, targs1)
          let inst = apply_tp_subst_te(body, subst)
          # Re-walk the instantiated body so a chain `type A = B; type B = Int`
          # collapses to Int. Decrement fuel on each unfold.
          let expanded = expand_ta_te(inst, table, aliases, fuel - 1)
          # issue #772: instantiating a row-parameterised alias may lift
          # a row argument that names an effect alias (`Stream[Int,
          # Console]` → `() -> ... / Console`) or an aliased label
          # inside a compound row (`Stdout + Console`). Expand those
          # effect-alias labels now, on the stabilised node, so a named
          # row alias resolves to its base labels. `AliasResult` is flat
          # (resolve_alias_labels pre-expands alias-of-alias), so one
          # pass suffices; the helper does not re-enter `expand_ta_te`.
          expand_row_aliases_in_te(expanded, aliases)
        }
        None -> TypeExpr { tkind: TyName(r, targs1), line: te.line, col: te.col }
      }
    }
    TyList(inner) ->
      TypeExpr { tkind: TyList(expand_ta_te(inner, table, aliases, fuel)),
                  line: te.line, col: te.col }
    TyFn(ps, ret, row) ->
      TypeExpr { tkind: TyFn(expand_ta_te_list(ps, table, aliases, fuel),
                              expand_ta_te(ret, table, aliases, fuel),
                              expand_ta_row(row, table, aliases, fuel)),
                  line: te.line, col: te.col }
    TyDim(base, u) ->
      TypeExpr { tkind: TyDim(expand_ta_te(base, table, aliases, fuel), u),
                  line: te.line, col: te.col }
    TyRefine(base, p) ->
      TypeExpr { tkind: TyRefine(expand_ta_te(base, table, aliases, fuel), p),
                  line: te.line, col: te.col }
    # issue #772: a compound row as a type argument — expand transparent
    # aliases inside any parameterised labels it carries, then leave the
    # carrier for `apply_tp_subst_row` to dissolve at substitution time.
    TyRow(row) ->
      TypeExpr { tkind: TyRow(expand_ta_row(row, table, aliases, fuel)),
                  line: te.line, col: te.col }
    TySurface(ts) ->
      TypeExpr { tkind: TySurface(tysurface_rebuild(ts, expand_ta_te_list(tysurface_children(ts), table, aliases, fuel))),
                  line: te.line, col: te.col }
  } }
}

fn expand_ta_te_list(tes: [TypeExpr], table: TAScope, aliases: [AliasResult], fuel: Int) : [TypeExpr] {
  match tes {
    [] -> []
    [t, ...rest] -> [expand_ta_te(t, table, aliases, fuel),
                     ...expand_ta_te_list(rest, table, aliases, fuel)]
  }
}

# Walk a RowExpr looking for TypeExprs (inside label ty_args) to expand.
# The row tail is a name — not a TypeExpr — so no alias substitution
# happens there. Label ty_args (`Reader[Int]`) carry TypeExprs that
# may mention aliases.

# Walk a RowExpr looking for TypeExprs (inside label ty_args) to expand.
# The row tail is a name — not a TypeExpr — so no alias substitution
# happens there. Label ty_args (`Reader[Int]`) carry TypeExprs that
# may mention aliases.
fn expand_ta_row(r: RowExpr, table: TAScope, aliases: [AliasResult], fuel: Int) : RowExpr {
  match r {
    REmpty -> REmpty
    RClosed(labels) -> RClosed(expand_ta_rls(labels, table, aliases, fuel))
    ROpen(rv, labels) -> ROpen(rv, expand_ta_rls(labels, table, aliases, fuel))
  }
}

fn expand_ta_rls(ls: [RowLabel], table: TAScope, aliases: [AliasResult], fuel: Int) : [RowLabel] {
  match ls {
    [] -> []
    [rl, ...rest] -> match rl {
      RL(r, ts) -> [
        RL(r, expand_ta_te_list(ts, table, aliases, fuel)),
        ...expand_ta_rls(rest, table, aliases, fuel)
      ]
    }
  }
}

# Walk every Decl, expanding transparent aliases in every TypeExpr.
# Mirrors qualtype_decl shape but rewrites TypeExprs only — no Console
# diagnostics (all errors deferred to downstream typer cascade).

# Walk every Decl, expanding transparent aliases in every TypeExpr.
# Mirrors qualtype_decl shape but rewrites TypeExprs only — no Console
# diagnostics (all errors deferred to downstream typer cascade).
#[doc("Walk every Decl, expanding transparent aliases in every TypeExpr. Mirrors qualtype_decl shape but rewrites TypeExprs only — no Console diagnostics (all errors deferred to…")]
pub fn expand_ta_decls(decls: [Decl], tab: SymTab, table: [TAEntry], aliases: [AliasResult]) : [Decl] {
  let fuel = list_length(table) + 1
  expand_ta_decls_loop(decls, TAScope { tab: tab, entries: table }, aliases, fuel)
}

#[doc("Expand transparent aliases in one decl against an already module-scoped table.")]
pub fn ta_expand_one(d: Decl, tab: SymTab, table: [TAEntry], aliases: [AliasResult],
      fuel: Int) : Decl = expand_ta_decl(d, TAScope { tab: tab, entries: table }, aliases, fuel)

fn expand_ta_decls_loop(decls: [Decl], table: TAScope, aliases: [AliasResult], fuel: Int) : [Decl] {
  match decls {
    [] -> []
    [d, ...rest] -> [expand_ta_decl(d, table, aliases, fuel),
                     ...expand_ta_decls_loop(rest, table, aliases, fuel)]
  }
}

fn expand_ta_decl(d: Decl, table: TAScope, aliases: [AliasResult], fuel: Int) : Decl {
  match d {
    DFn(p, fid, tps, ps, ret_opt, row, body, l, c, mo) ->
      DFn(p, fid, tps, expand_ta_params(ps, table, aliases, fuel),
          match ret_opt { None -> None Some(te) -> Some(expand_ta_te(te, table, aliases, fuel)) },
          expand_ta_row(row, table, aliases, fuel),
          expand_ta_expr(body, table, aliases, fuel), l, c, mo)
    DType(p, tsym, tps, body, l, c, mo, slots) ->
      # Skip rewriting the alias's own DType body: keeping the original
      # decl preserves the alias name in `--ast` output and lets later
      # passes that consult it (refinement synth, dump) see the surface
      # form. Nominal record/sum bodies still get their field/variant
      # TypeExprs walked so a record field typed with an alias resolves.
      match body {
        TBAlias(_) -> d
        TBEffectAlias(_) -> d
        TBRecord(fs) ->
          DType(p, tsym, tps, TBRecord(expand_ta_fields(fs, table, aliases, fuel)), l, c, mo, slots)
        TBSum(vs) ->
          DType(p, tsym, tps, TBSum(expand_ta_variants(vs, table, aliases, fuel)), l, c, mo, slots)
      }
    DEffect(p, esym, tps, ops, defblk, l, c, mo) ->
      DEffect(p, esym, tps, expand_ta_eops(ops, table, aliases, fuel), defblk, l, c, mo)
    DProtocol(p, psym, tps, ops, l, c, mo) ->
      DProtocol(p, psym, tps, expand_ta_pops(ops, table, aliases, fuel), l, c, mo)
    DImpl(name, proto_args, ty, sub_decls, l, c, tps, isym) ->
      DImpl(name, expand_ta_te_list(proto_args, table, aliases, fuel),
            expand_ta_te(ty, table, aliases, fuel),
            expand_ta_decls_loop(sub_decls, table, aliases, fuel), l, c, tps, isym)
    DDerive(ps, inner, l, c) ->
      DDerive(ps, expand_ta_decl(inner, table, aliases, fuel), l, c)
    DUnstable(inner, l, c) ->
      DUnstable(expand_ta_decl(inner, table, aliases, fuel), l, c)
    DProtoLaws(thy, inner, l, c, mo) ->
      DProtoLaws(thy, expand_ta_decl(inner, table, aliases, fuel), l, c, mo)
    DImplAxiom(thy, inner, l, c, mo) ->
      DImplAxiom(thy, expand_ta_decl(inner, table, aliases, fuel), l, c, mo)
    DConstructor(inner, l, c) ->
      DConstructor(expand_ta_decl(inner, table, aliases, fuel), l, c)
    DAxiom(p, sm, n, cso, tps, ps, ret, row, l, c) ->
      DAxiom(p, sm, n, cso, tps, expand_ta_params(ps, table, aliases, fuel),
             expand_ta_te(ret, table, aliases, fuel), row, l, c)
    DConst(p, csym, ty, body, mo, l, c) ->
      DConst(p, csym, expand_ta_te(ty, table, aliases, fuel),
              expand_ta_expr(body, table, aliases, fuel), mo, l, c)
    DTest(n, body, l, c, mo) -> DTest(n, expand_ta_expr(body, table, aliases, fuel), l, c, mo)
    DBench(n, body, l, c, mo) -> DBench(n, expand_ta_expr(body, table, aliases, fuel), l, c, mo)
    DCheck(n, ps, body, l, c, mo) ->
      DCheck(n, expand_ta_params(ps, table, aliases, fuel),
              expand_ta_expr(body, table, aliases, fuel), l, c, mo)
    DImport(_, _, _) -> d
    DUnit(_, _, _, _, _, _, _) -> d
    DUse(_, _, _) -> d
    DUseKind(_, _, _, _) -> d
    # Issue #681: the module-doc carrier has no types to expand; a
    # documented decl arriving wrapped (pre-strip callers) recurses.
    DDoc(raw, text, inner, l, c) -> DDoc(raw, text, expand_ta_decl(inner, table, aliases, fuel), l, c)
    DAttr(raw, inner, l, c) -> DAttr(raw, expand_ta_decl(inner, table, aliases, fuel), l, c)
    DModuleDoc(_, _, _, _) -> d
    DExternType(_, _, _, _, _) -> d   # FFI v2: foreign type carries no transparent-alias-expandable type expressions
    DTheory(_, _, _, _, _) -> d
    DKind(_, _, _, _, _, _, _, _) -> d
  }
}

fn expand_ta_params(ps: [Param], table: TAScope, aliases: [AliasResult], fuel: Int) : [Param] {
  match ps {
    [] -> []
    [p, ...rest] -> [expand_ta_param(p, table, aliases, fuel),
                     ...expand_ta_params(rest, table, aliases, fuel)]
  }
}

fn expand_ta_param(pm: Param, table: TAScope, aliases: [AliasResult], fuel: Int) : Param =
  Param { binder: pm.binder,
          ptype: match pm.ptype {
            None -> None
            Some(te) -> Some(expand_ta_te(te, table, aliases, fuel))
          },
          pline: pm.pline, pcol: pm.pcol, pborrow: pm.pborrow }

fn expand_ta_fields(fs: [FieldDecl], table: TAScope, aliases: [AliasResult], fuel: Int) : [FieldDecl] {
  match fs {
    [] -> []
    [f, ...rest] -> match f {
      FD(is_pub, name, te, attrs) -> [FD(is_pub, name, expand_ta_te(te, table, aliases, fuel), attrs),
                       ...expand_ta_fields(rest, table, aliases, fuel)]
    }
  }
}

fn expand_ta_variants(vs: [Variant], table: TAScope, aliases: [AliasResult], fuel: Int) : [Variant] {
  match vs {
    [] -> []
    [v, ...rest] -> match v {
      Var(cname, vargs) -> [Var(cname, expand_ta_te_list(vargs, table, aliases, fuel)),
                             ...expand_ta_variants(rest, table, aliases, fuel)]
    }
  }
}

fn expand_ta_eops(ops: [EffectOp], table: TAScope, aliases: [AliasResult], fuel: Int) : [EffectOp] {
  match ops {
    [] -> []
    [op, ...rest] -> match op {
      EffOp(name, tps, ps, ret, l, c) ->
        [EffOp(name, tps, expand_ta_params(ps, table, aliases, fuel),
              expand_ta_te(ret, table, aliases, fuel), l, c),
         ...expand_ta_eops(rest, table, aliases, fuel)]
    }
  }
}

fn expand_ta_pops(ops: [ProtoOp], table: TAScope, aliases: [AliasResult], fuel: Int) : [ProtoOp] {
  match ops {
    [] -> []
    [op, ...rest] -> match op {
      POp(name, tps, ps, ret, l, c) ->
        [POp(name, tps, expand_ta_params(ps, table, aliases, fuel),
              expand_ta_te(ret, table, aliases, fuel), l, c),
         ...expand_ta_pops(rest, table, aliases, fuel)]
    }
  }
}

fn expand_ta_expr(e: Expr, table: TAScope, aliases: [AliasResult], fuel: Int) : Expr =
  Expr { kind: expand_ta_expr_kind(e.kind, table, aliases, fuel),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn expand_ta_expr_kind(k: ExprKind, table: TAScope, aliases: [AliasResult], fuel: Int) : ExprKind {
  match k {
    EBlock(stmts, opt_final) ->
      EBlock(expand_ta_stmts(stmts, table, aliases, fuel),
             match opt_final {
               None -> None
               Some(fe) -> Some(expand_ta_expr(fe, table, aliases, fuel))
             })
    EMatch(scrut, arms) ->
      EMatch(expand_ta_expr(scrut, table, aliases, fuel),
             expand_ta_arms(arms, table, aliases, fuel))
    EVariantsOf(te, ns) ->
      EVariantsOf(expand_ta_te(te, table, aliases, fuel), ns)
    ELambda(ps, body) ->
      ELambda(expand_ta_params(ps, table, aliases, fuel),
              expand_ta_expr(body, table, aliases, fuel))
    EHandle(body, eff, ty_args, init_opt, alias_opt, clauses, ret_opt) ->
      EHandle(expand_ta_expr(body, table, aliases, fuel), eff,
              expand_ta_te_list(ty_args, table, aliases, fuel),
              match init_opt { None -> None Some(ie) -> Some(expand_ta_expr(ie, table, aliases, fuel)) },
              alias_opt,
              expand_ta_hclauses(clauses, table, aliases, fuel),
              match ret_opt {
                None -> None
                Some(r) -> Some(expand_ta_hreturn(r, table, aliases, fuel))
              })
    _ -> map_expr_kind(k, (sub) => expand_ta_expr(sub, table, aliases, fuel))
  }
}

fn expand_ta_arms(arms: [Arm], table: TAScope, aliases: [AliasResult], fuel: Int) : [Arm] {
  match arms {
    [] -> []
    [a, ...rest] -> [expand_ta_arm(a, table, aliases, fuel),
                     ...expand_ta_arms(rest, table, aliases, fuel)]
  }
}

fn expand_ta_arm(a: Arm, table: TAScope, aliases: [AliasResult], fuel: Int) : Arm {
  match a {
    Arm(pat, opt_guard, body) ->
      Arm(expand_ta_pat(pat, table, aliases, fuel),
          match opt_guard {
            None -> None
            Some(g) -> Some(expand_ta_expr(g, table, aliases, fuel))
          },
          expand_ta_expr(body, table, aliases, fuel))
  }
}

fn expand_ta_pat(pat: Pattern, table: TAScope, aliases: [AliasResult], fuel: Int) : Pattern {
  match pat.pkind {
    PNarrow(name, te) ->
      Pattern { pkind: PNarrow(name, expand_ta_te(te, table, aliases, fuel)),
                 line: pat.line, col: pat.col }
    PVariant(r, subs) ->
      Pattern { pkind: PVariant(r, expand_ta_pat_list(subs, table, aliases, fuel)),
                 line: pat.line, col: pat.col }
    PVariantRecord(r, fs) ->
      Pattern { pkind: PVariantRecord(r, expand_ta_pfields(fs, table, aliases, fuel)),
                 line: pat.line, col: pat.col }
    PRecord(fs) ->
      Pattern { pkind: PRecord(expand_ta_pfields(fs, table, aliases, fuel)),
                 line: pat.line, col: pat.col }
    PList(subs, rest) ->
      Pattern { pkind: PList(expand_ta_pat_list(subs, table, aliases, fuel), rest),
                 line: pat.line, col: pat.col }
    PAs(name, inner) ->
      Pattern { pkind: PAs(name, expand_ta_pat(inner, table, aliases, fuel)),
                 line: pat.line, col: pat.col }
    _ -> pat
  }
}

fn expand_ta_pat_list(ps: [Pattern], table: TAScope, aliases: [AliasResult], fuel: Int) : [Pattern] {
  match ps {
    [] -> []
    [p, ...rest] -> [expand_ta_pat(p, table, aliases, fuel),
                     ...expand_ta_pat_list(rest, table, aliases, fuel)]
  }
}

fn expand_ta_pfields(fs: [PField], table: TAScope, aliases: [AliasResult], fuel: Int) : [PField] {
  match fs {
    [] -> []
    [f, ...rest] -> match f {
      PField(name, sub, sh) -> [PField(name, expand_ta_pat(sub, table, aliases, fuel), sh),
                                 ...expand_ta_pfields(rest, table, aliases, fuel)]
    }
  }
}

fn expand_ta_stmts(ss: [Stmt], table: TAScope, aliases: [AliasResult], fuel: Int) : [Stmt] {
  match ss {
    [] -> []
    [s, ...rest] -> [expand_ta_stmt(s, table, aliases, fuel),
                     ...expand_ta_stmts(rest, table, aliases, fuel)]
  }
}

fn expand_ta_stmt(s: Stmt, table: TAScope, aliases: [AliasResult], fuel: Int) : Stmt {
  match s {
    SLet(pat, ty_opt, e) ->
      SLet(expand_ta_pat(pat, table, aliases, fuel),
           match ty_opt {
             None -> None
             Some(te) -> Some(expand_ta_te(te, table, aliases, fuel))
           },
           expand_ta_expr(e, table, aliases, fuel))
    SVar(name, ty_opt, init, l, c) ->
      SVar(name,
           match ty_opt {
             None -> None
             Some(te) -> Some(expand_ta_te(te, table, aliases, fuel))
           },
           expand_ta_expr(init, table, aliases, fuel), l, c)
    SAssert(e, om) ->
      SAssert(expand_ta_expr(e, table, aliases, fuel),
              match om { None -> None Some(m) -> Some(expand_ta_expr(m, table, aliases, fuel)) })
    SExprStmt(e) -> SExprStmt(expand_ta_expr(e, table, aliases, fuel))
    SIndexAssign(t, ix, v, l, c) ->
      SIndexAssign(expand_ta_expr(t, table, aliases, fuel),
                    expand_ta_expr(ix, table, aliases, fuel),
                    expand_ta_expr(v, table, aliases, fuel), l, c)
    SAssign(t, v, l, c) ->
      SAssign(expand_ta_expr(t, table, aliases, fuel),
               expand_ta_expr(v, table, aliases, fuel), l, c)
    SUse(eff, l, c) -> SUse(eff, l, c)
  }
}

fn expand_ta_hclauses(cs: [HClause], table: TAScope, aliases: [AliasResult], fuel: Int) : [HClause] {
  match cs {
    [] -> []
    [c, ...rest] -> match c {
      HC(name, ps, body, l, col) ->
        [HC(name, expand_ta_params(ps, table, aliases, fuel),
             expand_ta_expr(body, table, aliases, fuel), l, col),
         ...expand_ta_hclauses(rest, table, aliases, fuel)]
    }
  }
}

fn expand_ta_hreturn(r: HReturn, table: TAScope, aliases: [AliasResult], fuel: Int) : HReturn {
  match r {
    HR(name, body, l, c) -> HR(name, expand_ta_expr(body, table, aliases, fuel), l, c)
  }
}

# A core module's private sum type and a user type may share a name.
# Inside the core segment that declares one, every written reference to
# it is settled to its declaration here, before the typer, so the core's
# own matches never see the user's constructors and the user's never see
# the core's. Only sum types are settled; a segment cannot name another
# segment's private type, and the root's declarations are left alone.

# A core segment's private sum types, and the table that names them.
type PrivTys = { tab: SymTab, types: [SymId] }

fn collect_private_segment_types(decls: [Decl], acc: [SymId]) : [SymId] {
  match decls {
    [] -> acc
    [d, ...rest] -> collect_private_segment_types(rest, private_type_entry_of(d, acc))
  }
}

fn private_type_entry_of(d: Decl, acc: [SymId]) : [SymId] {
  match d {
    DType(is_pub, tsym, _, body, _, _, _, _) ->
      if is_pub { acc }
      else { match body {
        TBSum(_) -> [tsym, ...acc]
        _ -> acc
      } }
    _ -> acc
  }
}

# The private type a written reference names in its own segment.
fn priv_ty_lookup(entries: PrivTys, r: DeclRef) : Option[SymId] = match r {
  DrWritten(None, n) -> priv_ty_among(entries.types, st_candidates(entries.tab, NCType, written_text(n)))
  _                  -> None
}

fn priv_ty_among(types: [SymId], named: [SymId]) : Option[SymId] = match named {
  [] -> None
  [s, ...rest] ->
    if any(types, (t) => sym_same(t, s)) { Some(s) } else { priv_ty_among(types, rest) }
}

#[doc("Settle, inside each core segment, the written references to that segment's own private sum types. `segs` gives each core file's module and length, `n_core` how many of `decls` are core; `tab` names the types.")]
pub fn mangle_core_segments(decls: [Decl], tab: SymTab, segs: [CoreSegment],
                              n_core: Int) : [Decl] {
  let core_part = pae_take(decls, n_core)
  let root_part = pae_drop(decls, n_core)
  let mangled_core = mangle_core_segments_loop(core_part, tab, segs, [])
  list_append(mangled_core, root_part)
}

fn mangle_core_segments_loop(core_decls: [Decl], tab: SymTab,
                                   segs: [CoreSegment],
                                   acc: [Decl]) : [Decl] {
  match segs {
    [] -> list_append(acc, core_decls)   # safety: leftover untouched
    [s, ...rest] -> match s {
      PSeg(mod_name, seg_template) -> {
        let n_seg = list_length(seg_template)
        let this_seg = pae_take(core_decls, n_seg)
        let remaining = pae_drop(core_decls, n_seg)
        let seg_types = collect_private_segment_types(this_seg, [])
        let mangled_seg =
          if seg_types == [] { this_seg }
          else { mangle_one_segment(this_seg, PrivTys { tab: tab, types: seg_types }, mod_name, []) }
        mangle_core_segments_loop(remaining, tab, rest,
                                        list_append(acc, mangled_seg))
      }
    }
  }
}

fn mangle_one_segment(decls: [Decl], entries: PrivTys,
                        mod_name: String, acc: [Decl]) : [Decl] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> {
      let d1 = mangle_one_decl(d, entries, mod_name)
      mangle_one_segment(rest, entries, mod_name, [d1, ...acc])
    }
  }
}

fn mangle_one_decl(d: Decl, entries: PrivTys, home_mod: String) : Decl {
  match d {
    DType(is_pub, tsym, tps, body, l, c, mo, slots) ->
      DType(is_pub, tsym, tps,
            mangle_typebody(body, entries, home_mod), l, c, mo, slots)
    DFn(p, fid, tps, ps, ret_opt, row, body, l, c, mo) ->
      DFn(p, fid, tps, mangle_params(ps, entries, home_mod),
          match ret_opt { None -> None
                          Some(te) -> Some(mangle_te(te, entries, home_mod)) },
          row,
          mangle_expr(body, entries, home_mod), l, c, mo)
    DAxiom(p, sm, n, cso, tps, ps, ret, row, l, c) ->
      DAxiom(p, sm, n, cso, tps, mangle_params(ps, entries, home_mod),
             mangle_te(ret, entries, home_mod), row, l, c)
    DConst(p, csym, ty, body, mo, l, c) ->
      DConst(p, csym, mangle_te(ty, entries, home_mod),
              mangle_expr(body, entries, home_mod), mo, l, c)
    DEffect(p, esym, tps, ops, defblk, l, c, _) ->
      DEffect(p, esym, tps, mangle_eops(ops, entries, home_mod), defblk, l, c, None)
    DProtocol(p, psym, tps, ops, l, c, mo) ->
      DProtocol(p, psym, tps, mangle_pops(ops, entries, home_mod), l, c, mo)
    DImpl(name, proto_args, ty, sub_decls, l, c, tps, isym) ->
      DImpl(name, mangle_te_list(proto_args, entries, home_mod),
            mangle_te(ty, entries, home_mod),
            mangle_one_segment(sub_decls, entries, home_mod, []),
            l, c, tps, isym)
    DDerive(ps, inner, l, c) ->
      DDerive(ps, mangle_one_decl(inner, entries, home_mod), l, c)
    DUnstable(inner, l, c) ->
      DUnstable(mangle_one_decl(inner, entries, home_mod), l, c)
    DProtoLaws(thy, inner, l, c, mo) ->
      DProtoLaws(thy, mangle_one_decl(inner, entries, home_mod), l, c, mo)
    DImplAxiom(thy, inner, l, c, mo) ->
      DImplAxiom(thy, mangle_one_decl(inner, entries, home_mod), l, c, mo)
    DConstructor(inner, l, c) ->
      DConstructor(mangle_one_decl(inner, entries, home_mod), l, c)
    DTest(n, body, l, c, mo) ->
      DTest(n, mangle_expr(body, entries, home_mod), l, c, mo)
    DBench(n, body, l, c, mo) ->
      DBench(n, mangle_expr(body, entries, home_mod), l, c, mo)
    DCheck(n, ps, body, l, c, mo) ->
      DCheck(n, mangle_params(ps, entries, home_mod),
              mangle_expr(body, entries, home_mod), l, c, mo)
    _ -> d
  }
}

fn mangle_te(te: TypeExpr, entries: PrivTys, home_mod: String) : TypeExpr {
  match te.tkind {
    TyName(r, targs) -> {
      let targs1 = mangle_te_list(targs, entries, home_mod)
      let r1 = match priv_ty_lookup(entries, r) {
        Some(s) -> DrSym(s)
        None    -> r
      }
      TypeExpr { tkind: TyName(r1, targs1), line: te.line, col: te.col }
    }
    TyList(inner) ->
      TypeExpr { tkind: TyList(mangle_te(inner, entries, home_mod)),
                  line: te.line, col: te.col }
    TyFn(ps, ret, row) ->
      TypeExpr { tkind: TyFn(mangle_te_list(ps, entries, home_mod),
                              mangle_te(ret, entries, home_mod),
                              mangle_row(row, entries, home_mod)),
                  line: te.line, col: te.col }
    TyDim(base, u) ->
      TypeExpr { tkind: TyDim(mangle_te(base, entries, home_mod), u),
                  line: te.line, col: te.col }
    TyRefine(base, p) ->
      TypeExpr { tkind: TyRefine(mangle_te(base, entries, home_mod), p),
                  line: te.line, col: te.col }
    # issue #772: a compound row carrier — mangle private labels it
    # carries. Dissolved by alias substitution before reaching emit, so
    # this is defensive completeness for the exhaustiveness check.
    TyRow(row) ->
      TypeExpr { tkind: TyRow(mangle_row(row, entries, home_mod)),
                  line: te.line, col: te.col }
    TySurface(ts) ->
      TypeExpr { tkind: TySurface(tysurface_rebuild(ts, mangle_te_list(tysurface_children(ts), entries, home_mod))),
                  line: te.line, col: te.col }
  }
}

fn mangle_te_list(tes: [TypeExpr], entries: PrivTys,
                    home_mod: String) : [TypeExpr] {
  match tes {
    [] -> []
    [t, ...rest] -> [mangle_te(t, entries, home_mod),
                     ...mangle_te_list(rest, entries, home_mod)]
  }
}

fn mangle_row(r: RowExpr, entries: PrivTys,
                home_mod: String) : RowExpr {
  match r {
    REmpty -> REmpty
    RClosed(labels) -> RClosed(mangle_rls(labels, entries, home_mod))
    ROpen(rv, labels) -> ROpen(rv, mangle_rls(labels, entries, home_mod))
  }
}

fn mangle_rls(ls: [RowLabel], entries: PrivTys,
                home_mod: String) : [RowLabel] {
  match ls {
    [] -> []
    [rl, ...rest] -> match rl {
      RL(r, ts) -> [RL(r, mangle_te_list(ts, entries, home_mod)),
                        ...mangle_rls(rest, entries, home_mod)]
    }
  }
}

fn mangle_params(ps: [Param], entries: PrivTys,
                   home_mod: String) : [Param] {
  match ps {
    [] -> []
    [p, ...rest] -> [mangle_param(p, entries, home_mod),
                     ...mangle_params(rest, entries, home_mod)]
  }
}

fn mangle_param(pm: Param, entries: PrivTys,
                  home_mod: String) : Param =
  Param { binder: pm.binder,
          ptype: match pm.ptype {
            None -> None
            Some(te) -> Some(mangle_te(te, entries, home_mod))
          },
          pline: pm.pline, pcol: pm.pcol, pborrow: pm.pborrow }

fn mangle_typebody(b: TypeBody, entries: PrivTys,
                     home_mod: String) : TypeBody {
  match b {
    TBAlias(t) -> TBAlias(mangle_te(t, entries, home_mod))
    TBRecord(fs) -> TBRecord(mangle_fields(fs, entries, home_mod))
    TBSum(vs) -> TBSum(mangle_variants(vs, entries, home_mod))
    TBEffectAlias(_) -> b
  }
}

fn mangle_fields(fs: [FieldDecl], entries: PrivTys,
                   home_mod: String) : [FieldDecl] {
  match fs {
    [] -> []
    [f, ...rest] -> match f {
      FD(is_pub, name, te, attrs) -> [FD(is_pub, name, mangle_te(te, entries, home_mod), attrs),
                        ...mangle_fields(rest, entries, home_mod)]
    }
  }
}

fn mangle_variants(vs: [Variant], entries: PrivTys,
                     home_mod: String) : [Variant] {
  match vs {
    [] -> []
    [v, ...rest] -> match v {
      Var(cname, vargs) -> [Var(cname, mangle_te_list(vargs, entries, home_mod)),
                             ...mangle_variants(rest, entries, home_mod)]
    }
  }
}

fn mangle_eops(ops: [EffectOp], entries: PrivTys,
                 home_mod: String) : [EffectOp] {
  match ops {
    [] -> []
    [op, ...rest] -> match op {
      EffOp(name, tps, ps, ret, l, c) ->
        [EffOp(name, tps, mangle_params(ps, entries, home_mod),
              mangle_te(ret, entries, home_mod), l, c),
         ...mangle_eops(rest, entries, home_mod)]
    }
  }
}

fn mangle_pops(ops: [ProtoOp], entries: PrivTys,
                 home_mod: String) : [ProtoOp] {
  match ops {
    [] -> []
    [op, ...rest] -> match op {
      POp(name, tps, ps, ret, l, c) ->
        [POp(name, tps, mangle_params(ps, entries, home_mod),
              mangle_te(ret, entries, home_mod), l, c),
         ...mangle_pops(rest, entries, home_mod)]
    }
  }
}

fn mangle_expr(e: Expr, entries: PrivTys, home_mod: String) : Expr =
  Expr { kind: mangle_expr_kind(e.kind, entries, home_mod),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn mangle_expr_kind(k: ExprKind, entries: PrivTys,
                       home_mod: String) : ExprKind {
  match k {
    EBlock(stmts, opt_final) ->
      EBlock(mangle_stmts(stmts, entries, home_mod),
             match opt_final {
               None -> None
               Some(fe) -> Some(mangle_expr(fe, entries, home_mod))
             })
    EMatch(scrut, arms) ->
      EMatch(mangle_expr(scrut, entries, home_mod),
             mangle_arms(arms, entries, home_mod))
    EVariantsOf(te, ns) ->
      EVariantsOf(mangle_te(te, entries, home_mod), ns)
    ELambda(ps, body) ->
      ELambda(mangle_params(ps, entries, home_mod),
              mangle_expr(body, entries, home_mod))
    EHandle(body, eff, ty_args, init_opt, alias_opt, clauses, ret_opt) ->
      EHandle(mangle_expr(body, entries, home_mod), eff,
              mangle_te_list(ty_args, entries, home_mod),
              match init_opt {
                None -> None
                Some(ie) -> Some(mangle_expr(ie, entries, home_mod))
              },
              alias_opt,
              mangle_hclauses(clauses, entries, home_mod),
              match ret_opt {
                None -> None
                Some(r) -> Some(mangle_hreturn(r, entries, home_mod))
              })
    _ -> map_expr_kind(k, (sub) => mangle_expr(sub, entries, home_mod))
  }
}

fn mangle_arms(arms: [Arm], entries: PrivTys,
                 home_mod: String) : [Arm] {
  match arms {
    [] -> []
    [a, ...rest] -> [mangle_arm(a, entries, home_mod),
                     ...mangle_arms(rest, entries, home_mod)]
  }
}

fn mangle_arm(a: Arm, entries: PrivTys, home_mod: String) : Arm {
  match a {
    Arm(pat, opt_guard, body) ->
      Arm(mangle_pat(pat, entries, home_mod),
          match opt_guard {
            None -> None
            Some(g) -> Some(mangle_expr(g, entries, home_mod))
          },
          mangle_expr(body, entries, home_mod))
  }
}

fn mangle_pat(pat: Pattern, entries: PrivTys,
                home_mod: String) : Pattern {
  match pat.pkind {
    PNarrow(name, te) ->
      Pattern { pkind: PNarrow(name, mangle_te(te, entries, home_mod)),
                 line: pat.line, col: pat.col }
    PVariant(r, subs) ->
      Pattern { pkind: PVariant(r, mangle_pat_list(subs, entries, home_mod)),
                 line: pat.line, col: pat.col }
    PVariantRecord(r, fs) ->
      Pattern { pkind: PVariantRecord(r, mangle_pfields(fs, entries, home_mod)),
                 line: pat.line, col: pat.col }
    PRecord(fs) ->
      Pattern { pkind: PRecord(mangle_pfields(fs, entries, home_mod)),
                 line: pat.line, col: pat.col }
    PList(subs, rest) ->
      Pattern { pkind: PList(mangle_pat_list(subs, entries, home_mod), rest),
                 line: pat.line, col: pat.col }
    PAs(name, inner) ->
      Pattern { pkind: PAs(name, mangle_pat(inner, entries, home_mod)),
                 line: pat.line, col: pat.col }
    _ -> pat
  }
}

fn mangle_pat_list(ps: [Pattern], entries: PrivTys,
                     home_mod: String) : [Pattern] {
  match ps {
    [] -> []
    [p, ...rest] -> [mangle_pat(p, entries, home_mod),
                     ...mangle_pat_list(rest, entries, home_mod)]
  }
}

fn mangle_pfields(fs: [PField], entries: PrivTys,
                    home_mod: String) : [PField] {
  match fs {
    [] -> []
    [f, ...rest] -> match f {
      PField(name, sub, sh) -> [PField(name, mangle_pat(sub, entries, home_mod), sh),
                                 ...mangle_pfields(rest, entries, home_mod)]
    }
  }
}

fn mangle_stmts(ss: [Stmt], entries: PrivTys,
                  home_mod: String) : [Stmt] {
  match ss {
    [] -> []
    [s, ...rest] -> [mangle_stmt(s, entries, home_mod),
                     ...mangle_stmts(rest, entries, home_mod)]
  }
}

fn mangle_stmt(s: Stmt, entries: PrivTys, home_mod: String) : Stmt {
  match s {
    SLet(pat, ty_opt, e) ->
      SLet(mangle_pat(pat, entries, home_mod),
           match ty_opt {
             None -> None
             Some(te) -> Some(mangle_te(te, entries, home_mod))
           },
           mangle_expr(e, entries, home_mod))
    SVar(name, ty_opt, init, l, c) ->
      SVar(name,
           match ty_opt {
             None -> None
             Some(te) -> Some(mangle_te(te, entries, home_mod))
           },
           mangle_expr(init, entries, home_mod), l, c)
    SAssert(e, om) ->
      SAssert(mangle_expr(e, entries, home_mod),
              match om {
                None -> None
                Some(m) -> Some(mangle_expr(m, entries, home_mod))
              })
    SExprStmt(e) -> SExprStmt(mangle_expr(e, entries, home_mod))
    SIndexAssign(t, ix, v, l, c) ->
      SIndexAssign(mangle_expr(t, entries, home_mod),
                    mangle_expr(ix, entries, home_mod),
                    mangle_expr(v, entries, home_mod), l, c)
    SAssign(t, v, l, c) ->
      SAssign(mangle_expr(t, entries, home_mod),
               mangle_expr(v, entries, home_mod), l, c)
    SUse(eff, l, c) -> SUse(eff, l, c)
  }
}

fn mangle_hclauses(cs: [HClause], entries: PrivTys,
                     home_mod: String) : [HClause] {
  match cs {
    [] -> []
    [c, ...rest] -> match c {
      HC(name, ps, body, l, col) ->
        [HC(name, mangle_params(ps, entries, home_mod),
             mangle_expr(body, entries, home_mod), l, col),
         ...mangle_hclauses(rest, entries, home_mod)]
    }
  }
}

fn mangle_hreturn(r: HReturn, entries: PrivTys,
                    home_mod: String) : HReturn {
  match r {
    HR(name, body, l, c) -> HR(name, mangle_expr(body, entries, home_mod), l, c)
  }
}

# m7b #1d — display-time alias preservation (Doc A §*Open questions*
# #5). Render a label set using the largest alias that fully covers
# it; remaining labels (those outside the alias) are appended with
# `+`. The alias rewrite at resolve time is value-preserving, so the
# choice is purely cosmetic — diagnostics keep the user's `Io`
# spelling when it still describes the row, and fall back to the
# expanded labels on partial coverage. Currently no diagnostic prints
# whole rows; this helper is the building block when row-mismatch
# rendering lands.

# Return the alias whose label set is a subset of `labels` and that
# covers the largest number of labels. Ties prefer the alias seen
# first (lexically earlier in source).

fn sig_of_decl(d: Decl) : Option[Ty] {
  match d {
    DFn(_, _, _, params, opt_ret, rexpr, _, _, _, _) -> {
      let pts = map(params, param_ty)
      let ret = match opt_ret {
        Some(rty) -> resolve_ty(rty)
        None -> TyUnit
      }
      Some(TyFnT(pts, ret, row_of_expr(rexpr)))
    }
    # m12.7: axiom signature has the same shape as a fn — params,
    # return type, row. The body's row is replaced by the declared
    # row directly (no body to read row_of_expr from).
    DAxiom(_, _, _, _, _, params, ret_ty, row, _, _) -> {
      let pts = map(params, param_ty)
      let ret = resolve_ty(ret_ty)
      Some(TyFnT(pts, ret, row_of_expr(row)))
    }
    _ -> None
  }
}

# The mangle of a type that names no declaration: a scalar, or a shape
# over scalars and core types.
fn mangle_ty(t: Ty) : String = mangle_ty_in(st_empty(), t)

fn mangle_ty_in(tab: SymTab, t: Ty) : String {
  match t {
    TyInt    -> "Int"
    TyReal   -> "Real"
    TyBool   -> "Bool"
    TyString -> "String"
    TyChar   -> "Char"
    TyUnit   -> "Unit"
    TyByte     -> "Byte"
    TyInt32    -> "Int32"
    TyUInt32   -> "UInt32"
    TyUInt64   -> "UInt64"
    TyInt128   -> "Int128"
    TyHandle   -> "Handle"
    TyListT(inner) -> concat_all(["L_", mangle_ty_in(tab, inner), "_E"])
    TyFnT(ps, ret, _) -> concat_all([
      "F_", join_with(map(ps, (p) => mangle_ty_in(tab, p)), "_"),
      "_R_", mangle_ty_in(tab, ret), "_E"
    ])
    TyCon(s, tas) -> {
      let cname = rt_name(tab, s)
      match tas {
        [] -> cname
        [_h, ..._rest] -> concat_all([cname, "_O_",
                                    join_with(map(tas, (a) => mangle_ty_in(tab, a)), "_"),
                                    "_C"])
      }
    }
    TyVarT(_) -> "TVAR"
    # a resolved shape app is erased to its constructor before codegen;
    # an unresolved one is a bug, flagged like `TVAR`.
    TyShapeApp(_, arg) -> concat_all(["SVAR_", mangle_ty_in(tab, arg)])
    TyAny     -> "Any"
    # m12.5: units are erased at codegen time. The mangled name for a
    # dimensioned type is the same as its base type's mangle — so a
    # call like `f(1.0<USD>)` and a call `f(1.0)` mangle into the same
    # specialisation. This is the codegen-erasure invariant manifest
    # at the mangler level. The exception is a fixed-width `Vec[e]<n>`:
    # its inline layout differs per `n`, so it keeps a `_D<n>` suffix
    # that splits its specialisation from the dynamic `Vec` and from
    # every other length.
    TyDimT(base, u) -> if ty_is_fixed_vec(t) {
      concat_all([mangle_ty_in(tab, base), "_D", int_to_string(fixed_vec_n(t))])
    } else { mangle_ty_in(tab, base) }
    # m12.6.x #1: refinements erase like units. `Int where >= 0` and
    # `Int` mangle the same — they share monomorphisations and
    # protocol-impl dispatch entries.
    TyRefineT(base, _) -> mangle_ty_in(tab, base)
    # issue #187 phase 1: mangle a union as `U_<part1>_<part2>_..._E`
    # using the canonical component order. The leading `U_` and
    # trailing `_E` bracket the spec the same way `L_..._E` brackets
    # a list, so distinct unions never collide with each other or
    # with primitive mangles even when their component manglings
    # rearrange. Phase 1 never invokes the mangler on a `TyUnion` in
    # selfhost (no resolver path constructs one) so this arm is dead
    # until Phase 2 wires it up; the implementation is provided now
    # to keep the walker exhaustive without `_` fallbacks that would
    # mask future bugs.
    TyUnion(parts) -> concat_all(["U_",
                                  join_with(map(parts, (p) => mangle_ty_in(tab, p)), "_"),
                                  "_E"])
  }
}

fn mangle_name(tab: SymTab, name: String, tys: [Ty], units: [UnitExprT]) : String {
  let ty_part = match tys {
    [] -> ""
    [_h, ..._rest] -> concat_all(["__mono__", join_with(map(tys, (t) => mangle_ty_in(tab, t)), "__")])
  }
  # m4c Phase 3: encode the unit-tparam tuple after the type-tparam
  # tuple. Empty units means no per-unit specialisation (the common
  # case). For `impl[u: Measure] Show for Real<u>` and friends, two
  # specs binding `u` to USD and EUR mangle distinctly via
  # `__umono__USD` / `__umono__EUR`. The rendering uses the same
  # canonical-unit display as `unit_name(x)` so emit and rewrite
  # agree on the suffix string.
  let u_part = match units {
    [] -> ""
    [_h, ..._rest] -> concat_all(["__umono__", join_with(map(units, mangle_unit), "__")])
  }
  if string_length(ty_part) == 0 and string_length(u_part) == 0 {
    name
  } else {
    concat_all([name, ty_part, u_part])
  }
}

# Render a unit canonically for mangling. `unit_one` (i.e. no unit)
# emits "1" so a `Real<1>` spec sits in its own slot. Bare unit-vars
# only appear in pre-monomorphisation insts and would not key a
# real spec; we still emit a stable "TUVAR" sentinel so any such
# slip-through is observable rather than silently colliding with a
# concrete unit.

# Render a unit canonically for mangling. `unit_one` (i.e. no unit)
# emits "1" so a `Real<1>` spec sits in its own slot. Bare unit-vars
# only appear in pre-monomorphisation insts and would not key a
# real spec; we still emit a stable "TUVAR" sentinel so any such
# slip-through is observable rather than silently colliding with a
# concrete unit.
fn mangle_unit(u: UnitExprT) : String {
  let cu = unit_canon(u)
  match cu {
    UVar(_) -> "TUVAR"
    UOne    -> "1"
    _       -> mangle_unit_ident(unit_key(cu))
  }
}

# Replace mangle-unsafe characters in the canonical unit display with
# C-identifier-safe sentinels. `*` -> `_x_`, `/` -> `_d_`, `^` ->
# `_p_`, `(`/`)` -> `_l_` / `_r_`. Spaces, if any, become `_s_`.

# Replace mangle-unsafe characters in the canonical unit display with
# C-identifier-safe sentinels. `*` -> `_x_`, `/` -> `_d_`, `^` ->
# `_p_`, `(`/`)` -> `_l_` / `_r_`. Spaces, if any, become `_s_`.
fn mangle_unit_ident(s: String) : String =
  mangle_unit_ident_loop(s, 0, string_length(s), [])

fn mangle_unit_ident_loop(s: String, i: Int, n: Int, acc: [String]) : String {
  if i >= n { concat_all(list_reverse(acc)) }
  else {
    let c = match char_at(s, i) {
      Some(ch) -> ch
      None     -> ' '
    }
    let piece = match c {
      '*' -> "_x_"
      '/' -> "_d_"
      '^' -> "_p_"
      '(' -> "_l_"
      ')' -> "_r_"
      ' ' -> "_s_"
      _   -> string_slice(s, i, 1)
    }
    mangle_unit_ident_loop(s, i + 1, n, [piece, ...acc])
  }
}

fn dump_decl_type(d: Decl, tab: SymTab) : Unit / Console {
  match d {
    DFn(is_pub, fid, _, _, _, _, _, line, col, _) -> {
      let pub_s = if is_pub { "pub " } else { "" }
      match sig_of_decl(d) {
        Some(ty) -> print("#{pub_s}fn #{written_text(decl_name(tab, fnid_sym(fid)))} : #{ty_to_string(tab, ty)} @#{int_to_string(line)}:#{int_to_string(col)}")
        None -> ()
      }
    }
    DType(is_pub, tsym, tparams, _, line, col, _, _) -> {
      let pub_s = if is_pub { "pub " } else { "" }
      let tps = match tparams {
        [] -> ""
        _ -> concat_all(["[", join_with(tparams, ", "), "]"])
      }
      print("#{pub_s}type #{written_text(decl_name(tab, tsym))}#{tps} @#{int_to_string(line)}:#{int_to_string(col)}")
    }
    DTest(desc, _, line, col, _) ->
      print("test #{desc} @#{int_to_string(line)}:#{int_to_string(col)}")
    DBench(desc, _, line, col, _) ->
      print("bench #{desc} @#{int_to_string(line)}:#{int_to_string(col)}")
    DCheck(desc, _, _, line, col, _) ->
      print("check #{desc} @#{int_to_string(line)}:#{int_to_string(col)}")
    DImport(ik, line, col) -> {
      match ik {
        IkPath(p) -> print("import #{p} @#{int_to_string(line)}:#{int_to_string(col)}")
        IkAlias(p, a) -> print("import #{p} as #{a} @#{int_to_string(line)}:#{int_to_string(col)}")
        IkSelective(p, _) -> print("import #{p} @#{int_to_string(line)}:#{int_to_string(col)}")
        IkHole(name) -> print("import ?#{name} @#{int_to_string(line)}:#{int_to_string(col)}")
      }
    }
    DEffect(is_pub, esym, _, _, _, line, col, _) -> {
      let pub_s = if is_pub { "pub " } else { "" }
      print("#{pub_s}effect #{written_text(decl_name(tab, esym))} @#{int_to_string(line)}:#{int_to_string(col)}")
    }
    DProtocol(is_pub, psym, _, _, line, col, _) -> {
      let pub_s = if is_pub { "pub " } else { "" }
      print("#{pub_s}protocol #{written_text(decl_name(tab, psym))} @#{int_to_string(line)}:#{int_to_string(col)}")
    }
    DImpl(pref, _, _, _, line, col, _, _) ->
      print("impl #{decl_ref_text(tab, pref)} @#{int_to_string(line)}:#{int_to_string(col)}")
    DDerive(_, inner, _, _) -> dump_decl_type(inner, tab)
    DUnstable(inner, _, _) -> dump_decl_type(inner, tab)
    DProtoLaws(_, inner, _, _, _) -> dump_decl_type(inner, tab)
    DImplAxiom(_, inner, _, _, _) -> dump_decl_type(inner, tab)
    DConstructor(inner, _, _) -> dump_decl_type(inner, tab)
    DUnit(is_pub, name, body, _, line, col, _) -> {
      let pub_s = if is_pub { "pub " } else { "" }
      let body_s = match body {
        UBNone -> ""
        UBAlias(u) -> string_concat(" = ", unit_canon_display(u))
        UBMeasure(m) -> string_concat(" = ", m)
      }
      print("#{pub_s}unit #{name}#{body_s} @#{int_to_string(line)}:#{int_to_string(col)}")
    }
    DUse(name, line, col) ->
      print("use #{name} @#{int_to_string(line)}:#{int_to_string(col)}")
    DUseKind(name, line, col, _) ->
      print("use_kind #{name} @#{int_to_string(line)}:#{int_to_string(col)}")
    DAxiom(is_pub, _, name, _, _, _, _, _, line, col) -> {
      let pub_s = if is_pub { "pub " } else { "" }
      match sig_of_decl(d) {
        Some(ty) -> print("#{pub_s}axiom #{name} : #{ty_to_string(tab, ty)} @#{int_to_string(line)}:#{int_to_string(col)}")
        None -> print("#{pub_s}axiom #{name} @#{int_to_string(line)}:#{int_to_string(col)}")
      }
    }
    DConst(is_pub, csym, ty, _, _, line, col) -> {
      let pub_s = if is_pub { "pub " } else { "" }
      print("#{pub_s}const #{written_text(decl_name(tab, csym))} : #{ty_to_string(tab, resolve_ty(ty))} @#{int_to_string(line)}:#{int_to_string(col)}")
    }
    # See through the item wrapper; the module-doc carrier declares no
    # signature.
    DDoc(_, _, inner, _, _) -> dump_decl_type(inner, tab)
    DAttr(_, inner, _, _) -> dump_decl_type(inner, tab)
    DModuleDoc(_, _, _, _) -> ()
    DExternType(name, _, line, col, _) ->
      print("extern type #{name} @#{int_to_string(line)}:#{int_to_string(col)}")
    DTheory(name, _, line, col, _) ->
      print("theory #{name} @#{int_to_string(line)}:#{int_to_string(col)}")
    DKind(is_pub, name, thy, _, _, line, col, _) -> {
      let pub_s = if is_pub { "pub " } else { "" }
      print("#{pub_s}kind #{name} : #{thy} @#{int_to_string(line)}:#{int_to_string(col)}")
    }
  }
}

#[doc("Emit-layer entry point dump_types")]
pub fn dump_types(decls: [Decl], tab: SymTab) : Unit / Console = dump_types_loop(decls, tab)

fn dump_types_loop(ds: [Decl], tab: SymTab) : Unit / Console {
  match ds {
    [] -> ()
    [d, ...rest] -> { dump_decl_type(d, tab) dump_types_loop(rest, tab) }
  }
}

# ====================================================================
# ---- `--dump-mono`: call-site instantiations ----
#
# Every EVar reference that instantiates a polymorphic scheme
# registers a CallSite; inference then resolves each CallSite's
# fresh TyVarT ids through the final substitution to get concrete
# type arguments. This flag prints one line per call-site showing
# the name, location, and the resolved type tuple.
#
# Monomorphisation (M4c) will de-duplicate these tuples per callee
# and emit one specialised function body per unique instantiation.

fn dump_mono_line(tab: SymTab, cs: ResolvedCS) : Unit / Console {
  match cs {
    RCS(s, line, col, tys, _, _) -> {
      let tys_str = join_with(ty_string_list(tab, tys), ", ")
      print("#{written_text(decl_name(tab, s))}@#{int_to_string(line)}:#{int_to_string(col)}  [#{tys_str}]")
    }
  }
}

# Drop every instance whose enclosing decl was authored outside the
# root file (i.e. came in through core or an imported module). Used
# by --dump-mono / --dump-mono-out so the diagnostic surface only
# reflects what the user's program contributes, mirroring the legacy
# behaviour before core became implicit.

# Drop every instance whose enclosing decl was authored outside the
# root file (i.e. came in through core or an imported module). Used
# by --dump-mono / --dump-mono-out so the diagnostic surface only
# reflects what the user's program contributes, mirroring the legacy
# behaviour before core became implicit.
fn root_only_insts(insts: [ResolvedCS]) : [ResolvedCS] = match insts {
  [] -> []
  [cs, ...rest] -> match cs {
    RCS(_, _, _, _, _, mo) -> match mo {
      None    -> [cs, ...root_only_insts(rest)]
      Some(_) -> root_only_insts(rest)
    }
  }
}

#[doc("Emit-layer entry point dump_mono")]
pub fn dump_mono(file: String, decls: [Decl], tin: TyperIn) : Int / Console + File + Mutable {


  let tab = tin.tab
  let r = infer_program(file, decls, tin, false)
  root_only_insts(r.insts) |> each((cs: ResolvedCS) => dump_mono_line(tab, cs))
  r.errs
}

# ---- `--dump-mono-out`: planned mangled names per call site ----
#
# Same input as `--dump-mono` (the resolved-call-site list); output
# adds the mangled name `mangle_name` would produce for each tuple.
# Diagnostic for m4c #2; m4c #3 will use these names to mint the
# specialised decls. Lines look like:
#   foo@line:col  [Int, Bool]  ->  foo__mono__Int__Bool

fn dump_mono_out_line(tab: SymTab, cs: ResolvedCS) : Unit / Console {
  match cs {
    RCS(s, line, col, tys, units, _) -> {
      let nm = written_text(decl_name(tab, s))
      let tys_str = join_with(ty_string_list(tab, tys), ", ")
      let mname = mangle_name(tab, nm, tys, units)
      print("#{nm}@#{int_to_string(line)}:#{int_to_string(col)}  [#{tys_str}]  ->  #{mname}")
    }
  }
}

#[doc("Emit-layer entry point dump_mono_out")]
pub fn dump_mono_out(file: String, decls: [Decl], tin: TyperIn) : Int / Console + File + Mutable {


  let tab = tin.tab
  let r = infer_program(file, decls, tin, false)
  root_only_insts(r.insts) |> each((cs: ResolvedCS) => dump_mono_out_line(tab, cs))
  r.errs
}


# ---- m37 / TCO — self-tail-call detection (M1) ---------------------
#
# Issue #37: the Perceus exit-drop wrap places `kai_internal_drop(...)`
# calls *after* the body's tail expression, so neither gcc nor clang
# can fold a self-recursive call into `jmp` at the C level. The
# compiler-side fix rewrites self-tail-calls into a `goto`-loop with
# parameter rebinding; this walker is the recognition half.
#
# `tcrec_has_tail_self_call(body, nm, arity)` returns true if `body`
# contains at least one self-recursive call to a fn named `nm` with
# `arity` arguments in *tail position*. Tail position propagates
# through:
#   - EBlock(_, Some(tail))      — `tail` is tail
#   - EIf(_, then, opt_else)     — both branches are tail
#   - EMatch(_, arms)            — each arm body is tail
# It does NOT propagate through:
#   - ECall args / EBinop / EUnop / ERange / records / lists
#   - EBlock stmts (only the trailing expression is tail)
#   - EMatch scrutinee / EIf condition / match guards
#   - ELambda body (different fn — never tail of the enclosing fn)
#   - EPipe / EHandle (conservative; could be relaxed later)
#
# M1 lands the walker only; no caller wires it into the pipeline,
# so selfhost stays byte-identical until M3 flips emission.

# ---- m37 / TCO — self-tail-call detection (M1) ---------------------
#
# Issue #37: the Perceus exit-drop wrap places `kai_internal_drop(...)`
# calls *after* the body's tail expression, so neither gcc nor clang
# can fold a self-recursive call into `jmp` at the C level. The
# compiler-side fix rewrites self-tail-calls into a `goto`-loop with
# parameter rebinding; this walker is the recognition half.
#
# `tcrec_has_tail_self_call(body, nm, arity)` returns true if `body`
# contains at least one self-recursive call to a fn named `nm` with
# `arity` arguments in *tail position*. Tail position propagates
# through:
#   - EBlock(_, Some(tail))      — `tail` is tail
#   - EIf(_, then, opt_else)     — both branches are tail
#   - EMatch(_, arms)            — each arm body is tail
# It does NOT propagate through:
#   - ECall args / EBinop / EUnop / ERange / records / lists
#   - EBlock stmts (only the trailing expression is tail)
#   - EMatch scrutinee / EIf condition / match guards
#   - ELambda body (different fn — never tail of the enclosing fn)
#   - EPipe / EHandle (conservative; could be relaxed later)
#
# M1 lands the walker only; no caller wires it into the pipeline,
# so selfhost stays byte-identical until M3 flips emission.
fn tcrec_has_tail_self_call(body: Expr, me: SelfRef, arity: Int, cons_ok: Bool, tab: SymTab) : Bool =
  tcrec_walk_tail(body.kind, me, arity, cons_ok, tab)

# ---- TRMC for the BUILTIN cons (`[h, ...self(t)]`) ------------------
#
# The dominant list-build idiom is the cons literal, not a user ctor:
#   - `if .. { [] } else { [h, ...recur(t)] }`   (raw EList; no match)
#   - `match xs { .. [h, ...t] -> [g(h), ...recur(t)] }`  (cons arm)
# Both desugar to a tail-position cons whose CDR is a single self-call.
# `tcrec_ctor_modcons_slot` only recognises a USER ctor (`name_first_is_
# upper`), so neither fired and these loops grew the C stack per element
# (Tier-1 TCO violation). These helpers recognise the two shapes and
# return the cons args `[head, self_call]`; the hole is always the tail
# (slot 1), so the recursion plugs into the open cdr. The step carries a
# cons spine so the lowering builds a `kai_cons` cell (not a
# `kai_variant_u`) — see `emit_trmc_step`.
#
# Reuse-in-place (the variant path's `_arm_ru` donation) is NOT applied
# here: `try_arm_top_reuse` only captures a token for PVariant arms, so a
# cons step always FRESH-allocs the new cell. Correctness of the consumed
# input is the step's job (NOT the match exit, which the goto skips):
#   - raw EList (`build`, no scrutinee): nothing to free, the cons cells
#     it builds are owned by the result; spine `TsCons`.
#   - reuse-cons arm (`map_inc`): the consumed scrutinee cons `_scr` would
#     leak because the goto jumps over the arm's exit `kai_decref(_scr)`,
#     so the step decref's `_scr` itself before looping; spine
#     `TsConsScr`.
# Donating the cons cell to the step (reuse-in-place, zero alloc per level)
# is a follow-up perf lane, not a correctness gap.

# Shape 1 — a raw cons literal `[head, ...self_call]` in tail position.
# Returns the cons args `[head, self_call]` when the spread cdr is a clean
# single self-call and the head carries no self-call; else None.
fn trmc_list_cons_modcons(els: [ListElem], me: SelfRef, arity: Int) : Option[[Expr]] =
  match els {
    [ElPlain(head), ElSpread(tail)] -> {
      let clean = tcrec_is_direct_self_call(tail, me, arity) and not tcrec_expr_has_self_call(head, me, arity)
      if clean { Some([head, tail]) } else { None }
    }
    _ -> None
  }

# Shape 2 — the perceus reuse-cons rewrite of a cons arm, its args
# `(scr, head, self_call)`. The first arg is the scrutinee handle that
# lowers to the match emitter's `_scr`; the step decref's it so the
# consumed input spine is freed level by level. Returns the cons args
# `[head, self_call]` under the clean-single-site discipline.
fn trmc_reuse_cons_modcons(xs: [Expr], me: SelfRef, arity: Int) : Option[[Expr]] =
  match xs {
    [_scr, head, tail] -> {
      let clean = tcrec_is_direct_self_call(tail, me, arity) and not tcrec_expr_has_self_call(head, me, arity)
      if clean { Some([head, tail]) } else { None }
    }
    _ -> None
  }

# True when a reuse-cons call over `xs` is a modulo-cons tail and the
# builtin cons shapes are enabled.
fn trmc_reuse_cons_tail(xs: [Expr], me: SelfRef, arity: Int, cons_ok: Bool) : Bool =
  cons_ok and
  (match trmc_reuse_cons_modcons(xs, me, arity) { Some(_) -> true None -> false })


fn tcrec_walk_tail(k: ExprKind, me: SelfRef, arity: Int, cons_ok: Bool, tab: SymTab) : Bool {
  match k {
    ECall(f, xs) -> match f.kind {
      # Builtin cons via perceus's reuse-cons rewrite.
      EMark(MkReuseCons) -> trmc_reuse_cons_tail(xs, me, arity, cons_ok)
      _ ->
        if tcrec_callee_is_self(f, me) and list_length(xs) == arity {
          true
        } else if tcrec_names_ctor(tab, f) {
          # TRMC: a constructor application in tail position with a
          # self-call in exactly one slot is modulo-cons-eligible.
          match tcrec_ctor_modcons_slot(xs, me, arity) { Some(_) -> true None -> false }
        } else { false }
    }
    EList(els) ->
      if cons_ok { match trmc_list_cons_modcons(els, me, arity) { Some(_) -> true None -> false } }
      else { false }
    EIf(_, t, opt_e) -> {
      if tcrec_walk_tail(t.kind, me, arity, cons_ok, tab) { true }
      else { match opt_e {
        None -> false
        Some(e2) -> tcrec_walk_tail(e2.kind, me, arity, cons_ok, tab)
      } }
    }
    EMatch(_, arms) -> tcrec_walk_arms(arms, me, arity, cons_ok, tab)
    EBlock(stmts, opt_tail) -> {
      match opt_tail {
        None -> false
        # Perceus wraps an arm/block tail as `EBlock([..SLet(__pcs_arm_ret,
        # INNER)..], Some(ELocal(__pcs_arm_ret)))`. The tail read carries no
        # self-call shape, so the naive descent reports `false` and the TRMC
        # rewrite is skipped — exactly the mixed-signature regression where
        # the unbox/perceus passes introduce this wrap and the gate then
        # loses the modulo-cons site `trmc_walk_modcons` (which DOES unwrap)
        # still sees. Peel the wrap here too so the gate and the modcons
        # recogniser agree, keeping TRMC (and its fused reuse-in-place)
        # alive through mixed-signature unboxing.
        Some(e) -> match e.kind {
          ELocal(tl) ->
            if ret_slot_id_is_scope(tl) {
              match trmc_find_ret_let_rhs(stmts, tl) {
                Some(inner) -> tcrec_walk_tail(inner.kind, me, arity, cons_ok, tab)
                None        -> false
              }
            } else { false }
          _ -> tcrec_walk_tail(e.kind, me, arity, cons_ok, tab)
        }
      }
    }
    _ -> false
  }
}

fn tcrec_walk_arms(arms: [Arm], me: SelfRef, arity: Int, cons_ok: Bool, tab: SymTab) : Bool {
  match arms {
    [] -> false
    [a, ...rest] -> match a {
      Arm(_, _, body) -> {
        if tcrec_walk_tail(body.kind, me, arity, cons_ok, tab) { true }
        else { tcrec_walk_arms(rest, me, arity, cons_ok, tab) }
      }
    }
  }
}

# ---- m37 / TCO: self-tail-call rewrite ------------------------------
#
# Runs after `perceus_pass`. Each self-tail-call's callee is replaced with
# a `MkTcrecStep` mark carrying what `emit_call_expr` needs: `sym` mints
# the goto label `_kai_<sym>_entry`; bit `i` of `dropmask` drops param `i`
# before the rebind, standing in for the exit drop the goto jumps past
# (`tcrec_compute_site_dropmask`); `params` are the params in declaration
# order.
#[doc("Rewrite every self-tail-call into the goto sentinel the C and native emitters lower to a loop.")]
pub fn tcrec_rewrite_decls(decls: [Decl], allow_trmc: Bool, cons_ok: Bool, root: String, tab: SymTab, specs: SpecNames) : [Decl] / Console + Mutable = {
  # The goto rebinds a parameter slot in place, so a read that hands the
  # value to a BORROWED callee slot leaves the old value unreleased: the
  # callee never took ownership. The borrow map is what separates that
  # from an owned pass, which releases through the callee.
  let bmap = pcs_planned_borrow_map(decls)
  map(decls, (d) => tcrec_rewrite_decl(d, allow_trmc, cons_ok, bmap, tab, specs))
}

# The body may arrive wrapped by perceus as `EBlock([entry..., SLet(__pcs_ret,
# INNER), exit...], Some(ELocal(__pcs_ret)))`; `tcrec_rewrite_pcs_ret_wrap`
# rewrites INNER and rebuilds the wrap. The wrap-less and entry-only shapes
# need no unwrap: the walker descends through `EBlock(_, Some(tail))`.
fn tcrec_rewrite_decl(d: Decl, allow_trmc: Bool, cons_ok: Bool, bmap: BorrowMap, tab: SymTab, specs: SpecNames) : Decl / Console + Mutable {

  match d {
    DFn(is_pub, fid, tparams, params, opt_ret, row, body, ln, cl, mo) -> {
      let arity = list_length(params)
      if tcrec_is_pcs_ret_wrap(body) {
        match body.kind {
          EBlock(stmts, _) ->
            tcrec_rewrite_pcs_ret_wrap(d, is_pub, fid, tparams, params,
                                        opt_ret, row, body, stmts, ln, cl, mo,
                                        arity, allow_trmc, cons_ok, bmap, tab, specs)
          _ -> d
        }
      } else {
        if not tcrec_has_tail_self_call(body, SelfRef(fid), arity, cons_ok, tab) { d }
        else { site_renumber_decl({
          let pbs = map(params, (p) => p.binder)
          let pnames = map(params, (p) => written_text(p.binder.name))
          let uses = pcs_use_index(body, pbs)
          {
            let c_sym_str = c_sym(written_text(fn_emit_name(tab, specs, fid)), mo)
            # Skip-set aligned with pcs_pass's wrap-skip decisions: the
            # derived set under-approximates on a rewritten body (the
            # reuse recogniser replaces the cons the classifier judged
            # linear), so widen it with every param whose reads the
            # rewriter actually left bare. A TCO drop planted without
            # the matching dup double-frees the original ref.
            # A param Perceus borrowed is never dropped by the callee, so the
            # TCO step must not drop it either: a borrow-through self-tail-call
            # re-passes the same borrowed value. Read the set Perceus planned,
            # never a re-derivation of it, so the two cannot disagree.
            let borrowed_ps = pcs_explicit_borrow_names(params)
            let skip_set = pcs_list_union(borrowed_ps,
                             tcrec_widen_skip_raw_reads(pbs, body,
                               pcs_branch_aware_skip_params(pbs, body, bmap), bmap))
            # The base mask feeds the per-site table so the borrowed-arg
            # rule never re-adds a bit rules 1+2 already set.
            let base_mask = tcrec_compute_site_dropmask(params, uses, skip_set, 0, 0)
            let dm_table = tcrec_collect_dm_table(body, SelfRef(fid), arity, params,
                                                   pnames, uses, [], [],
                                                   bmap, base_mask)
            # TRMC: when the fn is modulo-cons-eligible (a constructor
            # in tail position with a self-call slot) AND its effect row
            # is affine (REmpty — no suspendable effect between the cctx
            # extend and apply, per the soundness gate), rewrite via the
            # constructor-context path instead of the plain goto. The
            # ordinary tcrec rewrite handles fns whose tail is a direct
            # self-call; TRMC handles fns whose tail is `Ctor(.., self,..)`.
            # `allow_trmc` is false on the LLVM backend: it lowers the
            # `__kai_tcrec|` sentinel (issue #706) but not the `__kai_trmc|`
            # cctx sentinel, so a TRMC-rewritten body would emit the raw
            # sentinel as a function name with illegal `|` chars. On LLVM
            # the fn falls back to ordinary recursion (correct, just
            # without the modulo-cons reuse-in-place the C backend gets).
            let new_body =
              if allow_trmc and trmc_row_is_affine(row) and trmc_body_has_modcons(body, SelfRef(fid), arity, cons_ok, tab) {
                trmc_rewrite_body(body, SelfRef(fid), arity, c_sym_str,
                                  params, pnames, uses, dm_table, skip_set, cons_ok, tab, ln_of_decl(d))
              } else {
                tcrec_rewrite_body(body, SelfRef(fid), arity, c_sym_str,
                                   params, pnames, uses, dm_table, skip_set)
              }
            DFn(is_pub, fid, tparams, params, opt_ret, row, new_body, ln, cl, mo)
          }
        }) }
      }
    }
    _ -> d
  }
}

# TRMC soundness gate: only an affine (suspend-free) effect row is
# eligible. v1 accepts REmpty (no `/` row) only — the strictest case.
# A handler that can multi-resume or a fiber that can suspend between
# the cctx extend and apply would observe the partially-built spine
# with an open NULL hole (Tier-1 corruption); those rows are rejected
# and fall back to ordinary recursion.
fn trmc_row_is_affine(row: RowExpr) : Bool = match row {
  REmpty -> true
  _      -> false
}

# Does the body have at least one modulo-cons tail leaf? (a ctor in
# tail position with a self-call slot). Distinguishes a TRMC fn from a
# direct-tail-self-call fn so the right rewrite fires. `cons_ok` enables
# the builtin-cons shapes (`[h, ...self(t)]` / reuse-cons); it is false on
# the LLVM/KIR/native backends, whose step lowering builds a variant node
# and has no cons cell path yet (those fns fall back to ordinary recursion
# there — correct, just stack-growing; native cons-TRMC is a follow-up).
fn trmc_body_has_modcons(body: Expr, me: SelfRef, arity: Int, cons_ok: Bool, tab: SymTab) : Bool =
  trmc_walk_modcons((trmc_unwrap_ret(body)).kind, me, arity, cons_ok, tab)

fn trmc_walk_modcons(k: ExprKind, me: SelfRef, arity: Int, cons_ok: Bool, tab: SymTab) : Bool {
  match k {
    ECall(f, xs) -> match f.kind {
      EMark(MkReuseCons) -> trmc_reuse_cons_tail(xs, me, arity, cons_ok)
      _ ->
        if tcrec_names_ctor(tab, f) {
          match tcrec_ctor_modcons_slot(xs, me, arity) { Some(_) -> true None -> false }
        } else { false }
    }
    EList(els) ->
      if cons_ok { match trmc_list_cons_modcons(els, me, arity) { Some(_) -> true None -> false } }
      else { false }
    EIf(_, t, opt_e) ->
      if trmc_walk_modcons((trmc_unwrap_ret(t)).kind, me, arity, cons_ok, tab) { true }
      else { match opt_e { None -> false Some(e2) -> trmc_walk_modcons((trmc_unwrap_ret(e2)).kind, me, arity, cons_ok, tab) } }
    EMatch(_, arms) -> trmc_walk_modcons_arms(arms, me, arity, cons_ok, tab)
    EBlock(_, opt_tail) ->
      match opt_tail { None -> false Some(e) -> trmc_walk_modcons((trmc_unwrap_ret(e)).kind, me, arity, cons_ok, tab) }
    _ -> false
  }
}

fn trmc_walk_modcons_arms(arms: [Arm], me: SelfRef, arity: Int, cons_ok: Bool, tab: SymTab) : Bool {
  match arms {
    [] -> false
    [Arm(_, _, body), ...rest] -> {
      if trmc_walk_modcons((trmc_unwrap_ret(body)).kind, me, arity, cons_ok, tab) { true }
      else { trmc_walk_modcons_arms(rest, me, arity, cons_ok, tab) }
    }
  }
}

# Recognise the perceus exit-drop wrap shape: a block whose tail reads
# the fn's result slot. Cheap structural test — only allocates if the
# shape matches, in which case the caller proceeds to extract the SLet
# and rebuild.
fn tcrec_is_pcs_ret_wrap(body: Expr) : Bool {
  match body.kind {
    EBlock(_, opt_tail) -> match opt_tail {
      Some(t) -> match t.kind {
        ELocal(l) -> ret_slot_id_is_fn(l)
        _ -> false
      }
      None -> false
    }
    _ -> false
  }
}

fn tcrec_rewrite_pcs_ret_wrap(d: Decl, is_pub: Bool, fid: FnId,
                              tparams: [String], params: [Param],
                              opt_ret: Option[TypeExpr], row: RowExpr,
                              body: Expr, stmts: [Stmt],
                              ln: Int, cl: Int, mo: Option[String],
                              arity: Int, allow_trmc: Bool, cons_ok: Bool,
                              bmap: BorrowMap, tab: SymTab, specs: SpecNames) : Decl / Console + Mutable {

  match tcrec_find_pcs_ret_let(stmts, []) {
    None -> d
    Some(triple) -> match triple {
      TcrecPcsTriple(before, inner, after) -> {
        # TRMC eligibility (modulo-cons through arm-wraps) OR an ordinary
        # direct tail self-call qualifies the inner for rewrite.
        # `allow_trmc` is false on the LLVM backend (it cannot lower the
        # `__kai_trmc|` cctx sentinel — see the direct-branch note); a
        # TRMC-only inner then falls back to ordinary recursion.
        let is_trmc_inner = allow_trmc and trmc_row_is_affine(row) and trmc_body_has_modcons(inner, SelfRef(fid), arity, cons_ok, tab)
        let has_direct = tcrec_has_tail_self_call(inner, SelfRef(fid), arity, cons_ok, tab)
        if not has_direct and not is_trmc_inner { d }
        else { site_renumber_decl({
          let pbs = map(params, (p) => p.binder)
          let pnames = map(params, (p) => written_text(p.binder.name))
          let uses = pcs_use_index(inner, pbs)
          {
            let c_sym_str = c_sym(written_text(fn_emit_name(tab, specs, fid)), mo)
            # Skip-set aligned with pcs_pass's wrap-skip decisions —
            # widened with the params the rewriter left bare (raw
            # transfer), same as the non-wrap branch. Plus the planned
            # borrow set (a borrow-through param is never TCO-dropped).
            let borrowed_ps = pcs_explicit_borrow_names(params)
            let skip_set = pcs_list_union(borrowed_ps,
                             tcrec_widen_skip_raw_reads(pbs, inner,
                               pcs_branch_aware_skip_params(pbs, inner, bmap), bmap))
            let base_mask = tcrec_compute_site_dropmask(params, uses, skip_set, 0, 0)
            let dm_table = tcrec_collect_dm_table(inner, SelfRef(fid), arity, params,
                                                   pnames, uses, [], [],
                                                   bmap, base_mask)
            # TRMC: a modulo-cons step `goto`s past the exit wrap and pays
            # its params through the dropmask; the wrap's exit drops move
            # into the apply leaves, the only exits that return.
            let new_body =
              if is_trmc_inner {
                let ns = ln_of_decl(d)
                txd_plant_exit(ns, trmc_rewrite_body(inner, SelfRef(fid), arity, c_sym_str,
                                                     params, pnames, uses, dm_table, skip_set, cons_ok, tab, ns), after)
              } else {
                let new_inner = tcrec_rewrite_body(inner, SelfRef(fid), arity, c_sym_str,
                                                    params, pnames, uses, dm_table, skip_set)
                tcrec_rebuild_pcs_ret_wrap(body, before, new_inner, after)
              }
            DFn(is_pub, fid, tparams, params, opt_ret, row, new_body, ln, cl, mo)
          }
        }) }
      }
    }
  }
}

# Decomposition of the exit-drop wrap into the entry stmts before the
# SLet of the fn's result slot, the SLet's RHS (the original body), and
# the exit stmts after it. Returns None if no stmt binds that slot.
type TcrecPcsTriple = TcrecPcsTriple([Stmt], Expr, [Stmt])

fn tcrec_find_pcs_ret_let(stmts: [Stmt], before_acc: [Stmt]) : Option[TcrecPcsTriple] {
  match stmts {
    [] -> None
    [s, ...rest] -> match s {
      SLet(pat, _, rhs) -> match pat.pkind {
        PBind(b) ->
          if ret_slot_id_is_fn(b.id) {
            Some(TcrecPcsTriple(list_reverse(before_acc), rhs, rest))
          } else {
            tcrec_find_pcs_ret_let(rest, [s, ...before_acc])
          }
        _ -> tcrec_find_pcs_ret_let(rest, [s, ...before_acc])
      }
      _ -> tcrec_find_pcs_ret_let(rest, [s, ...before_acc])
    }
  }
}

fn tcrec_rebuild_pcs_ret_wrap(orig: Expr, before: [Stmt], new_inner: Expr,
                              after: [Stmt]) : Expr {
  let ret_let = SLet(
    Pattern { pkind: PBind(ret_slot_binder(RsFn)), line: new_inner.line, col: new_inner.col },
    None,
    new_inner
  )
  let stmts = list_append(before, [ret_let, ...after])
  let tail = Expr { kind: ELocal(ret_slot_local(RsFn)), line: new_inner.line, col: new_inner.col,
                    ty: new_inner.ty, mode: new_inner.mode,  site: new_inner.site }
  Expr { kind: EBlock(stmts, Some(tail)),
         line: orig.line, col: orig.col, ty: orig.ty, mode: orig.mode,  site: orig.site }
}

# Per-call-site dropmask: bit `i` is set iff param `i`'s payer is the exit
# drop, which the goto jumps past. A never-read param is owned and paid by
# the entry drop, which the goto re-runs.
fn tcrec_compute_site_dropmask(params: [Param], uses: UseIx, skip_set: [Binder],
                                i: Int, acc: Int) : Int {
  match params {
    [] -> acc
    [p, ...rest] -> {
      let sets = PcsParamSets { moved: skip_set, forced: [] }
      let acc1 = if pcs_pays(pcs_param_payer(p.binder.id, uses, sets), PyExit) { acc + tcrec_pow2(i) } else { acc }
      tcrec_compute_site_dropmask(rest, uses, skip_set, i + 1, acc1)
    }
  }
}

fn tcrec_pow2(n: Int) : Int =
  if n <= 0 { 1 } else { 2 * tcrec_pow2(n - 1) }

# ---- TCO — per-site drop side table ---------------------------------
#
# A self-tail-call site owes the goto an extra drop of `p` when every read
# of `p` in its args sits in a borrowed callee slot: the callee never
# releases it and the goto rebinds the slot over it. The mask is computed
# once per site in a pre-pass and looked up by `(line, col)` during the
# rewrite, so no `[Expr]` flows through the dropmask computation.
type TcrDm = TcrDm(Int, Int, Int)   # call-site line, col, drop mask

# Pre-pass entry: walks `body` in tail position the same way
# `tcrec_rewrite_kind` does, recording one TcrDm per self-tail-call site.
fn tcrec_collect_dm_table(body: Expr, me: SelfRef, arity: Int,
                          params: [Param], pnames: [String],
                          uses: UseIx,
                          hoisted: [Expr], acc: [TcrDm],
                          bmap: BorrowMap, base_mask: Int) : [TcrDm] =
  tcrec_collect_dm_kind(body.kind, me, arity, params, pnames, uses, hoisted, acc, bmap, base_mask)

# `hoisted` carries the RHS of the `__pcs_ta*` arg-hoist lets the perceus
# tail-drop pass placed above a self-call. The mask must see those exprs as
# args — they ARE the call's arguments, evaluated one statement earlier — or
# it flips at hoisted sites.
fn tcrec_collect_dm_kind(k: ExprKind, me: SelfRef, arity: Int,
                         params: [Param], pnames: [String], uses: UseIx,
                         hoisted: [Expr],
                         acc: [TcrDm], bmap: BorrowMap, base_mask: Int) : [TcrDm] {
  match k {
    ECall(f, xs) ->
      if tcrec_callee_is_self(f, me) and list_length(xs) == arity {
        let mask = tcrec_site_drop_mask(params, list_append(xs, hoisted), bmap, base_mask, 0, 0)
        [TcrDm(f.line, f.col, mask), ...acc]
      } else { acc }
    EIf(_, t, opt_e) -> {
      let a1 = tcrec_collect_dm_table(t, me, arity, params, pnames, uses, hoisted, acc, bmap, base_mask)
      match opt_e {
        None -> a1
        Some(e2) -> tcrec_collect_dm_table(e2, me, arity, params, pnames, uses, hoisted, a1, bmap, base_mask)
      }
    }
    EMatch(_, arms) -> tcrec_collect_dm_arms(arms, me, arity, params, pnames, uses, hoisted, acc, bmap, base_mask)
    EBlock(stmts, opt_tail) -> {
      let hoisted1 = tcrec_hoisted_arg_rhs(stmts, 0, hoisted)
      match opt_tail {
        None -> acc
        Some(e) -> tcrec_collect_dm_table(e, me, arity, params, pnames, uses, hoisted1, acc, bmap, base_mask)
      }
    }
    _ -> acc
  }
}

# `next` is the hoisted argument the block binds next.
fn tcrec_hoisted_arg_rhs(stmts: [Stmt], next: Int, acc: [Expr]) : [Expr] {
  match stmts {
    [] -> acc
    [s, ...rest] -> match s {
      SLet(pat, _, rhs) ->
        if ret_slot_binds_tail_arg(pat, next) { tcrec_hoisted_arg_rhs(rest, next + 1, [rhs, ...acc]) }
        else { tcrec_hoisted_arg_rhs(rest, next, acc) }
      _ -> tcrec_hoisted_arg_rhs(rest, next, acc)
    }
  }
}

fn tcrec_collect_dm_arms(arms: [Arm], me: SelfRef, arity: Int, params: [Param],
                         pnames: [String], uses: UseIx,
                         hoisted: [Expr], acc: [TcrDm],
                         bmap: BorrowMap, base_mask: Int) : [TcrDm] {
  match arms {
    [] -> acc
    [a, ...rest] -> match a {
      Arm(_, _, body) -> {
        let a1 = tcrec_collect_dm_table(body, me, arity, params, pnames, uses, hoisted, acc, bmap, base_mask)
        tcrec_collect_dm_arms(rest, me, arity, params, pnames, uses, hoisted, a1, bmap, base_mask)
      }
    }
  }
}

# `base_mask` carries the bits the base pass already set, so a site never
# re-adds one (the masks are summed, not or'd).
fn tcrec_site_drop_mask(params: [Param], args: [Expr], bmap: BorrowMap, base_mask: Int,
                        i: Int, acc: Int) : Int = match params {
  [] -> acc
  [p, ...rest] -> {
    let fire = not tcrec_bit_is_set(base_mask, i) and tcrec_args_borrow_only(args, p.binder.id, bmap)
    let acc1 = if fire { acc + tcrec_pow2(i) } else { acc }
    tcrec_site_drop_mask(rest, args, bmap, base_mask, i + 1, acc1)
  }
}

fn tcrec_bit_is_set(mask: Int, i: Int) : Bool = (mask / tcrec_pow2(i)) % 2 == 1

# True when `p` occurs in `args` and EVERY occurrence is a bare read in a
# borrowed parameter slot of the call it sits in. One occurrence anywhere
# else — an owned slot, a field read, a constructor slot — means some
# consumer on this path already releases `p`, and the goto must not drop.
fn tcrec_args_borrow_only(args: [Expr], p: LocalId, bmap: BorrowMap) : Bool = {
  let seen = tcrec_borrow_reads(args, p, bmap)
  let total = tcrec_all_reads(args, p)
  seen > 0 and seen == total
}

# Reads of `p` sitting bare in a borrowed slot.
fn tcrec_borrow_reads(args: [Expr], p: LocalId, bmap: BorrowMap) : Int = match args {
  []           -> 0
  [a, ...rest] -> tcrec_borrow_reads_e(a, p, bmap) + tcrec_borrow_reads(rest, p, bmap)
}

fn tcrec_borrow_reads_e(e: Expr, p: LocalId, bmap: BorrowMap) : Int = match e.kind {
  ECall(f, xs) -> {
    let positions = pcs_borrow_lookup(bmap, pcs_callee_key(f))
    tcrec_borrow_reads_e(f, p, bmap) + tcrec_borrow_reads_args(xs, p, positions, 0, bmap)
  }
  _ -> tcrec_borrow_reads_ps(xp_positions(e), p, bmap)
}

fn tcrec_borrow_reads_args(xs: [Expr], p: LocalId, positions: [Int], i: Int,
                           bmap: BorrowMap) : Int = match xs {
  []           -> 0
  [a, ...rest] -> {
    let here = if pcs_has_int(positions, i) {
      match a.kind { ELocal(u) -> if local_eq(u, p) { 1 } else { 0 }  _ -> tcrec_borrow_reads_e(a, p, bmap) }
    } else { tcrec_borrow_reads_e(a, p, bmap) }
    here + tcrec_borrow_reads_args(rest, p, positions, i + 1, bmap)
  }
}

fn tcrec_borrow_reads_ps(ps: [XPos], p: LocalId, bmap: BorrowMap) : Int = match ps {
  []                  -> 0
  [XP(_, c), ...rest] -> tcrec_borrow_reads_e(c, p, bmap) + tcrec_borrow_reads_ps(rest, p, bmap)
}

# Every read of `p` in `args`, borrowed slot or not.
fn tcrec_all_reads(args: [Expr], p: LocalId) : Int = match args {
  []           -> 0
  [a, ...rest] -> tcrec_all_reads_e(a, p) + tcrec_all_reads(rest, p)
}

fn tcrec_all_reads_e(e: Expr, p: LocalId) : Int = match e.kind {
  ELocal(u) -> if local_eq(u, p) { 1 } else { 0 }
  _       -> tcrec_all_reads_ps(xp_positions(e), p)
}

fn tcrec_all_reads_ps(ps: [XPos], p: LocalId) : Int = match ps {
  []                  -> 0
  [XP(_, c), ...rest] -> tcrec_all_reads_e(c, p) + tcrec_all_reads_ps(rest, p)
}

# The perceus rewrite records its ownership decision in the body itself:
# a read wrapped in `__perceus_dup` leaves the original ref alive; a bare
# read transfers it raw. A param with any bare non-lambda read must not
# get the goto-block drop — the drop and the wrap must pair or RC
# double-counts. Widening only (never removes a derived skip entry), so
# a read this walker cannot see (interp strings) keeps today's mask.
fn tcrec_widen_skip_raw_reads(pbs: [Binder], body: Expr, skip: [Binder], bm: BorrowMap) : [Binder] {
  match pbs {
    [] -> skip
    [h, ...rest] -> {
      let skip1 =
        if not pcs_has(skip, h.id) and tcrec_expr_raw_read(body, h.id, bm) { [h, ...skip] }
        else { skip }
      tcrec_widen_skip_raw_reads(rest, body, skip1, bm)
    }
  }
}

# Lambda bodies are excluded: closure captures are RC'd separately, and
# the dropmask's lambda story lives in the LUBlocked arm.
fn tcrec_expr_raw_read(e: Expr, p: LocalId, bm: BorrowMap) : Bool =
  tcrec_kind_raw_read(e.kind, p, bm)

fn tcrec_kind_raw_read(k: ExprKind, p: LocalId, bm: BorrowMap) : Bool {
  match k {
    ELocal(l) -> local_eq(l, p)
    ECall(f, xs) ->
      if tcrec_is_dup_callee(f) { tcrec_dup_arg_raw_read(xs, p, bm) }
      else if tcrec_expr_raw_read(f, p, bm) { true }
      else if pcs_any_arg_is_var(p, xs) { tcrec_args_raw_read(tcrec_owned_args(xs, tcrec_borrowed_slots(bm, f), 0), p, bm) }
      else { tcrec_args_raw_read(xs, p, bm) }
    EIntrinsic(_, xs) -> tcrec_args_raw_read(xs, p, bm)
    ESurface(sf) -> tcrec_args_raw_read(surface_children(sf), p, bm)
    EBinop(_, l, r) ->
      if tcrec_expr_raw_read(l, p, bm) { true } else { tcrec_expr_raw_read(r, p, bm) }
    EUnop(_, x) -> tcrec_expr_raw_read(x, p, bm)
    EField(x, _) -> tcrec_expr_raw_read(x, p, bm)
    EIndex(x, i) ->
      if tcrec_expr_raw_read(x, p, bm) { true } else { tcrec_expr_raw_read(i, p, bm) }
    EIf(c, t, opt_e) ->
      if tcrec_expr_raw_read(c, p, bm) { true }
      else if tcrec_expr_raw_read(t, p, bm) { true }
      else { match opt_e {
        None -> false
        Some(e2) -> tcrec_expr_raw_read(e2, p, bm)
      } }
    EMatch(s, arms) ->
      if tcrec_expr_raw_read(s, p, bm) { true }
      else { tcrec_arms_raw_read(arms, p, bm) }
    EBlock(stmts, opt_tail) ->
      if tcrec_stmts_raw_read(stmts, p, bm) { true }
      else { match opt_tail {
        None -> false
        Some(e) -> tcrec_expr_raw_read(e, p, bm)
      } }
    EList(elems) -> tcrec_elems_raw_read(elems, p, bm)
    ERange(lo, hi, opt_by) ->
      if tcrec_expr_raw_read(lo, p, bm) { true }
      else if tcrec_expr_raw_read(hi, p, bm) { true }
      else { match opt_by {
        None -> false
        Some(e) -> tcrec_expr_raw_read(e, p, bm)
      } }
    ERecordLit(_, fis) -> tcrec_fields_raw_read(fis, p, bm)
    EPipe(l, r) ->
      if tcrec_expr_raw_read(l, p, bm) { true } else { tcrec_expr_raw_read(r, p, bm) }
    EMapPipe(l, r) ->
      if tcrec_expr_raw_read(l, p, bm) { true } else { tcrec_expr_raw_read(r, p, bm) }
    EFlatMapPipe(l, r) ->
      if tcrec_expr_raw_read(l, p, bm) { true } else { tcrec_expr_raw_read(r, p, bm) }
    EFilterPipe(l, r) ->
      if tcrec_expr_raw_read(l, p, bm) { true } else { tcrec_expr_raw_read(r, p, bm) }
    EBang(inner) -> tcrec_expr_raw_read(inner, p, bm)
    ELitUnit(inner, _) -> tcrec_expr_raw_read(inner, p, bm)
    _ -> false
  }
}

fn tcrec_is_dup_callee(f: Expr) : Bool = match f.kind {
  EMark(MkDup) -> true
  _            -> false
}

# Perceus has already renamed a borrowing prim to its `_borrow` variant,
# which lends slot 0.
fn tcrec_borrowed_slots(bm: BorrowMap, f: Expr) : [Int] =
  if tcrec_is_lending_form(f) { [0] } else { pcs_borrow_lookup(bm, pcs_callee_key(f)) }

fn tcrec_is_lending_form(f: Expr) : Bool = match builtin_ref(f) {
  Some(b) -> builtin_is_lending_form(b)
  None    -> false
}

# A bare read in a borrowed slot lends, so it hands nothing on.
fn tcrec_owned_args(xs: [Expr], borrowed: [Int], i: Int) : [Expr] = match xs {
  []           -> []
  [x, ...rest] -> {
    let tl = tcrec_owned_args(rest, borrowed, i + 1)
    match x.kind {
      ELocal(_) -> if pcs_has_int(borrowed, i) { tl } else { [x, ...tl] }
      _         -> [x, ...tl]
    }
  }
}

# `__perceus_dup(x)` shields a bare-var read; a composite arg recurses.
fn tcrec_dup_arg_raw_read(xs: [Expr], p: LocalId, bm: BorrowMap) : Bool {
  match xs {
    [a] -> match a.kind {
      ELocal(_)  -> false
      ESym(_, _) -> false
      _          -> tcrec_expr_raw_read(a, p, bm)
    }
    _ -> tcrec_args_raw_read(xs, p, bm)
  }
}

fn tcrec_args_raw_read(args: [Expr], p: LocalId, bm: BorrowMap) : Bool {
  match args {
    [] -> false
    [h, ...rest] ->
      if tcrec_expr_raw_read(h, p, bm) { true }
      else { tcrec_args_raw_read(rest, p, bm) }
  }
}

fn tcrec_arms_raw_read(arms: [Arm], p: LocalId, bm: BorrowMap) : Bool {
  match arms {
    [] -> false
    [a, ...rest] -> match a {
      Arm(_, opt_g, body) -> {
        let g_hit = match opt_g {
          None -> false
          Some(g) -> tcrec_expr_raw_read(g, p, bm)
        }
        if g_hit { true }
        else if tcrec_expr_raw_read(body, p, bm) { true }
        else { tcrec_arms_raw_read(rest, p, bm) }
      }
    }
  }
}

fn tcrec_stmts_raw_read(stmts: [Stmt], p: LocalId, bm: BorrowMap) : Bool {
  match stmts {
    [] -> false
    [s, ...rest] -> {
      let here = match s {
        SLet(_, _, e) -> tcrec_expr_raw_read(e, p, bm)
        SVar(_, _, e, _, _) -> tcrec_expr_raw_read(e, p, bm)
        SAssert(c, opt_m) ->
          if tcrec_expr_raw_read(c, p, bm) { true }
          else { match opt_m {
            None -> false
            Some(m) -> tcrec_expr_raw_read(m, p, bm)
          } }
        SExprStmt(e) -> tcrec_expr_raw_read(e, p, bm)
        SIndexAssign(b, i, v, _, _) ->
          if tcrec_expr_raw_read(b, p, bm) { true }
          else if tcrec_expr_raw_read(i, p, bm) { true }
          else { tcrec_expr_raw_read(v, p, bm) }
        SAssign(b, v, _, _) ->
          if tcrec_expr_raw_read(b, p, bm) { true }
          else { tcrec_expr_raw_read(v, p, bm) }
        SUse(_, _, _) -> false
      }
      if here { true } else { tcrec_stmts_raw_read(rest, p, bm) }
    }
  }
}

fn tcrec_elems_raw_read(elems: [ListElem], p: LocalId, bm: BorrowMap) : Bool {
  match elems {
    [] -> false
    [e, ...rest] -> {
      let here = match e {
        ElPlain(x) -> tcrec_expr_raw_read(x, p, bm)
        ElSpread(x) -> tcrec_expr_raw_read(x, p, bm)
      }
      if here { true } else { tcrec_elems_raw_read(rest, p, bm) }
    }
  }
}

fn tcrec_fields_raw_read(fis: [FieldInit], p: LocalId, bm: BorrowMap) : Bool {
  match fis {
    [] -> false
    [h, ...rest] -> match h {
      FI(_, e) ->
        if tcrec_expr_raw_read(e, p, bm) { true }
        else { tcrec_fields_raw_read(rest, p, bm) }
    }
  }
}

# The side-table mask for the call site at (line, col); 0 when the site
# is absent (e.g. shadowed by a local binding the rewriter walks into
# separately).
fn tcrec_lookup_dm(table: [TcrDm], line: Int, col: Int) : Int {
  match table {
    [] -> 0
    [h, ...rest] -> match h {
      TcrDm(l, c, m) ->
        if l == line and c == col { m }
        else { tcrec_lookup_dm(rest, line, col) }
    }
  }
}

# ---- TRMC step -----------------------------------------------------
#
# A modulo-cons tail leaf is rewritten to
#   ECall(EMark(MkTrmcStep(..)), ctor_args)
# where `ctor_args` are the ORIGINAL constructor arguments (the one at
# the step's `hole` is the self-call `ECall(<the fn>, self_args)`).
# The emitter (`emit_trmc_step`) builds the node with a NULL hole there,
# extends the cctx to point at it, rebinds the loop params from the
# self-call's args (with `dropmask` reconciling Perceus's exit-drops,
# exactly like tcrec_emit_goto), and `goto`s the entry label.
#
# A non-modulo-cons tail leaf is wrapped in the `MkTrmcApply` mark, which
# the emitter lowers to `kai_cctx_apply_linear(_kai_acc, <leaf>)`.
#
# The ctor tag/mask/payload-types are resolved at emit time from
# `cname` against `cx.variants` (the rewrite pass has no EmitCtx).

# Tail-position rewrite. Mirrors the M1 walker but produces a fresh
# `Expr` tree where each tail-self-call's callee has been swapped
# for a freshly-built step mark whose dropmask is computed
# *per call site* by inspecting that site's args. Args are not
# recursed into — they are non-tail and `emit_expr` evaluates
# them normally on emit.

# Tail-position rewrite. Mirrors the M1 walker but produces a fresh
# `Expr` tree where each tail-self-call's callee has been swapped
# for a freshly-built step mark whose dropmask is computed
# *per call site* by inspecting that site's args. Args are not
# recursed into — they are non-tail and `emit_expr` evaluates
# them normally on emit.
fn tcrec_rewrite_body(body: Expr, me: SelfRef, arity: Int, c_sym_str: String,
                      params: [Param], pnames: [String], uses: UseIx,
                      dm_table: [TcrDm], skip_set: [Binder]) : Expr =
  Expr { kind: tcrec_rewrite_kind(body.kind, body.line, body.col, me, arity,
                                   c_sym_str, params, pnames, uses, dm_table, skip_set),
         line: body.line, col: body.col, ty: body.ty, mode: body.mode,  site: body.site }

fn trmc_expr_nth(xs: [Expr], i: Int) : Option[Expr] =
  if i < 0 { None }
  else { match xs {
    [] -> None
    [a, ...rest] -> if i == 0 { Some(a) } else { trmc_expr_nth(rest, i - 1) }
  } }

# Peel a Perceus arm-ret wrap to its INNER value, exposing the modulo-cons
# ctor; `trmc_rewrite_body` replants the wrap's drops (trmc_exit_drops).
fn trmc_unwrap_ret(e: Expr) : Expr {
  match e.kind {
    EBlock(stmts, opt_tail) -> match opt_tail {
      Some(t) -> match t.kind {
        ELocal(tl) ->
          if ret_slot_id_is_scope(tl) {
            match trmc_find_ret_let_rhs(stmts, tl) {
              Some(inner) -> inner
              None        -> e
            }
          } else { e }
        _ -> e
      }
      None -> e
    }
    _ -> e
  }
}

fn trmc_find_ret_let_rhs(stmts: [Stmt], ret: LocalId) : Option[Expr] {
  match stmts {
    [] -> None
    [s, ...rest] -> match s {
      SLet(pat, _, rhs) -> match pat.pkind {
        PBind(b) -> if local_eq(b.id, ret) { Some(rhs) } else { trmc_find_ret_let_rhs(rest, ret) }
        _ -> trmc_find_ret_let_rhs(rest, ret)
      }
      _ -> trmc_find_ret_let_rhs(rest, ret)
    }
  }
}

# ---- TRMC body rewrite ---------------------------------------------
#
# Rewrites the body of a TRMC-eligible fn (single-recursive, every
# modulo-cons tail leaf, affine effect row). Walks tail position:
#   - a modulo-cons ctor leaf  → step sentinel (build-hole+extend+goto);
#   - any other tail leaf       → apply sentinel (cctx_apply_linear).
# Mirrors the structural recursion of tcrec_rewrite_kind. The dropmask
# threaded into the step is the same per-site dropmask the ordinary
# tcrec uses, computed from the self-call's args; it reconciles
# Perceus's exit-drops that the goto skips.
fn trmc_rewrite_body(body0: Expr, me: SelfRef, arity: Int, c_sym_str: String,
                     params: [Param], pnames: [String], uses: UseIx,
                     dm_table: [TcrDm], skip_set: [Binder], cons_ok: Bool, tab: SymTab, ns: LocalNames) : Expr {
  let body = trmc_unwrap_ret(body0)
  let out = Expr { kind: trmc_rewrite_kind(body.kind, body.line, body.col, me, arity,
                                  c_sym_str, params, pnames, uses, dm_table, skip_set, cons_ok, tab, ns),
         line: body.line, col: body.col, ty: body.ty, mode: body.mode,  site: body.site }
  txd_plant(ns, out, txd_wrap_drops(body0))
}

# Build the step `ECall` for a modulo-cons leaf: compute the
# per-site dropmask (base + side table), make the step callee, and apply
# it to the ctor args (`args` carries the self-call at slot `h`). Shared
# by the user-ctor, builtin-cons-literal, and reuse-cons leaves so the
# dropmask discipline stays single-sourced.
fn trmc_make_step_call(spine: TrmcSpine, args: [Expr], h: Int, line: Int, col: Int,
                       c_sym_str: String, params: [Param], pnames: [String],
                       uses: UseIx, dm_table: [TcrDm], skip_set: [Binder]) : ExprKind {
  let base_mask = tcrec_compute_site_dropmask(params, uses, skip_set, 0, 0)
  let self_e = trmc_expr_nth(args, h)
  let site_mask = match self_e {
    Some(se) -> tcrec_lookup_dm(dm_table, se.line, se.col)
    None     -> 0
  }
  let dropmask = base_mask + site_mask
  let step = MkTrmcStep(TrmcStep { sym: c_sym_str, hole: h, spine: spine, dropmask: dropmask, params: pnames })
  ECall(Expr { kind: EMark(step), line: line, col: col, ty: None, mode: MBoxed , site: 0 }, args)
}

fn trmc_rewrite_kind(k: ExprKind, line: Int, col: Int, me: SelfRef, arity: Int,
                     c_sym_str: String, params: [Param], pnames: [String],
                     uses: UseIx, dm_table: [TcrDm], skip_set: [Binder], cons_ok: Bool, tab: SymTab, ns: LocalNames) : ExprKind {
  match k {
    EIf(c, t, opt_e) -> {
      let t1 = trmc_rewrite_body(t, me, arity, c_sym_str, params, pnames, uses, dm_table, skip_set, cons_ok, tab, ns)
      let opt_e1 = match opt_e {
        None -> None
        Some(e2) -> Some(trmc_rewrite_body(e2, me, arity, c_sym_str, params, pnames, uses, dm_table, skip_set, cons_ok, tab, ns))
      }
      EIf(c, t1, opt_e1)
    }
    EMatch(s, arms) ->
      EMatch(s, trmc_rewrite_arms(arms, me, arity, c_sym_str, params, pnames, uses, dm_table, skip_set, [], cons_ok, tab, ns))
    EBlock(stmts, opt_tail) -> {
      match opt_tail {
        None -> trmc_wrap_apply(Expr { kind: k, line: line, col: col, ty: None, mode: MBoxed , site: 0 })
        Some(e) -> EBlock(stmts, Some(trmc_rewrite_body(e, me, arity, c_sym_str, params, pnames, uses, dm_table, skip_set, cons_ok, tab, ns)))
      }
    }
    # Builtin cons literal `[head, ...self(t)]` in tail position. The
    # cons args are `[head, self_call]`; the hole is the cdr (slot 1).
    EList(els) ->
      if cons_ok { match trmc_list_cons_modcons(els, me, arity) {
        Some(cargs) -> trmc_make_step_call(TsCons, cargs, 1, line, col,
                                           c_sym_str, params, pnames, uses, dm_table, skip_set)
        None        -> trmc_wrap_apply(Expr { kind: k, line: line, col: col, ty: None, mode: MBoxed , site: 0 })
      } } else { trmc_wrap_apply(Expr { kind: k, line: line, col: col, ty: None, mode: MBoxed , site: 0 }) }
    # A bare self-call beside a modulo-cons step is a loop step that leaves
    # the accumulator open, never a call whose result plugs the hole.
    ECall(f, xs) -> if tcrec_callee_is_self(f, me) and list_length(xs) == arity {
      tcrec_make_step_site(f, xs, params, pnames, uses, dm_table, skip_set, c_sym_str)
    } else {
      # Tail-position ctor application: is it modulo-cons (user ctor or,
      # via perceus's reuse-cons rewrite, the builtin cons)?
      let modslot = match tcrec_ctor_callee(tab, f) {
        Some(c2) -> match tcrec_ctor_modcons_slot(xs, me, arity) {
          Some(slot) -> Some((c2, slot))
          None       -> None
        }
        None -> None
      }
      match modslot {
        Some((csym, h)) -> {
          # Dropmask for the rebind of the loop params from the
          # self-call's args. Same per-site computation as ordinary
          # tcrec; the self-call sits at slot `h`.
          let base_mask = tcrec_compute_site_dropmask(params, uses, skip_set, 0, 0)
          let self_e = trmc_expr_nth(xs, h)
          let site_mask = match self_e {
            Some(se) -> tcrec_lookup_dm(dm_table, se.line, se.col)
            None     -> 0
          }
          let dropmask = base_mask + site_mask
          let step = MkTrmcStep(TrmcStep { sym: c_sym_str, hole: h, spine: TsCtor(csym), dropmask: dropmask, params: pnames })
          ECall(Expr { kind: EMark(step), line: line, col: col, ty: f.ty, mode: f.mode , site: 0 }, xs)
        }
        None -> match trmc_reuse_variant_ctor(f, xs, me, arity, tab) {
          # A Perceus reuse rebuild of a modulo-cons ctor is that ctor's step:
          # the arm-top token hands the step the scrutinee's cell as its hole.
          Some(ctor) -> trmc_rewrite_kind(ctor.kind, ctor.line, ctor.col, me, arity,
                                          c_sym_str, params, pnames, uses, dm_table, skip_set, cons_ok, tab, ns)
          None -> {
          # Reuse-cons leaf: the mark over `(scr, head, self)`.
          let reuse = match f.kind {
            EMark(MkReuseCons) -> if cons_ok { trmc_reuse_cons_modcons(xs, me, arity) } else { None }
            _                  -> None
          }
          match reuse {
            Some(cargs) -> trmc_make_step_call(TsConsScr, cargs, 1, line, col,
                                               c_sym_str, params, pnames, uses, dm_table, skip_set)
            None        -> trmc_wrap_apply(Expr { kind: k, line: line, col: col, ty: None, mode: MBoxed , site: 0 })
          }
          }
        }
      }
    }
    _ -> trmc_wrap_apply(Expr { kind: k, line: line, col: col, ty: None, mode: MBoxed , site: 0 })
  }
}

# The ctor a reuse-variant mark over `(scr, Ctor(..))` rebuilds, when one
# of its slots is the self-call.
fn trmc_reuse_variant_ctor(f: Expr, xs: [Expr], me: SelfRef, arity: Int, tab: SymTab) : Option[Expr] = match f.kind {
  EMark(MkReuseVariant) -> match xs {
    [_scr, ctor] -> match ctor.kind {
      ECall(cf, cargs) -> if tcrec_names_ctor(tab, cf) and not trmc_slot_none(tcrec_ctor_modcons_slot(cargs, me, arity)) { Some(ctor) } else { None }
      _                -> None
    }
    _ -> None
  }
  _ -> None
}

# The constructor a callee names: a reference whose id is a constructor's.
fn tcrec_ctor_callee(tab: SymTab, f: Expr) : Option[SymId] = match f.kind {
  ESym(s, _) -> if sym_is_ctor(tab, s) { Some(s) } else { None }
  _          -> None
}

fn tcrec_names_ctor(tab: SymTab, f: Expr) : Bool = match tcrec_ctor_callee(tab, f) {
  Some(_) -> true
  None    -> false
}

fn trmc_slot_none(o: Option[Int]) : Bool = match o { Some(_) -> false  None -> true }

fn trmc_wrap_apply(leaf: Expr) : ExprKind =
  ECall(Expr { kind: EMark(MkTrmcApply), line: leaf.line, col: leaf.col, ty: leaf.ty, mode: leaf.mode,  site: leaf.site },
        [leaf])

fn trmc_rewrite_arms(arms: [Arm], me: SelfRef, arity: Int, c_sym_str: String,
                     params: [Param], pnames: [String], uses: UseIx,
                     dm_table: [TcrDm], skip_set: [Binder], acc: [Arm], cons_ok: Bool, tab: SymTab, ns: LocalNames) : [Arm] {
  match arms {
    [] -> list_reverse(acc)
    [a, ...rest] -> match a {
      Arm(pat, opt_g, body) -> {
        let new_body = trmc_rewrite_body(body, me, arity, c_sym_str, params, pnames, uses, dm_table, skip_set, cons_ok, tab, ns)
        trmc_rewrite_arms(rest, me, arity, c_sym_str, params, pnames, uses, dm_table, skip_set, [Arm(pat, opt_g, new_body), ...acc], cons_ok, tab, ns)
      }
    }
  }
}

fn tcrec_rewrite_kind(k: ExprKind, line: Int, col: Int, me: SelfRef, arity: Int,
                      c_sym_str: String, params: [Param], pnames: [String],
                      uses: UseIx, dm_table: [TcrDm], skip_set: [Binder]) : ExprKind {
  match k {
    ECall(f, xs) ->
      if tcrec_callee_is_self(f, me) and list_length(xs) == arity {
        # The base mask is per-fn; the side-table mask is per-site and
        # never re-adds a base bit, so OR == ADD.
        tcrec_make_step_site(f, xs, params, pnames, uses, dm_table, skip_set, c_sym_str)
      } else { k }
    EIf(c, t, opt_e) -> {
      let t1 = tcrec_rewrite_body(t, me, arity, c_sym_str, params, pnames, uses, dm_table, skip_set)
      let opt_e1 = match opt_e {
        None -> None
        Some(e2) -> Some(tcrec_rewrite_body(e2, me, arity, c_sym_str, params,
                                            pnames, uses, dm_table, skip_set))
      }
      EIf(c, t1, opt_e1)
    }
    EMatch(s, arms) ->
      EMatch(s, tcrec_rewrite_arms(arms, me, arity, c_sym_str, params, pnames,
                                    uses, dm_table, skip_set, []))
    EBlock(stmts, opt_tail) -> {
      match opt_tail {
        None -> k
        Some(e) ->
          EBlock(stmts, Some(tcrec_rewrite_body(e, me, arity, c_sym_str, params,
                                                 pnames, uses, dm_table, skip_set)))
      }
    }
    _ -> k
  }
}

# Plant the goto step for one recognised self-call site.
fn tcrec_make_step_site(f: Expr, xs: [Expr], params: [Param], pnames: [String],
                        uses: UseIx, dm_table: [TcrDm], skip_set: [Binder],
                        c_sym_str: String) : ExprKind {
  let base_mask = tcrec_compute_site_dropmask(params, uses, skip_set, 0, 0)
  let site_mask = tcrec_lookup_dm(dm_table, f.line, f.col)
  let dropmask = base_mask + site_mask
  let step = MkTcrecStep(TcrecStep { sym: c_sym_str, dropmask: dropmask, params: pnames })
  ECall(
    Expr { kind: EMark(step), line: f.line, col: f.col,
           ty: f.ty, mode: f.mode,  site: f.site },
    xs)
}

fn tcrec_rewrite_arms(arms: [Arm], me: SelfRef, arity: Int, c_sym_str: String,
                      params: [Param], pnames: [String], uses: UseIx,
                      dm_table: [TcrDm], skip_set: [Binder], acc: [Arm]) : [Arm] {
  match arms {
    [] -> list_reverse(acc)
    [a, ...rest] -> match a {
      Arm(pat, opt_g, body) -> {
        let new_body = tcrec_rewrite_body(body, me, arity, c_sym_str, params,
                                          pnames, uses, dm_table, skip_set)
        tcrec_rewrite_arms(rest, me, arity, c_sym_str, params, pnames, uses,
                           dm_table, skip_set, [Arm(pat, opt_g, new_body), ...acc])
      }
    }
  }
}

# Recognition predicate used by `emit_fn_body` to decide whether to
# plant the goto label. Recurses into every sub-expression, not just
# tail position, because a sentinel can sit anywhere the rewrite
# placed one (currently always tail; future relaxations may place
# them elsewhere).

# Recognition predicate used by `emit_fn_body` to decide whether to
# plant the goto label. Recurses into every sub-expression, not just
# tail position, because a sentinel can sit anywhere the rewrite
# placed one (currently always tail; future relaxations may place
# them elsewhere).
fn tcrec_body_has_sentinel(body: Expr) : Bool =
  tcrec_scan_kind(body.kind)

# Does the body contain a TRMC step sentinel? Used by emit_fn_body to
# decide whether to declare the `KaiCctx _kai_acc = kai_cctx_empty();`
# accumulator before the goto entry label. Walks every sub-expression
# (a step sentinel sits in tail position of some branch).
# pub: the LLVM backend's arm-top reuse (llvm-c-parity lane) reuses this
# pure TRMC-shape probe so its eligibility gate stays in lock-step with C.
pub fn trmc_body_has_step(body: Expr) : Bool = trmc_scan_step_kind(body.kind)

fn trmc_scan_step_kind(k: ExprKind) : Bool {
  match k {
    ECall(f, xs) -> match f.kind {
      EMark(MkTrmcStep(_)) -> true
      _ -> trmc_scan_step_exprs(xs)
    }
    EIf(c, t, opt_e) ->
      if trmc_body_has_step(c) { true }
      else if trmc_body_has_step(t) { true }
      else { match opt_e { None -> false Some(e2) -> trmc_body_has_step(e2) } }
    EMatch(s, arms) -> if trmc_body_has_step(s) { true } else { trmc_scan_step_arms(arms) }
    EBlock(stmts, opt_tail) ->
      if trmc_scan_step_stmts(stmts) { true }
      else { match opt_tail { None -> false Some(e) -> trmc_body_has_step(e) } }
    EBinop(_, l, r) -> if trmc_body_has_step(l) { true } else { trmc_body_has_step(r) }
    EUnop(_, x) -> trmc_body_has_step(x)
    EField(x, _) -> trmc_body_has_step(x)
    _ -> false
  }
}

fn trmc_scan_step_exprs(xs: [Expr]) : Bool {
  match xs {
    [] -> false
    [a, ...rest] -> if trmc_body_has_step(a) { true } else { trmc_scan_step_exprs(rest) }
  }
}

fn trmc_scan_step_arms(arms: [Arm]) : Bool {
  match arms {
    [] -> false
    [Arm(_, _, body), ...rest] -> if trmc_body_has_step(body) { true } else { trmc_scan_step_arms(rest) }
  }
}

fn trmc_scan_step_stmts(stmts: [Stmt]) : Bool {
  match stmts {
    [] -> false
    [s, ...rest] -> {
      let here = match s {
        SLet(_, _, rhs) -> trmc_body_has_step(rhs)
        SExprStmt(e)    -> trmc_body_has_step(e)
        _ -> false
      }
      if here { true } else { trmc_scan_step_stmts(rest) }
    }
  }
}

fn tcrec_scan_kind(k: ExprKind) : Bool {
  match k {
    ECall(f, xs) -> match f.kind {
      # A TRMC step needs the goto label too.
      EMark(m) -> if mark_is_tail_step(m) { true } else { tcrec_scan_exprs(xs) }
      _ -> if tcrec_body_has_sentinel(f) { true } else { tcrec_scan_exprs(xs) }
    }
    EIf(c, t, opt_e) ->
      if tcrec_body_has_sentinel(c) { true }
      else if tcrec_body_has_sentinel(t) { true }
      else { match opt_e {
        None -> false
        Some(e2) -> tcrec_body_has_sentinel(e2)
      } }
    EMatch(s, arms) ->
      if tcrec_body_has_sentinel(s) { true } else { tcrec_scan_arms(arms) }
    EBlock(stmts, opt_tail) ->
      if tcrec_scan_stmts(stmts) { true }
      else { match opt_tail {
        None -> false
        Some(e) -> tcrec_body_has_sentinel(e)
      } }
    EBinop(_, l, r) ->
      if tcrec_body_has_sentinel(l) { true } else { tcrec_body_has_sentinel(r) }
    EUnop(_, x) -> tcrec_body_has_sentinel(x)
    EField(x, _) -> tcrec_body_has_sentinel(x)
    EIndex(x, i) ->
      if tcrec_body_has_sentinel(x) { true } else { tcrec_body_has_sentinel(i) }
    EPipe(l, r) ->
      if tcrec_body_has_sentinel(l) { true } else { tcrec_body_has_sentinel(r) }
    EMapPipe(l, r) ->
      if tcrec_body_has_sentinel(l) { true } else { tcrec_body_has_sentinel(r) }
    EFlatMapPipe(l, r) ->
      if tcrec_body_has_sentinel(l) { true } else { tcrec_body_has_sentinel(r) }
    EFilterPipe(l, r) ->
      if tcrec_body_has_sentinel(l) { true } else { tcrec_body_has_sentinel(r) }
    _ -> false
  }
}

fn tcrec_scan_exprs(es: [Expr]) : Bool {
  match es {
    [] -> false
    [h, ...rest] ->
      if tcrec_body_has_sentinel(h) { true } else { tcrec_scan_exprs(rest) }
  }
}

fn tcrec_scan_arms(arms: [Arm]) : Bool {
  match arms {
    [] -> false
    [a, ...rest] -> match a {
      Arm(_, _, body) ->
        if tcrec_body_has_sentinel(body) { true } else { tcrec_scan_arms(rest) }
    }
  }
}

fn tcrec_scan_stmts(stmts: [Stmt]) : Bool {
  match stmts {
    [] -> false
    [s, ...rest] -> {
      let here = match s {
        SLet(_, _, e) -> tcrec_body_has_sentinel(e)
        SVar(_, _, e, _, _) -> tcrec_body_has_sentinel(e)
        SAssert(c, opt_m) ->
          if tcrec_body_has_sentinel(c) { true }
          else { match opt_m {
            None -> false
            Some(m) -> tcrec_body_has_sentinel(m)
          } }
        SExprStmt(e) -> tcrec_body_has_sentinel(e)
        SIndexAssign(b, i, v, _, _) ->
          if tcrec_body_has_sentinel(b) { true }
          else if tcrec_body_has_sentinel(i) { true }
          else { tcrec_body_has_sentinel(v) }
        SAssign(b, v, _, _) ->
          if tcrec_body_has_sentinel(b) { true }
          else { tcrec_body_has_sentinel(v) }
        SUse(_, _, _) -> false
      }
      if here { true } else { tcrec_scan_stmts(rest) }
    }
  }
}

# ---- m37 / TCO — goto-block emission ------------------------------
#
# Called from `emit_call_expr` when the callee is a `MkTcrecStep` mark.
# Emits the rebind-and-goto block
# documented in `tcrec_rewrite_decl`. Refcount discipline:
#
# 1. Evaluate every arg into a fresh `_t<i>` local (each with rc=1
#    per the Perceus contract — args may share storage with a
#    parameter only via `kai_internal_dup`, which already bumped rc).
# 2. Drop the params whose bit is set in the dropmask. Those are
#    exactly the params that would have been dropped by the wrap's
#    exit drops, which the goto skips by jumping out of the
#    enclosing statement-expression.
# 3. Rebind `*_kai_tcrp<i> = _t<i>`, in declaration order — through
#    the param pointers captured at fn top, since a same-named
#    pattern/let binder may shadow `kai_<pname>` at the call site.
#    Each rebound param now holds rc=1, the same invariant the wrap
#    relies on at fn entry.
# 4. Goto the entry label planted by `emit_fn_body`.
# 5. Trailing `(KaiValue *)0;` so the statement-expression is a
#    well-typed lvalue; the value is unreachable past the goto.
# ---- TRMC step emission --------------------------------------------
#
# Emit one modulo-cons loop step (mirror rbtree__koka.c:288-304):
#   ({ KaiVarSlot _sl[N] = { ...ctor args, hole=NULL at holeslot... };
#      KaiValue *_node = kai_variant_u(tag, cname, N, mask, _sl);
#      _kai_acc = kai_cctx_extend_linear(_kai_acc, _node,
#                   kai_field_addr_create(&kai_var_slots(_node)[holeslot].ptr));
#      <rebind loop params from the self-call's args>;
#      goto _kai_<sym>_entry; (KaiValue *)0; })
#
# v1 allocates the node FRESH (kai_variant_u). The reuse-token donate
# (write into the consumed scrutinee cell, zero spine allocs) is the
# next increment once leaked==0 is confirmed on the fresh-alloc path.
#
# `args_e` are the original ctor args; args_e[holeslot] is the
# self-call. The non-hole slots emit with
# their Perceus-planted dups; the hole slot emits NULL. The loop params
# rebind from `self_args` using the same dropmask machinery as
# tcrec_emit_goto (reconciling the exit-drops the goto skips).
fn emit_trmc_step(src: String, s: TrmcStep, args_e: [Expr], cx: EmitCtx) : String / Console {
  # A cons spine is a `kai_cons` cell, not a registered variant, so it takes
  # the cons-specific build path (hole at the cdr).
  match trmc_spine_ctor(s.spine) {
    Some(ctor) -> emit_trmc_variant_step(src, s, ctor, args_e, cx)
    None       -> emit_trmc_cons_step(src, s.sym, s.dropmask, s.params, args_e, cx)
  }
}

# Cons modulo-cons loop step (`[head, ...self(t)]`). The cons args are
# `args_e = [head, self_call]`; the hole is the cdr (slot 1). Builds a
# fresh `kai_cons(head, NULL)` cell, extends the cctx so the next step
# attaches at `&node->as.cons.tail`, rebinds the loop params from the
# self-call args, and loops — O(1) stack. Mirrors `emit_trmc_variant_step`
# but for the cons layout; no `_arm_ru` donation (cons arms never capture a
# reuse token — see `try_arm_top_reuse`), so the cell is fresh-allocated.
#
# Like the tcrec goto, the step leaves every enclosing match: after the args
# are read it releases the ledger's pending entries they do not consume, the
# scrutinees' exit decrefs among them.
fn emit_trmc_cons_step(src: String, sym: String, dropmask: Int, pnames: [String],
                       args_e: [Expr], cx: EmitCtx) : String / Console {
  let head_c = match args_e { [h, _] -> emit_expr(src, h, cx) _ -> "kai_unit() /* trmc cons: bad args */" }
  let self_args = match args_e {
    [_, t] -> match t.kind { ECall(_, sa) -> sa _ -> [] }
    _      -> []
  }
  let sig_opt  = fnx_ufn_by_csym(cx.fx, sym)
  let arg_lets = match sig_opt {
    Some(US(pts, _, pmask)) -> tcrec_emit_arg_lets_masked(src, self_args, pts, pmask, 0, cx)
    None                    -> tcrec_emit_arg_lets(src, self_args, 0, cx)
  }
  let drops    = match sig_opt {
    Some(US(_, _, pmask)) -> tcrec_emit_drops_masked(pnames, pmask, dropmask, 0)
    None                  -> tcrec_emit_drops(pnames, dropmask, 0)
  }
  let rebinds  = tcrec_emit_rebinds(pnames, 0)
  let live     = tcl_goto_drops(cx.locals, tcl_without_tok(cx.tcpend), args_e)
  let cons_c = emit_cons_ctor(cx)
  concat_all([
    # A cons spine never hosts the arm-top token; it is freed, not dropped.
    "({ kai_reuse_free(_arm_ru); _arm_ru = kai_reuse_null; ",
    "KaiValue *_trmc_node = ", cons_c, head_c, ", (KaiValue *)0); ",
    "_kai_acc = kai_cctx_extend_linear(_kai_acc, _trmc_node, ",
    "kai_field_addr_create(&_trmc_node->as.cons.tail)); ",
    arg_lets, live, drops, rebinds,
    "goto ", c_user_entry_label(sym), "; (KaiValue *)0; })"
  ])
}

# The fresh-alloc brick for a TRMC spine node. In a region, bump-allocate
# in the current arena (`kai_arena_variant`, `_trmc_sl` already holds the
# NULL-hole slots); the cctx plugs the child pointer into the hole exactly
# as on the RC heap. Outside a region, the inlined `kai_variant_u_fast`.
# In a region the `_arm_ru` reuse branch above is dead anyway: an arena
# scrutinee carries the immortal sentinel rc, so `kai_drop_reuse_token`
# yields null and control always reaches this fresh path.
fn trmc_fresh_alloc(cname: String, tag_str: String, n: Int, mask: Int, cx: EmitCtx) : String =
  if cx.in_region {
    concat_all(["kai_arena_variant(", tag_str, ", \"", cname, "\", ", int_to_string(n),
                ", ", int_to_string(mask), ", _trmc_sl)"])
  } else {
    concat_all(["kai_variant_u_fast(", tag_str, ", ", int_to_string(n), ", _trmc_sl)"])
  }

# The slot kinds of the step's constructor when its layout has `n` slots:
# a list of another length would be walked off its end.
fn trmc_row_kinds(row: Option[VariantEntry], n: Int) : Option[[Int]] = match row {
  Some(v) -> if list_length(evar_kinds(v)) == n { Some(evar_kinds(v)) } else { None }
  None    -> None
}

fn emit_trmc_variant_step(src: String, s: TrmcStep, ctor: SymId, args_e: [Expr],
                  cx: EmitCtx) : String / Console {
  let sym = s.sym
  let holeslot = s.hole
  let cname = written_text(decl_name(cx.tab, ctor))
  let dropmask = s.dropmask
  let pnames = s.params
  let n = list_length(args_e)
  let row = ctor_ix_row(cx.ctor_ix, ctor)
  let tag_str = int_to_string(match row { Some(v) -> ctor_row_tag(v)  None -> 0 })
  let tys_opt = trmc_row_kinds(row, n)
  let mask = match tys_opt { Some(ts) -> variant_slot_mask(ts) None -> 0 }
  # Build the slot initialiser list: every slot from args_e except the
  # hole slot (NULL); typed Int/Real slots emit `.i64`/`.r`.
  let slot_inits = emit_trmc_slot_inits(src, args_e, tys_opt, holeslot, cx)
  # Extract the self-call's args (the recursion) from the hole slot.
  let self_args = match trmc_expr_nth(args_e, holeslot) {
    Some(e) -> match e.kind { ECall(_, sa) -> sa _ -> [] }
    None    -> []
  }
  # Rebind the loop params from the self-call args, with dropmask
  # reconciling the skipped exit-drops (same shape as tcrec_emit_goto).
  # Mixed-param lane: when the recursive fn has a (possibly mixed) raw
  # signature, the goto's arg-eval / drop / rebind must honour the
  # per-param mask — raw params evaluate raw, rebind `kair_<p>`, and are
  # NOT dropped (a scalar has no rc, the #709 corruption). Without this
  # the TRMC step rebinds `kai_<p>` (boxed prefix) for a param the
  # signature minted as `kair_<p>` (`undeclared identifier 'kai_k'`) —
  # the exact failure when mixed-sig and the TRMC+reuse path compose.
  let sig_opt  = fnx_ufn_by_csym(cx.fx, sym)
  let arg_lets = match sig_opt {
    Some(US(pts, _, pmask)) -> tcrec_emit_arg_lets_masked(src, self_args, pts, pmask, 0, cx)
    None                    -> tcrec_emit_arg_lets(src, self_args, 0, cx)
  }
  let drops    = match sig_opt {
    Some(US(_, _, pmask)) -> tcrec_emit_drops_masked(pnames, pmask, dropmask, 0)
    None                  -> tcrec_emit_drops(pnames, dropmask, 0)
  }
  let rebinds  = tcrec_emit_rebinds(pnames, 0)
  let live     = tcl_goto_drops(cx.locals, tcl_without_tok(cx.tcpend), args_e)
  let slot_stores = emit_trmc_slot_stores(src, "_trmc_node", ctor, args_e, tys_opt, holeslot, 0, cx)
  concat_all([
    # Build the spine node REUSING `_arm_ru` (the token the arm-top
    # captured from the consumed scrutinee when it was unique) — Koka
    # uniform reuse. When the donated cell matches tag/arity, write the
    # rebuilt slots DIRECTLY into it (`_con->field = ...`, Koka's shape)
    # instead of building a stack KaiVarSlot[] and having kai_variant_at
    # copy it — the array build + copy was ~10 stores per descent level;
    # direct stores are ~5. The fresh-alloc fallback (token null / arity
    # mismatch) keeps the array path via kai_variant_u_fast. `_arm_ru` is
    # null by default (emit_fn_body), so a TRMC step outside an arm-top-
    # reuse arm fresh-allocs exactly as before. Consume the token: reset
    # to null so a later step in the same descent fresh-allocs.
    "({ KaiValue *_trmc_node; ",
    "if (_arm_ru != NULL && _arm_ru->tag == KAI_VARIANT && _arm_ru->var_n_args == ", int_to_string(n), ") { ",
    "_trmc_node = _arm_ru; ", slot_stores,
    "_trmc_node->variant_tag = ", tag_str, "; _trmc_node->rc = 1; ",
    "} else { kai_reuse_free(_arm_ru); ", seq_binds(slot_inits), "KaiVarSlot _trmc_sl[", int_to_string(n), "] = {", seq_joined(slot_inits), "}; ",
    "_trmc_node = ", trmc_fresh_alloc(cname, tag_str, n, mask, cx), "; } ",
    "_arm_ru = kai_reuse_null; ",
    "_kai_acc = kai_cctx_extend_linear(_kai_acc, _trmc_node, ",
    "kai_field_addr_create(&kai_var_slots(_trmc_node)[", int_to_string(holeslot), "].ptr)); ",
    arg_lets, live, drops, rebinds,
    "goto ", c_user_entry_label(sym), "; (KaiValue *)0; })"
  ])
}

# Slot initialisers for the TRMC node, values sequenced left to right:
# position `holeslot` is the open hole (NULL ptr); other positions emit
# their ctor arg, typed by the payload type list (Int→.i64, Real→.r, else .ptr).
fn emit_trmc_slot_inits(src: String, args_e: [Expr], tys_opt: Option[[Int]],
                        holeslot: Int, cx: EmitCtx) : SeqOps / Console {
  let q = seq_operands(emit_trmc_slot_vals(src, args_e, tys_opt, holeslot, 0, cx))
  match q {
    SeqOps(binds, refs) -> SeqOps(binds, variant_slot_inits(refs, trmc_slot_fields(args_e, tys_opt, 0, cx)))
  }
}

fn trmc_slot_kind(tys_opt: Option[[Int]], i: Int, cx: EmitCtx) : Int = match tys_opt {
  Some(ts) -> kind_at(ts, i)
  None     -> 0
}

fn trmc_slot_fields(args_e: [Expr], tys_opt: Option[[Int]], i: Int, cx: EmitCtx) : [String] = match args_e {
  [] -> []
  [_, ...rest] -> {
    let k = trmc_slot_kind(tys_opt, i, cx)
    let f = if k == 1 or k == 3 { ".i64" } else if k == 2 { ".r" } else { ".ptr" }
    [f, ...trmc_slot_fields(rest, tys_opt, i + 1, cx)]
  }
}

fn emit_trmc_slot_vals(src: String, args_e: [Expr], tys_opt: Option[[Int]],
                       holeslot: Int, i: Int, cx: EmitCtx) : [String] / Console {
  match args_e {
    [] -> []
    [a, ...rest] -> {
      let kind = trmc_slot_kind(tys_opt, i, cx)
      let v =
        if i == holeslot {
          "(KaiValue *)0"
        } else if kind == 1 {
          emit_trmc_int_slot(src, a, cx)
        } else if kind == 2 {
          emit_trmc_real_slot(src, a, cx)
        } else if kind == 3 {
          # Enum slot in a TRMC rebuild: store the immediate tag,
          # matching emit_variant_slot_init's enum path. A nullary ctor
          # literal (`Red`/`Black`) stores its tag directly, skipping the
          # kai_take_enum(kai_variant_u(...)) singleton round-trip — this
          # is the hot path for the rb-tree descent's node rebuilds.
          match nullary_ctor_tag(a, cx) {
            Some(tag) -> int_to_string(tag)
            None      -> concat_all(["kai_take_enum(", emit_expr(src, a, cx), ")"])
          }
        } else {
          # Int lives in a pointer slot (kind 0) as a tagged immediate
          # (the c221cee decision: a tagged Int IS a valid KaiValue*).
          # perceus wraps the slot value in __perceus_dup, but dup/drop
          # on a tagged Int is a no-op (kai_incref short-circuits on
          # kai_is_value) — the call is still emitted and run, ~2 per
          # node rebuild on the rb-tree descent. Strip the dup when the
          # slot's declared type is Int: copy the tagged word directly,
          # no kai_internal_dup call. Safe because no ref is taken (the
          # immediate has no header) and none is owed (the old node's
          # slot is overwritten/freed, not the value).
          let is_int_slot = match tys_opt {
            Some(ts) -> kind_at(ts, i) == 1
            None     -> false
          }
          emit_expr(src, if is_int_slot { raw_border_strip_dup(a) } else { a }, cx)
        }
      [v, ...emit_trmc_slot_vals(src, rest, tys_opt, holeslot, i + 1, cx)]
    }
  }
}

# Like emit_trmc_slot_inits, but emit direct stores into `node`'s slots
# (`kai_var_slots(node)[i].FIELD = VALUE;`) instead of a slot-array
# initialiser. Used by the in-place-reuse branch of a TRMC step: when a
# reuse token is donated, write the rebuilt slots straight into the
# donated cell — Koka's `_con->field = ...` shape — instead of building a
# stack `KaiVarSlot[]` and having kai_variant_at copy it (the array build
# + copy was ~10 stores per descent level; direct stores are ~5). The
# hole slot is zeroed (the cctx fills it next).
fn emit_trmc_slot_stores(src: String, node: String, ctor: SymId, args_e: [Expr],
                         tys_opt: Option[[Int]],
                         holeslot: Int, i: Int, cx: EmitCtx) : String / Console {
  match args_e {
    [] -> ""
    [a, ...rest] -> {
      let kind = match tys_opt {
        Some(ts) -> kind_at(ts, i)
        None     -> 0
      }
      let head =
        if i == holeslot {
          concat_all(["kai_var_slots(", node, ")[", int_to_string(i), "].ptr = (KaiValue *)0; "])
        } else if trmc_slot_is_donor_identity(ctor, a, i, cx) {
          # Single-store reuse: this slot's value is already in the donated
          # shell (`_arm_ru` IS the consumed `_scr`, handed back intact), and
          # the rebuild re-places the same binder at the same position of the
          # same ctor. The store is redundant — skip it (Koka writes only the
          # changed fields). Only the TRMC hole + permuted/transformed slots
          # are written. Guarded by trmc_slot_is_donor_identity (same ctor,
          # arg is the positional binder bound off `_scr[i]`).
          #
          # A Real slot is the one kind whose binder owns a box: the arm bind
          # reads it as `kai_real(slot.r)`, and the store this elides is what
          # would have consumed it (`kai_take_real`). Pointer binders alias
          # without an incref, Int binders bind raw, enum binders are
          # immortal singletons — none owes a release. Eliding the store
          # without this decref orphans one Real per rebuilt spine node.
          if kind == 2 { trmc_elided_real_release(a, cx) } else { "" }
        } else {
          let slotpfx = concat_all(["kai_var_slots(", node, ")[", int_to_string(i), "]"])
          if kind == 1 {
            concat_all([slotpfx, ".i64 = ", emit_trmc_int_slot(src, a, cx), "; "])
          } else if kind == 2 {
            concat_all([slotpfx, ".r = ", emit_trmc_real_slot(src, a, cx), "; "])
          } else if kind == 3 {
            match nullary_ctor_tag(a, cx) {
              Some(tag) -> concat_all([slotpfx, ".i64 = ", int_to_string(tag), "; "])
              None      -> concat_all([slotpfx, ".i64 = kai_take_enum(", emit_expr(src, a, cx), "); "])
            }
          } else {
            let is_int_slot = match tys_opt {
              Some(ts) -> kind_at(ts, i) == 1
              None     -> false
            }
            let av = if is_int_slot { raw_border_strip_dup(a) } else { a }
            concat_all([slotpfx, ".ptr = ", emit_expr(src, av, cx), "; "])
          }
        }
      concat_all([head, emit_trmc_slot_stores(src, node, ctor, rest, tys_opt, holeslot, i + 1, cx)])
    }
  }
}

# Release the boxed Real a donor-identity slot elision leaves unconsumed:
# the binder's arm bind allocated the box and the elided store was its only consumer.
fn trmc_elided_real_release(a: Expr, cx: EmitCtx) : String =
  match a.kind {
    ELocal(l) -> concat_all(["kai_decref(", c_local_of(cx, l), "); "])
    _         -> ""
  }

# True when slot i of the rebuild can skip its store because the value is
# already in the donated reuse cell. SOUND only when (1) we are inside an
# arm-top-reuse body whose donor is the cell being rebuilt (`reuse_donor`
# set), (2) the rebuilt ctor is the SAME as the donor's (so slot layouts
# coincide — the cell keeps its ctor), and (3) the rebuild arg is a bare
# read of the donor's positional binder for slot i (same
# value, same position — not permuted, not transformed). The binder was bound
# borrow off `_scr[i]` at the arm top; `kai_drop_reuse_token` returned the
# shell with slot i untouched, so the value is already there. A dup'd read
# leaves the binder its own reference for its exit drop, so the store stays.
fn trmc_slot_is_donor_identity(ctor: SymId, a: Expr, i: Int, cx: EmitCtx) : Bool =
  match cx.reuse_donor {
    None -> false
    Some(ReuseDonor(dctor, binders)) ->
      if sym_raw(ctor) < 0 or not sym_same(dctor, ctor) { false }
      else { trmc_reads_donor_slot(a, binders, i) }
  }

fn trmc_reads_donor_slot(a: Expr, binders: [LocalId], i: Int) : Bool = match a.kind {
  ELocal(l) -> local_eq(l, trmc_donor_binder_nth(binders, i))
  _         -> false
}

# The donor's binder for slot `i`; the absent id, which no read matches,
# when the slot has none.
fn trmc_donor_binder_nth(binders: [LocalId], i: Int) : LocalId =
  if i < 0 { local_none() }
  else { match binders {
    []           -> local_none()
    [b, ...rest] -> if i == 0 { b } else { trmc_donor_binder_nth(rest, i - 1) }
  } }

# An Int payload slot: the ctor arg yields a boxed KaiValue*; unbox to
# the raw i64 via kai_take_int (decref-and-extract), matching how
# emit_variant_slot_init emits typed Int slots.
fn emit_trmc_int_slot(src: String, a: Expr, cx: EmitCtx) : String / Console =
  concat_all(["kai_take_int(", emit_expr(src, a, cx), ")"])

fn emit_trmc_real_slot(src: String, a: Expr, cx: EmitCtx) : String / Console =
  concat_all(["kai_take_real(", emit_expr(src, a, cx), ")"])

fn tcrec_emit_goto(src: String, sym: String, dropmask: Int, pnames: [String],
                   args_e: [Expr], cx: EmitCtx) : String / Console {

  # Phase 3 unboxing — when the recursive callee is a UFn, the
  # rebound parameters are raw scalars (`kair_<name>`) and the
  # arg values are evaluated as raw expressions. Drops collapse
  # to no-ops since raw scalars carry no reference count.
  match fnx_ufn_by_csym(cx.fx, sym) {
    Some(US(pts, rt, mask)) -> {
      # Mixed-param lane: params are a mix of raw scalars and boxed
      # pointers. Raw slots take raw `_tN` temporaries and are never
      # dropped (decref of a scalar corrupts — the #709 bug-class);
      # boxed slots drop the old param value when their dropmask bit is
      # set. Temporaries are computed before any rebind (args may
      # reference old param values); drops and rebinds go through the
      # `_kai_tcrp<N>` param pointers, immune to same-name binder shadow.
      let arg_lets = tcrec_emit_arg_lets_masked(src, args_e, pts, mask, 0, cx)
      # Releases the goto skips: enclosing owned-scrutinee refs + this
      # path's unconsumed bind-increfs. After arg_lets (args may still
      # dup-read the binders), before the rebinds.
      let live     = tcl_goto_drops(cx.locals, cx.tcpend, args_e)
      let drops    = tcrec_emit_drops_masked(pnames, mask, dropmask, 0)
      let rebinds  = tcrec_emit_rebinds(pnames, 0)
      # The statement-expression's value type must match the enclosing
      # match `_r`: a RAW-return UFn uses a scalar `0`; a BOXED-return
      # mixed UFn (e.g. `drop(xs, n) : [a]`) needs `(KaiValue *)0` so the
      # `_r = ({ ...; (KaiValue *)0; })` assignment type-checks.
      let sentinel = if ty_is_unboxable_t(rt) { "0" } else { "(KaiValue *)0" }
      concat_all([
        "({ ", arg_lets, live, drops, rebinds,
        "goto ", c_user_entry_label(sym), "; ", sentinel, "; })"
      ])
    }
    None -> {
      let arg_lets = tcrec_emit_arg_lets(src, args_e, 0, cx)
      let live     = tcl_goto_drops(cx.locals, cx.tcpend, args_e)
      let drops    = tcrec_emit_drops(pnames, dropmask, 0)
      let rebinds  = tcrec_emit_rebinds(pnames, 0)
      concat_all([
        "({ ", arg_lets, live, drops, rebinds,
        "goto ", c_user_entry_label(sym), "; (KaiValue *)0; })"
      ])
    }
  }
}

fn tcrec_emit_arg_lets(src: String, args_e: [Expr], i: Int, cx: EmitCtx) : String / Console {

  match args_e {
    [] -> ""
    [a, ...rest] -> {
      let arg_c = emit_expr(src, a, cx)
      let head = concat_all([
        "KaiValue *_t", int_to_string(i), " = ", arg_c, "; "
      ])
      string_concat(head,
        tcrec_emit_arg_lets(src, rest, i + 1, cx))
    }
  }
}

# Phase 3 unboxing — same shape as `tcrec_emit_arg_lets` but each
# `_tN` is a raw scalar matching the corresponding UFn param ty,
# and the rhs is built by `emit_expr_raw`. The decoupling between
# arg evaluation (into temporaries) and rebind (back to param
# locals) preserves the original sequencing — the prior args may
# have referenced the old param values, so all temporaries are
# computed before any rebind fires.

# Phase 3 unboxing — same shape as `tcrec_emit_arg_lets` but each
# `_tN` is a raw scalar matching the corresponding UFn param ty,
# and the rhs is built by `emit_expr_raw`. The decoupling between
# arg evaluation (into temporaries) and rebind (back to param
# locals) preserves the original sequencing — the prior args may
# have referenced the old param values, so all temporaries are
# computed before any rebind fires.
fn tcrec_emit_arg_lets_raw(src: String, args_e: [Expr], pts: [Ty], i: Int, cx: EmitCtx) : String / Console {

  match args_e {
    [] -> ""
    [a, ...rest] -> {
      let pty = match pts {
        [t, ...trest] -> t
        []            -> match a.ty { Some(t) -> t None -> TyInt }
      }
      let trest = match pts {
        [_, ...r] -> r
        []        -> []
      }
      let arg_c = emit_expr_raw(src, a, cx)
      let head = concat_all([
        raw_c_type(Some(pty)), " _t", int_to_string(i), " = ", arg_c, "; "
      ])
      string_concat(head,
        tcrec_emit_arg_lets_raw(src, rest, trest, i + 1, cx))
    }
  }
}

# The goto-loop's drops/rebinds reach the fn's C param locals through
# `_kai_tcrp<N>` pointers captured before the entry label: a pattern or
# let binder named like a param shadows `kai_<p>`/`kair_<p>` at the
# sentinel site, so a by-name rebind there would write the shadow and
# leave the real param frozen at its first-call value.
fn tcrec_emit_param_ptrs(params: [Param], i: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let head = concat_all([
        "KaiValue **_kai_tcrp", int_to_string(i), " = &", c_local(written_text(p.binder.name)), "; "
      ])
      string_concat(head, tcrec_emit_param_ptrs(rest, i + 1))
    }
  }
}

# Mixed-param variant: a raw slot's pointer takes the param's raw C
# scalar type; a boxed slot's is `KaiValue **`, as in the all-boxed path.
fn tcrec_emit_param_ptrs_masked(params: [Param], usig: UFnSig, i: Int) : String {
  match usig {
    US(pts, _, mask) -> tcrec_emit_param_ptrs_masked_loop(params, pts, mask, i)
  }
}

fn tcrec_emit_param_ptrs_masked_loop(params: [Param], pts: [Ty], mask: [Bool], i: Int) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let is_raw = match mask {
        [m, ..._] -> m
        [] -> true
      }
      let mrest = match mask {
        [_, ...r] -> r
        [] -> []
      }
      let pty = match pts {
        [t, ..._] -> Some(t)
        [] -> None
      }
      let trest = match pts {
        [_, ...r] -> r
        [] -> []
      }
      let head =
        if is_raw {
          concat_all([raw_c_type(pty), " *_kai_tcrp", int_to_string(i),
                      " = &kair_", written_text(p.binder.name), "; "])
        } else {
          concat_all(["KaiValue **_kai_tcrp", int_to_string(i),
                      " = &", c_local(written_text(p.binder.name)), "; "])
        }
      string_concat(head, tcrec_emit_param_ptrs_masked_loop(rest, trest, mrest, i + 1))
    }
  }
}

fn tcrec_emit_drops(pnames: [String], dropmask: Int, i: Int) : String {
  match pnames {
    [] -> ""
    [_, ...rest] -> {
      let bit = tcrec_pow2(i)
      let head =
        if (dropmask / bit) % 2 == 1 {
          concat_all([
            "{ KaiValue *_ = kai_internal_drop(*_kai_tcrp", int_to_string(i), "); (void) _; } "
          ])
        } else { "" }
      string_concat(head, tcrec_emit_drops(rest, dropmask, i + 1))
    }
  }
}

fn tcrec_emit_rebinds(pnames: [String], i: Int) : String {
  match pnames {
    [] -> ""
    [_, ...rest] -> {
      let head = concat_all([
        "*_kai_tcrp", int_to_string(i), " = _t", int_to_string(i), "; "
      ])
      string_concat(head, tcrec_emit_rebinds(rest, i + 1))
    }
  }
}

# Mixed-param lane (issue #440 follow-up) — TCO back-edge for a fn with
# a mix of raw and boxed params. Three helpers, all walked in lockstep
# with the same `mask`.

# Arg evaluation into temporaries: raw slot → `<scalar> _tN = <raw>`,
# boxed slot → `KaiValue *_tN = <boxed>`. Done before any rebind.
fn tcrec_emit_arg_lets_masked(src: String, args_e: [Expr], pts: [Ty], mask: [Bool], i: Int, cx: EmitCtx) : String / Console {
  match args_e {
    [] -> ""
    [a, ...rest] -> {
      let pty = match pts {
        [t, ..._] -> t
        [] -> match a.ty { Some(t) -> t  None -> TyInt }
      }
      let trest = match pts {
        [_, ...r] -> r
        [] -> []
      }
      let is_raw = match mask {
        [m, ..._] -> m
        [] -> true
      }
      let mrest = match mask {
        [_, ...r] -> r
        [] -> []
      }
      let head =
        if is_raw {
          concat_all([raw_c_type(Some(pty)), " _t", int_to_string(i), " = ",
                      emit_expr_raw(src, a, cx), "; "])
        } else {
          concat_all(["KaiValue *_t", int_to_string(i), " = ",
                      emit_expr(src, a, cx), "; "])
        }
      string_concat(head, tcrec_emit_arg_lets_masked(src, rest, trest, mrest, i + 1, cx))
    }
  }
}

# Drops: ONLY boxed slots whose dropmask bit is set get a drop of the
# old param value. Raw slots are skipped (a scalar has no refcount —
# dropping it is the #709 corruption bug).
fn tcrec_emit_drops_masked(pnames: [String], mask: [Bool], dropmask: Int, i: Int) : String {
  match pnames {
    [] -> ""
    [_, ...rest] -> {
      let is_raw = match mask {
        [m, ..._] -> m
        [] -> true
      }
      let mrest = match mask {
        [_, ...r] -> r
        [] -> []
      }
      let bit = tcrec_pow2(i)
      let head =
        if is_raw { "" }
        else if (dropmask / bit) % 2 == 1 {
          concat_all(["{ KaiValue *_ = kai_internal_drop(*_kai_tcrp", int_to_string(i), "); (void) _; } "])
        } else { "" }
      string_concat(head, tcrec_emit_drops_masked(rest, mrest, dropmask, i + 1))
    }
  }
}

# ---- `--dump-last-use`: per-fn-param last-use diagnostic ----

# ====================================================================

# ====================================================================
#                     ^name  ^exports  ^origin ^unstable_exports
#
# Issue #602: `unstable_exports` is the subset of `exports` that the
# module file wrapped in `DUnstable(...)`. The import-rewrite pass
# checks this list when threading an `EField(EName(mod), fn)` into an
# `EModCall(mod, fn)` so it can emit the #602 warning before any
# code generation runs.

# `in_progress` (issue #538 shape 1) is the stack of module paths
# currently mid-resolution. It is distinct from `visited`: `visited`
# means "finished loading, do not reload" (legitimate diamond
# imports hit this path), `in_progress` means "actively resolving;
# seeing this path again is an import cycle". Push on entry to
# `resolve_module`, pop on exit, then mark visited. Order matters —
# the head of the list is the most recently entered module, so the
# chain in the diagnostic walks head→tail.

# ====================================================================
# downward glue mirrors (cmt_ prefix) — see header

# Extract just the eff names from a row's labels — useful for the
# many string-based passes in the resolver that don't need the type
# args. Parametric effects are projected to their bare name (so
# `Reader[Int]` and `Reader[String]` both yield `Reader`); callers
# that need to distinguish instantiations work on the full label list.

#[doc("Mirror of main head's row_effects_without_default_handler (downward glue, phase 1r); reconcile in the driver lane.")]
fn cmt_row_effects_without_default_handler(main_row: [SymId],
                                        decls: [Decl]) : [SymId] {
  match main_row {
    [] -> []
    [x, ...rest] ->
      if effect_default_block_all_extern(x, decls) {
        [x, ...cmt_row_effects_without_default_handler(rest, decls)]
      } else {
        cmt_row_effects_without_default_handler(rest, decls)
      }
  }
}

# net-tcp-v1: walk the declared types so the NetTcp / Conn / Listener
# / Byte builtin injection in `inject_builtin_effects` can defer to
# any user-supplied decl with the same name. Mirrors
# `collect_effect_names` for DType.
