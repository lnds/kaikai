#[doc("""
`var` lowered after the resolver. A `var` whose initial value is a plain expression and whose cell is only read and written in place becomes a one-slot array; every other `var` becomes a `State` handler. The decision reads ids: a cell is its binder, a loop is the intrinsic the resolver made of a call of the core's.
""")]

import compiler.util
import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.refine_coerce
import compiler.handler_alias
import compiler.core_types
import compiler.core_builtins
import compiler.written
import compiler.desugar_escape
import compiler.desugar_refine_pred

#[doc("`ds` with each `var` lowered, to a slot or to a handler.")]
pub(pkg) fn lower_vars_decls(ds: [Decl]) : [Decl] = map(ds, lower_vars_decl)

#[doc("`d` with each `var` lowered, to a slot or to a handler.")]
pub(pkg) fn lower_vars_decl(d: Decl) : Decl {
  match d {
    DFn(pub_, fid, tps, ps, ret, row, body, l, c, nl, nc, mo) ->
      DFn(pub_, fid, tps, ps, ret, row, lower_vars_expr(body), l, c, nl, nc, mo)
    DTest(desc, body, l, c, mo) -> DTest(desc, lower_vars_expr(body), l, c, mo)
    DBench(desc, body, l, c, mo) -> DBench(desc, lower_vars_expr(body), l, c, mo)
    DCheck(desc, params, body, l, c, mo) -> DCheck(desc, params, lower_vars_expr(body), l, c, mo)
    DImpl(p, tas, tgt, inner, l, c, tps, isym) -> DImpl(p, tas, tgt, map(inner, lower_vars_decl), l, c, tps, isym)
    _ -> match decl_transparent_inner(d) {
      Some(inner) -> decl_rewrap(d, lower_vars_decl(inner))
      None        -> d
    }
  }
}

fn lower_vars_expr(e: Expr) : Expr =
  Expr { kind: lower_vars_kind(e.kind), line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn lower_vars_opt(opt: Option[Expr]) : Option[Expr] = map(opt, lower_vars_expr)

fn lower_vars_kind(k: ExprKind) : ExprKind = match k {
  EBlock(stmts, tail) -> lower_vars_block(stmts, tail)
  _                   -> dsg_map_expr_kind(k, lower_vars_expr)
}

# A statement before a block's first `var`: it cannot see that cell, but its inner blocks may declare their own.
fn lower_vars_stmt(s: Stmt) : Stmt = match s {
  SLet(pat, ann, rhs) -> SLet(pat, ann, lower_vars_expr(rhs))
  SAssert(c, m) -> SAssert(lower_vars_expr(c), lower_vars_opt(m))
  SExprStmt(x) -> SExprStmt(lower_vars_expr(x))
  SIndexAssign(b, i, v, l, c) -> SIndexAssign(lower_vars_expr(b), lower_vars_expr(i), lower_vars_expr(v), l, c)
  SAssign(b, v, l, c) -> SAssign(lower_vars_expr(b), lower_vars_expr(v), l, c)
  SVar(n, _, rhs, _, _) -> SLet(mk_pat(PBind(n), 0, 0), None, lower_vars_expr(rhs))
  SUse(n, l, c) -> SUse(n, l, c)
}

# The ids the handler form mints for a cell's clauses, derived from the cell's own so that no two vars share one.
fn var_clause_id(cell: Binder, what: String) : LocalId =
  local_minted(concat_all(["__var_", what, "#", int_to_string(local_raw(cell.id))]))

# A binder of the clause `op`, named `name`: each clause binds its own, as the resolver numbers them.
fn var_clause_binder(cell: Binder, op: String, name: String) : Binder =
  Binder { id: var_clause_id(cell, concat_all([op, "_", name])), name: written(name) }

fn var_clause_param(cell: Binder, op: String, name: String, line: Int, col: Int) : Param =
  Param { binder: var_clause_binder(cell, op, name), ptype: None, pline: line, pcol: col, pborrow: false }

# The canonical `State` clauses of a `var`. `get` resumes with the slot the
# alias holds, which Perceus dups; `set` resumes with the new value stored in it.
fn var_canonical_clauses(cell: Binder, line: Int, col: Int) : [HClause] {
  let get_k = var_clause_param(cell, "get", "resume", line, col)
  let set_v = var_clause_param(cell, "set", "v", line, col)
  let set_k = var_clause_param(cell, "set", "resume", line, col)
  let get_body = mk_expr(ECall(mk_local(get_k.binder.id, line, col), [mk_local(local_minted(var_cell_alias()), line, col)]), line, col)
  let set_body = mk_expr(ECall(mk_local(set_k.binder.id, line, col), [mk_expr(EUnit, line, col), mk_local(set_v.binder.id, line, col)]), line, col)
  [
    HC(ChOp(cell_op_name(CellGet)), [get_k], get_body, line, col),
    HC(ChOp(cell_op_name(CellSet)), [set_v, set_k], set_body, line, col)
  ]
}

fn var_canonical_return(cell: Binder, line: Int, col: Int) : HReturn = {
  let x = var_clause_binder(cell, "return", "x")
  HR(x, mk_local(x.id, line, col), line, col)
}

# The initial value is a plain expression: literals, a reference, core
# arithmetic, and calls whose callee is a reference. An op call, lambda,
# handle, match, if, block, list or record keeps the handler.
fn init_is_safe(e: Expr) : Bool {
  match e.kind {
    EInt(_, _)  -> true
    EReal(_, _) -> true
    EIntLit(_) -> true
    EDecimalLit(_) -> true
    EFixed(_, _) -> true
    EBool(_) -> true
    EChar(_) -> true
    EStr(_, _) -> true
    EUnit -> true
    EName(_) -> true
    ESym(_, _) -> true
    ELocal(_) -> true
    EBinop(_, a, b) -> init_is_safe(a) and init_is_safe(b)
    EUnop(_, x) -> init_is_safe(x)
    ECall(callee, args_) -> {
      let callee_ok = match callee.kind {
        EName(_) -> true
        ESym(_, _) -> true
        ELocal(_) -> true
        _ -> false
      }
      callee_ok and init_args_safe(args_)
    }
    _ -> false
  }
}

fn init_args_safe(es: [Expr]) : Bool {
  match es {
    [] -> true
    [h, ...rest] -> if init_is_safe(h) { init_args_safe(rest) } else { false }
  }
}

fn var_slot_binder(cell: Binder) : Binder =
  Binder { id: local_minted(concat_all(["__var_slot#", int_to_string(local_raw(cell.id))])),
           name: written(string_concat(written_text(cell.name), "__slot")) }

# The statements of a block up to its first `var`, and that `var` with the rest of the block, which is its scope.
type VarAt = { b: Binder, ty: Option[TypeExpr], init: Expr, rest: [Stmt], line: Int, col: Int }

type VarSplit = { before: [Stmt], found: Option[VarAt] }

fn split_first_var(stmts: [Stmt], acc: [Stmt]) : VarSplit = match stmts {
  [] -> VarSplit { before: list_reverse(acc), found: None }
  [SVar(b, ty, init, line, col), ...rest] ->
    VarSplit { before: list_reverse(acc), found: Some(VarAt { b: b, ty: ty, init: init, rest: rest, line: line, col: col }) }
  [s, ...rest] -> split_first_var(rest, [s, ...acc])
}

# The statements before the first `var` are lowered on their own.
fn lower_vars_block(stmts: [Stmt], tail: Option[Expr]) : ExprKind {
  let sp = split_first_var(stmts, [])
  let before = map(sp.before, lower_vars_stmt)
  match sp.found {
    None -> EBlock(before, lower_vars_opt(tail))
    Some(v) -> match lower_var(v.b, v.ty, lower_vars_expr(v.init), lower_vars_block(v.rest, tail), v.line, v.col) {
      EBlock(ss, t) -> EBlock(list_append(before, ss), t)
      k             -> EBlock(before, Some(mk_expr(k, 0, 0)))
    }
  }
}

fn lower_var(b: Binder, ty: Option[TypeExpr], init0: Expr, inner_kind: ExprKind, line: Int, col: Int) : ExprKind {
  # A declared `: T` binds the cell, so it is checked against the initialiser.
  # Neither lowering carries the annotation (the slot drops it; the handler's
  # `[T]` types the capability, not the state), so an annotated `let` pins it.
  let ann = var_ann_binder(written_text(b.name), line, col)
  let ann_pre = match ty {
    Some(t) -> [SLet(mk_pat(PBind(ann), line, col), Some(t), init0)]
    None -> []
  }
  let init_d = match ty {
    Some(_) -> mk_local(ann.id, line, col)
    None -> init0
  }
  let inner_expr = rc_check_var_writes(b, ty, mk_expr(inner_kind, line, col))
  if init_is_safe(init_d) and not body_escapes(b.id, inner_expr) {
    let slot = var_slot_binder(b)
    let slot_init = mk_expr(
      ECall(builtin_mk(CbArrayMake, line, col), [mk_expr(mk_int_synth(1), line, col), init_d]),
      line, col)
    let let_stmt = SLet(mk_pat(PBind(slot), line, col), None, slot_init)
    EBlock(list_append(ann_pre, [let_stmt]), Some(specialise_body(b.id, slot.id, inner_expr)))
  } else {
    let tyargs = match ty { Some(t) -> [t]  None -> [] }
    let handle_kind = EHandle(inner_expr, DrSym(core_effect_id(CeState)), tyargs, Some(init_d), Some(b),
                              var_canonical_clauses(b, line, col), Some(var_canonical_return(b, line, col)))
    EBlock(ann_pre, Some(mk_expr(handle_kind, line, col)))
  }
}
