#[doc("""
The spelling of the binary, unary and dispatch-pipe operators.

Which operator an `EBinop` or an `EUnop` applies rides the node as a
`BinOp` or a `UnOp` constructor, so a pass that builds one and the
passes that read it agree by construction, and a reader that matches on
them stops compiling until it says what it does with a new one.

The text survives at two boundaries only. The parser turns the
operator it read into the constructor with `binop_of_text`; the
formatter, the dumps, the diagnostics and the emitted code print it
back with `binop_text` and `unop_text`.
""")]

import compiler.ast
import compiler.ast_ids
import compiler.ast_ids

#[doc("The source spelling of a binary operator.")]
pub(pkg) fn binop_text(o: BinOp) : String = match o {
  BoAdd    -> "+"
  BoSub    -> "-"
  BoMul    -> "*"
  BoDiv    -> "/"
  BoMod    -> "%"
  BoPow    -> "^"
  BoConcat -> "++"
  BoEq     -> "=="
  BoNe     -> "!="
  BoLt     -> "<"
  BoGt     -> ">"
  BoLe     -> "<="
  BoGe     -> ">="
  BoAnd    -> "and"
  BoOr     -> "or"
}

#[doc("The binary operator a spelling denotes, or `None` when it denotes none. The inverse of `binop_text`.")]
pub(pkg) fn binop_of_text(s: String) : Option[BinOp] = match s {
  "+"   -> Some(BoAdd)
  "-"   -> Some(BoSub)
  "*"   -> Some(BoMul)
  "/"   -> Some(BoDiv)
  "%"   -> Some(BoMod)
  "^"   -> Some(BoPow)
  "++"  -> Some(BoConcat)
  "=="  -> Some(BoEq)
  "!="  -> Some(BoNe)
  "<"   -> Some(BoLt)
  ">"   -> Some(BoGt)
  "<="  -> Some(BoLe)
  ">="  -> Some(BoGe)
  "and" -> Some(BoAnd)
  "or"  -> Some(BoOr)
  _     -> None
}

#[doc("The source spelling of a unary operator.")]
pub(pkg) fn unop_text(o: UnOp) : String = match o {
  UoNeg -> "-"
  UoNot -> "not"
}

#[doc("True when `a` and `b` are the same binary operator.")]
pub(pkg) fn binop_eq(a: BinOp, b: BinOp) : Bool = binop_text(a) == binop_text(b)

#[doc("True when `a` and `b` are the same unary operator.")]
pub(pkg) fn unop_eq(a: UnOp, b: UnOp) : Bool = unop_text(a) == unop_text(b)

#[doc("True for the five arithmetic operators `+ - * / %`.")]
pub(pkg) fn binop_is_arith(o: BinOp) : Bool = match o {
  BoAdd -> true
  BoSub -> true
  BoMul -> true
  BoDiv -> true
  BoMod -> true
  _     -> false
}

#[doc("True for `/` and `%`, the operators a zero divisor traps.")]
pub(pkg) fn binop_is_division(o: BinOp) : Bool = match o {
  BoDiv -> true
  BoMod -> true
  _     -> false
}

#[doc("True for `==` and `!=`.")]
pub(pkg) fn binop_is_equality(o: BinOp) : Bool = match o {
  BoEq -> true
  BoNe -> true
  _    -> false
}

#[doc("True for the four ordering operators `< > <= >=`.")]
pub(pkg) fn binop_is_ordering(o: BinOp) : Bool = match o {
  BoLt -> true
  BoGt -> true
  BoLe -> true
  BoGe -> true
  _    -> false
}

#[doc("True for the six comparison operators: equality and ordering.")]
pub(pkg) fn binop_is_comparison(o: BinOp) : Bool = binop_is_equality(o) or binop_is_ordering(o)

#[doc("True for `and` and `or`, which evaluate their right operand only when the left one does not decide.")]
pub(pkg) fn binop_is_logical(o: BinOp) : Bool = match o {
  BoAnd -> true
  BoOr  -> true
  _     -> false
}

#[doc("The source spelling of a dispatch pipe.")]
pub(pkg) fn pipe_op_text(o: PipeOp) : String = match o {
  PoMap     -> "|"
  PoFlatMap -> "||"
  PoFilter  -> "|?"
  PoEach    -> "|!"
}

#[doc("The node name the AST dumps print for a dispatch pipe.")]
pub(pkg) fn pipe_op_dump_name(o: PipeOp) : String = match o {
  PoMap     -> "map_pipe"
  PoFlatMap -> "flat_map_pipe"
  PoFilter  -> "filter_pipe"
  PoEach    -> "each_pipe"
}

#[doc("True when `op` compares two statically-Int operands.")]
pub(pkg) fn int_cmp_raw(op: BinOp, a: Expr, b: Expr) : Bool =
  binop_is_comparison(op) and ic_is_int(a.ty) and ic_is_int(b.ty)

fn ic_is_int(opt_ty: Option[Ty]) : Bool = match opt_ty {
  Some(t) -> match t {
    TyInt               -> true
    TyDimT(inner, _)    -> match inner { TyInt -> true  _ -> false }
    TyRefineT(inner, _) -> match inner { TyInt -> true  _ -> false }
    _                   -> false
  }
  None -> false
}
