# The union a variant with no constructor tags: the one its module
# declares listing the type the variant stands for. A generic union's
# tag, and any other unbound declaration, is typed by its use.
#[doc("Typer-internal helper `tag_union_ty` shared across the infer modules.")]
pub fn tag_union_ty(st: InferState, c: SymId) : Ty = {
  let tab = st.env.tab
  if not st_valid(tab, c) or not inf_is_ctor(tab, c) { TyAny }
  else { match filter(ut_parents(st.env.unions, tsh_variant_sym(st_home_view(st), c)), (r) => sym_same_owner(tab, ut_row_sym(r), c)) {
    [r] -> match ut_row_ty(r) {
      TyCon(u, []) -> TyCon(u, [])
      _            -> TyAny
    }
    _ -> TyAny
  } }
}


#[doc("Typer-internal helper `mut_scan` shared across the infer modules.")]
pub fn mut_scan(st: InferState, params: [Param], body: Expr) : MutScan {
  let dmut = st.env.carriers
  let built = collect_local_arrays(body, [], dmut)
  let tainted = tainted_locals(body, built, (v, live) => stores_foreign_carrier(v, live, dmut))
  MutScan { tab: st.env.tab, locals: filter(built, (l) => not lid_in(tainted.all, l)), tainted: tainted.roots,
            escaped: collect_escaped_result(st.protos.ids, body, []),
            opaque: opaque_binders(params, body), dmut: dmut }
}


#[doc("Typer-internal helper `demand_via` shared across the infer modules.")]
pub fn demand_via(params: [Param], body: Expr, d: Expr, sc: MutScan) : Option[SpanNote] = match d.kind {
  ECall(callee, args_) -> match demand_target(callee, args_, sc) {
    Some(t) -> match provenance_loss(body, t, (x) => carrier_not_local(x, sc)) {
      Some(f) -> Some(mut_via_note(sc.tab, ln_with_expr(ln_with_params(ln_empty(), params), body), t, f))
      None    -> None
    }
    None -> None
  }
  _ -> None
}


fn carrier_not_local(x: Expr, sc: MutScan) : Bool = match x.ty {
  Some(t) -> ty_may_carry_mutation(t, sc.dmut) and not rhs_is_local_origin(x, sc.locals, sc.dmut)
  None    -> false
}


# Walk the typed body and accumulate the locals bound to a locally-
# constructed mutable value (an Array, a Ref, or a Ref-backed
# container — `dmut` lists the mutating types). Recurses
# through every sub-expression so locals introduced inside
# if/match/block branches are caught.
fn collect_local_arrays(e: Expr, acc: [LocalId], dmut: [SymId]) : [LocalId] =
  collect_local_arrays_kind(e.kind, acc, dmut)


fn collect_local_arrays_kind(k: ExprKind, acc: [LocalId], dmut: [SymId]) : [LocalId] {
  match k {
    EBlock(stmts, tail) -> {
      let acc1 = collect_local_in_stmts(stmts, acc, dmut)
      match tail {
        Some(t) -> collect_local_arrays(t, acc1, dmut)
        None    -> acc1
      }
    }
    EIf(c, t_, eo) -> {
      let a1 = collect_local_arrays(c, acc, dmut)
      let a2 = collect_local_arrays(t_, a1, dmut)
      match eo {
        Some(e2) -> collect_local_arrays(e2, a2, dmut)
        None     -> a2
      }
    }
    EMatch(scr, arms) -> {
      let a1 = collect_local_arrays(scr, acc, dmut)
      collect_local_in_arms(arms, a1, dmut)
    }
    ECall(callee, args_) -> {
      let a1 = collect_local_arrays(callee, acc, dmut)
      collect_local_in_exprs(args_, a1, dmut)
    }
    EBinop(_, a, b)   -> collect_local_arrays(b, collect_local_arrays(a, acc, dmut), dmut)
    EUnop(_, x)       -> collect_local_arrays(x, acc, dmut)
    EField(b, _)      -> collect_local_arrays(b, acc, dmut)
    EIndex(a, b)      -> collect_local_arrays(b, collect_local_arrays(a, acc, dmut), dmut)
    EPipe(a, b)       -> collect_local_arrays(b, collect_local_arrays(a, acc, dmut), dmut)
    EDispatchPipe(_, a, b) -> collect_local_arrays(b, collect_local_arrays(a, acc, dmut), dmut)
    ELambda(_, b)     -> collect_local_arrays(b, acc, dmut)
    ERecordLit(_, fs) -> collect_local_in_field_inits(fs, acc, dmut)
    EList(els)        -> collect_local_in_list_elems(els, acc, dmut)
    ERange(a, b, oc)  -> {
      let a1 = collect_local_arrays(b, collect_local_arrays(a, acc, dmut), dmut)
      match oc { Some(c) -> collect_local_arrays(c, a1, dmut) None -> a1 }
    }
    EHandle(body, _, _, init_opt, _, clauses, ret_opt) -> {
      let a1 = collect_local_arrays(body, acc, dmut)
      let a2 = match init_opt { Some(i) -> collect_local_arrays(i, a1, dmut) None -> a1 }
      let a3 = collect_local_in_hclauses(clauses, a2, dmut)
      match ret_opt {
        Some(HR(_, body, _, _)) -> collect_local_arrays(body, a3, dmut)
        None              -> a3
      }
    }
    ELitUnit(inner, _) -> collect_local_arrays(inner, acc, dmut)
    EBang(inner)       -> collect_local_arrays(inner, acc, dmut)
    EIntrinsic(_, xs)  -> collect_local_in_exprs(xs, acc, dmut)
    ESurface(sf)       -> collect_local_in_exprs(surface_children(sf), acc, dmut)
    _ -> acc
  }
}


fn collect_local_in_exprs(es: [Expr], acc: [LocalId], dmut: [SymId]) : [LocalId] = match es {
  []           -> acc
  [h, ...rest] -> collect_local_in_exprs(rest, collect_local_arrays(h, acc, dmut), dmut)
}


fn collect_local_in_field_inits(fs: [FieldInit], acc: [LocalId], dmut: [SymId]) : [LocalId] = match fs {
  []           -> acc
  [h, ...rest] -> match h {
    FI(_, v) -> collect_local_in_field_inits(rest, collect_local_arrays(v, acc, dmut), dmut)
  }
}


fn collect_local_in_list_elems(els: [ListElem], acc: [LocalId], dmut: [SymId]) : [LocalId] = match els {
  []           -> acc
  [h, ...rest] -> match h {
    ElPlain(x)  -> collect_local_in_list_elems(rest, collect_local_arrays(x, acc, dmut), dmut)
    ElSpread(x) -> collect_local_in_list_elems(rest, collect_local_arrays(x, acc, dmut), dmut)
  }
}


fn collect_local_in_arms(arms: [Arm], acc: [LocalId], dmut: [SymId]) : [LocalId] = match arms {
  []           -> acc
  [h, ...rest] -> match h {
    Arm(_, g, b) -> {
      let a1 = match g { Some(gx) -> collect_local_arrays(gx, acc, dmut) None -> acc }
      collect_local_in_arms(rest, collect_local_arrays(b, a1, dmut), dmut)
    }
  }
}


fn collect_local_in_hclauses(cs: [HClause], acc: [LocalId], dmut: [SymId]) : [LocalId] = match cs {
  []           -> acc
  [h, ...rest] -> match h {
    HC(_, _, b, _, _) -> collect_local_in_hclauses(rest, collect_local_arrays(b, acc, dmut), dmut)
  }
}


fn collect_local_in_stmts(stmts: [Stmt], acc: [LocalId], dmut: [SymId]) : [LocalId] = match stmts {
  []           -> acc
  [s, ...rest] -> collect_local_in_stmts(rest, collect_local_in_stmt(s, acc, dmut), dmut)
}


fn collect_local_in_stmt(s: Stmt, acc: [LocalId], dmut: [SymId]) : [LocalId] {
  match s {
    SLet(p, _, rhs) -> {
      # Recurse into rhs first (a let RHS may itself contain nested
      # local-construction bindings inside an if/match branch).
      let acc1 = collect_local_arrays(rhs, acc, dmut)
      match p.pkind {
        PBind(b) ->
          if rhs_is_local_origin(rhs, acc1, dmut) {
            [b.id, ...acc1]
          } else { acc1 }
        _ -> acc1
      }
    }
    SAssert(c, m) -> {
      let a1 = collect_local_arrays(c, acc, dmut)
      match m { Some(mx) -> collect_local_arrays(mx, a1, dmut) None -> a1 }
    }
    SExprStmt(x)                -> collect_local_arrays(x, acc, dmut)
    SIndexAssign(b, i, v, _, _) ->
      collect_local_arrays(v, collect_local_arrays(i, collect_local_arrays(b, acc, dmut), dmut), dmut)
    SAssign(b, v, _, _) ->
      collect_local_arrays(v, collect_local_arrays(b, acc, dmut), dmut)
    SVar(_, _, rhs, _, _)       -> collect_local_arrays(rhs, acc, dmut)
    SUse(_, _, _)               -> acc
  }
}


# Collect names that appear as argument positions of any call other
# than the safe array_* whitelist. Conservative escape: passing a
# locally-constructed Array to a helper assumes the helper might
# mutate it. The whitelist covers reads
# (array_get / array_length) and writes the demand pass already
# inspects (array_set / array_grow / array_make).
fn collect_escaped_names(ids: ProtoIds, e: Expr, acc: [LocalId]) : [LocalId] =
  collect_escaped_names_kind(ids, e.kind, acc)


fn collect_escaped_names_kind(ids: ProtoIds, k: ExprKind, acc: [LocalId]) : [LocalId] {
  match k {
    ECall(callee, args_) -> collect_escaped_call(ids, callee, args_, acc)
    EBlock(stmts, tail) -> escaped_opt(ids, tail, collect_escaped_in_stmts(ids, stmts, acc))
    EIf(c, t_, eo) -> escaped_opt(ids, eo, collect_escaped_names(ids, t_, collect_escaped_names(ids, c, acc)))
    EMatch(scr, arms) -> collect_escaped_in_arms(ids, arms, collect_escaped_names(ids, scr, acc))
    EBinop(_, a, b) -> collect_escaped_names(ids, b, collect_escaped_names(ids, a, acc))
    EUnop(_, x) -> collect_escaped_names(ids, x, acc)
    EField(b, _) -> collect_escaped_names(ids, b, acc)
    EIndex(a, b) -> collect_escaped_names(ids, b, collect_escaped_names(ids, a, acc))
    EPipe(a, b) -> collect_escaped_names(ids, pipe_as_call(a, b), acc)
    EDispatchPipe(_, a, b) -> collect_escaped_via_pipe(ids, a, b, acc)
    ELambda(_, b) -> collect_escaped_names(ids, b, acc)
    ERecordLit(_, fs) -> collect_escaped_in_field_inits(ids, fs, acc)
    EList(els) -> collect_escaped_in_list_elems(ids, els, acc)
    ERange(a, b, oc) -> escaped_opt(ids, oc, collect_escaped_names(ids, b, collect_escaped_names(ids, a, acc)))
    EHandle(body, _, _, init_opt, _, clauses, ret_opt) -> {
      let a2 = escaped_opt(ids, init_opt, collect_escaped_names(ids, body, acc))
      let a3 = collect_escaped_in_hclauses(ids, clauses, a2)
      match ret_opt {
        Some(HR(_, rbody, _, _)) -> collect_escaped_names(ids, rbody, a3)
        None -> a3
      }
    }
    ELitUnit(inner, _) -> collect_escaped_names(ids, inner, acc)
    EBang(inner) -> collect_escaped_names(ids, inner, acc)
    EIntrinsic(_, xs) -> collect_escaped_in_exprs_safe(ids, xs, acc)
    ESurface(sf) -> collect_escaped_in_exprs(ids, surface_children(sf), acc)
    _ -> acc
  }
}

fn escaped_opt(ids: ProtoIds, o: Option[Expr], acc: [LocalId]) : [LocalId] =
  match o {
    Some(x) -> collect_escaped_names(ids, x, acc)
    None -> acc
  }

fn collect_escaped_call(ids: ProtoIds, callee: Expr, args_: [Expr], acc: [LocalId]) : [LocalId] {
  let a0 = collect_escaped_names(ids, callee, acc)
  if callee_args_safe(ids, callee) { collect_escaped_in_exprs_safe(ids, args_, a0) }
  else { collect_escaped_in_exprs(ids, args_, a0) }
}

# A named callee (a declaration, a local, a primitive or dispatcher mark) never
# makes its arguments escape: `mutable_callee_args_all_local` alone decides per
# call site whether passing a local mutable value to a `/ Mutable` callee is
# observable. An unnamed callee (a lambda, a field access) is safe only when
# its row carries no `Mutable`.
fn callee_args_safe(ids: ProtoIds, callee: Expr) : Bool {
  let callee_ty = match callee.ty {
    Some(t) -> t
    None -> TyAny
  }
  match callee.kind {
    ELocal(_) -> true
    ESym(_, _) -> true
    EName(_) -> true
    EOp(r) -> effect_is(r.eff, CeMutable)
    EMark(m) -> mark_is_prim(m) or ty_callee_has_mutable(callee_ty)
    EModCall(m, n) -> pid_qualified_is_disp(ids, m, n) or ty_callee_has_mutable(callee_ty)
    _ -> ty_callee_has_mutable(callee_ty)
  }
}


# A collection pipe hands the LHS to its stage: it escapes unless the
# stage is a safe array_* core builtin.
fn collect_escaped_via_pipe(ids: ProtoIds, a: Expr, b: Expr, acc: [LocalId]) : [LocalId] {
  let safe = is_array_safe_callee(b)
  let a1 = collect_escaped_names(ids, b, acc)
  if safe { collect_escaped_names(ids, a, a1) }
  else { match a.kind {
    ELocal(l) -> [l, ...collect_escaped_names(ids, a, a1)]
    _         -> collect_escaped_names(ids, a, a1)
  } }
}


fn is_array_safe_callee(callee: Expr) : Bool {
  # Runtime builtins for Array — their first argument is the array
  # they read or mutate. The masking pass already classifies each
  # call site as local-vs-external by inspecting that argument, so
  # treating the callees themselves as non-escaping is sound.
  #
  # previously this list also held `array_concat_bytes`
  # and `bin_write_len4` (stdlib functions hardcoded by name). Those
  # entries crossed an abstraction boundary — the compiler should
  # not know about specific stdlib symbols. They are gone; their
  # callers now propagate `/ Mutable` honestly through the row.
  match builtin_ref(callee) {
    Some(CbArrayMake)   -> true
    Some(CbArrayLength) -> true
    Some(CbArrayGet)    -> true
    Some(CbArraySet)    -> true
    Some(CbArrayGrow)   -> true
    _                   -> false
  }
}


# Variant for argument lists of safe (whitelisted) callees:
# arguments that are direct references DO NOT escape,
# but we still recurse structurally so deeper calls inside e.g.
# `array_set(local, idx, helper(local))` register `helper(local)`'s
# escape correctly.
fn collect_escaped_in_exprs_safe(ids: ProtoIds, es: [Expr], acc: [LocalId]) : [LocalId] = match es {
  []           -> acc
  [h, ...rest] -> match h.kind {
    ELocal(_) -> collect_escaped_in_exprs_safe(ids, rest, acc)
    ESym(_, _) -> collect_escaped_in_exprs_safe(ids, rest, acc)
    _       -> collect_escaped_in_exprs_safe(ids, rest, collect_escaped_names(ids, h, acc))
  }
}


# Variant for argument lists of NON-whitelisted callees: every direct
# read of a local escapes (the callee may mutate it). Otherwise
# recurse.
fn collect_escaped_in_exprs(ids: ProtoIds, es: [Expr], acc: [LocalId]) : [LocalId] = match es {
  []           -> acc
  [h, ...rest] -> match h.kind {
    ELocal(l) -> collect_escaped_in_exprs(ids, rest, [l, ...acc])
    _         -> collect_escaped_in_exprs(ids, rest, collect_escaped_names(ids, h, acc))
  }
}


# The function's result: a record literal returned from it hands its fields
# to the caller, like returning the local itself, so they do not escape.
fn collect_escaped_result(ids: ProtoIds, e: Expr, acc: [LocalId]) : [LocalId] = match e.kind {
  EBlock(stmts, tail) -> {
    let a1 = collect_escaped_in_stmts(ids, stmts, acc)
    match tail { Some(t) -> collect_escaped_result(ids, t, a1)  None -> a1 }
  }
  EIf(c, t_, eo) -> {
    let a2 = collect_escaped_result(ids, t_, collect_escaped_names(ids, c, acc))
    match eo { Some(x) -> collect_escaped_result(ids, x, a2)  None -> a2 }
  }
  EMatch(scr, arms) -> foldl(arms, collect_escaped_names(ids, scr, acc), (a, arm) => match arm {
    Arm(_, g, b) -> collect_escaped_result(ids, b, match g { Some(gx) -> collect_escaped_names(ids, gx, a)  None -> a })
  })
  ERecordLit(_, fs) -> foldl(fs, acc, (a, f) => match f {
    FI(_, v) -> match v.kind {
      ELocal(_) -> a
      _         -> collect_escaped_result(ids, v, a)
    }
  })
  _ -> collect_escaped_names(ids, e, acc)
}


fn collect_escaped_in_stmts(ids: ProtoIds, stmts: [Stmt], acc: [LocalId]) : [LocalId] = match stmts {
  []           -> acc
  [s, ...rest] -> collect_escaped_in_stmts(ids, rest, collect_escaped_in_stmt(ids, s, acc))
}


fn collect_escaped_in_stmt(ids: ProtoIds, s: Stmt, acc: [LocalId]) : [LocalId] {
  match s {
    SLet(_, _, rhs)             -> collect_escaped_names(ids, rhs, acc)
    SAssert(c, m) -> {
      let a1 = collect_escaped_names(ids, c, acc)
      match m { Some(mx) -> collect_escaped_names(ids, mx, a1) None -> a1 }
    }
    SExprStmt(x)                -> collect_escaped_names(ids, x, acc)
    SIndexAssign(b, i, v, _, _) ->
      collect_escaped_names(ids, v, collect_escaped_names(ids, i, collect_escaped_names(ids, b, acc)))
    SAssign(b, v, _, _) ->
      collect_escaped_names(ids, v, collect_escaped_names(ids, b, acc))
    SVar(_, _, rhs, _, _)       -> collect_escaped_names(ids, rhs, acc)
    SUse(_, _, _)               -> acc
  }
}


fn collect_escaped_in_arms(ids: ProtoIds, arms: [Arm], acc: [LocalId]) : [LocalId] = match arms {
  []           -> acc
  [h, ...rest] -> match h {
    Arm(_, g, b) -> {
      let a1 = match g { Some(gx) -> collect_escaped_names(ids, gx, acc) None -> acc }
      collect_escaped_in_arms(ids, rest, collect_escaped_names(ids, b, a1))
    }
  }
}


fn collect_escaped_in_hclauses(ids: ProtoIds, cs: [HClause], acc: [LocalId]) : [LocalId] = match cs {
  []           -> acc
  [h, ...rest] -> match h {
    HC(_, _, b, _, _) -> collect_escaped_in_hclauses(ids, rest, collect_escaped_names(ids, b, acc))
  }
}


fn collect_escaped_in_field_inits(ids: ProtoIds, fs: [FieldInit], acc: [LocalId]) : [LocalId] = match fs {
  []           -> acc
  [h, ...rest] -> match h {
    FI(_, v) -> match v.kind {
      ELocal(l) -> collect_escaped_in_field_inits(ids, rest, [l, ...acc])
      _         -> collect_escaped_in_field_inits(ids, rest, collect_escaped_names(ids, v, acc))
    }
  }
}


fn collect_escaped_in_list_elems(ids: ProtoIds, els: [ListElem], acc: [LocalId]) : [LocalId] = match els {
  []           -> acc
  [h, ...rest] -> match h {
    ElPlain(x) -> match x.kind {
      ELocal(l) -> collect_escaped_in_list_elems(ids, rest, [l, ...acc])
      _         -> collect_escaped_in_list_elems(ids, rest, collect_escaped_names(ids, x, acc))
    }
    ElSpread(x) -> collect_escaped_in_list_elems(ids, rest, collect_escaped_names(ids, x, acc))
  }
}


# Pass 2: walk every `array_set(first, ...)` / `array_grow(first, ...)`
# call site and decide whether the demand is local or external.
# Returns true iff EVERY demand encountered is local-non-escaping.
# An empty body (no demands) returns true vacuously — but the caller
# only invokes us when `Mutable` is actually in the row, so the body
# must contain at least one demand.
# true iff `t` is a function type whose declared row
# carries the `Mutable` label. Used by the masking pass to recognise
# call sites whose Mutable contribution comes from the callee's
# declared row rather than a direct `array_set` / `ref_set`.
fn ty_callee_has_mutable(t: Ty) : Bool = match t {
  TyFnT(_, _, row) -> labels_contain_mutable(row.labels)
  _                -> false
}


#[doc("Typer-internal helper `labels_contain_mutable` shared across the infer modules.")]
pub fn labels_contain_mutable(labels: [Label]) : Bool = match labels {
  []           -> false
  [h, ...rest] -> if effect_is(h.sym, CeMutable) { true } else { labels_contain_mutable(rest) }
}


# True iff the call's callee is an op of the `Mutable` effect: the callee
# of a perform names its effect. Its `.ty` is the op's result type,
# so `ty_callee_has_mutable` cannot see the demand. This is NOT a per-op
# whitelist — `array_set`, `ref_set`, `ref_get`, `ref_make`, and any other
# `Mutable` op all match.
fn callee_is_mutable_op(callee: Expr) : Bool = match callee.kind {
  EOp(r) -> effect_is(r.eff, CeMutable)
  _      -> false
}


# For a callee declared `/ Mutable`, find the argument through which the
# mutation it performs is observable. Each argument that CARRIES MUTATION
# must be a locally-originated, non-parameter, non-escaping value; an
# argument of any other type cannot carry mutation and is ignored.
#
# A mutation-carrying arg is local iff it is `local_origin` (a local read,
# a fresh-constructor inline like `string_builder.new()`, or a record literal
# whose fields are all local) — which lets `foldl(xs, new(), \b -> mutate(b))`
# mask: the HOF's local `init` makes the lambda's accumulator local. A shared
# parameter or a constructor that wraps a shared value is rejected (its arg
# carries mutation and is not local).
fn first_nonlocal_carrier(args_: [Expr], sc: MutScan) : Option[Expr] = match args_ {
  []           -> None
  [h, ...rest] -> {
    let arg_ty = match h.ty { Some(t) -> t  None -> TyAny }
    if not ty_may_carry_mutation(arg_ty, sc.dmut) { first_nonlocal_carrier(rest, sc) }
    else if fn_value_is_transparent(h, sc.opaque) { first_nonlocal_carrier(rest, sc) }
    else if arg_is_local_carrier(h, sc.locals, sc.escaped, sc.dmut) { first_nonlocal_carrier(rest, sc) }
    else { Some(h) }
  }
}


# A writer that mutates only its first argument makes the demand
# observable only through that destination.
fn writer_dst_nonlocal(args_: [Expr], sc: MutScan) : Option[Expr] = match args_ {
  []            -> None
  [h, ..._rest] -> if dst_is_local(h, sc) { None } else { Some(h) }
}


# A tainted container is still a local destination: only what is read out
# of it is foreign.
fn dst_is_local(h: Expr, sc: MutScan) : Bool = match h.kind {
  ELocal(l) -> not lid_in(sc.escaped, l) and (lid_in(sc.locals, l) or lid_in(sc.tainted, l))
  _         -> arg_is_local_carrier(h, sc.locals, sc.escaped, sc.dmut)
}


# The argument through which a `/ Mutable` call's demand is observable.
fn demand_target(callee: Expr, args_: [Expr], sc: MutScan) : Option[Expr] =
  if callee_writes_only_first_arg(sc.tab, callee) { writer_dst_nonlocal(args_, sc) }
  else { first_nonlocal_carrier(args_, sc) }


fn callee_writes_only_first_arg(tab: SymTab, callee: Expr) : Bool = match callee.kind {
  ESym(s, _) -> writes_only_first_arg(tab, s) or is_builtin_ref(callee, CbArraySet)
  _          -> false
}


# A mutation-carrying argument is local iff its origin is local AND, when it
# names a local, that name is not escaped. `rhs_is_local_origin` covers the
# fresh-constructor and record-literal shapes (recursing into args/fields, so
# a `wrap(shared)` factory is correctly non-local).
fn arg_is_local_carrier(h: Expr, locals: [LocalId], escaped: [LocalId], dmut: [SymId]) : Bool =
  match h.kind {
    ELocal(l) -> if lid_in(escaped, l) { false } else { lid_in(locals, l) }
    _         -> rhs_is_local_origin(h, locals, dmut)
  }


# A call demands `Mutable` when its callee's type carries it or the callee
# is an op of the `Mutable` effect (a qualified `Mutable.<op>` is rewritten
# to an `EOp` whose `.ty` is the effect instance, not a `/ Mutable` fn type).
# Every spelling — the core `array_set` / `array_grow`, a Ref-backed
# container op, a user fn `/ Mutable`, a HOF carrying `Mutable` from its
# callback — flows through the same per-argument rule.
fn call_demand_is_local(callee: Expr, args_: [Expr], sc: MutScan) : Bool {
  let callee_ty = match callee.ty { Some(t) -> t  None -> TyAny }
  if not (ty_callee_has_mutable(callee_ty) or callee_is_mutable_op(callee)) { true }
  else if callee_is_opaque(callee, sc.opaque) { false }
  else { match demand_target(callee, args_, sc) { None -> true  Some(_) -> false } }
}


# The first `Mutable` demand in `e` whose mutation the caller could observe,
# or None when every demand is local. A loop intrinsic's lambdas are walked
# like any other child.
#[doc("Typer-internal helper `external_demand` shared across the infer modules.")]
pub fn external_demand(e: Expr, sc: MutScan) : Option[Expr] = match e.kind {
  ECall(callee, args_) ->
    if not call_demand_is_local(callee, args_, sc) { Some(e) }
    else { match external_demand(callee, sc) {
      None  -> external_demand_in_args(args_, sc)
      found -> found
    } }
  EPipe(a, b) -> external_demand(pipe_as_call(a, b), sc)
  _           -> external_demand_in_positions(xp_positions(e), sc)
}


fn external_demand_in_positions(ps: [XPos], sc: MutScan) : Option[Expr] = match ps {
  []                  -> None
  [XP(_, c), ...rest] -> match external_demand(c, sc) {
    None  -> external_demand_in_positions(rest, sc)
    found -> found
  }
}


# Reached only once the call passed the carrier-locality check, so a lambda
# argument's params inherit the locality proven at this site (the
# `foldl(xs, new(), \b -> mutate(b))` thread): a shared init would have
# made the call itself the external demand.
fn external_demand_in_args(es: [Expr], sc: MutScan) : Option[Expr] = match es {
  []           -> None
  [h, ...rest] -> {
    let found = match h.kind {
      ELambda(ps, body) -> external_demand(body, MutScan { ...sc, locals: mut_collect_param_ids(ps, sc.locals) })
      _                 -> external_demand(h, sc)
    }
    match found {
      None -> external_demand_in_args(rest, sc)
      _    -> found
    }
  }
}


#[doc("Typer-internal helper `check_record_lit_fields` shared across the infer modules.")]
pub fn check_record_lit_fields(st: InferState, rsym: SymId, fis: [FieldInit], fields: [FTy],
                           line: Int, col: Int) : InferState / Console + File {
  let given = map(fis, (fi) => match fi { FI(fnm, _) -> fnm })
  foldl(record_lit_field_errors(written_text(decl_name(st.env.tab, rsym)), given, fty_names(fields)), st, (s, msg) => {
    let perr = mk_diag(SevError, s.file, line, col, msg, [])
    render_diag(perr)
    st_bump_err(st_push_diag(s, perr))
  })
}


# Lower a `4.50<USD>` / `42<sec>`-style numeric UoM literal into an inline
# `Decimal { raw, scale }` when the context expects `Decimal<u>`. The
# literal is minted from its source digits, so the written scale survives
# (`10.50<USD>` is scale 2); the scale of an arithmetic result is the
# operation's to define. On a unit mismatch the AST is left alone and the
# unifier reports it.
fn try_lower_decimal_uom_lit(value: Expr, expected: Ty, bh: String) : Expr {
  match expected {
    TyDimT(TyCon(dsym, _), u_field) -> match value.kind {
      ELitUnit(inner, u_lit) ->
        if ty_is(dsym, CdDecimal) and inf_unit_eq(u_lit, u_field) {
          let dec = TyCon(dsym, [])
          match mint_literal(inner, dec, bh) {
            MintOk(e) -> with_ty(e, TyDimT(dec, unit_canon(u_field)))
            _ -> value
          }
        } else { value }
      _ -> value
    }
    _ -> value
  }
}


# Same rewrite, threading the resulting type back to the caller so
# downstream unify sees equal types. Returned ty is the input
# `value_ty` when no rewrite applies, otherwise the lowered
# `Decimal<u>` shape.
#[doc("Typer-internal helper `maybe_lower_decimal_lit` shared across the infer modules.")]
pub fn maybe_lower_decimal_lit(value: Expr, value_ty: Ty, expected: Ty, bh: String) : ExprTy {
  let rewritten = try_lower_decimal_uom_lit(value, expected, bh)
  let new_ty = match rewritten.ty { Some(t) -> t None -> value_ty }
  ExprTy { expr: rewritten, ty: new_ty }
}


#[doc("Typer-internal type `ExprTy` shared across the infer modules.")]
pub type ExprTy = { expr: Expr, ty: Ty }


#[doc("Typer-internal type `MintedExpr` shared across the infer modules.")]
pub type MintedExpr = { st: InferState, pair: ExprTy }


# Coin a numeric literal to a concrete carrier resolved from context.
# `expected` must already be `apply_ty`-resolved: a concrete carrier
# mints (or errors on overflow / shape mismatch); a type variable falls
# through to the Decimal-with-unit lowering and then the shape default,
# so unification stays the authority and principality is preserved.
#[doc("Typer-internal helper `maybe_mint_literal` shared across the infer modules.")]
pub fn maybe_mint_literal(st: InferState, value: Expr, value_ty: Ty, expected: Ty,
                      line: Int, col: Int) : MintedExpr / Console + File + Mutable {
  match mint_literal(value, expected, mint_bigint_home(st.env)) {
    MintOk(e2) -> {
      let new_ty = match e2.ty { Some(t) -> t None -> value_ty }
      MintedExpr { st: st, pair: ExprTy { expr: e2, ty: new_ty } }
    }
    MintErr(msg) -> {
      let perr = mk_diag(SevError, st.file, line, col, msg, [])
      render_diag(perr)
      MintedExpr { st: st_bump_err(st_push_diag(st, perr)), pair: ExprTy { expr: value, ty: value_ty } }
    }
    MintNone -> MintedExpr { st: st, pair: maybe_lower_decimal_lit(value, value_ty, expected, mint_bigint_home(st.env)) }
  }
}


#[doc("Typer-internal helper `rf_keep_result` shared across the infer modules.")]
pub fn rf_keep_result(want: Ty, have: Ty) : Ty = match want {
  TyFnT(ps, _, row) -> match have {
    TyFnT(_, r, _) -> TyFnT(ps, r, row)
    _              -> want
  }
  _ -> want
}


# The type a declaration defines, with its parameters and
# the types its values hold, so variance reads the definition.
#[doc("Typer-internal helper `st_ty_defs` shared across the infer modules.")]
pub fn st_ty_defs(st: InferState) : (SymId) -> [TyDef] =
  (s) => list_append(rec_defs_of(st.recs, s), sum_defs_of(st.sums, s))


fn rec_defs_of(rs: [RecInfo], s: SymId) : [TyDef] = match rs {
  [] -> []
  [RI(n, tps, fs, _), ...rest] ->
    if sym_same(n, s) { [TyDef(tps, map(fs, (f) => match f { FD(_, _, te, _) -> te })), ...rec_defs_of(rest, s)] }
    else { rec_defs_of(rest, s) }
}


fn sum_defs_of(ss: [SumInfo], s: SymId) : [TyDef] = match ss {
  [] -> []
  [SI(n, tps, vs, _), ...rest] ->
    if sym_same(n, s) { [TyDef(tps, flat_map(vs, (v) => match v { Var(_, args_) -> args_ })), ...sum_defs_of(rest, s)] }
    else { sum_defs_of(rest, s) }
}


# A refinement predicate belongs to a type: the one binder it is sure
# to read is its own `self`.
#[doc("Typer-internal helper `rv_pred_text` shared across the infer modules.")]
pub fn rv_pred_text(tab: SymTab, p: Expr) : String = refine_pred_text(p, tab, ln_empty())


# A call's type variables keep the refinements its arguments bring,
# joined where several meet, and each argument flows into its
# parameter only where variance allows.
#[doc("Typer-internal type `RefCall` shared across the infer modules.")]
pub type RefCall = RefCall(InferState, Ty)


# `rc_mentions` through the substitution, without applying it.
#[doc("Typer-internal helper `rc_mentions_in` shared across the infer modules.")]
pub fn rc_mentions_in(s: Subst, t: Ty) : Bool = match t {
  TyRefineT(_, _)       -> true
  TyVarT(v)             -> match subst_lookup(s, v) {
    Some(b) -> rc_mentions_in(s, b)
    None    -> false
  }
  TyListT(x)            -> rc_mentions_in(s, x)
  TyCon(_, args_)       -> rc_any_mentions_in(s, args_)
  TyFnT(ps, r, _)       -> rc_mentions_in(s, r) or rc_any_mentions_in(s, ps)
  _                     -> false
}


#[doc("Typer-internal helper `rc_any_mentions_in` shared across the infer modules.")]
pub fn rc_any_mentions_in(s: Subst, ts: [Ty]) : Bool = match ts {
  [] -> false
  [t, ...rest] -> rc_mentions_in(s, t) or rc_any_mentions_in(s, rest)
}


#[doc("Typer-internal helper `expr_tail` shared across the infer modules.")]
pub fn expr_tail(e: Expr) : Expr = match e.kind {
  EBlock(_, Some(t)) -> expr_tail(t)
  _                  -> e
}


#[doc("Typer-internal helper `callee_label` shared across the infer modules.")]
pub fn callee_label(st: InferState, c: Expr) : String = match c.kind {
  EName(n)       -> " of `#{n}`"
  EModCall(_, n) -> " of `#{n}`"
  ESym(s, _)     -> " of `#{decl_name(st.env.tab, s)}`"
  ELocal(l)      -> " of `#{st_local_text(st, l)}`"
  _              -> ""
}


# The name the local `l` was bound with, for a diagnostic.
#[doc("Typer-internal helper `st_local_text` shared across the infer modules.")]
pub fn st_local_text(st: InferState, l: LocalId) : Written = local_text_in(st.env.entries, l)


fn local_text_in(es: [TyEntry], l: LocalId) : Written = match es {
  [] -> written("")
  [e, ...rest] -> match e.key {
    KLocal(b) -> if local_eq(b.id, l) { b.name } else { local_text_in(rest, l) }
    _         -> local_text_in(rest, l)
  }
}


# The names a diagnostic printing an expression needs: every local in scope.
#[doc("Typer-internal helper `st_local_names` shared across the infer modules.")]
pub fn st_local_names(st: InferState) : LocalNames =
  foldl(st.env.entries, ln_empty(), (ns, en) => match en.key {
    KLocal(b) -> ln_with_binder(ns, b)
    _         -> ns
  })


# Where a join widened a type variable, so a later mismatch names it.
#[doc("Typer-internal helper `widened_note` shared across the infer modules.")]
pub fn widened_note(args_: [Expr], binds: [RvBind]) : String = match nth(args_, rv_widened_at(binds)) {
  Some(a) -> concat_all(["; the type parameter lost that refinement where argument ", int_to_string(rv_widened_at(binds) + 1),
                         " (line ", int_to_string(a.line), ", col ", int_to_string(a.col), ") brought a wider one"])
  None    -> ""
}


#[doc("Typer-internal helper `list_any_may_owe` shared across the infer modules.")]
pub fn list_any_may_owe(ts: [Ty]) : Bool = match ts {
  [] -> false
  [t, ...rest] -> rc_may_owe(t) or list_any_may_owe(rest)
}


#[doc("Typer-internal helper `list_any_lambda` shared across the infer modules.")]
pub fn list_any_lambda(xs: [Expr]) : Bool = match xs {
  [] -> false
  [x, ...rest] -> match x.kind {
    ELambda(_, _) -> true
    _             -> list_any_lambda(rest)
  }
}


# Only a function type's return can owe a refinement through a lambda
# argument; any other parameter type is left to the callee.
#[doc("Typer-internal helper `fn_ret_only` shared across the infer modules.")]
pub fn fn_ret_only(t: Ty) : Ty = match t {
  TyFnT(_, _, _) -> t
  _              -> TyAny
}


# The constructor a typed callee names, as a diagnostic spells it.
#[doc("Typer-internal helper `callee_ctor_name` shared across the infer modules.")]
pub fn callee_ctor_name(tab: SymTab, callee: Expr) : Option[Written] = match callee.kind {
  ESym(s, _) -> if inf_is_ctor(tab, s) { Some(sym_name(tab, s)) } else { None }
  _          -> None
}


#[doc("Typer-internal helper `callee_is_ctor` shared across the infer modules.")]
pub fn callee_is_ctor(tab: SymTab, callee: Expr) : Bool = match callee_ctor_name(tab, callee) {
  Some(_) -> true
  None    -> false
}


#[doc("Typer-internal helper `inf_is_ctor` shared across the infer modules.")]
pub fn inf_is_ctor(tab: SymTab, s: SymId) : Bool = st_valid(tab, s) and ncls_same(sym_class(tab, s), NCCtor)


#[doc("Typer-internal helper `typed_ty_or` shared across the infer modules.")]
pub fn typed_ty_or(e: Expr, fallback: Ty) : Ty = match e.ty {
  Some(t) -> t
  None    -> fallback
}


#[doc("Typer-internal helper `field_what` shared across the infer modules.")]
pub fn field_what(fnm: String) : String = string_concat("record field '", string_concat(fnm, "'"))


#[doc("Typer-internal helper `binding_what` shared across the infer modules.")]
pub fn binding_what(pat: Pattern, fallback: String) : String = match pat.pkind {
  PBind(b) -> concat_all(["binding `", if pat_is_var_ann(pat) { var_ann_cell(b) } else { written_text(b.name) }, "`"])
  _        -> fallback
}


#[doc("Typer-internal helper `synth_mint_decimal` shared across the infer modules.")]
pub fn synth_mint_decimal(st: InferState, e: Expr) : Inferred / Console + File + Mutable {
  let dec = TyCon(core_decl_ty_id(CdDecimal), [])
  match mint_literal(e, dec, mint_bigint_home(st.env)) {
    MintOk(e2) -> {
      let ty = match e2.ty { Some(t) -> t None -> dec }
      mk_inferred(st, ty, e2)
    }
    MintErr(msg) -> {
      let perr = mk_diag(SevError, st.file, e.line, e.col, msg, [])
      render_diag(perr)
      mk_inferred(st_bump_err(st_push_diag(st, perr)), dec, e)
    }
    MintNone -> {
      let perr = mk_diag(SevError, st.file, e.line, e.col, "numeric literal has no concrete type in context", [])
      render_diag(perr)
      mk_inferred(st_bump_err(st_push_diag(st, perr)), dec, e)
    }
  }
}

