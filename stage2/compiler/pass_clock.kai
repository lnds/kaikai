#[doc("The per-pass clock: with `KAI_PASS_CLOCK` set, the driver prints the monotonic clock after each pass.")]

#[doc("A reading of the monotonic clock, in the shape the runtime hands back.")]
pub type PassInstant = { secs: Int, nanos: Int }

#[doc("The monotonic clock, bridged to the runtime's own entry so that no module outside the compiler is imported.")]
pub effect PassClock {
  mono() : PassInstant

  default {
    mono(resume) -> $extern_handler("kai_default_clock_monotonic_now")
  }
}

#[doc("`v`, once the monotonic clock has been printed under `label` when `KAI_PASS_CLOCK` is set.")]
pub(pkg) fn pass_tick(label: String, v: a) : a / PassClock + Env + Console =
  match Env.get("KAI_PASS_CLOCK") {
    None -> v
    Some(_) -> {
      let t = PassClock.mono()
      eprint("pass-clock #{label} #{t.secs * 1000000000 + t.nanos}")
      v
    }
  }
