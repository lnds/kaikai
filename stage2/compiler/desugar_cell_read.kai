#[doc("Reads and writes of a cell lowered to nodes naming the cell's binder, and the veto on a cell escaping through a closure.")]

import compiler.ast_build
import compiler.ast_ids
import compiler.desugar_escape
import compiler.util
import compiler.diag
import compiler.ast
import compiler.written
import compiler.desugar_rename
import compiler.desugar_cell_access
import compiler.desugar_brand

#[doc("`e` with each read and write of a cell of `caps` lowered to a node naming that cell's binder.")]
pub(pkg) fn lcr_expr(e: Expr, caps: [CapScope], reject_at: Bool, file: String, errs: Int) : VLExpr / Console + File {

  let r = lcr_kind(e.kind, caps, reject_at, e.line, e.col, file, errs)
  VLExpr { expr: Expr { kind: r.expr.kind, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site },
           errs: r.errs }
}

fn lcr_opt(o: Option[Expr], caps: [CapScope], reject_at: Bool, file: String, errs: Int) : VLOpt / Console + File {

  match o {
    Some(e) -> { let r = lcr_expr(e, caps, reject_at, file, errs)
                 VLOpt { opt: Some(r.expr), errs: r.errs } }
    None    -> VLOpt { opt: None, errs: errs }
  }
}

fn lcr_exprs(es: [Expr], caps: [CapScope], reject_at: Bool, file: String, errs: Int) : VLExprs / Console + File {

  match es {
    [] -> VLExprs { exprs: [], errs: errs }
    [h, ...rest] -> {
      let r1 = lcr_expr(h, caps, reject_at, file, errs)
      let r2 = lcr_exprs(rest, caps, reject_at, file, r1.errs)
      VLExprs { exprs: [r1.expr, ...r2.exprs], errs: r2.errs }
    }
  }
}

fn lcr_elems(les: [ListElem], caps: [CapScope], reject_at: Bool, file: String, errs: Int) : VLElems / Console + File {

  match les {
    [] -> VLElems { elems: [], errs: errs }
    [h, ...rest] -> {
      let r1 = match h {
        ElPlain(e)  -> { let r = lcr_expr(e, caps, reject_at, file, errs)
                         VLExpr { expr: r.expr, errs: r.errs } }
        ElSpread(e) -> { let r = lcr_expr(e, caps, reject_at, file, errs)
                         VLExpr { expr: r.expr, errs: r.errs } }
      }
      let wrapped = match h { ElPlain(_) -> ElPlain(r1.expr)  ElSpread(_) -> ElSpread(r1.expr) }
      let r2 = lcr_elems(rest, caps, reject_at, file, r1.errs)
      VLElems { elems: [wrapped, ...r2.elems], errs: r2.errs }
    }
  }
}

fn lcr_fields(fs: [FieldInit], caps: [CapScope], reject_at: Bool, file: String, errs: Int) : VLFields / Console + File {

  match fs {
    [] -> VLFields { fields: [], errs: errs }
    [FI(nm, v), ...rest] -> {
      let r1 = lcr_expr(v, caps, reject_at, file, errs)
      let r2 = lcr_fields(rest, caps, reject_at, file, r1.errs)
      VLFields { fields: [FI(nm, r1.expr), ...r2.fields], errs: r2.errs }
    }
  }
}

fn lcr_arms(arms: [Arm], caps: [CapScope], reject_at: Bool, file: String, errs: Int) : VLArms / Console + File {

  match arms {
    [] -> VLArms { arms: [], errs: errs }
    [Arm(p, g, b), ...rest] -> {
      let names = dsg_rename_pat_names(p, [])
      let caps1 = caps_minus_names(caps, names)
      let rg = lcr_opt(g, caps1, reject_at, file, errs)
      let rb = lcr_expr(b, caps1, reject_at, file, rg.errs)
      let r2 = lcr_arms(rest, caps, reject_at, file, rb.errs)
      VLArms { arms: [Arm(p, rg.opt, rb.expr), ...r2.arms], errs: r2.errs }
    }
  }
}

fn lcr_clauses(cs: [HClause], caps: [CapScope], reject_at: Bool, file: String, errs: Int) : VLClauses / Console + File {

  match cs {
    [] -> VLClauses { clauses: [], errs: errs }
    [HC(nm, ps, b, l, c), ...rest] -> {
      let pnames = dsg_rename_param_names(ps, [])
      let rb = lcr_expr(b, caps_minus_names(caps, pnames), reject_at, file, errs)
      let r2 = lcr_clauses(rest, caps, reject_at, file, rb.errs)
      VLClauses { clauses: [HC(nm, ps, rb.expr, l, c), ...r2.clauses], errs: r2.errs }
    }
  }
}

fn cap_is_cell(caps: [CapScope], n: String) : Bool = match caps_find(caps, n) {
  Some(CsCell(_)) -> true
  _               -> false
}

# `@x`, the operand `x` of a `MkDeref` call. A `var`/`State`/`Reader` cell
# reads naked and is not a `Ref`, so `@` on one is rejected; any other
# operand stays for the typer to read by its type.
fn lcr_deref(callee: Expr, x: Expr, caps: [CapScope], reject_at: Bool, line: Int, col: Int, file: String, errs: Int) : VLExpr / Console + File = match x.kind {
  EName(w) -> {
    let n = written_text(w)
    if cap_is_cell(caps, n) {
      diag_error(file, line, col, concat_all([
        "`@", n, "` is not how a `var` cell is read — read it naked, as `", n, "`"
      ]))
      diag_help(concat_all([
        "`@` dereferences a first-class `Ref[T]`; a `var`/`State`/`Reader` cell is block-local and reads without `@`"
      ]))
      VLExpr { expr: mk_expr(ECall(callee, [x]), line, col), errs: errs + 1 }
    } else {
      VLExpr { expr: mk_expr(ECall(callee, [x]), line, col), errs: errs }
    }
  }
  _ -> {
    let r = lcr_expr(x, caps, reject_at, file, errs)
    VLExpr { expr: mk_expr(ECall(callee, [r.expr]), line, col), errs: r.errs }
  }
}

fn lcr_kind(k: ExprKind, caps: [CapScope], reject_at: Bool, line: Int, col: Int, file: String, errs: Int) : VLExpr / Console + File {

  match k {
    EName(w) -> match caps_find(caps, written_text(w)) {
      Some(CsCell(b)) -> VLExpr { expr: mk_expr(mk_cell_get(b.id, line, col), line, col), errs: errs }
      Some(CsCap(b))  -> VLExpr { expr: mk_local(b.id, line, col), errs: errs }
      None            -> VLExpr { expr: mk_name(written_text(w), line, col), errs: errs }
    }
    ESym(_, _) -> VLExpr { expr: mk_expr(k, line, col), errs: errs }
    ECall(callee, args_) -> lcr_call(k, callee, args_, caps, reject_at, line, col, file, errs)
    EBlock(stmts, tail) -> {
      let r = lcr_block(stmts, tail, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EBlock(r.stmts, r.opt), line, col), errs: r.errs }
    }
    ELambda(ps, body) -> {
      let pnames = dsg_rename_param_names(ps, [])
      let r = lcr_expr(body, caps_minus_names(caps, pnames), reject_at, file, errs)
      VLExpr { expr: mk_expr(ELambda(ps, r.expr), line, col), errs: r.errs }
    }
    EMatch(scr, arms) -> {
      let rs = lcr_expr(scr, caps, reject_at, file, errs)
      let ra = lcr_arms(arms, caps, reject_at, file, rs.errs)
      VLExpr { expr: mk_expr(EMatch(rs.expr, ra.arms), line, col), errs: ra.errs }
    }
    EHandle(body, eff, tys, init_opt, alias_opt, clauses, ret_opt) ->
      lcr_handle(body, eff, tys, init_opt, alias_opt, clauses, ret_opt, caps, reject_at, line, col, file, errs)
    EField(base, nm) -> {
      let r = lcr_expr(base, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EField(r.expr, nm), line, col), errs: r.errs }
    }
    EIndex(b, i) -> {
      let r1 = lcr_expr(b, caps, reject_at, file, errs)
      let r2 = lcr_expr(i, caps, reject_at, file, r1.errs)
      VLExpr { expr: mk_expr(EIndex(r1.expr, r2.expr), line, col), errs: r2.errs }
    }
    EBinop(op, a, b) -> {
      let r1 = lcr_expr(a, caps, reject_at, file, errs)
      let r2 = lcr_expr(b, caps, reject_at, file, r1.errs)
      VLExpr { expr: mk_expr(EBinop(op, r1.expr, r2.expr), line, col), errs: r2.errs }
    }
    EUnop(op, x) -> {
      let r = lcr_expr(x, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EUnop(op, r.expr), line, col), errs: r.errs }
    }
    EIf(c, t_, eo) -> {
      let r1 = lcr_expr(c, caps, reject_at, file, errs)
      let r2 = lcr_expr(t_, caps, reject_at, file, r1.errs)
      let r3 = lcr_opt(eo, caps, reject_at, file, r2.errs)
      VLExpr { expr: mk_expr(EIf(r1.expr, r2.expr, r3.opt), line, col), errs: r3.errs }
    }
    EList(elems) -> {
      let r = lcr_elems(elems, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EList(r.elems), line, col), errs: r.errs }
    }
    EPipe(a, b) -> {
      let r1 = lcr_expr(a, caps, reject_at, file, errs)
      let r2 = lcr_expr(b, caps, reject_at, file, r1.errs)
      VLExpr { expr: mk_expr(EPipe(r1.expr, r2.expr), line, col), errs: r2.errs }
    }
    EDispatchPipe(op, a, b) -> {
      let r1 = lcr_expr(a, caps, reject_at, file, errs)
      let r2 = lcr_expr(b, caps, reject_at, file, r1.errs)
      VLExpr { expr: mk_expr(EDispatchPipe(op, r1.expr, r2.expr), line, col), errs: r2.errs }
    }
    ERange(a, b, opt_step) -> {
      let r1 = lcr_expr(a, caps, reject_at, file, errs)
      let r2 = lcr_expr(b, caps, reject_at, file, r1.errs)
      let r3 = lcr_opt(opt_step, caps, reject_at, file, r2.errs)
      VLExpr { expr: mk_expr(ERange(r1.expr, r2.expr, r3.opt), line, col), errs: r3.errs }
    }
    ERecordLit(rh, fields) -> {
      let r = lcr_fields(fields, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(ERecordLit(rh, r.fields), line, col), errs: r.errs }
    }
    EBang(inner) -> {
      let r = lcr_expr(inner, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EBang(r.expr), line, col), errs: r.errs }
    }
    ELitUnit(inner, u) -> {
      let r = lcr_expr(inner, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(ELitUnit(r.expr, u), line, col), errs: r.errs }
    }
    # A loop intrinsic's lambdas read cells like any eagerly-applied
    # closure; the post-interp relower must reach the reads the interp
    # lift plants inside them.
    EIntrinsic(nm, args_) -> {
      let r = lcr_exprs(args_, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EIntrinsic(nm, r.exprs), line, col), errs: r.errs }
    }
    _ -> VLExpr { expr: mk_expr(k, line, col), errs: errs }
  }
}

fn lcr_call(k: ExprKind, callee: Expr, args_: [Expr], caps: [CapScope], reject_at: Bool, line: Int, col: Int,
            file: String, errs: Int) : VLExpr / Console + File = match callee.kind {
  EMark(MkDeref) -> match args_ {
    [x] -> lcr_deref(callee, x, caps, reject_at, line, col, file, errs)
    _   -> VLExpr { expr: mk_expr(k, line, col), errs: errs }
  }
  # `n := v` on a cell is the cell's write; on anything else it stays for the typer.
  EMark(MkCellSet) -> match args_ {
    [target, v] -> lcr_cell_set(callee, target, v, caps, reject_at, line, col, file, errs)
    _           -> VLExpr { expr: mk_expr(k, line, col), errs: errs }
  }
  # A var's slot: every late read of the var is sent to it by the
  # enclosing block, so it becomes the allocation it stood for.
  EMark(MkVarSlot(_, _)) -> {
    let ra = lcr_exprs(args_, caps, reject_at, file, errs)
    VLExpr { expr: mk_expr(var_slot_call(k, ra.exprs), line, col), errs: ra.errs }
  }
  # Already lowered: the operands are the cell's binder and the value written.
  EMark(MkCellGet) -> VLExpr { expr: mk_expr(k, line, col), errs: errs }
  EMark(MkCellPut) -> {
    let ra = lcr_exprs(args_, caps, reject_at, file, errs)
    VLExpr { expr: mk_expr(ECall(callee, ra.exprs), line, col), errs: ra.errs }
  }
  EField(base, fname) -> match base.kind {
    # An op called on a cell by name: only the args recurse. The base would
    # re-lower to a read of the cell and yield a call on the value read.
    EName(w) -> match caps_find(caps, written_text(w)) {
      Some(c) -> {
        let ra = lcr_exprs(args_, caps, reject_at, file, errs)
        VLExpr { expr: mk_expr(ECall(mk_expr(EField(mk_local(cs_binder(c).id, base.line, base.col), fname), callee.line, callee.col), ra.exprs), line, col), errs: ra.errs }
      }
      None -> lcr_call_plain(callee, args_, caps, reject_at, line, col, file, errs)
    }
    _ -> lcr_call_plain(callee, args_, caps, reject_at, line, col, file, errs)
  }
  _ -> lcr_call_plain(callee, args_, caps, reject_at, line, col, file, errs)
}

fn lcr_call_plain(callee: Expr, args_: [Expr], caps: [CapScope], reject_at: Bool, line: Int, col: Int,
                  file: String, errs: Int) : VLExpr / Console + File = {
  let rc = lcr_expr(callee, caps, reject_at, file, errs)
  let ra = lcr_exprs(args_, caps, reject_at, file, rc.errs)
  VLExpr { expr: mk_expr(ECall(rc.expr, ra.exprs), line, col), errs: ra.errs }
}

fn lcr_cell_set(callee: Expr, target: Expr, v: Expr, caps: [CapScope], reject_at: Bool, line: Int, col: Int,
                file: String, errs: Int) : VLExpr / Console + File = {
  let rv = lcr_expr(v, caps, reject_at, file, errs)
  match target.kind {
    EName(w) -> match caps_find(caps, written_text(w)) {
      Some(CsCell(b)) -> VLExpr { expr: mk_expr(mk_cell_put(b.id, rv.expr, line, col), line, col), errs: rv.errs }
      _               -> VLExpr { expr: mk_expr(ECall(callee, [target, rv.expr]), line, col), errs: rv.errs }
    }
    _ -> {
      let rt = lcr_expr(target, caps, reject_at, file, rv.errs)
      VLExpr { expr: mk_expr(ECall(callee, [rt.expr, rv.expr]), line, col), errs: rt.errs }
    }
  }
}

fn lcr_handle(body: Expr, eff: DeclRef, tys: [TypeExpr], init_opt: Option[Expr], alias_opt: Option[Binder],
              clauses: [HClause], ret_opt: Option[HReturn], caps: [CapScope], reject_at: Bool, line: Int, col: Int,
              file: String, errs: Int) : VLExpr / Console + File = {
  let alias1 = alias_numbered(alias_opt, "__alias", line, col)
  let ri = lcr_opt(init_opt, caps, reject_at, file, errs)
  let rb = lcr_expr(body, lcr_handle_caps(eff, alias1, caps), reject_at, file, ri.errs)
  # A `with Eff as a` capability — a cell or a named instance — may not
  # outlive the handle that installed it: its evidence node is torn
  # down at the closing brace.
  let esc = match alias1 {
    Some(a) -> lcr_escape_in_value(rb.expr, a, file)
    None    -> 0
  }
  let rc = lcr_clauses(clauses, caps, reject_at, file, rb.errs + esc)
  match ret_opt {
    Some(HR(p, rbody, hl, hc)) -> {
      let rr = lcr_expr(rbody, caps_remove_name(caps, written_text(p.name)), reject_at, file, rc.errs)
      VLExpr { expr: mk_expr(EHandle(rb.expr, eff, tys, ri.opt, alias1, rc.clauses, Some(HR(p, rr.expr, hl, hc))), line, col), errs: rr.errs }
    }
    None -> VLExpr { expr: mk_expr(EHandle(rb.expr, eff, tys, ri.opt, alias1, rc.clauses, None), line, col), errs: rc.errs }
  }
}

# The binder a pass numbers before the resolver, keyed by where it is written, unless an earlier walk numbered it.
fn binder_numbered_at(b: Binder, what: String, line: Int, col: Int) : Binder =
  if local_raw(b.id) != 0 { b }
  else { binder_numbered(b, local_minted(concat_all([what, "@", int_to_string(line), ":", int_to_string(col)]))) }

fn alias_numbered(alias_opt: Option[Binder], what: String, line: Int, col: Int) : Option[Binder] =
  map(alias_opt, (a) => binder_numbered_at(a, what, line, col))

# The scope a handle's body sees: its alias shadows an outer name of the
# same spelling, and is a cell when the effect is one.
fn lcr_handle_caps(eff: DeclRef, alias_opt: Option[Binder], caps: [CapScope]) : [CapScope] = match alias_opt {
  Some(a) -> {
    let rest = caps_remove_name(caps, written_text(a.name))
    if eff_is_cell(ref_sym(eff)) { [CsCell(a), ...rest] } else { [CsCap(a), ...rest] }
  }
  None -> caps
}

fn lcr_block(stmts: [Stmt], tail: Option[Expr], caps: [CapScope], reject_at: Bool, file: String, errs: Int) : VLStmts / Console + File {

  match stmts {
    [] -> { let r = lcr_opt(tail, caps, reject_at, file, errs)
            VLStmts { stmts: [], opt: r.opt, errs: r.errs } }
    [s, ...rest] -> match s {
      SLet(p, ann, rhs) -> {
        let r = lcr_expr(rhs, caps, reject_at, file, errs)
        let names = dsg_rename_pat_names(p, [])
        match var_slot_of(p, rhs) {
          Some(VarSlot(cell, slot)) -> {
            # A var lowered to a slot: a read of it surfacing only now, from
            # an interpolation, lowers to a read of the cell and then to the slot.
            let r2 = lcr_block(rest, tail, [CsCell(cell), ...caps_minus_names(caps, names)], reject_at, file, r.errs)
            let body = specialise_body(cell.id, slot.id, mk_expr(EBlock(r2.stmts, r2.opt), rhs.line, rhs.col))
            match body.kind {
              EBlock(ss, t) -> VLStmts { stmts: [SLet(p, ann, r.expr), ...ss], opt: t, errs: r2.errs }
              _             -> VLStmts { stmts: [SLet(p, ann, r.expr), ...r2.stmts], opt: r2.opt, errs: r2.errs }
            }
          }
          None -> {
            let r2 = lcr_block(rest, tail, caps_minus_names(caps, names), reject_at, file, r.errs)
            VLStmts { stmts: [SLet(p, ann, r.expr), ...r2.stmts], opt: r2.opt, errs: r2.errs }
          }
        }
      }
      SVar(b0, ty, rhs, l, c) -> {
        let b = binder_numbered_at(b0, "__cell", l, c)
        # The init runs under the *outer* caps (`var n := n` self-shadows
        # only after the binder, F# / Rust convention).
        let r = lcr_expr(rhs, caps, reject_at, file, errs)
        let caps1 = [CsCell(b), ...caps_remove_name(caps, written_text(b.name))]
        let r2 = lcr_block(rest, tail, caps1, reject_at, file, r.errs)
        # `rest` + `tail` is exactly the block the var's `State[n]`
        # handler wraps. Reject a closure that reads/writes `n` and whose
        # value reaches the block's exit (tail / returned / stored) — the
        # handler is gone by the time such a closure could run.
        let esc = lcr_escape_check(r2.stmts, r2.opt, b, file)
        VLStmts { stmts: [SVar(b, ty, r.expr, l, c), ...r2.stmts], opt: r2.opt, errs: r2.errs + esc }
      }
      SExprStmt(x) -> {
        let r = lcr_expr(x, caps, reject_at, file, errs)
        let r2 = lcr_block(rest, tail, caps, reject_at, file, r.errs)
        VLStmts { stmts: [SExprStmt(r.expr), ...r2.stmts], opt: r2.opt, errs: r2.errs }
      }
      SIndexAssign(b, i, v, l, c) -> {
        let r1 = lcr_expr(b, caps, reject_at, file, errs)
        let r2 = lcr_expr(i, caps, reject_at, file, r1.errs)
        let r3 = lcr_expr(v, caps, reject_at, file, r2.errs)
        let r4 = lcr_block(rest, tail, caps, reject_at, file, r3.errs)
        VLStmts { stmts: [SIndexAssign(r1.expr, r2.expr, r3.expr, l, c), ...r4.stmts], opt: r4.opt, errs: r4.errs }
      }
      SAssign(b, v, l, c) -> {
        let r1 = lcr_expr(b, caps, reject_at, file, errs)
        let r3 = lcr_expr(v, caps, reject_at, file, r1.errs)
        let r4 = lcr_block(rest, tail, caps, reject_at, file, r3.errs)
        VLStmts { stmts: [SAssign(r1.expr, r3.expr, l, c), ...r4.stmts], opt: r4.opt, errs: r4.errs }
      }
      SAssert(c, m) -> {
        let r1 = lcr_expr(c, caps, reject_at, file, errs)
        let r2 = lcr_opt(m, caps, reject_at, file, r1.errs)
        let r3 = lcr_block(rest, tail, caps, reject_at, file, r2.errs)
        VLStmts { stmts: [SAssert(r1.expr, r2.opt), ...r3.stmts], opt: r3.opt, errs: r3.errs }
      }
      SUse(nm, l, c) -> {
        let r = lcr_block(rest, tail, caps, reject_at, file, errs)
        VLStmts { stmts: [SUse(nm, l, c), ...r.stmts], opt: r.opt, errs: r.errs }
      }
    }
  }
}
