#[doc("Compile stages that lower surface forms before the resolver: regions, protocols and string interpolation.")]

import compiler.ast_decl
import compiler.verdicts
import compiler.ast
import compiler.real_lit
import compiler.written
import compiler.symtab
import compiler.const_pattern
import compiler.resolve_env
import compiler.scope_view
import compiler.proto_resolve
import compiler.module_table
import compiler.import_unit
import compiler.driver_cli
import compiler.core_front
import compiler.bang_hoist
import compiler.region
import compiler.edition
import compiler.infer_glue
import compiler.infer_state
import compiler.diag_type_text
import compiler.interp_check
import compiler.resume_segment
import compiler.protos_registry
import compiler.protos
