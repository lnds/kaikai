  qh_vd: Verdict, qualtype_vd: Verdict, tab1: SymTab, cs_coll: [NEnt], rqc_fx: [RqcFx], vs_coll: [VSEntry], qualified_core: [Decl],
  missing_exports: [Diagnostic], pa_segs: [CoreSegment], type_name_coll: [Diagnostic], pub_access_vd: Verdict, fn_name_coll: [Diagnostic],
  effect_name_coll: [Diagnostic], const_name_coll: [Diagnostic], axiom_name_coll: [Diagnostic], kai_decl_vd: Verdict, tab2: SymTab,
  ref_pred_fns: [SymId], narrow_aliases: [SymId], tab3: SymTab, kind_ctx_a: KindCtx, kind_theories: [KindTheory], unit_ref_vd: Verdict,
  hab_decl_vd: Verdict, kind_home_vd: Verdict, shape_ref_vd: Verdict, nominal_row_diags: [Diagnostic], union_collision_vd: Verdict,
  constructor_uniq_vd: Verdict, variant_cap_vd: Verdict, extern_home_vd: Verdict, extern_fn_vd: Verdict, extern_type_diags: [Diagnostic],
  alias_res: AliasResolution, ta_table: [TAEntry], kind_ctx_b: KindCtx, post_alias_unit_vd: Verdict, pos_recs: [RecInfo],
  region_marks: [RegionMark], indexed: [Decl] }

