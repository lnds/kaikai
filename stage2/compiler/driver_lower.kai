pub(pkg) fn stage_region(req: Req, cx: Aliased) : Flow[Regioned] / Console + File + Mutable {
  let diag_ctx = cx.diag_ctx
  let raw_decls_with_regions = cx.raw_decls_with_regions
  # Opt-in Perceus regions. Unwrap the `region { }` markers
  # (`ECall(EMark(MkRegion), [block])`) the parser emitted, as
  # the FIRST post-parse rewrite — before any other desugar
  # pass can choke on the unusual "block as a call argument"
  # shape (a marker that survives into a pass whose match
  # assumes call args are non-blocks panics with
  # "non-exhaustive match"). Records the region side table
  # (`region_marks`, consumed by the emitter for arena
  # lowering + deep-copy-out at the block border) and replaces
  # each marker with its bare block, so every downstream pass +
  # the typer + both emitters see an ordinary block. Regions
  # lower to ordinary RC alloc, so selfhost stays
  # byte-identical for non-region code; the escape policy is
  # deep-copy-out at emit, not compile-time rejection, so this
  # rewrite emits no diagnostics. Lexical — no resolved binders.
  let region_rw = rewrite_regions_decls(raw_decls_with_regions, diag_ctx)
  let raw_decls = region_rw.decls
  let region_marks = region_rw.regions
  # Pre-resolve desugar of `a[i]` and `a[i] := v` into the
  # underlying array_get / array_set calls. Runs before name
  # resolution so every downstream pass sees only the core
  # form.
  # Pre-resolve desugar of `var name = init` into
  # `handle { rest } with State[T](init) as name { ... }`.
  # Runs after the index desugar so any `a[i]` inside a
  # `var`'s init or its rest-of-block has already been
  # lowered to a call.
  let indexed_decls = split_resume_decls(desugar_index_decls(raw_decls))
  Go(Regioned { json: cx.json, target_mod_name: cx.target_mod_name, roots: cx.roots, entry: cx.entry, own_tab: cx.own_tab, docs: cx.docs, doc_errs: cx.doc_errs, doc_decls: cx.doc_decls, import_hole_vd: cx.import_hole_vd, expanded: cx.expanded, tab0: cx.tab0, nsrcs: cx.nsrcs, npre: cx.npre, core_hit: cx.core_hit, prunes: cx.prunes, core_decls_whole: cx.core_decls_whole, surface_decls_whole: cx.surface_decls_whole, lib_mods: cx.lib_mods, pcut: cx.pcut, emptied: cx.emptied, gone: cx.gone, surface_decls: cx.surface_decls, core_segs: cx.core_segs, surface_fn_bounds: cx.surface_fn_bounds, import_resolve_vd: cx.import_resolve_vd, module_table: cx.module_table, diag_ctx: cx.diag_ctx, mod_tabs: cx.mod_tabs, mod_imps: cx.mod_imps, sel_imports: cx.sel_imports, sym_views: cx.sym_views, ts_coll: cx.ts_coll, ty_scope_vd: cx.ty_scope_vd, eff_scope_vd: cx.eff_scope_vd, pat_qual_vd: cx.pat_qual_vd, qh_vd: cx.qh_vd, qualtype_vd: cx.qualtype_vd, tab1: cx.tab1, cs_coll: cx.cs_coll, rqc_fx: cx.rqc_fx, vs_coll: cx.vs_coll, qualified_core: cx.qualified_core, missing_exports: cx.missing_exports, pa_segs: cx.pa_segs, type_name_coll: cx.type_name_coll, pub_access_vd: cx.pub_access_vd, fn_name_coll: cx.fn_name_coll, effect_name_coll: cx.effect_name_coll, const_name_coll: cx.const_name_coll, axiom_name_coll: cx.axiom_name_coll, kai_decl_vd: cx.kai_decl_vd, tab2: cx.tab2, ref_pred_fns: cx.ref_pred_fns, narrow_aliases: cx.narrow_aliases, tab3: cx.tab3, kind_ctx_a: cx.kind_ctx_a, kind_theories: cx.kind_theories, unit_ref_vd: cx.unit_ref_vd, hab_decl_vd: cx.hab_decl_vd, kind_home_vd: cx.kind_home_vd, shape_ref_vd: cx.shape_ref_vd, nominal_row_diags: cx.nominal_row_diags, union_collision_vd: cx.union_collision_vd, constructor_uniq_vd: cx.constructor_uniq_vd, variant_cap_vd: cx.variant_cap_vd, extern_home_vd: cx.extern_home_vd, extern_fn_vd: cx.extern_fn_vd, extern_type_diags: cx.extern_type_diags, alias_res: cx.alias_res, ta_table: cx.ta_table, kind_ctx_b: cx.kind_ctx_b, post_alias_unit_vd: cx.post_alias_unit_vd, pos_recs: cx.pos_recs, region_marks: region_marks, indexed: indexed_decls })
}

pub(pkg) fn stage_lower(req: Req, cx: Regioned) : Flow[Lowered] / Console + File + Mutable {
  let alias_res = cx.alias_res
  let axiom_name_coll = cx.axiom_name_coll
  let backend = req.backend
  let indexed = cx.indexed
  let const_name_coll = cx.const_name_coll
  let constructor_uniq_vd = cx.constructor_uniq_vd
  let core_mods = req.core_mods
  let diag_ctx = cx.diag_ctx
  let doc_errs = cx.doc_errs
  let docs = cx.docs
  let eff_scope_vd = cx.eff_scope_vd
  let effect_name_coll = cx.effect_name_coll
  let expanded = cx.expanded
  let extern_fn_vd = cx.extern_fn_vd
  let extern_home_vd = cx.extern_home_vd
  let extern_type_diags = cx.extern_type_diags
  let fn_name_coll = cx.fn_name_coll
  let hab_decl_vd = cx.hab_decl_vd
  let import_hole_vd = cx.import_hole_vd
  let import_resolve_vd = cx.import_resolve_vd
  let json = cx.json
  let kai_decl_vd = cx.kai_decl_vd
  let kind_home_vd = cx.kind_home_vd
  let missing_exports = cx.missing_exports
  let mod_imps = cx.mod_imps
  let mode = req.mode
  let module_table = cx.module_table
  let nominal_row_diags = cx.nominal_row_diags
  let pat_qual_vd = cx.pat_qual_vd
  let path = req.path
  let post_alias_unit_vd = cx.post_alias_unit_vd
  let pub_access_vd = cx.pub_access_vd
  let qh_vd = cx.qh_vd
  let qualtype_vd = cx.qualtype_vd
  let quiet = req.quiet
  let sel_imports = cx.sel_imports
  let shape_ref_vd = cx.shape_ref_vd
  let sym_views = cx.sym_views
  let tab3 = cx.tab3
  let target_mod_name = cx.target_mod_name
  let ty_scope_vd = cx.ty_scope_vd
  let type_name_coll = cx.type_name_coll
  let union_collision_vd = cx.union_collision_vd
  let unit_ref_vd = cx.unit_ref_vd
  let variant_cap_vd = cx.variant_cap_vd
  # `use Effect` desugar. Strips DUse / SUse and rewrites bare
  # `EName(op)` references into qualified
  # `EField(EName(eff), op)` form when the op belongs to an
  # effect open in scope. Runs after the index/var
  # desugars so SVar and SIndexAssign are already lowered;
  # runs before lower_protocols so protocol ops don't
  # conflict with effect ops in the open set.
  let post_use_decls = indexed
  # Lower protocols / impls / #[derive] into ordinary
  # top-level fns + a registry the post-inference rewrite
  # consumes. The registry-driven dispatch resolution runs
  # later, after `infer_program` populates `Expr.ty`.
  let lowered_whole = lower_protocols(post_use_decls, diag_ctx, target_mod_name,
                                core_mod_names(core_mods, []),
                                mod_imps,
                                PScope(tab3, sym_views, target_mod_name))
  let early_cut_on = is_some(cx.pcut)
  let tracked = early_cut_on or mode_checks_core_front(mode)
  let hold = if tracked {
    hold_core_impls(lowered_whole.decls, lowered_whole.reg, core_mod_names(core_mods, []), false, early_cut_on,
                    lowered_whole.origins, core_impl_syms(cx.core_decls_whole))
  } else { ImplHold { decls: lowered_whole.decls, held: [], emptied: [] } }
  let lowered = LoweredProtocols { ...lowered_whole, decls: hold.decls }
  if quiet { () } else {
    report_imports(ledger_note_derived(match expanded { EP_Mod(_, _, _, _, _, _, _, _, l, _) -> l }, lowered.minted, diag_ctx),
                   abspath(path))
  }
  # The dispatchers, lowered impl methods and derived functions
  # the lowering minted. The passes below take this binding, not
  # the same table read back out of a resolver result: `Mutable`
  # is masked only over a table this function built.
  let sym_tab = st_extend(tab3, lowered.rows)
  # Every `#{...}` hole still calls a mark: the protocols are
  # registered now, so each takes the `show` its home reaches.
  let interp_cores = core_mod_names(core_mods, [])
  # The protocol operations are the resolver's last rung: every
  # bare use, interpolations' included, reaches one through it.
  let callee_ops = proto_rungs(lowered.reg)
  let interp_dot_vd = vd_render(check_interp_dots(lowered.decls, diag_ctx))
  let interp_lifted = bang_hoist_decls(interp_show_decls(lowered.decls,
                                       proto_core_show(lowered.reg, interp_cores),
                                       interp_cores, target_mod_name))
  let root_picks = nt_picks_of(sel_imports, "", module_table)
  let early_const_uses = nu_scan_consts(interp_lifted, sym_tab, target_mod_name, root_picks)
  let interp_decls_pre = interp_lifted
  # Value-position const reads need no rewrite (a const IS a
  # value). The ONE ambiguous case is pattern position: a bare
  # const name parses as PVariant/PBind, so rewrite it to an
  # equality-guard arm (`__cv if __cv == NAME -> ...`).
  let pattern_consts = const_pattern_names(interp_decls_pre, sym_tab)
  let interp_decls_c = desugar_const_patterns_with(pattern_consts, interp_decls_pre)
  # Rewrite `lo..hi` interval patterns into a binder + comparison
  # guard, so the checker + lowering see a bind-with-guard arm
  # (refutable, catch-all still required) instead of a `PRange`.
  let interp_decls = desugar_range_patterns_decls(interp_decls_c)
  # Cap-binding nursery rewrite: expand `nursery { n -> body }`
  # by stripping `n` from the lambda param list and
  # rewriting `n.<spawn|await|select|cancel|...>` inside
  # `body` to `Spawn.<op>`. Mints a fresh BrandId per
  # nursery scope; the resulting `[BrandRec]` is the
  # registry the typer reads for sibling-nursery
  # brand-mismatch detection.
  let all_decls = interp_decls
  let proto_reg = lowered.reg
  let proto_errs = lowered.errs
  # The stage's verdicts in the order their exits are tried: the
  # first failing count is the exit status, and the document
  # carries what every pass collected, whichever fails first.
  let front_vds = [
    Verdict(doc_errs, docs.diags), eff_scope_vd, ty_scope_vd, interp_dot_vd,
    import_resolve_vd, Verdict(alias_res.errs, alias_res.diags),
    Verdict(proto_errs, lowered.diags), import_hole_vd,
    unit_ref_vd, hab_decl_vd, shape_ref_vd, post_alias_unit_vd,
    vd_rendered(nominal_row_diags), union_collision_vd, constructor_uniq_vd,
    variant_cap_vd, extern_home_vd, extern_fn_vd, vd_rendered(extern_type_diags),
    kind_home_vd, qualtype_vd, pat_qual_vd]
  let back_vds = [
    qh_vd, vd_rendered(type_name_coll), pub_access_vd, vd_rendered(fn_name_coll),
    vd_rendered(effect_name_coll), vd_rendered(const_name_coll), vd_rendered(axiom_name_coll),
    kai_decl_vd]
  # The missing exports are rendered only once every earlier pass is clean.
  if vd_failed(front_vds) { Halt(vd_exit(json, list_append(front_vds, back_vds))) }
  else if missing_exports != [] { Halt(vd_exit(json, [vd_render(missing_exports), ...back_vds])) }
  else if vd_failed(back_vds) { Halt(vd_exit(json, back_vds)) }
  else { Go(Lowered { json: cx.json, target_mod_name: cx.target_mod_name, roots: cx.roots, entry: cx.entry, own_tab: cx.own_tab, docs: cx.docs, doc_decls: cx.doc_decls, expanded: cx.expanded, tab0: cx.tab0, nsrcs: cx.nsrcs, npre: cx.npre, core_hit: cx.core_hit, prunes: cx.prunes, core_decls_whole: cx.core_decls_whole, surface_decls_whole: cx.surface_decls_whole, lib_mods: cx.lib_mods, pcut: cx.pcut, emptied: cx.emptied, gone: cx.gone, surface_decls: cx.surface_decls, core_segs: cx.core_segs, surface_fn_bounds: cx.surface_fn_bounds, module_table: cx.module_table, diag_ctx: cx.diag_ctx, mod_tabs: cx.mod_tabs, mod_imps: cx.mod_imps, sel_imports: cx.sel_imports, sym_views: cx.sym_views, ts_coll: cx.ts_coll, tab1: cx.tab1, cs_coll: cx.cs_coll, rqc_fx: cx.rqc_fx, vs_coll: cx.vs_coll, qualified_core: cx.qualified_core, pa_segs: cx.pa_segs, tab2: cx.tab2, ref_pred_fns: cx.ref_pred_fns, narrow_aliases: cx.narrow_aliases, tab3: cx.tab3, kind_ctx_a: cx.kind_ctx_a, kind_theories: cx.kind_theories, alias_res: cx.alias_res, ta_table: cx.ta_table, kind_ctx_b: cx.kind_ctx_b, pos_recs: cx.pos_recs, region_marks: cx.region_marks, post_use_decls: post_use_decls, lowered: lowered, sym_tab: sym_tab, interp_cores: interp_cores, callee_ops: callee_ops, root_picks: root_picks, early_const_uses: early_const_uses, pattern_consts: pattern_consts, all_decls: all_decls, proto_reg: proto_reg, held_impls: hold.held, emptied_impls: hold.emptied }) }
}

pub(pkg) fn stage_ready(req: Req, cx: Lowered) : Ready / Console + File + Mutable {
  let alias_res = cx.alias_res
  let backend = req.backend
  let core_segs = cx.core_segs
  let cs_coll = cx.cs_coll
  let diag_ctx = cx.diag_ctx
  let edition = req.edition
  let entry = cx.entry
  let expanded = cx.expanded
  let interp_cores = cx.interp_cores
  let kind_ctx_a = cx.kind_ctx_a
  let kind_ctx_b = cx.kind_ctx_b
  let kind_theories = cx.kind_theories
  let lowered = cx.lowered
  let mod_imps = cx.mod_imps
  let mod_tabs = cx.mod_tabs
  let module_table = cx.module_table
  let narrow_aliases = cx.narrow_aliases
  let path = req.path
  let pattern_consts = cx.pattern_consts
  let pos_recs = cx.pos_recs
  let qualified_core = cx.qualified_core
  let ref_pred_fns = cx.ref_pred_fns
  let roots = cx.roots
  let rqc_fx = cx.rqc_fx
  let sel_imports = cx.sel_imports
  let sym_tab = cx.sym_tab
  let sym_views = cx.sym_views
  let ta_table = cx.ta_table
  let tab0 = cx.tab0
  let tab1 = cx.tab1
  let tab2 = cx.tab2
  let tab3 = cx.tab3
  let target_mod_name = cx.target_mod_name
  let ts_coll = cx.ts_coll
  let vs_coll = cx.vs_coll
  let front_cx_of = () => CoreFrontCx { tab0: tab0, tab1: tab1, target: target_mod_name, module_table: module_table,
                             mod_tabs: mod_tabs, core_tabs: mtabs_build([], module_table), sym_views: sym_views, cs_coll: cs_coll, rqc_fx: rqc_fx,
                             diag_ctx: diag_ctx, mangle: mangle_core_plan(qualified_core, tab1, core_segs),
                             tab2: tab2, tab3: tab3, sym_tab: sym_tab, file: path,
                             narrow_aliases: narrow_aliases, kind_ctx_a: kind_ctx_a, kind_ctx_b: kind_ctx_b,
                             effect_aliases: alias_res.aliases, ta_table: ta_table, ref_pred_fns: ref_pred_fns,
                             recs: pos_recs,
                             show: proto_core_show(lowered.reg, interp_cores), cores: interp_cores,
                             consts: pattern_consts,
                             ts_coll: ts_coll, vs_coll: vs_coll, mod_imps: mod_imps, sel_imports: sel_imports, entry: entry, reg: lowered.reg,
                             cover: if runs_blocks(req.mode) { req.cover } else { cover_none() } }
  let front = TyperFront { df: diag_ctx, views: sym_views, target: target_mod_name, roots: roots,
                           kind_theories: kind_theories, edition: edition_or_oldest(edition),
                           cycles: match expanded { EP_Mod(_, _, _, _, _, _, _, _, _, cy) -> cy } }
  Ready { json: cx.json, target_mod_name: cx.target_mod_name, entry: cx.entry, own_tab: cx.own_tab, docs: cx.docs, doc_decls: cx.doc_decls,
    expanded: cx.expanded, tab0: cx.tab0, nsrcs: cx.nsrcs, npre: cx.npre, core_hit: cx.core_hit, prunes: cx.prunes,
    core_decls_whole: cx.core_decls_whole, surface_decls_whole: cx.surface_decls_whole, lib_mods: cx.lib_mods, pcut: cx.pcut,
    emptied: cx.emptied, gone: cx.gone, surface_decls: cx.surface_decls, surface_fn_bounds: cx.surface_fn_bounds,
    module_table: cx.module_table, diag_ctx: cx.diag_ctx, mod_tabs: cx.mod_tabs, sym_views: cx.sym_views, pa_segs: cx.pa_segs,
    region_marks: cx.region_marks, post_use_decls: cx.post_use_decls, lowered: cx.lowered, sym_tab: cx.sym_tab, callee_ops: cx.callee_ops,
    root_picks: cx.root_picks, early_const_uses: cx.early_const_uses, all_decls: cx.all_decls, proto_reg: cx.proto_reg,
    held_impls: cx.held_impls, emptied_impls: cx.emptied_impls, front_cx_of: front_cx_of, front: front }
}


fn mode_checks_core_front(mode: Mode) : Bool = match mode {
  MCheckCoreFront -> true
  _ -> false
}
