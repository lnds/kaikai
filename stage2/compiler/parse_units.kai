#[doc("""
Unit-of-measure expression parsing and the `<...>` habitant annotation on type heads.
""")]

import compiler.util
import compiler.lex_tokens
import compiler.ast
import compiler.kinds
import compiler.parse_state
import compiler.parse_literals

#[doc("""
A type head takes a `<habitant>` annotation when it is `Real`, `Int` or
`Decimal`, or a user-declared nominal head (uppercase). A lowercase head is
a type variable, so `t < u` in a signature stays a refinement comparison.
""")]
pub fn ty_head_takes_habitant(src: String, t: Token, name: String) : Bool =
  name == "Real" or name == "Int" or name == "Decimal" or is_upper_ident(src, t)

#[doc("A parameterised uppercase head may carry a habitant after its argument list (`Money[Decimal]<USD>`).")]
pub fn ty_args_habitant(pr: PTy, t: Token) : PTy / Console = match pr.r {
  None -> pr
  Some(base) ->
    if p_at(pr.p, TkLt) and is_upper_ident(pr.p.src, t) { parse_habitant_slot(pr.p, base, t) } else { pr }
}

type HabHead = { base: TypeExpr, t: Token, from: Int }

#[doc("""
The `<...>` habitant slot on a type head, `p` at the `<`: one habitant
expression, or a comma-separated positional list (`Matrix[t]<m, n>`) that
rides a single `UDims`. The spelling between the brackets is not recoverable
from the resolved units, so it is sliced from the source into a `TsUnitSpan`.
""")]
pub fn parse_habitant_slot(p: Parser, base: TypeExpr, t: Token) : PTy / Console {
  let lt = p_peek(p)
  parse_habitant_list(p_advance_nl(p), [], HabHead { base: base, t: t, from: lt.start + lt.length })
}

fn parse_habitant_list(p: Parser, acc: [UnitExprT], h: HabHead) : PTy / Console {
  let ru = parse_unit_expr(p)
  match ru.r {
    None -> err_t(ru.p)
    Some(u) -> habitant_list_next(p_skip_newlines(ru.p), [u, ...acc], h)
  }
}

fn habitant_list_next(p: Parser, acc: [UnitExprT], h: HabHead) : PTy / Console =
  if p_at(p, TkComma) { parse_habitant_list(p_advance_nl(p), acc, h) }
  else if p_at(p, TkGt) { close_habitant(p, acc, h) }
  else { fail_t(p, "expected `>` to close the habitant annotation") }

fn close_habitant(p: Parser, acc: [UnitExprT], h: HabHead) : PTy {
  let raw = string_slice(p.src, h.from, p_peek(p).start - h.from)
  let hab = match acc { [u] -> u  _ -> UDims(list_reverse(acc)) }
  let dim = ty_at(TyDim(h.base, hab), h.t)
  ok_t(p_advance(p), ty_at(TySurface(TsUnitSpan(raw, dim)), h.t))
}

#[doc("Parses a unit-of-measure expression.")]
pub fn parse_unit_expr(p: Parser) : PUnit / Console {
  let r = parse_unit_term(p)
  match r.r {
    None -> r
    Some(lhs) -> parse_unit_expr_rest(r.p, lhs)
  }
}

fn is_unit_op(k: TokKind) : Bool = tk_is(k, TkStar) or tk_is(k, TkSlash) or tk_is(k, TkPlus)

fn unit_op_node(k: TokKind, lhs: UnitExprT, rhs: UnitExprT) : UnitExprT = match k {
  TkSlash -> UMul(lhs, UInv(rhs))
  TkPlus  -> UJoin(lhs, rhs)
  _       -> UMul(lhs, rhs)
}

fn parse_unit_expr_rest(p: Parser, lhs: UnitExprT) : PUnit / Console = {
  let op = p_peek(p).kind
  if is_unit_op(op) {
    let r = parse_unit_term(p_advance(p))
    match r.r {
      None -> r
      Some(rhs) -> parse_unit_expr_rest(r.p, unit_op_node(op, lhs, rhs))
    }
  } else { ok_u(p, lhs) }
}

fn parse_unit_term(p: Parser) : PUnit / Console {
  let r = parse_unit_factor(p)
  match r.r {
    None -> r
    Some(base) -> if p_at(r.p, TkCaret) { unit_power(base, parse_unit_signed_int(p_advance(r.p))) } else { r }
  }
}

fn unit_power(base: UnitExprT, rn: PUInt) : PUnit = match rn.r {
  None -> err_u(rn.p)
  Some(n) -> ok_u(rn.p, UPow(base, n))
}

fn parse_unit_signed_int(p: Parser) : PUInt / Console {
  let neg = p_at(p, TkMinus)
  let p1 = if neg { p_advance(p) } else { p }
  let t = p_peek(p1)
  if tk_is(t.kind, TkInt) {
    let n = decode_int(tok_source(p1.src, t))
    PUInt { p: p_advance(p1), r: Some(if neg { 0 - n } else { n }) }
  } else {
    PUInt { p: p_error_here(p1, "expected integer after `^` in unit expression"), r: None }
  }
}

fn parse_unit_factor(p: Parser) : PUnit / Console {
  let t = p_peek(p)
  match t.kind {
    TkIdent -> parse_unit_ident(p, t)
    TkInt -> parse_unit_int(p, t)
    # The quoted source text is the symbol, disjoint from identifier habitants by its leading quote.
    TkString -> ok_u(p_advance(p), USym(tok_source(p.src, t)))
    TkLparen -> unit_group_close(parse_unit_expr(p_advance(p)))
    _ -> err_u(p_error(p, t, "expected unit symbol, `1`, or parenthesised unit expression"))
  }
}

# An explicit `Kind.sym` is emitted in its final form; only a bare `USym` is rewritten later.
fn parse_unit_ident(p: Parser, t: Token) : PUnit / Console =
  if tk_is(p_peek1(p).kind, TkDot) { parse_qualified_unit(p, t) }
  else { ok_u(p_advance(p), USym(tok_source(p.src, t))) }

# `<1>` is the dimensionless unit; any other integer is a value habitant.
fn parse_unit_int(p: Parser, t: Token) : PUnit {
  let span = tok_source(p.src, t)
  ok_u(p_advance(p), if decode_int(span) == 1 { UOne } else { USym(span) })
}

fn unit_group_close(r: PUnit) : PUnit / Console = match r.r {
  None -> r
  Some(u) ->
    if p_at(r.p, TkRparen) { ok_u(p_advance(r.p), u) }
    else { err_u(p_error_here(r.p, "expected `)` in unit expression")) }
}

# `Kind.sym` or `intro.sym`: the qualifier resolves through the kind registry and the factor becomes `USym("Kind$sym")`.
fn parse_qualified_unit(p: Parser, qt: Token) : PUnit / Console {
  let qual = tok_source(p.src, qt)
  let p1 = p_advance(p_advance(p))
  let st = p_peek(p1)
  if not tk_is(st.kind, TkIdent) {
    err_u(p_error_here(p1, "expected a habitant name after `.` in a qualified unit"))
  } else {
    match kind_reg_resolve_qualifier(p.kind_reg, qual) {
      None -> err_u(p_error(p, qt, concat_all(["`", qual, "` is not a declared kind or introducer"])))
      Some(kind) -> ok_u(p_advance(p1), USym(kind_qualify_nondefault(kind, tok_source(p1.src, st))))
    }
  }
}
