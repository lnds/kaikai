# Char literal spellings for `kai fmt`. The AST keeps only a literal's
# decoded Char, so the writer reprints it from the source token: `'é'`
# stays `'é'` and `'\u{e9}'` stays `'\u{e9}'`.

import compiler.lex

#[doc("Each char literal token's (line, col, source spelling), quotes included.")]
pub fn char_spellings(toks: [Token], src: String) : [(Int, Int, String)] =
  char_spellings_loop(toks, src, [])

fn char_spellings_loop(toks: [Token], src: String, acc: [(Int, Int, String)]) : [(Int, Int, String)] = match toks {
  [] -> acc
  [t, ...rest] -> match t.kind {
    TkChar -> char_spellings_loop(rest, src, [(t.line, t.col, string_slice(src, t.start, t.length)), ...acc])
    _      -> char_spellings_loop(rest, src, acc)
  }
}

#[doc("The spelling of the char literal at (`line`, `col`), or `None` when no literal starts there.")]
pub fn char_spelling_at(cs: [(Int, Int, String)], line: Int, col: Int) : Option[String] = match cs {
  [] -> None
  [c, ...rest] -> if c.fst == line and c.snd == col { Some(c.trd) } else { char_spelling_at(rest, line, col) }
}
