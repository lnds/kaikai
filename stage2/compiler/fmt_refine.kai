# compiler/fmt_refine.kai — surface-form recovery for `kai fmt`.
#
# Four parse-time desugars reach the writer with the surface form gone:
#
#   ~r/pat/           ->  regexp.compile_or_panic("pat")   (an EModCall callee)
#   where >= 0        ->  self >= 0
#   where matches p   ->  matches(self, p)
#   3i                ->  complex.mk(0.0, 3)
#
# Re-printing the desugar is not merely verbose. `EModCall` prints as
# `m.f()`, so the regex desugar came out as `(regexp.compile_or_panic())("pat")`
# — malformed, and naming a module that need not be in scope at that point
# in the file. A clean program stopped compiling after formatting.
#
# Each recogniser here is exact: a shape that is not the desugar is left
# for the ordinary expression path, so hand-written code that happens to
# call `matches` or compare against `self` keeps its own spelling.

import compiler.util
import compiler.ast
import compiler.refinements

#[doc("A recovered `where` elision: the leading keyword or operator, and the expression that follows it.")]
pub type RefineElision = RE(String, Expr)

#[doc("The `~r/.../` sigil behind a `regexp.compile_or_panic(\"...\")` desugar, or None for any other call.")]
pub fn fmt_regex_sigil(callee: Expr, call_args: [Expr]) : Option[String] =
  match call_args {
    [arg0] -> if fmt_callee_is_regex_compile(callee) { fmt_sigil_of(arg0) } else { None }
    _      -> None
  }

#[doc("The receiver elision behind a `where` predicate refining `base`, or None when the predicate was written in full.")]
pub fn fmt_refine_elision(base: TypeExpr, pred: Expr) : Option[RefineElision] =
  fmt_elision_at(base.line, base.col, pred)

#[doc("The receiver elision behind a `where` predicate whose synthetic `self` was minted at (line, col) — the base type's position for a refinement, the `ensure` token's for `ensure(v) where`.")]
pub fn fmt_elision_at(line: Int, col: Int, pred: Expr) : Option[RefineElision] = match pred.kind {
  EBinop(op, lhs, rhs) ->
    if fmt_is_cmp_op(op) and fmt_is_elided_self(lhs, line, col) {
      Some(RE(concat_all([op, " "]), rhs))
    } else { None }
  ECall(callee, cargs) -> fmt_matches_elision(callee, cargs, line, col)
  _ -> None
}

# `matches(self, rhs)`, where the sugar minted the receiver. The callee
# sits at the `matches` token, so it is the `self` argument alone that
# betrays the elision.
fn fmt_matches_elision(callee: Expr, cargs: [Expr], line: Int, col: Int) : Option[RefineElision] =
  match cargs {
    [recv, rhs] ->
      if fmt_var_is(callee, "matches") and fmt_is_elided_self(recv, line, col) {
        Some(RE("matches ", rhs))
      } else { None }
    _ -> None
  }

# The synthetic receiver is minted at the anchor position — the one
# place inside the predicate no operand can occupy, since every operand
# is written after the `where`. A written-out `self` never lands on it.
fn fmt_is_elided_self(e: Expr, line: Int, col: Int) : Bool =
  fmt_var_is(e, "self") and e.line == line and e.col == col

#[doc("True when the expression is the bare identifier `name`.")]
pub fn fmt_var_is(e: Expr, name: String) : Bool = match e.kind {
  EVar(n) -> n == name
  _       -> false
}

fn fmt_is_cmp_op(op: String) : Bool =
  op == "<" or op == "<=" or op == "==" or op == "!=" or op == ">" or op == ">="

# Only the sigil parser mints an `EModCall` this early — a hand-written
# `regexp.compile_or_panic(p)` is still an `EField` when the writer runs,
# since the qualified-call resolver has not yet rewritten it.
fn fmt_callee_is_regex_compile(callee: Expr) : Bool = match callee.kind {
  EModCall(m, fname) -> m == "regexp" and fname == "compile_or_panic"
  _                  -> false
}

# Re-wrap the desugared pattern in its sigil delimiters. The string span
# holds the pattern escaped as a kaikai string literal; decoding it
# recovers the bytes that stood between `~r/` and `/`. A pattern
# containing `/` could not have been written as a sigil in the first
# place, so it stays a call.
fn fmt_sigil_of(arg0: Expr) : Option[String] = match arg0.kind {
  EStr(span, false) -> {
    let pat = decode_regex_str_span(span)
    if pat == "" or fmt_has_slash(pat, 0, string_length(pat)) { None }
    else { Some(concat_all(["~r/", pat, "/"])) }
  }
  _ -> None
}

fn fmt_has_slash(s: String, i: Int, n: Int) : Bool {
  if i >= n { false }
  else if char_at_or_zero(s, i) == '/' { true }
  else { fmt_has_slash(s, i + 1, n) }
}

# ---- imaginary literals ----------------------------------------------
# A fourth desugar, same discipline: `3i` reaches the writer as
# `complex.mk(0.0, 3)`. The parser mints callee and both arguments from
# the one token, so all three share its position and the real part is
# the synthetic `0.0`; a hand-written `complex.mk(0.0, n)` spreads
# across distinct columns and keeps its call form.

#[doc("The surface literal a call node stands for — an imaginary literal or a regex sigil — or None when the author wrote a call.")]
pub fn fmt_call_literal(callee: Expr, call_args: [Expr]) : Option[String] =
  match fmt_imaginary_span(callee, call_args) {
    Some(im) -> Some(string_concat(im, "i"))
    None     -> fmt_regex_sigil(callee, call_args)
  }

# The imaginary part's span, which is what `<digits>i` prints from.
fn fmt_imaginary_span(callee: Expr, call_args: [Expr]) : Option[String] = match call_args {
  [re, im] -> if fmt_is_imaginary_desugar(callee, re, im) {
    fmt_nonempty(fmt_real_span(im))
  } else { None }
  _ -> None
}

fn fmt_is_imaginary_desugar(callee: Expr, re: Expr, im: Expr) : Bool {
  let shape_ok = fmt_callee_is_complex_mk(callee) and fmt_real_span(re) == "0.0"
  shape_ok and fmt_same_pos(callee, re) and fmt_same_pos(callee, im)
}

fn fmt_callee_is_complex_mk(callee: Expr) : Bool = match callee.kind {
  EField(obj, fld) -> fld == "mk" and fmt_var_is(obj, "complex")
  _                -> false
}

# The raw span of a real literal, or "" for any other node.
fn fmt_real_span(e: Expr) : String = match e.kind {
  EReal(_, span) -> span
  _              -> ""
}

fn fmt_same_pos(a: Expr, b: Expr) : Bool = a.line == b.line and a.col == b.col

fn fmt_nonempty(s: String) : Option[String] = if s == "" { None } else { Some(s) }
