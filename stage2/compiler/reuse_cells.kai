#[doc("""
The inner cells a variant reuse arm deconstructs, shared by both backends.

A nested sub-pattern with a payload names an inner cell, at any depth. A
reuse arm settles each one once: unique, the children its rebuild takes
move to their binders, every other boxed child is released and the shell
is freed; shared, each taken binder gains a reference and the cell loses
the donor's.
""")]

import compiler.ast
import compiler.emit_shared
import compiler.ctor_ix

#[doc("A boxed child of an inner cell, by slot: a binder, a slot no binder names, or a deeper cell.")]
pub type CellKid = KidBind(Int, LocalId) | KidDrop(Int) | KidCell(Int, ReuseCell)

#[doc("An inner cell: its arity and its boxed children in slot order.")]
pub type ReuseCell = ReuseCell(Int, [CellKid])

#[doc("True when sub-pattern `sp` over a slot of kind `k` deconstructs an inner cell.")]
pub fn reuse_is_cell(sp: Pattern, k: Int) : Bool = k == 0 and match sp.pkind {
  PVariant(_, isubs) -> isubs != []
  _                  -> false
}

# A layout of another arity is worse than none: the kinds are walked in
# lockstep with the sub-patterns.
#[doc("The slot kinds of the constructor a sub-pattern names, [] when it is not registered.")]
pub fn reuse_ctor_kinds(ctors: CtorIx, r: DeclRef, isubs: [Pattern]) : [Int] = match ctor_ix_row(ctors, ref_sym(r)) {
  Some(EV(_, _, _, ks, _)) -> if list_length(ks) == list_length(isubs) { ks } else { [] }
  None                     -> []
}

#[doc("The inner cells the slots `subs` (of kinds `ks`) deconstruct, each with its slot index.")]
pub fn reuse_slot_cells(subs: [Pattern], ks: [Int], ctors: CtorIx) : [(Int, ReuseCell)] =
  rc_slots(subs, ks, 0, ctors)

#[doc("The inner cells a reuse arm's pattern deconstructs below its donor.")]
pub fn reuse_pattern_cells(p: Pattern, ctors: CtorIx) : [(Int, ReuseCell)] = match p.pkind {
  PVariant(r, subs) -> rc_slots(subs, reuse_ctor_kinds(ctors, r, subs), 0, ctors)
  _                 -> []
}

fn rc_slots(subs: [Pattern], ks: [Int], i: Int, ctors: CtorIx) : [(Int, ReuseCell)] = match subs {
  []            -> []
  [sp, ...rest] -> {
    let tl = rc_slots(rest, ks, i + 1, ctors)
    match rc_cell(sp, kind_at(ks, i), ctors) { Some(c) -> [(i, c), ...tl] None -> tl }
  }
}

fn rc_cell(sp: Pattern, k: Int, ctors: CtorIx) : Option[ReuseCell] =
  if not reuse_is_cell(sp, k) { None }
  else { match sp.pkind {
    PVariant(r, isubs) ->
      Some(ReuseCell(list_length(isubs), rc_kids(isubs, reuse_ctor_kinds(ctors, r, isubs), 0, ctors)))
    _ -> None
  } }

# Only boxed slots carry a reference to settle.
fn rc_kids(isubs: [Pattern], ks: [Int], j: Int, ctors: CtorIx) : [CellKid] = match isubs {
  []            -> []
  [sp, ...rest] -> {
    let k = kind_at(ks, j)
    let tl = rc_kids(rest, ks, j + 1, ctors)
    if k != 0 { tl }
    else { match rc_cell(sp, k, ctors) {
      Some(c) -> [KidCell(j, c), ...tl]
      None    -> match sp.pkind {
        PBind(b)  -> [KidBind(j, b.id), ...tl]
        _         -> [KidDrop(j), ...tl]
      }
    } }
  }
}
