#[doc("Package identity: each module carries the id of the package that owns it, fixed when it is loaded from the roots the build declares.")]

import compiler.util
import compiler.modules_paths


#[doc("The identity of a package; `PkgId(0)` is no package and equals nothing, itself included.")]
pub(pkg) type PkgId = PkgId(Int)

#[doc("The package roots of a build and the standard library directory, all absolute.")]
pub(pkg) type PkgPlan = PkgPlan([String], String)

#[doc("The id of no package.")]
pub(pkg) fn pkg_none() : PkgId = PkgId(0)

#[doc("The plan for a build declaring `roots`, one package per manifest directory. A root file no root holds belongs to the package of the `kai.toml` that encloses it, found once here; with none it belongs to no package.")]
pub(pkg) fn pkg_plan(roots: [String], stdlib: String, root_file: String) : PkgPlan / File = {
  let declared = PkgPlan(map(roots, abspath), abspath(stdlib))
  if pkg_known(pkg_of(declared, root_file)) { declared }
  else { match enclosing_manifest(dir_of(abspath(root_file))) {
    Some(dir) -> match declared { PkgPlan(rs, std) -> PkgPlan(list_append(rs, [dir]), std) }
    None      -> declared
  } }
}

fn enclosing_manifest(dir: String) : Option[String] / File =
  if string_length(dir) <= 1 { None }
  else { match read_file(cat2(dir, "/kai.toml")) {
    Ok(_)  -> Some(dir)
    Err(_) -> enclosing_manifest(dir_of(dir))
  } }

#[doc("Whether two modules sit in one package.")]
pub(pkg) fn pkg_same(a: PkgId, b: PkgId) : Bool = match a { PkgId(x) -> x != 0 and b == a }

#[doc("Whether the id names a package.")]
pub(pkg) fn pkg_known(p: PkgId) : Bool = match p { PkgId(x) -> x != 0 }

#[doc("The id of the standard library package.")]
pub(pkg) fn pkg_stdlib() : PkgId = PkgId(1)

#[doc("The package id as it spells inside an export marker.")]
pub(pkg) fn pkg_text(p: PkgId) : String = match p { PkgId(n) -> int_to_string(n) }

#[doc("The id of the package that owns the file `path`: the declared root that contains it most deeply, or the standard library; none when neither holds it.")]
pub(pkg) fn pkg_of(plan: PkgPlan, file: String) : PkgId = match plan {
  PkgPlan(roots, stdlib) -> {
    let path = abspath(file)
    let held = deepest(roots, path, 2, -1, 0)
    let held_std = if contains(stdlib, path) { string_length(stdlib) } else { -1 }
    if held_std > held.fst { PkgId(1) }
    else if held.fst >= 0 { PkgId(held.snd) }
    else { PkgId(0) }
  }
}

fn contains(dir: String, path: String) : Bool = starts_with(path, string_concat(dir, "/"))

fn deepest(roots: [String], path: String, id: Int, best: Int, best_id: Int) : (Int, Int) = match roots {
  [] -> (best, best_id)
  [r, ...rest] ->
    if contains(r, path) and string_length(r) > best { deepest(rest, path, id + 1, string_length(r), id) }
    else { deepest(rest, path, id + 1, best, best_id) }
}
