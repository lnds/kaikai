#[doc("""
The expressions that can trap, which the native backend gives landing
pads: a trap leaves through the unwinder, and each pad releases the
binders its frame still owns across the expression.

A pad may be given where nothing traps: LLVM drops a pad no unwind can
reach. It must never be missing where a trap can reach a binder the
frame owns, or that reference leaks on the trap.
""")]

import compiler.ast
import compiler.operators
import compiler.marks
import compiler.unwind_sites
import compiler.emit_shared

#[doc("True when a call through `f` can trap: every call but the compiler's marks. A name calls a declared fn or a closure, whatever its spelling.")]
pub fn unw_call_traps(f: Expr) : Bool = match f.kind {
  EMark(MkApplyBorrow) -> true
  EMark(_)             -> false
  _                    -> true
}

#[doc("True when the binary operator `op` on the operand `a` can trap: integer division and remainder, and any operator but concatenation and the logical ones on a value that is not a scalar, which calls the type's own implementation.")]
pub fn unw_op_traps(op: BinOp, a: Expr) : Bool =
  binop_is_division(op) or (up_dispatches(op) and not up_scalar(a.ty))

fn up_dispatches(op: BinOp) : Bool = match op {
  BoConcat -> false
  BoAnd    -> false
  BoOr     -> false
  _        -> true
}

fn up_scalar(t: Option[Ty]) : Bool = match t {
  Some(x) -> ty_is_scalar(x)
  None    -> true
}

#[doc("The binders the landing pad at `x` releases, if `x` has one; only a node that can trap has one, whatever shares its position.")]
pub fn unw_pad_names(sites: [UnwSite], x: Expr) : Option[[LocalId]] = match sites {
  [] -> None
  _  -> if up_trap_kind(x) { unw_pad_at(sites, x.site) } else { None }
}

fn up_trap_kind(x: Expr) : Bool = match x.kind {
  ECall(_, _)     -> true
  EIndex(_, _)    -> true
  EBinop(_, _, _) -> true
  _               -> false
}
