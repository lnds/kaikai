#[doc("""
The expressions that can trap, which the native backend gives landing
pads: a trap leaves through the unwinder, and each pad releases the
binders its frame still owns across the expression.

A pad may be given where nothing traps: LLVM drops a pad no unwind can
reach. It must never be missing where a trap can reach a binder the
frame owns, or that reference leaks on the trap.
""")]

import compiler.ast
import compiler.marks
import compiler.unwind_sites

#[doc("True when a call through `f` can trap: every call but the compiler's internal forms and marks.")]
pub fn unw_call_traps(f: Expr) : Bool = match f.kind {
  EMark(MkApplyBorrow) -> true
  EMark(_)             -> false
  EVar(n)              -> not up_internal(n)
  ESym(_, _, n)        -> not up_internal(n)
  _                    -> true
}

#[doc("True when the binary operator `op` can trap: integer division and remainder.")]
pub fn unw_op_traps(op: String) : Bool = op == "/" or op == "%"

#[doc("The spelling a landing pad at `e` is keyed by, beside its position.")]
pub fn unw_pad_key(e: Expr) : String = match e.kind {
  ECall(f, _)      -> unw_callee_key(f)
  EIndex(_, _)     -> "[]"
  EBinop(op, _, _) -> op
  _                -> ""
}

#[doc("The key of the landing pad around an `assert`, at its condition's position.")]
pub fn unw_assert_key() : String = "assert"

#[doc("The binders the landing pad at `x` releases, if `x` has one.")]
pub fn unw_pad_names(sites: [UnwSite], x: Expr) : Option[[String]] = match sites {
  [] -> None
  _  -> unw_pad_at(sites, x.line, x.col, unw_pad_key(x))
}

fn up_internal(n: String) : Bool = string_byte_at_int(n, 0) == 95 and string_byte_at_int(n, 1) == 95
