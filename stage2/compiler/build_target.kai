#[doc("The platform a program is built for, and the effects its `main` may perform there.")]

import compiler.util
import compiler.ast_ids
import compiler.ast_decl
import compiler.diag
import compiler.core_types
import compiler.symtab
import compiler.written
import compiler.emit_shared_rows

#[doc("A build target: the host the compiler runs on, or a browser page.")]
pub type Target = TgHost | TgWasm32Browser

#[doc("The target a name spells, or `None` when it spells none.")]
pub fn target_of_name(n: String) : Option[Target] = match n {
  "host"           -> Some(TgHost)
  "wasm32-browser" -> Some(TgWasm32Browser)
  _                -> None
}

#[doc("The name a target is selected by.")]
pub fn target_name(t: Target) : String = match t {
  TgHost          -> "host"
  TgWasm32Browser -> "wasm32-browser"
}

fn browser_refused_core() : [CoreEffect] =
  [CeProcess, CeNetTcp, CeNetDns, CeSignal, CeFile, CeStdin, CeSpawn, CeCancel, CeLink, CeMonitor, CeActor]

fn browser_refused_named() : [String] = ["NetUdp", "NetUnix"]

fn refused_on(t: Target, tab: SymTab, s: SymId) : Bool = match t {
  TgHost          -> false
  TgWasm32Browser -> effect_is_any(s, browser_refused_core()) or list_has(browser_refused_named(), written_text(decl_name(tab, s)))
}

fn refusal(t: Target, tab: SymTab, file: String, line: Int, col: Int, s: SymId) : Diagnostic = {
  let eff = written_text(decl_name(tab, s))
  mk_diag(SevError, file, line, col,
    "`main` performs effect `#{eff}`, which the `#{target_name(t)}` target cannot run",
    [ri_help(file, line, col, "handle `#{eff}` in `main` with a handler of your own, or remove it from `main`'s row")])
}

fn main_site(decls: [Decl], entry: SymId) : Option[[Int]] = match decls {
  [] -> None
  [d, ...rest] -> match d {
    DFn(_, fid, _, _, _, _, _, line, col, _) -> if is_entry(entry, fid) { Some([line, col]) } else { main_site(rest, entry) }
    _ -> main_site(rest, entry)
  }
}

#[doc("One diagnostic for each effect in `main`'s final row that the target cannot run; none on the host.")]
pub fn target_main_diags(t: Target, file: String, decls: [Decl], entry: SymId, tab: SymTab) : [Diagnostic] = match t {
  TgHost -> []
  TgWasm32Browser -> match main_site(decls, entry) {
    Some([line, col]) -> map(filter(main_row_labels(decls, entry), (s) => refused_on(t, tab, s)), (s) => refusal(t, tab, file, line, col, s))
    _ -> []
  }
}
