# compiler/const_pattern.kai — constants in pattern position.
#
# A constant named in a pattern parses as a nullary variant (`LIMIT`,
# `m.LIMIT`) or, lowercase at the top of an arm, as a binder. When the
# name is a declared constant the arm means "equal to that constant's
# value": the pattern becomes a fresh binder and the arm gains an
# equality guard. A qualifier selects the module's constant, so the
# guard reads `m.LIMIT`; a bare spelling reads the bare constant.
#
# Value-position reads need no rewrite: a constant IS a value.

import compiler.util
import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.modules_homes
import compiler.desugar_refine_pred
import compiler.local_names
import compiler.expr_positions
import compiler.fnreg
import compiler.diag
import compiler.diag_file
import compiler.import_cycles

# A declared constant as a pattern can write it: its home module (`None`
# for the root file) and its spelling. A pattern is read before name
# resolution, so the spelling is all it has to match.
#[doc("A declared constant as a pattern can write it: its home module (`None` for the root file) and its spelling.")]
pub(pkg) type CDecl = CD(Option[String], String)

# One rewritten pattern plus the equality guards it accumulated.
type CPRes = CPR(Pattern, [Expr])

#[doc("The constants a program declares, by home and spelling.")]
pub(pkg) fn const_pattern_names(decls: [Decl], tab: SymTab) : [CDecl] = cpat_consts(decls, tab, [])

#[doc("Rewrite constant names used in match patterns, at any depth, into a fresh binder plus an equality guard against the table `cs`, so declarations can be rewritten one at a time.")]
pub(pkg) fn desugar_const_patterns_with(cs: [CDecl], decls: [Decl]) : [Decl] =
  match cs {
    [] -> decls
    _  -> map(decls, (d) => cpat_decl(d, cs))
  }

fn cpat_consts(decls: [Decl], tab: SymTab, acc: [CDecl]) : [CDecl] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DConst(_, s, _, _, mo, _, _, _, _) -> cpat_consts(rest, tab, [CD(mo, written_text(decl_name(tab, s))), ...acc])
    _ -> cpat_consts(rest, tab, acc)
  }
}

fn cpat_decl(d: Decl, cs: [CDecl]) : Decl = match d {
  DFn(p, fid, tps, ps, ret, row, body, l, c, mo) ->
    DFn(p, fid, tps, ps, ret, row, cpat_expr(body, cs), l, c, mo)
  DTest(n, body, l, c, mo) -> DTest(n, cpat_expr(body, cs), l, c, mo)
  DBench(n, body, l, c, mo) -> DBench(n, cpat_expr(body, cs), l, c, mo)
  DConst(p, csym, ty, body, mo, l, c, nl, nc) -> DConst(p, csym, ty, cpat_expr(body, cs), mo, l, c, nl, nc)
  _ -> d
}

fn cpat_expr(e: Expr, cs: [CDecl]) : Expr = {
  let k2 = match e.kind {
    EMatch(scr, arms) -> EMatch(cpat_expr(scr, cs), map(arms, (a) => cpat_arm(a, cs)))
    _ -> dsg_map_expr_kind(e.kind, (sub) => cpat_expr(sub, cs))
  }
  Expr { kind: k2, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
}

# A pattern binder shadows a same-named constant inside the arm's body
# and guard, so those walk with the shadowed constants removed. The
# pattern itself is judged against the full set.
fn cpat_arm(a: Arm, cs: [CDecl]) : Arm = match a {
  Arm(pat, opt_g, body) -> {
    let inner = cpat_unshadowed(cs, map(pat_binders(pat, []), (b) => written_text(b.name)), [])
    let body2 = cpat_expr(body, inner)
    let g2 = match opt_g { Some(g) -> Some(cpat_expr(g, inner))  None -> None }
    match cpat_top(pat, cs) {
      CPR(pat2, guards) -> Arm(pat2, cpat_and_all(g2, guards), body2)
    }
  }
}

fn cpat_unshadowed(cs: [CDecl], binders: [String], acc: [CDecl]) : [CDecl] = match cs {
  [] -> acc
  [CD(mo, n), ...rest] ->
    if list_has(binders, n) { cpat_unshadowed(rest, binders, acc) }
    else { cpat_unshadowed(rest, binders, [CD(mo, n), ...acc]) }
}

# The user's guard, if any, is tested after every equality: a binder it
# reads must already be known to hold the constant's value.
fn cpat_and_all(user: Option[Expr], guards: [Expr]) : Option[Expr] = match guards {
  [] -> user
  [g, ...rest] -> match cpat_and_all(user, rest) {
    None    -> Some(g)
    Some(r) -> Some(mk_expr(EBinop(BoAnd, g, r), g.line, g.col))
  }
}

# Only the top of an arm reads a lowercase binder as a constant; a
# nested lowercase name is always a binder.
fn cpat_top(pat: Pattern, cs: [CDecl]) : CPRes = match pat.pkind {
  PBind(b) -> {
    let name = written_text(b.name)
    if cpat_has_bare(cs, name) { cpat_eq(pat, name, mk_name(name, pat.line, pat.col)) }
    else { CPR(pat, []) }
  }
  _ -> cpat_pat(pat, cs)
}

fn cpat_pat(pat: Pattern, cs: [CDecl]) : CPRes = match pat.pkind {
  PVariant(r, [])            -> cpat_nullary(pat, r, cs)
  PVariant(r, subs)          -> cpat_subs(pat, subs, cs, (s2) => PVariant(r, s2))
  PList(subs, rest)          -> cpat_subs(pat, subs, cs, (s2) => PList(s2, rest))
  PAs(name, inner)           -> cpat_subs(pat, [inner], cs, (s2) => cpat_as(name, s2, inner))
  PVariantRecord(r, fs)      -> cpat_fields(pat, fs, cs, (f2) => PVariantRecord(r, f2))
  PRecord(fs)                -> cpat_fields(pat, fs, cs, (f2) => PRecord(f2))
  _ -> CPR(pat, [])
}

# A reference already settled names a constructor, never a constant.
fn cpat_nullary(pat: Pattern, r: DeclRef, cs: [CDecl]) : CPRes = match r {
  DrWritten(home, name) -> match cpat_const_ref(home, name, cs, pat.line, pat.col) {
    Some(cref) -> cpat_eq(pat, written_text(name), cref)
    None       -> CPR(pat, [])
  }
  DrSym(_) -> CPR(pat, [])
}

fn cpat_as(name: Binder, rebuilt: [Pattern], orig: Pattern) : PatKind = match rebuilt {
  [inner2, ..._] -> PAs(name, inner2)
  []             -> PAs(name, orig)
}

fn cpat_subs(pat: Pattern, subs: [Pattern], cs: [CDecl],
             build: ([Pattern]) -> PatKind) : CPRes = match cpat_pats(subs, cs) {
  CPRs(subs2, gs) -> CPR(mk_pat(build(subs2), pat.line, pat.col), gs)
}

fn cpat_fields(pat: Pattern, fs: [PField], cs: [CDecl],
               build: ([PField]) -> PatKind) : CPRes = match cpat_pfields(fs, cs) {
  CPFs(fs2, gs) -> CPR(mk_pat(build(fs2), pat.line, pat.col), gs)
}

# The expression a constant pattern compares against. A qualifier names
# the module's own constant and nothing else; a bare spelling names
# whichever constant carries it. Neither is a constant: `None`.
fn cpat_const_ref(home: Option[Written], name: Written, cs: [CDecl],
                line: Int, col: Int) : Option[Expr] = match home {
  Some(h) ->
    if cpat_has_homed(cs, written_text(h), written_text(name)) { Some(mk_expr(EModCall(h, name), line, col)) }
    else { None }
  None ->
    if cpat_has_bare(cs, written_text(name)) { Some(mk_expr(EName(name), line, col)) }
    else { None }
}

fn cpat_has_bare(cs: [CDecl], name: String) : Bool = match cs {
  [] -> false
  [CD(_, n), ...rest] -> n == name or cpat_has_bare(rest, name)
}

fn cpat_has_homed(cs: [CDecl], home: String, name: String) : Bool = match cs {
  [] -> false
  [CD(mo, n), ...rest] -> match mo {
    Some(m) -> (m == home and n == name) or cpat_has_homed(rest, home, name)
    None    -> cpat_has_homed(rest, home, name)
  }
}

# The binder is compiler-internal (`__` prefix) and unique per pattern
# position, so two constants in one pattern never share a name.
fn cpat_eq(pat: Pattern, name: String, const_ref: Expr) : CPRes = {
  let cv = concat_all(["__cv_", name, "_", int_to_string(pat.line), "_",
                       int_to_string(pat.col)])
  let cv_var = mk_name(cv, pat.line, pat.col)
  CPR(mk_pat(PBind(binder_minted(cv)), pat.line, pat.col),
      [mk_expr(EBinop(BoEq, cv_var, const_ref), pat.line, pat.col)])
}

type CPResList = CPRs([Pattern], [Expr])

fn cpat_pats(ps: [Pattern], cs: [CDecl]) : CPResList = match ps {
  [] -> CPRs([], [])
  [p, ...rest] -> match cpat_pat(p, cs) {
    CPR(p2, gs) -> match cpat_pats(rest, cs) {
      CPRs(rest2, gs2) -> CPRs([p2, ...rest2], list_append(gs, gs2))
    }
  }
}

type CPFieldList = CPFs([PField], [Expr])

fn cpat_pfields(fs: [PField], cs: [CDecl]) : CPFieldList = match fs {
  [] -> CPFs([], [])
  [PField(name, sub, short), ...rest] -> match cpat_pat(sub, cs) {
    CPR(sub2, gs) -> match cpat_pfields(rest, cs) {
      CPFs(rest2, gs2) -> CPFs([PField(name, sub2, short), ...rest2], list_append(gs, gs2))
    }
  }
}

#[doc("The declarations with every such initialiser moved into a function, and the table rows of the functions minted.")]
pub(pkg) type ConstInits = { decls: [Decl], rows: [NEnt] }

#[doc("Move each constant initialiser that declares a local or holds a lambda into a function homed beside the constant; `target` homes the root file's.")]
pub(pkg) fn const_init_fns(decls: [Decl], tab: SymTab, target: String) : ConstInits =
  ci_loop(decls, tab, target, [], [])

fn ci_loop(ds: [Decl], tab: SymTab, target: String, out: [Decl], rows: [NEnt]) : ConstInits = match ds {
  [] -> ConstInits { decls: list_reverse(out), rows: list_reverse(rows) }
  [d, ...rest] -> match d {
    DConst(is_pub, s, ty, body, mo, l, c, nl, nc) ->
      if ci_is_body(body) {
        let row = NEnt(NCFn, ci_name(written_text(decl_name(tab, s))), ci_home(mo, target), is_pub, NmHelper)
        let init = fnid_decl(nent_sym(row))
        let fun = DFn(is_pub, init, [], [], Some(ty), REmpty, body, l, c, mo)
        ci_loop(rest, tab, target, [fun, DConst(is_pub, s, ty, ci_call(init, body), mo, l, c, nl, nc), ...out], [row, ...rows])
      } else { ci_loop(rest, tab, target, [d, ...out], rows) }
    _ -> ci_loop(rest, tab, target, [d, ...out], rows)
  }
}

# The function is spelled after its constant, so its symbol moves only
# when the constant is renamed. No source identifier spells the prefix,
# and a module declares a constant's name once.
fn ci_name(const_name: String) : String = string_concat("__kai_const_", const_name)

fn ci_home(mo: Option[String], target: String) : String = match mo {
  Some(m) -> m
  None    -> target
}

fn ci_is_body(e: Expr) : Bool =
  if ln_is_empty(ln_with_expr(ln_empty(), e)) { ci_has_lambda(e) } else { true }

fn ci_has_lambda(e: Expr) : Bool = match e.kind {
  ELambda(_, _) -> true
  _             -> ci_any_lambda(xp_positions(e))
}

fn ci_any_lambda(ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> ci_has_lambda(c) or ci_any_lambda(rest)
}

# The call stands where the body stood: same position, type and mode.
fn ci_call(init: FnId, body: Expr) : Expr = {
  let fty = match body.ty {
    Some(t) -> Some(TyFnT([], t, row_empty()))
    None    -> None
  }
  let callee = Expr { kind: ESym(fnid_sym(init), spec_none()), line: body.line, col: body.col,
                      ty: fty, mode: body.mode, site: body.site }
  Expr { kind: ECall(callee, []), line: body.line, col: body.col, ty: body.ty, mode: body.mode, site: body.site }
}

#[doc("The diagnostics for the constants of `decls` that reach themselves through the constants their initialisers read directly.")]
pub(pkg) fn const_cycle_diags(decls: [Decl], tab: SymTab, df: DiagFiles) : [Diagnostic] = {
  let consts = filter(decls, is_const)
  let ids = map(consts, const_id)
  let edges = flat_map(range_pairs(consts), (ic) => map(filter_map_idx(ids, ic.snd), (j) => (ic.fst, j)))
  let loops = filter(edges, (e) => e.fst == e.snd)
  let groups = scc_groups(list_length(consts), edges)
  flat_map(list_append(map(loops, (e) => [e.fst]), groups), (g) => const_cycle_diag(consts, g, tab, df))
}

fn is_const(d: Decl) : Bool = match d {
  DConst(_, s, _, _, _, _, _, _, _) -> sym_raw(s) >= 0
  _ -> false
}

fn const_id(d: Decl) : SymId = match d {
  DConst(_, s, _, _, _, _, _, _, _) -> s
  _ -> sym_none()
}

fn const_body(d: Decl) : Option[Expr] = match d {
  DConst(_, _, _, e, _, _, _, _, _) -> Some(e)
  _ -> None
}

fn range_pairs(ds: [Decl]) : [(Int, Decl)] = zip_index(ds, 0)

fn zip_index(ds: [Decl], i: Int) : [(Int, Decl)] = match ds {
  []           -> []
  [d, ...rest] -> [(i, d), ...zip_index(rest, i + 1)]
}

fn filter_map_idx(ids: [SymId], d: Decl) : [Int] = {
  let refs = match const_body(d) { Some(e) -> inline_syms(e)  None -> [] }
  index_all(ids, refs, 0)
}

fn index_all(ids: [SymId], refs: [SymId], i: Int) : [Int] = match ids {
  []           -> []
  [s, ...rest] -> if any(refs, (r) => sym_raw(r) == sym_raw(s)) { [i, ...index_all(rest, refs, i + 1)] } else { index_all(rest, refs, i + 1) }
}

fn inline_syms(e: Expr) : [SymId] = {
  let here = match e.kind { ESym(s, _) -> [s]  _ -> [] }
  list_append(here, flat_map(xp_positions(e), (p) => match p {
    XP(r, x) -> if xrole_inline(r) { inline_syms(x) } else { [] }
  }))
}

fn const_cycle_diag(consts: [Decl], members: [Int], tab: SymTab, df: DiagFiles) : [Diagnostic] =
  match nth_decl(consts, list_min(members)) {
    Some(first) -> match first {
      DConst(_, _, _, _, _, l, c, _, _) -> {
        let file = decl_diag_file(first, df)
        let names = flat_map(sort(members), (i) => match nth_decl(consts, i) { Some(d) -> [const_name(d, tab)]  None -> [] })
        [mk_diag(SevError, file, l, c, "constant `#{const_name(first, tab)}` is defined in terms of itself",
                 [ri_note(file, l, c, "the cycle runs through #{string_join(names, ", ")}")])]
      }
      _ -> []
    }
    None -> []
  }

fn const_name(d: Decl, tab: SymTab) : String = match d {
  DConst(_, s, _, _, _, _, _, _, _) -> written_text(decl_name(tab, s))
  _ -> ""
}

fn nth_decl(ds: [Decl], i: Int) : Option[Decl] = match ds {
  [d, ...rest] -> if i == 0 { Some(d) } else { nth_decl(rest, i - 1) }
  []           -> None
}

fn list_min(xs: [Int]) : Int = foldl(xs, 1000000000, (a, x) => if x < a { x } else { a })

# `lo..hi` interval patterns, at any depth, lowered to binders plus range
# checks conjoined into the arm guard.

# Rewrite `lo..hi` interval patterns, at any depth, into a binder plus a
# comparison conjoined into the arm guard — the shape a `case n when n >= lo
# and n <= hi` arm produces, so both backends lower it as an ordinary guard.
# The range checks run before the user's guard, which may rely on them. The
# bounds are literals (the parser rejects anything else).
#[doc("Rewrite `lo..hi` match patterns, at any depth, into binders plus `>= lo and <= hi` guard checks.")]
pub(pkg) fn desugar_range_patterns_decls(decls: [Decl]) : [Decl] =
  map(decls, (d) => drp_decl(d))

fn drp_decl(d: Decl) : Decl = match d {
  DFn(p, fid, tps, ps, ret, row, body, l, c, mo) ->
    DFn(p, fid, tps, ps, ret, row, drp_expr(body), l, c, mo)
  DTest(desc, body, l, c, mo) -> DTest(desc, drp_expr(body), l, c, mo)
  DBench(desc, body, l, c, mo) -> DBench(desc, drp_expr(body), l, c, mo)
  DConst(p, csym, ty, body, mo, l, c, nl, nc) -> DConst(p, csym, ty, drp_expr(body), mo, l, c, nl, nc)
  DUnstable(inner, l, c) -> DUnstable(drp_decl(inner), l, c)
  DProtoLaws(thy, inner, l, c, mo) -> DProtoLaws(thy, drp_decl(inner), l, c, mo)
  DImplAxiom(thy, inner, l, c, mo) -> DImplAxiom(thy, drp_decl(inner), l, c, mo)
  DConstructor(inner, l, c) -> DConstructor(drp_decl(inner), l, c)
  _ -> d
}

fn drp_expr(e: Expr) : Expr {
  match e.kind {
    EMatch(scr, arms) ->
      mk_expr(EMatch(drp_expr(scr), map(arms, (a) => drp_arm(a))), e.line, e.col)
    _ -> mk_expr(dsg_map_expr_kind(e.kind, (sub) => drp_expr(sub)), e.line, e.col)
  }
}

fn drp_arm(a: Arm) : Arm = match a {
  Arm(pat, guard, body) -> {
    let guard1 = match guard { Some(g) -> Some(drp_expr(g)) None -> None }
    match drp_pat(pat, []) {
      DrpPat(p1, checks) -> Arm(p1, drp_guard(list_reverse(checks), guard1), drp_expr(body))
    }
  }
}

# A pattern with its ranges replaced by binders, and the checks they owe
# (reversed source order).
type DrpPat = DrpPat(Pattern, [Expr])

fn drp_pat(p: Pattern, acc: [Expr]) : DrpPat = match p.pkind {
  PRange(lo, hi) -> {
    let nm = concat_all(["__range_", int_to_string(p.line), "_", int_to_string(p.col), "__"])
    let v = mk_name(nm, p.line, p.col)
    let ge = mk_expr(EBinop(BoGe, v, lo), p.line, p.col)
    let le = mk_expr(EBinop(BoLe, v, hi), p.line, p.col)
    DrpPat(mk_pat(PBind(binder_minted(nm)), p.line, p.col), [mk_expr(EBinop(BoAnd, ge, le), p.line, p.col), ...acc])
  }
  PVariant(cn, subs) -> match drp_pats(subs, [], acc) {
    DrpPats(subs1, acc1) -> DrpPat(mk_pat(PVariant(cn, subs1), p.line, p.col), acc1)
  }
  PVariantRecord(cn, fs) -> match drp_fields(fs, [], acc) {
    DrpFields(fs1, acc1) -> DrpPat(mk_pat(PVariantRecord(cn, fs1), p.line, p.col), acc1)
  }
  PRecord(fs) -> match drp_fields(fs, [], acc) {
    DrpFields(fs1, acc1) -> DrpPat(mk_pat(PRecord(fs1), p.line, p.col), acc1)
  }
  PList(ps, rest) -> match drp_pats(ps, [], acc) {
    DrpPats(ps1, acc1) -> DrpPat(mk_pat(PList(ps1, rest), p.line, p.col), acc1)
  }
  PAs(name, sub) -> match drp_pat(sub, acc) {
    DrpPat(sub1, acc1) -> DrpPat(mk_pat(PAs(name, sub1), p.line, p.col), acc1)
  }
  _ -> DrpPat(p, acc)
}

type DrpPats = DrpPats([Pattern], [Expr])

fn drp_pats(ps: [Pattern], out: [Pattern], acc: [Expr]) : DrpPats = match ps {
  [] -> DrpPats(list_reverse(out), acc)
  [q, ...rest] -> match drp_pat(q, acc) { DrpPat(q1, acc1) -> drp_pats(rest, [q1, ...out], acc1) }
}

type DrpFields = DrpFields([PField], [Expr])

fn drp_fields(fs: [PField], out: [PField], acc: [Expr]) : DrpFields = match fs {
  [] -> DrpFields(list_reverse(out), acc)
  [PField(n, sub, sh), ...rest] -> match drp_pat(sub, acc) {
    DrpPat(sub1, acc1) -> drp_fields(rest, [PField(n, sub1, sh), ...out], acc1)
  }
}

# The range checks, conjoined in source order ahead of the user's guard.
fn drp_guard(checks: [Expr], guard: Option[Expr]) : Option[Expr] = match checks {
  [] -> guard
  [c, ...rest] -> match drp_guard(rest, guard) {
    None -> Some(c)
    Some(g) -> Some(mk_expr(EBinop(BoAnd, c, g), c.line, c.col))
  }
}
