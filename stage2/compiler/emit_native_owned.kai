#[doc("""
What the partition that owns a program's singletons emits beyond the
functions it defines, as text for its cache key: the thunk of every
function, the default handlers it installs and the globals it defines
for them, the impl table it registers, and the runner driver.

Each part is read from the value its emitter walks, so the key moves
whenever the object would. A singleton the owner gains belongs here in
the same change, or two builds that differ only in it share one object.
""")]

import compiler.ast
import compiler.util
import compiler.kir
import compiler.rt_name
import compiler.symtab
import compiler.fnreg
import compiler.emit_shared
import compiler.emit_native_proto
import compiler.emit_native_test

#[doc("The text of what the owner of the singletons of `kp` emits for them in a `bmode` build, with a thunk for each function among `thunked`; `decl` gives a function's declaration text.")]
pub fn nowned_text(kp: KProgram, decls: [Decl], variants: [VariantEntry], fns: [EFn],
                   bmode: BuildMode, thunked: [KFn], decl: (KFn) -> String) : String =
  concat_all([
    "thunks\n", concat_all(map(thunked, (f) => nowned_thunk_text(f, decl))),
    "entry defaults\n", nowned_defaults_text(kp.tab, nemit_entry_defaults(kp, bmode)),
    "default globals\n", nowned_defaults_text(kp.tab, kp.synth_defaults),
    nproto_init_text(decls, kp.tab, kp.ids, variants, fns, kp.reuse_tags),
    "runners ", nowned_mode_word(bmode), "\n", concat_all(map(kp.runners, nowned_runner_text))
  ])

# A thunk forwards to its function as that function is declared; only these kinds get one.
fn nowned_thunk_text(f: KFn, decl: (KFn) -> String) : String = match f.kind {
  KFnNormal       -> decl(f)
  KFnFfi(_, _, _) -> decl(f)
  _               -> ""
}

fn nowned_defaults_text(tab: SymTab, ds: [KDefault]) : String = concat_all(map(ds, (d) => match d {
  KDef(eff, ops) -> concat_all([rt_name(tab, eff), ":", concat_all(map(ops, nowned_op_text)), "\n"])
}))

fn nowned_op_text(op: KDefOp) : String = match op {
  KDOp(name, sym, arity) -> concat_all([" ", name, "=", sym, "/", int_to_string(arity)])
}

fn nowned_mode_word(bmode: BuildMode) : String = match bmode {
  BMBuild -> "build"
  BMTest  -> "test"
  BMBench -> "bench"
  BMCheck -> "check"
}

fn nowned_runner_text(r: KRunner) : String =
  concat_all([r.sym, " ", int_to_string(r.line), " ", r.home, " ", nowned_kind_text(r.kind), " ", r.desc, "\n"])

fn nowned_kind_text(k: KRunnerKind) : String = match k {
  KRTest         -> "test"
  KRBench        -> "bench"
  KRCheck(specs) -> cat2("check ", string_join(specs, ";"))
}
