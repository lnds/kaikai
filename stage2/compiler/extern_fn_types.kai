#[doc("""
compiler.extern_fn_types — an `extern "C" fn` crosses the boundary in C types only.

The parser admits any capitalised name in an extern signature because it
cannot see which names are foreign. The names that are: the scalars, the
fixed-width annotations, and the `extern "C" type` / `extern "C" opaque`
declarations in the program. A signature naming anything else (an
ordinary record, a sum type, an alias) has no C layout, so the check
rejects it here instead of leaving the backend to fail.
""")]

import compiler.util
import compiler.ast
import compiler.diag
import compiler.diag_file
import compiler.emit_shared
import compiler.ffi_v2

#[doc("Reject an `extern \"C\" fn` whose parameter or return type is not a scalar, a fixed-width annotation, or a declared `extern \"C\" type`/`opaque`.")]
pub fn validate_extern_fn_types(decls: [Decl], df: DiagFiles) : Int / Console + File =
  extern_types_loop(decls, df, collect_extern_types(decls), 0)

fn extern_types_loop(decls: [Decl], df: DiagFiles, reg: [ExternTypeReg],
                     errs: Int) : Int / Console + File = match decls {
  [] -> errs
  [d, ...rest] -> extern_types_loop(rest, df, reg, errs + check_extern_fn(d, df, reg))
}

fn check_extern_fn(d: Decl, df: DiagFiles, reg: [ExternTypeReg]) : Int / Console + File = match d {
  DFn(_, name, _, params, ret, _, body, l, c, _, _) -> match body.kind {
    EExternBody(AbiC, _) -> {
      let n = check_params(params, d, df, name, l, c, reg, 0)
      match ret {
        Some(t) ->
          if boundary_ok(t, true, reg) { n }
          else {
            report_foreign_type(df, d, name, l, c, "return type", t)
            n + 1
          }
        None    -> n
      }
    }
    _ -> 0
  }
  DDoc(_, _, inner, _, _) -> check_extern_fn(inner, df, reg)
  DAttr(_, inner, _, _)   -> check_extern_fn(inner, df, reg)
  _ -> 0
}

fn check_params(params: [Param], d: Decl, df: DiagFiles, fname: String, l: Int, c: Int,
                reg: [ExternTypeReg], errs: Int) : Int / Console + File = match params {
  [] -> errs
  [p, ...rest] -> match p.ptype {
    None -> check_params(rest, d, df, fname, l, c, reg, errs)
    Some(t) ->
      if boundary_ok(t, false, reg) { check_params(rest, d, df, fname, l, c, reg, errs) }
      else {
        report_foreign_type(df, d, fname, l, c, concat_all(["parameter `", p.pname, "`"]), t)
        check_params(rest, d, df, fname, l, c, reg, errs + 1)
      }
  }
}

fn boundary_ok(t: TypeExpr, is_return: Bool, reg: [ExternTypeReg]) : Bool = match t.tkind {
  TyName(n, []) ->
    if n == "Unit" { is_return }
    else if is_scalar_name(n) { true }
    else { match extern_type_lookup(reg, n) { Some(_) -> true  None -> false } }
  _ -> false
}

fn is_scalar_name(n: String) : Bool =
  n == "Int" or n == "Real" or n == "Bool" or n == "Char" or n == "String"
    or n == "Int32" or n == "UInt32" or n == "UInt64"
    or (match ffi_fixed_of_name(n) { Some(_) -> true  None -> false })

fn report_foreign_type(df: DiagFiles, d: Decl, fname: String, l: Int, c: Int,
                       what: String, t: TypeExpr) : Unit / Console + File = {
  diag_error(decl_diag_file(d, df), l, c,
    concat_all(["`extern \"C\" fn ", fname, "` ", what, " has type `",
                type_surface_name(t), "`, which has no C layout"]))
  diag_help("allowed: Int, Real, Bool, Char, String, Unit (return only), fixed-width U8..F32, Int32, UInt32, UInt64, or a declared `extern \"C\" type` / `extern \"C\" opaque`")
}

fn type_surface_name(t: TypeExpr) : String = match t.tkind {
  TyName(n, [])    -> n
  TyName(n, targs) -> concat_all([n, "[", join_with(map(targs, type_surface_name), ", "), "]"])
  TyList(inner)    -> concat_all(["[", type_surface_name(inner), "]"])
  _                -> "?"
}
