#[doc("""
The type parameters a signature mentions.

Each parameter once, in the order the signature first uses it as a
type: the parameters, the return type, the row; a head's arguments
before the head. A pass that declares a function from a signature it
did not write lists its type parameters in this order.
""")]

import compiler.ast
import compiler.tbinder

#[doc("The type parameters a signature uses in type position, each once, in first-use order.")]
pub fn sig_param_ids(ps: [Param], ret: Option[TypeExpr], row: RowExpr) : [TLocalId] =
  tu_row(row, tu_opt(ret, tu_params(ps, [])))

#[doc("The type parameters `t` uses in type position not already in `acc`, appended in first-use order.")]
pub fn te_param_ids(t: TypeExpr, acc: [TLocalId]) : [TLocalId] = match t.tkind {
  TyParam(id, tas)    -> tids_add(tu_tys(tas, acc), id)
  TyName(_, tas)      -> tu_tys(tas, acc)
  TyList(inner)       -> te_param_ids(inner, acc)
  TyFn(fps, ret, row) -> tu_row(row, te_param_ids(ret, tu_tys(fps, acc)))
  TyDim(base, _)      -> te_param_ids(base, acc)
  TyRefine(base, _)   -> te_param_ids(base, acc)
  TyRow(row)          -> tu_row(row, acc)
  TySurface(ts)       -> tu_tys(tysurface_children(ts), acc)
}

fn tu_params(ps: [Param], acc: [TLocalId]) : [TLocalId] = match ps {
  []           -> acc
  [p, ...rest] -> tu_params(rest, tu_opt(p.ptype, acc))
}

fn tu_opt(o: Option[TypeExpr], acc: [TLocalId]) : [TLocalId] = match o {
  Some(t) -> te_param_ids(t, acc)
  None    -> acc
}

fn tu_tys(ts: [TypeExpr], acc: [TLocalId]) : [TLocalId] = match ts {
  []           -> acc
  [t, ...rest] -> tu_tys(rest, te_param_ids(t, acc))
}

fn tu_row(r: RowExpr, acc: [TLocalId]) : [TLocalId] = match r {
  REmpty       -> acc
  RClosed(ls)  -> tu_labels(ls, acc)
  ROpen(_, ls) -> tu_labels(ls, acc)
}

fn tu_labels(ls: [RowLabel], acc: [TLocalId]) : [TLocalId] = match ls {
  []                    -> acc
  [RL(_, tas), ...rest] -> tu_labels(rest, tu_tys(tas, acc))
}

#[doc("The binders of `scope` a signature uses in type position, in first-use order.")]
pub fn sig_used_binders(scope: [TBinder], ps: [Param], ret: Option[TypeExpr], row: RowExpr) : [TBinder] =
  tu_pick(scope, sig_param_ids(ps, ret, row))

fn tu_pick(scope: [TBinder], ids: [TLocalId]) : [TBinder] = match ids {
  []            -> []
  [id, ...rest] -> match tbs_find(scope, id) {
    Some(b) -> [b, ...tu_pick(scope, rest)]
    None    -> tu_pick(scope, rest)
  }
}
