#[doc("""
Result shapes of the `use` rewrite, and the names a clause binds over
the opens.
""")]

import compiler.ast
import compiler.written

#[doc("""
Per-Expr rewrite. `opens` is the effective list of effects active
at this point (file-level + outer block-level + fn-level + this
block's prior SUse declarations). `bound` is the list of
locally-bound names that shadow opens. The error count is threaded
through a record return.
""")]
pub type UseRw = { expr: Expr, errs: Int }

#[doc("""
Default-case dispatcher: applies use_rewrite_expr to every direct
sub-Expr via the shared visitor's children, threading the error
count.
""")]
pub type UseRwAcc = { errs: Int }

#[doc("""
Manual recursion: walk the same kinds dsg_map_expr_kind does, but
carry the per-Expr error counter forward. Mirrors the structural
cases of dsg_map_expr_kind exactly so adding a new ExprKind variant
breaks here at the same single match site.
""")]
pub type UseKindAcc = { kind: ExprKind, acc: UseRwAcc }

#[doc("A rewritten optional expression and the error count so far.")]
pub type UseRwOpt = { expr: Option[Expr], errs: Int }

#[doc("Rewritten expressions and the error count so far.")]
pub type UseRwExprs = { exprs: [Expr], errs: Int }

#[doc("Rewritten list elements and the error count so far.")]
pub type UseRwElems = { elems: [ListElem], errs: Int }

#[doc("Rewritten field initialisers and the error count so far.")]
pub type UseRwFields = { fields: [FieldInit], errs: Int }

#[doc("Rewritten arms and the error count so far.")]
pub type UseRwArms = { arms: [Arm], errs: Int }

#[doc("Rewritten handler clauses and the error count so far.")]
pub type UseRwClauses = { clauses: [HClause], errs: Int }

#[doc("A rewritten handler return and the error count so far.")]
pub type UseRwRet = { ret: Option[HReturn], errs: Int }

#[doc("""
Block-level: track SUse declarations as we walk; strip them from
the output. `local_opens` is the original outer scope; each SUse
extends it and the extension lives only for the rest of the block.
""")]
pub type UseRwBlock = { stmts: [Stmt], tail: Option[Expr], errs: Int }

#[doc("`acc` with the names the parameters bind.")]
pub fn use_param_names(ps: [Param], acc: [String]) : [String] {
  match ps {
    [] -> list_reverse(acc)
    [p, ...rest] -> use_param_names(rest, [written_text(p.binder.name), ...acc])
  }
}

#[doc("`bound` with the handler alias, when one is written.")]
pub fn use_alias_bound(alias: Option[Binder], bound: [String]) : [String] {
  match alias {
    None    -> bound
    Some(a) -> [written_text(a.name), ...bound]
  }
}
