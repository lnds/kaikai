#[doc("""
Ownership at the box→raw border, shared by both backends.

A boxed scalar read as a raw value either borrows or consumes its box. A
variable read borrows: the binding's own drop pays its reference. A call,
operator or compound expression hands the reader a fresh reference no
binding holds, so the reader releases it once the payload is out.
""")]

import compiler.ast
import compiler.sym_read
import compiler.fnreg

#[doc("True when the boxed value of `x` is an owned temporary the raw reader must release.")]
pub fn raw_border_owns(x: Expr) : Bool = match sym_read_kind(x.kind) {
  ECall(f, _)     -> raw_border_owning_callee(f)
  EMatch(_, _)    -> true
  EIf(_, _, _)    -> true
  EBlock(_, _)    -> true
  EBinop(_, _, _) -> true
  EUnop(_, _)     -> true
  EField(_, _)    -> true
  EIndex(_, _)    -> true
  _               -> false
}

# Compiler sentinels are transparent or manage their own RC; protocol impls
# and dispatchers are ordinary fns returning an owned result.
fn raw_border_owning_callee(f: Expr) : Bool = match sym_read_kind(f.kind) {
  EVar(nm)       -> not string_starts_with_q(nm, "__") or
                      string_starts_with_q(nm, "__pimpl_") or
                      string_starts_with_q(nm, "__proto_")
  EModCall(_, _) -> true
  EMark(m)       -> raw_border_owning_mark(m)
  _              -> false
}

# Perceus marks a move into a borrowing slot for the caller to release.
fn raw_border_owning_mark(m: Mark) : Bool = match m {
  MkOwnedBorrow -> true
  _             -> false
}

#[doc("""
The operand of a `__perceus_dup` wrap, or `x` itself.

A scalar read raw never retains its box, so the dup and the release the
reader would owe for it cancel: the raw reader borrows the operand instead.
""")]
pub fn raw_border_strip_dup(x: Expr) : Expr = match x.kind {
  ECall(callee, args_) -> match sym_read_kind(callee.kind) {
    EVar(nm) -> if nm == "__perceus_dup" { raw_border_dup_operand(args_, x) } else { x }
    _        -> x
  }
  _ -> x
}

fn raw_border_dup_operand(args_: [Expr], x: Expr) : Expr = match args_ {
  [inner] -> inner
  _       -> x
}
