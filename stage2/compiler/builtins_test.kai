#[doc("""
The builtin registry as `--builtin-table` prints it, checked first against
the resolver's core names and the typer's seed.

Each line is `<name> <C entry> <arity>`, one per entry of `core_table`;
`tools/builtin-table-gate.sh` matches every line against the forwarders in
both runtimes. The report starts with `FAIL` when the resolver binds an entry
the table leaves unbound or the reverse, or when an entry has no typer scheme
or one taking another number of arguments. `--builtin-names` prints the
names a bare use binds, for the gates that generate programs over them.
""")]

import compiler.ast
import compiler.util
import compiler.builtin_types
import compiler.builtins
import compiler.core_prims
import compiler.resolve
import compiler.infer

#[doc("Every core builtin name a bare use binds, one per line, as `--builtin-names` prints it.")]
pub fn builtin_names_report() : String = string_join(map(core_builtin_names(), (n) => cat2(n, "\n")), "")

#[doc("The registry lines, or a `FAIL` line naming the first entry the resolver or the typer disagrees on.")]
pub fn builtin_table_report() : String = {
  let names = core_names()
  let seed = add_core_sigs(ty_env_empty()).entries
  bt_report(core_table(), BtView { names: names, unbound: bt_unbound(builtin_table()), seed: seed }, [])
}

type BtView = { names: [String], unbound: [String], seed: [TyEntry] }

fn bt_unbound(bs: [Builtin]) : [String] = match bs {
  [] -> []
  [BF(name, entry, _), ...rest] -> if builtin_bound(entry) { bt_unbound(rest) } else { [name, ...bt_unbound(rest)] }
}

fn bt_report(tbl: [ECore], v: BtView, acc: [String]) : String = match tbl {
  [] -> string_join(list_reverse(acc), "")
  [EP(name, cname, arity), ...rest] -> match bt_disagreement(name, arity, v) {
    Some(why) -> cat3("FAIL ", name, cat2(": ", why))
    None      -> bt_report(rest, v, [bt_line(name, cname, arity), ...acc])
  }
}

fn bt_line(name: String, cname: String, arity: Int) : String =
  cat3(cat2(name, " "), cat2(cname, " "), cat2(int_to_string(arity), "\n"))

fn bt_disagreement(name: String, arity: Int, v: BtView) : Option[String] =
  if list_has(v.names, name) == list_has(v.unbound, name) { Some("the resolver's binding disagrees with the table") }
  else { bt_arity_disagreement(arity, bt_seed_arity(v.seed, name), bt_is_borrow(name)) }

# A `_borrow` sibling is synthesised after inference, so only it lacks a scheme.
fn bt_arity_disagreement(arity: Int, typed: Option[Int], borrow: Bool) : Option[String] = match typed {
  Some(n) -> if n == arity { None } else { Some(cat2("the typer's scheme takes ", int_to_string(n))) }
  None    -> if borrow { None } else { Some("no typer scheme") }
}

fn bt_is_borrow(name: String) : Bool = list_has(map(core_borrowing_prims(), (b) => cat2(b, "_borrow")), name)

fn bt_seed_arity(seed: [TyEntry], name: String) : Option[Int] = match seed {
  [] -> None
  [e, ...rest] -> if e.name == name { Some(bt_scheme_arity(e.scheme)) } else { bt_seed_arity(rest, name) }
}

fn bt_scheme_arity(s: TyScheme) : Int = match s {
  Scheme(_, _, _, _, TyFnT(ps, _, _)) -> list_length(ps)
  Scheme(_, _, _, _, _)               -> 0
}
