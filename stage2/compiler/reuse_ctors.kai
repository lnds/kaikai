#[doc("""
Which constructors Perceus turned into reuse targets, shared by both backends.

The runtime interns a variant whose slots are all immortal. Interning a reuse
target saturates its refcount, so `kai_check_unique` never passes and the
cell is never rewritten in place. Each backend stamps the tags returned by
`reusable_tags` into the runtime at startup so construction leaves them out
of the intern table.
""")]

import compiler.ast
import compiler.expr_positions
import compiler.emit_shared
import compiler.ctor_ix
import compiler.live_fns

#[doc("The tags of every constructor a `__perceus_reuse_variant` rebuild names in a function of the post-Perceus `decls` that can run. Functions that never run are left out, so the table does not depend on how much of the core a build lowered. `ctors` are the constructors' rows by id; `entry` is the program's entry point.")]
pub fn reusable_tags(decls: [Decl], ids: ProtoIds, ctors: CtorIx, entry: SymId) : [Int] =
  list_reverse(collect_reuse_tags(live_decls(decls, ids, entry), ctors, []))

fn reuse_site_tag(ctors: CtorIx, ctor: Expr) : Option[Int] = match reuse_site_row(ctors, ctor) {
  Some(row) -> Some(ctor_row_tag(row))
  None      -> None
}

fn reuse_site_row(ctors: CtorIx, ctor: Expr) : Option[VariantEntry] = match ctor.kind {
  ECall(cf, _) -> ctor_ix_site(ctors, cf)
  _            -> None
}

#[doc("The constructor a rebuild call names, when its callee is one `ctors` lays out.")]
pub fn reuse_ctor_id(ctors: CtorIx, ctor: Expr) : Option[SymId] = match ctor.kind {
  ECall(cf, _) -> match cf.kind {
    ESym(s, _) -> match ctor_ix_row(ctors, s) {
      Some(_) -> Some(s)
      None    -> None
    }
    _ -> None
  }
  _ -> None
}

#[doc("Whether a pattern's constructor and a rebuild's are the same declaration.")]
pub fn reuse_same_ctor(p: DeclRef, b: SymId) : Bool = sym_raw(b) >= 0 and sym_same(ref_sym(p), b)

# Newest first, each tag once.
fn collect_reuse_tags(decls: [Decl], cx: CtorIx, acc: [Int]) : [Int] = match decls {
  []           -> acc
  [d, ...rest] -> collect_reuse_tags(rest, cx, collect_reuse_tags_decl(d, cx, acc))
}

fn collect_reuse_tags_decl(d: Decl, cx: CtorIx, acc: [Int]) : [Int] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _) -> walk_reuse_tags(body, cx, acc)
  DTest(_, body, _, _, _)     -> walk_reuse_tags(body, cx, acc)
  DBench(_, body, _, _, _)    -> walk_reuse_tags(body, cx, acc)
  DCheck(_, _, body, _, _, _) -> walk_reuse_tags(body, cx, acc)
  _ -> acc
}

fn walk_reuse_tags(e: Expr, cx: CtorIx, acc: [Int]) : [Int] =
  walk_reuse_tags_positions(xp_positions(e), cx, add_reuse_tag(e.kind, cx, acc))

fn walk_reuse_tags_positions(ps: [XPos], cx: CtorIx, acc: [Int]) : [Int] = match ps {
  []                 -> acc
  [XP(_, x), ...rest] -> walk_reuse_tags_positions(rest, cx, walk_reuse_tags(x, cx, acc))
}

fn add_reuse_tag(k: ExprKind, cx: CtorIx, acc: [Int]) : [Int] = match k {
  ECall(callee, [_scr, ctor]) ->
    if is_reuse_variant_callee(callee) {
      match reuse_site_tag(cx, ctor) {
        Some(t) -> if any(acc, (x) => x == t) { acc } else { [t, ...acc] }
        None    -> acc
      }
    } else { acc }
  _ -> acc
}

fn is_reuse_variant_callee(callee: Expr) : Bool = match callee.kind {
  EMark(MkReuseVariant) -> true
  _                     -> false
}

#[doc("TEMPORARY. A rebuild's constructor is its id (`reuse_ctor_id`); kept so the callers still resolve until they read it.")]
pub type ReuseCtorName = RCN(Option[String], String)

#[doc("TEMPORARY. The answer of `reuse_ctor_home_name`, which fits no match.")]
pub type ReuseCtorGone = | ReuseCtorGone

#[doc("TEMPORARY. Call `reuse_ctor_id`.")]
pub fn reuse_ctor_home_name(ctors: CtorIx, ctor: Expr) : ReuseCtorGone = ReuseCtorGone
