#[doc("""
Which constructors Perceus turned into reuse targets, shared by both backends.

The runtime interns a variant whose slots are all immortal. Interning a reuse
target saturates its refcount, so `kai_check_unique` never passes and the
cell is never rewritten in place. Each backend stamps the tags returned by
`reusable_tags` into the runtime at startup so construction leaves them out
of the intern table.
""")]

import compiler.ast
import compiler.expr_positions
import compiler.emit_shared
import compiler.ctor_ix
import compiler.sym_read
import compiler.live_fns

#[doc("A rebuild's constructor: the module that declares it, if known, and its name.")]
pub type ReuseCtorName = RCN(Option[String], String)

# The variant table and its rows by constructor id. The callers hold no
# root name, so the index is built without one: a constructor it does not
# answer is the root's.
type RtCx = { variants: [VariantEntry], ctors: CtorIx }

#[doc("The tags of every constructor a `__perceus_reuse_variant` rebuild names in a function of the post-Perceus `decls` that can run. Functions that never run are left out, so the table does not depend on how much of the core a build lowered. `entry` is the program's entry point.")]
pub fn reusable_tags(decls: [Decl], variants: [VariantEntry], entry: SymId) : [Int] =
  list_reverse(collect_reuse_tags(live_decls(decls, entry), RtCx { variants: variants, ctors: ctor_ix_build(variants, decls, None) }, []))

# A rebuild resolved by id answers from its row. Any other is keyed by the
# module that declares it: its type's home, else the qualifier it was
# written with.
fn reuse_site_tag(cx: RtCx, ctor: Expr) : Option[Int] = match reuse_site_row(cx.ctors, ctor) {
  Some(row) -> Some(ctor_row_tag(row))
  None      -> match reuse_ctor_spelled(ctor) {
    Some(RCN(q, cname)) -> match ctor.ty {
      Some(TyCon(Some(m), _, _, _)) -> evar_find_tag_opt_in(cx.variants, Some(m), cname)
      _                             -> evar_find_tag_opt_in(cx.variants, q, cname)
    }
    None -> None
  }
}

fn reuse_site_row(ctors: CtorIx, ctor: Expr) : Option[VariantEntry] = match ctor.kind {
  ECall(cf, _) -> ctor_ix_site(ctors, cf)
  _            -> None
}

# The rebuild's ctor as its callee spells it. A reference reads as the
# bare name it carries.
fn reuse_ctor_spelled(ctor: Expr) : Option[ReuseCtorName] = match ctor.kind {
  ECall(cf, _) -> match sym_read_kind(cf.kind) {
    EVar(cname)          -> Some(RCN(None, cname))
    EModCall(m, cname)   -> Some(RCN(Some(m), cname))
    _                    -> None
  }
  _ -> None
}

#[doc("The ctor a rebuild call names: the home and name of its row when the callee carries its id, else the qualifier it was written with, which may name the type rather than the module.")]
pub fn reuse_ctor_home_name(ctors: CtorIx, ctor: Expr) : Option[ReuseCtorName] = match ctor.kind {
  ECall(cf, _) -> match cf.kind {
    ESym(_, _, _) -> match ctor_ix_site(ctors, cf) {
      Some(EV(home, cname, _, _, _)) -> Some(RCN(home, cname))
      None                           -> None
    }
    EVar(cname)          -> Some(RCN(None, cname))
    EModCall(m, cname)   -> Some(RCN(Some(m), cname))
    _                    -> None
  }
  _ -> None
}

#[doc("Whether a pattern's ctor and a rebuild's ctor are the same: names match and homes do not contradict.")]
pub fn reuse_same_ctor(phome: Option[String], pname: String, b: ReuseCtorName) : Bool =
  match b {
    RCN(bhome, bname) ->
      bname == pname and (ctor_home_matches(bhome, phome) or ctor_home_matches(phome, bhome))
  }

# Newest first, each tag once.
fn collect_reuse_tags(decls: [Decl], cx: RtCx, acc: [Int]) : [Int] = match decls {
  []           -> acc
  [d, ...rest] -> collect_reuse_tags(rest, cx, collect_reuse_tags_decl(d, cx, acc))
}

fn collect_reuse_tags_decl(d: Decl, cx: RtCx, acc: [Int]) : [Int] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _, _) -> walk_reuse_tags(body, cx, acc)
  DTest(_, body, _, _, _)     -> walk_reuse_tags(body, cx, acc)
  DBench(_, body, _, _, _)    -> walk_reuse_tags(body, cx, acc)
  DCheck(_, _, body, _, _, _) -> walk_reuse_tags(body, cx, acc)
  _ -> acc
}

fn walk_reuse_tags(e: Expr, cx: RtCx, acc: [Int]) : [Int] =
  walk_reuse_tags_positions(xp_positions(e), cx, add_reuse_tag(e.kind, cx, acc))

fn walk_reuse_tags_positions(ps: [XPos], cx: RtCx, acc: [Int]) : [Int] = match ps {
  []                 -> acc
  [XP(_, x), ...rest] -> walk_reuse_tags_positions(rest, cx, walk_reuse_tags(x, cx, acc))
}

fn add_reuse_tag(k: ExprKind, cx: RtCx, acc: [Int]) : [Int] = match k {
  ECall(callee, [_scr, ctor]) ->
    if is_reuse_variant_callee(callee) {
      match reuse_site_tag(cx, ctor) {
        Some(t) -> if any(acc, (x) => x == t) { acc } else { [t, ...acc] }
        None    -> acc
      }
    } else { acc }
  _ -> acc
}

fn is_reuse_variant_callee(callee: Expr) : Bool = match callee.kind {
  EMark(MkReuseVariant) -> true
  _                     -> false
}
