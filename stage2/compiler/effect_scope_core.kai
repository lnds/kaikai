# compiler/effect_scope_core.kai — the core stream through the effect pass.

import compiler.ast
import compiler.modules
import compiler.symtab
import compiler.scope_file
import compiler.effect_scope_table
import compiler.effect_scope
import compiler.module_table

#[doc("The core stream through the same pass, each declaration from its own module's viewpoint: a core signature's effects settle to declarations like any other.")]
pub fn es_core_decls(ds: [Decl], scopes: [ModScope], global: [ModuleEntry],
      target: String, tab: SymTab, views: FileViews) : [Decl] = {
  let mk = (h: String) => es_ctx(h, target, scopes, global, tab, views)
  es_core_loop(ds, mk(target), mk, target)
}

# Consecutive declarations share a module, so one context serves the run.
fn es_core_loop(ds: [Decl], cx: ESCtx, mk: (String) -> ESCtx, target: String) : [Decl] = match ds {
  [] -> []
  [d, ...rest] -> {
    let h = decl_home_hint_reset(d, target, target)
    let cx1 = if h == cx.home { cx } else { mk(h) }
    [es_decl(d, cx1), ...es_core_loop(rest, cx1, mk, target)]
  }
}
