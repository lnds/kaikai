# compiler/effect_scope_check.kai — the root's ambiguous bare effect
# names. A bare name the ladder cannot settle stays bare, and the
# resolver would report it as unknown; it is named as an ambiguity
# here instead, before that.

import compiler.ast
import compiler.modules_segments
import compiler.diag
import compiler.diag_file
import compiler.expr_positions
import compiler.decl_names
import compiler.name_report
import compiler.effect_scope_table
import compiler.effect_scope
import compiler.symtab
import compiler.scope_file
import compiler.written
import compiler.module_tables

#[doc("The error for every bare effect name of the root file that the ladder leaves contested, in source order.")]
pub fn eschk_segmented(segs: [ImportSeg], decls: [Decl], coll: [ESEntry],
      tabs: ModTables, target: String,
      tab: SymTab, views: FileViews, df: DiagFiles) : [Diagnostic] =
  if list_length(coll) == 0 { [] }
  else {
    let cx = es_ctx(target, target, tabs, tab, views)
    finalize_diags(eschk_decls(seg_root(segs, decls), cx, df_root(df), []))
  }

fn seg_root(segs: [ImportSeg], decls: [Decl]) : [Decl] = match segs {
  [] -> decls
  [ISeg(_, n), ...rest] -> seg_root(rest, seg_drop(decls, n))
}

# The walk accumulates newest first.
fn eschk_decls(ds: [Decl], cx: ESCtx, file: String, acc: [Diagnostic]) : [Diagnostic] = match ds {
  [] -> acc
  [d, ...rest] -> eschk_decls(rest, cx, file, eschk_decl(d, cx, file, acc))
}

fn eschk_decl(d: Decl, cx: ESCtx, file: String, acc: [Diagnostic]) : [Diagnostic] = match d {
  DFn(_, _, _, ps, ret, row, body, l, c, _) ->
    eschk_expr(body, cx, file, eschk_ty_opt(ret, cx, file, l, c,
      eschk_tys(es_param_tys(ps, []), cx, file, l, c, eschk_row(row, cx, file, l, c, acc))))
  DConst(_, _, ty, body, _, l, c) -> eschk_expr(body, cx, file, eschk_ty(ty, cx, file, l, c, acc))
  DTest(_, body, _, _, _)  -> eschk_expr(body, cx, file, acc)
  DBench(_, body, _, _, _) -> eschk_expr(body, cx, file, acc)
  DCheck(_, _, body, _, _, _) -> eschk_expr(body, cx, file, acc)
  DUse(eff, l, c) -> eschk_name(eff, cx, file, l, c, acc)
  DDerive(_, inner, _, _)        -> eschk_decl(inner, cx, file, acc)
  DUnstable(inner, _, _)         -> eschk_decl(inner, cx, file, acc)
  DProtoLaws(_, inner, _, _, _)  -> eschk_decl(inner, cx, file, acc)
  DImplAxiom(_, inner, _, _, _)  -> eschk_decl(inner, cx, file, acc)
  DConstructor(inner, _, _)      -> eschk_decl(inner, cx, file, acc)
  DDoc(_, _, inner, _, _)        -> eschk_decl(inner, cx, file, acc)
  DAttr(_, inner, _, _)          -> eschk_decl(inner, cx, file, acc)
  _ -> acc
}

fn es_param_tys(ps: [Param], acc: [TypeExpr]) : [TypeExpr] = match ps {
  [] -> acc
  [p, ...rest] -> match p.ptype {
    Some(t) -> es_param_tys(rest, [t, ...acc])
    None -> es_param_tys(rest, acc)
  }
}

fn eschk_tys(ts: [TypeExpr], cx: ESCtx, file: String, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match ts {
  [] -> acc
  [t, ...rest] -> eschk_tys(rest, cx, file, l, c, eschk_ty(t, cx, file, l, c, acc))
}

fn eschk_ty_opt(o: Option[TypeExpr], cx: ESCtx, file: String, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match o {
  None -> acc
  Some(t) -> eschk_ty(t, cx, file, l, c, acc)
}

fn eschk_ty(t: TypeExpr, cx: ESCtx, file: String, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match t.tkind {
  TyName(_, ts) -> eschk_tys(ts, cx, file, l, c, acc)
  TyParam(_, ts) -> eschk_tys(ts, cx, file, l, c, acc)
  TyList(x) -> eschk_ty(x, cx, file, l, c, acc)
  TyFn(ps, r, row) -> eschk_row(row, cx, file, l, c, eschk_ty(r, cx, file, l, c, eschk_tys(ps, cx, file, l, c, acc)))
  TyDim(x, _) -> eschk_ty(x, cx, file, l, c, acc)
  TyRefine(x, _) -> eschk_ty(x, cx, file, l, c, acc)
  TyRow(row) -> eschk_row(row, cx, file, l, c, acc)
  _ -> acc
}

# A row label carries no position of its own; the declaration's stands in.
fn eschk_row(r: RowExpr, cx: ESCtx, file: String, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match r {
  REmpty -> acc
  RClosed(ls) -> eschk_labels(ls, cx, file, l, c, acc)
  ROpen(_, ls) -> eschk_labels(ls, cx, file, l, c, acc)
}

fn eschk_labels(ls: [RowLabel], cx: ESCtx, file: String, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match ls {
  [] -> acc
  [RL(r, ts), ...rest] ->
    eschk_labels(rest, cx, file, l, c, eschk_tys(ts, cx, file, l, c, eschk_ref(r, cx, file, l, c, acc)))
}

fn eschk_expr(e: Expr, cx: ESCtx, file: String, acc: [Diagnostic]) : [Diagnostic] = {
  let here = match e.kind {
    EHandle(_, r, _, _, _, _, _) -> eschk_ref(r, cx, file, e.line, e.col, acc)
    EField(obj, _) -> match obj.kind {
      EName(n) -> eschk_name(written_text(n), cx, file, obj.line, obj.col, acc)
      _ -> acc
    }
    _ -> acc
  }
  eschk_children(xp_positions(e), cx, file, here)
}

fn eschk_children(ps: [XPos], cx: ESCtx, file: String, acc: [Diagnostic]) : [Diagnostic] = match ps {
  [] -> acc
  [XP(_, child), ...rest] -> eschk_children(rest, cx, file, eschk_expr(child, cx, file, acc))
}

# Only a bare name can be contested: a settled reference names its
# declaration, and a qualifier is the choice.
fn eschk_ref(r: DeclRef, cx: ESCtx, file: String, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match r {
  DrWritten(None, n) -> eschk_name(written_text(n), cx, file, l, c, acc)
  _                  -> acc
}

fn eschk_name(n: String, cx: ESCtx, file: String, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] =
  match es_contested(cx, n) {
    [] -> acc
    homes -> [nr_ambiguous_diag(file, l, c, NCEffect, n, homes, "", cx.mt), ...acc]
  }
