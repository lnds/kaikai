pub(pkg) type StampRunOut = { rd: ResolvedDecls, chk: Int, all_decls: [Decl], stamped: Stamped, proto_reg: ProtocolReg, stamp_ids: [SymId], nursery_brands: [BrandRec], nursery_calls: [BrandCall] }

pub(pkg) type StampRun = { opened: OpenedOut, loaded: LoadedOut, cutrun: CutRunOut, tablesrun: TablesRunOut, accessed: AccessedOut, regioned: RegionedOut, lowered: LoweredOut, ready: ReadyOut, stamprun: StampRunOut }

pub(pkg) type SolvedOut = { core_hit: Option[String], pcut: PoolCut, cut: CoreCut }

pub(pkg) type Solved = { opened: OpenedOut, loaded: LoadedOut, cutrun: CutRunOut, tablesrun: TablesRunOut, accessed: AccessedOut, regioned: RegionedOut, lowered: LoweredOut, ready: ReadyOut, stamprun: StampRunOut, solved: SolvedOut }

pub(pkg) type InferRunOut = { all_decls: [Decl], dropped: [SymId], pruned: Bool, dm: Option[Demand], typed_tab: SymTab, tin: TyperIn, typed_prog0: TypedProgram }

pub(pkg) type InferRun = { opened: OpenedOut, loaded: LoadedOut, cutrun: CutRunOut, tablesrun: TablesRunOut, accessed: AccessedOut, regioned: RegionedOut, lowered: LoweredOut, stamprun: StampRunOut, solved: SolvedOut, inferrun: InferRunOut }

pub(pkg) type CheckedOut = { proto_reg: ProtocolReg, typed_prog: TypedProgram, typed_vds: [Verdict] }

pub(pkg) type Checked = { opened: OpenedOut, loaded: LoadedOut, cutrun: CutRunOut, tablesrun: TablesRunOut, accessed: AccessedOut, regioned: RegionedOut, lowered: LoweredOut, stamprun: StampRunOut, solved: SolvedOut, inferrun: InferRunOut, checked: CheckedOut }

pub(pkg) fn stage_stamp(req: Req, cx: Ready) : StampRun / Console + File + Mutable {
  let all_decls = cx.lowered.all_decls
  let callee_ops = cx.lowered.callee_ops
  let core_mods = req.core_mods
  let diag_ctx = cx.tablesrun.diag_ctx
  let front = cx.ready.front
  let lowered = cx.lowered.lowered
  let proto_reg = cx.lowered.proto_reg
  let sym_tab = cx.lowered.sym_tab
  let sym_views = cx.tablesrun.sym_views
  let target_mod_name = root_module_name(req.path)
  let rd0 = resolve_decls_stamped(diag_ctx, all_decls, sym_views, sym_tab, target_mod_name, callee_ops, loops_on(req.mode))
  let nursery_rw = if rd0.env.rs.nursery_used { rewrite_nursery_caps_decls(rd0.decls, rd0.env.rs.nursery, core_mod_names(core_mods, []), diag_ctx) }
                   else { NurseryRwProgram { decls: rd0.decls, brands: [], calls: [] } }
  let brand_diags = if df_quiet(diag_ctx) { [] }
                    else { check_nursery_brand_mismatch_decls(nursery_rw.decls, sym_tab, diag_ctx, nursery_rw.calls, nursery_rw.brands) }
  let rd = ResolvedDecls { ...rd0, decls: nursery_rw.decls, diags: list_append(rd0.diags, brand_diags) }
  let chk = rd.errs + list_length(filter(brand_diags, diag_is_error))
  let all_decls = rd.decls
  let stamped = stamped_registry(front, proto_reg, all_decls, sym_tab)
  let proto_reg = reg_with_walked(stamped.reg, walked_impls(stamped.reg.impls, lowered.derived, all_decls))
  let stamp_ids = stamp_targets(proto_reg.impls, lowered.derived, core_mod_names(core_mods, []))
  StampRun { opened: cx.opened, loaded: cx.loaded, cutrun: cx.cutrun, tablesrun: cx.tablesrun, accessed: cx.accessed, regioned: cx.regioned, lowered: cx.lowered, ready: cx.ready, stamprun: StampRunOut { rd: rd, chk: chk, all_decls: all_decls, stamped: stamped, proto_reg: proto_reg, stamp_ids: stamp_ids, nursery_brands: nursery_rw.brands, nursery_calls: nursery_rw.calls } }
}

pub(pkg) fn stage_solve(req: Req, cx: StampRun) : Flow[Solved] / Console + File + Mutable {
  let all_decls = cx.stamprun.all_decls
  let chk = cx.stamprun.chk
  let core_hit = cx.cutrun.core_hit
  let core_mods = req.core_mods
  let emptied = list_append(cx.cutrun.emptied, list_append(impl_hold_syms(cx.lowered.held_impls), impl_origin_syms(cx.lowered.emptied_impls)))
  let json = cx.opened.json
  let lib_mods = cx.cutrun.lib_mods
  let pcut = cx.cutrun.pcut
  let proto_reg = cx.stamprun.proto_reg
  let prunes = cx.cutrun.prunes
  let rd = cx.stamprun.rd
  let sym_tab = cx.lowered.sym_tab
  let pcut = if chk == 0 and prunes {
               core_pool(sym_tab, all_decls, list_append(core_mod_names(core_mods, []), lib_mods), proto_reg, emptied, false)
             } else { pool_none(all_decls) }
  let cut = pcut.cut
  let missed = match cut { CoreCut(_, _, m) -> m }
  if chk != 0 { Halt(vd_exit(json, [Verdict(chk, rd.diags)])) }
  else if list_length(missed) > 0 { Halt(core_cut_fail("keeps a function the early cut emptied", core_cut_names(sym_tab, missed))) }
  else { Go(Solved { opened: cx.opened, loaded: cx.loaded, cutrun: cx.cutrun, tablesrun: cx.tablesrun, accessed: cx.accessed, regioned: cx.regioned, lowered: cx.lowered, ready: cx.ready, stamprun: cx.stamprun, solved: SolvedOut { core_hit: core_hit, pcut: pcut, cut: cut } }) }
}

pub(pkg) fn stage_infer(req: Req, cx: Solved) : Flow[InferRun] / Console + File + Mutable {
  let all_decls = cx.stamprun.all_decls
  let core_cache = req.core_cache
  let core_decls_whole = cx.cutrun.core_decls_whole
  let cut = cx.solved.cut
  let emptied = cx.cutrun.emptied
  let front = cx.ready.front
  let front_cx_of = cx.ready.front_cx_of
  let lib_mods = cx.cutrun.lib_mods
  let mode = req.mode
  let path = req.path
  let pcut = cx.solved.pcut
  let proto_reg = cx.stamprun.proto_reg
  let prunes = cx.cutrun.prunes
  let rd = cx.stamprun.rd
  let stamped = cx.stamprun.stamped
  let surface_decls_whole = cx.cutrun.surface_decls_whole
  let sym_tab = cx.lowered.sym_tab
  let target_mod_name = root_module_name(req.path)
  let user_cache = req.user_cache
  # Build the per-compile head-owner cache once from the
  # post-`expand_imports` decl stream + the
  # full module table (cores + transitively imported +
  # the target file itself). The typer threads this cache
  # into `synth_pipe_dispatch` so any in-scope `pub type`
  # whose declaring module exports the canonical
  # `map / flat_map / filter` participates in `|`, `||`,
  # `|?` automatically — no compiler change required when
  # a downstream package adds a new pipe-eligible type.
  prune_note(core_cache.stats, prunes, cut)
  let whole_decls = all_decls
  let all_decls = match cut { CoreCut(kept, _, _) -> kept }
  let dropped = list_append(match cut { CoreCut(_, d, _) -> d }, cx.cutrun.gone)
  let pruned = match dropped { [] -> false _ -> true }
  let whole_decls = pcut.stream
  # The typed blobs follow the sources, so an explicit
  # project directory wins over the entry's own: the
  # native paths compile a copy of the entry from an
  # ephemeral object-cache dir, and deriving the cache
  # from that copy publishes blobs nothing ever reads.
  # With the project cache off, a typecheck-only run rides
  # the shared core-cache directory: the blobs are
  # content-addressed by a key folding the module's decls,
  # its inherited interface hash and the cross-module
  # context, so a toolchain-scoped directory serves them
  # safely, and without it the stdlib core is re-inferred
  # on every invocation. Restricted to the modes that stop
  # at the front-end: a build publishes one blob per module
  # and the whole-compiler selfhost pays that serialisation
  # on every run for a cache it never reads back.
  let tcut_dir = typed_cut_dir(mode, user_cache, core_cache, path)
  # Mutual tail recursion is fused into one
  # self-recursive function ahead of inference, so the
  # synthesised dispatch is typed like any other body and
  # the self-tail rewrite downstream turns the cycle into
  # the goto-loop it already emits.
  let fused = pub_loop_workers(tailfuse_decls(tailnorm_decls(whole_decls), sym_tab, target_mod_name), sym_tab, target_mod_name)
  let dm = if pruned { Some(demand_new(fused.decls, pcut, proto_reg, true)) } else { None }
  let front_src = FrontSrc { cx_of: front_cx_of, core: core_decls_whole, libs: precut_lib_fns(surface_decls_whole, lib_mods), impls: cx.lowered.held_impls, origins: cx.lowered.emptied_impls,
                             stream: whole_decls, held: pcut.held, env: rd.env }
  let defer = TcDefer { demand: dm, order: fused.decls, stats: core_cache.stats, front: Some(front_src) }
  # The fused functions are declarations the typer must name.
  let typed_tab = st_extend(sym_tab, fused.rows)
  let tin = typer_in(front, stamped.view, whole_decls, typed_tab)
  let tout = tcut_infer_demand(path, fused.decls, tcut_dir, tin, defer, match mode { MDumpSymIds -> true  MInfer -> true  _ -> false })
  let typed_prog0 = match tout { TcOut(tp, _) -> tp }
  let asked_bare = match tout { TcOut(_, ms) -> ms }
  if list_length(asked_bare) > 0 { Halt(core_cut_fail("asks for a function the early cut emptied", core_cut_names(sym_tab, asked_bare))) }
  else { Go(InferRun { opened: cx.opened, loaded: cx.loaded, cutrun: cx.cutrun, tablesrun: cx.tablesrun, accessed: cx.accessed, regioned: cx.regioned, lowered: cx.lowered, stamprun: cx.stamprun, solved: cx.solved, inferrun: InferRunOut { all_decls: all_decls, dropped: dropped, pruned: pruned, dm: dm, typed_tab: typed_tab, tin: tin, typed_prog0: typed_prog0 } }) }
}

pub(pkg) fn stage_check(req: Req, cx: InferRun) : Flow[Checked] / Console + File + Mutable {
  let core_mods = req.core_mods
  let diag_ctx = cx.tablesrun.diag_ctx
  let entry = entry_id(root_module_name(req.path), runs_blocks(req.mode))
  let dm = cx.inferrun.dm
  let early_const_uses = cx.lowered.early_const_uses
  let json = cx.opened.json
  let lowered = cx.lowered.lowered
  let mod_tabs = cx.tablesrun.mod_tabs
  let module_table = cx.tablesrun.module_table
  let path = req.path
  let post_use_decls = cx.lowered.post_use_decls
  let proto_reg = cx.stamprun.proto_reg
  let rd = cx.stamprun.rd
  let region_marks = cx.regioned.region_marks
  let root_picks = cx.lowered.root_picks
  let sym_tab = cx.lowered.sym_tab
  let target_mod_name = root_module_name(req.path)
  let typed_prog0 = cx.inferrun.typed_prog0
  let typed_tab = cx.inferrun.typed_tab
  # Contracts are discharged against the typed calls, where a
  # pipe is the call it spells.
  let contract_vd = if typed_prog0.errs != 0 { vd_count(0) }
                    else { vd_render(call_site_diags(path, typed_prog0.decls, typed_tab)) }
  # Post-inference protocol-call rewrite. `Expr.ty` is
  # populated for every node now, so each `op(x, ...)`
  # call can be redirected to the matching
  # `__pimpl_<P>_<T>_<op>` direct call. Sites with
  # unknown types fall through and execute the
  # dispatcher fn's panic at runtime.
  let proto_reg = match dm { Some(x) -> demand_registry(proto_reg, x, typed_prog0.decls)  None -> proto_reg }
  let typed_prog = resolve_protocol_calls(typed_prog0, proto_reg)
  # Walk the post-rewrite AST and report any
  # `__proto_<op>` call whose receiver type is concrete
  # but has no matching impl. Polymorphic helpers whose
  # receiver is a TyVar at this point keep the runtime
  # fallthrough behaviour.
  let dispatch_diags =
    validate_resolved_protocols(typed_prog, typed_tab, proto_reg, diag_ctx)
  # The pinned-region gate. A `region { }` bump-arena is
  # a per-thread pointer; a fiber that parks inside one
  # would resume on another OS thread with a stale arena
  # pointer. Fail the compile if any region body can reach
  # a suspending effect — the typed row already carries
  # the transitive reach a syntactic scan would miss.
  let region_yield_diags = region_yield_findings(typed_prog.decls, region_marks, path)
  # Op-name collision diagnostic. The by-name handler
  # walk binds the wrong evidence when an op name is shared
  # by ≥2 effects and the call is not disambiguated; the
  # typer's resolution record (`op_res`) flags those sites.
  # Capability passing makes the collision impossible, so it
  # is a compile error, not corruption.
  let collision_errs =
    check_op_collisions(path, typed_prog.op_res, typed_prog.decls, typed_tab)
  # One table, one message, every class: a contested
  # type reads like a contested function, and a bare
  # name two modules both export is an error rather
  # than a pick by registration order.
  let name_report =
    nr_report_program_tab(diag_ctx, typed_prog.decls, target_mod_name,
                      lowered.reg, early_const_uses,
                      core_mod_names(core_mods, []),
                      post_use_decls, root_picks, sym_tab,
                      mtabs_of(mod_tabs, "").entries, typed_prog.diags)
  let name_errs = name_report.errs
  # Unused local bindings in the root file's fns and in every
  # runner block; warnings only.
  let unused_diags = report_unused_in_decls(path, module_table, typed_prog.decls)
  each(unused_diags, render_diag)
  let typed_vds = [Verdict(0, rd.diags), Verdict(typed_prog.errs, typed_prog.diags), contract_vd, Verdict(0, cx.lowered.warnings), Verdict(0, unused_diags), Verdict(0, name_report.warns),
                   vd_render(dispatch_diags), vd_rendered(region_yield_diags),
                   vd_rendered(collision_errs), vd_rendered(name_errs),
                   vd_render(target_main_diags(req.target, path, typed_prog.decls, sym_tab, entry)),
                   vd_render(backend_js_diags(req.backend, req.target, path, typed_prog.decls))]
  if vd_failed(typed_vds) { Halt(vd_exit(json, typed_vds)) }
  else { Go(Checked { opened: cx.opened, loaded: cx.loaded, cutrun: cx.cutrun, tablesrun: cx.tablesrun, accessed: cx.accessed, regioned: cx.regioned, lowered: cx.lowered, stamprun: cx.stamprun, solved: cx.solved, inferrun: cx.inferrun, checked: CheckedOut { proto_reg: proto_reg, typed_prog: typed_prog, typed_vds: typed_vds } }) }
}


fn backend_js_diags(bk: Backend, target: Target, path: String, decls: [Decl]) : [Diagnostic] = match bk {
  BkNative        -> if target == TgWasm32Browser { [] } else { js_native_diags(path, decls) }
  BkNativeModular -> if target == TgWasm32Browser { [] } else { js_native_diags(path, decls) }
  _               -> []
}
