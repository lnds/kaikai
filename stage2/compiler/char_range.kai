#[doc("""
A range of `Char`s, written over the code points it walks.

A range walks `Int` or `Char`, and its start says which. One of `Char`s
is the range of their code points, each mapped back, so nothing under
the typer counts anything but `Int`:

    ['a'..'e']       map([char_to_int('a')..char_to_int('e')], int_to_char)
    lazy ['a'..]     map(from(char_to_int('a')), int_to_char)

The step of a stepped range is `second - first`: between two `Char`s,
the distance of their code points.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.core_refs
import compiler.lazy_seq

#[doc("True when a range walks `Char`s: its start is one, or its start has no type yet and its end is a `Char` literal.")]
pub fn range_of_chars(start: Ty, hi: Expr) : Bool = match start {
  TyChar -> true
  TyInt  -> false
  _      -> match hi.kind {
    EChar(_) -> true
    _        -> false
  }
}

#[doc("`range_of_chars` for the progression of a `lazy` range, whose arguments after the start are `rest`: the end when it has one, then the step.")]
pub fn lazy_range_of_chars(start: Ty, rest: [Expr]) : Bool = match rest {
  [hi, _] -> range_of_chars(start, lazy_bare(hi))
  _       -> match start {
    TyChar -> true
    _      -> false
  }
}

#[doc("The code point of the `Char` `c`.")]
pub fn char_code(c: Expr) : Expr =
  mk_expr(ECall(mk_sym(core_fn_sym(CfCharToInt), c.line, c.col), [c]), c.line, c.col)

#[doc("The step of a `Char` range over code points: `second - first` between the two code points, and a literal step as it is.")]
pub fn char_step(step: Expr) : Expr = match step.kind {
  EBinop(BoSub, second, first) -> Expr { ...step, kind: EBinop(BoSub, char_code(second), char_code(first)) }
  _                            -> step
}

#[doc("The `Char`s of the `lazy` range whose progression `call` applies `f` to `start` and `rest`.")]
pub fn lazy_char_walk(call: Expr, f: Expr, start: Expr, rest: [Expr]) : Expr =
  lazy_chars(Expr { ...call, kind: ECall(f, [char_code(start), ...char_rest(rest)]) })

fn char_rest(rest: [Expr]) : [Expr] = match rest {
  [hi, step] -> [char_code(hi), char_step(step)]
  [step]     -> [char_step(step)]
  _          -> []
}
