#[doc("Declarations and what they carry: declaration forms, record and protocol descriptors and the lookups over them.")]

import compiler.written
import compiler.real_lit
import compiler.escapes
import compiler.ast
import compiler.ast_ids

# Issue #533: user-declared default handler clauses attached to an
# `effect E { ops; default { clauses } }` declaration. Carries the
# same `HClause` / `HReturn` shapes that `EHandle` uses so the codegen
# can later reuse the clause emit machinery. Stored as the new
# Option[DefaultBlock] field on DEffect.
#[derive(BinSerialize)]
pub(pkg) type DefaultBlock = DBlk([HClause], Option[HReturn], Int, Int)

#[derive(BinSerialize)]
pub(pkg) type Decl
  # m7b #13: optional type parameters on the function declaration —
  # `pub fn id[T](x: T) : T = x`. Empty list for monomorphic decls.
  # Each name in tparams is a quantified type variable in scope across
  # the param types, return type, row, and body. Generalised in
  # fn_scheme_of_decl so each call site fresh-instantiates.
  #
  # m6.2 v2: trailing `Option[String]` is the *module origin* — the
  # surface name of the module that owns this decl, or None for
  # decls authored in the root file. expand_imports + the core
  # loader populate it (every imported / preloaded decl gets a
  # `Some(<surface_name>)`); the parser produces only `None`. The
  # codegen mints `kai_<m>__<name>` for `Some(m)` and `kai_<name>`
  # for `None`, which lets two modules export the same bare name
  # without a linker collision and lets a root-file `fn sum`
  # silently shadow `pub fn sum` exported by a core.
  # Every form below ending in `Option[String]` carries this same
  # module-origin slot: the parser leaves it None, the module loader
  # stamps it.
  # `SymId` last, as on the other declaration forms: the identity the
  # symbol table minted, which the module tag cannot supply.
  = DFn(Bool, FnId, [TBinder], [Param], Option[TypeExpr], RowExpr, Expr, Int, Int, Option[String])
  # Hanga Roa: trailing `Option[String]` is the *module origin*,
  # mirroring `DFn`. None for decls authored in the root file; the
  # surface name of the owning module for decls coming through
  # `expand_imports` / the core auto-load. The typer's type-name
  # resolution uses this to disambiguate same-name records / sums /
  # unions per-module — a user `type Pair = ...` in the root file
  # shadows `core.tuple.Pair` only inside the root, while
  # `core/tuple.kai`'s own internal uses of `Pair` keep resolving
  # to their home module's definition.
  # Trailing `[String]` (kinds-1455) is the *habitant-slot kinds* — the
  # per-slot kind names of a declared `<>` annotation on the type head
  # (`type Matrix[t]<m: Dim, n: Dim>` -> `["Dim", "Dim"]`). Empty when
  # the head declares no slots (every pre-slot type). This list is
  # DISJOINT from the positional type parameters: no `tparams[i] <->
  # type-arg[i]` consumer reads it, so a habitant slot can never be
  # mis-read as a type parameter. Its one reader is the derived
  # name->slots table the `TyDim` annotation validator consults.
  # `SymId` last, as on `DEffect`: the declaration's own identity, which
  # the module tag cannot supply — a root declaration and an untagged one
  # both spell `None`.
  | DType(Bool, SymId, [TBinder], TypeBody, Int, Int, Option[String], [String])
  | DTest(String, Expr, Int, Int, Option[String])
  # bench v1 (issue #40): mirrors DTest but the runner times the body.
  # Fields: description (raw quoted span), body, line, col.
  | DBench(String, Expr, Int, Int, Option[String])
  # check v1 (issue #44): property-based check block. Mirrors DTest +
  # DBench but the body is run N times with random inputs generated
  # from the parameter type list. Fields: description (raw quoted
  # span), `with`-clause params (each carrying an explicit type), body
  # (must produce Bool), line, col.
  | DCheck(String, [Param], Expr, Int, Int, Option[String])
  | DImport(ImportKind, Int, Int)
  # m7b #11: optional type parameters on the effect declaration —
  # `effect Reader[T] { ask() : T }`. Empty list for stateless effects.
  # Issue #533: trailing Option[DefaultBlock] carries the parsed
  # `default { clauses }` body, or None when the effect declares no
  # default. Stage 1 (parser + AST) only; coverage check and codegen
  # land in follow-up lanes.
  # The `SymId` after the module tag is the declaration's own identity.
  # A module tag alone cannot tell a root declaration from an untagged
  # one, and both spell `None`.
  | DEffect(Bool, SymId, [TBinder], [EffectOp], Option[DefaultBlock], Int, Int, Option[String])
  # m12.8: `protocol P { op_decls }` — single-dispatch ad-hoc
  # polymorphism. Each ProtoOp carries a parameter list using `Self`
  # as the first-position dispatch type. Defaults are not parsed in
  # the v1 (the parser only accepts bodyless op signatures).
  # Issue #180: optional [A1, A2, ...] type parameter list bound at
  # protocol declaration scope (alongside the implicit `Self`). The
  # impl-table key remains `(P, Self)` — `Ai` resolve at impl-site.
  # The trailing `Option[String]` is the declaring module's origin,
  # stamped at the import boundary like DType/DEffect; `None` = root.
  | DProtocol(Bool, SymId, [TBinder], [ProtoOp], Int, Int, Option[String])
  # m12.8: `impl P for T { fn op(args) = body ... }` — supplies the
  # ops of protocol `pname` for the concrete type `target`. The body
  # decls live as ordinary DFns whose name is the op name (no
  # mangling at parse time; the lower-protocols pass renames them to
  # `__pimpl_<P>_<T>_<op>`).
  # Issue #180: optional [T1, T2, ...] type-arg list (the protocol's
  # `[A1, ...]` parameters monomorphised at this impl-site). Empty
  # list means the legacy un-parametrised form `impl P for X`, which
  # the resolver treats as `impl P[X] for X` (`Ai := Self`).
  # The trailing list holds the impl-site type parameters of
  # `impl[T: Show + Eq, u: Measure] P for X`. The binding pass hands
  # them to each method, ahead of its own; the head keeps them for the
  # argument and target types that mention them.
  | DImpl(DeclRef, [TypeExpr], TypeExpr, [Decl], Int, Int, [TBinder], SymId)
  # m12.8: `#derive(P, ...) type T = ...` — opt-in structural impl
  # generator. The lower-protocols pass walks the type body and
  # synthesises one DImpl per derived protocol. The parser keeps the
  # annotation alongside the wrapped DType so the desugar pass has all
  # the data in one node.
  | DDerive([String], Decl, Int, Int)
  # Issue #602: `#unstable` wrapper around a `pub fn / pub type / pub
  # const`. Marks the inner declaration as not covered by the edition
  # stability contract. The wrapper is preserved through the resolver
  # and module-export collection so import-site enforcement can flag
  # consumers that have not opted in via `[unstable]` in their
  # `kai.toml`. Every downstream walker that recurses into Decl trees
  # mirrors the existing `DDerive` / `DAttribPure` precedent: unwrap
  # the inner Decl and walk that. The flag only affects diagnostics —
  # codegen does not see it.
  | DUnstable(Decl, Int, Int)
  # `#[constructor]` wrapper around a `pub fn` returning the marked
  # type. The typer reads it in `add_decls_loop` to register
  # `type_name -> (home_module, fn_name)` so `Type(args)` desugars to a
  # call to that fn (never the raw record literal). The wrapper is
  # transparent for every other walker — unwrap the inner Decl and walk
  # it, mirroring the `DUnstable` / `DDerive` precedent.
  | DConstructor(Decl, Int, Int)
  # `laws <Theory>` wrapper around a `protocol` — records that the
  # protocol's ops obey the closed-catalog term theory (e.g.
  # `Functorial`). The lower-protocols pass reads the theory to
  # autogenerate the law-checks per impl; every other walker unwraps the
  # inner `DProtocol`, mirroring the `DDerive`/`DUnstable` precedent.
  | DProtoLaws(String, Decl, Int, Int, Option[String])
  # `axiom <Theory>` wrapper around an `impl` — asserts the impl obeys
  # the theory's laws, exempting it from the autogenerated law-checks
  # (the audited escape). Transparent to every other walker.
  | DImplAxiom(String, Decl, Int, Int, Option[String])
  # Issue #681: `#[doc("...")]` / `#[doc("""...""")]` wrapper around a
  # documented declaration. Fields: raw attribute source (the exact
  # `#[doc(...)]` byte span, re-emitted verbatim by `kai fmt`),
  # normalised doc text (surrounding whitespace stripped, internal
  # newlines preserved), inner Decl, line, col. The wrapper is
  # stripped right after parse by `doc_strip_collect`
  # (compiler/doc_attr.kai) into a side table, so no pass beyond the
  # formatter and the doc collector ever sees it.
  | DDoc(String, String, Decl, Int, Int)
  # Issue #681: module-level `#[doc(...)]` — an attribute in module
  # position (not immediately followed by a declaration head). Same
  # raw/text fields as DDoc, no inner Decl. The root file's module
  # doc survives the pipeline up to `infer_program`, which lifts it
  # into `TypedProgram.module_doc`; loaders for imported / core
  # modules strip it at load time.
  | DModuleDoc(String, String, Int, Int)
  # Unknown-attribute wrapper (`#[deprecated]`, `#[cfg(...)]`, custom
  # attributes): raw byte span (re-emitted verbatim by the formatter)
  # around the following declaration. Carries no compilation
  # semantics — `doc_strip_collect` / `doc_strip_all` dissolve it
  # right after parse, so only the formatter, `kai migrate`, and the
  # doc strip ever see it.
  | DAttr(String, Decl, Int, Int)
  # Habitant declaration. `unit USD` (UBNone) introduces an atomic
  # unit symbol; `unit Newton = kg * m / sec^2` (UBAlias) a named
  # alias whose RHS the resolver expands eagerly before unification;
  # `pct pct70 = 70` (UBMeasure) a symbol carrying the exact numeric
  # measure a measure-carrying theory sums. The `intro` field is the
  # introducer word verbatim (`unit` for the built-in Measure,
  # `metric`/`cur` for a user kind), so the formatter round-trips it
  # and the typer maps it to its kind through the KindReg for
  # per-kind isolation. Codegen emits nothing for DUnit.
  | DUnit(Bool, String, UnitBody, String, Int, Int, Option[String])
  # m7e §25: `use Effect` at file scope — opens the effect's ops
  # for bare-name resolution in every fn body of the file. The
  # resolver expands every bare name matching
  # an opened op into `EField(EName(eff), name)`. Ambiguity (two
  # opened effects expose the same op name) is a hard error.
  # `use` does NOT remove the cap from the row — the effect still
  # appears in any caller's row annotation.
  | DUse(String, Int, Int)
  # `use kind Currency` at file scope — opens a kind's habitants for
  # bare `<habitant>` resolution, the same way `use Effect` opens an
  # effect's ops. Read by the kind-resolution pass and stripped there,
  # so no later stage sees it. The home keys the open to the module
  # that wrote it: `use kind` is file scope, not program scope.
  # Fields: kind name, line, col, home module.
  | DUseKind(String, Int, Int, Option[String])
  # `axiom name[tparams](params) : T / row` — a typed symbol with no
  # body — or, with an ABI, an `extern "<abi>" fn` declaration. Fields:
  # is_pub, ABI (None for a plain axiom), name, symbol (the C override
  # or "" under `AbiC`; the explicit runtime symbol under `AbiKai`),
  # tparams, params, return type, row, line, col. `lower_axioms`
  # rewrites every DAxiom to a DFn — a panic body for an axiom, an
  # `EExternBody` marker for an extern — before any other Decl walker
  # runs, so downstream passes only see DFn.
  | DAxiom(Bool, Option[ExternAbi], String, String, [TBinder], [Param], TypeExpr, RowExpr, Int, Int)
  # `const NAME : T = expr` — a top-level named constant, bound
  # monomorphically (`name : T`, no scheme) and never a dispatch
  # candidate. Fields: is_pub, name, declared type, initialiser,
  # module_origin, line, col.
  | DConst(Bool, SymId, TypeExpr, Expr, Option[String], Int, Int)
  # A foreign type declared by `extern "C" type Name = { fields }` (a C
  # struct passed by value) or `extern "C" opaque Name` (an opaque C
  # handle kaikai threads through but never inspects). Fields: is_pub,
  # name, body, line, col, module_origin. The resolver records the name in the FFI type
  # registry the boundary classifier consults. Codegen emits nothing
  # for the decl itself — the struct layout lives in the shim, the
  # opaque is a runtime `KAI_FOREIGN` box.
  | DExternType(Bool, String, ExternTypeBody, Int, Int, Option[String])
  # `theory Name = { prop* }` or `theory Name = builtin` — a named
  # unification theory (the catalog surface for kinds). Fields: name,
  # property idents (a builtin body is stored as the single sentinel
  # `theory_builtin_marker()`), line, col. Catalog-only; it carries
  # no runtime meaning and is stripped right after parse, alongside
  # `DKind`, before any typer pass runs.
  | DTheory(String, [String], Int, Int, Option[String])
  # `kind Name : Theory [over Domain] with <habitant-form>` — names a
  # classification algebra (`Measure : AbelianGroup with unit`).
  # Fields: is_pub, name, the theory it is classified by, the second
  # type domain (`over Int`; empty for a single-domain theory), the
  # habitant form of the `with` clause, line, col. Recognised
  # contextually (`kind` and `over` are ordinary identifiers
  # everywhere but item-declaration position, like `region`). v1
  # keeps `Measure`'s KUnit plumbing on its hardcoded path; the
  # declaration is parsed and validated, then stripped before the
  # typer.
  | DKind(Bool, String, String, String, KindHab, Int, Int, Option[String])

#[derive(BinSerialize)]
pub(pkg) type ExternTypeBody = ETStruct([FieldDecl]) | ETOpaque([TBinder]) | ETOpaqueJs

# m12.8: a single operation declared inside a `protocol P { ... }`
# block. Mirrors EffectOp's shape (no body, with optional generic
# tparams), but lives in its own type so the resolver / typer can
# distinguish protocol ops from effect ops cleanly.
#[derive(BinSerialize)]
pub(pkg) type ProtoOp = POp(String, [TBinder], [Param], TypeExpr, Int, Int)

# An operation declared inside an `effect Eff { ... }` block.
# name[op_tparams](params) : ret_ty — no body, no `fn` keyword.
# m7b #2: per-op type generics. `op_tparams` is the optional
# `[T1, T2]` between op name and `(args)`. Empty for monomorphic
# ops; non-empty when the op signature itself quantifies over
# types (Doc B §`Mutable`'s `array_get[T]`, etc.).
#[derive(BinSerialize)]
pub(pkg) type EffectOp = EffOp(String, [TBinder], [Param], TypeExpr, Int, Int)

# TBEffectAlias holds a closed sum of effect labels, e.g.
# `type Io = Console + Stdin + Env + File` (m7b #1). The body is a
# list of label names; non-effect labels and cycles are rejected at
# resolve time. Single-effect aliases (`type Foo = Console`) parse as
# TBAlias(TyName(name, [])) and are recognised at resolve time.
#[derive(BinSerialize)]
pub(pkg) type TypeBody = TBAlias(TypeExpr) | TBRecord([FieldDecl]) | TBSum([Variant]) | TBEffectAlias([RowLabel])

# Record field declaration. `is_pub` is false for a `priv` field: only
# the declaring module may read it (`.f` or a pattern) or name it in a
# record literal.
#[derive(BinSerialize)]
pub(pkg) type FieldDecl = FD(Bool, String, TypeExpr, [FieldAttr])

# Per-field `#[json(...)]` override on a record field. `FAJsonRename`
# sends the field to the wire under an explicit name; `FAJsonDefault`
# supplies a value when the key is absent (the opt-out from the
# missing-non-`Option`-is-an-error policy); `FAJsonSkip` drops the field
# from the wire (its decode then needs a default or an `Option` type).
#[derive(BinSerialize)]
pub(pkg) type FieldAttr = FAJsonRename(String) | FAJsonDefault(Expr) | FAJsonSkip

#[derive(BinSerialize)]
pub(pkg) type Variant = Var(SymId, [TypeExpr])

#[doc("Record-table entry: type name, type params, field decls, module origin, declaration id. Built by collect_records, consumed by the positional-record desugar (compiler.desugar) and the typer; an AST-adjacent shared type.")]
#[derive(BinSerialize)]
pub(pkg) type RecInfo = RI(SymId, [TBinder], [FieldDecl], Option[String])

#[doc("The record `s` declares, if the table holds one.")]
pub(pkg) fn rec_find(rs: [RecInfo], s: SymId) : Option[RecInfo] =
  if sym_raw(s) < 0 { None } else { rec_find_loop(rs, sym_raw(s)) }

fn rec_find_loop(rs: [RecInfo], id: Int) : Option[RecInfo] = match rs {
  [] -> None
  [r, ...rest] -> match r {
    RI(ds, _, _, _) -> if sym_raw(ds) == id { Some(r) } else { rec_find_loop(rest, id) }
  }
}

#[doc("The `#[json(rename = ...)]` wire name of a field, or `None` when it has none.")]
pub(pkg) fn field_attr_json_rename(attrs: [FieldAttr]) : Option[String] = match attrs {
  [] -> None
  [a, ...rest] -> match a {
    FAJsonRename(n) -> Some(n)
    _               -> field_attr_json_rename(rest)
  }
}

#[doc("The `#[json(default = ...)]` expression of a field, or `None` when it has none.")]
pub(pkg) fn field_attr_json_default(attrs: [FieldAttr]) : Option[Expr] = match attrs {
  [] -> None
  [a, ...rest] -> match a {
    FAJsonDefault(e) -> Some(e)
    _                -> field_attr_json_default(rest)
  }
}

#[doc("True when a field carries `#[json(skip)]`, dropping it from the JSON wire.")]
pub(pkg) fn field_attr_json_skip(attrs: [FieldAttr]) : Bool = match attrs {
  [] -> false
  [a, ...rest] -> match a {
    FAJsonSkip -> true
    _          -> field_attr_json_skip(rest)
  }
}

#[doc("Declaration-order index of `target` in a `[FieldDecl]` list, or -1 if absent.")]
fn field_decl_index(fs: [FieldDecl], target: String) : Int =
  field_decl_index_loop(fs, target, 0)

fn field_decl_index_loop(fs: [FieldDecl], target: String, i: Int) : Int = match fs {
  [] -> -1
  [f, ...rest] -> match f {
    FD(_, nm, _, _) -> if nm == target { i } else { field_decl_index_loop(rest, target, i + 1) }
  }
}

#[doc("The declaration-order slot of `field` on the record `s` declares, or `None` when it declares no such record or field.")]
fn rec_field_index(rs: [RecInfo], s: SymId, field: String) : Option[Int] = match rec_find(rs, s) {
  None     -> None
  Some(ri) -> match ri {
    RI(_, _, fs, _) -> match field_decl_index(fs, field) {
      -1 -> None
      n  -> Some(n)
    }
  }
}

#[doc("The declaration-order slot of `field` when `opt_t` is a known record type, else `None`.")]
pub(pkg) fn field_index_of(recs: [RecInfo], opt_t: Option[Ty], field: String) : Option[Int] = match opt_t {
  Some(t) -> field_index_of_t(recs, t, field)
  None    -> None
}

fn field_index_of_t(recs: [RecInfo], t: Ty, field: String) : Option[Int] = match t {
  TyCon(s, _)         -> rec_field_index(recs, s, field)
  TyRefineT(inner, _) -> field_index_of_t(recs, inner, field)
  _                   -> None
}

#[doc("The wrapped decl of an annotation-only wrapper, None for a bare decl.")]
pub(pkg) fn decl_transparent_inner(d: Decl) : Option[Decl] = match d {
  DDerive(_, inner, _, _)     -> Some(inner)
  DUnstable(inner, _, _)      -> Some(inner)
  DConstructor(inner, _, _)   -> Some(inner)
  DProtoLaws(_, inner, _, _, _) -> Some(inner)
  DImplAxiom(_, inner, _, _, _) -> Some(inner)
  DDoc(_, _, inner, _, _)     -> Some(inner)
  DAttr(_, inner, _, _)       -> Some(inner)
  _                           -> None
}

#[doc("`d`, an annotation-only wrapper, around `inner` in place of the decl it wrapped; a bare decl is returned as it is.")]
pub(pkg) fn decl_rewrap(d: Decl, inner: Decl) : Decl = match d {
  DDerive(ns, _, l, c)          -> DDerive(ns, inner, l, c)
  DUnstable(_, l, c)            -> DUnstable(inner, l, c)
  DConstructor(_, l, c)         -> DConstructor(inner, l, c)
  DProtoLaws(th, _, l, c, mo)   -> DProtoLaws(th, inner, l, c, mo)
  DImplAxiom(th, _, l, c, mo)   -> DImplAxiom(th, inner, l, c, mo)
  DDoc(ds, dl, _, l, c)         -> DDoc(ds, dl, inner, l, c)
  DAttr(at, _, l, c)            -> DAttr(at, inner, l, c)
  _                             -> d
}

#[doc("Project a decl stream into the record table ([RecInfo]), newest-first.")]
pub(pkg) fn collect_records(ds: [Decl]) : [RecInfo] = collect_records_loop(ds, [])

# Sum-type registry for the region-brand walker (issue #71). The
# shallow `ty_expr_contains_fiber/pid` walker only sees TypeExprs;
# a `type Boxed = Wrap(Fiber[Int])` would otherwise hide the Fiber
# inside the variant's payload, since the surface TypeExpr is just
# `TyName("Boxed", [])`. SumInfo records (type name, tparams,
# variants) per `DType ... TBSum`, threaded through `infer_program`
# the same way `RecInfo` is.

fn collect_records_loop(ds: [Decl], acc: [RecInfo]) : [RecInfo] {
  match ds {
    [] -> acc
    [d, ...rest] -> match decl_transparent_inner(d) {
      Some(inner) -> collect_records_loop([inner, ...rest], acc)
      None -> match d {
        DType(_, dsym, tps, body, _, _, mo, _) -> match body {
          TBRecord(fs) -> collect_records_loop(rest, [RI(dsym, tps, fs, mo), ...acc])
          _ -> collect_records_loop(rest, acc)
        }
        _ -> collect_records_loop(rest, acc)
      }
    }
  }
}

# Protocol registry types (issue #677 phase 1n0). Sunk here from the
# protocols block in main.kai ahead of the infer + protocols
# extraction lanes: these appear both in the infer public surface
# (`infer_program_with_protos_cached`'s signature) and are produced by
# the protocols block, so sinking them into ast.kai lets both lanes
# import downward instead of laterally. The ops/impls/origins themselves
# are populated by fns that stay in main.kai for now.

#[doc("Registered protocol operation: (proto, op_name, params, ret, line, col, home, the op's own type parameters). `home` is the declaring protocol's module origin, `None` for the root file.")]
pub(pkg) type ProtoOpReg = POR(SymId, Written, [Param], TypeExpr, Int, Int, Option[String], [TBinder])
#                         protocol op      params  ret      line col  home            op tparams

#[doc("Aggregate protocol registry: ops, impls, op_names, tparams, origins, dispatch keys, impl_index, plus what protocol resolution scopes by — the stdlib core module names and each file's direct imports — and the generated functions by id.")]
pub(pkg) type ProtocolReg = { ops: [ProtoOpReg], impls: [ProtoImplReg],
                         op_names: [String], tparams: [ProtoTPReg],
                         origins: [ProtoOriginReg], dkeys: [ProtoKey],
                         impl_index: ImplIndex, cores: [String],
                         imports: [ModImports], root: String, ids: ProtoIds }
