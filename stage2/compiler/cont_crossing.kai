#[doc("""
A continuation belongs to the fiber whose stack segment it suspended, and
needs the handlers of the effects its body performs. A lazy sequence is
evaluated in place by the fiber that made it. This walk over a typed body
finds where either would reach another fiber: a thunk handed to a call that
yields a `Fiber` or `Pid` capturing one, such a call's result holding one, or
a call that takes a `Pid` passing one along. It also finds a handle whose
value holds a continuation that performs the effect the handle discharges.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.expr_positions
import compiler.modules_homes
import compiler.core_types

#[doc("Where a value would leave its fiber, or a continuation its handlers: message, help, position.")]
pub type Crossing = Crossing(String, String, Int, Int)

#[doc("A value that stays on the fiber that made it.")]
pub type FiberBound = FbCont | FbSeq

#[doc("What a value of `t` holds that stays on its fiber; `holds` says whether it holds one of the type `h`.")]
pub fn fiber_bound(t: Ty, holds: (SymId, Ty) -> Bool) : Option[FiberBound] =
  if holds(core_ty_sym(CtCont), t) { Some(FbCont) }
  else if holds(core_decl_ty_id(CdSeq), t) { Some(FbSeq) }
  else { None }

#[doc("Every crossing in `e`; `tab` names an effect in a message, `res` resolves a type, `bound` says what a value of it holds that stays on its fiber and `needs` whether it holds a continuation performing the given effect.")]
pub fn cont_crossings(e: Expr, tab: SymTab, res: (Ty) -> Ty, bound: (Ty) -> Option[FiberBound], needs: (Ty, SymId) -> Bool) : [Crossing] =
  list_reverse(cc(e, Cc { tab: tab, res: res, bound: bound, needs: needs }, []))

type Cc = { tab: SymTab, res: (Ty) -> Ty, bound: (Ty) -> Option[FiberBound], needs: (Ty, SymId) -> Bool }

# Every typed body runs through this walk, so it reads each node once and
# allocates only for a crossing it finds.
fn cc(e: Expr, c: Cc, acc: [Crossing]) : [Crossing] = match e.kind {
  ECall(f, xs)       -> cc_all(xs, c, cc(f, c, at_call(e, xs, c, acc)))
  EField(b, _)       -> cc(b, c, acc)
  EIndex(a, b)       -> cc(b, c, cc(a, c, acc))
  EBinop(_, a, b)    -> cc(b, c, cc(a, c, acc))
  EUnop(_, x)        -> cc(x, c, acc)
  EIf(k, t, oe)      -> cc_opt(oe, c, cc(t, c, cc(k, c, acc)))
  EMatch(s, arms)    -> cc_arms(arms, c, cc(s, c, acc))
  ELambda(_, b)      -> cc(b, c, acc)
  ERecordLit(_, fs)  -> cc_fields(fs, c, acc)
  EList(els)         -> cc_elems(els, c, acc)
  ERange(a, b, os)   -> cc_opt(os, c, cc(b, c, cc(a, c, acc)))
  EBlock(ss, ot)     -> cc_opt(ot, c, cc_stmts(ss, c, acc))
  EPipe(a, b)        -> cc(b, c, cc(a, c, acc))
  EDispatchPipe(_, a, b) -> cc(b, c, cc(a, c, acc))
  EBang(x)           -> cc(x, c, acc)
  ELitUnit(x, _)     -> cc(x, c, acc)
  EHandle(body, eff, _, init, _, cls, ret) ->
    cc_ret(ret, c, cc_clauses(cls, c, cc_opt(init, c, cc(body, c, at_handle(e, eff, c, acc)))))
  EIntrinsic(_, xs)  -> cc_all(xs, c, acc)
  ESurface(sf)       -> cc_all(surface_children(sf), c, acc)
  EInt(_, _)         -> acc
  EReal(_, _)        -> acc
  EFixed(_, _)       -> acc
  EIntLit(_)         -> acc
  EDecimalLit(_)     -> acc
  EBool(_)           -> acc
  EChar(_)           -> acc
  EStr(_, _)         -> acc
  EUnit              -> acc
  EName(_)           -> acc
  EMark(_)           -> acc
  ESym(_, _)         -> acc
  ELocal(_)          -> acc
  EOp(_)             -> acc
  EUnder             -> acc
  EPlaceholder       -> acc
  EHole(_)           -> acc
  ETodo(_)           -> acc
  EExternBody(_, _)  -> acc
  EVariantsOf(_, _)  -> acc
  EModCall(_, _)     -> acc
}

fn cc_all(xs: [Expr], c: Cc, acc: [Crossing]) : [Crossing] = match xs {
  []           -> acc
  [x, ...rest] -> cc_all(rest, c, cc(x, c, acc))
}

fn cc_opt(o: Option[Expr], c: Cc, acc: [Crossing]) : [Crossing] = match o {
  Some(x) -> cc(x, c, acc)
  None    -> acc
}

fn cc_arms(arms: [Arm], c: Cc, acc: [Crossing]) : [Crossing] = match arms {
  []                      -> acc
  [Arm(_, g, b), ...rest] -> cc_arms(rest, c, cc(b, c, cc_opt(g, c, acc)))
}

fn cc_fields(fs: [FieldInit], c: Cc, acc: [Crossing]) : [Crossing] = match fs {
  []                  -> acc
  [FI(_, v), ...rest] -> cc_fields(rest, c, cc(v, c, acc))
}

fn cc_elems(els: [ListElem], c: Cc, acc: [Crossing]) : [Crossing] = match els {
  []                     -> acc
  [ElPlain(x), ...rest]  -> cc_elems(rest, c, cc(x, c, acc))
  [ElSpread(x), ...rest] -> cc_elems(rest, c, cc(x, c, acc))
}

fn cc_stmts(ss: [Stmt], c: Cc, acc: [Crossing]) : [Crossing] = match ss {
  [] -> acc
  [s, ...rest] -> cc_stmts(rest, c, match s {
    SLet(_, _, rhs)             -> cc(rhs, c, acc)
    SAssert(k, m)               -> cc_opt(m, c, cc(k, c, acc))
    SExprStmt(x)                -> cc(x, c, acc)
    SIndexAssign(b, i, v, _, _) -> cc_all([b, i, v], c, acc)
    SAssign(b, v, _, _)         -> cc(v, c, cc(b, c, acc))
    SVar(_, _, rhs, _, _)       -> cc(rhs, c, acc)
    SUse(_, _, _)               -> acc
  })
}

fn cc_clauses(cls: [HClause], c: Cc, acc: [Crossing]) : [Crossing] = match cls {
  []                            -> acc
  [HC(_, _, b, _, _), ...rest] -> cc_clauses(rest, c, cc(b, c, acc))
}

fn cc_ret(r: Option[HReturn], c: Cc, acc: [Crossing]) : [Crossing] = match r {
  Some(HR(_, b, _, _)) -> cc(b, c, acc)
  None                 -> acc
}

# A node's type, resolved only when it is still a variable.
fn peek(e: Expr, c: Cc) : Ty = match e.ty {
  Some(t) -> match t {
    TyVarT(_) -> c.res(t)
    _         -> t
  }
  None -> TyAny
}

fn at_handle(h: Expr, eff: DeclRef, c: Cc, acc: [Crossing]) : [Crossing] =
  if c.needs(c.res(ty_of(h)), ref_sym(eff)) {
    [Crossing("this handle's value holds a continuation that performs `#{eff_text(c.tab, eff)}`, which the handle discharges",
              "resume or drop the continuation inside the handle", h.line, h.col), ...acc]
  } else { acc }

fn eff_text(tab: SymTab, eff: DeclRef) : Written = match eff {
  DrSym(s)        -> decl_name(tab, s)
  DrWritten(_, n) -> n
}

fn at_call(call: Expr, xs: [Expr], c: Cc, acc: [Crossing]) : [Crossing] = match peek(call, c) {
  TyCon(tcs, targs) -> {
    let fiber = core_ty_is(tcs, CtFiber)
    if fiber or core_ty_is(tcs, CtPid) { [...fiber_call(call, fiber, targs, xs, c), ...acc] }
    else { message_crossings(xs, c, acc) }
  }
  _ -> message_crossings(xs, c, acc)
}

fn fiber_call(call: Expr, fiber: Bool, targs: [Ty], xs: [Expr], c: Cc) : [Crossing] = {
  let what = if fiber { "a fiber's result" } else { "an actor's message" }
  let result = match first_bound(targs, c) {
    Some(b) -> [Crossing("#{what} cannot hold #{bound_noun(b)}", fiber_help(b), call.line, call.col)]
    None    -> []
  }
  [...result, ...flat_map(xs, (x) => thunk_captures(x, c.res, c.bound))]
}

fn first_bound(ts: [Ty], c: Cc) : Option[FiberBound] = match ts {
  []           -> None
  [t, ...rest] -> match c.bound(c.res(t)) {
    Some(b) -> Some(b)
    None    -> first_bound(rest, c)
  }
}

fn message_crossings(xs: [Expr], c: Cc, acc: [Crossing]) : [Crossing] =
  if any(xs, (x) => is_pid(peek(x, c))) { foldl(xs, acc, (a, x) => message_crossing(x, c, a)) } else { acc }

fn message_crossing(x: Expr, c: Cc, acc: [Crossing]) : [Crossing] = {
  let t = c.res(ty_of(x))
  if is_pid(t) { acc } else { match c.bound(t) {
    Some(b) -> [Crossing("a message cannot hold #{bound_noun(b)}", fiber_help(b), x.line, x.col), ...acc]
    None    -> acc
  } }
}

fn bound_noun(b: FiberBound) : String = match b {
  FbCont -> "a continuation"
  FbSeq  -> "a lazy sequence"
}

fn fiber_help(b: FiberBound) : String = match b {
  FbCont -> "a continuation can only be resumed by the fiber that created it"
  FbSeq  -> "a `Seq` is evaluated in place by the fiber that created it; send its elements as a list"
}

fn is_pid(t: Ty) : Bool = match t {
  TyCon(tcs, _) -> core_ty_is(tcs, CtPid)
  _ -> false
}

fn thunk_captures(x: Expr, res: (Ty) -> Ty, bound: (Ty) -> Option[FiberBound]) : [Crossing] = match x.kind {
  ELambda(ps, b) -> match outer_ref(b, binders(b, map(ps, (p) => p.binder.id)), res, bound) {
    Some(c) -> [c]
    None    -> []
  }
  _ -> []
}

# The crossing at a read of a local `e` does not bind itself, whose value stays on its fiber.
fn outer_ref(e: Expr, local: [LocalId], res: (Ty) -> Ty, bound: (Ty) -> Option[FiberBound]) : Option[Crossing] =
  match own_ref(e, local, res, bound) {
    Some(c) -> Some(c)
    None    -> first_some(xp_positions(e), (p) => match p { XP(_, x) -> outer_ref(x, local, res, bound) })
  }

fn own_ref(e: Expr, local: [LocalId], res: (Ty) -> Ty, bound: (Ty) -> Option[FiberBound]) : Option[Crossing] = match e.kind {
  ELocal(l) -> if any(local, (x) => local_eq(x, l)) { None } else { match bound(res(ty_of(e))) {
    Some(b) -> Some(Crossing("a thunk run on another fiber cannot capture #{bound_noun(b)}", fiber_help(b), e.line, e.col))
    None    -> None
  } }
  _ -> None
}

# Every binder declared anywhere inside `e`, after `acc`.
fn binders(e: Expr, acc: [LocalId]) : [LocalId] = {
  let here = match e.kind {
    ELambda(ps, _)  -> [...map(ps, (p) => p.binder.id), ...acc]
    EBlock(ss, _)   -> stmt_binders(ss, acc)
    EMatch(_, arms) -> arm_binders(arms, acc)
    _ -> acc
  }
  foldl(xp_positions(e), here, (a, p) => match p { XP(_, x) -> binders(x, a) })
}

fn stmt_binders(ss: [Stmt], acc: [LocalId]) : [LocalId] = match ss {
  [] -> acc
  [s, ...rest] -> match s {
    SLet(p, _, _)       -> stmt_binders(rest, pat_ids(p, acc))
    SVar(b, _, _, _, _) -> stmt_binders(rest, [b.id, ...acc])
    _                   -> stmt_binders(rest, acc)
  }
}

fn arm_binders(arms: [Arm], acc: [LocalId]) : [LocalId] = match arms {
  [] -> acc
  [Arm(p, _, _), ...rest] -> arm_binders(rest, pat_ids(p, acc))
}

fn pat_ids(p: Pattern, acc: [LocalId]) : [LocalId] = foldl(pat_binders(p, []), acc, (a, b) => [b.id, ...a])

fn ty_of(e: Expr) : Ty = match e.ty {
  Some(t) -> t
  None    -> TyAny
}

fn first_some(ps: [XPos], f: (XPos) -> Option[Crossing]) : Option[Crossing] = match ps {
  [] -> None
  [p, ...rest] -> match f(p) {
    Some(x) -> Some(x)
    None    -> first_some(rest, f)
  }
}
