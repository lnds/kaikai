#[doc("Typer-internal helper `env_bind_sym` shared across the infer modules.")]
pub fn env_bind_sym(env: TyEnv, s: SymId, sc: TyScheme) : TyEnv =
  env_entry_add(env, TyEntry { key: KSym(s), scheme: sc })


#[doc("Typer-internal helper `env_bind_ctor` shared across the infer modules.")]
pub fn env_bind_ctor(env: TyEnv, ctor: SymId, sc: TyScheme) : TyEnv =
  env_entry_add(env, TyEntry { key: KCtor(ctor), scheme: sc })


#[doc("Typer-internal helper `env_bind_op` shared across the infer modules.")]
pub fn env_bind_op(env: TyEnv, eff: SymId, op: Written, sc: TyScheme) : TyEnv =
  env_entry_add(env, TyEntry { key: KOp(eff, op), scheme: sc })


#[doc("Typer-internal helper `ty_env_prepend_batch` shared across the infer modules.")]
pub fn ty_env_prepend_batch(batch: [TyEntry], entries: [TyEntry], ix: NameIndex[TyEntry], vx: VariantIndex[TyEntry], n: Int) : TyEnvParts =
  ty_env_prepend_batch_loop(list_reverse(batch), entries, ix, vx, n)


fn ty_env_prepend_batch_loop(batch: [TyEntry], entries: [TyEntry], ix: NameIndex[TyEntry], vx: VariantIndex[TyEntry], n: Int) : TyEnvParts = match batch {
  [] -> TEP(entries, ix, vx, n)
  [e, ...rest] -> ty_env_prepend_batch_loop(rest, [e, ...entries], env_ix_add(ix, e), env_vix_add(vx, e), n + 1)
}


#[doc("infer: `add_core_sigs` — typer entry point invoked by the driver.")]
pub fn add_core_sigs(env: TyEnv) : TyEnv {
  let batch = list_append(builtin_ty_entries(builtin_table()), native_prim_ty_entries(rcore_table()))
  match ty_env_prepend_batch(batch, env.entries, env.index, env.vindex, 0) {
    TEP(all_entries, idx, vidx, _) -> TyEnv { ...env, entries: all_entries, index: idx, vindex: vidx }
  }
}


fn add_builtin_variant_sigs(env: TyEnv) : TyEnv {
  let some_sc = scheme([0],    fn_ty([tv(0)], core_ty_con(CtOption, [tv(0)])))
  let none_sc = scheme([0],    core_ty_con(CtOption, [tv(0)]))
  let ok_sc   = scheme([0, 1], fn_ty([tv(0)], core_ty_con(CtResult, [tv(0), tv(1)])))
  let err_sc  = scheme([0, 1], fn_ty([tv(1)], core_ty_con(CtResult, [tv(0), tv(1)])))
  let es = [
    TyEntry { key: KCtor(core_ctor_sym("Some")), scheme: some_sc },
    TyEntry { key: KCtor(core_ctor_sym("None")), scheme: none_sc },
    TyEntry { key: KCtor(core_ctor_sym("Ok")),   scheme: ok_sc   },
    TyEntry { key: KCtor(core_ctor_sym("Err")),  scheme: err_sc  }
  ]
  match ty_env_prepend_batch(es, env.entries, env.index, env.vindex, 0) {
    TEP(all_entries, idx, vidx, _) -> TyEnv { ...env, entries: all_entries, index: idx, vindex: vidx }
  }
}


# Canonicalise a list of ResolvedCS records by applying the bound-id
# redirect maps to each CS's tys / units. Mirrors the canon_*_expr
# walkers but operates on the per-decl call-site list.
#[doc("Typer-internal helper `canon_resolved_css` shared across the infer modules.")]
pub fn canon_resolved_css(css: [ResolvedCS], tv_map: [IntPair],
                       uv_map: [IntPair]) : [ResolvedCS] {
  match css {
    [] -> []
    [cs, ...rest] -> match cs {
      RCS(nm, line, col, tys, units, rows, mo, owner) ->
        [RCS(nm, line, col,
             map(tys, (t) => canon_uvars_ty(canon_tvars_ty(t, tv_map), uv_map)),
             map(units, (u) => canon_uvars_unit(u, uv_map)), rows, mo, owner),
         ...canon_resolved_css(rest, tv_map, uv_map)]
    }
  }
}


# per-module env composition.
#
# `build_ty_env_seed` builds the built-in baseline (`add_core_sigs`
# + `add_builtin_variant_sigs`) that every module inherits.
# `core_len = list_length(seed.entries)` is the boundary the
# `--holes` user-scope filter consults; it is the length of the
# *built-in* seed, NOT of any user core module.
#
# `build_ty_env_module` adds a single module's contributions to an
# inherited seed: registers every DFn / DType / DEffect against the
# entries already present, returning the updated env plus this
# module's op-effect arities. The fold composition is the call
# `build_ty_env_module(seed, all_decls)`, which is byte-identical
# to the monolithic builder.
#
# `unions` is a global property of the entire decl stream — collected
# once over the union of all modules and threaded around the per-module
# fold rather than recomputed per module. It is not part of
# `ModuleEnvDelta` under scope A.
#[doc("Typer-internal helper `build_ty_env_seed` shared across the infer modules.")]
pub fn build_ty_env_seed() : BuiltEnv {
  let e0 = ty_env_empty()
  let e1 = add_core_sigs(e0)
  let e2 = add_builtin_variant_sigs(e1)
  BuiltEnv { env: e2, core_len: list_length(e2.entries),
             op_eff_arities: [], new_arities: [] }
}


# The union-flavoured notes for a focused TyCon vs TyCon pair. Adds nothing
# when neither side has union context: the caller already attached the
# generic expected/found notes.
#[doc("Typer-internal helper `st_union_focus_notes` shared across the infer modules.")]
pub fn st_union_focus_notes(st: InferState, expected: Ty, found: Ty) : InferState {
  let env = st.env
  let exp_sym = ut_ty_sym(expected)
  let exp_shown = inf_tycon_display_ow(env.tab, env.head_owners, exp_sym)
  let fnd_shown = inf_tycon_display_ow(env.tab, env.head_owners, ut_ty_sym(found))
  let exp_comps = variants_of_type(env, exp_sym)
  let fnd_comps = variants_of_type(env, ut_ty_sym(found))
  let fnd_parents = ut_parents(env.unions, ut_ty_sym(found))
  let st1 = match exp_comps {
    [] -> st
    _  -> st_note(st, "union: `#{exp_shown}` = #{inf_join_with(exp_comps, " | ")}")
  }
  let st2 = match fnd_comps {
    [] -> match fnd_parents {
      [] -> st1
      [p, ..._rest] -> st_note(st1, "`#{fnd_shown}` is a component of `#{inf_tycon_display_ow(env.tab, env.head_owners, ut_row_sym(p))}`")
    }
    _ -> st_note(st1, "union: `#{fnd_shown}` = #{inf_join_with(fnd_comps, " | ")}")
  }
  match exp_comps {
    [] -> st2
    _ -> match fnd_parents {
      [p, ..._rest] -> {
        let ps = inf_tycon_display_ow(env.tab, env.head_owners, ut_row_sym(p))
        if ut_lists(env.unions, exp_sym, ut_row_sym(p)) {
          # The expected union already lists the found's parent, so the
          # failure is the no-chains rule: the upcast does not transit
          # through intermediate unions.
          st_help(st2, "the D3 upcast does not chain; lift through `#{ps}` first (e.g. `let x: #{ps} = ...`)")
        } else {
          st_help(st2, "extend `#{exp_shown}` to include `#{fnd_shown}` (or its parent `#{ps}`), or narrow via `match` before the call")
        }
      }
      [] -> if any(exp_comps, (c) => c == fnd_shown) {
              st_help(st2, "`#{exp_shown}` holds it inside its variant `#{fnd_shown}(...)`: wrap the value as `#{fnd_shown}(value)`")
            } else {
              st_help(st2, "extend `#{exp_shown}` to include `#{fnd_shown}`, or narrow via `match` before the call")
            }
    }
  }
}


# The constructors spelled `name` the sum `tsym` answers with: its own,
# else those of the types it lists as components, `depth` levels down.
#[doc("Typer-internal helper `ctors_of_type` shared across the infer modules.")]
pub fn ctors_of_type(env: TyEnv, tsym: SymId, name: String, depth: Int) : [SymId] =
  if sym_raw(tsym) < 0 or depth == 0 { [] }
  else { match own_ctor(env, tsym, name) {
    Some(c) -> [c]
    None    -> sym_list_unique(flat_map(ut_components(env.unions, tsym), (t) => component_ctors(env, tsym, ut_ty_sym(t), name, depth - 1)), [])
  } }


# A sum never answers through itself: a variant spelled like its own sum
# is listed as a component of it.
fn component_ctors(env: TyEnv, parent: SymId, comp: SymId, name: String, depth: Int) : [SymId] =
  if sym_same(comp, parent) { [] } else { ctors_of_type(env, comp, name, depth) }


# `m.name`: what the module `m` declares under the name, else the
# constructor of the sum `m` names to the reader.
#[doc("Typer-internal helper `settle_qualified` shared across the infer modules.")]
pub fn settle_qualified(st: InferState, m: String, name: String, cs: [NCls]) : Settled = {
  let tab = st.env.tab
  let in_module = match st_module(tab, m) {
    Some(ms) -> bound_syms(st.env, opt_syms(map(cs, (c) => st_lookup(tab, c, name, ms))))
    None     -> []
  }
  match in_module {
    [] -> settle_list(ctors_of_type(st.env, tsh_sym(st_home_view(st), m), name, 1))
    ss -> settle_list(ss)
  }
}


# A bare name on the scope ladder. Dispatchers the resolver left to the
# type stand for one operation whichever home generated them: one is the
# answer, several are a tie the receiver's type settles. A name no
# declaration of the classes
# answers may still be a union's tag, and past that it is whatever else
# the scope declares under it.
#[doc("Typer-internal helper `settle_bare` shared across the infer modules.")]
pub fn settle_bare(st: InferState, name: String, cs: [NCls]) : Settled = match settle_on_ladder(st, name, cs) {
  SetOne(s) -> SetOne(s)
  r         -> match op_dispatchers(st, name, cs, r) {
    [] -> match r {
      SetNone -> if list_is_empty(cs) { SetNone } else { settle_unanswered(st, name, cs) }
      _       -> r
    }
    ss -> settle_list(ss)
  }
}


fn settle_unanswered(st: InferState, name: String, cs: [NCls]) : Settled = {
  let tag = if ncls_in(cs, NCCtor) { component_tag(st, name) } else { SetNone }
  match tag {
    SetNone -> match other_declarations(st, name, cs) {
      [] -> SetNone
      ss -> SetOther(ss)
    }
    r -> r
  }
}


# A union that lists a declared type as a component keeps a variant for
# it, which registers no constructor: the type is the handle. Read as a
# value where nothing else is named so, the name is that variant, the
# union's own tag for the component.
fn component_tag(st: InferState, name: String) : Settled = {
  let tab = st.env.tab
  let comp = tsh_sym(st_home_view(st), name)
  if sym_raw(comp) < 0 { SetNone }
  else { settle_list(sym_list_unique(opt_syms(map(ut_parents(st.env.unions, comp), (r) => st_lookup(tab, NCCtor, name, sym_owner(tab, ut_row_sym(r))))), [])) }
}


# The dispatchers `name` is left between. A tie the scope found among
# dispatchers alone is that set. Otherwise it is every dispatcher
# generated under the name, whichever module holds the protocol: the
# resolver reaches an operation through the protocol rung, which sees
# past the reader's imports.
fn op_dispatchers(st: InferState, name: String, cs: [NCls], r: Settled) : [SymId] =
  if not ncls_in(cs, NCFn) { [] }
  else { match r {
    SetTie(ss) -> if op_tie(st, ss) { ss } else { env_dispatchers(st, name) }
    _          -> env_dispatchers(st, name)
  } }


fn env_dispatchers(st: InferState, name: String) : [SymId] =
  sym_list_unique(map(filter(ty_env_collect_candidates(st.env, name), (c) => pid_is_disp(st.protos.ids, c.sym)), (c) => c.sym), [])


# Several declarations on one rung answer a written name, and nothing
# picks among equals. The root file is told which modules export it, the
# way every contested name is reported there; a module's own body is told
# which types declare the constructor.
#[doc("Typer-internal helper `report_name_tie` shared across the infer modules.")]
pub fn report_name_tie(st: InferState, w: Written, ss: [SymId], called: Bool,
                   line: Int, col: Int) : InferState / Console + File =
  report_tie(st, "#{w}", ss, called, line, col)


# `shown` is the name as the source spells it, for the message alone.
#[doc("Typer-internal helper `report_tie` shared across the infer modules.")]
pub fn report_tie(st: InferState, shown: String, ss: [SymId], called: Bool,
              line: Int, col: Int) : InferState / Console + File = {
  let d = if is_none(st.home) or not all(ss, (s) => inf_is_ctor(st.env.tab, s)) { tie_modules_diag(st, shown, ss, called, line, col) }
          else { tie_types_diag(st, shown, ss, line, col) }
  st_bump_err(st_push_diag(st, d))
}


fn tie_types_diag(st: InferState, w: String, ss: [SymId], line: Int, col: Int) : Diagnostic = {
  let parents = sym_names(st.env.tab, ctor_sums(st.env, ss))
  let cands = format_ctor_candidates(w, parents)
  let first = ctor_first_parent(parents)
  mk_diag(SevError, st.file, line, col, "ambiguous constructor '#{w}' — declared by more than one type",
          [ri_note(st.file, line, col, "candidates: #{cands}"),
           ri_help(st.file, line, col, "qualify the constructor, e.g. `#{first}.#{w}`")])
}


# The sum each constructor builds, in order.
fn ctor_sums(env: TyEnv, cs: [SymId]) : [SymId] = match cs {
  [] -> []
  [c, ...rest] -> match ctor_entry(env, c) {
    Some(CtorPick(_, e)) -> [scheme_ret_sym(e.scheme), ...ctor_sums(env, rest)]
    None                 -> ctor_sums(env, rest)
  }
}


# What a pattern head settled to: the constructor's entry when one
# declaration answers and the environment binds it, or the tie.
#[doc("Typer-internal type `PatCtor` shared across the infer modules.")]
pub type PatCtor = PcOne(Option[CtorPick]) | PcTie([SymId])


# The rewrite's contract, diagnosed before building: no guards, heads
# are simple binders, and the arms cover every length (a catch-all, or
# `[]` plus a spread arm — the list-exhaustiveness rule).
#[doc("Typer-internal helper `vec_match_validate` shared across the infer modules.")]
pub fn vec_match_validate(st: InferState, arms: [Arm], line: Int, col: Int) : VecMatchGate / Console + File {
  let g = vec_match_check_arms(st, arms)
  let exhaustive = any_arm(arms, vec_arm_catchall) or
                   (any_arm(arms, arm_pat_empty_list) and any_arm(arms, arm_pat_spread_list))
  if exhaustive { g }
  else {
    let perr = mk_diag(SevError, g.st.file, line, col,
      "non-exhaustive match on Vec: cover both `[]` and a spread pattern (`[_, ...rest]`), or add a wildcard `_` arm", [])
    VecMatchGate { st: st_bump_err(st_push_diag(g.st, perr)), ok: false }
  }
}


# The ids of the constructors the environment binds for the sum `tsym`,
# newest first.
fn sum_ctor_ids(env: TyEnv, tsym: SymId) : [SymId] =
  sym_list_unique(map(env_ctors(env, tsym), (e) => env_key_sym(e.key)), [])


fn sym_list_unique(xs: [SymId], acc: [SymId]) : [SymId] = match xs {
  []           -> list_reverse(acc)
  [x, ...rest] -> sym_list_unique(rest, if sym_list_has(acc, x) { acc } else { [x, ...acc] })
}


# The constructors of the sum `tsym` declares, as an arm spells them,
# newest first.
fn sum_ctor_names(env: TyEnv, tsym: SymId) : [String] =
  union_merge_unique([], sym_names(env.tab, sum_ctor_ids(env, tsym)))


# A constructor as the sum table answers for it: its declaration, and
# the entry it was registered with.
#[doc("Typer-internal type `CtorPick` shared across the infer modules.")]
pub type CtorPick = CtorPick(SymId, TyEntry)


# The constructor `c` as the environment binds it.
#[doc("Typer-internal helper `ctor_entry` shared across the infer modules.")]
pub fn ctor_entry(env: TyEnv, c: SymId) : Option[CtorPick] = match vix_of_ctor(env.vindex, c) {
  [e, ..._] -> Some(CtorPick(c, e))
  []        -> None
}


# The names a diagnostic lists for the type `tsym` declares: its
# constructors, then the components no constructor stands for (a
# variant naming a declared type registers none).
fn variants_of_type(env: TyEnv, tsym: SymId) : [String] =
  union_merge_unique(sum_ctor_names(env, tsym), union_component_names(env.tab, env.unions, tsym))


#[doc("The error header for a pattern spelled `name` against the union `tsym` when it lists a declared type of that name instead of a constructor.")]
pub fn union_component_header(st: InferState, tsym: SymId, name: String) : Option[String] =
  match find(ut_components(st.env.unions, tsym), (c) => component_shown(st, c) == name) {
    Some(TyCon(cs, _)) -> {
      let kind = match rec_find(st.recs, cs) { Some(_) -> "record type"  None -> "type" }
      Some("`#{name}` in `#{inf_tycon_display_ow(st.env.tab, st.env.head_owners, tsym)}` is the #{kind} `#{name}`, not a unit variant")
    }
    _ -> None
  }


fn component_shown(st: InferState, t: Ty) : String = match t {
  TyCon(cs, _) -> inf_tycon_display_ow(st.env.tab, st.env.head_owners, cs)
  _            -> ""
}


# One variant of a sum as a match reads it: its constructor, and the
# type its name denotes — a declared type of that name, else the
# constructor itself.
#[doc("Typer-internal type `SumVar` shared across the infer modules.")]
pub type SumVar = SumVar(SymId, SymId)


#[doc("Typer-internal helper `sum_var_ctor` shared across the infer modules.")]
pub fn sum_var_ctor(v: SumVar) : SymId = match v { SumVar(c, _) -> c }


#[doc("Typer-internal helper `sum_var_names` shared across the infer modules.")]
pub fn sum_var_names(v: SumVar, t: SymId) : Bool = match v {
  SumVar(_, comp) -> sym_raw(t) >= 0 and sym_same(comp, t)
}


# The variants of the sum `tsym` declares, in declaration order. A union
# row lists one component per variant, in the same order.
#[doc("Typer-internal helper `sum_vars` shared across the infer modules.")]
pub fn sum_vars(st: InferState, tsym: SymId) : [SumVar] = match sum_find(st.sums, tsym) {
  Some(SI(_, _, vs, _)) -> sum_vars_zip(vs, ut_components(st.env.unions, tsym))
  None                  -> []
}


fn sum_vars_zip(vs: [Variant], comps: [Ty]) : [SumVar] = match vs {
  [] -> []
  [Var(c, _), ...rest] -> match comps {
    [t, ...more] -> [SumVar(c, ut_ty_sym(t)), ...sum_vars_zip(rest, more)]
    []           -> [SumVar(c, sym_none()), ...sum_vars_zip(rest, [])]
  }
}


fn sum_var_of(vars: [SumVar], c: SymId) : SumVar = match find(vars, (v) => sym_same(sum_var_ctor(v), c)) {
  Some(v) -> v
  None    -> SumVar(c, sym_none())
}


# What a match on the type `tsym` declares must cover: its
# constructors, newest first, then the variants no constructor is bound
# for (a variant naming a declared type registers none).
#[doc("Typer-internal helper `match_needs` shared across the infer modules.")]
pub fn match_needs(st: InferState, tsym: SymId) : [SumVar] =
  if sym_raw(tsym) < 0 { [] }
  else {
    let vars = sum_vars(st, tsym)
    let bound = sum_ctor_ids(st.env, tsym)
    list_append(map(bound, (c) => sum_var_of(vars, c)),
                filter(vars, (v) => match v { SumVar(c, t) -> sym_raw(t) >= 0 and not sym_list_has(bound, c) }))
  }


# The name a diagnostic lists a variant by.
#[doc("Typer-internal helper `need_names` shared across the infer modules.")]
pub fn need_names(tab: SymTab, vs: [SumVar]) : [String] = sym_names(tab, map(vs, sum_var_ctor))


# An arm of its constructor covers a variant. A variant no constructor
# is bound for stands for a declared type: a record pattern of that
# type covers it, and so do arms of every constructor the type declares.
fn need_covered(st: InferState, arms: [Arm], v: SumVar) : Bool = match v {
  SumVar(c, t) -> match ctor_entry(st.env, c) {
    Some(_) -> arms_head(arms, c)
    None    -> arms_head(arms, t) or sum_ctors_headed(st.env, arms, t)
  }
}


fn sum_ctors_headed(env: TyEnv, arms: [Arm], t: SymId) : Bool = match sum_ctor_ids(env, t) {
  [] -> false
  cs -> all(cs, (x) => arms_head(arms, x))
}


fn union_merge_unique(a: [String], b: [String]) : [String] {
  match b {
    [] -> a
    [n, ...rest] -> if list_has(a, n) { union_merge_unique(a, rest) }
                    else { union_merge_unique(list_append(a, [n]), rest) }
  }
}


# Classify a sum's constructors for `variants[T]()`, which lists the
# inhabitants of a nullary-only sum: its nullary constructors, the ones
# that take arguments, or no constructor at all.
#[doc("Typer-internal type `VariantsCheck` shared across the infer modules.")]
pub type VariantsCheck = VCOk([SymId]) | VCNotSum | VCHasPayload([SymId])


#[doc("Typer-internal helper `check_variants_nullary` shared across the infer modules.")]
pub fn check_variants_nullary(env: TyEnv, tsym: SymId) : VariantsCheck =
  check_variants_nullary_rows(env_ctors(env, tsym), [], [])


# The chain is newest first, so prepending restores declaration order,
# which `variants[T]()` guarantees.
fn check_variants_nullary_rows(rows: [TyEntry], ok_acc: [SymId], err_acc: [SymId]) : VariantsCheck =
  match rows {
    [] -> if list_is_empty(ok_acc) and list_is_empty(err_acc) { VCNotSum }
          else if list_is_empty(err_acc) { VCOk(ok_acc) }
          else { VCHasPayload(err_acc) }
    [e, ...rest] ->
      if scheme_takes_args(e.scheme) { check_variants_nullary_rows(rest, ok_acc, [env_key_sym(e.key), ...err_acc]) }
      else { check_variants_nullary_rows(rest, [env_key_sym(e.key), ...ok_acc], err_acc) }
  }


fn scheme_takes_args(sc: TyScheme) : Bool = match sc {
  Scheme(_, _, _, _, TyFnT(pargs, _, _)) -> not list_is_empty(pargs)
  _                                      -> false
}


#[doc("Typer-internal helper `find_missing_variants` shared across the infer modules.")]
pub fn find_missing_variants(st: InferState, needed: [SumVar], arms: [Arm], acc: [SumVar]) : [SumVar] {
  match needed {
    [] -> list_reverse(acc)
    [v, ...rest] -> {
      if need_covered(st, arms, v) {
        find_missing_variants(st, rest, arms, acc)
      } else {
        find_missing_variants(st, rest, arms, [v, ...acc])
      }
    }
  }
}


# Inverse of find_missing_variants — used by the match diagnostics to print
# the "covered:" note alongside "missing:". Walking the needed list
# again is cheaper than caching given the small variant counts.
#[doc("Typer-internal helper `find_covered_variants` shared across the infer modules.")]
pub fn find_covered_variants(st: InferState, needed: [SumVar], arms: [Arm], acc: [SumVar]) : [SumVar] {
  match needed {
    [] -> list_reverse(acc)
    [v, ...rest] -> {
      if need_covered(st, arms, v) {
        find_covered_variants(st, rest, arms, [v, ...acc])
      } else {
        find_covered_variants(st, rest, arms, acc)
      }
    }
  }
}


# The notes and help under a non-exhaustive match: one per missing
# variant, the covered list, and the canonical fix.
fn build_nonexhaustive_related(file: String, line: Int, col: Int,
                                 missing: [String], covered: [String]) : [RelatedInfo] {
  let miss_notes = map(missing, (m) => ri_note(file, line, col, "missing variant: `#{m}`"))
  let cov_notes = match covered {
    [] -> []
    _  -> [ri_note(file, line, col, "covered: #{inf_join_with(covered, ", ")}")]
  }
  let help_msg = match missing {
    []        -> "add a wildcard `_ -> ...` arm"
    [m, ..._] -> "add an arm `#{m} -> ...` or a wildcard `_ -> ...`"
  }
  let help_ri = [ri_help(file, line, col, help_msg)]
  list_append(miss_notes, list_append(cov_notes, help_ri))
}


#[doc("Typer-internal helper `build_nonexhaustive_diag` shared across the infer modules.")]
pub fn build_nonexhaustive_diag(file: String, line: Int, col: Int,
                              header: String, missing: [String],
                              covered: [String]) : Diagnostic =
  mk_diag(SevError, file, line, col, header,
          build_nonexhaustive_related(file, line, col, missing, covered))


# A pattern hole reports what the arms before its own leave uncovered.
#[doc("Typer-internal helper `annotate_pattern_holes` shared across the infer modules.")]
pub fn annotate_pattern_holes(st: InferState, arms: [Arm], scr_ty: Ty) : InferState =
  annotate_arm_holes(st, [], arms, scr_ty)


fn annotate_arm_holes(st: InferState, before: [Arm], rest: [Arm], scr_ty: Ty) : InferState = match rest {
  [] -> st
  [Arm(p, g, b), ...tail] -> {
    let holes = pattern_holes(p)
    let st1 = if list_is_empty(holes) { st } else {
      let rem = match x_match_remaining(before, XCtors((c) => x_ctor_entry(st, c, scr_ty))) {
        XMissing(ws) -> Some(ws)
        XCovered     -> Some([])
        XUnknown     -> None
      }
      InferState { ...st, holes: map(st.holes, (h) => set_pattern_remaining(h, holes, rem)) }
    }
    annotate_arm_holes(st1, list_append(before, [Arm(p, g, b)]), tail, scr_ty)
  }
}


fn set_pattern_remaining(h: HoleSite, holes: [Pattern], rem: Option[[String]]) : HoleSite = match h {
  HS(HKPattern(nm, _), line, col, fresh, scope, env_fresh, handled) ->
    if any(holes, (p) => p.line == line and p.col == col) {
      HS(HKPattern(nm, rem), line, col, fresh, scope, env_fresh, handled)
    } else { h }
  _ -> h
}


# Arms naming every constructor can still miss a value: a guard, a literal
# or a nested pattern narrows what an arm covers.
#[doc("Typer-internal helper `check_exhaustive_matrix` shared across the infer modules.")]
pub fn check_exhaustive_matrix(st: InferState, arms: [Arm], scr_ty: Ty, line: Int, col: Int) : InferState / Console + File =
  match x_match_verdict(arms, XCtors((c) => x_ctor_entry(st, c, scr_ty))) {
    XMissing([w, ..._]) -> report_uncovered(st, w, line, col)
    _                   -> st
  }


fn report_uncovered(st: InferState, w: String, line: Int, col: Int) : InferState / Console + File = {
  let header = if w == "_" { "non-exhaustive match: the arms' literals and guards do not cover every value" }
               else { "non-exhaustive match: no arm covers `#{w}`" }
  let help_msg = "add an arm for the uncovered values, or a wildcard `_` arm; a guarded arm covers nothing on its own"
  st_bump_err(st_push_diag(st, mk_diag(SevError, st.file, line, col, header, [ri_help(st.file, line, col, help_msg)])))
}


# A constructor's siblings. One the scrutinee's type does not declare is
# left unplaced when more than one type declares its name: the check
# then answers unknown rather than read the wrong type.
fn x_ctor_entry(st: InferState, c: SymId, scr_ty: Ty) : Option[[XSib]] =
  match x_ctor_scheme(st.env, c, scr_ty) {
    Some(sc) -> Some(x_ctor_siblings(st, c, sc))
    None     -> match rec_find(st.recs, c) {
      Some(_) -> Some([XSib(c, written_text(decl_name(st.env.tab, c)))])
      None    -> None
    }
  }


fn x_ctor_scheme(env: TyEnv, c: SymId, scr_ty: Ty) : Option[TyScheme] = match ctor_entry(env, c) {
  None -> None
  Some(CtorPick(_, e)) ->
    if sym_same(scheme_ret_sym(e.scheme), ut_ty_sym(scr_ty)) and sym_raw(ut_ty_sym(scr_ty)) >= 0 { Some(e.scheme) }
    else if ctor_has_homonym(env.tab, c) { None }
    else { Some(e.scheme) }
}


# True when another type declares a constructor spelled like `c`: a
# second declaration in the table, or one the runtime builds.
fn ctor_has_homonym(tab: SymTab, c: SymId) : Bool =
  match find(core_ctor_names(), (n) => sym_same(c, core_ctor_sym(n))) {
    Some(n) -> any(st_candidates(tab, NCCtor, n), (s) => not sym_same(s, c))
    None    -> sym_contested(tab, c) or any(core_ctor_names(), (n) => match st_lookup(tab, NCCtor, n, sym_owner(tab, c)) {
      Some(s) -> sym_same(s, c)
      None    -> false
    })
  }


# A type with no variant list has the one constructor. A variant no
# constructor is bound for is headed by a record pattern of its type.
fn x_ctor_siblings(st: InferState, c: SymId, sc: TyScheme) : [XSib] = {
  let tsym = scheme_ret_sym(sc)
  let tab = st.env.tab
  match match_needs(st, tsym) {
    []   -> [XSib(c, written_text(decl_name(tab, c)))]
    sibs -> map(sibs, (v) => match v {
      SumVar(s, t) -> match ctor_entry(st.env, s) {
        Some(CtorPick(_, e)) -> XSib(s, x_ctor_spelling(written_text(decl_name(tab, s)), e.scheme))
        None                 -> XSib(t, written_text(decl_name(tab, s)))
      }
    })
  }
}


fn x_ctor_spelling(cn: String, sc: TyScheme) : String = match sc {
  Scheme(_, _, _, _, TyFnT(params, _, _)) ->
    if list_is_empty(params) { cn } else { concat_all([cn, "(", inf_join_with(map(params, (p) => "_"), ", "), ")"]) }
  _ -> cn
}


# a tycon is a "union of types" when it was declared
# as `type T = A | B | ...` where every A, B, ... is itself a
# declared type with its own variants (e.g. `type ErrAB = ErrA |
# ErrB` with `type ErrA = ...`). `env.unions` records every
# `TBSum` decl, so we can't simply ask "is tycon in env.unions";
# regular sum types like `type ExprKind = EInt | EReal | ...` are
# also there but their variant names (`EInt`, `EReal`, ...) are
# not themselves declared types. Requiring EVERY component to be
# a declared sum/union type isolates true unions-of-types from
# regular sum types and from union collision shapes.
#[doc("Typer-internal helper `is_union_of_types` shared across the infer modules.")]
pub fn is_union_of_types(env: TyEnv, tycon: SymId) : Bool {
  match ut_components(env.unions, tycon) {
    [] -> false
    comps -> all_components_are_declared_types(env, comps)
  }
}


fn all_components_are_declared_types(env: TyEnv, comps: [Ty]) : Bool {
  match comps {
    [] -> true
    [c, ...rest] -> match ut_components(env.unions, ut_ty_sym(c)) {
      [] -> false
      _  -> all_components_are_declared_types(env, rest)
    }
  }
}


# trigger for the per-component recursive
# exhaustiveness check. Returns true iff any arm uses a `PNarrow`
# pattern, which is the signal that the user is matching on a
# union-of-types and wants per-component coverage.
#[doc("Typer-internal helper `any_arm_is_narrow` shared across the infer modules.")]
pub fn any_arm_is_narrow(arms: [Arm]) : Bool {
  match arms {
    [] -> false
    [a, ...rest] -> match a {
      Arm(pat, _, _) -> match pat.pkind {
        PNarrow(_, _) -> true
        _             -> any_arm_is_narrow(rest)
      }
    }
  }
}


fn arm_pat_empty_list(a: Arm) : Bool {
  match a {
    Arm(pat, guard, _) -> {
      let unguarded = match guard { None -> true Some(_) -> false }
      if not unguarded { false } else { pat_is_empty_list(pat) }
    }
  }
}


# drill through `name @ inner` for the list-exhaustiveness
# helpers so an as-pattern wrapping `[]` or `[_, ...rest]` still
# satisfies the check.
fn pat_is_empty_list(pat: Pattern) : Bool {
  match pat.pkind {
    PList(ps, rest_opt) -> match ps {
      [] -> match rest_opt { None -> true Some(_) -> false }
      _  -> false
    }
    PAs(_, sub) -> pat_is_empty_list(sub)
    _ -> false
  }
}


fn arm_pat_spread_list(a: Arm) : Bool {
  match a {
    Arm(pat, guard, _) -> {
      let unguarded = match guard { None -> true Some(_) -> false }
      if not unguarded { false } else { pat_is_spread_list(pat) }
    }
  }
}


fn pat_is_spread_list(pat: Pattern) : Bool {
  match pat.pkind {
    PList(_, rest_opt) -> match rest_opt {
      Some(_) -> true
      None    -> false
    }
    PAs(_, sub) -> pat_is_spread_list(sub)
    _ -> false
  }
}


fn any_arm(arms: [Arm], pred: (Arm) -> Bool) : Bool {
  match arms {
    [] -> false
    [a, ...rest] -> if pred(a) { true } else { any_arm(rest, pred) }
  }
}


#[doc("Typer-internal helper `check_list_exhaustive` shared across the infer modules.")]
pub fn check_list_exhaustive(st: InferState, arms: [Arm], line: Int, col: Int) : InferState / Console + File {


  let has_empty  = any_arm(arms, arm_pat_empty_list)
  let has_spread = any_arm(arms, arm_pat_spread_list)
  if has_empty and has_spread { st }
  else {
    let missing = if has_empty { "non-empty lists (e.g. `[_, ...rest]`)" }
                  else if has_spread { "the empty list `[]`" }
                  else { "the empty list `[]` and non-empty lists (e.g. `[_, ...rest]`)" }
    let header = "non-exhaustive match on list: missing #{missing}"
    let help_msg = "cover both `[]` and a spread pattern, or add a wildcard `_` arm"
    let d = mk_diag(SevError, st.file, line, col, header,
                    [ri_help(st.file, line, col, help_msg)])
    st_bump_err(st_push_diag(st, d))
  }
}


# One `sig <fn> <eff>#<id>` line per label the signature's row declares,
# the effect under the name it is emitted with.
#[doc("Typer-internal helper `print_sig_ids` shared across the infer modules.")]
pub fn print_sig_ids(tab: SymTab, nm: String, ls: [RowLabel]) : Unit / Console = match ls {
  [] -> ()
  [RL(r, _), ...rest] -> {
    print("sig #{nm} #{rt_ref_name(tab, r)}##{int_to_string(sym_raw(ref_sym(r)))}")
    print_sig_ids(tab, nm, rest)
  }
}


#[doc("Typer-internal helper `row_expr_labels` shared across the infer modules.")]
pub fn row_expr_labels(r: RowExpr) : [RowLabel] = match r {
  REmpty -> []
  RClosed(ls) -> ls
  ROpen(_, ls) -> ls
}


# One `row <fn> <eff>#<id>` line per label the body's row carries.
#[doc("Typer-internal helper `print_row_ids` shared across the infer modules.")]
pub fn print_row_ids(tab: SymTab, nm: String, row: [Label]) : Unit / Console = match row {
  [] -> ()
  [l, ...rest] -> {
    print("row #{nm} #{rt_name(tab, l.sym)}##{int_to_string(sym_raw(l.sym))}")
    print_row_ids(tab, nm, rest)
  }
}


# A CallSite whose fresh var ids have been resolved via the final
# substitution to concrete types. Consumed by monomorphisation later
# and surfaced as-is by `--dump-mono`. The trailing `[UnitExprT]`
# carries the resolved units for the scheme's unit-kind tparams
# — used to differentiate impl `Show for Real<u>`
# specialisations that share an empty type tuple but bind `u` to
# distinct concrete units (USD vs EUR vs `m^2` ...).
# `mo` propagates from the originating CallSite — see CallSite's
# Hanga Roa note for why downstream consumers need it.
#[doc("infer: what a call instantiated a row variable of its callee's scheme with.")]
#[derive(BinSerialize)]
pub type RowBind = RwB(Int, Row)

#[doc("infer: a resolved call-site instantiation consumed by monomorphisation.")]
#[derive(BinSerialize)]
pub type ResolvedCS = RCS(SymId, Int, Int, [Ty], [UnitExprT], [RowBind], Option[String], SymId)  # declaration, line, col, concrete tys, concrete units, instantiated row vars, module_origin, enclosing function


# A hole resolved against the final substitution: the expected type
# is the TyVarT ran through sub, which usually pins to a concrete
# type from context but can remain a TyVarT if the hole sits in a
# position that doesn't constrain (e.g. the whole body of a fn with
# no declared return).
#[doc("infer: the function a hole sits in and its parameters' binders, or none for a hole outside a function.")]
#[derive(BinSerialize)]
pub type HoleOwner = HOwner(SymId, [LocalId]) | HNoOwner


#[doc("infer: the effects a hole's context makes available — any, under an open row; else the declared labels, the enclosing handlers' labels, and whether `main`'s default-handled effects are absorbed.")]
#[derive(BinSerialize)]
pub type HoleRow = HRowOpen | HRowLabels([Label], [Label], Bool)


#[doc("infer: `ResolvedHole` — driver-facing type.")]
#[derive(BinSerialize)]
pub type ResolvedHole = RH(HoleKind, Int, Int, Ty, [TyEntry], Int, HoleOwner, HoleRow)


# a typed effect-hole resolution. Recorded
# per occurrence of `?` or `?name` in row tail position; one instance
# per parser placeholder regardless of how many times the same source
# name (`?e`) appears in a signature — each `?e` is its own anonymous
# row variable, not a re-use, so the reporter mirrors that.
#
# Fields:
#   - source name (`Some("e")` for `?e`, `None` for bare `?`)
#   - source line/col (location of the `?` token in the input file)
#   - enclosing fn
#   - resolved Row (apply_row of the row-var the hole was bound to)
#   - body_row: effects actually performed by the fn's body. Useful
#     because `check_body_row` skips unification when the declared
#     row is `ROpen` (a hole IS an open row), so `resolved` is often
#     just the unbound tail variable. Consumers (LLMs) want to know
#     the body's effective row to fill the hole with. Order matches
#     the order labels were first encountered during inference.
#[doc("infer: `ResolvedRowHole` — driver-facing type.")]
#[derive(BinSerialize)]
pub type ResolvedRowHole = RRH(Option[String], Int, Int, SymId, Row, [SymId])


#[doc("Typer-internal helper `take_entries` shared across the infer modules.")]
pub fn take_entries(es: [TyEntry], n: Int, acc: [TyEntry]) : [TyEntry] {
  if n <= 0 { list_reverse(acc) }
  else { match es {
    [] -> list_reverse(acc)
    [h, ...rest] -> take_entries(rest, n - 1, [h, ...acc])
  } }
}


#[doc("infer: drop the trailing `n` entries of a scope listing, hiding top-level bindings.")]
pub fn drop_last_entries(es: [TyEntry], n: Int) : [TyEntry] {
  let total = list_length(es)
  let keep = total - n
  if keep <= 0 { [] } else { take_entries(es, keep, []) }
}


#[doc("Typer-internal helper `hole_row_handling` shared across the infer modules.")]
pub fn hole_row_handling(base: HoleRow, handled: [Label]) : HoleRow = match base {
  HRowOpen                   -> HRowOpen
  HRowLabels(declared, _, a) -> HRowLabels(declared, handled, a)
}


# Decls after inference: type-annotated body (or original decl for
# non-DFn). Also carries the error count, the resolved call-site
# instantiations, and the resolved hole reports.
#[doc("Typer-internal type `TypedDecl` shared across the infer modules.")]
pub type TypedDecl = { decl: Decl, errs: Int, insts: [ResolvedCS],
                    holes: [ResolvedHole], row_holes: [ResolvedRowHole],
                    # per-decl collected diagnostics (T1, T2,
                    # T4, T5). Stored in source order (already reversed
                    # at the per-decl level, since `infer_all_loop`
                    # reverses again when assembling `TypedProgram`).
                    diags: [Diagnostic],
                    # per-decl op-call resolutions (#820 evidence
                    # analysis). Mirrors `diags`' aggregation: stored
                    # source-order here, reversed into `TypedProgram`.
                    op_res: [OpResolution] }

