#[doc("""
The resolver's scope chain: a stack of scopes, each binding a written
name to what it declares.

A scope holds `(name, Bound)` pairs, not names. That is the whole
difference from a stack of name lists: a lookup answers *which*
declaration or binder a name reaches, so the walker that finds it can
write the identity into the tree instead of re-deriving it in every pass
downstream.

A name is bound to one of two things: a declaration the symbol table
holds, or a local binder. The two are different types, so no consumer
can take one for the other. The name itself is the resolver's lookup
key and lives nowhere else.

Local ids are minted at the moment of declaring, counting up from 1
across the whole walk. A binder that already carries an id keeps it,
and the counter steps past it.

The outermost scope holds every top-level name of the program, so it
is not scanned: once it has grown, pushing the first inner scope folds
its bindings into a hash index. Bindings the outermost scope takes
after that stay in its list, which is searched before the index, so
the newest binding of a name still wins.
""")]

import compiler.ast
import compiler.symtab

#[doc("What a scope binds a name to: a declaration, or a local binder.")]
pub type Bound = BDecl(SymId) | BLocal(LocalId)

#[doc("One binding: the name as written, and what it declares.")]
pub type ChBind = ChBind(String, Bound)

#[doc("The outermost scope's folded bindings: newest first in `all`, and bucketed by name.")]
pub type ChIndex = { all: [ChBind], buckets: Array[[ChBind]], nb: Int }

#[doc("A stack of scopes, innermost first, the outermost scope's folded bindings, and the next local id to mint.")]
pub type ScopeChain = { scopes: [[ChBind]], root: ChIndex, next_local: Int }

#[doc("A chain with one empty scope and no locals minted yet.")]
pub fn ch_new() : ScopeChain =
  ScopeChain { scopes: [[]],
               root: ChIndex { all: [], buckets: array_make(0, []), nb: 0 },
               next_local: 1 }

#[doc("The same chain with a fresh innermost scope.")]
pub fn ch_push(c: ScopeChain) : ScopeChain = match c.scopes {
  [top] -> if ch_at_least(top, 16) { ch_fold(c, top) } else { ch_pushed(c) }
  _     -> ch_pushed(c)
}

fn ch_pushed(c: ScopeChain) : ScopeChain =
  ScopeChain { scopes: [[], ...c.scopes], root: c.root, next_local: c.next_local }

fn ch_fold(c: ScopeChain, top: [ChBind]) : ScopeChain =
  ScopeChain { scopes: [[], []], root: ch_index(list_append(top, c.root.all)),
               next_local: c.next_local }

fn ch_at_least(bs: [ChBind], n: Int) : Bool =
  if n == 0 { true } else { match bs {
    [] -> false
    [_, ...rest] -> ch_at_least(rest, n - 1)
  } }

fn ch_index(all: [ChBind]) : ChIndex {
  let nb = ch_nbuckets(list_length(all), 16)
  ChIndex { all: all, buckets: ch_fill(list_reverse(all), array_make(nb, []), nb), nb: nb }
}

fn ch_nbuckets(n: Int, nb: Int) : Int = if nb >= 2 * n { nb } else { ch_nbuckets(n, 2 * nb) }

# Filled oldest first, so each bucket lists the newest binding of a name first.
fn ch_fill(bs: [ChBind], a: Array[[ChBind]], nb: Int) : Array[[ChBind]] / Mutable = match bs {
  [] -> a
  [b, ...rest] -> {
    let i = st_slot(ch_name(b), nb)
    ch_fill(rest, array_set(a, i, [b, ...array_get(a, i)]), nb)
  }
}

fn ch_name(b: ChBind) : String = match b { ChBind(n, _) -> n }

#[doc("The same chain with its innermost scope discarded. Popping the last scope is a no-op, so an unbalanced walk cannot empty the chain.")]
pub fn ch_pop(c: ScopeChain) : ScopeChain = match c.scopes {
  [_, ...rest] -> match rest {
    [] -> c
    _  -> ScopeChain { scopes: rest, root: c.root, next_local: c.next_local }
  }
  [] -> c
}

#[doc("Bind `name` to `b` in the innermost scope, shadowing whatever the outer scopes bind it to.")]
pub fn ch_bind(c: ScopeChain, name: String, b: Bound) : ScopeChain = match c.scopes {
  [top, ...rest] ->
    ScopeChain { scopes: [[ChBind(name, b), ...top], ...rest], root: c.root,
                 next_local: c.next_local }
  [] -> c
}

#[doc("The id the next `ch_declare_local` binds.")]
pub fn ch_next_local(c: ScopeChain) : LocalId = LocalId(c.next_local)

#[doc("Declare `name` as a local binder: mint a fresh id and bind it in the innermost scope.")]
pub fn ch_declare_local(c: ScopeChain, name: String) : ScopeChain =
  ch_bind(ScopeChain { scopes: c.scopes, root: c.root, next_local: c.next_local + 1 },
          name, BLocal(LocalId(c.next_local)))

#[doc("Bind `name` to the binder `l`, which already carries its id. The counter steps past a numbered one, so no later binder takes the same id.")]
pub fn ch_bind_local(c: ScopeChain, name: String, l: LocalId) : ScopeChain = {
  let next = if local_raw(l) >= c.next_local { local_raw(l) + 1 } else { c.next_local }
  ch_bind(ScopeChain { scopes: c.scopes, root: c.root, next_local: next }, name, BLocal(l))
}

#[doc("What `name` reaches, walking innermost scope outward, or `None` when nothing binds it.")]
pub fn ch_lookup(c: ScopeChain, name: String) : Option[Bound] = match ch_walk(c.scopes, name) {
  Some(b) -> Some(b)
  None    -> ch_probe(c.root, name)
}

fn ch_walk(ss: [[ChBind]], name: String) : Option[Bound] = match ss {
  [] -> None
  [top, ...rest] -> match ch_in(top, name) {
    Some(b) -> Some(b)
    None    -> ch_walk(rest, name)
  }
}

fn ch_in(bs: [ChBind], name: String) : Option[Bound] = match bs {
  [] -> None
  [ChBind(n, b), ...rest] -> if n == name { Some(b) } else { ch_in(rest, name) }
}

fn ch_probe(ix: ChIndex, name: String) : Option[Bound] =
  if ix.nb == 0 { None } else { ch_in(array_get(ix.buckets, st_slot(name, ix.nb)), name) }

#[doc("Every local binder of `name` in scope, innermost first.")]
pub fn ch_locals(c: ScopeChain, name: String) : [LocalId] = ch_locals_in(c.scopes, name)

fn ch_locals_in(ss: [[ChBind]], name: String) : [LocalId] = match ss {
  [] -> []
  [top, ...rest] -> list_append(ch_locals_of(top, name), ch_locals_in(rest, name))
}

fn ch_locals_of(bs: [ChBind], name: String) : [LocalId] = match bs {
  [] -> []
  [ChBind(n, BLocal(l)), ...rest] -> if n == name { [l, ...ch_locals_of(rest, name)] } else { ch_locals_of(rest, name) }
  [_, ...rest] -> ch_locals_of(rest, name)
}

#[doc("True when `name` is bound anywhere in the chain.")]
pub fn ch_has(c: ScopeChain, name: String) : Bool = match ch_lookup(c, name) {
  Some(_) -> true
  None    -> false
}

#[doc("True when a local binder shadows `name`. A declaration bound in the outermost scope does not shadow itself.")]
pub fn ch_shadows(c: ScopeChain, name: String) : Bool = match ch_lookup(c, name) {
  Some(BLocal(_)) -> true
  _               -> false
}

#[doc("Every name the chain binds, innermost first. Only the did-you-mean suggestion reads this.")]
pub fn ch_names(c: ScopeChain) : [String] =
  list_append(ch_names_loop(c.scopes, []), ch_scope_names(c.root.all))

fn ch_names_loop(ss: [[ChBind]], acc: [String]) : [String] = match ss {
  [] -> acc
  [top, ...rest] -> ch_names_loop(rest, list_append(acc, ch_scope_names(top)))
}

fn ch_scope_names(bs: [ChBind]) : [String] = match bs {
  [] -> []
  [ChBind(n, _), ...rest] -> [n, ...ch_scope_names(rest)]
}
