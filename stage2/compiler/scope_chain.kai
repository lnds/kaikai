#[doc("""
The resolver's scope chain: a stack of scopes, each binding a name to
the symbol it declares.

A scope holds `(name, SymId)` pairs, not names. That is the whole
difference from a stack of name lists: a lookup answers *which*
declaration a name reaches, so the walker that finds it can stamp the
identity into the tree instead of re-deriving it in every pass
downstream.

Ids are minted at the moment of declaring, by the scope that declares.
A local binder is a declaration like any other — the same `declare`
that a top-level function goes through — so no consumer needs a
separate rule for locals.

Local ids are negative and count down from `-2`, so they never index
the module symbol table and no consumer can confuse the two: a
positive id is a declaration the table knows, a negative one is a
binder that lives and dies inside this walk. `sym_none()` is `-1`, so
counting from `-2` keeps it distinct from every binder.
""")]

import compiler.ast
import compiler.symtab

#[doc("One binding: the name as written, and the symbol it declares.")]
pub type ScopeBind = ScopeBind(String, SymId)

#[doc("A stack of scopes, innermost first, plus the counter that mints local ids.")]
pub type ScopeChain = { scopes: [[ScopeBind]], next_local: Int }

#[doc("A chain with one empty scope and no locals minted yet.")]
pub fn ch_new() : ScopeChain = ScopeChain { scopes: [[]], next_local: 0 - 2 }

#[doc("The same chain with a fresh innermost scope.")]
pub fn ch_push(c: ScopeChain) : ScopeChain =
  ScopeChain { scopes: [[], ...c.scopes], next_local: c.next_local }

#[doc("The same chain with its innermost scope discarded. Popping the last scope is a no-op, so an unbalanced walk cannot empty the chain.")]
pub fn ch_pop(c: ScopeChain) : ScopeChain = match c.scopes {
  [_, ...rest] -> match rest {
    [] -> c
    _  -> ScopeChain { scopes: rest, next_local: c.next_local }
  }
  [] -> c
}

#[doc("Bind `name` to `s` in the innermost scope, shadowing whatever the outer scopes bind it to.")]
pub fn ch_bind(c: ScopeChain, name: String, s: SymId) : ScopeChain = match c.scopes {
  [top, ...rest] ->
    ScopeChain { scopes: [[ScopeBind(name, s), ...top], ...rest], next_local: c.next_local }
  [] -> c
}

#[doc("Declare `name` as a local binder: mint a fresh id and bind it in the innermost scope.")]
pub fn ch_declare_local(c: ScopeChain, name: String) : ScopeChain =
  ch_bind(ScopeChain { scopes: c.scopes, next_local: c.next_local - 1 },
          name, SymId(c.next_local))

#[doc("The symbol `name` reaches, walking innermost scope outward, or `None` when nothing binds it.")]
pub fn ch_lookup(c: ScopeChain, name: String) : Option[SymId] = ch_walk(c.scopes, name)

fn ch_walk(ss: [[ScopeBind]], name: String) : Option[SymId] = match ss {
  [] -> None
  [top, ...rest] -> match ch_in(top, name) {
    Some(s) -> Some(s)
    None    -> ch_walk(rest, name)
  }
}

fn ch_in(bs: [ScopeBind], name: String) : Option[SymId] = match bs {
  [] -> None
  [ScopeBind(n, s), ...rest] -> if n == name { Some(s) } else { ch_in(rest, name) }
}

#[doc("True when `name` is bound anywhere in the chain.")]
pub fn ch_has(c: ScopeChain, name: String) : Bool = match ch_lookup(c, name) {
  Some(_) -> true
  None    -> false
}

#[doc("True when `s` is a local binder rather than a declaration the symbol table holds.")]
pub fn ch_is_local(s: SymId) : Bool = sym_raw(s) < 0 - 1

#[doc("True when a local binder shadows `name`. A declaration bound in the outermost scope does not shadow itself.")]
pub fn ch_shadows(c: ScopeChain, name: String) : Bool = match ch_lookup(c, name) {
  Some(s) -> ch_is_local(s)
  None    -> false
}

#[doc("Every name the chain binds, innermost first. Only the did-you-mean suggestion reads this.")]
pub fn ch_names(c: ScopeChain) : [String] = ch_names_loop(c.scopes, [])

fn ch_names_loop(ss: [[ScopeBind]], acc: [String]) : [String] = match ss {
  [] -> acc
  [top, ...rest] -> ch_names_loop(rest, list_append(acc, ch_scope_names(top)))
}

fn ch_scope_names(bs: [ScopeBind]) : [String] = match bs {
  [] -> []
  [ScopeBind(n, _), ...rest] -> [n, ...ch_scope_names(rest)]
}
