#[doc("""
The bodies a declaration holds.

Every `Decl` variant is named here: a new one is a compile error in this
file, not a body each walk silently skips.
""")]

import compiler.ast

#[doc("Every body `d` holds: a function's, a runner block's, a constant's initialiser, and those of an impl's methods.")]
pub fn decl_bodies(d: Decl) : [Expr] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _)  -> [body]
  DTest(_, body, _, _, _)               -> [body]
  DBench(_, body, _, _, _)              -> [body]
  DCheck(_, _, body, _, _, _)           -> [body]
  DConst(_, _, _, body, _, _, _)        -> [body]
  DImpl(_, _, _, subs, _, _, _, _)      -> flat_map(subs, decl_bodies)
  DDerive(_, inner, _, _)               -> decl_bodies(inner)
  DUnstable(inner, _, _)                -> decl_bodies(inner)
  DConstructor(inner, _, _)             -> decl_bodies(inner)
  DProtoLaws(_, inner, _, _, _)         -> decl_bodies(inner)
  DImplAxiom(_, inner, _, _, _)         -> decl_bodies(inner)
  DDoc(_, _, inner, _, _)               -> decl_bodies(inner)
  DAttr(_, inner, _, _)                 -> decl_bodies(inner)
  DType(_, _, _, _, _, _, _, _)         -> []
  DImport(_, _, _)                      -> []
  DEffect(_, _, _, _, _, _, _, _)       -> []
  DProtocol(_, _, _, _, _, _, _)        -> []
  DModuleDoc(_, _, _, _)                -> []
  DUnit(_, _, _, _, _, _, _)            -> []
  DUse(_, _, _)                         -> []
  DUseKind(_, _, _, _)                  -> []
  DAxiom(_, _, _, _, _, _, _, _, _, _)  -> []
  DExternType(_, _, _, _, _)            -> []
  DTheory(_, _, _, _, _)                -> []
  DKind(_, _, _, _, _, _, _, _)         -> []
}
