#[doc("""
The one enumeration of the declarations that carry a body.

A per-declaration check that walks a body asks `decl_body_exprs` instead of
matching the declaration kinds itself, so a `test`, `bench`, `check` or
`const` initialiser is visited exactly like a `fn`. Lambdas inside a body
are reached through `expr_positions`.
""")]

import compiler.ast
import compiler.ast_decl

#[doc("The declaration under its annotation wrappers (`#[unstable]`, laws, axioms, constructors).")]
pub(pkg) fn decl_unwrap(d: Decl) : Decl = match d {
  DUnstable(inner, _, _) -> decl_unwrap(inner)
  DProtoLaws(_, inner, _, _, _) -> decl_unwrap(inner)
  DImplAxiom(_, inner, _, _, _) -> decl_unwrap(inner)
  DConstructor(inner, _, _) -> decl_unwrap(inner)
  _ -> d
}

#[doc("The bodies of a `fn`, `test`, `bench`, `check` or `const`, or the clause bodies of an effect's `default { }` block; empty for a declaration without one.")]
pub(pkg) fn decl_body_exprs(d: Decl) : [Expr] = match decl_unwrap(d) {
  DFn(_, _, _, _, _, _, body, _, _, _, _, _) -> [body]
  DTest(_, body, _, _, _) -> [body]
  DBench(_, body, _, _, _) -> [body]
  DCheck(_, _, body, _, _, _) -> [body]
  DConst(_, _, _, body, _, _, _, _, _) -> [body]
  DEffect(_, _, _, _, Some(DBlk(cs, ret, _, _)), _, _, _, _, _) -> list_append(
    map(
      cs,
      c => match c {
        HC(_, _, body, _, _) -> body
      }
    ),
    match ret {
      Some(HR(_, body, _, _)) -> [body]
      None -> []
    }
  )
  _ -> []
}
