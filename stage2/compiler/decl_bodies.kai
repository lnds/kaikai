#[doc("""
The one enumeration of the declarations that carry a body.

A per-declaration check that walks a body asks `decl_body` instead of
matching the declaration kinds itself, so a `test`, `bench`, `check` or
`const` initialiser is visited exactly like a `fn`. Lambdas inside a body
are reached through `expr_positions`.
""")]

import compiler.ast
import compiler.ast_decl

#[doc("The declaration under every annotation wrapper.")]
pub(pkg) fn decl_unwrap(d: Decl) : Decl = match decl_transparent_inner(d) {
  Some(inner) -> decl_unwrap(inner)
  None -> d
}

#[doc("The body of a `fn`, `test`, `bench`, `check` or `const`; `None` for a declaration without one.")]
pub(pkg) fn decl_body(d: Decl) : Option[Expr] = match decl_unwrap(d) {
  DFn(_, _, _, _, _, _, body, _, _, _, _, _) -> Some(body)
  DTest(_, body, _, _, _) -> Some(body)
  DBench(_, body, _, _, _) -> Some(body)
  DCheck(_, _, body, _, _, _) -> Some(body)
  DConst(_, _, _, body, _, _, _, _, _) -> Some(body)
  _ -> None
}
