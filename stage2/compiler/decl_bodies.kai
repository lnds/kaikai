#[doc("""
The expressions a declaration evaluates: its bodies, and the defaults
its record fields carry.

Every `Decl` variant is named here: a new one is a compile error in this
file, not a body each walk silently skips.
""")]

import compiler.ast
import compiler.decl_map

#[doc("Every body `d` holds: a function's, a runner block's, a constant's initialiser, and those of an impl's methods.")]
pub fn decl_bodies(d: Decl) : [Expr] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _)  -> [body]
  DTest(_, body, _, _, _)               -> [body]
  DBench(_, body, _, _, _)              -> [body]
  DCheck(_, _, body, _, _, _)           -> [body]
  DConst(_, _, _, body, _, _, _)        -> [body]
  DImpl(_, _, _, subs, _, _, _, _)      -> flat_map(subs, decl_bodies)
  DDerive(_, inner, _, _)               -> decl_bodies(inner)
  DUnstable(inner, _, _)                -> decl_bodies(inner)
  DConstructor(inner, _, _)             -> decl_bodies(inner)
  DProtoLaws(_, inner, _, _, _)         -> decl_bodies(inner)
  DImplAxiom(_, inner, _, _, _)         -> decl_bodies(inner)
  DDoc(_, _, inner, _, _)               -> decl_bodies(inner)
  DAttr(_, inner, _, _)                 -> decl_bodies(inner)
  DType(_, _, _, _, _, _, _, _)         -> []
  DImport(_, _, _)                      -> []
  DEffect(_, _, _, _, _, _, _, _)       -> []
  DProtocol(_, _, _, _, _, _, _)        -> []
  DModuleDoc(_, _, _, _)                -> []
  DUnit(_, _, _, _, _, _, _)            -> []
  DUse(_, _, _)                         -> []
  DUseKind(_, _, _, _)                  -> []
  DAxiom(_, _, _, _, _, _, _, _, _, _)  -> []
  DExternType(_, _, _, _, _)            -> []
  DTheory(_, _, _, _, _)                -> []
  DKind(_, _, _, _, _, _, _, _)         -> []
}

#[doc("Every expression `d` evaluates: its bodies and the `#[json(default = …)]` of the fields of a record it declares.")]
pub fn decl_exprs(d: Decl) : [Expr] = match decl_transparent_inner(d) {
  Some(inner) -> decl_exprs(inner)
  None        -> match d {
    DType(_, _, _, TBRecord(fs), _, _, _, _) -> field_defaults(fs)
    _                                        -> decl_bodies(d)
  }
}

#[doc("`d`, a declaration beneath its wrappers, with `f` applied to each expression `decl_exprs` lists.")]
pub fn decl_map_exprs[e](d: Decl, f: (Expr) -> Expr / e) : Decl / e = match d {
  DType(p, s, tps, TBRecord(fs), l, c, mo, xs) ->
    DType(p, s, tps, TBRecord(map(fs, (fd) => field_map_default(fd, f))), l, c, mo, xs)
  _ -> decl_map_bodies(d, f)
}

fn field_defaults(fs: [FieldDecl]) : [Expr] = match fs {
  [] -> []
  [FD(_, _, _, attrs), ...rest] -> match field_attr_json_default(attrs) {
    Some(e) -> [e, ...field_defaults(rest)]
    None    -> field_defaults(rest)
  }
}

fn field_map_default[e](fd: FieldDecl, f: (Expr) -> Expr / e) : FieldDecl / e = match fd {
  FD(p, n, te, attrs) -> FD(p, n, te, map(attrs, (a) => attr_map_default(a, f)))
}

fn attr_map_default[e](a: FieldAttr, f: (Expr) -> Expr / e) : FieldAttr / e = match a {
  FAJsonDefault(x) -> FAJsonDefault(f(x))
  FAJsonRename(_)  -> a
  FAJsonSkip       -> a
}
