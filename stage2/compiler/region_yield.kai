#[doc("The pinned-region gate: a `region { }` body may not reach a fiber suspension point. Errors when a region's body demands a suspending effect (Spawn/Actor/Cancel/Link/Monitor) directly or through a call, since an arena pointer that outlives a park would dangle after a migrating fiber resumes on another thread.")]

import compiler.ast
import compiler.diag
import compiler.expr_positions
import compiler.loop_lower
import compiler.region
import compiler.util
import compiler.core_effects

# The arena stack is a per-thread bump stack whose live pointer is the
# region's `KaiArena*`. A fiber that parks between a region push and its
# pop can resume on a different OS thread, where that pointer is stale —
# so the invariant is that a region never spans a suspension point. This
# gate proves it over the typed AST: reachability of a park inside a
# region body is exactly the region body's effect row intersecting the
# suspending set, and the typer already propagated that row through every
# call. A syntactic scan would miss a park hidden behind a helper; the
# row does not.

#[doc("Effects whose ops are fiber suspension points — the ones that let a fiber migrate across a park.")]
pub fn ry_suspending_effects() : [CoreEffect] =
  [CeSpawn, CeActor, CeCancel, CeLink, CeMonitor]

#[doc("Fail the compile for every `region { }` whose body can reach a fiber suspension point; returns the diagnostics, already printed.")]
pub fn region_yield_findings(decls: [Decl], regions: [RegionMark], file: String) : [Diagnostic] / Console =
  ry_decls(decls, regions, file, [])

fn ry_decls(decls: [Decl], regions: [RegionMark], file: String, acc: [Diagnostic]) : [Diagnostic] / Console {
  match decls {
    []           -> acc
    [d, ...rest] -> ry_decls(rest, regions, file, list_append(acc, ry_decl(d, regions, file)))
  }
}

fn ry_decl(d: Decl, regions: [RegionMark], file: String) : [Diagnostic] / Console {
  match d {
    DFn(_, _, _, _, _, _, body, _, _, _, _) -> ry_sites(body, regions, file)
    DTest(_, body, _, _, _)                  -> ry_sites(body, regions, file)
    DBench(_, body, _, _, _)                 -> ry_sites(body, regions, file)
    DCheck(_, _, body, _, _, _)              -> ry_sites(body, regions, file)
    DImpl(_, _, _, ms, _, _, _, _)              -> ry_decls(ms, regions, file, [])
    DDerive(_, inner, _, _)               -> ry_decl(inner, regions, file)
    DUnstable(inner, _, _)                -> ry_decl(inner, regions, file)
    DProtoLaws(_, inner, _, _, _)            -> ry_decl(inner, regions, file)
    DImplAxiom(_, inner, _, _, _)            -> ry_decl(inner, regions, file)
    DConstructor(inner, _, _)             -> ry_decl(inner, regions, file)
    _                                     -> []
  }
}

# Visit every region site in `e`, in every position: a region within a
# spawned closure or a loop body is still its own push/pop bracket and
# must hold the invariant on its own. Each region found is checked
# against its OWN body's suspending row.
fn ry_sites(e: Expr, regions: [RegionMark], file: String) : [Diagnostic] / Console {
  let here = match e.kind {
    EBlock(_, _) ->
      if ry_pos_is_region(regions, e.line, e.col) { ry_check_region(e, file) } else { [] }
    _ -> []
  }
  list_append(here, ry_sites_ps(xp_positions(e), regions, file))
}

fn ry_sites_ps(ps: [XPos], regions: [RegionMark], file: String) : [Diagnostic] / Console {
  match ps {
    []                  -> []
    [XP(_, x), ...rest] -> list_append(ry_sites(x, regions, file), ry_sites_ps(rest, regions, file))
  }
}

# A block at (line, col) is a region when the side table keys that
# position (same match `kir_lower_walk`'s `block_is_region` uses to route
# a block to the arena).
fn ry_pos_is_region(ms: [RegionMark], line: Int, col: Int) : Bool {
  match ms {
    []            -> false
    [m, ...rest]  ->
      if rmark_line(m) == line and rmark_col(m) == col { true }
      else { ry_pos_is_region(rest, line, col) }
  }
}

# A region body reaching a suspending op. The suspending effect is the
# first one demanded (deterministic diagnostic); the whole set is what
# the invariant forbids.
fn ry_check_region(e: Expr, file: String) : [Diagnostic] / Console {
  match ry_first_suspend(ry_effects_in_expr(e, [])) {
    Some(c) -> {
      let eff = core_effect_name(c)
      let msg = concat_all(["a `region { }` block may not reach a `", eff,
        "` suspension point — a region never spans a yield (the pinned-region invariant), so an arena pointer would dangle after a migrating fiber resumes on another thread"])
      eprint(concat_all([file, ":", int_to_string(e.line), ":", int_to_string(e.col), ": error: ", msg, "\n"]))
      [mk_diag(SevError, file, e.line, e.col, msg, [])]
    }
    None -> []
  }
}

fn ry_first_suspend(effs: [SymId]) : Option[CoreEffect] {
  match effs {
    []           -> None
    [s, ...rest] -> match ry_suspending_of(s, ry_suspending_effects()) {
      Some(c) -> Some(c)
      None    -> ry_first_suspend(rest)
    }
  }
}

fn ry_suspending_of(s: SymId, cs: [CoreEffect]) : Option[CoreEffect] = match cs {
  []           -> None
  [c, ...rest] -> if effect_is(s, c) { Some(c) } else { ry_suspending_of(s, rest) }
}

# ---- suspending effects demanded by a region body --------------------
#
# Same source as `lint_effects.effects_in_expr` — a direct op reference,
# or a call whose resolved callee row carries the effect — but NOT
# descending into lambda bodies: a closure's body runs when it is CALLED,
# not where it is written, so a `spawn(() -> Actor.receive())` does not
# make the enclosing region span a yield (the `Spawn` on the spawn call
# itself does). A loop intrinsic's lambdas are the exception: their
# bodies run in place. Nested regions and handler clauses ARE walked:
# they run inside this body, so an effect they reach is reachable here.

fn ry_effects_in_expr(e: Expr, acc: [SymId]) : [SymId] {
  let a1 = ry_effects_here(e, acc)
  match e.kind {
    EIntrinsic(nm, xs) ->
      if is_loop_intrinsic(nm) { ry_effects_in_exprs(map(xs, loop_arg_body), a1) }
      else { ry_effects_in_ps(xp_positions(e), a1) }
    _ -> ry_effects_in_ps(xp_positions(e), a1)
  }
}

fn ry_effects_in_ps(ps: [XPos], acc: [SymId]) : [SymId] {
  match ps {
    []                     -> acc
    [XP(XLam, _), ...rest] -> ry_effects_in_ps(rest, acc)
    [XP(_, x), ...rest]    -> ry_effects_in_ps(rest, ry_effects_in_expr(x, acc))
  }
}

# An effect-op callee reaches here untyped; the id it carries is its effect's.
fn ry_effects_here(e: Expr, acc: [SymId]) : [SymId] {
  match e.kind {
    ESym(s, _, _)    -> if sym_is_local(s) { acc } else { [s, ...acc] }
    ECall(callee, _) -> ry_add_callee_effects(callee, acc)
    EHandle(_, _, hsym, _, _, _, _, _) -> [hsym, ...acc]
    _                -> acc
  }
}

fn ry_add_callee_effects(callee: Expr, acc: [SymId]) : [SymId] {
  match callee.ty {
    Some(TyFnT(_, _, row)) -> ry_add_label_effects(row.labels, acc)
    _                      -> acc
  }
}

fn ry_add_label_effects(ls: [Label], acc: [SymId]) : [SymId] {
  match ls {
    []           -> acc
    [l, ...rest] -> ry_add_label_effects(rest, [l.sym, ...acc])
  }
}

fn ry_effects_in_exprs(xs: [Expr], acc: [SymId]) : [SymId] {
  match xs {
    []           -> acc
    [x, ...rest] -> ry_effects_in_exprs(rest, ry_effects_in_expr(x, acc))
  }
}

