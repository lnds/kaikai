#[doc("""
The read table: every read of every tracked binder in a body, collected once.

The table is keyed by binder identity. The rewriter's dup-or-move decision and
every payer answer "how often is this binder read" and "which read is its
last" from this one table; nothing else in the pass re-collects reads.

A read inside a lambda body is a capture: it is flagged, and it blocks the
last-use transfer. A raw read of a boxed binder copies the payload out and
leaves the box alone, so it is flagged too: as the last read it hands
nothing on. `compiler.perceus_read_walk` collects the table.

A binder is tracked as its `Binder`; its identity decides every question.
""")]

import compiler.ast
import compiler.expr_positions
import compiler.handler_alias
import compiler.core_builtins
import compiler.name_ix

#[doc("A function's reads, indexed by binder.")]
pub type UseIx = NameIx[Read]

#[doc("One read of a tracked binder: binder, line, column, inside a lambda, read raw.")]
pub type Read = Rd(LocalId, Int, Int, Bool, Bool)

#[doc("Where a binder is read last: at a position, behind a capture that blocks the last-use transfer, or nowhere.")]
pub type LastUse = LuAt(Int, Int) | LuBlocked | LuUnused

#[doc("True when `l` is one of the binders `bs`.")]
pub fn pcs_has(bs: [Binder], l: LocalId) : Bool = match bs {
  []           -> false
  [b, ...rest] -> local_eq(b.id, l) or pcs_has(rest, l)
}

#[doc("""
A clause's op-argument binders, without the continuation.

A call of the continuation is emitted by a special case and has no runtime
value, so wrapping a read of it in `__perceus_dup` would reach an undeclared
symbol.
""")]
pub fn pcs_filter_non_resume(params: [Param]) : [Binder] = map(clause_op_args(params), (p) => p.binder)

#[doc("""
The state aliases a handle binds in its clauses; a handle carries state
exactly when it has an initial value.

A clause reads each alias through the binder minted under its name. A scope
lists them after every other binder.
""")]
pub fn pcs_handle_aliases(init_opt: Option[Expr]) : [Binder] = match init_opt {
  Some(_) -> map(list_append(user_state_aliases(), [var_cell_alias()]), binder_minted)
  None    -> []
}

# ---- the tracked binders of a pattern ----

#[doc("The binders a pattern declares that perceus tracks.")]
pub fn prc_pat_bindings(pat: Pattern, acc: [Binder]) : [Binder] = match pat.pkind {
  PBind(b)                  -> [b, ...acc]
  PList(pats, opt_rest)     -> {
    let acc1 = prc_pats_bindings(pats, acc)
    match opt_rest {
      Some(r) -> [r, ...acc1]
      None    -> acc1
    }
  }
  PVariant(_, subs)         -> prc_pats_bindings(subs, acc)
  PVariantRecord(_, fields) -> prc_pats_bindings(map(fields, prc_pfield_pat), acc)
  PRecord(fields)           -> prc_pats_bindings(map(fields, prc_pfield_pat), acc)
  PAs(b, sub)               -> prc_pat_bindings(sub, [b, ...acc])
  PNarrow(b, _)             -> [b, ...acc]
  PSurface(sp)              -> prc_pats_bindings(patsurface_children(sp), acc)
  _                         -> acc
}

#[doc("`prc_pat_bindings` of a `let`, except that a single `PBind` over an `MUnboxed` rhs is a raw C scalar with no refcount and stays out.")]
pub fn prc_pat_bindings_skip_raw(pat: Pattern, rhs: Expr, acc: [Binder]) : [Binder] = match pat.pkind {
  PBind(b) -> match rhs.mode {
    MUnboxed -> acc
    _        -> [b, ...acc]
  }
  _ -> prc_pat_bindings(pat, acc)
}

fn prc_pats_bindings(ps: [Pattern], acc: [Binder]) : [Binder] = match ps {
  []           -> acc
  [p, ...rest] -> prc_pats_bindings(rest, prc_pat_bindings(p, acc))
}

fn prc_pfield_pat(f: PField) : Pattern = match f { PField(_, p, _) -> p }

# ---- queries ----

#[doc("Last-use class of a binder over a read table: never read, read inside a lambda (a capture blocks the last-use transfer), or last read at a position.")]
pub fn last_use_for(b: LocalId, uses: UseIx) : LastUse = {
  let reads = ni_bucket_id(uses, local_raw(b))
  if prt_any_in_lam(reads, b) { LuBlocked }
  else {
    match prt_latest(b, reads, None) {
      None         -> LuUnused
      Some((l, c)) -> LuAt(l, c)
    }
  }
}

fn prt_latest(b: LocalId, uses: [Read], best: Option[(Int, Int)]) : Option[(Int, Int)] = match uses {
  [] -> best
  [Rd(u, ln, cl, _, _), ...rest] ->
    prt_latest(b, rest, if local_eq(u, b) and prt_after(ln, cl, best) { Some((ln, cl)) } else { best })
}

fn prt_after(ln: Int, cl: Int, best: Option[(Int, Int)]) : Bool = match best {
  None         -> true
  Some((l, c)) -> ln > l or (ln == l and cl > c)
}

#[doc("The reads of a binder outside lambdas; a lambda read is a capture, paid by the closure's own incref.")]
pub fn pcs_read_count(b: LocalId, uses: UseIx) : Int = prt_count(b, ni_bucket_id(uses, local_raw(b)), 0)

fn prt_count(b: LocalId, uses: [Read], n: Int) : Int = match uses {
  [] -> n
  [Rd(u, _, _, in_lam, _), ...rest] -> prt_count(b, rest, if local_eq(u, b) and not in_lam { n + 1 } else { n })
}

#[doc("True when some read of `b` sits inside a lambda.")]
pub fn pcs_uses_have_in_lam(uses: UseIx, b: LocalId) : Bool = prt_any_in_lam(ni_bucket_id(uses, local_raw(b)), b)

fn prt_any_in_lam(uses: [Read], b: LocalId) : Bool = match uses {
  []                                -> false
  [Rd(u, _, _, in_lam, _), ...rest] -> (in_lam and local_eq(u, b)) or prt_any_in_lam(rest, b)
}

#[doc("True when the read of `b` at `(l, c)` is raw, which leaves its box alone.")]
pub fn pcs_read_raw_at(b: LocalId, uses: UseIx, l: Int, c: Int) : Bool = prt_raw_at(ni_bucket_id(uses, local_raw(b)), b, l, c)

fn prt_raw_at(uses: [Read], b: LocalId, l: Int, c: Int) : Bool = match uses {
  []                               -> false
  [Rd(u, ln, cl, _, raw), ...rest] -> (raw and local_eq(u, b) and ln == l and cl == c) or prt_raw_at(rest, b, l, c)
}

#[doc("True when `b` is read exactly once, outside any lambda.")]
pub fn pcs_read_once(b: LocalId, uses: UseIx) : Bool =
  pcs_read_count(b, uses) == 1 and not pcs_uses_have_in_lam(uses, b)

#[doc("True when `b` is read anywhere in `e`: lambda bodies and handler clauses included.")]
pub fn pcs_mentions(b: Binder, e: Expr) : Bool = match e.kind {
  ELocal(u) -> local_eq(u, b.id)
  _         -> prt_mentions_ps(b, xp_positions(e))
}

fn prt_mentions_ps(b: Binder, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> pcs_mentions(b, c) or prt_mentions_ps(b, rest)
}

#[doc("The expression a unit coercion wraps, peeled to the value Perceus reads; any other expression is itself.")]
pub fn prc_peel_unit(e: Expr) : Expr = match e.kind {
  ECall(f, xs) -> if prc_is_unit_coercion(f) { match xs { [x] -> prc_peel_unit(x)  _ -> e } } else { e }
  _ -> e
}

fn prc_is_unit_coercion(f: Expr) : Bool = match builtin_ref(f) {
  Some(b) -> builtin_is_unit_coercion(b)
  None    -> false
}
