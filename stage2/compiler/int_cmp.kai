#[doc("""
Comparisons the C backend evaluates on raw Int payloads.

An order or equality comparison whose operands are both statically Int
reads each payload out of its box and leaves the box alone, whatever mode
the operands carry.
""")]

import compiler.ast

#[doc("True when `op` compares two statically-Int operands.")]
pub fn int_cmp_raw(op: String, a: Expr, b: Expr) : Bool =
  ic_is_cmp(op) and ic_is_int(a.ty) and ic_is_int(b.ty)

fn ic_is_cmp(op: String) : Bool =
  op == "<" or op == ">" or op == "<=" or op == ">=" or op == "==" or op == "!="

fn ic_is_int(opt_ty: Option[Ty]) : Bool = match opt_ty {
  Some(t) -> match t {
    TyInt               -> true
    TyDimT(inner, _)    -> match inner { TyInt -> true  _ -> false }
    TyRefineT(inner, _) -> match inner { TyInt -> true  _ -> false }
    _                   -> false
  }
  None -> false
}
