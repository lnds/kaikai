#[doc("Rewrite of the handles that omit an operation or the `return` of an effect whose default carries kaikai clauses, so the handle inherits them from the wrapper functions synthesised for that effect.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.decl_bodies
import compiler.default_wrappers
import compiler.emit_shared_alias
import compiler.expr_positions
import compiler.handler_alias
import compiler.symtab
import compiler.unique_binders
import compiler.util
import compiler.resume_segment
import compiler.written

type DOp = { name: String, arity: Int }

type DInfo = {
  eff: SymId,
  ops: [DOp],
  has_ret: Bool,
  handler: SymId,
  retf: SymId,
  home: String,
  name: String
}

type SiteCx = { all: [Decl], infos: [DInfo] }

fn op_arity_of(ops: [EffectOp], name: String) : Int = match ops {
  [] -> 0
  [EffOp(n, _, ps, _, _, _), ...rest] ->
    if n == name { list_length(ps) } else { op_arity_of(rest, name) }
}

fn lookup_in(tab: SymTab, cls: NCls, name: String, owner: SymId) : SymId =
  unwrap_or(st_lookup(tab, cls, name, owner), sym_none())

fn info_of(tab: SymTab, d: Decl) : Option[DInfo] = match decl_unwrap(d) {
  DEffect(_, s, _, ops, Some(DBlk(cs, ret, _, _)), _, _, _, _, _) -> {
    let kcs = filter(cs, is_kaikai_clause)
    let has_ret = is_some(ret)
    if list_is_empty(kcs) and (not has_ret) {
      None
    } else {
      let name = written_text(decl_name(tab, s))
      let owner = sym_owner(tab, s)
      Some(DInfo {
        eff: s,
        ops: map(
          kcs,
          c => DOp {
            name: clause_head_word(clause_head(c)),
            arity: op_arity_of(ops, clause_head_word(clause_head(c)))
          }
        ),
        has_ret: has_ret,
        handler: lookup_in(tab, NCFn, dflt_handler_name(name), owner),
        retf: lookup_in(tab, NCFn, dflt_return_name(name), owner),
        home: written_text(sym_home(tab, s)),
        name: name
      })
    }
  }
  _ -> None
}

fn clause_head(c: HClause) : ClauseHead = match c {
  HC(h, _, _, _, _) -> h
}

fn find_info(infos: [DInfo], s: SymId) : Option[DInfo] =
  find(infos, i => sym_raw(i.eff) == sym_raw(s))

fn omits(cs: [HClause], o: DOp) : Bool =
  not any(cs, c => clause_head_word(clause_head(c)) == o.name)

fn default_clause(all: [Decl], i: DInfo, o: DOp) : Option[HClause] =
  fn_body_of(all, i.handler)
    || (b => match b.kind {
      EHandle(_, _, _, _, _, cs, _) ->
        find(cs, c => clause_head_word(clause_head(c)) == dflt_op_name(o.name))
      _ -> None
    })

fn default_return(all: [Decl], i: DInfo) : Option[HReturn] =
  find_map(
    all,
    d => match decl_unwrap(d) {
      DFn(_, id, _, [p], _, _, body, _, _, _, _, _) ->
        if sym_raw(fnid_sym(id)) == sym_raw(i.retf) {
          Some(HR(p.binder, body, p.pline, p.pcol))
        } else {
          None
        }
      _ -> None
    }
  )

fn salt_of(i: DInfo, what: String, e: Expr) : String =
  concat_all([
    int_to_string(sym_raw(i.eff)),
    ":",
    what,
    ":",
    int_to_string(e.line),
    ":",
    int_to_string(e.col),
    ":"
  ])

fn inherited_note(i: DInfo, what: String, line: Int) : String =
  concat_all([
    "this ",
    what,
    " is inherited from the `default { }` of `",
    i.name,
    "` (module `",
    i.home,
    "`, line ",
    int_to_string(line),
    ")"
  ])

fn cloned_clause(cx: SiteCx, i: DInfo, o: DOp, e: Expr, c: HClause) : HClause =
  match refresh_clause(c, salt_of(i, o.name, e)) {
    HC(_, ps, body, _, _) -> HC(
      ChOp(o.name),
      ps,
      home_marked(
        i.home,
        inherited_note(i, "clause", clause_line(c)),
        site_expr(inside(cx, i), body)
      ),
      e.line,
      e.col
    )
  }

fn clause_line(c: HClause) : Int = match c {
  HC(_, _, _, l, _) -> l
}

fn inherited_clauses(cx: SiteCx, i: DInfo, missing: [DOp], e: Expr) : [HClause] =
  flat_map(
    missing,
    o => match default_clause(cx.all, i, o) {
      Some(c) -> [cloned_clause(cx, i, o, e, c)]
      None -> []
    }
  )

fn inherited_return(cx: SiteCx, i: DInfo, e: Expr) : Option[HReturn] =
  default_return(cx.all, i)
    | (r => match refresh_return(r, salt_of(i, "return", e)) {
      HR(b, body, l, _) -> HR(
        b,
        home_marked(
          i.home,
          inherited_note(i, "`return` clause", l),
          site_expr(inside(cx, i), body)
        ),
        e.line,
        e.col
      )
    })

fn rewrite_handle(cx: SiteCx, i: DInfo, e: Expr, h: HandleParts) : ExprKind {
  let missing = filter(i.ops, o => omits(h.clauses, o))
  let ret = if i.has_ret and (not is_some(h.ret)) { inherited_return(cx, i, e) } else { h.ret }
  EHandle(
    h.body,
    h.eff,
    h.tys,
    h.init,
    h.alias,
    list_append(h.clauses, inherited_clauses(cx, i, missing, e)),
    ret
  )
}

fn site_expr(cx: SiteCx, e: Expr) : Expr = Expr { ...e, kind: site_kind(cx, e) }

fn site_kind(cx: SiteCx, e: Expr) : ExprKind = match e.kind {
  EHandle(body, eff, tys, init, alias, cs, ret) -> {
    let h = HandleParts {
      body: site_expr(cx, body),
      eff: eff,
      tys: tys,
      init: map_opt_expr(init, x => site_expr(cx, x)),
      alias: alias,
      clauses: map(cs, c => site_clause(cx, c)),
      ret: map_opt_return_exprs(ret, x => site_expr(cx, x))
    }
    match find_info(cx.infos, ref_sym(eff)) {
      Some(i) -> rewrite_handle(cx, i, e, h)
      None -> EHandle(h.body, h.eff, h.tys, h.init, h.alias, h.clauses, h.ret)
    }
  }
  k -> map_expr_kind(k, x => site_expr(cx, x))
}

fn site_clause(cx: SiteCx, c: HClause) : HClause = match c {
  HC(n, ps, body, l, col) -> HC(n, ps, site_expr(cx, body), l, col)
}

fn inheriting_handles(infos: [DInfo], e: Expr, acc: [SymId]) : [SymId] {
  let here = match e.kind {
    EHandle(_, eff, _, _, _, cs, ret) -> match find_info(infos, ref_sym(eff)) {
      Some(i) ->
        if (not list_is_empty(filter(i.ops, o => omits(cs, o))))
          or (i.has_ret and (not is_some(ret))) {
          [ref_sym(eff), ...acc]
        } else {
          acc
        }
      None -> acc
    }
    _ -> acc
  }
  foldl(
    xp_positions(e),
    here,
    (a, p) => match p {
      XP(_, x) -> inheriting_handles(infos, x, a)
    }
  )
}

fn fn_body_of(all: [Decl], s: SymId) : Option[Expr] =
  find_map(
    all,
    d => match decl_unwrap(d) {
      DFn(_, id, _, _, _, _, body, _, _, _, _, _) ->
        if sym_raw(fnid_sym(id)) == sym_raw(s) { Some(body) } else { None }
      _ -> None
    }
  )

# The effects whose defaults a handle written in the default body of `i` inherits.
fn written_in_default(all: [Decl], infos: [DInfo], i: DInfo) : [SymId] =
  flat_map(
    [i.handler, i.retf],
    f => match fn_body_of(all, f) {
      Some(b) -> inheriting_handles(infos, b, [])
      None -> []
    }
  )

fn reaches(all: [Decl], infos: [DInfo], from: SymId, target: SymId, fuel: Int) : Bool =
  sym_raw(from) == sym_raw(target)
    or (fuel > 0
      and any(
        infos,
        i => sym_raw(i.eff) == sym_raw(from)
          and any(
            written_in_default(all, infos, i),
            n => reaches(all, infos, n, target, fuel - 1)
          )
      ))

fn self_cyclic(all: [Decl], infos: [DInfo], i: DInfo) : Bool =
  any(written_in_default(all, infos, i), n => reaches(all, infos, n, i.eff, list_length(infos)))

# The defaults a clone of the default of `i` inherits: the ones that do not lead back to `i`.
fn inside(cx: SiteCx, i: DInfo) : SiteCx =
  SiteCx {
    all: cx.all,
    infos: filter(cx.infos, j => not reaches(cx.all, cx.infos, j.eff, i.eff, list_length(cx.infos)))
  }

fn owned(cx: SiteCx, owner: FnId) : SiteCx {
  let own = fnid_sym(owner)
  match find(cx.infos, i => sym_raw(i.handler) == sym_raw(own) or sym_raw(i.retf) == sym_raw(own)) {
    Some(h) -> inside(cx, h)
    None -> cx
  }
}

fn site_body(cx: SiteCx, tab: SymTab, owner: FnId, body: Expr) : Expr =
  if holds_handle(body) and (not is_default_root(tab, fnid_sym(owner))) {
    site_expr(owned(cx, owner), body)
  } else {
    body
  }

#[doc("`ds` with every handle that omits an operation or the `return` of an effect with kaikai default clauses made to inherit them, by cloning the default's clauses into the handle; unchanged when no effect has any. An effect whose default writes a handle that leads back to it is not inherited: the clones would never end.")]
pub(pkg) fn inherit_default_sites(ds: [Decl], all: [Decl], tab: SymTab) : [Decl] =
  if declares_kaikai_default(all) {
    let infos0 = flat_map(
      all,
      d => match info_of(tab, d) {
        Some(i) -> [i]
        None -> []
      }
    )
    let infos = filter(infos0, i => not self_cyclic(all, infos0, i))
    let cx = SiteCx { all: all, infos: infos }
    map(ds, d => decl_map_named_bodies(d, (owner, body) => site_body(cx, tab, owner, body)))
  } else {
    ds
  }
