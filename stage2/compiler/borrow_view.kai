#[doc("""
Perceus' interprocedural borrow map: each function's borrowed positions,
keyed by the identity of the declaration or specialisation, over the
core prims, which have no identity and are keyed by name.
""")]

import compiler.ast
import compiler.borrow_map

#[doc("One function's borrow verdict: its identity and borrowed positions.")]
pub type BorrowDecl = BD(FnId, [Int])

#[doc("The map of every verdict with a borrowed position, over the `seed` rows.")]
pub fn bv_build(bds: [BorrowDecl], seed: [BorrowEntry]) : BorrowMap = bm_of(bv_rows(bds, seed))

fn bv_rows(bds: [BorrowDecl], acc: [BorrowEntry]) : [BorrowEntry] = match bds {
  []                 -> acc
  [BD(fid, ps), ...rest] -> match ps {
    [] -> bv_rows(rest, acc)
    _  -> bv_rows(rest, if sym_raw(fnid_sym(fid)) < 0 { acc } else { [BwE(bv_fid_key(fid), ps), ...acc] })
  }
}

#[doc("The map key of the function instance `fid`; no spelling can collide with it.")]
pub fn bv_fid_key(fid: FnId) : String = {
  let k = string_concat("#", int_to_string(sym_raw(fnid_sym(fid))))
  if fnid_inst(fid) == spec_none() { k } else { concat_all([k, "/", int_to_string(fnid_inst(fid))]) }
}
