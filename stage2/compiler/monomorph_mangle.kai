fn mono_join_with(xs: [String], sep: String) : String = string_join(xs, sep)

#[doc("The name of the specialisation of `name` at `tys` and `units`.")]
pub(pkg) fn mono_mangle_name(tab: SymTab, name: String, tys: [Ty], units: [UnitExprT]) : String {
  let ty_part = match tys {
    [] -> ""
    [_h, ..._rest] -> concat_all(["__mono__", mono_join_with(map(tys, (t) => mono_mangle_ty(tab, t)), "__")])
  }
  # m4c Phase 3: encode the unit-tparam tuple after the type-tparam
  # tuple. Empty units means no per-unit specialisation (the common
  # case). For `impl[u: Measure] Show for Real<u>` and friends, two
  # specs binding `u` to USD and EUR mangle distinctly via
  # `__umono__USD` / `__umono__EUR`. The rendering uses the same
  # canonical-unit display as `unit_name(x)` so emit and rewrite
  # agree on the suffix string.
  let u_part = match units {
    [] -> ""
    [_h, ..._rest] -> concat_all(["__umono__", mono_join_with(map(units, mono_mangle_unit), "__")])
  }
  if string_length(ty_part) == 0 and string_length(u_part) == 0 {
    name
  } else {
    concat_all([name, ty_part, u_part])
  }
}

fn mono_mangle_ty(tab: SymTab, t: Ty) : String {
  match t {
    TyInt    -> "Int"
    TyReal   -> "Real"
    TyBool   -> "Bool"
    TyString -> "String"
    TyChar   -> "Char"
    TyUnit   -> "Unit"
    TyByte     -> "Byte"
    TyInt32    -> "Int32"
    TyUInt32   -> "UInt32"
    TyUInt64   -> "UInt64"
    TyInt128   -> "Int128"
    TyHandle   -> "Handle"
    TyListT(inner) -> concat_all(["L_", mono_mangle_ty(tab, inner), "_E"])
    TyFnT(ps, ret, _) -> concat_all([
      "F_", mono_join_with(map(ps, (p) => mono_mangle_ty(tab, p)), "_"),
      "_R_", mono_mangle_ty(tab, ret), "_E"
    ])
    TyCon(s, tas) -> {
      match tas {
        [] -> rt_name(tab, s)
        [_h, ..._rest] -> concat_all([rt_name(tab, s), "_O_",
                                    mono_join_with(map(tas, (a) => mono_mangle_ty(tab, a)), "_"),
                                    "_C"])
      }
    }
    TyVarT(_) -> "TVAR"
    # a resolved shape app never reaches the mangler (apply/subst erase
    # it to the concrete constructor); an unresolved one in a key is a
    # bug, flagged like `TVAR`.
    TyShapeApp(_, arg) -> concat_all(["SVAR_", mono_mangle_ty(tab, arg)])
    TyAny     -> "Any"
    # m12.5: units are erased at codegen time. The mangled name for a
    # dimensioned type is the same as its base type's mangle — so a
    # call like `f(1.0<USD>)` and a call `f(1.0)` mangle into the same
    # specialisation. This is the codegen-erasure invariant manifest
    # at the mangler level. A fixed-width `Vec[e]<n>` is the exception:
    # its inline layout differs per `n`, so it keeps a `_D<n>` suffix
    # (lockstep with `mangle_ty` in emit_c) that splits its spec from
    # the dynamic `Vec` and from every other length.
    TyDimT(base, u) -> if ty_is_fixed_vec(t) {
      concat_all([mono_mangle_ty(tab, base), "_D", int_to_string(fixed_vec_n(t))])
    } else { mono_mangle_ty(tab, base) }
    # m12.6.x #1: refinements erase like units. `Int where >= 0` and
    # `Int` mangle the same — they share monomorphisations and
    # protocol-impl dispatch entries.
    TyRefineT(base, _) -> mono_mangle_ty(tab, base)
    # issue #187 phase 1: mangle a union as `U_<part1>_<part2>_..._E`
    # using the canonical component order. The leading `U_` and
    # trailing `_E` bracket the spec the same way `L_..._E` brackets
    # a list, so distinct unions never collide with each other or
    # with primitive mangles even when their component manglings
    # rearrange. Phase 1 never invokes the mangler on a `TyUnion` in
    # selfhost (no resolver path constructs one) so this arm is dead
    # until Phase 2 wires it up; the implementation is provided now
    # to keep the walker exhaustive without `_` fallbacks that would
    # mask future bugs.
    TyUnion(parts) -> concat_all(["U_",
                                  mono_join_with(map(parts, (p) => mono_mangle_ty(tab, p)), "_"),
                                  "_E"])
  }
}

fn mono_mangle_unit(u: UnitExprT) : String {
  let cu = unit_canon(u)
  match cu {
    UVar(_) -> "TUVAR"
    UOne    -> "1"
    _       -> mono_mangle_unit_ident(unit_key(cu))
  }
}

fn mono_mangle_unit_ident(s: String) : String =
  mono_mangle_unit_ident_loop(s, 0, string_length(s), [])

fn mono_mangle_unit_ident_loop(s: String, i: Int, n: Int, acc: [String]) : String {
  if i >= n { concat_all(list_reverse(acc)) }
  else {
    let c = match char_at(s, i) {
      Some(ch) -> ch
      None     -> ' '
    }
    let piece = match c {
      '*' -> "_x_"
      '/' -> "_d_"
      '^' -> "_p_"
      '(' -> "_l_"
      ')' -> "_r_"
      ' ' -> "_s_"
      _   -> string_slice(s, i, 1)
    }
    mono_mangle_unit_ident_loop(s, i + 1, n, [piece, ...acc])
  }
}

fn mono_ty_string_list(tab: SymTab, ts: [Ty]) : [String] = map(ts, (t) => mono_ty_to_string(tab, t))

#[doc("A type as a diagnostic shows it.")]
pub(pkg) fn mono_ty_to_string(tab: SymTab, t: Ty) : String {
  match t {
    TyInt    -> "Int"
    TyReal   -> "Real"
    TyBool   -> "Bool"
    TyString -> "String"
    TyChar   -> "Char"
    TyUnit   -> "Unit"
    TyByte     -> "Byte"
    TyInt32    -> "Int32"
    TyUInt32   -> "UInt32"
    TyUInt64   -> "UInt64"
    TyInt128   -> "Int128"
    TyHandle   -> "Handle"
    TyListT(inner) -> cat3("[", mono_ty_to_string(tab, inner), "]")
    # m7b #11k: render the function type's effect row alongside the
    # arrow when non-empty, with each label printed as `Eff` or
    # `Eff[T1, T2]` so parametric-effect mismatches (Reader[Int] vs
    # Reader[String]) are visible in `expected/found` notes.
    TyFnT(ps, ret, row) -> concat_all([
      "(", mono_join_with(mono_ty_string_list(tab, ps), ", "), ") -> ",
      mono_ty_to_string(tab, ret),
      mono_row_to_string_suffix(tab, row)
    ])
    TyCon(s, tas) -> {
      let cname = written_text(decl_name(tab, s))
      match tas {
        [] -> cname
        _ -> concat_all([cname, "[", mono_join_with(mono_ty_string_list(tab, tas), ", "), "]"])
      }
    }
    TyVarT(n) -> cat2("?t", int_to_string(n))
    TyAny -> "?"
    # m12.5: render dimensioned base types as `Real<u>` / `Int<u>`.
    # The unit goes through unit_canon so the printed form matches
    # what the unifier compares against — same shape on every side.
    TyDimT(base, u) -> concat_all([mono_ty_to_string(tab, base), "<", mono_unit_canon_display(u), ">"])
    # m12.6.x #1: render `T where ...` for diagnostics. The predicate
    # is left as `<pred>` to keep the line short; full predicate text
    # lands with the diagnostics-quality pass (m12.6.x #8).
    TyRefineT(base, _) -> concat_all([mono_ty_to_string(tab, base), " where <pred>"])
    TyShapeApp(sv, arg) -> concat_all(["?s", int_to_string(sv), "[", mono_ty_to_string(tab, arg), "]"])
    # issue #187 phase 1: render unions inline as `A | B | C` to match
    # surface syntax. Components are already in canonical order when
    # the walker receives them via `normalize_union`.
    TyUnion(parts) -> mono_join_with(mono_ty_string_list(tab, parts), " | ")
  }
}

fn mono_unit_canon_display(u: UnitExprT) : String = unit_key(unit_canon(u))

fn mono_row_to_string_suffix(tab: SymTab, r: Row) : String {
  # Issue #645: a row with no labels is treated as "pure" in display
  # form, whether its tail is None (truly closed empty) or Some(_)
  # (a free row var with no demand on it — the phantom that
  # `fn_scheme_of_decl` inserts for REmpty signatures, or any fresh
  # row var introduced by instantiation and never constrained). The
  # tail variable is internal bookkeeping; showing `?eN` to users
  # mis-suggests they need to annotate the function. Diagnostics for
  # actual row mismatches still print the `expected` and `found`
  # rows in full (those rows carry labels by the time the mismatch
  # is reported).
  let body =
    if labels_empty(r.labels) {
      ""
    } else {
      let lbs = mono_join_with(map(r.labels, (l) => label_to_string(tab, l)), " + ")
      let tail_s = match r.tail {
        None -> ""
        Some(v) -> {
          let pre = if string_length(lbs) > 0 { " + " } else { "" }
          concat_all([pre, "?e", int_to_string(v)])
        }
      }
      concat_all([" / ", lbs, tail_s])
    }
  body
}

#[doc("One free-fn protocol-bound violation caught at a concrete instantiation: the message plus the call-site (or callee) location.")]
pub(pkg) type BoundViolation = BV(String, Int, Int)

#[doc("A source position.")]
pub(pkg) type LineCol = MoLC(Int, Int)

#[doc("The violations of the bounds `ftbs` by the types `tys` of one instantiation of `callee`.")]
pub(pkg) fn check_tuple_bounds(ftbs: [FnTPBound], tys: [Ty], callee: SymId,
                      fmo: Option[String],
                      reg: ProtocolReg, env: EqEnv, loc: LineCol,
                      acc: [BoundViolation]) : [BoundViolation] {
  match ftbs {
    [] -> acc
    [ftb, ...rest] -> match ftb {
      FTB(idx, protos) -> {
        let acc1 = match ty_at(tys, idx) {
          None     -> acc
          Some(ty) -> check_protos_for_head(protos, ty_disp_head(ty), callee, fmo, ty, reg, env, loc, acc)
        }
        check_tuple_bounds(rest, tys, callee, fmo, reg, env, loc, acc1)
      }
    }
  }
}

fn check_protos_for_head(protos: [DeclRef], head: Option[DispHead], callee: SymId,
                         fmo: Option[String],
                         ty: Ty, reg: ProtocolReg, env: EqEnv, loc: LineCol,
                         acc: [BoundViolation]) : [BoundViolation] {
  match protos {
    [] -> acc
    [p, ...rest] -> {
      let acc1 = if bound_satisfied(reg, env, p, fmo, head, ty) { acc }
                 else {
                   let msg = concat_all(["type `", mono_ty_to_string(ps_tab(env.ps), ty),
                     "` does not satisfy the bound `", ref_display(ps_tab(env.ps), p),
                     "` on a type parameter of `", written_text(decl_name(ps_tab(env.ps), callee)), "`"])
                   match loc { MoLC(l, c) -> [BV(msg, l, c), ...acc] }
                 }
      check_protos_for_head(rest, head, callee, fmo, ty, reg, env, loc, acc1)
    }
  }
}

# `Eq` is decided on the whole type: an impl, else structurally.
fn bound_satisfied(reg: ProtocolReg, env: EqEnv, p: DeclRef, fmo: Option[String], head: Option[DispHead], ty: Ty) : Bool =
  if proto_is_eq(env.ps, p, fmo) { ty_is_eq(env, ty) }
  else { match head {
    Some(h) -> head_satisfies_proto(reg, p, fmo, h, env.ps)
    None    -> true
  } }

fn proto_is_eq(ps: PScope, p: DeclRef, fmo: Option[String]) : Bool =
  sym_raw(proto_ref_sym(ps, p, fmo)) == sym_raw(core_proto_id(CpEq))

# Canonical "head satisfies protocol": a user impl or a derive-
# synthesised impl (both land in `reg.impls` via `expand_derives`
# + `lower_impls`), or a structural builtin (Int/Real/... for
# Eq/Show/Ord/Hash).
# The bound's name resolves from the declaring fn's module, so a
# contested protocol name checks against its own impl table.
fn head_satisfies_proto(reg: ProtocolReg, proto: DeclRef,
                        fmo: Option[String], head: DispHead,
                        ps: PScope) : Bool {
  let psym = proto_ref_sym(ps, proto, fmo)
  prc_reg_has_impl(reg, psym, head) or match core_proto_of(psym) {
    Some(cp) -> head_has_builtin_impl(cp, head)
    None     -> false
  }
}

# Only a scalar has a structural builtin impl.
fn head_has_builtin_impl(cp: CoreProto, head: DispHead) : Bool = match head {
  DhScalar(t) -> match scalar_ty_name(t) {
    Some(n) -> derive_builtin_impl(cp, n)
    None    -> false
  }
  DhSym(_) -> false
}

fn ty_at(tys: [Ty], idx: Int) : Option[Ty] {
  match tys {
    [] -> None
    [t, ...rest] -> if idx == 0 { Some(t) } else { ty_at(rest, idx - 1) }
  }
}

#[doc("The violations of the operators in the specialised body `body` of `callee`, each located at `loc`, the call that instantiated it.")]
pub(pkg) fn spec_op_violations(tab: SymTab, callee: SymId, body: Expr, loc: LineCol) : [BoundViolation] =
  op_scan(tab, callee, body, loc, [])

fn op_scan(tab: SymTab, callee: SymId, e: Expr, loc: LineCol, acc: [BoundViolation]) : [BoundViolation] = {
  let here = match e.kind {
    EBinop(op, l, _) -> if bp_is_arith(binop_proto(op)) and operand_unsupported(l.ty) { [op_violation(tab, callee, op, l.ty, loc), ...acc] } else { acc }
    _ -> acc
  }
  op_scan_children(tab, callee, xp_positions(e), loc, here)
}

fn op_scan_children(tab: SymTab, callee: SymId, ps: [XPos], loc: LineCol, acc: [BoundViolation]) : [BoundViolation] = match ps {
  [] -> acc
  [XP(_, c), ...rest] -> op_scan_children(tab, callee, rest, loc, op_scan(tab, callee, c, loc, acc))
}

fn operand_unsupported(t: Option[Ty]) : Bool = match t {
  Some(TyDimT(inner, _))    -> operand_unsupported(Some(inner))
  Some(TyRefineT(inner, _)) -> operand_unsupported(Some(inner))
  Some(TyCon(_, _))         -> true
  Some(TyString)            -> true
  Some(TyBool)              -> true
  Some(TyChar)              -> true
  Some(TyUnit)              -> true
  Some(TyListT(_))          -> true
  _                         -> false
}

fn op_violation(tab: SymTab, callee: SymId, op: BinOp, t: Option[Ty], loc: LineCol) : BoundViolation = {
  let shown = match t { Some(ty) -> mono_ty_to_string(tab, ty)  None -> "?" }
  let msg = concat_all(["type `", shown, "` has no impl for operator `", binop_text(op),
                        "` used in `", ref_display(tab, DrSym(callee)),
                        "`; declare the matching protocol bound on its type parameter"])
  match loc { MoLC(l, c) -> BV(msg, l, c) }
}

#[doc("A located warning.")]
pub(pkg) type OpWarning = OpWarn(String, Int, Int)

#[doc("The operators of the generic `d` applied to a type parameter while none of its type parameters declares a bound, each with the bound it needs. Nothing for a fn the target module does not own.")]
pub(pkg) fn unbounded_op_warnings(d: Decl, fn_bounds: [SymBounds], target_mod: String) : [OpWarning] = match d {
  DFn(_, fid, tps, _, _, _, body, _, _, mo) ->
    if owned_by(mo, target_mod) and any(tps, (b) => tb_is_type(b)) and is_unbounded(bounds_of_sym(fn_bounds, fnid_sym(fid))) {
      var_op_scan(body, [])
    } else { [] }
  _ -> []
}

fn owned_by(mo: Option[String], target_mod: String) : Bool = match mo {
  None    -> true
  Some(m) -> m == target_mod
}

fn is_unbounded(bs: Option[[FnTPBound]]) : Bool = match bs {
  None    -> true
  Some(_) -> false
}

fn var_op_scan(e: Expr, acc: [OpWarning]) : [OpWarning] = {
  let here = match e.kind {
    EBinop(op, l, _) -> if bp_is_arith(binop_proto(op)) and operand_is_var(l.ty) { [var_op_warning(op, e), ...acc] } else { acc }
    _ -> acc
  }
  var_op_children(xp_positions(e), here)
}

fn var_op_children(ps: [XPos], acc: [OpWarning]) : [OpWarning] = match ps {
  [] -> acc
  [XP(_, c), ...rest] -> var_op_children(rest, var_op_scan(c, acc))
}

fn operand_is_var(t: Option[Ty]) : Bool = match t {
  Some(TyVarT(_)) -> true
  _               -> false
}

fn var_op_warning(op: BinOp, e: Expr) : OpWarning = {
  let bound = match op_proto_core(binop_proto(op)) { Some(cp) -> core_proto_name(cp)  None -> "" }
  OpWarn(concat_all(["operator `", binop_text(op), "` on a type parameter with no declared bound; declare `[T: ", bound, "]`"]),
         e.line, e.col)
}
