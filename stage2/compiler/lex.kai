# compiler/lex.kai — the lexer: `tokenize(src)` turns a source string
# into the `[Token]` stream the parser consumes. Errors are `TkError`
# tokens; rendering them is the caller's job.

import compiler.escapes

# ====================================================================
# token kinds + tokens
# ====================================================================

pub type TokKind
  = TkEof
  | TkNewline
  # keywords (alphabetical)
  | TkAnd | TkAs | TkAssert | TkAxiom | TkBench | TkCase | TkCheck | TkConst | TkEffect | TkElse | TkEnsures | TkExtern | TkFalse | TkFn | TkFor
  | TkHandle | TkIf | TkImpl | TkImport
  | TkLet | TkMatch | TkNot | TkOr | TkPriv | TkProtocol | TkPub | TkRequires | TkTest | TkTheory | TkTrue | TkType
  | TkUse | TkVar | TkWhen | TkWhere | TkWith
  # Issue #608: `#[...]` annotation form. `#[` is one token (TkHashOpen);
  # the parser then reads `ident (args)?` and expects a closing `]`.
  # Replaces the pre-#608 hard-coded `#derive`/`#unstable` reserved-word
  # scan. The `#` followed by anything other than `[` remains a comment.
  | TkHashOpen
  # m12.6.x #7: regex literal `/pattern/`, only emitted when the
  # previous non-newline token is the identifier `matches` (the
  # refinement-pure predicate). Outside that narrow context, `/` keeps
  # its arithmetic meaning as TkSlash. The token's source span covers
  # both delimiters so the parser can carve out the inner pattern with
  # `tok_source` + `string_slice`.
  | TkRegex
  # literals
  | TkInt | TkReal | TkChar | TkString
  # Fixed-width integer literals: a numeric scan followed *immediately*
  # by a width suffix (`42i32`, `42u32`, `42u64`, `42i128`). The token
  # span covers the digits AND the suffix; the parser strips the suffix
  # before decoding and pins the literal's type. `i128` keeps its
  # textual span (an EFixed node) because its value can exceed 2^63 and
  # would overflow the compiler's 64-bit decode.
  | TkInt32 | TkUInt32 | TkUInt64 | TkInt128
  # An integer literal followed *immediately* by `u8` (`200u8`) lexes as
  # TkUInt8, the surface literal for the `Byte` carrier. The span covers
  # the digits AND the suffix; the parser strips it and the typer
  # range-checks `0..255`, mirroring the `[Byte]` list-element path.
  | TkUInt8
  # A numeric literal followed *immediately* by `d` (`19.99d`, `42d`)
  # lexes as TkDecimal, the suffix form for the `Decimal` carrier. Unlike
  # the width and bigint suffixes it fires on both the integer and real
  # base. The span covers the digits AND the `d`; the parser strips it
  # and folds an exact `Decimal { raw, scale }` from the source lexeme.
  | TkDecimal
  # A decimal integer literal followed *immediately* by `n` (`99n`)
  # lexes as TkBigInt. The token span includes the trailing `n`; the
  # parser strips it and desugars to `bigint.from_literal("<digits>")`,
  # folding the digit string exactly so the suffix covers any magnitude,
  # not just the i64 range.
  | TkBigInt
  # m12.x: numeric literal followed *immediately* (no whitespace) by
  # `i` lexes as TkComplex. The token span includes the trailing `i`;
  # the parser strips it before decoding the imaginary value as Real
  # and desugars to `complex.mk(0.0, im)`. Phase 1 of #267; full
  # `Real + Complex` heterogeneous arithmetic awaits #180.
  | TkComplex
  # identifiers
  | TkIdent | TkUnderscore
  # punctuation
  | TkLparen | TkRparen | TkLbracket | TkRbracket | TkLbrace | TkRbrace
  | TkComma | TkColon | TkColonEq | TkSemi | TkDot | TkDotDot | TkEllipsis
  # operators
  | TkEq | TkArrow | TkFatArrow | TkPipe | TkPipeApply | TkBarBar | TkPipeQuestion
  | TkPlus | TkMinus | TkStar | TkSlash | TkPercent
  # m7d §23: `++` is the string / list concatenation operator.
  # Right-associative, lower precedence than `+`/`-`/`*`/`/`,
  # higher than comparison.
  | TkPlusPlus
  | TkEqEq | TkNeq | TkLt | TkGt | TkLe | TkGe
  | TkBang | TkAt | TkAmp
  # Issue #556: `$<ident>(args)` is the surface form of a compiler
  # intrinsic call. Reserved sigil; user code cannot define new
  # intrinsics. Lexer emits a bare `$` as TkDollar; the parser pairs
  # it with the following identifier to produce `EIntrinsic(name, args)`.
  | TkDollar
  # m12.5: caret used for integer power inside unit expressions, e.g.
  # `m^2`, `sec^-1`. Reserved exclusively for unit syntax — outside
  # `<...>` annotations it is a parser error.
  | TkCaret
  # typed holes (M10): TkHole is a bare `?`; TkHoleName carries the
  # identifier for `?foo`. The lexer recognises `?ident` as one token
  # so the parser does not have to re-synthesise the form.
  | TkHole | TkHoleName(String)
  # m7d §1: `todo!` is a single token. The lexer recognises the
  # `todo` identifier followed immediately by `!` as `TkTodoBang`,
  # so the parser sees one symbol at the call site.
  | TkTodoBang
  # error token carries a human-readable message
  | TkError(String)

pub type Token = { kind: TokKind, line: Int, col: Int, start: Int, length: Int }

# Convenience constructor — fewer characters at call sites.
fn tok(kind: TokKind, line: Int, col: Int, start: Int, end: Int) : Token {
  Token { kind: kind, line: line, col: col, start: start, length: end - start }
}

# Mnemonic for token kinds (for --tokens dump). Keep in sync with TokKind.
pub fn tk_name(k: TokKind) : String {
  match k {
    TkEof -> "EOF"
    TkNewline -> "NEWLINE"
    TkAnd -> "and" TkAs -> "as" TkAssert -> "assert" TkAxiom -> "axiom" TkBench -> "bench" TkCase -> "case" TkCheck -> "check" TkConst -> "const" TkEffect -> "effect" TkElse -> "else"
    TkEnsures -> "ensures"
    TkExtern -> "extern"
    TkFalse -> "false" TkFn -> "fn" TkFor -> "for" TkHandle -> "handle"
    TkIf -> "if" TkImpl -> "impl" TkImport -> "import"
    TkLet -> "let" TkMatch -> "match" TkNot -> "not" TkOr -> "or"
    TkPriv -> "priv" TkProtocol -> "protocol" TkPub -> "pub" TkRequires -> "requires"
    TkTest -> "test" TkTheory -> "theory" TkTrue -> "true" TkType -> "type"
    TkUse -> "use" TkVar -> "var" TkWhen -> "when" TkWhere -> "where" TkWith -> "with"
    TkHashOpen -> "#["
    TkRegex -> "REGEX"
    TkInt -> "INT" TkReal -> "REAL" TkChar -> "CHAR" TkString -> "STRING"
    TkInt32 -> "INT32" TkUInt32 -> "UINT32" TkUInt64 -> "UINT64" TkInt128 -> "INT128"
    TkUInt8 -> "UINT8" TkDecimal -> "DECIMAL"
    TkBigInt -> "BIGINT"
    TkComplex -> "COMPLEX"
    TkIdent -> "IDENT" TkUnderscore -> "_"
    TkLparen -> "(" TkRparen -> ")" TkLbracket -> "[" TkRbracket -> "]"
    TkLbrace -> "{" TkRbrace -> "}"
    TkComma -> "," TkColon -> ":" TkColonEq -> ":=" TkSemi -> ";"
    TkDot -> "." TkDotDot -> ".." TkEllipsis -> "..."
    TkEq -> "=" TkArrow -> "->" TkFatArrow -> "=>"
    TkPipe -> "|" TkPipeApply -> "|>" TkBarBar -> "||" TkPipeQuestion -> "|?"
    TkPlus -> "+" TkMinus -> "-" TkStar -> "*" TkSlash -> "/"
    TkPercent -> "%" TkPlusPlus -> "++"
    TkEqEq -> "==" TkNeq -> "!=" TkLt -> "<" TkGt -> ">"
    TkLe -> "<=" TkGe -> ">=" TkBang -> "!" TkAt -> "@" TkAmp -> "&" TkCaret -> "^" TkDollar -> "$"
    TkHole -> "?" TkHoleName(_) -> "?NAME"
    TkTodoBang -> "todo!"
    TkError(_) -> "ERROR"
  }
}

# ====================================================================
# lexer state + helpers
# ====================================================================

type Lexer = { src: String, pos: Int, line: Int, col: Int }

fn lex_new(src: String) : Lexer = Lexer { src: src, pos: 0, line: 1, col: 1 }

# Source is read as byte Ints, -1 past the end: an `Option[Char]` per
# read, or a `Lexer` per byte stepped over, would allocate on every byte.
# Scanners walk positions and the cursor moves once per token.
const B_TAB : Int = 9
const B_NL : Int = 10
const B_CR : Int = 13
const B_SPACE : Int = 32
const B_DQUOTE : Int = 34
const B_HASH : Int = 35
const B_SQUOTE : Int = 39
const B_SLASH : Int = 47
const B_LBRACKET : Int = 91
const B_BACKSLASH : Int = 92
const B_RBRACKET : Int = 93
const B_UNDERSCORE : Int = 95
const B_LBRACE : Int = 123
const B_RBRACE : Int = 125

fn byte_at(src: String, i: Int) : Int = string_byte_at_int(src, i)

fn b_is_digit(b: Int) : Bool = b >= 48 and b <= 57

fn b_is_alpha(b: Int) : Bool = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or b == B_UNDERSCORE

fn b_is_alnum(b: Int) : Bool = b_is_alpha(b) or b_is_digit(b)

fn b_is_space(b: Int) : Bool = b == B_SPACE or b == B_TAB or b == B_CR

fn b_is_hex_digit(b: Int) : Bool = b_is_digit(b) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)

fn lex_peek_at(l: Lexer, off: Int) : Int = byte_at(l.src, l.pos + off)

fn lex_peek(l: Lexer) : Int = lex_peek_at(l, 0)

# The cursor at `end`, counting the lines and columns of the bytes passed.
fn lex_move(l: Lexer, end: Int) : Lexer = lex_move_from(l.src, l.pos, end, l.line, l.col)

fn lex_move_from(src: String, i: Int, end: Int, line: Int, col: Int) : Lexer =
  if i >= end { Lexer { src: src, pos: i, line: line, col: col } }
  else if byte_at(src, i) == B_NL { lex_move_from(src, i + 1, end, line + 1, 1) }
  else { lex_move_from(src, i + 1, end, line, col + 1) }

fn lex_advance(l: Lexer) : Lexer = if lex_peek(l) < 0 { l } else { lex_move(l, l.pos + 1) }

fn lex_advance_n(l: Lexer, n: Int) : Lexer = {
  let len = string_length(l.src)
  if l.pos + n > len { lex_move(l, len) } else { lex_move(l, l.pos + n) }
}

# Pair of lexer state + emitted token. Used everywhere the scanner
# returns both a new position and a produced token.
type LexStep = Step(Lexer, Token)

fn lex_peek_is(l: Lexer, want: Char) : Bool = lex_peek(l) == char_to_int(want)

fn lex_peek2_is(l: Lexer, want: Char) : Bool = lex_peek_at(l, 1) == char_to_int(want)

# `s` spelled at `i`, byte for byte.
fn src_has_at(src: String, i: Int, s: String, k: Int) : Bool =
  k >= string_length(s) or (byte_at(src, i + k) == byte_at(s, k) and src_has_at(src, i, s, k + 1))

# `s` at `i` and not continued by an identifier byte (`#derive(` but not `#deriveable`).
fn word_at(src: String, i: Int, s: String) : Bool =
  src_has_at(src, i, s, 0) and not b_is_alnum(byte_at(src, i + string_length(s)))

fn lex_match_word_at(l: Lexer, off: Int, s: String) : Bool = word_at(l.src, l.pos + off, s)

# ====================================================================
# whitespace and comments
# ====================================================================

fn lex_skip_ws(l: Lexer) : Lexer = lex_move(l, ws_end(l.src, l.pos))

# Spaces and `#` line comments; the newline itself is a token. `#[` opens
# an attribute, and a bare `#derive`/`#unstable` stays for `lex_punct` to
# report as legacy syntax.
fn ws_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b_is_space(b) { ws_end(src, i + 1) }
  else if b != B_HASH { i }
  else if byte_at(src, i + 1) == B_LBRACKET or word_at(src, i + 1, "derive") or word_at(src, i + 1, "unstable") { i }
  else { ws_end(src, comment_end(src, i + 1)) }
}

fn comment_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b < 0 or b == B_NL { i } else { comment_end(src, i + 1) }
}

# ====================================================================
# identifiers and keywords
# ====================================================================

fn ident_end(src: String, i: Int) : Int =
  if b_is_alnum(byte_at(src, i)) { ident_end(src, i + 1) } else { i }

fn lex_scan_ident_rest(l: Lexer) : Lexer = lex_move(l, ident_end(l.src, l.pos))

# The keyword an identifier spells, or `TkIdent`. Every keyword is 2..8
# bytes long and starts with 'a'..'w', so a plain identifier is settled
# without materialising a keyword literal to compare against.
fn ident_kind(src: String, start: Int, n: Int) : TokKind {
  let b = byte_at(src, start)
  if n == 1 and b == B_UNDERSCORE { TkUnderscore }
  else if n < 2 or n > 8 or b < 97 or b > 119 { TkIdent }
  else { keyword_at(src, start, n, int_to_char(b)) }
}

fn kw(src: String, start: Int, n: Int, s: String) : Bool =
  string_length(s) == n and src_has_at(src, start, s, 0)

fn keyword_at(src: String, start: Int, n: Int, c: Char) : TokKind = match c {
  'a' -> if kw(src, start, n, "and") { TkAnd }
         else if kw(src, start, n, "as") { TkAs }
         else if kw(src, start, n, "assert") { TkAssert }
         else if kw(src, start, n, "axiom") { TkAxiom }
         else { TkIdent }
  'b' -> if kw(src, start, n, "bench") { TkBench } else { TkIdent }
  'c' -> if kw(src, start, n, "case") { TkCase }
         else if kw(src, start, n, "check") { TkCheck }
         else if kw(src, start, n, "const") { TkConst }
         else { TkIdent }
  'e' -> if kw(src, start, n, "effect") { TkEffect }
         else if kw(src, start, n, "else") { TkElse }
         else if kw(src, start, n, "ensures") { TkEnsures }
         else if kw(src, start, n, "extern") { TkExtern }
         else { TkIdent }
  'f' -> if kw(src, start, n, "false") { TkFalse }
         else if kw(src, start, n, "fn") { TkFn }
         else if kw(src, start, n, "for") { TkFor }
         else { TkIdent }
  'h' -> if kw(src, start, n, "handle") { TkHandle } else { TkIdent }
  'i' -> if kw(src, start, n, "if") { TkIf }
         else if kw(src, start, n, "impl") { TkImpl }
         else if kw(src, start, n, "import") { TkImport }
         else { TkIdent }
  'l' -> if kw(src, start, n, "let") { TkLet } else { TkIdent }
  'm' -> if kw(src, start, n, "match") { TkMatch } else { TkIdent }
  'n' -> if kw(src, start, n, "not") { TkNot } else { TkIdent }
  'o' -> if kw(src, start, n, "or") { TkOr } else { TkIdent }
  'p' -> if kw(src, start, n, "priv") { TkPriv }
         else if kw(src, start, n, "protocol") { TkProtocol }
         else if kw(src, start, n, "pub") { TkPub }
         else { TkIdent }
  'r' -> if kw(src, start, n, "requires") { TkRequires } else { TkIdent }
  't' -> if kw(src, start, n, "test") { TkTest }
         else if kw(src, start, n, "theory") { TkTheory }
         else if kw(src, start, n, "true") { TkTrue }
         else if kw(src, start, n, "type") { TkType }
         else { TkIdent }
  'u' -> if kw(src, start, n, "use") { TkUse } else { TkIdent }
  'v' -> if kw(src, start, n, "var") { TkVar } else { TkIdent }
  'w' -> if kw(src, start, n, "when") { TkWhen }
         else if kw(src, start, n, "where") { TkWhere }
         else if kw(src, start, n, "with") { TkWith }
         else { TkIdent }
  _   -> TkIdent
}

fn lex_ident(l: Lexer) : LexStep {
  let start = l.pos
  let end = ident_end(l.src, start)
  let n = end - start
  # `todo!` is one token, so the parser sees `TkTodoBang` and the bang
  # stays free as a postfix operator elsewhere.
  if n == 4 and src_has_at(l.src, start, "todo", 0) and byte_at(l.src, end) == char_to_int('!') {
    Step(lex_move(l, end + 1), tok(TkTodoBang, l.line, l.col, start, end + 1))
  } else {
    Step(lex_move(l, end), tok(ident_kind(l.src, start, n), l.line, l.col, start, end))
  }
}

# ====================================================================
# numbers
# ====================================================================

fn digits_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b_is_digit(b) or b == B_UNDERSCORE { digits_end(src, i + 1) } else { i }
}

fn hex_digits_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b_is_hex_digit(b) or b == B_UNDERSCORE { hex_digits_end(src, i + 1) } else { i }
}

fn bin_digits_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b == 48 or b == 49 or b == B_UNDERSCORE { bin_digits_end(src, i + 1) } else { i }
}

fn lex_scan_digits(l: Lexer) : Lexer = lex_move(l, digits_end(l.src, l.pos))

# Recognise `0x[0-9a-fA-F_]+` and `0b[01_]+` as TkInt, then hand off to
# the shared suffix path so a width suffix (`0xFFi32`) attaches on every
# base. `_` is a digit separator, as in decimal, so a run of only
# separators (`0x_`) carries no digits and stays an error.
fn lex_hex_or_bin_int(l: Lexer, is_hex: Bool, sl: Int, sc: Int, start: Int) : LexStep {
  let digits = l.pos + 2
  let end = if is_hex { hex_digits_end(l.src, digits) } else { bin_digits_end(l.src, digits) }
  let l_end = lex_move(l, end)
  if lex_span_has_digit(l.src, digits, end) {
    lex_maybe_complex_suffix(l_end, sl, sc, start, TkInt)
  } else {
    let msg = if is_hex { "malformed number: expected hex digits after 0x" }
              else { "malformed number: expected binary digits after 0b" }
    Step(l_end, tok(TkError(msg), sl, sc, start, end))
  }
}

# True when the half-open span holds at least one non-`_` byte.
fn lex_span_has_digit(src: String, i: Int, end: Int) : Bool =
  i < end and (byte_at(src, i) != B_UNDERSCORE or lex_span_has_digit(src, i + 1, end))

fn lex_number(l: Lexer) : LexStep {
  let start = l.pos
  let sl = l.line
  let sc = l.col
  # Hex (`0x`/`0X`) and binary (`0b`/`0B`) literals branch off here so
  # they share TkInt with decimal and skip the float/exponent path below.
  if lex_peek_is(l, '0') and (lex_peek2_is(l, 'x') or lex_peek2_is(l, 'X')) {
    lex_hex_or_bin_int(l, true, sl, sc, start)
  } else if lex_peek_is(l, '0') and (lex_peek2_is(l, 'b') or lex_peek2_is(l, 'B')) {
    lex_hex_or_bin_int(l, false, sl, sc, start)
  } else {
    lex_number_decimal(l, sl, sc, start)
  }
}

fn lex_number_decimal(l: Lexer, sl: Int, sc: Int, start: Int) : LexStep {
  let l1 = lex_scan_digits(l)
  # Fractional part: only when `.` is followed by a digit. `x..y` (range)
  # and `x.field` (access) must be left alone.
  let is_real1 = lex_peek_is(l1, '.') and b_is_digit(lex_peek_at(l1, 1))
  let l2 = if is_real1 { lex_move(l1, digits_end(l1.src, l1.pos + 2)) } else { l1 }
  # Exponent part: `e` or `E`, optional sign, digits.
  if lex_peek_is(l2, 'e') or lex_peek_is(l2, 'E') {
    let l3 = lex_advance(l2)
    let l4 = if lex_peek_is(l3, '+') or lex_peek_is(l3, '-') { lex_advance(l3) } else { l3 }
    if b_is_digit(lex_peek(l4)) {
      lex_maybe_complex_suffix(lex_scan_digits(l4), sl, sc, start, TkReal)
    } else {
      Step(l4, tok(TkError("malformed number: expected digits after exponent"),
                   sl, sc, start, l4.pos))
    }
  } else {
    let kind = if is_real1 { TkReal } else { TkInt }
    lex_maybe_complex_suffix(l2, sl, sc, start, kind)
  }
}

# A matched fixed-width suffix: the width token and the lexer advanced
# past the suffix characters.
type WidthSuffix = WS(TokKind, Lexer)

# Try to consume a fixed-width suffix (`i32`/`u32`/`u64`/`i128`) starting
# at `l`. Only valid on an integer base, so the caller gates on
# `fallback == TkInt`. `i64` is intentionally NOT a suffix (the base
# `Int` IS i64); it is rejected so a stray `42i64` surfaces as a lex
# error rather than silently becoming complex `42i` + `64`.
fn lex_width_suffix(l: Lexer, fallback: TokKind) : Option[WidthSuffix] {
  let is_int = match fallback { TkInt -> true _ -> false }
  if not is_int { None }
  else if lex_peek_is(l, 'i') { lex_width_after_i(lex_advance(l)) }
  else if lex_peek_is(l, 'u') { lex_width_after_u(lex_advance(l)) }
  else { None }
}

# After the leading `i`: `32` is Int32, `128` is Int128. Anything else
# (including a bare `i`, which is complex) returns None.
fn lex_width_after_i(l: Lexer) : Option[WidthSuffix] {
  if lex_match_str(l, "32") { Some(WS(TkInt32, lex_advance_n(l, 2))) }
  else if lex_match_str(l, "128") { Some(WS(TkInt128, lex_advance_n(l, 3))) }
  else { None }
}

# After the leading `u`: `8` is Byte, `32` is UInt32, `64` is UInt64.
fn lex_width_after_u(l: Lexer) : Option[WidthSuffix] {
  if lex_match_str(l, "8") { Some(WS(TkUInt8, lex_advance_n(l, 1))) }
  else if lex_match_str(l, "32") { Some(WS(TkUInt32, lex_advance_n(l, 2))) }
  else if lex_match_str(l, "64") { Some(WS(TkUInt64, lex_advance_n(l, 2))) }
  else { None }
}

# True when `s` matches the source at `l.pos` AND the char immediately
# after is not alphanumeric (so `42u32x` does not match `u32`).
fn lex_match_str(l: Lexer, s: String) : Bool = word_at(l.src, l.pos, s)

# After a complete numeric scan, peek for an *immediately adjacent*
# typed suffix. Three outcomes:
#  - a fixed-width suffix (`i32`/`u32`/`u64`/`i128`) gives the matching
#    width token, span covering digits + suffix (parser strips it);
#  - a lone `i` not starting a width suffix gives TkComplex, its span
#    covering the digits + `i`;
#  - nothing adjacent gives the integer/real `fallback`.
# Whitespace before the suffix already terminates the numeric scan, so
# `3 + i` and `for i in ...` keep lexing `i` as TkIdent. The width path
# only fires on the *integer* fallback; a Real base never reaches it
# (`lex_width_suffix` returns None), so `1.0i` stays complex.
fn lex_maybe_complex_suffix(l: Lexer, sl: Int, sc: Int, start: Int, fallback: TokKind) : LexStep {
  match lex_width_suffix(l, fallback) {
    Some(WS(kind, l_after)) -> Step(l_after, tok(kind, sl, sc, start, l_after.pos))
    None ->
      # `<num>d` is a Decimal literal — on either base (`42d`, `19.99d`),
      # only when no identifier char follows (so `42d` lexes but `42down`
      # keeps `42` then `down`).
      if lex_is_decimal_suffix(l) {
        let l_after = lex_advance(l)
        Step(l_after, tok(TkDecimal, sl, sc, start, l_after.pos))
      }
      # `<int>n` is a BigInt literal — only on an integer base, and only
      # when no identifier char follows (so `99n` lexes but `99name`
      # keeps `99` then `name`).
      else if lex_is_bigint_suffix(l, fallback) {
        let l_after = lex_advance(l)
        Step(l_after, tok(TkBigInt, sl, sc, start, l_after.pos))
      } else if lex_peek_is(l, 'i') {
        let l_after = lex_advance(l)
        Step(l_after, tok(TkComplex, sl, sc, start, l_after.pos))
      } else {
        Step(l, tok(fallback, sl, sc, start, l.pos))
      }
  }
}

# True when `l` is at a `d` that ends a numeric literal (`<num>d`) and is
# not the start of an identifier. Fires on both integer and real bases.
fn lex_is_decimal_suffix(l: Lexer) : Bool =
  lex_peek_is(l, 'd') and not b_is_alnum(lex_peek_at(l, 1))

# True when `l` is at an `n` that ends an integer literal (`<int>n`) and
# is not the start of an identifier.
fn lex_is_bigint_suffix(l: Lexer, fallback: TokKind) : Bool = {
  let is_int = match fallback { TkInt -> true _ -> false }
  is_int and lex_peek_is(l, 'n') and not b_is_alnum(lex_peek_at(l, 1))
}

# ====================================================================
# strings
# ====================================================================

# Where a literal's scan stopped: past its close, or at an error.
type StrResult = StrOk(Int) | StrErr(Int, String)

fn triple_quote_at(src: String, i: Int) : Bool =
  byte_at(src, i) == B_DQUOTE and byte_at(src, i + 1) == B_DQUOTE and byte_at(src, i + 2) == B_DQUOTE

# Skip past a nested {...} block inside interpolation, counting braces.
fn lex_skip_interp(src: String, i: Int, depth: Int) : StrResult {
  let b = byte_at(src, i)
  if depth == 0 { StrOk(i) }
  else if b < 0 { StrErr(i, "unterminated interpolation in string") }
  else if b == B_LBRACE { lex_skip_interp(src, i + 1, depth + 1) }
  else if b == B_RBRACE { lex_skip_interp(src, i + 1, depth - 1) }
  else if b == B_DQUOTE {
    match lex_skip_inner_string(src, i + 1) {
      StrOk(j) -> lex_skip_interp(src, j, depth)
      err -> err
    }
  }
  else { lex_skip_interp(src, i + 1, depth) }
}

fn lex_skip_inner_string(src: String, i: Int) : StrResult {
  let b = byte_at(src, i)
  if b < 0 { StrErr(i, "unterminated string inside interpolation") }
  else if b == B_DQUOTE { StrOk(i + 1) }
  else if b != B_BACKSLASH { lex_skip_inner_string(src, i + 1) }
  else if byte_at(src, i + 1) < 0 { StrErr(i + 1, "unterminated string inside interpolation") }
  else {
    match esc_decode_at(src, i, i + 1, string_length(src)) {
      EscBad(msg, _) -> StrErr(i, msg)
      EscOk(_, next) -> lex_skip_inner_string(src, next)
    }
  }
}

fn lex_string_body(src: String, i: Int, triple: Bool) : StrResult {
  let b = byte_at(src, i)
  if b < 0 { StrErr(i, "unterminated string") }
  else if b == B_BACKSLASH { lex_string_escape(src, i, triple) }
  else if b == B_HASH and byte_at(src, i + 1) == B_LBRACE {
    match lex_skip_interp(src, i + 2, 1) {
      StrOk(j) -> lex_string_body(src, j, triple)
      err -> err
    }
  }
  else if triple {
    if triple_quote_at(src, i) { StrOk(i + 3) } else { lex_string_body(src, i + 1, triple) }
  }
  else if b == B_NL { StrErr(i, "unterminated string (newline in single-line string)") }
  else if b == B_DQUOTE { StrOk(i + 1) }
  else { lex_string_body(src, i + 1, triple) }
}

# A bad escape still scans to the closing quote so the cursor
# resynchronises instead of cascading into "unterminated string".
fn lex_string_escape(src: String, i: Int, triple: Bool) : StrResult {
  if byte_at(src, i + 1) < 0 { StrErr(i + 1, "unterminated string") }
  else {
    match esc_decode_at(src, i, i + 1, string_length(src)) {
      EscBad(msg, _) -> lex_string_err_at(src, i, msg, triple)
      EscOk(_, next) -> lex_string_body(src, next, triple)
    }
  }
}

# Report `msg` but hand back the cursor past the closing quote, so one
# bad escape yields one diagnostic instead of a cascade.
fn lex_string_err_at(src: String, i: Int, msg: String, triple: Bool) : StrResult {
  match lex_string_skip_to_close(src, i + 1, triple) {
    StrOk(j) -> StrErr(j, msg)
    StrErr(j, _) -> StrErr(j, msg)
  }
}

# Scan to the closing quote WITHOUT validating escapes — recovery only.
fn lex_string_skip_to_close(src: String, i: Int, triple: Bool) : StrResult {
  let b = byte_at(src, i)
  if b < 0 { StrErr(i, "unterminated string") }
  else if b == B_BACKSLASH {
    if byte_at(src, i + 1) < 0 { StrErr(i + 1, "unterminated string") }
    else { lex_string_skip_to_close(src, i + 2, triple) }
  }
  else if triple {
    if triple_quote_at(src, i) { StrOk(i + 3) } else { lex_string_skip_to_close(src, i + 1, triple) }
  }
  else if b == B_NL { StrErr(i, "unterminated string") }
  else if b == B_DQUOTE { StrOk(i + 1) }
  else { lex_string_skip_to_close(src, i + 1, triple) }
}

# The token for a literal spanning `start` to wherever its scan stopped.
fn lex_str_step(l: Lexer, r: StrResult, kind: TokKind) : LexStep = match r {
  StrOk(j) -> Step(lex_move(l, j), tok(kind, l.line, l.col, l.pos, j))
  StrErr(j, msg) -> Step(lex_move(l, j), tok(TkError(msg), l.line, l.col, l.pos, j))
}

fn lex_string(l: Lexer) : LexStep {
  let triple = triple_quote_at(l.src, l.pos)
  let body = if triple { l.pos + 3 } else { l.pos + 1 }
  lex_str_step(l, lex_string_body(l.src, body, triple), TkString)
}

# ====================================================================
# regex literals
# ====================================================================
#
# Elixir-style sigil: `~r/pattern/` lexes as a single `TkRegex` token
# whose source span covers the full sigil including delimiters, so `/`
# keeps its arithmetic meaning everywhere else — no contextual lookback,
# no parser backtracking.
#
# Pattern body rules: any byte except an unescaped `/` or unescaped
# newline; `\` escapes the next byte; inside `[...]` a `/` is a
# literal class element, not a terminator.

# `l` sits on the `~`; the pattern opens after `~r/`.
fn lex_regex(l: Lexer) : LexStep = lex_str_step(l, lex_regex_body(l.src, l.pos + 3, false), TkRegex)

# `in_class` is true inside a `[...]` character class, where `/` and `]`
# swap their meaning relative to the outer state.
fn lex_regex_body(src: String, i: Int, in_class: Bool) : StrResult {
  let b = byte_at(src, i)
  if b < 0 { StrErr(i, "unterminated regex literal") }
  else if b == B_BACKSLASH {
    if byte_at(src, i + 1) < 0 { StrErr(i + 1, "unterminated regex literal") }
    else { lex_regex_body(src, i + 2, in_class) }
  }
  else if b == B_NL { StrErr(i, "unterminated regex literal (newline before closing `/`)") }
  else if in_class { lex_regex_body(src, i + 1, b != B_RBRACKET) }
  else if b == B_SLASH { StrOk(i + 1) }
  else { lex_regex_body(src, i + 1, b == B_LBRACKET) }
}

# ====================================================================
# char literals
# ====================================================================

# Past the UTF-8 continuation bytes (0b10xxxxxx) after a lead byte, so
# `'á'` scans as one char; `decode_char` reads the codepoint later.
fn utf8_continuation_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b >= 128 and b < 192 { utf8_continuation_end(src, i + 1) } else { i }
}

fn lex_char(l: Lexer) : LexStep {
  let body = l.pos + 1
  if byte_at(l.src, body) < 0 {
    lex_str_step(l, StrErr(body, "unterminated char literal"), TkChar)
  } else {
    match lex_char_scan_body(l.src, body) {
      StrOk(j) ->
        if byte_at(l.src, j) == B_SQUOTE { lex_str_step(l, StrOk(j + 1), TkChar) }
        else { lex_str_step(l, StrErr(j, "unterminated char literal"), TkChar) }
      err -> lex_str_step(l, err, TkChar)
    }
  }
}

# The body of a char literal: an escape through the shared table, or a
# codepoint with its continuation bytes.
fn lex_char_scan_body(src: String, i: Int) : StrResult {
  if byte_at(src, i) != B_BACKSLASH { StrOk(utf8_continuation_end(src, i + 1)) }
  else {
    match esc_decode_at(src, i, i + 1, string_length(src)) {
      # Skip to the closing quote so a bad escape yields one diagnostic
      # rather than a cascade from the leftover cursor.
      EscBad(msg, _) -> StrErr(lex_char_skip_to_quote(src, i), msg)
      EscOk(_, next) -> StrOk(next)
    }
  }
}

fn lex_char_skip_to_quote(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b < 0 or b == B_NL { i }
  else if b == B_SQUOTE { i + 1 }
  else { lex_char_skip_to_quote(src, i + 1) }
}

# ====================================================================
# punctuation and operators
# ====================================================================

fn lex_punct(l: Lexer) : LexStep {
  let start = l.pos
  let sl = l.line
  let sc = l.col
  let b = lex_peek(l)
  if b < 0 { Step(l, tok(TkEof, sl, sc, start, start)) }
  else {
    let c = int_to_char(b)
    let l1 = lex_advance(l)
    match c {
      '(' -> Step(l1, tok(TkLparen, sl, sc, start, l1.pos))
      ')' -> Step(l1, tok(TkRparen, sl, sc, start, l1.pos))
      '[' -> Step(l1, tok(TkLbracket, sl, sc, start, l1.pos))
      ']' -> Step(l1, tok(TkRbracket, sl, sc, start, l1.pos))
      '{' -> Step(l1, tok(TkLbrace, sl, sc, start, l1.pos))
      '}' -> Step(l1, tok(TkRbrace, sl, sc, start, l1.pos))
      ',' -> Step(l1, tok(TkComma, sl, sc, start, l1.pos))
      '@' -> Step(l1, tok(TkAt, sl, sc, start, l1.pos))
      # `&x` takes a reference: the prefix `ref_make` sigil. `&` is not
      # a binary operator (bitwise-and lives behind UFCS in
      # `stdlib/math/bits.kai`), so a bare `&` only ever opens a ref.
      '&' -> Step(l1, tok(TkAmp, sl, sc, start, l1.pos))
      # Issue #556: `$` opens a compiler-intrinsic call (`$<ident>(args)`).
      # The lexer emits the bare sigil; the parser consumes the
      # following ident and arg list to build `EIntrinsic`.
      '$' -> Step(l1, tok(TkDollar, sl, sc, start, l1.pos))
      # m12.5: caret token for unit exponents — only meaningful inside
      # `<...>` annotations; the parser rejects it elsewhere.
      '^' -> Step(l1, tok(TkCaret, sl, sc, start, l1.pos))
      ':' -> {
        if lex_peek_is(l1, '=') {
          let l2 = lex_advance(l1)
          Step(l2, tok(TkColonEq, sl, sc, start, l2.pos))
        } else {
          Step(l1, tok(TkColon, sl, sc, start, l1.pos))
        }
      }
      ';' -> Step(l1, tok(TkSemi, sl, sc, start, l1.pos))
      '+' -> {
        # m7d §23: `++` is the concatenation operator. The lexer
        # fuses two adjacent `+` characters into a single token; a
        # space breaks it (so `1 + +2` is still allowed if anyone
        # writes it).
        if lex_peek_is(l1, '+') {
          let l2 = lex_advance(l1)
          Step(l2, tok(TkPlusPlus, sl, sc, start, l2.pos))
        } else {
          Step(l1, tok(TkPlus, sl, sc, start, l1.pos))
        }
      }
      '*' -> Step(l1, tok(TkStar, sl, sc, start, l1.pos))
      '%' -> Step(l1, tok(TkPercent, sl, sc, start, l1.pos))
      '-' -> {
        if lex_peek_is(l1, '>') {
          let l2 = lex_advance(l1)
          Step(l2, tok(TkArrow, sl, sc, start, l2.pos))
        } else {
          Step(l1, tok(TkMinus, sl, sc, start, l1.pos))
        }
      }
      '/' -> {
        if lex_peek_is(l1, '/') {
          # Issue #608: `//` is reserved as TkError with guidance.
          # kaikai uses `#` for comments; `//` is not a comment form
          # and the `//` integer-division operator was removed in #315.
          let l2 = lex_advance(l1)
          Step(l2, tok(TkError("kaikai uses `#` for comments, not `//` (and `//` is not an operator — `Int / Int` already truncates per #315)"),
                       sl, sc, start, l2.pos))
        } else if lex_peek_is(l1, '*') {
          # Issue #608: `/*` reserved as TkError. kaikai does not
          # support block comments; each comment line begins with `#`.
          let l2 = lex_advance(l1)
          Step(l2, tok(TkError("block comments are not supported — use `#` on each line (kaikai follows Elixir on this)"),
                       sl, sc, start, l2.pos))
        } else {
          Step(l1, tok(TkSlash, sl, sc, start, l1.pos))
        }
      }
      '=' -> {
        if lex_peek_is(l1, '=') {
          let l2 = lex_advance(l1)
          Step(l2, tok(TkEqEq, sl, sc, start, l2.pos))
        } else if lex_peek_is(l1, '>') {
          let l2 = lex_advance(l1)
          Step(l2, tok(TkFatArrow, sl, sc, start, l2.pos))
        } else {
          Step(l1, tok(TkEq, sl, sc, start, l1.pos))
        }
      }
      '<' -> {
        if lex_peek_is(l1, '=') {
          let l2 = lex_advance(l1)
          Step(l2, tok(TkLe, sl, sc, start, l2.pos))
        } else {
          Step(l1, tok(TkLt, sl, sc, start, l1.pos))
        }
      }
      '>' -> {
        if lex_peek_is(l1, '=') {
          let l2 = lex_advance(l1)
          Step(l2, tok(TkGe, sl, sc, start, l2.pos))
        } else {
          Step(l1, tok(TkGt, sl, sc, start, l1.pos))
        }
      }
      '!' -> {
        if lex_peek_is(l1, '=') {
          let l2 = lex_advance(l1)
          Step(l2, tok(TkNeq, sl, sc, start, l2.pos))
        } else {
          Step(l1, tok(TkBang, sl, sc, start, l1.pos))
        }
      }
      '?' -> {
        # `?ident` is one TkHoleName token; `?` alone is TkHole.
        # Peek at the next char: if it's alpha (or `_`), read an
        # identifier.
        if b_is_alpha(lex_peek(l1)) {
          let l_end = lex_scan_ident_rest(lex_advance(l1))
          let name = string_slice(l.src, start + 1, l_end.pos - (start + 1))
          Step(l_end, tok(TkHoleName(name), sl, sc, start, l_end.pos))
        } else {
          Step(l1, tok(TkHole, sl, sc, start, l1.pos))
        }
      }
      '|' -> {
        if lex_peek_is(l1, '>') {
          let l2 = lex_advance(l1)
          Step(l2, tok(TkPipeApply, sl, sc, start, l2.pos))
        } else if lex_peek_is(l1, '|') {
          # issue #201: `||` (no whitespace between bars) is the
          # flat-map pipe. Single token so the parser sees one symbol
          # at the operator slot, mirroring how `|>` is one token.
          let l2 = lex_advance(l1)
          Step(l2, tok(TkBarBar, sl, sc, start, l2.pos))
        } else if lex_peek_is(l1, '?') {
          # issue #412: `|?` (no whitespace between bar and question)
          # is the filter pipe. Single token, mirroring `|>` and `||`.
          let l2 = lex_advance(l1)
          Step(l2, tok(TkPipeQuestion, sl, sc, start, l2.pos))
        } else {
          Step(l1, tok(TkPipe, sl, sc, start, l1.pos))
        }
      }
      '.' -> {
        if lex_peek_is(l1, '.') and lex_peek2_is(l1, '.') {
          let l2 = lex_advance(lex_advance(l1))
          Step(l2, tok(TkEllipsis, sl, sc, start, l2.pos))
        } else if lex_peek_is(l1, '.') {
          let l2 = lex_advance(l1)
          Step(l2, tok(TkDotDot, sl, sc, start, l2.pos))
        } else {
          Step(l1, tok(TkDot, sl, sc, start, l1.pos))
        }
      }
      '#' -> {
        # Issue #608: `#[` opens an attribute. lex_skip_ws only leaves a
        # `#` for lex_punct when it is followed by `[`, by the legacy
        # `derive`/`unstable` keywords (for the transition-aid TkError),
        # or in error positions; all three branches are handled here.
        if lex_peek_is(l1, '[') {
          let l_end = lex_advance(l1)
          Step(l_end, tok(TkHashOpen, sl, sc, start, l_end.pos))
        } else if lex_match_word_at(l1, 0, "derive") {
          let l_end = lex_advance_n(l1, 6)
          Step(l_end, tok(TkError("deprecated annotation syntax (issue #608) — write `#[derive(...)]` instead of `#derive(...)`"),
                          sl, sc, start, l_end.pos))
        } else if lex_match_word_at(l1, 0, "unstable") {
          let l_end = lex_advance_n(l1, 8)
          Step(l_end, tok(TkError("deprecated annotation syntax (issue #608) — write `#[unstable]` instead of `#unstable`"),
                          sl, sc, start, l_end.pos))
        } else {
          Step(l1, tok(TkError("unexpected `#` — comments start with `#` followed by space; annotations use `#[...]`"),
                       sl, sc, start, l1.pos))
        }
      }
      '~' -> {
        # m12.6.x #7: Elixir-style sigils. Currently only `~r/pattern/`
        # is recognised — opens a regex literal that lexes as a single
        # `TkRegex` token spanning `~r/.../`. The sigil family is
        # designed for future growth (`~s`, `~w`, etc.) but those
        # require their own runtime carriers and are out of scope
        # for this lane. Anything other than `~r` followed by a
        # delimiter falls through as an error so tildes don't silently
        # turn into a junk-drawer prefix.
        if lex_peek_is(l1, 'r') and lex_peek_at(l1, 1) == char_to_int('/') {
          lex_regex(l)
        } else {
          let msg = string_concat("unexpected character '~' (only `~r/.../` regex sigil is supported)", "")
          Step(l1, tok(TkError(msg), sl, sc, start, l1.pos))
        }
      }
      _ -> {
        let msg = string_concat("unexpected character '", string_concat(int_to_byte_string(b), "'"))
        Step(l1, tok(TkError(msg), sl, sc, start, l1.pos))
      }
    }
  }
}

# ====================================================================
# dispatch: one token
# ====================================================================

fn lex_next(l: Lexer) : LexStep {
  let l0 = lex_skip_ws(l)
  let sl = l0.line
  let sc = l0.col
  let b = lex_peek(l0)
  if b < 0 { Step(l0, tok(TkEof, sl, sc, l0.pos, l0.pos)) }
  else if b == B_NL {
    let l1 = lex_advance(l0)
    Step(l1, tok(TkNewline, sl, sc, l0.pos, l1.pos))
  }
  else if b_is_alpha(b) { lex_ident(l0) }
  else if b_is_digit(b) { lex_number(l0) }
  else if b == B_DQUOTE { lex_string(l0) }
  else if b == B_SQUOTE { lex_char(l0) }
  else { lex_punct(l0) }
}

# Build the full token list. Accumulate in reverse for O(1) prepend, then
# list_reverse once at the end.
fn lex_loop(l: Lexer, acc: [Token]) : [Token] {
  match lex_next(l) {
    Step(l1, t) -> {
      let acc1 = [t, ...acc]
      match t.kind {
        TkEof -> list_reverse(acc1)
        _ -> lex_loop(l1, acc1)
      }
    }
  }
}

pub fn tokenize(src: String) : [Token] {
  lex_loop(lex_new(src), [])
}

