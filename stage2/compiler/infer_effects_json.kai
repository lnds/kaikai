#[doc("""Per-function records behind the typer's `--effects-json` report.

A record carries the function's effect row, which is what a caller must
handle, and the handlers its body installs. A top-level function's row is
its declared one: an unannotated top-level function is pure.
""")]

import compiler.util
import compiler.ast
import compiler.diag_file
import compiler.expr_positions
import compiler.infer
import compiler.infer_json_base
import compiler.infer_effects_names

#[doc("infer: per-function effect record behind `--effects-json`; `row_open` marks a row polymorphic in further effects.")]
pub type EffEntry = { file: String, fn_name: String, line: Int, col: Int,
                  effs: [String], row_open: Bool, handlers: [EffHandle] }

#[doc("infer: collect per-function effect records across a typed declaration list; `df` names the file each function is declared in.")]
pub fn effects_walk_decls(decls: [Decl], df: DiagFiles, acc: [EffEntry]) : [EffEntry] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DFn(_, name, _, _, _, row, body, line, col, _, _) ->
        if effects_skip_internal(name) {
          effects_walk_decls(rest, df, acc)
        } else {
          let entry = EffEntry { file: decl_diag_file(d, df), fn_name: name,
                                  line: line, col: col,
                                  effs: effects_row_labels(row), row_open: effects_row_open(row),
                                  handlers: effects_handlers(body, []) }
          effects_walk_decls(rest, df, [entry, ...acc])
        }
      _ -> effects_walk_decls(rest, df, acc)
    }
  }
}

fn effects_row_labels(row: RowExpr) : [String] = match row {
  REmpty         -> []
  RClosed(ls)    -> effects_label_names(ls, [])
  ROpen(_, ls)   -> effects_label_names(ls, [])
}

fn effects_row_open(row: RowExpr) : Bool = match row {
  ROpen(_, _) -> true
  _           -> false
}

fn effects_label_names(ls: [RowLabel], acc: [String]) : [String] = match ls {
  []                    -> acc
  [RL(n, _), ...rest]   -> effects_label_names(rest, effects_add_unique(n, acc))
}

fn effects_handlers(e: Expr, acc: [EffHandle]) : [EffHandle] = match e.kind {
  EHandle(_, eff, _, _, _, _, _, _) -> effects_handlers_ps(xp_positions(e), [EH(eff, e.line, e.col), ...acc])
  _                                 -> effects_handlers_ps(xp_positions(e), acc)
}

fn effects_handlers_ps(ps: [XPos], acc: [EffHandle]) : [EffHandle] = match ps {
  []                  -> acc
  [XP(_, c), ...rest] -> effects_handlers_ps(rest, effects_handlers(c, acc))
}

#[doc("infer: one `--effects-json` record, rendered as a JSON object.")]
pub fn effects_json_entry(e: EffEntry) : String =
  concat_all([
    "{",
    "\"file\": ", json_str(e.file),
    ", \"fn\": ", json_str(e.fn_name),
    ", \"line\": ", int_to_string(e.line),
    ", \"col\": ", int_to_string(e.col),
    ", \"effects\": [",
    inf_join_with(map(e.effs, json_str), ", "),
    "], \"row_open\": ", if e.row_open { "true" } else { "false" },
    ", \"handlers_installed\": [",
    inf_join_with(map(e.handlers, effects_json_handler), ", "),
    "]}"
  ])

fn effects_json_handler(h: EffHandle) : String {
  match h {
    EH(eff, line, col) -> concat_all([
      "{\"effect\": ", json_str(eff),
      ", \"line\": ", int_to_string(line),
      ", \"col\": ", int_to_string(col), "}"
    ])
  }
}

