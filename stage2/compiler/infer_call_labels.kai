#[doc("Typer-internal helper `collect_call_labels` shared across the infer modules.")]
pub fn collect_call_labels(e: Expr, acc: [Label]) : [Label] = match e.kind {
  EInt(_, _)             -> acc
  EReal(_, _)            -> acc
  EIntLit(_)            -> acc
  EDecimalLit(_)        -> acc
  EFixed(_, _)          -> acc
  EBool(_)            -> acc
  EChar(_)            -> acc
  EStr(_, _)          -> acc
  EUnit               -> acc
  EName(_)             -> acc
  EMark(_)             -> acc
  ESym(_, _)          -> acc
  ELocal(_)           -> acc
  EOp(_)              -> acc
  EUnder              -> acc
  EPlaceholder        -> acc
  EHole(_)            -> acc
  ETodo(_)            -> acc
  EExternBody(_, _)   -> acc
  EVariantsOf(_, _)   -> acc
  EModCall(_, _)      -> acc
  EIntrinsic(_, args_) -> collect_call_labels_list(args_, acc)
  ESurface(sf) -> collect_call_labels_list(surface_children(sf), acc)
  ECall(callee, args_) -> {
    let acc1 = match callee.ty {
      Some(t) -> match t {
        TyFnT(_, _, row) -> append_labels(row.labels, acc)
        _                -> acc
      }
      None    -> acc
    }
    collect_call_labels_list(args_, collect_call_labels(callee, acc1))
  }
  EField(base, _)     -> collect_call_labels(base, acc)
  EIndex(a, b)        -> collect_call_labels(b, collect_call_labels(a, acc))
  EBinop(_, a, b)     -> collect_call_labels(b, collect_call_labels(a, acc))
  EUnop(_, x)         -> collect_call_labels(x, acc)
  EIf(c, t, eo)       -> {
    let a1 = collect_call_labels(t, collect_call_labels(c, acc))
    match eo { Some(b) -> collect_call_labels(b, a1) None -> a1 }
  }
  EMatch(scr, arms)   -> collect_call_labels_arms(arms, collect_call_labels(scr, acc))
  ELambda(_, _)       -> acc
  ERecordLit(_, fs)   -> collect_call_labels_fields(fs, acc)
  EList(els)          -> collect_call_labels_elems(els, acc)
  ERange(a, b, opt)   -> {
    let a1 = collect_call_labels(b, collect_call_labels(a, acc))
    match opt { Some(s) -> collect_call_labels(s, a1) None -> a1 }
  }
  EBlock(stmts, tail) -> {
    let a1 = collect_call_labels_stmts(stmts, acc)
    match tail { Some(t) -> collect_call_labels(t, a1) None -> a1 }
  }
  EPipe(a, b)         -> collect_pipe_labels(b, collect_call_labels(b, collect_call_labels(a, acc)))
  EDispatchPipe(_, a, b) -> collect_call_labels(b, collect_call_labels(a, acc))
  EBang(inner)        -> collect_call_labels(inner, acc)
  ELitUnit(inner, _)  -> collect_call_labels(inner, acc)
  EHandle(body, _, _, init_opt, _, clauses, ret_opt) -> {
    let a1 = collect_call_labels(body, acc)
    let a2 = match init_opt { Some(i) -> collect_call_labels(i, a1) None -> a1 }
    let a3 = collect_call_labels_clauses(clauses, a2)
    match ret_opt {
      Some(r) -> match r { HR(_, b, _, _) -> collect_call_labels(b, a3) }
      None    -> a3
    }
  }
}


fn collect_call_labels_list(es: [Expr], acc: [Label]) : [Label] = match es {
  []           -> acc
  [h, ...rest] -> collect_call_labels_list(rest, collect_call_labels(h, acc))
}


fn collect_call_labels_arms(arms: [Arm], acc: [Label]) : [Label] = match arms {
  []           -> acc
  [a, ...rest] -> match a {
    Arm(_, opt_guard, body) -> {
      let a1 = match opt_guard { Some(g) -> collect_call_labels(g, acc) None -> acc }
      collect_call_labels_arms(rest, collect_call_labels(body, a1))
    }
  }
}


fn collect_call_labels_fields(fs: [FieldInit], acc: [Label]) : [Label] = match fs {
  []           -> acc
  [f, ...rest] -> match f {
    FI(_, e) -> collect_call_labels_fields(rest, collect_call_labels(e, acc))
  }
}


fn collect_call_labels_elems(els: [ListElem], acc: [Label]) : [Label] = match els {
  []           -> acc
  [el, ...rest] -> match el {
    ElPlain(e)  -> collect_call_labels_elems(rest, collect_call_labels(e, acc))
    ElSpread(e) -> collect_call_labels_elems(rest, collect_call_labels(e, acc))
  }
}


fn collect_call_labels_stmts(ss: [Stmt], acc: [Label]) : [Label] = match ss {
  []           -> acc
  [s, ...rest] -> match s {
    SLet(_, _, e)        -> collect_call_labels_stmts(rest, collect_call_labels(e, acc))
    SVar(_, _, e, _, _)  -> collect_call_labels_stmts(rest, collect_call_labels(e, acc))
    SAssert(e, og)       -> {
      let a1 = collect_call_labels(e, acc)
      let a2 = match og { Some(g) -> collect_call_labels(g, a1) None -> a1 }
      collect_call_labels_stmts(rest, a2)
    }
    SExprStmt(e)         -> collect_call_labels_stmts(rest, collect_call_labels(e, acc))
    SIndexAssign(a, b, c, _, _) -> {
      let a1 = collect_call_labels(c, collect_call_labels(b, collect_call_labels(a, acc)))
      collect_call_labels_stmts(rest, a1)
    }
    SAssign(a, c, _, _) ->
      collect_call_labels_stmts(rest, collect_call_labels(c, collect_call_labels(a, acc)))
    SUse(_, _, _)        -> collect_call_labels_stmts(rest, acc)
  }
}


fn collect_call_labels_clauses(cs: [HClause], acc: [Label]) : [Label] = match cs {
  []           -> acc
  [c, ...rest] -> match c {
    HC(_, _, body, _, _) -> collect_call_labels_clauses(rest, collect_call_labels(body, acc))
  }
}


# The functions a bare `nm` may reach from the file under inference:
# those of a module the file declares, picks from, opens or sees as a
# core. A module the reader never imported is out of its scope, whatever
# the program loaded.
#[doc("Typer-internal helper `st_visible_candidates` shared across the infer modules.")]
pub fn st_visible_candidates(st: InferState, nm: String) : [TyCandidate] = {
  let v = st_scope(st)
  filter(ty_env_collect_candidates(st.env, nm), (c) => sv_reaches(v, sym_owner(st.env.tab, c.sym), nm))
}


# The functions a bare written callee may reach: what the first argument's
# type narrows.
#[doc("Typer-internal helper `bare_fn_candidates` shared across the infer modules.")]
pub fn bare_fn_candidates(st: InferState, w: Written) : [TyCandidate] = st_visible_candidates(st, written_text(w))


# replace the row accumulator wholesale. Used by
# synth_handle to switch into an empty inner row before walking
# the body, then to merge the filtered body-row back with the
# outer row.
#[doc("Typer-internal helper `st_set_row` shared across the infer modules.")]
pub fn st_set_row(st: InferState, new_row: [Label]) : InferState =
  InferState { ...st, row: new_row }


# push/pop the alias stack as we enter/leave a handle's body.
# A freshly-pushed alias starts taggable.
#[doc("Typer-internal helper `st_push_alias` shared across the infer modules.")]
pub fn st_push_alias(st: InferState, alias: LocalId, esym: SymId) : InferState =
  InferState { ...st, aliases: [AB(alias, true, esym), ...st.aliases] }


#[doc("Typer-internal helper `st_pop_alias` shared across the infer modules.")]
pub fn st_pop_alias(st: InferState) : InferState {
  match st.aliases {
    [] -> st
    [_, ...rest] ->
      InferState { ...st, aliases: rest }
  }
}


# push / pop / read the clause resume binding.
#[doc("Typer-internal helper `st_set_clause_resume` shared across the infer modules.")]
pub fn st_set_clause_resume(st: InferState, rb: Option[ResumeBind]) : InferState =
  InferState { ...st, clause_resume: rb }


# mark whether the current scope is a handler op-clause body.
#[doc("Typer-internal helper `st_set_home` shared across the infer modules.")]
pub fn st_set_home(st: InferState, h: Option[String]) : InferState =
  InferState { ...st, home: h }


#[doc("Typer-internal helper `st_set_in_clause` shared across the infer modules.")]
pub fn st_set_in_clause(st: InferState, b: ClauseCont) : InferState =
  InferState { ...st, in_clause: b }


# stash/clear/restore the enclosing function's declared
# return type for `e!` propagation. Set by `infer_decl` before walking
# the body; cleared by `synth_lambda` so `!` inside a closure is
# rejected (would propagate from the lambda, not the surrounding fn).
#[doc("Typer-internal helper `st_set_refine_ctx` shared across the infer modules.")]
pub fn st_set_refine_ctx(st: InferState, ctx: String) : InferState = InferState { ...st, refine_ctx: ctx }


#[doc("Typer-internal helper `st_set_ret_ty` shared across the infer modules.")]
pub fn st_set_ret_ty(st: InferState, rt: Option[Ty]) : InferState =
  InferState { ...st, ret_ty: rt }


# register a deferred field-access constraint (see
# `DeferredField`). Pushed by `synth_field` when the receiver type is
# still an unbound tyvar; drained by `infer_decl` after `check_body_row`.
#[doc("Typer-internal helper `st_push_deferred_field` shared across the infer modules.")]
pub fn st_push_deferred_field(st: InferState, df: DeferredField) : InferState =
  InferState { ...st, deferred_fields: [df, ...st.deferred_fields] }


# register a bare call whose candidate modules only the argument's type
# can tell apart (see `DeferredHom`). Pushed by `try_bare_call_narrow`
# when that type is still a variable; drained by `infer_decl`.
#[doc("Typer-internal helper `st_push_deferred_hom` shared across the infer modules.")]
pub fn st_push_deferred_hom(st: InferState, dh: DeferredHom) : InferState =
  InferState { ...st, deferred_homs: [dh, ...st.deferred_homs] }


# record an op call's effect, cell and live row-arg tyvar ids
# BEFORE `st_add_label`'s dedup can drop the label. Only parametric ops
# (non-empty id list) carry a payload tyvar a deferred field could need.
#[doc("Typer-internal helper `st_push_op_payload_vars` shared across the infer modules.")]
pub fn st_push_op_payload_vars(st: InferState, esym: SymId, cell: LocalId, ids: [Int]) : InferState =
  match ids {
    [] -> st
    _  -> InferState { ...st, op_payload_labels: [OPV(esym, cell, ids), ...st.op_payload_labels] }
  }


#[doc("The effect the alias binder `l` names, or `None` when `l` is no alias in scope.")]
pub fn lookup_alias(aliases: [AliasBinding], l: LocalId) : Option[SymId] {
  match aliases {
    [] -> None
    [AB(alias, _, s), ...rest] ->
      if local_eq(alias, l) { Some(s) } else { lookup_alias(rest, l) }
  }
}


#[doc("The declaration the `handle` head bound to the alias `l` resolved to, or `sym_none()` when `l` is no alias in scope.")]
pub fn lookup_alias_sym(aliases: [AliasBinding], l: LocalId) : SymId =
  match lookup_alias(aliases, l) {
    Some(s) -> s
    None    -> sym_none()
  }


# variant of lookup_alias that returns the binding's
# taggability flag. Used by try_op_call's alias-fallback to decide
# whether the call goes through the alias's own instance.
#[doc("Typer-internal helper `lookup_alias_taggable` shared across the infer modules.")]
pub fn lookup_alias_taggable(aliases: [AliasBinding], l: LocalId) : Option[Bool] {
  match aliases {
    [] -> None
    [AB(alias, t, _), ...rest] ->
      if local_eq(alias, l) { Some(t) } else { lookup_alias_taggable(rest, l) }
  }
}


#[doc("Typer-internal helper `st_push_inst` shared across the infer modules.")]
pub fn st_push_inst(st: InferState, cs: CallSite) : InferState =
  InferState { ...st, insts: [cs, ...st.insts] }


#[doc("Typer-internal helper `st_push_hole` shared across the infer modules.")]
pub fn st_push_hole(st: InferState, h: HoleSite) : InferState =
  InferState { ...st, holes: [h, ...st.holes] }


# lookup the recorded first-use line/col of an effect label.
# Returns (-1, -1) when the effect was never tracked — that should
# only happen when the row was set via st_set_row from outside, in
# which case the caller falls back to the function's decl span.
#[doc("Typer-internal helper `lookup_eff_use` shared across the infer modules.")]
pub fn lookup_eff_use(uses: [EffUse], target: Label) : EffUse {
  match uses {
    [] -> EU(target, -1, -1)
    [u, ...rest] -> match u {
      EU(l, _, _) -> if label_same(l, target) { u } else { lookup_eff_use(rest, target) }
    }
  }
}


# Half-open range [lo, hi) as a list of ints. Used to name the fresh
# TyVarT ids minted by one call-site's instantiation.
fn range_ids_loop(i: Int, hi: Int, acc: [Int]) : [Int] {
  if i >= hi { list_reverse(acc) }
  else { range_ids_loop(i + 1, hi, [i, ...acc]) }
}


#[doc("Typer-internal helper `range_ids` shared across the infer modules.")]
pub fn range_ids(lo: Int, hi: Int) : [Int] = range_ids_loop(lo, hi, [])


#[doc("Typer-internal helper `ty_res` shared across the infer modules.")]
pub fn ty_res(st: InferState, t: Ty) : StTy = StTy { st: st, ty: t }


#[doc("Typer-internal helper `mk_inferred` shared across the infer modules.")]
pub fn mk_inferred(st: InferState, t: Ty, e: Expr) : Inferred =
  Inferred { st: st, ty: t, expr: e }


# Leaf expressions (literals, references, EUnder, EPlaceholder) have no
# sub-nodes to rebuild, so they annotate themselves in place.
#[doc("Typer-internal helper `inferred_leaf` shared across the infer modules.")]
pub fn inferred_leaf(st: InferState, t: Ty, e: Expr) : Inferred =
  mk_inferred(st, t, with_ty(e, t))


#[doc("Typer-internal helper `synth_byte_lit` shared across the infer modules.")]
pub fn synth_byte_lit(st: InferState, n: Int, e: Expr) : Inferred / Console + File =
  if n >= 0 and n <= 255 { inferred_leaf(st, TyByte, e) }
  else {
    let perr = mk_diag(SevError, st.file, e.line, e.col, "Byte literal out of range 0..255", [])
    inferred_leaf(st_bump_err(st_push_diag(st, perr)), TyByte, e)
  }


#[doc("Typer-internal helper `st_fresh_ty` shared across the infer modules.")]
pub fn st_fresh_ty(st: InferState) : StTy {
  let n = st.env.fresh
  ty_res(st_set_env(st, fresh_var(st.env)), TyVarT(n))
}


# Why `a` and `b` fail to unify when only a declared type parameter's
# rigidity stops them: the parameter the unification would have bound,
# and what to.
#[doc("Typer-internal type `RigidWhy` shared across the infer modules.")]
pub type RigidWhy = RigidWhy(String, String)


# Another rigid parameter `j` resolves to, other than `self`.
#[doc("Typer-internal helper `rigid_named` shared across the infer modules.")]
pub fn rigid_named(rs: [RigidTv], j: Int, self: Int) : Option[String] = match rs {
  [] -> None
  [RigidTv(i, b, _), ...rest] -> if i == j and i != self { Some(rigid_name(b)) } else { rigid_named(rest, j, self) }
}


#[doc("Typer-internal helper `rigid_text` shared across the infer modules.")]
pub fn rigid_text(name: String, owner: String, what: String) : RigidWhy =
  if name == "" {
    RigidWhy(concat_all(["a type parameter of `", owner, "` is not ", what,
                         ": inside its handler clause it stands for any type a perform chooses"]),
             "keep the clause generic over it, or give the op parameter a concrete type")
  } else {
    RigidWhy(concat_all(["type parameter `", name, "` of `", owner, "` is not ", what,
                         ": inside the body it stands for any type its callers choose"]),
             "bound the parameter with the protocol it needs, or make the parameter a concrete type")
  }


# Template 1 — best-effort callee-name + argument-index
# augmentation for `type mismatch in function call`. Called after the
# generic `st_unify` has already emitted its error+notes; pinpoints
# which argument failed and surfaces the callee's signature.
#
# The callee may not be a bare name (it could be a higher-order
# expression or a method call), so name extraction is optional and
# we fall back to the generic message when nothing useful can be
# said.
#[doc("Typer-internal helper `callee_display_name` shared across the infer modules.")]
pub fn callee_display_name(st: InferState, callee: Expr) : Option[String] = {
  let env = st.env
  match callee.kind {
    EName(n)       -> Some("#{n}")
    ESym(s, _)     -> Some(decl_shown(st, s))
    ELocal(l)      -> Some("#{local_name_in(env, l)}")
    EOp(r)         -> Some("#{decl_name(env.tab, r.eff)}.#{r.op}")
    EModCall(m, n) -> Some("#{m}.#{n}")
    EField(_, f)   -> Some(f)
    _              -> None
  }
}


# A declaration as a diagnostic names it to the reader: under its module
# only when the program declares the name more than once. The reader's
# own declaration and a builtin, whose home nobody writes, stay bare.
fn decl_shown(st: InferState, s: SymId) : String = {
  let tab = st.env.tab
  let n = "#{decl_name(tab, s)}"
  if not st_valid(tab, s) or not sym_contested(tab, s) { n }
  else {
    let owner = sym_owner(tab, s)
    if not st_valid(tab, owner) or sym_same(owner, st_scope(st).home) or sym_same(owner, st_module_id(core_type_home())) { n }
    else { "#{home_shown(st, owner)}.#{n}" }
  }
}


# A module as the reader writes it: the qualifier its file binds the
# module under, else the module's name.
fn home_shown(st: InferState, m: SymId) : String = match sv_qualifier(st_scope(st), m) {
  Some(q) -> q
  None    -> "#{sym_name(st.env.tab, m)}"
}


#[doc("Typer-internal type `TyConPair` shared across the infer modules.")]
pub type TyConPair = { exp: Ty, fnd: Ty }


#[doc("Typer-internal helper `find_mismatched_tycons` shared across the infer modules.")]
pub fn find_mismatched_tycons(expected: Ty, found: Ty) : Option[TyConPair] {
  match expected {
    TyFnT(eps, eret, _) -> match found {
      TyFnT(fps, fret, _) -> {
        match find_mismatch_in_list(eps, fps) {
          Some(p) -> Some(p)
          None    -> find_mismatched_tycons(eret, fret)
        }
      }
      _ -> tycon_pair_or_none(expected, found)
    }
    # Same-name types from different modules are a real mismatch —
    # flag them so the diagnostic can render the modules and show the
    # user the actual confusion.
    TyCon(ta_sym, eas) -> match found {
      TyCon(tb_sym, fas) -> if sym_same(ta_sym, tb_sym) {
        find_mismatch_in_list(eas, fas)
      } else {
        Some(TyConPair { exp: expected, fnd: found })
      }
      _ -> tycon_pair_or_none(expected, found)
    }
    _ -> tycon_pair_or_none(expected, found)
  }
}


fn find_mismatch_in_list(es: [Ty], fs: [Ty]) : Option[TyConPair] {
  match es {
    [] -> None
    [e, ...erest] -> match fs {
      [] -> None
      [f, ...frest] -> match find_mismatched_tycons(e, f) {
        Some(p) -> Some(p)
        None    -> find_mismatch_in_list(erest, frest)
      }
    }
  }
}


fn tycon_pair_or_none(expected: Ty, found: Ty) : Option[TyConPair] {
  match expected {
    TyCon(_, _) -> match found {
      TyCon(_, _) -> Some(TyConPair { exp: expected, fnd: found })
      _           -> None
    }
    _ -> None
  }
}


# accept a bare nominal `expected = U` and
# `found = T` when `T` is registered as a variant of `U`
# in the env. This is the union-of-types upcast under the dual
# representation: `type U = A | B` adds `A` and `B` as
# zero-arg variants of `U`, so a value of type `A` lifts to `U`.
#[doc("Typer-internal helper `union_upcast_ok` shared across the infer modules.")]
pub fn union_upcast_ok(env: TyEnv, expected: Ty, found: Ty) : Bool {
  match expected {
    TyCon(u_sym, u_args) -> match found {
      TyCon(t_sym, t_args) -> {
        # An upcast lifts a component into a DIFFERENT parent, between
        # bare nominal heads only. Without the self guard, a sum type
        # whose variant names the type itself upcasts to itself and
        # swallows an argument mismatch (`Box[String]` vs `Box[Int]`).
        #
        # The two homes are deliberately not compared: a union lists
        # components another module declares (`type Both = ua.Cfg |
        # ub.Cfg`), so the parent's home and the component's are
        # unrelated. Membership in the parent's component list is what
        # authorises the lift, and that list names one declaration each.
        if sym_raw(t_sym) == sym_raw(u_sym) { false }
        else if list_length(u_args) > 0 or list_length(t_args) > 0 { false }
        else { ut_lists(env.unions, u_sym, t_sym) }
      }
      _ -> false
    }
    _ -> false
  }
}


# Known conversion pairs. `st_type_hint(st, expected, found)` suggests
# a core helper that lifts `found` into `expected` (or vice versa)
# when the pair is one we already have a built-in for. Kept narrow
# on purpose: hints that nearly-always apply are the helpful ones.
#[doc("Typer-internal helper `st_type_hint` shared across the infer modules.")]
pub fn st_type_hint(st: InferState, expected: Ty, found: Ty) : InferState {
  match expected {
    TyString -> match found {
      TyInt    -> st_help(st, "wrap the Int with `int_to_string(n)`")
      TyReal   -> st_help(st, "wrap the Real with `real_to_string(r)`")
      TyChar   -> st_help(st, "interpolate the Char into a String literal")
      _        -> st
    }
    TyInt -> match found {
      TyString -> st_help(st, "parse with `string_to_int(s)` (returns Option[Int])")
      TyChar   -> st_help(st, "convert with `char_to_int(c)`")
      _        -> st
    }
    TyReal -> match found {
      TyString -> st_help(st, "parse with `string_to_real(s)` (returns Option[Real])")
      _        -> st
    }
    TyChar -> match found {
      TyInt -> st_help(st, "convert with `int_to_char(n)`")
      _     -> st
    }
    TyCon(tcs, _) ->
      if core_ty_is(tcs, CtOption) { st_help(st, "wrap the value with `Some(...)`, or use `None` if absent") } else { st }
    _ -> st
  }
}


# Wider instantiate result: also reports the fresh TyVarT ids that
# were minted to replace the scheme's bound vars. Those ids, run
# through the final substitution, give the call-site's concrete
# type arguments (M4b) and feed monomorphisation (M4c).
#[doc("Typer-internal type `TyInstRes` shared across the infer modules.")]
pub type TyInstRes = { st: InferState, ty: Ty, fresh: [Int], unit_fresh: [Int] }


# Lexically scope a sub-walk: entries added during `inner` are dropped,
# but the fresh counter, substitution, record registry, and error
# counter propagate back to the caller.
#[doc("Typer-internal helper `st_restore_entries` shared across the infer modules.")]
pub fn st_restore_entries(outer: InferState, inner: InferState) : InferState =
  InferState { ...outer, env: TyEnv { ...outer.env, fresh: inner.env.fresh }, sub: inner.sub, recs: inner.recs, errs: inner.errs, insts: inner.insts, holes: inner.holes, row: inner.row, eff_uses: inner.eff_uses, diags: inner.diags, deferred_fields: inner.deferred_fields, deferred_homs: inner.deferred_homs, op_payload_labels: inner.op_payload_labels, op_res: inner.op_res, row_tails: inner.row_tails }


# Add fn parameters to the type environment. Doesn't produce an Expr
# list (params aren't expressions), just the param types for later
# function-type construction.
#[doc("Typer-internal type `InferredParams` shared across the infer modules.")]
pub type InferredParams = { st: InferState, tys: [Ty] }


#[doc("Typer-internal type `FTy` shared across the infer modules.")]
pub type FTy = FT(String, Ty)


#[doc("Typer-internal type `RecInst` shared across the infer modules.")]
pub type RecInst = { st: InferState, result_ty: Ty, fields: [FTy] }


#[doc("Typer-internal helper `rec_tpbinds_loop` shared across the infer modules.")]
pub fn rec_tpbinds_loop(tps: [TBinder], start: Int, i: Int, acc: [TPBind]) : [TPBind] {
  match tps {
    [] -> list_reverse(acc)
    [n, ...rest] -> rec_tpbinds_loop(rest, start, i + 1, [TPB(n, start + i), ...acc])
  }
}


#[doc("Typer-internal type `RecRows` shared across the infer modules.")]
pub type RecRows = { binds: [RVBind], sub: Subst }


# One fresh row var per row-kind tparam, per instantiation: a shared id
# would let two instances' rows unify with each other.
#[doc("Typer-internal helper `rec_row_binds` shared across the infer modules.")]
pub fn rec_row_binds(tps: [TBinder], row_names: [TLocalId], s: Subst, acc: [RVBind]) : RecRows {
  match tps {
    [] -> RecRows { binds: list_reverse(acc), sub: s }
    [n, ...rest] ->
      if tids_has(row_names, n.id) {
        let fr = subst_fresh_row(s)
        rec_row_binds(rest, row_names, fr.subst, [RVB(n.id, fr.id), ...acc])
      } else { rec_row_binds(rest, row_names, s, acc) }
  }
}


#[doc("Typer-internal helper `rec_head_slots` shared across the infer modules.")]
pub fn rec_head_slots(tps: [TBinder], binds: [TPBind], rbinds: [RVBind]) : [Ty] =
  map(tps, (n) => match inf_rvbind_lookup(rbinds, n.id) {
    Some(id) -> row_arg_carrier(row_with_tail(id))
    None     -> tv(tpbind_id_of(binds, n.id))
  })


fn fty_find_loop(fs: [FTy], target: String) : Option[Ty] {
  match fs {
    [] -> None
    [f, ...rest] -> match f {
      FT(nm, t) -> if nm == target { Some(t) } else { fty_find_loop(rest, target) }
    }
  }
}


#[doc("Typer-internal helper `fty_find` shared across the infer modules.")]
pub fn fty_find(fs: [FTy], target: String) : Option[Ty] = fty_find_loop(fs, target)


#[doc("Typer-internal helper `fty_names` shared across the infer modules.")]
pub fn fty_names(fs: [FTy]) : [String] = fty_names_loop(fs, [])


fn fty_names_loop(fs: [FTy], acc: [String]) : [String] {
  match fs {
    [] -> list_reverse(acc)
    [f, ...rest] -> match f {
      FT(nm, _) -> fty_names_loop(rest, [nm, ...acc])
    }
  }
}


#[doc("Typer-internal helper `field_hint` shared across the infer modules.")]
pub fn field_hint(fs: [FTy], target: String) : String {
  match closest_name(target, fty_names(fs)) {
    Some(sug) -> " (did you mean `.#{sug}`?)"
    None      -> ""
  }
}


#[doc("Typer-internal helper `names_clause_continuation` shared across the infer modules.")]
pub fn names_clause_continuation(st: InferState, l: LocalId) : Bool = clause_cont_reaches(st.in_clause, l)


# The name the local `l` is bound under; the empty name when nothing binds it.
#[doc("Typer-internal helper `local_name_in` shared across the infer modules.")]
pub fn local_name_in(env: TyEnv, l: LocalId) : Written = match idx_chain_local(env.locals, l) {
  [e, ..._] -> match e.key {
    KLocal(b) -> b.name
    _         -> written("")
  }
  [] -> written("")
}


# True when the tie is between dispatchers alone: one operation, declared
# by several protocols.
#[doc("Typer-internal helper `op_tie` shared across the infer modules.")]
pub fn op_tie(st: InferState, ss: [SymId]) : Bool = all(ss, (s) => pid_is_disp(st.protos.ids, s))


# A reference left between dispatchers, with the state past it: the type
# it has, or none when the dispatchers share no type.
#[doc("Typer-internal type `OpTyped` shared across the infer modules.")]
pub type OpTyped = { st: InferState, ty: Option[Ty] }


# A protocol operation called with no argument has no value to dispatch
# on: only the type it builds says whose it is, so the end of the
# declaration is told of it like an operation left between dispatchers.
#[doc("Typer-internal helper `nullary_op_noted` shared across the infer modules.")]
pub fn nullary_op_noted(rc: Inferred, args_: [Expr], line: Int, col: Int) : Inferred = match args_ {
  [] -> match rc.expr.kind {
    ESym(s, _) -> if pid_is_disp(rc.st.protos.ids, s) { Inferred { ...rc, st: st_push_deferred_hom(rc.st, DOp([s], rc.ty, line, col)) } } else { rc }
    _          -> rc
  }
  _  -> rc
}


#[doc("Typer-internal helper `report_op_stranded` shared across the infer modules.")]
pub fn report_op_stranded(st: InferState, ss: [SymId], line: Int, col: Int) : InferState / Console + File = {
  let tab = st.env.tab
  let shown = map(contest_protocols(st.protos.ids, ss), (p) => "`#{decl_name(tab, p)}` of #{home_shown(st, sym_owner(tab, p))}")
  let d = contest_stranded_diag(st.file, line, col, st.protos.ids, ss, shown)
  st_bump_err(st_push_diag(st, d))
}


# Nothing the reader's scope reaches declares the name.
#[doc("Typer-internal helper `report_no_declaration` shared across the infer modules.")]
pub fn report_no_declaration(st: InferState, w: Written, line: Int, col: Int) : InferState / Console + File = {
  let d = mk_diag(SevError, st.file, line, col, "cannot find `#{w}` in this scope", [])
  st_bump_err(st_push_diag(st, d))
}


# The name is declared, as something that is no value: one class says
# what it is, several leave even that open.
#[doc("Typer-internal helper `report_no_value` shared across the infer modules.")]
pub fn report_no_value(st: InferState, w: Written, ss: [SymId], line: Int, col: Int) : InferState / Console + File = {
  let words = class_words(st.env.tab, ss, [])
  let msg = match words {
    [one] -> "`#{w}` is #{with_article(one)}, not a value"
    _     -> "`#{w}` is ambiguous here: it names #{join_with(map(words, with_article), " and ")}, but no value"
  }
  let d = mk_diag(SevError, st.file, line, col, msg, [])
  st_bump_err(st_push_diag(st, d))
}


fn class_words(tab: SymTab, ss: [SymId], acc: [String]) : [String] = match ss {
  [] -> list_reverse(acc)
  [s, ...rest] -> {
    let word = ncls_word(sym_class(tab, s))
    class_words(tab, rest, if list_has(acc, word) { acc } else { [word, ...acc] })
  }
}


fn with_article(word: String) : String = if starts_with(word, "e") { "an #{word}" } else { "a #{word}" }


# The classes a bare value name may denote; they share one namespace.
#[doc("Typer-internal helper `value_classes` shared across the infer modules.")]
pub fn value_classes() : [NCls] = [NCFn, NCConst, NCCtor]


# What a written name denotes: one declaration, several the scope cannot
# tell apart, only declarations of a class the site did not ask for, or
# none.
#[doc("Typer-internal type `Settled` shared across the infer modules.")]
pub type Settled = SetOne(SymId) | SetTie([SymId]) | SetOther([SymId]) | SetNone


#[doc("Typer-internal helper `settle_list` shared across the infer modules.")]
pub fn settle_list(ss: [SymId]) : Settled = match ss {
  []  -> SetNone
  [s] -> SetOne(s)
  _   -> SetTie(ss)
}


#[doc("Typer-internal helper `ncls_in` shared across the infer modules.")]
pub fn ncls_in(cs: [NCls], c: NCls) : Bool = any(cs, (x) => ncls_same(x, c))


#[doc("Typer-internal helper `bound_syms` shared across the infer modules.")]
pub fn bound_syms(env: TyEnv, ss: [SymId]) : [SymId] = filter(ss, (s) => is_some(env_sym(env, s)))


#[doc("Typer-internal helper `opt_syms` shared across the infer modules.")]
pub fn opt_syms(os: [Option[SymId]]) : [SymId] = match os {
  []                 -> []
  [Some(s), ...rest] -> [s, ...opt_syms(rest)]
  [None, ...rest]    -> opt_syms(rest)
}


# What the reader's scope declares under `name` outside the classes `cs`
# and outside what a call alone reaches.
#[doc("Typer-internal helper `other_declarations` shared across the infer modules.")]
pub fn other_declarations(st: InferState, name: String, cs: [NCls]) : [SymId] = {
  let tab = st.env.tab
  let v = st_scope(st)
  filter(st_by_name(tab, name), (s) => not ncls_in(cs, sym_class(tab, s)) and names_a_kind(sym_class(tab, s)) and sv_reaches(v, sym_owner(tab, s), name))
}


fn names_a_kind(c: NCls) : Bool = match c {
  NCType       -> true
  NCExternType -> true
  NCEffect     -> true
  NCProtocol   -> true
  NCModule     -> true
  _            -> false
}


# The scope's answer for `name`: the reader's own module, its picks, its
# imports and the cores are climbed in that order, as the resolver climbs
# them, and the first rung holding a declaration the environment binds
# answers. What the runtime builds sits past the cores. A module the
# reader never imported answers nothing, whatever the program loaded.
#[doc("Typer-internal helper `settle_on_ladder` shared across the infer modules.")]
pub fn settle_on_ladder(st: InferState, name: String, cs: [NCls]) : Settled = {
  let bound = (s) => is_some(env_sym(st.env, s))
  match settle_fit(sv_resolve_fit(st.env.tab, st_scope(st), [SvOwn, SvPicks, SvImports, SvCores], cs, name, bound)) {
    SetNone -> settle_list(bound_syms(st.env, runtime_syms(name, cs)))
    r       -> r
  }
}


fn settle_fit(f: SvFit) : Settled = match f {
  SvFit(SvSym(s), _)    -> SetOne(s)
  SvFit(SvAmbig(ss), _) -> SetTie(ss)
  SvFit(_, _)           -> SetNone
}


# What the runtime builds under `name`: a constructor of `Option` or
# `Result`, a primitive.
fn runtime_syms(name: String, cs: [NCls]) : [SymId] =
  list_append(if ncls_in(cs, NCCtor) { [core_ctor_sym(name)] } else { [] },
              if ncls_in(cs, NCFn) { [builtin_sym(name)] } else { [] })


# The scope view of the file the declaration under inference is in.
#[doc("Typer-internal helper `st_scope` shared across the infer modules.")]
pub fn st_scope(st: InferState) : ScopeView = tsh_scope(st.env.ty_homes, st_reader(st))


#[doc("Typer-internal helper `tie_modules_diag` shared across the infer modules.")]
pub fn tie_modules_diag(st: InferState, w: String, ss: [SymId], called: Bool, line: Int, col: Int) : Diagnostic = {
  let tab = st.env.tab
  let cls = match ss {
    [s, ..._] -> sym_class(tab, s)
    []        -> NCFn
  }
  let suffix = if called and not ncls_same(cls, NCConst) { "(...)" } else { "" }
  nr_ambiguous_diag(st.file, line, col, cls, w, tie_homes(st, ss, []), suffix, [])
}


# Each candidate's module as the reader writes it: the qualifier its file
# binds the module under, else the module's name.
fn tie_homes(st: InferState, ss: [SymId], acc: [String]) : [String] = match ss {
  [] -> list_reverse(acc)
  [s, ...rest] -> {
    let h = home_shown(st, sym_owner(st.env.tab, s))
    tie_homes(st, rest, if list_has(acc, h) { acc } else { [h, ...acc] })
  }
}


#[doc("Typer-internal helper `escaping_uses` shared across the infer modules.")]
pub fn escaping_uses(inner: [EffUse], n_new: Int, outer: [EffUse], kept: [Label], acc: [EffUse]) : [EffUse] =
  if n_new <= 0 { list_reverse(acc) }
  else { match inner {
    [] -> list_reverse(acc)
    [EU(l, line, col), ...rest] -> {
      let blamable = any(kept, (k) => label_same(k, l)) and not any(outer, (u) => match u { EU(ol, _, _) -> label_same(ol, l) })
      escaping_uses(rest, n_new - 1, outer, kept, if blamable { [EU(l, line, col), ...acc] } else { acc })
    }
  } }

