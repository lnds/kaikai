#[doc("""
The name a declaration was written with, from its id.

A node that refers to a declaration carries the id alone. Whoever must
print the name — a diagnostic, a dump, an emitter spelling a symbol —
asks the symbol table, and for the few declarations the table has no row
for (the types the runtime builds) asks the registry that owns them.
""")]

import compiler.ast
import compiler.written
import compiler.symtab

#[doc("The name `s` was declared with: its table row, else the core type of that id, else the empty name.")]
pub fn decl_name(tab: SymTab, s: SymId) : Written =
  if st_valid(tab, s) { sym_name(tab, s) }
  else { match core_type_name_of(s) {
    Some(n) -> written(n)
    None    -> written("")
  } }

#[doc("The module that declares `s`, by name: its owner's row, else the reserved core home for a core type, else the empty name.")]
pub fn decl_home(tab: SymTab, s: SymId) : Written =
  if st_valid(tab, s) { sym_home(tab, s) }
  else { match core_type_name_of(s) {
    Some(_) -> written(core_type_home())
    None    -> written("")
  } }
