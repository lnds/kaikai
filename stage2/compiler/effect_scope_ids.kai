# compiler/effect_scope_ids.kai — the declaration an effect reference
# names from one module's viewpoint, qualified or by the scope ladder.

import compiler.ast
import compiler.modules
import compiler.symtab
import compiler.scope_view
import compiler.effect_scope_table

#[doc("Whether a bare `name` settles to a type from the context's file.")]
pub fn es_names_type(cx: ESCtx, name: String) : Bool = match sv_resolve(cx.tab, cx.view, NCType, name) {
  SvNone -> false
  _      -> true
}

#[doc("The declaration a qualified `mod.name` names: `mod`'s own `effect name`, whatever a bare `name` would reach from here; `sym_none()` when `mod` is not a visible module declaring it.")]
pub fn es_qualified_sym(cx: ESCtx, mod: String, name: String) : SymId =
  match es_module_sym(cx, mod) {
    None    -> sym_none()
    Some(m) -> match st_lookup(cx.tab, NCEffect, name, m) { Some(s) -> s  None -> sym_none() }
  }

fn es_module_sym(cx: ESCtx, mod: String) : Option[SymId] = match mt_lookup(cx.mt, mod) {
  None    -> None
  Some(_) -> st_module(cx.tab, mt_tagged_name(cx.mt, mod))
}

#[doc("The declaration an effect reference names: `m.E` names `m`'s, a bare `E` the one the ladder settles.")]
pub fn es_ref_sym(cx: ESCtx, n: String) : SymId =
  match split_dotted_qualifier(n) {
    None -> es_settle(cx, n)
    Some(QSplit(m, bare)) -> es_qualified_sym(cx, m, bare)
  }

#[doc("The base a qualified perform `mod.name.op` keeps once its qualifier is dropped: the declaration it named, spelled `spelled`.")]
pub fn es_qualified_base(cx: ESCtx, mod: String, name: String, spelled: String) : ExprKind = {
  let q = es_qualified_sym(cx, mod, name)
  if sym_raw(q) < 0 { EVar(spelled) } else { ESym(q, spec_none(), spelled) }
}

#[doc("A type argument no type answers to but an effect does fills a row-kind slot: the one-label row it denotes; None for any other name.")]
pub fn es_effect_arg(cx: ESCtx, n: String) : Option[TyKind] = {
  let s = es_settle(cx, n)
  if sym_raw(s) < 0 or es_names_type(cx, n) { None }
  else { Some(TyRow(RClosed([RL(es_resolve(cx, n), [], s)]))) }
}
