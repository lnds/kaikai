#[doc("The C of a tail call to another declared function: a guaranteed tail call once the pending releases are done.")]

import compiler.ast
import compiler.ast_ids
import compiler.emit_c_ctx
import compiler.emit_c_trmc
import compiler.emit_c_rawtypes
import compiler.emit_c_sigs
import compiler.emit_c_tcrec_emit
import compiler.emit_reuse
import compiler.effect_instance
import compiler.emit_shared_syms
import compiler.emit_tcrec_live
import compiler.enc_unit
import compiler.fn_index
import compiler.fnreg
import compiler.tail_report
import compiler.unwind_pend
import compiler.util

#[doc("What becomes of a tail call under a jump: it jumps to the C symbol, it stays a call for a reason the report names, or it stays a call with nothing to report.")]
pub(pkg) type TjVerdict = TjJump(String) | TjCall(TailWhy) | TjStay

#[doc("The tail call `call` under the jump `s` as C, or None when it stays an ordinary call.")]
pub(pkg) fn tail_emit_jump(src: String, call: Expr, s: TailStep, raw: Bool, cx: EmitCtx) : Option[String] / Console = match call.kind {
  ECall(_, args_e) -> match tail_verdict(call, s, list_length(args_e), raw, cx) {
    TjJump(sym) -> Some(tj_text(src, sym, s, args_e, cx))
    _           -> None
  }
  _ -> None
}

#[doc("The verdict on the tail call `call` of `n` arguments under `s`, in a context that is `raw` or boxed: the callee's prototype must be the caller's, with no unwind bracket, region, donor or evidence frame around the jump.")]
pub(pkg) fn tail_verdict(call: Expr, s: TailStep, n: Int, raw: Bool, cx: EmitCtx) : TjVerdict = match cx.cur_enc_fn.unit {
  EuFn(caller) -> match (fnx_callee(cx.fx, s.fid), fnx_callee(cx.fx, caller)) {
    (Some(e), Some(c)) -> tj_judge(call, s, caller, e, c, n, raw, cx)
    _                  -> TjCall(TwNotPlain)
  }
  _ -> TjStay
}

fn tj_judge(call: Expr, s: TailStep, caller: FnId, e: EFn, c: EFn, n: Int, raw: Bool, cx: EmitCtx) : TjVerdict =
  if is_some(fnx_kai(cx.fx, s.fid)) or rd_is_capable(s.fid, cx.rd_capable) { TjCall(TwNotPlain) }
  else if s.lends and tj_owes(call, cx) { TjCall(TwBorrow) }
  else { tj_judge_protos(call, s, caller, e, c, n, raw, cx) }

# A borrowing callee leaves the caller to release what it lent after the call: pending releases, or an argument the caller birthed for the borrow.
fn tj_owes(call: Expr, cx: EmitCtx) : Bool = match call.kind {
  ECall(_, args_e) -> tcl_goto_drops(cx.locals, cx.tcpend, args_e) != "" or any(args_e, tj_owned_borrow)
  _                -> false
}

fn tj_owned_borrow(a: Expr) : Bool = match a.kind {
  ECall(g, _) -> match g.kind {
    EMark(MkOwnedBorrow) -> true
    _                    -> false
  }
  _ -> false
}

fn tj_judge_protos(call: Expr, s: TailStep, caller: FnId, e: EFn, c: EFn, n: Int, raw: Bool, cx: EmitCtx) : TjVerdict =
  if cx.in_region or cx.rd_active or unw_bracketed(cx.unw, call, (n) => emit_unw_local(n, cx)) { TjStay }
  else { match (tj_proto(c), tj_proto(e)) {
    (Some(a), Some(b)) ->
      if a.raw != b.raw { TjCall(TwResult) }
      else if a.key != b.key or tj_arity(c) != n or frame_slots_of(cx.evf, caller) != [] or frame_slots_of(cx.evf, s.fid) != [] {
        TjCall(TwParams)
      }
      else if a.raw != raw { TjStay }
      else { TjJump(efn_c_sym(e)) }
    _ -> TjCall(TwParams)
  } }

fn tj_arity(e: EFn) : Int = match e { EFn(_, n, _, _, _) -> n }

type TjProto = { key: String, raw: Bool }

# The C prototype of a declared function, as clang compares it for a tail call: each parameter's C type, then the return's.
fn tj_proto(e: EFn) : Option[TjProto] = match e {
  EFn(_, n, _, sig, _) -> match sig {
    Some(US(pts, rt, mask)) ->
      if list_length(pts) == n and list_length(mask) == n {
        Some(TjProto { key: string_concat_all([join_with(tj_params(pts, mask), ", "), " -> ", ufn_ret_c_type(rt)]), raw: ufn_ret_is_raw(US(pts, rt, mask)) })
      } else { None }
    None -> Some(TjProto { key: string_concat_all([join_with(tj_boxed(n), ", "), " -> KaiValue *"]), raw: false })
  }
}

fn tj_params(pts: [Ty], mask: [Bool]) : [String] = match pts {
  [] -> []
  [t, ...rest] -> match mask {
    [m, ...mrest] -> [if m { raw_c_type(Some(t)) } else { "KaiValue *" }, ...tj_params(rest, mrest)]
    []            -> []
  }
}

fn tj_boxed(n: Int) : [String] = if n <= 0 { [] } else { ["KaiValue *", ...tj_boxed(n - 1)] }

# The arguments bound and the releases the jump skips done, in the order the back-edge of a self call does them.
fn tj_text(src: String, sym: String, s: TailStep, args_e: [Expr], cx: EmitCtx) : String / Console =
  match fnx_ufn_sig_first(cx.fx, s.fid) {
    Some(US(pts, rt, mask)) -> {
      let arg_lets = tcrec_emit_arg_lets_masked(src, args_e, pts, mask, 0, cx)
      let live     = tcl_goto_drops(cx.locals, cx.tcpend, args_e)
      let drops    = tcrec_emit_drops_masked(s.params, mask, s.dropmask, 0)
      concat_all(["({ ", arg_lets, live, drops, tj_return(sym, args_e), "(", ufn_ret_c_type(rt), ")0; })"])
    }
    None -> {
      let arg_lets = tcrec_emit_arg_lets(src, args_e, 0, cx)
      let live     = tcl_goto_drops(cx.locals, cx.tcpend, args_e)
      let drops    = tcrec_emit_drops(s.params, s.dropmask, 0)
      concat_all(["({ ", arg_lets, live, drops, tj_return(sym, args_e), "(KaiValue *)0; })"])
    }
  }

fn tj_return(sym: String, args_e: [Expr]) : String =
  concat_all(["KAI_MUSTTAIL return ", c_user_sym(sym), "(", join_with(tj_temps(list_length(args_e), 0), ", "), "); "])

fn tj_temps(n: Int, i: Int) : [String] = if i >= n { [] } else { [cat2("_t", int_to_string(i)), ...tj_temps(n, i + 1)] }
