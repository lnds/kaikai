#[doc("The bodies of the core impl functions a build may leave untyped: held aside until the program asks for the function.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.infer_index
import compiler.symtab
import compiler.core_cut
import compiler.unwind_clauses
import compiler.util

#[doc("The stream with the bodies of the held impl functions emptied, and those functions as the stream had them.")]
pub(pkg) type ImplHold = { decls: [Decl], held: [Decl] }

#[doc("The functions of `decls` that the core impls of `reg` lower to, other than the ones that feed the unwind analysis when `keep_unw` is set. With `stub` their bodies are emptied in the stream.")]
pub(pkg) fn hold_core_impls(decls: [Decl], reg: ProtocolReg, cores: [String], keep_unw: Bool, stub: Bool) : ImplHold = {
  let ix = foldl(reg.impls, idx_empty(), (acc, p) => match p {
    PIR(_, _, _, f, _, _, Some(h)) -> if list_has(cores, h) { idx_prepend_sym(acc, f, f) } else { acc }
    _ -> acc
  })
  let held = filter(decls, (d) => ih_held(ix, d, keep_unw))
  ImplHold { decls: if stub { map(decls, (d) => if ih_held(ix, d, keep_unw) { pc_stub(d) } else { d }) } else { decls }, held: held }
}

fn ih_held(ix: NameIndex[SymId], d: Decl, keep_unw: Bool) : Bool = match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) -> not list_is_empty(idx_chain_sym(ix, fnid_sym(fid))) and not (keep_unw and unw_feeds_analysis(d))
  _ -> false
}

#[doc("The symbols of the held functions.")]
pub(pkg) fn impl_hold_syms(held: [Decl]) : [SymId] = flat_map(held, (d) => match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) -> [fnid_sym(fid)]
  _ -> []
})
