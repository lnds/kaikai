#[doc("The core impl functions a build may leave untyped: those whose bodies the early cut emptied in the impl block, and those whose bodies are held aside once protocol lowering has named them.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.infer_index
import compiler.symtab
import compiler.core_cut
import compiler.protos_impls
import compiler.unwind_clauses
import compiler.util

#[doc("The stream with the bodies of the held impl functions emptied, those functions as the stream had them, and the functions whose impl block the early cut emptied.")]
pub(pkg) type ImplHold = { decls: [Decl], held: [Decl], emptied: [ImplOrigin] }

#[doc("The symbols of the methods of the impl blocks of `core`, which the early cut empties.")]
pub(pkg) fn core_impl_syms(core: [Decl]) : NameIndex[SymId] =
  foldl(core, idx_empty(), (acc, d) => match ih_bare(d) {
    DImpl(_, _, _, ms, _, _, _, _) -> foldl(ms, acc, (ix, m) => match ih_bare(m) {
      DFn(_, fid, _, _, _, _, _, _, _, _) -> idx_prepend_sym(ix, fnid_sym(fid), fnid_sym(fid))
      _ -> ix
    })
    _ -> acc
  })

#[doc("The functions of `decls` that the core impls of `reg` lower to, other than the ones that feed the unwind analysis when `keep_unw` is set. `origins` says which impl block each function came from; those of a block in `cut` already have their bodies emptied and are returned as such. With `stub` the bodies of the others are emptied in the stream.")]
pub(pkg) fn hold_core_impls(decls: [Decl], reg: ProtocolReg, cores: [String], keep_unw: Bool, stub: Bool,
                            origins: [ImplOrigin], cut: NameIndex[SymId]) : ImplHold = {
  let ix = foldl(reg.impls, idx_empty(), (acc, p) => match p {
    PIR(_, _, _, f, _, _, Some(h)) -> if list_has(cores, h) { idx_prepend_sym(acc, f, f) } else { acc }
    _ -> acc
  })
  let emptied = foldl(origins, idx_empty(), (acc, o) => match o {
    ImplOrigin(f, i) -> if list_is_empty(idx_chain_sym(cut, i)) { acc } else { idx_prepend_sym(acc, f, o) }
  })
  let free = (d) => ih_core_fn(ix, d) and not (keep_unw and unw_feeds_analysis(d))
  let by_block = (d) => free(d) and not list_is_empty(idx_chain_sym(emptied, ih_sym(d)))
  let held = (d) => free(d) and not by_block(d)
  ImplHold { decls: if stub { map(decls, (d) => if held(d) { pc_stub(d) } else { d }) } else { decls },
             held: filter(decls, held),
             emptied: flat_map(decls, (d) => if by_block(d) { idx_chain_sym(emptied, ih_sym(d)) } else { [] }) }
}

fn ih_core_fn(ix: NameIndex[SymId], d: Decl) : Bool = match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) -> not list_is_empty(idx_chain_sym(ix, fnid_sym(fid)))
  _ -> false
}

fn ih_sym(d: Decl) : SymId = match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) -> fnid_sym(fid)
  _ -> sym_none()
}

fn ih_bare(d: Decl) : Decl = match d {
  DDoc(_, _, inner, _, _) -> ih_bare(inner)
  DAttr(_, inner, _, _)   -> ih_bare(inner)
  _ -> d
}

#[doc("The symbols of the held functions.")]
pub(pkg) fn impl_hold_syms(held: [Decl]) : [SymId] = flat_map(held, (d) => match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) -> [fnid_sym(fid)]
  _ -> []
})

#[doc("The symbols of the functions whose impl block the early cut emptied.")]
pub(pkg) fn impl_origin_syms(os: [ImplOrigin]) : [SymId] = map(os, (o) => match o { ImplOrigin(f, _) -> f })
