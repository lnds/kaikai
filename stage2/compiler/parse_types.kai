#[doc("Type-expression and kind-annotation parsing.")]

import compiler.chars
import compiler.lex
import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.parse_state
import compiler.symtab
import compiler.parse_lexical
import compiler.util
import compiler.kinds

#[doc("Parses an optional `: Type` annotation.")]
pub fn parse_optional_type(p: Parser) : PTy / Console =
  if p_at(p, TkColon) { parse_type(p_advance(p)) } else { PTy { p: p, r: None } }

#[doc("Parses an optional `/ row` effect-row suffix.")]
pub fn parse_row_suffix(p: Parser) : PRow / Console =
  if p_at(p, TkSlash) { parse_row_labels(p_advance(p), []) } else { PRow { p: p, r: REmpty } }

# A row variable or hole closes the row, so a `+` after it is an error.
fn row_open(p: Parser, tail: TParamRef, acc: [RowLabel], msg: String) : PRow / Console {
  let p1 = if p_at(p, TkPlus) { p_error_here(p, msg) } else { p }
  PRow { p: p1, r: ROpen(tail, list_reverse(acc)) }
}

fn parse_row_labels(p: Parser, acc: [RowLabel]) : PRow / Console {
  let t = p_peek(p)
  match t.kind {
    TkHole -> row_open(p_advance(p), TpHole(None, t.line, t.col), acc, row_hole_msg())
    TkHoleName(nm) -> row_open(p_advance(p), TpHole(Some(nm), t.line, t.col), acc, row_hole_msg())
    TkIdent -> parse_row_label_head(p, t, acc)
    _ -> PRow { p: p_error(p, t, "expected effect name in row"), r: REmpty }
  }
}

fn row_hole_msg() : String = "row hole must be the last item in the row"

fn parse_row_label_head(p: Parser, t: Token, acc: [RowLabel]) : PRow / Console {
  let name = tok_source(p.src, t)
  let p1 = p_advance(p)
  if is_upper_ident(p.src, t) { row_label_tail(p1, ref_written(name), acc) }
  else if p_at(p1, TkDot) { row_qualified_label(p_advance(p1), name, acc) }
  else { row_open(p1, TpWritten(written(name)), acc, "row variable must be the last item in the row") }
}

fn row_qualified_label(p: Parser, qualifier: String, acc: [RowLabel]) : PRow / Console {
  let t = p_peek(p)
  if tk_is(t.kind, TkIdent) and is_upper_ident(p.src, t) {
    row_label_tail(p_advance(p), ref_qualified(qualifier, tok_source(p.src, t)), acc)
  } else {
    PRow { p: p_error(p, t, "expected effect name after module qualifier"), r: REmpty }
  }
}

# `Reader[Int]` in row position reads like a generic application: distinct instantiations are distinct labels.
fn row_label_tail(p: Parser, name: DeclRef, acc: [RowLabel]) : PRow / Console =
  if p_at(p, TkLbracket) { row_label_after_args(parse_row_label_args(p_advance_nl(p), []), name, acc) }
  else { row_label_next(p, [RL(name, []), ...acc]) }

fn row_label_after_args(r: PRowArgs, name: DeclRef, acc: [RowLabel]) : PRow / Console =
  match r.r {
    None -> PRow { p: r.p, r: REmpty }
    Some(targs) -> row_label_next(r.p, [RL(name, targs), ...acc])
  }

fn row_label_next(p: Parser, acc: [RowLabel]) : PRow / Console =
  if p_at(p, TkPlus) { parse_row_labels(p_advance(p), acc) }
  else { PRow { p: p, r: RClosed(list_reverse(acc)) } }

#[doc("Parses the type arguments of an effect-row label.")]
pub fn parse_row_label_args(p: Parser, acc: [TypeExpr]) : PRowArgs / Console {
  let r = parse_type(p)
  match r.r {
    None -> PRowArgs { p: r.p, r: None }
    Some(arg) -> row_args_next(p_skip_newlines(r.p), [arg, ...acc])
  }
}

fn row_args_next(p: Parser, acc: [TypeExpr]) : PRowArgs / Console =
  if p_at(p, TkComma) { parse_row_label_args(p_advance_nl(p), acc) }
  else if p_at(p, TkRbracket) { PRowArgs { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else { PRowArgs { p: p_error_here(p, "expected `,` or `]` after row-label type arguments"), r: None } }

#[doc("Parses a type expression.")]
pub fn parse_type(p: Parser) : PTy / Console {
  if p.depth >= nest_max() { err_t(p_too_deep(p)) }
  else {
    let r = parse_type_in(p_at_depth(p, p.depth + 1))
    PTy { p: p_at_depth(r.p, p.depth), r: r.r }
  }
}

fn parse_type_in(p: Parser) : PTy / Console {
  let base = parse_type_base(p)
  match base.r {
    None -> base
    Some(bt) -> if p_at(base.p, TkWhere) { parse_refined_type(base.p, bt) } else { base }
  }
}

fn parse_refined_type(p: Parser, bt: TypeExpr) : PTy / Console {
  let pe = parse_refinement_predicate(p_advance(p), bt.line, bt.col)
  match pe.r {
    None -> err_t(pe.p)
    Some(pred) -> ok_t(pe.p, mk_ty(TyRefine(bt, pred), bt.line, bt.col))
  }
}

# A leading comparator elides the receiver (`where >= 0` is `self >= 0`); a leading `matches <expr>` is `matches(self, <expr>)`.
#[doc("Parses the predicate of a `where` refinement.")]
pub fn parse_refinement_predicate(p: Parser, line: Int, col: Int) : PExpr / Console {
  let t = p_peek(p)
  if is_cmp_tok(t.kind) { refine_cmp(p, line, col) }
  else if is_matches_sugar_start(p, t) { refine_matches(p, t, line, col) }
  else { p_expr(p) }
}

fn refine_matches(p: Parser, t: Token, line: Int, col: Int) : PExpr / Console {
  let rhs = p_expr(p_advance(p))
  match rhs.r {
    None -> rhs
    Some(rv) -> ok_e(rhs.p, expr_at(ECall(mk_name("matches", t.line, t.col), [mk_name("self", line, col), rv]), t))
  }
}

# A chained comparison (`1 <= self <= n`) is not read here: write `1 <= self and self <= n`.
fn refine_cmp(p: Parser, line: Int, col: Int) : PExpr / Console {
  let lhs = mk_name("self", line, col)
  let op = cmp_op_of_tok(p_peek(p).kind)
  let rhs = p_expr(p_advance(p))
  match rhs.r {
    None -> rhs
    Some(rv) -> ok_e(rhs.p, mk_expr(EBinop(op, lhs, rv), line, col))
  }
}

fn is_matches_sugar_start(p: Parser, t: Token) : Bool =
  tk_is(t.kind, TkIdent) and tok_source(p.src, t) == "matches" and matches_operand_follows(p_advance(p))

# `matches(...)` is an explicit call and `matches.f` a member access: only an operand start reads as the sugar.
fn matches_operand_follows(p: Parser) : Bool =
  match p_peek(p).kind {
    TkRegex -> true
    TkIdent -> true
    TkString -> true
    _ -> false
  }

fn parse_type_base(p: Parser) : PTy / Console {
  let t = p_peek(p)
  match t.kind {
    TkLbracket -> parse_list_type(p, t)
    TkLparen -> parse_fn_type(p, t)
    TkIdent -> parse_named_type(p, t)
    _ -> fail_t(p, "expected type")
  }
}

fn parse_list_type(p: Parser, t: Token) : PTy / Console {
  let r = parse_type(p_advance(p))
  match r.r {
    None -> err_t(r.p)
    Some(inner) ->
      if p_at(r.p, TkRbracket) { ok_t(p_advance(r.p), ty_at(TyList(inner), t)) }
      else { fail_t(r.p, "expected `]` in list type") }
  }
}

fn parse_named_type(p: Parser, t: Token) : PTy / Console {
  let name = tok_source(p.src, t)
  let p1 = p_advance(p)
  if at_qualified_member(p, t) { parse_qualified_type(p1, name, t) }
  else { type_tail(p1, ref_written(name), t, t, p_at(p1, TkLt) and ty_head_takes_habitant(p.src, t, name)) }
}

# `mod.Type[args?]`: the qualifier is validated against the module table before resolve.
fn parse_qualified_type(p1: Parser, name: String, t: Token) : PTy / Console {
  let nt = p_peek1(p1)
  let p2 = p_advance(p_advance(p1))
  type_tail(p2, ref_qualified(name, tok_source(p1.src, nt)), t, nt, p_at(p2, TkLt))
}

# `Foo[<...>]` is the `[<refinement_pure>]` attribute for the caller, not a generic opener. A habitant in
# angle brackets (`Real<m/s>`) rides `TyDim`, which the typer collapses to the head `TyName`.
fn type_tail(p: Parser, dref: DeclRef, t: Token, key: Token, habitant: Bool) : PTy / Console =
  if p_at(p, TkLbracket) and not tk_is(p_peek1(p).kind, TkLt) {
    ty_args_habitant(parse_type_args_loop(p_advance_nl(p), [], dref, t), key)
  } else if habitant {
    parse_habitant_slot(p, ty_at(TyName(dref, []), t), t)
  } else {
    ok_t(p, ty_at(TyName(dref, []), t))
  }

fn parse_type_args_loop(p: Parser, acc: [TypeExpr], name: DeclRef, t: Token) : PTy / Console {
  let r = parse_type(p)
  match r.r {
    None -> err_t(r.p)
    Some(arg) -> type_args_next(p_skip_newlines(r.p), arg, acc, name, t)
  }
}

fn type_args_next(p: Parser, arg: TypeExpr, acc: [TypeExpr], name: DeclRef, t: Token) : PTy / Console =
  if p_at(p, TkPlus) { type_args_row(p_advance(p), arg, acc, name, t) }
  else { type_args_end(p, [arg, ...acc], name, t) }

# A `+` after the first label makes the argument a compound effect row (`Stream[Int, Stdout + Fail]`),
# carried as a `TyRow` that alias substitution folds into the alias row.
fn type_args_row(p: Parser, first: TypeExpr, acc: [TypeExpr], name: DeclRef, t: Token) : PTy / Console {
  let rr = parse_row_type_arg(p, first)
  match rr.r {
    None -> err_t(rr.p)
    Some(row_te) -> type_args_end(p_skip_newlines(rr.p), [row_te, ...acc], name, t)
  }
}

fn type_args_end(p: Parser, acc: [TypeExpr], name: DeclRef, t: Token) : PTy / Console =
  if p_at(p, TkComma) { parse_type_args_loop(p_advance_nl(p), acc, name, t) }
  else if p_at(p, TkRbracket) { ok_t(p_advance(p), ty_at(TyName(name, list_reverse(acc)), t)) }
  else { fail_t(p, "expected `,` or `]` after type arguments") }

# `first` is the label read before the `+`; it must be a plain, possibly parameterised, name.
fn parse_row_type_arg(p: Parser, first: TypeExpr) : PTy / Console =
  match te_as_row_label(first) {
    None -> fail_t(p, "expected an effect label before `+` in a row type argument")
    Some(rl) -> {
      let pr = parse_row_labels(p, [rl])
      match pr.r {
        REmpty -> err_t(pr.p)
        _ -> ok_t(pr.p, mk_ty(TyRow(pr.r), first.line, first.col))
      }
    }
  }

# An uppercase plain or parameterised name; a lowercase name is a row variable, which can only close a row.
fn te_as_row_label(te: TypeExpr) : Option[RowLabel] =
  match te.tkind {
    TyName(DrWritten(None, nm), targs) ->
      if row_label_name_is_upper(written_text(nm)) { Some(RL(DrWritten(None, nm), targs)) } else { None }
    _ -> None
  }

fn row_label_name_is_upper(s: String) : Bool =
  match char_at(s, 0) {
    Some(c) -> ch_is_upper(c)
    None -> false
  }

fn parse_fn_type(p: Parser, t: Token) : PTy / Console {
  let p1 = p_advance_nl(p)
  if p_at(p1, TkRparen) {
    let p2 = p_advance(p1)
    if p_at(p2, TkArrow) { fn_type_ret(p_advance(p2), [], t) }
    else { fail_t(p2, "expected `->` in function type") }
  } else {
    parse_fn_type_args(p1, [], t)
  }
}

fn fn_type_ret(p: Parser, args: [TypeExpr], t: Token) : PTy / Console {
  let r = parse_type(p)
  match r.r {
    None -> err_t(r.p)
    Some(ret) -> {
      let row = parse_row_suffix(r.p)
      ok_t(row.p, ty_at(TyFn(args, ret, row.r), t))
    }
  }
}

# Parenthesised types are function arguments when `->` follows, else n-tuple sugar (`TsTuple`) or grouping.
fn parse_fn_type_args(p: Parser, acc: [TypeExpr], t: Token) : PTy / Console {
  let r = parse_type(p)
  match r.r {
    None -> err_t(r.p)
    Some(arg) -> fn_type_args_next(p_skip_newlines(r.p), [arg, ...acc], t)
  }
}

fn fn_type_args_next(p: Parser, acc: [TypeExpr], t: Token) : PTy / Console =
  if p_at(p, TkComma) { parse_fn_type_args(p_advance_nl(p), acc, t) }
  else if p_at(p, TkRparen) { fn_type_close(p, list_reverse(acc), t) }
  else { fail_t(p, "expected `,` or `)` in type") }

fn fn_type_close(p1: Parser, args: [TypeExpr], t: Token) : PTy / Console {
  let p2 = p_advance(p1)
  if p_at(p2, TkArrow) { fn_type_ret(p_advance(p2), args, t) }
  else { parse_tuple_type_sugar(p1, p2, args, t) }
}

fn parse_tuple_type_sugar(p1: Parser, p2: Parser, args: [TypeExpr], t: Token) : PTy / Console =
  match args {
    [only] -> ok_t(p2, only)
    _ -> match tuple_type_for_arity(list_length(args)) {
      None -> fail_t(p1, "n-tuple type sugar supports arity 2..4 only — use a named record for wider products")
      Some(_) -> ok_t(p2, ty_at(TySurface(TsTuple(args)), t))
    }
  }

#[doc("The stdlib tuple type name of an arity, or `None` outside 2..4.")]
pub fn tuple_type_for_arity(n: Int) : Option[String] =
  match n {
    2 -> Some("Pair")
    3 -> Some("Triple")
    4 -> Some("Quad")
    _ -> None
  }

#[doc("Closes an unannotated parameter group: each pending name becomes a `ptype: None` parameter pushed onto `acc`.")]
pub fn close_param_group_untyped(names: [PendName], acc: [Param]) : [Param] = close_group(names, None, acc)

#[doc("Back-fills `ty` onto every pending name of a type group (`a, b: Int`), pushing the parameters onto `acc`.")]
pub fn close_param_group(names: [PendName], ty: TypeExpr, acc: [Param]) : [Param] = close_group(names, Some(ty), acc)

fn close_group(names: [PendName], ty: Option[TypeExpr], acc: [Param]) : [Param] =
  match names {
    [] -> acc
    [pn, ...rest] -> close_group(rest, ty, [group_param(pn, ty), ...acc])
  }

fn group_param(pn: PendName, ty: Option[TypeExpr]) : Param =
  Param { binder: binder_written(pn.nm), ptype: ty, pline: pn.nline, pcol: pn.ncol, pborrow: pn.pborrow }

type UnitHead = { is_pub: Bool, name: String, intro: String, t: Token }

fn unit_decl_ok(p: Parser, h: UnitHead, body: UnitBody) : PDecl =
  ok_dn(p, DUnit(h.is_pub, h.name, body, h.intro, h.t.line, h.t.col, None), [p_ent(p, NCUnit, h.name, h.is_pub)])

#[doc("""
Parses a habitant declaration after its introducer `t`, whose source is kept verbatim:
`unit USD` (atomic), `unit Newton = kg * m / sec^2` (alias) or `pct pct70 = 70` (measure).
An integer other than `1` after `=` is a measure payload; anything else is a unit alias.
""")]
pub fn parse_unit_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let intro = tok_source(p.src, t)
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) {
    err_d(p_error(p, id, concat_all(["expected a name after `", intro, "`"])))
  } else {
    let h = UnitHead { is_pub: is_pub, name: tok_source(p.src, id), intro: intro, t: t }
    let p1 = p_advance(p)
    if p_at(p1, TkEq) { parse_unit_rhs(p_advance_nl(p1), h) } else { unit_decl_ok(p1, h, UBNone) }
  }
}

fn parse_unit_rhs(p: Parser, h: UnitHead) : PDecl / Console {
  let mt = p_peek(p)
  if tk_is(mt.kind, TkInt) and decode_int(tok_source(p.src, mt)) != 1 { parse_unit_measure(p, h) }
  else {
    let rb = parse_unit_expr(p)
    match rb.r {
      None -> err_d(rb.p)
      Some(u) -> unit_decl_ok(rb.p, h, UBAlias(u))
    }
  }
}

fn at_arith_op(p: Parser) : Bool =
  p_at(p, TkStar) or p_at(p, TkSlash) or p_at(p, TkCaret) or p_at(p, TkPlus) or p_at(p, TkMinus) or p_at(p, TkPercent)

# A measure is one literal, not a term: the sum a measure-carrying theory verifies must be exact.
fn parse_unit_measure(p: Parser, h: UnitHead) : PDecl / Console {
  let p1 = p_advance(p)
  if at_arith_op(p1) { err_d(p_error_here(p1, "a habitant measure must be a single exact numeric literal (e.g. `= 70`)")) }
  else { unit_decl_ok(p1, h, UBMeasure(tok_source(p.src, p_peek(p)))) }
}

# `kind` is contextual: the head `kind IDENT :` is never a valid expression or pattern at module scope.
#[doc("Reports whether the head is the identifier `kind` followed by `IDENT :`.")]
pub fn decl_head_is_kind(p: Parser, hd: Token) : Bool =
  tk_is(hd.kind, TkIdent) and tok_source(p.src, hd) == "kind" and tk_is(p_peek1(p).kind, TkIdent) and tk_is(p_peek2(p).kind, TkColon)

#[doc("Reports whether the head is a registered introducer word (builtin or from a `kind ... with` in the file) followed by a name.")]
pub fn decl_head_is_user_introducer(p: Parser, hd: Token) : Bool =
  tk_is(hd.kind, TkIdent) and kind_reg_is_introducer(p.kind_reg, tok_source(p.src, hd)) and tk_is(p_peek1(p).kind, TkIdent)

# Theories whose operation crosses two type domains admit an `over <Domain>` clause.
fn is_known_theory(name: String) : Bool =
  name == "AbelianGroup" or name == "Module" or name == "Composition" or name == "Semilattice" or is_builtin_theory(name)

fn is_two_domain_theory(name: String) : Bool = name == "Module" or name == "Composition"

type KindHead = { is_pub: Bool, name: String, thy: String, over: String, t: Token }

fn kind_decl_ok(p: Parser, h: KindHead, hab: KindHab) : PDecl =
  ok_dn(p, DKind(h.is_pub, h.name, h.thy, h.over, hab, h.t.line, h.t.col, None), [p_ent(p, NCKind, h.name, h.is_pub)])

#[doc("Parses `[pub] kind Name : Theory [over Domain] [with intro]` once the contextual `kind` is consumed; `t` anchors diagnostics.")]
pub fn parse_kind_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not is_upper_ident(p.src, id) { err_d(p_error(p, id, "kind name must start with an uppercase letter")) }
  else { parse_kind_theory(p_advance(p_advance(p)), KindHead { is_pub: is_pub, name: tok_source(p.src, id), thy: "", over: "", t: t }) }
}

fn parse_kind_theory(p: Parser, h: KindHead) : PDecl / Console {
  let th = p_peek(p)
  if not tk_is(th.kind, TkIdent) { err_d(p_error(p, th, "expected a theory name after `:` in a `kind` declaration")) }
  else {
    let thy = tok_source(p.src, th)
    if is_known_theory(thy) { parse_kind_over(p_advance(p), KindHead { ...h, thy: thy }) }
    else { err_d(p_error(p, th, concat_all(["unknown theory `", thy, "`"]))) }
  }
}

# `over` is contextual: claimed only in this slot of a `kind` head.
fn parse_kind_over(p: Parser, h: KindHead) : PDecl / Console {
  let ov = p_peek(p)
  if not (tk_is(ov.kind, TkIdent) and tok_source(p.src, ov) == "over") { parse_kind_with(p, h) }
  else if is_two_domain_theory(h.thy) { parse_kind_domain(p_advance(p), h) }
  else {
    err_d(p_error(p, ov, concat_all(["theory `", h.thy, "` has one domain, so it takes no `over` clause",
                                     " (only Module and Composition cross two domains)"])))
  }
}

fn parse_kind_domain(p: Parser, h: KindHead) : PDecl / Console {
  let dom = p_peek(p)
  if tk_is(dom.kind, TkIdent) and is_upper_ident(p.src, dom) { parse_kind_with(p_advance(p), KindHead { ...h, over: tok_source(p.src, dom) }) }
  else { err_d(p_error_here(p, "expected a domain type after `over` (e.g. `over Int`)")) }
}

# A kind whose habitants are derived (every arity-1 `type`) has no `with` and an empty introducer.
fn parse_kind_with(p: Parser, h: KindHead) : PDecl / Console =
  if p_at(p, TkWith) { parse_kind_introducer(p_advance(p), h) } else { kind_decl_ok(p, h, HabNone) }

fn parse_kind_introducer(p: Parser, h: KindHead) : PDecl / Console =
  match p_peek(p).kind {
    TkType -> kind_decl_ok(p_advance(p), h, HabIntro("type"))
    TkEffect -> kind_decl_ok(p_advance(p), h, HabIntro("effect"))
    _ -> parse_kind_introducer_word(p, h)
  }

# An uppercase name is a value domain; a lowercase one an introducer word, whose `{` opens a closed habitant set.
fn parse_kind_introducer_word(p: Parser, h: KindHead) : PDecl / Console {
  let it = p_peek(p)
  if not tk_is(it.kind, TkIdent) {
    err_d(p_error_here(p, "expected an introducer word or a value domain after `with` (e.g. `with metric`, `with Int`)"))
  } else if is_upper_ident(p.src, it) { kind_value_domain(p, it, h) }
  else { kind_introducer_tail(p_advance(p), tok_source(p.src, it), h) }
}

fn kind_value_domain(p: Parser, it: Token, h: KindHead) : PDecl / Console =
  match value_domain_of_name(tok_source(p.src, it)) {
    Some(dom) -> kind_decl_ok(p_advance(p), h, HabDomain(dom))
    None -> err_d(p_error(p, it, "a value-habitant domain must be `Int` or `String`"))
  }

fn kind_introducer_tail(p: Parser, word: String, h: KindHead) : PDecl / Console =
  if p_at(p, TkLbrace) { parse_kind_closed_set(p_advance_nl(p), h, word, []) }
  else { kind_decl_ok(p, h, HabIntro(word)) }

fn parse_kind_closed_set(p: Parser, h: KindHead, word: String, acc: [String]) : PDecl / Console {
  let a = p_peek(p)
  if p_at(p, TkRbrace) { closed_set_done(p, h, word, acc) }
  else if tk_is(a.kind, TkIdent) { parse_kind_closed_set(p_advance_nl(p), h, word, [tok_source(p.src, a), ...acc]) }
  else { err_d(p_error_here(p, "expected a habitant atom or `}` in the closed habitant set")) }
}

fn closed_set_done(p: Parser, h: KindHead, word: String, acc: [String]) : PDecl / Console =
  match acc {
    [] -> err_d(p_error_here(p, "a closed habitant set cannot be empty"))
    _  -> kind_decl_ok(p_advance(p), h, HabClosed(word, list_reverse(acc)))
  }

#[doc("The parser state paired with a `<name: Kind, ...>` habitant-slot list, one `\"name:Kind\"` string per slot.")]
pub type PHSlots = { p: Parser, r: Option[[String]] }

fn slots_err(p: Parser) : PHSlots = PHSlots { p: p, r: None }

#[doc("Parses `name: Kind` slots separated by commas up to `>`; each kind must be registered.")]
pub fn parse_habitant_slots_loop(p: Parser, acc: [String]) : PHSlots / Console {
  let t = p_peek(p)
  if not tk_is(t.kind, TkIdent) { slots_err(p_error(p, t, "expected a slot name in the `<...>` habitant list")) }
  else {
    let p1 = p_advance_nl(p)
    if p_at(p1, TkColon) { parse_habitant_slot_kind(p_advance_nl(p1), tok_source(p.src, t), acc) }
    else { slots_err(p_error_here(p1, "expected `:` after a habitant-slot name (`<n: Dim>`)")) }
  }
}

fn parse_habitant_slot_kind(p: Parser, sname: String, acc: [String]) : PHSlots / Console {
  let kt = p_peek(p)
  if not tk_is(kt.kind, TkIdent) { slots_err(p_error_here(p, "expected a kind after `:` in the habitant slot")) }
  else {
    let kind = tok_source(p.src, kt)
    if kind == measure_kind_name() or kind_reg_has_kind(p.kind_reg, kind) {
      parse_habitant_slot_end(p_advance_nl(p), [concat_all([sname, ":", kind]), ...acc])
    } else {
      slots_err(p_error(p, kt, concat_all(["habitant-slot kind must be a declared kind — `", kind, "` is not a kind"])))
    }
  }
}

fn parse_habitant_slot_end(p: Parser, acc: [String]) : PHSlots / Console =
  if p_at(p, TkComma) { parse_habitant_slots_loop(p_advance_nl(p), acc) }
  else if p_at(p, TkGt) { PHSlots { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else { slots_err(p_error_here(p, "expected `,` or `>` after a habitant slot")) }

# `Unit` is the void return type, not a kind; a declared kind wins over the protocol-bound reading (`[u: Metric]`).
fn word_kind(p: Parser, kw: String) : Option[Kind] =
  match kw {
    "Measure" -> Some(KUnit(measure_kind_name()))
    "Type" -> Some(KType)
    "Shape" -> Some(KShape)
    "Unit" -> None
    _ -> if kind_reg_has_kind(p.kind_reg, kw) { Some(KUnit(kw)) } else { None }
  }

fn unit_not_kind_msg() : String = "expected kind `Measure`; `Unit` is the void return type, not a kind (renamed in #253)"

#[doc("A kind annotation on a type parameter, defaulting to `Type`.")]
pub type PKind = { p: Parser, kind: Kind }

fn kind_err(p: Parser) : PKind = PKind { p: p, kind: KType }

#[doc("Parses an optional `: Type` / `: Measure` / `: Shape` / declared-kind annotation on a type parameter.")]
pub fn parse_optional_kind_annotation(p: Parser) : PKind / Console =
  if not p_at(p, TkColon) { PKind { p: p, kind: KType } }
  else {
    let p1 = p_advance_nl(p)
    let t = p_peek(p1)
    if tk_is(t.kind, TkIdent) { parse_kind_word(p, p1, t) }
    else { kind_err(p_error_here(p1, "expected `Type` or `Measure` after `:` in type parameter")) }
  }

fn parse_kind_word(p: Parser, p1: Parser, t: Token) : PKind / Console {
  let kw = tok_source(p1.src, t)
  match word_kind(p, kw) {
    Some(k) -> PKind { p: p_advance(p1), kind: k }
    None -> kind_err(p_error(p1, t, if kw == "Unit" { unit_not_kind_msg() }
      else { concat_all(["type-parameter kind must be `Type`, `Measure`, or a declared kind — `", kw, "` is not a kind"]) }))
  }
}

#[doc("""
The colon suffix of a type parameter: a kind annotation (`: Measure`, `: Type`) or a
protocol bound list (`: Show + Eq`); the two do not mix.
""")]
pub type PKindBounds = { p: Parser, kind: Kind, bounds: [String] }

fn bounds_err(p: Parser) : PKindBounds = PKindBounds { p: p, kind: KType, bounds: [] }

#[doc("Parses an optional kind annotation or protocol bounds on a type parameter.")]
pub fn parse_optional_kind_or_bounds(p: Parser) : PKindBounds / Console =
  if not p_at(p, TkColon) { PKindBounds { p: p, kind: KType, bounds: [] } }
  else {
    let p1 = p_advance_nl(p)
    let t = p_peek(p1)
    if tk_is(t.kind, TkIdent) { parse_kind_or_bounds_word(p, p1, t) }
    else { bounds_err(p_error_here(p1, "expected protocol name, `Type`, or `Measure` after `:` in type parameter")) }
  }

fn parse_kind_or_bounds_word(p: Parser, p1: Parser, t: Token) : PKindBounds / Console {
  let kw = tok_source(p1.src, t)
  match word_kind(p, kw) {
    Some(k) -> PKindBounds { p: p_advance(p1), kind: k, bounds: [] }
    None ->
      if kw == "Unit" { bounds_err(p_error(p1, t, unit_not_kind_msg())) }
      else if is_upper_ident(p1.src, t) { parse_more_bounds_loop(p_advance(p1), [kw]) }
      else { bounds_err(p_error(p1, t, "type-parameter annotation must be `Type`, `Measure`, or an uppercase protocol name")) }
  }
}

fn parse_more_bounds_loop(p: Parser, acc: [String]) : PKindBounds / Console {
  let p_n = p_skip_newlines(p)
  if not p_at(p_n, TkPlus) { PKindBounds { p: p, kind: KType, bounds: list_reverse(acc) } }
  else {
    let p1 = p_advance_nl(p_n)
    let t = p_peek(p1)
    if tk_is(t.kind, TkIdent) and is_upper_ident(p1.src, t) { parse_more_bounds_loop(p_advance(p1), [tok_source(p1.src, t), ...acc]) }
    else { PKindBounds { p: p_error_here(p1, "expected uppercase protocol name after `+` in bound list"), kind: KType, bounds: list_reverse(acc) } }
  }
}
