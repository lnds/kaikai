# compiler/name_report.kai — the one ambiguity diagnostic.
#
# Every class routes here, so a contested type reads like a contested
# function: the spelling, every candidate home, and the qualified form
# that resolves it. A contested name is an error in every class — the
# candidates are equals, and there is no order to prefer one by.

import compiler.util
import compiler.ast
import compiler.diag
import compiler.diag_file
import compiler.name_table
import compiler.name_uses
import compiler.home_spell

#[doc("Report that a bare `name` of class `cls` is contested by `homes`, naming every candidate and the qualified form. Suffix distinguishes a call (`(...)`) from a plain reference.")]
pub fn nr_error_ambiguous(file: String, line: Int, col: Int, cls: NCls,
      name: String, homes: [String], suffix: String) : Unit / Console + File {
  diag_error(file, line, col, nr_ambiguous_msg(name, homes))
  nr_ambiguous_notes(cls, name, homes, suffix)
}

fn nr_ambiguous_msg(name: String, homes: [String]) : String =
  concat_all(["bare name '", name, "' is exported by multiple modules: ",
              join_with(homes, ", ")])

fn nr_ambiguous_notes(cls: NCls, name: String, homes: [String],
      suffix: String) : Unit / Console = {
  diag_note(concat_all([ncls_word(cls), " candidates: ",
                        nr_candidates(name, homes)]))
  diag_help(concat_all(["qualify the ", ncls_word(cls), ", e.g. `",
                        nr_first(homes), ".", name, suffix, "`"]))
}

# `pa.Tok, pb.Tok` — every candidate spelled the way the user must type it.
fn nr_candidates(name: String, homes: [String]) : String =
  nr_cand_loop(name, homes, "")

fn nr_cand_loop(name: String, homes: [String], acc: String) : String =
  match homes {
    [] -> acc
    [h, ...rest] -> {
      let one = concat_all([h, ".", name])
      nr_cand_loop(name, rest, if acc == "" { one } else { concat_all([acc, ", ", one]) })
    }
  }

fn nr_first(homes: [String]) : String = match homes {
  []        -> "<mod>"
  [h, ..._] -> h
}

#[doc("Report once for every contested bare name the root file references, and once for every effect two non-core modules both export; returns the number of errors. The single entry point: build the table, scan the uses, report each. `early` carries uses scanned before a pass keyed them; `core` names the modules whose collisions are theirs to resolve.")]
pub fn nr_report_program(df: DiagFiles, decls: [Decl], target: String,
      reg: ProtocolReg, early: [NUse], core: [String]) : Int / Console + File {
  let t = list_append(nt_collect(decls, target), nt_protocols(reg, target))
  let uses = nu_merge(nu_scan(decls, t, target, nu_dispatchers(reg), core), early)
  let errs = nr_each(df_root(df), uses, t, target, core, 0)
  nr_effects(df, decls, nt_collisions(t, NCEffect), t, target, core)
  errs
}

fn nr_each(file: String, uses: [NUse], t: [NEnt],
      target: String, core: [String], errs: Int) : Int / Console + File = match uses {
  [] -> errs
  [u, ...rest] ->
    if nr_use(file, u, t, target, core) { nr_each(file, rest, t, target, core, errs + 1) }
    else { nr_each(file, rest, t, target, core, errs) }
}

# True when the report was an error. A use collected before the table
# was keyed may turn out settled here; it is then left alone.
#
# A contested name has no resolution to keep, whatever its class: the
# candidates are equals, and keeping one means keeping the one that
# happened to register last. Only a genuine tie reaches here —
# `nt_contested` has already dropped every case a rule settles.
fn nr_use(file: String, u: NUse, t: [NEnt], target: String,
      core: [String]) : Bool / Console + File = match u {
  NUse(cls, name, line, col, op) -> match nt_contested(t, cls, name, target, core) {
    [] -> false
    homes -> {
      nr_error_ambiguous(file, line, col, cls, name, homes, nr_suffix(cls, op))
      true
    }
  }
}

# A value class is qualified at a call; a classifier is qualified where
# it is named; a protocol reached through an operation, at that call.
fn nr_suffix(c: NCls, op: String) : String = match c {
  NCFn       -> nr_call_suffix(op)
  NCCtor     -> nr_call_suffix(op)
  NCProtocol -> if op == "" { "" } else { concat_all([".", op, "(...)"]) }
  _          -> ""
}

# A name the source wrote without an argument list is spelled back the
# same way: a nullary constructor has no `(...)` the reader could type.
fn nr_call_suffix(op: String) : String =
  if op == nu_bare_mark() { "" } else { "(...)" }

# Two non-core modules exporting the same effect name: each keeps its
# own, but a bare reference to the name cannot choose. Reported once,
# whether or not the root names it; core keeps its own names.
fn nr_effects(df: DiagFiles, decls: [Decl], names: [String], t: [NEnt],
      target: String, core: [String]) : Unit / Console + File = match names {
  [] -> ()
  [n, ...rest] -> {
    let homes = nr_non_core(nt_homes(t, NCEffect, n), core)
    if list_length(homes) > 1 { nr_effect_warn(df, decls, n, homes, target) } else { () }
    nr_effects(df, decls, rest, t, target, core)
  }
}

fn nr_non_core(homes: [String], core: [String]) : [String] = match homes {
  [] -> []
  [h, ...rest] ->
    if list_has(core, h) { nr_non_core(rest, core) } else { [h, ...nr_non_core(rest, core)] }
}

# Anchored at the last colliding declaration, in its own file.
fn nr_effect_warn(df: DiagFiles, decls: [Decl], name: String,
      homes: [String], target: String) : Unit / Console + File = {
  let msg = concat_all(["effect '", name, "' is exported by multiple modules: ",
                        join_with(homes, ", ")])
  match nr_effect_decl(decls, name, nr_last(homes), target) {
    Some(d) -> match d {
      DEffect(_, _, _, _, _, l, c, _) -> diag_warning(decl_diag_file(d, df), l, c, msg)
      _ -> diag_warning(df_root(df), 0, 0, msg)
    }
    None -> diag_warning(df_root(df), 0, 0, msg)
  }
  diag_note(concat_all(["effect candidates: ", nr_candidates(name, homes)]))
  diag_help("a bare reference cannot choose between them; qualify the handler head or the operation (`m.E`, `m.E.op(...)`)")
}

fn nr_effect_decl(decls: [Decl], name: String, home: String,
      target: String) : Option[Decl] = match decls {
  [] -> None
  [d, ...rest] -> match d {
    DEffect(_, n, _, _, _, _, _, mo) ->
      if hs_display(n, mo) == name and nr_home(mo, target) == home { Some(d) }
      else { nr_effect_decl(rest, name, home, target) }
    DDoc(_, _, inner, _, _) -> nr_effect_decl([inner, ...rest], name, home, target)
    DAttr(_, inner, _, _)   -> nr_effect_decl([inner, ...rest], name, home, target)
    _ -> nr_effect_decl(rest, name, home, target)
  }
}

fn nr_home(mo: Option[String], target: String) : String = match mo {
  Some(m) -> m
  None    -> target
}

fn nr_last(xs: [String]) : String = match xs {
  []           -> ""
  [x]          -> x
  [_, ...rest] -> nr_last(rest)
}
