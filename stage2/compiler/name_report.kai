#[doc("The diagnostic for a bare name the file reaches only through a module it never imported, and the indexes it reads.")]

import compiler.diag
import compiler.symtab
import compiler.module_table
import compiler.ast_decl
import compiler.ast_ids
import compiler.scope_view
import compiler.written
import compiler.core_types
import compiler.util
import compiler.diag_file
import compiler.name_uses
import compiler.infer_index
import compiler.ast

#[doc("The error for a bare `name` of class `cls` contested by `homes`: every candidate, and the qualified form as the reader whose module table is `mt` would type it. `suffix` distinguishes a call (`(...)`) from a plain reference.")]
pub(pkg) fn nr_ambiguous_diag(file: String, line: Int, col: Int, cls: NCls,
      name: String, homes: [String], suffix: String, mt: [ModuleEntry]) : Diagnostic {
  let spelled = map(homes, (h) => mt_spell_home(mt, h))
  let at = (msg) => DR(file, line, col, msg)
  mk_diag(SevError, file, line, col, nr_ambiguous_msg(name, spelled),
          map(nr_ambiguous_notes(cls, name, spelled, suffix), at))
}

fn nr_ambiguous_msg(name: String, homes: [String]) : String =
  concat_all([nr_ambiguous_head(name), join_with(homes, ", ")])

fn nr_ambiguous_head(name: String) : String =
  concat_all(["bare name '", name, "' is exported by multiple modules: "])

# True when `d` is this report, already made, for the use `u`.
fn nr_tells(d: Diagnostic, u: NUse) : Bool = match d {
  D(_, _, line, col, msg, _) -> match u {
    NUse(_, name, ul, uc, _) -> line == ul and col == uc and starts_with(msg, nr_ambiguous_head(name))
  }
}

fn nr_ambiguous_notes(cls: NCls, name: String, homes: [String], suffix: String) : [String] =
  [concat_all(["note: ", ncls_word(cls), " candidates: ", nr_candidates(name, homes)]),
   concat_all(["help: qualify the ", ncls_word(cls), ", e.g. `",
               nr_first(homes), ".", name, suffix, "`"])]

# `pa.Tok, pb.Tok` — every candidate spelled the way the user must type it.
fn nr_candidates(name: String, homes: [String]) : String =
  nr_cand_loop(name, homes, "")

fn nr_cand_loop(name: String, homes: [String], acc: String) : String =
  match homes {
    [] -> acc
    [h, ...rest] -> {
      let one = concat_all([h, ".", name])
      nr_cand_loop(name, rest, if acc == "" { one } else { concat_all([acc, ", ", one]) })
    }
  }

fn nr_first(homes: [String]) : String = match homes {
  []        -> "<mod>"
  [h, ..._] -> h
}

#[doc("Report once for every contested bare name the root file references, and once for every effect two non-core modules both export; returns the errors. The single entry point: read the names `tab` holds for the declarations, scan the uses, report each. A reference carrying an id names one declaration, so it is settled and never reported, and neither is a use `told` already reports as contested. `early` carries uses scanned before a pass keyed them; `core` names the modules whose collisions are theirs to resolve; `pre` is the stream before the protocol lowering, which is where the `DProtocol` decls still are.")]
pub(pkg) fn nr_report_program_tab(df: DiagFiles, decls: [Decl], target: String,
      reg: ProtocolReg, early: [NUse], core: [String],
      pre: [Decl], picks: [NPick], tab: SymTab, mt: [ModuleEntry], told: [Diagnostic]) : [Diagnostic] / Console + File {
  let t = list_append(nt_collect(decls, tab, target), nt_protocols(pre, tab, target))
  let scanned = nu_merge(nu_scan_tab(decls, t, target, nu_dispatchers(reg), core, picks, tab), early)
  let uses = filter(scanned, (u) => not any(told, (d) => nr_tells(d, u)))
  let ix = nt_index(t)
  let errs = list_reverse(nr_each(df_root(df), uses, ix, target, core, picks, mt, []))
  nr_effects(df, decls, tab, nt_collisions(t, NCEffect), ix, target, core, picks)
  errs
}

fn nr_each(file: String, uses: [NUse], t: NameIndex[NEnt], target: String,
      core: [String], picks: [NPick], mt: [ModuleEntry], errs: [Diagnostic]) : [Diagnostic] / Console + File = match uses {
  [] -> errs
  [u, ...rest] -> match nr_use(file, u, t, target, core, picks, mt) {
    Some(d) -> nr_each(file, rest, t, target, core, picks, mt, [d, ...errs])
    None    -> nr_each(file, rest, t, target, core, picks, mt, errs)
  }
}

# The error it reported, if any. A use collected before the table
# was keyed may turn out settled here; it is then left alone.
#
# A contested name has no resolution to keep, whatever its class: the
# candidates are equals, and keeping one means keeping the one that
# happened to register last. Only a genuine tie reaches here —
# `nt_contested_in` has already dropped every case a rule settles.
fn nr_use(file: String, u: NUse, t: NameIndex[NEnt], target: String,
      core: [String], picks: [NPick], mt: [ModuleEntry]) : Option[Diagnostic] / Console + File = match u {
  NUse(cls, name, line, col, op) -> match nt_contested_in(idx_chain(t, name), picks, cls, name, target, core) {
    [] -> None
    homes -> {
      let d = nr_ambiguous_diag(file, line, col, cls, name, homes, nr_suffix(cls, op), mt)
      render_diag(d)
      Some(d)
    }
  }
}

# A value class is qualified at a call; a classifier is qualified where
# it is named; a protocol reached through an operation, at that call.
fn nr_suffix(c: NCls, op: String) : String = match c {
  NCFn       -> nr_call_suffix(op)
  NCCtor     -> nr_call_suffix(op)
  NCProtocol -> if op == "" { "" } else { concat_all([".", op, "(...)"]) }
  _          -> ""
}

# A name the source wrote without an argument list is spelled back the
# same way: a nullary constructor has no `(...)` the reader could type.
fn nr_call_suffix(op: String) : String =
  if op == nu_bare_mark() { "" } else { "(...)" }

# Two non-core modules exporting the same effect name: each keeps its
# own, but a bare reference to the name cannot choose. Reported once,
# whether or not the root names it; core keeps its own names. A
# selective import naming the effect is that choice, so the root has
# nothing left to disambiguate and the warning would be false.
fn nr_effects(df: DiagFiles, decls: [Decl], tab: SymTab, names: [String], t: NameIndex[NEnt],
      target: String, core: [String], picks: [NPick]) : Unit / Console + File = match names {
  [] -> ()
  [n, ...rest] -> {
    let homes = nr_non_core(nt_homes(idx_chain(t, n), NCEffect, n), core)
    if list_length(homes) > 1 and list_length(nt_contested_in(idx_chain(t, n), picks, NCEffect, n, target, core)) > 0 {
      nr_effect_warn(df, decls, tab, n, homes)
    } else { () }
    nr_effects(df, decls, tab, rest, t, target, core, picks)
  }
}

fn nr_non_core(homes: [String], core: [String]) : [String] = match homes {
  [] -> []
  [h, ...rest] ->
    if list_has(core, h) { nr_non_core(rest, core) } else { [h, ...nr_non_core(rest, core)] }
}

# Anchored at the last colliding declaration, in its own file.
fn nr_effect_warn(df: DiagFiles, decls: [Decl], tab: SymTab, name: String,
      homes: [String]) : Unit / Console + File = {
  let msg = concat_all(["effect '", name, "' is exported by multiple modules: ",
                        join_with(homes, ", ")])
  match nr_effect_decl(decls, nr_effect_sym(tab, name, nr_last(homes))) {
    Some(d) -> match d {
      DEffect(_, _, _, _, _, l, c, _) -> diag_warning(decl_diag_file(d, df), l, c, msg)
      _ -> diag_warning(df_root(df), 0, 0, msg)
    }
    None -> diag_warning(df_root(df), 0, 0, msg)
  }
  diag_note(concat_all(["effect candidates: ", nr_candidates(name, homes)]))
  diag_help("a bare reference cannot choose between them; qualify the handler head or the operation (`m.E`, `m.E.op(...)`)")
}

# The effect `home` declares under `name`, `sym_none()` when the table holds none.
fn nr_effect_sym(tab: SymTab, name: String, home: String) : SymId =
  match st_lookup(tab, NCEffect, name, st_module_id(home)) {
    Some(s) -> s
    None    -> sym_none()
  }

fn nr_effect_decl(decls: [Decl], s: SymId) : Option[Decl] = match decls {
  [] -> None
  [d, ...rest] -> match d {
    DEffect(_, esym, _, _, _, _, _, _) ->
      if sym_raw(s) >= 0 and sym_raw(esym) == sym_raw(s) { Some(d) }
      else { nr_effect_decl(rest, s) }
    DDoc(_, _, inner, _, _) -> nr_effect_decl([inner, ...rest], s)
    DAttr(_, inner, _, _)   -> nr_effect_decl([inner, ...rest], s)
    _ -> nr_effect_decl(rest, s)
  }
}

fn nr_last(xs: [String]) : String = match xs {
  []           -> ""
  [x]          -> x
  [_, ...rest] -> nr_last(rest)
}

#[doc("The error for the bare `name` at `file:line:col`, which the view `v` reaches as the exported declarations `ss` only through modules it does not import; `ss` is never empty.")]
pub(pkg) fn nh_diag(t: SymTab, v: ScopeView, ss: [SymId], file: String, line: Int, col: Int,
      name: String) : Diagnostic {
  let ms = map(ss, (s) => mt_spell_home([], written_text(sym_home(t, s))))
  if all(ss, (s) => not sv_pkg_reaches(t, v, s, sym_owner(t, s))) {
    mk_diag(SevError, file, line, col, "`#{name}` is `pub(pkg)` in #{nh_modules(ms)}, which belongs to another package",
            [ri_help(file, line, col, "a `pub(pkg)` declaration is visible only to the modules of its own package; declare it `pub` there to use it from here")])
  } else { nh_diag_unimported(t, v, ss, file, line, col, name, ms) }
}

fn nh_diag_unimported(t: SymTab, v: ScopeView, ss: [SymId], file: String, line: Int, col: Int,
      name: String, ms: [String]) : Diagnostic =
  mk_diag(SevError, file, line, col, "`#{name}` is not imported in this file",
          [ri_note(file, line, col, "#{nh_class(t, ss)} `#{name}` is declared in #{nh_modules(ms)}"),
           ri_help(file, line, col, nh_help(nh_qualifier(t, v, ss), ms, name))])

#[doc("The error for the type name `name` at `file:line:col`, which nothing declares. The help names the import when a stdlib module declares a type so named, else the one-member sum when the name is the whole body of the alias declaration `alias`.")]
pub(pkg) fn nh_unknown_type_diag(file: String, line: Int, col: Int, name: String, alias: Option[Written]) : Diagnostic =
  mk_diag(SevError, file, line, col, "unknown type `#{name}`",
          match stdlib_type_home(name) {
            Some(h) -> [ri_help(file, line, col, "add `import #{mt_spell_home([], h)}`")]
            None    -> match alias {
              Some(t) -> [ri_help(file, line, col, "to declare a one-member sum, write `type #{t} = | #{name}`")]
              None    -> []
            }
          })

#[doc("The error for a literal at `file:line:col` that writes the stdlib type `t`, in a file that does not import the module declaring it.")]
pub(pkg) fn nh_literal_import_diag(file: String, line: Int, col: Int, t: CoreDeclTy) : Diagnostic =
  mk_diag(SevError, file, line, col,
          "#{nh_literal_form(t)} writes a `#{core_decl_ty_name(t)}`, and this file does not import its module",
          [ri_help(file, line, col, "add `import #{mt_spell_home([], core_decl_ty_home(t))}`")])

fn nh_literal_form(t: CoreDeclTy) : String = match t {
  CdSeq -> "`lazy [...]`"
  _     -> "the `#{core_decl_ty_suffix(t)}` suffix"
}

# A file that already binds the module under a qualifier can name the
# declaration through it; otherwise it has to import the module.
fn nh_help(q: Option[String], ms: [String], name: String) : String = match q {
  Some(qual) -> "qualify it as `#{qual}.#{name}`, or import it with `import #{nh_first(ms)}.{#{name}}`"
  None       -> "import it with `import #{nh_first(ms)}.{#{name}}`, or open the module with `import #{nh_first(ms)}`"
}

fn nh_qualifier(t: SymTab, v: ScopeView, ss: [SymId]) : Option[String] = match ss {
  [] -> None
  [s, ...rest] -> match sv_qualifier(v, sym_owner(t, s)) {
    Some(q) -> Some(q)
    None    -> nh_qualifier(t, v, rest)
  }
}

fn nh_first(ms: [String]) : String = match ms {
  [m, ..._] -> m
  []        -> ""
}

fn nh_class(t: SymTab, ss: [SymId]) : String = match ss {
  [s, ..._] -> ncls_word(sym_class(t, s))
  []        -> "name"
}

fn nh_modules(ms: [String]) : String = match ms {
  [m] -> "module `#{m}`"
  _   -> "modules #{string_join(map(ms, (m) => "`#{m}`"), ", ")}"
}

#[doc("Entries bucketed by the hash of the name each one is about.")]
pub(pkg) type NameIx[a] = NameIx(Array[[a]])

const BUCKETS : Int = 128

#[doc("Empty buckets for a collector to fill with `ni_add`.")]
pub(pkg) fn ni_buckets() : Array[[a]] = array_make(BUCKETS, [])

#[doc("`buckets` with `x` added under `key`.")]
pub(pkg) fn ni_add(buckets: Array[[a]], key: String, x: a) : Array[[a]] / Mutable = {
  let b = ni_slot(key)
  buckets[b] := [x, ...array_get(buckets, b)]
  buckets
}

#[doc("The index over filled buckets.")]
pub(pkg) fn ni_wrap(buckets: Array[[a]]) : NameIx[a] = NameIx(buckets)

#[doc("The bucket holding the entries about `key`. It holds every name that hashes alike, so a consumer re-tests the name of each entry.")]
pub(pkg) fn ni_bucket(ix: NameIx[a], key: String) : [a] = match ix {
  NameIx(buckets) -> array_get(buckets, ni_slot(key))
}

#[doc("`buckets` with `x` added under the id `key`.")]
pub(pkg) fn ni_add_id(buckets: Array[[a]], key: Int, x: a) : Array[[a]] / Mutable = {
  let b = ni_slot_id(key)
  buckets[b] := [x, ...array_get(buckets, b)]
  buckets
}

#[doc("The bucket holding the entries about the id `key`. It holds every id that falls alike, so a consumer re-tests the id of each entry.")]
pub(pkg) fn ni_bucket_id(ix: NameIx[a], key: Int) : [a] = match ix {
  NameIx(buckets) -> array_get(buckets, ni_slot_id(key))
}

fn ni_slot(key: String) : Int = ((string_hash(key) % BUCKETS) + BUCKETS) % BUCKETS

fn ni_slot_id(key: Int) : Int = ((key % BUCKETS) + BUCKETS) % BUCKETS

#[doc("The error for the expression `e` when it is a literal of a stdlib type whose module the file seeing `view` does not import; nothing for any other expression. `file` is the path the error names.")]
pub(pkg) fn suffix_import_diags(e: Expr, view: ScopeView, file: String) : [Diagnostic] =
  match suffix_ty(e) {
    None    -> []
    Some(t) ->
      if sv_imports(view, st_module_id(core_decl_ty_home(t))) { [] }
      else { [nh_literal_import_diag(file, e.line, e.col, t)] }
  }

# The `n` suffix reaches here lowered to a call of the one function a
# file cannot name by id itself, and a `lazy [...]` as the marked parts
# it is built from: the one that opens the literal stands for it.
fn suffix_ty(e: Expr) : Option[CoreDeclTy] = match e.kind {
  EDecimalLit(_) -> Some(CdDecimal)
  ECall(f, _)    -> match f.kind {
    ESym(s, _)          -> if sym_raw(s) == sym_raw(core_bigint_literal_fn()) { Some(CdBigInt) } else { None }
    EMark(MkLazy(head)) -> if head { Some(CdSeq) } else { None }
    _                   -> None
  }
  _              -> None
}
