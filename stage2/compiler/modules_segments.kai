#[doc("The rewrites and checks run per import segment, and the diagnostics of qualified types and unstable exports.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.symtab
import compiler.fn_index
import compiler.diag
import compiler.diag_file
import compiler.module_table
import compiler.expr_positions
import compiler.written
import compiler.util
import compiler.modules_qualtype
import compiler.modules
import compiler.modules_homes
import compiler.refine_types
import compiler.lex
import compiler.parse_decls
import compiler.modules_paths

# The per-file `(mod_name, decls)` split. The driver's core loader
# builds one `PSeg` per core file so the privacy validator can treat
# each file as its own home module — without it the flat decl append
# loses the boundary between files and a decl at the head of one file
# inherits the previous file's module.
pub(pkg) type CoreSegment = PSeg(String, [Decl])

# A (module, decl-count) mark the import resolver records as each
# imported module's decls join the flat stream, so the privacy
# validator can slice the stream back into per-module segments. The
# root file's own decls follow the last mark.
pub(pkg) type ImportSeg = ISeg(String, Int)

# Segment-aware variants of the qualifier passes. The flat decl stream
# mixes modules, and a qualifier only means what the file that wrote it
# declared, so each segment resolves under its own module's imports
# instead of one shared table.
pub(pkg) fn rqc_segmented(segs: [ImportSeg], decls: [Decl], tabs: ModTables, fx: [RqcFx], df: DiagFiles)
      : [Decl] / Console + File = match segs {
  # Past the marks lie the root file's own decls, which resolve
  # through the root scope (recorded under "").
  [] -> rqc_decls(decls, mtabs_of(tabs, "").entries, fx, df)
  [ISeg(home, n), ...rest] -> {
    let mt = mtabs_of(tabs, home).entries
    list_append(rqc_decls(seg_take(decls, n), mt, fx, df),
                rqc_segmented(rest, seg_drop(decls, n), tabs, fx, df))
  }
}

pub(pkg) fn qualtype_segmented(segs: [ImportSeg], decls: [Decl], tab: SymTab, tabs: ModTables,
      imps: [ModImports]) : QualTyped =
  qualtype_seg_loop(segs, decls, tab, tabs, imps, qualtype_list_homes(tab))

fn qualtype_seg_loop(segs: [ImportSeg], decls: [Decl], tab: SymTab, tabs: ModTables,
      imps: [ModImports], homes: [SymId]) : QualTyped = match segs {
  [] -> qualtype_decls(decls, tab, qualtype_scoped(tab, mtabs_of(tabs, "").entries, Some(tab.root), imports_of_owner(imps, ""), homes))
  [ISeg(home, n), ...rest] -> {
    let mt = qualtype_scoped(tab, mtabs_of(tabs, home).entries, st_module(tab, home), imports_of_owner(imps, home), homes)
    let here = qualtype_decls(seg_take(decls, n), tab, mt)
    let more = qualtype_seg_loop(rest, seg_drop(decls, n), tab, tabs, imps, homes)
    QualTyped { decls: list_append(here.decls, more.decls), rows: list_append(here.rows, more.rows) }
  }
}

fn imports_of_owner(imps: [ModImports], owner: String) : [String] = match imps {
  [] -> []
  [MImp(o, names), ...rest] -> if o == owner { names } else { imports_of_owner(rest, owner) }
}

# Only `EMatch` arms and `EBlock` lets carry patterns after lowering;
# every other position descends through `xp_positions`.
#[doc("One diagnostic per qualified variant pattern whose module is not imported or does not export the constructor.")]
pub(pkg) fn pqchk_decls(ds: [Decl], mt: [ModuleEntry], df: DiagFiles) : [Diagnostic] = match ds {
  [] -> []
  [d, ...rest] -> {
    let cx = PqCx { d: d, mt: mt, df: df }
    list_append(list_append(pqchk_exprs(decl_preds(d), cx), pqchk_exprs(decl_exprs(d), cx)), pqchk_decls(rest, mt, df))
  }
}

# The diagnostic file is read off the decl only when a diagnostic is made.
type PqCx = { d: Decl, mt: [ModuleEntry], df: DiagFiles }

fn pqchk_exprs(es: [Expr], cx: PqCx) : [Diagnostic] = match es {
  [] -> []
  [e, ...rest] -> list_append(pqchk_expr(e, cx), pqchk_exprs(rest, cx))
}

fn pqchk_expr(e: Expr, cx: PqCx) : [Diagnostic] = {
  let own = match e.kind {
    EMatch(_, arms)  -> pqchk_arms(arms, cx)
    EBlock(stmts, _) -> list_append(pqchk_stmts(stmts, cx), pqchk_exprs(expr_preds(e), cx))
    ELambda(_, _)    -> pqchk_exprs(expr_preds(e), cx)
    EHandle(_, _, _, _, _, _, _) -> pqchk_exprs(expr_preds(e), cx)
    _ -> []
  }
  list_append(own, pqchk_positions(xp_positions(e), cx))
}

fn pqchk_positions(ps: [XPos], cx: PqCx) : [Diagnostic] = match ps {
  [] -> []
  [XP(_, e), ...rest] -> list_append(pqchk_expr(e, cx), pqchk_positions(rest, cx))
}

fn pqchk_arms(arms: [Arm], cx: PqCx) : [Diagnostic] = match arms {
  [] -> []
  [Arm(pat, _, _), ...rest] -> list_append(pqchk_pat(pat, cx), pqchk_arms(rest, cx))
}

fn pqchk_stmts(stmts: [Stmt], cx: PqCx) : [Diagnostic] = match stmts {
  [] -> []
  [SLet(pat, _, _), ...rest] -> list_append(pqchk_pat(pat, cx), pqchk_stmts(rest, cx))
  [_, ...rest] -> pqchk_stmts(rest, cx)
}

fn pqchk_pat(pat: Pattern, cx: PqCx) : [Diagnostic] = match pat.pkind {
  PVariant(r, subs)     -> list_append(pqchk_ref(r, cx, pat), pqchk_pats(subs, cx))
  PVariantRecord(r, fs) -> list_append(pqchk_ref(r, cx, pat), pqchk_pfields(fs, cx))
  PRecord(fs)           -> pqchk_pfields(fs, cx)
  PList(subs, _)        -> pqchk_pats(subs, cx)
  PAs(_, inner)         -> pqchk_pat(inner, cx)
  _ -> []
}

fn pqchk_ref(r: DeclRef, cx: PqCx, pat: Pattern) : [Diagnostic] = match r {
  DrWritten(Some(q), n) -> pqchk_qualifier(written_text(q), written_text(n), cx, pat)
  _                     -> []
}

fn pqchk_qualifier(q: String, ctor: String, cx: PqCx, pat: Pattern) : [Diagnostic] =
  match mt_lookup_member(cx.mt, q, ctor) {
    Some(me) -> if me_has_export(me, ctor) { [] } else {
      [mk_diag(SevError, decl_diag_file(cx.d, cx.df), pat.line, pat.col, missing_export_msg(q, ctor, me_exports(me)), [])]
    }
    None -> {
      let file = decl_diag_file(cx.d, cx.df)
      [mk_diag(SevError, file, pat.line, pat.col, concat_all(["cannot find module `", q, "`"]),
               [ri_help(file, pat.line, pat.col, concat_all(["import `", q, "` before qualifying `", ctor, "` with it"]))])]
    }
  }

fn pqchk_pats(ps: [Pattern], cx: PqCx) : [Diagnostic] = match ps {
  [] -> []
  [p, ...rest] -> list_append(pqchk_pat(p, cx), pqchk_pats(rest, cx))
}

fn pqchk_pfields(fs: [PField], cx: PqCx) : [Diagnostic] = match fs {
  [] -> []
  [PField(_, sub, _), ...rest] -> list_append(pqchk_pat(sub, cx), pqchk_pfields(rest, cx))
}

#[doc("`pqchk_decls` over an import-segmented stream, each segment against its own module table.")]
pub(pkg) fn pqchk_segmented(segs: [ImportSeg], decls: [Decl], tabs: ModTables, df: DiagFiles) : [Diagnostic] = match segs {
  [] -> pqchk_decls(decls, mtabs_of(tabs, "").entries, df)
  [ISeg(home, n), ...rest] -> {
    let mt = mtabs_of(tabs, home).entries
    list_append(pqchk_decls(seg_take(decls, n), mt, df),
                pqchk_segmented(rest, seg_drop(decls, n), tabs, df))
  }
}

#[doc("`qtchk_decls` over an import-segmented stream, each segment against its own module table.")]
pub(pkg) fn qtchk_segmented(segs: [ImportSeg], decls: [Decl], tab: SymTab, tabs: ModTables, df: DiagFiles) : [Diagnostic] =
  finalize_diags(qtchk_segs(segs, decls, tab, tabs, df, []))

fn qtchk_segs(segs: [ImportSeg], decls: [Decl], tab: SymTab, tabs: ModTables, df: DiagFiles,
      acc: [Diagnostic]) : [Diagnostic] = match segs {
  [] -> qtchk_decls_onto(decls, tab, mtabs_of(tabs, "").entries, df, acc)
  [ISeg(home, n), ...rest] ->
    qtchk_segs(rest, seg_drop(decls, n), tab, tabs, df,
               qtchk_decls_onto(seg_take(decls, n), tab, mtabs_of(tabs, home).entries, df, acc))
}

#[doc("The first `n` decls of an import segment.")]
pub(pkg) fn seg_take(ds: [Decl], n: Int) : [Decl] =
  if n <= 0 { [] }
  else { match ds {
    [] -> []
    [d, ...rest] -> [d, ...seg_take(rest, n - 1)]
  } }

#[doc("The decls after an import segment's first `n`.")]
pub(pkg) fn seg_drop(ds: [Decl], n: Int) : [Decl] =
  if n <= 0 { ds }
  else { match ds {
    [] -> []
    [_, ...rest] -> seg_drop(rest, n - 1)
  } }

#[doc("The declarations with every `mod.name` their bodies, field defaults and refinement predicates hold rewritten against the module table `mt`.")]
pub(pkg) fn rqc_decls(decls: [Decl], mt: [ModuleEntry], fx: [RqcFx], df: DiagFiles) : [Decl] / Console + File = match decls {

  [] -> []
  [d, ...rest] -> [rqc_decl(d, mt, fx, decl_diag_file(d, df)), ...rqc_decls(rest, mt, fx, df)]
}

fn rqc_decl(d: Decl, mt: [ModuleEntry], fx: [RqcFx], file: String) : Decl / Console + File =
  decl_map_inner(d, (x) => rqc_leaf(x, mt, fx, file))

# Parameters are in scope over a function's body, its signature and a
# check's; every other body starts with none. An impl's methods report
# against the file of the enclosing decl.
fn rqc_leaf(d: Decl, mt: [ModuleEntry], fx: [RqcFx], file: String) : Decl / Console + File = match d {
  DFn(p, n, tp, params, ret, row, body, l, c, mo) -> {
    let ps = fn_param_names(params)
    DFn(p, n, tp, rqc_params(params, [], mt, fx, file), rqc_ty_opt(ret, ps, mt, fx, file), row,
        rqc_expr(body, ps, mt, fx, file), l, c, mo)
  }
  DCheck(n, ps, body, l, c, mo) ->
    DCheck(n, rqc_params(ps, [], mt, fx, file), rqc_expr(body, fn_param_names(ps), mt, fx, file), l, c, mo)
  DImpl(name, proto_args, ty, sub_decls, l, c, tps, isym) ->
    DImpl(name, proto_args, ty, rqc_sub_decls(sub_decls, mt, fx, file), l, c, tps, isym)
  DConst(p, s, ta, body, mo, l, c, nl, nc) ->
    DConst(p, s, rqc_ty(ta, [], mt, fx, file), rqc_expr(body, [], mt, fx, file), mo, l, c, nl, nc)
  DType(p, s, tps, body, l, c, mo, xs) -> {
    let ts = body_types(body)
    let typed = if tys_refined(ts) { DType(p, s, tps, body_with_types(body, rqc_tys(ts, [], mt, fx, file)), l, c, mo, xs) } else { d }
    decl_map_exprs(typed, (x) => rqc_expr(x, [], mt, fx, file))
  }
  DEffect(p, s, tps, ops, dblk, l, c, mo) ->
    DEffect(p, s, tps, rqc_effect_ops(ops, mt, fx, file), dblk, l, c, mo)
  _ -> decl_map_exprs(d, (x) => rqc_expr(x, [], mt, fx, file))
}

# An operation's parameters are in scope of its own signature only.
fn rqc_effect_ops(ops: [EffectOp], mt: [ModuleEntry], fx: [RqcFx], file: String) : [EffectOp] / Console + File = match ops {
  [] -> []
  [EffOp(n, tps, ps, ret, l, c), ...rest] ->
    [EffOp(n, tps, rqc_params(ps, [], mt, fx, file), rqc_ty(ret, fn_param_names(ps), mt, fx, file), l, c),
     ...rqc_effect_ops(rest, mt, fx, file)]
}

fn rqc_sub_decls(decls: [Decl], mt: [ModuleEntry], fx: [RqcFx], file: String) : [Decl] / Console + File = match decls {
  [] -> []
  [d, ...rest] -> [rqc_decl(d, mt, fx, file), ...rqc_sub_decls(rest, mt, fx, file)]
}

fn import_hole_known_stdlib() : [String] = [
  "core", "actor", "effects", "loop", "protocols", "reader",
  "spawn", "writer"
]

# Try to load a module's source from the search paths and return the
# list of `pub fn name` identifiers it exports. Returns an empty
# list if the module cannot be opened — the caller treats that as
# "no candidate from this path".
fn import_hole_pub_fns(base_dir: String, mod_path: String,
                         search_paths: [String]) : [String] / File + Console {

  let cf = find_module_file(base_dir, mod_path, search_paths)
  match cf {
    CF(path, opt_src) -> match opt_src {
      None      -> []
      Some(src) -> {
        let toks = tokenize(src)
        let parsed = parse_program_unchecked(mod_path, src, toks, module_name_of_path(path))
        match parsed.decls {
          None -> []
          Some(decls) -> import_hole_collect_pub_fns(decls, st_of_entries(parsed.names), [])
        }
      }
    }
  }
}

fn import_hole_collect_pub_fns(ds: [Decl], tab: SymTab, acc: [String]) : [String] {
  match ds {
    [] -> list_reverse(acc)
    [d, ...rest] -> match decl_transparent_inner(d) {
      Some(inner) -> import_hole_collect_pub_fns([inner, ...rest], tab, acc)
      None -> match d {
        DFn(true, fid, _, _, _, _, _, _, _, _) ->
          import_hole_collect_pub_fns(rest, tab, [written_text(sym_name(tab, fnid_sym(fid))), ...acc])
        _ -> import_hole_collect_pub_fns(rest, tab, acc)
      }
    }
  }
}

# A single "module exports name" hit.
type ImportHoleHit = IHH(String, String)

fn import_hole_search_modules(target: String, base_dir: String,
                                 mods: [String], search_paths: [String],
                                 acc: [ImportHoleHit]) : [ImportHoleHit] / File + Console {

  match mods {
    [] -> list_reverse(acc)
    [m, ...rest] -> {
      let pubs = import_hole_pub_fns(base_dir, m, search_paths)
      if list_has(pubs, target) {
        import_hole_search_modules(target, base_dir, rest, search_paths,
                                      [IHH(m, target), ...acc])
      } else {
        import_hole_search_modules(target, base_dir, rest, search_paths, acc)
      }
    }
  }
}

# Also walk the modules the user already imported in this file
# (regular DImport with IkPath / IkAlias / IkSelective).
fn import_hole_explicit_paths(decls: [Decl], acc: [String]) : [String] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DImport(ik, _, _) -> match ik {
        IkPath(p)         -> import_hole_explicit_paths(rest, [p, ...acc])
        IkAlias(p, _)     -> import_hole_explicit_paths(rest, [p, ...acc])
        IkSelective(p, _) -> import_hole_explicit_paths(rest, [p, ...acc])
        IkHole(_)         -> import_hole_explicit_paths(rest, acc)
      }
      _ -> import_hole_explicit_paths(rest, acc)
    }
  }
}

#[doc("The error for every `import ?name` hole in `decls`, in source order: a hole never resolves, it reports the modules that export the name.")]
pub(pkg) fn import_hole_diags(file: String, decls: [Decl], base_dir: String,
                         search_paths: [String]) : [Diagnostic] / Console + File {
  let explicit = import_hole_explicit_paths(decls, [])
  # Combine stdlib + user-explicit module paths, deduped by name.
  let all_mods = list_uniq(list_append(import_hole_known_stdlib(), explicit))
  finalize_diags(import_hole_diags_loop(file, decls, base_dir, all_mods, search_paths, []))
}

fn import_hole_diags_loop(file: String, decls: [Decl], base_dir: String,
                          mods: [String], search_paths: [String],
                          acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match decls {
    [] -> acc
    [d, ...rest] -> match d {
      DImport(ik, line, col) -> match ik {
        IkHole(name) -> {
          let hits = import_hole_search_modules(name, base_dir, mods,
                                                   search_paths, [])
          import_hole_diags_loop(file, rest, base_dir, mods, search_paths,
                                 [import_hole_diag(file, name, line, col, hits), ...acc])
        }
        _ -> import_hole_diags_loop(file, rest, base_dir, mods, search_paths, acc)
      }
      _ -> import_hole_diags_loop(file, rest, base_dir, mods, search_paths, acc)
    }
  }
}

fn import_hole_diag(file: String, name: String, line: Int, col: Int,
                    hits: [ImportHoleHit]) : Diagnostic {
  let help = (msg) => ri_help(file, line, col, msg)
  match hits {
    [] ->
      mk_diag(SevError, file, line, col, "import hole: no module exports `#{name}`",
        [help("the symbol-index v1 only scans well-known stdlib modules and modules already imported by name in this file"),
         ri_note(file, line, col, "add an `import some.module` for the file that exports `#{name}`, then replace the hole if you still want the report")])
    [IHH(mod_path, _)] ->
      mk_diag(SevError, file, line, col, "import hole: `#{name}` is exported by `#{mod_path}`",
        [help("replace `?#{name}` with `#{mod_path}` (the import then loads the module and exposes `#{name}`)")])
    _ ->
      mk_diag(SevError, file, line, col, "import hole: `#{name}` is exported by multiple modules",
        list_append(map(hits, (h) => match h { IHH(mod_path, _) -> ri_note(file, line, col, "candidate: `#{mod_path}`") }),
                    [help("replace `?#{name}` with one of the explicit module paths above")]))
  }
}

# Strip every DUse and IkHole DImport from the decl stream after
# the diagnostic pass runs. Downstream passes never see them.
pub(pkg) fn strip_import_holes(decls: [Decl], acc: [Decl]) : [Decl] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DImport(ik, _, _) -> match ik {
        IkHole(_) -> strip_import_holes(rest, acc)
        _         -> strip_import_holes(rest, [d, ...acc])
      }
      _ -> strip_import_holes(rest, [d, ...acc])
    }
  }
}

fn qualtype_member(c: SymId, tab: SymTab, mt: [ModuleEntry]) : SymId =
  match split_dotted_qualifier(written_text(sym_name(tab, c))) {
    None -> c
    Some(QSplit(mod, ty)) -> match qualtype_member_row(mod, ty, c, tab, mt) {
      NEnt(cls, name, home, _, _) -> sym_derive(cls, name, home)
    }
  }

# The row of the constructor the union member `mod.ty` is re-pointed to:
# the bare member homed at the module it names, so two members spelled
# alike under different qualifiers stay two constructors and each leads
# to its own module's type. A member `mod` does not export goes under the
# unresolvable name in the union's own module.
fn qualtype_member_row(mod: String, ty: String, c: SymId, tab: SymTab, mt: [ModuleEntry]) : NEnt =
  if qualtype_exported(mod, ty, mt) { NEnt(NCCtor, ty, mt_member_home(mt, mod, ty), sym_exported(tab, c), sym_mint(tab, c)) }
  else { NEnt(NCCtor, qualtype_unresolvable(), written_text(sym_home(tab, c)), sym_exported(tab, c), sym_mint(tab, c)) }

fn qualtype_variant_rows(vs: [Variant], tab: SymTab, mt: [ModuleEntry], acc: [NEnt]) : [NEnt] = match vs {
  [] -> acc
  [Var(c, _), ...rest] -> match split_dotted_qualifier(written_text(sym_name(tab, c))) {
    Some(QSplit(mod, ty)) -> qualtype_variant_rows(rest, tab, mt, [qualtype_member_row(mod, ty, c, tab, mt), ...acc])
    None                  -> qualtype_variant_rows(rest, tab, mt, acc)
  }
}

# A union member is validated like a type head, at its declaration's
# position: a variant carries none of its own.
fn qtchk_variants(vs: [Variant], tab: SymTab, cx: QtCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match vs {
  [] -> acc
  [Var(m, vargs), ...rest] ->
    qtchk_variants(rest, tab, cx, l, c, qtchk_tes(vargs, cx, qtchk_member(m, tab, cx, l, c, acc)))
}

fn qtchk_member(m: SymId, tab: SymTab, cx: QtCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] =
  match split_dotted_qualifier(written_text(sym_name(tab, m))) {
    None                  -> acc
    Some(QSplit(mod, ty)) -> qtchk_site(mod, ty, cx, l, c, acc)
  }

fn qtchk_fields(fs: [FieldDecl], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match fs {
  []                         -> acc
  [FD(_, _, te, _), ...rest] -> qtchk_fields(rest, cx, qtchk_te(te, cx, acc))
}

fn qtchk_body(tb: TypeBody, tab: SymTab, cx: QtCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match tb {
  TBAlias(te)      -> qtchk_te(te, cx, acc)
  TBRecord(fs)     -> qtchk_fields(fs, cx, acc)
  TBSum(vs)        -> qtchk_variants(vs, tab, cx, l, c, acc)
  TBEffectAlias(_) -> acc
}

fn qtchk_eops(ops: [EffectOp], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match ops {
  [] -> acc
  [EffOp(_, _, ps, ret, _, _), ...rest] -> qtchk_eops(rest, cx, qtchk_te(ret, cx, qtchk_params(ps, cx, acc)))
}

fn qtchk_pops(ops: [ProtoOp], cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match ops {
  [] -> acc
  [POp(_, _, ps, ret, _, _), ...rest] -> qtchk_pops(rest, cx, qtchk_te(ret, cx, qtchk_params(ps, cx, acc)))
}

# Every variant is named, as in the rewrite: the two read the same
# positions in the same order.
fn qtchk_decl(d: Decl, tab: SymTab, cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match d {
  DFn(_, _, _, ps, ret, row, body, _, _, _) ->
    qtchk_expr(body, cx, qtchk_row(row, cx, qtchk_te_opt(ret, cx, qtchk_params(ps, cx, acc))))
  DType(_, _, _, body, l, c, _, _)   -> qtchk_body(body, tab, cx, l, c, acc)
  DEffect(_, _, _, ops, _, _, _, _)  -> qtchk_eops(ops, cx, acc)
  DProtocol(_, _, _, ops, _, _, _)   -> qtchk_pops(ops, cx, acc)
  DImpl(_, pargs, ty, subs, _, _, _, _) ->
    qtchk_sub_decls(subs, tab, cx, qtchk_te(ty, cx, qtchk_tes(pargs, cx, acc)))
  DAxiom(_, _, _, _, _, ps, ret, row, _, _) ->
    qtchk_row(row, cx, qtchk_te(ret, cx, qtchk_params(ps, cx, acc)))
  DConst(_, _, ty, body, _, _, _, _, _)    -> qtchk_expr(body, cx, qtchk_te(ty, cx, acc))
  DTest(_, body, _, _, _)            -> qtchk_expr(body, cx, acc)
  DBench(_, body, _, _, _)           -> qtchk_expr(body, cx, acc)
  DCheck(_, ps, body, _, _, _)       -> qtchk_expr(body, cx, qtchk_params(ps, cx, acc))
  DDerive(_, inner, _, _)            -> qtchk_decl(inner, tab, cx, acc)
  DUnstable(inner, _, _)             -> qtchk_decl(inner, tab, cx, acc)
  DProtoLaws(_, inner, _, _, _)      -> qtchk_decl(inner, tab, cx, acc)
  DImplAxiom(_, inner, _, _, _)      -> qtchk_decl(inner, tab, cx, acc)
  DConstructor(inner, _, _)          -> qtchk_decl(inner, tab, cx, acc)
  DDoc(_, _, inner, _, _)            -> qtchk_decl(inner, tab, cx, acc)
  DAttr(_, inner, _, _)              -> qtchk_decl(inner, tab, cx, acc)
  DImport(_, _, _)                   -> acc
  DUnit(_, _, _, _, _, _, _)         -> acc
  DUse(_, _, _)                      -> acc
  DUseKind(_, _, _, _)               -> acc
  DModuleDoc(_, _, _, _)             -> acc
  DExternType(_, _, _, _, _, _)         -> acc
  DTheory(_, _, _, _, _)             -> acc
  DKind(_, _, _, _, _, _, _, _)      -> acc
}

# An impl's methods are reported against the file of the impl.
fn qtchk_sub_decls(ds: [Decl], tab: SymTab, cx: QtCx, acc: [Diagnostic]) : [Diagnostic] = match ds {
  []           -> acc
  [d, ...rest] -> qtchk_sub_decls(rest, tab, cx, qtchk_decl(d, tab, cx, acc))
}

#[doc("The diagnostics of every qualified type head of `ds` that names no module `mt` binds or no type it exports, in source order. Each is reported against the file that declares it.")]
pub(pkg) fn qtchk_decls(ds: [Decl], tab: SymTab, mt: [ModuleEntry], df: DiagFiles) : [Diagnostic] =
  finalize_diags(qtchk_decls_onto(ds, tab, mt, df, []))

fn qtchk_decls_onto(ds: [Decl], tab: SymTab, mt: [ModuleEntry], df: DiagFiles, acc: [Diagnostic]) : [Diagnostic] = match ds {
  []           -> acc
  [d, ...rest] -> qtchk_decls_onto(rest, tab, mt, df, qtchk_decl(d, tab, QtCx { mt: mt, file: decl_diag_file(d, df) }, acc))
}

fn qualtype_variants(vs: [Variant], tab: SymTab, mt: [ModuleEntry]) : [Variant] = match vs {

  [] -> []
  [v, ...rest] -> match v {
    Var(c, vargs) -> [Var(qualtype_member(c, tab, mt), qualtype_te_list(vargs, mt)),
                       ...qualtype_variants(rest, tab, mt)]
  }
}

fn qualtype_rows(ds: [Decl], tab: SymTab, mt: [ModuleEntry], acc: [NEnt]) : [NEnt] = match ds {
  [] -> acc
  [d, ...rest] -> qualtype_rows(rest, tab, mt, qualtype_decl_rows(d, tab, mt, acc))
}

fn qualtype_decl_rows(d: Decl, tab: SymTab, mt: [ModuleEntry], acc: [NEnt]) : [NEnt] = match decl_transparent_inner(d) {
  Some(inner) -> qualtype_decl_rows(inner, tab, mt, acc)
  None -> match d {
    DType(_, _, _, TBSum(vs), _, _, _, _) -> qualtype_variant_rows(vs, tab, mt, acc)
    _ -> acc
  }
}

fn qualtype_fields(fs: [FieldDecl], mt: [ModuleEntry]) : [FieldDecl] = match fs {

  [] -> []
  [f, ...rest] -> match f {
    FD(is_pub, name, te, attrs) -> [FD(is_pub, name, qualtype_te(te, mt), attrs), ...qualtype_fields(rest, mt)]
  }
}

fn qualtype_body(tb: TypeBody, tab: SymTab, mt: [ModuleEntry]) : TypeBody = match tb {

  TBAlias(te) -> TBAlias(qualtype_te(te, mt))
  TBRecord(fs) -> TBRecord(qualtype_fields(fs, mt))
  TBSum(vs) -> TBSum(qualtype_variants(vs, tab, mt))
  TBEffectAlias(ls) -> TBEffectAlias(ls)
}

fn qualtype_eops(ops: [EffectOp], mt: [ModuleEntry]) : [EffectOp] = match ops {

  [] -> []
  [op, ...rest] -> match op {
    EffOp(name, tps, ps, ret, l, c) ->
      [EffOp(name, tps, qualtype_params(ps, mt), qualtype_te(ret, mt), l, c),
       ...qualtype_eops(rest, mt)]
  }
}

fn qualtype_pops(ops: [ProtoOp], mt: [ModuleEntry]) : [ProtoOp] = match ops {

  [] -> []
  [op, ...rest] -> match op {
    POp(name, tps, ps, ret, l, c) ->
      [POp(name, tps, qualtype_params(ps, mt), qualtype_te(ret, mt), l, c),
       ...qualtype_pops(rest, mt)]
  }
}

fn qualtype_decl(d: Decl, tab: SymTab, mt: [ModuleEntry]) : Decl = match d {

  DFn(p, n, tps, ps, ret_opt, row, body, l, c, mo) ->
    DFn(p, n, tps, qualtype_params(ps, mt),
        match ret_opt { None -> None Some(te) -> Some(qualtype_te(te, mt)) },
        qualtype_row(row, mt),
        qualtype_expr(body, mt), l, c, mo)
  DType(p, n, tps, body, l, c, mo, slots) ->
    DType(p, n, tps, qualtype_body(body, tab, mt), l, c, mo, slots)
  DEffect(p, n, tps, ops, defblk, l, c, mo) ->
    DEffect(p, n, tps, qualtype_eops(ops, mt), defblk, l, c, mo)
  DProtocol(p, n, tps, ops, l, c, mo) ->
    DProtocol(p, n, tps, qualtype_pops(ops, mt), l, c, mo)
  DImpl(name, proto_args, ty, sub_decls, l, c, tps, isym) ->
    DImpl(name, map(proto_args, (te) => qualtype_te(te, mt)),
          qualtype_te(ty, mt),
          qualtype_sub_decls(sub_decls, tab, mt), l, c, tps, isym)
  DDerive(ps, inner, l, c) ->
    DDerive(ps, qualtype_decl(inner, tab, mt), l, c)
  DUnstable(inner, l, c) ->
    DUnstable(qualtype_decl(inner, tab, mt), l, c)
  DProtoLaws(thy, inner, l, c, mo) ->
    DProtoLaws(thy, qualtype_decl(inner, tab, mt), l, c, mo)
  DImplAxiom(thy, inner, l, c, mo) ->
    DImplAxiom(thy, qualtype_decl(inner, tab, mt), l, c, mo)
  DConstructor(inner, l, c) ->
    DConstructor(qualtype_decl(inner, tab, mt), l, c)
  DAxiom(p, sm, n, cso, tps, ps, ret, row, l, c) ->
    DAxiom(p, sm, n, cso, tps, qualtype_params(ps, mt),
            qualtype_te(ret, mt), qualtype_row(row, mt), l, c)
  # Rewrite the declared type's qualifiers and the body
  # expression. `lower_consts` runs before this in the driver, but
  # the arm exists for completeness so any pre-lowering caller (e.g.
  # `--ast` of a future entry point) does not blow up. Mirrors what
  # the DFn arm above does for the body + return type.
  DConst(p, n, ty, body, mo, l, c, nl, nc) ->
    DConst(p, n, qualtype_te(ty, mt),
            qualtype_expr(body, mt), mo, l, c, nl, nc)
  DTest(n, body, l, c, mo) -> DTest(n, qualtype_expr(body, mt), l, c, mo)
  DBench(n, body, l, c, mo) -> DBench(n, qualtype_expr(body, mt), l, c, mo)
  DCheck(n, ps, body, l, c, mo) ->
    DCheck(n, qualtype_params(ps, mt), qualtype_expr(body, mt), l, c, mo)
  DImport(ik, l, c) -> DImport(ik, l, c)
  DUnit(p, n, opt, intro, l, c, mo) -> DUnit(p, n, opt, intro, l, c, mo)
  DUse(eff, l, c) -> DUse(eff, l, c)
  DUseKind(k, l, c, mo) -> DUseKind(k, l, c, mo)
  # The root file's module-doc carrier rides the stream
  # until the typer lifts it into TypedProgram.module_doc; it has no
  # types to qualify.
  DDoc(raw, text, inner, l, c) -> DDoc(raw, text, qualtype_decl(inner, tab, mt), l, c)
  DAttr(raw, inner, l, c) -> DAttr(raw, qualtype_decl(inner, tab, mt), l, c)
  DModuleDoc(raw, text, l, c) -> DModuleDoc(raw, text, l, c)
  # FFI v2: a foreign type's fields are fixed-width / nested foreign
  # names that resolve nominally — nothing to qualify.
  DExternType(pb, name, body, l, c, mo) -> DExternType(pb, name, body, l, c, mo)
  # catalog decls carry no qualifiable type heads; stripped pre-resolve.
  DTheory(n, props, l, c, mo) -> DTheory(n, props, l, c, mo)
  DKind(p, n, th, ov, intro, l, c, mo) -> DKind(p, n, th, ov, intro, l, c, mo)
}

pub(pkg) type QualTyped = { decls: [Decl], rows: [NEnt] }

#[doc("Re-qualify every qualified type head of `decls` against `mt`; a head that names no exported type is left unresolvable for `qtchk_decls` to report. `tab` holds the rows of `decls`; the caller extends it with the rows returned.")]
pub(pkg) fn qualtype_decls(decls: [Decl], tab: SymTab, mt: [ModuleEntry]) : QualTyped =
  QualTyped { decls: qualtype_sub_decls(decls, tab, mt), rows: qualtype_rows(decls, tab, mt, []) }

#[doc("`qualtype_decls` without the rows.")]
pub(pkg) fn qualtype_decls_only(decls: [Decl], tab: SymTab, mt: [ModuleEntry]) : [Decl] = qualtype_sub_decls(decls, tab, mt)

fn qualtype_sub_decls(decls: [Decl], tab: SymTab, mt: [ModuleEntry]) : [Decl] = match decls {
  [] -> []
  [d, ...rest] -> [qualtype_decl(d, tab, mt), ...qualtype_sub_decls(rest, tab, mt)]
}

# Walk every Decl body's EModCall sites and emit a
# diagnostic for any call to a `#unstable` export from a package
# the consumer has not opted into. Pure post-pass — runs AFTER
# `rqc_decls` has lifted `EField(EName(mod), fn)` into
# `EModCall(mod, fname)` so we have a uniform shape to scan.
#
# Suppression rules:
#   1. `mod == pkg` — the consumer is touching their own module;
#      never warn on self-imports.
#   2. `mod ∈ optins` — the consumer added `mod = true` under
#      `[unstable]` in their kai.toml.
#   3. The module is unknown to `mt` (corner case — should not
#      happen by the time rqc runs, but be defensive). Skip.
#   4. The fname is not in the module's `unstable_exports` list.
#      The vast majority of imports.
#
# Otherwise emit a warning anchored at the call site, naming the
# `<mod>.<fname>` pair and the opt-in instruction. The diagnostic
# is non-fatal; downstream codegen proceeds as usual.
pub(pkg) fn unstable_check_decls(ds: [Decl], mt: [ModuleEntry],
                          pkg: String, optins: [String], df: DiagFiles) : [Diagnostic] =
  flat_map(ds, (d) => {
    let file = decl_diag_file(d, df)
    list_append(unstable_check_exprs(decl_preds(d), mt, pkg, optins, file),
                unstable_check_exprs(decl_exprs(d), mt, pkg, optins, file))
  })

fn unstable_check_exprs(es: [Expr], mt: [ModuleEntry], pkg: String,
                          optins: [String], file: String) : [Diagnostic] =
  flat_map(es, (x) => unstable_check_expr(x, mt, pkg, optins, file))

fn unstable_check_expr(e: Expr, mt: [ModuleEntry], pkg: String,
    optins: [String], file: String) : [Diagnostic] = {
  let here = match e.kind {
    EModCall(m, f) -> unstable_call_diag(written_text(m), written_text(f), e, mt, pkg, optins, file)
    ELambda(_, _) -> unstable_check_exprs(expr_preds(e), mt, pkg, optins, file)
    EHandle(_, _, _, _, _, _, _) -> unstable_check_exprs(expr_preds(e), mt, pkg, optins, file)
    EBlock(_, _) -> unstable_check_exprs(expr_preds(e), mt, pkg, optins, file)
    _ -> []
  }
  list_append(here, unstable_check_children(xp_positions(e), mt, pkg, optins, file))
}

fn unstable_check_children(ps: [XPos], mt: [ModuleEntry], pkg: String,
    optins: [String], file: String) : [Diagnostic] =
  flat_map(ps, (p) => match p { XP(_, c) -> unstable_check_expr(c, mt, pkg, optins, file) })

fn unstable_call_diag(mod: String, fname: String, e: Expr, mt: [ModuleEntry], pkg: String,
    optins: [String], file: String) : [Diagnostic] =
  if mod == pkg or list_has(optins, mod) { [] }
  else {
    match mt_lookup(mt, mod) {
      None -> []
      Some(me) ->
        if me_export_is_unstable(me, fname) {
          [mods_diag_warning(file, e.line, e.col,
            concat_all([mod, ".", fname,
                        " is #[unstable] — API may change between versions without an edition bump. ",
                        "Add '", mod, " = true' under [unstable] in kai.toml to acknowledge."]))]
        } else { [] }
    }
  }
