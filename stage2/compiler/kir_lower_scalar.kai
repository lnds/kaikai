#[doc("Lowering helpers for fixed-size vectors, scalar borders, cells, loop conditions, captures and variant tables.")]

import compiler.ast
import compiler.ast_ids
import compiler.ast_ids
import compiler.emit_shared_fv
import compiler.fnreg
import compiler.infer_env
import compiler.infer_glue
import compiler.infer_state
import compiler.kinds
import compiler.kir
import compiler.kir_lower
import compiler.kir_lower_raw
import compiler.kir_syms
import compiler.raw_border
import compiler.real_lit
import compiler.symtab
import compiler.util
import compiler.written
import compiler.kir_lower_sig

# The read prim for a base in `mode`: an inline `[n x elem]` aggregate (what
# the unbox pass marks `MUnboxed`) is GEP'd directly; anything else already
# crossed the boxed border and is a dynamic heap vec, whose slot is reached
# through the runtime.
pub(pkg) fn fixed_vec_get_prim(mode: ValueMode, raw: Bool, dyn: Bool, elem: Ty, n: Int) : PrimOp = {
  let heap = match mode {
    MUnboxed -> false
    _        -> true
  }
  KpFixedVecGet(KVecRead { heap: heap, raw: raw, dyn: dyn }, fixed_vec_elem_scalar(elem), n)
}

pub(pkg) fn fixed_vec_idx_atom(i: Expr) : KVal = match i.kind {
  EInt(k, _) -> KIntV(k)
  _       -> KIntV(0)
}

# The element scalar a fixed-vec prim carries.
pub(pkg) fn fixed_vec_elem_scalar(t: Ty) : RawScalar = match t {
  TyReal   -> RwReal
  TyInt    -> RwInt
  TyBool   -> RwBool
  TyChar   -> RwChar
  TyByte   -> RwByte
  TyInt32  -> RwInt32
  TyUInt32 -> RwUInt32
  TyUInt64 -> RwUInt64
  _        -> RwInt
}

# The atom-accumulating result of the element walk.
pub(pkg) type LRes2 = LRes2([KVal], LowerSt)

# --- The Expr walk ------------------------------------------------------
#
# The program/fn-level orchestration (`lower_to_kir`, the per-decl walk,
# and the lifted `KFnLambda` / `KFnClause` generation) lives in
# `kir_lower_fns.kai` — it drives ON `lower_expr` but `lower_expr` never
# calls back, so the split keeps the import graph acyclic and each file
# within the size cap. This module is the Expr-SCC: the mutual recursion
# `lower_expr ↔ lower_call ↔ lower_if/match/handle/list/...`.

# An INLINE fixed-vec value in boxed position — a header-less `[n x elem]`
# aggregate where the consumer wants a `KaiValue *`, so it must materialise.
# The predicate is `MUnboxed` + a fixed-vec type and nothing else: that pair
# IS the record that the value holds the inline form, and it holds for a
# LITERAL as much as for a read of an inline binder. Gating on the node shape
# instead would store the bare aggregate pointer into a boxed slot — a value
# with no `KaiValue` header, which every later read type-confuses.
# `__fixed_vec_get` reads its base through `lower_expr_boxed`, so a static
# read never reaches here and stays heap-free.
pub(pkg) fn fixed_vec_needs_materialize(x: Expr) : Bool =
  match x.mode {
    MUnboxed -> ty_is_fixed_vec_opt(x.ty)
    _        -> false
  }

# A `let` RHS whose binder itself holds the inline form crosses no boxed
# border: an alias between two inline binders, or the literal that CREATES
# one. Both must stay inline — materialising here would leave the binder a
# dynamic vec while its own reads still index it as an aggregate.
pub(pkg) fn fixed_vec_alias_rhs(rhs: Expr) : Bool =
  fixed_vec_needs_materialize(rhs) and
  match rhs.kind {
    ELocal(_)      -> true
    ESym(_, _)     -> true
    ECall(f, _)    -> match f.kind { EMark(MkFixedVecLit) -> true  _ -> false }
    _              -> false
  }

# Loud trap for an AST node the lowering does not yet cover but codegen
# does. Prints the kind + position to stderr and lowers to unit so the
# dump still completes; the parity gate (not "no panic") is what catches
# the divergence. Replaces the old silent catch-all (Lane 0 gap).
pub(pkg) fn lower_unhandled(x: Expr, st: LowerSt) : LRes / Console {
  eprint(concat_all(["kir: unhandled expr kind ", kir_expr_kind_name(x.kind),
                     " at ", int_to_string(x.line), ":", int_to_string(x.col)]))
  LRes(KUnitV, st)
}

# `x` without a `__perceus_dup` wrap, keeping `x`'s type: the inner read
# often carries none.
pub(pkg) fn raw_operand(x: Expr) : Expr = {
  let xb = raw_border_strip_dup(x)
  Expr { kind: xb.kind, line: xb.line, col: xb.col, ty: x.ty, mode: xb.mode,  site: xb.site }
}

pub(pkg) fn border_slot_of(opt_t: Option[Ty]) : KSlot =
  if kir_ty_is_int(opt_t) { SInt64 }
  else if kir_ty_is_bool(opt_t) { SBool }
  else if kir_ty_is_char(opt_t) { SChar }
  else if kir_ty_is_byte(opt_t) { SByte }
  else if kir_ty_is_fixed_raw(opt_t) { kir_fixed_raw_slot(opt_t) }
  else { SReal }

pub(pkg) fn border_unbox_prim(slot: KSlot) : Option[PrimOp] = match slot {
  SInt64  -> Some(KpUnbox(RwInt))
  SReal   -> Some(KpUnbox(RwReal))
  SBool   -> Some(KpUnbox(RwBool))
  SChar   -> Some(KpUnbox(RwChar))
  SByte   -> Some(KpUnbox(RwByte))
  SInt32T -> Some(KpUnbox(RwInt32))
  SUInt32 -> Some(KpUnbox(RwUInt32))
  SUInt64 -> Some(KpUnbox(RwUInt64))
  SInt128 -> Some(KpUnbox(RwInt128))
  _       -> None
}

# Bool and Byte boxes are immortal, so their read owes no release.
pub(pkg) fn release_border_box(x: Expr, slot: KSlot, bv: KVal, st: LowerSt) : LowerSt = match slot {
  SBool -> st
  SByte -> st
  _     -> ls_emit(st, KRC(KDrop(bv), kpos_of(x)))
}

# A promoted var cell's register: its first argument is a read of the
# cell's binder.
pub(pkg) fn lower_cell_reg(iargs: [Expr], st: LowerSt) : String = match iargs {
  [r, ..._] -> match r.kind {
    ELocal(l) -> ls_reg_of(st, l)
    _         -> ""
  }
  [] -> ""
}

pub(pkg) fn cell_slot_of_ty(opt_t: Option[Ty]) : KSlot =
  if kir_ty_is_real(opt_t) { SReal }
  else if kir_ty_is_bool(opt_t) { SBool }
  else { SInt64 }

pub(pkg) fn cell_unbox_prim(slot: KSlot) : PrimOp = match slot {
  SReal -> KpUnbox(RwReal)
  SBool -> KpUnbox(RwBool)
  _     -> KpUnbox(RwInt)
}

pub(pkg) fn loop_cond_is_raw(p: Expr) : Bool =
  if kir_node_is_raw(p) { true }
  else { match p.kind {
    EBlock(stmts, tail) -> match stmts {
      [] -> match tail { Some(t) -> loop_cond_is_raw(t) None -> false }
      _  -> false
    }
    _ -> false
  } }

# A read of a local binder: its register.
pub(pkg) fn lower_local(l: LocalId, st: LowerSt) : LRes = LRes(KVar(ls_reg_of(st, l)), st)

# The per-param type list of a (self-recursing) UFn sig, `[]` when None.
pub(pkg) fn tcrec_ptys_of(sig: Option[UFnSig]) : [Ty] = match sig {
  Some(US(ptys, _, _)) -> ptys
  None -> []
}

# The per-param raw mask of a (self-recursing) UFn sig, `[]` when None.
pub(pkg) fn tcrec_mask_of(sig: Option[UFnSig]) : [Bool] = match sig {
  Some(US(_, _, mask)) -> mask
  None -> []
}

# --- List literals (and interpolation, which desugars to a list) --------

# The cons prim for the current allocation context: the bump-arena ctor
# inside a region, the RC-heap ctor otherwise.
pub(pkg) fn region_cons_prim(st: LowerSt) : PrimOp = if st.in_region { KpArenaCons } else { KpCons }

# `variants[T]()` → a cons spine of nullary constructors, one `KCon` per
# constructor. Built tail-first so evaluation order matches emit_c.
pub(pkg) fn lower_variants_of(ctors: [SymId], pos: KPos, st: LowerSt) : LRes / Console = match ctors {
  [] -> bind_op(st, KPrim(KpNil, []), pos)
  [c, ...rest] ->
    match bind_op(st, ls_nullary_con(st, c), pos) { LRes(hdv, st1) ->
      match lower_variants_of(rest, pos, st1) { LRes(tlv, st2) ->
        bind_op(st2, KPrim(KpCons, [hdv, tlv]), pos) } }
}

# The value of the nullary constructor `c`; one the table lays out no row
# for keeps tag 0 under its declared name.
fn ls_nullary_con(st: LowerSt, c: SymId) : KOp = match ls_ctor_lay(st, c) {
  Some(lay) -> KCon(lay.name, lay.tag, 0, [], false)
  None      -> KCon(written_text(decl_name(st.tab, c)), 0, 0, [], false)
}

# An inline lambda use-site → a `KClosure` over `lam_symbol` with the
# captures lowered as atoms (each a read of the captured binder in the
# current scope). The `LamInfo` (id, params, caps) is looked up by
# (enclosing-fn, line, col). A miss means the collector and lowering
# disagree on the key — surface it loudly rather than emit a bad closure.
pub(pkg) fn lower_lambda_ref(x: Expr, st: LowerSt) : LRes / Console =
  match find_lam(st.lams, st.enc_fn, x.line, x.col) {
    Some(LamInfo(_, ef, ln, cl, params, caps, _, _)) ->
      match lower_capture_atoms(caps, st, []) { LResMany(capvs, st1) ->
        bind_op(st1, KClosure(lam_symbol_at(ef.sym, ln, cl),
                              list_length(params), capvs), kpos_of(x)) }
    None -> { eprint(concat_all(["kir: lambda info missing at ",
                                 int_to_string(x.line), ":", int_to_string(x.col)]));
              LRes(KUnitV, st) }
  }

# Lower each capture to a read of what it reaches in the enclosing scope:
# a binder's register, or the register holding an alias's handler id.
fn lower_capture_atoms(caps: [Capture], st: LowerSt, acc: [KVal]) : LResMany / Console = match caps {
  [] -> LResMany(acc, st)
  [c, ...rest] -> lower_capture_atoms(rest, st, list_append(acc, [KVar(capture_reg(st, c))]))
}

fn capture_reg(st: LowerSt, c: Capture) : String = match c {
  CapLocal(l) -> ls_reg_of(st, l)
  CapAlias(a) -> kir_alias_id_reg(ls_reg_of(st, a))
}

# --- Blocks -------------------------------------------------------------

# Bind the field-read op to a fresh register (captures the incref'd field
# BEFORE the base is dropped), then drop the owned base — mirror of the C
# oracle's `_f = kai_op_field_at(_b, n); kai_decref(_b)`.
pub(pkg) fn lower_field_read(st: LowerSt, op: KOp, base: KVal, pos: KPos) : LRes / Console =
  match bind_op(st, op, pos) {
    LRes(fv, st1) -> LRes(fv, ls_emit(st1, KRC(KDrop(base), pos)))
  }

# ---- Vec raw element fusion (classifier verdict in vec_raw.kai) -----

# A fused Vec read only borrows the vec, so the read releases it after when
# it owns it: a consuming `vec_get`, or an owned value in the borrowing
# one's slot. The vec stays in flight while the index runs.
pub(pkg) type VecReadArgs = { vv: KVal, iv: KVal, owned: Bool, st: LowerSt }

pub(pkg) fn lower_vec_read_bind(x: Expr, a: VecReadArgs, op: KOp, slot: KSlot) : LRes / Console =
  match bind_op_slot(a.st, op, slot, kpos_of(x)) {
    LRes(rv, st1) -> if a.owned { LRes(rv, ls_emit(st1, KRC(KDrop(a.vv), kpos_of(x)))) }
                     else { LRes(rv, st1) }
  }

# The bare-word writes: every payload is lowered at its raw slot, so no box
# is built; the runtime entry keeps the unique-or-copy decision.
pub(pkg) type LVecFields = LVecFields([VecField], LowerSt)
