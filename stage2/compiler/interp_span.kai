#[doc("""
Raw `#{...}` interpolation spans, as the passes before the lift read them.

An interpolated string is source text until the lift parses its bodies,
which happens before name resolution. A pass that runs earlier and needs
to know what a body mentions splits the span and reads its tokens.
""")]

import compiler.ast
import compiler.fnreg
import compiler.infer
import compiler.lex
import compiler.util

#[doc("The literal and `#{...}` parts of a string span, or `[]` when it interpolates nothing.")]
pub fn isp_parts(span: String, is_triple: Bool) : [IPart] = {
  let n = string_length(span)
  let body_start = if is_triple { 3 } else { 1 }
  let body_end = if is_triple { n - 3 } else { n - 1 }
  if has_interp(span, body_start, body_end) {
    iscan_collect(span, body_end, IScan { parts: [], lit_start: body_start, i: body_start })
  } else { [] }
}

#[doc("Identifier tokens spelled `name` inside the `#{...}` parts of a string span. Lexical: a field or a binder of the body spelled so counts too.")]
pub fn isp_ident_count(name: String, span: String, is_triple: Bool) : Int =
  isp_count_parts(name, isp_parts(span, is_triple))

fn isp_count_parts(name: String, parts: [IPart]) : Int = match parts {
  []           -> 0
  [p, ...rest] -> isp_count_parts(name, rest) + match p {
    IpLit(_, _) -> 0
    IpExp(esrc) -> isp_count_toks(name, esrc, tokenize(esrc))
  }
}

fn isp_count_toks(name: String, esrc: String, toks: [Token]) : Int = match toks {
  []           -> 0
  [t, ...rest] -> isp_count_toks(name, esrc, rest) + match t.kind {
    TkIdent -> if string_slice(esrc, t.start, t.length) == name { 1 } else { 0 }
    _       -> 0
  }
}
