#[doc("""
The scope the type-parameter binding pass resolves a written name in.

This is the one place a type parameter is found by its spelling: the
scope maps what the source wrote to the binder it means, innermost
declaration first, and collects the names a signature binds without
listing them.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.written
import compiler.util
import compiler.chars
import compiler.type_text

#[doc("The type parameters in scope, outermost first, and the id `Self` has inside a protocol (unnumbered elsewhere).")]
pub type TScope = { bs: [TBinder], self_id: TLocalId }

#[doc("A scope binding nothing.")]
pub fn tsc_empty() : TScope = TScope { bs: [], self_id: tlocal_none() }

#[doc("A scope binding `bs`.")]
pub fn tsc_of(bs: [TBinder]) : TScope = TScope { bs: bs, self_id: tlocal_none() }

#[doc("`sc` with `bs` bound inside it: each shadows an outer parameter of the same name.")]
pub fn tsc_add(sc: TScope, bs: [TBinder]) : TScope =
  TScope { bs: list_append(sc.bs, bs), self_id: sc.self_id }

#[doc("`sc` inside a protocol whose `Self` is `id`.")]
pub fn tsc_with_self(sc: TScope, id: TLocalId) : TScope = TScope { bs: sc.bs, self_id: id }

#[doc("True when the scope binds nothing, so no type under it can mention a parameter.")]
pub fn tsc_is_empty(sc: TScope) : Bool = list_is_empty(sc.bs) and tlocal_raw(sc.self_id) == 0

#[doc("True when the scope binds a unit-kind parameter, the only kind a unit expression can mention.")]
pub fn tsc_binds_unit(sc: TScope) : Bool = any(sc.bs, tb_is_unit)

#[doc("Binders numbered from a seed, and the next free position.")]
pub type TNumbered = { bs: [TBinder], next: Int }

#[doc("`tps` numbered from position `from` of the declaration seeded `seed`. A binder that already carries an id keeps it.")]
pub fn tsc_number(tps: [TBinder], seed: Int, from: Int) : TNumbered = tsc_number_loop(tps, seed, from, [])

fn tsc_number_loop(tps: [TBinder], seed: Int, i: Int, acc: [TBinder]) : TNumbered = match tps {
  []           -> TNumbered { bs: list_reverse(acc), next: i }
  [b, ...rest] -> tsc_number_loop(rest, seed, i + 1, [tsc_numbered(b, tlocal_seeded(seed, i)), ...acc])
}

fn tsc_numbered(b: TBinder, id: TLocalId) : TBinder =
  if tlocal_raw(b.id) != 0 { b }
  else { TBinder { id: id, name: b.name, kind: b.kind, bounds: b.bounds, implicit: b.implicit, line: b.line, col: b.col } }

# The innermost binder wins: the list runs outermost first. A row hole
# is reached by its position, never by a name.
fn tsc_find(bs: [TBinder], n: String, found: Option[TBinder]) : Option[TBinder] = match bs {
  []           -> found
  [b, ...rest] -> tsc_find(rest, n, if tb_text(b) == n and not tb_is_hole(b) { Some(b) } else { found })
}

fn tsc_has(sc: TScope, n: String) : Bool = match tsc_find(sc.bs, n, None) {
  Some(_) -> true
  None    -> false
}

#[doc("The parameter an unqualified written type name means in `sc`, if it means one: `Self` inside a protocol, or a binder of that name.")]
pub fn tsc_ref(sc: TScope, r: DeclRef) : Option[TLocalId] = match r {
  DrWritten(None, w) -> {
    let n = written_text(w)
    if n == "Self" and tlocal_raw(sc.self_id) != 0 { Some(sc.self_id) }
    else { match tsc_find(sc.bs, n, None) {
      Some(b) -> Some(b.id)
      None    -> None
    } }
  }
  _ -> None
}

#[doc("The unit-kind parameter the unit symbol `s` means in `sc`, if it means one.")]
pub fn tsc_unit(sc: TScope, s: String) : Option[TLocalId] =
  match tsc_find(filter(sc.bs, tb_is_unit), s, None) {
    Some(b) -> Some(b.id)
    None    -> None
  }

#[doc("A row tail under `sc`: the row parameter it names, or itself while nothing binds it.")]
pub fn tsc_tail(sc: TScope, t: TParamRef) : TParamRef = match t {
  TpWritten(w) -> match tsc_find(sc.bs, written_text(w), None) {
    Some(b) -> TpId(b.id)
    None    -> t
  }
  TpHole(_, l, c) -> match tsc_hole(sc.bs, l, c) {
    Some(b) -> TpId(b.id)
    None    -> t
  }
  TpId(_) -> t
}

fn tsc_hole(bs: [TBinder], l: Int, c: Int) : Option[TBinder] = match bs {
  []           -> None
  [b, ...rest] -> match b.kind {
    KRowHole(bl, bc) -> if bl == l and bc == c { Some(b) } else { tsc_hole(rest, l, c) }
    _                -> tsc_hole(rest, l, c)
  }
}

#[doc("The binder of a type a signature uses without listing it.")]
pub fn tsc_implicit_type(n: String) : TBinder =
  TBinder { id: tlocal_none(), name: written(n), kind: KType, bounds: [], implicit: true, line: 0, col: 0 }

# ---- what a signature binds without listing ---------------------------

# A type variable is spelled lowercase and unqualified.
fn tsc_var_spelling(n: String) : Bool = match char_at(n, 0) {
  Some(c) -> ch_is_lower(c) and string_find(n, ".") < 0
  None    -> false
}

#[doc("The lowercase names a signature uses as types with no binder in `sc`, each once, in first-use order: the parameters, the return type, the row; a head's arguments before the head.")]
pub fn tsc_free_names(ps: [Param], ret: Option[TypeExpr], row: RowExpr, sc: TScope) : [String] =
  fn_row(row, sc, fn_opt(ret, sc, fn_params(ps, sc, [])))

fn fn_params(ps: [Param], sc: TScope, acc: [String]) : [String] = match ps {
  []           -> acc
  [p, ...rest] -> fn_params(rest, sc, fn_opt(p.ptype, sc, acc))
}

fn fn_opt(o: Option[TypeExpr], sc: TScope, acc: [String]) : [String] = match o {
  Some(t) -> fn_ty(t, sc, acc)
  None    -> acc
}

fn fn_ty(t: TypeExpr, sc: TScope, acc: [String]) : [String] = match t.tkind {
  TyName(r, tas)     -> fn_head(r, sc, fn_tys(tas, sc, acc))
  TyParam(_, tas)    -> fn_tys(tas, sc, acc)
  TyList(inner)      -> fn_ty(inner, sc, acc)
  TyFn(fps, ret, row) -> fn_row(row, sc, fn_ty(ret, sc, fn_tys(fps, sc, acc)))
  TyDim(base, _)     -> fn_ty(base, sc, acc)
  TyRefine(base, _, _)  -> fn_ty(base, sc, acc)
  TyRow(row)         -> fn_row(row, sc, acc)
  TySurface(ts)      -> fn_tys(tysurface_children(ts), sc, acc)
}

fn fn_tys(ts: [TypeExpr], sc: TScope, acc: [String]) : [String] = match ts {
  []           -> acc
  [t, ...rest] -> fn_tys(rest, sc, fn_ty(t, sc, acc))
}

fn fn_head(r: DeclRef, sc: TScope, acc: [String]) : [String] = match r {
  DrWritten(None, w) -> {
    let n = written_text(w)
    if tsc_var_spelling(n) and not tsc_has(sc, n) and not list_has(acc, n) { list_append(acc, [n]) }
    else { acc }
  }
  _ -> acc
}

fn fn_row(r: RowExpr, sc: TScope, acc: [String]) : [String] = match r {
  REmpty       -> acc
  RClosed(ls)  -> fn_labels(ls, sc, acc)
  ROpen(_, ls) -> fn_labels(ls, sc, acc)
}

fn fn_labels(ls: [RowLabel], sc: TScope, acc: [String]) : [String] = match ls {
  []                    -> acc
  [RL(_, tas), ...rest] -> fn_labels(rest, sc, fn_tys(tas, sc, acc))
}

#[doc("Binders for the row variables and row holes a signature opens a row with and `sc` does not bind, each once, in first-use order: the outer row, the parameters, the return type.")]
pub fn tsc_tail_binders(ps: [Param], ret: Option[TypeExpr], row: RowExpr, sc: TScope) : [TBinder] =
  tl_opt(ret, sc, tl_params(ps, sc, tl_row(row, sc, [])))

fn tl_params(ps: [Param], sc: TScope, acc: [TBinder]) : [TBinder] = match ps {
  []           -> acc
  [p, ...rest] -> tl_params(rest, sc, tl_opt(p.ptype, sc, acc))
}

fn tl_opt(o: Option[TypeExpr], sc: TScope, acc: [TBinder]) : [TBinder] = match o {
  Some(t) -> tl_ty(t, sc, acc)
  None    -> acc
}

fn tl_ty(t: TypeExpr, sc: TScope, acc: [TBinder]) : [TBinder] = match t.tkind {
  TyName(_, tas)      -> tl_tys(tas, sc, acc)
  TyParam(_, tas)     -> tl_tys(tas, sc, acc)
  TyList(inner)       -> tl_ty(inner, sc, acc)
  TyFn(fps, ret, row) -> tl_row(row, sc, tl_ty(ret, sc, tl_tys(fps, sc, acc)))
  TyDim(base, _)      -> tl_ty(base, sc, acc)
  TyRefine(base, _, _)   -> tl_ty(base, sc, acc)
  TyRow(row)          -> tl_row(row, sc, acc)
  TySurface(ts)       -> tl_tys(tysurface_children(ts), sc, acc)
}

fn tl_tys(ts: [TypeExpr], sc: TScope, acc: [TBinder]) : [TBinder] = match ts {
  []           -> acc
  [t, ...rest] -> tl_tys(rest, sc, tl_ty(t, sc, acc))
}

fn tl_row(r: RowExpr, sc: TScope, acc: [TBinder]) : [TBinder] = match r {
  ROpen(TpWritten(w), _) -> {
    let n = written_text(w)
    if tsc_has(sc, n) or tsc_has(tsc_of(acc), n) { acc }
    else { list_append(acc, [TBinder { id: tlocal_none(), name: w, kind: KRow, bounds: [], implicit: true, line: 0, col: 0 }]) }
  }
  ROpen(TpHole(nm, l, c), _) -> match tsc_hole(acc, l, c) {
    Some(_) -> acc
    None    -> list_append(acc, [TBinder { id: tlocal_none(), name: written(match nm { Some(n) -> n  None -> "" }),
                                           kind: KRowHole(l, c), bounds: [], implicit: true, line: 0, col: 0 }])
  }
  _ -> acc
}
