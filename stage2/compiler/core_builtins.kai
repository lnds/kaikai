#[doc("The builtin functions, primitives and their table rows the core knows by name.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.infer_index
import compiler.native_prims
import compiler.diag
import compiler.written
import compiler.symtab
import compiler.type_home
import compiler.ast_map
import compiler.expr_positions
import compiler.builtins
import compiler.util

#[doc("A core builtin a pass singles out.")]
pub(pkg) type CoreBuiltin =
    CbArrayMake | CbArrayGet | CbArrayTake | CbArraySet | CbArrayLength | CbArrayGrow
  | CbArrayGetBorrow | CbArrayLengthBorrow
  | CbVecGet | CbVecLength | CbVecGetBorrow | CbVecLengthBorrow
  | CbPanic | CbExit
  | CbVecSlice | CbVecFromList
  | CbStripUnit | CbAttachUnit | CbDetachUnit
  | CbVecPush | CbVecSet
  | CbUnitName
  | CbBitAnd | CbBitOr | CbBitXor | CbBitNot | CbBitShl | CbBitShr | CbBitUshr
  | CbBitCount | CbBitTest | CbBitSet | CbBitClear | CbBitToggle
  | CbSpawnActorFiber
  | CbIntToReal | CbRealToInt

#[doc("Every builtin with a constructor.")]
pub(pkg) fn core_builtins() : [CoreBuiltin] = [
  CbArrayMake, CbArrayGet, CbArrayTake, CbArraySet, CbArrayLength, CbArrayGrow,
  CbArrayGetBorrow, CbArrayLengthBorrow,
  CbVecGet, CbVecLength, CbVecGetBorrow, CbVecLengthBorrow,
  CbPanic, CbExit,
  CbVecSlice, CbVecFromList,
  CbStripUnit, CbAttachUnit, CbDetachUnit,
  CbVecPush, CbVecSet,
  CbUnitName,
  CbBitAnd, CbBitOr, CbBitXor, CbBitNot, CbBitShl, CbBitShr, CbBitUshr,
  CbBitCount, CbBitTest, CbBitSet, CbBitClear, CbBitToggle,
  CbSpawnActorFiber,
  CbIntToReal, CbRealToInt
]

#[doc("The name `b` is spelled with.")]
pub(pkg) fn builtin_name(b: CoreBuiltin) : String = match b {
  CbArrayMake         -> "array_make"
  CbArrayGet          -> "array_get"
  CbArrayTake         -> "array_take"
  CbArraySet          -> "array_set"
  CbArrayLength       -> "array_length"
  CbArrayGrow         -> "array_grow"
  CbArrayGetBorrow    -> "array_get_borrow"
  CbArrayLengthBorrow -> "array_length_borrow"
  CbVecGet            -> "vec_get"
  CbVecLength         -> "vec_length"
  CbVecGetBorrow      -> "vec_get_borrow"
  CbVecLengthBorrow   -> "vec_length_borrow"
  CbPanic             -> "panic"
  CbExit              -> "exit"
  CbVecSlice          -> "vec_slice"
  CbVecFromList       -> "vec_from_list"
  CbStripUnit         -> "__strip_unit"
  CbAttachUnit        -> "__attach_unit"
  CbDetachUnit        -> "__detach_unit"
  CbVecPush           -> "vec_push"
  CbVecSet            -> "vec_set"
  CbUnitName          -> "unit_name"
  CbBitAnd            -> "bit_and"
  CbBitOr             -> "bit_or"
  CbBitXor            -> "bit_xor"
  CbBitNot            -> "bit_not"
  CbBitShl            -> "bit_shl"
  CbBitShr            -> "bit_shr"
  CbBitUshr           -> "bit_ushr"
  CbBitCount          -> "bit_count"
  CbBitTest           -> "bit_test"
  CbBitSet            -> "bit_set"
  CbBitClear          -> "bit_clear"
  CbBitToggle         -> "bit_toggle"
  CbSpawnActorFiber   -> "spawn_actor_fiber"
  CbIntToReal         -> "int_to_real"
  CbRealToInt         -> "real_to_int"
}

#[doc("True when the backends lower every use of `b` in place, so it has no runtime entry to read as a value.")]
pub(pkg) fn builtin_is_inline(b: CoreBuiltin) : Bool = match b {
  CbStripUnit -> true
  CbAttachUnit -> true
  CbDetachUnit -> true
  CbUnitName -> true
  CbBitAnd -> true
  CbBitOr -> true
  CbBitXor -> true
  CbBitNot -> true
  CbBitShl -> true
  CbBitShr -> true
  CbBitUshr -> true
  CbBitCount -> true
  CbBitTest -> true
  CbBitSet -> true
  CbBitClear -> true
  CbBitToggle -> true
  _ -> false
}

