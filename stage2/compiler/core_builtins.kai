#[doc("The builtin whose row `s` is, or `None` for any other symbol.")]
pub(pkg) fn builtin_of(s: SymId) : Option[CoreBuiltin] = match sym_raw(s) {
  6152798857067796487 -> Some(CbArrayMake)
  3431439868629982737 -> Some(CbArrayGet)
  1985417026627175561 -> Some(CbArrayTake)
  4066169504582419058 -> Some(CbArraySet)
  1420750404759437129 -> Some(CbArrayLength)
  2923158632286845906 -> Some(CbArrayGrow)
  6120724367815020769 -> Some(CbArrayGetBorrow)
  487524741130700902  -> Some(CbArrayLengthBorrow)
  1982582579665107154 -> Some(CbVecGet)
  4705379299206458603 -> Some(CbVecLength)
  8584301020251401152 -> Some(CbVecGetBorrow)
  8036283533893600501 -> Some(CbVecLengthBorrow)
  5356888815066063375 -> Some(CbPanic)
  3512249259006271419 -> Some(CbExit)
  4139262320981728212 -> Some(CbVecSlice)
  57684091814999176   -> Some(CbVecFromList)
  3583922027156876123 -> Some(CbStripUnit)
  3132429856436085237 -> Some(CbAttachUnit)
  5947904153746571504 -> Some(CbDetachUnit)
  8213624147040685864 -> Some(CbVecPush)
  5331522700881722785 -> Some(CbVecSet)
  5391470388420523484 -> Some(CbUnitName)
  4851909271892983353 -> Some(CbBitAnd)
  7363151630086390786 -> Some(CbBitOr)
  689106573965500021  -> Some(CbBitXor)
  5556414141742326126 -> Some(CbBitNot)
  2438281628330607026 -> Some(CbBitShl)
  2438314613679453356 -> Some(CbBitShr)
  7118562272637024077 -> Some(CbBitUshr)
  184085060908312848  -> Some(CbBitCount)
  2067553864545900036 -> Some(CbBitTest)
  2427900039539120239 -> Some(CbBitSet)
  2781277959498946253 -> Some(CbBitClear)
  9081499593308955219 -> Some(CbBitToggle)
  3754035307162293952 -> Some(CbSpawnActorFiber)
  1273667732043964424 -> Some(CbIntToReal)
  1476049628431850885 -> Some(CbRealToInt)
  _                   -> None
}

#[doc("The builtin a reference names, or `None` when `e` is anything else: a bare name is a local, whatever it spells.")]
pub(pkg) fn builtin_ref(e: Expr) : Option[CoreBuiltin] = match e.kind {
  ESym(s, _) -> builtin_of(s)
  _          -> None
}

#[doc("True when `e` is a reference to the builtin `b`.")]
pub(pkg) fn is_builtin_ref(e: Expr, b: CoreBuiltin) : Bool = match e.kind {
  ESym(s, _) -> sym_raw(s) == sym_raw(builtin_id(b))
  _          -> false
}

#[doc("A fresh reference to `b` at a source position, for a pass that synthesises a call to it.")]
pub(pkg) fn builtin_mk(b: CoreBuiltin, line: Int, col: Int) : Expr =
  mk_sym(builtin_id(b), line, col)

#[doc("A reference to `b`, at the position and with the type of `at`.")]
pub(pkg) fn builtin_ref_at(b: CoreBuiltin, at: Expr) : Expr =
  Expr { kind: ESym(builtin_id(b), spec_none()), line: at.line, col: at.col,
         ty: at.ty, mode: at.mode, site: at.site }

#[doc("The sibling of `b` that only reads its first argument, which a call can lend instead of handing over; `None` when `b` has none.")]
pub(pkg) fn builtin_lending_form(b: CoreBuiltin) : Option[CoreBuiltin] = match b {
  CbArrayGet    -> Some(CbArrayGetBorrow)
  CbArrayLength -> Some(CbArrayLengthBorrow)
  CbVecGet      -> Some(CbVecGetBorrow)
  CbVecLength   -> Some(CbVecLengthBorrow)
  _             -> None
}

#[doc("True when `b` is a lending sibling: it only reads its first argument.")]
pub(pkg) fn builtin_is_lending_form(b: CoreBuiltin) : Bool = match b {
  CbArrayGetBorrow    -> true
  CbArrayLengthBorrow -> true
  CbVecGetBorrow      -> true
  CbVecLengthBorrow   -> true
  _                   -> false
}

#[doc("Every builtin with a lending sibling.")]
pub(pkg) fn lending_builtins() : [CoreBuiltin] =
  filter(core_builtins(), (b) => match builtin_lending_form(b) { Some(_) -> true None -> false })

#[doc("True when `b` reads or writes an array slot: a body that names one keeps a boxed signature.")]
pub(pkg) fn builtin_is_mutable_intrinsic(b: CoreBuiltin) : Bool = match b {
  CbArrayMake         -> true
  CbArrayGet          -> true
  CbArraySet          -> true
  CbArrayLength       -> true
  CbArrayGrow         -> true
  CbArrayGetBorrow    -> true
  CbArrayLengthBorrow -> true
  _                   -> false
}

#[doc("True when a call to `b` never produces a value.")]
pub(pkg) fn builtin_never_returns(b: CoreBuiltin) : Bool = match b {
  CbPanic -> true
  CbExit  -> true
  _       -> false
}

#[doc("True when `b` is a unit coercion: the identity at run time.")]
pub(pkg) fn builtin_is_unit_coercion(b: CoreBuiltin) : Bool = match b {
  CbStripUnit  -> true
  CbAttachUnit -> true
  CbDetachUnit -> true
  _            -> false
}

#[doc("A set of symbol ids.")]
pub(pkg) type SymSet = { ix: NameIndex[SymId] }

#[doc("The set holding no id.")]
pub(pkg) fn sym_set_empty() : SymSet = SymSet { ix: idx_empty() }

#[doc("The set of the ids `ss`.")]
pub(pkg) fn sym_set_of(ss: [SymId]) : SymSet = SymSet { ix: ss_add(ss, idx_empty()) }

#[doc("True when `set` holds `s`.")]
pub(pkg) fn sym_set_has(set: SymSet, s: SymId) : Bool = match idx_chain_sym(set.ix, s) {
  [] -> false
  _  -> true
}

fn ss_add(ss: [SymId], ix: NameIndex[SymId]) : NameIndex[SymId] = match ss {
  []           -> ix
  [s, ...rest] -> ss_add(rest, idx_prepend_sym(ix, s, s))
}

#[doc("The raw core primitives: a call to one crosses unboxed.")]
pub(pkg) fn raw_prim_syms() : SymSet = sym_set_of(map(native_prim_names(), builtin_sym))

#[doc("The builtins a program can name as a value: every bound row of the builtin table, and the lending sibling of one that has it.")]
pub(pkg) fn bound_builtin_syms() : SymSet = sym_set_of(map(core_builtin_names(), builtin_sym))

#[doc("The boxed core builtins, the raw core primitives, and the kaikai name of every builtin a call can name, each keyed by the id of its row.")]
pub(pkg) type CoreIx = { boxed: NameIndex[ECore], raw: NameIndex[RCore], names: NameIndex[String] }

#[doc("The index over every core builtin.")]
pub(pkg) fn core_ix_build() : CoreIx =
  CoreIx { boxed: cix_boxed(core_table(), idx_empty()), raw: cix_raw(rcore_table(), idx_empty()),
           names: cix_names(list_append(core_minted_names(), list_append(core_builtin_names(), native_prim_names())), idx_empty()) }

#[doc("The boxed row of the builtin `s`, or None when `s` is the row of no boxed builtin.")]
pub(pkg) fn core_ix_boxed(ix: CoreIx, s: SymId) : Option[ECore] = match idx_chain_sym(ix.boxed, s) {
  [ep, ..._] -> Some(ep)
  []         -> None
}

#[doc("The raw row of the primitive `s`, or None when `s` is the row of no raw primitive.")]
pub(pkg) fn core_ix_raw(ix: CoreIx, s: SymId) : Option[RCore] = match idx_chain_sym(ix.raw, s) {
  [rp, ..._] -> Some(rp)
  []         -> None
}

#[doc("The kaikai name of the builtin `s`, which keys its native entry; None when `s` is the row of no builtin a call can name.")]
pub(pkg) fn core_ix_name(ix: CoreIx, s: SymId) : Option[String] = match idx_chain_sym(ix.names, s) {
  [n, ..._] -> Some(n)
  []        -> None
}

fn cix_boxed(table: [ECore], ix: NameIndex[ECore]) : NameIndex[ECore] = match table {
  []           -> ix
  [ep, ...rest] -> match ep {
    EP(name, _, _) -> cix_boxed(rest, idx_prepend_sym(ix, builtin_sym(name), ep))
  }
}

fn cix_raw(table: [RCore], ix: NameIndex[RCore]) : NameIndex[RCore] = match table {
  []           -> ix
  [rp, ...rest] -> match rp {
    RP(name, _, _, _) -> cix_raw(rest, idx_prepend_sym(ix, builtin_sym(name), rp))
  }
}

fn cix_names(names: [String], ix: NameIndex[String]) : NameIndex[String] = match names {
  []          -> ix
  [n, ...rest] -> cix_names(rest, idx_prepend_sym(ix, builtin_sym(n), n))
}

#[doc("A boxed core builtin: its kaikai name, its C entry point and its arity.")]
pub(pkg) type ECore = EP(String, String, Int)

#[doc("The boxed core builtins the backends know, in registry order: every builtin with a runtime entry, each followed by its `_borrow` sibling when it has one.")]
pub(pkg) fn core_table() : [ECore] = core_table_of(builtin_table())

fn core_table_of(bs: [Builtin]) : [ECore] = match bs {
  [] -> []
  [BF(name, entry, sig), ...rest] -> match builtin_cname(name, entry) {
    Some(cname) -> core_entry_rows(name, cname, bsig_arity(sig), core_table_of(rest))
    None        -> core_table_of(rest)
  }
}

fn core_entry_rows(name: String, cname: String, arity: Int, rest: [ECore]) : [ECore] =
  if list_has(core_borrowing_prims(), name) {
    [EP(name, cname, arity), EP(cat2(name, "_borrow"), cat2(cname, "_borrow"), arity), ...rest]
  } else { [EP(name, cname, arity), ...rest] }

#[doc("Every core builtin name a bare use binds, `_borrow` siblings included.")]
pub(pkg) fn core_builtin_names() : [String] = core_names_of(builtin_table())

fn core_names_of(bs: [Builtin]) : [String] = match bs {
  [] -> []
  [BF(name, entry, _), ...rest] ->
    if not builtin_bound(entry) { core_names_of(rest) }
    else { match core_borrow_variant(name) {
      Some(b) -> [name, b, ...core_names_of(rest)]
      None    -> [name, ...core_names_of(rest)]
    } }
}

fn core_minted_names() : [String] = ["array_take"]

#[doc("The runtime symbol of the thunk that lets the native backend build a closure over a core builtin.")]
pub(pkg) fn core_native_thunk_sym(name: String) : String = cat3("kaix_", name, "_thunk")

#[doc("The linkable runtime symbol a direct call to the core builtin `name` binds on the native backend.")]
pub(pkg) fn core_native_call_sym(name: String) : String = string_concat("kaix_core_", name)

# Each name here has a `<name>_borrow` registry entry: the read-only
# sibling that borrows argument 0 where `name` consumes it.
#[doc("The core builtins with a read-only `_borrow` sibling that borrows argument 0.")]
pub(pkg) fn core_borrowing_prims() : [String] = ["array_get", "array_length", "vec_get", "vec_length"]

#[doc("The read-only `_borrow` sibling of a core builtin, or None when it has none.")]
pub(pkg) fn core_borrow_variant(name: String) : Option[String] =
  if list_has(core_borrowing_prims(), name) { Some(cat2(name, "_borrow")) } else { None }

#[doc("The note and help for a mismatch between a declared type and the builtin it shadows; None when the pair is not one.")]
pub(pkg) fn core_shadow_notes(tab: SymTab, hs: TyHomes, expected: Ty, found: Ty) : Option[(String, String)] =
  map(core_shadow_pair(tab, expected, found), (s) => core_shadow_text(written_text(decl_name(tab, s)), tsh_sym_slot(tsh_view(hs, None), s)))

fn core_shadow_text(nm: String, home: Option[String]) : (String, String) = match home {
  Some(m) -> ("`#{nm}` here names `#{m}.#{nm}`, the type module `#{m}` declares, not the builtin `#{nm}`",
              "import `#{m}` selectively without `#{nm}` (`import #{m}.{…}`) or under a qualifier (`import #{m} as …`) so a bare `#{nm}` names the builtin")
  None -> ("`#{nm}` here names the `#{nm}` this file declares, not the builtin `#{nm}`",
           "rename this file's `#{nm}` so a bare `#{nm}` names the builtin")
}

# The declared type of the pair, when the other is the builtin it is spelled like.
fn core_shadow_pair(tab: SymTab, e: Ty, f: Ty) : Option[SymId] = match e {
  TyCon(es, _) -> match f {
    TyCon(fs, _) ->
      if core_shadowed_by(tab, fs, es) { Some(es) }
      else if core_shadowed_by(tab, es, fs) { Some(fs) }
      else { None }
    _ -> None
  }
  _ -> None
}

fn core_shadowed_by(tab: SymTab, core: SymId, decl: SymId) : Bool = match core_type_name_of(core) {
  Some(n) -> sym_raw(decl) >= 0 and sym_raw(decl) != sym_raw(core) and written_text(decl_name(tab, decl)) == n
  None    -> false
}

#[doc("`ds` with every written name that spells a core builtin replaced by the builtin's row.")]
pub(pkg) fn core_stamp_decls(tab: SymTab, ds: [Decl]) : [Decl] = map(ds, (d) => decl_map_bodies(d, (b) => cst_body(tab, b)))

# Most bodies leave no builtin written, and are returned as they are.
fn cst_body(tab: SymTab, body: Expr) : Expr =
  if xp_exists(body, false, (x) => cst_is_written_builtin(tab, x)) { cst_expr(tab, body) } else { body }

fn cst_is_written_builtin(tab: SymTab, e: Expr) : Bool = match e.kind {
  EName(n) -> sym_is_builtin(tab, builtin_sym(written_text(n)))
  _        -> false
}

fn cst_expr(tab: SymTab, e: Expr) : Expr =
  Expr { kind: cst_kind(tab, e.kind), line: e.line, col: e.col, ty: e.ty, mode: e.mode, site: e.site }

fn cst_kind(tab: SymTab, k: ExprKind) : ExprKind = match k {
  EName(n) -> {
    let s = builtin_sym(written_text(n))
    if sym_is_builtin(tab, s) { ESym(s, spec_none()) } else { k }
  }
  _ -> prc_map_expr_kind(k, (sub) => cst_expr(tab, sub))
}

#[doc("The id of the core builtin named `name`.")]
pub(pkg) fn builtin_sym(name: String) : SymId = sym_derive(NCBuiltin, name, core_type_home())

fn core_entries() : [NEnt] =
  list_append(map(core_ctor_names(), (n) => NEnt(NCCtor, n, core_type_home(), true, NmSource)),
              list_append(core_coercion_entries(),
                          map(list_append(core_table_names(builtin_table()), native_prim_names()),
                              (n) => NEnt(NCBuiltin, n, core_type_home(), true, NmSource))))

# The unit coercions are the typer's own: no source names them. They sit
# ahead of the builtin table's rows, and the first row of a key is kept.
fn core_coercion_entries() : [NEnt] =
  map([UcStrip, UcAttach, UcDetach], (u) => NEnt(NCBuiltin, unit_coercion_name(u), core_type_home(), true, NmHelper))

# The constructors of the types no declaration spells.
fn core_ctor_names() : [String] = ["Some", "None", "Ok", "Err"]

fn core_table_names(bs: [Builtin]) : [String] = match bs {
  [] -> []
  [BF(name, _, _), ...rest] -> match core_borrow_variant(name) {
    Some(b) -> [name, b, ...core_table_names(rest)]
    None    -> [name, ...core_table_names(rest)]
  }
}

#[doc("The symbol table for the entries `rows` of a program whose root file is the module `target` and whose core modules are `cores`, with the core builtins declared too.")]
pub(pkg) fn st_program(rows: [NEnt], target: String, cores: [String]) : SymTab =
  st_build(list_append(core_entries(), rows), target, [core_type_home(), ...cores])

#[doc("True when `s` is a core builtin's row in `t`.")]
pub(pkg) fn sym_is_builtin(t: SymTab, s: SymId) : Bool = match sym_class(t, s) {
  NCBuiltin -> st_valid(t, s)
  _         -> false
}

type UnitCoercion = UcStrip | UcAttach | UcDetach

fn unit_coercion_name(u: UnitCoercion) : String = match u {
  UcStrip  -> "__strip_unit"
  UcAttach -> "__attach_unit"
  UcDetach -> "__detach_unit"
}

fn unit_coercion_of(s: SymId) : Option[UnitCoercion] =
  if sym_raw(s) < 0 { None }
  else if cs_is(s, UcStrip) { Some(UcStrip) }
  else if cs_is(s, UcAttach) { Some(UcAttach) }
  else if cs_is(s, UcDetach) { Some(UcDetach) }
  else { None }

#[doc("True when `s` is the row of a unit coercion.")]
pub(pkg) fn sym_is_unit_coercion(s: SymId) : Bool = match unit_coercion_of(s) {
  Some(_) -> true
  None    -> false
}

fn cs_is(s: SymId, u: UnitCoercion) : Bool = sym_raw(s) == sym_raw(builtin_sym(unit_coercion_name(u)))
