#[doc("""
The core builtins the passes below monomorphisation treat by name.

Which builtin a reference names is asked of its id, never of its
spelling: a local binder may be spelled like a builtin, and only the
resolved reference carries the builtin's row. The ids are tabulated,
since the ownership passes ask on every call; the symbol table selftest
holds each equal to the id its name derives.

Only the builtins some pass singles out have a constructor here. A set
too large to enumerate is a set of ids built once per pass run
(`compiler.core_builtin_sets`).
""")]

import compiler.ast

#[doc("A core builtin a pass singles out.")]
pub type CoreBuiltin =
    CbArrayMake | CbArrayGet | CbArraySet | CbArrayLength | CbArrayGrow
  | CbArrayGetBorrow | CbArrayLengthBorrow
  | CbVecGet | CbVecLength | CbVecGetBorrow | CbVecLengthBorrow
  | CbPanic | CbExit
  | CbVecSlice | CbVecFromList
  | CbStripUnit | CbAttachUnit | CbDetachUnit
  | CbVecPush | CbVecSet
  | CbUnitName
  | CbBitAnd | CbBitOr | CbBitXor | CbBitNot | CbBitShl | CbBitShr | CbBitUshr
  | CbBitCount | CbBitTest | CbBitSet | CbBitClear | CbBitToggle
  | CbSpawnActorFiber

#[doc("Every builtin with a constructor.")]
pub fn core_builtins() : [CoreBuiltin] = [
  CbArrayMake, CbArrayGet, CbArraySet, CbArrayLength, CbArrayGrow,
  CbArrayGetBorrow, CbArrayLengthBorrow,
  CbVecGet, CbVecLength, CbVecGetBorrow, CbVecLengthBorrow,
  CbPanic, CbExit,
  CbVecSlice, CbVecFromList,
  CbStripUnit, CbAttachUnit, CbDetachUnit,
  CbVecPush, CbVecSet,
  CbUnitName,
  CbBitAnd, CbBitOr, CbBitXor, CbBitNot, CbBitShl, CbBitShr, CbBitUshr,
  CbBitCount, CbBitTest, CbBitSet, CbBitClear, CbBitToggle,
  CbSpawnActorFiber
]

#[doc("The name `b` is spelled with.")]
pub fn builtin_name(b: CoreBuiltin) : String = match b {
  CbArrayMake         -> "array_make"
  CbArrayGet          -> "array_get"
  CbArraySet          -> "array_set"
  CbArrayLength       -> "array_length"
  CbArrayGrow         -> "array_grow"
  CbArrayGetBorrow    -> "array_get_borrow"
  CbArrayLengthBorrow -> "array_length_borrow"
  CbVecGet            -> "vec_get"
  CbVecLength         -> "vec_length"
  CbVecGetBorrow      -> "vec_get_borrow"
  CbVecLengthBorrow   -> "vec_length_borrow"
  CbPanic             -> "panic"
  CbExit              -> "exit"
  CbVecSlice          -> "vec_slice"
  CbVecFromList       -> "vec_from_list"
  CbStripUnit         -> "__strip_unit"
  CbAttachUnit        -> "__attach_unit"
  CbDetachUnit        -> "__detach_unit"
  CbVecPush           -> "vec_push"
  CbVecSet            -> "vec_set"
  CbUnitName          -> "unit_name"
  CbBitAnd            -> "bit_and"
  CbBitOr             -> "bit_or"
  CbBitXor            -> "bit_xor"
  CbBitNot            -> "bit_not"
  CbBitShl            -> "bit_shl"
  CbBitShr            -> "bit_shr"
  CbBitUshr           -> "bit_ushr"
  CbBitCount          -> "bit_count"
  CbBitTest           -> "bit_test"
  CbBitSet            -> "bit_set"
  CbBitClear          -> "bit_clear"
  CbBitToggle         -> "bit_toggle"
  CbSpawnActorFiber   -> "spawn_actor_fiber"
}

#[doc("The id of `b`'s row.")]
pub fn builtin_id(b: CoreBuiltin) : SymId = match b {
  CbArrayMake         -> SymId(6152798857067796487)
  CbArrayGet          -> SymId(3431439868629982737)
  CbArraySet          -> SymId(4066169504582419058)
  CbArrayLength       -> SymId(1420750404759437129)
  CbArrayGrow         -> SymId(2923158632286845906)
  CbArrayGetBorrow    -> SymId(6120724367815020769)
  CbArrayLengthBorrow -> SymId(487524741130700902)
  CbVecGet            -> SymId(1982582579665107154)
  CbVecLength         -> SymId(4705379299206458603)
  CbVecGetBorrow      -> SymId(8584301020251401152)
  CbVecLengthBorrow   -> SymId(8036283533893600501)
  CbPanic             -> SymId(5356888815066063375)
  CbExit              -> SymId(3512249259006271419)
  CbVecSlice          -> SymId(4139262320981728212)
  CbVecFromList       -> SymId(57684091814999176)
  CbStripUnit         -> SymId(3583922027156876123)
  CbAttachUnit        -> SymId(3132429856436085237)
  CbDetachUnit        -> SymId(5947904153746571504)
  CbVecPush           -> SymId(8213624147040685864)
  CbVecSet            -> SymId(5331522700881722785)
  CbUnitName          -> SymId(5391470388420523484)
  CbBitAnd            -> SymId(4851909271892983353)
  CbBitOr             -> SymId(7363151630086390786)
  CbBitXor            -> SymId(689106573965500021)
  CbBitNot            -> SymId(5556414141742326126)
  CbBitShl            -> SymId(2438281628330607026)
  CbBitShr            -> SymId(2438314613679453356)
  CbBitUshr           -> SymId(7118562272637024077)
  CbBitCount          -> SymId(184085060908312848)
  CbBitTest           -> SymId(2067553864545900036)
  CbBitSet            -> SymId(2427900039539120239)
  CbBitClear          -> SymId(2781277959498946253)
  CbBitToggle         -> SymId(9081499593308955219)
  CbSpawnActorFiber   -> SymId(3754035307162293952)
}

#[doc("The builtin whose row `s` is, or `None` for any other symbol.")]
pub fn builtin_of(s: SymId) : Option[CoreBuiltin] = match sym_raw(s) {
  6152798857067796487 -> Some(CbArrayMake)
  3431439868629982737 -> Some(CbArrayGet)
  4066169504582419058 -> Some(CbArraySet)
  1420750404759437129 -> Some(CbArrayLength)
  2923158632286845906 -> Some(CbArrayGrow)
  6120724367815020769 -> Some(CbArrayGetBorrow)
  487524741130700902  -> Some(CbArrayLengthBorrow)
  1982582579665107154 -> Some(CbVecGet)
  4705379299206458603 -> Some(CbVecLength)
  8584301020251401152 -> Some(CbVecGetBorrow)
  8036283533893600501 -> Some(CbVecLengthBorrow)
  5356888815066063375 -> Some(CbPanic)
  3512249259006271419 -> Some(CbExit)
  4139262320981728212 -> Some(CbVecSlice)
  57684091814999176   -> Some(CbVecFromList)
  3583922027156876123 -> Some(CbStripUnit)
  3132429856436085237 -> Some(CbAttachUnit)
  5947904153746571504 -> Some(CbDetachUnit)
  8213624147040685864 -> Some(CbVecPush)
  5331522700881722785 -> Some(CbVecSet)
  5391470388420523484 -> Some(CbUnitName)
  4851909271892983353 -> Some(CbBitAnd)
  7363151630086390786 -> Some(CbBitOr)
  689106573965500021  -> Some(CbBitXor)
  5556414141742326126 -> Some(CbBitNot)
  2438281628330607026 -> Some(CbBitShl)
  2438314613679453356 -> Some(CbBitShr)
  7118562272637024077 -> Some(CbBitUshr)
  184085060908312848  -> Some(CbBitCount)
  2067553864545900036 -> Some(CbBitTest)
  2427900039539120239 -> Some(CbBitSet)
  2781277959498946253 -> Some(CbBitClear)
  9081499593308955219 -> Some(CbBitToggle)
  3754035307162293952 -> Some(CbSpawnActorFiber)
  _                   -> None
}

#[doc("The builtin a reference names, or `None` when `e` is anything else: a bare name is a local, whatever it spells.")]
pub fn builtin_ref(e: Expr) : Option[CoreBuiltin] = match e.kind {
  ESym(s, _, _) -> builtin_of(s)
  _             -> None
}

#[doc("True when `e` is a reference to the builtin `b`.")]
pub fn is_builtin_ref(e: Expr, b: CoreBuiltin) : Bool = match e.kind {
  ESym(s, _, _) -> sym_raw(s) == sym_raw(builtin_id(b))
  _             -> false
}

#[doc("A fresh reference to `b` at a source position, for a pass that synthesises a call to it.")]
pub fn builtin_mk(b: CoreBuiltin, line: Int, col: Int) : Expr =
  mk_expr(ESym(builtin_id(b), spec_none(), builtin_name(b)), line, col)

#[doc("A reference to `b`, at the position and with the type of `at`.")]
pub fn builtin_ref_at(b: CoreBuiltin, at: Expr) : Expr =
  Expr { kind: ESym(builtin_id(b), spec_none(), builtin_name(b)), line: at.line, col: at.col,
         ty: at.ty, mode: at.mode, site: at.site }

#[doc("The sibling of `b` that only reads its first argument, which a call can lend instead of handing over; `None` when `b` has none.")]
pub fn builtin_lending_form(b: CoreBuiltin) : Option[CoreBuiltin] = match b {
  CbArrayGet    -> Some(CbArrayGetBorrow)
  CbArrayLength -> Some(CbArrayLengthBorrow)
  CbVecGet      -> Some(CbVecGetBorrow)
  CbVecLength   -> Some(CbVecLengthBorrow)
  _             -> None
}

#[doc("True when `b` is a lending sibling: it only reads its first argument.")]
pub fn builtin_is_lending_form(b: CoreBuiltin) : Bool = match b {
  CbArrayGetBorrow    -> true
  CbArrayLengthBorrow -> true
  CbVecGetBorrow      -> true
  CbVecLengthBorrow   -> true
  _                   -> false
}

#[doc("Every builtin with a lending sibling.")]
pub fn lending_builtins() : [CoreBuiltin] =
  filter(core_builtins(), (b) => match builtin_lending_form(b) { Some(_) -> true None -> false })

#[doc("True when `b` reads or writes an array slot: a body that names one keeps a boxed signature.")]
pub fn builtin_is_mutable_intrinsic(b: CoreBuiltin) : Bool = match b {
  CbArrayMake         -> true
  CbArrayGet          -> true
  CbArraySet          -> true
  CbArrayLength       -> true
  CbArrayGrow         -> true
  CbArrayGetBorrow    -> true
  CbArrayLengthBorrow -> true
  _                   -> false
}

#[doc("True when a call to `b` never produces a value.")]
pub fn builtin_never_returns(b: CoreBuiltin) : Bool = match b {
  CbPanic -> true
  CbExit  -> true
  _       -> false
}

#[doc("True when `b` is a unit coercion: the identity at run time.")]
pub fn builtin_is_unit_coercion(b: CoreBuiltin) : Bool = match b {
  CbStripUnit  -> true
  CbAttachUnit -> true
  CbDetachUnit -> true
  _            -> false
}
