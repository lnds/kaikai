#[doc("""
Constructor sites carry the constructor's declaration.

Which constructor a site names is decided by the type it builds: two
modules may each declare a `Node`, and a bare `Node(x)` means the one of
the type the typer gave that node. So the identity is written down here,
on the typed declarations, from each site's own type. A site whose type
names no declaration of that constructor is left as written.
""")]

import compiler.ast
import compiler.ast_map
import compiler.decl_map
import compiler.decl_names
import compiler.symtab
import compiler.symtab_build
import compiler.chars

# The table, and the two homes a type with no module slot can have.
type CsCx = { tab: SymTab, root: SymId, core: SymId }

#[doc("`ds` with each constructor site carrying the id of the constructor its type declares; `target` is the root module.")]
pub fn ctor_stamp_decls(tab: SymTab, target: String, ds: [Decl]) : [Decl] = {
  let cx = CsCx { tab: tab, root: st_module_id(target), core: st_module_id(core_type_home()) }
  map(ds, (d) => decl_map_bodies(d, (b) => cs_expr(cx, b)))
}

# A callee builds the call's type; any other site builds its own.
fn cs_expr(cx: CsCx, e: Expr) : Expr = match e.kind {
  ECall(f, args) -> {
    let f1 = match cs_ctor(cx, f.kind, e.ty) {
      Some(k) -> cs_re(f, k)
      None    -> cs_expr(cx, f)
    }
    cs_re(e, ECall(f1, map(args, (a) => cs_expr(cx, a))))
  }
  _ -> match cs_ctor(cx, e.kind, e.ty) {
    Some(k) -> cs_re(e, k)
    None    -> cs_re(e, prc_map_expr_kind(e.kind, (sub) => cs_expr(cx, sub)))
  }
}

fn cs_re(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode, site: e.site }

fn cs_ctor(cx: CsCx, k: ExprKind, t: Option[Ty]) : Option[ExprKind] = match k {
  EVar(n)        -> if cs_capital(n) { cs_pick(cx, n, cs_owners(cx, t)) } else { None }
  # A qualifier that names no module is a type the typer chose by; that site keeps its spelling.
  EModCall(m, n) -> if cs_capital(n) { cs_pick(cx, n, [st_module_id(m)]) } else { None }
  _              -> None
}

# Only a constructor is spelled with a capital in value position.
fn cs_capital(n: String) : Bool = match char_at(n, 0) {
  Some(c) -> ch_is_upper(c)
  None    -> false
}

fn cs_pick(cx: CsCx, n: String, owners: [SymId]) : Option[ExprKind] = match owners {
  [] -> None
  [o, ...rest] -> match st_lookup(cx.tab, NCCtor, n, o) {
    Some(s) -> Some(ESym(s, spec_none(), n))
    None    -> cs_pick(cx, n, rest)
  }
}

# The modules that may declare the constructors of the type a site builds.
fn cs_owners(cx: CsCx, t: Option[Ty]) : [SymId] = match t {
  Some(TyCon(mo, _, _, s))  -> cs_type_owners(cx, mo, s)
  Some(TyRefineT(inner, _)) -> cs_owners(cx, Some(inner))
  Some(TyDimT(inner, _))    -> cs_owners(cx, Some(inner))
  Some(TyFnT(_, ret, _))    -> cs_owners(cx, Some(ret))
  _                         -> []
}

# A type the table declares is owned by its module; one it does not is the core's.
fn cs_type_owners(cx: CsCx, mo: Option[String], s: SymId) : [SymId] =
  if st_valid(cx.tab, s) { [sym_owner(cx.tab, s)] }
  else if sym_raw(s) >= 0 { [cx.core] }
  else { match mo {
    Some(m) -> [st_module_id(m)]
    None    -> [cx.root, cx.core]
  } }
