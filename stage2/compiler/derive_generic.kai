# compiler/derive_generic.kai — a derived impl over a generic type.
#
# The derive generators build their impl for the bare head `T`. For
# `type T[a, b]` that head has no type arguments, so the typer cannot
# match a method parameter typed `T` to the record, and a derived field
# access falls through to whatever else carries the field's name.
#
# This pass rewrites the impl the way it would be written by hand:
# `impl[a: P, b: P] P for T[a, b]`, every `T` in a method signature
# read as `T[a, b]`. Surface lowering, which copies an impl's type
# parameters onto its methods, has already run by the time derives
# expand, so the methods receive them here directly.

import compiler.ast
import compiler.tbinder

#[doc("Rewrite a derived impl of protocol `pname` for the type `t` with type parameters `tps` into its generic form. A non-generic type or a non-impl decl comes back unchanged.")]
pub fn derive_generalize(d: Decl, pname: String, t: SymId, tps: [TBinder]) : Decl =
  if list_length(tps) == 0 { d } else {
    match d {
      DImpl(p, pargs, target, ms, l, c, _, isym) -> {
        let applied = mk_ty(TyName(DrSym(t), dg_args(tps, l, c)), target.line, target.col)
        let methods = map(ms, (m) => dg_method(m, map(tps, tb_unbounded), t))
        DImpl(p, pargs, applied, methods, l, c, map(tps, (tp) => dg_bounded(tp, pname)), isym)
      }
      _ -> d
    }
  }

#[doc("The type parameters a derived impl bounds by its protocol; a field typed by one of them is covered by that bound.")]
pub fn derive_bound_params(tps: [TBinder]) : [TBinder] = filter(tps, tb_is_type)

# The type's own parameters, as the argument list its head takes.
fn dg_args(tps: [TBinder], l: Int, c: Int) : [TypeExpr] =
  map(tps, (tp) => tb_use(tp, l, c))

# Only a plain type parameter takes the protocol bound: a kinded one (a
# measure, a shape) is not a value the protocol ranges over.
fn dg_bounded(tp: TBinder, pname: String) : TBinder =
  if tb_is_type(tp) { TBinder { id: tp.id, name: tp.name, kind: tp.kind, bounds: [ref_written(pname)], implicit: tp.implicit } }
  else { tp }

fn dg_method(m: Decl, tps: [TBinder], head: SymId) : Decl = match m {
  DFn(is_pub, f, mtps, ps, ret, row, body, l, c, mo) ->
    DFn(is_pub, f, list_append(tps, mtps), map(ps, (p) => dg_param(p, head, tps)),
        dg_ty_opt(ret, head, tps), row, body, l, c, mo)
  _ -> m
}

fn dg_param(p: Param, head: SymId, tps: [TBinder]) : Param =
  Param { binder: p.binder, ptype: dg_ty_opt(p.ptype, head, tps),
          pline: p.pline, pcol: p.pcol, pborrow: p.pborrow }

fn dg_ty_opt(t: Option[TypeExpr], head: SymId, tps: [TBinder]) : Option[TypeExpr] =
  match t {
    None -> None
    Some(x) -> Some(dg_ty(x, head, tps))
  }

# A generator names the type it derives for by id.
fn dg_is_head(r: DeclRef, head: SymId) : Bool = match r {
  DrSym(s)        -> sym_raw(s) >= 0 and sym_raw(s) == sym_raw(head)
  DrWritten(_, _) -> false
}

# Apply the type's arguments to every bare occurrence of its head.
fn dg_ty(t: TypeExpr, head: SymId, tps: [TBinder]) : TypeExpr = match t.tkind {
  TyName(r, targs) ->
    if dg_is_head(r, head) and list_length(targs) == 0 { mk_ty(TyName(r, dg_args(tps, t.line, t.col)), t.line, t.col) }
    else { mk_ty(TyName(r, map(targs, (x) => dg_ty(x, head, tps))), t.line, t.col) }
  TyParam(p, targs) -> mk_ty(TyParam(p, map(targs, (x) => dg_ty(x, head, tps))), t.line, t.col)
  TyList(inner) -> mk_ty(TyList(dg_ty(inner, head, tps)), t.line, t.col)
  TyFn(ps, ret, row) ->
    mk_ty(TyFn(map(ps, (x) => dg_ty(x, head, tps)), dg_ty(ret, head, tps), row), t.line, t.col)
  _ -> t
}
