#[doc("""
Which handler clauses can finish without resuming: those make their
effect one that unwinds. A clause resumes only when every path through
its body calls its continuation; a runtime default handler resumes. A
clause that forwards its op to a segment handle does not: that handle
may drop the continuation.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.borrow_infer
import compiler.core_builtins
import compiler.core_types
import compiler.fnreg
import compiler.emit_shared_fv
import compiler.enc_unit
import compiler.expr_positions
import compiler.handler_alias
import compiler.marks
import compiler.modules_homes

#[doc("Every op clause of the program: its handlers' and its effects' default blocks.")]
fn unw_clauses(cs: [ClauseInfo], decls: [Decl]) : [UnwClause] = list_append(ue_clauses(cs), ue_default_clauses(decls, []))

#[doc("A handler clause: the effect it handles, its continuation's binder and its body.")]
type UnwClause = UnwC(SymId, LocalId, Expr)

#[doc("True when the effect declaration `s` is in `set`; an unresolved id is in none.")]
pub(pkg) fn unw_has_id(set: [Int], s: SymId) : Bool = sym_raw(s) >= 0 and unw_int_in(set, sym_raw(s))

fn unw_int_in(set: [Int], x: Int) : Bool = match set {
  [] -> false
  [y, ...rest] -> y == x or unw_int_in(rest, x)
}

fn ue_clauses(cs: [ClauseInfo]) : [UnwClause] = match cs {
  [] -> []
  [CI(_, _, _, _, params, body, _, _, _, _, esym), ...rest] -> match ue_continuation(params) {
    Some(k) -> [UnwC(esym, k, body), ...ue_clauses(rest)]
    None    -> ue_clauses(rest)
  }
}

#[doc("Every op clause of `decls`, read off each `handle` in their bodies, and their effects' default blocks.")]
fn unw_handle_clauses(decls: [Decl]) : [UnwClause] = ue_default_clauses(decls, ue_decls_handles(decls, []))

fn ue_decls_handles(decls: [Decl], acc: [UnwClause]) : [UnwClause] = match decls {
  [] -> acc
  [d, ...rest] -> ue_decls_handles(rest, match d {
    DFn(_, _, _, _, _, _, body, _, _, _) -> ue_handles(body, acc)
    DTest(_, body, _, _, _)     -> ue_handles(body, acc)
    DBench(_, body, _, _, _)    -> ue_handles(body, acc)
    DCheck(_, _, body, _, _, _) -> ue_handles(body, acc)
    DConst(_, _, _, init, _, _, _, _, _) -> ue_handles(init, acc)
    DImpl(_, _, _, inner, _, _, _, _) -> ue_decls_handles(inner, acc)
    _ -> acc
  })
}

fn ue_handles(e: Expr, acc: [UnwClause]) : [UnwClause] = {
  let here = match e.kind {
    EHandle(_, eff, _, _, _, hcs, _) -> ue_hclauses(ref_sym(eff), hcs, acc)
    _ -> acc
  }
  ue_handles_in(xp_positions(e), here)
}

fn ue_handles_in(ps: [XPos], acc: [UnwClause]) : [UnwClause] = match ps {
  [] -> acc
  [XP(_, c), ...rest] -> ue_handles_in(rest, ue_handles(c, acc))
}

fn ue_default_clauses(decls: [Decl], acc: [UnwClause]) : [UnwClause] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DEffect(_, esym, _, _, Some(DBlk(hcs, _, _, _)), _, _, _) ->
      ue_default_clauses(rest, ue_hclauses(esym, hcs, acc))
    _ -> ue_default_clauses(rest, acc)
  }
}

fn ue_hclauses(es: SymId, hcs: [HClause], acc: [UnwClause]) : [UnwClause] = match hcs {
  [] -> acc
  [HC(_, params, body, _, _), ...rest] -> match ue_continuation(params) {
    Some(k) -> ue_hclauses(es, rest, [UnwC(es, k, body), ...acc])
    None    -> ue_hclauses(es, rest, acc)
  }
}

# An op clause's continuation is its last parameter; `finally { }` has none.
fn ue_continuation(ps: [Param]) : Option[LocalId] = match ps {
  []           -> None
  [p]          -> Some(p.binder.id)
  [_, ...rest] -> ue_continuation(rest)
}

#[doc("True when `f` reads the continuation `k` of the clause it is in: the clause's own binder, or the binder every settled continuation call carries.")]
fn unw_reads_continuation(f: Expr, k: LocalId) : Bool = match f.kind {
  ELocal(l) -> local_eq(l, k) or local_eq(l, local_minted(canonical_continuation()))
  _         -> false
}

#[doc("`acc` plus the id of every effect one of the clauses `hs` can finish without resuming.")]
fn unw_abandoning(hs: [UnwClause], acc: [Int]) : [Int] = match hs {
  [] -> acc
  [UnwC(eff, k, body), ...rest] ->
    if sym_raw(eff) < 0 or unw_has_id(acc, eff) or ue_clause_resumes(body, k) { unw_abandoning(rest, acc) }
    else { unw_abandoning(rest, [sym_raw(eff), ...acc]) }
}

# A segment request may never come back: the body it suspends unwinds
# there when the handle drops the continuation.
fn ue_clause_resumes(body: Expr, k: LocalId) : Bool = not xp_exists(body, true, ue_is_request) and ue_resumes(body, k)

fn ue_is_request(e: Expr) : Bool = match e.kind {
  EIntrinsic(InSegRequest, _) -> true
  _ -> false
}

# Every path through `e` calls the continuation `k`. A runtime default
# handler resumes; the one that does not, `Cancel`'s, is counted apart.
fn ue_resumes(e: Expr, k: LocalId) : Bool = match extern_handler_c_symbol(e) {
  Some(_) -> true
  None    -> ue_resumes_kind(e, k)
}

fn ue_resumes_kind(e: Expr, k: LocalId) : Bool = match e.kind {
  ECall(f, xs) -> unw_reads_continuation(f, k) or ue_any_resumes(xs, k)
  EBlock(ss, ot) -> ue_stmts_resume(ss, k) or (match ot { Some(t) -> ue_resumes(t, k) None -> false })
  EIf(c, t, oe) -> ue_resumes(c, k) or (match oe {
    Some(el) -> ue_resumes(t, k) and ue_resumes(el, k)
    None     -> false
  })
  EMatch(s, arms) -> ue_resumes(s, k) or (arms != [] and ue_arms_resume(arms, k))
  _ -> false
}

fn ue_any_resumes(xs: [Expr], k: LocalId) : Bool = match xs {
  [] -> false
  [x, ...rest] -> ue_resumes(x, k) or ue_any_resumes(rest, k)
}

fn ue_stmts_resume(ss: [Stmt], k: LocalId) : Bool = match ss {
  [] -> false
  [s, ...rest] -> (match s {
    SLet(_, _, rhs) -> ue_resumes(rhs, k)
    SExprStmt(x)    -> ue_resumes(x, k)
    _               -> false
  }) or ue_stmts_resume(rest, k)
}

fn ue_arms_resume(arms: [Arm], k: LocalId) : Bool = match arms {
  [] -> true
  [Arm(_, _, b), ...rest] -> ue_resumes(b, k) and ue_arms_resume(rest, k)
}

#[doc("""
What decides whether a call can unwind: the ids of the declared
effects, every declared fn with the class of its row, the ids of the
effects that can unwind, whether every effect can, the ids of the types
that can carry a closure, and the emitted symbols of the fns that
install a handler.
""")]
pub(pkg) type UnwCx = { eff_ids: [Int], fns: Array[[UnwFn]], unw: [Int], all: Bool, carriers: [Int], handles: [EncUnit] }

#[doc("""
What an unwind analysis starts from beside the handlers it reads: whether
every fn row may cancel, and effects already known to unwind. A program
with no such knowledge passes `unw_seed_none`.
""")]
pub(pkg) type UnwSeed = { all: Bool, effects: [SymId] }

#[doc("The seed that adds nothing.")]
pub(pkg) fn unw_seed_none() : UnwSeed = UnwSeed { all: false, effects: [] }

#[doc("""
A declared fn, by its identity key, the class of its row (1 can unwind,
2 is open with nothing that can, so the call unwinds only through what
its arguments bring, 0 cannot) and the positions of the parameters it
borrows.
""")]
pub(pkg) type UnwFn = UF(String, Int, [Int])

#[doc("A context that finds no call able to unwind.")]
pub(pkg) fn unw_cx_empty() : UnwCx = UnwCx { eff_ids: [], fns: array_make(1, []), unw: [], all: false, carriers: [], handles: [] }

#[doc("The class of a declared row: 1 can unwind, 2 is open with nothing that can, 0 cannot.")]
pub(pkg) fn unw_row_class(row: RowExpr, ucx: UnwCx) : Int = match row {
  REmpty       -> 0
  RClosed(ls)  -> if unw_labels(ls, false, ucx) { 1 } else { 0 }
  ROpen(_, ls) -> if unw_labels(ls, false, ucx) { 1 } else { 2 }
}

#[doc("The bucket of `n` in a table of `size` buckets.")]
fn unw_bucket(n: String, size: Int) : Int = uc_hash(n, 0, 0) % size

# Kept below 2^20 at every step, so the hash never leaves the immediate range.
fn uc_hash(s: String, i: Int, h: Int) : Int =
  if i >= string_length(s) { h } else { uc_hash(s, i + 1, (h * 31 + string_byte_at_int(s, i)) % 1048573) }

#[doc("True when a call through a value of type `t` can unwind; an unknown type can.")]
fn unw_ty_unwinds(t: Option[Ty], ucx: UnwCx) : Bool = match t {
  Some(TyFnT(_, _, row)) -> match row.tail {
    Some(_) -> true
    None    -> uc_labels_unwind(row.labels, ucx)
  }
  _ -> true
}

fn uc_labels_unwind(ls: [Label], ucx: UnwCx) : Bool = match ls {
  [] -> false
  [l, ...rest] -> unw_effect_unwinds(l.sym, ucx) or uc_labels_unwind(rest, ucx)
}

#[doc("The class of the fn whose identity key is `k`: 1 can unwind, 2 is open, 0 cannot, -1 when no fn has it.")]
fn unw_fn_class(k: String, ucx: UnwCx) : Int = uc_best(ucx.fns[unw_bucket(k, array_length(ucx.fns))], k, 0 - 1)

#[doc("The class of two, the one that can unwind first.")]
fn unw_class_max(a: Int, b: Int) : Int =
  if a == 1 or b == 1 { 1 } else if a == 2 or b == 2 { 2 } else if a == 0 or b == 0 { 0 } else { 0 - 1 }

fn uc_best(fs: [UnwFn], n: String, acc: Int) : Int = match fs {
  [] -> acc
  [UF(m, c, _), ...rest] -> if m != n { uc_best(rest, n, acc) } else { uc_best(rest, n, unw_class_max(c, acc)) }
}

#[doc("The positions of the parameters the fn whose identity key is `k` borrows: none when no fn has it.")]
fn unw_fn_borrows(k: String, ucx: UnwCx) : [Int] = uc_borrows(ucx.fns[unw_bucket(k, array_length(ucx.fns))], k)

fn uc_borrows(fs: [UnwFn], n: String) : [Int] = match fs {
  [] -> []
  [UF(m, _, bs), ...rest] -> if m == n { bs } else { uc_borrows(rest, n) }
}

#[doc("True when a perform of the effect `s` can unwind.")]
fn unw_effect_unwinds(s: SymId, ucx: UnwCx) : Bool = ucx.all or unw_has_id(ucx.unw, s)

#[doc("True when `s` is the id of a declared effect.")]
fn unw_is_effect(ucx: UnwCx, s: SymId) : Bool = unw_has_id(ucx.eff_ids, s)

#[doc("True when `t` names a declared effect: a capability parameter, never owned.")]
pub(pkg) fn unw_is_cap_param(ucx: UnwCx, t: Option[TypeExpr]) : Bool = match t {
  Some(te) -> match te.tkind {
    TyName(r, _) -> unw_is_effect(ucx, ref_sym(r))
    _            -> false
  }
  None -> false
}

#[doc("True when a row with the labels `ls`, open or not, can unwind.")]
fn unw_labels(ls: [RowLabel], open: Bool, ucx: UnwCx) : Bool =
  if ucx.all { open or ls != [] }
  else { open or any(ls, (l) => unw_has_id(ucx.unw, rl_sym(l))) }

#[doc("The ids of the types `decls` declares that can carry a closure.")]
fn unw_carriers(decls: [Decl]) : [Int] = uc_fix(decls, uc_step(decls, [], []))

fn uc_fix(decls: [Decl], cs: [Int]) : [Int] = {
  let more = uc_step(decls, cs, cs)
  if list_length(more) == list_length(cs) { cs } else { uc_fix(decls, more) }
}

fn uc_step(decls: [Decl], cs: [Int], acc: [Int]) : [Int] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DType(_, s, _, body, _, _, _, _) ->
      if sym_raw(s) >= 0 and not unw_has_id(acc, s) and uc_body(body, cs) { uc_step(rest, cs, [sym_raw(s), ...acc]) }
      else { uc_step(rest, cs, acc) }
    _ -> uc_step(rest, cs, acc)
  }
}

fn uc_body(b: TypeBody, cs: [Int]) : Bool = match b {
  TBAlias(t)       -> uc_te(t, cs)
  TBRecord(fs)     -> uc_fields(fs, cs)
  TBSum(vs)        -> uc_variants(vs, cs)
  TBEffectAlias(_) -> false
}

fn uc_fields(fs: [FieldDecl], cs: [Int]) : Bool = match fs {
  [] -> false
  [FD(_, _, t, _), ...rest] -> uc_te(t, cs) or uc_fields(rest, cs)
}

fn uc_variants(vs: [Variant], cs: [Int]) : Bool = match vs {
  [] -> false
  [Var(_, ts), ...rest] -> uc_tes(ts, cs) or uc_variants(rest, cs)
}

fn uc_tes(ts: [TypeExpr], cs: [Int]) : Bool = match ts {
  [] -> false
  [t, ...rest] -> uc_te(t, cs) or uc_tes(rest, cs)
}

# A spelling the parser keeps for the formatter is dissolved before this
# runs; it counts as carrying, the safe answer.
fn uc_te(t: TypeExpr, cs: [Int]) : Bool = match t.tkind {
  TyFn(_, _, _)   -> true
  TyName(r, args)    -> unw_has_id(cs, ref_sym(r)) or uc_tes(args, cs)
  TyParam(_, args)   -> uc_tes(args, cs)
  TyList(a)       -> uc_te(a, cs)
  TyDim(a, _)     -> uc_te(a, cs)
  TyRefine(a, _, _)  -> uc_te(a, cs)
  TyRow(_)        -> true
  TySurface(_)    -> true
}

# Whether an argument of type `t` can bring an effect that unwinds: a
# closure whose row can, a value that can carry a closure, an unknown.
fn ue_carries(t: Option[Ty], ucx: UnwCx) : Bool = match t {
  Some(x) -> ue_ty_carries(x, ucx)
  None    -> true
}

fn ue_ty_carries(t: Ty, ucx: UnwCx) : Bool = match t {
  TyFnT(_, _, _)          -> unw_ty_unwinds(Some(t), ucx)
  TyListT(a)              -> ue_ty_carries(a, ucx)
  TyCon(s, args)          -> unw_has_id(ucx.carriers, s) or ue_tys_carry(args, ucx) or unw_effect_unwinds(s, ucx)
  TyDimT(a, _)            -> ue_ty_carries(a, ucx)
  TyRefineT(a, _, _)         -> ue_ty_carries(a, ucx)
  TyUnion(ts)             -> ue_tys_carry(ts, ucx)
  TyVarT(_)               -> true
  TyAny                   -> true
  TyShapeApp(_, _)        -> true
  _                       -> false
}

fn ue_tys_carry(ts: [Ty], ucx: UnwCx) : Bool = match ts {
  [] -> false
  [t, ...rest] -> ue_ty_carries(t, ucx) or ue_tys_carry(rest, ucx)
}

fn ue_args_carry(xs: [Expr], ucx: UnwCx) : Bool = match xs {
  [] -> false
  [x, ...rest] -> ue_arg_carries(x, ucx) or ue_args_carry(rest, ucx)
}

# A lambda literal brings what its body can do, whatever its row says; a
# mark around an argument changes who owns it, not what it can do. A dup
# wraps a bare read, and the wrap is the node that carries the type; a
# primitive mark or a tail step is no wrapper, its call stands on its own.
fn ue_arg_carries(x: Expr, ucx: UnwCx) : Bool = match x.kind {
  ELambda(_, body) -> unw_scan(body, ucx)
  ECall(g, [y]) -> match g.kind {
    EMark(MkDup) -> ue_carries(x.ty, ucx)
    EMark(m)     -> if mark_is_prim(m) or mark_is_tail_step(m) { ue_carries(x.ty, ucx) } else { ue_arg_carries(y, ucx) }
    _            -> ue_carries(x.ty, ucx)
  }
  _ -> ue_carries(x.ty, ucx)
}

# ---- the scan --------------------------------------------------------------

#[doc("Whether `e` holds a `!` it runs in place.")]
pub(pkg) fn unw_has_exit(e: Expr) : Bool = xp_exists(e, true, xp_is_bang)

#[doc("Whether any call `e` makes in place may unwind, or a `!` in it may return early; a lambda or clause body runs in its own frame.")]
pub(pkg) fn unw_scan(e: Expr, ucx: UnwCx) : Bool = unw_scan_node(e, ucx) or ue_scan_ps(xp_positions(e), ucx)

#[doc("Whether `e` itself, not its children, is a call that may unwind or a `!`.")]
pub(pkg) fn unw_scan_node(e: Expr, ucx: UnwCx) : Bool = match e.kind {
  EBang(_)     -> true
  ECall(f, xs) -> ue_call(f, xs, [], true, ucx)
  _ -> false
}

fn ue_scan_ps(ps: [XPos], ucx: UnwCx) : Bool = match ps {
  [] -> false
  [XP(r, c), ...rest] -> (xrole_inline(r) and unw_scan(c, ucx)) or ue_scan_ps(rest, ucx)
}

#[doc("""
True when the call of `f` on `xs` can unwind. A callee that reads one of
`locals` is a closure, judged by its type; a fn by its declared row; a
perform by its effect. Tail-call sentinels and marks other than the
borrowing indirect call are not calls.
""")]
pub(pkg) fn unw_call_unwinds(f: Expr, xs: [Expr], locals: [LocalId], ucx: UnwCx) : Bool = ue_call(f, xs, locals, false, ucx)

# `scan` also judges a fn callee by its type, which covers a closure the
# scan cannot tell from a fn: it must answer yes wherever the walk does.
fn ue_call(f: Expr, xs: [Expr], locals: [LocalId], scan: Bool, ucx: UnwCx) : Bool = match f.kind {
  EMark(MkApplyBorrow) -> match xs {
    [clo, ..._] -> unw_ty_unwinds(clo.ty, ucx)
    []          -> false
  }
  EMark(_) -> false
  ELocal(l) -> if unw_has(locals, l) { unw_ty_unwinds(f.ty, ucx) } else { ue_fn(f, 0 - 1, xs, scan, ucx) }
  EOp(r) -> unw_effect_unwinds(r.eff, ucx)
  ESym(s, inst) -> ue_fn(f, unw_fn_class(bv_fid_key(FnId(s, inst)), ucx), xs, scan, ucx)
  _ -> unw_ty_unwinds(f.ty, ucx)
}

#[doc("The binders read bare at a position the callee `f` borrows: the call hands none of them over, so they stay pending past it.")]
pub(pkg) fn unw_lent_reads(f: Expr, xs: [Expr], ucx: UnwCx) : [LocalId] = match ue_borrowed_slots(f, ucx) {
  [] -> []
  bs -> ue_reads_at(xs, bs, 0)
}

# Perceus names a lending builtin only where the caller keeps its reference.
fn ue_borrowed_slots(f: Expr, ucx: UnwCx) : [Int] =
  if ue_lends(f) { [0] }
  else { match ue_callee_key(f) {
    Some(k) -> unw_fn_borrows(k, ucx)
    None    -> []
  } }

fn ue_lends(f: Expr) : Bool = match builtin_ref(f) {
  Some(b) -> builtin_is_lending_form(b)
  None    -> false
}

fn ue_callee_key(f: Expr) : Option[String] = match f.kind {
  ESym(s, inst) -> Some(bv_fid_key(FnId(s, inst)))
  _ -> None
}

fn ue_reads_at(xs: [Expr], bs: [Int], i: Int) : [LocalId] = match xs {
  [] -> []
  [x, ...rest] -> match x.kind {
    ELocal(l) -> if list_has_int(bs, i) { [l, ...ue_reads_at(rest, bs, i + 1)] } else { ue_reads_at(rest, bs, i + 1) }
    _ -> ue_reads_at(rest, bs, i + 1)
  }
}

fn list_has_int(xs: [Int], x: Int) : Bool = match xs {
  [] -> false
  [y, ...rest] -> y == x or list_has_int(rest, x)
}

# A fn is judged by the class `c` of its declared row; a local or a
# builtin has no declared row. The scan cannot tell a local closure from
# a fn, so it also asks the callee's type.
fn ue_fn(f: Expr, c: Int, xs: [Expr], scan: Bool, ucx: UnwCx) : Bool =
  if c == 1 { true }
  else if c == 2 { ue_args_carry(xs, ucx) }
  else if c == 0 { false }
  else { scan and unw_ty_unwinds(f.ty, ucx) }

#[doc("The unwind context of a program: its decls and every handler clause in them.")]
pub(pkg) fn unw_cx(decls: [Decl], clauses: [ClauseInfo]) : UnwCx = unw_cx_seeded(decls, clauses, unw_seed_none())

#[doc("`unw_cx` for a program whose analysis also starts from `seed`.")]
pub(pkg) fn unw_cx_seeded(decls: [Decl], clauses: [ClauseInfo], seed: UnwSeed) : UnwCx = {
  let c = ue_cx_of(decls, unw_clauses(clauses, decls), seed)
  UnwCx { ...c, handles: ue_handle_fns(clauses, []) }
}

#[doc("Whether `d` feeds the unwind analysis, which reads every function: one that handles an effect or whose row may cancel. A cut that dropped it would change what the rest of the program unwinds through.")]
pub(pkg) fn unw_feeds_analysis(d: Decl) : Bool = match d {
  DFn(_, _, _, _, _, row, body, _, _, _) -> ue_row_cancels(row) or xp_exists(body, false, ue_is_handle)
  _ -> false
}

# A `var` lowers to a handler, so a block that declares one handles too.
fn ue_is_handle(e: Expr) : Bool = match e.kind {
  EHandle(_, _, _, _, _, _, _) -> true
  EBlock(ss, _) -> ue_has_var(ss)
  _ -> false
}

fn ue_has_var(ss: [Stmt]) : Bool = match ss {
  [] -> false
  [s, ...rest] -> match s {
    SVar(_, _, _, _, _) -> true
    _ -> ue_has_var(rest)
  }
}

#[doc("The effects the handlers in `own` make unwind, within the program `decls`, and whether every fn row may cancel.")]
pub(pkg) type UnwEffects = UnwEffects(Bool, [Int])

#[doc("The unwinding effects of the handlers `own` write, as the fixpoint over `decls` settles them.")]
pub(pkg) fn unw_effects_of(own: [Decl], decls: [Decl]) : UnwEffects =
  if ue_rows_cancel(decls) { UnwEffects(true, []) }
  else {
    let hs = unw_handle_clauses(own)
    UnwEffects(false, ue_fix(hs, decls, unw_carriers(decls), unw_abandoning(hs, [sym_raw(core_effect_id(CeCancel))])))
  }

#[doc("The unwind context of `decls` before their clauses are lifted, for a program whose analysis starts from `seed`: each `handle` brings its own; no fn is marked as installing one.")]
pub(pkg) fn unw_cx_decls_seeded(decls: [Decl], seed: UnwSeed) : UnwCx = ue_cx_of(decls, unw_handle_clauses(decls), seed)

fn ue_cx_of(decls: [Decl], hs: [UnwClause], seed: UnwSeed) : UnwCx = {
  let all = ue_rows_cancel(decls) or seed.all
  let carriers = unw_carriers(decls)
  let start = ue_seeded(seed.effects, unw_abandoning(hs, [sym_raw(core_effect_id(CeCancel))]))
  let unw = if all { [] } else { ue_fix(hs, decls, carriers, start) }
  ue_cx(decls, carriers, unw, all)
}

fn ue_seeded(effects: [SymId], acc: [Int]) : [Int] = match effects {
  [] -> acc
  [s, ...rest] -> ue_seeded(rest, if sym_raw(s) < 0 or unw_has_id(acc, s) { acc } else { [sym_raw(s), ...acc] })
}

fn ue_cx(decls: [Decl], carriers: [Int], unw: [Int], all: Bool) : UnwCx = {
  let base = UnwCx { eff_ids: ue_effect_ids(decls, []), fns: array_make(1, []), unw: unw,
                     all: all, carriers: carriers, handles: [] }
  UnwCx { ...base, fns: ue_table(decls, base) }
}

fn ue_effect_ids(decls: [Decl], acc: [Int]) : [Int] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DEffect(_, s, _, _, _, _, _, _) -> ue_effect_ids(rest, if sym_raw(s) >= 0 { [sym_raw(s), ...acc] } else { acc })
    _ -> ue_effect_ids(rest, acc)
  }
}

fn ue_handle_fns(cs: [ClauseInfo], acc: [EncUnit]) : [EncUnit] = match cs {
  [] -> acc
  [CI(_, _, _, _, _, _, _, enc, _, _, _), ...rest] -> ue_handle_fns(rest, if unit_in(acc, enc.unit) { acc } else { [enc.unit, ...acc] })
}

fn ue_table(decls: [Decl], ucx: UnwCx) : Array[[UnwFn]] = {
  let t = array_make(1024, [])
  foreach(decls, (d) => match d {
    DFn(_, fid, _, ps, _, row, body, _, _, _) -> {
      let k = bv_fid_key(fid)
      let b = unw_bucket(k, 1024)
      let lent = if body_has_raw_entry(body) { boxed_param_positions(ps, 0) } else { ue_borrowed(ps, 0) }
      t[b] := [UF(k, unw_row_class(row, ucx), lent), ...t[b]]
    }
    _ -> ()
  })
  t
}

fn ue_borrowed(ps: [Param], i: Int) : [Int] = match ps {
  [] -> []
  [p, ...rest] -> if p.pborrow { [i, ...ue_borrowed(rest, i + 1)] } else { ue_borrowed(rest, i + 1) }
}

# ---- cancellation from outside -------------------------------------------

fn ue_rows_cancel(decls: [Decl]) : Bool = match decls {
  [] -> false
  [d, ...rest] -> match d {
    DFn(_, _, _, _, _, row, _, _, _, _) -> ue_row_cancels(row) or ue_rows_cancel(rest)
    _ -> ue_rows_cancel(rest)
  }
}

fn ue_row_cancels(row: RowExpr) : Bool = match row {
  REmpty       -> false
  RClosed(ls)  -> ue_cancel_label(ls)
  ROpen(_, ls) -> ue_cancel_label(ls)
}

fn ue_cancel_label(ls: [RowLabel]) : Bool =
  any(ls, (l) => effect_is_any(rl_sym(l), [CeSpawn, CeLink]))

# Adds every effect one of whose clauses can unwind, until none is added.
fn ue_fix(hs: [UnwClause], decls: [Decl], carriers: [Int], unw: [Int]) : [Int] = {
  let ucx = ue_cx(decls, carriers, unw, false)
  let more = ue_unwinding_clauses(hs, ucx, unw)
  if list_length(more) == list_length(unw) { unw } else { ue_fix(hs, decls, carriers, more) }
}

fn ue_unwinding_clauses(hs: [UnwClause], ucx: UnwCx, acc: [Int]) : [Int] = match hs {
  [] -> acc
  [UnwC(eff, k, body), ...rest] ->
    if sym_raw(eff) < 0 or unw_has_id(acc, eff) or not ue_clause_unwinds(body, k, ucx) { ue_unwinding_clauses(rest, ucx, acc) }
    else { ue_unwinding_clauses(rest, ucx, [sym_raw(eff), ...acc]) }
}

# A clause's resume in tail position returns into the perform: only its
# arguments can unwind there.
fn ue_clause_unwinds(e: Expr, k: LocalId, ucx: UnwCx) : Bool = match e.kind {
  ECall(f, xs) -> if unw_reads_continuation(f, k) { ue_any_scan(xs, ucx) } else { unw_scan(e, ucx) }
  EBlock(ss, Some(t)) -> ue_stmts_scan(ss, ucx) or ue_clause_unwinds(t, k, ucx)
  EIf(c, t, Some(el)) -> unw_scan(c, ucx) or ue_clause_unwinds(t, k, ucx) or ue_clause_unwinds(el, k, ucx)
  _ -> unw_scan(e, ucx)
}

fn ue_any_scan(xs: [Expr], ucx: UnwCx) : Bool = match xs {
  [] -> false
  [x, ...rest] -> unw_scan(x, ucx) or ue_any_scan(rest, ucx)
}

fn ue_stmts_scan(ss: [Stmt], ucx: UnwCx) : Bool = unw_scan(mk_expr(EBlock(ss, None), 0, 0), ucx)

#[doc("True when a match on `s` owns its scrutinee (it is not a borrow).")]
pub(pkg) fn unw_scr_owned(s: Expr) : Bool = match s.kind {
  ECall(f, _) -> match f.kind {
    EMark(MkBorrow) -> false
    _               -> true
  }
  _ -> true
}

#[doc("True when `xs` holds the binder `l`.")]
pub(pkg) fn unw_has(xs: [LocalId], l: LocalId) : Bool = match xs {
  [] -> false
  [x, ...rest] -> local_eq(x, l) or unw_has(rest, l)
}

# A binder a pattern still holds binds a local whatever its name: one
# nothing reads is a wildcard by the time a frame is built.
#[doc("The locals the binders `bs` bind, each holding a reference of its own.")]
pub(pkg) fn unw_rc_binders(bs: [Binder]) : [LocalId] = ub_ids(bs)

fn ub_ids(bs: [Binder]) : [LocalId] = match bs {
  [] -> []
  [b, ...rest] -> [b.id, ...ub_ids(rest)]
}

#[doc("The binders of every owned match's arms and destructuring `let` in `e`, after `acc`.")]
pub(pkg) fn unw_arm_binders(e: Expr, acc: [LocalId]) : [LocalId] = match e.kind {
  EMatch(s, arms) -> uw_arm_binders_arms(arms, unw_scr_owned(s), unw_arm_binders(s, acc))
  EBlock(ss, _) -> uw_arm_binders_ps(xp_positions(e), list_append(uw_let_binders(ss), acc))
  ELambda(_, _) -> acc
  EIntrinsic(name, xs) ->
    if unw_is_loop(name) { uw_arm_binders_loop(xs, acc) } else { uw_arm_binders_ps(xp_positions(e), acc) }
  _ -> uw_arm_binders_ps(xp_positions(e), acc)
}

fn uw_arm_binders_ps(ps: [XPos], acc: [LocalId]) : [LocalId] = match ps {
  [] -> acc
  [XP(r, c), ...rest] -> uw_arm_binders_ps(rest, if xrole_inline(r) { unw_arm_binders(c, acc) } else { acc })
}

fn uw_arm_binders_arms(arms: [Arm], owned: Bool, acc: [LocalId]) : [LocalId] = match arms {
  [] -> acc
  [Arm(pat, og, b), ...rest] -> {
    let own = if owned { list_append(unw_rc_binders(pat_binders(pat, [])), acc) } else { acc }
    let a1 = match og { None -> own Some(g) -> unw_arm_binders(g, own) }
    uw_arm_binders_arms(rest, owned, unw_arm_binders(b, a1))
  }
}

fn uw_let_binders(ss: [Stmt]) : [LocalId] = match ss {
  [] -> []
  [SLet(pat, _, _), ...rest] -> list_append(unw_destructured(pat), uw_let_binders(rest))
  [_, ...rest] -> uw_let_binders(rest)
}

#[doc("The binders a destructuring `let` pattern owns, each bound with a reference of its own; none for a plain binder or `_`.")]
pub(pkg) fn unw_destructured(pat: Pattern) : [LocalId] = match pat.pkind {
  PBind(_) -> []
  PWild    -> []
  _        -> unw_rc_binders(pat_binders(pat, []))
}

fn uw_arm_binders_loop(xs: [Expr], acc: [LocalId]) : [LocalId] = match xs {
  [] -> acc
  [x, ...rest] -> {
    let b = match x.kind { ELambda(_, body) -> body _ -> x }
    uw_arm_binders_loop(rest, unw_arm_binders(b, acc))
  }
}

#[doc("True when `i` is a loop intrinsic whose lambda body is pasted inline.")]
pub(pkg) fn unw_is_loop(i: Intrinsic) : Bool = match i {
  InLoopWhile  -> true
  InLoopUntil  -> true
  InLoopRepeat -> true
  _            -> false
}

#[doc("Every binder `e` introduces, after `acc`, repeats kept; lambda bodies other than pasted loop bodies are other frames.")]
pub(pkg) fn unw_binders(e: Expr, acc: [LocalId]) : [LocalId] = match e.kind {
  EBlock(ss, ot) -> uw_binders_opt(ot, uw_binders_stmts(ss, acc))
  EMatch(s, arms) -> uw_binders_arms(arms, unw_binders(s, acc))
  ELambda(_, _) -> acc
  EIntrinsic(name, xs) ->
    if unw_is_loop(name) { uw_binders_loop(xs, acc) } else { uw_binders_ps(xp_positions(e), acc) }
  EHandle(body, _, _, oi, _, _, oret) -> {
    let a1 = unw_binders(body, uw_binders_opt(oi, acc))
    match oret {
      None -> a1
      Some(HR(p, b, _, _)) -> unw_binders(b, [p.id, ...a1])
    }
  }
  _ -> uw_binders_ps(xp_positions(e), acc)
}

fn uw_binders_ps(ps: [XPos], acc: [LocalId]) : [LocalId] = match ps {
  [] -> acc
  [XP(r, c), ...rest] -> if xrole_inline(r) { uw_binders_ps(rest, unw_binders(c, acc)) } else { uw_binders_ps(rest, acc) }
}

fn uw_binders_opt(o: Option[Expr], acc: [LocalId]) : [LocalId] = match o {
  None    -> acc
  Some(x) -> unw_binders(x, acc)
}

fn uw_binders_stmts(ss: [Stmt], acc: [LocalId]) : [LocalId] = match ss {
  [] -> acc
  [s, ...rest] -> {
    let inner = uw_binders_ps(xp_positions(Expr { kind: EBlock([s], None), line: 0, col: 0, ty: None, mode: MUnknown , site: 0 }), acc)
    uw_binders_stmts(rest, list_append(unw_stmt_binders(s), inner))
  }
}

fn uw_binders_arms(arms: [Arm], acc: [LocalId]) : [LocalId] = match arms {
  [] -> acc
  [Arm(pat, og, b), ...rest] ->
    uw_binders_arms(rest, unw_binders(b, uw_binders_opt(og, list_append(ub_ids(pat_binders(pat, [])), acc))))
}

fn uw_binders_loop(xs: [Expr], acc: [LocalId]) : [LocalId] = match xs {
  [] -> acc
  [x, ...rest] -> match x.kind {
    ELambda(ps, b) -> uw_binders_loop(rest, unw_binders(b, list_append(map(ps, (p) => p.binder.id), acc)))
    _ -> uw_binders_loop(rest, unw_binders(x, acc))
  }
}

#[doc("The binders `xs` holds more than once.")]
pub(pkg) fn unw_dups(xs: [LocalId], seen: [LocalId], acc: [LocalId]) : [LocalId] = match xs {
  [] -> acc
  [x, ...rest] ->
    if unw_has(seen, x) { unw_dups(rest, seen, if unw_has(acc, x) { acc } else { [x, ...acc] }) }
    else { unw_dups(rest, [x, ...seen], acc) }
}

#[doc("The binders of `xs` not in `ys`, in order.")]
pub(pkg) fn unw_minus(xs: [LocalId], ys: [LocalId]) : [LocalId] = if ub_meets(xs, ys) { ub_minus(xs, ys) } else { xs }

fn ub_minus(xs: [LocalId], ys: [LocalId]) : [LocalId] = match xs {
  [] -> []
  [x, ...rest] -> if unw_has(ys, x) { ub_minus(rest, ys) } else { [x, ...ub_minus(rest, ys)] }
}

fn ub_meets(xs: [LocalId], ys: [LocalId]) : Bool = match xs {
  [] -> false
  [x, ...rest] -> unw_has(ys, x) or ub_meets(rest, ys)
}

fn ub_within(xs: [LocalId], ys: [LocalId]) : Bool = match xs {
  [] -> true
  [x, ...rest] -> unw_has(ys, x) and ub_within(rest, ys)
}

#[doc("The binders of `xs` also in `ys`, in order.")]
pub(pkg) fn unw_inter(xs: [LocalId], ys: [LocalId]) : [LocalId] = if ub_within(xs, ys) { xs } else { ub_inter(xs, ys) }

fn ub_inter(xs: [LocalId], ys: [LocalId]) : [LocalId] = match xs {
  [] -> []
  [x, ...rest] -> if unw_has(ys, x) { [x, ...ub_inter(rest, ys)] } else { ub_inter(rest, ys) }
}

#[doc("`xs` plus the binders of `ys` it lacks.")]
pub(pkg) fn unw_union(xs: [LocalId], ys: [LocalId]) : [LocalId] = match ys {
  [] -> xs
  [y, ...rest] -> if unw_has(xs, y) { unw_union(xs, rest) } else { unw_union([y, ...xs], rest) }
}

#[doc("The binders statement `s` binds.")]
pub(pkg) fn unw_stmt_binders(s: Stmt) : [LocalId] = match s {
  SLet(pat, _, _)        -> ub_ids(pat_binders(pat, []))
  SVar(b, _, _, _, _)    -> [b.id]
  _                      -> []
}

#[doc("True when `e` reads a variable as is: the frame holds that reference until the construct reading it runs.")]
pub(pkg) fn unw_bare_read(e: Expr) : Bool = match e.kind {
  ELocal(_)  -> true
  ESym(_, _) -> true
  EOp(_)     -> true
  _          -> false
}

#[doc("True when both captures take the same local's value, or the same alias's handler id.")]
fn capture_same(a: Capture, b: Capture) : Bool = match a {
  CapLocal(x) -> match b { CapLocal(y) -> local_eq(x, y)  CapAlias(_) -> false }
  CapAlias(x) -> match b { CapAlias(y) -> local_eq(x, y)  CapLocal(_) -> false }
}

#[doc("The position of `c` among `caps`, or -1 when it is not one of them.")]
pub(pkg) fn capture_index(caps: [Capture], c: Capture) : Int = capture_index_from(caps, c, 0)

fn capture_index_from(caps: [Capture], c: Capture, i: Int) : Int = match caps {
  []          -> 0 - 1
  [h, ...rest] -> if capture_same(h, c) { i } else { capture_index_from(rest, c, i + 1) }
}

#[doc("Every capture of `a` that `b` lacks, in order, then `b`.")]
fn merge_capture_set(a: [Capture], b: [Capture]) : [Capture] = match a {
  []          -> b
  [h, ...rest] ->
    if any(b, (x) => capture_same(x, h)) { merge_capture_set(rest, b) }
    else { [h, ...merge_capture_set(rest, b)] }
}

#[doc("The union of the captures of every clause of the handle at `(hline, hcol)` inside the unit `enc`: the layout of its env.")]
pub(pkg) fn handle_captures_at(cls: [ClauseInfo], enc: EncFn, hline: Int, hcol: Int) : [Capture] = match cls {
  [] -> []
  [CI(line, col, _, _, _, _, _, enc_fn, caps, _, _), ...rest] ->
    if line == hline and col == hcol and enc_same(enc_fn, enc) {
      merge_capture_set(caps, handle_captures_at(rest, enc, hline, hcol))
    } else { handle_captures_at(rest, enc, hline, hcol) }
}
