#[doc("""
Which handler clauses can finish without resuming: those make their
effect one that unwinds. A clause resumes only when every path through
its body calls its continuation; a runtime default handler resumes.
""")]

import compiler.ast
import compiler.util
import compiler.emit_shared
import compiler.effect_default

#[doc("Every op clause of the program: its handlers' and its effects' default blocks.")]
pub fn unw_clauses(cs: [ClauseInfo], decls: [Decl]) : [UnwClause] = list_append(ue_clauses(cs), ue_default_clauses(decls, []))

#[doc("True when one of the effects `names` is in `set`.")]
pub fn unw_any_effect_in(names: [String], set: [String]) : Bool = match names {
  [] -> false
  [n, ...rest] -> list_has(set, unw_bare_effect(n)) or unw_any_effect_in(rest, set)
}

#[doc("The effect `e` names without its module qualifier.")]
pub fn unw_bare_effect(e: String) : String = {
  let d = unw_last_dot(e)
  if d < 0 { e } else { string_slice(e, d + 1, string_length(e) - d - 1) }
}

#[doc("Index of the last `.` in `s`, or -1.")]
pub fn unw_last_dot(s: String) : Int = ue_dot_before(s, string_length(s) - 1)

fn ue_dot_before(s: String, i: Int) : Int =
  if i < 0 or string_byte_at_int(s, i) == 46 { i } else { ue_dot_before(s, i - 1) }

#[doc("A handler clause: its effect, its continuation's name and its body.")]
pub type UnwClause = UnwC(String, String, Expr)

fn ue_clauses(cs: [ClauseInfo]) : [UnwClause] = match cs {
  [] -> []
  [CI(_, _, eff, _, params, body, _, _, _, _, _), ...rest] -> match ue_resume_name(params) {
    Some(k) -> [UnwC(unw_bare_effect(eff), k, body), ...ue_clauses(rest)]
    None    -> ue_clauses(rest)
  }
}

fn ue_default_clauses(decls: [Decl], acc: [UnwClause]) : [UnwClause] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DEffect(_, name, _, _, Some(DBlk(hcs, _, _, _)), _, _, _, _) ->
      ue_default_clauses(rest, ue_hclauses(name, hcs, acc))
    _ -> ue_default_clauses(rest, acc)
  }
}

fn ue_hclauses(eff: String, hcs: [HClause], acc: [UnwClause]) : [UnwClause] = match hcs {
  [] -> acc
  [HC(_, params, body, _, _), ...rest] -> match ue_resume_name(params) {
    Some(k) -> ue_hclauses(eff, rest, [UnwC(unw_bare_effect(eff), k, body), ...acc])
    None    -> ue_hclauses(eff, rest, acc)
  }
}

# An op clause's continuation is its last parameter; `finally { }` has none.
fn ue_resume_name(ps: [Param]) : Option[String] = match ps {
  []           -> None
  [p]          -> Some(p.pname)
  [_, ...rest] -> ue_resume_name(rest)
}

#[doc("`acc` plus every effect one of the clauses `hs` can finish without resuming.")]
pub fn unw_abandoning(hs: [UnwClause], acc: [String]) : [String] = match hs {
  [] -> acc
  [UnwC(eff, k, body), ...rest] ->
    if list_has(acc, eff) or ue_resumes(body, k) { unw_abandoning(rest, acc) }
    else { unw_abandoning(rest, [eff, ...acc]) }
}

# Every path through `e` calls the continuation `k`. A runtime default
# handler resumes; the one that does not, `Cancel`'s, is counted apart.
fn ue_resumes(e: Expr, k: String) : Bool = match extern_handler_c_symbol(e) {
  Some(_) -> true
  None    -> ue_resumes_kind(e, k)
}

fn ue_resumes_kind(e: Expr, k: String) : Bool = match e.kind {
  ECall(f, xs) -> (match f.kind { EVar(n) -> n == k _ -> false }) or ue_any_resumes(xs, k)
  EBlock(ss, ot) -> ue_stmts_resume(ss, k) or (match ot { Some(t) -> ue_resumes(t, k) None -> false })
  EIf(c, t, oe) -> ue_resumes(c, k) or (match oe {
    Some(el) -> ue_resumes(t, k) and ue_resumes(el, k)
    None     -> false
  })
  EMatch(s, arms) -> ue_resumes(s, k) or (arms != [] and ue_arms_resume(arms, k))
  _ -> false
}

fn ue_any_resumes(xs: [Expr], k: String) : Bool = match xs {
  [] -> false
  [x, ...rest] -> ue_resumes(x, k) or ue_any_resumes(rest, k)
}

fn ue_stmts_resume(ss: [Stmt], k: String) : Bool = match ss {
  [] -> false
  [s, ...rest] -> (match s {
    SLet(_, _, rhs) -> ue_resumes(rhs, k)
    SExprStmt(x)    -> ue_resumes(x, k)
    _               -> false
  }) or ue_stmts_resume(rest, k)
}

fn ue_arms_resume(arms: [Arm], k: String) : Bool = match arms {
  [] -> true
  [Arm(_, _, b), ...rest] -> ue_resumes(b, k) and ue_arms_resume(rest, k)
}
