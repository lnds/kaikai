#[doc("""
Known nullary constructors.

A register whose every definition is a nullary constructor, or a copy of such
a register, only ever holds an immortal cell. Its tag is read from a shadow
`i32` register kept beside it instead of from memory, and its dups and drops
are no-ops, so a join of nullary values reaches a `switch` as constants the
backend folds into the branches. The cell itself stays for every other use.
""")]

import compiler.kir
import compiler.util

#[doc("`kp` with the tag reads and RC ops of known nullary registers resolved statically.")]
pub(pkg) fn kir_nullary_program(kp: KProgram) : KProgram =
  KProgram { ...kp, fns: map(kp.fns, nl_fn) }

fn nl_max_stmts() : Int = 600

type NlDef = NlCon(Int) | NlCopy(String) | NlNeutral | NlBad

type NlRow = NlRow(String, NlDef)

fn nl_fn(f: KFn) : KFn {
  let stmts = flat_map(f.blocks, .stmts)
  if list_length(stmts) > nl_max_stmts()
    or (not (any(stmts, nl_is_tagof) and any(stmts, nl_is_nullary)))
    or any(stmts, nl_is_handler) {
    f
  } else {
    match nl_known(f, stmts) {
      [] -> f
      known ->
        kfn_with_blocks(f, map(f.blocks, b => KBlock { ...b, stmts: nl_stmts(b.stmts, known) }))
    }
  }
}

fn nl_is_tagof(s: KStmt) : Bool = match s {
  KLet(_, _, KTagOf(_), _) -> true
  _ -> false
}

fn nl_is_nullary(s: KStmt) : Bool = match s {
  KLet(_, _, KCon(_, _, _, [], _), _) -> true
  _ -> false
}

fn nl_is_handler(s: KStmt) : Bool = match s {
  KInstall(_, _, _, _, _, _) -> true
  KPop(_, _, _) -> true
  KLet(_, _, KSetjmp(_, _), _) -> true
  KBindEvState(_, _, _, _) -> true
  KBindSelfState(_, _) -> true
  _ -> false
}

# ---- which registers are known ------------------------------------------

fn nl_known(f: KFn, stmts: [KStmt]) : [String] {
  let rows = list_append(
    map(f.params, p => NlRow(p.name, NlBad)),
    flat_map(stmts, nl_rows)
  )
  nl_fix(nl_names(rows, []), rows)
}

fn nl_names(rows: [NlRow], acc: [String]) : [String] = match rows {
  [] -> acc
  [NlRow(n, _), ...rest] -> nl_names(rest, if list_has(acc, n) { acc } else { [n, ...acc] })
}

fn nl_rows(s: KStmt) : [NlRow] = match s {
  KLet(n, SBoxed, op, _) -> [NlRow(n, nl_op_def(op))]
  KLet(n, _, _, _) -> [NlRow(n, NlBad)]
  KStore(n, v, _) -> [NlRow(n, nl_val_def(v))]
  KRC(KArmTake(_, bs, _), _) -> flat_map(
    bs,
    b => match b {
      KVar(n) -> [NlRow(n, NlBad)]
      _ -> []
    }
  )
  _ -> []
}

fn nl_op_def(op: KOp) : NlDef = match op {
  KCon(_, tag, _, [], _) -> NlCon(tag)
  KLitOp(v) -> nl_val_def(v)
  _ -> NlBad
}

fn nl_val_def(v: KVal) : NlDef = match v {
  KVar(s) -> NlCopy(s)
  KUnitV -> NlNeutral
  _ -> NlBad
}

# The greatest set closed under copies: a register drops out when one of its
# definitions is not a nullary constructor or a copy of a register that stays.
fn nl_fix(cands: [String], rows: [NlRow]) : [String] {
  let keep = filter(cands, c => nl_defs_ok(c, cands, rows))
  if list_length(keep) == list_length(cands) { keep } else { nl_fix(keep, rows) }
}

fn nl_defs_ok(c: String, cands: [String], rows: [NlRow]) : Bool =
  all(
    rows,
    r => match r {
      NlRow(n, d) -> if n == c {
        match d {
          NlBad -> false
          NlCopy(s) -> list_has(cands, s)
          _ -> true
        }
      } else {
        true
      }
    }
  )

# ---- rewrite --------------------------------------------------------------

fn nl_shadow(n: String) : String = cat2(n, "$nt")

fn nl_stmts(ss: [KStmt], known: [String]) : [KStmt] = flat_map(ss, s => nl_stmt(s, known))

fn nl_stmt(s: KStmt, known: [String]) : [KStmt] = match s {
  KLet(n, SBoxed, op, pos) -> if list_has(known, n) {
    [s, KLet(nl_shadow(n), SInt32, KLitOp(nl_op_tag(op)), pos)]
  } else {
    [s]
  }
  KStore(n, v, pos) -> if list_has(known, n) {
    [s, KStore(nl_shadow(n), nl_val_tag(v), pos)]
  } else {
    [s]
  }
  KLet(x, SInt32, KTagOf(KVar(r)), pos) -> if list_has(known, r) {
    [KLet(x, SInt32, KLitOp(KVar(nl_shadow(r))), pos)]
  } else {
    [s]
  }
  KRC(KDup(KVar(r)), _) -> if list_has(known, r) { [] } else { [s] }
  KRC(KDrop(KVar(r)), _) -> if list_has(known, r) { [] } else { [s] }
  _ -> [s]
}

fn nl_op_tag(op: KOp) : KVal = match op {
  KCon(_, tag, _, _, _) -> KIntV(tag)
  KLitOp(v) -> nl_val_tag(v)
  _ -> KIntV(0)
}

fn nl_val_tag(v: KVal) : KVal = match v {
  KVar(s) -> KVar(nl_shadow(s))
  _ -> KIntV(0)
}
