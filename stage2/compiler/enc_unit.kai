#[doc("""
The unit a body is emitted into.

A lambda and a handler clause are lifted into functions of their own, and
neither is a declaration: what tells one from another is the unit it was
lifted out of and where it stands in it. That unit is a declared function,
a `test`, `bench` or `check` block, or another lifted body.

An emitter carries the unit beside the symbol it is emitted under. The
unit answers which lifted body a site means; the symbol is only written
out.
""")]

import compiler.ast_ids
import compiler.ast

#[doc("Which block a runner runs.")]
pub(pkg) type RunnerKind = RkTest | RkBench | RkCheck

#[doc("What a body is lifted out of: nothing, the function `FnId` declares, the runner of a block of a module at a position, or the lambda, clause or `finally` at a position inside another unit. A clause is told from its siblings by its op label.")]
pub(pkg) type EncUnit = EuNone
  | EuFn(FnId)
  | EuRunner(RunnerKind, Option[String], Int, Int)
  | EuLam(EncUnit, Int, Int)
  | EuClause(EncUnit, Int, Int, String)
  | EuFinally(EncUnit, Int, Int)

#[doc("A unit and the symbol it is emitted under.")]
pub(pkg) type EncFn = { unit: EncUnit, sym: String }

#[doc("No unit: a body emitted outside every function.")]
pub(pkg) fn enc_none() : EncFn = EncFn { unit: EuNone, sym: "" }

#[doc("The unit of the declared function `fid`, emitted as `sym`.")]
pub(pkg) fn enc_of_fn(fid: FnId, sym: String) : EncFn = EncFn { unit: EuFn(fid), sym: sym }

#[doc("The function a unit is, or the unresolved identity for a runner or a lifted body.")]
pub(pkg) fn enc_fn_id(e: EncFn) : FnId = match e.unit {
  EuFn(f) -> f
  _       -> fnid_none()
}

#[doc("True when `a` and `b` are the same unit.")]
pub(pkg) fn enc_same(a: EncFn, b: EncFn) : Bool = unit_same(a.unit, b.unit)

#[doc("True when two units are the same one.")]
pub(pkg) fn unit_same(a: EncUnit, b: EncUnit) : Bool = match (a, b) {
  (EuNone, EuNone)                               -> true
  (EuFn(f), EuFn(g))                             -> fnid_eq(f, g)
  (EuRunner(k, m, l, c), EuRunner(j, n, p, q))   -> l == p and c == q and kind_same(k, j) and m == n
  (EuLam(o, l, c), EuLam(u, p, q))               -> l == p and c == q and unit_same(o, u)
  (EuClause(o, l, c, w), EuClause(u, p, q, x))   -> l == p and c == q and w == x and unit_same(o, u)
  (EuFinally(o, l, c), EuFinally(u, p, q))       -> l == p and c == q and unit_same(o, u)
  _                                              -> false
}

fn kind_same(a: RunnerKind, b: RunnerKind) : Bool = match (a, b) {
  (RkTest, RkTest)   -> true
  (RkBench, RkBench) -> true
  (RkCheck, RkCheck) -> true
  _                  -> false
}

#[doc("True when `u` is one of `us`.")]
pub(pkg) fn unit_in(us: [EncUnit], u: EncUnit) : Bool = match us {
  []           -> false
  [h, ...rest] -> unit_same(h, u) or unit_in(rest, u)
}

#[doc("A segment continuation's parts: what it resumes with, the handle's type, and the body's row carrier.")]
pub(pkg) type ContParts = { arg: Ty, answer: Ty, row: Ty }

#[doc("The name source code writes the continuation type with.")]
pub(pkg) fn cont_name() : String = "Cont"

#[doc("Whether a type name in source names the continuation type.")]
pub(pkg) fn is_cont_name(n: String) : Bool = n == cont_name()

#[doc("The parts of `t` when it is a segment continuation `Cont[T, S, e]`.")]
pub(pkg) fn cont_parts(t: Ty) : Option[ContParts] = match t {
  TyCon(cs, [a, s, e]) -> if core_ty_is(cs, CtCont) { Some(ContParts { arg: a, answer: s, row: e }) } else { None }
  _ -> None
}

#[doc("The segment continuation type `Cont[arg, answer, row]`.")]
pub(pkg) fn cont_ty(arg: Ty, answer: Ty, row: Ty) : Ty = TyCon(core_ty_sym(CtCont), [arg, answer, row])
