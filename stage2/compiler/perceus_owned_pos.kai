#[doc("""
Dup-on-consume for borrowed binders.

A borrowed binder (a `^` param) arrives without a reference of its own, so
perceus never dups or drops it. Every position that takes ownership of a
value must still receive one: a bare read of a borrowed binder there is
dup'd. The owned positions are a `let` value, the fn's return value, a list
element or spread operand, a record field, and a call argument in a slot its
callee does not borrow (a ctor, an effect op, a closure call, a prim, or a
fn slot outside the callee's borrow map). A position yields its value
through `if`, `match` and block tails, and through perceus's own `__`-named
wrap of a tail value. No other read is touched.
""")]

import compiler.ast
import compiler.sym_read
import compiler.ast_map
import compiler.fnreg
import compiler.ret_slots
import compiler.util

type PopCx = { borrowed: [String], slots: (Expr) -> [Int] }

#[doc("Dup every bare read of a `borrowed` binder that an owned position of `body` yields; `slots` gives a callee's borrowed argument positions.")]
pub fn pop_own_positions(body: Expr, borrowed: [String], slots: (Expr) -> [Int]) : Expr = match borrowed {
  []         -> body
  [_, ...__] -> {
    let cx = PopCx { borrowed: borrowed, slots: slots }
    pop_value(pop_expr(body, cx), cx)
  }
}

fn pop_expr(e: Expr, cx: PopCx) : Expr =
  Expr { kind: pop_kind(prc_map_expr_kind(e.kind, (x) => pop_expr(x, cx)), cx),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn pop_kind(k: ExprKind, cx: PopCx) : ExprKind = match k {
  EBlock(stmts, tail)  -> EBlock(map(stmts, (s) => pop_stmt(s, cx)), tail)
  EList(els)           -> EList(map(els, (el) => pop_elem(el, cx)))
  ERecordLit(rh, nm, fis)  -> ERecordLit(rh, nm, map(fis, (fi) => pop_field(fi, cx)))
  ECall(f, args_)      -> if pop_is_sentinel(f) { k } else { ECall(f, pop_args(args_, cx.slots(f), 0, cx)) }
  _                    -> k
}

# A minted `let` passes its value through, so its rhs is owned only where
# the block's value is.
fn pop_stmt(s: Stmt, cx: PopCx) : Stmt = match s {
  SLet(pat, ann, rhs) -> if pop_is_wrap(pat) { s } else { SLet(pat, ann, pop_value(rhs, cx)) }
  _                   -> s
}

fn pop_elem(el: ListElem, cx: PopCx) : ListElem = match el {
  ElSpread(x) -> ElSpread(pop_value(x, cx))
  ElPlain(x)  -> ElPlain(pop_value(x, cx))
}

fn pop_field(fi: FieldInit, cx: PopCx) : FieldInit = match fi {
  FI(nm, v) -> FI(nm, pop_value(v, cx))
}

fn pop_args(args_: [Expr], borrowed_slots: [Int], i: Int, cx: PopCx) : [Expr] = match args_ {
  []           -> []
  [a, ...rest] -> {
    let a1 = if any(borrowed_slots, (p) => p == i) { a } else { pop_value(a, cx) }
    [a1, ...pop_args(rest, borrowed_slots, i + 1, cx)]
  }
}

# Perceus's own calls (the dup and drop marks) manage their operands.
fn pop_is_sentinel(f: Expr) : Bool = match sym_read_kind(f.kind) {
  EVar(nm)       -> string_starts_with_q(nm, "__")
  EModCall(_, _) -> false
  _              -> true
}

fn pop_is_wrap(pat: Pattern) : Bool = match pat.pkind {
  PBind(nm) -> pop_is_minted(nm)
  _         -> false
}

# A result slot, or a temporary an earlier pass named with the `__` prefix.
fn pop_is_minted(nm: String) : Bool = ret_slot_is_any(nm) or string_starts_with_q(nm, "__")

fn pop_value(e: Expr, cx: PopCx) : Expr = match sym_read_kind(e.kind) {
  EVar(nm) -> if list_has(cx.borrowed, nm) { pop_dup(e) } else { e }
  _        -> Expr { kind: pop_value_kind(e.kind, cx), line: e.line, col: e.col,
                     ty: e.ty, mode: e.mode,  site: e.site }
}

fn pop_value_kind(k: ExprKind, cx: PopCx) : ExprKind = match k {
  EIf(c, t, oe)       -> EIf(c, pop_value(t, cx), prc_map_opt_expr(oe, (x) => pop_value(x, cx)))
  EMatch(scr, arms)   -> EMatch(scr, map(arms, (a) => match a { Arm(p, g, b) -> Arm(p, g, pop_value(b, cx)) }))
  EBlock(stmts, tail) -> match tail {
    Some(t) -> EBlock(pop_wrapped(stmts, pop_tail_wrap(t), cx), Some(pop_value(t, cx)))
    None    -> k
  }
  _ -> k
}

# The wrap a block tail names, if the tail is a bare minted binder.
fn pop_tail_wrap(t: Expr) : String = match sym_read_kind(t.kind) {
  EVar(nm) -> if pop_is_minted(nm) { nm } else { "" }
  _        -> ""
}

fn pop_wrapped(stmts: [Stmt], wrap: String, cx: PopCx) : [Stmt] = match wrap {
  "" -> stmts
  _  -> map(stmts, (s) => match s {
    SLet(pat, ann, rhs) -> match pat.pkind {
      PBind(nm) -> if nm == wrap { SLet(pat, ann, pop_value(rhs, cx)) } else { s }
      _         -> s
    }
    _ -> s
  })
}

fn pop_dup(a: Expr) : Expr =
  Expr { kind: ECall(mk_expr(EMark(MkDup), a.line, a.col), [a]),
         line: a.line, col: a.col, ty: a.ty, mode: a.mode,  site: a.site }
