#[doc("""
The part of a program that shapes the text of a core translation unit: the
core effects its handlers make unwind. A core function that can unwind is
emitted with an unwind frame, so two programs that disagree here need
different core TU sets.
""")]

import compiler.util
import compiler.ast
import compiler.symtab
import compiler.user_cache
import compiler.unwind_effects
import compiler.unwind_clauses
import compiler.driver_exports

#[doc("The digest of the core effects the handlers of `decls` outside the core make unwind. `decls` is the resolved program, core included; `core_mods` are the core modules.")]
pub fn core_variant(decls: [Decl], tab: SymTab, core_mods: [String]) : String =
  match unw_effects_of(filter(decls, (d) => not cv_in_core(d, core_mods)), decls) {
    UnwEffects(all, unw) -> uc_content_hex(concat_all([
      if all { "all" } else { "some" }, "\n",
      string_join(cv_sort(cv_names(decls, unw, core_mods, tab, []), []), "\n")]))
  }

fn cv_in_core(d: Decl, core_mods: [String]) : Bool = match d {
  DFn(_, _, _, _, _, _, _, _, _, mo) -> cv_has(core_mods, mo)
  DType(_, _, _, _, _, _, mo, _)     -> cv_has(core_mods, mo)
  DEffect(_, _, _, _, _, _, _, mo)   -> cv_has(core_mods, mo)
  _                                  -> false
}

fn cv_has(mods: [String], mo: Option[String]) : Bool = match mo {
  Some(m) -> list_has(mods, m)
  None    -> false
}

fn cv_names(decls: [Decl], unw: [Int], core_mods: [String], tab: SymTab, acc: [String]) : [String] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DEffect(_, s, _, _, _, _, _, mo) ->
      cv_names(rest, unw, core_mods, tab, if cv_has(core_mods, mo) and unw_has_id(unw, s) { [export_name(tab, s), ...acc] } else { acc })
    _ -> cv_names(rest, unw, core_mods, tab, acc)
  }
}

fn cv_sort(xs: [String], sorted: [String]) : [String] = match xs {
  [] -> sorted
  [h, ...rest] -> cv_sort(rest, cv_insert(h, sorted))
}

fn cv_insert(x: String, sorted: [String]) : [String] = match sorted {
  [] -> [x]
  [h, ...rest] -> if string_lt(x, h) { [x, h, ...rest] } else { [h, ...cv_insert(x, rest)] }
}
