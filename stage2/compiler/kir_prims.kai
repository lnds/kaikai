#[doc("""
The spelling of the KIR primitives.

Which primitive a `KPrim` applies rides the node as a `PrimOp`
constructor, so the lowering that builds one and the passes that read it
agree by construction. The text survives only where it is printed: the
`--emit=kir` dump, the linearity check's diagnostics, and the runtime
symbol the native emitter links a helper call to.
""")]

import compiler.ast
import compiler.operators
import compiler.kir
import compiler.util

#[doc("The spelling of a primitive.")]
pub fn kprim_text(p: PrimOp) : String = match p {
  KpBin(op)                      -> binop_text(op)
  KpUn(op)                       -> kprim_un_text(op)
  KpRawBin(s, op)                -> cat2(kprim_raw_prefix(s, op), binop_text(op))
  KpRawUn(op)                    -> kprim_raw_un_text(op)
  KpBox(s)                       -> cat2(kprim_scalar_text(s), ".box")
  KpUnbox(s)                     -> cat2(kprim_scalar_text(s), ".unbox")
  KpField                        -> "kai_op_field"
  KpFieldAt                      -> "kai_op_field_at"
  KpFieldBorrow                  -> "kai_op_field_borrow"
  KpEqRaw                        -> "kai_eq_raw"
  KpTagEq                        -> "kai_tag_eq"
  KpNil                          -> "kai_nil"
  KpCons                         -> "kai_cons"
  KpArenaCons                    -> "kai_arena_cons"
  KpIsCons                       -> "kai_is_cons_b"
  KpIsNil                        -> "kai_is_nil_b"
  KpListAppend                   -> "kai_core_list_append"
  KpStringConcat                 -> "kai_core_string_concat"
  KpPanic                        -> "kai_core_panic"
  KpRange                        -> "kai_range"
  KpRangeStep                    -> "kai_range_step"
  KpVecGetField                  -> "kai_vec_get_field"
  KpVecGetFieldBorrow            -> "kai_vec_get_field_borrow"
  KpVecPushRecRaw                -> "kai_vec_push_rec_raw"
  KpVecSetRecRaw                 -> "kai_vec_set_rec_raw"
  KpAssertCheck                  -> "kai_assert_check"
  KpAssertCheckWithValue         -> "kai_assert_check_with_value"
  KpResumeFramesRun              -> "kai_resume_frames_run"
  KpResumeFramePush              -> "kai_resume_frame_push"
  KpSegHandle                    -> "kai_seg_handle"
  KpSegRequest                   -> "kai_seg_request"
  KpUnwFiber                     -> "kai_unw_fiber"
  KpUnwPush                      -> "kai_unw_push"
  KpUnwPushReg                   -> "kai_unw_push_reg"
  KpUnwPushState                 -> "kai_unw_push_state"
  KpUnwPop                       -> "kai_unw_pop"
  KpPadOpen                      -> "kai_pad_open"
  KpPadClose                     -> "kai_pad_close"
  KpFixedVecLit(elem, n)         -> kprim_fixed_vec_text("__fixed_vec_lit", elem, n)
  KpFixedVecMaterialize(elem, n) -> kprim_fixed_vec_text("__fixed_vec_materialize", elem, n)
  KpFixedVecGet(r, elem, n)      -> kprim_fixed_vec_text(kprim_vec_read_stem(r), elem, n)
}

# Negation is not spelled `-`: that is the two-operand subtraction.
fn kprim_un_text(op: UnOp) : String = match op {
  UoNeg -> "neg"
  UoNot -> "not"
}

fn kprim_raw_un_text(op: UnOp) : String = match op {
  UoNeg -> "fneg"
  UoNot -> "bnot"
}

# Bool has two families: `band` / `bor`, and the `b1` comparisons.
fn kprim_raw_prefix(s: RawScalar, op: BinOp) : String = match s {
  RwReal   -> "f"
  RwInt    -> "i"
  RwBool   -> if binop_is_logical(op) { "b" } else { "b1" }
  RwChar   -> "ch"
  RwByte   -> "u8"
  RwInt32  -> "i32"
  RwUInt32 -> "u32"
  RwUInt64 -> "u64"
  RwInt128 -> "i128"
}

fn kprim_scalar_text(s: RawScalar) : String = match s {
  RwReal   -> "real"
  RwInt    -> "int"
  RwBool   -> "bool"
  RwChar   -> "char"
  RwByte   -> "byte"
  RwInt32  -> "int32"
  RwUInt32 -> "uint32"
  RwUInt64 -> "uint64"
  RwInt128 -> "int128"
}

fn kprim_scalar_type_name(s: RawScalar) : String = match s {
  RwReal   -> "Real"
  RwInt    -> "Int"
  RwBool   -> "Bool"
  RwChar   -> "Char"
  RwByte   -> "Byte"
  RwInt32  -> "Int32"
  RwUInt32 -> "UInt32"
  RwUInt64 -> "UInt64"
  RwInt128 -> "Int128"
}

fn kprim_vec_read_stem(r: KVecRead) : String =
  concat_all([if r.heap { "__fixed_vec_dget" } else { "__fixed_vec_get" },
              if r.raw { "raw" } else { "" },
              if r.dyn { "_dyn" } else { "" }])

fn kprim_fixed_vec_text(stem: String, elem: RawScalar, n: Int) : String =
  concat_all([stem, "@", kprim_scalar_type_name(elem), "@", int_to_string(n)])

#[doc("The register slot a raw scalar lives in.")]
pub fn raw_scalar_slot(s: RawScalar) : KSlot = match s {
  RwReal   -> SReal
  RwInt    -> SInt64
  RwBool   -> SBool
  RwChar   -> SChar
  RwByte   -> SByte
  RwInt32  -> SInt32T
  RwUInt32 -> SUInt32
  RwUInt64 -> SUInt64
  RwInt128 -> SInt128
}
