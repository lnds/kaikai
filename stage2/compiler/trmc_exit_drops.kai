#[doc("""
Exit drops across a TRMC modulo-cons step.

Perceus runs an arm's exit drops after its value:
`{ let __pcs_arm_ret = INNER; drops; __pcs_arm_ret }`. The TRMC rewrite peels
that wrap to expose the modulo-cons ctor, so the drops move into each leaf of
the rewritten INNER. Both backends evaluate a step's ctor heads, then the
self-call's arguments, in order. A step binds the drops around the rightmost
boxed operand at or after the last read of a dropped binder, or around the
raw operand holding that read when no boxed one follows it. A bare self-call
that loops places them the same way among its args. An apply leaf binds them
around its whole value.

A binder passed bare into the self-call keeps its reference: that slot may
only borrow it. A Perceus reuse rebuild keeps no drops, since the native
apply lowering reads its shape.
""")]

import compiler.ast
import compiler.marks
import compiler.fnreg
import compiler.perceus_reads
import compiler.emit_shared
import compiler.perceus_plant_drop

#[doc("The drops a Perceus arm-ret wrap runs after its value; `[]` when `e` is no such wrap or holds anything but drops.")]
pub fn txd_wrap_drops(e: Expr) : [Stmt] = match e.kind {
  EBlock(stmts, Some(t)) -> txd_ret_drops(stmts, t.kind)
  _                      -> []
}

fn txd_ret_drops(stmts: [Stmt], k: ExprKind) : [Stmt] = match k {
  EVar(tn) -> if txd_is_ret_name(tn) { txd_only_drops(txd_after_let(stmts, tn)) } else { [] }
  _        -> []
}

fn txd_is_ret_name(tn: String) : Bool = tn == "__pcs_arm_ret" or tn == "__pcs_block_ret"

fn txd_after_let(stmts: [Stmt], tn: String) : [Stmt] = match stmts {
  []           -> []
  [s, ...rest] -> if txd_binds(s, tn) { rest } else { txd_after_let(rest, tn) }
}

fn txd_binds(s: Stmt, tn: String) : Bool = match s {
  SLet(pat, _, _) -> match pat.pkind {
    PBind(nm) -> nm == tn
    _         -> false
  }
  _ -> false
}

fn txd_only_drops(stmts: [Stmt]) : [Stmt] =
  if all(stmts, (s) => txd_named(ppd_drop_name(s))) { stmts } else { [] }

fn txd_named(o: Option[String]) : Bool = match o {
  Some(_) -> true
  None    -> false
}

#[doc("Plant `drops` into every TRMC step and apply leaf of a rewritten body, after the leaf's last read.")]
pub fn txd_plant(e: Expr, drops: [Stmt]) : Expr = txd_walk(e, drops, true)

#[doc("Plant a fn's exit drops `after` into the apply leaves of a TRMC-rewritten body; a step releases its params through the dropmask.")]
pub fn txd_plant_exit(e: Expr, after: [Stmt]) : Expr = txd_walk(e, txd_only_drops(after), false)

fn txd_walk(e: Expr, drops: [Stmt], steps: Bool) : Expr = match drops {
  []         -> e
  [_, ...__] -> Expr { kind: txd_kind(e.kind, drops, steps), line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
}

fn txd_kind(k: ExprKind, drops: [Stmt], steps: Bool) : ExprKind = match k {
  EIf(c, t, opt_e) -> EIf(c, txd_walk(t, drops, steps), txd_walk_opt(opt_e, drops, steps))
  EMatch(s, arms)  -> EMatch(s, map(arms, (a) => txd_arm(a, drops, steps)))
  EBlock(stmts, opt_tail) -> match opt_tail {
    Some(t) -> EBlock(stmts, Some(txd_walk(t, txd_unshadowed(drops, ppd_let_names(stmts)), steps)))
    None    -> k
  }
  ECall(f, xs) -> match f.kind {
    EVar(callee)       -> if steps { txd_sentinel(f, callee, xs, drops) } else { k }
    EMark(MkTrmcApply) -> ECall(f, map(xs, (leaf) => txd_apply_leaf(leaf, drops)))
    _                  -> k
  }
  _ -> k
}

fn txd_apply_leaf(leaf: Expr, drops: [Stmt]) : Expr = match leaf.kind {
  ECall(f, _) -> match f.kind {
    EMark(m) -> if mark_is_reuse(m) { leaf } else { ppd_bind_then(leaf, drops) }
    _        -> ppd_bind_then(leaf, drops)
  }
  _ -> ppd_bind_then(leaf, drops)
}

fn txd_walk_opt(opt_e: Option[Expr], drops: [Stmt], steps: Bool) : Option[Expr] = match opt_e {
  Some(e) -> Some(txd_walk(e, drops, steps))
  None    -> None
}

fn txd_arm(a: Arm, drops: [Stmt], steps: Bool) : Arm = match a {
  Arm(pat, g, body) -> Arm(pat, g, txd_walk(body, txd_unshadowed(drops, prc_pat_bindings(pat, [])), steps))
}

# A drop whose binder a nested scope rebinds would release the inner value.
fn txd_unshadowed(drops: [Stmt], names: [String]) : [Stmt] =
  filter(drops, (d) => not ppd_drop_among(d, names))

fn txd_hole(callee: String) : Int = match es_tcrec_split_pipe(callee) {
  [_, _, h, ..._] -> es_tcrec_parse_decimal(h)
  _               -> 0 - 1
}

fn txd_step_args(xs: [Expr], hole: Int, drops: [Stmt]) : [Expr] = match txd_nth(xs, hole) {
  Some(se) -> match se.kind {
    ECall(sf, sa) -> txd_plant_step(xs, hole, se, sf, sa, filter(drops, (d) => not txd_passed(d, sa)))
    _             -> xs
  }
  None -> xs
}

# Operands in evaluation order: the ctor heads, then the self-call's args.
fn txd_plant_step(xs: [Expr], hole: Int, se: Expr, sf: Expr, sa: [Expr], kept: [Stmt]) : [Expr] = {
  let heads = txd_without(xs, hole, 0)
  let j = txd_pick(list_append(heads, sa), map(kept, (d) => txd_drop_binder(d)))
  let nh = list_length(heads)
  let wrap = (a: Expr) => ppd_bind_then(a, kept)
  if j < 0 or list_length(kept) == 0 { xs }
  else if j < nh { txd_map_nth(xs, if j < hole { j } else { j + 1 }, wrap) }
  else {
    let se2 = Expr { kind: ECall(sf, txd_map_nth(sa, j - nh, wrap)), line: se.line, col: se.col, ty: se.ty, mode: se.mode,  site: se.site }
    txd_map_nth(xs, hole, (_a: Expr) => se2)
  }
}

fn txd_sentinel(f: Expr, callee: String, xs: [Expr], drops: [Stmt]) : ExprKind =
  if es_trmc_is_step_sentinel(callee) { ECall(f, txd_step_args(xs, txd_hole(callee), drops)) }
  else if es_tcrec_is_sentinel(callee) { txd_goto(f, xs, filter(drops, (d) => not txd_passed(d, xs))) }
  else { ECall(f, xs) }

# A self-call that loops leaves no value to release after, so its drops run
# among its args like a step's; with no args they run before the jump.
fn txd_goto(f: Expr, xs: [Expr], kept: [Stmt]) : ExprKind = match kept {
  [] -> ECall(f, xs)
  _  -> match xs {
    [] -> EBlock(kept, Some(Expr { kind: ECall(f, xs), line: f.line, col: f.col, ty: f.ty, mode: f.mode,  site: f.site }))
    _  -> ECall(f, txd_map_nth(xs, txd_pick(xs, map(kept, txd_drop_binder)), (a: Expr) => ppd_bind_then(a, kept)))
  }
}

fn txd_drop_binder(d: Stmt) : String = match ppd_drop_name(d) {
  Some(nm) -> nm
  None     -> ""
}

# The rightmost boxed operand at or after the last read of any `names`, else
# the operand holding that read.
fn txd_pick(ops: [Expr], names: [String]) : Int = {
  let from = txd_last_read(ops, names, 0, 0)
  let j = txd_rightmost_boxed(ops, from, 0, 0 - 1)
  if j < 0 { from } else { j }
}

fn txd_last_read(ops: [Expr], names: [String], i: Int, acc: Int) : Int = match ops {
  []           -> acc
  [a, ...rest] -> txd_last_read(rest, names, i + 1, if any(names, (n) => pcs_mentions(n, a)) { i } else { acc })
}

fn txd_rightmost_boxed(ops: [Expr], from: Int, i: Int, acc: Int) : Int = match ops {
  []           -> acc
  [a, ...rest] -> txd_rightmost_boxed(rest, from, i + 1, if i >= from and txd_boxed(a) { i } else { acc })
}

fn txd_boxed(a: Expr) : Bool = match a.mode {
  MUnboxed -> false
  _        -> match a.ty {
    Some(t) -> not ty_is_unboxable_t(t)
    None    -> false
  }
}

fn txd_nth(xs: [Expr], i: Int) : Option[Expr] = match xs {
  []           -> None
  [a, ...rest] -> if i == 0 { Some(a) } else { txd_nth(rest, i - 1) }
}

fn txd_without(xs: [Expr], skip: Int, i: Int) : [Expr] = match xs {
  []           -> []
  [a, ...rest] -> if i == skip { txd_without(rest, skip, i + 1) } else { [a, ...txd_without(rest, skip, i + 1)] }
}

fn txd_map_nth(xs: [Expr], j: Int, f: (Expr) -> Expr) : [Expr] = match xs {
  []           -> []
  [a, ...rest] -> if j == 0 { [f(a), ...rest] } else { [a, ...txd_map_nth(rest, j - 1, f)] }
}

fn txd_passed(d: Stmt, sa: [Expr]) : Bool = match ppd_drop_name(d) {
  Some(nm) -> any(sa, (x) => txd_is_ref_to(x, nm))
  None     -> true
}

fn txd_is_ref_to(x: Expr, nm: String) : Bool = match x.kind {
  EVar(v)     -> v == nm
  ECall(f, a) -> txd_is_wrapper(f) and any(a, (y) => txd_is_ref_to(y, nm))
  _           -> false
}

# The RC marks pass the operand through. A dup hands the callee its own
# reference, so the binder's still needs the drop.
fn txd_is_wrapper(f: Expr) : Bool = match f.kind {
  EMark(MkDup) -> false
  EMark(m)     -> not mark_is_prim(m)
  _            -> false
}
