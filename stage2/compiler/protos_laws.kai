#[doc("""
Law wrappers: `laws <Theory>` on a protocol and `axiom <Theory>` on an
impl. `strip_law_wrappers` unwraps them to the bare declaration and
records the association, so no later pass sees a wrapper. The law engine
reads the registry to generate per-impl property checks, except for
impls marked `axiom`.
""")]

import compiler.ast
import compiler.home_dup

# The theory each protocol declares, and the impls exempted by
# `axiom <Theory>`. An impl has neither an id nor a name: it is the one
# written at that position of its module, so an exemption cannot reach
# an unrelated impl, which would silently bypass a verification.
pub type LawReg = LR([ProtoLaw], [AxiomImpl])
pub type ProtoLaw = PL(SymId, String)                    # protocol, theory
pub type AxiomImpl = AI(Option[String], Int, Int, String) # home, impl line, impl col, theory

pub fn law_reg_protocols(r: LawReg) : [ProtoLaw] = match r { LR(ps, _) -> ps }
pub fn law_reg_axioms(r: LawReg) : [AxiomImpl] = match r { LR(_, xs) -> xs }

#[doc("The theory the protocol `proto` declares its ops obey via `laws`, if any.")]
pub fn law_theory_of(r: LawReg, proto: SymId) : Option[String] =
  law_theory_loop(law_reg_protocols(r), proto)

fn law_theory_loop(ps: [ProtoLaw], proto: SymId) : Option[String] = match ps {
  [] -> None
  [PL(p, thy), ...rest] ->
    if sym_raw(proto) >= 0 and sym_raw(p) == sym_raw(proto) { Some(thy) }
    else { law_theory_loop(rest, proto) }
}

#[doc("True when the impl written at `line:col` of the module `home` is exempted from law-checks by an `axiom` clause.")]
pub fn law_impl_axiomed(r: LawReg, home: Option[String], line: Int, col: Int) : Bool =
  law_axiom_loop(law_reg_axioms(r), home, line, col)

fn law_axiom_loop(xs: [AxiomImpl], home: Option[String], line: Int, col: Int) : Bool = match xs {
  [] -> false
  [AI(h, l, c, _), ...rest] ->
    if l == line and c == col and home_eq(h, home) { true }
    else { law_axiom_loop(rest, home, line, col) }
}

#[doc("""
Unwrap every `DProtoLaws` / `DImplAxiom` wrapper to its bare inner decl,
returning the flattened decl stream and the law registry. Runs before
any other Decl walker so downstream passes see only plain
protocols/impls, mirroring `lower_axioms`.
""")]
pub fn strip_law_wrappers(decls: [Decl]) : StrippedLaws =
  strip_law_loop(decls, [], [], [])

pub type StrippedLaws = SL([Decl], LawReg)

pub fn strip_sl_decls(s: StrippedLaws) : [Decl] = match s { SL(ds, _) -> ds }
pub fn strip_sl_reg(s: StrippedLaws) : LawReg = match s { SL(_, r) -> r }

fn strip_law_loop(decls: [Decl], acc: [Decl], laws: [ProtoLaw],
                  axioms: [AxiomImpl]) : StrippedLaws = match decls {
  [] -> SL(list_reverse(acc), LR(list_reverse(laws), list_reverse(axioms)))
  [d, ...rest] -> match d {
    DProtoLaws(thy, DProtocol(a, psym, b, c, l, cc, mo), _, _, _) ->
      strip_law_loop(rest, [DProtocol(a, psym, b, c, l, cc, mo), ...acc],
                     [PL(psym, thy), ...laws], axioms)
    DImplAxiom(thy, DImpl(pref, pa, target, ms, l, cc, tps, _), _, _, amo) ->
      strip_law_loop(rest, [DImpl(pref, pa, target, ms, l, cc, tps, sym_none()), ...acc],
                     laws, [AI(amo, l, cc, thy), ...axioms])
    _ -> strip_law_loop(rest, [d, ...acc], laws, axioms)
  }
}
