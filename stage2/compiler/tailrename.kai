#[doc("""
The parameter renames of a fused tail-call group, and the scope that
limits them: a local that reuses a parameter's name shadows it.
""")]

import compiler.ast
import compiler.util

#[doc("A parameter's old name and the fused entry's name for it.")]
pub type Rename = Rn(String, String)

#[doc("The renames that turn `from`'s parameter names into `to`'s, skipping positions that already agree.")]
pub fn tf_rename_pairs(from: [Param], to: [Param]) : [Rename] {
  match from {
    [] -> []
    [f, ...frest] -> match to {
      [] -> []
      [t, ...trest] ->
        if f.pname == t.pname { tf_rename_pairs(frest, trest) }
        else { [Rn(f.pname, t.pname), ...tf_rename_pairs(frest, trest)] }
      _ -> []
    }
    _ -> []
  }
}

#[doc("The renames still in force after `s`: a `let` drops those whose name it rebinds.")]
pub fn tf_stmt_unbind(s: Stmt, pairs: [Rename]) : [Rename] = match s {
  SLet(p, _, _) -> tf_unbind(pairs, pat_bindings(p, []))
  _             -> pairs
}

#[doc("The renames whose old name is not among `bound`.")]
pub fn tf_unbind(pairs: [Rename], bound: [String]) : [Rename] = match pairs {
  [] -> []
  [Rn(from, to), ...rest] ->
    if list_has(bound, from) { tf_unbind(rest, bound) } else { [Rn(from, to), ...tf_unbind(rest, bound)] }
}

#[doc("The name `n` reads under `pairs`.")]
pub fn tf_subst_name(n: String, pairs: [Rename]) : String = match pairs {
  [] -> n
  [Rn(from, to), ...rest] -> if n == from { to } else { tf_subst_name(n, rest) }
}
