#[doc("""
Whether an expression holds a `handle`, answered without allocating.
The non-tail `resume` split asks it of every declaration, so a program
that installs no handler pays one read of each node and nothing else;
`expr_positions` would build a list per node to answer the same.
""")]

import compiler.ast

#[doc("True when `e` holds a `handle` anywhere inside it.")]
pub fn holds_handle(e: Expr) : Bool = match e.kind {
  EInt(_, _)        -> false
  EReal(_, _)       -> false
  EFixed(_, _)      -> false
  EIntLit(_)        -> false
  EDecimalLit(_)    -> false
  EBool(_)          -> false
  EChar(_)          -> false
  EStr(_, _)        -> false
  EUnit             -> false
  EName(_)           -> false
  EMark(_)          -> false
  ESym(_, _, _)     -> false
  EUnder            -> false
  EPlaceholder      -> false
  EHole(_)          -> false
  ETodo(_)          -> false
  EExternBody(_, _) -> false
  EVariantsOf(_, _) -> false
  EModCall(_, _)    -> false
  EHandle(_, _, _, _, _, _, _, _) -> true
  ECall(f, xs)       -> call_holds(f, xs)
  EField(b, _)       -> holds_handle(b)
  EIndex(a, b)       -> pair_holds(a, b)
  EBinop(_, a, b)    -> pair_holds(a, b)
  EUnop(_, x)        -> holds_handle(x)
  EIf(c, t, oe)      -> pair_holds(c, t) or opt_holds(oe)
  EMatch(s, arms)    -> scrutinee_holds(s, arms)
  ELambda(_, b)      -> holds_handle(b)
  ERecordLit(_, _, fs)  -> fields_hold(fs)
  EList(els)         -> elems_hold(els)
  ERange(a, b, os)   -> pair_holds(a, b) or opt_holds(os)
  EBlock(ss, ot)     -> block_holds(ss, ot)
  EPipe(a, b)        -> pair_holds(a, b)
  EMapPipe(a, b)     -> pair_holds(a, b)
  EFlatMapPipe(a, b) -> pair_holds(a, b)
  EFilterPipe(a, b)  -> pair_holds(a, b)
  EBang(x)           -> holds_handle(x)
  ELitUnit(x, _)     -> holds_handle(x)
  EIntrinsic(_, xs)  -> any_holds(xs)
  ESurface(sf)       -> any_holds(surface_children(sf))
}

fn pair_holds(a: Expr, b: Expr) : Bool = holds_handle(a) or holds_handle(b)

fn call_holds(f: Expr, xs: [Expr]) : Bool = holds_handle(f) or any_holds(xs)

fn scrutinee_holds(s: Expr, arms: [Arm]) : Bool = holds_handle(s) or arms_hold(arms)

fn block_holds(ss: [Stmt], ot: Option[Expr]) : Bool = stmts_hold(ss) or opt_holds(ot)

fn any_holds(xs: [Expr]) : Bool = match xs {
  []           -> false
  [x, ...rest] -> holds_handle(x) or any_holds(rest)
}

fn opt_holds(o: Option[Expr]) : Bool = match o {
  Some(x) -> holds_handle(x)
  None    -> false
}

fn arms_hold(arms: [Arm]) : Bool = match arms {
  []                      -> false
  [Arm(_, g, b), ...rest] -> opt_holds(g) or holds_handle(b) or arms_hold(rest)
}

fn fields_hold(fs: [FieldInit]) : Bool = match fs {
  []                  -> false
  [FI(_, v), ...rest] -> holds_handle(v) or fields_hold(rest)
}

fn elems_hold(els: [ListElem]) : Bool = match els {
  []                    -> false
  [ElPlain(x), ...rest]  -> holds_handle(x) or elems_hold(rest)
  [ElSpread(x), ...rest] -> holds_handle(x) or elems_hold(rest)
}

fn stmts_hold(ss: [Stmt]) : Bool = match ss {
  []           -> false
  [s, ...rest] -> stmt_holds(s) or stmts_hold(rest)
}

fn stmt_holds(s: Stmt) : Bool = match s {
  SLet(_, _, rhs)             -> holds_handle(rhs)
  SAssert(c, m)               -> holds_handle(c) or opt_holds(m)
  SExprStmt(x)                -> holds_handle(x)
  SIndexAssign(b, i, v, _, _) -> any_holds([b, i, v])
  SAssign(b, v, _, _)         -> pair_holds(b, v)
  SVar(_, _, rhs, _, _)       -> holds_handle(rhs)
  SUse(_, _, _)               -> false
}
