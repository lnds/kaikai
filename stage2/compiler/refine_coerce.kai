#[doc("""
Refinement coercion, enforcement and variance.
""")]

import compiler.util
import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.handler_alias
import compiler.core_types
import compiler.desugar_rename
import compiler.written
import compiler.core_builtins
import compiler.refine_pred
import compiler.refinements
import compiler.resolve_names
import compiler.ast_map
import compiler.symtab
import compiler.local_names
import compiler.desugar_refine_pred

fn rc_preds(t: Ty) : [Expr] = match t {
  TyRefineT(base, p) -> [p, ...rc_preds(base)]
  _ -> []
}

#[doc("Whether a refined type's base carries a unit, so its check compares the bare number.")]
pub(pkg) fn rc_is_dim(t: Ty) : Bool = match t {
  TyRefineT(base, _) -> rc_is_dim(base)
  TyDimT(_, _) -> true
  _ -> false
}

#[doc("How a value discharges the predicates of the type it flows into.")]
pub(pkg) type RcVerdict = RcProven | RcRefuted(LooseWhy) | RcCheck([Expr])

#[doc("Decide the predicates of `want` for `value`, whose own type is `have`.")]
pub(pkg) fn rc_verdict(want: Ty, value: Expr, have: Ty) : RcVerdict {
  let carried = rc_preds(have)
  let owed = filter(rc_preds(want), (p) => not rc_carries(carried, p))
  rc_classify(owed, value, rc_refs(value, carried), [])
}

fn rc_carries(carried: [Expr], p: Expr) : Bool = match carried {
  [] -> false
  [q, ...rest] -> expr_struct_eq(p, q) or rc_carries(rest, p)
}

fn rc_refs(value: Expr, carried: [Expr]) : [RefBinding] = match value.kind {
  ELocal(l) -> map(carried, (q) => RBind(l, subst_self(q, l)))
  _         -> []
}

fn rc_classify(owed: [Expr], value: Expr, refs: [RefBinding], acc: [Expr]) : RcVerdict = match owed {
  [] -> if acc == [] { RcProven } else { RcCheck(list_reverse(acc)) }
  [p, ...rest] -> match classify_self_vs_pred(p, value, refs) {
    CSElided      -> rc_classify(rest, value, refs, acc)
    CSLoose(why)  -> RcRefuted(why)
    CSRuntime     -> rc_classify(rest, value, refs, [p, ...acc])
  }
}

# A binder the resolver has not numbered yet is read by the name it was
# written with; one with an id, by that id.
fn rc_read(b: Binder, line: Int, col: Int) : Expr =
  if local_raw(b.id) == local_raw(local_none()) { mk_expr(EName(b.name), line, col) } else { mk_local(b.id, line, col) }

#[doc("The runtime check of `pred` on the value bound to `b`, panicking with the decl `ctx` names. `tab` and `locals` name what the predicate refers to in that message.")]
pub(pkg) fn rc_assert(b: Binder, pred: Expr, ctx: String, strip: Bool, tab: SymTab, locals: LocalNames) : Stmt {
  let v = rc_read(b, pred.line, pred.col)
  let self_e = if strip { mk_expr(ECall(builtin_mk(CbStripUnit, pred.line, pred.col), [v]), pred.line, pred.col) } else { v }
  let msg = concat_all([
    "\"refinement violated in `", escape_str_body_for_c(ctx), "`",
    "\\npredicate: ", escape_str_body_for_c(refine_pred_text(pred, tab, locals)),
    "\\ndeclared at line ", int_to_string(pred.line),
    ", col ", int_to_string(pred.col), "\""
  ])
  SAssert(rc_on(b, pred, self_e), Some(mk_expr(EStr(msg, false), pred.line, pred.col)))
}

# The predicate over the value: before the resolver has numbered `b`, a
# predicate written in place still spells its `self`.
fn rc_on(b: Binder, pred: Expr, self_e: Expr) : Expr =
  if local_raw(b.id) == local_raw(local_none()) { subst_self_unresolved(pred, self_e) } else { subst_self_with(pred, self_e) }

#[doc("The refined types `expected` gives the type variables of `pat`, where it gives any.")]
pub(pkg) fn rc_var_binds(pat: Ty, expected: Ty) : [(Int, Ty)] = rc_binds(pat, expected, [])

fn rc_binds(pat: Ty, t: Ty, acc: [(Int, Ty)]) : [(Int, Ty)] = match pat {
  TyVarT(i) -> if rc_preds(t) == [] { acc } else { [(i, t), ...acc] }
  TyListT(p) -> match t {
    TyListT(x) -> rc_binds(p, x, acc)
    _          -> acc
  }
  TyCon(_, ps) -> match t {
    TyCon(_, ts) -> rc_binds_all(ps, ts, acc)
    _            -> acc
  }
  _ -> acc
}

fn rc_binds_all(ps: [Ty], ts: [Ty], acc: [(Int, Ty)]) : [(Int, Ty)] = match ps {
  [p, ...prest] -> match ts {
    [t, ...trest] -> rc_binds_all(prest, trest, rc_binds(p, t, acc))
    []            -> acc
  }
  [] -> acc
}

#[doc("`t` with every bound type variable replaced by its binding.")]
pub(pkg) fn rc_subst(t: Ty, binds: [(Int, Ty)]) : Ty = match t {
  TyVarT(i) -> rc_bound(binds, i, t)
  TyListT(x) -> TyListT(rc_subst(x, binds))
  TyCon(sym, args_) -> TyCon(sym, map(args_, (a) => rc_subst(a, binds)))
  TyFnT(ps, r, row) -> TyFnT(map(ps, (p) => rc_subst(p, binds)), rc_subst(r, binds), row)
  _ -> t
}

fn rc_bound(binds: [(Int, Ty)], i: Int, fallback: Ty) : Ty = match binds {
  [] -> fallback
  [(j, t), ...rest] -> if i == j { t } else { rc_bound(rest, i, fallback) }
}

#[doc("A refined `var`'s writes bind the new value under the declared type, as its initial value is, so the typer checks each one.")]
pub(pkg) fn rc_check_var_writes(cell: Binder, ann: Option[TypeExpr], body: Expr) : Expr = match ann {
  Some(t) -> match t.tkind {
    TyRefine(_, _) -> rc_pin_writes(cell, t, body)
    _              -> body
  }
  None -> body
}

fn rc_pin_writes(cell: Binder, t: TypeExpr, e: Expr) : Expr = match rc_write_of(cell.id, e) {
  Some(v) -> match e.kind {
    ECall(callee, args_) -> {
      let ann = var_ann_binder(written_text(cell.name), v.line, v.col)
      let pinned = mk_expr(EBlock([SLet(mk_pat(PBind(ann), v.line, v.col), Some(t), rc_pin_writes(cell, t, v))],
                                  Some(mk_local(ann.id, v.line, v.col))), v.line, v.col)
      Expr { ...e, kind: ECall(callee, match args_ { [c, _] -> [c, pinned]  _ -> [pinned] }) }
    }
    _ -> e
  }
  None -> Expr { ...e, kind: prc_map_expr_kind(e.kind, (sub) => rc_pin_writes(cell, t, sub)) }
}

fn rc_write_of(cell: LocalId, e: Expr) : Option[Expr] = match e.kind {
  ECall(callee, args_) -> match cell_access_of(cell, callee, args_) {
    Some(CellSet) -> cell_write_value(callee, args_)
    _             -> None
  }
  _ -> None
}

# A type variable never owes one: unification binds it to a type with
# its refinements peeled.
#[doc("Whether a value flowing into `t` can owe a refinement: `t` is refined, or a function type whose result is.")]
pub(pkg) fn rc_may_owe(t: Ty) : Bool = match t {
  TyRefineT(_, _) -> true
  TyFnT(_, r, _)  -> rc_may_owe(r)
  _               -> false
}

#[doc("Whether a refinement appears anywhere inside `t`.")]
pub(pkg) fn rc_mentions(t: Ty) : Bool = match t {
  TyRefineT(_, _)     -> true
  TyListT(x)          -> rc_mentions(x)
  TyCon(_, args_)     -> rc_any_mentions(args_)
  TyFnT(ps, r, _)     -> rc_mentions(r) or rc_any_mentions(ps)
  _                   -> false
}

fn rc_any_mentions(ts: [Ty]) : Bool = match ts {
  [] -> false
  [t, ...rest] -> rc_mentions(t) or rc_any_mentions(rest)
}

# ---- shared helpers ----

fn renf_preds_of(t: TypeExpr) : [Expr] = match t.tkind {
  TyRefine(base, pred) -> [pred, ...renf_preds_of(base)]
  _ -> []
}

# True when `f` is one of the predicate fns `preds`.
fn renf_skip_fn(f: FnId, preds: [SymId]) : Bool = renf_has(preds, sym_raw(fnid_sym(f)))

fn renf_has(xs: [SymId], id: Int) : Bool = match xs {
  []           -> false
  [x, ...rest] -> sym_raw(x) == id or renf_has(rest, id)
}

# A refinement over a dimensioned base (`Real<USD> where >= 0.0`)
# checks the bare numeric value: the inserted assert compares
# `__strip_unit(self)`, since the predicate's literals carry no unit
# and a dimensioned operand would be a unit mismatch in the typer.
fn renf_ty_is_dim(t: TypeExpr) : Bool = match t.tkind {
  TyRefine(base, _) -> renf_ty_is_dim(base)
  TyDim(_, _) -> true
  _ -> false
}

fn renf_asserts_for(b: Binder, preds: [Expr], cx: RenfCx, strip: Bool) : [Stmt] =
  map(preds, (p) => rc_assert(b, p, cx.ctx, strip, cx.tab, ln_empty()))

# The decl a violated refinement reports, and the table that names what
# a predicate copied from an alias refers to.
type RenfCx = { ctx: String, tab: SymTab }

#[doc("Check every refined fn and lambda parameter on entry. `tab` names the function a violated refinement reports; `pred_fns` are the predicate fns the refinement aliases were given, left unchecked.")]
pub(pkg) fn enforce_refinements_decls(decls: [Decl], tab: SymTab, pred_fns: [SymId]) : [Decl] =
  map(decls, (d) => renf_decl(d, tab, pred_fns))

fn renf_decl(d: Decl, tab: SymTab, preds: [SymId]) : Decl = match d {
  DFn(p, f, tps, params, ret, row, body, l, c, mo) ->
    if renf_skip_fn(f, preds) { d } else {
      let n = written_text(decl_name(tab, fnid_sym(f)))
      let cx = RenfCx { ctx: n, tab: tab }
      DFn(p, f, tps, params, ret, row, renf_add_param_checks(params, renf_walk(body, cx), cx), l, c, mo)
    }
  DTest(desc, body, l, c, mo) -> DTest(desc, renf_walk(body, RenfCx { ctx: desc, tab: tab }), l, c, mo)
  DBench(desc, body, l, c, mo) -> DBench(desc, renf_walk(body, RenfCx { ctx: desc, tab: tab }), l, c, mo)
  DCheck(desc, ps, body, l, c, mo) -> DCheck(desc, ps, renf_walk(body, RenfCx { ctx: desc, tab: tab }), l, c, mo)
  DUnstable(inner, l, c) -> DUnstable(renf_decl(inner, tab, preds), l, c)
  DProtoLaws(thy, inner, l, c, mo) -> DProtoLaws(thy, renf_decl(inner, tab, preds), l, c, mo)
  DImplAxiom(thy, inner, l, c, mo) -> DImplAxiom(thy, renf_decl(inner, tab, preds), l, c, mo)
  DConstructor(inner, l, c) -> DConstructor(renf_decl(inner, tab, preds), l, c)
  _ -> d
}

fn renf_walk(e: Expr, cx: RenfCx) : Expr = match e.kind {
  ELambda(ps, b) -> mk_expr(ELambda(ps, renf_add_param_checks(ps, renf_walk(b, cx), cx)), e.line, e.col)
  _ -> mk_expr(dsg_map_expr_kind(e.kind, (s) => renf_walk(s, cx)), e.line, e.col)
}

fn renf_add_param_checks(params: [Param], body: Expr, cx: RenfCx) : Expr {
  let asserts = renf_param_asserts(params, cx)
  if asserts == [] { body } else { renf_insert_after_requires(body, asserts) }
}

fn renf_param_asserts(params: [Param], cx: RenfCx) : [Stmt] = match params {
  [] -> []
  [p, ...rest] -> match p.ptype {
    Some(t) -> {
      let live = renf_drop_trivial(renf_preds_of(t))
      list_append(renf_asserts_for(p.binder, live, cx, renf_ty_is_dim(t)),
                  renf_param_asserts(rest, cx))
    }
    None -> renf_param_asserts(rest, cx)
  }
}

fn renf_drop_trivial(preds: [Expr]) : [Expr] = match preds {
  [] -> []
  [p, ...rest] -> match try_eval_pred(p) {
    Some(true) -> renf_drop_trivial(rest)
    _ -> [p, ...renf_drop_trivial(rest)]
  }
}

# Param checks slot in after the requires-assert prefix so
# `extract_requires_asserts` (which stops at the first non-requires
# statement) still sees every requires clause.
fn renf_insert_after_requires(body: Expr, asserts: [Stmt]) : Expr = match body.kind {
  EBlock(stmts, tail) -> match renf_split_requires(stmts, []) {
    RenfRSP(reqs, rest) ->
      mk_expr(EBlock(list_append(reqs, list_append(asserts, rest)), tail), body.line, body.col)
  }
  _ -> mk_expr(EBlock(asserts, Some(body)), body.line, body.col)
}

type RenfReqSplit = RenfRSP([Stmt], [Stmt])

fn renf_split_requires(stmts: [Stmt], acc: [Stmt]) : RenfReqSplit = match stmts {
  [] -> RenfRSP(list_reverse(acc), [])
  [s, ...rest] -> match s {
    SAssert(_, Some(m)) -> match m.kind {
      EStr(span, _) ->
        if assert_span_is_requires(span) { renf_split_requires(rest, [s, ...acc]) }
        else { RenfRSP(list_reverse(acc), [s, ...rest]) }
      _ -> RenfRSP(list_reverse(acc), [s, ...rest])
    }
    _ -> RenfRSP(list_reverse(acc), [s, ...rest])
  }
}

#[doc("A type's parameters and every type its values hold, as declared.")]
pub(pkg) type TyDef = TyDef([TBinder], [TypeExpr])

#[doc("A refinement a flow cannot carry: the polarity it met, the value's part, the expected part, and the predicate in question.")]
pub(pkg) type RvMiss = RvMiss(Int, Ty, Ty, Expr)

#[doc("A call's binding of a type variable to a refined type, and the argument that widened it, or -1.")]
pub(pkg) type RvBind = RvBind(Int, Ty, Int)

fn rv_flip(v: Int) : Int = match v {
  1 -> 2
  2 -> 1
  _ -> v
}

fn rv_compose(outer: Int, inner: Int) : Int = match outer {
  0 -> 0
  1 -> inner
  2 -> rv_flip(inner)
  _ -> if inner == 0 { 0 } else { 3 }
}

fn rv_or(a: Int, b: Int) : Int =
  if a == 3 or b == 3 or (a == 1 and b == 2) or (a == 2 and b == 1) { 3 } else if a == 0 { b } else { a }

fn rv_param(defs: (SymId) -> [TyDef], t: SymId, j: Int) : Int = rv_param_seen(defs, t, j, [])

fn rv_param_seen(defs: (SymId) -> [TyDef], t: SymId, j: Int, seen: [SymId]) : Int =
  if core_ty_is(t, CtOption) or core_ty_is(t, CtResult) { 1 }
  else { match defs(t) {
    [] -> 3
    ds -> rv_defs(defs, ds, t, j, seen, 0)
  } }

fn rv_defs(defs: (SymId) -> [TyDef], ds: [TyDef], t: SymId, j: Int, seen: [SymId], acc: Int) : Int = match ds {
  [] -> acc
  [TyDef(tps, payloads), ...rest] -> match nth(tps, j) {
    Some(tp) -> rv_defs(defs, rest, t, j, seen, rv_or(acc, rv_occ_all(defs, payloads, tp.id, 1, [t, ...seen])))
    None     -> 3
  }
}

fn rv_occ_all(defs: (SymId) -> [TyDef], ts: [TypeExpr], v: TLocalId, pol: Int, seen: [SymId]) : Int = match ts {
  [] -> 0
  [t, ...rest] -> rv_or(rv_occ(defs, t, v, pol, seen), rv_occ_all(defs, rest, v, pol, seen))
}

# The type a payload's head names: its declaration once settled; a head
# still written bare names a core type, or nothing this walk knows.
fn rv_head_sym(r: DeclRef) : SymId = match r {
  DrSym(s)              -> s
  DrWritten(None, n)    -> core_type_sym_or_none(written_text(n))
  DrWritten(Some(_), _) -> sym_none()
}

fn rv_seen(seen: [SymId], t: SymId) : Bool = match seen {
  []           -> false
  [s, ...rest] -> (sym_raw(t) >= 0 and sym_raw(s) == sym_raw(t)) or rv_seen(rest, t)
}

fn rv_occ(defs: (SymId) -> [TyDef], t: TypeExpr, v: TLocalId, pol: Int, seen: [SymId]) : Int = match t.tkind {
  TyParam(p, [])  -> if tlocal_eq(p, v) { pol } else { 0 }
  TyParam(_, args) -> rv_occ_args(defs, sym_none(), args, 0, v, pol, seen)
  TyName(_, [])   -> 0
  TyName(r, args) -> rv_occ_args(defs, rv_head_sym(r), args, 0, v, pol, seen)
  TyList(x)       -> rv_occ(defs, x, v, pol, seen)
  TyFn(ps, r, _)  -> rv_or(rv_occ_all(defs, ps, v, rv_flip(pol), seen), rv_occ(defs, r, v, pol, seen))
  TyDim(b, _)     -> rv_occ(defs, b, v, pol, seen)
  TyRefine(b, _)  -> rv_occ(defs, b, v, pol, seen)
  _               -> 0
}

# A type reached again through its own definition is assumed to keep
# the polarity it is met at; met under any other, it is invariant.
fn rv_occ_args(defs: (SymId) -> [TyDef], n: SymId, args: [TypeExpr], j: Int, v: TLocalId, pol: Int, seen: [SymId]) : Int = match args {
  [] -> 0
  [a, ...rest] -> {
    let m = rv_occ(defs, a, v, 1, seen)
    let here = if m == 0 { 0 }
               else if rv_seen(seen, n) { rv_compose(pol, if pol == 1 { m } else { 3 }) }
               else { rv_compose(pol, rv_compose(rv_param_seen(defs, n, j, seen), m)) }
    rv_or(here, rv_occ_args(defs, n, rest, j + 1, v, pol, seen))
  }
}

fn rv_peel(t: Ty) : Ty = match t {
  TyRefineT(b, _) -> rv_peel(b)
  _               -> t
}

fn rv_all_carried(need: [Expr], have: [Expr]) : Option[Expr] = match need {
  [] -> None
  [p, ...rest] -> if any(have, (q) => expr_struct_eq(p, q)) { rv_all_carried(rest, have) } else { Some(p) }
}

fn rv_preds_miss(h: Ty, w: Ty, pol: Int) : Option[RvMiss] = {
  let co = if pol == 1 or pol == 3 { rv_all_carried(rc_preds(w), rc_preds(h)) } else { None }
  match co {
    Some(p) -> Some(RvMiss(pol, h, w, p))
    None -> if pol == 2 or pol == 3 {
      match rv_all_carried(rc_preds(h), rc_preds(w)) {
        Some(p) -> Some(RvMiss(pol, h, w, p))
        None    -> None
      }
    } else { None }
  }
}

#[doc("The first refinement inside `want` that a value of type `have` cannot carry there, if any. The outermost level is the caller's: a value meeting a refined type is checked at runtime.")]
pub(pkg) fn rv_flow(defs: (SymId) -> [TyDef], have: Ty, want: Ty) : Option[RvMiss] = rv_inner(defs, rv_peel(have), rv_peel(want), 1)

fn rv_walk(defs: (SymId) -> [TyDef], h: Ty, w: Ty, pol: Int) : Option[RvMiss] = match rv_preds_miss(h, w, pol) {
  Some(m) -> Some(m)
  None    -> rv_inner(defs, rv_peel(h), rv_peel(w), pol)
}

fn rv_inner(defs: (SymId) -> [TyDef], h: Ty, w: Ty, pol: Int) : Option[RvMiss] = match h {
  TyListT(a) -> match w {
    TyListT(b) -> rv_walk(defs, a, b, pol)
    _          -> None
  }
  TyCon(n, as_) -> match w {
    TyCon(_, bs) -> rv_args(defs, n, as_, bs, 0, pol)
    _            -> None
  }
  TyFnT(aps, ar, _) -> match w {
    TyFnT(bps, br, _) -> match rv_pairs(defs, aps, bps, rv_flip(pol)) {
      Some(m) -> Some(m)
      None    -> rv_walk(defs, ar, br, pol)
    }
    _ -> None
  }
  _ -> None
}

fn rv_args(defs: (SymId) -> [TyDef], n: SymId, hs: [Ty], ws: [Ty], j: Int, pol: Int) : Option[RvMiss] = match hs {
  [h, ...hrest] -> match ws {
    [w, ...wrest] -> {
      let here = if rc_mentions(h) or rc_mentions(w) { rv_walk(defs, h, w, rv_compose(pol, rv_param(defs, n, j))) } else { None }
      match here {
        Some(m) -> Some(m)
        None    -> rv_args(defs, n, hrest, wrest, j + 1, pol)
      }
    }
    [] -> None
  }
  [] -> None
}

fn rv_pairs(defs: (SymId) -> [TyDef], hs: [Ty], ws: [Ty], pol: Int) : Option[RvMiss] = match hs {
  [h, ...hrest] -> match ws {
    [w, ...wrest] -> match rv_walk(defs, h, w, pol) {
      Some(m) -> Some(m)
      None    -> rv_pairs(defs, hrest, wrest, pol)
    }
    [] -> None
  }
  [] -> None
}

fn rv_join(a: Ty, b: Ty) : Ty = rv_rewrap(rv_shared(rc_preds(a), rc_preds(b)), rv_join_bare(rv_peel(a), rv_peel(b)))

fn rv_shared(ps: [Expr], qs: [Expr]) : [Expr] = filter(ps, (p) => any(qs, (q) => expr_struct_eq(p, q)))

fn rv_rewrap(ps: [Expr], base: Ty) : Ty = match ps {
  [] -> base
  [p, ...rest] -> TyRefineT(rv_rewrap(rest, base), p)
}

fn rv_join_bare(a: Ty, b: Ty) : Ty = match a {
  TyListT(x) -> match b {
    TyListT(y) -> TyListT(rv_join(x, y))
    _          -> a
  }
  TyCon(s, xs) -> match b {
    TyCon(_, ys) -> TyCon(s, rv_join_list(xs, ys))
    _            -> a
  }
  TyFnT(xs, r, row) -> match b {
    TyFnT(_, q, _) -> TyFnT(xs, rv_join(r, q), row)
    _              -> a
  }
  _ -> a
}

fn rv_join_list(xs: [Ty], ys: [Ty]) : [Ty] = match xs {
  [x, ...xrest] -> match ys {
    [y, ...yrest] -> [rv_join(x, y), ...rv_join_list(xrest, yrest)]
    []            -> xs
  }
  [] -> []
}

fn rv_same(a: Ty, b: Ty) : Bool = rv_none(rv_all_carried(rc_preds(a), rc_preds(b))) and rv_none(rv_all_carried(rc_preds(b), rc_preds(a)))

fn rv_none(o: Option[Expr]) : Bool = match o {
  Some(_) -> false
  None    -> true
}

# Only covariant positions bind: a value of a type variable comes out
# of a call only from where it went in as a value, never from a
# function parameter that consumes one.
#[doc("The refined types a call's arguments `args` give the type variables of its parameters `params`, joined where several meet.")]
pub(pkg) fn rv_call_binds(params: [Ty], args: [Ty]) : [RvBind] = rv_bind_args(params, args, 0, [])

fn rv_bind_args(ps: [Ty], ts: [Ty], i: Int, acc: [RvBind]) : [RvBind] = match ps {
  [p, ...prest] -> match ts {
    [t, ...trest] -> rv_bind_args(prest, trest, i + 1, rv_bind(p, t, i, acc))
    []            -> acc
  }
  [] -> acc
}

fn rv_bind(pat: Ty, t: Ty, i: Int, acc: [RvBind]) : [RvBind] = match pat {
  TyVarT(v) -> rv_note(acc, v, t, i)
  TyRefineT(b, _) -> rv_bind(b, t, i, acc)
  TyListT(p) -> match rv_peel(t) {
    TyListT(x) -> rv_bind(p, x, i, acc)
    _          -> acc
  }
  TyCon(_, ps) -> match rv_peel(t) {
    TyCon(_, ts) -> rv_bind_list(ps, ts, i, acc)
    _            -> acc
  }
  TyFnT(_, r, _) -> match rv_peel(t) {
    TyFnT(_, q, _) -> rv_bind(r, q, i, acc)
    _              -> acc
  }
  _ -> acc
}

fn rv_bind_list(ps: [Ty], ts: [Ty], i: Int, acc: [RvBind]) : [RvBind] = match ps {
  [p, ...prest] -> match ts {
    [t, ...trest] -> rv_bind_list(prest, trest, i, rv_bind(p, t, i, acc))
    []            -> acc
  }
  [] -> acc
}

fn rv_note(acc: [RvBind], v: Int, t: Ty, i: Int) : [RvBind] = match acc {
  [] -> [RvBind(v, t, -1)]
  [RvBind(w, b, at), ...rest] ->
    if w != v { [RvBind(w, b, at), ...rv_note(rest, v, t, i)] }
    else {
      let j = rv_join(b, t)
      [RvBind(v, j, if at < 0 and not rv_same(j, b) { i } else { at }), ...rest]
    }
}

#[doc("The bindings of `binds` as `rc_subst` reads them.")]
pub(pkg) fn rv_pairs_of(binds: [RvBind]) : [(Int, Ty)] = map(binds, (b) => match b { RvBind(v, t, _) -> (v, t) })

#[doc("The first argument index that widened a binding, or -1.")]
pub(pkg) fn rv_widened_at(binds: [RvBind]) : Int = match binds {
  [] -> -1
  [RvBind(_, _, at), ...rest] -> if at >= 0 { at } else { rv_widened_at(rest) }
}
