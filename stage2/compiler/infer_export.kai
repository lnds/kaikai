#[doc("Row and shape checks for an `extern \"C\" fn` that exports a kaikai function.")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.core_types
import compiler.infer_state
import compiler.infer_env
import compiler.handler_alias

#[doc("True when the function `f` is declared `extern \"C\"` with a body.")]
pub fn fn_is_c_export(st: InferState, f: FnId) : Bool = fn_is_c_export_in(st.env.tab, f)

#[doc("True when `f` is a C export, judged from the symbol table alone.")]
pub fn fn_is_c_export_in(tab: SymTab, f: FnId) : Bool = is_some(mint_export(sym_mint(tab, fnid_sym(f))))

#[doc("Report an export whose declared row is open or names an effect no default handler serves, or that is generic.")]
pub fn check_export_shape(st: InferState, fname: String, tparams: [TBinder], declared: RowExpr,
                          line: Int, col: Int) : InferState / Console + File =
  if not list_is_empty(tparams) {
    export_error(st, fname, line, col, "is generic", "an exported function has one C signature; drop its type parameters")
  } else {
    match declared {
      ROpen(_, _) -> export_error(st, fname, line, col, "has an open effect row",
                                  "C calls it with no handler on the stack; close the row with the effects it performs")
      _ -> st
    }
  }

#[doc("Report each performed effect of an export that has no default handler.")]
pub fn check_export_row_handlable(st: InferState, fname: String, body_row: [Label],
                                  line: Int, col: Int, decls: [Decl]) : InferState / Console + File =
  match body_row {
    [] -> st
    [h, ...rest] -> {
      let st1 = if effect_is(h.sym, CeFfi) or effect_decl_default_all_extern(effect_decl_of(h.sym, decls)) { st }
      else {
        let shown = inf_tycon_display_ow(st.env.tab, st.env.head_owners, h.sym)
        export_error(st, fname, line, col, concat_all(["performs effect `", shown, "`, which has no default handler"]),
                     "C calls it with no `handle` on the stack; only effects with a default handler (Stdout, Stderr, Clock, Random, Log, Spawn, …) are allowed")
      }
      check_export_row_handlable(st1, fname, rest, line, col, decls)
    }
  }

fn export_error(st: InferState, fname: String, line: Int, col: Int, what: String, help: String) : InferState / Console + File = {
  let msg = concat_all(["exported function `", fname, "` ", what])
  st_bump_err(st_push_diag(st, mk_diag(SevError, st.file, line, col, msg, [ri_help(st.file, line, col, help)])))
}
