#[doc("Command-line parsing: the flag loop that builds the options a run is driven by.")]

import compiler.util
import compiler.ast
import compiler.real_lit
import compiler.written
import compiler.symtab
import compiler.user_cache
import compiler.driver_cli
import compiler.edition
import compiler.build_target
import compiler.infer_glue
import compiler.infer_state
import compiler.diag_type_text
import compiler.core_cut

# One argument-less flag applied to the options; `None` when `a` is not one.
fn flag_plain(a: String, opts: CliOptions) : Option[CliOptions] = match a {
  "--tokens" -> Some(cli_with_mode(opts, MTokens))
  "--ast" -> Some(cli_with_mode(opts, MAst))
  "--types" -> Some(cli_with_mode(opts, MTypes))
  "--env" -> Some(cli_with_mode(opts, MEnv))
  "--infer" -> Some(cli_with_mode(opts, MInfer))
  "--check" -> Some(cli_with_mode(opts, MCheck))
  "--dump-typed" -> Some(cli_with_mode(opts, MDumpTyped))
  "--dump-typed-core" -> Some(cli_with_mode(opts, MDumpTypedCore))
  "--dump-tycon-ids" -> Some(cli_with_mode(opts, MDumpTyconIds))
  "--check-type-ids" -> Some(cli_with_mode(opts, MCheckTypeIds))
  "--dump-mono" -> Some(cli_with_mode(opts, MDumpMono))
  "--dump-mono-out" -> Some(cli_with_mode(opts, MDumpMonoOut))
  "--dump-rawsafe" -> Some(cli_with_mode(opts, MDumpRawSafe))
  "--dump-borrowsafe" -> Some(cli_with_mode(opts, MDumpBorrowSafe))
  "--dump-purity" -> Some(cli_with_mode(opts, MDumpPurity))
  "--dump-symids" -> Some(cli_with_mode(opts, MDumpSymIds))
  "--check-field-types" -> Some(cli_with_mode(opts, MCheckFieldTypes))
  "--check-site-ids" -> Some(cli_with_mode(opts, MCheckSiteIds))
  "--check-written-eq" -> Some(cli_with_mode(opts, MCheckWrittenEq))
  "--dump-last-use" -> Some(cli_with_mode(opts, MDumpLastUse))
  "--dump-intervals" -> Some(cli_with_mode(opts, MDumpIntervals))
  "--dump-call-elision" -> Some(cli_with_mode(opts, MDumpCallElision))
  "--dump-brands" -> Some(cli_with_mode(opts, MDumpBrands))
  "--check-core-front-stubs" -> Some(cli_with_mode(opts, MCheckCoreFront))
  "--check-core-front" -> Some(cli_with_early_cut(cli_with_mode(opts, MCheckCoreFront), EcOff))
  "--dump=evidence-obligations" -> Some(cli_with_mode(opts, MDumpEvidenceObligations))
  "--dump=evidence-arity" -> Some(cli_with_mode(opts, MDumpEvidenceArity))
  "--holes" -> Some(cli_with_mode(opts, MHoles))
  "--holes-json" -> Some(cli_with_mode(opts, MHolesJson))
  "--holes-scope" -> Some(cli_with_mode(opts, MHolesScope))
  "--holes-json-scope" -> Some(cli_with_mode(opts, MHolesJsonScope))
  "--effects-json" -> Some(cli_with_mode(opts, MEffectsJson))
  "--explain" -> Some(cli_with_mode(opts, MExplain))
  "--effect-holes-json" -> Some(cli_with_mode(opts, MEffectHolesJson))
  "--doc-json" -> Some(cli_with_mode(opts, MDocJson))
  "--builtins-doc-json" -> Some(cli_with_mode(opts, MBuiltinsDocJson))
  "--strict-holes" -> Some(cli_with_strict_holes(opts))
  "--core-cache-stats" -> Some(cli_with_cc_opt_stats(opts))
  "--full-core" -> Some(cli_with_full_core(opts))
  "--no-early-cut" -> Some(cli_with_early_cut(opts, EcOff))
  "--user-cache" -> Some(cli_with_user_cache(opts))
  "--emit=kir" -> Some(cli_with_mode(opts, MEmitKir(mode_kir_program(opts.mode))))
  "--emit=kir-noinline" -> Some(cli_with_mode(opts, MEmitKirNoInline(mode_kir_program(opts.mode))))
  "--emit=native" -> Some(cli_with_backend(opts, BkNative))
  "--emit=native-modular" -> Some(cli_with_backend(opts, BkNativeModular))
  "--emit=c-modular" -> Some(cli_with_backend(opts, BkCModular))
  "--fmt" -> Some(cli_with_mode(opts, MFmt(mode_fmt_width(opts.mode))))
  "--fmt-check" -> Some(cli_with_mode(opts, MFmtCheck(mode_fmt_width(opts.mode))))
  "--migrate" -> Some(cli_with_mode(opts, MMigrate))
  "--target=host" -> Some(CliOptions { ...opts, target: TgHost })
  "--target=wasm32-browser" -> Some(CliOptions { ...opts, target: TgWasm32Browser })
  "--target=wasm32-wasi" -> Some(CliOptions { ...opts, target: TgWasm32Wasi })
  "--mutate-list" -> Some(cli_with_mode(opts, MMutateList))
  "--mutate-list-json" -> Some(cli_with_mode(opts, MMutateListJson))
  "--library-mode" -> Some(cli_with_mode(opts, MLibraryMode))
  "--diags-json" -> Some(cli_with_mode(opts, MDiagsJson))
  "--lint" -> Some(cli_with_mode(opts, MLint))
  "--lint-json" -> Some(cli_with_mode(opts, MLintJson))
  "--cache-roundtrip-test" -> Some(cli_with_mode(opts, MCacheRoundtrip))
  "--cache-typed-selftest" -> Some(cli_with_mode(opts, MCacheTypedSelftest))
  "--symtab-selftest" -> Some(cli_with_mode(opts, MSymtabSelftest))
  "--builtin-names" -> Some(cli_with_mode(opts, MBuiltinNames))
  "--builtin-table" -> Some(cli_with_mode(opts, MBuiltinTable))
  "--kai-builtins" -> Some(cli_with_mode(opts, MKaiBuiltins))
  "--resolve-sym-selftest" -> Some(cli_with_mode(opts, MResolveSymSelftest))
  "--emit-core-cache" -> Some(cli_with_mode(opts, MEmitCoreCache))
  "--batch-list" -> Some(cli_with_mode(opts, MBatchList))
  "--guard-inputs" -> Some(cli_with_mode(opts, MGuardInputs))
  "--guard-interfaces" -> Some(cli_with_mode(opts, MGuardInterfaces))
  "--guard-core-inputs" -> Some(cli_with_mode(opts, MGuardCoreInputs))
  "--test" -> Some(cli_with_mode(opts, mode_with_program(opts.mode, MTest)))
  "--bench" -> Some(cli_with_mode(opts, mode_with_program(opts.mode, MBench)))
  "--prop-check" -> Some(cli_with_mode(opts, mode_with_program(opts.mode, MPropCheck)))
  "-h" -> Some(cli_with_mode(opts, MHelp))
  "--help" -> Some(cli_with_mode(opts, MHelp))
  "-V" -> Some(cli_with_mode(opts, MVersion))
  "--version" -> Some(cli_with_mode(opts, MVersion))
  "--backend-tag" -> Some(cli_with_mode(opts, MBackendTag))
  _ -> None
}


# The noun a flag's missing argument is reported with; `None` for a flag that takes none.
fn flag_arg_noun(a: String) : Option[String] = match a {
  "--core-cache-dir" -> Some("a directory argument")
  "--test-root" -> Some("a module argument")
  "--test-own" -> Some("a file argument")
  "--cover" -> Some("a file argument")
  "--cover-root" -> Some("a file argument")
  "--test-plan" -> Some("a file argument")
  "--kir-verify" -> Some("a file argument")
  "--native-obj-dir" -> Some("a directory argument")
  "--toolchain-id" -> Some("an argument")
  "--user-cache-dir" -> Some("a directory argument")
  "--ffi-header-out" -> Some("a file argument")
  "--fmt-width" -> Some("a column count")
  "--mutate-apply" -> Some("a site index")
  "--list-tests" -> Some("a file label")
  "--inputs-out" -> Some("a file argument")
  "--cache-sha" -> Some("a 64-char hex argument")
  "--path" -> Some("a directory argument")
  "--package-root" -> Some("a directory argument")
  "--package-name" -> Some("a package-name argument")
  "--unstable-optin" -> Some("a package-name argument")
  "--edition" -> Some("an edition-name argument")
  _ -> None
}

# A flag that takes one argument, applied; `None` when the argument was rejected and reported.
fn apply_flag_arg(a: String, v: String, opts: CliOptions) : Option[CliOptions] / Console = match a {
  "--core-cache-dir" -> Some(cli_with_cc_opt_dir(opts, v))
  "--test-root" -> Some(CliOptions { ...opts, test_roots: list_append(opts.test_roots, [v]) })
  "--test-own" -> Some(CliOptions { ...opts, test_own: list_append(opts.test_own, [v]) })
  "--cover" -> Some(cli_with_cover(opts, a, v))
  "--cover-root" -> Some(cli_with_cover(opts, a, v))
  "--test-plan" -> Some(CliOptions { ...opts, test_plan: v })
  "--kir-verify" -> Some(CliOptions { ...opts, kir_verify: v })
  "--native-obj-dir" -> Some(cli_with_nmod_dir(opts, v))
  "--toolchain-id" -> Some(cli_with_toolchain_id(opts, v))
  "--user-cache-dir" -> Some(cli_with_user_cache_dir(opts, v))
  "--ffi-header-out" -> Some(CliOptions { ...opts, ffi_out: v })
  "--fmt-width" -> Some(cli_with_mode(opts, mode_with_fmt_width(opts.mode, cli_parse_width(v))))
  "--mutate-apply" -> Some(cli_with_mode(opts, MMutateApply(cli_parse_site(v))))
  "--list-tests" -> Some(cli_with_mode(opts, MListTests(v)))
  "--inputs-out" -> Some(CliOptions { ...opts, inputs_out: v })
  "--cache-sha" -> Some(cli_with_cache_sha(opts, v))
  "--path" -> Some(cli_push_search_path(opts, v))
  "--package-root" -> Some(cli_push_pkg_root(opts, v))
  "--package-name" -> Some(cli_with_package_name(opts, v))
  "--unstable-optin" -> Some(cli_push_unstable_optin(opts, v))
  "--edition" -> match edition_of_name(v) {
    Some(e) -> {
      let _w = warn_if_edition_ahead(e)
      Some(cli_with_edition(opts, e))
    }
    None -> {
      eprint(concat_all(["kaic2: unknown edition `", v,
        "` in kai.toml — known editions: tongariki, hanga-roa, orongo"]))
      None
    }
  }
  _ -> None
}

fn parse_cli_with_arg(a: String, noun: String, more: [String], opts: CliOptions) : CliOptions / Console = match more {
  [v, ...rest] -> match apply_flag_arg(a, v, opts) {
    Some(next) -> parse_cli_loop(rest, next)
    None -> cli_with_mode(opts, MUsageError)
  }
  [] -> {
    eprint(concat_all(["kaic2: ", a, " requires ", noun]))
    cli_with_mode(opts, MUsageError)
  }
}

fn parse_cli_other(a: String, more: [String], opts: CliOptions) : CliOptions / Console =
  if a == "--core" or a == "--core-cache" {
    eprint(concat_all(["kaic2: ", a, " is retired in Hanga Roa — the core module set is loaded automatically; remove the flag"]))
    cli_with_mode(opts, MUsageError)
  } else if string_length(a) > 1 and string_slice(a, 0, 1) == "-" {
    eprint(concat_all(["kaic2: unknown option `", a, "`"]))
    cli_with_mode(opts, MUsageError)
  } else {
    parse_cli_loop(more, cli_with_path(opts, a))
  }

fn parse_cli_loop(rest: [String], opts: CliOptions) : CliOptions / Console = match rest {
  [] -> opts
  [a, ...more] -> match flag_plain(a, opts) {
    Some(next) -> parse_cli_loop(more, next)
    None -> match flag_arg_noun(a) {
      Some(noun) -> parse_cli_with_arg(a, noun, more, opts)
      None -> parse_cli_other(a, more, opts)
    }
  }
}

#[doc("Parse argv into CliOptions: mode, path, cores, search paths, edition, and feature flags. Driver entry point called by fn main().")]
pub fn parse_cli(argv: [String]) : CliOptions / Console {

  parse_cli_loop(argv, CliOptions { mode: MDefault, backend: BkC, path: None, cores: [],
                                    core_caches: [], cache_sha: "",
                                    strict_holes: false, search_paths: [], pkg_roots: [],
                                    package_name: "", unstable_optins: [],
                                    edition: None, target: TgHost, user_cache: false, core_cache: cc_opt_off(),
                                    test_roots: [], test_own: [], cover: cover_none(), test_plan: "", kir_verify: "", inputs_out: "", ffi_out: "" })
}
