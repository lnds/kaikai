#[doc("""
Which bare names a diagnostic must ask the author to qualify.

The resolver settles a use site against the scope chain and answers an
identity. This is the other half of the same question, asked ahead of
any use site: given the declarations alone, which names could a reader
not settle on their own? Only the report needs it, so it reads the
entry stream the declaration walker already produces rather than
resolving anything itself.

The ladder here is the report's, not the resolver's: it stops at the
first rung that decides, because a name the reader's own module
declares is never ambiguous to its author however many other modules
declare it too.
""")]

import compiler.util
import compiler.modules
import compiler.module_table
import compiler.decl_names
import compiler.infer_index

#[doc("The table indexed by name, each chain in stream order: a query on one name reads the chain as it would the whole table.")]
pub fn nt_index(t: [NEnt]) : NameIndex[NEnt] = nt_index_rev(list_reverse(t), idx_empty())

fn nt_index_rev(rev: [NEnt], ix: NameIndex[NEnt]) : NameIndex[NEnt] = match rev {
  [] -> ix
  [e, ...rest] -> match e { NEnt(_, n, _, _, _) -> nt_index_rev(rest, idx_prepend(ix, n, e)) }
}

#[doc("Every name declared by two or more homes in class `cls`, each once, in stream order.")]
pub fn nt_collisions(t: [NEnt], cls: NCls) : [String] =
  nt_coll_loop(nt_only(t, cls), [], [])

fn nt_coll_loop(t: [NEnt], seen: [String], acc: [String]) : [String] = match t {
  [] -> list_reverse(acc)
  [NEnt(c, n, _, _, _), ...rest] ->
    if list_has(seen, n) { nt_coll_loop(rest, seen, acc) }
    else if list_length(nt_homes(t, c, n)) > 1 { nt_coll_loop(rest, [n, ...seen], [n, ...acc]) }
    else { nt_coll_loop(rest, [n, ...seen], acc) }
}

#[doc("The homes that declare `name` in class `cls`, deduplicated, in stream order. Fewer than two means the name resolves without qualification.")]
pub fn nt_homes(t: [NEnt], cls: NCls, name: String) : [String] =
  nt_homes_loop(t, cls, name, [])

fn nt_homes_loop(t: [NEnt], cls: NCls, name: String, acc: [String]) : [String] =
  match t {
    [] -> list_reverse(acc)
    [NEnt(c, n, h, _, _), ...rest] ->
      if n == name and ncls_same(c, cls) and list_has(acc, h) == false {
        nt_homes_loop(rest, cls, name, [h, ...acc])
      } else { nt_homes_loop(rest, cls, name, acc) }
  }

#[doc("True when `home` itself declares `name` in class `cls`. The reader's own module wins over every import, so such a use is never ambiguous.")]
pub fn nt_declares(t: [NEnt], cls: NCls, name: String, home: String) : Bool =
  match t {
    [] -> false
    [NEnt(c, n, h, _, _), ...rest] ->
      if n == name and h == home and ncls_same(c, cls) { true }
      else { nt_declares(rest, cls, name, home) }
  }

#[doc("One name a selective import picks, bound to the module it names: `NPick(name, home)`.")]
pub type NPick = NPick(String, String)

#[doc("One `import m.{A, B}` a file wrote: `SelImport(importing file, written module name, picked names)`, importer `\"\"` for the root file.")]
pub type SelImport = SelImport(String, String, [String])

#[doc("The names one file's selective imports pick, tagged with the home each names. `owner` is the importing file, empty for the root.")]
pub fn nt_picks_of(sels: [SelImport], owner: String, mt: [ModuleEntry]) : [NPick] =
  nt_picks_loop(sels, owner, mt, [])

fn nt_picks_loop(sels: [SelImport], owner: String, mt: [ModuleEntry],
      acc: [NPick]) : [NPick] = match sels {
  [] -> list_reverse(acc)
  [SelImport(o, written, names), ...rest] ->
    if o == owner {
      nt_picks_loop(rest, owner, mt, nt_pick_names(names, mt_tagged_name(mt, written), acc))
    } else { nt_picks_loop(rest, owner, mt, acc) }
}

fn nt_pick_names(names: [String], home: String, acc: [NPick]) : [NPick] = match names {
  [] -> acc
  [n, ...rest] -> nt_pick_names(rest, home, [NPick(n, home), ...acc])
}

#[doc("The homes a selective import picks `name` from, deduplicated.")]
pub fn nt_pick_homes(picks: [NPick], name: String, acc: [String]) : [String] = match picks {
  [] -> acc
  [NPick(n, h), ...rest] ->
    if n == name and not list_has(acc, h) { nt_pick_homes(rest, name, [h, ...acc]) }
    else { nt_pick_homes(rest, name, acc) }
}

#[doc("The candidate homes a bare use of `name` must choose between, or `[]` when the ladder already resolves it: the reader's own declaration wins, a selective import naming it decides next (`import m.{T}` says which `T` the file means), the non-core homes outrank the cores, and a single candidate on a rung needs no qualifier.")]
pub fn nt_contested_in(t: [NEnt], picks: [NPick], cls: NCls, name: String,
      reader: String, core: [String]) : [String] =
  if nt_declares(t, cls, name, reader) { [] }
  else {
    let homes = nt_homes(t, cls, name)
    let picked = nt_on_picks(homes, picks, name, [])
    let user = nt_drop_cores(homes, core)
    let rung = if list_length(picked) > 0 { picked }
               else if list_length(user) > 0 { user }
               else { homes }
    if list_length(rung) <= 1 { [] } else { rung }
  }

# The homes a pick names, kept in the candidate order so a report lists
# them the way the declarations arrived.
fn nt_on_picks(homes: [String], picks: [NPick], name: String,
      acc: [String]) : [String] = match homes {
  [] -> list_reverse(acc)
  [h, ...rest] ->
    if nt_picked(picks, name, h) { nt_on_picks(rest, picks, name, [h, ...acc]) }
    else { nt_on_picks(rest, picks, name, acc) }
}

fn nt_picked(picks: [NPick], name: String, home: String) : Bool = match picks {
  [] -> false
  [NPick(n, h), ...rest] ->
    if n == name and h == home { true } else { nt_picked(rest, name, home) }
}

fn nt_drop_cores(homes: [String], core: [String]) : [String] = match homes {
  [] -> []
  [h, ...rest] ->
    if list_has(core, h) { nt_drop_cores(rest, core) } else { [h, ...nt_drop_cores(rest, core)] }
}
