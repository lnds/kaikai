#[doc("""
Walking the reads of a name and classifying them by the edges between the scope root and each read.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.expr_positions
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.infer_apply
import compiler.name_report
import compiler.operators
import compiler.perceus_reads
import compiler.perceus_exit_drops
import compiler.trmc_self_call
import compiler.perceus_arm
import compiler.local_names
import compiler.ast_map

# Buckets of reads a collector fills, and what filling them performs.
type UseAcc = Array[[Read]]
type Collect = Console + Mutable

pub(pkg) fn pcs_use_index(body: Expr, scope: [Binder]) : UseIx / Console = pcs_use_index_in(body, scope, [], prt_no_slots)

pub(pkg) fn pcs_use_index_in(body: Expr, scope: [Binder], boxed: [Binder], slots: (Expr) -> [Int]) : UseIx / Console =
  ni_wrap(prt_expr(body, scope, Prt { capt: [], slots: slots, boxed: boxed, lent: [] }, ni_buckets()))

fn prt_no_slots(f: Expr) : [Int] = []

# `capt` holds the binders a lambda or handler clause reads from outside it: a
# clause borrows what it captures from the handle's env, a lambda from its
# closure, so those reads are captures; a binder declared inside is not. `lent` binders are boxed too, but
# only an operand of an operator lowered raw reads them raw: a boxed Int
# comparison borrows its operands on C and consumes them on native.
# A scope lists the nearest binder first and a handle's state aliases last.
type Prt = { capt: [Binder], slots: (Expr) -> [Int], boxed: [Binder], lent: [Binder] }

fn prt_lam(cx: Prt, scope: [Binder]) : Prt = Prt { capt: scope, slots: cx.slots, boxed: cx.boxed, lent: cx.lent }

fn prt_expr(e: Expr, scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect = match e.kind {
  ELocal(l) -> prt_read(e, l, prt_is_raw(e) and pcs_has(cx.boxed, l), scope, cx, acc)
  EMatch(s, arms) -> prt_arms(arms, scope, cx, prt_expr(s, scope, cx, acc))
  ELambda(ps, body) -> prt_expr(body, list_append(map(ps, (p) => p.binder), scope), prt_lam(cx, scope), acc)
  EBlock(stmts, opt_tail) -> prt_block(stmts, opt_tail, scope, cx, acc)
  EHandle(body, _, _, init_opt, _, clauses, ret_opt) -> {
    let a1 = prt_opt(init_opt, scope, cx, prt_expr(body, scope, cx, acc))
    let aliases = pcs_handle_aliases(init_opt)
    let a2 = prt_clauses(clauses, scope, cx, aliases, a1)
    match ret_opt {
      None -> a2
      Some(HR(b, body2, _, _)) -> prt_expr(body2, [b, ...list_append(scope, aliases)], prt_boxed(cx, b), a2)
    }
  }
  # An `ELitUnit` inner is always a numeric literal.
  ELitUnit(_, _) -> acc
  _ -> prt_reader(e, scope, cx, acc)
}

# The forms whose operands may be read raw.
fn prt_reader(e: Expr, scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect = match e.kind {
  EBinop(op, x, y) ->
    if prt_is_raw(e) { prt_raw_operand(y, scope, cx, prt_raw_operand(x, scope, cx, acc)) }
    else if int_cmp_raw(op, x, y) { prt_operand(y, scope, cx, prt_operand(x, scope, cx, acc)) }
    else { prt_ps(xp_positions(e), scope, cx, acc) }
  EUnop(_, x)  -> if prt_is_raw(e) { prt_raw_operand(x, scope, cx, acc) } else { prt_ps(xp_positions(e), scope, cx, acc) }
  ECall(f, xs) -> {
    let raws = if any(xs, (x) => prt_boxed_var(x, cx.boxed)) { cx.slots(f) } else { [] }
    prt_args(xs, raws, 0, scope, cx, prt_expr(f, scope, cx, acc))
  }
  _ -> prt_ps(xp_positions(e), scope, cx, acc)
}

fn prt_boxed_var(x: Expr, boxed: [Binder]) : Bool = match x.kind {
  ELocal(l) -> pcs_has(boxed, l)
  _         -> false
}

# `raw` says the read copies the payload out of a box the binder holds.
fn prt_read(e: Expr, l: LocalId, raw: Bool, scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect =
  if pcs_has(scope, l) { ni_add_id(acc, local_raw(l), Rd(l, e.line, e.col, pcs_has(cx.capt, l), raw)) }
  else { acc }

# An operand read raw copies the payload out whatever its own mode.
fn prt_operand(x: Expr, scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect = match x.kind {
  ELocal(l) -> prt_read(x, l, pcs_has(cx.boxed, l), scope, cx, acc)
  _         -> prt_expr(x, scope, cx, acc)
}

fn prt_raw_operand(x: Expr, scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect = match x.kind {
  ELocal(l) -> prt_read(x, l, pcs_has(cx.boxed, l) or pcs_has(cx.lent, l), scope, cx, acc)
  _         -> prt_expr(x, scope, cx, acc)
}

fn prt_args(xs: [Expr], raws: [Int], i: Int, scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect = match xs {
  []           -> acc
  [x, ...rest] ->
    prt_args(rest, raws, i + 1, scope, cx, if list_has_int(raws, i) { prt_operand(x, scope, cx, acc) } else { prt_expr(x, scope, cx, acc) })
}

fn prt_opt(oe: Option[Expr], scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect = match oe {
  None    -> acc
  Some(e) -> prt_expr(e, scope, cx, acc)
}

fn prt_ps(ps: [XPos], scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect = match ps {
  [] -> acc
  [XP(r, c), ...rest] -> prt_ps(rest, scope, cx, prt_expr(c, scope, match r { XLam -> prt_lam(cx, scope)  _ -> cx }, acc))
}

fn prt_arms(arms: [Arm], scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect = match arms {
  [] -> acc
  [Arm(pat, opt_g, body), ...rest] -> {
    let scope1 = prc_pat_bindings(pat, scope)
    let cx1 = prt_arm_cx(pat, cx)
    prt_arms(rest, scope, cx, prt_expr(body, scope1, cx1, prt_opt(opt_g, scope1, cx1, acc)))
  }
}

# A list cell holds each element boxed, so an element a list pattern binds
# directly has a box; a variant slot may be bound raw.
# A `return(x)` binder holds the handled result boxed.
fn prt_boxed(cx: Prt, b: Binder) : Prt = Prt { capt: cx.capt, slots: cx.slots, boxed: [b, ...cx.boxed], lent: cx.lent }

fn prt_arm_cx(p: Pattern, cx: Prt) : Prt = match p.pkind {
  PList(_, _)    -> Prt { capt: cx.capt, slots: cx.slots, boxed: prt_list_elems(p, cx.boxed), lent: cx.lent }
  PVariant(_, _) -> Prt { capt: cx.capt, slots: cx.slots, boxed: prt_list_elems(p, cx.boxed), lent: cx.lent }
  _              -> cx
}

fn prt_list_elems(p: Pattern, acc: [Binder]) : [Binder] = match p.pkind {
  PList(subs, _)    -> prt_elems(subs, acc)
  PVariant(_, subs) -> prt_nested(subs, acc)
  PAs(_, sub)       -> prt_list_elems(sub, acc)
  _                 -> acc
}

fn prt_elems(subs: [Pattern], acc: [Binder]) : [Binder] = match subs {
  []           -> acc
  [q, ...rest] -> prt_elems(rest, match q.pkind {
    PBind(b) -> [b, ...acc]
    _        -> prt_list_elems(q, acc)
  })
}

fn prt_nested(subs: [Pattern], acc: [Binder]) : [Binder] = match subs {
  []           -> acc
  [q, ...rest] -> prt_nested(rest, prt_list_elems(q, acc))
}

fn prt_block(stmts: [Stmt], opt_tail: Option[Expr], scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect = match stmts {
  [] -> prt_opt(opt_tail, scope, cx, acc)
  [s, ...rest] -> match s {
    SLet(pat, _, rhs)     -> prt_block(rest, opt_tail, prc_pat_bindings_skip_raw(pat, rhs, scope), cx, prt_expr(rhs, scope, cx, acc))
    SVar(b, _, rhs, _, _) -> prt_block(rest, opt_tail, [b, ...scope], cx, prt_expr(rhs, scope, cx, acc))
    _                     -> prt_block(rest, opt_tail, scope, cx, prt_exprs(stmt_exprs(s), scope, cx, acc))
  }
}

fn prt_exprs(es: [Expr], scope: [Binder], cx: Prt, acc: UseAcc) : UseAcc / Collect = match es {
  []           -> acc
  [e, ...rest] -> prt_exprs(rest, scope, cx, prt_expr(e, scope, cx, acc))
}

# A clause lends its op arguments and, in a stateful handle, every state
# alias to raw operators, which read the payload and leave the box alone.
fn prt_clauses(cs: [HClause], scope: [Binder], cx: Prt, aliases: [Binder], acc: UseAcc) : UseAcc / Collect = match cs {
  [] -> acc
  [HC(_, params, body, _, _), ...rest] -> {
    let own = pcs_filter_non_resume(params)
    let inner = list_append(own, list_append(scope, aliases))
    let lent = list_append(list_append(own, aliases), cx.lent)
    prt_clauses(rest, scope, cx, aliases, prt_expr(body, inner, Prt { capt: scope, slots: cx.slots, boxed: cx.boxed, lent: lent }, acc))
  }
}

fn prt_is_raw(e: Expr) : Bool = match e.mode {
  MUnboxed -> true
  _        -> false
}

# Reads of a name classified by the edges between the scope root and
# each read: reads reachable without crossing a short-circuit edge land
# in the first count (`XAll` chains and `XBr` alternatives — the
# sibling-branch machinery can pay those), reads behind an `XSc`/`XMsg`
# edge (an `and`/`or` RHS, an assert message — skippable with no
# covering alternative) land in the second, and the flag marks reads
# the walk cannot attribute to a path at all (deferred `XLam`/`XCl`
# bodies).
type PcsRR = PRR(Int, Int, Bool)

fn pcs_rr_merge(a: PcsRR, b: PcsRR) : PcsRR = match a {
  PRR(a1, b1, k1) -> match b { PRR(a2, b2, k2) -> PRR(a1 + a2, b1 + b2, k1 or k2) }
}

fn pcs_read_roles(nm: Binder, e: Expr, in_sc: Bool) : PcsRR = match e.kind {
  ELocal(u) -> if local_eq(u, nm.id) {
                 if in_sc { PRR(0, 1, false) } else { PRR(1, 0, false) }
               } else { PRR(0, 0, false) }
  _ -> pcs_read_roles_ps(nm, xp_positions(e), in_sc)
}

fn pcs_read_roles_ps(nm: Binder, ps: [XPos], in_sc: Bool) : PcsRR = match ps {
  []                  -> PRR(0, 0, false)
  [XP(r, c), ...rest] -> {
    let here = match r {
      XAll -> pcs_read_roles(nm, c, in_sc)
      XBr  -> pcs_read_roles(nm, c, in_sc)
      XSc  -> pcs_read_roles(nm, c, true)
      XMsg -> pcs_read_roles(nm, c, true)
      XLam -> pcs_read_roles_deferred(nm, c)
      XCl  -> pcs_read_roles_deferred(nm, c)
    }
    pcs_rr_merge(here, pcs_read_roles_ps(nm, rest, in_sc))
  }
}

fn pcs_read_roles_deferred(nm: Binder, e: Expr) : PcsRR =
  match pcs_read_roles(nm, e, false) {
    PRR(a, b, k) -> if a + b > 0 or k { PRR(0, 0, true) } else { PRR(0, 0, false) }
  }

pub(pkg) fn pcs_branchy_arm_binders(e: Expr, fn_name: SelfRef, uses: UseIx, skip: [Binder],
                           acc: [Binder]) : [Binder] = match e.kind {
  EMatch(s, arms) ->
    pcs_bab_arms(arms, fn_name, uses, skip, pcs_branchy_arm_binders(s, fn_name, uses, skip, acc))
  _ -> pcs_bab_ps(xp_positions(e), fn_name, uses, skip, acc)
}

fn pcs_bab_ps(ps: [XPos], fn_name: SelfRef, uses: UseIx, skip: [Binder], acc: [Binder]) : [Binder] = match ps {
  []                  -> acc
  [XP(r, c), ...rest] -> {
    let acc1 = if xrole_inline(r) { pcs_branchy_arm_binders(c, fn_name, uses, skip, acc) }
               else { acc }
    pcs_bab_ps(rest, fn_name, uses, skip, acc1)
  }
}

fn pcs_bab_arms(arms: [Arm], fn_name: SelfRef, uses: UseIx, skip: [Binder], acc: [Binder]) : [Binder] = match arms {
  []           -> acc
  [Arm(pat, og, b), ...rest] -> {
    let acc1 = pcs_bab_binders(prc_pat_bindings(pat, []), og, b, fn_name, uses, skip, acc)
    let acc2 = match og {
      None    -> acc1
      Some(g) -> pcs_branchy_arm_binders(g, fn_name, uses, skip, acc1)
    }
    pcs_bab_arms(rest, fn_name, uses, skip, pcs_branchy_arm_binders(b, fn_name, uses, skip, acc2))
  }
}

fn pcs_bab_binders(bound: [Binder], og: Option[Expr], b: Expr, fn_name: SelfRef,
                   uses: UseIx, skip: [Binder], acc: [Binder]) : [Binder] = match bound {
  []            -> acc
  [nm, ...rest] -> {
    let acc1 = if pcs_bab_qualifies(nm, og, b, fn_name, uses, skip) { [nm, ...acc] } else { acc }
    pcs_bab_binders(rest, og, b, fn_name, uses, skip, acc1)
  }
}

fn pcs_bab_qualifies(nm: Binder, og: Option[Expr], b: Expr, fn_name: SelfRef,
                     uses: UseIx, skip: [Binder]) : Bool =
  if pcs_has(skip, nm.id) or not pcs_read_once(nm.id, uses) { false }
  else {
    let g_roles = pcs_guard_roles(nm, og)
    let b_roles = pcs_read_roles(nm, b, false)
    pcs_rr_one_skippable(pcs_rr_merge(g_roles, b_roles)) and pcs_bab_body_paid(b_roles, b, fn_name)
  }

fn pcs_guard_roles(nm: Binder, og: Option[Expr]) : PcsRR = match og {
  None    -> PRR(0, 0, false)
  Some(g) -> pcs_read_roles(nm, g, false)
}

# The one read sits behind a short-circuit edge and the walk attributed it.
fn pcs_rr_one_skippable(r: PcsRR) : Bool = match r {
  PRR(a, brc, blocked) -> a == 0 and brc == 1 and not blocked
}

# A guard read pays through the guard-fail drop plus the body drop. A
# body read is forced only when every tail leaf is a self-call, where
# the goto ledger pays it.
fn pcs_bab_body_paid(b_roles: PcsRR, b: Expr, fn_name: SelfRef) : Bool = match b_roles {
  PRR(_, bb, _) -> bb == 0 or (pcs_is_self_tail_call(b, fn_name) and pcs_bab_all_leaves_self(b, fn_name))
}

fn pcs_bab_all_leaves_self(e: Expr, fn_name: SelfRef) : Bool = match e.kind {
  EIf(_, t, oe)   -> pcs_bab_all_leaves_self(t, fn_name) and
                     (match oe { None -> false Some(e2) -> pcs_bab_all_leaves_self(e2, fn_name) })
  EMatch(_, arms) -> pcs_bab_leaves_arms(arms, fn_name)
  EBlock(_, ot)   -> match ot { None -> false Some(t) -> pcs_bab_all_leaves_self(t, fn_name) }
  ECall(f, _)     -> is_self_callee(f, fn_name)
  _               -> false
}

fn pcs_bab_leaves_arms(arms: [Arm], fn_name: SelfRef) : Bool = match arms {
  []                      -> true
  [Arm(_, _, b), ...rest] -> pcs_bab_all_leaves_self(b, fn_name) and pcs_bab_leaves_arms(rest, fn_name)
}

pub(pkg) fn pcs_branchy_let_binders(body: Expr, fn_name: SelfRef, uses: UseIx,
                           skip: [Binder]) : [Binder] =
  pcs_blb_expr(body, body, fn_name, uses, skip, [])

fn pcs_blb_expr(e: Expr, body: Expr, fn_name: SelfRef, uses: UseIx,
                skip: [Binder], acc: [Binder]) : [Binder] = {
  let acc1 = match e.kind {
    EBlock(ss, ot) -> pcs_blb_scan(ss, ot, body, fn_name, uses, skip, acc)
    _              -> acc
  }
  pcs_blb_ps(xp_positions(e), body, fn_name, uses, skip, acc1)
}

fn pcs_blb_ps(ps: [XPos], body: Expr, fn_name: SelfRef, uses: UseIx,
              skip: [Binder], acc: [Binder]) : [Binder] = match ps {
  []                  -> acc
  [XP(r, c), ...rest] -> {
    let acc1 = if xrole_inline(r) { pcs_blb_expr(c, body, fn_name, uses, skip, acc) }
               else { acc }
    pcs_blb_ps(rest, body, fn_name, uses, skip, acc1)
  }
}

fn pcs_blb_scan(ss: [Stmt], ot: Option[Expr], body: Expr, fn_name: SelfRef,
                uses: UseIx, skip: [Binder], acc: [Binder]) : [Binder] = match ss {
  []           -> acc
  [s, ...rest] -> {
    let acc1 = match s {
      SLet(pat, _, rhs) -> match pat.pkind {
        PBind(nm) ->
          if pcs_blb_qualifies(nm, pat, rhs, rest, ot, body, fn_name, uses, skip) {
            [nm, ...acc]
          } else { acc }
        _ -> acc
      }
      _ -> acc
    }
    pcs_blb_scan(rest, ot, body, fn_name, uses, skip, acc1)
  }
}

fn pcs_blb_qualifies(nm: Binder, pat: Pattern, rhs: Expr, rest: [Stmt],
                     ot: Option[Expr], body: Expr, fn_name: SelfRef,
                     uses: UseIx, skip: [Binder]) : Bool =
  pcs_blb_candidate(nm, pat, rhs, uses, skip) and
  pcs_rr_one_skippable(pcs_read_roles(nm, mk_expr(EBlock(rest, ot), pat.line, pat.col), false)) and
  pcs_blb_payer_ok(nm, ot, fn_name)

fn pcs_blb_candidate(nm: Binder, pat: Pattern, rhs: Expr, uses: UseIx, skip: [Binder]) : Bool =
  not pcs_has(skip, nm.id) and pcs_has(prc_pat_bindings_skip_raw(pat, rhs, []), nm.id) and
  pcs_read_once(nm.id, uses)

fn pcs_blb_payer_ok(nm: Binder, ot: Option[Expr], fn_name: SelfRef) : Bool = match ot {
  None    -> true
  Some(t) -> match pcs_read_roles(nm, t, false) {
    PRR(_, tb, _) -> tb == 0 or not ppd_has_self_call(t, fn_name)
  }
}

pub(pkg) fn reuse_gc_uses(ns: LocalNames, cargs: [Expr], gc: [LocalId]) : [LocalId] / Console = match gc {
  [] -> []
  _  -> ru_exprs(cargs, gc, map(gc, (l) => Binder { id: l, name: ln_text(ns, l) }), [])
}

pub(pkg) fn reuse_taken_uses(ns: LocalNames, cargs: [Expr], gc: [LocalId]) : [LocalId] / Console =
  reuse_gc_uses(ns, map(cargs, reuse_unlent), gc)

fn reuse_unlent(e: Expr) : Expr = match e.kind {
  ECall(f, _) -> match f.kind {
    EMark(MkBorrow) -> Expr { ...e, kind: EUnit }
    _               -> ru_map(e)
  }
  _ -> ru_map(e)
}

fn ru_map(e: Expr) : Expr = Expr { ...e, kind: prc_map_expr_kind(e.kind, reuse_unlent) }

fn ru_exprs(es: [Expr], gc: [LocalId], scope: [Binder], acc: [LocalId]) : [LocalId] / Console = match es {
  []           -> acc
  [e, ...rest] -> {
    let ix = pcs_use_index(e, scope)
    ru_exprs(rest, gc, scope, ru_names(gc, ix, acc))
  }
}

# The collector grows its scope with lambda params, so it indexes their
# reads too: only the donor binders' reads count, one entry per read.
fn ru_names(gc: [LocalId], ix: UseIx, acc: [LocalId]) : [LocalId] = match gc {
  []           -> acc
  [g, ...rest] -> ru_names(rest, ix, ru_reads_of(g, ni_bucket_id(ix, local_raw(g)), acc))
}

fn ru_reads_of(g: LocalId, us: [Read], acc: [LocalId]) : [LocalId] = match us {
  [] -> acc
  [Rd(l, _, _, _, _), ...rest] -> ru_reads_of(g, rest, if local_eq(l, g) { [g, ...acc] } else { acc })
}

pub(pkg) fn reuse_taken_binders(gc: [LocalId], uses: [LocalId]) : [LocalId] = filter(gc, (n) => any(uses, (u) => local_eq(u, n)))
