#[doc("""
One level of A-normal form around an operand: the operands evaluated
before it are bound first, in order; it is bound last; the rest stay in
place, evaluated after it. The non-tail `resume` split binds the
resuming operand and cuts the block at that binding; the unwind naming
binds the last operand that can unwind, so the values computed before it
are named binders.
""")]

import compiler.ast
import compiler.resume_scan
import compiler.anf_ops

#[doc("A node with its resuming operand bound in a block, and the next fresh-name counter.")]
pub type Anf = { e: Expr, n: Int }

#[doc("Bind the operands of `e` up to the one that calls `k`, or `None` for a shape whose resuming operand cannot be split out.")]
pub fn anf_resuming_operand(e: Expr, k: String, n: Int) : Option[Anf] = bind_picked(e, (x) => rs_has_k(x, k), false, "__resume_v", n)

#[doc("Bind the operands of `e` up to the last one `pick` holds, naming the binders `prefix` and a counter from `n`; `None` for a shape whose operand cannot be split out.")]
pub fn anf_bind_until(e: Expr, pick: (Expr) -> Bool, prefix: String, n: Int) : Option[Anf] = bind_picked(e, pick, true, prefix, n)

fn bind_picked(e: Expr, pick: (Expr) -> Bool, last: Bool, prefix: String, n: Int) : Option[Anf] = match anf_operands_of(e, pick) {
  Some(Ops(xs, rebuild)) -> {
    let h = hoist_until(xs, picked_index(xs, pick, last, 0, 0 - 1), prefix, n, [], [])
    Some(Anf { e: with_kind(e, EBlock(h.lets, Some(with_kind(e, rebuild(h.vals))))), n: h.n })
  }
  None -> None
}

#[doc("The index of the first (or, with `last`, the last) of `xs` that `pick` holds, counting from `i`; `found` when none does.")]
pub fn picked_index(xs: [Expr], pick: (Expr) -> Bool, last: Bool, i: Int, found: Int) : Int = match xs {
  [] -> found
  [x, ...rest] ->
    if not pick(x) { picked_index(rest, pick, last, i + 1, found) }
    else if last { picked_index(rest, pick, last, i + 1, i) }
    else { i }
}

type Hoisted = { lets: [Stmt], vals: [Expr], n: Int }

# Operands before the picked one, at `at`, are bound in order so they
# still run first; the picked one is bound last; the rest stay in place.
fn hoist_until(xs: [Expr], at: Int, prefix: String, n: Int, lets: [Stmt], vals: [Expr]) : Hoisted = match xs {
  [] -> Hoisted { lets: list_reverse(lets), vals: list_reverse(vals), n: n }
  [x, ...rest] ->
    if at == 0 {
      let v = fresh(prefix, n)
      Hoisted { lets: list_reverse([let_of(v, x), ...lets]),
                vals: list_append(list_reverse([ref_of(v, x), ...vals]), rest), n: n + 1 }
    } else if anf_is_atom(x) { hoist_until(rest, at - 1, prefix, n, lets, [x, ...vals]) }
    else { hoist_until(rest, at - 1, prefix, n + 1, [let_of(fresh(prefix, n), x), ...lets], [ref_of(fresh(prefix, n), x), ...vals]) }
}

fn fresh(prefix: String, n: Int) : String = string_concat(prefix, int_to_string(n))

fn let_of(v: String, x: Expr) : Stmt = SLet(Pattern { pkind: PBind(v), line: x.line, col: x.col }, None, x)

# The read keeps the operand's type, so a pass after the typer sees it typed.
fn ref_of(v: String, x: Expr) : Expr = Expr { kind: EVar(v), line: x.line, col: x.col, ty: x.ty, mode: x.mode,  site: x.site }

