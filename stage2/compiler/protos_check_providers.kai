#[doc("""
The types that have, or by a derive will have, an impl of a protocol:
what a derive check accepts as a field type.
""")]

import compiler.ast
import compiler.rt_name
import compiler.core_protos
import compiler.proto_resolve
import compiler.derive_pick
import compiler.protos_names
import compiler.protos_lower_impls
import compiler.protos_derive_check
import compiler.protos_heads

#[doc("""
The emitted names of the types deriving BinSerialize, plus with `impls`
those with a hand-written impl.
""")]
pub fn collect_binser_types(ps: PScope, decls: [Decl], impls: Bool, acc: [String]) : [String] =
  list_append(map(binser_type_refs(ps, decls, impls, []), (r) => rt_ref_name(ps_tab(ps), r)), acc)

#[doc("""
Types deriving BinSerialize, plus with `impls` the targets of a
hand-written impl.
""")]
pub fn binser_type_refs(ps: PScope, decls: [Decl], impls: Bool, acc: [DeclRef]) : [DeclRef] {
  match decls {
    [] -> acc
    [d, ...rest] -> match d {
      DImpl(pref, _, target, ms, _, _, _, _) ->
        if impls and proto_is(proto_ref_sym(ps, pref, impl_home_of(ms)), CpBinSerialize) {
          binser_type_refs(ps, rest, impls, [vdv_head(ps, target, impl_home_of(ms)), ...acc])
        } else {
          binser_type_refs(ps, rest, impls, acc)
        }
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, _, _, _, _, _, _) ->
          if derives_core(ps, names, derive_from(ps, inner), CpBinSerialize) {
            binser_type_refs(ps, rest, impls, [DrSym(tsym), ...acc])
          } else {
            binser_type_refs(ps, rest, impls, acc)
          }
        _ -> binser_type_refs(ps, rest, impls, acc)
      }
      DUnstable(inner, _, _) ->
        binser_type_refs(ps, [inner, ...rest], impls, acc)
      DProtoLaws(_, inner, _, _, _) ->
        binser_type_refs(ps, [inner, ...rest], impls, acc)
      DImplAxiom(_, inner, _, _, _) ->
        binser_type_refs(ps, [inner, ...rest], impls, acc)
      DConstructor(inner, _, _) ->
        binser_type_refs(ps, [inner, ...rest], impls, acc)
      _ -> binser_type_refs(ps, rest, impls, acc)
    }
  }
}

#[doc("The types with an `Ord` impl, written or about to be derived, as heads settled in the file that names them.")]
pub fn collect_ord_providers(ps: PScope, sg: ShapedGens, decls: [Decl], acc: [DeclRef]) : [DeclRef] {
  match decls {
    [] -> acc
    [d, ...rest] -> match d {
      DImpl(pref, _, target, ms, _, _, _, _) ->
        if gen_is(proto_gen(sg, proto_ref_sym(ps, pref, impl_home_of(ms))), CpOrd) {
          collect_ord_providers(ps, sg, rest, [vdv_head(ps, target, impl_home_of(ms)), ...acc])
        } else {
          collect_ord_providers(ps, sg, rest, acc)
        }
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, _, _, _, _, _, _) ->
          if derives_gen(ps, sg, names, derive_from(ps, inner), CpOrd) {
            collect_ord_providers(ps, sg, rest, [DrSym(tsym), ...acc])
          } else {
            collect_ord_providers(ps, sg, rest, acc)
          }
        _ -> collect_ord_providers(ps, sg, rest, acc)
      }
      DUnstable(inner, _, _) ->
        collect_ord_providers(ps, sg, [inner, ...rest], acc)
      DProtoLaws(_, inner, _, _, _) ->
        collect_ord_providers(ps, sg, [inner, ...rest], acc)
      DImplAxiom(_, inner, _, _, _) ->
        collect_ord_providers(ps, sg, [inner, ...rest], acc)
      DConstructor(inner, _, _) ->
        collect_ord_providers(ps, sg, [inner, ...rest], acc)
      _ -> collect_ord_providers(ps, sg, rest, acc)
    }
  }
}
