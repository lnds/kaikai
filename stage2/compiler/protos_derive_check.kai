#[doc("""
Checks on `#[derive]` before expansion: each entry picks a generator, and every field type reaches an impl of the derived protocol; the `Layout` and JSON derive checks.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.core_refs
import compiler.core_types
import compiler.diag_file
import compiler.diag
import compiler.util
import compiler.proto_resolve
import compiler.scalar_ty
import compiler.derive_reach
import compiler.type_text
import compiler.protos_registry
import compiler.protos_impls
import compiler.infer_index
import compiler.layout_derive
import compiler.json_shape
import compiler.expr_positions
import compiler.operators

#[doc("""
Validate, before expansion, that every `#[derive(P)]` of Eq, Hash or
Show can be discharged: each field type must reach an impl that answers
the derive (explicit, derived, or builtin) through every type argument a
container impl bounds by its protocol, so `[(Int, String)]` needs one on
`List` and on `Pair`.
""")]
pub(pkg) fn validate_derives(ps: PScope, sg: ShapedGens, ds: [Decl], df: DiagFiles) : [Diagnostic] / Console =
  list_reverse(validate_derives_loop(ps, sg, ds, df, collect_impl_reach(ps, sg, ds, []), eq_types(ds), []))

# Every impl, written or derived, of a protocol whose generator's fields
# are checked here.
fn collect_impl_reach(ps: PScope, sg: ShapedGens, ds: [Decl], acc: [ImplReach]) : [ImplReach] {
  match ds {
    [] -> acc
    [d, ...rest] -> match d {
      DImpl(pref, _, target, ms, _, _, tps, _) -> {
        let from = impl_home_of(ms)
        let p = proto_ref_sym(ps, pref, from)
        let acc1 = if gen_reach_checked(proto_gen(sg, p)) {
          [impl_reach(p, head_tree(ps, from, tps, target), tps,
                      (b) => psc_same(proto_ref_sym(ps, b, from), p)), ...acc]
        } else { acc }
        collect_impl_reach(ps, sg, rest, acc1)
      }
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, tps, _, _, _, _, _) ->
          collect_impl_reach(ps, sg, rest, list_append(map(reach_gens(ps, sg, names, derive_from(ps, inner)),
                                                       (g) => derived_reach(gen_proto(g), tsym, tps)), acc))
        _ -> collect_impl_reach(ps, sg, rest, acc)
      }
      DUnstable(inner, _, _) ->
        collect_impl_reach(ps, sg, [inner, ...rest], acc)
      DProtoLaws(_, inner, _, _, _) ->
        collect_impl_reach(ps, sg, [inner, ...rest], acc)
      DImplAxiom(_, inner, _, _, _) ->
        collect_impl_reach(ps, sg, [inner, ...rest], acc)
      DConstructor(inner, _, _) ->
        collect_impl_reach(ps, sg, [inner, ...rest], acc)
      _ -> collect_impl_reach(ps, sg, rest, acc)
    }
  }
}

# A type as the file homed at `from` reads it, head by head: a type
# parameter of the declaration, one of `params`, is filed under its
# binder's name, and any other head is settled to the declaration it
# denotes there.
fn head_tree(ps: PScope, from: Option[String], params: [TBinder], te: TypeExpr) : HeadTree =
  HT(reach_head(ps, from, params, te), map(te_type_args(te), (a) => head_tree(ps, from, params, a)))

fn reach_head(ps: PScope, from: Option[String], params: [TBinder], te: TypeExpr) : DeclRef =
  match te_param_of(te, params) {
    Some(b) -> param_head(b)
    None    -> vdv_head(ps, te, from)
  }

#[doc("The parameter among `params` a type is a use of, if it is one.")]
pub(pkg) fn te_param_of(te: TypeExpr, params: [TBinder]) : Option[TBinder] = match te.tkind {
  TyParam(id, _) -> tbs_find(params, id)
  _              -> None
}

fn te_type_args(te: TypeExpr) : [TypeExpr] = match te.tkind {
  TyName(_, args)   -> args
  TyParam(_, args)  -> args
  TyList(elem)      -> [elem]
  TyDim(base, _)    -> te_type_args(base)
  TyRefine(base, _) -> te_type_args(base)
  _                 -> []
}

# Builtin impls bundled with kaikai for primitive types, kept in
# sync with stdlib/protocols.kai. The validator treats these as
# always available so users do not have to redeclare `impl Eq for
# Int` in every fixture that derives Eq on a sum carrying Ints.
#[doc("True iff kaikai bundles a structural builtin impl of the core protocol `p` for primitive head `tname` (Eq/Show/Ord/Hash over Int/Real/String/... and fixed-width ints).")]
pub(pkg) fn derive_builtin_impl(p: CoreProto, tname: String) : Bool = match p {
  CpEq ->
    list_has(["Int", "Real", "Bool", "String", "Char", "Unit"], tname) or is_fixed_width_name(tname)
  CpHash ->
    list_has(["Int", "Real", "String", "Bool", "Char"], tname) or is_fixed_width_name(tname)
  CpShow ->
    list_has(["Int", "Real", "Bool", "String", "Unit", "Char"], tname) or is_fixed_width_name(tname)
  CpOrd -> is_fixed_width_name(tname)
  _     -> false
}

# An `Eq` field of a data type with no parameters is covered when the type's own fields are.
fn head_plain_data_eq(rd: ReachRead, impls: [ImplReach], serves: (SymId) -> Bool, h: DeclRef) : Bool =
  ref_resolved(h) and plain_data_eq(eq_env_of(rd.ps, (s) => any(impls, (ir) => impl_reach_serves(rd.ps, serves, ir, s)), (s) => false, rd.types), ref_sym(h))

fn impl_reach_serves(ps: PScope, serves: (SymId) -> Bool, ir: ImplReach, s: SymId) : Bool = match ir {
  IR(p, ih, _) -> serves(p) and refs_same(ps_tab(ps), ih, DrSym(s))
}

# Only a scalar has a builtin impl, and a scalar head stays as written.
fn head_builtin_impl(g: CoreProto, h: DeclRef) : Bool = match h {
  DrWritten(None, _) -> derive_builtin_impl(g, ref_spelled(h))
  _                  -> false
}

#[doc("The file a derive's entries are written in: the one declaring the type.")]
pub(pkg) fn derive_from(ps: PScope, inner: Decl) : Option[String] = decl_type_home(inner, ps_root(ps))

fn gen_proto(d: DeriveGen) : SymId = match d { DeriveGen(p, _) -> p }

#[doc("True when the generator a derive picked is the core protocol `g`.")]
pub(pkg) fn gen_is(picked: Option[CoreProto], g: CoreProto) : Bool = match picked {
  Some(p) -> core_proto_same(p, g)
  None    -> false
}

#[doc("What each `#[derive]` entry fails to pick, in declaration order.")]
pub(pkg) fn derive_entry_diags(ps: PScope, sg: ShapedGens, ds: [Decl], df: DiagFiles, acc: [Diagnostic]) : [Diagnostic] = match ds {
  [] -> list_reverse(acc)
  [d, ...rest] -> match d {
    DDerive(names, inner, line, col) ->
      derive_entry_diags(ps, sg, rest, df,
        derive_pick_diags(ps, sg, names, derive_from(ps, inner), decl_diag_file(d, df), line, col, acc))
    DUnstable(inner, _, _)        -> derive_entry_diags(ps, sg, [inner, ...rest], df, acc)
    DProtoLaws(_, inner, _, _, _) -> derive_entry_diags(ps, sg, [inner, ...rest], df, acc)
    DImplAxiom(_, inner, _, _, _) -> derive_entry_diags(ps, sg, [inner, ...rest], df, acc)
    DConstructor(inner, _, _)     -> derive_entry_diags(ps, sg, [inner, ...rest], df, acc)
    _ -> derive_entry_diags(ps, sg, rest, df, acc)
  }
}

fn validate_derives_loop(ps: PScope, sg: ShapedGens, ds: [Decl], df: DiagFiles, reach: [ImplReach],
                         types: [Decl], errs: [Diagnostic]) : [Diagnostic] / Console {
  match ds {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, line, col) -> {
        let site = DS(decl_diag_file(d, df), line, col)
        let errs1 = validate_derive_decl(ps, sg, names, inner, site, reach, types, errs)
        validate_derives_loop(ps, sg, rest, df, reach, types, errs1)
      }
      DUnstable(inner, _, _) ->
        validate_derives_loop(ps, sg, [inner, ...rest], df, reach, types, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derives_loop(ps, sg, [inner, ...rest], df, reach, types, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derives_loop(ps, sg, [inner, ...rest], df, reach, types, errs)
      DConstructor(inner, _, _) ->
        validate_derives_loop(ps, sg, [inner, ...rest], df, reach, types, errs)
      _ -> validate_derives_loop(ps, sg, rest, df, reach, types, errs)
    }
  }
}

# Where a derive reports: the file and position of its declaration.
type DeriveSite = DS(String, Int, Int)

# What a derive's fields are read with: the scope, the file and the type
# parameters of the deriving type, its name, and where it reports.
type ReachRead = { ps: PScope, from: Option[String], params: [TBinder], tname: String, site: DeriveSite, types: [Decl] }

fn validate_derive_decl(ps: PScope, sg: ShapedGens, names: [String], inner: Decl, site: DeriveSite,
                        reach: [ImplReach], types: [Decl], errs: [Diagnostic]) : [Diagnostic] / Console = match inner {
  DType(_, tsym, tps, body, _, _, _, _) -> {
    let tab = ps_tab(ps)
    let from = derive_from(ps, inner)
    let gens = reach_gens(ps, sg, names, from)
    let own = list_append(map(gens, (g) => derived_reach(gen_proto(g), tsym, tps)), param_reaches(gens, tps))
    let rd = ReachRead { ps: ps, from: from, params: tps, tname: ref_text(tab, DrSym(tsym)), site: site, types: types }
    validate_derive_protos(rd, sg, gens, derive_field_types(tab, body), list_append(own, reach), errs)
  }
  _ -> errs
}

# The entries whose generator's fields are checked here.
fn reach_gens(ps: PScope, sg: ShapedGens, names: [String], from: Option[String]) : [DeriveGen] =
  filter(derive_gens(ps, sg, names, from), (d) => match d { DeriveGen(_, g) -> gen_reach_checked(Some(g)) })

fn gen_reach_checked(picked: Option[CoreProto]) : Bool = match picked {
  Some(CpEq)   -> true
  Some(CpHash) -> true
  Some(CpShow) -> true
  _            -> false
}

# A field typed by a parameter the derive bounds is covered by that bound.
fn param_reaches(gens: [DeriveGen], tps: [TBinder]) : [ImplReach] = match gens {
  []          -> []
  [g, ...rest] ->
    list_append(map(derive_bound_params(tps), (tp) => param_reach(gen_proto(g), tp)), param_reaches(rest, tps))
}

# Each field a derived impl reads, labelled the way a diagnostic names it.
type DeriveField = DFld(String, TypeExpr)

fn derive_field_types(tab: SymTab, body: TypeBody) : [DeriveField] = match body {
  TBSum(variants)  -> variant_fields(tab, variants)
  TBRecord(fields) -> map(fields, record_field)
  _                -> []
}

fn variant_fields(tab: SymTab, vs: [Variant]) : [DeriveField] = match vs {
  []           -> []
  [v, ...rest] -> match v {
    Var(vsym, vargs) ->
      list_append(variant_args(written_text(sym_name(tab, vsym)), vargs, 0), variant_fields(tab, rest))
  }
}

fn variant_args(vname: String, vargs: [TypeExpr], i: Int) : [DeriveField] = match vargs {
  []            -> []
  [te, ...rest] ->
    [DFld(concat_all(["variant `", vname, "` field #", int_to_string(i)]), te),
     ...variant_args(vname, rest, i + 1)]
}

fn record_field(f: FieldDecl) : DeriveField = match f {
  FD(_, fname, te, _) -> DFld(concat_all(["field `", fname, "`"]), te)
}

fn validate_derive_protos(rd: ReachRead, sg: ShapedGens, gens: [DeriveGen], fields: [DeriveField],
                          impls: [ImplReach], errs: [Diagnostic]) : [Diagnostic] / Console = match gens {
  []           -> errs
  [d, ...rest] ->
    validate_derive_protos(rd, sg, rest, fields, impls,
                           validate_derive_fields(rd, d, derive_reach_of(rd, sg, d, impls), fields, errs))
}

# An impl of the derived protocol answers the derive. A core protocol's
# derived body names its operation through the core home, so nothing else
# does; any other protocol's names it bare, so an impl of every protocol
# that picks the same generator answers too.
fn derive_reach_of(rd: ReachRead, sg: ShapedGens, d: DeriveGen, impls: [ImplReach]) : ReachCx = match d {
  DeriveGen(p, g) -> {
    let ps = rd.ps
    let tab = ps_tab(ps)
    let serves = (q) => psc_same(q, p) or (not proto_is(p, g) and gen_is(proto_gen(sg, q), g))
    ReachCx { impls: impls,
              serves: serves,
              same: (a, b) => refs_same(tab, a, b),
              builtin: (h) => head_builtin_impl(g, h) or (proto_is(p, g) and core_proto_same(g, CpEq) and head_plain_data_eq(rd, impls, serves, h)) }
  }
}

fn validate_derive_fields(rd: ReachRead, d: DeriveGen, reach: ReachCx, fields: [DeriveField],
                          errs: [Diagnostic]) : [Diagnostic] / Console = match fields {
  []           -> errs
  [f, ...rest] -> match f {
    DFld(what, te) -> {
      let tab = ps_tab(rd.ps)
      let path = map(missing_path(reach, head_tree(rd.ps, rd.from, rd.params, te)), (r) => match head_param(rd.params, r) {
        Some(b) -> tb_text(b)
        None    -> ref_text(tab, r)
      })
      let errs1 = match path {
        [] -> errs
        _  -> [report_derive_missing(ref_text(tab, DrSym(gen_proto(d))), rd.tname, what, path, rd.site), ...errs]
      }
      validate_derive_fields(rd, d, reach, rest, errs1)
    }
  }
}

fn last_head(path: [String]) : String = match path {
  []           -> ""
  [h]          -> h
  [_, ...rest] -> last_head(rest)
}

#[doc("A derive error, printed on the single line the derive diagnostics use.")]
pub(pkg) fn derive_error(file: String, line: Int, col: Int, msg: String) : Diagnostic / Console = {
  eprint(concat_all([file, ":", int_to_string(line), ":", int_to_string(col), ": error: ", msg]))
  mk_diag(SevError, file, line, col, msg, [])
}

fn report_derive_missing(pname: String, tname: String, what: String, path: [String],
                         site: DeriveSite) : Diagnostic / Console = match site {
  DS(file, line, col) -> {
    let head = last_head(path)
    let lacks = concat_all(["no `impl ", pname, " for ", head, "` in this compilation unit"])
    let tail = match path {
      [_] -> concat_all([" which has ", lacks])
      _   -> concat_all(["; `", head, "` has ", lacks])
    }
    derive_error(file, line, col, concat_all([
      "cannot derive `", pname, "` for `", tname, "`: ", what,
      " has type `", path_type(path), "`", tail]))
  }
}

#[doc("""
Pre-expansion validator for `#[derive(Layout)]`. `derive_layout_impl`
returns no decls when the record is not Layout-bearing, so without this
pass the omission surfaces only as a missing `to_bytes` at the first
call site. Walks the original decl stream and reports each offending
field with the remedy that applies to it.
""")]
pub(pkg) fn validate_derive_layout(ps: PScope, decls: [Decl], df: DiagFiles) : [Diagnostic] / Console =
  list_reverse(validate_derive_layout_loop(ps, decls, df, []))

fn validate_derive_layout_loop(ps: PScope, decls: [Decl], df: DiagFiles,
                                 errs: [Diagnostic]) : [Diagnostic] / Console {
  match decls {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, _, body, line, col, _, _) ->
          if derives_core(ps, names, derive_from(ps, inner), CpLayout) {
            let file = decl_diag_file(d, df)
            let errs1 = validate_derive_layout_body(ps_tab(ps), file, vdv_type_name(ps, tsym), body,
                                                     line, col, errs)
            validate_derive_layout_loop(ps, rest, df, errs1)
          } else {
            validate_derive_layout_loop(ps, rest, df, errs)
          }
        _ -> validate_derive_layout_loop(ps, rest, df, errs)
      }
      DUnstable(inner, _, _) ->
        validate_derive_layout_loop(ps, [inner, ...rest], df, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derive_layout_loop(ps, [inner, ...rest], df, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derive_layout_loop(ps, [inner, ...rest], df, errs)
      DConstructor(inner, _, _) ->
        validate_derive_layout_loop(ps, [inner, ...rest], df, errs)
      _ -> validate_derive_layout_loop(ps, rest, df, errs)
    }
  }
}

fn validate_derive_layout_body(tab: SymTab, file: String, tname: String, body: TypeBody,
                                 line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match body {
    TBRecord(fields) -> match fields {
      [] -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Layout)]` for `", tname,
          "`: a Layout record needs at least one field"]))
        [derr, ...errs]
      }
      _ -> validate_derive_layout_fields(tab, file, tname, fields, line, col, errs)
    }
    _ -> {
      let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Layout)]` for `", tname,
        "`: Layout applies to records, not sum types"]))
      [derr, ...errs]
    }
  }
}

fn validate_derive_layout_fields(tab: SymTab, file: String, tname: String,
                                   fields: [FieldDecl], line: Int, col: Int,
                                   errs: [Diagnostic]) : [Diagnostic] / Console {
  match fields {
    [] -> errs
    [fd, ...rest] -> {
      let errs1 = validate_derive_layout_one(tab, file, tname, fd, line, col, errs)
      validate_derive_layout_fields(tab, file, tname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_layout_one(tab: SymTab, file: String, tname: String, fd: FieldDecl,
                                line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  let rej = layout_reject_of(tab, fd)
  if layout_reject_is_err(rej) {
    match fd {
      FD(_, fname, ftype, _) -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Layout)]` for `", tname,
          "`: field `", fname, "` of type `", layout_head_name(tab, ftype),
          "` is not Layout-bearing: ", layout_reject_why(rej)]))
        [derr, ...errs]
      }
    }
  } else { errs }
}

#[doc("""
Pre-expansion validator for `#[derive(Json)]`. Same shape as the
Layout one: `derive_json_impl` returns no decls when a field has no
JSON denotation, so without this pass the omission surfaces only as a
missing `to_json` at the first call site.
""")]
pub(pkg) fn validate_derive_json(ps: PScope, decls: [Decl], df: DiagFiles) : [Diagnostic] / Console =
  list_reverse(validate_derive_json_loop(ps, decls, df, []))

fn validate_derive_json_loop(ps: PScope, decls: [Decl], df: DiagFiles,
                              errs: [Diagnostic]) : [Diagnostic] / Console {
  match decls {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, tps, body, line, col, _, _) ->
          if derives_core(ps, names, derive_from(ps, inner), CpJson) {
            let file = decl_diag_file(d, df)
            let settled = heads_body(HeadScope(ps, derive_from(ps, inner)), body)
            let errs1 = validate_derive_json_body(ps_tab(ps), file, vdv_type_name(ps, tsym), settled, line, col, errs)
            validate_derive_json_loop(ps, rest, df, errs1)
          } else {
            validate_derive_json_loop(ps, rest, df, errs)
          }
        _ -> validate_derive_json_loop(ps, rest, df, errs)
      }
      DUnstable(inner, _, _) ->
        validate_derive_json_loop(ps, [inner, ...rest], df, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derive_json_loop(ps, [inner, ...rest], df, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derive_json_loop(ps, [inner, ...rest], df, errs)
      DConstructor(inner, _, _) ->
        validate_derive_json_loop(ps, [inner, ...rest], df, errs)
      _ -> validate_derive_json_loop(ps, rest, df, errs)
    }
  }
}

fn validate_derive_json_body(tab: SymTab, file: String, tname: String, body: TypeBody,
                              line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match body {
    TBRecord(fields) -> match fields {
      [] -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
          "`: a Json record needs at least one field"]))
        [derr, ...errs]
      }
      _ -> validate_derive_json_fields(tab, file, tname, fields, line, col, errs)
    }
    TBSum(variants) -> match variants {
      [] -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
          "`: a Json sum needs at least one variant"]))
        [derr, ...errs]
      }
      _ -> validate_derive_json_variants(tab, file, tname, variants, line, col, errs)
    }
    _ -> {
      let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
        "`: Json applies to records and sum types, not type aliases"]))
      [derr, ...errs]
    }
  }
}

# Each variant payload must be JSON-bindable. The adjacently-tagged
# envelope encodes the payload under `value`, so an unbindable payload
# type is reported the same way an unbindable record field is.
fn validate_derive_json_variants(tab: SymTab, file: String, tname: String, variants: [Variant],
                                  line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match variants {
    [] -> errs
    [v, ...rest] -> {
      let errs1 = validate_derive_json_variant(tab, file, tname, v, line, col, errs)
      validate_derive_json_variants(tab, file, tname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_json_variant(tab: SymTab, file: String, tname: String, v: Variant,
                                 line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match v {
    Var(vsym, vargs) ->
      validate_derive_json_payload(tab, file, tname, written_text(sym_name(tab, vsym)), vargs, line, col, errs)
  }
}

fn validate_derive_json_payload(tab: SymTab, file: String, tname: String, vname: String,
                                 vargs: [TypeExpr], line: Int, col: Int,
                                 errs: [Diagnostic]) : [Diagnostic] / Console {
  match vargs {
    [] -> errs
    [t, ...rest] -> {
      let errs1 = match json_field_reject(tab, t) {
        None -> errs
        Some(why) -> {
          let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
            "`: variant `", vname, "` payload of type `", json_head_name(tab, t),
            "` is not JSON-bindable: ", why]))
          [derr, ...errs]
        }
      }
      validate_derive_json_payload(tab, file, tname, vname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_json_fields(tab: SymTab, file: String, tname: String, fields: [FieldDecl],
                                line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match fields {
    [] -> errs
    [fd, ...rest] -> {
      let errs1 = validate_derive_json_one(tab, file, tname, fd, line, col, errs)
      validate_derive_json_fields(tab, file, tname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_json_one(tab: SymTab, file: String, tname: String, fd: FieldDecl,
                             line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match fd {
    FD(_, fname, ftype, attrs) ->
      # A `#[json(skip)]` field never touches the wire, so its type need
      # not be JSON-bindable — but decode must be able to reconstruct it,
      # which requires a `#[json(default)]` or an `Option` type.
      if field_attr_json_skip(attrs) {
        let has_default = match field_attr_json_default(attrs) { Some(_) -> true None -> false }
        if has_default or json_head_is_option(ftype) { errs }
        else {
          let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
            "`: field `", fname, "` carries `#[json(skip)]` but has no `#[json(default)]` and is not `Option` — decode cannot reconstruct a skipped field"]))
          [derr, ...errs]
        }
      } else { match json_field_reject(tab, ftype) {
        None -> errs
        Some(why) -> {
          let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
            "`: field `", fname, "` of type `", json_head_name(tab, ftype),
            "` is not JSON-bindable: ", why]))
          [derr, ...errs]
        }
      } }
  }
}

# ---- Eq without an impl ----

#[doc("What `Eq` is read against: the scope, which types have an `Eq` and an `Ord` impl, the type declarations of the program, and the types that are not `Eq` (a function among their fields, directly or through another such type) and carry no impl.")]
pub(pkg) type EqEnv = { ps: PScope, has_eq: (SymId) -> Bool, has_ord: (SymId) -> Bool, types: [Decl], bad: NameIndex[SymId] }

#[doc("The environment for deciding `Eq` and `Ord` over the program `ds` when `has_eq` and `has_ord` say which types have an impl.")]
pub(pkg) fn eq_env_of(ps: PScope, has_eq: (SymId) -> Bool, has_ord: (SymId) -> Bool, ds: [Decl]) : EqEnv =
  mk_env(ps, has_eq, has_ord, ds)

fn mk_env(ps: PScope, has_eq: (SymId) -> Bool, has_ord: (SymId) -> Bool, ds: [Decl]) : EqEnv = {
  let types = type_decls(ds, [])
  EqEnv { ps: ps, has_eq: has_eq, has_ord: has_ord, types: types, bad: bad_fixpoint(type_uses(ps, has_eq, types), idx_empty()) }
}

#[doc("True when `s` is a data type with no type parameters whose fields are all `Eq`.")]
pub(pkg) fn plain_data_eq(env: EqEnv, s: SymId) : Bool = match find(env.types, (d) => type_decl_is(d, s)) {
  Some(DType(_, _, [], _, _, _, _, _)) -> not in_bad(env.bad, s)
  _                                    -> false
}

#[doc("The type declarations of the program `ds`.")]
pub(pkg) fn eq_types(ds: [Decl]) : [Decl] = type_decls(ds, [])

fn type_decls(ds: [Decl], acc: [Decl]) : [Decl] = match ds {
  []           -> acc
  [d, ...rest] -> match d {
    DType(_, _, _, _, _, _, _, _) -> type_decls(rest, [d, ...acc])
    DUnstable(inner, _, _)        -> type_decls([inner, ...rest], acc)
    DProtoLaws(_, inner, _, _, _) -> type_decls([inner, ...rest], acc)
    DImplAxiom(_, inner, _, _, _) -> type_decls([inner, ...rest], acc)
    DConstructor(inner, _, _)     -> type_decls([inner, ...rest], acc)
    _                             -> type_decls(rest, acc)
  }
}

fn in_bad(bad: NameIndex[SymId], s: SymId) : Bool = match idx_chain_sym(bad, s) {
  [] -> false
  _  -> true
}

# Core types hold no function, so they are never listed. A type with no impl of its own, what it holds directly, and the types it names.
type TypeUse = TypeUse(SymId, Bool, [SymId])

fn type_uses(ps: PScope, has_eq: (SymId) -> Bool, types: [Decl]) : [TypeUse] = match types {
  []           -> []
  [d, ...rest] -> match d {
    DType(_, s, _, body, _, _, _, _) ->
      if has_eq(s) or sym_in_core(ps_tab(ps), s) { type_uses(ps, has_eq, rest) }
      else { [body_use(ps, decl_type_home(d, ps_root(ps)), s, body), ...type_uses(ps, has_eq, rest)] }
    _ -> type_uses(ps, has_eq, rest)
  }
}

fn body_use(ps: PScope, from: Option[String], s: SymId, body: TypeBody) : TypeUse = match body {
  TBAlias(te)      -> te_use(ps, from, s, te, TypeUse(s, false, []))
  TBRecord(fs)     -> foldl(fs, TypeUse(s, false, []), (u, f) => match f { FD(_, _, te, _) -> te_use(ps, from, s, te, u) })
  TBSum(vs)        -> foldl(vs, TypeUse(s, false, []), (u, v) => match v {
                        Var(_, tes) -> foldl(tes, u, (w, te) => te_use(ps, from, s, te, w)) })
  TBEffectAlias(_) -> TypeUse(s, false, [])
}

fn te_use(ps: PScope, from: Option[String], s: SymId, te: TypeExpr, u: TypeUse) : TypeUse = match te.tkind {
  TyFn(_, _, _)     -> TypeUse(s, true, [])
  TyName(_, args)   -> foldl(args, with_ref(u, vdv_head(ps, te, from)), (w, a) => te_use(ps, from, s, a, w))
  TyList(inner)     -> te_use(ps, from, s, inner, u)
  TyDim(base, _)    -> te_use(ps, from, s, base, u)
  TyRefine(base, _) -> te_use(ps, from, s, base, u)
  TyParam(_, args)  -> foldl(args, u, (w, a) => te_use(ps, from, s, a, w))
  _                 -> u
}

fn with_ref(u: TypeUse, head: DeclRef) : TypeUse = match u {
  TypeUse(s, direct, refs) -> if ref_resolved(head) { TypeUse(s, direct, [ref_sym(head), ...refs]) } else { u }
}

# Grows the set of types holding a function until a round adds none.
fn bad_fixpoint(uses: [TypeUse], bad: NameIndex[SymId]) : NameIndex[SymId] = match bad_round(uses, bad, [], false) {
  BadRound(next, rest, changed) -> if changed { bad_fixpoint(rest, next) } else { next }
}

type BadRound = BadRound(NameIndex[SymId], [TypeUse], Bool)

fn bad_round(uses: [TypeUse], bad: NameIndex[SymId], kept: [TypeUse], changed: Bool) : BadRound = match uses {
  [] -> BadRound(bad, kept, changed)
  [u, ...rest] -> match u {
    TypeUse(s, direct, refs) ->
      if direct or any(refs, (r) => in_bad(bad, r)) { bad_round(rest, idx_prepend_sym(bad, s, s), kept, true) }
      else { bad_round(rest, bad, [u, ...kept], changed) }
  }
}

#[doc("True when values of `t` can be compared with `==` and satisfy an `Eq` bound.")]
pub(pkg) fn ty_is_eq(env: EqEnv, t: Ty) : Bool = match t {
  TyFnT(_, _, _)      -> false
  TyListT(inner)      -> ty_is_eq(env, inner)
  TyDimT(inner, _)    -> ty_is_eq(env, inner)
  TyRefineT(inner, _) -> ty_is_eq(env, inner)
  TyUnion(ts)         -> all(ts, (x) => ty_is_eq(env, x))
  TyCon(s, args)      -> not in_bad(env.bad, s) and all(args, (x) => ty_is_eq(env, x))
  _                   -> true
}

fn type_decl_is(d: Decl, s: SymId) : Bool = match d {
  DType(_, ds, _, _, _, _, _, _) -> sym_raw(ds) >= 0 and sym_raw(ds) == sym_raw(s)
  _                              -> false
}

#[doc("A comparison the program may not make: where it is, the operand type, and whether it is `==`/`!=` (else an ordering).")]
pub(pkg) type CmpSite = CS(Int, Int, Ty, Bool)

#[doc("The comparisons in `e` that compare a value with no `Eq`, or order a function or a record with no `Ord` impl.")]
pub(pkg) fn cmp_sites(env: EqEnv, e: Expr, acc: [CmpSite]) : [CmpSite] {
  let here = match e.kind {
    EBinop(op, l, _) -> match l.ty {
      Some(t) ->
        if binop_is_equality(op) and not ty_is_eq(env, t) { [CS(e.line, e.col, t, true), ...acc] }
        else { match (if binop_is_ordering(op) { unordered_part(env, t) } else { None }) {
          Some(u) -> [CS(e.line, e.col, u, false), ...acc]
          None    -> acc
        } }
      None -> acc
    }
    _ -> acc
  }
  cmp_sites_in(env, xp_positions(e), here)
}

fn cmp_sites_in(env: EqEnv, ps: [XPos], acc: [CmpSite]) : [CmpSite] = match ps {
  []             -> acc
  [XP(_, c), ...rest] -> cmp_sites_in(env, rest, cmp_sites(env, c, acc))
}

# The part of `t` that lacks the ordering it needs: a function, a record with no impl, or such a part of a container's element.
fn unordered_part(env: EqEnv, t: Ty) : Option[Ty] = match t {
  TyDimT(inner, _)    -> unordered_part(env, inner)
  TyRefineT(inner, _) -> unordered_part(env, inner)
  TyCon(s, _) -> if not env.has_ord(s) and is_record(env, s) { Some(t) } else { ord_blocker(env.has_ord, t) }
  _ -> ord_blocker(env.has_ord, t)
}

#[doc("The part of `t` that keeps an ordering of it from existing: a function, or an element of a container that orders by its elements whose type has no `Ord` impl.")]
pub(pkg) fn ord_blocker(has_ord: (SymId) -> Bool, t: Ty) : Option[Ty] = match t {
  TyFnT(_, _, _)      -> Some(t)
  TyDimT(inner, _)    -> ord_blocker(has_ord, inner)
  TyRefineT(inner, _) -> ord_blocker(has_ord, inner)
  TyListT(inner)      -> element_blocker(has_ord, inner)
  TyCon(s, args)      -> if orders_by_elements(has_ord, s) { first_some(args, (a) => element_blocker(has_ord, a)) } else { None }
  _                   -> None
}

fn element_blocker(has_ord: (SymId) -> Bool, t: Ty) : Option[Ty] = match t {
  TyCon(s, args) ->
    if orders_by_elements(has_ord, s) { first_some(args, (a) => element_blocker(has_ord, a)) }
    else if has_ord(s) { None }
    else { Some(t) }
  _ -> ord_blocker(has_ord, t)
}

fn orders_by_elements(has_ord: (SymId) -> Bool, s: SymId) : Bool =
  has_ord(s) and (core_ty_is(s, CtOption) or core_ty_is(s, CtResult)
    or any(["Pair", "Triple", "Quad"], (n) => sym_same(s, sym_derive(NCType, n, tuple_module_home()))))

fn first_some(xs: [Ty], f: (Ty) -> Option[Ty]) : Option[Ty] = match xs {
  [] -> None
  [x, ...rest] -> match f(x) { Some(u) -> Some(u)  None -> first_some(rest, f) }
}

fn is_record(env: EqEnv, s: SymId) : Bool = match find(env.types, (d) => type_decl_is(d, s)) {
  Some(DType(_, _, _, TBRecord(_), _, _, _, _)) -> true
  _ -> false
}
