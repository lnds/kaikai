#[doc("""
Incremental interface hashing across the per-module fold.

Each module in the fold hashes the interface it *inherits* — every export
of every module folded before it. Deriving that from the merged delta
costs a full canonicalise-sort-hash of the accumulation once per module,
which is quadratic in the module count: the dominant cost of the cut on
anything but a tiny package, and more than the inference it replaces.

So the accumulator folds the hash instead of rebuilding it. Each entry
contributes `string_hash(key ++ canonical chunk)` and the interface hash
is the wrapping sum of those contributions per table. Extending by one
module is then proportional to that module's own exports, not to the
accumulation.

Summing is what makes the fold possible, and it is also exactly the
contract `mdelta_canon_bytes` bought with its sort: interface identity
must not depend on the order entries were inserted in. A commutative
combine gets that by construction rather than by canonicalising first.
Multiplicity survives — two equal entries sum, they do not cancel as
they would under xor — so a duplicated export still moves the hash.
""")]

import compiler.util
import compiler.infer
import compiler.user_cache
import compiler.cache_delta

# Per-table running sums. Kept apart rather than summed into one number
# so an entry moving between tables still moves the hash.
#[doc("The 8 interface tables of an accumulated interface, each reduced to the running sum of its entry hashes.")]
pub type IfaceAcc = IFA(Int, Int, Int, Int, Int, Int, Int, Int)

#[doc("The accumulator for an empty inherited interface.")]
pub fn iface_acc_empty() : IfaceAcc = IFA(0, 0, 0, 0, 0, 0, 0, 0)

# A pair's contribution length-prefixes the key so no two different
# splits of the same characters hash alike.
fn kv_hash(p: KV) : Int = match p {
  KV(k, chunk) -> string_hash(concat_all([int_to_string(string_length(k)), ":",
                                          k, chunk]))
}

fn kv_sum(ps: [KV], acc: Int) : Int = match ps {
  [] -> acc
  [p, ...t] -> kv_sum(t, acc + kv_hash(p))
}

#[doc("Fold one module's exported delta into the accumulated interface, hashing only that module's own entries.")]
pub fn iface_acc_extend(a: IfaceAcc, d: ModuleEnvDelta) : IfaceAcc = match a {
  IFA(tys, uns, ars, recs, sums, ops, uas, ctors) ->
    IFA(kv_sum(tyentry_pairs(d.ty_entries, []), tys),
        kv_sum(unioninfo_pairs(d.unions, []), uns),
        kv_sum(opeffarity_pairs(d.op_eff_arities, []), ars),
        kv_sum(recinfo_pairs(d.recs, []), recs),
        kv_sum(suminfo_pairs(d.sums, []), sums),
        kv_sum(optoeff_pairs(d.op_to_eff, []), ops),
        kv_sum(ualias_pairs(d.unit_aliases, []), uas),
        kv_sum(ctorentry_pairs(d.constructors, []), ctors))
}

#[doc("Interface hash of an accumulated interface, as 16 hex chars: the value the per-module cut keys on.")]
pub fn iface_acc_hash(a: IfaceAcc) : String = match a {
  IFA(tys, uns, ars, recs, sums, ops, uas, ctors) ->
    uc_content_hex(concat_all([int_to_string(tys), ":", int_to_string(uns), ":",
                               int_to_string(ars), ":", int_to_string(recs), ":",
                               int_to_string(sums), ":", int_to_string(ops), ":",
                               int_to_string(uas), ":", int_to_string(ctors)]))
}
