#[doc("KIR to C printer: effects, handlers, continuations and TRMC.")]

import compiler.kir
import compiler.kir_c_core
import compiler.kir_c_fx_locals
import compiler.kir_c_fx_ops
import compiler.kir_c_fx_stmt
import compiler.kir_c_fx_trmc
import compiler.util

#[doc("The C declarations of the non-register locals `f` reserves: handle frames, continuation, `__evf`, `__self`, resume register, reuse accumulators and donor.")]
pub fn kc_fx_locals(cx: KcCx, f: KFn) : String = kcx_locals(cx, f)

#[doc("Whether a call inside `f` may pass `f`'s own evidence frame on: `f` has a frame and installs no handler.")]
pub fn kc_fx_passes_frame(cx: KcCx, f: KFn) : Bool = kc_fn_frame_slots(cx, f) > 0 and not kcx_installs_handler(f)

#[doc("The expression of a perform, resume, resume with state or setjmp op.")]
pub fn kc_op_fx_expr(cx: KcCx, op: KOp) : String = kcx_op(cx, op)

#[doc("The expression of an unwind, landing-pad, resume-frame or segment primitive.")]
pub fn kc_prim_fx_expr(cx: KcCx, p: PrimOp, args: [KVal]) : String = kcx_prim(cx, p, args)

#[doc("The statement text of an install, pop, state binding, cleanup arming or cleanup run.")]
pub fn kc_stmt_fx(cx: KcCx, s: KStmt) : String = kcx_stmt(cx, s)

#[doc("The statement text of an arm-top reuse capture, its release, or a flat arm take; empty for other RC ops.")]
pub fn kc_rc_fx(cx: KcCx, rc: KRCOp) : String = kcx_rc(cx, rc)

#[doc("The statement text of a modulo-cons step or the terminal leaf plug.")]
pub fn kc_term_fx(cx: KcCx, t: KTerm, ret: KSlot) : String = kcx_term(cx, t)

#[doc("The C signature of a clause or cleanup fn, without braces.")]
pub fn kc_clause_sig(cx: KcCx, f: KFn, sym: String) : String = kcx_clause_sig(f, sym)

#[doc("The statements that seed a clause or cleanup fn's registers from its params.")]
pub fn kc_clause_seed(cx: KcCx, f: KFn) : String = kcx_clause_seed(f)

#[doc("The forward declaration of a clause or cleanup fn.")]
pub fn kc_clause_proto(cx: KcCx, f: KFn, sym: String) : String = cat2(kcx_clause_sig(f, sym), ";\n")

#[doc("True when `_arm_ru` is a reserved register of `f`.")]
pub fn kc_fn_armru(f: KFn) : Bool = kc_fn_has_armru(f)
