# Re-runs the masking scan, so call it only where `Mutable` stayed on a row
# that does not declare it: the body-row check then reports this demand.
fn mutable_blame(st: InferState, params: [Param], body: Expr) : Option[MutBlame] =
  if not labels_contain_mutable(st.row) or labels_contain_mutable(st.decl_row) { None }
  else {
    let body_resolved = finalise_typed_expr(st.sub, body)
    let sc = mut_scan(st, params, body_resolved)
    match external_demand(body_resolved, sc) {
      None    -> None
      Some(d) -> Some(MB(d, demand_via(params, body_resolved, d, sc)))
    }
  }


fn resolve_callsite_tys(ids: [Int], sub: Subst) : [Ty] {
  match ids {
    [] -> []
    [i, ...rest] -> [apply_ty(sub, TyVarT(i)), ...resolve_callsite_tys(rest, sub)]
  }
}


fn resolve_callsite_units(ids: [Int], sub: Subst) : [UnitExprT] {
  match ids {
    [] -> []
    [i, ...rest] -> [apply_unit(sub, UVar(i)), ...resolve_callsite_units(rest, sub)]
  }
}


fn resolve_callsites(css: [CallSite], sub: Subst, mo: Option[String]) : [ResolvedCS] {
  match css {
    [] -> []
    [cs, ...rest] -> match cs {
      # The mo parameter overrides the mo carried on the CS itself.
      # `infer_decl` walks all CS produced inside one DFn body, so
      # tagging them with the enclosing DFn's `module_origin` is
      # correct and avoids threading home_mod through every
      # InferState constructor (28 of them).
      CS(s, line, col, ids, uids, _) ->
        [RCS(s, line, col, resolve_callsite_tys(ids, sub),
             resolve_callsite_units(uids, sub), mo), ...resolve_callsites(rest, sub, mo)]
    }
  }
}


# Build the [ResolvedRowHole] for one decl. For each row hole the
# decl binds, look up its
# allocated id in `rbinds`, resolve `Row { tail: Some(id) }` under the
# final substitution, and emit one entry. Non-hole row variables (the
# user-written tail `e` in `... / Io + e`) are skipped — they are not
# typed-hole resolutions and belong to a different reporter.
fn extract_row_holes(d: Decl, rbinds: [RVBind], sub: Subst, body_row: [Label]) : [ResolvedRowHole] {
  match d {
    DFn(_, fid, tps, _, _, _, _, _, _, _) -> {
      let body_labels = map(apply_labels(sub, body_row), (l) => l.sym)
      extract_row_holes_loop(filter(tps, tb_is_hole), fnid_sym(fid), rbinds, sub, body_labels, [])
    }
    _ -> []
  }
}


fn extract_row_holes_loop(holes: [TBinder], fn_name: SymId,
                           rbinds: [RVBind], sub: Subst,
                           body_labels: [SymId],
                           acc: [ResolvedRowHole]) : [ResolvedRowHole] {
  match holes {
    [] -> list_reverse(acc)
    [b, ...rest] -> match b.kind {
      KRowHole(hl, hc) -> match inf_rvbind_lookup(rbinds, b.id) {
        None -> extract_row_holes_loop(rest, fn_name, rbinds, sub, body_labels, acc)
        Some(id) -> {
          let r = apply_row(sub, Row { labels: [], tail: Some(id),
                                         display_alias: None })
          let nm = if tb_text(b) == "" { None } else { Some(tb_text(b)) }
          let entry = RRH(nm, hl, hc, fn_name, r, body_labels)
          extract_row_holes_loop(rest, fn_name, rbinds, sub, body_labels, [entry, ...acc])
        }
      }
      _ -> extract_row_holes_loop(rest, fn_name, rbinds, sub, body_labels, acc)
    }
  }
}


fn resolve_holes(hs: [HoleSite], sub: Subst, owner: HoleOwner, base: HoleRow) : [ResolvedHole] {
  match hs {
    [] -> []
    [h, ...rest] -> match h {
      HS(kind, line, col, fresh, scope, env_fresh, handled) ->
        [RH(kind, line, col, apply_ty(sub, TyVarT(fresh)), scope, env_fresh, owner,
            hole_row_handling(base, apply_labels(sub, handled))),
         ...resolve_holes(rest, sub, owner, base)]
    }
  }
}


# The entry point without a row absorbs the default-handled effects, as
# `check_body_row` does.
fn fn_hole_row(st: InferState, entry: Bool, row: RowExpr) : HoleRow = match row {
  REmpty       -> HRowLabels([], [], entry)
  RClosed(lbs) -> HRowLabels(apply_labels(st.sub, st_annot_labels(st, lbs)), [], false)
  ROpen(_, _)  -> HRowOpen
}


type FnSite = {
  is_pub: Bool,
  fid: FnId,
  entry: Bool,
  tparams: [TBinder],
  tps: [TBinder],
  tpbinds: [TPBind],
  rbinds: [RVBind],
  ps: [Param],
  opt_ret: Option[TypeExpr],
  row: RowExpr,
  line: Int,
  col: Int
}

type FnBody = { rb: Inferred, st: InferState, declared_ret: Ty, ret_site: Expr }

type FnRows = { st: InferState, picks: [HomPick] }

fn infer_decl(file: String, env: TyEnv, core_len: Int, recs: [RecInfo],
              op_eff_arities: [OpEffArity],
              type_aliases: [AliasResult], op_to_eff: [OpToEff],
              sums: [SumInfo], hcar: HandleTab,
              protos: ProtoView,
              all_decls: [Decl],
              kind_theories: [KindTheory],
              d: Decl, verbose: Bool) : TypedDecl / Console + File + Mutable =
  match d {
    DFn(is_pub, fid, tparams, ps, opt_ret, row, body0, line, col, mo) -> {
      let nm = written_text(decl_name(env.tab, fnid_sym(fid)))
      let rbinds = mk_rvbinds(list_append(collect_decl_rvars(d),
                                          collect_rowkind_args_decl(d, env.row_kind, env_home_view(env, mo))))
      let tps = tbs_positional(tparams)
      let tpbinds = mk_tpbinds(tps)
      let entry = decl_types_as_entry(env.ty_homes, fid)
      let site = FnSite {
        is_pub: is_pub, fid: fid, entry: entry, tparams: tparams, tps: tps, tpbinds: tpbinds,
        rbinds: rbinds, ps: ps, opt_ret: opt_ret, row: row, line: line, col: col
      }
      let body = name_unit_tparams(body0, tparams)
      let st_init = fn_initial_state(file, env, core_len, recs, op_eff_arities, type_aliases, op_to_eff,
                                     kind_theories, protos, sums, site, nm, mo)
      let added = add_infer_params_with_binds(st_init, ps, tpbinds, rbinds)
      let opt_declared = match opt_ret {
        Some(rty) -> Some(resolve_ty_with_binds(rty, tpbinds, rbinds, env.row_kind, env_home_view(env, mo)))
        None -> None
      }
      let st_ready = InferState { ...st_set_refine_ctx(st_set_ret_ty(added.st, opt_declared), nm),
                                  decl_row: declared_row_labels(added.st, row) }
      let fb = check_fn_body(st_ready, nm, body, opt_declared)
      let rows = check_fn_rows(file, env, sums, hcar, all_decls, site, nm, mo, fb, added.tys)
      finalise_fn_decl(env, d, site, nm, mo, fb, rows, added.tys, verbose)
    }
    DTest(_, body, line, col, _) ->
      infer_test_body(file, env, core_len, recs, op_eff_arities, type_aliases, op_to_eff, sums, protos,
                      all_decls, kind_theories, [], body, d, line, col)
    DBench(_, body, line, col, _) ->
      infer_test_body(file, env, core_len, recs, op_eff_arities, type_aliases, op_to_eff, sums, protos,
                      all_decls, kind_theories, [], body, d, line, col)
    DCheck(_, ps, body, line, col, _) ->
      infer_test_body(file, env, core_len, recs, op_eff_arities, type_aliases, op_to_eff, sums, protos,
                      all_decls, kind_theories, ps, body, d, line, col)
    DConst(is_pub, csym, cte, cbody, mo, line, col) ->
      infer_const_body(file, env, core_len, recs, op_eff_arities, type_aliases, op_to_eff, sums, hcar,
                       protos, kind_theories, is_pub, csym, cte, cbody, mo, line, col)
    DProtoLaws(_, inner, _, _, _) ->
      infer_decl(file, env, core_len, recs, op_eff_arities, type_aliases, op_to_eff, sums, hcar, protos,
                 all_decls, kind_theories, inner, verbose)
    DImplAxiom(_, inner, _, _, _) ->
      infer_decl(file, env, core_len, recs, op_eff_arities, type_aliases, op_to_eff, sums, hcar, protos,
                 all_decls, kind_theories, inner, verbose)
    DConstructor(inner, _, _) ->
      infer_decl(file, env, core_len, recs, op_eff_arities, type_aliases, op_to_eff, sums, hcar, protos,
                 all_decls, kind_theories, inner, verbose)
    _ -> TypedDecl { decl: d, errs: 0, insts: [], holes: [], row_holes: [], diags: [], op_res: [] }
  }

# Inside its own body a unit parameter is the symbol it is named.
fn name_unit_tparams(body: Expr, tparams: [TBinder]) : Expr =
  match filter(tparams, tb_is_unit) {
    [] -> body
    us -> map_units_expr(body, (u) => unit_named(u, us))
  }

# The typer state a fn body is walked under. Every counter advances past the
# ids the registered scheme already quantifies over (row binds, the phantom
# row of an empty signature, tparams, unit tparams), so a fresh variable
# minted in the body never aliases a bound one.
fn fn_initial_state(file: String, env: TyEnv, core_len: Int, recs: [RecInfo], op_eff_arities: [OpEffArity],
                    type_aliases: [AliasResult], op_to_eff: [OpToEff], kind_theories: [KindTheory],
                    protos: ProtoView, sums: [SumInfo], site: FnSite, nm: String,
                    mo: Option[String]) : InferState / Mutable {
  let st_init0 = infer_state_new_full_aliases(file, env, core_len, recs,
                                              op_eff_arities, type_aliases, op_to_eff,
                                              kind_theories)
  let st_init = st_set_sums(st_set_protos(st_set_home(st_set_walker(st_init0, walker()), mo), protos), sums)
  let phantom_extra = if elaborate_phantom_row(site.row, site.entry) { 1 } else { 0 }
  let st0 = advance_row_fresh(InferState { ...st_init, sig_rows: site.rbinds, sig_tps: site.tps },
                              list_length(site.rbinds) + phantom_extra)
  let st0a = st_set_env(st0, advance_fresh(st0.env, list_length(site.tpbinds)))
  let st0b = reserve_unit_tparams(st0a, site.tps)
  let sub_r = subst_with_rigid(st0b.sub, rigid_tparams(site.tpbinds, nm))
  st_set_sub(st0b, subst_with_rigid_rows(sub_r, map(site.rbinds, (rb) => match rb { RVB(_, id) -> id })))
}

# Reserves the unit-kind tparam ids and constrains them to their declared kinds.
fn reserve_unit_tparams(st: InferState, tps: [TBinder]) : InferState {
  let n = tparam_unit_count(tps)
  if n > 0 {
    let st1 = advance_unit_fresh(st, n)
    st_set_sub(st1, subst_add_unit_kinds(st1.sub, range_ids(0, n), tparam_unit_kinds(tps)))
  } else { st }
}

# With a declared return type the body is checked against it, so the expected
# type reaches every match arm; without one the body's own type is the return.
fn check_fn_body(st_ready: InferState, nm: String, body: Expr, opt_declared: Option[Ty]) : FnBody / Console + File + Mutable {
  let what = string_concat("return type of ", nm)
  let ret_site = return_site_of(body)
  let rb0 = match opt_declared {
    Some(rty) -> check_body_against_ret(st_ready, body, rty, what, ret_site.line, ret_site.col)
    None -> synth(st_ready, body)
  }
  let rb = match opt_declared {
    Some(rty) ->
      if not (rc_mentions(rty) or rc_mentions_in(rb0.st.sub, rb0.ty)) { rb0 }
      else { refine_coerce_tail(rb0, rty, concat_all(["return of `", nm, "`"])) }
    None -> rb0
  }
  let declared_ret = match opt_declared {
    Some(rty) -> rty
    None -> rb.ty
  }
  let st1 = match opt_declared {
    Some(rty) -> st_unify(rb.st, rty, rb.ty, what, ret_site.line, ret_site.col)
    None -> rb.st
  }
  let st1h = if st1.errs > st_ready.errs and tail_is_section(body) { st_hint_section_tail(st1, ret_site) } else { st1 }
  FnBody { rb: rb, st: st1h, declared_ret: declared_ret, ret_site: ret_site }
}

# The post-body checks, then the drains of what the walk had to postpone: a
# deferred field is resolved once the declared row has pinned its receiver's
# type, and a deferred bare call once its argument type settled.
fn check_fn_rows(file: String, env: TyEnv, sums: [SumInfo], hcar: HandleTab, all_decls: [Decl],
                 site: FnSite, nm: String, mo: Option[String], fb: FnBody, added_tys: [Ty]) : FnRows / Console + File + Mutable {
  let st1 = fb.st
  let body = fb.rb.expr
  let ret_now = apply_ty(st1.sub, fb.declared_ret)
  let st1e = check_entry_result(st1, site.entry, ret_now, fb.ret_site.line, fb.ret_site.col)
  let st1b = check_no_fiber_escape(st1e, file, fnid_sym(site.fid), nm, site.opt_ret, ret_now,
                                   sums, hcar, site.line, site.col)
  let st1c = check_cont_crossings(st_drop_provided_caps(mask_local_mutable_demand(st1b, site.ps, body), site.ps), body, hcar)
  let st2pre = check_body_row(st1c, nm, site.entry, site.fid, site.row, site.rbinds, site.tparams,
                              site.line, site.col, all_decls, mutable_blame(st1c, site.ps, body))
  let st2f = drain_deferred_fields(st2pre, list_reverse(st2pre.deferred_fields),
                                   decl_row_concrete_labels(site.row, env_home_view(env, mo)))
  let hd = drain_deferred_homs(st2f, list_reverse(st2f.deferred_homs), [])
  FnRows { st: report_stranded_ops(hd.st, st2f.deferred_homs, [fb.declared_ret, ...added_tys]), picks: hd.picks }
}

# The final substitution is applied to every `Expr.ty` of the body, then the
# body's and the call sites' ids are canonicalised back to the impl's bound
# ids: the unifier may have redirected a bound var through fresh ones.
fn finalise_fn_decl(env: TyEnv, d: Decl, site: FnSite, nm: String, mo: Option[String], fb: FnBody, rows: FnRows,
                    added_tys: [Ty], verbose: Bool) : TypedDecl / Console + File + Mutable {
  let st2 = rows.st
  let _ = if verbose {
    print_inferred_fn(env.tab, nm, apply_ty(st2.sub, fb.declared_ret), apply_tys(st2.sub, added_tys), site.line, site.col)
    print_row_ids(env.tab, nm, st2.row)
    print_sig_ids(env.tab, nm, row_expr_labels(site.row))
  } else { () }
  let resolved0 = resolve_callsites(list_reverse(st2.insts), st2.sub, mo)
  let hole_reports = resolve_holes(list_reverse(st2.holes), st2.sub,
                                   HOwner(fnid_sym(site.fid), map(site.ps, (p) => p.binder.id)),
                                   fn_hole_row(st2, site.entry, site.row))
  let final_body0 = hom_retarget(finalise_typed_expr(st2.sub, fb.rb.expr), rows.picks)
  let split_for_canon = tparam_id_split(site.tps)
  let canon_uvars = build_uvar_canon_map(split_for_canon.uvars, st2.sub, [])
  let canon_tvars = build_tvar_canon_map(split_for_canon.tvars, st2.sub, [])
  let canonical = list_length(canon_uvars) > 0 or list_length(canon_tvars) > 0
  let final_body = if canonical { canon_uvars_expr(canon_tvars_expr(final_body0, canon_tvars), canon_uvars) } else { final_body0 }
  let resolved = if canonical { canon_resolved_css(resolved0, canon_tvars, canon_uvars) } else { resolved0 }
  let row_holes = extract_row_holes(d, site.rbinds, st2.sub, st2.row)
  let stamp = (te: TypeExpr) => resolve_ty_with_binds(te, site.tpbinds, site.rbinds, env.row_kind, env_home_view(env, mo))
  TypedDecl {
    decl: DFn(site.is_pub, site.fid, site.tparams, stamp_params(site.ps, stamp), stamp_opt(site.opt_ret, stamp),
              stamp_row_with(main_inferred_row(site, final_body, st2), stamp),
              final_body, site.line, site.col, mo),
    errs: st2.errs,
    insts: resolved,
    holes: hole_reports,
    row_holes: row_holes,
    diags: finalize_diags(st2.diags),
    op_res: stamp_op_res_fn(list_reverse(st2.op_res), site.fid)
  }
}

# A `main` without a declared row takes the row its body performs, directly
# and through the helpers it calls, so the wrapper installs the default
# handlers for every builtin the body uses. Other fns keep their row.
fn main_inferred_row(site: FnSite, final_body: Expr, st2: InferState) : RowExpr =
  match site.row {
    REmpty -> if site.entry { inferred_main_row(collect_call_labels(final_body, st2.row)) } else { site.row }
    _ -> site.row
  }


fn infer_test_body(file: String, env: TyEnv, core_len: Int,
                   recs: [RecInfo], op_eff_arities: [OpEffArity],
                   type_aliases: [AliasResult], op_to_eff: [OpToEff],
                   sums: [SumInfo], protos: ProtoView,
                   all_decls: [Decl], kind_theories: [KindTheory],
                   ps: [Param], body: Expr,
                   d: Decl, line: Int, col: Int) : TypedDecl / Console + File + Mutable {
  let st_init0 = infer_state_new_full_aliases(file, env, core_len, recs,
                                                op_eff_arities, type_aliases, op_to_eff,
                                                kind_theories)
  let st_init1 = st_set_protos(st_set_home(st_set_walker(st_init0, walker()), decl_home_module(d)), protos)
  let st_init = st_set_sums(st_init1, sums)
  let added = add_infer_params_with_binds(st_set_refine_ctx(st_init, test_decl_desc(d)), ps, [], [])
  let rb = synth(added.st, body)
  # A test/bench/check body has no declared row; absorb exactly what
  # the program entry may carry: the default-handled effects `main`'s
  # REmpty row absorbs, plus the compiler-synthesised `Ffi` capability
  # `main` may opt into by declaring it. A test block has no surface
  # to declare a row on, so the opt-in set is granted outright; the
  # audit point for FFI stays on the wrappers' public `/ Ffi` rows.
  let st2pre = check_body_row_label_loop(rb.st, RowInBlock(test_block_kind(d)),
    test_non_absorbed_labels(rb.st, rb.st.row, all_decls),
    [], [], line, col, None)
  let hd = drain_deferred_homs(st2pre, list_reverse(st2pre.deferred_homs), [])
  let st2 = report_stranded_ops(hd.st, st2pre.deferred_homs, [])
  let resolved = resolve_callsites(list_reverse(st2.insts), st2.sub, None)
  let hole_reports = resolve_holes(list_reverse(st2.holes), st2.sub, HNoOwner, HRowLabels([], [], true))
  let final_body = hom_retarget(finalise_typed_expr(st2.sub, rb.expr), hd.picks)
  TypedDecl {
    decl: test_decl_with_body(d, final_body),
    errs: st2.errs,
    insts: resolved,
    holes: hole_reports,
    row_holes: [],
    diags: finalize_diags(st2.diags),
    # A block runs under its build's runner.
    op_res: stamp_op_res_fn(list_reverse(st2.op_res), fnid_decl(entry_id(tsh_target(env.ty_homes), true)))
  }
}


# Type-check a `const NAME : T = init` initialiser against its
# annotation. Mirrors the annotated-`SLet` path: a textual numeric
# literal coins against the resolved annotation first, then the
# synthesised type is unified with the declared one so a mismatch is an
# error rather than a value reaching codegen at a type it does not have.
# The body is returned typed — emit and KIR inline it.
fn infer_const_body(file: String, env: TyEnv, core_len: Int,
                    recs: [RecInfo], op_eff_arities: [OpEffArity],
                    type_aliases: [AliasResult], op_to_eff: [OpToEff],
                    sums: [SumInfo], hcar: HandleTab, protos: ProtoView,
                    kind_theories: [KindTheory],
                    is_pub: Bool, csym: SymId, cte: TypeExpr, cbody: Expr,
                    mo: Option[String], line: Int,
                    col: Int) : TypedDecl / Console + File + Mutable {
  let cname = written_text(decl_name(env.tab, csym))
  let st_init0 = infer_state_new_full_aliases(file, env, core_len, recs,
                                                op_eff_arities, type_aliases, op_to_eff,
                                                kind_theories)
  let st_init1 = st_set_protos(st_set_home(st_set_walker(st_init0, walker()), mo), protos)
  let st_init = st_set_sums(st_init1, sums)
  let shared = ty_holds(core_decl_ty_id(CdSeq), st_annot_ty(st_init, cte), hcar)
  let rr = synth_let_rhs_or_mint(st_init, if shared { seq_once_call(cbody) } else { cbody }, cte, line, col)
  let minted = maybe_mint_literal(rr.st, rr.expr, rr.ty,
                                  apply_ty(rr.st.sub, st_annot_ty(rr.st, cte)),
                                  line, col)
  let declared = st_annot_ty(minted.st, cte)
  let coerced = if not (rc_mentions(declared) or rc_mentions_in(minted.st.sub, minted.pair.ty)) { minted }
                else { refine_coerce(minted, declared, concat_all(["const `", cname, "`"]), cbody.line, cbody.col) }
  let st2c0 = st_unify(coerced.st, declared, coerced.pair.ty, "const annotation", line, col)
  let st2c = const_init_must_be_pure(st2c0, cname, line, col)
  let hd = drain_deferred_homs(st2c, list_reverse(st2c.deferred_homs), [])
  let st2 = report_stranded_ops(hd.st, st2c.deferred_homs, [])
  let resolved = resolve_callsites(list_reverse(st2.insts), st2.sub, None)
  let final_body = hom_retarget(finalise_typed_expr(st2.sub, coerced.pair.expr), hd.picks)
  TypedDecl {
    decl: DConst(is_pub, csym, cte, final_body, mo, line, col),
    errs: st2.errs,
    insts: resolved,
    holes: resolve_holes(list_reverse(st2.holes), st2.sub, HNoOwner, HRowLabels([], [], false)),
    row_holes: [],
    diags: finalize_diags(st2.diags),
    op_res: stamp_op_res_fn(list_reverse(st2.op_res), fnid_decl(csym))
  }
}


# A `const` initialiser runs once at load, outside any handler, so it
# performs no effect.
fn const_init_must_be_pure(st: InferState, cname: String, line: Int, col: Int) : InferState / Console + File + Mutable =
  foldl(st.row, st, (acc, lab) => {
    match lookup_eff_use(acc.eff_uses, lab) {
      EU(_, uline, ucol) -> {
        let l = if uline >= 0 { uline } else { line }
        let c = if ucol >= 0 { ucol } else { col }
        let lab_str = label_diag_display(acc, apply_label_args(acc.sub, lab))
        let header = "const `#{cname}` initialiser performs effect `#{lab_str}`"
        let help = "use a `fn`, or compute the value in `main`"
        st_bump_err(st_push_diag(acc, mk_diag(SevError, acc.file, l, c, header, [ri_help(acc.file, l, c, help)])))
      }
    }
  })


# A continuation stays on the fiber whose segment it suspended, inside the
# handlers of what its body performs; a lazy sequence on the fiber that made it.
fn check_cont_crossings(st: InferState, body: Expr, ht: HandleTab) : InferState / Console + File =
  foldl(cont_crossings(body, st.env.tab, (t) => apply_ty(st.sub, t), (t) => fiber_bound(t, (h, x) => ty_holds(h, x, ht)),
                       (t, es) => ty_cont_needs(t, es, ht)), st,
        (acc, c) => match c {
          Crossing(msg, help, l, col) -> {
            st_bump_err(st_push_diag(acc, mk_diag(SevError, acc.file, l, col, msg, [ri_help(acc.file, l, col, help)])))
          }
        })


# Every effect the body performs, including the labels and tail of each
# row variable it performs, must appear in the declared row. Row
# variables resolve only once the body is typed, so they are checked here.
fn check_body_row(st: InferState, fname: String, entry: Bool, f: FnId, declared: RowExpr, rbinds: [RVBind],
                  tps: [TBinder], line: Int, col: Int, decls: [Decl], mb: Option[MutBlame]) : InferState / Console + File + Mutable =
  if declares_row_hole(declared, tps) { st }
  else {
    let st1 = check_body_labels(st_add_tail_labels(st, st.row_tails), fname, entry, f, declared, line, col, decls, mb)
    match rbinds {
      [] -> st1
      _  -> check_body_tails(st1, fname, declared_root(st.sub, declared, rbinds), rbinds, tps, st.row_tails)
    }
  }


fn check_body_labels(st: InferState, fname: String, entry: Bool, f: FnId, declared: RowExpr,
                     line: Int, col: Int, decls: [Decl], mb: Option[MutBlame]) : InferState / Console + File + Mutable {
  # An open declared row's tail is the caller's variable and absorbs nothing
  # the body performs.
  match declared {
    REmpty ->
      # `main` without a row absorbs only the effects that have a default
      # handler (a builtin or a source-level `default` block); `Ffi` has none,
      # so a direct FFI call must declare `/ Ffi`.
      if entry {
        check_body_row_label_loop(st, RowInFn(fname),
                                  only_non_absorbed_labels(st, st.row, decls),
                                  [], [], line, col, mb)
      }
      else if list_is_empty(st.row) { st }
      else { check_body_row_label_loop(st, RowInFn(fname), st.row, [], unrowed_notes(st, f), line, col, mb) }
    RClosed(lbs) -> {
      # for `main`, every declared row label must also
      # have an `emit_main_wrapper` default handler. `main : Int / Net`
      # for a user-defined `Net` previously accepted, then segfaulted
      # at runtime because no handler was installed before `kai_main()`.
      # The body-vs-declared subset check is still the primary check;
      # this added pass surfaces the unhandled top-level row.
      let st1 = check_body_row_label_loop(st, RowInFn(fname), st.row,
                                            st_annot_labels(st, lbs),
                                            [], line, col, mb)
      if entry {
        let declared = st_annot_labels(st, lbs)
        check_main_row_handlable(st1, filter(st.row, (l) => any(declared, (d) => label_same(d, l))), line, col, decls)
      } else { st1 }
    }
    ROpen(_, lbs) -> check_body_row_label_loop(st, RowInFn(fname), st.row, st_annot_labels(st, lbs), [], line, col, mb)
  }
}


# Each performed label must match a declared label by effect and by
# unifiable ty_args (the match extends the substitution). A miss reports
# "effect not handled" with the label rendered in full and the notes of
# `extra`.
fn check_body_row_label_loop(st: InferState, sc: RowScope, performed: [Label],
                             declared: [Label], extra: [String], fline: Int, fcol: Int,
                             mb: Option[MutBlame]) : InferState / Console + File + Mutable =
  match performed {
    [] -> st
    [lab, ...rest] -> {
      let st1 = match find_matching_declared(declared, lab, st) {
        Some(s_after) -> s_after
        None -> report_unhandled_label(st, sc, lab, declared, extra, fline, fcol, mb)
      }
      check_body_row_label_loop(st1, sc, rest, declared, extra, fline, fcol, mb)
    }
  }

fn report_unhandled_label(st: InferState, sc: RowScope, lab: Label, declared: [Label], extra: [String],
                          fline: Int, fcol: Int, mb: Option[MutBlame]) : InferState / Console + File + Mutable {
  let blame = if effect_is(lab.sym, CeMutable) { mb } else { None }
  match blamed_use(st.eff_uses, lab, blame) {
    EU(_, uline, ucol) -> {
      let line = if uline >= 0 { uline } else { fline }
      let col = if ucol >= 0 { ucol } else { fcol }
      let applied = apply_label_args(st.sub, lab)
      let lab_str = label_diag_display(st, applied)
      let header = string_concat("effect not handled: ", lab_str)
      let n1 = scope_row_note(sc, lab_str)
      let n2 = "missing effect: `#{lab_str}`"
      let n3 = scope_row_line(sc, st.env.tab, declared)
      let helps = [scope_row_help(sc, lab_str, any(applied.ty_args, (t) => ty_is_free_var(st.sub, t)))]
      let vias = blame_via_notes(blame)
      let related = list_append([
        ri_note(st.file, line, col, n1),
        ri_note(st.file, line, col, n2),
        ...map(n3, (n) => ri_note(st.file, line, col, n)),
        ...map(vias, (v) => match v { SN(vl, vc, m) -> ri_note(st.file, vl, vc, m) }),
        ...map(extra, (n) => ri_note(st.file, line, col, n))
      ], map(helps, (h) => ri_help(st.file, line, col, h)))
      st_bump_err(st_push_diag(st, mk_diag(SevError, st.file, line, col, header, related)))
    }
  }
}


fn declared_row_labels(st: InferState, row: RowExpr) : [Label] = match row {
  REmpty        -> []
  RClosed(lbs)  -> st_annot_labels(st, lbs)
  ROpen(_, lbs) -> st_annot_labels(st, lbs)
}


fn declared_label_for(declared: [Label], target: Label, sub: Subst) : Option[Label] = match declared {
  [] -> None
  [d, ...rest] ->
    if label_same(d, target) and labels_args_unify(d.ty_args, target.ty_args, sub) { Some(d) }
    else { declared_label_for(rest, target, sub) }
}


#[doc("infer: the labels of `performed` a hole's context neither declares, handles, nor absorbs — the row a candidate performing them needs added.")]
pub fn hole_row_missing(hr: HoleRow, performed: [Label], decls: [Decl]) : [Label] = match hr {
  HRowOpen -> []
  HRowLabels(declared, handled, absorbs) ->
    filter(performed, (lab) => not hole_row_covers(declared, handled, absorbs, lab, decls))
}


fn hole_row_covers(declared: [Label], handled: [Label], absorbs: Bool, lab: Label, decls: [Decl]) : Bool =
  is_some(declared_label_for(declared, lab, subst_empty()))
    or any(handled, (h) => label_same(h, lab) and label_args_dischargeable(lab.ty_args, h.ty_args, subst_empty()))
    or (absorbs and label_absorbed(lab, decls))


#[doc("Typer-internal helper `infer_all_loop` shared across the infer modules.")]
pub fn infer_all_loop(df: DiagFiles, env: TyEnv, core_len: Int, recs: [RecInfo],
                   op_eff_arities: [OpEffArity],
                   ds: [Decl], verbose: Bool,
                   acc_decls: [Decl], acc_errs: Int, acc_insts: [ResolvedCS],
                   acc_holes: [ResolvedHole],
                   acc_row_holes: [ResolvedRowHole],
                   acc_diags: [Diagnostic],
                   acc_op_res: [OpResolution],
                   type_aliases: [AliasResult],
                   op_to_eff: [OpToEff],
                   sums: [SumInfo], hcar: HandleTab,
                   protos: ProtoView,
                   all_decls: [Decl],
                   kind_theories: [KindTheory]) : TypedProgram / Console + File + Mutable {


  match ds {
    [] -> TypedProgram {
      decls: list_reverse(acc_decls), errs: acc_errs,
      insts: list_reverse(acc_insts), holes: list_reverse(acc_holes),
      row_holes: list_reverse(acc_row_holes),
      core_len: core_len,
      toplevel_len: 0,
      module_doc: None,
      diags: list_reverse(acc_diags),
      op_res: list_reverse(acc_op_res)
    }
    [d, ...rest] -> {
      # A decl's diagnostics name the file that declares it, not the
      # root: the flattened stream mixes every imported module's decls
      # and each one's line/column belongs to its own source.
      let r = infer_decl(decl_diag_file(d, df), env, core_len, recs, op_eff_arities,
                          type_aliases, op_to_eff, sums, hcar, protos,
                          # pass program-level decls so
                          # check_body_row / check_main_row_handlable can
                          # consult source-level `default { }` blocks
                          # when deciding row absorption at `main`.
                          all_decls,
                          kind_theories,
                          d, verbose)
      infer_all_loop(df, env, core_len, recs, op_eff_arities, rest, verbose,
                     [r.decl, ...acc_decls],
                     acc_errs + r.errs,
                     llvm_prepend_reverse(r.insts, acc_insts),
                     prepend_reverse_holes(r.holes, acc_holes),
                     prepend_reverse_row_holes(r.row_holes, acc_row_holes),
                     prepend_reverse_diags(r.diags, acc_diags),
                     prepend_reverse_op_res(r.op_res, acc_op_res),
                     type_aliases, op_to_eff, sums, hcar, protos,
                     all_decls, kind_theories)
    }
  }
}


# Working tables for one module, seeded from the inherited
# `ModuleEnvDelta` and the program-wide `TcShared`. Cons-front, so this
# module's bindings shadow the inherited ones: `recs`, `sums`,
# `op_to_eff` and `unions` are `this_module ++ inherited`, the env
# entries come from `build_ty_env_inherited`.
#[doc("Typer-internal helper `collect_program_data_inherited` shared across the infer modules.")]
pub fn collect_program_data_inherited(file: String, decls: [Decl],
                                    inherited: ModuleEnvDelta,
                                    sh: TcShared, tab: SymTab)
                                    : ProgramData {
  # expand `unit Newton = kg * m / sec^2` aliases at the AST
  # level before any pass that calls inf_resolve_ty. After this pass no
  # USym in any TyDim or ELitUnit refers to an alias name.
  let aliases_here = collect_unit_alias_table(decls)
  # when this module references a unit alias declared
  # by an upstream module, the inherited table participates in
  # expansion. Cons-front so local aliases shadow inherited ones.
  let aliases_all = unit_alias_compose(aliases_here, inherited.unit_aliases)
  let decls_a = expand_unit_aliases_decls(decls, aliases_all)
  let hview = tsh_view(sh.homes, None)
  let unions_all = ut_add(sh.unions, collect_union_rows(decls_a, tab, hview))
  let built = build_ty_env_inherited(sh.seed, sh.inh, inherited, decls_a,
                                       unions_all, sh.rk_table, tab,
                                       sh.homes)
  let recs_here = typer_records(decls_a, tab)
  let recs_all = list_append(recs_here, inherited.recs)
  let op_to_eff_here = inf_collect_op_to_eff(decls_a)
  let op_to_eff_all = list_append(op_to_eff_here, inherited.op_to_eff)
  # sum-type registry for the region-brand walker.
  let sums_here = collect_sums(decls_a)
  let sums_all = list_append(sums_here, inherited.sums)
  ProgramData {
    decls_a: decls_a, built: built, recs: recs_all,
    alias_res: sh.alias_res, op_to_eff: op_to_eff_all, sums: sums_all,
    homes: sh.homes
  }
}


# Reject entries whose return type after stripping TyFnT is a bare
# bound variable or `Nothing` — either fits any hole, so suggesting it is
# noise. Accept structural return types (TyCon, TyList, primitives),
# which still constrain the substitution meaningfully.
#[doc("Typer-internal helper `synth_return_structural` shared across the infer modules.")]
pub fn synth_return_structural(sc: TyScheme) : Bool {
  match sc {
    Scheme(vars, _, _, _, ty) -> match ty {
      TyFnT(_, ret, _) -> match ret {
        TyVarT(v) -> not list_has_int(vars, v)
        TyAny     -> false
        _         -> true
      }
      TyVarT(v) -> not list_has_int(vars, v)
      TyAny     -> false
      _         -> true
    }
  }
}


#[doc("Typer-internal helper `list_has_string` shared across the infer modules.")]
pub fn list_has_string(xs: [String], s: String) : Bool {
  match xs {
    [] -> false
    [h, ...rest] -> if h == s { true } else { list_has_string(rest, s) }
  }
}

