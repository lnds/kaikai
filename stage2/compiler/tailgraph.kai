#[doc("""
Tail-call graph over a program's `[Decl]`, and its mutually recursive
groups.

The self-tail rewrite keys on a function's own name, so it sees a cycle
of length one and nothing longer. This pass supplies the missing shape:
an edge `f -> g` for every call to `g` sitting in TAIL position in `f`'s
body, and the strongly connected components of that graph. A component
of two or more members is a mutual tail recursion — the
`is_even`/`is_odd` shape — which the fusion rewrite turns into a single
self-recursive function the existing goto-loop already optimises.

Tail position is `tail_pos`'s, read through `tail_norm`: the one definition the self-tail gate
and the fusion rewrite share.

A call finds its node by the declaration's id, so two same-named
functions are two targets and a local binder is none.

The pass is a PURE analysis producing a side table (the `purity.kai`
pattern): it does not mutate the AST.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.infer_index
import compiler.import_cycles
import compiler.tail_norm
import compiler.call_site_target
import compiler.util
import compiler.written
import compiler.scalar_ty
import compiler.ast_map
import compiler.symtab

#[doc("One node of the tail-call graph: a top-level function's module origin, its arity, and the id of the declaration it stands for. Arity is carried because a call whose argument count differs from the declaration is not a tail call the rewrite can fuse; the id is what a call matches on, so two same-named functions are two nodes whatever they spell.")]
pub(pkg) type TgNode = TgN(Option[String], Int, SymId)

#[doc("A tail-call edge from the node at index `from` to the node at index `to`, both indices into the node list `tailgraph_nodes` returned.")]
pub(pkg) type TgEdge = TgE(Int, Int)

#[doc("The tail-call graph of a program: its nodes in declaration order and the tail-call edges between them.")]
pub(pkg) type TailGraph = TG([TgNode], [TgEdge])

#[doc("A mutually recursive tail-call group: the indices, into the graph's node list, of the members of one strongly connected component of size two or more.")]
pub(pkg) type TgGroup = TgGrp([Int])

fn tgnode_arity(n: TgNode) : Int = match n { TgN(_, a, _) -> a }

fn tgnode_sym(n: TgNode) : SymId = match n { TgN(_, _, s) -> s }
#[doc("The node indices making up a mutually recursive group, in member order (`scc_groups`).")]
pub(pkg) fn tggroup_members(g: TgGroup) : [Int] = match g { TgGrp(xs) -> xs }
#[doc("The nodes of a tail-call graph, in declaration order.")]
pub(pkg) fn tailgraph_nodes(g: TailGraph) : [TgNode] = match g { TG(ns, _) -> ns }
fn tailgraph_edges(g: TailGraph) : [TgEdge] = match g { TG(_, es) -> es }

# ---- entry points --------------------------------------------------

#[doc("Build the tail-call graph of `decls`: one node per top-level function, one edge per call in tail position whose callee is another top-level function of matching arity.")]
pub(pkg) fn tailgraph_build(decls: [Decl]) : TailGraph {
  let nodes = tg_collect_nodes(decls)
  TG(nodes, tg_collect_edges(decls, nodes))
}

#[doc("The tail-call graph of `decls` before their names are resolved, with a call matched to the functions of `tab` that share its last name segment. It reports every group `tailgraph_build` does, and possibly more.")]
pub(pkg) fn tailgraph_build_named(decls: [Decl], tab: SymTab) : TailGraph / Mutable {
  let nodes = tg_collect_nodes(decls)
  TG(nodes, tg_collect_edges_named(decls, nodes, tab))
}

#[doc("The ids of the functions that belong to some group of `g`.")]
pub(pkg) fn tailgraph_group_syms(g: TailGraph) : [SymId] = {
  let syms = map(tailgraph_nodes(g), tgnode_sym)
  flat_map(tailgraph_groups(g), (grp) => flat_map(tggroup_members(grp), (i) => match nth(syms, i) { Some(s) -> [s]  None -> [] }))
}

#[doc("The mutually recursive tail-call groups of `g`: every strongly connected component with two or more members, ordered and listed as `scc_groups` gives them. Self-loops are excluded — a component of one member is the self-tail case the existing rewrite already handles.")]
pub(pkg) fn tailgraph_groups(g: TailGraph) : [TgGroup] =
  map(scc_groups(list_length(tailgraph_nodes(g)), map(tailgraph_edges(g), (e) => match e { TgE(a, b) -> (a, b) })), (ms) => TgGrp(ms))

# ---- nodes ---------------------------------------------------------

fn tg_collect_nodes(decls: [Decl]) : [TgNode] = match decls {
  [] -> []
  [d, ...rest] -> match tg_node_of_decl(d) {
    Some(n) -> [n, ...tg_collect_nodes(rest)]
    None    -> tg_collect_nodes(rest)
  }
}

fn tg_node_of_decl(d: Decl) : Option[TgNode] = match d {
  DFn(_, fid, _, params, _, _, _, _, _, mo) -> Some(TgN(mo, list_length(params), fnid_sym(fid)))
  _ -> None
}

# The nodes with their list index, by declaration id; each chain keeps
# list order, so its first hit is the list's first hit.
type TgIx = { by_sym: NameIndex[(Int, TgNode)], by_name: Array[[(String, Int, TgNode)]], tab: Option[SymTab] }

fn tg_index(rev: [(Int, TgNode)], ix: TgIx) : TgIx = match rev {
  [] -> ix
  [(i, n), ...rest] -> tg_index(rest, TgIx { ...ix, by_sym: idx_prepend_sym(ix.by_sym, tgnode_sym(n), (i, n)) })
}

fn tg_ix_named(rev: [(Int, TgNode)], tab: SymTab, table: Array[[(String, Int, TgNode)]]) : TgIx / Mutable =
  TgIx { by_sym: idx_empty(), by_name: tg_index_names(rev, tab, table), tab: Some(tab) }

fn tg_name_slot(name: String) : Int = ((string_hash(name) % 2048) + 2048) % 2048

fn tg_index_names(rev: [(Int, TgNode)], tab: SymTab, table: Array[[(String, Int, TgNode)]]) : Array[[(String, Int, TgNode)]] / Mutable = match rev {
  [] -> table
  [(i, n), ...rest] -> {
    let name = tg_text(sym_name(tab, tgnode_sym(n)))
    let slot = tg_name_slot(name)
    tg_index_names(rest, tab, array_set(table, slot, [(name, i, n), ...array_get(table, slot)]))
  }
}

fn tg_numbered(ns: [TgNode], i: Int, acc: [(Int, TgNode)]) : [(Int, TgNode)] = match ns {
  [] -> acc
  [n, ...rest] -> tg_numbered(rest, i + 1, [(i, n), ...acc])
}

fn tg_first(chain: [(Int, TgNode)], hit: (TgNode) -> Bool) : Option[(Int, TgNode)] = match chain {
  [] -> None
  [(i, n), ...rest] -> if hit(n) { Some((i, n)) } else { tg_first(rest, hit) }
}

# ---- edges ---------------------------------------------------------

fn tg_collect_edges(decls: [Decl], nodes: [TgNode]) : [TgEdge] =
  tg_edges_loop(decls, tg_index(tg_numbered(nodes, 0, []), TgIx { by_sym: idx_empty(), by_name: array_make(0, []), tab: None }), 0, [])

fn tg_collect_edges_named(decls: [Decl], nodes: [TgNode], tab: SymTab) : [TgEdge] / Mutable = {
  let numbered = tg_numbered(nodes, 0, [])
  tg_edges_loop(decls, tg_ix_named(numbered, tab, array_make(2048, [])), 0, [])
}

fn tg_edges_loop(decls: [Decl], nodes: TgIx, i: Int, acc: [TgEdge]) : [TgEdge] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DFn(_, _, _, _, _, _, body, _, _, _) ->
        tg_edges_loop(rest, nodes, i + 1,
          tg_add_targets(tg_tail_targets(body, nodes), nodes, i, acc))
      _ -> tg_edges_loop(rest, nodes, i, acc)
    }
  }
}

fn tg_add_targets(targets: [Int], nodes: TgIx, from: Int, acc: [TgEdge]) : [TgEdge] {
  match targets {
    [] -> acc
    [t, ...rest] ->
      if tg_has_edge(acc, from, t) { tg_add_targets(rest, nodes, from, acc) }
      else { tg_add_targets(rest, nodes, from, [TgE(from, t), ...acc]) }
  }
}

# The edges of `from` sit at the head of `es`: they are the last added.
fn tg_has_edge(es: [TgEdge], from: Int, to: Int) : Bool = match es {
  [] -> false
  [TgE(a, b), ...rest] -> if a != from { false } else if b == to { true } else { tg_has_edge(rest, from, to) }
}

fn tg_tail_targets(body: Expr, nodes: TgIx) : [Int] = flat_map(tailnorm_leaves(body), (leaf) => match leaf.kind {
  ECall(f, xs) -> tg_call_target(f, list_length(xs), nodes)
  _            -> []
})

# A callee names one declaration or none: the node is found by id, and
# a local's id is no node's.
fn tg_call_target(f: Expr, argc: Int, nodes: TgIx) : [Int] = match nodes.tab {
  Some(_) -> tg_resolve_name(tg_callee_name(f), argc, nodes)
  None -> match callee_id(f) {
    Some(s) -> tg_resolve_sym(s, argc, nodes)
    None    -> []
  }
}

# The early cut runs before the resolver: tail callees are still written names, over-approximated.
fn tg_text(w: Written) : String = written_text(w)

# Before names are resolved a callee is only its last segment: every node
# of that name is a target, so a group may be reported that is not one.
fn tg_callee_name(f: Expr) : String = match f.kind {
  EName(w)       -> tg_last_segment(tg_text(w))
  EModCall(_, n) -> tg_text(n)
  EField(_, n)   -> n
  _              -> ""
}

fn tg_last_segment(s: String) : String =
  if is_some(index_of(s, ".")) { unwrap_or(last(split(s, ".")), s) } else { s }

fn tg_resolve_name(name: String, argc: Int, nodes: TgIx) : [Int] =
  tg_name_hits(array_get(nodes.by_name, tg_name_slot(name)), name, argc)

fn tg_name_hits(chain: [(String, Int, TgNode)], name: String, argc: Int) : [Int] = match chain {
  [] -> []
  [(nm, i, n), ...rest] ->
    if nm == name and tgnode_arity(n) == argc { [i, ...tg_name_hits(rest, name, argc)] }
    else { tg_name_hits(rest, name, argc) }
}

fn tg_resolve_sym(s: SymId, argc: Int, nodes: TgIx) : [Int] =
  match tg_first(idx_chain_sym(nodes.by_sym, s), (n) => sym_raw(tgnode_sym(n)) == sym_raw(s)) {
    Some(at) -> tg_arity_ok(at, argc)
    None     -> []
  }

fn tg_arity_ok(at: (Int, TgNode), argc: Int) : [Int] = match at {
  (i, n) -> if tgnode_arity(n) == argc { [i] } else { [] }
}

#[doc("True when every declaration in `ds` agrees with `lead` on type parameters, return type and effect row, and every member annotates each parameter. Parameter lists may differ. The members' types are settled declarations and their type parameters are the lead's (`tfty_align`).")]
pub(pkg) fn tfsig_members_match(ds: [Decl], lead: Decl) : Bool = tf_members_match(ds, lead) and tf_sig_is_plain(lead)

fn tf_members_match(ds: [Decl], lead: Decl) : Bool = match ds {
  [] -> true
  [d, ...rest] -> if tf_sig_is_plain(d) and tf_sig_eq(d, lead) { tf_members_match(rest, lead) } else { false }
}

fn tf_sig_is_plain(d: Decl) : Bool = match d {
  DFn(_, _, _, params, opt_ret, _, _, _, _, _) -> tf_all_annotated(params) and tf_opt_ty_known(opt_ret)
  _ -> false
}

fn tf_all_annotated(params: [Param]) : Bool = match params {
  [] -> true
  [p, ...rest] -> match p.ptype {
    Some(_) -> tf_all_annotated(rest)
    None    -> false
  }
}

fn tf_opt_ty_known(t: Option[TypeExpr]) : Bool = match t {
  None    -> false
  Some(te) -> tf_ty_known(te)
}

fn tf_sig_eq(a: Decl, b: Decl) : Bool = match a {
  DFn(_, _, ta, _, ra, rowa, _, _, _, _) -> match b {
    DFn(_, _, tb, _, rb, rowb, _, _, _, _) -> tf_binders_eq(ta, tb) and tf_opt_ty_eq(ra, rb) and tf_row_eq(rowa, rowb)
    _ -> false
  }
  _ -> false
}

fn tf_binders_eq(a: [TBinder], b: [TBinder]) : Bool = match a {
  [] -> list_is_empty(b)
  [x, ...arest] -> match b {
    [] -> false
    [y, ...brest] -> if tlocal_eq(x.id, y.id) { tf_binders_eq(arest, brest) } else { false }
  }
}

fn tf_opt_ty_eq(a: Option[TypeExpr], b: Option[TypeExpr]) : Bool = match a {
  None -> false
  Some(ta) -> match b {
    None     -> false
    Some(tb) -> tf_ty_eq(ta, tb)
  }
}

# Only the shapes a fusable signature is made of; anything else reports
# unequal so the group stays unfused.
fn tf_ty_eq(a: TypeExpr, b: TypeExpr) : Bool = match a.tkind {
  TyName(ra, argsa) -> match b.tkind {
    TyName(rb, argsb) -> tf_ref_eq(ra, rb) and tf_ty_list_eq(argsa, argsb)
    _                 -> false
  }
  TyList(ea) -> match b.tkind {
    TyList(eb) -> tf_ty_eq(ea, eb)
    _          -> false
  }
  TyFn(psa, ra, rowa) -> match b.tkind {
    TyFn(psb, rb, rowb) -> tf_ty_list_eq(psa, psb) and tf_ty_eq(ra, rb) and tf_row_eq(rowa, rowb)
    _                   -> false
  }
  TyParam(ia, argsa) -> match b.tkind {
    TyParam(ib, argsb) -> tlocal_eq(ia, ib) and tf_ty_list_eq(argsa, argsb)
    _                  -> false
  }
  _ -> false
}

# One declaration, or one scalar: a scalar has no declaration, so its
# reference stays written and names the builtin type.
fn tf_ref_eq(a: DeclRef, b: DeclRef) : Bool = {
  let sa = ref_sym_or_core(a)
  let sb = ref_sym_or_core(b)
  if sym_raw(sa) >= 0 or sym_raw(sb) >= 0 { sym_raw(sa) == sym_raw(sb) } else { tf_scalar_eq(a, b) }
}

fn tf_scalar_eq(a: DeclRef, b: DeclRef) : Bool = match a {
  DrSym(_)          -> false
  DrWritten(qa, na) -> match b {
    DrSym(_)          -> false
    DrWritten(qb, nb) -> is_none(qa) and is_none(qb) and is_some(tf_scalar_of(na)) and tf_scalar_of(na) == tf_scalar_of(nb)
  }
}

# The builtin a scalar spelling names, as its canonical name.
fn tf_scalar_of(n: Written) : Option[String] = and_then(scalar_ty_named(written_text(n)), scalar_ty_name)

fn tf_ty_known(t: TypeExpr) : Bool = match t.tkind {
  TyName(_, targs) -> tf_ty_all_known(targs)
  TyFn(ps, r, _)  -> tf_ty_all_known(ps) and tf_ty_known(r)
  TyParam(_, targs) -> tf_ty_all_known(targs)
  TyList(e)       -> tf_ty_known(e)
  _               -> false
}

fn tf_ty_all_known(ts: [TypeExpr]) : Bool = match ts {
  [] -> true
  [t, ...rest] -> if tf_ty_known(t) { tf_ty_all_known(rest) } else { false }
  _ -> true
}

fn tf_ty_list_eq(a: [TypeExpr], b: [TypeExpr]) : Bool = match a {
  [] -> list_is_empty(b)
  [ta, ...arest] -> match b {
    [] -> false
    [tb, ...brest] -> if tf_ty_eq(ta, tb) { tf_ty_list_eq(arest, brest) } else { false }
  }
}

fn tf_row_eq(a: RowExpr, b: RowExpr) : Bool = match a {
  REmpty -> match b { REmpty -> true  _ -> false }
  RClosed(la) -> match b {
    RClosed(lb) -> tf_labels_eq(la, lb)
    _           -> false
  }
  ROpen(ta, la) -> match b {
    ROpen(tb, lb) -> tf_tail_eq(ta, tb) and tf_labels_eq(la, lb)
    _             -> false
  }
}

fn tf_tail_eq(a: TParamRef, b: TParamRef) : Bool = match a {
  TpId(ia) -> match b {
    TpId(ib) -> tlocal_eq(ia, ib)
    _        -> false
  }
  _ -> false
}

fn tf_labels_eq(a: [RowLabel], b: [RowLabel]) : Bool = match a {
  [] -> list_is_empty(b)
  [RL(ra, argsa), ...arest] -> match b {
    [] -> false
    [RL(rb, argsb), ...brest] ->
      if tf_eff_eq(ref_sym(ra), ref_sym(rb)) and tf_ty_list_eq(argsa, argsb) { tf_labels_eq(arest, brest) } else { false }
  }
}

fn tf_eff_eq(a: SymId, b: SymId) : Bool = sym_raw(a) >= 0 and sym_raw(a) == sym_raw(b)

#[doc("True when parameters `a` and `b` can share a slot of the fused entry: same borrow mode and a type the comparison recognises as equal.")]
fn tfsig_param_shares(a: Param, b: Param) : Bool =
  a.pborrow == b.pborrow and tf_opt_ty_eq(a.ptype, b.ptype)

#[doc("The fused entry's parameter slots and, per member, the slot each of its parameters lands in. Members share a slot when type and borrow mode agree, and the first member's parameters take slots 0 to k-1 in order.")]
pub(pkg) type TfSlots = TfSlots([Param], [[Int]])

#[doc("Assign the parameters of `ds`, in order, to shared slots.")]
pub(pkg) fn tfslots_layout(ds: [Decl]) : TfSlots = tf_slots_go(ds, [], [])

fn tf_slots_go(ds: [Decl], slots: [Param], acc: [[Int]]) : TfSlots = match ds {
  [] -> TfSlots(slots, list_reverse(acc))
  [d, ...rest] -> match d {
    DFn(_, _, _, ps, _, _, _, _, _, _) -> match tf_place(ps, slots, []) {
      TfPlaced(slots2, idxs) -> tf_slots_go(rest, slots2, [idxs, ...acc])
    }
    _ -> tf_slots_go(rest, slots, acc)
  }
}

# The slots after placing one member, and the slot of each of its parameters.
type TfPlaced = TfPlaced([Param], [Int])

# `used` holds the slots the member already took, newest first.
fn tf_place(ps: [Param], slots: [Param], used: [Int]) : TfPlaced = match ps {
  [] -> TfPlaced(slots, list_reverse(used))
  [p, ...rest] -> match tf_free_slot(slots, p, used, 0) {
    Some(i) -> tf_place(rest, slots, [i, ...used])
    None    -> tf_place(rest, list_append(slots, [p]), [list_length(slots), ...used])
  }
}

fn tf_free_slot(slots: [Param], p: Param, used: [Int], i: Int) : Option[Int] = match slots {
  [] -> None
  [s, ...rest] ->
    if not tf_int_has(used, i) and tfsig_param_shares(s, p) { Some(i) }
    else { tf_free_slot(rest, p, used, i + 1) }
}

fn tf_int_has(xs: [Int], x: Int) : Bool = match xs {
  [] -> false
  [h, ...rest] -> h == x or tf_int_has(rest, x)
}

#[doc("`body` with each read of the parameter `ids[i]` reading `to[i]`.")]
fn tfid_rename(body: Expr, ids: [LocalId], to: [LocalId]) : Expr =
  Expr { ...body, kind: match body.kind {
    ELocal(l) -> match tfid_slot(ids, to, l) {
      Some(t) -> ELocal(t)
      None    -> body.kind
    }
    _ -> prc_map_expr_kind(body.kind, (e) => tfid_rename(e, ids, to))
  } }

fn tfid_slot(ids: [LocalId], to: [LocalId], l: LocalId) : Option[LocalId] = match ids {
  [] -> None
  [i, ...irest] -> match to {
    [] -> None
    [t, ...trest] -> if local_eq(i, l) { Some(t) } else { tfid_slot(irest, trest, l) }
  }
}

#[doc("True when the resolver numbered every member's parameters; a group that fails stays unfused.")]
pub(pkg) fn tfid_all_renamable(ms: [Decl]) : Bool = match ms {
  [] -> true
  [d, ...rest] -> tfid_member_renamable(d) and tfid_all_renamable(rest)
}

fn tfid_member_renamable(d: Decl) : Bool = match d {
  DFn(_, _, _, ps, _, _, _, _, _, _) -> all(ps, (p) => local_raw(p.binder.id) != 0)
  _ -> false
}

#[doc("Each member renamed onto the slots it occupies, `slot_id` giving the binder of a slot by its index.")]
pub(pkg) fn tfid_onto_slots(members: [Decl], slots: TfSlots, slot_id: (Int) -> LocalId) : [Decl] = match slots {
  TfSlots(_, layout) -> tfid_onto_layout(members, layout, slot_id)
}

fn tfid_onto_layout(members: [Decl], layout: [[Int]], slot_id: (Int) -> LocalId) : [Decl] = match members {
  [] -> []
  [d, ...rest] -> match layout {
    [] -> members
    [idxs, ...more] -> [tfid_rename_member(d, map(idxs, slot_id)), ...tfid_onto_layout(rest, more, slot_id)]
  }
}

fn tfid_rename_member(d: Decl, to: [LocalId]) : Decl = match d {
  DFn(p, fid, tps, ps, ret, row, body, ln, cl, mo) ->
    DFn(p, fid, tps, ps, ret, row, tfid_rename(body, map(ps, (x) => x.binder.id), to), ln, cl, mo)
  _ -> d
}
