#[doc("Inlining a donation-capable template: the caller's arm-top token stands in for the donor its call handed over.")]

import compiler.kir
import compiler.kir_inline_beta

# The template sets a caller may draw from. A donation-capable template
# rebuilds into the token its call hands over, which a paste reads from the
# caller's arm-top token register, so only a caller holding one gets it.
pub(pkg) type KinSets = { all: KinTmpls, plain: KinTmpls }

pub(pkg) fn kin_tmpl_donor(t: KinTmpl) : Bool = match t {
  KT(_, f) -> f.donor
}

pub(pkg) fn kin_has_donor_rebuild(bs: [KBlock]) : Bool =
  any(bs, b => any(b.stmts, st => is_some(kin_donor_rebuild(st))))

fn kin_donor_rebuild(st: KStmt) : Option[KOp] = match st {
  KLet(_, _, op, _) -> kin_donor_op(op)
  KDo(op, _) -> kin_donor_op(op)
  _ -> None
}

fn kin_donor_op(op: KOp) : Option[KOp] = match op {
  KConReuse(RkDonorVariant, _, nm, tag, inits) ->
    Some(KConReuse(RkDonorVariant, KVar(kir_armru_reg()), nm, tag, inits))
  _ -> None
}

# A pasted donor rebuild takes the caller's arm-top token, as the call did.
pub(pkg) fn kin_rehome_donor(bs: [KBlock]) : [KBlock] =
  map(bs, b => KBlock { ...b, stmts: map(b.stmts, kin_rehome_stmt) })

fn kin_rehome_stmt(st: KStmt) : KStmt = match (st, kin_donor_rebuild(st)) {
  (KLet(x, sl, _, p), Some(op)) -> KLet(x, sl, op, p)
  (KDo(_, p), Some(op)) -> KDo(op, p)
  _ -> st
}

pub(pkg) fn kin_has_armtop(bs: [KBlock]) : Bool =
  any(
    bs,
    b => any(
      b.stmts,
      st => match st {
        KRC(KArmTopReuse(_, _, _, _), _) -> true
        _ -> false
      }
    )
  )
