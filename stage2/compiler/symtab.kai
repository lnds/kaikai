#[doc("The symbol table: one opaque `SymId` per declaration resolved to its row in O(1), how a program's entries build it, and the names and declarations its rows carry.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.expr_positions
import compiler.util

#[doc("Symbol table keyed by `SymId`: one slot buffer per field, plus a hash index from bare name to ids. `root` is the module symbol of the program's root file and `cores` those of its core modules; a table built for no program holds neither.")]
pub(pkg) type SymTab = { count: Int,
                    cap: Int,
                    ids: Array[Int],
                    names: Array[Written],
                    owners: Array[Int],
                    classes: Array[NCls],
                    exported: Array[Bool],
                    mints: Array[NMint],
                    buckets: Array[[Int]],
                    root: SymId,
                    cores: [SymId] }

#[doc("""
The empty table: no symbols, and no slots either.

Every read checks `cap` before it probes, so a table with zero slots
answers every lookup empty without allocating. A caller holding an
inert table — a resolver walking with recording off — pays nothing.
""")]
pub(pkg) fn st_empty() : SymTab = st_with_cap(0)

fn st_with_cap(cap: Int) : SymTab = st_fresh(cap, sym_none(), [])

#[doc("A table with `cap` empty slots and no symbols, of the program whose root file is the module `root` and whose core modules are `cores`.")]
pub(pkg) fn st_fresh(cap: Int, root: SymId, cores: [SymId]) : SymTab =
  SymTab { count: 0,
           cap: cap,
           ids: array_make(cap, 0 - 1),
           names: array_make(cap, written("")),
           owners: array_make(cap, 0 - 1),
           classes: array_make(cap, NCFn),
           exported: array_make(cap, false),
           mints: array_make(cap, NmSource),
           buckets: array_make(cap, []),
           root: root,
           cores: cores }

#[doc("How many symbols the table holds.")]
pub(pkg) fn st_count(t: SymTab) : Int = t.count

#[doc("True when `s` names a row of `t`.")]
pub(pkg) fn st_valid(t: SymTab, s: SymId) : Bool = st_row(t, s) >= 0

# The slot holding `s`, or -1. Ids are never negative, so a negative
# raw value (none, or a local binder) answers absent without probing.
fn st_row(t: SymTab, s: SymId) : Int {
  let id = sym_raw(s)
  if t.cap == 0 or id < 0 { 0 - 1 }
  else {
    let i = st_probe(t, id, id % t.cap)
    if array_get(t.ids, i) == id { i } else { 0 - 1 }
  }
}

fn st_probe(t: SymTab, id: Int, i: Int) : Int {
  let k = array_get(t.ids, i)
  if k == id or k < 0 { i } else { st_probe(t, id, (i + 1) % t.cap) }
}

#[doc("The declared name of `s`, or the empty name when `t` does not hold `s`.")]
pub(pkg) fn sym_name(t: SymTab, s: SymId) : Written {
  let i = st_row(t, s)
  if i >= 0 { array_get(t.names, i) } else { written("") }
}

#[doc("The module symbol that owns `s`. A module owns nothing, so its own owner is `sym_none()`.")]
pub(pkg) fn sym_owner(t: SymTab, s: SymId) : SymId {
  let i = st_row(t, s)
  if i >= 0 { SymId(array_get(t.owners, i)) } else { sym_none() }
}

#[doc("The home module that declares `s`, or the empty name when `t` does not hold `s` or nothing owns it.")]
pub(pkg) fn sym_home(t: SymTab, s: SymId) : Written = sym_name(t, sym_owner(t, s))

#[doc("True when `a` and `b` are owned by the same module symbol.")]
pub(pkg) fn sym_same_owner(t: SymTab, a: SymId, b: SymId) : Bool =
  sym_raw(sym_owner(t, a)) == sym_raw(sym_owner(t, b))

#[doc("True when the module symbol `m` owns `s`.")]
pub(pkg) fn sym_owned_by(t: SymTab, s: SymId, m: SymId) : Bool =
  sym_raw(sym_owner(t, s)) == sym_raw(m)

#[doc("True when the root file's module declares `s`. A table of no program has no root.")]
pub(pkg) fn sym_in_root(t: SymTab, s: SymId) : Bool =
  sym_raw(t.root) >= 0 and sym_owned_by(t, s, t.root)

#[doc("True when a core module declares `s`.")]
pub(pkg) fn sym_in_core(t: SymTab, s: SymId) : Bool = st_among(t.cores, sym_raw(sym_owner(t, s)))

fn st_among(ms: [SymId], m: Int) : Bool = match ms {
  []           -> false
  [h, ...rest] -> sym_raw(h) == m or st_among(rest, m)
}

#[doc("The name class of `s`. An absent id reports `NCFn`, which no caller reaches without first checking `st_valid`.")]
pub(pkg) fn sym_class(t: SymTab, s: SymId) : NCls {
  let i = st_row(t, s)
  if i >= 0 { array_get(t.classes, i) } else { NCFn }
}

#[doc("True when `s` is exported from its home.")]
pub(pkg) fn sym_exported(t: SymTab, s: SymId) : Bool {
  let i = st_row(t, s)
  if i >= 0 { array_get(t.exported, i) } else { false }
}

#[doc("Who declared `s`: the source, or the pass that minted it. An absent id reports the source.")]
pub(pkg) fn sym_mint(t: SymTab, s: SymId) : NMint {
  let i = st_row(t, s)
  if i >= 0 { array_get(t.mints, i) } else { NmSource }
}

#[doc("True when the compiler declared `s` for its own use, so no source text names it.")]
pub(pkg) fn sym_internal(t: SymTab, s: SymId) : Bool = mint_internal(sym_mint(t, s))

fn st_ent(t: SymTab, s: SymId) : Option[NEnt] {
  let i = st_row(t, s)
  if i < 0 { None }
  else { Some(NEnt(array_get(t.classes, i), written_text(array_get(t.names, i)),
                   written_text(sym_home(t, s)), array_get(t.exported, i), array_get(t.mints, i))) }
}

#[doc("Every id the table holds, in slot order.")]
pub(pkg) fn st_ids(t: SymTab) : [SymId] = st_ids_from(t, t.cap - 1, [])

fn st_ids_from(t: SymTab, i: Int, acc: [SymId]) : [SymId] =
  if i < 0 { acc }
  else {
    let k = array_get(t.ids, i)
    st_ids_from(t, i - 1, if k >= 0 { [SymId(k), ...acc] } else { acc })
  }

#[doc("Bucket for `name`. `string_hash` may be negative; the result lands in `[0, n)` for any sign.")]
pub(pkg) fn st_slot(name: String, n: Int) : Int {
  let h = string_hash(name)
  ((h % n) + n) % n
}

#[doc("Every id declared under the bare name `name`, in declaration order. Empty when nothing declares it.")]
pub(pkg) fn st_by_name(t: SymTab, name: String) : [SymId] =
  if t.cap == 0 { [] }
  else { st_filter_name(t, array_get(t.buckets, st_slot(name, t.cap)), name, []) }

# A bucket chain is built newest-first and may hold foreign names that
# hashed alike, so the read re-applies exact equality and re-reverses.
fn st_filter_name(t: SymTab, chain: [Int], name: String, acc: [SymId]) : [SymId] = match chain {
  [] -> acc
  [id, ...rest] ->
    if written_text(sym_name(t, SymId(id))) == name { st_filter_name(t, rest, name, [SymId(id), ...acc]) }
    else { st_filter_name(t, rest, name, acc) }
}

#[doc("The module symbol named `name`, or `None`.")]
pub(pkg) fn st_module(t: SymTab, name: String) : Option[SymId] =
  st_first_class(t, st_by_name(t, name), NCModule)

fn st_first_class(t: SymTab, cands: [SymId], cls: NCls) : Option[SymId] = match cands {
  [] -> None
  [s, ...rest] ->
    if ncls_same(sym_class(t, s), cls) { Some(s) } else { st_first_class(t, rest, cls) }
}

#[doc("The single id declaring `name` in class `cls`, owned by the module symbol `owner`, or `None`.")]
pub(pkg) fn st_lookup(t: SymTab, cls: NCls, name: String, owner: SymId) : Option[SymId] =
  st_pick(t, st_by_name(t, name), cls, owner)

fn st_pick(t: SymTab, cands: [SymId], cls: NCls, owner: SymId) : Option[SymId] = match cands {
  [] -> None
  [s, ...rest] ->
    if sym_owned_by(t, s, owner) and ncls_same(sym_class(t, s), cls) { Some(s) }
    else { st_pick(t, rest, cls, owner) }
}

#[doc("The ids declaring `name` in class `cls`, across every home. More than one means the bare use is contested.")]
pub(pkg) fn st_candidates(t: SymTab, cls: NCls, name: String) : [SymId] =
  st_keep_class(t, st_by_name(t, name), cls)

#[doc("The classes a type name ranges over: a declared type and a foreign one.")]
pub(pkg) fn type_classes() : [NCls] = [NCType, NCExternType]

#[doc("The core's `nursery` function, or no symbol when the program loads none.")]
pub(pkg) fn core_nursery_fn(t: SymTab) : SymId = match st_module(t, "spawn") {
  Some(m) -> unwrap_or(st_lookup(t, NCFn, "nursery", m), sym_none())
  None    -> sym_none()
}

#[doc("The core's `while`, `until` and `repeat`, in that order, or none when the program loads no `loop` module.")]
pub(pkg) fn core_loop_fns(t: SymTab) : [SymId] = match st_module(t, "loop") {
  Some(m) -> match st_lookup(t, NCFn, "while", m) {
    Some(w) -> match st_lookup(t, NCFn, "until", m) {
      Some(u) -> match st_lookup(t, NCFn, "repeat", m) {
        Some(r) -> [w, u, r]
        None    -> []
      }
      None -> []
    }
    None -> []
  }
  None -> []
}

#[doc("The core `loop` module, or no symbol when the program loads none.")]
pub(pkg) fn core_loop_home(t: SymTab) : SymId = unwrap_or(st_module(t, "loop"), sym_none())

#[doc("The ids declaring the type `name`, declared or foreign, across every home.")]
pub(pkg) fn st_type_candidates(t: SymTab, name: String) : [SymId] =
  list_append(st_candidates(t, NCType, name), st_candidates(t, NCExternType, name))

#[doc("The type `name` that module `owner` declares, declared or foreign.")]
pub(pkg) fn st_type_lookup(t: SymTab, name: String, owner: SymId) : Option[SymId] = match st_lookup(t, NCType, name, owner) {
  Some(s) -> Some(s)
  None    -> st_lookup(t, NCExternType, name, owner)
}

#[doc("The declarations of the class of `s` that share its name, in any home, `s` among them.")]
pub(pkg) fn sym_homonyms(t: SymTab, s: SymId) : [SymId] =
  st_candidates(t, sym_class(t, s), written_text(sym_name(t, s)))

#[doc("True when a second declaration of the class of `s` shares its name, in any home.")]
pub(pkg) fn sym_contested(t: SymTab, s: SymId) : Bool =
  match sym_homonyms(t, s) {
    [_, _, ..._] -> true
    _            -> false
  }

fn st_keep_class(t: SymTab, cands: [SymId], cls: NCls) : [SymId] = match cands {
  [] -> []
  [s, ...rest] ->
    if ncls_same(sym_class(t, s), cls) { [s, ...st_keep_class(t, rest, cls)] }
    else { st_keep_class(t, rest, cls) }
}

#[doc("The symbol table for the entries `es` of a program whose root file is the module `target` and whose core modules are `cores`. `target` is declared even when nothing is homed there.")]
pub(pkg) fn st_build(es: [NEnt], target: String, cores: [String]) : SymTab =
  st_fill(es, st_put_module(st_fresh(stb_pow2(4 * list_length(es) + 2, 8), st_module_id(target),
                                     map(cores, st_module_id)), target))

#[doc("The symbol table for an already-collected entry stream, of no program: every entry plus the module symbol of its home.")]
pub(pkg) fn st_of_entries(es: [NEnt]) : SymTab =
  st_fill(es, st_with_cap(stb_pow2(4 * list_length(es), 8)))

#[doc("`t` with every entry of `es` declared too; a key `t` already holds changes nothing. `t` itself is left as it was.")]
pub(pkg) fn st_extend(t: SymTab, es: [NEnt]) : SymTab =
  st_fill(es, st_refill(st_rows_of(t), st_fresh(t.cap, t.root, t.cores)))

# Each entry can bring a new module along, so `2n` rows at half load.
fn stb_pow2(n: Int, c: Int) : Int = if c >= n { c } else { stb_pow2(n, c * 2) }

fn st_fill(es: [NEnt], t: SymTab) : SymTab / Mutable = match es {
  [] -> t
  [NEnt(cls, name, home, exp, mint), ...rest] -> st_fill(rest, st_declare(t, cls, name, home, exp, mint))
}

# A key `t` already holds is the same symbol and changes nothing. A
# method is keyed by its impl block's scope and owned by that block's module.
fn st_declare(t: SymTab, cls: NCls, name: String, home: String,
      exp: Bool, mint: NMint) : SymTab / Mutable {
  let owner = match cls {
    NCMethod -> impl_scope_module(home)
    _        -> home
  }
  st_put(st_put_module(t, owner), cls, name, home, sym_raw(st_module_id(owner)), exp, mint)
}

fn st_put_module(t: SymTab, home: String) : SymTab / Mutable = st_put(t, NCModule, home, "", 0 - 1, true, NmSource)

#[doc("The id of the module symbol named `name`, the same whether or not a table holds it yet.")]
pub(pkg) fn st_module_id(name: String) : SymId = sym_derive(NCModule, name, "")

#[doc("The id a table gives the declaration of `name`, of class `cls`, homed at `home`.")]
pub(pkg) fn sym_derive(cls: NCls, name: String, home: String) : SymId = sym_derive_word(ncls_word(cls), name, home)

fn st_put(t: SymTab, cls: NCls, name: String, home: String, owner: Int,
      exp: Bool, mint: NMint) : SymTab / Mutable =
  if t.cap == 0 { st_put(st_grow(t), cls, name, home, owner, exp, mint) }
  else { st_put_at(t, sym_raw(sym_derive(cls, name, home)), cls, name, owner, exp, mint) }

fn st_put_at(t: SymTab, id: Int, cls: NCls, name: String, owner: Int,
      exp: Bool, mint: NMint) : SymTab / Mutable {
  let i = st_probe(t, id, id % t.cap)
  let held = array_get(t.ids, i) >= 0
  if held and st_same_key(t, i, cls, name, owner) { t }
  else if held { panic("symbol table: #{name} and #{array_get(t.names, i)} derive one id") }
  else if 2 * (t.count + 1) > t.cap { st_put_at(st_grow(t), id, cls, name, owner, exp, mint) }
  else { st_fill_slot(t, i, id, cls, written(name), owner, exp, mint) }
}

fn st_grow(t: SymTab) : SymTab = st_moved(t, stb_pow2(2 * t.cap, 8))

# Owners are themselves derived ids, so equal owners mean equal homes.
fn st_same_key(t: SymTab, i: Int, cls: NCls, name: String, owner: Int) : Bool =
  written_text(array_get(t.names, i)) == name and array_get(t.owners, i) == owner and
  ncls_same(array_get(t.classes, i), cls)

#[doc("The rows `tab` holds for what `decls` declares, in stream order: each declaration, and after a sum type its constructors. A declaration `tab` does not hold contributes nothing. `target` is the root file's module, the home of a form that carries a name and no origin.")]
pub(pkg) fn nt_collect(decls: [Decl], tab: SymTab, target: String) : [NEnt] =
  ntc_loop(decls, tab, target, [])

fn ntc_loop(ds: [Decl], tab: SymTab, target: String, acc: [NEnt]) : [NEnt] = match ds {
  []           -> list_reverse(acc)
  [d, ...rest] -> ntc_loop(rest, tab, target, ntc_one(d, tab, target, acc))
}

fn ntc_one(d: Decl, tab: SymTab, target: String, acc: [NEnt]) : [NEnt] = match decl_transparent_inner(d) {
  Some(inner) -> ntc_one(inner, tab, target, acc)
  None -> match d {
    # A specialisation is no symbol: only the declaration itself has a row.
    DFn(_, f, _, _, _, _, _, _, _, _, _, _) ->
      if fnid_inst(f) == spec_none() { ntc_sym(tab, fnid_sym(f), acc) } else { acc }
    DConst(_, s, _, _, _, _, _, _, _)       -> ntc_sym(tab, s, acc)
    DEffect(_, s, _, _, _, _, _, _, _, _)   -> ntc_sym(tab, s, acc)
    DProtocol(_, s, _, _, _, _, _, _, _)    -> ntc_sym(tab, s, acc)
    DType(_, s, _, body, _, _, _, _, _, _)  -> ntc_variants(body, tab, ntc_sym(tab, s, acc))
    DKind(p, n, _, _, _, _, _, mo)    -> [NEnt(NCKind, n, ntc_home(mo, target), p, NmSource), ...acc]
    DUnit(p, n, _, _, _, _, mo)       -> [NEnt(NCUnit, n, ntc_home(mo, target), p, NmSource), ...acc]
    DExternType(pb, n, _, _, _, mo)      -> [NEnt(NCExternType, n, ntc_home(mo, target), pb, NmSource), ...acc]
    DAxiom(p, _, n, _, _, _, _, _, _, _) -> [NEnt(NCFn, n, target, p, NmSource), ...acc]
    _ -> acc
  }
}

fn ntc_home(mo: Option[String], target: String) : String = match mo {
  Some(m) -> m
  None    -> target
}

fn ntc_sym(tab: SymTab, s: SymId, acc: [NEnt]) : [NEnt] = match st_ent(tab, s) {
  Some(e) -> [e, ...acc]
  None    -> acc
}

fn ntc_variants(b: TypeBody, tab: SymTab, acc: [NEnt]) : [NEnt] = match b {
  TBSum(vs) -> ntc_variant_loop(vs, tab, acc)
  _         -> acc
}

fn ntc_variant_loop(vs: [Variant], tab: SymTab, acc: [NEnt]) : [NEnt] = match vs {
  []                   -> acc
  [Var(c, _, _, _), ...rest] -> ntc_variant_loop(rest, tab, ntc_sym(tab, c, acc))
}

#[doc("The protocol rows of `decls`, for a consumer that only sees the stream after the lowering replaced each `DProtocol` with dispatchers.")]
pub(pkg) fn nt_protocols(decls: [Decl], tab: SymTab, target: String) : [NEnt] =
  nt_only(nt_collect(decls, tab, target), NCProtocol)

fn st_moved(t: SymTab, cap: Int) : SymTab = st_refill(st_rows_of(t), st_fresh(cap, t.root, t.cores))

fn st_fill_slot(t: SymTab, i: Int, id: Int, cls: NCls, name: Written, owner: Int,
      exp: Bool, mint: NMint) : SymTab / Mutable {
  let b = st_slot(written_text(name), t.cap)
  SymTab { count: t.count + 1,
           cap: t.cap,
           ids: array_set(t.ids, i, id),
           names: array_set(t.names, i, name),
           owners: array_set(t.owners, i, owner),
           classes: array_set(t.classes, i, cls),
           exported: array_set(t.exported, i, exp),
           mints: array_set(t.mints, i, mint),
           buckets: array_set(t.buckets, b, [id, ...array_get(t.buckets, b)]),
           root: t.root,
           cores: t.cores }
}

type StRow = StRow(Int, NCls, Written, Int, Bool, NMint)

fn st_rows_of(t: SymTab) : [StRow] = st_rows(t, t.cap - 1, [])

fn st_rows(t: SymTab, b: Int, acc: [StRow]) : [StRow] =
  if b < 0 { acc }
  else { st_rows(t, b - 1, st_chain_rows(t, array_get(t.buckets, b), acc)) }

fn st_chain_rows(t: SymTab, chain: [Int], acc: [StRow]) : [StRow] = match chain {
  [] -> acc
  [id, ...rest] -> st_chain_rows(t, rest, [st_row_of(t, id, st_probe(t, id, id % t.cap)), ...acc])
}

fn st_row_of(t: SymTab, id: Int, i: Int) : StRow =
  StRow(id, array_get(t.classes, i), array_get(t.names, i),
        array_get(t.owners, i), array_get(t.exported, i), array_get(t.mints, i))

fn st_refill(rows: [StRow], u: SymTab) : SymTab / Mutable = match rows {
  [] -> u
  [StRow(id, cls, name, owner, exp, mint), ...rest] ->
    st_refill(rest, st_fill_slot(u, st_probe(u, id, id % u.cap), id, cls, name, owner, exp, mint))
}

#[doc("Every body `d` holds: a function's, a runner block's, a constant's initialiser, and those of an impl's methods.")]
pub(pkg) fn decl_bodies(d: Decl) : [Expr] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _, _, _)  -> [body]
  DTest(_, body, _, _, _)               -> [body]
  DBench(_, body, _, _, _)              -> [body]
  DCheck(_, _, body, _, _, _)           -> [body]
  DConst(_, _, _, body, _, _, _, _, _)        -> [body]
  DImpl(_, _, _, subs, _, _, _, _)      -> flat_map(subs, decl_bodies)
  DDerive(_, inner, _, _)               -> decl_bodies(inner)
  DUnstable(inner, _, _)                -> decl_bodies(inner)
  DConstructor(inner, _, _)             -> decl_bodies(inner)
  DProtoLaws(_, inner, _, _, _)         -> decl_bodies(inner)
  DImplAxiom(_, inner, _, _, _)         -> decl_bodies(inner)
  DDoc(_, _, inner, _, _)               -> decl_bodies(inner)
  DAttr(_, inner, _, _)                 -> decl_bodies(inner)
  DType(_, _, _, _, _, _, _, _, _, _)         -> []
  DImport(_, _, _)                      -> []
  DEffect(_, _, _, _, _, _, _, _, _, _)       -> []
  DProtocol(_, _, _, _, _, _, _, _, _)        -> []
  DModuleDoc(_, _, _, _)                -> []
  DUnit(_, _, _, _, _, _, _)            -> []
  DUse(_, _, _)                         -> []
  DUseKind(_, _, _, _)                  -> []
  DAxiom(_, _, _, _, _, _, _, _, _, _)  -> []
  DExternType(_, _, _, _, _, _)            -> []
  DTheory(_, _, _, _, _)                -> []
  DKind(_, _, _, _, _, _, _, _)         -> []
}

#[doc("Every expression `d` evaluates: its bodies and the `#[json(default = …)]` of the fields of a record it declares.")]
pub(pkg) fn decl_exprs(d: Decl) : [Expr] = match decl_transparent_inner(d) {
  Some(inner) -> decl_exprs(inner)
  None        -> match d {
    DType(_, _, _, TBRecord(fs), _, _, _, _, _, _) -> field_defaults(fs)
    _                                        -> decl_bodies(d)
  }
}

#[doc("`d`, a declaration beneath its wrappers, with `f` applied to each expression `decl_exprs` lists.")]
pub(pkg) fn decl_map_exprs[e](d: Decl, f: (Expr) -> Expr / e) : Decl / e = match d {
  DType(p, s, tps, TBRecord(fs), l, c, nl, nc, mo, xs) ->
    DType(p, s, tps, TBRecord(map(fs, (fd) => field_map_default(fd, f))), l, c, nl, nc, mo, xs)
  _ -> decl_map_bodies(d, f)
}

fn field_defaults(fs: [FieldDecl]) : [Expr] = match fs {
  [] -> []
  [FD(_, _, _, attrs, _, _), ...rest] -> match field_attr_json_default(attrs) {
    Some(e) -> [e, ...field_defaults(rest)]
    None    -> field_defaults(rest)
  }
}

fn field_map_default[e](fd: FieldDecl, f: (Expr) -> Expr / e) : FieldDecl / e = match fd {
  FD(p, n, te, attrs, nl, nc) -> FD(p, n, te, map(attrs, (a) => attr_map_default(a, f)), nl, nc)
}

fn attr_map_default[e](a: FieldAttr, f: (Expr) -> Expr / e) : FieldAttr / e = match a {
  FAJsonDefault(x) -> FAJsonDefault(f(x))
  FAJsonRename(_)  -> a
  FAJsonSkip       -> a
}

#[doc("`d` with `f` applied beneath its annotation wrappers, which are rebuilt around the result.")]
pub(pkg) fn decl_map_inner[e](d: Decl, f: (Decl) -> Decl / e) : Decl / e = match d {
  DDerive(ps, inner, l, c)         -> DDerive(ps, decl_map_inner(inner, f), l, c)
  DUnstable(inner, l, c)           -> DUnstable(decl_map_inner(inner, f), l, c)
  DConstructor(inner, l, c)        -> DConstructor(decl_map_inner(inner, f), l, c)
  DProtoLaws(th, inner, l, c, mo)  -> DProtoLaws(th, decl_map_inner(inner, f), l, c, mo)
  DImplAxiom(th, inner, l, c, mo)  -> DImplAxiom(th, decl_map_inner(inner, f), l, c, mo)
  DDoc(raw, txt, inner, l, c)      -> DDoc(raw, txt, decl_map_inner(inner, f), l, c)
  DAttr(raw, inner, l, c)          -> DAttr(raw, decl_map_inner(inner, f), l, c)
  DFn(_, _, _, _, _, _, _, _, _, _, _, _)     -> f(d)
  DType(_, _, _, _, _, _, _, _, _, _)         -> f(d)
  DTest(_, _, _, _, _)                  -> f(d)
  DBench(_, _, _, _, _)                 -> f(d)
  DCheck(_, _, _, _, _, _)              -> f(d)
  DImport(_, _, _)                      -> f(d)
  DEffect(_, _, _, _, _, _, _, _, _, _)       -> f(d)
  DProtocol(_, _, _, _, _, _, _, _, _)        -> f(d)
  DImpl(_, _, _, _, _, _, _, _)         -> f(d)
  DModuleDoc(_, _, _, _)                -> f(d)
  DUnit(_, _, _, _, _, _, _)            -> f(d)
  DUse(_, _, _)                         -> f(d)
  DUseKind(_, _, _, _)                  -> f(d)
  DAxiom(_, _, _, _, _, _, _, _, _, _)  -> f(d)
  DConst(_, _, _, _, _, _, _, _, _)           -> f(d)
  DExternType(_, _, _, _, _, _)            -> f(d)
  DTheory(_, _, _, _, _)                -> f(d)
  DKind(_, _, _, _, _, _, _, _)         -> f(d)
}

#[doc("`d` with `f` applied to each body it holds, an impl's methods included. `f` also receives the identity of the function that owns the body, `fnid_none()` outside a function.")]
pub(pkg) fn decl_map_named_bodies[e](d: Decl, f: (FnId, Expr) -> Expr / e) : Decl / e = decl_map_inner(d, (x) => dmb_leaf(x, f))

#[doc("`d` with `f` applied to each body it holds, an impl's methods included.")]
pub(pkg) fn decl_map_bodies[e](d: Decl, f: (Expr) -> Expr / e) : Decl / e = decl_map_named_bodies(d, (owner, body) => f(body))

fn dmb_leaf[e](d: Decl, f: (FnId, Expr) -> Expr / e) : Decl / e = match d {
  DFn(p, id, tp, ps, rt, row, body, l, c, nlp, ncp, mo)     -> DFn(p, id, tp, ps, rt, row, f(id, body), l, c, nlp, ncp, mo)
  DTest(desc, body, l, c, mo)                     -> DTest(desc, f(fnid_none(), body), l, c, mo)
  DBench(desc, body, l, c, mo)                    -> DBench(desc, f(fnid_none(), body), l, c, mo)
  DCheck(desc, ps, body, l, c, mo)                -> DCheck(desc, ps, f(fnid_none(), body), l, c, mo)
  DConst(p, id, ta, body, mo, l, c, nl, nc)               -> DConst(p, id, ta, f(fnid_none(), body), mo, l, c, nl, nc)
  DImpl(pn, tas, tgt, subs, l, c, tps, id)        -> DImpl(pn, tas, tgt, map(subs, (s) => decl_map_named_bodies(s, f)), l, c, tps, id)
  DDerive(_, _, _, _)                             -> decl_map_named_bodies(d, f)
  DUnstable(_, _, _)                              -> decl_map_named_bodies(d, f)
  DConstructor(_, _, _)                           -> decl_map_named_bodies(d, f)
  DProtoLaws(_, _, _, _, _)                       -> decl_map_named_bodies(d, f)
  DImplAxiom(_, _, _, _, _)                       -> decl_map_named_bodies(d, f)
  DDoc(_, _, _, _, _)                             -> decl_map_named_bodies(d, f)
  DAttr(_, _, _, _)                               -> decl_map_named_bodies(d, f)
  DType(_, _, _, _, _, _, _, _, _, _)                   -> d
  DImport(_, _, _)                                -> d
  DEffect(_, _, _, _, _, _, _, _, _, _)                 -> d
  DProtocol(_, _, _, _, _, _, _, _, _)                  -> d
  DModuleDoc(_, _, _, _)                          -> d
  DUnit(_, _, _, _, _, _, _)                      -> d
  DUse(_, _, _)                                   -> d
  DUseKind(_, _, _, _)                            -> d
  DAxiom(_, _, _, _, _, _, _, _, _, _)            -> d
  DExternType(_, _, _, _, _, _)                      -> d
  DTheory(_, _, _, _, _)                          -> d
  DKind(_, _, _, _, _, _, _, _)                   -> d
}

#[doc("The namespace a name competes in. Two entries collide only when their class matches — `type Log` and `effect Log` are distinct habitants.")]
#[derive(BinSerialize)]
pub(pkg) type NCls = NCFn | NCType | NCEffect | NCConst | NCProtocol
              | NCCtor | NCKind | NCExternType | NCUnit | NCModule | NCBuiltin
              | NCMethod

#[derive(BinSerialize)]
pub(pkg) type NMint
  = NmSource
  # A function a derive declares for the program to call by name.
  | NmDerived
  # A protocol operation's dispatcher, an impl method lowered to a
  # function, a derived `BinSerialize` writer, a closure specialisation.
  | NmDispatcher | NmImpl | NmBinWriter | NmSpec
  # Any other declaration a pass makes for its own use.
  | NmHelper
  # A source declaration exported to the modules of its own package alone.
  | NmPackage
  # An `extern "C" fn` with a body: callable from C under the carried symbol,
  # empty when the fn's own name is the symbol.
  | NmExport(String)

#[doc("The spelling the formatter keeps for `pub(pkg)`: the raw text of the wrapper that carries it.")]
pub(pkg) fn pub_pkg_raw() : String = "pub(pkg)"

#[doc("The C symbol an `extern \"C\" fn` with a body is exported under, empty when its own name; None for any other declaration.")]
pub(pkg) fn mint_export(m: NMint) : Option[String] = match m {
  NmExport(sym) -> Some(sym)
  _             -> None
}

#[doc("True when the declaration is exported to its package alone.")]
pub(pkg) fn mint_package(m: NMint) : Bool = match m {
  NmPackage -> true
  _         -> false
}

fn mint_internal(m: NMint) : Bool = match m {
  NmSource     -> false
  NmPackage    -> false
  NmExport(_)  -> false
  NmDerived    -> false
  NmDispatcher -> true
  NmImpl       -> true
  NmBinWriter  -> true
  NmSpec       -> true
  NmHelper     -> true
}

#[doc("One declared name: `NEnt(class, name, home, exported, mint)`. Root-file declarations carry the target module as home; an impl method carries its impl block's scope.")]
#[derive(BinSerialize)]
pub(pkg) type NEnt = NEnt(NCls, String, String, Bool, NMint)

#[doc("The English word for a class, as it appears in a diagnostic.")]
pub(pkg) fn ncls_word(c: NCls) : String = match c {
  NCFn         -> "function"
  NCType       -> "type"
  NCEffect     -> "effect"
  NCConst      -> "constant"
  NCProtocol   -> "protocol"
  NCCtor       -> "constructor"
  NCKind       -> "kind"
  NCExternType -> "extern type"
  NCUnit       -> "unit"
  NCModule     -> "module"
  NCBuiltin    -> "builtin"
  NCMethod     -> "method"
}

#[doc("True when two name classes are the same namespace.")]
pub(pkg) fn ncls_same(a: NCls, b: NCls) : Bool = ncls_word(a) == ncls_word(b)

#[doc("The id a symbol table gives the entry `e`.")]
pub(pkg) fn nent_sym(e: NEnt) : SymId = match e {
  NEnt(cls, name, home, _, _) -> sym_derive_word(ncls_word(cls), name, home)
}

# No module home holds a '#', so a scope never spells a module and the
# module is everything before the first one.
fn impl_scope_mark() : String = "#impl:"

#[doc("The scope the methods of an impl block are declared in: the block's module and `key`, which no other impl block of that module carries.")]
pub(pkg) fn impl_scope_keyed(home: String, key: String) : String =
  string_concat(string_concat(home, impl_scope_mark()), key)

#[doc("The scope of the impl block written at `line`:`col` of the module `home`.")]
pub(pkg) fn impl_scope(home: String, line: Int, col: Int) : String =
  impl_scope_keyed(home, string_concat(string_concat(int_to_string(line), ":"), int_to_string(col)))

fn impl_scope_module(scope: String) : String = scope_module_at(scope, 0, string_length(scope))

fn scope_module_at(scope: String, i: Int, n: Int) : String =
  if i >= n { scope }
  else if string_byte_at_int(scope, i) == 35 { string_slice(scope, 0, i) }
  else { scope_module_at(scope, i + 1, n) }

#[doc("The id of the method `op` of the impl block whose scope is `scope`.")]
pub(pkg) fn method_sym(op: String, scope: String) : SymId = sym_derive_word(ncls_word(NCMethod), op, scope)

#[doc("The entry of the method `op` of the impl block whose scope is `scope`.")]
pub(pkg) fn method_ent(op: String, scope: String) : NEnt = NEnt(NCMethod, op, scope, false, NmSource)

#[doc("Only the entries of class `cls`.")]
pub(pkg) fn nt_only(t: [NEnt], cls: NCls) : [NEnt] = match t {
  [] -> []
  [e, ...rest] -> match e {
    NEnt(c, _, _, _, _) -> if ncls_same(c, cls) { [e, ...nt_only(rest, cls)] } else { nt_only(rest, cls) }
  }
}

#[doc("The name `s` was declared with: its table row, else the core type of that id, else the empty name.")]
pub(pkg) fn decl_name(tab: SymTab, s: SymId) : Written =
  if st_valid(tab, s) { sym_name(tab, s) }
  else { match core_type_name_of(s) {
    Some(n) -> written(n)
    None    -> written("")
  } }

#[doc("The module that declares `s`, by name: its owner's row, else the reserved core home for a core type, else the empty name.")]
pub(pkg) fn decl_home(tab: SymTab, s: SymId) : Written =
  if st_valid(tab, s) { sym_home(tab, s) }
  else { match core_type_name_of(s) {
    Some(_) -> written(core_type_home())
    None    -> written("")
  } }

type CdCx = CdCx(SymTab, String)

#[doc("One line per constructor site in the bodies of the functions outside the `core` modules.")]
pub(pkg) fn ctor_site_lines(tab: SymTab, core: [String], ds: [Decl]) : [String] = match ds {
  []           -> []
  [d, ...rest] -> cd_decl(tab, core, d) ++ ctor_site_lines(tab, core, rest)
}

fn cd_decl(tab: SymTab, core: [String], d: Decl) : [String] = match d {
  DFn(_, fid, _, _, _, _, body, _, _, _, _, mo) ->
    if cd_user(mo, core) { list_reverse(cd_expr(CdCx(tab, written_text(decl_name(tab, fnid_sym(fid)))), body, [])) } else { [] }
  _ -> []
}

fn cd_user(mo: Option[String], core: [String]) : Bool = match mo {
  None    -> true
  Some(m) -> not list_has(core, m)
}

fn cd_expr(cx: CdCx, e: Expr, acc: [String]) : [String] =
  cd_children(cx, xp_positions(e), cd_node(cx, e.kind, acc))

fn cd_node(cx: CdCx, k: ExprKind, acc: [String]) : [String] = match k {
  ESym(s, _)      -> if cd_is_ctor_sym(cx, s) { [cd_line(cx, "sym", cd_sym_text(cx, s), Some(s)), ...acc] } else { acc }
  EName(n)        -> if cd_is_ctor_name(cx, written_text(n)) { [cd_line(cx, "bare", written_text(n), None), ...acc] } else { acc }
  EModCall(q, n)  -> if cd_is_ctor_name(cx, written_text(n)) { [cd_line(cx, "mod", written_text(n), cd_in_home(cx, written_text(q), written_text(n))), ...acc] } else { acc }
  EMatch(_, arms) -> cd_arms(cx, arms, acc)
  EBlock(ss, _)   -> cd_stmts(cx, ss, acc)
  _               -> acc
}

fn cd_children(cx: CdCx, ps: [XPos], acc: [String]) : [String] = match ps {
  []                  -> acc
  [XP(_, c), ...rest] -> cd_children(cx, rest, cd_expr(cx, c, acc))
}

fn cd_arms(cx: CdCx, arms: [Arm], acc: [String]) : [String] = match arms {
  []                      -> acc
  [Arm(p, _, _), ...rest] -> cd_arms(cx, rest, cd_pat(cx, p, acc))
}

fn cd_stmts(cx: CdCx, ss: [Stmt], acc: [String]) : [String] = match ss {
  []                       -> acc
  [SLet(p, _, _), ...rest] -> cd_stmts(cx, rest, cd_pat(cx, p, acc))
  [_, ...rest]             -> cd_stmts(cx, rest, acc)
}

fn cd_pat(cx: CdCx, p: Pattern, acc: [String]) : [String] = match p.pkind {
  PVariant(r, subs)        -> cd_pats(cx, subs, [cd_ref_line(cx, "pat", r), ...acc])
  PVariantRecord(r, fs)    -> cd_pfields(cx, fs, [cd_ref_line(cx, "patrec", r), ...acc])
  PList(subs, _)           -> cd_pats(cx, subs, acc)
  PRecord(fs)              -> cd_pfields(cx, fs, acc)
  PAs(_, inner)            -> cd_pat(cx, inner, acc)
  _                        -> acc
}

fn cd_pats(cx: CdCx, ps: [Pattern], acc: [String]) : [String] = match ps {
  []           -> acc
  [p, ...rest] -> cd_pats(cx, rest, cd_pat(cx, p, acc))
}

fn cd_pfields(cx: CdCx, fs: [PField], acc: [String]) : [String] = match fs {
  []                         -> acc
  [PField(_, p, _), ...rest] -> cd_pfields(cx, rest, cd_pat(cx, p, acc))
}

# A pattern's head: the declaration it settled to, or what it is still written as.
fn cd_ref_line(cx: CdCx, form: String, r: DeclRef) : String = match r {
  DrSym(s)              -> cd_line(cx, form, cd_sym_text(cx, s), Some(s))
  DrWritten(None, n)    -> cd_line(cx, form, written_text(n), None)
  DrWritten(Some(q), n) -> cd_line(cx, form, written_text(n), cd_in_home(cx, written_text(q), written_text(n)))
}

fn cd_sym_text(cx: CdCx, s: SymId) : String = match cx {
  CdCx(tab, _) -> written_text(decl_name(tab, s))
}

fn cd_in_home(cx: CdCx, q: String, n: String) : Option[SymId] = match cx {
  CdCx(tab, _) -> match st_module(tab, q) {
    None    -> None
    Some(m) -> st_lookup(tab, NCCtor, n, m)
  }
}

fn cd_is_ctor_sym(cx: CdCx, s: SymId) : Bool = match cx {
  CdCx(tab, _) -> st_valid(tab, s) and ncls_same(sym_class(tab, s), NCCtor)
}

# A name some declaration gives a constructor, or one of the builtins no
# declaration carries.
fn cd_is_ctor_name(cx: CdCx, n: String) : Bool = match cx {
  CdCx(tab, _) -> match st_candidates(tab, NCCtor, n) {
    [] -> list_has(["Some", "None", "Ok", "Err"], n)
    _  -> true
  }
}

fn cd_line(cx: CdCx, form: String, n: String, s: Option[SymId]) : String = match cx {
  CdCx(tab, f) -> match s {
    None    -> concat_all(["ctor ", form, " ", f, " ", n, "#none"])
    Some(x) -> concat_all(["ctor ", form, " ", f, " ", n, "#", int_to_string(sym_raw(x)), " ",
                           written_text(sym_name(tab, x)), "@", written_text(sym_home(tab, x))])
  }
}

fn main_name() : String = "main"

# No identifier holds an `@`, so no source declares it.
fn runner_name() : String = "@runner"

#[doc("The id of the `main` the module homed at `home` may declare.")]
pub(pkg) fn main_id(home: String) : SymId = sym_derive(NCFn, main_name(), home)

#[doc("True when the function `f` is the declaration `main`, a module's `main`, itself and not a specialisation of it.")]
pub(pkg) fn is_main(main: SymId, f: FnId) : Bool = fnid_eq(f, fnid_decl(main))

#[doc("The id of what the binary built from `target` starts: its runner when the build runs test, bench or check blocks, the target's `main` otherwise.")]
pub(pkg) fn entry_id(target: String, runs_blocks: Bool) : SymId =
  if runs_blocks { sym_derive(NCFn, runner_name(), target) } else { main_id(target) }

#[doc("True when the function `f` is the entry point `entry`: no function is in a build that starts its runner.")]
pub(pkg) fn is_entry(entry: SymId, f: FnId) : Bool = fnid_eq(f, fnid_decl(entry))

#[doc("True when `t` is a result the entry point may return: `Int`, `Unit`, or a type left open because the body never returns.")]
pub(pkg) fn entry_result_ok(t: Ty) : Bool = match t {
  TyInt     -> true
  TyUnit    -> true
  TyVarT(_) -> true
  TyAny     -> true
  TyNothing -> true
  _         -> false
}

#[doc("The root modules of one compile: the id of each module, and the id of the `main` each may declare.")]
pub type Roots = Roots([SymId], [SymId])

#[doc("The root modules of a compile whose target is `target` and whose grouped test files are homed at `test_homes`.")]
pub(pkg) fn roots_of(target: String, test_homes: [String]) : Roots = {
  let homes = [target, ...test_homes]
  Roots(map(homes, (h) => st_module_id(h)), map(homes, (h) => main_id(h)))
}

#[doc("True when the module whose id is `m` is a root module.")]
pub(pkg) fn is_root_module(roots: Roots, m: SymId) : Bool = match roots {
  Roots(mods, _) -> roots_hold(mods, m)
}

#[doc("True when `f` is the `main` of a root module: the function the entry point's typing rules apply to.")]
pub(pkg) fn is_root_main(roots: Roots, f: FnId) : Bool = match roots {
  Roots(_, mains) -> fnid_inst(f) == spec_none() and roots_hold(mains, fnid_sym(f))
}

fn roots_hold(ids: [SymId], s: SymId) : Bool = match ids {
  []           -> false
  [x, ...rest] -> if sym_raw(s) >= 0 and sym_same(x, s) { true } else { roots_hold(rest, s) }
}

#[doc("True when `f` is the `main` of the module `mo` and that module is not a root. `None` is the target, always a root. It words a diagnostic; no rule reads it.")]
pub(pkg) fn is_imported_main(roots: Roots, mo: Option[String], f: FnId) : Bool = match mo {
  Some(m) -> is_main(main_id(m), f) and not is_root_module(roots, st_module_id(m))
  None    -> false
}

#[doc("The note a diagnostic about an imported module's `main` carries.")]
pub(pkg) fn imported_main_note() : String =
  "`main` is an entry point only in the root module; this file is imported here"
