# Infer a pipe / combinator function argument. A point-free section takes
# the stage's element type before its body is walked. A lambda that names
# its parameter keeps it open: what its body asks of it is how a stage
# written for the whole container is told from one written for an element.
fn synth_pipe_rhs(st: InferState, rhs: Expr, elem: Option[Ty]) : Inferred / Console + File + Mutable =
  match rhs.kind {
    ELambda(ps, body) -> match elem {
      Some(et) -> if params_point_free(ps) or stage_param_is_receiver(ps, body) { synth_lambda_expecting(st, ps, body, [et], rhs.line, rhs.col) }
                  else { w_synth(st, rhs) }
      None     -> w_synth(st, rhs)
    }
    _ -> w_synth(st, rhs)
  }


#[doc("Typer-internal helper `synth_pipe` shared across the infer modules.")]
pub fn synth_pipe(st: InferState, lhs: Expr, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let att = try_fuse_terminal_fold(st, lhs, rhs, line, col)
  match att.fused {
    Some(inf) -> inf
    None      -> synth_pipe_plain(att.st, lhs, rhs, line, col)
  }
}


# The callee of a pipe stage. A name the resolver left for the typer,
# one several modules declare (`filter` of both `option` and `list`), is
# narrowed by the piped value's type: under the pipe rewrite that value
# is the callee's first argument. A settled callee, and one with a single
# candidate, is read as any callee is.
fn synth_pipe_callee(st: InferState, f: Expr, lhs_ty: Ty) : Inferred / Console + File + Mutable = match f.kind {
  EName(nm) -> {
    let candidates = bare_fn_candidates(st, nm)
    if list_length(candidates) < 2 { synth_callee(st, f) }
    else { match pick_by_first_arg(st, candidates, apply_ty(st.sub, lhs_ty), f.line, f.col) {
      FaNone -> synth_callee(st, f)
      FaTie(st_t, ss) -> inferred_leaf(report_name_tie(st_t, nm, ss, true, f.line, f.col), TyAny, f)
      FaOne(pick) -> mk_inferred(pick_inst(pick, f.line, f.col), pick.inst_ty, with_ty(pick_ref(pick, f.line, f.col), pick.inst_ty))
    } }
  }
  _ -> w_synth(st, f)
}


fn synth_pipe_plain(st: InferState, lhs: Expr, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let rl = w_synth(st, lhs)
  let res = match rhs.kind {
    ECall(f, pa) -> {
      let rf = synth_pipe_callee(rl.st, f, rl.ty)
      let ra = synth_many_expecting(rf.st, pa, params_after_first(fn_param_tys(rf.st, rf.ty)))
      let rv = st_fresh_ty(ra.st)
      # same open-row trick `synth_call`
      # uses — let the callee's row tail bind to a fresh row var so
      # `xs |> each(handler)` against a row-polymorphic combinator
      # passes type checking when `handler` carries effect labels.
      let fr = subst_fresh_row(rv.st.sub)
      let st_fresh = st_set_sub(rv.st, fr.subst)
      let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
      let expected = TyFnT([rl.ty, ...ra.tys], rv.ty, expected_row)
      let st_unif = st_unify(st_fresh, rf.ty, expected, "pipe call", line, col)
      let st2 = st_propagate_capability_labels(st_unif, apply_ty(st_unif.sub, rf.ty), line, col)
      match refine_call(st2, rf.expr, rf.ty, [rl.expr, ...ra.exprs], [rl.ty, ...ra.tys], apply_ty(st2.sub, rv.ty)) {
        RefCall(st3, ty) -> PipeRes { st: st3, ty: ty, call: mk_expr(ECall(rf.expr, [rl.expr, ...ra.exprs]), line, col) }
      }
    }
    _ -> {
      let rf = synth_pipe_callee(rl.st, rhs, rl.ty)
      let rv = st_fresh_ty(rf.st)
      let fr = subst_fresh_row(rv.st.sub)
      let st_fresh = st_set_sub(rv.st, fr.subst)
      let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
      let expected = TyFnT([rl.ty], rv.ty, expected_row)
      let st_unif = st_unify(st_fresh, rf.ty, expected, "pipe call", line, col)
      let st2 = st_propagate_capability_labels(st_unif, apply_ty(st_unif.sub, rf.ty), line, col)
      match refine_call(st2, rf.expr, rf.ty, [rl.expr], [rl.ty], apply_ty(st2.sub, rv.ty)) {
        RefCall(st3, ty) -> PipeRes { st: st3, ty: ty, call: mk_expr(ECall(rf.expr, [rl.expr]), line, col) }
      }
    }
  }
  mk_inferred(res.st, res.ty, with_ty(res.call, res.ty))
}

# head-owner cache.
#
# `synth_pipe_dispatch` rewrites `xs | f`, `xs || f`, and `xs |? p`
# into a qualified call against the module that owns the LHS's head
# type — `List → list.map`, `MyBox → mypkg.mybox.map`, etc.
#
# Earlier this was a hardcoded `if head == "List" { Some("list") }`
# table that knew exactly one entry. That made any downstream package
# wishing to participate in `|` (ahu.stream.Source[T], henua.EventBus,
# manutara stream/sink types, …) require a recompile of `kaic2`.
# Unacceptable for a downstream-package ecosystem.
#
# Why convention beats annotation/protocol here:
#   * Operator protocols (`+`-style) require the op's signature to fit
#     `(Self, X) -> Y` shapes a protocol can express. `map`'s shape is
#     `F[A] -> (A -> B) -> F[B]` — higher-kinded. CLAUDE.md bans HKT in
#     the typer; protocols cannot express it.
#   * Effect rows in operator-protocol ops are also banned, but `map`
#     against an effectful function carries the function's effect row
#     into its own signature — protocols would have to admit row-poly
#     ops, which they don't.
#   * Annotations (`#pipe_dispatch`) cost a parser change and a new
#     visible concept for ~5 stdlib + future package decls. Convention
#     is free at the surface, costs ~70 LOC inside the compiler, and
#     mirrors how qualified-name resolution already works for
#     `EModCall`-driven calls.
#
# The cache shape: `[HOE(head type, [module_path])]`. A single-element
# `module_path` list is the dispatchable case; a multi-element list is
# ambiguous and the typer reports the modules at the use site so the
# user can pick `mod.T` annotation or rename one of the conflicting
# `pub type T` declarations.
#
# Canonical signatures package authors must follow for their `pub type T`
# to participate in `|` / `||` / `|?` (the LHS receiver is always the
# first argument; the function/predicate is second; the return wraps
# the same head type):
#
#   pub fn map[A, B, e](xs: T[A], f: (A) -> B / e) : T[B] / e
#   pub fn flat_map[A, B, e](xs: T[A], f: (A) -> T[B] / e) : T[B] / e
#   pub fn filter[A, e](xs: T[A], p: (A) -> Bool / e) : T[A] / e
#
# A head carrying an `(element, row)` parameter list — `Stream[t, e]`,
# the streaming carrier whose effect row is a type parameter — also
# rides the pipes: dispatch is by the head type (arity-agnostic), and the
# whole LHS type unifies against the canonical receiver, so the row
# slot threads via the row carrier (`row_arg_carrier`). The element
# unifies against the first slot; the row threads as `e`.
#
# A package that ships `map` with a swapped argument order or a missing
# row var still surfaces the standard call-inference signature mismatch
# — the typer does not need a separate diagnostic for "your map shape
# is wrong". (An extra *type* parameter that is NOT the trailing
# effect-row slot still mismatches; only the legitimate `(element, row)`
# shape is accepted.)
#
# Construction: linear over `(decls, modules)`, called once per
# `compile_source` invocation right before `infer_program`
# runs the typer over the same decl stream. Lookup at each pipe call
# site is `find_head_owner` walking the cache; it is a small linear
# list (one entry per `pub type` across all modules in scope) and the
# constant-factor cost dominates over a hash map until the program
# crosses ~hundreds of pub types — hello-world programs sit at <50.


#[doc("Typer-internal helper `synth_pipe_dispatch` shared across the infer modules.")]
pub fn synth_pipe_dispatch(st: InferState, pop: PipeOp, lhs: Expr, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let rl = w_synth(st, lhs)
  let lhs_ty = apply_ty(rl.st.sub, rl.ty)
  match inf_ty_head_name(rl.st.env.tab, lhs_ty) {
    None       -> pipe_error(rl, pop, rhs, pipe_unresolved_head_msg(pipe_op_core_fn(pop)), line, col)
    Some(head) -> pipe_by_head(rl, lhs_ty, head, pop, rhs, line, col)
  }
}

fn pipe_unresolved_head_msg(cf: CoreFn) : String =
  concat_all([core_fn_name(cf), "-pipe requires a concrete head type on the left-hand side; got an unresolved type variable. ",
              "Annotate the LHS or restructure the pipeline."])

fn pipe_error(rl: Inferred, pop: PipeOp, rhs: Expr, msg: String, line: Int, col: Int) : Inferred / Console + File + Mutable {
  let perr = mk_diag(SevError, rl.st.file, line, col, msg, [])
  render_diag(perr)
  let root = with_ty(mk_expr(EDispatchPipe(pop, rl.expr, rhs), line, col), TyAny)
  mk_inferred(st_bump_err(st_push_diag(rl.st, perr)), TyAny, root)
}

fn pipe_by_head(rl: Inferred, lhs_ty: Ty, head: String, pop: PipeOp, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let hsym = ty_head_sym(lhs_ty)
  match pipe_rejection_reason(hsym, pop) {
    Some(msg) -> pipe_error(rl, pop, rhs, msg, line, col)
    None      -> match find_head_owner(rl.st.env, hsym) {
      HLNone          -> pipe_error(rl, pop, rhs, concat_all(["no module declaring type `", head, "` is in scope"]), line, col)
      HLAmbiguous(ms) -> pipe_error(rl, pop, rhs, pipe_ambiguous_msg(rl.st.env.tab, head, ms), line, col)
      HLOk(owner)     -> pipe_through_owner(rl, lhs_ty, hsym, head, owner, pop, rhs, line, col)
    }
  }
}

fn pipe_ambiguous_msg(tab: SymTab, head: String, mods: [SymId]) : String =
  concat_all(["ambiguous head type `", head, "` — ", join_modules_for_diag(map(mods, (m) => "#{sym_name(tab, m)}")),
              " all declare it. Use qualified type annotation."])

# The module's own `op` when it declares one; a `Shape`-protocol impl provides the
# op through its dispatcher; otherwise the runtime primitive of that name answers,
# and the call-inference signature mismatch reports it.
fn pipe_callee_kind(qualified: Option[SymId], op: String, proto_disp: Option[ExprKind]) : ExprKind =
  match qualified {
    Some(s) -> ESym(s, spec_none())
    None    -> match proto_disp {
      Some(k) -> k
      None    -> ESym(builtin_sym(op), spec_none())
    }
  }

# A user `pub type` whose module ships no canonical op is reported; the seeded
# `List` head stays silent and routes through the primitive.
fn pipe_missing_op_state(rl: Inferred, hsym: SymId, head: String, owner: SymId, op: String, has_proto_op: Bool, line: Int, col: Int) : InferState / Console + File + Mutable =
  if core_ty_is(hsym, CtList) or has_proto_op { rl.st }
  else {
    let perr = mk_diag(SevError, rl.st.file, line, col,
      "module `#{sym_name(rl.st.env.tab, owner)}` declares `#{head}` but does not export `#{op}`", [])
    render_diag(perr)
    st_bump_err(st_push_diag(rl.st, perr))
  }

fn pipe_through_owner(rl: Inferred, lhs_ty: Ty, hsym: SymId, head: String, owner: SymId, pop: PipeOp, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let cf = pipe_op_core_fn(pop)
  let op = core_fn_name(cf)
  let qualified = env_module_fn(rl.st.env, owner, op)
  let proto_disp = pipe_op_dispatcher(rl.st.protos, lhs_ty, op)
  let callee_kind = pipe_callee_kind(qualified, op, proto_disp)
  let st_after_diag = match qualified {
    Some(_) -> rl.st
    None    -> pipe_missing_op_state(rl, hsym, head, owner, op, is_some(proto_disp), line, col)
  }
  let rc = w_synth(st_after_diag, with_ty(mk_expr(callee_kind, line, col), TyAny))
  pipe_apply(rl, rc, lhs_ty, callee_kind, cf, owner, op, qualified, pop, rhs, line, col)
}

fn pipe_apply(rl: Inferred, rc: Inferred, lhs_ty: Ty, callee_kind: ExprKind, cf: CoreFn, owner: SymId, op: String, qualified: Option[SymId], pop: PipeOp, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let pe = pipe_elem_from_callee(rc.st.env, rc.st.sub, rc.ty, lhs_ty)
  let st_pe = match pe {
    Some(PE(_, s)) -> st_set_sub(rc.st, s)
    None           -> rc.st
  }
  let elem = pipe_elem_ty(pe)
  let rf = each_stage_checked(pop, synth_pipe_rhs(st_pe, rhs, elem), line, col)
  let rv = st_fresh_ty(rf.st)
  let ret = match pop {
    PoEach -> TyUnit
    _      -> rv.ty
  }
  let fr = subst_fresh_row(rv.st.sub)
  let st_fresh = st_set_sub(rv.st, fr.subst)
  let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
  let expected = TyFnT([rl.ty, rf.ty], ret, expected_row)
  let pipe_callee = mk_expr(callee_kind, line, col)
  let st2 = match pipe_stage_wants_container(st_fresh.env, st_fresh.sub, rl.ty, rf.ty, elem) {
    Some(param) -> {
      emit_pipe_wants_apply(st_fresh, pop, rhs, param, elem, line, col)
      st_bump_err(st_fresh)
    }
    None -> st_unify_named(st_fresh, pipe_callee_shown(st_fresh, owner, op, qualified, pipe_callee), rc.ty, [rl.ty, rf.ty], expected, line, col)
  }
  match refine_call(st2, pipe_callee, rc.ty, [rl.expr, rf.expr], [rl.ty, rf.ty], apply_ty(st2.sub, ret)) {
    RefCall(st3, ty) -> {
      let fused = try_fuse_map_pipe(st3, cf, rc.expr, rl.expr, rf.expr, ty, line, col)
      mk_inferred(fused.st, ty, fused.root)
    }
  }
}


fn try_fuse_terminal_fold(st: InferState, lhs: Expr, rhs0: Expr, line: Int, col: Int) : FuseAttempt / Console + File + Mutable = {
  let rhs = if pipe_fusion_head(lhs) { terminal_settled(st, rhs0) } else { rhs0 }
  match pipe_fusion_as_terminal_fold(st.protos.ids, lhs, rhs) {
    None     -> FuseAttempt { st: st, fused: None }
    Some(ff) -> fuse_gated(st, ff, rhs, line, col)
  }
}

fn fuse_gated(st: InferState, ff: FusedFold, rhs: Expr, line: Int, col: Int) : FuseAttempt / Console + File + Mutable = {
  let g = fuse_terminal_gate(st, ff)
  if g.ok { fuse_rewrite(st, g.st, ff, rhs, line, col) } else { FuseAttempt { st: g.st, fused: None } }
}

# The peek advances the fresh-tvar counter and binds in the shared substitution,
# so the rewrite is walked from the state the peek returns: reusing the old one
# would mint the peek's already-bound ids again.
fn fuse_rewrite(st: InferState, st_gate: InferState, ff: FusedFold, rhs: Expr, line: Int, col: Int) : FuseAttempt / Console + File + Mutable =
  match fuse_source_is_protocol_seq(st_gate, ff) {
    FSP(st_after, is_seq, of_chars) -> {
      let proto_foldl = pipe_fusion_proto_foldl(st.protos.ids, rhs)
      if of_chars or fuse_owner_mismatch(ff, proto_foldl, is_seq) { FuseAttempt { st: st_after, fused: None } }
      else {
        let rewrite = if is_seq { pipe_fusion_generic_fold_rewrite(ff, proto_foldl, line, col) } else { pipe_fusion_fold_rewrite(ff, line, col) }
        FuseAttempt { st: st_after, fused: Some(w_synth(st_after, rewrite)) }
      }
    }
  }


fn fuse_source_is_protocol_seq(st: InferState, ff: FusedFold) : FuseSeqPeek / Console + File + Mutable =
  fuse_source_peek(st, ff.source)


#[doc("Typer-internal helper `fuse_source_peek` shared across the infer modules.")]
pub fn fuse_source_peek(st: InferState, source: Expr) : FuseSeqPeek / Console + File + Mutable {
  let r = w_synth(st, source)
  let src_ty = apply_ty(r.st.sub, r.ty)
  let head_ok = not core_ty_is(ty_head_sym(src_ty), CtList) and pipe_op_has_impl(st.protos.impls, src_ty, "foldl")
  let of_chars = pipe_fusion_head(source) and ty_is_char_list(src_ty)
  FSP(st_restore_deferred_fields(r.st, st.deferred_fields, st.deferred_homs), head_ok, of_chars)
}


# An explicit `foldl` keeps the Mutable-masked purity gate — its stage
# and combine still run, only reordered. An implicit terminal (`sum`,
# `product`, `length`) rewrites to a target with a row-less stage
# parameter — and `length` drops the stages — so it demands strictly
# empty labels.
fn fuse_terminal_gate(st: InferState, ff: FusedFold) : FuseGate / Console + File + Mutable =
  match ff.term {
    TermFoldl(_, combine) -> {
      let g = fuse_all_raw(st, ff.stages, false)
      if g.ok { fuse_raw(g.st, combine, false) } else { g }
    }
    _ -> fuse_all_raw(st, ff.stages, true)
  }


#[doc("Typer-internal helper `fuse_all_raw` shared across the infer modules.")]
pub fn fuse_all_raw(st: InferState, closures: [Expr], strict: Bool) : FuseGate / Console + File + Mutable =
  match closures {
    [] -> FuseGate { st: st, ok: true }
    [c, ...rest] -> {
      let g = fuse_raw(st, c, strict)
      if g.ok { fuse_all_raw(g.st, rest, strict) } else { g }
    }
  }


# Synthesise a raw stage/combine closure solely to read its effect row.
# The typed node is discarded — only the verdict and the threaded state
# are kept. The probe's `deferred_fields` are rolled back: a stage body
# `(r) => r.field` with an unannotated `r` synthesised in isolation defers
# the field against a receiver tyvar that this probe never pins (only the
# re-synthesised rewrite call binds the real stage param to the element
# type). Left in the worklist, that orphan receiver drains to a spurious
# "annotation needed". The fresh-tvar counter and substitution still ride
# forward — rewinding those would re-mint ids the probe already bound.
fn fuse_raw(st: InferState, closure: Expr, strict: Bool) : FuseGate / Console + File + Mutable {
  let r = w_synth(st, closure)
  let ok = if strict { fuse_row_strict(r.st.sub, r.expr) }
           else { fuse_stage_pure(r.st.sub, r.expr) }
  FuseGate { st: st_restore_deferred_fields(r.st, st.deferred_fields, st.deferred_homs), ok: ok }
}


