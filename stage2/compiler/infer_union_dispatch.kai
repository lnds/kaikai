#[doc("Dispatch of a protocol operation on a union-typed receiver: a static match over the components, each arm calling its component's impl.")]

import compiler.util
import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.written
import compiler.proto_ids
import compiler.infer_env
import compiler.infer_env_exhaust
import compiler.infer_head_dispatch
import compiler.infer_index
import compiler.infer_state

#[doc("The call of the dispatcher `callee` on a receiver typed `recv` as a union of types, rewritten to a match that calls the operation on the component the receiver carries; `None` for any other call, or when no component has an impl of the operation.")]
pub fn try_union_dispatch(st: InferState, settled: Expr, callee: Expr, args_: [Expr], recv: Ty,
                          line: Int, col: Int) : Option[Inferred] / Console + File + Mutable =
  match pid_ref_disp(st.protos.ids, settled) {
    None      -> None
    Some(row) -> match args_ {
      []                     -> None
      [first, ...rest_args] -> match union_receiver(st, recv, disp_op(row)) {
        []    -> None
        comps -> Some(w_synth(st, union_call(callee, first, rest_args, comps, line, col)))
      }
    }
  }

# The components of the receiver type when it is a union of types at least
# one of whose components has an impl of `op`.
fn union_receiver(st: InferState, t: Ty, op: String) : [SymId] = match ty_dispatch_head(t) {
  TyCon(s, []) ->
    if sym_raw(s) >= 0 and is_union_of_types(st.env, s) {
      let comps = filter(map(ut_components(st.env.unions, s), ut_ty_sym), (c) => sym_raw(c) >= 0)
      if any(comps, (c) => is_some(pipe_op_impl(st.protos.impls, TyCon(c, []), op))) { comps } else { [] }
    } else { [] }
  _ -> []
}

# `{ let u = first; let r_i = rest_i; match u { b : C -> callee(b, r_i...) ... } }`:
# the receiver and the other arguments evaluate once, in source order.
fn union_call(callee: Expr, first: Expr, rest_args: [Expr], comps: [SymId], line: Int, col: Int) : Expr = {
  let site = concat_all([int_to_string(line), ":", int_to_string(col)])
  let recv = union_binder(concat_all(["union dispatch receiver ", site]))
  let rest_binders = union_arg_binders(site, 0, list_length(rest_args))
  let scr = if rest_args == [] { first } else { mk_expr(ELocal(recv.id), line, col) }
  let arg_tail = map(rest_binders, (b) => mk_expr(ELocal(b.id), line, col))
  let m = mk_expr(EMatch(scr, union_arms(callee, comps, 0, arg_tail, site, line, col)), line, col)
  if rest_args == [] { m } else {
    mk_expr(EBlock([union_let(recv, first, line, col), ...union_arg_lets(rest_binders, rest_args, line, col)], Some(m)), line, col)
  }
}

fn union_arms(callee: Expr, comps: [SymId], i: Int, arg_tail: [Expr], site: String, line: Int, col: Int) : [Arm] = match comps {
  [] -> []
  [comp, ...rest] -> {
    let b = union_binder(concat_all(["union dispatch arm ", int_to_string(i), " ", site]))
    let te = mk_ty(TyName(DrSym(comp), []), line, col)
    let call = mk_expr(ECall(callee, [mk_expr(ELocal(b.id), line, col), ...arg_tail]), line, col)
    [Arm(mk_pat(PNarrow(b, te), line, col), None, call), ...union_arms(callee, rest, i + 1, arg_tail, site, line, col)]
  }
}

fn union_binder(key: String) : Binder = Binder { id: local_minted(key), name: written("u") }

fn union_arg_binders(site: String, i: Int, n: Int) : [Binder] =
  if i >= n { [] }
  else { [union_binder(concat_all(["union dispatch argument ", int_to_string(i), " ", site])), ...union_arg_binders(site, i + 1, n)] }

fn union_arg_lets(bs: [Binder], rhs: [Expr], line: Int, col: Int) : [Stmt] = match bs {
  [] -> []
  [b, ...brest] -> match rhs {
    []             -> []
    [e, ...erest] -> [union_let(b, e, line, col), ...union_arg_lets(brest, erest, line, col)]
  }
}

fn union_let(b: Binder, rhs: Expr, line: Int, col: Int) : Stmt = SLet(mk_pat(PBind(b), line, col), None, rhs)
