#[doc("Whether an expression reads a binder outside its lambda bodies, answered without counting the reads.")]

import compiler.ast
import compiler.sym_read
import compiler.expr_positions
import compiler.perceus_reads

#[doc("True when `nm` is read in `e` outside every lambda body; unlike `pcs_mentions`, a lambda body's reads do not count.")]
pub fn pcs_read_outside_lambda(nm: String, e: Expr) : Bool = match sym_read_kind(e.kind) {
  EVar(uname)           -> uname == nm
  EStr(span, is_triple) -> pcs_interp_ident_count(nm, span, is_triple) > 0
  _                     -> pcs_read_outside_lambda_ps(nm, xp_positions_kind(e.kind))
}

fn pcs_read_outside_lambda_ps(nm: String, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(r, c), ...rest] -> (match r { XLam -> false  _ -> pcs_read_outside_lambda(nm, c) }) or pcs_read_outside_lambda_ps(nm, rest)
}

#[doc("True when `nm` is passed bare as one of `xs`.")]
pub fn pcs_any_arg_is_var(nm: String, xs: [Expr]) : Bool = match xs {
  []           -> false
  [h, ...rest] -> match sym_read_kind(h.kind) {
    EVar(uname) -> if uname == nm { true } else { pcs_any_arg_is_var(nm, rest) }
    _           -> pcs_any_arg_is_var(nm, rest)
  }
}

#[doc("True when one of `xs` reads `nm` outside its lambda bodies.")]
pub fn pcs_any_arg_mentions(nm: String, xs: [Expr]) : Bool = match xs {
  []           -> false
  [h, ...rest] -> pcs_read_outside_lambda(nm, h) or pcs_any_arg_mentions(nm, rest)
}
