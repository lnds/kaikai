#[doc("Whether an expression reads a binder outside its lambda bodies, answered without counting the reads.")]

import compiler.ast
import compiler.expr_positions
import compiler.perceus_reads

#[doc("True when `b` is read in `e` outside every lambda body; unlike `pcs_mentions`, a lambda body's reads do not count.")]
pub fn pcs_read_outside_lambda(b: Binder, e: Expr) : Bool = match e.kind {
  ELocal(u) -> local_eq(u, b.id)
  _         -> pcs_read_outside_lambda_ps(b, xp_positions_kind(e.kind))
}

fn pcs_read_outside_lambda_ps(b: Binder, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(r, c), ...rest] -> (match r { XLam -> false  _ -> pcs_read_outside_lambda(b, c) }) or pcs_read_outside_lambda_ps(b, rest)
}

#[doc("True when `e` is the binder `l` read bare.")]
pub fn pcs_is_bare(l: LocalId, e: Expr) : Bool = match e.kind {
  ELocal(u) -> local_eq(u, l)
  _         -> false
}

#[doc("True when `l` is passed bare as one of `xs`.")]
pub fn pcs_any_arg_is_var(l: LocalId, xs: [Expr]) : Bool = match xs {
  []           -> false
  [h, ...rest] -> pcs_is_bare(l, h) or pcs_any_arg_is_var(l, rest)
}

#[doc("True when `l` is passed bare as one of `xs`, seen through a unit coercion, which is identity at runtime.")]
pub fn pcs_any_arg_bare(l: LocalId, xs: [Expr]) : Bool = match xs {
  []           -> false
  [h, ...rest] -> pcs_is_bare(l, prc_peel_unit(h)) or pcs_any_arg_bare(l, rest)
}

#[doc("True when one of `xs` reads `b` outside its lambda bodies.")]
pub fn pcs_any_arg_mentions(b: Binder, xs: [Expr]) : Bool = match xs {
  []           -> false
  [h, ...rest] -> pcs_read_outside_lambda(b, h) or pcs_any_arg_mentions(b, rest)
}
