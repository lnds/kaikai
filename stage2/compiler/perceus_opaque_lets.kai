#[doc("""
Lets bound to the result of a function returning an opaque handle.
""")]

import compiler.ast
import compiler.perceus_borrow_strip

fn pcs_has_fn(fs: [FnId], f: FnId) : Bool = match fs {
  []           -> false
  [h, ...rest] -> fnid_eq(h, f) or pcs_has_fn(rest, f)
}

#[doc("""
Names bound by `let x = f(...)` where `f` returns an opaque handle —
the candidate set for the opaque move-at-last-use. Walks block/if/
match/lambda bodies for such bindings.
""")]
pub fn pcs_collect_opaque_let_binders(e: Expr, opaque_ret_fns: [FnId], acc: [Binder]) : [Binder] =
  pcs_olb_kind(e.kind, opaque_ret_fns, acc)

fn pcs_olb_kind(k: ExprKind, ofns: [FnId], acc: [Binder]) : [Binder] = match k {
  EBlock(stmts, tail) -> {
    let a1 = pcs_olb_stmts(stmts, ofns, acc)
    match tail { None -> a1 Some(e) -> pcs_collect_opaque_let_binders(e, ofns, a1) }
  }
  EIf(c, t, oe) -> {
    let a1 = pcs_collect_opaque_let_binders(t, ofns, pcs_collect_opaque_let_binders(c, ofns, acc))
    match oe { None -> a1 Some(e2) -> pcs_collect_opaque_let_binders(e2, ofns, a1) }
  }
  EMatch(s, arms) -> pcs_olb_arms(arms, ofns, pcs_collect_opaque_let_binders(s, ofns, acc))
  ELambda(_, body) -> pcs_collect_opaque_let_binders(body, ofns, acc)
  _ -> acc
}

fn pcs_olb_stmts(stmts: [Stmt], ofns: [FnId], acc: [Binder]) : [Binder] = match stmts {
  []           -> acc
  [s, ...rest] -> {
    let a1 = match s {
      SLet(pat, _, rhs) -> match pat.pkind {
        PBind(nm) -> if pcs_rhs_calls_opaque_fn(rhs, ofns) { [nm, ...pcs_collect_opaque_let_binders(rhs, ofns, acc)] }
                     else { pcs_collect_opaque_let_binders(rhs, ofns, acc) }
        _ -> pcs_collect_opaque_let_binders(rhs, ofns, acc)
      }
      SExprStmt(e) -> pcs_collect_opaque_let_binders(e, ofns, acc)
      _ -> acc
    }
    pcs_olb_stmts(rest, ofns, a1)
  }
}

fn pcs_olb_arms(arms: [Arm], ofns: [FnId], acc: [Binder]) : [Binder] = match arms {
  []           -> acc
  [Arm(_, _, b), ...rest] -> pcs_olb_arms(rest, ofns, pcs_collect_opaque_let_binders(b, ofns, acc))
}

fn pcs_rhs_calls_opaque_fn(rhs: Expr, ofns: [FnId]) : Bool = match rhs.kind {
  ECall(f, _) -> pcs_has_fn(ofns, pcs_callee_key(f))
  _           -> false
}
