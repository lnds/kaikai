#[doc("The context that decides whether a call can unwind, and its lookups.")]

import compiler.ast
import compiler.util
import compiler.unwind_clauses

#[doc("""
What decides whether a call can unwind: the declared effects by name
and by id, every declared fn with the class of its row, the ids of the
effects that can unwind and their names, whether every effect can, the
types that can carry a closure, and the fns that install a handler.

Identity is the id. The names serve the two nodes that carry none: a
parameter's written type, and a callee spelled with a qualifier.
""")]
pub type UnwCx = { effs: [String], eff_ids: [Int], fns: Array[[UnwFn]], unw: [Int], unw_spelled: [String], all: Bool, carriers: [String], handles: [String] }

#[doc("""
A declared fn, by its identity key, the class of its row (1 can unwind,
2 is open with nothing that can, so the call unwinds only through what
its arguments bring, 0 cannot) and the positions of the parameters it
borrows.
""")]
pub type UnwFn = UF(String, Int, [Int])

#[doc("A context that finds no call able to unwind.")]
pub fn unw_cx_empty() : UnwCx = UnwCx { effs: [], eff_ids: [], fns: array_make(1, []), unw: [], unw_spelled: [], all: false, carriers: [], handles: [] }

#[doc("The class of a declared row: 1 can unwind, 2 is open with nothing that can, 0 cannot.")]
pub fn unw_row_class(row: RowExpr, ucx: UnwCx) : Int = match row {
  REmpty       -> 0
  RClosed(ls)  -> if unw_labels(ls, false, ucx) { 1 } else { 0 }
  ROpen(_, ls) -> if unw_labels(ls, false, ucx) { 1 } else { 2 }
}

#[doc("The bucket of `n` in a table of `size` buckets.")]
pub fn unw_bucket(n: String, size: Int) : Int = uc_hash(n, 0, 0) % size

# Kept below 2^20 at every step, so the hash never leaves the immediate range.
fn uc_hash(s: String, i: Int, h: Int) : Int =
  if i >= string_length(s) { h } else { uc_hash(s, i + 1, (h * 31 + string_byte_at_int(s, i)) % 1048573) }

#[doc("True when a call through a value of type `t` can unwind; an unknown type can.")]
pub fn unw_ty_unwinds(t: Option[Ty], ucx: UnwCx) : Bool = match t {
  Some(TyFnT(_, _, row)) -> match row.tail {
    Some(_) -> true
    None    -> uc_labels_unwind(row.labels, ucx)
  }
  _ -> true
}

fn uc_labels_unwind(ls: [Label], ucx: UnwCx) : Bool = match ls {
  [] -> false
  [l, ...rest] -> unw_effect_unwinds(l.sym, ucx) or uc_labels_unwind(rest, ucx)
}

#[doc("The class of the fn whose identity key is `k`: 1 can unwind, 2 is open, 0 cannot, -1 when no fn has it.")]
pub fn unw_fn_class(k: String, ucx: UnwCx) : Int = uc_best(ucx.fns[unw_bucket(k, array_length(ucx.fns))], k, 0 - 1)

#[doc("The class of two, the one that can unwind first.")]
pub fn unw_class_max(a: Int, b: Int) : Int =
  if a == 1 or b == 1 { 1 } else if a == 2 or b == 2 { 2 } else if a == 0 or b == 0 { 0 } else { 0 - 1 }

fn uc_best(fs: [UnwFn], n: String, acc: Int) : Int = match fs {
  [] -> acc
  [UF(m, c, _), ...rest] -> if m != n { uc_best(rest, n, acc) } else { uc_best(rest, n, unw_class_max(c, acc)) }
}

#[doc("The positions of the parameters the fn whose identity key is `k` borrows: none when no fn has it.")]
pub fn unw_fn_borrows(k: String, ucx: UnwCx) : [Int] = uc_borrows(ucx.fns[unw_bucket(k, array_length(ucx.fns))], k)

fn uc_borrows(fs: [UnwFn], n: String) : [Int] = match fs {
  [] -> []
  [UF(m, _, bs), ...rest] -> if m == n { bs } else { uc_borrows(rest, n) }
}

#[doc("True when a perform of the effect `s` can unwind.")]
pub fn unw_effect_unwinds(s: SymId, ucx: UnwCx) : Bool = ucx.all or unw_has_id(ucx.unw, s)

#[doc("True when a perform spelled on the effect name `e` can unwind: for a callee that carries no effect id.")]
pub fn unw_spelled_unwinds(e: String, ucx: UnwCx) : Bool = ucx.all or list_has(ucx.unw_spelled, unw_bare_effect(e))

#[doc("True when `s` is the id of a declared effect: a call whose callee carries it is a perform.")]
pub fn unw_is_effect(ucx: UnwCx, s: SymId) : Bool = unw_has_id(ucx.eff_ids, s)

#[doc("True when `t` names a declared effect: a capability parameter, never owned.")]
pub fn unw_is_cap_param(ucx: UnwCx, t: Option[TypeExpr]) : Bool = match t {
  Some(te) -> match te.tkind {
    TyName(_, n, _) -> list_has(ucx.effs, n)
    _            -> false
  }
  None -> false
}

#[doc("True when a row with the labels `ls`, open or not, can unwind.")]
pub fn unw_labels(ls: [RowLabel], open: Bool, ucx: UnwCx) : Bool =
  if ucx.all { open or ls != [] }
  else { open or any(ls, (l) => unw_has_id(ucx.unw, rl_sym(l))) }
