#[doc("""
The checks on `extern "kai"` declarations as parsed: where one may appear,
and the manifest line each contributes to the reviewed list of declared
core builtins.
""")]

import compiler.util
import compiler.ast
import compiler.diag
import compiler.diag_file
import compiler.type_text
import compiler.core_prims

#[doc("An error for every `extern \"kai\"` declaration in `ds` whose source file, resolved through `df`, is not a core module by `is_core`, and for every declaration of a builtin whose `_borrow` sibling the ownership passes pick by name.")]
pub fn kai_builtin_decl_diags(ds: [Decl], df: DiagFiles, is_core: (String) -> Bool) : [Diagnostic] = match ds {
  []           -> []
  [d, ...rest] -> match kai_decl_site(d) {
    Some(site) -> list_append(kai_site_diags(site, decl_diag_file(d, df), is_core), kai_builtin_decl_diags(rest, df, is_core))
    None       -> kai_builtin_decl_diags(rest, df, is_core)
  }
}

# The name and position of an `extern "kai"` declaration, lowered or not.
type KaiSite = KS(String, Int, Int)

fn kai_decl_site(d: Decl) : Option[KaiSite] = match d {
  DAxiom(_, Some(AbiKai), name, _, _, _, _, _, l, c) -> Some(KS(name, l, c))
  DFn(_, name, _, _, _, _, body, l, c, _, _) -> match body.kind {
    EExternBody(AbiKai, _) -> Some(KS(name, l, c))
    _                      -> None
  }
  DDoc(_, _, inner, _, _) -> kai_decl_site(inner)
  DAttr(_, inner, _, _)   -> kai_decl_site(inner)
  _                       -> None
}

# `is_core` resolves the path, so it runs only at a declaration.
fn kai_site_diags(site: KaiSite, file: String, is_core: (String) -> Bool) : [Diagnostic] = match site {
  KS(name, l, c) ->
    if not is_core(file) {
      [mk_diag(SevError, file, l, c, cat3("`extern \"kai\" fn ", name, "` declares a core builtin, which only the core modules may do"), [])]
    } else { match core_borrow_variant(name) {
      Some(b) -> [mk_diag(SevError, file, l, c, concat_all(["`extern \"kai\" fn ", name, "` cannot be declared: the ownership passes rewrite its calls to `", b, "` by name"]), [])]
      None    -> []
    } }
}

#[doc("One manifest line per `extern \"kai\"` declaration among the loaded core decls `ds`: `<name> <symbol> <arity> <signature>`, the signature as written, row included.")]
pub fn kai_builtin_manifest(ds: [Decl]) : [String] = match ds {
  []           -> []
  [d, ...rest] -> match kai_manifest_line(d) {
    Some(l) -> [l, ...kai_builtin_manifest(rest)]
    None    -> kai_builtin_manifest(rest)
  }
}

fn kai_manifest_line(d: Decl) : Option[String] = match d {
  DFn(_, name, tps, ps, Some(ret), row, body, _, _, _, _) -> match body.kind {
    EExternBody(AbiKai, sym) ->
      Some(concat_all([name, " ", sym, " ", int_to_string(list_length(ps)), " ", kai_scheme_text(tps, ps, ret, row)]))
    _ -> None
  }
  DDoc(_, _, inner, _, _) -> kai_manifest_line(inner)
  DAttr(_, inner, _, _)   -> kai_manifest_line(inner)
  _                       -> None
}

fn kai_scheme_text(tps: [String], ps: [Param], ret: TypeExpr, row: RowExpr) : String = {
  let tp_s = match tps { [] -> "" _ -> concat_all(["[", join_with(tps, ", "), "]"]) }
  let row_s = match row { REmpty -> "" _ -> cat2(" / ", row_text(row)) }
  concat_all([tp_s, "(", join_with(map(ps, kai_param_text), ", "), ") : ", type_text(ret), row_s])
}

fn kai_param_text(p: Param) : String = match p.ptype {
  Some(t) -> concat_all([p.pname, ": ", type_text(t)])
  None    -> p.pname
}
