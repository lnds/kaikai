#[doc("Typing of call arguments: each argument is walked with the declared parameter it fills, so the expected type reaches literals, lambdas and Vec contexts.")]

import compiler.diag
import compiler.ast
import compiler.written
import compiler.decl_names
import compiler.infer_unit_alias
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.infer_clause_holes
import compiler.infer_local_mutation
import compiler.infer_arms_vec
import compiler.infer_env_exhaust
import compiler.infer_dump_text
import compiler.infer_apply
import compiler.infer_tparam_escape
import compiler.infer_values

#[doc("Typer-internal helper `synth_many` shared across the infer modules.")]
pub fn synth_many(st: InferState, es: [Expr]) : InferredList / Console + File + Mutable {


  match es {
    [] -> InferredList { st: st, tys: [], exprs: [] }
    [x, ...rest] -> {
      let r = w_synth(st, x)
      let rr = synth_many(r.st, rest)
      InferredList { st: rr.st, tys: [r.ty, ...rr.tys], exprs: [r.expr, ...rr.exprs] }
    }
  }
}


# Like `synth_many`, but each argument is paired with the declared
# parameter type at the same position (`param_tys`), which it is
# synthesised against; a missing expected type is a no-op.
#[doc("Typer-internal helper `synth_many_threaded` shared across the infer modules.")]
pub fn synth_many_threaded(st: InferState, es: [Expr],
                        param_tys: [Ty]) : InferredList / Console + File + Mutable {
  match es {
    [] -> InferredList { st: st, tys: [], exprs: [] }
    [x, ...rest] -> {
      let exp = match param_tys { [pt, ...] -> Some(apply_ty(st.sub, pt))  _ -> None }
      let prest = match param_tys { [_, ...pr] -> pr  _ -> [] }
      let r = synth_threaded_arg(st, x, exp)
      let rr = synth_many_threaded(st_settle_arg(r.st, exp, r.ty, rest, prest), rest, prest)
      InferredList { st: rr.st, tys: [r.ty, ...rr.tys], exprs: [r.expr, ...rr.exprs] }
    }
  }
}


fn synth_threaded_arg(st: InferState, x: Expr,
                       exp: Option[Ty]) : Inferred / Console + File + Mutable =
  match exp {
    Some(et) ->
      if arg_wants_vec_context(x, et) {
        w_check_against(st, x, et, "argument", x.line, x.col)
      } else { synth_expecting(st, x, et) }
    None -> w_synth(st, x)
  }


# `synth_many` with the callee's declared params threaded per position.
# The expected type routes a Vec-context arg (literal / collect) through
# the bidirectional check, coins a dimensioned numeric literal to the
# parameter's declared carrier (`10.50<USD>` against `Decimal<USD>`), and
# names the record a bare literal head builds; every other arg keeps the
# plain synth path.
#[doc("Typer-internal helper `synth_many_vec_args` shared across the infer modules.")]
pub fn synth_many_vec_args(st: InferState, es: [Expr], param_tys: [Ty]) : InferredList / Console + File + Mutable =
  match es {
    [] -> InferredList { st: st, tys: [], exprs: [] }
    [x, ...rest] -> {
      let exp = match param_tys { [pt, ...] -> Some(apply_ty(st.sub, pt))  _ -> None }
      let prest = match param_tys { [_, ...pr] -> pr  _ -> [] }
      let r = vec_arg(st, x, exp)
      let lowered = lowered_arg(r, exp, st)
      let rr = synth_many_vec_args(st_settle_arg(r.st, exp, lowered.ty, rest, prest), rest, prest)
      InferredList { st: rr.st, tys: [lowered.ty, ...rr.tys], exprs: [lowered.expr, ...rr.exprs] }
    }
  }


fn vec_arg(st: InferState, x: Expr, exp: Option[Ty]) : Inferred / Console + File + Mutable =
  match exp {
    Some(et) -> if arg_wants_vec_context(x, et) { w_check_against(st, x, et, "argument", x.line, x.col) } else { synth_expecting(st, x, et) }
    None     -> w_synth(st, x)
  }


fn lowered_arg(r: Inferred, exp: Option[Ty], st: InferState) : ExprTy =
  match exp {
    Some(et) -> maybe_lower_decimal_lit(r.expr, r.ty, et, mint_bigint_home(st.env))
    None     -> ExprTy { expr: r.expr, ty: r.ty }
  }


# `synth_many` with each argument's declared parameter in hand, where no
# other context rule applies: a record literal's head is asked of it.
#[doc("Typer-internal helper `synth_many_expecting` shared across the infer modules.")]
pub fn synth_many_expecting(st: InferState, es: [Expr], param_tys: [Ty]) : InferredList / Console + File + Mutable = match es {
  [] -> InferredList { st: st, tys: [], exprs: [] }
  [x, ...rest] -> {
    let exp = match param_tys { [pt, ...] -> Some(apply_ty(st.sub, pt))  _ -> None }
    let r = match exp {
      Some(et) -> synth_expecting(st, x, et)
      None     -> w_synth(st, x)
    }
    let prest = params_after_first(param_tys)
    let rr = synth_many_expecting(st_settle_arg(r.st, exp, r.ty, rest, prest), rest, prest)
    InferredList { st: rr.st, tys: [r.ty, ...rr.tys], exprs: [r.expr, ...rr.exprs] }
  }
}
