#[doc("""Name helpers for the typer's effect-usage walker.

Splits qualified `Eff.op` spellings, and filters the compiler-internal
names the `--effects-json` report must not surface.
""")]

import compiler.util

#[doc("infer: true for compiler-internal names the effect report must not surface.")]
pub fn effects_skip_internal(name: String) : Bool =
  effects_starts_with_underscore_pair(name)

#[doc("infer: true when a name opens with a double underscore.")]
pub fn effects_starts_with_underscore_pair(name: String) : Bool {
  match char_at(name, 0) {
    Some(c0) -> if c0 == '_' {
      match char_at(name, 1) {
        Some(c1) -> c1 == '_'
        None     -> false
      }
    } else { false }
    None -> false
  }
}

# Walker over typed Expr — collects (a) every effect whose op is
# called via `EVar("Eff.op")` (post-desugar_op_calls form), and
# (b) every EHandle's effect+location. Recurse via inf_map_expr_kind
# for the structural cases; explicit cases for EVar (the source of
# truth) and EHandle (handler installation).
#[doc("infer: effect part of a qualified `Eff.op` spelling, if any.")]
pub fn effects_split_qualified(name: String) : Option[String] {
  if effects_starts_with_underscore_pair(name) { None }
  else { effects_find_dot(name, 0, string_length(name)) }
}

# Effect names are uppercase, so a lowercase head means the dot was a
# record projection (`list.length`), not a qualified operation.
#[doc("infer: true when a name opens with an uppercase letter.")]
pub fn effects_starts_upper(name: String) : Bool =
  match char_at(name, 0) {
    Some(p) -> p >= 'A' and p <= 'Z'
    None    -> false
  }

#[doc("infer: scan for the qualifying dot in an operation name.")]
pub fn effects_find_dot(name: String, i: Int, n: Int) : Option[String] {
  if i >= n { None }
  else {
    match char_at(name, i) {
      Some(c) -> {
        if c == '.' {
          let prefix = string_slice(name, 0, i)
          if effects_starts_upper(prefix) { Some(prefix) } else { None }
        } else {
          effects_find_dot(name, i + 1, n)
        }
      }
      None -> None
    }
  }
}

#[doc("infer: append an effect label unless the list already carries it.")]
pub fn effects_add_unique(eff: String, effs: [String]) : [String] {
  if list_has(effs, eff) { effs } else { list_append(effs, [eff]) }
}
