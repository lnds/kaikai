#[doc("""Name helpers for the typer's effect-usage walker.

Accumulates effect labels without repeats.
""")]

import compiler.util

#[doc("infer: append an effect label unless the list already carries it.")]
pub fn effects_add_unique(eff: String, effs: [String]) : [String] {
  if list_has(effs, eff) { effs } else { list_append(effs, [eff]) }
}
