#[doc("Which declaration a typed call site calls, and what reaches its parameters: the identity a contract check discharges against.")]

import compiler.ast
import compiler.decl_names
import compiler.symtab_build

#[doc("A call resolved by identity: the callee's declaration id and node, the arguments as written, and the lambda binders those arguments may mention with the values bound to them.")]
pub type CallTarget = CallTarget(SymId, Expr, [Expr], [String], [Expr])

#[doc("A module constant's declaration id and its defining expression.")]
pub type ConstVal = ConstVal(SymId, Expr)

#[doc("The callee's id and arguments of a typed call; an immediately applied lambda whose body is a call is seen through, its parameters bound to the applied arguments.")]
pub fn call_target(callee: Expr, args: [Expr]) : Option[CallTarget] = match callee.kind {
  ELambda(params, body) -> match body.kind {
    ECall(f, inner) -> match callee_id(f) {
      Some(id) -> Some(CallTarget(id, f, inner, param_names(params), args))
      None -> None
    }
    _ -> None
  }
  _ -> match callee_id(callee) {
    Some(id) -> Some(CallTarget(id, callee, args, [], []))
    None -> None
  }
}

#[doc("The declaration a callee names: the id a resolved reference carries, or, for a callee still spelled by its home, the function that home declares under the name. A local binder and any other shape name none.")]
pub fn callee_id(f: Expr) : Option[SymId] = match f.kind {
  ESym(id, _, _) -> if sym_raw(id) >= 0 { Some(id) } else { None }
  EModCall(home, name) -> Some(sym_derive(NCFn, name, home))
  _ -> None
}

#[doc("A reference to the function the module homed at `home` declares as `name`: what a pass that picked a home writes, so nothing below re-derives the declaration from the two spellings.")]
pub fn home_fn_ref(home: String, name: String) : ExprKind = ESym(sym_derive(NCFn, name, home), spec_none(), name)

#[doc("The function instance a callee names: `callee_id` with the specialisation a resolved reference carries; a callee spelled by its home names the declaration itself.")]
pub fn callee_fnid(f: Expr) : Option[FnId] = match f.kind {
  ESym(id, inst, _) -> if sym_raw(id) >= 0 { Some(FnId(id, inst)) } else { None }
  EModCall(_, _)    -> match callee_id(f) {
    Some(id) -> Some(fnid_decl(id))
    None     -> None
  }
  _ -> None
}

fn param_names(ps: [Param]) : [String] = match ps {
  [] -> []
  [p, ...rest] -> [p.pname, ...param_names(rest)]
}

#[doc("Every module constant of a program with a declaration id.")]
pub fn collect_const_vals(decls: [Decl]) : [ConstVal] = match decls {
  [] -> []
  [d, ...rest] -> match d {
    DConst(_, _, _, value, _, _, _, id) ->
      if sym_raw(id) >= 0 { [ConstVal(id, value), ...collect_const_vals(rest)] }
      else { collect_const_vals(rest) }
    _ -> collect_const_vals(rest)
  }
}

#[doc("Replace each constant reference in an arithmetic expression by its defining expression, so a closed value folds.")]
pub fn fold_const_refs(e: Expr, consts: [ConstVal]) : Expr = fold_refs(e, consts, list_length(consts))

# `fuel` bounds the unfolding depth: a constant defined through others
# unfolds at most once per constant, so a cycle cannot loop.
fn fold_refs(e: Expr, consts: [ConstVal], fuel: Int) : Expr = match e.kind {
  ESym(id, _, _) -> match const_value(consts, id) {
    Some(v) -> if fuel > 0 { fold_refs(v, consts, fuel - 1) } else { e }
    None -> e
  }
  EBinop(op, a, b) -> mk_expr(EBinop(op, fold_refs(a, consts, fuel), fold_refs(b, consts, fuel)), e.line, e.col)
  EUnop(op, x) -> mk_expr(EUnop(op, fold_refs(x, consts, fuel)), e.line, e.col)
  _ -> e
}

fn const_value(consts: [ConstVal], id: SymId) : Option[Expr] = match consts {
  [] -> None
  [ConstVal(k, v), ...rest] -> if sym_raw(k) == sym_raw(id) { Some(v) } else { const_value(rest, id) }
}
