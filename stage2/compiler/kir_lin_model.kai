#[doc("The model the KIR linearity check runs over: the control-flow graph, the reference ledger and each op's take/borrow contract.")]

import compiler.kir
import compiler.util
import compiler.ast
import compiler.ast_ids
import compiler.ast_ids
import compiler.operators
import compiler.kir_syms
import compiler.name_report

#[doc("The facts of one function's CFG, indexed by block label.")]
pub(pkg) type LinCfg = { blocks: [KBlock], live: [(String, [String])], doomed: [String] }

#[doc("The CFG facts of `f`.")]
pub(pkg) fn klc_build(f: KFn) : LinCfg = {
  let pnames = map(f.params, (p) => p.name)
  let ud = map(f.blocks, (b) => (b.label, klc_uses_defs(b, pnames)))
  LinCfg { blocks: f.blocks, live: klc_live(f.blocks, ud, map(f.blocks, (b) => (b.label, []))), doomed: klc_doomed(f.blocks, []) }
}

#[doc("The labels `t` can branch to.")]
pub(pkg) fn klc_succ(t: KTerm) : [String] = match t {
  KBr(l, _)             -> [l]
  KCondBr(_, a, b, _)   -> [a, b]
  KSwitch(_, cs, d, _)  -> list_append(map(cs, (c) => match c { KC(_, l) -> l }), [d])
  _                     -> []
}

#[doc("The block labelled `l`, if any.")]
pub(pkg) fn klc_block(cfg: LinCfg, l: String) : Option[KBlock] = klc_find(cfg.blocks, l)

fn klc_find(bs: [KBlock], l: String) : Option[KBlock] = match bs {
  []           -> None
  [b, ...rest] -> if b.label == l { Some(b) } else { klc_find(rest, l) }
}

#[doc("The registers live on entry to block `l`.")]
pub(pkg) fn klc_live_at(cfg: LinCfg, l: String) : [String] = klc_lookup(cfg.live, l)

#[doc("True when every path out of block `l` ends in `unreachable`.")]
pub(pkg) fn klc_is_doomed(cfg: LinCfg, l: String) : Bool = list_has(cfg.doomed, l)

fn klc_lookup(xs: [(String, [String])], l: String) : [String] = match xs {
  []                -> []
  [(k, v), ...rest] -> if k == l { v } else { klc_lookup(rest, l) }
}

# --- uses and defs -------------------------------------------------------

# Registers read before any def in the block, and the registers it defines.
# A loop back-edge reads every param it does not rebind.
fn klc_uses_defs(b: KBlock, pnames: [String]) : ([String], [String]) = {
  let (uses, defs) = klc_stmts_ud(b.stmts, [], [])
  let tu = filter(klc_term_reads(b.term, pnames), (n) => not list_has(defs, n))
  (list_append(uses, tu), defs)
}

fn klc_stmts_ud(ss: [KStmt], uses: [String], defs: [String]) : ([String], [String]) = match ss {
  []           -> (uses, defs)
  [s, ...rest] -> {
    let reads = filter(klc_stmt_reads(s), (n) => not list_has(defs, n))
    klc_stmts_ud(rest, list_append(uses, reads), list_append(defs, klc_stmt_defs(s)))
  }
}

fn klc_stmt_defs(s: KStmt) : [String] = match s {
  KLet(x, _, _, _)   -> [x]
  KStore(x, _, _)    -> [x]
  KBindEvState(_, _, rs, _) -> rs
  KBindSelfState(rs, _)     -> rs
  _                  -> []
}

#[doc("The registers a statement reads.")]
pub(pkg) fn klc_stmt_reads(s: KStmt) : [String] = match s {
  KLet(_, _, op, _)          -> klc_op_reads(op)
  KDo(op, _)                 -> klc_op_reads(op)
  KRC(rc, _)                 -> klc_rc_reads(rc)
  KStore(_, v, _)            -> klc_vars([v])
  KInstall(_, _, st, _, _, _) -> match st { Some(v) -> klc_vars([v])  None -> [] }
  _                          -> []
}

fn klc_rc_reads(rc: KRCOp) : [String] = match rc {
  KDup(v)                -> klc_vars([v])
  KDrop(v)               -> klc_vars([v])
  KFreeToken(v)          -> klc_vars([v])
  KIncrefIfShared(a, b)  -> klc_vars([a, b])
  KArmTopReuse(v, _, _, _) -> klc_vars([v])
  KArmTokenFree          -> []
  KArmTake(v, bs, _)     -> klc_vars([v, ...bs])
}

#[doc("The registers an op reads.")]
pub(pkg) fn klc_op_reads(op: KOp) : [String] = klc_vars(klc_op_atoms(op))

fn klc_op_atoms(op: KOp) : [KVal] = match op {
  KCall(_, xs)                  -> xs
  KCallIndirect(f, xs)          -> [f, ...xs]
  KCallIndirectBorrow(f, xs)    -> [f, ...xs]
  KPrim(_, xs)                  -> xs
  KCon(_, _, _, inits, _)       -> map(inits, klc_init_val)
  KRecord(fs, _, _)             -> map(fs, (fi) => match fi { KFI(_, v) -> v })
  KConReuse(_, d, _, _, inits)  -> [d, ...map(inits, klc_init_val)]
  KRecordReuse(d, fs, _, _)     -> [d, ...map(fs, (fi) => match fi { KFI(_, v) -> v })]
  KTokenSteal(v, _)             -> [v]
  KProj(v, _)                   -> [v]
  KProjBorrow(v, _)             -> [v]
  KProjKind(v, _, _)            -> [v]
  KTagOf(v)                     -> [v]
  KClosure(_, _, xs)            -> xs
  KPerform(_, _, _, _, xs)      -> xs
  KSetjmp(_, _)                 -> []
  KResumeOp(k, a)               -> [k, a]
  KResume2Op(k, a, s)           -> [k, a, s]
  KLitOp(v)                     -> [v]
}

#[doc("The atom a constructor slot is initialised with.")]
pub(pkg) fn klc_init_val(i: KSlotInit) : KVal = match i {
  SIBoxed(v) -> v
  SIInt64(v) -> v
  SIReal(v)  -> v
  SIEnum(v)  -> v
}

fn klc_term_reads(t: KTerm, pnames: [String]) : [String] = match t {
  KRet(v, _)                                -> klc_vars([v])
  KCondBr(v, _, _, _)                       -> klc_vars([v])
  KSwitch(v, _, _, _)                       -> klc_vars([v])
  KTcrecGoto(_, asg, _, _)                  -> list_append(klc_vars(map(asg, klc_asg_val)), pnames)
  KTrmcStep(_, _, _, _, _, _, hs, asg, _, _) -> list_append(klc_vars(list_append(hs, map(asg, klc_asg_val))), pnames)
  KTrmcApply(v, _)                          -> klc_vars([v])
  _                                         -> []
}

#[doc("The value a loop back-edge assigns.")]
pub(pkg) fn klc_asg_val(a: KAssign) : KVal = match a { KAsg(_, v) -> v }

fn klc_vars(vs: [KVal]) : [String] = match vs {
  []           -> []
  [v, ...rest] -> match v {
    KVar(n) -> [n, ...klc_vars(rest)]
    _       -> klc_vars(rest)
  }
}

# --- liveness and doomed blocks ------------------------------------------

fn klc_live(bs: [KBlock], ud: [(String, ([String], [String]))], cur: [(String, [String])]) : [(String, [String])] = {
  let next = map(bs, (b) => (b.label, klc_live_in(b, ud, cur)))
  if klc_same(next, cur) { cur } else { klc_live(bs, ud, next) }
}

fn klc_live_in(b: KBlock, ud: [(String, ([String], [String]))], cur: [(String, [String])]) : [String] = {
  let (uses, defs) = klc_ud_of(ud, b.label)
  let out = klc_union_all(map(klc_succ(b.term), (s) => klc_lookup(cur, s)))
  klc_union(uses, filter(out, (n) => not list_has(defs, n)))
}

fn klc_ud_of(ud: [(String, ([String], [String]))], l: String) : ([String], [String]) = match ud {
  []                 -> ([], [])
  [(k, v), ...rest]  -> if k == l { v } else { klc_ud_of(rest, l) }
}

fn klc_same(a: [(String, [String])], b: [(String, [String])]) : Bool = match a {
  []                 -> true
  [(k, v), ...rest]  -> list_length(v) == list_length(klc_lookup(b, k)) and klc_same(rest, b)
}

fn klc_union_all(xss: [[String]]) : [String] = match xss {
  []            -> []
  [xs, ...rest] -> klc_union(xs, klc_union_all(rest))
}

fn klc_union(xs: [String], ys: [String]) : [String] = match xs {
  []           -> ys
  [x, ...rest] -> if list_has(ys, x) { klc_union(rest, ys) } else { klc_union(rest, [x, ...ys]) }
}

fn klc_doomed(bs: [KBlock], acc: [String]) : [String] = {
  let next = filter(map(bs, (b) => b.label), (l) => list_has(acc, l) or klc_dooms(bs, l, acc))
  if list_length(next) == list_length(acc) { acc } else { klc_doomed(bs, next) }
}

fn klc_dooms(bs: [KBlock], l: String, acc: [String]) : Bool = match klc_find(bs, l) {
  None    -> false
  Some(b) -> match b.term {
    KUnreachable(_) -> true
    t               -> match klc_succ(t) {
      []         -> false
      ss         -> all(ss, (s) => list_has(acc, s))
    }
  }
}

#[doc("A violation: its kind and the registers naming the object.")]
pub(pkg) type LinV = LinV(String, String)

#[doc("One path's ledger: register to object, object to owned count, the next object id, and the registers known to hold a constant Bool.")]
pub(pkg) type LinSt = { names: [(String, Int)], creds: [(Int, Int)], next: Int, consts: [(String, Bool)] }

#[doc("The count of a value the check does not track: a static, immortal or unboxed value.")]
pub(pkg) const UNTRACKED : Int = 1000000

#[doc("The empty ledger.")]
pub(pkg) fn kls_empty() : LinSt = LinSt { names: [], creds: [], next: 0, consts: [] }

#[doc("Bind `n` to a fresh object holding `c` owned references.")]
pub(pkg) fn kls_fresh(st: LinSt, n: String, c: Int) : LinSt =
  LinSt { ...st, names: kls_put(st.names, n, st.next), creds: [(st.next, c), ...st.creds], next: st.next + 1 }

#[doc("Bind `n` to a fresh object whose count is not tracked.")]
pub(pkg) fn kls_fresh_imm(st: LinSt, n: String) : LinSt = kls_fresh(st, n, UNTRACKED)

#[doc("Bind `n` to the object `src` names.")]
pub(pkg) fn kls_alias(st: LinSt, n: String, src: String) : LinSt = match kls_obj_of(st.names, src) {
  Some(o) -> LinSt { ...st, names: kls_put(st.names, n, o) }
  None    -> kls_fresh_imm(kls_fresh_imm(st, src), n)
}

#[doc("Take one owned reference from the object `n` names; a take from an object holding none is a violation.")]
pub(pkg) fn kls_take(st: LinSt, n: String, what: String) : (LinSt, [LinV]) = match kls_obj_of(st.names, n) {
  None    -> (st, [])
  Some(o) -> {
    let c = kls_cred(st, o)
    if c >= UNTRACKED { (st, []) }
    else if c <= 0 { (st, [LinV(cat2("consume-unowned:", what), n)]) }
    else { (kls_set(st, o, c - 1), []) }
  }
}

#[doc("Add one owned reference to the object `n` names.")]
pub(pkg) fn kls_dup(st: LinSt, n: String) : LinSt = match kls_obj_of(st.names, n) {
  None    -> st
  Some(o) -> {
    let c = kls_cred(st, o)
    if c >= UNTRACKED { st } else { kls_set(st, o, c + 1) }
  }
}

#[doc("Stop tracking the object `n` names.")]
pub(pkg) fn kls_untrack(st: LinSt, n: String) : LinSt = match kls_obj_of(st.names, n) {
  None    -> st
  Some(o) -> kls_set(st, o, UNTRACKED)
}

#[doc("A store of `src` into the join register `t`: the store moves one reference into a fresh object; overwriting the last name of an owned object is a violation.")]
pub(pkg) fn kls_store(st: LinSt, t: String, src: Option[String]) : (LinSt, [LinV]) =
  (kls_move_into(st, t, match src { Some(s) -> kls_obj_of(st.names, s)  None -> None }), kls_overwrite(st, t))

fn kls_overwrite(st: LinSt, t: String) : [LinV] = match kls_obj_of(st.names, t) {
  None    -> []
  Some(o) -> {
    let c = kls_cred(st, o)
    if c > 0 and c < UNTRACKED and not kls_shared(st.names, o, t) { [LinV("store-over-owned", t)] } else { [] }
  }
}

fn kls_move_into(st: LinSt, t: String, src: Option[Int]) : LinSt = match src {
  None    -> kls_fresh_imm(st, t)
  Some(o) -> {
    let c = kls_cred(st, o)
    if c >= UNTRACKED { kls_fresh_imm(st, t) }
    else if c > 0 { kls_fresh(kls_set(st, o, c - 1), t, 1) }
    else { kls_fresh(st, t, 0) }
  }
}

#[doc("Record that `n` holds the constant `b`, or forget it.")]
pub(pkg) fn kls_const(st: LinSt, n: String, b: Option[Bool]) : LinSt = {
  let rest = filter(st.consts, (kv) => match kv { (k, _) -> k != n })
  let cs = match b { Some(v) -> [(n, v), ...rest]  None -> rest }
  LinSt { ...st, consts: cs }
}

#[doc("The constant `n` is known to hold, if any.")]
pub(pkg) fn kls_const_of(st: LinSt, n: String) : Option[Bool] = kls_const_in(st.consts, n)

fn kls_const_in(cs: [(String, Bool)], n: String) : Option[Bool] = match cs {
  []                -> None
  [(k, v), ...rest] -> if k == n { Some(v) } else { kls_const_in(rest, n) }
}

# --- internals -----------------------------------------------------------

fn kls_put(xs: [(String, Int)], n: String, o: Int) : [(String, Int)] =
  [(n, o), ...filter(xs, (kv) => match kv { (k, _) -> k != n })]

#[doc("The object `n` names, if bound.")]
pub(pkg) fn kls_obj_of(xs: [(String, Int)], n: String) : Option[Int] = match xs {
  []                -> None
  [(k, o), ...rest] -> if k == n { Some(o) } else { kls_obj_of(rest, n) }
}

#[doc("The owned count of object `o`.")]
pub(pkg) fn kls_cred(st: LinSt, o: Int) : Int = kls_cred_in(st.creds, o)

fn kls_cred_in(cs: [(Int, Int)], o: Int) : Int = match cs {
  []                -> UNTRACKED
  [(k, c), ...rest] -> if k == o { c } else { kls_cred_in(rest, o) }
}

#[doc("Set object `o`'s owned count to `c`.")]
pub(pkg) fn kls_set(st: LinSt, o: Int, c: Int) : LinSt =
  LinSt { ...st, creds: [(o, c), ...filter(st.creds, (kv) => match kv { (k, _) -> k != o })] }

fn kls_shared(xs: [(String, Int)], o: Int, t: String) : Bool =
  any(xs, (kv) => match kv { (k, oo) -> oo == o and k != t })

#[doc("What an op's result holds: an owned reference, a borrowed view, an untracked value, or another register's object.")]
pub(pkg) type LinRes = LrOwn | LrView | LrImm | LrAlias(String)

#[doc("An op's effect on its operands: the atoms it consumes (with what consumed them), the atoms whose count it stops tracking, and its result.")]
pub(pkg) type LinFx = LinFx([(KVal, String)], [KVal], LinRes)

#[doc("The program's functions by symbol, for the callee side of a direct call's contract.")]
pub(pkg) type LinFns = NameIx[KSymFn]

#[doc("Index `fs` by the symbol `nm` spells each with.")]
pub(pkg) fn klo_index(nm: KNames, fs: [KFn]) : LinFns = ni_wrap(klo_fill(ksym_fns(nm, fs), ni_buckets()))

fn klo_fill(fs: [KSymFn], acc: Array[[KSymFn]]) : Array[[KSymFn]] / Mutable = match fs {
  []           -> acc
  [r, ...rest] -> klo_fill(rest, ni_add(acc, r.sym, r))
}

#[doc("The contract of `op`.")]
pub(pkg) fn klo_fx(op: KOp, fns: LinFns) : LinFx = match op {
  KCall(sym, xs)             -> LinFx(klo_call_takes(sym, xs, 0, fns), [], if klo_borrow_call(sym) { LrImm } else { LrOwn })
  KCallIndirect(f, xs)       -> LinFx([(f, "call_ind-closure"), ...klo_all(xs, "call_ind-arg")], [], LrOwn)
  KCallIndirectBorrow(_, xs) -> LinFx(klo_all(xs, "call_ind-arg"), [], LrOwn)
  KPrim(p, xs)               -> LinFx(klo_prim_takes(p, xs, 0), klo_prim_untracks(p, xs), klo_prim_res(p))
  KCon(_, _, _, inits, _)    -> match inits {
    [] -> LinFx([], [], LrImm)
    _  -> LinFx(klo_all(map(inits, klc_init_val), "con"), [], LrOwn)
  }
  KRecord(fs, _, _)          -> LinFx(klo_all(map(fs, (fi) => match fi { KFI(_, v) -> v }), "record"), [], LrOwn)
  KPerform(_, _, _, _, xs)   -> LinFx(klo_all(xs, "perform"), [], LrOwn)
  KResumeOp(_, a)            -> LinFx([(a, "resume")], [], LrOwn)
  KResume2Op(_, a, s)        -> LinFx([(a, "resume"), (s, "resume")], [], LrOwn)
  KProjKind(_, _, k)         -> LinFx([], [], if k == 2 { LrOwn } else { LrImm })
  KClosure(_, _, _)          -> LinFx([], [], LrOwn)
  KProj(_, _)                -> LinFx([], [], LrView)
  KProjBorrow(_, _)          -> LinFx([], [], LrView)
  KLitOp(v)                  -> match v {
    KVar(n) -> LinFx([], [], LrAlias(n))
    _       -> LinFx([], [], klo_lit_res(v))
  }
  _                          -> LinFx([], [], LrImm)
}

# Strings, reals and Int32/UInt32/UInt64/Int128 literals are heap cells the
# register owns; the other literals are immediate or immortal.
fn klo_lit_res(v: KVal) : LinRes = match v {
  KStrV(_)         -> LrOwn
  KRealV(_)        -> LrOwn
  KFixedV(_, TyByte) -> LrImm
  KFixedV(_, _)    -> LrOwn
  _                -> LrImm
}

#[doc("True when `op` belongs to the reuse protocol, which the check does not model.")]
pub(pkg) fn klo_is_reuse(op: KOp) : Bool = match op {
  KConReuse(_, _, _, _, _) -> true
  KRecordReuse(_, _, _, _) -> true
  KTokenSteal(_, _)        -> true
  KCall(sym, _)            -> sym == "kaix_incref_if_token_null" or sym == "kaix_take_slot"
  _                        -> false
}

fn klo_all(xs: [KVal], what: String) : [(KVal, String)] = map(xs, (x) => (x, what))

# --- direct calls --------------------------------------------------------

fn klo_call_takes(sym: String, xs: [KVal], i: Int, fns: LinFns) : [(KVal, String)] = match xs {
  []           -> []
  [x, ...rest] -> {
    let tl = klo_call_takes(sym, rest, i + 1, fns)
    if klo_callee_consumes(sym, i, fns) { [(x, cat2("call:", sym)), ...tl] } else { tl }
  }
}

fn klo_callee_consumes(sym: String, i: Int, fns: LinFns) : Bool = match klo_fn(ni_bucket(fns, sym), sym) {
  Some(f) -> match klo_nth(f.params, i) {
    Some(p) -> klo_param_owned(p)
    None    -> true
  }
  None    -> if klo_ends(sym, "_borrow") { i > 0 } else { not klo_borrow_call(sym) }
}

#[doc("True when a callee's param takes ownership of its argument.")]
pub(pkg) fn klo_param_owned(p: KParam) : Bool = match p.mode {
  KBorrow -> false
  KOwn    -> match p.origin {
    PDirect(_) -> true
    _          -> false
  }
}

fn klo_nth(ps: [KParam], i: Int) : Option[KParam] = match ps {
  []           -> None
  [p, ...rest] -> if i == 0 { Some(p) } else { klo_nth(rest, i - 1) }
}

fn klo_fn(fs: [KSymFn], sym: String) : Option[KFn] = match fs {
  []           -> None
  [r, ...rest] -> if r.sym == sym { Some(r.f) } else { klo_fn(rest, sym) }
}

fn klo_borrow_call(sym: String) : Bool =
  sym == "kaix_check_unique" or sym == "kaix_incref_if_token_null" or sym == "kaix_take_slot" or sym == "kaix_truthy" or klo_ends(sym, "_b")

# --- prims ---------------------------------------------------------------

fn klo_prim_takes(p: PrimOp, xs: [KVal], i: Int) : [(KVal, String)] = match xs {
  []           -> []
  [x, ...rest] -> {
    let tl = klo_prim_takes(p, rest, i + 1)
    let takes = not klo_prim_borrows(p) or (klo_prim_borrows_base_only(p) and i > 0)
    if takes { [(x, cat2("prim:", kprim_text(p))), ...tl] } else { tl }
  }
}

# Unboxing a scalar ends its count: the payload is all that is read on.
fn klo_prim_untracks(p: PrimOp, xs: [KVal]) : [KVal] =
  if klo_prim_unboxes_untracked(p) {
    match xs {
      [x, ..._] -> [x]
      []        -> []
    }
  } else { [] }

fn klo_prim_unboxes_untracked(p: PrimOp) : Bool = match p {
  KpUnbox(RwInt)  -> true
  KpUnbox(RwBool) -> true
  KpUnbox(RwChar) -> true
  KpUnbox(RwByte) -> true
  _               -> false
}

# A read of the inline aggregate borrows it; a read of a heap vec owns its base.
fn klo_prim_borrows(p: PrimOp) : Bool = match p {
  KpFieldBorrow           -> true
  KpVecRead(_)            -> true
  KpVecReadField(_)       -> true
  KpVecReadFieldBoxed     -> true
  KpIsCons                -> true
  KpIsNil                 -> true
  KpUnbox(_)              -> true
  KpField                 -> true
  KpFieldAt               -> true
  KpTagEq                 -> true
  KpEqRaw                 -> true
  KpFixedVecGet(r, _, _)  -> not r.heap
  _                       -> klo_prim_is_marker(p)
}

# The unwind-frame and landing-pad markers name registers without owning them.
fn klo_prim_is_marker(p: PrimOp) : Bool = match p {
  KpUnwFiber     -> true
  KpUnwPush      -> true
  KpUnwPushReg   -> true
  KpUnwPushState -> true
  KpUnwPop       -> true
  KpPadOpen      -> true
  KpPadClose     -> true
  _              -> false
}

# The borrowing reads whose operands after the base are taken.
fn klo_prim_borrows_base_only(p: PrimOp) : Bool = match p {
  KpFieldBorrow -> true
  _             -> false
}

fn klo_prim_res(p: PrimOp) : LinRes = match p {
  KpFieldBorrow -> LrView
  _             -> if klo_prim_imm(p) { LrImm } else { LrOwn }
}

fn klo_prim_imm(p: PrimOp) : Bool = match p {
  KpIsCons            -> true
  KpIsNil             -> true
  KpBox(RwReal)       -> false
  KpBox(RwInt32)      -> false
  KpBox(RwUInt32)     -> false
  KpBox(RwUInt64)     -> false
  KpBox(RwInt128)     -> false
  KpBox(_)            -> true
  KpFixedVecLit(_, _) -> true
  KpNil               -> true
  KpBin(op)           -> binop_is_comparison(op)
  KpUn(UoNot)         -> true
  KpEqRaw             -> true
  KpTagEq             -> true
  _                   -> klo_prim_is_marker(p)
}

fn klo_ends(s: String, suffix: String) : Bool = {
  let sl = string_length(s)
  let xl = string_length(suffix)
  xl <= sl and string_slice(s, sl - xl, xl) == suffix
}
