import compiler.ast

#[doc("The `?` holes inside a pattern, outermost first.")]
pub fn pattern_holes(p: Pattern) : [Pattern] = match p.pkind {
  PHole(_)              -> [p]
  PAs(_, inner)         -> pattern_holes(inner)
  PVariant(_, subs)     -> flat_map(subs, pattern_holes)
  PList(subs, _)        -> flat_map(subs, pattern_holes)
  PVariantRecord(_, fs) -> flat_map(fs, field_holes)
  PRecord(fs)           -> flat_map(fs, field_holes)
  _                     -> []
}

fn field_holes(f: PField) : [Pattern] = match f {
  PField(_, sub, _) -> pattern_holes(sub)
}
