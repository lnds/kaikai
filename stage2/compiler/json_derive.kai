#[doc("""
compiler.json_derive - the `#[derive(Json)]` impl builder.

Emits `impl Json for T { fn to_json(self) ... fn of_json(v, path) ... }`
for a record or a sum type, plus a `<lower(T)>_of_json` shim (single
dispatch cannot route on a return type; same rationale as BinSerialize's
and Layout's).

A record's `to_json` builds a `JObj` whose keys are the kaikai field
names verbatim. A sum encodes under the adjacently-tagged envelope
`{"tag": "<Variant>", "value": <payload>}` — `null` for a nullary
variant, the lone encoding for one payload, a `JArr` for several.
`of_json` reads back through the `json_bind_*` readers in
`stdlib/encoding/json_bind.kai`, threading the JSON path so a failure
names the node it happened at; a sum decode routes on `tag` and reports
an unknown tag as a located error. The absent/required and unknown-key
policies live in those readers, not here — the emitted code only picks
which reader a field/payload type calls for, and `compiler.json_shape`
is what decides which one that is.
""")]

import compiler.util
import compiler.ast
import compiler.json_shape

fn jd_expr(k: ExprKind, line: Int, col: Int) : Expr = mk_expr(k, line, col)
fn jd_var(n: String, line: Int, col: Int) : Expr = jd_expr(EVar(n), line, col)

fn jd_call(callee: String, targs: [Expr], line: Int, col: Int) : Expr =
  jd_expr(ECall(jd_var(callee, line, col), targs), line, col)

# `EStr` carries the raw source span, quotes included.
fn jd_str(s: String, line: Int, col: Int) : Expr =
  jd_expr(EStr(concat_all(["\"", s, "\""]), false), line, col)

fn jd_ty(n: String, targs: [TypeExpr], line: Int, col: Int) : TypeExpr =
  mk_ty(TyName(n, targs), line, col)

fn jd_param(name: String, ty: TypeExpr, line: Int, col: Int) : Param =
  Param { pname: name, ptype: Some(ty), pline: line, pcol: col, pborrow: false }

fn jd_result_ty(tname: String, line: Int, col: Int) : TypeExpr =
  jd_ty("Result", [jd_ty(tname, [], line, col),
                   jd_ty("JsonError", [], line, col)], line, col)

#[doc("The `#[derive(Json)]` decls for `type T`: the protocol impl plus the `of_json` shim, for a record body or a sum body under the adjacently-tagged `{\"tag\", \"value\"}` envelope. Empty when a field/payload has no JSON denotation.")]
pub fn derive_json_impl(tname: String, body: TypeBody,
                        line: Int, col: Int) : [Decl] = match body {
  TBRecord(fields) -> match jd_fields_of(fields) {
    Some(jfs) -> match jfs {
      []  -> []
      _   -> [jd_impl(tname, jfs, line, col), jd_shim(tname, line, col)]
    }
    None -> []
  }
  TBSum(variants) -> match jd_variants_of(variants) {
    Some([]) -> []
    Some(_)  -> [jd_sum_impl(tname, variants, line, col), jd_shim(tname, line, col)]
    None     -> []
  }
  _ -> []
}

# ASCII lowercaser for the shim name. Local rather than shared with
# `protos` because this module precedes it in the bundle.
fn jd_lower(s: String, i: Int, n: Int, acc: String) : String =
  if i >= n { acc } else { match char_at(s, i) {
    None -> acc
    Some(c) -> {
      let nc = char_to_int(c)
      let lc = if nc >= 65 and nc <= 90 { int_to_char(nc + 32) } else { c }
      jd_lower(s, i + 1, n, string_concat(acc, "#{lc}"))
    }
  } }

fn jd_shim_name(tname: String) : String =
  concat_all([jd_lower(tname, 0, string_length(tname), ""), "_of_json"])

fn jd_impl(tname: String, jfs: [JsonField], line: Int, col: Int) : Decl =
  jd_make_impl(tname, jd_to_json_body(jfs, line, col),
               jd_of_json_body(tname, jfs, line, col), line, col)

# The `impl Json for T` shell: same `to_json`/`of_json` signatures for a
# record or a sum, differing only in the two supplied bodies.
fn jd_make_impl(tname: String, to_body: Expr, of_body: Expr,
                line: Int, col: Int) : Decl {
  let self_ty = jd_ty(tname, [], line, col)
  let str_ty = jd_ty("String", [], line, col)
  let json_ty = jd_ty("JsonValue", [], line, col)
  let to_params = [jd_param("self", self_ty, line, col)]
  let of_params = [jd_param("v", json_ty, line, col),
                   jd_param("path", str_ty, line, col)]
  let to_method = DFn(false, "to_json", [], to_params, Some(json_ty), REmpty,
                      to_body, line, col, None)
  let of_method = DFn(false, "of_json", [], of_params,
                      Some(jd_result_ty(tname, line, col)), REmpty,
                      of_body, line, col, None)
  DImpl("Json", [], self_ty, [to_method, of_method], line, col)
}

# `fn <lower(T)>_of_json(v, path)` — the non-overloaded entry point.
# Single dispatch picks the impl from the first argument, which here is
# the DOM node, so the user cannot call `of_json` directly.
fn jd_shim(tname: String, line: Int, col: Int) : Decl {
  let params = [jd_param("v", jd_ty("JsonValue", [], line, col), line, col),
                jd_param("path", jd_ty("String", [], line, col), line, col)]
  let mangled = concat_all(["__pimpl_Json_", tname, "_of_json"])
  let body = jd_call(mangled, [jd_var("v", line, col), jd_var("path", line, col)],
                     line, col)
  DFn(true, jd_shim_name(tname),
      [], params, Some(jd_result_ty(tname, line, col)), REmpty, body, line, col, None)
}

# ---- to_json -------------------------------------------------------
#
# `JObj([Pair { fst: "<name>", snd: <encode(self.<name>)> }, ...])` in
# declaration order. Keys are the kaikai field names verbatim: the wire
# name is what the type says, with no case conversion.

fn jd_to_json_body(jfs: [JsonField], line: Int, col: Int) : Expr =
  jd_call("JObj", [jd_expr(EList(jd_pairs(jfs, line, col)), line, col)], line, col)

fn jd_pairs(jfs: [JsonField], line: Int, col: Int) : [ListElem] = match jfs {
  [] -> []
  [f, ...rest] -> match f {
    # A `#[json(skip)]` field is not written to the wire.
    JF(name, wire, shape, _, skip) ->
      if skip { jd_pairs(rest, line, col) }
      else {
        let read = jd_expr(EField(jd_var("self", line, col), name), line, col)
        let pair = jd_expr(ERecordLit("Pair",
                     [FI("fst", jd_str(wire, line, col)),
                      FI("snd", jd_encode(shape, read, line, col))]), line, col)
        [ElPlain(pair), ...jd_pairs(rest, line, col)]
      }
  }
}

fn jd_encode(shape: JsonShape, v: Expr, line: Int, col: Int) : Expr = match shape {
  JSStr  -> jd_call("JStr", [v], line, col)
  JSInt  -> jd_call("JNum", [v], line, col)
  JSReal -> jd_call("JReal", [v], line, col)
  JSBool -> jd_call("JBool", [v], line, col)
  JSRecord(rt) -> jd_call(concat_all(["__pimpl_Json_", rt, "_to_json"]), [v], line, col)
  JSList(inner) -> jd_call("json_of_list", [v, jd_encoder_fn(inner, line, col)], line, col)
  JSOpt(inner)  -> jd_call("json_of_opt", [v, jd_encoder_fn(inner, line, col)], line, col)
}

# The element encoder a list / option hands to its combinator: `(x) =>
# <encode(x)>`, so the same `jd_encode` covers nesting to any depth.
fn jd_encoder_fn(shape: JsonShape, line: Int, col: Int) : Expr {
  let p = Param { pname: "x", ptype: None, pline: line, pcol: col, pborrow: false }
  jd_expr(ELambda([p], jd_encode(shape, jd_var("x", line, col), line, col)), line, col)
}

# ---- of_json -------------------------------------------------------
#
# An object check, then a match tower with one arm per field: read the
# key, bind it or return the located error, then build the record from
# the bound names. Absence and unknown keys are the readers' business —
# the tower only threads paths. The object check comes first so a node
# of the wrong shape reports as itself instead of as every field
# going missing at once.

fn jd_of_json_body(tname: String, jfs: [JsonField], line: Int, col: Int) : Expr {
  let guard = jd_call("json_bind_object",
                [jd_var("v", line, col), jd_var("path", line, col)], line, col)
  let ok_arm = Arm(mk_pat(PVariant("Ok", [mk_pat(PWild, line, col)]), line, col),
                   None, jd_tower(tname, jfs, [], line, col))
  let err_arm = Arm(mk_pat(PVariant("Err", [mk_pat(PBind("e"), line, col)]),
                           line, col), None,
                    jd_call("Err", [jd_var("e", line, col)], line, col))
  jd_expr(EMatch(guard, [ok_arm, err_arm]), line, col)
}

fn jd_tower(tname: String, jfs: [JsonField], bound: [String],
            line: Int, col: Int) : Expr = match jfs {
  [] -> jd_call("Ok", [jd_record(tname, list_reverse(bound), line, col)], line, col)
  [f, ...rest] -> match f {
    JF(name, wire, shape, dflt, skip) ->
      if skip {
        # No wire value: reconstruct from the default, or `None` for an
        # `Option`. `let name = <value>` then continue the tower.
        let value = jd_skip_value(shape, dflt, line, col)
        jd_expr(EBlock([SLet(mk_pat(PBind(name), line, col), None, value)],
                       Some(jd_tower(tname, rest, [name, ...bound], line, col))),
                line, col)
      } else {
        let node = jd_call("json_bind_field",
                     [jd_var("v", line, col), jd_str(wire, line, col)], line, col)
        let sub = jd_call("json_path_field",
                    [jd_var("path", line, col), jd_str(wire, line, col)], line, col)
        # A `#[json(default)]` field substitutes the default when the key
        # is absent (`JNull`); an absent field with no default still errors
        # in the leaf reader, preserving #1280's required-field policy.
        let read = match dflt {
          None    -> jd_decode(shape, node, sub, line, col)
          Some(d) -> jd_default_read(shape, node, sub, d, line, col)
        }
        let ok_arm = Arm(mk_pat(PVariant("Ok", [mk_pat(PBind(name), line, col)]),
                                line, col), None,
                         jd_tower(tname, rest, [name, ...bound], line, col))
        let err_arm = Arm(mk_pat(PVariant("Err", [mk_pat(PBind("e"), line, col)]),
                                 line, col), None,
                          jd_call("Err", [jd_var("e", line, col)], line, col))
        jd_expr(EMatch(read, [ok_arm, err_arm]), line, col)
      }
  }
}

# The value a `#[json(skip)]` field takes on decode: its `#[json(default)]`
# expression, or `None` when it has none (the validator guarantees a bare
# skip is an `Option`).
fn jd_skip_value(shape: JsonShape, dflt: Option[Expr], line: Int, col: Int) : Expr =
  match dflt {
    Some(d) -> d
    None    -> jd_var("None", line, col)
  }

# `match json_bind_field(v, wire) { JNull -> Ok(<default>) ; node -> <decode> }`
# — the default stands in for an absent key, the leaf reader still handles
# a present-but-wrong-shape value.
fn jd_default_read(shape: JsonShape, node: Expr, sub: Expr, dflt: Expr,
                   line: Int, col: Int) : Expr {
  let null_arm = Arm(mk_pat(PVariant("JNull", []), line, col), None,
                     jd_call("Ok", [dflt], line, col))
  let some_arm = Arm(mk_pat(PBind("__jn"), line, col), None,
                     jd_decode(shape, jd_var("__jn", line, col), sub, line, col))
  jd_expr(EMatch(node, [null_arm, some_arm]), line, col)
}

fn jd_decode(shape: JsonShape, node: Expr, path: Expr,
             line: Int, col: Int) : Expr = match shape {
  JSStr  -> jd_call("json_bind_string", [node, path], line, col)
  JSInt  -> jd_call("json_bind_int", [node, path], line, col)
  JSReal -> jd_call("json_bind_real", [node, path], line, col)
  JSBool -> jd_call("json_bind_bool", [node, path], line, col)
  JSRecord(rt) ->
    jd_call(jd_shim_name(rt), [node, path], line, col)
  JSList(inner) ->
    jd_call("json_bind_list", [node, path, jd_decoder_fn(inner, line, col)], line, col)
  JSOpt(inner) -> jd_opt_decode(inner, node, path, line, col)
}

# The optional readers are per-leaf so `null` short-circuits before the
# leaf's shape check; a nested record or list under `Option` has no
# dedicated reader, so it goes through the generic combinator instead.
fn jd_opt_decode(inner: JsonShape, node: Expr, path: Expr,
                 line: Int, col: Int) : Expr = match inner {
  JSStr  -> jd_call("json_bind_opt_string", [node, path], line, col)
  JSInt  -> jd_call("json_bind_opt_int", [node, path], line, col)
  JSReal -> jd_call("json_bind_opt_real", [node, path], line, col)
  JSBool -> jd_call("json_bind_opt_bool", [node, path], line, col)
  JSList(elem) ->
    jd_call("json_bind_opt_list", [node, path, jd_decoder_fn(elem, line, col)], line, col)
  _ -> jd_call("json_bind_opt", [node, path, jd_decoder_fn(inner, line, col)], line, col)
}

# The element decoder a list hands to its combinator: `(x, p) =>
# <decode(x, p)>`, taking the per-element path the combinator built.
fn jd_decoder_fn(shape: JsonShape, line: Int, col: Int) : Expr {
  let px = Param { pname: "x", ptype: None, pline: line, pcol: col, pborrow: false }
  let pp = Param { pname: "p", ptype: None, pline: line, pcol: col, pborrow: false }
  let body = jd_decode(shape, jd_var("x", line, col), jd_var("p", line, col), line, col)
  jd_expr(ELambda([px, pp], body), line, col)
}

fn jd_record(tname: String, names: [String], line: Int, col: Int) : Expr =
  jd_expr(ERecordLit(tname, jd_field_inits(names, line, col)), line, col)

fn jd_field_inits(names: [String], line: Int, col: Int) : [FieldInit] = match names {
  [] -> []
  [n, ...rest] -> [FI(n, jd_var(n, line, col)), ...jd_field_inits(rest, line, col)]
}

# ==== sum types: adjacently-tagged `{"tag", "value"}` envelope =======
#
# A sum value encodes as `JObj([tag: "<Variant>", value: <payload>])`.
# The payload mirrors the variant's arity: `null` for a nullary variant,
# the single encoding for one payload, a `JArr` of the encodings for
# several. Decode reads `tag`, routes to the variant, and decodes `value`
# against that variant's payload shape — an unknown tag reports as a
# located `JsonError`, preserving #1280's structured-error policy.

# `[[JsonShape]]` — the payload shapes of every variant, or `None` when a
# payload type has no JSON denotation, which drops the whole derive.
fn jd_variants_of(variants: [Variant]) : Option[[[JsonShape]]] =
  jd_variants_loop(variants, [])

fn jd_variants_loop(variants: [Variant], acc: [[JsonShape]]) : Option[[[JsonShape]]] =
  match variants {
    [] -> Some(list_reverse(acc))
    [v, ...rest] -> match v {
      Var(_, vargs) -> match jd_payload_shapes(vargs, []) {
        Some(ss) -> jd_variants_loop(rest, [ss, ...acc])
        None     -> None
      }
    }
  }

fn jd_payload_shapes(vargs: [TypeExpr], acc: [JsonShape]) : Option[[JsonShape]] =
  match vargs {
    [] -> Some(list_reverse(acc))
    [t, ...rest] -> match jd_shape_of(t) {
      Some(s) -> jd_payload_shapes(rest, [s, ...acc])
      None    -> None
    }
  }

fn jd_sum_impl(tname: String, variants: [Variant], line: Int, col: Int) : Decl =
  jd_make_impl(tname, jd_sum_to_json_body(variants, line, col),
               jd_sum_of_json_body(tname, variants, line, col), line, col)

# ---- sum to_json ---------------------------------------------------
#
# `match self { V0 -> <envelope "V0" null>; V1(p0) -> <envelope "V1" enc(p0)>;
#  V2(p0, p1) -> <envelope "V2" JArr([enc(p0), enc(p1)])> }`.

fn jd_sum_to_json_body(variants: [Variant], line: Int, col: Int) : Expr =
  jd_expr(EMatch(jd_var("self", line, col),
                 jd_sum_encode_arms(variants, line, col)), line, col)

fn jd_sum_encode_arms(variants: [Variant], line: Int, col: Int) : [Arm] =
  match variants {
    [] -> []
    [v, ...rest] -> [jd_sum_encode_arm(v, line, col),
                     ...jd_sum_encode_arms(rest, line, col)]
  }

fn jd_sum_encode_arm(v: Variant, line: Int, col: Int) : Arm = match v {
  Var(name, vargs) -> {
    let subs = jd_bind_pats(vargs, 0, line, col)
    let pat = mk_pat(PVariant(name, subs), line, col)
    let value = jd_encode_payload(jd_shape_of_all(vargs), 0, line, col)
    Arm(pat, None, jd_envelope(name, value, line, col))
  }
}

# The wire object `JObj([Pair{tag}, Pair{value}])` for one variant.
fn jd_envelope(name: String, value: Expr, line: Int, col: Int) : Expr {
  let tag = jd_expr(ERecordLit("Pair",
              [FI("fst", jd_str("tag", line, col)),
               FI("snd", jd_call("JStr", [jd_str(name, line, col)], line, col))]),
              line, col)
  let val = jd_expr(ERecordLit("Pair",
              [FI("fst", jd_str("value", line, col)), FI("snd", value)]), line, col)
  jd_call("JObj", [jd_expr(EList([ElPlain(tag), ElPlain(val)]), line, col)], line, col)
}

# `null` for a nullary variant, the single encoding for one payload, a
# `JArr` of encodings for several.
fn jd_encode_payload(shapes: [JsonShape], i: Int, line: Int, col: Int) : Expr =
  match shapes {
    []  -> jd_var("JNull", line, col)
    [s] -> jd_encode(s, jd_var(concat_all(["p", int_to_string(i)]), line, col), line, col)
    _   -> jd_call("JArr", [jd_expr(EList(jd_encode_elems(shapes, i, line, col)), line, col)],
                   line, col)
  }

fn jd_encode_elems(shapes: [JsonShape], i: Int, line: Int, col: Int) : [ListElem] =
  match shapes {
    [] -> []
    [s, ...rest] -> {
      let e = jd_encode(s, jd_var(concat_all(["p", int_to_string(i)]), line, col), line, col)
      [ElPlain(e), ...jd_encode_elems(rest, i + 1, line, col)]
    }
  }

fn jd_bind_pats(vargs: [TypeExpr], i: Int, line: Int, col: Int) : [Pattern] =
  match vargs {
    [] -> []
    [_, ...rest] -> [mk_pat(PBind(concat_all(["p", int_to_string(i)])), line, col),
                     ...jd_bind_pats(rest, i + 1, line, col)]
  }

fn jd_shape_of_all(vargs: [TypeExpr]) : [JsonShape] = match jd_payload_shapes(vargs, []) {
  Some(ss) -> ss
  None     -> []
}

# ---- sum of_json ---------------------------------------------------
#
# Object-check, then read the `tag` string and match it to a variant.
# Each arm decodes `value` against that variant's payload; an unknown
# tag is a located `JsonError`.

fn jd_sum_of_json_body(tname: String, variants: [Variant], line: Int, col: Int) : Expr {
  let guard = jd_call("json_bind_object",
                [jd_var("v", line, col), jd_var("path", line, col)], line, col)
  let ok_arm = Arm(mk_pat(PVariant("Ok", [mk_pat(PWild, line, col)]), line, col),
                   None, jd_sum_read_tag(tname, variants, line, col))
  let err_arm = Arm(mk_pat(PVariant("Err", [mk_pat(PBind("e"), line, col)]), line, col),
                    None, jd_call("Err", [jd_var("e", line, col)], line, col))
  jd_expr(EMatch(guard, [ok_arm, err_arm]), line, col)
}

# `match json_bind_string(json_bind_field(v, "tag"), path.tag) {
#    Ok(__tag) -> <tag tower> ; Err(e) -> Err(e) }`.
fn jd_sum_read_tag(tname: String, variants: [Variant], line: Int, col: Int) : Expr {
  let node = jd_call("json_bind_field",
               [jd_var("v", line, col), jd_str("tag", line, col)], line, col)
  let tag_path = jd_call("json_path_field",
               [jd_var("path", line, col), jd_str("tag", line, col)], line, col)
  let read = jd_call("json_bind_string", [node, tag_path], line, col)
  let ok_arm = Arm(mk_pat(PVariant("Ok", [mk_pat(PBind("__tag"), line, col)]), line, col),
                   None, jd_tag_tower(tname, variants, line, col))
  let err_arm = Arm(mk_pat(PVariant("Err", [mk_pat(PBind("e"), line, col)]), line, col),
                    None, jd_call("Err", [jd_var("e", line, col)], line, col))
  jd_expr(EMatch(read, [ok_arm, err_arm]), line, col)
}

# `match __tag { "V0" -> <decode V0> ; ... ; _ -> Err(unknown) }`.
fn jd_tag_tower(tname: String, variants: [Variant], line: Int, col: Int) : Expr {
  let arms = jd_tag_arms(variants, line, col)
  let names = jd_variant_names(variants)
  let unknown = jd_call("Err",
    [jd_call("json_bind_unknown_tag",
       [jd_var("path", line, col), jd_var("__tag", line, col),
        jd_str(names, line, col)], line, col)], line, col)
  let dflt = Arm(mk_pat(PWild, line, col), None, unknown)
  jd_expr(EMatch(jd_var("__tag", line, col), list_append(arms, [dflt])), line, col)
}

fn jd_tag_arms(variants: [Variant], line: Int, col: Int) : [Arm] = match variants {
  [] -> []
  [v, ...rest] -> match v {
    Var(name, vargs) -> {
      let pat = mk_pat(PLit(jd_str(name, line, col)), line, col)
      let body = jd_variant_decode(name, jd_shape_of_all(vargs), line, col)
      [Arm(pat, None, body), ...jd_tag_arms(rest, line, col)]
    }
  }
}

# The `value` node and its path, shared by every variant decode.
fn jd_value_node(line: Int, col: Int) : Expr =
  jd_call("json_bind_field", [jd_var("v", line, col), jd_str("value", line, col)], line, col)

fn jd_value_path(line: Int, col: Int) : Expr =
  jd_call("json_path_field", [jd_var("path", line, col), jd_str("value", line, col)], line, col)

# Decode `value` for one variant against its payload shapes and build
# the constructor. Nullary ignores `value`; one payload decodes it
# directly; several read `value` as a JSON array element-by-element.
fn jd_variant_decode(name: String, shapes: [JsonShape], line: Int, col: Int) : Expr =
  match shapes {
    []  -> jd_call("Ok", [jd_var(name, line, col)], line, col)
    [s] -> {
      let read = jd_decode(s, jd_value_node(line, col), jd_value_path(line, col), line, col)
      let ok = Arm(mk_pat(PVariant("Ok", [mk_pat(PBind("p0"), line, col)]), line, col), None,
                   jd_call("Ok", [jd_call(name, [jd_var("p0", line, col)], line, col)], line, col))
      let err = Arm(mk_pat(PVariant("Err", [mk_pat(PBind("e"), line, col)]), line, col), None,
                    jd_call("Err", [jd_var("e", line, col)], line, col))
      jd_expr(EMatch(read, [ok, err]), line, col)
    }
    _ -> jd_tuple_decode(name, shapes, jd_count_shapes(shapes, 0), 0, [], line, col)
  }

# Thread `json_bind_tuple_elem(value, i, arity, path.value)` for each
# payload, then decode the element, ending in `Ok(Variant(p0, ..))`.
fn jd_tuple_decode(name: String, shapes: [JsonShape], arity: Int, i: Int,
                   bound: [String], line: Int, col: Int) : Expr = match shapes {
  [] -> {
    let args = jd_bound_args(list_reverse(bound), line, col)
    jd_call("Ok", [jd_call(name, args, line, col)], line, col)
  }
  [s, ...rest] -> {
    let elem = jd_call("json_bind_tuple_elem",
                 [jd_value_node(line, col), jd_expr(mk_int_synth(i), line, col),
                  jd_expr(mk_int_synth(arity), line, col), jd_value_path(line, col)], line, col)
    let epath = jd_call("json_path_index",
                  [jd_value_path(line, col), jd_expr(mk_int_synth(i), line, col)], line, col)
    let pname = concat_all(["p", int_to_string(i)])
    let elem_ok = Arm(mk_pat(PVariant("Ok", [mk_pat(PBind("__ev"), line, col)]), line, col), None,
                      jd_decode_elem(s, pname, rest, name, shapes, arity, i, bound, epath, line, col))
    let elem_err = Arm(mk_pat(PVariant("Err", [mk_pat(PBind("e"), line, col)]), line, col), None,
                       jd_call("Err", [jd_var("e", line, col)], line, col))
    jd_expr(EMatch(elem, [elem_ok, elem_err]), line, col)
  }
}

fn jd_decode_elem(s: JsonShape, pname: String, rest: [JsonShape], name: String,
                  shapes: [JsonShape], arity: Int, i: Int, bound: [String],
                  epath: Expr, line: Int, col: Int) : Expr {
  let read = jd_decode(s, jd_var("__ev", line, col), epath, line, col)
  let ok = Arm(mk_pat(PVariant("Ok", [mk_pat(PBind(pname), line, col)]), line, col), None,
               jd_tuple_decode(name, rest, arity, i + 1, [pname, ...bound], line, col))
  let err = Arm(mk_pat(PVariant("Err", [mk_pat(PBind("e"), line, col)]), line, col), None,
                jd_call("Err", [jd_var("e", line, col)], line, col))
  jd_expr(EMatch(read, [ok, err]), line, col)
}

fn jd_bound_args(names: [String], line: Int, col: Int) : [Expr] = match names {
  [] -> []
  [n, ...rest] -> [jd_var(n, line, col), ...jd_bound_args(rest, line, col)]
}

fn jd_count_shapes(shapes: [JsonShape], acc: Int) : Int = match shapes {
  [] -> acc
  [_, ...rest] -> jd_count_shapes(rest, acc + 1)
}

# `"A, B, C"` — the variant names for the unknown-tag error's expected set.
fn jd_variant_names(variants: [Variant]) : String = match variants {
  [] -> ""
  [v, ...rest] -> match v {
    Var(name, _) -> match rest {
      [] -> name
      _  -> concat_all([name, ", ", jd_variant_names(rest)])
    }
  }
}
