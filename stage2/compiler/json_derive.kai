#[doc("""
compiler.json_derive - the `#[derive(Json)]` impl builder.

Emits `impl Json for T { fn to_json(self) ... fn of_json(v, path) ... }`
for a record or a sum type, plus a `<lower(T)>_of_json` shim (single
dispatch cannot route on a return type; same rationale as BinSerialize's
and Layout's).

A record's `to_json` builds a `JObj` whose keys are the kaikai field
names verbatim. A sum encodes under the adjacently-tagged envelope
`{"tag": "<Variant>", "value": <payload>}` — `null` for a nullary
variant, the lone encoding for one payload, a `JArr` for several.
`of_json` reads back through the `json_bind_*` readers in
`stdlib/encoding/json_bind.kai`, threading the JSON path so a failure
names the node it happened at; a sum decode routes on `tag` and reports
an unknown tag as a located error. The absent/required and unknown-key
policies live in those readers, not here — the emitted code only picks
which reader a field/payload type calls for, and `compiler.json_shape`
is what decides which one that is.

The derived type and its constructors are named by id; everything else a
body mentions is written text the resolver settles like source.
""")]

import compiler.util
import compiler.ast
import compiler.json_shape
import compiler.decl_names
import compiler.symtab
import compiler.symtab_build
import compiler.core_protos
import compiler.derive_mint

fn jd_expr(k: ExprKind, line: Int, col: Int) : Expr = mk_expr(k, line, col)
fn jd_var(n: String, line: Int, col: Int) : Expr = mk_name(n, line, col)

fn jd_call(callee: String, targs: [Expr], line: Int, col: Int) : Expr =
  jd_expr(ECall(jd_var(callee, line, col), targs), line, col)

# The module declaring the readers and writers a derived impl calls.
fn jd_lib_home() : String = "encoding__json_bind"

# A call of one of them, by the id that module gives it: a function of
# the deriving file that shares the name is another declaration.
fn jd_lib(callee: String, targs: [Expr], line: Int, col: Int) : Expr =
  jd_expr(ECall(mk_sym(sym_derive(NCFn, callee, jd_lib_home()), line, col), targs), line, col)

fn jd_bind(n: String, line: Int, col: Int) : Pattern = mk_pat(PBind(binder_written(n)), line, col)

fn jd_ctor_pat(ctor: String, subs: [Pattern], line: Int, col: Int) : Pattern =
  mk_pat(PVariant(ref_written(ctor), subs), line, col)

# `Err(e) -> Err(e)`: the arm every threaded read re-raises through.
fn jd_err_arm(line: Int, col: Int) : Arm =
  Arm(jd_ctor_pat("Err", [jd_bind("e", line, col)], line, col), None,
      jd_call("Err", [jd_var("e", line, col)], line, col))

# `EStr` carries the raw source span, quotes included.
fn jd_str(s: String, line: Int, col: Int) : Expr =
  jd_expr(EStr(concat_all(["\"", s, "\""]), false), line, col)

fn jd_ty(n: String, targs: [TypeExpr], line: Int, col: Int) : TypeExpr =
  mk_ty(TyName(ref_written(n), targs), line, col)

fn jd_param(name: String, ty: Option[TypeExpr], line: Int, col: Int) : Param =
  Param { binder: binder_written(name), ptype: ty, pline: line, pcol: col, pborrow: false }

fn jd_result_ty(d: DeriveFor, line: Int, col: Int) : TypeExpr =
  jd_ty("Result", [derive_self_ty(d, line, col),
                   jd_ty("JsonError", [], line, col)], line, col)

# The name a constructor is declared with: its wire tag.
fn jd_ctor_name(d: DeriveFor, c: SymId) : String = derive_ref_text(d.tab, DrSym(c))

#[doc("The `#[derive(Json)]` decls for the type `t`, with the row of each function: the protocol impl plus the `of_json` shim, for a record body or a sum body under the adjacently-tagged `{\"tag\", \"value\"}` envelope. `tab` names the type, its constructors and the module the functions are minted in; `spell` is the piece a generated symbol spells a nested record's head with. Nothing when a field/payload has no JSON denotation.")]
pub fn derive_json_impl(tab: SymTab, t: SymId, body: TypeBody, spell: (DeclRef) -> String,
                        line: Int, col: Int) : Minted = {
  let d = DeriveFor { tab: tab, t: t, spell: spell }
  match body {
    TBRecord(fields) -> match jd_fields_of(fields) {
      Some(jfs) -> match jfs {
        []  -> minted_none()
        _   -> minted_append(jd_impl(d, jfs, line, col), jd_shim(d, line, col))
      }
      None -> minted_none()
    }
    TBSum(variants) -> match jd_variants_of(variants) {
      Some([]) -> minted_none()
      Some(_)  -> minted_append(jd_sum_impl(d, variants, line, col), jd_shim(d, line, col))
      None     -> minted_none()
    }
    _ -> minted_none()
  }
}

# ASCII lowercaser for the shim name. Local rather than shared with
# `protos` because this module precedes it in the bundle.
fn jd_lower(s: String, i: Int, n: Int, acc: String) : String =
  if i >= n { acc } else { match char_at(s, i) {
    None -> acc
    Some(c) -> {
      let nc = char_to_int(c)
      let lc = if nc >= 65 and nc <= 90 { int_to_char(nc + 32) } else { c }
      jd_lower(s, i + 1, n, string_concat(acc, "#{lc}"))
    }
  } }

fn jd_shim_name(tname: String) : String =
  concat_all([jd_lower(tname, 0, string_length(tname), ""), "_of_json"])

fn jd_impl(d: DeriveFor, jfs: [JsonField], line: Int, col: Int) : Minted =
  jd_make_impl(d, jd_to_json_body(d, jfs, line, col),
               jd_of_json_body(d, jfs, line, col), line, col)

# The `impl Json for T` shell: same `to_json`/`of_json` signatures for a
# record or a sum, differing only in the two supplied bodies.
fn jd_make_impl(d: DeriveFor, to_body: Expr, of_body: Expr,
                line: Int, col: Int) : Minted {
  let str_ty = jd_ty("String", [], line, col)
  let json_ty = jd_ty("JsonValue", [], line, col)
  let to_params = [jd_param("self", Some(derive_self_ty(d, line, col)), line, col)]
  let of_params = [jd_param("v", Some(json_ty), line, col),
                   jd_param("path", Some(str_ty), line, col)]
  derive_impl(d, CpJson,
              [DeriveMethod("to_json", to_params, json_ty, to_body),
               DeriveMethod("of_json", of_params, jd_result_ty(d, line, col), of_body)],
              line, col)
}

# `fn <lower(T)>_of_json(v, path)` — the non-overloaded entry point.
# Single dispatch picks the impl from the first argument, which here is
# the DOM node, so the user cannot call `of_json` directly.
fn jd_shim(d: DeriveFor, line: Int, col: Int) : Minted {
  let params = [jd_param("v", Some(jd_ty("JsonValue", [], line, col)), line, col),
                jd_param("path", Some(jd_ty("String", [], line, col)), line, col)]
  let mangled = concat_all(["__pimpl_Json_", derive_type_spell(d), "_of_json"])
  let body = jd_call(mangled, [jd_var("v", line, col), jd_var("path", line, col)],
                     line, col)
  derive_fn(d, jd_shim_name(derive_type_name(d)), params, jd_result_ty(d, line, col), body, line, col)
}

# ---- to_json -------------------------------------------------------
#
# `JObj([Pair { fst: "<name>", snd: <encode(self.<name>)> }, ...])` in
# declaration order. Keys are the kaikai field names verbatim: the wire
# name is what the type says, with no case conversion.

fn jd_to_json_body(d: DeriveFor, jfs: [JsonField], line: Int, col: Int) : Expr =
  jd_call("JObj", [jd_expr(EList(jd_pairs(d, jfs, 0, line, col)), line, col)], line, col)

fn jd_pair(key: String, value: Expr, line: Int, col: Int) : Expr =
  jd_expr(ERecordLit(ref_written("Pair"),
            [FI("fst", jd_str(key, line, col)), FI("snd", value)]), line, col)

fn jd_pairs(d: DeriveFor, jfs: [JsonField], slot: Int, line: Int, col: Int) : [ListElem] = match jfs {
  [] -> []
  [f, ...rest] -> match f {
    # A `#[json(skip)]` field is not written to the wire.
    JF(name, wire, shape, _, skip) ->
      if skip { jd_pairs(d, rest, slot, line, col) }
      else {
        let read = jd_expr(EField(jd_var("self", line, col), name), line, col)
        let pair = jd_pair(wire, jd_encode(d, shape, read, slot, line, col), line, col)
        [ElPlain(pair), ...jd_pairs(d, rest, slot + jd_enc_lams(shape), line, col)]
      }
  }
}

# The impl function a nested record's `op` lowered to, by the name the
# record is emitted under.
fn jd_nested(d: DeriveFor, rt: DeclRef, op: String) : String = {
  let spell = d.spell
  concat_all(["__pimpl_Json_", spell(rt), "_", op])
}

fn jd_encode(d: DeriveFor, shape: JsonShape, v: Expr, slot: Int, line: Int, col: Int) : Expr = match shape {
  JSStr  -> jd_call("JStr", [v], line, col)
  JSInt  -> jd_call("JNum", [v], line, col)
  JSReal -> jd_call("JReal", [v], line, col)
  JSBool -> jd_call("JBool", [v], line, col)
  JSRecord(rt) -> jd_call(jd_nested(d, rt, "to_json"), [v], line, col)
  JSList(inner) -> jd_lib("json_of_list", [v, jd_encoder_fn(d, inner, slot, line, col)], line, col)
  JSOpt(inner)  -> jd_lib("json_of_opt", [v, jd_encoder_fn(d, inner, slot, line, col)], line, col)
}

# The element encoder a list / option hands to its combinator: `(x) =>
# <encode(x)>`, so the same `jd_encode` covers nesting to any depth.
fn jd_encoder_fn(d: DeriveFor, shape: JsonShape, slot: Int, line: Int, col: Int) : Expr {
  let lcol = jd_slot_col(col, slot)
  let p = jd_param("x", None, line, lcol)
  jd_expr(ELambda([p], jd_encode(d, shape, jd_var("x", line, col), slot + 1, line, col)),
          line, lcol)
}

# ---- of_json -------------------------------------------------------
#
# An object check, then a match tower with one arm per field: read the
# key, bind it or return the located error, then build the record from
# the bound names. Absence and unknown keys are the readers' business —
# the tower only threads paths. The object check comes first so a node
# of the wrong shape reports as itself instead of as every field
# going missing at once.

fn jd_of_json_body(d: DeriveFor, jfs: [JsonField], line: Int, col: Int) : Expr {
  let guard = jd_lib("json_bind_object",
                [jd_var("v", line, col), jd_var("path", line, col)], line, col)
  let ok_arm = Arm(jd_ctor_pat("Ok", [mk_pat(PWild, line, col)], line, col),
                   None, jd_tower(d, jfs, [], 0, line, col))
  let err_arm = jd_err_arm(line, col)
  jd_expr(EMatch(guard, [ok_arm, err_arm]), line, col)
}

fn jd_tower(d: DeriveFor, jfs: [JsonField], bound: [String], slot: Int,
            line: Int, col: Int) : Expr = match jfs {
  [] -> jd_call("Ok", [jd_record(d, list_reverse(bound), line, col)], line, col)
  [f, ...rest] -> match f {
    JF(name, wire, shape, dflt, skip) ->
      if skip {
        # No wire value: reconstruct from the default, or `None` for an
        # `Option`. `let name = <value>` then continue the tower.
        let value = jd_skip_value(shape, dflt, line, col)
        let tail = jd_tower(d, rest, [name, ...bound], slot, line, col)
        jd_expr(EBlock([SLet(jd_bind(name, line, col), None, value)], Some(tail)),
                line, col)
      } else {
        let node = jd_lib("json_bind_field",
                     [jd_var("v", line, col), jd_str(wire, line, col)], line, col)
        let sub = jd_lib("json_path_field",
                    [jd_var("path", line, col), jd_str(wire, line, col)], line, col)
        # A `#[json(default)]` field substitutes the default when the key
        # is absent (`JNull`); an absent field with no default still errors
        # in the leaf reader, preserving #1280's required-field policy.
        let read = match dflt {
          None    -> jd_decode(d, shape, node, sub, slot, line, col)
          Some(dv) -> jd_default_read(d, shape, node, sub, dv, slot, line, col)
        }
        let next = slot + jd_dec_lams(shape)
        let tail = jd_tower(d, rest, [name, ...bound], next, line, col)
        let ok_arm = Arm(jd_ctor_pat("Ok", [jd_bind(name, line, col)], line, col), None, tail)
        let err_arm = jd_err_arm(line, col)
        jd_expr(EMatch(read, [ok_arm, err_arm]), line, col)
      }
  }
}

# The value a `#[json(skip)]` field takes on decode: its `#[json(default)]`
# expression, or `None` when it has none (the validator guarantees a bare
# skip is an `Option`).
fn jd_skip_value(shape: JsonShape, dflt: Option[Expr], line: Int, col: Int) : Expr =
  match dflt {
    Some(d) -> d
    None    -> jd_var("None", line, col)
  }

# `match json_bind_field(v, wire) { JNull -> Ok(<default>) ; node -> <decode> }`
# — the default stands in for an absent key, the leaf reader still handles
# a present-but-wrong-shape value.
fn jd_default_read(d: DeriveFor, shape: JsonShape, node: Expr, sub: Expr, dflt: Expr,
                   slot: Int, line: Int, col: Int) : Expr {
  let null_arm = Arm(jd_ctor_pat("JNull", [], line, col), None,
                     jd_call("Ok", [dflt], line, col))
  let some_arm = Arm(jd_bind("__jn", line, col), None,
                     jd_decode(d, shape, jd_var("__jn", line, col), sub, slot, line, col))
  jd_expr(EMatch(node, [null_arm, some_arm]), line, col)
}

fn jd_decode(d: DeriveFor, shape: JsonShape, node: Expr, path: Expr, slot: Int,
             line: Int, col: Int) : Expr = match shape {
  JSStr  -> jd_lib("json_bind_string", [node, path], line, col)
  JSInt  -> jd_lib("json_bind_int", [node, path], line, col)
  JSReal -> jd_lib("json_bind_real", [node, path], line, col)
  JSBool -> jd_lib("json_bind_bool", [node, path], line, col)
  JSRecord(rt) -> jd_call(jd_nested(d, rt, "of_json"), [node, path], line, col)
  JSList(inner) ->
    jd_lib("json_bind_list", [node, path, jd_decoder_fn(d, inner, slot, line, col)], line, col)
  JSOpt(inner) -> jd_opt_decode(d, inner, node, path, slot, line, col)
}

# The optional readers are per-leaf so `null` short-circuits before the
# leaf's shape check; a nested record or list under `Option` has no
# dedicated reader, so it goes through the generic combinator instead.
fn jd_opt_decode(d: DeriveFor, inner: JsonShape, node: Expr, path: Expr, slot: Int,
                 line: Int, col: Int) : Expr = match inner {
  JSStr  -> jd_lib("json_bind_opt_string", [node, path], line, col)
  JSInt  -> jd_lib("json_bind_opt_int", [node, path], line, col)
  JSReal -> jd_lib("json_bind_opt_real", [node, path], line, col)
  JSBool -> jd_lib("json_bind_opt_bool", [node, path], line, col)
  JSList(elem) ->
    jd_lib("json_bind_opt_list", [node, path, jd_decoder_fn(d, elem, slot, line, col)], line, col)
  _ -> jd_lib("json_bind_opt", [node, path, jd_decoder_fn(d, inner, slot, line, col)], line, col)
}

# The element decoder a list hands to its combinator: `(x, p) =>
# <decode(x, p)>`, taking the per-element path the combinator built.
fn jd_decoder_fn(d: DeriveFor, shape: JsonShape, slot: Int, line: Int, col: Int) : Expr {
  let lcol = jd_slot_col(col, slot)
  let px = jd_param("x", None, line, lcol)
  let pp = jd_param("p", None, line, lcol)
  let body = jd_decode(d, shape, jd_var("x", line, col), jd_var("p", line, col), slot + 1,
                       line, col)
  jd_expr(ELambda([px, pp], body), line, lcol)
}

fn jd_record(d: DeriveFor, names: [String], line: Int, col: Int) : Expr =
  jd_expr(ERecordLit(DrSym(d.t), jd_field_inits(names, line, col)), line, col)

fn jd_field_inits(names: [String], line: Int, col: Int) : [FieldInit] = match names {
  [] -> []
  [n, ...rest] -> [FI(n, jd_var(n, line, col)), ...jd_field_inits(rest, line, col)]
}

# ==== sum types: adjacently-tagged `{"tag", "value"}` envelope =======
#
# A sum value encodes as `JObj([tag: "<Variant>", value: <payload>])`.
# The payload mirrors the variant's arity: `null` for a nullary variant,
# the single encoding for one payload, a `JArr` of the encodings for
# several. Decode reads `tag`, routes to the variant, and decodes `value`
# against that variant's payload shape — an unknown tag reports as a
# located `JsonError`, preserving #1280's structured-error policy.

# `[[JsonShape]]` — the payload shapes of every variant, or `None` when a
# payload type has no JSON denotation, which drops the whole derive.
fn jd_variants_of(variants: [Variant]) : Option[[[JsonShape]]] =
  jd_variants_loop(variants, [])

fn jd_variants_loop(variants: [Variant], acc: [[JsonShape]]) : Option[[[JsonShape]]] =
  match variants {
    [] -> Some(list_reverse(acc))
    [v, ...rest] -> match v {
      Var(_, vargs) -> match jd_payload_shapes(vargs, []) {
        Some(ss) -> jd_variants_loop(rest, [ss, ...acc])
        None     -> None
      }
    }
  }

fn jd_sum_impl(d: DeriveFor, variants: [Variant], line: Int, col: Int) : Minted =
  jd_make_impl(d, jd_sum_to_json_body(d, variants, line, col),
               jd_sum_of_json_body(d, variants, line, col), line, col)

# ---- sum to_json ---------------------------------------------------
#
# `match self { V0 -> <envelope "V0" null>; V1(p0) -> <envelope "V1" enc(p0)>;
#  V2(p0, p1) -> <envelope "V2" JArr([enc(p0), enc(p1)])> }`.

fn jd_sum_to_json_body(d: DeriveFor, variants: [Variant], line: Int, col: Int) : Expr =
  jd_expr(EMatch(jd_var("self", line, col),
                 jd_sum_encode_arms(d, variants, 0, line, col)), line, col)

fn jd_sum_encode_arms(d: DeriveFor, variants: [Variant], slot: Int, line: Int, col: Int) : [Arm] =
  match variants {
    [] -> []
    [v, ...rest] -> {
      let next = slot + jd_variant_lams(v, true)
      [jd_sum_encode_arm(d, v, slot, line, col),
       ...jd_sum_encode_arms(d, rest, next, line, col)]
    }
  }

fn jd_sum_encode_arm(d: DeriveFor, v: Variant, slot: Int, line: Int, col: Int) : Arm = match v {
  Var(ctor, vargs) -> {
    let subs = jd_bind_pats(vargs, 0, line, col)
    let pat = mk_pat(PVariant(DrSym(ctor), subs), line, col)
    let value = jd_encode_payload(d, jd_shape_of_all(vargs), 0, slot, line, col)
    Arm(pat, None, jd_envelope(jd_ctor_name(d, ctor), value, line, col))
  }
}

# The wire object `JObj([Pair{tag}, Pair{value}])` for one variant.
fn jd_envelope(name: String, value: Expr, line: Int, col: Int) : Expr {
  let tag = jd_pair("tag", jd_call("JStr", [jd_str(name, line, col)], line, col), line, col)
  let val = jd_pair("value", value, line, col)
  jd_call("JObj", [jd_expr(EList([ElPlain(tag), ElPlain(val)]), line, col)], line, col)
}

# `null` for a nullary variant, the single encoding for one payload, a
# `JArr` of encodings for several.
fn jd_encode_payload(d: DeriveFor, shapes: [JsonShape], i: Int, slot: Int, line: Int, col: Int) : Expr =
  match shapes {
    []  -> jd_var("JNull", line, col)
    [s] -> jd_encode(d, s, jd_var(concat_all(["p", int_to_string(i)]), line, col), slot, line, col)
    _   -> jd_call("JArr", [jd_expr(EList(jd_encode_elems(d, shapes, i, slot, line, col)), line, col)],
                   line, col)
  }

fn jd_encode_elems(d: DeriveFor, shapes: [JsonShape], i: Int, slot: Int, line: Int, col: Int) : [ListElem] =
  match shapes {
    [] -> []
    [s, ...rest] -> {
      let e = jd_encode(d, s, jd_var(concat_all(["p", int_to_string(i)]), line, col), slot, line, col)
      [ElPlain(e), ...jd_encode_elems(d, rest, i + 1, slot + jd_enc_lams(s), line, col)]
    }
  }

fn jd_bind_pats(vargs: [TypeExpr], i: Int, line: Int, col: Int) : [Pattern] =
  match vargs {
    [] -> []
    [_, ...rest] -> [jd_bind(concat_all(["p", int_to_string(i)]), line, col),
                     ...jd_bind_pats(rest, i + 1, line, col)]
  }

# ---- sum of_json ---------------------------------------------------
#
# Object-check, then read the `tag` string and match it to a variant.
# Each arm decodes `value` against that variant's payload; an unknown
# tag is a located `JsonError`.

fn jd_sum_of_json_body(d: DeriveFor, variants: [Variant], line: Int, col: Int) : Expr {
  let guard = jd_lib("json_bind_object",
                [jd_var("v", line, col), jd_var("path", line, col)], line, col)
  let ok_arm = Arm(jd_ctor_pat("Ok", [mk_pat(PWild, line, col)], line, col),
                   None, jd_sum_read_tag(d, variants, line, col))
  let err_arm = jd_err_arm(line, col)
  jd_expr(EMatch(guard, [ok_arm, err_arm]), line, col)
}

# `match json_bind_string(json_bind_field(v, "tag"), path.tag) {
#    Ok(__tag) -> <tag tower> ; Err(e) -> Err(e) }`.
fn jd_sum_read_tag(d: DeriveFor, variants: [Variant], line: Int, col: Int) : Expr {
  let node = jd_lib("json_bind_field",
               [jd_var("v", line, col), jd_str("tag", line, col)], line, col)
  let tag_path = jd_lib("json_path_field",
               [jd_var("path", line, col), jd_str("tag", line, col)], line, col)
  let read = jd_lib("json_bind_string", [node, tag_path], line, col)
  let ok_arm = Arm(jd_ctor_pat("Ok", [jd_bind("__tag", line, col)], line, col),
                   None, jd_tag_tower(d, variants, line, col))
  let err_arm = jd_err_arm(line, col)
  jd_expr(EMatch(read, [ok_arm, err_arm]), line, col)
}

# `match __tag { "V0" -> <decode V0> ; ... ; _ -> Err(unknown) }`.
fn jd_tag_tower(d: DeriveFor, variants: [Variant], line: Int, col: Int) : Expr {
  let arms = jd_tag_arms(d, variants, 0, line, col)
  let names = jd_variant_names(d, variants)
  let unknown = jd_call("Err",
    [jd_lib("json_bind_unknown_tag",
       [jd_var("path", line, col), jd_var("__tag", line, col),
        jd_str(names, line, col)], line, col)], line, col)
  let dflt = Arm(mk_pat(PWild, line, col), None, unknown)
  jd_expr(EMatch(jd_var("__tag", line, col), list_append(arms, [dflt])), line, col)
}

fn jd_tag_arms(d: DeriveFor, variants: [Variant], slot: Int, line: Int, col: Int) : [Arm] = match variants {
  [] -> []
  [v, ...rest] -> match v {
    Var(ctor, vargs) -> {
      let pat = mk_pat(PLit(jd_str(jd_ctor_name(d, ctor), line, col)), line, col)
      let body = jd_variant_decode(d, ctor, jd_shape_of_all(vargs), slot, line, col)
      let next = slot + jd_variant_lams(v, false)
      [Arm(pat, None, body), ...jd_tag_arms(d, rest, next, line, col)]
    }
  }
}

# The `value` node and its path, shared by every variant decode.
fn jd_value_node(line: Int, col: Int) : Expr =
  jd_lib("json_bind_field", [jd_var("v", line, col), jd_str("value", line, col)], line, col)

fn jd_value_path(line: Int, col: Int) : Expr =
  jd_lib("json_path_field", [jd_var("path", line, col), jd_str("value", line, col)], line, col)

# `Ctor(args)`, the constructor by id.
fn jd_construct(ctor: SymId, args: [Expr], line: Int, col: Int) : Expr =
  jd_expr(ECall(mk_sym(ctor, line, col), args), line, col)

# Decode `value` for one variant against its payload shapes and build
# the constructor. Nullary ignores `value`; one payload decodes it
# directly; several read `value` as a JSON array element-by-element.
fn jd_variant_decode(d: DeriveFor, ctor: SymId, shapes: [JsonShape], slot: Int, line: Int, col: Int) : Expr =
  match shapes {
    []  -> jd_call("Ok", [mk_sym(ctor, line, col)], line, col)
    [s] -> {
      let read = jd_decode(d, s, jd_value_node(line, col), jd_value_path(line, col), slot, line, col)
      let ok = Arm(jd_ctor_pat("Ok", [jd_bind("p0", line, col)], line, col), None,
                   jd_call("Ok", [jd_construct(ctor, [jd_var("p0", line, col)], line, col)], line, col))
      let err = jd_err_arm(line, col)
      jd_expr(EMatch(read, [ok, err]), line, col)
    }
    _ -> jd_tuple_decode(d, ctor, shapes, jd_count_shapes(shapes, 0), 0, [], slot, line, col)
  }

# Thread `json_bind_tuple_elem(value, i, arity, path.value)` for each
# payload, then decode the element, ending in `Ok(Variant(p0, ..))`.
fn jd_tuple_decode(d: DeriveFor, ctor: SymId, shapes: [JsonShape], arity: Int, i: Int,
                   bound: [String], slot: Int, line: Int, col: Int) : Expr = match shapes {
  [] -> {
    let args = jd_bound_args(list_reverse(bound), line, col)
    jd_call("Ok", [jd_construct(ctor, args, line, col)], line, col)
  }
  [s, ...rest] -> {
    let elem = jd_lib("json_bind_tuple_elem",
                 [jd_value_node(line, col), jd_expr(mk_int_synth(i), line, col),
                  jd_expr(mk_int_synth(arity), line, col), jd_value_path(line, col)], line, col)
    let epath = jd_lib("json_path_index",
                  [jd_value_path(line, col), jd_expr(mk_int_synth(i), line, col)], line, col)
    let pname = concat_all(["p", int_to_string(i)])
    let read = jd_decode_elem(d, s, pname, rest, ctor, shapes, arity, i,
                              bound, epath, slot, line, col)
    let elem_ok = Arm(jd_ctor_pat("Ok", [jd_bind("__ev", line, col)], line, col), None, read)
    let elem_err = jd_err_arm(line, col)
    jd_expr(EMatch(elem, [elem_ok, elem_err]), line, col)
  }
}

fn jd_decode_elem(d: DeriveFor, s: JsonShape, pname: String, rest: [JsonShape], ctor: SymId,
                  shapes: [JsonShape], arity: Int, i: Int, bound: [String],
                  epath: Expr, slot: Int, line: Int, col: Int) : Expr {
  let read = jd_decode(d, s, jd_var("__ev", line, col), epath, slot, line, col)
  let next = slot + jd_dec_lams(s)
  let bound1 = [pname, ...bound]
  let ok = Arm(jd_ctor_pat("Ok", [jd_bind(pname, line, col)], line, col), None,
               jd_tuple_decode(d, ctor, rest, arity, i + 1, bound1, next, line, col))
  let err = jd_err_arm(line, col)
  jd_expr(EMatch(read, [ok, err]), line, col)
}

fn jd_bound_args(names: [String], line: Int, col: Int) : [Expr] = match names {
  [] -> []
  [n, ...rest] -> [jd_var(n, line, col), ...jd_bound_args(rest, line, col)]
}

fn jd_count_shapes(shapes: [JsonShape], acc: Int) : Int = match shapes {
  [] -> acc
  [_, ...rest] -> jd_count_shapes(rest, acc + 1)
}

# `"A, B, C"` — the variant names for the unknown-tag error's expected set.
fn jd_variant_names(d: DeriveFor, variants: [Variant]) : String = match variants {
  [] -> ""
  [v, ...rest] -> match v {
    Var(ctor, _) -> match rest {
      [] -> jd_ctor_name(d, ctor)
      _  -> concat_all([jd_ctor_name(d, ctor), ", ", jd_variant_names(d, rest)])
    }
  }
}
