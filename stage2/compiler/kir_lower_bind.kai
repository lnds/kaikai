#[doc("Pattern lowering helpers: binding sub-patterns, aliasing, variant tags and literal equality.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.ctor_ix
import compiler.emit_shared_syms
import compiler.arm_release
import compiler.kir
import compiler.kir_lower
import compiler.unbox
import compiler.written
import compiler.kir_lower_sig

# compiler/kir_lower_variant.kai — which sub-patterns discriminate.
#
# The variant path of `lower_match` switches on the scrutinee's top-level
# tag. Two arms sharing a tag (`Exited(0)` / `Exited(_)`) must still test
# their payload, so the arms of one tag are grouped into a fail chain whose
# per-arm tests come from `kir_lower_ptest`. This module answers the
# question both need: does a sub-pattern carry a test the tag does not?

#[doc("Whether a sub-pattern carries a test: a literal, a constructor, a list, or a record or tuple with a discriminating field.")]
pub(pkg) fn psub_is_discriminating(p: Pattern) : Bool = match p.pkind {
  PLit(_)                 -> true
  PVariant(_, _)          -> true
  PVariantRecord(_, _)    -> true
  PList(_, _)             -> true
  PRecord(fields)         -> any_field_discriminating(fields)
  PAs(_, inner)           -> psub_is_discriminating(inner)
  _                       -> false
}

#[doc("Whether a variant arm tests nothing beyond its tag (`Exited(_)`), ending its tag's sub-chain.")]
pub(pkg) fn var_arm_is_tag_catchall(p: Pattern) : Bool = match p.pkind {
  PVariant(_, subs)            -> not any_discriminating(subs)
  PVariantRecord(_, fields)    -> not any_field_discriminating(fields)
  PAs(_, inner)                -> var_arm_is_tag_catchall(inner)
  _                            -> true
}

#[doc("Whether any of the sub-patterns discriminates.")]
pub(pkg) fn any_discriminating(subs: [Pattern]) : Bool = match subs {
  [] -> false
  [sp, ...rest] -> if psub_is_discriminating(sp) { true } else { any_discriminating(rest) }
}

#[doc("Whether any field's sub-pattern discriminates.")]
pub(pkg) fn any_field_discriminating(fields: [PField]) : Bool = match fields {
  [] -> false
  [PField(_, sub, _), ...rest] ->
    if psub_is_discriminating(sub) { true } else { any_field_discriminating(rest) }
}

# A literal pattern test compares with `kai_eq_raw`, which borrows both
# operands. A String, Real or fixed-width literal materialises a fresh box
# for the comparison, so the test binds it, compares, and releases it before
# branching. An Int, Bool or Char literal is an immediate and needs none.

#[doc("Seal `condbr (kai_eq_raw v lit) ? ok_lbl : fail_lbl`, releasing a boxed literal before the branch.")]
pub(pkg) fn kle_seal_eq(v: KVal, lit: KVal, ok_lbl: String, fail_lbl: String, pos: KPos,
                   st: LowerSt) : LowerSt / Console =
  if kle_lit_is_boxed(lit) {
    match bind_op(st, KLitOp(lit), pos) { LRes(lv, st1) ->
      match bind_op(st1, KPrim(KpEqRaw, [v, lv]), pos) { LRes(cond, st2) ->
        ls_seal(ls_emit(st2, KRC(KDrop(lv), pos)), KCondBr(cond, ok_lbl, fail_lbl, pos), fail_lbl) } }
  } else {
    match bind_op(st, KPrim(KpEqRaw, [v, lit]), pos) { LRes(cond, st1) ->
      ls_seal(st1, KCondBr(cond, ok_lbl, fail_lbl, pos), fail_lbl) }
  }

fn kle_lit_is_boxed(lit: KVal) : Bool = match lit {
  KStrV(_)      -> true
  KRealV(_)     -> true
  KFixedV(_, _) -> true
  _             -> false
}

# compiler/kir_pat_alias.kai — the single source of truth for which match
# arm binders are ALIASES of the scrutinee's storage and therefore need a
# structural incref (dup) in the native lowering.
#
# The C-direct oracle (`emit_pat_binds` in emit_c.kai) decides alias-ness as
# part of ONE textual walk: a binder reached with `is_alias=true` shares
# storage with the scrutinee (a variant pointer slot, a cons head/tail/rest)
# and is bound `kai_incref(scr)`; a binder reached with `is_alias=false`
# already owns its ref (a `kai_op_field` result, a freshly-boxed Real slot).
# The native backend re-derives that same discipline; before this module it
# did so with several ad-hoc collectors keyed by arm shape, each a partial
# re-implementation that drifted from the oracle as new arm shapes appeared.
#
# This module holds ONE recursive collector — `pat_alias_binders` — that
# mirrors `emit_pat_binds` at any depth, plus pure position predicates that
# PARTITION its result for the two reuse call-sites that need a subset. No
# consumer re-walks a pattern to decide alias-ness; they all read this set.

# Pointer/scalar split of a variant slot kind: 0 = pointer, 1 = Int,
# 2 = Real. `pa_slot_needs_dup` maps kind to whether the native binder is a
# heap-box BORROW of the cell's storage (0) or an owned / no-RC read (1, 2).
# An enum slot maps to 0/pointer: its binder holds the immortal interned
# singleton, so the alias dup it gets is a runtime no-op — same net effect
# as the C oracle's alias-shaped enum bind.
fn pa_slot_kind(k: Int) : Int = if k == 3 { 0 } else { k }

#[doc("The pointer/scalar slot kinds of the constructor a pattern references, or [] when it references none.")]
pub(pkg) fn pa_kinds(ix: CtorIx, r: DeclRef) : [Int] = match ctor_ix_row(ix, ref_sym(r)) {
  Some(EV(_, ks, _, _)) -> map(ks, pa_slot_kind)
  None                     -> []
}

#[doc("""
Every binder a match arm reaches over a heap-box BORROW path — the set the
native lowering must structurally dup so a consuming arm body cannot free a
slot the scrutinee still holds. This is the single mirror of that discipline;
all native alias-dup / reuse call-sites derive their sets from it, never
re-walking.

Descends PList (heads + `...rest`), PVariant slots that `pa_slot_needs_dup`
(pointer slots; Int is a tagged immediate and a Real slot's read mints an
owned box), and PAs (name + inner, inner always alias). Record and
variant-record fields are NOT descended: the field bind dups its own cell
binders and releases the field read (`bind_field_owned`), so they arrive owned.
""")]
pub(pkg) fn pat_alias_binders(p: Pattern, ix: CtorIx) : [LocalId] = pab_pat(p, ix, [])

fn pab_pat(p: Pattern, ix: CtorIx, acc: [LocalId]) : [LocalId] = match p.pkind {
  PBind(b)      -> [b.id, ...acc]
  PNarrow(b, _) -> [b.id, ...acc]
  PAs(b, inner) -> pab_pat(inner, ix, [b.id, ...acc])
  PList(pats, opt_rest) -> {
    let a1 = match opt_rest {
      None    -> acc
      Some(b) -> [b.id, ...acc]
    }
    pab_pats(pats, ix, a1)
  }
  PVariant(r, subs) -> pab_variant_slots(subs, pa_kinds(ix, r), 0, ix, acc)
  _ -> acc
}

fn pab_pats(pats: [Pattern], ix: CtorIx, acc: [LocalId]) : [LocalId] = match pats {
  []           -> acc
  [hp, ...rest] -> pab_pats(rest, ix, pab_pat(hp, ix, acc))
}

fn pab_variant_slots(subs: [Pattern], ks: [Int], idx: Int, ix: CtorIx, acc: [LocalId]) : [LocalId] = match subs {
  []            -> acc
  [sp, ...rest] -> {
    let k = kind_at(ks, idx)
    let acc1 = if pa_slot_needs_dup(k) { pab_pat(sp, ix, acc) } else { acc }
    pab_variant_slots(rest, ks, idx + 1, ix, acc1)
  }
}

# A slot binder needs a structural dup iff the native reads it as a BORROW of
# storage the arm may consume — pointer slots (0) only. A Real slot (2) is a
# raw `.r` word under the full slot mask: its `KProj` read mints a fresh
# OWNED box (the C oracle's `kai_real(slot.r)`, `is_alias=false`), so a dup
# here would leak one box per read. Int (1) is a tagged immediate whose
# decref is a no-op.
fn pa_slot_needs_dup(k: Int) : Bool = k == 0

#[doc("""
The DIRECT-slot partition of `pat_alias_binders`: the alias binders bound as
a top-level cons slot (head `PBind`, `...rest`) or a top-level variant
pointer slot. These are the slots a dual-branch reuse binds per-branch (a
borrow in the unique branch, a dup in the shared branch); everything else in
the alias set is deconstructed and dup'd unconditionally outside the fork.
""")]
pub(pkg) fn pat_direct_alias_slots(p: Pattern, ix: CtorIx) : [LocalId] = match p.pkind {
  PList(pats, opt_rest) -> {
    let heads = pa_list_direct_heads(pats, [])
    match opt_rest { None -> heads Some(b) -> [b.id, ...heads] }
  }
  PVariant(r, subs) -> pa_variant_direct_slots(subs, pa_kinds(ix, r), 0, [])
  PBind(b)  -> [b.id]
  PAs(b, _) -> [b.id]
  _         -> []
}

fn pa_list_direct_heads(pats: [Pattern], acc: [LocalId]) : [LocalId] = match pats {
  []            -> acc
  [hp, ...rest] -> match hp.pkind {
    PBind(b) -> pa_list_direct_heads(rest, [b.id, ...acc])
    _        -> pa_list_direct_heads(rest, acc)
  }
}

fn pa_variant_direct_slots(subs: [Pattern], ks: [Int], idx: Int, acc: [LocalId]) : [LocalId] = match subs {
  []            -> acc
  [sp, ...rest] -> {
    let k = kind_at(ks, idx)
    let acc1 = match sp.pkind {
      PBind(b) -> if k == 0 { [b.id, ...acc] } else { acc }
      _        -> acc
    }
    pa_variant_direct_slots(rest, ks, idx + 1, acc1)
  }
}

#[doc("""
The DECONSTRUCTED partition of `pat_alias_binders`: the alias set minus the
direct slots. In a dual-branch cons reuse these sub-binders are incref'd
UNCONDITIONALLY (in both branches, per the oracle's is_alias path), so they
leave the condbr; only the direct slots differ per branch.
""")]
pub(pkg) fn pat_decon_alias_binders(p: Pattern, ix: CtorIx) : [LocalId] =
  binders_minus(pat_alias_binders(p, ix), pat_direct_alias_slots(p, ix))

fn binders_minus(all: [LocalId], drop: [LocalId]) : [LocalId] = match all {
  []           -> []
  [n, ...rest] -> if binder_among(drop, n) { binders_minus(rest, drop) } else { [n, ...binders_minus(rest, drop)] }
}

fn binder_among(xs: [LocalId], n: LocalId) : Bool = match xs {
  []           -> false
  [h, ...rest] -> if local_eq(h, n) { true } else { binder_among(rest, n) }
}

# compiler/kir_lower_bind.kai — pattern-binder lowering for `match` arms
# and destructuring `let`s.
#
# When a `match` arm or a `let` pattern binds names from the scrutinee, the
# binders must become real KIR registers (`KLet name = <slot read>`) or the
# arm body's read of the binder lowers to an unbound register the native backend
# aborts on. This module owns that bind emission, recursing into NESTED
# sub-patterns so `let { p: { x, y } } = b` and `Some(x)` bind their inner
# names against the EXTRACTED inner value. Mirror of emit_c's
# `emit_pat_binds` / `emit_pat_binds_variant` / `emit_pat_binds_record`.
# A bare `KLet`/`KProj` never increfs: Perceus's
# already-placed KRC nodes own the refcounting (`lm_bind_name` note).
#
# It drives ON the lowering base (`bind_op`, `ls_emit`, `KProj`,
# `KPrim`) but NEVER recurses into `lower_expr`, so the import graph stays
# acyclic (`kir_lower ← kir_lower_bind ← kir_lower_walk`) — the same split
# `kir_lower_match.kai` / `kir_lower_rec.kai` use for the list / record
# decision trees.
#
# The binds run after the arm's tests (`kir_lower_ptest`), so a nested
# sub-pattern's names are projected only once its shape is confirmed.

# --- top-level arm binds (the switch already tested the tag) ------------

# Bind a TOP-LEVEL variant arm's sub-binders from the scrutinee. The
# `KSwitch` already matched the arm's tag, so the direct sub-slots are safe
# to bind. `PVariant` reads positional slots (`KProj scrv idx`);
# `PVariantRecord` reads the payload record's named fields (`kai_op_field`).
pub(pkg) fn bind_pattern_fields(p: Pattern, scrv: KVal, body: Expr, st: LowerSt) : LowerSt / Console = match p.pkind {
  PVariant(r, subs)         -> bind_sub_binders(kcr_of_pat(st, r), subs, scrv, 0, body, st)
  PVariantRecord(_, fields) -> bind_record_subfields(fields, scrv, body, st)
  # A top-level as-pattern (`a @ A`, `a: A` after the narrow rewrite): bind the
  # whole scrutinee to `name`, then bind the inner pattern's own sub-binders.
  PAs(b, _)                 -> bind_pattern_fields(as_inner(p), scrv, body,
                                 ls_let(st, b, SBoxed, KLitOp(scrv), KAt(p.line, p.col)))
  _                         -> st
}

fn bind_sub_binders(c: KCtorRef, subs: [Pattern], scrv: KVal, idx: Int, body: Expr, st: LowerSt) : LowerSt / Console = match subs {
  [] -> st
  [sp, ...rest] -> bind_sub_binders(c, rest, scrv, idx + 1, body, bind_slot_pattern(c, sp, scrv, idx, body, st))
}

#[doc("The constructor a variant pattern names, as the slot readers need it: its row, or none when the pattern references no constructor.")]
pub(pkg) type KCtorRef = KCR(Option[VariantEntry])

#[doc("The constructor a variant pattern references.")]
pub(pkg) fn kcr_of_pat(st: LowerSt, r: DeclRef) : KCtorRef = KCR(ctor_ix_row(st.ctor_ix, ref_sym(r)))

#[doc("The head tag of the constructor `c`; 0 when it is none.")]
pub(pkg) fn kcr_tag(c: KCtorRef) : Int = match c {
  KCR(Some(row)) -> ctor_row_tag(row)
  KCR(None)      -> 0
}

# The runtime kind of ctor `cn`'s slot `idx`, read from the same variant
# table row the construction path uses (`ctor_lay`), so
# a slot READ never disagrees with how the ctor WROTE it. 1 = Int (`.i64`
# raw), 2 = Real (`.r` raw), 3 = enum (immediate tag), 0 = boxed pointer
# (the default: unresolvable ctors and runtime-minted variants with no
# user-visible payload). Both `bind_slot_kslot` and `bind_slot_op` consult
# it.
#
# A runtime-minted ctor (tag below
# the user base — `Exited`/`Signaled`, or a user type reusing such a name)
# has NO single static layout: the runtime mints its cells with raw Int
# slots while the native user-side construction (`ctor_lay`'s builtin
# guard, mask 0) builds them boxed. Only the mask-consulting dynamic read
# (`KProj`) is correct for both writers, so such a ctor classifies as the
# sentinel -1: never raw (`bind_slot_kslot`), never a static `.ptr` borrow
# (`bind_slot_op`), never a static literal test. A static kind on either
# side reads the other writer's cells wrong (the rc-detector and
# os_process parity catches, one per direction).
pub(pkg) fn slot_kind_of(c: KCtorRef, idx: Int) : Int = match c {
  KCR(Some(EV(_, ks, tag, _))) -> if tag < user_variant_tag_base() { 0 - 1 } else { kind_at(ks, idx) }
  KCR(None)                       -> 0 - 1
}

# The KSlot a match-arm binder `b` reads slot `idx` of ctor `c` at. Only a
# kind-1 Int slot can go raw (`SInt64`): the unbox pass seeds Int binders
# only. A kind-2 Real / kind-3 enum binder stays `SBoxed` — its `KProj` read
# re-boxes at the border (a fresh owned box for Real, the interned immortal
# singleton for enum), so the register always holds a `KaiValue *`.
#
# A kind-1 Int binder is `SInt64` iff the unbox phase seeded it native-raw —
# READ from the `st.raw_binders` side table by the binder's `PBind` position,
# NOT re-derived here. The one verdict `native_raw_arm_binders` produced (the
# same predicate the unbox seed applies) governs BOTH the perceus RC plan and
# this KSlot; keyed by position, it survives perceus untouched, so mode and
# KSlot can never desync (#1229). A body re-scan diverged when perceus dropped
# the binder's `MUnboxed` reads — a raw register loaded where the plan decref'd
# a boxed pointer, the self-compile SIGSEGV. A kind-2 Real / kind-3 enum binder
# stays `SBoxed`: its `KProj` re-boxes at the border, so the register always
# holds a `KaiValue *`.
pub(pkg) fn bind_slot_kslot(st: LowerSt, c: KCtorRef, idx: Int, b: Binder, line: Int, col: Int) : KSlot / Console =
  match slot_kind_of(c, idx) {
    1 -> if raw_arm_binder_at(st.raw_binders, b.id, line, col) { SInt64 } else { SBoxed }
    _ -> SBoxed
  }

# The conservative "no bounded arm body" sentinel — a bind path with no arm
# position of its own passes `bind_body_none()`; a binder bound through it is
# never in `st.raw_binders` (the table keys on real `PBind` positions), so an
# Int/Real slot binder stays boxed.
pub(pkg) fn bind_body_none() : Expr = mk_expr(EUnit, 0, 0)

# The read op for slot `idx` of ctor `cn`. A kind-0 slot (a boxed pointer)
# reads as a direct `.ptr` borrow (`KProjBorrow`); a typed slot (kind-1 Int,
# kind-2 Real, kind-3 enum) reads at its static kind (`KProjKind` — raw word
# load + minimal re-box, no mask lookup); only the mixed-writer sentinel
# keeps the mask-consulting `KProj`. The read op always matches the ctor's
# write layout.
pub(pkg) fn bind_slot_op(c: KCtorRef, idx: Int, scrv: KVal) : KOp =
  match slot_kind_of(c, idx) {
    0 -> KProjBorrow(scrv, idx)
    1 -> KProjKind(scrv, idx, 1)
    2 -> KProjKind(scrv, idx, 2)
    3 -> KProjKind(scrv, idx, 3)
    _ -> KProj(scrv, idx)
  }

# Bind ONE positional slot's sub-pattern. A `PBind` aliases the slot; a
# structured sub-pattern projects the slot and recurses; a nullary ctor, a
# literal or a wildcard binds nothing. The arm's tests already ran.
fn bind_slot_pattern(c: KCtorRef, sp: Pattern, scrv: KVal, idx: Int, body: Expr, st: LowerSt) : LowerSt / Console = match sp.pkind {
  # A kind-0 pointer slot binder reads a direct `.ptr` borrow (`KProjBorrow`);
  # every other slot stays the mask-consulting `KProj`. The read op matches the
  # ctor's write layout, so no tagged pointer is ever read raw nor vice versa.
  PBind(b)             -> ls_let(st, b, bind_slot_kslot(st, c, idx, b, sp.line, sp.col), bind_slot_op(c, idx, scrv), KAt(sp.line, sp.col))
  PRecord(_)           -> bind_nested_slot(c, sp, scrv, idx, body, st)
  PAs(b, _)            -> bind_nested_as(c, sp, b, scrv, idx, body, st)
  PVariant(_, subs)    -> if nullary_slot_ctor(subs) { st } else { bind_nested_slot(c, sp, scrv, idx, body, st) }
  PVariantRecord(_, _) -> bind_nested_slot(c, sp, scrv, idx, body, st)
  PList(_, _)          -> bind_nested_slot(c, sp, scrv, idx, body, st)
  _                    -> st
}

fn nullary_slot_ctor(subs: [Pattern]) : Bool = match subs {
  [] -> true
  _  -> false
}

# Project slot `idx` into a fresh register, then bind the nested sub-pattern
# (plain record OR a tag-tested variant payload) against it. A nested
# variant / record slot is always a kind-0 boxed pointer, so `bind_slot_op`
# reads it as a direct `.ptr` borrow (the same hot child read the balance
# rotations perform) rather than the mask-consulting `KProj`.
fn bind_nested_slot(c: KCtorRef, sp: Pattern, scrv: KVal, idx: Int, body: Expr, st: LowerSt) : LowerSt / Console =
  match bind_op(st, bind_slot_op(c, idx, scrv), KAt(sp.line, sp.col)) { LRes(sub, st1) ->
    bind_pattern_fields_any(sp, sub, body, st1) }

# An as-pattern slot (`name @ inner`): bind the slot to `name`, then bind
# the inner pattern against the SAME projected value.
fn bind_nested_as(c: KCtorRef, sp: Pattern, b: Binder, scrv: KVal, idx: Int, body: Expr, st: LowerSt) : LowerSt / Console =
  match bind_op(st, bind_slot_op(c, idx, scrv), KAt(sp.line, sp.col)) { LRes(sub, st1) -> {
    let st2 = ls_let(st1, b, SBoxed, KLitOp(sub), KAt(sp.line, sp.col))
    bind_pattern_fields_any(as_inner(sp), sub, body, st2)
  } }

# --- bind against an already-extracted value ----------------------------

# Bind a destructuring pattern against an already-extracted value (a `let`
# RHS, a projected slot, a read field). A nested plain `PRecord` /
# `PVariantRecord` payload binds its fields; a top-level-shaped `PVariant`
# here arrives only from a context whose tag is settled (the let-bind of a
# single-ctor type, an as-pattern inner), so its direct subs bind.
pub(pkg) fn bind_pattern_fields_any(p: Pattern, v: KVal, body: Expr, st: LowerSt) : LowerSt / Console = match p.pkind {
  PVariant(r, subs)         -> bind_sub_binders(kcr_of_pat(st, r), subs, v, 0, body, st)
  PVariantRecord(_, fields) -> bind_record_subfields(fields, v, body, st)
  PRecord(fields)           -> bind_record_subfields(fields, v, body, st)
  PList(pats, opt_rest)     -> bind_list_cells(pats, opt_rest, v, p, st)
  _                         -> st
}

# Bind the named binding fields of a record / variant-record payload by
# `kai_op_field` read, recursing into nested sub-patterns. Literal /
# wildcard fields bind nothing. Mirror of emit_c's `emit_pat_binds_record`.
fn bind_record_subfields(fields: [PField], v: KVal, body: Expr, st: LowerSt) : LowerSt / Console = match fields {
  [] -> st
  [PField(fname, sub, _), ...rest] ->
    bind_record_subfields(rest, v, body, bind_field_pattern(fname, sub, v, body, st))
}

#[doc("After a guard has passed, releases the cell's own reference to each field the guard did not read.")]
pub(pkg) fn bind_untake_unread(fields: [PField], g: Expr, v: KVal, st: LowerSt) : LowerSt / Console = match fields {
  [] -> st
  [PField(fname, sub, _), ...rest] -> bind_untake_unread(rest, g, v, match sub.pkind {
    PBind(b) ->
      if guard_reads(b.id, g) { st }
      else { match bind_op(st, KPrim(KpFieldUntake, [v, KStrV(fname)]), KAt(sub.line, sub.col)) { LRes(_, st1) -> st1 } }
    _ -> st
  })
}

#[doc("Bind a record pattern's names, nested records included, by taking each field from the cell: a unique cell hands it over, a shared one dups it.")]
pub(pkg) fn bind_record_taking(fields: [PField], v: KVal, st: LowerSt) : LowerSt / Console = match fields {
  [] -> st
  [PField(fname, sub, _), ...rest] -> bind_record_taking(rest, v, match sub.pkind {
    PBind(b) -> ls_let(st, b, SBoxed, KPrim(KpFieldTake, [v, KStrV(fname)]), KAt(sub.line, sub.col))
    PRecord(inner) -> {
      let pos = KAt(sub.line, sub.col)
      match bind_op(st, KPrim(KpFieldTake, [v, KStrV(fname)]), pos) { LRes(tv, st1) ->
        ls_emit(bind_record_taking(inner, tv, st1), KRC(KDrop(tv), pos)) }
    }
    _ -> st
  })
}

# A plain field binder owns the field read (`kai_op_field` increfs).
fn bind_field_pattern(fname: String, sub: Pattern, v: KVal, body: Expr, st: LowerSt) : LowerSt / Console =
  match sub.pkind {
    PBind(b) -> ls_let(st, b, SBoxed, KPrim(KpField, [v, KStrV(fname)]), KAt(sub.line, sub.col))
    PAs(b, inner) ->
      if field_sub_destructures(inner) { bind_field_owned(fname, sub, v, body, st) }
      else { bind_field_as(fname, b, sub, v, body, st) }
    _ -> if field_sub_destructures(sub) { bind_field_owned(fname, sub, v, body, st) } else { st }
  }

fn field_sub_destructures(p: Pattern) : Bool = match p.pkind {
  PRecord(_)              -> true
  PVariant(_, _)          -> true
  PVariantRecord(_, _)    -> true
  PList(_, _)             -> true
  PAs(_, inner)           -> field_sub_destructures(inner)
  _                       -> false
}

# A destructuring field sub-pattern binds its names as borrows of an owning
# field read. Each alias binder then takes its own reference and the read is
# released, so every binder owns exactly one reference, as on the C backend
# (`emit_pat_binds_record`). The decision tree already tested the field's
# shape, so these binds are dominated by that test.
fn bind_field_owned(fname: String, sub: Pattern, v: KVal, body: Expr, st: LowerSt) : LowerSt / Console = {
  let pos = KAt(sub.line, sub.col)
  match bind_op(st, KPrim(KpField, [v, KStrV(fname)]), pos) { LRes(fv, st1) -> {
    let st2 = bind_field_sub(sub, fv, body, st1)
    let st3 = dup_binders(pat_alias_binders(sub, st2.ctor_ix), pos, st2)
    ls_emit(st3, KRC(KDrop(fv), pos))
  } }
}

#[doc("Bind a destructuring `let` against its owned value: each alias binder takes its own reference and the value is released, as on the C backend.")]
pub(pkg) fn bind_let_owned(pat: Pattern, v: KVal, st: LowerSt) : LowerSt / Console = {
  let pos = KAt(pat.line, pat.col)
  let st1 = bind_field_sub(pat, v, bind_body_none(), st)
  ls_emit(dup_binders(pat_alias_binders(pat, st1.ctor_ix), pos, st1), KRC(KDrop(v), pos))
}

fn bind_field_sub(sub: Pattern, fv: KVal, body: Expr, st: LowerSt) : LowerSt / Console = match sub.pkind {
  PAs(b, inner) ->
    bind_field_sub(inner, fv, body, ls_let(st, b, SBoxed, KLitOp(fv), KAt(sub.line, sub.col)))
  _ -> bind_pattern_fields_any(sub, fv, body, st)
}

fn dup_binders(names: [LocalId], pos: KPos, st: LowerSt) : LowerSt = match names {
  []           -> st
  [n, ...rest] -> dup_binders(rest, pos, ls_emit(st, KRC(KDup(KVar(ls_reg_of(st, n))), pos)))
}

# Bind a list pattern's element/rest names as borrows of the cells under
# `cur`: each element is `KProj(cur, 0)`, the tail `KProj(cur, 1)`, and a
# `...rest` binds whatever cell the walk stands on. Emits no tests.
fn bind_list_cells(pats: [Pattern], opt_rest: Option[Binder], cur: KVal,
                   sp: Pattern, st: LowerSt) : LowerSt / Console = match pats {
  [] -> match opt_rest {
    Some(b)    -> ls_let(st, b, SBoxed, KLitOp(cur), KAt(sp.line, sp.col))
    None       -> st
  }
  [hp, ...rest] -> match bind_op(st, KProj(cur, 0), KAt(hp.line, hp.col)) { LRes(headv, st1) -> {
    let st2 = bind_list_head(hp, headv, st1)
    match bind_op(st2, KProj(cur, 1), KAt(hp.line, hp.col)) { LRes(tailv, st3) ->
      bind_list_cells(rest, opt_rest, tailv, sp, st3) }
  } }
}

fn bind_list_head(hp: Pattern, headv: KVal, st: LowerSt) : LowerSt / Console = match hp.pkind {
  PBind(b) -> ls_let(st, b, SBoxed, KLitOp(headv), KAt(hp.line, hp.col))
  _        -> bind_field_sub(hp, headv, bind_body_none(), st)
}

# An as-pattern field whose inner pattern binds no cells (`f: name @ x`):
# `name` owns the field read outright.
fn bind_field_as(fname: String, b: Binder, sub: Pattern, v: KVal, body: Expr, st: LowerSt) : LowerSt / Console =
  match bind_op(st, KPrim(KpField, [v, KStrV(fname)]), KAt(sub.line, sub.col)) { LRes(fv, st1) -> {
    let st2 = ls_let(st1, b, SBoxed, KLitOp(fv), KAt(sub.line, sub.col))
    bind_pattern_fields_any(as_inner(sub), fv, body, st2)
  } }

# The inner pattern of a `PAs(name, inner)`.
pub(pkg) fn as_inner(p: Pattern) : Pattern = match p.pkind {
  PAs(_, inner) -> inner
  _             -> p
}
