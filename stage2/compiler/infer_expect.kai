#[doc("Reading an expected result type back into a call's parameter types, so arguments are checked against what the context fixes.")]

import compiler.ast
import compiler.infer_state
import compiler.infer_apply
import compiler.infer_call_labels
import compiler.ast_ids

#[doc("Whether `t` is an unresolved variable, which says nothing a check could use.")]
pub(pkg) fn ty_is_open(t: Ty) : Bool = match t {
  TyVarT(_) -> true
  TyAny     -> true
  _         -> false
}

#[doc("The parameter types of a call whose result `res` is expected at `exp`: each variable of `res` that `exp` fixes is read through in the parameters.")]
pub(pkg) fn params_under_result(st: InferState, ps: [Ty], res: Ty, exp: Option[Ty]) : [Ty] = match exp {
  None    -> ps
  Some(t) -> {
    let binds = result_binds(apply_ty(st.sub, res), apply_ty(st.sub, t), [])
    if binds == [] { ps } else { map(ps, (p) => bind_read(p, binds)) }
  }
}

#[doc("The declared field types of a record literal expected at `exp`, with the record's type variables that `exp` fixes read through.")]
pub(pkg) fn fields_under_result(st: InferState, fields: [FTy], res: Ty, exp: Ty) : [FTy] = {
  let binds = result_binds(apply_ty(st.sub, res), apply_ty(st.sub, exp), [])
  if binds == [] { fields } else { map(fields, (f) => match f { FT(nm, t) -> FT(nm, bind_read(t, binds)) }) }
}

fn result_binds(pat: Ty, t: Ty, acc: [(Int, Ty)]) : [(Int, Ty)] = match pat {
  TyVarT(i) -> if ty_is_open(t) { acc } else { [(i, t), ...acc] }
  TyListT(p) -> match t {
    TyListT(x) -> result_binds(p, x, acc)
    _          -> acc
  }
  TyCon(sy, ps) -> match t {
    TyCon(sy2, ts) -> if sym_same(sy, sy2) { result_binds_all(ps, ts, acc) } else { acc }
    _              -> acc
  }
  _ -> acc
}

fn result_binds_all(ps: [Ty], ts: [Ty], acc: [(Int, Ty)]) : [(Int, Ty)] = match ps {
  [p, ...prest] -> match ts {
    [t, ...trest] -> result_binds_all(prest, trest, result_binds(p, t, acc))
    []            -> acc
  }
  [] -> acc
}

fn bind_read(t: Ty, binds: [(Int, Ty)]) : Ty = match t {
  TyVarT(i)          -> bound_or(binds, i, t)
  TyListT(x)         -> TyListT(bind_read(x, binds))
  TyCon(sym, args_)  -> TyCon(sym, map(args_, (a) => bind_read(a, binds)))
  TyFnT(ps, r, row)  -> TyFnT(map(ps, (p) => bind_read(p, binds)), bind_read(r, binds), row)
  _                  -> t
}

fn bound_or(binds: [(Int, Ty)], i: Int, fallback: Ty) : Ty = match binds {
  []                -> fallback
  [(j, t), ...rest] -> if i == j { t } else { bound_or(rest, i, fallback) }
}
