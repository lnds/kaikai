#[doc("""
The data types that can carry a closure, and so an effect row: a type
whose definition mentions a function type, or a type that does. A
row-polymorphic fn performs only what such arguments bring it.
""")]

import compiler.ast
import compiler.util

#[doc("The names of the types `decls` declares that can carry a closure.")]
pub fn unw_carriers(decls: [Decl]) : [String] = uc_fix(decls, uc_step(decls, [], []))

fn uc_fix(decls: [Decl], cs: [String]) : [String] = {
  let more = uc_step(decls, cs, cs)
  if list_length(more) == list_length(cs) { cs } else { uc_fix(decls, more) }
}

fn uc_step(decls: [Decl], cs: [String], acc: [String]) : [String] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DType(_, name, _, body, _, _, _, _, _) ->
      if not list_has(acc, name) and uc_body(body, cs) { uc_step(rest, cs, [name, ...acc]) }
      else { uc_step(rest, cs, acc) }
    _ -> uc_step(rest, cs, acc)
  }
}

fn uc_body(b: TypeBody, cs: [String]) : Bool = match b {
  TBAlias(t)       -> uc_te(t, cs)
  TBRecord(fs)     -> uc_fields(fs, cs)
  TBSum(vs)        -> uc_variants(vs, cs)
  TBEffectAlias(_) -> false
}

fn uc_fields(fs: [FieldDecl], cs: [String]) : Bool = match fs {
  [] -> false
  [FD(_, _, t, _), ...rest] -> uc_te(t, cs) or uc_fields(rest, cs)
}

fn uc_variants(vs: [Variant], cs: [String]) : Bool = match vs {
  [] -> false
  [Var(_, ts), ...rest] -> uc_tes(ts, cs) or uc_variants(rest, cs)
}

fn uc_tes(ts: [TypeExpr], cs: [String]) : Bool = match ts {
  [] -> false
  [t, ...rest] -> uc_te(t, cs) or uc_tes(rest, cs)
}

# A spelling the parser keeps for the formatter is dissolved before this
# runs; it counts as carrying, the safe answer.
fn uc_te(t: TypeExpr, cs: [String]) : Bool = match t.tkind {
  TyFn(_, _, _)   -> true
  TyName(_, n, args) -> list_has(cs, n) or uc_tes(args, cs)
  TyList(a)       -> uc_te(a, cs)
  TyDim(a, _)     -> uc_te(a, cs)
  TyRefine(a, _)  -> uc_te(a, cs)
  TyRow(_)        -> true
  TySurface(_)    -> true
}
