#[doc("""
compiler.layout_derive - the `#[derive(Layout)]` impl builder.

Emits `impl Layout for T { fn to_bytes(self) ... fn from_bytes(buf, pos) ... }`
for a record whose fields are all `U<N><be|le>`, plus a `<lower(T)>_from_bytes`
shim (single dispatch cannot route on a return type; same rationale as
BinSerialize's shim).

The bytes are positional and byte-exact: field K lands at its declared width
in its declared order, nothing else is written. That is the whole point of
Layout as opposed to BinSerialize's structural format, so the encoder is the
same `bin_put_uint_be/le` fold `layout_synth` builds - only the trigger
(`#[derive]` instead of field shape) and the carrier (a protocol impl instead
of a global fn) differ.

`from_bytes` reads from `pos` rather than 0 and returns
`Result[BinCursor[T], String]`, so a Layout record composes inside a
cursor-threaded decode the same way a BinSerialize one does.

The derived type is named by its id; everything else a body mentions is
written text the resolver settles like source.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.core_builtins
import compiler.core_refs
import compiler.derive_reach
import compiler.emit_shared_proto
import compiler.kinds
import compiler.spec_names
import compiler.symtab
import compiler.util

# Fixed byte length of a Layout record: the sum of its field widths. The
# decoder bounds-checks once against this instead of per field.
fn ld_total_width(fields: [LayoutField], acc: Int) : Int = match fields {
  [] -> acc
  [f, ...rest] -> ld_total_width(rest, acc + lf_width(f))
}

fn ld_expr(k: ExprKind, line: Int, col: Int) : Expr = mk_expr(k, line, col)
fn ld_var(n: String, line: Int, col: Int) : Expr = mk_name(n, line, col)
fn ld_int(n: Int, line: Int, col: Int) : Expr = ld_expr(mk_int_synth(n), line, col)

fn ld_call(callee: String, args: [Expr], line: Int, col: Int) : Expr =
  ld_expr(ECall(ld_var(callee, line, col), args), line, col)

# A call of a function the core module of `Layout` declares.
fn ld_lib(callee: String, args: [Expr], line: Int, col: Int) : Expr =
  ld_expr(ECall(derive_lib_ref(callee, line, col), args), line, col)

fn ld_prim(b: CoreBuiltin, args: [Expr], line: Int, col: Int) : Expr =
  ld_expr(ECall(builtin_mk(b, line, col), args), line, col)

fn ld_ty(n: String, args: [TypeExpr], line: Int, col: Int) : TypeExpr =
  mk_ty(TyName(ref_written(n), args), line, col)

fn ld_param(name: String, ty: TypeExpr, line: Int, col: Int) : Param =
  Param { binder: binder_written(name), ptype: Some(ty), pline: line, pcol: col, pborrow: false }

fn ld_byte_arr(line: Int, col: Int) : TypeExpr =
  ld_ty("Array", [ld_ty("Byte", [], line, col)], line, col)

# `Result[BinCursor[T], String]` — the from_bytes return shared with
# BinSerialize.
fn ld_result_ty(d: DeriveFor, line: Int, col: Int) : TypeExpr {
  let cur_ty = ld_ty("BinCursor", [derive_self_ty(d, line, col)], line, col)
  ld_ty("Result", [cur_ty, ld_ty("String", [], line, col)], line, col)
}

#[doc("The `#[derive(Layout)]` decls for the type `t`, with the row of each function: the protocol impl plus the `from_bytes` shim. `tab` names the type and the module its functions are minted in. Nothing when the body is not an all-Layout-fields record.")]
pub(pkg) fn derive_layout_impl(tab: SymTab, t: SymId, body: TypeBody,
                          line: Int, col: Int) : Minted = match body {
  TBRecord(fields) -> match layout_fields_of(fields) {
    Some(lfs) -> {
      let d = DeriveFor { tab: tab, t: t, spell: (r) => rt_ref_name(tab, r) }
      minted_append(ld_impl(d, lfs, line, col), ld_shim(d, line, col))
    }
    None -> minted_none()
  }
  _ -> minted_none()
}

fn ld_impl(d: DeriveFor, lfs: [LayoutField], line: Int, col: Int) : Minted {
  let to_params = [ld_param("self", derive_self_ty(d, line, col), line, col)]
  let from_params = [ld_param("buf", ld_byte_arr(line, col), line, col),
                     ld_param("pos", ld_ty("Int", [], line, col), line, col)]
  derive_impl(d, CpLayout,
              [DeriveMethod("to_bytes", to_params, ld_byte_arr(line, col),
                            ld_to_bytes_body(lfs, line, col)),
               DeriveMethod("from_bytes", from_params, ld_result_ty(d, line, col),
                            ld_from_bytes_body(d, lfs, line, col))],
              line, col)
}

# `fn <lower(T)>_from_bytes(buf, pos)` — the non-overloaded entry point.
# Single dispatch picks the impl from the first argument, which here is the
# buffer, so the user cannot call `from_bytes` directly.
fn ld_shim(d: DeriveFor, line: Int, col: Int) : Minted {
  let params = [ld_param("buf", ld_byte_arr(line, col), line, col),
                ld_param("pos", ld_ty("Int", [], line, col), line, col)]
  let tname = derive_type_name(d)
  let mangled = concat_all(["__pimpl_Layout_", derive_type_spell(d), "_from_bytes"])
  let body = ld_call(mangled, [ld_var("buf", line, col), ld_var("pos", line, col)],
                     line, col)
  derive_fn(d, concat_all([ld_lower(tname, 0, string_length(tname), ""), "_from_bytes"]),
            params, ld_result_ty(d, line, col), body, line, col)
}

# ASCII lowercaser for the shim name. Local rather than shared with
# `protos` because this module precedes it in the bundle.
fn ld_lower(s: String, i: Int, n: Int, acc: String) : String =
  if i >= n { acc } else { match char_at(s, i) {
    None -> acc
    Some(c) -> {
      let nc = char_to_int(c)
      let lc = if nc >= 65 and nc <= 90 { int_to_char(nc + 32) } else { c }
      ld_lower(s, i + 1, n, string_concat(acc, "#{lc}"))
    }
  } }

# --- to_bytes -------------------------------------------------------
#
# Left fold of `bin_put_uint_be/le(acc, __detach_unit(self.f), width)` in
# declaration order, onto an empty buffer. `__detach_unit` erases the
# `<be>`/`<le>` brand (identity at runtime) so the plain-`Int` helper
# accepts the branded field.

fn ld_to_bytes_body(lfs: [LayoutField], line: Int, col: Int) : Expr =
  ld_enc_fold(lfs, ld_empty_buf(line, col), line, col)

fn ld_empty_buf(line: Int, col: Int) : Expr =
  ld_prim(CbArrayMake, [ld_int(0, line, col),
                         ld_lib("bin_byte", [ld_int(0, line, col)], line, col)],
          line, col)

fn ld_enc_fold(lfs: [LayoutField], acc: Expr, line: Int, col: Int) : Expr =
  match lfs {
    [] -> acc
    [f, ...rest] -> {
      let putter = match lf_order(f) {
        BigEndian    -> "bin_put_uint_be"
        LittleEndian -> "bin_put_uint_le"
      }
      let fld = ld_expr(EField(ld_var("self", line, col), lf_name(f)), line, col)
      let raw = ld_prim(CbDetachUnit, [fld], line, col)
      ld_enc_fold(rest, ld_lib(putter, [acc, raw, ld_int(lf_width(f), line, col)],
                                line, col), line, col)
    }
  }

# --- from_bytes -----------------------------------------------------
#
# One length check, then a match tower of `bin_get_uint_be/le(buf, pos + off, w)`
# reads. The reads cannot fail once the length check passes, but the getters
# return `Option`, so each arm still threads a `None -> Err(..)` branch rather
# than asserting.

fn ld_from_bytes_body(d: DeriveFor, lfs: [LayoutField], line: Int, col: Int) : Expr {
  let width = ld_total_width(lfs, 0)
  let have = ld_prim(CbArrayLength, [ld_var("buf", line, col)], line, col)
  let need = ld_expr(EBinop(BoAdd, ld_var("pos", line, col), ld_int(width, line, col)),
                     line, col)
  let short = ld_expr(EBinop(BoLt, have, need), line, col)
  let err = ld_call("Err", [ld_expr(EStr(ld_short_msg(derive_type_name(d)), false), line, col)], line, col)
  ld_expr(EIf(short, err, Some(ld_tower(d, lfs, 0, [], line, col))), line, col)
}

# `EStr` carries the raw source span, quotes included.
fn ld_short_msg(tname: String) : String =
  concat_all(["\"Layout ", tname, ": buffer too short\""])

fn ld_tower(d: DeriveFor, lfs: [LayoutField], off: Int, bound: [String],
            line: Int, col: Int) : Expr = match lfs {
  [] -> ld_ok_cursor(d, list_reverse(bound), off, line, col)
  [f, ...rest] -> {
    let getter = match lf_order(f) {
      BigEndian    -> "bin_get_uint_be"
      LittleEndian -> "bin_get_uint_le"
    }
    let at = ld_expr(EBinop(BoAdd, ld_var("pos", line, col), ld_int(off, line, col)),
                     line, col)
    let read = ld_lib(getter, [ld_var("buf", line, col), at,
                                ld_int(lf_width(f), line, col)], line, col)
    let ok = ld_tower(d, rest, off + lf_width(f), [lf_name(f), ...bound], line, col)
    let bind = mk_pat(PBind(binder_written(lf_name(f))), line, col)
    let some_arm = Arm(mk_pat(PVariant(ref_written("Some"), [bind]), line, col), None, ok)
    let none_arm = Arm(mk_pat(PVariant(ref_written("None"), []), line, col), None,
                       ld_call("Err", [ld_expr(EStr(ld_short_msg(derive_type_name(d)), false), line, col)],
                               line, col))
    ld_expr(EMatch(read, [some_arm, none_arm]), line, col)
  }
}

# `Ok(BinCursor { value: T { f: __attach_unit(f), .. }, pos: pos + width })`.
# `__attach_unit` re-applies the field's brand so the plain `Int` the getter
# returned fits the branded record field.
fn ld_ok_cursor(d: DeriveFor, names: [String], width: Int,
                line: Int, col: Int) : Expr {
  let rec_e = ld_expr(ERecordLit(DrSym(d.t), ld_field_inits(names, line, col)), line, col)
  let end = ld_expr(EBinop(BoAdd, ld_var("pos", line, col), ld_int(width, line, col)),
                    line, col)
  let cur = ld_expr(ERecordLit(ref_written("BinCursor"), [FI("value", rec_e), FI("pos", end)]),
                    line, col)
  ld_call("Ok", [cur], line, col)
}

fn ld_field_inits(names: [String], line: Int, col: Int) : [FieldInit] = match names {
  [] -> []
  [n, ...rest] -> [FI(n, ld_prim(CbAttachUnit, [ld_var(n, line, col)], line, col)),
                   ...ld_field_inits(rest, line, col)]
}

# One Layout field: its name, byte width, and byte order.
type LayoutField = LFld(String, Int, ByteOrder)
#                         name    width  order

#[doc("The field name of a Layout field.")]
fn lf_name(f: LayoutField) : String = match f { LFld(n, _, _) -> n }
#[doc("The byte width of a Layout field.")]
fn lf_width(f: LayoutField) : Int = match f { LFld(_, w, _) -> w }
#[doc("The byte order of a Layout field.")]
fn lf_order(f: LayoutField) : ByteOrder = match f { LFld(_, _, o) -> o }

#[doc("The Layout fields of a record body, or None if the record is not Layout-bearing (no field carries a `be`/`le` habitant) or mixes a non-Layout field in.")]
fn layout_fields_of(fields: [FieldDecl]) : Option[[LayoutField]] =
  lfo_loop(fields, [], false)

# Fold the field list. A record is Layout-bearing iff EVERY field is a
# Layout field and there is at least one - a single non-Layout field
# (a plain `Int`, a nested record, a TLV `Bytes<len>`) makes the whole
# record non-Layout, so it is left to the plain-record path and any
# `encode`/`decode` on it is rejected. A partial encoder is never
# generated.
fn lfo_loop(fields: [FieldDecl], acc: [LayoutField], saw: Bool) : Option[[LayoutField]] =
  match fields {
    [] -> if saw { Some(list_reverse(acc)) } else { None }
    [f, ...rest] -> match layout_field_of(f) {
      Some(lf) -> lfo_loop(rest, [lf, ...acc], true)
      None -> None
    }
  }

# A single field: `FD(_, name, TyDim(TyName("U32"), USym("be")), _)` ->
# `LFld("magic", 4, BigEndian)`. Any other shape is not a Layout field: a
# width annotation is a head written bare.
fn layout_field_of(fd: FieldDecl) : Option[LayoutField] = match fd {
  FD(_, name, te, _) -> match te.tkind {
    TyDim(base, u) -> match base.tkind {
      TyName(head, _) -> match layout_order_of(u) {
        Some(order) -> match layout_width_of(derive_bare_text(head)) {
          Some(w) -> Some(LFld(name, w, order))
          None -> None
        }
        None -> None
      }
      _ -> None
    }
    _ -> None
  }
}

# Kind resolution qualifies the habitant (`be` -> `Layout$be`) before
# this runs at rewrite time, so strip the qualifier first; pre-
# resolution (synthesis) the symbol is already bare.
#[doc("The byte order a habitant expr names, or `None` for anything else (a compound, a non-order symbol).")]
fn layout_order_of(u: UnitExprT) : Option[ByteOrder] = match u {
  USym(s) -> byte_order_of_atom(kind_sym_bare(s))
  _       -> None
}

# Only the unsigned heads carry a decode-clean unsigned round-trip; signed
# heads are a follow-up (sign extension), so they are not Layout-bearing yet.
#[doc("The byte width of an unsigned width annotation (`U32` -> 4); `None` for a signed one, `F32`, or any other name.")]
fn layout_width_of(name: String) : Option[Int] = match ffi_fixed_of_name(name) {
  Some(fx) -> if ffi_fixed_is_signed(fx) or ffi_fixed_is_float(fx) { None } else { Some(ffi_fixed_bits(fx) / 8) }
  None     -> None
}

# Why a field is not Layout-bearing. `LOk` keeps the walk total.
pub(pkg) type LayoutReject
  = LOk
  | LNoOrder(String)
  | LSigned(String)
  | LNotFixed(String)

#[doc("Classify one record field against the Layout rule. `tab` names a field type a scope pass already settled.")]
pub(pkg) fn layout_reject_of(tab: SymTab, fd: FieldDecl) : LayoutReject = match fd {
  FD(_, _, te, _) -> match te.tkind {
    TyDim(base, u) -> match base.tkind {
      TyName(r, _) ->
        if layout_order_name(u) { layout_head_reject(derive_bare_text(r), derive_ref_text(tab, r)) }
        else { LNoOrder(derive_ref_text(tab, r)) }
      _ -> LNotFixed(layout_head_name(tab, te))
    }
    _ -> {
      let width = layout_scalar_head(te)
      let head = layout_head_name(tab, te)
      if layout_is_signed_head(width) { LSigned(head) }
      else if layout_is_unsigned_head(width) { LNoOrder(head) }
      else { LNotFixed(head) }
    }
  }
}

# A habitant already carrying a byte order needs only a width check; a
# signed head there is the declared follow-up, not a malformed field.
# `width` is the annotation the head spells, `head` how a message names it.
fn layout_head_reject(width: String, head: String) : LayoutReject =
  if layout_is_unsigned_head(width) { LOk }
  else if layout_is_signed_head(width) { LSigned(head) }
  else { LNotFixed(head) }

# The width annotation the head of `te` may spell, empty when it spells none.
fn layout_scalar_head(te: TypeExpr) : String = match te.tkind {
  TyName(r, _)   -> derive_bare_text(r)
  TyDim(base, _) -> layout_scalar_head(base)
  TyRefine(b, _) -> layout_scalar_head(b)
  _              -> ""
}

fn layout_order_name(u: UnitExprT) : Bool = match layout_order_of(u) {
  Some(_) -> true
  None    -> false
}

fn layout_is_unsigned_head(n: String) : Bool = match layout_width_of(n) {
  Some(_) -> true
  None    -> false
}

fn layout_is_signed_head(n: String) : Bool = match ffi_fixed_of_name(n) {
  Some(fx) -> ffi_fixed_is_signed(fx)
  None     -> false
}

# The head name as the user wrote it, for the diagnostic. Lists and
# functions have no head name worth printing, so they render structurally.
#[doc("The head of a field type as a diagnostic names it.")]
pub(pkg) fn layout_head_name(tab: SymTab, te: TypeExpr) : String = match te.tkind {
  TyName(r, _)   -> derive_ref_text(tab, r)
  TyList(_)      -> "List"
  TyFn(_, _, _)  -> "Fn"
  TyDim(base, _) -> layout_head_name(tab, base)
  TyRefine(b, _) -> layout_head_name(tab, b)
  _              -> "?"
}

#[doc("The remedy sentence for a Layout rejection, or the empty string for `LOk`.")]
pub(pkg) fn layout_reject_why(r: LayoutReject) : String = match r {
  LOk -> ""
  LNoOrder(h) ->
    concat_all(["`", h, "` carries no byte order; add `<be>` or `<le>`"])
  LSigned(h) ->
    concat_all(["`", h, "` is signed; Layout covers the unsigned heads ",
                "`U8`/`U16`/`U32`/`U64` only"])
  LNotFixed(h) ->
    concat_all(["`", h, "` is not a fixed-width unsigned integer"])
}

#[doc("True when the rejection is a real failure.")]
pub(pkg) fn layout_reject_is_err(r: LayoutReject) : Bool = match r {
  LOk -> false
  _   -> true
}
