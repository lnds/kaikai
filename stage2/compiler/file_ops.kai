#[doc("The bare core file operations and the `fs.file` methods that replace them.")]

#[doc("Each bare file operation paired with its `fs.file` method.")]
pub(pkg) fn file_op_pairs() : [Pair[String, String]] = [
  Pair { fst: "read_file",        snd: "read"        },
  Pair { fst: "write_file",       snd: "write"       },
  Pair { fst: "file_append",      snd: "append"      },
  Pair { fst: "file_exists",      snd: "exists"      },
  Pair { fst: "file_delete",      snd: "delete"      },
  Pair { fst: "file_rename",      snd: "rename"      },
  Pair { fst: "file_read_bytes",  snd: "read_bytes"  },
  Pair { fst: "file_write_bytes", snd: "write_bytes" }
]

#[doc("The `fs.file` method that replaces the bare file operation `name`, when it is one.")]
pub(pkg) fn file_op_replacement(name: String) : Option[String] = lookup_file_op(file_op_pairs(), name)

#[doc("The bare names of the core file operations.")]
pub(pkg) fn file_op_names() : [String] = map(file_op_pairs(), .fst)

#[doc("The method paired with `name` in `ps`, when present.")]
pub(pkg) fn lookup_file_op(ps: [Pair[String, String]], name: String) : Option[String] = match ps {
  [] -> None
  [p, ...rest] -> if p.fst == name { Some(p.snd) } else { lookup_file_op(rest, name) }
}
