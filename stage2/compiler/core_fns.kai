#[doc("""
The stdlib functions a pass below the resolver singles out, by declaration.

Which of them a callee is gets asked of its id, never of its spelling: a
user function may be spelled like one of these, and only the resolved
reference carries the declaration's row. The ids are tabulated, since a
pass asks on every call; the symbol table selftest holds each equal to
the id its name and home derive.

A pass that runs before the resolver has only what the source wrote, and
reads a spelling there; nothing it recognises belongs here.
""")]

import compiler.ast

#[doc("A stdlib function a pass singles out.")]
pub type KnownFn = KfSpawn | KfSpawnActor | KfSpawnActorPolicy

#[doc("Every function with a constructor.")]
pub fn known_fns() : [KnownFn] = [KfSpawn, KfSpawnActor, KfSpawnActorPolicy]

#[doc("The name `f` is declared with.")]
pub fn known_fn_name(f: KnownFn) : String = match f {
  KfSpawn            -> "spawn"
  KfSpawnActor       -> "spawn_actor"
  KfSpawnActorPolicy -> "spawn_actor_policy"
}

#[doc("The home of the module that declares `f`.")]
pub fn known_fn_home(f: KnownFn) : String = match f {
  KfSpawn            -> "spawn"
  KfSpawnActor       -> "actor"
  KfSpawnActorPolicy -> "actor"
}

#[doc("The id of `f`'s declaration.")]
pub fn known_fn_id(f: KnownFn) : SymId = match f {
  KfSpawn            -> SymId(2706662557330909554)
  KfSpawnActor       -> SymId(5948856876204158501)
  KfSpawnActorPolicy -> SymId(4159613756523685806)
}

#[doc("The function whose declaration `s` is, or `None` for any other symbol.")]
pub fn known_fn_of(s: SymId) : Option[KnownFn] = match sym_raw(s) {
  2706662557330909554 -> Some(KfSpawn)
  5948856876204158501 -> Some(KfSpawnActor)
  4159613756523685806 -> Some(KfSpawnActorPolicy)
  _                   -> None
}

#[doc("True when a call to `f` runs its thunk argument on a fresh fiber.")]
pub fn known_fn_starts_fiber(f: KnownFn) : Bool = match f {
  KfSpawn            -> true
  KfSpawnActor       -> true
  KfSpawnActorPolicy -> true
}
