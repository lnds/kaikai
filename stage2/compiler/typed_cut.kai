#[doc("""
The per-module rebuild cut: decide whether a module can be restored
from its typed blob instead of re-inferred, and publish the blob when
it is.

A module is restorable only when every input its inference reads is
unchanged. Those inputs are three, and the key folds all three:

1. **The module's own post-cascade decls**, and whether the module is a
   root of the compile: a root's `main` types as an entry point. Keyed
   over the serialized decls, not the source text, so the ~15
   whole-program passes that run before the typer are already baked in.
2. **The interface it inherits.** Every export of every module folded
   before it, via the folded interface hash (`compiler.cache_iface_acc`)
   — so an upstream edit that leaves its interface unchanged does not
   invalidate this module.
3. **The cross-module context** — protocol impls, kind theories, the
   head-owner table, the program-wide type/effect declarations the
   typer looks up across the partition, and which function names more
   than one module declares. These are threaded around the
   fold, so a fine-grained attribution would have to model how each
   reaches an importer's inference; a change to any of them
   invalidates every module instead. Over-invalidating costs a miss;
   under-invalidating serves a stale interface, which is the one
   unsound failure.

Function *bodies* outside the module are deliberately excluded from
term 3: the whole-program lookups the typer performs across the
partition read type, effect and protocol declarations, and only the
names and homes of functions. That
exclusion is what makes a one-line body edit stop at its own module.
""")]

import compiler.ast_decl
import compiler.ast_ids
import compiler.util
import compiler.const_pattern
import compiler.symtab
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.infer_env_exhaust
import compiler.diag_type_text
import compiler.infer_apply
import compiler.unit_walk
import compiler.infer_program
import compiler.proto_ids
import compiler.scope_view
import compiler.cache_delta
import compiler.user_cache
import compiler.modules_paths
import compiler.diag_file
import compiler.type_home
import compiler.diag
import compiler.kind_theory
import compiler.doc_attr
import compiler.written
import compiler.core_cut
import compiler.core_front
import compiler.infer_index

#[doc("Per-module cut context: the cache directory (empty disables the cut), the cross-module context hash folded into every module key, the scope view of each file, the target module that owns untagged declarations, and the root modules.")]
pub type TypedCutCtx = TCC(String, String, FileViews, String, Roots, [(String, String)])

#[doc("Resolve the directory the typed blobs live in: an explicit project directory when the caller supplies one, else the entry file's own. A caller that compiles a copy of the entry outside the project must supply it, or the blobs are published where the next build will not look.")]
pub fn tcut_cache_dir(proj_dir: String, entry_path: String) : String =
  if proj_dir != "" { proj_dir }
  else { concat_all([dir_of(entry_path), "/", uc_cache_dir_name()]) }

#[doc("Whether the cut is live. A cut with no cache directory infers every module, which is the behaviour every non-build entry point wants.")]
pub fn tcut_on(ctx: TypedCutCtx) : Bool = match ctx { TCC(dir, _, _, _, _, _) -> dir != "" }

# ---- cross-module context hash ----------------------------------------
#
# The projection of the whole-program decl stream that the typer can
# reach across the module partition: type, effect, protocol, impl and
# unit declarations. A `DFn` contributes its name and signature shape
# only through its own module's term, so its body is not hashed here —
# that is the whole point of the cut.

fn is_xdecl(d: Decl) : Bool = match d {
  DType(_, _, _, _, _, _, _, _) -> true
  DEffect(_, _, _, _, _, _, _, _) -> true
  DProtocol(_, _, _, _, _, _, _) -> true
  DUnit(_, _, _, _, _, _, _) -> true
  _ -> false
}

# The three tables are rendered field-by-field, not by length: an impl
# retargeted onto a different type keeps the table's length and would
# otherwise slip through as an unchanged context. Each field is
# length-prefixed so no two different splits of the same characters
# render identically.

fn tc_field(s: String) : String =
  concat_all([int_to_string(string_length(s)), ":", s])

fn tc_fields(xs: [String]) : String =
  concat_all([int_to_string(list_length(xs)), "[",
              concat_all(map(xs, (x) => tc_field(x))), "]"])

fn tc_sym(s: SymId) : String = int_to_string(sym_raw(s))

# A reference keys by the declaration it names, by its text while written.
fn tc_ref(r: DeclRef) : String = match r {
  DrSym(s)              -> cat2("#", tc_sym(s))
  DrWritten(None, n)    -> written_text(n)
  DrWritten(Some(q), n) -> concat_all([written_text(q), ".", written_text(n)])
}

fn pir_chunk(p: ProtoImplReg) : String = match p {
  PIR(proto, target, op, impl_fn, es, ret, _) ->
    concat_all([tc_field(tc_sym(proto)), tc_field(tc_ref(target)), tc_field(written_text(op)), tc_field(tc_sym(impl_fn)),
                tc_fields(map(es, tc_ref)), tc_field(tc_ref(ret))])
}

fn hoe_chunk(h: HeadOwnerEntry) : String = match h {
  HOE(s, owners) -> concat_all([tc_field(tc_sym(s)), tc_fields(map(owners, tc_sym))])
}

fn kth_chunk(k: KindTheory) : String = match k {
  KTh(a, b) -> concat_all([tc_field(a), tc_field(b)])
}

#[doc("Build the cut context for one compile: the cache directory, the files' scope views, the root modules, plus a hash over the cross-module inputs the typer reads around the fold — the protocol-impl, kind-theory and head-owner tables, the program-wide type/effect declarations, and the function names several modules declare. Pass an empty directory to disable the cut.")]
pub fn tcut_ctx(cache_dir: String, all_program_decls: [Decl], tab: SymTab, target: String, roots: Roots,
                 protos: ProtoView, head_owners: [HeadOwnerEntry],
                 kind_theories: [KindTheory], views: FileViews, pool_hex: String, cycles: [[String]]) : TypedCutCtx = {
  let xhex = uc_content_hex(concat_all([tm_decls_hex(filter(all_program_decls, is_xdecl)), "|",
                                        concat_all(map(protos.impls, (p) => pir_chunk(p))), "|",
                                        concat_all(map(head_owners, (h) => hoe_chunk(h))), "|",
                                        concat_all(map(kind_theories, (k) => kth_chunk(k))), "|",
                                        tsh_fn_contests(all_program_decls, tab, target), "|", pool_hex, "|", tcut_pkg_only(tab, views, target)]))
  TCC(cache_dir, xhex, views, target, roots, tcut_cycle_digests(all_program_decls, target, views, cycles))
}

# Which declarations are exported to their package alone is part of what every module is typed against.
fn tcut_pkg_only(tab: SymTab, views: FileViews, target: String) : String =
  if list_is_empty(fv_of(views, st_module_id(target)).pkgs) { "" }
  else { string_join(map(filter(st_ids(tab), (s) => mint_package(sym_mint(tab, s))), (s) => int_to_string(sym_raw(s))), ",") }

# A module typed against the signatures of its import cycle depends on every
# peer's declarations and imports, which the inherited interface does not carry.
fn tcut_cycle_digests(decls: [Decl], target: String, views: FileViews, cycles: [[String]]) : [(String, String)] =
  if list_is_empty(cycles) { [] } else {
    let by_home = partition_decls_by_home(decls, target)
    flat_map(cycles, (g) => {
      let d = uc_content_hex(concat_all(map(g, (h) => concat_all([h, "=", tm_decls_hex(tcut_decls_of(by_home, h)), sv_key(fv_of(views, st_module_id(h)))]))))
      map(g, (h) => (h, d))
    })
  }

fn tcut_decls_of(ms: [ModuleDecls], h: String) : [Decl] = match ms {
  [] -> []
  [m, ...rest] -> if tcx_same(m.name, Some(h)) { m.decls } else { tcut_decls_of(rest, h) }
}

fn tcut_cycle_of(cyc: [(String, String)], name: String) : String = match cyc {
  [] -> ""
  [(h, d), ...rest] -> if h == name { d } else { tcut_cycle_of(rest, name) }
}

# ---- key + lookup + publish -------------------------------------------

#[doc("The typed-module cache key for one module folded against an inherited interface, under the given cut context. The module's own file view is part of it: an import changes what a bare name reaches without changing a declaration. So is whether the module is a root: its `main` types as an entry point only then.")]
pub fn tcut_key(ctx: TypedCutCtx, m: ModuleDecls, inherited: IfaceAcc) : String = match ctx {
  TCC(_, xhex, views, target, roots, cyc) -> {
    let name = unwrap_or(m.name, target)
    let home = st_module_id(name)
    let root = if is_root_module(roots, home) { "|root" } else { "|" }
    tm_key_hex(uc_content_hex(concat_all([tm_decls_hex(m.decls), "|", sv_key(fv_of(views, home)), root, "|", tcut_cycle_of(cyc, name)])),
               iface_acc_hash(inherited), xhex)
  }
}

#[doc("Look up a module's typed blob by key; `None` on a disabled cut, a missing blob, or any header/payload drift.")]
pub fn tcut_lookup(ctx: TypedCutCtx,
                    key: String) : Option[TypecheckedModule] / Console + File =
  match ctx {
    TCC(dir, _, _, _, _, _) -> if dir == "" { None }
                   else { tcut_read(dir, key) }
  }

fn tcut_read(dir: String, key: String) : Option[TypecheckedModule] / Console + File =
  match __file_read_bytes(tm_blob_path(dir, key)) {
    Err(_) -> None
    Ok(blob) -> cache_deserialize_tcmodule(blob)
  }

#[doc("Publish a module's typed blob for its key. A write failure is swallowed — a cache that cannot be written is a performance loss, never a correctness one.")]
pub fn tcut_publish(ctx: TypedCutCtx, key: String,
                     m: TypecheckedModule) : Unit / Console + File = match ctx {
  TCC(dir, _, _, _, _, _) -> if dir == "" { () }
                 else {
                   cache_publish_bytes(tm_blob_path(dir, key),
                                       cache_serialize_tcmodule(m, tm_header_sha(key)))
                 }
}

# ---- the fold, with the cut -------------------------------------------
#
# Mirrors `typecheck_program_loop` in `compiler.infer`, with one
# difference: each module is looked up by key first and only inferred on
# a miss. The accumulators, their order, and the terminal `TypedProgram`
# assembly are identical, so a build in which every module misses is
# byte-identical to the uncut fold.

type TCFold = TCF([Decl], Int, [ResolvedCS], [ResolvedHole], [ResolvedRowHole],
                   [Diagnostic], [OpResolution], Int, Int)

fn tcf_empty() : TCFold = TCF([], 0, [], [], [], [], [], 0, 0)

fn tcf_step(acc: TCFold, tm: TypecheckedModule) : TCFold = match acc {
  TCF(ds, errs, insts, holes, rhs, diags, ops, core_len, _) -> {
    let tp = tm.typed
    let next_core_len = match core_len { 0 -> tp.core_len
                                         _ -> core_len }
    TCF(prepend_reverse_decls(tp.decls, ds), errs + tp.errs,
        llvm_prepend_reverse(tp.insts, insts),
        prepend_reverse_holes(tp.holes, holes),
        prepend_reverse_row_holes(tp.row_holes, rhs),
        prepend_reverse_diags(tp.diags, diags),
        prepend_reverse_op_res(tp.op_res, ops),
        next_core_len, tp.toplevel_len)
  }
}

fn tcf_finish(acc: TCFold, all_program_decls: [Decl]) : TypedProgram = match acc {
  TCF(ds, errs, insts, holes, rhs, diags, ops, core_len, toplevel_len) ->
    TypedProgram {
      decls: list_reverse(ds), errs: errs, insts: list_reverse(insts),
      holes: list_reverse(holes), row_holes: list_reverse(rhs),
      core_len: core_len, toplevel_len: toplevel_len,
      module_doc: doc_module_doc_text(all_program_decls),
      diags: list_reverse(diags), op_res: list_reverse(ops)
    }
}

#[doc("The core functions the front end types only when the typed program needs them: the lookups of the candidates, and the declarations in program order, which the late ones are put back into.")]
pub type TcDefer = { demand: Option[Demand], order: [Decl], stats: Bool, front: Option[FrontSrc] }

#[doc("A fold with nothing deferred.")]
pub fn tcut_no_defer() : TcDefer = TcDefer { demand: None, order: [], stats: false, front: None }

#[doc("A typed program and the core functions it asked for that the early cut left without a body.")]
pub type TcOut = TcOut(TypedProgram, [SymId])

# A module as the fold met it, and the front a late batch of its functions is typed against.
type TcCtx = TcX(ModuleDecls, ModuleEnvDelta, TcShared, Option[ModuleFront], Int)

# The fold so far, the declarations its last pass typed, and the modules met.
type TCLoop = TCL(TCFold, ModuleEnvDelta, IfaceAcc, TcShared, [Decl], [TcCtx])

type TcMod = TcMod(TypecheckedModule, Option[ModuleFront])

#[doc("Fold the per-module typechecker across a partitioned decl stream, restoring each module from its typed blob when the cut's key matches and inferring it otherwise. With the cut disabled every module is inferred, which is byte-identical to the uncut fold. The core functions left to the demand scan are typed afterwards, until no more are asked for.")]
pub fn tcut_typecheck_program(file: String, df: DiagFiles, modules: [ModuleDecls], full: [ModuleDecls],
                               ctx: TypedCutCtx,
                               protos: ProtoView,
                               head_owners: [HeadOwnerEntry],
                               kind_theories: [KindTheory],
                               tab: SymTab, views: FileViews, roots: Roots,
                               defer: TcDefer,
                               verbose: Bool) : TcOut / Console + File + Mutable = {
  let all_program_decls = flatten_module_decls(modules, [])
  let sh0 = tc_shared(file, df, match defer.demand { Some(_) -> flatten_module_decls(full, [])  None -> all_program_decls }, tab, views, roots)
  let sh = match defer.demand { Some(dm) -> TcShared { ...sh0, pool: dm.sigs }  None -> sh0 }
  let first = tcut_loop(file, df, modules, all_program_decls, ctx, protos, head_owners,
                         kind_theories, tab, verbose, defer.demand,
                         TCL(tcf_empty(), module_env_delta_empty(), iface_acc_empty(), sh, [], []))
  match defer.demand {
    None -> TcOut(tcf_finish(match first { TCL(acc, _, _, _, _, _) -> acc }, all_program_decls), [])
    Some(dm) -> {
      let first_acc = match first { TCL(a, _, _, _, _, _) -> a }
      let done = tcut_demand(file, df, all_program_decls, protos, head_owners, kind_theories, tab, verbose, dm,
                              dm_empty(), defer.stats, full, first, [], [], defer.front, None)
      match done {
        TcDone(TCL(acc, _, _, _, _, ctxs), ms, late) -> {
          let tp = tcf_finish(tcf_keep_toplevel(acc, first_acc), all_program_decls)
          let firsts = tcf_finish(first_acc, all_program_decls).decls
          TcOut(TypedProgram { ...tp, decls: tcut_weave(file, defer.order, dm, list_reverse(ctxs), firsts, late) }, ms)
        }
      }
    }
  }
}

# The typed program in the order the modules of what it keeps give: each late function takes the place it has in its module.
fn tcut_weave(file: String, order: [Decl], dm: Demand, ctxs: [TcCtx], firsts: [Decl], late: [Decl]) : [Decl] = {
  let slices = tcut_slices(ctxs, firsts, [])
  let lates = foldl(late, idx_empty(), (ix, d) => idx_prepend_sym(ix, tcg_decl_sym(d), d))
  let kept = filter(order, (d) => not demand_pooled(dm, tcg_decl_sym(d)) or tcx_asked(lates, d))
  flat_map(partition_decls_by_home(kept, root_module_name(file)), (m) => tcut_weave_module(dm, lates, m.decls, tcut_slice_of(slices, m.name), []))
}

type TcSlice = TcSlice(Option[String], [Decl])

fn tcut_slices(ctxs: [TcCtx], rest: [Decl], acc: [TcSlice]) : [TcSlice] = match ctxs {
  [] -> acc
  [TcX(m, _, _, _, c), ...more] -> tcut_slices(more, drop(rest, c), [TcSlice(m.name, take(rest, c)), ...acc])
}

fn tcut_slice_of(ss: [TcSlice], name: Option[String]) : [Decl] = match ss {
  [] -> []
  [TcSlice(n, ds), ...rest] -> if tcx_same(n, name) { ds } else { tcut_slice_of(rest, name) }
}

fn tcut_weave_module(dm: Demand, lates: NameIndex[Decl], orig: [Decl], first: [Decl], acc: [Decl]) : [Decl] = match orig {
  [] -> list_append(list_reverse(acc), first)
  [o, ...rest] -> if demand_pooled(dm, tcg_decl_sym(o)) {
    tcut_weave_module(dm, lates, rest, first, list_append(list_reverse(idx_chain_sym(lates, tcg_decl_sym(o))), acc))
  } else { match first {
    [f, ...more] -> tcut_weave_module(dm, lates, rest, more, [f, ...acc])
    []           -> tcut_weave_module(dm, lates, rest, [], acc)
  } }
}

fn tcf_keep_toplevel(acc: TCFold, first: TCFold) : TCFold = match acc {
  TCF(ds, errs, insts, holes, rhs, diags, ops, core_len, _) -> match first {
    TCF(_, _, _, _, _, _, _, _, toplevel_len) -> TCF(ds, errs, insts, holes, rhs, diags, ops, core_len, toplevel_len)
  }
}

# The fold once nothing more is asked for, and the asked-for functions that had no body.
type TcDone = TcDone(TCLoop, [SymId], [Decl])

fn tcut_demand(file: String, df: DiagFiles, all_program_decls: [Decl], protos: ProtoView,
                head_owners: [HeadOwnerEntry], kind_theories: [KindTheory], tab: SymTab, verbose: Bool,
                dm: Demand, st: DmSt, stats: Bool, full: [ModuleDecls], lp: TCLoop, missed: [SymId], late: [Decl],
                src: Option[FrontSrc], fc: Option[FrontCtx]) : TcDone / Console + File + Mutable = match lp {
  TCL(acc, inherited, iface, sh, fresh, ctxs) -> match demand_take(demand_scan(dm, st, fresh)) {
    DmTake(want, miss, st2) -> if list_is_empty(want) { TcDone(lp, list_append(miss, missed), late) } else {
      let _note = if stats { eprint("kaic2: core-demand: typing #{list_length(want)}: #{string_join(core_cut_names(tab, want), ", ")}") } else { () }
      let asked = foldl(want, idx_empty(), (ix, s) => idx_prepend_sym(ix, s, s))
      let fc2 = match fc { Some(_) -> fc  None -> map(src, front_ctx) }
      let batches = filter(map(full, (m) => ModuleDecls { name: m.name, decls: map(filter(m.decls, (d) => tcx_asked(asked, d)), (d) => tcut_completed(dm, src, fc2, d)) }), (m) => not list_is_empty(m.decls))
      match tcut_batches(file, df, all_program_decls, protos, head_owners, kind_theories, tab, verbose, sh, inherited, batches, acc, ctxs, []) {
        TcB(acc2, ctxs2, typed) -> tcut_demand(file, df, all_program_decls, protos, head_owners, kind_theories, tab, verbose, dm, st2, stats, full,
                                                TCL(acc2, inherited, iface, sh, typed, ctxs2), list_append(miss, missed), list_append(typed, late), src, fc2)
      }
    }
  }
}

# A function whose body an earlier cut emptied is completed from its parsed declaration.
fn tcut_completed(dm: Demand, src: Option[FrontSrc], fc: Option[FrontCtx], d: Decl) : Decl / Console + File =
  if not demand_emptied(dm, tcg_decl_sym(d)) { d }
  else { match src {
    Some(sr) -> match fc {
      Some(f) -> match front_complete(f, sr.env, tcg_decl_sym(d)) {
        Some(c) -> c
        None -> panic("a function the cut emptied has no parsed declaration")
      }
      None -> panic("a function the cut emptied is asked for before the tables to complete it exist")
    }
    None -> d
  } }

type TcB = TcB(TCFold, [TcCtx], [Decl])

fn tcut_batches(file: String, df: DiagFiles, all_program_decls: [Decl], protos: ProtoView,
                 head_owners: [HeadOwnerEntry], kind_theories: [KindTheory], tab: SymTab, verbose: Bool,
                 sh: TcShared, inherited: ModuleEnvDelta, bs: [ModuleDecls], acc: TCFold, ctxs: [TcCtx],
                 typed: [Decl]) : TcB / Console + File + Mutable = match bs {
  [] -> TcB(acc, ctxs, typed)
  [b, ...rest] -> match tcx_front(file, head_owners, tab, b.name, TcX(ModuleDecls { name: b.name, decls: [] }, inherited, sh, None, 0), ctxs, []) {
    TcFr(fr, inh, ctxs2) -> {
      let own = ModuleFront { ...fr, data: ProgramData { ...fr.data, decls_a: expand_unit_aliases_decls(b.decls, unit_alias_compose(fr.delta.unit_aliases, inh.unit_aliases)) } }
      let tm = module_bodies(file, df, b, own, all_program_decls, protos, kind_theories, tab, sh, verbose)
      tcut_batches(file, df, all_program_decls, protos, head_owners, kind_theories, tab, verbose, sh, inherited, rest,
                    tcf_step(acc, tm), ctxs2, list_append(tm.typed.decls, typed))
    }
  }
}

fn tcx_asked(asked: NameIndex[a], d: Decl) : Bool = match idx_chain_sym(asked, tcg_decl_sym(d)) {
  [] -> false
  _  -> true
}

fn tcx_same(a: Option[String], b: Option[String]) : Bool = match a {
  Some(x) -> match b { Some(y) -> x == y  None -> false }
  None    -> match b { Some(_) -> false  None -> true }
}

type TcFr = TcFr(ModuleFront, ModuleEnvDelta, [TcCtx])

# The front of the module `name`, computed on the first batch that needs it, and the modules with it kept.
fn tcx_front(file: String, head_owners: [HeadOwnerEntry], tab: SymTab, name: Option[String], bare: TcCtx,
              ctxs: [TcCtx], seen: [TcCtx]) : TcFr / Console + File + Mutable = match ctxs {
  [] -> match bare {
    TcX(m, inherited, sh, _, c) -> {
      let got = module_front(file, m, inherited, head_owners, tab, sh)
      TcFr(got, inherited, [TcX(m, inherited, sh, Some(got), c), ...list_reverse(seen)])
    }
  }
  [TcX(m, inherited, sh, fr, c), ...rest] ->
    if tcx_same(m.name, name) {
      let got = match fr { Some(f) -> f  None -> module_front(file, m, inherited, head_owners, tab, sh) }
      TcFr(got, inherited, list_append(list_reverse(seen), [TcX(m, inherited, sh, Some(got), c), ...rest]))
    } else { tcx_front(file, head_owners, tab, name, bare, rest, [TcX(m, inherited, sh, fr, c), ...seen]) }
}

fn tcg_decl_sym(d: Decl) : SymId = match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) -> fnid_sym(fid)
  _ -> sym_none()
}

fn tcut_loop(file: String, df: DiagFiles, modules: [ModuleDecls],
              all_program_decls: [Decl], ctx: TypedCutCtx,
              protos: ProtoView, head_owners: [HeadOwnerEntry],
              kind_theories: [KindTheory], tab: SymTab, verbose: Bool, dm: Option[Demand],
              lp: TCLoop) : TCLoop / Console + File + Mutable = match modules {
  [] -> lp
  [m, ...rest] -> match tcut_unit(ctx, m, rest) {
    TcU([_], _) -> match lp {
      TCL(_, inherited, iface, sh, _, _) -> {
        let r = tcut_module(file, df, m, inherited, iface, all_program_decls, ctx,
                             protos, head_owners, kind_theories, tab, sh, verbose, dm)
        tcut_loop(file, df, rest, all_program_decls, ctx, protos, head_owners, kind_theories, tab, verbose, dm,
                   tcut_absorb(m, match r { TcMod(t, _) -> t }, match r { TcMod(_, f) -> f }, dm, ctx, inherited, sh, lp))
      }
    }
    TcU(members, after) -> tcut_loop(file, df, after, all_program_decls, ctx, protos, head_owners, kind_theories, tab, verbose, dm,
                                      tcut_unit_run(file, df, members, all_program_decls, ctx, protos, head_owners, kind_theories, tab, verbose, dm, lp))
  }
}

# The modules the fold takes together: the head and, when it is in an import cycle, the rest of the cycle that follows it.
type TcU = TcU([ModuleDecls], [ModuleDecls])

fn tcut_unit(ctx: TypedCutCtx, m: ModuleDecls, rest: [ModuleDecls]) : TcU = match ctx {
  TCC(_, _, _, target, _, cyc) -> {
    let d = tcut_cycle_of(cyc, unwrap_or(m.name, target))
    if d == "" { TcU([m], rest) } else { tcut_unit_take(cyc, target, d, rest, [m]) }
  }
}

fn tcut_unit_take(cyc: [(String, String)], target: String, d: String, rest: [ModuleDecls], acc: [ModuleDecls]) : TcU = match rest {
  [] -> TcU(list_reverse(acc), [])
  [r, ...more] -> if tcut_cycle_of(cyc, unwrap_or(r.name, target)) == d { tcut_unit_take(cyc, target, d, more, [r, ...acc]) }
                  else { TcU(list_reverse(acc), rest) }
}

# Fold one typed module into the loop state.
fn tcut_absorb(m: ModuleDecls, tm: TypecheckedModule, fr: Option[ModuleFront], dm: Option[Demand], ctx: TypedCutCtx,
                seen: ModuleEnvDelta, seen_sh: TcShared, lp: TCLoop) : TCLoop = match lp {
  TCL(acc, inherited, iface, sh, fresh, ctxs) ->
    TCL(tcf_step(acc, tm), merge_env_deltas(inherited, tm.delta),
        tcut_iface_next(ctx, iface, tm.delta), tc_shared_extend(sh, tm.delta),
        if is_some(dm) { list_append(tm.typed.decls, fresh) } else { fresh },
        if is_some(dm) { [TcX(m, seen, seen_sh, fr, list_length(tm.typed.decls)), ...ctxs] } else { ctxs })
}

# An import cycle restores when every member's key hits and is typed together otherwise.
fn tcut_unit_run(file: String, df: DiagFiles, members: [ModuleDecls], all_program_decls: [Decl], ctx: TypedCutCtx,
                  protos: ProtoView, head_owners: [HeadOwnerEntry], kind_theories: [KindTheory], tab: SymTab,
                  verbose: Bool, dm: Option[Demand], lp: TCLoop) : TCLoop / Console + File + Mutable = match lp {
  TCL(_, inherited, iface, sh, _, _) -> {
    let keys = map(members, (m) => tcut_key(ctx, m, iface))
    let hits = map(keys, (k) => tcut_lookup(ctx, k))
    let tms = if all(hits, (h) => is_some(h)) { flat_map(hits, (h) => match h { Some(t) -> [t]  None -> [] }) } else {
      let got = tcut_unit_consts(typecheck_unit(file, df, members, inherited, all_program_decls, protos, head_owners, kind_theories, tab, sh, verbose), tab, df)
      if tcut_on(ctx) { each(zip(keys, got), (kt) => if kt.snd.typed.errs == 0 { tcut_publish(ctx, kt.fst, kt.snd) } else { () }) } else { () }
      got
    }
    tcut_absorb_all(members, tms, map(tms, .delta), 0, inherited, sh, dm, ctx, lp)
  }
}

# The constants of a cycle cannot be checked one module at a time: the loop closes across the members.
fn tcut_unit_consts(tms: [TypecheckedModule], tab: SymTab, df: DiagFiles) : [TypecheckedModule] / Console + File = {
  let ds = const_cycle_diags(flat_map(tms, .typed.decls), tab, df)
  if list_is_empty(ds) { tms } else {
    let n = list_length(tms) - 1
    list_append(take(tms, n), map(drop(tms, n), (t) => tcut_with_diags(t, ds)))
  }
}

fn tcut_with_diags(t: TypecheckedModule, ds: [Diagnostic]) : TypecheckedModule =
  TypecheckedModule { ...t, typed: typed_with_diags(t.typed, ds) }

fn typed_with_diags(tp: TypedProgram, ds: [Diagnostic]) : TypedProgram =
  TypedProgram { ...tp, errs: tp.errs + list_length(ds), diags: list_append(tp.diags, ds) }

# A program typed whole has its constant cycles checked here, as a unit does in `tcut_unit_consts`.
fn tcut_program_consts(tp: TypedProgram, tab: SymTab, df: DiagFiles) : TypedProgram / Console + File = {
  let ds = const_cycle_diags(tp.decls, tab, df)
  if list_is_empty(ds) { tp } else {
    typed_with_diags(tp, ds)
  }
}

fn tcut_mod_consts(r: TcMod, tab: SymTab, df: DiagFiles) : TcMod / Console + File = match r {
  TcMod(t, f) -> TcMod(TypecheckedModule { ...t, typed: tcut_program_consts(t.typed, tab, df) }, f)
}

# A cycle member is typed again against the environment the whole cycle gives, as `typecheck_unit` typed it.
fn tcut_absorb_all(ms: [ModuleDecls], tms: [TypecheckedModule], ds: [ModuleEnvDelta], i: Int, inherited: ModuleEnvDelta, sh: TcShared,
                    dm: Option[Demand], ctx: TypedCutCtx, lp: TCLoop) : TCLoop = match ms {
  [] -> lp
  [m, ...rest] -> match tms {
    [tm, ...more] -> {
      let others = list_append(take(ds, i), drop(ds, i + 1))
      let seen = foldl(others, inherited, (a, d) => merge_env_deltas(a, d))
      let seen_sh = foldl(others, sh, (s, d) => tc_shared_extend(s, d))
      tcut_absorb_all(rest, more, ds, i + 1, inherited, sh, dm, ctx, tcut_absorb(m, tm, None, dm, ctx, seen, seen_sh, lp))
    }
    [] -> lp
  }
}

# The interface only feeds the keys, so an uncut fold never builds it.
fn tcut_iface_next(ctx: TypedCutCtx, iface: IfaceAcc, d: ModuleEnvDelta) : IfaceAcc =
  if tcut_on(ctx) { iface_acc_extend(iface, d) } else { iface }

fn tcut_compute(file: String, df: DiagFiles, m: ModuleDecls, inherited: ModuleEnvDelta,
                 all_program_decls: [Decl], protos: ProtoView, head_owners: [HeadOwnerEntry],
                 kind_theories: [KindTheory], tab: SymTab, sh: TcShared,
                 verbose: Bool, dm: Option[Demand]) : TcMod / Console + File + Mutable = match dm {
  None -> TcMod(typecheck_module(file, df, m, inherited, all_program_decls, protos,
                                  head_owners, kind_theories, tab, sh, verbose), None)
  Some(_) -> {
    let fr = module_front(file, m, inherited, head_owners, tab, sh)
    TcMod(module_bodies(file, df, m, fr, all_program_decls, protos, kind_theories, tab, sh, verbose), Some(fr))
  }
}

# One module: restore it when its key hits, infer and publish otherwise.
# The key is computed once and reused for the publish, so a hit and the
# miss that would have replaced it name the same blob.
fn tcut_module(file: String, df: DiagFiles, m: ModuleDecls, inherited: ModuleEnvDelta,
                iface: IfaceAcc, all_program_decls: [Decl], ctx: TypedCutCtx,
                protos: ProtoView, head_owners: [HeadOwnerEntry],
                kind_theories: [KindTheory], tab: SymTab, sh: TcShared,
                verbose: Bool, dm: Option[Demand]) : TcMod / Console + File + Mutable = {
  if not tcut_on(ctx) {
    tcut_mod_consts(tcut_compute(file, df, m, inherited, all_program_decls, protos, head_owners, kind_theories, tab, sh, verbose, dm), tab, df)
  } else {
    let key = tcut_key(ctx, m, iface)
    match tcut_lookup(ctx, key) {
      Some(hit) -> TcMod(hit, None)
      None -> {
        let r = tcut_mod_consts(tcut_compute(file, df, m, inherited, all_program_decls, protos, head_owners, kind_theories, tab, sh, verbose, dm), tab, df)
        let tm = match r { TcMod(t, _) -> t }
        # A module that produced errors is not published: its typed artifact is
        # a partial result the next build must reproduce, diagnostics and all.
        if tm.typed.errs == 0 { tcut_publish(ctx, key, tm) } else { () }
        r
      }
    }
  }
}

#[doc("The cut-aware counterpart of `infer_program`: partition the post-cascade decl stream by home module, then fold the per-module typechecker across it under the cut. An empty cache directory disables the cut and reproduces the uncut path exactly.")]
pub fn tcut_infer_program(file: String, decls: [Decl], cache_dir: String, tin: TyperIn,
                           defer: TcDefer, verbose: Bool) : TypedProgram / Console + File + Mutable =
  match tcut_infer_demand(file, decls, cache_dir, tin, defer, verbose) { TcOut(tp, _) -> tp }

#[doc("`tcut_infer_program` with the core functions the demand scan asked for that had no body.")]
pub fn tcut_infer_demand(file: String, decls: [Decl], cache_dir: String, tin: TyperIn,
                          defer: TcDefer, verbose: Bool) : TcOut / Console + File + Mutable = {
  match tcut_infer_collect(file, decls, cache_dir, tin, defer, verbose) {
    TcOut(tp, pooled) -> {
      each(tp.diags, render_diag)
      TcOut(tp, pooled)
    }
  }
}

fn tcut_infer_collect(file: String, decls: [Decl], cache_dir: String, tin: TyperIn,
                      defer: TcDefer, verbose: Bool) : TcOut / Console + File + Mutable = {
  let full = partition_decls_by_home(decls, root_module_name(file))
  let mods0 = match defer.demand {
    Some(dm) -> filter(map(full, (m) => ModuleDecls { name: m.name, decls: filter(m.decls, (d) => not demand_pooled(dm, tcg_decl_sym(d))) }),
                       (m) => not list_is_empty(m.decls))
    None -> full
  }
  # One bucket (or none) means there is nothing to cut: the fold would
  # re-infer the whole program on any edit anyway, so run it uncut.
  match mods0 {
    []  -> TcOut(tcut_program_consts(infer_program_collect(file, flatten_module_decls(full, []), tin, verbose), tin.tab, tin.df), [])
    [_] -> if is_none(defer.demand) { TcOut(tcut_program_consts(infer_program_collect(file, decls, tin, verbose), tin.tab, tin.df), []) } else { tcut_infer_modules(file, mods0, full, cache_dir, tin, defer, verbose) }
    _   -> tcut_infer_modules(file, mods0, full, cache_dir, tin, defer, verbose)
  }
}

fn tcut_infer_modules(file: String, mods0: [ModuleDecls], full: [ModuleDecls], cache_dir: String, tin: TyperIn,
                       defer: TcDefer, verbose: Bool) : TcOut / Console + File + Mutable = {
  let pool_hex = match defer.demand { Some(dm) -> if cache_dir == "" { "" } else { demand_digest(tin.tab, dm) }  None -> "" }
  let ctx = tcut_ctx(cache_dir, flatten_module_decls(mods0, []), tin.tab, root_module_name(file), tin.roots,
                      tin.protos, tin.head_owners, tin.kind_theories, tin.views, pool_hex, tin.cycles)
  tcut_typecheck_program(file, tin.df, mods0, full, ctx, tin.protos, tin.head_owners,
                          tin.kind_theories, tin.tab, tin.views, tin.roots, defer, verbose)
}
