# What a handle body performs through row variables is discharged too: their
# bound labels join the body row, and only their open residues stay tails.
#[doc("Typer-internal helper `st_scope_tails` shared across the infer modules.")]
pub fn st_scope_tails(st: InferState, outer: [TailUse]) : InferState / Mutable = {
  let st1 = st_add_tail_labels(st, st.row_tails)
  InferState { ...st1, row_tails: residual_tails(st1.sub, st1.row_tails, outer) }
}


#[doc("Typer-internal helper `bind_clause_env_typed` shared across the infer modules.")]
pub fn bind_clause_env_typed(st: InferState, eff: SymId, op_name: String,
                          params: [Param], stateful: Bool,
                          state_ty: Option[Ty], eff_tyargs: [Ty], result_ty: Ty) : ClauseBindRes / Console + File + Mutable {


  let key = "#{decl_name(st.env.tab, eff)}.#{op_name}"
  match env_op(st.env, eff, written(op_name)) {
    None     -> ClauseBindRes { st: bind_params_lenient(st, params), answer_ty: TyAny, op_rigid: [] }
    Some(sc) -> {
      let inst = st_instantiate_report(st, sc)
      # unify the op-scheme's effect-tparam fresh tyvars
      # with the handler's instantiation. For State[Int], `get`'s
      # bound `?Tfresh` becomes `Int`, so the resume answer type is
      # `Int` rather than a free tyvar.
      let eff_arity = lookup_op_eff_arity(st.op_eff_arities, eff)
      let st_unified = unify_eff_tparams(inst.st, take(inst.fresh, eff_arity), eff_tyargs,
                                          op_name)
      # The op's own type parameters are chosen per perform, so the
      # clause must handle every choice: rigid for the clause body.
      let op_rigid = drop(inst.fresh, eff_arity)
      let st_rigid = st_set_sub(st_unified, subst_with_rigid(st_unified.sub,
                       list_append(map(op_rigid, (i) => RigidTv(i, None, key)), st_unified.sub.rigid)))
      match inst.ty {
        TyFnT(arg_tys, ret_ty, _) -> {
          let bound = bind_params_with_sig_typed(st_rigid, params, arg_tys, ret_ty,
                                                   stateful, state_ty, result_ty)
          ClauseBindRes { st: bound, answer_ty: ret_ty, op_rigid: op_rigid }
        }
        _ -> ClauseBindRes { st: bind_params_lenient(st_rigid, params), answer_ty: TyAny, op_rigid: op_rigid }
      }
    }
  }
}


# The handler state, the clause's result, or a var that predates the
# clause resolving to one of the op's own type parameters would carry
# one perform's choice past the clause.
#[doc("Typer-internal helper `check_op_tparam_escape` shared across the infer modules.")]
pub fn check_op_tparam_escape(st: InferState, rigid: [Int], before: Int, state_ty: Option[Ty],
                          body_ty: Ty, line: Int, col: Int) : InferState / Console + File =
  match rigid {
    [] -> st
    _  -> match op_tparam_escape_site(st.sub, rigid, before, state_ty, body_ty) {
      None      -> st
      Some(via) -> {
        let msg = concat_all(["a type parameter of `", rigid_owner(st.sub.rigid, rigid),
                              "` escapes its handler clause through ", via])
        let help = "the clause sees one perform's type; keep values of it inside the clause"
        diag_error(st.file, line, col, msg)
        diag_help(help)
        st_bump_err(st_push_diag(st, mk_diag(SevError, st.file, line, col, msg, [ri_help(st.file, line, col, help)])))
      }
    }
  }


fn op_tparam_escape_site(s: Subst, rigid: [Int], before: Int, state_ty: Option[Ty],
                         body_ty: Ty) : Option[String] =
  if (match state_ty { Some(t) -> mentions_any_var(s, rigid, t) None -> false }) { Some("the handler state") }
  else if mentions_any_var(s, rigid, body_ty) { Some("its result") }
  else if var_below_mentions(s, rigid, 0, before) { Some("a binding outside the clause") }
  else { None }


fn mentions_any_var(s: Subst, ids: [Int], t: Ty) : Bool = any(ids, (i) => occurs(i, t, s))


fn var_below_mentions(s: Subst, ids: [Int], v: Int, hi: Int) : Bool =
  if v >= hi { false }
  else if mentions_any_var(s, ids, TyVarT(v)) { true }
  else { var_below_mentions(s, ids, v + 1, hi) }


fn rigid_owner(rs: [RigidTv], ids: [Int]) : String = match rs {
  [] -> ""
  [RigidTv(i, _, owner), ...rest] -> if list_has_int(ids, i) { owner } else { rigid_owner(rest, ids) }
}


# Unify each effect-tparam fresh tyvar (from the op's polymorphic
# scheme) with the corresponding handler instantiation type. Length
# mismatch is silent — the row-level arity check has already reported
# that error.
fn unify_eff_tparams(st: InferState, fresh: [Int], tys: [Ty],
                      op_name: String) : InferState / Console + File + Mutable {


  match fresh {
    [] -> st
    [id, ...frest] -> match tys {
      [] -> st
      [t, ...trest] -> {
        let st1 = st_unify(st, TyVarT(id), t,
                            string_concat("clause op tparam in ", op_name),
                            -1, -1)
        unify_eff_tparams(st1, frest, trest, op_name)
      }
    }
  }
}


fn bind_params_with_sig_typed(st: InferState, params: [Param], arg_tys: [Ty],
                                ret_ty: Ty, stateful: Bool,
                                state_ty: Option[Ty], result_ty: Ty) : InferState / Console + File + Mutable {
  match params {
    []      -> st
    [last]  -> bind_resume_param_typed(st, last, ret_ty, stateful, result_ty)
    [p, ...rest] -> match arg_tys {
      []           -> bind_params_lenient(st, params)
      [a, ...rest_a] -> {
        let st_ann = check_clause_param_annotation(st, p, a)
        let env1 = env_bind_local(st_ann.env, p.binder, mono(a))
        bind_params_with_sig_typed(st_set_env(st_ann, env1), rest, rest_a, ret_ty,
                                     stateful, state_ty, result_ty)
      }
    }
  }
}


# The op's declared parameter type is the source of truth for a clause
# param; an annotation is a restatement of it, so a discordant one is a
# reader-facing lie rather than a second binding.
#
# `declared` is the op scheme's *uninstantiated* parameter type: a slot
# the effect declares generically is a bare tyvar here even once the
# handler pins it. Those are skipped, because an annotation on a generic
# slot names the effect's type parameter (`set(v: T, resume)` under
# `effect St[T]`), which is not in lexical scope inside the clause and
# would resolve to an unrelated nominal type.
fn check_clause_param_annotation(st: InferState, p: Param,
                                  declared: Ty) : InferState / Console + File + Mutable {
  match p.ptype {
    None     -> st
    Some(te) ->
      if ty_is_generic_slot(declared) { st }
      else {
        st_unify(st, st_annot_ty(st, te), apply_ty(st.sub, declared),
                  "handler clause parameter annotation", p.pline, p.pcol)
      }
  }
}


#[doc("Typer-internal helper `filter_labels_matching_res` shared across the infer modules.")]
pub fn filter_labels_matching_res(xs: [Label], hsym: SymId, cell: LocalId, tyargs: [Ty],
                               sub: Subst) : FilterResult / Mutable {
  match xs {
    [] -> FilterResult { kept: [], sub: sub }
    [h, ...rest] -> {
      # The guard ignores a function type's effect row; `unify` compares
      # it, so a label the unify rejects stays undischarged.
      let handled = label_same(h, label_in_cell(hsym, [], cell))
      let bound = if handled and label_args_dischargeable(h.ty_args, tyargs, sub) {
        unify_list(ty_env_empty(), h.ty_args, tyargs, sub)
      } else { None }
      match bound {
        Some(sub1) -> filter_labels_matching_res(rest, hsym, cell, tyargs, sub1)
        None -> {
          let r = filter_labels_matching_res(rest, hsym, cell, tyargs, sub)
          FilterResult { kept: [h, ...r.kept], sub: r.sub }
        }
      }
    }
  }
}


# Pure discharge guard: every arg position must be either flexibly
# unifiable (a TyVar on either side, at any nesting depth) or a
# structurally-equal concrete shape. Rejects a concrete-vs-concrete leaf
# clash (`Int` vs `String`) so a `Reader[Int]` handler still refuses a
# `Reader[String]` label. Unlike `labels_args_unify`, a TyVar nested
# inside a `[T]` / `Foo[T]` does NOT block the match — the binding is
# done afterward by the real unify.
#[doc("Typer-internal helper `label_args_dischargeable` shared across the infer modules.")]
pub fn label_args_dischargeable(a: [Ty], b: [Ty], s: Subst) : Bool {
  match a {
    [] -> match b { [] -> true _ -> false }
    [ah, ...arest] -> match b {
      [] -> false
      [bh, ...brest] ->
        if ty_dischargeable(apply_ty(s, ah), apply_ty(s, bh), s) {
          label_args_dischargeable(arest, brest, s)
        } else { false }
    }
  }
}


# A type variable on either side, at any depth, is compatible: unify binds it
# later.
fn ty_dischargeable(a: Ty, b: Ty, s: Subst) : Bool {
  let ax = unwrap_refines(a)
  let bx = unwrap_refines(b)
  if ty_is_flexible(ax) or ty_is_flexible(bx) { true }
  else { dischargeable_heads(ax, bx, s) }
}



fn dischargeable_heads(ax: Ty, bx: Ty, s: Subst) : Bool =
  match ax {
    TyListT(ai) -> match bx { TyListT(bi) -> ty_dischargeable(ai, bi, s) _ -> false }
    TyCon(ta_sym, aas) -> match bx {
      TyCon(tb_sym, bas) -> sym_same(ta_sym, tb_sym) and ty_list_dischargeable(aas, bas, s)
      _ -> false
    }
    TyFnT(aps, ar, arow) -> match bx {
      TyFnT(bps, br, brow) ->
        ty_list_dischargeable(aps, bps, s) and ty_dischargeable(ar, br, s)
          and (rows_label_free(arow, brow) or row_shape_compatible(arow, brow, s))
      _ -> false
    }
    TyUnion(aps) -> match bx {
      TyUnion(bps) -> ty_list_dischargeable(aps, bps, s)
      _ -> false
    }
    TyDimT(ab, _) -> match bx { TyDimT(bb, _) -> ty_dischargeable(ab, bb, s) _ -> ty_eq_shape(ax, bx) }
    _ -> ty_eq_shape(ax, bx)
  }


fn ty_list_dischargeable(a: [Ty], b: [Ty], s: Subst) : Bool {
  match a {
    [] -> match b { [] -> true _ -> false }
    [ah, ...arest] -> match b {
      [] -> false
      [bh, ...brest] -> ty_dischargeable(apply_ty(s, ah), apply_ty(s, bh), s) and ty_list_dischargeable(arest, brest, s)
    }
  }
}


# Merge two label lists, deduplicating by (eff name + unifiable
# ty_args). Used when synth_handle stitches the outer row back with
# the body's residual labels.
#[doc("Typer-internal helper `st_merge_labels` shared across the infer modules.")]
pub fn st_merge_labels(st: InferState, b: [Label]) : InferState / Mutable = match b {
  []           -> st
  [h, ...rest] -> st_merge_labels(st_join_label(st, h).st, rest)
}


# Validate `Option[t]` against the enclosing return type. The fn must
# return `Option[U]` for some `U` — we extract the U via a fresh
# tyvar so a generic `fn f[a]() : Option[a]` body still type-checks.
#[doc("Typer-internal helper `bang_finish_option` shared across the infer modules.")]
pub fn bang_finish_option(st: InferState, inner_typed: Expr, t: Ty,
                       line: Int, col: Int) : Inferred / Console + File {


  match st.ret_ty {
    None -> bang_no_enclosing_fn(st, "Option", t, inner_typed, line, col)
    Some(rt) -> {
      let rt_now = apply_ty(st.sub, rt)
      match rt_now {
        TyCon(tcs, rargs) ->
          if core_ty_is(tcs, CtOption) {
            match rargs {
              [_] ->
                mk_inferred(st, t, with_ty(mk_expr(EBang(inner_typed), line, col), t))
              _ -> bang_ret_mismatch(st, "Option", t, rt_now, inner_typed, line, col)
            }
          } else {
            bang_ret_mismatch(st, "Option", t, rt_now, inner_typed, line, col)
          }
        _ -> bang_ret_mismatch(st, "Option", t, rt_now, inner_typed, line, col)
      }
    }
  }
}


# Validate `Result[t, e_ty]` against the enclosing return type. The fn
# must return `Result[U, E]` for the same E — we unify e_ty with the
# function's declared error type (no implicit conversion).
#[doc("Typer-internal helper `bang_finish_result` shared across the infer modules.")]
pub fn bang_finish_result(st: InferState, inner_typed: Expr, e_ty: Ty, t: Ty,
                       line: Int, col: Int) : Inferred / Console + File + Mutable {


  match st.ret_ty {
    None -> bang_no_enclosing_fn(st, "Result", t, inner_typed, line, col)
    Some(rt) -> {
      let rt_now = apply_ty(st.sub, rt)
      match rt_now {
        TyCon(tcs, rargs) ->
          if core_ty_is(tcs, CtResult) {
            match rargs {
              [_, ret_e_ty] -> {
                # pass the enclosing function's
                # error type as `expected` so the unifier's D3 arm can
                # accept `e_ty <: ret_e_ty` when `e_ty` is a component
                # of the union `ret_e_ty`. Same-type Result use is
                # unaffected (head-unification succeeds before the
                # upcast arm fires).
                let st1 = st_unify(st, ret_e_ty, e_ty,
                  "`!` propagation requires the same error type as the enclosing function",
                  line, col)
                mk_inferred(st1, t, with_ty(mk_expr(EBang(inner_typed), line, col), t))
              }
              _ -> bang_ret_mismatch_result(st, e_ty, t, rt_now, inner_typed, line, col)
            }
          } else {
            bang_ret_mismatch_result(st, e_ty, t, rt_now, inner_typed, line, col)
          }
        _ -> bang_ret_mismatch_result(st, e_ty, t, rt_now, inner_typed, line, col)
      }
    }
  }
}


# The state with an argument unified into the parameter it was passed
# for, while a lambda still to be walked waits on it: the lambda's
# parameters read the callee's types, and those name what the earlier
# arguments are. A clash is the call's to report.
#[doc("Typer-internal helper `st_settle_arg` shared across the infer modules.")]
pub fn st_settle_arg(st: InferState, param: Option[Ty], arg: Ty, rest: [Expr],
                 rest_params: [Ty]) : InferState / Mutable =
  match param {
    Some(pt) -> if lambda_awaits(st.sub, rest, rest_params) { st_settle(st, pt, arg) } else { st }
    None     -> st
  }


fn st_settle(st: InferState, param: Ty, arg: Ty) : InferState / Mutable =
  match unify_env(st.env, param, arg, st.sub) {
    Some(s) -> st_set_sub(st, s)
    None    -> st
  }


# True when a lambda among `es` is expected at a function type with a
# domain no argument has settled yet.
fn lambda_awaits(s: Subst, es: [Expr], params: [Ty]) : Bool = match es {
  [] -> false
  [e, ...er] -> match params {
    [] -> false
    [p, ...pr] -> if is_lambda(e) and doms_open(apply_ty(s, p)) { true } else { lambda_awaits(s, er, pr) }
  }
}


#[doc("Typer-internal helper `cont_arg` shared across the infer modules.")]
pub fn cont_arg(r: Inferred, cp: ContParts, what: String) : Inferred / Console + File + Mutable =
  Inferred { ...r, st: st_unify(r.st, cp.arg, r.ty, what, r.expr.line, r.expr.col) }


#[doc("Typer-internal helper `constructor_mint_args` shared across the infer modules.")]
pub fn constructor_mint_args(env: TyEnv, sc: TyScheme, args_: [Expr]) : [Expr] {
  match instantiate(env, sc).ty {
    TyFnT(param_tys, _, _) -> constructor_mint_zip(args_, param_tys, mint_bigint_home(env))
    _                      -> args_
  }
}


# A record type is not callable: a bare-name callee with no scheme in
# the type env that names a declared record would otherwise fall
# through to the unknown-identifier TyAny fallback (unifies with
# anything) and only fail in the backend. Fns, sum-variant
# constructors and `#[constructor]` sugar all resolve upstream, so
# they stay callable.
#[doc("Typer-internal helper `try_record_type_call` shared across the infer modules.")]
pub fn try_record_type_call(st: InferState, callee: Expr, args_: [Expr],
                        line: Int, col: Int) : Option[Inferred] / Console + File + Mutable {
  let rec_opt = match callee.kind {
    EName(nm) -> match rec_find(st.recs, callee_type_sym(st, callee)) {
      None    -> None
      Some(r) -> match settle_name(st, None, nm, TyAny, value_classes()) {
        SetOne(_) -> None
        SetTie(_) -> None
        _         -> Some(r)
      }
    }
    _ -> None
  }
  match rec_opt {
    Some(r) -> match r {
      RI(rsym, _, fs, _) -> {
        let rnm = written_text(decl_name(st.env.tab, rsym))
        let perr = mk_diag(SevError, st.file, line, col,
          concat_all(["record type `", rnm, "` cannot be called with positional arguments"]), [])
        render_diag(perr)
        diag_help(concat_all(["construct it with the record literal form: `",
                              rnm, " { ", rec_fields_hint(fs), " }`"]))
        let root = with_ty(mk_expr(ECall(callee, args_), line, col), TyAny)
        Some(mk_inferred(st_bump_err(st_push_diag(st, perr)), TyAny, root))
      }
    }
    None -> None
  }
}


# The handle calls each lambda: its effects are the caller's.
#[doc("Typer-internal helper `seg_absorb` shared across the infer modules.")]
pub fn seg_absorb(st: InferState, fn_ty: Ty, at: Expr) : InferState / Console + File + Mutable =
  st_propagate_capability_labels(st, apply_ty(st.sub, fn_ty), at.line, at.col)


# Returns true when `obj_ty` resolves to a record type that declares
# a field named `ident`. Used by `try_ufcs_call` to honour the
# field-wins-on-ties precedence rule before attempting UFCS lookup.
#[doc("Typer-internal helper `record_has_field` shared across the infer modules.")]
pub fn record_has_field(st: InferState, obj_ty: Ty, ident: String) : Bool {
  match obj_ty {
    TyCon(tsym, _) -> match rec_pick(st.recs, tsym) {
      None -> false
      Some(ri) -> {
        let inst = rec_instantiate(st, ri)
        match fty_find(inst.fields, ident) {
          Some(_) -> true
          None    -> false
        }
      }
    }
    _ -> false
  }
}


# choose the candidate whose first parameter unifies
# with `target_ty`, preferring CONCRETE-headed matches over
# tyvar-headed ones.
#
# A scheme's first param can be either:
#   - concrete-headed: a nominal type, a list, `String`,
#     etc. These match `target_ty` only when the heads agree, so a
#     `Result[String, Int]` arg never accidentally picks `list.map`.
#   - tyvar-headed: TyVarT(_), TyAny. Vacuously unifies with any
#     `target_ty` because instantiation refreshed the var. The
#     classic case is `pub fn repeat(x: a, n: Int) : [a]` whose
#     first param is `a` — given a `String` arg, list.repeat would
#     win the race against `string.repeat` even though the intent
#     is string.repeat.
#
# The concrete-headed matches are the pool when there is one, the
# tyvar-headed ones otherwise. A pool of one is the answer. A larger
# pool is the scope's to decide, as for any bare name: the nearest rung
# holding one of them answers, alone or not at all; `tie_break` names
# the two ties that are none.
#
# Each tried candidate bumps the inference state's fresh counter
# (instantiation mints fresh tyvars). On a match the `sub` is *not*
# extended by the probe — `synth_ufcs_dispatch` and `synth_call`
# re-do the unify against the call's full expected fn type, which is
# what records the receiver / arg constraints into the substitution.
# So this helper only commits the instantiation, not the probe.
#[doc("Typer-internal helper `pick_by_first_arg` shared across the infer modules.")]
pub fn pick_by_first_arg(st: InferState, candidates: [TyCandidate],
                      target_ty: Ty, line: Int, col: Int) : FirstArg / Mutable = {
  let run = probe_first_arg(st, candidates, target_ty, [])
  let concrete = filter(run.hits, (h) => h.concrete)
  let pool = if list_is_empty(concrete) { run.hits } else { concrete }
  match pool {
    []  -> FaNone
    [h] -> FaOne(pick_at(h.pick, run.st))
    _   -> {
      let syms = map(pool, (h) => h.sym)
      match headless_pool(st, candidates, target_ty, syms) {
        Some(ss) -> FaTie(run.st, ss)
        None -> pick_in_pool(st, run, pool, syms, target_ty, line, col)
      }
    }
  }
}


# A receiver with no head fits every candidate, so a pool whose heads
# differ is ambiguous: no tie-break may choose for it.
fn headless_pool(st: InferState, candidates: [TyCandidate], target_ty: Ty, syms: [SymId]) : Option[[SymId]] =
  match hom_head(target_ty) {
    Some(_) -> None
    None    -> if hom_decidable(hom_cands_of(candidates)) { Some(syms) } else { None }
  }


fn pick_in_pool(st: InferState, run: ProbeRun, pool: [Probed], syms: [SymId],
                target_ty: Ty, line: Int, col: Int) : FirstArg / Mutable =
  match pool_answer(st, target_ty, sv_nearest(st.env.tab, st_scope(st), sv_rungs(), list_reverse(syms))) {
    SetOne(s) -> match find(pool, (h) => sym_same(h.sym, s)) {
      Some(h) -> FaOne(pick_at(h.pick, run.st))
      None    -> FaNone
    }
    SetTie(ss) -> if op_tie(st, ss) { op_pick(run.st, ss, line, col) } else { FaTie(run.st, ss) }
    _          -> FaNone
  }


# The pick of an operation no impl serves the argument for yet: the
# reference stays between its dispatchers, typed as all of them are.
fn op_pick(st: InferState, ss: [SymId], line: Int, col: Int) : FirstArg / Mutable = {
  let c = op_unsettled(st, ss, line, col)
  match c.ty {
    Some(t) -> FaOne(PickResult { st: c.st, inst_ty: t, fresh: [], unit_fresh: [], target: PtOp(ss) })
    None    -> FaTie(c.st, ss)
  }
}


# Every candidate whose first parameter unifies with `target_ty`, in
# candidate order, with the state past all of their instantiations.
#
# each iteration's `st_instantiate_report` advances the
# inferencer's `env.fresh` and writes fresh tyvar slots. Subsequent
# iterations' probe `unify_env` may extend the (mutable) `slots`
# array with bindings — those bindings persist even though the
# returned Subst is discarded, because kaikai's stage 2 substitution
# arrays are opaque-mutable. So a pick's own `st` is stale once a later
# candidate is probed: a fresh tyvar allocated from it would reuse a
# slot a discarded probe already bound. The run's final `st` is past
# every instantiation, and a pick is only used advanced to it.
fn probe_first_arg(st: InferState, candidates: [TyCandidate], target_ty: Ty,
                   acc: [Probed]) : ProbeRun / Mutable = match candidates {
  [] -> ProbeRun { st: st, hits: list_reverse(acc) }
  [c, ...rest] -> {
    let inst = st_instantiate_report(st, c.scheme)
    let probe = match inst.ty {
      TyFnT(params, _, _) -> match params {
        [] -> ProbeNoMatch
        [first, ..._rest_params] -> {
          let head_concrete = first_param_head_is_concrete(first)
          match unify_env(inst.st.env, first, target_ty, inst.st.sub) {
            None    -> ProbeNoMatch
            Some(_) -> if head_concrete { ProbeConcrete } else { ProbeTyvar }
          }
        }
      }
      _ -> ProbeNoMatch
    }
    let pick = PickResult { st: inst.st, inst_ty: inst.ty,
                             fresh: inst.fresh, unit_fresh: inst.unit_fresh,
                             target: PtDecl(c.sym) }
    let acc1 = match probe {
      ProbeNoMatch  -> acc
      ProbeConcrete -> [Probed { pick: pick, sym: c.sym, concrete: true }, ...acc]
      ProbeTyvar    -> [Probed { pick: pick, sym: c.sym, concrete: false }, ...acc]
    }
    probe_first_arg(inst.st, rest, target_ty, acc1)
  }
}


# What `obj.ident(…)` calls. The receiver's type picks among the modules
# declaring `ident`; a name none of them answers reads as the bare name
# does: the innermost binder spelled so, else the root file's function,
# else the builtin.
#[doc("Typer-internal helper `ufcs_target` shared across the infer modules.")]
pub fn ufcs_target(st: InferState, ident: String, obj_ty: Ty,
               line: Int, col: Int) : UfcsFound / Mutable =
  match pick_by_first_arg(st, st_visible_candidates(st, ident), obj_ty, line, col) {
    FaOne(p)       -> UfOne(UfcsTarget { st: pick_inst(p, line, col), inst_ty: p.inst_ty, callee: pick_ref(p, line, col) })
    FaTie(st_t, ss) -> UfTie(st_t, ss)
    FaNone -> match env_local_written(st.env.entries, ident) {
      Some(b) -> match env_local(st.env, b.id) {
        None -> UfNone
        Some(sc) -> {
          let inst = st_instantiate_report(st, sc)
          UfOne(UfcsTarget { st: inst.st, inst_ty: inst.ty, callee: mk_local(b.id, line, col) })
        }
      }
      None -> match ufcs_bare_sym(st.env, ident) {
        None -> UfNone
        Some(s) -> match env_sym(st.env, s) {
          None -> UfNone
          Some(sc) -> {
            let inst = st_instantiate_report(st, sc)
            UfOne(ufcs_sym_target(inst.st, s, inst.ty, inst.fresh, inst.unit_fresh, line, col))
          }
        }
      }
    }
  }


# When the local `l` is bound to a capability type — a parameter `c: Eff`
# or a `with Eff as name` binding (§6 named instances) — the effect it
# carries. The capability type is the effect's own nominal type, so a
# `TyCon` whose declaration has ops registered is a capability.
#[doc("Typer-internal helper `cap_eff_of_var` shared across the infer modules.")]
pub fn cap_eff_of_var(st: InferState, l: LocalId) : Option[SymId] =
  match env_local(st.env, l) {
    None     -> None
    Some(sc) -> match sc {
      Scheme(_, _, _, _, ty) -> match apply_ty(st.sub, ty) {
        TyCon(esym, _) -> if env_has_effect(st.env, esym) { Some(esym) } else { None }
        _ -> None
      }
    }
  }


# Apply the substitution to a list of fresh-tyvar ids, producing the
# resolved type for each. Avoids an inline lambda that would capture
# the substitution and confuse stage 1's capture analyser.
# An effect parameter the op's signature never mentions is not fixed by the
# call (`Actor.send`): any instance of the effect serves it, so its label
# argument is `TyAny`, which never pins the instance.
#[doc("Typer-internal helper `phantom_eff_args` shared across the infer modules.")]
pub fn phantom_eff_args(ids: [Int], pinned: [Bool], sub: Subst) : [Ty] = match ids {
  [] -> []
  [id, ...rest] -> match pinned {
    [p, ...prest] -> [if p { apply_ty(sub, TyVarT(id)) } else { TyAny }, ...phantom_eff_args(rest, prest, sub)]
    []            -> resolve_fresh_ids(ids, sub)
  }
}


#[doc("Typer-internal helper `resolve_fresh_ids` shared across the infer modules.")]
pub fn resolve_fresh_ids(ids: [Int], sub: Subst) : [Ty] {
  match ids {
    [] -> []
    [id, ...rest] -> [apply_ty(sub, TyVarT(id)), ...resolve_fresh_ids(rest, sub)]
  }
}


# returns true when (lt, rt) form a heterogeneous pair
# (prim<->nonprim or two distinct nonprim heads) for which a matching
# `impl P[A] for T` is registered in `st.protos.impls`. Same-prim pairs
# (`Int + Int`, `Real + Real`) and same-nonprim pairs already
# captured by `binop_should_dispatch_proto` are NOT matched here.
#[doc("Typer-internal helper `binop_dispatch_proto_heterogeneous` shared across the infer modules.")]
pub fn binop_dispatch_proto_heterogeneous(st: InferState, op: BinOp,
                                        lt: Ty, rt: Ty) : Bool {
  let l_prim = ty_is_concrete_prim(lt)
  let r_prim = ty_is_concrete_prim(rt)
  let l_user = ty_is_concrete_nonprim(lt)
  let r_user = ty_is_concrete_nonprim(rt)
  let pair_prim_user = (l_prim and r_user) or (r_prim and l_user)
  let pair_user_user_diff = l_user and r_user and not ty_same_head(lt, rt)
  if not (pair_prim_user or pair_user_user_diff) { false }
  else {
    let bp = binop_proto(op)
    let picked = match op_proto_core(bp) {
      None     -> None
      Some(cp) -> binop_pick_proto_dispatch(st.protos.impls, core_proto_id(cp), op_proto_method(bp), lt, rt, st.sub)
    }
    match picked { Some(_) -> true  None -> false }
  }
}


fn binop_pick_proto_dispatch(impls: [ProtoImplReg], proto: SymId, op: String,
                              lt: Ty, rt: Ty, sub: Subst) : Option[BinopProtoChoice] {
  let l = apply_ty(sub, lt)
  let r = apply_ty(sub, rt)
  match inf_disp_head(l) {
    None -> None
    Some(lh) -> match inf_disp_head(r) {
      None -> None
      Some(rh) -> {
        # Try (receiver = lhs, arg = rhs) first.
        if impl_pair_exists(impls, proto, op, lh, [rh]) {
          Some(BPC(lh, [rh]))
        # Mirror: (receiver = rhs, arg = lhs).
        } else if impl_pair_exists(impls, proto, op, rh, [lh]) {
          Some(BPC(rh, [lh]))
        } else {
          None
        }
      }
    }
  }
}


# The dispatcher answers `Self`, the receiver's own type with its unit.
# An impl that declares a result of another head answers that instead:
# `Real + Complex` is a `Complex`.
#[doc("Typer-internal helper `binop_impl_result` shared across the infer modules.")]
pub fn binop_impl_result(inf: Inferred, declared: Option[Ty]) : Inferred = match declared {
  None     -> inf
  Some(rv) -> {
    let ty = apply_ty(inf.st.sub, rv)
    match inf_disp_head(ty) {
      None    -> inf
      Some(_) ->
        if ty_same_head(ty, apply_ty(inf.st.sub, inf.ty)) { inf }
        else { mk_inferred(inf.st, ty, with_ty(call_answering(inf.expr, ty), ty)) }
    }
  }
}


# The dispatcher's signature is generic over `Self`, so unifying against
# it accepts any operand sharing the impl's head and lets a wrong
# habitant through. Re-run the ordinary call unification against the
# selected impl's own concrete signature — the check a direct call to
# that fn would get. Dispatch stays keyed on heads (O(1)); only the
# winner is re-checked.
#[doc("Typer-internal helper `binop_check_against_impl` shared across the infer modules.")]
pub fn binop_check_against_impl(st: InferState, op: BinOp, lt0: Ty, rt0: Ty,
                            line: Int, col: Int) : BinopImpl / Console + File + Mutable {
  let bp = binop_proto(op)
  let method = op_proto_method(bp)
  let lt = apply_ty(st.sub, lt0)
  let rt = apply_ty(st.sub, rt0)
  let impl_sym = match op_proto_core(bp) {
    None     -> None
    Some(cp) -> binop_impl_sym(st.protos.impls, core_proto_id(cp), method, lt, rt, st.sub)
  }
  match impl_sym {
    None -> BinopImpl(st, None)
    Some(sym) -> match env_sym(st.env, sym) {
      None -> BinopImpl(st, None)
      Some(sc) -> {
        let inst = st_instantiate(st, sc)
        let rv = st_fresh_ty(inst.st)
        let fr = subst_fresh_row(rv.st.sub)
        let st2 = st_set_sub(rv.st, fr.subst)
        let args = binop_args_for_impl(inst.ty, [lt, rt], st2.sub)
        let expected = TyFnT(args, rv.ty,
                             Row { labels: [], tail: Some(fr.id), display_alias: None })
        # The notes cite the operator the user wrote, not the impl's
        # function, which is never spelled in source.
        BinopImpl(st_unify_named(st2, Some(binop_text(op)), inst.ty, args, expected, line, col), Some(rv.ty))
      }
    }
  }
}


# Align each operand with the impl parameter it lands on, dropping the
# operand's habitant wherever the parameter declares none. An impl over
# a bare carrier (`impl Add for BigInt`) is habitant-agnostic on purpose
# — the unit rides an outer wrapper like `Money[BigInt]<USD>`, and the
# same-unit rule for `+`/`-` is already enforced before dispatch. Only a
# parameter that spells a habitant gets to demand one.
fn binop_args_for_impl(impl_ty: Ty, args: [Ty], s: Subst) : [Ty] =
  match apply_ty(s, impl_ty) {
    TyFnT(params, _, _) -> binop_args_zip(params, args, s)
    _                   -> args
  }


fn binop_args_zip(params: [Ty], args: [Ty], s: Subst) : [Ty] = match args {
  [] -> []
  [a, ...arest] -> match params {
    [] -> args
    [p, ...prest] ->
      [binop_arg_for_param(p, a, s), ...binop_args_zip(prest, arest, s)]
  }
}


fn binop_arg_for_param(param: Ty, arg: Ty, s: Subst) : Ty =
  if ty_is_dimmed(apply_ty(s, param)) { arg }
  else { (ty_split_dim(arg, s)).base }


# The function of the impl the operator dispatches to, matching
# `binop_pick_proto_dispatch`'s receiver/mirror order.
fn binop_impl_sym(impls: [ProtoImplReg], proto: SymId, method: String,
                  lt: Ty, rt: Ty, sub: Subst) : Option[SymId] =
  match binop_pick_proto_dispatch(impls, proto, method, lt, rt, sub) {
    None -> None
    Some(BPC(recv, want)) -> impl_sym_for(impls, proto, method, recv, want)
  }


#[doc("Typer-internal helper `ty_split_dim` shared across the infer modules.")]
pub fn ty_split_dim(t: Ty, s: Subst) : DimSplit {
  match apply_ty(s, t) {
    TyDimT(b, u) -> DimSplit { base: b, dim: u }
    other -> DimSplit { base: other, dim: UOne }
  }
}


# Atomic-kind formation guard. Habitants of Module and Composition kinds
# have no product or power — and Semilattice habitants compound only
# through `+` in annotations — so the combined unit an operator would
# produce must keep every such habitant alone with exponent 1 (full
# cancellation is fine: `USD/USD` is a scalar ratio). Reports against
# the operator's source position; a no-op when no such kind is
# declared.
#[doc("Typer-internal helper `st_check_atomic_unit` shared across the infer modules.")]
pub fn st_check_atomic_unit(st: InferState, op: BinOp, u: UnitExprT,
                        line: Int, col: Int) : InferState / Console + File + Mutable {
  match st.sub.kind_theories {
    [] -> st
    _ -> {
      let t = unit_to_table_resolved(u, st.sub)
      match product_form_violation(utable_symexps(t), list_length(t.vars),
                                   st.sub.kind_theories) {
        None -> st
        Some(sym) -> {
          let kind = kind_sym_kind(sym)
          let note =
            if kind_is_semilattice(st.sub.kind_theories, kind) {
              concat_all(["`", kind,
                "` habitants join with `+` inside `<>` annotations; operators never combine them"])
            } else {
              concat_all(["`", kind,
                "` habitants stand alone: a quantity is either scalar or carries exactly one habitant with exponent 1 — habitant products and powers are not expressible"])
            }
          let d = mk_diag(SevError, st.file, line, col,
            concat_all(["operator `", binop_text(op), "` cannot combine `", kind,
                        "` quantities: the result unit `",
                        unit_text(utable_to_tree(t)),
                        "` does not exist"]),
            [ri_note(st.file, line, col, note)])
          render_diag(d)
          st_bump_err(st_push_diag(st, d))
        }
      }
    }
  }
}


#[doc("Typer-internal helper `st_add_tail_labels` shared across the infer modules.")]
pub fn st_add_tail_labels(st: InferState, us: [TailUse]) : InferState / Mutable = match us {
  [] -> st
  [TU(t, l, c), ...rest] -> st_add_tail_labels(st_add_bound_labels(st, t, l, c), rest)
}

