# Hash index over the typer's resolved call-site instantiations.
#
# `find_mono_insts_at` collects the instantiations recorded at one
# `(name, line, col)`, and the monomorphiser asks once per call site it
# rewrites, against one entry per instantiation in the whole program.
# The index buckets by name so the position filter runs over one name's
# instantiations instead of all of them.
#
# The collected order is load-bearing: `resolve_call_inst_first` takes
# the HEAD of the collected list, so a chain must preserve the table's
# order. `idx_prepend` builds newest-first, so the table is indexed back
# to front and each chain comes out in table order. A hash collision
# mixes foreign names into a chain; the position filter re-tests the
# name, so it costs a comparison, never a resolution.

import compiler.infer
import compiler.infer_index

#[doc("The resolved call-site table plus a hash index from name to that name's instantiations.")]
pub type InstIndex = { ix: NameIndex[ResolvedCS], all: [ResolvedCS] }

#[doc("The index over an empty call-site table.")]
pub fn iix_empty() : InstIndex = InstIndex { ix: idx_empty(), all: [] }

#[doc("Index the resolved call-site table so one name's instantiations are reachable without scanning it.")]
pub fn iix_build(insts: [ResolvedCS]) : InstIndex =
  InstIndex { ix: iix_add_rev(list_reverse(insts), idx_empty()), all: insts }

fn iix_add_rev(rev: [ResolvedCS], ix: NameIndex[ResolvedCS]) : NameIndex[ResolvedCS] = match rev {
  []           -> ix
  [r, ...rest] -> match r {
    RCS(n, _, _, _, _, _) -> iix_add_rev(rest, idx_prepend(ix, n, r))
  }
}

#[doc("The instantiations recorded under `name`, in table order; empty when the name is absent.")]
pub fn iix_chain(ix: InstIndex, name: String) : [ResolvedCS] =
  idx_chain(ix.ix, name)

#[doc("The whole resolved call-site table, in its original order.")]
pub fn iix_all(ix: InstIndex) : [ResolvedCS] = ix.all
