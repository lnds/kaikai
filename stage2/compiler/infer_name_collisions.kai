#[doc("""Duplicate function, effect, const and axiom declarations.

One parametric walker drives all four entity classes.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.enc_unit
import compiler.diag
import compiler.diag_file
import compiler.emit_shared_syms
import compiler.infer_dump_text
import compiler.infer_glue
import compiler.infer_index
import compiler.infer_state
import compiler.modules_paths
import compiler.proto_resolve
import compiler.symtab
import compiler.util
import compiler.written
import compiler.ast_build
import compiler.type_text

# Reject two declarations sharing a
# name in the same module across the `fn`, `effect`, `const`, `axiom`
# kinds. The resolver historically prepended decls into the env blindly
# (see `register_one`), so a second `fn foo` (or `effect E`, `const N`,
# `axiom A`) silently shadowed the first. Companion to
# `validate_type_name_collisions_decls` for `type`; these walkers only
# check same-module same-name pairs in `root_only_decls`. Cross-module
# shadowing (`pub fn foo` in one module, `fn foo` private in another) is
# gated by `pub` + `use` and remains permitted.
#
# Diagnostic shape mirrors the type case: anchor at the second site,
# cite the earlier file:line:col in the message body, and add a help
# line nudging the user to rename or remove the redeclaration.
#
# The four kinds differ only in (a) which Decl variant carries the
# name/line/col, and (b) three words of diagnostic text. A single
# parametric walker (`validate_name_collisions_walk`) carries the shared
# linear scan; each public entry point supplies a pure extractor naming
# its Decl variant plus an `EntitySpec` for the three varying words. The
# `type` and union validators stay bespoke — `type` layers cross-module
# / reserved-name / DDerive-DUnstable cases and a distinct message, and
# union collision accumulates per-variant claims with builtin seeding;
# forcing either into this mould would drag their special logic into the
# generic path.

# What a declaration claims in its module: its id, which a second
# declaration of its class and name in that module derives too; an
# axiom carries no id and claims its name.
type NameKey = NkSym(SymId) | NkName(String)

# A claim at a source position.
type NameSite = NS(NameKey, Int, Int)

fn name_key_same(a: NameKey, b: NameKey) : Bool = match a {
  NkSym(x)  -> match b { NkSym(y) -> sym_raw(x) >= 0 and sym_raw(x) == sym_raw(y)  NkName(_) -> false }
  NkName(x) -> match b { NkName(y) -> x == y  NkSym(_) -> false }
}

fn name_key_text(tab: SymTab, k: NameKey) : String = match k {
  NkSym(s)  -> written_text(decl_name(tab, s))
  NkName(n) -> n
}

# The three words of diagnostic text that vary per entity kind:
#   word   — noun in the error line ("function" / "effect" / ...)
#   kw     — keyword fragment opening the help suggestion ("fn" / ...)
#   syntax — the rest of the help's declaration shape ("(...)" / ...)
type EntitySpec = ES(String, String, String)

# Parametric same-module duplicate-name walker. `extract` returns
# `Some(NS(key, line, col))` for the decls this entity owns and `None`
# for every other decl kind; `spec` supplies the varying diagnostic
# words. One pass accumulating the claims seen so far and an error tally.
fn validate_name_collisions_walk(remaining: [Decl], tab: SymTab, file: String,
    extract: (Decl) -> Option[NameSite],
    spec: EntitySpec,
    seen: Seen,
    errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match remaining {
    [] -> list_reverse(errs)
    [d, ...rest] -> match extract(d) {
      Some(site) -> match site {
        NS(key, line, col) -> match find_name_site(seen, key) {
          Some(prev) -> {
            let d = report_dup_name_decl(file, name_key_text(tab, key), line, col, prev, spec)
            validate_name_collisions_walk(rest, tab, file, extract, spec, seen, [d, ...errs])
          }
          None ->
            validate_name_collisions_walk(rest, tab, file, extract, spec,
          seen_add(seen, NS(key, line, col)), errs)
        }
      }
      None -> validate_name_collisions_walk(rest, tab, file, extract, spec, seen, errs)
    }
  }
}

# The claims seen so far, each under its key.
type Seen = { syms: NameIndex[NameSite], names: NameIndex[NameSite] }

fn seen_empty() : Seen = Seen { syms: idx_empty(), names: idx_empty() }

fn seen_add(seen: Seen, site: NameSite) : Seen = match site {
  NS(NkSym(s), _, _)  -> Seen { ...seen, syms: idx_prepend_sym(seen.syms, s, site) }
  NS(NkName(n), _, _) -> Seen { ...seen, names: idx_prepend(seen.names, n, site) }
}

fn find_name_site(seen: Seen, key: NameKey) : Option[NameSite] = match key {
  NkSym(s)  -> first_site(idx_chain_sym(seen.syms, s), key)
  NkName(n) -> first_site(idx_chain(seen.names, n), key)
}

fn first_site(chain: [NameSite], key: NameKey) : Option[NameSite] {
  match chain {
    [] -> None
    [c, ...rest] -> match c {
      NS(k, _, _) -> if name_key_same(k, key) { Some(c) } else { first_site(rest, key) }
    }
  }
}

fn report_dup_name_decl(file: String, name: String, line: Int, col: Int,
    prev: NameSite, spec: EntitySpec) : Diagnostic / Console + File {

  match prev {
    NS(_, prev_line, prev_col) -> match spec {
      ES(word, kw, syntax) -> {
        let msg = concat_all([word, " '", name,
          "' is already declared in this module (earlier at ",
          file, ":", int_to_string(prev_line), ":",
          int_to_string(prev_col), ")"])
        let help = concat_all(["remove or rename the second '", kw, " ", name, syntax, "' declaration"])
        let d = mk_diag(SevError, file, line, col, msg, [ri_help(file, line, col, help)])
        render_diag(d)
        d
      }
    }
  }
}

fn extract_fn_site(d: Decl) : Option[NameSite] = match d {
  DFn(_, fid, _, _, _, _, _, line, col, _) -> Some(NS(NkSym(fnid_sym(fid)), line, col))
  _ -> None
}

#[doc("infer: `validate_fn_name_collisions_decls` — typer entry point invoked by the driver.")]
pub(pkg) fn validate_fn_name_collisions_decls(root_decls: [Decl], tab: SymTab,
    file: String) : [Diagnostic] / Console + File {

  validate_name_collisions_walk(root_decls, tab, file, extract_fn_site,
      ES("function", "fn", "(...)"), seen_empty(), [])
}

# reject two `effect Foo` declarations in the same module.
# The resolver's `register_one` prepends DEffect names into the env
# blindly so the second silently shadows the first. Companion to the
# DFn / DType walkers above; shares `validate_name_collisions_walk`.

fn extract_effect_site(d: Decl) : Option[NameSite] = match d {
  DEffect(_, s, _, _, _, line, col, _) -> Some(NS(NkSym(s), line, col))
  _ -> None
}

#[doc("infer: `validate_effect_name_collisions_decls` — typer entry point invoked by the driver.")]
pub(pkg) fn validate_effect_name_collisions_decls(root_decls: [Decl], tab: SymTab,
    file: String) : [Diagnostic] / Console + File {

  validate_name_collisions_walk(root_decls, tab, file, extract_effect_site,
      ES("effect", "effect", " { ... }"), seen_empty(), [])
}

# reject two `const N = ...` declarations in the same
# module. DConst flows through `register_one` with the same blind
# prepend pattern; shares `validate_name_collisions_walk`.

fn extract_const_site(d: Decl) : Option[NameSite] = match d {
  DConst(_, s, _, _, _, line, col) -> Some(NS(NkSym(s), line, col))
  _ -> None
}

#[doc("infer: `validate_const_name_collisions_decls` — typer entry point invoked by the driver.")]
pub(pkg) fn validate_const_name_collisions_decls(root_decls: [Decl], tab: SymTab,
    file: String) : [Diagnostic] / Console + File {

  validate_name_collisions_walk(root_decls, tab, file, extract_const_site,
      ES("const", "const", " = ..."), seen_empty(), [])
}

# reject two axiom declarations sharing a name in the
# same module. DAxiom is rewritten to DFn by `lower_axioms`, but the
# walk must run on the raw decl list (before the lowering) so the
# diagnostic anchors at the original axiom site. Shares
# `validate_name_collisions_walk`; the caller feeds it the pre-lowering
# decls so DAxiom still appears.

fn extract_axiom_site(d: Decl) : Option[NameSite] = match d {
  DAxiom(_, _, name, _, _, _, _, _, line, col) -> Some(NS(NkName(name), line, col))
  _ -> None
}

#[doc("infer: `validate_axiom_name_collisions_decls` — typer entry point invoked by the driver.")]
pub(pkg) fn validate_axiom_name_collisions_decls(root_decls: [Decl], tab: SymTab,
    file: String) : [Diagnostic] / Console + File {

  validate_name_collisions_walk(root_decls, tab, file, extract_axiom_site,
      ES("axiom", "axiom", "(...)"), seen_empty(), [])
}

# Run every same-module duplicate-decl validator over a single module's
# decls. Stdlib modules (core auto-load + `import`-resolved files) bypass
# `validate_*_collisions_decls` because those walkers only see the
# root file's `root_only_decls`. The consequence (json_hex_digit case):
# a duplicate `fn foo` inside a stdlib module silently overwrites the
# first definition, the second wins at name resolution, and the codegen
# emits two C-level definitions of `kai_<mod>__foo` that cc rejects at
# link time — far from the kaikai source where the duplicate lives.
#
# This wrapper closes the gap. `load_core` (core auto-load) and
# `resolve_module` (import) call it on every freshly-parsed module's
# decls before tagging or appending to the global stream. Each
# validator counts its own diagnostic emissions; the caller sums the
# total and aborts the load when non-zero so downstream passes never
# see the broken module.
#
# Pre-conditions:
#   - decls are the just-parsed AST of one source file, NOT the global
#     concat. Cross-module shadowing is NOT a concern here — by design,
#     a stdlib `type Pair` and a user `type Pair` coexist (Hanga Roa
#     decision; see `validate_one_type_decl` comments). This walker
#     only catches same-file same-name pairs.
#[doc("infer: `validate_module_same_module_collisions` — typer entry point invoked by the driver.")]
pub(pkg) fn validate_module_same_module_collisions(decls: [Decl], tab: SymTab, file: String)
    : Int / Console + File {
  let e_fn     = validate_fn_name_collisions_decls(decls, tab, file)
  let e_type   = validate_type_name_collisions_decls(decls, tab, file)
  let e_effect = validate_effect_name_collisions_decls(decls, tab, file)
  let e_const  = validate_const_name_collisions_decls(decls, tab, file)
  let e_axiom  = validate_axiom_name_collisions_decls(decls, tab, file)
  list_length(e_fn) + list_length(e_type) + list_length(e_effect) + list_length(e_const) + list_length(e_axiom)
}

# A type declaration at a source position: a second declaration of its
# name in its module derives the same id.
type TypeNameClaim = TNC(SymId, Int, Int)

#[doc("infer: `validate_type_name_collisions_decls` — typer entry point invoked by the driver.")]
pub(pkg) fn validate_type_name_collisions_decls(root_decls: [Decl], tab: SymTab, file: String) : [Diagnostic] / Console + File {

  list_reverse(validate_type_name_collisions_loop(root_decls, tab, file, [], []))
}

fn validate_type_name_collisions_loop(remaining: [Decl], tab: SymTab, file: String,
    claims: [TypeNameClaim],
    errs: [Diagnostic]) : [Diagnostic] / Console + File {

  match remaining {
    [] -> errs
    [d, ...rest] -> match d {
      DType(_, s, _, _, line, col, _, _) ->
        validate_one_type_decl(rest, tab, file, claims, errs, s, line, col)
      DDerive(_, inner, _, _) -> match inner {
        DType(_, s, _, _, line, col, _, _) ->
          validate_one_type_decl(rest, tab, file, claims, errs, s, line, col)
        _ -> validate_type_name_collisions_loop(rest, tab, file, claims, errs)
      }
      DUnstable(inner, _, _) -> match inner {
        DType(_, s, _, _, line, col, _, _) ->
          validate_one_type_decl(rest, tab, file, claims, errs, s, line, col)
        _ -> validate_type_name_collisions_loop(rest, tab, file, claims, errs)
      }
      DProtoLaws(_, inner, _, _, _) -> validate_type_name_collisions_loop(rest, tab, file, claims, errs)
      DImplAxiom(_, inner, _, _, _) -> validate_type_name_collisions_loop(rest, tab, file, claims, errs)
      DConstructor(inner, _, _) -> validate_type_name_collisions_loop(rest, tab, file, claims, errs)
      _ -> validate_type_name_collisions_loop(rest, tab, file, claims, errs)
    }
  }
}

fn validate_one_type_decl(rest: [Decl], tab: SymTab, file: String,
    claims: [TypeNameClaim], errs: [Diagnostic],
    s: SymId, line: Int, col: Int) : [Diagnostic] / Console + File {

  let name = written_text(decl_name(tab, s))
  if list_has(reserved_builtin_type_names(), name) {
    let help = concat_all(["rename the local type (e.g. '", name, "2'); '", name, "' is reserved by the language"])
    let d = mk_diag(SevError, file, line, col,
      concat_all(["type '", name, "' is a reserved builtin type name and cannot be redeclared"]),
      [ri_help(file, line, col, help)])
    render_diag(d)
    validate_type_name_collisions_loop(rest, tab, file,
        [TNC(s, line, col), ...claims],
        [d, ...errs])
  } else {
  match find_type_name_claim(claims, s) {
    Some(prev) -> {
      let d = report_dup_type_decl(file, name, line, col, prev)
      validate_type_name_collisions_loop(rest, tab, file, claims, [d, ...errs])
    }
    # Hanga Roa: cross-module type-name "collision" with a core /
    # core / imported module is NOT an error — it is shadowing,
    # which every serious language with scoped identifiers permits.
    # A user `type Pair = { fst: Int, snd: Int }` in their root file
    # is welcome to coexist with `core.tuple.Pair[a, b]`: inside the
    # user's archivo the local definition wins; the imported one
    # stays reachable via qualified access (`tuple.Pair`). The cb4bd6b
    # invariant ("one type name resolves to one definition") was an
    # over-strict shortcut that traded language ergonomics for a
    # simpler variant-table lookup — the correct fix lives in the
    # typer's dispatch (key variants by (module, name) and resolve
    # contextually by the scrutinee's type) and is tracked as a
    # separate bug. Local duplicates inside the same file (the case
    # `Some(prev)` above) remain an error — that ambiguity has no
    # disambiguator.
    None -> validate_type_name_collisions_loop(rest, tab, file,
        [TNC(s, line, col), ...claims],
        errs)
  }
  }
}

# Types the language reserves for its own use; user code cannot
# redeclare them via `type X = ...`. The primitives come from the
# typer's own list so the two cannot drift. `Cont` is the one-shot
# continuation type that appears in `extern "handler" fn` signatures
# inside `default { }` blocks; the typer/codegen treat it as an opaque
# builtin and lower it to KaiCont* at emit time.
fn reserved_builtin_type_names() : [String] =
  [cont_name(), ...primitive_type_names()]

fn find_type_name_claim(claims: [TypeNameClaim], s: SymId) : Option[TypeNameClaim] {
  match claims {
    [] -> None
    [c, ...rest] -> match c {
      TNC(t, _, _) -> if sym_raw(s) >= 0 and sym_raw(t) == sym_raw(s) { Some(c) } else { find_type_name_claim(rest, s) }
    }
  }
}

fn report_dup_type_decl(file: String, name: String, line: Int, col: Int,
    prev: TypeNameClaim) : Diagnostic / Console + File {

  match prev {
    TNC(_, prev_line, prev_col) -> {
      let msg = concat_all(["type '", name,
          "' is already declared in this module (earlier at ",
          file, ":", int_to_string(prev_line), ":",
          int_to_string(prev_col), ")"])
      let help = concat_all(["remove or rename the second 'type ", name, " = ...' declaration"])
      let d = mk_diag(SevError, file, line, col, msg, [ri_help(file, line, col, help)])
      render_diag(d)
      d
    }
  }
}

#[doc("infer: `validate_constructor_uniqueness_decls` — reject a second `#[constructor]` for the same type. The claim is the type's declaration: two modules each with their own type and its own constructor are distinct claims, not a collision.")]
pub(pkg) fn validate_constructor_uniqueness_decls(decls: [Decl], ps: PScope, df: DiagFiles) : [Diagnostic] =
  finalize_diags(validate_constructor_uniqueness_loop(decls, ps, df, [], []))

# A `#[constructor]` claim: the type it builds, by declaration, and where
# the wrapper stands.
type CtorClaim = CtorClaim(SymId, ClaimSite)

# Where a wrapper stands: its file and position.
type ClaimSite = ClaimSite(String, Int, Int)

fn validate_constructor_uniqueness_loop(remaining: [Decl], ps: PScope, df: DiagFiles,
    claims: [CtorClaim],
    acc: [Diagnostic]) : [Diagnostic] {
  match remaining {
    [] -> acc
    [d, ...rest] -> match constructor_decl_type(d, ps, decl_diag_file(d, df)) {
      Some(claim) -> match find(claims, (c) => claim_type(c) == claim_type(claim)) {
        Some(prev) ->
          validate_constructor_uniqueness_loop(rest, ps, df, claims, [dup_constructor_diag(ps_tab(ps), claim, prev), ...acc])
        None -> validate_constructor_uniqueness_loop(rest, ps, df, [claim, ...claims], acc)
      }
      None -> validate_constructor_uniqueness_loop(rest, ps, df, claims, acc)
    }
  }
}

fn claim_type(c: CtorClaim) : Int = match c { CtorClaim(s, _) -> sym_raw(s) }

# The claim of a `#[constructor]` wrapper whose inner fn returns a
# declared type, read from the wrapper's own file; None for any other
# decl and for a return type no declaration answers.
fn constructor_decl_type(d: Decl, ps: PScope, file: String) : Option[CtorClaim] = match d {
  DConstructor(DFn(_, _, _, _, Some(ret_te), _, _, _, _, mo), l, c) ->
    match ret_te.tkind {
      TyName(r, _) -> {
        let s = ps_type_sym(ps, r, mo)
        if sym_raw(s) < 0 { None } else { Some(CtorClaim(s, ClaimSite(file, l, c))) }
      }
      _ -> None
    }
  _ -> None
}

fn dup_constructor_diag(tab: SymTab, claim: CtorClaim, prev: CtorClaim) : Diagnostic = match claim {
  CtorClaim(s, ClaimSite(file, l, c)) -> match prev {
    CtorClaim(_, ClaimSite(pfile, pl, pc)) ->
      mk_diag(SevError, file, l, c,
        concat_all(["type '", "#{decl_name(tab, s)}", "' already has a `#[constructor]` (earlier at ",
                    pfile, ":", int_to_string(pl), ":", int_to_string(pc), ")"]),
        [ri_help(file, l, c, "a type has at most one `#[constructor]`; keep one and make the other a named `pub fn` (overloading is out — Tier 1 #3)")])
  }
}

#[doc("Reject a program declaring more variant constructors than the constructor tag space holds, the count the emitters register.")]
pub(pkg) fn validate_variant_capacity(decls: [Decl], tab: SymTab, df: DiagFiles) : [Diagnostic] {
  let n = variant_ctor_excess(decls, tab)
  if n == 0 { [] } else {
    match largest_sum(decls, None) {
      Some(d) -> variant_capacity_diag(decl_diag_file(d, df), tab, d, n)
      None    -> []
    }
  }
}

# The sum type with the most constructors: where splitting helps most.
fn largest_sum(ds: [Decl], best: Option[Decl]) : Option[Decl] = match ds {
  [] -> best
  [d, ...rest] -> if sum_width(d) > opt_sum_width(best) { largest_sum(rest, Some(d)) } else { largest_sum(rest, best) }
}

fn sum_width(d: Decl) : Int = match d {
  DType(_, _, _, TBSum(vs), _, _, _, _) -> list_length(vs)
  _ -> 0
}

fn opt_sum_width(d: Option[Decl]) : Int = match d {
  Some(x) -> sum_width(x)
  None    -> 0
}

fn variant_capacity_diag(file: String, tab: SymTab, d: Decl, n: Int) : [Diagnostic] = match d {
  DType(_, s, _, _, l, c, _, _) ->
    [mk_diag(SevError, file, l, c,
      concat_all(["the program declares ", int_to_string(n),
        " variant constructors; at most ", int_to_string(variant_ctor_limit()), " fit the constructor tag space"]),
      [ri_help(file, l, c, concat_all(["`", "#{decl_name(tab, s)}", "` is the widest sum type (", int_to_string(sum_width(d)), " constructors); split it, or carry its cases as data"]))])]
  _ -> []
}

# === D2: name-collision error semantics ===
#
# `type A = Foo | Bar` and `type B = Foo | Baz` are both attempting
# to *implicitly declare* a nominal type `Foo`. D2 says: refuse, and
# instruct the user to pre-declare `type Foo = ...` once and
# reference it from both unions.
#
# Detection rule:
#   - Walk every `TBSum` decl in source order.
#   - For each variant name `v`:
#       - If `v` is the name of *some* `DType` in the program (any
#         shape — record, sum, alias, effect-alias), it is
#         pre-declared. The TBSum *references* it. No error.
#       - Else if `v` was already claimed by an EARLIER `TBSum` decl
#         with a *different* parent name, that's D2 — emit an error
#         pointing at the current decl, with a note pointing at the
#         earlier one and a hint to pre-declare.
#       - Else record the claim and continue.
#   - `A | A` (same parent claiming `A` twice) is D6 idempotence,
#     not D2 — `normalize_union` collapses the duplicate, no error.

type VariantClaim = VC(SymId, SymId, Int, Int)
#                       ^variant ^parent ^line ^col   (line/col of the
#                                                claiming TBSum)

# Claims bucketed by the variant's constructor id, which a second sum of
# the same home claiming the name derives too. A bucket keeps insertion
# order newest-first, so its first match is the one a scan of all claims
# finds.
type Claims = NameIndex[VariantClaim]

# Find the first claim in the variant's bucket whose parent differs from
# `parent`. Same-parent claims are not collisions (D6 idempotence; the
# union normalises to a singleton). Two homes each claiming the name are
# two constructors — ctor overloading, resolved at the use site.
fn find_other_claim(chain: [VariantClaim], parent: SymId) : Option[VariantClaim] {
  match chain {
    [] -> None
    [c, ...rest] -> match c {
      VC(_, p, _, _) -> {
        if sym_raw(p) != sym_raw(parent) { Some(c) }
        else { find_other_claim(rest, parent) }
      }
    }
  }
}

fn add_claim(claims: Claims, c: VariantClaim) : Claims =
  match c { VC(v, _, _, _) -> idx_prepend_sym(claims, v, c) }

#[doc("The error for every union variant a second union of the same home claims implicitly, in source order.")]
pub(pkg) fn validate_union_collisions_decls(ds: [Decl], tab: SymTab, df: DiagFiles) : [Diagnostic] {

  let top_names = collect_top_type_names(ds, tab)
  # D2 only governs root-file unions. `target_mod` is the root file's
  # stamped module_origin (`tag_target_decls_module_origin`); a DType
  # whose origin differs belongs to a core/imported module and must
  # not participate — a user union reusing a core type's variant name
  # is ctor overloading resolved at use sites, not a collision.
  let target_mod = root_module_name(df_root(df))
  finalize_diags(validate_union_collisions_loop(ds, tab, top_names, df, target_mod, [], idx_empty()))
}

# The name of every type the stream declares, a record, an alias and an
# effect alias included: a variant spelled like one refers to it.
fn collect_top_type_names(ds: [Decl], tab: SymTab) : [String] = collect_top_type_names_loop(ds, tab, [])

fn collect_top_type_names_loop(ds: [Decl], tab: SymTab, acc: [String]) : [String] {
  match ds {
    [] -> list_reverse(acc)
    [d, ...rest] -> match decl_transparent_inner(d) {
      Some(inner) -> collect_top_type_names_loop([inner, ...rest], tab, acc)
      None -> match d {
        DType(_, tsym, _, _, _, _, _, _) -> collect_top_type_names_loop(rest, tab, [written_text(decl_name(tab, tsym)), ...acc])
        _ -> collect_top_type_names_loop(rest, tab, acc)
      }
    }
  }
}

# Root-file decls are unstamped, or stamped with the root module's own name.
fn decl_is_root(origin: Option[String], target_mod: String) : Bool =
  match origin {
    None    -> true
    Some(m) -> m == target_mod
  }

# A root variant spelled like a constructor the core builds (`Some`,
# `None`, `Ok`, `Err`) is a reference to that one, never a claim.
fn names_core_ctor(tab: SymTab, vname: String) : Bool =
  st_valid(tab, sym_derive(NCCtor, vname, core_type_home()))

fn validate_union_collisions_loop(remaining: [Decl], tab: SymTab, top_names: [String],
    df: DiagFiles,
    target_mod: String, acc: [Diagnostic],
    claims: Claims) : [Diagnostic] {

  match remaining {
    [] -> acc
    [d, ...rest] -> match d {
      # Claims are scoped to the declaring home, so an imported module's
      # union participates without colliding with the root's: two homes
      # claiming one variant name is ctor overloading resolved at the
      # use site, not D2. Within one home the check is unchanged.
      DType(_, parent, _, body, line, col, origin, _) -> match body {
        TBSum(vs) -> {
          let decl_file = decl_diag_file(d, df)
          let r = check_variants_for_collision(vs, tab, decl_is_root(origin, target_mod), parent, line, col,
          top_names, claims, decl_file, acc)
          validate_union_collisions_loop(rest, tab, top_names, df, target_mod, r.diags, r.claims)
        }
        _ -> validate_union_collisions_loop(rest, tab, top_names, df, target_mod, acc, claims)
      }
      _ -> validate_union_collisions_loop(rest, tab, top_names, df, target_mod, acc, claims)
    }
  }
}

# `diags` is the running accumulator, newest first.
type CollisionResult = { diags: [Diagnostic], claims: Claims }

# One variant against the claims seen so far. A pre-declared name and a
# root variant spelled like a core constructor are references, not
# implicit declarations, so neither reports.
fn variant_collision_step(v: SymId, tab: SymTab, is_root: Bool, parent: SymId,
    line: Int, col: Int, top_names: [String],
    claims: Claims,
    decl_file: String, acc: [Diagnostic]) : CollisionResult = {
  let vname = written_text(decl_name(tab, v))
  if list_has(top_names, vname) or (is_root and names_core_ctor(tab, vname)) { CollisionResult { diags: acc, claims: claims } }
  else { match find_other_claim(idx_chain_sym(claims, v), parent) {
    None -> CollisionResult { diags: acc,
        claims: add_claim(claims, VC(v, parent, line, col)) }
    Some(prev) ->
      CollisionResult { diags: [d2_collision_diag(tab, decl_file, vname, parent, line, col, prev), ...acc], claims: claims }
  } }
}

fn check_variants_for_collision(vs: [Variant], tab: SymTab, is_root: Bool, parent: SymId,
    line: Int, col: Int,
    top_names: [String], claims: Claims,
    decl_file: String, acc: [Diagnostic]) : CollisionResult {

  match vs {
    [] -> CollisionResult { diags: acc, claims: claims }
    [v, ...rest] -> match v {
      Var(c, _) -> {
        let step = variant_collision_step(c, tab, is_root, parent, line, col,
          top_names, claims, decl_file, acc)
        check_variants_for_collision(rest, tab, is_root, parent, line, col,
          top_names, step.claims, decl_file,
          step.diags)
      }
    }
  }
}

# The error points at the second declaration to claim the name and
# cites the first; the help says how to share the component.
fn d2_collision_diag(tab: SymTab, file: String, vname: String, parent: SymId,
    line: Int, col: Int, prev: VariantClaim) : Diagnostic {
  match prev {
    VC(_, prev_parent, prev_line, prev_col) -> {
      let msg = concat_all(["type '", vname,
          "' is declared by both 'type ",
          written_text(decl_name(tab, prev_parent)),
          " = ...' (",
          file, ":",
          int_to_string(prev_line), ":",
          int_to_string(prev_col),
          ") and 'type ",
          written_text(decl_name(tab, parent)),
          " = ...' (",
          file, ":",
          int_to_string(line), ":",
          int_to_string(col),
          ")"])
      mk_diag(SevError, file, line, col, msg,
        [ri_help(file, line, col, concat_all(["pre-declare 'type ", vname,
          " = ...' once and reference it from both unions"]))])
    }
  }
}

# type-name collisions across module boundaries.
#
# Two related contracts. Both rejected up front instead of letting
# resolution pick one definition non-deterministically and emit
# downstream errors that name constructors the user never wrote.
#
#   (a) A user `type T = ...` whose name `T` is already exported by
#       a core or imported module. Without this check the typer's
#       variant lookup walks both definitions and reports `match` arms
#       as non-exhaustive against the *other* file's constructors.
#       This validator closes the type-name path for `pub type`
#       exported by any module in the table — auto-loaded cores
#       and explicit `import` lines alike.
#
#   (b) Two `type T = ...` declarations in the SAME root file.
#       Stage 2 silently accepts; the typer picks one nondeterm-
#       inistically. Rejecting at the second occurrence keeps the
#       diagnostic local.
#
# Diagnostic always points at the *user's* DType (the second site
# to claim the name): `path` is the root file, line/col come from
# the offending DType. The first claimant is named in the message
# either by its module name (case a) or by its earlier line/col
# (case b).
#
# Approach mirrors `validate_union_collisions_decls`: a small walker
# over `root_only_decls`, two helper lookups against `module_table`
# (case a) and an in-flight claim list (case b). No interaction with
# the typer or pattern-exhaustiveness — that machinery keeps working
# under the assumption that one type name resolves to one definition,
# which is exactly what this validator enforces.

# ----------------------------------------------------------------------
# Shape-application formation pass.
#
# A `[s: Shape]` tparam is an arity-1 constructor applied as `s[A]`.
# Formation is strict: `s` takes exactly one type argument, and that
# argument may not itself be a bare shape variable (no `s[t[A]]`
# composition — the case that would reintroduce higher-order
# unification). Both are rejected here with a clear diagnostic, at the
# signature that writes them, so the user gets a recipe rather than a
# downstream unification failure.

#[doc("infer: validate `Shape`-tparam application formation across the decl stream; returns its diagnostics.")]
pub(pkg) fn validate_shape_refs_decls(decls: [Decl], df: DiagFiles) : [Diagnostic] =
  validate_shape_refs_loop(decls, df, [])

fn validate_shape_refs_loop(decls: [Decl], df: DiagFiles, errs: [Diagnostic]) : [Diagnostic] =
  match decls {
    [] -> errs
    [d, ...rest] -> validate_shape_refs_loop(rest, df, errs ++ validate_shape_refs_decl(d, decl_diag_file(d, df)))
  }

# The `DImpl` arm re-enters the walk for the methods, which already
# resolved their file from the enclosing decl.
fn validate_shape_refs_sub_decls(decls: [Decl], file: String, errs: [Diagnostic]) : [Diagnostic] =
  match decls {
    [] -> errs
    [d, ...rest] ->
      validate_shape_refs_sub_decls(rest, file, errs ++ validate_shape_refs_decl(d, file))
  }

fn validate_shape_refs_decl(d: Decl, file: String) : [Diagnostic] = match d {
  DFn(_, _, tparams, ps, ret, _, _, _, _, _) -> {
    let shapes = filter(tparams, tb_is_shape)
    let e0 = validate_shape_refs_params(ps, shapes, file, [])
    match ret {
      Some(te) -> e0 ++ validate_shape_refs_te(te, shapes, file)
      None -> e0
    }
  }
  DProtocol(_, _, tparams, ops, _, _, _) -> {
    let shapes = filter(tparams, tb_is_shape)
    validate_shape_refs_protoops(ops, shapes, file, [])
  }
  DEffect(_, _, _, ops, _, _, _, _) -> validate_shape_refs_eops(ops, [], file, [])
  DImpl(_, _, _, sub_decls, _, _, _, _) -> validate_shape_refs_sub_decls(sub_decls, file, [])
  DDerive(_, inner, _, _) -> validate_shape_refs_decl(inner, file)
  DUnstable(inner, _, _) -> validate_shape_refs_decl(inner, file)
  DProtoLaws(_, inner, _, _, _) -> validate_shape_refs_decl(inner, file)
  DImplAxiom(_, inner, _, _, _) -> validate_shape_refs_decl(inner, file)
  DConstructor(inner, _, _) -> validate_shape_refs_decl(inner, file)
  _ -> []
}

fn validate_shape_refs_params(ps: [Param], shapes: [TBinder], file: String,
                              acc: [Diagnostic]) : [Diagnostic] = match ps {
  [] -> acc
  [p, ...rest] -> {
    let e1 = match p.ptype {
      Some(te) -> acc ++ validate_shape_refs_te(te, shapes, file)
      None -> acc
    }
    validate_shape_refs_params(rest, shapes, file, e1)
  }
}

fn validate_shape_refs_protoops(ops: [ProtoOp], shapes: [TBinder], file: String,
                                acc: [Diagnostic]) : [Diagnostic] = match ops {
  [] -> acc
  [POp(_, _, ps, ret, _, _), ...rest] -> {
    let e1 = acc ++ validate_shape_refs_params(ps, shapes, file, []) ++
              validate_shape_refs_te(ret, shapes, file)
    validate_shape_refs_protoops(rest, shapes, file, e1)
  }
}

fn validate_shape_refs_eops(ops: [EffectOp], shapes: [TBinder], file: String,
                            acc: [Diagnostic]) : [Diagnostic] = match ops {
  [] -> acc
  [EffOp(_, _, ps, ret, _, _), ...rest] -> {
    let e1 = acc ++ validate_shape_refs_params(ps, shapes, file, []) ++
              validate_shape_refs_te(ret, shapes, file)
    validate_shape_refs_eops(rest, shapes, file, e1)
  }
}

# Walk a signature TypeExpr; a use of a shape parameter must apply it to
# exactly one argument, and that argument may not be a bare shape
# variable (composition). Nested positions recurse.
fn validate_shape_refs_te(te: TypeExpr, shapes: [TBinder], file: String) : [Diagnostic] =
  match te.tkind {
    TyName(_, targs) -> validate_shape_refs_te_composition(targs, shapes, file, [])
    TyParam(id, targs) -> {
      if tbs_has(shapes, id) {
        let name = tbs_text_of(shapes, id)
        let e_arity = if list_length(targs) == 1 { [] } else {
          [mk_diag(SevError, file, te.line, te.col,
            concat_all(["shape `", name, "` must be applied to exactly one type argument (`",
              name, "[A]`); it is an arity-1 constructor"]), [])]
        }
        e_arity ++ validate_shape_refs_te_list(targs, shapes, file, [])
      } else {
        # a concrete head whose argument is a bare shape var is
        # composition `t[s[..]]` only when the arg head is itself a
        # shape variable — checked as we recurse below.
        validate_shape_refs_te_composition(targs, shapes, file, [])
      }
    }
    TyList(inner) -> validate_shape_refs_te(inner, shapes, file)
    TyFn(ps, ret, _) -> validate_shape_refs_te_list(ps, shapes, file, []) ++
                        validate_shape_refs_te(ret, shapes, file)
    TyDim(base, _) -> validate_shape_refs_te(base, shapes, file)
    TyRefine(base, _) -> validate_shape_refs_te(base, shapes, file)
    TyRow(_) -> []
    TySurface(ts) -> validate_shape_refs_te_composition(tysurface_children(ts), shapes, file, [])
  }

# The argument of a shape application must not be a bare shape variable:
# `s[t[Int]]` with `t` a shape var is composition, rejected at formation.
fn validate_shape_refs_te_list(tes: [TypeExpr], shapes: [TBinder], file: String,
                               acc: [Diagnostic]) : [Diagnostic] = match tes {
  [] -> acc
  [t, ...rest] -> {
    let e_comp = match t.tkind {
      TyParam(id, _) -> {
        let hn = tbs_text_of(shapes, id)
        if tbs_has(shapes, id) {
          [mk_diag(SevError, file, t.line, t.col,
            concat_all(["shape composition `s[t[..]]` is not supported: `", hn,
              "` is a shape variable and may not stand under another shape application"]), [])]
        } else { [] }
      }
      _ -> []
    }
    validate_shape_refs_te_list(rest, shapes, file, acc ++ e_comp ++ validate_shape_refs_te(t, shapes, file))
  }
}

fn validate_shape_refs_te_composition(tes: [TypeExpr], shapes: [TBinder], file: String,
                                      acc: [Diagnostic]) : [Diagnostic] = match tes {
  [] -> acc
  [t, ...rest] ->
    validate_shape_refs_te_composition(rest, shapes, file,
      acc ++ validate_shape_refs_te(t, shapes, file))
}
