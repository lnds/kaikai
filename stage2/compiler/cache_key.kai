#[doc("Cache identity: how a cache key is composed and hashed, and how a stored blob or object is checked against its content.")]

import compiler.util

# Nibbles come from `%` and `/` alone: the bootstrap compiler that builds this
# module has no bit operators. `h` is a signed Int64 (FNV-1a cast through
# int64_t), so the low nibble is folded into [0,15] first.
fn ck_nibble(n: Int) : String {
  let d = if n < 0 { 0 } else if n > 15 { 15 } else { n }
  if d < 10 { int_to_byte_string(48 + d) } else { int_to_byte_string(87 + d) }
}

#[doc("A 64-bit hash as 16 lowercase hex chars (least-significant nibble last), the form a cache key takes.")]
pub fn ck_hex16(h: Int) : String = ck_hex16_loop(h, 16, "")

fn ck_hex16_loop(h: Int, steps: Int, acc: String) : String =
  if steps <= 0 {
    acc
  } else {
    ck_hex16_loop(h / 16, steps - 1, string_concat(ck_nibble((h % 16 + 16) % 16), acc))
  }

#[doc("Content hash of a string as 16 lowercase hex chars. Changes on any single-byte edit.")]
pub fn ck_hex(s: String) : String = ck_hex16(string_hash(s))

#[doc("A 128-bit content hash of a string as 32 hex chars: two FNV-1a passes under distinct prefixes, wide enough that an accidental collision is not a practical concern.")]
pub fn ck_wide(s: String) : String =
  string_concat(ck_hex16(string_hash(s)), ck_hex16(string_hash(string_concat("wide\n", s))))

#[doc("The parts of a key as one unambiguous string: each part is length-prefixed, so no two part lists compose to the same text.")]
pub fn ck_compose(parts: [String]) : String =
  concat_all(map(parts, p => concat_all([int_to_string(string_length(p)), ":", p, "\n"])))

#[doc("The wide key of `parts` under `domain`: every input that shapes a cached artifact goes through here.")]
pub fn ck_key(domain: String, parts: [String]) : String = ck_wide(ck_compose([domain, ...parts]))

#[doc("Checksum of `buf` from byte `off` to the end, as 16 hex chars.")]
pub fn ck_sum_hex(buf: Array[Byte], off: Int) : String =
  ck_hex(bytes_get_string(buf, off, array_length(buf) - off))

#[doc("Whether the object at `obj` exists and its bytes match the digest its emitter recorded in `<obj>.sum`; an object with no record, or a stale one, is not trusted.")]
pub fn ck_obj_sealed(obj: String) : Bool / File = match __file_read(obj) {
  Err(_) -> false
  Ok(bytes) -> match __file_read(string_concat(obj, ".sum")) {
    Ok(sum) -> sum == int_to_string(string_hash(bytes))
    Err(_) -> false
  }
}
