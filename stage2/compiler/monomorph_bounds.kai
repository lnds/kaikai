#[doc("""
The protocol bounds of a generic's type parameters, checked against the
types of one instantiation.
""")]

import compiler.ast
import compiler.type_text
import compiler.written
import compiler.decl_text
import compiler.util
import compiler.scalar_ty
import compiler.impl_identity
import compiler.protos_registry
import compiler.protos_calls
import compiler.protos_derive_check
import compiler.protos_find_impl
import compiler.proto_resolve
import compiler.core_protos
import compiler.monomorph_mangle

#[doc("One free-fn protocol-bound violation caught at a concrete instantiation: the message plus the call-site (or callee) location.")]
pub type BoundViolation = BV(String, Int, Int)

#[doc("A source position.")]
pub type LineCol = MoLC(Int, Int)

#[doc("The violations of the bounds `ftbs` by the types `tys` of one instantiation of `callee`.")]
pub fn check_tuple_bounds(ftbs: [FnTPBound], tys: [Ty], callee: SymId,
                      fmo: Option[String],
                      reg: ProtocolReg, loc: LineCol,
                      ps: PScope, acc: [BoundViolation]) : [BoundViolation] {
  match ftbs {
    [] -> acc
    [ftb, ...rest] -> match ftb {
      FTB(idx, protos) -> {
        let acc1 = match ty_at(tys, idx) {
          None -> acc
          Some(ty) -> match ty_disp_head(ty) {
            None -> acc
            Some(head) -> check_protos_for_head(protos, head, callee, fmo, ty, reg, loc, ps, acc)
          }
        }
        check_tuple_bounds(rest, tys, callee, fmo, reg, loc, ps, acc1)
      }
    }
  }
}

fn check_protos_for_head(protos: [DeclRef], head: DispHead, callee: SymId,
                         fmo: Option[String],
                         ty: Ty, reg: ProtocolReg, loc: LineCol,
                         ps: PScope, acc: [BoundViolation]) : [BoundViolation] {
  match protos {
    [] -> acc
    [p, ...rest] -> {
      let acc1 = if head_satisfies_proto(reg, p, fmo, head, ps) { acc }
                 else {
                   let msg = concat_all(["type `", mono_ty_to_string(ps_tab(ps), ty),
                     "` does not satisfy the bound `", ref_display(ps_tab(ps), p),
                     "` on a type parameter of `", written_text(decl_name(ps_tab(ps), callee)), "`"])
                   match loc { MoLC(l, c) -> [BV(msg, l, c), ...acc] }
                 }
      check_protos_for_head(rest, head, callee, fmo, ty, reg, loc, ps, acc1)
    }
  }
}

# Canonical "head satisfies protocol": a user impl or a derive-
# synthesised impl (both land in `reg.impls` via `expand_derives`
# + `lower_impls`), or a structural builtin (Int/Real/... for
# Eq/Show/Ord/Hash).
# The bound's name resolves from the declaring fn's module, so a
# contested protocol name checks against its own impl table.
fn head_satisfies_proto(reg: ProtocolReg, proto: DeclRef,
                        fmo: Option[String], head: DispHead,
                        ps: PScope) : Bool {
  let psym = proto_ref_sym(ps, proto, fmo)
  prc_reg_has_impl(reg, psym, head) or match core_proto_of(psym) {
    Some(cp) -> head_has_builtin_impl(cp, head)
    None     -> false
  }
}

# Only a scalar has a structural builtin impl.
fn head_has_builtin_impl(cp: CoreProto, head: DispHead) : Bool = match head {
  DhScalar(t) -> match scalar_ty_name(t) {
    Some(n) -> derive_builtin_impl(cp, n)
    None    -> false
  }
  DhSym(_) -> false
}

fn ty_at(tys: [Ty], idx: Int) : Option[Ty] {
  match tys {
    [] -> None
    [t, ...rest] -> if idx == 0 { Some(t) } else { ty_at(rest, idx - 1) }
  }
}
