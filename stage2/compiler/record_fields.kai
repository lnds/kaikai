# compiler/record_fields.kai — a named record literal lists each
# declared field exactly once.

import compiler.diag

#[doc("The diagnostics for a record literal whose field names are not exactly its declared ones.")]
pub fn record_lit_field_errors(rec: String, given: [String], declared: [String]) : [String] =
  duplicate_errors(rec, given) ++ unknown_errors(rec, given, declared) ++ missing_errors(rec, given, declared)

fn duplicate_errors(rec: String, given: [String]) : [String] =
  uniq(given)
    |> filter((g) => count(given, (x) => x == g) > 1)
    |> map((g) => "field '#{g}' given more than once in #{rec} literal")

fn unknown_errors(rec: String, given: [String], declared: [String]) : [String] =
  uniq(given)
    |> filter((g) => not any(declared, (d) => d == g))
    |> map((g) => "no field '#{g}' on #{rec}#{literal_hint(g, absent(declared, given))}")

fn missing_errors(rec: String, given: [String], declared: [String]) : [String] =
  match absent(declared, given) {
    []    -> []
    [one] -> ["missing field '#{one}' in #{rec} literal"]
    many  -> ["missing fields #{quoted(many)} in #{rec} literal"]
  }

fn absent(declared: [String], given: [String]) : [String] =
  filter(declared, (d) => not any(given, (g) => g == d))

fn literal_hint(target: String, declared: [String]) : String =
  match closest_name(target, declared) {
    Some(sug) -> " (did you mean `#{sug}`?)"
    None      -> ""
  }

fn quoted(names: [String]) : String = join(map(names, (n) => "'#{n}'"), ", ")
