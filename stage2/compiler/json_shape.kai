#[doc("""
compiler.json_shape - which JSON shape a `#[derive(Json)]` field has.

Classifies a field's declared type into the `JsonShape` the impl builder
reads and encodes it as, and explains the classification's refusals so
the pre-expansion validator can report an unbindable field at the derive
rather than leaving it to surface as a missing `to_json` at the first
call site. It also counts the combinator lambdas a shape's encoder and
decoder emit, which is what gives each synthesised lambda a column of
its own.
""")]

import compiler.util
import compiler.ast
import compiler.fnreg

#[doc("The JSON shape a field's declared type binds as. `JSOpt` wraps the inner shape rather than being a leaf of its own: `Option[[Int]]` needs both the optional reader and the element reader the list would have used.")]
pub type JsonShape = JSStr | JSInt | JSReal | JSBool
                   | JSList(JsonShape)
                   | JSOpt(JsonShape)
                   | JSRecord(String)

#[doc("A record field reduced to its kaikai name, its wire name (equal to the kaikai name unless `#[json(rename)]` overrides it), the JSON shape it binds as, an optional `#[json(default)]` expression, and whether it carries `#[json(skip)]`.")]
pub type JsonField = JF(String, String, JsonShape, Option[Expr], Bool)

# ---- field-shape classification ------------------------------------
#
# A field's declared type decides which reader/encoder pair it gets. An
# unrecognised head yields `None`, which drops the whole derive — the
# validator turns that into a located error naming the field.

# The sole type argument of `Name[T]`, or `None` for any other arity.
# Read with `map` inside the arm that destructured the variant: kaic1
# miscompiles a variant's list payload passed positionally to a helper
# that matches on it, so the payload is reduced here and only the
# reduced value travels.
fn jd_sole_arg(t: TypeExpr) : Option[TypeExpr] = match t.tkind {
  TyName(_, _, targs) -> match map(targs, (a: TypeExpr) => a) {
    [a] -> Some(a)
    _   -> None
  }
  _ -> None
}

pub fn jd_shape_of(t: TypeExpr) : Option[JsonShape] = match t.tkind {
  TyList(elem) -> jd_wrap_list(jd_shape_of(elem))
  TyName(_, n, _) -> jd_named_shape(t, n, resolve_ty(t))
  _ -> None
}

# The shape of a written type name, decided by what it resolves to. The
# name is only what a nested record's shape is spelled with.
fn jd_named_shape(t: TypeExpr, n: String, ty: Ty) : Option[JsonShape] = match ty {
  TyString -> Some(JSStr)
  TyInt    -> Some(JSInt)
  TyReal   -> Some(JSReal)
  TyBool   -> Some(JSBool)
  _ -> match jd_collection_of(ty) {
    Some(CtOption) -> jd_wrap_opt(jd_shape_inner(t))
    Some(_)        -> jd_wrap_list(jd_shape_inner(t))
    None -> if jd_is_user_type(n) and jd_arity(t) == 0 { Some(JSRecord(n)) } else { None }
  }
}

# The collection a resolved head is: `Option` or `List`.
fn jd_collection_of(ty: Ty) : Option[CoreTy] = match ty {
  TyCon(_, _, _, s) ->
    if core_ty_is(s, CtOption) { Some(CtOption) }
    else if core_ty_is(s, CtList) { Some(CtList) }
    else { None }
  _ -> None
}

fn jd_collection(t: TypeExpr) : Option[CoreTy] = match t.tkind {
  TyName(_, _, _) -> jd_collection_of(resolve_ty(t))
  _ -> None
}

# A generic head is not a JSON-bindable record: the derive emits a call
# to the monomorphic `<lower(T)>_of_json` shim, which a parameterised
# type has none of.
fn jd_arity(t: TypeExpr) : Int = match t.tkind {
  TyName(_, _, targs) -> jd_count(map(targs, (a: TypeExpr) => a), 0)
  _ -> 0
}

fn jd_count(xs: [TypeExpr], acc: Int) : Int = match xs {
  []          -> acc
  [_, ...rest] -> jd_count(rest, acc + 1)
}

fn jd_shape_inner(t: TypeExpr) : Option[JsonShape] = match jd_sole_arg(t) {
  None    -> None
  Some(a) -> jd_shape_of(a)
}

# A nested record is any capitalised head that is not a builtin leaf —
# whether it actually derives Json is checked at the call site the
# emitted body makes, which is where the user gets the better message.
fn jd_is_user_type(n: String) : Bool = match char_at(n, 0) {
  None    -> false
  Some(c) -> {
    let nc = char_to_int(c)
    nc >= 65 and nc <= 90
  }
}

fn jd_wrap_list(inner: Option[JsonShape]) : Option[JsonShape] = match inner {
  None    -> None
  Some(s) -> Some(JSList(s))
}

# `Option[Option[T]]` has no JSON denotation — one `null` cannot mean two
# different absences — so it is rejected rather than silently flattened.
fn jd_wrap_opt(inner: Option[JsonShape]) : Option[JsonShape] = match inner {
  None    -> None
  Some(s) -> match s {
    JSOpt(_) -> None
    _        -> Some(JSOpt(s))
  }
}

pub fn jd_fields_of(fields: [FieldDecl]) : Option[[JsonField]] =
  jd_fields_loop(fields, [])

# A `#[json(skip)]` field never reads or writes the wire, so its shape is
# inert: it may be a type with no JSON denotation as long as a default (or
# an `Option`) reconstructs it on decode — the validator enforces that
# rule, so here a skipped field with no denotation gets a placeholder
# shape that no reader/encoder is ever emitted for.
fn jd_fields_loop(fields: [FieldDecl], acc: [JsonField]) : Option[[JsonField]] =
  match fields {
    [] -> Some(list_reverse(acc))
    [fd, ...rest] -> match fd {
      FD(_, fname, ftype, attrs) -> {
        let wire = match field_attr_json_rename(attrs) { Some(w) -> w None -> fname }
        let dflt = field_attr_json_default(attrs)
        let skip = field_attr_json_skip(attrs)
        match jd_shape_of(ftype) {
          Some(s) -> jd_fields_loop(rest, [JF(fname, wire, s, dflt, skip), ...acc])
          None    -> if skip { jd_fields_loop(rest, [JF(fname, wire, JSStr, dflt, skip), ...acc]) }
                     else { None }
        }
      }
    }
  }

#[doc("Why `ftype` cannot be a `#[derive(Json)]` field, or `None` when it can. The pre-expansion validator turns the reason into a located error.")]
pub fn json_field_reject(ftype: TypeExpr) : Option[String] = match jd_shape_of(ftype) {
  Some(_) -> None
  None    -> Some(jd_reject_why(ftype))
}

fn jd_reject_why(t: TypeExpr) : String = match t.tkind {
  TyName(_, n, _) -> match jd_collection(t) {
    Some(c) -> jd_arg_reject_why(t, c)
    None ->
      if jd_arity(t) > 0 {
        concat_all(["`", n, "` is generic; only a monomorphic record can derive Json"])
      }
      else { concat_all(["`", n, "` has no JSON denotation"]) }
  }
  TyList(elem) -> concat_all(["its element type: ", jd_reject_why(elem)])
  _ -> "only records of JSON-bindable fields can derive Json"
}

fn jd_arg_reject_why(t: TypeExpr, head: CoreTy) : String = match jd_sole_arg(t) {
  None    -> concat_all(["`", core_ty_name(head), "` without a single type argument"])
  Some(a) ->
    if jd_is_option(head) and json_head_is_option(a) {
      "`Option[Option[T]]` cannot be told apart from `Option[T]`: one JSON `null` denotes one absence"
    } else {
      concat_all(["its ", core_ty_name(head), " element type: ", jd_reject_why(a)])
    }
}

fn jd_is_option(c: CoreTy) : Bool = match c {
  CtOption -> true
  _        -> false
}

#[doc("True when the head of `ftype` is `Option`.")]
pub fn json_head_is_option(ftype: TypeExpr) : Bool = match jd_collection(ftype) {
  Some(c) -> jd_is_option(c)
  None    -> false
}

#[doc("The head type name of `ftype` as written, for a diagnostic that names the offending field's type.")]
pub fn json_head_name(ftype: TypeExpr) : String = match ftype.tkind {
  TyName(_, n, _) -> n
  TyList(elem) -> concat_all(["[", json_head_name(elem), "]"])
  _            -> "?"
}

# ---- variant payloads ----------------------------------------------

#[doc("The JSON shapes of one variant's payload types, or `None` when a payload has no JSON denotation, which drops the whole derive.")]
pub fn jd_payload_shapes(vargs: [TypeExpr], acc: [JsonShape]) : Option[[JsonShape]] =
  match vargs {
    [] -> Some(list_reverse(acc))
    [t, ...rest] -> match jd_shape_of(t) {
      Some(s) -> jd_payload_shapes(rest, [s, ...acc])
      None    -> None
    }
  }

#[doc("The same payload shapes with an unbindable payload reduced to the empty list, for callers that already refused the derive.")]
pub fn jd_shape_of_all(vargs: [TypeExpr]) : [JsonShape] = match jd_payload_shapes(vargs, []) {
  Some(ss) -> ss
  None     -> []
}

# ---- synthesised-lambda slots --------------------------------------
#
# The lambda lifter keys a lifted lambda's C symbol on
# `(enclosing fn, line, col)`, and every node the impl builder makes
# carries the derive attribute's single source position. Two combinator
# lambdas in one derive would therefore mint the same symbol, so each
# gets a distinct synthetic column: a slot number, unique across the
# whole `to_json` / `of_json` body, offset past any real column on the
# line. The counts below mirror the emission walk and must stay in step
# with which shapes actually emit a lambda.

#[doc("The synthetic column a lambda in `slot` takes, offset past any real column on the line.")]
pub fn jd_slot_col(col: Int, slot: Int) : Int = col + 1000 + slot

#[doc("How many lambdas encoding a shape emits: one per list/option combinator, plus whatever the element shape nests.")]
pub fn jd_enc_lams(shape: JsonShape) : Int = match shape {
  JSList(inner) -> 1 + jd_enc_lams(inner)
  JSOpt(inner)  -> 1 + jd_enc_lams(inner)
  _ -> 0
}

#[doc("How many lambdas decoding a shape emits. Mirrors the encoder except at `Option`: a leaf reads through its own optional reader and emits none, and an optional list hands its ELEMENT decoder straight to `json_bind_opt_list`, skipping the list combinator's own lambda.")]
pub fn jd_dec_lams(shape: JsonShape) : Int = match shape {
  JSList(inner) -> 1 + jd_dec_lams(inner)
  JSOpt(inner)  -> match inner {
    JSStr  -> 0
    JSInt  -> 0
    JSReal -> 0
    JSBool -> 0
    JSList(elem) -> 1 + jd_dec_lams(elem)
    _ -> 1 + jd_dec_lams(inner)
  }
  _ -> 0
}

#[doc("How many lambdas one variant's payloads emit in the given direction.")]
pub fn jd_variant_lams(v: Variant, enc: Bool) : Int = match v {
  Var(_, vargs) -> jd_shapes_lams(jd_shape_of_all(vargs), enc, 0)
}

fn jd_shapes_lams(shapes: [JsonShape], enc: Bool, acc: Int) : Int = match shapes {
  [] -> acc
  [s, ...rest] ->
    jd_shapes_lams(rest, enc, acc + if enc { jd_enc_lams(s) } else { jd_dec_lams(s) })
}
