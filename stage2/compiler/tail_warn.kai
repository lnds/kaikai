#[doc("""
The tail recursion the C backend leaves as calls.

Fusion turns a group of functions that tail-call each other into one
self-recursive function. A group it does not fuse keeps one stack frame
per hop on the C backend, which has no guaranteed tail call across
functions of different signatures. This reports such a group of the
module being built. Run after protocol calls resolve to their implementations,
so a cycle through dispatch is a group like any other.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.proto_ids
import compiler.symtab
import compiler.tail_pos
import compiler.tailgraph
import compiler.written

#[doc("Print one warning on stderr for each group of `decls` that tail-calls in a cycle and has a member homed in `target`.")]
pub(pkg) fn tailwarn_unfused(decls: [Decl], tab: SymTab, ids: ProtoIds, target: String) : Unit / Console = {
  let callers = filter(decls, tw_tail_calls)
  let g = tailgraph_build(callers)
  tw_groups(tailgraph_groups(g), tailgraph_nodes(g), callers, tab, ids, target)
}

# A function with no tail call cannot be on a cycle.
fn tw_tail_calls(d: Decl) : Bool = match d {
  DFn(_, _, _, _, _, _, body, _, _, _) -> any(tail_leaves(body), (e) => match e.kind { ECall(_, _) -> true _ -> false })
  _ -> false
}

fn tw_groups(groups: [TgGroup], nodes: [TgNode], decls: [Decl], tab: SymTab, ids: ProtoIds, target: String) : Unit / Console = match groups {
  [] -> ()
  [grp, ...rest] -> {
    let members = flat_map(tggroup_members(grp), (i) => match nth(nodes, i) {
      Some(n) -> [n]
      None    -> []
    })
    if any(members, (n) => tw_homed(n, target)) {
      eprint(string_concat_all(["warning: ", tw_names(members, decls, tab, ids), " call each other in tail position and are not fused; ",
                                "each hop of the cycle keeps a stack frame on this backend"]))
    } else { () }
    tw_groups(rest, nodes, decls, tab, ids, target)
  }
}

# A specialisation or an implementation has no home of its own: it belongs to the module being built.
fn tw_homed(n: TgNode, target: String) : Bool = match n {
  TgN(Some(h), _, _) -> h == target
  TgN(None, _, _)    -> true
}

fn tw_names(members: [TgNode], decls: [Decl], tab: SymTab, ids: ProtoIds) : String =
  string_join(map(members, (n) => match n { TgN(_, _, s) -> tw_member(s, decls, tab, ids) }), ", ")

fn tw_member(s: SymId, decls: [Decl], tab: SymTab, ids: ProtoIds) : String =
  string_concat_all([tw_what(s, tab, ids), tw_pos(decls, s)])

# What the user wrote: the method of an impl, or the declared function.
fn tw_what(s: SymId, tab: SymTab, ids: ProtoIds) : String = match pid_impl(ids, s) {
  Some(PIR(p, target, op, _, _, _, _)) ->
    string_concat_all(["method `", written_text(op), "` of `impl ", written_text(sym_name(tab, p)), " for ", tw_ref_text(target, tab), "`"])
  None -> string_concat_all(["`", written_text(sym_name(tab, s)), "`"])
}

fn tw_pos(decls: [Decl], s: SymId) : String = match decls {
  [] -> ""
  [DFn(_, fid, _, _, _, _, _, ln, cl, _), ...rest] ->
    if sym_raw(fnid_sym(fid)) == sym_raw(s) { string_concat_all([" (line ", int_to_string(ln), ", column ", int_to_string(cl), ")"]) }
    else { tw_pos(rest, s) }
  [_, ...rest] -> tw_pos(rest, s)
}

fn tw_ref_text(r: DeclRef, tab: SymTab) : String = match r {
  DrSym(s)        -> written_text(sym_name(tab, s))
  DrWritten(_, n) -> written_text(n)
}
