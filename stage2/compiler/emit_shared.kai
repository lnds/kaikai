# compiler/emit_shared.kai — backend-shared lowering layer.
#
# Extracted from main.kai under issue #677 Phase 1r, ahead of the C
# emitter (compiler.emit_c). This module owns the stateless plumbing the
# C backend (`emit_program`) and the LLVM backend (`emit_program_llvm`)
# both consume: the layer that turns a resolved + monomorphised AST into
# the per-backend symbol tables, free-variable analyses, alias rewrites,
# FFI marshalling classifications, and protocol-dispatch decoders. Neither
# backend reads the typer's working state here — only the `.ty` already
# embedded in `Expr` nodes — so this is codegen-common, not typer code.
#
# Why it exists: the LLVM-backend lane (#699, phase 1q) duplicated 137 of
# these helpers as `lvm_*` mirrors rather than block on a future sink. The
# divergence debt was real (a codegen fix had to be applied twice or the
# two backends drift). This lane reconciles it: the 133 genuinely-shared
# helpers + their 13 helper types move here once, both backends import
# them, and the `lvm_*` copies are deleted from emit_llvm.kai. (Four
# `lvm_*` mirrors whose originals live outside the emit_c range — in the
# driver/head — stay in emit_llvm.kai until the driver lane.)
#
# What this module owns
#
#   - Symbol minting: `c_sym` / `c_sym_of_callee`, the `evar_*` variant-
#     table lookups, `register_variants` / `builtin_variants`.
#   - FFI marshalling: the `ffi_*` family + `FfiRetKind`.
#   - Free-variable analysis: the `fv_*` family + `FvScoped`.
#   - Alias rewriting: `rewrite_alias_*` / `alias_map_*` + `AliasMap` /
#     `StmtsRewrite`.
#   - Protocol-dispatch decoding: `proto_dispatch_*` / `pimpl_*` +
#     `ProtoDispatchParts` / `PimplRow` / `PR2`.
#   - The AST collector/functor glue both backends walk (`collect_*`,
#     `map_*_exprs`, `map_expr_kind`, `pat_bindings`).
#   - The lifted-clause/lambda descriptors `VariantEntry` / `ClauseInfo`
#     / `LamInfo` / `LamCollect` and the user-variant scan `CUVResult` /
#     `CUVStep`.
#
# Public surface: 133 fns + 13 types, all `pub` — every one is called by
# at least one of the two backends. That breadth is inherent: this module
# *is* the shared backend API. `join_with` did NOT come here — it is a
# generic string helper and moved to compiler.util instead.
#
# Bundle order: ... unbox, perceus, protos, monomorph, **emit_shared**,
# emit_llvm, emit_c, main. Imports compiler.ast (AST nodes + `mk_expr`),
# compiler.util (string/list/char helpers incl. the relocated `join_with`),
# compiler.fnreg (`EFn` + the `scan_uses_*` use-scan family),
# compiler.infer (`AliasBinding` / `Use` + `unit_canon` /
# `label_to_string` / `lookup_alias`), compiler.resolve (`core_names`),
# and compiler.unbox (`uses_have_in_lam`).

import compiler.ast
import compiler.written
import compiler.symtab
import compiler.symtab_build
import compiler.decl_names
import compiler.decl_text
import compiler.local_names
import compiler.spec_names
import compiler.core_effects
import compiler.core_protos
import compiler.entry
import compiler.core_types
import compiler.effect_default
import compiler.type_text
import compiler.head_tag_decl
import compiler.util
import compiler.loop_lower
import compiler.fnreg
import compiler.fn_index
import compiler.fn_csym
import compiler.infer
import compiler.resolve
import compiler.handler_alias
import compiler.unbox
import compiler.evidence_scan
import compiler.perceus_payer
import compiler.ret_slots
import compiler.type_home

# ====================================================================

# Build-time wrapper selection passed to the emitters. Collapses the
# previous test_mode/bench_mode/check_mode Bool triple. `BMBuild` is the
# ordinary `main` path; the other three each emit a distinct wrapper.
# Lives here (not in a backend) so the C-direct and native emitters both
# import it without depending on one another.
#[doc("Build-time wrapper selection (build/test/bench/check) passed to the emitters; the driver consumes it from here.")]
pub type BuildMode = BMBuild | BMTest | BMBench | BMCheck

# The slot kinds are resolved once, from the declaring module, so every
# consumer reads the same layout verdict instead of re-reading a payload
# type name that a homonym elsewhere could shadow.
#[doc("Emit-side variant table entry: declaring module, constructor name, arity, payload slot kinds, head tag.")]
pub type VariantEntry = EV(Option[String], String, Int, [Int], Int)

# A `test` / `bench` / `check` block has no name to derive a symbol from,
# so its runner is keyed on the declaring module plus its source position:
# position alone collides across modules, and the collision silently fuses
# two blocks' lifted lambdas into one. The symbol doubles as the enclosing
# fn of everything lifted out of the block's body (lambdas, clauses), so
# the collector and both backends must mint it here rather than each
# rebuilding the string.
#[doc("The runner symbol for a `test`/`bench`/`check` block, keyed on its module and source position.")]
pub fn runner_enc_fn(kind: String, mo: Option[String], line: Int, col: Int) : String =
  concat_all(["__", kind, "__", c_sym(concat_all([int_to_string(line), "_", int_to_string(col)]), mo)])

# A user fn's own C symbol lives in the `kaiu_` namespace so it can be
# named after any runtime helper without redeclaring it. `c_sym` stays the
# unprefixed key every internal table is keyed by (purity, reuse-donation,
# evidence frames) and the symbol the native backend emits verbatim; the
# prefix belongs to the C emission border alone.
#
# `main` is the one exception: the runtime's `int main` calls `kai_main` by
# that literal name, so it must not move.
#[doc("Prefix a user function's `c_sym` for C emission, keeping user symbols out of the runtime's `kai_` namespace.")]
pub fn c_user_sym(csym: String) : String =
  if csym == "main" { "kai_main" } else { string_concat("kaiu_", csym) }

# The runtime defines `_kai_<prim>_thunk` for its core prims, so a user
# thunk needs the `kaiu` namespace too.
#[doc("The closure-thunk symbol for a user function's `c_sym`.")]
pub fn c_user_thunk_sym(csym: String) : String =
  string_concat("_kaiu_", string_concat(csym, "_thunk"))

# Emitted only as a C label (`X:;` / `goto X`). C labels live in their
# own namespace, so no runtime symbol can ever collide with one; the
# `_kai_` spelling is safe by construction, not by inspection.
#[doc("The TCO/TRMC entry label for a user function's `c_sym`.")]
pub fn c_user_entry_label(csym: String) : String =
  string_concat("_kai_", string_concat(csym, "_entry"))

# The native backend emits a boxed-ABI adapter beside each raw protocol
# impl; the symbol is minted from the impl's `c_sym`, so it needs the
# user namespace like every other user-derived symbol.
#[doc("The boxed-ABI protocol adapter symbol for a raw impl's `c_sym`.")]
pub fn user_boxed_adapter_sym(csym: String) : String =
  string_concat("_kaiu_", string_concat(csym, "__boxed"))

# Handler-scoped symbols key on the ENCLOSING FN plus the handle's source
# position and, for a clause, the op name. The enclosing fn is part of the
# key, not decoration: a source position is not an identity — two modules
# both have a line 2 column 1, and two monomorph specialisations of one
# source fn share a position exactly — so a position-only symbol collides
# and the linker silently keeps one definition. `enc_fn` is the
# post-monomorph, module-mangled symbol of the containing fn / lambda /
# clause / test, which discriminates both shapes at once. Every site minting one of
# these — install, clause body, cleanup, env struct, on either backend —
# feeds the SAME `enc_fn`, read from `ClauseInfo.enc_fn` or `LowerSt.enc_fn`.
#[doc("The `_kaiu_<enc_fn>__<what>_<L>_<C>` symbol shared by every handler-scoped emission.")]
pub fn handler_scoped_sym(what: String, enc_fn: String, line: Int, col: Int) : String =
  concat_all(["_kaiu_", enc_fn, "__", what, "_",
              int_to_string(line), "_", int_to_string(col)])

#[doc("The install-site symbol for a handler in `enc_fn` at a source position.")]
pub fn user_handler_sym(enc_fn: String, line: Int, col: Int) : String =
  handler_scoped_sym("handler", enc_fn, line, col)

#[doc("The clause-thunk symbol for a handler op clause in `enc_fn` at a source position.")]
pub fn user_clause_sym(enc_fn: String, line: Int, col: Int, op: String) : String =
  concat_all([handler_scoped_sym("clause", enc_fn, line, col), "_", op])

#[doc("The cleanup-thunk symbol for a handler's `finally { }` in `enc_fn`, keyed on the handle's position.")]
pub fn user_cleanup_sym(enc_fn: String, line: Int, col: Int) : String =
  handler_scoped_sym("finally", enc_fn, line, col)

# A user-derived local binder (fn/lambda/clause param, `let`/`var`,
# match binder, closure capture, handler alias or state name) gets its
# own `kaiv_` namespace, disjoint from the runtime's `kai_` and from
# user fns' `kaiu_`. Any site emitting a C identifier for a local name
# must mint it here: a hand-spelled prefix is how a binder named after
# a runtime helper (`unit`, `decref`, ...) shadows the helper and
# breaks the emitted C.
#[doc("The C identifier for a user-named local binder.")]
pub fn c_local(name: String) : String = string_concat("kaiv_", name)

#[doc("The C identifier for a handler alias's id constant.")]
pub fn c_alias_id(alias: String) : String =
  concat_all(["kaiv_alias_", alias, "_id"])

# One scan backs every variant-table lookup. `home` is the declaring
# module the call site knows: `Some(m)` demands that exact entry, so two
# modules declaring the same ctor name never read each other's arity or
# payload layout. `None` means the site has only the bare name and takes
# the first entry — the pre-namespace behaviour, still correct whenever
# the name is unique in the program.
# Resolution ladder over a name's entries, one scan: an exact (name, home)
# match wins immediately; failing that, the name's single entry answers
# whatever its home; a homeless entry answers a homed request (builtins and
# root-file types register without a home). Two or more homed entries with
# no exact match are a real ambiguity — first-entry-wins here is how one
# homonym's cells got stamped with the other's slot layout, so the table
# refuses to guess.
fn evar_entry(vs: [VariantEntry], home: Option[String], target: String) : Option[VariantEntry] =
  evar_resolve(vs, home, target, 0 - 1, None, None, "", 0)

# `arity` of -1 accepts every entry of the name; a real arity narrows the
# candidate set BEFORE the ladder runs, so two homonyms of different arity
# never even count as an ambiguity.
fn evar_resolve(vs: [VariantEntry], home: Option[String], target: String, arity: Int,
                homeless: Option[VariantEntry], homed: Option[VariantEntry],
                seen_homes: String, n: Int) : Option[VariantEntry] =
  match vs {
    [] ->
      if n == 0 { None }
      else if n == 1 { match homed { Some(_) -> homed None -> homeless } }
      else { match homeless {
        Some(_) -> homeless
        None -> panic(concat_all(["ambiguous constructor '", target,
                   "': declared by modules [", seen_homes,
                   "] and the use site names no home — qualify the construction or the pattern"]))
      } }
    [h, ...rest] -> match h {
      EV(hm, nm, ar, _, _) ->
        if nm != target or (arity >= 0 and ar != arity) {
          evar_resolve(rest, home, target, arity, homeless, homed, seen_homes, n)
        }
        else if evar_home_eq(hm, home) { Some(h) }
        else { match hm {
          None -> evar_resolve(rest, home, target, arity, Some(h), homed, seen_homes, n + 1)
          Some(m) -> evar_resolve(rest, home, target, arity, homeless,
                       match homed { Some(_) -> homed None -> Some(h) },
                       if seen_homes == "" { m } else { concat_all([seen_homes, ", ", m]) },
                       n + 1)
        } }
    }
  }

fn evar_home_eq(a: Option[String], b: Option[String]) : Bool = match a {
  None    -> match b { None -> true  Some(_) -> false }
  Some(x) -> match b { None -> false Some(y) -> x == y }
}

# A constructor qualifier the AST carries is not always a module: the
# typer rewrites an ambiguous bare ctor to `EModCall(<type>, Ctor)`, so
# the same slot may hold a type name. Resolving as a home first and
# falling back to the bare name keeps both spellings working; only the
# module reading disambiguates homonyms, and only it can match.
#[doc("Arity of ctor `target` under a qualifier that may name either its module or its type.")]
pub fn evar_find_qual(vs: [VariantEntry], qual: String, target: String) : Option[Int] =
  match evar_entry(vs, Some(qual), target) {
    Some(EV(_, _, ar, _, _)) -> Some(ar)
    None                     -> evar_find(vs, target)
  }

#[doc("The home a constructor qualifier denotes, or None when it names the type rather than a module.")]
pub fn evar_qual_home(vs: [VariantEntry], qual: String, target: String) : Option[String] =
  match evar_entry(vs, Some(qual), target) {
    Some(EV(hm, _, _, _, _)) -> hm
    None                     -> None
  }

#[doc("Arity of ctor target as declared by `home`, or None when it is not a registered variant.")]
pub fn evar_find_in(vs: [VariantEntry], home: Option[String], target: String) : Option[Int] =
  match evar_entry(vs, home, target) {
    None            -> None
    Some(EV(_, _, ar, _, _)) -> Some(ar)
  }

#[doc("Variant-table lookup helper: find.")]
pub fn evar_find(vs: [VariantEntry], target: String) : Option[Int] =
  evar_find_in(vs, None, target)

# When the call site knows no home, its ARITY still narrows which
# homonym it means: two constructors sharing a name usually differ in
# payload shape, and reading one's layout for the other is the
# corruption this keying exists to remove. An arity matching no entry
# falls back to the plain lookup.
#[doc("The head tag of ctor `target` whose payload has `arity` slots, preferring the entry declared by `home`.")]
pub fn evar_find_tag_arity(vs: [VariantEntry], home: Option[String], target: String, arity: Int) : Int =
  match evar_entry_arity(vs, home, target, arity) {
    Some(EV(_, _, _, _, t)) -> t
    None                    -> evar_find_tag_in(vs, home, target)
  }

fn evar_entry_arity(vs: [VariantEntry], home: Option[String], target: String, arity: Int) : Option[VariantEntry] =
  evar_resolve(vs, home, target, arity, None, None, "", 0)

# The list returned here is walked in lockstep with the call site's
# arguments, so a payload of a DIFFERENT arity is worse than none: the
# walk runs off the end, every remaining slot classifies boxed, and a raw
# Int64 slot receives a pointer the consumer then dereferences as an
# integer. Fall back only when the fallback's arity still matches.
#[doc("The payload slot kinds of ctor `target` with `arity` slots, preferring the entry declared by `home`.")]
pub fn evar_slot_kinds_arity(vs: [VariantEntry], home: Option[String], target: String,
                             arity: Int) : Option[[Int]] =
  match evar_entry_arity(vs, home, target, arity) {
    Some(EV(_, _, _, ks, _)) -> Some(ks)
    None                     -> match evar_slot_kinds_in(vs, home, target) {
      Some(ks) -> if list_length(ks) == arity { Some(ks) } else { None }
      None     -> None
    }
  }

# Falls back to 0 for an unknown name: call sites guard with `evar_find`
# first, and the default only matters for a synthetic emit path that
# stringifies a non-variant identifier into a kai_variant call shape.
#[doc("The head tag of ctor target as declared by `home`, or 0 when it is not a registered variant.")]
pub fn evar_find_tag_in(vs: [VariantEntry], home: Option[String], target: String) : Int =
  match evar_entry(vs, home, target) {
    None            -> 0
    Some(EV(_, _, _, _, t)) -> t
  }

#[doc("Atom-style global variant tag lookup: the reserved tag for a builtin (0..10 per docs/variant-tags.md) or the hashed user-range tag.")]
pub fn evar_find_tag(vs: [VariantEntry], target: String) : Int =
  evar_find_tag_in(vs, None, target)

#[doc("The head tag of ctor target with `arity` slots, preferring the entry declared by `home`, or None when unregistered.")]
pub fn evar_find_tag_opt_arity(vs: [VariantEntry], home: Option[String], target: String, arity: Int) : Option[Int] =
  match evar_entry_arity(vs, home, target, arity) {
    None            -> None
    Some(EV(_, _, _, _, t)) -> Some(t)
  }

#[doc("The head tag of ctor target as declared by `home`, or None when it is not a registered variant.")]
pub fn evar_find_tag_opt_in(vs: [VariantEntry], home: Option[String], target: String) : Option[Int] =
  match evar_entry(vs, home, target) {
    None            -> None
    Some(EV(_, _, _, _, t)) -> Some(t)
  }

# Match-side variant. Consumers (emit_pat_test_variant*, emit_bang) use
# this to decide between the fast tag-compare path (`variant_tag == N`)
# and the legacy strcmp fallback. The None branch protects synthetic AST
# paths where a constructor name slipped through without registration.
#[doc("Match-side variant. Returns Some(tag) when target is in the variants table, None otherwise.")]
pub fn evar_find_tag_opt(vs: [VariantEntry], target: String) : Option[Int] =
  evar_find_tag_opt_in(vs, None, target)

#[doc("The payload slot kinds of ctor target as declared by `home`, or None when it is not a registered variant.")]
pub fn evar_slot_kinds_in(vs: [VariantEntry], home: Option[String], target: String) : Option[[Int]] =
  match evar_entry(vs, home, target) {
    None                     -> None
    Some(EV(_, _, _, ks, _)) -> Some(ks)
  }

#[doc("The payload slot kinds of ctor target, or None when it is not a registered variant.")]
pub fn evar_slot_kinds(vs: [VariantEntry], target: String) : Option[[Int]] =
  evar_slot_kinds_in(vs, None, target)

#[doc("The slot kind at slot `i` of a kind list (0 boxed, 1 Int, 2 Real, 3 enum); 0 past its end.")]
pub fn kind_at(ks: [Int], i: Int) : Int = match ks {
  []           -> 0
  [k, ...rest] -> if i == 0 { k } else { kind_at(rest, i - 1) }
}

# Plain arithmetic, no `<<`/`bit_or`: the stage-1 compiler does not parse the
# bit-intrinsic surface, and disjoint 2-bit windows make `+` equal to `or`.
#[doc("The base-4 scaler for slot i (each slot owns a disjoint 2-bit window in the mask).")]
pub fn variant_slot_pos(i: Int) : Int =
  if i <= 0 { 1 } else { 4 * variant_slot_pos(i - 1) }

#[doc("The slot kind that a variant slot mask records for slot i: 0 boxed, 1 Int, 2 Real, 3 enum.")]
pub fn variant_mask_kind(mask: Int, i: Int) : Int = (mask / variant_slot_pos(i)) % 4

fn variant_slot_mask_loop(ks: [Int], i: Int, acc: Int) : Int = match ks {
  [] -> acc
  [k, ...rest] ->
    if i >= 16 { 0 }
    else { variant_slot_mask_loop(rest, i + 1, acc + (k * variant_slot_pos(i))) }
}

#[doc("The 2-bit-per-slot mask for a payload slot-kind list (0 when > 16 slots overflow the field).")]
pub fn variant_slot_mask(ks: [Int]) : Int = variant_slot_mask_loop(ks, 0, 0)

# Plain arithmetic for the same stage-1 reason as variant_slot_pos.
fn record_kept_pos(i: Int) : Int =
  if i <= 0 { 1 } else { 2 * record_kept_pos(i - 1) }

# A plain binder read carries its own reference: a bare read or its
# dup wrap. Call results do not qualify — their pointer may BE
# the donor's recycled old child, the shape the reuse alias guard protects.
fn record_fi_is_binder_read(v: Expr) : Bool = match v.kind {
  ECall(f, dargs) -> match f.kind {
    EMark(MkDup) -> match dargs {
      [inner] -> record_fi_is_bare_read(inner)
      _       -> false
    }
    _ -> false
  }
  _ -> record_fi_is_bare_read(v)
}

fn record_fi_is_bare_read(v: Expr) : Bool = match v.kind {
  ELocal(_)  -> true
  ESym(_, _) -> true
  _          -> false
}

#[doc("One bit per rebuild field-init that re-embeds a plain binder read; the record reuse helper still pays the donor's claim on an aliased old child at those slots. Fields past bit 61 stay unmarked (mask overflow).")]
pub fn record_kept_mask(fis: [FieldInit], i: Int, acc: Int) : Int = match fis {
  [] -> acc
  [fi, ...rest] -> match fi {
    FI(_, v) ->
      record_kept_mask(rest, i + 1,
        if i < 62 and record_fi_is_binder_read(v) { acc + record_kept_pos(i) }
        else { acc })
  }
}

#[doc("True iff any payload slot is a primitive (Int/Real/enum) — the typed-construction gate.")]
pub fn variant_has_primitive_slot(ks: [Int]) : Bool = match ks {
  [] -> false
  [k, ...rest] -> if k != 0 { true } else { variant_has_primitive_slot(rest) }
}

#[doc("The fixed table of built-in variant constructors (Option/Result/etc.) every emit run seeds.")]
pub fn builtin_variants() : [VariantEntry] =
  # Phase 2 #440: builtins use empty type lists so the emitter falls
  # back to the legacy boxed constructor path. Some/Ok/Err wrap an
  # arbitrary boxed value; unboxing them would require a per-call-site
  # type read which is not in scope for this lane.
  #
  # Tag assignment per docs/variant-tags.md. Builtins 0..10 are
  # reserved; user code that matches against Sig*/Exited/Signaled
  # (e.g. `match s { SigInt -> ... }`) needs these in the table so
  # `evar_find_tag` resolves to the reserved value and not to a
  # user-range tag. The runtime constructs these via stage0/runtime.h
  # using the same convention, so producer and matcher agree.
  # `Sig` and `Exit` are declared by the core module `effects/os.kai`, so
  # their entries carry its home: a program constructor of the same name
  # is a different constructor with its own tag and payload layout.
  [EV(None, "Some", 1, [], 0), EV(None, "None", 0, [], 1),
   EV(None, "Ok", 1, [], 2), EV(None, "Err", 1, [], 3),
   EV(os_home(), "SigInt", 0, [], 4), EV(os_home(), "SigTerm", 0, [], 5), EV(os_home(), "SigHup", 0, [], 6),
   EV(os_home(), "SigUsr1", 0, [], 7), EV(os_home(), "SigUsr2", 0, [], 8),
   # Exited/Signaled carry an unboxed Int slot — the runtime constructs
   # them via kai_variant_u with KAI_VAR_SLOT_INT, so the matcher must
   # read slots[0].i64 not slots[0].ptr. Registering the payload type
   # here drives emit_pat_test_variant through the typed (Phase 2 #440)
   # slot-read path.
   EV(os_home(), "Exited", 1, [1], 9),
   EV(os_home(), "Signaled", 1, [1], 10),
   EV(os_home(), "SigWinch", 0, [], 11)]

# A core file's declarations take its basename as their home.
fn os_home() : Option[String] = Some("os")

#[doc("First tag assigned to a user-declared variant. Mirrors KAI_USER_VARIANT_TAG_BASE in stage0/emit.c and user_variant_tag_base() in stage1/compiler.kai.")]
pub fn user_variant_tag_base() : Int = 12

# User tags are key-hashed, not declaration-ordered: slot = base +
# FNV(key) mod range, linear probe on collision, keys inserted in sorted
# order. A constructor's tag is a function of the program's SET of keys —
# adding or moving a type in one module cannot renumber the tags baked
# into other modules' emitted code. Range is the uint16 tag space above
# the reserved builtins.
fn user_variant_tag_range() : Int = 65524

# The hash key and the sort key are the same string, which is what keeps
# probe order independent of traversal order.
#
# The key carries the declaring module, so two modules declaring one
# ctor name get two tags and never read each other's payload layout.
# Both sides of a match agree on it because `tag_tycon_modules` stamps
# an unqualified arm with its scrutinee's home before emit; a ctor whose
# type has no home keys on the bare name, as every ctor did before.
fn evar_key(home: Option[String], ctor: String) : String = match home {
  None    -> ctor
  Some(m) -> concat_all([m, "::", ctor])
}

fn evar_key_of(v: VariantEntry) : String = match v {
  EV(hm, n, _, _, _) -> evar_key(hm, n)
}

#[doc("The most user variant constructors one program may declare: the tag probe needs headroom in the uint16 range.")]
pub fn variant_ctor_limit() : Int = 60000

#[doc("The number of user variant constructors the program declares when it exceeds `variant_ctor_limit`, else 0.")]
pub fn variant_ctor_excess(decls: [Decl], tab: SymTab) : Int = {
  let n = suv_declared_ctors(decls, tab, 0)
  if n > variant_ctor_limit() { n } else { 0 }
}

# Every declared constructor a builtin does not absorb: the count
# `register_variants` registers, since one module never declares a
# constructor name twice.
fn suv_declared_ctors(ds: [Decl], tab: SymTab, acc: Int) : Int = match ds {
  [] -> acc
  [DType(_, _, _, TBSum(vs), _, _, mo, _), ...rest] -> suv_declared_ctors(rest, tab, suv_own_ctors(vs, mo, tab, acc))
  [_, ...rest] -> suv_declared_ctors(rest, tab, acc)
}

fn suv_own_ctors(vs: [Variant], home: Option[String], tab: SymTab, acc: Int) : Int = match vs {
  [] -> acc
  [Var(c, _), ...rest] -> suv_own_ctors(rest, home, tab, if suv_is_builtin(home, suv_ctor_text(tab, c)) { acc } else { acc + 1 })
}

# The row keeps the constructor's name: the runtime tag hashes it and the
# emitted cell carries it.
fn suv_ctor_text(tab: SymTab, c: SymId) : String = written_text(sym_name(tab, c))

#[doc("Register a declaration's variant constructors into the EVar table with stable name-keyed tags. `tab` names each constructor.")]
pub fn register_variants(decls: [Decl], tab: SymTab) : [VariantEntry] {
  let pending = suv_sorted_unique(suv_pending_decls(decls, tab, type_home_table(decls, tab), []))
  # The front-end rejects a program past the limit (`variant_ctor_excess`).
  if list_length(pending) > variant_ctor_limit() {
    panic("too many variant constructors for the uint16 tag space")
  } else {
    suv_assign(pending, [], builtin_variants())
  }
}

# Collect user ctors newest-first, each stamped with the module that
# declares it. Tags are assigned later.
fn suv_pending_decls(ds: [Decl], tab: SymTab, hs: TyHomeTab, acc: [VariantEntry]) : [VariantEntry] {
  match ds {
    [] -> acc
    [d, ...rest] -> match d {
      DType(_, _, _, body, _, _, mo, _) -> match body {
        TBSum(vs) -> suv_pending_decls(rest, tab, hs, suv_pending_vs(vs, mo, tab, hs, acc))
        _         -> suv_pending_decls(rest, tab, hs, acc)
      }
      _ -> suv_pending_decls(rest, tab, hs, acc)
    }
  }
}

fn suv_pending_vs(vs: [Variant], home: Option[String], tab: SymTab, hs: TyHomeTab, acc: [VariantEntry]) : [VariantEntry] {
  match vs {
    [] -> acc
    [v, ...rest] -> match v {
      Var(c, tys) -> {
        let n = suv_ctor_text(tab, c)
        if suv_is_builtin(home, n) {
          suv_pending_vs(rest, home, tab, hs, acc)
        } else {
          let ks = map(tys, (t) => payload_slot_kind(hs, home, t))
          suv_pending_vs(rest, home, tab, hs, [EV(home, n, list_length(tys), ks, 0), ...acc])
        }
      }
    }
  }
}

# A homeless builtin absorbs every declaration of its name; a homed one only
# its own module's.
fn suv_is_builtin(home: Option[String], ctor: String) : Bool =
  suv_seen(builtin_variants(), None, ctor) or suv_seen(builtin_variants(), home, ctor)

# Exact-key membership. Distinct from `evar_entry`, whose `None` home is
# a wildcard for LOOKUP: at construction a homeless entry must not
# absorb a homed one, or the collapse this keying removes comes back.
fn suv_seen(vs: [VariantEntry], home: Option[String], ctor: String) : Bool = {
  let k = evar_key(home, ctor)
  suv_seen_loop(vs, k)
}

fn suv_seen_loop(vs: [VariantEntry], k: String) : Bool = match vs {
  [] -> false
  [h, ...rest] -> if evar_key_of(h) == k { true } else { suv_seen_loop(rest, k) }
}

# A builtin row has two writers on native: the runtime mints raw slots and a
# program builds boxed ones. Its constructor has no raw slot here, for the
# read-side seeding and the write-side permit alike. Every other constructor
# takes the slot kinds `register_variants` lays its row out with.
#[doc("The kind-1 Int-slot flags of every constructor by its id, in slot order: the ones `decls` declare, then the ones only the runtime builds. A constructor a builtin row lays out has none.")]
pub fn build_ctor_int_slots(decls: [Decl], tab: SymTab) : [CtorIntSlots] =
  cis_decls(decls, tab, type_home_table(decls, tab), map(builtin_variants(), cis_builtin))

fn cis_builtin(v: VariantEntry) : CtorIntSlots = match v {
  EV(Some(h), n, _, _, _) -> CIS(sym_derive(NCCtor, n, h), [])
  EV(None, n, _, _, _)    -> CIS(sym_derive(NCCtor, n, core_type_home()), [])
}

fn cis_decls(ds: [Decl], tab: SymTab, hs: TyHomeTab, acc: [CtorIntSlots]) : [CtorIntSlots] = match ds {
  [] -> acc
  [DType(_, _, _, TBSum(vs), _, _, mo, _), ...rest] -> cis_decls(rest, tab, hs, cis_own(vs, mo, tab, hs, acc))
  [_, ...rest] -> cis_decls(rest, tab, hs, acc)
}

fn cis_own(vs: [Variant], home: Option[String], tab: SymTab, hs: TyHomeTab, acc: [CtorIntSlots]) : [CtorIntSlots] = match vs {
  [] -> acc
  [Var(c, tys), ...rest] -> {
    let flags = if suv_is_builtin(home, suv_ctor_text(tab, c)) { [] } else { map(tys, (t) => payload_slot_kind(hs, home, t) == 1) }
    cis_own(rest, home, tab, hs, [CIS(c, flags), ...acc])
  }
}

# Sorted by the hash key, so probe order is independent of traversal
# order. The sort is stable, so a repeated key (a builtin re-emitted by
# core-inject) keeps its first declaration's arity/payload.
fn suv_sorted_unique(newest_first: [VariantEntry]) : [VariantEntry] =
  suv_unique(sort_by(list_reverse(newest_first), suv_cmp), [])

fn suv_cmp(a: VariantEntry, b: VariantEntry) : Int =
  if string_lt(evar_key_of(a), evar_key_of(b)) { 0 - 1 } else if evar_key_of(a) == evar_key_of(b) { 0 } else { 1 }

fn suv_unique(vs: [VariantEntry], acc: [VariantEntry]) : [VariantEntry] = match (vs, acc) {
  ([], _) -> list_reverse(acc)
  ([v, ...rest], [prev, ..._]) -> suv_unique(rest, if evar_key_of(prev) == evar_key_of(v) { acc } else { [v, ...acc] })
  ([v, ...rest], []) -> suv_unique(rest, [v])
}

fn suv_assign(vs: [VariantEntry], used: [Int], acc: [VariantEntry]) : [VariantEntry] = match vs {
  [] -> acc
  [v, ...rest] -> match v {
    EV(hm, n, ar, tys, _) -> {
      let t = suv_slot(evar_key(hm, n), used)
      suv_assign(rest, [t, ...used], [EV(hm, n, ar, tys, t), ...acc])
    }
  }
}

fn suv_slot(key: String, used: [Int]) : Int {
  let h = string_hash(key)
  let n = user_variant_tag_range()
  suv_probe(user_variant_tag_base() + ((h % n) + n) % n, used)
}

fn suv_probe(slot: Int, used: [Int]) : Int {
  if suv_taken(slot, used) {
    suv_probe(if slot >= 65535 { user_variant_tag_base() } else { slot + 1 }, used)
  } else { slot }
}

fn suv_taken(s: Int, used: [Int]) : Bool = match used {
  [] -> false
  [h, ...rest] -> if h == s { true } else { suv_taken(s, rest) }
}

#[doc("The AST `ExprKind` constructor name as a string (e.g. `EInt(0)` → \"EInt\"). Used by the typed-hole / library-mode enclosing-node walk in the driver to label nodes by kind.")]
pub fn expr_kind_name(k: ExprKind) : String {
  match k {
    EInt(_, _)        -> "EInt"
    EReal(_, _)       -> "EReal"
    EIntLit(_)        -> "EIntLit"
    EDecimalLit(_)    -> "EDecimalLit"
    EFixed(_, _)      -> "EFixed"
    EBool(_)       -> "EBool"
    EChar(_)       -> "EChar"
    EStr(_, _)     -> "EStr"
    EUnit          -> "EUnit"
    EName(_)        -> "EVar"
    EMark(_)       -> "EMark"
    ESym(_, _)     -> "EVar"
    ELocal(_)      -> "EVar"
    EOp(_)         -> "EVar"
    EUnder         -> "EUnder"
    EPlaceholder   -> "EPlaceholder"
    ECall(_, _)    -> "ECall"
    EField(_, _)   -> "EField"
    EIndex(_, _)   -> "EIndex"
    EBinop(_, _, _) -> "EBinop"
    EUnop(_, _)    -> "EUnop"
    EIf(_, _, _)   -> "EIf"
    EMatch(_, _)   -> "EMatch"
    ELambda(_, _)  -> "ELambda"
    ERecordLit(_, _) -> "ERecordLit"
    EList(_)       -> "EList"
    ERange(_, _, _) -> "ERange"
    EBlock(_, _)   -> "EBlock"
    EPipe(_, _)    -> "EPipe"
    EMapPipe(_, _) -> "EMapPipe"
    EFlatMapPipe(_, _) -> "EFlatMapPipe"
    EFilterPipe(_, _) -> "EFilterPipe"
    EHole(_)       -> "EHole"
    ETodo(_)       -> "ETodo"
    EExternBody(_, _) -> "ETodo"
    EBang(_)       -> "EBang"
    EHandle(_, _, _, _, _, _, _) -> "EHandle"
    ELitUnit(_, _) -> "ELitUnit"
    EVariantsOf(_, _) -> "EVariantsOf"
    EModCall(_, _) -> "EModCall"
    EIntrinsic(_, _) -> "EIntrinsic"
    ESurface(_) -> "ESurface"
  }
}

# ---- core mapping for emission ----
#
# For user-facing builtins, we map to their runtime C symbol and arity.
# Stage 1 mirrors stage 0's table 1:1.

# M5 fast-path predicate. True iff every arm in `arms` is a
# literal pattern (Int / Bool / Char) or a wildcard (PWild /
# PBind), and no arm carries a guard. Strings are intentionally
# excluded — the C `switch` only works on integral types.
#[doc("M5 fast-path predicate. True iff every arm in `arms` is a literal pattern (Int / Bool / Char) or a wildcard (PWild / PBind), and no arm carries a guard. Strings are…")]
pub fn arms_all_literal_or_wild(arms: [Arm]) : Bool {
  match arms {
    [] -> false   # need at least one arm to dispatch on
    _  -> arms_all_literal_or_wild_loop(arms)
  }
}

#[doc("Tail loop: true while every remaining match arm is a literal or wildcard pattern.")]
pub fn arms_all_literal_or_wild_loop(arms: [Arm]) : Bool {
  match arms {
    [] -> true
    [Arm(p, g, _), ...rest] -> match g {
      Some(_) -> false
      None    -> if pat_is_unboxable_lit_or_wild(p) {
        arms_all_literal_or_wild_loop(rest)
      } else { false }
    }
  }
}

# The fast path binds a `PBind` catch-all raw. A read of the binder
# from inside a lambda body expects the boxed binding, so such a match
# routes through the boxed path. Mirrors the lambda-capture guard of the
# unbox pass's `let`.
#[doc("True when no `PBind` catch-all arm's body reads its binder from a lambda body, the read the fast match path's raw binding cannot serve.")]
pub fn arms_pbind_safe_for_fast_path(arms: [Arm]) : Bool {

  match arms {
    [] -> true
    [Arm(p, _, b), ...rest] -> {
      let ok = match p.pkind {
        PBind(bd) -> not uses_have_in_lam(scan_uses_expr(b, false), bd.id)
        _ -> true
      }
      if ok { arms_pbind_safe_for_fast_path(rest) } else { false }
    }
  }
}

#[doc("True if a pattern is an unboxable literal or wildcard (drives the fast match path).")]
pub fn pat_is_unboxable_lit_or_wild(p: Pattern) : Bool {
  match p.pkind {
    PWild     -> true
    # A PBind catch-all rides the fast path: the unbox pass marks the
    # body's reads of the binder MUnboxed and the emitters bind it raw
    # in the default block before the body.
    PBind(_)  -> true
    PLit(lit) -> match lit.kind {
      EInt(_, _)  -> true
      EBool(_) -> true
      EChar(_) -> true
      _ -> false
    }
    _ -> false
  }
}

# Emit the raw C scalar that goes inside `switch (...)` for a
# literal pattern. `EInt` → `<n>LL`, `EBool` → `0`/`1`,
# `EChar` → numeric codepoint.

# enc_fn (the post-monomorph, module-mangled symbol of the enclosing
# fn / lambda) is the cross-module discriminator: `(line, col)` alone
# collides when two modules have a lambda at the same source position,
# so `find_lam` keys on `(enc_fn, line, col)`.
#[doc("What a lifted body takes from the frame around it: the value of a local, or the handler id a cell alias names. The list order is the closure's capture array and a handle's env layout.")]
pub type Capture = CapLocal(LocalId) | CapAlias(LocalId)

#[doc("Lifted lambda descriptor (binder names of the enclosing declaration, enc_fn, line, col, params, captures, body, module) for closure emission.")]
pub type LamInfo = LamInfo(LocalNames, String, Int, Int, [Param], [Capture], Expr, Option[String])

# The lambda's C symbol derives from (enc_fn, line, col) — the same key
# find_lam resolves — not from a program-global counter, so a lambda
# added in one module cannot rename the lifted symbols of another.
#[doc("C symbol of a lifted lambda at (enc_fn, line, col).")]
pub fn lam_symbol_at(enc_fn: String, line: Int, col: Int) : String =
  concat_all(["_kaiu_lam_", enc_fn, "_", int_to_string(line), "_", int_to_string(col)])

#[doc("C symbol of a lifted lambda from its LamInfo.")]
pub fn lam_symbol(l: LamInfo) : String = match l {
  LamInfo(_, ef, ln, cl, _, _, _, _) -> lam_symbol_at(ef, ln, cl)
}

#[doc("The binder names of the declaration a lifted lambda sits in: its body and its captures are spelled from them.")]
pub fn lam_locals(l: LamInfo) : LocalNames = match l {
  LamInfo(ns, _, _, _, _, _, _, _) -> ns
}

# The handle's position plus the clause head names the clause; the
# enclosing fn keys its symbol, since two specialisations of one body
# share a position. The last param is the continuation. The captures are
# what the handle's env threads in from its frame: the clause body is
# free in them given its params and the state aliases it binds.
#[doc("A handler clause lifted to a top-level function: (handle line, handle col, binder names of the enclosing declaration, head, params, body, stateful, enc_fn, captures, module, effect handled).")]
pub type ClauseInfo = CI(Int, Int, LocalNames, ClauseHead, [Param], Expr, Bool, String, [Capture], Option[String], SymId)

#[doc("The symbol a handler clause's body lifts into; it is the enclosing fn of the lambdas and handles nested in that body.")]
pub fn clause_body_sym(enc_fn: String, line: Int, col: Int, head: ClauseHead) : String =
  if is_lifecycle_clause(head) { user_cleanup_sym(enc_fn, line, col) }
  else { user_clause_sym(enc_fn, line, col, clause_head_word(head)) }

#[doc("The symbol a recorded clause's body lifts into.")]
pub fn clause_sym(c: ClauseInfo) : String = match c {
  CI(line, col, _, head, _, _, _, enc_fn, _, _, _) -> clause_body_sym(enc_fn, line, col, head)
}

#[doc("The binder names of the declaration a recorded clause sits in.")]
pub fn clause_locals(c: ClauseInfo) : LocalNames = match c {
  CI(_, _, ns, _, _, _, _, _, _, _, _) -> ns
}

#[doc("The effect a recorded clause handles.")]
pub fn clause_eff(c: ClauseInfo) : SymId = match c {
  CI(_, _, _, _, _, _, _, _, _, _, esym) -> esym
}

#[doc("The module a lifted lambda came from, for rotating the EFn table to it before its body resolves a bare call.")]
pub fn lam_mo(l: LamInfo) : Option[String] = match l {
  LamInfo(_, _, _, _, _, _, _, mo) -> mo
}

#[doc("The module a handler clause came from, for rotating the EFn table to it before its body resolves a bare call.")]
pub fn clause_mo(c: ClauseInfo) : Option[String] = match c {
  CI(_, _, _, _, _, _, _, _, _, mo, _) -> mo
}

#[doc("Look up a lifted lambda by enclosing fn + source position. The (enc_fn, line, col) triple is unique even when two modules share a lambda at the same line/col.")]
pub fn find_lam(lams: [LamInfo], enc_fn: String, line: Int, col: Int) : Option[LamInfo] {
  match lams {
    [] -> None
    [l, ...rest] -> match l {
      LamInfo(_, ef, ln, cl, _, _, _, _) ->
        if ef == enc_fn and ln == line and cl == col { Some(l) }
        else { find_lam(rest, enc_fn, line, col) }
    }
  }
}

#[doc("What surrounds a walked body: the binders in scope around it, innermost first, and the handler aliases among them. The binders say whether an enclosing clause already binds a state alias; an alias is reached through its handler, never captured as a value.")]
pub type FvOuter = { binders: [Binder], aliases: [LocalId] }

#[doc("A body with nothing in scope around it.")]
pub fn fv_outer_empty() : FvOuter = FvOuter { binders: [], aliases: [] }

#[doc("A body with `binders` in scope around it, none of them a handler alias.")]
pub fn fv_outer_of(binders: [Binder]) : FvOuter = FvOuter { binders: binders, aliases: [] }

fn fv_outer_bind(o: FvOuter, added: [Binder]) : FvOuter =
  FvOuter { binders: list_append(added, o.binders), aliases: o.aliases }

fn fv_outer_alias(o: FvOuter, a: Binder) : FvOuter =
  FvOuter { binders: [a, ...o.binders], aliases: [a.id, ...o.aliases] }

fn fv_binds(bs: [Binder], l: LocalId) : Bool = match bs {
  []           -> false
  [b, ...rest] -> local_eq(b.id, l) or fv_binds(rest, l)
}

#[doc("True when the binder `l` is among `ls`.")]
pub fn local_among(ls: [LocalId], l: LocalId) : Bool = match ls {
  []           -> false
  [x, ...rest] -> local_eq(x, l) or local_among(rest, l)
}


fn fv_cap_same(a: Capture, b: Capture) : Bool = match a {
  CapLocal(x) -> match b {
    CapLocal(y) -> local_eq(x, y)
    CapAlias(_) -> false
  }
  CapAlias(x) -> match b {
    CapAlias(y) -> local_eq(x, y)
    CapLocal(_) -> false
  }
}

fn fv_add(c: Capture, acc: [Capture]) : [Capture] = if fv_captured(acc, c) { acc } else { [c, ...acc] }

fn fv_captured(acc: [Capture], c: Capture) : Bool = match acc {
  []           -> false
  [h, ...rest] -> fv_cap_same(h, c) or fv_captured(rest, c)
}

# A read of the local `l`: a capture unless the walked body binds it.
fn fv_local(l: LocalId, own: [Binder], outer: FvOuter, acc: [Capture]) : [Capture] =
  if fv_is_wrap_slot(l) or fv_binds(own, l) or local_among(outer.aliases, l) { acc }
  else { fv_add(CapLocal(l), acc) }

# A perform through a cell alias dispatches by the alias's handler id,
# which the lifted body captures; through a receiver it reads that local.
fn fv_op(r: OpRef, own: [Binder], outer: FvOuter, acc: [Capture]) : [Capture] = match r.via {
  ViaAmbient  -> acc
  ViaAlias(a) -> if fv_binds(own, a) { acc } else { fv_add(CapAlias(a), acc) }
  ViaRecv(x)  -> fv_local(x, own, outer, acc)
}

# The fn and arm result slots are synthetic binders a Perceus pass wraps a
# body in; they materialise as match-scoped C locals at emit time, not as
# kaikai-level bindings. Left inside a lambda body they would be asked to
# capture a binding that does not exist, emitting C that references an
# undeclared identifier.
fn fv_is_wrap_slot(l: LocalId) : Bool =
  local_eq(l, local_minted(ret_slot_name(RsFn))) or local_eq(l, local_minted(ret_slot_name(RsArm)))

# What a clause body binds: its params, the canonical continuation, and
# the state aliases `aliases`.
fn fv_clause_own(params: [Param], aliases: [Binder]) : [Binder] =
  list_append(params_binders(params), [binder_minted(canonical_continuation()), ...aliases])

# The state aliases a clause binds: an alias an enclosing clause already
# binds stays that clause's.
fn fv_clause_aliases(own: [Binder], outer: FvOuter) : [Binder] =
  map(clause_state_aliases((key) => fv_binds(own, local_minted(key)) or fv_binds(outer.binders, local_minted(key))), binder_minted)

#[doc("The captures of an expression: every local it reads that `own`, the binders bound inside the walked body, does not bind. A nested lambda's captures are the enclosing body's too.")]
pub fn fv_expr(x: Expr, own: [Binder], outer: FvOuter, acc: [Capture]) : [Capture] / Console {

  match x.kind {
    EInt(_, _)  -> acc
    EReal(_, _) -> acc
    EIntLit(_) -> acc
    EDecimalLit(_) -> acc
    EFixed(_, _) -> acc
    EBool(_) -> acc
    EChar(_) -> acc
    EStr(_, _) -> acc
    EUnit -> acc
    EName(_) -> acc
    EMark(_) -> acc
    # A lambda captures locals, never a top-level declaration.
    ESym(_, _) -> acc
    ELocal(l) -> fv_local(l, own, outer, acc)
    EOp(r) -> fv_op(r, own, outer, acc)
    EUnder -> acc
    EPlaceholder -> acc
    ECall(f, xs) -> fv_exprs(xs, own, outer, fv_expr(f, own, outer, acc))
    EField(base, _) -> fv_expr(base, own, outer, acc)
    EIndex(a, b) -> fv_expr(b, own, outer, fv_expr(a, own, outer, acc))
    EBinop(_, a, b) -> fv_expr(b, own, outer, fv_expr(a, own, outer, acc))
    EUnop(_, inner) -> fv_expr(inner, own, outer, acc)
    EIf(c, a, opt_b) -> {
      let acc1 = fv_expr(a, own, outer, fv_expr(c, own, outer, acc))
      match opt_b { Some(b) -> fv_expr(b, own, outer, acc1) None -> acc1 }
    }
    EMatch(scr, arms) -> fv_arms(arms, own, outer, fv_expr(scr, own, outer, acc))
    # A nested lambda computes its own capture list, but what it reads
    # beyond its params must be visible in the enclosing body too: that
    # body is where the nested closure's capture array is built.
    ELambda(ps, body) -> fv_expr(body, list_append(params_binders(ps), own), outer, acc)
    ETodo(_) -> acc
    EExternBody(_, _) -> acc
    EBang(inner) -> fv_expr(inner, own, outer, acc)
    ERecordLit(_, fields) -> fv_field_inits(fields, own, outer, acc)
    EList(elems) -> fv_list_elems(elems, own, outer, acc)
    ERange(a, b, opt_step) -> {
      let acc1 = fv_expr(b, own, outer, fv_expr(a, own, outer, acc))
      match opt_step { Some(s) -> fv_expr(s, own, outer, acc1) None -> acc1 }
    }
    EBlock(stmts, opt_final) -> {
      # The trailing expression sees the bindings the statements introduced.
      let r = fv_stmts_scoped(stmts, own, outer, acc)
      match opt_final { Some(f) -> fv_expr(f, r.own, outer, r.acc) None -> r.acc }
    }
    EPipe(a, b) -> fv_expr(b, own, outer, fv_expr(a, own, outer, acc))
    EMapPipe(a, b) -> fv_expr(b, own, outer, fv_expr(a, own, outer, acc))
    EFlatMapPipe(a, b) -> fv_expr(b, own, outer, fv_expr(a, own, outer, acc))
    EFilterPipe(a, b) -> fv_expr(b, own, outer, fv_expr(a, own, outer, acc))
    EHole(_) -> acc
    EHandle(body, _, _, init_opt, alias_opt, clauses, ret_opt) -> {
      let acc0 = match init_opt {
        Some(ie) -> fv_expr(ie, own, outer, acc)
        None     -> acc
      }
      # The alias is in scope inside the body only: not in `init`, which
      # runs before the handler is installed, and not in the clauses.
      let own_body = match alias_opt {
        Some(a) -> [a, ...own]
        None    -> own
      }
      let acc1 = fv_expr(body, own_body, outer, acc0)
      let acc2 = fv_hclauses(clauses, own, outer, acc1)
      match ret_opt { Some(r) -> fv_hreturn(r, own, outer, acc2) None -> acc2 }
    }
    ELitUnit(inner, _) -> fv_expr(inner, own, outer, acc)
    EVariantsOf(_, _) -> acc
    EModCall(_, _) -> acc
    EIntrinsic(_, args_) -> fv_exprs(args_, own, outer, acc)
    ESurface(sf) -> fv_exprs(surface_children(sf), own, outer, acc)
  }
}

#[doc("Free-variable collector over hclauses.")]
pub fn fv_hclauses(cs: [HClause], own: [Binder], outer: FvOuter, acc: [Capture]) : [Capture] / Console {

  match cs {
    [] -> acc
    [c, ...rest] -> match c {
      HC(_, params, body, _, _) -> {
        let own1 = list_append(fv_clause_own(params, fv_clause_aliases(own, outer)), own)
        let acc1 = fv_expr(body, own1, outer, acc)
        fv_hclauses(rest, own, outer, acc1)
      }
    }
  }
}

#[doc("Free-variable collector over hreturn.")]
pub fn fv_hreturn(r: HReturn, own: [Binder], outer: FvOuter, acc: [Capture]) : [Capture] / Console {

  match r {
    HR(b, body, _, _) ->
      fv_expr(body, [b, ...list_append(fv_clause_aliases(own, outer), own)], outer, acc)
  }
}

#[doc("Free-variable collector over exprs.")]
pub fn fv_exprs(xs: [Expr], own: [Binder], outer: FvOuter, acc: [Capture]) : [Capture] / Console {

  match xs {
    [] -> acc
    [h, ...rest] -> fv_exprs(rest, own, outer, fv_expr(h, own, outer, acc))
  }
}

#[doc("Free-variable collector over arms.")]
pub fn fv_arms(arms: [Arm], own: [Binder], outer: FvOuter, acc: [Capture]) : [Capture] / Console {

  match arms {
    [] -> acc
    [a, ...rest] -> match a {
      Arm(pat, opt_g, body) -> {
        # The pattern's binders are bound in the guard and the body.
        let own1 = pat_bindings(pat, own)
        let acc1 = match opt_g { Some(g) -> fv_expr(g, own1, outer, acc) None -> acc }
        fv_arms(rest, own, outer, fv_expr(body, own1, outer, acc1))
      }
    }
  }
}

#[doc("The binders a pattern declares, consed onto `acc`.")]
pub fn pat_bindings(pat: Pattern, acc: [Binder]) : [Binder] {
  match pat.pkind {
    PWild -> acc
    PLit(_) -> acc
    PRange(_, _) -> acc
    PBind(b) -> [b, ...acc]
    PList(pats, opt_rest) -> {
      let acc1 = pat_bindings_loop(pats, acc)
      match opt_rest {
        Some(rb) -> [rb, ...acc1]
        None -> acc1
      }
    }
    PVariant(_, subs) -> pat_bindings_loop(subs, acc)
    PVariantRecord(_, fields) -> pfield_bindings_loop(fields, acc)
    PRecord(fields) -> pfield_bindings_loop(fields, acc)
    PHole(_) -> acc
    PAs(b, sub) -> pat_bindings(sub, [b, ...acc])
    PNarrow(b, _) -> [b, ...acc]
    PSurface(sp) -> pat_bindings_loop(patsurface_children(sp), acc)
  }
}

#[doc("Tail accumulator for pat_bindings: the binders a pattern list declares.")]
pub fn pat_bindings_loop(ps: [Pattern], acc: [Binder]) : [Binder] {
  match ps {
    [] -> acc
    [p, ...rest] -> pat_bindings_loop(rest, pat_bindings(p, acc))
  }
}

#[doc("Tail accumulator collecting the binders record-pattern fields declare.")]
pub fn pfield_bindings_loop(fs: [PField], acc: [Binder]) : [Binder] {
  match fs {
    [] -> acc
    [f, ...rest] -> match f {
      PField(_, sub, _) -> pfield_bindings_loop(rest, pat_bindings(sub, acc))
    }
  }
}

#[doc("Free-variable collector over field inits.")]
pub fn fv_field_inits(fs: [FieldInit], own: [Binder], outer: FvOuter, acc: [Capture]) : [Capture] / Console {

  match fs {
    [] -> acc
    [f, ...rest] -> match f {
      FI(_, val) -> fv_field_inits(rest, own, outer, fv_expr(val, own, outer, acc))
    }
  }
}

#[doc("Free-variable collector over list elems.")]
pub fn fv_list_elems(es: [ListElem], own: [Binder], outer: FvOuter, acc: [Capture]) : [Capture] / Console {

  match es {
    [] -> acc
    [el, ...rest] -> match el {
      ElPlain(x) -> fv_list_elems(rest, own, outer, fv_expr(x, own, outer, acc))
      ElSpread(x) -> fv_list_elems(rest, own, outer, fv_expr(x, own, outer, acc))
    }
  }
}

#[doc("What a statement list leaves behind: the binders bound once every `let` / `var` in it has run, and the captures so far.")]
pub type FvScoped = { own: [Binder], acc: [Capture] }

#[doc("Free-variable collector over stmts scoped.")]
pub fn fv_stmts_scoped(ss: [Stmt], own: [Binder], outer: FvOuter, acc: [Capture]) : FvScoped / Console {

  match ss {
    [] -> FvScoped { own: own, acc: acc }
    [s, ...rest] -> match s {
      SLet(pat, _, rhs) -> {
        let acc1 = fv_expr(rhs, own, outer, acc)
        let own1 = pat_bindings(pat, own)
        fv_stmts_scoped(rest, own1, outer, acc1)
      }
      SVar(b, _, rhs, _, _) -> {
        let acc1 = fv_expr(rhs, own, outer, acc)
        fv_stmts_scoped(rest, [b, ...own], outer, acc1)
      }
      _ -> fv_stmts_scoped(rest, own, outer, fv_stmt(s, own, outer, acc))
    }
  }
}

#[doc("Free-variable collector over stmt.")]
pub fn fv_stmt(s: Stmt, own: [Binder], outer: FvOuter, acc: [Capture]) : [Capture] / Console {

  match s {
    SLet(_, _, rhs) -> fv_expr(rhs, own, outer, acc)
    SAssert(c, opt_m) -> {
      let acc1 = fv_expr(c, own, outer, acc)
      match opt_m { Some(m) -> fv_expr(m, own, outer, acc1) None -> acc1 }
    }
    SExprStmt(x) -> fv_expr(x, own, outer, acc)
    SIndexAssign(b, i, v, _, _) -> {
      let acc1 = fv_expr(b, own, outer, acc)
      let acc2 = fv_expr(i, own, outer, acc1)
      fv_expr(v, own, outer, acc2)
    }
    SAssign(b, v, _, _) -> fv_expr(v, own, outer, fv_expr(b, own, outer, acc))
    SVar(_, _, rhs, _, _) -> fv_expr(rhs, own, outer, acc)
    SUse(_, _, _) -> acc
  }
}

# ---- lambda collection pass ----

# `cur_enc_fn` is the emitted symbol of the fn / lambda / clause / runner
# the walker is inside: a handle stamps it on each clause it records, so
# the install site and the clause body mint the same symbol. `cur_mo` is
# that fn's module, carried raw because a lifted body is emitted from a
# side table with no declaration to read it off. `locals` names the
# binders of the declaration being walked, for the lifted bodies' text.
#[doc("Lambda-collect state: the lambdas and clauses lifted so far, the binders in scope at the walk position, the enclosing fn's symbol and module, the binder names of the declaration being walked, and the tables a fn's symbol is spelled from.")]
pub type LamCollect = { lams: [LamInfo], clauses: [ClauseInfo],
                    scope: FvOuter, cur_enc_fn: String, cur_mo: Option[String],
                    locals: LocalNames, tab: SymTab, specs: SpecNames }

#[doc("Lambda-collect state helper: new. `tab` and `specs` spell each walked fn's symbol.")]
pub fn lc_new(tab: SymTab, specs: SpecNames) : LamCollect =
  LamCollect { lams: [], clauses: [], scope: fv_outer_empty(), cur_enc_fn: "", cur_mo: None,
               locals: ln_empty(), tab: tab, specs: specs }

# Snapshot the scope at entry of a scope-introducing form (fn body,
# block, lambda body); restore it on exit.
#[doc("Replace the walker's enclosing scope, for restoring a snapshot taken at a scope boundary.")]
pub fn lc_set_scope(st: LamCollect, sc: FvOuter) : LamCollect = LamCollect { ...st, scope: sc }

#[doc("Lambda-collect state helper: bind more binders in the current scope.")]
pub fn lc_extend_locals(st: LamCollect, added: [Binder]) : LamCollect =
  lc_set_scope(st, fv_outer_bind(st.scope, added))

#[doc("The binders a parameter list declares.")]
pub fn params_binders(ps: [Param]) : [Binder] =
  map(ps, (pm) => pm.binder)

#[doc("AST collector walking expr.")]
pub fn collect_expr(x: Expr, st: LamCollect) : LamCollect / Console {

  match x.kind {
    EInt(_, _)  -> st
    EReal(_, _) -> st
    EIntLit(_) -> st
    EDecimalLit(_) -> st
    EFixed(_, _) -> st
    EBool(_) -> st
    EChar(_) -> st
    EStr(_, _) -> st
    EUnit -> st
    EName(_) -> st
    EMark(_) -> st
    ESym(_, _) -> st
    ELocal(_) -> st
    EOp(_) -> st
    EUnder -> st
    EPlaceholder -> st
    ECall(f, xs) -> collect_exprs(xs, collect_expr(f, st))
    EField(base, _) -> collect_expr(base, st)
    EIndex(a, b) -> collect_expr(b, collect_expr(a, st))
    EBinop(_, a, b) -> collect_expr(b, collect_expr(a, st))
    EUnop(_, inner) -> collect_expr(inner, st)
    EIf(c, a, opt_b) -> {
      let s1 = collect_expr(a, collect_expr(c, st))
      match opt_b { Some(b) -> collect_expr(b, s1) None -> s1 }
    }
    EMatch(scr, arms) -> collect_arms(arms, collect_expr(scr, st))
    ELambda(params, body) -> {
      let own = params_binders(params)
      let caps = fv_expr(body, own, st.scope, [])
      let info = LamInfo(st.locals, st.cur_enc_fn, x.line, x.col, params, caps, body, st.cur_mo)
      # The lambda body is its own enclosing scope for clause symbols
      # (lifted to `lam_symbol` at emit); a sibling expression keeps
      # stamping against the outer fn.
      let outer_enc_fn = st.cur_enc_fn
      let outer_scope = st.scope
      let st1 = LamCollect { ...st, lams: [info, ...st.lams],
                             scope: fv_outer_bind(outer_scope, own),
                             cur_enc_fn: lam_symbol_at(outer_enc_fn, x.line, x.col) }
      let st2 = collect_expr(body, st1)
      LamCollect { ...st2, scope: outer_scope, cur_enc_fn: outer_enc_fn, cur_mo: st.cur_mo }
    }
    ERecordLit(_, fields) -> collect_field_inits(fields, st)
    EList(elems) -> collect_list_elems(elems, st)
    ERange(a, b, opt_step) -> {
      let s1 = collect_expr(b, collect_expr(a, st))
      match opt_step { Some(s) -> collect_expr(s, s1) None -> s1 }
    }
    EBlock(stmts, opt_final) -> {
      # Statements bind into the block's scope; siblings must not see
      # those bindings, so the outer scope is restored on exit.
      let outer_scope = st.scope
      let s1 = collect_stmts(stmts, st)
      let s2 = match opt_final { Some(f) -> collect_expr(f, s1) None -> s1 }
      lc_set_scope(s2, outer_scope)
    }
    EPipe(a, b) -> collect_expr(b, collect_expr(a, st))
    EMapPipe(a, b) -> collect_expr(b, collect_expr(a, st))
    EFlatMapPipe(a, b) -> collect_expr(b, collect_expr(a, st))
    EFilterPipe(a, b) -> collect_expr(b, collect_expr(a, st))
    EHole(_) -> st
    ETodo(_) -> st
    EExternBody(_, _) -> st
    EBang(inner) -> collect_expr(inner, st)
    EHandle(body, eref, _, init_opt, alias_opt, clauses, ret_opt) -> {
      let stateful = match init_opt { Some(_) -> true None -> false }
      let s_init = match init_opt { Some(ie) -> collect_expr(ie, st) None -> st }
      # Each clause is stamped with the enclosing fn's symbol, which the
      # install site reads back.
      let s0 = lc_record_clauses(clauses, ref_sym(eref), stateful, x.line, x.col, s_init.cur_enc_fn, s_init)
      # The alias is in scope inside the body only — not in `init`, which
      # runs before the handler is installed, and not in the clauses. A
      # lambda in the body reaches it through its handler, never as a
      # captured value.
      let outer_scope = s0.scope
      let s_body_in = match alias_opt {
        Some(a) -> lc_set_scope(s0, fv_outer_alias(outer_scope, a))
        None    -> s0
      }
      let s1_ext = collect_expr(body, s_body_in)
      let s1 = lc_set_scope(s1_ext, outer_scope)
      let s2 = collect_hclauses(clauses, x.line, x.col, s1)
      match ret_opt { Some(r) -> collect_hreturn(r, s2) None -> s2 }
    }
    # m12.5: literal-with-unit — the inner literal contributes nothing,
    # but recurse so future non-literal carriers stay covered.
    ELitUnit(inner, _) -> collect_expr(inner, st)
    # m7e §11: `variants[T]()` produces no lambdas / no clauses to
    # collect. The TypeExpr is not a lambda host.
    EVariantsOf(_, _) -> st
    # m6.2 Phase 2.1: qualified module call hosts no lambdas and
    # introduces no clauses — both fields are plain strings.
    EModCall(_, _) -> st
    # A loop intrinsic's own arg-lambdas never become closures — the C
    # emitter pastes their bodies inline into the enclosing frame — so
    # they get no LamInfo and their bodies walk under the ENCLOSING
    # enc_fn/scope: a genuine nested lambda (or handle) inside a loop
    # body must register where the inline emission will look it up.
    EIntrinsic(nm, args_) ->
      if is_loop_intrinsic(nm) { collect_loop_args(args_, st) }
      else { collect_exprs(args_, st) }
    ESurface(sf) -> collect_exprs(surface_children(sf), st)
  }
}

fn collect_loop_args(args_: [Expr], st: LamCollect) : LamCollect / Console = match args_ {
  []           -> st
  [a, ...rest] -> {
    let st1 = match a.kind {
      ELambda(ps, body) -> match ps { [] -> collect_expr(body, st) _ -> collect_expr(a, st) }
      _ -> collect_expr(a, st)
    }
    collect_loop_args(rest, st1)
  }
}

#[doc("Append one ClauseInfo per clause of the handle at (hline, hcol), which handles `esym` inside the fn `enc_fn`.")]
pub fn lc_record_clauses(cs: [HClause], esym: SymId, stateful: Bool,
                     hline: Int, hcol: Int, enc_fn: String,
                     st: LamCollect) : LamCollect / Console {

  match cs {
    [] -> st
    [c, ...rest] -> match c {
      HC(op_name, params, body, _, _) -> {
        # The clause's captures are what its body reads beyond its own
        # params and the state aliases it binds. A stateless handler
        # binds no alias, and a name the enclosing scope already binds
        # rides the env like any other capture.
        let aliases = if stateful { fv_clause_aliases([], st.scope) } else { [] }
        let caps = fv_expr(body, fv_clause_own(params, aliases), st.scope, [])
        let info = CI(hline, hcol, st.locals, op_name, params, body, stateful, enc_fn, caps, st.cur_mo, esym)
        lc_record_clauses(rest, esym, stateful, hline, hcol, enc_fn,
                          LamCollect { ...st, clauses: [info, ...st.clauses] })
      }
    }
  }
}

#[doc("AST collector walking hclauses.")]
pub fn collect_hclauses(cs: [HClause], hline: Int, hcol: Int, st: LamCollect) : LamCollect / Console {

  match cs {
    [] -> st
    [c, ...rest] -> match c {
      HC(head, _, body, _, _) -> {
        let outer_enc_fn = st.cur_enc_fn
        let body_st = enter_enc_fn(st, clause_body_sym(outer_enc_fn, hline, hcol, head), st.cur_mo)
        collect_hclauses(rest, hline, hcol, restore_enc_fn(collect_expr(body, body_st), outer_enc_fn))
      }
    }
  }
}

#[doc("AST collector walking hreturn.")]
pub fn collect_hreturn(r: HReturn, st: LamCollect) : LamCollect / Console {

  match r {
    HR(_, body, _, _) -> collect_expr(body, st)
  }
}

#[doc("AST collector walking exprs.")]
pub fn collect_exprs(xs: [Expr], st: LamCollect) : LamCollect / Console {

  match xs {
    [] -> st
    [h, ...rest] -> collect_exprs(rest, collect_expr(h, st))
  }
}

#[doc("AST collector walking arms.")]
pub fn collect_arms(arms: [Arm], st: LamCollect) : LamCollect / Console {

  match arms {
    [] -> st
    [a, ...rest] -> match a {
      Arm(pat, opt_g, body) -> {
        # The arm's binders shadow globals in its guard and body only.
        let s0 = lc_extend_locals(st, pat_bindings(pat, []))
        let s1 = match opt_g { Some(g) -> collect_expr(g, s0) None -> s0 }
        collect_arms(rest, lc_set_scope(collect_expr(body, s1), st.scope))
      }
    }
  }
}

#[doc("AST collector walking field inits.")]
pub fn collect_field_inits(fs: [FieldInit], st: LamCollect) : LamCollect / Console {

  match fs {
    [] -> st
    [f, ...rest] -> match f {
      FI(_, val) -> collect_field_inits(rest, collect_expr(val, st))
    }
  }
}

#[doc("AST collector walking list elems.")]
pub fn collect_list_elems(es: [ListElem], st: LamCollect) : LamCollect / Console {

  match es {
    [] -> st
    [el, ...rest] -> match el {
      ElPlain(x) -> collect_list_elems(rest, collect_expr(x, st))
      ElSpread(x) -> collect_list_elems(rest, collect_expr(x, st))
    }
  }
}

#[doc("AST collector walking stmts.")]
pub fn collect_stmts(ss: [Stmt], st: LamCollect) : LamCollect / Console {

  match ss {
    [] -> st
    [s, ...rest] -> collect_stmts(rest, collect_stmt(s, st))
  }
}

#[doc("AST collector walking stmt.")]
pub fn collect_stmt(s: Stmt, st: LamCollect) : LamCollect / Console {

  match s {
    SLet(pat, _, rhs) -> {
      # The RHS walks in the outer scope; the pattern's names bind only
      # for the statements after it.
      let s1 = collect_expr(rhs, st)
      lc_extend_locals(s1, pat_bindings(pat, []))
    }
    SAssert(c, opt_m) -> {
      let s1 = collect_expr(c, st)
      match opt_m { Some(m) -> collect_expr(m, s1) None -> s1 }
    }
    SExprStmt(x) -> collect_expr(x, st)
    SIndexAssign(b, i, v, _, _) -> {
      let s1 = collect_expr(b, st)
      let s2 = collect_expr(i, s1)
      collect_expr(v, s2)
    }
    SAssign(b, v, _, _) -> collect_expr(v, collect_expr(b, st))
    # A `var` is desugared into a handle upstream of this walker; one
    # that survives binds like a `let`.
    SVar(b, _, rhs, _, _) -> {
      let s1 = collect_expr(rhs, st)
      lc_extend_locals(s1, [b])
    }
    # m7e §25: stripped by desugar_use_decls before lambda lift runs.
    SUse(_, _, _) -> st
  }
}

# The walker swaps the enclosing fn's symbol on the way in and restores
# the parent's on the way out, so siblings stamp their own clauses
# against the right scope.
#[doc("Enter the fn / lambda / clause / runner whose emitted symbol is `name`, declared by module `mo`.")]
pub fn enter_enc_fn(st: LamCollect, name: String, mo: Option[String]) : LamCollect =
  LamCollect { ...st, cur_enc_fn: name, cur_mo: mo }

#[doc("Restore the enclosing-function name in clause-lookup state after a nested walk.")]
pub fn restore_enc_fn(st: LamCollect, name: String) : LamCollect =
  LamCollect { ...st, cur_enc_fn: name }

# Walk a fn / test / bench / check body under its symbol, restoring the
# surrounding enclosing fn and lexical scope on the way out. The scope
# starts from the body's own params: an outer local is not in scope.
fn collect_body(body: Expr, params: [Binder], enc: String,
                mo: Option[String], st: LamCollect) : LamCollect / Console {
  let outer = st.cur_enc_fn
  let outer_scope = st.scope
  let st1 = enter_enc_fn(lc_set_scope(st, fv_outer_of(params)), enc, mo)
  let st2 = collect_expr(body, st1)
  lc_set_scope(restore_enc_fn(st2, outer), outer_scope)
}

#[doc("AST collector walking decl.")]
pub fn collect_decl(d: Decl, st: LamCollect) : LamCollect / Console {
  let outer_locals = st.locals
  let st1 = collect_decl_body(d, LamCollect { ...st, locals: ln_of_decl(d) })
  LamCollect { ...st1, locals: outer_locals }
}

fn collect_decl_body(d: Decl, st: LamCollect) : LamCollect / Console {

  match d {
    DFn(_, fid, _, ps, _, _, body, _, _, mo) ->
      collect_body(body, params_binders(ps), c_sym(written_text(fn_emit_name(st.tab, st.specs, fid)), mo), mo, st)
    DType(_, _, _, _, _, _, _, _) -> st
    # The runner symbol the backends will emit is also the enclosing-fn
    # key for everything lifted out of the block's body, so the collector
    # mints it from the same `runner_enc_fn` both backends call.
    DTest(_, body, line, col, mo) ->
      collect_body(body, [], runner_enc_fn("test", mo, line, col), mo, st)
    DBench(_, body, line, col, mo) ->
      collect_body(body, [], runner_enc_fn("bench", mo, line, col), mo, st)
    DCheck(_, ps, body, line, col, mo) ->
      collect_body(body, params_binders(ps), runner_enc_fn("check", mo, line, col), mo, st)
    DImport(_, _, _) -> st
    DEffect(_, _, _, _, _, _, _, _) -> st
    DProtocol(_, _, _, _, _, _, _) -> st
    DImpl(_, _, _, _, _, _, _, _) -> st
    DDerive(_, _, _, _) -> st
    DUnstable(_, _, _) -> st
    DProtoLaws(_, _, _, _, _) -> st
    DImplAxiom(_, _, _, _, _) -> st
    DConstructor(_, _, _) -> st
    DUnit(_, _, _, _, _, _, _) -> st
    DUse(_, _, _) -> st
    DUseKind(_, _, _, _) -> st
    DDoc(_, _, _, _, _) -> st
    DAttr(_, inner, _, _) -> collect_decl_body(inner, st)
    DModuleDoc(_, _, _, _) -> st
    DExternType(_, _, _, _, _) -> st
    DAxiom(_, _, _, _, _, _, _, _, _, _) -> st
    DConst(_, _, _, body, _, _, _) -> collect_expr(body, st)
    DTheory(_, _, _, _, _) -> st
    DKind(_, _, _, _, _, _, _, _) -> st
  }
}

#[doc("AST collector walking decls.")]
pub fn collect_decls(ds: [Decl], st: LamCollect) : LamCollect / Console {

  match ds {
    [] -> st
    [d, ...rest] -> collect_decls(rest, collect_decl(d, st))
  }
}

#[doc("The name a row's constructor is emitted with.")]
pub fn evar_name(v: VariantEntry) : String = match v { EV(_, n, _, _, _) -> n }

#[doc("The module that declares a row's constructor; None for the root file's and the runtime's.")]
pub fn evar_home(v: VariantEntry) : Option[String] = match v { EV(hm, _, _, _, _) -> hm }

#[doc("The number of payload slots of a row's constructor.")]
pub fn evar_arity(v: VariantEntry) : Int = match v { EV(_, _, ar, _, _) -> ar }

#[doc("The payload slot kinds of a row's constructor.")]
pub fn evar_kinds(v: VariantEntry) : [Int] = match v { EV(_, _, _, ks, _) -> ks }

# ---- lambda helper emission ----

#[doc("Keep only the operand arguments of a call, dropping any threaded evidence args.")]
pub fn op_args_only(params: [Param]) : [Param] {
  match params {
    [] -> []
    [_] -> []                       # the lone trailing `resume`
    [p, ...rest] -> [p, ...op_args_only(rest)]
  }
}

#[doc("The success-side variant constructor a postfix-! expression unwraps.")]
pub fn bang_success_variant(opt_ty: Option[Ty]) : Option[String] {
  match opt_ty {
    None -> None
    Some(t) -> match t {
      TyCon(tcs, _) ->
        if core_ty_is(tcs, CtOption) { Some("Some") }
        else if core_ty_is(tcs, CtResult) { Some("Ok") }
        else { None }
      _ -> None
    }
  }
}

# m7a #6b/#6c: lower `handle { body } with Eff [as alias] { clauses }`
# to its prologue/body/epilogue. m7a #6b shipped the EvE alloca,
# the handler-id stamp, the kai_evidence_push/pop pair, and the
# optional return clause; m7a #6c populates each op fn-ptr with the
# top-level clause function emitted by emit_clause_body, so that op
# calls inside the body dispatch through the EvE.
# m7b #11: when `init_opt` is `Some(ie)`, write the init value into
# `_ev.state` after the handler-id and op-fn-ptr assignments. The
# clause body emitter exposes that slot inside clauses as `state` /
# `log` aliases of `self->state`.

#[doc("The block `let`s the emitter releases inline: a single `PBind` never read in the rest of the block whose rhs `pcs_let_paid_inline` accepts. A drop perceus planted counts as a read, so a binder perceus pays is never paid here too.")]
pub fn block_unused_lets(stmts: [Stmt], opt_final: Option[Expr]) : [LocalId] {
  let final_reads = match opt_final {
    None -> []
    Some(e) -> bul_add_reads([], scan_uses_expr(e, false))
  }
  bul_from_end(list_reverse(stmts), final_reads, [])
}

# Walks the block from its end, carrying every read after the statement
# at hand, so each statement is scanned once.
fn bul_from_end(rev: [Stmt], later: [LocalId], acc: [LocalId]) : [LocalId] =
  match rev {
    [] -> acc
    [s, ...earlier] -> {
      let acc1 = match s {
        SLet(pat, _, rhs) -> match pat.pkind {
          PBind(b) -> if pcs_let_paid_inline(rhs) and not local_among(later, b.id) { [b.id, ...acc] } else { acc }
          _ -> acc
        }
        _ -> acc
      }
      bul_from_end(earlier, bul_add_reads(later, scan_uses_in_stmts([s], false)), acc1)
    }
  }

fn bul_add_reads(reads: [LocalId], uses: [Use]) : [LocalId] =
  match uses {
    [] -> reads
    [U(l, _, _, _), ...rest] -> bul_add_reads([l, ...reads], rest)
  }

#[doc("True if the local `l` is read anywhere among `uses`.")]
pub fn any_use_of(uses: [Use], l: LocalId) : Bool {
  match uses {
    [] -> false
    [h, ...rest] -> match h {
      U(ul, _, _, _) ->
        if local_eq(ul, l) { true } else { any_use_of(rest, l) }
    }
  }
}

# m12.7.x FFI v1: enumeration of the supported return kinds plus an
# escape hatch (`FfiRetUnknown`) carrying the offending type name so
# the emitted `#error` can name it back to the user.
#[doc("FFI marshalling kind of a boundary type: scalars (Int/Real/Bool/String/Unit), fixed-width annotations (`FfiRetFixed`), struct-by-value (`FfiRetStruct`, carrying the declared name — fields looked up in the extern-type registry), and opaque handles (`FfiRetForeign`). `FfiRetUnknown` carries the offending type name so the emitted `#error` can name it.")]
pub type FfiRetKind
  = FfiRetUnit
  | FfiRetInt
  | FfiRetReal
  | FfiRetBool
  | FfiRetChar
  | FfiRetString
  | FfiRetFixed(FfiFixed)
  # Numeric lane A: an honest fixed-width VALUE type (Int32/UInt32/
  # UInt64/Int128) at the boundary. Unlike `FfiRetFixed` (the legacy
  # I32/U32 annotation whose kaikai side is `Int`, unboxed via kai_intf),
  # the kaikai side is a tagged fixed-width box, so marshalling reads its
  # width field and re-boxes with the matching constructor.
  | FfiRetFixedVal(Ty)
  | FfiRetStruct(String)
  | FfiRetForeign(String)
  | FfiRetUnknown(String)

#[doc("A fixed-width FFI-boundary scalar. Maps to a C `uintN_t`/`intN_t`/`float` at the boundary; the kaikai side stays `Int` (or `Real` for `F32`). C-cast semantics, no range-check.")]
pub type FfiFixed = FxU8 | FxU16 | FxU32 | FxU64 | FxI8 | FxI16 | FxI32 | FxI64 | FxF32

#[doc("The fixed-width annotation for `name`, or None if it is not one.")]
pub fn ffi_fixed_of_name(name: String) : Option[FfiFixed] {
  if name == "U8" { Some(FxU8) }
  else if name == "U16" { Some(FxU16) }
  else if name == "U32" { Some(FxU32) }
  else if name == "U64" { Some(FxU64) }
  else if name == "I8" { Some(FxI8) }
  else if name == "I16" { Some(FxI16) }
  else if name == "I32" { Some(FxI32) }
  else if name == "I64" { Some(FxI64) }
  else if name == "F32" { Some(FxF32) }
  else { None }
}

#[doc("The C scalar type a fixed-width annotation maps to at the boundary.")]
pub fn ffi_fixed_c_type(f: FfiFixed) : String = match f {
  FxU8  -> "uint8_t"
  FxU16 -> "uint16_t"
  FxU32 -> "uint32_t"
  FxU64 -> "uint64_t"
  FxI8  -> "int8_t"
  FxI16 -> "int16_t"
  FxI32 -> "int32_t"
  FxI64 -> "int64_t"
  FxF32 -> "float"
}

#[doc("The C boundary type for an honest fixed-width value type (Int32 -> int32_t, etc.).")]
pub fn fixed_val_c_type(t: Ty) : String = match t {
  TyInt32  -> "int32_t"
  TyUInt32 -> "uint32_t"
  TyUInt64 -> "uint64_t"
  _        -> "__int128"
}

#[doc("The KaiValue union field a fixed-width value box reads through (Int32 -> ->as.i32, etc.). Int32/UInt32/UInt64 only — Int128 is rejected at the FFI boundary, so its arm reads the low half defensively (no bare `->as.i128`, which the union no longer carries).")]
pub fn fixed_val_box_field(t: Ty) : String = match t {
  TyInt32  -> "->as.i32"
  TyUInt32 -> "->as.u32"
  TyUInt64 -> "->as.u64"
  _        -> "->as.i128_halves[0]"
}

#[doc("The box constructor for a fixed-width value (Int32 -> kai_int32, etc.).")]
pub fn fixed_val_box_ctor(t: Ty) : String = match t {
  TyInt32  -> "kai_int32"
  TyUInt32 -> "kai_uint32"
  TyUInt64 -> "kai_uint64"
  _        -> "kai_int128"
}

#[doc("True when a fixed-width annotation is the floating `F32` (carried on the kaikai side as `Real`, not `Int`).")]
pub fn ffi_fixed_is_float(f: FfiFixed) : Bool = match f {
  FxF32 -> true
  _     -> false
}

#[doc("The bit width of a fixed-width annotation (8/16/32/64; `F32` is 32).")]
pub fn ffi_fixed_bits(f: FfiFixed) : Int = match f {
  FxU8  -> 8   FxI8  -> 8
  FxU16 -> 16  FxI16 -> 16
  FxU32 -> 32  FxI32 -> 32
  FxU64 -> 64  FxI64 -> 64
  FxF32 -> 32
}

#[doc("True when a fixed-width integer annotation is signed (`I*`); false for unsigned (`U*`). Drives sext vs zext on the boundary return. `F32` is false (not an integer).")]
pub fn ffi_fixed_is_signed(f: FfiFixed) : Bool = match f {
  FxI8 -> true   FxI16 -> true   FxI32 -> true   FxI64 -> true
  _    -> false
}

#[doc("FFI marshalling helper: ret kind of.")]
pub fn ffi_ret_kind_of(opt: Option[TypeExpr], tab: SymTab) : FfiRetKind {
  match opt {
    None -> FfiRetUnit
    Some(t) -> ffi_kind_of_ty(t, tab)
  }
}

# Registry-free classifier: handles v1 scalars + fixed-width
# annotations (a closed global set). A non-primitive named type
# becomes `FfiRetUnknown` here — the registry-AWARE classifier
# (`ffi_kind_of_ty_reg`, compiler/ffi_v2.kai) upgrades a known extern
# struct / opaque before the emitter consumes the result.
#[doc("FFI marshalling helper: registry-free kind of a boundary type (v1 scalars + fixed-width). `tab` names a declared type the boundary does not support.")]
pub fn ffi_kind_of_ty(t: TypeExpr, tab: SymTab) : FfiRetKind {
  match t.tkind {
    TyName(r, _) -> match resolve_ty(t) {
      TyInt    -> FfiRetInt
      TyReal   -> FfiRetReal
      TyBool   -> FfiRetBool
      TyChar   -> FfiRetChar
      TyString -> FfiRetString
      TyUnit   -> FfiRetUnit
      TyInt32  -> FfiRetFixedVal(TyInt32)
      TyUInt32 -> FfiRetFixedVal(TyUInt32)
      TyUInt64 -> FfiRetFixedVal(TyUInt64)
      TyInt128 -> FfiRetFixedVal(TyInt128)
      # A width annotation resolves to no type of its own and declares
      # nothing: the written name is all that carries the width.
      _ -> match r {
        DrWritten(_, w) -> match ffi_fixed_of_name(written_text(w)) {
          Some(fx) -> FfiRetFixed(fx)
          None     -> FfiRetUnknown(written_text(w))
        }
        DrSym(s) -> FfiRetUnknown(written_text(decl_name(tab, s)))
      }
    }
    _ -> FfiRetUnknown("non-named type")
  }
}

# Row for one `__pimpl_*` entry: the C symbol name, the core protocol,
# the kaikai type name (head), and the impl fn's arity. Heterogeneous-
# mangled impls (`__pimpl_<P>_<T>_<op>__a_<args>`) collapse to the same
# `(P, T)` dispatch key — the typer's compile-time rewrite already
# routes the right arg-shape; the runtime only needs the head match.
# The arity is needed by the LLVM emit to synthesise the bitcast
# target type (`%KaiValue* (%KaiValue*, ...)*`) with the right number
# of params — without it every impl would be bitcast to arity 1 and
# clang rejects the mismatch (issue surfaced in release v0.83.x build).
#
# The fifth slot is the impl fn's unboxed signature, captured in situ
# from the `EFn` registry by `collect_pimpl_rows`. `Some(US([Ty], Ty))`
# means the builtin scalar impl (`Eq_Int_eq(int64_t,int64_t)`,
# `Ord_Real_cmp(double,double)`, …) was classified by the unbox pass as
# taking + returning raw C scalars — its C symbol does NOT have the
# `KaiValue*(KaiValue*,KaiValue*)` shape the runtime dispatch sites
# (`kai_op_eq` / `kai_op_lt` / `kai_op_gt`) cast to and call. Such rows
# register a boxed shim (`&kai_<csym>__boxed`) in the impl table instead
# of the raw pimpl; the raw pimpl stays reachable for the monomorphic
# fast path. `None` means the impl already has the boxed
# `KaiValue*(...)` shape (String / Unit / List / Option / Result); it is
# registered directly unless it borrows a param. See `emit_impl_shim_defs`.
#[doc("Row for one `__pimpl_*` entry: the C symbol name, the core protocol, the kaikai type name (head), the impl fn's arity, its unboxed signature (Some when scalar, None when boxed), op name, impl home, and the param positions Perceus made borrowed.")]
pub type PimplRow = PR(String, CoreProto, String, Int, Option[UFnSig], String, Option[String], [Int])
#                  c_sym    proto   type_name arity      unboxed sig   op_name impl home      lent

#[doc("AST collector walking pimpl rows. `fns` is the EFn registry, holding each fn's unboxed signature (the unbox pass stamps it there); `tab` and `specs` spell the name each fn is emitted under.")]
pub fn collect_pimpl_rows(ds: [Decl], fns: [EFn], tab: SymTab, specs: SpecNames, acc: [PimplRow]) : [PimplRow] =
  pimpl_rows(ds, fnx_build(fns), tab, specs, acc)

fn pimpl_rows(ds: [Decl], fx: FnIndex, tab: SymTab, specs: SpecNames, acc: [PimplRow]) : [PimplRow] {
  match ds {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DFn(_, fid, _, params, _, _, _, _, _, mo) ->
        match pimpl_row_of(fx, fid, written_text(fn_emit_name(tab, specs, fid)), params, mo) {
          Some(row) -> pimpl_rows(rest, fx, tab, specs, [row, ...acc])
          None      -> pimpl_rows(rest, fx, tab, specs, acc)
        }
      _ -> pimpl_rows(rest, fx, tab, specs, acc)
    }
  }
}

# The row of the fn `fid` when `name`, the name it is emitted under,
# spells a protocol impl.
fn pimpl_row_of(fx: FnIndex, fid: FnId, name: String, params: [Param], mo: Option[String]) : Option[PimplRow] =
  if not string_starts_with_q(name, "__pimpl_") { None }
  else { match parse_pimpl_name(name) {
    Some(pr) -> {
      let sig = fnx_ufn_sig_first(fx, fid)
      Some(pr_with_csym(pr, c_sym(name, mo), list_length(params), sig, mo, pimpl_lent(params, pimpl_raw_flags(sig), 0)))
    }
    None -> None
  } }

#[doc("Attach the minted C symbol, unboxed signature, impl home and borrowed positions to a decoded protocol-impl row.")]
pub fn pr_with_csym(pr: PimplRow, csym: String, arity: Int, sig: Option[UFnSig], home: Option[String], lent: [Int]) : PimplRow {
  match pr { PR(_, p, t, _, _, op, _, _) -> PR(csym, p, t, arity, sig, op, home, lent) }
}

# Only boxed params: a raw one reaches the impl unboxed and the adapter
# already consumed its box.
fn pimpl_lent(params: [Param], raw: [Bool], i: Int) : [Int] = match params {
  [] -> []
  [p, ...rest] -> {
    let here = match raw {
      [r, ..._] -> r
      [] -> false
    }
    let more = match raw {
      [_, ...rs] -> rs
      [] -> []
    }
    let lent = pimpl_lent(rest, more, i + 1)
    if p.pborrow and not here { [i, ...lent] } else { lent }
  }
}

# Per-param raw flags; an unboxed signature with no mask is raw where scalar.
fn pimpl_raw_flags(sig: Option[UFnSig]) : [Bool] = match sig {
  Some(US(pts, _, [])) -> map(pts, (t) => ty_is_scalar(t))
  Some(US(_, _, mask)) -> mask
  None -> []
}

#[doc("The param positions the impl borrows; the dispatch table hands every argument owned, so its adapter drops these after the call.")]
pub fn pimpl_row_lent(pr: PimplRow) : [Int] = match pr { PR(_, _, _, _, _, _, _, lent) -> lent }

#[doc("True when the impl cannot sit in the dispatch table as is: its ABI is raw, or it borrows a param the table hands over owned.")]
pub fn pimpl_row_needs_adapter(pr: PimplRow) : Bool = pimpl_row_is_unboxed(pr) or pimpl_row_lent(pr) != []

#[doc("True when this pimpl row has an unboxed (raw-scalar) C signature and so needs a boxed shim before it can be registered in the impl table. A row is unboxed when the unbox pass classified it (`Some(US ...)`) AND it touches a raw scalar at the ABI boundary — either a scalar PARAM or a scalar RETURN. The return-only branch covers arity-0 impls like `Default` (`Default_Int_default() : Int` is emitted `i64 ()*` but the impl table bitcasts the slot to `%KaiValue* ()*` — clang's LLVM verifier rejects the mismatch; the C backend gets an implicit cast and only the LLVM smoke test catches it). issue fix-default-shim.")]
pub fn pimpl_row_is_unboxed(pr: PimplRow) : Bool {
  match pr {
    PR(_, _, _, _, sig, _, _, _) -> match sig {
      None -> false
      Some(US(pts, rt, _)) -> any_param_scalar(pts) or ty_is_scalar(rt)
    }
  }
}

#[doc("True when any type in the list is a raw C scalar (Int/Bool/Char/Real), peeling Dim/Refine wrappers. The unbox pass only classifies a fn when every param + the return are scalar, so a non-empty scalar param implies the whole signature is unboxed.")]
pub fn any_param_scalar(ts: [Ty]) : Bool {
  match ts {
    [] -> false
    [t, ...rest] -> if ty_is_scalar(t) { true } else { any_param_scalar(rest) }
  }
}

#[doc("True when a Ty is a raw C scalar (Int/Bool/Char/Byte/Real), peeling unit-of-measure and refinement wrappers.")]
pub fn ty_is_scalar(t: Ty) : Bool {
  match t {
    TyInt  -> true
    TyReal -> true
    TyBool -> true
    TyChar -> true
    TyByte -> true
    TyInt32  -> true
    TyUInt32 -> true
    TyUInt64 -> true
    TyInt128 -> true
    TyDimT(inner, _)    -> ty_is_scalar(inner)
    TyRefineT(inner, _) -> ty_is_scalar(inner)
    _ -> false
  }
}

#[doc("Parse `__pimpl_<P>_<T>_<op>` or `__pimpl_<P>_<T>_<op>__a_<args>` back into (proto, type_name). The proto is the core protocol whose name the symbol spells; any other protocol returns None to skip.")]
pub fn parse_pimpl_name(name: String) : Option[PimplRow] {
  # name = "__pimpl_" ++ <rest>; cut prefix.
  let prefix_len = 8
  let n = string_length(name)
  if n <= prefix_len { None }
  else {
    let rest = string_slice(name, prefix_len, n - prefix_len)
    # split off the trailing "__a_..." suffix if present.
    let base = pimpl_strip_arg_suffix(rest)
    # `base` is now `<P>_<T>_<op>`. Take P as the core protocol the
    # symbol leads with; everything between `<P>_` and the final
    # `_<op>` is the type name.
    match pimpl_split_proto(base) {
      None -> None
      Some(p_rest) -> match p_rest {
        PR2(p, rest1) -> {
          # rest1 = "<T>_<op>". Strip the trailing `_<op>` by finding
          # the last underscore.
          let m = string_length(rest1)
          let last = find_last_underscore_proto(rest1, m - 1)
          if last <= 0 { None }
          else {
            let tname = string_slice(rest1, 0, last)
            let op = string_slice(rest1, last + 1, m - last - 1)
            Some(PR("", p, tname, 0, None, op, None, []))
          }
        }
      }
    }
  }
}

#[doc("Two-field protocol-impl name split (proto, rest).")]
pub type PR2 = PR2(CoreProto, String)

# Strip a `__a_…` suffix off a `__pimpl_*` symbol's payload string.

# Strip a `__a_…` suffix off a `__pimpl_*` symbol's payload string.
#[doc("Strip a `__a_…` suffix off a `__pimpl_*` symbol's payload string.")]
pub fn pimpl_strip_arg_suffix(s: String) : String {
  let marker = "__a_"
  let idx = find_substring(s, marker, 0)
  let n = string_length(s)
  if idx >= n { s }
  else { string_slice(s, 0, idx) }
}

# No core protocol's name holds a `_`, so at most one leads `s`.
#[doc("The core protocol whose name `s` starts with, and the remainder after the trailing `_`. None when no core protocol leads `s`.")]
pub fn pimpl_split_proto(s: String) : Option[PR2] {
  let try_one = (cp: CoreProto) => {
    let p = core_proto_name(cp)
    let plen = string_length(p)
    let n = string_length(s)
    if n > plen and substring_eq(s, 0, p) {
      let after = char_at_or_zero(s, plen)
      if after == '_' {
        Some(PR2(cp, string_slice(s, plen + 1, n - plen - 1)))
      } else { None }
    } else { None }
  }
  pimpl_first_match(core_protos(), try_one)
}

#[doc("Protocol-impl name decoder: first match.")]
pub fn pimpl_first_match(opts: [CoreProto], f: (CoreProto) -> Option[PR2]) : Option[PR2] {
  match opts {
    [] -> None
    [o, ...rest] -> match f(o) {
      Some(r) -> Some(r)
      None    -> pimpl_first_match(rest, f)
    }
  }
}

#[doc("Find the last underscore boundary in a protocol-impl name for splitting.")]
pub fn find_last_underscore_proto(s: String, from: Int) : Int {
  if from < 0 { -1 }
  else {
    match char_at(s, from) {
      Some('_') -> from
      _         -> find_last_underscore_proto(s, from - 1)
    }
  }
}

# Substring-equality. Returns true if `s[i..i+|t|] == t`. Bounds-safe.

# Substring-equality. Returns true if `s[i..i+|t|] == t`. Bounds-safe.
#[doc("Substring-equality. Returns true if `s[i..i+|t|] == t`. Bounds-safe.")]
pub fn substring_eq(s: String, i: Int, t: String) : Bool {
  let tn = string_length(t)
  let sn = string_length(s)
  if i + tn > sn { false }
  else { substring_eq_loop(s, i, t, 0, tn) }
}

#[doc("Tail loop comparing a substring against a needle character by character.")]
pub fn substring_eq_loop(s: String, i: Int, t: String, k: Int, tn: Int) : Bool {
  if k >= tn { true }
  else {
    let b = string_byte_at_int(s, i + k)
    b >= 0 and b == string_byte_at_int(t, k) and substring_eq_loop(s, i, t, k + 1, tn)
  }
}

# Find `needle` in `hay` starting at `from`. Returns length(hay) if
# not found.

# Find `needle` in `hay` starting at `from`. Returns length(hay) if
# not found.
#[doc("Find `needle` in `hay` starting at `from`. Returns length(hay) if not found.")]
pub fn find_substring(hay: String, needle: String, from: Int) : Int {
  let hn = string_length(hay)
  if from >= hn { hn }
  else if substring_eq(hay, from, needle) { from }
  else { find_substring(hay, needle, from + 1) }
}

# C array body for the impl table. Each row maps the parsed proto/type
# back to the integer constants pinned in runtime.h.

# `kai_variant_to_head[]` — one int32_t per variant tag, mapping each
# constructor to its sum-type head. The runtime indexes this array by
# Tags are sparse (name-keyed), so no dense slot-per-tag array exists;
# the runtime builds its indexed lookup from explicit (tag, head) pairs.
#[doc("Variant-to-head map as flattened (variant_tag, head_tag) pairs, one pair per EVar entry. The runtime rebuilds its dense lookup from these; pairs impose no density assumption on the tag space.")]
pub fn collect_variant_to_head(variants: [VariantEntry], decls: [Decl], tab: SymTab) : [Int] =
  collect_v2h_pairs(variants, decls, tab, [])

fn collect_v2h_pairs(vs: [VariantEntry], decls: [Decl], tab: SymTab, acc: [Int]) : [Int] {
  match vs {
    [] -> list_reverse(acc)
    [EV(hm, name, _, _, tag), ...rest] ->
      collect_v2h_pairs(rest, decls, tab, [variant_head_tag_for_in(hm, name, decls, tab), tag, ...acc])
  }
}

#[doc("Integer head tag for a builtin type name (Int -> 3, Real -> 4, Bool -> 2, ...) or a user record/sum type (dense, >= 20); -1 for unknown types. The runtime-table identity backing both LLVM-text (`_kai_proto_init_llvm`) and in-process native emission. Pub for unit testing.")]
pub fn stdlib_head_tag_int(home: Option[String], tname: String, decls: [Decl], tab: SymTab) : Int = match rt_head_named(tname) {
  Some(h) -> rt_head_tag(h)
  None    -> impl_target_head_tag(home, tname, decls, tab)
}

#[doc("The id the runtime impl table numbers the core protocol `p` with. The integer counterpart of `stdlib_proto_id_c`, shared by both the LLVM-text and in-process native impl-table registration.")]
pub fn stdlib_proto_id_int(p: CoreProto) : Int = match p {
  CpShow         -> 0
  CpEq           -> 1
  CpOrd          -> 2
  CpHash         -> 3
  CpSerialize    -> 4
  CpBinSerialize -> 5
  CpDefault      -> 6
  CpAdd          -> 7
  CpSub          -> 8
  CpMul          -> 9
  CpDiv          -> 10
  CpRem          -> 11
  CpNumeric      -> 12
  CpLayout       -> 13
  CpJson         -> 14
}

# The operation index within a protocol. The impl table keys on
# (proto_id, op_id, head_tag), so a multi-op protocol's ops (Ord.cmp/min/max,
# Numeric.*) resolve distinctly instead of colliding on (proto_id, head_tag).
# Single-op protocols are op 0. The exact value is irrelevant — only that it
# is unique within a protocol and that both backends compute it from the same
# function, so a C table entry and the native dispatch agree on the key.
pub fn stdlib_proto_op_id_int(p: CoreProto, opname: String) : Int = match p {
  CpOrd ->
    if opname == "cmp" { 0 } else if opname == "min" { 1 } else { 2 }
  CpNumeric ->
    if opname == "add" { 0 } else if opname == "mul" { 1 } else if opname == "zero" { 2 }
    else if opname == "one" { 3 } else if opname == "abs" { 4 } else if opname == "sign" { 5 }
    else if opname == "pow_int" { 6 } else if opname == "clamp" { 7 } else { 8 }
  CpSerialize ->
    if opname == "to_string" { 0 } else { 1 }
  CpBinSerialize ->
    if opname == "to_bytes" { 0 } else { 1 }
  CpLayout ->
    if opname == "to_bytes" { 0 } else { 1 }
  CpJson ->
    if opname == "to_json" { 0 } else { 1 }
  _ -> 0
}

#[doc("The op-id (`stdlib_proto_op_id_int`) as a C integer literal for the impl table + dispatch shim.")]
pub fn stdlib_proto_op_id_c(p: CoreProto, opname: String) : String =
  int_to_string(stdlib_proto_op_id_int(p, opname))

#[doc("The core protocol a dispatcher's marker names. A dispatcher carries its protocol only as the name the marker spells.")]
pub fn pdp_core(parts: ProtoDispatchParts) : Option[CoreProto] = match parts {
  PDP(pname, _) -> core_proto_named(pname)
}

#[doc("The runtime protocol id a dispatcher looks its impl up under; -1 for a protocol the runtime impl table does not number.")]
pub fn pdp_proto_id_int(parts: ProtoDispatchParts) : Int = match pdp_core(parts) {
  Some(cp) -> stdlib_proto_id_int(cp)
  None     -> 0 - 1
}

#[doc("The runtime op id a dispatcher looks its impl up under; 0 for a protocol the runtime impl table does not number.")]
pub fn pdp_op_id_int(parts: ProtoDispatchParts) : Int = match parts {
  PDP(_, opname) -> match pdp_core(parts) {
    Some(cp) -> stdlib_proto_op_id_int(cp, opname)
    None     -> 0
  }
}

#[doc("For a constructor `name`, find the sum type it belongs to and look up that sum's head tag. Builtins use the reserved ids; user sums resolve to their declaration's dense head tag.")]
pub fn variant_head_tag_for(name: String, decls: [Decl], tab: SymTab) : Int =
  variant_head_tag_for_in(None, name, decls, tab)

#[doc("Head tag of the sum declaring `name` in module `home`; builtins keep their reserved ids.")]
pub fn variant_head_tag_for_in(home: Option[String], name: String, decls: [Decl], tab: SymTab) : Int {
  let os_tag = if evar_home_eq(home, os_home()) { os_head_tag(name) } else { 0 - 1 }
  if name == "Some" or name == "None" { 16 }
  else if name == "Ok" or name == "Err" { 17 }
  else if os_tag >= 0 { os_tag }
  else { ctor_owner_head_tag(home, name, decls, tab) }
}

fn os_head_tag(name: String) : Int =
  if name == "SigInt" or name == "SigTerm" or name == "SigHup" or name == "SigUsr1"
     or name == "SigUsr2" or name == "SigWinch" { 18 }
  else if name == "Exited" or name == "Signaled" { 19 }
  else { 0 - 1 }

#[doc("The effects of the entry fn's declared row, the ones its default-handler wrapper installs.")]
pub fn main_row_labels(decls: [Decl], entry: SymId) : [SymId] {
  match decls {
    [] -> []
    [d, ...rest] -> match d {
      DFn(_, fid, _, _, _, row, _, _, _, _) ->
        if is_entry(entry, fid) {
          match row {
            REmpty       -> []
            RClosed(lbs) -> es_row_label_syms(lbs)
            ROpen(_, lbs) -> es_row_label_syms(lbs)
          }
        } else { main_row_labels(rest, entry) }
      _ -> main_row_labels(rest, entry)
    }
  }
}

# Effects whose default handler is installed at the base of the
# evidence stack UNCONDITIONALLY — present around `kai_main` whether
# or not the effect appears in `main`'s inferred row.
#
# The general criterion (issue #531): an effect E is *base-installable*
# iff (a) it has a non-parametric default handler that can be installed
# statically (no user-supplied init), AND (b) it has no per-instance
# resources whose teardown must run before `kai_main` returns. `Mutable`
# qualifies: its default forwards each op to a `kai_core_*` C
# primitive, it carries no state, and a never-touched default is inert.
# `Stdout` fails (b) — flushing must be observable per call, not deferred
# to a base handler nobody asked for; `State` / `Spawn` / `Cancel` fail
# (a) — they need a user-supplied initial value or scheduler.
#
# Installing the base default unconditionally is what makes masking
# `Mutable` for ANY local mutable value (Array, Ref, HashMap, future
# Matrix/Tensor) trivially sound: the masking pass may drop `Mutable`
# from a fn's row knowing the dispatch site always finds a handler. A
# user `handle { } with Mutable { }` pushes ABOVE this base node, so
# LIFO dispatch still resolves a user op to the user handler.
#
# Generalising the unconditional install to other effects is purely
# additive (extend this list) and deliberately out of scope here.
pub fn unconditional_default_effects() : [SymId] = [core_effect_id(CeMutable)]

# Add every base-installable effect (`unconditional_default_effects`)
# to `main_row` that is not already present. DEDUP is load-bearing: the
# result must stay a SET so the install/teardown push/pop derived from
# it (both filter `install_order` against this same row) stays LIFO-
# balanced — a duplicated `Mutable` would otherwise risk a second push
# with no matching pop in any consumer that iterates the row directly.
pub fn ensure_unconditional_defaults(main_row: [SymId]) : [SymId] =
  add_missing_effects(unconditional_default_effects(), main_row)

# An extern-default effect a lexical handler absorbed from main's row still
# needs its default node installed: a spawned fiber starts with an empty
# evidence stack (the parent handler does not cross the spawn boundary) and
# resolves the effect to that default, not to a zero-init node. Both backends
# add these back to the default-install set.
#[doc("Extern-default effects handled by some `handle` in the program — the set a lexical parent handler absorbs from main's row.")]
pub fn default_effects_absorbed_by_handler(decls: [Decl]) : [SymId] =
  effects_absorbed_loop(collect_effect_ids(decls), decls)

fn effects_absorbed_loop(rem: [SymId], decls: [Decl]) : [SymId] = match rem {
  []           -> []
  [e, ...rest] ->
    if effect_default_block_all_extern(e, decls) and obl_eff_handled_anywhere(decls, decls, e) {
      [e, ...effects_absorbed_loop(rest, decls)]
    } else { effects_absorbed_loop(rest, decls) }
}

#[doc("The effects a test, bench or check entry installs a default handler for: every effect whose default block is all-extern. A runner body has no row of its own, so it may perform any of them.")]
pub fn runner_entry_row(decls: [Decl]) : [SymId] =
  filter(collect_effect_ids(decls), (e) => effect_default_block_all_extern(e, decls))

#[doc("Append each effect in `extra` not already present in `row`; preserves `row` as a set.")]
pub fn add_missing_effects(extra: [SymId], row: [SymId]) : [SymId] = match extra {
  []           -> row
  [e, ...rest] ->
    if effect_in_row(row, e) { add_missing_effects(rest, row) }
    else { add_missing_effects(rest, [e, ...row]) }
}

fn effect_in_row(row: [SymId], e: SymId) : Bool = match row {
  []           -> false
  [h, ...rest] -> sym_same(h, e) or effect_in_row(rest, e)
}

# m12.8 Phase 4b: atomic Stdout / Stderr default setups. The
# combined `Console` is an alias `type Console = Stdout + Stderr`,
# so a `main` declaring `/ Console` installs BOTH the Stdout and
# Stderr default handlers via the alias-expansion path in
# `default_setups_for`.
#
# Issue #115: the runtime `kai_default_*` handlers in stage0/runtime.h
# take `void *self` because the runtime header cannot know the
# emitted `EvStdout` / `EvStderr` / ... types. Casting their
# addresses to typed function pointers (`(KaiValue *(*)(EvStdout *,
# ...))`) is a representation-equivalent cast in C, but UBSan's
# `-fsanitize=function` (active in clang's `-fsanitize=undefined`
# on Linux; absent from Apple clang's default `undefined` set)
# checks at every indirect call that the *function definition's*
# type tag equals the function pointer's static type. The cast
# does not change the function definition's type tag, so every
# dispatch through `_ev_op->print(...)` etc. trips the check on
# Linux while passing on macOS.
#
# Fix: emit a thin typed shim per default-op at file scope
# (`_kai_default_<eff>_<op>_shim`). The shim has the typed
# signature matching the struct field, forwards to the runtime
# void-self function via a regular call (not subject to
# `-fsanitize=function`). Setup assigns the shim's address; no
# cast required at the assignment, no UBSan diagnostic at the
# dispatch site.
# Issue #556: derive a default-handler shim from a user-declared
# `default { }` block whose clause bodies are `$extern_handler("c_sym")`.
# The shim shape mirrors the hardcoded family above:
#     static KaiValue *_kai_default_<eff_lc>_<op>_shim(Ev<Eff> *self,
#         KaiValue *kai_<arg>, ..., KaiCont *k) {
#         return <c_sym>(self, kai_<arg>, ..., k);
#     }
# Returns "" when the effect has no default block, or when the block's
# clauses do not all bridge to extern_handler (the latter case is a
# user-declared effect with kaikai-bodied default; Stage C will lower
# those, but Stage A's codegen scope is the extern_handler bridge only).

#[doc("The `default { }` block the effect `eff` declares; None when it is not declared or declares none.")]
pub fn find_effect_default_block(eff: SymId, decls: [Decl]) : Option[DefaultBlock] =
  effect_decl_default(effect_decl_of(eff, decls))

# The default-handler shims and the evidence static mint their `Ev`
# struct name from this module, so they target the struct that carries
# the default block's ops.
#[doc("Module qualifier of the effect `eff` when it declares a `default { }` block; None otherwise.")]
pub fn default_block_owner_mo(eff: SymId, decls: [Decl]) : Option[String] = match effect_decl_of(eff, decls) {
  Some(DEffect(_, _, _, _, Some(_), _, _, mo)) -> mo
  _ -> None
}

#[doc("The effect `eff` when it declares a `default { }` block, `sym_none()` when it declares none.")]
pub fn default_block_owner_sym(eff: SymId, decls: [Decl]) : SymId = match find_effect_default_block(eff, decls) {
  Some(_) -> eff
  None    -> sym_none()
}

# Issue #557 — strict variant of `effect_has_default_block` used for
# main absorption: every clause must bridge to an `extern_handler`
# intrinsic. Stage A's codegen only knows how to lower those — a
# kaikai-bodied clause has no emitter path yet (Stage C). Treating
# effects with kaikai-bodied defaults as absorbed would type-check
# clean and segfault at runtime, so the typer holds back until codegen
# can match.
#[doc("True when the effect `eff` declares a `default { }` block whose every clause bridges to `$extern_handler`, the only shape codegen installs.")]
pub fn effect_default_block_all_extern(eff: SymId, decls: [Decl]) : Bool =
  effect_decl_default_all_extern(effect_decl_of(eff, decls))

# Search the handle stack for the topmost frame matching `eff_name`.
# Step 2 (clause-merge) and step 3 (handle-with-default) both require
# the topmost frame; step 1 fires when that frame's clauses list `op`.

# m7a #7 + m7b #2b + m8 #2/#4 + m12.8 Phase 4b: assemble the full
# setup block for the builtins listed in `main`'s row. Push order
# Stdout → Stderr → Stdin → Env → File → Mutable → Cancel →
# Spawn matches Doc B §*Installation order*: Spawn innermost (last
# pushed, first looked up); Cancel the layer below it (root nursery
# flags fibers, Cancel handler unwinds); Mutable below Cancel (I/O
# cluster). Phase 4b: `Console` acts as the alias `Stdout + Stderr`,
# so a row containing it triggers both setups.

# The typer settles `alias.op` into a perform on the typed tree; this
# walker does the same for a tree that reaches the emitter with the
# alias read still written as a field access. An alias is in scope
# inside its handle's body only: the init expression and the clauses
# are walked under the outer map.
#[doc("The handler aliases in scope of a walk, each with the effect it names, and whether a perform through one may dispatch by the alias's own handler id.")]
pub type AliasMap = AM([(LocalId, SymId)], Bool)

#[doc("Alias-map operation: empty.")]
pub fn alias_map_empty() : AliasMap = AM([], true)

#[doc("`m` with the alias binder `alias` naming the effect `esym`.")]
pub fn alias_map_push(m: AliasMap, alias: LocalId, esym: SymId) : AliasMap {
  match m { AM(xs, t) -> AM([(alias, esym), ...xs], t) }
}

#[doc("The effect the alias binder `l` names, or None when `l` is no alias in scope.")]
pub fn alias_map_lookup(m: AliasMap, l: LocalId) : Option[SymId] {
  match m { AM(xs, _) -> alias_find(xs, l) }
}

fn alias_find(xs: [(LocalId, SymId)], l: LocalId) : Option[SymId] = match xs {
  [] -> None
  [(a, e), ...rest] -> if local_eq(a, l) { Some(e) } else { alias_find(rest, l) }
}

# A clause body compiles to a separate C function, where the id local
# the handle prologue declares for an outer alias is out of scope: a
# perform through that alias falls back to the ambient lookup there.
#[doc("`m` with dispatch by alias handler id switched off; the aliases stay in scope.")]
pub fn alias_map_disable_tag(m: AliasMap) : AliasMap {
  match m { AM(xs, _) -> AM(xs, false) }
}

#[doc("Alias-map operation: may tag.")]
pub fn alias_map_may_tag(m: AliasMap) : Bool {
  match m { AM(_, t) -> t }
}

#[doc("Let-alias rewriter over decls.")]
pub fn rewrite_alias_decls(ds: [Decl]) : [Decl] = map(ds, rewrite_alias_decl)

#[doc("Let-alias rewriter over decl.")]
pub fn rewrite_alias_decl(d: Decl) : Decl {
  match d {
    DFn(pub_, fid, tps, ps, ret, row, body, l, c, mo) ->
      DFn(pub_, fid, tps, ps, ret, row, rewrite_alias_expr(body, alias_map_empty()), l, c, mo)
    DTest(desc, body, l, c, mo) ->
      DTest(desc, rewrite_alias_expr(body, alias_map_empty()), l, c, mo)
    DBench(desc, body, l, c, mo) ->
      DBench(desc, rewrite_alias_expr(body, alias_map_empty()), l, c, mo)
    DCheck(desc, params, body, l, c, mo) ->
      DCheck(desc, params, rewrite_alias_expr(body, alias_map_empty()), l, c, mo)
    _ -> d
  }
}

#[doc("Let-alias rewriter over expr.")]
pub fn rewrite_alias_expr(e: Expr, m: AliasMap) : Expr =
  Expr { kind: rewrite_alias_kind(e.kind, m, e.line, e.col),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

#[doc("Let-alias rewriter over opt.")]
pub fn rewrite_alias_opt(opt: Option[Expr], m: AliasMap) : Option[Expr] {
  match opt {
    Some(e) -> Some(rewrite_alias_expr(e, m))
    None    -> None
  }
}

#[doc("Let-alias rewriter over clauses.")]
pub fn rewrite_alias_clauses(cs: [HClause], m: AliasMap) : [HClause] =
  map(cs, (c) => rewrite_alias_clause(c, m))

#[doc("Let-alias rewriter over clause.")]
pub fn rewrite_alias_clause(c: HClause, m: AliasMap) : HClause {
  match c {
    HC(n, ps, b, l, co) -> HC(n, ps, rewrite_alias_expr(b, alias_map_disable_tag(m)), l, co)
  }
}

#[doc("Let-alias rewriter over opt return.")]
pub fn rewrite_alias_opt_return(opt: Option[HReturn], m: AliasMap) : Option[HReturn] {
  match opt {
    Some(r) -> Some(rewrite_alias_return(r, m))
    None    -> None
  }
}

#[doc("Let-alias rewriter over return.")]
pub fn rewrite_alias_return(r: HReturn, m: AliasMap) : HReturn {
  match r {
    # The return clause compiles to a separate C function too.
    HR(p, b, l, c) -> HR(p, rewrite_alias_expr(b, alias_map_disable_tag(m)), l, c)
  }
}

# ---------------------------------------------------------------------------
# Shared structural map over ExprKind.
#
# Background (Full prerequisite 0.1, see `docs/stage2-design.md`):
# every AST-walking pass used to hand-roll its own structural recursion
# with a `_ -> k` catch-all over ExprKind. The wildcard audit in
# `7bd5a68` showed the same pattern duplicated 10x. Adding a new
# ExprKind variant (m7e variants[T](), refinement carriers, future
# actor primitives) silently re-introduces the same `_ -> k` debt
# at every site.
#
# `map_expr_kind` is the single point of structural recursion. Each
# walker handles only the kinds it actually transforms (or that
# require scope-aware bookkeeping); everything else falls through to
# `map_expr_kind`, which recurses into sub-Exprs explicitly. Adding
# a new ExprKind now breaks the compiler at one match site instead
# of degrading ten walkers.
#
# Convention: `f` is a closure that captures the walker's context
# and threads it through `<walker>_expr`. The closure is responsible
# for further recursion (i.e., `map_expr_kind` is one-level: it
# applies `f` to direct children, not to grandchildren).
#
# Sub-helpers (`map_stmt_exprs`, `map_arm_exprs`, etc.) replicate
# the structure for the auxiliary AST nodes that contain Exprs.
# A pass that needs scope-aware traversal (pattern shadowing in
# arms, binding shadowing in stmt blocks) handles those nodes
# explicitly in its own walker and never reaches the helpers below.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Shared structural map over ExprKind.
#
# Background (Full prerequisite 0.1, see `docs/stage2-design.md`):
# every AST-walking pass used to hand-roll its own structural recursion
# with a `_ -> k` catch-all over ExprKind. The wildcard audit in
# `7bd5a68` showed the same pattern duplicated 10x. Adding a new
# ExprKind variant (m7e variants[T](), refinement carriers, future
# actor primitives) silently re-introduces the same `_ -> k` debt
# at every site.
#
# `map_expr_kind` is the single point of structural recursion. Each
# walker handles only the kinds it actually transforms (or that
# require scope-aware bookkeeping); everything else falls through to
# `map_expr_kind`, which recurses into sub-Exprs explicitly. Adding
# a new ExprKind now breaks the compiler at one match site instead
# of degrading ten walkers.
#
# Convention: `f` is a closure that captures the walker's context
# and threads it through `<walker>_expr`. The closure is responsible
# for further recursion (i.e., `map_expr_kind` is one-level: it
# applies `f` to direct children, not to grandchildren).
#
# Sub-helpers (`map_stmt_exprs`, `map_arm_exprs`, etc.) replicate
# the structure for the auxiliary AST nodes that contain Exprs.
# A pass that needs scope-aware traversal (pattern shadowing in
# arms, binding shadowing in stmt blocks) handles those nodes
# explicitly in its own walker and never reaches the helpers below.
# ---------------------------------------------------------------------------
#[doc("--------------------------------------------------------------------------- Shared structural map over ExprKind. Background (Full prerequisite 0.1, see…")]
pub fn map_expr_kind(k: ExprKind, f: (Expr) -> Expr) : ExprKind {
  match k {
    # Leaves: no sub-Expr to recurse into.
    EInt(_, _)        -> k
    EReal(_, _)       -> k
    EIntLit(_)        -> k
    EDecimalLit(_)    -> k
    EFixed(_, _)      -> k
    EBool(_)       -> k
    EChar(_)       -> k
    EStr(_, _)     -> k
    EUnit          -> k
    EName(_)        -> k
    EMark(_)        -> k
    ESym(_, _)     -> k
    ELocal(_)      -> k
    EOp(_)         -> k
    EUnder         -> k
    EPlaceholder   -> k
    EHole(_)       -> k
    ETodo(_)       -> k
    EExternBody(_, _) -> k
    EVariantsOf(_, _) -> k
    EModCall(_, _) -> k
    # Issue #556: intrinsic args ARE sub-Exprs, so the visitor recurs.
    EIntrinsic(name, args_) -> EIntrinsic(name, map(args_, f))
    ESurface(sf) -> ESurface(surface_map(sf, f))
    # Composites: apply f to every direct sub-Expr.
    ECall(callee, args_) -> ECall(f(callee), map(args_, f))
    EField(base, name)   -> EField(f(base), name)
    EIndex(a, b)         -> EIndex(f(a), f(b))
    EBinop(op, a, b)     -> EBinop(op, f(a), f(b))
    EUnop(op, x)         -> EUnop(op, f(x))
    EIf(c, t_, eo)       -> EIf(f(c), f(t_), map_opt_expr(eo, f))
    EMatch(scr, arms)    -> EMatch(f(scr), map(arms, (a) => map_arm_exprs(a, f)))
    ELambda(ps, b)       -> ELambda(ps, f(b))
    ERecordLit(r, fs)    -> ERecordLit(r, map(fs, (fi) => map_field_exprs(fi, f)))
    EList(els)           -> EList(map(els, (el) => map_elem_exprs(el, f)))
    ERange(a, b, opt_step) -> ERange(f(a), f(b), map_opt_expr(opt_step, f))
    EBlock(stmts, tail)  -> EBlock(map(stmts, (s) => map_stmt_exprs(s, f)),
                                    map_opt_expr(tail, f))
    EPipe(a, b)          -> EPipe(f(a), f(b))
    EMapPipe(a, b)       -> EMapPipe(f(a), f(b))
    EFlatMapPipe(a, b)   -> EFlatMapPipe(f(a), f(b))
    EFilterPipe(a, b)    -> EFilterPipe(f(a), f(b))
    EHandle(body, eref, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) ->
      EHandle(f(body), eref, eff_tyargs,
              map_opt_expr(init_opt, f), alias_opt,
              map(clauses, (c) => map_clause_exprs(c, f)),
              map_opt_return_exprs(ret_opt, f))
    ELitUnit(inner, u)   -> ELitUnit(f(inner), u)
    EBang(inner)         -> EBang(f(inner))
  }
}

#[doc("AST-functor map over opt expr.")]
pub fn map_opt_expr(opt: Option[Expr], f: (Expr) -> Expr) : Option[Expr] {
  match opt {
    Some(e) -> Some(f(e))
    None    -> None
  }
}

#[doc("AST-functor map over stmt exprs.")]
pub fn map_stmt_exprs(s: Stmt, f: (Expr) -> Expr) : Stmt {
  match s {
    SLet(p, ann, rhs)           -> SLet(p, ann, f(rhs))
    SAssert(c, m)               -> SAssert(f(c), map_opt_expr(m, f))
    SExprStmt(x)                -> SExprStmt(f(x))
    SIndexAssign(b, i, v, l, c) -> SIndexAssign(f(b), f(i), f(v), l, c)
    SAssign(b, v, l, c) -> SAssign(f(b), f(v), l, c)
    SVar(n, ty, rhs, l, c)      -> SVar(n, ty, f(rhs), l, c)
    # m7e §25: SUse has no sub-expression — pass through unchanged.
    SUse(n, l, c)               -> SUse(n, l, c)
  }
}

#[doc("AST-functor map over arm exprs.")]
pub fn map_arm_exprs(a: Arm, f: (Expr) -> Expr) : Arm {
  match a {
    Arm(p, g, b) -> Arm(p, map_opt_expr(g, f), f(b))
  }
}

#[doc("AST-functor map over field exprs.")]
pub fn map_field_exprs(fi: FieldInit, f: (Expr) -> Expr) : FieldInit {
  match fi {
    FI(n, v) -> FI(n, f(v))
  }
}

#[doc("AST-functor map over elem exprs.")]
pub fn map_elem_exprs(el: ListElem, f: (Expr) -> Expr) : ListElem {
  match el {
    ElPlain(x)  -> ElPlain(f(x))
    ElSpread(x) -> ElSpread(f(x))
  }
}

#[doc("AST-functor map over clause exprs.")]
pub fn map_clause_exprs(c: HClause, f: (Expr) -> Expr) : HClause {
  match c {
    HC(n, ps, b, l, co) -> HC(n, ps, f(b), l, co)
  }
}

#[doc("AST-functor map over opt return exprs.")]
pub fn map_opt_return_exprs(opt: Option[HReturn], f: (Expr) -> Expr) : Option[HReturn] {
  match opt {
    Some(r) -> Some(map_return_exprs(r, f))
    None    -> None
  }
}

#[doc("AST-functor map over return exprs.")]
pub fn map_return_exprs(r: HReturn, f: (Expr) -> Expr) : HReturn {
  match r {
    HR(p, b, l, c) -> HR(p, f(b), l, c)
  }
}

#[doc("Let-alias rewriter over kind.")]
pub fn rewrite_alias_kind(k: ExprKind, m: AliasMap, line: Int, col: Int) : ExprKind {
  match k {
    EField(base, fname) -> match base.kind {
      ELocal(a) -> match alias_map_lookup(m, a) {
        # A `@cap` read always spells `cap.get`: `canonical_cap_getter`
        # gives the op the effect declares for it. The perform goes
        # through the alias's own handler where its id is in scope.
        Some(esym) -> EOp(OpRef { eff: esym, op: written(canonical_cap_getter(esym, fname)),
                                  via: if alias_map_may_tag(m) { ViaAlias(a) } else { ViaAmbient } })
        None -> EField(rewrite_alias_expr(base, m), fname)
      }
      _ -> EField(rewrite_alias_expr(base, m), fname)
    }
    EHandle(body, eref, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) -> {
      let body_m = match alias_opt {
        Some(a) -> alias_map_push(m, a.id, ref_sym(eref))
        None    -> m
      }
      EHandle(rewrite_alias_expr(body, body_m), eref, eff_tyargs,
              map_opt_expr(init_opt, (e) => rewrite_alias_expr(e, m)),
              alias_opt,
              rewrite_alias_clauses(clauses, m),
              rewrite_alias_opt_return(ret_opt, m))
    }
    # Every other kind recurses structurally: adding an ExprKind variant
    # breaks the compiler at `map_expr_kind`'s match instead of leaking
    # through this walker.
    _ -> map_expr_kind(k, (sub) => rewrite_alias_expr(sub, m))
  }
}

#[doc("The C symbol an extern fn binds to: the body's override payload, or the kaikai name when empty.")]
pub fn ffi_extern_symbol_of(body: Expr, default_name: String) : String {
  match body.kind {
    EExternBody(_, over) -> if string_length(over) > 0 { over } else { default_name }
    _ -> default_name
  }
}

# Protocol-dispatch runtime shim (opción C).
#
# A dispatcher fn (`__proto_<op>`) whose body is the tag
# `__kai_proto_dispatch__:<P>:<op>` signals codegen to emit a custom
# C/LLVM body that looks up the impl in the runtime hashmap by
# `(proto_id, head_tag)` and tail-calls it. The dispatcher fn shape
# (params, return type) is unchanged so the typer / monomorphiser see
# a regular polymorphic call.

#[doc("Protocol-dispatch marker decoder: tag prefix.")]
pub fn proto_dispatch_tag_prefix() : String = "__kai_proto_dispatch__:"

#[doc("True if a function body is a single protocol-dispatch marker call.")]
pub fn body_is_proto_dispatch(body: Expr) : Bool {
  proto_dispatch_marker_in(body)
}

# The dispatcher's body starts as a bare `ETodo(marker)`, but Perceus'
# exit-drop wrap can re-shape it into `EBlock([_drop kai_x...], Some(ETodo))`
# before codegen sees it. Walk through the EBlock / EIf / EMatch shells
# the lowering may wrap around the marker and look for the ETodo with
# our prefix on the tail position.

# The dispatcher's body starts as a bare `ETodo(marker)`, but Perceus'
# exit-drop wrap can re-shape it into `EBlock([_drop kai_x...], Some(ETodo))`
# before codegen sees it. Walk through the EBlock / EIf / EMatch shells
# the lowering may wrap around the marker and look for the ETodo with
# our prefix on the tail position.
#[doc("The dispatcher's body starts as a bare `ETodo(marker)`, but Perceus' exit-drop wrap can re-shape it into `EBlock([_drop kai_x...], Some(ETodo))` before codegen sees it. Walk…")]
pub fn proto_dispatch_marker_in(e: Expr) : Bool {
  match e.kind {
    ETodo(msg)             -> string_starts_with_q(msg, proto_dispatch_tag_prefix())
    EBlock(_, Some(tail))  -> proto_dispatch_marker_in(tail)
    _                      -> false
  }
}

#[doc("Decoded protocol-dispatch marker parts (proto name, qualifier).")]
pub type ProtoDispatchParts = PDP(String, String)

# Build the dispatcher body marker: `__kai_proto_dispatch__:<P>:<op>`.

# Parse the marker back into (P, op). Caller must have established
# `body_is_proto_dispatch` first. Walks through Perceus' exit-drop
# wrap (EBlock-with-tail) to reach the underlying ETodo marker.
#[doc("Parse the marker back into (P, op). Caller must have established `body_is_proto_dispatch` first. Walks through Perceus' exit-drop wrap (EBlock-with-tail) to reach the…")]
pub fn proto_dispatch_parts(body: Expr) : ProtoDispatchParts {
  match body.kind {
    ETodo(msg) -> {
      let payload = string_slice(msg, string_length(proto_dispatch_tag_prefix()),
                                  string_length(msg) - string_length(proto_dispatch_tag_prefix()))
      let idx = find_colon(payload, 0)
      let pname = string_slice(payload, 0, idx)
      let opname = string_slice(payload, idx + 1, string_length(payload) - (idx + 1))
      PDP(pname, opname)
    }
    EBlock(_, Some(tail)) -> proto_dispatch_parts(tail)
    _                     -> PDP("?", "?")
  }
}

# Find the first ':' starting at `from`. Returns string length if not
# found. The dispatcher marker always contains exactly one ':' so this
# helper is sufficient (no escaping concerns).

# Find the first ':' starting at `from`. Returns string length if not
# found. The dispatcher marker always contains exactly one ':' so this
# helper is sufficient (no escaping concerns).
#[doc("Find the first ':' starting at `from`. Returns string length if not found. The dispatcher marker always contains exactly one ':' so this helper is sufficient (no escaping…")]
pub fn find_colon(s: String, from: Int) : Int {
  let n = string_length(s)
  if from >= n { n }
  else {
    match char_at(s, from) {
      Some(c) -> if c == ':' { from } else { find_colon(s, from + 1) }
      None    -> n
    }
  }
}

#[doc("Render each Ty of a list; `tab` names the nominal types.")]
pub fn ty_string_list(tab: SymTab, ts: [Ty]) : [String] = map(ts, (t) => ty_to_string(tab, t))

#[doc("Render a Ty to its display string (shared by the emitters and the dump queries); `tab` names the nominal types.")]
pub fn ty_to_string(tab: SymTab, t: Ty) : String {
  match t {
    TyInt    -> "Int"
    TyReal   -> "Real"
    TyBool   -> "Bool"
    TyString -> "String"
    TyChar   -> "Char"
    TyUnit   -> "Unit"
    TyByte     -> "Byte"
    TyInt32    -> "Int32"
    TyUInt32   -> "UInt32"
    TyUInt64   -> "UInt64"
    TyInt128   -> "Int128"
    TyHandle   -> "Handle"
    TyListT(inner) -> cat3("[", ty_to_string(tab, inner), "]")
    # m7b #11k: render the function type's effect row alongside the
    # arrow when non-empty, with each label printed as `Eff` or
    # `Eff[T1, T2]` so parametric-effect mismatches (Reader[Int] vs
    # Reader[String]) are visible in `expected/found` notes.
    TyFnT(ps, ret, row) -> concat_all([
      "(", join_with(ty_string_list(tab, ps), ", "), ") -> ",
      ty_to_string(tab, ret),
      row_to_string_suffix(tab, row)
    ])
    TyCon(s, tas) -> {
      let cname = written_text(decl_name(tab, s))
      match tas {
        [] -> cname
        _ -> concat_all([cname, "[", join_with(ty_string_list(tab, tas), ", "), "]"])
      }
    }
    TyVarT(n) -> cat2("?t", int_to_string(n))
    TyShapeApp(sv, arg) -> concat_all(["?s", int_to_string(sv), "[", ty_to_string(tab, arg), "]"])
    TyAny -> "?"
    # m12.5: render dimensioned base types as `Real<u>` / `Int<u>`.
    # The unit goes through unit_canon so the printed form matches
    # what the unifier compares against — same shape on every side.
    TyDimT(base, u) -> concat_all([ty_to_string(tab, base), "<", unit_canon_display(u), ">"])
    # m12.6.x #1: render `T where ...` for diagnostics. The predicate
    # is left as `<pred>` to keep the line short; full predicate text
    # lands with the diagnostics-quality pass (m12.6.x #8).
    TyRefineT(base, _) -> concat_all([ty_to_string(tab, base), " where <pred>"])
    # issue #187 phase 1: render unions inline as `A | B | C` to match
    # surface syntax. Components are already in canonical order when
    # the walker receives them via `normalize_union`.
    TyUnion(parts) -> join_with(ty_string_list(tab, parts), " | ")
  }
}

# m12.5: render a UnitExprT in canonical form for diagnostics. Sorts
# symbols alphabetically and groups powers, so `kg * m` and `m * kg`
# render identically.

# m12.5: render a UnitExprT in canonical form for diagnostics. Sorts
# symbols alphabetically and groups powers, so `kg * m` and `m * kg`
# render identically.
#[doc("render a UnitExprT in canonical form for diagnostics. Sorts symbols alphabetically and groups powers, so `kg * m` and `m * kg` render identically.")]
pub fn unit_canon_display(u: UnitExprT) : String = unit_text(unit_canon(u))

# m12.8.x phase 2 (Gap 1, partial): extract the canonical unit symbol
# of a dimensioned type for the `unit_name` compile-time intrinsic.
# Bare types and unresolved unit-vars yield the empty string so the
# emitter never produces an LLVM/C error from a missing dimension.

# m12.8.x phase 2 (Gap 1, partial): extract the canonical unit symbol
# of a dimensioned type for the `unit_name` compile-time intrinsic.
# Bare types and unresolved unit-vars yield the empty string so the
# emitter never produces an LLVM/C error from a missing dimension.
#[doc("x phase 2 (Gap 1, partial): extract the canonical unit symbol of a dimensioned type for the `unit_name` compile-time intrinsic. Bare types and unresolved unit-vars yield the…")]
pub fn unit_name_of_ty(ot: Option[Ty]) : String {
  match ot {
    Some(t) -> match t {
      TyDimT(_, u) -> match unit_canon(u) {
        UVar(_) -> ""
        UOne    -> ""
        cu      -> unit_text(cu)
      }
      _ -> ""
    }
    None -> ""
  }
}

# m4c #2 — name-mangling helpers for monomorphisation.
#
# `mangle_name(name, [Ty]) : String` produces a deterministic,
# C-identifier-safe name for a polymorphic decl instantiated at a
# concrete type tuple. The empty tuple maps back to `name` (no
# instantiation, e.g. fully monomorphic decls). For non-empty tuples
# the form is `name__mono__T1[__T2...]`, with each `Tn` rendered by
# `mangle_ty` using bracketed sentinels (`L_..._E` for lists,
# `_O_..._C` for type-constructor argument lists, `F_..._R_..._E`
# for function arrows). The sentinels make the encoding unambiguous:
# `Foo[Bar]` and a hypothetical user fn named `Foo_Bar` cannot
# collide. Effects are erased — two instantiations that differ only
# in the row of an inner `TyFnT` mangle the same, by design (Perceus
# operates on values, not on rows).
#
# The mangler errors implicitly on `TyVarT` / `TyAny`: a resolved
# call-site tuple should not contain unresolved variables. If one
# slips through the renderer emits `TVAR` / `Any` and the resulting
# duplicate is caught by the m4c #3 collision check.

# Render a Row as the ` / Eff1 + Eff2` suffix used in fn-type
# strings. Empty row → empty string. Open row tail → trailing
# `+ ?eN`. Each label uses `label_to_string` so type args render.
#[doc("Render a Row as the ` / Eff1 + Eff2` suffix used in fn-type strings. Empty row → empty string. Open row tail → trailing `+ ?eN`. Each label uses `label_to_string` so type args…")]
pub fn row_to_string_suffix(tab: SymTab, r: Row) : String {
  # Issue #645: a row with no labels is treated as "pure" in display
  # form, whether its tail is None (truly closed empty) or Some(_)
  # (a free row var with no demand on it — the phantom that
  # `fn_scheme_of_decl` inserts for REmpty signatures, or any fresh
  # row var introduced by instantiation and never constrained). The
  # tail variable is internal bookkeeping; showing `?eN` to users
  # mis-suggests they need to annotate the function. Diagnostics for
  # actual row mismatches still print the `expected` and `found`
  # rows in full (those rows carry labels by the time the mismatch
  # is reported).
  let body =
    if labels_empty(r.labels) {
      ""
    } else {
      let lbs = join_with(map(r.labels, (l) => label_to_string(tab, l)), " + ")
      let tail_s = match r.tail {
        None -> ""
        Some(v) -> {
          let pre = if string_length(lbs) > 0 { " + " } else { "" }
          concat_all([pre, "?e", int_to_string(v)])
        }
      }
      concat_all([" / ", lbs, tail_s])
    }
  body
}

# Dump the declared signature (or shape) of every top-level decl. Used
# by `--types`; does not attempt to infer bodies, just surfaces what
# the user wrote.

# ====================================================================
# downward glue mirrors (es_ prefix) — originals in main head/driver

# The effects a row's labels name. A label still written names no effect
# (a row alias), and a parametric effect is one effect whatever it is
# applied to.
fn es_row_label_syms(labels: [RowLabel]) : [SymId] = match labels {
  []           -> []
  [l, ...rest] ->
    if sym_raw(rl_sym(l)) >= 0 { [rl_sym(l), ...es_row_label_syms(rest)] }
    else { es_row_label_syms(rest) }
}
