#[doc("""
The unboxing pass: representation modes for every expression of the monomorphised program, and the walk that assigns them.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.symtab
import compiler.spec_names
import compiler.fnreg
import compiler.fn_index
import compiler.kinds
import compiler.loop_lower
import compiler.operators
import compiler.unbox
import compiler.handler_alias

#
# Sits between monomorphisation and perceus_pass. Walks every
# top-level fn / test body and rewrites each `Expr.mode` from the
# parser default (`MUnknown`) to either `MBoxed` (the current
# everywhere behaviour) or `MUnboxed` (raw C scalar — `int64_t`
# for `Int`, `int` for `Bool`, `uint32_t` for `Char`).
#
# The pass is local: it does not propagate across fn boundaries.
# Function parameters and return values stay `MBoxed` per
# Phase 2 non-goal #1; the call boundary is the cheapest place
# to keep boxed.
#
# M3 (this commit): activates the analysis for `let x = <int-arith>`
# style expressions. Local `let` bindings whose RHS is a numeric
# `Int` arithmetic tree (`+ - * / // % ^`) collapse to raw
# `int64_t` storage; subsequent reads stay raw inside other
# arithmetic, and box at the call/return boundary. The emitter's
# manual box/unbox dance for the bit-ops intrinsics
# (`emit_call_value` lines ~7920–8060) collapses naturally because
# the operands now carry `MUnboxed` straight through.
#
# Subsequent milestones extend the analysis to comparisons, EIf
# cond, and match scrutinees.
pub(pkg) fn unbox_pass(decls: [Decl], tab: SymTab, specs: SpecNames, cis: CtorIntIx, nat: Bool, entry: SymId) : [Decl] / Console = {
  let fx = fnx_with_raw_prims(fnx_with_effects(fnx_build(register_fn_decls(decls, tab, specs, entry)), decls))
  let fns = if nat { fnx_with_vec_raw(fx, decls) } else { fx }
  map(decls, (d) => unbox_decl(d, fns, cis, nat))
}

fn unbox_decl(d: Decl, fns: FnIndex, cis: CtorIntIx, nat: Bool) : Decl / Console {

  match d {
    DFn(is_pub, fsym, tparams, params, opt_ret, row, body, ln, cl, mo) -> {
      # Phase 3 unboxing: when this DFn is itself a UFn, seed the
      # local-binding env with each parameter marked MUnboxed so
      # reads of the param in the body resolve to the raw alias
      # `kair_<pname>` (planted by emit_fn_body) instead of the
      # boxed `kai_<pname>`. The body's tail return inherits its
      # mode from the body itself; emit_fn_body emits the raw
      # `return <raw>;` form when the fn is UFn.
      let env0 = match fnx_decl_sig(fns, fsym) {
        Some(US(_, _, mask)) -> ufn_param_env(params, mask, [])
        None    -> []
      }
      let body1 = unbox_expr_aware(body, env0, fns, cis, nat)
      DFn(is_pub, fsym, tparams, params, opt_ret, row, body1, ln, cl, mo)
    }
    DTest(desc, body, ln, cl, mo) -> DTest(desc, unbox_expr_aware(body, [], fns, cis, nat), ln, cl, mo)
    DBench(desc, body, ln, cl, mo) -> DBench(desc, unbox_expr_aware(body, [], fns, cis, nat), ln, cl, mo)
    DCheck(desc, ps, body, ln, cl, mo) -> DCheck(desc, ps, unbox_expr_aware(body, [], fns, cis, nat), ln, cl, mo)
    DImpl(name, proto_args, ty, sub_decls, l, c, tps, isym) ->
      DImpl(name, proto_args, ty, map(sub_decls, (sd) => unbox_decl(sd, fns, cis, nat)), l, c, tps, isym)
    DDerive(ps, inner, l, c) -> DDerive(ps, unbox_decl(inner, fns, cis, nat), l, c)
    DUnstable(inner, l, c) -> DUnstable(unbox_decl(inner, fns, cis, nat), l, c)
    DProtoLaws(thy, inner, l, c, mo) -> DProtoLaws(thy, unbox_decl(inner, fns, cis, nat), l, c, mo)
    DImplAxiom(thy, inner, l, c, mo) -> DImplAxiom(thy, unbox_decl(inner, fns, cis, nat), l, c, mo)
    DConstructor(inner, l, c) -> DConstructor(unbox_decl(inner, fns, cis, nat), l, c)
    _ -> d
  }
}

fn unbox_expr_aware(e: Expr, env: [LocBind], fns: FnIndex, cis: CtorIntIx, nat: Bool) : Expr / Console {

  let kind1 = unbox_kind_aware(e.kind, env, fns, cis, nat)
  let mode1 = decide_mode_aware(kind1, e.ty, env, fns)
  Expr { kind: kind1, line: e.line, col: e.col, ty: e.ty, mode: mode1,  site: e.site }
}

fn unbox_kind_aware(k: ExprKind, env: [LocBind], fns: FnIndex, cis: CtorIntIx, nat: Bool) : ExprKind / Console {

  match k {
    EInt(_, _)        -> k
    EReal(_, _)       -> k
    EIntLit(_)        -> k
    EDecimalLit(_)    -> k
    EFixed(_, _)      -> k
    EBool(_)       -> k
    EChar(_)       -> k
    EStr(_, _)     -> k
    EUnit          -> k
    EName(_)       -> k
    EMark(_)       -> k
    ESym(_, _)     -> k
    ELocal(_)      -> k
    EOp(_)         -> k
    EUnder         -> k
    EPlaceholder   -> k
    EHole(_)       -> k
    ETodo(_)       -> k
    EExternBody(_, _) -> k
    EVariantsOf(_, _) -> k
    EModCall(_, _) -> k
    EIntrinsic(name, args_) ->
      EIntrinsic(name, map(args_, (a) => if is_loop_intrinsic(name) and not nat { unbox_loop_arg(a, env, fns, cis) } else { unbox_expr_aware(a, env, fns, cis, nat) }))
    ESurface(sf) -> ESurface(surface_rebuild(sf, map(surface_children(sf), (a) => unbox_expr_aware(a, env, fns, cis, nat))))
    ECall(callee, args_) -> ECall(unbox_expr_aware(callee, env, fns, cis, nat),
                                   map(args_, (a) => unbox_expr_aware(a, env, fns, cis, nat)))
    EField(base, name)   -> EField(unbox_expr_aware(base, env, fns, cis, nat), name)
    EIndex(a, b)         -> EIndex(unbox_expr_aware(a, env, fns, cis, nat), unbox_expr_aware(b, env, fns, cis, nat))
    EBinop(op, a, b)     -> EBinop(op, unbox_expr_aware(a, env, fns, cis, nat), unbox_expr_aware(b, env, fns, cis, nat))
    EUnop(op, x)         -> EUnop(op, unbox_expr_aware(x, env, fns, cis, nat))
    EIf(c, t_, eo)       -> EIf(unbox_expr_aware(c, env, fns, cis, nat), unbox_expr_aware(t_, env, fns, cis, nat),
                                 unbox_opt_aware(eo, env, fns, cis, nat))
    EMatch(scr, arms)    -> {
      # Issue #91 — PBind catch-all in the M5 fast path. When the
      # scrutinee unboxes to a raw integral scalar, the emitter will
      # take the `switch` fast path. A `PBind(name)` catch-all in
      # that path stores the raw scrutinee as `kair_<name>`, so the
      # body's reads of that binder must be marked MUnboxed here —
      # otherwise `decide_mode_aware` falls back to MBoxed and the emit
      # routes to a non-existent `kai_<name>`. Other arms (and
      # boxed-scrut matches) keep the outer env unchanged.
      let scr1 = unbox_expr_aware(scr, env, fns, cis, nat)
      let raw_scr = ty_is_unboxable(scr1.ty) and ty_is_integral_raw(scr1.ty) and (match scr1.mode { MUnboxed -> true _ -> false })
      EMatch(scr1,
             map(arms, (a) => unbox_arm_with_scr_aware(a, env, raw_scr, fns, cis, nat)))
    }
    # Closure boundary: free vars captured into the closure record
    # are always boxed (per Phase 2 non-goal table). The lambda's
    # own body sees no caller env — its locals are independent.
    ELambda(ps, b)       -> ELambda(ps, unbox_expr_aware(b, [], fns, cis, nat))
    ERecordLit(rh, fs)   -> ERecordLit(rh, map(fs, (fi) => unbox_field_aware(fi, env, fns, cis, nat)))
    EList(els)           -> EList(map(els, (el) => unbox_elem_aware(el, env, fns, cis, nat)))
    ERange(a, b, opt_step) -> ERange(unbox_expr_aware(a, env, fns, cis, nat), unbox_expr_aware(b, env, fns, cis, nat),
                                       unbox_opt_aware(opt_step, env, fns, cis, nat))
    EBlock(stmts, tail)  -> {
      let r = unbox_stmts_aware(stmts, tail, env, [], fns, cis, nat)
      let stmts1 = match r { UbStmts(ss, _) -> ss }
      let env1   = match r { UbStmts(_, e1) -> e1 }
      EBlock(stmts1, unbox_opt_aware(tail, env1, fns, cis, nat))
    }
    EPipe(a, b)          -> EPipe(unbox_expr_aware(a, env, fns, cis, nat), unbox_expr_aware(b, env, fns, cis, nat))
    EDispatchPipe(op, a, b) -> EDispatchPipe(op, unbox_expr_aware(a, env, fns, cis, nat), unbox_expr_aware(b, env, fns, cis, nat))
    EHandle(body, eff, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) ->
      # The handled body opens a fresh dynamic scope for the effect
      # capability. v1 walks it with the outer env (no bindings
      # leak into the handler's continuation captures).
      EHandle(unbox_expr_aware(body, env, fns, cis, nat), eff, eff_tyargs,
              unbox_opt_aware(init_opt, env, fns, cis, nat), alias_opt,
              map(clauses, (c) => unbox_clause_aware(c, init_opt, env, fns, cis, nat)),
              unbox_opt_return_aware(ret_opt, env, fns, cis, nat))
    ELitUnit(inner, u)   -> ELitUnit(unbox_expr_aware(inner, env, fns, cis, nat), u)
    EBang(inner)         -> EBang(unbox_expr_aware(inner, env, fns, cis, nat))
  }
}

# A loop's condition and body run in place, so they read the raw binders of the enclosing scope.
fn unbox_loop_arg(a: Expr, env: [LocBind], fns: FnIndex, cis: CtorIntIx) : Expr / Console = match a.kind {
  ELambda(ps, b) -> {
    let raw_env = filter(env, (lb) => match lb { LB(_, MUnboxed) -> true  _ -> false })
    Expr { kind: ELambda(ps, unbox_expr_aware(b, raw_env, fns, cis, false)), line: a.line, col: a.col, ty: a.ty, mode: a.mode, site: a.site }
  }
  _ -> unbox_expr_aware(a, env, fns, cis, false)
}

fn unbox_opt_aware(opt: Option[Expr], env: [LocBind], fns: FnIndex, cis: CtorIntIx, nat: Bool) : Option[Expr] / Console {

  match opt {
    Some(e) -> Some(unbox_expr_aware(e, env, fns, cis, nat))
    None    -> None
  }
}

fn unbox_arm_with_scr_aware(a: Arm, env: [LocBind], raw_scr: Bool, fns: FnIndex, cis: CtorIntIx, nat: Bool) : Arm / Console {

  match a {
    Arm(p, g, b) -> {
      let env_b = match p.pkind {
        PBind(nm) -> {
          if raw_scr and not expr_captures(b, nm) {
            [LB(nm.id, MUnboxed), ...env]
          } else { env }
        }
        # i64-inline (Lane B): a variant pattern whose sub-PBind binders
        # read kind-1 Int slots. Seed each such binder MUnboxed so its
        # reads resolve to the raw `kair_<nm>` alias the emitter
        # plants for a kind-1 slot — no kai_int/kai_take_int round-trip.
        # The SAME interp / lambda-capture guards as the scalar PBind
        # case apply: a `#{nm}` interp slot or a captured lambda body
        # bypasses this pass's alias map, so those binders must stay
        # boxed. The seeding is recursive: a nested PVariant sub-pattern
        # carries its own kind-1 binders (rb-tree balance rotation shape).
        PVariant(ctor, subs) -> seed_variant_int_binders(ctor, subs, b, cis, nat, env, fns)
        _ -> env
      }
      Arm(p, unbox_opt_aware(g, env, fns, cis, nat), unbox_expr_aware(b, env_b, fns, cis, nat))
    }
  }
}

fn unbox_field_aware(fi: FieldInit, env: [LocBind], fns: FnIndex, cis: CtorIntIx, nat: Bool) : FieldInit / Console {

  match fi {
    FI(n, v) -> FI(n, unbox_expr_aware(v, env, fns, cis, nat))
  }
}

fn unbox_elem_aware(el: ListElem, env: [LocBind], fns: FnIndex, cis: CtorIntIx, nat: Bool) : ListElem / Console {

  match el {
    ElPlain(x)  -> ElPlain(unbox_expr_aware(x, env, fns, cis, nat))
    ElSpread(x) -> ElSpread(unbox_expr_aware(x, env, fns, cis, nat))
  }
}

fn unbox_clause_aware(c: HClause, init_opt: Option[Expr], env: [LocBind], fns: FnIndex, cis: CtorIntIx, nat: Bool) : HClause / Console {

  match c {
    HC(n, ps, b, l, co) -> {
      let lent = list_append(map(clause_lent_names(ps, init_opt), (nm) => LBLent(nm)), env)
      HC(n, ps, unbox_expr_aware(b, lent, fns, cis, nat), l, co)
    }
  }
}

fn unbox_opt_return_aware(opt: Option[HReturn], env: [LocBind], fns: FnIndex, cis: CtorIntIx, nat: Bool) : Option[HReturn] / Console {
  match opt {
    Some(r) -> Some(unbox_return_aware(r, env, fns, cis, nat))
    None    -> None
  }
}

fn unbox_return_aware(r: HReturn, env: [LocBind], fns: FnIndex, cis: CtorIntIx, nat: Bool) : HReturn / Console {

  match r {
    HR(p, b, l, c) -> HR(p, unbox_expr_aware(b, env, fns, cis, nat), l, c)
  }
}

type UbStmts = UbStmts([Stmt], [LocBind])

fn unbox_stmts_aware(stmts: [Stmt], tail: Option[Expr], env: [LocBind], acc: [Stmt], fns: FnIndex, cis: CtorIntIx, nat: Bool) : UbStmts / Console {

  match stmts {
    [] -> UbStmts(list_reverse(acc), env)
    [s, ...rest] -> {
      let r = unbox_stmt_aware(s, rest, tail, env, fns, cis, nat)
      let s1 = match r { UbStmt(s_, _) -> s_ }
      let e1 = match r { UbStmt(_, ev) -> ev }
      unbox_stmts_aware(rest, tail, e1, [s1, ...acc], fns, cis, nat)
    }
  }
}

type UbStmt = UbStmt(Stmt, [LocBind])

fn unbox_stmt_aware(s: Stmt, rest: [Stmt], tail: Option[Expr], env: [LocBind], fns: FnIndex, cis: CtorIntIx, nat: Bool) : UbStmt / Console {

  match s {
    SLet(pat, ann, rhs) -> {
      let rhs1 = unbox_expr_aware(rhs, env, fns, cis, nat)
      match pat.pkind {
        PBind(nm) -> match rhs1.mode {
          MUnboxed -> if stmt_rhs_is_cell_init(rhs1) {
            # A promoted var cell never demotes: its reads/writes ride
            # the `__cell_*` intrinsics (no read of `nm` exists for the
            # capture/interp scans to find), and the emitters declare it
            # as a raw mutable local.
            UbStmt(SLet(pat, ann, rhs1), [LB(nm.id, MUnboxed), ...env])
          } else {
            # Closure capture stays boxed (Phase 2 non-goal table:
            # `Closure capture (ELambda free var) → boxed`). If `nm`
            # is referenced from within any subsequent ELambda, the
            # capture array would expect `kai_<nm>` and find a raw
            # `int64_t` — break the boxed convention. Demote to
            # MBoxed so the binding lives as `KaiValue *kai_<nm>`
            # and the unbox/wrap happens at the read site.
            if name_captured_in_block(rest, tail, nm, not nat) {
              let rhs_box = expr_to_boxed(rhs1)
              UbStmt(SLet(pat, ann, rhs_box), env)
            }
            else {
              UbStmt(SLet(pat, ann, rhs1), [LB(nm.id, MUnboxed), ...env])
            }
          }
          _ -> if let_rhs_unboxes_at_binding(rhs1, nat) and not name_captured_in_block(rest, tail, nm, not nat) {
            UbStmt(SLet(pat, ann, expr_to_unboxed(rhs1)), [LB(nm.id, MUnboxed), ...env])
          } else {
            UbStmt(SLet(pat, ann, rhs1), env)
          }
        }
        PVariant(ctor, subs) ->
          UbStmt(SLet(pat, ann, rhs1), seed_variant_int_binders(ctor, subs, let_scope(rhs, rest, tail), cis, nat, env, fns))
        _ -> UbStmt(SLet(pat, ann, rhs1), env)
      }
    }
    SVar(n, ty, rhs, l, c) -> UbStmt(SVar(n, ty, unbox_expr_aware(rhs, env, fns, cis, nat), l, c), env)
    SAssert(cond, m) -> UbStmt(SAssert(unbox_expr_aware(cond, env, fns, cis, nat), unbox_opt_aware(m, env, fns, cis, nat)), env)
    SExprStmt(x) -> UbStmt(SExprStmt(unbox_expr_aware(x, env, fns, cis, nat)), env)
    SIndexAssign(b, i, v, l, c) ->
      UbStmt(SIndexAssign(unbox_expr_aware(b, env, fns, cis, nat), unbox_expr_aware(i, env, fns, cis, nat),
                          unbox_expr_aware(v, env, fns, cis, nat), l, c), env)
    SAssign(b, v, l, c) ->
      UbStmt(SAssign(unbox_expr_aware(b, env, fns, cis, nat),
                      unbox_expr_aware(v, env, fns, cis, nat), l, c), env)
    SUse(n, l, c) -> UbStmt(SUse(n, l, c), env)
  }
}

fn stmt_rhs_is_cell_init(e: Expr) : Bool = match e.kind {
  EIntrinsic(InCellInit, _) -> true
  _ -> false
}

# A boxed scalar-typed computation a `let` binds: the binding takes the box and
# keeps the raw payload, so later arithmetic on the binder stays raw. The native
# lowering has no matching drop for the taken box, so only C binds it raw.
fn let_rhs_unboxes_at_binding(rhs: Expr, nat: Bool) : Bool =
  not nat and ty_is_unboxable(rhs.ty) and not ty_is_fixed_vec_opt(rhs.ty) and match rhs.kind {
    ECall(_, _) -> true
    EBinop(op, _, _) -> binop_eq(op, BoAdd) or binop_eq(op, BoSub) or binop_eq(op, BoMul)
    _ -> false
  }

fn expr_to_unboxed(e: Expr) : Expr =
  Expr { kind: e.kind, line: e.line, col: e.col, ty: e.ty, mode: MUnboxed, site: e.site }

# Demote an Expr's outer mode to MBoxed. Children retain their own
# modes — emit_expr handles the boundary wrap on the way down.
fn expr_to_boxed(e: Expr) : Expr =
  Expr { kind: e.kind, line: e.line, col: e.col, ty: e.ty, mode: MBoxed,  site: e.site }
