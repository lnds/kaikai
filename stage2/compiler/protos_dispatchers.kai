#[doc("""
One dispatcher function per protocol operation, named by label and
arity, and the same operations as the resolver's last rung.
""")]

import compiler.ast
import compiler.written
import compiler.symtab
import compiler.util
import compiler.proto_ids
import compiler.decl_names
import compiler.resolve_callee
import compiler.tbinder
import compiler.tparam_uses
import compiler.protos_names
import compiler.protos_registry

#[doc("""
Generate one stub-dispatcher DFn per protocol op so the resolver
and typer can treat `op(x, ...)` as a regular polymorphic call.
The body panics; the post-inference rewrite redirects every reach-
able call to the matching `__pimpl_*` function.

Issue #597 boundary tagging: each dispatcher inherits the home
module of the originating DProtocol via `reg.origins`. Root-file
protocols still resolve to `mo = None`, so root-file selfhost
stays byte-identical. Core protocols (the common case in
`stdlib/protocols.kai`) now produce dispatchers tagged with the
core's basename so a cache loader can partition post-cascade
decls back into their original core/user segments.
""")]
pub fn generate_dispatchers(reg: ProtocolReg, tab: SymTab) : DispGen =
  generate_dispatchers_loop(reg.ops, reg.tparams, op_arities_from_ops(reg.ops), tab, reg.root,
                            DispGen { decls: [], ids: pid_empty(), rows: [] })

#[doc("""
The dispatchers, the id table that records each one as it is minted,
and the table row of each.
""")]
pub type DispGen = { decls: [Decl], ids: ProtoIds, rows: [NEnt] }

fn generate_dispatchers_loop(ops: [ProtoOpReg], ptps: [ProtoTPReg], arities: [OpAr], tab: SymTab, root: String,
                                acc: DispGen) : DispGen {
  match ops {
    [] -> acc
    [op, ...rest] -> match op {
      POR(psym, oplbl, params, ret, line, col, mo, op_tps) -> {
        let opname = written_text(oplbl)
        let tps = dispatcher_tparams(psym, proto_scope_tparams(ptps, psym), op_tps, params, ret)
        # An arity-ambiguous op (`f/1` + `f/2`) yields two dispatcher
        # names, so both survive. One dispatcher per (name, home): every
        # protocol of a home declaring the op at that arity shares it,
        # and two modules declaring it each get their own, so a call
        # narrows by receiver among distinct signatures.
        let disp = proto_dispatcher_name_at(arities, opname, list_length(params))
        let dsym = pid_fn_id(disp, mo, root)
        let already = pid_is_disp(acc.ids, dsym)
        let ids = pid_note_disp(acc.ids, disp, opname, mo, list_length(params), psym, root)
        if already { generate_dispatchers_loop(rest, ptps, arities, tab, root, DispGen { decls: acc.decls, ids: ids, rows: acc.rows }) }
        else {
          let pname = written_text(sym_name(tab, psym))
          let stub = make_dispatcher_fn(pname, opname, dsym, tps, params, ret, line, col, mo)
          let open = DispGen { decls: [stub, ...acc.decls], ids: ids,
                               rows: [NEnt(NCFn, disp, proto_home_name(mo, root), true, NmDispatcher), ...acc.rows] }
          generate_dispatchers_loop(rest, ptps, arities, tab, root, with_homed_twin(open, pname, opname, disp, tps, params, ret, line, col, mo, root))
        }
      }
    }
  }
}

# A module's dispatcher gains its homed twin: the same stub under a name
# of its own, which only that module's protocols answer. The root file
# has none: nothing names its dispatchers through a home.
fn with_homed_twin(g: DispGen, pname: String, opname: String, disp: String, tps: [TBinder], params: [Param], ret: TypeExpr,
                   line: Int, col: Int, mo: Option[String], root: String) : DispGen = match mo {
  None    -> g
  Some(_) -> {
    let twin = proto_homed_name(disp)
    let stub = make_dispatcher_fn(pname, opname, pid_fn_id(twin, mo, root), tps, params, ret, line, col, mo)
    DispGen { decls: [stub, ...g.decls], ids: pid_note_homed(g.ids, disp, twin, mo, root),
              rows: [NEnt(NCFn, twin, proto_home_name(mo, root), true, NmDispatcher), ...g.rows] }
  }
}

# The name a dispatcher's homed twin is declared with: the dispatcher's,
# under a prefix of its own.
fn proto_homed_name(disp: String) : String = concat_all(["__homed", disp])

# `dsym` is the dispatcher's id, derived from its arity-resolved name
# (which may carry an `__a<N>` suffix); `opname` is the original op name,
# kept for the dispatch tag so the post-inference rewrite and emit
# resolve the impl by the protocol's true op name.
fn make_dispatcher_fn(pname: String, opname: String, dsym: SymId, tps: [TBinder],
                       params: [Param], ret: TypeExpr, line: Int, col: Int,
                       mo: Option[String]) : Decl {
  let body = make_dispatcher_body(pname, opname, ret, line, col)
  DFn(true, fnid_decl(dsym), tps, params, Some(ret),
      REmpty, body, line, col, mo)
}

# A dispatcher is generic over everything its operation's signature
# mentions: `Self`, the protocol's parameters and the operation's own,
# in the order the signature first uses them. Each ranges over types
# there, whatever kind the protocol gave it, and none is rigid.
fn dispatcher_tparams(psym: SymId, proto_tps: [TBinder], op_tps: [TBinder],
                      params: [Param], ret: TypeExpr) : [TBinder] = {
  let self_b = TBinder { id: tlocal_self(psym), name: written("Self"), kind: KType, bounds: [], implicit: true }
  let scope = [self_b, ...list_append(proto_tps, op_tps)]
  list_append(map(sig_used_binders(scope, params, Some(ret), REmpty),
                  (b) => TBinder { id: b.id, name: b.name, kind: KType, bounds: [], implicit: true }),
              filter(op_tps, tb_is_row))
}

# Synthesises an `ETodo` body tagged `__kai_proto_dispatch__:<P>:<op>`.
# The typer keeps treating the dispatcher as a regular polymorphic fn
# (ETodo is the same magic shape `body_is_ffi_extern` uses for FFI
# shims). When the C / LLVM emit
# encounters this body, it generates a runtime-dispatch shim that
# looks up the matching `__pimpl_*` in the impl-table by
# `(proto_id, head_tag(self))` and tail-calls it — option C from
# `docs/protocols.md`. Post-inference rewrite still redirects every
# monomorphic call site directly to `__pimpl_<P>_<T>_<op>`, so the
# runtime lookup only runs when the type stays polymorphic past mono
# (e.g. inside the body of `impl[T : Show] Show for [T]`).
fn make_dispatcher_body(pname: String, opname: String, ret: TypeExpr,
                          line: Int, col: Int) : Expr =
  proto_mk_dispatch_body(pname, opname, line, col)

#[doc("A protocol operation's (name, arity): what names its dispatcher.")]
pub type OpAr = OpAr(String, Int)

#[doc("The protocol rung of the resolver's ladder: each operation the registry holds, with its arity, its dispatcher, its protocol's home and whether that protocol is exported.")]
pub fn proto_rungs(reg: ProtocolReg) : [ProtoRung] = {
  let ars = op_arities_from_ops(reg.ops)
  map(reg.ops, (op) => match op {
    POR(psym, name, params, _, _, _, mo, _) -> {
      let n = list_length(params)
      let label = written_text(name)
      ProtoRung(label, n, proto_dispatcher_name_at(ars, label, n), mo, psc_is_pub(reg.origins, psym))
    }
  })
}

#[doc("Project the registry's protocol ops into their (name, arity) pairs.")]
pub fn op_arities_from_ops(ops: [ProtoOpReg]) : [OpAr] {
  match ops {
    [] -> []
    [op, ...rest] -> match op {
      POR(_, name, params, _, _, _, _, _) ->
        [OpAr(written_text(name), list_length(params)), ...op_arities_from_ops(rest)]
    }
  }
}

# True when `target` is declared by two protocols at DIFFERENT arities
# (`P { f(x) }` + `Q { f(a, b) }`). A single `__proto_f` dispatcher
# cannot carry two incompatible signatures, so the rename + dispatcher
# generation switch to arity-suffixed names (`__proto_f__a1`) for such
# a name. Same-arity collisions (the common case — `Ring.add` vs
# `Add.add`, both arity 2) keep the unsuffixed `__proto_<op>` and the
# runtime impl-table disambiguates by `head_tag(self)`.
fn op_name_arity_ambiguous(arities: [OpAr], target: String) : Bool =
  op_name_arity_ambiguous_loop(arities, target, -1)

fn op_name_arity_ambiguous_loop(arities: [OpAr], target: String,
                                  seen: Int) : Bool {
  match arities {
    [] -> false
    [a, ...rest] -> match a {
      OpAr(name, ar) ->
        if name == target {
          if seen >= 0 and ar != seen { true }
          else { op_name_arity_ambiguous_loop(rest, target, ar) }
        } else {
          op_name_arity_ambiguous_loop(rest, target, seen)
        }
    }
  }
}

# Dispatcher name for an op call resolved at a known arity. Unsuffixed
# `__proto_<op>` unless the name is arity-ambiguous, in which case the
# arity is appended so the two protocols' ops land on distinct
# dispatchers. Keeping the unsuffixed form for the common case is what
# preserves the selfhost byte-id.
fn proto_dispatcher_name_at(arities: [OpAr], op: String, arity: Int) : String {
  if op_name_arity_ambiguous(arities, op) {
    concat_all(["__proto_", op, "__a", int_to_string(arity)])
  } else {
    proto_dispatcher_name(op)
  }
}
