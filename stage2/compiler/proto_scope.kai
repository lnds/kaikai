# compiler/proto_scope.kai — module scoping for protocol names.
#
# `protocol P` is not a package-global name. The registry collects
# every protocol over the flattened decl stream of every module, so
# consulting it by name alone lets whichever protocol was declared
# first answer for the whole package — including inside a module that
# declares its own `P` and never imports the first one. With two
# same-named protocols of different signatures, an impl would be
# validated against a contract its module cannot even see.
#
# Resolution mirrors `ta_scope` (transparent aliases): a module sees
# its own protocols first, then the exported ones of other modules.
# Root-file protocols are visible package-wide, like every other
# root declaration.

import compiler.util
import compiler.ast
import compiler.fnreg

#[doc("Resolution of a protocol name from one module's viewpoint: the home of the protocol it binds to, a private foreign declaration (its module named for diagnostics), or no declaration at all.")]
pub type ProtoRes = PRHome(Option[String]) | PRPrivate(String) | PRUnknown

#[doc("Resolve protocol `pname` as seen from the module whose home is `from` (`None` = root file): its own declaration first, else the first-declared visible foreign one (`pub` or root-file).")]
pub fn proto_scope_resolve(origins: [ProtoOriginReg], pname: String,
                           from: Option[String]) : ProtoRes =
  match psc_own(origins, pname, from) {
    Some(mo) -> PRHome(mo)
    None -> match psc_foreign(list_reverse(origins), pname) {
      Some(mo) -> PRHome(mo)
      None -> match psc_any(origins, pname) {
        Some(m) -> PRPrivate(m)
        None    -> PRUnknown
      }
    }
  }

fn psc_own(origins: [ProtoOriginReg], pname: String,
           from: Option[String]) : Option[Option[String]] = match origins {
  [] -> None
  [PrOR(n, mo, _), ...rest] ->
    if n == pname and mo_eq(mo, from) { Some(mo) }
    else { psc_own(rest, pname, from) }
}

# `origins` arrives reversed (the registry prepends), so the caller
# passes it re-reversed: the first visible match is the first-declared.
# No own-home exclusion is needed — the own pass already failed, so no
# entry carries the consumer's home.
fn psc_foreign(origins: [ProtoOriginReg],
               pname: String) : Option[Option[String]] = match origins {
  [] -> None
  [PrOR(n, mo, is_pub), ...rest] -> {
    let visible = is_pub or mo_eq(mo, None)
    if n == pname and visible { Some(mo) }
    else { psc_foreign(rest, pname) }
  }
}

# Reached only when every candidate is a private non-root foreign
# declaration; any match names a module for the diagnostic.
fn psc_any(origins: [ProtoOriginReg], pname: String) : Option[String] =
  match origins {
    [] -> None
    [PrOR(n, mo, _), ...rest] ->
      if n == pname { mo } else { psc_any(rest, pname) }
  }

#[doc("The ops of the protocol named `pname` whose home is exactly `home`, in declaration order.")]
pub fn proto_scope_ops(ops: [ProtoOpReg], pname: String,
                       home: Option[String]) : [ProtoOpReg] =
  psc_ops_loop(ops, pname, home, [])

fn psc_ops_loop(ops: [ProtoOpReg], pname: String, home: Option[String],
                acc: [ProtoOpReg]) : [ProtoOpReg] = match ops {
  [] -> acc
  [op, ...rest] -> match op {
    POR(p, _, _, _, _, _, mo) ->
      if p == pname and mo_eq(mo, home) {
        psc_ops_loop(rest, pname, home, [op, ...acc])
      } else { psc_ops_loop(rest, pname, home, acc) }
  }
}

#[doc("The tparam names of the protocol named `pname` whose home is exactly `home`; `[]` for monomorphic protocols.")]
pub fn proto_scope_tparams(tps: [ProtoTPReg], pname: String,
                           home: Option[String]) : [String] = match tps {
  [] -> []
  [PTPR(p, names, mo), ...rest] ->
    if p == pname and mo_eq(mo, home) { names }
    else { proto_scope_tparams(rest, pname, home) }
}

# Dispatch identity. A contested name (declared by two or more homes)
# spells each declaration with its home module so impl mangling and
# `PIR` keys stay distinct — the `unit_spell` rule, protocol edition.
# Two exceptions keep the bare spelling: the root file (no module to
# qualify with) and stdlib cores (the runtime impl table and both
# backends key stdlib protocols by their fixed bare-name ids).
#[doc("One dispatch key per declared protocol: `<home>__<name>` when the name is contested and the home is a non-core module, the bare name otherwise.")]
pub fn proto_dispatch_keys(origins: [ProtoOriginReg],
                           cores: [String]) : [ProtoKey] = match origins {
  [] -> []
  [PrOR(n, mo, _), ...rest] ->
    [PKey(n, mo, psc_spell(origins, cores, n, mo)),
     ...proto_dispatch_keys(rest, cores)]
}

fn psc_spell(origins: [ProtoOriginReg], cores: [String],
             pname: String, home: Option[String]) : String = match home {
  None -> pname
  Some(m) ->
    if psc_contested(origins, pname) and not list_has(cores, m) {
      concat_all([m, "__", pname])
    } else { pname }
}

# Contested = at least two distinct homes declare the name. The walk
# compares every declaring home against the first one found.
fn psc_contested(origins: [ProtoOriginReg], pname: String) : Bool =
  match psc_first_home(origins, pname) {
    None -> false
    Some(h) -> psc_other_home(origins, pname, h)
  }

fn psc_first_home(origins: [ProtoOriginReg],
                  pname: String) : Option[Option[String]] = match origins {
  [] -> None
  [PrOR(n, mo, _), ...rest] ->
    if n == pname { Some(mo) } else { psc_first_home(rest, pname) }
}

fn psc_other_home(origins: [ProtoOriginReg], pname: String,
                  h: Option[String]) : Bool = match origins {
  [] -> false
  [PrOR(n, mo, _), ...rest] ->
    if n == pname and not mo_eq(mo, h) { true }
    else { psc_other_home(rest, pname, h) }
}

#[doc("The dispatch key of the protocol named `pname` homed at `home`; the bare name when the pair is unregistered.")]
pub fn proto_key_of(dkeys: [ProtoKey], pname: String,
                    home: Option[String]) : String = match dkeys {
  [] -> pname
  [PKey(n, mo, k), ...rest] ->
    if n == pname and mo_eq(mo, home) { k }
    else { proto_key_of(rest, pname, home) }
}

# Call-site visibility mirrors the resolution rule above: a module
# sees its own protocols, root-file ones, and exported foreign ones.
# The root file sees every protocol.
#[doc("True when the protocol `(pname, home)` is a legal dispatch candidate for a call inside module `cm` (`None` = root file).")]
pub fn proto_visible_from(origins: [ProtoOriginReg], pname: String,
                          home: Option[String],
                          cm: Option[String]) : Bool = match cm {
  None -> true
  Some(_) -> match home {
    None -> true
    Some(_) ->
      if mo_eq(home, cm) { true } else { psc_is_pub(origins, pname, home) }
  }
}

fn psc_is_pub(origins: [ProtoOriginReg], pname: String,
              home: Option[String]) : Bool = match origins {
  [] -> false
  [PrOR(n, mo, p), ...rest] ->
    if n == pname and mo_eq(mo, home) { p }
    else { psc_is_pub(rest, pname, home) }
}
