# compiler/proto_scope.kai — module scoping for protocol names.
#
# `protocol P` is not a package-global name. The registry collects
# every protocol over the flattened decl stream of every module, so
# consulting it by name alone lets whichever protocol was declared
# first answer for the whole package — including inside a module that
# declares its own `P` and never imports the first one. With two
# same-named protocols of different signatures, an impl would be
# validated against a contract its module cannot even see.
#
# Resolution follows the name ladder. An explicit qualifier (`m.P`)
# selects that module's declaration. A bare name tries, in order: the
# module's own declaration; the `pub` declarations of the modules its
# file imports, plus root-file declarations (visible package-wide);
# the stdlib cores (the implicit prelude); finally any visible foreign
# declaration. The first rung with a candidate answers — one candidate
# resolves, two or more are an ambiguity, never a first-declared
# choice. A core sees only other cores: user code never reaches into
# the stdlib's dispatch.

import compiler.util
import compiler.ast
import compiler.fnreg
import compiler.modules

#[doc("Resolution of a protocol name from one module's viewpoint: the home of the protocol it binds to, a private foreign declaration (its module named for diagnostics), no declaration at all, or several visible candidates (their homes, `None` = root file).")]
pub type ProtoRes = PRHome(Option[String]) | PRPrivate(String) | PRUnknown
                  | PRAmbiguous([Option[String]])

#[doc("Resolve protocol `pname` (bare or `m.P`) as seen from the module whose home is `from` (`None` = root file), through the registry's origins, cores and per-file imports.")]
pub fn proto_scope_resolve(reg: ProtocolReg, pname: String,
                           from: Option[String]) : ProtoRes =
  match split_dotted_qualifier(pname) {
    Some(q) -> match q { QSplit(m, bare) -> psc_qualified(reg.origins, bare, m, from) }
    None -> match psc_own(reg.origins, pname, from) {
      Some(mo) -> PRHome(mo)
      None -> psc_rungs(reg, pname, from,
                        [PscImported(psc_imports_of(reg.imports, from)), PscCores, PscAny])
    }
  }

# The three foreign rungs, tried in order.
type PscRung = PscImported([String]) | PscCores | PscAny

fn psc_rungs(reg: ProtocolReg, pname: String, from: Option[String],
             rungs: [PscRung]) : ProtoRes = match rungs {
  [] -> match psc_any(reg.origins, pname) {
    Some(m) -> PRPrivate(m)
    None    -> PRUnknown
  }
  [rung, ...rest] ->
    match psc_candidates(list_reverse(reg.origins), reg.cores, rung, pname, from, []) {
      [mo]  -> PRHome(mo)
      []    -> psc_rungs(reg, pname, from, rest)
      homes -> PRAmbiguous(list_reverse(homes))
    }
}

fn psc_imports_of(imports: [ModImports], from: Option[String]) : [String] =
  match imports {
    [] -> []
    [MImp(owner, names), ...rest] ->
      if owner == psc_owner_name(from) { names } else { psc_imports_of(rest, from) }
  }

fn psc_owner_name(from: Option[String]) : String = match from {
  None -> ""
  Some(m) -> m
}

fn psc_own(origins: [ProtoOriginReg], pname: String,
           from: Option[String]) : Option[Option[String]] = match origins {
  [] -> None
  [PrOR(n, mo, _), ...rest] ->
    if n == pname and mo_eq(mo, from) { Some(mo) }
    else { psc_own(rest, pname, from) }
}

# The qualifier is validated against the import table before this
# runs, so a missing declaration here is a protocol the module does
# not declare at all.
fn psc_qualified(origins: [ProtoOriginReg], bare: String, m: String,
                 from: Option[String]) : ProtoRes = match origins {
  [] -> PRUnknown
  [PrOR(n, mo, is_pub), ...rest] ->
    if n == bare and mo_eq(mo, Some(m)) {
      if is_pub or mo_eq(mo, from) { PRHome(mo) } else { PRPrivate(m) }
    } else { psc_qualified(rest, bare, m, from) }
}

# Every visible foreign home declaring `pname` on this rung,
# deduplicated, in declaration order (`origins` arrives re-reversed).
# The own home was already ruled out.
fn psc_candidates(origins: [ProtoOriginReg], cores: [String], rung: PscRung,
                  pname: String, from: Option[String],
                  acc: [Option[String]]) : [Option[String]] =
  match origins {
    [] -> acc
    [PrOR(n, mo, is_pub), ...rest] -> {
      let visible = (is_pub or mo_eq(mo, None)) and
                    psc_tier_ok(cores, from, mo) and psc_on_rung(cores, rung, mo)
      if n == pname and visible and not psc_has_home(acc, mo) {
        psc_candidates(rest, cores, rung, pname, from, [mo, ...acc])
      } else { psc_candidates(rest, cores, rung, pname, from, acc) }
    }
  }

fn psc_on_rung(cores: [String], rung: PscRung, mo: Option[String]) : Bool =
  match rung {
    PscImported(names) -> match mo {
      None    -> true
      Some(m) -> list_has(names, m)
    }
    PscCores -> psc_is_core(cores, mo)
    PscAny   -> true
  }

fn psc_tier_ok(cores: [String], from: Option[String], mo: Option[String]) : Bool =
  match from {
    None -> true
    Some(f) -> if list_has(cores, f) { psc_is_core(cores, mo) } else { true }
  }

fn psc_is_core(cores: [String], mo: Option[String]) : Bool = match mo {
  None -> false
  Some(m) -> list_has(cores, m)
}

fn psc_has_home(homes: [Option[String]], mo: Option[String]) : Bool = match homes {
  [] -> false
  [h, ...rest] -> if mo_eq(h, mo) { true } else { psc_has_home(rest, mo) }
}

# Reached only when every candidate is a private non-root foreign
# declaration; any match names a module for the diagnostic.
fn psc_any(origins: [ProtoOriginReg], pname: String) : Option[String] =
  match origins {
    [] -> None
    [PrOR(n, mo, _), ...rest] ->
      if n == pname { mo } else { psc_any(rest, pname) }
  }

#[doc("The ops of the protocol named `pname` whose home is exactly `home`, in declaration order.")]
pub fn proto_scope_ops(ops: [ProtoOpReg], pname: String,
                       home: Option[String]) : [ProtoOpReg] =
  psc_ops_loop(ops, pname, home, [])

fn psc_ops_loop(ops: [ProtoOpReg], pname: String, home: Option[String],
                acc: [ProtoOpReg]) : [ProtoOpReg] = match ops {
  [] -> acc
  [op, ...rest] -> match op {
    POR(p, _, _, _, _, _, mo) ->
      if p == pname and mo_eq(mo, home) {
        psc_ops_loop(rest, pname, home, [op, ...acc])
      } else { psc_ops_loop(rest, pname, home, acc) }
  }
}

#[doc("The tparam names of the protocol named `pname` whose home is exactly `home`; `[]` for monomorphic protocols.")]
pub fn proto_scope_tparams(tps: [ProtoTPReg], pname: String,
                           home: Option[String]) : [String] = match tps {
  [] -> []
  [PTPR(p, names, mo), ...rest] ->
    if p == pname and mo_eq(mo, home) { names }
    else { proto_scope_tparams(rest, pname, home) }
}

# Dispatch identity. A contested name (declared by two or more homes)
# spells each declaration with its home module so impl mangling and
# `PIR` keys stay distinct — the `unit_spell` rule, protocol edition.
# Two exceptions keep the bare spelling: the root file (no module to
# qualify with) and stdlib cores (the runtime impl table and both
# backends key stdlib protocols by their fixed bare-name ids).
#[doc("One dispatch key per declared protocol: `<home>__<name>` when the name is contested and the home is a non-core module, the bare name otherwise.")]
pub fn proto_dispatch_keys(origins: [ProtoOriginReg],
                           cores: [String]) : [ProtoKey] =
  psc_keys_loop(origins, origins, cores)

# `all` stays the whole table: contestedness is a property of every
# declaration, not of the ones after the current entry.
fn psc_keys_loop(all: [ProtoOriginReg], todo: [ProtoOriginReg],
                 cores: [String]) : [ProtoKey] = match todo {
  [] -> []
  [PrOR(n, mo, _), ...rest] ->
    [PKey(n, mo, psc_spell(all, cores, n, mo)), ...psc_keys_loop(all, rest, cores)]
}

fn psc_spell(origins: [ProtoOriginReg], cores: [String],
             pname: String, home: Option[String]) : String = match home {
  None -> pname
  Some(m) ->
    if psc_contested(origins, pname) and not list_has(cores, m) {
      concat_all([m, "__", pname])
    } else { pname }
}

# Contested = at least two distinct homes declare the name. The walk
# compares every declaring home against the first one found.
fn psc_contested(origins: [ProtoOriginReg], pname: String) : Bool =
  match psc_first_home(origins, pname) {
    None -> false
    Some(h) -> psc_other_home(origins, pname, h)
  }

fn psc_first_home(origins: [ProtoOriginReg],
                  pname: String) : Option[Option[String]] = match origins {
  [] -> None
  [PrOR(n, mo, _), ...rest] ->
    if n == pname { Some(mo) } else { psc_first_home(rest, pname) }
}

fn psc_other_home(origins: [ProtoOriginReg], pname: String,
                  h: Option[String]) : Bool = match origins {
  [] -> false
  [PrOR(n, mo, _), ...rest] ->
    if n == pname and not mo_eq(mo, h) { true }
    else { psc_other_home(rest, pname, h) }
}

#[doc("The dispatch key of the protocol named `pname` homed at `home`; the bare name when the pair is unregistered.")]
pub fn proto_key_of(dkeys: [ProtoKey], pname: String,
                    home: Option[String]) : String = match dkeys {
  [] -> pname
  [PKey(n, mo, k), ...rest] ->
    if n == pname and mo_eq(mo, home) { k }
    else { proto_key_of(rest, pname, home) }
}

# Call-site visibility mirrors the resolution rule above: a module
# sees its own protocols, root-file ones, and exported foreign ones.
# The root file sees every protocol.
#[doc("True when the protocol `(pname, home)` is a legal dispatch candidate for a call inside module `cm` (`None` = root file).")]
pub fn proto_visible_from(origins: [ProtoOriginReg], pname: String,
                          home: Option[String],
                          cm: Option[String]) : Bool = match cm {
  None -> true
  Some(_) -> match home {
    None -> true
    Some(_) ->
      if mo_eq(home, cm) { true } else { psc_is_pub(origins, pname, home) }
  }
}

fn psc_is_pub(origins: [ProtoOriginReg], pname: String,
              home: Option[String]) : Bool = match origins {
  [] -> false
  [PrOR(n, mo, p), ...rest] ->
    if n == pname and mo_eq(mo, home) { p }
    else { psc_is_pub(rest, pname, home) }
}

