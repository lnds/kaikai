#[doc("The KIR linearity check: owed references, canonical forms, facts, per-op steps and the driver that reports violations.")]

import compiler.util
import compiler.kir_lin_model
import compiler.kir
import compiler.kir_syms
import compiler.kir_dump
import compiler.fnreg
import compiler.tailfuse

#[doc("Every object still holding an owned reference, as a leak.")]
pub(pkg) fn kls_leaks(st: LinSt) : [LinV] = kls_owing(st, st.creds, (o) => true, "leak")

#[doc("True when a register in `live` names object `o`.")]
pub(pkg) fn kls_named_live(xs: [(String, Int)], o: Int, live: [String]) : Bool =
  any(xs, (kv) => match kv { (k, oo) -> oo == o and list_has(live, k) })

#[doc("The objects of `cs` still owed and picked by `pick`, as violations of `kind`.")]
pub(pkg) fn kls_owing(st: LinSt, cs: [(Int, Int)], pick: (Int) -> Bool, kind: String) : [LinV] = match cs {
  []                -> []
  [(o, c), ...rest] -> {
    let tl = kls_owing(st, rest, pick, kind)
    if c > 0 and c < UNTRACKED and pick(o) { [LinV(kind, kls_label(st.names, o)), ...tl] } else { tl }
  }
}

# The first three registers naming `o`, sorted.
fn kls_label(xs: [(String, Int)], o: Int) : String = {
  let ns = kls_sort(map(filter(xs, (kv) => match kv { (_, oo) -> oo == o }), (kv) => match kv { (k, _) -> k }))
  match ns {
    [] -> "?"
    _  -> string_join(kls_first3(ns), ",")
  }
}

fn kls_first3(xs: [String]) : [String] = match xs {
  [a, b, c, ..._] -> [a, b, c]
  _               -> xs
}

#[doc("`xs` in ascending order.")]
pub(pkg) fn kls_sort(xs: [String]) : [String] = match xs {
  []           -> []
  [x, ...rest] -> kls_insert(x, kls_sort(rest))
}

fn kls_insert(x: String, ys: [String]) : [String] = match ys {
  []           -> [x]
  [y, ...rest] -> if string_lt(x, y) { [x, y, ...rest] } else { [y, ...kls_insert(x, rest)] }
}

#[doc("The canonical form of the ledger over the `live` registers, and the owned objects no live register names, reported as dead leaks and then forgotten.")]
pub(pkg) fn klk_canon(st: LinSt, live: [String]) : (String, LinSt, [LinV]) = {
  let dead = kls_owing(st, st.creds, (o) => not kls_named_live(st.names, o, live), "leak-dead")
  let st1 = klk_forget(st, st.creds, live)
  let names = kls_sort(filter(map(st1.names, (kv) => match kv { (k, _) -> k }), (n) => list_has(live, n)))
  let cnames = kls_sort(filter(map(st1.consts, (kv) => match kv { (k, _) -> k }), (n) => list_has(live, n)))
  (cat2(klk_key(st1, names, [], ""), klk_consts_key(st1, cnames)), st1, dead)
}

fn klk_forget(st: LinSt, cs: [(Int, Int)], live: [String]) : LinSt = match cs {
  []                -> st
  [(o, c), ...rest] ->
    if c > 0 and c < UNTRACKED and not kls_named_live(st.names, o, live) { klk_forget(kls_set(st, o, 0), rest, live) }
    else { klk_forget(st, rest, live) }
}

# Live registers in order, each with its object renumbered by first use and
# its count, then the live constants.
fn klk_key(st: LinSt, names: [String], seen: [Int], acc: String) : String = match names {
  []           -> acc
  [n, ...rest] -> match kls_obj_of(st.names, n) {
    None    -> klk_key(st, rest, seen, acc)
    Some(o) -> {
      let seen1 = if any(seen, (x) => x == o) { seen } else { list_append(seen, [o]) }
      let item = concat_all([n, "=", int_to_string(klk_index(seen1, o, 0)), ":", klk_count(st, o, kls_cred(st, o)), ";"])
      klk_key(st, rest, seen1, cat2(acc, item))
    }
  }
}

# The count, then whether the cell is unique or a view of a unique cell.
fn klk_count(st: LinSt, o: Int, c: Int) : String = cat2(
  if c >= UNTRACKED { "i" } else { int_to_string(c) },
  if list_has_int(st.uniq, o) { "u" } else if kls_slot_of_unique(st, o) { "s" } else { "" })

fn klk_consts_key(st: LinSt, ns: [String]) : String = match ns {
  []           -> ""
  [n, ...rest] -> concat_all([n, match kls_const_of(st, n) { Some(true) -> "!t;"  _ -> "!f;" }, klk_consts_key(st, rest)])
}

fn klk_index(xs: [Int], o: Int, i: Int) : Int = match xs {
  []           -> i
  [x, ...rest] -> if x == o { i } else { klk_index(rest, o, i + 1) }
}

#[doc("One function under check: its KIR, the program's functions, its CFG facts, which registers are boxed, and its `setjmp` registers.")]
pub(pkg) type Kx = { f: KFn, fns: LinFns, cfg: LinCfg, slots: [(String, Bool)], setjmps: [String], state: Option[FusedState] }

#[doc("One dispatch state of a fused group: its tag, and which slots a call into it leaves absent.")]
pub(pkg) type FusedState = FusedState(Int, [Bool])

#[doc("The facts of `f`.")]
pub(pkg) fn klf_cx(f: KFn, fns: LinFns, state: Option[FusedState]) : Kx =
  Kx { f: f, fns: fns, cfg: klc_build(f), slots: klin_slots(f), setjmps: klin_setjmps(f.blocks), state: state }

#[doc("The ledger the params of `kx` start with.")]
pub(pkg) fn klf_entry(kx: Kx) : LinSt = match kx.state {
  Some(FusedState(tag, absent)) -> klin_donor(kx, klin_entry_in(kx.f.params, absent, 0, klin_caps(kx.f.blocks), klin_seed_tag(kx.f.params, tag, kls_empty())))
  None -> if klin_fused(kx.f.params) { kls_empty() }
          else { klin_donor(kx, klin_entry(kx.f.params, klin_caps(kx.f.blocks), kls_empty())) }
}

# A fused group's slots hold a member's param in some states and an absent
# value in others; a function none of the program's calls enter is not walked.
fn klin_fused(ps: [KParam]) : Bool = match ps {
  [p, ..._] -> string_starts_with_q(p.name, tailfuse_tag_param())
  []        -> false
}

fn klin_seed_tag(ps: [KParam], tag: Int, st: LinSt) : LinSt = match ps {
  [p, ..._] -> kls_int(st, p.name, tag)
  []        -> st
}

# The params of a dispatch state: the slots a call leaves absent hold nothing.
fn klin_entry_in(ps: [KParam], absent: [Bool], i: Int, caps: [String], st: LinSt) : LinSt = match ps {
  []           -> st
  [p, ...rest] -> klin_entry_in(rest, absent, i + 1, caps,
    if klin_absent_at(absent, i) { st } else { klin_entry([p], caps, st) })
}

fn klin_absent_at(absent: [Bool], i: Int) : Bool = match absent {
  []           -> false
  [a, ...rest] -> if i == 0 { a } else { klin_absent_at(rest, i - 1) }
}

fn klin_donor(kx: Kx, st: LinSt) : LinSt = if kx.f.donor { kls_fresh(st, kir_donor_reg(), 1) } else { st }

#[doc("True when register `n` holds a boxed value.")]
pub(pkg) fn klf_boxed(kx: Kx, n: String) : Bool = match klin_slot_of(kx.slots, n) {
  Some(b) -> b
  None    -> false
}

# A capability param carries evidence, not a counted value.
fn klin_entry(ps: [KParam], caps: [String], st: LinSt) : LinSt = match ps {
  []           -> st
  [p, ...rest] -> klin_entry(rest, caps, match p.slot {
    SBoxed -> match p.origin {
      PResume -> st
      _       -> if list_has(caps, p.name) { st } else { kls_fresh(st, p.name, if klin_param_held(p) { 1 } else { 0 }) }
    }
    _ -> st
  })
}

# The capability params a perform goes through.
fn klin_caps(bs: [KBlock]) : [String] = match bs {
  []           -> []
  [b, ...rest] -> list_append(klin_stmt_caps(b.stmts), klin_caps(rest))
}

fn klin_stmt_caps(ss: [KStmt]) : [String] = match ss {
  []           -> []
  [s, ...rest] -> match s {
    KLet(_, _, KPerform(_, _, _, via, _), _) -> list_append(klin_cap_of(via), klin_stmt_caps(rest))
    KDo(KPerform(_, _, _, via, _), _)        -> list_append(klin_cap_of(via), klin_stmt_caps(rest))
    _                                        -> klin_stmt_caps(rest)
  }
}

fn klin_cap_of(via: KVia) : [String] = match via {
  KvRecv(r) -> [r]
  _         -> []
}

# A param the function owns: not borrowed, passed directly or captured into
# a handler's environment.
fn klin_param_held(p: KParam) : Bool = match p.mode {
  KBorrow -> false
  KOwn    -> match p.origin {
    PDirect(_)    -> true
    PEnvCapture(_) -> true
    _             -> false
  }
}

# A register let-bound at two slot kinds counts as boxed.
fn klin_slots(f: KFn) : [(String, Bool)] =
  klin_let_slots(f.blocks, map(f.params, (p) => (p.name, klin_is_box(p.slot))))

fn klin_let_slots(bs: [KBlock], acc: [(String, Bool)]) : [(String, Bool)] = match bs {
  []           -> acc
  [b, ...rest] -> klin_let_slots(rest, klin_stmt_slots(b.stmts, acc))
}

fn klin_stmt_slots(ss: [KStmt], acc: [(String, Bool)]) : [(String, Bool)] = match ss {
  []           -> acc
  [s, ...rest] -> klin_stmt_slots(rest, match s {
    KLet(x, sl, _, _) -> match klin_slot_of(acc, x) {
      None    -> [(x, klin_is_box(sl)), ...acc]
      Some(b) -> if b == klin_is_box(sl) { acc } else { [(x, true), ...acc] }
    }
    _ -> acc
  })
}

fn klin_slot_of(xs: [(String, Bool)], n: String) : Option[Bool] = match xs {
  []                -> None
  [(k, b), ...rest] -> if k == n { Some(b) } else { klin_slot_of(rest, n) }
}

fn klin_is_box(s: KSlot) : Bool = match s {
  SBoxed -> true
  _      -> false
}

fn klin_setjmps(bs: [KBlock]) : [String] = match bs {
  []           -> []
  [b, ...rest] -> list_append(klin_setjmp_regs(b.stmts), klin_setjmps(rest))
}

fn klin_setjmp_regs(ss: [KStmt]) : [String] = match ss {
  []           -> []
  [s, ...rest] -> match s {
    KLet(x, _, KSetjmp(_, _), _) -> [x, ...klin_setjmp_regs(rest)]
    _                            -> klin_setjmp_regs(rest)
  }
}

#[doc("True when a block of `bs` uses the reuse protocol, which the check does not model.")]
pub(pkg) fn klf_uses_reuse(bs: [KBlock]) : Bool = any(bs, (b) => any(b.stmts, klin_stmt_reuse))

fn klin_stmt_reuse(s: KStmt) : Bool = match s {
  KLet(_, _, op, _)           -> klo_is_reuse(op)
  KDo(op, _)                  -> klo_is_reuse(op)
  KRC(KArmTopReuse(_, _, _, _), _) -> true
  KRC(KArmTokenFree, _)       -> true
  _                           -> false
}

#[doc("Apply the statements `ss` to the ledger, gathering violations into `acc`.")]
pub(pkg) fn klin_stmts(kx: Kx, ss: [KStmt], st: LinSt, acc: [LinV]) : (LinSt, [LinV]) = match ss {
  []           -> (st, acc)
  [s, ...rest] -> {
    let (st1, vs) = klin_stmt(kx, s, st)
    klin_stmts(kx, rest, st1, list_append(vs, acc))
  }
}

fn klin_stmt(kx: Kx, s: KStmt, st: LinSt) : (LinSt, [LinV]) = match s {
  KLet(x, _, op, _)                -> klin_let(kx, x, op, st)
  KDo(op, _)                       -> match op {
    KLitOp(v) -> klin_take(kx, st, v, "do-discard")
    _         -> match klin_apply(kx, klo_fx(op, kx.fns), st) { (st1, vs) -> (klin_implicit(kx, op, st1), vs) }
  }
  KRC(rc, _)                       -> klin_rc(kx, rc, st)
  KStore(t, v, _)                  -> klin_store(kx, t, v, st)
  KInstall(_, _, Some(v), _, _, _) -> klin_take(kx, st, v, "install-state")
  _                                -> (st, [])
}

fn klin_let(kx: Kx, x: String, op: KOp, st: LinSt) : (LinSt, [LinV]) = {
  let fx = klo_fx(op, kx.fns)
  let (st0, vs) = klin_apply(kx, fx, st)
  let st1 = klin_implicit(kx, op, klin_gain(kx, op, st0))
  if not klf_boxed(kx, x) { (klin_note(st1, x, op), vs) }
  else { match fx {
    LinFx(_, _, res) -> (klin_note(klin_bind(kx, x, res, st1), x, op), vs)
  } }
}

# A projection remembers its cell, and a uniqueness test its subject.
fn klin_note(st: LinSt, x: String, op: KOp) : LinSt = match op {
  KProj(KVar(d), _)       -> kls_view_of(st, x, d)
  KProjBorrow(KVar(d), _) -> kls_view_of(st, x, d)
  KCall("kaix_check_unique", [KVar(d)]) -> kls_unique_test(st, x, d)
  KPrim(KpBox(_), [KVar(a)])            -> match kls_int_of(st, a) { Some(v) -> kls_int(st, x, v)  None -> st }
  KPrim(KpEqRaw, [KVar(a), KIntV(n)])   -> match kls_int_of(st, a) { Some(v) -> kls_const(st, x, Some(v == n))  None -> st }
  _                       -> st
}

# A slot move hands the register an owned reference to the child it names.
fn klin_gain(kx: Kx, op: KOp, st: LinSt) : LinSt = match op {
  KCall(sym, [_, v]) -> if klo_slot_gain(sym) { klin_dup(kx, st, v) } else { st }
  _                  -> st
}

fn klin_bind(kx: Kx, x: String, res: LinRes, st: LinSt) : LinSt = match res {
  LrOwn     -> kls_fresh(st, x, 1)
  LrView    -> kls_fresh(st, x, 0)
  LrImm     -> kls_fresh_imm(st, x)
  LrAlias(n) -> if klf_boxed(kx, n) { kls_alias(st, x, n) } else { kls_fresh_imm(st, x) }
}

fn klin_apply(kx: Kx, fx: LinFx, st: LinSt) : (LinSt, [LinV]) = match fx {
  LinFx(takes, untracks, _) -> {
    let (st1, vs) = klin_takes(kx, takes, st, [])
    (klin_untracks(kx, untracks, st1), vs)
  }
}

fn klin_takes(kx: Kx, ts: [(KVal, String)], st: LinSt, acc: [LinV]) : (LinSt, [LinV]) = match ts {
  []                  -> (st, acc)
  [(v, w), ...rest]   -> {
    let (st1, vs) = klin_take(kx, st, v, w)
    klin_takes(kx, rest, st1, list_append(vs, acc))
  }
}

fn klin_untracks(kx: Kx, vs: [KVal], st: LinSt) : LinSt = match vs {
  []           -> st
  [v, ...rest] -> klin_untracks(kx, rest, match v {
    KVar(n) -> if klf_boxed(kx, n) { kls_untrack(st, n) } else { st }
    _       -> st
  })
}

fn klin_rc(kx: Kx, rc: KRCOp, st: LinSt) : (LinSt, [LinV]) = match rc {
  KDup(v)                -> (klin_dup(kx, st, v), [])
  KDrop(v)               -> klin_take(kx, st, v, "drop")
  KFreeToken(v)          -> klin_take(kx, st, v, "free-token")
  KIncrefIfShared(_, c)  -> (klin_dup(kx, st, c), [])
  KArmTake(v, bs, _)     -> klin_take(kx, klin_dups(kx, st, bs), v, "arm-take")
  KArmTopReuse(v, _, ns, _) -> klin_arm_top(kx, v, ns, st)
  KArmTokenFree          -> (kls_release(st, kir_armru_reg()), [])
  _                      -> (st, [])
}

# The scrutinee becomes the arm-top token and the named binders each own one
# reference on both paths; a token still owned is overwritten.
fn klin_arm_top(kx: Kx, v: KVal, ns: [String], st: LinSt) : (LinSt, [LinV]) = {
  let (st1, vs) = klin_take(kx, klin_dups(kx, st, map(ns, (n) => KVar(n))), v, "arm-top")
  let over = if kls_owns(st1, kir_armru_reg()) { [LinV("arm-token-overwritten", kir_armru_reg())] } else { [] }
  (kls_fresh(st1, kir_armru_reg(), 1), list_append(over, vs))
}

# Implicit token traffic: a donating call moves `_arm_ru` in, a donor rebuild
# reads and nulls `__donor`.
fn klin_implicit(kx: Kx, op: KOp, st: LinSt) : LinSt = match op {
  KCall(sym, _)                    -> if klo_callee_donor(sym, kx.fns) { kls_release(st, kir_armru_reg()) } else { st }
  KConReuse(RkDonorVariant, _, _, _, _) -> kls_release(st, kir_donor_reg())
  _                                -> st
}

fn klin_store(kx: Kx, t: String, v: KVal, st: LinSt) : (LinSt, [LinV]) = {
  let st1 = kls_const(st, t, match v { KBoolV(b) -> Some(b)  _ -> None })
  if not klf_boxed(kx, t) { (st1, []) }
  else { kls_store(st1, t, match v {
    KVar(n) -> if klf_boxed(kx, n) { Some(n) } else { None }
    _       -> None
  }) }
}

fn klin_take(kx: Kx, st: LinSt, v: KVal, what: String) : (LinSt, [LinV]) = match v {
  KVar(n) -> if klf_boxed(kx, n) { kls_take(st, n, what) } else { (st, []) }
  _       -> (st, [])
}

fn klin_dups(kx: Kx, st: LinSt, vs: [KVal]) : LinSt = match vs {
  []           -> st
  [v, ...rest] -> klin_dups(kx, klin_dup(kx, st, v), rest)
}

fn klin_dup(kx: Kx, st: LinSt, v: KVal) : LinSt = match v {
  KVar(n) -> if klf_boxed(kx, n) { kls_dup(st, n) } else { st }
  _       -> st
}

# --- terminators ---------------------------------------------------------

#[doc("Apply the terminator `t`: the successors with their ledgers, and the violations at an exit.")]
pub(pkg) fn klin_term(kx: Kx, t: KTerm, st: LinSt) : ([(String, LinSt)], [LinV]) = match t {
  KRet(v, _)                                   -> klin_exit(klin_take(kx, st, v, "ret"))
  KCondBr(c, a, b, _)                          -> (klin_cond(kx, c, a, b, st), [])
  KTcrecGoto(_, asg, dm, _)                    -> klin_exit(klin_goto(kx, asg, dm, st))
  KTrmcStep(_, _, _, _, _, dm, hs, asg, _, _)  -> {
    let (st1, v1) = klin_takes(kx, map(hs, (h) => (h, "trmc-head")), st, [])
    let (out, v2) = klin_exit(klin_goto(kx, asg, dm, kls_release(st1, kir_armru_reg())))
    (out, list_append(v2, v1))
  }
  KTrmcApply(v, _)                             -> klin_exit(klin_take(kx, kls_release(st, kir_armru_reg()), v, "trmc-apply"))
  KSwitch(KVar(a), cs, d, _)                   -> match kls_int_of(st, a) {
    Some(v) -> ([(klin_case(cs, d, v), st)], [])
    None    -> (map(klc_succ(t), (l) => (l, st)), [])
  }
  _                                            -> (map(klc_succ(t), (l) => (l, st)), [])
}

fn klin_case(cs: [KCase], d: String, v: Int) : String = match cs {
  []               -> d
  [KC(k, l), ...rest] -> if k == v { l } else { klin_case(rest, d, v) }
}

# The emitter frees a donor token left at exit.
fn klin_exit(r: (LinSt, [LinV])) : ([(String, LinSt)], [LinV]) = match r {
  (st, vs) -> ([], list_append(kls_leaks(kls_release(st, kir_donor_reg())), vs))
}

# A setjmp's landing branch is the exceptional path; a branch on a known
# constant takes one side.
fn klin_cond(kx: Kx, c: KVal, a: String, b: String, st: LinSt) : [(String, LinSt)] = match c {
  KVar(n) ->
    if list_has(kx.setjmps, n) { [(b, st)] }
    else { match kls_const_of(st, n) {
      Some(true)  -> [(a, st)]
      Some(false) -> [(b, st)]
      None        -> match kls_test_cell(st, n) {
        Some(o) -> [(a, kls_mark_unique(st, o)), (b, st)]
        None    -> {
          let st1 = if klf_boxed(kx, n) { kls_untrack(st, n) } else { st }
          [(a, st1), (b, st1)]
        }
      }
    } }
  _ -> [(a, st), (b, st)]
}

# A back-edge moves each assigned value into the param it rebinds, then
# releases the params its drop mask names.
fn klin_goto(kx: Kx, asg: [KAssign], dm: Int, st: LinSt) : (LinSt, [LinV]) = {
  let moved = filter(asg, (a) => match a { KAsg(i, _) -> match klin_param(kx.f.params, i) {
    Some(p) -> klo_param_owned(p)
    None    -> true
  } })
  let (st1, v1) = klin_takes(kx, map(moved, (a) => (klc_asg_val(a), "goto-assign")), st, [])
  let dropped = filter(asg, (a) => match a { KAsg(i, _) -> klin_bit(dm, i) })
  klin_takes(kx, klin_param_vals(kx.f.params, dropped), st1, v1)
}

fn klin_param_vals(ps: [KParam], asg: [KAssign]) : [(KVal, String)] = match asg {
  []                  -> []
  [KAsg(i, _), ...rest] -> match klin_param(ps, i) {
    Some(p) -> [(KVar(p.name), "goto-dropmask"), ...klin_param_vals(ps, rest)]
    None    -> klin_param_vals(ps, rest)
  }
}

fn klin_param(ps: [KParam], i: Int) : Option[KParam] = match ps {
  []           -> None
  [p, ...rest] -> if i == 0 { Some(p) } else { klin_param(rest, i - 1) }
}

fn klin_bit(m: Int, i: Int) : Bool = if i == 0 { m % 2 == 1 } else { klin_bit(m / 2, i - 1) }

#[doc("Check `kp` and write one line per violation to `path` (function, kind, registers), and the KIR of each offending function to `path.kir`; nothing runs when `path` is empty.")]
pub(pkg) fn kir_lin_hook(kp: KProgram, path: String) : KProgram / File = {
  if path == "" { kp } else {
    let lines = kir_lin_report(kp)
    let _w = __file_write(path, string_join(map(lines, (l) => cat2(l, "\n")), ""))
    let nm = kp_names(kp)
    let bad = filter(kp.fns, (f) => any(lines, (l) => string_starts_with_q(l, cat2(kfn_sym(nm, f), "\t"))))
    let _k = match bad { [] -> 0  _ -> { let _d = __file_write(cat2(path, ".kir"), kir_dump_fns_pub(nm, bad)); 0 } }
    kp
  }
}

#[doc("One line per violation in `kp`: function, kind and registers, tab-separated.")]
pub(pkg) fn kir_lin_report(kp: KProgram) : [String] = klin_fns(kp_names(kp), kp.fns, kp.fns, klo_index(kp_names(kp), kp.fns), [])

fn klin_fns(nm: KNames, all: [KFn], fs: [KFn], fns: LinFns, acc: [String]) : [String] = match fs {
  []           -> acc
  [f, ...rest] -> klin_fns(nm, all, rest, fns, list_append(acc, klin_fn_lines(nm, all, f, fns)))
}

fn klin_fn_lines(nm: KNames, all: [KFn], f: KFn, fns: LinFns) : [String] = match f.kind {
  KFnFfi(_, _, _) -> []
  _               -> match f.blocks {
    []         -> []
    [b0, ..._] -> {
      let vs = if klin_fused(f.params) { klin_states_check(nm, all, f, fns, b0.label) }
               else { klin_check(klf_cx(f, fns, None), b0.label) }
      map(klin_dedupe(vs, []), (v) => klin_line(kfn_sym(nm, f), v))
    }
  }
}

# Each dispatch state the program enters is walked on its own.
fn klin_states_check(nm: KNames, all: [KFn], f: KFn, fns: LinFns, entry: String) : [LinV] =
  klin_state_walks(f, fns, entry, klin_states(all, kfn_sym(nm, f), []), [])

fn klin_state_walks(f: KFn, fns: LinFns, entry: String, ss: [FusedState], acc: [LinV]) : [LinV] = match ss {
  []           -> acc
  [s, ...rest] -> klin_state_walks(f, fns, entry, rest, list_append(acc, klin_check(klf_cx(f, fns, Some(s)), entry)))
}

# The states of the fused function `sym`: the tag and absent slots of each call into it.
fn klin_states(fs: [KFn], sym: String, acc: [FusedState]) : [FusedState] = match fs {
  []           -> acc
  [f, ...rest] -> klin_states(rest, sym, klin_block_states(f.blocks, sym, acc))
}

fn klin_block_states(bs: [KBlock], sym: String, acc: [FusedState]) : [FusedState] = match bs {
  []           -> acc
  [b, ...rest] -> klin_block_states(rest, sym, klin_stmt_states(b.stmts, sym, acc))
}

fn klin_stmt_states(ss: [KStmt], sym: String, acc: [FusedState]) : [FusedState] = match ss {
  []           -> acc
  [s, ...rest] -> klin_stmt_states(rest, sym, match s {
    KLet(_, _, KCall(c, xs), _) -> klin_add_state(c, xs, sym, acc)
    KDo(KCall(c, xs), _)        -> klin_add_state(c, xs, sym, acc)
    _                           -> acc
  })
}

fn klin_add_state(c: String, xs: [KVal], sym: String, acc: [FusedState]) : [FusedState] = match xs {
  [KIntV(k), ..._] ->
    if c == sym and not any(acc, (s) => match s { FusedState(t, _) -> t == k }) {
      [FusedState(k, map(xs, (x) => match x { KUnitV -> true  _ -> false })), ...acc]
    } else { acc }
  _ -> acc
}

fn klin_line(sym: String, v: LinV) : String = match v { LinV(k, r) -> concat_all([sym, "\t", k, "\t", r]) }

# A path is cut once it revisits a block this often, and a function's walk
# once it has taken this many steps.
const LOOP_LIMIT : Int = 3
const STEP_LIMIT : Int = 20000

fn klin_check(kx: Kx, entry: String) : [LinV] =
  klin_loop(kx, [(entry, klf_entry(kx), [entry])], [], 0, [])

fn klin_loop(kx: Kx, work: [(String, LinSt, [String])], seen: [String], steps: Int, acc: [LinV]) : [LinV] = match work {
  [] -> acc
  [(b, st, path), ...rest] ->
    if steps > STEP_LIMIT { [LinV("path-cap", "-"), ...acc] }
    else if klin_count(path, b) > LOOP_LIMIT { klin_loop(kx, rest, seen, steps + 1, [LinV("loop-unbalanced", b), ...acc]) }
    else { match klc_block(kx.cfg, b) {
      None      -> klin_loop(kx, rest, seen, steps + 1, acc)
      Some(blk) -> {
        let (key, st1, dead) = klin_canon(kx, b, st)
        if list_has(seen, key) { klin_loop(kx, rest, seen, steps + 1, list_append(dead, acc)) }
        else {
          let (st2, v1) = klin_stmts(kx, blk.stmts, st1, [])
          let (next, v2) = klin_term(kx, blk.term, st2)
          let more = map(next, (ns) => match ns { (l, s) -> (l, s, [l, ...path]) })
          klin_loop(kx, list_append(more, rest), [key, ...seen], steps + 1, concat_lists([v2, v1, dead, acc]))
        }
      }
    } }
}

fn klin_canon(kx: Kx, b: String, st: LinSt) : (String, LinSt, [LinV]) =
  if klc_is_doomed(kx.cfg, b) { (cat2(b, "|unreachable"), st, []) }
  else {
    let (k, st1, dead) = klk_canon(st, [kir_armru_reg(), kir_donor_reg(), ...klc_live_at(kx.cfg, b)])
    (concat_all([b, "|", k]), st1, dead)
  }

fn klin_count(xs: [String], x: String) : Int = match xs {
  []           -> 0
  [y, ...rest] -> (if y == x { 1 } else { 0 }) + klin_count(rest, x)
}

fn klin_dedupe(vs: [LinV], seen: [String]) : [LinV] = match vs {
  []           -> []
  [v, ...rest] -> match v {
    LinV(k, r) -> {
      let key = concat_all([k, "\t", r])
      if list_has(seen, key) { klin_dedupe(rest, seen) } else { [v, ...klin_dedupe(rest, [key, ...seen])] }
    }
  }
}

fn concat_lists(xss: [[LinV]]) : [LinV] = match xss {
  []            -> []
  [xs, ...rest] -> list_append(xs, concat_lists(rest))
}
