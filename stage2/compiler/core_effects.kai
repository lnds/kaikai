#[doc("""
The effects the compiler itself treats specially, named by declaration.

A pass that gives `State` a stack slot, routes `Ffi` around the
dispatcher or masks a local `Mutable` is asking which declaration an
effect is, and the answer is the declaration's `SymId`. This module is
the one place that spells those effects: every other pass asks
`effect_is` with the id the node carries, so a user effect that merely
shares a core effect's name is never taken for it.

An id here is the one the symbol table derives for the declaration: the
written name, the effect class, and the home of the module that declares
it. Most are declared by a core module; `Clock`, `NetTcp` and `NetDns`
by a standard-library module a program imports.
""")]

import compiler.ast
import compiler.decl_names
import compiler.symtab_build

#[doc("A core effect the compiler names: the closed set of declarations a pass may single out.")]
pub type CoreEffect = CeState | CeReader | CeWriter | CeMutable | CeFfi
  | CeSpawn | CeCancel | CeLink | CeMonitor | CeActor
  | CeStdout | CeStderr | CeStdin | CeEnv | CeFile | CeProcess
  | CeClock | CeRandom | CeSecureRandom | CeNetTcp | CeNetDns | CeSignal | CeLog

#[doc("The name a core effect is declared with: what a diagnostic, a dump and the runtime label spell.")]
pub fn core_effect_name(c: CoreEffect) : String = match c {
  CeState   -> "State"
  CeReader  -> "Reader"
  CeWriter  -> "Writer"
  CeMutable -> "Mutable"
  CeFfi     -> "Ffi"
  CeSpawn   -> "Spawn"
  CeCancel  -> "Cancel"
  CeLink    -> "Link"
  CeMonitor -> "Monitor"
  CeActor   -> "Actor"
  CeStdout  -> "Stdout"
  CeStderr  -> "Stderr"
  CeStdin   -> "Stdin"
  CeEnv     -> "Env"
  CeFile    -> "File"
  CeProcess -> "Process"
  CeClock   -> "Clock"
  CeRandom  -> "Random"
  CeSecureRandom -> "SecureRandom"
  CeNetTcp  -> "NetTcp"
  CeNetDns  -> "NetDns"
  CeSignal  -> "Signal"
  CeLog     -> "Log"
}

# The module whose stream declares the effect.
fn core_effect_home(c: CoreEffect) : String = match c {
  CeState   -> "concurrent"
  CeReader  -> "concurrent"
  CeWriter  -> "concurrent"
  CeSpawn   -> "concurrent"
  CeCancel  -> "concurrent"
  CeLink    -> "concurrent"
  CeMonitor -> "concurrent"
  CeActor   -> "concurrent"
  CeProcess -> "os"
  CeMutable -> "effects"
  CeFfi     -> "effects"
  CeStdout  -> "effects"
  CeStderr  -> "effects"
  CeStdin   -> "effects"
  CeEnv     -> "effects"
  CeFile    -> "effects"
  CeRandom  -> "effects"
  CeSecureRandom -> "effects"
  CeLog     -> "effects"
  CeSignal  -> "os"
  CeClock   -> "time"
  CeNetTcp  -> "net__tcp"
  CeNetDns  -> "net__dns"
}

#[doc("The declaration a core effect is: the id the symbol table holds for it.")]
pub fn core_effect_id(c: CoreEffect) : SymId = SymId(core_effect_raw(c))

# The id each effect's name and home derive, tabulated: passes ask which
# core effect a label is on every row they read, and a derivation builds
# a string and hashes it.
fn core_effect_raw(c: CoreEffect) : Int = match c {
  CeState        -> 1793337584142949932
  CeReader       -> 9118086695842773681
  CeWriter       -> 3742621026940645377
  CeMutable      -> 5284387685190924345
  CeFfi          -> 7458743709468539139
  CeSpawn        -> 4982727092969191890
  CeCancel       -> 4073248305964767003
  CeLink         -> 3536290541108258182
  CeMonitor      -> 7194965815363612335
  CeActor        -> 5523920262146478775
  CeStdout       -> 7011661366081257046
  CeStderr       -> 3365168435483099045
  CeStdin        -> 39558678912747917
  CeEnv          -> 9184442853664428740
  CeFile         -> 1185392000373346643
  CeProcess      -> 772543352024307631
  CeClock        -> 3930682887202962661
  CeRandom       -> 7113299721127038226
  CeSecureRandom -> 7501162831799159192
  CeNetTcp       -> 1053914643869103684
  CeNetDns       -> 1481266202576392499
  CeSignal       -> 8602324383868402738
  CeLog          -> 3542305281035147134
}

#[doc("Every core effect.")]
pub fn core_effects() : [CoreEffect] =
  [CeState, CeReader, CeWriter, CeMutable, CeFfi, CeSpawn, CeCancel, CeLink, CeMonitor, CeActor,
   CeStdout, CeStderr, CeStdin, CeEnv, CeFile, CeProcess, CeClock, CeRandom, CeSecureRandom,
   CeNetTcp, CeNetDns, CeSignal, CeLog]

#[doc("True when each tabulated identity is the one its declaration's name and home derive.")]
pub fn core_effects_are_derived() : Bool =
  all(core_effects(), (c) => core_effect_raw(c) == sym_raw(sym_derive(NCEffect, core_effect_name(c), core_effect_home(c))))

#[doc("True when `s` is the declaration of the core effect `c`. An unresolved id is no core effect.")]
pub fn effect_is(s: SymId, c: CoreEffect) : Bool =
  sym_raw(s) >= 0 and sym_raw(s) == core_effect_raw(c)

#[doc("True when `s` is the declaration of one of the core effects `cs`.")]
pub fn effect_is_any(s: SymId, cs: [CoreEffect]) : Bool = match cs {
  []           -> false
  [c, ...rest] -> effect_is(s, c) or effect_is_any(s, rest)
}

#[doc("The resolved row label of a core effect that takes no type argument.")]
pub fn core_effect_label(c: CoreEffect) : Label =
  Label { sym: core_effect_id(c), ty_args: [], cell: local_none() }

#[doc("The row label, in a signature, of a core effect that takes no type argument.")]
pub fn core_effect_row_label(c: CoreEffect) : RowLabel =
  RL(DrSym(core_effect_id(c)), [])

#[doc("The effects whose default handlers the runtime installs first, in its order; every other effect of the entry point's row follows in row order.")]
pub fn default_install_first() : [CoreEffect] =
  [CeStdout, CeStderr, CeStdin, CeEnv, CeFile, CeClock,
   CeRandom, CeSecureRandom, CeNetTcp, CeNetDns, CeSignal, CeProcess, CeLog,
   CeMutable, CeCancel, CeLink, CeMonitor, CeSpawn]

#[doc("The effects of `row` in the order their default handlers install: those the runtime installs first, in its order, then the others in row order.")]
pub fn default_install_order(row: [SymId]) : [SymId] = {
  let first = map(default_install_first(), core_effect_id)
  list_append(filter(first, (b) => effect_among(row, b)), filter(row, (s) => not effect_among(first, s)))
}

#[doc("True when the declared effect `s` is one of `ss`.")]
pub fn effect_among(ss: [SymId], s: SymId) : Bool = match ss {
  []           -> false
  [h, ...rest] -> (sym_raw(s) >= 0 and sym_raw(h) == sym_raw(s)) or effect_among(rest, s)
}
