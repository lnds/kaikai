# Type-level reference enumeration for module-privacy validation:
# the `PaRef` shape plus the walks over `TyKind`, `RowExpr` and
# `UnitExprT`. The declaration and expression walks build on these in
# `pub_access_decl.kai`; the decision point consuming the refs is
# `validate_pub_access` in `pub_access.kai`. Matches carry no
# catch-all arm on purpose: a new AST form fails this file's compile
# until its privacy story is decided.

import compiler.chars
import compiler.ast
import compiler.written

#[doc("What a reference names: the bare name the source wrote, or the declaration a scope pass settled it to.")]
pub type PaName = PnWritten(String) | PnSym(SymId)

#[doc("""
One free-name reference found in a declaration.

`is_ty` selects the namespace the privacy table resolves the name in;
`in_sig` marks references that belong to the declaration's exported
surface (params, return, row, type body); `leakable` clears for
surface positions invisible to consumers (a `priv` field's type),
which the pub-signature leak rule skips.
""")]
pub type PaRef = { name: PaName, is_ty: Bool, in_sig: Bool,
      leakable: Bool, line: Int, col: Int }

#[doc("A reference by the bare name the source wrote.")]
pub fn pa_ref(name: String, is_ty: Bool, in_sig: Bool, leakable: Bool,
      line: Int, col: Int) : PaRef =
  PaRef { name: PnWritten(name), is_ty: is_ty, in_sig: in_sig, leakable: leakable,
      line: line, col: col }

#[doc("A reference a scope pass settled to the declaration `s`.")]
pub fn pa_ref_sym(s: SymId, is_ty: Bool, in_sig: Bool, leakable: Bool,
      line: Int, col: Int) : PaRef =
  PaRef { name: PnSym(s), is_ty: is_ty, in_sig: in_sig, leakable: leakable,
      line: line, col: col }

#[doc("True for a dotted (`mod.name`) reference — those are resolved and gated by the qualified resolver, not the privacy table.")]
pub fn pa_dotted(n: String) : Bool = pa_dotted_loop(n, 0, string_length(n))

fn pa_dotted_loop(n: String, i: Int, len: Int) : Bool =
  if i >= len { false }
  else if string_slice(n, i, 1) == "." { true }
  else { pa_dotted_loop(n, i + 1, len) }

# A bound (`T: Sneaky`) references the protocol.
#[doc("Type-namespace refs for every protocol bound a type-parameter list carries.")]
pub fn pa_bound_refs(tps0: [TBinder], line: Int, col: Int,
      acc: [PaRef]) : [PaRef] = match tps0 {
  [] -> acc
  [t, ...rest] -> pa_bound_refs(rest, line, col, pa_bound_names(t.bounds, line, col, acc))
}

#[doc("Type-namespace refs for a list of protocol bounds.")]
pub fn pa_bound_names(bs: [DeclRef], line: Int, col: Int,
      acc: [PaRef]) : [PaRef] = match bs {
  [] -> acc
  [DrSym(s), ...rest] -> pa_bound_names(rest, line, col,
      [pa_ref_sym(s, true, true, true, line, col), ...acc])
  [DrWritten(_, n), ...rest] -> pa_bound_names(rest, line, col,
      [pa_ref(written_text(n), true, true, true, line, col), ...acc])
}

fn pa_te_name(n: String, tps: [TBinder], in_sig: Bool, leakable: Bool,
      line: Int, col: Int, acc: [PaRef]) : [PaRef] =
  if pa_dotted(n) { acc }
  else { [pa_ref(n, true, in_sig, leakable, line, col), ...acc] }

# A lowercase name still written in type position is one no signature
# bound, never a reference to a global symbol. Unit symbols and row
# labels resolve nominally and do not take this rule.
fn pa_ty_ref(n: String, tps: [TBinder], in_sig: Bool, leakable: Bool,
      line: Int, col: Int, acc: [PaRef]) : [PaRef] =
  if pa_lower_start(n) { acc }
  else { pa_te_name(n, tps, in_sig, leakable, line, col, acc) }

fn pa_lower_start(n: String) : Bool = match char_at(n, 0) {
  Some(c) -> ch_is_lower(c)
  None -> false
}

# A type head: a settled one is checked on its declaration, a written
# one on its name.
fn pa_ty_head(r: DeclRef, tps: [TBinder], in_sig: Bool, leakable: Bool,
      line: Int, col: Int, acc: [PaRef]) : [PaRef] = match r {
  DrWritten(_, n) -> pa_ty_ref(written_text(n), tps, in_sig, leakable, line, col, acc)
  DrSym(s)        -> [pa_ref_sym(s, true, in_sig, leakable, line, col), ...acc]
}

# A row label. A qualified one was gated by the qualified resolver.
fn pa_label_ref(r: DeclRef, tps: [TBinder], in_sig: Bool, leakable: Bool,
      line: Int, col: Int, acc: [PaRef]) : [PaRef] = match r {
  DrWritten(None, n)    -> pa_te_name(written_text(n), tps, in_sig, leakable, line, col, acc)
  DrWritten(Some(_), _) -> acc
  DrSym(s)              -> [pa_ref_sym(s, true, in_sig, leakable, line, col), ...acc]
}

#[doc("Type-namespace refs of a type expression. `tps` are the type parameters in scope, for a fragment parsed on the way.")]
pub fn par_te(te: TypeExpr, tps: [TBinder], in_sig: Bool, leakable: Bool,
      acc: [PaRef]) : [PaRef] = match te.tkind {
  TyName(r, targs) ->
    par_te_list(targs, tps, in_sig, leakable,
      pa_ty_head(r, tps, in_sig, leakable, te.line, te.col, acc))
  TyList(inner) -> par_te(inner, tps, in_sig, leakable, acc)
  TyFn(ps, ret, row) -> {
    let a1 = par_te_list(ps, tps, in_sig, leakable, acc)
    let a2 = par_te(ret, tps, in_sig, leakable, a1)
    par_row(row, tps, in_sig, leakable, te.line, te.col, a2)
  }
  TyDim(base, u) -> {
    let a1 = par_te(base, tps, in_sig, leakable, acc)
    par_uexpr(u, tps, in_sig, leakable, te.line, te.col, a1)
  }
  # The refinement predicate is an expression over `self`, checked by
  # the refinement pipeline; only the base type is a name reference.
  TyRefine(base, _) -> par_te(base, tps, in_sig, leakable, acc)
  TyRow(row) -> par_row(row, tps, in_sig, leakable, te.line, te.col, acc)
  TySurface(ts) -> par_te_list(tysurface_children(ts), tps, in_sig, leakable, acc)
  TyParam(_, targs) -> par_te_list(targs, tps, in_sig, leakable, acc)
}

#[doc("Type-namespace refs of a type-expression list.")]
pub fn par_te_list(ts: [TypeExpr], tps: [TBinder], in_sig: Bool, leakable: Bool,
      acc: [PaRef]) : [PaRef] = match ts {
  [] -> acc
  [t, ...rest] -> par_te_list(rest, tps, in_sig, leakable,
      par_te(t, tps, in_sig, leakable, acc))
}

#[doc("Effect-label refs of a row expression.")]
pub fn par_row(row: RowExpr, tps: [TBinder], in_sig: Bool, leakable: Bool,
      line: Int, col: Int, acc: [PaRef]) : [PaRef] = match row {
  REmpty -> acc
  RClosed(ls)  -> par_row_labels(ls, tps, in_sig, leakable, line, col, acc)
  ROpen(_, ls) -> par_row_labels(ls, tps, in_sig, leakable, line, col, acc)
}

fn par_row_labels(ls: [RowLabel], tps: [TBinder], in_sig: Bool, leakable: Bool,
      line: Int, col: Int, acc: [PaRef]) : [PaRef] = match ls {
  [] -> acc
  [RL(r, targs), ...rest] ->
    par_row_labels(rest, tps, in_sig, leakable, line, col,
      par_te_list(targs, tps, in_sig, leakable,
      pa_label_ref(r, tps, in_sig, leakable, line, col, acc)))
}

#[doc("Unit-symbol refs of a unit expression.")]
pub fn par_uexpr(u: UnitExprT, tps: [TBinder], in_sig: Bool, leakable: Bool,
      line: Int, col: Int, acc: [PaRef]) : [PaRef] = match u {
  UOne    -> acc
  UVar(_) -> acc
  USym(s) -> pa_te_name(s, tps, in_sig, leakable, line, col, acc)
  UMul(a, b)  -> par_uexpr(b, tps, in_sig, leakable, line, col,
      par_uexpr(a, tps, in_sig, leakable, line, col, acc))
  UInv(a)     -> par_uexpr(a, tps, in_sig, leakable, line, col, acc)
  UPow(a, _)  -> par_uexpr(a, tps, in_sig, leakable, line, col, acc)
  UJoin(a, b) -> par_uexpr(b, tps, in_sig, leakable, line, col,
      par_uexpr(a, tps, in_sig, leakable, line, col, acc))
  UDims(us)   -> par_uexprs(us, tps, in_sig, leakable, line, col, acc)
  UParam(_)   -> acc
}

fn par_uexprs(us: [UnitExprT], tps: [TBinder], in_sig: Bool, leakable: Bool,
      line: Int, col: Int, acc: [PaRef]) : [PaRef] = match us {
  [] -> acc
  [u, ...rest] -> par_uexprs(rest, tps, in_sig, leakable, line, col,
      par_uexpr(u, tps, in_sig, leakable, line, col, acc))
}
