# compiler/core_prims.kai — the boxed core-builtin registry both backends
# read: the kaikai name, its C entry point and its arity, for every prim
# the backends can call or reference as a first-class value. Derived from
# `builtin_table`; the C backend calls `cname` or closes over
# `_<cname>_thunk`, the native backend calls `kaix_core_<name>` or closes
# over `kaix_<name>_thunk`.

import compiler.util
import compiler.builtin_types
import compiler.builtins

#[doc("A boxed core builtin: its kaikai name, its C entry point and its arity.")]
pub type ECore = EP(String, String, Int)

#[doc("The boxed core builtins the backends know, in registry order: every builtin with a runtime entry, each followed by its `_borrow` sibling when it has one.")]
pub fn core_table() : [ECore] = core_table_of(builtin_table())

fn core_table_of(bs: [Builtin]) : [ECore] = match bs {
  [] -> []
  [BF(name, entry, sig), ...rest] -> match builtin_cname(name, entry) {
    Some(cname) -> core_entries(name, cname, bsig_arity(sig), core_table_of(rest))
    None        -> core_table_of(rest)
  }
}

fn core_entries(name: String, cname: String, arity: Int, rest: [ECore]) : [ECore] =
  if list_has(core_borrowing_prims(), name) {
    [EP(name, cname, arity), EP(cat2(name, "_borrow"), cat2(cname, "_borrow"), arity), ...rest]
  } else { [EP(name, cname, arity), ...rest] }

#[doc("Every core builtin name a bare use binds, `_borrow` siblings included.")]
pub fn core_builtin_names() : [String] = core_names_of(builtin_table())

fn core_names_of(bs: [Builtin]) : [String] = match bs {
  [] -> []
  [BF(name, entry, _), ...rest] ->
    if not builtin_bound(entry) { core_names_of(rest) }
    else { match core_borrow_variant(name) {
      Some(b) -> [name, b, ...core_names_of(rest)]
      None    -> [name, ...core_names_of(rest)]
    } }
}

# Find a core builtin by kaikai name in a pre-built table, walked
# borrowed: the match reads each field and copies the hit instead of
# returning the shared spine node, so the table threaded from emit entry
# stays live and unmutated across every call site.
#[doc("The registry entry for a kaikai builtin name, or None when the name is not a core builtin.")]
pub fn core_find(table: [ECore], target: String) : Option[ECore] {
  match table {
    [] -> None
    [ep, ...rest] -> match ep {
      EP(name, cname, ar) -> if name == target { Some(EP(name, cname, ar)) } else { core_find(rest, target) }
    }
  }
}

#[doc("The runtime symbol of the thunk that lets the native backend build a closure over a core builtin.")]
pub fn core_native_thunk_sym(name: String) : String = cat3("kaix_", name, "_thunk")

#[doc("The linkable runtime symbol a direct call to the core builtin `name` binds on the native backend.")]
pub fn core_native_call_sym(name: String) : String = string_concat("kaix_core_", name)

# Each name here has a `<name>_borrow` registry entry: the read-only
# sibling that borrows argument 0 where `name` consumes it.
#[doc("The core builtins with a read-only `_borrow` sibling that borrows argument 0.")]
pub fn core_borrowing_prims() : [String] = ["array_get", "array_length", "vec_get", "vec_length"]

#[doc("True for the typer's unit tag and untag intrinsics, which are identity at runtime.")]
pub fn core_is_unit_coercion(callee: String) : Bool =
  callee == "__strip_unit" or callee == "__attach_unit" or callee == "__detach_unit"

#[doc("The read-only `_borrow` sibling of a core builtin, or None when it has none.")]
pub fn core_borrow_variant(name: String) : Option[String] =
  if list_has(core_borrowing_prims(), name) { Some(cat2(name, "_borrow")) } else { None }
