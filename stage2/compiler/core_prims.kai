# compiler/core_prims.kai — the boxed core-builtin registry: the kaikai
# name, its C entry point and its arity, for every prim the backends can
# call or reference as a first-class value.
#
# Both backends read this one table, so they cannot disagree on which
# builtins exist or how many arguments they take. The C backend emits a
# direct call to `cname` (or a closure over the prim's `_<cname>_thunk`);
# the native backend emits a call to the `kaix_core_<name>` shim (or a
# closure over `kaix_<name>_thunk`).
#
# Invariant: every entry needs BOTH thunk forwarders to exist — the
# `static _<cname>_thunk` in `stage2/runtime.h` and the exported
# `kaix_<name>_thunk` in `stage0/runtime_llvm.c`. A missing one is a link
# error at the first program that names the builtin as a value.

import compiler.util

#[doc("A boxed core builtin: its kaikai name, its C entry point and its arity.")]
pub type ECore = EP(String, String, Int)

#[doc("The boxed core builtins the backends know, in registry order.")]
pub fn core_table() : [ECore] {
  [
    EP("print",            "kai_core_print",            1),
    EP("eprint",           "kai_core_eprint",           1),
    EP("write_stdout",     "kai_core_write_stdout",     1),
    EP("panic",            "kai_core_panic",            1),
    EP("exit",             "kai_core_exit",             1),
    EP("int_to_string",    "kai_core_int_to_string",    1),
    EP("real_to_string",   "kai_core_real_to_string",   1),
    EP("int_to_real",      "kai_core_int_to_real",      1),
    EP("real_to_int",      "kai_core_real_to_int",      1),
    # libm bindings (issue #343) — pass-through NaN/Inf semantics.
    EP("real_sqrt",        "kai_core_real_sqrt",        1),
    EP("real_cbrt",        "kai_core_real_cbrt",        1),
    EP("real_exp",         "kai_core_real_exp",         1),
    EP("real_log",         "kai_core_real_log",         1),
    EP("real_log2",        "kai_core_real_log2",        1),
    EP("real_log10",       "kai_core_real_log10",       1),
    EP("real_sin",         "kai_core_real_sin",         1),
    EP("real_cos",         "kai_core_real_cos",         1),
    EP("real_tan",         "kai_core_real_tan",         1),
    EP("real_asin",        "kai_core_real_asin",        1),
    EP("real_acos",        "kai_core_real_acos",        1),
    EP("real_atan",        "kai_core_real_atan",        1),
    EP("real_sinh",        "kai_core_real_sinh",        1),
    EP("real_cosh",        "kai_core_real_cosh",        1),
    EP("real_tanh",        "kai_core_real_tanh",        1),
    EP("real_signum",      "kai_core_real_signum",      1),
    EP("real_is_nan",      "kai_core_real_is_nan",      1),
    EP("real_is_inf",      "kai_core_real_is_inf",      1),
    EP("real_pow",         "kai_core_real_pow",         2),
    EP("real_atan2",       "kai_core_real_atan2",       2),
    EP("real_rem",         "kai_core_real_rem",         2),
    EP("string_length",    "kai_core_string_length",    1),
    EP("string_concat",    "kai_core_string_concat",    2),
    EP("string_concat_all","kai_core_string_concat_all",1),
    EP("string_join",      "kai_core_string_join",      2),
    EP("list_length",      "kai_core_list_length",      1),
    EP("list_append",      "kai_core_list_append",      2),
    EP("list_reverse",     "kai_core_list_reverse",     1),
    EP("map",              "kai_core_map",              2),
    # issue #201: paired runtime entry for the `||` flat-map pipe.
    # Same shape as `map`; head-type-to-module dispatch in
    # `synth_flat_map_pipe` resolves to `<module>.flat_map`, and the
    # module bound to head-type `List` is `list` whose `flat_map` lands
    # on this core symbol so `[T]` works without an explicit import.
    EP("flat_map",         "kai_core_flat_map",         2),
    EP("filter",           "kai_core_filter",           2),
    EP("reduce",           "kai_core_reduce",           3),
    EP("each",             "kai_core_each",             2),
    EP("args",             "kai_core_args",             0),
    # Issue #127: argv[0] as a flat core (path (a) in the issue
    # body, mirroring how `args()` is also a core even though
    # `Env.args()` exists as an op). `stdlib/os/args.kai` re-exports
    # this as `program_name()` so the dotted-call surface stays
    # uniform with the rest of `os.args`.
    EP("program_name",     "kai_core_program_name",     0),
    # Hanga Roa: compile-time hard-coded path to `stdlib/`. Used by
    # the core loader to find core/*.kai without --core flags.
    EP("stdlib_path",      "kai_core_stdlib_path",      0),
    # Canonicalise a filesystem path via realpath(3). Used by the
    # import resolver to dedup module loads when --core paths
    # are absolute (core auto-load) but user --path arguments are
    # relative — without this the same file loads twice.
    EP("abspath",          "kai_core_abspath",          1),
    EP("read_file",        "kai_core_read_file",        1),
    EP("write_file",       "kai_core_write_file",       2),
    # Issue #345: fs/file expansion (exists/delete/rename).
    EP("file_exists",      "kai_core_file_exists",      1),
    EP("file_delete",      "kai_core_file_delete",      1),
    EP("file_rename",      "kai_core_file_rename",      2),
    # Issue #482: binary file IO (deferred from #345).
    EP("file_read_bytes",  "kai_core_file_read_bytes",  1),
    EP("file_write_bytes", "kai_core_file_write_bytes", 2),
    # Issue #344: fs/dir surface (list/create/remove/walk).
    EP("dir_list_dir",     "kai_core_dir_list_dir",     1),
    EP("dir_create_dir",   "kai_core_dir_create_dir",   1),
    EP("dir_remove_dir",   "kai_core_dir_remove_dir",   1),
    EP("dir_walk",         "kai_core_dir_walk",         1),
    EP("read_line",        "kai_core_read_line",        0),
    # Issue #453: byte-oriented stdin (LSP framing precursor).
    EP("read_bytes",       "kai_core_read_bytes",       1),
    EP("string_to_int",    "kai_core_string_to_int",    1),
    EP("string_to_real",   "kai_core_string_to_real",   1),
    EP("char_at",          "kai_core_char_at",          2),
    EP("string_split",     "kai_core_string_split",     2),
    EP("string_contains",  "kai_core_string_contains",  2),
    EP("string_slice",     "kai_core_string_slice",     3),
    EP("char_to_int",      "kai_core_char_to_int",      1),
    EP("int_to_char",      "kai_core_int_to_char",      1),
    # Issue #592 KAB2 cache: build a 1-byte String from the low 8 bits
    # of `n`. Bypasses `kai_to_string(KAI_CHAR)` + `Show for Char`'s
    # `\xNN` escape rendering so every byte value 0..255 round-trips
    # byte-exact; the cache codec needs this for raw binary payloads.
    EP("int_to_byte_string","kai_core_int_to_byte_string", 1),
    # Issue #592 KAB2 cache: read one byte from String as Int 0..255,
    # or -1 on OOB. Bypasses Option allocation of `char_at`; reduces
    # cache deserialize wall by ~80% on warm loads.
    EP("string_byte_at_int","kai_core_string_byte_at_int", 2),
    # Issue #744: UTF-8 codepoint decode — width of the sequence at a
    # byte offset, and the codepoint there. `string.chars()`/`char_count`
    # /`char_indices` walk the buffer in kaikai over these two.
    EP("string_cp_at",      "kai_core_string_cp_at",       2),
    EP("string_cp_len",     "kai_core_string_cp_len",      2),
    # Codepoint-wise reverse in one pass / one allocation. Walks the
    # UTF-8 buffer by sequence width, copying each full sequence into the
    # destination from the tail — never re-encodes a Char, so multibyte
    # text round-trips byte-exact; O(n) vs an immutable-concat O(n^2).
    EP("string_reverse",    "kai_core_string_reverse",     1),
    # Issue #373: Hash protocol backends — full-width FNV-1a over a
    # String's bytes, and IEEE-754 bit reinterpret for Real.
    EP("string_hash",       "kai_core_string_hash",        1),
    EP("int_to_le4",        "kai_core_int_to_le4",         1),
    EP("int_to_le8",        "kai_core_int_to_le8",         1),
    EP("real_bits",         "kai_core_real_bits",          1),
    # Lane 4 (#473): Byte nominal primitive. See add_core_sigs above
    # for the type-level surface; C bodies live in stage0/runtime.h.
    EP("int_to_byte",        "kai_core_int_to_byte",        1),
    EP("byte_to_int",        "kai_core_byte_to_int",        1),
    EP("byte_add",           "kai_core_byte_add",           2),
    EP("byte_sub",           "kai_core_byte_sub",           2),
    EP("byte_eq",            "kai_core_byte_eq",            2),
    EP("byte_lt",            "kai_core_byte_lt",            2),
    EP("byte_to_string",     "kai_core_byte_to_string",     1),
    # Fixed-width integer prims (numeric lane A). C bodies in runtime.h.
    EP("int32_to_string",    "kai_core_int32_to_string",    1),
    EP("uint32_to_string",   "kai_core_uint32_to_string",   1),
    EP("uint64_to_string",   "kai_core_uint64_to_string",   1),
    EP("int128_to_string",   "kai_core_int128_to_string",   1),
    EP("int_to_int32",       "kai_core_int_to_int32",       1),
    EP("int_to_uint32",      "kai_core_int_to_uint32",      1),
    EP("int_to_uint64",      "kai_core_int_to_uint64",      1),
    EP("int_to_int128",      "kai_core_int_to_int128",      1),
    EP("int32_to_int",       "kai_core_int32_to_int",       1),
    EP("uint32_to_int",      "kai_core_uint32_to_int",      1),
    EP("uint64_to_int",      "kai_core_uint64_to_int",      1),
    EP("int128_to_int",      "kai_core_int128_to_int",      1),
    EP("array_make",       "kai_core_array_make",       2),
    EP("array_empty",      "kai_core_array_empty",      0),
    EP("array_length",        "kai_core_array_length",        1),
    EP("array_length_borrow", "kai_core_array_length_borrow", 1),
    EP("array_get",           "kai_core_array_get",           2),
    EP("array_get_borrow",    "kai_core_array_get_borrow",    2),
    EP("array_set",        "kai_core_array_set",        3),
    EP("array_grow",       "kai_core_array_grow",       3),
    EP("vec_make",         "kai_core_vec_make",         2),
    EP("vec_empty",        "kai_core_vec_empty",        0),
    EP("vec_length",       "kai_core_vec_length",       1),
    EP("vec_get",          "kai_core_vec_get",          2),
    EP("vec_set",          "kai_core_vec_set",          3),
    EP("vec_push",         "kai_core_vec_push",         2),
    EP("vec_length_borrow", "kai_core_vec_length_borrow", 1),
    EP("vec_get_borrow",   "kai_core_vec_get_borrow",   2),
    EP("vec_slice",        "kai_core_vec_slice",        3),
    EP("vec_tail_from",    "kai_core_vec_tail_from",    2),
    EP("vec_reserve",      "kai_core_vec_reserve",      1),
    EP("vec_from_list",    "kai_core_vec_from_list",    1),
    # m8 #7: mailbox runtime
    EP("mailbox_alloc",         "kai_core_mailbox_alloc",         0),
    EP("mailbox_alloc_bounded", "kai_core_mailbox_alloc_bounded", 2),
    EP("mailbox_send",          "kai_core_mailbox_send",          2),
    EP("mailbox_recv",          "kai_core_mailbox_recv",          1),
    EP("mailbox_recv_timeout",  "kai_core_mailbox_recv_timeout",  2),
    EP("mailbox_free",          "kai_core_mailbox_free",          1),
    # Tier 2 spawn_actor — alloc-without-stamp + reassign owner to a
    # spawned fiber. Used by stdlib/actor.kai's `spawn_actor` and
    # (issue #763) `spawn_actor_policy`.
    EP("mailbox_alloc_unowned",  "kai_core_mailbox_alloc_unowned",  0),
    EP("mailbox_alloc_bounded_unowned", "kai_core_mailbox_alloc_bounded_unowned", 2),
    EP("mailbox_assign_owner",   "kai_core_mailbox_assign_owner",   2),
    EP("spawn_actor_fiber",      "kai_core_spawn_actor_fiber",      2)
  ]
}

# Find a core builtin by kaikai name in a pre-built table, walked
# borrowed: the match reads each field and copies the hit instead of
# returning the shared spine node, so the table threaded from emit entry
# stays live and unmutated across every call site.
#[doc("The registry entry for a kaikai builtin name, or None when the name is not a core builtin.")]
pub fn core_find(table: [ECore], target: String) : Option[ECore] {
  match table {
    [] -> None
    [ep, ...rest] -> match ep {
      EP(name, cname, ar) -> if name == target { Some(EP(name, cname, ar)) } else { core_find(rest, target) }
    }
  }
}

#[doc("The runtime symbol of the thunk that lets the native backend build a closure over a core builtin.")]
pub fn core_native_thunk_sym(name: String) : String = cat3("kaix_", name, "_thunk")
