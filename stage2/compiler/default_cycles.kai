#[doc("Rejects a `default { }` block whose clauses, through the defaults they need, perform their own effect again.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.diag
import compiler.diag_file
import compiler.emit_shared_rows
import compiler.inherit_defaults
import compiler.symtab
import compiler.util
import compiler.written

#[doc("One error per effect whose default reaches itself through the defaults its clause bodies perform, at the `default` block.")]
pub fn default_cycle_diags(df: DiagFiles, tab: SymTab, decls: [Decl]) : [Diagnostic] =
  flat_map(
    decls,
    d => match d {
      DEffect(_, esym, _, _, Some(DBlk(_, _, bl, bc)), _, _, _, _, _) ->
        if has_kaikai_default(d) and reaches_itself(decls, esym) {
          [
            mk_diag(
              SevError,
              decl_diag_file(d, df),
              bl,
              bc,
              concat_all([
                "the `default { }` of effect `",
                written_text(decl_name(tab, esym)),
                "` performs itself"
              ]),
              []
            )
          ]
        } else {
          []
        }
      _ -> []
    }
  )

fn reaches_itself(decls: [Decl], eff: SymId) : Bool =
  any(next_defaults(decls, eff), n => reaches(decls, n, eff, [eff]))

fn next_defaults(decls: [Decl], eff: SymId) : [SymId] =
  filter(default_body_effects(decls, eff), e => effect_default_block_present(e, decls))

fn reaches(decls: [Decl], from: SymId, target: SymId, seen: [SymId]) : Bool =
  if sym_same(from, target) {
    true
  } else if any(seen, s => sym_same(s, from)) {
    false
  } else {
    any(next_defaults(decls, from), n => reaches(decls, n, target, [from, ...seen]))
  }
