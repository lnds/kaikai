#[doc("The warning for a statement that discards a value of a `#[must_use]` type.")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.infer_env
import compiler.infer_state
import compiler.infer_apply
import compiler.infer_handle_walk
import compiler.infer_row_kinds

#[doc("The stable rule name the discard warning reports under.")]
pub fn must_use_rule() : String = "must_use_discard"

#[doc("Warn when the statement expression `ex`, of type `ty`, is a `#[must_use]` value left unused.")]
pub fn warn_discarded(st: InferState, ty: Ty, ex: Expr) : InferState =
  match apply_ty(st.sub, ty) {
    TyCon(s, args) -> match must_use_lookup(st.env.must_use, s) {
      Some(MU(_, msg)) -> st_push_diag(st, discard_diag(st, ex, TyCon(s, args), msg))
      None -> st
    }
    _ -> st
  }

#[doc("The expression whose position names a discarded statement: the callee of a call, whose own position marks its parentheses.")]
pub fn discard_site(x: Expr) : Expr = match x.kind {
  ECall(callee, _) -> callee
  _ -> x
}

#[doc("True when `d` is the discard warning at `file`:`line`:`col`.")]
pub fn is_must_use_warning_at(d: Diagnostic, file: String, line: Int, col: Int) : Bool = match d {
  D(_, f, l, c, _, _, rule) -> rule == must_use_rule() and f == file and l == line and c == col
}

fn discard_diag(st: InferState, ex: Expr, ty: Ty, msg: Option[String]) : Diagnostic {
  let at = discard_site(ex)
  let text = concat_all(["unused value of type `", inf_ty_to_string(st.env.tab, ty), "`"])
  let help = ri_help(st.file, at.line, at.col, "close it with `|> ignore` or bind it with `let _ =`")
  let notes = match msg {
    Some(m) -> [ri_note(st.file, at.line, at.col, m), help]
    None -> [help]
  }
  mk_diag_rule(SevWarning, st.file, at.line, at.col, text, notes, must_use_rule())
}
