#[doc("""
The names a pattern and a parameter list bind, and the imports and
tagged names a declaration list puts in scope.
""")]

import compiler.util
import compiler.ast
import compiler.module_table
import compiler.written

#[doc("True when a name starts with an ASCII uppercase letter.")]
pub fn name_starts_upper(name: String) : Bool = match char_at(name, 0) {
  Some(c) -> c >= 'A' and c <= 'Z'
  None    -> false
}

# The module name an EModCall must carry: the one the module's decls
# were tagged with, which is what codegen keys symbols by. A file
# reached under an alias appears in the table more than once, sharing
# an origin path; the tagged name is the one on the entry the resolver
# registered globally, which per-file alias entries are prepended to.
# Scanning from the end finds it regardless of how many aliases name
# the same file.
#[doc("The modules each file opens with a plain `import m`, as tagged module names, keyed by the importing file's tagged name (`\"\"` = root). An alias or a selective import binds a qualifier or picks names, and opens nothing.")]
pub fn scope_imports(scopes: [ModScope], global: [ModuleEntry]) : [ModImports] = match scopes {
  [] -> []
  [MScope(owner, mes, opens), ...rest] ->
    [MImp(owner, scope_tagged_names(mes, opens, global)), ...scope_imports(rest, global)]
}

fn scope_tagged_names(mes: [ModuleEntry], opens: [String], global: [ModuleEntry]) : [String] = match mes {
  [] -> []
  [ME(written, _, origin, _), ...rest] ->
    if list_has(opens, written) {
      [me_last_name_for_origin(global, origin, written), ...scope_tagged_names(rest, opens, global)]
    } else { scope_tagged_names(rest, opens, global) }
}

# Collect the binders introduced by a pattern. Used by SLet,
# match-arm patterns, and variant-record / record patterns.
pub fn pat_binders(pat: Pattern, acc: [Binder]) : [Binder] = match pat.pkind {
  PWild           -> acc
  PLit(_)         -> acc
  PRange(_, _)    -> acc
  PBind(b)        -> [b, ...acc]
  PList(subs, opt_rest) -> {
    let acc1 = pat_binders_list(subs, acc)
    match opt_rest { Some(b) -> [b, ...acc1] None -> acc1 }
  }
  PVariant(_, subs)        -> pat_binders_list(subs, acc)
  PVariantRecord(_, fs)    -> pat_binders_pfields(fs, acc)
  PRecord(fs)              -> pat_binders_pfields(fs, acc)
  PHole(_)                 -> acc
  PAs(b, inner)            -> pat_binders(inner, [b, ...acc])
  PNarrow(b, _)            -> [b, ...acc]
  PSurface(sp)             -> pat_binders_list(patsurface_children(sp), acc)
}

fn pat_binders_list(ps: [Pattern], acc: [Binder]) : [Binder] = match ps {
  [] -> acc
  [p, ...rest] -> pat_binders_list(rest, pat_binders(p, acc))
}

fn pat_binders_pfields(fs: [PField], acc: [Binder]) : [Binder] = match fs {
  [] -> acc
  [f, ...rest] -> match f {
    PField(_, sub, _) -> pat_binders_pfields(rest, pat_binders(sub, acc))
  }
}

#[doc("The names the binders of a pattern were written with, ahead of `acc`: what a pass that runs before the resolver tracks its scope by.")]
pub fn pat_binder_names(pat: Pattern, acc: [String]) : [String] =
  list_append(map(pat_binders(pat, []), (b) => written_text(b.name)), acc)

pub fn fn_param_names(params: [Param]) : [String] = match params {
  [] -> []
  [p, ...rest] -> [written_text(p.binder.name), ...fn_param_names(rest)]
}
