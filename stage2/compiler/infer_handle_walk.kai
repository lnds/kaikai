fn inf_row_to_string_suffix(tab: SymTab, r: Row) : String = inf_row_suffix_ow(tab, [], r)


#[doc("Typer-internal helper `inf_row_suffix_ow` shared across the infer modules.")]
pub fn inf_row_suffix_ow(tab: SymTab, owners: [HeadOwnerEntry], r: Row) : String {
  # a row with no labels is treated as "pure" in display
  # form, whether its tail is None (truly closed empty) or Some(_)
  # (a free row var with no demand on it — the phantom that
  # `fn_scheme_of_decl` inserts for REmpty signatures, or any fresh
  # row var introduced by instantiation and never constrained). The
  # tail variable is internal bookkeeping; showing `?eN` to users
  # mis-suggests they need to annotate the function. Diagnostics for
  # actual row mismatches still print the `expected` and `found`
  # rows in full (those rows carry labels by the time the mismatch
  # is reported).
  let body =
    if labels_empty(r.labels) {
      ""
    } else {
      let lbs = inf_join_with(map(r.labels, (l) => label_display(tab, owners, l)), " + ")
      let tail_s = match r.tail {
        None -> ""
        Some(v) -> {
          let pre = if string_length(lbs) > 0 { " + " } else { "" }
          concat_all([pre, "?e", int_to_string(v)])
        }
      }
      concat_all([" / ", lbs, tail_s])
    }
  body
}


fn inf_ty_string_list(tab: SymTab, ts: [Ty]) : [String] = map(ts, (t) => inf_ty_to_string(tab, t))


fn inf_tycon_arg_to_string(tab: SymTab, t: Ty) : String = match inf_row_carrier_of(t) {
  Some(row) -> if labels_empty(row.labels) { "_" } else { inf_join_with(map(row.labels, (l) => label_to_string(tab, l)), " + ") }
  None      -> inf_ty_to_string(tab, t)
}


#[doc("Render a resolved Ty as its surface display string (with a non-empty effect row suffix). Shared by the typed-AST dumps and consumers like kai lint.")]
pub fn inf_ty_to_string(tab: SymTab, t: Ty) : String {
  match t {
    TyInt    -> "Int"
    TyReal   -> "Real"
    TyBool   -> "Bool"
    TyString -> "String"
    TyChar   -> "Char"
    TyUnit   -> "Unit"
    TyByte     -> "Byte"
    TyInt32    -> "Int32"
    TyUInt32   -> "UInt32"
    TyUInt64   -> "UInt64"
    TyInt128   -> "Int128"
    TyHandle   -> "Handle"
    TyListT(inner) -> cat3("[", inf_ty_to_string(tab, inner), "]")
    # render the function type's effect row alongside the
    # arrow when non-empty, with each label printed as `Eff` or
    # `Eff[T1, T2]` so parametric-effect mismatches (Reader[Int] vs
    # Reader[String]) are visible in `expected/found` notes.
    TyFnT(ps, ret, row) -> concat_all([
      "(", inf_join_with(inf_ty_string_list(tab, ps), ", "), ") -> ",
      inf_ty_to_string(tab, ret),
      inf_row_to_string_suffix(tab, row)
    ])
    TyCon(csym, tas) -> {
      let cname = written_text(decl_name(tab, csym))
      match tas {
        [] -> cname
        _ -> concat_all([cname, "[", inf_join_with(map(cont_shown_args(csym, tas), (a) => inf_tycon_arg_to_string(tab, a)), ", "), "]"])
      }
    }
    TyVarT(n) -> cat2("?t", int_to_string(n))
    # a still-unresolved shape application prints as `?sN[Arg]`.
    TyShapeApp(sv, arg) -> concat_all(["?s", int_to_string(sv), "[", inf_ty_to_string(tab, arg), "]"])
    TyAny -> "?"
    # render dimensioned base types as `Real<u>` / `Int<u>`.
    # The unit goes through unit_canon so the printed form matches
    # what the unifier compares against — same shape on every side.
    TyDimT(base, u) -> concat_all([inf_ty_to_string(tab, base), "<", inf_unit_canon_display(u), ">"])
    # render `T where ...` for diagnostics. The predicate
    # is left as `<pred>` to keep the line short.
    TyRefineT(base, _) -> concat_all([inf_ty_to_string(tab, base), " where <pred>"])
    # render unions inline as `A | B | C` to match
    # surface syntax. Components are already in canonical order when
    # the walker receives them via `normalize_union`.
    TyUnion(parts) -> inf_join_with(map(parts, (p) => inf_ty_to_string(tab, p)), " | ")
  }
}


#[doc("Typer-internal helper `residual_tails` shared across the infer modules.")]
pub fn residual_tails(s: Subst, us: [TailUse], acc: [TailUse]) : [TailUse] = match us {
  [] -> acc
  [TU(t, l, c), ...rest] -> {
    let root = row_root(s, t)
    residual_tails(s, rest, if root < 0 or tail_uses_have(acc, root) { acc } else { [TU(root, l, c), ...acc] })
  }
}


# Walk to the expression whose type is what the function body
# "produces". For block bodies that's the tail expression (or the
# block's closing brace if tail is absent). This lets return-type
# mismatches point at the offending expression instead of the `fn`
# header.
#[doc("Typer-internal helper `return_site_of` shared across the infer modules.")]
pub fn return_site_of(e: Expr) : Expr {
  match e.kind {
    EBlock(_, opt_tail) -> match opt_tail {
      Some(tail) -> return_site_of(tail)
      None       -> e
    }
    _ -> e
  }
}


# A block that ends in a point-free section after other statements: a
# `.` opening the last line began a new statement, it did not continue
# the line above.
#[doc("Typer-internal helper `tail_is_section` shared across the infer modules.")]
pub fn tail_is_section(body: Expr) : Bool = match body.kind {
  EBlock([_, ..._], Some(tail)) -> match tail.kind {
    ELambda(ps, _) -> params_point_free(ps)
    _              -> false
  }
  _ -> false
}


#[doc("Typer-internal helper `st_hint_section_tail` shared across the infer modules.")]
pub fn st_hint_section_tail(st: InferState, site: Expr) : InferState / Console + File {
  let msg = "a line starting with `.` is a point-free section, not a continuation of the previous line"
  st_relate_all(st, [ri_help(st.file, site.line, site.col, msg)])
}


# type-check a `test` / `bench` / `check` body so the typed
# AST it produces carries resolved callees for downstream
# passes. Mirrors the paramless-`fn` slice of `infer_decl`'s DFn arm:
# install the proto-impl + sum registries, add any `check` params to
# scope, `synth` the body, then absorb the body's builtin effects the
# way `main` does (the test runner installs those defaults). The decl
# shape itself is returned unchanged with its now-typed body.
#[doc("Typer-internal helper `test_block_kind` shared across the infer modules.")]
pub fn test_block_kind(d: Decl) : String = match d {
  DBench(_, _, _, _, _)    -> "bench"
  DCheck(_, _, _, _, _, _) -> "check"
  _                        -> "test"
}


#[doc("Typer-internal helper `test_decl_desc` shared across the infer modules.")]
pub fn test_decl_desc(d: Decl) : String = match d {
  DTest(desc, _, _, _, _)     -> desc
  DBench(desc, _, _, _, _)    -> desc
  DCheck(desc, _, _, _, _, _) -> desc
  _                           -> ""
}


# Rebuild a DTest / DBench / DCheck decl with its body replaced by the
# typed one. Other decl shapes are returned unchanged (never reached —
# `infer_test_body` is only called on the three test-like shapes).
#[doc("Typer-internal helper `test_decl_with_body` shared across the infer modules.")]
pub fn test_decl_with_body(d: Decl, body: Expr) : Decl {
  match d {
    DTest(desc, _, l, c, mo)      -> DTest(desc, body, l, c, mo)
    DBench(desc, _, l, c, mo)     -> DBench(desc, body, l, c, mo)
    DCheck(desc, ps, _, l, c, mo) -> DCheck(desc, ps, body, l, c, mo)
    _                         -> d
  }
}


type HandleEscapeKind = HkFiber | HkPid

fn handle_kind_sym(k: HandleEscapeKind) : SymId = match k {
  HkFiber -> core_ty_sym(CtFiber)
  HkPid -> core_ty_sym(CtPid)
}

fn handle_kind_shown(k: HandleEscapeKind) : String = match k {
  HkFiber -> "Fiber[T]"
  HkPid -> "Pid[Msg]"
}

fn handle_kind_name(k: HandleEscapeKind) : String = match k {
  HkFiber -> "Fiber"
  HkPid -> "Pid"
}

fn handle_kind_owner(k: HandleEscapeKind) : String = match k {
  HkFiber -> "nursery"
  HkPid -> "actor scope"
}

fn handle_kind_help(k: HandleEscapeKind) : String = match k {
  HkFiber -> "process the fiber inside the nursery (e.g. with `spawn.await`), or pass a thunk in and a value out instead"
  HkPid -> "process the pid inside the scope (e.g. with `Actor.send`), or pass a thunk in and a value out instead"
}

#[doc("Reject a function whose return type lets a `Fiber` or `Pid` handle outlive the scope that created it.")]
pub fn check_no_fiber_escape(st: InferState, file: String, f: SymId, fname: String,
                             opt_ret: Option[TypeExpr], ret: Ty, sums: [SumInfo], hcar: HandleTab,
                             line: Int, col: Int) : InferState / Console + File {
  if is_fiber_producer_helper(f) { st }
  else {
    match opt_ret {
      None -> st
      Some(rty) ->
        if not ty_mentions(ht_carriers(hcar, core_ty_sym(CtFiber)), ret) { st }
        else {
          let site = EscapeSite { file: file, fname: fname, rty: rty, line: line, col: col }
          find_handle_escape(st, st_home_view(st), site, sums, [HkFiber, HkPid])
        }
    }
  }
}

type EscapeSite = { file: String, fname: String, rty: TypeExpr, line: Int, col: Int }

fn find_handle_escape(st: InferState, hv: TyHomeView, site: EscapeSite, sums: [SumInfo],
                      kinds: [HandleEscapeKind]) : InferState / Console + File =
  match kinds {
    [] -> st
    [k, ...rest] -> match ty_expr_find_handle(hv, handle_kind_sym(k), site.rty, sums, st.recs, []) {
      Some(breach) -> report_handle_escape(st, site, k, breach)
      None -> find_handle_escape(st, hv, site, sums, rest)
    }
  }

fn report_handle_escape(st: InferState, site: EscapeSite, k: HandleEscapeKind,
                        breach: HandleBreach) : InferState / Console + File {
  let shown = handle_kind_shown(k)
  let lline = if site.rty.line > 0 { site.rty.line } else { site.line }
  let lcol = if site.rty.col > 0 { site.rty.col } else { site.col }
  let perr = mk_diag(SevError, site.file, lline, lcol,
    concat_all([shown, " cannot escape `", site.fname, "`'s structured-concurrency scope"]), [])
  let st1 = st_note(st_note(st_push_diag(st, perr), concat_all(["a `", shown, "` handle is bound to the ", handle_kind_owner(k), " that created it"])), "returning one from a function lets it outlive that scope")
  st_bump_err(st_help(st_handle_breach_note(st1, handle_kind_name(k), breach), handle_kind_help(k)))
}


# when the breach goes through a user-defined sum
# payload, surface the type + constructor name so the user can
# see exactly which carrier smuggled the handle out. Direct
# breaches (Fiber/Pid as a top-level type-arg or return type)
# emit no extra note — the existing Fiber/Pid pointer is enough.
fn st_handle_breach_note(st: InferState, hname: String, breach: HandleBreach) : InferState {
  let tab = st.env.tab
  match breach {
    HBDirect -> st
    HBRec(tsym) ->
      st_note(st, concat_all(["`", hname, "` is held by a field of record type `", written_text(decl_name(tab, tsym)), "`"]))
    HBSum(tsym, csym) ->
      st_note(st, concat_all(["`", hname,
                              "` is wrapped by constructor `", written_text(decl_name(tab, csym)),
                              "` of sum type `", written_text(decl_name(tab, tsym)), "`"]))
  }
}


# Allow-list of stdlib helpers permitted to mention Fiber[T] / Pid[Msg]
# in their return type. Kept intentionally narrow — these are the only
# legitimate constructors / passthroughs of Fiber / Pid values today
# (stdlib/spawn.kai + stdlib/actor.kai). Any new helper that needs to
# return either handle must be added here on purpose. The full
# TyBranded(Ty, BrandId) machinery — proper brand propagation through
# every binding form so an arbitrary helper can be admitted without an
# allow-list — is not yet wired up; this allow-list stands in for it.
fn is_fiber_producer_helper(f: SymId) : Bool = match known_fn_of(f) {
  Some(_) -> true
  None    -> false
}


# (option (a)): a single deep walker
# parameterised by the handle type (`Fiber` or `Pid`). Returns
# `Some(HBDirect)` for a top-level/recursive-shallow occurrence
# (Fiber[Int], Result[_, Fiber[Int]], Option[Pid[Msg]], …) and
# `Some(HBSum(type, constructor))` when the handle is hidden inside a
# user-defined sum's variant payload (`type Boxed =
# Wrap(Fiber[Int])`). The `visited` set guards recursive sums
# (`type Tree[T] = Leaf(T) | Node(Tree[T], Tree[T])`).
type HandleBreach = HBDirect | HBSum(SymId, SymId) | HBRec(SymId)


# A value of `t` holds one of the type `h`, directly or in a field of a type it names.
#[doc("Typer-internal helper `ty_holds` shared across the infer modules.")]
pub fn ty_holds(h: SymId, t: Ty, ht: HandleTab) : Bool = match t {
  TyCon(s, args) ->
    sym_same(s, h) or any(args, (a) => ty_holds(h, a, ht)) or named_holds(h, s, ht)
  TyListT(x) -> ty_holds(h, x, ht)
  _ -> false
}


# A value of `t` holds a continuation whose row names the effect `es`: a
# `Cont` with it in its row, or a type holding one that `t` instantiates
# with such a row.
#[doc("Typer-internal helper `ty_cont_needs` shared across the infer modules.")]
pub fn ty_cont_needs(t: Ty, es: SymId, ht: HandleTab) : Bool = match cont_parts(t) {
  Some(cp) -> row_arg_names(cp.row, es) or cont_needs_any([cp.arg, cp.answer], es, ht)
  None -> ty_cont_needs_in(t, es, ht)
}


fn ty_cont_needs_in(t: Ty, es: SymId, ht: HandleTab) : Bool = match t {
  TyCon(s, args) -> cont_named_needs(s, args, es, ht)
  TyListT(x) -> ty_cont_needs(x, es, ht)
  TyFnT(_, r, _) -> ty_cont_needs(r, es, ht)
  _ -> false
}


fn cont_named_needs(s: SymId, args: [Ty], es: SymId, ht: HandleTab) : Bool =
  cont_needs_any(args, es, ht)
    or (any(args, (a) => row_arg_names(a, es)) and named_holds(core_ty_sym(CtCont), s, ht))


fn cont_needs_any(ts: [Ty], es: SymId, ht: HandleTab) : Bool =
  any(ts, (t) => ty_cont_needs(t, es, ht))


# A row carrier naming the effect `es`, bare of any cell.
fn row_arg_names(t: Ty, es: SymId) : Bool = match t {
  TyFnT([], TyUnit, row) -> any(row.labels, (l) => sym_raw(es) >= 0 and sym_raw(l.sym) == sym_raw(es) and not label_is_aliased_cell(l))
  _ -> false
}


fn named_holds(h: SymId, s: SymId, ht: HandleTab) : Bool = sym_list_has(ht_carriers(ht, h), s)


# Named types that transitively hold a Fiber or Pid, computed once per program
# so a return-type check consults a table instead of re-expanding declarations.
#[doc("Typer-internal type `HandleTab` shared across the infer modules.")]
pub type HandleTab = HT([SymId], [SymId], [SymId])


# A declared type and the named types its fields or payloads mention.
type TypeDeps = TD(SymId, [SymId])


#[doc("The types that hold a handle before any program type is read: Fiber, Pid, Cont and Seq.")]
pub fn hold_seed() : [HoldAt] =
  [HA(core_ty_sym(CtFiber), Hold(true, false, false)), HA(core_ty_sym(CtPid), Hold(true, false, false)),
   HA(core_ty_sym(CtCont), Hold(false, true, false)), HA(core_decl_ty_id(CdSeq), Hold(false, false, true))]


#[doc("The marks `prev` extended with what a module's own sums and records hold. A type only mentions types of its own module or an imported one, so the marks of earlier modules stay final and the closure is the same one the whole program would give.")]
pub fn hold_extend(env: TyEnv, sums: [SumInfo], recs: [RecInfo], prev: [HoldAt]) : [HoldAt] =
  hold_close(type_deps(env, sums, recs), prev)


#[doc("The handle table a set of hold marks answers.")]
pub fn handle_tab_of(marks: [HoldAt]) : HandleTab {
  HT(flat_map(marks, (m) => match m { HA(sy, Hold(f, _, _)) -> if f { [sy] } else { [] } }),
     flat_map(marks, (m) => match m { HA(sy, Hold(_, c, _)) -> if c { [sy] } else { [] } }),
     flat_map(marks, (m) => match m { HA(sy, Hold(_, _, q)) -> if q { [sy] } else { [] } }))
}


# What a type holds: a Fiber or Pid, a Cont, a Seq.
#[doc("Typer-internal type `Hold` shared across the infer modules.")]
pub type Hold = Hold(Bool, Bool, Bool)

#[doc("Typer-internal type `HoldAt` shared across the infer modules.")]
pub type HoldAt = HA(SymId, Hold)


fn hold_or(a: Hold, b: Hold) : Hold = match a {
  Hold(f1, c1, q1) -> match b { Hold(f2, c2, q2) -> Hold(f1 or f2, c1 or c2, q1 or q2) }
}


fn hold_adds(m: Hold, old: Hold) : Bool = match m {
  Hold(f, c, q) -> match old { Hold(f0, c0, q0) -> (f and not f0) or (c and not c0) or (q and not q0) }
}


# Newest mark first: a type's later marks only ever add to its earlier ones.
fn hold_of(marks: [HoldAt], s: SymId) : Hold = match marks {
  [] -> Hold(false, false, false)
  [HA(sy, h), ...rest] -> if sym_same(sy, s) { h } else { hold_of(rest, s) }
}


fn hold_close(deps: [TypeDeps], marks: [HoldAt]) : [HoldAt] {
  let fresh = flat_map(deps, (d) => match d {
    TD(sy, ms) -> {
      let old = hold_of(marks, sy)
      let m = foldl(ms, old, (a, x) => hold_or(a, hold_of(marks, x)))
      if hold_adds(m, old) { [HA(sy, m)] } else { [] }
    }
  })
  if list_length(fresh) == 0 { marks } else { hold_close(deps, concat([fresh, marks])) }
}


# The carriers of the handle type `h`: Cont, Seq, or Fiber/Pid.
fn ht_carriers(ht: HandleTab, h: SymId) : [SymId] = match ht {
  HT(fp, cont, seq) ->
    if sym_same(h, core_ty_sym(CtCont)) { cont }
    else if sym_same(h, core_decl_ty_id(CdSeq)) { seq }
    else { fp }
}


# A sum's payload types are read from its constructors' schemes, which the
# environment already holds resolved; only a record's fields are resolved here.
fn type_deps(env: TyEnv, sums: [SumInfo], recs: [RecInfo]) : [TypeDeps] {
  let hv = env_home_view(env, None)
  concat([
    map(sums, (si) => match si {
      SI(sy, _, _, _) -> TD(sy, foldl(env_ctors(env, sy), [], (acc, e) => match e.scheme {
        Scheme(_, _, _, _, TyFnT(ps, _, _)) -> foldl(ps, acc, (a, p) => ty_syms(p, a))
        _ -> acc
      }))
    }),
    map(recs, (ri) => match ri {
      RI(sy, _, fs, mo) -> TD(sy, foldl(fs, [], (acc, f) => match f {
        FD(_, _, te, _) -> te_syms(tsh_at(hv, mo), te, acc)
      }))
    })])
}


# The named types a resolved type mentions, prepended to `acc`.
fn ty_syms(t: Ty, acc: [SymId]) : [SymId] = match t {
  TyCon(s, args) -> foldl(args, if sym_raw(s) >= 0 { [s, ...acc] } else { acc }, (a, x) => ty_syms(x, a))
  TyListT(x) -> ty_syms(x, acc)
  TyFnT(ps, r, _) -> ty_syms(r, foldl(ps, acc, (a, x) => ty_syms(x, a)))
  TyDimT(x, _) -> ty_syms(x, acc)
  TyRefineT(x, _) -> ty_syms(x, acc)
  TyUnion(parts) -> foldl(parts, acc, (a, x) => ty_syms(x, a))
  _ -> acc
}


# The named types `t` mentions, prepended to `acc`.
fn te_syms(hv: TyHomeView, t: TypeExpr, acc: [SymId]) : [SymId] = match t.tkind {
  TyName(r, tas) -> {
    let s = ref_ty_sym(hv, r)
    foldl(tas, if sym_raw(s) >= 0 { [s, ...acc] } else { acc }, (a, x) => te_syms(hv, x, a))
  }
  TyList(inner) -> te_syms(hv, inner, acc)
  TyFn(ps, ret, _) -> te_syms(hv, ret, foldl(ps, acc, (a, x) => te_syms(hv, x, a)))
  TyDim(base, _) -> te_syms(hv, base, acc)
  TyRefine(base, _) -> te_syms(hv, base, acc)
  TyRow(_) -> acc
  TySurface(ts) -> foldl(tysurface_children(ts), acc, (a, x) => te_syms(hv, x, a))
  TyParam(_, tas) -> foldl(tas, acc, (a, x) => te_syms(hv, x, a))
}


# `t` is, or has among its parts, a type of `hs`.
fn ty_mentions(hs: [SymId], t: Ty) : Bool = match t {
  TyCon(s, args) -> sym_list_has(hs, s) or any(args, (a) => ty_mentions(hs, a))
  TyListT(x) -> ty_mentions(hs, x)
  TyFnT(ps, r, _) -> any(ps, (a) => ty_mentions(hs, a)) or ty_mentions(hs, r)
  TyDimT(x, _) -> ty_mentions(hs, x)
  TyRefineT(x, _) -> ty_mentions(hs, x)
  TyUnion(parts) -> any(parts, (a) => ty_mentions(hs, a))
  _ -> false
}


# The breach found in a type, and the named types already explored: a type
# explored without a hit is never walked again, so the walk is linear in the
# type graph however many paths reach it.
type HandleWalk = HW(Option[HandleBreach], [SymId])


fn ty_expr_find_handle(hv: TyHomeView, hsym: SymId, t: TypeExpr,
                        sums: [SumInfo], recs: [RecInfo], visited: [SymId]) : Option[HandleBreach] =
  match handle_walk(hv, hsym, t, sums, recs, visited) { HW(b, _) -> b }


# `hv` reads the type names `t` writes: the module that wrote `t`.
fn handle_walk(hv: TyHomeView, hsym: SymId, t: TypeExpr,
               sums: [SumInfo], recs: [RecInfo], seen: [SymId]) : HandleWalk =
  match t.tkind {
    TyName(r, tas) -> {
      let s = ref_ty_sym(hv, r)
      if sym_raw(s) >= 0 and sym_same(s, hsym) { HW(Some(HBDirect), seen) }
      else {
        match handle_walk_list(hv, hsym, tas, sums, recs, seen) {
          HW(Some(b), sn) -> HW(Some(b), sn)
          HW(None, sn) ->
            if sym_raw(s) < 0 or sym_list_has(sn, s) { HW(None, sn) }
            else { handle_walk_decl(hv, hsym, s, tas, sums, recs, [s, ...sn]) }
        }
      }
    }
    TyList(inner) -> handle_walk(hv, hsym, inner, sums, recs, seen)
    TyFn(ps, ret, _) -> match handle_walk_list(hv, hsym, ps, sums, recs, seen) {
      HW(Some(b), sn) -> HW(Some(b), sn)
      HW(None, sn) -> handle_walk(hv, hsym, ret, sums, recs, sn)
    }
    TyDim(base, _) -> handle_walk(hv, hsym, base, sums, recs, seen)
    TyRefine(base, _) -> handle_walk(hv, hsym, base, sums, recs, seen)
    TyRow(_) -> HW(None, seen)
    TySurface(ts) -> handle_walk_list(hv, hsym, tysurface_children(ts), sums, recs, seen)
    TyParam(_, tas) -> handle_walk_list(hv, hsym, tas, sums, recs, seen)
  }


fn handle_walk_list(hv: TyHomeView, hsym: SymId, ts: [TypeExpr],
                    sums: [SumInfo], recs: [RecInfo], seen: [SymId]) : HandleWalk =
  match ts {
    [] -> HW(None, seen)
    [t, ...rest] -> match handle_walk(hv, hsym, t, sums, recs, seen) {
      HW(Some(b), sn) -> HW(Some(b), sn)
      HW(None, sn) -> handle_walk_list(hv, hsym, rest, sums, recs, sn)
    }
  }


fn handle_walk_decl(hv: TyHomeView, hsym: SymId, s: SymId, tas: [TypeExpr],
                    sums: [SumInfo], recs: [RecInfo], seen: [SymId]) : HandleWalk =
  match sum_find(sums, s) {
    Some(SI(ssym, tps, vs, smo)) ->
      walk_variants(tsh_at(hv, smo), hsym, vs, build_tparam_mapping(tps, tas), sums, recs, seen, ssym)
    None -> match rec_find(recs, s) {
      Some(RI(rsym, tps, fs, rmo)) ->
        walk_fields(tsh_at(hv, rmo), hsym, fs, build_tparam_mapping(tps, tas), sums, recs, seen, rsym)
      None -> HW(None, seen)
    }
  }


fn walk_fields(hv: TyHomeView, hsym: SymId, fs: [FieldDecl], mapping: [TParamMapEntry],
               sums: [SumInfo], recs: [RecInfo], seen: [SymId], rsym: SymId) : HandleWalk =
  match fs {
    [] -> HW(None, seen)
    [FD(_, _, te, _), ...rest] -> match handle_walk(hv, hsym, subst_tparams_te(te, mapping), sums, recs, seen) {
      HW(Some(_), sn) -> HW(Some(HBRec(rsym)), sn)
      HW(None, sn) -> walk_fields(hv, hsym, rest, mapping, sums, recs, sn, rsym)
    }
  }


fn walk_variants(hv: TyHomeView, hsym: SymId, vs: [Variant], mapping: [TParamMapEntry],
                 sums: [SumInfo], recs: [RecInfo], seen: [SymId], ssym: SymId) : HandleWalk =
  match vs {
    [] -> HW(None, seen)
    [Var(csym, payload), ...rest] -> match handle_walk_list(hv, hsym, map(payload, (te) => subst_tparams_te(te, mapping)), sums, recs, seen) {
      HW(Some(_), sn) -> HW(Some(HBSum(ssym, csym)), sn)
      HW(None, sn) -> walk_variants(hv, hsym, rest, mapping, sums, recs, sn, ssym)
    }
  }


# Tparam->TypeExpr mapping built from a sum's [tparams] zipped with
# the type-args at the use site. When the use site provides fewer
# type-args than the type declares (rare, but possible on a not-yet-
# fully-applied alias), the missing entries are skipped — the walker
# treats the unbound name as opaque (no Fiber/Pid hidden behind it).
type TParamMapEntry = TPM(TLocalId, TypeExpr)


fn build_tparam_mapping(tps: [TBinder], tas: [TypeExpr]) : [TParamMapEntry] {
  match tps {
    [] -> []
    [tp, ...tps_rest] -> match tas {
      [] -> []
      [ta, ...tas_rest] -> [TPM(tp.id, ta), ...build_tparam_mapping(tps_rest, tas_rest)]
    }
  }
}


fn tparam_lookup(mapping: [TParamMapEntry], id: TLocalId) : Option[TypeExpr] {
  match mapping {
    [] -> None
    [m, ...rest] -> match m {
      TPM(n, te) -> if tlocal_eq(n, id) { Some(te) } else { tparam_lookup(rest, id) }
    }
  }
}


# substitute tparam references in a payload TypeExpr
# with their concrete TypeExpr at the use site. Only a parameter
# with no arguments is a candidate for substitution. The substitution
# is purely structural; positions are preserved.
fn subst_tparams_te(t: TypeExpr, mapping: [TParamMapEntry]) : TypeExpr {
  match t.tkind {
    TyParam(p, tas) -> {
      if list_length(tas) == 0 {
        match tparam_lookup(mapping, p) {
          Some(replacement) -> replacement
          None              -> t
        }
      } else {
        mk_ty(TyParam(p, subst_tparams_tes(tas, mapping)), t.line, t.col)
      }
    }
    TyName(th, tas) -> mk_ty(TyName(th, subst_tparams_tes(tas, mapping)), t.line, t.col)
    TyList(inner) ->
      mk_ty(TyList(subst_tparams_te(inner, mapping)), t.line, t.col)
    TyFn(ps, ret, row) ->
      mk_ty(TyFn(subst_tparams_tes(ps, mapping),
                 subst_tparams_te(ret, mapping), row), t.line, t.col)
    TyDim(base, u) ->
      mk_ty(TyDim(subst_tparams_te(base, mapping), u), t.line, t.col)
    TyRefine(base, p) ->
      mk_ty(TyRefine(subst_tparams_te(base, mapping), p), t.line, t.col)
    # a compound-row payload is passed through unchanged,
    # matching the `TyFn` arm above (which leaves its row untouched).
    # The carrier is dissolved by alias substitution, not here.
    TyRow(_) -> t
    TySurface(ts) ->
      mk_ty(TySurface(tysurface_rebuild(ts, subst_tparams_tes(tysurface_children(ts), mapping))),
            t.line, t.col)
  }
}


fn subst_tparams_tes(ts: [TypeExpr], mapping: [TParamMapEntry]) : [TypeExpr] {
  match ts {
    [] -> []
    [t, ...rest] -> [subst_tparams_te(t, mapping),
                     ...subst_tparams_tes(rest, mapping)]
  }
}


# A row hole (`/ ?e`) asks for the row to be inferred, so it absorbs.
#[doc("Typer-internal helper `declares_row_hole` shared across the infer modules.")]
pub fn declares_row_hole(declared: RowExpr, tps: [TBinder]) : Bool = match declared {
  ROpen(TpId(id), _) -> any(tps, (b) => tb_is_hole(b) and tlocal_eq(b.id, id))
  _                  -> false
}


#[doc("Typer-internal helper `check_body_tails` shared across the infer modules.")]
pub fn check_body_tails(st: InferState, fname: String, declared: Int, rbinds: [RVBind], tps: [TBinder],
                    us: [TailUse]) : InferState / Console + File + Mutable = match us {
  [] -> st
  [TU(t, l, c), ...rest] -> {
    let root = row_root(st.sub, t)
    let st1 = if root < 0 or root == declared { st } else {
      match sig_row_var_at(st.sub, rbinds, root) {
        Some(n) -> report_row_var_unhandled(st, fname, tbs_text_of(tps, n), l, c)
        None    -> st
      }
    }
    check_body_tails(st1, fname, declared, rbinds, tps, rest)
  }
}


# The variable a row variable resolves to, or -1 once its row is closed.
#[doc("Typer-internal helper `row_root` shared across the infer modules.")]
pub fn row_root(s: Subst, t: Int) : Int = match subst_row_lookup(s, t) {
  None    -> t
  Some(r) -> match r.tail {
    Some(v) -> row_root(s, v)
    None    -> -1
  }
}


#[doc("Typer-internal helper `is_sig_row` shared across the infer modules.")]
pub fn is_sig_row(s: Subst, rbinds: [RVBind], root: Int) : Bool = match sig_row_var_at(s, rbinds, root) {
  Some(_) -> true
  None    -> false
}


# The signature row variable that `root` stands for, if any.
fn sig_row_var_at(s: Subst, rbinds: [RVBind], root: Int) : Option[TLocalId] = match rbinds {
  [] -> None
  [RVB(n, id), ...rest] -> if row_root(s, id) == root { Some(n) } else { sig_row_var_at(s, rest, root) }
}


#[doc("Typer-internal helper `declared_root` shared across the infer modules.")]
pub fn declared_root(s: Subst, declared: RowExpr, rbinds: [RVBind]) : Int = match declared {
  ROpen(n, _) -> match inf_rvbind_lookup(rbinds, tail_id(n)) {
    Some(id) -> row_root(s, id)
    None     -> -1
  }
  _ -> -1
}


fn report_row_var_unhandled(st: InferState, fname: String, n: String, line: Int, col: Int) : InferState / Console + File {
  let header = "effect not handled: #{n}"
  let n1 = "`#{fname}`'s declared row does not include the row variable `#{n}`"
  let h1 = "add `/ #{n}` to `#{fname}`'s return type, or handle every effect `#{n}` stands for"
  let d = mk_diag(SevError, st.file, line, col, header, [ri_note(st.file, line, col, n1), ri_help(st.file, line, col, h1)])
  st_bump_err(st_push_diag(st, d))
}


# Labels for which `emit_main_wrapper` does NOT
# install a default handler. The runtime default-handler set is the
# fixed list in `default_shims_for` (Stdout, Stderr, Stdin,
# Env, File, Clock, Random, SecureRandom, NetTcp, Signal, Process,
# Log, Mutable, Cancel, Link, Monitor, Spawn). Anything outside that
# set — `Ffi` (capability tag, no default handler by design) plus any
# user-defined effect (no runtime evidence wired up) — must NOT be
# absorbed by main; reject explicitly so the program does not segfault.
#[doc("Typer-internal helper `only_non_absorbed_labels` shared across the infer modules.")]
pub fn only_non_absorbed_labels(st: InferState, row: [Label], decls: [Decl]) : [Label] {
  match row {
    [] -> []
    [h, ...rest] ->
      if label_absorbed(h, decls) {
        only_non_absorbed_labels(st, rest, decls)
      } else {
        [h, ...only_non_absorbed_labels(st, rest, decls)]
      }
  }
}


# The labels a test/bench/check body may NOT absorb: everything the
# program entry could neither absorb nor declare. `Ffi` is exempt on
# top of the default-handled set because `check_main_row_handlable`
# accepts it in `main`'s declared row (capability tag, no handler to
# install) and a test block has no row surface to opt in through.
#[doc("Typer-internal helper `test_non_absorbed_labels` shared across the infer modules.")]
pub fn test_non_absorbed_labels(st: InferState, row: [Label], decls: [Decl]) : [Label] =
  only_non_absorbed_labels(st, filter(row, (h) => not effect_is_foreign(h.sym)), decls)


# A label `main` absorbs: the declaration it names carries an all-extern
# default, or it is a parametric stdlib effect whose handler the `var`
# desugar installs. A root homonym without a default names itself, so the
# prelude's handler is never installed for its ops.
#[doc("Typer-internal helper `label_absorbed` shared across the infer modules.")]
pub fn label_absorbed(h: Label, decls: [Decl]) : Bool =
  effect_decl_default_all_extern(effect_decl_of(h.sym, decls)) or is_parametric_handlerless_stdlib_eff(h.sym)


# Parametric stdlib effects whose handlers are always user-installed
# (`var x = init` desugar wraps `with State[T](init) { ... }`). They
# carry no runtime default but main absorption stays true so the sugar
# surface keeps compiling — see the long comment on the legacy
# `is_absorbable_stdlib_eff` for the row-arithmetic rationale.
fn is_parametric_handlerless_stdlib_eff(s: SymId) : Bool =
  effect_is_any(s, [CeState, CeReader, CeWriter])


# walk `main`'s body row reporting any label whose
# effect lacks an `emit_main_wrapper` default handler. Catches
# `main : Int / Net` where `Net` is user-declared: nothing installs
# a handler, the binary segfaults the first time the op runs.
# `Ffi` is naturally caught here too.
#[doc("Typer-internal helper `check_main_row_handlable` shared across the infer modules.")]
pub fn check_main_row_handlable(st: InferState, body_row: [Label],
                             line: Int, col: Int, decls: [Decl]) : InferState / Console + File {
  match body_row {
    [] -> st
    [h, ...rest] -> {
      # `Ffi` is the capability-only effect that crosses
      # to C. There is no `emit_main_wrapper` shim for it (by design;
      # the C ABI is the handler), but declaring it in main's row is
      # exactly how a program "earns" the right to call extern fns
      # directly. Treat it as handlable here so `main : Int / Ffi`
      # still typechecks; the REmpty path keeps rejecting an
      # undeclared Ffi label so the silent contract holds.
      let st1 = if effect_is_foreign(h.sym) or label_absorbed(h, decls) { st }
      else {
        let use_eu = lookup_eff_use(st.eff_uses, h)
        match use_eu {
          EU(_, uline, ucol) -> {
            let ln = if uline >= 0 { uline } else { line }
            let cl = if ucol  >= 0 { ucol  } else { col  }
            let shown = inf_tycon_display_ow(st.env.tab, st.env.head_owners, h.sym)
            let header = string_concat("`main` declares effect `",
              string_concat(shown,
                "` but no default handler is installed for it"))
            let perr = mk_diag(SevError, st.file, ln, cl, header, [])
            st_bump_err(st_help(st_help(st_note(st_note(st_push_diag(st, perr), "only the canonical stdlib effects (Stdout, Stderr, Stdin, Env, File, Clock, Random, SecureRandom, NetTcp, Signal, Process, Log, Mutable, Cancel, Link, Monitor, Spawn) receive a default handler from the `main` wrapper"), "`#{shown}` is either user-declared or a capability-only effect (e.g. `Ffi`); the runtime would have no evidence for it at the top level"), "wrap the body in `handle { ... } with #{shown} { ... }` so the effect is closed before reaching `main`'s scope"), "or remove `/ #{shown}` from `main`'s declared row if the call site is dead code"))
          }
        }
      }
      check_main_row_handlable(st1, rest, line, col, decls)
    }
  }
}


# What encloses an effect-row check: a function with a signature, or a
# `test` / `bench` / `check` block, which has none.
#[doc("Typer-internal type `RowScope` shared across the infer modules.")]
pub type RowScope = RowInFn(String) | RowInBlock(String)


#[doc("Typer-internal helper `scope_row_note` shared across the infer modules.")]
pub fn scope_row_note(sc: RowScope, lab_str: String) : String = match sc {
  RowInFn(f)    -> "`#{f}`'s declared row does not include `#{lab_str}`"
  RowInBlock(k) -> "this `#{k}` block's row is empty"
}


#[doc("Typer-internal helper `scope_row_help` shared across the infer modules.")]
pub fn scope_row_help(sc: RowScope, lab_str: String, free_instance: Bool) : String = match sc {
  RowInFn(f) -> if free_instance {
    "replace each `_` in `#{lab_str}` with the instance `#{f}` runs under, a concrete type or one of its type parameters, and declare it in `#{f}`'s row"
  } else {
    "add `/ #{lab_str}` to `#{f}`'s return type, or wrap the call in `handle { ... } with #{lab_str} { ... }`"
  }
  RowInBlock(_) -> if free_instance {
    "replace each `_` in `#{lab_str}` with a concrete type, and wrap the call in `handle { ... } with #{lab_str} { ... }`"
  } else {
    "wrap the call in `handle { ... } with #{lab_str} { ... }`"
  }
}


# A blamed `Mutable` is reported at the demand the masking pass rejected,
# not where `Mutable` first entered the row.
#[doc("Typer-internal helper `blamed_use` shared across the infer modules.")]
pub fn blamed_use(uses: [EffUse], lab: Label, blame: Option[MutBlame]) : EffUse = match blame {
  Some(MB(d, _)) -> EU(lab, d.line, d.col)
  None           -> lookup_eff_use(uses, lab)
}


#[doc("Typer-internal helper `blame_via_notes` shared across the infer modules.")]
pub fn blame_via_notes(blame: Option[MutBlame]) : [SpanNote] = match blame {
  Some(MB(_, Some(n))) -> [n]
  _                    -> []
}


# render a Label for diagnostics. Bare-name labels render
# as the eff name; parameterised labels render as `Eff[T1, T2]` with
# each ty_arg passed through `inf_ty_to_string` so unbound TyVars show as
# `?tN`.
#[doc("An effect label as the reader wrote it: the head shown as `mod.Eff` when its name is contested, its type arguments untouched.")]
pub fn label_display(tab: SymTab, owners: [HeadOwnerEntry], l: Label) : String =
  label_with_args(inf_tycon_display_ow(tab, owners, l.sym), map(l.ty_args, (t) => inf_ty_to_string(tab, t)))


#[doc("Typer-internal helper `label_with_args` shared across the infer modules.")]
pub fn label_with_args(head: String, args: [String]) : String = match args {
  [] -> head
  _  -> concat_all([head, "[", inf_join_with(args, ", "), "]"])
}


#[doc("infer: an effect label as a diagnostic names it: the effect's declared name and its type arguments.")]
pub fn label_to_string(tab: SymTab, l: Label) : String =
  label_with_args(written_text(decl_name(tab, l.sym)), map(l.ty_args, (t) => inf_ty_to_string(tab, t)))

