#[doc("What one module can see: the scope view a file resolves under, the rungs a bare name climbs before it resolves, and the contested bare names a diagnostic asks the author to qualify.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.symtab
import compiler.written
import compiler.util
import compiler.module_table
import compiler.package_id
import compiler.infer_index
import compiler.core_refs

#[doc("The modules one file can see: its own home, the names its selective imports pick, the modules its plain imports open, and the prelude cores. `quals` are the qualifiers the file binds, each to its module; they open nothing. `pkgs` binds a module to the package it belongs to, for the modules that sit in one.")]
pub(pkg) type ScopeView = { home: SymId, picks: [SvPick], imports: [SymId], cores: [SymId], quals: [SvPick], pkgs: [PkgPick] }

#[doc("One name a selective import picks, bound to the module that exports it.")]
pub(pkg) type SvPick = SvPick(String, SymId)

#[doc("A module and the package that owns it.")]
pub(pkg) type PkgPick = PkgPick(PkgId, SymId)

#[doc("A view that sees nothing but its own home. The root file before any import is resolved.")]
pub(pkg) fn sv_of_home(home: SymId) : ScopeView =
  ScopeView { home: home, picks: [], imports: [], cores: [], quals: [], pkgs: [] }

#[doc("The view of a file homed at `home`, picking `picks`, importing `imports`, over the prelude `cores`.")]
pub(pkg) fn sv_new(home: SymId, picks: [SvPick], imports: [SymId],
      cores: [SymId]) : ScopeView =
  ScopeView { home: home, picks: picks, imports: imports, cores: cores, quals: [], pkgs: [] }

fn sv_at_home(v: ScopeView, home: SymId) : ScopeView =
  ScopeView { ...v, home: home }

fn sv_with_quals(v: ScopeView, quals: [SvPick]) : ScopeView = ScopeView { ...v, quals: quals }

fn sv_with_pkgs(v: ScopeView, pkgs: [PkgPick]) : ScopeView = ScopeView { ...v, pkgs: pkgs }

#[doc("Whether the declaration `s`, owned by the module `owner`, is within reach of this view's package: a declaration exported to its package alone is seen from the modules of that package, and a package is a directory with a manifest.")]
pub(pkg) fn sv_pkg_reaches(t: SymTab, v: ScopeView, s: SymId, owner: SymId) : Bool =
  list_is_empty(v.pkgs) or not mint_package(sym_mint(t, s)) or sv_same_pkg(v, owner, v.home)

fn sv_same_pkg(v: ScopeView, a: SymId, b: SymId) : Bool = pkgs_same(v.pkgs, a, b)

#[doc("Whether the modules `a` and `b` sit in one package of `ps`.")]
pub(pkg) fn pkgs_same(ps: [PkgPick], a: SymId, b: SymId) : Bool = match sv_pkg_of(ps, a) {
  Some(pa) -> match sv_pkg_of(ps, b) { Some(pb) -> pkg_same(pa, pb)  None -> false }
  None     -> false
}

fn sv_pkg_of(ps: [PkgPick], m: SymId) : Option[PkgId] = match ps {
  [] -> None
  [PkgPick(pkg, o), ...rest] -> if sym_raw(o) == sym_raw(m) { Some(pkg) } else { sv_pkg_of(rest, m) }
}

#[doc("The qualifier the file binds module `m` under, if it binds one.")]
pub(pkg) fn sv_qualifier(v: ScopeView, m: SymId) : Option[String] = sv_qual_of(v.quals, m)

fn sv_qual_of(qs: [SvPick], m: SymId) : Option[String] = match qs {
  [] -> None
  [SvPick(q, o), ...rest] -> if sym_raw(o) == sym_raw(m) { Some(q) } else { sv_qual_of(rest, m) }
}

#[doc("Every rung of the view rendered as text: two views that resolve some name differently render differently. A cache key folds it in.")]
pub(pkg) fn sv_key(v: ScopeView) : String =
  string_concat_all([int_to_string(sym_raw(v.home)), "|", sv_picks_key(v.picks), "|", sv_ids_key(v.imports),
              "|", sv_ids_key(v.cores), "|", sv_picks_key(v.quals), "|", pkg_text(pkgs_root(v.pkgs, v.home))])

fn sv_ids_key(ms: [SymId]) : String = string_join(map(ms, (m) => int_to_string(sym_raw(m))), ",")

fn sv_picks_key(ps: [SvPick]) : String =
  string_join(map(ps, (p) => match p { SvPick(n, m) -> string_concat_all([n, "@", int_to_string(sym_raw(m))]) }), ",")

#[doc("True when `m` is one of the prelude cores. A core's declarations keep the spelling the runtime is keyed by.")]
pub(pkg) fn sv_is_core(v: ScopeView, m: SymId) : Bool = sv_has(v.cores, m)

#[doc("Between core modules only, the core set's order is a rung order: the one of `ss`, declarations of one name, whose module the set lists last. `None` when any of them is not a core's.")]
pub(pkg) fn sv_last_listed_core(t: SymTab, v: ScopeView, ss: [SymId]) : Option[SymId] =
  if not all(ss, (s) => sv_is_core(v, sym_owner(t, s))) { None }
  else { last_listed(t, v.cores, ss, None) }

fn last_listed(t: SymTab, cores: [SymId], ss: [SymId], found: Option[SymId]) : Option[SymId] = match cores {
  [] -> found
  [c, ...rest] -> match find(ss, (s) => sym_same(sym_owner(t, s), c)) {
    Some(s) -> last_listed(t, rest, ss, Some(s))
    None    -> last_listed(t, rest, ss, found)
  }
}

#[doc("True when the file is the module `m` or imports it in any form: opened, picked from, or bound to a qualifier.")]
pub(pkg) fn sv_imports(v: ScopeView, m: SymId) : Bool =
  sym_raw(m) == sym_raw(v.home) or sv_has(v.imports, m) or sv_names(v.picks, m) or sv_names(v.quals, m)

fn sv_names(ps: [SvPick], m: SymId) : Bool =
  any(ps, (p) => match p { SvPick(_, o) -> sym_raw(o) == sym_raw(m) })

#[doc("True when the file imports the module `m` or sees it as a core.")]
pub(pkg) fn sv_sees(v: ScopeView, m: SymId) : Bool = sv_has(v.imports, m) or sv_has(v.cores, m)

#[doc("True when a bare `name` the module `m` declares sits on one of the file's rungs: its own home, a pick of that name, an opened import, or a core.")]
pub(pkg) fn sv_reaches(v: ScopeView, m: SymId, name: String) : Bool =
  sym_raw(m) == sym_raw(v.home) or sv_sees(v, m) or sv_has(sv_pick_homes(v.picks, name, []), m)

fn sv_has(ms: [SymId], m: SymId) : Bool = match ms {
  [] -> false
  [x, ...rest] -> if sym_raw(x) == sym_raw(m) { true } else { sv_has(rest, m) }
}

# The modules a selective import names this name from. `import m.{T}`
# says which `T` the file means, so it outranks the plain import list
# even when a second import also exports one.
fn sv_pick_homes(ps: [SvPick], name: String, acc: [SymId]) : [SymId] = match ps {
  [] -> acc
  [SvPick(n, m), ...rest] ->
    if n == name and not sv_has(acc, m) { sv_pick_homes(rest, name, [m, ...acc]) }
    else { sv_pick_homes(rest, name, acc) }
}

#[doc("The rungs a bare `name` climbs, outermost last. `SvAny` closes the ladder: a declaration in a module the file never opened still answers, so the use can be reported as not imported or private rather than unknown.")]
pub(pkg) type SvRung = SvOwn | SvPicks | SvImports | SvCores | SvAny

#[doc("The ladder every name class climbs, in order.")]
pub(pkg) fn sv_rungs() : [SvRung] = [SvOwn, SvPicks, SvImports, SvCores, SvAny]

#[doc("What resolving a name against a view decided. `SvPrivate` names the home of a declaration that exists but this view cannot reach, which a diagnostic reports differently from a name nothing declares.")]
pub(pkg) type SvRes = SvSym(SymId) | SvAmbig([SymId]) | SvNone | SvPrivate(SymId)

#[doc("""
The symbol `name` of class `cls` reaches from this view.

Each rung is tried in turn and the first that holds a candidate
answers. One candidate resolves; two or more are an ambiguity, because
a rung that cannot tell them apart has no ground to prefer either.
""")]
pub(pkg) fn sv_resolve(t: SymTab, v: ScopeView, cls: NCls, name: String) : SvRes =
  sv_climb(t, v, sv_rungs(), st_candidates(t, cls, name))

#[doc("""
The symbol `name` reaches when several classes share one namespace at
the use site — the three value classes, where a function, a constant
and a constructor all answer to a bare name.

The rungs are climbed once over the union, not once per class: a
constant at home must beat a function two modules away, which resolving
each class apart and choosing between the answers cannot express.
""")]
pub(pkg) fn sv_resolve_any(t: SymTab, v: ScopeView, cs: [NCls], name: String) : SvRes =
  sv_climb(t, v, sv_rungs(), sv_cands_of(t, cs, name))

#[doc("""
The exported declarations a bare `name` across `cs` would reach only
through modules this file does not import: no candidate is the file's
own, picked, opened or a core. Empty when a rung answers, or nothing
hidden competes.

A core is compiled against the other cores alone, so nothing is hidden
from it.
""")]
pub(pkg) fn sv_hidden(t: SymTab, v: ScopeView, cs: [NCls], name: String) : [SymId] =
  match sv_cands_of(t, cs, name) {
    [] -> []
    cands ->
      if sv_is_core(v, v.home) or sv_any_visible(t, v, cands, name) { [] }
      else { list_reverse(sv_exported(t, cands, [])) }
  }

fn sv_any_visible(t: SymTab, v: ScopeView, cands: [SymId], name: String) : Bool = match cands {
  [] -> false
  [s, ...rest] -> {
    let o = sym_owner(t, s)
    sym_raw(o) == sym_raw(v.home) or sv_reserved(o) or sym_exported(t, s) and sv_pkg_reaches(t, v, s, o) and sv_reaches(v, o, name)
      or sv_any_visible(t, v, rest, name)
  }
}

# What the runtime builds has no module to import.
fn sv_reserved(o: SymId) : Bool = sym_raw(o) == sym_raw(st_module_id(core_type_home()))

fn sv_exported(t: SymTab, cands: [SymId], acc: [SymId]) : [SymId] = match cands {
  [] -> acc
  [s, ...rest] ->
    if sym_exported(t, s) and not sv_owner_seen(t, acc, sym_owner(t, s)) { sv_exported(t, rest, [s, ...acc]) }
    else { sv_exported(t, rest, acc) }
}

#[doc("The symbol `name` reaches on the rungs nearer than the cores, across the classes `cs`: what the reader's module declares, picks or imports.")]
pub(pkg) fn sv_resolve_near(t: SymTab, v: ScopeView, cs: [NCls], name: String) : SvRes =
  sv_climb(t, v, sv_near_rungs(), sv_cands_of(t, cs, name))

#[doc("The rungs nearer than the cores: the file's own module, its selective imports and its imports.")]
pub(pkg) fn sv_near_rungs() : [SvRung] = [SvOwn, SvPicks, SvImports]

#[doc("What an arity-checked climb decided: the answer, and the nearest declaration it passed over because the call's arity did not fit it.")]
pub(pkg) type SvFit = SvFit(SvRes, Option[SymId])

#[doc("""
The symbol a call of `name` reaches across the classes `cs`, climbing
`rungs`: the first rung holding a visible candidate that `fits` answers.

A rung whose visible candidates all fail `fits` is passed over, never
answered by, and its first candidate is reported so the caller can name
what the call skipped. `SvNone` when no rung answers.
""")]
pub(pkg) fn sv_resolve_fit(t: SymTab, v: ScopeView, rungs: [SvRung], cs: [NCls],
      name: String, fits: (SymId) -> Bool) : SvFit =
  sv_climb_fit(t, v, rungs, sv_cands_of(t, cs, name), fits, None)

#[doc("The nearest of `rungs` holding any of `cands`, declarations of one name: alone there it answers, several are the tie.")]
pub(pkg) fn sv_nearest(t: SymTab, v: ScopeView, rungs: [SvRung], cands: [SymId]) : SvRes =
  match sv_climb_fit(t, v, rungs, cands, (_s) => true, None) {
    SvFit(r, _) -> r
  }

fn sv_climb_fit(t: SymTab, v: ScopeView, rungs: [SvRung], cands: [SymId],
      fits: (SymId) -> Bool, skipped: Option[SymId]) : SvFit =
  match rungs {
    [] -> SvFit(SvNone, skipped)
    [r, ...rest] -> {
      let on = list_reverse(sv_on_rung(t, v, r, cands, []))
      match filter(on, fits) {
        []  -> sv_climb_fit(t, v, rest, cands, fits, sv_first_skip(skipped, on))
        [s] -> SvFit(SvSym(s), skipped)
        ss  -> SvFit(SvAmbig(ss), skipped)
      }
    }
  }

fn sv_first_skip(skipped: Option[SymId], on: [SymId]) : Option[SymId] = match skipped {
  Some(_) -> skipped
  None    -> match on {
    [s, ..._] -> Some(s)
    []        -> None
  }
}

# One hash probe for every class; the candidates stay grouped by class, in `cs` order.
fn sv_cands_of(t: SymTab, cs: [NCls], name: String) : [SymId] = match st_by_name(t, name) {
  [] -> []
  all -> sv_cands_by_class(t, cs, all)
}

fn sv_cands_by_class(t: SymTab, cs: [NCls], all: [SymId]) : [SymId] = match cs {
  [] -> []
  [c, ...rest] -> list_append(filter(all, (s) => ncls_same(sym_class(t, s), c)), sv_cands_by_class(t, rest, all))
}

fn sv_climb(t: SymTab, v: ScopeView, rungs: [SvRung], cands: [SymId]) : SvRes =
  match rungs {
    [] -> sv_unreached(cands)
    [r, ...rest] -> match sv_on_rung(t, v, r, cands, []) {
      []  -> sv_climb(t, v, rest, cands)
      [s] -> SvSym(s)
      ss  -> SvAmbig(list_reverse(ss))
    }
  }

# Every rung is exhausted. A candidate the walk saw but never admitted
# is a declaration this view cannot reach — reported as private, naming
# a home, rather than as a name nothing declares.
fn sv_unreached(cands: [SymId]) : SvRes = match cands {
  []       -> SvNone
  [s, ..._] -> SvPrivate(s)
}

# A candidate is on a rung when its owner is a module that rung admits
# and it is reachable from here: a foreign declaration must be
# exported, one at home need not be.
fn sv_on_rung(t: SymTab, v: ScopeView, r: SvRung, cands: [SymId],
      acc: [SymId]) : [SymId] = match cands {
  [] -> acc
  [s, ...rest] -> {
    let owner = sym_owner(t, s)
    let at_home = sym_raw(owner) == sym_raw(v.home)
    let ok = sv_admits(v, r, owner, written_text(sym_name(t, s))) and
             (at_home or sym_exported(t, s) and sv_pkg_reaches(t, v, s, owner)) and
             not sv_owner_seen(t, acc, owner)
    if ok { sv_on_rung(t, v, r, rest, [s, ...acc]) }
    else { sv_on_rung(t, v, r, rest, acc) }
  }
}

#[doc("True when the rung `r` of this view admits a bare `name` declared by the module `owner`.")]
pub(pkg) fn sv_admits(v: ScopeView, r: SvRung, owner: SymId, name: String) : Bool =
  sv_tier_ok(v, owner) and sv_on(v, r, owner, name)

# A core sees only other cores. The prelude is compiled once and must
# not resolve a name against user code that happens to be loaded with
# it, so a view homed in a core admits no non-core declaration.
fn sv_tier_ok(v: ScopeView, owner: SymId) : Bool =
  if sv_is_core(v, v.home) { sv_is_core(v, owner) } else { true }

fn sv_on(v: ScopeView, r: SvRung, owner: SymId, name: String) : Bool = match r {
  SvOwn     -> sym_raw(owner) == sym_raw(v.home)
  SvPicks   -> sv_has(sv_pick_homes(v.picks, name, []), owner)
  SvImports -> sv_has(v.imports, owner)
  SvCores   -> sv_has(v.cores, owner)
  SvAny     -> true
}

# Two declarations from one module never compete on a rung: the module
# is the unit a rung admits, so the first is the one it meant.
fn sv_owner_seen(t: SymTab, acc: [SymId], owner: SymId) : Bool = match acc {
  [] -> false
  [s, ...rest] ->
    if sym_raw(sym_owner(t, s)) == sym_raw(owner) { true }
    else { sv_owner_seen(t, rest, owner) }
}

#[doc("The symbol the qualified `mod.name` of class `cls` reaches: the declaration `mod` homes, ignoring every other module. A qualifier names its module, so no rung applies.")]
pub(pkg) fn sv_qualified(t: SymTab, cls: NCls, modn: String, name: String) : SvRes =
  match st_module(t, modn) {
    None    -> SvNone
    Some(m) -> match st_lookup(t, cls, name, m) {
      Some(s) -> SvSym(s)
      None    -> SvNone
    }
  }

#[doc("The type `modn.name` reaches: the declaration `modn` homes, declared or foreign.")]
pub(pkg) fn sv_qualified_type(t: SymTab, modn: String, name: String) : SvRes =
  match st_module(t, modn) {
    None    -> SvNone
    Some(m) -> match st_type_lookup(t, name, m) {
      Some(s) -> SvSym(s)
      None    -> SvNone
    }
  }

#[doc("The type a bare `name` reaches from the view `v`, declared or foreign.")]
pub(pkg) fn sv_resolve_type(t: SymTab, v: ScopeView, name: String) : SvRes =
  sv_resolve_any(t, v, type_classes(), name)

#[doc("The package of the module `m` in `ps`; none when `m` sits in none.")]
pub(pkg) fn pkgs_root(ps: [PkgPick], m: SymId) : PkgId = unwrap_or(sv_pkg_of(ps, m), pkg_none())

#[doc("Every file's scope view, each found by its home module's id, and the view a home with no recorded file falls back to.")]
pub(pkg) type FileViews = FileViews([ScopeView], ScopeView)

#[doc("""
The per-file views for a program: for each file the loader recorded,
the modules it opens, the names it picks, and the cores every file
sees without importing them.

`root` is the target module's name — the home of every untagged
declaration, and the owner an import table spells `""`. A pick names its
module as its file wrote it, which `scopes` over `global` turns into the
home the module's declarations carry.
""")]
pub(pkg) fn fv_build(imports: [ModImports], sels: [SelImport], scopes: [ModScope],
      global: [ModuleEntry], cores: [String], root: String, pkgs: [PkgPick]) : FileViews {
  let core_ids = fv_ids(cores, [])
  FileViews(map(fv_entries(imports, fv_tag_sels(sels, scopes, global), scopes, fv_origins(global, idx_empty()), core_ids, root, []),
                (v) => sv_with_pkgs(v, pkgs)),
            sv_with_pkgs(fv_bare(core_ids, root), pkgs))
}

#[doc("""
Every selective import with the constructors of each sum type it picks
added: `import m.{Shape}` lets the file write `Circle(1)`. The type and
its variants are exported as one, and a constructor is read under its
type. `decls` is the stream the picked modules' declarations are in, and
`tab` the table that names them.
""")]
pub(pkg) fn sel_with_ctors(sels: [SelImport], scopes: [ModScope], global: [ModuleEntry],
      decls: [Decl], tab: SymTab, root: String) : [SelImport] = match sels {
  [] -> []
  _  -> {
    let sums = fv_sums(decls, tab, root, [])
    map(sels, (s) => match s {
      SelImport(o, written, names) ->
        SelImport(o, written, fv_with_ctors(names, sums, mt_tagged_name(ms_scope_table(scopes, o, global), written), names))
    })
  }
}

#[doc("No file views: every home resolves seeing only its own declarations, the shape a caller with no loader tables gets.")]
pub(pkg) fn fv_empty() : FileViews = FileViews([], sv_of_home(sym_none()))

#[doc("The view of the file owned by the module `home`; a view seeing only that home and the cores when no file was recorded for it.")]
pub(pkg) fn fv_of(v: FileViews, home: SymId) : ScopeView = match v {
  FileViews(vs, fallback) -> match fv_find(vs, home) {
    Some(sv) -> sv
    None     -> sv_at_home(fallback, home)
  }
}

fn fv_find(vs: [ScopeView], home: SymId) : Option[ScopeView] = match vs {
  [] -> None
  [sv, ...rest] -> if sym_raw(sv.home) == sym_raw(home) { Some(sv) } else { fv_find(rest, home) }
}

fn fv_tag_sels(sels: [SelImport], scopes: [ModScope], global: [ModuleEntry]) : [SelImport] =
  map(sels, (s) => match s {
    SelImport(o, written, names) -> SelImport(o, mt_tagged_name(ms_scope_table(scopes, o, global), written), names)
  })

# A file the loader spells `""` is the root file, whose declarations are
# homed in the target module.
fn fv_owner(owner: String, root: String) : String =
  if owner == "" { root } else { owner }

fn fv_entries(imports: [ModImports], sels: [SelImport], scopes: [ModScope],
      origins: NameIndex[FvOrigin], core_ids: [SymId], root: String, acc: [ScopeView]) : [ScopeView] =
  match imports {
    [] -> list_reverse(acc)
    [MImp(owner, names), ...rest] -> {
      let home = fv_owner(owner, root)
      let v = sv_with_quals(fv_view(home, names, sels, core_ids, root), fv_quals(scopes, owner, origins))
      fv_entries(rest, sels, scopes, origins, core_ids, root, [v, ...acc])
    }
  }

# The qualifiers the file `owner` wrote, each bound to the module it names.
fn fv_quals(scopes: [ModScope], owner: String, origins: NameIndex[FvOrigin]) : [SvPick] = match scopes {
  [] -> []
  [MScope(o, mes, _), ...rest] ->
    if o == owner {
      map(mes, (me) => match me {
        ME(written, _, origin, _, _) -> SvPick(written, st_module_id(fv_origin_name(origins, origin, written)))
      })
    } else { fv_quals(rest, owner, origins) }
}

# The name the global table last binds a file under, keyed by the file's
# origin: one pass over the table instead of one per import.
type FvOrigin = FvOrigin(String, String)

fn fv_origins(global: [ModuleEntry], ix: NameIndex[FvOrigin]) : NameIndex[FvOrigin] = match global {
  [] -> ix
  [ME(n, _, o, _, _), ...rest] -> fv_origins(rest, idx_prepend(ix, o, FvOrigin(o, n)))
}

fn fv_origin_name(ix: NameIndex[FvOrigin], origin: String, fallback: String) : String =
  fv_origin_first(idx_chain(ix, origin), origin, fallback)

fn fv_origin_first(es: [FvOrigin], origin: String, fallback: String) : String = match es {
  [] -> fallback
  [FvOrigin(o, n), ...rest] -> if o == origin { n } else { fv_origin_first(rest, origin, fallback) }
}

fn fv_view(home: String, names: [String], sels: [SelImport],
      core_ids: [SymId], root: String) : ScopeView =
  sv_new(st_module_id(home), fv_picks(sels, home, root, []),
         fv_ids(names, []), core_ids)

# A sum type a module declares: its name, its home, its constructors.
type FvSum = FvSum(String, String, [String])

fn fv_sums(ds: [Decl], tab: SymTab, root: String, acc: [FvSum]) : [FvSum] = match ds {
  [] -> acc
  [d, ...rest] -> fv_sums(rest, tab, root, fv_sum(d, tab, root, acc))
}

# A pick is written as a name, so the sum is filed under the names the
# table holds for it and for its constructors.
fn fv_sum(d: Decl, tab: SymTab, root: String, acc: [FvSum]) : [FvSum] = match d {
  DType(_, s, _, TBSum(vs), _, _, mo, _) ->
    [FvSum(written_text(sym_name(tab, s)), fv_mo_home(mo, root), fv_variant_names(vs, tab)), ...acc]
  DDoc(_, _, inner, _, _) -> fv_sum(inner, tab, root, acc)
  DAttr(_, inner, _, _)   -> fv_sum(inner, tab, root, acc)
  _ -> acc
}

fn fv_mo_home(mo: Option[String], root: String) : String = match mo {
  Some(m) -> m
  None    -> root
}

fn fv_variant_names(vs: [Variant], tab: SymTab) : [String] =
  map(vs, (v) => match v { Var(c, _) -> written_text(sym_name(tab, c)) })

fn fv_with_ctors(ns: [String], sums: [FvSum], home: String, acc: [String]) : [String] = match ns {
  [] -> acc
  [n, ...rest] -> fv_with_ctors(rest, sums, home, list_append(acc, fv_ctors_of(sums, n, home)))
}

fn fv_ctors_of(sums: [FvSum], n: String, home: String) : [String] = match sums {
  [] -> []
  [FvSum(t, h, cs), ...rest] -> if t == n and h == home { cs } else { fv_ctors_of(rest, n, home) }
}

fn fv_bare(core_ids: [SymId], root: String) : ScopeView =
  sv_new(st_module_id(root), [], [], core_ids)

# Only the picks the file itself wrote. A pick names one module, so it
# outranks the plain import list even when a second import exports the
# same name.
fn fv_picks(sels: [SelImport], home: String, root: String,
      acc: [SvPick]) : [SvPick] = match sels {
  [] -> list_reverse(acc)
  [SelImport(owner, picked, names), ...rest] ->
    if fv_owner(owner, root) == home {
      fv_picks(rest, home, root, fv_pick_loop(names, st_module_id(picked), acc))
    } else { fv_picks(rest, home, root, acc) }
}

fn fv_pick_loop(names: [String], m: SymId, acc: [SvPick]) : [SvPick] =
  match names {
    [] -> acc
    [n, ...rest] -> fv_pick_loop(rest, m, [SvPick(n, m), ...acc])
  }

fn fv_ids(names: [String], acc: [SymId]) : [SymId] = match names {
  [] -> list_reverse(acc)
  [n, ...rest] -> fv_ids(rest, [st_module_id(n), ...acc])
}

#[doc("Names bound by a param list, prepended onto `acc`.")]
pub(pkg) fn sw_params(ps: [Param], acc: [String]) : [String] = match ps {
  [] -> acc
  [p, ...rest] -> sw_params(rest, [written_text(p.binder.name), ...acc])
}

fn sw_re(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

#[doc("The head hook that leaves a handler head as it was.")]
pub(pkg) fn sw_head_same(r: DeclRef) : DeclRef = r

#[doc("Rewrite one expression; `sh` holds the names already bound in scope. `lf` answers for a free `EName`/`EField` (None = descend), `tyf` maps each annotation, `hdf` each `with E` head.")]
pub(pkg) fn sw_expr(e: Expr, sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (DeclRef) -> DeclRef) : Expr = match e.kind {
  EName(_) -> match lf(e, sh) { Some(r) -> r  None -> e }
  ESym(_, _) -> match lf(e, sh) { Some(r) -> r  None -> e }
  EField(obj, f) -> match lf(e, sh) {
    Some(r) -> r
    None -> sw_re(e, EField(sw_expr(obj, sh, lf, tyf, hdf), f))
  }
  ECall(callee, args_) ->
    sw_re(e, ECall(sw_expr(callee, sh, lf, tyf, hdf), sw_exprs(args_, sh, lf, tyf, hdf)))
  EIndex(a, b) -> sw_re(e, EIndex(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf)))
  EBinop(op, a, b) ->
    sw_re(e, EBinop(op, sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf)))
  EUnop(op, x) -> sw_re(e, EUnop(op, sw_expr(x, sh, lf, tyf, hdf)))
  EIf(c, t_, eo) ->
    sw_re(e, EIf(sw_expr(c, sh, lf, tyf, hdf), sw_expr(t_, sh, lf, tyf, hdf),
                 sw_expr_opt(eo, sh, lf, tyf, hdf)))
  EMatch(scr, arms) ->
    sw_re(e, EMatch(sw_expr(scr, sh, lf, tyf, hdf), sw_arms(arms, sh, lf, tyf, hdf)))
  ELambda(ps, body) ->
    sw_re(e, ELambda(sw_typed_params(ps, tyf),
                     sw_expr(body, sw_params(ps, sh), lf, tyf, hdf)))
  ERecordLit(r, fis) ->
    sw_re(e, ERecordLit(sw_type_ref(r, e.line, e.col, tyf), sw_fis(fis, sh, lf, tyf, hdf)))
  EVariantsOf(t, ns) -> sw_re(e, EVariantsOf(tyf(t), ns))
  EList(els) -> sw_re(e, EList(sw_elems(els, sh, lf, tyf, hdf)))
  ERange(a, b, stp) ->
    sw_re(e, ERange(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf),
                    sw_expr_opt(stp, sh, lf, tyf, hdf)))
  EBlock(ss, tail) -> match sw_stmts(ss, sh, lf, tyf, hdf, []) {
    SWS(ss1, sh1) -> sw_re(e, EBlock(ss1, sw_expr_opt(tail, sh1, lf, tyf, hdf)))
  }
  EPipe(a, b) -> sw_re(e, EPipe(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf)))
  EDispatchPipe(op, a, b) ->
    sw_re(e, EDispatchPipe(op, sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf)))
  EBang(x) -> sw_re(e, EBang(sw_expr(x, sh, lf, tyf, hdf)))
  ELitUnit(x, u) -> sw_re(e, ELitUnit(sw_expr(x, sh, lf, tyf, hdf), u))
  EHandle(body, eff, tas, init, alias, hcs, ret) -> {
    let shb = match alias { Some(a) -> [written_text(a.name), ...sh]  None -> sh }
    sw_re(e, EHandle(sw_expr(body, shb, lf, tyf, hdf), hdf(eff), map(tas, tyf),
                     sw_expr_opt(init, sh, lf, tyf, hdf), alias,
                     sw_hclauses(hcs, sh, lf, tyf, hdf),
                     sw_hreturn_opt(ret, sh, lf, tyf, hdf)))
  }
  EIntrinsic(n, args_) -> sw_re(e, EIntrinsic(n, sw_exprs(args_, sh, lf, tyf, hdf)))
  _ -> e
}

# A record literal names its type; the annotation hook sees a reference
# still written as one, and what it hands back is the reference. One
# already resolved to its declaration is left alone.
fn sw_type_ref(r: DeclRef, l: Int, c: Int, tyf: (TypeExpr) -> TypeExpr) : DeclRef = match r {
  DrSym(_)        -> r
  DrWritten(_, _) -> {
    let t = tyf(TypeExpr { tkind: TyName(r, []), line: l, col: c })
    match t.tkind {
      TyName(r1, _) -> r1
      _ -> r
    }
  }
}

fn sw_typed_params(ps: [Param], tyf: (TypeExpr) -> TypeExpr) : [Param] =
  map(ps, (p) => Param { binder: p.binder, ptype: sw_ty_opt(p.ptype, tyf),
                         pline: p.pline, pcol: p.pcol, pborrow: p.pborrow })

fn sw_ty_opt(o: Option[TypeExpr], tyf: (TypeExpr) -> TypeExpr) : Option[TypeExpr] = match o {
  None -> None
  Some(t) -> Some(tyf(t))
}

fn sw_exprs(es: [Expr], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (DeclRef) -> DeclRef) : [Expr] = match es {
  [] -> []
  [x, ...rest] -> [sw_expr(x, sh, lf, tyf, hdf), ...sw_exprs(rest, sh, lf, tyf, hdf)]
}

fn sw_expr_opt(o: Option[Expr], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (DeclRef) -> DeclRef) : Option[Expr] = match o {
  None -> None
  Some(x) -> Some(sw_expr(x, sh, lf, tyf, hdf))
}

fn sw_fis(fis: [FieldInit], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (DeclRef) -> DeclRef) : [FieldInit] = match fis {
  [] -> []
  [FI(f, x), ...rest] ->
    [FI(f, sw_expr(x, sh, lf, tyf, hdf)), ...sw_fis(rest, sh, lf, tyf, hdf)]
}

fn sw_elems(els: [ListElem], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (DeclRef) -> DeclRef) : [ListElem] = match els {
  [] -> []
  [el, ...rest] -> {
    let el1 = match el {
      ElPlain(x)  -> ElPlain(sw_expr(x, sh, lf, tyf, hdf))
      ElSpread(x) -> ElSpread(sw_expr(x, sh, lf, tyf, hdf))
    }
    [el1, ...sw_elems(rest, sh, lf, tyf, hdf)]
  }
}

fn sw_arms(arms: [Arm], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (DeclRef) -> DeclRef) : [Arm] = match arms {
  [] -> []
  [Arm(p, g, body), ...rest] -> {
    let shb = sw_pat_names(p, sh)
    [Arm(sw_pat(p, tyf), sw_expr_opt(g, shb, lf, tyf, hdf), sw_expr(body, shb, lf, tyf, hdf)),
     ...sw_arms(rest, sh, lf, tyf, hdf)]
  }
}

# A narrowing pattern names a type, and so does the head of a
# record-shaped ctor pattern whenever that head is a record alias
# (`P { x: a }` over `type P = { x: Int }`): the head goes through the
# annotation hook with the qualifier it was written with, so `m.P { ... }`
# picks `m`'s declaration exactly as `m.P` does in type position. A head
# the hook leaves as written is a sum-type ctor.
fn sw_pat(p: Pattern, tyf: (TypeExpr) -> TypeExpr) : Pattern = {
  let k = match p.pkind {
    PNarrow(n, t) -> PNarrow(n, tyf(t))
    PVariant(r, subs) -> PVariant(r, map(subs, (x) => sw_pat(x, tyf)))
    PVariantRecord(r, fs) -> PVariantRecord(sw_type_ref(r, p.line, p.col, tyf), sw_pfields(fs, tyf))
    PRecord(fs) -> PRecord(sw_pfields(fs, tyf))
    PList(subs, rest) -> PList(map(subs, (x) => sw_pat(x, tyf)), rest)
    PAs(n, inner) -> PAs(n, sw_pat(inner, tyf))
    PSurface(ps) ->
      PSurface(patsurface_rebuild(ps, map(patsurface_children(ps), (x) => sw_pat(x, tyf))))
    _ -> p.pkind
  }
  Pattern { pkind: k, line: p.line, col: p.col }
}

# The names a pattern binds, as written, prepended onto `acc`.
fn sw_pat_names(p: Pattern, acc: [String]) : [String] = match p.pkind {
  PBind(b)              -> [written_text(b.name), ...acc]
  PAs(b, inner)         -> sw_pat_names(inner, [written_text(b.name), ...acc])
  PNarrow(b, _)         -> [written_text(b.name), ...acc]
  PList(subs, rest)     -> {
    let acc1 = sw_pats_names(subs, acc)
    match rest { Some(b) -> [written_text(b.name), ...acc1]  None -> acc1 }
  }
  PVariant(_, subs)     -> sw_pats_names(subs, acc)
  PVariantRecord(_, fs) -> sw_pfield_names(fs, acc)
  PRecord(fs)           -> sw_pfield_names(fs, acc)
  PSurface(sp)          -> sw_pats_names(patsurface_children(sp), acc)
  _                     -> acc
}

fn sw_pats_names(ps: [Pattern], acc: [String]) : [String] = match ps {
  []           -> acc
  [p, ...rest] -> sw_pats_names(rest, sw_pat_names(p, acc))
}

fn sw_pfield_names(fs: [PField], acc: [String]) : [String] = match fs {
  []                           -> acc
  [PField(_, sub, _), ...rest] -> sw_pfield_names(rest, sw_pat_names(sub, acc))
}

fn sw_pfields(fs: [PField], tyf: (TypeExpr) -> TypeExpr) : [PField] = match fs {
  [] -> []
  [PField(n, sub, sh), ...rest] -> [PField(n, sw_pat(sub, tyf), sh), ...sw_pfields(rest, tyf)]
}

#[doc("Rewrite the bodies of a handler-clause list; each clause binds its op params and `resume`.")]
pub(pkg) fn sw_hclauses(hcs: [HClause], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (DeclRef) -> DeclRef) : [HClause] = match hcs {
  [] -> []
  [HC(op, ps, body, l, c), ...rest] -> {
    let shc = ["resume", ...sw_params(ps, sh)]
    [HC(op, sw_typed_params(ps, tyf), sw_expr(body, shc, lf, tyf, hdf), l, c),
     ...sw_hclauses(rest, sh, lf, tyf, hdf)]
  }
}

#[doc("Rewrite a handler `return(x)` clause body; `x` is bound inside it.")]
pub(pkg) fn sw_hreturn_opt(o: Option[HReturn], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (DeclRef) -> DeclRef) : Option[HReturn] = match o {
  None -> None
  Some(HR(x, body, l, c)) -> Some(HR(x, sw_expr(body, [written_text(x.name), ...sh], lf, tyf, hdf), l, c))
}

# A statement list threads its binders forward: a `let` / `var` name
# scopes over the remaining statements and the block tail.
type SwStmts = SWS([Stmt], [String])

fn sw_stmts(ss: [Stmt], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (DeclRef) -> DeclRef, acc: [Stmt]) : SwStmts = match ss {
  [] -> SWS(list_reverse(acc), sh)
  [s, ...rest] ->
    sw_stmts(rest, sw_stmt_binders(s, sh), lf, tyf, hdf, [sw_stmt(s, sh, lf, tyf, hdf), ...acc])
}

fn sw_stmt(s: Stmt, sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (DeclRef) -> DeclRef) : Stmt = match s {
  SLet(p, t, x) -> SLet(sw_pat(p, tyf), sw_ty_opt(t, tyf), sw_expr(x, sh, lf, tyf, hdf))
  SAssert(x, mo) -> SAssert(sw_expr(x, sh, lf, tyf, hdf), sw_expr_opt(mo, sh, lf, tyf, hdf))
  SExprStmt(x) -> SExprStmt(sw_expr(x, sh, lf, tyf, hdf))
  SIndexAssign(a, b, c, l, cc) ->
    SIndexAssign(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf),
                 sw_expr(c, sh, lf, tyf, hdf), l, cc)
  SAssign(a, b, l, c) -> SAssign(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf), l, c)
  SVar(n, t, x, l, c) -> SVar(n, sw_ty_opt(t, tyf), sw_expr(x, sh, lf, tyf, hdf), l, c)
  SUse(n, l, c) -> SUse(sw_use_name(hdf(ref_written(n)), n), l, c)
}

# A `use` names its effect in text; a head the hook settled keeps the
# name the source wrote.
fn sw_use_name(r: DeclRef, n: String) : String = match r {
  DrWritten(None, w)    -> written_text(w)
  DrWritten(Some(q), w) -> cat3(written_text(q), ".", written_text(w))
  DrSym(_)              -> n
}

fn sw_stmt_binders(s: Stmt, sh: [String]) : [String] = match s {
  SLet(p, _, _)       -> sw_pat_names(p, sh)
  SVar(n, _, _, _, _) -> [written_text(n.name), ...sh]
  _ -> sh
}

#[doc("The table indexed by name, each chain in stream order: a query on one name reads the chain as it would the whole table.")]
pub(pkg) fn nt_index(t: [NEnt]) : NameIndex[NEnt] = nt_index_rev(list_reverse(t), idx_empty())

fn nt_index_rev(rev: [NEnt], ix: NameIndex[NEnt]) : NameIndex[NEnt] = match rev {
  [] -> ix
  [e, ...rest] -> match e { NEnt(_, n, _, _, _) -> nt_index_rev(rest, idx_prepend(ix, n, e)) }
}

#[doc("Every name declared by two or more homes in class `cls`, each once, in stream order.")]
pub(pkg) fn nt_collisions(t: [NEnt], cls: NCls) : [String] =
  nt_coll_loop(nt_only(t, cls), [], [])

fn nt_coll_loop(t: [NEnt], seen: [String], acc: [String]) : [String] = match t {
  [] -> list_reverse(acc)
  [NEnt(c, n, _, _, _), ...rest] ->
    if list_has(seen, n) { nt_coll_loop(rest, seen, acc) }
    else if list_length(nt_homes(t, c, n)) > 1 { nt_coll_loop(rest, [n, ...seen], [n, ...acc]) }
    else { nt_coll_loop(rest, [n, ...seen], acc) }
}

#[doc("The homes that declare `name` in class `cls`, deduplicated, in stream order. Fewer than two means the name resolves without qualification.")]
pub(pkg) fn nt_homes(t: [NEnt], cls: NCls, name: String) : [String] =
  nt_homes_loop(t, cls, name, [])

fn nt_homes_loop(t: [NEnt], cls: NCls, name: String, acc: [String]) : [String] =
  match t {
    [] -> list_reverse(acc)
    [NEnt(c, n, h, _, _), ...rest] ->
      if n == name and ncls_same(c, cls) and list_has(acc, h) == false {
        nt_homes_loop(rest, cls, name, [h, ...acc])
      } else { nt_homes_loop(rest, cls, name, acc) }
  }

#[doc("True when `home` itself declares `name` in class `cls`. The reader's own module wins over every import, so such a use is never ambiguous.")]
pub(pkg) fn nt_declares(t: [NEnt], cls: NCls, name: String, home: String) : Bool =
  match t {
    [] -> false
    [NEnt(c, n, h, _, _), ...rest] ->
      if n == name and h == home and ncls_same(c, cls) { true }
      else { nt_declares(rest, cls, name, home) }
  }

#[doc("One name a selective import picks, bound to the module it names: `NPick(name, home)`.")]
pub(pkg) type NPick = NPick(String, String)

#[doc("One `import m.{A, B}` a file wrote: `SelImport(importing file, written module name, picked names)`, importer `\"\"` for the root file.")]
pub(pkg) type SelImport = SelImport(String, String, [String])

#[doc("The names one file's selective imports pick, tagged with the home each names. `owner` is the importing file, empty for the root.")]
pub(pkg) fn nt_picks_of(sels: [SelImport], owner: String, mt: [ModuleEntry]) : [NPick] =
  nt_picks_loop(sels, owner, mt, [])

fn nt_picks_loop(sels: [SelImport], owner: String, mt: [ModuleEntry],
      acc: [NPick]) : [NPick] = match sels {
  [] -> list_reverse(acc)
  [SelImport(o, written, names), ...rest] ->
    if o == owner {
      nt_picks_loop(rest, owner, mt, nt_pick_names(names, mt_tagged_name(mt, written), acc))
    } else { nt_picks_loop(rest, owner, mt, acc) }
}

fn nt_pick_names(names: [String], home: String, acc: [NPick]) : [NPick] = match names {
  [] -> acc
  [n, ...rest] -> nt_pick_names(rest, home, [NPick(n, home), ...acc])
}

#[doc("The homes a selective import picks `name` from, deduplicated.")]
pub(pkg) fn nt_pick_homes(picks: [NPick], name: String, acc: [String]) : [String] = match picks {
  [] -> acc
  [NPick(n, h), ...rest] ->
    if n == name and not list_has(acc, h) { nt_pick_homes(rest, name, [h, ...acc]) }
    else { nt_pick_homes(rest, name, acc) }
}

#[doc("The candidate homes a bare use of `name` must choose between, or `[]` when the ladder already resolves it: the reader's own declaration wins, a selective import naming it decides next (`import m.{T}` says which `T` the file means), the non-core homes outrank the cores, cores that restate one name settle by the core set's order, and a single candidate on a rung needs no qualifier.")]
pub(pkg) fn nt_contested_in(t: [NEnt], picks: [NPick], cls: NCls, name: String,
      reader: String, core: [String]) : [String] =
  if nt_declares(t, cls, name, reader) { [] }
  else {
    let homes = nt_homes(t, cls, name)
    let picked = nt_on_picks(homes, picks, name, [])
    let user = nt_drop_cores(homes, core)
    let rung = if list_length(picked) > 0 { picked }
               else if list_length(user) > 0 { user }
               else { homes }
    if list_length(rung) <= 1 or nt_core_default(rung, name, core) { [] } else { rung }
  }

# The homes a pick names, kept in the candidate order so a report lists
# them the way the declarations arrived.
fn nt_on_picks(homes: [String], picks: [NPick], name: String,
      acc: [String]) : [String] = match homes {
  [] -> list_reverse(acc)
  [h, ...rest] ->
    if nt_picked(picks, name, h) { nt_on_picks(rest, picks, name, [h, ...acc]) }
    else { nt_on_picks(rest, picks, name, acc) }
}

# Cores restating one name settle on the home the name's rule gives it, never on load order.
fn nt_core_default(rung: [String], name: String, core: [String]) : Bool =
  all(rung, (h) => list_has(core, h)) and core_bare_default_named(name) and list_has(rung, core_module_name(CmList))

fn nt_picked(picks: [NPick], name: String, home: String) : Bool = match picks {
  [] -> false
  [NPick(n, h), ...rest] ->
    if n == name and h == home { true } else { nt_picked(rest, name, home) }
}

fn nt_drop_cores(homes: [String], core: [String]) : [String] = match homes {
  [] -> []
  [h, ...rest] ->
    if list_has(core, h) { nt_drop_cores(rest, core) } else { [h, ...nt_drop_cores(rest, core)] }
}
