# Infer a pipe / combinator function argument. A point-free section takes
# the stage's element type before its body is walked. A lambda that names
# its parameter keeps it open: what its body asks of it is how a stage
# written for the whole container is told from one written for an element.
fn synth_pipe_rhs(st: InferState, rhs: Expr, elem: Option[Ty]) : Inferred / Console + File + Mutable =
  match rhs.kind {
    ELambda(ps, body) -> match elem {
      Some(et) -> if params_point_free(ps) or stage_param_is_receiver(ps, body) { synth_lambda_expecting(st, ps, body, [et], rhs.line, rhs.col) }
                  else { synth(st, rhs) }
      None     -> synth(st, rhs)
    }
    _ -> synth(st, rhs)
  }


# A name the resolver left to the typer. Settled here, the node carries
# the declaration's id; a name that settles to none is an error, so no
# written name leaves the typer of a program that compiles.
fn synth_name_read(st: InferState, w: Written, e: Expr) : Inferred / Console + File + Mutable =
  synth_settled(st, settle_name(st, None, w, TyAny, value_classes()), w, false, e)


# The callee of a call is read the same way; its tie is reported as a call.
fn synth_callee(st: InferState, callee: Expr) : Inferred / Console + File + Mutable = match callee.kind {
  EName(w) -> synth_settled(st, settle_name(st, None, w, TyAny, value_classes()), w, true, callee)
  _        -> synth(st, callee)
}


fn synth_settled(st: InferState, r: Settled, w: Written, called: Bool, e: Expr) : Inferred / Console + File + Mutable = match r {
  SetOne(s)    -> synth_sym_read(st, s, Expr { ...e, kind: ESym(s, spec_none()) })
  SetTie(ss)   -> if op_tie(st, ss) { synth_op_ref(st, w, ss, called, e) }
                  else { inferred_leaf(report_name_tie(st, w, ss, called, e.line, e.col), TyAny, e) }
  SetOther(ss) -> inferred_leaf(report_no_value(st, w, ss, e.line, e.col), TyAny, e)
  SetNone      -> inferred_leaf(report_no_declaration(st, w, e.line, e.col), TyAny, e)
}


# An operation several protocols declare, read where nothing tells them
# apart. Called, the reference stays between its dispatchers and the
# dispatch rewrite settles it by the receiver. Read as a value it is the
# function that calls it, so the same holds of that call.
fn synth_op_ref(st: InferState, w: Written, ss: [SymId], called: Bool, e: Expr) : Inferred / Console + File + Mutable =
  if called {
    let c = op_unsettled(st, ss, e.line, e.col)
    match c.ty {
      Some(t) -> inferred_leaf(c.st, t, Expr { ...e, kind: EMark(MkProtoOp(ss)) })
      None    -> inferred_leaf(report_name_tie(c.st, w, ss, true, e.line, e.col), TyAny, e)
    }
  }
  else { match contest_arity(st.protos.ids, ss) {
    Some(n) -> synth(st, contest_as_function(e, n))
    None    -> inferred_leaf(report_name_tie(st, w, ss, false, e.line, e.col), TyAny, e)
  } }


#[doc("Typer-internal helper `synth` shared across the infer modules.")]
pub fn synth(st: InferState, e: Expr) : Inferred / Console + File + Mutable {


  match e.kind {
    EInt(_, _)        -> inferred_leaf(st, TyInt, e)
    # A suffix-tagged literal (`42i32`, `7u8`) carries its width type in
    # the node itself; that type IS the literal's type. Byte is the one
    # width whose range check the parser defers here.
    EFixed(span, ty) -> match ty {
      TyByte -> synth_byte_lit(st, decode_int(span), e)
      _      -> inferred_leaf(st, ty, e)
    }
    EReal(_, _)       -> inferred_leaf(st, TyReal, e)
    # A past-i64 integer literal with no concrete carrier in context is
    # out of range — the `n`/`bigint.from_string` escape hatch is named.
    EIntLit(span)  -> synth_lit_mint_or_err(st, e, EIntLit(span))
    # A `d`-suffixed literal always targets `Decimal`; the suffix
    # supplies the carrier locally, so mint it with no expected type.
    EDecimalLit(_) -> synth_lit_mint_or_err(st, e, e.kind)
    EBool(_)       -> inferred_leaf(st, TyBool, e)
    EChar(_)       -> inferred_leaf(st, TyChar, e)
    EStr(_, _)     -> inferred_leaf(st, TyString, e)
    EUnit          -> inferred_leaf(st, TyUnit, e)
    # `try_pipe_placeholder` substitutes the legitimate `_` while
    # parsing, so one reaching the typer is in value position. Typing it
    # `TyAny` fits every slot and lowers to zero — a wrong value that
    # looks valid for its type (`0`, `""`, a real row id), not garbage.
    EUnder         -> {
      let perr = mk_diag(SevError, st.file, e.line, e.col,
        "`_` is not an expression; it is a pattern wildcard, or a `|>` argument placeholder", [])
      render_diag(perr)
      inferred_leaf(st_bump_err(st_push_diag(st, perr)), TyAny, e)
    }
    # a `.` placeholder that survives parsing in a
    # non-argument position is a hard error per
    # `docs/kaikai-minimal.md` §"Placeholder rules". The argument-
    # position desugar (`desugar_placeholder_arg`) wraps every
    # call-arg subtree containing a `.` into a unary lambda before
    # the typer ever sees it; reaching this arm means the user
    # wrote `.` outside that sugar.
    EPlaceholder   -> {
      let perr = mk_diag(SevError, st.file, e.line, e.col,
        "`.` placeholder used outside lambda-expected position; use a named arrow `(x) => ...`", [])
      render_diag(perr)
      inferred_leaf(st_bump_err(st_push_diag(st, perr)), TyAny, e)
    }
    # `resume` reaching the value-position read arm (call-position
    # `resume(...)` is intercepted by `try_resume_call` upstream) means it
    # escapes its clause as a first-class value — `let k = resume`,
    # `f(resume)`. The continuation has no value representation outside its
    # clause, so reject it cleanly (docs/effects.md).
    ESym(sy, _) -> synth_sym_read(st, sy, e)
    ELocal(l)   -> synth_local_read(st, l, e)
    EOp(r)      -> synth_op_read(st, r, e)
    EName(nm) -> synth_name_read(st, nm, e)
    EMark(m) -> synth_mark_read(st, m, e)
    ECall(callee, args_)       -> synth_call_site(st, callee, args_, e.line, e.col)
    EField(obj, fnm)           -> synth_field(st, obj, fnm, e.line, e.col)
    EIndex(coll, ix)           -> synth_index(st, coll, ix, e.line, e.col)
    EBinop(op, l, r)           -> synth_binop(st, op, l, r, e.line, e.col)
    EUnop(op, x)               -> synth_unop(st, op, x, e.line, e.col)
    EIf(c, t_, eo)             -> synth_if(st, c, t_, eo, e.line, e.col)
    EMatch(scr, arms)          -> synth_match(st, scr, arms, e.line, e.col)
    ELambda(ps, body)          -> synth_lambda(st, ps, body, e.line, e.col)
    ERecordLit(rh, fis)        -> synth_record_lit(st, rh, fis, TyAny, e.line, e.col)
    EList(els)                 -> synth_list_expr(st, els, e.line, e.col)
    ERange(lo, hi, stp)        -> synth_range(st, lo, hi, stp, e.line, e.col)
    EBlock(stmts, tail)        -> synth_block(st, stmts, tail, e.line, e.col)
    EPipe(lhs, rhs)            -> synth_pipe(st, lhs, rhs, e.line, e.col)
    EDispatchPipe(op, lhs, rhs) -> synth_pipe_dispatch(st, op, lhs, rhs, e.line, e.col)
    EHole(nm_opt)              -> synth_hole(st, nm_opt, e)
    ETodo(msg)                 -> synth_todo(st, msg, e)
    EExternBody(_, _)          -> synth_extern_body(st, e)
    EBang(inner)               -> synth_bang(st, inner, e.line, e.col)
    EHandle(_, _, _, _, _, _, _) -> synth_handle(st, e)
    # numeric literal with a unit annotation. The inner Expr is
    # always EInt or EReal; the literal's type is `TyDimT(base, u)`
    # where base is TyInt or TyReal and u is the canonical unit.
    ELitUnit(inner, u) -> synth_lit_unit(st, inner, u, e.line, e.col)
    # `variants[T]()`. Validate T is a sum type with
    # nullary-only variants, stamp the result with `[T]` (TyListT),
    # and bake the resolved variant names into the AST so codegen
    # has them without re-walking the env. Errors yield a TyAny
    # stub so cascade is graceful.
    EVariantsOf(ty_expr, _) -> synth_variants_of(st, ty_expr, e)
    # A loop intrinsic types exactly as the combinator call it replaced:
    # arg 0 is the original callee, so delegating to `synth_call` gives
    # the same scheme lookup, lambda checking, and row join. The stamped
    # pieces are re-wrapped; a non-call rewrite (e.g. a dispatch rewrite
    # that changes the node shape) falls back to the rewritten call,
    # dropping the intrinsic rather than guessing at its semantics.
    #
    # Any other `$<name>(args)` reaching `synth` is an error. The
    # clause-body path that legitimately admits `$extern_handler`
    # short-circuits before reaching this arm.
    ESurface(_) ->
      panic("infer: ESurface must be lowered by surface_lower before the typer")
    EIntrinsic(nm, args_) ->
      if is_loop_intrinsic(nm) {
        match args_ {
          [callee, ...rest] -> {
            let r = synth_call(st, callee, rest, e.line, e.col)
            match r.expr.kind {
              ECall(callee2, rest2) ->
                Inferred { st: r.st, ty: r.ty,
                           expr: Expr { kind: EIntrinsic(nm, [callee2, ...rest2]),
                                        line: e.line, col: e.col,
                                        ty: r.expr.ty, mode: r.expr.mode,  site: e.site } }
              _ -> r
            }
          }
          _ -> {
            let perr = mk_diag(SevError, st.file, e.line, e.col,
              concat_all(["compiler intrinsic `$", intrinsic_name(nm), "` has a malformed argument list"]), [])
            render_diag(perr)
            inferred_leaf(st_bump_err(st_push_diag(st, perr)), TyAny, e)
          }
        }
      } else { match nm {
        InResumeFrame -> synth_resume_frame(st, args_, e)
        InResumeBad   -> report_resume_bad(st, args_, e)
        InSegHandle   -> synth_seg_handle(st, args_, e)
        InSegRequest  -> synth_seg_request(st, args_, e)
        InAbsent -> {
          let r = st_fresh_ty(st)
          inferred_leaf(r.st, r.ty, e)
        }
        InCovHit(_) -> inferred_leaf(st, TyUnit, e)
        _ -> {
          let perr = mk_diag(SevError, st.file, e.line, e.col,
            concat_all(["compiler intrinsic `$", intrinsic_name(nm),
                        "` is not valid in this position"]), [])
          render_diag(perr)
          inferred_leaf(st_bump_err(st_push_diag(st, perr)), TyAny, e)
        }
      } }
    # A qualified reference the resolver left. Settled here, the node
    # carries the declaration's id.
    EModCall(m, fname) -> match settle_name(st, Some(m), fname, TyAny, value_classes()) {
      SetOne(s)  -> synth_sym_read(st, s, Expr { ...e, kind: ESym(s, spec_none()) })
      SetTie(ss) -> inferred_leaf(report_name_tie(st, fname, ss, false, e.line, e.col), TyAny, e)
      _ -> {
        # The resolver only leaves a name the module exports, so the
        # table and the decl stream are out of sync: a diagnostic
        # rather than a panic, so the user sees a concrete location.
        let perr = mk_diag(SevError, st.file, e.line, e.col,
          "module '#{m}' does not export '#{fname}' at the typer (rqc / TyEnv mismatch — internal)", [])
        render_diag(perr)
        inferred_leaf(st_bump_err(st_push_diag(st, perr)), TyAny, e)
      }
    }
  }
}


# synth a literal annotated with a unit. Unit aliases were
# expanded by the resolver before the typer ever sees them; here we
# only canonicalise (sort/group) and stamp the dimensioned type onto
# the rebuilt expression node.
fn synth_lit_unit(st: InferState, inner: Expr, u: UnitExprT, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let ri = synth(st, inner)
  let base = apply_ty(ri.st.sub, ri.ty)
  let canon_u = unit_canon(u)
  let ty = dim_collapse(base, canon_u)
  let root = with_ty(mk_expr(ELitUnit(ri.expr, canon_u), line, col), ty)
  mk_inferred(ri.st, ty, root)
}


# type-check `handle { body } with Eff [as alias] {
# clauses }`. The body is walked under a fresh row accumulator;
# the named effect is filtered out of whatever the body
# accumulates, and the remainder merges back into the outer
# function's row. Clause bodies and the optional return clause
# are not type-checked against the op signatures here, and alias
# resolution (`Eff as log`) is not handled here.
fn synth_handle(st: InferState, e: Expr) : Inferred / Console + File + Mutable {


  match e.kind {
    EHandle(body, eff_ref, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) -> {
      let hsym = ref_sym(eff_ref)
      # type-check the init expression in the outer scope.
      # The init's inferred type IS the handler-state type — it is
      # propagated into the clauses so `state` / `log` and 2-arg
      # `resume(v, ns)` are typed precisely (no TyAny escape).
      let init_typed_st = match init_opt {
        Some(ie) -> {
          let ri = synth(st, ie)
          let ity = apply_ty(ri.st.sub, ri.ty)
          IT { st: ri.st, init_opt: Some(ri.expr), state_ty: Some(ity) }
        }
        None -> IT { st: st, init_opt: None, state_ty: None }
      }
      # alias rebinds the capability inside the body.
      let st_aliased = match alias_opt {
        Some(a) -> st_push_alias(init_typed_st.st, a.id, hsym)
        None    -> init_typed_st.st
      }
      # when a stateful handler omits the explicit `[T]`
      # instantiation but supplies an `(init)`, infer the single
      # type argument from the init's type. This is the path for the
      # unannotated `var x = init` desugar:
      # `with State(init) as x { ... }` resolves to
      # `State[type_of_init]`. The fallback only fires when no syntactic
      # type args were written, so explicit `with State[Int](0)` still
      # round-trips verbatim.
      let resolved_eff_tyargs = match eff_tyargs {
        [] -> match init_typed_st.state_ty {
          Some(t) -> [t]
          None    -> []
        }
        _ -> map(eff_tyargs, (t) => st_annot_ty(st, t))
      }
      # A `with Eff as a` binding makes `a` a first-class capability value of
      # type `Eff[ty_args]` so it can be passed as a call argument (§6 named
      # instances). The capability type IS the effect's nominal type — no
      # `Handler[E]` wrapper (HKT stays banned). The alias entry on st.aliases
      # still drives op dispatch inside the handle body; this env binding is what
      # lets `a` cross into `f(a)` and type against a `c: Eff` parameter.
      # The capability type carries only the effect's own tparams, not the
      # handler's full state type: a non-parametric `Cell` has no arguments
      # even when `with Cell(0)` infers an Int state. Truncating to the effect's
      # tparam arity makes the binding unify with a `c: Cell` parameter.
      let cap_arity = eff_tparam_arity(st_aliased.op_eff_arities, hsym)
      let cap_tyargs = take_first_tys(resolved_eff_tyargs, cap_arity)
      let st_capbound = match alias_opt {
        Some(a) -> st_set_env(st_aliased,
                     env_bind_local(st_aliased.env, a, mono(TyCon(hsym, cap_tyargs))))
        None    -> st_aliased
      }
      let prev_row = st_capbound.row
      let st_in = InferState { ...st_set_row(st_capbound, []), row_tails: [] }
      let rb_raw = synth(st_in, body)
      let rb0 = Inferred { ...rb_raw, st: st_scope_tails(rb_raw.st, st_capbound.row_tails) }
      let cell = match alias_opt { Some(a) -> a.id  None -> local_none() }
      let rb = Inferred { ...rb0, st: holes_under_handler(rb0.st, list_length(st_in.holes),
                                     label_in_cell(hsym, cap_tyargs, cell)) }
      # filter out *only* the labels whose ty_args unify with
      # the handler's instantiation. Labels with the same eff name but
      # non-unifiable ty_args remain and propagate to the outer row —
      # they need their own enclosing handler.
      # a `with State as i` handler discharges the labels of its own
      # cell, leaving a sibling cell for its own handler; an unaliased
      # handler (`alias_opt = None`) discharges the labels of no cell. The
      # discharge binds the cell's type via `unify_list`, so thread the
      # resulting substitution into the handler's output state (all reads
      # of the cell converge on the handler's instantiation).
      # Discharge against the effect's own tparam tyargs (truncated to its
      # arity), not the full handler state type — a non-parametric `Cell` op
      # carries a `[]` label even when `with Cell(0)` infers an Int state, so
      # matching against `[Int]` would leave the label undischarged.
      let filt = filter_labels_matching_res(rb.st.row, hsym, cell,
                                              cap_tyargs, rb.st.sub)
      let body_row_minus = filt.kept
      let rb_st1 = InferState { ...st_set_sub(rb.st, filt.sub),
                                eff_uses: scope_eff_uses(st_capbound.eff_uses, rb.st.eff_uses, body_row_minus) }
      let st_out0 = st_merge_labels(st_set_row(rb_st1, prev_row), body_row_minus)
      let st_out1 = match alias_opt { Some(_) -> st_pop_alias(st_out0) None -> st_out0 }
      # verify `with <Eff>` names a known effect. When
      # `Eff` is unknown the body's labels still flow up via the
      # filter-and-merge step above (so a downstream "effect not
      # handled" still fires for what the body actually performs),
      # but we surface the parse-level mistake directly so the user
      # does not chase a "unknown op X on effect Y" cascade.
      let st_out_eff = check_handle_effect_known(st_out1, eff_ref, e.line, e.col)
      # every clause name must be a declared op of the effect.
      let st_out2 = check_clause_names(st_out_eff, eff_ref, clauses, e.line, e.col)
      let stateful = match init_opt { Some(_) -> true None -> false }
      let r_typed = check_return_clause_opt(st_out2, ret_opt, rb.ty,
                                             stateful, init_typed_st.state_ty)
      let cs_typed = check_clauses_types(r_typed.st, hsym, clauses,
                                          stateful, init_typed_st.state_ty,
                                          resolved_eff_tyargs, r_typed.ty)
      let hty = apply_ty(cs_typed.st.sub, r_typed.ty)
      let new_e = with_ty(
        mk_expr(EHandle(rb.expr, eff_ref, stamp_tes(eff_tyargs, resolved_eff_tyargs, (te: TypeExpr) => st_annot_ty(st, te)), init_typed_st.init_opt,
                         alias_opt, cs_typed.clauses, r_typed.ret_opt),
                e.line, e.col),
        hty)
      mk_inferred(cs_typed.st, hty, new_e)
    }
    _ -> mk_inferred(st, TyAny, with_ty(e, TyAny))
  }
}


fn check_return_clause_opt(st: InferState, ret_opt: Option[HReturn],
                           body_ty: Ty, stateful: Bool,
                           state_ty: Option[Ty]) : RetTyped / Console + File + Mutable {


  match ret_opt {
    None    -> RetTyped { st: st, ty: body_ty, ret_opt: None }
    Some(r) -> match r {
      HR(b, rexpr, line, col) -> {
        let outer = st
        let env1 = env_bind_local(st.env, b, mono(body_ty))
        # `state` / `log` get the actual handler-state type
        # in the return clause so `return(x) -> (x, state)` types as
        # `(body_ty, state_ty)`.
        let sty = match state_ty { Some(t) -> t None -> TyAny }
        let env2 = if stateful { add_state_aliases(env1, sty) } else { env1 }
        let st1 = st_set_env(st, env2)
        let rr = synth(st_clause_alias_tags(st1), rexpr)
        let st_out = st_restore_entries(outer, rr.st)
        let ty = apply_ty(st_out.sub, rr.ty)
        RetTyped { st: st_out, ty: ty, ret_opt: Some(HR(b, rr.expr, line, col)) }
      }
    }
  }
}


# `result_ty` is the handle's type: what `resume` returns and what every
# op clause evaluates to.
fn check_clauses_types(st: InferState, eff: SymId, cs: [HClause],
                        stateful: Bool, state_ty: Option[Ty],
                        eff_tyargs: [Ty], result_ty: Ty) : ClausesTyped / Console + File + Mutable =


  check_clauses_types_loop(st, eff, cs, stateful, state_ty, eff_tyargs, result_ty, [])


fn check_clauses_types_loop(st: InferState, eff: SymId, cs: [HClause],
                             stateful: Bool, state_ty: Option[Ty],
                             eff_tyargs: [Ty], result_ty: Ty, acc: [HClause]) : ClausesTyped / Console + File + Mutable {


  match cs {
    [] -> ClausesTyped { st: st, clauses: list_reverse(acc) }
    [c, ...rest] -> match c {
      HC(head, params, body, line, col) ->
        if is_lifecycle_clause(head) {
          let ft = check_finally_clause(st, head, params, body, line, col,
                                         stateful, state_ty)
          check_clauses_types_loop(ft.st, eff, rest, stateful, state_ty,
                                    eff_tyargs, result_ty, [ft.clause, ...acc])
        } else {
      {
        let outer = st
        let op_name = clause_head_word(head)
        # clause shape: the clause's positional parameter
        # count must equal the op's declared arity plus one (the
        # trailing `resume`). Without this check `print_io(s) -> 0`
        # (missing resume) or `print_io(a, b, c, resume) -> resume(())`
        # (too many user params for a single-param op) type-check
        # silently; the downstream C emitter then produces ill-formed
        # function pointers. Validation is gated on a known op scheme
        # so the unknown-op path keeps its dedicated diagnostic in
        # check_clause_names instead of layering an arity error on top.
        let st_arity = check_clause_arity(st, eff, op_name, params, line, col)
        # bind the clause params and unify the op's
        # effect-tparam tyvars with the handler's instantiation, so
        # the answer type is concrete (e.g., `Int` for State.get under
        # `with State[Int]`). `st.clause_resume` is then set with the
        # concrete answer/state types so `resume(v)` / `resume(v, ns)`
        # are typechecked precisely.
        let bind_res = bind_clause_env_typed(st_arity, eff, op_name, params,
                                              stateful, state_ty, eff_tyargs, result_ty)
        let fresh_before = st_arity.env.fresh
        let sty = match state_ty { Some(t) -> t None -> TyAny }
        let env_bound = bind_res.st.env
        let env_with_sl = if stateful { add_state_aliases(env_bound, sty) } else { env_bound }
        let st_env = st_set_env(bind_res.st, env_with_sl)
        let answer_resolved = apply_ty(st_env.sub, bind_res.answer_ty)
        let st_resume = if stateful {
          match state_ty {
            Some(sv) -> st_set_clause_resume(st_env,
              Some(RB(answer_resolved, sv, result_ty)))
            None -> st_env
          }
        } else { st_env }
        let st_clause_in = st_set_in_clause(st_clause_alias_tags(st_resume), clause_cont_of(params))
        let rb = synth(st_clause_in, body)
        let st_res = st_unify(rb.st, result_ty, rb.ty, "handler clause result", line, col)
        let st_esc = check_op_tparam_escape(st_res, bind_res.op_rigid, fresh_before,
                                            state_ty, rb.ty, line, col)
        let st_out0 = st_restore_entries(outer, st_esc)
        let st_out = st_set_sub(st_set_clause_resume(st_out0, outer.clause_resume),
                                subst_with_rigid(st_out0.sub, outer.sub.rigid))
        # keep the typed body so the op resolution that fired inside
        # `synth` (`Console.print(...)` settled to `Stdout`'s `print`)
        # actually reaches the emit phase.
        let new_clause = HC(head, params, rb.expr, line, col)
        check_clauses_types_loop(st_out, eff, rest, stateful, state_ty,
                                  eff_tyargs, result_ty, [new_clause, ...acc])
      }
        }
    }
  }
}


# `finally { }` runs with `evidence_top` restored to its own node's
# parent, so its body is typed in the OUTER scope: performing the very
# effect this handler discharges is an "effect not handled" error, not a
# runtime loop. It carries no params and its value is discarded, so it
# is checked against `Unit`. A stateful handler exposes `state`, which is
# what connects an `initially`-acquired resource to its release.
fn check_finally_clause(st: InferState, head: ClauseHead, params: [Param], body: Expr,
                        line: Int, col: Int, stateful: Bool,
                        state_ty: Option[Ty]) : ClauseTyped1 / Console + File + Mutable {

  let st_arity = match params {
    [] -> st
    _  -> {
      let perr = mk_diag(SevError, st.file, line, col,
        string_concat("`", string_concat(clause_head_word(head), " { }` takes no parameters")), [])
      render_diag(perr)
      diag_note("`finally` runs for its effect only; use `return(x) -> ...` to transform the result")
      st_bump_err(st_push_diag(st, perr))
    }
  }
  let outer = st_arity
  let sty = match state_ty { Some(t) -> t None -> TyAny }
  let env1 = if stateful { add_state_aliases(outer.env, sty) } else { outer.env }
  let rb = synth(st_clause_alias_tags(st_set_env(outer, env1)), body)
  let st_out = st_restore_entries(outer, rb.st)
  ClauseTyped1 { st: st_out, clause: HC(head, params, rb.expr, line, col) }
}


# `expr!` typer.
# - Operand must be `Option[T]` or `Result[T, E]` (after substitution).
# - Enclosing function's declared return type must be the matching
#   `Option[U]` or `Result[U, E]` (same `E` — no `From` coercion).
# - Result type of the EBang node is the unwrapped success type `T`.
# Diagnostics name both types; the inner Expr is re-stamped with its
# resolved operand type so the C emitter can pick the correct
# discriminator (`Some` / `Ok`).
fn synth_bang(st: InferState, inner: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let ri = synth(st, inner)
  let it_now = apply_ty(ri.st.sub, ri.ty)
  let inner_typed = with_ty(ri.expr, it_now)
  match it_now {
    TyCon(tcs, args_) ->
      if core_ty_is(tcs, CtOption) {
        match args_ {
          [t] -> bang_finish_option(ri.st, inner_typed, t, line, col)
          _   -> bang_bad_operand(ri.st, it_now, inner_typed, line, col)
        }
      } else if core_ty_is(tcs, CtResult) {
        match args_ {
          [t, e_ty] -> bang_finish_result(ri.st, inner_typed, e_ty, t, line, col)
          _ -> bang_bad_operand(ri.st, it_now, inner_typed, line, col)
        }
      } else {
        bang_bad_operand(ri.st, it_now, inner_typed, line, col)
      }
    _ -> bang_bad_operand(ri.st, it_now, inner_typed, line, col)
  }
}


fn synth_many(st: InferState, es: [Expr]) : InferredList / Console + File + Mutable {


  match es {
    [] -> InferredList { st: st, tys: [], exprs: [] }
    [x, ...rest] -> {
      let r = synth(st, x)
      let rr = synth_many(r.st, rest)
      InferredList { st: rr.st, tys: [r.ty, ...rr.tys], exprs: [r.expr, ...rr.exprs] }
    }
  }
}


# Like `synth_many`, but each argument is paired with the declared
# parameter type at the same position (`param_tys`), which it is
# synthesised against; a missing expected type is a no-op.
fn synth_many_threaded(st: InferState, es: [Expr],
                        param_tys: [Ty]) : InferredList / Console + File + Mutable {
  match es {
    [] -> InferredList { st: st, tys: [], exprs: [] }
    [x, ...rest] -> {
      let exp = match param_tys { [pt, ...] -> Some(apply_ty(st.sub, pt))  _ -> None }
      let prest = match param_tys { [_, ...pr] -> pr  _ -> [] }
      let r = synth_threaded_arg(st, x, exp)
      let rr = synth_many_threaded(st_settle_arg(r.st, exp, r.ty, rest, prest), rest, prest)
      InferredList { st: rr.st, tys: [r.ty, ...rr.tys], exprs: [r.expr, ...rr.exprs] }
    }
  }
}


fn synth_threaded_arg(st: InferState, x: Expr,
                       exp: Option[Ty]) : Inferred / Console + File + Mutable =
  match exp {
    Some(et) ->
      if arg_wants_vec_context(x, et) {
        check_expr_against(st, x, et, "argument", x.line, x.col)
      } else { synth_expecting(st, x, et) }
    None -> synth(st, x)
  }


# `synth_many` with the callee's declared params threaded per position.
# The expected type routes a Vec-context arg (literal / collect) through
# the bidirectional check, coins a dimensioned numeric literal to the
# parameter's declared carrier (`10.50<USD>` against `Decimal<USD>`), and
# names the record a bare literal head builds; every other arg keeps the
# plain synth path.
fn synth_many_vec_args(st: InferState, es: [Expr],
                       param_tys: [Ty]) : InferredList / Console + File + Mutable {
  match es {
    [] -> InferredList { st: st, tys: [], exprs: [] }
    [x, ...rest] -> {
      let exp = match param_tys { [pt, ...] -> Some(apply_ty(st.sub, pt))  _ -> None }
      let prest = match param_tys { [_, ...pr] -> pr  _ -> [] }
      let r = match exp {
        Some(et) ->
          if arg_wants_vec_context(x, et) {
            check_expr_against(st, x, et, "argument", x.line, x.col)
          } else { synth_expecting(st, x, et) }
        None -> synth(st, x)
      }
      let lowered = match exp {
        Some(et) -> maybe_lower_decimal_lit(r.expr, r.ty, et, mint_bigint_home(st.env))
        None     -> ExprTy { expr: r.expr, ty: r.ty }
      }
      let rr = synth_many_vec_args(st_settle_arg(r.st, exp, lowered.ty, rest, prest), rest, prest)
      InferredList { st: rr.st, tys: [lowered.ty, ...rr.tys],
                     exprs: [lowered.expr, ...rr.exprs] }
    }
  }
}


# `synth_many` with each argument's declared parameter in hand, where no
# other context rule applies: a record literal's head is asked of it.
fn synth_many_expecting(st: InferState, es: [Expr], param_tys: [Ty]) : InferredList / Console + File + Mutable = match es {
  [] -> InferredList { st: st, tys: [], exprs: [] }
  [x, ...rest] -> {
    let exp = match param_tys { [pt, ...] -> Some(apply_ty(st.sub, pt))  _ -> None }
    let r = match exp {
      Some(et) -> synth_expecting(st, x, et)
      None     -> synth(st, x)
    }
    let prest = params_after_first(param_tys)
    let rr = synth_many_expecting(st_settle_arg(r.st, exp, r.ty, rest, prest), rest, prest)
    InferredList { st: rr.st, tys: [r.ty, ...rr.tys], exprs: [r.expr, ...rr.exprs] }
  }
}


# A `@x` the cell-read lowering never reached (a `const` initialiser has
# no cell scope) is typed as the method call it reads as, so it is
# reported the way a call of a missing method is.
fn synth_call_site(st: InferState, callee: Expr, args_: [Expr], line: Int, col: Int) : Inferred / Console + File + Mutable = match callee.kind {
  EMark(MkDeref) -> match args_ {
    [x] -> synth_call(st, mk_expr(EField(x, mark_name(MkDeref)), callee.line, callee.col), [], line, col)
    _   -> synth_call(st, callee, args_, line, col)
  }
  EMark(MkLazy(_)) -> match args_ {
    [x] -> synth_lazy_part(st, x)
    _   -> synth_call(st, callee, args_, line, col)
  }
  EMark(MkLazyRange) -> match args_ {
    [x] -> synth_lazy_range(st, x)
    _   -> synth_call(st, callee, args_, line, col)
  }
  _ -> synth_call(st, callee, args_, line, col)
}


fn synth_call(st: InferState, callee: Expr, args_: [Expr], line: Int, col: Int) : Inferred / Console + File + Mutable {


  # The bare core IO builtins (`print`, `read_file`, `array_set`, …)
  # carry their effect in their own scheme row (`builtin_table`), so the standard call-inference path below — the open-row
  # unification of the callee's `TyFnT` plus `st_propagate_capability_labels`
  # — raises the label on the caller's row, exactly as for an explicit
  # `Eff.op(...)` call or a stdlib fn written `: T / Stdout`. No name-keyed
  # side table is needed; `check_body_row` still enforces row declaration
  # uniformly.
  let st_p = st
  match try_resume_call(st_p, callee, args_, line, col) {
    Some(inf) -> inf
    None ->
      match try_op_call(st_p, callee, args_, line, col) {
        Some(inf) -> inf
        None -> match try_ufcs_call(st_p, callee, args_, line, col) {
          Some(inf) -> inf
          None -> match try_constructor_call(st_p, callee, args_, line, col) {
            Some(inf) -> inf
            None -> match try_record_type_call(st_p, callee, args_, line, col) {
            Some(inf) -> inf
            None -> match try_bare_call_narrow(st_p, callee, args_, line, col) {
            Some(inf) -> inf
            None -> {
            let rc = nullary_op_noted(synth_callee(st_p, callee), args_, line, col)
            let callee_ty = apply_ty(rc.st.sub, rc.ty)
            match cont_parts(callee_ty) {
              Some(cp) -> synth_cont_call(rc, cp, args_, line, col)
              None -> {
            # pair each arg with its declared param so a Vec-typed
            # param mints an EList / collects a map-pipe chain — the
            # argument-position face of the annotation-context rules.
            let vparams = match callee_ty {
              TyFnT(ps, _, _) -> ps
              _               -> []
            }
            let ra = synth_many_vec_args(rc.st, args_, vparams)
            let rv = st_fresh_ty(ra.st)
            # An open expected row keeps the callee's own row unforced; its
            # labels reach the caller through st_propagate_capability_labels.
            let fr = subst_fresh_row(rv.st.sub)
            let st_fresh = st_set_sub(rv.st, fr.subst)
            let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
            let expected = TyFnT(ra.tys, rv.ty, expected_row)
            let st_unif = dot_identity_help(st_fresh, st_unify_call(st_fresh, callee, rc.ty, ra.tys, expected, line, col),
                                            rc.ty, ra.tys, args_)
            let st2 = st_propagate_capability_labels(st_unif,
                        apply_ty(st_unif.sub, rc.ty), line, col)
            let ca = coerce_lambda_args(coerce_ctor_args(st2, rc.expr, ra.exprs, ra.tys, rc.ty), rc.ty)
            match refine_call(ca.st, rc.expr, rc.ty, ca.exprs, ca.tys, apply_ty(st2.sub, rv.ty)) {
              RefCall(st3, ty) -> mk_inferred(st3, ty, with_ty(mk_expr(ECall(rc.expr, ca.exprs), line, col), ty))
            }
              }
            }
            }
          }
          }
          }
        }
      }
  }
}


# `k(v)` on a `Cont[T, S, e]`: resume with a `T`, get the handle's `S`; the
# body runs on, so the caller performs `e`. A stateful handle's
# `Cont[(T, H), S, e]` is called `k(v, s)` and resumes with the pair.
fn synth_cont_call(rc: Inferred, cp: ContParts, args_: [Expr], line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let r = match args_ {
    [v] -> cont_arg(synth(rc.st, v), cp, "continuation argument")
    [v, s] -> cont_arg(synth(rc.st, tuple_lit_expr([v, s], line, col)), cp, "continuation value and state")
    _ -> {
      let ra = synth_many(rc.st, args_)
      inferred_leaf(seg_error(ra.st, rc.expr, "a continuation takes a value, or a value and a state", "call it as `k(v)`, or `k(v, s)` for a stateful handle's").st, TyUnit, rc.expr)
    }
  }
  let st2 = st_propagate_capability_labels(r.st, apply_ty(r.st.sub, cp.row), line, col)
  mk_inferred(st2, cp.answer, with_ty(mk_expr(ECall(rc.expr, [r.expr]), line, col), cp.answer))
}


# `#[constructor]` sugar: a call whose callee is a bare type name with
# a registered constructor desugars to a call to that fn,
# so `Rational(2, 3)` routes through `rational.make` — passing
# the fn's logic (canonicalisation, invariants), never the raw record
# literal — and its arg literals mint against `make`'s param types.
fn try_constructor_call(st: InferState, callee: Expr, args_: [Expr],
                        line: Int, col: Int) : Option[Inferred] / Console + File + Mutable {

  match constructor_of_type(st, callee_type_sym(st, callee)) {
    Some(CtorE(_, fsym)) -> {
      let qcallee = mk_sym(fsym, callee.line, callee.col)
      # coin bare numeric args to the marked fn's param types (its
      # scheme is concrete, e.g. `make(BigInt, BigInt)`), so
      # `Rational(2, 3)` mints `2`/`3` to `BigInt`. Call-arg minting
      # is not automatic, so the sugar does it explicitly here.
      let minted_args = match env_sym(st.env, fsym) {
        Some(sc) -> constructor_mint_args(st.env, sc, args_)
        None     -> args_
      }
      let rewritten = mk_expr(ECall(qcallee, minted_args), line, col)
      Some(synth(st, rewritten))
    }
    None -> None
  }
}


# when a bare-name callee has several candidate schemes
# (`option.map`, `list.map`, `result.map`, ...), narrow by the type of
# the FIRST argument before instantiating: the scope alone would call it
# a tie.
#
# Returns Some only when:
#   - callee is a name the resolver left unsettled,
#   - the name has 2+ candidates in the env (otherwise the default arm
#     does the right thing already),
#   - args_ is non-empty (we need a first-arg type to narrow on),
#   - some candidate's first param unifies with the first arg's type.
# Otherwise returns None and the caller falls through to the default
# arm, where the scope settles the name and the diagnostics for missing
# names / arity mismatches fire.
fn try_bare_call_narrow(st: InferState, callee: Expr, args_: [Expr],
                         line: Int, col: Int) : Option[Inferred] / Console + File + Mutable {


  match callee.kind {
    EName(w) -> {
      # A declaration the resolver reached arrives stamped; a bare name
      # here is a contest it left to the type. The candidates are
      # functions only: a constructor is never a receiver-typed
      # dispatch target.
      let candidates = bare_fn_candidates(st, w)
      let n_cand = list_length(candidates)
      if n_cand < 2 { None }
      else {
        match args_ {
          [] -> None
          [first_arg, ...rest_args] -> {
            let r0 = synth(st, first_arg)
            let first_ty = apply_ty(r0.st.sub, r0.ty)
            match hom_try_defer(r0.st, w, candidates, first_ty, r0.expr,
                                 rest_args, callee, line, col) {
              Some(inf) -> Some(inf)
              None ->
            match pick_by_first_arg(r0.st, candidates, first_ty, callee.line, callee.col) {
              FaNone -> None
              FaTie(st_t, ss) -> {
                let st_e = report_name_tie(st_t, w, ss, true, callee.line, callee.col)
                Some(mk_inferred(st_e, TyAny, with_ty(mk_expr(ECall(callee, [r0.expr, ...rest_args]), line, col), TyAny)))
              }
              FaOne(pick) -> {
                let st_inst = pick_inst(pick, line, col)
                let ra_rest = synth_many_expecting(st_inst, rest_args, params_after_first(fn_param_tys(st_inst, pick.inst_ty)))
                let all_arg_tys = [first_ty, ...ra_rest.tys]
                let all_arg_exprs = [r0.expr, ...ra_rest.exprs]
                let rv = st_fresh_ty(ra_rest.st)
                let fr = subst_fresh_row(rv.st.sub)
                let st_fresh = st_set_sub(rv.st, fr.subst)
                let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
                let expected = TyFnT(all_arg_tys, rv.ty, expected_row)
                # propagate capability-only labels only.
                let st_unif = st_unify_call(st_fresh, callee, pick.inst_ty, all_arg_tys, expected, line, col)
                let st2 = st_propagate_capability_labels(st_unif,
                            apply_ty(st_unif.sub, pick.inst_ty), line, col)
                let ty = apply_ty(st2.sub, rv.ty)
                let callee_node = with_ty(pick_ref(pick, callee.line, callee.col), pick.inst_ty)
                match refine_call(st2, callee, pick.inst_ty, all_arg_exprs, all_arg_tys, ty) {
                  RefCall(st3, ty3) -> Some(mk_inferred(st3, ty3, with_ty(mk_expr(ECall(callee_node, all_arg_exprs), line, col), ty3)))
                }
              }
            }
            }
          }
        }
      }
    }
    _ -> None
  }
}


# A bare call several modules could answer, written where the first
# argument's type is still a variable. Nothing can be committed here: a
# variable fits every candidate. So
# record the call against its expected function type, stamp a fresh
# result tyvar, and let `infer_decl` decide once the body has settled;
# the worklist mirrors the deferred field accesses. Only a candidate set
# an argument's head CAN decide is deferred, which leaves every other
# bare call on the path it already took.
fn hom_try_defer(st: InferState, w: Written, candidates: [TyCandidate],
                  first_ty: Ty, first_expr: Expr, rest_args: [Expr],
                  callee: Expr, line: Int, col: Int) : Option[Inferred] / Console + File + Mutable {
  match hom_head(first_ty) {
    Some(_) -> None
    None -> {
      if hom_decidable(hom_cands_of(candidates)) == false { None } else {
      let ra = synth_many(st, rest_args)
      let rv = st_fresh_ty(ra.st)
      let fr = subst_fresh_row(rv.st.sub)
      let st_fresh = st_set_sub(rv.st, fr.subst)
      let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
      let want = TyFnT([first_ty, ...ra.tys], rv.ty, expected_row)
      let st1 = st_push_deferred_hom(st_fresh, DHom(w, want, callee.line, callee.col))
      let callee_node = with_ty(callee, want)
      let root = with_ty(mk_expr(ECall(callee_node, [first_expr, ...ra.exprs]), line, col), rv.ty)
      Some(mk_inferred(st1, rv.ty, root))
    } }
  }
}


# type-check `resume(v)` in a STATELESS clause against `resume`'s env scheme
# (`bind_resume_param_typed` bound it to `(answer) -> ?fresh`). Done here
# rather than via the generic `synth(callee)` path so the callee `resume`
# never reaches the value-position guard of a local read.
fn synth_resume_call_stateless(st: InferState, k: LocalId, args_: [Expr], callee: Expr,
                                line: Int, col: Int) : Inferred / Console + File + Mutable {
  let callee_ty = match env_local(st.env, k) {
    Some(sc) -> (st_instantiate_report(st, sc)).ty
    None     -> TyAny
  }
  let ra = synth_many(st, args_)
  let rv = st_fresh_ty(ra.st)
  let fr = subst_fresh_row(rv.st.sub)
  let st_fresh = st_set_sub(rv.st, fr.subst)
  let expected = TyFnT(ra.tys, rv.ty, Row { labels: [], tail: Some(fr.id), display_alias: None })
  let st_unif = st_unify_call(st_fresh, callee, callee_ty, ra.tys, expected, line, col)
  let ty = apply_ty(st_unif.sub, rv.ty)
  let resume_root = with_ty(mk_local(local_minted(canonical_continuation()), callee.line, callee.col), callee_ty)
  let root = with_ty(mk_expr(ECall(resume_root, ra.exprs), line, col), ty)
  mk_inferred(st_unif, ty, root)
}


# `$resume_frame(f)`, minted by the non-tail `resume` split: `f` takes
# the handle's result and yields the next one, and it runs at the handle's
# exit in the clause's own context, so its effects are the clause's.
fn synth_resume_frame(st: InferState, args_: [Expr], e: Expr) : Inferred / Console + File + Mutable = match args_ {
  [f] -> {
    let rf = synth(st, f)
    let s_ty = clause_result_ty(rf.st)
    let fr = subst_fresh_row(rf.st.sub)
    let expected = TyFnT([s_ty], s_ty, Row { labels: [], tail: Some(fr.id), display_alias: None })
    let st1 = st_unify(st_set_sub(rf.st, fr.subst), expected, rf.ty, "deferred clause tail", e.line, e.col)
    let st2 = st_propagate_capability_labels(st1, apply_ty(st1.sub, rf.ty), e.line, e.col)
    mk_inferred(st2, TyUnit, with_ty(mk_expr(EIntrinsic(InResumeFrame, [rf.expr]), e.line, e.col), TyUnit))
  }
  _ -> {
    let perr = mk_diag(SevError, st.file, e.line, e.col, "compiler intrinsic `$resume_frame` takes one argument", [])
    render_diag(perr)
    inferred_leaf(st_bump_err(st_push_diag(st, perr)), TyAny, e)
  }
}


# `$seg_request(i, args...)`: a forwarding clause handing op `i` to its
# segment handle; its value is what the continuation is called with.
fn synth_seg_request(st: InferState, args_: [Expr], e: Expr) : Inferred / Console + File + Mutable = match args_ {
  [ix, ...xs] -> {
    let ra = synth_many(st, xs)
    let r = st_fresh_ty(ra.st)
    mk_inferred(r.st, r.ty, with_ty(mk_expr(EIntrinsic(InSegRequest, [with_ty(ix, TyInt), ...ra.exprs]), e.line, e.col), r.ty))
  }
  [] -> seg_error(st, e, "compiler intrinsic `$seg_request` takes an op index", "")
}


# `$seg_handle(escapes, reason, body, return, clause...)`: the body thunk is
# typed first; its forwarders' requests give each clause its parameter types
# and its continuation `Cont[answer, S, e]`, where `S` is the handle's type and
# `e` the thunk's row: what the body performs besides the handled effect.
fn synth_seg_handle(st: InferState, args_: [Expr], e: Expr) : Inferred / Console + File + Mutable = match args_ {
  [esc, why, thunk, ret, ...cls] -> {
    let rt = synth(st, thunk)
    let (body_ty, e_ty) = match apply_ty(rt.st.sub, rt.ty) {
      TyFnT(_, b, row) -> (b, row_arg_carrier(row))
      t -> (t, row_arg_carrier(inf_row_empty()))
    }
    let rs = st_fresh_ty(rt.st)
    let rr = seg_lambda(rs.st, ret, [body_ty], rs.ty)
    let rc = seg_clauses(rr.st, cls, rt.expr, rs.ty, e_ty, 0, [])
    let st1 = seg_absorb(seg_absorb(rc.st, rt.ty, e), rr.ty, e)
    let node = mk_expr(EIntrinsic(InSegHandle, [esc, why, rt.expr, rr.expr, ...rc.exprs]), e.line, e.col)
    mk_inferred(st1, rs.ty, with_ty(node, rs.ty))
  }
  _ -> seg_error(st, e, "compiler intrinsic `$seg_handle` has a malformed argument list", "")
}


fn seg_clauses(st: InferState, cls: [Expr], body: Expr, s_ty: Ty, e_ty: Ty, i: Int, acc: [Expr]) : SegClauses / Console + File + Mutable =
  match cls {
    [] -> SegClauses { st: st, exprs: list_reverse(acc) }
    [c, ...rest] -> {
      let pins = match seg_request_at(body, i) {
        Some(req) -> [...map(req.args, (a) => ty_of_expr(a)), cont_ty(ty_of_expr(req.at), s_ty, e_ty)]
        None -> []
      }
      let r = seg_lambda(st, c, pins, s_ty)
      seg_clauses(seg_absorb(r.st, r.ty, c), rest, body, s_ty, e_ty, i + 1, [r.expr, ...acc])
    }
  }


# A clause or return lambda: parameters pinned, result the handle's type.
# The `()` standing for a missing return clause passes the body's value on.
fn seg_lambda(st: InferState, lam: Expr, pins: [Ty], s_ty: Ty) : Inferred / Console + File + Mutable = match lam.kind {
  EUnit -> match pins {
    [b] -> mk_inferred(st_unify(st, s_ty, b, "handle result", lam.line, lam.col), TyUnit, with_ty(lam, TyUnit))
    _ -> synth(st, lam)
  }
  ELambda(ps, b) -> {
    let r = synth_lambda_pinned(st, ps, b, pins, "handler clause", lam.line, lam.col)
    let res = match apply_ty(r.st.sub, r.ty) { TyFnT(_, t, _) -> t  t -> t }
    Inferred { ...r, st: st_unify(r.st, s_ty, res, "handler clause result", lam.line, lam.col) }
  }
  _ -> synth(st, lam)
}


# type-check `resume(v)` / `resume(v, ns)` inside a clause body.
# Stateful clauses validate against `clause_resume` (precise answer/state
# types); stateless clauses type the call against `resume`'s env scheme.
# Intercepting the call here keeps the callee off the local-read arm of
# `synth`, whose value-position guard would otherwise reject this legal call.
# Returns None when the call is not a resume inside a clause.
fn try_resume_call(st: InferState, callee: Expr, args_: [Expr],
                    line: Int, col: Int) : Option[Inferred] / Console + File + Mutable {


  match callee.kind {
    ELocal(l) -> match st.in_clause {
      CcOwn(k) -> if local_eq(l, k.id) {
        match st.clause_resume {
          Some(rb) -> Some(synth_resume_call(st, rb, args_, callee, line, col))
          None     -> Some(synth_resume_call_stateless(st, l, args_, callee, line, col))
        }
      } else { None }
      CcInLambda(k) -> if local_eq(l, k.id) { Some(lambda_resume_call(st, k.name, callee)) } else { None }
      CcNone -> None
    }
    _ -> None
  }
}


fn synth_resume_call(st: InferState, rb: ResumeBind, args_: [Expr],
                      callee: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  match rb {
    RB(answer_ty, state_ty, result_ty) -> {
      let ra = synth_many(st, args_)
      let rv = ty_res(ra.st, result_ty)
      # st_unify treats the first arg as `expected` and the second as
      # `found`; the resume answer is what the clause must produce, so
      # answer_ty is the `expected` slot.
      let st_after = match ra.tys {
        [a]     -> st_unify(rv.st, answer_ty, a,
                             "resume answer", line, col)
        [a, ns] -> {
          let s1 = st_unify(rv.st, answer_ty, a,
                              "resume answer", line, col)
          st_unify(s1, state_ty, ns,
                    "resume new state", line, col)
        }
        _ -> {
          let perr = mk_diag(SevError, rv.st.file, line, col,
            "resume call: expected 1 or 2 arguments inside a stateful clause", [])
          render_diag(perr)
          diag_note("`resume(v)` resumes with the answer; `resume(v, ns)` also writes the new handler state")
          diag_help("for `with State[T]` and `with Writer[W]`, use `resume(v, new_state)`; otherwise `resume(v)`")
          st_bump_err(st_push_diag(rv.st, perr))
        }
      }
      let ty = apply_ty(st_after.sub, rv.ty)
      let resume_root = with_ty(mk_local(local_minted(canonical_continuation()), callee.line, callee.col), TyAny)
      let root = with_ty(mk_expr(ECall(resume_root, ra.exprs), line, col), ty)
      mk_inferred(st_after, ty, root)
    }
  }
}


# detect the surface shape `Eff.op(args)` and treat it as
# an op call. Args are unified against the op's parameter types; the
# result type is the op's return type; `Eff` is added to the caller's row.
#
# The resolver settled the head: a declared effect (a row alias reads as
# the component that declares the op) is its id, an alias binder or a
# capability parameter is the local it is. If `Eff` is an effect but the
# op is missing, we emit a dedicated diagnostic instead of falling
# through to the generic `unknown identifier` path.
fn try_op_call(st: InferState, callee: Expr, args_: [Expr],
               line: Int, col: Int) : Option[Inferred] / Console + File + Mutable {


  match callee.kind {
    EField(base, op_name) -> match base.kind {
      ESym(bsym, _) -> match env_op(st.env, bsym, written(op_name)) {
        Some(sc) -> Some(record_op_res(synth_op_call_with_scheme(st, sc, args_, bsym, op_name, line, col), bsym, written(op_name), None, false, line, col))
        None ->
          if env_has_effect(st.env, bsym) {
            Some(synth_op_call_unknown_op(st, bsym, op_name, line, col))
          } else { None }
      }
      # A local heads the op: an alias bound by an enclosing
      # `handle ... with Eff as name`, else a capability PARAMETER
      # (`c: Eff`), provided by the caller, whose op does not join the row
      # (§6 named instances).
      ELocal(l) -> match lookup_alias_taggable(st.aliases, l) {
        None -> cap_op_call(st, l, op_name, args_, line, col)
        Some(taggable) -> {
          # The callee names the declaration the `handle` head resolved to.
          let asym = lookup_alias_sym(st.aliases, l)
          # `@cap` desugars to `cap.get()` for every capability shape; for
          # a Reader-bound alias the op is `ask`, not `get`.
          let real_op = canonical_cap_getter(asym, op_name)
          # §6 named instances: a `with Eff as name` binding dispatches
          # `name.op` against the handle's own evidence node, the value the
          # alias holds — the same path a capability parameter uses, no
          # by-id walk. `var`/State/Reader cells keep the by-id dispatch:
          # their naked-read sugar and nested-cell identity ride that path.
          # Inside a lambda body the prologue local is out of scope, so the
          # instance is not named and the ambient lookup runs.
          let via = if not taggable { ViaAmbient }
                    else if eff_is_cell_effect(asym) { ViaAlias(l) }
                    else { ViaRecv(l) }
          # The row label is tagged with the cell whatever `taggable`
          # says: row identity must hold inside a lambda too (the `while`
          # thunks are lambdas).
          match env_op(st.env, asym, written(real_op)) {
            Some(sc) -> Some(record_op_res(synth_op_call_with_scheme_keys(st, sc, args_, asym, real_op, via, Some(l), line, col), asym, written(real_op), Some(l), taggable, line, col))
            None ->
              if env_has_effect(st.env, asym) {
                Some(synth_op_call_unknown_op(st, asym, real_op, line, col))
              } else { None }
          }
        }
      }
      _ -> None
    }
    _ -> None
  }
}


# UFCS dispatch for `receiver.method(args)` callees.
#
# Fires from `synth_call` when the callee shape is `EField(obj, ident)`
# and `try_op_call` already declined (so `obj` is not an effect-name
# reference). Walks `obj` once to learn its type, then applies the
# field-vs-function precedence rule:
#
#   1. If `obj` is a record value AND `ident` names a field of that
#      record, returns None — let `synth_call`'s generic path run
#      `synth(st, callee)` (which dispatches `synth_field`) so field
#      access wins on ties.
#   2. Else if `ident` names a function whose first parameter unifies
#      with `obj`'s type, lowers the call to `ident(obj, ...args)` on that
#      function's id and finishes typing it with the same expected-row
#      pattern `synth_call`/`synth_pipe_dispatch` use, so call-site
#      row-tracking and unify diagnostics stay identical to the prefix
#      form.
#   3. Else, emits a Q4-style diagnostic naming the receiver type and
#      hinting at scope candidates whose first arg matches, then
#      stamps `TyAny` to keep cascade graceful.
#
# Returning Some always means "we handled this call site". Returning
# None always means "let the generic `synth(st, callee)` path run" —
# used for the field-wins precedence step.
fn try_ufcs_call(st: InferState, callee: Expr, args_: [Expr],
                  line: Int, col: Int) : Option[Inferred] / Console + File + Mutable {


  match callee.kind {
    EField(obj, ident) -> {
      let r = synth(st, obj)
      let obj_ty = apply_ty(r.st.sub, r.ty)
      if record_has_field(r.st, obj_ty, ident) { None }
      else {
        # `c := v` and `@c` for `c : Ref[T]` desugar in
        # the parser to `c.set(v)` / `c.get()`. `Ref[T]` is the
        # return type of `Mutable.ref_make[T]`; `get`/`set` aren't
        # inherent methods, but `Mutable` carries `ref_get`/`ref_set`
        # ops with matching signatures. Bridge here, mirroring the
        # `a[i] := v` → `Mutable.array_set(a, i, v)` precedent.
        # Effect-row injection rides for free: `synth_op_call_with_scheme`
        # already labels the row with `Mutable` for op calls.
        match try_ref_sugar_op(st, obj, obj_ty, ident, args_, line, col) {
          Some(inf) -> Some(inf)
          None -> Some(synth_ufcs_dispatch(r.st, ident, r.expr, obj_ty, args_, line, col))
        }
      }
    }
    _ -> None
  }
}


# rewrite `c.get()` / `c.set(v)` to `Mutable.ref_get(c)` /
# `Mutable.ref_set(c, v)` when `c : Ref[T]`. Returns None when the
# receiver is not a `Ref` or the ident is not `get` / `set`, so the
# caller falls back to the regular UFCS path (preserving the existing
# "method not found" diagnostic for unrelated names).
fn try_ref_sugar_op(st: InferState, obj: Expr, obj_ty: Ty, ident: String,
                     args_: [Expr], line: Int, col: Int) : Option[Inferred] / Console + File + Mutable {


  match obj_ty {
    TyCon(tcs, _) ->
      if core_ty_is(tcs, CtRef) {
        let op_opt =
          if ident == "get" { Some("ref_get") }
          else if ident == "set" { Some("ref_set") }
          else { None }
        match op_opt {
          None -> None
          Some(op) -> {
            let ms = core_effect_id(CeMutable)
            match env_op(st.env, ms, written(op)) {
              None -> None
              Some(sc) -> {
                # `obj` re-walks once inside `synth_op_call_with_scheme`
                # (via `synth_many`); typing a read twice is idempotent.
                let all_args = [obj, ...args_]
                Some(synth_op_call_with_scheme(st, sc, all_args, ms, op, line, col))
              }
            }
          }
        }
      } else { None }
    _ -> None
  }
}


# Lowers `obj.ident(args)` to `ident(obj, args)`. Picks among the
# functions spelled `ident`; if none is found or its first param doesn't
# unify with `obj_ty`, emits the Q4 method-not-found diagnostic and
# returns a TyAny stamp. Mirrors `synth_pipe_dispatch`'s open-row pattern
# so the dispatched call's effect labels and unify diagnostics match
# the prefix-form call (`ident(obj, args)`).
#
# `obj_expr` has already been walked by `try_ufcs_call`; we walk
# `args_` ourselves to avoid double-walking `obj` (the args may
# carry their own effect labels and CallSite entries which must
# stamp the final InferState).
fn synth_ufcs_dispatch(st: InferState, ident: String, obj_expr: Expr,
                        obj_ty: Ty, args_: [Expr],
                        line: Int, col: Int) : Inferred / Console + File + Mutable {


  match ufcs_target(st, ident, obj_ty, line, col) {
    UfNone -> ufcs_method_not_found(st, ident, obj_expr, obj_ty, args_, line, col)
    UfTie(st_t, ss) -> {
      let st_e = report_tie(st_t, ident, ss, true, line, col)
      mk_inferred(st_e, TyAny, with_ty(mk_expr(ECall(field_root(obj_expr, ident, line, col, TyAny), args_), line, col), TyAny))
    }
    UfOne(target) -> {
      let st_inst = target.st
      let inst_ty = target.inst_ty
      match inst_ty {
        TyFnT(params, _, _) -> match params {
          [] -> ufcs_method_not_found(st_inst, ident, obj_expr, obj_ty, args_, line, col)
          [first, ..._rest] -> match unify_env(st_inst.env, first, obj_ty, st_inst.sub) {
            None -> ufcs_method_not_found(st_inst, ident, obj_expr, obj_ty, args_, line, col)
            Some(_) -> {
              # Walk the remaining args (obj is already typed in obj_expr).
              # Thread each declared param type (skip the receiver at
              # params[0]) so a point-free section arg gets its receiver
              # pinned from the combinator's element type up front.
              let arg_param_tys = match params { [_, ...pr] -> pr  _ -> [] }
              let ra = synth_many_threaded(st_inst, args_, arg_param_tys)
              let all_arg_tys = [obj_ty, ...ra.tys]
              let all_arg_exprs = [obj_expr, ...ra.exprs]
              # Same expected-row pattern `synth_call` and
              # `synth_pipe_dispatch` use: open-row tail so the
              # callee's declared row variables don't force-bind the
              # call site's row.
              let rv = st_fresh_ty(ra.st)
              let fr = subst_fresh_row(rv.st.sub)
              let st_fresh = st_set_sub(rv.st, fr.subst)
              let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
              let expected = TyFnT(all_arg_tys, rv.ty, expected_row)
              let synth_callee = target.callee
              # propagate capability-only labels through UFCS.
              let st_unif = st_unify_call(st_fresh, synth_callee, inst_ty, all_arg_tys, expected, line, col)
              let st2 = st_propagate_capability_labels(st_unif,
                          apply_ty(st_unif.sub, inst_ty), line, col)
              let callee_node = with_ty(synth_callee, inst_ty)
              match refine_call(st2, synth_callee, inst_ty, all_arg_exprs, all_arg_tys, apply_ty(st2.sub, rv.ty)) {
                RefCall(st3, ty) -> mk_inferred(st3, ty, with_ty(mk_expr(ECall(callee_node, all_arg_exprs), line, col), ty))
              }
            }
          }
        }
        _ -> ufcs_method_not_found(st_inst, ident, obj_expr, obj_ty, args_, line, col)
      }
    }
  }
}


# Type `name.op(args)` where `name` is a capability value. Dispatch the op to the
# effect it carries; codegen reads `name`'s evidence node. The effect does NOT
# join the row — the capability is provided, not demanded.
fn cap_op_call(st: InferState, l: LocalId, op_name: String, args_: [Expr],
               line: Int, col: Int) : Option[Inferred] / Console + File + Mutable =
  match cap_eff_of_var(st, l) {
    None -> None
    Some(esym) -> match env_op(st.env, esym, written(op_name)) {
      Some(sc) -> Some(synth_op_call_provided(st, sc, args_, l, esym, op_name, line, col))
      None     -> Some(synth_op_call_unknown_op(st, esym, op_name, line, col))
    }
  }


fn synth_op_call_with_scheme(st: InferState, sc: TyScheme, args_: [Expr],
                              esym: SymId, op: String, line: Int, col: Int) : Inferred / Console + File + Mutable {


  # No alias: a direct `Eff.op(...)` call is not a `with ... as <name>`
  # cell, so it reaches the ambient handler and its row label is the
  # effect's own.
  synth_op_call_with_scheme_keys(st, sc, args_, esym, op, ViaAmbient, None, line, col)
}


# An op call on a PROVIDED capability (`c.op(...)` where `c: Eff` is a value
# parameter, §6 named instances). Types the call exactly like a normal op call —
# instantiate, unify args against the op scheme — but does NOT add the effect to
# the body's row: a capability passed in is satisfied by the caller, not demanded
# by this function (design §3 "capability as a parameter does not enter the row").
# Codegen reads the evidence from the parameter's own slot, so distinct instances
# stay distinct by parameter position.
fn synth_op_call_provided(st: InferState, sc: TyScheme, args_: [Expr],
                           recv: LocalId, esym: SymId, op: String, line: Int, col: Int) : Inferred / Console + File + Mutable {
  let inst = st_instantiate_report(st, sc)
  let ra = synth_many_expecting(inst.st, args_, fn_param_tys(inst.st, inst.ty))
  let rv = st_fresh_ty(ra.st)
  let expected = fn_ty(ra.tys, rv.ty)
  let st2 = st_unify(rv.st, inst.ty, expected, op_what(st, "cap op call ", esym, op), line, col)
  let ty = apply_ty(st2.sub, rv.ty)
  # The callee goes through the receiver, so codegen reads `recv`'s own
  # evidence slot rather than walking by effect — distinct capability params
  # resolve to distinct nodes. No row label: the capability is provided, not
  # demanded.
  let root = with_ty(mk_expr(ECall(op_callee(esym, op, ViaRecv(recv), line, col), ra.exprs), line, col), ty)
  mk_inferred(st2, ty, root)
}


fn synth_op_call_with_scheme_keys(st: InferState, sc: TyScheme, args_: [Expr],
                                   esym: SymId, op: String, via: OpVia,
                                   row_alias: Option[LocalId],
                                   line: Int, col: Int) : Inferred / Console + File + Mutable {


  # capture the fresh ids minted by instantiation. For
  # parametric effects (where the scheme quantifies over the effect's
  # tparams) these fresh tyvars are the row label's ty_args. For
  # stateless effects the list is empty and the label has none.
  # per-op generic schemes also quantify over op-level
  # tparams; those are NOT part of the row label's ty_args. Use the
  # `op_eff_arities` table to take only the first N fresh ids
  # (corresponding to the effect's tparams) for the row.
  # `via` routes the perform through the handle's own instance; the
  # type-level lookups (op_eff_arities, row label) read the effect.
  let inst = st_instantiate_report(st, sc)
  let eff_fresh = take_first(inst.fresh, eff_tparam_arity(st.op_eff_arities, esym))
  # Read before unifying: the substitution's slots mutate in place.
  let pinned = map(eff_fresh, (id) => occurs(id, inst.ty, inst.st.sub))
  let ra = synth_many_expecting(inst.st, args_, fn_param_tys(inst.st, inst.ty))
  let rv = st_fresh_ty(ra.st)
  let expected = fn_ty(ra.tys, rv.ty)
  let st2 = st_unify(rv.st, inst.ty, expected, op_what(st, "op call ", esym, op), line, col)
  let row_args = phantom_eff_args(eff_fresh, pinned, st2.sub)
  # tag the row label with the cell so two distinct
  # `with <eff> as <name>` cells stay distinct labels. The cell is
  # discharged symmetrically by its own handler.
  let cell = alias_cell(row_alias)
  let lab = label_in_cell(esym, row_args, cell)
  # stash the effect + live payload tyvar ids before
  # `st_add_label`, whose dedup may drop this label against a sibling op's
  # concrete label of the same effect. The deferred-field drain reads it
  # to pin a receiver the dropped label was the only carrier for, under
  # the final sub so the `match` binder's receiver-to-payload link shows.
  let st2p = st_push_op_payload_vars(st2, esym, cell, eff_fresh)
  # The cell keeps distinct cells apart, so this only
  # threads ty_args between ops of the same cell (`cur.set` → `cur.get`).
  let st2u = st_unify_dedup_label(st2p, lab, line, col)
  let st3 = st_add_label(st2u, lab, line, col)
  let ty = apply_ty(st3.sub, rv.ty)
  # The callee carries the instance the perform resolved to, for evidence selection.
  let callee = with_ty(op_callee(esym, op, via, line, col), TyCon(esym, row_args))
  let root = with_ty(mk_expr(ECall(callee, ra.exprs), line, col), ty)
  mk_inferred(st3, ty, root)
}


fn synth_field(st: InferState, obj: Expr, fnm: String, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let r = synth(st, obj)
  let applied = apply_ty(r.st.sub, r.ty)
  # A unit or a refinement wraps the record that carries the fields.
  let carrier = ty_dispatch_head(applied)
  match carrier {
    TyCon(tsym, _) -> match rec_pick(r.st.recs, tsym) {
      None -> field_non_record_or_partial_app(r.st, r.expr, applied, fnm, line, col)
      Some(ri) -> {
        let inst = rec_instantiate(r.st, ri)
        let st1 = st_unify(inst.st, inst.result_ty, carrier, "record field access", line, col)
        match fty_find(inst.fields, fnm) {
          Some(t) -> {
            let ty = apply_ty(st1.sub, t)
            mk_inferred(st1, ty, field_root(r.expr, fnm, line, col, ty))
          }
          None -> {
            let perr = mk_diag(SevError, st.file, line, col, "no field '#{fnm}' on #{decl_name(st.env.tab, tsym)}#{field_hint(inst.fields, fnm)}", [])
            render_diag(perr)
            mk_inferred(st_bump_err(st_push_diag(st1, perr)), TyAny, field_root(r.expr, fnm, line, col, TyAny))
          }
        }
      }
    }
    # the receiver's type is still an unbound tyvar — the
    # canonical case is the payload of a generic effect op (`Some(b) ->
    # b.id` where `b : ?a` and `?a` is only pinned to the row's `Box`
    # later by `check_body_row`). We cannot decide field-vs-UFCS here:
    # eager UFCS (the `_` fallback below) is exactly the wrong guess —
    # it produces a bogus diagnostic. Defer instead — record a
    # constraint keyed on the receiver tyvar, stamp the access with a
    # FRESH result tyvar (not TyAny, so downstream uses stay connected),
    # and let `infer_decl` resolve it once the receiver settles. This is
    # purely a timing fix in the field-access path; it touches neither
    # effect-row inference nor the UFCS rule for resolved receivers.
    TyVarT(recv_id) -> {
      let fr = st_fresh_ty(r.st)
      let res_id = ty_var_id(fr.ty)
      let st1 = st_push_deferred_field(fr.st, DFd(recv_id, fnm, res_id, line, col, false))
      mk_inferred(st1, fr.ty, field_root(r.expr, fnm, line, col, fr.ty))
    }
    _ -> field_non_record_or_partial_app(r.st, r.expr, applied, fnm, line, col)
  }
}


# `e1[e2]` dispatches on the container's inferred
# type. `Map[K, V]` lowers to `map.get(coll, ix)` and `HashMap[K, V]`
# to `hashmap.get(coll, ix)` (both return `Option[V]`); any
# other container — including unresolved type variables — falls back
# to `array_get(coll, ix)` so the unifier produces the existing
# "expected `Array[T]`" error message at the call site. The chosen
# callee's scheme types the arguments, the result AND the effect row —
# `hashmap_get`'s `/ Mutable` included. `coll` is walked exactly once:
# the call is typed against a placeholder (`compiler.index_coll`).
#
# Design note (not a smell — kept as a closed 3-case dispatch on
# purpose): a smell audit flagged the `name == "Map"` test as wanting
# an `Index` protocol. It does not. kaikai has exactly three indexable
# containers (Array, Map, HashMap), and the language bans
# type-class-style resolution — a closed compile-time dispatch is
# precisely what is preferred over a resolution mechanism. An `Index`
# protocol
# would not remove a hardcode, it would move it (the proto name + the
# builtin impls) across more sites and route every `[]` through the
# proto impl-table at runtime. Worse, it would degrade this error:
# the Array fallback for an unresolved type var is deliberate, and a
# protocol over `?t` can only emit a generic "no `Index` impl" or
# re-hardcode the Array bias inside the resolver.
fn synth_index(st: InferState, coll: Expr, ix: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {
  let probe = synth(st, coll)
  let coll_ty = apply_ty(probe.st.sub, probe.ty)
  let ph = ixc_ref(coll)
  match coll_ty {
    TyCon(tcs, _) ->
      if core_ty_is(tcs, CtVec) { synth_vec_index(probe, coll_ty, ph, ix, line, col) }
      else { synth_on_coll(probe, coll_ty, ECall(index_getter(coll_ty, line, col), [ph, ix]), line, col) }
    # A fixed-width vec (`Vec[T]<n>`) reads inline: a static literal index
    # is a bare struct field load with the bound proved at compile time
    # (no runtime check). A dynamic index is declined in v1.
    TyDimT(inner, _) -> match inner {
      TyCon(tcs, _) ->
        if core_ty_is(tcs, CtVec) {
          if ty_is_fixed_vec(coll_ty) { synth_fixed_vec_index(probe.st, probe.expr, ix, coll_ty, line, col) }
          else {
            let bare = mk_expr(ECall(builtin_mk(CbDetachUnit, line, col), [ph]), line, col)
            synth_vec_index(probe, coll_ty, bare, ix, line, col)
          }
        } else { synth_on_coll(probe, coll_ty, ECall(builtin_mk(CbArrayGet, line, col), [ph, ix]), line, col) }
      _ -> synth_on_coll(probe, coll_ty, ECall(builtin_mk(CbArrayGet, line, col), [ph, ix]), line, col)
    }
    _ -> synth_on_coll(probe, coll_ty, ECall(builtin_mk(CbArrayGet, line, col), [ph, ix]), line, col)
  }
}


# Types the read `k`, whose collection is the placeholder, against the
# probe's type for it, then splices the probe's typed collection back.
fn synth_on_coll(probe: Inferred, t: Ty, k: ExprKind, line: Int,
      col: Int) : Inferred / Console + File + Mutable {
  let st1 = st_set_env(probe.st, env_bind_local(probe.st.env, binder_minted(ixc_name()), mono(t)))
  let r = synth(st1, mk_expr(k, line, col))
  mk_inferred(st_restore_entries(probe.st, r.st), r.ty, ixc_splice(r.expr, probe.expr))
}


# `xs[i]` on a Vec reads the element; `xs[a..b]` (inclusive, like the
# range literal) is the O(1) slice — the same view `[h, ...t]` binds.
fn synth_vec_index(probe: Inferred, t: Ty, coll: Expr, ix: Expr,
                   line: Int, col: Int) : Inferred / Console + File + Mutable =
  match ix.kind {
    ERange(a, b, None) -> synth_on_coll(probe, t, vec_slice_block(coll, a, b, line, col), line, col)
    ERange(_, _, Some(_)) -> {
      let perr = mk_diag(SevError, probe.st.file, line, col, "a stepped range cannot slice a Vec — a slice is one contiguous view", [])
      render_diag(perr)
      mk_inferred(st_bump_err(st_push_diag(probe.st, perr)), TyAny, with_ty(mk_expr(EIndex(probe.expr, ix), line, col), TyAny))
    }
    _ -> synth_on_coll(probe, t, ECall(builtin_mk(CbVecGet, line, col), [coll, ix]), line, col)
  }


# `v[k]` on a fixed-width `Vec[e]<n>`: a static literal index in range
# lowers to `__fixed_vec_get` — a bare struct field load, the bound
# proved here at compile time so no runtime check is emitted. Out of
# range is a compile error (strictly better than the dynamic vec's
# runtime trap). A dynamic index lowers to `__fixed_vec_get_dyn`, the
# same inline field load behind a bounds check against the static `n`.
fn synth_fixed_vec_index(st: InferState, coll: Expr, ix: Expr, coll_ty: Ty,
                         line: Int, col: Int) : Inferred / Console + File + Mutable {
  let n = fixed_vec_n(coll_ty)
  let elem = fixed_vec_elem(coll_ty)
  match ix.kind {
    EInt(k, _) ->
      if k >= 0 and k < n {
        fixed_vec_index_node(st, coll, ix, MkFixedVecGet, elem, line, col)
      } else {
        let perr = mk_diag(SevError, st.file, line, col,
          concat_all(["index ", int_to_string(k), " is out of range for a fixed-width `Vec` of length ", int_to_string(n)]), [])
        render_diag(perr)
        mk_inferred(st_bump_err(st_push_diag(st, perr)), elem, with_ty(mk_expr(EIndex(coll, ix), line, col), elem))
      }
    _ -> {
      let ir = check_expr_against(st, ix, TyInt, "index", ix.line, ix.col)
      fixed_vec_index_node(ir.st, coll, ir.expr, MkFixedVecGetDyn, elem, line, col)
    }
  }
}


fn synth_binop(st: InferState, op: BinOp, l: Expr, r: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let rl = synth(st, l)
  let rr = synth(rl.st, r)
  if binop_eq(op, BoConcat) {
    synth_concat(rr.st, rl.ty, rl.expr, rr.ty, rr.expr, line, col)
  } else if binop_is_logical(op) {
    let s1 = st_unify(rr.st, rl.ty, TyBool, "boolean operator", line, col)
    let s2 = st_unify(s1, rr.ty, TyBool, "boolean operator", line, col)
    mk_inferred(s2, TyBool, binop_root(op, rl.expr, rr.expr, line, col, TyBool))
  } else if binop_is_equality(op) {
    # `==` / `!=` are sugar for Eq.eq. The typer keeps the existing
    # structural builtin form (`binop_root`, lowered to `kai_op_eq_v`);
    # the structural-vs-custom-impl decision is made later, per spec,
    # by `resolve_protocol_calls` over concrete types (it rewrites the
    # EBinop to a `__pimpl_Eq_<T>_eq` call when the type — or a field
    # at any depth — carries a custom `impl Eq`). Deciding here is
    # premature: inside a generic body the operand type is still a
    # `TyVarT` and only monomorphisation makes it concrete.
    let s1 = st_unify(rr.st, rl.ty, rr.ty, "comparison", line, col)
    mk_inferred(s1, TyBool, binop_root(op, rl.expr, rr.expr, line, col, TyBool))
  } else if binop_is_ordering(op) {
    # `<` / `>` / `<=` / `>=` are sugar for Ord.cmp. Same as `==`: the
    # typer keeps the structural builtin form and the per-spec protocol
    # resolver rewrites to `__pimpl_Ord_<T>_cmp` (reduced to Bool against
    # 0) when the concrete type has a custom `impl Ord`.
    let s1 = st_unify(rr.st, rl.ty, rr.ty, "comparison", line, col)
    mk_inferred(s1, TyBool, binop_root(op, rl.expr, rr.expr, line, col, TyBool))
  } else if binop_eq(op, BoMod) {
    # modulo over a `Rem` protocol. Primitive `Int % Int`
    # keeps the unify-and-emit fast path; concrete non-primitive
    # operands desugar to a `Rem.rem` protocol-method call so user
    # types can supply `impl Rem for T`. Heterogeneous routing follows
    # the same shape as `*` / `/`. `Real % Real` also routes through
    # the protocol, which dispatches to `impl Rem for Real` and lowers
    # to the `fmod` libm binding.
    let lty_now = apply_ty(rr.st.sub, rl.ty)
    let rty_now = apply_ty(rr.st.sub, rr.ty)
    if binop_should_dispatch_proto(lty_now, rty_now) {
      synth_binop_proto(rr.st, op, rl.expr, lty_now, rr.expr, rty_now, line, col)
    } else if binop_dispatch_proto_heterogeneous(rr.st, op, lty_now, rty_now) {
      synth_binop_proto(rr.st, op, rl.expr, lty_now, rr.expr, rty_now, line, col)
    } else if ty_is_real_head(lty_now) and ty_is_real_head(rty_now) {
      synth_binop_proto(rr.st, op, rl.expr, lty_now, rr.expr, rty_now, line, col)
    } else if ty_is_var_head(lty_now) or ty_is_var_head(rty_now) {
      # A generic operand keeps its type: the protocol rewrite after
      # monomorphisation reaches `Rem` once the type is concrete.
      let s1 = st_unify(rr.st, rl.ty, rr.ty, "arithmetic operator '%'", line, col)
      let ty = apply_ty(s1.sub, rl.ty)
      mk_inferred(s1, ty, binop_root(op, rl.expr, rr.expr, line, col, ty))
    } else {
      # `T % T` over a same-width fixed integer keeps the primitive fast
      # path (`+`/`-`/`*`-style width wrap); everything else unifies with
      # `Int`.
      let modt = fixed_mod_result(lty_now, rty_now)
      let s1 = st_unify(rr.st, rl.ty, modt, "integer arithmetic", line, col)
      let s2 = st_unify(s1, rr.ty, modt, "integer arithmetic", line, col)
      mk_inferred(s2, modt, binop_root(op, rl.expr, rr.expr, line, col, modt))
    }
  } else if binop_eq(op, BoMul) or binop_eq(op, BoDiv) {
    # when neither operand is primitive numeric (Int/Real,
    # optionally dim-wrapped) but both have concrete head TyCon (e.g.
    # Complex), desugar to a Mul/Div protocol-method call so the
    # post-inference rewrite can dispatch to `__pimpl_<P>_<T>_<op>`.
    # Falls through to the dim-aware path otherwise (keeps primitive
    # arithmetic on the zero-overhead unify-and-emit fast path).
    let lty_now = apply_ty(rr.st.sub, rl.ty)
    let rty_now = apply_ty(rr.st.sub, rr.ty)
    if binop_should_dispatch_proto(lty_now, rty_now) {
      if binop_same_head_dimmed(lty_now, rty_now) {
        # dimensioned protocol operands (`Decimal<USD>`): the impl
        # erases units (its signature is the bare carrier), so combine
        # them here exactly as the primitive dim path does — the
        # Module guard rejects habitant products, and the result
        # carries the combined unit.
        synth_binop_proto_dim_mul(rr.st, op, rl.expr, lty_now, rr.expr, rty_now, line, col)
      } else {
        synth_binop_proto(rr.st, op, rl.expr, lty_now, rr.expr, rty_now, line, col)
      }
    } else if binop_dispatch_proto_heterogeneous(rr.st, op, lty_now, rty_now) {
      # heterogeneous prim<->nonprim or cross-nonprim
      # routing, gated on impl-existence in the snapshot.
      synth_binop_proto(rr.st, op, rl.expr, lty_now, rr.expr, rty_now, line, col)
    } else {
      # multiplication and division of dimensioned values
      # combine units rather than requiring equality. The operand-type
      # rule still requires the *base* numeric types to agree (Real*Real
      # / Int*Int) — we delegate that to synth_dim_mul_div.
      synth_dim_mul_div(rr.st, op, rl.ty, rl.expr, rr.ty, rr.expr, line, col)
    }
  } else if binop_eq(op, BoPow) {
    # Integer-exponent power. Mirrors `*`/`/`'s UoM behaviour with one
    # twist: the result unit is `u^n`, which only resolves when `n`
    # is a literal Int known at compile time. If the exponent is not
    # a literal AND the base has a non-trivial unit, the rule is
    # rejected (no dependent types). Bare numeric bases (`Int`,
    # `Real<1>`, …) accept any `Int` exponent.
    synth_dim_pow(rr.st, rl.ty, rl.expr, rr.ty, rr.expr, line, col)
  } else {
    # protocol-method dispatch fall-through for `+` / `-`
    # when both operands resolve to a non-primitive concrete type.
    # Primitive `Int + Int` / `Real + Real` arithmetic still goes
    # through the unify-and-emit path; only user types (Complex,
    # Vector, ...) take the protocol detour.
    let lty_now = apply_ty(rr.st.sub, rl.ty)
    let rty_now = apply_ty(rr.st.sub, rr.ty)
    if binop_should_dispatch_proto(lty_now, rty_now) {
      # dimensioned protocol operands keep the primitive rule: `+` and
      # `-` demand unit equality. The impl signature is the bare
      # carrier and would silently swallow a unit mismatch.
      let st_d = if binop_same_head_dimmed(lty_now, rty_now) {
        let what = string_concat("arithmetic operator '", string_concat(binop_text(op), "'"))
        st_unify(rr.st, rl.ty, rr.ty, what, line, col)
      } else { rr.st }
      synth_binop_proto(st_d, op, rl.expr, lty_now, rr.expr, rty_now, line, col)
    } else if binop_dispatch_proto_heterogeneous(rr.st, op, lty_now, rty_now) {
      # heterogeneous routing.
      synth_binop_proto(rr.st, op, rl.expr, lty_now, rr.expr, rty_now, line, col)
    } else {
      # `+` / `-` keep the unify-both-sides rule. The dim-aware unifier
      # checks the unit equality automatically.
      let what = string_concat("arithmetic operator '", string_concat(binop_text(op), "'"))
      let s1 = st_unify(rr.st, rl.ty, rr.ty, what, line, col)
      let s2 = st_check_arith_string(s1, op, rl.ty, line, col)
      let ty = apply_ty(s2.sub, rl.ty)
      mk_inferred(s2, ty, binop_root(op, rl.expr, rr.expr, line, col, ty))
    }
  }
}


# Build a call of the operator protocol's dispatcher on `[l, r]` and walk
# it through `synth_call`. The lower-protocols pass has already
# generated the dispatcher (when the matching protocol is declared); the
# post-inference rewrite then redirects to the impl.
fn synth_binop_proto(st: InferState, op: BinOp, le: Expr, lt: Ty,
                      re: Expr, rt: Ty,
                      line: Int, col: Int) : Inferred / Console + File + Mutable {


  match binop_check_against_impl(st, op, lt, rt, line, col) {
    BinopImpl(st_h, declared) ->
      binop_impl_result(synth_call(st_h, binop_dispatcher_ref(st_h.protos.ids, binop_proto(op), line, col), [le, re], line, col), declared)
  }
}


# `*` / `/` over dimensioned protocol operands: combine the units the
# way the primitive dim path does, run the Module formation guard on
# the combined unit, dispatch to the impl on the bare carriers, and
# stamp the combined unit back onto the impl's result. `USD·USD` dies
# in the guard; `Decimal<USD> · Decimal` keeps the habitant; a full
# cancellation (`USD/USD`) yields the bare carrier.
fn synth_binop_proto_dim_mul(st: InferState, op: BinOp,
                             le: Expr, lt: Ty, re: Expr, rt: Ty,
                             line: Int, col: Int) : Inferred / Console + File + Mutable {
  let ls = ty_split_dim(lt, st.sub)
  let rs = ty_split_dim(rt, st.sub)
  let combined = if binop_eq(op, BoMul) { UMul(ls.dim, rs.dim) }
                 else { UMul(ls.dim, UInv(rs.dim)) }
  let s1 = st_check_atomic_unit(st, op, combined, line, col)
  # The units are the combined-unit rule's business, already checked
  # above; the impl sees the bare carriers.
  let inf = synth_binop_proto(s1, op, le, ls.base, re, rs.base, line, col)
  let base = (ty_split_dim(inf.ty, inf.st.sub)).base
  let ty = dim_collapse(base, unit_canon(combined))
  mk_inferred(inf.st, ty, with_ty(inf.expr, ty))
}


fn synth_unop(st: InferState, op: UnOp, x: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let r = synth(st, x)
  match op {
    UoNot -> {
      let s1 = st_unify(r.st, r.ty, TyBool, "logical 'not'", line, col)
      let root = with_ty(mk_expr(EUnop(op, r.expr), line, col), TyBool)
      mk_inferred(s1, TyBool, root)
    }
    UoNeg ->
      if ty_negates(apply_ty(r.st.sub, r.ty)) {
        let root = with_ty(mk_expr(EUnop(op, r.expr), line, col), r.ty)
        mk_inferred(r.st, r.ty, root)
      } else { synth_call(r.st, op_dispatcher_ref(r.st.protos.ids, CpNeg, neg_proto_method(), line, col), [r.expr], line, col) }
  }
}


fn synth_if(st: InferState, c: Expr, t_: Expr, eo: Option[Expr], line: Int, col: Int) : Inferred / Console + File + Mutable {


  let rc = synth(st, c)
  let s1 = st_unify(rc.st, rc.ty, TyBool, "if condition", line, col)
  let rt = synth(s1, t_)
  match eo {
    None -> {
      let root = with_ty(mk_expr(EIf(rc.expr, rt.expr, None), line, col), TyUnit)
      mk_inferred(rt.st, TyUnit, root)
    }
    Some(ee) -> {
      let re = synth(rt.st, ee)
      let s2 = st_unify(re.st, rt.ty, re.ty, "if/else branches", line, col)
      let ty = apply_ty(s2.sub, rt.ty)
      let root = with_ty(mk_expr(EIf(rc.expr, rt.expr, Some(re.expr)), line, col), ty)
      mk_inferred(s2, ty, root)
    }
  }
}


fn synth_lambda(st: InferState, ps: [Param], body: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable =
  synth_lambda_pinned(st, ps, body, [], "", line, col)


# A lambda where a function over `doms` is expected: each parameter takes
# the domain at its position BEFORE the body is walked. A method call in
# the body is chosen by its receiver's type there and then; it cannot
# defer the way a bare field access can, so a parameter it reaches must
# already be typed.
fn synth_lambda_expecting(st: InferState, ps: [Param], body: Expr, doms: [Ty],
                          line: Int, col: Int) : Inferred / Console + File + Mutable =
  synth_lambda_pinned(st, ps, body, expected_pins(st, ps, doms), "lambda parameter", line, col)


# A lambda whose leading parameters take `pins` before its body is walked.
fn synth_lambda_pinned(st: InferState, ps: [Param], body: Expr, pins: [Ty], why: String,
                       line: Int, col: Int) : Inferred / Console + File + Mutable =
  synth_lambda_rows(st, ps, body, pins, why, false, line, col)


# `every_tail` ties the lambda's row to every open row its body calls
# through, not only the enclosing signature's: closing the lambda's row
# then closes them all.
fn synth_lambda_rows(st: InferState, ps: [Param], body: Expr, pins: [Ty], why: String, every_tail: Bool,
                     line: Int, col: Int) : Inferred / Console + File + Mutable {


  let outer = st
  let added0 = add_infer_params(st, ps)
  let added = InferredParams { st: pin_params(added0.st, added0.tys, pins, why, line, col), tys: added0.tys }
  # walk the body in an isolated row context. Effects
  # invoked inside the lambda body MUST NOT leak to the enclosing
  # function's row — they belong to the lambda type's own row.
  # Same pattern as `synth_handle` (snapshot, reset, walk, restore).
  # closure-capture: tagging stays enabled across the
  # lambda boundary now that `kai_alias_<a>_id` is captured by the
  # closure (see `fv_expr`'s tagged-op detection plus the
  # `__alias_id__<a>` lane in `emit_closure_caps` /
  # `emit_lam_cap_reads`). Without this the typer would emit a
  # bare dispatch key for every op call inside the lambda and the
  # innermost-name lookup would shadow outer cap binders — the
  # exact failure mode that broke `var n = ...; var m = ...; while
  # @n < lim { ... }` and routed `@n` to `m`.
  let prev_row = added.st.row
  let prev_tails = added.st.row_tails
  let st_in = InferState { ...added.st, row: [], row_tails: [], decl_row: [] }
  # `e!` propagates from the enclosing function, not from a
  # closure. Clear ret_ty inside the lambda body so any `!` site
  # inside reports a clean diagnostic. st_restore_entries (below)
  # restores ret_ty from `outer` after the walk, so subsequent
  # siblings of the lambda see the function-level ret_ty unchanged.
  let st_in2 = st_set_ret_ty(st_in, None)
  # A lambda lifted out of a clause body cannot call the clause's
  # continuation, unless a lambda param shadows its name.
  let st_in3 = st_set_in_clause(st_set_clause_resume(st_in2, None), clause_cont_in_lambda(st_in2.in_clause, ps))
  let rb = synth(st_in3, body)
  # keep the row labels in their raw form so a downstream
  # `unify_row` partition can see TyVar payloads (an `Actor[?T]` mint-
  # ed by `Actor.self()` inside this body should bias the enclosing
  # handler's `Msg` toward that `?T`). The previous `apply_labels`
  # call substituted bound TyVars away and forced the partition into
  # a row-position lottery; `find_remove_label_best`'s
  # `find_remove_label_tyvar_args` branch needs the raw shape to
  # prefer body-local labels over callee-propagated concrete labels.
  #
  # apply the Mutable-masking pass to the lambda
  # body too. `infer_decl` masks `Mutable` for a top-level fn whose
  # body only mutates locally-constructed Arrays (the `var i = 0`
  # desugar lowers to a `let i__slot = array_make(1, 0)` slot the
  # caller never observes), but a lambda body went through `synth`
  # alone and never reached that pass — so a `var` inside a thunk
  # leaked `Mutable` into the lambda's row. The thunk
  # `() => { var i = 0  i := @i + 1 }` would surface as
  # `() -> Unit / Mutable + ?e`, which then refused to unify against a
  # higher-order slot declared `() -> Unit / Stdout`. Masking here is
  # scoped to the lambda's own params + body and is a no-op when
  # `Mutable` is not in the body row, mirroring the fn-decl call site.
  let rb_masked = mask_local_mutable_demand(st_add_tail_labels(rb.st, rb.st.row_tails), ps, rb.expr)
  let lambda_row_labels = rb_masked.row
  let st_after = InferState { ...rb_masked, row: prev_row, row_tails: prev_tails, decl_row: added.st.decl_row }
  let st2 = st_restore_entries(outer, st_after)
  # lambdas carry an *open* row with a
  # fresh tail var. Closed rows pinned row-polymorphic call sites
  # too eagerly: `while(pred, body)` would unify the pure-pred's
  # closed-empty row with `while`'s `e`, then reject `body`'s
  # `Stdout` row when the same `e` was already bound to empty.
  # The open form `[labels] + ?eN` lets sibling args' rows unify
  # via Rémy-style tail unification — the row variable absorbs
  # whatever residual labels each arg performs.
  let fr = subst_fresh_row(st2.sub)
  let st3 = join_tails(st_set_sub(st2, fr.subst), fr.id, rb_masked.row_tails, every_tail, line, col)
  let lam_row = Row { labels: lambda_row_labels,
                       tail: Some(fr.id),
                       display_alias: None }
  # Left unapplied: finalise applies the substitution once. Applying it here
  # rebuilt the body's type at every level of a lambda nest.
  let lam_ty = TyFnT(added.tys, rb.ty, lam_row)
  let root = with_ty(mk_expr(ELambda(ps, rb.expr), line, col), lam_ty)
  mk_inferred(st3, lam_ty, root)
}


fn synth_list_expr(st: InferState, els: [ListElem], line: Int, col: Int) : Inferred / Console + File + Mutable {


  let rv = st_fresh_ty(st)
  let elems = synth_list_elems(rv.st, els, rv.ty, line, col)
  let ty = TyListT(apply_ty(elems.st.sub, rv.ty))
  let root = with_ty(mk_expr(EList(elems.elems), line, col), ty)
  mk_inferred(elems.st, ty, root)
}


fn synth_list_elems(st: InferState, els: [ListElem], elem: Ty, line: Int, col: Int) : InferredElems / Console + File + Mutable {


  match els {
    [] -> InferredElems { st: st, elems: [] }
    [el, ...rest] -> match el {
      ElPlain(ex) -> {
        let r = synth(st, ex)
        let s1 = st_unify(r.st, elem, r.ty, "list element", line, col)
        let rr = synth_list_elems(s1, rest, elem, line, col)
        InferredElems { st: rr.st, elems: [ElPlain(r.expr), ...rr.elems] }
      }
      ElSpread(ex) -> {
        let r = synth(st, ex)
        let s1 = st_unify(r.st, TyListT(elem), r.ty, "list spread", line, col)
        let rr = synth_list_elems(s1, rest, elem, line, col)
        InferredElems { st: rr.st, elems: [ElSpread(r.expr), ...rr.elems] }
      }
    }
  }
}


fn synth_range(st: InferState, lo: Expr, hi: Expr, stp: Option[Expr], line: Int, col: Int) : Inferred / Console + File + Mutable {
  let rl = synth(st, lo)
  if range_of_chars(apply_ty(rl.st.sub, rl.ty), hi) { synth_char_range(st, rl, lo, hi, stp, line, col) }
  else {
    let s1 = st_unify(rl.st, TyInt, rl.ty, "range start", line, col)
    let rh = synth(s1, hi)
    let s2 = st_unify(rh.st, TyInt, rh.ty, "range end", line, col)
    match stp {
      None -> {
        let root = with_ty(mk_expr(ERange(rl.expr, rh.expr, None), line, col), TyListT(TyInt))
        mk_inferred(s2, TyListT(TyInt), root)
      }
      Some(se) -> {
        let rs_ = synth(s2, se)
        let s3 = st_unify(rs_.st, TyInt, rs_.ty, "range step", line, col)
        let root = with_ty(mk_expr(ERange(rl.expr, rh.expr, Some(rs_.expr)), line, col), TyListT(TyInt))
        mk_inferred(s3, TyListT(TyInt), root)
      }
    }
  }
}


# A range of Chars is the range of their code points, each mapped back:
# `map([code(lo)..code(hi)], int_to_char)`. The three elements are held to
# Char first, so a mix is reported against the range and not against the
# rewrite; `peek` is the start, already read once to choose this path.
fn synth_char_range(st: InferState, peek: Inferred, lo: Expr, hi: Expr, stp: Option[Expr],
                    line: Int, col: Int) : Inferred / Console + File + Mutable {
  let s1 = st_unify(peek.st, TyChar, peek.ty, "range start", line, col)
  let rh = synth(s1, hi)
  let s2 = st_unify(rh.st, TyChar, rh.ty, "range end", line, col)
  let s3 = char_range_second(s2, stp, line, col)
  if s3.errs > st.errs { inferred_leaf(s3, TyListT(TyChar), mk_expr(EList([]), line, col)) }
  else {
    let codes = mk_expr(ERange(char_code(lo), char_code(hi), inf_map_opt_expr(stp, char_step)), line, col)
    let back = mk_sym(builtin_sym("int_to_char"), line, col)
    synth(st_restore_deferred_fields(s3, st.deferred_fields, st.deferred_homs),
          mk_expr(ECall(mk_sym(builtin_sym("map"), line, col), [codes, back]), line, col))
  }
}


# The step a stepped range lowers to is `second - first`: between two
# Chars, the distance of their code points.
fn char_range_second(st: InferState, stp: Option[Expr], line: Int, col: Int) : InferState / Console + File + Mutable =
  match stp {
    Some(step) -> match step.kind {
      EBinop(BoSub, second, _) -> {
        let r = synth(st, second)
        st_unify(r.st, TyChar, r.ty, "the second element of a Char range", line, col)
      }
      _ -> st
    }
    None -> st
  }


fn synth_pipe(st: InferState, lhs: Expr, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let att = try_fuse_terminal_fold(st, lhs, rhs, line, col)
  match att.fused {
    Some(inf) -> inf
    None      -> synth_pipe_plain(att.st, lhs, rhs, line, col)
  }
}


# The callee of a pipe stage. A name the resolver left for the typer,
# one several modules declare (`filter` of both `option` and `list`), is
# narrowed by the piped value's type: under the pipe rewrite that value
# is the callee's first argument. A settled callee, and one with a single
# candidate, is read as any callee is.
fn synth_pipe_callee(st: InferState, f: Expr, lhs_ty: Ty) : Inferred / Console + File + Mutable = match f.kind {
  EName(nm) -> {
    let candidates = bare_fn_candidates(st, nm)
    if list_length(candidates) < 2 { synth_callee(st, f) }
    else { match pick_by_first_arg(st, candidates, apply_ty(st.sub, lhs_ty), f.line, f.col) {
      FaNone -> synth_callee(st, f)
      FaTie(st_t, ss) -> inferred_leaf(report_name_tie(st_t, nm, ss, true, f.line, f.col), TyAny, f)
      FaOne(pick) -> mk_inferred(pick_inst(pick, f.line, f.col), pick.inst_ty, with_ty(pick_ref(pick, f.line, f.col), pick.inst_ty))
    } }
  }
  _ -> synth(st, f)
}


fn synth_pipe_plain(st: InferState, lhs: Expr, rhs: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let rl = synth(st, lhs)
  let res = match rhs.kind {
    ECall(f, pa) -> {
      let rf = synth_pipe_callee(rl.st, f, rl.ty)
      let ra = synth_many_expecting(rf.st, pa, params_after_first(fn_param_tys(rf.st, rf.ty)))
      let rv = st_fresh_ty(ra.st)
      # same open-row trick `synth_call`
      # uses — let the callee's row tail bind to a fresh row var so
      # `xs |> each(handler)` against a row-polymorphic combinator
      # passes type checking when `handler` carries effect labels.
      let fr = subst_fresh_row(rv.st.sub)
      let st_fresh = st_set_sub(rv.st, fr.subst)
      let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
      let expected = TyFnT([rl.ty, ...ra.tys], rv.ty, expected_row)
      let st_unif = st_unify(st_fresh, rf.ty, expected, "pipe call", line, col)
      let st2 = st_propagate_capability_labels(st_unif, apply_ty(st_unif.sub, rf.ty), line, col)
      match refine_call(st2, rf.expr, rf.ty, [rl.expr, ...ra.exprs], [rl.ty, ...ra.tys], apply_ty(st2.sub, rv.ty)) {
        RefCall(st3, ty) -> PipeRes { st: st3, ty: ty, call: mk_expr(ECall(rf.expr, [rl.expr, ...ra.exprs]), line, col) }
      }
    }
    _ -> {
      let rf = synth_pipe_callee(rl.st, rhs, rl.ty)
      let rv = st_fresh_ty(rf.st)
      let fr = subst_fresh_row(rv.st.sub)
      let st_fresh = st_set_sub(rv.st, fr.subst)
      let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
      let expected = TyFnT([rl.ty], rv.ty, expected_row)
      let st_unif = st_unify(st_fresh, rf.ty, expected, "pipe call", line, col)
      let st2 = st_propagate_capability_labels(st_unif, apply_ty(st_unif.sub, rf.ty), line, col)
      match refine_call(st2, rf.expr, rf.ty, [rl.expr], [rl.ty], apply_ty(st2.sub, rv.ty)) {
        RefCall(st3, ty) -> PipeRes { st: st3, ty: ty, call: mk_expr(ECall(rf.expr, [rl.expr]), line, col) }
      }
    }
  }
  mk_inferred(res.st, res.ty, with_ty(res.call, res.ty))
}

# head-owner cache.
#
# `synth_pipe_dispatch` rewrites `xs | f`, `xs || f`, and `xs |? p`
# into a qualified call against the module that owns the LHS's head
# type — `List → list.map`, `MyBox → mypkg.mybox.map`, etc.
#
# Earlier this was a hardcoded `if head == "List" { Some("list") }`
# table that knew exactly one entry. That made any downstream package
# wishing to participate in `|` (ahu.stream.Source[T], henua.EventBus,
# manutara stream/sink types, …) require a recompile of `kaic2`.
# Unacceptable for a downstream-package ecosystem.
#
# Why convention beats annotation/protocol here:
#   * Operator protocols (`+`-style) require the op's signature to fit
#     `(Self, X) -> Y` shapes a protocol can express. `map`'s shape is
#     `F[A] -> (A -> B) -> F[B]` — higher-kinded. CLAUDE.md bans HKT in
#     the typer; protocols cannot express it.
#   * Effect rows in operator-protocol ops are also banned, but `map`
#     against an effectful function carries the function's effect row
#     into its own signature — protocols would have to admit row-poly
#     ops, which they don't.
#   * Annotations (`#pipe_dispatch`) cost a parser change and a new
#     visible concept for ~5 stdlib + future package decls. Convention
#     is free at the surface, costs ~70 LOC inside the compiler, and
#     mirrors how qualified-name resolution already works for
#     `EModCall`-driven calls.
#
# The cache shape: `[HOE(head type, [module_path])]`. A single-element
# `module_path` list is the dispatchable case; a multi-element list is
# ambiguous and the typer reports the modules at the use site so the
# user can pick `mod.T` annotation or rename one of the conflicting
# `pub type T` declarations.
#
# Canonical signatures package authors must follow for their `pub type T`
# to participate in `|` / `||` / `|?` (the LHS receiver is always the
# first argument; the function/predicate is second; the return wraps
# the same head type):
#
#   pub fn map[A, B, e](xs: T[A], f: (A) -> B / e) : T[B] / e
#   pub fn flat_map[A, B, e](xs: T[A], f: (A) -> T[B] / e) : T[B] / e
#   pub fn filter[A, e](xs: T[A], p: (A) -> Bool / e) : T[A] / e
#
# A head carrying an `(element, row)` parameter list — `Stream[t, e]`,
# the streaming carrier whose effect row is a type parameter — also
# rides the pipes: dispatch is by the head type (arity-agnostic), and the
# whole LHS type unifies against the canonical receiver, so the row
# slot threads via the row carrier (`row_arg_carrier`). The element
# unifies against the first slot; the row threads as `e`.
#
# A package that ships `map` with a swapped argument order or a missing
# row var still surfaces the standard call-inference signature mismatch
# — the typer does not need a separate diagnostic for "your map shape
# is wrong". (An extra *type* parameter that is NOT the trailing
# effect-row slot still mismatches; only the legitimate `(element, row)`
# shape is accepted.)
#
# Construction: linear over `(decls, modules)`, called once per
# `compile_source` invocation right before `infer_program`
# runs the typer over the same decl stream. Lookup at each pipe call
# site is `find_head_owner` walking the cache; it is a small linear
# list (one entry per `pub type` across all modules in scope) and the
# constant-factor cost dominates over a hash map until the program
# crosses ~hundreds of pub types — hello-world programs sit at <50.


fn synth_pipe_dispatch(st: InferState, pop: PipeOp, lhs: Expr, rhs: Expr,
                        line: Int, col: Int) : Inferred / Console + File + Mutable {
  let cf = pipe_op_core_fn(pop)
  let op = core_fn_name(cf)


  let rl = synth(st, lhs)
  let lhs_ty = apply_ty(rl.st.sub, rl.ty)
  let hsym = ty_head_sym(lhs_ty)
  match inf_ty_head_name(rl.st.env.tab, lhs_ty) {
    None -> {
      let perr = mk_diag(SevError, rl.st.file, line, col,
        concat_all([op, "-pipe requires a concrete head type on the ",
          "left-hand side; got an unresolved type variable. Annotate ",
          "the LHS or restructure the pipeline."]), [])
      render_diag(perr)
      let root = with_ty(mk_expr(EDispatchPipe(pop, rl.expr, rhs), line, col), TyAny)
      mk_inferred(st_bump_err(st_push_diag(rl.st, perr)), TyAny, root)
    }
    Some(head) -> match pipe_rejection_reason(hsym, pop) {
      Some(msg) -> {
        let perr = mk_diag(SevError, rl.st.file, line, col, msg, [])
        render_diag(perr)
        let root = with_ty(mk_expr(EDispatchPipe(pop, rl.expr, rhs), line, col), TyAny)
        mk_inferred(st_bump_err(st_push_diag(rl.st, perr)), TyAny, root)
      }
      None -> match find_head_owner(rl.st.env, hsym) {
        HLNone -> {
          let perr = mk_diag(SevError, rl.st.file, line, col,
            concat_all(["no module declaring type `", head, "` is in scope"]), [])
          render_diag(perr)
          let root = with_ty(mk_expr(EDispatchPipe(pop, rl.expr, rhs), line, col), TyAny)
          mk_inferred(st_bump_err(st_push_diag(rl.st, perr)), TyAny, root)
        }
        HLAmbiguous(mods) -> {
          let perr = mk_diag(SevError, rl.st.file, line, col,
            concat_all(["ambiguous head type `", head, "` — ",
              join_modules_for_diag(map(mods, (m) => "#{sym_name(rl.st.env.tab, m)}")),
              " all declare it. Use qualified type annotation."]), [])
          render_diag(perr)
          let root = with_ty(mk_expr(EDispatchPipe(pop, rl.expr, rhs), line, col), TyAny)
          mk_inferred(st_bump_err(st_push_diag(rl.st, perr)), TyAny, root)
        }
        HLOk(owner) -> {
          # call the module's own `op` when it declares one — that is
          # the dispatch-eligible case (the diagnostic surface
          # `pipe_no_map` checks). When it declares none the call
          # reaches the runtime's primitive of that op: this is the
          # seeded head, `List → list`, under a harness that does not
          # load `core/list.kai` as a core. For a user-defined head
          # whose declaring module ships no canonical op, the
          # primitive then triggers the standard call-inference
          # signature mismatch, after the diagnostic below.
          let qualified = env_module_fn(rl.st.env, owner, op)
          # A `Shape`-protocol impl (`impl Sequence for Chain { map, ... }`)
          # provides the pipe op even when the head's module ships no
          # `map` function: call its dispatcher, which `resolve_protocol_calls`
          # retargets to `__pimpl_<P>_<head>_<op>` post-typing.
          let proto_disp = pipe_op_dispatcher(rl.st.protos, lhs_ty, op)
          let head_proto_op = is_some(proto_disp)
          let callee_kind = match qualified {
            Some(s) -> ESym(s, spec_none())
            None    -> match proto_disp {
              Some(k) -> k
              None    -> ESym(builtin_sym(op), spec_none())
            }
          }
          # emit the "module declares T but does not
          # export op" diagnostic only when the head was contributed
          # by the from_decls walk — i.e. a real user `pub type` —
          # AND the module ships no qualified op. The seeded
          # `List → list` case stays silent and routes through the
          # primitive so existing test-sugars fixtures (no
          # `--core core/list.kai`) continue to compile.
          let st_after_diag = match qualified {
            Some(_) -> rl.st
            None ->
              if core_ty_is(hsym, CtList) or head_proto_op { rl.st }
              else {
                let perr = mk_diag(SevError, rl.st.file, line, col,
                  "module `#{sym_name(rl.st.env.tab, owner)}` declares `#{head}` but does not export `#{op}`", [])
                render_diag(perr)
                st_bump_err(st_push_diag(rl.st, perr))
              }
          }
          let rc = synth(st_after_diag, with_ty(mk_expr(callee_kind, line, col), TyAny))
          let pe = pipe_elem_from_callee(rc.st.env, rc.st.sub, rc.ty, lhs_ty)
          let st_pe = match pe {
            Some(PE(_, s)) -> st_set_sub(rc.st, s)
            None           -> rc.st
          }
          let elem = pipe_elem_ty(pe)
          let rf = each_stage_checked(pop, synth_pipe_rhs(st_pe, rhs, elem), line, col)
          let rv = st_fresh_ty(rf.st)
          let ret = match pop {
            PoEach -> TyUnit
            _      -> rv.ty
          }
          let fr = subst_fresh_row(rv.st.sub)
          let st_fresh = st_set_sub(rv.st, fr.subst)
          let expected_row = Row { labels: [], tail: Some(fr.id), display_alias: None }
          let expected = TyFnT([rl.ty, rf.ty], ret, expected_row)
          # Use the same unify-message label as `synth_call` so existing
          # diagnostics-pinning fixtures (e.g.
          # `examples/sugars/map_pipe_type_mismatch.err.expected`)
          # match identically — the surface-level lane should not
          # change unrelated diagnostic strings.
          let pipe_callee = mk_expr(callee_kind, line, col)
          let st2 = match pipe_stage_wants_container(st_fresh.env, st_fresh.sub, rl.ty, rf.ty, elem) {
            Some(param) -> {
              emit_pipe_wants_apply(st_fresh, pop, rhs, param, elem, line, col)
              st_bump_err(st_fresh)
            }
            None ->
              st_unify_named(st_fresh, pipe_callee_shown(st_fresh, owner, op, qualified, pipe_callee),
                             rc.ty, [rl.ty, rf.ty], expected, line, col)
          }
          match refine_call(st2, pipe_callee, rc.ty, [rl.expr, rf.expr], [rl.ty, rf.ty], apply_ty(st2.sub, ret)) {
            RefCall(st3, ty) -> {
              let fused = try_fuse_map_pipe(st3, cf, rc.expr, rl.expr, rf.expr, ty, line, col)
              mk_inferred(fused.st, ty, fused.root)
            }
          }
        }
      }
    }
  }
}


fn try_fuse_terminal_fold(st: InferState, lhs: Expr, rhs0: Expr,
                          line: Int, col: Int) : FuseAttempt / Console + File + Mutable = {
  let rhs = if pipe_fusion_head(lhs) { terminal_settled(st, rhs0) } else { rhs0 }
  match pipe_fusion_as_terminal_fold(st.protos.ids, lhs, rhs) {
    None -> FuseAttempt { st: st, fused: None }
    Some(ff) -> {
      let g = fuse_terminal_gate(st, ff)
      if g.ok {
        # Peek the source head; the peek synth advances the fresh-tvar
        # counter and binds in the shared `sub`, so the rewrite synth must
        # continue from the RETURNED state (`peek.0`), not `g.st` — reusing
        # the old counter re-mints the peek's already-bound ids (#1186).
        let peek = fuse_source_is_protocol_seq(g.st, ff)
        let st_after = match peek { FSP(s, _, _) -> s }
        let is_seq = match peek { FSP(_, b, _) -> b }
        let of_chars = match peek { FSP(_, _, c) -> c }
        let proto_foldl = pipe_fusion_proto_foldl(st.protos.ids, rhs)
        if of_chars or fuse_owner_mismatch(ff, proto_foldl, is_seq) { FuseAttempt { st: st_after, fused: None } }
        else {
          let rewrite = if is_seq {
            pipe_fusion_generic_fold_rewrite(ff, proto_foldl, line, col)
          } else {
            pipe_fusion_fold_rewrite(ff, line, col)
          }
          FuseAttempt { st: st_after, fused: Some(synth(st_after, rewrite)) }
        }
      } else { FuseAttempt { st: g.st, fused: None } }
    }
  }
}


fn fuse_source_is_protocol_seq(st: InferState, ff: FusedFold) : FuseSeqPeek / Console + File + Mutable =
  fuse_source_peek(st, ff.source)


fn fuse_source_peek(st: InferState, source: Expr) : FuseSeqPeek / Console + File + Mutable {
  let r = synth(st, source)
  let src_ty = apply_ty(r.st.sub, r.ty)
  let head_ok = not core_ty_is(ty_head_sym(src_ty), CtList) and pipe_op_has_impl(st.protos.impls, src_ty, "foldl")
  let of_chars = pipe_fusion_head(source) and ty_is_char_list(src_ty)
  FSP(st_restore_deferred_fields(r.st, st.deferred_fields, st.deferred_homs), head_ok, of_chars)
}


# An explicit `foldl` keeps the Mutable-masked purity gate — its stage
# and combine still run, only reordered. An implicit terminal (`sum`,
# `product`, `length`) rewrites to a target with a row-less stage
# parameter — and `length` drops the stages — so it demands strictly
# empty labels.
fn fuse_terminal_gate(st: InferState, ff: FusedFold) : FuseGate / Console + File + Mutable =
  match ff.term {
    TermFoldl(_, combine) -> {
      let g = fuse_all_raw(st, ff.stages, false)
      if g.ok { fuse_raw(g.st, combine, false) } else { g }
    }
    _ -> fuse_all_raw(st, ff.stages, true)
  }


fn fuse_all_raw(st: InferState, closures: [Expr], strict: Bool) : FuseGate / Console + File + Mutable =
  match closures {
    [] -> FuseGate { st: st, ok: true }
    [c, ...rest] -> {
      let g = fuse_raw(st, c, strict)
      if g.ok { fuse_all_raw(g.st, rest, strict) } else { g }
    }
  }


# Synthesise a raw stage/combine closure solely to read its effect row.
# The typed node is discarded — only the verdict and the threaded state
# are kept. The probe's `deferred_fields` are rolled back: a stage body
# `(r) => r.field` with an unannotated `r` synthesised in isolation defers
# the field against a receiver tyvar that this probe never pins (only the
# re-synthesised rewrite call binds the real stage param to the element
# type). Left in the worklist, that orphan receiver drains to a spurious
# "annotation needed". The fresh-tvar counter and substitution still ride
# forward — rewinding those would re-mint ids the probe already bound.
fn fuse_raw(st: InferState, closure: Expr, strict: Bool) : FuseGate / Console + File + Mutable {
  let r = synth(st, closure)
  let ok = if strict { fuse_row_strict(r.st.sub, r.expr) }
           else { fuse_stage_pure(r.st.sub, r.expr) }
  FuseGate { st: st_restore_deferred_fields(r.st, st.deferred_fields, st.deferred_homs), ok: ok }
}


fn synth_record_lit(st: InferState, rh: DeclRef, fis: [FieldInit], expected: Ty, line: Int, col: Int) : Inferred / Console + File + Mutable {


  # The typed literal carries the id of the record its head settles to,
  # and its fields lie in the order that record declares: a field's slot
  # is the declaration's, however the literal wrote it.
  let head = record_head_sym(st, rh, expected, line, col)
  match head_record(st.recs, head.sym) {
    None -> {
      let named = match head.sym {
        Some(s) -> TyCon(s, [])
        None    -> tsh_tycon_at(st_home_view(st), rh, [])
      }
      let r = synth_field_inits(head.st, fis, [], line, col)
      let root = with_ty(mk_expr(ERecordLit(rh, r.fis), line, col), named)
      mk_inferred(r.st, named, root)
    }
    Some(ri) -> match ri {
      RI(rsym, _, fds, _) -> {
        let inst = rec_instantiate(head.st, ri)
        let r = synth_field_inits(inst.st, fis, inst.fields, line, col)
        let st1 = check_record_lit_fields(r.st, rsym, fis, inst.fields, line, col)
        let ty = apply_ty(st1.sub, inst.result_ty)
        if rh_out_of_order(fis, fds) { lay_in_declared_order(head.st, st1, rsym, fds, r.fis, ty, line, col) }
        else { mk_inferred(st1, ty, with_ty(mk_expr(ERecordLit(DrSym(rsym), r.fis), line, col), ty)) }
      }
    }
  }
}


# A literal written in another order than its record declares, as a
# block: each typed value bound in the order written, the record laid
# from those bindings in the declared order. Evaluation keeps the source
# order; `outer` is the state the bindings are scoped out to.
fn lay_in_declared_order(outer: InferState, st: InferState, rsym: SymId, fds: [FieldDecl], vals: [FieldInit],
                         ty: Ty, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let bound = bind_written_fields(st, vals, line, col, 0)
  let laid = read_declared_fields(bound.st, fds, vals, line, col)
  let lit = with_ty(mk_expr(ERecordLit(DrSym(rsym), laid.fis), line, col), ty)
  mk_inferred(st_restore_entries(outer, laid.st), ty, with_ty(mk_expr(EBlock(bound.stmts, Some(lit)), line, col), ty))
}


fn bind_written_fields(st: InferState, vals: [FieldInit], line: Int, col: Int, i: Int) : InferredStmts / Console + File + Mutable = match vals {
  [] -> InferredStmts { st: st, stmts: [] }
  [FI(_, v), ...rest] -> {
    let pat = mk_pat(PBind(rh_temp_binder(line, col, i)), line, col)
    let after = check_pattern_stamped(st, pat, let_binder_ty(typed_ty_or(v, TyAny), v))
    let rr = bind_written_fields(after.st, rest, line, col, i + 1)
    InferredStmts { st: rr.st, stmts: [SLet(after.pat, None, v), ...rr.stmts] }
  }
}


fn read_declared_fields(st: InferState, fds: [FieldDecl], vals: [FieldInit], line: Int, col: Int) : InferredFInits / Console + File + Mutable = match fds {
  [] -> InferredFInits { st: st, fis: [] }
  [FD(_, dnm, _, _), ...rest] -> {
    let r = synth(st, mk_local(rh_temp_binder(line, col, rh_written_at(vals, dnm)).id, line, col))
    let rr = read_declared_fields(r.st, rest, vals, line, col)
    InferredFInits { st: rr.st, fis: [FI(dnm, r.expr), ...rr.fis] }
  }
}


# A value meeting a refined type: a refuting literal is an error, and
# an unproven value is bound once and checked before it flows on.
#[doc("Typer-internal helper `refine_coerce` shared across the infer modules.")]
pub fn refine_coerce(m: MintedExpr, expected: Ty, what: String, line: Int, col: Int) : MintedExpr / Console + File + Mutable =
  if not (rc_mentions(expected) or rc_mentions_in(m.st.sub, m.pair.ty)) { m } else {
    let want = apply_ty(m.st.sub, expected)
    let m1 = refine_flow(m, want, what, line, col)
    if rc_may_owe(want) { refine_coerce_applied(m1, want, what, line, col) } else { m1 }
  }


fn refine_coerce_applied(m: MintedExpr, want: Ty, what: String, line: Int, col: Int) : MintedExpr / Console + File + Mutable {
  match want {
    TyFnT(_, ret, _) -> match m.pair.expr.kind {
      ELambda(ps, body) -> {
        let b = refine_coerce_tail(mk_inferred(m.st, typed_ty_or(body, ret), body), ret, what)
        MintedExpr { st: b.st, pair: ExprTy { expr: Expr { ...m.pair.expr, kind: ELambda(ps, b.expr) }, ty: m.pair.ty } }
      }
      _ -> m
    }
    _ -> refine_coerce_value(m, want, what, line, col)
  }
}


fn refine_coerce_value(m: MintedExpr, want: Ty, what: String, line: Int, col: Int) : MintedExpr / Console + File + Mutable {
  match rc_verdict(want, m.pair.expr, apply_ty(m.st.sub, m.pair.ty)) {
    RcProven -> m
    RcRefuted(why) -> {
      # The refuted value and the refinement it carries read the locals in scope.
      let names = ln_with_binder(st_local_names(m.st), pred_self_binder())
      let show = (e) => fmt_expr_text(e, m.st.env.tab, names)
      let perr = mk_diag(SevError, m.st.file, line, col, concat_all([what, ": ", loose_text(why, show, show)]), [])
      render_diag(perr)
      MintedExpr { st: st_bump_err(st_push_diag(m.st, perr)), pair: m.pair }
    }
    RcCheck(preds) -> {
      let r = refine_checked(m.st, m.pair.expr, m.pair.ty, preds, rc_is_dim(want))
      MintedExpr { st: r.st, pair: ExprTy { expr: r.expr, ty: r.ty } }
    }
  }
}


# A constructor has no body to check its fields on entry, so its call
# coerces each argument to the declared payload type.
fn coerce_ctor_args(st: InferState, callee: Expr, args_: [Expr], arg_tys: [Ty], callee_ty: Ty) : InferredList / Console + File + Mutable =
  if not list_any_may_owe(fn_param_tys(st, callee_ty)) { InferredList { st: st, tys: arg_tys, exprs: args_ } }
  else { match callee_ctor_name(st.env.tab, callee) {
    Some(cn) -> coerce_args_to(st, args_, arg_tys, fn_param_tys(st, callee_ty), "argument of `#{cn}`")
    None     -> InferredList { st: st, tys: arg_tys, exprs: args_ }
  } }


# A lambda passed where its parameter's type has a refined return
# checks that return in its own body.
fn coerce_lambda_args(r: InferredList, callee_ty: Ty) : InferredList / Console + File + Mutable =
  if not list_any_lambda(r.exprs) { r } else {
    let params = fn_param_tys(r.st, callee_ty)
    if not list_any_may_owe(params) { r }
    else { coerce_args_to(r.st, r.exprs, r.tys, map(params, (p) => fn_ret_only(p)), "lambda result") }
  }


# Under an expected type, a generic constructor's payload takes the
# refined type the expectation gives its variable, as `Some(v)` does
# for an `Option[Pos]`.
fn ctor_coerce_expected(r: Inferred, expected: Ty) : Inferred / Console + File + Mutable = match r.expr.kind {
  ECall(c, args_) -> match callee_ctor_name(r.st.env.tab, c) {
    Some(cn) -> if not rc_mentions(apply_ty(r.st.sub, expected)) { r } else { match ctor_fresh_sig(r.st.env, c) {
      TyFnT(ps, res, _) -> {
        let binds = rc_var_binds(res, apply_ty(r.st.sub, expected))
        if binds == [] { r } else {
          let ca = coerce_args_to(r.st, args_, map(args_, (a) => typed_ty_or(a, TyAny)),
                                  map(ps, (p) => rc_subst(p, binds)), "argument of `#{cn}`")
          mk_inferred(ca.st, r.ty, Expr { ...r.expr, kind: ECall(c, ca.exprs) })
        }
      }
      _ -> r
    } }
    None -> r
  }
  _ -> r
}


fn coerce_args_to(st: InferState, args_: [Expr], arg_tys: [Ty], params: [Ty], what: String) : InferredList / Console + File + Mutable =
  match args_ {
    [a, ...rest] -> match arg_tys {
      [t, ...trest] -> match params {
        [p, ...prest] -> {
          let m = refine_coerce(MintedExpr { st: st, pair: ExprTy { expr: a, ty: t } }, p, what, a.line, a.col)
          let rr = coerce_args_to(m.st, rest, trest, prest, what)
          InferredList { st: rr.st, tys: [m.pair.ty, ...rr.tys], exprs: [m.pair.expr, ...rr.exprs] }
        }
        [] -> InferredList { st: st, tys: arg_tys, exprs: args_ }
      }
      [] -> InferredList { st: st, tys: arg_tys, exprs: args_ }
    }
    [] -> InferredList { st: st, tys: arg_tys, exprs: args_ }
  }


# A block's value is its tail; checking the tail keeps the block's
# prefix (the requires checks a call site reads) in front.
#[doc("Typer-internal helper `refine_coerce_tail` shared across the infer modules.")]
pub fn refine_coerce_tail(r: Inferred, expected: Ty, what: String) : Inferred / Console + File + Mutable = match r.expr.kind {
  EBlock(ss, Some(t)) -> {
    let inner = refine_coerce_tail(mk_inferred(r.st, typed_ty_or(t, r.ty), t), expected, what)
    mk_inferred(inner.st, r.ty, Expr { ...r.expr, kind: EBlock(ss, Some(inner.expr)) })
  }
  _ -> {
    let m = refine_coerce(MintedExpr { st: r.st, pair: ExprTy { expr: r.expr, ty: r.ty } }, expected, what, r.expr.line, r.expr.col)
    mk_inferred(m.st, m.pair.ty, m.pair.expr)
  }
}


fn refine_checked(st: InferState, v: Expr, vty: Ty, preds: [Expr], strip: Bool) : Inferred / Console + File + Mutable {
  let rv = binder_minted("__rv")
  let pat = mk_pat(PBind(rv), v.line, v.col)
  let named = (p) => pred_local_names(p, (l) => st_local_text(st, l), ln_empty())
  let checks = synth_stmts(check_pattern(st, pat, vty), map(preds, (p) => rc_assert(rv, p, st.refine_ctx, strip, st.env.tab, named(p))))
  let tail = synth(checks.st, mk_local(rv.id, v.line, v.col))
  let block = mk_expr(EBlock([SLet(pat, None, v), ...checks.stmts], Some(tail.expr)), v.line, v.col)
  mk_inferred(st_restore_entries(st, tail.st), vty, with_ty(block, vty))
}


# A let-RHS under annotation. A textual numeric literal
# (`EIntLit`/`EDecimalLit`) coins against the resolved annotation here,
# before `synth` would error on the missing context; everything else
# synths normally and the post-synth `maybe_mint_literal` covers the
# `EInt`/`EReal` cases.
#[doc("Typer-internal helper `synth_let_rhs_or_mint` shared across the infer modules.")]
pub fn synth_let_rhs_or_mint(st: InferState, rhs: Expr, te: TypeExpr,
                         line: Int, col: Int) : Inferred / Console + File + Mutable {
  match rhs.kind {
    EIntLit(_)     -> mint_let_textual(st, rhs, te, line, col)
    EDecimalLit(_) -> mint_let_textual(st, rhs, te, line, col)
    EUnop(UoNeg, x) -> match x.kind {
      EIntLit(_) -> mint_let_textual(st, rhs, te, line, col)
      _          -> synth(st, rhs)
    }
    # The annotation names the record a bare literal head builds.
    ERecordLit(rh, fis) -> synth_record_lit(st, rh, fis, st_annot_ty(st, te), rhs.line, rhs.col)
    _ -> synth(st, rhs)
  }
}


# `e` where a type is expected: a record literal's head is asked of that
# type first, as is one written as an element of a list literal, and a
# lambda's parameters take its domains; any other shape is synthesised.
fn synth_expecting(st: InferState, e: Expr, expected: Ty) : Inferred / Console + File + Mutable = match e.kind {
  ERecordLit(rh, fis) -> synth_record_lit(st, rh, fis, expected, e.line, e.col)
  ELambda(ps, body) -> match apply_ty(st.sub, expected) {
    TyFnT(doms, _, _) -> synth_lambda_expecting(st, ps, body, doms, e.line, e.col)
    _                 -> synth(st, e)
  }
  EList(els) -> match apply_ty(st.sub, expected) {
    TyListT(elem_ty) -> if any(els, elem_is_record_lit) { check_list_elems_against(st, els, elem_ty, e.line, e.col) }
                        else { synth(st, e) }
    _ -> synth(st, e)
  }
  _ -> synth(st, e)
}


fn mint_let_textual(st: InferState, rhs: Expr, te: TypeExpr,
                    line: Int, col: Int) : Inferred / Console + File + Mutable {
  let expected = apply_ty(st.sub, st_annot_ty(st, te))
  match mint_literal(rhs, expected, mint_bigint_home(st.env)) {
    MintOk(e2) -> {
      let ty = match e2.ty { Some(t) -> t None -> expected }
      mk_inferred(st, ty, e2)
    }
    MintErr(msg) -> {
      let perr = mk_diag(SevError, st.file, line, col, msg, [])
      render_diag(perr)
      mk_inferred(st_bump_err(st_push_diag(st, perr)), expected, rhs)
    }
    MintNone -> synth(st, rhs)
  }
}


# A field whose declared type is a sum picks the constructor the way an
# annotated binding does; every other shape keeps synthesising, so the
# field's type still only has to unify.
fn synth_field_value(st: InferState, ex: Expr, ft: Option[Ty]) : Inferred / Console + File + Mutable =
  match ft {
    None     -> synth(st, ex)
    Some(ty) -> check_branch_for_ctor(st, ex, apply_ty(st.sub, ty))
  }


fn synth_field_inits(st: InferState, fis: [FieldInit], fields: [FTy], line: Int, col: Int) : InferredFInits / Console + File + Mutable {


  match fis {
    [] -> InferredFInits { st: st, fis: [] }
    [fi, ...rest] -> match fi {
      FI(fnm, ex) -> {
        let r = synth_field_value(st, ex, fty_find(fields, fnm))
        let minted = match fty_find(fields, fnm) {
          None -> MintedExpr { st: r.st, pair: ExprTy { expr: r.expr, ty: r.ty } }
          Some(ft) -> maybe_mint_literal(r.st, r.expr, r.ty, apply_ty(r.st.sub, ft), line, col)
        }
        let coerced = match fty_find(fields, fnm) {
          Some(ft) -> if rc_mentions(ft) or rc_mentions_in(minted.st.sub, minted.pair.ty) { refine_coerce(minted, ft, field_what(fnm), ex.line, ex.col) } else { minted }
          None -> minted
        }
        let lower_pair = coerced.pair
        let s1 = match fty_find(fields, fnm) {
          None -> coerced.st
          Some(ft) -> st_unify(coerced.st, ft, lower_pair.ty, field_what(fnm), line, col)
        }
        let rr = synth_field_inits(s1, rest, fields, line, col)
        InferredFInits { st: rr.st, fis: [FI(fnm, lower_pair.expr), ...rr.fis] }
      }
    }
  }
}


fn synth_block(st: InferState, stmts: [Stmt], tail: Option[Expr], line: Int, col: Int) : Inferred / Console + File + Mutable {


  let outer = st
  let is = synth_stmts(st, stmts)
  let rt_kind = match tail {
    None     -> BlockTail { st: is.st, ty: TyUnit, expr_opt: None }
    Some(te) -> {
      let r = synth(is.st, te)
      BlockTail { st: r.st, ty: r.ty, expr_opt: Some(r.expr) }
    }
  }
  let st2 = st_restore_entries(outer, rt_kind.st)
  let ty = apply_ty(st2.sub, rt_kind.ty)
  let root = with_ty(mk_expr(EBlock(is.stmts, rt_kind.expr_opt), line, col), ty)
  mk_inferred(st2, ty, root)
}


fn synth_stmts(st: InferState, stmts: [Stmt]) : InferredStmts / Console + File + Mutable {


  match stmts {
    [] -> InferredStmts { st: st, stmts: [] }
    [one, ...rest] -> {
      let r = synth_stmt(st, one)
      let rr = synth_stmts(r.st, rest)
      InferredStmts { st: rr.st, stmts: [r.stmt, ...rr.stmts] }
    }
  }
}


fn synth_stmt(st: InferState, stmt: Stmt) : OneStmt / Console + File + Mutable {


  match stmt {
    SLet(pat, ann, rhs) -> {
      let ann_label = if pat_binds_var_ann(pat) { "var annotation" } else { "let annotation" }
      # when the let is annotated and the RHS is an
      # `EMatch`, drive the RHS in check-mode so the expected
      # type reaches every arm via `check_match`. The non-match
      # path is unchanged (synth + post-hoc unify against `declared`
      # below). Decimal-literal lowering relies on `rr.ty` being the
      # synthesised RHS type, which is preserved in both paths.
      # same routing for `EIf` via `check_if`.
      let rr = match ann {
        Some(te) -> match rhs.kind {
          EMatch(_, _) -> {
            let exp_resolved = st_annot_ty(st, te)
            check_expr_against(st, rhs, exp_resolved, ann_label, pat.line, pat.col)
          }
          EIf(_, _, _) -> {
            let exp_resolved = st_annot_ty(st, te)
            check_expr_against(st, rhs, exp_resolved, ann_label, pat.line, pat.col)
          }
          # Fix B: route EList through bidirectional check so element
          # literals can be retagged to Byte when expected is [Byte]
          # (and a Vec annotation mints the literal to a vec build).
          EList(_) -> {
            let exp_resolved = st_annot_ty(st, te)
            check_expr_against(st, rhs, exp_resolved, ann_label, pat.line, pat.col)
          }
          # a Vec-annotated map-pipe chain collects into the vec
          # (pre-sized when the head is a pure range).
          EDispatchPipe(PoMap, _, _) -> {
            let exp_resolved = st_annot_ty(st, te)
            check_expr_against(st, rhs, exp_resolved, ann_label, pat.line, pat.col)
          }
          # route a call, a bare name and a local read with annotation
          # context through check_expr_against so a bare ctor the
          # annotation's type declares resolves to that constructor.
          ECall(_, _) -> {
            let exp_resolved = st_annot_ty(st, te)
            check_expr_against(st, rhs, exp_resolved, ann_label, pat.line, pat.col)
          }
          EName(_) -> {
            let exp_resolved = st_annot_ty(st, te)
            check_expr_against(st, rhs, exp_resolved, ann_label, pat.line, pat.col)
          }
          ELocal(_) -> {
            let exp_resolved = st_annot_ty(st, te)
            check_expr_against(st, rhs, exp_resolved, ann_label, pat.line, pat.col)
          }
          # a bare numeric literal coins directly to the annotated carrier
          # from its source lexeme, before synth would stamp a default
          # type (or error on a textual `EIntLit`/`EDecimalLit`).
          _ -> synth_let_rhs_or_mint(st, rhs, te, pat.line, pat.col)
        }
        None -> synth(st, rhs)
      }
      # when the let binding is annotated, coin a numeric RHS literal to
      # the declared carrier: a point literal to an exact Decimal, an
      # integer to any numeric type, from the source lexeme. The
      # Decimal-with-unit lowering is folded into `maybe_mint_literal`.
      # `st_unify` below still confirms the minted type equals the
      # declared one, so the unifier stays the authority.
      let minted = match ann {
        None -> MintedExpr { st: rr.st, pair: ExprTy { expr: rr.expr, ty: rr.ty } }
        Some(te) -> maybe_mint_literal(rr.st, rr.expr, rr.ty,
                                       apply_ty(rr.st.sub, st_annot_ty(rr.st, te)),
                                       pat.line, pat.col)
      }
      let coerced = match ann {
        None -> minted
        Some(te) -> {
          let declared = st_annot_ty(minted.st, te)
          if not (rc_mentions(declared) or rc_mentions_in(minted.st.sub, minted.pair.ty)) { minted }
          else { refine_coerce(minted, declared, binding_what(pat, ann_label), pat.line, pat.col) }
        }
      }
      let lower_pair = coerced.pair
      let binding_st = match ann {
        None -> coerced.st
        Some(te) -> {
          let declared = st_annot_ty(coerced.st, te)
          st_unify(coerced.st, declared, lower_pair.ty, ann_label, pat.line, pat.col)
        }
      }
      let binding_ty0 = match ann {
        None -> lower_pair.ty
        Some(te) -> st_annot_ty(rr.st, te)
      }
      let binding_ty = let_binder_ty(binding_ty0, lower_pair.expr)
      let after = check_pattern_stamped(binding_st, pat, binding_ty)
      OneStmt { st: after.st, stmt: SLet(after.pat, ann, lower_pair.expr) }
    }
    SAssert(cond, msg) -> {
      let rc = synth_assert_cond(st, cond, contract_assert_kind(msg))
      let s1 = st_unify(rc.st, rc.ty, TyBool, "assert condition", cond.line, cond.col)
      let rm = match msg {
        None -> InferredOptExpr { st: s1, expr: None }
        Some(mx) -> {
          let r = synth(s1, mx)
          InferredOptExpr { st: r.st, expr: Some(r.expr) }
        }
      }
      OneStmt { st: rm.st, stmt: SAssert(rc.expr, rm.expr) }
    }
    SExprStmt(ex) -> {
      let r = synth(st, ex)
      OneStmt { st: r.st, stmt: SExprStmt(r.expr) }
    }
    # dispatch the indexed write by container type.
    # `Array[T]` lowers to `array_set(b, i, v)`. `Map[K, V]` is
    # rejected with a typed error that points at `map_put`; the
    # node returned is harmless filler so downstream passes never
    # see a typed `SIndexAssign` survive.
    SAssign(_, _, _, _) ->
      panic("infer: SAssign must be lowered by surface_lower before the typer")
    SIndexAssign(b, i, v, line, col) -> {
      let probe = synth(st, b)
      let base_ty = apply_ty(probe.st.sub, probe.ty)
      match ty_coll(base_ty) {
        Some(CcMap) -> {
          let ri = synth(probe.st, i)
          let rv = synth(ri.st, v)
          let perr = mk_diag(SevError, st.file, line, col,
            "indexed write `m[k] := v` is not supported for `Map[K, V]` in v1", [])
          render_diag(perr)
          diag_help("use `map.put(m, k, v)` and rebind; the v2 design lands alongside the HAMT carrier")
          OneStmt { st: st_bump_err(st_push_diag(rv.st, perr)), stmt: SExprStmt(probe.expr) }
        }
        _ -> {
          let callee = builtin_mk(CbArraySet, line, col)
          let call_node = mk_expr(ECall(callee, [b, i, v]), line, col)
          let rc = synth(st, call_node)
          OneStmt { st: rc.st, stmt: SExprStmt(rc.expr) }
        }
      }
    }
    # `var name = init` — desugar pass not yet implemented.
    # The resolve pass (chk_stmt) already emits the explicit "not yet
    # implemented" diagnostic and short-circuits before infer normally
    # runs. If a future caller invokes inference on the raw AST, return
    # the init's type without binding `name`, so we never silently
    # produce a `let`-equivalent.
    SVar(name, ann, rhs, line, col) -> {
      let rr = synth(st, rhs)
      OneStmt { st: rr.st, stmt: SVar(name, ann, rr.expr, line, col) }
    }
    # SUse stripped pre-typer; if we ever reach here, treat
    # as a no-op (no expressions, no bindings).
    SUse(n, line, col) -> OneStmt { st: st, stmt: SUse(n, line, col) }
  }
}

# ---- patterns ----


fn check_pattern(st: InferState, pat: Pattern, expected: Ty) : InferState / Console + File + Mutable =
  check_pattern_stamped(st, pat, expected).st


fn check_pattern_stamped(st: InferState, pat: Pattern, expected: Ty) : PatChecked / Console + File + Mutable {


  match pat.pkind {
    PWild      -> PatChecked { st: st, pat: pat }
    PBind(b)   -> {
      let env2 = env_bind_local(st.env, b, mono(apply_ty(st.sub, expected)))
      PatChecked { st: st_set_env(st, env2), pat: pat }
    }
    PLit(lit)  -> {
      let r = synth(st, lit)
      PatChecked { st: st_unify(r.st, expected, r.ty, "literal pattern", pat.line, pat.col), pat: pat }
    }
    # `PRange` is desugared to a binder + comparison guard before the
    # typer runs, so it never reaches here.
    PRange(_, _) -> PatChecked { st: st, pat: pat }
    PList(subpats, rest_opt) -> {
      let rv = st_fresh_ty(st)
      let s1 = st_unify(rv.st, expected, TyListT(rv.ty), "list pattern", pat.line, pat.col)
      let subs = check_list_subpats(s1, subpats, rv.ty)
      let s2 = subs.st
      let s3 = match rest_opt {
        None -> s2
        Some(rb) -> {
          let env2 = env_bind_local(s2.env, rb, mono(TyListT(apply_ty(s2.sub, rv.ty))))
          st_set_env(s2, env2)
        }
      }
      PatChecked { st: s3, pat: mk_pat(PList(subs.pats, rest_opt), pat.line, pat.col) }
    }
    PVariant(r, sub_pats) ->
      check_variant_pattern(st, r, sub_pats, expected, pat.line, pat.col)
    PVariantRecord(r, pfs) ->
      check_variant_record_pattern(st, r, pfs, expected, pat.line, pat.col)
    PRecord(pfs) -> {
      let fs = check_record_pattern(st, pfs, expected, pat.line, pat.col)
      PatChecked { st: fs.st, pat: mk_pat(PRecord(fs.fields), pat.line, pat.col) }
    }
    PHole(nm_opt) -> PatChecked { st: check_hole_pattern(st, nm_opt, expected, pat.line, pat.col), pat: pat }
    # bind the as-name to the scrutinee at the *expected*
    # type, then continue typing the inner pattern at the same type.
    # The inner pattern owns its own bindings; the as-binding adds
    # one more name that aliases the whole scrutinee.
    PAs(b, sub) -> {
      let env2 = env_bind_local(st.env, b, mono(apply_ty(st.sub, expected)))
      let inner = check_pattern_stamped(st_set_env(st, env2), sub, expected)
      PatChecked { st: inner.st, pat: mk_pat(PAs(b, inner.pat), pat.line, pat.col) }
    }
    # type-narrowing pattern. The scrutinee must
    # be a `TyUnion` containing the narrow type as a component; bind
    # `name` at the narrow type so the arm body can call APIs that
    # accept the component directly. Exhaustiveness treats this as
    # full coverage of the component's variants (see
    # `check_exhaustive`). Codegen never sees `PNarrow` — it is
    # rewritten to a sequence of `PAs(name, PVariant(Vi, []))` arms
    # in `expand_narrow_arms` after typing.
    PNarrow(b, ty_expr) -> PatChecked { st: check_narrow_pattern(st, b, ty_expr, expected, pat.line, pat.col), pat: pat }
    PSurface(_) -> panic("check_pattern: surface pattern not lowered")
  }
}


fn check_list_subpats(st: InferState, ps: [Pattern], elem: Ty) : PatsChecked / Console + File + Mutable {


  match ps {
    [] -> PatsChecked { st: st, pats: [] }
    [p, ...rest] -> {
      let h = check_pattern_stamped(st, p, elem)
      let t = check_list_subpats(h.st, rest, elem)
      PatsChecked { st: t.st, pats: [h.pat, ...t.pats] }
    }
  }
}


# A pattern head the scope cannot tell apart: reported, and its
# sub-patterns typed against nothing.
fn check_tied_pattern(st: InferState, r: DeclRef, ss: [SymId], subpats: [Pattern], line: Int, col: Int) : PatChecked / Console + File + Mutable = {
  let st1 = match r {
    DrWritten(_, w) -> report_name_tie(st, w, ss, not list_is_empty(subpats), line, col)
    DrSym(_)        -> st
  }
  let subs = check_unknown_subpats(st1, subpats)
  PatChecked { st: subs.st, pat: mk_pat(PVariant(r, subs.pats), line, col) }
}


fn check_variant_pattern(st: InferState, r: DeclRef, subpats: [Pattern], expected: Ty, line: Int, col: Int) : PatChecked / Console + File + Mutable {


  let cname = ref_text(st.env.tab, r)
  let picked = match pattern_ctor(st, r, expected) {
    SetOne(c)  -> PcOne(ctor_entry(st.env, c))
    SetTie(ss) -> PcTie(ss)
    _          -> PcOne(None)
  }
  match picked {
    PcTie(ss) -> check_tied_pattern(st, r, ss, subpats, line, col)
    PcOne(None) -> {
      let hint = match closest_name(cname, env_ctor_names(st.env)) {
        Some(sug) -> " (did you mean `#{sug}`?)"
        None      -> ""
      }
      let perr = mk_diag(SevError, st.file, line, col, "unknown variant '#{cname}'#{hint}", [])
      render_diag(perr)
      let subs = check_unknown_subpats(st_bump_err(st_push_diag(st, perr)), subpats)
      PatChecked { st: subs.st, pat: mk_pat(PVariant(r, subs.pats), line, col) }
    }
    PcOne(Some(CtorPick(c, entry))) -> {
      let inst = st_instantiate(st, entry.scheme)
      match inst.ty {
        TyFnT(aps, ret, _) -> {
          let what = string_concat("variant pattern '", string_concat(cname, "'"))
          let s1 = st_unify(inst.st, expected, ret, what, line, col)
          let subs = check_subpat_list(s1, subpats, aps, line, col)
          PatChecked { st: subs.st, pat: mk_pat(PVariant(DrSym(c), subs.pats), line, col) }
        }
        _ -> {
          let what = string_concat("variant pattern '", string_concat(cname, "'"))
          let s1 = st_unify(inst.st, expected, inst.ty, what, line, col)
          match subpats {
            [] -> PatChecked { st: s1, pat: mk_pat(PVariant(DrSym(c), []), line, col) }
            _  -> {
              let perr = mk_diag(SevError, st.file, line, col, "variant '#{cname}' takes no args but pattern has #{int_to_string(list_length(subpats))}", [])
              render_diag(perr)
              PatChecked { st: st_bump_err(st_push_diag(s1, perr)), pat: mk_pat(PVariant(DrSym(c), subpats), line, col) }
            }
          }
        }
      }
    }
  }
}


fn check_unknown_subpats(st: InferState, ps: [Pattern]) : PatsChecked / Console + File + Mutable {


  match ps {
    [] -> PatsChecked { st: st, pats: [] }
    [p, ...rest] -> {
      let h = check_pattern_stamped(st, p, TyAny)
      let t = check_unknown_subpats(h.st, rest)
      PatsChecked { st: t.st, pats: [h.pat, ...t.pats] }
    }
  }
}


fn check_subpat_list(st: InferState, ps: [Pattern], tys: [Ty], line: Int, col: Int) : PatsChecked / Console + File + Mutable {


  variant_arity_check(st, ps, tys, line, col, list_length(tys), list_length(ps))
}


fn variant_arity_check(st: InferState, ps: [Pattern], tys: [Ty],
                        line: Int, col: Int, expected: Int, found: Int) : PatsChecked / Console + File + Mutable {


  match ps {
    [] -> match tys {
      [] -> PatsChecked { st: st, pats: [] }
      _  -> {
        let perr = mk_diag(SevError, st.file, line, col, "variant pattern has too few sub-patterns", [])
        render_diag(perr)
        diag_note("expected #{int_to_string(expected)}, found #{int_to_string(found)}")
        diag_help("add #{int_to_string(expected - found)} more sub-pattern(s), or use a wildcard `_` for each")
        PatsChecked { st: st_bump_err(st_push_diag(st, perr)), pats: [] }
      }
    }
    [p, ...pr] -> match tys {
      [] -> {
        let perr = mk_diag(SevError, st.file, line, col, "variant pattern has too many sub-patterns", [])
        render_diag(perr)
        diag_note("expected #{int_to_string(expected)}, found #{int_to_string(found)}")
        diag_help("remove #{int_to_string(found - expected)} sub-pattern(s) so the count matches the variant's declared arity")
        PatsChecked { st: st_bump_err(st_push_diag(st, perr)), pats: ps }
      }
      [t, ...tr] -> {
        let h = check_pattern_stamped(st, p, t)
        let r = variant_arity_check(h.st, pr, tr, line, col, expected, found)
        PatsChecked { st: r.st, pats: [h.pat, ...r.pats] }
      }
    }
  }
}


# `Name { fields }` names a record type; the typed pattern holds its id.
fn check_variant_record_pattern(st: InferState, r: DeclRef, pfs: [PField], expected: Ty, line: Int, col: Int) : PatChecked / Console + File + Mutable {


  let head = record_head_sym(st, r, expected, line, col)
  match head_record(st.recs, head.sym) {
    None -> {
      let fs = check_unknown_pfields(head.st, pfs)
      PatChecked { st: fs.st, pat: mk_pat(PVariantRecord(r, fs.fields), line, col) }
    }
    Some(ri) -> {
      let rsym = match ri { RI(s, _, _, _) -> s }
      let inst = rec_instantiate(head.st, ri)
      let what = string_concat("record pattern '", string_concat(ref_text(st.env.tab, r), "'"))
      let s1 = st_unify(inst.st, expected, inst.result_ty, what, line, col)
      let fs = check_pfield_list(s1, pfs, ri, inst.fields, line, col)
      PatChecked { st: fs.st, pat: mk_pat(PVariantRecord(DrSym(rsym), fs.fields), line, col) }
    }
  }
}


fn check_record_pattern(st: InferState, pfs: [PField], expected: Ty, line: Int, col: Int) : PFieldsChecked / Console + File + Mutable {


  let applied = apply_ty(st.sub, expected)
  match applied {
    TyCon(tsym, _) -> {
      let lookup = rec_pick(st.recs, tsym)
      match lookup {
        None -> check_unknown_pfields(st, pfs)
        Some(ri) -> {
          let inst = rec_instantiate(st, ri)
          let s1 = st_unify(inst.st, expected, inst.result_ty, "record pattern", line, col)
          check_pfield_list(s1, pfs, ri, inst.fields, line, col)
        }
      }
    }
    TyVarT(recv_id) -> check_deferred_pfields(st, pfs, recv_id, line, col)
    _ -> check_unknown_pfields(st, pfs)
  }
}


# The record type is not known yet: each field is resolved, and its
# visibility judged, once the body settles the scrutinee.
fn check_deferred_pfields(st: InferState, pfs: [PField], recv_id: Int, line: Int, col: Int) : PFieldsChecked / Console + File + Mutable =
  match pfs {
    [] -> PFieldsChecked { st: st, fields: [] }
    [PField(fnm, sub, sh), ...rest] -> {
      let fr = st_fresh_ty(st)
      let s1 = st_push_deferred_field(fr.st, DFd(recv_id, fnm, ty_var_id(fr.ty), line, col, true))
      let h = check_pattern_stamped(s1, sub, fr.ty)
      let t = check_deferred_pfields(h.st, rest, recv_id, line, col)
      PFieldsChecked { st: t.st, fields: [PField(fnm, h.pat, sh), ...t.fields] }
    }
  }


fn check_unknown_pfields(st: InferState, pfs: [PField]) : PFieldsChecked / Console + File + Mutable {


  match pfs {
    [] -> PFieldsChecked { st: st, fields: [] }
    [pf, ...rest] -> match pf {
      PField(fnm, sub, sh) -> {
        let h = check_pattern_stamped(st, sub, TyAny)
        let t = check_unknown_pfields(h.st, rest)
        PFieldsChecked { st: t.st, fields: [PField(fnm, h.pat, sh), ...t.fields] }
      }
    }
  }
}


fn check_pfield_list(st: InferState, pfs: [PField], ri: RecInfo, fields: [FTy], line: Int, col: Int) : PFieldsChecked / Console + File + Mutable {


  match pfs {
    [] -> PFieldsChecked { st: st, fields: [] }
    [pf, ...rest] -> match pf {
      PField(fnm, sub, sh) -> {
        let h = match fty_find(fields, fnm) {
          Some(ft) -> check_pattern_stamped(check_pfield_visible(st, ri, fnm, line, col), sub, ft)
          None -> {
            let perr = mk_diag(SevError, st.file, line, col, "no field '#{fnm}' in record pattern#{field_hint(fields, fnm)}", [])
            render_diag(perr)
            check_pattern_stamped(st_bump_err(st_push_diag(st, perr)), sub, TyAny)
          }
        }
        let t = check_pfield_list(h.st, rest, ri, fields, line, col)
        PFieldsChecked { st: t.st, fields: [PField(fnm, h.pat, sh), ...t.fields] }
      }
    }
  }
}


fn synth_match(st: InferState, scr: Expr, arms: [Arm], line: Int, col: Int) : Inferred / Console + File + Mutable {


  let st0 = check_arms_redundancy(st, arms, [], false, line, col)
  let rs_ = synth(st0, scr)
  let scr_ty0 = apply_ty(rs_.st.sub, rs_.ty)
  if fixed_vec_match_route(scr_ty0, arms) {
    synth_fixed_vec_match(rs_.st, rs_.expr, arms, scr_ty0, None, line, col)
  } else if vec_match_route(scr_ty0, arms) {
    synth_vec_match(rs_.st, scr, arms, None, line, col)
  } else if seq_match_route(scr_ty0, arms) {
    synth_seq_match(rs_.st, scr, arms, None, line, col)
  } else {
  let rv = st_fresh_ty(rs_.st)
  let ra = synth_arms(rv.st, arms, rs_.ty, rv.ty, line, col)
  let ty = apply_ty(ra.st.sub, rv.ty)
  let scr_final = apply_ty(ra.st.sub, rs_.ty)
  let st_rep = check_arms_ctor_repeats(ra.st, ra.arms, [], false, line, col)
  let st_post = check_exhaustive(annotate_pattern_holes(st_rep, ra.arms, scr_final), ra.arms, scr_final, line, col)
  # expand `PNarrow(name, T)` arms into one
  # `PAs(name, PVariant(Vi, []))` arm per variant of T so codegen
  # never sees `PNarrow`. Variants come from the post-resolve env
  # (same accessor used by exhaustiveness). The rewrite is purely
  # structural — `name`'s narrow type was bound during typing in
  # `check_narrow_pattern`, so the body's typed AST is already
  # consistent.
  let arms_narrowed = expand_narrow_arms(ra.arms, st_post, scr_final)
  # the parser emits `PVariantRecord(name, fields)` for
  # any `Name { ... }` pattern, even when `Name` is a record alias
  # (`type P = { x: Int, y: Int }`) rather than a sum-type ctor with
  # named fields. The typer accepts both shapes via
  # `check_variant_record_pattern`, but the emitter's
  # `emit_pat_test_variant_record` always tests `KAI_VARIANT` — which
  # never matches a `KAI_RECORD` value, so the arm falls through to
  # the runtime "non-exhaustive match" panic. Rewriting to `PRecord`
  # post-typing routes codegen through `emit_pat_test_record` (the
  # `KAI_RECORD` check) without touching the typer.
  let arms_codegen = rewrite_record_alias_arms(arms_narrowed, st_post.recs)
  let root = with_ty(mk_expr(EMatch(rs_.expr, arms_codegen), line, col), ty)
  mk_inferred(st_post, ty, root)
  }
}


# bidirectional check variant of `synth_match`. When the
# match appears in a position with a known expected type — annotated
# function return, annotated `let` RHS — the caller passes that type
# in as `expected`, and each arm is unified against it directly
# instead of against a freshly-fabricated TyVar. This carries the
# implicit-upcast behaviour across match arms: with the
# expected union shape in scope when the first arm unifies, the
# `union_upcast_ok` rule in `unify_heads` accepts a narrower component
# type without the typer pinning `body_ty` to it.
# Synthesise mode (`synth_match`) is preserved verbatim for
# unannotated positions so existing inference is unchanged.
fn check_match(st: InferState, scr: Expr, arms: [Arm], expected: Ty,
               line: Int, col: Int) : Inferred / Console + File + Mutable {


  let st0 = check_arms_redundancy(st, arms, [], false, line, col)
  let rs_ = synth(st0, scr)
  let scr_ty0 = apply_ty(rs_.st.sub, rs_.ty)
  if fixed_vec_match_route(scr_ty0, arms) {
    synth_fixed_vec_match(rs_.st, rs_.expr, arms, scr_ty0, Some(expected), line, col)
  } else if vec_match_route(scr_ty0, arms) {
    synth_vec_match(rs_.st, scr, arms, Some(expected), line, col)
  } else if seq_match_route(scr_ty0, arms) {
    synth_seq_match(rs_.st, scr, arms, Some(expected), line, col)
  } else {
  # walk arms via `check_arms` so the expected type
  # propagates into nested EMatch / EIf / EBlock-tailed-by-match
  # arm bodies — the shape produced by the multi-clause fn-body
  # desugar for fns with N>=2 parameters. With `synth_arms`
  # the nested match was synthesised against a fresh body-ty var,
  # which re-exposed the same arm-vs-arm asymmetry already handled at
  # the top level. The 1-arg multi-clause shape is already covered because
  # `check_body_against_ret` reaches the outer EMatch directly.
  let ra = check_arms(rs_.st, arms, rs_.ty, expected, line, col)
  let ty = apply_ty(ra.st.sub, expected)
  let scr_final = apply_ty(ra.st.sub, rs_.ty)
  let st_rep = check_arms_ctor_repeats(ra.st, ra.arms, [], false, line, col)
  let st_post = check_exhaustive(annotate_pattern_holes(st_rep, ra.arms, scr_final), ra.arms, scr_final, line, col)
  let arms_narrowed = expand_narrow_arms(ra.arms, st_post, scr_final)
  let arms_codegen  = rewrite_record_alias_arms(arms_narrowed, st_post.recs)
  let root = with_ty(mk_expr(EMatch(rs_.expr, arms_codegen), line, col), ty)
  mk_inferred(st_post, ty, root)
  }
}


# Rewrite a fixed-vec match to the selected arm's body. Arms ride the
# same shape contract as the dynamic rewrite (no guards, simple head
# binders); the length test is decided here instead of at runtime, so a
# vec whose length no arm covers is a compile error, not a fallthrough.
fn synth_fixed_vec_match(st: InferState, scr: Expr, arms: [Arm], scr_ty: Ty,
                         expected: Option[Ty], line: Int, col: Int) : Inferred / Console + File + Mutable {
  let g = vec_match_check_arms(st, arms)
  if g.ok {
    let n = fixed_vec_n(scr_ty)
    match fixed_vec_match_arm(arms, n) {
      Some(a) -> {
        let body = fixed_vec_arm_build(a, scr, scr_ty)
        match expected {
          None    -> synth(g.st, body)
          Some(t) -> check_expr_against(g.st, body, t, "match arm", line, col)
        }
      }
      None -> {
        let perr = mk_diag(SevError, g.st.file, line, col,
          concat_all(["no arm matches a fixed-width `Vec` of length ", int_to_string(n)]), [])
        render_diag(perr)
        diag_help("add an arm for that length, a spread pattern (`[a, ...rest]`), or a wildcard `_`")
        mk_inferred(st_bump_err(st_push_diag(g.st, perr)), TyAny, with_ty(mk_expr(EMatch(scr, arms), line, col), TyAny))
      }
    }
  } else {
    mk_inferred(g.st, TyAny, with_ty(mk_expr(EMatch(scr, arms), line, col), TyAny))
  }
}


# Rewrite a Vec-scrutinee match into the vec_match if-chain and type it
# ONCE (check-mode when an expected type is in play). The scrutinee was
# already synthesised to learn its type; the returned state is threaded
# so its fresh-tvar mints stay bound — the chain re-synthesises the raw
# scrutinee node under that same state.
fn synth_vec_match(st: InferState, scr: Expr, arms: [Arm], expected: Option[Ty],
                   line: Int, col: Int) : Inferred / Console + File + Mutable {
  let g = vec_match_validate(st, arms, line, col)
  if g.ok {
    let chain = vec_match_build(scr, arms, line, col)
    match expected {
      None    -> synth(g.st, chain)
      Some(t) -> check_expr_against(g.st, chain, t, "match arm", line, col)
    }
  } else {
    mk_inferred(g.st, TyAny, with_ty(mk_expr(EMatch(scr, arms), line, col), TyAny))
  }
}


# A list-pattern match on a `Seq`, typed as the match over the read cell
# it is rewritten to. The scrutinee was synthesised to learn its type;
# the rewrite re-synthesises the raw node under that same state.
fn synth_seq_match(st: InferState, scr: Expr, arms: [Arm], expected: Option[Ty],
                   line: Int, col: Int) : Inferred / Console + File + Mutable =
  match seq_match_fault(arms, line, col) {
    Some(f) -> {
      let d = mk_diag(SevError, st.file, f.line, f.col, f.msg, [ri_help(st.file, f.line, f.col, f.help)])
      render_diag(d)
      mk_inferred(st_bump_err(st_push_diag(st, d)), TyAny, with_ty(mk_expr(EMatch(scr, arms), line, col), TyAny))
    }
    None -> {
      let read = seq_match_build(scr, arms, line, col)
      match expected {
        None    -> synth(st, read)
        Some(t) -> check_expr_against(st, read, t, "match arm", line, col)
      }
    }
  }


# A part of a `lazy [...]` performs nothing. A thunk's effects are its
# lambda's row: a label it holds, or a row of the enclosing signature it
# is tied to; a row still open is closed with it, so a function the
# thunk calls is pure wherever it comes from. A range bound's are what
# it adds where the literal stands.
fn synth_lazy_part(st: InferState, x: Expr) : Inferred / Console + File + Mutable = match x.kind {
  ELambda(ps, body) -> {
    let r = synth_lambda_rows(st, ps, body, [], "", true, x.line, x.col)
    match r.ty {
      TyFnT(ps, ret, row) -> {
        let pure_ty = TyFnT(ps, ret, Row { labels: [], tail: None, display_alias: None })
        let tied = match row.tail { Some(t) -> is_sig_row(r.st.sub, r.st.sig_rows, row_root(r.st.sub, t)) None -> false }
        match row.labels {
          [] -> if tied { mk_inferred(lazy_impure(r.st, [], body), pure_ty, with_ty(r.expr, pure_ty)) }
                else { mk_inferred(st_unify(r.st, r.ty, pure_ty, "lazy sequence", x.line, x.col), pure_ty, r.expr) }
          ls -> mk_inferred(lazy_impure(r.st, ls, body), pure_ty, with_ty(r.expr, pure_ty))
        }
      }
      _ -> r
    }
  }
  _ -> {
    let r = synth(InferState { ...st, row: [], row_tails: [] }, x)
    let st1 = st_add_tail_labels(r.st, r.st.row_tails)
    let st2 = match st1.row {
      [] -> lazy_close_tails(st1, st1.row_tails, x)
      ls -> lazy_impure(st1, ls, x)
    }
    mk_inferred(InferState { ...st2, row: st.row, row_tails: st.row_tails }, r.ty, r.expr)
  }
}


# The progression of a `lazy` range: `call` is `from(start)`,
# `from_step(start, step)` or `range(start, end, step)`. The start says
# whether the range walks Int or Char, as in a list range, and the bounds
# are held to it first, so a mix is reported against the range.
fn synth_lazy_range(st: InferState, call: Expr) : Inferred / Console + File + Mutable = match call.kind {
  ECall(f, [start, ...rest]) -> {
    let peek = synth(st, start)
    let chars = lazy_range_of_chars(apply_ty(peek.st.sub, peek.ty), rest)
    let of = if chars { TyChar } else { TyInt }
    let s1 = st_unify(peek.st, of, peek.ty, "range start", call.line, call.col)
    let s2 = match rest {
      [hi, _] -> {
        let rh = synth(s1, hi)
        st_unify(rh.st, of, rh.ty, "range end", call.line, call.col)
      }
      _ -> s1
    }
    let s3 = if chars { char_range_second(s2, last(rest), call.line, call.col) } else { s2 }
    if s3.errs > st.errs { inferred_leaf(s3, TyAny, call) }
    else {
      let walk = if chars { lazy_char_walk(call, f, start, rest) } else { call }
      synth(st_restore_deferred_fields(s3, st.deferred_fields, st.deferred_homs), walk)
    }
  }
  _ -> synth(st, call)
}


# bidirectional walker over match arms. Mirrors
# `synth_arms` but routes each arm body through
# `check_body_against_ret`, which dispatches EMatch / EIf /
# EBlock-tailed-by-match to their check-mode helpers. The trailing
# unify against `expected` is preserved so non-match leaf bodies
# behave exactly as in synth_arms (synth + post-hoc unify against
# `expected`). For the propagating shapes the unify collapses to
# a no-op since `check_match` / `check_if` already pinned the body
# type to `expected`.
fn check_arms(st: InferState, arms: [Arm], scrut_ty: Ty, expected: Ty,
              line: Int, col: Int) : InferredArms / Console + File + Mutable {


  match arms {
    [] -> InferredArms { st: st, arms: [] }
    [a, ...rest] -> match a {
      Arm(pat, guard, body) -> {
        let outer = st
        let pc = check_pattern_stamped(st, pat, scrut_ty)
        let s_p = pc.st
        let guard_res = match guard {
          None -> InferredOptExpr { st: s_p, expr: None }
          Some(gx) -> {
            let rg = synth(s_p, gx)
            let s_g = st_unify(rg.st, rg.ty, TyBool, "match guard", gx.line, gx.col)
            InferredOptExpr { st: s_g, expr: Some(rg.expr) }
          }
        }
        let rb = check_body_against_ret(guard_res.st, body, expected, "match arm", body.line, body.col)
        let s_b = st_unify(rb.st, expected, rb.ty, "match arm", body.line, body.col)
        let s_scoped = st_restore_entries(outer, s_b)
        let rr = check_arms(s_scoped, rest, scrut_ty, expected, line, col)
        InferredArms { st: rr.st, arms: [Arm(pc.pat, guard_res.expr, rb.expr), ...rr.arms] }
      }
    }
  }
}


# bidirectional check variant of `synth_if`, parallel to
# `check_match`. When the if/else appears in a position
# with a known expected type — annotated function return, annotated
# `let` RHS — the caller passes that type in as `expected`, and each
# branch is unified against it directly instead of against the
# synthesised `then`-branch type. This carries the implicit-upcast
# behaviour across if/else branches: with the
# expected union shape in scope when the first branch unifies, the
# `union_upcast_ok` rule in `unify_heads` accepts a narrower component
# type without the typer pinning `body_ty` to it.
# Synthesise mode (`synth_if`) is preserved verbatim for unannotated
# positions so existing inference is unchanged.
fn check_if(st: InferState, c: Expr, t_: Expr, eo: Option[Expr],
            expected: Ty, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let rc = synth(st, c)
  let s1 = st_unify(rc.st, rc.ty, TyBool, "if condition", line, col)
  # thread `expected` into the then-branch ONLY
  # when it is shaped like a bare ctor expression (`EBlock` whose tail
  # is a ctor / nullary ctor, a call of a name, or a name) so a user
  # `Response.Ok` shadowing the core `Result.Ok` can be picked by
  # annotation context. Other branch shapes stay on synth to avoid
  # regressions in non-ctor expression types.
  let rt = check_branch_for_ctor(s1, t_, expected)
  match eo {
    None -> {
      let root = with_ty(mk_expr(EIf(rc.expr, rt.expr, None), line, col), TyUnit)
      mk_inferred(rt.st, TyUnit, root)
    }
    Some(ee) -> {
      let s_t = st_unify(rt.st, expected, rt.ty, "if/else branches", line, col)
      let re = check_branch_for_ctor(s_t, ee, expected)
      let s2 = st_unify(re.st, expected, re.ty, "if/else branches", line, col)
      let ty = apply_ty(s2.sub, expected)
      let root = with_ty(mk_expr(EIf(rc.expr, rt.expr, Some(re.expr)), line, col), ty)
      mk_inferred(s2, ty, root)
    }
  }
}


# Helper: route a branch through `check_expr_against`
# when it is a bare ctor reference (or a block whose tail is), so the
# annotation context can disambiguate. Other shapes fall through to
# `synth` to keep existing behaviour.
fn check_branch_for_ctor(st: InferState, br: Expr, expected: Ty) : Inferred / Console + File + Mutable {

  match br.kind {
    ECall(c, _) -> match c.kind {
      EName(_) -> check_expr_against(st, br, expected, "if branch", br.line, br.col)
      ESym(_, _) -> check_expr_against(st, br, expected, "if branch", br.line, br.col)
      _ -> synth(st, br)
    }
    EName(_) -> check_expr_against(st, br, expected, "if branch", br.line, br.col)
    ESym(_, _) -> check_expr_against(st, br, expected, "if branch", br.line, br.col)
    EBlock(_, tail) -> match tail {
      Some(te) -> match te.kind {
        ECall(c, _) -> match c.kind {
          EName(_) -> check_expr_against(st, br, expected, "if branch", br.line, br.col)
          ESym(_, _) -> check_expr_against(st, br, expected, "if branch", br.line, br.col)
          _ -> synth(st, br)
        }
        EName(_) -> check_expr_against(st, br, expected, "if branch", br.line, br.col)
        ESym(_, _) -> check_expr_against(st, br, expected, "if branch", br.line, br.col)
        _ -> if is_record_lit(te) { check_expr_against(st, br, expected, "if branch", br.line, br.col) } else { synth(st, br) }
      }
      None -> synth(st, br)
    }
    _ -> synth_expecting(st, br, expected)
  }
}


# route an expression through `check_match` when its
# AST head is `EMatch`, otherwise fall back to synth. The post-hoc
# unify in the caller (`infer_decl`, `synth_stmt` for SLet) handles
# the non-match case; for match the propagation already happened
# inside `check_match`.
# extends to `EIf` via `check_if`.
fn check_expr_against(st: InferState, e: Expr, expected: Ty,
                      what: String, line: Int, col: Int) : Inferred / Console + File + Mutable {


  match e.kind {
    EMatch(scr, arms) -> check_match(st, scr, arms, expected, e.line, e.col)
    EIf(c, t_, eo)    -> check_if(st, c, t_, eo, expected, e.line, e.col)
    # Fix B: bidirectional list literals. When the typer expects
    # `[T]`, propagate `T` to each element. Specifically lets
    # `let bs: [Byte] = [65, 66]` work — Int literals get rewritten
    # to Byte literals (range-checked 0..255) when the expected
    # element type is TyByte.
    EList(els) -> match apply_ty(st.sub, expected) {
      TyListT(elem_ty) -> check_list_elems_against(st, els, elem_ty, e.line, e.col)
      # Vec-context minting (the #1091 shape for containers): the
      # literal builds a pre-sized vec instead of a cons list. A BARE
      # literal keeps denoting the cons list — only annotation /
      # argument context reaches here.
      TyCon(tcs, hargs) ->
        if core_ty_is(tcs, CtVec) { check_vec_lit_against(st, els, hargs, e.line, e.col) }
        else { synth(st, e) }
      # Fixed-width Vec context: `Vec[T]<k>` fixes the literal's
      # length by its habitant.
      TyDimT(inner, u) -> match inner {
        TyCon(tcs, hargs) ->
          if core_ty_is(tcs, CtVec) { check_fixed_vec_lit(st, els, hargs, u, e.line, e.col) }
          else { synth(st, e) }
        _ -> synth(st, e)
      }
      _                -> synth(st, e)
    }
    # Vec-context pipeline collect: a map-pipe chain in Vec-expected
    # position collects into a vec. Pure range-headed chains rewrite to
    # the pre-sized collect combinator (one buffer, zero intermediates);
    # anything else materialises once through `vec_from_list`.
    EDispatchPipe(PoMap, _, _) -> {
      let exp = apply_ty(st.sub, expected)
      if ty_is_fixed_vec(exp) { check_map_pipe_fixed_collect(st, e, exp, e.line, e.col) }
      else if ty_is_vec_head(exp) { check_map_pipe_vec_collect(st, e, e.line, e.col) }
      else { synth(st, e) }
    }
    # annotation-driven ctor disambiguation. When
    # the expected type is a sum and the callee is a bare
    # `EName(cname)` that names one of its constructors,
    # rewrite the callee to that constructor so the core's
    # same-named one never wins. Falls through to synth otherwise.
    ECall(callee, args_) ->
      ctor_coerce_expected(ctor_check_or_synth(st, e, callee, args_, expected, line, col), expected)
    # nullary ctor disambiguation. A bare
    # `EName(cname)` (e.g. `NotFound`) in annotation context that
    # names a constructor of the expected sum picks its scheme.
    EName(_) -> nullary_ctor_check_or_synth(st, e, expected)
    ESym(_, _) -> nullary_ctor_check_or_synth(st, e, expected)
    # A record literal's head is asked of the expected type first.
    ERecordLit(rh, fis) -> synth_record_lit(st, rh, fis, expected, e.line, e.col)
    # thread expected into block tails so a
    # `{ ...stmts...; ctor(args) }` body benefits from the same
    # annotation-driven disambiguation as a bare ctor expression.
    EBlock(stmts, tail) -> match tail {
      Some(te) -> {
        let outer = st
        let is_ = synth_stmts(st, stmts)
        let r = check_expr_against(is_.st, te, expected, what, te.line, te.col)
        let st2 = st_restore_entries(outer, r.st)
        let ty = apply_ty(st2.sub, r.ty)
        let root = with_ty(mk_expr(EBlock(is_.stmts, Some(r.expr)), e.line, e.col), ty)
        mk_inferred(st2, ty, root)
      }
      None -> synth(st, e)
    }
    _ -> synth(st, e)
  }
}


# A bare constructor call under an expected type that declares the
# constructor is rewritten to a call of that constructor: the
# expected type names the sum, so a same-named one never wins (a user
# variant may shadow `Result.Ok` / `Option.Some`).
fn ctor_check_or_synth(st: InferState, e: Expr, callee: Expr, args_: [Expr],
                          expected: Ty, line: Int, col: Int) : Inferred / Console + File + Mutable =
  match callee.kind {
    EName(w) -> match settle_name(st, None, w, expected, []) {
      SetOne(c) -> synth(st, mk_expr(ECall(mk_sym(c, callee.line, callee.col), args_), line, col))
      _         -> synth(st, e)
    }
    _ -> synth(st, e)
  }


# A bare nullary constructor under an expected type that declares it
# reads that declaration's scheme.
fn nullary_ctor_check_or_synth(st: InferState, e: Expr, expected: Ty) : Inferred / Console + File + Mutable =
  match e.kind {
    EName(w) -> match typed_ctor_entry(st, w, expected) {
      Some(CtorPick(c, entry)) -> synth_scheme_read(st, entry.scheme, c, mk_sym(c, e.line, e.col))
      None                     -> synth(st, e)
    }
    _ -> synth(st, e)
  }


# `[e1, ..., en]` under a `Vec[T]` expectation: coin numeric elements
# against `T` (the #1091 lattice), check the rest against `T` (Byte
# retag included), then hand the TYPED elements to the typed chain
# build — never re-synthesised, so retags survive. The caller's
# trailing unify confirms the result against the annotation. Spread
# elements have no vec build; they are rejected here.
fn check_vec_lit_against(st: InferState, els: [ListElem], hargs: [Ty],
                         line: Int, col: Int) : Inferred / Console + File + Mutable {
  if vec_lit_has_spread(els) {
    let perr = mk_diag(SevError, st.file, line, col, "spread elements are not supported in a Vec literal", [])
    render_diag(perr)
    diag_help("build the list first and convert it: `vec_from_list([...xs, y])`")
    let r = synth(st_bump_err(st_push_diag(st, perr)), mk_expr(EList(els), line, col))
    r
  } else {
    let elem_exp = match hargs { [t] -> apply_ty(st.sub, t)  _ -> TyAny }
    let checked = check_vec_elems(st, els, elem_exp, line, col, [])
    let vty = core_ty_con(CtVec, [apply_ty(checked.st.sub, elem_exp)])
    mk_inferred(checked.st, vty, vec_lit_build(list_reverse(checked.elems), vty, line, col))
  }
}


# `[e1, ..., en]` under a `Vec[T]<k>` expectation: the habitant IS
# the length. A known value index must equal the element count; an
# unbound index variable brands the literal with its own length and
# the caller's trailing unify binds it (the kind gate rejects a
# non-`Dim` variable there). A habitant that is no `Int` value index
# cannot fix a length — the carrier guard at the formation site.
fn check_fixed_vec_lit(st: InferState, els: [ListElem], hargs: [Ty], u: UnitExprT,
                       line: Int, col: Int) : Inferred / Console + File + Mutable {
  let r = check_vec_lit_against(st, els, hargs, line, col)
  let hab = apply_unit(r.st.sub, u)
  let n = list_length(els)
  match fixed_vec_hab(hab, n) {
    FVOk(h) -> {
      let bty = TyDimT(r.ty, h)
      if ty_is_fixed_vec(bty) { fixed_vec_lit_inferred(r, els, hargs, bty, line, col) }
      else { brand_vec_lit(r, h) }
    }
    FVLen(k) -> {
      let perr = mk_diag(SevError, r.st.file, line, col,
        concat_all(["vector literal has ", int_to_string(n), " elements, but its type fixes the length to ", int_to_string(k)]), [])
      render_diag(perr)
      brand_vec_lit(mk_inferred(st_bump_err(st_push_diag(r.st, perr)), r.ty, r.expr), hab)
    }
    FVCarrier -> {
      let perr = mk_diag(SevError, r.st.file, line, col,
        concat_all(["`", inf_unit_canon_display(hab), "` cannot fix a `Vec` length — the index of a fixed-width `Vec` is an `Int` value habitant (`Dim`)"]), [])
      render_diag(perr)
      brand_vec_lit(mk_inferred(st_bump_err(st_push_diag(r.st, perr)), r.ty, r.expr), hab)
    }
  }
}


# A concrete `Vec[e]<n>` literal builds the fixed inline representation:
# the elements are re-checked (already coined once, so this only re-reads
# the typed forms) and handed to the `__fixed_vec_lit` intrinsic the C
# emitter lowers to a flat `(cname){ .a = {...} }` aggregate. The node is
# MUnboxed — a fixed vec has no boxed form.
fn fixed_vec_lit_inferred(r: Inferred, els: [ListElem], hargs: [Ty], bty: Ty,
                          line: Int, col: Int) : Inferred / Console + File + Mutable {
  let elem_exp = match hargs { [t] -> apply_ty(r.st.sub, t)  _ -> TyAny }
  let checked = check_vec_elems(r.st, els, elem_exp, line, col, [])
  let call = fixed_vec_lit_build(list_reverse(checked.elems), bty, line, col)
  mk_inferred(checked.st, bty, unboxed_expr(call))
}


fn check_vec_elems(st: InferState, els: [ListElem], elem_ty: Ty,
                   line: Int, col: Int, acc: [Expr]) : VecElems / Console + File + Mutable =
  match els {
    [] -> VecElems { st: st, elems: acc }
    [el, ...rest] -> match el {
      ElPlain(ex) -> match mint_literal(ex, apply_ty(st.sub, elem_ty), mint_bigint_home(st.env)) {
        MintOk(m) -> check_vec_elems(st, rest, elem_ty, line, col, [m, ...acc])
        MintErr(msg) -> {
          let perr = mk_diag(SevError, st.file, ex.line, ex.col, msg, [])
          render_diag(perr)
          check_vec_elems(st_bump_err(st_push_diag(st, perr)), rest, elem_ty, line, col, [ex, ...acc])
        }
        MintNone -> {
          let r = check_elem_against(st, ex, apply_ty(st.sub, elem_ty), line, col)
          check_vec_elems(r.st, rest, elem_ty, line, col, [r.expr, ...acc])
        }
      }
      ElSpread(ex) -> check_vec_elems(st, rest, elem_ty, line, col, [ex, ...acc])
    }
  }


# A Vec-typed map-pipe chain. Pure stages over a range head collect
# into ONE pre-sized buffer (`range_map_collect_vec`); an impure stage
# or a non-range source keeps the ordinary list pipeline and converts
# once via `vec_from_list` — same semantics, one materialisation.
fn check_map_pipe_vec_collect(st: InferState, e: Expr,
                              line: Int, col: Int) : Inferred / Console + File + Mutable =
  match pipe_fusion_as_collect(e) {
    None -> synth(st, e)
    Some(fc) -> {
      let g = fuse_all_raw(st, fc.stages, false)
      if g.ok {
        match pipe_fusion_collect_rewrite(fc, line, col) {
          Some(rewritten) -> match fuse_source_peek(g.st, fc.source) {
            FSP(s, _, true)  -> synth(s, vec_collect_via_list(e, line, col))
            FSP(s, _, false) -> synth(s, rewritten)
          }
          None -> synth(g.st, vec_collect_via_list(e, line, col))
        }
      } else { synth(g.st, vec_collect_via_list(e, line, col)) }
    }
  }


# A map-pipe chain in a `Vec[e]<n>` slot: a fixed vec has no runtime
# length, so the chain may only collect there when its length is proved
# HERE. A map is 1:1, so the length is the source's — provable for a
# literal head (`[a, b, c] | f`), where the chain unrolls to one literal
# of per-element stage applications and rides the fixed-vec literal path.
# Any other head has a statically-unknown length and is declined loudly,
# never silently collected into a wrong-length aggregate.
fn check_map_pipe_fixed_collect(st: InferState, e: Expr, expected: Ty,
                                line: Int, col: Int) : Inferred / Console + File + Mutable =
  match pipe_fusion_as_collect(e) {
    None -> synth(st, e)
    Some(fc) -> match fixed_collect_unroll(fc, line, col) {
      Some(unrolled) -> check_expr_against(st, unrolled, expected, "fixed-width vector collect", line, col)
      None -> {
        let perr = mk_diag(SevError, st.file, line, col,
          concat_all(["a `|` chain cannot collect into a fixed-width `Vec[t]<",
            int_to_string(fixed_vec_n(expected)),
            ">`: its length is not known at compile time"]), [])
        render_diag(perr)
        diag_help("start the chain from a vector literal, or collect into a dynamic `Vec` first")
        mk_inferred(st_bump_err(st_push_diag(st, perr)), expected, with_ty(e, expected))
      }
    }
  }


fn check_list_elems_against(st: InferState, els: [ListElem], elem_ty: Ty,
                            line: Int, col: Int) : Inferred / Console + File + Mutable {


  let acc = check_list_elems_loop(st, els, elem_ty, line, col, [])
  let ty = TyListT(elem_ty)
  let root = with_ty(mk_expr(EList(list_reverse(acc.elems)), line, col), ty)
  mk_inferred(acc.st, ty, root)
}


fn check_list_elems_loop(st: InferState, els: [ListElem], elem_ty: Ty,
                         line: Int, col: Int, acc: [ListElem]) : InferredElems / Console + File + Mutable {


  match els {
    [] -> InferredElems { st: st, elems: acc }
    [el, ...rest] -> match el {
      ElPlain(ex) -> {
        let r = check_elem_against(st, ex, elem_ty, line, col)
        check_list_elems_loop(r.st, rest, elem_ty, line, col, [ElPlain(r.expr), ...acc])
      }
      ElSpread(ex) -> {
        let r = synth(st, ex)
        let s1 = st_unify(r.st, TyListT(elem_ty), r.ty, "list spread", line, col)
        check_list_elems_loop(s1, rest, elem_ty, line, col, [ElSpread(r.expr), ...acc])
      }
    }
  }
}


fn check_elem_against(st: InferState, ex: Expr, elem_ty: Ty,
                      line: Int, col: Int) : Inferred / Console + File + Mutable {


  match elem_ty {
    TyByte -> match ex.kind {
      EInt(n, _) -> if n >= 0 and n <= 255 {
        let retagged = with_ty(mk_expr(mk_int_synth(n), ex.line, ex.col), TyByte)
        mk_inferred(st, TyByte, retagged)
      } else {
        let r = synth(st, ex)
        let s1 = st_unify(r.st, elem_ty, r.ty, "Byte literal out of range 0..255", line, col)
        mk_inferred(s1, elem_ty, r.expr)
      }
      _ -> elem_synth_unify(st, ex, elem_ty, line, col)
    }
    # A list literal against a Vec-typed element (a fixed-width
    # matrix row) re-enters the bidirectional path, so the inner
    # literal builds a vec and its length habitant binds.
    _ -> match ex.kind {
      EList(_) ->
        if ty_vec_headed(elem_ty) {
          let r = check_expr_against(st, ex, elem_ty, "list element", ex.line, ex.col)
          let s1 = st_unify(r.st, elem_ty, r.ty, "list element", line, col)
          mk_inferred(s1, apply_ty(s1.sub, r.ty), r.expr)
        } else { elem_synth_unify(st, ex, elem_ty, line, col) }
      _ -> elem_synth_unify(st, ex, elem_ty, line, col)
    }
  }
}


fn elem_synth_unify(st: InferState, ex: Expr, elem_ty: Ty,
                    line: Int, col: Int) : Inferred / Console + File + Mutable {
  let r0 = synth_expecting(st, ex, elem_ty)
  let r = if not (rc_mentions(elem_ty) or rc_mentions_in(r0.st.sub, r0.ty)) { r0 } else {
    let m = refine_coerce(MintedExpr { st: r0.st, pair: ExprTy { expr: r0.expr, ty: r0.ty } }, elem_ty, "list element", ex.line, ex.col)
    mk_inferred(m.st, m.pair.ty, m.pair.expr)
  }
  let s1 = st_unify(r.st, elem_ty, r.ty, "list element", line, col)
  mk_inferred(s1, elem_ty, r.expr)
}


# same idea but threaded through an EBlock when the tail
# is itself an EMatch. The fn-body case `fn f(...) : T = match { ... }`
# parses as a bare EMatch (handled by `check_expr_against`), but
# `fn f(...) : T { ...stmts... match { ... } }` parses as an EBlock
# whose tail is an EMatch — synth_block ignores the expected type, so
# we recreate just enough of synth_block here to route the tail
# through check_match while the prefix stmts still synth normally.
# A dimensioned literal body coins to the declared carrier, as it does
# under a `let` annotation or in an argument slot.
fn check_literal_against(st: InferState, body: Expr, expected: Ty,
                         line: Int, col: Int) : Inferred / Console + File + Mutable {
  let r = synth(st, body)
  let m = maybe_mint_literal(r.st, r.expr, r.ty, apply_ty(r.st.sub, expected), line, col)
  mk_inferred(m.st, m.pair.ty, m.pair.expr)
}


#[doc("Typer-internal helper `check_body_against_ret` shared across the infer modules.")]
pub fn check_body_against_ret(st: InferState, body: Expr, expected: Ty,
                          what: String, line: Int, col: Int) : Inferred / Console + File + Mutable {


  match body.kind {
    EMatch(scr, arms) -> check_match(st, scr, arms, expected, body.line, body.col)
    EIf(c, t_, eo)    -> check_if(st, c, t_, eo, expected, body.line, body.col)
    ELitUnit(_, _)    -> check_literal_against(st, body, expected, line, col)
    EBlock(stmts, tail) -> match tail {
      Some(te) -> match te.kind {
        EMatch(scr, arms) -> {
          let outer = st
          let is_ = synth_stmts(st, stmts)
          let r = check_match(is_.st, scr, arms, expected, te.line, te.col)
          let st2 = st_restore_entries(outer, r.st)
          let ty = apply_ty(st2.sub, r.ty)
          let root = with_ty(mk_expr(EBlock(is_.stmts, Some(r.expr)), body.line, body.col), ty)
          mk_inferred(st2, ty, root)
        }
        EIf(c, t_, eo) -> {
          let outer = st
          let is_ = synth_stmts(st, stmts)
          let r = check_if(is_.st, c, t_, eo, expected, te.line, te.col)
          let st2 = st_restore_entries(outer, r.st)
          let ty = apply_ty(st2.sub, r.ty)
          let root = with_ty(mk_expr(EBlock(is_.stmts, Some(r.expr)), body.line, body.col), ty)
          mk_inferred(st2, ty, root)
        }
        # thread `expected` into the block tail
        # when the tail is a bare ctor reference (a call, or a name
        # the resolver left written), so annotation-driven
        # disambiguation can pick a user variant over the core builtin. Other
        # tail shapes keep synthing the whole body as before to avoid
        # regressions in non-ctor expression types.
        ECall(_, _) -> check_block_tail(st, stmts, te, expected, what, body)
        EName(_)    -> check_block_tail(st, stmts, te, expected, what, body)
        _ -> if is_record_lit(te) { check_block_tail(st, stmts, te, expected, what, body) } else { synth(st, body) }
      }
      None -> synth(st, body)
    }
    # bare-expression body benefits from
    # annotation-driven ctor disambiguation when it is a ctor call
    # or a nullary ctor reference. Other shapes stay on synth to
    # avoid regressing existing inference paths.
    ECall(_, _) -> check_expr_against(st, body, expected, what, body.line, body.col)
    EName(_) -> check_expr_against(st, body, expected, what, body.line, body.col)
    ESym(_, _) -> check_expr_against(st, body, expected, what, body.line, body.col)
    _ -> synth_expecting(st, body, expected)
  }
}


# The block `{ stmts; te }` with its tail checked against `expected`.
fn check_block_tail(st: InferState, stmts: [Stmt], te: Expr, expected: Ty,
                    what: String, body: Expr) : Inferred / Console + File + Mutable = {
  let is_ = synth_stmts(st, stmts)
  let r = check_expr_against(is_.st, te, expected, what, te.line, te.col)
  let st2 = st_restore_entries(st, r.st)
  let ty = apply_ty(st2.sub, r.ty)
  mk_inferred(st2, ty, with_ty(mk_expr(EBlock(is_.stmts, Some(r.expr)), body.line, body.col), ty))
}


fn synth_arms(st: InferState, arms: [Arm], scrut_ty: Ty, body_ty: Ty, line: Int, col: Int) : InferredArms / Console + File + Mutable {


  match arms {
    [] -> InferredArms { st: st, arms: [] }
    [a, ...rest] -> match a {
      Arm(pat, guard, body) -> {
        let outer = st
        let pc = check_pattern_stamped(st, pat, scrut_ty)
        let s_p = pc.st
        let guard_res = match guard {
          None -> InferredOptExpr { st: s_p, expr: None }
          Some(gx) -> {
            let rg = synth(s_p, gx)
            let s_g = st_unify(rg.st, rg.ty, TyBool, "match guard", gx.line, gx.col)
            InferredOptExpr { st: s_g, expr: Some(rg.expr) }
          }
        }
        let rb = synth(guard_res.st, body)
        let s_b = st_unify(rb.st, body_ty, rb.ty, "match arm", body.line, body.col)
        let s_scoped = st_restore_entries(outer, s_b)
        let rr = synth_arms(s_scoped, rest, scrut_ty, body_ty, line, col)
        InferredArms { st: rr.st, arms: [Arm(pc.pat, guard_res.expr, rb.expr), ...rr.arms] }
      }
    }
  }
}

# ---- per-decl entry + dumper ----


# A contract predicate is synthesised against an empty row, so what it
# performs is its own and not hidden by the enclosing body's effects.
fn synth_assert_cond(st: InferState, cond: Expr, kind: Option[ContractKind]) : Inferred / Console + File + Mutable =
  match kind {
    None    -> synth(st, cond)
    Some(k) -> {
      let r = synth(InferState { ...st, row: [], eff_uses: [] }, cond)
      let st1 = reject_predicate_effect(r.st, contract_kind_word(k), r.st.row, cond)
      Inferred { st: InferState { ...st1, row: st.row, eff_uses: st.eff_uses }, ty: r.ty, expr: r.expr }
    }
  }

