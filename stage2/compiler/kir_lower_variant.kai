# compiler/kir_lower_variant.kai — which sub-patterns discriminate.
#
# The variant path of `lower_match` switches on the scrutinee's top-level
# tag. Two arms sharing a tag (`Exited(0)` / `Exited(_)`) must still test
# their payload, so the arms of one tag are grouped into a fail chain whose
# per-arm tests come from `kir_lower_ptest`. This module answers the
# question both need: does a sub-pattern carry a test the tag does not?

import compiler.ast

#[doc("Whether a sub-pattern carries a test: a literal, a constructor, a list, or a record or tuple with a discriminating field.")]
pub fn psub_is_discriminating(p: Pattern) : Bool = match p.pkind {
  PLit(_)                 -> true
  PVariant(_, _, _)       -> true
  PVariantRecord(_, _, _) -> true
  PList(_, _)             -> true
  PRecord(fields)         -> any_field_discriminating(fields)
  PAs(_, inner)           -> psub_is_discriminating(inner)
  _                       -> false
}

#[doc("Whether a variant arm tests nothing beyond its tag (`Exited(_)`), ending its tag's sub-chain.")]
pub fn var_arm_is_tag_catchall(p: Pattern) : Bool = match p.pkind {
  PVariant(_, _, subs)         -> not any_discriminating(subs)
  PVariantRecord(_, _, fields) -> not any_field_discriminating(fields)
  PAs(_, inner)                -> var_arm_is_tag_catchall(inner)
  _                            -> true
}

#[doc("Whether any of the sub-patterns discriminates.")]
pub fn any_discriminating(subs: [Pattern]) : Bool = match subs {
  [] -> false
  [sp, ...rest] -> if psub_is_discriminating(sp) { true } else { any_discriminating(rest) }
}

#[doc("Whether any field's sub-pattern discriminates.")]
pub fn any_field_discriminating(fields: [PField]) : Bool = match fields {
  [] -> false
  [PField(_, sub, _), ...rest] ->
    if psub_is_discriminating(sub) { true } else { any_field_discriminating(rest) }
}
