# compiler/const_scope_table.kai — the const collision table and the
# ownership rule const_scope applies to each read.
#
# A `const` name is not a package-global. The value env registers the
# bare name once per declaration, so two homonymous consts in
# different modules shadow each other by load order. Same defect the
# transparent-alias table had (ta_scope); same cure: the module key.
# Only names in collision (declared in two or more homes) enter the
# table, so a package without homonymous consts is untouched.

import compiler.ast
import compiler.modules

#[doc("A colliding const's identity: `CSE(name, home, pub)`. Root consts carry the target module as home.")]
pub type CSEntry = CSE(String, String, Bool)

#[doc("Per-decl rewrite context: the collision table, the reading decl's home, and the root module name. `free` off restricts the walk to qualified reads (the interp lift keys those before rqc; free reads wait for the scope-aware rerun). `mt` maps a written qualifier to its tagged module name — empty when the stream's qualifiers are already tagged.")]
pub type CSCtx = { coll: [CSEntry], home: String, target: String,
                   free: Bool, mt: [ModuleEntry] }

#[doc("The consts of `decls` whose name another home also declares, in stream order. `target` is the root file's module name.")]
pub fn cs_collect_table(decls: [Decl], target: String) : [CSEntry] = {
  let table = cs_collect(decls, target, target, [])
  cs_colliding(table, table, [])
}

fn cs_collect(ds: [Decl], cur: String, target: String,
      acc: [CSEntry]) : [CSEntry] = match ds {
  [] -> list_reverse(acc)
  [d, ...rest] ->
    cs_collect(rest, cs_reader_home(d, cur, target), target,
               cs_collect_one(d, target, acc))
}

fn cs_collect_one(d: Decl, target: String, acc: [CSEntry]) : [CSEntry] =
  match d {
    DConst(p, n, _, _, mo, _, _) -> {
      let home = match mo { Some(m) -> m  None -> target }
      [CSE(n, home, p), ...acc]
    }
    DDerive(_, inner, _, _)    -> cs_collect_one(inner, target, acc)
    DUnstable(inner, _, _)     -> cs_collect_one(inner, target, acc)
    DProtoLaws(_, inner, _, _, _) -> cs_collect_one(inner, target, acc)
    DImplAxiom(_, inner, _, _, _) -> cs_collect_one(inner, target, acc)
    DConstructor(inner, _, _)  -> cs_collect_one(inner, target, acc)
    DDoc(_, _, inner, _, _)    -> cs_collect_one(inner, target, acc)
    DAttr(_, inner, _, _)      -> cs_collect_one(inner, target, acc)
    _ -> acc
  }

# Entries whose name some other home also declares. Order of the
# stream is preserved so the foreign-pub pick stays first-match.
fn cs_colliding(all: [CSEntry], rest: [CSEntry], acc: [CSEntry]) : [CSEntry] =
  match rest {
    [] -> list_reverse(acc)
    [e, ...more] -> match e {
      CSE(n, h, _) ->
        cs_colliding(all, more,
                     if cs_other_home(all, n, h) { [e, ...acc] } else { acc })
    }
  }

fn cs_other_home(t: [CSEntry], name: String, home: String) : Bool = match t {
  [] -> false
  [CSE(n, h, _), ...rest] ->
    if n == name and h != home { true } else { cs_other_home(rest, name, home) }
}

#[doc("A decl's home for both reading and streaming: a DConst carries its own module_origin (None marks the root); everything else follows the streaming reset the privacy validator uses.")]
pub fn cs_reader_home(d: Decl, cur: String, target: String) : String = match d {
  DConst(_, _, _, _, mo, _, _) -> match mo { Some(m) -> m  None -> target }
  DDoc(_, _, inner, _, _) -> cs_reader_home(inner, cur, target)
  DAttr(_, inner, _, _)   -> cs_reader_home(inner, cur, target)
  _ -> decl_home_hint_reset(d, cur, target)
}

#[doc("The module that owns a read of `name` from the context's home: the reader's own const if it declares one, else the first exported const of another module. The root's consts are never a foreign pick — the root is not importable.")]
pub fn cs_owner(cx: CSCtx, name: String) : Option[String] =
  if cs_has_home(cx.coll, name, cx.home) { Some(cx.home) }
  else { cs_foreign_pub(cx.coll, name, cx.home, cx.target) }

fn cs_has_home(t: [CSEntry], name: String, home: String) : Bool = match t {
  [] -> false
  [CSE(n, h, _), ...rest] ->
    if n == name and h == home { true } else { cs_has_home(rest, name, home) }
}

fn cs_foreign_pub(t: [CSEntry], name: String, home: String,
      target: String) : Option[String] = match t {
  [] -> None
  [CSE(n, h, p), ...rest] ->
    if n == name and p and h != home and h != target { Some(h) }
    else { cs_foreign_pub(rest, name, home, target) }
}

#[doc("True when `home` declares a pub const `name` in the collision table.")]
pub fn cs_is_pub_const(t: [CSEntry], name: String, home: String) : Bool = match t {
  [] -> false
  [CSE(n, h, p), ...rest] ->
    if n == name and h == home and p { true }
    else { cs_is_pub_const(rest, name, home) }
}
