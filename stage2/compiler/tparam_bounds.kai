#[doc("""
Decoding the protocol bounds a stored type parameter carries: the
parser packs `T: Show + Eq` as `T#b:Show,Eq`.
""")]

#[doc("True when the stored type parameter carries a `#b:` bound list.")]
pub fn tp_has_bounds(stored: String) : Bool = string_find(stored, "#b:") >= 0

#[doc("The stored type parameter without its `#b:` bound list.")]
pub fn tp_strip_bounds(stored: String) : String {
  let i = string_find(stored, "#b:")
  if i < 0 { stored } else { string_slice(stored, 0, i) }
}

#[doc("The protocol names of the stored type parameter's `#b:` bound list, in written order.")]
pub fn tp_bounds_of(stored: String) : [String] {
  let i = string_find(stored, "#b:")
  let n = string_length(stored)
  if i < 0 or i + 3 == n { [] }
  else { string_split(string_slice(stored, i + 3, n - i - 3), ",") }
}
