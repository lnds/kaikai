#[doc("""
The innermost typed node around a source position, for the type queries
of library mode.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_build
import compiler.ast_decl
import compiler.emit_shared_lams
import compiler.diag_type_text
import compiler.infer_env
import compiler.infer_program
import compiler.infer_state

#[doc("""
A query-friendly wrapper around the typed AST. `compile_to_module`
returns one of these; the queries below operate on it. Keeps only
what the queries need (file path + decls + module-table
placeholder).
""")]
pub(pkg) type TypedModule = { tm_file: String, tm_decls: [Decl] }

#[doc("""
Result of `enclosing_node` — carries the node kind name (so the
JSON consumer can branch without re-implementing the AST), the
start position, and (for type queries) the inferred type if any.
""")]
pub type EncResult = ER(String, Int, Int, Option[Ty])

# ---------------- innermost-enclosing walker ----------------
#
# `find_enc_*` walks the typed AST top-down. At each node we compare
# its start (line, col) against the query position. The returned
# value is the innermost (last-document-order) node whose start is
# ≤ pos. We do not need explicit end positions: the AST is built in
# document order, so the deepest node satisfying `start ≤ pos` is
# the innermost containing node for any well-formed source position.

fn enc_better(a: Option[EncResult], cl: Int, cc: Int, kind_name: String,
              ty: Option[Ty], ql: Int, qc: Int) : Option[EncResult] {
  if not pos_ge(ql, qc, cl, cc) { a }
  else {
    match a {
      None        -> Some(ER(kind_name, cl, cc, ty))
      Some(ER(_, al, ac, _)) ->
        if pos_ge(cl, cc, al, ac) { Some(ER(kind_name, cl, cc, ty)) }
        else { a }
    }
  }
}

fn find_enc_decls(ds: [Decl], ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match ds {
    []           -> acc
    [d, ...rest] -> find_enc_decls(rest, ql, qc, find_enc_decl(d, ql, qc, acc))
  }
}

fn find_enc_decl(d: Decl, ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match d {
    DFn(_, _, _, params, _, _, body, line, col, _) -> {
      let a1 = enc_better(acc, line, col, "DFn", None, ql, qc)
      let a2 = find_enc_params(params, ql, qc, a1)
      find_enc_expr(body, ql, qc, a2)
    }
    DConst(_, _, _, body, _, line, col, _, _) -> {
      let a1 = enc_better(acc, line, col, "DConst", None, ql, qc)
      find_enc_expr(body, ql, qc, a1)
    }
    DTest(_, body, line, col, _) -> {
      let a1 = enc_better(acc, line, col, "DTest", None, ql, qc)
      find_enc_expr(body, ql, qc, a1)
    }
    DBench(_, body, line, col, _) -> {
      let a1 = enc_better(acc, line, col, "DBench", None, ql, qc)
      find_enc_expr(body, ql, qc, a1)
    }
    DCheck(_, params, body, line, col, _) -> {
      let a1 = enc_better(acc, line, col, "DCheck", None, ql, qc)
      let a2 = find_enc_params(params, ql, qc, a1)
      find_enc_expr(body, ql, qc, a2)
    }
    DType(_, _, _, _, line, col, _, _) -> enc_better(acc, line, col, "DType", None, ql, qc)
    DImport(_, line, col)        -> enc_better(acc, line, col, "DImport", None, ql, qc)
    DEffect(_, _, _, _, _, line, col, _) -> enc_better(acc, line, col, "DEffect", None, ql, qc)
    DProtocol(_, _, _, _, line, col, _) -> enc_better(acc, line, col, "DProtocol", None, ql, qc)
    DImpl(_, _, _, decls, line, col, _, _) -> {
      let a1 = enc_better(acc, line, col, "DImpl", None, ql, qc)
      find_enc_decls(decls, ql, qc, a1)
    }
    DDerive(_, inner, line, col) -> {
      let a1 = enc_better(acc, line, col, "DDerive", None, ql, qc)
      find_enc_decl(inner, ql, qc, a1)
    }
    DUnstable(inner, line, col) -> {
      let a1 = enc_better(acc, line, col, "DUnstable", None, ql, qc)
      find_enc_decl(inner, ql, qc, a1)
    }
    DProtoLaws(_, inner, line, col, _) -> {
      let a1 = enc_better(acc, line, col, "DProtoLaws", None, ql, qc)
      find_enc_decl(inner, ql, qc, a1)
    }
    DImplAxiom(_, inner, line, col, _) -> {
      let a1 = enc_better(acc, line, col, "DImplAxiom", None, ql, qc)
      find_enc_decl(inner, ql, qc, a1)
    }
    DConstructor(inner, line, col) -> {
      let a1 = enc_better(acc, line, col, "DConstructor", None, ql, qc)
      find_enc_decl(inner, ql, qc, a1)
    }
    DUnit(_, _, _, _, line, col, _) -> enc_better(acc, line, col, "DUnit", None, ql, qc)
    DUse(_, line, col)        -> enc_better(acc, line, col, "DUse", None, ql, qc)
    DUseKind(_, line, col, _) -> enc_better(acc, line, col, "DUseKind", None, ql, qc)
    DAxiom(_, _, _, _, _, params, _, _, line, col) -> {
      let a1 = enc_better(acc, line, col, "DAxiom", None, ql, qc)
      find_enc_params(params, ql, qc, a1)
    }
    # Recurse into the documented decl; the module-doc carrier owns no
    # expressions or params to probe.
    DDoc(_, _, inner, line, col) -> {
      let a1 = enc_better(acc, line, col, "DDoc", None, ql, qc)
      find_enc_decl(inner, ql, qc, a1)
    }
    DAttr(_, inner, line, col) -> {
      let a1 = enc_better(acc, line, col, "DAttr", None, ql, qc)
      find_enc_decl(inner, ql, qc, a1)
    }
    DModuleDoc(_, _, line, col) -> enc_better(acc, line, col, "DModuleDoc", None, ql, qc)
    DExternType(_, _, _, line, col, _) -> enc_better(acc, line, col, "DExternType", None, ql, qc)
    DTheory(_, _, line, col, _) -> enc_better(acc, line, col, "DTheory", None, ql, qc)
    DKind(_, _, _, _, _, line, col, _) -> enc_better(acc, line, col, "DKind", None, ql, qc)
  }
}

fn find_enc_params(ps: [Param], ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match ps {
    []           -> acc
    [p, ...rest] -> {
      let a1 = enc_better(acc, p.pline, p.pcol, "Param", None, ql, qc)
      find_enc_params(rest, ql, qc, a1)
    }
  }
}

fn find_enc_expr(e: Expr, ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  let a0 = enc_better(acc, e.line, e.col, expr_kind_name(e.kind), e.ty, ql, qc)
  find_enc_expr_kind(e.kind, ql, qc, a0)
}

fn find_enc_expr_kind(k: ExprKind, ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match k {
    EInt(_, _)         -> acc
    EReal(_, _)        -> acc
    EIntLit(_)         -> acc
    EDecimalLit(_)     -> acc
    EFixed(_, _)       -> acc
    EBool(_)        -> acc
    EChar(_)        -> acc
    EStr(_, _)      -> acc
    EUnit           -> acc
    EName(_)         -> acc
    EMark(_)         -> acc
    ESym(_, _)       -> acc
    ELocal(_)        -> acc
    EOp(_)           -> acc
    EUnder          -> acc
    EPlaceholder    -> acc
    EHole(_)        -> acc
    ETodo(_)        -> acc
    EExternBody(_, _)  -> acc
    EModCall(_, _)  -> acc
    ECall(f, call_args)  -> {
      let a1 = find_enc_expr(f, ql, qc, acc)
      find_enc_exprs(call_args, ql, qc, a1)
    }
    EField(e1, _)   -> find_enc_expr(e1, ql, qc, acc)
    EIndex(e1, e2)  -> find_enc_expr(e2, ql, qc, find_enc_expr(e1, ql, qc, acc))
    EBinop(_, l, r) -> find_enc_expr(r, ql, qc, find_enc_expr(l, ql, qc, acc))
    EUnop(_, e1)    -> find_enc_expr(e1, ql, qc, acc)
    EIf(c, t, eo)   -> {
      let a1 = find_enc_expr(c, ql, qc, acc)
      let a2 = find_enc_expr(t, ql, qc, a1)
      match eo { None -> a2  Some(el) -> find_enc_expr(el, ql, qc, a2) }
    }
    EMatch(s, arms) -> {
      let a1 = find_enc_expr(s, ql, qc, acc)
      find_enc_arms(arms, ql, qc, a1)
    }
    ELambda(params, body) -> {
      let a1 = find_enc_params(params, ql, qc, acc)
      find_enc_expr(body, ql, qc, a1)
    }
    ERecordLit(_, fis) -> find_enc_field_inits(fis, ql, qc, acc)
    EList(elems)    -> find_enc_list_elems(elems, ql, qc, acc)
    ERange(a, b, so) -> {
      let a1 = find_enc_expr(a, ql, qc, acc)
      let a2 = find_enc_expr(b, ql, qc, a1)
      match so { None -> a2  Some(s) -> find_enc_expr(s, ql, qc, a2) }
    }
    EBlock(stmts, tail) -> {
      let a1 = find_enc_stmts(stmts, ql, qc, acc)
      match tail { None -> a1  Some(t) -> find_enc_expr(t, ql, qc, a1) }
    }
    EPipe(l, r)        -> find_enc_expr(r, ql, qc, find_enc_expr(l, ql, qc, acc))
    EDispatchPipe(_, l, r) -> find_enc_expr(r, ql, qc, find_enc_expr(l, ql, qc, acc))
    EBang(inner)       -> find_enc_expr(inner, ql, qc, acc)
    EHandle(body, _, _, init_opt, _, clauses, ret_opt) -> {
      let a1 = find_enc_expr(body, ql, qc, acc)
      let a2 = match init_opt { None -> a1  Some(i) -> find_enc_expr(i, ql, qc, a1) }
      let a3 = find_enc_hclauses(clauses, ql, qc, a2)
      match ret_opt {
        None              -> a3
        Some(HR(_, e1, line, col)) -> {
          let a4 = enc_better(a3, line, col, "HReturn", None, ql, qc)
          find_enc_expr(e1, ql, qc, a4)
        }
      }
    }
    ELitUnit(inner, _) -> find_enc_expr(inner, ql, qc, acc)
    EVariantsOf(_, _)  -> acc
    EIntrinsic(_, args_) -> find_enc_exprs(args_, ql, qc, acc)
    ESurface(sf) -> find_enc_exprs(surface_children(sf), ql, qc, acc)
  }
}

fn find_enc_exprs(es: [Expr], ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match es {
    []           -> acc
    [e, ...rest] -> find_enc_exprs(rest, ql, qc, find_enc_expr(e, ql, qc, acc))
  }
}

fn find_enc_arms(arms: [Arm], ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match arms {
    []           -> acc
    [a, ...rest] -> match a {
      Arm(pat, guard, body) -> {
        let a1 = find_enc_pattern(pat, ql, qc, acc)
        let a2 = match guard { None -> a1  Some(g) -> find_enc_expr(g, ql, qc, a1) }
        let a3 = find_enc_expr(body, ql, qc, a2)
        find_enc_arms(rest, ql, qc, a3)
      }
    }
  }
}

fn find_enc_pattern(p: Pattern, ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  let a0 = enc_better(acc, p.line, p.col, "Pattern", None, ql, qc)
  match p.pkind {
    PWild           -> a0
    PLit(e)         -> find_enc_expr(e, ql, qc, a0)
    PRange(lo, hi)  -> find_enc_expr(hi, ql, qc, find_enc_expr(lo, ql, qc, a0))
    PBind(_)        -> a0
    PList(subs, _)  -> find_enc_patterns(subs, ql, qc, a0)
    PVariant(_, subs) -> find_enc_patterns(subs, ql, qc, a0)
    PVariantRecord(_, fields) -> find_enc_pfields(fields, ql, qc, a0)
    PRecord(fields) -> find_enc_pfields(fields, ql, qc, a0)
    PHole(_)        -> a0
    PAs(_, inner)   -> find_enc_pattern(inner, ql, qc, a0)
    PNarrow(_, _)   -> a0
    PSurface(sp)    -> find_enc_patterns(patsurface_children(sp), ql, qc, a0)
  }
}

fn find_enc_patterns(ps: [Pattern], ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match ps {
    []           -> acc
    [p, ...rest] -> find_enc_patterns(rest, ql, qc, find_enc_pattern(p, ql, qc, acc))
  }
}

fn find_enc_pfields(fs: [PField], ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match fs {
    []           -> acc
    [f, ...rest] -> match f {
      PField(_, sub, _) -> find_enc_pfields(rest, ql, qc, find_enc_pattern(sub, ql, qc, acc))
    }
  }
}

fn find_enc_field_inits(fis: [FieldInit], ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match fis {
    []           -> acc
    [f, ...rest] -> match f {
      FI(_, e1) -> find_enc_field_inits(rest, ql, qc, find_enc_expr(e1, ql, qc, acc))
    }
  }
}

fn find_enc_list_elems(es: [ListElem], ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match es {
    []           -> acc
    [e, ...rest] -> match e {
      ElPlain(e1)  -> find_enc_list_elems(rest, ql, qc, find_enc_expr(e1, ql, qc, acc))
      ElSpread(e1) -> find_enc_list_elems(rest, ql, qc, find_enc_expr(e1, ql, qc, acc))
    }
  }
}

fn find_enc_stmts(ss: [Stmt], ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match ss {
    []           -> acc
    [s, ...rest] -> find_enc_stmts(rest, ql, qc, find_enc_stmt(s, ql, qc, acc))
  }
}

fn find_enc_stmt(s: Stmt, ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match s {
    SLet(pat, _, body)               -> find_enc_expr(body, ql, qc, find_enc_pattern(pat, ql, qc, acc))
    SAssert(e1, mo)                  -> {
      let a1 = find_enc_expr(e1, ql, qc, acc)
      match mo { None -> a1  Some(m) -> find_enc_expr(m, ql, qc, a1) }
    }
    SExprStmt(e1)                    -> find_enc_expr(e1, ql, qc, acc)
    SIndexAssign(arr, idx, v, _, _)  -> find_enc_expr(v, ql, qc,
                                          find_enc_expr(idx, ql, qc,
                                            find_enc_expr(arr, ql, qc, acc)))
    SAssign(lhs, v, _, _)            -> find_enc_expr(v, ql, qc,
                                          find_enc_expr(lhs, ql, qc, acc))
    SVar(_, _, init, line, col)      -> {
      let a1 = enc_better(acc, line, col, "SVar", None, ql, qc)
      find_enc_expr(init, ql, qc, a1)
    }
    SUse(_, line, col)               -> enc_better(acc, line, col, "SUse", None, ql, qc)
  }
}

fn find_enc_hclauses(cs: [HClause], ql: Int, qc: Int, acc: Option[EncResult]) : Option[EncResult] {
  match cs {
    []           -> acc
    [c, ...rest] -> match c {
      HC(_, params, body, line, col) -> {
        let a1 = enc_better(acc, line, col, "HClause", None, ql, qc)
        let a2 = find_enc_params(params, ql, qc, a1)
        let a3 = find_enc_expr(body, ql, qc, a2)
        find_enc_hclauses(rest, ql, qc, a3)
      }
    }
  }
}

#[doc("The innermost node of the typed module around the position.")]
pub(pkg) fn enclosing_node(tm: TypedModule, line: Int, col: Int) : Option[EncResult] =
  find_enc_decls(tm.tm_decls, line, col, None)

#[doc("The type of the innermost node around the position, when it carries one.")]
pub(pkg) fn type_at(tm: TypedModule, line: Int, col: Int) : Option[Ty] {
  match enclosing_node(tm, line, col) {
    None              -> None
    Some(ER(_, _, _, ty_opt)) -> ty_opt
  }
}

#[doc("""
Public entry point for in-process consumers (tests + cache
prototypes). Mirrors `compile_source` up through inference but
returns the typed module instead of an exit code. Errors are
folded into the returned module's decls just like a normal
infer_program run; consumers inspect `tm_decls` for emptiness.
""")]
pub(pkg) fn compile_to_module(file: String, decls: [Decl], tin: TyperIn) : TypedModule / Console + File + Mutable {
  let r = infer_program(file, decls, tin, false)
  TypedModule { tm_file: file, tm_decls: r.decls }
}

#[doc("Compare two (line, col) positions: a >= b in document order.")]
pub(pkg) fn pos_ge(al: Int, ac: Int, bl: Int, bc: Int) : Bool {
  if al > bl { true }
  else if al < bl { false }
  else { ac >= bc }
}

#[doc("""
A call's callee, the declaration whose body holds it, and where the
call starts; `CallAt` is the same call before its declaration is known.
""")]
pub(pkg) type EncCall = EC(Expr, Decl, Int, Int)
type CallAt = CA(Expr, Int, Int)

fn enc_call_in(d: Decl, body: Expr, ql: Int, qc: Int, acc: Option[EncCall]) : Option[EncCall] =
  match find_enc_call_expr(body, ql, qc, None) {
    None              -> acc
    Some(CA(f, l, c)) -> if enc_call_starts_after(acc, l, c) { Some(EC(f, d, l, c)) } else { acc }
  }

#[doc("The innermost call starting at or before the position, across the declarations.")]
pub(pkg) fn find_enc_call(ds: [Decl], ql: Int, qc: Int, acc: Option[EncCall]) : Option[EncCall] {
  match ds {
    []           -> acc
    [d, ...rest] -> find_enc_call(rest, ql, qc, find_enc_call_decl(d, ql, qc, acc))
  }
}

fn find_enc_call_decl(d: Decl, ql: Int, qc: Int, acc: Option[EncCall]) : Option[EncCall] {
  match d {
    DFn(_, _, _, _, _, _, body, _, _, _)    -> enc_call_in(d, body, ql, qc, acc)
    DConst(_, _, _, body, _, _, _, _, _)          -> enc_call_in(d, body, ql, qc, acc)
    DTest(_, body, _, _, _)                 -> enc_call_in(d, body, ql, qc, acc)
    DBench(_, body, _, _, _)                -> enc_call_in(d, body, ql, qc, acc)
    DCheck(_, _, body, _, _, _)             -> enc_call_in(d, body, ql, qc, acc)
    DImpl(_, _, _, inner, _, _, _, _)          -> find_enc_call(inner, ql, qc, acc)
    DDerive(_, inner, _, _)              -> find_enc_call_decl(inner, ql, qc, acc)
    DUnstable(inner, _, _)               -> find_enc_call_decl(inner, ql, qc, acc)
    DProtoLaws(_, inner, _, _, _)           -> find_enc_call_decl(inner, ql, qc, acc)
    DImplAxiom(_, inner, _, _, _)           -> find_enc_call_decl(inner, ql, qc, acc)
    DConstructor(inner, _, _)            -> find_enc_call_decl(inner, ql, qc, acc)
    _                                     -> acc
  }
}

fn find_enc_call_expr(e: Expr, ql: Int, qc: Int, acc: Option[CallAt]) : Option[CallAt] {
  # Start positions decide, not walk order: a desugared pipe's call
  # precedes its first argument in the walk but follows it in the source.
  # The callee's type is the signature; the call's own `ty` is its result.
  let a0 = match e.kind {
    ECall(callee, _) ->
      if pos_ge(ql, qc, e.line, e.col) and call_at_starts_after(acc, e.line, e.col) {
        Some(CA(callee, e.line, e.col))
      } else { acc }
    _ -> acc
  }
  find_enc_call_expr_kind(e.kind, ql, qc, a0)
}

fn enc_call_starts_after(acc: Option[EncCall], line: Int, col: Int) : Bool = match acc {
  None                 -> true
  Some(EC(_, _, l, c)) -> pos_ge(line, col, l, c)
}

fn call_at_starts_after(acc: Option[CallAt], line: Int, col: Int) : Bool = match acc {
  None              -> true
  Some(CA(_, l, c)) -> pos_ge(line, col, l, c)
}

fn find_enc_call_expr_kind(k: ExprKind, ql: Int, qc: Int, acc: Option[CallAt]) : Option[CallAt] {
  match k {
    ECall(f, call_args) -> {
      let a1 = find_enc_call_expr(f, ql, qc, acc)
      find_enc_call_exprs(call_args, ql, qc, a1)
    }
    EField(e1, _)   -> find_enc_call_expr(e1, ql, qc, acc)
    EIndex(e1, e2)  -> find_enc_call_expr(e2, ql, qc, find_enc_call_expr(e1, ql, qc, acc))
    EBinop(_, l, r) -> find_enc_call_expr(r, ql, qc, find_enc_call_expr(l, ql, qc, acc))
    EUnop(_, e1)    -> find_enc_call_expr(e1, ql, qc, acc)
    EIf(c, t, eo)   -> {
      let a1 = find_enc_call_expr(c, ql, qc, acc)
      let a2 = find_enc_call_expr(t, ql, qc, a1)
      match eo { None -> a2  Some(el) -> find_enc_call_expr(el, ql, qc, a2) }
    }
    EMatch(s, arms)       -> find_enc_call_arms(arms, ql, qc, find_enc_call_expr(s, ql, qc, acc))
    ELambda(_, body)      -> find_enc_call_expr(body, ql, qc, acc)
    EBlock(stmts, last)   -> {
      let a1 = find_enc_call_stmts(stmts, ql, qc, acc)
      match last { None -> a1  Some(e1) -> find_enc_call_expr(e1, ql, qc, a1) }
    }
    EPipe(l, r)           -> find_enc_call_expr(r, ql, qc, find_enc_call_expr(l, ql, qc, acc))
    _ -> acc
  }
}

fn find_enc_call_exprs(es: [Expr], ql: Int, qc: Int, acc: Option[CallAt]) : Option[CallAt] {
  match es {
    []           -> acc
    [e, ...rest] -> find_enc_call_exprs(rest, ql, qc, find_enc_call_expr(e, ql, qc, acc))
  }
}

fn find_enc_call_arms(arms: [Arm], ql: Int, qc: Int, acc: Option[CallAt]) : Option[CallAt] {
  match arms {
    []           -> acc
    [a, ...rest] -> match a {
      Arm(_, _, body) -> find_enc_call_arms(rest, ql, qc, find_enc_call_expr(body, ql, qc, acc))
    }
  }
}

fn find_enc_call_stmts(ss: [Stmt], ql: Int, qc: Int, acc: Option[CallAt]) : Option[CallAt] {
  match ss {
    []           -> acc
    [s, ...rest] -> find_enc_call_stmts(rest, ql, qc, find_enc_call_stmt(s, ql, qc, acc))
  }
}

fn find_enc_call_stmt(s: Stmt, ql: Int, qc: Int, acc: Option[CallAt]) : Option[CallAt] =
  match s {
    SLet(_, _, e)         -> find_enc_call_expr(e, ql, qc, acc)
    SExprStmt(e)          -> find_enc_call_expr(e, ql, qc, acc)
    SVar(_, _, e, _, _)   -> find_enc_call_expr(e, ql, qc, acc)
    _                      -> acc
  }
