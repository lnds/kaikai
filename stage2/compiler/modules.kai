#[doc("""
The qualified-call rewrite: a field access on an imported module becomes
a module call once the module table proves the qualifier names one, in
expressions and in patterns.
""")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.module_table
import compiler.written
import compiler.symtab
import compiler.modules_paths
import compiler.modules_binders
import compiler.refine_types

#[doc("One effect and its op names, as the `rqc` walk sees them.")]
pub type RqcFx = RqcFx(String, [String])

#[doc("The (effect, ops) table of a decl stream: what `Eff.op` can still mean when the module table loses the qualifier.")]
pub fn rqc_collect_fx(decls: [Decl], tab: SymTab) : [RqcFx] = match decls {
  [] -> []
  [d, ...rest] -> match d {
    DEffect(_, s, _, ops, _, _, _, _) ->
      [RqcFx(written_text(sym_name(tab, s)), rqc_fx_op_names(ops, [])), ...rqc_collect_fx(rest, tab)]
    _ -> rqc_collect_fx(rest, tab)
  }
}

fn rqc_fx_op_names(ops: [EffectOp], acc: [String]) : [String] = match ops {
  [] -> list_reverse(acc)
  [EffOp(n, _, _, _, _, _), ...rest] -> rqc_fx_op_names(rest, [n, ...acc])
}

fn rqc_fx_has_op(fx: [RqcFx], eff: String, op: String) : Bool = match fx {
  [] -> false
  [RqcFx(n, ops), ...rest] ->
    if n == eff { list_has(ops, op) or rqc_fx_has_op(rest, eff, op) }
    else { rqc_fx_has_op(rest, eff, op) }
}

#[doc("`ts` with the rewrite applied to their refinement predicates: each reads `self` and the `locals` in scope where the type is written.")]
pub fn rqc_tys(ts: [TypeExpr], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : [TypeExpr] / Console + File =
  if not tys_refined(ts) { ts }
  else { tys_with_preds(ts, rqc_expr_list(tys_preds(ts), ["self", ...locals], mt, fx, file)) }

#[doc("`rqc_tys` over one type.")]
pub fn rqc_ty(t: TypeExpr, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : TypeExpr / Console + File =
  match rqc_tys([t], locals, mt, fx, file) {
    [t1, ..._] -> t1
    []         -> t
  }

#[doc("`rqc_tys` over an optional annotation.")]
pub fn rqc_ty_opt(o: Option[TypeExpr], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : Option[TypeExpr] / Console + File = match o {
  None    -> None
  Some(t) -> Some(rqc_ty(t, locals, mt, fx, file))
}

#[doc("`ps` with the rewrite applied to the predicates of their annotations; a parameter's refinement may name any parameter of its list.")]
pub fn rqc_params(ps: [Param], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : [Param] / Console + File = {
  let ts = params_types(ps)
  if not tys_refined(ts) { ps }
  else { params_with_types(ps, rqc_tys(ts, list_append(locals, fn_param_names(ps)), mt, fx, file)) }
}

pub fn rqc_expr(e: Expr, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : Expr / Console + File =

  Expr { kind: rqc_kind(e, locals, mt, fx, file), line: e.line, col: e.col,
         ty: e.ty, mode: e.mode,  site: e.site }

#[doc("The error for `mod.fname` where the imported `mod` does not export `fname`; it lists what `mod` does export.")]
pub fn missing_export_msg(mod: String, fname: String, exports: [String]) : String =
  concat_all(["module '", mod, "' does not export '", fname, "'; available exports: ",
              mods_join_with(exports, ", ")])

# The habitant a three-segment path names, when it names one at all.
# Both guards are load-bearing: the leading segment must be an
# imported module and not a local, or `config.default.port` stops
# being a projection; the middle segment must be an uppercase export,
# or `user.address.city` does. The habitant comes back bare — the
# qualifier's only job was to say whose effect was meant.
fn rqc_habitant_qualifier(inner: Expr, mid: String, locals: [String],
                          mt: [ModuleEntry]) : Option[String] = match inner.kind {
  EName(w) -> {
    let mod = written_text(w)
    if list_has(locals, mod) { None }
    else if not name_starts_upper(mid) { None }
    else { match mt_lookup_member(mt, mod, mid) {
      Some(me) -> if me_has_export(me, mid) { Some(mid) } else { None }
      None -> None
    } }
  }
  _ -> None
}

fn rqc_kind(e: Expr, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : ExprKind / Console + File = match e.kind {
  EField(base, fname) -> rqc_field(e, base, fname, locals, mt, fx, file)
  # Scope-introducing shapes: lambda, match arms, handle, block.
  ELambda(params, body) ->
    ELambda(rqc_params(params, locals, mt, fx, file),
            rqc_expr(body, list_append(locals, fn_param_names(params)), mt, fx, file))
  EMatch(scrut, arms) ->
    EMatch(rqc_expr(scrut, locals, mt, fx, file),
           rqc_arms(arms, locals, mt, fx, file))
  EHandle(body, eff, ty_args, init_opt, alias_opt, clauses, ret_opt) -> {
    let body1 = rqc_expr(body, locals, mt, fx, file)
    let init_opt1 = rqc_expr_opt(init_opt, locals, mt, fx, file)
    let inner = rqc_alias_scope(alias_opt, locals)
    let clauses1 = rqc_hclauses(clauses, inner, mt, fx, file)
    EHandle(body1, eff, rqc_tys(ty_args, locals, mt, fx, file), init_opt1, alias_opt, clauses1, rqc_hreturn_opt(ret_opt, inner, mt, fx, file))
  }
  EBlock(stmts, opt_final) -> {
    # Scope grows monotonically through the block: each binding
    # statement adds to what the final expression sees.
    let res = rqc_block_stmts(stmts, locals, mt, fx, file, [])
    EBlock(res.stmts, rqc_expr_opt(opt_final, res.bound, mt, fx, file))
  }
  # Every other form recurses into its children under the same scope.
  EInt(_, _)        -> e.kind
  EReal(_, _)       -> e.kind
  EIntLit(_)        -> e.kind
  EDecimalLit(_)    -> e.kind
  EFixed(_, _)      -> e.kind
  EBool(_)       -> e.kind
  EChar(_)       -> e.kind
  EStr(_, _)     -> e.kind
  EUnit          -> e.kind
  EName(_)        -> e.kind
  EMark(_)        -> e.kind
  ESym(_, _)      -> e.kind
  ELocal(_)       -> e.kind
  EOp(_)          -> e.kind
  EUnder         -> e.kind
  EPlaceholder   -> e.kind
  EHole(_)       -> e.kind
  ETodo(_)       -> e.kind
  EExternBody(_, _) -> e.kind
  EVariantsOf(_, _) -> e.kind
  EModCall(_, _) -> e.kind
  EIntrinsic(name, args_) ->
    EIntrinsic(name, rqc_expr_list(args_, locals, mt, fx, file))
  ESurface(sf) ->
    ESurface(surface_rebuild(sf, rqc_expr_list(surface_children(sf), locals, mt, fx, file)))
  ECall(callee, args_) ->
    ECall(rqc_expr(callee, locals, mt, fx, file),
          rqc_expr_list(args_, locals, mt, fx, file))
  EIndex(a, b)         -> EIndex(rqc_expr(a, locals, mt, fx, file),
                                  rqc_expr(b, locals, mt, fx, file))
  EBinop(op, a, b)     -> EBinop(op, rqc_expr(a, locals, mt, fx, file),
                                      rqc_expr(b, locals, mt, fx, file))
  EUnop(op, x)         -> EUnop(op, rqc_expr(x, locals, mt, fx, file))
  EIf(c, t_, eo)       -> EIf(rqc_expr(c, locals, mt, fx, file),
                                rqc_expr(t_, locals, mt, fx, file),
                                rqc_expr_opt(eo, locals, mt, fx, file))
  ERecordLit(r, fs)    -> ERecordLit(r, rqc_fields_init(fs, locals, mt, fx, file))
  EList(els)           -> EList(rqc_list_elems(els, locals, mt, fx, file))
  ERange(a, b, opt_step) -> ERange(rqc_expr(a, locals, mt, fx, file),
                                     rqc_expr(b, locals, mt, fx, file),
                                     rqc_expr_opt(opt_step, locals, mt, fx, file))
  EPipe(a, b)          -> EPipe(rqc_expr(a, locals, mt, fx, file),
                                  rqc_expr(b, locals, mt, fx, file))
  EDispatchPipe(op, a, b) -> EDispatchPipe(op, rqc_expr(a, locals, mt, fx, file),
                                     rqc_expr(b, locals, mt, fx, file))
  ELitUnit(inner, u)   -> ELitUnit(rqc_expr(inner, locals, mt, fx, file), u)
  EBang(inner)         -> EBang(rqc_expr(inner, locals, mt, fx, file))
}

# Only `mod.name` is a rewrite candidate; every other receiver recurses
# with the same scope.
fn rqc_field(e: Expr, base: Expr, fname: String, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : ExprKind / Console + File = match base.kind {
  EName(w) -> rqc_qualified(e, base, w, fname, locals, mt, fx, file)
  # `m.E.op` — a module-qualified effect operation. The qualifier
  # names the effect's home; the operation itself dispatches on the
  # bare effect, so the rewrite drops the module and leaves the
  # two-segment shape every later pass already folds. A local
  # receiver never reaches here (its inner node is a projection),
  # which is what keeps `user.address.city` a projection.
  EField(inner, mid) -> match rqc_habitant_qualifier(inner, mid, locals, mt) {
    Some(hab) -> EField(mk_name(hab, base.line, base.col), fname)
    None -> EField(rqc_expr(base, locals, mt, fx, file), fname)
  }
  _ -> EField(rqc_expr(base, locals, mt, fx, file), fname)
}

# `name.fname` with a bare receiver. A local in scope makes it a record
# projection. `bit.<op>` is the dotted surface of the bit intrinsics: the
# method carries a leading underscore (`bit._and`) so a reserved word is
# never a field name, and joining the two gives the flat `bit_<op>`; an
# unknown one surfaces as an unbound identifier.
fn rqc_qualified(e: Expr, base: Expr, w: Written, fname: String, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : ExprKind / Console + File = {
  let name = written_text(w)
  if list_has(locals, name) { EField(rqc_expr(base, locals, mt, fx, file), fname) }
  else if name == "bit" { EName(written(string_concat("bit", fname))) }
  else {
    match mt_lookup_member_at(mt, name, fname, file, e.line, e.col) {
      Some(me) -> rqc_member(me, base, w, name, fname, locals, mt, fx, file)
      None     -> EField(rqc_expr(base, locals, mt, fx, file), fname)
    }
  }
}

# A member of the module `me` that `name` names. A qualified constructor
# keeps its module, so the qualifier the user wrote survives to the
# typer; a function carries the name the module actually exports, which
# may be the prefixed one (`list.take` for `list_take`).
fn rqc_member(me: ModuleEntry, base: Expr, w: Written, name: String, fname: String, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : ExprKind / Console + File =
  if name_starts_upper(fname) and me_has_export(me, fname) {
    EModCall(written(me_emit_name(mt, me, name)), written(fname))
  } else {
    match me_lookup_export(me, fname) {
      Some(actual) -> EModCall(written(me_emit_name(mt, me, name)), written(actual))
      None         -> rqc_unexported(base, w, name, fname, locals, mt, fx, file)
    }
  }

# The module table is consulted first. When it loses but an effect of
# the same name owns the op, the qualified name belongs to the effect
# class and is left to the typer. Otherwise it stays qualified so no
# pass reads `mod` as a value, and `missing_export` reports it.
fn rqc_unexported(base: Expr, w: Written, name: String, fname: String, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : ExprKind / Console + File =
  if rqc_fx_has_op(fx, name, fname) { EField(rqc_expr(base, locals, mt, fx, file), fname) }
  else { EModCall(w, written(fname)) }

# A handle's alias (`as name`) is visible only inside the clauses and
# the return clause; the body sees the original locals.
fn rqc_alias_scope(alias_opt: Option[Binder], locals: [String]) : [String] = match alias_opt {
  Some(a) -> [written_text(a.name), ...locals]
  None    -> locals
}

fn rqc_hreturn_opt(opt: Option[HReturn], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : Option[HReturn] / Console + File = match opt {
  None    -> None
  Some(r) -> Some(rqc_hreturn(r, locals, mt, fx, file))
}

fn rqc_expr_opt(opt: Option[Expr], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : Option[Expr] / Console + File = match opt {
  None    -> None
  Some(x) -> Some(rqc_expr(x, locals, mt, fx, file))
}

fn rqc_expr_list(es: [Expr], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : [Expr] / Console + File = match es {
  []           -> []
  [h, ...rest] -> [rqc_expr(h, locals, mt, fx, file), ...rqc_expr_list(rest, locals, mt, fx, file)]
}

fn rqc_fields_init(fs: [FieldInit], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : [FieldInit] / Console + File = match fs {
  []           -> []
  [h, ...rest] -> [rqc_field_init(h, locals, mt, fx, file), ...rqc_fields_init(rest, locals, mt, fx, file)]
}

fn rqc_field_init(fi: FieldInit, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : FieldInit / Console + File = match fi {
  FI(name, e) -> FI(name, rqc_expr(e, locals, mt, fx, file))
}

fn rqc_list_elems(els: [ListElem], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : [ListElem] / Console + File = match els {
  []           -> []
  [h, ...rest] -> [rqc_list_elem(h, locals, mt, fx, file), ...rqc_list_elems(rest, locals, mt, fx, file)]
}

fn rqc_list_elem(el: ListElem, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : ListElem / Console + File = match el {
  ElPlain(e)  -> ElPlain(rqc_expr(e, locals, mt, fx, file))
  ElSpread(e) -> ElSpread(rqc_expr(e, locals, mt, fx, file))
}

fn rqc_arms(arms: [Arm], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : [Arm] / Console + File = match arms {

  [] -> []
  [a, ...rest] -> [rqc_arm(a, locals, mt, fx, file), ...rqc_arms(rest, locals, mt, fx, file)]
}

fn rqc_arm(a: Arm, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : Arm / Console + File = match a {

  Arm(pat, opt_guard, body) -> {
    let inner = pat_binder_names(pat, locals)
    let guard1 = match opt_guard {
      Some(g) -> Some(rqc_expr(g, inner, mt, fx, file))
      None -> None
    }
    Arm(rqc_pat(pat, mt, file), guard1, rqc_expr(body, inner, mt, fx, file))
  }
}

# A qualified variant pattern is validated like a qualified ctor
# expression: the module must be imported and must export the ctor.
# The qualifier is rewritten to the module's tagged name so it keys
# the same way `EModCall` does.
fn rqc_pat(pat: Pattern, mt: [ModuleEntry], file: String) : Pattern / Console + File = match pat.pkind {

  PVariant(r, subs) -> {
    let r1 = rqc_pat_ref(r, mt, file, pat.line, pat.col)
    Pattern { pkind: PVariant(r1, rqc_pat_list(subs, mt, file)),
              line: pat.line, col: pat.col }
  }
  PVariantRecord(r, fs) -> {
    let r1 = rqc_pat_ref(r, mt, file, pat.line, pat.col)
    Pattern { pkind: PVariantRecord(r1, rqc_pfields(fs, mt, file)),
              line: pat.line, col: pat.col }
  }
  PRecord(fs) ->
    Pattern { pkind: PRecord(rqc_pfields(fs, mt, file)), line: pat.line, col: pat.col }
  PList(subs, rest) ->
    Pattern { pkind: PList(rqc_pat_list(subs, mt, file), rest),
              line: pat.line, col: pat.col }
  PAs(name, inner) ->
    Pattern { pkind: PAs(name, rqc_pat(inner, mt, file)), line: pat.line, col: pat.col }
  _ -> pat
}

fn rqc_pat_ref(r: DeclRef, mt: [ModuleEntry], file: String, line: Int, col: Int) : DeclRef / Console + File = match r {
  DrWritten(Some(q), n) -> match rqc_pat_qualifier(written_text(q), written_text(n), mt, file, line, col) {
    Some(q1) -> DrWritten(Some(written(q1)), n)
    None     -> DrWritten(None, n)
  }
  _ -> r
}

fn rqc_pat_qualifier(q: String, ctor: String, mt: [ModuleEntry], file: String, line: Int, col: Int) : Option[String] / Console + File =

  match mt_lookup_member_at(mt, q, ctor, file, line, col) {
    Some(me) ->
      if me_has_export(me, ctor) { Some(me_emit_name(mt, me, q)) } else { Some(q) }
    None -> Some(q)
  }

fn rqc_pat_list(ps: [Pattern], mt: [ModuleEntry], file: String) : [Pattern] / Console + File = match ps {

  [] -> []
  [p, ...rest] -> [rqc_pat(p, mt, file), ...rqc_pat_list(rest, mt, file)]
}

fn rqc_pfields(fs: [PField], mt: [ModuleEntry], file: String) : [PField] / Console + File = match fs {

  [] -> []
  [PField(n, sub, short), ...rest] ->
    [PField(n, rqc_pat(sub, mt, file), short), ...rqc_pfields(rest, mt, file)]
}

fn rqc_hclauses(cs: [HClause], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : [HClause] / Console + File =

  match cs {
    [] -> []
    [c, ...rest] -> [rqc_hclause(c, locals, mt, fx, file), ...rqc_hclauses(rest, locals, mt, fx, file)]
  }

fn rqc_hclause(c: HClause, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : HClause / Console + File = match c {

  HC(name, params, body, l, col) -> {
    let inner = list_append(locals, fn_param_names(params))
    HC(name, params, rqc_expr(body, inner, mt, fx, file), l, col)
  }
}

fn rqc_hreturn(r: HReturn, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : HReturn / Console + File = match r {

  HR(b, body, l, c) ->
    HR(b, rqc_expr(body, [written_text(b.name), ...locals], mt, fx, file), l, c)
}

# Stmt-walker: threads the scope through a block's statement list.
# `bound` accumulates the local names introduced so far; the final
# expression after the last SExprStmt sees the full bound set.
type RqcStmtsAcc = { stmts: [Stmt], bound: [String] }

fn rqc_block_stmts(stmts: [Stmt], locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String, acc_stmts: [Stmt]) : RqcStmtsAcc / Console + File =

  match stmts {
    [] -> RqcStmtsAcc { stmts: list_reverse(acc_stmts), bound: locals }
    [s, ...rest] -> {
      let r = rqc_stmt(s, locals, mt, fx, file)
      rqc_block_stmts(rest, r.bound, mt, fx, file, [r.s, ...acc_stmts])
    }
  }

type RqcStmtR = { s: Stmt, bound: [String] }

fn rqc_stmt(s: Stmt, locals: [String], mt: [ModuleEntry], fx: [RqcFx], file: String) : RqcStmtR / Console + File = match s {

  SLet(pat, ty_opt, e) -> {
    # The RHS evaluates under the *outer* scope; bindings from `pat`
    # only become visible to subsequent stmts.
    let e1 = rqc_expr(e, locals, mt, fx, file)
    let inner = pat_binder_names(pat, locals)
    RqcStmtR { s: SLet(rqc_pat(pat, mt, file), rqc_ty_opt(ty_opt, locals, mt, fx, file), e1), bound: inner }
  }
  SAssert(e, opt_msg) -> {
    let e1 = rqc_expr(e, locals, mt, fx, file)
    let m1 = match opt_msg {
      Some(m) -> Some(rqc_expr(m, locals, mt, fx, file))
      None -> None
    }
    RqcStmtR { s: SAssert(e1, m1), bound: locals }
  }
  SExprStmt(e) ->
    RqcStmtR { s: SExprStmt(rqc_expr(e, locals, mt, fx, file)), bound: locals }
  SIndexAssign(target, ix, v, l, c) -> {
    let t1 = rqc_expr(target, locals, mt, fx, file)
    let i1 = rqc_expr(ix, locals, mt, fx, file)
    let v1 = rqc_expr(v, locals, mt, fx, file)
    RqcStmtR { s: SIndexAssign(t1, i1, v1, l, c), bound: locals }
  }
  SAssign(target, v, l, c) -> {
    let t1 = rqc_expr(target, locals, mt, fx, file)
    let v1 = rqc_expr(v, locals, mt, fx, file)
    RqcStmtR { s: SAssign(t1, v1, l, c), bound: locals }
  }
  SVar(b, ty_opt, init, l, c) -> {
    # SVar should not survive the desugar pass that runs before
    # rqc, but we handle it defensively just in case rqc lands
    # earlier in the pipeline some day.
    let init1 = rqc_expr(init, locals, mt, fx, file)
    RqcStmtR { s: SVar(b, ty_opt, init1, l, c), bound: [written_text(b.name), ...locals] }
  }
  # SUse introduces no value bindings; leaves locals untouched.
  SUse(eff, l, c) ->
    RqcStmtR { s: SUse(eff, l, c), bound: locals }
}
