#[doc("`kai fmt`: the entry point and the formatter of declarations and effect rows.")]

# compiler/fmt.kai — `kai fmt` entry point.
#
# The formatter is a cluster of small modules; this file is the thin
# top: `fmt_program` walks the decl list, draining collected comments
# at line boundaries and separating decls by a blank line (a run of
# adjacent imports stays one block). The per-node
# walkers live in fmt_expr / fmt_decl / fmt_effect; the writer and
# comment machinery in fmt_writer; the width model in fmt_layout.
#
# `kai fmt` formats the full language surface — generics, effects,
# handlers, protocols, impls, units, refinements.

import compiler.lex
import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.symtab
import compiler.local_names
import compiler.fmt_writer
import compiler.fmt_layout
import compiler.fmt_expr
import compiler.fmt_form
import compiler.parse_lexical
import compiler.util
import compiler.fmt_shape
import compiler.kinds

# ---- top-level entry ------------------------------------------------

#[doc("The line width `kai fmt` lays code out against when no other is given.")]
pub(pkg) fn fmt_default_width() : Int = 100

#[doc("Pretty-print a parsed program to canonical kaikai source at the given line width, interleaving the collected comments at line boundaries.")]
pub(pkg) fn fmt_program(decls: [Decl], tab: SymTab, cmts: [Cmt], toks: [Token], src: String, width: Int) : String {
  let s0 = fmt_init(cmts, toks, src, fmt_line_starts(toks), fmt_blank_lines(toks), fmt_close_lines(toks), width, tab, ln_empty())
  let s1 = fmt_decls(filter(decls, (d) => not is_fmt_lib_decl(d)), s0, None)
  let s2 = fmt_drain_rest(s1)
  fmt_finish(s2)
}

# No source to consult: no author line breaks, comments or char spellings.
#[doc("Render one expression as kaikai source on a single line, with no source text to recover spellings from. `tab` names the declarations it refers to and `locals` the binders it reads.")]
pub(pkg) fn fmt_expr_text(e: Expr, tab: SymTab, locals: LocalNames) : String {
  let s0 = fmt_init([], [], "", fmt_line_starts([]), fmt_blank_lines([]), fmt_close_lines([]), fmt_unbounded_width(), tab, locals)
  fmt_finish(fmt_expr(e, s0))
}

fn fmt_unbounded_width() : Int = 1000000000

# Walk decls, separating each by a blank line. The `prev` slot carries
# the previous decl so a run of adjacent imports prints as one block:
# no blank line is minted between `import` decls the author wrote on
# consecutive lines; an author's own gap between import groups is kept.
fn fmt_decls(decls: [Decl], s: FmtSt, prev: Option[Decl]) : FmtSt {
  match decls {
    [] -> s
    [d, ...rest] -> {
      let s1 = match prev {
        None -> s
        Some(p) -> if fmt_joins_prev_import_block(p, d) { s } else { fmt_blank_line(s) }
      }
      let s2 = fmt_drain_before(s1, decl_line(d))
      let s3 = fmt_decl(d, fmt_with_locals(s2, ln_of_decl(d)))
      let s3a = fmt_drain_trailing_after(s3, decls_trailing_limit(d, rest))
      let s4 = fmt_ensure_newline(s3a)
      fmt_decls(rest, s4, Some(d))
    }
  }
}

fn fmt_joins_prev_import_block(prev: Decl, d: Decl) : Bool = match prev {
  DImport(_, pl, _) -> match d {
    DImport(_, dl, _) -> dl == pl + 1
    _ -> false
  }
  _ -> false
}

# Upper bound for `fmt_drain_trailing_after` between the just-
# emitted decl and what follows. Two cases:
#   non-last  → the next decl's start line; any trailing in the
#               gap belongs to `d` (gap can't carry a leading on a
#               line that has code).
#   last      → `0`, the unbounded sentinel (see
#               `fmt_drain_trailing_after`). A trailing on the LAST
#               source line of a multi-line last decl (a sum-variant
#               arm, a wrapped record field) sits below
#               `decl_line(d)`, so the old `decl_line(d) + 1` bound
#               missed it and the comment demoted to leading-position
#               on re-format — the issue #785 non-idempotency. Any
#               trailing pending after the last decl can only belong
#               to it (no code follows), so the unbounded drain is
#               sound and there is no decl below to mis-anchor against.
fn decls_trailing_limit(d: Decl, rest: [Decl]) : Int {
  match rest {
    [] -> 0
    [next, ..._tail] -> decl_line(next)
  }
}

fn decl_line(d: Decl) : Int {
  match d {
    DFn(_, _, _, _, _, _, _, line, _, _) -> line
    DType(_, _, _, _, line, _, _, _) -> line
    DTest(_, _, line, _, _) -> line
    DBench(_, _, line, _, _) -> line
    DCheck(_, _, _, line, _, _) -> line
    DImport(_, line, _) -> line
    DEffect(_, _, _, _, _, line, _, _) -> line
    DProtocol(_, _, _, _, line, _, _) -> line
    DImpl(_, _, _, _, line, _, _, _) -> line
    DDerive(_, _, line, _) -> line
    DUnstable(_, line, _) -> line
    DProtoLaws(_, _, line, _, _) -> line
    DImplAxiom(_, _, line, _, _) -> line
    DConstructor(_, line, _) -> line
    DDoc(_, _, _, line, _) -> line
    DModuleDoc(_, _, line, _) -> line
    DAttr(_, _, line, _) -> line
    DUnit(_, _, _, _, line, _, _) -> line
    DUse(_, line, _) -> line
    DUseKind(_, line, _, _) -> line
    DAxiom(_, _, _, _, _, _, _, _, line, _) -> line
    DConst(_, _, _, _, _, line, _) -> line       # issue #269
    DExternType(_, _, _, line, _, _) -> line           # FFI v2
    DTheory(_, _, line, _, _) -> line
    DKind(_, _, _, _, _, line, _, _) -> line
  }
}

# Emit a single decl. Every Decl variant has an arm — a file is
# refused only when it fails to parse, never by the writer.
pub(pkg) fn fmt_decl(d: Decl, s: FmtSt) : FmtSt {
  match d {
    DImport(ik, _, _) -> fmt_import(ik, s)
    DFn(is_pub, fid, tparams, params, ret, row, body, line, _, _) ->
      fmt_fn(is_pub, fmt_decl_name(s, fnid_sym(fid)), tparams, params, ret, row, body, line, s)
    DType(is_pub, sym, tparams, body, line, _, _, slots) ->
      fmt_type_decl(is_pub, fmt_decl_name(s, sym), tparams, body, slots, line, s)
    DTest(label, body, _, _, _) -> fmt_test(label, body, s)
    DBench(label, body, _, _, _) -> fmt_bench(label, body, s)
    DCheck(label, ps, body, _, _, _) -> fmt_check(label, ps, body, s)
    DEffect(is_pub, sym, tparams, ops, default_opt, _, _, _) ->
      fmt_effect_decl(is_pub, fmt_decl_name(s, sym), tparams, ops, default_opt, s)
    DProtocol(is_pub, sym, tparams, ops, _, _, _) ->
      fmt_protocol_decl(is_pub, fmt_decl_name(s, sym), tparams, ops, s)
    DImpl(proto, proto_args, target_ty, methods, _, _, impl_tps, _) ->
      fmt_impl_decl(fmt_ref_text(s, proto), proto_args, target_ty, methods, impl_tps, s)
    # `#[derive(P, ...)] <inner_type_decl>`. Only the bracketed spelling
    # is accepted by the parser.
    DDerive(names, inner, _, _) ->
      fmt_attr_wrapped(string_concat_all(["#[derive(", string_join(names, ", "), ")]"]), inner, s)
    DUnstable(inner, _, _) -> fmt_attr_wrapped("#[unstable]", inner, s)
    DConstructor(inner, _, _) -> fmt_attr_wrapped("#[constructor]", inner, s)
    # A theory-bound protocol: the clause is spelled `: Theory` in the
    # head (`protocol P[s: Shape] : Functorial { ... }`).
    DProtoLaws(thy, inner, _, _, _) -> fmt_proto_laws(thy, inner, s)
    # `impl { } axiom <Theory>` — format the impl then the clause.
    DImplAxiom(thy, inner, _, _, _) -> fmt_emit(fmt_decl(inner, s), concat_all([" axiom ", thy]))
    # `#[doc("...")]` and any unknown attribute (`#[deprecated]`,
    # `#[cfg(...)]`, custom) re-emit their raw byte span verbatim — no
    # re-quoting, no auto-wrapping — so `kai fmt` is byte-identical on
    # attribute text it does not understand.
    DDoc(raw, _, inner, _, _) -> fmt_attr_wrapped(raw, inner, s)
    DAttr(raw, inner, _, _) -> fmt_attr_wrapped(raw, inner, s)
    # Module-position `#[doc(...)]` — verbatim, stands alone (the
    # program walker adds the blank line separating decls).
    DModuleDoc(raw, _, _, _) ->
      fmt_emit(s, raw)
    # `[pub] intro NAME [= unit_expr | = measure]` — a habitant decl.
    DUnit(is_pub, name, body, intro, _, _, _) -> fmt_unit_decl(is_pub, name, body, intro, s)
    # `use Effect` at file scope — m7e §25.
    DUse(eff_name, _, _) ->
      fmt_emit(s, string_concat("use ", eff_name))
    DUseKind(kind_name, _, _, _) ->
      fmt_emit(s, concat_all(["use kind ", kind_name]))
    # `extern "C" type Name = { fields }` struct, or `extern "C" opaque Name`.
    DExternType(pb, name, body, _, _, _) -> fmt_extern_type_decl(pb, name, body, s)
    # `[pub] axiom name[tparams](params) : T / row` (m12.7) or
    DAxiom(is_pub, abi, name, sym, tparams, params, ret_ty, row, line, _) ->
      fmt_axiom_decl(is_pub, abi, name, sym, tparams, params, ret_ty, row, line, s)
    # Issue #269: dedicated fmt arm matching the parser surface.
    # Round-trips `[pub] const NAME : T = body`. The body is emitted
    # via `fmt_expr` (the same printer used by `let pat = expr`
    # initialisers) so the produced source survives a re-parse.
    DConst(is_pub, sym, ty, body, _, _, _) -> fmt_const_decl(is_pub, fmt_decl_name(s, sym), ty, body, s)
    # `theory Name = { p1, p2, ... }` / `theory Name = builtin` — the
    # kind-catalog theory decl.
    DTheory(name, props, _, _, _) -> fmt_theory_decl(name, props, s)
    # `[pub] kind Name : Theory [over Domain] [with <habitant-form>]` —
    # the kind-catalog kind decl. A kind whose habitants are derived
    # (`kind Shape : ConstructorApp`) has no `with` clause.
    DKind(is_pub, name, thy, over, hab, _, _, _) -> fmt_kind_decl(is_pub, name, thy, over, hab, s)
  }
}

# A declaration the table cannot name would print without its name,
# and the caller writes the result back over the author's source.
fn fmt_decl_name(s: FmtSt, sym: SymId) : String {
  let name = fmt_sym_text(s, sym)
  if name == "" { panic("kai fmt: a declaration's id has no row in the symbol table") } else { name }
}

# An attribute line above the declaration it wraps.
fn fmt_attr_wrapped(raw: String, inner: Decl, s: FmtSt) : FmtSt {
  if raw == pub_pkg_raw() {
    let done = fmt_decl(inner, FmtSt { ...s, pkg_pub: true })
    FmtSt { ...done, pkg_pub: false }
  } else { fmt_attr_raw(raw, inner, s) }
}

fn fmt_attr_raw(raw: String, inner: Decl, s: FmtSt) : FmtSt {
  let s1 = fmt_emit(s, raw)
  let s2 = fmt_newline(s1)
  fmt_decl(inner, s2)
}

fn fmt_proto_laws(thy: String, inner: Decl, s: FmtSt) : FmtSt = match inner {
  DProtocol(is_pub, sym, tparams, ops, _, _, _) ->
    fmt_protocol_decl_thy(is_pub, fmt_decl_name(s, sym), tparams, thy, ops, s)
  _ -> fmt_decl(inner, s)
}

fn fmt_unit_decl(is_pub: Bool, name: String, body: UnitBody, intro: String, s: FmtSt) : FmtSt {
  let s1 = if is_pub { fmt_pub(s) } else { s }
  let s2 = fmt_emit(s1, string_concat(intro, " "))
  let s3 = fmt_emit(s2, name)
  match body {
    UBNone       -> s3
    UBAlias(u)   -> fmt_emit(fmt_emit(s3, " = "), fmt_unit_expr_str(u))
    UBMeasure(m) -> fmt_emit(fmt_emit(s3, " = "), m)
  }
}

fn fmt_extern_type_decl(is_pub: Bool, name: String, body: ExternTypeBody, s: FmtSt) : FmtSt = match body {
  ETStruct(fields) -> {
    let a = fmt_emit(s, if is_pub { "extern \"C\" pub type " } else { "extern \"C\" type " })
    let b = fmt_emit(a, name)
    let c = fmt_emit(b, " = { ")
    fmt_emit(fmt_field_decls(fields, c), " }")
  }
  ETOpaque -> fmt_emit(fmt_emit(s, if is_pub { "extern \"C\" pub opaque " } else { "extern \"C\" opaque " }), name)
}

fn fmt_theory_decl(name: String, props: [String], s: FmtSt) : FmtSt {
  let b = fmt_emit(fmt_emit(s, "theory "), name)
  if theory_props_builtin(props) { fmt_emit(b, " = builtin") }
  else {
    let c = fmt_emit(b, " = { ")
    fmt_emit(fmt_emit(c, string_join(props, ", ")), " }")
  }
}

fn fmt_kind_decl(is_pub: Bool, name: String, thy: String, over: String, hab: KindHab, s: FmtSt) : FmtSt {
  let a = if is_pub { fmt_pub(s) } else { s }
  let c = fmt_emit(fmt_emit(a, "kind "), name)
  let e = fmt_emit(fmt_emit(c, " : "), thy)
  let f = if over == "" { e } else { fmt_emit(fmt_emit(e, " over "), over) }
  match hab {
    HabNone        -> f
    HabIntro(w)    -> fmt_emit(fmt_emit(f, " with "), w)
    HabDomain(dom) -> fmt_emit(fmt_emit(f, " with "), value_domain_name(dom))
    HabClosed(w, atoms) -> {
      let g = fmt_emit(fmt_emit(f, " with "), w)
      fmt_emit(g, concat_all([" { ", string_join(atoms, " "), " }"]))
    }
  }
}

# Issue #269: format a `[pub] const NAME : T = body` declaration.
fn fmt_const_decl(is_pub: Bool, name: String, ty: TypeExpr, body: Expr, s: FmtSt) : FmtSt {
  let s1 = if is_pub { fmt_pub(s) } else { s }
  let s2 = fmt_emit(s1, "const ")
  let s3 = fmt_emit(s2, name)
  let s4 = fmt_emit(s3, " : ")
  let s5 = fmt_type(ty, s4)
  fmt_assign_body(body, fmt_emit(s5, " ="))
}

# `[pub] axiom name[tparams](params) : T / row`, or with an ABI
# `extern "<abi>"["("symbol")"] [pub] fn name[tparams](params) : T / row`,
# the symbol placed immediately after the ABI literal.
fn fmt_axiom_decl(is_pub: Bool, abi: Option[ExternAbi], name: String, sym: String, tparams: [TBinder], params: [Param], ret_ty: TypeExpr, row: RowExpr, line: Int, s: FmtSt) : FmtSt {
  let s_pre = match abi {
    Some(a) -> {
      let la = fmt_emit(s, string_concat("extern ", extern_abi_literal(a)))
      let ls = if string_length(sym) > 0 {
        fmt_emit(la, string_concat_all(["(\"", sym, "\")"]))
      } else { la }
      fmt_emit(ls, " ")
    }
    None -> s
  }
  let s_pub = if is_pub { fmt_pub(s_pre) } else { s_pre }
  let s_kw  = fmt_emit(s_pub, if is_some(abi) { "fn " } else { "axiom " })
  let s_n   = fmt_emit(s_kw, name)
  let s_tp  = fmt_tparams(tparams, s_n)
  fmt_param_seq(params, line, s_tp, (t) => fmt_type_row(ret_ty, row, fmt_emit(t, " : ")))
}

# m12.8: `impl[tparams] Pname[proto_args] for Target { methods... }`.
# When `proto_args` (or the impl-site tparam list) is empty, the
# surface form drops that `[...]`. Issue #180.
fn fmt_impl_decl(pname: String, proto_args: [TypeExpr], target_ty: TypeExpr, methods: [Decl], impl_tps: [TBinder], s: FmtSt) : FmtSt {
  let s0 = fmt_emit(s, "impl")
  let s0b = fmt_tparams(impl_tps, s0)
  let s1 = fmt_emit(s0b, " ")
  let s2 = fmt_emit(s1, pname)
  let s3 = if list_is_empty(proto_args) { s2 }
    else { fmt_type_seq("[", "]", fmt_first_type_line(proto_args), proto_args, s2, (t) => t) }
  let s4 = fmt_emit(s3, " for ")
  let s5 = fmt_type(target_ty, s4)
  let s6 = fmt_emit(s5, " {")
  let s7 = fmt_newline(s6)
  let s8 = fmt_indent_in(s7)
  let s9 = fmt_impl_methods(methods, s8)
  let s10 = fmt_indent_out(s9)
  fmt_emit(s10, "}")
}

fn fmt_impl_methods(methods: [Decl], s: FmtSt) : FmtSt = match methods {
  []           -> s
  [m, ...rest] -> {
    let s1 = fmt_decl(m, s)
    let s2 = fmt_newline(s1)
    fmt_impl_methods(rest, s2)
  }
}

# ---- imports --------------------------------------------------------

fn fmt_import(ik: ImportKind, s: FmtSt) : FmtSt {
  match ik {
    IkPath(p) -> fmt_emit(s, string_concat_all(["import ", p]))
    IkAlias(p, alias) -> fmt_emit(s, string_concat_all(["import ", p, " as ", alias]))
    IkSelective(p, names) -> fmt_emit(s, string_concat_all(["import ", p, ".{", string_join(names, ", "), "}"]))
    IkHole(name) -> fmt_emit(s, string_concat_all(["import ?", name]))
  }
}

# The signature's parameter list counts the return type, the row and
# the body's opening token (` =` / ` {`) toward its line, then the body
# continues past that token.
pub(pkg) fn fmt_fn(is_pub: Bool, name: String, tparams: [TBinder], params: [Param], ret: Option[TypeExpr], row: RowExpr, body: Expr, line: Int, s: FmtSt) : FmtSt {
  let s1 = if is_pub {
    fmt_pub(s)
  } else {
    s
  }
  let s2 = fmt_emit(s1, "fn ")
  let s3 = fmt_emit(s2, name)
  let s4 = fmt_tparams(tparams, s3)
  let opener = fmt_fn_opener(body)
  let s9 = fmt_param_seq(params, line, s4, (t) => fmt_emit(fmt_fn_ret(ret, row, t), opener))
  match body.kind {
    ESurface(sf) -> match sf {
      SfContract(reqs, enss, inner) -> fmt_fn_contracts(reqs, enss, inner, s9)
      # A case-block prints as the body's own braces, never `= { ... }`.
      SfCaseBlock(_) -> fmt_expr(body, fmt_emit(s9, " "))
      _ -> fmt_fn_body_rest(body, s9)
    }
    _ -> fmt_fn_body_rest(body, s9)
  }
}

fn fmt_fn_ret(ret: Option[TypeExpr], row: RowExpr, s: FmtSt) : FmtSt = match ret {
  None -> fmt_row(row, s)
  Some(t) -> fmt_type_row(t, row, fmt_emit(s, " : "))
}

# Contract clauses in signature position: a group with one break point
# before each clause. Before a block body the group is always broken —
# the collapsed `requires p {` shape does not re-parse (the pred
# swallows the brace). Before an `= expr` body it is flat when the
# whole signature fits and the author kept it flat, one clause per
# line otherwise, with the `=` opening at the margin below them so no
# clause line ends on a dangling opener.
fn fmt_fn_contracts(reqs: [Expr], enss: [Expr], inner: Expr, s: FmtSt) : FmtSt {
  match inner.kind {
    EBlock(_, _) -> fmt_clauses_broken(reqs, enss, (t) => fmt_fn_body_at_margin(inner, t), s)
    _ ->
      if clauses_author_broke(s, reqs, enss) { fmt_clauses_expr_broken(reqs, enss, inner, s) }
      else {
        match fmt_try_flat(s, (t) => fmt_clauses_flat(reqs, enss, t)) {
          Some(r) -> fmt_fn_body(inner, r)
          None -> fmt_clauses_expr_broken(reqs, enss, inner, s)
        }
      }
  }
}

# The clause run flat on the signature line, up to the body's opener.
# Measured as one group: a `requires` that fits only by pushing the
# `=` past the budget has not fit.
fn fmt_clauses_flat(reqs: [Expr], enss: [Expr], s: FmtSt) : FmtSt =
  fmt_contract_clauses("ensures", enss, fmt_contract_clauses("requires", reqs, s))

# One clause per line, indented under the signature; `open` then emits
# the body at the margin the clauses left.
fn fmt_clauses_broken(reqs: [Expr], enss: [Expr], open: (FmtSt) -> FmtSt, s: FmtSt) : FmtSt {
  let s1 = fmt_indent_in(s)
  let s2 = fmt_clause_lines("requires", reqs, s1)
  let s3 = fmt_clause_lines("ensures", enss, s2)
  open(fmt_newline(fmt_indent_out(s3)))
}

fn fmt_clauses_expr_broken(reqs: [Expr], enss: [Expr], inner: Expr, s: FmtSt) : FmtSt =
  fmt_clauses_broken(reqs, enss, (t) => fmt_assign_body(inner, fmt_emit(t, "=")), s)

# The author broke the run when some `requires` / `ensures` keyword
# opens a source line. The keyword is the break point, so it is the
# token to ask about — the predicate after it never starts the line.
fn clauses_author_broke(s: FmtSt, reqs: [Expr], enss: [Expr]) : Bool =
  clause_kw_opens_line(s.toks, s, clauses_span_from(reqs, enss), clauses_span_to(reqs, enss))

fn clause_kw_opens_line(toks: [Token], s: FmtSt, from: Int, to: Int) : Bool = match toks {
  [] -> false
  [t, ...rest] ->
    if clause_kw_in_span(t, s, from, to) { true }
    else { clause_kw_opens_line(rest, s, from, to) }
}

fn clause_kw_in_span(t: Token, s: FmtSt, from: Int, to: Int) : Bool {
  let in_span = (clause_tok_is_kw(t.kind) and (t.line >= from)) and (t.line <= to)
  in_span and fmt_starts_line(s, t.line, t.col)
}

fn clause_tok_is_kw(k: TokKind) : Bool = match k {
  TkRequires -> true
  TkEnsures -> true
  _ -> false
}

# The clause run spans the lines its predicates occupy: a keyword
# outside that window belongs to another declaration's contract.
fn clauses_span_from(reqs: [Expr], enss: [Expr]) : Int =
  preds_line_bound(enss, preds_line_bound(reqs, 0, true), true)

fn clauses_span_to(reqs: [Expr], enss: [Expr]) : Int =
  preds_line_bound(enss, preds_line_bound(reqs, 0, false), false)

fn preds_line_bound(preds: [Expr], acc: Int, lo: Bool) : Int = match preds {
  [] -> acc
  [p, ...rest] -> {
    let line = fmt_leftmost(p).line
    let next = if acc == 0 { line }
               else if lo { if line < acc { line } else { acc } }
               else { if line > acc { line } else { acc } }
    preds_line_bound(rest, next, lo)
  }
}

# `kw <pred>` inline, in signature position.
fn fmt_contract_clauses(kw: String, preds: [Expr], s: FmtSt) : FmtSt = match preds {
  [] -> s
  [p, ...rest] -> {
    let s1 = fmt_emit(s, concat_all([" ", kw, " "]))
    fmt_contract_clauses(kw, rest, fmt_expr(p, s1))
  }
}

# One `kw <pred>` per line, indented under the signature.
fn fmt_clause_lines(kw: String, preds: [Expr], s: FmtSt) : FmtSt = match preds {
  [] -> s
  [p, ...rest] -> {
    let s1 = fmt_emit(fmt_newline(s), concat_all([kw, " "]))
    fmt_clause_lines(kw, rest, fmt_expr(p, s1))
  }
}

# Block body opening at the current line start (after multi-line
# contract clauses), not appended to the signature line.
fn fmt_fn_body_at_margin(body: Expr, s: FmtSt) : FmtSt = match body.kind {
  EBlock(stmts, tail) -> {
    let s1 = fmt_emit(s, "{")
    let s2 = fmt_newline(s1)
    let s3 = fmt_indent_in(s2)
    let s4 = fmt_block_inner(stmts, tail, s3)
    let s5 = fmt_indent_out(s4)
    fmt_emit(s5, "}")
  }
  _ -> fmt_fn_body(body, s)
}

# Function body: `= expr` for a single expression, `{ ... }` for a
# block. The `= expr` form hangs the expression below the signature
# when it does not fit beside it.
fn fmt_fn_body(body: Expr, s: FmtSt) : FmtSt = fmt_fn_body_rest(body, fmt_emit(s, fmt_fn_opener(body)))

# The body after its opening token is out.
fn fmt_fn_body_rest(body: Expr, s: FmtSt) : FmtSt = match body.kind {
  EBlock(stmts, tail) -> fmt_block_rest(stmts, tail, s)
  _ -> fmt_assign_body(body, s)
}

# ---- type decls -----------------------------------------------------

fn fmt_type_decl(is_pub: Bool, name: String, tparams: [TBinder], body: TypeBody, slots: [String], line: Int, s: FmtSt) : FmtSt {
  let s1 = if is_pub {
    fmt_pub(s)
  } else {
    s
  }
  let s2 = fmt_emit(s1, "type ")
  let s3 = fmt_emit(s2, name)
  let s3b = fmt_habitant_slots(slots, fmt_tparams(tparams, s3))
  let s4 = s3b
  match body {
    TBAlias(t) -> fmt_hang(fmt_emit(s4, " ="), fmt_type_starts_line(s4, t), (a) => fmt_type(t, a))
    TBRecord(fields) -> fmt_record_body(fields, line, s4)
    TBSum(variants) -> fmt_sum_body(variants, line, s4)
    TBEffectAlias(labels) -> fmt_row_labels(labels, fmt_emit(s4, " = "))
  }
}

# Round-trip a type head's `<name: Kind, ...>` habitant-slot list. Empty
# for a type that declares no slots, so pre-slot decls format unchanged.
fn fmt_habitant_slots(slots: [String], s: FmtSt) : FmtSt = match slots {
  [] -> s
  _ -> fmt_emit(fmt_habitant_slots_inner(slots, fmt_emit(s, "<")), ">")
}

fn fmt_habitant_slots_inner(slots: [String], s: FmtSt) : FmtSt = match slots {
  [] -> s
  [slot] -> fmt_one_slot(slot, s)
  [slot, ...rest] -> fmt_habitant_slots_inner(rest, fmt_emit(fmt_one_slot(slot, s), ", "))
}

fn fmt_one_slot(slot: String, s: FmtSt) : FmtSt =
  fmt_emit(fmt_emit(fmt_emit(s, habitant_slot_name_of(slot)), ": "), habitant_slot_kind_of(slot))

# True when one of a type body's elements carries a comment of its own
# — a trailing on its line, or a leading block above it. Drives the
# one-per-line layout for both record fields and sum variants: the
# single-line form has nowhere to put a mid-body comment, so it would
# push every one of them past the closing delimiter.
fn elem_lines_commented(count: Int, el: ElemLines, cmts: [Cmt], i: Int) : Bool =
  if i >= count { false }
  else if cmt_within_elem(cmts, elem_line_at(el, i)) { true }
  else { elem_lines_commented(count, el, cmts, i + 1) }

# Any pending comment at or above `line` belongs inside the record:
# `fmt_drain_before` has already emitted everything preceding the decl,
# so what remains at this point starts at the decl's own body.
fn cmt_within_elem(cmts: [Cmt], line: Int) : Bool = match cmts {
  [] -> false
  [Cmt(cl, _, _, _), ..._rest] -> (line > 0) and (cl <= line)
}

# A record expands to one field per line when a field carries a
# comment (a comment swallows the rest of its line), when the author
# wrote it that way, or when the one-line form does not fit.
fn fmt_record_body(fields: [FieldDecl], line: Int, s: FmtSt) : FmtSt {
  let el = scan_elem_lines(s.toks, line)
  if elem_lines_commented(list_length(fields), el, s.cmts, 0) or elem_lines_broken(el, list_length(fields), line) {
    fmt_record_expanded(fields, el, s)
  } else {
    match fmt_try_flat(s, (t) => fmt_record_flat(fields, t)) {
      Some(r) -> r
      None -> fmt_record_expanded(fields, el, s)
    }
  }
}

fn fmt_record_flat(fields: [FieldDecl], s: FmtSt) : FmtSt =
  if list_is_empty(fields) { fmt_emit(s, " = {}") }
  else { fmt_emit(fmt_field_decls(fields, fmt_emit(s, " = { ")), " }") }

# `= {` / one field per line / `}`, each field keeping the comments
# that documented it. Trailing comma is omitted on the last field,
# matching the single-line form's separator discipline.
fn fmt_record_expanded(fs: [FieldDecl], el: ElemLines, s: FmtSt) : FmtSt {
  let s1 = fmt_emit(s, " = {")
  let s2 = fmt_indent_in(fmt_newline(s1))
  let s3 = fmt_record_expanded_loop(fs, el, 0, s2)
  fmt_emit(fmt_indent_out(s3), "}")
}

fn fmt_record_expanded_loop(fs: [FieldDecl], el: ElemLines, i: Int, s: FmtSt) : FmtSt = match fs {
  [] -> s
  [f, ...rest] -> {
    let line = elem_line_at(el, i)
    let s0 = fmt_drain_before(s, line)
    let s1 = fmt_field_decl(f, s0)
    let s2 = match rest { [] -> s1 _ -> fmt_emit(s1, ",") }
    let s3 = fmt_drain_trailing_on_line(s2, line)
    fmt_record_expanded_loop(rest, el, i + 1, fmt_newline(s3))
  }
}

fn fmt_field_decls(fs: [FieldDecl], s: FmtSt) : FmtSt {
  match fs {
    [] -> s
    [f] -> fmt_field_decl(f, s)
    [f, ...rest] -> {
      let s1 = fmt_field_decl(f, s)
      let s2 = fmt_emit(s1, ", ")
      fmt_field_decls(rest, s2)
    }
  }
}

fn fmt_field_decl(fd: FieldDecl, s: FmtSt) : FmtSt {
  match fd {
    FD(is_pub, name, t, attrs) -> {
      let s_a = fmt_field_attrs(attrs, s)
      # Round-trip `priv` qualifier when present so `kai fmt` does
      # not silently flip a field's visibility. Public is the default
      # — no `pub` prefix is emitted, matching the surface syntax.
      let s_v = if is_pub { s_a } else { fmt_emit(s_a, "priv ") }
      let s1 = fmt_emit(s_v, name)
      let s2 = fmt_emit(s1, ": ")
      fmt_type(t, s2)
    }
  }
}

fn fmt_field_attrs(attrs: [FieldAttr], s: FmtSt) : FmtSt = match attrs {
  [] -> s
  [a, ...rest] -> fmt_field_attrs(rest, fmt_field_attr(a, s))
}

fn fmt_field_attr(a: FieldAttr, s: FmtSt) : FmtSt = match a {
  FAJsonRename(n) -> fmt_emit(s, concat_all(["#[json(rename = \"", n, "\")] "]))
  FAJsonSkip      -> fmt_emit(s, "#[json(skip)] ")
  FAJsonDefault(e) -> {
    let s1 = fmt_emit(s, "#[json(default = ")
    let s2 = fmt_expr(e, s1)
    fmt_emit(s2, ")] ")
  }
}

# A sum body breaks one variant per line when a variant carries a
# comment (a comment swallows the rest of its line), when the author
# wrote it that way, or when the one-line form does not fit — the same
# three questions a record body asks.
fn fmt_sum_body(vs: [Variant], line: Int, s: FmtSt) : FmtSt {
  let el = scan_elem_lines(s.toks, line)
  if elem_lines_commented(list_length(vs), el, s.cmts, 0) or elem_lines_broken(el, list_length(vs), line) {
    fmt_sum_variants(vs, el, s)
  } else {
    match fmt_try_flat(s, (t) => fmt_sum_flat(vs, t)) {
      Some(r) -> r
      None -> fmt_sum_variants(vs, el, s)
    }
  }
}

# `= A | B | C` on the declaration's own line. A one-member sum keeps
# its leading bar: `= X` alone is the alias spelling, so dropping the
# bar would change what the declaration means.
fn fmt_sum_flat(vs: [Variant], s: FmtSt) : FmtSt =
  fmt_sum_flat_loop(vs, fmt_emit(s, if fmt_sum_needs_bar(vs) { " = | " } else { " = " }))

# Only a lone nullary variant needs it: `= X` on its own is the alias
# spelling, while `= X(T)` already reads as a sum on the parens.
fn fmt_sum_needs_bar(vs: [Variant]) : Bool = match vs {
  [Var(_, [])] -> true
  _            -> false
}

fn fmt_sum_flat_loop(vs: [Variant], s: FmtSt) : FmtSt = match vs {
  [] -> s
  [v] -> fmt_variant(v, s)
  [v, ...rest] -> fmt_sum_flat_loop(rest, fmt_emit(fmt_variant(v, s), " | "))
}

fn fmt_sum_variants(vs: [Variant], el: ElemLines, s: FmtSt) : FmtSt {
  let s0 = fmt_newline(s)
  let s1 = fmt_indent_in(s0)
  let s2 = fmt_emit(s1, if fmt_sum_needs_bar(vs) { "= | " } else { "= " })
  let s3 = fmt_sum_variants_loop(vs, el, 0, s2, true)
  fmt_indent_out(s3)
}

fn fmt_sum_variants_loop(vs: [Variant], el: ElemLines, i: Int, s: FmtSt, first: Bool) : FmtSt {
  match vs {
    [] -> s
    [v, ...rest] -> {
      let line = elem_line_at(el, i)
      let s1 = if first {
        s
      } else {
        let n = fmt_drain_before(fmt_newline(s), line)
        fmt_emit(n, "| ")
      }
      let s2 = fmt_variant(v, s1)
      let s3 = fmt_drain_trailing_on_line(s2, line)
      fmt_sum_variants_loop(rest, el, i + 1, s3, false)
    }
  }
}

fn fmt_variant(v: Variant, s: FmtSt) : FmtSt {
  match v {
    Var(ctor, ty_args) -> {
      let s1 = fmt_emit(s, fmt_decl_name(s, ctor))
      if list_is_empty(ty_args) { s1 }
      else { fmt_type_seq("(", ")", fmt_first_type_line(ty_args), ty_args, s1, (t) => t) }
    }
  }
}

# ---- tests ----------------------------------------------------------

fn fmt_test(label: String, body: Expr, s: FmtSt) : FmtSt {
  # `label` is the raw source span of the string literal (quotes
  # included), so it round-trips verbatim — single, triple, escaped
  # quotes all preserved.
  let s1 = fmt_emit(s, "test ")
  let s2 = fmt_emit(s1, label)
  fmt_fn_body(body, s2)
}

fn fmt_bench(label: String, body: Expr, s: FmtSt) : FmtSt {
  let s1 = fmt_emit(s, "bench ")
  let s2 = fmt_emit(s1, label)
  fmt_fn_body(body, s2)
}

# check v1 (issue #44): formats `check "label" [with p1: T, ...] { body }`.
# The `with` clause prints only when params are non-empty so a check
# without params round-trips identically to a parameterless test/bench.
fn fmt_check(label: String, ps: [Param], body: Expr, s: FmtSt) : FmtSt {
  let s1 = fmt_emit(s, "check ")
  let s2 = fmt_emit(s1, label)
  let s3 = match ps {
    [] -> s2
    _ -> {
      let a = fmt_emit(s2, " with ")
      fmt_params(ps, a)
    }
  }
  fmt_fn_body(body, s3)
}

# `[pub] effect Name[tparams] { op_decls... [default { ... }] }`.
fn fmt_effect_decl(is_pub: Bool, name: String, tparams: [TBinder], ops: [EffectOp], default_opt: Option[DefaultBlock], s: FmtSt) : FmtSt {
  let s0 = if is_pub { fmt_pub(s) } else { s }
  let s1 = fmt_emit(s0, "effect ")
  let s2 = fmt_emit(s1, name)
  let s3 = fmt_tparams(tparams, s2)
  match (ops, default_opt) {
    ([], None) -> fmt_emit(s3, " {}")
    _          -> fmt_effect_body(ops, default_opt, s3)
  }
}

fn fmt_effect_body(ops: [EffectOp], default_opt: Option[DefaultBlock], s: FmtSt) : FmtSt {
  let s1 = fmt_indent_in(fmt_newline(fmt_emit(s, " {")))
  let s2 = fmt_effect_ops(ops, s1)
  let s3 = match default_opt {
    None     -> s2
    Some(db) -> fmt_default_block(db, s2)
  }
  fmt_emit(fmt_indent_out(s3), "}")
}

fn fmt_effect_ops(ops: [EffectOp], s: FmtSt) : FmtSt = match ops {
  [] -> s
  [o, ...rest] -> {
    let s1 = fmt_effect_op(o, s)
    let s2 = fmt_newline(s1)
    fmt_effect_ops(rest, s2)
  }
}

fn fmt_effect_op(o: EffectOp, s: FmtSt) : FmtSt = match o {
  EffOp(op_name, tparams, params, ret_ty, line, _) -> fmt_op_sig(op_name, tparams, params, ret_ty, line, s)
}

# `name[tparams](params) : ret` — the parameter list breaks on width
# like a function signature's, the return type riding the fit.
fn fmt_op_sig(op_name: String, tparams: [TBinder], params: [Param], ret_ty: TypeExpr, line: Int, s: FmtSt) : FmtSt {
  let s1 = fmt_tparams(tparams, fmt_emit(s, op_name))
  fmt_param_seq(params, line, s1, (t) => fmt_type(ret_ty, fmt_emit(t, " : ")))
}

# `default { hclauses... [return(x) -> body] }` body of an
# effect declaration, sharing the clause printers with `EHandle`.
fn fmt_default_block(db: DefaultBlock, s: FmtSt) : FmtSt = match db {
  DBlk(clauses, ret_opt, line, _) -> {
    let s1 = fmt_emit(fmt_drain_before(s, line), "default {")
    let s2 = fmt_newline(s1)
    let s3 = fmt_indent_in(s2)
    let s4 = fmt_hclauses(clauses, s3)
    let s5 = match ret_opt {
      None    -> s4
      Some(r) -> fmt_hreturn(r, s4)
    }
    let s6 = fmt_indent_out(s5)
    let s7 = fmt_emit(s6, "}")
    fmt_newline(s7)
  }
}

# `[pub] protocol Name[tparams] { op_signatures... }`.
fn fmt_protocol_decl(is_pub: Bool, name: String, tparams: [TBinder], ops: [ProtoOp], s: FmtSt) : FmtSt =
  fmt_protocol_decl_thy(is_pub, name, tparams, "", ops, s)

fn fmt_protocol_decl_thy(is_pub: Bool, name: String, tparams: [TBinder], thy: String, ops: [ProtoOp], s: FmtSt) : FmtSt {
  let s0 = if is_pub { fmt_pub(s) } else { s }
  let s1 = fmt_emit(s0, "protocol ")
  let s2 = fmt_emit(s1, name)
  let s3a = fmt_tparams(tparams, s2)
  let s3 = if thy == "" { s3a } else { fmt_emit(s3a, concat_all([" : ", thy])) }
  let s4 = fmt_emit(s3, " {")
  let s5 = fmt_newline(s4)
  let s6 = fmt_indent_in(s5)
  let s7 = fmt_proto_ops(ops, s6)
  let s8 = fmt_indent_out(s7)
  fmt_emit(s8, "}")
}

fn fmt_proto_ops(ops: [ProtoOp], s: FmtSt) : FmtSt = match ops {
  [] -> s
  [o, ...rest] -> {
    let s1 = fmt_proto_op(o, s)
    let s2 = fmt_newline(s1)
    fmt_proto_ops(rest, s2)
  }
}

# Protocol op signatures OMIT the `fn` keyword (per `kai info protocols`).
# `impl` bodies use the full `fn name(...) : R = body` form, which goes
# through `fmt_decl` -> `fmt_fn` and brings the `fn` back.
fn fmt_proto_op(o: ProtoOp, s: FmtSt) : FmtSt = match o {
  POp(op_name, tparams, params, ret_ty, line, _) -> fmt_op_sig(op_name, tparams, params, ret_ty, line, s)
}
