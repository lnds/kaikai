#[doc("""
The marks the compiler plants in a body and later recognises.

A mark is not a reference. Nothing declares `__fuse_missing`, no scope
binds it and no symbol table knows it: a pass plants the node, a pass
downstream reads it back, and the two agree because they are the same
compiler. Spelling that agreement as a name made it a string
comparison, so a typo compiled and a mark and a user function of the
same name were one node.

The set is closed by construction, so it can be named by a constructor
the compiler checks. Adding a mark is an edit here, and every reader
that matches on marks stops compiling until it says what it does with
the new one.

The spelling stays reachable through `mark_name`: the backend emits
some of these as C identifiers and the goldens name them.
""")]

import compiler.util
import compiler.ast

#[doc("The spelling a mark carries into the backend, and the one the goldens name.")]
pub fn mark_name(m: Mark) : String = match m {
  MkFuseMissing -> "__fuse_missing"
  MkScrutinee   -> "__pcs_scr"
  MkGuardDrop   -> "__perceus_guard_drop"
}

#[doc("The mark a spelling denotes, or `None` when the name is an ordinary one. The inverse of `mark_name`, for the passes that receive a body spelled before the marks were separated.")]
pub fn mark_of_name(n: String) : Option[Mark] =
  if n == "__fuse_missing" { Some(MkFuseMissing) }
  else if n == "__pcs_scr" { Some(MkScrutinee) }
  else if n == "__perceus_guard_drop" { Some(MkGuardDrop) }
  else { None }

#[doc("True when the mark accounts for a reference the RC pass releases.")]
pub fn mark_is_drop(m: Mark) : Bool = match m {
  MkGuardDrop   -> true
  MkFuseMissing -> false
  MkScrutinee   -> false
}

#[doc("True when `a` and `b` are the same mark.")]
pub fn mark_eq(a: Mark, b: Mark) : Bool = mark_name(a) == mark_name(b)
