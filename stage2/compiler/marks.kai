#[doc("""
The marks the compiler plants in a body and later recognises.

A mark is not a reference. Nothing declares `__fuse_missing`, no scope
binds it and no symbol table knows it: a pass plants the node, a pass
downstream reads it back, and the two agree because they are the same
compiler. Spelling that agreement as a name made it a string
comparison, so a typo compiled and a mark and a user function of the
same name were one node.

The set is closed by construction, so it can be named by a constructor
the compiler checks. Adding a mark is an edit here, and every reader
that matches on marks stops compiling until it says what it does with
the new one.

The spelling stays reachable through `mark_name`: the backend emits
some of these as C identifiers and the goldens name them.
""")]

import compiler.ast
import compiler.written

#[doc("The spelling a mark carries into the backend, and the one the goldens name.")]
pub fn mark_name(m: Mark) : String = match m {
  MkFuseMissing -> "__fuse_missing"
  MkScrutinee   -> "__pcs_scr"
  MkGuardDrop   -> "__perceus_guard_drop"
  MkBorrow      -> "__perceus_borrow"
  MkApplyBorrow -> "__perceus_apply_borrow"
  MkTrmcApply   -> "__kai_trmc_apply"
  MkOwnedBorrow -> "__perceus_owned_borrow"
  MkDrop        -> "__perceus_drop"
  MkDup          -> "__perceus_dup"
  MkReuseCons    -> "__perceus_reuse_cons"
  MkReuseVariant -> "__perceus_reuse_variant"
  MkReuseRecord  -> "__perceus_reuse_record"
  MkFixedVecLit    -> "__fixed_vec_lit"
  MkFixedVecGet    -> "__fixed_vec_get"
  MkFixedVecGetDyn -> "__fixed_vec_get_dyn"
  # A step spells its fields after its head; `|` cannot appear in an identifier.
  MkTcrecStep(s) -> string_concat("__kai_tcrec|", string_join([s.sym, int_to_string(s.dropmask), ...s.params], "|"))
  MkTrmcStep(s)  -> string_concat("__kai_trmc|", string_join([s.sym, int_to_string(s.hole), s.cname, int_to_string(s.dropmask), ...s.params], "|"))
  MkRegion       -> "region"
  MkFieldPos     -> "__field_pos"
  MkFieldSpread  -> "__field_spread"
  MkDeref        -> "__deref"
  MkVarSlot(n)   -> string_concat("__var_slot|", n)
  MkIndexColl    -> "index collection"
}

#[doc("True when the mark accounts for a reference the RC pass releases.")]
pub fn mark_is_drop(m: Mark) : Bool = match m {
  MkGuardDrop   -> true
  MkDrop        -> true
  MkApplyBorrow -> false
  MkTrmcApply   -> false
  MkOwnedBorrow -> false
  MkBorrow      -> false
  MkFuseMissing -> false
  MkScrutinee   -> false
  MkDup          -> false
  MkReuseCons    -> false
  MkReuseVariant -> false
  MkReuseRecord  -> false
  MkFixedVecLit    -> false
  MkFixedVecGet    -> false
  MkFixedVecGetDyn -> false
  MkTcrecStep(_)   -> false
  MkTrmcStep(_)    -> false
  MkRegion         -> false
  MkFieldPos       -> false
  MkFieldSpread    -> false
  MkDeref          -> false
  MkVarSlot(_)     -> false
  MkIndexColl      -> false
}

#[doc("True when the mark wraps a read that costs no reference, so both backends emit the wrapped expression and nothing else.")]
pub fn mark_is_transparent(m: Mark) : Bool = match m {
  MkBorrow      -> true
  MkOwnedBorrow -> true
  MkDrop        -> false
  MkApplyBorrow -> false
  MkTrmcApply   -> false
  MkGuardDrop   -> false
  MkFuseMissing -> false
  MkScrutinee   -> false
  MkDup          -> false
  MkReuseCons    -> false
  MkReuseVariant -> false
  MkReuseRecord  -> false
  MkFixedVecLit    -> false
  MkFixedVecGet    -> false
  MkFixedVecGetDyn -> false
  MkTcrecStep(_)   -> false
  MkTrmcStep(_)    -> false
  MkRegion         -> false
  MkFieldPos       -> false
  MkFieldSpread    -> false
  MkDeref          -> false
  MkVarSlot(_)     -> false
  MkIndexColl      -> false
}

#[doc("True when the mark is a primitive: a call of it evaluates its arguments in order and yields a value of its own, like a call of a function no declaration backs. Every other mark is a form a pass plants: around a value, around a block, or in place of a self call.")]
pub fn mark_is_prim(m: Mark) : Bool = match m {
  MkFixedVecLit    -> true
  MkFixedVecGet    -> true
  MkFixedVecGetDyn -> true
  MkFuseMissing -> false
  MkScrutinee   -> false
  MkGuardDrop   -> false
  MkBorrow      -> false
  MkApplyBorrow -> false
  MkTrmcApply   -> false
  MkOwnedBorrow -> false
  MkDrop        -> false
  MkDup          -> false
  MkReuseCons    -> false
  MkReuseVariant -> false
  MkReuseRecord  -> false
  MkTcrecStep(_) -> false
  MkTrmcStep(_)  -> false
  MkRegion       -> false
  MkFieldPos       -> false
  MkFieldSpread    -> false
  MkDeref          -> false
  MkVarSlot(_)     -> false
  MkIndexColl      -> false
}

#[doc("True when the mark stands for a self call the tail-call pass turned into a jump: its operands are that call's arguments, not a value it wraps.")]
pub fn mark_is_tail_step(m: Mark) : Bool = match m {
  MkTcrecStep(_) -> true
  MkTrmcStep(_)  -> true
  MkFuseMissing  -> false
  MkScrutinee    -> false
  MkGuardDrop    -> false
  MkBorrow       -> false
  MkApplyBorrow  -> false
  MkTrmcApply    -> false
  MkOwnedBorrow  -> false
  MkDrop         -> false
  MkDup          -> false
  MkReuseCons    -> false
  MkReuseVariant -> false
  MkReuseRecord  -> false
  MkFixedVecLit    -> false
  MkFixedVecGet    -> false
  MkFixedVecGetDyn -> false
  MkRegion         -> false
  MkFieldPos       -> false
  MkFieldSpread    -> false
  MkDeref          -> false
  MkVarSlot(_)     -> false
  MkIndexColl      -> false
}

#[doc("True when the mark rebuilds a value in the cell of the scrutinee it consumes.")]
pub fn mark_is_reuse(m: Mark) : Bool = match m {
  MkReuseCons    -> true
  MkReuseVariant -> true
  MkReuseRecord  -> true
  MkDup          -> false
  MkDrop         -> false
  MkGuardDrop    -> false
  MkBorrow       -> false
  MkOwnedBorrow  -> false
  MkApplyBorrow  -> false
  MkTrmcApply    -> false
  MkFuseMissing  -> false
  MkScrutinee    -> false
  MkFixedVecLit    -> false
  MkFixedVecGet    -> false
  MkFixedVecGetDyn -> false
  MkTcrecStep(_)   -> false
  MkTrmcStep(_)    -> false
  MkRegion         -> false
  MkFieldPos       -> false
  MkFieldSpread    -> false
  MkDeref          -> false
  MkVarSlot(_)     -> false
  MkIndexColl      -> false
}

#[doc("True when `a` and `b` are the same mark.")]
pub fn mark_eq(a: Mark, b: Mark) : Bool = mark_name(a) == mark_name(b)
