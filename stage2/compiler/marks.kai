#[doc("""
The marks the compiler plants in a body and later recognises.

A mark is not a reference. Nothing declares `__fuse_missing`, no scope
binds it and no symbol table knows it: a pass plants the node, a pass
downstream reads it back, and the two agree because they are the same
compiler. Spelling that agreement as a name made it a string
comparison, so a typo compiled and a mark and a user function of the
same name were one node.

The set is closed by construction, so it can be named by a constructor
the compiler checks. Adding a mark is an edit here, and every reader
that matches on marks stops compiling until it says what it does with
the new one.

The spelling stays reachable through `mark_name`: the backend emits
some of these as C identifiers and the goldens name them.
""")]

import compiler.ast
import compiler.ast_map

#[doc("The spelling a mark carries into the backend, and the one the goldens name.")]
pub fn mark_name(m: Mark) : String = match m {
  MkFuseMissing -> "__fuse_missing"
  MkScrutinee   -> "__pcs_scr"
  MkGuardDrop   -> "__perceus_guard_drop"
  MkBorrow      -> "__perceus_borrow"
  MkApplyBorrow -> "__perceus_apply_borrow"
  MkTrmcApply   -> "__kai_trmc_apply"
  MkOwnedBorrow -> "__perceus_owned_borrow"
  MkDrop        -> "__perceus_drop"
  MkDup          -> "__perceus_dup"
  MkReuseCons    -> "__perceus_reuse_cons"
  MkReuseVariant -> "__perceus_reuse_variant"
  MkReuseRecord  -> "__perceus_reuse_record"
  MkFixedVecLit    -> "__fixed_vec_lit"
  MkFixedVecGet    -> "__fixed_vec_get"
  MkFixedVecGetDyn -> "__fixed_vec_get_dyn"
}

#[doc("The mark a spelling denotes, or `None` when the name is an ordinary one. The inverse of `mark_name`, for the passes that receive a body spelled before the marks were separated.")]
pub fn mark_of_name(n: String) : Option[Mark] =
  if n == "__fuse_missing" { Some(MkFuseMissing) }
  else if n == "__pcs_scr" { Some(MkScrutinee) }
  else if n == "__perceus_guard_drop" { Some(MkGuardDrop) }
  else if n == "__perceus_borrow" { Some(MkBorrow) }
  else if n == "__perceus_apply_borrow" { Some(MkApplyBorrow) }
  else if n == "__kai_trmc_apply" { Some(MkTrmcApply) }
  else if n == "__perceus_owned_borrow" { Some(MkOwnedBorrow) }
  else if n == "__perceus_drop" { Some(MkDrop) }
  else if n == "__perceus_dup" { Some(MkDup) }
  else if n == "__perceus_reuse_cons" { Some(MkReuseCons) }
  else if n == "__perceus_reuse_variant" { Some(MkReuseVariant) }
  else if n == "__perceus_reuse_record" { Some(MkReuseRecord) }
  else if n == "__fixed_vec_lit" { Some(MkFixedVecLit) }
  else if n == "__fixed_vec_get" { Some(MkFixedVecGet) }
  else if n == "__fixed_vec_get_dyn" { Some(MkFixedVecGetDyn) }
  else { None }

#[doc("True when the mark accounts for a reference the RC pass releases.")]
pub fn mark_is_drop(m: Mark) : Bool = match m {
  MkGuardDrop   -> true
  MkDrop        -> true
  MkApplyBorrow -> false
  MkTrmcApply   -> false
  MkOwnedBorrow -> false
  MkBorrow      -> false
  MkFuseMissing -> false
  MkScrutinee   -> false
  MkDup          -> false
  MkReuseCons    -> false
  MkReuseVariant -> false
  MkReuseRecord  -> false
  MkFixedVecLit    -> false
  MkFixedVecGet    -> false
  MkFixedVecGetDyn -> false
}

#[doc("True when the mark wraps a read that costs no reference, so both backends emit the wrapped expression and nothing else.")]
pub fn mark_is_transparent(m: Mark) : Bool = match m {
  MkBorrow      -> true
  MkOwnedBorrow -> true
  MkDrop        -> false
  MkApplyBorrow -> false
  MkTrmcApply   -> false
  MkGuardDrop   -> false
  MkFuseMissing -> false
  MkScrutinee   -> false
  MkDup          -> false
  MkReuseCons    -> false
  MkReuseVariant -> false
  MkReuseRecord  -> false
  MkFixedVecLit    -> false
  MkFixedVecGet    -> false
  MkFixedVecGetDyn -> false
}

#[doc("True when the mark is a primitive: a call of it evaluates its arguments in order and yields a value of its own, like a call of a function no declaration backs. Every other mark is a form the ownership and tail-call passes plant around a value.")]
pub fn mark_is_prim(m: Mark) : Bool = match m {
  MkFixedVecLit    -> true
  MkFixedVecGet    -> true
  MkFixedVecGetDyn -> true
  MkFuseMissing -> false
  MkScrutinee   -> false
  MkGuardDrop   -> false
  MkBorrow      -> false
  MkApplyBorrow -> false
  MkTrmcApply   -> false
  MkOwnedBorrow -> false
  MkDrop        -> false
  MkDup          -> false
  MkReuseCons    -> false
  MkReuseVariant -> false
  MkReuseRecord  -> false
}

#[doc("True when the mark rebuilds a value in the cell of the scrutinee it consumes.")]
pub fn mark_is_reuse(m: Mark) : Bool = match m {
  MkReuseCons    -> true
  MkReuseVariant -> true
  MkReuseRecord  -> true
  MkDup          -> false
  MkDrop         -> false
  MkGuardDrop    -> false
  MkBorrow       -> false
  MkOwnedBorrow  -> false
  MkApplyBorrow  -> false
  MkTrmcApply    -> false
  MkFuseMissing  -> false
  MkScrutinee    -> false
  MkFixedVecLit    -> false
  MkFixedVecGet    -> false
  MkFixedVecGetDyn -> false
}

#[doc("The expression `e` re-parsed from the interpolation source `src`, with each call the RC pass spelled there as text read back as its mark. The dup is the one mark that travels as text, so a source that never names it is returned as parsed.")]
pub fn marks_read_spelled(src: String, e: Expr) : Expr =
  if string_contains(src, mark_name(MkDup)) { mark_read_expr(e) } else { e }

fn mark_read_expr(e: Expr) : Expr = Expr { ...e, kind: mark_read_kind(e.kind) }

fn mark_read_kind(k: ExprKind) : ExprKind = match k {
  ECall(f, xs) -> ECall(mark_read_callee(f), map(xs, mark_read_expr))
  _            -> prc_map_expr_kind(k, mark_read_expr)
}

fn mark_read_callee(f: Expr) : Expr = match f.kind {
  EVar(n) -> match mark_of_name(n) {
    Some(MkDup) -> Expr { ...f, kind: EMark(MkDup) }
    _           -> f
  }
  _ -> mark_read_expr(f)
}

#[doc("True when `a` and `b` are the same mark.")]
pub fn mark_eq(a: Mark, b: Mark) : Bool = mark_name(a) == mark_name(b)
