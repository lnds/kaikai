#[doc("The attribute lines wrapped around a declaration, back in the order they were written.")]

import compiler.ast_decl
import compiler.symtab
import compiler.util

#[doc("One attribute as `kai fmt` prints it, at the position it was written.")]
pub type AttrLine = { line: Int, col: Int, text: String }

#[doc("A declaration's attribute lines in source order, whether it is `pub(pkg)`, the declaration under them and the line the whole stack starts on.")]
pub type AttrStack = { lines: [AttrLine], pkg: Bool, base: Decl, first: Int }

#[doc("Unwraps every attribute around `d`.")]
pub fn attr_stack(d: Decl) : AttrStack =
  attr_stack_loop(d, AttrStack { lines: [], pkg: false, base: d, first: 0 })

fn attr_stack_loop(d: Decl, acc: AttrStack) : AttrStack = match d {
  DDerive(names, inner, l, c) ->
    attr_push(inner, l, c, concat_all(["#[derive(", string_join(names, ", "), ")]"]), acc)
  DUnstable(inner, l, c) -> attr_push(inner, l, c, "#[unstable]", acc)
  DConstructor(inner, l, c) -> attr_push(inner, l, c, "#[constructor]", acc)
  DDoc(raw, _, inner, l, c) -> attr_push(inner, l, c, raw, acc)
  DAttr(raw, inner, l, c) ->
    if raw == pub_pkg_raw() {
      attr_stack_loop(inner, AttrStack { ...acc, pkg: true, first: earlier(acc.first, l) })
    } else {
      attr_push(inner, l, c, raw, acc)
    }
  _ -> AttrStack { ...acc, base: d }
}

fn attr_push(inner: Decl, line: Int, col: Int, text: String, acc: AttrStack) : AttrStack {
  let lines = attr_insert(acc.lines, AttrLine { line: line, col: col, text: text })
  attr_stack_loop(inner, AttrStack { ...acc, lines: lines, first: earlier(acc.first, line) })
}

fn earlier(first: Int, line: Int) : Int = if first == 0 or line < first { line } else { first }

fn attr_insert(lines: [AttrLine], a: AttrLine) : [AttrLine] = match lines {
  [] -> [a]
  [h, ...t] ->
    if a.line < h.line or (a.line == h.line and a.col < h.col) {
      [a, h, ...t]
    } else {
      [h, ...attr_insert(t, a)]
    }
}
