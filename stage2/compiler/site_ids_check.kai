#[doc("""
`--check-site-ids`: every node an unwind site can sit on carries a site
id of its own within its declaration.

The unwinder keys each bracket, landing pad and early return by the site
id of the node it brackets. Two such nodes of one declaration sharing an
id, or one carrying none, would make the emitters read one site for the
other.
""")]

import compiler.ast
import compiler.util
import compiler.expr_positions
import compiler.site_ids

#[doc("Report each site-capable node that shares its site id with another of its declaration or carries none; the exit status is the number found.")]
pub fn check_site_ids(decls: [Decl]) : Int / Console = {
  let found = flat_map(decls, sic_decl)
  each(found, (m) => eprint(m))
  list_length(found)
}

fn sic_decl(d: Decl) : [String] = sic_bad(map(decl_body_exprs(d), (b) => SicAt(b, false)), d, [], [])

# A node to check, and whether it is keyed whatever its kind (an `assert`'s condition).
type SicAt = SicAt(Expr, Bool)

fn sic_bad(es: [SicAt], d: Decl, seen: [Int], acc: [String]) : [String] = match es {
  [] -> acc
  [SicAt(e, forced), ...rest] -> {
    # A forced visit checks the condition alone; its children come with
    # the block's ordinary walk.
    let next = if forced { rest } else { list_append(sic_kids(e), rest) }
    if not (forced or site_keyed(e.kind)) { sic_bad(next, d, seen, acc) }
    else if e.site <= 0 or list_has_int(seen, e.site) { sic_bad(next, d, seen, [sic_msg(d, e), ...acc]) }
    else { sic_bad(next, d, [e.site, ...seen], acc) }
  }
}

# The children of `e`, plus an `assert`'s condition again as keyed when its
# kind alone would not be.
fn sic_kids(e: Expr) : [SicAt] = list_append(sic_asserts(e), map(xp_positions(e), (p) => match p { XP(_, c) -> SicAt(c, false) }))

fn sic_asserts(e: Expr) : [SicAt] = match e.kind {
  EBlock(ss, _) -> flat_map(ss, (s) => match s { SAssert(c, _) -> if site_keyed(c.kind) { [] } else { [SicAt(c, true)] }  _ -> [] })
  _ -> []
}

fn list_has_int(xs: [Int], x: Int) : Bool = match xs {
  [] -> false
  [y, ...rest] -> y == x or list_has_int(rest, x)
}

fn sic_msg(d: Decl, e: Expr) : String =
  concat_all(["site id ", int_to_string(e.site), " not unique in ", decl_label(d), " at ", int_to_string(e.line), ":", int_to_string(e.col)])

fn decl_body_exprs(d: Decl) : [Expr] = match decl_transparent_inner(d) {
  Some(inner) -> decl_body_exprs(inner)
  None -> match d {
    DFn(_, _, _, _, _, _, body, _, _, _, _)  -> [body]
    DTest(_, body, _, _, _)                  -> [body]
    DBench(_, body, _, _, _)                 -> [body]
    DCheck(_, _, body, _, _, _)              -> [body]
    DConst(_, _, _, body, _, _, _, _)        -> [body]
    DImpl(_, _, _, subs, _, _, _, _)         -> flat_map(subs, decl_body_exprs)
    _ -> []
  }
}

fn decl_label(d: Decl) : String = match decl_transparent_inner(d) {
  Some(inner) -> decl_label(inner)
  None -> match d {
    DFn(_, n, _, _, _, _, _, _, _, _, _) -> n
    _ -> "a declaration"
  }
}
