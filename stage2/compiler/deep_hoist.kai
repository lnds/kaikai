#[doc("""
Bounds how deep the C backend nests an expression, whatever the source depth.

A chain of calls, operators, pipes or list and record literals nests its
operands, and the C backend spells the chain as one expression: C
compilers stop at a few hundred brackets. Past `dh_max` levels the
operand that reaches the bound is bound to a `let` ahead of the
statement that holds it, and the chain reads it back.

The bindings run in the order the operands would: every operand
evaluated before the bound one is bound too, unless it is a name or a
literal, which evaluates nothing. The bindings rise past operand chains
only. A branch, an arm or a statement too deep for its holder moves into
a function of its own (`deep_outline`). A function whose expressions all
fit is returned untouched.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.symtab
import compiler.ast_map
import compiler.util
import compiler.operators
import compiler.expr_positions
import compiler.written

#[doc("Every declaration of `ds` with its nesting bounded for the C backend.")]
pub(pkg) fn deep_hoist_decls(ds: [Decl], tab: SymTab) : [Decl] =
  map(ds, (d) => decl_map_named_bodies(d, (owner, body) => dh_body(tab, owner, body)))

# A past-i64 literal takes its type from the annotation around it, which a
# `let` of its own would not carry, so a body holding one stays as written.
fn dh_body(tab: SymTab, owner: FnId, body: Expr) : Expr =
  if dh_height(body) <= dh_max() and do_depth(body) <= do_budget() or dh_has_wide_lit(body) { body }
  else { dh_top(DhCx { tab: tab, owner: owner, outline: do_outlines_in(body) }, body) }

# The table the function's name is read from, the function being rewritten,
# and whether its branches may be outlined.
type DhCx = { tab: SymTab, owner: FnId, outline: Bool }

# Bindings to run first, the expression reading them, and its operand height.
type DhOut = DhOut([Stmt], Expr, Int)

fn dh_top(cx: DhCx, e: Expr) : Expr = match dh(cx, e) {
  DhOut([], x, _)   -> x
  DhOut(lets, x, _) -> mk_expr(EBlock(lets, Some(x)), e.line, e.col)
}

fn dh(cx: DhCx, e: Expr) : DhOut = match dh_operands(e) {
  Some(xs) -> dh_chain(cx, e, map(xs, (x) => dh(cx, x)))
  None     -> DhOut([], dh_with(e, dh_enclosing(cx, e)), 1)
}

# A node that keeps its bindings; the branches of a conditional or a block
# also move into a function of their own when they nest too deep.
fn dh_enclosing(cx: DhCx, e: Expr) : ExprKind = match e.kind {
  EBlock(stmts, tail) -> EBlock(dh_stmts(cx, stmts), prc_map_opt_expr(tail, (x) => dh_branch(cx, 1, x)))
  EMatch(scr, arms)   -> EMatch(dh_top(cx, scr), map(arms, (a) => dh_arm(cx, a)))
  EIf(c, t, eo)       -> EIf(dh_top(cx, c), dh_branch(cx, 1, t), prc_map_opt_expr(eo, (x) => dh_branch(cx, 1, x)))
  _                   -> prc_map_expr_kind(e.kind, (x) => dh_top(cx, x))
}

fn dh_arm(cx: DhCx, a: Arm) : Arm = match a {
  Arm(p, g, b) -> Arm(p, prc_map_opt_expr(g, (x) => dh_top(cx, x)), dh_branch(cx, 3, b))
}

fn dh_branch(cx: DhCx, weight: Int, x: Expr) : Expr = {
  let x1 = dh_top(cx, x)
  if cx.outline { do_branch(cx.tab, cx.owner, weight, x1) } else { x1 }
}

fn dh_with(e: Expr, k: ExprKind) : Expr = Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn dh_stmts(cx: DhCx, stmts: [Stmt]) : [Stmt] = match stmts {
  []           -> []
  [s, ...rest] -> dh_stmt(cx, s) ++ dh_stmts(cx, rest)
}

fn dh_stmt(cx: DhCx, s: Stmt) : [Stmt] = match s {
  SLet(p, t, x)  -> match dh(cx, x) { DhOut(lets, x1, _) -> lets ++ [SLet(p, t, dh_outlined(cx, x1))] }
  SExprStmt(x)   -> match dh(cx, x) { DhOut(lets, x1, _) -> lets ++ [SExprStmt(dh_outlined(cx, x1))] }
  _              -> [prc_map_stmt_exprs(s, (x) => dh_top(cx, x))]
}

fn dh_outlined(cx: DhCx, x: Expr) : Expr = if cx.outline { do_branch(cx.tab, cx.owner, 1, x) } else { x }

# Operands up to the last one that is too tall or brings bindings of its
# own are settled in order: the tall ones and the ones that evaluate
# something are bound, so nothing runs ahead of an operand it followed.
fn dh_chain(cx: DhCx, e: Expr, outs: [DhOut]) : DhOut = match dh_settle(outs, dh_last_live(outs, 0, -1), 0) {
  DhSettle(lets, xs, h) -> DhOut(lets, dh_rebuild(cx, e, xs), 1 + h)
}

# Bindings, the operands reading them back, and the tallest operand left.
type DhSettle = DhSettle([Stmt], [Expr], Int)

fn dh_settle(outs: [DhOut], last: Int, i: Int) : DhSettle = match outs {
  [] -> DhSettle([], [], 0)
  [DhOut(lets, x, h), ...rest] -> match dh_settle(rest, last, i + 1) {
    DhSettle(more, ys, hr) ->
      if dh_binds(i, last, x, h) { dh_bound(lets ++ [dh_let(x, h), ...more], dh_ref(x, h), ys, hr) }
      else { DhSettle(lets ++ more, [x, ...ys], dh_hi(h, hr)) }
  }
}

fn dh_binds(i: Int, last: Int, x: Expr, h: Int) : Bool =
  i <= last and (h >= dh_max() or (i < last and not dh_inert(x)))

fn dh_bound(lets: [Stmt], r: Expr, ys: [Expr], hr: Int) : DhSettle = DhSettle(lets, [r, ...ys], dh_hi(1, hr))

fn dh_let(x: Expr, h: Int) : Stmt = SLet(mk_pat(PBind(binder_minted(dh_temp(x, h))), x.line, x.col), None, x)

fn dh_ref(x: Expr, h: Int) : Expr = mk_name(dh_temp(x, h), x.line, x.col)

# Unique per operand: a nested binding sits at another position or height.
fn dh_temp(x: Expr, h: Int) : String =
  concat_all(["__dh_", int_to_string(x.line), "_", int_to_string(x.col), "_", int_to_string(h)])

fn dh_last_live(outs: [DhOut], i: Int, acc: Int) : Int = match outs {
  []                           -> acc
  [DhOut(lets, _, h), ...rest] ->
    dh_last_live(rest, i + 1, if h >= dh_max() or not list_is_empty(lets) { i } else { acc })
}

fn dh_rebuild(cx: DhCx, e: Expr, xs: [Expr]) : Expr = dh_with(e, dh_kind(cx, e.kind, xs))

fn dh_kind(cx: DhCx, k: ExprKind, xs: [Expr]) : ExprKind {
  case _, ECall(f, _), _             -> ECall(f, xs)
  case _, EBinop(op, _, _), [a, b]   -> EBinop(op, a, b)
  case _, EUnop(op, _), [a]          -> EUnop(op, a)
  case _, EField(_, n), [a]          -> EField(a, n)
  case _, EIndex(_, _), [a, b]       -> EIndex(a, b)
  case _, EPipe(_, f), [a]           -> EPipe(a, dh_pipe_fn(cx, f))
  case _, _, _                       -> dh_literal_kind(k, xs)
}

fn dh_literal_kind(k: ExprKind, xs: [Expr]) : ExprKind = match k {
  EList(els)           -> EList(dh_elems(els, xs))
  ERecordLit(rh, fs)   -> ERecordLit(rh, dh_fields(fs, xs))
  _                    -> k
}

fn dh_elems(els: [ListElem], xs: [Expr]) : [ListElem] = match els {
  []             -> []
  [el, ...rest]  -> match xs {
    [x, ...more] -> [match el { ElPlain(_) -> ElPlain(x)  ElSpread(_) -> ElSpread(x) }, ...dh_elems(rest, more)]
    []           -> els
  }
}

fn dh_fields(fs: [FieldInit], xs: [Expr]) : [FieldInit] = match fs {
  []                  -> []
  [FI(n, _), ...rest] -> match xs {
    [x, ...more] -> [FI(n, x), ...dh_fields(rest, more)]
    []           -> fs
  }
}

# A pipe's right side is a call shape, not a value: only its arguments are rewritten.
fn dh_pipe_fn(cx: DhCx, f: Expr) : Expr = match f.kind {
  ECall(g, xs) -> dh_with(f, ECall(g, map(xs, (x) => dh_top(cx, x))))
  _            -> f
}

# A name or a literal: it evaluates nothing, so it may stay behind a binding.
fn dh_inert(x: Expr) : Bool = match x.kind {
  EName(_)       -> true
  ESym(_, _)     -> true
  ELocal(_)      -> true
  EModCall(_, _) -> true
  _              -> dh_literal(x)
}

fn dh_literal(x: Expr) : Bool = match x.kind {
  EInt(_, _)     -> true
  EReal(_, _)    -> true
  EFixed(_, _)   -> true
  EBool(_)       -> true
  EChar(_)       -> true
  EStr(_, _)     -> true
  EUnit          -> true
  _              -> false
}

#[doc("The tallest operand chain an expression keeps before a `let` takes its bottom.")]
fn dh_max() : Int = 32

#[doc("The operand height of `e`, or above `dh_max` when any chain inside is taller.")]
fn dh_height(e: Expr) : Int = match e.kind {
  ECall(f, xs)     -> if dh_name(f) { 1 + dh_tallest(xs, 0) } else { dh_enclosed(e) }
  EBinop(op, a, b) -> if binop_is_logical(op) { dh_enclosed(e) } else { 1 + dh_hi(dh_height(a), dh_height(b)) }
  EUnop(_, a)      -> 1 + dh_height(a)
  EField(a, _)     -> 1 + dh_height(a)
  EIndex(a, b)     -> 1 + dh_hi(dh_height(a), dh_height(b))
  EPipe(a, f)      -> {
    let rhs = dh_height(f)
    if rhs > dh_max() { rhs } else { 1 + dh_height(a) }
  }
  _                -> dh_literal_height(e)
}

fn dh_literal_height(e: Expr) : Int = match e.kind {
  EList(_)         -> 1 + dh_tallest_at(xp_positions(e), 0)
  ERecordLit(_, _) -> 1 + dh_tallest_at(xp_positions(e), 0)
  _                -> dh_enclosed(e)
}

# A node that keeps its bindings: height 1, unless a chain inside is too tall.
fn dh_enclosed(e: Expr) : Int = {
  let inner = dh_tallest_at(xp_positions(e), 0)
  if inner > dh_max() { inner } else { 1 }
}

fn dh_tallest(xs: [Expr], acc: Int) : Int = match xs {
  []           -> acc
  [x, ...rest] -> dh_tallest(rest, dh_hi(dh_height(x), acc))
}

fn dh_tallest_at(ps: [XPos], acc: Int) : Int = match ps {
  []                  -> acc
  [XP(_, c), ...rest] -> dh_tallest_at(rest, dh_hi(dh_height(c), acc))
}

#[doc("Whether `e` holds a past-i64 integer literal.")]
fn dh_has_wide_lit(e: Expr) : Bool = match e.kind {
  EIntLit(_) -> true
  _          -> any(xp_positions(e), (p) => match p { XP(_, c) -> dh_has_wide_lit(c) })
}

#[doc("The operands a binding may rise past, in evaluation order; `None` for a node that keeps its bindings to itself.")]
fn dh_operands(e: Expr) : Option[[Expr]] = match e.kind {
  ECall(f, xs)     -> if dh_name(f) { Some(xs) } else { None }
  EBinop(op, a, b) -> if binop_is_logical(op) { None } else { Some([a, b]) }
  EUnop(_, a)      -> Some([a])
  EField(a, _)     -> Some([a])
  EIndex(a, b)     -> Some([a, b])
  EPipe(a, _)      -> Some([a])
  _                -> dh_literal_operands(e)
}

fn dh_literal_operands(e: Expr) : Option[[Expr]] = match e.kind {
  EList(els)        -> Some(map(els, (el) => match el { ElPlain(x) -> x  ElSpread(x) -> x }))
  ERecordLit(_, fs) -> Some(map(fs, (fi) => match fi { FI(_, v) -> v }))
  _                 -> None
}

fn dh_name(f: Expr) : Bool = match f.kind {
  EName(_)         -> true
  ESym(_, _)       -> true
  ELocal(_)        -> true
  EModCall(_, _)   -> true
  EField(base, _)  -> dh_name(base)
  # A var's slot stands for a call of a name, which rides its operands.
  EMark(MkVarSlot(_)) -> true
  _                -> false
}

#[doc("The larger of `a` and `b`.")]
fn dh_hi(a: Int, b: Int) : Int = if a > b { a } else { b }

#[doc("The estimated C nesting below which a branch stays where it is written.")]
fn do_budget() : Int = 140

#[doc("The estimated C nesting of `e`: brackets per level by form, a lambda body counted apart.")]
fn do_depth(e: Expr) : Int = match e.kind {
  ELambda(_, _)    -> 1
  ECall(f, xs)     -> 1 + do_deeper(do_depth(f), do_deepest_of(xs, 0))
  EBinop(_, a, b)  -> 3 + do_deeper(do_depth(a), do_depth(b))
  EUnop(_, a)      -> 2 + do_depth(a)
  EField(a, _)     -> 2 + do_depth(a)
  # A deref or cell-write mark weighs what it lowers to, a field read.
  EMark(MkDeref)   -> 3
  EMark(MkCellSet) -> 3
  _                -> do_depth_branching(e)
}

# The conditionals and blocks every body is made of, walked in place.
fn do_depth_branching(e: Expr) : Int = match e.kind {
  EMatch(s, arms)     -> 3 + do_deeper(do_depth(s), do_deepest_arm(arms, 0))
  EIf(c, t, eo)       -> 1 + do_deeper(do_deeper(do_depth(c), do_depth(t)), do_depth_opt(eo))
  EBlock(stmts, tail) -> 1 + do_deeper(do_deepest_at(stmts, 0), do_depth_opt(tail))
  _                   -> 1 + do_deepest(xp_positions(e), 0)
}

fn do_depth_opt(eo: Option[Expr]) : Int = match eo {
  Some(x) -> do_depth(x)
  None    -> 0
}

fn do_deepest_arm(arms: [Arm], acc: Int) : Int = match arms {
  []                      -> acc
  [Arm(_, g, b), ...rest] -> do_deepest_arm(rest, do_deeper(do_deeper(do_depth_opt(g), do_depth(b)), acc))
}

fn do_deepest_at(stmts: [Stmt], acc: Int) : Int = match stmts {
  []           -> acc
  [s, ...rest] -> do_deepest_at(rest, do_deeper(do_stmt_depth(s), acc))
}

fn do_stmt_depth(s: Stmt) : Int = match s {
  SLet(_, _, x)               -> do_depth(x)
  SVar(_, _, x, _, _)         -> do_depth(x)
  SExprStmt(x)                -> do_depth(x)
  SAssert(c, om)              -> do_deeper(do_depth(c), do_depth_opt(om))
  SIndexAssign(a, i, v, _, _) -> do_deeper(do_depth(a), do_deeper(do_depth(i), do_depth(v)))
  SAssign(a, v, _, _)         -> do_deeper(do_depth(a), do_depth(v))
  SUse(_, _, _)               -> 0
}

fn do_deeper(a: Int, b: Int) : Int = if a > b { a } else { b }

fn do_deepest_of(xs: [Expr], acc: Int) : Int = match xs {
  []           -> acc
  [x, ...rest] -> do_deepest_of(rest, do_deeper(do_depth(x), acc))
}

fn do_deepest(ps: [XPos], acc: Int) : Int = match ps {
  []                  -> acc
  [XP(_, c), ...rest] -> do_deepest(rest, do_deeper(do_depth(c), acc))
}

#[doc("Whether any function in `body` may have a branch outlined: one holding a handler or a `var` keeps every branch in its own frame.")]
fn do_outlines_in(body: Expr) : Bool = not xp_exists(body, false, do_is_handle)

fn do_is_handle(e: Expr) : Bool = match e.kind {
  EHandle(_, _, _, _, _, _, _) -> true
  _                            -> false
}

#[doc("`branch` as an immediately applied closure when the node holding it, `weight` brackets deep, would push it past the budget; as written otherwise.")]
fn do_branch(tab: SymTab, owner: FnId, weight: Int, branch: Expr) : Expr =
  if weight + do_depth(branch) <= do_budget() or do_pinned(tab, owner, branch) { branch }
  else {
    let thunk = mk_expr(ELambda([], branch), branch.line, branch.col)
    mk_expr(ECall(thunk, []), branch.line, branch.col)
  }

# A branch that must run in the frame it is written in: an early return, a
# `resume`, a call back into the enclosing function (a closure would turn its
# tail call into a plain one), or a nursery boundary.
fn do_pinned(tab: SymTab, owner: FnId, branch: Expr) : Bool = {
  let fname = written_text(decl_name(tab, fnid_sym(owner)))
  xp_exists(branch, false, (x) => do_pins(fname, fnid_sym(owner), x))
}

# The body is read before name resolution: a written name is all a
# reference has, and one already settled is told by its declaration.
fn do_pins(fname: String, owner: SymId, x: Expr) : Bool = match x.kind {
  EBang(_)        -> true
  EName(w)        -> {
    let n = written_text(w)
    n == fname or n == "resume" or n == "nursery"
  }
  ESym(s, _)      -> sym_raw(s) >= 0 and (sym_raw(s) == sym_raw(owner) or sym_raw(s) == sym_raw(do_nursery()))
  _               -> false
}

fn do_nursery() : SymId = sym_derive(NCFn, "nursery", "spawn")
