#[doc("""
Every name a program declares, with the class it competes in and the
module that declares it.

A declaration node holds its id and no name. The parser, which reads the
name, files one entry per declaration and per constructor; the symbol
table is built from those entries, and a name is read back from it.

Names enter as the user wrote them: a declaration's identity is the
module that owns it, so two modules declaring `Item` contribute two
entries under ONE name rather than one entry under two names — which is
what lets a contested bare use be recognised as contested at all.
""")]

import compiler.ast

#[doc("The namespace a name competes in. Two entries collide only when their class matches — `type Log` and `effect Log` are distinct habitants.")]
#[derive(BinSerialize)]
pub type NCls = NCFn | NCType | NCEffect | NCConst | NCProtocol
              | NCCtor | NCKind | NCExternType | NCUnit | NCModule | NCBuiltin
              | NCMethod

#[doc("One declared name: `NEnt(class, name, home, exported)`. Root-file declarations carry the target module as home; an impl method carries its impl block's scope.")]
#[derive(BinSerialize)]
pub type NEnt = NEnt(NCls, String, String, Bool)

#[doc("The English word for a class, as it appears in a diagnostic.")]
pub fn ncls_word(c: NCls) : String = match c {
  NCFn         -> "function"
  NCType       -> "type"
  NCEffect     -> "effect"
  NCConst      -> "constant"
  NCProtocol   -> "protocol"
  NCCtor       -> "constructor"
  NCKind       -> "kind"
  NCExternType -> "extern type"
  NCUnit       -> "unit"
  NCModule     -> "module"
  NCBuiltin    -> "builtin"
  NCMethod     -> "method"
}

#[doc("True when two name classes are the same namespace.")]
pub fn ncls_same(a: NCls, b: NCls) : Bool = ncls_word(a) == ncls_word(b)

#[doc("The id a symbol table gives the entry `e`.")]
pub fn nent_sym(e: NEnt) : SymId = match e {
  NEnt(cls, name, home, _) -> sym_derive_word(ncls_word(cls), name, home)
}

# No module home holds a '#', so a scope never spells a module and the
# module is everything before the first one.
fn impl_scope_mark() : String = "#impl:"

#[doc("The scope the methods of an impl block are declared in: the block's module and `key`, which no other impl block of that module carries.")]
pub fn impl_scope_keyed(home: String, key: String) : String =
  string_concat(string_concat(home, impl_scope_mark()), key)

#[doc("The scope of the impl block written at `line`:`col` of the module `home`.")]
pub fn impl_scope(home: String, line: Int, col: Int) : String =
  impl_scope_keyed(home, string_concat(string_concat(int_to_string(line), ":"), int_to_string(col)))

#[doc("The module an impl scope belongs to.")]
pub fn impl_scope_module(scope: String) : String = scope_module_at(scope, 0, string_length(scope))

fn scope_module_at(scope: String, i: Int, n: Int) : String =
  if i >= n { scope }
  else if string_byte_at_int(scope, i) == 35 { string_slice(scope, 0, i) }
  else { scope_module_at(scope, i + 1, n) }

#[doc("The id of the method `op` of the impl block whose scope is `scope`.")]
pub fn method_sym(op: String, scope: String) : SymId = sym_derive_word(ncls_word(NCMethod), op, scope)

#[doc("The entry of the method `op` of the impl block whose scope is `scope`.")]
pub fn method_ent(op: String, scope: String) : NEnt = NEnt(NCMethod, op, scope, false)

#[doc("Only the entries of class `cls`.")]
pub fn nt_only(t: [NEnt], cls: NCls) : [NEnt] = match t {
  [] -> []
  [NEnt(c, n, h, p), ...rest] ->
    if ncls_same(c, cls) { [NEnt(c, n, h, p), ...nt_only(rest, cls)] }
    else { nt_only(rest, cls) }
}
