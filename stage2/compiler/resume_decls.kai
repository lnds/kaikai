#[doc("""
Program walk for the non-tail `resume` split: every op clause of every
`handle` is split where it resumes in non-tail position. A clause the
split cannot express is replaced by `$resume_bad` markers the typer
reports with their span, so the walk is the only pass over the program.
A default handler has no handle exit to apply a deferred tail at, so
its clauses must resume in tail position.
""")]

import compiler.ast
import compiler.handler_alias
import compiler.emit_shared
import compiler.resume_scan
import compiler.handle_presence
import compiler.resume_segment

#[doc("Split every op clause of `ds` that resumes in non-tail position.")]
pub fn split_resume_decls(ds: [Decl]) : [Decl] = map(ds, rsd_decl)

fn rsd_decl(d: Decl) : Decl = match d {
  DFn(pub_, n, tps, ps, ret, row, body, l, c, mo, fsym) -> DFn(pub_, n, tps, ps, ret, row, rsd_body(body), l, c, mo, fsym)
  DTest(desc, body, l, c, mo)      -> DTest(desc, rsd_body(body), l, c, mo)
  DBench(desc, body, l, c, mo)     -> DBench(desc, rsd_body(body), l, c, mo)
  DCheck(desc, ps, body, l, c, mo) -> DCheck(desc, ps, rsd_body(body), l, c, mo)
  DImpl(p, tas, tgt, inner, l, c, tps, isym) -> DImpl(p, tas, tgt, map(inner, rsd_decl), l, c, tps, isym)
  DDerive(ns, inner, l, c)         -> DDerive(ns, rsd_decl(inner), l, c)
  DUnstable(inner, l, c)           -> DUnstable(rsd_decl(inner), l, c)
  DProtoLaws(thy, inner, l, c, mo) -> DProtoLaws(thy, rsd_decl(inner), l, c, mo)
  DImplAxiom(thy, inner, l, c, mo) -> DImplAxiom(thy, rsd_decl(inner), l, c, mo)
  DConstructor(inner, l, c)        -> DConstructor(rsd_decl(inner), l, c)
  DDoc(a, b, inner, l, c)          -> DDoc(a, b, rsd_decl(inner), l, c)
  DConst(pub_, n, ty, init, mo, l, c, csym) -> DConst(pub_, n, ty, rsd_body(init), mo, l, c, csym)
  DEffect(pub_, n, tps, ops, dflt, l, c, mo, esym) -> DEffect(pub_, n, tps, ops, rsd_default(dflt), l, c, mo, esym)
  _ -> d
}

fn rsd_default(dflt: Option[DefaultBlock]) : Option[DefaultBlock] = match dflt {
  Some(DBlk(cs, ret, l, c)) -> Some(DBlk(map(cs, rsd_default_clause), map_opt_return_exprs(ret, rsd_expr), l, c))
  None -> None
}

# A body that installs no handler is returned as is: the rebuild would cost
# every program, and almost none has a clause to split.
fn rsd_body(e: Expr) : Expr = if holds_handle(e) { rsd_expr(e) } else { e }

fn rsd_expr(e: Expr) : Expr = Expr { kind: rsd_kind(e), line: e.line, col: e.col, ty: e.ty, mode: e.mode }

# Handles nested in a clause are placed first; to the clause they are opaque.
fn rsd_kind(e: Expr) : ExprKind = match e.kind {
  EHandle(body, eff, hs, tys, init, alias, cs, ret) -> {
    let parts = HandleParts { body: rsd_expr(body), eff: eff, hsym: hs, tys: tys,
                              init: map_opt_expr(init, rsd_expr), alias: alias,
                              clauses: map(cs, rsd_clause), ret: map_opt_return_exprs(ret, rsd_expr) }
    place_handle(parts, e)
  }
  k -> map_expr_kind(k, rsd_expr)
}

fn rsd_clause(c: HClause) : HClause = match c {
  HC(n, ps, body, l, col) -> HC(n, ps, rsd_expr(body), l, col)
}

# A default clause is never split (it must resume in tail position), but a
# `handle` inside it is.
fn rsd_default_clause(c: HClause) : HClause = match c {
  HC(n, ps, body, l, col) -> {
    let body1 = rsd_expr(body)
    let tail_only = match clause_continuation(ps) {
      Some(k) -> rs_all_tail(body1, k)
      None    -> true
    }
    if tail_only { HC(n, ps, body1, l, col) }
    else { HC(n, ps, rs_bad_body(body1, [rs_default_nontail(l, col)]), l, col) }
  }
}
