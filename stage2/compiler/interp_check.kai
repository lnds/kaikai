#[doc("""
The gate for a `.` inside a `#{...}` body that no pipe stage owns.

A `|`, `||` or `|?` stage claims every `.` on its right side, those in
interpolation bodies included. A body outside any stage keeps its `.`:
a bare one, or a point-free section that would be shown as a function.
A `.` wrapped by the call-argument rule inside the body is its own.
""")]

import compiler.ast
import compiler.diag
import compiler.diag_file
import compiler.expr_positions

#[doc("The error for every `.` in an interpolation body that no pipe stage owns, in source order.")]
pub fn check_interp_dots(ds: [Decl], df: DiagFiles) : [Diagnostic] =
  finalize_diags(ic_decls(ds, df, []))

fn ic_decls(ds: [Decl], df: DiagFiles, acc: [Diagnostic]) : [Diagnostic] = match ds {
  [] -> acc
  [d, ...rest] -> ic_decls(rest, df, ic_decl(d, df, acc))
}

fn ic_decl(d: Decl, df: DiagFiles, acc: [Diagnostic]) : [Diagnostic] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _) -> ic_expr(body, decl_diag_file(d, df), acc)
  DTest(_, body, _, _, _)              -> ic_expr(body, decl_diag_file(d, df), acc)
  DBench(_, body, _, _, _)             -> ic_expr(body, decl_diag_file(d, df), acc)
  DCheck(_, _, body, _, _, _)          -> ic_expr(body, decl_diag_file(d, df), acc)
  DImpl(_, _, _, subs, _, _, _, _)        -> ic_decls(subs, df, acc)
  DDerive(_, inner, _, _)              -> ic_decl(inner, df, acc)
  DUnstable(inner, _, _)               -> ic_decl(inner, df, acc)
  DConstructor(inner, _, _)            -> ic_decl(inner, df, acc)
  DProtoLaws(_, inner, _, _, _)        -> ic_decl(inner, df, acc)
  DImplAxiom(_, inner, _, _, _)        -> ic_decl(inner, df, acc)
  _ -> acc
}

fn ic_expr(e: Expr, file: String, acc: [Diagnostic]) : [Diagnostic] = match e.kind {
  ECall(f, xs) -> match f.kind {
    EMark(MkInterpShow) -> ic_exprs(xs, file, ic_holes(xs, file, acc))
    _                   -> ic_kids(e.kind, file, acc)
  }
  k -> ic_kids(k, file, acc)
}

# The descent enumerates children directly rather than through
# `xp_positions`: that table materialises a fresh `[XPos]` per node, and
# a whole-program scan visits two orders of magnitude more nodes than it
# finds interpolations, so the array is allocated and dropped unread.
fn ic_kids(k: ExprKind, file: String, acc: [Diagnostic]) : [Diagnostic] = match k {
  ECall(f, xs)          -> ic_exprs(xs, file, ic_expr(f, file, acc))
  EField(x, _)          -> ic_expr(x, file, acc)
  EIndex(a, b)          -> ic_expr(b, file, ic_expr(a, file, acc))
  EBinop(_, a, b)       -> ic_expr(b, file, ic_expr(a, file, acc))
  EUnop(_, x)           -> ic_expr(x, file, acc)
  EIf(c, t_, eo)        -> ic_expr_opt(eo, file, ic_expr(t_, file, ic_expr(c, file, acc)))
  EMatch(scr, arms)     -> ic_arms(arms, file, ic_expr(scr, file, acc))
  ELambda(_, b)         -> ic_expr(b, file, acc)
  ERecordLit(_, fs)     -> ic_fields(fs, file, acc)
  EList(els)            -> ic_elems(els, file, acc)
  ERange(a, b, st)      -> ic_expr_opt(st, file, ic_expr(b, file, ic_expr(a, file, acc)))
  EBlock(ss, tail)      -> ic_expr_opt(tail, file, ic_stmts(ss, file, acc))
  EPipe(a, b)           -> ic_expr(b, file, ic_expr(a, file, acc))
  EDispatchPipe(_, a, b) -> ic_expr(b, file, ic_expr(a, file, acc))
  EHandle(body, _, _, init, _, cs, ret) ->
    ic_hreturn_opt(ret, file, ic_hclauses(cs, file, ic_expr_opt(init, file, ic_expr(body, file, acc))))
  ELitUnit(inner, _)    -> ic_expr(inner, file, acc)
  EBang(inner)          -> ic_expr(inner, file, acc)
  EIntrinsic(_, xs)     -> ic_exprs(xs, file, acc)
  ESurface(sf)          -> ic_exprs(surface_children(sf), file, acc)
  _ -> acc
}

fn ic_exprs(es: [Expr], file: String, acc: [Diagnostic]) : [Diagnostic] = match es {
  [] -> acc
  [h, ...rest] -> ic_exprs(rest, file, ic_expr(h, file, acc))
}

fn ic_expr_opt(o: Option[Expr], file: String, acc: [Diagnostic]) : [Diagnostic] = match o {
  None    -> acc
  Some(x) -> ic_expr(x, file, acc)
}

fn ic_arms(arms: [Arm], file: String, acc: [Diagnostic]) : [Diagnostic] = match arms {
  [] -> acc
  [Arm(_, g, body), ...rest] -> ic_arms(rest, file, ic_expr(body, file, ic_expr_opt(g, file, acc)))
}

fn ic_fields(fs: [FieldInit], file: String, acc: [Diagnostic]) : [Diagnostic] = match fs {
  [] -> acc
  [FI(_, e), ...rest] -> ic_fields(rest, file, ic_expr(e, file, acc))
}

fn ic_elems(els: [ListElem], file: String, acc: [Diagnostic]) : [Diagnostic] = match els {
  [] -> acc
  [h, ...rest] -> ic_elems(rest, file, match h {
    ElPlain(e)  -> ic_expr(e, file, acc)
    ElSpread(e) -> ic_expr(e, file, acc)
  })
}

fn ic_stmts(ss: [Stmt], file: String, acc: [Diagnostic]) : [Diagnostic] = match ss {
  [] -> acc
  [h, ...rest] -> ic_stmts(rest, file, ic_stmt(h, file, acc))
}

fn ic_stmt(s: Stmt, file: String, acc: [Diagnostic]) : [Diagnostic] = match s {
  SLet(_, _, rhs)              -> ic_expr(rhs, file, acc)
  SAssert(c, m)                -> ic_expr_opt(m, file, ic_expr(c, file, acc))
  SExprStmt(e)                 -> ic_expr(e, file, acc)
  SIndexAssign(a, i, v, _, _)  -> ic_expr(v, file, ic_expr(i, file, ic_expr(a, file, acc)))
  SAssign(l, v, _, _)          -> ic_expr(v, file, ic_expr(l, file, acc))
  SVar(_, _, init, _, _)       -> ic_expr(init, file, acc)
  SUse(_, _, _)                -> acc
}

fn ic_hclauses(cs: [HClause], file: String, acc: [Diagnostic]) : [Diagnostic] = match cs {
  [] -> acc
  [HC(_, _, body, _, _), ...rest] -> ic_hclauses(rest, file, ic_expr(body, file, acc))
}

fn ic_hreturn_opt(o: Option[HReturn], file: String, acc: [Diagnostic]) : [Diagnostic] = match o {
  None -> acc
  Some(HR(_, body, _, _)) -> ic_expr(body, file, acc)
}

fn ic_holes(xs: [Expr], file: String, acc: [Diagnostic]) : [Diagnostic] = match xs {
  [hole] -> match stray_dot(hole) {
    Some(d) -> [ic_report(file, d.line, d.col), ...acc]
    None    -> acc
  }
  _ -> acc
}

fn ic_report(file: String, line: Int, col: Int) : Diagnostic =
  mk_diag(SevError, file, line, col, "`.` inside `\x23{...}` is not in a pipe stage",
          [ri_help(file, line, col, "a `|`, `||` or `|?` stage gives `.` its element, as in `xs | println(\"\x23{.}\")`; elsewhere, name the value")])

# The body itself may be a section; below it, a section is an argument
# the call rule already owns. A nested body is checked on its own.
fn stray_dot(hole: Expr) : Option[Expr] = match hole.kind {
  ELambda(ps, _) -> if params_point_free(ps) { Some(hole) } else { None }
  _              -> bare_dot(hole)
}

fn bare_dot(e: Expr) : Option[Expr] = match e.kind {
  EPlaceholder                 -> Some(e)
  ELambda(_, _)                -> None
  EHandle(_, _, _, _, _, _, _) -> None
  ECall(f, _) -> match f.kind {
    EMark(MkInterpShow) -> None
    _                   -> bare_dot_in(xp_positions(e))
  }
  _ -> bare_dot_in(xp_positions(e))
}

fn bare_dot_in(ps: [XPos]) : Option[Expr] = match ps {
  [] -> None
  [XP(_, x), ...rest] -> match bare_dot(x) {
    Some(d) -> Some(d)
    None    -> bare_dot_in(rest)
  }
}
