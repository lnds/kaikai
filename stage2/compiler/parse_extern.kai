#[doc("`extern` and `axiom` declarations.")]

import compiler.util
import compiler.lex_tokens
import compiler.ast
import compiler.decl_names
import compiler.parse_state
import compiler.parse_type_decls
import compiler.parse_types
import compiler.parse_fns
import compiler.parse_effects
import compiler.parse_extern_check

type FnHead = { p: Parser, is_pub: Bool }

type PStr = { p: Parser, r: Option[String] }

type AxiomHead = {
  p0: Parser,
  is_pub: Bool,
  abi: Option[ExternAbi],
  c_sym: String,
  t: Token,
  aname: String,
  tparams: [TBinder]
}

fn fail_d(p: Parser, msg: String) : PDecl / Console = err_d(p_error_here(p, msg))

fn fail_d_at(p: Parser, t: Token, msg: String) : PDecl / Console = err_d(p_error(p, t, msg))

fn at_upper_ident(p: Parser, t: Token) : Bool = tk_is(t.kind, TkIdent) and is_upper_ident(p.src, t)

#[doc("Reports whether the parser sits on the retired `[<extern_c>]` attribute prefix.")]
pub fn parse_at_legacy_extern_c_attribute(p: Parser) : Bool =
  p_at(p, TkLbracket) and tk_is(p_peek1(p).kind, TkLt) and tk_is(p_peek2(p).kind, TkIdent)
    and tok_source(p.src, p_peek2(p)) == "extern_c"

#[doc("""
Parses `extern "C"|"kai" [("symbol")] [pub] fn name(...) : T [/ row]`, `extern "C" type`
and `extern "C" opaque` after the `extern` token `t`. A C symbol override must be a valid
C identifier; under `"kai"` the symbol is mandatory.
""")]
pub fn parse_extern_decl(p: Parser, t: Token) : PDecl / Console {
  let pa = p_skip_newlines(p)
  let abi_tok = p_peek(pa)
  if not tk_is(abi_tok.kind, TkString) {
    fail_d_at(pa, abi_tok, "expected an ABI string literal after `extern` (only `\"C\"` is supported)")
  } else {
    let abi = tok_source(pa.src, abi_tok)
    if abi == "\"C\"" { extern_c_decl(p_advance(pa), t) }
    else if abi == "\"kai\"" { extern_kai_decl(p_advance(pa), t) }
    else { fail_d_at(pa, abi_tok, concat_all(["unsupported FFI ABI ", abi, " — only \"C\" is supported"])) }
  }
}

fn extern_c_decl(p: Parser, t: Token) : PDecl / Console {
  let head = p_peek(p)
  if tk_is(head.kind, TkType) { extern_struct_decl(p_advance(p), t) }
  else if tk_is(head.kind, TkIdent) and tok_source(p.src, head) == "opaque" { extern_opaque_decl(p_advance(p), t) }
  else {
    let over = parse_optional_c_override(p)
    match over.r {
      None -> err_d(over.p)
      Some(sym) -> validate_extern_c_decl(
        extern_fn(over.p, "expected `fn`, `type`, or `opaque` after `extern \"C\"` (FFI declarations look like `extern \"C\" fn name(...) : T / Ffi`)", AbiC, sym, t), t)
    }
  }
}

fn extern_kai_decl(p: Parser, t: Token) : PDecl / Console {
  let over = parse_optional_c_override(p)
  match over.r {
    None -> err_d(over.p)
    Some("") -> fail_d(p, "`extern \"kai\"` needs its runtime symbol: `extern \"kai\"(\"kai_core_<name>\") fn ...`")
    Some(sym) -> extern_fn(over.p, "expected `fn` after `extern \"kai\"(\"<symbol>\")`", AbiKai, sym, t)
  }
}

fn extern_fn_head(p: Parser, msg: String) : FnHead / Console {
  let p1 = p_skip_newlines(p)
  let is_pub = p_at(p1, TkPub)
  FnHead { p: p_eat(if is_pub { p_advance_nl(p1) } else { p1 }, TkFn, msg), is_pub: is_pub }
}

fn extern_fn(p: Parser, msg: String, abi: ExternAbi, sym: String, t: Token) : PDecl / Console {
  let h = extern_fn_head(p, msg)
  if p_failed(h.p) { err_d(h.p) } else { parse_axiom_decl(h.p, h.is_pub, Some(abi), sym, t) }
}

fn parse_optional_c_override(p: Parser) : PStr / Console =
  if not p_at(p, TkLparen) { PStr { p: p, r: Some("") } }
  else {
    let p1 = p_advance(p)
    let tok = p_peek(p1)
    if tk_is(tok.kind, TkString) { c_symbol_override(p1, tok) }
    else { PStr { p: p_error(p1, tok, "expected a C-symbol string literal inside `extern \"C\"(...)`"), r: None } }
  }

fn c_symbol_override(p: Parser, tok: Token) : PStr / Console {
  let span = tok_source(p.src, tok)
  let n = string_length(span)
  let sym = if n >= 2 { string_slice(span, 1, n - 2) } else { "" }
  if not is_valid_c_identifier(sym) {
    PStr { p: p_error(p, tok, concat_all(["invalid C symbol override ", span, " — must match `[A-Za-z_][A-Za-z0-9_]*`"])), r: None }
  } else {
    let p1 = p_eat(p_advance(p), TkRparen, "expected `)` to close `extern \"C\"(\"<symbol>\")` override")
    PStr { p: p1, r: if p_failed(p1) { None } else { Some(sym) } }
  }
}

fn extern_struct_decl(p: Parser, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not at_upper_ident(p, id) { fail_d_at(p, id, "expected an uppercase type name after `extern \"C\" type`") }
  else {
    let p1 = p_eat(p_advance_nl(p), TkEq, "expected `=` in `extern \"C\" type` declaration")
    if p_failed(p1) { err_d(p1) } else { extern_struct_body(p_skip_newlines(p1), tok_source(p.src, id), t) }
  }
}

fn extern_struct_body(p: Parser, name: String, t: Token) : PDecl / Console {
  let p1 = p_eat(p, TkLbrace, "expected `{` — `extern \"C\" type` must be a struct body `{ field: T, ... }`")
  if p_failed(p1) { err_d(p1) }
  else {
    let body = parse_record_body(p_skip_newlines(p1), [], false, name, [], [], t)
    match body.r {
      None -> body
      Some(DType(_, _, _, TBRecord(fields), _, _, _, _)) -> validate_extern_struct_decl(name, fields, body.p, t)
      Some(_) -> fail_d_at(body.p, t, "internal: extern struct body did not parse as a record")
    }
  }
}

fn extern_opaque_decl(p: Parser, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not at_upper_ident(p, id) { fail_d_at(p, id, "expected an uppercase type name after `extern \"C\" opaque`") }
  else {
    let name = tok_source(p.src, id)
    ok_dn(p_advance(p), DExternType(name, ETOpaque, t.line, t.col, None), [p_ent(p, NCExternType, name, true)])
  }
}

#[doc("""
Parses `name[tparams](params) : T / row` of an axiom; the return type is required and
a body is rejected. `c_sym_over` is the C-symbol override, empty when absent.
""")]
pub fn parse_axiom_decl(p: Parser, is_pub: Bool, abi: Option[ExternAbi], c_sym_over: String, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) { fail_d_at(p, id, "expected axiom name") }
  else if is_some(abi) and is_upper_ident(p.src, id) { fail_d_at(p, id, "function names must start with a lowercase letter") }
  else {
    let tp = parse_opt_type_params(p_advance(p))
    match tp.r {
      None -> err_d(tp.p)
      Some(tparams) -> axiom_params(tp.p, AxiomHead { p0: p, is_pub: is_pub, abi: abi, c_sym: c_sym_over,
                                                      t: t, aname: tok_source(p.src, id), tparams: tparams })
    }
  }
}

fn axiom_params(p: Parser, h: AxiomHead) : PDecl / Console {
  let p1 = p_eat(p, TkLparen, "expected `(` after axiom name")
  if p_failed(p1) { err_d(p1) }
  else {
    let ps = parse_fn_params(p_skip_newlines(p1), [])
    match ps.r {
      None -> err_d(ps.p)
      Some(params) -> axiom_ret(p_skip_newlines(ps.p), h, params)
    }
  }
}

fn axiom_ret(p: Parser, h: AxiomHead, params: [Param]) : PDecl / Console {
  let p1 = p_eat(p, TkColon, "axiom requires a return type — write `axiom name(...) : T`")
  if p_failed(p1) { err_d(p1) }
  else {
    let rt = parse_type(p1)
    match rt.r {
      None -> err_d(rt.p)
      Some(ty) -> axiom_tail(rt.p, h, params, ty)
    }
  }
}

fn axiom_tail(p: Parser, h: AxiomHead, params: [Param], ty: TypeExpr) : PDecl / Console {
  let row = parse_row_suffix(p)
  let p1 = p_skip_newlines(row.p)
  if p_at(p1, TkEq) or p_at(p1, TkLbrace) { fail_d(p1, "axiom must not have a body — drop the `=` / `{` and trailing block") }
  else {
    ok_dn(row.p, DAxiom(h.is_pub, h.abi, h.aname, h.c_sym, h.tparams, params, ty, row.r, h.t.line, h.t.col),
          [p_ent(h.p0, NCFn, h.aname, h.is_pub)])
  }
}
