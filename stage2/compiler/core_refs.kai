#[doc("Which core functions, modules and protocols a program refers to.")]

import compiler.ast
import compiler.ast_ids
import compiler.ast_ids
import compiler.symtab

#[doc("A core function the compiler inserts after name resolution.")]
pub(pkg) type CoreFn = CfMapFoldl | CfMapSum | CfMapProduct | CfListLength
  | CfRangeMapFoldl | CfRangeMapSum | CfRangeMapProduct | CfRangeLength | CfRangeMapCollectVec
  | CfRangeStepMapFoldl | CfRangeStepMapSum | CfRangeStepMapProduct | CfRangeStepLength
  | CfRangeStepMapCollectVec
  | CfPipeMap | CfPipeFlatMap | CfPipeFilter | CfPipeEach

type CoreTrigger = TrDispatchPipe(PipeOp) | TrRangeApply | TrSteppedApply

fn core_fn_module(cf: CoreFn) : Option[CoreModule] = match cf {
  CfMapFoldl    -> Some(CmList)
  CfMapSum      -> Some(CmList)
  CfMapProduct  -> Some(CmList)
  CfListLength  -> Some(CmList)
  CfPipeMap     -> None
  CfPipeFlatMap -> None
  CfPipeFilter  -> None
  CfPipeEach    -> None
  _             -> Some(CmProtocols)
}

#[doc("The declaration of a `CoreFn` a core module declares; none when it is the pipe head type's own module's.")]
pub(pkg) fn core_fn_id(cf: CoreFn) : Option[SymId] = match core_fn_module(cf) {
  Some(m) -> Some(sym_derive(NCFn, core_fn_name(cf), core_module_name(m)))
  None    -> None
}

#[doc("The declared name of a `CoreFn`.")]
pub(pkg) fn core_fn_name(cf: CoreFn) : String = match cf {
  CfMapFoldl               -> "map_foldl"
  CfMapSum                 -> "map_sum"
  CfMapProduct             -> "map_product"
  CfListLength             -> "length"
  CfRangeMapFoldl          -> "range_map_foldl"
  CfRangeMapSum            -> "range_map_sum"
  CfRangeMapProduct        -> "range_map_product"
  CfRangeLength            -> "range_length"
  CfRangeMapCollectVec     -> "range_map_collect_vec"
  CfRangeStepMapFoldl      -> "range_step_map_foldl"
  CfRangeStepMapSum        -> "range_step_map_sum"
  CfRangeStepMapProduct    -> "range_step_map_product"
  CfRangeStepLength        -> "range_step_length"
  CfRangeStepMapCollectVec -> "range_step_map_collect_vec"
  CfPipeMap                -> "map"
  CfPipeFlatMap            -> "flat_map"
  CfPipeFilter             -> "filter"
  CfPipeEach               -> "each"
}

#[doc("The `CoreFn` a dispatch pipe calls on its head type's owner.")]
pub(pkg) fn pipe_op_core_fn(op: PipeOp) : CoreFn = match op {
  PoMap     -> CfPipeMap
  PoFlatMap -> CfPipeFlatMap
  PoFilter  -> CfPipeFilter
  PoEach    -> CfPipeEach
}

#[doc("The protocol operation a binary operator is sugar for, or `BpNone`.")]
pub(pkg) type BinopProto = BpAdd | BpSub | BpMul | BpDiv | BpRem | BpEq | BpOrd | BpNone

#[doc("The protocol operation binary operator `op` dispatches to on a type with a custom impl.")]
pub(pkg) fn binop_proto(op: BinOp) : BinopProto = match op {
  BoAdd    -> BpAdd
  BoSub    -> BpSub
  BoMul    -> BpMul
  BoDiv    -> BpDiv
  BoMod    -> BpRem
  BoEq     -> BpEq
  BoNe     -> BpEq
  BoLt     -> BpOrd
  BoGt     -> BpOrd
  BoLe     -> BpOrd
  BoGe     -> BpOrd
  BoPow    -> BpNone
  BoConcat -> BpNone
  BoAnd    -> BpNone
  BoOr     -> BpNone
}

#[doc("True for the operator protocols that combine two values of one type: `Add`, `Sub`, `Mul`, `Div`, `Rem`.")]
pub(pkg) fn bp_is_arith(bp: BinopProto) : Bool = match bp {
  BpAdd -> true
  BpSub -> true
  BpMul -> true
  BpDiv -> true
  BpRem -> true
  _     -> false
}

#[doc("The core protocol `bp` belongs to; `None` for `BpNone`.")]
pub(pkg) fn op_proto_core(bp: BinopProto) : Option[CoreProto] = match bp {
  BpAdd  -> Some(CpAdd)
  BpSub  -> Some(CpSub)
  BpMul  -> Some(CpMul)
  BpDiv  -> Some(CpDiv)
  BpRem  -> Some(CpRem)
  BpEq   -> Some(CpEq)
  BpOrd  -> Some(CpOrd)
  BpNone -> None
}

#[doc("The protocol method `bp` calls; empty for `BpNone`.")]
pub(pkg) fn op_proto_method(bp: BinopProto) : String = match bp {
  BpAdd  -> "add"
  BpSub  -> "sub"
  BpMul  -> "mul"
  BpDiv  -> "div"
  BpRem  -> "rem"
  BpEq   -> "eq"
  BpOrd  -> "cmp"
  BpNone -> ""
}

#[doc("The protocol method unary `-` calls.")]
pub(pkg) fn neg_proto_method() : String = "neg"

#[doc("True when unary `-` negates `t` with no protocol call. A type still unknown counts: the rewrite after monomorphisation reaches `Neg` once it is concrete.")]
pub(pkg) fn ty_negates(t: Ty) : Bool = match t {
  TyInt               -> true
  TyReal              -> true
  TyByte              -> true
  TyInt32             -> true
  TyUInt32            -> true
  TyUInt64            -> true
  TyInt128            -> true
  TyVarT(_)           -> true
  TyAny               -> true
  TyUnion(_)          -> true
  TyShapeApp(_, _)    -> true
  TyDimT(inner, _)    -> ty_negates(inner)
  TyRefineT(inner, _) -> ty_negates(inner)
  _                   -> false
}

#[doc("A stdlib function a pass singles out.")]
pub(pkg) type KnownFn = KfSpawn | KfSpawnActor | KfSpawnActorPolicy

#[doc("Every function with a constructor.")]
pub(pkg) fn known_fns() : [KnownFn] = [KfSpawn, KfSpawnActor, KfSpawnActorPolicy]

#[doc("The name `f` is declared with.")]
pub(pkg) fn known_fn_name(f: KnownFn) : String = match f {
  KfSpawn            -> "spawn"
  KfSpawnActor       -> "spawn_actor"
  KfSpawnActorPolicy -> "spawn_actor_policy"
}

#[doc("The home of the module that declares `f`.")]
pub(pkg) fn known_fn_home(f: KnownFn) : String = match f {
  KfSpawn            -> "spawn"
  KfSpawnActor       -> "actor"
  KfSpawnActorPolicy -> "actor"
}

#[doc("The id of `f`'s declaration.")]
pub(pkg) fn known_fn_id(f: KnownFn) : SymId = match f {
  KfSpawn            -> SymId(2706662557330909554)
  KfSpawnActor       -> SymId(5948856876204158501)
  KfSpawnActorPolicy -> SymId(4159613756523685806)
}

#[doc("The function whose declaration `s` is, or `None` for any other symbol.")]
pub(pkg) fn known_fn_of(s: SymId) : Option[KnownFn] = match sym_raw(s) {
  2706662557330909554 -> Some(KfSpawn)
  5948856876204158501 -> Some(KfSpawnActor)
  4159613756523685806 -> Some(KfSpawnActorPolicy)
  _                   -> None
}

#[doc("True when a call to `f` runs its thunk argument on a fresh fiber.")]
pub(pkg) fn known_fn_starts_fiber(f: KnownFn) : Bool = match f {
  KfSpawn            -> true
  KfSpawnActor       -> true
  KfSpawnActorPolicy -> true
}

#[doc("A core module the compiler treats specially, named without building its spelling.")]
pub(pkg) type CoreModule = CmList | CmArray | CmVec | CmOption | CmResult | CmProtocols | CmLoop

#[doc("The name the core module `m` is homed under.")]
pub(pkg) fn core_module_name(m: CoreModule) : String = match m {
  CmList      -> "list"
  CmArray     -> "array"
  CmVec       -> "collections__vec"
  CmOption    -> "option"
  CmResult    -> "result"
  CmProtocols -> "protocols"
  CmLoop      -> "loop"
}

#[doc("The core module that owns the core type `c`, the one a pipe over a `c` dispatches into; a core type no module owns has none.")]
pub(pkg) fn core_ty_owner(c: CoreTy) : Option[CoreModule] = match c {
  CtList  -> Some(CmList)
  CtArray -> Some(CmArray)
  CtVec   -> Some(CmVec)
  CtOption -> Some(CmOption)
  CtResult -> Some(CmResult)
  _       -> None
}

#[doc("The identity of the core module `m`: the id the symbol table gives its module symbol.")]
pub(pkg) fn core_module_id(m: CoreModule) : SymId = st_module_id(core_module_name(m))

fn module_is(s: SymId, m: CoreModule) : Bool =
  sym_raw(s) >= 0 and sym_raw(s) == sym_raw(core_module_id(m))

#[doc("True when the module homed at `home` is the core module `m`.")]
pub(pkg) fn home_is(home: String, m: CoreModule) : Bool = module_is(st_module_id(home), m)

#[doc("A protocol the compiler treats specially, named without building its spelling.")]
pub(pkg) type CoreProto = CpShow | CpEq | CpOrd | CpHash | CpSerialize | CpBinSerialize | CpDefault
                   | CpAdd | CpSub | CpMul | CpDiv | CpRem | CpNumeric | CpLayout | CpJson | CpNeg

fn core_protos() : [CoreProto] =
  [CpShow, CpEq, CpOrd, CpHash, CpSerialize, CpBinSerialize, CpDefault,
   CpAdd, CpSub, CpMul, CpDiv, CpRem, CpNumeric, CpLayout, CpJson, CpNeg]

#[doc("The name the core protocol `p` is declared with; a lowered symbol of a core protocol spells it too.")]
pub(pkg) fn core_proto_name(p: CoreProto) : String = match p {
  CpShow         -> "Show"
  CpEq           -> "Eq"
  CpOrd          -> "Ord"
  CpHash         -> "Hash"
  CpSerialize    -> "Serialize"
  CpBinSerialize -> "BinSerialize"
  CpDefault      -> "Default"
  CpAdd          -> "Add"
  CpSub          -> "Sub"
  CpMul          -> "Mul"
  CpDiv          -> "Div"
  CpRem          -> "Rem"
  CpNumeric      -> "Numeric"
  CpLayout       -> "Layout"
  CpJson         -> "Json"
  CpNeg          -> "Neg"
}

#[doc("The core module that declares the core protocol `p`.")]
pub(pkg) fn core_proto_home(p: CoreProto) : String = match p {
  CpNumeric -> "numeric"
  _         -> "protocols"
}

#[doc("The identity of the core protocol `p`: the id the symbol table gives its declaration.")]
pub(pkg) fn core_proto_id(p: CoreProto) : SymId = SymId(core_proto_raw(p))

# The id each protocol's name and home derive, tabulated: every impl and
# every derive asks which core protocol it has, and a derivation builds
# a string and hashes it.
fn core_proto_raw(p: CoreProto) : Int = match p {
  CpShow         -> 324175720640151984
  CpEq           -> 6489844535757717936
  CpOrd          -> 7383583460927875276
  CpHash         -> 7008855247708931562
  CpSerialize    -> 5949690116690496085
  CpBinSerialize -> 249241432970137695
  CpDefault      -> 2968505971027612293
  CpAdd          -> 8714241020345636112
  CpSub          -> 1449866653147330937
  CpMul          -> 6103677159235048853
  CpDiv          -> 6608747637486660699
  CpRem          -> 2186823117861825075
  CpNumeric      -> 4649140185815868824
  CpLayout       -> 661611131014493715
  CpJson         -> 7958965159749842472
  CpNeg          -> 8142769851737187237
}

#[doc("True when each tabulated identity is the one its declaration's name and home derive.")]
pub(pkg) fn core_protos_are_derived() : Bool =
  all(core_protos(), (p) => core_proto_raw(p) == sym_raw(sym_derive(NCProtocol, core_proto_name(p), core_proto_home(p))))

#[doc("True when the protocol `s` is the core protocol `p`. An absent id is no protocol.")]
pub(pkg) fn proto_is(s: SymId, p: CoreProto) : Bool =
  sym_raw(s) >= 0 and sym_raw(s) == core_proto_raw(p)

#[doc("The core protocol `s` is the declaration of, or `None` for any other symbol.")]
pub(pkg) fn core_proto_of(s: SymId) : Option[CoreProto] =
  if sym_raw(s) < 0 { None } else { find(core_protos(), (p) => proto_is(s, p)) }

#[doc("The core protocol spelled `name`, or `None`: what a lowered symbol's protocol part names, and what a diagnostic compares a written name against.")]
pub(pkg) fn core_proto_named(name: String) : Option[CoreProto] =
  find(core_protos(), (p) => core_proto_name(p) == name)

#[doc("True when `a` and `b` are the same core protocol.")]
pub(pkg) fn core_proto_same(a: CoreProto, b: CoreProto) : Bool =
  core_proto_name(a) == core_proto_name(b)
