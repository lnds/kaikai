# compiler/core_refs.kai -- the core functions the compiler
# inserts after name resolution, and the protocol operations operators
# are sugar for.
#
# A call the typer or a later pass synthesises is invisible to anything
# that reads the resolved program, so every such callee is a `CoreFn`
# here: the inserting pass can only spell it through `core_fn_home` /
# `core_fn_name`, and `core_fn_fires_on` names the source constructs whose
# presence makes the pass fire. Callees inserted before resolution
# (derive expansion, surface lowering, the desugars) are ordinary
# references and do not belong here.

#[doc("A core function the compiler inserts after name resolution.")]
pub type CoreFn = CfMapFoldl | CfMapSum | CfMapProduct | CfListLength
  | CfRangeMapFoldl | CfRangeMapSum | CfRangeMapProduct | CfRangeLength | CfRangeMapCollectVec
  | CfRangeStepMapFoldl | CfRangeStepMapSum | CfRangeStepMapProduct | CfRangeStepLength
  | CfRangeStepMapCollectVec
  | CfPipeMap | CfPipeFlatMap | CfPipeFilter

#[doc("A source construct whose presence makes a `CoreFn` insertion fire. `TrRangeApply` is an apply pipe `|>` whose head is a range.")]
pub type CoreTrigger = TrMapPipe | TrFlatMapPipe | TrFilterPipe | TrRangeApply

#[doc("The module declaring a `CoreFn`; empty when it is the pipe head type's own module.")]
pub fn core_fn_home(cf: CoreFn) : String = match cf {
  CfMapFoldl    -> "list"
  CfMapSum      -> "list"
  CfMapProduct  -> "list"
  CfListLength  -> "list"
  CfPipeMap     -> ""
  CfPipeFlatMap -> ""
  CfPipeFilter  -> ""
  _             -> "protocols"
}

#[doc("The declared name of a `CoreFn`.")]
pub fn core_fn_name(cf: CoreFn) : String = match cf {
  CfMapFoldl               -> "map_foldl"
  CfMapSum                 -> "map_sum"
  CfMapProduct             -> "map_product"
  CfListLength             -> "length"
  CfRangeMapFoldl          -> "range_map_foldl"
  CfRangeMapSum            -> "range_map_sum"
  CfRangeMapProduct        -> "range_map_product"
  CfRangeLength            -> "range_length"
  CfRangeMapCollectVec     -> "range_map_collect_vec"
  CfRangeStepMapFoldl      -> "range_step_map_foldl"
  CfRangeStepMapSum        -> "range_step_map_sum"
  CfRangeStepMapProduct    -> "range_step_map_product"
  CfRangeStepLength        -> "range_step_length"
  CfRangeStepMapCollectVec -> "range_step_map_collect_vec"
  CfPipeMap                -> "map"
  CfPipeFlatMap            -> "flat_map"
  CfPipeFilter             -> "filter"
}

#[doc("True when construct `t` can make the compiler insert `cf`. A range applied to a fold terminal fuses with no map stage.")]
pub fn core_fn_fires_on(cf: CoreFn, t: CoreTrigger) : Bool = match t {
  TrMapPipe     -> match cf { CfPipeFlatMap -> false  CfPipeFilter -> false  _ -> true }
  TrFlatMapPipe -> match cf { CfPipeFlatMap -> true  _ -> false }
  TrFilterPipe  -> match cf { CfPipeFilter -> true  _ -> false }
  TrRangeApply  -> core_fn_home(cf) == "protocols"
}

#[doc("The protocol operation a binary operator is sugar for, or `BpNone`.")]
pub type BinopProto = BpAdd | BpSub | BpMul | BpDiv | BpRem | BpEq | BpOrd | BpNone

#[doc("The protocol operation binary operator `op` dispatches to on a type with a custom impl.")]
pub fn binop_proto(op: String) : BinopProto =
  if op == "+" { BpAdd }
  else if op == "-" { BpSub }
  else if op == "*" { BpMul }
  else if op == "/" { BpDiv }
  else if op == "%" { BpRem }
  else if op == "==" or op == "!=" { BpEq }
  else if op == "<" or op == ">" or op == "<=" or op == ">=" { BpOrd }
  else { BpNone }

#[doc("The protocol `bp` belongs to; empty for `BpNone`.")]
pub fn op_proto_protocol(bp: BinopProto) : String = match bp {
  BpAdd  -> "Add"
  BpSub  -> "Sub"
  BpMul  -> "Mul"
  BpDiv  -> "Div"
  BpRem  -> "Rem"
  BpEq   -> "Eq"
  BpOrd  -> "Ord"
  BpNone -> ""
}

#[doc("The protocol method `bp` calls; empty for `BpNone`.")]
pub fn op_proto_method(bp: BinopProto) : String = match bp {
  BpAdd  -> "add"
  BpSub  -> "sub"
  BpMul  -> "mul"
  BpDiv  -> "div"
  BpRem  -> "rem"
  BpEq   -> "eq"
  BpOrd  -> "cmp"
  BpNone -> ""
}
