#[doc("""
Recursive-descent parser core: expressions, statements, patterns, types
and effect rows, the mutually recursive part of the grammar.
""")]

import compiler.util
import compiler.lex_tokens
import compiler.lex
import compiler.ast
import compiler.real_lit
import compiler.written
import compiler.intrinsics
import compiler.nest_limit
import compiler.interp_scan
import compiler.parse_state
import compiler.parse_literals
import compiler.parse_binop
import compiler.parse_placeholder
import compiler.parse_expr_aux
import compiler.parse_units

#[doc("Parses an expression.")]
pub fn parse_expr(p: Parser) : PExpr / Console {
  if p.depth >= nest_max() { err_e(p_too_deep(p)) }
  else {
    let r = parse_bin(p_at_depth(p, p.depth + 1), bin_pipe())
    PExpr { p: p_at_depth(r.p, p.depth), r: r.r }
  }
}

fn parse_bin(p: Parser, lo: Int) : PExpr / Console {
  let r = parse_unary(p)
  match r.r {
    None -> r
    Some(lhs) -> parse_bin_rest(r.p, lhs, lo, bin_tightest())
  }
}

fn parse_bin_rest(p: Parser, lhs: Expr, lo: Int, hi: Int) : PExpr / Console =
  match bin_op_at(p, lo, hi) {
    None -> ok_e(p, lhs)
    Some(op) -> {
      let r = parse_bin_step(op, lhs)
      match r.r {
        None -> r
        Some(e) -> parse_bin_rest(r.p, e, lo, bin_ceiling(op))
      }
    }
  }

fn parse_bin_step(op: BinOpAt, lhs: Expr) : PExpr / Console = {
  let t = op.tok
  let rhs_lo = if op.level == bin_concat() { op.level } else { op.level + 1 }
  let r = parse_bin(p_skip_newlines(p_advance(op.p)), rhs_lo)
  match r.r {
    None -> err_e(r.p)
    Some(rhs) ->
      if op.level == bin_pipe() { bin_pipe_node(r.p, t, lhs, rhs) }
      else if op.level == bin_cmp() { bin_cmp_node(r.p, t, lhs, rhs) }
      else { bin_node(r.p, t, lhs, rhs) }
  }
}

# An expression that stops before a pipe: an arrow lambda's body, whose
# trailing pipe chains at the enclosing level.
fn parse_bin_or(p: Parser) : PExpr / Console = parse_bin(p, bin_or())

fn parse_unary(p: Parser) : PExpr / Console = parse_unary_in(p)

fn parse_unary_nested(p: Parser) : PExpr / Console {
  if p.depth >= nest_max() { err_e(p_too_deep(p)) }
  else {
    let r = parse_unary_in(p_at_depth(p, p.depth + 1))
    PExpr { p: p_at_depth(r.p, p.depth), r: r.r }
  }
}

fn parse_unary_in(p: Parser) : PExpr / Console {

  let t = p_peek(p)
  if tk_is(t.kind, TkMinus) {
    let r = parse_unary_nested(p_advance(p))
    match r.r {
      None -> err_e(r.p)
      Some(e) -> ok_e(r.p, mk_expr(EUnop(UoNeg, e), t.line, t.col))
    }
  } else if tk_is(t.kind, TkNot) {
    let r = parse_unary_nested(p_advance(p))
    match r.r {
      None -> err_e(r.p)
      Some(e) -> ok_e(r.p, mk_expr(EUnop(UoNot, e), t.line, t.col))
    }
  } else if tk_is(t.kind, TkAmp) {
    # `&x` takes a reference: `Mutable.ref_make(x)`. The sigil mirrors
    # the C/C++/Go `&` address-of; `Mutable` never appears on the
    # surface but rides the inferred effect row. Binds tighter than the
    # binary operators, so `&x + 1` is `(&x) + 1` — a ref of `x`, not
    # `&(x + 1)` — matching `-`/`not` prefix precedence.
    let r = parse_unary_nested(p_advance(p))
    match r.r {
      None -> err_e(r.p)
      Some(e) -> ok_e(r.p, mk_expr(ESurface(SfRefMake(e)), t.line, t.col))
    }
  } else if tk_is(t.kind, TkAt) {
    # `@r` / `@r.field…` dereferences a first-class `Ref[T]` (OCaml `!r`
    # / C `*p`). The target path is preserved; `surface_lower` picks the
    # deref lowering by its shape.
    let p1 = p_advance(p)
    let id = p_peek(p1)
    if not tk_is(id.kind, TkIdent) {
      err_e(p_error(p1, id, "expected a `Ref` binding name after `@`"))
    } else {
      let name = tok_source(p1.src, id)
      let p2 = p_advance(p1)
      let cap = mk_name(name, id.line, id.col)
      let pr = parse_deref_path(p2, cap)
      match pr.r {
        None -> err_e(pr.p)
        Some(target) -> ok_e(pr.p, mk_expr(ESurface(SfDeref(target)), t.line, t.col))
      }
    }
  } else {
    parse_pow(p)
  }
}

# `^` — integer-exponent power. Higher precedence than `*`/`/` and
# right-associative (Haskell convention): `2 ^ 3 ^ 2` parses as
# `2 ^ (3 ^ 2)` = `2 ^ 9` = 512. The LHS is `parse_postfix` so calls
# and field accesses bind tighter than `^`; the RHS calls back into
# `parse_unary` so a leading sign on the exponent (`r ^ -2`) lexes
# as `EUnop(UoNeg, EInt(2))`. The typer treats `^` specially: when the
# base has a non-trivial unit, the exponent must be a literal Int
# (or `-Int`) so the result unit `u^n` resolves at compile time.
fn parse_pow(p: Parser) : PExpr / Console {

  let r = parse_postfix(p)
  match r.r {
    None -> r
    Some(lhs) -> parse_pow_rest(r.p, lhs)
  }
}

fn parse_pow_rest(p: Parser, lhs: Expr) : PExpr / Console {

  if p_at(p, TkCaret) {
    let t = p_peek(p)
    let rr = parse_unary_nested(p_skip_newlines(p_advance(p)))
    match rr.r {
      None -> err_e(rr.p)
      Some(rhs) -> ok_e(rr.p, mk_expr(EBinop(BoPow, lhs, rhs), t.line, t.col))
    }
  } else {
    let p_look = p_skip_newlines(p)
    if p_at(p_look, TkCaret) {
      let t = p_peek(p_look)
      let rr = parse_unary_nested(p_skip_newlines(p_advance(p_look)))
      match rr.r {
        None -> err_e(rr.p)
        Some(rhs) -> ok_e(rr.p, mk_expr(EBinop(BoPow, lhs, rhs), t.line, t.col))
      }
    } else { ok_e(p, lhs) }
  }
}

fn parse_postfix(p: Parser) : PExpr / Console {

  let r = parse_primary(p)
  match r.r {
    None -> r
    Some(e) -> parse_postfix_rest(r.p, e)
  }
}

fn parse_postfix_rest(p: Parser, lhs: Expr) : PExpr / Console {

  let t = p_peek(p)
  if tk_is(t.kind, TkLparen) {
    # Call arguments are a delimited context: record literals are
    # unambiguous here, so re-enable them even inside an `if`/`match`
    # cond, then restore the cond's flag on the way out.
    let prev_rl = p.allow_record_lit
    let args_r0 = parse_call_args(p_with_record_lit(p_advance(p), true))
    let args_r = PArgs { p: p_with_record_lit(args_r0.p, prev_rl), r: args_r0.r }
    match args_r.r {
      None -> err_e(args_r.p)
      Some(xs) -> {
        # Same-line `{` after `f(args)` attaches as a trailing
        # lambda. Up to two consecutive trailings (greedy,
        # both must be on the same line as the previous token).
        # Trailing-lambda attachment is disabled for cond positions
        # (see p_with_trailing_lambda).
        let lam_r = if args_r.p.allow_trailing_lambda {
          parse_trailing_lambdas(args_r.p, xs)
        } else {
          ok_args(args_r.p, xs)
        }
        match lam_r.r {
          None -> err_e(lam_r.p)
          Some(xs1) -> {
            # Rewrite `f(. < 3)` to `f((__pl) => __pl < 3)` so the
            # placeholder sugar reaches the typer as a function value.
            # See `desugar_placeholder_arg` for the scope rules.
            let xs2 = desugar_placeholder_args(xs1)
            parse_postfix_rest(lam_r.p, mk_expr(ECall(lhs, xs2), t.line, t.col))
          }
        }
      }
    }
  } else if tk_is(t.kind, TkDot) {
    let p1 = p_advance(p)
    let id = p_peek(p1)
    if tk_is(id.kind, TkIdent) {
      let name = tok_source(p.src, id)
      parse_postfix_rest(p_advance(p1), mk_expr(EField(lhs, name), t.line, t.col))
    } else {
      err_e(p_error_here(p1, "expected field name after `.`"))
    }
  } else if tk_is(t.kind, TkLbracket) {
    # Index brackets delimit the cond, so record literals are
    # unambiguous inside; re-enable, then restore on the way out.
    let prev_rl = p.allow_record_lit
    let p1 = p_with_record_lit(p_advance(p), true)
    let r = parse_expr(p1)
    match r.r {
      None -> err_e(r.p)
      Some(first) -> {
        # `xs[a..b]` — a range index (the Vec slice surface). The
        # typer dispatches it; a stepped `a..b..s` parses too so the
        # typer can reject it with a typed diagnostic.
        let ri = parse_index_range(r.p, first)
        match ri.r {
          None -> err_e(ri.p)
          Some(idx) -> {
            let rp = p_with_record_lit(ri.p, prev_rl)
            let closed = p_expect(rp, TkRbracket, "expected `]` after index")
            match closed.r {
              None -> err_e(closed.p)
              Some(_) -> parse_postfix_rest(closed.p, mk_expr(EIndex(lhs, idx), t.line, t.col))
            }
          }
        }
      }
    }
  } else if tk_is(t.kind, TkBang) {
    # `expr!` — postfix Option/Result propagation. Binds
    # tighter than calls and field access can chain through it
    # (`f()!.field`, `xs[0]!`), but binary operators sit lower.
    parse_postfix_rest(p_advance(p), mk_expr(EBang(lhs), t.line, t.col))
  } else if tk_is(t.kind, TkLbrace) and p.allow_trailing_lambda {
    # Paren-free trailing lambda — `f { body }` desugars to
    # `f(() => body)`, optionally followed by a second trailing
    # lambda. Same-line is implicit: parse_postfix_rest does not
    # skip newlines, so a `{` appearing here is on the same source
    # line as `lhs`. Disabled inside `if` / `match` conds.
    let lam_r = parse_trailing_lambdas(p, [])
    match lam_r.r {
      None -> err_e(lam_r.p)
      Some(xs1) -> parse_postfix_rest(lam_r.p, mk_expr(ECall(lhs, xs1), t.line, t.col))
    }
  } else {
    ok_e(p, lhs)
  }
}

# Parse zero, one, or two trailing lambdas after a call site.
# Each trailing lambda must be on the same line as the
# preceding token (parse_postfix_rest never skips newlines, so a
# `TkLbrace` at the head of `p` is by construction same-line).
# `acc` is the call's existing argument list; the parsed lambdas
# are appended in source order. Returns the call's full arg list.
fn parse_trailing_lambdas(p: Parser, acc: [Expr]) : PArgs / Console {

  if p_at(p, TkLbrace) {
    let lr = parse_trailing_lambda(p)
    match lr.r {
      None -> err_args(lr.p)
      Some(lam) -> {
        let acc1 = list_append(acc, [lam])
        if p_at(lr.p, TkLbrace) {
          let lr2 = parse_trailing_lambda(lr.p)
          match lr2.r {
            None -> err_args(lr2.p)
            Some(lam2) -> ok_args(lr2.p, list_append(acc1, [lam2]))
          }
        } else {
          ok_args(lr.p, acc1)
        }
      }
    }
  } else {
    ok_args(p, acc)
  }
}

# Parse a single trailing-lambda `{ (LambdaParams "->")? Block }`.
# Position is at the `{`. Returns an `ELambda(params, body)` where
# `body` is an EBlock (the lambda's body block). The block-form
# `{ x -> body }` desugars to `(x) => body`.
fn parse_trailing_lambda(p: Parser) : PExpr / Console {

  let t = p_peek(p)
  # Consume `{`.
  let p1 = p_advance(p)
  # Decide between `(LambdaParams "->")? Block`. Peek past optional
  # newlines after `{` to see whether we're staring at a parameter
  # list. The lookahead is bounded: `Ident ("," Ident)* "->"` or
  # just `->` for zero arity.
  let p1n = p_skip_newlines(p1)
  let pp_r = try_parse_lambda_block_params(p1n)
  match pp_r {
    Some(res) -> {
      # `res.p` is positioned right after `->`. Body is a brace-less
      # block of statements terminated by `}`.
      let body_r = parse_lambda_block_body(res.p, t)
      match body_r.r {
        None -> err_e(body_r.p)
        Some(body) -> ok_e(body_r.p, wrap_lam_block(finish_block_lambda(res, body, t), true, t))
      }
    }
    None -> {
      # Zero-arity trailing lambda: no `params ->` prefix. The body
      # is the contents of the brace block. Treat as a lambda with
      # an empty parameter list whose body is the parsed block.
      let body_r = parse_lambda_block_body(p1, t)
      match body_r.r {
        None -> err_e(body_r.p)
        Some(body) -> ok_e(body_r.p, wrap_lam_block(mk_expr(ELambda([], body), t.line, t.col), true, t))
      }
    }
  }
}

# Parse the contents of a lambda-block body up to the closing `}`.
# Position is after the optional `params ->` prefix. The body is
# the same shape as a regular block: zero or more statements
# followed by an optional final expression. We reuse the existing
# parse_block_body machinery for this.
fn parse_lambda_block_body(p: Parser, t: Token) : PExpr / Console {

  let p0 = p_skip_newlines_and_semis(p)
  parse_block_body(p0, [], t)
}

fn try_parse_lambda_block_params(p: Parser) : Option[LamBlockParams] / Console {
  # Zero-arity: `{ -> body }`.
  if p_at(p, TkArrow) {
    Some(LamBlockParams { p: p_advance(p), params: [], wrap: None })
  } else if p_at(p, TkLparen) {
    try_parse_lambda_block_pattern(p)
  } else if p_at(p, TkIdent) {
    try_parse_lambda_block_params_loop(p, [])
  } else {
    None
  }
}

# A block lambda whose sole parameter is a tuple pattern: `{ (a, b) -> body }`.
# Disambiguated from a brace block opening with a parenthesised expression
# (`{ (a + b) }`) by a balanced-paren scan: a pattern binder only if `->`
# immediately follows the matching `)`. The scan reports no errors, so a
# misfire falls back to the ordinary block path.
fn try_parse_lambda_block_pattern(p: Parser) : Option[LamBlockParams] / Console {
  let after = skip_balanced_parens(p_advance(p), 1)
  if not p_at(after, TkArrow) { None }
  else {
    let pr = parse_pattern(p)
    match pr.r {
      None -> None
      Some(pat) -> {
        let p2 = p_skip_newlines(pr.p)
        if not p_at(p2, TkArrow) { None }
        else {
          let fresh = binder_minted(lam_pat_binder_name(pat.line, pat.col))
          let pm = Param { binder: fresh, ptype: None, pline: pat.line, pcol: pat.col, pborrow: false }
          Some(LamBlockParams { p: p_advance(p2), params: [pm], wrap: Some(pat) })
        }
      }
    }
  }
}

fn parse_call_args(p: Parser) : PArgs / Console {

  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRparen) { ok_args(p_advance(p0), []) }
  else { parse_call_args_loop(p0, []) }
}

fn parse_call_args_loop(p: Parser, acc: [Expr]) : PArgs / Console {

  let p_start = p_skip_newlines(p)
  if p_at(p_start, TkRparen) {
    # Trailing comma: `f(a, b,)` — `acc` already has all args.
    ok_args(p_advance(p_start), list_reverse(acc))
  } else {
    let r = parse_expr(p_start)
    match r.r {
      None -> err_args(r.p)
      Some(e) -> {
        let p1 = p_skip_newlines(r.p)
        if p_at(p1, TkComma) { parse_call_args_loop(p_skip_newlines(p_advance(p1)), [e, ...acc]) }
        else if p_at(p1, TkRparen) {
          ok_args(p_advance(p1), list_reverse([e, ...acc]))
        }
        else { err_args(p_error_here(p1, "expected `,` or `)` in call arguments")) }
      }
    }
  }
}

fn parse_primary(p: Parser) : PExpr / Console {

  let t = p_peek(p)
  match t.kind {
    TkInt -> {
      let span = tok_source(p.src, t)
      if int_lit_overflows(span) {
        # A hex/binary literal past 64 bits is a hard error — no
        # arbitrary-precision carrier decodes a base-prefixed span.
        if has_base_prefix(span) {
          err_e(p_error(p_advance(p), t,
            "hex/binary literal exceeds 64 bits; Int is 64-bit — use bigint.from_string"))
        } else {
          # A decimal literal past i64 keeps its lexeme in an EIntLit so
          # an annotation can mint it to BigInt/DecimalBig/Int128; the
          # typer surfaces the out-of-range error when no such context
          # is present. A unit annotation cannot follow (the carrier is
          # arbitrary-precision, not a `Real<u>`).
          ok_e(p_advance(p), mk_expr(EIntLit(span), t.line, t.col))
        }
      } else {
        let lit = mk_expr(mk_int_lit(decode_int(span), span), t.line, t.col)
        try_lit_unit_annotation(p_advance(p), lit, t)
      }
    }
    TkReal -> {
      let span = tok_source(p.src, t)
      match decode_real(span) {
        Some(r) -> try_lit_unit_annotation(p_advance(p), mk_expr(EReal(RealLit(r), span), t.line, t.col), t)
        None    -> err_e(p_error(p, t, real_range_error()))
      }
    }
    # Fixed-width integer literals. The token span covers digits +
    # width suffix; strip the suffix and tag the literal with its width
    # type, which rides the `EFixed` node (not `.ty`, which later passes
    # drop). No unit annotation can follow a width-tagged literal.
    TkInt32  -> ok_e(p_advance(p), fixed_lit(p.src, t, 3, TyInt32))
    TkUInt32 -> ok_e(p_advance(p), fixed_lit(p.src, t, 3, TyUInt32))
    TkUInt64 -> ok_e(p_advance(p), fixed_lit(p.src, t, 3, TyUInt64))
    TkInt128 -> ok_e(p_advance(p), fixed_lit(p.src, t, 4, TyInt128))
    # `<int>u8` is a Byte literal; the typer range-checks `0..255`.
    TkUInt8  -> ok_e(p_advance(p), fixed_lit(p.src, t, 2, TyByte))
    # `<num>d` is a Decimal literal. Strip the `d` and keep the lexeme in
    # an EDecimalLit; the typer folds the exact `{ raw, scale }` and
    # errors past the Int128 carrier.
    TkDecimal -> {
      let span = tok_source(p.src, t)
      let digits = string_slice(span, 0, string_length(span) - 1)
      ok_e(p_advance(p), mk_expr(EDecimalLit(digits), t.line, t.col))
    }
    # `<int>n` — a BigInt literal. The span covers digits + trailing
    # `n`; the digit string is kept as written and `surface_lower`
    # expands it to `bigint.from_literal("<digits>")` so arbitrary-
    # precision values fold exactly — never via an i64 that would wrap.
    TkBigInt -> {
      let span = tok_source(p.src, t)
      let digits = string_slice(span, 0, string_length(span) - 1)
      ok_e(p_advance(p), mk_expr(ESurface(SfBigIntLit(digits)), t.line, t.col))
    }
    # `<digits>i` desugars at parse time to
    # `complex.mk(0.0, <digits>)`. Span covers digits + trailing `i`;
    # strip the `i` before decoding. Resolver rewrites the
    # `EField(EName("complex"), "mk")` callee to an EModCall once the
    # `complex` module is bound (auto-imported via the core path).
    TkComplex -> {
      let span = tok_source(p.src, t)
      let im_span = string_slice(span, 0, string_length(span) - 1)
      match decode_real(im_span) {
        Some(im) -> {
          let zero = mk_expr(EReal(RealLit(0.0), "0.0"), t.line, t.col)
          let im_e = mk_expr(EReal(RealLit(im), im_span), t.line, t.col)
          let mod_var = mk_name("complex", t.line, t.col)
          let callee = mk_expr(EField(mod_var, "mk"), t.line, t.col)
          ok_e(p_advance(p), mk_expr(ECall(callee, [zero, im_e]), t.line, t.col))
        }
        None -> err_e(p_error(p, t, real_range_error()))
      }
    }
    TkTrue  -> ok_e(p_advance(p), mk_expr(EBool(true),  t.line, t.col))
    TkFalse -> ok_e(p_advance(p), mk_expr(EBool(false), t.line, t.col))
    TkChar  -> {
      let span = tok_source(p.src, t)
      ok_e(p_advance(p), mk_expr(EChar(decode_char(span)), t.line, t.col))
    }
    TkString -> parse_str_lit(p, t)
    TkUnderscore -> ok_e(p_advance(p), mk_expr(EUnder, t.line, t.col))
    TkDot -> {
      # `.tail` in expression position is a point-free section: it
      # desugars to `(__pl) => __pl.tail`, where `tail` is any postfix
      # chain — a single field (`.label`), a chain (`.addr.city`), a
      # method call (`.length()`), or a method call with args
      # (`.starts_with("a")`, receiver implicit via UFCS). The chain is
      # parsed by the shared postfix parser rooted at `__pl`, so it
      # stops at the first non-postfix token (`|`, `)`, newline). The
      # fully general receiver-bound `obj.method` ref form is still not
      # a value; only the leading-dot section is.
      let p1 = p_advance(p)
      let nxt = p_peek(p1)
      if tk_is(nxt.kind, TkIdent) {
        let name = tok_source(p1.src, nxt)
        let p2 = p_advance(p1)
        # The placeholder param name is mangled to avoid colliding
        # with user bindings. The body grows the rest of the postfix
        # chain inside the lambda, so `.a.b` and `.f(x)` apply to the
        # receiver, not to the synthesised function value.
        let pl = point_free_binder()
        let pl_param = Param { binder: pl, ptype: None,
                                 pline: t.line, pcol: t.col, pborrow: false }
        let pl_var = mk_local(pl.id, t.line, t.col)
        let head = mk_expr(EField(pl_var, name), t.line, t.col)
        let body_r = parse_postfix_rest(p2, head)
        match body_r.r {
          None -> body_r
          Some(body) -> ok_e(body_r.p, mk_expr(ELambda([pl_param], body), t.line, t.col))
        }
      } else {
        # Bare `.` — pipeline placeholder per syntax-sugars.md.
        ok_e(p1, mk_expr(EPlaceholder, t.line, t.col))
      }
    }
    TkHole -> ok_e(p_advance(p), mk_expr(EHole(None), t.line, t.col))
    TkHoleName(nm) -> ok_e(p_advance(p), mk_expr(EHole(Some(nm)), t.line, t.col))
    TkDollar -> parse_intrinsic(p, t)
    TkTodoBang -> parse_todo_bang(p, t)
    TkRegex -> parse_regex_sigil(p, t)
    TkIdent -> parse_ident_primary(p, t)
    # `()`, `[]`, and `{}` open delimited contexts where a record
    # literal is unambiguous: re-enable it for the interior even inside
    # an `if`/`match` cond, then restore the caller's flag on return.
    TkLparen -> restore_rl(p.allow_record_lit, parse_paren_or_lambda(p_with_record_lit(p, true), t))
    TkLbracket -> restore_rl(p.allow_record_lit, reject_endless(p, parse_list_or_range(p_with_record_lit(p, true), t)))
    TkLazy -> parse_lazy(p, t)
    TkLbrace -> restore_rl(p.allow_record_lit, parse_brace_primary(p_with_record_lit(p, true), t))
    TkIf -> parse_if(p, t)
    TkMatch -> parse_match(p, t)
    TkHandle -> parse_handle(p_advance(p), t)
    # `%{ }` / `%[ ]` collection literals. Only in primary position:
    # infix `a % b` (modulo) is consumed by `parse_mul_rest` and never
    # reaches here. A `%` not followed by `{`/`[` falls back to the
    # expression error inside `parse_collection_lit`.
    TkPercent -> parse_collection_lit(p, t)
    _ -> err_e(p_error_here(p, "expected expression"))
  }
}

# A string literal. Each `#{...}` body of one that interpolates is
# parsed here, at the position it occupies in the file.
fn parse_str_lit(p: Parser, t: Token) : PExpr / Console {
  let span = tok_source(p.src, t)
  let is_triple =
    string_length(span) >= 6 and
    match char_at(span, 0) { Some(c) -> c == '"' _ -> false } and
    match char_at(span, 1) { Some(c) -> c == '"' _ -> false } and
    match char_at(span, 2) { Some(c) -> c == '"' _ -> false }
  if span_interpolates(span, is_triple) {
    let at = InterpPos { line: t.line, col: t.col + interp_lead(is_triple) }
    let parts = interp_parts(span, is_triple)
    let r = parse_interp_bodies(p, parts, at, [])
    match r.r {
      None        -> err_e(r.p)
      Some(holes) -> ok_e(p_advance(r.p), mk_expr(ESurface(SfInterp(span, is_triple, parts, holes)), t.line, t.col))
    }
  } else { ok_e(p_advance(p), mk_expr(EStr(span, is_triple), t.line, t.col)) }
}

fn parse_interp_bodies(p: Parser, parts: [IPart], at: InterpPos, acc: [Expr]) : PArgs / Console = match parts {
  [] -> ok_args(p, list_reverse(acc))
  [IpLit(piece, _), ...rest] -> parse_interp_bodies(p, rest, interp_pos_advance(at, piece, 0), acc)
  [IpExp(src), ...rest] -> {
    let body = interp_pos_body(at)
    let toks = map(tokenize(src), (tk) => tok_at(tk, body.line, body.col))
    let sub = parse_expr(Parser { ...p, file: interp_parse_file(), src: src, rest: toks, error: None,
                                  allow_trailing_lambda: true, allow_record_lit: true })
    match sub.r {
      None    -> err_args(p_interp_fail(p, src, body, sub.p.error))
      Some(x) -> parse_interp_bodies(p, rest, interp_pos_past(body, src), [x, ...acc])
    }
  }
}

# `$<ident>(args)` — a compiler intrinsic call.
# Caller has already peeked `TkDollar` at `t`; `p` is positioned on
# the `$` token itself. The parser:
#   1. consumes the `$`,
#   2. requires an immediately-following identifier (no whitespace
#      logic — the lexer already skipped newlines into `t`),
#   3. requires a `(arg, ...)` arglist,
#   4. produces `EIntrinsic(intrinsic, args)`.
# Per-intrinsic shape rules (arity, arg kind, context) are enforced
# later by the typer, not here — the parser's job is to deliver the
# call shape to the AST.
fn parse_intrinsic(p: Parser, t: Token) : PExpr / Console {

  let p1 = p_advance(p)
  let id = p_peek(p1)
  if not tk_is(id.kind, TkIdent) {
    err_e(p_error(p1, id, "expected an intrinsic name after `$` (e.g. `$extern_handler(\"sym\")`)"))
  } else {
    let name = tok_source(p1.src, id)
    let p2 = p_advance(p1)
    if not p_at(p2, TkLparen) {
      err_e(p_error_here(p2,
        "expected `(` to start the intrinsic argument list — write `$NAME(args)`"))
    } else {
      let p3 = p_advance(p2)
      let args_r = parse_call_args(p3)
      match args_r.r {
        None    -> err_e(args_r.p)
        Some(args_) -> ok_e(args_r.p, mk_expr(EIntrinsic(intrinsic_of_name(name), args_), t.line, t.col))
      }
    }
  }
}

# `handle { body } with Eff [as alias] { clauses }`. Both blocks
# are parsed by handle-specific rules; the body is an ordinary
# block expression, the clauses
# block contains `op_name(args, resume) -> body` plus an optional
# `return(x) -> body` at the end.
fn parse_handle(p: Parser, t: Token) : PExpr / Console {
  if not p_at(p, TkLbrace) {
    err_e(p_error_here(p, "expected `{` to start handle body"))
  } else {
    let body_r = parse_block(p, p_peek(p))
    match body_r.r {
      None -> err_e(body_r.p)
      Some(body) -> parse_handle_with(p_skip_newlines(body_r.p), t, body)
    }
  }
}

fn parse_handle_with(p1: Parser, t: Token, body: Expr) : PExpr / Console {
  if not p_at(p1, TkWith) {
    err_e(p_error_here(p1, "expected `with` after handle body"))
  } else {
    let p2 = p_advance(p1)
    let eff_t = p_peek(p2)
    if not tk_is(eff_t.kind, TkIdent) {
      err_e(p_error(p2, eff_t, "expected effect name after `with`"))
    } else {
      parse_handle_effect(p2, eff_t, t, body)
    }
  }
}

fn parse_handle_effect(p2: Parser, eff_t: Token, t: Token, body: Expr) : PExpr / Console {
  let eff_q = parse_qualified_head_name(p2, eff_t)
  let p3 = eff_q.p
  let tyargs_r =
    if p_at(p3, TkLbracket) {
      parse_row_label_args(p_skip_newlines(p_advance(p3)), [])
    } else {
      PRowArgs { p: p3, r: Some([]) }
    }
  match tyargs_r.r {
    None -> err_e(tyargs_r.p)
    Some(eff_tyargs) -> parse_handle_init(tyargs_r.p, t, body, eff_q.dref, eff_tyargs)
  }
}

fn parse_handle_init(p: Parser, t: Token, body: Expr, eff_name: DeclRef,
                     eff_tyargs: [TypeExpr]) : PExpr / Console {
  let init_r = parse_handler_state_init(p)
  let init_failed =
    if init_r.has_init {
      match init_r.r { None -> true Some(_) -> false }
    } else { false }
  if init_failed {
    err_e(init_r.p)
  } else {
    parse_handle_clause_block(init_r, t, body, eff_name, eff_tyargs)
  }
}

fn parse_handler_state_init(p: Parser) : PInit / Console {
  if p_at(p, TkLparen) {
    let ie = parse_expr(p_skip_newlines(p_advance(p)))
    match ie.r {
      None -> PInit { p: ie.p, r: None, has_init: true }
      Some(ix) -> {
        let p_ic = p_skip_newlines(ie.p)
        if not p_at(p_ic, TkRparen) {
          PInit { p: p_error_here(p_ic, "expected `)` after handler-state initializer"),
                  r: None, has_init: true }
        } else {
          PInit { p: p_advance(p_ic), r: Some(ix), has_init: true }
        }
      }
    }
  } else {
    PInit { p: p, r: None, has_init: false }
  }
}

fn parse_handle_clause_block(init_r: PInit, t: Token, body: Expr, eff_name: DeclRef,
                             eff_tyargs: [TypeExpr]) : PExpr / Console {
  let alias_r = parse_handle_alias(init_r.p)
  let p4 = p_skip_newlines(alias_r.p)
  if not p_at(p4, TkLbrace) {
    err_e(p_error_here(p4, "expected `{` to start handler clauses"))
  } else {
    let cr = parse_handle_clauses(p_skip_newlines(p_advance(p4)), [], None, [])
    match cr.r {
      None -> err_e(cr.p)
      Some(_) -> finish_handle(p4, t, body, eff_name, eff_tyargs, init_r, alias_r.r, cr)
    }
  }
}

# Handler-clause params: like fn params but the type annotation is
# optional. `print(s, resume) -> ...` is the common shape.
fn parse_clause_params(p: Parser, acc: [Param]) : PParams / Console {

  if p_at(p, TkRparen) { PParams { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else {
    let t = p_peek(p)
    if not tk_is(t.kind, TkIdent) {
      PParams { p: p_error(p, t, "expected parameter name"), r: None }
    } else {
      let name = tok_source(p.src, t)
      let p1 = p_advance(p)
      let opt_ty_r =
        if p_at(p1, TkColon) {
          let rt = parse_type(p_advance(p1))
          match rt.r {
            None -> PTy { p: rt.p, r: None }
            Some(ty) -> PTy { p: rt.p, r: Some(ty) }
          }
        } else {
          PTy { p: p1, r: None }
        }
      let pm = Param { binder: binder_written(name), ptype: opt_ty_r.r, pline: t.line, pcol: t.col, pborrow: false }
      let p2 = p_skip_newlines(opt_ty_r.p)
      if p_at(p2, TkComma) {
        parse_clause_params(p_skip_newlines(p_advance(p2)), [pm, ...acc])
      } else if p_at(p2, TkRparen) {
        PParams { p: p_advance(p2), r: Some(list_reverse([pm, ...acc])) }
      } else {
        PParams { p: p_error_here(p2, "expected `,` or `)` in parameter list"), r: None }
      }
    }
  }
}

#[doc("""
A `var` or `let` decl may appear at the top of the clause list,
before all operation
clauses. The parser collects them into a `prelude` and the
caller wraps the `EHandle` in an `EBlock(prelude, Some(EHandle))`.
The existing `desugar_var_block` pass then lifts each `SVar`
into a sibling `with State[T](init) as name` that wraps the
handler. Once an operation clause has been seen, any further
`var` / `let` is a parse error — the rule is "var/let must
precede all operation clauses inside one handler block."
""")]
pub fn parse_handle_clauses(p: Parser, acc: [HClause], rret: Option[HReturn], prelude: [Stmt]) : PClauses / Console {
  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) {
    PClauses { p: p_advance(p0), clauses: list_reverse(acc),
               return_clause: rret, prelude: list_reverse(prelude), r: Some(true) }
  } else {
    parse_handle_clause(p0, acc, rret, prelude)
  }
}

fn parse_handle_clause(p0: Parser, acc: [HClause], rret: Option[HReturn], prelude: [Stmt]) : PClauses / Console {
  let id_t = p_peek(p0)
  if tk_is(id_t.kind, TkVar) or tk_is(id_t.kind, TkLet) {
    parse_clause_prelude(p0, id_t, acc, rret, prelude)
  } else if not tk_is(id_t.kind, TkIdent) {
    pclauses_err(p_error(p0, id_t, "expected operation name in handler"))
  } else if is_lifecycle_clause_at(p0, id_t) {
    parse_lifecycle_clause(p0, id_t, acc, rret, prelude)
  } else {
    parse_op_clause(p0, id_t, acc, rret, prelude)
  }
}

fn parse_clause_prelude(p0: Parser, id_t: Token, acc: [HClause], rret: Option[HReturn],
                        prelude: [Stmt]) : PClauses / Console {
  match acc {
    [] -> {
      let sr = if tk_is(id_t.kind, TkVar) { parse_var(p0, id_t) } else { parse_let(p0, id_t) }
      match sr.r {
        None -> pclauses_err(sr.p)
        Some(s) -> parse_handle_clauses(sr.p, acc, rret, [s, ...prelude])
      }
    }
    _ -> pclauses_err(p_error(p0, id_t,
           "`var` and `let` must precede all operation clauses inside a handler"))
  }
}

fn parse_op_clause(p0: Parser, id_t: Token, acc: [HClause], rret: Option[HReturn],
                   prelude: [Stmt]) : PClauses / Console {
  let p1 = p_advance(p0)
  if not p_at(p1, TkLparen) {
    pclauses_err(p_error_here(p1, "expected `(` after operation name"))
  } else {
    let params_r = parse_clause_params(p_skip_newlines(p_advance(p1)), [])
    match params_r.r {
      None -> pclauses_err(params_r.p)
      Some(params) -> parse_op_clause_body(p_skip_newlines(params_r.p), id_t, params, acc, rret, prelude)
    }
  }
}

fn parse_op_clause_body(p3: Parser, id_t: Token, params: [Param], acc: [HClause],
                        rret: Option[HReturn], prelude: [Stmt]) : PClauses / Console {
  if not p_at(p3, TkArrow) {
    pclauses_err(p_error_here(p3, "expected `->` after operation parameters"))
  } else {
    let rb = parse_expr(p_skip_newlines(p_advance(p3)))
    match rb.r {
      None -> pclauses_err(rb.p)
      Some(body) -> {
        let name = tok_source(p3.src, id_t)
        if name == "return" {
          match params {
            [pp] -> parse_handle_clauses(rb.p, acc, Some(HR(pp.binder, body, id_t.line, id_t.col)), prelude)
            _ -> pclauses_err(p_error(p3, id_t, "return clause takes exactly one parameter"))
          }
        } else {
          let hc = HC(ChOp(name), params, body, id_t.line, id_t.col)
          parse_handle_clauses(rb.p, [hc, ...acc], rret, prelude)
        }
      }
    }
  }
}

# Both lower to an `HClause` with no params. `initially` is unwrapped by
# `parse_handle` into the handler-state slot the `(init)` form already
# fills; `finally` stays in the clause list under its own head.
fn parse_lifecycle_clause(p: Parser, id_t: Token, acc: [HClause],
                          rret: Option[HReturn], prelude: [Stmt]) : PClauses / Console {

  let name = tok_source(p.src, id_t)
  # The caller saw one of the two keywords, so the fallback never runs.
  let head = match clause_lifecycle_of_word(name) {
    Some(h) -> h
    None    -> ChOp(name)
  }
  let p1 = p_skip_newlines(p_advance(p))
  let bt = p_peek(p1)
  let rb = parse_block(p1, bt)
  match rb.r {
    None -> PClauses { p: rb.p, clauses: [], return_clause: None,
                       prelude: [], r: None }
    Some(body) ->
      if lifecycle_clause_seen(acc, head) {
        PClauses { p: p_error(p, id_t,
                     string_concat("duplicate `",
                       string_concat(name, "` clause in handler"))),
                   clauses: [], return_clause: None, prelude: [], r: None }
      } else {
        parse_handle_clauses(rb.p, [HC(head, [], body, id_t.line, id_t.col), ...acc],
                             rret, prelude)
      }
  }
}

fn parse_ident_primary(p: Parser, t: Token) : PExpr / Console {

  let name = tok_source(p.src, t)
  let p1 = p_advance(p)
  # `variants[T]()` — compile-time enumeration of a nullary sum
  # type's constructors. Special-cased before `[` would otherwise
  # pick up the postfix EIndex path. Active only when the source
  # ident is exactly "variants" and the next token is `[`. Any other
  # use of an identifier called `variants` followed by an expression
  # in `[...]` still parses as EIndex via parse_postfix_rest.
  if name == "variants" and p_at(p1, TkLbracket) {
    parse_variants_of(p1, t)
  }
  # `region { ... }` — opt-in Perceus region block. A
  # contextual ident (not a lexer keyword), recognised only when the
  # source ident is exactly "region" and the next token is `{`. Any
  # other use of an identifier called `region` (a bare variable, a
  # call `region(x)`, a field `region.x`) falls through to the normal
  # EVar path, so user code that names something `region` is
  # unaffected. The block parses as a normal `EBlock`; the surface is
  # lowered to the marker `ECall(EMark(MkRegion), [block])` so the
  # pre-typer region pass can recognise it, record the region in a
  # side table, run escape analysis, and unwrap the marker back to the
  # bare block.
  else if name == "region" and p_at(p1, TkLbrace) {
    parse_region(p1, t)
  }
  # `ensure(value) where pred` primary — narrows `value`
  # into the refined type via a runtime check, returning
  # `Option[T]`. Recognised only when the call is followed by
  # `where`; without it, `ensure(x)` parses as an ordinary call so
  # user code that defines a function called `ensure` is unaffected.
  else if name == "ensure" and p_at(p1, TkLparen) {
    parse_ensure_primary(p1, t)
  }
  # Lambda: `name => body`. Body is parsed via `parse_bin_or`, NOT
  # `parse_expr`, so a top-level pipe operator (`|`, `||`, `|?`,
  # `|>`) terminates the body and chains at the enclosing pipe
  # level.
  else if p_at(p1, TkFatArrow) {
    let p2 = p_advance(p1)
    let r = parse_bin_or(p2)
    match r.r {
      None -> err_e(r.p)
      Some(body) -> {
        let param = Param { binder: binder_written(name), ptype: None, pline: t.line, pcol: t.col, pborrow: false }
        ok_e(r.p, mk_expr(ELambda([param], body), t.line, t.col))
      }
    }
  }
  # Record literal: `Name { ... }` — but only when the name is Uppercase
  # and record literals are allowed here (suppressed in `if`/`match` cond
  # position so the `{` opens the body, not a positional record).
  else if is_upper_ident(p.src, t) and p_at(p1, TkLbrace) and p.allow_record_lit {
    parse_record_lit(p1, ref_written(name), t)
  }
  # Qualified record literal `mod.Type { ... }`. Lowercase head +
  # `.UpperIdent` + `{` commits to a record literal whose type is the
  # qualified reference. The qualtype rewriter pass validates the
  # qualifier against the module table before resolve runs (mirrors
  # the qualified-type-head treatment in `parse_named_type`).
  else if (not is_upper_ident(p.src, t)) and p_at(p1, TkDot) and
          tk_is(p_peek1(p1).kind, TkIdent) and
          is_upper_ident(p1.src, p_peek1(p1)) and
          tk_is(p_peek2(p1).kind, TkLbrace) and p.allow_record_lit {
    let nt = p_peek1(p1)
    # Advance past `.` and the UpperIdent so `p2` is at the `{`.
    let p2 = p_advance(p_advance(p1))
    parse_record_lit(p2, ref_qualified(name, tok_source(p1.src, nt)), t)
  }
  # Plain variable reference.
  else {
    ok_e(p1, mk_name(name, t.line, t.col))
  }
}

# Parse `variants[T]()`. `p` is positioned at the `[`; `t` is
# the original `variants` token (used for line/col). The closing `()`
# is mandatory and carries no payload — `variants[T](anything)` is a
# parse error. The TypeExpr inside the brackets is whatever
# `parse_type` accepts; resolver validates that it is a sum type with
# nullary-only variants.
fn parse_variants_of(p: Parser, t: Token) : PExpr / Console {

  let p1 = p_skip_newlines(p_advance(p))
  let r = parse_type(p1)
  match r.r {
    None -> err_e(r.p)
    Some(ty) -> {
      let p2 = p_skip_newlines(r.p)
      if not p_at(p2, TkRbracket) {
        err_e(p_error_here(p2, "expected `]` after type in `variants[T]`"))
      } else {
        let p3 = p_advance(p2)
        if not p_at(p3, TkLparen) {
          err_e(p_error_here(p3, "expected `()` after `variants[T]`"))
        } else {
          let p4 = p_advance(p3)
          if not p_at(p4, TkRparen) {
            err_e(p_error_here(p4,
              "`variants[T]()` does not accept arguments"))
          } else {
            ok_e(p_advance(p4),
                  mk_expr(EVariantsOf(ty, []), t.line, t.col))
          }
        }
      }
    }
  }
}

# Parse `region { ... }` or the named form `region { r -> ... }`. `p`
# is positioned at the `{`; `t` is the original `region` token (line/col
# key for the side table). The bare form parses as an ordinary `EBlock`
# wrapped in the marker `ECall(EMark(MkRegion), [block])` — the block is
# the DIRECT single argument (NOT a thunk lambda), so it stays inline:
# no closure capture, no codegen perturbation. The named form skolemizes
# a fresh region `r` and wraps the block in `ELambda([Param(r)], block)`
# inside the same marker, so the region pass can read the region's name
# off the binder (the nursery rhyme: `nursery { n -> }` names a cap the
# same way). The pre-typer region pass (compiler.region) recognises the
# marker, records the region and its name, runs escape
# analysis, and unwraps it back to the bare block — the typer and
# emitter see a normal block; the `ELambda` never reaches them. `region`
# is NOT a fn and NOT an effect — the marker exists only between parse
# and the region pass.
fn parse_region(p: Parser, t: Token) : PExpr / Console {
  # `{` at p_peek(p). Peek past it (and whitespace) to test for `r ->`.
  let after_lbrace = p_skip_newlines(p_advance(p))
  match region_binder_name(after_lbrace) {
    Some(bres) -> {
      let body_r = parse_lambda_block_body(bres.p, t)
      match body_r.r {
        None -> err_e(body_r.p)
        Some(body) -> {
          let param = Param { binder: binder_written(bres.name), ptype: None, pline: t.line, pcol: t.col, pborrow: false }
          let lam = mk_expr(ELambda([param], body), t.line, t.col)
          let callee = mk_expr(EMark(MkRegion), t.line, t.col)
          ok_e(body_r.p, mk_expr(ECall(callee, [lam]), t.line, t.col))
        }
      }
    }
    None -> {
      let r = parse_block(p, t)
      match r.r {
        None -> err_e(r.p)
        Some(block) -> {
          let callee = mk_expr(EMark(MkRegion), t.line, t.col)
          ok_e(r.p, mk_expr(ECall(callee, [block]), t.line, t.col))
        }
      }
    }
  }
}

# Parse `ensure(value) where pred`. `p` is positioned at the
# `(` of `ensure(...)`; `t` is the original `ensure` token. The form
# is preserved as an `SfEnsure` surface node; `surface_lower_decls`
# expands it to `{ let self = value; if pred { Some(self) } else
# { None } }`. Without a `where` suffix, `ensure(...)` falls through
# to an ordinary call so user-defined `ensure` functions are
# preserved.
fn parse_ensure_primary(p: Parser, t: Token) : PExpr / Console {

  let p1 = p_skip_newlines(p_advance(p))
  let rv = parse_expr(p1)
  match rv.r {
    None -> err_e(rv.p)
    Some(value) -> {
      let p2 = p_skip_newlines(rv.p)
      if not p_at(p2, TkRparen) {
        err_e(p_error_here(p2, "expected `)` after value in `ensure(...)`"))
      } else {
        let p3 = p_advance(p2)
        if not p_at(p3, TkWhere) {
          # No `where` suffix — fall back to an ordinary call so the
          # name `ensure` remains usable as a regular function.
          let callee = mk_name("ensure", t.line, t.col)
          ok_e(p3, mk_expr(ECall(callee, [value]), t.line, t.col))
        } else {
          let p4 = p_skip_newlines(p_advance(p3))
          let pred_r = parse_refinement_predicate(p4, t.line, t.col)
          match pred_r.r {
            None -> err_e(pred_r.p)
            Some(pred) -> ok_e(pred_r.p,
              mk_expr(ESurface(SfEnsure(value, pred)), t.line, t.col))
          }
        }
      }
    }
  }
}

fn parse_record_lit(p: Parser, type_name: DeclRef, tname: Token) : PExpr / Console {

  # `{` is next. Consume it.
  let p1 = p_skip_newlines(p_advance(p))
  if p_at(p1, TkRbrace) {
    ok_e(p_advance(p1), mk_expr(ERecordLit(type_name, []), tname.line, tname.col))
  } else if p_at(p1, TkEllipsis) {
    # Record-spread sugar: `T { ...src, x: 10, y: 20 }`.
    # The `...src` MUST be the first item; only named-field overrides
    # may follow. The source is captured as the first FieldInit, a
    # spread field, and resolved by the record desugar against the
    # record's declared field list.
    let _dotsTok = p_peek(p1)
    let p2 = p_skip_newlines(p_advance(p1))
    let r = parse_expr(p2)
    match r.r {
      None -> err_e(r.p)
      Some(src) -> {
        let acc0 = [mk_field_spread(src)]
        let p3 = p_skip_newlines(r.p)
        if p_at(p3, TkRbrace) {
          ok_e(p_advance(p3), mk_expr(ERecordLit(type_name, list_reverse(acc0)),
                                      tname.line, tname.col))
        } else if p_at(p3, TkComma) {
          parse_record_spread_loop(p_skip_newlines(p_advance(p3)), acc0, type_name, tname)
        } else {
          err_e(p_error_here(p3, "expected `,` or `}` after `...` source in record literal"))
        }
      }
    }
  } else {
    # Dispatch: peek the first item to choose between the named-field
    # path (existing) and the positional-sugar path. The
    # named path also covers `{ x, y }` punning, where the first item
    # is a bare ident followed by `,` or `}` — keeping legacy
    # behavior. Anything else (literal, call, expression, or an ident
    # followed by an expression-continuation token) routes to the
    # positional path. The positional fields carry no name;
    # `desugar_pos_records_decls` gives each its real field name from
    # the record's declared field order before any other pre-typer
    # pass runs.
    let tk0 = p_peek(p1)
    let tk1 = p_peek1(p1)
    let tk1_named_follow = tk_is(tk1.kind, TkColon) or tk_is(tk1.kind, TkComma) or tk_is(tk1.kind, TkRbrace)
    let is_named_first = tk_is(tk0.kind, TkIdent) and tk1_named_follow
    if is_named_first {
      parse_record_fields_loop(p1, [], type_name, tname)
    } else {
      parse_record_pos_loop(p1, [], type_name, tname)
    }
  }
}

# Parse named-field overrides after `...src,`. The spread field already
# lives at `acc[0]`. Pun and
# positional are rejected explicitly: pun would silently bind
# `x: x` from the local scope, which the spread form forbids;
# positional would conflict with the positional-sugar path. A second
# `...` is also rejected — a literal admits a single spread.
fn parse_record_spread_loop(p: Parser, acc: [FieldInit], type_name: DeclRef, tname: Token) : PExpr / Console {

  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) {
    ok_e(p_advance(p0), mk_expr(ERecordLit(type_name, list_reverse(acc)),
                                tname.line, tname.col))
  } else if p_at(p0, TkEllipsis) {
    err_e(p_error_here(p0,
      "record literal admits a single `...` spread; remove the second one"))
  } else {
    let tk = p_peek(p0)
    if not tk_is(tk.kind, TkIdent) {
      err_e(p_error(p0, tk,
        "expected named field override (`x: expr`) after `...` in record literal"))
    } else {
      let fname = tok_source(p0.src, tk)
      let p1 = p_advance(p0)
      if p_at(p1, TkColon) {
        let p2 = p_skip_newlines(p_advance(p1))
        let r = parse_expr(p2)
        match r.r {
          None -> err_e(r.p)
          Some(val) -> {
            let acc1 = [FI(fname, val), ...acc]
            let p3 = p_skip_newlines(r.p)
            if p_at(p3, TkComma) {
              parse_record_spread_loop(p_skip_newlines(p_advance(p3)), acc1, type_name, tname)
            } else if p_at(p3, TkRbrace) {
              ok_e(p_advance(p3), mk_expr(ERecordLit(type_name, list_reverse(acc1)),
                                          tname.line, tname.col))
            } else {
              err_e(p_error_here(p3, "expected `,` or `}` in record literal"))
            }
          }
        }
      } else {
        err_e(p_error(p1, p_peek(p1),
          "spread record overrides must use named field syntax `x: expr`; pun shorthand is not allowed after `...`"))
      }
    }
  }
}

# Positional record sugar. Accumulates positional fields. Each
# item is a full Expr; intermixing `IDENT :` is a parse error.
fn parse_record_pos_loop(p: Parser, acc: [FieldInit], type_name: DeclRef, tname: Token) : PExpr / Console {

  let p0 = p_skip_newlines(p)
  # Reject mixed forms: any subsequent item starting with `IDENT :`
  # signals named-field syntax inside a positional list.
  let tk0 = p_peek(p0)
  let tk1 = p_peek1(p0)
  if tk_is(tk0.kind, TkRbrace) {
    # Trailing comma: `R { 1, 2, }` — close the literal.
    ok_e(p_advance(p0), mk_expr(ERecordLit(type_name, list_reverse(acc)), tname.line, tname.col))
  } else if tk_is(tk0.kind, TkIdent) and tk_is(tk1.kind, TkColon) {
    err_e(p_error_here(p0, "expected positional or all-named record fields, found mixed forms"))
  } else {
    let r = parse_expr(p0)
    match r.r {
      None -> err_e(r.p)
      Some(val) -> {
        let acc1 = [mk_field_pos(val), ...acc]
        let p1 = p_skip_newlines(r.p)
        if p_at(p1, TkComma) {
          parse_record_pos_loop(p_skip_newlines(p_advance(p1)), acc1, type_name, tname)
        } else if p_at(p1, TkRbrace) {
          ok_e(p_advance(p1), mk_expr(ERecordLit(type_name, list_reverse(acc1)), tname.line, tname.col))
        } else {
          err_e(p_error_here(p1, "expected `,` or `}` in positional record literal"))
        }
      }
    }
  }
}

fn parse_record_fields_loop(p: Parser, acc: [FieldInit], type_name: DeclRef, tname: Token) : PExpr / Console {

  let p0 = p_skip_newlines(p)
  let tk = p_peek(p0)
  if tk_is(tk.kind, TkEllipsis) {
    err_e(p_error(p0, tk,
      "`...` must be the first item in a record literal — found a field before the spread"))
  } else if tk_is(tk.kind, TkRbrace) {
    # Trailing comma: `R { a: 1, b: 2, }` — `acc` already contains the
    # parsed fields; close the literal here.
    ok_e(p_advance(p0), mk_expr(ERecordLit(type_name, list_reverse(acc)), tname.line, tname.col))
  } else if not tk_is(tk.kind, TkIdent) {
    err_e(p_error(p0, tk, "expected field name in record literal"))
  } else {
    let fname = tok_source(p0.src, tk)
    let p1 = p_advance(p0)
    if p_at(p1, TkColon) {
      let p2 = p_skip_newlines(p_advance(p1))
      let r = parse_expr(p2)
      match r.r {
        None -> err_e(r.p)
        Some(val) -> {
          let acc1 = [FI(fname, val), ...acc]
          let p3 = p_skip_newlines(r.p)
          if p_at(p3, TkComma) {
            parse_record_fields_loop(p_skip_newlines(p_advance(p3)), acc1, type_name, tname)
          } else if p_at(p3, TkRbrace) {
            ok_e(p_advance(p3), mk_expr(ERecordLit(type_name, list_reverse(acc1)), tname.line, tname.col))
          } else {
            err_e(p_error_here(p3, "expected `,` or `}` in record literal"))
          }
        }
      }
    }
    # Record-literal punning. `{ x, y }` desugars to
    # `{ x: x, y: y }`, with the value wrapped in `SfFieldPun` so the
    # writer restores it. Symmetric with the pattern form already
    # parsed by `parse_record_pattern_fields` (PField is_shorthand).
    # Mixed forms (`{ x, y: other }`) compose because the punning
    # decision is per-field.
    else if p_at(p1, TkComma) or p_at(p1, TkRbrace) {
      let val = mk_name(fname, tk.line, tk.col)
      let acc1 = [mk_field_pun(fname, val), ...acc]
      if p_at(p1, TkComma) {
        parse_record_fields_loop(p_skip_newlines(p_advance(p1)), acc1, type_name, tname)
      } else {
        ok_e(p_advance(p1), mk_expr(ERecordLit(type_name, list_reverse(acc1)), tname.line, tname.col))
      }
    }
    else {
      err_e(p_error_here(p1, "expected `:`, `,`, or `}` after field name in record literal"))
    }
  }
}

fn parse_paren_or_lambda(p: Parser, t: Token) : PExpr / Console {

  # We need to distinguish:
  #   (expr)                  — grouping
  #   ()                       — unit
  #   () => expr               — zero-arg lambda
  #   (a, b, ...) => expr      — multi-arg lambda
  #   (a) => expr              — single-arg lambda (parenthesised)
  # Strategy: speculatively parse a lambda-param list. If followed by
  # `=>`, it's a lambda. Otherwise it was a parenthesised expression
  # and we re-parse from the original position.
  let p1 = p_skip_newlines(p_advance(p))
  # Empty parens: unit, or zero-arg lambda. Lambda body is parsed
  # via `parse_bin_or` so a trailing pipe operator chains at the
  # enclosing level.
  if p_at(p1, TkRparen) {
    let p2 = p_advance(p1)
    if p_at(p2, TkFatArrow) {
      let p3 = p_advance(p2)
      let r = parse_bin_or(p3)
      match r.r {
        None -> err_e(r.p)
        Some(body) -> ok_e(r.p, mk_expr(ELambda([], body), t.line, t.col))
      }
    } else {
      ok_e(p2, mk_expr(EUnit, t.line, t.col))
    }
  } else {
    # Try lambda: tentatively scan for an ident list ending with `)` `=>`.
    # Body parsed via `parse_bin_or`.
    match try_parse_lambda_params(p1) {
      Some(res) -> {
        let r = parse_bin_or(res.p)
        match r.r {
          None -> err_e(r.p)
          Some(body) -> ok_e(r.p, mk_expr(ELambda(res.params, body), t.line, t.col))
        }
      }
      None -> {
        # Fall back to `( expr )` or `( a, b, ... )` n-tuple sugar.
        let r = parse_expr(p1)
        match r.r {
          None -> err_e(r.p)
          Some(e) -> {
            let p2 = p_skip_newlines(r.p)
            if p_at(p2, TkRparen) { ok_e(p_advance(p2), e) }
            else if p_at(p2, TkComma) {
              # n-tuple expression sugar: (a, b) => Pair { fst: a, snd: b },
              # (a, b, c) => Triple { ... }, (a, b, c, d) => Quad { ... }.
              # N capped at 4 — wider products should be a named record.
              parse_tuple_expr_rest(p_skip_newlines(p_advance(p2)), [e], t)
            }
            else if p_at(r.p, TkNewline) and (p_at(p2, TkMinus) or p_at(p2, TkPercent)) {
              # `-` / `%` cannot lead a continuation line (they can
              # start an expression), so the newline ended this one.
              # Point the diagnostic at the newline, not the operator.
              let bad = p_peek(p2)
              let op = op_of_tok(bad.kind)
              let nl = p_peek(r.p)
              err_e(p_error(p2, nl, "expression ends at this newline: `#{op}` cannot lead a continuation line — keep `#{op}` at the end of the previous line to continue"))
            }
            else { err_e(p_error_here(p2, "expected `)` after expression")) }
          }
        }
      }
    }
  }
}

# n-tuple expression sugar. Called once the leading expr and a
# trailing `,` have been consumed. Accumulates further comma-separated
# exprs (in reverse) until `)`. On close, preserves the spelling as
# `SfTuple`; `surface_lower_decls` desugars it to a record literal of
# the appropriate stdlib type (Pair / Triple / Quad). Arity > 4 is
# rejected with a diagnostic naming the cap.
fn parse_tuple_expr_rest(p: Parser, acc: [Expr], t: Token) : PExpr / Console {

  if p_at(p, TkRparen) {
    # Trailing comma: `(1, 2, 3,)` — `acc` already has all elements.
    let elems = list_reverse(acc)
    let p2 = p_advance(p)
    match tuple_type_for_arity(list_length(elems)) {
      None -> err_e(p_error_here(p, "n-tuple sugar supports arity 2..4 only — use a named record for wider products"))
      Some(_) -> ok_e(p2, mk_expr(ESurface(SfTuple(elems)), t.line, t.col))
    }
  } else {
  let r = parse_expr(p)
  match r.r {
    None -> err_e(r.p)
    Some(e) -> {
      let p1 = p_skip_newlines(r.p)
      if p_at(p1, TkComma) {
        parse_tuple_expr_rest(p_skip_newlines(p_advance(p1)), [e, ...acc], t)
      } else if p_at(p1, TkRparen) {
        let elems = list_reverse([e, ...acc])
        let p2 = p_advance(p1)
        match tuple_type_for_arity(list_length(elems)) {
          None -> err_e(p_error_here(p1, "n-tuple sugar supports arity 2..4 only — use a named record for wider products"))
          Some(_) -> ok_e(p2, mk_expr(ESurface(SfTuple(elems)), t.line, t.col))
        }
      } else {
        err_e(p_error_here(p1, "expected `,` or `)` in tuple expression"))
      }
    }
  }
  }
}

fn try_parse_lambda_params(p: Parser) : Option[LamParams] / Console {

  try_parse_lambda_params_loop(p, [], [])
}

# `acc` holds already-closed params (reverse order); `pending` holds names
# of the current type group awaiting a `:` (reverse reading order). A `:`
# closes the group with a shared type back-filled onto every name (Go/Pony
# grouping); a closing `)` with pending names and no `:` closes them
# unannotated (lambda params may be inferred) but only when `=>` follows —
# otherwise the scan fails (None) and `(a, b)` falls back to n-tuple sugar.
# Annotated params now emit `Some(te)` (previously discarded — the typer
# honours the slot).
fn try_parse_lambda_params_loop(p: Parser, pending: [PendName], acc: [Param]) : Option[LamParams] / Console {

  let t = p_peek(p)
  if not tk_is(t.kind, TkIdent) { None }
  else {
    let name = tok_source(p.src, t)
    let p1 = p_advance(p)
    let pending1 = [PendName { nm: name, nline: t.line, ncol: t.col, pborrow: false }, ...pending]
    if p_at(p1, TkComma) {
      try_parse_lambda_params_loop(p_skip_newlines(p_advance(p1)), pending1, acc)
    } else if p_at(p1, TkColon) {
      let r = parse_type(p_advance(p1))
      match r.r {
        None -> None
        Some(te) -> {
          let acc1 = close_param_group(list_reverse(pending1), te, acc)
          if p_at(r.p, TkComma) {
            try_parse_lambda_params_loop(p_skip_newlines(p_advance(r.p)), [], acc1)
          } else if p_at(r.p, TkRparen) {
            let p3 = p_advance(r.p)
            if p_at(p3, TkFatArrow) {
              Some(LamParams { p: p_advance(p3), params: list_reverse(acc1) })
            } else { None }
          } else { None }
        }
      }
    } else if p_at(p1, TkRparen) {
      # No `:` for this group; close it unannotated. A lambda only if `=>`
      # follows the `)` — otherwise fail so `(a, b)` falls back to a tuple.
      let acc1 = close_param_group_untyped(list_reverse(pending1), acc)
      let p3 = p_advance(p1)
      if p_at(p3, TkFatArrow) {
        Some(LamParams { p: p_advance(p3), params: list_reverse(acc1) })
      } else { None }
    } else {
      None
    }
  }
}

fn parse_list_or_range(p: Parser, t: Token) : PExpr / Console {

  let p1 = p_skip_newlines(p_advance(p))
  if p_at(p1, TkRbracket) {
    ok_e(p_advance(p1), mk_expr(EList([]), t.line, t.col))
  } else {
    # Parse first element (could start with `...`).
    parse_first_list_elem(p1, t)
  }
}

fn parse_first_list_elem(p: Parser, t: Token) : PExpr / Console {

  if p_at(p, TkEllipsis) {
    let r = parse_expr(p_advance(p))
    match r.r {
      None -> err_e(r.p)
      Some(e) -> parse_list_rest(r.p, [ElSpread(e)], t)
    }
  } else {
    let r = parse_expr(p)
    match r.r {
      None -> err_e(r.p)
      Some(first) -> {
        let p1 = p_skip_newlines(r.p)
        if p_at(p1, TkDotDot) { parse_range_end(p, p1, first, t) }
        else { parse_list_rest(p1, [ElPlain(first)], t) }
      }
    }
  }
}

# `lazy [...]`. `p` is at `lazy`; the bracket is read as any list or
# range, and an endless range is legal here alone.
fn parse_lazy(p: Parser, t: Token) : PExpr / Console {
  let p1 = p_advance(p)
  if not p_at(p1, TkLbracket) { err_e(p_error_here(p1, "`lazy` opens a lazy sequence and takes a list or a range — write `lazy [...]`")) }
  else {
    let r = restore_rl(p.allow_record_lit, parse_list_or_range(p_with_record_lit(p1, true), p_peek(p1)))
    match r.r {
      None          -> r
      Some(bracket) ->
        if spread_before_last(bracket) { err_e(p_error(r.p, t, "a spread in `lazy [...]` is the rest of the sequence, so it comes last — write `lazy [a, ...rest]`")) }
        else { ok_e(r.p, mk_expr(ESurface(SfLazy(bracket)), t.line, t.col)) }
    }
  }
}

# `[first..last]`. `p0` is at `first` and `p1` at the `..` after it.
fn parse_range_end(p0: Parser, p1: Parser, first: Expr, t: Token) : PExpr / Console {
  let pe = p_skip_newlines(p_advance(p1))
  if p_at(pe, TkRbracket) { ok_e(p_advance(pe), mk_expr(ESurface(SfEndlessRange(first, None)), t.line, t.col)) } else {
  let r = parse_expr(pe)
  match r.r {
    None -> err_e(r.p)
    Some(last) -> {
      let p2 = p_skip_newlines(r.p)
      if p_at(p2, TkRbracket) {
        ok_e(p_advance(p2), mk_expr(ERange(first, last, None), t.line, t.col))
      } else if p_at(p2, TkDotDot) { err_e(reject_trailing_step(p0, p1, p2, first))
      } else { err_e(p_error_here(p2, "expected `]` at end of range")) }
    }
  }
  }
}

# `[from..to..step]` is not a form: the error spells the stepped range the
# author meant, from the source text of the three operands.
fn reject_trailing_step(p0: Parser, p1: Parser, p2: Parser, first: Expr) : Parser / Console {
  let r = parse_expr(p_skip_newlines(p_advance(p2)))
  match r.r {
    None -> r.p
    Some(step) -> {
      let form = "a stepped range is written `[first, second..last]`, its step being `second - first`"
      let from = src_between(p0, p1, 0)
      let spelled = concat_all([from, " + ", src_between(p2, r.p, 2)])
      let second = match try_int_literal(first) {
        Some(a) -> match try_int_literal(step) {
          Some(d) -> int_to_string(a + d)
          None    -> spelled
        }
        None -> spelled
      }
      p_error_here(p2, concat_all([form, " — write `[", from, ", ", second, "..", src_between(p1, p2, 2), "]`"]))
    }
  }
}

# `[first, second..last]`. `p` is at the `..`; `acc` holds the elements
# before it, newest first.
fn parse_stepped_range(p: Parser, acc: [ListElem], t: Token) : PExpr / Console = match acc {
  [ElPlain(second), ElPlain(first)] -> {
    let pe = p_skip_newlines(p_advance(p))
    if p_at(pe, TkRbracket) { stepped_range_at(pe, first, second, None, t) } else {
    let r = parse_expr(pe)
    match r.r {
      None -> err_e(r.p)
      Some(last) -> {
        let p1 = p_skip_newlines(r.p)
        if not p_at(p1, TkRbracket) { err_e(p_error_here(p1, "expected `]` at end of range")) }
        else { stepped_range_at(p1, first, second, Some(last), t) }
      }
    }
    }
  }
  _ -> err_e(p_error_here(p, "a stepped range takes exactly two elements before `..` — write `[first, second..last]`"))
}

# After an index's first expr: `..` turns it into a range index
# (`xs[a..b]`, optionally `..step`); otherwise the expr IS the index.
fn parse_index_range(p: Parser, first: Expr) : PExpr / Console {
  let p1 = p_skip_newlines(p)
  if p_at(p1, TkDotDot) {
    let r2 = parse_expr(p_skip_newlines(p_advance(p1)))
    match r2.r {
      None -> err_e(r2.p)
      Some(to) -> {
        let p2 = p_skip_newlines(r2.p)
        if p_at(p2, TkDotDot) {
          let r3 = parse_expr(p_skip_newlines(p_advance(p2)))
          match r3.r {
            None -> err_e(r3.p)
            Some(step) ->
              ok_e(r3.p, mk_expr(ERange(first, to, Some(step)), first.line, first.col))
          }
        } else { ok_e(p2, mk_expr(ERange(first, to, None), first.line, first.col)) }
      }
    }
  } else { ok_e(p, first) }
}

fn parse_list_rest(p: Parser, acc: [ListElem], t: Token) : PExpr / Console {

  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbracket) {
    ok_e(p_advance(p0), mk_expr(EList(list_reverse(acc)), t.line, t.col))
  } else if p_at(p0, TkDotDot) {
    parse_stepped_range(p0, acc, t)
  } else if p_at(p0, TkComma) {
    let p1 = p_skip_newlines(p_advance(p0))
    if p_at(p1, TkRbracket) {
      ok_e(p_advance(p1), mk_expr(EList(list_reverse(acc)), t.line, t.col))
    } else if p_at(p1, TkEllipsis) {
      let r = parse_expr(p_advance(p1))
      match r.r {
        None -> err_e(r.p)
        Some(e) -> parse_list_rest(r.p, [ElSpread(e), ...acc], t)
      }
    } else {
      let r = parse_expr(p1)
      match r.r {
        None -> err_e(r.p)
        Some(e) -> parse_list_rest(r.p, [ElPlain(e), ...acc], t)
      }
    }
  } else {
    err_e(p_error_here(p0, "expected `,` or `]` in list"))
  }
}

# Entry from `parse_primary` on `TkPercent`. The token after `%`
# selects map (`{`) or set (`[`); anything else is not a literal.
fn parse_collection_lit(p: Parser, t: Token) : PExpr / Console {

  let after = p_peek1(p)
  if tk_is(after.kind, TkLbrace) {
    parse_map_lit(p_advance(p_advance(p)), t)
  } else if tk_is(after.kind, TkLbracket) {
    parse_set_lit(p_advance(p_advance(p)), t)
  } else {
    err_e(p_error_here(p, "expected expression"))
  }
}

fn parse_map_lit(p: Parser, t: Token) : PExpr / Console {

  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) {
    ok_e(p_advance(p0), mk_map_lit(None, [], t))
  } else if p_at(p0, TkEllipsis) {
    let r = parse_expr(p_skip_newlines(p_advance(p0)))
    match r.r {
      None -> err_e(r.p)
      Some(base) -> map_after_spread(r.p, base, [], t)
    }
  } else {
    parse_map_entries(p0, [], t)
  }
}

# Collect `k: v` entries (no spread present) into `map.from([Pair])`.
fn parse_map_entries(p: Parser, acc: [MapEntry], t: Token) : PExpr / Console {

  let r = parse_map_entry(p, t)
  match r.r {
    None -> err_e(r.p)
    Some(entry) -> map_entries_sep(p_skip_newlines(r.p), [entry, ...acc], t)
  }
}

# After one entry: `}` (or `,}`) closes, `,` continues, `, ...` is the
# spread-not-first error, anything else is a separator error.
fn map_entries_sep(p: Parser, acc: [MapEntry], t: Token) : PExpr / Console {

  if p_at(p, TkRbrace) {
    ok_e(p_advance(p), mk_map_lit(None, list_reverse(acc), t))
  } else if not p_at(p, TkComma) {
    err_e(p_error_here(p, "expected `,` or `}` in map literal"))
  } else {
    let p1 = p_skip_newlines(p_advance(p))
    if p_at(p1, TkRbrace) {
      ok_e(p_advance(p1), mk_map_lit(None, list_reverse(acc), t))
    } else if p_at(p1, TkEllipsis) {
      err_e(p_error_here(p1,
        "map literal admits a single `...` spread, and it must come first"))
    } else {
      parse_map_entries(p1, acc, t)
    }
  }
}

# Parse one `key: value`. A bare element (no `:`) is the set-shape mistake.
fn parse_map_entry(p: Parser, t: Token) : PEntry / Console {

  let rk = parse_expr(p)
  match rk.r {
    None -> err_entry(rk.p)
    Some(key) -> {
      let p1 = p_skip_newlines(rk.p)
      if p_at(p1, TkColon) {
        let rv = parse_expr(p_skip_newlines(p_advance(p1)))
        match rv.r {
          None -> err_entry(rv.p)
          Some(val) -> ok_entry(rv.p, MapE(key, val))
        }
      } else {
        err_entry(p_error_here(p1,
          "set element in map literal: use a set literal `%[ ]`, or write `key: value`"))
      }
    }
  }
}

# Entries after `%{ ...base }`; overrides accumulate in source order.
fn map_after_spread(p: Parser, base: Expr, acc: [MapEntry], t: Token) : PExpr / Console {

  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) {
    ok_e(p_advance(p0), mk_map_lit(Some(base), list_reverse(acc), t))
  } else if not p_at(p0, TkComma) {
    err_e(p_error_here(p0, "expected `,` or `}` after `...` source in map literal"))
  } else {
    let p1 = p_skip_newlines(p_advance(p0))
    if p_at(p1, TkRbrace) {
      ok_e(p_advance(p1), mk_map_lit(Some(base), list_reverse(acc), t))
    } else if p_at(p1, TkEllipsis) {
      err_e(p_error_here(p1,
        "map literal admits a single `...` spread; remove the second one"))
    } else {
      let r = parse_map_entry(p1, t)
      match r.r {
        None -> err_e(r.p)
        Some(entry) -> map_after_spread(r.p, base, [entry, ...acc], t)
      }
    }
  }
}

fn parse_set_lit(p: Parser, t: Token) : PExpr / Console {

  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbracket) {
    ok_e(p_advance(p0), mk_set_lit(None, [], t))
  } else if p_at(p0, TkEllipsis) {
    let r = parse_expr(p_skip_newlines(p_advance(p0)))
    match r.r {
      None -> err_e(r.p)
      Some(base) -> set_after_spread(r.p, base, [], t)
    }
  } else {
    parse_set_elems(p0, [], t)
  }
}

fn parse_set_elems(p: Parser, acc: [Expr], t: Token) : PExpr / Console {

  let r = parse_set_elem(p, t)
  match r.r {
    None -> err_e(r.p)
    Some(elem) -> set_elems_sep(p_skip_newlines(r.p), [elem, ...acc], t)
  }
}

# After one element: `]` (or `,]`) closes, `,` continues, `, ...` is
# the spread-not-first error, anything else is a separator error.
fn set_elems_sep(p: Parser, acc: [Expr], t: Token) : PExpr / Console {

  if p_at(p, TkRbracket) {
    ok_e(p_advance(p), mk_set_lit(None, list_reverse(acc), t))
  } else if not p_at(p, TkComma) {
    err_e(p_error_here(p, "expected `,` or `]` in set literal"))
  } else {
    let p1 = p_skip_newlines(p_advance(p))
    if p_at(p1, TkRbracket) {
      ok_e(p_advance(p1), mk_set_lit(None, list_reverse(acc), t))
    } else if p_at(p1, TkEllipsis) {
      err_e(p_error_here(p1,
        "set literal admits a single `...` spread, and it must come first"))
    } else {
      parse_set_elems(p1, acc, t)
    }
  }
}

# Parse one set element. A `key: value` pair is the map-shape mistake.
fn parse_set_elem(p: Parser, t: Token) : PExpr / Console {

  let r = parse_expr(p)
  match r.r {
    None -> err_e(r.p)
    Some(e) -> {
      let p1 = p_skip_newlines(r.p)
      if p_at(p1, TkColon) {
        err_e(p_error_here(p1,
          "key:value pair in set literal: use a map literal `%{ }`"))
      } else {
        ok_e(r.p, e)
      }
    }
  }
}

fn set_after_spread(p: Parser, base: Expr, acc: [Expr], t: Token) : PExpr / Console {

  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbracket) {
    ok_e(p_advance(p0), mk_set_lit(Some(base), list_reverse(acc), t))
  } else if not p_at(p0, TkComma) {
    err_e(p_error_here(p0, "expected `,` or `]` after `...` source in set literal"))
  } else {
    let p1 = p_skip_newlines(p_advance(p0))
    if p_at(p1, TkRbracket) {
      ok_e(p_advance(p1), mk_set_lit(Some(base), list_reverse(acc), t))
    } else if p_at(p1, TkEllipsis) {
      err_e(p_error_here(p1,
        "set literal admits a single `...` spread; remove the second one"))
    } else {
      let r = parse_set_elem(p1, t)
      match r.r {
        None -> err_e(r.p)
        Some(e) -> set_after_spread(r.p, base, [e, ...acc], t)
      }
    }
  }
}

#[doc("Parses a `{ ... }` block expression whose brace token is given.")]
pub fn parse_block(p: Parser, t: Token) : PExpr / Console {

  # `{` is at current position.
  let p1 = p_skip_newlines_and_semis(p_advance(p))
  parse_block_body(p1, [], t)
}

# A `{` in expression position (i.e., reached via parse_primary, not
# via parse_handle's body) may start either a lambda-block or an
# ordinary block expression. Disambiguation is bounded lookahead:
#   {  ->  body    } -> zero-arity lambda-block
#   {  Ident ("," Ident)* "->"  body  } -> parameterised lambda-block
#   anything else -> ordinary block expression
# parse_handle still calls parse_block directly, so its body is
# always a block (a `{ x -> ... }` shape there is a syntax error;
# handle clauses use a different production).
fn parse_brace_primary(p: Parser, t: Token) : PExpr / Console {

  # `{` is at p_peek(p). Peek past it (and any whitespace).
  let after_lbrace = p_skip_newlines(p_advance(p))
  let pp_r = try_parse_lambda_block_params(after_lbrace)
  match pp_r {
    Some(res) -> {
      let body_r = parse_lambda_block_body(res.p, t)
      match body_r.r {
        None -> err_e(body_r.p)
        Some(body) -> ok_e(body_r.p, wrap_lam_block(finish_block_lambda(res, body, t), false, t))
      }
    }
    None -> parse_block(p, t)
  }
}

fn parse_block_body(p: Parser, stmts: [Stmt], t: Token) : PExpr / Console {

  let p0 = p_skip_newlines_and_semis(p)
  if p_at(p0, TkRbrace) {
    ok_e(p_advance(p0), mk_expr(EBlock(list_reverse(stmts), None), t.line, t.col))
  } else {
    let r = parse_stmt(p0)
    match r.r {
      None -> err_e(r.p)
      Some(s) -> {
        let p1 = p_skip_newlines_and_semis(r.p)
        if p_at(p1, TkRbrace) {
          # If the last stmt was an expression statement, it becomes the
          # block's final expression.
          match s {
            SExprStmt(e) -> ok_e(p_advance(p1), mk_expr(EBlock(list_reverse(stmts), Some(e)), t.line, t.col))
            _ -> ok_e(p_advance(p1), mk_expr(EBlock(list_reverse([s, ...stmts]), None), t.line, t.col))
          }
        } else if stmt_is_bare_section(p_peek(p0), s) {
          err_e(p_error_here(p0, "a line starting with `.` is a point-free section whose value is discarded, not a continuation of the previous line"))
        } else {
          parse_block_body(p1, [s, ...stmts], t)
        }
      }
    }
  }
}

fn parse_stmt(p: Parser) : PStmt / Console {

  let t = p_peek(p)
  if tk_is(t.kind, TkLet) {
    parse_let(p, t)
  } else if tk_is(t.kind, TkVar) {
    parse_var(p, t)
  } else if tk_is(t.kind, TkCase) {
    # `case` inside a stmt-block is the second half of a mixed
    # stmt + case body. The opening of the block was a stmt, so
    # the parser took the stmt-block path. Surface the pure-block
    # rule explicitly here instead of letting the user chase a stale
    # "expected expression" error.
    err_s(p_error(p, t, "case-block must contain only `case` arms; mix with stmt-block by extracting a helper or using `= match { ... }`"))
  } else if tk_is(t.kind, TkAssert) {
    parse_assert(p, t)
  } else if tk_is(t.kind, TkUse) {
    # `use Effect` at block scope. Same shape as the file-level
    # Decl form, but produces a Stmt so it can sit
    # mid-block. `desugar_use_decls` strips both before resolve.
    let p1 = p_advance(p)
    let id = p_peek(p1)
    if not tk_is(id.kind, TkIdent) {
      err_s(p_error(p1, id, "expected effect name after `use`"))
    } else if not is_upper_ident(p1.src, id) {
      err_s(p_error(p1, id, "effect name in `use` must start with an uppercase letter"))
    } else {
      let name = tok_source(p1.src, id)
      ok_s(p_advance(p1), SUse(name, t.line, t.col))
    }
  } else {
    let r = parse_expr(p)
    match r.r {
      None -> err_s(r.p)
      Some(e) -> {
        # Indexed write `a[i] := v`. The LHS expression we just parsed
        # must be an `EIndex(base, idx)` whose `base` is a plain
        # identifier or a `.`-chain of fields rooted at an identifier.
        # Anything else (e.g. a call result) is rejected so the write
        # hits a named binding the caller can observe elsewhere.
        if p_at(r.p, TkColonEq) {
          parse_index_assign_rest(r.p, e, t)
        } else {
          ok_s(r.p, SExprStmt(e))
        }
      }
    }
  }
}

# Validate the LHS of `:=` and parse the RHS.
# Accepted shapes:
#   `Ident[i] := v`            (indexed write — SIndexAssign)
#   `Ident.field…[i] := v`     (indexed write through field path)
#   `Ident := v`               (capability write — desugared to
#                              `cap.set(v)`; the alias rewrite later
#                              maps it to `State.set(cap, v)`)
fn parse_index_assign_rest(p: Parser, lhs: Expr, t: Token) : PStmt / Console {

  match lhs.kind {
    EIndex(base, idx) -> {
      if not is_index_lhs_path(base) {
        err_s(p_error(p, t,
          string_concat(
            "left-hand side of `:=` must be `Ident` or `Ident.field…[i]`; ",
            "bind a temporary first if you need to write to a call result")))
      } else {
        let p1 = p_skip_newlines(p_advance(p))
        let rv = parse_expr(p1)
        match rv.r {
          None -> err_s(rv.p)
          Some(v) -> ok_s(rv.p, SIndexAssign(base, idx, v, lhs.line, lhs.col))
        }
      }
    }
    EName(_) -> {
      # `cap := v` — preserved as SAssign; `surface_lower_decls`
      # rewrites it to `cap.set(v)`, which the alias rewrite remaps to
      # `State.set(cap, v)`. Only `State[T].set(v)` is the semantic
      # target; if cap is a Reader binding the lowering still produces
      # `cap.set(v)`, the alias rewrite emits `Reader.set(v)`, and the
      # resolver rejects it ("Reader has no operation `set`").
      let p1 = p_skip_newlines(p_advance(p))
      let rv = parse_expr(p1)
      match rv.r {
        None -> err_s(rv.p)
        Some(v) -> ok_s(rv.p, SAssign(lhs, v, lhs.line, lhs.col))
      }
    }
    EField(_, _) -> {
      # `record.field := v` where `field : Ref[T]` — preserved as
      # SAssign; the lowering produces `record.field.set(v)`, the same
      # `.set` shape as the `cap` arm. The typer's `try_ref_sugar_op`
      # maps `.set` on a `Ref` receiver to
      # `Mutable.ref_set(record.field, v)`; a non-`Ref` field falls
      # through to the ordinary UFCS lookup and its "no method `set`"
      # diagnostic. Only a `.`-chain rooted at an identifier is a valid
      # write target, mirroring the indexed-write rule.
      if not is_index_lhs_path(lhs) {
        err_s(p_error(p, t,
          "left-hand side of `:=` must be `Ident` or `Ident.field…`; bind a temporary first if you need to write through a call result"))
      } else {
        let p1 = p_skip_newlines(p_advance(p))
        let rv = parse_expr(p1)
        match rv.r {
          None -> err_s(rv.p)
          Some(v) -> ok_s(rv.p, SAssign(lhs, v, lhs.line, lhs.col))
        }
      }
    }
    _ -> err_s(p_error(p, t,
      "left-hand side of `:=` must be a capability binding `Ident`, an indexed `Ident[i]`, or `Ident.field…[i]`"))
  }
}

fn parse_let(p: Parser, t: Token) : PStmt / Console {

  let p1 = p_advance(p)
  let rp = parse_pattern(p1)
  match rp.r {
    None -> err_s(rp.p)
    Some(pat) -> {
      # Optional `: Type` annotation.
      let pa = p_skip_newlines(rp.p)
      let ty_opt_r =
        if p_at(pa, TkColon) {
          let rt = parse_type(p_advance(pa))
          match rt.r {
            None -> PTy { p: rt.p, r: None }
            Some(ty) -> PTy { p: rt.p, r: Some(ty) }
          }
        } else {
          PTy { p: pa, r: None }
        }
      if p_failed(ty_opt_r.p) and not p_failed(pa) { err_s(ty_opt_r.p) }
      else {
        let p_eq = p_skip_newlines(ty_opt_r.p)
        if not p_at(p_eq, TkEq) {
          err_s(p_error_here(p_eq, "expected `=` in let binding"))
        } else {
          let p_rhs = p_skip_newlines(p_advance(p_eq))
          let re = parse_expr(p_rhs)
          match re.r {
            None -> err_s(re.p)
            Some(rhs) -> ok_s(re.p, SLet(pat, ty_opt_r.r, rhs))
          }
        }
      }
    }
  }
}

# `var name (: T)? := init` — local mutable cell. `:=` is the single
# mark of mutability (declaration and write); `=` binds an immutable
# `let`. The parser produces an `SVar` node; the pre-resolve
# `desugar_var_decls` pass rewrites every block containing an SVar into
# the canonical `handle { rest } with State[T](init) as name { ... }`
# form. No `var name` (without `:= init`) form: rejected here so the
# desugar always has a state value to thread.
fn parse_var(p: Parser, t: Token) : PStmt / Console {

  let p1 = p_advance(p)
  let nt = p_peek(p1)
  if not tk_is(nt.kind, TkIdent) {
    err_s(p_error(p1, nt, "expected identifier after `var`"))
  } else {
    let name = tok_source(p1.src, nt)
    let p2 = p_advance(p1)
    let ty_opt_r =
      if p_at(p2, TkColon) {
        let rt = parse_type(p_advance(p2))
        match rt.r {
          None -> PTy { p: rt.p, r: None }
          Some(ty) -> PTy { p: rt.p, r: Some(ty) }
        }
      } else {
        PTy { p: p2, r: None }
      }
    if p_failed(ty_opt_r.p) and not p_failed(p2) { err_s(ty_opt_r.p) }
    else {
      let p_eq = p_skip_newlines(ty_opt_r.p)
      if p_at(p_eq, TkEq) {
        err_s(p_error_here(p_eq, "`var` declares a mutable cell with `:=`, not `=`; write `var name := init` (`=` binds an immutable `let`)"))
      } else if not p_at(p_eq, TkColonEq) {
        err_s(p_error_here(p_eq, "expected `:=` in var binding (initialiser is required): `var name := init`"))
      } else {
        let p_rhs = p_skip_newlines(p_advance(p_eq))
        let re = parse_expr(p_rhs)
        match re.r {
          None -> err_s(re.p)
          Some(rhs) -> ok_s(re.p, SVar(binder_written(name), ty_opt_r.r, rhs, t.line, t.col))
        }
      }
    }
  }
}

fn parse_assert(p: Parser, t: Token) : PStmt / Console {

  let p1 = p_advance(p)
  let re = parse_expr(p1)
  match re.r {
    None -> err_s(re.p)
    Some(cond) -> {
      if p_at(re.p, TkComma) {
        let p2 = p_skip_newlines(p_advance(re.p))
        let rm = parse_expr(p2)
        match rm.r {
          None -> err_s(rm.p)
          Some(msg) -> ok_s(rm.p, SAssert(cond, Some(msg)))
        }
      } else {
        ok_s(re.p, SAssert(cond, None))
      }
    }
  }
}

fn parse_if(p: Parser, t: Token) : PExpr / Console {

  let p1 = p_advance(p)
  # Cond cannot consume a trailing `{` (as a trailing lambda) or an
  # `UpperIdent {` (as a record literal) — that `{` is the `if` body.
  # Disable both while parsing cond, then restore their prior values
  # before consuming the body.
  let prev_atl = p1.allow_trailing_lambda
  let prev_arl = p1.allow_record_lit
  let pc = p_with_record_lit(p_with_trailing_lambda(p1, false), false)
  let rc = parse_expr(pc)
  match rc.r {
    None -> err_e(rc.p)
    Some(cond) -> {
      # Then-block
      let p2 = p_skip_newlines(p_with_record_lit(p_with_trailing_lambda(rc.p, prev_atl), prev_arl))
      if not p_at(p2, TkLbrace) {
        err_e(p_error_here(p2, "expected `{` after `if` condition"))
      } else {
        let tb = p_peek(p2)
        let rt = parse_block(p2, tb)
        match rt.r {
          None -> err_e(rt.p)
          Some(then_e) -> {
            let p3 = p_skip_newlines(rt.p)
            if p_at(p3, TkElse) {
              let p4 = p_skip_newlines(p_advance(p3))
              if p_at(p4, TkIf) {
                let te = p_peek(p4)
                let re = parse_if(p4, te)
                match re.r {
                  None -> err_e(re.p)
                  Some(else_e) -> ok_e(re.p, mk_expr(EIf(cond, then_e, Some(else_e)), t.line, t.col))
                }
              } else if p_at(p4, TkLbrace) {
                let teb = p_peek(p4)
                let re = parse_block(p4, teb)
                match re.r {
                  None -> err_e(re.p)
                  Some(else_e) -> ok_e(re.p, mk_expr(EIf(cond, then_e, Some(else_e)), t.line, t.col))
                }
              } else {
                err_e(p_error_here(p4, "expected `if` or `{` after `else`"))
              }
            } else {
              # No `else`: the `if` ends at its `}`; the newlines skipped
              # looking for one still separate it from the next line.
              ok_e(rt.p, mk_expr(EIf(cond, then_e, None), t.line, t.col))
            }
          }
        }
      }
    }
  }
}

fn parse_match(p: Parser, t: Token) : PExpr / Console {

  let p1 = p_advance(p)
  # Same as `if` — scrutinees cannot eat the `{` that opens the arms
  # block, whether as a trailing lambda or a record literal.
  let prev_atl = p1.allow_trailing_lambda
  let prev_arl = p1.allow_record_lit
  let ps = p_with_record_lit(p_with_trailing_lambda(p1, false), false)
  let rs = parse_expr(ps)
  match rs.r {
    None -> err_e(rs.p)
    Some(scrut1) -> {
      # Comma after the first scrutinee opens multi-scrutinee
      # match — `match e1, e2, ..., eN { p1, p2, ..., pN -> body | ... }`.
      let r_more = parse_more_scruts(rs.p, [scrut1])
      let p2 = p_skip_newlines(p_with_record_lit(p_with_trailing_lambda(r_more.p, prev_atl), prev_arl))
      if not p_at(p2, TkLbrace) {
        err_e(p_error_here(p2, "expected `{` after `match` expression"))
      } else {
        let scruts = list_reverse(r_more.r)
        let n = list_length(scruts)
        if n == 1 {
          parse_match_arms(p_skip_newlines(p_advance(p2)), [], scrut1, t)
        } else if n > 4 {
          # Cap multi-arg `match` at 4 columns. Higher arities push
          # the desugared nesting past what stays readable in
          # diagnostics.
          err_e(p_error_here(p2, "multi-arg `match` supports up to 4 scrutinees"))
        } else {
          parse_multi_match_arms(p_skip_newlines(p_advance(p2)), [], scruts, n, t)
        }
      }
    }
  }
}

fn parse_more_scruts(p: Parser, acc: [Expr]) : PScruts / Console {

  let p0 = p_skip_newlines(p)
  if not p_at(p0, TkComma) { PScruts { p: p0, r: acc } }
  else {
    let p1 = p_skip_newlines(p_advance(p0))
    let r = parse_expr(p1)
    match r.r {
      None    -> PScruts { p: r.p, r: acc }
      Some(e) -> parse_more_scruts(r.p, [e, ...acc])
    }
  }
}

# Parse arms where each arm has N patterns separated by commas,
# optional guard, `->`, body. Stops at `}`.
fn parse_multi_match_arms(p: Parser, acc: [MMArm], scruts: [Expr], n: Int, t: Token) : PExpr / Console {

  let p0 = p_skip_newlines_and_semis(p)
  if p_at(p0, TkRbrace) {
    let p1 = p_advance(p0)
    ok_e(p1, mk_expr(ESurface(SfMultiMatch(scruts, list_reverse(acc))), t.line, t.col))
  } else {
    let ra = parse_multi_arm(p0, n)
    match ra.r {
      None -> err_e(ra.p)
      Some(arm) -> parse_multi_match_arms(ra.p, [arm, ...acc], scruts, n, t)
    }
  }
}

fn parse_multi_arm(p: Parser, n: Int) : PMArm / Console {

  let r_pats = parse_n_patterns(p, n, [])
  match r_pats.r {
    None -> err_marm(r_pats.p)
    Some(pats) -> {
      let p1 = p_skip_newlines(r_pats.p)
      let guard_opt_r = parse_arm_guard(p1, TkIf)
      parse_marm_body(guard_opt_r, pats, "expected `->` in multi-arg match arm")
    }
  }
}

#[doc("""
An arm's optional guard after `kw`, read with trailing lambdas off so a
guard ending in a call does not swallow the arm body's `{`.
""")]
pub fn parse_arm_guard(p: Parser, kw: TokKind) : PExpr / Console =
  if p_at(p, kw) {
    let rg = parse_expr(p_with_trailing_lambda(p_advance(p), false))
    PExpr { p: p_with_trailing_lambda(rg.p, p.allow_trailing_lambda), r: rg.r }
  } else { PExpr { p: p, r: None } }

#[doc("`-> body` after an arm's patterns and optional guard.")]
pub fn parse_marm_body(g: PExpr, pats: [Pattern], missing_arrow: String) : PMArm / Console = {
  let p2 = p_skip_newlines(g.p)
  if not p_at(p2, TkArrow) {
    err_marm(p_error_here(p2, missing_arrow))
  } else {
    let rb = parse_expr(p_skip_newlines(p_advance(p2)))
    match rb.r {
      None -> err_marm(rb.p)
      Some(body) -> ok_marm(rb.p, MMArm(pats, g.r, body))
    }
  }
}

#[doc("Parses a fixed number of comma-separated patterns.")]
pub fn parse_n_patterns(p: Parser, n: Int, acc: [Pattern]) : PPatN / Console {

  if n == 0 {
    ok_patn(p, list_reverse(acc))
  } else {
    let rp = parse_pattern(p)
    match rp.r {
      None -> err_patn(rp.p)
      Some(pat) -> {
        let next = n - 1
        if next == 0 { ok_patn(rp.p, list_reverse([pat, ...acc])) }
        else {
          let p1 = p_skip_newlines(rp.p)
          if not p_at(p1, TkComma) {
            err_patn(p_error_here(p1, "expected `,` between multi-arg match patterns"))
          } else {
            parse_n_patterns(p_skip_newlines(p_advance(p1)), next, [pat, ...acc])
          }
        }
      }
    }
  }
}

fn parse_match_arms(p: Parser, acc: [Arm], scrut: Expr, t: Token) : PExpr / Console {

  let p0 = p_skip_newlines_and_semis(p)
  if p_at(p0, TkRbrace) {
    ok_e(p_advance(p0), mk_expr(EMatch(scrut, list_reverse(acc)), t.line, t.col))
  } else {
    let ra = parse_arm(p0)
    match ra.r {
      None -> err_e(ra.p)
      Some(arm) -> parse_match_arms(ra.p, [arm, ...acc], scrut, t)
    }
  }
}

fn parse_arm(p: Parser) : PArm / Console {

  let rp = parse_pattern(p)
  match rp.r {
    None -> err_a(rp.p)
    Some(pat) -> {
      # Optional refinement-narrowing `: Type where ...` after a
      # binding pattern. Lowers to a guard that evaluates the
      # refinement's predicate with `self` bound to the name. Only
      # PBind patterns participate; other shapes ignore the suffix.
      let p_after_ty = p_skip_newlines(rp.p)
      let nr = parse_optional_arm_refine(p_after_ty, pat)
      # Arm-refine may rewrite the pattern (PNarrow).
      let pat_eff = match nr.new_pat { Some(np) -> np  None -> pat }
      let p1 = p_skip_newlines(nr.p)
      # Optional guard: `if expr`. Same discipline as `parse_if` /
      # `parse_match`: the guard expression cannot eat the `->` (or
      # an arm body's `{`) by extending into a trailing lambda. Off
      # the flag for the guard, restore for the body.
      let guard_opt_r = parse_arm_guard(p1, TkIf)
      match guard_opt_r.r {
        None -> if p_failed(guard_opt_r.p) { err_a(guard_opt_r.p) } else {
          parse_arm_body(guard_opt_r.p, pat_eff, None)
        }
        Some(g) -> parse_arm_body(guard_opt_r.p, pat_eff, Some(g))
      }
    }
  }
}

fn parse_optional_arm_refine(p: Parser, pat: Pattern) : ArmRefine / Console {

  if not p_at(p, TkColon) { ArmRefine { p: p, new_pat: None } }
  else { match pat.pkind {
    PBind(name) -> {
      let p1 = p_skip_newlines(p_advance(p))
      let rt = parse_type(p1)
      match rt.r {
        None -> ArmRefine { p: rt.p, new_pat: None }
        Some(ty) -> match ty.tkind {
          TyRefine(_, _) -> {
            # Keep the author's `: Base where pred` spelling; lowering
            # turns it into a guard over the bound name (same desugar as
            # `ensure(value) where pred`), welded with any user guard.
            ArmRefine { p: rt.p,
                        new_pat: Some(mk_pat(PSurface(PsRefine(written_text(name.name), ty)),
                                             pat.line, pat.col)) }
          }
          # `name : TyName(t, ...)`. Parser cannot tell whether `t` is
          # a refinement-type alias or a union-component nominal type,
          # so it emits a uniform `PNarrow(name, ty)` pattern with no
          # guard. `lower_pattern_narrow_decls` later splits the cases:
          # for every refinement alias declared in the program, the
          # narrowing is rewritten back into `PBind(name)` + a guard
          # call to `__ref_pred_t(name)`; narrowings whose target is
          # not a refinement alias survive as `PNarrow` for the typer,
          # which checks the scrutinee is a union containing the
          # component.
          TyName(_, _) -> ArmRefine {
            p: rt.p,
            new_pat: Some(mk_pat(PNarrow(name, ty), pat.line, pat.col))
          }
          _ -> ArmRefine {
            p: p_error(rt.p, p_peek(p),
                       "match-arm narrowing `: Type` requires either an inline `Int where ...` or a refinement-type alias name"),
            new_pat: None
          }
        }
      }
    }
    _ -> ArmRefine {
      p: p_error(p, p_peek(p),
                 "match-arm narrowing `: Type` only applies to a binding pattern (a bare name)"),
      new_pat: None
    }
  } }
}

fn parse_arm_body(p: Parser, pat: Pattern, guard: Option[Expr]) : PArm / Console {

  let p1 = p_skip_newlines(p)
  if not p_at(p1, TkArrow) {
    err_a(p_error_here(p1, "expected `->` in match arm"))
  } else {
    let p2 = p_skip_newlines(p_advance(p1))
    let rb = parse_expr(p2)
    match rb.r {
      None -> err_a(rb.p)
      Some(body) -> ok_a(rb.p, Arm(pat, guard, body))
    }
  }
}

fn parse_pattern(p: Parser) : PPat / Console {
  if p.depth >= nest_max() { err_p(p_too_deep(p)) }
  else {
    let r = parse_pattern_in(p_at_depth(p, p.depth + 1))
    PPat { p: p_at_depth(r.p, p.depth), r: r.r }
  }
}

fn parse_pattern_in(p: Parser) : PPat / Console {

  let t = p_peek(p)
  match t.kind {
    TkHole          -> ok_p(p_advance(p), mk_pat(PHole(None), t.line, t.col))
    TkHoleName(nm)  -> ok_p(p_advance(p), mk_pat(PHole(Some(nm)), t.line, t.col))
    _ -> parse_pattern_rest(p, t)
  }
}

fn parse_pattern_rest(p: Parser, t: Token) : PPat / Console {

  if tk_is(t.kind, TkUnderscore) {
    ok_p(p_advance(p), mk_pat(PWild, t.line, t.col))
  } else if tk_is(t.kind, TkInt) {
    let span = tok_source(p.src, t)
    let lit = mk_expr(mk_int_lit(decode_int(span), span), t.line, t.col)
    pat_lit_or_range(p_advance(p), lit, t)
  } else if tk_is(t.kind, TkReal) {
    let span = tok_source(p.src, t)
    match decode_real(span) {
      Some(r) -> ok_p(p_advance(p), mk_pat(PLit(mk_expr(EReal(RealLit(r), span), t.line, t.col)), t.line, t.col))
      None    -> err_p(p_error(p, t, real_range_error()))
    }
  } else if tk_is(t.kind, TkTrue) {
    ok_p(p_advance(p), mk_pat(PLit(mk_expr(EBool(true), t.line, t.col)), t.line, t.col))
  } else if tk_is(t.kind, TkFalse) {
    ok_p(p_advance(p), mk_pat(PLit(mk_expr(EBool(false), t.line, t.col)), t.line, t.col))
  } else if tk_is(t.kind, TkChar) {
    let span = tok_source(p.src, t)
    let lit = mk_expr(EChar(decode_char(span)), t.line, t.col)
    pat_lit_or_range(p_advance(p), lit, t)
  } else if tk_is(t.kind, TkUInt8) {
    ok_p(p_advance(p), mk_pat(PLit(fixed_lit(p.src, t, 2, TyByte)), t.line, t.col))
  } else if tk_is(t.kind, TkInt32) {
    ok_p(p_advance(p), mk_pat(PLit(fixed_lit(p.src, t, 3, TyInt32)), t.line, t.col))
  } else if tk_is(t.kind, TkUInt32) {
    ok_p(p_advance(p), mk_pat(PLit(fixed_lit(p.src, t, 3, TyUInt32)), t.line, t.col))
  } else if tk_is(t.kind, TkUInt64) {
    ok_p(p_advance(p), mk_pat(PLit(fixed_lit(p.src, t, 3, TyUInt64)), t.line, t.col))
  } else if tk_is(t.kind, TkInt128) {
    ok_p(p_advance(p), mk_pat(PLit(fixed_lit(p.src, t, 4, TyInt128)), t.line, t.col))
  } else if tk_is(t.kind, TkString) {
    # An interpolated string pattern keeps its parsed bodies; surface
    # lowering turns it into a binder and a guard that compares it.
    let r = parse_str_lit(p, t)
    match r.r {
      Some(lit) -> ok_p(r.p, mk_pat(PLit(lit), t.line, t.col))
      None      -> err_p(r.p)
    }
  } else if tk_is(t.kind, TkMinus) {
    let nxt = p_peek1(p)
    if tk_is(nxt.kind, TkInt) {
      let span = tok_source(p.src, nxt)
      let v = 0 - decode_int(span)
      let p1 = p_advance(p_advance(p))
      pat_lit_or_range(p1, mk_expr(mk_int_lit(v, string_concat("-", span)), t.line, t.col), t)
    } else {
      err_p(p_error_here(p, "expected literal after `-` in pattern"))
    }
  } else if tk_is(t.kind, TkLbracket) {
    parse_list_pattern(p, t)
  } else if tk_is(t.kind, TkLparen) {
    # n-tuple pattern sugar. `(a, b)` desugars to a record
    # pattern matching the corresponding stdlib type — `Pair` for
    # arity 2, `Triple` for 3, `Quad` for 4. Single-element parens
    # `(p)` are grouping (returns `p` unchanged); zero-element `()`
    # is reserved for the unit pattern (rejected here as a parse
    # error to keep the surface small until a use case appears).
    parse_tuple_pattern(p, t)
  } else if tk_is(t.kind, TkLbrace) {
    # Anonymous record pattern. `{ fst, snd }` (with field
    # punning) or `{ fst: a, snd: b }`. The typer + bind_pat +
    # emitter machinery for PRecord is shared with the existing
    # match-arm record patterns, so this only needs the parser
    # entry point. Useful primarily on the LHS of `let` to
    # destructure multi-return shapes (Pair[a, b], etc.) without
    # the three-line `let p = ...; let a = p.fst; let b = p.snd`
    # ceremony.
    parse_record_pattern_fields(p_skip_newlines(p_advance(p)), [], None, t)
  } else if tk_is(t.kind, TkIdent) {
    parse_ident_pattern(p, t)
  } else {
    err_p(p_error_here(p, "expected pattern"))
  }
}

fn parse_list_pattern(p: Parser, t: Token) : PPat / Console {

  let p1 = p_skip_newlines(p_advance(p))
  if p_at(p1, TkRbracket) {
    ok_p(p_advance(p1), mk_pat(PList([], None), t.line, t.col))
  } else {
    parse_list_pattern_loop(p1, [], None, t)
  }
}

fn parse_list_pattern_loop(p: Parser, acc: [Pattern], rest: Option[String], t: Token) : PPat / Console {

  if p_at(p, TkEllipsis) {
    # Spread binder. `...` may stand alone (preferred form
    # `[h, ...]`) or be followed by `_` (uniform-with-`_` form
    # `[h, ..._]`); both discard the tail with no binding. The named
    # form `[h, ...rest]` keeps the existing semantics. The two
    # anonymous forms parse as `PsAnonRest`; `surface_lower_decls`
    # gives them a unique sentinel binder, preserving the
    # spread-vs-no-spread distinction the typer needs for
    # exhaustiveness while leaving the author's spelling recoverable
    # by the writer.
    let p1 = p_advance(p)
    let id = p_peek(p1)
    if tk_is(id.kind, TkIdent) {
      let name = tok_source(p1.src, id)
      let p2 = p_skip_newlines(p_advance(p1))
      if p_at(p2, TkRbracket) {
        ok_p(p_advance(p2), mk_pat(PList(list_reverse(acc), Some(binder_written(name))), t.line, t.col))
      } else {
        err_p(p_error_here(p2, "expected `]` after spread pattern"))
      }
    } else if tk_is(id.kind, TkUnderscore) {
      let p2 = p_skip_newlines(p_advance(p1))
      if p_at(p2, TkRbracket) {
        ok_p(p_advance(p2), mk_pat(PSurface(PsAnonRest(list_reverse(acc), true)), t.line, t.col))
      } else {
        err_p(p_error_here(p2, "expected `]` after spread pattern"))
      }
    } else if tk_is(id.kind, TkRbracket) {
      ok_p(p_advance(p1), mk_pat(PSurface(PsAnonRest(list_reverse(acc), false)), t.line, t.col))
    } else {
      err_p(p_error_here(p1, "expected identifier, `_`, or `]` after `...` in list pattern"))
    }
  } else {
    let r = parse_pattern(p)
    match r.r {
      None -> err_p(r.p)
      Some(pat) -> {
        let p1 = p_skip_newlines(r.p)
        if p_at(p1, TkComma) {
          parse_list_pattern_loop(p_skip_newlines(p_advance(p1)), [pat, ...acc], None, t)
        } else if p_at(p1, TkRbracket) {
          ok_p(p_advance(p1), mk_pat(PList(list_reverse([pat, ...acc]), None), t.line, t.col))
        } else {
          err_p(p_error_here(p1, "expected `,` or `]` in list pattern"))
        }
      }
    }
  }
}

# n-tuple pattern sugar. Mirrors parse_tuple_expr_rest: starts
# with `(`, parses N≥2 comma-separated sub-patterns, closes with `)`,
# preserved as `PsTuple`; `surface_lower_decls` desugars it to a
# `PVariantRecord` of the corresponding stdlib type (`Pair` / `Triple`
# / `Quad`). Single-paren `(p)` is grouping — returns the inner
# pattern unchanged. Empty `()` is rejected.
fn parse_tuple_pattern(p: Parser, t: Token) : PPat / Console {

  let p1 = p_skip_newlines(p_advance(p))
  if p_at(p1, TkRparen) {
    err_p(p_error_here(p1, "empty tuple pattern `()` not supported"))
  } else {
    let r = parse_pattern(p1)
    match r.r {
      None -> err_p(r.p)
      Some(first) -> {
        let p2 = p_skip_newlines(r.p)
        if p_at(p2, TkRparen) {
          # Single-pattern parens: grouping.
          ok_p(p_advance(p2), first)
        } else if p_at(p2, TkComma) {
          parse_tuple_pattern_rest(p_skip_newlines(p_advance(p2)), [first], t)
        } else {
          err_p(p_error_here(p2, "expected `,` or `)` in tuple pattern"))
        }
      }
    }
  }
}

fn parse_tuple_pattern_rest(p: Parser, acc: [Pattern], t: Token) : PPat / Console {

  let r = parse_pattern(p)
  match r.r {
    None -> err_p(r.p)
    Some(pat) -> {
      let p1 = p_skip_newlines(r.p)
      if p_at(p1, TkComma) {
        parse_tuple_pattern_rest(p_skip_newlines(p_advance(p1)), [pat, ...acc], t)
      } else if p_at(p1, TkRparen) {
        let pats = list_reverse([pat, ...acc])
        let p2 = p_advance(p1)
        match tuple_type_for_arity(list_length(pats)) {
          None -> err_p(p_error_here(p1, "n-tuple sugar supports arity 2..4 only — use a named record for wider products"))
          Some(_) -> ok_p(p2, mk_pat(PSurface(PsTuple(pats)), t.line, t.col))
        }
      } else {
        err_p(p_error_here(p1, "expected `,` or `)` in tuple pattern"))
      }
    }
  }
}

fn parse_ident_pattern(p: Parser, t: Token) : PPat / Console {

  let name = tok_source(p.src, t)
  let p1 = p_advance(p)
  # Qualified variant pattern `mod.Ctor[(subs)|{fields}]`.
  # Lowercase head + `.UpperIdent` is a qualifier; keep the spelling in
  # a surface wrapper and let the trailing UpperIdent flow through the
  # existing variant arms. Lowering moves it into the variant's home
  # slot; the module resolver validates it against the import table.
  if (not is_upper_ident(p.src, t)) and p_at(p1, TkDot) and tk_is(p_peek1(p1).kind, TkIdent) and is_upper_ident(p1.src, p_peek1(p1)) {
    let nt = p_peek1(p1)
    let r = parse_ident_pattern(p_advance(p1), nt)
    match r.r {
      None -> r
      Some(sub) -> ok_p(r.p, mk_pat(PSurface(PsQualified(name, sub)), t.line, t.col))
    }
  } else if is_upper_ident(p.src, t) and p_at(p1, TkLparen) {
    # Variant with positional sub-patterns.
    let p2 = p_skip_newlines(p_advance(p1))
    if p_at(p2, TkRparen) {
      ok_p(p_advance(p2), mk_pat(PVariant(ref_written(name), []), t.line, t.col))
    } else {
      parse_variant_sub_patterns(p2, [], name, t)
    }
  } else if is_upper_ident(p.src, t) and p_at(p1, TkLbrace) {
    # Variant-record pattern: parse as record, wrap in PVariantRecord.
    let p2 = p_skip_newlines(p_advance(p1))
    parse_record_pattern_fields(p2, [], Some(name), t)
  } else if is_upper_ident(p.src, t) {
    # Bare uppercase ident: 0-arg variant.
    ok_p(p1, mk_pat(PVariant(ref_written(name), []), t.line, t.col))
  } else if p_at(p1, TkAs) or p_at(p1, TkAt) {
    # `name as pattern` — as-pattern. Bind `name` to the whole scrutinee
    # and continue matching with the sub-pattern. The lowercase ident
    # already implies a fresh binding; the inner pattern is parsed by the
    # same `parse_pattern` entry, so list, variant, record, hole, and
    # even nested as-patterns compose. The legacy `name @ pattern`
    # spelling is still accepted; `@` now primarily means deref, and the
    # as-binding reads more naturally as `as` ("bind `name` as …").
    let spelled_as = p_at(p1, TkAs)
    let p2 = p_skip_newlines(p_advance(p1))
    let r = parse_pattern(p2)
    match r.r {
      None -> err_p(r.p)
      Some(sub) ->
        if spelled_as {
          ok_p(r.p, mk_pat(PSurface(PsAs(name, sub)), t.line, t.col))
        } else {
          ok_p(r.p, mk_pat(PAs(binder_written(name), sub), t.line, t.col))
        }
    }
  } else {
    ok_p(p1, mk_pat(PBind(binder_written(name)), t.line, t.col))
  }
}

fn parse_variant_sub_patterns(p: Parser, acc: [Pattern], name: String, t: Token) : PPat / Console {

  let r = parse_pattern(p)
  match r.r {
    None -> err_p(r.p)
    Some(sub) -> {
      let p1 = p_skip_newlines(r.p)
      if p_at(p1, TkComma) {
        parse_variant_sub_patterns(p_skip_newlines(p_advance(p1)), [sub, ...acc], name, t)
      } else if p_at(p1, TkRparen) {
        ok_p(p_advance(p1), mk_pat(PVariant(ref_written(name), list_reverse([sub, ...acc])), t.line, t.col))
      } else {
        err_p(p_error_here(p1, "expected `,` or `)` in variant pattern"))
      }
    }
  }
}

fn parse_record_pattern_fields(p: Parser, acc: [PField], ctor: Option[String], t: Token) : PPat / Console {

  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) {
    let p1 = p_advance(p0)
    match ctor {
      None -> ok_p(p1, mk_pat(PRecord(list_reverse(acc)), t.line, t.col))
      Some(name) -> ok_p(p1, mk_pat(PVariantRecord(ref_written(name), list_reverse(acc)), t.line, t.col))
    }
  } else {
    let fn_t = p_peek(p0)
    if not tk_is(fn_t.kind, TkIdent) {
      err_p(p_error(p0, fn_t, "expected field name in record pattern"))
    } else {
      let fname = tok_source(p0.src, fn_t)
      let p1 = p_advance(p0)
      let sub_r =
        if p_at(p1, TkColon) {
          let r = parse_pattern(p_advance(p1))
          match r.r {
            None -> PPat { p: r.p, r: None }
            Some(sp) -> PPat { p: r.p, r: Some(sp) }
          }
        } else {
          PPat { p: p1, r: Some(mk_pat(PBind(binder_written(fname)), fn_t.line, fn_t.col)) }
        }
      match sub_r.r {
        None -> err_p(sub_r.p)
        Some(sub) -> {
          let is_short = not p_at(p1, TkColon)
          let pf = PField(fname, sub, is_short)
          let p2 = p_skip_newlines(sub_r.p)
          if p_at(p2, TkComma) {
            parse_record_pattern_fields(p_skip_newlines(p_advance(p2)), [pf, ...acc], ctor, t)
          } else if p_at(p2, TkRbrace) {
            parse_record_pattern_fields(p2, [pf, ...acc], ctor, t)
          } else {
            err_p(p_error_here(p2, "expected `,` or `}` in record pattern"))
          }
        }
      }
    }
  }
}

#[doc("Parses an optional `/ row` effect-row suffix.")]
pub fn parse_row_suffix(p: Parser) : PRow / Console {

  if not p_at(p, TkSlash) { PRow { p: p, r: REmpty } }
  else {
    let p1 = p_advance(p)
    parse_row_labels(p1, [])
  }
}

fn parse_row_labels(p: Parser, acc: [RowLabel]) : PRow / Console {

  let t = p_peek(p)
  # `?e` or `?` in row tail position: a row variable the reporter
  # tells from an ordinary one by its `TpHole` tail.
  # Must be the last item in the row — `?e + Stdout` is rejected
  # for the same reason `e + Stdout` is.
  if tk_is(t.kind, TkHole) {
    let p1 = p_advance(p)
    let placeholder = TpHole(None, t.line, t.col)
    if p_at(p1, TkPlus) {
      let pe = p_error(p1, p_peek(p1),
        "row hole must be the last item in the row")
      PRow { p: pe, r: ROpen(placeholder, list_reverse(acc)) }
    } else {
      PRow { p: p1, r: ROpen(placeholder, list_reverse(acc)) }
    }
  } else if match t.kind { TkHoleName(_) -> true _ -> false } {
    let p1 = p_advance(p)
    let nm = match t.kind {
      TkHoleName(n) -> n
      _             -> "anon"
    }
    let placeholder = TpHole(Some(nm), t.line, t.col)
    if p_at(p1, TkPlus) {
      let pe = p_error(p1, p_peek(p1),
        "row hole must be the last item in the row")
      PRow { p: pe, r: ROpen(placeholder, list_reverse(acc)) }
    } else {
      PRow { p: p1, r: ROpen(placeholder, list_reverse(acc)) }
    }
  } else if not tk_is(t.kind, TkIdent) {
    PRow { p: p_error(p, t, "expected effect name in row"), r: REmpty }
  } else {
    let name = tok_source(p.src, t)
    let p1 = p_advance(p)
    if is_upper_ident(p.src, t) {
      parse_row_label_tail(p1, ref_written(name), acc)
    } else if p_at(p1, TkDot) {
      # Module qualifier: `ea.Emit`.
      let p2 = p_advance(p1)
      let t2 = p_peek(p2)
      if tk_is(t2.kind, TkIdent) and is_upper_ident(p.src, t2) {
        parse_row_label_tail(p_advance(p2), ref_qualified(name, tok_source(p.src, t2)), acc)
      } else {
        PRow { p: p_error(p2, t2, "expected effect name after module qualifier"), r: REmpty }
      }
    } else {
      # Lowercase identifier — a row variable in tail
      # position. Row variables themselves carry no type args and
      # must be the last item in the row; anything after `+` here
      # is rejected.
      if p_at(p1, TkPlus) {
        let pe = p_error(p1, p_peek(p1),
          "row variable must be the last item in the row")
        PRow { p: pe, r: ROpen(TpWritten(written(name)), list_reverse(acc)) }
      } else {
        PRow { p: p1, r: ROpen(TpWritten(written(name)), list_reverse(acc)) }
      }
    }
  }
}

# The label tail shared by the bare and qualified forms: optional
# `[T1, T2]` (`Reader[Int]` in row position parses the same way as a
# generic type application — distinct labels for distinct
# instantiations), then `+` or row end.
fn parse_row_label_tail(p: Parser, name: DeclRef, acc: [RowLabel]) : PRow / Console {
  let args_r =
    if p_at(p, TkLbracket) {
      parse_row_label_args(p_skip_newlines(p_advance(p)), [])
    } else {
      PRowArgs { p: p, r: Some([]) }
    }
  match args_r.r {
    None -> PRow { p: args_r.p, r: REmpty }
    Some(targs) -> {
      let acc1 = [RL(name, targs), ...acc]
      if p_at(args_r.p, TkPlus) {
        parse_row_labels(p_advance(args_r.p), acc1)
      } else {
        PRow { p: args_r.p, r: RClosed(list_reverse(acc1)) }
      }
    }
  }
}

#[doc("Parses the type arguments of an effect-row label.")]
pub fn parse_row_label_args(p: Parser, acc: [TypeExpr]) : PRowArgs / Console {

  let r = parse_type(p)
  match r.r {
    None -> PRowArgs { p: r.p, r: None }
    Some(arg) -> {
      let p1 = p_skip_newlines(r.p)
      if p_at(p1, TkComma) {
        parse_row_label_args(p_skip_newlines(p_advance(p1)), [arg, ...acc])
      } else if p_at(p1, TkRbracket) {
        PRowArgs { p: p_advance(p1), r: Some(list_reverse([arg, ...acc])) }
      } else {
        PRowArgs { p: p_error_here(p1, "expected `,` or `]` after row-label type arguments"), r: None }
      }
    }
  }
}

#[doc("Parses a type expression.")]
pub fn parse_type(p: Parser) : PTy / Console {
  if p.depth >= nest_max() { err_t(p_too_deep(p)) }
  else {
    let r = parse_type_in(p_at_depth(p, p.depth + 1))
    PTy { p: p_at_depth(r.p, p.depth), r: r.r }
  }
}

fn parse_type_in(p: Parser) : PTy / Console {

  let base = parse_type_base(p)
  match base.r {
    None -> base
    Some(_) -> parse_optional_refinement(base)
  }
}

# After a base type parses, peek for `where` and consume the
# refinement predicate as a single Expr. The predicate parses with the
# normal expression grammar; the typer restricts it to the decidable
# subset and wires it into codegen. The unary form `where >= 0`
# (predicate begins with a comparator and elides `self` on the LHS) is
# desugared at parse time into `self >= 0`.
fn parse_optional_refinement(base: PTy) : PTy / Console {

  if not p_at(base.p, TkWhere) { base } else {
    match base.r {
      None -> base
      Some(bt) -> {
        let p1 = p_advance(base.p)
        let pe = parse_refinement_predicate(p1, bt.line, bt.col)
        match pe.r {
          None -> PTy { p: pe.p, r: None }
          Some(pred) ->
            PTy { p: pe.p, r: Some(mk_ty(TyRefine(bt, pred), bt.line, bt.col)) }
        }
      }
    }
  }
}

# Parse the body of a `where` clause. The grammar accepts any
# Expr; in addition, when the next token is a comparison operator
# (`<`, `<=`, `==`, `!=`, `>`, `>=`), `self` is implicitly inserted as
# the LHS so that `where >= 0` desugars to `self >= 0`. Validation that
# the resulting Expr lies in the decidable subset is the typer's job.
#
# A second receiver-elision sugar — `where matches <expr>`
# desugars to `matches(self, <expr>)`. This is the refinement-side
# counterpart to the regex sigil: typical use is `String where matches
# ~r/^[a-z]+$/`. The desugar applies whenever the predicate begins
# with the bare identifier `matches` and the next non-`(` token is an
# expression starter — that excludes `matches(s, p)` (an explicit
# call) and `matches.field` (a member access on a value bound to
# `matches`), so user code that already names a function `matches` is
# unaffected.
fn parse_refinement_predicate(p: Parser, line: Int, col: Int) : PExpr / Console {

  let t = p_peek(p)
  if is_cmp_tok(t.kind) {
    let lhs = mk_name("self", line, col)
    parse_refinement_cmp_with(p, lhs, line, col)
  } else if is_matches_sugar_start(p, t) {
    parse_refinement_matches_with(p, t, line, col)
  } else {
    parse_expr(p)
  }
}

fn parse_refinement_matches_with(p: Parser, t: Token, line: Int, col: Int) : PExpr / Console {

  let p1 = p_advance(p)
  let rhs = parse_expr(p1)
  match rhs.r {
    None -> rhs
    Some(rv) -> {
      let self_e = mk_name("self", line, col)
      let callee = mk_name("matches", t.line, t.col)
      let call = mk_expr(ECall(callee, [self_e, rv]), t.line, t.col)
      PExpr { p: rhs.p, r: Some(call) }
    }
  }
}

# Build `self <op> rhs` when the where clause begins with a bare
# comparator. Emitted as an EBinop so the typer / codegen treat it
# identically to a written-out comparison. The spec's bounded-interval
# form `1 <= self <= 65535` is not chained here because parse_expr
# rejects non-associative comparison chaining; users who want both
# sides write `where 1 <= self and self <= 65535`.
fn parse_refinement_cmp_with(p: Parser, lhs: Expr, line: Int, col: Int) : PExpr / Console {

  let op_tok = p_peek(p)
  let op = cmp_op_of_tok(op_tok.kind)
  let p1 = p_advance(p)
  let rhs = parse_expr(p1)
  match rhs.r {
    None -> rhs
    Some(rv) -> {
      let cmp = mk_expr(EBinop(op, lhs, rv), line, col)
      PExpr { p: rhs.p, r: Some(cmp) }
    }
  }
}

fn parse_type_base(p: Parser) : PTy / Console {

  let t = p_peek(p)
  if tk_is(t.kind, TkLbracket) {
    let p1 = p_advance(p)
    let r = parse_type(p1)
    match r.r {
      None -> err_t(r.p)
      Some(inner) -> {
        if p_at(r.p, TkRbracket) {
          ok_t(p_advance(r.p), mk_ty(TyList(inner), t.line, t.col))
        } else {
          err_t(p_error_here(r.p, "expected `]` in list type"))
        }
      }
    }
  } else if tk_is(t.kind, TkLparen) {
    parse_fn_type(p, t)
  } else if tk_is(t.kind, TkIdent) {
    parse_named_type(p, t)
  } else {
    err_t(p_error_here(p, "expected type"))
  }
}

fn parse_named_type(p: Parser, t: Token) : PTy / Console {

  let name = tok_source(p.src, t)
  let p1 = p_advance(p)
  # Qualified type head `mod.Type[args?]`. When the leading ident
  # is lowercase and followed by `.UpperIdent`, the TyName carries the
  # qualified reference. The qualtype rewriter pass validates the
  # qualifier against the module table before resolve_ty runs.
  if (not is_upper_ident(p.src, t)) and p_at(p1, TkDot) and tk_is(p_peek1(p1).kind, TkIdent) and is_upper_ident(p1.src, p_peek1(p1)) {
    let nt = p_peek1(p1)
    let qname = ref_qualified(name, tok_source(p1.src, nt))
    let p2 = p_advance(p_advance(p1))
    if p_at(p2, TkLbracket) and not tk_is(p_peek1(p2).kind, TkLt) {
      let p3 = p_skip_newlines(p_advance(p2))
      # The habitant check keys on the TYPE token `nt`, not the
      # lowercase module qualifier (`mod.Type[a]<hab>`).
      ty_args_habitant(parse_type_args_loop(p3, [], qname, t), nt)
    } else if p_at(p2, TkLt) {
      parse_habitant_slot(p2, mk_ty(TyName(qname, []), t.line, t.col), t)
    } else {
      ok_t(p2, mk_ty(TyName(qname, []), t.line, t.col))
    }
  }
  # Peek-2 disambiguation. `Foo[<...>]` is the
  # `[<refinement_pure>]` attribute (handled by the caller, e.g.
  # parse_fn_decl), NOT a generic-type opener. So when `[` is
  # followed by `<`, leave both tokens for the outer parser.
  else if p_at(p1, TkLbracket) and not tk_is(p_peek1(p1).kind, TkLt) {
    # Generic type: Name[T1, T2, ...], optionally with a trailing
    # habitant (`Money[Decimal]<USD>`).
    let p2 = p_skip_newlines(p_advance(p1))
    ty_args_habitant(parse_type_args_loop(p2, [], ref_written(name), t), t)
  } else if ty_head_takes_habitant(p.src, t, name) and p_at(p1, TkLt) {
    # Dimensioned type — a habitant in angle brackets on the head.
    # Numeric heads (`Real<m/s>`, `Decimal<USD>`) carry a unit-expr; a
    # user head carries a kind habitant too — `Tree<r>` brands the type
    # with region `r`, the same notation Measure/Currency use. Both share
    # one route: `parse_habitant_slot` reads the `<...>` and `TyDim`
    # carries it. The typer collapses `TyDim` to the head `TyName` at
    # protocol-dispatch time (see `proto_type_name`), so the brand rides
    # the type without disturbing structural unification of the head.
    parse_habitant_slot(p1, mk_ty(TyName(ref_written(name), []), t.line, t.col), t)
  } else {
    ok_t(p1, mk_ty(TyName(ref_written(name), []), t.line, t.col))
  }
}

fn parse_type_args_loop(p: Parser, acc: [TypeExpr], name: DeclRef, t: Token) : PTy / Console {

  let r = parse_type(p)
  match r.r {
    None -> err_t(r.p)
    Some(arg) -> {
      let p1 = p_skip_newlines(r.p)
      # A compound effect row as a type argument —
      # `Stream[Int, Stdout + Fail]`. A `+` after the first label means
      # this argument is a row, not a plain type. Re-read it as a row
      # (seeding the labels with what we already parsed) and wrap it in
      # a `TyRow` carrier that alias substitution folds into the alias
      # row. Single-label and named-row-alias arguments keep the
      # ordinary `parse_type` path (`Stdout`, `SB`).
      if p_at(p1, TkPlus) {
        let rr = parse_row_type_arg(p_advance(p1), arg)
        match rr.r {
          None -> err_t(rr.p)
          Some(row_te) -> {
            let p2 = p_skip_newlines(rr.p)
            if p_at(p2, TkComma) {
              parse_type_args_loop(p_skip_newlines(p_advance(p2)), [row_te, ...acc], name, t)
            } else if p_at(p2, TkRbracket) {
              ok_t(p_advance(p2), mk_ty(TyName(name, list_reverse([row_te, ...acc])), t.line, t.col))
            } else {
              err_t(p_error_here(p2, "expected `,` or `]` after type arguments"))
            }
          }
        }
      } else if p_at(p1, TkComma) {
        parse_type_args_loop(p_skip_newlines(p_advance(p1)), [arg, ...acc], name, t)
      } else if p_at(p1, TkRbracket) {
        ok_t(p_advance(p1), mk_ty(TyName(name, list_reverse([arg, ...acc])), t.line, t.col))
      } else {
        err_t(p_error_here(p1, "expected `,` or `]` after type arguments"))
      }
    }
  }
}

# Parse the remainder of a compound row argument. `first`
# is the label already parsed before the `+`; `p` is positioned just
# after that `+`. Reuses `parse_row_labels` to read the rest of the
# row, then prepends `first`, yielding a `TyRow` carrier. The first
# label must be a plain (possibly parameterised) name — a function or
# list type in row-argument position is rejected.
fn parse_row_type_arg(p: Parser, first: TypeExpr) : PTy / Console {
  match te_as_row_label(first) {
    None -> err_t(p_error(p, p_peek(p),
      "expected an effect label before `+` in a row type argument"))
    Some(rl) -> {
      let pr = parse_row_labels(p, [rl])
      match pr.r {
        REmpty -> err_t(pr.p)
        _      -> ok_t(pr.p, mk_ty(TyRow(pr.r), first.line, first.col))
      }
    }
  }
}

fn parse_fn_type(p: Parser, t: Token) : PTy / Console {

  let p1 = p_skip_newlines(p_advance(p))
  if p_at(p1, TkRparen) {
    let p2 = p_advance(p1)
    if not p_at(p2, TkArrow) {
      err_t(p_error_here(p2, "expected `->` in function type"))
    } else {
      let r = parse_type(p_advance(p2))
      match r.r {
        None -> err_t(r.p)
        Some(ret) -> {
          let row_r = parse_row_suffix(r.p)
          ok_t(row_r.p, mk_ty(TyFn([], ret, row_r.r), t.line, t.col))
        }
      }
    }
  } else {
    parse_fn_type_args(p1, [], t)
  }
}

# Function-type args OR n-tuple type sugar. The disambiguation
# is local: parse a comma-separated list of types until `)`. If `->`
# follows, it's a function type. Otherwise it's a tuple type,
# preserved as `TsTuple`; `surface_lower_decls` desugars it to
# `Pair[A, B]` / `Triple[A, B, C]` / `Quad[A, B, C, D]`.
# A single type in parens (`(A)`) followed by no `->` is grouping —
# returns the inner type unchanged. Zero-arg `()` keeps the existing
# function-type contract (handled in parse_fn_type, must be `() -> T`).
fn parse_fn_type_args(p: Parser, acc: [TypeExpr], t: Token) : PTy / Console {

  let r = parse_type(p)
  match r.r {
    None -> err_t(r.p)
    Some(arg) -> {
      let p1 = p_skip_newlines(r.p)
      if p_at(p1, TkComma) {
        parse_fn_type_args(p_skip_newlines(p_advance(p1)), [arg, ...acc], t)
      } else if p_at(p1, TkRparen) {
        let p2 = p_advance(p1)
        if p_at(p2, TkArrow) {
          let rr = parse_type(p_advance(p2))
          match rr.r {
            None -> err_t(rr.p)
            Some(ret) -> {
              let row_r = parse_row_suffix(rr.p)
              ok_t(row_r.p, mk_ty(TyFn(list_reverse([arg, ...acc]), ret, row_r.r), t.line, t.col))
            }
          }
        } else {
          # Not a function type: re-interpret as tuple-type sugar or grouping.
          let args = list_reverse([arg, ...acc])
          let n = list_length(args)
          if n == 1 {
            # Single type in parens: grouping. `(A)` ≡ `A`.
            ok_t(p2, arg)
          } else {
            match tuple_type_for_arity(n) {
              None -> err_t(p_error_here(p1, "n-tuple type sugar supports arity 2..4 only — use a named record for wider products"))
              Some(_) -> ok_t(p2, mk_ty(TySurface(TsTuple(args)), t.line, t.col))
            }
          }
        }
      } else {
        err_t(p_error_here(p1, "expected `,` or `)` in type"))
      }
    }
  }
}
