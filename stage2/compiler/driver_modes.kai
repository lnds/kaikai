fn tok_text(src: String, t: Token) : String = string_slice(src, t.start, t.length)

fn tok_line_str(t: Token) : String = int_to_string(t.line)
fn tok_col_str(t: Token)  : String = int_to_string(t.col)

fn dump_token(src: String, t: Token) : Unit / Console {
  match t.kind {
    TkNewline -> print("#{tok_line_str(t)}:#{tok_col_str(t)}  NEWLINE")
    TkError(msg) -> eprint("#{tok_line_str(t)}:#{tok_col_str(t)}  ERROR  #{msg}")
    _ -> {
      let text = tok_text(src, t)
      print("#{tok_line_str(t)}:#{tok_col_str(t)}  #{tk_name(t.kind)}  \"#{text}\"")
    }
  }
}

#[doc("Print one line per token.")]
pub fn dump_tokens(src: String, tokens: [Token]) : Unit / Console {
  tokens |> each((t) => dump_token(src, t))
}

#[doc("""
`--builtins-doc-json`. Dump the `#[doc(...)]` attributes of the
auto-loaded core module set as one JSON array,
one object per module. Parses each core file fresh — docs are
stripped from cached decl streams, so the cache is bypassed on
purpose. The JSON rendering lives in compiler/doc_attr.kai.
""")]
pub(pkg) fn dump_builtins_doc_json() : Int / Console + File =
  builtins_doc_loop(core_module_files(), core_module_paths(), [])

fn builtins_doc_loop(rels: [String], paths: [String],
                       acc: [String]) : Int / Console + File {
  match rels {
    [] -> { print(doc_builtins_json(list_reverse(acc))); 0 }
    [r, ...rrest] -> match paths {
      [] -> { print(doc_builtins_json(list_reverse(acc))); 0 }
      [p, ...prest] -> match read_file(p) {
        Err(msg) -> { eprint("kaic2: #{p}: #{msg}"); 1 }
        Ok(src) -> {
          let toks = tokenize(src)
          let lex_errs = report_errors(p, src, toks)
          if lex_errs != 0 { 1 }
          else {
            let parsed = parse_program(p, src, toks, module_name_of_path(p))
            match parsed.decls {
              None -> 1
              Some(ds) -> {
                let docs = doc_strip_all(p, src, ds)
                # "core/list.kai" -> "core/list" for the module field.
                let mod_name = string_slice(r, 0, string_length(r) - 4)
                builtins_doc_loop(rrest, prest,
                  [doc_module_json(mod_name, docs.module_doc, docs.items, st_of_entries(parsed.names)), ...acc])
              }
            }
          }
        }
      }
    }
  }
}

#[doc("""
The cache directory the core loader should use for this invocation:
the shared `--core-cache-dir` when supplied, else the per-project
`.kai-cache` under the legacy `--user-cache` opt-in, else "" (off).
""")]
pub(pkg) fn core_cache_dir_for(opts: CliOptions, target: String) : String =
  if opts.core_cache.dir != "" { opts.core_cache.dir }
  else if opts.user_cache {
    concat_all([dir_of(target), "/", uc_cache_dir_name()])
  } else { "" }

#[doc("""
`kai migrate` body: rewrite the decls, re-emit through the fmt-
writer, and guard the never-emit-non-parsing invariant by reparsing
the output. On a reparse failure nothing is printed and the run
fails, so the user's file is never overwritten with broken source.
The migrated source goes to stdout; the `manual:` report and the
change summary go to stderr, keeping stdout a clean source stream
the bin/kai wrapper can diff or write back.
The report is scanned from an INDEPENDENT parse of the same source,
not the binding the rewrite consumes: the rewrite moves its owned
`decls`, so reusing one binding for both passes would leave the scan
reading freed sub-lists. Re-parsing is cheap next to the rest of
migrate and keeps the two passes fully decoupled.
""")]
pub(pkg) fn run_migrate(path: String, src: String, decls: [Decl], tab: SymTab, cmts: [Cmt], edition: Option[Edition]) : Int / Console =
  if migrate_flips_types(edition) {
    run_migrate_scanned(path, src, tab, cmts, scan_source(path, src), migrate_type_flip_count(decls), migrate_decls(decls))
  } else {
    run_migrate_scanned(path, src, tab, cmts, scan_source(path, src), 0, migrate_decls_renames_only(decls))
  }

# The Ok-first `Result` flip is the hanga-roa -> orongo type-order
# change: it applies to hanga-roa source and produces orongo source.
# The rewrite is positional, so it cannot tell an already-flipped
# `Result[T, E]` from a not-yet-flipped `Result[E, T]` by shape — the
# declared source edition is the only convergence signal. Anything but
# hanga-roa, including a flagless invocation, gets the call renames
# only; that is what makes a second migrate a no-op.
fn migrate_flips_types(edition: Option[Edition]) : Bool = match edition {
  Some(EdHangaRoa) -> true
  _                -> false
}

fn scan_source(path: String, src: String) : [MigRep] / Console = match parse_program(path, src, tokenize(src), module_name_of_path(path)).decls {
  None -> []
  Some(ds) -> migrate_scan_decls(ds)
}

fn run_migrate_scanned(path: String, src: String, tab: SymTab, cmts: [Cmt], reps: [MigRep], flips: Int, migrated: [Decl]) : Int / Console = {
  let out = fmt_program(migrated, tab, cmts, tokenize(src), src, fmt_default_width())
  let reparsed = parse_program(path, out, tokenize(out), module_name_of_path(path))
  match reparsed.decls {
    None -> { eprint("migrate: internal error — rewritten source does not parse; aborting (no file written)"); 1 }
    Some(_) -> run_migrate_ok(out, reps, flips)
  }
}

fn run_migrate_ok(out: String, reps: [MigRep], flips: Int) : Int / Console = {
  print(out)
  let report = migrate_manual_report(reps)
  if report != "" { eprint(report) } else { () }
  eprint("migrate: #{int_to_string(mig_count_renames(reps) + flips)} automatic rewrite(s) applied")
  0
}

#[doc("""
Write the source with one mutation site applied to stdout. A mutant
costs a full rebuild of whatever the oracle compiles, so a mutant that
does not parse is that cost spent for nothing: the rewritten source is
reparsed here and the run fails without printing rather than handing
the caller a guaranteed compile-fail. A parse failure is a defect in
an operator's span arithmetic, not a property of the corpus.
""")]
pub(pkg) fn run_mutate_apply(path: String, src: String, toks: [Token], decls: [Decl], tab: SymTab, i: Int) : Int / Console = {
  let sites = mutate_sites(decls, tab)
  match mut_site_at(sites, i) {
    None -> {
      eprint("mutate: no site #{int_to_string(i)} (the file has #{int_to_string(list_length(sites))})")
      1
    }
    Some(site) -> match mut_apply(site, toks, src) {
      None -> { eprint("mutate: site #{int_to_string(i)} does not resolve to a source span"); 1 }
      Some(out) -> run_mutate_checked(path, out, i)
    }
  }
}

fn run_mutate_checked(path: String, out: String, i: Int) : Int / Console =
  match parse_program(path, out, tokenize(out), module_name_of_path(path)).decls {
    None -> { eprint("mutate: site #{int_to_string(i)} produced source that does not parse"); 1 }
    Some(_) -> { print(mut_strip_final_newline(out)); 0 }
  }

# `print` re-adds the newline the source already carries, so the mutant
# would otherwise gain a blank last line its parent does not have.
fn mut_strip_final_newline(out: String) : String = {
  let n = string_length(out)
  if n > 0 and string_slice(out, n - 1, 1) == "\n" { string_slice(out, 0, n - 1) } else { out }
}

fn mut_site_at(sites: [MutSite], i: Int) : Option[MutSite] {
  match sites {
    [] -> None
    [s, ...rest] -> if i == 0 { Some(s) } else { mut_site_at(rest, i - 1) }
  }
}

# One `<input.kai>\t<output>` entry of a batch list.
#[doc("One entry of a batch list: an input file and its output.")]
pub type BatchEntry = BE(String, String)

# Parse the batch list file's contents into entries. Each non-blank
# line is `<input>\t<output>`; a line missing the tab is reported and
# dropped. Blank lines (trailing newline) are skipped.
#[doc("The entries of a batch list, one per non-blank line; a line without a tab is dropped.")]
pub(pkg) fn parse_batch_entries(content: String) : [BatchEntry] =
  parse_batch_entries_loop(string_split(content, "\n"), [])

fn parse_batch_entries_loop(lines: [String], acc: [BatchEntry]) : [BatchEntry] = match lines {
  [] -> list_reverse(acc)
  [ln, ...rest] ->
    if string_length(ln) == 0 { parse_batch_entries_loop(rest, acc) }
    else { match string_split(ln, "\t") {
      [inp, outp, ..._] -> parse_batch_entries_loop(rest, [BE(inp, outp), ...acc])
      _                 -> parse_batch_entries_loop(rest, acc)
    } }
}

#[doc("""
The sources the import closure of the root reads besides the root, one
per line; with `interfaces`, each followed by its interface digest.
""")]
pub(pkg) fn guard_listing(opts: CliOptions, interfaces: Bool) : Int / Console + File =
  match opts.path {
    None -> { usage(); 2 }
    Some(p) -> match read_file(p) {
      Ok(src) -> {
        let memo = if opts.core_cache.proj_dir == "" { "" } else { cat2(opts.core_cache.proj_dir, "/imports") }
        let _m = if memo == "" { () } else {
          let _p = match dir_create_dir(opts.core_cache.proj_dir) { _ -> () }
          match dir_create_dir(memo) { _ -> () }
        }
        let srcs = uc_input_files(p, src, opts.test_roots, opts.search_paths, memo)
        print_lines(if interfaces { map(srcs, (x) => with_interface(memo, x)) } else { srcs })
        0
      }
      Err(msg) -> { eprint("kaic2: #{p}: #{msg}"); 1 }
    }
  }

# A listed source with the digest of its interface after a tab; a missing
# source, or one that does not parse, as it was listed.
fn with_interface(memo: String, line: String) : String / Console + File =
  if string_starts_with_q(line, "-") { line }
  else { match read_file(line) {
    Ok(src) -> match gi_interface_memo(memo, line, src) {
      Some(h) -> concat_all([line, "\t", h])
      None    -> line
    }
    Err(_) -> line
  } }

#[doc("Run the compiler for the given CliOptions: load cores, dispatch the mode (build/test/check/fmt/library/dump), and return the process exit code. Driver entry point called by fn main().")]
pub(pkg) fn print_lines(xs: [String]) : Unit / Console = if xs != [] { print(string_join(xs, "\n")) }

#[doc("""
The joined core source hashes the native core object is keyed by; empty
when that cache is not in play.
""")]
pub(pkg) fn native_core_srcs(backend: Backend, cc: CoreCacheOpt, core_names: [String]) : String / Console + File =
  match backend {
    BkNative ->
      if native_core_cached(cc) and list_length(core_names) > 0 {
        match core_src_hexes(core_module_paths(), []) {
          None -> ""
          Some(hx) -> string_join(hx, "\n")
        }
      } else { "" }
    _ -> ""
  }

#[doc("""
The pre-key the c-modular core TU set is looked up by before typing; empty
when that cache is not in play.
""")]
pub(pkg) fn cmod_core_pre(backend: Backend, cc: CoreCacheOpt, edition: Option[Edition]) : String / Console + File =
  match backend {
    BkCModular ->
      if cc.dir == "" or cc.toolchain == "" { "" }
      else {
        match core_src_hexes(core_module_paths(), []) {
          None -> ""
          Some(hx) -> ec_pre_key(cc.toolchain, edition_key_text(edition), string_join(hx, "\n"), cc.inputs)
        }
      }
    _ -> ""
  }

#[doc("Whether the index already holds `variant` under `pre`.")]
pub(pkg) fn cmod_variant_known(cc: CoreCacheOpt, pre: String, variant: String) : Bool / Console + File =
  pre != "" and ec_index_has(cc.dir, pre, variant)

#[doc("The marker that the index holds a c-modular core TU set under `pre`, for some variant.")]
pub(pkg) fn cmod_core_hit(mode: Mode, cc: CoreCacheOpt, pre: String) : Option[String] / Console + File =
  match mode {
    MDefault -> if pre != "" and ec_index_any(cc.dir, pre) { Some(pre) } else { None }
    _        -> None
  }

#[doc("The key of the core TU set recorded for the program's variant, when the compile may prune against one.")]
pub(pkg) fn cmod_core_pick(backend: Backend, mode: Mode, cc: CoreCacheOpt, pre: String, variant: String) : Option[String] / Console + File =
  match backend {
    BkCModular -> match mode {
      MDefault -> if pre == "" or variant == "" { None } else { ec_index_pick(cc.dir, pre, variant) }
      _        -> None
    }
    _ -> None
  }

#[doc("""
The single-TU native emit: link a core object the cache holds, emit and
cache the core object, or emit the whole program as one object. Prints
one object path per line for the wrapper to link.
""")]
pub(pkg) fn native_single_emit(kp: KProgram, decls: [Decl], vs: [VariantEntry], fns: [EFn], bmode: BuildMode,
                      obj: String, path: String, core_names: [String], reuse: Option[String],
                      cfg: NCoreCfg) : Int / Console + File = match reuse {
  Some(co) -> print_objects(build_native_core_reuse(kp, decls, vs, fns, bmode, obj, path, co, core_names, cfg.stats))
  None ->
    if cfg.srcs_hex != "" { print_objects(build_native_core_split(kp, decls, vs, fns, bmode, obj, path, cfg, core_names)) }
    else {
      let rc = build_native_object(kp, decls, vs, fns, bmode, obj, path)
      if rc == 0 { print(obj); 0 } else { rc }
    }
}

fn print_objects(objs: [String]) : Int / Console = match objs {
  [] -> 1
  _ -> { print(string_join(objs, "\n")); 0 }
}

# Content hexes of the core sources, in load order. None on any read
# failure, which disables the emit cache for this invocation.
fn core_src_hexes(paths: [String], acc: [String]) : Option[[String]] / Console + File = match paths {
  [] -> Some(list_reverse(acc))
  [p, ...rest] -> match read_file(p) {
    Err(_) -> None
    Ok(s) -> core_src_hexes(rest, [uc_content_hex(s), ...acc])
  }
}

# Span-free identity of one decl for the emit-cache key. Core TU
# emission is fn-body-independent (a user body only shapes the root
# TU), but the program's NAME-LEVEL surface — types, impls (as their
# lowered `__pimpl_*` fn names), protocols, effects, units, fn
# name/arity pairs — can perturb synthetic decls or renames attributed
# to a core TU. Names and arities capture that surface without spans,
# so a plain body edit keeps the key while any surface change is a
# safe miss.
# The target file's basename is NOT part of the surface: a root pub
# fn (and an impl's lowered `__pimpl_*` method) carries the target
# module as its origin, and keying on it would make an identical
# program under a different filename miss.
fn ec_key_mo(mo: Option[String], target: String) : String = match mo {
  None -> ""
  Some(m) -> if m == target { "" } else { m }
}

fn ec_key_decl_id(d: Decl, tab: SymTab, specs: SpecNames, target: String) : String = match d {
  DFn(_, f, _, ps, _, _, _, _, _, mo) ->
    concat_all(["fn ", "#{fn_emit_name(tab, specs, f)}", "/", int_to_string(list_length(ps)), "@", ec_key_mo(mo, target)])
  DType(_, s, _, _, _, _, mo, _) -> concat_all(["type ", export_name(tab, s), "@", ec_key_mo(mo, target)])
  DEffect(_, s, _, _, _, _, _, mo) -> concat_all(["effect ", export_name(tab, s), "@", ec_key_mo(mo, target)])
  DProtocol(_, s, _, _, _, _, _) -> concat_all(["protocol ", export_name(tab, s)])
  DImpl(p, _, _, _, _, _, _, _) -> concat_all(["impl ", dump_ref_shown(tab, p)])
  DUnit(_, n, _, _, _, _, _) -> concat_all(["unit ", n])
  DConst(_, s, _, _, mo, _, _) -> concat_all(["const ", export_name(tab, s), "@", ec_key_mo(mo, target)])
  DUse(n, _, _) -> concat_all(["use ", n])
  _ -> "."
}

# A per-call-site closure-spec decl is derived and root-homed; its name
# carries a lambda body's `line`/`col`, so admitting it would let a plain
# body edit that adds, removes, or moves a specialisable HOF call re-key
# the core surface. It cannot perturb a core TU, so it stays out.
fn ec_decl_is_cspec(d: Decl, tab: SymTab) : Bool = match d {
  DFn(_, f, _, _, _, _, _, _, _, _) -> match sym_mint(tab, fnid_sym(f)) { NmSpec -> true  _ -> false }
  _ -> false
}

fn ec_key_user_ids(decls: [Decl], tab: SymTab, specs: SpecNames, core_names: [String], target: String, acc: [String]) : [String] = match decls {
  [] -> list_reverse(acc)
  [d, ...rest] -> {
    let is_core = match home_tu(d) {
      None -> false
      Some(m) -> list_has(core_names, m)
    }
    if is_core or ec_decl_is_cspec(d, tab) { ec_key_user_ids(rest, tab, specs, core_names, target, acc) }
    else { ec_key_user_ids(rest, tab, specs, core_names, target, [ec_key_decl_id(d, tab, specs, target), ...acc]) }
  }
}

fn ec_key_surface_hex(decls: [Decl], tab: SymTab, specs: SpecNames, core_names: [String], target: String) : String =
  uc_content_hex(string_join(ec_key_user_ids(decls, tab, specs, core_names, target, []), "\n"))

#[doc("""
The emit-cache entry key: content hash over the format tag, the
toolchain id, the edition, every core source, the program's
type-level surface and its unwind variant. "" means the cache does not participate; a
missing toolchain id disables it so a rebuilt dev compiler can never
splice another build's C.
""")]
pub(pkg) fn core_emit_key(cc: CoreCacheOpt, edition: Option[Edition], decls: [Decl], tab: SymTab, specs: SpecNames,
                 core_names: [String], target: String, variant: String) : String / Console + File =
  if cc.dir == "" or cc.toolchain == "" { "" }
  else {
    match core_src_hexes(core_module_paths(), []) {
      None -> ""
      Some(hexes) -> uc_content_hex(concat_all([
        ec_format_tag(), "\n", cc.toolchain, "\n", edition_key_text(edition), "\n",
        ec_key_surface_hex(decls, tab, specs, core_names, target), "\n", variant, "\n",
        string_join(hexes, "\n")]))
    }
  }

# c-modular emit with the core emit cache threaded through. On a warm
# entry the core TU bodies splice from the cache; on a miss the fresh
# core TU bodies are persisted for the next build. Only plain builds
# participate: test/bench shapes skip the cache instead of folding the
# shape into the key.
pub(pkg) fn emit_modular_maybe_cached(path: String, src: String, decls: [Decl], tab: SymTab, specs: SpecNames,
                             ids: ProtoIds, bmode: BuildMode, target_mod_name: String, entry: SymId,
                             regions: [RegionMark], cc: CoreCacheOpt,
                             core_mods: [ModuleEntry], edition: Option[Edition], pre: String, variant: String, seed: UnwSeed, hit: Option[String], stamp_ids: [SymId])
                             : String / Console + File + Mutable = {
  let plain = match bmode { BMBuild -> true _ -> false }
  let cacheable = core_mod_names(core_mods, [])
  let key = match hit {
    Some(k) -> k
    None    -> if plain { core_emit_key(cc, edition, decls, tab, specs, cacheable, target_mod_name, variant) } else { "" }
  }
  if key == "" {
    let _s = if cc.stats { eprint("kaic2: core-emit-cache: off") } else { () }
    match emit_program_modular_cached(path, src, decls, tab, specs, ids, bmode, Some(target_mod_name), entry, regions, [], cacheable, false, seed, stamp_ids) {
      EMO(stream, _) -> stream
    }
  } else {
    let cached = match ec_lookup(cc.dir, key) { None -> [] Some(tus) -> tus }
    let _v = if is_some(hit) and list_is_empty(cached) { panic("kaic2: the core TU set the compile pruned against is gone") } else { () }
    match emit_program_modular_cached(path, src, decls, tab, specs, ids, bmode, Some(target_mod_name), entry, regions, cached, cacheable, is_some(hit), seed, stamp_ids) {
      EMO(stream, fresh) -> {
        let n_hit = list_length(cached)
        let written = if n_hit == 0 and list_length(fresh) > 0 { ec_write(cc.dir, key, fresh) } else { "" }
        let complete = if n_hit == 0 { fresh } else if list_is_empty(fresh) { cached } else { [] }
        let _i = if is_none(hit) and variant != "" and not list_is_empty(complete) {
          if written != "" { ec_index_record(cc.dir, pre, variant, key, written, cc.stats) }
          else if not ec_index_has(cc.dir, pre, variant) { ec_index_record(cc.dir, pre, variant, key, ec_content_hex(complete), cc.stats) }
          else { () }
        } else { () }
        let _s = if cc.stats {
          if n_hit > 0 { eprint("kaic2: core-emit-cache: hit (#{n_hit} TUs)") }
          else { eprint("kaic2: core-emit-cache: miss (wrote #{list_length(fresh)} TUs)") }
        } else { () }
        stream
      }
    }
  }
}
