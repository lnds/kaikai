#[doc("""
Fiber-boundary check on the monomorphised program.

A value that stays on its fiber (a cell, a `Seq`, a `Cont`) must not
reach another one, whether a spawned thunk captures it or an actor
message carries it. The typer sees a generic helper's `t`, never the
`Ref[Int]` a caller binds it to; here every type is concrete, so the
same capture check and a message check see through type parameters.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.diag
import compiler.diag_file
import compiler.util
import compiler.scope_view
import compiler.type_home
import compiler.infer_state
import compiler.infer_head_dispatch
import compiler.mutation_carriers
import compiler.spawn_capture
import compiler.spawn_row

# A spawn with its thunk, or a call taking a `Pid` beside other arguments.
type Site = SpawnAt(SpawnSite, Expr) | SendAt(SpawnSite, [Expr])

#[doc("The diagnostics for every spawned thunk of `ds` capturing, and every actor message carrying, a value that stays on its fiber. `program` declares the types, `target` is the root module.")]
pub(pkg) fn fiber_crossings(df: DiagFiles, tab: SymTab, views: FileViews, target: String, roots: Roots,
                            program: [Decl], ds: [Decl]) : [Diagnostic] / Console + File {
  let sites = flat_map(ds, (d) => decl_sites(df, tab, d))
  match sites {
    [] -> []
    _  -> {
      let homes = tsh_homes(program, tab, views, target, roots)
      let shapes = carrier_shapes(tsh_view(homes, None), typer_records(program, tab), collect_sums(program))
      let bound = fiber_bound_type_names(shapes)
      list_uniq(flat_map(sites, (s) => site_diags(s, bound)))
    }
  }
}

fn decl_sites(df: DiagFiles, tab: SymTab, d: Decl) : [Site] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _) -> expr_sites(SpawnSite { file: decl_diag_file(d, df), tab: tab, owner: d }, body)
  _ -> []
}

fn expr_sites(site: SpawnSite, e: Expr) : [Site] = {
  let here = match e.kind {
    ECall(callee, args_) ->
      if callee_is_spawn(callee) {
        match spawn_thunk_arg(args_) {
          Some(thk) -> [SpawnAt(site, thk)]
          None      -> []
        }
      }
      else if any(args_, is_pid) { [SendAt(site, args_)] }
      else { [] }
    _ -> []
  }
  list_append(here, flat_map(spawn_expr_children(e), (k) => expr_sites(site, k)))
}

fn is_pid(e: Expr) : Bool = match pid_message(e) {
  Some(_) -> true
  None    -> false
}

# The message type of an expression that is a `Pid`.
fn pid_message(e: Expr) : Option[Ty] = match e.ty {
  Some(TyCon(s, [m])) -> if core_ty_is(s, CtPid) { Some(m) } else { None }
  _ -> None
}

fn site_diags(s: Site, bound: [SymId]) : [Diagnostic] / Console + File = match s {
  SpawnAt(site, thk)  -> check_thunk_captures(site, bound, thk)
  SendAt(site, args_) -> message_diags(site, args_, bound)
}

fn carries_message(e: Expr, bound: [SymId]) : Bool = match pid_message(e) {
  Some(m) -> ty_holds_bound(m, bound)
  None    -> false
}

fn message_diags(site: SpawnSite, args_: [Expr], bound: [SymId]) : [Diagnostic] =
  if any(args_, (a) => carries_message(a, bound)) {
    flat_map(args_, (a) => match a.ty {
      Some(t) -> if not is_pid(a) and ty_holds_bound(t, bound) { [message_diag(site, a, t)] } else { [] }
      None    -> []
    })
  } else { [] }

fn message_diag(site: SpawnSite, a: Expr, t: Ty) : Diagnostic = {
  let file = site.file
  mk_diag(SevError, file, a.line, a.col,
          concat_all(["an actor message cannot hold `", carrier_display(site.tab, t), "`"]),
          [ri_note(file, a.line, a.col, "fibers have private heaps; the receiver would not share it with the sender"),
           ri_help(file, a.line, a.col, "send the value's contents, or let one actor own the state (`kai info actors`)")])
}
