#[doc("""
Fiber-boundary check on the monomorphised program.

A value that stays on its fiber (a cell, a `Seq`, a `Cont`) must not
reach another one. A spawned thunk capturing it, an actor mailbox typed
to carry it and a `Fiber` returning it all cross. The typer sees a
generic helper's `t`, never the `Ref[Int]` a caller binds it to; here
every type is concrete, so the checks see through type parameters. The
mailbox and the fiber result are judged by their type, so no send or
await can carry one however the call is spelled.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.diag
import compiler.diag_file
import compiler.util
import compiler.scope_view
import compiler.type_home
import compiler.infer_state
import compiler.infer_head_dispatch
import compiler.mutation_carriers
import compiler.spawn_capture
import compiler.spawn_row

# A spawn with its thunk, or the expressions of a declaration whose type names a `Pid` or a `Fiber`.
type Site = SpawnAt(SpawnSite, Expr) | TypedAt(SpawnSite, [Expr])

#[doc("The diagnostics for every spawned thunk of `ds` capturing, and every `Pid` or `Fiber` type carrying, a value that stays on its fiber. `program` declares the types, `target` is the root module. One per site: a generic's instances report once.")]
pub(pkg) fn fiber_crossings(df: DiagFiles, tab: SymTab, views: FileViews, target: String, roots: Roots,
                            program: [Decl], ds: [Decl]) : [Diagnostic] / Console + File {
  let sites = flat_map(ds, (d) => decl_sites(df, tab, d))
  match sites {
    [] -> []
    _  -> {
      let homes = tsh_homes(program, tab, views, target, roots)
      let shapes = carrier_shapes(tsh_view(homes, None), typer_records(program, tab), collect_sums(program))
      let bound = fiber_bound_type_names(shapes)
      once_per_site(df_root(df), flat_map(sites, (s) => site_diags(s, bound)), [])
    }
  }
}

fn decl_sites(df: DiagFiles, tab: SymTab, d: Decl) : [Site] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _, _, _) -> {
    let site = SpawnSite { file: decl_diag_file(d, df), tab: tab, owner: d }
    let spawns = spawn_sites(site, body)
    match filter(all_exprs(body), has_fiber_type) {
      [] -> spawns
      es -> [...spawns, TypedAt(site, es)]
    }
  }
  _ -> []
}

fn spawn_sites(site: SpawnSite, e: Expr) : [Site] = {
  let here = match e.kind {
    ECall(callee, args_) -> if callee_is_spawn(callee) {
      match spawn_thunk_arg(args_) {
        Some(thk) -> [SpawnAt(site, thk)]
        None      -> []
      }
    } else { [] }
    _ -> []
  }
  list_append(here, flat_map(spawn_expr_children(e), (k) => spawn_sites(site, k)))
}

fn all_exprs(e: Expr) : [Expr] = [e, ...flat_map(spawn_expr_children(e), all_exprs)]

fn has_fiber_type(e: Expr) : Bool = match e.ty {
  Some(t) -> names_fiber_type(t)
  None    -> false
}

fn names_fiber_type(t: Ty) : Bool = match t {
  TyCon(s, args) -> core_ty_is(s, CtPid) or core_ty_is(s, CtFiber) or any(args, names_fiber_type)
  TyListT(x)     -> names_fiber_type(x)
  _              -> false
}

fn site_diags(s: Site, bound: [SymId]) : [Diagnostic] / Console + File = match s {
  SpawnAt(site, thk) -> check_thunk_captures(site, bound, thk)
  TypedAt(site, es)  -> first_crossing(site, es, bound)
}

# The first expression of a declaration whose type moves a bound value between fibers.
fn first_crossing(site: SpawnSite, es: [Expr], bound: [SymId]) : [Diagnostic] = match es {
  []           -> []
  [e, ...rest] -> match e.ty {
    Some(t) -> match carried(t, bound) {
      Some(c) -> [crossing_diag(site, e, c)]
      None    -> first_crossing(site, rest, bound)
    }
    None -> first_crossing(site, rest, bound)
  }
}

# A `Pid[M]` or `Fiber[T]` within `t` whose argument holds a bound value.
type Carried = Carried(Bool, Ty)

fn carried(t: Ty, bound: [SymId]) : Option[Carried] = match t {
  TyCon(s, args) -> {
    let is_pid = core_ty_is(s, CtPid)
    match args {
      [m] -> if (is_pid or core_ty_is(s, CtFiber)) and ty_holds_bound(m, bound) { Some(Carried(is_pid, m)) }
             else { carried_in(args, bound) }
      _   -> carried_in(args, bound)
    }
  }
  TyListT(x) -> carried(x, bound)
  _          -> None
}

fn carried_in(ts: [Ty], bound: [SymId]) : Option[Carried] = match ts {
  []           -> None
  [t, ...rest] -> match carried(t, bound) {
    Some(c) -> Some(c)
    None    -> carried_in(rest, bound)
  }
}

fn crossing_diag(site: SpawnSite, e: Expr, c: Carried) : Diagnostic = match c {
  Carried(is_pid, m) -> {
    let file = site.file
    let what = if is_pid { "an actor message" } else { "a fiber's result" }
    mk_diag(SevError, file, e.line, e.col,
            concat_all([what, " cannot hold `", carrier_display(site.tab, m), "`"]),
            [ri_note(file, e.line, e.col, "fibers have private heaps; the other side would not share it"),
             ri_help(file, e.line, e.col, "pass the value's contents, or let one fiber own the state and message it (`kai info actors`)")])
  }
}

# The diagnostics that say the same thing about the same names are one
# site seen through different instances of a generic, or through the
# copies a closure specialisation makes of it. The one kept is in the
# file the user compiles, else the earliest.
fn once_per_site(root: String, ds: [Diagnostic], acc: [Diagnostic]) : [Diagnostic] = match ds {
  []           -> acc
  [d, ...rest] -> once_per_site(root, rest,
    if any(acc, (a) => same_site(a, d)) { map(acc, (a) => if same_site(a, d) { preferred(root, a, d) } else { a }) }
    else { list_append(acc, [d]) })
}

fn same_site(a: Diagnostic, b: Diagnostic) : Bool = match a {
  D(_, _, _, _, ma, ia) -> match b {
    D(_, _, _, _, mb, ib) -> ma == mb and map(ia, ri_text) == map(ib, ri_text)
  }
}

fn ri_text(r: RelatedInfo) : String = match r { DR(_, _, _, m) -> m }

fn preferred(root: String, a: Diagnostic, b: Diagnostic) : Diagnostic = match a {
  D(_, fa, la, ca, _, _) -> match b {
    D(_, fb, lb, cb, _, _) ->
      if fa == root and fb != root { a }
      else if fb == root and fa != root { b }
      else if lb < la or (lb == la and cb < ca) { b }
      else { a }
  }
}
