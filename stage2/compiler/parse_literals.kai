#[doc("""
Literal parsing: decoding of integer, real and character text, fixed-width
literals, string literals with their interpolations, and regex sigils.
""")]

import compiler.util
import compiler.chars
import compiler.diag
import compiler.written
import compiler.lex
import compiler.interp_scan
import compiler.escapes
import compiler.lex_tokens
import compiler.ast
import compiler.parse_state

fn char_before_end(s: String, i: Int, n: Int) : Option[Char] =
  if i >= n { None } else { char_at(s, i) }

fn lit_base(span: String, i: Int, n: Int) : Int =
  if i + 1 < n and char_at(span, i) == Some('0') {
    match char_at(span, i + 1) {
      Some('x') -> 16
      Some('X') -> 16
      Some('b') -> 2
      Some('B') -> 2
      _ -> 0
    }
  } else { 0 }

fn hex_digit_value(c: Char) : Int =
  if ch_is_digit(c) { char_to_int(c) - char_to_int('0') }
  else if c >= 'a' and c <= 'f' { char_to_int(c) - char_to_int('a') + 10 }
  else if c >= 'A' and c <= 'F' { char_to_int(c) - char_to_int('A') + 10 }
  else { 0 }

# Hex digits end at `}` and read any other byte as 0, binary at the first non-bit.
fn digit_in(c: Char, base: Int) : Option[Int] =
  if base == 16 { if c == '}' { None } else { Some(hex_digit_value(c)) } }
  else if ch_is_digit(c) and char_to_int(c) - char_to_int('0') < base { Some(char_to_int(c) - char_to_int('0')) }
  else { None }

fn scan_digits(s: String, i: Int, n: Int, base: Int, acc: Int) : Int =
  match char_before_end(s, i, n) {
    None -> acc
    Some('_') -> scan_digits(s, i + 1, n, base, acc)
    Some(c) -> match digit_in(c, base) {
      Some(d) -> scan_digits(s, i + 1, n, base, acc * base + d)
      None -> acc
    }
  }

fn decode_magnitude(span: String, i: Int, n: Int) : Int =
  match lit_base(span, i, n) {
    0 -> scan_digits(span, i, n, 10, 0)
    base -> scan_digits(span, i + 2, n, base, 0)
  }

#[doc("Decode a decimal/hex/bin integer literal span (optional leading `-`, `_` separators) to Int. Shared with the backends for fixed-width literals that fit 64 bits.")]
pub fn decode_int(span: String) : Int =
  match char_at(span, 0) {
    None -> 0
    Some('-') -> 0 - decode_magnitude(span, 1, string_length(span))
    Some(_) -> decode_magnitude(span, 0, string_length(span))
  }

# Significant base digits after the `0x`/`0b` prefix: `_` and leading zeros do not count.
fn count_base_digits(s: String, i: Int, n: Int, acc: Int) : Int =
  match char_before_end(s, i, n) {
    None -> acc
    Some(c) ->
      if c == '_' or (c == '0' and acc == 0) { count_base_digits(s, i + 1, n, acc) }
      else { count_base_digits(s, i + 1, n, acc + 1) }
  }

# Decimal digits of a span without `_` and leading zeros, up to the first other byte.
fn significant_digits(s: String, i: Int, n: Int, acc: String) : String =
  match char_before_end(s, i, n) {
    None -> acc
    Some(c) ->
      if c == '_' or (c == '0' and acc == "") { significant_digits(s, i + 1, n, acc) }
      else if ch_is_digit(c) { significant_digits(s, i + 1, n, string_concat(acc, "#{c}")) }
      else { acc }
  }

# Longer magnitude wins; equal lengths order like the numbers do.
fn mag_gt(a: String, b: String) : Bool =
  if string_length(a) != string_length(b) { string_length(a) > string_length(b) } else { a > b }

#[doc("""
True when an integer literal's written form cannot be decoded without
wrapping. Decimal compares magnitude against 2^63-1; hex and binary are
bit patterns, so the check is the width: more than 16 significant hex or
64 significant binary digits.
""")]
pub fn int_lit_overflows(span: String) : Bool = {
  let n = string_length(span)
  match lit_base(span, 0, n) {
    16 -> count_base_digits(span, 2, n, 0) > 16
    2 -> count_base_digits(span, 2, n, 0) > 64
    _ -> mag_gt(significant_digits(span, 0, n, ""), "9223372036854775807")
  }
}

#[doc("Reports whether an integer literal carries a `0x` or `0b` prefix.")]
pub fn has_base_prefix(span: String) : Bool = lit_base(span, 0, string_length(span)) != 0

#[doc("""
Build a fixed-width integer literal: strip the `suf_len`-char width
suffix off the token span and keep the remaining digits verbatim in an
`EFixed` node tagged with the width type. The value is range-checked by
the typer, so an Int128 above 2^63 survives.
""")]
pub fn fixed_lit(src: String, t: Token, suf_len: Int, ty: Ty) : Expr {
  let span = tok_source(src, t)
  let digits = string_slice(span, 0, string_length(span) - suf_len)
  with_ty(expr_at(EFixed(digits, ty), t), ty)
}

#[doc("The width-tagged literal a fixed-width integer token spells, or `None` for any other token.")]
pub fn fixed_lit_of_tok(src: String, t: Token) : Option[Expr] =
  match t.kind {
    TkUInt8 -> Some(fixed_lit(src, t, 2, TyByte))
    TkInt32 -> Some(fixed_lit(src, t, 3, TyInt32))
    TkUInt32 -> Some(fixed_lit(src, t, 3, TyUInt32))
    TkUInt64 -> Some(fixed_lit(src, t, 3, TyUInt64))
    TkInt128 -> Some(fixed_lit(src, t, 4, TyInt128))
    _ -> None
  }

#[doc("Decodes real literal text, rejecting values out of range.")]
pub fn decode_real(span: String) : Option[Real] = string_to_real(replace(span, "_", ""))

#[doc("Returns the diagnostic for a real literal outside the representable range.")]
pub fn real_range_error() : String = "real literal out of range for Real"

# The lexer rejected every escape outside the table; `\xHH` and `\u{...}` name a scalar value, not UTF-8 bytes.
#[doc("Decodes the text of a character literal.")]
pub fn decode_char(span: String) : Char =
  int_to_char(match char_at(span, 1) {
    None -> 0
    Some('\\') -> unwrap_or(esc_decode_scalar_at(span, 2, string_length(span) - 1), 0)
    Some(_) -> string_cp_at(span, 1)
  })

fn interp_fail_head() : String = "cannot parse the interpolated expression"

fn interp_diag(p: Parser, src: String, body: InterpPos, inner: Option[Diagnostic]) : Diagnostic = {
  let own = concat_all([interp_fail_head(), " `", src, "`"])
  match inner {
    None -> mk_diag(SevError, p.file, body.line, body.col, own, [])
    Some(D(_, _, l, c, msg, notes)) ->
      if starts_with(msg, interp_fail_head()) { mk_diag(SevError, p.file, l, c, msg, notes) }
      else { mk_diag(SevError, p.file, body.line, body.col, concat_all([own, ": ", msg]), notes) }
  }
}

fn p_interp_report(p: Parser, d: Diagnostic) : Parser / Console = match d {
  D(sev, _, l, c, msg, notes) ->
    if p.file == interp_parse_file() { p_mark_err(p, d) }
    else {
      diag_error_from_src(p.file, p.src, l, c, msg)
      notes |> each((n) => match n { DR(_, _, _, m) -> diag_note(m) })
      p_mark_err(p, D(sev, p.file, l, c, msg, map(notes, (n) => match n { DR(_, nl, nc, m) -> DR(p.file, nl, nc, m) })))
    }
}

#[doc("""
A nested body that fails has already named itself; any other failure
names the body and carries the parser's reason.
""")]
pub fn p_interp_fail(p: Parser, src: String, body: InterpPos, inner: Option[Diagnostic]) : Parser / Console =
  p_interp_report(p, interp_diag(p, src, body, inner))

fn parse_interp_bodies(p: Parser, parts: [IPart], at: InterpPos, acc: [Expr]) : PArgs / Console = match parts {
  [] -> ok_args(p, list_reverse(acc))
  [IpLit(piece, _), ...rest] -> parse_interp_bodies(p, rest, interp_pos_advance(at, piece, 0), acc)
  [IpExp(src), ...rest] -> {
    let body = interp_pos_body(at)
    let toks = map(tokenize(src), (tk) => tok_at(tk, body.line, body.col))
    let sub = p_expr(Parser { ...p, file: interp_parse_file(), src: src, rest: toks, error: None,
                                  allow_trailing_lambda: true, allow_record_lit: true })
    match sub.r {
      None    -> err_args(p_interp_fail(p, src, body, sub.p.error))
      Some(x) -> parse_interp_bodies(p, rest, interp_pos_past(body, src), [x, ...acc])
    }
  }
}

#[doc("Parses a string literal, including the bodies of its `#{...}` interpolations.")]
pub fn parse_str_lit(p: Parser, t: Token) : PExpr / Console {
  let span = tok_source(p.src, t)
  let triple = string_length(span) >= 6 and starts_with(span, "\"\"\"")
  if span_interpolates(span, triple) {
    let parts = interp_parts(span, triple)
    let r = parse_interp_bodies(p, parts, InterpPos { line: t.line, col: t.col + interp_lead(triple) }, [])
    match r.r {
      None        -> err_e(r.p)
      Some(holes) -> ok_e(p_advance(r.p), expr_at(ESurface(SfInterp(span, triple, parts, holes)), t))
    }
  } else { ok_e(p_advance(p), expr_at(EStr(span, triple), t)) }
}

# `#` is refused in the body: it would start a `#{...}` interpolation in the generated string.
#[doc("Parses a `~r/pattern/` sigil into a call of `regexp.compile_or_panic` on the pattern as a string literal.")]
pub fn parse_regex_sigil(p: Parser, t: Token) : PExpr / Console {
  let span = tok_source(p.src, t)
  let pattern = string_slice(span, 3, string_length(span) - 4)
  if string_find(pattern, "#") >= 0 {
    fail_e(p, "regex sigil contains `#`, which v1 forbids (would collide with kaikai string interpolation); use `regex_compile` directly for patterns containing `#`")
  } else {
    let body = replace(replace(pattern, "\\", "\\\\"), "\"", "\\\"")
    let lit = expr_at(EStr(concat_all(["\"", body, "\""]), false), t)
    let callee = expr_at(EModCall(written("regexp"), written("compile_or_panic")), t)
    ok_e(p_advance(p), expr_at(ECall(callee, [lit]), t))
  }
}
