#[doc("The access check of `pub` and `pub(pkg)` exports, and the worker a `pub` loop that owns its `^` slot runs in.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.util
import compiler.ast_map
import compiler.borrow_infer
import compiler.perceus_arm
import compiler.trmc_self_call
import compiler.symtab
import compiler.written
import compiler.home_dup
import compiler.tailfuse
import compiler.diag
import compiler.diag_file
import compiler.modules_segments
import compiler.modules_homes
import compiler.pub_access_decl
import compiler.scope_view
import compiler.package_id
import compiler.resolve_env
import compiler.infer_index

# Module privacy, decided at one point. The table records every
# top-level symbol with its home module and `pub`-ness; every free
# reference the enumerator yields (`pub_access_decl.kai`) is resolved
# through `pa_decide` and diagnosed with one wording. Two rules share
# the one resolution:
#   - reference privacy: a name whose every carrier is non-`pub` in a
#     foreign module cannot be referenced;
#   - signature leak: a `pub` declaration's exported surface cannot
#     name a non-`pub` type / effect / protocol / unit of its own
#     module.
# Qualified references (`mod.name`) are validated earlier, where the
# qualified path is resolved against the module's export list.

type PaVerdict = PaVisible | PaPrivateTo(String) | PaUnknown

type PaMeta = { name: String, kind: String, is_pub: Bool, pkg: Bool }

# What every reference of one declaration is checked against.
type PaCx = { table: PaIndex, tab: SymTab, home: String, target_mod: String,
      cores: [String], file: String, pkgs: [PkgPick] }

#[doc("Validate module privacy over the per-module decl segments: the violations, in source order. `bounds` carries every module's fn tparam bounds, keyed by the module that declares the fn (the parser strips them from the stored tparams into a side table).")]
pub(pkg) fn validate_pub_access(segs: [CoreSegment], tab: SymTab, bounds: [FnBoundsRec],
      target_mod: String, cores: [String],
      df: DiagFiles, pkgs: [PkgPick]) : [Diagnostic] / Console + File {
  let table = pai_build(pa_table(segs, tab))
  let e1 = pa_check_segs(segs, table, tab, target_mod, cores, df, pkgs, [])
  list_reverse(pa_check_bound_segs(segs, bounds, table, tab, df, pkgs, e1))
}

#[doc("The top-level declarations a root-file reference cannot reach: those of a name whose every carrier is non-`pub` in a foreign module.")]
pub(pkg) fn pa_hidden_from_root(segs: [CoreSegment], tab: SymTab, target_mod: String) : [SymId] = {
  let entries = pa_table(segs, tab)
  flat_map(pa_hidden_loop(entries, pai_build(entries), target_mod, []), (name) => st_by_name(tab, name))
}

fn pa_hidden_loop(es: [PaEntry], table: PaIndex, target_mod: String,
      acc: [String]) : [String] = match es {
  [] -> acc
  [e, ...rest] -> {
    let hidden = match pa_decide(table, e.name, target_mod, false) {
      PaPrivateTo(_) -> not list_has(acc, e.name)
      _              -> false
    }
    pa_hidden_loop(rest, table, target_mod, if hidden { [e.name, ...acc] } else { acc })
  }
}

#[doc("Rebuild per-module segments from a rewritten flat decl stream, taking each segment's length from `orig`. The rewrite passes map decls 1:1, so slicing by length restores the module boundaries.")]
pub(pkg) fn pa_reseg(orig: [CoreSegment], flat: [Decl]) : [CoreSegment] = match orig {
  [] -> []
  [PSeg(mod_name, ds), ...rest] -> {
    let n = list_length(ds)
    [PSeg(mod_name, pae_take(flat, n)), ...pa_reseg(rest, pae_drop(flat, n))]
  }
}

#[doc("Slice the flat imported-decl stream into per-module segments using the (module, count) marks the resolver recorded.")]
pub(pkg) fn pa_import_segs(marks: [ImportSeg], flat: [Decl]) : [CoreSegment] = match marks {
  [] -> []
  [ISeg(home, n), ...rest] ->
    [PSeg(home, pae_take(flat, n)), ...pa_import_segs(rest, pae_drop(flat, n))]
}

# ==== decision ====

# A reference is admissible when at least one same-named entry is
# same-home or `pub` (locals-shadow-imports and root-shadows-core rely
# on this); it is private when every carrier is foreign and non-`pub`;
# it is unknown when no entry exists (the typer reports unbound names).
# A core module's own reference cannot mean a declaration in the root
# file: the root shadows the core name for the user's code, not for the
# core module that declared it. Without this, a `type Option` written in
# the root file makes every `Option` annotation inside `core/option.kai`
# read as a private access to the user's module. A root that is the core
# module's own file shadows nothing.
fn pa_decide_at(table: PaIndex, name: String, home: String,
      target_mod: String, cores: [String], types_only: Bool) : PaVerdict =
  if pa_is_core_home(home, cores) and not pa_is_core_home(target_mod, cores) {
    pa_decide_loop(pa_drop_home(pai_entries(table, name), target_mod),
                   name, home, types_only, None)
  } else { pa_decide(table, name, home, types_only) }

fn pa_is_core_home(home: String, cores: [String]) : Bool = list_has(cores, home)

fn pa_drop_home(entries: [PaEntry], drop: String) : [PaEntry] = match entries {
  [] -> []
  [e, ...rest] ->
    if e.home == drop { pa_drop_home(rest, drop) }
    else { [e, ...pa_drop_home(rest, drop)] }
}

fn pa_decide(table: PaIndex, name: String, home: String,
      types_only: Bool) : PaVerdict =
  pa_decide_loop(pai_entries(table, name), name, home, types_only, None)

fn pa_decide_loop(table: [PaEntry], name: String, home: String,
      types_only: Bool,
      first_private: Option[String]) : PaVerdict = match table {
  [] -> match first_private {
    Some(m) -> PaPrivateTo(m)
    None    -> PaUnknown
  }
  [e, ...rest] ->
    if e.name != name or (types_only and not e.is_ty) {
      pa_decide_loop(rest, name, home, types_only, first_private)
    } else if e.home == home or e.is_pub { PaVisible }
    else {
      let fp = match first_private { Some(_) -> first_private
      None -> Some(e.home) }
      pa_decide_loop(rest, name, home, types_only, fp)
    }
}

# The signature-leak lookup: a same-home non-`pub` entry in the type
# namespace, returned with its kind word for the diagnostic.
fn pa_leak_kind(table: PaIndex, name: String,
      home: String) : Option[String] = pa_leak_loop(pai_entries(table, name), name, home)

fn pa_leak_loop(entries: [PaEntry], name: String,
      home: String) : Option[String] = match entries {
  [] -> None
  [e, ...rest] ->
    if e.name == name and e.home == home and not e.is_pub and e.is_ty and not pa_is_ctor(e.kind) { Some(pa_kind_word(e.kind)) }
    else { pa_leak_loop(rest, name, home) }
}

fn pa_is_ctor(k: PaKind) : Bool = match k {
  PkCtor -> true
  _      -> false
}

# ==== walk + diagnostics ====

# Each segment carries its own module, so the diagnostics for its
# decls name that module's file rather than the root path.
fn pa_check_segs(segs: [CoreSegment], table: PaIndex, tab: SymTab, target_mod: String,
      cores: [String], df: DiagFiles, pkgs: [PkgPick],
      errs: [Diagnostic]) : [Diagnostic] / Console + File = match segs {
  [] -> errs
  [PSeg(mod_name, ds), ...rest] -> {
    let cx = PaCx { table: table, tab: tab, home: mod_name, target_mod: target_mod,
                    cores: cores, file: df_file_of(df, mod_name), pkgs: pkgs }
    pa_check_segs(rest, table, tab, target_mod, cores, df, pkgs, pa_check_decls(ds, cx, errs))
  }
}

fn pa_check_decls(ds: [Decl], cx: PaCx,
      errs: [Diagnostic]) : [Diagnostic] / Console + File = match ds {
  [] -> errs
  [d, ...rest] ->
    pa_check_decls(rest, cx, pa_check_decl(d, pa_decl_meta(d, cx.tab, not list_is_empty(cx.pkgs)), cx, errs))
}

fn pa_check_decl(d: Decl, meta: PaMeta, cx: PaCx, errs: [Diagnostic]) : [Diagnostic] / Console + File =
  pa_check_refs(pa_decl_refs(d), meta, cx, list_append(pa_package_home(d, meta, cx), errs))

# `pub(pkg)` is a promise about a package, which a file under no `kai.toml` is not part of.
fn pa_package_home(d: Decl, meta: PaMeta, cx: PaCx) : [Diagnostic] =
  if list_is_empty(cx.pkgs) or not meta.pkg or pkg_known(pkgs_root(cx.pkgs, st_module_id(cx.home))) { [] }
  else { match pa_decl_pos(d) {
    Some(lc) -> [mk_diag(SevError, cx.file, lc.fst, lc.snd, "`pub(pkg)` needs a package, and no `kai.toml` encloses this file", [])]
    None     -> []
  } }

fn pa_decl_pos(d: Decl) : Option[(Int, Int)] = match d {
  DFn(_, _, _, _, _, _, _, l, c, _)   -> Some((l, c))
  DConst(_, _, _, _, _, l, c)         -> Some((l, c))
  DType(_, _, _, _, l, c, _, _)       -> Some((l, c))
  DEffect(_, _, _, _, _, l, c, _)     -> Some((l, c))
  DProtocol(_, _, _, _, l, c, _)      -> Some((l, c))
  DDerive(_, inner, _, _)             -> pa_decl_pos(inner)
  _                                   -> None
}

fn pa_meta(name: String, kind: String, is_pub: Bool) : PaMeta =
  PaMeta { name: name, kind: kind, is_pub: is_pub, pkg: false }

fn pa_meta_s(tab: SymTab, pk: Bool, s: SymId, kind: String, is_pub: Bool) : PaMeta =
  PaMeta { name: pa_sym_text(tab, s), kind: kind, is_pub: is_pub, pkg: pk and mint_package(sym_mint(tab, s)) }

fn pa_decl_meta(d: Decl, tab: SymTab, pk: Bool) : PaMeta = match d {
  DFn(is_pub, fid, _, _, _, _, _, _, _, _)     -> pa_meta_s(tab, pk, fnid_sym(fid), "fn", is_pub)
  DAxiom(is_pub, _, name, _, _, _, _, _, _, _) -> pa_meta(name, "axiom", is_pub)
  DConst(is_pub, s, _, _, _, _, _)             -> pa_meta_s(tab, pk, s, "const", is_pub)
  DType(is_pub, s, _, _, _, _, _, _)           -> pa_meta_s(tab, pk, s, "type", is_pub)
  DEffect(is_pub, s, _, _, _, _, _, _)         -> pa_meta_s(tab, pk, s, "effect", is_pub)
  DProtocol(is_pub, s, _, _, _, _, _)          -> pa_meta_s(tab, pk, s, "protocol", is_pub)
  DUnit(is_pub, name, _, _, _, _, _)           -> pa_meta(name, "unit", is_pub)
  DDerive(_, inner, _, _)    -> pa_decl_meta(inner, tab, pk)
  DUnstable(inner, _, _)     -> pa_decl_meta(inner, tab, pk)
  DProtoLaws(_, inner, _, _, _) -> pa_decl_meta(inner, tab, pk)
  DImplAxiom(_, inner, _, _, _) -> pa_decl_meta(inner, tab, pk)
  DConstructor(inner, _, _)  -> pa_decl_meta(inner, tab, pk)
  DDoc(_, _, inner, _, _)    -> pa_decl_meta(inner, tab, pk)
  # An impl is not an exported signature of its own; its references
  # get the cross-module check but never the leak rule.
  _ -> pa_meta("", "", false)
}

fn pa_sym_text(tab: SymTab, s: SymId) : String = written_text(sym_name(tab, s))

fn pa_check_refs(refs: [PaRef], meta: PaMeta, cx: PaCx,
      errs: [Diagnostic]) : [Diagnostic] = match refs {
  [] -> errs
  [r, ...rest] ->
    pa_check_refs(rest, meta, cx, list_append(pa_check_ref(r, meta, cx), errs))
}

fn pa_check_ref(r: PaRef, meta: PaMeta, cx: PaCx) : [Diagnostic] = match r.name {
  PnWritten(n) -> pa_check_written(r, n, meta, cx)
  PnSym(s)     -> pa_check_sym(r, s, meta, cx)
}

fn pa_check_written(r: PaRef, n: String, meta: PaMeta, cx: PaCx) : [Diagnostic] =
  match pa_decide_at(cx.table, n, cx.home, cx.target_mod, cx.cores, r.is_ty) {
    # A builtin's name reaches a declaration only where the reader's own
    # module declares it, and that one is visible; elsewhere it is the builtin.
    PaPrivateTo(m) -> if list_has(core_names(), n) { [] } else { [pa_diag_private(cx.file, r, n, m)] }
    PaUnknown -> []
    PaVisible ->
      if pa_leak_position(r, meta) { pa_check_leak(r, n, meta, cx) }
      else { [] }
  }

# A reference a scope pass settled is judged on the declaration it names:
# reachable when its reader's own or `pub`, and a leak when a `pub`
# signature exposes a non-`pub` one of its own module.
fn pa_check_sym(r: PaRef, s: SymId, meta: PaMeta, cx: PaCx) : [Diagnostic] =
  if not list_is_empty(cx.pkgs) and st_valid(cx.tab, s) and sym_exported(cx.tab, s) and mint_package(sym_mint(cx.tab, s)) { pa_check_package_sym(r, s, meta, cx) }
  else if not st_valid(cx.tab, s) or sym_exported(cx.tab, s) { [] }
  else if not sym_owned_by(cx.tab, s, st_module_id(cx.home)) {
    [pa_diag_private(cx.file, r, pa_sym_text(cx.tab, s), written_text(sym_home(cx.tab, s)))]
  }
  else if pa_leak_position(r, meta) {
    match pa_cls_leak_word(sym_class(cx.tab, s)) {
      Some(w) -> [pa_diag_leak(cx.file, r, meta, pa_sym_text(cx.tab, s), w, cx.home)]
      None    -> []
    }
  }
  else { [] }

# A `pub(pkg)` declaration is reachable from the modules of its package and leaks
# when a `pub` signature, which other packages read, exposes one of its types.
fn pa_check_package_sym(r: PaRef, s: SymId, meta: PaMeta, cx: PaCx) : [Diagnostic] =
  if not pkgs_same(cx.pkgs, sym_owner(cx.tab, s), st_module_id(cx.home)) {
    [pa_diag_package(cx.file, r, pa_sym_text(cx.tab, s), written_text(sym_home(cx.tab, s)))]
  }
  else if meta.is_pub and not meta.pkg and pa_leak_position(r, meta) {
    match pa_cls_leak_word(sym_class(cx.tab, s)) {
      Some(w) -> [pa_diag_package_leak(cx.file, r, meta, pa_sym_text(cx.tab, s), w)]
      None    -> []
    }
  }
  else { [] }

fn pa_diag_package(file: String, r: PaRef, name: String, owner: String) : Diagnostic =
  mk_diag(SevError, file, r.line, r.col,
    concat_all(["`", name, "` is `pub(pkg)` in module `", owner,
      "`, which belongs to another package; declare it `pub` there to use it from here"]), [])

fn pa_diag_package_leak(file: String, r: PaRef, meta: PaMeta, name: String, kind_word: String) : Diagnostic =
  mk_diag(SevError, file, r.line, r.col,
    concat_all(["pub ", meta.kind, " `", meta.name, "` exposes ", kind_word, " `", name,
      "`, which is `pub(pkg)`; mark `", meta.name, "` `pub(pkg)` too or remove it from the signature"]), [])

# The kind word of a class the leak rule covers: the type namespace
# without constructors, which a type exposes on its own.
fn pa_cls_leak_word(c: NCls) : Option[String] = match c {
  NCType     -> Some(pa_kind_word(PkType))
  NCExternType -> Some(pa_kind_word(PkType))
  NCEffect   -> Some(pa_kind_word(PkEffect))
  NCProtocol -> Some(pa_kind_word(PkProtocol))
  NCUnit     -> Some(pa_kind_word(PkUnit))
  _          -> None
}

# The leak rule fires only for type-namespace references on the
# exported surface of a `pub` declaration.
fn pa_leak_position(r: PaRef, meta: PaMeta) : Bool =
  meta.is_pub and r.in_sig and r.leakable and r.is_ty

fn pa_diag_private(file: String, r: PaRef, name: String, owner: String) : Diagnostic =
  mk_diag(SevError, file, r.line, r.col,
    concat_all(["`", name, "` is private to module `", owner,
      "`; declare it `pub` in `", owner,
      "` to use it from other modules"]), [])

fn pa_check_leak(r: PaRef, n: String, meta: PaMeta, cx: PaCx) : [Diagnostic] =
  match pa_leak_kind(cx.table, n, cx.home) {
    None -> []
    Some(kind_word) -> [pa_diag_leak(cx.file, r, meta, n, kind_word, cx.home)]
  }

fn pa_diag_leak(file: String, r: PaRef, meta: PaMeta, name: String, kind_word: String,
      home: String) : Diagnostic =
  mk_diag(SevError, file, r.line, r.col,
    concat_all(["pub ", meta.kind, " `", meta.name,
      "` exposes non-pub ", kind_word, " `", name,
      "` from module `", home, "`; mark `", name,
      "` as `pub` or remove it from the signature"]), [])

# ==== fn tparam bounds ====

# A bound (`fn f[T: Sneaky]`) references the protocol by name, but the
# parser stores fn-decl bounds in a side table instead of the tparam
# string — walk each module's fn decls against its own bounds.
fn pa_check_bound_segs(segs: [CoreSegment], bounds: [FnBoundsRec],
      table: PaIndex, tab: SymTab, df: DiagFiles, pkgs: [PkgPick],
      errs: [Diagnostic]) : [Diagnostic] = match segs {
  [] -> errs
  [PSeg(mod_name, ds), ...rest] -> {
    let own = filter(bounds, (b) => match b { FBR(_, mo, _) -> mo == Some(mod_name) })
    let cx = PaCx { table: table, tab: tab, home: mod_name, target_mod: mod_name,
                    cores: [], file: df_file_of(df, mod_name), pkgs: pkgs }
    let e1 = if list_length(own) == 0 { errs } else { pa_check_bound_decls(ds, own, cx, errs) }
    pa_check_bound_segs(rest, bounds, table, tab, df, pkgs, e1)
  }
}

# The side table keys a function's bounds by the name it was written with.
fn pa_check_bound_decls(ds: [Decl], bounds: [FnBoundsRec], cx: PaCx,
      errs: [Diagnostic]) : [Diagnostic] = match ds {
  [] -> errs
  [d, ...rest] -> match d {
    DFn(is_pub, fid, _, _, _, _, _, line, col, _) -> {
      let name = pa_sym_text(cx.tab, fnid_sym(fid))
      pa_check_bound_decls(rest, bounds, cx,
        pa_check_refs(pa_bound_table_refs(bounds, name, line, col),
                      pa_meta(name, "fn", is_pub), cx, errs))
    }
    _ -> pa_check_bound_decls(rest, bounds, cx, errs)
  }
}

fn pa_bound_table_refs(bounds: [FnBoundsRec], fname: String,
      line: Int, col: Int) : [PaRef] = match bounds {
  [] -> []
  [FBR(name, _, ftbs), ...rest] ->
    if name == fname { pa_ftb_refs(ftbs, line, col, []) }
    else { pa_bound_table_refs(rest, fname, line, col) }
}

fn pa_ftb_refs(ftbs: [FnTPBound], line: Int, col: Int,
      acc: [PaRef]) : [PaRef] = match ftbs {
  [] -> acc
  [FTB(_, names), ...rest] ->
    pa_ftb_refs(rest, line, col, pa_bound_names(names, line, col, acc))
}

fn pub_loop_worker_name(f: String) : String = cat2("__kai_loop_", f)

#[doc("`prog` with every `pub` function whose back-edge hands a `^` slot an owned value split into a forwarding wrapper and its worker, whose rows join `prog`'s.")]
pub(pkg) fn pub_loop_workers(prog: TailFused, tab: SymTab, target: String) : TailFused =
  if any(prog.decls, (d) => plw_needs_worker(d, tab)) {
    plw_split_all(prog.decls, PlwIn { tab: tab, target: target }, [], list_reverse(prog.rows))
  } else { prog }

type PlwIn = { tab: SymTab, target: String }

fn plw_split_all(decls: [Decl], inp: PlwIn, acc: [Decl], rows: [NEnt]) : TailFused = match decls {
  []           -> TailFused { decls: list_reverse(acc), rows: list_reverse(rows) }
  [d, ...rest] ->
    if plw_needs_worker(d, inp.tab) {
      let row = plw_row(d, inp)
      let wsym = nent_sym(row)
      plw_split_all(rest, inp, [plw_wrapper(d, wsym), plw_worker(d, wsym), ...acc], [row, ...rows])
    } else { plw_split_all(rest, inp, [d, ...acc], rows) }
}

fn plw_needs_worker(d: Decl, tab: SymTab) : Bool = match d {
  DFn(true, fid, _, params, _, _, body, _, _, _) -> match pcs_explicit_borrow_names(params) {
    []    -> false
    caret -> {
      let pnames = map(params, (p) => p.binder)
      list_length(bbe_keep_borrowed(tab, SelfRef(fid), pnames, caret, body)) < list_length(caret)
    }
  }
  _ -> false
}

# The worker is homed beside the function it serves.
fn plw_row(d: Decl, inp: PlwIn) : NEnt = match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) -> {
    let name = pub_loop_worker_name(written_text(decl_name(inp.tab, fnid_sym(fid))))
    let home = match home_tu(d) { Some(m) -> m  None -> inp.target }
    NEnt(NCFn, name, home, false, NmHelper)
  }
  _ -> panic("pub_loop_worker: a row for a declaration that is not a function")
}

fn plw_worker(d: Decl, wsym: SymId) : Decl = match d {
  DFn(_, fid, tparams, params, opt_ret, row, body, ln, cl, mo) ->
    DFn(false, fnid_decl(wsym), tparams, params, opt_ret, row, plw_retarget(body, fnid_sym(fid), wsym), ln, cl, mo)
  _ -> d
}

fn plw_wrapper(d: Decl, wsym: SymId) : Decl = match d {
  DFn(is_pub, fid, tparams, params, opt_ret, row, _, ln, cl, mo) -> {
    let args = map(params, (p) => mk_local(p.binder.id, ln, cl))
    DFn(is_pub, fid, tparams, params, opt_ret, row, mk_expr(ECall(mk_sym(wsym, ln, cl), args), ln, cl), ln, cl, mo)
  }
  _ -> d
}

# Every reference to the function inside its own body names the worker,
# so each back-edge stays a self call the tail rewrite turns into a jump.
fn plw_retarget(e: Expr, me: SymId, wsym: SymId) : Expr = match e.kind {
  ESym(s, inst) ->
    if sym_raw(s) == sym_raw(me) { Expr { ...e, kind: ESym(wsym, inst) } } else { e }
  k -> Expr { ...e, kind: prc_map_expr_kind(k, (x) => plw_retarget(x, me, wsym)) }
}

# Hash index over the privacy table. `pa_decide` and `pa_leak_kind` both
# filter the whole table down to one name's entries and only then apply their
# rule, so both are a scan over every top-level symbol in the program for
# every reference the enumerator yields. The index answers "this name's
# entries" and leaves the two rules untouched. Entry order within a name
# decides the verdict: `pa_decide` reports the FIRST private carrier it meets,
# so a bucket chain must preserve the table's source order. `idx_prepend`
# builds newest-first, so the table is indexed back to front and the chain
# comes out in source order. A hash collision mixes foreign names into a
# chain; both readers re-test `name`, so it costs a comparison, never a
# verdict.

#[doc("Hash index from a symbol name to its privacy-table entries, in source order.")]
type PaIndex = { ix: NameIndex[PaEntry] }

#[doc("Index a privacy table so each name's entries are reachable without scanning it.")]
fn pai_build(table: [PaEntry]) : PaIndex =
  PaIndex { ix: pai_add_rev(list_reverse(table), idx_empty()) }

fn pai_add_rev(rev: [PaEntry], ix: NameIndex[PaEntry]) : NameIndex[PaEntry] = match rev {
  []           -> ix
  [e, ...rest] -> pai_add_rev(rest, idx_prepend(ix, e.name, e))
}

#[doc("The entries registered under `name`, in source order; empty when the name is absent.")]
fn pai_entries(px: PaIndex, name: String) : [PaEntry] =
  idx_chain(px.ix, name)
