#[doc("""
Entries bucketed by a name's hash. Perceus asks the same question of one
table for every name in a function — how often it is read, whether a
lambda captures it, how each read is used — so the entries are bucketed
as they are collected, and each question walks one bucket instead of
the whole table.
""")]

#[doc("Entries bucketed by the hash of the name each one is about.")]
pub type NameIx[a] = NameIx(Array[[a]])

const BUCKETS : Int = 128

#[doc("Empty buckets for a collector to fill with `ni_add`.")]
pub fn ni_buckets() : Array[[a]] = array_make(BUCKETS, [])

#[doc("`buckets` with `x` added under `key`.")]
pub fn ni_add(buckets: Array[[a]], key: String, x: a) : Array[[a]] / Mutable = {
  let b = ni_slot(key)
  buckets[b] := [x, ...array_get(buckets, b)]
  buckets
}

#[doc("The index over filled buckets.")]
pub fn ni_wrap(buckets: Array[[a]]) : NameIx[a] = NameIx(buckets)

#[doc("The bucket holding the entries about `key`. It holds every name that hashes alike, so a consumer re-tests the name of each entry.")]
pub fn ni_bucket(ix: NameIx[a], key: String) : [a] = match ix {
  NameIx(buckets) -> array_get(buckets, ni_slot(key))
}

fn ni_slot(key: String) : Int = ((string_hash(key) % BUCKETS) + BUCKETS) % BUCKETS
