#[doc("""
The exit of a call, for tail-call shaping.

What follows a call before the function returns: copies of the result, the
releases of other values, the pads it closes, the regions it leaves. An exit
that does anything else with the result is no tail.
""")]

import compiler.kir

#[doc("The exit of a call: the releases to move, the pads it closes, where it returns and whether it leaves a region, a postcondition between them, or no tail.")]
pub(pkg) type KtExit = KtOk([KStmt], [KStmt], KPos, Bool) | KtChecked([KStmt], [KStmt], Option[KtPost]) | KtNo

#[doc("A postcondition that reads nothing but the call's result: the statements that check it and return, from the register that holds the result, the value they return and where.")]
pub(pkg) type KtPost = { x: String, stmts: [KStmt], value: String, pos: KPos }

#[doc("What the scan of an exit has seen: the registers holding the call's result, the releases to move, the pads to close, whether the result is read by work other than a copy or by a postcondition, and the copies out of a region and the arenas freed.")]
pub(pkg) type KtSt = { alias: [String], drops: [KStmt], pads: [KStmt], raw: Bool, checked: Bool, lenient: Bool, copies: Int, pops: Int, tail: [KStmt], defs: [String], opens: Int }

#[doc("The scan of an exit starting at the register `x` that holds the call's result.")]
pub(pkg) fn kt_start(x: String, raw: Bool) : KtSt =
  KtSt { alias: [x], drops: [], pads: [], raw: raw, checked: false, lenient: false, copies: 0, pops: 0, tail: [], defs: [x], opens: 0 }

#[doc("True when a block belongs to a region, whose returns no call may be moved across.")]
pub(pkg) fn kt_in_region(r: Option[Int]) : Bool = is_some(r)

#[doc("True when a result in `slot` is a raw scalar, which carries no reference count.")]
pub(pkg) fn kt_raw(slot: KSlot) : Bool = match slot {
  SBoxed -> false
  _      -> true
}

#[doc("The releases an exit performs before returning a copy of the call's result, and where it returns; an exit that does anything else, or releases the result, is no tail.")]
pub(pkg) fn kt_exit(stmts: [KStmt], term: KTerm, st: KtSt, blocks: [KBlock], fuel: Int) : KtExit = match stmts {
  [] -> kt_exit_end(term, st, blocks, fuel)
  [s, ...rest] -> match kt_step(s, st) {
    Some(st1) -> kt_exit(rest, term, st1, blocks, fuel)
    None      -> KtNo
  }
}

fn kt_exit_end(term: KTerm, st: KtSt, blocks: [KBlock], fuel: Int) : KtExit = match term {
  KRet(KVar(v), pos) ->
    if not kt_has(st.alias, v) { KtNo }
    else if st.lenient { if st.checked { kt_checked(v, pos, st) } else { KtNo } }
    else if st.checked { kt_checked(v, pos, st) }
    else if st.copies != st.pops { KtNo }
    else { KtOk(list_reverse(st.drops), list_reverse(st.pads), pos, st.copies > 0) }
  KBr(l, _) -> match kt_find(blocks, l) {
    Some(nb) -> if fuel <= 0 or kt_in_region(nb.region_id) { KtNo } else { kt_exit(nb.stmts, nb.term, st, blocks, fuel - 1) }
    None     -> KtNo
  }
  _ -> KtNo
}

fn kt_checked(v: String, pos: KPos, st: KtSt) : KtExit = {
  let x = match list_reverse(st.defs) {
    []           -> ""
    [first, ...rest] -> first
  }
  let closed = st.copies == 0 and kt_has(st.defs, v) and not any(st.tail, (s) => not kt_closed(s, st.defs))
  KtChecked(list_reverse(st.drops), list_reverse(st.pads),
            if closed { Some(KtPost { x: x, stmts: list_reverse(st.tail), value: v, pos: pos }) } else { None })
}

# One statement of an exit, or none when the exit does something a tail call cannot move before the call.
fn kt_step(s: KStmt, st: KtSt) : Option[KtSt] = map(kt_scan(s, st), (st1) => kt_record(s, st, st1))

# What the postcondition of an exit is made of: every statement that is not a release or a pad moved before the call.
fn kt_record(s: KStmt, st: KtSt, st1: KtSt) : KtSt =
  if list_length(st1.drops) > list_length(st.drops) or list_length(st1.pads) > list_length(st.pads) { st1 }
  else { KtSt { ...st1, tail: [kt_pad_own(s, st1.defs), ...st1.tail], defs: list_append(kt_defs(s), st1.defs) } }

# A pad opened by the check releases only what the check holds: the other registers it names were released before the call.
fn kt_pad_own(s: KStmt, defs: [String]) : KStmt = match s {
  KLet(r, slot, KPrim(KpPadOpen, xs), pos) -> KLet(r, slot, KPrim(KpPadOpen, filter(xs, (x) => match x {
    KVar(n) -> kt_has(defs, n)
    _       -> true
  })), pos)
  _ -> s
}

fn kt_defs(s: KStmt) : [String] = match s {
  KLet(r, _, _, _) -> [r]
  KStore(n, _, _)  -> [n]
  _                -> []
}

# True when the statement reads no register but those in `defs`, and only through operations whose operands are known.
fn kt_closed(s: KStmt, defs: [String]) : Bool = match kt_stmt_reads(s) {
  None     -> false
  Some(xs) -> not any(xs, (x) => not kt_has(defs, x))
}

fn kt_stmt_reads(s: KStmt) : Option[[String]] = match s {
  KLet(_, _, op, _) -> kt_op_reads(op)
  KDo(op, _)        -> kt_op_reads(op)
  KStore(_, v, _)   -> Some(kt_vars([v]))
  KRC(KDup(v), _)   -> Some(kt_vars([v]))
  KRC(KDrop(v), _)  -> Some(kt_vars([v]))
  _                 -> None
}

fn kt_op_reads(op: KOp) : Option[[String]] = match op {
  KPrim(_, xs)    -> Some(kt_vars(xs))
  KCall(_, xs)    -> Some(kt_vars(xs))
  KLitOp(v)       -> Some(kt_vars([v]))
  KProj(v, _)     -> Some(kt_vars([v]))
  KProjBorrow(v, _) -> Some(kt_vars([v]))
  KTagOf(v)       -> Some(kt_vars([v]))
  _               -> None
}

fn kt_vars(vs: [KVal]) : [String] = flat_map(vs, (v) => match v {
  KVar(n) -> [n]
  _       -> []
})

fn kt_scan(s: KStmt, st: KtSt) : Option[KtSt] = match s {
  KStore(n, KVar(v), _) -> kt_copy(n, v, st)
  KLet(r, _, KLitOp(KVar(v)), _) -> kt_copy(r, v, st)
  KLet(r, _, KPrim(KpUnbox(_), [KVar(v)]), _) -> if st.raw { kt_copy(r, v, st) } else { None }
  KDo(KPrim(KpPadClose, _), _) ->
    if st.opens > 0 { Some(KtSt { ...st, opens: st.opens - 1 }) } else { Some(KtSt { ...st, pads: [s, ...st.pads] }) }
  KLet(_, _, KPrim(KpPadOpen, xs), _) -> map(kt_work(KPrim(KpPadOpen, xs), st), (st1) => KtSt { ...st1, opens: st1.opens + 1 })
  KLet(r, _, KCall(sym, [KVar(v)]), _) ->
    if sym == kir_deep_copy_out_sym() and kt_has(st.alias, v) { Some(KtSt { ...st, alias: [r, ...st.alias], copies: st.copies + 1 }) }
    else { kt_work(KCall(sym, [KVar(v)]), st) }
  KDo(KCall(sym, []), _) ->
    if sym == kir_arena_pop_sym() { Some(KtSt { ...st, pads: [s, ...st.pads], pops: st.pops + 1 }) } else { kt_work(KCall(sym, []), st) }
  KDo(KPrim(KpAssertCheck, _), _) -> Some(KtSt { ...st, checked: true })
  KDo(KPrim(KpAssertCheckWithValue, _), _) -> Some(KtSt { ...st, checked: true })
  KRC(KDup(KVar(v)), _) -> if kt_has(st.alias, v) { Some(KtSt { ...st, lenient: true }) } else if st.lenient { Some(st) } else { None }
  KRC(KDrop(KVar(v)), _) -> kt_release(s, v, st)
  KLet(_, _, op, _) -> kt_work(op, st)
  KDo(op, _) -> kt_work(op, st)
  _ -> if st.lenient { Some(st) } else { None }
}

fn kt_copy(to: String, from: String, st: KtSt) : Option[KtSt] =
  if kt_has(st.alias, from) { Some(KtSt { ...st, alias: [to, ...st.alias] }) } else { None }

# Releasing another register moves before the call; releasing the result is nothing for a raw scalar.
fn kt_release(s: KStmt, v: String, st: KtSt) : Option[KtSt] =
  if not kt_has(st.alias, v) and not kt_has(st.defs, v) { Some(KtSt { ...st, drops: [s, ...st.drops] }) }
  else if not kt_has(st.alias, v) { Some(st) }
  else if st.raw { Some(st) }
  else { None }

# Work that reads the result is no tail; it is looked past only to find a postcondition.
fn kt_work(op: KOp, st: KtSt) : Option[KtSt] =
  if st.lenient or kt_reads(op, st.alias) { Some(KtSt { ...st, lenient: true }) } else { None }

fn kt_reads(op: KOp, alias: [String]) : Bool = match op {
  KPrim(_, xs) -> any(xs, (x) => kt_uses(x, alias))
  KCall(_, xs) -> any(xs, (x) => kt_uses(x, alias))
  _            -> false
}

fn kt_uses(v: KVal, alias: [String]) : Bool = match v {
  KVar(n) -> kt_has(alias, n)
  _       -> false
}

fn kt_has(xs: [String], x: String) : Bool = any(xs, (y) => y == x)

fn kt_find(blocks: [KBlock], l: String) : Option[KBlock] = match blocks {
  []           -> None
  [b, ...rest] -> if b.label == l { Some(b) } else { kt_find(rest, l) }
}
