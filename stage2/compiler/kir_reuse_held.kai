#[doc("""
Native reuse rebuilds under a registered scrutinee.

A match whose arms can unwind registers its scrutinee, and an exit out
of a rebuild releases that cell. A reuse arm there keeps the cell and
the binders apart: each child the rebuild takes leaves its slot
(`kaix_take_slot`) and is registered with its binder, and each operand
value computed before a later operand is held for that operand's extent.
""")]

import compiler.ast
import compiler.kir
import compiler.kir_lower
import compiler.unwind_pend
import compiler.unwind_binders
import compiler.emit_tcrec_live
import compiler.util

#[doc("True when the enclosing match registered its scrutinee: a rebuild here can be left by an exit that releases the cell.")]
pub fn rh_held(st: LowerSt) : Bool = st.mscr != "" and unw_mreg(st.unw, st.mscr) != ""

#[doc("`st` with the arm binders `names` owned, so the sites that hold them register them.")]
pub fn rh_own(st: LowerSt, names: [String]) : LowerSt =
  if st.unw.arms == [] or names == [] { st } else { ls_with_unw(st, unw_owning(st.unw, names)) }

#[doc("Take each child `names` binds out of `donor`, once per name: a unique cell clears the slot, a shared one increfs the child.")]
pub fn rh_take_slots(donor: KVal, names: [String], pos: KPos, st: LowerSt) : LowerSt = match names {
  [] -> st
  [n, ...rest] -> match bind_op(st, KCall("kaix_take_slot", [donor, KVar(ls_reg_of(st, n))]), pos) {
    LRes(_, st1) -> rh_take_slots(donor, rest, pos, st1)
  }
}

#[doc("The registrations a rebuild holds: each push register with the temp it registers.")]
pub type RhHolds = { regs: [(String, String)], st: LowerSt }

#[doc("Hold `v`, the value of operand `e` of kind `k`, when a later operand runs and no binder already holds it.")]
pub fn rh_hold(e: Expr, v: KVal, k: Int, later: Bool, pos: KPos, h: RhHolds) : RhHolds = match v {
  KVar(r) -> if later and k != 1 and not unw_bare_read(e) { rh_push(r, pos, h) } else { h }
  _       -> h
}

fn rh_push(r: String, pos: KPos, h: RhHolds) : RhHolds = match ls_fresh_reg(h.st) {
  LSReg(f, st1) -> {
    let st2 = ls_emit(st1, KLet(f, SBoxed, KPrim(KpUnwPushReg, [KStrV(r), KVar(unw_fib(st1.unw))]), pos))
    RhHolds { regs: [(f, r), ...h.regs], st: ls_set_tcpend(st2, tcl_hold(st2.tcpend, f, r)) }
  }
}

#[doc("Pop every registration `h` holds, once the last operand has run.")]
pub fn rh_release(h: RhHolds, pos: KPos) : LowerSt = rh_pops(h.regs, pos, h.st)

fn rh_pops(regs: [(String, String)], pos: KPos, st: LowerSt) : LowerSt = match regs {
  [] -> st
  [(f, r), ...rest] -> {
    let st1 = ls_emit(st, KDo(KPrim(KpUnwPop, [KVar(f)]), pos))
    rh_pops(rest, pos, ls_set_tcpend(st1, tcl_unhold(st1.tcpend, f, r)))
  }
}

#[doc("The occurrences in `xs` after each name's first: what a taken slot leaves for the per-use incref.")]
pub fn rh_repeats(xs: [String]) : [String] = rh_repeats_go(xs, [])

fn rh_repeats_go(xs: [String], seen: [String]) : [String] = match xs {
  [] -> []
  [x, ...rest] -> if list_has(seen, x) { [x, ...rh_repeats_go(rest, seen)] } else { rh_repeats_go(rest, [x, ...seen]) }
}
