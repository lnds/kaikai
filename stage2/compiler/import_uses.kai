# compiler/import_uses.kai — the imports a file never refers to.
#
# An import is used when the file mentions its written name (a
# qualifier) or any name the module exports — its protocol operations
# included, since an op is called without its protocol's name — anywhere
# outside the import lines themselves; a module that declares impls, or
# nothing at all, is used by being loaded and is never reported. The scan is over the token stream, not the AST:
# every position a name can occupy counts the same way, and a word inside
# a string literal counts too, so an interpolation (`#{m.f(x)}`) keeps its
# module alive. A name right after `m.` belongs to `m` alone; any other
# identifier may be a bare or UFCS reference to whichever module exports
# it. Over-approximating "used" is the safe direction — a missed use
# would be a false report.

import compiler.chars
import compiler.util
import compiler.lex_tokens
import compiler.lex
import compiler.ast
import compiler.resolve_register
import compiler.module_table
import compiler.span_names
import compiler.core_types

#[doc("One import nothing in its file refers to: `UImp(written_name, origin, line, col)`, `origin` being the path of the module it loads.")]
pub type UnusedImport = UImp(String, String, Int, Int)

#[doc("One loaded file as the unit-wide import check sees it: its origin and diagnostic path, what a rescan of it needs (`src`, `import_lines`, the module names it binds), the modules its used imports load, its unused imports, and what would mark each of those used.")]
pub type FileImports = { origin: String, path: String, src: String, import_lines: [Int], mods: [String], edges: [String], unused: [UnusedImport], marks: [ImportMarks] }

#[doc("The names that mark an import used: `IMarks(written_name, names)`.")]
pub type ImportMarks = IMarks(String, [String])

#[doc("What a file can refer to a loaded module by: `MNames(origin, names, silent)` — the exports plus protocol operation names; `silent` when loading the module is its use (it declares impls, or nothing).")]
pub type ModNames = MNames(String, [String], Bool)

#[doc("The `ModNames` of a module loaded from `origin` with `exports`, read off its declarations.")]
pub fn mod_names(origin: String, exports: [String], decls: [Decl]) : ModNames =
  MNames(origin, mn_proto_ops(decls, exports), decls_declare_impls(decls) or list_length(decls) == 0)

fn mn_proto_ops(ds: [Decl], acc: [String]) : [String] = match ds {
  []           -> acc
  [d, ...rest] -> mn_proto_ops(rest, mn_decl_ops(d, acc))
}

fn mn_decl_ops(d: Decl, acc: [String]) : [String] = match d {
  DProtocol(true, _, _, ops, _, _, _) -> mn_ops(ops, acc)
  DDoc(_, _, inner, _, _)             -> mn_decl_ops(inner, acc)
  DAttr(_, inner, _, _)               -> mn_decl_ops(inner, acc)
  DUnstable(inner, _, _)              -> mn_decl_ops(inner, acc)
  DProtoLaws(_, inner, _, _, _)       -> mn_decl_ops(inner, acc)
  _                                   -> acc
}

fn mn_ops(ops: [ProtoOp], acc: [String]) : [String] = match ops {
  []                                  -> acc
  [POp(n, _, _, _, _, _), ...rest]    -> mn_ops(rest, [n, ...acc])
}

#[doc("The `ModNames` recorded in `table` for the module loaded from `origin`.")]
pub fn mod_names_find(table: [ModNames], origin: String) : Option[ModNames] = match table {
  []           -> None
  [MNames(o, ns, sl), ...rest] -> if o == origin { Some(MNames(o, ns, sl)) } else { mod_names_find(rest, origin) }
}

# Something still waiting for its first mention: its key, and every name
# that counts as one.
type Pending = Pend(String, [String])

# An import that may turn out unused, with the names that mark it used.
type ImportCand = ICand(UnusedImport, [String])

#[doc("Scan one file's imports. `bindings` are the file's own import entries; `table` the names of every loaded module, keyed by origin.")]
pub fn file_imports(origin: String, path: String, src: String, tokens: [Token], decls: [Decl],
                    bindings: [ModuleEntry], table: [ModNames]) : FileImports = {
  let cands = iu_cands(decls, bindings, table, [])
  let pending = iu_cand_pending(cands, [])
  let cx = iu_cx(src, iu_import_lines(decls, []), iu_module_names(bindings, []), pending)
  let unused = iu_unused(cands, iu_scan(cx, tokens, 0, pending), [])
  FileImports { origin: origin, path: path, src: src, import_lines: cx.import_lines, mods: cx.mods,
                edges: iu_edges(bindings, unused, []), unused: unused, marks: iu_marks(cands, unused, []) }
}

#[doc("`f` once `names` count as mentions in it too: an unused import one of them marks is used. For names no token of the file spells, as a derive's expansion refers to.")]
pub fn file_also_mentions(f: FileImports, names: [String]) : FileImports = {
  let still = filter(f.unused, (u) => not iu_marked(f.marks, u, names))
  if list_length(still) == list_length(f.unused) { f }
  else { FileImports { ...f, unused: still, edges: iu_now_used(f.unused, still, f.edges) } }
}

fn iu_marks(cs: [ImportCand], unused: [UnusedImport], acc: [ImportMarks]) : [ImportMarks] = match cs {
  [] -> acc
  [ICand(UImp(w, _, _, _), ns), ...rest] ->
    iu_marks(rest, unused, if iu_unused_has(unused, w) { [IMarks(w, [w, ...ns]), ...acc] } else { acc })
}

fn iu_marked(ms: [ImportMarks], u: UnusedImport, names: [String]) : Bool = match ms {
  [] -> false
  [IMarks(w, ns), ...rest] -> match u {
    UImp(uw, _, _, _) -> (w == uw and iu_any_in(names, ns)) or iu_marked(rest, u, names)
  }
}

fn iu_any_in(names: [String], ns: [String]) : Bool = match names {
  []           -> false
  [n, ...rest] -> list_has(ns, n) or iu_any_in(rest, ns)
}

# The origins of the imports that left `unused`, ahead of `edges`.
fn iu_now_used(unused: [UnusedImport], still: [UnusedImport], edges: [String]) : [String] = match unused {
  [] -> edges
  [UImp(w, o, _, _), ...rest] ->
    iu_now_used(rest, still, if iu_unused_has(still, w) { edges } else { [o, ...edges] })
}

#[doc("The origins among `mods` that `f` mentions by one of their names, a name qualified by another module aside.")]
pub fn file_mentions(f: FileImports, mods: [ModNames]) : [String] = {
  let pending = iu_mod_pending(mods, [])
  let cx = iu_cx(f.src, f.import_lines, f.mods, pending)
  iu_mentioned(pending, iu_scan(cx, tokenize(f.src), 0, pending), [])
}

# The scan's fixed inputs: the source, the lines the imports sit on, and
# every module name the file binds (a qualifier). The two indexes answer
# "could this word be a qualifier / a pending name" without walking a list.
type IuCx = { src: String, import_lines: [Int], last_import_line: Int, mods: [String],
              mods_ix: SpanNames, names_ix: SpanNames }

fn iu_cx(src: String, import_lines: [Int], mods: [String], pending: [Pending]) : IuCx =
  IuCx { src: src, import_lines: import_lines, last_import_line: iu_max_line(import_lines, 0), mods: mods,
         mods_ix: span_names(mods), names_ix: span_names(iu_pending_names(pending, [])) }

fn iu_max_line(ls: [Int], acc: Int) : Int = match ls {
  []           -> acc
  [h, ...rest] -> iu_max_line(rest, if h > acc { h } else { acc })
}

fn iu_pending_names(ps: [Pending], acc: [String]) : [String] = match ps {
  []                     -> acc
  [Pend(_, ns), ...rest] -> iu_pending_names(rest, iu_push_all(ns, acc))
}

fn iu_push_all(ns: [String], acc: [String]) : [String] = match ns {
  []           -> acc
  [n, ...rest] -> iu_push_all(rest, [n, ...acc])
}

fn iu_on_line(cx: IuCx, line: Int) : Bool =
  line <= cx.last_import_line and iu_on_import_line(cx.import_lines, line)

fn iu_module_names(mes: [ModuleEntry], acc: [String]) : [String] = match mes {
  []                         -> acc
  [ME(w, _, _, _), ...rest]  -> iu_module_names(rest, [w, ...acc])
}

fn iu_import_lines(ds: [Decl], acc: [Int]) : [Int] = match ds {
  []                          -> acc
  [DImport(_, l, _), ...rest] -> iu_import_lines(rest, [l, ...acc])
  [_, ...rest]                -> iu_import_lines(rest, acc)
}

# An import whose module failed to load has no binding and was already
# reported; it is no candidate. A binding without names (not loaded this
# run) falls back to its export list.
fn iu_cands(ds: [Decl], bindings: [ModuleEntry], table: [ModNames], acc: [ImportCand]) : [ImportCand] = match ds {
  [] -> list_reverse(acc)
  [DImport(ik, l, c), ...rest] -> match iu_written(ik) {
    None -> iu_cands(rest, bindings, table, acc)
    Some(w) -> match mt_lookup(bindings, w) {
      Some(ME(_, exports, origin, _)) -> {
        let left = mt_drop_first(bindings, w)
        match mod_names_find(table, origin) {
          Some(MNames(_, _, true))      -> iu_cands(rest, left, table, acc)
          Some(MNames(_, names, false)) -> iu_cands(rest, left, table, [ICand(UImp(w, origin, l, c), names), ...acc])
          None                          -> iu_cands(rest, left, table, [ICand(UImp(w, origin, l, c), exports), ...acc])
        }
      }
      None -> iu_cands(rest, bindings, table, acc)
    }
  }
  [_, ...rest] -> iu_cands(rest, bindings, table, acc)
}

fn iu_written(ik: ImportKind) : Option[String] = match ik {
  IkPath(p)         -> Some(last_segment(p))
  IkAlias(_, alias) -> Some(alias)
  IkSelective(p, _) -> Some(last_segment(p))
  IkHole(_)         -> None
}

# A candidate is keyed by its written name, which is also a mention of it.
fn iu_cand_pending(cs: [ImportCand], acc: [Pending]) : [Pending] = match cs {
  []                                     -> list_reverse(acc)
  [ICand(UImp(w, _, _, _), ns), ...rest] -> iu_cand_pending(rest, [Pend(w, [w, ...ns]), ...acc])
}

fn iu_unused(cs: [ImportCand], left: [Pending], acc: [UnusedImport]) : [UnusedImport] = match cs {
  [] -> list_reverse(acc)
  [ICand(UImp(w, o, l, c), _), ...rest] ->
    if iu_pending_has(left, w) { iu_unused(rest, left, [UImp(w, o, l, c), ...acc]) }
    else { iu_unused(rest, left, acc) }
}

fn iu_edges(bindings: [ModuleEntry], unused: [UnusedImport], acc: [String]) : [String] = match bindings {
  [] -> list_reverse(acc)
  [ME(w, _, origin, _), ...rest] ->
    if iu_unused_has(unused, w) { iu_edges(rest, unused, acc) } else { iu_edges(rest, unused, [origin, ...acc]) }
}

fn iu_unused_has(us: [UnusedImport], w: String) : Bool = match us {
  []                          -> false
  [UImp(u, _, _, _), ...rest] -> u == w or iu_unused_has(rest, w)
}

fn iu_mod_pending(ms: [ModNames], acc: [Pending]) : [Pending] = match ms {
  []                           -> acc
  [MNames(o, ns, _), ...rest]  -> iu_mod_pending(rest, [Pend(o, ns), ...acc])
}

fn iu_mentioned(all: [Pending], left: [Pending], acc: [String]) : [String] = match all {
  [] -> acc
  [Pend(k, _), ...rest] ->
    if iu_pending_has(left, k) { iu_mentioned(rest, left, acc) } else { iu_mentioned(rest, left, [k, ...acc]) }
}

fn iu_pending_has(ps: [Pending], k: String) : Bool = match ps {
  []                    -> false
  [Pend(p, _), ...rest] -> p == k or iu_pending_has(rest, k)
}

# Walk the tokens until every pending entry has been mentioned. `st`
# tracks a qualifier in progress: 1 after a module name, 2 after its dot,
# so the identifier that follows is that module's and counts for no other.
# Every comparison reads `cx.src` in place by offsets — materialising a
# slice per candidate word would pin each one in the runtime's intern
# table, a linear retention over the scan.
fn iu_scan(cx: IuCx, toks: [Token], st: Int, pending: [Pending]) : [Pending] =
  match pending {
    [] -> []
    _  -> match toks {
      [] -> pending
      [t, ...rest] ->
        iu_scan(cx, rest, iu_next_st(cx, t, st), iu_next_pending(cx, t, st, pending))
    }
  }

# The qualifier state after `t`: 1 on a module name, 2 on its dot, else 0.
fn iu_next_st(cx: IuCx, t: Token, st: Int) : Int =
  if iu_on_line(cx, t.line) { 0 }
  else { match t.kind {
    TkIdent -> if span_names_has(cx.mods_ix, cx.src, t.start, t.length) { 1 } else { 0 }
    TkDot   -> if st == 1 { 2 } else { 0 }
    _       -> 0
  } }

fn iu_next_pending(cx: IuCx, t: Token, st: Int, pending: [Pending]) : [Pending] =
  if iu_on_line(cx, t.line) { pending }
  else { match t.kind {
    TkIdent  -> if st == 2 { pending } else { iu_mention(cx, t.start, t.length, pending) }
    TkString -> iu_words(cx, t.start, t.start + t.length, pending)
    # `lazy [...]` writes a `Seq` without spelling it.
    TkLazy   -> iu_mention_named(core_decl_ty_name(CdSeq), pending)
    _        -> pending
  } }

fn iu_on_import_line(ls: [Int], line: Int) : Bool = match ls {
  []           -> false
  [h, ...rest] -> h == line or iu_on_import_line(rest, line)
}

fn iu_mention_named(name: String, pending: [Pending]) : [Pending] =
  if any(pending, (p) => iu_names(p, name)) { filter(pending, (p) => not iu_names(p, name)) } else { pending }

fn iu_names(p: Pending, name: String) : Bool = match p {
  Pend(_, names) -> list_has(names, name)
}

# Drop from `pending` every entry the word at src[ws, ws+wl) mentions.
# The no-hit case returns `pending` untouched: rebuilding the list per
# word retains an allocation per token scanned, linear over the file.
fn iu_mention(cx: IuCx, ws: Int, wl: Int, pending: [Pending]) : [Pending] =
  if span_names_has(cx.names_ix, cx.src, ws, wl) and iu_any_hit(cx.src, ws, wl, pending) { iu_drop_hits(cx.src, ws, wl, pending) }
  else { pending }

fn iu_any_hit(src: String, ws: Int, wl: Int, pending: [Pending]) : Bool = match pending {
  []                        -> false
  [Pend(_, names), ...rest] -> span_in(src, ws, wl, names) or iu_any_hit(src, ws, wl, rest)
}

fn iu_drop_hits(src: String, ws: Int, wl: Int, pending: [Pending]) : [Pending] = match pending {
  [] -> []
  [Pend(k, names), ...rest] ->
    if span_in(src, ws, wl, names) { iu_drop_hits(src, ws, wl, rest) }
    else { [Pend(k, names), ...iu_drop_hits(src, ws, wl, rest)] }
}

# Every identifier-shaped run inside a string literal is a mention, with
# the same qualifier rule: the word right after `m.` is `m`'s alone.
fn iu_words(cx: IuCx, i: Int, n: Int, pending: [Pending]) : [Pending] =
  iu_words_loop(cx, i, n, false, pending)

fn iu_words_loop(cx: IuCx, i: Int, n: Int, qualified: Bool, pending: [Pending]) : [Pending] =
  if i >= n { pending }
  else { match pending {
    [] -> []
    _  -> match char_at(cx.src, i) {
      None    -> pending
      Some(c) ->
        if ch_is_alpha(c) { iu_word(cx, i, iu_word_end(cx.src, i + 1, n), n, qualified, pending) }
        else { iu_words_loop(cx, i + 1, n, qualified and c == '.', pending) }
    }
  } }

fn iu_word(cx: IuCx, ws: Int, end: Int, n: Int, qualified: Bool, pending: [Pending]) : [Pending] = {
  let next_qual = span_names_has(cx.mods_ix, cx.src, ws, end - ws) and char_at(cx.src, end) == Some('.')
  let p2 = if qualified { pending } else { iu_mention(cx, ws, end - ws, pending) }
  iu_words_loop(cx, end, n, next_qual, p2)
}

fn iu_word_end(s: String, i: Int, n: Int) : Int =
  if i >= n { n }
  else { match char_at(s, i) {
    Some(c) -> if ch_is_alnum(c) { iu_word_end(s, i + 1, n) } else { i }
    None    -> i
  } }

#[doc("True when `decls` declares an impl at top level, through any wrapper.")]
pub fn decls_declare_impls(ds: [Decl]) : Bool = match ds {
  []           -> false
  [d, ...rest] -> decl_declares_impl(d) or decls_declare_impls(rest)
}

fn decl_declares_impl(d: Decl) : Bool = match d {
  DImpl(_, _, _, _, _, _, _, _)    -> true
  DImplAxiom(_, _, _, _, _)     -> true
  DDerive(_, _, _, _)           -> true
  DDoc(_, _, inner, _, _)       -> decl_declares_impl(inner)
  DAttr(_, inner, _, _)         -> decl_declares_impl(inner)
  DUnstable(inner, _, _)        -> decl_declares_impl(inner)
  DProtoLaws(_, inner, _, _, _) -> decl_declares_impl(inner)
  _                             -> false
}
