#[doc("KIR lowering of data-structure and loop forms: vectors, lists, records, ranges, cells and loops. Mutually recursive with kir_lower_walk.")]

import compiler.ast
import compiler.ast_ids
import compiler.ast_ids
import compiler.real_lit
import compiler.written
import compiler.symtab
import compiler.kinds
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.kir
import compiler.kir_lower
import compiler.core_builtins
import compiler.kir_lower_reuse
import compiler.kir_lower_scalar
import compiler.kir_syms
import compiler.loop_lower
import compiler.vec_raw
import compiler.kir_lower_walk
import compiler.kir_lower_sig

# Lower a fixed-width vec intrinsic to its inline KIR form: a header-less
# `[n x elem]` aggregate on the native side (no dynamic `Vec`). Returns
# `None` for any other call. The element scalar rides the prim (the
# emitter picks the scalar LLVM type + box constructor from it, mirroring
# the C `KaiFixedVec_<elem>_<n>` typedef), so the aggregate op carries its
# full type without a KOp variant. `__fixed_vec_lit(e0..en)` binds the flat
# aggregate at a `SBoxed` handle slot (the alloca pointer, no RC); a static
# `__fixed_vec_get(v, i)` is a GEP+load re-box.
pub(pkg) fn lower_fixed_vec_call(x: Expr, f: Expr, cargs: [Expr], st: LowerSt) : Option[LRes] / Console =
  match f.kind {
    EMark(MkFixedVecLit)    -> Some(lower_fixed_vec_lit(x, cargs, st))
    EMark(MkFixedVecGet)    -> lower_fixed_vec_get(x, cargs, st)
    EMark(MkFixedVecGetDyn) -> lower_fixed_vec_get_dyn(x, cargs, st)
    _                       -> None
  }

# `[e0, ..., en]` typed `Vec[elem]<n>` → each element lowered raw at the
# element scalar slot, then a `KpFixedVecLit(elem, n)` prim binding the
# flat aggregate at a handle slot. `(elem, n)` is the aggregate shape the
# emitter rebuilds the `[n x elem]` LLVM type from (LLVM dedups it with the
# read side's).
fn lower_fixed_vec_lit(x: Expr, cargs: [Expr], st: LowerSt) : LRes / Console = {
  let vty = match x.ty { Some(t) -> t  None -> TyReal }
  let elem = if ty_is_fixed_vec(vty) { fixed_vec_elem(vty) } else { TyReal }
  let eslot = kslot_of_raw_ty(elem)
  let re = lower_fixed_vec_elems(cargs, eslot, st, [])
  match re { LRes2(raws, st1) ->
    bind_op_slot(st1, KPrim(KpFixedVecLit(fixed_vec_elem_scalar(elem), list_length(cargs)), raws), SBoxed, kpos_of(x)) }
}

# `__fixed_vec_get(v, i)` → the base handle atom + a static-index prim,
# re-boxed at the element's box constructor. `i` is a compile-time literal
# (the typer proved it in range and elided the bounds check). The prim's
# length comes from the base's fixed-vec type so the emitter rebuilds the
# same `[n x elem]` type the write side alloca'd.
#
# The inline `[n x elem]` aggregate is the representation of a binder the
# unbox pass marked `MUnboxed`. A fixed-vec-TYPED base that is boxed (a
# parameter, a call result) already crossed the border and is a dynamic
# heap vec: GEPing into it would read through the `KaiValue *` header and
# return garbage, so it takes the `heap` read, which reaches the slot
# through the runtime. Neither form touches RC — what Perceus assumes for
# this read.
fn lower_fixed_vec_get(x: Expr, cargs: [Expr], st: LowerSt) : Option[LRes] / Console =
  match cargs {
    [v, i] -> {
      let elem = match x.ty { Some(t) -> t  None -> TyReal }
      let n = match v.ty { Some(t) -> if ty_is_fixed_vec(t) { fixed_vec_n(t) } else { 0 }  None -> 0 }
      let rv = lower_expr_boxed(v, st)
      match rv { LRes(vv, st1) ->
        Some(bind_op_slot(st1, KPrim(fixed_vec_get_prim(v.mode, false, false, elem, n), [vv, fixed_vec_idx_atom(i)]), SBoxed, kpos_of(x))) }
    }
    _ -> None
  }

# `__fixed_vec_get_dyn(v, i)` → the base handle atom plus the index lowered
# RAW at `SInt64`: the emitter gates it against the static length before the
# GEP, so the index must reach it as a machine word, not a boxed value.
fn lower_fixed_vec_get_dyn(x: Expr, cargs: [Expr], st: LowerSt) : Option[LRes] / Console =
  match cargs {
    [v, i] -> {
      let elem = match x.ty { Some(t) -> t  None -> TyReal }
      let n = match v.ty { Some(t) -> if ty_is_fixed_vec(t) { fixed_vec_n(t) } else { 0 }  None -> 0 }
      match lower_expr_boxed(v, st) { LRes(vv, st1) ->
        match lower_expr_raw_at(i, SInt64, st1) { LRes(iv, st2) ->
          Some(bind_op_slot(st2, KPrim(fixed_vec_get_prim(v.mode, false, true, elem, n), [vv, iv]), SBoxed, kpos_of(x))) } }
    }
    _ -> None
  }

# A fixed-vec element read in RAW position: the same GEP+load, bound at the
# element's scalar slot with no re-box. The read's `raw` tells the emitter to
# stop at the loaded word. Only the reads qualify — a fixed-vec LITERAL is an
# aggregate pointer, never a raw scalar.
#
# The base's mode picks the read exactly as on the boxed path: raw position
# changes what the loaded word becomes, never where it lives.
pub(pkg) fn lower_fixed_vec_read_raw(x: Expr, f: Expr, cargs: [Expr], st: LowerSt) : Option[LRes] / Console =
  match f.kind {
    EMark(MkFixedVecGet)    -> lower_fixed_vec_get_at(x, cargs, false, st)
    EMark(MkFixedVecGetDyn) -> lower_fixed_vec_get_at(x, cargs, true, st)
    _                       -> None
  }

fn lower_fixed_vec_get_at(x: Expr, cargs: [Expr], dyn: Bool, st: LowerSt) : Option[LRes] / Console =
  match cargs {
    [v, i] -> {
      let elem = match x.ty { Some(t) -> t  None -> TyReal }
      let n = match v.ty { Some(t) -> if ty_is_fixed_vec(t) { fixed_vec_n(t) } else { 0 }  None -> 0 }
      match lower_expr_boxed(v, st) { LRes(vv, st1) -> {
        let ri = if dyn { lower_expr_raw_at(i, SInt64, st1) } else { LRes(fixed_vec_idx_atom(i), st1) }
        match ri { LRes(iv, st2) ->
          Some(bind_op_slot(st2, KPrim(fixed_vec_get_prim(v.mode, true, dyn, elem, n), [vv, iv]),
                            kslot_of_raw_ty(elem), kpos_of(x))) }
      } }
    }
    _ -> None
  }

fn lower_fixed_vec_elems(es: [Expr], eslot: KSlot, st: LowerSt, acc: [KVal]) : LRes2 / Console = match es {
  []           -> LRes2(acc, st)
  [e, ...rest] -> match lower_expr_raw_at(e, eslot, st) {
    LRes(ev, st1) -> lower_fixed_vec_elems(rest, eslot, st1, list_append(acc, [ev]))
  }
}

# The inline aggregate → a dynamic heap `Vec`, one copy at the border
# (`vec_reserve` + one `vec_push` per element). Mirrors the C backend's
# `materialize_fixed_vec` reached from `box_wrap`.
pub(pkg) fn lower_fixed_vec_materialize(x: Expr, st: LowerSt) : LRes / Console = {
  let vty = match x.ty { Some(t) -> t  None -> TyReal }
  let elem = fixed_vec_elem(vty)
  let n = fixed_vec_n(vty)
  match lower_expr_boxed(x, st) { LRes(vv, st1) ->
    bind_op_slot(st1, KPrim(KpFixedVecMaterialize(fixed_vec_elem_scalar(elem), n), [vv]), SBoxed, kpos_of(x)) }
}

# A promoted var cell's write: store the raw value into the cell's
# register (an alloca — the same mutation KStore performs for TCO loop
# assigns). A raw value stores directly; a boxed value crosses the
# border (borrowing unbox) and is then dropped — the store owns the
# scalar, and a raw register carries no RC to hand the box to.
pub(pkg) fn lower_cell_set(x: Expr, inm: Intrinsic, iargs: [Expr], st: LowerSt) : LRes / Console = match iargs {
  [_, v] -> {
    let reg = lower_cell_reg(iargs, st)
    match v.mode {
      MUnboxed -> match lower_expr_raw(v, st) {
        LRes(rv, st1) -> LRes(KUnitV, ls_emit(st1, KStore(reg, rv, kpos_of(x))))
      }
      _ -> {
        let slot = cell_slot_of_ty(v.ty)
        match lower_expr_boxed(v, st) {
          LRes(bv, st1) -> match bind_op_slot(st1, KPrim(cell_unbox_prim(slot), [bv]), slot, kpos_of(x)) {
            LRes(rv, st2) ->
              LRes(KUnitV, ls_emit(ls_emit(st2, KStore(reg, rv, kpos_of(x))),
                                   KRC(KDrop(bv), kpos_of(x))))
          }
        }
      }
    }
  }
  _ -> lower_unhandled(x, st)
}

# --- loop intrinsics (inline block loops) -------------------------------
#
# The loop combinator's pred/body arrive as literal nullary lambdas the
# collector never lifted (they are not closures); their bodies lower
# INLINE into cond/body blocks with a backedge, in the enclosing fn's
# frame — so a promoted var cell mutated by the loop is a plain alloca
# the backedge re-reads. RC inside the pasted bodies was computed under
# the closure discipline (per-iteration balance), same as the C paste.

pub(pkg) fn lower_loop_intrinsic(x: Expr, inm: Intrinsic, iargs: [Expr], st: LowerSt) : LRes / Console = match iargs {
  [_, a, b] -> match inm {
    InLoopWhile  -> lower_loop_while(x, loop_arg_body(a), loop_arg_body(b), st)
    InLoopUntil  -> lower_loop_until(x, loop_arg_body(a), loop_arg_body(b), st)
    InLoopRepeat -> lower_loop_repeat(x, a, loop_arg_body(b), st)
    _            -> lower_unhandled(x, st)
  }
  _ -> lower_unhandled(x, st)
}

# `while { pred } { body }`: cond block (backedge target) evaluates the
# pred and forks to body/exit; the body block re-enters the cond.
fn lower_loop_while(x: Expr, pred: Expr, body: Expr, st: LowerSt) : LRes / Console =
  match three_labels(st) { LSL3(lcond, lbody, lcont, st1) -> {
    let st2 = ls_seal(st1, KBr(lcond, kpos_of(x)), lcond)
    match lower_loop_cond(pred, st2) { LRes(cv, st3) -> {
      let st4 = ls_seal(st3, KCondBr(cv, lbody, lcont, kpos_of(x)), lbody)
      let st5 = lower_loop_body(body, st4)
      LRes(KUnitV, ls_seal(st5, KBr(lcond, kpos_of(x)), lcont))
    } }
  } }

# `until { pred } { body }`: body runs first, then the pred in the same
# block; exit when it holds.
fn lower_loop_until(x: Expr, pred: Expr, body: Expr, st: LowerSt) : LRes / Console =
  match three_labels(st) { LSL3(lbody, _, lcont, st1) -> {
    let st2 = ls_seal(st1, KBr(lbody, kpos_of(x)), lbody)
    let st3 = lower_loop_body(body, st2)
    match lower_loop_cond(pred, st3) { LRes(cv, st4) ->
      LRes(KUnitV, ls_seal(st4, KCondBr(cv, lcont, lbody, kpos_of(x)), lcont))
    }
  } }

# `repeat(n) { body }`: a raw i64 count-down register.
fn lower_loop_repeat(x: Expr, n: Expr, body: Expr, st: LowerSt) : LRes / Console =
  match lower_loop_count(n, st) { LRes(nv, st1) ->
    match ls_fresh_reg(st1) { LSReg(reg, st2) -> {
      let st3 = ls_emit(st2, KLet(reg, SInt64, KLitOp(nv), kpos_of(x)))
      match three_labels(st3) { LSL3(lcond, lbody, lcont, st4) -> {
        let st5 = ls_seal(st4, KBr(lcond, kpos_of(x)), lcond)
        match bind_op_slot(st5, KPrim(KpRawBin(RwInt, BoGt), [KVar(reg), KIntV(0)]), SBool, kpos_of(x)) { LRes(cv, st6) -> {
          let st7 = ls_seal(st6, KCondBr(cv, lbody, lcont, kpos_of(x)), lbody)
          let st8 = lower_loop_body(body, st7)
          match bind_op_slot(st8, KPrim(KpRawBin(RwInt, BoSub), [KVar(reg), KIntV(1)]), SInt64, kpos_of(x)) { LRes(dv, st9) -> {
            let st10 = ls_emit(st9, KStore(reg, dv, kpos_of(x)))
            LRes(KUnitV, ls_seal(st10, KBr(lcond, kpos_of(x)), lcont))
          } }
        } }
      } }
    } }
  }

# The loop condition: raw when its tail is a raw-marked node (an i1 the
# condbr reads directly), else boxed (the condbr truthy path) — the same
# split `lower_if` applies. The pred arrives as the literal lambda's body,
# usually a single-tail block wrapping the comparison; the block itself is
# not a raw FORM, so peel transparent wrappers before consulting the mark
# (`lower_expr_raw`'s block arm recurses to the same tail).
fn lower_loop_cond(pred: Expr, st: LowerSt) : LRes / Console =
  if loop_cond_is_raw(pred) { lower_expr_raw(pred, st) }
  else { lower_expr(pred, st) }

# The loop body in statement position: its per-iteration value is
# discarded (the SExprStmt shape). A `()` value owns nothing and needs no
# `KDo` — eliding it keeps loop bodies free of dead unit ops; any other
# atom keeps the `KDo`, whose emitter drops an owned boxed discard. The
# unit test happens HERE, at the `LRes` destructure: an atom passed on to
# a helper that matches it hits the stage1 variant-read miscompile.
fn lower_loop_body(body: Expr, st: LowerSt) : LowerSt / Console =
  match lower_expr(body, st) { LRes(v, st1) -> match v {
    KUnitV -> st1
    _      -> ls_emit(st1, KDo(KLitOp(v), kpos_of(body)))
  } }

# The repeat count: raw when marked, else a boxed Int crossed at the
# border (borrowing unbox) and dropped — the count is consumed here.
fn lower_loop_count(n: Expr, st: LowerSt) : LRes / Console = match n.mode {
  MUnboxed -> lower_expr_raw(n, st)
  _ -> match lower_expr_boxed(n, st) {
    LRes(bv, st1) -> match bind_op_slot(st1, KPrim(KpUnbox(RwInt), [bv]), SInt64, kpos_of(n)) {
      LRes(rv, st2) -> LRes(rv, ls_emit(st2, KRC(KDrop(bv), kpos_of(n))))
    }
  }
}

# `[e0, ..., ...spread]` → a cons/nil/append spine, mirroring the C
# emitter's `emit_list_tail`: nil for the empty tail, `kai_cons(h, t)` for a
# plain head, `kai_core_list_append(h, t)` for a mid-list spread, and the
# operand itself for a trailing spread (it consumes like a ctor slot). Head
# is lowered before the tail to keep left-to-right evaluation order. Inside
# a region the cons cells bump-allocate: `kai_cons` becomes `kai_arena_cons`.
pub(pkg) fn lower_list(elems: [ListElem], pos: KPos, st: LowerSt) : LRes / Console = match elems {
  [] -> bind_op(st, KPrim(KpNil, []), pos)
  [el] -> lower_list_last(el, pos, st)
  [el, ...rest] -> match el {
    ElPlain(x)  -> lower_list_cons(x, rest, region_cons_prim(st), pos, st)
    ElSpread(x) -> lower_list_cons(x, rest, KpListAppend, pos, st)
  }
}

fn lower_list_last(el: ListElem, pos: KPos, st: LowerSt) : LRes / Console = match el {
  ElPlain(x) -> match lower_expr(x, st) { LRes(hdv, st1) ->
    match bind_op(st1, KPrim(KpNil, []), pos) { LRes(nilv, st2) ->
      bind_op(st2, KPrim(region_cons_prim(st2), [hdv, nilv]), pos) } }
  ElSpread(x) -> lower_expr(x, st)
}

# A head (plain or spread) joined to the lowered rest by `prim`
# (`kai_cons` for a plain head, `kai_core_list_append` for a spread).
fn lower_list_cons(x: Expr, rest: [ListElem], prim: PrimOp, pos: KPos, st: LowerSt) : LRes / Console =
  match lower_expr(x, st) { LRes(hdv, st1) ->
    match lower_list(rest, pos, lower_flight_add(x, hdv, st1)) { LRes(tlv, st2) ->
      bind_op(lower_flight_end(st, st2), KPrim(prim, [hdv, tlv]), pos) } }

# --- Holes / todo! → panic stub -----------------------------------------

# `T { f0: v0, ... }` → a `KRecord` op carrying each (name, value-atom).
# Field values lower left-to-right; the translator emits the parallel
# value/name buffers `kai_record` takes. The desugar already normalised the
# field order to DECLARATION order (eval still in source order via its
# let-bind), so the layout reaching here is canonical — KIR does not reorder.
pub(pkg) fn lower_record_lit(fis: [FieldInit], tag: Int, pos: KPos, st: LowerSt) : LRes / Console =
  match lower_field_inits(fis, st, []) { RecPlan(pairs, st1) ->
    bind_op(st1, KRecord(pairs, st1.in_region, tag), pos) }

pub(pkg) fn lower_field_inits(fis: [FieldInit], st: LowerSt, acc: [KFieldInit]) : RecPlan / Console = match lower_field_inits_flying(fis, st, acc) {
  RecPlan(pairs, st1) -> RecPlan(pairs, lower_flight_end(st, st1))
}

fn lower_field_inits_flying(fis: [FieldInit], st: LowerSt, acc: [KFieldInit]) : RecPlan / Console = match fis {
  [] -> RecPlan(acc, st)
  [FI(fname, fe), ...rest] -> match lower_expr(fe, st) { LRes(v, st1) ->
    lower_field_inits_flying(rest, lower_flight_next(fe, v, rest == [], st1), list_append(acc, [KFI(fname, v)])) }
}

# `lo..hi` / `lo..hi:step` → the runtime range builder prim.
pub(pkg) fn lower_range(lo: Expr, hi: Expr, stp: Option[Expr], pos: KPos, st: LowerSt) : LRes / Console =
  match lower_expr(lo, st) { LRes(lov, st1) -> match lower_expr(hi, st1) { LRes(hiv, st2) ->
    match stp {
      None -> bind_op(st2, KPrim(KpRange, [lov, hiv]), pos)
      Some(se) -> match lower_expr(se, st2) { LRes(sv, st3) ->
        bind_op(st3, KPrim(KpRangeStep, [lov, hiv, sv]), pos) }
    } } }

# `vec_get(v, i).f` / `vec_get_borrow(v, i).f` on a REC carrier, for a
# field the bare-word paths do not carry: the column is read as its box and
# no record is built.
pub(pkg) fn lower_vec_get_field_fused(x: Expr, base: Expr, fname: String, st: LowerSt) : Option[LRes] / Console = match vec_field_read(st.recs, base, fname) {
  None     -> None
  Some(fr) -> {
    let a = lower_vec_read_args(fr.get, st)
    Some(lower_vec_read_bind(x, a, vec_boxed_field_op(fr.col, a.vv, a.iv, a.owned), SBoxed))
  }
}

# A bare-word Vec read (verdict in vec_raw.kai).
pub(pkg) fn lower_vec_raw_read(x: Expr, rd: VecRawRead, st: LowerSt) : LRes / Console = {
  let a = lower_vec_read_args(rd.get, st)
  lower_vec_read_bind(x, a, vec_raw_read_op(rd, a.vv, a.iv, a.owned), vec_bits_slot(rd.bits))
}

fn lower_vec_read_args(g: VecGet, st: LowerSt) : VecReadArgs / Console =
  match lower_expr(g.v, st) { LRes(vv, st1) ->
    match lower_expr_raw_at(g.i, SInt64, lower_flight_add(g.v, vv, st1)) { LRes(iv, st2) ->
      VecReadArgs { vv: vv, iv: iv, owned: not g.borrows or ob_is_marked(g.v), st: lower_flight_end(st1, st2) } } }

# `vec_push(v, Rec{..})` / `vec_set(v, i, Rec{..})` on a REC carrier →
# `kai_vec_push_rec_raw` / `kai_vec_set_rec_raw` over the unpacked
# field values; the record is never allocated and the uniqueness
# decision stays inside the runtime helper. Push carries (value, name)
# pairs after the arity (the PENDING classify needs the names); set
# writes an already-classified slot and carries values only.
pub(pkg) fn lower_vec_write_rec_fused(x: Expr, f: Expr, cargs: [Expr], st: LowerSt) : Option[LRes] / Console = match f.kind {
  ESym(_, _) ->
    if is_builtin_ref(f, CbVecPush) {
      match cargs {
        [v, lit] -> lower_vec_push_fused(x, v, lit, st)
        _ -> None
      }
    } else if is_builtin_ref(f, CbVecSet) {
      match cargs {
        [v, i, lit] -> lower_vec_set_fused(x, v, i, lit, st)
        _ -> None
      }
    } else { None }
  _ -> None
}

fn lower_vec_push_fused(x: Expr, v: Expr, lit: Expr, st: LowerSt) : Option[LRes] / Console = match lit.kind {
  ERecordLit(_, fis) -> match vec_rec_lit_bits(st.recs, lit.ty, fis) {
    Some(bs) -> Some(lower_vec_push_rec_bits(x, v, fis, bs, st))
    None     -> lower_vec_push_rec_pairs(x, v, lit, fis, st)
  }
  _ -> lower_vec_push_scalar(x, v, lit, st)
}

fn lower_vec_push_rec_pairs(x: Expr, v: Expr, lit: Expr, fis: [FieldInit], st: LowerSt) : Option[LRes] / Console =
  if vec_elem_is_rec_carrier(st.recs, lit.ty) {
    match lower_vec_write_target(v, st) { LRes(vv, st1) ->
      match lower_vec_rec_pairs(fis, st1, []) {
        LResMany(pvs, st2) ->
          Some(bind_op(lower_flight_end(st, st2),
            KPrim(KpVecPushRecRaw, [vv, KIntV(list_length(fis)), ...pvs]),
            kpos_of(x)))
      } }
  } else { None }

fn lower_vec_set_fused(x: Expr, v: Expr, i: Expr, lit: Expr, st: LowerSt) : Option[LRes] / Console = match lit.kind {
  ERecordLit(_, fis) -> match vec_rec_lit_bits(st.recs, lit.ty, fis) {
    Some(bs) -> Some(lower_vec_set_rec_bits(x, v, i, fis, bs, st))
    None     -> lower_vec_set_rec_vals(x, v, i, lit, fis, st)
  }
  _ -> lower_vec_set_scalar(x, v, i, lit, st)
}

fn lower_vec_set_rec_vals(x: Expr, v: Expr, i: Expr, lit: Expr, fis: [FieldInit], st: LowerSt) : Option[LRes] / Console =
  if vec_elem_is_rec_carrier(st.recs, lit.ty) {
    match lower_vec_write_target(v, st) { LRes(vv, st1) ->
      match lower_expr(i, st1) { LRes(iv, st2) ->
        match lower_vec_rec_vals(fis, st2, []) {
          LResMany(fvs, st3) ->
            Some(bind_op(lower_flight_end(st, st3),
              KPrim(KpVecSetRecRaw, [vv, iv, KIntV(list_length(fis)), ...fvs]),
              kpos_of(x)))
        } } }
  } else { None }

# The vec a fused write consumes stays in flight while its other operands
# run; the write's own op lands it.
fn lower_vec_write_target(v: Expr, st: LowerSt) : LRes / Console =
  match lower_expr(v, st) { LRes(vv, st1) -> LRes(vv, lower_flight_add(v, vv, st1)) }

fn lower_vec_fields_raw(fis: [FieldInit], bs: [VecBits], st: LowerSt, acc: [VecField]) : LVecFields / Console = match fis {
  []            -> LVecFields(list_reverse(acc), st)
  [fi, ...rest] -> match fi {
    FI(nm, e) -> match bs {
      []            -> LVecFields(list_reverse(acc), st)
      [b, ...brest] -> match lower_expr_raw_at(e, vec_bits_slot(b), st) {
        LRes(ev, st1) -> lower_vec_fields_raw(rest, brest, st1, [VecField(nm, b, ev), ...acc])
      }
    }
  }
}

fn lower_vec_push_rec_bits(x: Expr, v: Expr, fis: [FieldInit], bs: [VecBits], st: LowerSt) : LRes / Console =
  match lower_vec_write_target(v, st) { LRes(vv, st1) ->
    match lower_vec_fields_raw(fis, bs, st1, []) { LVecFields(fs, st2) ->
      bind_op(lower_flight_end(st, st2), vec_push_rec_op(vv, fs), kpos_of(x)) } }

fn lower_vec_set_rec_bits(x: Expr, v: Expr, i: Expr, fis: [FieldInit], bs: [VecBits], st: LowerSt) : LRes / Console =
  match lower_vec_write_target(v, st) { LRes(vv, st1) ->
    match lower_expr_raw_at(i, SInt64, st1) { LRes(iv, st2) ->
      match lower_vec_fields_raw(fis, bs, st2, []) { LVecFields(fs, st3) ->
        bind_op(lower_flight_end(st, st3), vec_set_rec_op(vv, iv, fs), kpos_of(x)) } } }

fn lower_vec_push_scalar(x: Expr, v: Expr, e: Expr, st: LowerSt) : Option[LRes] / Console = match vec_bits_of(e.ty) {
  None    -> None
  Some(b) -> match lower_vec_write_target(v, st) { LRes(vv, st1) ->
    match lower_expr_raw_at(e, vec_bits_slot(b), st1) { LRes(xv, st2) ->
      Some(bind_op(lower_flight_end(st, st2), vec_push_scalar_op(b, vv, xv), kpos_of(x))) } }
}

fn lower_vec_set_scalar(x: Expr, v: Expr, i: Expr, e: Expr, st: LowerSt) : Option[LRes] / Console = match vec_bits_of(e.ty) {
  None    -> None
  Some(b) -> match lower_vec_write_target(v, st) { LRes(vv, st1) ->
    match lower_expr_raw_at(i, SInt64, st1) { LRes(iv, st2) ->
      match lower_expr_raw_at(e, vec_bits_slot(b), st2) { LRes(xv, st3) ->
        Some(bind_op(lower_flight_end(st, st3), vec_set_scalar_op(b, vv, iv, xv), kpos_of(x))) } } }
}

fn lower_vec_rec_pairs(fis: [FieldInit], st: LowerSt, acc: [KVal]) : LResMany / Console = match fis {
  []           -> LResMany(list_reverse(acc), st)
  [fi, ...rest] -> match fi {
    FI(nm, e) -> {
      let re = lower_expr(e, st)
      match re { LRes(ev, st1) -> lower_vec_rec_pairs(rest, st1, [KStrV(nm), ev, ...acc]) }
    }
  }
}

fn lower_vec_rec_vals(fis: [FieldInit], st: LowerSt, acc: [KVal]) : LResMany / Console = match fis {
  []           -> LResMany(list_reverse(acc), st)
  [fi, ...rest] -> match fi {
    FI(_, e) -> {
      let re = lower_expr(e, st)
      match re { LRes(ev, st1) -> lower_vec_rec_vals(rest, st1, [ev, ...acc]) }
    }
  }
}
