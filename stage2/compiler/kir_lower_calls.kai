#[doc("KIR lowering of calls, constructor application, constructor reuse, resumption and tail calls. Mutually recursive with kir_lower_walk and kir_lower_stmts.")]

import compiler.ast
import compiler.ast_ids
import compiler.ast_ids
import compiler.core_builtins
import compiler.effect_instance
import compiler.emit_shared_syms
import compiler.emit_tcrec_live
import compiler.fn_index
import compiler.fnreg
import compiler.infer_env
import compiler.infer_glue
import compiler.infer_state
import compiler.kir
import compiler.kir_lower
import compiler.kir_lower_arms
import compiler.kir_lower_ctors
import compiler.kir_lower_exits
import compiler.kir_lower_raw
import compiler.kir_lower_reuse
import compiler.kir_lower_scalar
import compiler.kir_lower_walk
