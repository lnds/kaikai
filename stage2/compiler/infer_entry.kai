#[doc("""The typer's entry for a report mode.

A report mode types the resolved program as it is, without the build's
head-owner cache or typed-cut cache.
""")]

import compiler.ast
import compiler.symtab
import compiler.scope_file
import compiler.diag_file
import compiler.entry
import compiler.modules
import compiler.proto_ids
import compiler.kind_theory
import compiler.infer

#[doc("Type a resolved program for a report mode. `views` holds each file's imports, which a bare name the typer settles is read through; `protos` picks among homonymous protocol operations by receiver.")]
pub fn infer_report(file: String, decls: [Decl], tab: SymTab, views: FileViews, protos: ProtoView,
                    verbose: Bool) : TypedProgram / Console + File + Mutable =
  infer_program_with_protos_cached(file, diag_files_flat(file), decls, verbose, protos,
                                   head_owner_seed(), atomic_kind_theories(decls), tab, views,
                                   roots_of(module_name_of_path(file), []))
