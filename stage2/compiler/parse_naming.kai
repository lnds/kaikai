#[doc("The naming conventions: one table from each kind of name to the case it must be written in.")]


#[doc("Every kind of name the conventions constrain; a new kind of binder adds a row to `name_rule`.")]
pub(pkg) type NameKind =
  | NkFn
  | NkParam
  | NkVar
  | NkPatBinder
  | NkCapBinder
  | NkField
  | NkConst
  | NkTypeParam
  | NkVariant
  | NkType
  | NkProtocol
  | NkEffect
  | NkEffectOp
  | NkTheory
  | NkKind
  | NkUseEffect

#[doc("The spelling a kind of name takes: a lowercase start, an uppercase start, or UPPER_SNAKE.")]
pub(pkg) type NameCase = CaseLower | CaseUpper | CaseUpperSnake

type NameRule = { spelling: NameCase, msg: String, migratable: Bool }

fn rule(spelling: NameCase, msg: String) : NameRule = NameRule { spelling: spelling, msg: msg, migratable: false }

fn migratable_rule(spelling: NameCase, msg: String) : NameRule = NameRule { spelling: spelling, msg: msg, migratable: true }

fn name_rule(k: NameKind) : NameRule = match k {
  NkFn         -> rule(CaseLower, "function names must start with a lowercase letter")
  NkParam      -> rule(CaseLower, "parameter names must start with a lowercase letter")
  NkVar        -> rule(CaseLower, "variable names must start with a lowercase letter")
  NkPatBinder  -> rule(CaseLower, "pattern binders must start with a lowercase letter")
  NkCapBinder  -> rule(CaseLower, "capability binders must start with a lowercase letter")
  NkField      -> rule(CaseLower, "record field names must start with a lowercase letter")
  NkConst      -> migratable_rule(CaseUpperSnake, "const names must be UPPER_SNAKE_CASE")
  NkTypeParam  -> migratable_rule(CaseLower, "type parameters must start with a lowercase letter")
  NkVariant    -> rule(CaseUpper, "variant names must start with an uppercase letter")
  NkType       -> rule(CaseUpper, "type names must start with an uppercase letter")
  NkProtocol   -> rule(CaseUpper, "protocol names must start with an uppercase letter")
  NkEffect     -> rule(CaseUpper, "effect names must start with an uppercase letter")
  NkEffectOp   -> rule(CaseLower, "effect operation names must start with a lowercase letter")
  NkTheory     -> rule(CaseUpper, "theory name must start with an uppercase letter")
  NkKind       -> rule(CaseUpper, "kind name must start with an uppercase letter")
  NkUseEffect  -> rule(CaseUpper, "effect name in `use` must start with an uppercase letter")
}

#[doc("The diagnostic for a name of this kind spelled in the wrong case.")]
pub(pkg) fn name_msg(k: NameKind) : String = name_rule(k).msg

fn starts_upper(name: String) : Bool = match char_at(name, 0) {
  Some(c) -> c >= 'A' and c <= 'Z'
  None -> false
}

fn upper_snake_from(name: String, i: Int) : Bool = match char_at(name, i) {
  None -> true
  Some(c) -> ((c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_') and upper_snake_from(name, i + 1)
}

fn matches_case(c: NameCase, name: String) : Bool = match c {
  CaseLower      -> not starts_upper(name)
  CaseUpper      -> starts_upper(name)
  CaseUpperSnake -> starts_upper(name) and upper_snake_from(name, 0)
}

#[doc("Whether a name is spelled against the convention of its kind.")]
pub(pkg) fn name_bad(k: NameKind, name: String) : Bool = not matches_case(name_rule(k).spelling, name)

#[doc("Whether a kind of name may still be spelled against its convention while `kai migrate` reads a legacy source.")]
pub(pkg) fn name_migratable(k: NameKind) : Bool = name_rule(k).migratable

#[doc("The note appended to an unknown-variant error on a bare uppercase pattern, which reads as a binder as well as a constructor or constant.")]
pub(pkg) fn pattern_binder_note(name: String) : String =
  "; no constructor or constant named `#{name}` was found, and a pattern binder must be lowercase"
