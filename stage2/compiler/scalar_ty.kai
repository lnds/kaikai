#[doc("""
The scalar types and the names the source spells them with.

A scalar has no declaration, so its spelling is all a written type
carries. This module is the one place that reads it: every resolver
that turns a written type into a `Ty` asks here before it looks for a
declaration, and whatever writes a resolved scalar back as a name takes
the spelling from here.
""")]

import compiler.ast

#[doc("The scalar type spelled `name`, or `None` for any other name.")]
pub fn scalar_ty_named(name: String) : Option[Ty] = match name {
  "Int"    -> Some(TyInt)
  "Real"   -> Some(TyReal)
  "Bool"   -> Some(TyBool)
  "String" -> Some(TyString)
  "Char"   -> Some(TyChar)
  "Unit"   -> Some(TyUnit)
  "Byte"   -> Some(TyByte)
  "Int32"  -> Some(TyInt32)
  "UInt32" -> Some(TyUInt32)
  "UInt64" -> Some(TyUInt64)
  "Int128" -> Some(TyInt128)
  "Handle" -> Some(TyHandle)
  _        -> None
}

#[doc("The name the scalar type `t` is spelled with, or `None` for any other type.")]
pub fn scalar_ty_name(t: Ty) : Option[String] = match t {
  TyInt    -> Some("Int")
  TyReal   -> Some("Real")
  TyBool   -> Some("Bool")
  TyString -> Some("String")
  TyChar   -> Some("Char")
  TyUnit   -> Some("Unit")
  TyByte   -> Some("Byte")
  TyInt32  -> Some("Int32")
  TyUInt32 -> Some("UInt32")
  TyUInt64 -> Some("UInt64")
  TyInt128 -> Some("Int128")
  TyHandle -> Some("Handle")
  _        -> None
}

#[doc("True when `name` is a fixed-width integer type name (Int32/UInt32/UInt64/Int128).")]
pub fn is_fixed_width_name(name: String) : Bool =
  name == "Int32" or name == "UInt32" or name == "UInt64" or name == "Int128"

# A boundary annotation is a plain `Int` (`Real` for `F32`) on the kaikai
# side: the exact C width lives only at the boundary, where the extern
# classifier reads the written name.
fn ffi_fixed_ty_named(name: String) : Option[Ty] =
  if name == "F32" { Some(TyReal) }
  else if name == "U8" or name == "U16" or name == "U32" or name == "U64" or
          name == "I8" or name == "I16" or name == "I32" or name == "I64" { Some(TyInt) }
  else { None }

#[doc("Which undeclared names a resolver reads besides the scalars: `SnBoundary` keeps a fixed-width boundary annotation nominal, for a reader that must see its width; `SnValue` reads it as the `Int` or `Real` its values are.")]
pub type ScalarNames = SnBoundary | SnValue

# `Nothing` is the uninhabited type of an abort op. Nothing witnesses
# uninhabitedness, so it reads as `TyAny`: sound only because the handler
# aborts before any consumer of that value runs.
#[doc("What a written type name denotes without a declaration, or `None` when only a declaration can answer.")]
pub fn undeclared_ty_named(name: String, mode: ScalarNames) : Option[Ty] = match scalar_ty_named(name) {
  Some(t) -> Some(t)
  None    ->
    if name == "Nothing" { Some(TyAny) }
    else { match mode {
      SnValue    -> ffi_fixed_ty_named(name)
      SnBoundary -> None
    } }
}
