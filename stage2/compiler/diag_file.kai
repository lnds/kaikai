#[doc("""Per-decl diagnostic file attribution for the pre-typer passes.

`expand_imports` flattens every imported module into one decl stream, so a
pass that carries a single file path attributes an imported decl's diagnostic
to the root file while the decl's line/column still belong to its own module —
the caret then lands in the wrong file, often past its end.

The decls already know their home: `module_origin` is stamped at the import
boundary, and the driver knows each module's file. `DiagFiles` pairs the two so
a pass resolves the file of the decl it is walking.
""")]

import compiler.ast

#[doc("A module's name paired with the file that declares it.")]
pub type ModFile = MF(String, String)

# The root path is the fallback for decls whose home cannot be resolved:
# root-file decls carry no `module_origin`, and a synthesised decl inherits
# whatever its source decl carried.
#[doc("Module-to-file table plus the root path — the context that attributes a decl to the file declaring it.")]
pub type DiagFiles = DF([ModFile], String)

#[doc("Build the attribution context from the module-to-file pairs and the root file path.")]
pub fn diag_files(mfs: [ModFile], root: String) : DiagFiles = DF(mfs, root)

#[doc("A context that attributes everything to one file; for callers with no module table.")]
pub fn diag_files_flat(root: String) : DiagFiles = DF([], root)

#[doc("The root file path this context falls back to.")]
pub fn df_root(df: DiagFiles) : String = match df { DF(_, root) -> root }

#[doc("The (module, file) pairs this context resolves against; for callers that know the module already.")]
pub fn df_mods(df: DiagFiles) : [ModFile] = match df { DF(mfs, _) -> mfs }

#[doc("The source file that declares `d`, or the root file when the decl has no resolvable home.")]
pub fn decl_diag_file(d: Decl, df: DiagFiles) : String = match df {
  DF(mfs, root) -> match decl_home_module(d) {
    None    -> root
    Some(m) -> module_file_or(m, mfs, root)
  }
}

#[doc("The source file of module `m`, or `root` when the table has no entry for it.")]
pub fn module_file_or(m: String, mfs: [ModFile], root: String) : String =
  match mfs {
    [] -> root
    [mf, ...rest] -> match mf {
      MF(name, path) -> if name == m { path } else { module_file_or(m, rest, root) }
    }
  }

# The annotation wrappers are transparent.
#[doc("The module that declares `d`, read from the `module_origin` its variant carries.")]
pub fn decl_home_module(d: Decl) : Option[String] = match d {
  DFn(_, _, _, _, _, _, _, _, _, mo)   -> mo
  DType(_, _, _, _, _, _, mo, _)       -> mo
  DProtocol(_, _, _, _, _, _, mo)      -> mo
  DConst(_, _, _, _, mo, _, _)         -> mo
  DEffect(_, _, _, _, _, _, _, mo)     -> mo
  DDerive(_, inner, _, _)              -> decl_home_module(inner)
  DUnstable(inner, _, _)               -> decl_home_module(inner)
  DProtoLaws(_, inner, _, _, _)           -> decl_home_module(inner)
  DImplAxiom(_, inner, _, _, _)           -> decl_home_module(inner)
  DConstructor(inner, _, _)            -> decl_home_module(inner)
  DImpl(_, _, _, sub_decls, _, _, _)   -> diag_impl_first_home(sub_decls)
  _                                    -> None
}

fn diag_impl_first_home(ms: [Decl]) : Option[String] = match ms {
  [] -> None
  [m, ...rest] -> match m {
    DFn(_, _, _, _, _, _, _, _, _, mo) -> mo
    _ -> diag_impl_first_home(rest)
  }
}
