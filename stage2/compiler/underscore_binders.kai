#[doc("""
An `_`-prefixed binder is an ordinary binder whose name only silences the
unused warning.

A pattern binder spelled that way and never read becomes a wildcard here,
and an unread `..._t` rest becomes the anonymous rest. This runs once, as
patterns are lowered, so every later pass reads "unused" from the pattern's
shape and never from a name. A read binder stays bound whatever its name.

The pass runs on parser output, so a read is a name still written like
the binder, lambdas and interpolations included; an over-count only
keeps a binder bound, which is always sound.
""")]

import compiler.ast
import compiler.interp_span
import compiler.expr_positions
import compiler.util
import compiler.written

#[doc("True when `name` asks for the unused warning to stay silent: one leading `_`. A `__` prefix marks a compiler-internal name, which is exempt.")]
pub fn ub_silenced_name(name: String) : Bool = match char_at(name, 0) {
  Some(c0) -> c0 == '_' and match char_at(name, 1) {
    Some(c1) -> c1 != '_'
    None     -> true
  }
  None -> false
}

#[doc("The binder an anonymous list rest takes at the `[` of `(line, col)`. Unique per pattern, since two rests never share a `[`.")]
pub fn ub_rest_sentinel(line: Int, col: Int) : Binder =
  binder_written(concat_all(["__list_rest_", int_to_string(line), "_", int_to_string(col), "__"]))

#[doc("The arm with its pattern's unread `_`-prefixed binders made wildcards. The guard and the body are the binders' scope.")]
pub fn ub_arm(a: Arm) : Arm = match a {
  Arm(p, g, b) -> Arm(ub_pat(p, (n) => not ub_silenced(n) or ub_read_in_arm(n, g, b)), g, b)
}

#[doc("The block's statements with each `let` pattern's unread `_`-prefixed binders made wildcards. A `let` binds for the statements after it and the tail.")]
pub fn ub_block(ss: [Stmt], tail: Option[Expr]) : [Stmt] = match ss {
  [] -> []
  [s, ...rest] -> [ub_stmt(s, rest, tail), ...ub_block(rest, tail)]
}

fn ub_stmt(s: Stmt, rest: [Stmt], tail: Option[Expr]) : Stmt = match s {
  SLet(p, ty, e) -> SLet(ub_pat(p, (n) => not ub_silenced(n) or ub_read_after(n, rest, tail)), ty, e)
  _              -> s
}

fn ub_read_in_arm(n: Binder, g: Option[Expr], b: Expr) : Bool =
  ub_mentions(n, b) or match g {
    Some(ge) -> ub_mentions(n, ge)
    None     -> false
  }

fn ub_read_after(n: Binder, rest: [Stmt], tail: Option[Expr]) : Bool =
  ub_mentions(n, mk_expr(EBlock(rest, tail), 0, 0))

# No name is resolved yet, so a read of the binder is the name it was
# written with: as an expression, or as a token of an interpolation.
#[doc("True when `e` reads the binder `n`, before any name is resolved.")]
pub fn ub_mentions(n: Binder, e: Expr) : Bool = match e.kind {
  EName(u)       -> written_text(u) == written_text(n.name)
  EStr(span, t3) -> isp_ident_count(written_text(n.name), span, t3) > 0
  _              -> ub_mentions_ps(n, xp_positions(e))
}

fn ub_mentions_ps(n: Binder, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> ub_mentions(n, c) or ub_mentions_ps(n, rest)
}

fn ub_silenced(n: Binder) : Bool = ub_silenced_name(written_text(n.name))

#[doc("The pattern binding only the binders `keep` accepts: any other becomes a wildcard, the anonymous rest, or the bare sub-pattern of an `@`.")]
pub fn ub_pat(p: Pattern, keep: (Binder) -> Bool) : Pattern = match p.pkind {
  PBind(n) -> if keep(n) { p } else { mk_pat(PWild, p.line, p.col) }
  PList(ps, rest) ->
    mk_pat(PList(ub_pats(ps, keep), ub_rest(rest, keep, p.line, p.col)), p.line, p.col)
  PVariant(r, ps)        -> mk_pat(PVariant(r, ub_pats(ps, keep)), p.line, p.col)
  PVariantRecord(r, fs)  -> mk_pat(PVariantRecord(r, ub_fields(fs, keep)), p.line, p.col)
  PRecord(fs)            -> mk_pat(PRecord(ub_fields(fs, keep)), p.line, p.col)
  PAs(n, sub)            -> if keep(n) { mk_pat(PAs(n, ub_pat(sub, keep)), p.line, p.col) } else { ub_pat(sub, keep) }
  # A narrowing cannot lose its binder, so an unkept one takes a silent name.
  PNarrow(n, t)          -> if keep(n) or ub_silenced(n) { p } else { mk_pat(PNarrow(binder_written("_unread"), t), p.line, p.col) }
  _                      -> p
}

fn ub_pats(ps: [Pattern], keep: (Binder) -> Bool) : [Pattern] = match ps {
  [] -> []
  [p, ...rest] -> [ub_pat(p, keep), ...ub_pats(rest, keep)]
}

fn ub_fields(fs: [PField], keep: (Binder) -> Bool) : [PField] = match fs {
  [] -> []
  [PField(name, sub, short), ...rest] -> [PField(name, ub_pat(sub, keep), short), ...ub_fields(rest, keep)]
}

fn ub_rest(rest: Option[Binder], keep: (Binder) -> Bool, line: Int, col: Int) : Option[Binder] =
  match rest {
    Some(r) -> if keep(r) { rest } else { Some(ub_rest_sentinel(line, col)) }
    None    -> None
  }
