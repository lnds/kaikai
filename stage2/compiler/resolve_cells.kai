#[doc("""
Cells in the resolver: a `var`, and the alias of a `State` or `Reader` handler, read and write naked. A cell is its binder's id, so a read of it is a node naming that id and no spelling decides which binder a name reaches.
""")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.ast_ids
import compiler.written
import compiler.resolve_state
import compiler.resolve_env
import compiler.desugar_cell_access

#[doc("`e` with the binder `id` read and written as a cell.")]
pub(pkg) fn cell_marked(e: Env, id: LocalId) : Env =
  env_with_rs(e, ResState { ...e.rs, cells: [id, ...e.rs.cells] })

#[doc("True when the program holds a binder whose use the escape check restricts: a `var`, or the alias of a handle.")]
pub(pkg) fn has_scoped_binders(e: Env) : Bool = e.rs.vars or e.rs.aliased

#[doc("`e` recording that the program holds a `var`, which the lowering after the resolver rewrites.")]
pub(pkg) fn vars_marked(e: Env) : Env =
  if e.rs.vars { e } else { env_with_rs(e, ResState { ...e.rs, vars: true }) }

#[doc("`e` with the binder `id` a cell when `eff`, the effect its handler installs, is one that reads naked.")]
pub(pkg) fn cell_alias_marked(e: Env, eff: DeclRef, id: LocalId) : Env = {
  let e1 = if e.rs.aliased { e } else { env_with_rs(e, ResState { ...e.rs, aliased: true }) }
  if eff_is_cell(ref_sym(eff)) { cell_marked(e1, id) } else { e1 }
}

fn is_cell(e: Env, l: LocalId) : Bool = any(e.rs.cells, (c) => local_eq(c, l))

#[doc("The cell the bare name `x` reaches, when it is one.")]
pub(pkg) fn cell_reached(e: Env, x: Expr) : Option[LocalId] = match e.rs.cells {
  [] -> None
  _  -> match x.kind {
    EName(w) -> match env_lookup(e, written_text(w)) {
      Some(BLocal(l)) -> if is_cell(e, l) { Some(l) } else { None }
      _               -> None
    }
    _ -> None
  }
}

#[doc("What a read of the local `l` is: the read node of a cell, the local itself otherwise.")]
pub(pkg) fn local_read_kind(e: Env, l: LocalId, x: Expr) : ExprKind = match e.rs.cells {
  [] -> ELocal(l)
  _  -> if is_cell(e, l) { mk_cell_get(l, x.line, x.col) } else { ELocal(l) }
}

#[doc("Rejects `@n` on a cell: it reads naked, and `@` dereferences a first-class `Ref`.")]
pub(pkg) fn cell_deref_rejected(e: Env, x: Expr, line: Int, col: Int) : Env / Console + File = {
  let n = match x.kind { EName(w) -> written_text(w)  _ -> "" }
  diag_error(e.file, line, col, concat_all([
    "`@", n, "` is not how a `var` cell is read — read it naked, as `", n, "`"
  ]))
  diag_help(concat_all([
    "`@` dereferences a first-class `Ref[T]`; a `var`/`State`/`Reader` cell is block-local and reads without `@`"
  ]))
  env_mark_err(e)
}
