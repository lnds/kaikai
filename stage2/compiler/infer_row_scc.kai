#[doc("Typing order for the private fns that omit their row: each is typed once, after every such fn it calls, so a call reads the row its callee settled on.")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.scc
import compiler.expr_positions
import compiler.effect_instance
import compiler.infer_index
import compiler.infer_unify_rows
import compiler.infer_tparam_escape
import compiler.infer_unit_tables
import compiler.infer_state
import compiler.infer_clause_holes
import compiler.infer_env
import compiler.infer_row_kinds
import compiler.type_home
import compiler.infer_env_exhaust
import compiler.infer_env_schemes
import compiler.diag_type_text

#[doc("infer: the env with the scheme of every fn typed ahead, and those fns' typed declarations by identity.")]
pub(pkg) type RowFirst = { env: TyEnv, done: NameIndex[TypedDecl] }

#[doc("infer: types the declarations in `cands` callee-first, binding each component's settled scheme before the next is typed. A component of several fns shares one row: the union of its members'.")]
pub(pkg) fn type_rowless_first(typeit: (TyEnv, Decl) -> TypedDecl / Console + File + Mutable,
                          file_of: (Decl) -> String,
                          rk: [RowKindEntry], homes: TyHomes, env: TyEnv,
                          cands: [Decl]) : RowFirst / Console + File + Mutable =
  match cands {
    [] -> RowFirst { env: env, done: idx_empty() }
    [first, ..._] -> {
      let n = list_length(cands)
      let ix = foldl(zip_index(cands, 0), idx_empty(), (a, p) => match p { (i, d) -> idx_prepend_sym(a, decl_fn_sym(d), i) })
      let es = flat_map(zip_index(cands, 0), (p) => match p {
        (i, d) -> map(callee_indices(ix, d), (j) => (i, j))
      })
      let arr = fill_decls(cands, 0, array_make(n, first))
      type_components(typeit, file_of, rk, homes, arr, scc_components(n, es), env, idx_empty())
    }
  }

fn zip_index(ds: [Decl], i: Int) : [(Int, Decl)] = match ds {
  [] -> []
  [d, ...rest] -> [(i, d), ...zip_index(rest, i + 1)]
}

fn fill_decls(ds: [Decl], i: Int, arr: Array[Decl]) : Array[Decl] / Mutable = match ds {
  [] -> arr
  [d, ...rest] -> fill_decls(rest, i + 1, array_set(arr, i, d))
}

fn decl_fn_sym(d: Decl) : SymId = match d {
  DFn(_, fid, _, _, _, _, _, _, _, _, _, _) -> fnid_sym(fid)
  _ -> sym_none()
}

fn callee_indices(ix: NameIndex[Int], d: Decl) : [Int] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _, _, _) -> body_callees(ix, body, [])
  _ -> []
}

fn body_callees(ix: NameIndex[Int], e: Expr, acc: [Int]) : [Int] = {
  let here = match e.kind {
    ESym(s, _) -> list_append(idx_chain_sym(ix, s), acc)
    _ -> acc
  }
  foldl(xp_positions(e), here, (a, p) => match p { XP(_, c) -> body_callees(ix, c, a) })
}

fn type_components(typeit: (TyEnv, Decl) -> TypedDecl / Console + File + Mutable, file_of: (Decl) -> String,
                   rk: [RowKindEntry], homes: TyHomes, arr: Array[Decl], comps: [[Int]], env: TyEnv,
                   done: NameIndex[TypedDecl]) : RowFirst / Console + File + Mutable = match comps {
  [] -> RowFirst { env: env, done: done }
  [c, ...rest] -> {
    let ds = map(c, (i) => array_get(arr, i))
    let settled = share_row(file_of, ds, map(ds, (d) => typeit(env, d)))
    let env2 = foldl(zip_decls(ds, settled), env, (e, p) => match p {
      (d, t) -> match fn_scheme_of_decl(with_row_of(d, t.decl), rk, homes) {
        Some(sc) -> env_bind_sym(e, decl_fn_sym(d), sc)
        None -> e
      }
    })
    type_components(typeit, file_of, rk, homes, arr, rest, env2,
                    foldl(zip_decls(ds, settled), done, (ix, p) => match p { (d, t) -> idx_prepend_sym(ix, decl_fn_sym(d), t) }))
  }
}

fn zip_decls(ds: [Decl], ts: [TypedDecl]) : [(Decl, TypedDecl)] = match (ds, ts) {
  ([d, ...dr], [t, ...tr]) -> [(d, t), ...zip_decls(dr, tr)]
  _ -> []
}

fn with_row_of(orig: Decl, typed: Decl) : Decl = match (orig, typed) {
  (DFn(ip, fid, a, b, c, _, g, h, i, j, k, m), DFn(_, _, _, _, _, row, _, _, _, _, _, _)) -> DFn(ip, fid, a, b, c, row, g, h, i, j, k, m)
  _ -> orig
}

fn decl_row(d: Decl) : RowExpr = match d {
  DFn(_, _, _, _, _, row, _, _, _, _, _, _) -> row
  _ -> REmpty
}

fn decl_with_row(d: Decl, row: RowExpr) : Decl = match d {
  DFn(ip, fid, a, b, c, _, g, h, i, j, k, m) -> DFn(ip, fid, a, b, c, row, g, h, i, j, k, m)
  _ -> d
}

fn row_labels(r: RowExpr) : [RowLabel] = match r {
  REmpty -> []
  RClosed(ls) -> ls
  ROpen(_, ls) -> ls
}

fn row_is_open(r: RowExpr) : Bool = match r {
  ROpen(_, _) -> true
  _ -> false
}

# Two labels are one when they name one effect at structurally equal types.
fn rl_same(a: RowLabel, b: RowLabel) : Bool = match (a, b) {
  (RL(ra, xs), RL(rb, ys)) ->
    sym_same(ref_sym(ra), ref_sym(rb)) and list_length(xs) == list_length(ys)
      and all(zip_tes(xs, ys), (p) => ty_eq_shape(te_as_ty(p.fst), te_as_ty(p.snd)))
}

fn zip_tes(xs: [TypeExpr], ys: [TypeExpr]) : [(TypeExpr, TypeExpr)] = match (xs, ys) {
  ([x, ...xr], [y, ...yr]) -> [(x, y), ...zip_tes(xr, yr)]
  _ -> []
}

# The members of a recursive group call one another, so a member performs
# what its own body does and what its callees do, less what the handlers
# around each call discharge. Each member's own labels come from its typing;
# the call sites are read off the typed bodies by identity.
fn share_row(file_of: (Decl) -> String, ds: [Decl], ts: [TypedDecl]) : [TypedDecl] = match ts {
  [_] -> ts
  _ -> {
    if any(ts, (t) => row_is_open(decl_row(t.decl))) {
      map(zip_decls(ds, ts), (p) => match p {
        (d, t) -> TypedDecl { ...t, errs: t.errs + 1,
          diags: list_append(t.diags, [mk_diag(SevError, file_of(d), decl_line(d), decl_col(d),
            "cannot infer the row of a recursive group whose row is tied to a row variable of its signature",
            [])]) }
      })
    } else {
      let syms = map(ds, decl_fn_sym)
      let own = map(ts, (t) => row_labels(decl_row(t.decl)))
      let calls = map(ts, (t) => decl_group_calls(syms, t.decl))
      let rows = solve_group(own, calls, own)
      map(zip_rows(ts, rows), (p) => match p {
        (t, ls) -> TypedDecl { ...t, decl: decl_with_row(t.decl, if list_is_empty(ls) { REmpty } else { RClosed(ls) }) }
      })
    }
  }
}

fn zip_rows(ts: [TypedDecl], rs: [[RowLabel]]) : [(TypedDecl, [RowLabel])] = match (ts, rs) {
  ([t, ...tr], [r, ...rr]) -> [(t, r), ...zip_rows(tr, rr)]
  _ -> []
}

# Rows only grow and the labels are finite, so the rows settle.
fn solve_group(own: [[RowLabel]], calls: [[(Int, [Handler])]], rows: [[RowLabel]]) : [[RowLabel]] = {
  let next = map(zip_rows_calls(own, calls), (p) => match p {
    (o, cs) -> union_labels(list_append(o, flat_map(cs, (c) => match c {
      (j, handled) -> filter(nth_row(rows, j), (l) => not any(handled, (h) => handler_discharges(h, l)))
    })), [])
  })
  if total_labels(next) == total_labels(rows) { rows } else { solve_group(own, calls, next) }
}

fn total_labels(rows: [[RowLabel]]) : Int = foldl(rows, 0, (n, r) => n + list_length(r))

fn zip_rows_calls(own: [[RowLabel]], calls: [[(Int, [Handler])]]) : [([RowLabel], [(Int, [Handler])])] = match (own, calls) {
  ([o, ...os], [c, ...cr]) -> [(o, c), ...zip_rows_calls(os, cr)]
  _ -> []
}

fn nth_row(rows: [[RowLabel]], j: Int) : [RowLabel] = match rows {
  [] -> []
  [r, ...rest] -> if j == 0 { r } else { nth_row(rest, j - 1) }
}

fn union_labels(ls: [RowLabel], acc: [RowLabel]) : [RowLabel] = match ls {
  [] -> list_reverse(acc)
  [l, ...rest] -> if any(acc, (a) => rl_same(a, l)) { union_labels(rest, acc) } else { union_labels(rest, [l, ...acc]) }
}

# A handle as the typer reads it when it filters the body's row.
type Handler = { eff: SymId, cell: LocalId, tyargs: [Ty] }

# The typer's own discharge rule, so the two cannot drift.
fn handler_discharges(h: Handler, l: RowLabel) : Bool = match l {
  RL(r, args) -> {
    let lab = Label { sym: ref_sym(r), ty_args: map(args, te_as_ty), cell: local_none() }
    label_same(lab, label_in_cell(h.eff, [], h.cell))
      and label_args_dischargeable(lab.ty_args, take_first_tys(h.tyargs, list_length(lab.ty_args)), subst_empty())
  }
}

# Each call a body makes to a member of the group, with the labels the
# handles around it discharge.
fn decl_group_calls(syms: [SymId], d: Decl) : [(Int, [Handler])] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _, _, _) -> group_calls(syms, body, [], [])
  _ -> []
}

fn group_calls(syms: [SymId], e: Expr, handled: [Handler], acc: [(Int, [Handler])]) : [(Int, [Handler])] = {
  let here = match e.kind {
    ESym(s, _) -> match index_of_sym(syms, s, 0) {
      Some(j) -> [(j, handled), ...acc]
      None -> acc
    }
    _ -> acc
  }
  match e.kind {
    EHandle(body, ref, targs, init, alias, cls, oret) -> {
      let h = Handler { eff: ref_sym(ref), cell: match alias { Some(a) -> a.id  None -> local_none() }, tyargs: map(targs, te_as_ty) }
      let inside = group_calls(syms, body, [h, ...handled], here)
      let a1 = match init { Some(i) -> group_calls(syms, i, handled, inside)  None -> inside }
      let a2 = foldl(cls, a1, (a, c) => match c { HC(_, _, b, _, _) -> group_calls(syms, b, handled, a) })
      match oret { Some(HR(_, b, _, _)) -> group_calls(syms, b, handled, a2)  None -> a2 }
    }
    _ -> foldl(xp_positions(e), here, (a, p) => match p { XP(_, c) -> group_calls(syms, c, handled, a) })
  }
}

fn index_of_sym(syms: [SymId], s: SymId, i: Int) : Option[Int] = match syms {
  [] -> None
  [m, ...rest] -> if sym_same(m, s) { Some(i) } else { index_of_sym(rest, s, i + 1) }
}

fn decl_line(d: Decl) : Int = match d {
  DFn(_, _, _, _, _, _, _, l, _, _, _, _) -> l
  _ -> 0
}

fn decl_col(d: Decl) : Int = match d {
  DFn(_, _, _, _, _, _, _, _, c, _, _, _) -> c
  _ -> 0
}
