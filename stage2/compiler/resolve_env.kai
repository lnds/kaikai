#[doc("The resolver's environment and the resolution of callees.")]

import compiler.diag
import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.effect_alias
import compiler.native_prims
import compiler.core_builtins
import compiler.symtab
import compiler.resolve_state
import compiler.written
import compiler.refine_types
import compiler.infer_index
import compiler.modules_homes
import compiler.scope_view
import compiler.util

#[doc("Resolver scope environment: the scope chain, an error flag, the source file, and the T3 diagnostic accumulator.")]
pub(pkg) type Env = { chain: ScopeChain, had_error: Bool, file: String,
              # Right-hand sides of bare `type E = X` declarations. `X`
              # names no constructor — the declaration is an alias — so
              # a use of `X` as a value is the one-member-sum mistake
              # and earns a targeted help line.
              alias_heads: [String],
              # A row alias (`type Console = Stdout + Stderr + Stdin`) is
              # an `NCType`, so an op call written on it has no effect
              # declaration to stamp. These settle it to the component
              # that declares the op (`effect_alias_scope`).
              row_aliases: [RowAlias],
              eff_ops: [EffOps],
              # Structured diagnostic collection for T3
              # (`cannot find <name> in this scope`). Mirrors
              # `InferState.diags` semantics (reverse order, flipped at
              # the entry point).
              diags: [Diagnostic],
              # The resolution the walk produces. Inert unless the
              # entry point turned it on.
              rs: ResState,
              callees: CalleeTab,
              # What settles the names a refinement's predicate leaves
              # to the type it refines.
              preds: PredCx,
              larity: [LocalArity],
              params: [ParamIds],
              # The pipes whose stage is being walked, innermost first,
              # kept only when a lambda on the left side ends at the pipe.
              cut_pipes: [Expr],
              # Warnings are collected but not printed.
              quiet: Bool }

#[doc("The local ids a function's parameters were numbered with, in parameter order.")]
pub(pkg) type ParamIds = ParamIds(SymId, [LocalId])

#[doc("Fresh resolver env for `file` with a single empty scope and no errors.")]
pub(pkg) fn env_new(file: String) : Env =
  Env { chain: ch_new(), had_error: false, file: file, alias_heads: [],
        row_aliases: [], eff_ops: [], diags: [], rs: rs_off(),
        callees: ct_empty(), preds: pn_none(), larity: [], params: [], cut_pipes: [], quiet: false }

#[doc("`e` with the scope chain `c`.")]
pub(pkg) fn env_with_chain(e: Env, c: ScopeChain) : Env =
  Env { ...e, chain: c }

#[doc("`e` with a new innermost scope.")]
pub(pkg) fn env_push(e: Env) : Env = env_with_chain(e, ch_push(e.chain))

#[doc("`e` without its innermost scope.")]
pub(pkg) fn env_pop(e: Env) : Env = env_with_chain(e, ch_pop(e.chain))

#[doc("""
A top-level name is registered so forward references resolve, but its
identity is NOT fixed here: two homes may declare it, and which one a
use reaches depends on the home the walk is inside when the use is
read. Binding it to a symbol at registration time would freeze the
first home's answer for every reader.
A declaration that carries its name instead of an id binds the id the
table holds for it in the current home, `sym_none()` when it holds
none: the chain still shadows correctly.
""")]
pub(pkg) fn env_add(e: Env, name: String, cls: NCls) : Env =
  env_with_chain(e, ch_bind(e.chain, name, BDecl(env_decl_owner_sym(e, cls, name))))

fn env_decl_owner_sym(e: Env, cls: NCls, name: String) : SymId =
  if rs_recording(e.rs) { rs_decl_owner_sym(e.rs, cls, name) } else { sym_none() }

#[doc("""
The name the declaration `s` was written with. Registration is where
the resolver learns it: nothing in the tree spells it.
""")]
pub(pkg) fn env_sym_text(e: Env, s: SymId) : String = written_text(sym_name(e.rs.tab, s))

#[doc("A declaration the table holds no row for has no name to register.")]
pub(pkg) fn env_add_decl(e: Env, s: SymId) : Env =
  if st_valid(e.rs.tab, s) { env_with_chain(e, ch_bind(e.chain, env_sym_text(e, s), BDecl(s))) } else { e }

#[doc("""
A binding with no declared class of its own: the core names `add_all`
seeds the root scope with, and a selective import's picked names,
which are already declarations elsewhere and get their identity from
the ORIGIN's registration, not a second one here.
""")]
pub(pkg) fn env_add_untyped(e: Env, name: String) : Env =
  env_with_chain(e, ch_bind(e.chain, name, BDecl(sym_none())))

#[doc("A binder, and the environment after it is bound.")]
pub(pkg) type RBinder = RBinder(Env, Binder)

#[doc("""
A binder takes a fresh local id: `let map = ...` shadows the core
`map` and must never be read as it. One that already carries an id,
minted or numbered by an earlier walk, keeps it.
""")]
pub(pkg) fn env_bind(e: Env, b: Binder) : RBinder = {
  let name = written_text(b.name)
  if local_raw(b.id) != 0 { RBinder(env_with_chain(e, ch_bind_local(e.chain, name, b.id)), b) }
  else { RBinder(env_with_chain(e, ch_declare_local(e.chain, name)), binder_numbered(b, ch_next_local(e.chain))) }
}

#[doc("True when `name` is bound in some scope of the chain.")]
pub(pkg) fn env_has(e: Env, name: String) : Bool = ch_has(e.chain, name)

#[doc("True when a read of `name` reaches a binder or a declaration. The chain binds every file's declarations, so a name is reached only when the walk's own file can use it.")]
pub(pkg) fn env_reaches(e: Env, name: String) : Bool = match ch_lookup(e.chain, name) {
  Some(BLocal(_)) -> true
  Some(BDecl(_))  -> not rs_recording(e.rs) or rs_reaches(e.rs, name)
  None            -> false
}

#[doc("""
What a name reaches: a binder answers with its own id, a declaration
with whatever the symbol table resolves for the home the walk is in.

NOT the id the chain bound at registration. A core name is bound once
for the whole program, but which
declaration it reaches depends on the home the walk is inside when
the use is read — `map` is exported by `option`, `result` and `list`,
and answering with the registration's id turns every bare `map` into
a contested name. The chain's id says a name was declared; the table
says which declaration this reader reaches.
""")]
pub(pkg) fn env_lookup(e: Env, name: String) : Option[Bound] =
  match ch_lookup(e.chain, name) {
    Some(BLocal(l)) -> Some(BLocal(l))
    Some(BDecl(_))  -> match env_decl_sym(e, name) {
      Some(s) -> Some(BDecl(s))
      None    -> None
    }
    None -> None
  }

fn env_decl_sym(e: Env, name: String) : Option[SymId] =
  if rs_recording(e.rs) { rs_decl_sym(e.rs, name) } else { None }

#[doc("True when a local binder shadows `name`.")]
pub(pkg) fn env_shadowed(e: Env, name: String) : Bool = ch_shadows(e.chain, name)

#[doc("Every name the chain binds.")]
pub(pkg) fn env_all_names(e: Env) : [String] = ch_names(e.chain)

#[doc("`e` remembering `head` as an effect a handler alias stands for.")]
pub(pkg) fn env_note_alias_head(e: Env, head: String) : Env =
  Env { ...e, alias_heads: [head, ...e.alias_heads] }

#[doc("`e` marked as having reported an error.")]
pub(pkg) fn env_mark_err(e: Env) : Env =
  Env { ...e, had_error: true }

#[doc("""
Push a Diagnostic onto the Env accumulator. Used by the T3 emit
site in parallel with its existing `diag_error` call.
""")]
pub(pkg) fn env_push_diag(e: Env, d: Diagnostic) : Env =
  Env { ...e, diags: [d, ...e.diags] }

# ---- core seeding ----

#[doc("Canonical list of built-in value names pre-bound in every program's outermost scope.")]
pub(pkg) fn core_names() : [String] =
  list_append(core_builtin_names(), list_append(core_reserved_names(), native_prim_names()))

# Names no program declares but every scope must know, so the closure-capture
# analyser never takes one for a free variable: the core constructors.
fn core_reserved_names() : [String] = ["Some", "None", "Ok", "Err"]

# ---- expression walker ----
#
# Every walker returns the env AND the tree it walked. Rewriting here
# is what makes the resolver's decision survive: a use site the chain
# resolved becomes an `ELocal` or an `ESym` carrying the id, so no later
# pass re-reads the spelling to decide what the name meant.

#[doc("A walked expression: the env after it, and the tree with its resolved names stamped.")]
pub(pkg) type RExpr = RExpr(Env, Expr)

#[doc("A walked expression list: the env after it, and the rewritten elements.")]
pub(pkg) type RExprs = RExprs(Env, [Expr])

#[doc("A resolved expression kind, and the environment after it.")]
pub(pkg) type RKind = RKind(Env, ExprKind)

#[doc("What a resolver run produced: the error count, the declarations with every resolved name written as its identity, the table those ids index, and the diagnostics the walk collected.")]
pub(pkg) type Resolution = { errs: Int, decls: [Decl], tab: SymTab, diags: [Diagnostic], params: [ParamIds], env: Env }

#[doc("`e` with the resolver tables `rs`.")]
pub(pkg) fn env_with_rs(e: Env, rs: ResState) : Env =
  Env { ...e, rs: rs }

#[doc("`e` reading the file `file`.")]
pub(pkg) fn env_with_file(e: Env, file: String) : Env =
  Env { ...e, file: file }

#[doc("One protocol operation a bare call may reach: its name, its arity, its dispatcher, its protocol's home (`None` for the root file) and whether that protocol is exported.")]
pub(pkg) type ProtoRung = ProtoRung(String, Int, String, Option[String], Bool)

#[doc("The arities of a program's functions by identity, its protocol operations, and the module of the root file.")]
pub(pkg) type CalleeTab = { arities: NameIndex[Int], ops: [ProtoRung], target: String }

fn ct_empty() : CalleeTab = CalleeTab { arities: idx_empty(), ops: [], target: "" }

#[doc("The table for `decls`, homed under `target`, with the protocol operations `ops`.")]
pub(pkg) fn ct_build(decls: [Decl], target: String, ops: [ProtoRung]) : CalleeTab =
  CalleeTab { arities: ct_arities(decls, target, target, idx_empty()), ops: ops, target: target }

fn ct_arities(ds: [Decl], home: String, target: String, ix: NameIndex[Int]) : NameIndex[Int] =
  match ds {
    [] -> ix
    [d, ...rest] -> {
      let h = decl_home_hint_reset(d, home, target)
      ct_arities(rest, h, target, ct_note(ix, d, h))
    }
  }

fn ct_note(ix: NameIndex[Int], d: Decl, home: String) : NameIndex[Int] = match d {
  DFn(_, fid, _, ps, _, _, _, _, _, _) -> idx_prepend_sym(ix, fnid_sym(fid), list_length(ps))
  DConstructor(inner, _, _) -> ct_note(ix, inner, home)
  DDoc(_, _, inner, _, _)   -> ct_note(ix, inner, home)
  DAttr(_, inner, _, _)     -> ct_note(ix, inner, home)
  _ -> ix
}

fn ct_arity(ct: CalleeTab, s: SymId) : Option[Int] = match idx_chain_sym(ct.arities, s) {
  [a, ..._] -> Some(a)
  []        -> None
}

#[doc("Whether a call of arity `n` fits `s`: a declaration of no fixed arity fits any call.")]
pub(pkg) fn ct_fits(ct: CalleeTab, s: SymId, n: Int) : Bool = match ct_arity(ct, s) {
  Some(a) -> a == n
  None    -> true
}

#[doc("A protocol operation's dispatcher: the declaration the table holds, or the name the dispatchers are written with when protocols of several homes declare the operation and the type settles which.")]
pub(pkg) type Disp = DispSym(SymId) | DispWritten(String)

fn ct_proto(ct: CalleeTab, name: String, n: Option[Int], rs: ResState) : Option[Disp] = {
  let seen = filter(ct.ops, (r) => rung_fits(r, name, n) and rung_seen(r, rs_home_name(rs), ct.target))
  let own = filter(seen, (r) => rung_home(r, ct.target) == rs_home_name(rs))
  let near = filter(seen, (r) => rs_sees_home(rs, rung_home(r, ct.target)))
  rung_disp(first_nonempty([own, near, seen]), ct.target, rs)
}

fn first_nonempty(tiers: [[ProtoRung]]) : [ProtoRung] = match tiers {
  [] -> []
  [t, ...rest] -> if list_is_empty(t) { first_nonempty(rest) } else { t }
}

# A dispatcher carries its identity: two modules may each declare a
# protocol with an operation of one name.
fn rung_disp(rungs: [ProtoRung], target: String, rs: ResState) : Option[Disp] = match rungs {
  [] -> None
  [r, ...rest] -> {
    let h = rung_home(r, target)
    let s = sym_derive(NCFn, rung_name(r), h)
    let one = all(rest, (o) => rung_home(o, target) == h)
    Some(if one and rs_recording(rs) and st_valid(rs.tab, s) { DispSym(s) } else { DispWritten(rung_name(r)) })
  }
}

fn rung_fits(r: ProtoRung, name: String, n: Option[Int]) : Bool = match r {
  ProtoRung(op, a, _, _, _) -> op == name and ct_arity_ok(n, a)
}

fn rung_seen(r: ProtoRung, home: String, target: String) : Bool = match r {
  ProtoRung(_, _, _, mo, exported) -> match mo {
    None    -> home == target
    Some(m) -> m == home or exported
  }
}

fn rung_home(r: ProtoRung, target: String) : String = match r {
  ProtoRung(_, _, _, mo, _) -> match mo { Some(m) -> m  None -> target }
}

fn rung_name(r: ProtoRung) : String = match r { ProtoRung(_, _, disp, _, _) -> disp }

fn ct_arity_ok(n: Option[Int], a: Int) : Bool = match n {
  Some(k) -> k == a
  None    -> true
}

#[doc("A local binder whose definition fixes its arity: a lambda, or a function-typed annotation.")]
pub(pkg) type LocalArity = LocalArity(LocalId, Int)

#[doc("What the climb reads: the scopes in force, the resolution state, the table, and the local arities.")]
pub(pkg) type CallCx = CallCx(ScopeChain, ResState, CalleeTab, [LocalArity])

#[doc("What a bare use reached: a binder, a declaration, a name left as written (a constructor, a contest the type settles), a protocol operation's dispatcher, nothing that fits, or the core rung's builtin.")]
pub(pkg) type Reach = RLocal(LocalId) | RDecl(SymId) | RBare | RProto(Disp) | RNone | RCore

#[doc("The nearer binding a call passed over because its arity did not fit: a local of that arity, or a declaration.")]
pub(pkg) type Skip = SkNone | SkLocal(Int) | SkDecl(SymId)

#[doc("A call's answer and what it passed over on the way.")]
pub(pkg) type Hit = Hit(Reach, Skip)

#[doc("The arity a binder's definition fixes, if any: a lambda's parameter count, else a function-typed annotation's.")]
pub(pkg) fn binder_arity(rhs: Option[Expr], ta: Option[TypeExpr]) : Option[Int] = match ta {
  Some(t) -> match t.tkind { TyFn(ps, _, _) -> Some(list_length(ps))  _ -> None }
  None -> match rhs {
    Some(x) -> match x.kind { ELambda(ps, _) -> Some(list_length(ps))  _ -> None }
    None -> None
  }
}

#[doc("""
What a bare call of `name` with `n` arguments reaches. The nearest
binding whose arity fits answers: a local, then the reader's own module,
its picks and its imports, then a protocol operation, then the core and
any module that exports it. A protocol operation outranks a core
function of the same name and arity: `add(1, 2)` is `Add.add`, never
`complex.add`. `RNone` when nothing fits, so the caller reads the name
as a value and the arity error names the nearest binding.
""")]
pub(pkg) fn call_hit(cx: CallCx, name: String, n: Int) : Hit = match cx {
  CallCx(chain, _, _, las) -> {
    let ls = ch_locals(chain, name)
    match la_first_fit(las, ls, n) {
      Some(s) -> Hit(RLocal(s), SkNone)
      None    -> decl_hit(cx, name, n, la_skip(las, ls))
    }
  }
}

# Only the innermost binder of a name competes: a `let` hides every
# outer binder of its name, whatever the arities.
fn la_first_fit(las: [LocalArity], ls: [LocalId], n: Int) : Option[LocalId] = match ls {
  [] -> None
  [s, ..._] -> match la_of(las, s) {
    Some(a) -> if a == n { Some(s) } else { None }
    None    -> Some(s)
  }
}

fn la_skip(las: [LocalArity], ls: [LocalId]) : Skip = match ls {
  [s, ..._] -> match la_of(las, s) { Some(a) -> SkLocal(a)  None -> SkNone }
  []        -> SkNone
}

fn la_of(las: [LocalArity], s: LocalId) : Option[Int] = match las {
  [] -> None
  [LocalArity(t, a), ...rest] -> if local_eq(t, s) { Some(a) } else { la_of(rest, s) }
}

fn decl_hit(cx: CallCx, name: String, n: Int, sk0: Skip) : Hit = match cx {
  CallCx(_, rs, ct, _) -> {
    let fits = (s) => ct_fits(ct, s, n)
    let near = rs_rungs_call(rs, name, sv_near_rungs(), fits)
    match near {
      RsCall(RcNone, sk) -> match ct_proto(ct, name, Some(n), rs) {
        Some(d) -> Hit(RProto(d), sk_join(sk0, sk))
        None    -> rs_hit(rs_rungs_call(rs, name, far_rungs(), fits), sk_join(sk0, sk))
      }
      _ -> rs_hit(near, sk0)
    }
  }
}

fn far_rungs() : [SvRung] = [SvCores, SvAny]

fn rs_rungs_call(rs: ResState, name: String, rungs: [SvRung], fits: (SymId) -> Bool) : RsCall =
  if rs_recording(rs) { rs_call_sym(rs, name, rungs, fits) } else { RsCall(RcNone, None) }

fn rs_hit(c: RsCall, sk0: Skip) : Hit = match c {
  RsCall(RcSym(s), sk) -> Hit(RDecl(s), sk_join(sk0, sk))
  RsCall(RcBare, sk)   -> Hit(RBare, sk_join(sk0, sk))
  RsCall(RcCore, sk)   -> Hit(RCore, sk_join(sk0, sk))
  RsCall(RcNone, _)    -> Hit(RNone, SkNone)
}

fn sk_join(sk0: Skip, sk: Option[SymId]) : Skip = match sk0 {
  SkNone -> match sk { Some(s) -> SkDecl(s)  None -> SkNone }
  _      -> sk0
}

#[doc("The dispatcher a bare `name` used as a value reaches, if any: the call ladder with no arity to check, so a binding nearer than the protocol rung answers first.")]
pub(pkg) fn value_proto(cx: CallCx, name: String) : Option[Disp] = match cx {
  CallCx(chain, rs, ct, _) ->
    if not list_is_empty(ch_locals(chain, name)) { None }
    else if near_binds(rs, name, (s) => true) { None }
    else { ct_proto(ct, name, None, rs) }
}

#[doc("The dispatcher a method call `recv.op(...)` with `n` arguments, the receiver counted, reaches when no binding nearer than the protocol rung answers a call of that arity.")]
pub(pkg) fn method_proto(cx: CallCx, op: String, n: Int) : Option[Disp] = match cx {
  CallCx(chain, rs, ct, _) ->
    if not list_is_empty(ch_locals(chain, op)) { None }
    else if near_binds(rs, op, (s) => ct_fits(ct, s, n)) { None }
    else { ct_proto(ct, op, Some(n), rs) }
}

fn near_binds(rs: ResState, name: String, fits: (SymId) -> Bool) : Bool =
  if not rs_recording(rs) { false }
  else { match rs_call_sym(rs, name, sv_near_rungs(), fits) {
    RsCall(RcNone, _) -> false
    _                 -> true
  } }

#[doc("""
The warning a call earns when it passed over a binding the user wrote —
a local, or a declaration outside the core — for one of another arity,
read from a module that is not a core. `None` otherwise: the core's own
homonyms of different arity (`list.max` and `Ord.max`) coexist by design.
""")]
pub(pkg) fn skip_warning(cx: CallCx, name: String, n: Int, h: Hit) : Option[String] = match cx {
  CallCx(_, rs, ct, _) ->
    if rs_in_core(rs) { None }
    else { match h {
      Hit(RNone, _)      -> None
      Hit(_, SkNone)     -> None
      Hit(r, SkLocal(a)) -> Some(skip_text(name, n, concat_all(["the local `", name, "`"]), a, r, rs))
      Hit(r, SkDecl(s))  -> if rs_is_core_sym(rs, s) { None } else { match ct_arity(ct, s) {
        Some(a) -> Some(skip_text(name, n, sym_text(rs, s, name), a, r, rs))
        None    -> None
      } }
    } }
}

fn skip_text(name: String, n: Int, skipped: String, a: Int, r: Reach, rs: ResState) : String =
  concat_all(["call to `", name, "` with ", int_to_string(n), " argument", plural(n), " skips ",
              skipped, ", which takes ", int_to_string(a), ", and reaches ", reach_text(name, r, rs)])

fn plural(n: Int) : String = if n == 1 { "" } else { "s" }

fn sym_text(rs: ResState, s: SymId, name: String) : String =
  concat_all(["`", written_text(sym_home(rs.tab, s)), ".", name, "`"])

fn reach_text(name: String, r: Reach, rs: ResState) : String = match r {
  RDecl(s)  -> sym_text(rs, s, name)
  RProto(_) -> concat_all(["the protocol operation `", name, "`"])
  RLocal(_) -> concat_all(["the local `", name, "`"])
  _         -> concat_all(["the core `", name, "`"])
}
