#[doc("""
Operand temporaries around a C call: sequencing, owned-borrow slots and unwind registration.

Left-to-right operand sequencing for the C emitter.

C leaves the evaluation order of call arguments and initializer-list
elements unspecified, and gcc on x86_64 evaluates call arguments right to
left. kaikai evaluates operands left to right, so when two or more operands
of one C construct may have side effects, each of them but the last is
bound to a temporary first:

    f(A, B)   ->   ({ __auto_type _q0 = A; f(_q0, B); })

`__auto_type` keeps each operand's C type without the emitter naming it.
Nested sequencings reuse the `_q<i>` names; each lives in its own
statement expression, so an inner one shadows an outer one harmlessly.

Owned-borrow arguments of a C call.

Perceus marks an argument the caller releases after a borrowing call, and
the C emitter holds each in a temp for the call's extent. A temp is a named
local bound before the call when nothing left of it can have an effect, so
binding it early changes no order. Otherwise a temp computed in place takes
a slot of one array and is assigned where its argument stands, and the
operands still run left to right.

C text for the unwind-stack brackets (`unwind_pend.kai`): a call that
can exit non-locally registers the frame's pending references for its
extent, a `match` its scrutinee slot, a `handle` the references that
outlive it plus its state slot.

A bracket is one push and one pop on the fiber's unwind stack. A frame
never changes fiber, so its C function looks the fiber up once, on its
first push, and the pop reuses it.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.emit_shared_syms
import compiler.local_names
import compiler.unwind_clauses
import compiler.util

#[doc("Operands after sequencing: bindings that run first, and the texts to splice in place of the operands.")]
pub type SeqOps = SeqOps(String, [String])

#[doc("Sequence operand texts left to right; an operand that cannot have side effects stays inline.")]
pub fn seq_operands(ops: [String]) : SeqOps = seq_bind(ops, 0, seq_last_live(ops, 0, 0 - 1), "", [])

#[doc("The operand texts to splice into the construct, in source order.")]
pub fn seq_refs(q: SeqOps) : [String] = match q {
  SeqOps(_, refs) -> refs
}

#[doc("The operand texts comma-joined, ready to splice into an argument list.")]
pub fn seq_joined(q: SeqOps) : String = join_with(seq_refs(q), ", ")

#[doc("Reshape each operand text, e.g. into an initializer-list slot, keeping the bindings.")]
pub fn seq_map_refs(q: SeqOps, f: (String) -> String) : SeqOps = match q {
  SeqOps(binds, refs) -> SeqOps(binds, map(refs, f))
}

#[doc("The bindings as C statements, for a construct emitted in statement position.")]
pub fn seq_binds(q: SeqOps) : String = match q {
  SeqOps(binds, _) -> binds
}

#[doc("Wrap a construct built from `seq_refs(q)` so the bindings of `q` run first.")]
pub fn seq_wrap(q: SeqOps, expr: String) : String = match q {
  SeqOps(binds, _) -> if binds == "" { expr } else { concat_all(["({ ", binds, expr, "; })"]) }
}

#[doc("`head`, the comma-joined operands, then `tail`, with the operands evaluated left to right.")]
pub fn seq_call(head: String, ops: [String], tail: String) : String {
  let q = seq_operands(ops)
  seq_wrap(q, concat_all([head, seq_joined(q), tail]))
}

#[doc("Two operands joined by a C infix operator, evaluated left to right.")]
pub fn seq_infix(a: String, op: String, b: String) : String {
  let q = seq_operands([a, b])
  match seq_refs(q) {
    [ra, rb] -> seq_wrap(q, concat_all(["(", ra, " ", op, " ", rb, ")"]))
    _ -> concat_all(["(", a, " ", op, " ", b, ")"])
  }
}

fn seq_bind(ops: [String], i: Int, last: Int, binds: String, refs: [String]) : SeqOps = match ops {
  [] -> SeqOps(binds, list_reverse(refs))
  [op, ...rest] ->
    if i < last and (not seq_inert(op)) {
      let t = concat_all(["_q", int_to_string(i)])
      let bind = concat_all(["__auto_type ", t, " = ", op, "; "])
      seq_bind(rest, i + 1, last, string_concat(binds, bind), [t, ...refs])
    } else {
      seq_bind(rest, i + 1, last, binds, [op, ...refs])
    }
}

fn seq_last_live(ops: [String], i: Int, last: Int) : Int = match ops {
  [] -> last
  [op, ...rest] -> seq_last_live(rest, i + 1, if seq_inert(op) { last } else { i })
}

# A name, a literal, or a literal boxed by a pure constructor. Anything
# else may call out, including a Perceus dup or drop, whose order against
# a sibling that consumes the same value is load-bearing.
fn seq_inert(op: String) : Bool =
  if op == "kai_nil()" or op == "kai_unit()" or op == "(KaiValue *)0" {
    true
  } else {
    string_index_of_char(seq_unbox(op, seq_pure_boxes()), '(') < 0
  }

fn seq_pure_boxes() : [String] =
  ["kai_int(", "kai_bool(", "kai_char(", "kai_real(", "kai_str_from_bytes("]

fn seq_unbox(op: String, boxes: [String]) : String = match boxes {
  [] -> op
  [b, ...rest] -> {
    let n = string_length(b)
    if string_length(op) > n and string_slice(op, 0, n) == b {
      string_slice(op, n, string_length(op) - n)
    } else {
      seq_unbox(op, rest)
    }
  }
}

#[doc("True for an argument carrying the bare owned-borrow mark.")]
pub fn eob_is_marked(a: Expr) : Bool = match a.kind {
  ECall(callee, [_]) -> match callee.kind {
    EMark(MkOwnedBorrow) -> true
    _                    -> false
  }
  _ -> false
}

#[doc("True when some argument carries the mark.")]
pub fn eob_any(args_e: [Expr]) : Bool = match args_e {
  []           -> false
  [a, ...rest] -> eob_is_marked(a) or eob_any(rest)
}

#[doc("The value a marked argument wraps.")]
pub fn eob_inner(a: Expr) : Expr = match a.kind {
  ECall(_, [x]) -> x
  _             -> a
}

#[doc("True for a marked argument computed in place, as opposed to one that only renames a binder.")]
fn eob_is_fresh(a: Expr) : Bool = eob_is_marked(a) and not unw_bare_read(eob_inner(a))

#[doc("True when a marked argument computed in place stands right of an argument that can have an effect of its own, so binding the temps up front would run them first.")]
pub fn eob_needs_slots(args_e: [Expr]) : Bool = eob_slots_go(args_e, false)

fn eob_slots_go(args_e: [Expr], seen: Bool) : Bool = match args_e {
  []           -> false
  [a, ...rest] ->
    if eob_is_fresh(a) { seen or eob_slots_go(rest, seen) }
    else { eob_slots_go(rest, seen or not eob_inert(a)) }
}

# A read or a literal: running it early or late changes nothing. A dup is
# not one, its order against a sibling that consumes the value is load-bearing.
fn eob_inert(a: Expr) : Bool = match a.kind {
  ELocal(_)   -> true
  ESym(_, _)  -> true
  EInt(_, _)  -> true
  EBool(_)    -> true
  EChar(_)    -> true
  EUnit       -> true
  ECall(_, _) -> eob_is_marked(a)
  _           -> false
}

# A temp takes a slot when it is computed in place and the call needs slots.
fn eob_slotted(a: Expr, slots: Bool) : Bool = slots and eob_is_fresh(a)

#[doc("The positions of the marked arguments computed in place.")]
pub fn eob_fresh(args_e: [Expr]) : [Int] = eob_positions(args_e, true, true, 0)

#[doc("The positions of the marked arguments held in a named temp bound before the call.")]
pub fn eob_bound(args_e: [Expr], slots: Bool) : [Int] = eob_positions(args_e, false, slots, 0)

fn eob_positions(args_e: [Expr], slotted: Bool, slots: Bool, i: Int) : [Int] = match args_e {
  []           -> []
  [a, ...rest] -> {
    let more = eob_positions(rest, slotted, slots, i + 1)
    if eob_is_marked(a) and eob_slotted(a, slots) == slotted { [i, ...more] } else { more }
  }
}

#[doc("The key the named temp of argument `i` is minted under.")]
pub fn eob_key(i: Int) : String = cat2("bc", int_to_string(i))

#[doc("The C name of the named temp of argument `i`.")]
pub fn eob_named_c(i: Int) : String = c_local(ln_implicit(eob_key(i)))

#[doc("The C name of the slot array tagged `tag`.")]
pub fn eob_array(tag: Int) : String = cat2("_obt", int_to_string(tag))

#[doc("The C lvalue of slot `i` of the array tagged `tag`.")]
pub fn eob_slot(tag: Int, i: Int) : String = cat2(eob_array(tag), cat2("[", cat2(int_to_string(i), "]")))

#[doc("The C lvalue a slotted mark `__perceus_owned_borrow(g, tag, slot)` assigns.")]
pub fn eob_slot_of(tag: Expr, slot: Expr) : String = eob_slot(eob_int(tag), eob_int(slot))

fn eob_int(e: Expr) : Int = match e.kind {
  EInt(v, _) -> v
  _          -> 0
}

#[doc("The arguments the call is emitted over: a marked one reads its named temp, or keeps its mark and gains the slot it is assigned to.")]
pub fn eob_call_args(args_e: [Expr], tag: Int, slots: Bool) : [Expr] = eob_call_args_go(args_e, tag, slots, 0)

fn eob_call_args_go(args_e: [Expr], tag: Int, slots: Bool, i: Int) : [Expr] = match args_e {
  []           -> []
  [a, ...rest] -> [eob_call_arg(a, tag, slots, i), ...eob_call_args_go(rest, tag, slots, i + 1)]
}

fn eob_call_arg(a: Expr, tag: Int, slots: Bool, i: Int) : Expr =
  if not eob_is_marked(a) { a }
  else if eob_slotted(a, slots) { eob_with_slot(a, tag, i) }
  else { Expr { ...a, kind: ELocal(local_minted(eob_key(i))) } }

fn eob_with_slot(a: Expr, tag: Int, i: Int) : Expr = match a.kind {
  ECall(mark, [inner]) ->
    Expr { ...a, kind: ECall(mark, [inner, mk_expr(mk_int_synth(tag), a.line, a.col), mk_expr(mk_int_synth(i), a.line, a.col)]) }
  _ -> a
}

#[doc("The C statements releasing every temp after the call.")]
pub fn eob_drops(args_e: [Expr], tag: Int, slots: Bool) : String = eob_drops_go(args_e, tag, slots, 0)

fn eob_drops_go(args_e: [Expr], tag: Int, slots: Bool, i: Int) : String = match args_e {
  []           -> ""
  [a, ...rest] -> string_concat(eob_drop(a, tag, slots, i), eob_drops_go(rest, tag, slots, i + 1))
}

fn eob_drop(a: Expr, tag: Int, slots: Bool, i: Int) : String =
  if not eob_is_marked(a) { "" }
  else if eob_slotted(a, slots) { concat_all(["kai_decref(", eob_slot(tag, i), "); "]) }
  else { concat_all(["kai_decref(", eob_named_c(i), "); "]) }

#[doc("`call` bracketed by a push of the C locals `vars`; unchanged when there are none.")]
pub fn euw_call(call: String, vars: [String]) : String = match vars {
  [] -> call
  _  -> concat_all([euw_push_open("_uwf", vars), "__auto_type _uwr = ", call, "; kai_unw_pop(_uwf); _uwr; })"])
}

#[doc("`call` (a borrowing closure call) bracketed with the closure `clo` registered too, released after it returns.")]
pub fn euw_call_drop(call: String, vars: [String], clo: String) : String =
  concat_all([euw_push_open("_uwf", [clo, ...vars]), "__auto_type _uwr = ", call,
              "; kai_unw_pop(_uwf); kai_decref(", clo, "); _uwr; })"])

fn euw_push_open(f: String, vars: [String]) : String =
  concat_all(["({ KaiFiber *", f, " = kai_unw_push_c(&_uwfb, (KaiValue *[]){", join_with(vars, ", "), "}, ",
              int_to_string(list_length(vars)), "); "])

#[doc("`s` followed by the fiber cache a C function's brackets share; `s` when the frame has no bracket.")]
pub fn euw_with_fiber(bracketed: Bool, s: String) : String =
  if bracketed { cat2(s, "KaiFiber *_uwfb = NULL; (void) _uwfb;\n    ") } else { s }

#[doc("The statement registering slot `lv` (an lvalue) under the fiber local `f`.")]
pub fn euw_slot_push(f: String, lv: String) : String =
  concat_all(["KaiFiber *", f, " = kai_unw_push_c(&_uwfb, &", lv, ", 1); "])

#[doc("The statement registering the C locals `vars` under the fiber local `f`; empty when there are none.")]
pub fn euw_vars_push(f: String, vars: [String]) : String = match vars {
  [] -> ""
  _  -> concat_all(["KaiFiber *", f, " = kai_unw_push_c(&_uwfb, (KaiValue *[]){", join_with(vars, ", "), "}, ",
                    int_to_string(list_length(vars)), "); "])
}

#[doc("The statement registering the `n` slots of the C array `arr` under the fiber local `f`; the slots are read when the frame unwinds.")]
pub fn euw_array_push(f: String, arr: String, n: String) : String =
  concat_all(["KaiFiber *", f, " = kai_unw_push_c(&_uwfb, ", arr, ", ", n, "); "])

#[doc("The statement popping the entry pushed under `f`.")]
pub fn euw_pop(f: String) : String = concat_all(["kai_unw_pop(", f, "); "])
