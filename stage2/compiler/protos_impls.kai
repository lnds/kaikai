#[doc("""
Dispatcher generation, impl method checks, impl heads and lowering of impls to functions.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.util
import compiler.proto_ids
import compiler.resolve_env
import compiler.type_text
import compiler.tparam_uses
import compiler.protos_registry
import compiler.spec_names
import compiler.scope_view
import compiler.proto_resolve
import compiler.scalar_ty
import compiler.diag
import compiler.modules_paths

#[doc("""
Generate one stub-dispatcher DFn per protocol op so the resolver
and typer can treat `op(x, ...)` as a regular polymorphic call.
The body panics; the post-inference rewrite redirects every reach-
able call to the matching `__pimpl_*` function.

Issue #597 boundary tagging: each dispatcher inherits the home
module of the originating DProtocol via `reg.origins`. Root-file
protocols still resolve to `mo = None`, so root-file selfhost
stays byte-identical. Core protocols (the common case in
`stdlib/protocols.kai`) now produce dispatchers tagged with the
core's basename so a cache loader can partition post-cascade
decls back into their original core/user segments.
""")]
pub(pkg) fn generate_dispatchers(reg: ProtocolReg, tab: SymTab) : DispGen =
  generate_dispatchers_loop(reg.ops, reg.tparams, op_arities_from_ops(reg.ops), tab, reg.root,
                            DispGen { decls: [], ids: pid_empty(), rows: [] })

pub(pkg) type DispGen = { decls: [Decl], ids: ProtoIds, rows: [NEnt] }

fn generate_dispatchers_loop(ops: [ProtoOpReg], ptps: [ProtoTPReg], arities: [OpAr], tab: SymTab, root: String,
                                acc: DispGen) : DispGen {
  match ops {
    [] -> acc
    [op, ...rest] -> match op {
      POR(psym, oplbl, params, ret, line, col, mo, op_tps) -> {
        let opname = written_text(oplbl)
        let tps = dispatcher_tparams(psym, proto_scope_tparams(ptps, psym), op_tps, params, ret)
        # An arity-ambiguous op (`f/1` + `f/2`) yields two dispatcher
        # names, so both survive. One dispatcher per (name, home): every
        # protocol of a home declaring the op at that arity shares it,
        # and two modules declaring it each get their own, so a call
        # narrows by receiver among distinct signatures.
        let disp = proto_dispatcher_name_at(arities, opname, list_length(params))
        let dsym = pid_fn_id(disp, mo, root)
        let already = pid_is_disp(acc.ids, dsym)
        let ids = pid_note_disp(acc.ids, disp, opname, mo, list_length(params), psym, root)
        if already { generate_dispatchers_loop(rest, ptps, arities, tab, root, DispGen { decls: acc.decls, ids: ids, rows: acc.rows }) }
        else {
          let pname = written_text(sym_name(tab, psym))
          let stub = make_dispatcher_fn(pname, opname, dsym, tps, params, ret, line, col, mo)
          let open = DispGen { decls: [stub, ...acc.decls], ids: ids,
                               rows: [NEnt(NCFn, disp, proto_home_name(mo, root), true, NmDispatcher), ...acc.rows] }
          generate_dispatchers_loop(rest, ptps, arities, tab, root, with_homed_twin(open, pname, opname, disp, tps, params, ret, line, col, mo, root))
        }
      }
    }
  }
}

# A module's dispatcher gains its homed twin: the same stub under a name
# of its own, which only that module's protocols answer. The root file
# has none: nothing names its dispatchers through a home.
fn with_homed_twin(g: DispGen, pname: String, opname: String, disp: String, tps: [TBinder], params: [Param], ret: TypeExpr,
                   line: Int, col: Int, mo: Option[String], root: String) : DispGen = match mo {
  None    -> g
  Some(_) -> {
    let twin = proto_homed_name(disp)
    let stub = make_dispatcher_fn(pname, opname, pid_fn_id(twin, mo, root), tps, params, ret, line, col, mo)
    DispGen { decls: [stub, ...g.decls], ids: pid_note_homed(g.ids, disp, twin, mo, root),
              rows: [NEnt(NCFn, twin, proto_home_name(mo, root), true, NmDispatcher), ...g.rows] }
  }
}

# The name a dispatcher's homed twin is declared with: the dispatcher's,
# under a prefix of its own.
fn proto_homed_name(disp: String) : String = concat_all(["__homed", disp])

# `dsym` is the dispatcher's id, derived from its arity-resolved name
# (which may carry an `__a<N>` suffix); `opname` is the original op name,
# kept for the dispatch tag so the post-inference rewrite and emit
# resolve the impl by the protocol's true op name.
fn make_dispatcher_fn(pname: String, opname: String, dsym: SymId, tps: [TBinder],
                       params: [Param], ret: TypeExpr, line: Int, col: Int,
                       mo: Option[String]) : Decl {
  let body = make_dispatcher_body(pname, opname, ret, line, col)
  DFn(true, fnid_decl(dsym), tps, params, Some(ret),
      REmpty, body, line, col, mo)
}

# A dispatcher is generic over everything its operation's signature
# mentions: `Self`, the protocol's parameters and the operation's own,
# in the order the signature first uses them. Each ranges over types
# there, whatever kind the protocol gave it, and none is rigid.
fn dispatcher_tparams(psym: SymId, proto_tps: [TBinder], op_tps: [TBinder],
                      params: [Param], ret: TypeExpr) : [TBinder] = {
  let self_b = TBinder { id: tlocal_self(psym), name: written("Self"), kind: KType, bounds: [], implicit: true }
  let scope = [self_b, ...list_append(proto_tps, op_tps)]
  list_append(map(sig_used_binders(scope, params, Some(ret), REmpty),
                  (b) => TBinder { id: b.id, name: b.name, kind: KType, bounds: [], implicit: true }),
              filter(op_tps, tb_is_row))
}

# Synthesises an `ETodo` body tagged `__kai_proto_dispatch__:<P>:<op>`.
# The typer keeps treating the dispatcher as a regular polymorphic fn
# (ETodo is the same magic shape `body_is_ffi_extern` uses for FFI
# shims). When the C / LLVM emit
# encounters this body, it generates a runtime-dispatch shim that
# looks up the matching `__pimpl_*` in the impl-table by
# `(proto_id, head_tag(self))` and tail-calls it — option C from
# `docs/protocols.md`. Post-inference rewrite still redirects every
# monomorphic call site directly to `__pimpl_<P>_<T>_<op>`, so the
# runtime lookup only runs when the type stays polymorphic past mono
# (e.g. inside the body of `impl[T : Show] Show for [T]`).
fn make_dispatcher_body(pname: String, opname: String, ret: TypeExpr,
                          line: Int, col: Int) : Expr =
  proto_mk_dispatch_body(pname, opname, line, col)

type OpAr = OpAr(String, Int)

#[doc("The protocol rung of the resolver's ladder: each operation the registry holds, with its arity, its dispatcher, its protocol's home and whether that protocol is exported.")]
pub(pkg) fn proto_rungs(reg: ProtocolReg) : [ProtoRung] = {
  let ars = op_arities_from_ops(reg.ops)
  map(reg.ops, (op) => match op {
    POR(psym, name, params, _, _, _, mo, _) -> {
      let n = list_length(params)
      let label = written_text(name)
      ProtoRung(label, n, proto_dispatcher_name_at(ars, label, n), mo, psc_is_pub(reg.origins, psym))
    }
  })
}

fn op_arities_from_ops(ops: [ProtoOpReg]) : [OpAr] {
  match ops {
    [] -> []
    [op, ...rest] -> match op {
      POR(_, name, params, _, _, _, _, _) ->
        [OpAr(written_text(name), list_length(params)), ...op_arities_from_ops(rest)]
    }
  }
}

# True when `target` is declared by two protocols at DIFFERENT arities
# (`P { f(x) }` + `Q { f(a, b) }`). A single `__proto_f` dispatcher
# cannot carry two incompatible signatures, so the rename + dispatcher
# generation switch to arity-suffixed names (`__proto_f__a1`) for such
# a name. Same-arity collisions (the common case — `Ring.add` vs
# `Add.add`, both arity 2) keep the unsuffixed `__proto_<op>` and the
# runtime impl-table disambiguates by `head_tag(self)`.
fn op_name_arity_ambiguous(arities: [OpAr], target: String) : Bool =
  op_name_arity_ambiguous_loop(arities, target, -1)

fn op_name_arity_ambiguous_loop(arities: [OpAr], target: String,
                                  seen: Int) : Bool {
  match arities {
    [] -> false
    [a, ...rest] -> match a {
      OpAr(name, ar) ->
        if name == target {
          if seen >= 0 and ar != seen { true }
          else { op_name_arity_ambiguous_loop(rest, target, ar) }
        } else {
          op_name_arity_ambiguous_loop(rest, target, seen)
        }
    }
  }
}

# Dispatcher name for an op call resolved at a known arity. Unsuffixed
# `__proto_<op>` unless the name is arity-ambiguous, in which case the
# arity is appended so the two protocols' ops land on distinct
# dispatchers. Keeping the unsuffixed form for the common case is what
# preserves the selfhost byte-id.
fn proto_dispatcher_name_at(arities: [OpAr], op: String, arity: Int) : String {
  if op_name_arity_ambiguous(arities, op) {
    concat_all(["__proto_", op, "__a", int_to_string(arity)])
  } else {
    proto_dispatcher_name(op)
  }
}

#[doc("The name a derive's diagnostics spell the type `tsym` with.")]
pub(pkg) fn vdv_type_name(ps: PScope, tsym: SymId) : String = written_text(sym_name(ps_tab(ps), tsym))

#[doc("""
What a derive validator reads a field's type with: the scope, and the
file that declares the deriving type (`None` = root file).
""")]
pub(pkg) type VdvCx = { ps: PScope, from: Option[String] }

# A written type head, settled to the declaration it denotes from the
# file homed at `from`: the type its scope reaches, else the core type
# of that name. A scalar and a type parameter have no declaration and
# stay written.
fn vdv_settle(ps: PScope, r: DeclRef, from: Option[String]) : DeclRef = match r {
  DrSym(_)              -> r
  DrWritten(Some(m), n) -> match sv_qualified(ps_tab(ps), NCType, written_text(m), written_text(n)) {
    SvSym(s) -> DrSym(s)
    _        -> r
  }
  DrWritten(None, n) -> match scalar_ty_named(written_text(n)) {
    Some(_) -> r
    None    -> match sv_resolve(ps_tab(ps), ps_view(ps, from), NCType, written_text(n)) {
      SvSym(s) -> DrSym(s)
      SvNone   -> if is_core_type(written_text(n)) { DrSym(core_type_sym(written_text(n))) } else { r }
      _        -> r
    }
  }
}

#[doc("""
Where a type head is read from: the scope, and the home of the file
that wrote it.
""")]
pub(pkg) type HeadScope = HeadScope(PScope, Option[String])

#[doc("""
A type head as a generated symbol spells it. The head is settled from
the file that wrote it first, so the piece is its declaration's emitted
name whether or not a scope pass had settled the reference: the symbol
an impl is declared under and the one a derived body calls agree.
""")]
pub(pkg) fn head_spell(hs: HeadScope, te: TypeExpr) : String = match hs {
  HeadScope(ps, from) -> rt_ref_name(ps_tab(ps), vdv_head(ps, te, from))
}

#[doc("The symbol piece of the declaration the reference `r` denotes in the scope `hs`.")]
pub(pkg) fn head_ref_spell(hs: HeadScope, r: DeclRef) : String = match hs {
  HeadScope(ps, from) -> rt_ref_name(ps_tab(ps), vdv_settle(ps, r, from))
}

#[doc("""
A type body as its file reads it: every head of a field's type settled
to the declaration it denotes there. A type parameter is no head to
settle.
""")]
pub(pkg) fn heads_body(hs: HeadScope, body: TypeBody) : TypeBody = match body {
  TBRecord(fields) -> TBRecord(map(fields, (f) => match f {
    FD(p, name, te, attrs) -> FD(p, name, heads_type(hs, te), attrs)
  }))
  TBSum(variants) -> TBSum(map(variants, (v) => match v {
    Var(c, args) -> Var(c, map(args, (a) => heads_type(hs, a)))
  }))
  _ -> body
}

fn heads_type(hs: HeadScope, te: TypeExpr) : TypeExpr = match te.tkind {
  TyName(r, args) -> {
    let head = match hs { HeadScope(ps, from) -> vdv_settle(ps, r, from) }
    mk_ty(TyName(head, map(args, (a) => heads_type(hs, a))), te.line, te.col)
  }
  TyParam(id, args) -> mk_ty(TyParam(id, map(args, (a) => heads_type(hs, a))), te.line, te.col)
  TyList(elem) -> mk_ty(TyList(heads_type(hs, elem)), te.line, te.col)
  _            -> te
}

#[doc("The single-dispatch head of a type written in the file homed at `from`.")]
pub(pkg) fn vdv_head(ps: PScope, te: TypeExpr, from: Option[String]) : DeclRef = match te.tkind {
  TyName(r, _)      -> vdv_settle(ps, r, from)
  TyList(_)         -> DrSym(core_ty_sym(CtList))
  TyDim(base, _)    -> vdv_head(ps, base, from)
  TyRefine(base, _) -> vdv_head(ps, base, from)
  _                 -> proto_type_ref(te)
}

#[doc("True when `head` is one of the `providers`.")]
pub(pkg) fn vdv_provided(tab: SymTab, providers: [DeclRef], head: DeclRef) : Bool = match providers {
  []           -> false
  [p, ...rest] -> refs_same(tab, p, head) or vdv_provided(tab, rest, head)
}

#[doc("The labels of `ops`, pushed onto `acc` in reverse.")]
pub(pkg) fn proto_op_names(ops: [ProtoOpReg], acc: [String]) : [String] {
  match ops {
    [] -> acc
    [op, ...rest] -> match op {
      POR(_, name, _, _, _, _, _, _) -> proto_op_names(rest, [written_text(name), ...acc])
    }
  }
}

#[doc("Shape 1: every protocol op must have a matching method in the impl.")]
pub(pkg) fn check_missing_methods(tab: SymTab, proto_ops: [ProtoOpReg], methods: [Decl],
                         pname: String, tname: String,
                         all_op_names: [String],
                         file: String, line: Int, col: Int,
                         acc: [Diagnostic]) : [Diagnostic] {
  match proto_ops {
    [] -> acc
    [op, ...rest] -> match op {
      POR(_, oplbl, _, _, _, _, _, _) -> {
        let opname = written_text(oplbl)
        let acc1 =
          if impl_has_method(tab, methods, opname) { acc }
          else {
            [mk_diag(SevError, file, line, col,
               concat_all(["impl `", pname, " for ", tname,
                           "` is missing required method `", opname, "`"]),
               [ri_note(file, line, col,
                  concat_all(["protocol `", pname, "` declares operations: ",
                              proto_join_with(all_op_names, ", ")]))]), ...acc]
          }
        check_missing_methods(tab, rest, methods, pname, tname, all_op_names,
                              file, line, col, acc1)
      }
    }
  }
}

fn impl_has_method(tab: SymTab, methods: [Decl], opname: String) : Bool {
  match methods {
    [] -> false
    [d, ...rest] -> match d {
      DFn(_, fid, _, _, _, _, _, _, _, _) ->
        if impl_method_op(tab, fid) == opname { true } else { impl_has_method(tab, rest, opname) }
      _ -> impl_has_method(tab, rest, opname)
    }
  }
}

#[doc("The operation of `ops` labelled `target`.")]
pub(pkg) fn find_proto_op(ops: [ProtoOpReg], target: String) : Option[ProtoOpReg] {
  match ops {
    [] -> None
    [op, ...rest] -> match op {
      POR(_, name, _, _, _, _, _, _) ->
        if op_label_is(name, target) { Some(op) } else { find_proto_op(rest, target) }
    }
  }
}

#[doc("""
Compare an impl signature against the protocol's. `Self` in the
protocol substitutes to the impl target; each protocol tparam `Ai`
substitutes to `arg_heads[i]` (or the target when `arg_heads == []`,
the homogeneous default per the lower_impls rule). `tname` is the
target's head as a diagnostic shows it. Parameters are
compared structurally, so two instantiations of one constructor are
distinguished; the return below compares head names only, except a
function type, which has no meaningful head and compares structurally.
Unannotated impl params (`ptype == None`) are not checked — the
typer infers them; a pre-typer pass has no signal to compare against.
`shown` holds every type parameter either signature may mention, for
the diagnostics.
""")]
pub(pkg) fn check_sig_heads(tab: SymTab, impl_params: [Param], proto_params: [Param],
                   impl_ret_opt: Option[TypeExpr], proto_ret: TypeExpr,
                   op_name: String, pname: String, tname: String,
                   target: TypeExpr,
                   proto_tps: [TBinder], arg_heads: [DeclRef], shown: [TBinder],
                   file: String, line: Int, col: Int,
                   acc: [Diagnostic]) : [Diagnostic] {
  let e_params = check_sig_param_heads(tab, impl_params, proto_params, tname, target,
                                        proto_tps, arg_heads, shown,
                                        op_name, pname, file, acc)
  # Return-type check applies only when the impl is homogeneous w.r.t.
  # the protocol's tparams. Heterogeneous impls (`impl P[Other] for T`
  # with Other != T) often produce a *promoted* result type that the
  # protocol's `Self` return cannot express — stdlib's
  # `impl Add[Complex] for Real { fn add(...) : Complex }` is the
  # canonical case. Validating the return there requires a protocol-
  # level `Result` tparam or HKT, both out of scope for v1. The
  # parameter-position checks above still catch genuine signature
  # drift (wrong `self`/`rhs` types) — the leak here is only when
  # the impl rewrites the return shape for a known good reason.
  if heterogeneous_impl(tab, arg_heads, proto_type_ref(target)) { e_params }
  else { match impl_ret_opt {
    None -> e_params
    Some(impl_ret) -> {
      let ok = match proto_ret.tkind {
        TyFn(_, _, _) -> sig_type_matches(tab, impl_ret, sig_subst(proto_ret, target, proto_tps, arg_heads))
        _ ->
          if sig_free_param(proto_ret, proto_tps) { sig_free_param(impl_ret, []) }
          else { refs_same(tab, proto_type_ref(impl_ret), sig_head_subst(proto_ret, target, proto_tps, arg_heads)) }
      }
      if ok { e_params }
      else {
        [proto_err(file, line, col,
           concat_all(["impl method `", op_name, "` in `", pname, " for ", tname,
                       "` returns `", type_text_in(tab, shown, impl_ret),
                       "` but protocol declares return type `",
                       sig_ret_display(tab, proto_ret, target, proto_tps, arg_heads, shown), "`"])),
         ...e_params]
      }
    }
  } }
}

# A parameter the impl head settles nothing about: one of the op's own,
# which any parameter of the impl method answers.
fn sig_free_param(t: TypeExpr, proto_tps: [TBinder]) : Bool = match t.tkind {
  TyParam(id, _) -> not tlocal_is_self(id) and not tbs_has(proto_tps, id)
  _              -> false
}

fn sig_ret_display(tab: SymTab, t: TypeExpr, target: TypeExpr,
                   proto_tps: [TBinder], arg_heads: [DeclRef], shown: [TBinder]) : String =
  match t.tkind {
    TyFn(_, _, _) -> type_text_in(tab, shown, sig_subst(t, target, proto_tps, arg_heads))
    _ ->
      if sig_free_param(t, proto_tps) { type_text_in(tab, shown, t) }
      else { ref_text(tab, sig_head_subst(t, target, proto_tps, arg_heads)) }
  }

# An impl is heterogeneous iff it carries explicit bracket args and
# at least one of them differs from the target head. Legacy un-
# parametrised impls (`arg_heads == []`) are homogeneous by
# definition. Same-as-target args (`impl Add[Complex] for Complex`)
# round-trip through the homogeneous default, so they are not
# heterogeneous either.
fn heterogeneous_impl(tab: SymTab, arg_heads: [DeclRef], target: DeclRef) : Bool {
  match arg_heads {
    [] -> false
    [h, ...rest] -> if not refs_same(tab, h, target) { true } else { heterogeneous_impl(tab, rest, target) }
  }
}

fn check_sig_param_heads(tab: SymTab, impl_ps: [Param], proto_ps: [Param], tname: String,
                         target: TypeExpr,
                         proto_tps: [TBinder], arg_heads: [DeclRef], shown: [TBinder],
                         op_name: String, pname: String,
                         file: String, acc: [Diagnostic]) : [Diagnostic] {
  match impl_ps {
    [] -> acc
    [ip, ...irest] -> match proto_ps {
      [] -> acc
      [pp, ...prest] -> {
        let acc1 = match ip.ptype {
          None -> acc
          Some(it) -> match pp.ptype {
            None -> acc
            Some(pt) -> {
              let ps = sig_subst(pt, target, proto_tps, arg_heads)
              if sig_type_matches(tab, it, ps) { acc }
              else {
                [proto_err(file, ip.pline, ip.pcol,
                   concat_all(["impl method `", op_name, "` in `", pname, " for ", tname,
                               "`: parameter `", written_text(ip.binder.name),
                               "` has type `", type_text_in(tab, shown, it),
                               "` but protocol declares `", type_text_in(tab, shown, ps), "`"])), ...acc]
              }
            }
          }
        }
        check_sig_param_heads(tab, irest, prest, tname, target,
                              proto_tps, arg_heads, shown,
                              op_name, pname, file, acc1)
      }
    }
  }
}

#[doc("""
Walk every DImpl and (a) lower its methods into top-level DFns,
(b) record (P, T) -> impl fn in the registry. The fn body is
the impl's original body verbatim; the function is declared anew
under its impl symbol and the typer does its work on the result.
""")]
pub(pkg) fn lower_impls(ds: [Decl], reg: ProtocolReg, ps: PScope, acc_fns: [Decl]) : LowerImplsRes =
  lower_impls_loop(ds, ps, LowerImplsRes { reg: reg, fns: acc_fns, rows: [] })

fn lower_impls_loop(ds: [Decl], ps: PScope, acc: LowerImplsRes) : LowerImplsRes {
  match ds {
    [] -> LowerImplsRes { reg: acc.reg, fns: list_reverse(acc.fns), rows: list_reverse(acc.rows) }
    [d, ...rest] -> match d {
      DImpl(pref, proto_args, target, methods, _, _, _, isym) -> {
        let tab = ps_tab(ps)
        let pname = dotted_bare(proto_ref_spell(tab, pref))
        # The impl's dispatch key: resolve the head from the impl's own
        # module, then spell it. Unresolved protocols keep the bare
        # name — `validate_impls` has already reported them.
        let from = impl_home_of(methods)
        let psym = proto_ref_sym(ps, pref, from)
        # No protocol argument is the legacy form, `Ai = Self`.
        let head = ImplHead { key: proto_key_of(acc.reg.dkeys, pname, psym), proto: psym,
                              tname: head_spell(HeadScope(ps, from), target), target: proto_type_ref(target),
                              arg_names: map(proto_args, (a) => head_spell(HeadScope(ps, from), a)),
                              args: map(proto_args, proto_type_ref), home: from }
        lower_impls_loop(rest, ps, lower_impl_methods(tab, ps_root(ps), head, methods, acc))
      }
      DDerive(_, inner, _, _) -> lower_impls_loop([inner, ...rest], ps, acc)
      DUnstable(inner, _, _) -> lower_impls_loop([inner, ...rest], ps, acc)
      DProtoLaws(_, inner, _, _, _) -> lower_impls_loop([inner, ...rest], ps, acc)
      DImplAxiom(_, inner, _, _, _) -> lower_impls_loop([inner, ...rest], ps, acc)
      DConstructor(inner, _, _) -> lower_impls_loop([inner, ...rest], ps, acc)
      _ -> lower_impls_loop(rest, ps, acc)
    }
  }
}

#[doc("""
The module an impl block lives in, read off its first method's
origin stamp (the cascade tags every method with the enclosing
module; root-file methods carry none).
""")]
pub(pkg) fn impl_home_of(methods: [Decl]) : Option[String] =
  match methods {
    [] -> None
    [d, ...rest] -> match d {
      DFn(_, _, _, _, _, _, _, _, _, mo) -> mo
      _ -> impl_home_of(rest)
    }
  }

pub(pkg) type LowerImplsRes = { reg: ProtocolReg, fns: [Decl], rows: [NEnt] }

# What one impl block gives each of its methods. `key` is the protocol's
# dispatch key, the piece an impl symbol spells, not necessarily the
# surface name; `proto` is that protocol's identity, which decides whose
# impl an entry is. `tname` and `arg_names` are the symbol's type pieces,
# `target` and `args` the references the registry files.
type ImplHead = { key: String, proto: SymId, tname: String, target: DeclRef,
                  arg_names: [String], args: [DeclRef], home: Option[String] }

# `acc` accumulates in reverse; the caller list_reverses on return.
fn lower_impl_methods(tab: SymTab, root: String, head: ImplHead, methods: [Decl],
                      acc: LowerImplsRes) : LowerImplsRes {
  match methods {
    [] -> acc
    [d, ...rest] -> match d {
      DFn(_, fid, tparams, params, ret, row, body, line, col, mo) -> {
        let op_name = impl_method_op(tab, fid)
        # Issue #180: only the heterogeneous case (Ai != Self) augments
        # the mangled name. The default-Self form keeps the legacy
        # mangling so `impl Add for Complex` and `impl Add[Complex] for
        # Complex` produce the same impl-fn name.
        let mangled = proto_impl_mangled_with_args(head.key, head.tname, op_name, head.arg_names)
        let fsym = pid_fn_id(mangled, mo, root)
        let new_fn = DFn(false, fnid_decl(fsym), tparams, params, ret, row, body, line, col, mo)
        let ret_head = match ret { Some(rte) -> proto_type_ref(rte)  None -> head.target }
        let entry = PIR(head.proto, head.target, written(op_name), fsym, head.args, ret_head, head.home)
        let reg = acc.reg
        let reg1 = ProtocolReg {
          ops: reg.ops,
          impls: [entry, ...reg.impls],
          op_names: reg.op_names,
          tparams: reg.tparams,
          origins: reg.origins,
          dkeys: reg.dkeys,
          impl_index: reg.impl_index,
          cores: reg.cores, imports: reg.imports, root: reg.root, ids: reg.ids
        }
        lower_impl_methods(tab, root, head, rest,
                           LowerImplsRes { reg: reg1, fns: [new_fn, ...acc.fns],
                                           rows: [NEnt(NCFn, mangled, proto_home_name(mo, root), false, NmImpl), ...acc.rows] })
      }
      _ -> lower_impl_methods(tab, root, head, rest, acc)
    }
  }
}
