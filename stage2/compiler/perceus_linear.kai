#[doc("""
Linearity of a binder: its branch-aware read paths, self tail calls and the borrow-aware variant.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.marks
import compiler.ret_slots
import compiler.expr_positions
import compiler.perceus_payer
import compiler.perceus_borrow
import compiler.borrow_infer
import compiler.perceus_reads
import compiler.symtab
import compiler.perceus_lend
import compiler.perceus_exit_drops
import compiler.trmc_self_call
import compiler.ast_map
import compiler.anf_ops

# Issue #599 — branch-aware max-path count for a single name in a
# function body. Returns the maximum number of non-lambda reads of
# `nm` on ANY linear execution path through the body, taking the max
# over `EMatch` arms and `EIf` branches (mutually-exclusive sites)
# and the sum over sequential composition (`EBlock`, `ECall` args,
# `EBinop`, …).
#
# When the result is <= 1 the binding is read at most once on every
# path, so the conservative-dup wrap can be skipped: the last (and
# only) read on the executed path can transfer ownership raw.
#
# Lambdas contribute 0 because closure captures are RC'd separately
# via `kai_closure`'s incref; this matches the in_lam-skip convention
# of `pcs_count_non_lam_uses` and keeps the rule sound for
# LUBlocked bindings.
#
# This function is read-only and pure (no Console effect needed) so
# it can be called from any rewrite site without threading a new
# parameter through every `pcs_rewrite_*` helper. It is invoked
# lazily from `pcs_is_non_last` only for top-level fn params; per-fn
# bodies are small enough that the O(body-size) walk per param is
# cheap compared with the rest of the perceus pass.
# Back-compat wrapper: the borrow-unaware count (used by the params path
# and other call sites that have no borrow map in scope).
pub(pkg) fn pcs_max_paths_in_expr(nm: Binder, e: Expr) : Int =
  pcs_max_paths_b_expr(nm, e, bm_empty())

# Compute the branch-aware skip-set for a fn body: every top-level
# fn param whose reads can safely transfer ownership raw on every
# execution path. The three conditions for safety:
#
#   1. `pcs_max_paths_in_expr <= 1` — the binding is read at most
#      once on any single execution path (no path doubles a wrap).
#   2. `pcs_consumed_on_every_path` — every path through the body
#      actually consumes the binding (no exit-drop needed; the
#      single read on the executed path transfers ownership).
#   3. `pcs_all_consumers_linear` — every consumer of the binding
#      is a linear consumer: a call to a user-defined fn (which
#      pcs_pass made linear by construction) or a variant/record
#      that owns the slot. Non-linear consumers (intrinsics,
#      capability ops, raw field access on a borrowed record)
#      internally incref their arg, and a raw transfer would leak or
#      double-free.
pub(pkg) fn pcs_branch_aware_skip_params(pnames: [Binder], body: Expr,
                                    bmap: BorrowMap) : [Binder] = match pnames {
  []           -> []
  [h, ...rest] -> {
    # Borrowed reads still count here: the branch planter assumes one read
    # per path, and a lent read ahead of the move is a second one.
    let rest_skip = pcs_branch_aware_skip_params(rest, body, bmap)
    if pcs_param_moves_raw(h, body, bmap) { [h, ...rest_skip] } else { rest_skip }
  }
}

# Each condition walks the body, so a failing one spares the rest.
fn pcs_param_moves_raw(h: Binder, body: Expr, bmap: BorrowMap) : Bool =
  pcs_max_paths_in_expr(h, body) <= 1 and pcs_param_consumed_linear(h, body, bmap)

fn pcs_param_consumed_linear(h: Binder, body: Expr, bmap: BorrowMap) : Bool =
  pcs_consumed_b_expr(h, body, bmap) and pcs_all_consumers_linear(h, body)

# A param read twice on some path that every path hands over at one owning
# read, after its lends. `held` names the params that hold no reference.
fn pcs_param_lends_then_moves(h: Binder, body: Expr, uses: UseIx, held: [Binder], bmap: BorrowMap) : Bool =
  not pcs_has(held, h.id) and not pcs_uses_have_in_lam(uses, h.id) and
  pcs_lends_end_first(h, body, bmap) and
  pcs_all_consumers_linear(h, body) and
  pcs_consumed_b_expr(h, body, bmap)

pub(pkg) fn pcs_params_moved_raw(pnames: [Binder], body: Expr, uses: UseIx, bmap: BorrowMap, held: [Binder]) : [Binder] =
  filter(pnames, (h) => pcs_param_moves(h, body, uses, bmap, held))

fn pcs_param_moves(h: Binder, body: Expr, uses: UseIx, bmap: BorrowMap, held: [Binder]) : Bool =
  if pcs_max_paths_in_expr(h, body) <= 1 { pcs_param_consumed_linear(h, body, bmap) }
  else { pcs_param_lends_then_moves(h, body, uses, held, bmap) }

pub(pkg) fn pcs_all_consumers_linear(nm: Binder, e: Expr) : Bool =
  pcs_consumers_linear_kind(nm, e.kind)

fn pcs_consumers_linear_kind(nm: Binder, k: ExprKind) : Bool = match k {
  ELocal(_)           -> true   # a bare read is "in linear position"
  ESym(_, _)          -> true
                                 # — it's either the body's tail (return
                                 # transfer, linear), or recursed into
                                 # from an arg/field that already classified
                                 # the call/ctor as linear or not.
  EStr(_, _)          -> true
  ECall(f, xs)        -> pcs_call_consumers_linear(nm, f, xs)
  EIntrinsic(_, xs)   -> {
    # Intrinsics are runtime primitives — non-linear if `nm` appears
    # as an arg.
    if pcs_any_arg_is_var(nm.id, xs) { false }
    else { pcs_all_args_consumers_linear(nm, xs) }
  }
  EField(x, _)        -> {
    # Field access reads the record raw and incref's the field.
    # If `nm == x` (bare ref), this is non-linear (borrow-only on nm).
    match x.kind {
      ELocal(u) -> not local_eq(u, nm.id)    # bare `nm.field` = borrow → false
      _         -> pcs_all_consumers_linear(nm, x)
    }
  }
  EIndex(a, b)        -> {
    # Same as EField: index borrows the array.
    let a_ok = match a.kind {
      ELocal(u) -> not local_eq(u, nm.id)
      _         -> pcs_all_consumers_linear(nm, a)
    }
    a_ok and pcs_all_consumers_linear(nm, b)
  }
  EMatch(s, arms)     -> {
    # The scrutinee is consumed by `match` (kai_decref at end of
    # the match block). A bare read of `nm` as scrutinee is therefore
    # linear; but if `nm` appears INSIDE the scrutinee expression
    # (e.g. `match opts.path { ... }`), we recurse.
    let s_ok = pcs_is_leaf_ref(s) or pcs_all_consumers_linear(nm, s)   # a bare scrutinee is linear by match semantics
    s_ok and pcs_consumers_linear_arms(nm, arms)
  }
  EList(els)          -> pcs_consumers_linear_elems(nm, els)
  # Everything else checks its inline positions; deferred bodies
  # (lambda closures, handler clauses) are handled separately.
  _ -> pcs_consumers_linear_ps(nm, xp_positions_kind(k))
}

fn pcs_consumers_linear_ps(nm: Binder, ps: [XPos]) : Bool = match ps {
  []                  -> true
  [XP(r, c), ...rest] ->
    (not xrole_inline(r) or pcs_all_consumers_linear(nm, c)) and
    pcs_consumers_linear_ps(nm, rest)
}

# Check whether a call expression `f(xs...)` with `nm` possibly
# appearing as an arg is linear-safe. Rules:
#   - If callee `f` is an RC mark → non-linear (an RC primitive should
#     never see a skipped read).
#   - If callee `f` is a bare name, treat as user-defined linear fn.
#   - If callee is anything else (EField on capability, intrinsic,
#     apply on closure value), assume non-linear unless `nm` does
#     not appear in args.
# A bare callee needs no "does an arg mention `nm`" pre-pass: an arg that
# never reads `nm` is linear for it by construction, so the arg walk
# alone answers. That pre-pass re-walked every arg at every call level.
fn pcs_call_consumers_linear(nm: Binder, f: Expr, xs: [Expr]) : Bool = match f.kind {
  # A primitive mark consumes its arguments like a named function.
  EMark(m) -> if pcs_is_rc_primitive(m) { not pcs_any_arg_mentions(nm, xs) }
              else if mark_is_prim(m) { pcs_all_args_consumers_linear(nm, xs) }
              else { pcs_call_consumers_linear_via(nm, f, xs) }
  _        -> if pcs_callee_is_ref(f) { pcs_all_args_consumers_linear(nm, xs) }
              else { pcs_call_consumers_linear_via(nm, f, xs) }
}

fn pcs_call_consumers_linear_via(nm: Binder, f: Expr, xs: [Expr]) : Bool = {
  let nm_in_args = pcs_any_arg_is_var(nm.id, xs) or pcs_any_arg_mentions(nm, xs)
  if not nm_in_args {
    # `nm` only appears inside the callee expression (rare); recurse.
    pcs_all_consumers_linear(nm, f)
  } else {
    # On a post-perceus body the callee may be wrapped in a dup
    # (`step(initial, ev1)` becomes `(dup(step))(initial, ev1)`). Look
    # through the wrap so the linearity analysis matches the pre-perceus
    # body: a param that qualifies for the skip set in one view and not
    # the other gets a goto-block drop without the matching dup.
    let effective_f = pcs_strip_dup_wrap(f)
    # A call of a reference is linear by construction: a fn consumes its
    # slots, a constructor owns them. `nm` must not also appear in the
    # callee. A call through anything else is assumed non-linear.
    if pcs_callee_is_ref(effective_f) {
      pcs_all_consumers_linear(nm, effective_f) and pcs_all_args_consumers_linear(nm, xs)
    } else { false }
  }
}

# Recurse into each arg.
fn pcs_all_args_consumers_linear(nm: Binder, xs: [Expr]) : Bool = match xs {
  []           -> true
  [h, ...rest] -> pcs_all_consumers_linear(nm, h) and
                   pcs_all_args_consumers_linear(nm, rest)
}

# The RC marks the linearity analysis treats as non-linear consumers.
fn pcs_is_rc_primitive(m: Mark) : Bool = match m {
  MkDup -> true
  _     -> mark_is_reuse(m)
}

fn pcs_consumers_linear_arms(nm: Binder, arms: [Arm]) : Bool = match arms {
  []           -> true
  [a, ...rest] -> match a {
    Arm(_, opt_g, body) -> {
      let gp = match opt_g {
        None    -> true
        Some(g) -> pcs_all_consumers_linear(nm, g)
      }
      gp and pcs_all_consumers_linear(nm, body) and
      pcs_consumers_linear_arms(nm, rest)
    }
  }
}

fn pcs_consumers_linear_elems(nm: Binder, els: [ListElem]) : Bool = match els {
  []           -> true
  [h, ...rest] -> {
    let e = match h { ElPlain(x) -> x ElSpread(x) -> x }
    pcs_all_consumers_linear(nm, e) and pcs_consumers_linear_elems(nm, rest)
  }
}

pub(pkg) fn pcs_consumed_b_expr(nm: Binder, e: Expr, bmap: BorrowMap) : Bool = match e.kind {
  ELocal(u)        -> local_eq(u, nm.id)
  EIf(c, t, opt_e) -> {
    if pcs_consumed_b_expr(nm, c, bmap) { true }
    else {
      match opt_e {
        None    -> false   # missing-else path leaves the binding alive
        Some(e2) -> pcs_consumed_b_expr(nm, t, bmap) and
                    pcs_consumed_b_expr(nm, e2, bmap)
      }
    }
  }
  EMatch(s, arms)  -> {
    if pcs_consumed_b_expr(nm, s, bmap) { true }
    else { pcs_consumed_b_arms(nm, arms, bmap) }
  }
  ECall(f, xs)     -> {
    if pcs_consumed_b_expr(nm, f, bmap) { true }
    else { pcs_consumed_b_args(nm, xs, pcs_lent_slots(nm.id, f, xs, bmap), 0, bmap) }
  }
  _                -> pcs_consumed_b_ps(nm, xp_positions(e), bmap)
}

# A bare `nm` in a borrowed slot is a borrow, not a consumer; any other
# slot keeps the owned reading. Sub-expressions are scanned either way.
fn pcs_consumed_b_args(nm: Binder, xs: [Expr], positions: [Int], i: Int,
                       bmap: BorrowMap) : Bool = match xs {
  []           -> false
  [a, ...rest] -> {
    let here = if pcs_has_int(positions, i) {
      if pcs_is_leaf_ref(a) { false } else { pcs_consumed_b_expr(nm, a, bmap) }
    } else { pcs_consumed_b_expr(nm, a, bmap) }
    here or pcs_consumed_b_args(nm, rest, positions, i + 1, bmap)
  }
}

fn pcs_consumed_b_ps(nm: Binder, ps: [XPos], bmap: BorrowMap) : Bool = match ps {
  []                  -> false
  [XP(r, c), ...rest] ->
    (match r { XAll -> pcs_consumed_b_expr(nm, c, bmap) _ -> false }) or
    pcs_consumed_b_ps(nm, rest, bmap)
}

fn pcs_consumed_b_arms(nm: Binder, arms: [Arm], bmap: BorrowMap) : Bool = match arms {
  []           -> true   # no arms = no paths = vacuously consumed
                          # (but EMatch with zero arms is invalid anyway)
  [a, ...rest] -> match a {
    Arm(_, _, body) ->
      pcs_consumed_b_expr(nm, body, bmap) and pcs_consumed_b_arms(nm, rest, bmap)
  }
}

pub(pkg) fn pcs_owned_scope_move_params(pnames: [Binder], body: Expr, skip: [Binder],
                                bmap: BorrowMap, cmap: ConsumeIndex, borrowed: [Binder], tab: SymTab) : [Binder] =
  match pnames {
    [] -> []
    [p, ...rest] -> {
      let rest_sel = pcs_owned_scope_move_params(rest, body, skip, bmap, cmap, borrowed, tab)
      if pcs_has(skip, p.id) { rest_sel }
      else {
        if pcs_owned_param_moves(p, body, bmap, cmap, tab) { [p, ...rest_sel] } else { rest_sel }
      }
    }
  }

# The narrow-shape check for condition 4+5: `body` must be a top-level match
# (peeling the exit wrap) whose scrutinee omits `p`, and every arm either
# reads `p` zero times or consumes it exactly once with no guard read.
fn pcs_param_arms_move_safe(p: Binder, body: Expr) : Bool =
  match pcs_peel_ret_wrap(body).kind {
    EMatch(scr, arms) ->
      not pcs_name_in_expr(p, scr) and pcs_param_each_arm_move_safe(p, arms)
    _ -> false
  }

fn pcs_param_each_arm_move_safe(p: Binder, arms: [Arm]) : Bool = match arms {
  []           -> true
  [a, ...rest] -> match a {
    Arm(_, opt_g, body) -> {
      let guard_reads = match opt_g { None -> false Some(g) -> pcs_name_in_expr(p, g) }
      let n = pcs_max_paths_in_expr(p, body)
      let arm_ok = not guard_reads and (n == 0 or n == 1)
      arm_ok and pcs_param_each_arm_move_safe(p, rest)
    }
  }
}

fn pcs_owned_param_moves(p: Binder, body: Expr, bmap: BorrowMap, cmap: ConsumeIndex, tab: SymTab) : Bool =
  pcs_max_paths_b_expr(p, body, bmap) <= 1 and
  pcs_all_consumers_linear(p, body) and
  pcs_uses_only_consuming_slots(p, body, cmap, bm_empty(), tab) and
  pcs_param_arms_move_safe(p, body) and
  pbl_plantable(p, body)

# Peel the `EBlock([SLet(__pcs_ret, m), ...drops], Some(__pcs_ret))` exit wrap
# so the top-level match is visible. No wrap ⇒ returns `body` unchanged.
fn pcs_peel_ret_wrap(body: Expr) : Expr = match body.kind {
  EBlock(stmts, _) -> match stmts {
    [SLet(pat, _, rhs), ..._] -> match pat.pkind {
      PBind(b) -> if ret_slot_id_is_fn(b.id) { rhs } else { body }
      _         -> body
    }
    _ -> body
  }
  _ -> body
}

fn pcs_bmlp_loop(self_name: SelfRef, pnames: [Binder], body: Expr, uses: UseIx,
                 bmap: BorrowMap, borrowed: [Binder], skip_set: [Binder]) : [Binder] / Console = match pnames {
  []           -> []
  [nm, ...rest] -> {
    let more = pcs_bmlp_loop(self_name, rest, body, uses, bmap, borrowed, skip_set)
    if pcs_has(borrowed, nm.id) or pcs_has(skip_set, nm.id) { more }
    else {
      match last_use_for(nm.id, uses) {
        LuAt(_, _) ->
          if pcs_read_count(nm.id, uses) >= 2 and
             pcs_max_paths_b_expr(nm, body, bmap) == 1 and
             pcs_nm_absent_from_nonrec_tails(self_name, nm, body, bmap) {
            [nm, ...more]
          } else { more }
        _ -> more
      }
    }
  }
}

# True iff `nm` appears in no tail position that is not a self-call —
# i.e. every base arm is `nm`-free. A tail self-call is skipped (that is
# where the re-thread lives); any other tail is scanned for `nm`.
# A block whose tail has a base path is a base path: its STATEMENTS must
# be `nm`-free too — a read there (an operator operand, a consuming call)
# takes a ref while the exit wrap still drops `nm` on that path, two
# releases of one. Statements ahead of a tail that re-threads on every
# path stay allowed: they are the discounted prefix of the re-thread.
fn pcs_nm_absent_from_nonrec_tails(self_name: SelfRef, nm: Binder, e: Expr, bmap: BorrowMap) : Bool / Console =
  pcs_nmant_kind(self_name, nm, e.kind, bmap)

fn pcs_nmant_kind(self_name: SelfRef, nm: Binder, k: ExprKind, bmap: BorrowMap) : Bool / Console = match k {
  # A base-path call may lend `nm` to a borrowed slot: that read takes no ref.
  ECall(f, _) -> is_self_callee(f, self_name) or pcs_max_paths_b_expr(nm, mk_expr(k, 0, 0), bmap) == 0
  # The condition evaluates on EVERY path through the if, including the
  # base ones: a CONSUMING read of `nm` there spends the ref the exit
  # wrap still drops. A borrow-discounted read (a borrowed callee slot,
  # e.g. the vec-length probe a Vec match desugars to) keeps no ref and
  # stays allowed — the max-path count with `bmap` charges only real
  # consumers.
  EIf(c, t, opt_e) ->
    pcs_max_paths_b_expr(nm, c, bmap) == 0 and
    pcs_nm_absent_from_nonrec_tails(self_name, nm, t, bmap) and
    (match opt_e { None -> true Some(e2) -> pcs_nm_absent_from_nonrec_tails(self_name, nm, e2, bmap) })
  # The scrutinee is part of the tail: `match consume(nm) { ... }` in a base
  # tail spends the ref the exit wrap still drops.
  EMatch(s, arms) -> not pcs_name_in_expr(nm, s) and
                      pcs_nmant_arms(self_name, nm, arms, bmap)
  EBlock(stmts, opt_tail) -> match opt_tail {
    None    -> not pcs_name_in_stmts(nm, stmts)
    Some(t) ->
      if ppd_all_tails_self_call(t, self_name) { pcs_nm_absent_from_nonrec_tails(self_name, nm, t, bmap) }
      else { not pcs_name_in_stmts(nm, stmts) and pcs_nm_absent_from_nonrec_tails(self_name, nm, t, bmap) }
  }
  # Every other form has no self-call carve-out: the whole node is
  # base-path material, so the derivation holds only when a whole-node
  # scan (riding the position table via the use collector) finds no
  # read of `nm`. Conservative for any new variant: a read anywhere
  # simply withholds the optimisation.
  _ -> not pcs_mentions(nm, mk_expr(k, 0, 0))
}

fn pcs_name_in_stmts(nm: Binder, stmts: [Stmt]) : Bool / Console =
  pcs_mentions(nm, mk_expr(EBlock(stmts, None), 0, 0))

# A guard evaluates before its arm is chosen — a consuming read of `nm`
# there lands on base paths too; borrow-discounted reads stay allowed.
fn pcs_nmant_arms(self_name: SelfRef, nm: Binder, arms: [Arm], bmap: BorrowMap) : Bool / Console = match arms {
  []           -> true
  [Arm(_, opt_g, b), ...rest] ->
    (match opt_g { None -> true Some(g) -> pcs_max_paths_b_expr(nm, g, bmap) == 0 }) and
    pcs_nm_absent_from_nonrec_tails(self_name, nm, b, bmap) and pcs_nmant_arms(self_name, nm, rest, bmap)
}

fn pcs_max_paths_b_expr(nm: Binder, e: Expr, bmap: BorrowMap) : Int =
  pcs_max_paths_b_kind(nm, e.kind, bmap)

fn pcs_max_paths_b_kind(nm: Binder, k: ExprKind, bmap: BorrowMap) : Int = match k {
  ELocal(u)           -> if local_eq(u, nm.id) { 1 } else { 0 }
  ECall(f, xs)        -> {
    # Discount args that land in a borrowed slot of the callee: those uses
    # of `nm` are borrows, not consumers, and do not count. The slots are
    # looked up only for a call that takes `nm` bare.
    let positions = if pcs_any_arg_bare(nm.id, xs) { pcs_borrow_slots(bmap, f) } else { [] }
    pcs_max_paths_b_expr(nm, f, bmap) + pcs_max_paths_b_args(nm, xs, positions, 0, bmap)
  }
  # Branch positions are alternatives of each other — the count takes
  # the MAX across them — which the flat position list cannot express;
  # both keep explicit arms.
  EIf(c, t, opt_e)    -> pcs_max_paths_b_expr(nm, c, bmap) +
                          pcs_max_paths_b_alt2(nm, t, opt_e, bmap)
  EMatch(s, arms)     -> pcs_max_paths_b_expr(nm, s, bmap) +
                          pcs_max_paths_b_arms(nm, arms, 0, bmap)
  # Everything else sums its inline positions; a lambda body contributes
  # 0 (closure captures are RC'd separately).
  _ -> pcs_max_paths_b_ps(nm, xp_positions_kind(k), bmap)
}

fn pcs_max_paths_b_ps(nm: Binder, ps: [XPos], bmap: BorrowMap) : Int = match ps {
  []                  -> 0
  [XP(r, c), ...rest] ->
    (match r { XLam -> 0 _ -> pcs_max_paths_b_expr(nm, c, bmap) }) +
    pcs_max_paths_b_ps(nm, rest, bmap)
}

# Walk args, charging 0 for any arg whose index is a borrowed slot of the
# callee (the use is a borrow, not a consume). The discount applies ONLY
# to a bare-var arg (`is_red(l)`), seen through a unit coercion, which is
# identity at runtime: the callee borrows `l` itself. A
# compound arg (`origin_eq(home_tu(d), mo)` slot 0) consumes its interior
# reads while EVALUATING the arg — the callee borrows only the resulting
# value — so those reads must count in full; discounting them starves the
# dup insertion and the inner call frees the binder's only ref.
fn pcs_max_paths_b_args(nm: Binder, es: [Expr], positions: [Int], i: Int, bmap: BorrowMap) : Int = match es {
  []           -> 0
  [h, ...rest] -> {
    let bare = pcs_is_leaf_ref(prc_peel_unit(h))
    let here = if pcs_has_int(positions, i) and bare { 0 }
               else { pcs_max_paths_b_expr(nm, h, bmap) }
    here + pcs_max_paths_b_args(nm, rest, positions, i + 1, bmap)
  }
}

fn pcs_max_paths_b_alt2(nm: Binder, t: Expr, opt_e: Option[Expr], bmap: BorrowMap) : Int = {
  let tp = pcs_max_paths_b_expr(nm, t, bmap)
  let ep = match opt_e { None -> 0 Some(e) -> pcs_max_paths_b_expr(nm, e, bmap) }
  if tp > ep { tp } else { ep }
}

fn pcs_max_paths_b_arms(nm: Binder, arms: [Arm], best: Int, bmap: BorrowMap) : Int = match arms {
  [] -> best
  [a, ...rest] -> match a {
    Arm(_, opt_g, body) -> {
      let gp = match opt_g { None -> 0 Some(g) -> pcs_max_paths_b_expr(nm, g, bmap) }
      let bp = pcs_max_paths_b_expr(nm, body, bmap)
      let armp = gp + bp
      let nb = if armp > best { armp } else { best }
      pcs_max_paths_b_arms(nm, rest, nb, bmap)
    }
  }
}

pub(pkg) fn pcs_collect_borrow_move_last_params(self_name: SelfRef, pnames: [Binder], body: Expr, uses: UseIx,
                                       bmap: BorrowMap, borrowed: [Binder],
                                       skip_set: [Binder]) : [Binder] / Console = {
  if not pcs_body_has_tail_self_call(self_name, body) { [] }
  else { pcs_bmlp_loop(self_name, pnames, body, uses, bmap, borrowed, skip_set) }
}

# True iff SOME tail position of `e` is a direct self-call — the
# base-plus-recursive shape (`if i>=n { acc } else { read(...) }`) that
# `tcrec` lowers to a goto loop, moving the exit-drop wrap OUT of the
# recursive path. The `and` variant above demands EVERY tail recurse
# (map/filter); this `or` variant fits a fn with a non-recursing base
# arm. Descends only tail positions (blocks flow to their tail).
fn pcs_body_has_tail_self_call(self_name: SelfRef, e: Expr) : Bool = pcs_bhtsc_kind(self_name, e.kind)

fn pcs_bhtsc_kind(self_name: SelfRef, k: ExprKind) : Bool = match k {
  ECall(f, _) -> is_self_callee(f, self_name)
  EIf(_, t, opt_e) ->
    pcs_body_has_tail_self_call(self_name, t) or
    (match opt_e { None -> false Some(e2) -> pcs_body_has_tail_self_call(self_name, e2) })
  EMatch(_, arms) -> pcs_bhtsc_arms(self_name, arms)
  EBlock(_, opt_tail) -> match opt_tail {
    None    -> false
    Some(t) -> pcs_body_has_tail_self_call(self_name, t)
  }
  _ -> false
}

fn pcs_bhtsc_arms(self_name: SelfRef, arms: [Arm]) : Bool = match arms {
  []           -> false
  [Arm(_, _, b), ...rest] ->
    pcs_body_has_tail_self_call(self_name, b) or pcs_bhtsc_arms(self_name, rest)
}

pub(pkg) fn pcs_arm_self_modulo_cons(self_name: SelfRef, e: Expr, tab: SymTab) : Bool =
  pcs_smc_kind(self_name, e.kind, tab)

fn pcs_smc_kind(self_name: SelfRef, k: ExprKind, tab: SymTab) : Bool = match k {
  # ONLY the modulo-cons shape: a CONSTRUCTOR rebuild one of whose slots is a
  # self-call `self_name(...)`. A bare self tail-call (`r = self(...)` bound to
  # a let, then matched — as in stdlib/regexp compile_repeat_optional) is
  # plain recursion, NOT modulo-cons, and tcrec does NOT lower it to a TRMC
  # step in a constructor slot; moving binders there is unsound (it keeps the
  # legacy emit). So we require the self-call to sit in a ctor slot.
  ECall(f, xs) ->
    if pcs_callee_is_ctor(tab, f) { pcs_smc_any_arg_is_self(self_name, xs, tab) }
    else { pcs_smc_seq(self_name, xs, tab) }
  EIf(c, t, opt_e) ->
    pcs_smc_kind(self_name, c.kind, tab) or pcs_smc_kind(self_name, t.kind, tab) or
    (match opt_e { None -> false Some(e2) -> pcs_smc_kind(self_name, e2.kind, tab) })
  EBlock(stmts, tail) ->
    pcs_smc_stmts(self_name, stmts, tab) or
    (match tail { None -> false Some(e) -> pcs_smc_kind(self_name, e.kind, tab) })
  EMatch(s, arms) ->
    pcs_smc_kind(self_name, s.kind, tab) or pcs_smc_arms(self_name, arms, tab)
  _ -> false
}

# True iff any direct arg of a ctor call is a self-call (the modulo-cons hole)
# or recursively contains the modulo-cons shape.
fn pcs_smc_any_arg_is_self(self_name: SelfRef, xs: [Expr], tab: SymTab) : Bool = match xs {
  []           -> false
  [h, ...rest] -> {
    let here = match h.kind {
      ECall(f, _) -> is_self_callee(f, self_name)
      _ -> pcs_smc_kind(self_name, h.kind, tab)
    }
    here or pcs_smc_any_arg_is_self(self_name, rest, tab)
  }
}

fn pcs_smc_seq(self_name: SelfRef, xs: [Expr], tab: SymTab) : Bool = match xs {
  []           -> false
  [h, ...rest] -> pcs_smc_kind(self_name, h.kind, tab) or pcs_smc_seq(self_name, rest, tab)
}

fn pcs_smc_stmts(self_name: SelfRef, stmts: [Stmt], tab: SymTab) : Bool = match stmts {
  []           -> false
  [s, ...rest] -> {
    let here = match s {
      SLet(_, _, e)       -> pcs_smc_kind(self_name, e.kind, tab)
      SVar(_, _, e, _, _) -> pcs_smc_kind(self_name, e.kind, tab)
      SExprStmt(e)        -> pcs_smc_kind(self_name, e.kind, tab)
      _                   -> false
    }
    here or pcs_smc_stmts(self_name, rest, tab)
  }
}

fn pcs_smc_arms(self_name: SelfRef, arms: [Arm], tab: SymTab) : Bool = match arms {
  []           -> false
  [a, ...rest] -> match a { Arm(_, _, b) -> pcs_smc_kind(self_name, b.kind, tab) or pcs_smc_arms(self_name, rest, tab) }
}

# Returns `true` if every execution path through `body` consumes
# `nm` exactly once on a non-lambda read. Only a position that runs
# whenever its parent runs (`XAll`) can witness consumption: a branch
# position (`XBr` — if/match alternatives, a short-circuited `and`/`or`
# RHS) or an assert message (`XMsg`) may never evaluate, and deferred
# bodies (`XLam`/`XCl`) run elsewhere. `EIf`/`EMatch` keep explicit
# arms because their branch positions are alternatives of each other —
# all must consume — which the flat position list cannot express.
fn pcs_consumed_on_every_path(nm: Binder, e: Expr) : Bool =
  pcs_consumed_b_expr(nm, e, bm_empty())

pub(pkg) fn pcs_branchy_single_use_params(fn_name: SelfRef, fid: FnId, pnames: [Binder],
                                 body: Expr, uses: UseIx, skip: [Binder], tab: SymTab) : [Binder] =
  if pcs_body_has_tail_self_call(fn_name, body) or
     pcs_arm_self_modulo_cons(fn_name, body, tab) or
     pcs_body_has_cons_self_tail(fn_name, body) or
     pcs_fn_named_in(fid, body) { [] }
  else { pcs_branchy_single_loop(pnames, body, uses, skip) }

# A reference to the fn `fid` outside lambdas.
fn pcs_fn_named_in(fid: FnId, e: Expr) : Bool = match e.kind {
  ESym(s, inst) -> fnid_eq(FnId(s, inst), fid)
  _             -> pcs_fn_named_ps(fid, xp_positions_kind(e.kind))
}

fn pcs_fn_named_ps(fid: FnId, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(r, c), ...rest] -> (match r { XLam -> false  _ -> pcs_fn_named_in(fid, c) }) or pcs_fn_named_ps(fid, rest)
}

# The builtin-cons TRMC tail (`[h, ...self(t)]`): a tail-position list
# one of whose elements is a self-call. Goto-lowered like the ctor
# modcons shape, so it joins the self-recursion fence above.
fn pcs_body_has_cons_self_tail(self_name: SelfRef, e: Expr) : Bool =
  pcs_bhcst_kind(self_name, e.kind)

fn pcs_bhcst_kind(self_name: SelfRef, k: ExprKind) : Bool = match k {
  EList(els) -> pcs_bhcst_els(self_name, els)
  EIf(_, t, opt_e) ->
    pcs_body_has_cons_self_tail(self_name, t) or
    (match opt_e { None -> false Some(e2) -> pcs_body_has_cons_self_tail(self_name, e2) })
  EMatch(_, arms) -> pcs_bhcst_arms(self_name, arms)
  EBlock(_, opt_tail) -> match opt_tail {
    None    -> false
    Some(t) -> pcs_body_has_cons_self_tail(self_name, t)
  }
  _ -> false
}

fn pcs_bhcst_els(self_name: SelfRef, els: [ListElem]) : Bool = match els {
  []           -> false
  [h, ...rest] -> {
    let inner = match h { ElPlain(e) -> e ElSpread(e) -> e }
    let hit = match inner.kind {
      ECall(f, _) -> is_self_callee(f, self_name)
      _ -> false
    }
    hit or pcs_bhcst_els(self_name, rest)
  }
}

fn pcs_bhcst_arms(self_name: SelfRef, arms: [Arm]) : Bool = match arms {
  []                      -> false
  [Arm(_, _, b), ...rest] ->
    pcs_body_has_cons_self_tail(self_name, b) or pcs_bhcst_arms(self_name, rest)
}

fn pcs_branchy_single_loop(pnames: [Binder], body: Expr, uses: UseIx,
                           skip: [Binder]) : [Binder] = match pnames {
  []           -> []
  [p, ...rest] -> {
    let r = pcs_branchy_single_loop(rest, body, uses, skip)
    if pcs_has(skip, p.id) { r }
    else if pcs_read_count(p.id, uses) != 1 { r }
    else {
      match last_use_for(p.id, uses) {
        LuAt(_, _) ->
          if pcs_consumed_on_every_path(p, body) { r } else { [p, ...r] }
        _ -> r
      }
    }
  }
}

pub(pkg) fn pcs_is_modcons_leaf(e: Expr, fn_name: SelfRef, tab: SymTab) : Bool = match e.kind {
  EList(_)    -> pcs_body_has_cons_self_tail(fn_name, e)
  ECall(_, _) -> pcs_arm_self_modulo_cons(fn_name, e, tab)
  _           -> false
}

# Borrow-aware variant: the max-path count discounts uses of a binder that
# land in a borrowed callee slot (is_red(l) does not consume l). This is
# what lets the rb-tree Black arm's l/r pass `mp <= 1` — without it, the
# is_red(l) + insert_loop(l) uses sum to 2 on the descent path. `bmap` is
# the global borrow map; pass [] for the borrow-unaware behaviour.
pub(pkg) fn pcs_branch_aware_skip_locals_b(binders: [Binder], body: Expr, bmap: BorrowMap, cmap: ConsumeIndex, borrowed: [Binder], tab: SymTab) : [Binder] = match binders {
  []           -> []
  [h, ...rest] -> {
    let rest_skip = pcs_branch_aware_skip_locals_b(rest, body, bmap, cmap, borrowed, tab)
    if pcs_local_moves_raw(h, body, bmap, cmap, tab) { [h, ...rest_skip] } else { rest_skip }
  }
}

# Every arg-slot use of h lands in a consuming slot or a declared borrow
# that runs before the consuming read. Any other non-consuming slot
# (a field-read callee) would free h under the callee. Ctor slots, match
# scrutinees and returns consume by construction. A borrow is no
# consumer, so the consumed check must not count one either.
fn pcs_local_moves_raw(h: Binder, body: Expr, bmap: BorrowMap, cmap: ConsumeIndex, tab: SymTab) : Bool =
  pcs_max_paths_b_expr(h, body, bmap) <= 1 and
  pcs_consumed_b_expr(h, body, bmap) and
  pcs_all_consumers_linear(h, body) and
  pcs_uses_only_consuming_slots(h, body, cmap, bmap, tab) and
  not pcs_borrow_after_consume(h, body, bmap, tab)

# A borrowed-slot read of `nm` after, on the same path, a read that consumed
# it. Moving every read of `nm` would hand the borrow a value the consuming
# callee may already have freed. A read stored into a constructor, list or
# record stays pending until the call that receives it returns, or its
# statement ends. Source order stands in for evaluation order, which only
# errs toward keeping the dup.
fn pcs_borrow_after_consume(nm: Binder, e: Expr, bmap: BorrowMap, tab: SymTab) : Bool =
  pcs_bac(nm, e, bmap, pcs_bac_st(false, false, false), tab).bad

# A violation seen; `nm` consumed by now; `nm` read into a value not yet consumed.
type PcsBac = { bad: Bool, done: Bool, pending: Bool }

fn pcs_bac_st(bad: Bool, done: Bool, pending: Bool) : PcsBac = PcsBac { bad: bad, done: done, pending: pending }

fn pcs_bac(nm: Binder, e: Expr, bmap: BorrowMap, st: PcsBac, tab: SymTab) : PcsBac = match e.kind {
  ELocal(u)       -> pcs_bac_st(st.bad, st.done, st.pending or local_eq(u, nm.id))
  ECall(f, xs)    -> {
    let a = pcs_bac_args(nm, xs, pcs_lent_slots(nm.id, f, xs, bmap), 0, bmap,
                         pcs_bac_st(st.bad, st.done, false), tab)
    if pcs_callee_is_ctor(tab, f) { pcs_bac_st(a.bad, a.done, st.pending or a.pending) }
    else { pcs_bac_st(a.bad, a.done or a.pending, st.pending) }
  }
  EIf(c, t, oe)   -> {
    let sc = pcs_bac(nm, c, bmap, st, tab)
    pcs_bac_join(pcs_bac(nm, t, bmap, sc, tab), match oe { Some(x) -> pcs_bac(nm, x, bmap, sc, tab) None -> sc })
  }
  EMatch(s, arms) -> pcs_bac_arms(nm, arms, bmap, pcs_bac(nm, s, bmap, st, tab), pcs_bac_st(false, false, false), tab)
  EBlock(ss, ot)  -> {
    let s1 = pcs_bac_stmts(nm, ss, bmap, st, tab)
    match ot { Some(t) -> pcs_bac(nm, t, bmap, s1, tab) None -> s1 }
  }
  _               -> pcs_bac_ps(nm, xp_positions(e), bmap, st, tab)
}

fn pcs_bac_join(a: PcsBac, b: PcsBac) : PcsBac =
  pcs_bac_st(a.bad or b.bad, a.done or b.done, a.pending or b.pending)

fn pcs_bac_ps(nm: Binder, ps: [XPos], bmap: BorrowMap, st: PcsBac, tab: SymTab) : PcsBac = match ps {
  []                  -> st
  [XP(r, c), ...rest] ->
    pcs_bac_ps(nm, rest, bmap, if xrole_inline(r) { pcs_bac(nm, c, bmap, st, tab) } else { st }, tab)
}

# A statement's value is gone when it ends: whatever it read is spent.
fn pcs_bac_stmts(nm: Binder, ss: [Stmt], bmap: BorrowMap, st: PcsBac, tab: SymTab) : PcsBac = match ss {
  [] -> st
  [s, ...rest] -> {
    let a = pcs_bac_ps(nm, map(stmt_exprs(s), (x) => XP(XAll, x)), bmap, st, tab)
    pcs_bac_stmts(nm, rest, bmap, pcs_bac_st(a.bad, a.done or a.pending, false), tab)
  }
}

fn pcs_bac_arms(nm: Binder, arms: [Arm], bmap: BorrowMap, st: PcsBac, acc: PcsBac, tab: SymTab) : PcsBac = match arms {
  [] -> acc
  [Arm(_, og, b), ...rest] -> {
    let sg = match og { Some(g) -> pcs_bac(nm, g, bmap, st, tab) None -> st }
    pcs_bac_arms(nm, rest, bmap, st, pcs_bac_join(acc, pcs_bac(nm, b, bmap, sg, tab)), tab)
  }
}

fn pcs_bac_args(nm: Binder, xs: [Expr], borrowed: [Int], i: Int, bmap: BorrowMap, st: PcsBac, tab: SymTab) : PcsBac =
  match xs {
    [] -> st
    [a, ...rest] -> {
      let st1 = if pcs_is_bare(nm.id, a) and pcs_has_int(borrowed, i) { pcs_bac_st(st.bad or st.done, st.done, st.pending) }
                else { pcs_bac(nm, a, bmap, st, tab) }
      pcs_bac_args(nm, rest, borrowed, i + 1, bmap, st1, tab)
    }
  }

pub(pkg) fn plt_take(ps: [Param], orig: Expr, body: Expr, bmap: BorrowMap) : Expr = {
  let owned = map(filter(ps, (p) => not p.pborrow), .binder)
  match filter(owned, (b) => plt_consumes(b, orig, bmap)) {
    []    -> body
    taken -> {
      let ids = map(taken, .id)
      plt_mark(ids, plt_bare(ids, body))
    }
  }
}

# The mark is a leading statement: a body that is itself a block takes it in
# place, any other body becomes the tail of a block of its own.
fn plt_mark(ids: [LocalId], body: Expr) : Expr = {
  let m = SExprStmt(Expr { kind: ECall(mk_expr(EMark(MkLamTake(ids)), body.line, body.col), []), line: body.line, col: body.col, ty: None, mode: MUnknown, site: body.site })
  match body.kind {
    EBlock(ss, ot) -> with_kind(body, EBlock([m, ...ss], ot))
    _              -> with_kind(body, EBlock([m], Some(body)))
  }
}

# Every path hands the param over at one owning read, after the lends of it.
fn plt_consumes(b: Binder, body: Expr, bmap: BorrowMap) : Bool =
  not plt_captured(b.id, body) and pcs_consumed_b_expr(b, body, bmap) and pcs_all_consumers_linear(b, body) and
  (pcs_max_paths_in_expr(b, body) <= 1 or pcs_lends_end_first(b, body, bmap))

# A read in a nested lambda is a capture: it dups.
fn plt_captured(l: LocalId, e: Expr) : Bool =
  xp_exists(e, false, (x) => match x.kind {
    ELambda(_, b) -> xp_exists(b, false, (y) => match y.kind { ELocal(u) -> local_eq(u, l)  _ -> false })
    _             -> false
  })

fn plt_bare(ids: [LocalId], e: Expr) : Expr = match e.kind {
  ECall(f, [a]) -> match f.kind {
    EMark(MkDup) -> match a.kind {
      ELocal(l) -> if contains_local(ids, l) { with_kind(e, a.kind) } else { e }
      _         -> plt_bare_kind(ids, e)
    }
    _ -> plt_bare_kind(ids, e)
  }
  _ -> plt_bare_kind(ids, e)
}

fn plt_bare_kind(ids: [LocalId], e: Expr) : Expr = with_kind(e, prc_map_expr_kind(e.kind, (c) => plt_bare(ids, c)))

fn contains_local(ids: [LocalId], l: LocalId) : Bool = any(ids, (i) => local_eq(i, l))
