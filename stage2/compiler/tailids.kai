#[doc("""
Parameter renaming by binder identity, for tail-call fusion.

The resolver gives every parameter a local id and stamps it on each read,
and a local that reuses the name gets an id of its own. A member's body
is renamed onto the fused entry's slots by those ids, so a shadowing
local, a lambda's parameter or a handler clause's binder is never
renamed, whatever its spelling.
""")]

import compiler.ast
import compiler.ast_map
import compiler.tailslots

#[doc("`body` with each read of the parameter `ids[i]` reading `to[i]`.")]
pub fn tfid_rename(body: Expr, ids: [LocalId], to: [LocalId]) : Expr =
  Expr { ...body, kind: match body.kind {
    ELocal(l) -> match tfid_slot(ids, to, l) {
      Some(t) -> ELocal(t)
      None    -> body.kind
    }
    _ -> prc_map_expr_kind(body.kind, (e) => tfid_rename(e, ids, to))
  } }

fn tfid_slot(ids: [LocalId], to: [LocalId], l: LocalId) : Option[LocalId] = match ids {
  [] -> None
  [i, ...irest] -> match to {
    [] -> None
    [t, ...trest] -> if local_eq(i, l) { Some(t) } else { tfid_slot(irest, trest, l) }
  }
}

#[doc("True when the resolver numbered every member's parameters; a group that fails stays unfused.")]
pub fn tfid_all_renamable(ms: [Decl]) : Bool = match ms {
  [] -> true
  [d, ...rest] -> tfid_member_renamable(d) and tfid_all_renamable(rest)
}

fn tfid_member_renamable(d: Decl) : Bool = match d {
  DFn(_, _, _, ps, _, _, _, _, _, _) -> all(ps, (p) => local_raw(p.binder.id) != 0)
  _ -> false
}

#[doc("Each member renamed onto the slots it occupies, `slot_id` giving the binder of a slot by its index.")]
pub fn tfid_onto_slots(members: [Decl], slots: TfSlots, slot_id: (Int) -> LocalId) : [Decl] = match slots {
  TfSlots(_, layout) -> tfid_onto_layout(members, layout, slot_id)
}

fn tfid_onto_layout(members: [Decl], layout: [[Int]], slot_id: (Int) -> LocalId) : [Decl] = match members {
  [] -> []
  [d, ...rest] -> match layout {
    [] -> members
    [idxs, ...more] -> [tfid_rename_member(d, map(idxs, slot_id)), ...tfid_onto_layout(rest, more, slot_id)]
  }
}

fn tfid_rename_member(d: Decl, to: [LocalId]) : Decl = match d {
  DFn(p, fid, tps, ps, ret, row, body, ln, cl, mo) ->
    DFn(p, fid, tps, ps, ret, row, tfid_rename(body, map(ps, (x) => x.binder.id), to), ln, cl, mo)
  _ -> d
}
