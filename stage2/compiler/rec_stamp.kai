#[doc("""
Head tags a record value carries from its construction.

An operator on a compound value walks it at run time and reaches the
impl of a member's type through that member's runtime head tag. A
variant always carries its head; a record carries one only when its type
is stamped here, so every other record is built exactly as an anonymous
one.

A record type is stamped when it has an `impl Ord` or a hand-written
`impl Eq`: the impls a comparison operator looks up by head. A derived
`impl Eq` compares as the structural walk does, so the walk stands in
for it: it asks for no head and takes no row of the runtime impl table.
Core records stay untagged, so the cached core object never depends on
the program's declarations.
""")]

import compiler.ast
import compiler.core_protos
import compiler.head_tag_decl
import compiler.impl_identity
import compiler.util

#[doc("A stamped record type: its declaration and the head tag its values carry.")]
pub type RecStamp = RecStamp(SymId, Int)

#[doc("The impl functions of the derived `impl Eq`s among `impls`: the structural compare is each of them, so none takes a row of the runtime impl table and none asks its type for a head.")]
pub fn walked_impls(impls: [ProtoImplReg], derived: [SymId]) : [SymId] = wi_collect(impls, derived, [])

fn wi_collect(ps: [ProtoImplReg], derived: [SymId], acc: [SymId]) : [SymId] = match ps {
  [] -> acc
  [p, ...rest] -> match p {
    PIR(proto, _, _, m, _, _, _) ->
      wi_collect(rest, derived, if proto_is(proto, CpEq) and rs_has(derived, m) { [m, ...acc] } else { acc })
  }
}

#[doc("The declarations of the record types to stamp: targets of an `impl Ord` or an `impl Eq` declared outside the `cores` modules, the `walked` impl functions aside. Record-ness is checked against the decls by `rec_stamps`.")]
pub fn stamp_targets(impls: [ProtoImplReg], walked: [SymId], cores: [String]) : [SymId] =
  st_collect(impls, walked, cores, [])

fn st_collect(ps: [ProtoImplReg], walked: [SymId], cores: [String], acc: [SymId]) : [SymId] = match ps {
  [] -> acc
  [p, ...rest] -> st_collect(rest, walked, cores,
                             if st_needs_head(p, walked, cores) { [pir_target(p), ...acc] } else { acc })
}

# `==` looks an `impl Eq` up by head, an ordering operator an `impl Ord`.
fn st_needs_head(p: ProtoImplReg, walked: [SymId], cores: [String]) : Bool = match p {
  PIR(proto, target, _, m, _, _, home) ->
    (proto_is(proto, CpOrd) or (proto_is(proto, CpEq) and not (rs_has(walked, m))))
    and ref_resolved(target) and not (st_in_core(home, cores))
}

fn st_in_core(home: Option[String], cores: [String]) : Bool = match home {
  Some(h) -> list_has(cores, h)
  None    -> false
}

fn pir_target(p: ProtoImplReg) : SymId = match p { PIR(_, target, _, _, _, _, _) -> ref_sym(target) }

#[doc("The head tag of every record declaration among `ids`, counted as the runtime impl table counts it. Empty, without a walk, when nothing is stamped.")]
pub fn rec_stamps(decls: [Decl], ids: [SymId]) : [RecStamp] = match ids {
  [] -> []
  _  -> rs_walk(decls, ids, 20, [])
}

fn rs_walk(ds: [Decl], ids: [SymId], tag: Int, acc: [RecStamp]) : [RecStamp] = match ds {
  [] -> acc
  [d, ...rest] ->
    if decl_takes_head_tag(d) { rs_walk(rest, ids, tag + 1, rs_add(d, ids, tag, acc)) }
    else { rs_walk(rest, ids, tag, acc) }
}

fn rs_add(d: Decl, ids: [SymId], tag: Int, acc: [RecStamp]) : [RecStamp] = match d {
  DType(_, s, _, TBRecord(_), _, _, _, _) -> if rs_has(ids, s) { [RecStamp(s, tag), ...acc] } else { acc }
  _ -> acc
}

fn rs_has(ids: [SymId], s: SymId) : Bool = match ids {
  [] -> false
  [i, ...rest] -> if sym_raw(i) == sym_raw(s) { true } else { rs_has(rest, s) }
}

#[doc("The head tag a record value of type `ty` is built with; 0 when its type is not stamped.")]
pub fn rec_stamp_of(stamps: [RecStamp], ty: Option[Ty]) : Int = match stamps {
  [] -> 0
  _  -> match ty {
    Some(t) -> rs_tag(stamps, ty_head_sym(t))
    None    -> 0
  }
}

fn rs_tag(stamps: [RecStamp], s: SymId) : Int = match stamps {
  [] -> 0
  [RecStamp(i, tag), ...rest] -> if sym_raw(i) == sym_raw(s) { tag } else { rs_tag(rest, s) }
}
