#[doc("""
Head tags a record value carries from its construction.

An operator on a compound value walks it at run time and reaches the
impl of a member's type through that member's runtime head tag. A
variant always carries its head; a record carries one only when its type
is stamped here, so every other record is built exactly as an anonymous
one.

A record type is stamped when it has an `impl Ord`, `Show` or `Hash` or a
hand-written `impl Eq`: the impls an operator or a generic body looks up by head. A derived
`impl Eq` on a record compares as the structural walk does, so the walk
stands in for it: it asks for no head and takes no row of the runtime
impl table, and a record with a head for `Ord` compares as one without.
Core records stay untagged, so the cached core object never depends on
the program's declarations.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.core_refs
import compiler.core_types
import compiler.impl_identity
import compiler.util

#[doc("A stamped record type: its declaration and the head tag its values carry.")]
pub(pkg) type RecStamp = RecStamp(SymId, Int)

# A derived `impl Eq`: its impl function and the type it is for.
type DerivedEq = DerivedEq(SymId, SymId)

#[doc("The impl functions of the derived `impl Eq`s of the record types among `decls`: the structural compare is each of them, so none takes a row of the runtime impl table. Empty, without a walk, when `impls` holds no derived `impl Eq`.")]
pub(pkg) fn walked_impls(impls: [ProtoImplReg], derived: [SymId], decls: [Decl]) : [SymId] =
  match wi_collect(impls, derived, []) {
    [] -> []
    ds -> wi_of_records(ds, wi_records(decls, ds, []), [])
  }

fn wi_collect(ps: [ProtoImplReg], derived: [SymId], acc: [DerivedEq]) : [DerivedEq] = match ps {
  [] -> acc
  [p, ...rest] -> match p {
    PIR(proto, target, _, m, _, _, _) ->
      wi_collect(rest, derived,
                 if proto_is(proto, CpEq) and ref_resolved(target) and rs_has(derived, m) { [DerivedEq(m, ref_sym(target)), ...acc] }
                 else { acc })
  }
}

# The record declarations the impls of `ds` are for.
fn wi_records(decls: [Decl], ds: [DerivedEq], acc: [SymId]) : [SymId] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DType(_, s, _, TBRecord(_), _, _, _, _) -> wi_records(rest, ds, if wi_targets(ds, s) { [s, ...acc] } else { acc })
    _ -> wi_records(rest, ds, acc)
  }
}

fn wi_targets(ds: [DerivedEq], s: SymId) : Bool = match ds {
  [] -> false
  [DerivedEq(_, t), ...rest] -> if sym_raw(t) == sym_raw(s) { true } else { wi_targets(rest, s) }
}

fn wi_of_records(ds: [DerivedEq], recs: [SymId], acc: [SymId]) : [SymId] = match ds {
  [] -> acc
  [DerivedEq(m, t), ...rest] -> wi_of_records(rest, recs, if rs_has(recs, t) { [m, ...acc] } else { acc })
}

#[doc("The declarations of the record types to stamp: targets of an `impl Ord`, `Show` or `Hash` or of a hand-written `impl Eq` (not among the `derived` impl functions) declared outside the `cores` modules. Record-ness is checked against the decls by `rec_stamps`.")]
pub(pkg) fn stamp_targets(impls: [ProtoImplReg], derived: [SymId], cores: [String]) : [SymId] =
  st_collect(impls, derived, cores, [])

fn st_collect(ps: [ProtoImplReg], derived: [SymId], cores: [String], acc: [SymId]) : [SymId] = match ps {
  [] -> acc
  [p, ...rest] -> st_collect(rest, derived, cores,
                             if st_needs_head(p, derived, cores) { [pir_target(p), ...acc] } else { acc })
}

# `==` looks an `impl Eq` up by head, an ordering operator an `impl Ord`; a
# generic body reaches `show` and `hash` the same way.
fn st_needs_head(p: ProtoImplReg, derived: [SymId], cores: [String]) : Bool = match p {
  PIR(proto, target, _, m, _, _, home) ->
    (proto_is(proto, CpOrd) or proto_is(proto, CpShow) or proto_is(proto, CpHash) or (proto_is(proto, CpEq) and not (rs_has(derived, m))))
    and ref_resolved(target) and not (st_in_core(home, cores))
}

fn st_in_core(home: Option[String], cores: [String]) : Bool = match home {
  Some(h) -> list_has(cores, h)
  None    -> false
}

fn pir_target(p: ProtoImplReg) : SymId = match p { PIR(_, target, _, _, _, _, _) -> ref_sym(target) }

#[doc("The head tag of every record declaration among `ids`, counted as the runtime impl table counts it, and the fixed one of each tuple type.")]
pub(pkg) fn rec_stamps(decls: [Decl], ids: [SymId]) : [RecStamp] = list_append(tuple_stamps(), match ids {
  [] -> []
  _  -> rs_walk(decls, ids, user_head_base(), [])
})

# A tuple is a core record whose generic bodies dispatch on it, so it always carries its fixed head.
fn tuple_stamps() : [RecStamp] =
  map(filter(rt_heads(), (h) => rt_head_is_tuple(h)), (h) => RecStamp(rt_head_decl_sym(h), rt_head_tag(h)))

fn rs_walk(ds: [Decl], ids: [SymId], tag: Int, acc: [RecStamp]) : [RecStamp] = match ds {
  [] -> acc
  [d, ...rest] ->
    if decl_takes_head_tag(d) { rs_walk(rest, ids, tag + 1, rs_add(d, ids, tag, acc)) }
    else { rs_walk(rest, ids, tag, acc) }
}

fn rs_add(d: Decl, ids: [SymId], tag: Int, acc: [RecStamp]) : [RecStamp] = match d {
  DType(_, s, _, TBRecord(_), _, _, _, _) -> if rs_has(ids, s) { [RecStamp(s, tag), ...acc] } else { acc }
  _ -> acc
}

fn rs_has(ids: [SymId], s: SymId) : Bool = match ids {
  [] -> false
  [i, ...rest] -> if sym_raw(i) == sym_raw(s) { true } else { rs_has(rest, s) }
}

#[doc("The head tag a record value of type `ty` is built with; 0 when its type is not stamped.")]
pub(pkg) fn rec_stamp_of(stamps: [RecStamp], ty: Option[Ty]) : Int = match stamps {
  [] -> 0
  _  -> match ty {
    Some(t) -> rs_tag(stamps, ty_head_sym(t))
    None    -> 0
  }
}

fn rs_tag(stamps: [RecStamp], s: SymId) : Int = match stamps {
  [] -> 0
  [RecStamp(i, tag), ...rest] -> if sym_raw(i) == sym_raw(s) { tag } else { rs_tag(rest, s) }
}

#[doc("Head tag of the type an impl targets: the fixed one of a type the runtime numbers, a user record or sum's by its declaration, -1 for any other.")]
pub(pkg) fn impl_head_tag(target: DeclRef, decls: [Decl]) : Int = match rt_head_of_ref(target) {
  Some(h) -> rt_head_tag(h)
  None    -> decl_head_tag(ref_sym(target), decls)
}

#[doc("Head tag of the record or sum the declaration `s` is, or -1 when `decls` holds no such declaration.")]
fn decl_head_tag(s: SymId, decls: [Decl]) : Int =
  if sym_raw(s) < 0 { 0 - 1 } else { htd_sym_loop(decls, s, 0) }

fn htd_sym_loop(ds: [Decl], s: SymId, idx: Int) : Int = match ds {
  [] -> 0 - 1
  [d, ...rest] -> match htd_nominal(d) {
    Some(t) -> if sym_same(t, s) { user_head_base() + idx } else { htd_sym_loop(rest, s, idx + 1) }
    None    -> htd_sym_loop(rest, s, idx)
  }
}

#[doc("Head tag of the sum that declares the constructor `c`, or -1 when no declaration of `decls` does.")]
pub(pkg) fn ctor_owner_head_tag(c: SymId, decls: [Decl]) : Int =
  if sym_raw(c) < 0 { 0 - 1 } else { htd_ctor_loop(decls, c, 0) }

fn htd_ctor_loop(ds: [Decl], c: SymId, idx: Int) : Int = match ds {
  [] -> 0 - 1
  [d, ...rest] -> match htd_nominal(d) {
    Some(_) -> if htd_declares_ctor(d, c) { user_head_base() + idx } else { htd_ctor_loop(rest, c, idx + 1) }
    None    -> htd_ctor_loop(rest, c, idx)
  }
}

#[doc("True for a record or sum declaration: the decls that take a head tag, in stream order from `user_head_base()`.")]
fn decl_takes_head_tag(d: Decl) : Bool = match htd_nominal(d) {
  Some(_) -> true
  None    -> false
}

# The id of a record or sum declaration; the only decls that take a tag.
fn htd_nominal(d: Decl) : Option[SymId] = match d {
  DType(_, s, _, body, _, _, _, _) -> match body {
    TBRecord(_) -> Some(s)
    TBSum(_)    -> Some(s)
    _           -> None
  }
  _ -> None
}

fn htd_declares_ctor(d: Decl, c: SymId) : Bool = match d {
  DType(_, _, _, TBSum(vs), _, _, _, _) -> any(vs, (v) => match v { Var(k, _) -> sym_same(k, c) })
  _ -> false
}

#[doc("The slots of the table the flattened (tag, head) `pairs` describe; a later pair for a tag replaces an earlier one.")]
pub(pkg) fn dense_head_table(pairs: [Int]) : [Int] =
  ht_fill(sort_by(ht_pairs(pairs, []), (a, b) => a.fst - b.fst), 0, [])

fn ht_pairs(xs: [Int], acc: [Pair[Int, Int]]) : [Pair[Int, Int]] = match xs {
  [t, h, ...rest] -> ht_pairs(rest, [Pair { fst: t, snd: h }, ...acc])
  _ -> list_reverse(acc)
}

# `next` slots are filled and `acc` holds them newest first.
fn ht_fill(ps: [Pair[Int, Int]], next: Int, acc: [Int]) : [Int] = match ps {
  [] -> list_reverse(ht_pad(next, 11, acc))
  [p, ...rest] ->
    if p.fst == next - 1 { ht_fill(rest, next, ht_replace(acc, p.snd)) }
    else { ht_fill(rest, p.fst + 1, [p.snd, ...ht_pad(next, p.fst, acc)]) }
}

fn ht_pad(next: Int, upto: Int, acc: [Int]) : [Int] =
  if next >= upto { acc } else { ht_pad(next + 1, upto, [0, ...acc]) }

fn ht_replace(acc: [Int], h: Int) : [Int] = match acc {
  [] -> [h]
  [_, ...rest] -> [h, ...rest]
}
