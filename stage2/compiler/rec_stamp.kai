#[doc("""
Head tags a record value carries from its construction.

`==` on a compound value compares structurally and reaches a field's
`impl Eq` through that field value's runtime head tag. A variant always
carries its head; a record carries one only when its type is stamped
here, so every other record is built exactly as an anonymous one.

A record type is stamped when it has a hand-written `impl Eq`: a derived
one compares as the structural walk does. Core records stay untagged, so
the cached core object never depends on the program's declarations.
""")]

import compiler.ast
import compiler.core_refs
import compiler.head_tag_decl
import compiler.impl_identity
import compiler.util

#[doc("A stamped record type: its declaration and the head tag its values carry.")]
pub type RecStamp = RecStamp(SymId, Int)

#[doc("The declarations of the record types to stamp: targets of a hand-written `impl Eq` (not among `derived` symbols) declared outside the `cores` modules. Record-ness is checked against the decls by `rec_stamps`.")]
pub fn stamp_targets(impls: [ProtoImplReg], derived: [String], cores: [String]) : [SymId] =
  st_collect(impls, op_proto_protocol(BpEq), derived, cores, [])

fn st_collect(ps: [ProtoImplReg], eq: String, derived: [String], cores: [String],
              acc: [SymId]) : [SymId] = match ps {
  [] -> acc
  [p, ...rest] -> st_collect(rest, eq, derived, cores,
                             if st_hand_eq(p, eq, derived, cores) { [pir_target(p), ...acc] } else { acc })
}

fn st_hand_eq(p: ProtoImplReg, eq: String, derived: [String], cores: [String]) : Bool = match p {
  PIR(k, _, _, m, _, _, home, s) ->
    k == eq and sym_raw(s) >= 0 and not (list_has(derived, m)) and not (st_in_core(home, cores))
}

fn st_in_core(home: Option[String], cores: [String]) : Bool = match home {
  Some(h) -> list_has(cores, h)
  None    -> false
}

fn pir_target(p: ProtoImplReg) : SymId = match p { PIR(_, _, _, _, _, _, _, s) -> s }

#[doc("The head tag of every record declaration among `ids`, counted as the runtime impl table counts it. Empty, without a walk, when nothing is stamped.")]
pub fn rec_stamps(decls: [Decl], ids: [SymId]) : [RecStamp] = match ids {
  [] -> []
  _  -> rs_walk(decls, ids, 20, [])
}

fn rs_walk(ds: [Decl], ids: [SymId], tag: Int, acc: [RecStamp]) : [RecStamp] = match ds {
  [] -> acc
  [d, ...rest] ->
    if decl_takes_head_tag(d) { rs_walk(rest, ids, tag + 1, rs_add(d, ids, tag, acc)) }
    else { rs_walk(rest, ids, tag, acc) }
}

fn rs_add(d: Decl, ids: [SymId], tag: Int, acc: [RecStamp]) : [RecStamp] = match d {
  DType(_, _, _, TBRecord(_), _, _, _, _, s) -> if rs_has(ids, s) { [RecStamp(s, tag), ...acc] } else { acc }
  _ -> acc
}

fn rs_has(ids: [SymId], s: SymId) : Bool = match ids {
  [] -> false
  [i, ...rest] -> if sym_raw(i) == sym_raw(s) { true } else { rs_has(rest, s) }
}

#[doc("The head tag a record value of type `ty` is built with; 0 when its type is not stamped.")]
pub fn rec_stamp_of(stamps: [RecStamp], ty: Option[Ty]) : Int = match stamps {
  [] -> 0
  _  -> match ty {
    Some(t) -> rs_tag(stamps, ty_head_sym(t))
    None    -> 0
  }
}

fn rs_tag(stamps: [RecStamp], s: SymId) : Int = match stamps {
  [] -> 0
  [RecStamp(i, tag), ...rest] -> if sym_raw(i) == sym_raw(s) { tag } else { rs_tag(rest, s) }
}
