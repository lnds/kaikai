#[doc("""
Qualified habitant names in head position: `with m.E`, `impl m.P`,
`#[derive(m.P)]`.

The parser keeps the qualifier in the head's reference; a `#[derive]`
entry spells it into the name (`"m.P"`). This pass validates the
qualifier against the file's import table. A handler head is rewritten
back to the bare name. A protocol head keeps its qualifier,
canonicalised from the written alias to the module's tagged name
(`alias.P` -> `home.P`), so the protocol lowering resolves the impl
against exactly that module.

The rewrite is pure and total — a bad qualifier still yields the bare
name — and the check pass is what reports it and fails the build.

Effect operations (`m.E.op`) need no arm here: they parse as a nested
field chain whose leading segment is a module, and the module rewrite
resolves them along with every other `m.f`.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_map
import compiler.diag
import compiler.diag_file
import compiler.expr_positions
import compiler.modules_paths
import compiler.modules_segments
import compiler.module_table
import compiler.util
import compiler.written

#[doc("Strip a validated module qualifier from every habitant head in these decls.")]
pub fn qh_decls(decls: [Decl], mt: [ModuleEntry]) : [Decl] = match decls {
  [] -> []
  [d, ...rest] -> [qh_decl(d, mt), ...qh_decls(rest, mt)]
}

#[doc("Resolve each import segment's heads under its own file's qualifier table.")]
pub fn qh_segmented(segs: [ImportSeg], decls: [Decl], tabs: ModTables) : [Decl] = match segs {
  [] -> qh_decls(decls, mtabs_of(tabs, "").entries)
  [ISeg(home, n), ...rest] -> {
    let mt = mtabs_of(tabs, home).entries
    list_append(qh_decls(seg_take(decls, n), mt),
                qh_segmented(rest, seg_drop(decls, n), tabs))
  }
}

#[doc("The error for every habitant head of `decls` whose qualifier names no import or no export, in source order.")]
pub fn qhchk_decls(decls: [Decl], mt: [ModuleEntry], df: DiagFiles) : [Diagnostic] =
  finalize_diags(qhchk_onto(decls, mt, df, []))

#[doc("Segment-aware counterpart of `qhchk_decls`.")]
pub fn qhchk_segmented(segs: [ImportSeg], decls: [Decl], tabs: ModTables, df: DiagFiles) : [Diagnostic] =
  finalize_diags(qhchk_segs(segs, decls, tabs, df, []))

fn qhchk_segs(segs: [ImportSeg], decls: [Decl], tabs: ModTables, df: DiagFiles, acc: [Diagnostic]) : [Diagnostic] = match segs {
  [] -> qhchk_onto(decls, mtabs_of(tabs, "").entries, df, acc)
  [ISeg(home, n), ...rest] ->
    qhchk_segs(rest, seg_drop(decls, n), tabs, df,
               qhchk_onto(seg_take(decls, n), mtabs_of(tabs, home).entries, df, acc))
}

# The walk accumulates newest first.
fn qhchk_onto(decls: [Decl], mt: [ModuleEntry], df: DiagFiles, acc: [Diagnostic]) : [Diagnostic] = match decls {
  []           -> acc
  [d, ...rest] -> qhchk_onto(rest, mt, df, qhchk_decl(d, QhCx { mt: mt, file: decl_diag_file(d, df) }, acc))
}

# What a head is checked against: the module table of the file that
# wrote it, and that file.
type QhCx = { mt: [ModuleEntry], file: String }

# `Bool` distinguishes "no such module" from "module lacks the name",
# which the two diagnostics word differently.
type QhRes = QhOk(String) | QhBad(String, String, Bool, [String])

fn qh_resolve(name: String, mt: [ModuleEntry]) : QhRes = match split_dotted_qualifier(name) {
  None -> QhOk(name)
  Some(QSplit(mod, bare)) -> qh_resolve_in(mod, bare, mt)
}

fn qh_resolve_in(mod: String, bare: String, mt: [ModuleEntry]) : QhRes = match mt_lookup_member(mt, mod, bare) {
  None -> QhBad(mod, bare, false, [])
  Some(me) ->
    if me_has_export(me, bare) { QhOk(bare) }
    else { QhBad(mod, bare, true, me_exports(me)) }
}

# A handler head or a row label loses its qualifier, valid or not; a
# settled one has none.
fn qh_ref(r: DeclRef) : DeclRef = match r {
  DrWritten(Some(_), n) -> DrWritten(None, n)
  _                     -> r
}

fn qh_alias_label(l: RowLabel) : RowLabel = match l {
  RL(r, ts) -> RL(qh_ref(r), ts)
}

# A protocol head keeps a valid qualifier, spelled with the tagged
# module name; an invalid one falls back to the bare name.
fn qh_proto_name(name: String, mt: [ModuleEntry]) : String = match split_dotted_qualifier(name) {
  None -> name
  Some(q) -> match q {
    QSplit(mod, bare) -> match qh_resolve(name, mt) {
      QhOk(_) -> concat_all([mt_tagged_name(mt, mod), ".", bare])
      QhBad(_, _, _, _) -> bare
    }
  }
}

fn qh_proto_ref(r: DeclRef, mt: [ModuleEntry]) : DeclRef = match r {
  DrWritten(Some(q), n) -> match qh_resolve_in(written_text(q), written_text(n), mt) {
    QhOk(_)           -> DrWritten(Some(written(mt_tagged_name(mt, written_text(q)))), n)
    QhBad(_, _, _, _) -> DrWritten(None, n)
  }
  _ -> r
}

fn qh_report(name: String, kind: String, cx: QhCx, line: Int, col: Int, acc: [Diagnostic]) : [Diagnostic] =
  qh_report_res(qh_resolve(name, cx.mt), kind, cx, line, col, acc)

fn qh_report_ref(r: DeclRef, kind: String, cx: QhCx, line: Int, col: Int, acc: [Diagnostic]) : [Diagnostic] = match r {
  DrWritten(Some(q), n) -> qh_report_res(qh_resolve_in(written_text(q), written_text(n), cx.mt), kind, cx, line, col, acc)
  _                     -> acc
}

fn qh_report_res(res: QhRes, kind: String, cx: QhCx, line: Int, col: Int, acc: [Diagnostic]) : [Diagnostic] = match res {
  QhOk(_) -> acc
  QhBad(mod, bare, known, exports) ->
    [mk_diag(SevError, cx.file, line, col, qh_bad_msg(mod, bare, known, exports, kind), []), ...acc]
}

fn qh_bad_msg(mod: String, bare: String, known: Bool, exports: [String], kind: String) : String =
  if known {
    concat_all(["module '", mod, "' does not export ", kind, " '", bare,
                "'; available exports: ", qh_join(exports)])
  } else {
    concat_all(["unknown module qualifier '", mod, "' in qualified ", kind,
                " '", mod, ".", bare, "'"])
  }

fn qh_join(xs: [String]) : String = match xs {
  [] -> "(none)"
  [x] -> x
  [x, ...rest] -> concat_all([x, ", ", qh_join(rest)])
}

fn qh_decl(d: Decl, mt: [ModuleEntry]) : Decl = match d {
  DFn(is_pub, fid, tps, ps, ret, row, body, l, c, mo) ->
    DFn(is_pub, fid, tps, qh_params(ps, mt), qh_ty_opt(ret, mt), qh_row(row, mt), qh_expr(body, mt), l, c, mo)
  DImpl(proto, pargs, target, methods, l, c, itps, isym) ->
    DImpl(qh_proto_ref(proto, mt), qh_tys(pargs, mt), qh_ty(target, mt), qh_sub_decls(methods, mt), l, c, itps, isym)
  DTest(desc, body, l, c, mo) -> DTest(desc, qh_expr(body, mt), l, c, mo)
  DBench(desc, body, l, c, mo) -> DBench(desc, qh_expr(body, mt), l, c, mo)
  DCheck(desc, ps, body, l, c, mo) -> DCheck(desc, qh_params(ps, mt), qh_expr(body, mt), l, c, mo)
  DConst(p, n, ty, body, mo, l, c) -> DConst(p, n, qh_ty(ty, mt), qh_expr(body, mt), mo, l, c)
  DAxiom(p, sm, n, cso, tps, ps, ret, row, l, c) ->
    DAxiom(p, sm, n, cso, tps, qh_params(ps, mt), qh_ty(ret, mt), qh_row(row, mt), l, c)
  DProtocol(p, n, tps, ops, l, c, mo) -> DProtocol(p, n, tps, qh_pops(ops, mt), l, c, mo)
  DEffect(p, n, tps, ops, dblk, l, c, mo) -> DEffect(p, n, tps, qh_eops(ops, mt), dblk, l, c, mo)
  DType(p, n, tps, body, l, c, mo, slots) -> DType(p, n, tps, qh_tbody(body, mt), l, c, mo, slots)
  DDerive(protos, inner, l, c) ->
    DDerive(map(protos, (n) => qh_proto_name(n, mt)), qh_decl(inner, mt), l, c)
  _ -> d
}

# Row labels resolve like heads: `m.E` strips to the exported `E`
# (the effect-scope pass already settled the labels it could).
fn qh_row(r: RowExpr, mt: [ModuleEntry]) : RowExpr = match r {
  REmpty -> REmpty
  RClosed(ls) -> RClosed(map(ls, (l) => qh_label(l, mt)))
  ROpen(v, ls) -> ROpen(v, map(ls, (l) => qh_label(l, mt)))
}

fn qh_label(l: RowLabel, mt: [ModuleEntry]) : RowLabel = match l {
  RL(r, ts) -> RL(qh_ref(r), qh_tys(ts, mt))
}

fn qh_tys(ts: [TypeExpr], mt: [ModuleEntry]) : [TypeExpr] = map(ts, (t) => qh_ty(t, mt))

fn qh_ty_opt(o: Option[TypeExpr], mt: [ModuleEntry]) : Option[TypeExpr] = match o {
  None -> None
  Some(t) -> Some(qh_ty(t, mt))
}

fn qh_ty(t: TypeExpr, mt: [ModuleEntry]) : TypeExpr = {
  let k = match t.tkind {
    TyName(r, ts) -> TyName(r, qh_tys(ts, mt))
    TyParam(p, ts) -> TyParam(p, qh_tys(ts, mt))
    TyList(x) -> TyList(qh_ty(x, mt))
    TyFn(ps, r, row) -> TyFn(qh_tys(ps, mt), qh_ty(r, mt), qh_row(row, mt))
    TyRow(row) -> TyRow(qh_row(row, mt))
    TyDim(x, u) -> TyDim(qh_ty(x, mt), u)
    TyRefine(x, pred) -> TyRefine(qh_ty(x, mt), pred)
    _ -> t.tkind
  }
  TypeExpr { tkind: k, line: t.line, col: t.col }
}

fn qh_params(ps: [Param], mt: [ModuleEntry]) : [Param] =
  map(ps, (p) => Param { binder: p.binder, ptype: qh_ty_opt(p.ptype, mt),
                         pline: p.pline, pcol: p.pcol, pborrow: p.pborrow })

fn qh_pops(ops: [ProtoOp], mt: [ModuleEntry]) : [ProtoOp] =
  map(ops, (o) => match o {
    POp(n, tps, ps, ret, l, c) -> POp(n, tps, qh_params(ps, mt), qh_ty(ret, mt), l, c)
  })

fn qh_eops(ops: [EffectOp], mt: [ModuleEntry]) : [EffectOp] =
  map(ops, (o) => match o {
    EffOp(n, tps, ps, ret, l, c) -> EffOp(n, tps, qh_params(ps, mt), qh_ty(ret, mt), l, c)
  })

fn qh_tbody(b: TypeBody, mt: [ModuleEntry]) : TypeBody = match b {
  TBAlias(t) -> TBAlias(qh_ty(t, mt))
  TBRecord(fs) -> TBRecord(map(fs, (f) => match f {
    FD(p, n, t, attrs) -> FD(p, n, qh_ty(t, mt), attrs)
  }))
  TBSum(vs) -> TBSum(map(vs, (v) => match v {
    Var(n, ts) -> Var(n, qh_tys(ts, mt))
  }))
  TBEffectAlias(ls) -> TBEffectAlias(map(ls, qh_alias_label))
}

fn qh_sub_decls(ds: [Decl], mt: [ModuleEntry]) : [Decl] = match ds {
  [] -> []
  [d, ...rest] -> [qh_decl(d, mt), ...qh_sub_decls(rest, mt)]
}

#[doc("Strip a validated module qualifier from every habitant head inside one expression; for callers that hold a sub-tree rather than a decl.")]
pub fn qh_expr(e: Expr, mt: [ModuleEntry]) : Expr = match e.kind {
  EHandle(body, eff, tyargs, init, alias, clauses, ret) -> {
    let head = EHandle(body, qh_ref(eff), tyargs, init, alias, clauses, ret)
    Expr { kind: prc_map_expr_kind(head, (x) => qh_expr(x, mt)),
           line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
  }
  _ -> Expr { kind: prc_map_expr_kind(e.kind, (x) => qh_expr(x, mt)),
              line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
}

fn qhchk_decl(d: Decl, cx: QhCx, acc: [Diagnostic]) : [Diagnostic] = match d {
  DFn(_, _, _, ps, ret, row, body, l, c, _) ->
    qhchk_expr(body, cx, qhchk_row(row, cx, l, c, qhchk_ty_opt(ret, cx, l, c, qhchk_params(ps, cx, l, c, acc))))
  DImpl(proto, pargs, target, methods, l, c, _, _) ->
    qhchk_sub_decls(methods, cx,
      qhchk_ty(target, cx, l, c, qhchk_tys(pargs, cx, l, c, qh_report_ref(proto, "protocol", cx, l, c, acc))))
  DTest(_, body, _, _, _) -> qhchk_expr(body, cx, acc)
  DBench(_, body, _, _, _) -> qhchk_expr(body, cx, acc)
  DCheck(_, ps, body, l, c, _) -> qhchk_expr(body, cx, qhchk_params(ps, cx, l, c, acc))
  DConst(_, _, ty, body, _, l, c) -> qhchk_expr(body, cx, qhchk_ty(ty, cx, l, c, acc))
  DAxiom(_, _, _, _, _, ps, ret, row, l, c) ->
    qhchk_row(row, cx, l, c, qhchk_ty(ret, cx, l, c, qhchk_params(ps, cx, l, c, acc)))
  DProtocol(_, _, _, ops, l, c, _) -> qhchk_pops(ops, cx, l, c, acc)
  DEffect(_, _, _, ops, _, l, c, _) -> qhchk_eops(ops, cx, l, c, acc)
  DType(_, _, _, body, l, c, _, _) -> qhchk_tbody(body, cx, l, c, acc)
  DDerive(protos, inner, l, c) -> qhchk_decl(inner, cx, qhchk_names(protos, cx, l, c, acc))
  _ -> acc
}

# A row label carries no position of its own; the declaration's stands in.
fn qhchk_row(r: RowExpr, cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match r {
  REmpty -> acc
  RClosed(ls) -> qhchk_labels(ls, cx, l, c, acc)
  ROpen(_, ls) -> qhchk_labels(ls, cx, l, c, acc)
}

fn qhchk_labels(ls: [RowLabel], cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match ls {
  [] -> acc
  [RL(r, ts), ...rest] ->
    qhchk_labels(rest, cx, l, c, qhchk_tys(ts, cx, l, c, qh_report_ref(r, "effect", cx, l, c, acc)))
}

fn qhchk_tys(ts: [TypeExpr], cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match ts {
  [] -> acc
  [t, ...rest] -> qhchk_tys(rest, cx, l, c, qhchk_ty(t, cx, l, c, acc))
}

fn qhchk_ty_opt(o: Option[TypeExpr], cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match o {
  None -> acc
  Some(t) -> qhchk_ty(t, cx, l, c, acc)
}

fn qhchk_ty(t: TypeExpr, cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match t.tkind {
  TyName(_, ts) -> qhchk_tys(ts, cx, l, c, acc)
  TyParam(_, ts) -> qhchk_tys(ts, cx, l, c, acc)
  TyList(x) -> qhchk_ty(x, cx, l, c, acc)
  TyFn(ps, r, row) -> qhchk_row(row, cx, l, c, qhchk_ty(r, cx, l, c, qhchk_tys(ps, cx, l, c, acc)))
  TyRow(row) -> qhchk_row(row, cx, l, c, acc)
  TyDim(x, _) -> qhchk_ty(x, cx, l, c, acc)
  TyRefine(x, _) -> qhchk_ty(x, cx, l, c, acc)
  _ -> acc
}

fn qhchk_params(ps: [Param], cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match ps {
  [] -> acc
  [p, ...rest] -> qhchk_params(rest, cx, l, c, qhchk_ty_opt(p.ptype, cx, l, c, acc))
}

fn qhchk_pops(ops: [ProtoOp], cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match ops {
  [] -> acc
  [POp(_, _, ps, ret, _, _), ...rest] ->
    qhchk_pops(rest, cx, l, c, qhchk_ty(ret, cx, l, c, qhchk_params(ps, cx, l, c, acc)))
}

fn qhchk_eops(ops: [EffectOp], cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match ops {
  [] -> acc
  [EffOp(_, _, ps, ret, _, _), ...rest] ->
    qhchk_eops(rest, cx, l, c, qhchk_ty(ret, cx, l, c, qhchk_params(ps, cx, l, c, acc)))
}

fn qhchk_tbody(b: TypeBody, cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match b {
  TBAlias(t) -> qhchk_ty(t, cx, l, c, acc)
  TBRecord(fs) -> qhchk_fields(fs, cx, l, c, acc)
  TBSum(vs) -> qhchk_variants(vs, cx, l, c, acc)
  TBEffectAlias(ls) -> qhchk_eff_alias(ls, cx, l, c, acc)
}

fn qhchk_fields(fs: [FieldDecl], cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match fs {
  [] -> acc
  [FD(_, _, t, _), ...rest] -> qhchk_fields(rest, cx, l, c, qhchk_ty(t, cx, l, c, acc))
}

fn qhchk_variants(vs: [Variant], cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match vs {
  [] -> acc
  [Var(_, ts), ...rest] -> qhchk_variants(rest, cx, l, c, qhchk_tys(ts, cx, l, c, acc))
}

fn qhchk_eff_alias(ls: [RowLabel], cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match ls {
  [] -> acc
  [RL(r, _), ...rest] -> qhchk_eff_alias(rest, cx, l, c, qh_report_ref(r, "effect", cx, l, c, acc))
}

fn qhchk_names(names: [String], cx: QhCx, l: Int, c: Int, acc: [Diagnostic]) : [Diagnostic] = match names {
  [] -> acc
  [n, ...rest] -> qhchk_names(rest, cx, l, c, qh_report(n, "protocol", cx, l, c, acc))
}

fn qhchk_sub_decls(ds: [Decl], cx: QhCx, acc: [Diagnostic]) : [Diagnostic] = match ds {
  [] -> acc
  [d, ...rest] -> qhchk_sub_decls(rest, cx, qhchk_decl(d, cx, acc))
}

fn qhchk_expr(e: Expr, cx: QhCx, acc: [Diagnostic]) : [Diagnostic] = match e.kind {
  EHandle(_, eff, _, _, _, _, _) ->
    qhchk_positions(xp_positions(e), cx, qh_report_ref(eff, "effect", cx, e.line, e.col, acc))
  _ -> qhchk_positions(xp_positions(e), cx, acc)
}

fn qhchk_positions(ps: [XPos], cx: QhCx, acc: [Diagnostic]) : [Diagnostic] = match ps {
  [] -> acc
  [XP(_, child), ...rest] -> qhchk_positions(rest, cx, qhchk_expr(child, cx, acc))
}
