#[doc("""
Fusion of a mutually recursive tail-call group into one self-recursive
function.

The self-tail rewrite turns `f(a)` in tail position into a jump back to
`f`'s own entry, which is why a function that only calls ITSELF runs in
constant stack. A cycle through two or more functions has no such entry
to jump to, so every hop pushes a frame.

This pass supplies one. Given a group `[f, g]` from `tailgraph`, it
mints a single function carrying a discriminant plus a slot for every
parameter, members sharing a slot where type and borrow mode agree,
whose body is a `match` on the discriminant with one arm per member. A
tail call from `f` to `g` becomes a call to that fused function with
the discriminant set to `g` and `g`'s arguments in its slots — a call
the function makes to ITSELF, in tail position, which the existing
self-tail rewrite then turns into a jump. Slots `g` does not take carry
an absent value that no arm reads. Each original function survives as a
wrapper that forwards to the fused entry, so every caller and every
address-of keeps working unchanged.

Fusing before the self-tail rewrite is what makes the mechanism shared:
the two backends inherit mutual recursion through the goto-loop they
already agree on, and neither emitter changes.

A group only fuses when its members agree on return type and effect
row and have no type parameters, since the fused entry returns for all
of them. A return type the comparison does not recognise counts as a
mismatch, so an unfamiliar type leaves the group unfused rather than
fusing it under a convention that does not hold.
""")]

import compiler.ast
import compiler.util
import compiler.tailgraph
import compiler.tailsig
import compiler.tailslots
import compiler.tailids
import compiler.resolve
import compiler.infer_index
import compiler.symtab_build
import compiler.home_tu

# The group's member names, the fused entry's name, its slot layout, the
# module the group lives in, and the ids of the member declarations —
# a resolved call names one of them outright, so the (name, module)
# walk is only what an unresolved call falls back to.
type TfCtx = TfCtx([String], TfFused, TfSlots, Option[String], [SymId])

# The fused entry: its name and the id every call to it carries.
type TfFused = TfFused(String, SymId)

# The module a group is fused in and the parameter ids the resolver recorded.
type TfIn = { target: String, pids: NameIndex[ParamIds] }

fn tfctx_names(c: TfCtx) : [String] = match c { TfCtx(ns, _, _, _, _) -> ns }
fn tfctx_lead(c: TfCtx) : TfFused = match c { TfCtx(_, l, _, _, _) -> l }
fn tfctx_slots(c: TfCtx) : TfSlots = match c { TfCtx(_, _, sl, _, _) -> sl }
fn tfctx_mo(c: TfCtx) : Option[String] = match c { TfCtx(_, _, _, m, _) -> m }
fn tfctx_syms(c: TfCtx) : [SymId] = match c { TfCtx(_, _, _, _, ss) -> ss }

#[doc("The name of the fused function minted for the group whose first member is `lead`. The name is derived from the member's own name so a group in a module lands beside it, and carries a prefix no source identifier can spell.")]
pub fn tailfuse_name(lead: String) : String = cat2("__kai_fused_", lead)

#[doc("The parameter carrying the discriminant of the fused function: the index, into the group's member list, of the member whose body should run.")]
pub fn tailfuse_tag_param() : String = "__kai_fuse_tag"

#[doc("Fuse every mutually recursive tail-call group in `decls`, returning the rewritten program. A group that does not qualify for fusion is left untouched, so a program with no mutual tail recursion comes back unchanged.")]
pub fn tailfuse_decls(decls: [Decl], target: String, pids: [ParamIds]) : [Decl] {
  let g = tailgraph_build(decls)
  match tailgraph_groups(g) {
    []     -> decls
    groups -> {
      let n = list_length(tailgraph_nodes(g))
      let fns = tf_fn_array(decls, n)
      let fn_at = (i) => array_get(fns, i)
      let ix = tfid_index(pids, tf_group_syms(groups, fn_at))
      tf_emit(decls, tf_rewrites(groups, fn_at, n, TfIn { target: target, pids: ix }), 0, [])
    }
  }
}

# Node `i` of the graph is the `i`-th function declaration.
fn tf_fn_array(decls: [Decl], n: Int) : Array[Option[Decl]] =
  tf_fn_fill(decls, 0, array_make(n, None))

fn tf_fn_fill(decls: [Decl], i: Int, fns: Array[Option[Decl]]) : Array[Option[Decl]] / Mutable =
  match decls {
    [] -> fns
    [d, ...rest] -> match d {
      DFn(_, _, _, _, _, _, _, _, _, _, _) -> tf_fn_fill(rest, i + 1, array_set(fns, i, Some(d)))
      _ -> tf_fn_fill(rest, i, fns)
    }
  }

# What replaces each function: its wrapper, preceded by the fused entry
# at the group's lead; `None` where the function is not fused.
fn tf_rewrites(groups: [TgGroup], fn_at: (Int) -> Option[Decl], n: Int, inp: TfIn) : Array[Option[[Decl]]] =
  tf_rewrite_groups(groups, fn_at, array_make(n, None), inp)

fn tf_rewrite_groups(groups: [TgGroup], fn_at: (Int) -> Option[Decl],
                     out: Array[Option[[Decl]]], inp: TfIn) : Array[Option[[Decl]]] / Mutable =
  match groups {
    [] -> out
    [grp, ...rest] -> {
      let idxs = tggroup_members(grp)
      let members = tf_member_decls(idxs, fn_at)
      if tf_group_ok(members, idxs, inp.pids) {
        tf_rewrite_groups(rest, fn_at, tf_place_group(idxs, tf_fuse_group(members, inp), out), inp)
      } else { tf_rewrite_groups(rest, fn_at, out, inp) }
    }
  }

fn tf_place_group(idxs: [Int], outs: [[Decl]], out: Array[Option[[Decl]]]) : Array[Option[[Decl]]] / Mutable =
  match idxs {
    [] -> out
    [i, ...rest] -> match outs {
      [] -> out
      [ds, ...more] -> tf_place_group(rest, more, array_set(out, i, Some(ds)))
    }
  }

# Per member, in member order: the lead's fused entry and wrapper, then
# each other member's wrapper.
fn tf_fuse_group(members: [Decl], inp: TfIn) : [[Decl]] = match members {
  [] -> []
  [lead, ..._] -> {
    let names = tf_member_names(members)
    let slots = tfslots_layout(members)
    let fz = tf_fused_of(lead, inp.target)
    let fused = tf_make_fused(lead, tfid_onto_slots(members, slots, tf_fresh_name, inp.pids), names, slots, fz)
    match map(members, (d) => tf_wrapper(d, names, tf_decl_name(d), slots, fz)) {
      [] -> []
      [w, ...ws] -> [[fused, w], ...map(ws, (x) => [x])]
    }
  }
}

fn tf_fused_of(lead: Decl, target: String) : TfFused = {
  let name = tailfuse_name(tf_decl_name(lead))
  let home = match home_tu(lead) { Some(m) -> m  None -> target }
  TfFused(name, sym_derive(NCFn, name, home))
}

fn tf_decl_name(d: Decl) : String = match d {
  DFn(_, n, _, _, _, _, _, _, _, _, _) -> n
  _ -> ""
}

fn tf_emit(decls: [Decl], out: Array[Option[[Decl]]], i: Int, acc: [Decl]) : [Decl] = match decls {
  [] -> list_reverse(acc)
  [d, ...rest] -> match d {
    DFn(_, _, _, _, _, _, _, _, _, _, _) -> match array_get(out, i) {
      Some(ds) -> tf_emit(rest, out, i + 1, tf_reverse_onto(ds, acc))
      None     -> tf_emit(rest, out, i + 1, [d, ...acc])
    }
    _ -> tf_emit(rest, out, i, [d, ...acc])
  }
}

fn tf_reverse_onto(xs: [Decl], acc: [Decl]) : [Decl] = match xs {
  [] -> acc
  [x, ...rest] -> tf_reverse_onto(rest, [x, ...acc])
}

# ---- eligibility ---------------------------------------------------

fn tf_group_syms(groups: [TgGroup], fn_at: (Int) -> Option[Decl]) : [SymId] = match groups {
  []             -> []
  [grp, ...rest] -> list_append(tf_member_syms(tf_member_decls(tggroup_members(grp), fn_at)), tf_group_syms(rest, fn_at))
}

fn tf_group_ok(members: [Decl], idxs: [Int], pids: NameIndex[ParamIds]) : Bool =
  if list_length(members) != list_length(idxs) { false }
  else { match members {
    []              -> false
    [lead, ...rest] -> tfsig_members_match(rest, lead) and tfid_all_renamable(members, pids)
  } }

fn tf_member_decls(idxs: [Int], fn_at: (Int) -> Option[Decl]) : [Decl] = match idxs {
  [] -> []
  [i, ...rest] -> match fn_at(i) {
    Some(d) -> [d, ...tf_member_decls(rest, fn_at)]
    None    -> tf_member_decls(rest, fn_at)
  }
}

# ---- rewrite -------------------------------------------------------

fn tf_member_names(ds: [Decl]) : [String] = match ds {
  [] -> []
  [d, ...rest] -> match d {
    DFn(_, n, _, _, _, _, _, _, _, _, _) -> [n, ...tf_member_names(rest)]
    _ -> tf_member_names(rest)
  }
}

# The fused function takes the discriminant first, then the slots, and
# dispatches to the member bodies with every in-group tail call
# retargeted at itself.
fn tf_make_fused(lead: Decl, members: [Decl], names: [String], slots: TfSlots, fz: TfFused) : Decl {
  match lead {
    DFn(_, _, tparams, _, opt_ret, row, _, ln, cl, mo, _) -> match slots {
      TfSlots(sps, layout) -> match fz {
        TfFused(fname, fsid) -> {
          let fresh = tf_fresh_params(sps, 0)
          let ctx = TfCtx(names, fz, slots, mo, tf_member_syms(members))
          DFn(false, fname, tparams, [tf_tag_param(ln, cl), ...fresh],
              opt_ret, row, tf_dispatch_body(members, layout, ctx, ln, cl),
              ln, cl, mo, fnid_decl(fsid))
        }
      }
    }
    _ -> lead
  }
}

# The fused entry binds names no source can spell, so substituting a
# member's parameters into them cannot capture one of that member's own
# locals — the reason every member, the lead included, is rewritten.
fn tf_fresh_params(params: [Param], i: Int) : [Param] = match params {
  [] -> []
  [p, ...rest] ->
    [Param { pname: tf_fresh_name(i), ptype: p.ptype, pline: p.pline,
             pcol: p.pcol, pborrow: p.pborrow },
     ...tf_fresh_params(rest, i + 1)]
}

fn tf_fresh_name(i: Int) : String = cat2("__kai_fp", int_to_string(i))

fn tf_tag_param(ln: Int, cl: Int) : Param =
  Param { pname: tailfuse_tag_param(), ptype: Some(tf_int_ty(ln, cl)),
          pline: ln, pcol: cl, pborrow: false }

fn tf_int_ty(ln: Int, cl: Int) : TypeExpr =
  TypeExpr { tkind: TyName(None, "Int", []), line: ln, col: cl }

fn tf_dispatch_body(members: [Decl], layout: [[Int]], ctx: TfCtx,
                    ln: Int, cl: Int) : Expr =
  mk_expr(EMatch(mk_ref(tailfuse_tag_param(), ln, cl),
                 tf_dispatch_arms(members, layout, ctx, 0)), ln, cl)

# The id of each member declaration, positionally aligned with `names`.
fn tf_member_syms(ms: [Decl]) : [SymId] = match ms {
  [] -> []
  [d, ...rest] -> [tf_decl_sym(d), ...tf_member_syms(rest)]
}

fn tf_decl_sym(d: Decl) : SymId = match d {
  DFn(_, _, _, _, _, _, _, _, _, _, fsym) -> fnid_sym(fsym)
  _ -> sym_none()
}

fn tf_dispatch_arms(members: [Decl], layout: [[Int]], ctx: TfCtx, i: Int) : [Arm] {
  match members {
    [] -> []
    [d, ...rest] -> match layout {
      [] -> []
      [_, ...more] -> {
        let last = list_is_empty(rest)
        [tf_arm_for(d, ctx, i, last), ...tf_dispatch_arms(rest, more, ctx, i + 1)]
      }
    }
  }
}

# The final arm is the catch-all so the match is total without relying
# on the discriminant's range being known to the checker.
fn tf_arm_for(d: Decl, ctx: TfCtx, i: Int, last: Bool) : Arm {
  match d {
    DFn(_, _, _, _, _, _, body, ln, cl, _, _) ->
      Arm(tf_arm_pattern(i, last, ln, cl), None, tf_retarget_in(body, ctx, []))
    _ -> Arm(tf_arm_pattern(i, last, 0, 0), None, mk_expr(EUnit, 0, 0))
  }
}

# A fused call's slot arguments: the member argument a slot holds, the
# absent value where it holds none.
fn tf_slot_args(xs: [Expr], idxs: [Int], at: Int, n: Int, ln: Int, cl: Int) : [Expr] =
  if at >= n { [] }
  else {
    let here = match tf_arg_for(xs, idxs, at) {
      Some(x) -> x
      None    -> tf_absent(ln, cl)
    }
    [here, ...tf_slot_args(xs, idxs, at + 1, n, ln, cl)]
  }

fn tf_arg_for(xs: [Expr], idxs: [Int], slot: Int) : Option[Expr] = match xs {
  [] -> None
  [x, ...rest] -> match idxs {
    [] -> None
    [i, ...more] -> if i == slot { Some(x) } else { tf_arg_for(rest, more, slot) }
  }
}

fn tf_absent(ln: Int, cl: Int) : Expr = mk_expr(EIntrinsic(tfslots_absent(), []), ln, cl)

# Slots out of parameter order would evaluate the arguments out of source
# order, so unless every argument is an atom they are bound first.
fn tf_slot_call(fz: TfFused, tag: Int, xs: [Expr], slots: TfSlots, ln: Int, cl: Int) : Expr =
  match slots {
    TfSlots(sps, layout) -> {
      let idxs = tf_layout_at(layout, tag)
      if tf_ascending(idxs, -1) or tf_all_atoms(xs) {
        tf_fused_call(fz, tag, tf_slot_args(xs, idxs, 0, list_length(sps), ln, cl), ln, cl)
      } else {
        let names = tf_arg_names(xs, 0)
        let refs = map(names, (nm) => mk_ref(nm, ln, cl))
        mk_expr(EBlock(tf_arg_lets(names, xs, ln, cl),
                       Some(tf_fused_call(fz, tag, tf_slot_args(refs, idxs, 0, list_length(sps), ln, cl), ln, cl))),
                ln, cl)
      }
    }
  }

fn tf_fused_call(fz: TfFused, tag: Int, args: [Expr], ln: Int, cl: Int) : Expr = match fz {
  TfFused(name, sid) ->
    mk_expr(ECall(mk_expr(ESym(sid, spec_none(), name), ln, cl), [mk_expr(mk_int_synth(tag), ln, cl), ...args]), ln, cl)
}

fn tf_ascending(idxs: [Int], prev: Int) : Bool = match idxs {
  [] -> true
  [i, ...rest] -> i > prev and tf_ascending(rest, i)
}

fn tf_all_atoms(xs: [Expr]) : Bool = match xs {
  [] -> true
  [x, ...rest] -> tf_is_atom(x) and tf_all_atoms(rest)
}

fn tf_is_atom(x: Expr) : Bool = match x.kind {
  EVar(_)       -> true
  ESym(_, _, _) -> true
  EInt(_, _)    -> true
  EReal(_, _)   -> true
  EBool(_)      -> true
  EChar(_)      -> true
  EUnit         -> true
  _             -> false
}

fn tf_arg_names(xs: [Expr], i: Int) : [String] = match xs {
  [] -> []
  [_, ...rest] -> [cat2("__kai_fa", int_to_string(i)), ...tf_arg_names(rest, i + 1)]
}

fn tf_arg_lets(names: [String], xs: [Expr], ln: Int, cl: Int) : [Stmt] = match names {
  [] -> []
  [nm, ...rest] -> match xs {
    [] -> []
    [x, ...more] ->
      [SLet(Pattern { pkind: PBind(nm), line: ln, col: cl }, None, x), ...tf_arg_lets(rest, more, ln, cl)]
  }
}

fn tf_layout_at(layout: [[Int]], i: Int) : [Int] = match layout {
  [] -> []
  [h, ...rest] -> if i <= 0 { h } else { tf_layout_at(rest, i - 1) }
}

fn tf_arm_pattern(i: Int, last: Bool, ln: Int, cl: Int) : Pattern =
  if last { Pattern { pkind: PWild, line: ln, col: cl } }
  else { Pattern { pkind: PLit(mk_expr(mk_int_synth(i), ln, cl)), line: ln, col: cl } }

# ---- wrappers ------------------------------------------------------

# Every member keeps its name as a wrapper forwarding to the fused
# entry, so callers outside the group are untouched; the fused function
# lands ahead of the group's lead.
fn tf_wrapper(d: Decl, names: [String], n: String, slots: TfSlots, fz: TfFused) : Decl = match d {
  DFn(is_pub, name, tparams, params, opt_ret, row, _, ln, cl, mo, fsym) ->
    match tf_name_index(names, n, 0) {
      None      -> d
      Some(tag) ->
        DFn(is_pub, name, tparams, params, opt_ret, row,
            tf_slot_call(fz, tag, tf_param_args(params, ln, cl), slots, ln, cl),
            ln, cl, mo, fsym)
    }
  _ -> d
}

fn tf_param_args(params: [Param], ln: Int, cl: Int) : [Expr] = match params {
  [] -> []
  [p, ...rest] -> [mk_ref(p.pname, ln, cl), ...tf_param_args(rest, ln, cl)]
}

# ---- retargeting in-group tail calls -------------------------------

# A tail call to a group member becomes a self-call of the fused entry
# with the member's discriminant prepended; that is the call the
# self-tail rewrite later turns into a jump.
# `scope` carries the names an enclosing binder rebound: a local
# shadowing a member's name is not that member, so a call through it
# keeps its callee.
fn tf_retarget_in(body: Expr, ctx: TfCtx, scope: [String]) : Expr =
  mk_expr(tf_retarget_kind(body.kind, ctx, scope), body.line, body.col)

fn tf_retarget_kind(k: ExprKind, ctx: TfCtx, scope: [String]) : ExprKind {
  match k {
    ECall(f, xs) -> tf_retarget_call(k, f, xs, ctx, scope)
    EIf(c, t, opt_e) ->
      EIf(c, tf_retarget_in(t, ctx, scope), tf_retarget_opt(opt_e, ctx, scope))
    EMatch(scr, arms) -> EMatch(scr, tf_retarget_arms(arms, ctx, scope))
    EBlock(stmts, opt_tail) ->
      EBlock(stmts, tf_retarget_opt(opt_tail, ctx, tf_block_scope(stmts, scope)))
    _ -> k
  }
}

fn tf_block_scope(stmts: [Stmt], scope: [String]) : [String] {
  match stmts {
    [] -> scope
    [s, ...rest] -> tf_block_scope(rest, tf_stmt_scope(s, scope))
  }
}

fn tf_stmt_scope(s: Stmt, scope: [String]) : [String] = match s {
  SLet(pat, _, _)        -> pat_bindings(pat, scope)
  SVar(name, _, _, _, _) -> [name, ...scope]
  _                      -> scope
}

fn tf_retarget_opt(opt_e: Option[Expr], ctx: TfCtx, scope: [String]) : Option[Expr] =
  match opt_e {
    None    -> None
    Some(e) -> Some(tf_retarget_in(e, ctx, scope))
  }

fn tf_retarget_arms(arms: [Arm], ctx: TfCtx, scope: [String]) : [Arm] {
  match arms {
    [] -> []
    [Arm(p, guard, body), ...rest] ->
      [Arm(p, guard, tf_retarget_in(body, ctx, pat_bindings(p, scope))),
       ...tf_retarget_arms(rest, ctx, scope)]
  }
}

# The callee must name a member of THIS group: same module, matching
# arity, not shadowed. A bare name resolves against the group's own
# module, a qualified one only when the qualifier IS that module — a
# same-named function in another module is a different function.
fn tf_retarget_call(k: ExprKind, f: Expr, xs: [Expr], ctx: TfCtx,
                    scope: [String]) : ExprKind {
  match tf_member_index(f.kind, ctx, scope) {
    None    -> k
    Some(i) -> match tfctx_slots(ctx) {
      TfSlots(_, layout) ->
        if list_length(tf_layout_at(layout, i)) != list_length(xs) { k }
        else { tf_slot_call(tfctx_lead(ctx), i, xs, tfctx_slots(ctx), f.line, f.col).kind }
    }
  }
}

fn tf_member_index(fk: ExprKind, ctx: TfCtx, scope: [String]) : Option[Int] {
  match fk {
    # A resolved call names one declaration: the member is found by id,
    # with no (name, module) pair to agree on. A local's id indexes no
    # member, and the scope keeps it from matching one by name.
    ESym(s, _, n)      -> match tf_sym_index(tfctx_syms(ctx), s, 0) {
                         Some(i) -> Some(i)
                         None    -> if sym_raw(s) >= 0 { None } else { tf_lookup_member(n, ctx, scope) }
                       }
    EVar(n)         -> tf_lookup_member(n, ctx, scope)
    EModCall(cm, n) ->
      if tf_mod_is_own(cm, tfctx_mo(ctx)) { tf_lookup_member(n, ctx, scope) } else { None }
    _ -> None
  }
}

fn tf_lookup_member(n: String, ctx: TfCtx, scope: [String]) : Option[Int] =
  if list_has(scope, n) { None } else { tf_name_index(tfctx_names(ctx), n, 0) }

# The group member a resolved call reaches. Members the resolver never
# stamped carry no id and never match.
fn tf_sym_index(syms: [SymId], s: SymId, i: Int) : Option[Int] = match syms {
  [] -> None
  [h, ...rest] ->
    if sym_raw(h) >= 0 and sym_raw(h) == sym_raw(s) { Some(i) }
    else { tf_sym_index(rest, s, i + 1) }
}

fn tf_name_index(names: [String], n: String, i: Int) : Option[Int] = match names {
  [] -> None
  [h, ...rest] -> if h == n { Some(i) } else { tf_name_index(rest, n, i + 1) }
}

fn tf_mod_is_own(callmod: String, mo: Option[String]) : Bool = match mo {
  None    -> false
  Some(m) -> m == callmod
}
