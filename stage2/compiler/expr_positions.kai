#[doc("""
The single description of `ExprKind`'s sub-expression positions.

Read-side dual of `ast_map.kai`: where `prc_map_expr_kind` rebuilds a
node from mapped children, `xp_positions` enumerates the children with
the ROLE each occupies, flattening the `Stmt` / `Arm` / `HClause` /
`ListElem` / `FieldInit` substructure so a scan never touches those
shapes directly. Ownership walkers consult this enumeration instead of
replicating it: a walker keeps explicit arms only for the variants it
genuinely treats specially and descends through `xp_positions` for the
rest. A new `ExprKind` variant is then a compile error HERE, once, and
every table-driven walker inherits the decision — two walkers can no
longer disagree about which positions exist.

Roles say when a child runs relative to its parent:

- `XAll` — evaluated whenever the parent is, on every path (call args,
  binop operands, if-conditions, match scrutinees, block stmts + tail).
- `XBr`  — an alternative: evaluated on some paths only, but the
  alternatives jointly cover the parent (if branches, match guards and
  arm bodies). A per-branch analysis can place a payment on the
  sibling paths.
- `XSc`  — a short-circuit continuation: the right operand of `and` /
  `or`. Skippable with NO covering alternative — the skipped path
  falls through the same expression, so nothing downstream can pay
  for what the operand would have consumed.
- `XLam` — a lambda body: deferred to call time, closure boundary.
- `XCl`  — a handler clause or `return(x)` body: runs on effect
  dispatch, not where the `handle` is evaluated.
- `XMsg` — an assert message: evaluated only on the aborting path
  (short-circuit-like: no covering alternative).

Positions this table cannot carry, by construction:

- A string pattern's interpolation reads live in its raw source span,
  not in child `Expr` nodes.
- Pattern binders are not expressions; scope-tracking walkers still own
  their binder bookkeeping.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_build
import compiler.operators

#[doc("When a child position runs relative to its parent. See the module doc for the role vocabulary.")]
pub(pkg) type XRole = XAll | XBr | XSc | XLam | XCl | XMsg

#[doc("One child position: the role it occupies and the sub-expression in it.")]
pub(pkg) type XPos = XP(XRole, Expr)

#[doc("True for positions evaluated in place when the parent evaluates (on every or some path): `XAll`, `XBr`, `XSc`, `XMsg`. False for the deferred bodies `XLam` / `XCl`.")]
pub(pkg) fn xrole_inline(r: XRole) : Bool = match r {
  XAll -> true
  XBr  -> true
  XSc  -> true
  XMsg -> true
  XLam -> false
  XCl  -> false
}

#[doc("""
Every direct sub-expression of `e` with its role, in source order.
The one exhaustive enumeration of `ExprKind`'s positions — walkers
descend through this list instead of matching the variants themselves.
""")]
pub(pkg) fn xp_positions(e: Expr) : [XPos] = xp_positions_kind(e.kind)

#[doc("`xp_positions` for walkers that carry a bare `ExprKind`.")]
pub(pkg) fn xp_positions_kind(k: ExprKind) : [XPos] = match k {
  # Leaves: literals, names, markers — no sub-expression positions.
  EInt(_, _)        -> []
  EReal(_, _)       -> []
  EFixed(_, _)      -> []
  EIntLit(_)        -> []
  EDecimalLit(_)    -> []
  EBool(_)          -> []
  EChar(_)          -> []
  EStr(_, _)        -> []
  EUnit             -> []
  EName(_)          -> []
  EMark(_)          -> []
  ESym(_, _)        -> []
  ELocal(_)         -> []
  EOp(_)            -> []
  EUnder            -> []
  EPlaceholder      -> []
  EHole(_)          -> []
  ETodo(_)          -> []
  EExternBody(_, _) -> []
  EVariantsOf(_, _) -> []
  EModCall(_, _)    -> []

  ECall(f, xs)       -> [XP(XAll, f), ...xp_all(xs)]
  EField(b, _)       -> [XP(XAll, b)]
  EIndex(a, b)       -> [XP(XAll, a), XP(XAll, b)]
  # `and` / `or` short-circuit: the right operand runs on some paths only,
  # and no alternative covers the skipped path.
  EBinop(op, a, b)   -> [XP(XAll, a), XP(if binop_is_logical(op) { XSc } else { XAll }, b)]
  EUnop(_, x)        -> [XP(XAll, x)]
  EIf(c, t, oe)      -> [XP(XAll, c), XP(XBr, t), ...xp_opt(XBr, oe)]
  EMatch(s, arms)    -> [XP(XAll, s), ...xp_arms(arms)]
  ELambda(_, b)      -> [XP(XLam, b)]
  ERecordLit(_, fs)  -> xp_fields(fs)
  EList(els)         -> xp_elems(els)
  ERange(a, b, os)   -> [XP(XAll, a), XP(XAll, b), ...xp_opt(XAll, os)]
  EBlock(ss, ot)     -> xp_stmts(ss, xp_opt(XAll, ot))
  EPipe(a, b)        -> [XP(XAll, a), XP(XAll, b)]
  EDispatchPipe(_, a, b) -> [XP(XAll, a), XP(XAll, b)]
  EBang(x)           -> [XP(XAll, x)]
  EHandle(body, _, _, oi, _, cls, oret) ->
    xp_onto(XAll, oi, [XP(XAll, body), ...xp_clauses(cls, xp_hret(oret))])
  ELitUnit(x, _)     -> [XP(XAll, x)]
  EIntrinsic(_, xs)  -> xp_all(xs)
  ESurface(sf)       -> xp_all(surface_children(sf))
}

fn xp_all(xs: [Expr]) : [XPos] = match xs {
  []           -> []
  [h, ...rest] -> [XP(XAll, h), ...xp_all(rest)]
}

fn xp_opt(r: XRole, o: Option[Expr]) : [XPos] = xp_onto(r, o, [])

# `o`'s position, if any, in front of `tail`.
fn xp_onto(r: XRole, o: Option[Expr], tail: [XPos]) : [XPos] = match o {
  None    -> tail
  Some(x) -> [XP(r, x), ...tail]
}

# A guard runs only if the pattern matched; a body only if the guard
# also passed. Both are branch positions of the match.
fn xp_arms(arms: [Arm]) : [XPos] = match arms {
  []           -> []
  [Arm(_, og, b), ...rest] -> xp_onto(XBr, og, [XP(XBr, b), ...xp_arms(rest)])
}

# The statements' positions in front of `tail`.
fn xp_stmts(ss: [Stmt], tail: [XPos]) : [XPos] = match ss {
  []           -> tail
  [s, ...rest] -> xp_stmt(s, xp_stmts(rest, tail))
}

#[doc("The expression positions of one statement.")]
pub(pkg) fn xp_stmt_positions(s: Stmt) : [XPos] = xp_stmt(s, [])

fn xp_stmt(s: Stmt, tail: [XPos]) : [XPos] = match s {
  SLet(_, _, rhs)             -> [XP(XAll, rhs), ...tail]
  SVar(_, _, init, _, _)      -> [XP(XAll, init), ...tail]
  SExprStmt(x)                -> [XP(XAll, x), ...tail]
  SAssert(c, om)              -> [XP(XAll, c), ...xp_onto(XMsg, om, tail)]
  SIndexAssign(a, i, v, _, _) -> [XP(XAll, a), XP(XAll, i), XP(XAll, v), ...tail]
  SAssign(a, v, _, _)         -> [XP(XAll, a), XP(XAll, v), ...tail]
  SUse(_, _, _)               -> tail
}

fn xp_fields(fs: [FieldInit]) : [XPos] = match fs {
  []                  -> []
  [FI(_, x), ...rest] -> [XP(XAll, x), ...xp_fields(rest)]
}

fn xp_elems(els: [ListElem]) : [XPos] = match els {
  []           -> []
  [el, ...rest] -> {
    let inner = match el { ElPlain(x) -> x ElSpread(x) -> x }
    [XP(XAll, inner), ...xp_elems(rest)]
  }
}

fn xp_clauses(cls: [HClause], tail: [XPos]) : [XPos] = match cls {
  []           -> tail
  [HC(_, _, b, _, _), ...rest] -> [XP(XCl, b), ...xp_clauses(rest, tail)]
}

fn xp_hret(o: Option[HReturn]) : [XPos] = match o {
  None                 -> []
  Some(HR(_, b, _, _)) -> [XP(XCl, b)]
}

#[doc("""
True when `p` holds for `e` or a node below it; with `inline`, lambda and
handler-clause bodies are not entered. Walks the same positions as
`xp_positions` without building them, so a yes/no scan allocates nothing.
""")]
pub(pkg) fn xp_exists(e: Expr, inline: Bool, p: (Expr) -> Bool) : Bool = p(e) or xe_kind(e.kind, inline, p)

fn xe_kind(k: ExprKind, inline: Bool, p: (Expr) -> Bool) : Bool = match k {
  EInt(_, _)        -> false
  EReal(_, _)       -> false
  EFixed(_, _)      -> false
  EIntLit(_)        -> false
  EDecimalLit(_)    -> false
  EBool(_)          -> false
  EChar(_)          -> false
  EStr(_, _)        -> false
  EUnit             -> false
  EName(_)          -> false
  EMark(_)          -> false
  ESym(_, _)        -> false
  ELocal(_)         -> false
  EOp(_)            -> false
  EUnder            -> false
  EPlaceholder      -> false
  EHole(_)          -> false
  ETodo(_)          -> false
  EExternBody(_, _) -> false
  EVariantsOf(_, _) -> false
  EModCall(_, _)    -> false
  ECall(f, xs)       -> xp_exists(f, inline, p) or xe_all(xs, inline, p)
  EField(b, _)       -> xp_exists(b, inline, p)
  EIndex(a, b)       -> xe2(a, b, inline, p)
  EBinop(_, a, b)    -> xe2(a, b, inline, p)
  EUnop(_, x)        -> xp_exists(x, inline, p)
  EIf(c, t, oe)      -> xe2(c, t, inline, p) or xe_opt(oe, inline, p)
  EMatch(s, arms)    -> xp_exists(s, inline, p) or xe_arms(arms, inline, p)
  ELambda(_, b)      -> not inline and xp_exists(b, inline, p)
  ERecordLit(_, fs)  -> xe_fields(fs, inline, p)
  EList(els)         -> xe_elems(els, inline, p)
  ERange(a, b, os)   -> xe2(a, b, inline, p) or xe_opt(os, inline, p)
  EBlock(ss, ot)     -> xe_stmts(ss, inline, p) or xe_opt(ot, inline, p)
  EPipe(a, b)        -> xe2(a, b, inline, p)
  EDispatchPipe(_, a, b) -> xe2(a, b, inline, p)
  EBang(x)           -> xp_exists(x, inline, p)
  EHandle(body, _, _, oi, _, cls, oret) ->
    xe_opt(oi, inline, p) or xp_exists(body, inline, p) or xe_deferred(cls, oret, inline, p)
  ELitUnit(x, _)     -> xp_exists(x, inline, p)
  EIntrinsic(_, xs)  -> xe_all(xs, inline, p)
  ESurface(sf)       -> xe_all(surface_children(sf), inline, p)
}

fn xe2(a: Expr, b: Expr, inline: Bool, p: (Expr) -> Bool) : Bool = xp_exists(a, inline, p) or xp_exists(b, inline, p)

fn xe_deferred(cls: [HClause], oret: Option[HReturn], inline: Bool, p: (Expr) -> Bool) : Bool =
  not inline and (xe_clauses(cls, p) or xe_hret(oret, p))

fn xe_all(xs: [Expr], inline: Bool, p: (Expr) -> Bool) : Bool = match xs {
  []           -> false
  [h, ...rest] -> xp_exists(h, inline, p) or xe_all(rest, inline, p)
}

fn xe_opt(o: Option[Expr], inline: Bool, p: (Expr) -> Bool) : Bool = match o {
  None    -> false
  Some(x) -> xp_exists(x, inline, p)
}

fn xe_arms(arms: [Arm], inline: Bool, p: (Expr) -> Bool) : Bool = match arms {
  [] -> false
  [Arm(_, og, b), ...rest] -> xe_opt(og, inline, p) or xp_exists(b, inline, p) or xe_arms(rest, inline, p)
}

fn xe_stmts(ss: [Stmt], inline: Bool, p: (Expr) -> Bool) : Bool = match ss {
  [] -> false
  [s, ...rest] -> xe_stmt(s, inline, p) or xe_stmts(rest, inline, p)
}

fn xe_stmt(s: Stmt, inline: Bool, p: (Expr) -> Bool) : Bool = match s {
  SLet(_, _, rhs)             -> xp_exists(rhs, inline, p)
  SVar(_, _, init, _, _)      -> xp_exists(init, inline, p)
  SExprStmt(x)                -> xp_exists(x, inline, p)
  SAssert(c, om)              -> xp_exists(c, inline, p) or xe_opt(om, inline, p)
  SIndexAssign(a, i, v, _, _) -> xe2(a, i, inline, p) or xp_exists(v, inline, p)
  SAssign(a, v, _, _)         -> xe2(a, v, inline, p)
  SUse(_, _, _)               -> false
}

fn xe_fields(fs: [FieldInit], inline: Bool, p: (Expr) -> Bool) : Bool = match fs {
  [] -> false
  [FI(_, x), ...rest] -> xp_exists(x, inline, p) or xe_fields(rest, inline, p)
}

fn xe_elems(els: [ListElem], inline: Bool, p: (Expr) -> Bool) : Bool = match els {
  [] -> false
  [el, ...rest] -> match el {
    ElPlain(x)  -> xp_exists(x, inline, p) or xe_elems(rest, inline, p)
    ElSpread(x) -> xp_exists(x, inline, p) or xe_elems(rest, inline, p)
  }
}

fn xe_clauses(cls: [HClause], p: (Expr) -> Bool) : Bool = match cls {
  [] -> false
  [HC(_, _, b, _, _), ...rest] -> xp_exists(b, false, p) or xe_clauses(rest, p)
}

fn xe_hret(o: Option[HReturn], p: (Expr) -> Bool) : Bool = match o {
  None                 -> false
  Some(HR(_, b, _, _)) -> xp_exists(b, false, p)
}

#[doc("True when `e` is a postfix `!`.")]
pub(pkg) fn xp_is_bang(e: Expr) : Bool = match e.kind {
  EBang(_) -> true
  _        -> false
}
