#[doc("""
Reading a declaration's type parameters.

A parameter is its `TBinder`: an id, the written name, a kind and its
protocol bounds. Every lookup here is by id; the name is read only to
show the parameter or to mangle a symbol.
""")]

import compiler.ast
import compiler.written

#[doc("The name a type parameter was written with: for a diagnostic, a dump or an emitted symbol.")]
pub fn tb_text(b: TBinder) : String = written_text(b.name)

#[doc("True when the parameter ranges over a unit kind's habitants.")]
pub fn tb_is_unit(b: TBinder) : Bool = match b.kind {
  KUnit(_) -> true
  _        -> false
}

#[doc("True when the parameter ranges over arity-1 constructors.")]
pub fn tb_is_shape(b: TBinder) : Bool = match b.kind {
  KShape -> true
  _      -> false
}

#[doc("True for a row variable a signature uses without declaring it: it holds no position among the type arguments.")]
pub fn tb_is_row(b: TBinder) : Bool = match b.kind {
  KRow           -> true
  KRowHole(_, _) -> true
  _              -> false
}

#[doc("True for a row hole (`/ ?e`): a row parameter no name reaches.")]
pub fn tb_is_hole(b: TBinder) : Bool = match b.kind {
  KRowHole(_, _) -> true
  _              -> false
}

#[doc("True for a plain type-kind parameter.")]
pub fn tb_is_type(b: TBinder) : Bool = match b.kind {
  KType -> true
  _     -> false
}

#[doc("The unit kind a parameter ranges over, empty for any other parameter.")]
pub fn tb_unit_kind(b: TBinder) : String = match b.kind {
  KUnit(k) -> k
  _        -> ""
}

#[doc("The parameter without its protocol bounds.")]
pub fn tb_unbounded(b: TBinder) : TBinder =
  TBinder { id: b.id, name: b.name, kind: b.kind, bounds: [], implicit: b.implicit }

#[doc("The parameters the source listed in `[...]`.")]
pub fn tbs_declared(tps: [TBinder]) : [TBinder] = filter(tps, (b) => not b.implicit)

#[doc("The parameters that hold a position among a declaration's type arguments: all but the undeclared row variables.")]
pub fn tbs_positional(tps: [TBinder]) : [TBinder] = filter(tps, (b) => not tb_is_row(b))

#[doc("The parameter numbered `id`, if the list binds it.")]
pub fn tbs_find(tps: [TBinder], id: TLocalId) : Option[TBinder] = match tps {
  []           -> None
  [b, ...rest] -> if tlocal_eq(b.id, id) { Some(b) } else { tbs_find(rest, id) }
}

#[doc("True when the list binds the parameter numbered `id`.")]
pub fn tbs_has(tps: [TBinder], id: TLocalId) : Bool = match tbs_find(tps, id) {
  Some(_) -> true
  None    -> false
}

#[doc("The zero-based position of the parameter numbered `id`, or -1.")]
pub fn tbs_index(tps: [TBinder], id: TLocalId) : Int = tbs_index_from(tps, id, 0)

fn tbs_index_from(tps: [TBinder], id: TLocalId, i: Int) : Int = match tps {
  []           -> 0 - 1
  [b, ...rest] -> if tlocal_eq(b.id, id) { i } else { tbs_index_from(rest, id, i + 1) }
}

#[doc("The ids of the parameters, in order.")]
pub fn tbs_ids(tps: [TBinder]) : [TLocalId] = map(tps, (b) => b.id)

#[doc("The written names of the parameters, in order: for a diagnostic or a dump.")]
pub fn tbs_texts(tps: [TBinder]) : [String] = map(tps, tb_text)

#[doc("True when `ids` holds `id`.")]
pub fn tids_has(ids: [TLocalId], id: TLocalId) : Bool = match ids {
  []           -> false
  [x, ...rest] -> if tlocal_eq(x, id) { true } else { tids_has(rest, id) }
}

#[doc("`ids` with `id` appended unless it is already there.")]
pub fn tids_add(ids: [TLocalId], id: TLocalId) : [TLocalId] =
  if tids_has(ids, id) { ids } else { list_append(ids, [id]) }

#[doc("A spelling made from a parameter's id alone: a key, or a dispatch head, that tells two parameters apart whatever they are called. C-safe, and lowercase-initial so no declared type shares it.")]
pub fn tparam_key(id: TLocalId) : String = {
  let n = tlocal_raw(id)
  if n >= 0 { string_concat("tparam", int_to_string(n)) } else { string_concat("tparamm", int_to_string(0 - n)) }
}

#[doc("A use of the parameter `b` as a type, at a position.")]
pub fn tb_use(b: TBinder, line: Int, col: Int) : TypeExpr = mk_ty(TyParam(b.id, []), line, col)

#[doc("The name of the parameter numbered `id` among `tps`, or a placeholder when the list does not bind it: for a diagnostic or a dump.")]
pub fn tbs_text_of(tps: [TBinder], id: TLocalId) : String = match tbs_find(tps, id) {
  Some(b) -> tb_text(b)
  None    -> "?"
}

#[doc("A row tail as the source spells it while it is still written: a row variable's name, `?` or `?name` for a hole. A numbered tail has no spelling of its own.")]
pub fn tail_written_text(t: TParamRef) : String = match t {
  TpWritten(n)          -> written_text(n)
  TpHole(None, _, _)    -> "?"
  TpHole(Some(n), _, _) -> string_concat("?", n)
  TpId(_)               -> "_"
}

#[doc("How a type parameter prints: by the name its binder among `tps` carries, `_` when none of them binds it.")]
pub fn tparam_display(tps: [TBinder], id: TLocalId) : String = match tbs_find(tps, id) {
  Some(b) -> if tb_is_hole(b) { string_concat("?", tb_text(b)) } else { tb_text(b) }
  None    -> "_"
}

#[doc("How a row tail prints under the parameters `tps`.")]
pub fn tail_display(tps: [TBinder], t: TParamRef) : String = match t {
  TpId(id) -> tparam_display(tps, id)
  _        -> tail_written_text(t)
}

#[doc("The row parameter a tail names, the unnumbered id while it is still written.")]
pub fn tail_id(t: TParamRef) : TLocalId = match t {
  TpId(id) -> id
  _        -> tlocal_none()
}
