#[doc("Overflow-checked Int arithmetic for compile-time folding: None when the exact result is not representable.")]

#[doc("Largest Int.")]
pub(pkg) fn int_max_value() : Int = 9223372036854775807

#[doc("Smallest Int.")]
pub(pkg) fn int_min_value() : Int = 0 - 9223372036854775807 - 1

#[doc("a + b, or None on overflow.")]
pub(pkg) fn checked_add(a: Int, b: Int) : Option[Int] =
  if b > 0 and a > int_max_value() - b {
    None
  } else if b < 0 and a < int_min_value() - b {
    None
  } else {
    Some(a + b)
  }

#[doc("a - b, or None on overflow.")]
pub(pkg) fn checked_sub(a: Int, b: Int) : Option[Int] =
  if b < 0 and a > int_max_value() + b {
    None
  } else if b > 0 and a < int_min_value() + b {
    None
  } else {
    Some(a - b)
  }

#[doc("a * b, or None on overflow.")]
pub(pkg) fn checked_mul(a: Int, b: Int) : Option[Int] =
  if a == 0 or b == 0 {
    Some(0)
  } else if a == 0 - 1 {
    checked_neg(b)
  } else if b == 0 - 1 {
    checked_neg(a)
  } else {
    let r = a * b
    if r / b == a { Some(r) } else { None }
  }

#[doc("0 - a, or None when a is the smallest Int.")]
pub(pkg) fn checked_neg(a: Int) : Option[Int] =
  if a == int_min_value() { None } else { Some(0 - a) }

#[doc("a / b, or None on a zero divisor or MIN / -1.")]
pub(pkg) fn checked_div(a: Int, b: Int) : Option[Int] =
  if b == 0 or (a == int_min_value() and b == 0 - 1) { None } else { Some(a / b) }

#[doc("a % b, or None on a zero divisor or MIN % -1.")]
pub(pkg) fn checked_mod(a: Int, b: Int) : Option[Int] =
  if b == 0 or (a == int_min_value() and b == 0 - 1) { None } else { Some(a % b) }
