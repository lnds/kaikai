#[doc("Shared text helpers of the KIR to C operation printer: array literals, the fn-wide token registers and the raw-register tests.")]

import compiler.kir
import compiler.kir_c_core
import compiler.emit_native_fn
import compiler.emit_native_trmc
import compiler.util

#[doc("A C compound-literal array of `elems` typed `cty`, or `NULL` when there are none.")]
pub fn kc_arr(cty: String, elems: [String]) : String = match elems {
  [] -> "NULL"
  _  -> concat_all(["(", cty, "[]){", kc_args(elems), "}"])
}

#[doc("The boxed atoms of `vs` as printed expressions.")]
pub fn kc_atoms(cx: KcCx, vs: [KVal]) : [String] = map(vs, (v) => kc_atom(cx, v))

#[doc("An `int32_t` literal.")]
pub fn kc_i32(n: Int) : String = concat_all(["(int32_t)", kc_int_lit(n)])

#[doc("The fn being printed.")]
pub fn kc_cur_fn(cx: KcCx) : Option[KFn] = nfnx_by_sym(cx.fx, cx.cur)

#[doc("Whether the fn being printed takes the hidden donor token parameter.")]
pub fn kc_fn_has_donor(cx: KcCx) : Bool = match kc_cur_fn(cx) {
  Some(f) -> f.donor
  None    -> false
}

#[doc("Whether the fn being printed keeps an arm-top reuse token register.")]
pub fn kc_fn_has_armru(cx: KcCx) : Bool = match kc_cur_fn(cx) {
  Some(f) -> ntrmc_blocks_have_step(f.blocks)
  None    -> false
}

fn kc_take_reg(r: String) : String =
  concat_all(["({ KaiValue *t_ = ", r, "; ", r, " = NULL; t_; })"])

#[doc("The token a call to a donation-capable callee receives: the live arm-top token moved out of its register, or NULL.")]
pub fn kc_donate_token(cx: KcCx) : String =
  if kc_fn_has_armru(cx) { kc_take_reg(kc_reg(ntrmc_armru_reg())) } else { "NULL" }

#[doc("The cross-call donor token moved out of its register, or NULL when the fn has no donor channel.")]
pub fn kc_donor_token(cx: KcCx) : String =
  if kc_fn_has_donor(cx) { kc_take_reg(kc_reg(ndonor_reg())) } else { "NULL" }

#[doc("Whether a register of slot tag `t` is a raw scalar that owns no reference.")]
pub fn kc_tag_is_raw(t: Int) : Bool = t == 1 or t == 2 or t == 3 or t == 5 or t == 6 or t == 7 or t == 8 or t == 9 or t == 10

#[doc("Whether `v` names a register holding a raw scalar.")]
pub fn kc_val_is_raw(cx: KcCx, v: KVal) : Bool = match v {
  KVar(n) -> kc_tag_is_raw(kc_reg_tag(cx, n))
  _       -> false
}
