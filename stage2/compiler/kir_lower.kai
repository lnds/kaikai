#[doc("The KIR lowering state: the register and label supply, scope and rename bookkeeping, block accumulation and the result records the lowering passes thread.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.core_builtins
import compiler.ctor_ix
import compiler.effect_instance
import compiler.emit_shared_fv
import compiler.emit_shared_syms
import compiler.emit_tcrec_live
import compiler.enc_unit
import compiler.fn_index
import compiler.fnreg
import compiler.infer_index
import compiler.handler_alias
import compiler.kir
import compiler.kir_lin_model
import compiler.local_names
import compiler.perceus_reuse
import compiler.rec_stamp
import compiler.region
import compiler.spec_names
import compiler.symtab
import compiler.unwind_clauses
import compiler.unwind_pend
import compiler.util
import compiler.written

# Threaded immutably through the lowering, mirroring `EmitCtx`. A record
# (not a positional tuple) so adding a field — lams / enc_fn for closure
# lowering — does not touch every destructure site. Fields: per-function
# The per-slot RC plan of a nested (non-bijective) variant reuse arm's
# pattern, computed at the arm bind site and carried to the rebuild site
# through `LowerSt.rnested`. `RNBind(i, l)` is a heap-box slot bound to the
# binder `l`; `RNDrop(i)` a heap-box slot with no live binder, whose old value
# the unique branch must dispose by projection. Tagged-immediate (Int)
# slots carry no entry.
pub type RNSlot = RNBind(Int, LocalId) | RNDrop(Int)

# `RNI(oarity, nslot, n_inner, directs, grands)`: the matched ctor's arity,
# the index of its single nested sub-pattern slot, the inner ctor's arity,
# and the slot plans for the outer (direct) and inner (grand) levels.
# `RNInone` = the arm is not a single-nested rotation shape (the rebuild
# keeps the fresh-alloc path).
pub type ReuseNested = RNInone | RNI(Int, Int, Int, [RNSlot], [RNSlot])

# A reuse arm's slot plans: `rot` for a nested rebuild; `flat` (the direct
# slots that are not inner cells) and `cells` for a flat one.
pub type ReusePlan = { rot: ReuseNested, flat: [RNSlot], cells: [(Int, ReuseCell)] }

pub fn reuse_plan_none() : ReusePlan = ReusePlan { rot: RNInone, flat: [], cells: [] }

# reg + block-label counters, finished blocks (generation order), current
# block label, current block's reversed statement list, the EFn symbol
# table, the core builtins' rows keyed by id, the variant→tag table and
# its rows keyed by constructor id, the lifted-lambda table (`find_lam`),
# the lifted clauses (a handle reads its env layout from them), and the
# enclosing unit both lookups are scoped by.
pub(pkg) type LowerSt = { rc: Int, bc: Int, bs: [KBlock], cl: String, ss: [KStmt],
                     fns: [EFn], fx: FnIndex, core_ix: CoreIx, ctor_ix: CtorIx, vs: [VariantEntry], lams: [LamInfo], cls: [ClauseInfo], enc_fn: EncFn,
                     consts: [Decl],
                     # `regs` is the names of the registers live in the
                     # current lexical scope: params, captures, and every
                     # `KLet` / `KStore` destination. Registers are
                     # name-keyed allocas, so a binder whose name is taken
                     # binds a fresh one (`ls_bind`). Seeded at fn entry,
                     # extended at each binding statement, restored at a
                     # block's exit.
                     regs: NameIndex[String],
                     # `ffi` is the set of `extern "C" fn` declarations.
                     # An FFI wrapper's kaikai-visible symbol is mangled to
                     # `__ffi_<c_sym>` (via `ffi_wrapper_sym`) so it does NOT
                     # collide with the bare C symbol it calls (`puts`, `abs`)
                     # in the same module. Both the wrapper def and EVERY
                     # call site must mint the same mangled name.
                     ffi: [SymId],
                     # `scope` maps each local in scope to the register it
                     # was bound to, innermost first: every read of a local
                     # goes through it. A block restores it on exit.
                     scope: [Rename],
                     # `mscr` is the FRESH owned-scrutinee exit-drop binder
                     # (`<join>$sd`) of the match CURRENTLY being lowered, or ""
                     # outside any owned match. The TRMC cons-modulo step
                     # (`__kai_cons_s`, map/filter) drops the consumed scrutinee
                     # in the native emitter, but it lowers via the `ECall`
                     # dispatch, far from the match arm where the drop binder is
                     # named — so the name travels here. Nested owned matches
                     # mint distinct `$sd` names (the `max([T])`/`min([T])`
                     # double-free fix); a fixed literal would alias them into
                     # one native alloca. Saved/restored around each match like
                     # `regs`.
                     mscr: String,
                     # `reuse_gc` carries the POINTER-kind scrutinee binders
                     # a variant REUSE arm projects (top-level + one-level
                     # nested grand-children — the rb-tree rotation kept
                     # children). Like `mscr`, the reuse op lowers far from the
                     # arm pattern (inside the body, possibly under an `if`), so
                     # the names travel here. `lower_reuse_con` counts each
                     # binder's uses in the rebuild and emits one
                     # `kai_incref_if_shared(donor, child)` per use, so a SHARED
                     # donor's fresh-alloc keeps a ref the match-exit decref
                     # would otherwise cascade-free. Set per reuse arm, restored
                     # around each match like `mscr`; "" / [] outside one.
                     reuse_gc: [LocalId],
                     # `rnested` is the slot plan of the current variant REUSE
                     # arm. Like `reuse_gc`, the rebuild site
                     # (`lower_reuse_con`) sits far from the arm pattern, so
                     # the plan travels here. Set per reuse arm alongside
                     # `reuse_gc`; `reuse_plan_none()` everywhere else.
                     rnested: ReusePlan,
                     # `recs` is the program's record table. Record-literal and
                     # reuse-rebuild assembly index through `rec_field_index` to
                     # emit fields in DECLARATION order, the canonical layout the
                     # constant-index field read relies on. Shared (never reset);
                     # threaded verbatim through every fn-entry / state rebuild.
                     recs: [RecInfo],
                     # Head tags of the stamped record types (`rec_stamp`).
                     stamps: [RecStamp],
                     # `in_region` is true while lowering a body that bump-
                     # allocates into the ambient arena: a region-branded fn
                     # (`fn_has_region_brand` on its signature) sets it for the
                     # whole body, a lexical `region { }` block sets it for the
                     # block's extent (saved/restored around the block like
                     # `scope`). Each `KCon`/`KRecord` reads it, so the native
                     # emitter routes the ctor to `kaix_arena_*`. The C oracle
                     # reads the same predicate via `EmitCtx.in_region`.
                     in_region: Bool,
                     # `regions` is the `region { }` side table (keyed by the
                     # block's source position), the SAME list the C oracle
                     # carries as `EmitCtx.regions`. `lower_block` consults it
                     # to bracket a lexical region body with arena push/pop +
                     # deep-copy-out. Shared (never reset).
                     regions: [RegionMark],
                     # `raw_binders` is the native-raw match-arm Int binder side
                     # table (keyed by `PBind` source position), decided once in
                     # the unbox phase (`native_raw_arm_binders`) and READ here by
                     # `bind_slot_kslot` so the KSlot verdict never re-derives
                     # rawness from the perceus-mutated body (#1229). Shared
                     # (never reset); empty under the C backend.
                     raw_binders: [RawArmBinder],
                     # `tcpend` is the pending-release ledger for the tcrec
                     # goto-tail path (emit_tcrec_live entries): enclosing owned
                     # match scrutinee registers plus not-yet-consumed arm-binder
                     # dups. Seeded per arm body that can reach a goto, refined
                     # across branch points, and read by `lower_tcrec`, which
                     # drops each surviving entry before sealing the back-edge.
                     # Restored around each match like `mscr`; [] outside one.
                     tcpend: [TclEntry],
                     # The current frame's unwind sites (unwind_pend.kai).
                     unw: UnwFrame,
                     # The program's root file basename — see EmitCtx.root_mod
                     # in emit_c.kai.
                     root_mod: Option[String],
                     # An enclosing arm holds the fn-wide arm-top reuse token,
                     # so a nested arm must not capture over it.
                     arm_tok: Bool,
                     # The instances the `handle`s around the walk position
                     # install, innermost first: an op of one of them reaches
                     # that handler, not the fn's frame slot. A handle's body
                     # extends it; restored at the body's exit.
                     handles: [InstKey],
                     # The symbol table and the specialisations' emitted
                     # names, which spell a declaration's symbol; the
                     # binders of the declaration being lowered, which spell
                     # a local's register.
                     tab: SymTab, specs: SpecNames, locals: LocalNames }

# A local in scope paired with the register it is read from.
pub type Rename = Rn(LocalId, String)

# Result of lowering one expression: its value atom + threaded state.
pub(pkg) type LRes = LRes(KVal, LowerSt)

# Result of lowering a list of expressions: their atoms + threaded state.
pub type LResMany = LResMany([KVal], LowerSt)

pub(pkg) type LSReg = LSReg(String, LowerSt)

# Match-preamble result: the join register, the FRESH owned-scrutinee exit-drop
# binder (`<join>$sd`, unique per match so nested matches never share one alloca
# in the native flat register table), and the threaded state.
pub type LSPre = LSPre(String, String, LowerSt)

pub(pkg) type LSLabel = LSLabel(String, LowerSt)

pub(pkg) type LSL3 = LSL3(String, String, String, LowerSt)

pub(pkg) type LSL2 = LSL2(String, String, LowerSt)

pub type ArmPlan = ArmPlan([KCase], LowerSt)

pub type RecPlan = RecPlan([KFieldInit], LowerSt)

# An optional lowered value (handler state init) + threaded state.
pub type LResOpt = LResOpt(Option[KVal], LowerSt)

pub fn ls_new(fns: [EFn], fx: FnIndex, variants: [VariantEntry], ctors: CtorIx, lams: [LamInfo], cls: [ClauseInfo],
              consts: [Decl], ffi: [SymId], recs: [RecInfo], stamps: [RecStamp], regions: [RegionMark], raw_binders: [RawArmBinder], root_mod: Option[String],
              tab: SymTab, specs: SpecNames) : LowerSt =
  LowerSt { rc: 0, bc: 0, bs: [], cl: "entry", ss: [], fns: fns, fx: fx, core_ix: core_ix_build(), ctor_ix: ctors, vs: variants,
            lams: lams, cls: cls, enc_fn: enc_none(), consts: consts, regs: idx_empty(), ffi: ffi, scope: [], mscr: "", reuse_gc: [], rnested: reuse_plan_none(), recs: recs, stamps: stamps, in_region: false, regions: regions, raw_binders: raw_binders, tcpend: [], unw: unw_frame_none(unw_cx_empty()), root_mod: root_mod, arm_tok: false, handles: [],
            tab: tab, specs: specs, locals: ln_empty() }

#[doc("`st` with the arm-top token marked held (or released).")]
pub fn ls_set_arm_tok(st: LowerSt, held: Bool) : LowerSt = LowerSt { ...st, arm_tok: held }

# Reset the per-function counters and block buffers, preserving the shared
# tables. `enc_fn` is the fn / lambda / clause / runner the body's nested
# lambdas are scoped by (`find_lam` keys on it); `entry` the registers its
# params and captures are read from; `locals` the binders of the declaration
# it belongs to; `body_fns` the EFn table. Called at the head of every KFn
# lowering.
pub fn ls_enter_fn_with(st: LowerSt, enc_fn: EncFn, entry: EntryRegs, locals: LocalNames,
                        body_fns: [EFn]) : LowerSt =
  LowerSt { ...st, rc: 0, bc: 0, bs: [], cl: "entry", ss: [], fns: body_fns, enc_fn: enc_fn,
            regs: regs_of_names(entry.regs, idx_empty()), scope: list_append(entry.scope, implicit_scope()), mscr: "", reuse_gc: [], rnested: reuse_plan_none(), in_region: false,
            tcpend: [], unw: unw_blank(st.unw), arm_tok: false, handles: [], locals: kir_body_locals(locals) }

#[doc("What a body starts with: the register each param and capture is read from, and the names of the registers they take.")]
pub type EntryRegs = { scope: [Rename], regs: [String] }

fn regs_of_names(names: [String], ix: NameIndex[String]) : NameIndex[String] = match names {
  [] -> ix
  [n, ...rest] -> regs_of_names(rest, idx_prepend(ix, n, n))
}

#[doc("The register of the local `l`, one per binder of the declaration `locals` lists.")]
pub(pkg) fn kir_local_reg(locals: LocalNames, l: LocalId) : String = emitted_text(ln_emitted(locals, l))

#[doc("The entry registers of a parameter list on top of `captured`: each param is read from its binder's register.")]
pub fn entry_params(params: [Param], locals: LocalNames, captured: EntryRegs) : EntryRegs = match params {
  [] -> captured
  [p, ...rest] -> {
    let reg = kir_local_reg(locals, p.binder.id)
    entry_params(rest, locals, EntryRegs { scope: [Rn(p.binder.id, reg), ...captured.scope], regs: [reg, ...captured.regs] })
  }
}

#[doc("The entry registers of a lambda's or clause's captures: a captured binder is read from its register; an alias is known by its register, which holds nothing here, and takes the register holding its handler id.")]
pub fn entry_captures(caps: [Capture], locals: LocalNames) : EntryRegs = match caps {
  [] -> EntryRegs { scope: [], regs: [] }
  [c, ...rest] -> {
    let name = kir_local_reg(locals, capture_local(c))
    let more = entry_captures(rest, locals)
    EntryRegs { scope: [Rn(capture_local(c), name), ...more.scope], regs: list_append(capture_taken(c, name), more.regs) }
  }
}

# The registers the capture of the binder at `name` takes: a local its
# own, an alias the one holding its handler id beside it.
fn capture_taken(c: Capture, name: String) : [String] = match c {
  CapLocal(_) -> [name]
  CapAlias(_) -> [kir_alias_id_reg(name), name]
}

fn capture_local(c: Capture) : LocalId = match c {
  CapLocal(l) -> l
  CapAlias(a) -> a
}

# The continuation every clause body reads is declared by no node: it is
# read from the register a clause's continuation param is stored in.
fn implicit_scope() : [Rename] = [Rn(local_minted(canonical_continuation()), kir_resume_reg())]

#[doc("`ns` with the binders a body reads and no node declares: the handler-state aliases and the continuation, each minted under its key.")]
pub fn kir_body_locals(ns: LocalNames) : LocalNames =
  body_locals_loop([canonical_continuation(), var_cell_alias(), ...user_state_aliases()], ns)

fn body_locals_loop(keys: [String], ns: LocalNames) : LocalNames = match keys {
  []           -> ns
  [k, ...rest] -> body_locals_loop(rest, ln_with_binder(ns, binder_minted(k)))
}

#[doc("`st` inside the body of a `handle` that installs the instance `k`.")]
pub fn ls_in_handle(st: LowerSt, k: InstKey) : LowerSt = LowerSt { ...st, handles: [k, ...st.handles] }

#[doc("`st` with the enclosing `handle`s restored to `hs`.")]
pub fn ls_set_handles(st: LowerSt, hs: [InstKey]) : LowerSt = LowerSt { ...st, handles: hs }

#[doc("True when a `handle` around the walk position installs an instance the op of instance `k` reaches.")]
pub fn ls_handled_here(st: LowerSt, k: InstKey) : Bool = any(st.handles, (h) => inst_keys_match(h, k))

#[doc("The state with `u` as the current frame's unwind sites.")]
pub fn ls_with_unw(st: LowerSt, u: UnwFrame) : LowerSt = LowerSt { ...st, unw: u }

# Extend the lexical scope with one bound register. Forward-visible: a
# register is in scope only after its definition. Idempotent.
pub fn ls_bind_reg(st: LowerSt, reg: String) : LowerSt =
  if ls_reg_bound(st, reg) { st } else { LowerSt { ...st, regs: idx_prepend(st.regs, reg, reg) } }

# Is `reg` the name of a register live in the current scope?
pub fn ls_reg_bound(st: LowerSt, reg: String) : Bool = name_in_list(idx_chain(st.regs, reg), reg)

# Set the current match's owned-scrutinee exit-drop binder (`<join>$sd`), so a
# TRMC cons-modulo step lowered inside this match drops the right register. Saved
# (read `st.mscr`) and restored around each match, like the `scope` snapshot.
pub fn ls_set_mscr(st: LowerSt, sd: String) : LowerSt = LowerSt { ...st, mscr: sd }

# Replace the tcrec goto-tail pending-release ledger (entering an arm body /
# refining across a branch point). Restored around each match like `mscr`.
pub fn ls_set_tcpend(st: LowerSt, l: [TclEntry]) : LowerSt = LowerSt { ...st, tcpend: l }

# Set the reuse arm's scrutinee pointer-binders so a `KConReuse` lowered
# inside this arm's body emits the shared-donor incref. Saved (read
# `st.reuse_gc`) and restored around each match like `mscr`.
pub fn ls_set_reuse_gc(st: LowerSt, gc: [LocalId]) : LowerSt = LowerSt { ...st, reuse_gc: gc }

# Set the reuse arm's slot plan (see `ReusePlan`). Travels
# with `reuse_gc` — same set/clear discipline, same arm scope.
pub fn ls_set_rnested(st: LowerSt, rn: ReusePlan) : LowerSt = LowerSt { ...st, rnested: rn }

# --- The register scope ----------------------------------------------------

#[doc("Bind `b` to its register, the one of its id. The caller emits the statement that defines it.")]
pub fn ls_bind(st: LowerSt, b: Binder) : LSReg = {
  let reg = kir_local_reg(st.locals, b.id)
  LSReg(reg, ls_scope_put(ls_bind_reg(st, reg), b.id, reg))
}

#[doc("Bind the alias `b` of an install to its register: the node lives there and the handler id in `kir_alias_id_reg` of it.")]
pub fn ls_bind_alias(st: LowerSt, b: Binder) : LSReg = match ls_bind(st, b) {
  LSReg(reg, st1) -> LSReg(reg, ls_bind_reg(st1, kir_alias_id_reg(reg)))
}

#[doc("Bind `b` to its register and define it as `op` at `slot`.")]
pub fn ls_let(st: LowerSt, b: Binder, slot: KSlot, op: KOp, pos: KPos) : LowerSt =
  match ls_bind(st, b) { LSReg(reg, st1) -> ls_emit(st1, KLet(reg, slot, op, pos)) }

#[doc("`st` with the local `l` read from `reg`. A block restores the prior scope on exit.")]
pub fn ls_scope_put(st: LowerSt, l: LocalId, reg: String) : LowerSt =
  LowerSt { ...st, scope: [Rn(l, reg), ...st.scope] }

# The innermost binding wins.
fn ls_scope_find(rs: [Rename], l: LocalId) : Option[String] = match rs {
  []                -> None
  [Rn(n, r), ...rest] -> if local_eq(n, l) { Some(r) } else { ls_scope_find(rest, l) }
}

#[doc("True when the local `l` is bound to a register in the current scope.")]
pub fn ls_local_bound(st: LowerSt, l: LocalId) : Bool = match ls_scope_find(st.scope, l) {
  Some(_) -> true
  None    -> false
}

#[doc("The register the local `l` was bound to.")]
pub fn ls_reg_of(st: LowerSt, l: LocalId) : String = match ls_scope_find(st.scope, l) {
  Some(reg) -> reg
  None      -> panic(concat_all(["identity: local ", int_to_string(local_raw(l)), " (", written_text(ln_text(st.locals, l)), ") of ", st.enc_fn.sym, " is read outside its scope"]))
}

#[doc("The name the local `l` was written with.")]
pub fn ls_local_name(st: LowerSt, l: LocalId) : String = {
  let w = written_text(ln_text(st.locals, l))
  if w == "" { panic(concat_all(["identity: the name of local ", int_to_string(local_raw(l)), " of ", st.enc_fn.sym, " in ls_local_name"])) } else { w }
}

#[doc("The register a lambda or clause reads the capture `c` from inside its own body: the captured binder's, or the one holding the alias's handler id.")]
pub fn kir_capture_name(locals: LocalNames, c: Capture) : String = match c {
  CapLocal(l) -> kir_local_reg(locals, l)
  CapAlias(a) -> kir_alias_id_reg(kir_local_reg(locals, a))
}

#[doc("True when `l` is one of `xs`.")]
pub fn lid_has(xs: [LocalId], l: LocalId) : Bool = match xs {
  []           -> false
  [h, ...rest] -> local_eq(h, l) or lid_has(rest, l)
}

#[doc("`xs` without its repeats, first occurrences in order.")]
pub fn lid_uniq(xs: [LocalId]) : [LocalId] = lid_uniq_go(xs, [])

fn lid_uniq_go(xs: [LocalId], seen: [LocalId]) : [LocalId] = match xs {
  []           -> []
  [x, ...rest] -> if lid_has(seen, x) { lid_uniq_go(rest, seen) } else { [x, ...lid_uniq_go(rest, [x, ...seen])] }
}

# Restore `scope` to a snapshot taken at block entry. `rc` (the fresh-reg
# counter) is intentionally NOT restored — it stays monotone so sibling
# blocks that shadow the same name receive distinct `.tN` registers.
pub fn ls_set_scope(st: LowerSt, snap: [Rename]) : LowerSt = LowerSt { ...st, scope: snap }

# Restore the live-register names to a block-entry snapshot, so registers
# defined inside the block leave scope at its exit. Paired with
# `ls_set_scope` in `lower_block`.
pub fn ls_set_regs(st: LowerSt, snap: NameIndex[String]) : LowerSt = LowerSt { ...st, regs: snap }

# Set the arena-routing flag. `lower_fn` seeds it from the signature brand;
# `lower_block` sets it for a lexical `region { }` extent and restores the
# prior value at the block's exit.
pub fn ls_set_in_region(st: LowerSt, b: Bool) : LowerSt = LowerSt { ...st, in_region: b }

# A fresh virtual-register name, deterministic per function: `.t0`, `.t1`, …
# The leading `.` is load-bearing, NOT cosmetic: a temporary shares the
# fn's register table (string-keyed allocas) with the SURFACE binder names
# that `bind_pattern_fields` emits verbatim (`PBind(name) -> KLet(name, …)`).
# A user / stdlib binder named `t2` (e.g. `stdlib/collections/map.kai`'s
# `TNode(xk, xv, _, t1, t2)`) would ALIAS a `t2` temporary — same alloca,
# the second store clobbers the first. When their slots also differ (a
# `tagof` temporary is `SInt32`, the surface sub-tree binder is `SBoxed`)
# the clobber surfaces as `Call parameter type does not match function
# signature` at verify; when the slots happen to match it corrupts silently.
# `.` is rejected by the lexer in a surface identifier, so a `.tN` temporary
# can NEVER collide with a surface name — an impossibility, not a heuristic
# (`__t` would only lower the odds: a user CAN write `__t2`). LLVM accepts
# `.` in a local value name (the walk already appends `.addr` to allocas).
pub(pkg) fn ls_fresh_reg(st: LowerSt) : LSReg =
  LSReg(cat2(".t", int_to_string(st.rc)), ls_with_rc(st, st.rc + 1))

# A fresh block label, deterministic per function: `L0`, `L1`, …
pub(pkg) fn ls_fresh_label(st: LowerSt) : LSLabel =
  LSLabel(cat2("L", int_to_string(st.bc)), ls_with_bc(st, st.bc + 1))

# --- Field updaters (record copy-with) ----------------------------------

fn ls_with_rc(st: LowerSt, rc: Int) : LowerSt = LowerSt { ...st, rc: rc }

fn ls_with_bc(st: LowerSt, bc: Int) : LowerSt = LowerSt { ...st, bc: bc }

# --- Block accumulation -------------------------------------------------

# Append one statement to the block under construction (stored reversed).
# A binder statement (`KLet` / `KStore`) also EXTENDS `regs` with its
# destination — the single chokepoint every match/let/record/variant
# binder funnels through, so the scope set stays complete without
# threading a bind callback through each binding site.
pub(pkg) fn ls_emit(st: LowerSt, s: KStmt) : LowerSt =
  ls_emit_raw(ls_bind_reg_of(st, s), s)

# The register a binder statement introduces, if any (`KLet`/`KStore` dest).
fn ls_bind_reg_of(st: LowerSt, s: KStmt) : LowerSt = match s {
  KLet(name, _, _, _) -> ls_bind_reg(st, name)
  KStore(name, _, _)  -> ls_bind_reg(st, name)
  _                   -> st
}

fn ls_emit_raw(st: LowerSt, s: KStmt) : LowerSt = LowerSt { ...st, ss: [s, ...st.ss] }

# Seal the current block with a terminator and start a fresh block under
# `next_label`. The sealed block joins `blocks` in generation order.
pub(pkg) fn ls_seal(st: LowerSt, term: KTerm, next_label: String) : LowerSt =
  LowerSt { ...st,
            bs: [KBlock { label: st.cl, stmts: list_reverse(st.ss), term: term, region_id: None }, ...st.bs],
            cl: next_label, ss: [] }

# Seal the final block without opening a successor (function exit). When
# the body ends in a tail terminator, the final block is the dead successor
# `seal_tail` opened: nothing branches to it and no value reaches its `ret`,
# so it ends in `unreachable` rather than returning a placeholder.
pub fn ls_finish(st: LowerSt, term: KTerm) : [KBlock] = {
  let t = match term {
    KRet(_, p) if ls_cursor_dead(st) -> KUnreachable(p)
    _                                -> term
  }
  list_reverse([KBlock { label: st.cl, stmts: list_reverse(st.ss), term: t, region_id: None }, ...st.bs])
}

# The open block is past the entry and no sealed block branches to it.
fn ls_cursor_dead(st: LowerSt) : Bool =
  not list_is_empty(st.bs) and not any(st.bs, (b) => list_has(klc_succ(b.term), st.cl))

pub fn name_in_list(xs: [String], target: String) : Bool = match xs {
  [] -> false
  [h, ...rest] -> if h == target { true } else { name_in_list(rest, target) }
}

