# compiler/kir_lower.kai — KIR lowering base: state, name supply, block
# accumulation, type/decl walks, and the pure helpers.
#
# This module holds everything the Expr→ANF recursion in
# `kir_lower_walk.kai` builds ON but that does NOT itself recurse through
# `lower_expr`. Keeping the non-recursive base here and the mutual
# recursion (expr ↔ call ↔ if/match) in the walk module lets the import
# DAG stay acyclic (base ← walk, never base → walk) while each file stays
# small and A-grade.
#
# Determinism: byte-id of the downstream output
# requires (a) ANF flattening uses fixed left-to-right order; (b) virtual
# register names come from a monotonic counter RESET PER FUNCTION; (c)
# blocks are emitted in generation order, never from a hash set. `LowerSt`
# carries the per-function counter and the in-progress block list.

import compiler.ast
import compiler.decl_names
import compiler.written
import compiler.symtab
import compiler.decl_text
import compiler.spec_names
import compiler.local_names
import compiler.emit_tcrec_live
import compiler.effect_default
import compiler.util
import compiler.fnreg
import compiler.fn_index
import compiler.fn_csym
import compiler.core_prims
import compiler.core_builtins
import compiler.core_prim_ix
import compiler.ctor_ix
import compiler.emit_shared
import compiler.core_effects
import compiler.region
import compiler.reuse_cells
import compiler.kir
import compiler.rt_name
import compiler.enc_unit
import compiler.effect_instance
import compiler.kir_lin_cfg
import compiler.unwind_pend
import compiler.unwind_cx
import compiler.handler_alias
import compiler.rec_stamp

# --- Lowering state -----------------------------------------------------

# Threaded immutably through the lowering, mirroring `EmitCtx`. A record
# (not a positional tuple) so adding a field — lams / enc_fn for closure
# lowering — does not touch every destructure site. Fields: per-function
# The per-slot RC plan of a nested (non-bijective) variant reuse arm's
# pattern, computed at the arm bind site and carried to the rebuild site
# through `LowerSt.rnested`. `RNBind(i, l)` is a heap-box slot bound to the
# binder `l`; `RNDrop(i)` a heap-box slot with no live binder, whose old value
# the unique branch must dispose by projection. Tagged-immediate (Int)
# slots carry no entry.
pub type RNSlot = RNBind(Int, LocalId) | RNDrop(Int)

# `RNI(oarity, nslot, n_inner, directs, grands)`: the matched ctor's arity,
# the index of its single nested sub-pattern slot, the inner ctor's arity,
# and the slot plans for the outer (direct) and inner (grand) levels.
# `RNInone` = the arm is not a single-nested rotation shape (the rebuild
# keeps the fresh-alloc path).
pub type ReuseNested = RNInone | RNI(Int, Int, Int, [RNSlot], [RNSlot])

# A reuse arm's slot plans: `rot` for a nested rebuild; `flat` (the direct
# slots that are not inner cells) and `cells` for a flat one.
pub type ReusePlan = { rot: ReuseNested, flat: [RNSlot], cells: [(Int, ReuseCell)] }

pub fn reuse_plan_none() : ReusePlan = ReusePlan { rot: RNInone, flat: [], cells: [] }

# reg + block-label counters, finished blocks (generation order), current
# block label, current block's reversed statement list, the EFn symbol
# table, the core builtins' rows keyed by id, the variant→tag table and
# its rows keyed by constructor id, the lifted-lambda table (`find_lam`),
# and the enclosing unit the lambda lookup is scoped by.
pub type LowerSt = { rc: Int, bc: Int, bs: [KBlock], cl: String, ss: [KStmt],
                     fns: [EFn], fx: FnIndex, core_ix: CoreIx, ctor_ix: CtorIx, vs: [VariantEntry], lams: [LamInfo], enc_fn: EncFn,
                     consts: [Decl],
                     # `regs` is the names of the registers live in the
                     # current lexical scope: params, captures, and every
                     # `KLet` / `KStore` destination. Registers are
                     # name-keyed allocas, so a binder whose name is taken
                     # binds a fresh one (`ls_bind`). Seeded at fn entry,
                     # extended at each binding statement, restored at a
                     # block's exit.
                     regs: [String],
                     # `ffi` is the set of `extern "C" fn` declarations.
                     # An FFI wrapper's kaikai-visible symbol is mangled to
                     # `__ffi_<c_sym>` (via `ffi_wrapper_sym`) so it does NOT
                     # collide with the bare C symbol it calls (`puts`, `abs`)
                     # in the same module. Both the wrapper def and EVERY
                     # call site must mint the same mangled name.
                     ffi: [SymId],
                     # `scope` maps each local in scope to the register it
                     # was bound to, innermost first: every read of a local
                     # goes through it. A block restores it on exit.
                     scope: [Rename],
                     # `mscr` is the FRESH owned-scrutinee exit-drop binder
                     # (`<join>$sd`) of the match CURRENTLY being lowered, or ""
                     # outside any owned match. The TRMC cons-modulo step
                     # (`__kai_cons_s`, map/filter) drops the consumed scrutinee
                     # in the native emitter, but it lowers via the `ECall`
                     # dispatch, far from the match arm where the drop binder is
                     # named — so the name travels here. Nested owned matches
                     # mint distinct `$sd` names (the `max([T])`/`min([T])`
                     # double-free fix); a fixed literal would alias them into
                     # one native alloca. Saved/restored around each match like
                     # `regs`.
                     mscr: String,
                     # `reuse_gc` carries the POINTER-kind scrutinee binders
                     # a variant REUSE arm projects (top-level + one-level
                     # nested grand-children — the rb-tree rotation kept
                     # children). Like `mscr`, the reuse op lowers far from the
                     # arm pattern (inside the body, possibly under an `if`), so
                     # the names travel here. `lower_reuse_con` counts each
                     # binder's uses in the rebuild and emits one
                     # `kai_incref_if_shared(donor, child)` per use, so a SHARED
                     # donor's fresh-alloc keeps a ref the match-exit decref
                     # would otherwise cascade-free. Set per reuse arm, restored
                     # around each match like `mscr`; "" / [] outside one.
                     reuse_gc: [LocalId],
                     # `rnested` is the slot plan of the current variant REUSE
                     # arm. Like `reuse_gc`, the rebuild site
                     # (`lower_reuse_con`) sits far from the arm pattern, so
                     # the plan travels here. Set per reuse arm alongside
                     # `reuse_gc`; `reuse_plan_none()` everywhere else.
                     rnested: ReusePlan,
                     # `recs` is the program's record table. Record-literal and
                     # reuse-rebuild assembly index through `rec_field_index` to
                     # emit fields in DECLARATION order, the canonical layout the
                     # constant-index field read relies on. Shared (never reset);
                     # threaded verbatim through every fn-entry / state rebuild.
                     recs: [RecInfo],
                     # Head tags of the stamped record types (`rec_stamp`).
                     stamps: [RecStamp],
                     # `in_region` is true while lowering a body that bump-
                     # allocates into the ambient arena: a region-branded fn
                     # (`fn_has_region_brand` on its signature) sets it for the
                     # whole body, a lexical `region { }` block sets it for the
                     # block's extent (saved/restored around the block like
                     # `scope`). Each `KCon`/`KRecord` reads it, so the native
                     # emitter routes the ctor to `kaix_arena_*`. The C oracle
                     # reads the same predicate via `EmitCtx.in_region`.
                     in_region: Bool,
                     # `regions` is the `region { }` side table (keyed by the
                     # block's source position), the SAME list the C oracle
                     # carries as `EmitCtx.regions`. `lower_block` consults it
                     # to bracket a lexical region body with arena push/pop +
                     # deep-copy-out. Shared (never reset).
                     regions: [RegionMark],
                     # `raw_binders` is the native-raw match-arm Int binder side
                     # table (keyed by `PBind` source position), decided once in
                     # the unbox phase (`native_raw_arm_binders`) and READ here by
                     # `bind_slot_kslot` so the KSlot verdict never re-derives
                     # rawness from the perceus-mutated body (#1229). Shared
                     # (never reset); empty under the C backend.
                     raw_binders: [RawArmBinder],
                     # `tcpend` is the pending-release ledger for the tcrec
                     # goto-tail path (emit_tcrec_live entries): enclosing owned
                     # match scrutinee registers plus not-yet-consumed arm-binder
                     # dups. Seeded per arm body that can reach a goto, refined
                     # across branch points, and read by `lower_tcrec`, which
                     # drops each surviving entry before sealing the back-edge.
                     # Restored around each match like `mscr`; [] outside one.
                     tcpend: [TclEntry],
                     # The current frame's unwind sites (unwind_pend.kai).
                     unw: UnwFrame,
                     # The program's root file basename — see EmitCtx.root_mod
                     # in emit_c.kai.
                     root_mod: Option[String],
                     # An enclosing arm holds the fn-wide arm-top reuse token,
                     # so a nested arm must not capture over it.
                     arm_tok: Bool,
                     # The instances the `handle`s around the walk position
                     # install, innermost first: an op of one of them reaches
                     # that handler, not the fn's frame slot. A handle's body
                     # extends it; restored at the body's exit.
                     handles: [InstKey],
                     # The symbol table and the specialisations' emitted
                     # names, which spell a declaration's symbol; the
                     # binders of the declaration being lowered, which spell
                     # a local's register.
                     tab: SymTab, specs: SpecNames, locals: LocalNames }

# A local in scope paired with the register it is read from.
pub type Rename = Rn(LocalId, String)

# Result of lowering one expression: its value atom + threaded state.
pub type LRes = LRes(KVal, LowerSt)
# Result of lowering a list of expressions: their atoms + threaded state.
pub type LResMany = LResMany([KVal], LowerSt)

pub type LSReg = LSReg(String, LowerSt)
# Match-preamble result: the join register, the FRESH owned-scrutinee exit-drop
# binder (`<join>$sd`, unique per match so nested matches never share one alloca
# in the native flat register table), and the threaded state.
pub type LSPre = LSPre(String, String, LowerSt)
pub type LSLabel = LSLabel(String, LowerSt)
pub type LSL3 = LSL3(String, String, String, LowerSt)
pub type LSL2 = LSL2(String, String, LowerSt)
pub type ArmPlan = ArmPlan([KCase], LowerSt)
pub type RecPlan = RecPlan([KFieldInit], LowerSt)
# An optional lowered value (handler state init) + threaded state.
pub type LResOpt = LResOpt(Option[KVal], LowerSt)

pub fn ls_new(fns: [EFn], fx: FnIndex, variants: [VariantEntry], ctors: CtorIx, lams: [LamInfo],
              consts: [Decl], ffi: [SymId], recs: [RecInfo], stamps: [RecStamp], regions: [RegionMark], raw_binders: [RawArmBinder], root_mod: Option[String],
              tab: SymTab, specs: SpecNames) : LowerSt =
  LowerSt { rc: 0, bc: 0, bs: [], cl: "entry", ss: [], fns: fns, fx: fx, core_ix: core_ix_build(), ctor_ix: ctors, vs: variants,
            lams: lams, enc_fn: enc_none(), consts: consts, regs: [], ffi: ffi, scope: [], mscr: "", reuse_gc: [], rnested: reuse_plan_none(), recs: recs, stamps: stamps, in_region: false, regions: regions, raw_binders: raw_binders, tcpend: [], unw: unw_frame_none(unw_cx_empty()), root_mod: root_mod, arm_tok: false, handles: [],
            tab: tab, specs: specs, locals: ln_empty() }

#[doc("`st` with the arm-top token marked held (or released).")]
pub fn ls_set_arm_tok(st: LowerSt, held: Bool) : LowerSt = LowerSt { ...st, arm_tok: held }

# Reset the per-function counters and block buffers, preserving the shared
# tables. `enc_fn` is the fn / lambda / clause / runner the body's nested
# lambdas are scoped by (`find_lam` keys on it); `entry` the registers its
# params and captures are read from; `locals` the binders of the declaration
# it belongs to; `body_fns` the EFn table. Called at the head of every KFn
# lowering.
pub fn ls_enter_fn_with(st: LowerSt, enc_fn: EncFn, entry: EntryRegs, locals: LocalNames,
                        body_fns: [EFn]) : LowerSt =
  LowerSt { ...st, rc: 0, bc: 0, bs: [], cl: "entry", ss: [], fns: body_fns, enc_fn: enc_fn,
            regs: entry.regs, scope: list_append(entry.scope, implicit_scope()), mscr: "", reuse_gc: [], rnested: reuse_plan_none(), in_region: false,
            tcpend: [], unw: unw_blank(st.unw), arm_tok: false, handles: [], locals: kir_body_locals(locals) }

#[doc("What a body starts with: the register each param and capture is read from, and the names of the registers they take.")]
pub type EntryRegs = { scope: [Rename], regs: [String] }

#[doc("The entry registers of a parameter list on top of `captured`: each param is read from the register its name spells.")]
pub fn entry_params(params: [Param], captured: EntryRegs) : EntryRegs = match params {
  [] -> captured
  [p, ...rest] -> {
    let reg = written_text(p.binder.name)
    entry_params(rest, EntryRegs { scope: [Rn(p.binder.id, reg), ...captured.scope], regs: [reg, ...captured.regs] })
  }
}

#[doc("The entry registers of a lambda's or clause's captures: a captured binder is read from the register its name spells, an alias is known by its name and takes the register holding its handler id.")]
pub fn entry_captures(caps: [Capture], locals: LocalNames) : EntryRegs =
  EntryRegs { scope: map(caps, (c) => Rn(capture_local(c), written_text(ln_text(locals, capture_local(c))))),
              regs: map(caps, (c) => kir_capture_name(locals, c)) }

fn capture_local(c: Capture) : LocalId = match c {
  CapLocal(l) -> l
  CapAlias(a) -> a
}

# The continuation every clause body reads is declared by no node: it is
# read from the register its key spells.
fn implicit_scope() : [Rename] = [Rn(local_minted(canonical_continuation()), canonical_continuation())]

#[doc("`ns` with the binders a body reads and no node declares: the handler-state aliases and the continuation, each minted under its key.")]
pub fn kir_body_locals(ns: LocalNames) : LocalNames =
  body_locals_loop([canonical_continuation(), var_cell_alias(), ...user_state_aliases()], ns)

fn body_locals_loop(keys: [String], ns: LocalNames) : LocalNames = match keys {
  []           -> ns
  [k, ...rest] -> body_locals_loop(rest, ln_with_binder(ns, binder_minted(k)))
}

#[doc("`st` inside the body of a `handle` that installs the instance `k`.")]
pub fn ls_in_handle(st: LowerSt, k: InstKey) : LowerSt = LowerSt { ...st, handles: [k, ...st.handles] }

#[doc("`st` with the enclosing `handle`s restored to `hs`.")]
pub fn ls_set_handles(st: LowerSt, hs: [InstKey]) : LowerSt = LowerSt { ...st, handles: hs }

#[doc("True when a `handle` around the walk position installs an instance the op of instance `k` reaches.")]
pub fn ls_handled_here(st: LowerSt, k: InstKey) : Bool = any(st.handles, (h) => inst_keys_match(h, k))

#[doc("The state with `u` as the current frame's unwind sites.")]
pub fn ls_with_unw(st: LowerSt, u: UnwFrame) : LowerSt = LowerSt { ...st, unw: u }

# Extend the lexical scope with one bound register. Forward-visible: a
# register is in scope only after its definition. Idempotent.
pub fn ls_bind_reg(st: LowerSt, reg: String) : LowerSt =
  if ls_reg_bound(st, reg) { st } else { LowerSt { ...st, regs: [reg, ...st.regs] } }

# Is `reg` the name of a register live in the current scope?
pub fn ls_reg_bound(st: LowerSt, reg: String) : Bool = name_in_list(st.regs, reg)

# Set the current match's owned-scrutinee exit-drop binder (`<join>$sd`), so a
# TRMC cons-modulo step lowered inside this match drops the right register. Saved
# (read `st.mscr`) and restored around each match, like the `scope` snapshot.
pub fn ls_set_mscr(st: LowerSt, sd: String) : LowerSt = LowerSt { ...st, mscr: sd }

# Replace the tcrec goto-tail pending-release ledger (entering an arm body /
# refining across a branch point). Restored around each match like `mscr`.
pub fn ls_set_tcpend(st: LowerSt, l: [TclEntry]) : LowerSt = LowerSt { ...st, tcpend: l }

# Set the reuse arm's scrutinee pointer-binders so a `KConReuse` lowered
# inside this arm's body emits the shared-donor incref. Saved (read
# `st.reuse_gc`) and restored around each match like `mscr`.
pub fn ls_set_reuse_gc(st: LowerSt, gc: [LocalId]) : LowerSt = LowerSt { ...st, reuse_gc: gc }

# Set the reuse arm's slot plan (see `ReusePlan`). Travels
# with `reuse_gc` — same set/clear discipline, same arm scope.
pub fn ls_set_rnested(st: LowerSt, rn: ReusePlan) : LowerSt = LowerSt { ...st, rnested: rn }

# --- The register scope ----------------------------------------------------

#[doc("Bind `b` to its register, chosen once: the one its name spells, or a fresh one when a live register already has that name. The caller emits the statement that defines it.")]
pub fn ls_bind(st: LowerSt, b: Binder) : LSReg = {
  let name = written_text(b.name)
  if ls_reg_bound(st, name) {
    match ls_fresh_reg(st) { LSReg(reg, st1) -> LSReg(reg, ls_scope_put(st1, b.id, reg)) }
  } else { LSReg(name, ls_scope_put(ls_bind_reg(st, name), b.id, name)) }
}

#[doc("Bind `b` to its register and define it as `op` at `slot`.")]
pub fn ls_let(st: LowerSt, b: Binder, slot: KSlot, op: KOp, pos: KPos) : LowerSt =
  match ls_bind(st, b) { LSReg(reg, st1) -> ls_emit(st1, KLet(reg, slot, op, pos)) }

#[doc("`st` with the local `l` read from `reg`. A block restores the prior scope on exit.")]
pub fn ls_scope_put(st: LowerSt, l: LocalId, reg: String) : LowerSt =
  LowerSt { ...st, scope: [Rn(l, reg), ...st.scope] }

# The innermost binding wins.
fn ls_scope_find(rs: [Rename], l: LocalId) : Option[String] = match rs {
  []                -> None
  [Rn(n, r), ...rest] -> if local_eq(n, l) { Some(r) } else { ls_scope_find(rest, l) }
}

#[doc("True when the local `l` is bound to a register in the current scope.")]
pub fn ls_local_bound(st: LowerSt, l: LocalId) : Bool = match ls_scope_find(st.scope, l) {
  Some(_) -> true
  None    -> false
}

#[doc("The register the local `l` was bound to.")]
pub fn ls_reg_of(st: LowerSt, l: LocalId) : String = match ls_scope_find(st.scope, l) {
  Some(reg) -> reg
  None      -> panic(concat_all(["identity: local ", int_to_string(local_raw(l)), " (", written_text(ln_text(st.locals, l)), ") of ", st.enc_fn.sym, " is read outside its scope"]))
}

#[doc("The name the local `l` was written with.")]
pub fn ls_local_name(st: LowerSt, l: LocalId) : String = {
  let w = written_text(ln_text(st.locals, l))
  if w == "" { panic(concat_all(["identity: the name of local ", int_to_string(local_raw(l)), " of ", st.enc_fn.sym, " in ls_local_name"])) } else { w }
}

#[doc("The register a lambda or clause reads the capture `c` from: the captured binder's written name, or the register holding the alias's handler id.")]
pub fn kir_capture_name(locals: LocalNames, c: Capture) : String = match c {
  CapLocal(l) -> written_text(ln_text(locals, l))
  CapAlias(a) -> kir_alias_id_reg(written_text(ln_text(locals, a)))
}

#[doc("True when `l` is one of `xs`.")]
pub fn lid_has(xs: [LocalId], l: LocalId) : Bool = match xs {
  []           -> false
  [h, ...rest] -> local_eq(h, l) or lid_has(rest, l)
}

#[doc("`xs` without its repeats, first occurrences in order.")]
pub fn lid_uniq(xs: [LocalId]) : [LocalId] = lid_uniq_go(xs, [])

fn lid_uniq_go(xs: [LocalId], seen: [LocalId]) : [LocalId] = match xs {
  []           -> []
  [x, ...rest] -> if lid_has(seen, x) { lid_uniq_go(rest, seen) } else { [x, ...lid_uniq_go(rest, [x, ...seen])] }
}

# Restore `scope` to a snapshot taken at block entry. `rc` (the fresh-reg
# counter) is intentionally NOT restored — it stays monotone so sibling
# blocks that shadow the same name receive distinct `.tN` registers.
pub fn ls_set_scope(st: LowerSt, snap: [Rename]) : LowerSt = LowerSt { ...st, scope: snap }

# Restore the live-register names to a block-entry snapshot, so registers
# defined inside the block leave scope at its exit. Paired with
# `ls_set_scope` in `lower_block`.
pub fn ls_set_regs(st: LowerSt, snap: [String]) : LowerSt = LowerSt { ...st, regs: snap }

# Set the arena-routing flag. `lower_fn` seeds it from the signature brand;
# `lower_block` sets it for a lexical `region { }` extent and restores the
# prior value at the block's exit.
pub fn ls_set_in_region(st: LowerSt, b: Bool) : LowerSt = LowerSt { ...st, in_region: b }

# A fresh virtual-register name, deterministic per function: `.t0`, `.t1`, …
# The leading `.` is load-bearing, NOT cosmetic: a temporary shares the
# fn's register table (string-keyed allocas) with the SURFACE binder names
# that `bind_pattern_fields` emits verbatim (`PBind(name) -> KLet(name, …)`).
# A user / stdlib binder named `t2` (e.g. `stdlib/collections/map.kai`'s
# `TNode(xk, xv, _, t1, t2)`) would ALIAS a `t2` temporary — same alloca,
# the second store clobbers the first. When their slots also differ (a
# `tagof` temporary is `SInt32`, the surface sub-tree binder is `SBoxed`)
# the clobber surfaces as `Call parameter type does not match function
# signature` at verify; when the slots happen to match it corrupts silently.
# `.` is rejected by the lexer in a surface identifier, so a `.tN` temporary
# can NEVER collide with a surface name — an impossibility, not a heuristic
# (`__t` would only lower the odds: a user CAN write `__t2`). LLVM accepts
# `.` in a local value name (the walk already appends `.addr` to allocas).
pub fn ls_fresh_reg(st: LowerSt) : LSReg =
  LSReg(cat2(".t", int_to_string(st.rc)), ls_with_rc(st, st.rc + 1))

# A fresh block label, deterministic per function: `L0`, `L1`, …
pub fn ls_fresh_label(st: LowerSt) : LSLabel =
  LSLabel(cat2("L", int_to_string(st.bc)), ls_with_bc(st, st.bc + 1))

# --- Field updaters (record copy-with) ----------------------------------

fn ls_with_rc(st: LowerSt, rc: Int) : LowerSt = LowerSt { ...st, rc: rc }
fn ls_with_bc(st: LowerSt, bc: Int) : LowerSt = LowerSt { ...st, bc: bc }

# --- Block accumulation -------------------------------------------------

# Append one statement to the block under construction (stored reversed).
# A binder statement (`KLet` / `KStore`) also EXTENDS `regs` with its
# destination — the single chokepoint every match/let/record/variant
# binder funnels through, so the scope set stays complete without
# threading a bind callback through each binding site.
pub fn ls_emit(st: LowerSt, s: KStmt) : LowerSt =
  ls_emit_raw(ls_bind_reg_of(st, s), s)

# The register a binder statement introduces, if any (`KLet`/`KStore` dest).
fn ls_bind_reg_of(st: LowerSt, s: KStmt) : LowerSt = match s {
  KLet(name, _, _, _) -> ls_bind_reg(st, name)
  KStore(name, _, _)  -> ls_bind_reg(st, name)
  _                   -> st
}

fn ls_emit_raw(st: LowerSt, s: KStmt) : LowerSt = LowerSt { ...st, ss: [s, ...st.ss] }

# Seal the current block with a terminator and start a fresh block under
# `next_label`. The sealed block joins `blocks` in generation order.
pub fn ls_seal(st: LowerSt, term: KTerm, next_label: String) : LowerSt =
  LowerSt { ...st,
            bs: list_append(st.bs, [KBlock { label: st.cl, stmts: list_reverse(st.ss), term: term, region_id: None }]),
            cl: next_label, ss: [] }

# Seal the final block without opening a successor (function exit). When
# the body ends in a tail terminator, the final block is the dead successor
# `seal_tail` opened: nothing branches to it and no value reaches its `ret`,
# so it ends in `unreachable` rather than returning a placeholder.
pub fn ls_finish(st: LowerSt, term: KTerm) : [KBlock] = {
  let t = match term {
    KRet(_, p) if ls_cursor_dead(st) -> KUnreachable(p)
    _                                -> term
  }
  list_append(st.bs, [KBlock { label: st.cl, stmts: list_reverse(st.ss), term: t, region_id: None }])
}

# The open block is past the entry and no sealed block branches to it.
fn ls_cursor_dead(st: LowerSt) : Bool =
  not list_is_empty(st.bs) and not any(st.bs, (b) => list_has(klc_succ(b.term), st.cl))

#[doc("A constructor as the lowering lays it out: the name the dump prints, its head tag, the declared kind of each payload slot (0 boxed, 1 Int, 2 Real, 3 enum) and their 2-bit-per-slot mask. A builtin's kinds are empty and its mask 0: the runtime owns its layout.")]
pub type CtorLay = { name: String, tag: Int, kinds: [Int], mask: Int }

#[doc("The layout of the constructor `row` lays out.")]
pub fn ctor_lay(row: VariantEntry) : CtorLay = match row {
  EV(_, name, _, ks, tag, _) ->
    if tag < user_variant_tag_base() { CtorLay { name: name, tag: tag, kinds: [], mask: 0 } }
    else { CtorLay { name: name, tag: tag, kinds: ks, mask: variant_slot_mask(ks) } }
}

#[doc("The layout of the constructor `s`, or None when `s` is the id of no constructor.")]
pub fn ls_ctor_lay(st: LowerSt, s: SymId) : Option[CtorLay] = match ctor_ix_row(st.ctor_ix, s) {
  Some(row) -> Some(ctor_lay(row))
  None      -> None
}

#[doc("The layout of the constructor a pattern or record literal references; None while the reference is unresolved or names no constructor.")]
pub fn ls_ref_ctor(st: LowerSt, r: DeclRef) : Option[CtorLay] = ls_ctor_lay(st, ref_sym(r))

# The builtin list cell is no registered variant: a cons rebuild carries
# this layout through the paths a variant rebuild shares.
#[doc("The layout a cons rebuild is lowered under.")]
pub fn ctor_lay_cons() : CtorLay = CtorLay { name: "Cons", tag: 0, kinds: [], mask: 0 }

#[doc("The head tag of the constructor `c`; 0 when the table lays out none.")]
pub fn ls_ctor_tag(st: LowerSt, c: SymId) : Int =
  match ctor_ix_row(st.ctor_ix, c) {
    Some(row) -> ctor_row_tag(row)
    None      -> 0
  }

#[doc("The name the fn instance `f` is emitted under: its specialisation's, or its declaration's.")]
pub fn ls_fn_name(st: LowerSt, f: FnId) : String =
  if fnid_inst(f) == spec_none() { written_text(decl_name(st.tab, fnid_sym(f))) }
  else { written_text(spec_text(st.specs, f)) }

# Resolve a callee to its mangled symbol via the EFn table; a builtin to
# the native entry of its row.
# An `extern "C" fn` callee resolves to its `__ffi_<c_sym>` wrapper (NOT the
# bare extern symbol) — see `LowerSt.ffi`. The EFn table carries the callee's
# resolved module, so the wrapper name matches the def minted in `lower_fn`.
fn ls_callee(st: LowerSt, fid: FnId) : Option[EFn] = fnx_callee(st.fx, fid)

#[doc("True when `s` declares an `extern \"C\" fn`.")]
pub fn ls_is_ffi(st: LowerSt, s: SymId) : Bool = any(st.ffi, (f) => sym_raw(f) == sym_raw(s))

pub fn c_sym_of_callee_st(st: LowerSt, fid: FnId) : String =
  if ls_is_ffi(st, fnid_sym(fid)) { ffi_wrapper_sym(ls_fn_name(st, fid), efn_module_of(st, fid)) }
  else { match ls_callee(st, fid) {
    Some(e) -> ls_fn_call_sym(st, efn_sym(e), efn_c_sym(e))
    None    -> core_call_sym(st, fid)
  } }

#[doc("The C symbol the fn instance `f` is emitted under: its registry entry's, which carries the module that declares it.")]
pub fn ls_fn_c_sym(st: LowerSt, f: FnId) : String = match ls_callee(st, f) {
  Some(e) -> efn_c_sym(e)
  None    -> ls_fn_name(st, f)
}

#[doc("The unboxed signature a direct call of `fid` is lowered at: the fn's own when the call binds its symbol, none through an FFI wrapper or a core builtin's native entry.")]
pub fn ls_call_sig(st: LowerSt, fid: FnId) : Option[UFnSig] =
  if ls_is_ffi(st, fnid_sym(fid)) { None }
  else { match ls_callee(st, fid) {
    Some(e) -> match fnx_kai(st.fx, efn_sym(e)) {
      Some(_) -> None
      None    -> fnx_ufn_sig_first(st.fx, efn_sym(e))
    }
    None -> None
  } }

# A declared core builtin is called as a `builtin_table` row is, through
# its native entry; any other fn through its own symbol `csym`.
#[doc("The symbol a direct call to the fn `fid`, emitted as `csym`, binds.")]
pub fn ls_fn_call_sym(st: LowerSt, fid: FnId, csym: String) : String = match fnx_kai(st.fx, fid) {
  Some(_) -> core_native_call_sym(ls_fn_name(st, fid))
  None    -> csym
}

# A callee no fn declares is a core builtin, named by the runtime symbol
# of its row so a user fn spelled like a builtin can never be mistaken
# for it.
fn core_call_sym(st: LowerSt, fid: FnId) : String = match core_ix_name(st.core_ix, fnid_sym(fid)) {
  Some(n) -> core_native_call_sym(n)
  None    -> ls_fn_name(st, fid)
}

# The module of a callee via the EFn table (None when it is root-level or
# no fn). Used to mint the FFI wrapper symbol so the call site and the def
# agree on the mangling.
fn efn_module_of(st: LowerSt, fid: FnId) : Option[String] = match ls_callee(st, fid) {
  Some(EFn(_, _, mo, _, _)) -> mo
  None                      -> None
}

# The kaikai-visible wrapper symbol for an `extern "C" fn`: `__ffi_<c_sym>`.
# Minted identically at the wrapper DEF (`lower_fn`) and at EVERY call site
# (`c_sym_of_callee_st`), so a
# call to `abs()` resolves to the wrapper `@__ffi_abs`, never the bare extern
# `@abs` the shim itself calls. Lives in this base module (not kir_lower_fns)
# so both the def and the call-site resolvers reach it without an import cycle.
#
# The prefix is `__ffi_`, NOT `kai_`: the native callee resolver
# (`ncall_sym`) maps any `kai_`-prefixed symbol to a `kaix_<rest>` runtime
# prim (`kai_op_field` → `kaix_field`), so `kai_abs` would mis-resolve to the
# nonexistent `kaix_abs` (an undefined-symbol link error). `__ffi_` is neither
# a core name nor `kai_`-prefixed, so it stays a literal user-fn symbol.
# The C / LLVM-text oracles can use `kai_` because their resolvers never run
# the `kai_`→`kaix_` rewrite — that rewrite is native-only.
pub fn ffi_wrapper_sym(name: String, mo: Option[String]) : String =
  cat2("__ffi_", c_sym(name, mo))

# A first-class function value: a reference to a top-level fn lowers to a
# closure over the fn's thunk symbol. Returns the closure descriptor
# (thunk-with-`@`, arity), or the core builtin's for a reference to one.
pub type FnValue = FV(String, Int)

pub fn ls_fn_value(st: LowerSt, fid: FnId) : Option[FnValue] = match ls_callee(st, fid) {
  Some(e) -> match e { EFn(_, arity, _, _, _) -> Some(FV(c_user_thunk_sym(efn_c_sym(e)), arity)) }
  None    -> kir_core_fn_value(st, fid)
}

# A PRELUDE builtin used as a first-class value (`map(xs, int_to_string)`,
# `bytes(s) | byte_to_int`): the closure rides the runtime's pre-defined
# `kaix_<name>_thunk` (`stage0/runtime_llvm.c`). The arity comes from the
# shared `core_table()` row the C backend also reads, so a builtin is a
# value on both backends or on neither.
fn kir_core_fn_value(st: LowerSt, fid: FnId) : Option[FnValue] = match core_ix_boxed(st.core_ix, fnid_sym(fid)) {
  Some(EP(name, _, arity)) -> Some(FV(core_native_thunk_sym(name), arity))
  None                     -> None
}

# A call is DIRECT when the callee is a known top-level fn or a core
# builtin.
pub fn callee_is_direct(st: LowerSt, fid: FnId) : Bool = match ls_callee(st, fid) {
  Some(_) -> true
  None    -> match core_ix_name(st.core_ix, fnid_sym(fid)) {
    Some(_) -> true
    None    -> false
  }
}

pub fn name_in_list(xs: [String], target: String) : Bool = match xs {
  [] -> false
  [h, ...rest] -> if h == target { true } else { name_in_list(rest, target) }
}

# --- Top-level consts (inlined at their use site) -----------------------

# The top-level `DConst` decls of a program, kept in `LowerSt.consts` so
# `lower_sym` materialises a const read as its literal body inline (a const
# is a literal with a name, not a function).
pub fn kir_const_decls(ds: [Decl], acc: [Decl]) : [Decl] = match ds {
  [] -> acc
  [d, ...rest] -> match d {
    DConst(_, _, _, _, _, _, _) -> kir_const_decls(rest, list_append(acc, [d]))
    _                           -> kir_const_decls(rest, acc)
  }
}

#[doc("The literal body of the const `s` declares, or None when `s` is no top-level const.")]
pub fn kir_const_body(consts: [Decl], s: SymId) : Option[Expr] = match consts {
  [] -> None
  [d, ...rest] -> match d {
    DConst(_, cs, _, body, _, _, _) ->
      if sym_raw(s) >= 0 and sym_raw(cs) == sym_raw(s) { Some(body) } else { kir_const_body(rest, s) }
    _ -> kir_const_body(rest, s)
  }
}

# --- Pure helpers (no recursion through lower_expr) ----------------------

# Lift an AST node's `line`/`col` into a KIR position.
pub fn kpos_of(x: Expr) : KPos = KAt(x.line, x.col)

# The atom for an `EInt` literal. A fixed-width-context literal (`let b:
# Byte = 42`, `let w: Int32 = 42`) carries the fixed-width type on the node
# and must box through THAT width's constructor — minting it as an Int hands
# a fixed-width consumer a tagged-immediate Int it dereferences (the #1394
# segfault). Rides `KFixedV` carrying the width.
pub fn kir_int_atom(x: Expr, n: Int) : KVal = match x.ty {
  Some(TyByte)   -> KFixedV(int_to_string(n), TyByte)
  Some(TyInt32)  -> KFixedV(int_to_string(n), TyInt32)
  Some(TyUInt32) -> KFixedV(int_to_string(n), TyUInt32)
  Some(TyUInt64) -> KFixedV(int_to_string(n), TyUInt64)
  Some(TyInt128) -> KFixedV(int_to_string(n), TyInt128)
  _              -> KIntV(n)
}

# Bind an op into a fresh register and return that register as the value —
# the funnel through which every named subexpression flows (ANF's "name
# every non-trivial result" rule). Boxed slot: every value-bearing op is
# boxed by default.
pub fn bind_op(st: LowerSt, op: KOp, pos: KPos) : LRes =
  bind_op_slot(st, op, SBoxed, pos)

# As `bind_op`, but with an explicit slot. The lowering — never a backend
# — decides a register's repr: a `KTagOf` result is the raw
# `i32` tag word (`SInt32`), so the native backend lowers a real LLVM
# `switch` over an integer scrutinee instead of reinterpreting a `ptr`.
# KSlot stays the single source of truth for the register's type.
pub fn bind_op_slot(st: LowerSt, op: KOp, slot: KSlot, pos: KPos) : LRes = match ls_fresh_reg(st) {
  LSReg(name, st1) -> LRes(KVar(name), ls_emit(st1, KLet(name, slot, op, pos)))
}

# A tail terminator (sentinel / resume) ends the current block; nothing
# follows it in valid IR. Seal here and open a fresh (unreachable)
# successor so the cursor stays valid for the caller's exit KRet; the
# translator drops the unnamed successor. The label is threaded so the
# per-fn counter stays deterministic.
pub fn seal_tail(st: LowerSt, term: KTerm) : LRes = match ls_fresh_label(st) {
  LSLabel(dead, st1) -> LRes(KUnitV, ls_seal(st1, term, dead))
}

# Reloop assignments: param slot i ← value atom i, in order.
pub fn assigns_of(vs: [KVal], idx: Int, acc: [KAssign]) : [KAssign] = match vs {
  [] -> acc
  [v, ...rest] -> assigns_of(rest, idx + 1, list_append(acc, [KAsg(idx, v)]))
}

# Wrap each value atom as a slot-init typed by the ctor's declared payload
# kind: 1 (Int) → `SIInt64`, 2 (Real) → `SIReal`, 3 (enum) → `SIEnum`, else
# `SIBoxed`. The kinds come from the SAME variant table row the native mask
# and the drop-walker read, so construction, drop and read stay in lockstep. The
# emitter consumes a boxed Real/enum value (`kaix_take_real`/`kaix_take_enum`)
# but reads an Int word without consuming, so an Int slot's value must arrive
# raw: above the immediate range a boxed Int is a heap box nothing releases.
#[doc("Slot initialisers for the constructor `c`; a builtin's stay boxed.")]
pub fn typed_inits(vs: [KVal], c: CtorLay) : [KSlotInit] = kind_inits(vs, c.kinds, [])

#[doc("The mask kinds of slots `i` up to `n` of a ctor, in slot order, skipping slot `hole`.")]
pub fn mask_kinds_but(mask: Int, hole: Int, i: Int, n: Int) : [Int] =
  if i >= n { [] }
  else if i == hole { mask_kinds_but(mask, hole, i + 1, n) }
  else { [variant_mask_kind(mask, i), ...mask_kinds_but(mask, hole, i + 1, n)] }

fn kind_inits(vs: [KVal], ks: [Int], acc: [KSlotInit]) : [KSlotInit] = match vs {
  [] -> acc
  [v, ...vrest] -> match ks {
    [k, ...krest] -> kind_inits(vrest, krest, list_append(acc, [kind_init(v, k)]))
    []            -> kind_inits(vrest, [], list_append(acc, [SIBoxed(v)]))
  }
}

fn kind_init(v: KVal, k: Int) : KSlotInit =
  if k == 1 { SIInt64(v) }
  else if k == 2 { SIReal(v) }
  else if k == 3 { SIEnum(v) }
  else { SIBoxed(v) }

# Allocate three / two fresh block labels at once for the control-flow
# forks, threading the counter deterministically.
pub fn three_labels(st: LowerSt) : LSL3 = match ls_fresh_label(st) {
  LSLabel(a, st1) -> match ls_fresh_label(st1) {
    LSLabel(b, st2) -> match ls_fresh_label(st2) {
      LSLabel(c, st3) -> LSL3(a, b, c, st3)
    }
  }
}

pub fn two_labels(st: LowerSt) : LSL2 = match ls_fresh_label(st) {
  LSLabel(a, st1) -> match ls_fresh_label(st1) { LSLabel(b, st2) -> LSL2(a, b, st2) }
}

# Reopen a previously-named label as the current block (it must already be
# sealed); sets the cursor for the next statements.
pub fn reopen(st: LowerSt, label: String) : LowerSt = LowerSt { ...st, cl: label, ss: [] }

# --- Type declarations --------------------------------------------------

# Walk the decls collecting sum/record type declarations with resolved
# tags. Constructors carry their slot kinds so translators never re-derive
# boxed-vs-i64.
pub fn lower_types(ds: [Decl], tab: SymTab, ctors: CtorIx, acc: [KTypeDecl]) : [KTypeDecl] = match ds {
  [] -> acc
  [d, ...rest] -> lower_types(rest, tab, ctors, lower_type_one(d, tab, ctors, acc))
}

fn lower_type_one(d: Decl, tab: SymTab, ctors: CtorIx, acc: [KTypeDecl]) : [KTypeDecl] = match d {
  DType(_, s, _, body, _, _, _, _) -> match body {
    TBSum(vs) -> list_append(acc, [KSumT(rt_name(tab, s), lower_ctors(vs, tab, ctors, []))])
    TBRecord(fields) -> list_append(acc, [KRecordT(rt_name(tab, s), lower_fields(fields, []))])
    _ -> acc
  }
  _ -> acc
}

fn lower_ctors(vs: [Variant], tab: SymTab, ctors: CtorIx, acc: [KCtor]) : [KCtor] = match vs {
  [] -> acc
  [v, ...rest] -> match v {
    Var(c, vtys) ->
      lower_ctors(rest, tab, ctors,
        list_append(acc, [KCtor { name: written_text(decl_name(tab, c)),
                                  tag: ctor_tag_of(ctors, c),
                                  slots: lower_ctor_slots(vtys, []) }]))
  }
}

fn ctor_tag_of(ctors: CtorIx, c: SymId) : Int = match ctor_ix_row(ctors, c) {
  Some(row) -> ctor_row_tag(row)
  None      -> 0
}

# Conservatively boxed until the lowering consults the unbox
# classification; the translator reads the slot, never re-derives it.
fn lower_ctor_slots(tys: [TypeExpr], acc: [KSlot]) : [KSlot] = match tys {
  [] -> acc
  [_, ...rest] -> lower_ctor_slots(rest, list_append(acc, [SBoxed]))
}

fn lower_fields(fields: [FieldDecl], acc: [KField]) : [KField] = match fields {
  [] -> acc
  [f, ...rest] -> match f {
    FD(_, fname, _, _) ->
      lower_fields(rest, list_append(acc, [KField { fname: fname, fslot: SBoxed }]))
  }
}

# --- Regions / params ---------------------------------------------------

pub fn lower_regions(rs: [RegionMark], acc: [KRegion]) : [KRegion] = match rs {
  [] -> acc
  [_, ...rest] -> lower_regions(rest, list_append(acc, [KRgn(list_length(acc), "region")]))
}

#[doc("The ownership mode Perceus planned for a param: `KBorrow` when it borrows it.")]
pub fn kparam_mode(p: Param) : KMode = if p.pborrow { KBorrow } else { KOwn }

# Lower a fn / lambda parameter list. Each param is a `PDirect(i)` — the
# i-th argument under whichever calling kind the enclosing `KFn` carries
# (a normal fn's direct param, or a lambda/clause's `args[i]`).
pub fn lower_params(ps: [Param], acc: [KParam]) : [KParam] =
  lower_params_idx(ps, list_length(acc), acc)

fn lower_params_idx(ps: [Param], i: Int, acc: [KParam]) : [KParam] = match ps {
  [] -> acc
  [p, ...rest] ->
    lower_params_idx(rest, i + 1,
      list_append(acc, [KParam { name: written_text(p.binder.name), slot: SBoxed, mode: kparam_mode(p), origin: PDirect(i) }]))
}

# Build a capture param: the j-th closure capture, read from `self`.
pub fn capture_param(name: String, j: Int) : KParam =
  KParam { name: name, slot: SBoxed, mode: KOwn, origin: PCapture(j) }

# A return / param slot from a type annotation. Conservative boxed until
# the lowering consults the unbox classification.
pub fn slot_of_ty(t: Option[TypeExpr]) : KSlot = SBoxed

# --- Raw scalar param/return slots from the UFnSig -----------------------
#
# The native backend's signature emitter reads `KParam.slot` / `KFn.ret`,
# never the UFnSig (KSlot is the single source of a register's type — the
# mode-slave discipline). So a `KFnNormal` whose `EFn` carries a
# raw `UFnSig` (`Some(US(_, _, mask))`) lowers each RAW param to its scalar
# slot and the return to its scalar slot, exactly the shape `emit_native`'s
# raw-signature emitter then declares (`i64`/`f64`/`i1` instead of `ptr`).
# The body already reads those params raw: the unbox pass seeds the same
# mask-raw params `MUnboxed` (`ufn_param_env`), so a read of the param lowers
# through `lower_expr_raw` and the native register-load sees the raw slot.
#
# The KSlot maps the SAME scalar set the UFnSig mask marks raw: Int →
# `SInt64`, Real → `SReal`, Bool → `SBool`, Char → `SChar` (the raw `i32`
# codepoint, the C oracle's `uint32_t`), Byte → `SByte` (raw i32, value
# 0..255, the C oracle's `uint8_t`). The mapping must cover the whole
# mask-raw set: the post-perceus dup/drop plan is SHARED by both backends
# and calibrated for raw scalars (no dups for a mask-raw param's reads), so
# a mask-raw type left `SBoxed` here hands consuming prims N owned reads
# against one ref — the under-ref that freed live heap Chars.
pub fn kslot_of_raw_ty(t: Ty) : KSlot = match t {
  TyInt               -> SInt64
  TyReal              -> SReal
  TyBool              -> SBool
  TyChar              -> SChar
  TyByte              -> SByte
  TyInt32             -> SInt32T
  TyUInt32            -> SUInt32
  TyUInt64            -> SUInt64
  TyInt128            -> SInt128
  TyDimT(inner, _)    -> kslot_of_raw_ty(inner)
  TyRefineT(inner, _) -> kslot_of_raw_ty(inner)
  _                   -> SBoxed
}

# The return slot for a UFn: raw iff the UFnSig's return type is unboxable
# AND maps to a raw KIR slot (Int/Real/Bool/Char/Byte — Handle falls to
# SBoxed).
# `None` (a fn with no raw signature) keeps the conservative boxed slot.
pub fn ret_slot_of_sig(sig: Option[UFnSig]) : KSlot = match sig {
  Some(US(_, rt, _)) -> if ty_is_unboxable_t(rt) { kslot_of_raw_ty(rt) } else { SBoxed }
  None               -> SBoxed
}

# Lower a normal fn's params honouring the UFnSig raw mask: param `i` gets
# its raw scalar slot when `mask[i]` is true (and the type maps to a raw
# KIR slot), else stays `SBoxed`. `None` (no raw signature) is identical to
# the all-boxed `lower_params`. The `param_tys` carry each param's real Ty,
# indexed positionally — the same list `emit_fn_signature_unboxed` reads.
pub fn lower_params_sig(ps: [Param], sig: Option[UFnSig]) : [KParam] = match sig {
  Some(US(pts, _, mask)) -> lower_params_sig_idx(ps, pts, mask, 0, [])
  None                   -> lower_params(ps, [])
}

fn lower_params_sig_idx(ps: [Param], pts: [Ty], mask: [Bool], i: Int, acc: [KParam]) : [KParam] = match ps {
  [] -> acc
  [p, ...rest] -> {
    let slot = param_slot_for(pts, mask)
    let mrest = match mask {
      [_, ...r] -> r
      [] -> []
    }
    let trest = match pts {
      [_, ...r] -> r
      [] -> []
    }
    lower_params_sig_idx(rest, trest, mrest, i + 1,
      list_append(acc, [KParam { name: written_text(p.binder.name), slot: slot, mode: kparam_mode(p), origin: PDirect(i) }]))
  }
}

# The KSlot for the head param: raw (mapped from its Ty) when the head of
# `mask` is true, else `SBoxed`. Defensive on a short mask/tys list (a
# lowering bug, never reached for a well-formed UFnSig). `pub` so the
# call-site arg lowering (`lower_tcrec_args`) reads the SAME slot the param
# declaration does — a `Handle` param is `mask=true` but maps to `SBoxed`,
# so its arg must NOT lower raw.
pub fn param_slot_for(pts: [Ty], mask: [Bool]) : KSlot = match mask {
  [true, ..._] -> match pts {
    [t, ..._] -> kslot_of_raw_ty(t)
    [] -> SBoxed
  }
  _ -> SBoxed
}

# Resolve a binary operator to its prim. Arithmetic / comparison ops map
# 1:1 to a runtime helper the translator knows. `++` is overloaded on the
# operand type (string concat vs list append): resolve it HERE, in the
# lowering, from the typed AST — the translator must not re-derive types.
# The operand `a` carries the typer-stamped `ty`.
pub fn binop_prim(op: BinOp, a: Expr) : PrimOp = match op {
  BoConcat -> match a.ty { Some(TyListT(_)) -> KpListAppend _ -> KpStringConcat }
  _        -> KpBin(op)
}

# --- Callee classification ----------------------------------------------

# How a call to a builtin lowers.
pub type CalleeKind = CkStripUnit | CkUnitName | CkDirect

#[doc("How a call to the builtin `b` lowers: a unit form in place, any other as a direct call.")]
pub fn classify_builtin(b: CoreBuiltin) : CalleeKind =
  if builtin_is_unit_coercion(b) { CkStripUnit }
  else { match b {
    CbUnitName -> CkUnitName
    _          -> CkDirect
  } }

#[doc("True when `l` is the binder every call of a clause's continuation reads.")]
pub fn local_is_continuation(l: LocalId) : Bool = local_eq(l, local_minted(canonical_continuation()))

# --- Effect default-handler install order ---------------------------------

# The effects of a row the runtime does not install first go after those
# (so pop order mirrors reverse-declaration).
fn kir_later_effects(row: [SymId]) : [SymId] =
  filter(row, (s) => not effect_is_any(s, default_install_first()))

# The install order of a program whose entry row is `row`: the effects the
# runtime installs first, in its order, then the row's others.
fn kir_order_of(row: [SymId]) : [SymId] =
  list_append(map(default_install_first(), core_effect_id), kir_later_effects(row))

# The label of an effect the runtime installs first: the name the program
# emits it under, or its declared one in a program that does not hold it.
fn kir_first_label(tab: SymTab, c: CoreEffect) : String = {
  let s = core_effect_id(c)
  if st_valid(tab, s) { rt_name(tab, s) } else { core_effect_name(c) }
}

#[doc("The labels of the full install order, as a dump prints it: the effects the runtime installs first, then the entry row's others.")]
pub fn kir_install_order(decls: [Decl], tab: SymTab, entry: SymId) : [String] =
  list_append(map(default_install_first(), (c) => kir_first_label(tab, c)),
              map(kir_later_effects(main_row_labels(decls, entry)), (s) => rt_name(tab, s)))

# --- Default-handler op→runtime-symbol resolution (native install) ------
#
# For each effect in `install_order` carrying an all-`$extern_handler`
# default block, resolve its ops to the `kaix_default_<eff>_<op>`
# forwarders. The builtin effects (Stdout/Stderr/Stdin/…) and any user
# effect with a `default { }` block (Clock in stdlib/time.kai) go
# through the SAME path — the builtins are stdlib source `DEffect` decls
# with default blocks, so there is no second class.
# Mirror of emit_llvm's `lvm_default_install_for_effect` op walk, but
# producing target-neutral `KDefault` data the native translator reads.

# Map the C symbol `kai_default_<eff>_<op>` carried by `$extern_handler`
# to the LLVM-visible non-static forwarder `kaix_default_<eff>_<op>`
# (the static runtime handler is `kai_*`; only the `kaix_*` mirror is
# callable from emitted code). Mirror of `lvm_kaix_symbol`.
pub fn kir_kaix_symbol(c_sym: String) : String =
  if string_starts_with_q(c_sym, "kai_") {
    string_concat("kaix_", string_slice(c_sym, 4, string_length(c_sym) - 4))
  } else { c_sym }

# Recognise a `$extern_handler("c_symbol")` clause body and return the
# bridged C symbol, or "" when the body is not such a bridge.
#
# Returns a plain `String`, NOT the `Option[String]` that emit_shared's
# `extern_handler_c_symbol` returns — load-bearing, not style. The Option
# form trips a kaic1 codegen bug that silently empties the bound value
# (`Some("")` even though a direct strip returns the symbol); a plain
# String in one SSA slot guarded on `== ""` sidesteps it. This is the same
# fix `lvm_extern_handler_c_symbol` (emit_llvm) applies for the same reason.
# The native lowering runs in the kaic1-built KAI_LLVM kaic2, so the bug
# bites here too.
fn kir_extern_handler_c_symbol(body: Expr) : String = match body.kind {
  EIntrinsic(InExternHandler, [a]) -> match a.kind {
    EStr(span, is_triple) -> if is_triple { "" } else { strip_string_quotes(span) }
    _ -> ""
  }
  _ -> ""
}

# The op→symbol pairs of one default block's clauses, in clause order
# (= op declaration order, so the position is the Ev field offset). A
# clause that does not bridge via `$extern_handler` (empty symbol) is skipped.
fn kir_default_ops(cs: [HClause]) : [KDefOp] = match cs {
  [] -> []
  [HC(head, params, body, _, _), ...rest] -> {
    let c_sym = kir_extern_handler_c_symbol(body)
    if c_sym == "" { kir_default_ops(rest) }
    # The forwarder takes the Ev, the op's args and the continuation.
    else { [KDOp(clause_head_word(head), kir_kaix_symbol(c_sym), list_length(params) + 1), ...kir_default_ops(rest)] }
  }
}

#[doc("The `KDefault` of the effect declaration `s`, or None when it carries no default block.")]
pub fn kir_default_of_decl(s: SymId, decls: [Decl]) : Option[KDefault] = match decls {
  [] -> None
  [d, ...rest] -> match d {
    DEffect(_, esym, _, _, Some(DBlk(clauses, _, _, _)), _, _, _) ->
      if sym_raw(s) >= 0 and sym_raw(esym) == sym_raw(s) { Some(KDef(esym, kir_default_ops(clauses))) }
      else { kir_default_of_decl(s, rest) }
    _ -> kir_default_of_decl(s, rest)
  }
}

# Resolve each effect that main ACTUALLY uses to its `KDefault`. The set is
# `install_order ∩ main_row` (only effects in main's inferred row get a
# default installed); `install_order` itself is the full builtin ORDER, not
# the install set. An effect with no default block (e.g. a parametric
# `State[T]`) drops out. The result is in install order so native push/pop
# stays LIFO.
# `ensure_unconditional_defaults` forces the base-installable effects
# (`Mutable`) into the row BEFORE the filter, so their default handler is
# installed around `kai_main` even when the inferred row omits them. The
# result stays a SET (the helper dedups).
pub fn kir_default_handlers(decls: [Decl], entry: SymId) : [KDefault] =
  kir_default_handlers_loop(kir_order_of(main_row_labels(decls, entry)),
                            ensure_unconditional_defaults(add_missing_effects(
                              default_effects_absorbed_by_handler(decls),
                              main_row_labels(decls, entry))), decls)

#[doc("The defaults a test or bench entry installs: every effect in `runner_entry_row`, in install order.")]
pub fn kir_runner_default_handlers(decls: [Decl]) : [KDefault] = {
  let row = runner_entry_row(decls)
  kir_default_handlers_loop(kir_order_of(row), row, decls)
}

# Each effect of the install order that the row holds installs its default.
fn kir_default_handlers_loop(order: [SymId], main_row: [SymId], decls: [Decl]) : [KDefault] = match order {
  [] -> []
  [s, ...rest] -> match kir_default_in_row(s, main_row, decls) {
    None    -> kir_default_handlers_loop(rest, main_row, decls)
    Some(d) -> [d, ...kir_default_handlers_loop(rest, main_row, decls)]
  }
}

fn kir_default_in_row(s: SymId, row: [SymId], decls: [Decl]) : Option[KDefault] =
  if effect_among(row, s) { kir_default_of_decl(s, decls) } else { None }

# Synthesise a `KDefault` (op→field-index map) for EVERY effect DECLARED in
# the program — a deliberate SUPERSET of `kir_default_handlers`. The native
# backend emits a body for every fn, so a dead fn's `KPerform <eff>` needs a
# synth `KHandlerDecl` for its op field index, or `nemit_perform` aborts the
# build. The actual handler resolves from the evidence stack at runtime (the
# C-direct oracle never aborts; it null-derefs only if the dead fn runs — it
# does not). This set feeds ONLY `ndef_synth_handlers` (dispatch shape);
# `kir_default_handlers` stays the install/teardown set (LIFO push/pop).
#
# Two shapes of dead-code perform reach here:
#   - `today : Date / Clock`, never called from a Clock-free main. `Clock`
#     carries a `default { }` block, so its `KDefault` is the default-op map.
#   - `pump_lines : … / File + ReadFault`, dragged into a stream program
#     that only calls `from_list`/`take`/`count`. `ReadFault` has NO default
#     block, so we synthesise its op→field map straight from the `effect`
#     decl (op names in declaration order = the Ev field offset, identical to
#     the C-direct `Ev<eff>` struct layout). The recorded thunk symbol is
#     never called — `nemit_perform` reads only the field index — so a
#     never-installed effect is inert; the field map merely lets the build
#     emit the dead `KPerform` as the oracle does. This drives `from_list`-
#     only stream programs (`stream_early_stop`) and any dead File/Net perform
#     to C-direct byte-id parity. Iterating DECLARED effects (not
#     `install_order`, which is builtins ∪ main_row only) is what reaches a
#     non-main-row effect like `ReadFault`.
pub fn kir_synth_handler_effects(decls: [Decl], tab: SymTab) : [KDefault] = match decls {
  [] -> []
  [d, ...rest] -> match d {
    DEffect(_, esym, _, ops, defblk, _, _, _) ->
      [kir_synth_default_for_effect(rt_name(tab, esym), esym, ops, defblk),
       ...kir_synth_handler_effects(rest, tab)]
    _ -> kir_synth_handler_effects(rest, tab)
  }
}

# The synth `KDefault` for one declared effect: its default-block op→symbol
# map when a `default { }` block exists (the `$extern_handler` forwarders),
# else the op names straight from the `effect` decl (no default block —
# `ReadFault`/`File`/`Spawn`). The per-op symbol is a placeholder
# (`kaix_synth_<eff>_<op>`) the runtime never invokes: a synth handler is
# the field-index map for a dead-code perform, never an installed handler.
fn kir_synth_default_for_effect(eff: String, esym: SymId, ops: [EffectOp],
                                defblk: Option[DefaultBlock]) : KDefault =
  match defblk {
    Some(DBlk(clauses, _, _, _)) -> KDef(esym, kir_default_ops(clauses))
    None                         -> KDef(esym, kir_synth_ops(eff, ops))
  }

# Op→placeholder-symbol pairs in declaration order (the field offset). The
# symbol is inert (never called); the position is the load-bearing datum.
fn kir_synth_ops(eff: String, ops: [EffectOp]) : [KDefOp] = match ops {
  [] -> []
  [EffOp(op_name, _, ps, _, _, _), ...rest] ->
    [KDOp(op_name, string_concat("kaix_synth_", string_concat(eff,
       string_concat("_", op_name))), list_length(ps) + 2), ...kir_synth_ops(eff, rest)]
}

# --- Diagnostics --------------------------------------------------------

# The surface name of an AST expression kind, for the loud "unhandled
# node" trap (replacing a silent catch-all). A local copy so
# the lowering does not import `emit_llvm` (which would create a
# lowering → emitter cycle — the emitter consumes KIR, never the other
# way). Only the kinds that can plausibly reach a post-perceus AST need a
# real name; the rest share a generic label.
pub fn kir_expr_kind_name(k: ExprKind) : String = match k {
  ELambda(_, _)     -> "ELambda"
  EHandle(_, _, _, _, _, _, _) -> "EHandle"
  ERecordLit(_, _)  -> "ERecordLit"
  ERange(_, _, _)   -> "ERange"
  EVariantsOf(_, _) -> "EVariantsOf"
  EModCall(_, _)    -> "EModCall"
  EBang(_)          -> "EBang"
  EHole(_)          -> "EHole"
  ETodo(_)          -> "ETodo"
  EExternBody(_, _) -> "ETodo"
  EIntrinsic(_, _)  -> "EIntrinsic"
  _                 -> "other"
}
