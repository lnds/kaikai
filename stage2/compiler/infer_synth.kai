# route an expression through `check_match` when its
# AST head is `EMatch`, otherwise fall back to synth. The post-hoc
# unify in the caller (`infer_decl`, `synth_stmt` for SLet) handles
# the non-match case; for match the propagation already happened
# inside `check_match`.
# extends to `EIf` via `check_if`.
#[doc("Typer-internal helper `check_expr_against` shared across the infer modules.")]
pub fn check_expr_against(st: InferState, e: Expr, expected: Ty, what: String, line: Int, col: Int) : Inferred / Console + File + Mutable =
  match e.kind {
    EMatch(scr, arms)       -> check_match(st, scr, arms, expected, e.line, e.col)
    EIf(c, t_, eo)          -> check_if(st, c, t_, eo, expected, e.line, e.col)
    EList(els)              -> check_list_against(st, e, els, expected)
    EDispatchPipe(PoMap, _, _) -> check_map_pipe_against(st, e, expected)
    ECall(callee, args_)    -> ctor_coerce_expected(ctor_check_or_synth(st, e, callee, args_, expected, line, col), expected)
    EName(_)                -> nullary_ctor_check_or_synth(st, e, expected)
    ESym(_, _)              -> nullary_ctor_check_or_synth(st, e, expected)
    ERecordLit(rh, fis)     -> synth_record_lit(st, rh, fis, expected, e.line, e.col)
    EBlock(stmts, Some(te)) -> check_block_against(st, e, stmts, te, expected, what)
    _                       -> w_synth(st, e)
  }

# A list literal under `[T]` checks each element against `T` (an Int literal
# becomes a Byte under `[Byte]`). Under `Vec[T]` it builds a pre-sized vec; a bare
# literal keeps denoting the cons list.
fn check_list_against(st: InferState, e: Expr, els: [ListElem], expected: Ty) : Inferred / Console + File + Mutable =
  match apply_ty(st.sub, expected) {
    TyListT(elem_ty)         -> check_list_elems_against(st, els, elem_ty, e.line, e.col)
    TyCon(tcs, hargs)        -> if core_ty_is(tcs, CtVec) { check_vec_lit_against(st, els, hargs, e.line, e.col) } else { w_synth(st, e) }
    TyDimT(TyCon(tcs, hargs), u) -> if core_ty_is(tcs, CtVec) { check_fixed_vec_lit(st, els, hargs, u, e.line, e.col) } else { w_synth(st, e) }
    _                        -> w_synth(st, e)
  }

# A map-pipe chain in Vec-expected position collects into a vec: a pure range-headed
# chain rewrites to the pre-sized collect, anything else materialises once.
fn check_map_pipe_against(st: InferState, e: Expr, expected: Ty) : Inferred / Console + File + Mutable = {
  let exp = apply_ty(st.sub, expected)
  if ty_is_fixed_vec(exp) { check_map_pipe_fixed_collect(st, e, exp, e.line, e.col) }
  else if ty_is_vec_head(exp) { check_map_pipe_vec_collect(st, e, e.line, e.col) }
  else { w_synth(st, e) }
}

# The expected type reaches the tail of a block, so a `{ ...; ctor(args) }` body
# gets the same constructor disambiguation as a bare constructor expression.
fn check_block_against(st: InferState, e: Expr, stmts: [Stmt], te: Expr, expected: Ty, what: String) : Inferred / Console + File + Mutable = {
  let is_ = w_synth_stmts(st, stmts)
  block_with_tail(st, e, is_, check_expr_against(is_.st, te, expected, what, te.line, te.col))
}


# A bare constructor call under an expected type that declares the
# constructor is rewritten to a call of that constructor: the
# expected type names the sum, so a same-named one never wins (a user
# variant may shadow `Result.Ok` / `Option.Some`).
fn ctor_check_or_synth(st: InferState, e: Expr, callee: Expr, args_: [Expr],
                          expected: Ty, line: Int, col: Int) : Inferred / Console + File + Mutable =
  match callee.kind {
    EName(w) -> match settle_name(st, None, w, expected, []) {
      SetOne(c) -> w_synth(st, mk_expr(ECall(mk_sym(c, callee.line, callee.col), args_), line, col))
      _         -> w_synth(st, e)
    }
    _ -> w_synth(st, e)
  }


# A bare nullary constructor under an expected type that declares it
# reads that declaration's scheme.
fn nullary_ctor_check_or_synth(st: InferState, e: Expr, expected: Ty) : Inferred / Console + File + Mutable =
  match e.kind {
    EName(w) -> match typed_ctor_entry(st, w, expected) {
      Some(CtorPick(c, entry)) -> synth_scheme_read(st, entry.scheme, c, mk_sym(c, e.line, e.col))
      None                     -> homonym_check_or_synth(st, e, w, expected)
    }
    _ -> w_synth(st, e)
  }


# A combinator several core modules declare, read under an expected function
# type, is the declaration of the module owning that type's first parameter.
fn homonym_check_or_synth(st: InferState, e: Expr, w: Written, expected: Ty) : Inferred / Console + File + Mutable =
  match apply_ty(st.sub, expected) {
    TyFnT(_, _, _) -> match settle_core_homonyms(st, expected, settle_name(st, None, w, expected, value_classes())) {
      SetOne(s) -> if core_is_restated(s) { w_synth(st, Expr { ...e, kind: ESym(s, spec_none()) }) } else { w_synth(st, e) }
      _         -> w_synth(st, e)
    }
    _ -> w_synth(st, e)
  }


# `[e1, ..., en]` under a `Vec[T]` expectation: coin numeric elements
# against `T` (the #1091 lattice), check the rest against `T` (Byte
# retag included), then hand the TYPED elements to the typed chain
# build — never re-synthesised, so retags survive. The caller's
# trailing unify confirms the result against the annotation. Spread
# elements have no vec build; they are rejected here.
fn check_vec_lit_against(st: InferState, els: [ListElem], hargs: [Ty],
                         line: Int, col: Int) : Inferred / Console + File + Mutable {
  if vec_lit_has_spread(els) {
    let perr = mk_diag(SevError, st.file, line, col, "spread elements are not supported in a Vec literal", [])
    let r = w_synth(st_bump_err(st_help(st_push_diag(st, perr), "build the list first and convert it: `vec_from_list([...xs, y])`")), mk_expr(EList(els), line, col))
    r
  } else {
    let elem_exp = match hargs { [t] -> apply_ty(st.sub, t)  _ -> TyAny }
    let checked = check_vec_elems(st, els, elem_exp, line, col, [])
    let vty = core_ty_con(CtVec, [apply_ty(checked.st.sub, elem_exp)])
    mk_inferred(checked.st, vty, vec_lit_build(list_reverse(checked.elems), vty, line, col))
  }
}


# `[e1, ..., en]` under a `Vec[T]<k>` expectation: the habitant IS
# the length. A known value index must equal the element count; an
# unbound index variable brands the literal with its own length and
# the caller's trailing unify binds it (the kind gate rejects a
# non-`Dim` variable there). A habitant that is no `Int` value index
# cannot fix a length — the carrier guard at the formation site.
fn check_fixed_vec_lit(st: InferState, els: [ListElem], hargs: [Ty], u: UnitExprT,
                       line: Int, col: Int) : Inferred / Console + File + Mutable {
  let r = check_vec_lit_against(st, els, hargs, line, col)
  let hab = apply_unit(r.st.sub, u)
  let n = list_length(els)
  match fixed_vec_hab(hab, n) {
    FVOk(h) -> {
      let bty = TyDimT(r.ty, h)
      if ty_is_fixed_vec(bty) { fixed_vec_lit_inferred(r, els, hargs, bty, line, col) }
      else { brand_vec_lit(r, h) }
    }
    FVLen(k) -> {
      let perr = mk_diag(SevError, r.st.file, line, col,
        concat_all(["vector literal has ", int_to_string(n), " elements, but its type fixes the length to ", int_to_string(k)]), [])
      brand_vec_lit(mk_inferred(st_bump_err(st_push_diag(r.st, perr)), r.ty, r.expr), hab)
    }
    FVCarrier -> {
      let perr = mk_diag(SevError, r.st.file, line, col,
        concat_all(["`", inf_unit_canon_display(hab), "` cannot fix a `Vec` length — the index of a fixed-width `Vec` is an `Int` value habitant (`Dim`)"]), [])
      brand_vec_lit(mk_inferred(st_bump_err(st_push_diag(r.st, perr)), r.ty, r.expr), hab)
    }
  }
}


# A concrete `Vec[e]<n>` literal builds the fixed inline representation:
# the elements are re-checked (already coined once, so this only re-reads
# the typed forms) and handed to the `__fixed_vec_lit` intrinsic the C
# emitter lowers to a flat `(cname){ .a = {...} }` aggregate. The node is
# MUnboxed — a fixed vec has no boxed form.
fn fixed_vec_lit_inferred(r: Inferred, els: [ListElem], hargs: [Ty], bty: Ty,
                          line: Int, col: Int) : Inferred / Console + File + Mutable {
  let elem_exp = match hargs { [t] -> apply_ty(r.st.sub, t)  _ -> TyAny }
  let checked = check_vec_elems(r.st, els, elem_exp, line, col, [])
  let call = fixed_vec_lit_build(list_reverse(checked.elems), bty, line, col)
  mk_inferred(checked.st, bty, unboxed_expr(call))
}


fn check_vec_elems(st: InferState, els: [ListElem], elem_ty: Ty,
                   line: Int, col: Int, acc: [Expr]) : VecElems / Console + File + Mutable =
  match els {
    [] -> VecElems { st: st, elems: acc }
    [el, ...rest] -> match el {
      ElPlain(ex) -> match mint_literal(ex, apply_ty(st.sub, elem_ty), mint_bigint_home(st.env)) {
        MintOk(m) -> check_vec_elems(st, rest, elem_ty, line, col, [m, ...acc])
        MintErr(msg) -> {
          let perr = mk_diag(SevError, st.file, ex.line, ex.col, msg, [])
          check_vec_elems(st_bump_err(st_push_diag(st, perr)), rest, elem_ty, line, col, [ex, ...acc])
        }
        MintNone -> {
          let r = check_elem_against(st, ex, apply_ty(st.sub, elem_ty), line, col)
          check_vec_elems(r.st, rest, elem_ty, line, col, [r.expr, ...acc])
        }
      }
      ElSpread(ex) -> check_vec_elems(st, rest, elem_ty, line, col, [ex, ...acc])
    }
  }


# A Vec-typed map-pipe chain. Pure stages over a range head collect
# into ONE pre-sized buffer (`range_map_collect_vec`); an impure stage
# or a non-range source keeps the ordinary list pipeline and converts
# once via `vec_from_list` — same semantics, one materialisation.
fn check_map_pipe_vec_collect(st: InferState, e: Expr,
                              line: Int, col: Int) : Inferred / Console + File + Mutable =
  match pipe_fusion_as_collect(e) {
    None -> w_synth(st, e)
    Some(fc) -> {
      let g = fuse_all_raw(st, fc.stages, false)
      if g.ok {
        match pipe_fusion_collect_rewrite(fc, line, col) {
          Some(rewritten) -> match fuse_source_peek(g.st, fc.source) {
            FSP(s, _, true)  -> w_synth(s, vec_collect_via_list(e, line, col))
            FSP(s, _, false) -> w_synth(s, rewritten)
          }
          None -> w_synth(g.st, vec_collect_via_list(e, line, col))
        }
      } else { w_synth(g.st, vec_collect_via_list(e, line, col)) }
    }
  }


# A map-pipe chain in a `Vec[e]<n>` slot: a fixed vec has no runtime
# length, so the chain may only collect there when its length is proved
# HERE. A map is 1:1, so the length is the source's — provable for a
# literal head (`[a, b, c] | f`), where the chain unrolls to one literal
# of per-element stage applications and rides the fixed-vec literal path.
# Any other head has a statically-unknown length and is declined loudly,
# never silently collected into a wrong-length aggregate.
fn check_map_pipe_fixed_collect(st: InferState, e: Expr, expected: Ty,
                                line: Int, col: Int) : Inferred / Console + File + Mutable =
  match pipe_fusion_as_collect(e) {
    None -> w_synth(st, e)
    Some(fc) -> match fixed_collect_unroll(fc, line, col) {
      Some(unrolled) -> check_expr_against(st, unrolled, expected, "fixed-width vector collect", line, col)
      None -> {
        let perr = mk_diag(SevError, st.file, line, col,
          concat_all(["a `|` chain cannot collect into a fixed-width `Vec[t]<",
            int_to_string(fixed_vec_n(expected)),
            ">`: its length is not known at compile time"]), [])
        mk_inferred(st_bump_err(st_help(st_push_diag(st, perr), "start the chain from a vector literal, or collect into a dynamic `Vec` first")), expected, with_ty(e, expected))
      }
    }
  }


#[doc("Typer-internal helper `check_list_elems_against` shared across the infer modules.")]
pub fn check_list_elems_against(st: InferState, els: [ListElem], elem_ty: Ty,
                            line: Int, col: Int) : Inferred / Console + File + Mutable {


  let acc = check_list_elems_loop(st, els, elem_ty, line, col, [])
  let ty = TyListT(elem_ty)
  let root = with_ty(mk_expr(EList(list_reverse(acc.elems)), line, col), ty)
  mk_inferred(acc.st, ty, root)
}


fn check_list_elems_loop(st: InferState, els: [ListElem], elem_ty: Ty,
                         line: Int, col: Int, acc: [ListElem]) : InferredElems / Console + File + Mutable {


  match els {
    [] -> InferredElems { st: st, elems: acc }
    [el, ...rest] -> match el {
      ElPlain(ex) -> {
        let r = check_elem_against(st, ex, elem_ty, line, col)
        check_list_elems_loop(r.st, rest, elem_ty, line, col, [ElPlain(r.expr), ...acc])
      }
      ElSpread(ex) -> {
        let r = w_synth(st, ex)
        let s1 = st_unify(r.st, TyListT(elem_ty), r.ty, "list spread", line, col)
        check_list_elems_loop(s1, rest, elem_ty, line, col, [ElSpread(r.expr), ...acc])
      }
    }
  }
}


fn check_elem_against(st: InferState, ex: Expr, elem_ty: Ty, line: Int, col: Int) : Inferred / Console + File + Mutable =
  match ex.kind {
    EInt(n, _) -> match elem_ty {
      TyByte -> check_byte_literal(st, ex, n, line, col)
      _      -> elem_synth_unify(st, ex, elem_ty, line, col)
    }
    EList(_) -> if ty_vec_headed(elem_ty) { check_nested_list(st, ex, elem_ty, line, col) } else { elem_synth_unify(st, ex, elem_ty, line, col) }
    _        -> elem_synth_unify(st, ex, elem_ty, line, col)
  }

fn check_byte_literal(st: InferState, ex: Expr, n: Int, line: Int, col: Int) : Inferred / Console + File + Mutable =
  if n >= 0 and n <= 255 { mk_inferred(st, TyByte, with_ty(mk_expr(mk_int_synth(n), ex.line, ex.col), TyByte)) }
  else {
    let r = w_synth(st, ex)
    let s1 = st_unify(r.st, TyByte, r.ty, "Byte literal out of range 0..255", line, col)
    mk_inferred(s1, TyByte, r.expr)
  }

# A list literal against a Vec-typed element (a fixed-width matrix row) re-enters
# the bidirectional path, so the inner literal builds a vec and binds its length.
fn check_nested_list(st: InferState, ex: Expr, elem_ty: Ty, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let r = check_expr_against(st, ex, elem_ty, "list element", ex.line, ex.col)
  let s1 = st_unify(r.st, elem_ty, r.ty, "list element", line, col)
  mk_inferred(s1, apply_ty(s1.sub, r.ty), r.expr)
}


fn elem_synth_unify(st: InferState, ex: Expr, elem_ty: Ty,
                    line: Int, col: Int) : Inferred / Console + File + Mutable {
  let r0 = synth_expecting(st, ex, elem_ty)
  let r = if not (rc_mentions(elem_ty) or rc_mentions_in(r0.st.sub, r0.ty)) { r0 } else {
    let m = refine_coerce(MintedExpr { st: r0.st, pair: ExprTy { expr: r0.expr, ty: r0.ty } }, elem_ty, "list element", ex.line, ex.col)
    mk_inferred(m.st, m.pair.ty, m.pair.expr)
  }
  let s1 = st_unify(r.st, elem_ty, r.ty, "list element", line, col)
  mk_inferred(s1, elem_ty, r.expr)
}


# same idea but threaded through an EBlock when the tail
# is itself an EMatch. The fn-body case `fn f(...) : T = match { ... }`
# parses as a bare EMatch (handled by `check_expr_against`), but
# `fn f(...) : T { ...stmts... match { ... } }` parses as an EBlock
# whose tail is an EMatch — synth_block ignores the expected type, so
# we recreate just enough of synth_block here to route the tail
# through check_match while the prefix stmts still synth normally.
# A dimensioned literal body coins to the declared carrier, as it does
# under a `let` annotation or in an argument slot.
fn check_literal_against(st: InferState, body: Expr, expected: Ty,
                         line: Int, col: Int) : Inferred / Console + File + Mutable {
  let r = w_synth(st, body)
  let m = maybe_mint_literal(r.st, r.expr, r.ty, apply_ty(r.st.sub, expected), line, col)
  mk_inferred(m.st, m.pair.ty, m.pair.expr)
}


#[doc("Typer-internal helper `check_body_against_ret` shared across the infer modules.")]
pub fn check_body_against_ret(st: InferState, body: Expr, expected: Ty, what: String, line: Int, col: Int) : Inferred / Console + File + Mutable =
  match body.kind {
    EMatch(scr, arms)   -> check_match(st, scr, arms, expected, body.line, body.col)
    EIf(c, t_, eo)      -> check_if(st, c, t_, eo, expected, body.line, body.col)
    ELitUnit(_, _)      -> check_literal_against(st, body, expected, line, col)
    EBlock(stmts, Some(te)) -> check_body_block(st, body, stmts, te, expected, what)
    EBlock(_, None)     -> w_synth(st, body)
    ECall(_, _)         -> check_expr_against(st, body, expected, what, body.line, body.col)
    EName(_)            -> check_expr_against(st, body, expected, what, body.line, body.col)
    ESym(_, _)          -> check_expr_against(st, body, expected, what, body.line, body.col)
    _                   -> if let_rhs_takes_expected(body) { check_expr_against(st, body, expected, what, body.line, body.col) } else { synth_expecting(st, body, expected) }
  }

# `expected` reaches a block tail that is a match, an if, or a bare constructor
# reference (a call, or a name the resolver left written), so annotation-driven
# disambiguation picks a user variant over the core builtin. Other tails keep
# synthing the whole body.
fn check_body_block(st: InferState, body: Expr, stmts: [Stmt], te: Expr, expected: Ty, what: String) : Inferred / Console + File + Mutable =
  match te.kind {
    EMatch(scr, arms) -> {
      let is_ = w_synth_stmts(st, stmts)
      block_with_tail(st, body, is_, check_match(is_.st, scr, arms, expected, te.line, te.col))
    }
    EIf(c, t_, eo)    -> {
      let is_ = w_synth_stmts(st, stmts)
      block_with_tail(st, body, is_, check_if(is_.st, c, t_, eo, expected, te.line, te.col))
    }
    ECall(_, _)       -> check_block_tail(st, stmts, te, expected, what, body)
    EName(_)          -> check_block_tail(st, stmts, te, expected, what, body)
    _                 -> if is_record_lit(te) or let_rhs_takes_expected(te) { check_block_tail(st, stmts, te, expected, what, body) } else { w_synth(st, body) }
  }

fn block_with_tail(st: InferState, body: Expr, is_: InferredStmts, r: Inferred) : Inferred / Console + File + Mutable {
  let st2 = st_restore_entries(st, r.st)
  let ty = apply_ty(st2.sub, r.ty)
  mk_inferred(st2, ty, with_ty(mk_expr(EBlock(is_.stmts, Some(r.expr)), body.line, body.col), ty))
}


# The block `{ stmts; te }` with its tail checked against `expected`.
fn check_block_tail(st: InferState, stmts: [Stmt], te: Expr, expected: Ty,
                    what: String, body: Expr) : Inferred / Console + File + Mutable = {
  let is_ = w_synth_stmts(st, stmts)
  let r = check_expr_against(is_.st, te, expected, what, te.line, te.col)
  let st2 = st_restore_entries(st, r.st)
  let ty = apply_ty(st2.sub, r.ty)
  mk_inferred(st2, ty, with_ty(mk_expr(EBlock(is_.stmts, Some(r.expr)), body.line, body.col), ty))
}


#[doc("Typer-internal helper `synth` shared across the infer modules.")]
pub fn synth(st: InferState, e: Expr) : Inferred / Console + File + Mutable =
  match e.kind {
    EInt(_, _)        -> inferred_leaf(st, TyInt, e)
    EFixed(span, ty)  -> match ty {
      TyByte -> synth_byte_lit(st, decode_int(span), e)
      _      -> inferred_leaf(st, ty, e)
    }
    EReal(_, _)       -> inferred_leaf(st, TyReal, e)
    EIntLit(span)     -> synth_lit_mint_or_err(st, e, EIntLit(span))
    EDecimalLit(_)    -> synth_lit_mint_or_err(st, e, e.kind)
    EBool(_)          -> inferred_leaf(st, TyBool, e)
    EChar(_)          -> inferred_leaf(st, TyChar, e)
    EStr(_, _)        -> inferred_leaf(st, TyString, e)
    EUnit             -> inferred_leaf(st, TyUnit, e)
    EUnder            -> synth_misplaced(st, e, "`_` is not an expression; it is a pattern wildcard, or a `|>` argument placeholder")
    EPlaceholder      -> synth_misplaced(st, e, "`.` placeholder used outside lambda-expected position; use a named arrow `(x) => ...`")
    ESym(sy, _)       -> synth_sym_read(st, sy, e)
    ELocal(l)         -> synth_local_read(st, l, e)
    EOp(r)            -> synth_op_read(st, r, e)
    EName(nm)         -> synth_name_read(st, nm, e)
    EMark(m)          -> synth_mark_read(st, m, e)
    ECall(callee, args_)       -> synth_call_site(st, callee, args_, e.line, e.col)
    EField(obj, fnm)           -> match op_value_lambda(st, obj, fnm, e.line, e.col) {
      Some(lam) -> w_synth(st, lam)
      None      -> synth_field(st, obj, fnm, e.line, e.col)
    }
    EIndex(coll, ix)           -> synth_index(st, coll, ix, e.line, e.col)
    EBinop(op, l, r)           -> synth_binop(st, op, l, r, e.line, e.col)
    EUnop(op, x)               -> synth_unop(st, op, x, e.line, e.col)
    EIf(c, t_, eo)             -> synth_if(st, c, t_, eo, e.line, e.col)
    EMatch(scr, arms)          -> synth_match(st, scr, arms, e.line, e.col)
    ELambda(ps, body)          -> synth_lambda(st, ps, body, e.line, e.col)
    ERecordLit(rh, fis)        -> synth_record_lit(st, rh, fis, TyAny, e.line, e.col)
    EList(els)                 -> synth_list_expr(st, els, e.line, e.col)
    ERange(lo, hi, stp)        -> synth_range(st, lo, hi, stp, e.line, e.col)
    EBlock(stmts, tail)        -> synth_block(st, stmts, tail, e.line, e.col)
    EPipe(lhs, rhs)            -> synth_pipe(st, lhs, rhs, e.line, e.col)
    EDispatchPipe(op, lhs, rhs) -> synth_pipe_dispatch(st, op, lhs, rhs, e.line, e.col)
    EHole(nm_opt)              -> synth_hole(st, nm_opt, e)
    ETodo(msg)                 -> synth_todo(st, msg, e)
    EExternBody(_, _)          -> synth_extern_body(st, e)
    EBang(inner)               -> synth_bang(st, inner, e.line, e.col)
    EHandle(_, _, _, _, _, _, _) -> synth_handle(st, e)
    ELitUnit(inner, u)         -> synth_lit_unit(st, inner, u, e.line, e.col)
    EVariantsOf(ty_expr, _)    -> synth_variants_of(st, ty_expr, e)
    ESurface(_)                -> panic("infer: ESurface must be lowered by surface_lower before the typer")
    EIntrinsic(nm, args_)      -> synth_intrinsic(st, nm, args_, e)
    EModCall(m, fname)         -> synth_mod_call(st, m, fname, e)
  }

# `_` and `.` reaching the typer are in value position: `try_pipe_placeholder` and
# the argument-position desugar consume the legitimate ones. Typing the node `TyAny`
# keeps the cascade quiet.
fn synth_misplaced(st: InferState, e: Expr, msg: String) : Inferred / Console + File + Mutable = {
  let perr = mk_diag(SevError, st.file, e.line, e.col, msg, [])
  inferred_leaf(st_bump_err(st_push_diag(st, perr)), TyAny, e)
}

# A loop intrinsic types exactly as the combinator call it replaced: arg 0 is the
# original callee, so `synth_call` gives the same scheme lookup, lambda checking and
# row join. Any other `$<name>(args)` is an error.
fn synth_intrinsic(st: InferState, nm: Intrinsic, args_: [Expr], e: Expr) : Inferred / Console + File + Mutable =
  if is_loop_intrinsic(nm) {
    match args_ {
      [callee, ...rest] -> rewrap_loop_intrinsic(synth_call(st, callee, rest, e.line, e.col), nm, e)
      _ -> synth_misplaced(st, e, concat_all(["compiler intrinsic `$", intrinsic_name(nm), "` has a malformed argument list"]))
    }
  } else { synth_other_intrinsic(st, nm, args_, e) }

# A rewrite that changes the node shape falls back to the rewritten call, dropping
# the intrinsic rather than guessing at its semantics.
fn rewrap_loop_intrinsic(r: Inferred, nm: Intrinsic, e: Expr) : Inferred =
  match r.expr.kind {
    ECall(callee2, rest2) ->
      Inferred { st: r.st, ty: r.ty,
                 expr: Expr { kind: EIntrinsic(nm, [callee2, ...rest2]), line: e.line, col: e.col,
                              ty: r.expr.ty, mode: r.expr.mode, site: e.site } }
    _ -> r
  }

fn synth_other_intrinsic(st: InferState, nm: Intrinsic, args_: [Expr], e: Expr) : Inferred / Console + File + Mutable =
  match nm {
    InResumeFrame -> synth_resume_frame(st, args_, e)
    InResumeBad   -> report_resume_bad(st, args_, e)
    InSegHandle   -> synth_seg_handle(st, args_, e)
    InSegRequest  -> synth_seg_request(st, args_, e)
    InAbsent      -> {
      let r = st_fresh_ty(st)
      inferred_leaf(r.st, r.ty, e)
    }
    InCovHit(_)   -> inferred_leaf(st, TyUnit, e)
    _             -> synth_misplaced(st, e, concat_all(["compiler intrinsic `$", intrinsic_name(nm), "` is not valid in this position"]))
  }

# The resolver only leaves a name the module exports, so a miss means the table and
# the decl stream disagree: a diagnostic at a concrete location, not a panic.
fn synth_mod_call(st: InferState, m: Written, fname: Written, e: Expr) : Inferred / Console + File + Mutable =
  match settle_name(st, Some(m), fname, TyAny, value_classes()) {
    SetOne(s)  -> synth_sym_read(st, s, Expr { ...e, kind: ESym(s, spec_none()) })
    SetTie(ss) -> inferred_leaf(report_name_tie(st, fname, ss, false, e.line, e.col), TyAny, e)
    _          -> synth_misplaced(st, e, "module '#{m}' does not export '#{fname}' at the typer (rqc / TyEnv mismatch — internal)")
  }



# type-check `handle { body } with Eff [as alias] {
# clauses }`. The body is walked under a fresh row accumulator;
# the named effect is filtered out of whatever the body
# accumulates, and the remainder merges back into the outer
# function's row. Clause bodies and the optional return clause
# are not type-checked against the op signatures here, and alias
# resolution (`Eff as log`) is not handled here.
fn synth_handle(st: InferState, e: Expr) : Inferred / Console + File + Mutable =
  match e.kind {
    EHandle(body, eff_ref, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) -> {
      let hsym = ref_sym(eff_ref)
      let it = handle_init(st, init_opt)
      let st_aliased = match alias_opt {
        Some(a) -> st_push_alias(it.st, a.id, hsym)
        None    -> it.st
      }
      let resolved_eff_tyargs = handle_tyargs(st, eff_tyargs, it.state_ty)
      let cap_tyargs = take_first_tys(resolved_eff_tyargs, eff_tparam_arity(st_aliased.op_eff_arities, hsym))
      let st_capbound = handle_bind_capability(st_aliased, alias_opt, hsym, cap_tyargs)
      let hb = handle_walk_body(st_capbound, body, alias_opt, hsym, cap_tyargs)
      let st_out2 = check_clause_names(check_handle_effect_known(hb.st, eff_ref, e.line, e.col), eff_ref, clauses, e.line, e.col)
      let stateful = match init_opt { Some(_) -> true None -> false }
      let r_typed = check_return_clause_opt(st_out2, ret_opt, hb.rb.ty, stateful, it.state_ty)
      let cs_typed = check_clauses_types(r_typed.st, hsym, clauses, stateful, it.state_ty, resolved_eff_tyargs, r_typed.ty)
      let hty = apply_ty(cs_typed.st.sub, r_typed.ty)
      let tyargs_stamped = stamp_tes(eff_tyargs, resolved_eff_tyargs, (te: TypeExpr) => st_annot_ty(st, te))
      let new_e = with_ty(mk_expr(EHandle(hb.rb.expr, eff_ref, tyargs_stamped, it.init_opt, alias_opt, cs_typed.clauses, r_typed.ret_opt), e.line, e.col), hty)
      mk_inferred(cs_typed.st, hty, new_e)
    }
    _ -> mk_inferred(st, TyAny, with_ty(e, TyAny))
  }

# The init is typed in the outer scope; its type is the handler-state type, which
# reaches the clauses so `state` and the two-argument `resume(v, ns)` are typed
# precisely.
fn handle_init(st: InferState, init_opt: Option[Expr]) : IT / Console + File + Mutable =
  match init_opt {
    Some(ie) -> {
      let ri = synth(st, ie)
      IT { st: ri.st, init_opt: Some(ri.expr), state_ty: Some(apply_ty(ri.st.sub, ri.ty)) }
    }
    None -> IT { st: st, init_opt: None, state_ty: None }
  }

# A stateful handler that omits `[T]` but supplies an `(init)` takes its single type
# argument from the init's type; written type arguments round-trip verbatim.
fn handle_tyargs(st: InferState, eff_tyargs: [TypeExpr], state_ty: Option[Ty]) : [Ty] =
  match eff_tyargs {
    [] -> match state_ty {
      Some(t) -> [t]
      None    -> []
    }
    _ -> map(eff_tyargs, (t) => st_annot_ty(st, t))
  }

# `with Eff as a` makes `a` a first-class capability value of the effect's nominal
# type, truncated to the effect's own tparams, so it unifies with a `c: Eff`
# parameter even when `with Cell(0)` infers an Int state.
fn handle_bind_capability(st: InferState, alias_opt: Option[Binder], hsym: SymId, cap_tyargs: [Ty]) : InferState =
  match alias_opt {
    Some(a) -> st_set_env(st, env_bind_local(st.env, a, mono(TyCon(hsym, cap_tyargs))))
    None    -> st
  }

type HandleBody = { rb: Inferred, st: InferState }

# The body is walked under a fresh row; only the labels whose type arguments unify
# with the handler's instantiation are discharged. The rest, and any label of a
# sibling cell, propagate to the outer row. The discharge binds the cell's type, so
# its substitution flows into the output state.
fn handle_walk_body(st_capbound: InferState, body: Expr, alias_opt: Option[Binder], hsym: SymId, cap_tyargs: [Ty]) : HandleBody / Console + File + Mutable = {
  let st_in = InferState { ...st_set_row(st_capbound, []), row_tails: [] }
  let rb_raw = synth(st_in, body)
  let rb0 = Inferred { ...rb_raw, st: st_scope_tails(rb_raw.st, st_capbound.row_tails) }
  let cell = match alias_opt { Some(a) -> a.id  None -> local_none() }
  let rb = Inferred { ...rb0, st: holes_under_handler(rb0.st, list_length(st_in.holes), label_in_cell(hsym, cap_tyargs, cell)) }
  let filt = filter_labels_matching_res(rb.st.row, hsym, cell, cap_tyargs, rb.st.sub)
  let rb_st1 = InferState { ...st_set_sub(rb.st, filt.sub), eff_uses: scope_eff_uses(st_capbound.eff_uses, rb.st.eff_uses, filt.kept) }
  let st_out0 = st_merge_labels(st_set_row(rb_st1, st_capbound.row), filt.kept)
  HandleBody { rb: rb, st: match alias_opt { Some(_) -> st_pop_alias(st_out0)  None -> st_out0 } }
}



fn check_return_clause_opt(st: InferState, ret_opt: Option[HReturn],
                           body_ty: Ty, stateful: Bool,
                           state_ty: Option[Ty]) : RetTyped / Console + File + Mutable {


  match ret_opt {
    None    -> RetTyped { st: st, ty: body_ty, ret_opt: None }
    Some(r) -> match r {
      HR(b, rexpr, line, col) -> {
        let outer = st
        let env1 = env_bind_local(st.env, b, mono(body_ty))
        # `state` / `log` get the actual handler-state type
        # in the return clause so `return(x) -> (x, state)` types as
        # `(body_ty, state_ty)`.
        let sty = match state_ty { Some(t) -> t None -> TyAny }
        let env2 = if stateful { add_state_aliases(env1, sty) } else { env1 }
        let st1 = st_set_env(st, env2)
        let rr = synth(st_clause_alias_tags(st1), rexpr)
        let st_out = st_restore_entries(outer, rr.st)
        let ty = apply_ty(st_out.sub, rr.ty)
        RetTyped { st: st_out, ty: ty, ret_opt: Some(HR(b, rr.expr, line, col)) }
      }
    }
  }
}



# `result_ty` is the handle's type: what `resume` returns and what every
# op clause evaluates to.
fn check_clauses_types(st: InferState, eff: SymId, cs: [HClause],
                        stateful: Bool, state_ty: Option[Ty],
                        eff_tyargs: [Ty], result_ty: Ty) : ClausesTyped / Console + File + Mutable =


  check_clauses_types_loop(st, eff, cs, stateful, state_ty, eff_tyargs, result_ty, [])



fn check_clauses_types_loop(st: InferState, eff: SymId, cs: [HClause], stateful: Bool, state_ty: Option[Ty],
                            eff_tyargs: [Ty], result_ty: Ty, acc: [HClause]) : ClausesTyped / Console + File + Mutable =
  match cs {
    [] -> ClausesTyped { st: st, clauses: list_reverse(acc) }
    [HC(head, params, body, line, col), ...rest] -> {
      let ct = if is_lifecycle_clause(head) { check_finally_clause(st, head, params, body, line, col, stateful, state_ty) }
               else { check_op_clause(st, eff, head, params, body, line, col, stateful, state_ty, eff_tyargs, result_ty) }
      check_clauses_types_loop(ct.st, eff, rest, stateful, state_ty, eff_tyargs, result_ty, [ct.clause, ...acc])
    }
  }

# The clause's parameter count must be the op's arity plus the trailing `resume`;
# its params are bound and the op's effect tparams unified with the handler's
# instantiation, so the answer type is concrete and `resume(v)` / `resume(v, ns)`
# are checked precisely. The typed body is kept so the op resolutions inside it
# reach the emit phase.
fn check_op_clause(st: InferState, eff: SymId, head: ClauseHead, params: [Param], body: Expr, line: Int, col: Int,
                   stateful: Bool, state_ty: Option[Ty], eff_tyargs: [Ty], result_ty: Ty) : ClauseTyped1 / Console + File + Mutable = {
  let st_arity = check_clause_arity(st, eff, clause_head_word(head), params, line, col)
  let bind_res = bind_clause_env_typed(st_arity, eff, clause_head_word(head), params, stateful, state_ty, eff_tyargs, result_ty)
  let st_clause_in = clause_entry_state(bind_res, stateful, state_ty, result_ty, params)
  let rb = synth(st_clause_in, body)
  let st_res = st_unify(rb.st, result_ty, rb.ty, "handler clause result", line, col)
  let st_esc = check_op_tparam_escape(st_res, bind_res.op_rigid, st_arity.env.fresh, state_ty, rb.ty, line, col)
  let st_out0 = st_restore_entries(st, st_esc)
  let st_out = st_set_sub(st_set_clause_resume(st_out0, st.clause_resume), subst_with_rigid(st_out0.sub, st.sub.rigid))
  ClauseTyped1 { st: st_out, clause: HC(head, params, rb.expr, line, col) }
}

fn clause_entry_state(bind_res: ClauseBindRes, stateful: Bool, state_ty: Option[Ty], result_ty: Ty, params: [Param]) : InferState = {
  let sty = match state_ty { Some(t) -> t None -> TyAny }
  let env_bound = bind_res.st.env
  let st_env = st_set_env(bind_res.st, if stateful { add_state_aliases(env_bound, sty) } else { env_bound })
  let answer_resolved = apply_ty(st_env.sub, bind_res.answer_ty)
  let st_resume = match state_ty {
    Some(sv) -> if stateful { st_set_clause_resume(st_env, Some(RB(answer_resolved, sv, result_ty))) } else { st_env }
    None     -> st_env
  }
  st_set_in_clause(st_clause_alias_tags(st_resume), clause_cont_of(params))
}



# `finally { }` runs with `evidence_top` restored to its own node's
# parent, so its body is typed in the OUTER scope: performing the very
# effect this handler discharges is an "effect not handled" error, not a
# runtime loop. It carries no params and its value is discarded, so it
# is checked against `Unit`. A stateful handler exposes `state`, which is
# what connects an `initially`-acquired resource to its release.
fn check_finally_clause(st: InferState, head: ClauseHead, params: [Param], body: Expr,
                        line: Int, col: Int, stateful: Bool,
                        state_ty: Option[Ty]) : ClauseTyped1 / Console + File + Mutable {

  let st_arity = match params {
    [] -> st
    _  -> {
      let perr = mk_diag(SevError, st.file, line, col,
        string_concat("`", string_concat(clause_head_word(head), " { }` takes no parameters")), [])
      st_bump_err(st_note(st_push_diag(st, perr), "`finally` runs for its effect only; use `return(x) -> ...` to transform the result"))
    }
  }
  let outer = st_arity
  let sty = match state_ty { Some(t) -> t None -> TyAny }
  let env1 = if stateful { add_state_aliases(outer.env, sty) } else { outer.env }
  let rb = synth(st_clause_alias_tags(st_set_env(outer, env1)), body)
  let st_out = st_restore_entries(outer, rb.st)
  ClauseTyped1 { st: st_out, clause: HC(head, params, rb.expr, line, col) }
}



# `expr!` typer.
# - Operand must be `Option[T]` or `Result[T, E]` (after substitution).
# - Enclosing function's declared return type must be the matching
#   `Option[U]` or `Result[U, E]` (same `E` — no `From` coercion).
# - Result type of the EBang node is the unwrapped success type `T`.
# Diagnostics name both types; the inner Expr is re-stamped with its
# resolved operand type so the C emitter can pick the correct
# discriminator (`Some` / `Ok`).
fn synth_bang(st: InferState, inner: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable = {
  let ri = synth(st, inner)
  let it_now = apply_ty(ri.st.sub, ri.ty)
  let inner_typed = with_ty(ri.expr, it_now)
  match it_now {
    TyCon(tcs, args_) -> bang_on_con(ri.st, tcs, args_, it_now, inner_typed, line, col)
    _                 -> bang_bad_operand(ri.st, it_now, inner_typed, line, col)
  }
}

fn bang_on_con(st: InferState, tcs: SymId, args_: [Ty], it_now: Ty, inner_typed: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable =
  match args_ {
    [t] -> if core_ty_is(tcs, CtOption) { bang_finish_option(st, inner_typed, t, line, col) } else { bang_bad_operand(st, it_now, inner_typed, line, col) }
    [t, e_ty] -> if core_ty_is(tcs, CtResult) { bang_finish_result(st, inner_typed, e_ty, t, line, col) } else { bang_bad_operand(st, it_now, inner_typed, line, col) }
    _ -> bang_bad_operand(st, it_now, inner_typed, line, col)
  }



fn synth_block(st: InferState, stmts: [Stmt], tail: Option[Expr], line: Int, col: Int) : Inferred / Console + File + Mutable {


  let outer = st
  let is = synth_stmts(st, stmts)
  let rt_kind = match tail {
    None     -> BlockTail { st: is.st, ty: TyUnit, expr_opt: None }
    Some(te) -> {
      let r = synth(is.st, te)
      BlockTail { st: r.st, ty: r.ty, expr_opt: Some(r.expr) }
    }
  }
  let st2 = st_restore_entries(outer, rt_kind.st)
  let ty = apply_ty(st2.sub, rt_kind.ty)
  let root = with_ty(mk_expr(EBlock(is.stmts, rt_kind.expr_opt), line, col), ty)
  mk_inferred(st2, ty, root)
}



#[doc("Typer-internal helper `synth_stmts` shared across the infer modules.")]
pub fn synth_stmts(st: InferState, stmts: [Stmt]) : InferredStmts / Console + File + Mutable {


  match stmts {
    [] -> InferredStmts { st: st, stmts: [] }
    [one, ...rest] -> {
      let r = synth_stmt(st, one)
      let rr = synth_stmts(r.st, rest)
      InferredStmts { st: rr.st, stmts: [r.stmt, ...rr.stmts] }
    }
  }
}



fn synth_stmt(st: InferState, stmt: Stmt) : OneStmt / Console + File + Mutable =
  match stmt {
    SLet(pat, ann, rhs) -> synth_let(st, pat, ann, rhs)
    SAssert(cond, msg) -> {
      let rc = synth_assert_cond(st, cond, contract_assert_kind(msg))
      let s1 = st_unify(rc.st, rc.ty, TyBool, "assert condition", cond.line, cond.col)
      let rm = synth_opt_expr(s1, msg)
      OneStmt { st: rm.st, stmt: SAssert(rc.expr, rm.expr) }
    }
    SExprStmt(ex) -> {
      let r = synth(st, ex)
      OneStmt { st: r.st, stmt: SExprStmt(r.expr) }
    }
    SAssign(_, _, _, _) -> panic("infer: SAssign must be lowered by surface_lower before the typer")
    SIndexAssign(b, i, v, line, col) -> synth_index_assign(st, b, i, v, line, col)
    SVar(name, ann, rhs, line, col) -> {
      let rr = synth(st, rhs)
      OneStmt { st: rr.st, stmt: SVar(name, ann, rr.expr, line, col) }
    }
    SUse(n, line, col) -> OneStmt { st: st, stmt: SUse(n, line, col) }
  }

fn synth_opt_expr(st: InferState, msg: Option[Expr]) : InferredOptExpr / Console + File + Mutable =
  match msg {
    None     -> InferredOptExpr { st: st, expr: None }
    Some(mx) -> {
      let r = synth(st, mx)
      InferredOptExpr { st: r.st, expr: Some(r.expr) }
    }
  }

# `Array[T]` lowers to `array_set(b, i, v)`. `Map[K, V]` is rejected with a typed
# error pointing at `map_put`; the node returned is filler, so downstream passes
# never see a typed `SIndexAssign`.
fn synth_index_assign(st: InferState, b: Expr, i: Expr, v: Expr, line: Int, col: Int) : OneStmt / Console + File + Mutable = {
  let probe = synth(st, b)
  match ty_coll(apply_ty(probe.st.sub, probe.ty)) {
    Some(CcMap) -> {
      let ri = synth(probe.st, i)
      let rv = synth(ri.st, v)
      let perr = mk_diag(SevError, st.file, line, col, "indexed write `m[k] := v` is not supported for `Map[K, V]` in v1", [])
      OneStmt { st: st_bump_err(st_help(st_push_diag(rv.st, perr), "use `map.put(m, k, v)` and rebind; the v2 design lands alongside the HAMT carrier")), stmt: SExprStmt(probe.expr) }
    }
    _ -> {
      let rc = synth(st, mk_expr(ECall(builtin_mk(CbArraySet, line, col), [b, i, v]), line, col))
      OneStmt { st: rc.st, stmt: SExprStmt(rc.expr) }
    }
  }
}

# An annotated let drives the forms that take an expected type in check mode, so
# it reaches every arm of a match or if, retags list elements, collects a Vec
# map-pipe and resolves a bare constructor to the one the annotation declares. A
# numeric literal coins directly to the annotated carrier from its lexeme.
fn let_rhs_checked(st: InferState, rhs: Expr, te: TypeExpr, label: String, pat: Pattern) : Inferred / Console + File + Mutable =
  if let_rhs_takes_expected(rhs) { check_expr_against(st, rhs, st_annot_ty(st, te), label, pat.line, pat.col) }
  else { synth_let_rhs_or_mint(st, rhs, te, pat.line, pat.col) }

fn let_rhs_takes_expected(rhs: Expr) : Bool =
  match rhs.kind {
    EMatch(_, _)               -> true
    EIf(_, _, _)               -> true
    EList(_)                   -> true
    EDispatchPipe(PoMap, _, _) -> true
    ECall(_, _)                -> true
    EName(_)                   -> true
    ELocal(_)                  -> true
    _                          -> false
  }

fn synth_let(st: InferState, pat: Pattern, ann: Option[TypeExpr], rhs: Expr) : OneStmt / Console + File + Mutable =
  match ann {
    None -> {
      let rr = synth(st, rhs)
      let_finish(pat, ann, rr.st, rr.ty, rr.expr)
    }
    Some(te) -> synth_let_annotated(st, pat, ann, te, rhs)
  }

# The annotation coins a numeric literal to the declared carrier, coerces a
# refinement, and is confirmed by the unifier, which stays the authority.
fn synth_let_annotated(st: InferState, pat: Pattern, ann: Option[TypeExpr], te: TypeExpr, rhs: Expr) : OneStmt / Console + File + Mutable = {
  let label = if pat_binds_var_ann(pat) { "var annotation" } else { "let annotation" }
  let rr = let_rhs_checked(st, rhs, te, label, pat)
  let minted = maybe_mint_literal(rr.st, rr.expr, rr.ty, apply_ty(rr.st.sub, st_annot_ty(rr.st, te)), pat.line, pat.col)
  let declared = st_annot_ty(minted.st, te)
  let coerced = if rc_mentions(declared) or rc_mentions_in(minted.st.sub, minted.pair.ty) { refine_coerce(minted, declared, binding_what(pat, label), pat.line, pat.col) } else { minted }
  let binding_st = st_unify(coerced.st, st_annot_ty(coerced.st, te), coerced.pair.ty, label, pat.line, pat.col)
  let_finish(pat, ann, binding_st, st_annot_ty(rr.st, te), coerced.pair.expr)
}

fn let_finish(pat: Pattern, ann: Option[TypeExpr], binding_st: InferState, ty0: Ty, expr: Expr) : OneStmt / Console + File + Mutable = {
  let after = check_pattern_stamped(binding_st, pat, let_binder_ty(ty0, expr))
  OneStmt { st: after.st, stmt: SLet(after.pat, ann, expr) }
}

# ---- patterns ----



#[doc("The recursion entry points of the walker, for the modules below `infer_synth`.")]
pub fn walker() : Walker = Walker {
  synth: synth,
  synth_stmts: synth_stmts,
  check_against: check_expr_against,
  check_body: check_body_against_ret,
  check_elems: check_list_elems_against
}
