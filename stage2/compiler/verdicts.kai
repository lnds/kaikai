# compiler/verdicts.kai — what each pass decided, and the one exit
# that reports it.
#
# A pass yields a `Verdict`: its error count and the diagnostics it
# collected. A pass that still only prints to stderr contributes its
# count and no diagnostics. The driver closes a stage with `vd_exit`,
# which returns the first failing count, or under `--diags-json` prints
# the collected diagnostics as one JSON document and succeeds.

import compiler.util
import compiler.diag
import compiler.infer_json_base

#[doc("A pass's verdict: how many errors it reported and the diagnostics it collected.")]
pub type Verdict = Verdict(Int, [Diagnostic])

#[doc("The verdict of a pass that only prints: its error count and no collected diagnostics.")]
pub fn vd_count(n: Int) : Verdict = Verdict(n, [])

#[doc("The verdict of a pass that collects: render each diagnostic to stderr and count its errors.")]
pub fn vd_render(ds: [Diagnostic]) : Verdict / Console + File = {
  each(ds, render_diag)
  Verdict(vd_errors(ds, 0), ds)
}

#[doc("The verdict of a pass whose diagnostics are already rendered: one error per diagnostic.")]
pub fn vd_rendered(ds: [Diagnostic]) : Verdict = Verdict(list_length(ds), ds)

#[doc("One verdict for several passes run as a unit: the first failing count and every collected diagnostic.")]
pub fn vd_merge(vs: [Verdict]) : Verdict = Verdict(vd_first(vs), vd_all(vs))

#[doc("Whether any of the verdicts carries an error.")]
pub fn vd_failed(vs: [Verdict]) : Bool = vd_first(vs) != 0

#[doc("Close a stage: the first failing count, or with `json` naming the file, print its diagnostics document and succeed.")]
pub fn vd_exit(json: Option[String], vs: [Verdict]) : Int / Console = match json {
  Some(file) -> { print(diags_doc(file, vd_first(vs), vd_all(vs))); 0 }
  None       -> vd_first(vs)
}

# `status` is the exit status the same run has without `--diags-json`.
fn diags_doc(file: String, status: Int, ds: [Diagnostic]) : String =
  concat_all(["{\"file\": ", json_str(file), ", \"status\": ", int_to_string(status),
              ", \"diagnostics\": [", join_with(map(ds, diag_json), ", "), "]}"])

fn vd_first(vs: [Verdict]) : Int = match vs {
  [] -> 0
  [Verdict(n, _), ...rest] -> if n != 0 { n } else { vd_first(rest) }
}

fn vd_errors(ds: [Diagnostic], n: Int) : Int = match ds {
  [] -> n
  [d, ...rest] -> vd_errors(rest, if diag_is_error(d) { n + 1 } else { n })
}

fn vd_all(vs: [Verdict]) : [Diagnostic] = match vs {
  [] -> []
  [Verdict(_, ds), ...rest] -> list_append(ds, vd_all(rest))
}

fn diag_json(d: Diagnostic) : String = match d {
  D(sev, file, line, col, msg, related) ->
    concat_all(["{\"severity\": ", json_str(severity_to_string(sev)), ", ", pos_json(file, line, col),
                ", \"message\": ", json_str(msg),
                ", \"related\": [", join_with(map(related, related_json), ", "), "]}"])
}

fn related_json(r: RelatedInfo) : String = match r {
  DR(file, line, col, msg) -> concat_all(["{", pos_json(file, line, col), ", \"message\": ", json_str(msg), "}"])
}

fn pos_json(file: String, line: Int, col: Int) : String =
  concat_all(["\"file\": ", json_str(file), ", \"line\": ", int_to_string(line), ", \"col\": ", int_to_string(col)])
