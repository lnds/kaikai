# compiler/closure_spec_emit.kai — spec emission: beta-reduce the
# closure into the callee body, retarget the spec's own recursion, close
# the effect row, and prune the now-unused row tparam. Consumes the
# shared AST helpers in closure_spec_ast.
#
# Substitution is by binder identity: a read is replaced when it carries
# the parameter's id, so no binder inside the body can hide or capture
# one. Every pasted copy of the closure takes binders of its own, since a
# function must not declare one binder twice.

import compiler.ast
import compiler.util
import compiler.emit_shared
import compiler.closure_spec_ast
import compiler.self_call
import compiler.closure_spec_share
import compiler.fnreg
import compiler.written

# What one spec's beta-reduction substitutes: the callee's functional
# parameter, the closure it is bound to, whether that closure stays one
# literal per application, and the spec's name, which keys the binders
# of each pasted copy.
type Beta = { f: LocalId, ca: ClosureArg, sh: Bool, key: String }

# Build the specialised decl `sname`: drop the functional parameter,
# beta-reduce every `f(args)` in the body, then retarget the body's own
# recursive `n(..., f)` calls onto this same spec so a self-recursive
# higher-order (`foldl_loop`) becomes a self-recursive spec — TRMC then
# re-forms the loop instead of a fresh one-iteration wrapper per
# recursion site. The callee's module rides inside the spec's name (see
# `cspec_name`); the spec itself is a root decl (`mo = None`), and its
# call sites name it by the id of that root-homed name, whether the
# original callee was `mod.f` or a bare `f`.
#
# The callee's body needs no qualifying to move to the root: each call in
# it names its declaration by id.
pub fn emit_cspec(r: CSpecReq, sname: String, target: String) : Decl =
  match r {
    CSReq(callee, idx, ca, _) -> match callee {
      DFn(p, me, tp, ps, rt, row, body, dl, dc, _) -> {
        let ssym = cspec_sym(sname, target)
        let f = param_id_at(ps, idx)
        let bx = Beta { f: f, ca: ca, sh: shares_closure(ca, body, f), key: sname }
        let body1 = beta_apply_all(retarget_self(body, SelfRef(me), idx, cspec_ref(ssym), f), bx)
        let ps1 = drop_param_at(ps, idx)
        # Only pure closures reach here (classify_closure gate), so the
        # stage adds no effect: the spec keeps the callee's own labels and
        # drops the now-unused row tparam. Mono then grounds every remaining
        # tparam a data argument pins — `r` from a fold's `init`, so unbox
        # lands the loop's accumulator; a return-only tparam (a collect's
        # element type) stays polymorphic and boxed, but the per-element
        # indirect call is gone regardless.
        let tp1 = keep_used(tp, list_append(sig_tparam_names(ps1, rt), row_te_names(row)))
        DFn(p, fnid_decl(ssym), tp1, ps1, rt, spec_row(row, tp1), body1, dl, dc, None)
      }
      _ -> callee
    }
  }

# A row variable no remaining parameter names was the stage's, and the
# stage is pure.
fn spec_row(r: RowExpr, tps: [String]) : RowExpr = match r {
  ROpen(v, ls) -> if list_has(tps, v) { r } else { match ls { [] -> REmpty  _ -> RClosed(ls) } }
  _ -> r
}

# Retarget a body's own recursive `n(args)` that passes the functional
# param `f` itself at `idx` onto the spec, with that argument dropped.
# Runs before beta-reduction: a self-call the inlined closure makes passes
# another closure and must stay a call to `n`.
fn retarget_self(e: Expr, me: SelfRef, idx: Int, sref: ExprKind, f: LocalId) : Expr =
  match e.kind {
    ECall(callee, args_) -> {
      let args1 = map(args_, (a) => retarget_self(a, me, idx, sref, f))
      if is_self_callee(callee, me) and passes_param(args_, idx, f) {
        remap(e, ECall(remap(callee, sref), drop_at(args1, idx)))
      } else {
        remap(e, ECall(retarget_self(callee, me, idx, sref, f), args1))
      }
    }
    _ -> remap(e, map_expr_kind(e.kind, (k) => retarget_self(k, me, idx, sref, f)))
  }

fn passes_param(args_: [Expr], idx: Int, f: LocalId) : Bool =
  idx < list_length(args_) and match elem_at(args_, idx).kind {
    ELocal(a) -> local_eq(a, f)
    _         -> false
  }

# Rewrite the functional parameter out of the body. A direct
# application `f(args)` beta-reduces to the inlined closure body; any
# OTHER use of `f` as a value (`foldl_loop(..., f)`) is replaced by the
# closure's literal form so the next fixpoint round specialises that
# inner higher-order call too — this is how the transitive chain
# `foldl → foldl_loop` reaches the loop that carries the per-element
# indirect call.
fn beta_apply_all(e: Expr, bx: Beta) : Expr =
  match e.kind {
    ECall(callee, args_) -> match callee.kind {
      ELocal(l) ->
        if local_eq(l, bx.f) {
          let args1 = map(args_, (a) => beta_apply_all(a, bx))
          if bx.sh { remap(e, ECall(closure_literal(bx, callee), args1)) } else { inline_apply(bx, e, args1) }
        }
        else { beta_descend(e, bx) }
      _ -> beta_descend(e, bx)
    }
    ELocal(l) -> if local_eq(l, bx.f) { closure_literal(bx, e) } else { e }
    _ -> beta_descend(e, bx)
  }

fn beta_descend(e: Expr, bx: Beta) : Expr =
  Expr { kind: map_expr_kind(e.kind, (k) => beta_apply_all(k, bx)),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

# The key of the copy pasted at `site`: one per spec and position.
fn paste_key(bx: Beta, site: Expr) : String =
  concat_all([bx.key, "_", int_to_string(site.line), "_", int_to_string(site.col)])

# The closure as a first-class value, to substitute for a bare use of
# the functional param. A lambda is its own literal; a named fn is a
# reference to its declaration. `site` supplies the position/type of the
# replaced use.
fn closure_literal(bx: Beta, site: Expr) : Expr =
  match bx.ca {
    CaLambda(ps, b) -> {
      let k = paste_key(bx, site)
      remap(site, ELambda(fresh_params(ps, k), fresh_expr(b, k)))
    }
    CaNamedFn(d)    -> remap(site, ESym(cs_decl_sym(d), spec_none()))
  }

# Beta-reduce one application of the closure to `args`. A parameter read
# MORE THAN ONCE whose value CARRIES RC (a boxed record/list/variant/String)
# must NOT be substituted directly: duplicating the argument into every
# occurrence makes perceus emit one `drop` per read, and the second read
# then hits freed memory (`p => R { a: p.a, b: p.b }`). Such a parameter is
# bound to a fresh `let` and the body reads that binder — restoring the
# linear-occurrence shape perceus assumes and evaluating the argument once.
# A parameter read at most once, or one whose value is a raw scalar (no RC),
# substitutes directly: a raw scalar duplicated is harmless, and direct
# substitution is what lets the collect's `k` stay unboxed.
fn inline_apply(bx: Beta, site: Expr, args_: [Expr]) : Expr = {
  let k = paste_key(bx, site)
  match bx.ca {
    CaLambda(ps, b) -> bind_once_apply(fresh_expr(b, k), fresh_params(ps, k), args_, k)
    CaNamedFn(d)    -> bind_once_apply(fresh_expr(decl_body(d), k), fresh_params(decl_params(d), k), args_, k)
  }
}

fn bind_once_apply(body: Expr, ps: [Param], args_: [Expr], k: String) : Expr = {
  let plan = plan_binds(body, ps, args_, k)
  let pasted = subst_params(body, cs_param_ids(ps), plan.repls)
  match plan.lets { [] -> pasted  _ -> mk_expr(EBlock(plan.lets, Some(pasted)), body.line, body.col) }
}

type BindPlan = { repls: [Expr], lets: [Stmt] }

# For each closure param decide direct substitution vs a fresh let binder.
# `repls` is what `subst_params` puts at each read of the param (the arg
# itself, or a read of the fresh binder); `lets` collects the
# `let fresh = arg` for the bound-once params.
fn plan_binds(body: Expr, ps: [Param], args_: [Expr], k: String) : BindPlan =
  match ps {
    [] -> BindPlan { repls: [], lets: [] }
    [p, ...prest] -> match args_ {
      [] -> BindPlan { repls: [], lets: [] }
      [a, ...arest] -> {
        let rest = plan_binds(body, prest, arest, k)
        if bind_once_needed(body, p.binder.id, a) {
          let fresh = once_binder(body, p, k)
          BindPlan { repls: [mk_local(fresh.id, body.line, body.col), ...rest.repls],
                     lets: [SLet(mk_pat(PBind(fresh), body.line, body.col), None, a), ...rest.lets] }
        } else {
          BindPlan { repls: [a, ...rest.repls], lets: rest.lets }
        }
      }
    }
  }

# The binder a bound-once param's argument takes. Its name carries the
# body position, so it reads apart from the callee's own binders; its id
# is the pasted copy's own.
fn once_binder(body: Expr, p: Param, k: String) : Binder = {
  let spelled = concat_all(["__csb_", int_to_string(body.line), "_", int_to_string(body.col), "_", written_text(p.binder.name)])
  binder_numbered(binder_minted(spelled), local_minted(concat_all([spelled, "@", k])))
}

# Bind-once is needed iff the param is read more than once AND either its
# value carries RC or the argument is not a single variable. Reads are
# counted syntactically, rounding up (both `if` arms count; an occurrence
# under a nested lambda counts) — over-counting only adds a redundant
# `let`, never a UAF. A scalar type does not make a copy free: a boxed Int
# outside the immediate range lives on the heap, and the copies of a
# compound argument would share the positions Perceus keys its reads by.
# A variable argument substitutes at each read's own position.
fn bind_once_needed(body: Expr, l: LocalId, arg: Expr) : Bool = {
  let occ = count_param_reads(body, l)
  occ.n > 1 and (not opt_ty_unboxable(occ.ty) or not arg_is_var(arg))
}

fn arg_is_var(a: Expr) : Bool = match a.kind {
  ELocal(_) -> true
  _         -> false
}

fn opt_ty_unboxable(ot: Option[Ty]) : Bool =
  match ot { Some(t) -> ty_is_unboxable_t(t)  None -> false }

type ReadCount = { n: Int, ty: Option[Ty] }

# Count the reads of the binder `l` in the body and capture one
# occurrence's resolved type (they share it).
fn count_param_reads(e: Expr, l: LocalId) : ReadCount =
  match e.kind {
    ELocal(x) -> if local_eq(x, l) { ReadCount { n: 1, ty: e.ty } } else { ReadCount { n: 0, ty: None } }
    _         -> count_reads_kids(cspec_kids(e), l, ReadCount { n: 0, ty: None })
  }

fn count_reads_kids(es: [Expr], l: LocalId, acc: ReadCount) : ReadCount =
  match es {
    [] -> acc
    [k, ...rest] -> {
      let c = count_param_reads(k, l)
      let ty1 = match acc.ty { Some(_) -> acc.ty  None -> c.ty }
      count_reads_kids(rest, l, ReadCount { n: acc.n + c.n, ty: ty1 })
    }
  }

# Substitute each read of a closure parameter by its argument expression.
fn subst_params(e: Expr, ids: [LocalId], args_: [Expr]) : Expr =
  match e.kind {
    ELocal(l) -> match index_of(ids, l, 0) {
      Some(i) -> at_read(elem_at(args_, i), e)
      None    -> e
    }
    _ -> remap(e, map_expr_kind(e.kind, (k) => subst_params(k, ids, args_)))
  }

# A variable argument takes the position of the read it replaces, so two
# reads of one param stay two reads.
fn at_read(arg: Expr, read: Expr) : Expr = match arg.kind {
  ELocal(_) -> Expr { kind: arg.kind, line: read.line, col: read.col, ty: arg.ty, mode: arg.mode,  site: read.site }
  _         -> arg
}

# ---- a pasted copy's own binders ----

# The copy keyed `k` declares, in place of the binder `l`, the binder this
# mints; an unnumbered binder stays so.
fn fresh_id(l: LocalId, k: String) : LocalId =
  if local_raw(l) == 0 { l }
  else { local_minted(concat_all([k, "#", int_to_string(local_raw(l))])) }

fn fresh_binder(b: Binder, k: String) : Binder = binder_numbered(b, fresh_id(b.id, k))

fn fresh_opt_binder(o: Option[Binder], k: String) : Option[Binder] =
  match o { Some(b) -> Some(fresh_binder(b, k))  None -> None }

fn fresh_params(ps: [Param], k: String) : [Param] =
  map(ps, (p) => Param { binder: fresh_binder(p.binder, k), ptype: p.ptype, pline: p.pline, pcol: p.pcol, pborrow: p.pborrow })

# A closure reads only binders it declares, so every binder and every
# read in it moves to the copy's ids together.
fn fresh_expr(e: Expr, k: String) : Expr = remap(e, fresh_kind(e.kind, k))

fn fresh_kind(kind: ExprKind, k: String) : ExprKind =
  match kind {
    ELocal(l)         -> ELocal(fresh_id(l, k))
    EOp(r)            -> EOp(OpRef { eff: r.eff, op: r.op, via: fresh_via(r.via, k) })
    ELambda(ps, b)    -> ELambda(fresh_params(ps, k), fresh_expr(b, k))
    EMatch(scr, arms) -> EMatch(fresh_expr(scr, k), map(arms, (a) => fresh_arm(a, k)))
    EBlock(ss, t)     -> EBlock(map(ss, (s) => fresh_stmt(s, k)), map_opt(t, (x) => fresh_expr(x, k)))
    EHandle(body, eff, targs, init, alias, cls, ret) ->
      EHandle(fresh_expr(body, k), eff, targs, map_opt(init, (x) => fresh_expr(x, k)),
              fresh_opt_binder(alias, k), map(cls, (c) => fresh_clause(c, k)), fresh_return(ret, k))
    _ -> map_expr_kind(kind, (x) => fresh_expr(x, k))
  }

fn fresh_via(v: OpVia, k: String) : OpVia = match v {
  ViaAmbient  -> v
  ViaAlias(l) -> ViaAlias(fresh_id(l, k))
  ViaRecv(l)  -> ViaRecv(fresh_id(l, k))
}

fn fresh_arm(a: Arm, k: String) : Arm = match a {
  Arm(pat, g, b) -> Arm(fresh_pat(pat, k), map_opt(g, (x) => fresh_expr(x, k)), fresh_expr(b, k))
}

fn fresh_stmt(s: Stmt, k: String) : Stmt = match s {
  SLet(pat, ann, rhs)     -> SLet(fresh_pat(pat, k), ann, fresh_expr(rhs, k))
  SVar(b, ann, rhs, l, c) -> SVar(fresh_binder(b, k), ann, fresh_expr(rhs, k), l, c)
  _                       -> map_stmt_exprs(s, (x) => fresh_expr(x, k))
}

fn fresh_clause(c: HClause, k: String) : HClause = match c {
  HC(h, ps, b, l, col) -> HC(h, fresh_params(ps, k), fresh_expr(b, k), l, col)
}

fn fresh_return(o: Option[HReturn], k: String) : Option[HReturn] = match o {
  Some(HR(b, e, l, c)) -> Some(HR(fresh_binder(b, k), fresh_expr(e, k), l, c))
  None                 -> None
}

fn fresh_pat(p: Pattern, k: String) : Pattern = mk_pat(fresh_pkind(p.pkind, k), p.line, p.col)

fn fresh_pkind(pk: PatKind, k: String) : PatKind = match pk {
  PBind(b)              -> PBind(fresh_binder(b, k))
  PAs(b, sub)           -> PAs(fresh_binder(b, k), fresh_pat(sub, k))
  PNarrow(b, te)        -> PNarrow(fresh_binder(b, k), te)
  PList(subs, rest)     -> PList(map(subs, (s) => fresh_pat(s, k)), fresh_opt_binder(rest, k))
  PVariant(r, subs)     -> PVariant(r, map(subs, (s) => fresh_pat(s, k)))
  PVariantRecord(r, fs) -> PVariantRecord(r, map(fs, (f) => fresh_pfield(f, k)))
  PRecord(fs)           -> PRecord(map(fs, (f) => fresh_pfield(f, k)))
  _                     -> pk
}

fn fresh_pfield(f: PField, k: String) : PField = match f {
  PField(n, sub, sh) -> PField(n, fresh_pat(sub, k), sh)
}
