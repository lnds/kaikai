#[doc("""Unit-of-measure and shape reference validation over declarations.

Checks that every unit and shape a declaration names is declared and
visible, that habitant slots match their kind, and that module and
semilattice unit shapes are well formed.
""")]

import compiler.ast
import compiler.kind_resolve
import compiler.infer_glue
import compiler.infer_state
import compiler.infer_dump_text
import compiler.infer_unit_habitant
import compiler.infer_unit_expr
import compiler.diag
import compiler.diag_file
import compiler.proto_resolve
import compiler.modules_homes

# Unit hygiene: walk every `UnitExprT` reachable from the decl
# stream and report an error for each `USym(name)` whose `name` is
# neither a built-in dimension symbol nor declared by a `unit` decl
# present in the merged stream. Returns the diagnostics found.
#
# Scoping rules:
#   - A unit name is module-scoped: the kind-resolution pass resolves
#     each use against the sites its module may see (own declaration
#     first, then exported foreign ones) and spells contested atoms
#     with their home module. What reaches this walk still bare is
#     undeclared, kind-ambiguous, or contested across modules with no
#     own declaration to win — each reported here.
#   - Unit-kind tparams (`impl[u: Measure] ...`) extend the visible
#     set for the duration of a single decl; that scoping is handled
#     in `validate_unit_refs_decl` itself.
#[doc("infer: `validate_unit_refs_decls` — typer entry point invoked by the driver; `ps` settles a type head from the file that writes it.")]
pub fn validate_unit_refs_decls(decls: [Decl], ps: PScope, scope: UnitScope,
                              df: DiagFiles) : [Diagnostic] =
  validate_unit_refs_decls_loop(decls, UnitCx { units: scope, ps: ps, home: None, aliases: unit_alias_tys(decls, ps), heads: true }, df, [])

#[doc("infer: `validate_unit_refs_decls` for declarations whose type aliases are already expanded, where a base is no longer the head the unit was written on.")]
pub fn validate_unit_refs_decls_expanded(decls: [Decl], ps: PScope, scope: UnitScope,
                              df: DiagFiles) : [Diagnostic] =
  validate_unit_refs_decls_loop(decls, UnitCx { units: scope, ps: ps, home: None, aliases: [], heads: false }, df, [])

fn unit_alias_tys(decls: [Decl], ps: PScope) : [UAliasTy] = unit_alias_tys_loop(decls, ps, [])

fn unit_alias_tys_loop(decls: [Decl], ps: PScope, acc: [UAliasTy]) : [UAliasTy] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DType(_, s, _, TBAlias(te), _, _, _, _) ->
      unit_alias_tys_loop(rest, ps, [UAT(s, te), ...acc])
    _ -> unit_alias_tys_loop(rest, ps, acc)
  }
}

# The unit scope in force, and where a type head is settled from: the
# program's scopes and the home of the declaration being walked.
type UnitCx = { units: UnitScope, ps: PScope, home: Option[String], aliases: [UAliasTy], heads: Bool }


fn validate_unit_refs_decls_loop(decls: [Decl], scope: UnitCx,
                                    df: DiagFiles, errs: [Diagnostic]) : [Diagnostic] {
  match decls {
    [] -> errs
    [d, ...rest] -> {
      let here = UnitCx { ...scope, home: decl_slot(d, ps_root(scope.ps)) }
      let e1 = errs ++ validate_unit_refs_decl(d, here, decl_diag_file(d, df))
      validate_unit_refs_decls_loop(rest, scope, df, e1)
    }
  }
}

# The home a declaration is filed under: `None` for the root file's.
fn decl_slot(d: Decl, root: String) : Option[String] = {
  let h = decl_home_hint_reset(d, root, root)
  if h == root { None } else { Some(h) }
}

# The `DImpl` arm re-enters the walk for the methods, which already
# resolved their file from the enclosing decl.
fn validate_unit_refs_sub_decls(decls: [Decl], scope: UnitCx,
                                  file: String, errs: [Diagnostic]) : [Diagnostic] {
  match decls {
    [] -> errs
    [d, ...rest] ->
      validate_unit_refs_sub_decls(rest, scope, file,
                                     errs ++ validate_unit_refs_decl(d, scope, file))
  }
}

fn validate_unit_refs_decl(d: Decl, scope: UnitCx, file: String) : [Diagnostic] = match d {
  DFn(_, _, _, ps, ret, _, body, _, _, _) -> {
    let e0 = validate_unit_refs_params(ps, scope, file, [])
    let e1 = match ret {
      Some(te) -> e0 ++ validate_unit_refs_te(te, scope, file)
      None -> e0
    }
    e1 ++ validate_unit_refs_expr(body, scope, file)
  }
  DType(_, _, _, body, _, _, _, _) -> validate_unit_refs_typebody(body, scope, file)
  # a unit alias body is shape-checked at its declaration —
  # expansion happens after this pass, so a Module-kind product could
  # otherwise ride in through the alias name.
  DUnit(_, _, UBAlias(body), _, line, col, _) ->
    validate_unit_expr(body, scope.units, file, line, col) ++
    validate_module_unit_shape(body, scope.units, file, line, col) ++
    validate_semilattice_unit_shape(body, scope.units, file, line, col)
  DTest(_, body, _, _, _) -> validate_unit_refs_expr(body, scope, file)
  DBench(_, body, _, _, _) -> validate_unit_refs_expr(body, scope, file)
  DCheck(_, ps, body, _, _, _) ->
    validate_unit_refs_params(ps, scope, file, []) ++
    validate_unit_refs_expr(body, scope, file)
  DEffect(_, _, _, ops, _, _, _, _) -> validate_unit_refs_eops(ops, scope, file, [])
  DImpl(_, _, _, sub_decls, _, _, _, _) ->
    validate_unit_refs_sub_decls(sub_decls, scope, file, [])
  DDerive(_, inner, _, _) -> validate_unit_refs_decl(inner, scope, file)
  DUnstable(inner, _, _) -> validate_unit_refs_decl(inner, scope, file)
  DProtoLaws(_, inner, _, _, _) -> validate_unit_refs_decl(inner, scope, file)
  DImplAxiom(_, inner, _, _, _) -> validate_unit_refs_decl(inner, scope, file)
  DConstructor(inner, _, _) -> validate_unit_refs_decl(inner, scope, file)
  _ -> []
}


fn validate_unit_refs_params(ps: [Param], scope: UnitCx, file: String,
                                acc: [Diagnostic]) : [Diagnostic] = match ps {
  [] -> acc
  [p, ...rest] -> {
    let e1 = match p.ptype {
      Some(te) -> acc ++ validate_unit_refs_te(te, scope, file)
      None -> acc
    }
    validate_unit_refs_params(rest, scope, file, e1)
  }
}

fn validate_unit_refs_eops(ops: [EffectOp], scope: UnitCx, file: String,
                              acc: [Diagnostic]) : [Diagnostic] = match ops {
  [] -> acc
  [op, ...rest] -> match op {
    EffOp(_, _, ps, ret, _, _) -> {
      let e1 = acc ++ validate_unit_refs_params(ps, scope, file, []) ++
                validate_unit_refs_te(ret, scope, file)
      validate_unit_refs_eops(rest, scope, file, e1)
    }
  }
}

fn validate_unit_refs_typebody(b: TypeBody, scope: UnitCx, file: String) : [Diagnostic] = match b {
  TBAlias(te) -> validate_unit_refs_te(te, scope, file)
  TBRecord(fs) -> validate_unit_refs_fdecls(fs, scope, file, [])
  TBSum(vs) -> validate_unit_refs_variants(vs, scope, file, [])
  TBEffectAlias(_) -> []
}

fn validate_unit_refs_fdecls(fs: [FieldDecl], scope: UnitCx, file: String,
                                acc: [Diagnostic]) : [Diagnostic] = match fs {
  [] -> acc
  [f, ...rest] -> match f {
    FD(_, _, te, _) -> {
      let e1 = acc ++ validate_unit_refs_te(te, scope, file)
      validate_unit_refs_fdecls(rest, scope, file, e1)
    }
  }
}

fn validate_unit_refs_variants(vs: [Variant], scope: UnitCx, file: String,
                                  acc: [Diagnostic]) : [Diagnostic] = match vs {
  [] -> acc
  [v, ...rest] -> match v {
    Var(_, payload_tes) -> {
      let e1 = acc ++ validate_unit_refs_te_list(payload_tes, scope, file, [])
      validate_unit_refs_variants(rest, scope, file, e1)
    }
  }
}

fn validate_unit_refs_te(te: TypeExpr, scope: UnitCx, file: String) : [Diagnostic] = match te.tkind {
  TyName(_, targs) -> validate_unit_refs_te_list(targs, scope, file, [])
  TyParam(_, targs) -> validate_unit_refs_te_list(targs, scope, file, [])
  TyList(inner) -> validate_unit_refs_te(inner, scope, file)
  TyFn(ps, ret, _) -> validate_unit_refs_te_list(ps, scope, file, []) ++
                       validate_unit_refs_te(ret, scope, file)
  TyDim(base, u) -> validate_unit_refs_te(base, scope, file) ++
                     validate_unit_expr(u, scope.units, file, te.line, te.col) ++
                     validate_module_unit_shape(u, scope.units, file, te.line, te.col) ++
                     validate_semilattice_unit_shape(u, scope.units, file, te.line, te.col) ++
                     validate_habitant_slots(scope.ps, scope.home, base, u, scope.units, file, te.line, te.col) ++
                     (if scope.heads { validate_numeric_head(scope.ps, scope.home, scope.aliases, base, file, te.line, te.col) } else { [] })
  TyRefine(base, _) -> validate_unit_refs_te(base, scope, file)
  # a compound row as a type argument — validate units
  # inside any parameterised labels it carries (`Reader[Int<m>]`).
  TyRow(row) -> validate_unit_refs_row(row, scope, file)
  TySurface(ts) -> validate_unit_refs_te_list(tysurface_children(ts), scope, file, [])
}

# The head type name of a `TyDim`'s base (`Vec[Real]` -> `Vec`), or
# empty when the base is not a named type.
fn validate_unit_refs_row(row: RowExpr, scope: UnitCx, file: String) : [Diagnostic] =
  match row {
    REmpty -> []
    RClosed(labels) -> validate_unit_refs_rls(labels, scope, file, [])
    ROpen(_, labels) -> validate_unit_refs_rls(labels, scope, file, [])
  }

fn validate_unit_refs_rls(ls: [RowLabel], scope: UnitCx, file: String,
                             acc: [Diagnostic]) : [Diagnostic] = match ls {
  [] -> acc
  [RL(_, ts), ...rest] -> {
    let e1 = acc ++ validate_unit_refs_te_list(ts, scope, file, [])
    validate_unit_refs_rls(rest, scope, file, e1)
  }
}

fn validate_unit_refs_te_list(ts: [TypeExpr], scope: UnitCx, file: String,
                                 acc: [Diagnostic]) : [Diagnostic] = match ts {
  [] -> acc
  [t, ...rest] -> {
    let e1 = acc ++ validate_unit_refs_te(t, scope, file)
    validate_unit_refs_te_list(rest, scope, file, e1)
  }
}

fn validate_unit_refs_expr(e: Expr, scope: UnitCx, file: String) : [Diagnostic] =
  validate_unit_refs_kind(e.kind, scope, file, e.line, e.col)

fn validate_unit_refs_kind(k: ExprKind, scope: UnitCx, file: String,
                              line: Int, col: Int) : [Diagnostic] = match k {
  EInt(_, _)        -> []
  EReal(_, _)       -> []
  EIntLit(_)        -> []
  EDecimalLit(_)    -> []
  EFixed(_, _)      -> []
  EBool(_)       -> []
  EChar(_)       -> []
  EStr(_, _)     -> []
  EUnit          -> []
  EName(_)        -> []
  EMark(_)        -> []
  ESym(_, _)      -> []
  ELocal(_)       -> []
  EOp(_)          -> []
  EUnder         -> []
  EPlaceholder   -> []
  EHole(_)       -> []
  ETodo(_)       -> []
  EExternBody(_, _) -> []
  EVariantsOf(_, _) -> []
  EModCall(_, _) -> []
  EIntrinsic(_, args_) -> validate_unit_refs_expr_list(args_, scope, file, [])
  ESurface(sf) -> validate_unit_refs_expr_list(surface_children(sf), scope, file, [])
  ECall(callee, args_) -> validate_unit_refs_expr(callee, scope, file) ++
                           validate_unit_refs_expr_list(args_, scope, file, [])
  EField(base, _) -> validate_unit_refs_expr(base, scope, file)
  EIndex(a, b) -> validate_unit_refs_expr(a, scope, file) ++
                  validate_unit_refs_expr(b, scope, file)
  EBinop(_, a, b) -> validate_unit_refs_expr(a, scope, file) ++
                     validate_unit_refs_expr(b, scope, file)
  EUnop(_, x) -> validate_unit_refs_expr(x, scope, file)
  EIf(c, t_, eo) -> validate_unit_refs_expr(c, scope, file) ++
                     validate_unit_refs_expr(t_, scope, file) ++
                     validate_unit_refs_opt_expr(eo, scope, file)
  EMatch(scr, arms) -> validate_unit_refs_expr(scr, scope, file) ++
                        validate_unit_refs_arms(arms, scope, file, [])
  ELambda(_, b) -> validate_unit_refs_expr(b, scope, file)
  ERecordLit(_, fs) -> validate_unit_refs_fields(fs, scope, file, [])
  EList(els) -> validate_unit_refs_elems(els, scope, file, [])
  ERange(a, b, opt_step) -> validate_unit_refs_expr(a, scope, file) ++
                             validate_unit_refs_expr(b, scope, file) ++
                             validate_unit_refs_opt_expr(opt_step, scope, file)
  EBlock(stmts, tail) -> validate_unit_refs_stmts(stmts, scope, file, []) ++
                          validate_unit_refs_opt_expr(tail, scope, file)
  EPipe(a, b)        -> validate_unit_refs_expr(a, scope, file) ++
                         validate_unit_refs_expr(b, scope, file)
  EDispatchPipe(_, a, b) -> validate_unit_refs_expr(a, scope, file) ++
                         validate_unit_refs_expr(b, scope, file)
  EHandle(body, _, _, init_opt, _, clauses, ret_opt) ->
    validate_unit_refs_expr(body, scope, file) ++
    validate_unit_refs_opt_expr(init_opt, scope, file) ++
    validate_unit_refs_clauses(clauses, scope, file, []) ++
    validate_unit_refs_opt_return(ret_opt, scope, file)
  ELitUnit(inner, u) -> validate_unit_refs_expr(inner, scope, file) ++
                         validate_unit_expr(u, scope.units, file, line, col) ++
                         validate_module_unit_shape(u, scope.units, file, line, col) ++
                         validate_semilattice_unit_shape(u, scope.units, file, line, col)
  EBang(inner) -> validate_unit_refs_expr(inner, scope, file)
}

fn validate_unit_refs_expr_list(es: [Expr], scope: UnitCx, file: String,
                                   acc: [Diagnostic]) : [Diagnostic] = match es {
  [] -> acc
  [e, ...rest] -> {
    let e1 = acc ++ validate_unit_refs_expr(e, scope, file)
    validate_unit_refs_expr_list(rest, scope, file, e1)
  }
}

fn validate_unit_refs_opt_expr(opt: Option[Expr], scope: UnitCx,
                                  file: String) : [Diagnostic] = match opt {
  None -> []
  Some(e) -> validate_unit_refs_expr(e, scope, file)
}

fn validate_unit_refs_arms(arms: [Arm], scope: UnitCx, file: String,
                              acc: [Diagnostic]) : [Diagnostic] = match arms {
  [] -> acc
  [a, ...rest] -> match a {
    Arm(_, g, b) -> {
      let e1 = acc ++ validate_unit_refs_opt_expr(g, scope, file) ++
                validate_unit_refs_expr(b, scope, file)
      validate_unit_refs_arms(rest, scope, file, e1)
    }
  }
}

fn validate_unit_refs_fields(fs: [FieldInit], scope: UnitCx, file: String,
                                acc: [Diagnostic]) : [Diagnostic] = match fs {
  [] -> acc
  [f, ...rest] -> match f {
    FI(_, v) -> {
      let e1 = acc ++ validate_unit_refs_expr(v, scope, file)
      validate_unit_refs_fields(rest, scope, file, e1)
    }
  }
}

fn validate_unit_refs_elems(els: [ListElem], scope: UnitCx, file: String,
                               acc: [Diagnostic]) : [Diagnostic] = match els {
  [] -> acc
  [el, ...rest] -> {
    let e1 = match el {
      ElPlain(x)  -> acc ++ validate_unit_refs_expr(x, scope, file)
      ElSpread(x) -> acc ++ validate_unit_refs_expr(x, scope, file)
    }
    validate_unit_refs_elems(rest, scope, file, e1)
  }
}

fn validate_unit_refs_stmts(stmts: [Stmt], scope: UnitCx, file: String,
                               acc: [Diagnostic]) : [Diagnostic] = match stmts {
  [] -> acc
  [s, ...rest] -> {
    let e1 = match s {
      SLet(_, ann, rhs)           -> acc ++ validate_unit_refs_opt_te(ann, scope, file) ++
                                           validate_unit_refs_expr(rhs, scope, file)
      SAssert(c, m) -> match m {
        Some(me) -> acc ++ validate_unit_refs_expr(c, scope, file) ++
                          validate_unit_refs_expr(me, scope, file)
        None     -> acc ++ validate_unit_refs_expr(c, scope, file)
      }
      SExprStmt(x)                -> acc ++ validate_unit_refs_expr(x, scope, file)
      SIndexAssign(b, i, v, _, _) -> acc ++ validate_unit_refs_expr(b, scope, file) ++
                                            validate_unit_refs_expr(i, scope, file) ++
                                            validate_unit_refs_expr(v, scope, file)
      SAssign(b, v, _, _)         -> acc ++ validate_unit_refs_expr(b, scope, file) ++
                                            validate_unit_refs_expr(v, scope, file)
      SVar(_, ann, rhs, _, _)     -> acc ++ validate_unit_refs_opt_te(ann, scope, file) ++
                                           validate_unit_refs_expr(rhs, scope, file)
      SUse(_, _, _)               -> acc
    }
    validate_unit_refs_stmts(rest, scope, file, e1)
  }
}

fn validate_unit_refs_clauses(cs: [HClause], scope: UnitCx, file: String,
                                 acc: [Diagnostic]) : [Diagnostic] = match cs {
  [] -> acc
  [c, ...rest] -> match c {
    HC(_, _, b, _, _) -> {
      let e1 = acc ++ validate_unit_refs_expr(b, scope, file)
      validate_unit_refs_clauses(rest, scope, file, e1)
    }
  }
}

fn validate_unit_refs_opt_te(opt: Option[TypeExpr], scope: UnitCx,
                             file: String) : [Diagnostic] = match opt {
  None -> []
  Some(te) -> validate_unit_refs_te(te, scope, file)
}

fn validate_unit_refs_opt_return(opt: Option[HReturn], scope: UnitCx,
                                    file: String) : [Diagnostic] = match opt {
  None -> []
  Some(r) -> match r { HR(_, b, _, _) -> validate_unit_refs_expr(b, scope, file) }
}
