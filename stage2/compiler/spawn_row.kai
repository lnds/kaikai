# Spawn-boundary check.
#
# A child fiber starts empty: an empty evidence stack, and a heap of
# its own. Both halves of that are rejected here.
#
# The row half: a handler installed around a spawn sits on a frame the
# child cannot reach. Only two kinds of effect resolve inside a child:
# one whose `default { }` bridges to a runtime supplier (installed per
# fiber), and a fiber-local one (bound to the child's own disposition).
# Any other effect would dispatch against a slot nobody filled.
#
# The value half (`spawn_capture`): a captured value is copied into the
# child, so a mutation the child performs never reaches the parent.
#
# Both read the typed AST: inference annotates a lambda with
# `TyFnT(_, _, row)` and types its body, and the nursery cap rewrite has
# already turned `n.spawn(f)` into `Spawn.spawn(f)`, so every spawn
# surface reaches this one check.

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.diag
import compiler.diag_file
import compiler.spawn_capture
import compiler.spawn_cross
import compiler.decl_bodies
import compiler.util
import compiler.spawn_param
import compiler.infer_env_exhaust
import compiler.infer_index
import compiler.expr_positions
import compiler.core_types
import compiler.core_refs
import compiler.infer_handle_walk
import compiler.infer_unify_rows

#[doc("Reject a spawned thunk the child fiber cannot honour: an effect it cannot resolve, or a captured value it would mutate as a copy. Each diagnostic names the file declaring the decl it fires on; `tab` names what it reports; `carriers` are the types whose capture is a mutation the child cannot share; `edges` are the instantiations the typer recorded.")]
pub fn check_spawn_rows(
  df: DiagFiles,
  tab: SymTab,
  carriers: [SymId],
  edges: [ResolvedCS],
  typed: [Decl],
  all_decls: [Decl]
) : [Diagnostic] / Console + File {
  let sites = spawn_sites(edges)
  if list_is_empty(sites) {
    []
  } else {
    let reqs = spawn_reqs_of(edges, sites)
    list_append(
      foldl(
        edges,
        [],
        (acc, c) => list_append(acc, check_read(df, tab, reqs, typed, all_decls, c))
      ),
      check_spawn_owners(df, tab, carriers, typed, all_decls, spawn_owners(sites))
    )
  }
}

# What a read of a function instantiates a spawn-reaching row variable with
# is held to the same rule as a thunk handed to `spawn`, whether the function
# is called there or passed on as a value.
fn check_read(
  df: DiagFiles,
  tab: SymTab,
  reqs: SpawnReqs,
  typed: [Decl],
  decls: [Decl],
  c: ResolvedCS
) : [Diagnostic] / Console + File = match c {
  RCS(s, line, col, _, _, _, _, owner) -> match req_vars(reqs, s) {
    [] -> []
    vars -> match find_fn_decl(typed, owner) {
      None -> []
      Some(d) -> {
        let site = SpawnSite { file: decl_diag_file(d, df), tab: tab, owner: d }
        foldl(
          read_rows(c, vars),
          [],
          (acc, r) => list_append(
            acc,
            check_crossing_labels(site, decls, line, col, r.labels, false)
          )
        )
      }
    }
  }
}

fn find_fn_decl(ds: [Decl], f: SymId) : Option[Decl] = match ds {
  [] -> None
  [d, ...rest] -> match d {
    DFn(_, fid, _, _, _, _, _, _, _, _, _, _) ->
      if sym_raw(fnid_sym(fid)) == sym_raw(f) { Some(d) } else { find_fn_decl(rest, f) }
    DUnstable(inner, _, _) -> find_fn_decl([inner, ...rest], f)
    DProtoLaws(_, inner, _, _, _) -> find_fn_decl([inner, ...rest], f)
    DImplAxiom(_, inner, _, _, _) -> find_fn_decl([inner, ...rest], f)
    DConstructor(inner, _, _) -> find_fn_decl([inner, ...rest], f)
    _ -> find_fn_decl(rest, f)
  }
}

# A thunk handed straight to a fiber is judged from its own typed row; a
# `fn` is walked only when a read in it hands one to a fiber.
fn check_spawn_owners(
  df: DiagFiles,
  tab: SymTab,
  carriers: [SymId],
  typed: [Decl],
  decls: [Decl],
  owners: [SymId]
) : [Diagnostic] / Console + File =
  check_owner_decls(
    df,
    tab,
    carriers,
    decls,
    typed,
    foldl(owners, idx_empty(), (ix, o) => idx_prepend_sym(ix, o, o)),
    []
  )

fn check_owner_decls(
  df: DiagFiles,
  tab: SymTab,
  carriers: [SymId],
  all_decls: [Decl],
  ds: [Decl],
  owners: NameIndex[SymId],
  acc: [Diagnostic]
) : [Diagnostic] / Console + File = match ds {
  [] -> acc
  [d0, ...rest] -> {
    let acc1 = match decl_body(d0) {
      Some(body) -> if decl_owns_spawn(d0, owners) {
        list_append(acc, check_body_spawns(df, tab, carriers, all_decls, d0, body))
      } else {
        acc
      }
      None -> acc
    }
    check_owner_decls(df, tab, carriers, all_decls, rest, owners, acc1)
  }
}

# Every body other than a `fn` has no scheme to carry a spawn-reaching row, so it is always walked.
fn decl_owns_spawn(d: Decl, owners: NameIndex[SymId]) : Bool = match decl_unwrap(d) {
  DFn(_, fid, _, _, _, _, _, _, _, _, _, _) ->
    not list_is_empty(idx_chain_sym(owners, fnid_sym(fid)))
  _ -> true
}

fn check_body_spawns(
  df: DiagFiles,
  tab: SymTab,
  carriers: [SymId],
  all_decls: [Decl],
  d: Decl,
  body: Expr
) : [Diagnostic] / Console + File {
  let site = SpawnSite { file: decl_diag_file(d, df), tab: tab, owner: decl_unwrap(d) }
  foldl(
    spawn_calls(body, []),
    [],
    (a, e) => match e.kind {
      ECall(_, args_) -> list_append(a, check_spawned_thunk(site, carriers, all_decls, e, args_))
      _ -> a
    }
  )
}

fn spawn_calls(e: Expr, acc: [Expr]) : [Expr] {
  let here = match e.kind {
    ECall(callee, _) -> if callee_is_spawn(callee) { [e, ...acc] } else { acc }
    _ -> acc
  }
  foldl(
    xp_positions(e),
    here,
    (x, p) => match p {
      XP(_, c) -> spawn_calls(c, x)
    }
  )
}

# The two halves of the boundary: the row the child cannot resolve, and
# the values it would mutate as a copy.
fn check_spawned_thunk(
  site: SpawnSite,
  carriers: [SymId],
  decls: [Decl],
  call: Expr,
  args_: [Expr]
) : [Diagnostic] / Console + File {
  let row_errs = check_spawned_thunk_row(site, decls, call, args_)
  match spawn_thunk_arg(args_) {
    None -> row_errs
    Some(thk) -> list_append(row_errs, check_thunk_captures(site, carriers, thk))
  }
}

# The thunk is the last argument on every spawn surface.
pub(pkg) fn spawn_thunk_arg(args_: [Expr]) : Option[Expr] {
  match args_ {
    [] -> None
    [a] -> Some(a)
    [_, ...rest] -> spawn_thunk_arg(rest)
  }
}

fn check_spawned_thunk_row(
  site: SpawnSite,
  decls: [Decl],
  call: Expr,
  args_: [Expr]
) : [Diagnostic] / Console + File {
  match spawn_thunk_arg(args_) {
    None -> []
    Some(thk) -> match thk.ty {
      Some(TyFnT(_, _, row)) -> check_crossing_labels(
        site,
        decls,
        thk.line,
        thk.col,
        filter(row.labels, l => not label_is_handled_mailbox(call, l)),
        true
      )
      _ -> []
    }
  }
}

# A spawned actor's handler covers the one `Actor` instance its `Pid` is typed at.
fn label_is_handled_mailbox(call: Expr, l: Label) : Bool = match (call.ty, l.ty_args) {
  (Some(TyCon(_, covered)), [m]) ->
    effect_is(l.sym, CeActor)
      and callee_spawns_actor(call)
      and any(
        covered,
        c => ty_same_arg(c, m)
      )
  _ -> false
}

fn callee_spawns_actor(call: Expr) : Bool = match call.kind {
  ECall(callee, _) -> match callee.kind {
    ESym(s, _) -> match known_fn_of(s) {
      Some(KfSpawnActor) -> true
      Some(KfSpawnActorPolicy) -> true
      _ -> false
    }
    _ -> false
  }
  _ -> false
}

# The one rule at every boundary: what a function value may perform must be
# something a child fiber resolves on its own.
# A write through an argument is the capture check's to report, once the call
# is specialised to the type it writes through.
fn check_crossing_labels(
  site: SpawnSite,
  decls: [Decl],
  line: Int,
  col: Int,
  labels: [Label],
  mutable_too: Bool
) : [Diagnostic] / Console + File =
  report_spawn_row_labels(
    site,
    decls,
    if mutable_too { labels } else { filter(labels, l => not effect_is(l.sym, CeMutable)) },
    line,
    col,
    []
  )

# An effect crosses a spawn when the runtime installs it for the child:
# an all-`$extern_handler` default supplies it per fiber, and a
# fiber-local effect resolves against the child's own disposition. An
# effect this program never declares is not ours to judge, and neither is
# a `with .. as` cell: its label names one handler, which the thunk
# captured, not an effect the child has to find. A capability parameter the
# thunk captured is no such cell: its handler dies with the scope that provided it.
fn effect_crosses_spawn(l: Label, decls: [Decl]) : Bool {
  if local_eq(l.cell, capture_cell()) {
    false
  } else if local_raw(l.cell) != 0 {
    true
  } else {
    match find_effect_decl(l.sym, decls) {
      None -> true
      Some(blk) ->
        if effect_is(l.sym, CeActor) {
          false
        } else if spawn_effect_is_fiber_local(l.sym) {
          true
        } else {
          default_block_is_extern(blk)
        }
    }
  }
}

fn find_effect_decl(s: SymId, decls: [Decl]) : Option[Option[DefaultBlock]] {
  match decls {
    [] -> None
    [d, ...rest] -> match d {
      DEffect(_, esym, _, _, defblk, _, _, _, _, _) ->
        if sym_raw(esym) >= 0 and sym_raw(esym) == sym_raw(s) {
          Some(defblk)
        } else {
          find_effect_decl(s, rest)
        }
      _ -> find_effect_decl(s, rest)
    }
  }
}

# A `default { }` whose clauses all bridge to `$extern_handler` is
# supplied by the runtime per fiber; a hand-written clause is not.
fn default_block_is_extern(defblk: Option[DefaultBlock]) : Bool {
  match defblk {
    None -> false
    Some(blk) -> match blk {
      DBlk(clauses, _, _, _) -> clauses_all_extern(clauses)
    }
  }
}

fn clauses_all_extern(cs: [HClause]) : Bool {
  match cs {
    [] -> false
    [c, ...rest] -> match c {
      HC(_, _, body, _, _) ->
        if clause_is_extern(body) { rest_all_extern(rest) } else { false }
    }
  }
}

fn rest_all_extern(cs: [HClause]) : Bool {
  match cs {
    [] -> true
    [c, ...rest] -> match c {
      HC(_, _, body, _, _) ->
        if clause_is_extern(body) { rest_all_extern(rest) } else { false }
    }
  }
}

fn clause_is_extern(body: Expr) : Bool {
  match body.kind {
    EIntrinsic(InExternHandler, _) -> true
    _ -> false
  }
}

fn spawn_effect_is_fiber_local(s: SymId) : Bool =
  effect_is_any(s, [CeCancel, CeLink, CeMonitor, CeSpawn, CeFfi])

fn report_spawn_row_labels(
  site: SpawnSite,
  decls: [Decl],
  labels: [Label],
  line: Int,
  col: Int,
  acc: [Diagnostic]
) : [Diagnostic] / Console + File {
  match labels {
    [] -> acc
    [l, ...rest] ->
      if effect_is(l.sym, CeMutable) {
        let d = report_spawn_mutable(site.file, line, col)
        report_spawn_row_labels(site, decls, rest, line, col, list_append(acc, [d]))
      } else if effect_crosses_spawn(l, decls) {
        report_spawn_row_labels(site, decls, rest, line, col, acc)
      } else if effect_is(l.sym, CeActor) {
        let d = report_spawn_actor(site, l, line, col)
        report_spawn_row_labels(site, decls, rest, line, col, list_append(acc, [d]))
      } else {
        let kaikai = match find_effect_decl(l.sym, decls) {
          Some(Some(DBlk(cs, ret, _, _))) ->
            any(cs, c => not clause_is_extern_clause(c)) or is_some(ret)
          _ -> false
        }
        let d = report_spawn_escape(
          site.file,
          written_text(decl_name(site.tab, l.sym)),
          kaikai,
          line,
          col
        )
        report_spawn_row_labels(site, decls, rest, line, col, list_append(acc, [d]))
      }
  }
}

# A write the thunk performs on state it did not create lands on the
# child's copy, so the row alone shows the capture whatever path the
# thunk took to the spawn.
fn report_spawn_mutable(file: String, line: Int, col: Int) : Diagnostic / Console + File {
  let note = ri_note(
    file,
    line,
    col,
    "the spawned fiber gets a copy of what it captures, so a write is lost to the parent"
  )
  let help = ri_help(
    file,
    line,
    col,
    "let one fiber own the state and send it the updates as messages (`kai info actors`)"
  )
  let d = mk_diag(
    SevError,
    file,
    line,
    col,
    "a spawned fiber cannot mutate state it did not create: `Mutable` in its effect row",
    [note, help]
  )
  d
}

fn clause_is_extern_clause(c: HClause) : Bool = match c {
  HC(_, _, body, _, _) -> clause_is_extern(body)
}

fn report_spawn_escape(
  file: String,
  eff_name: String,
  has_kaikai_default: Bool,
  line: Int,
  col: Int
) : Diagnostic / Console + File {
  let note = ri_note(file, line, col, "a fiber does not inherit the parent's handlers")
  let help = ri_help(
    file,
    line,
    col,
    if has_kaikai_default {
      "write `handle { ... } with #{eff_name} {}` inside the spawned body to inherit the default"
    } else {
      "handle the effect inside the spawned body: `handle { ... } with #{eff_name} { ... }`"
    }
  )
  let d = mk_diag(SevError, file, line, col, "effect not handled in spawned fiber: #{eff_name}", [
    note, help
  ])
  d
}

fn report_spawn_actor(
  site: SpawnSite,
  l: Label,
  line: Int,
  col: Int
) : Diagnostic / Console + File {
  let shown = match l.ty_args {
    [m] -> "#{decl_name(site.tab, l.sym)}[#{inf_ty_to_string(site.tab, m)}]"
    _ -> "#{decl_name(site.tab, l.sym)}"
  }
  let note = ri_note(
    site.file,
    line,
    col,
    "an `Actor` instance never crosses a spawn: the child has no mailbox for it"
  )
  let help = ri_help(
    site.file,
    line,
    col,
    "if the instance is only used to send, remove it from the row (`send` goes through the child's own mailbox); otherwise give the child its own mailbox (`with_mailbox` / `spawn_actor`)"
  )
  mk_diag(SevError, site.file, line, col, "effect not handled in spawned fiber: `#{shown}`", [
    note, help
  ])
}

fn ty_same_arg(a: Ty, b: Ty) : Bool = match (a, b) {
  (TyVarT(x), TyVarT(y)) -> x == y
  (TyVarT(_), TyAny) -> true
  (TyAny, TyAny) -> true
  _ -> ty_eq_shape(a, b)
}
