#[doc("""
Top-level declaration dispatch: attributes, `import`, `use`, `test`, `bench`, `check` and the program entry point.
""")]

import compiler.util
import compiler.diag
import compiler.lex_tokens
import compiler.ast
import compiler.decl_names
import compiler.doc_attr
import compiler.nest_limit
import compiler.parse_state
import compiler.parse_type_decls
import compiler.parse_fns
import compiler.parse_extern
import compiler.parse_kinds
import compiler.parse_protocols
import compiler.parse_effects
import compiler.parse_types
import compiler.parse_stmt
import compiler.parse_expr

fn parse_decl(p: Parser) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  let t = p_peek(p0)
  if parse_at_legacy_extern_c_attribute(p0) {
    err_d(p_error_here(p0, "`[<extern_c>] axiom` is removed (issue #260) — use `extern \"C\" fn name(...) : T / Ffi` instead"))
  } else if tk_is(t.kind, TkExtern) {
    parse_extern_decl(p_advance(p0), t)
  } else {
    parse_decl_after_extern(p0, tk_is(t.kind, TkPub))
  }
}

fn parse_decl_after_extern(p0: Parser, is_pub: Bool) : PDecl / Console {
  let p1 = if is_pub { p_advance(p0) } else { p0 }
  let hd = p_peek(p1)
  match (if is_pub { pub_rejection(hd) } else { None }) {
    Some(msg) -> err_d(p_error(p1, hd, msg))
    None -> parse_decl_head(p1, is_pub, hd)
  }
}

fn pub_rejection(hd: Token) : Option[String] {
  if tk_is(hd.kind, TkImpl) { Some("`pub` is not allowed on an impl") }
  else if tk_is(hd.kind, TkHashOpen) { Some("`pub` must come AFTER the `#[...]` attribute, not before — write `#[unstable] pub fn ...`") }
  else if tk_is(hd.kind, TkTest) { Some("`pub` is not allowed on a test") }
  else if tk_is(hd.kind, TkBench) { Some("`pub` is not allowed on a bench") }
  else if tk_is(hd.kind, TkCheck) { Some("`pub` is not allowed on a check") }
  else if tk_is(hd.kind, TkImport) { Some("`pub` is not allowed on an import") }
  else if tk_is(hd.kind, TkUse) { Some("`pub` is not allowed on a `use` declaration") }
  else if tk_is(hd.kind, TkTheory) { Some("`pub` is not allowed on a `theory` declaration") }
  else { None }
}

fn parse_decl_head(p1: Parser, is_pub: Bool, hd: Token) : PDecl / Console {
  let p2 = p_advance(p1)
  if tk_is(hd.kind, TkFn) { parse_fn_decl(p2, is_pub, hd) }
  else if tk_is(hd.kind, TkType) { parse_type_decl(p2, is_pub, hd) }
  else if tk_is(hd.kind, TkEffect) { parse_effect_decl(p2, is_pub, hd) }
  else if tk_is(hd.kind, TkProtocol) { parse_protocol_decl(p2, is_pub, hd) }
  else if tk_is(hd.kind, TkAxiom) { parse_axiom_decl(p2, is_pub, None, "", hd) }
  else if tk_is(hd.kind, TkConst) { parse_const_decl(p2, is_pub, hd) }
  else { parse_decl_head_private(p1, is_pub, hd) }
}

fn parse_decl_head_private(p1: Parser, is_pub: Bool, hd: Token) : PDecl / Console {
  let p2 = p_advance(p1)
  if tk_is(hd.kind, TkImpl) { parse_impl_decl(p2, hd) }
  else if tk_is(hd.kind, TkHashOpen) { parse_attribute_decl(p2, hd) }
  else if tk_is(hd.kind, TkTest) { parse_test_decl(p2, hd) }
  else if tk_is(hd.kind, TkBench) { parse_bench_decl(p2, hd) }
  else if tk_is(hd.kind, TkCheck) { parse_check_decl(p2, hd) }
  else if tk_is(hd.kind, TkImport) { parse_import_decl(p2, hd) }
  else if tk_is(hd.kind, TkUse) { parse_use_decl(p2, hd) }
  else if tk_is(hd.kind, TkTheory) { parse_theory_decl(p2, hd) }
  else if decl_head_is_kind(p1, hd) { parse_kind_decl(p2, is_pub, hd) }
  else if decl_head_is_user_introducer(p1, hd) { parse_unit_decl(p2, is_pub, hd) }
  else { err_d(p_error(p1, hd, decl_head_expected_msg(p1, hd))) }
}

fn decl_head_expected_msg(p: Parser, hd: Token) : String {
  let base = "expected `fn`, `type`, `effect`, `protocol`, `impl`, `test`, `unit`, `use`, `axiom`, `const`, or `import`"
  if tk_is(hd.kind, TkIdent) {
    match closest_name(tok_source(p.src, hd), ["fn", "type", "effect", "protocol", "impl", "test", "unit", "use", "axiom", "const", "import", "pub", "kind", "theory"]) {
      Some(sug) -> concat_all([base, " (did you mean `", sug, "`?)"])
      None -> base
    }
  } else { base }
}

# `#[ident (args)?]` attribute, dispatched after the lexer emits
# `TkHashOpen` and the caller has advanced past it. Reads the
# identifier inside the brackets, expects the matching `]`, and routes
# to the appropriate inner-decl parser. Known attributes: `derive`
# (with parenthesised protocol list), `unstable` (flag form), `doc`
# (string argument), and `constructor` (flag form on a `pub fn`).
# Unknown attributes parse cleanly
# (forward-compat for `#[deprecated]`, custom user attributes) and are
# dropped from the AST.
fn parse_attribute_decl(p: Parser, hash_tok: Token) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  let id = p_peek(p0)
  if not tk_is(id.kind, TkIdent) {
    err_d(p_error(p0, id, "expected attribute name after `#[`"))
  } else {
    parse_attribute_named(p_advance(p0), tok_source(p0.src, id), hash_tok)
  }
}

fn parse_attribute_named(p1: Parser, name: String, hash_tok: Token) : PDecl / Console {
  if name == "derive" { parse_attr_derive_body(p1, hash_tok) }
  else if name == "unstable" { parse_attr_unstable_body(p1, hash_tok) }
  else if name == "doc" { parse_attr_doc_body(p1, hash_tok) }
  else if name == "constructor" { parse_attr_constructor_body(p1, hash_tok) }
  else { parse_attr_unknown_body(p1, name, hash_tok) }
}

# `#[derive(P1, P2, ...)] type T = ...`. The ident and TkHashOpen have
# already been consumed; `p` points at the `(`.
fn parse_attr_derive_body(p: Parser, hash_tok: Token) : PDecl / Console {
  if not p_at(p, TkLparen) {
    err_d(p_error_here(p, "expected `(` after `#[derive`"))
  } else {
    let names_r = parse_derive_names(p_skip_newlines(p_advance(p)), [])
    match names_r.r {
      None -> err_d(names_r.p)
      Some(names) -> {
        let p_close = p_skip_newlines(names_r.p)
        if not p_at(p_close, TkRbracket) {
          err_d(p_error_here(p_close, "expected `]` to close `#[derive(...)]`"))
        } else {
          parse_derive_target(p_skip_newlines(p_advance(p_close)), names, hash_tok)
        }
      }
    }
  }
}

fn parse_derive_target(p2: Parser, names: [String], hash_tok: Token) : PDecl / Console {
  let inner_pub = tk_is(p_peek(p2).kind, TkPub)
  let p3 = if inner_pub { p_advance(p2) } else { p2 }
  let hd = p_peek(p3)
  if not tk_is(hd.kind, TkType) {
    err_d(p_error(p3, hd, "`#[derive(...)]` must precede a `type` declaration"))
  } else {
    let inner = parse_type_decl(p_advance(p3), inner_pub, hd)
    match inner.r {
      None -> err_d(inner.p)
      Some(d) -> ok_d_wrap(inner, DDerive(names, d, hash_tok.line, hash_tok.col))
    }
  }
}

# `#[unstable] pub fn / pub type / pub const / pub effect / pub protocol`.
# The ident and TkHashOpen have already been consumed; `p` points at the
# closing `]`.
fn parse_attr_unstable_body(p: Parser, hash_tok: Token) : PDecl / Console {

  if not p_at(p, TkRbracket) {
    err_d(p_error_here(p, "expected `]` to close `#[unstable]` (the unstable attribute takes no arguments)"))
  } else {
    let p_after = p_advance(p)
    parse_unstable_decl(p_after, hash_tok)
  }
}

# `#[constructor] pub fn name(args) : T`. The ident and TkHashOpen
# have already been consumed; `p` points at the closing `]`. The flag
# takes no arguments and precedes a `pub fn` whose return type is the
# marked type. Recurses through `parse_decl` so a `#[doc(...)]` may sit
# between the attribute and the `pub fn`; the wrapped decl must resolve
# to a fn (rejected otherwise).
fn parse_attr_constructor_body(p: Parser, hash_tok: Token) : PDecl / Console {

  if not p_at(p, TkRbracket) {
    err_d(p_error_here(p, "expected `]` to close `#[constructor]` (the constructor attribute takes no arguments)"))
  } else {
    let p0 = p_skip_newlines(p_advance(p))
    let inner = parse_decl(p0)
    match inner.r {
      None    -> err_d(inner.p)
      Some(d) ->
        if constructor_wraps_fn(d) {
          ok_d_wrap(inner, constructor_wrap(d, hash_tok.line, hash_tok.col))
        } else {
          err_d(p_error_here(p0, "`#[constructor]` must precede a `pub fn` returning the constructed type"))
        }
    }
  }
}

# `#[doc("...")]` / `#[doc("""...""")]`. The ident and TkHashOpen
# have already been consumed; `p` points at the `(`. Only the
# string-argument forms are accepted — bare-flag (`hidden`) and
# key-value (`alias = "..."`, `since = "..."`) forms are not
# supported. The doc body is captured verbatim from the literal (no escape
# decoding — it is CommonMark, not a kaikai string), with surrounding
# whitespace stripped; the full `#[doc(...)]` byte span rides along
# so `kai fmt` can re-emit it byte-identical.
fn parse_attr_doc_body(p: Parser, hash_tok: Token) : PDecl / Console {
  if not p_at(p, TkLparen) {
    err_d(p_error_here(p, "expected `(` after `#[doc` — the doc attribute takes one string argument"))
  } else {
    let p1 = p_skip_newlines(p_advance(p))
    let st = p_peek(p1)
    if not tk_is(st.kind, TkString) {
      err_d(p_error(p1, st, "expected a string literal in `#[doc(...)]` — bare-flag and key-value forms (`hidden`, `alias = ...`, `since = ...`) are not supported yet"))
    } else {
      parse_attr_doc_close(p_skip_newlines(p_advance(p1)), p, st, hash_tok)
    }
  }
}

fn parse_attr_doc_close(p2: Parser, p: Parser, st: Token, hash_tok: Token) : PDecl / Console {
  if not p_at(p2, TkRparen) {
    err_d(p_error_here(p2, "expected `)` to close `#[doc(...)]` — the doc attribute takes exactly one string argument"))
  } else {
    let p3 = p_advance(p2)
    if not p_at(p3, TkRbracket) {
      err_d(p_error_here(p3, "expected `]` to close `#[doc(...)]`"))
    } else {
      let close = p_peek(p3)
      let raw = string_slice(p.src, hash_tok.start, (close.start + close.length) - hash_tok.start)
      let text = doc_text_normalize(doc_unquote(tok_source(p.src, st)))
      finish_doc_attr(p_advance(p3), raw, text, hash_tok)
    }
  }
}

# Module-vs-item resolution for a just-parsed `#[doc(...)]`. The
# doc documents the declaration that starts on the
# next line (or the same line) — at most one intervening newline and a
# declaration-head token. Anything else (blank line, `import`, EOF,
# a non-decl token) makes it the module doc. A second module-position
# doc is rejected later by `doc_strip_collect`, which also strips the
# wrappers built here into the doc side table.
fn finish_doc_attr(p: Parser, raw: String, text: String, t: Token) : PDecl / Console {

  let nl = p_count_newlines(p, 0)
  let ph = p_skip_newlines(p)
  if nl <= 1 and doc_head_starts_decl(p_peek(ph).kind) {
    let inner = parse_decl(ph)
    match inner.r {
      None -> err_d(inner.p)
      Some(d) -> match d {
        DDoc(_, _, _, il, ic) -> {
          err_d(p_fail_at(inner.p, il, ic,
            "duplicate `#[doc(...)]` on the same declaration — an item takes at most one doc attribute"))
        }
        _ -> ok_d_wrap(inner, DDoc(raw, text, d, t.line, t.col))
      }
    }
  } else {
    ok_d(p, DModuleDoc(raw, text, t.line, t.col))
  }
}

fn doc_head_starts_decl(k: TokKind) : Bool {
  match k {
    TkPub -> true
    TkFn -> true
    TkType -> true
    TkConst -> true
    TkEffect -> true
    TkProtocol -> true
    TkAxiom -> true
    TkImpl -> true
    TkExtern -> true
    TkHashOpen -> true
    _ -> false
  }
}

# Forward-compat: unknown attributes (`#[deprecated]`,
# `#[cfg(...)]`, custom user attributes). Consume the optional argument
# list and the closing `]`, then wrap the following decl in `DAttr`
# carrying the attribute's raw byte span so the formatter re-emits it
# verbatim. Only `derive`, `unstable`, and `doc` have downstream
# semantics; the doc strip dissolves this wrapper right after parse.
fn parse_attr_unknown_body(p: Parser, name: String, hash_tok: Token) : PDecl / Console {

  let p_args = if p_at(p, TkLparen) {
    skip_balanced_parens(p_advance(p), 1)
  } else { p }
  if not p_at(p_args, TkRbracket) {
    err_d(p_error_here(p_args, string_concat_all(["expected `]` to close `#[", name, "(...)]`"])))
  } else {
    let close = p_peek(p_args)
    let raw = string_slice(p.src, hash_tok.start,
                           (close.start + close.length) - hash_tok.start)
    let p2 = p_skip_newlines(p_advance(p_args))
    let inner = parse_decl(p2)
    match inner.r {
      None    -> err_d(inner.p)
      Some(d) -> ok_d_wrap(inner, DAttr(raw, d, hash_tok.line, hash_tok.col))
    }
  }
}

# `#unstable` immediately followed by `pub fn`, `pub type`, or
# `pub const`. Newlines between the annotation and the `pub` keyword
# are allowed so authors can place `#unstable` on its own line above
# the declaration. Wraps the parsed Decl in `DUnstable` so downstream
# walkers see the
# inner shape unchanged but the export-collection pass can mark the
# pub name as unstable for import-site enforcement.
fn parse_unstable_decl(p: Parser, t: Token) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  let pub_tok = p_peek(p0)
  if not tk_is(pub_tok.kind, TkPub) {
    err_d(p_error(p0, pub_tok, "`#[unstable]` must precede a `pub fn`, `pub type`, or `pub const` declaration"))
  } else {
    let p1 = p_skip_newlines(p_advance(p0))
    let inner = parse_unstable_inner(p1, p_peek(p1))
    match inner.r {
      None -> err_d(inner.p)
      Some(d) -> ok_d_wrap(inner, DUnstable(d, t.line, t.col))
    }
  }
}

fn parse_unstable_inner(p1: Parser, hd: Token) : PDecl / Console {
  let p2 = p_advance(p1)
  if tk_is(hd.kind, TkFn) { parse_fn_decl(p2, true, hd) }
  else if tk_is(hd.kind, TkType) { parse_type_decl(p2, true, hd) }
  else if tk_is(hd.kind, TkConst) { parse_const_decl(p2, true, hd) }
  else if tk_is(hd.kind, TkEffect) { parse_effect_decl(p2, true, hd) }
  else if tk_is(hd.kind, TkProtocol) { parse_protocol_decl(p2, true, hd) }
  else { err_d(p_error(p1, hd, "`#[unstable] pub` must be followed by `fn`, `type`, `const`, `effect`, or `protocol`")) }
}

fn parse_program_loop(p: Parser, acc: [Decl], bacc: [FnBoundsRec], nacc: [NEnt]) : PParser / Console {

  let p0 = p_skip_newlines(p)
  if p_at(p0, TkEof) {
    # A parser that accumulated errors (e.g. via
    # check_pred_not_false in parse_contracts_loop) must not let
    # the driver claim success. Surface the error as `decls: None`
    # so the entry point exits non-zero, even when every decl
    # parsed in shape.
    if p_failed(p0) { PParser { p: p0, decls: None, fn_bounds: [], names: [] } }
    else { PParser { p: p0, decls: Some(list_reverse(acc)), fn_bounds: list_reverse(bacc),
                     names: list_reverse(nacc) } }
  }
  else {
    let r = parse_decl(p0)
    match r.r {
      None -> PParser { p: r.p, decls: None, fn_bounds: [], names: [] }
      Some(d) -> parse_program_loop(r.p, [d, ...acc], fn_bounds_seed(d, r.bounds, r.names, bacc),
                                    names_onto(r.names, nacc))
    }
  }
}

#[doc("Parses the file `file`. `home` is the module the file's declarations belong to: every declaration and constructor id is derived with it.")]
pub fn parse_program(file: String, src: String, toks: [Token], home: String) : PParser / Console {

  let r = parse_program_loop(parser_new(file, src, toks, home, parse_expr), [], [], [])
  match r.decls {
    None -> r
    Some(ds) -> match nest_first_over(ds) {
      None -> r
      Some(e) -> PParser { p: p_fail_at(r.p, e.line, e.col, nest_msg()), decls: None, fn_bounds: [], names: [] }
    }
  }
}

#[doc("""
Parse `use Effect` as a Decl. The token at `t` is the `use`
keyword; `p` is positioned right after it. Effect names are
uppercase idents (matches the convention enforced by
`parse_effect_decl`). Aliases (`use Console as C`) are not
supported.
""")]
pub fn parse_use_decl(p: Parser, t: Token) : PDecl / Console {

  let id = p_peek(p)
  # `use kind K` — open a kind's habitants (contextual `kind` before an
  # uppercase kind name), distinct from `use Effect`.
  if tk_is(id.kind, TkIdent) and tok_source(p.src, id) == "kind" and
     tk_is(p_peek1(p).kind, TkIdent) and is_upper_ident(p.src, p_peek1(p)) {
    let kt = p_peek1(p)
    ok_d(p_advance(p_advance(p)), DUseKind(tok_source(p.src, kt), t.line, t.col, None))
  } else if not tk_is(id.kind, TkIdent) {
    err_d(p_error(p, id, "expected effect name after `use`"))
  } else if not is_upper_ident(p.src, id) {
    err_d(p_error(p, id, "effect name in `use` must start with an uppercase letter"))
  } else {
    let name = tok_source(p.src, id)
    ok_d(p_advance(p), DUse(name, t.line, t.col))
  }
}

#[doc("Parses an `import` declaration after its keyword.")]
pub fn parse_import_decl(p: Parser, t: Token) : PDecl / Console {

  # For stage 1 MVP, imports are structurally parsed but not resolved.
  # Accept: `import a.b.c`, `import a.b.c as X`, `import a.b.c.{f, g}`.
  # `import ?name` — dependency hole. Symbol-index resolver
  # runs after normal imports and reports candidates.
  let first = p_peek(p)
  if match first.kind { TkHoleName(_) -> true _ -> false } {
    let nm = match first.kind { TkHoleName(n) -> n _ -> "" }
    ok_d(p_advance(p), DImport(IkHole(nm), t.line, t.col))
  } else if tk_is(first.kind, TkHole) {
    err_d(p_error(p, first, "`import ?` requires a name; write `import ?some_symbol`"))
  } else if not tk_is(first.kind, TkIdent) {
    err_d(p_error(p, first, "expected module name after `import`"))
  } else {
    parse_import_path(p_advance(p), tok_source(p.src, first), t)
  }
}

fn parse_import_path(p: Parser, acc_path: String, t: Token) : PDecl / Console {

  if p_at(p, TkDot) {
    let p1 = p_advance(p)
    let nxt = p_peek(p1)
    if tk_is(nxt.kind, TkIdent) {
      let seg = tok_source(p1.src, nxt)
      parse_import_path(p_advance(p1), string_concat(string_concat(acc_path, "."), seg), t)
    } else if tk_is(nxt.kind, TkLbrace) {
      # Selective: `.{a, b}`
      parse_import_selectives(p_skip_newlines(p_advance(p1)), [], acc_path, t)
    } else {
      err_d(p_error_here(p1, "expected identifier or `{` after `.`"))
    }
  } else if p_at(p, TkAs) {
    let p1 = p_advance(p)
    let nxt = p_peek(p1)
    if not tk_is(nxt.kind, TkIdent) {
      err_d(p_error(p1, nxt, "expected alias name after `as`"))
    } else {
      let alias = tok_source(p1.src, nxt)
      ok_d(p_advance(p1), DImport(IkAlias(acc_path, alias), t.line, t.col))
    }
  } else {
    ok_d(p, DImport(IkPath(acc_path), t.line, t.col))
  }
}

fn parse_import_selectives(p: Parser, acc: [String], path: String, t: Token) : PDecl / Console {

  let p0 = p_skip_newlines(p)
  let nxt = p_peek(p0)
  if not tk_is(nxt.kind, TkIdent) {
    err_d(p_error(p0, nxt, "expected identifier in selective import"))
  } else {
    let name = tok_source(p0.src, nxt)
    let p1 = p_skip_newlines(p_advance(p0))
    if p_at(p1, TkComma) {
      parse_import_selectives(p_skip_newlines(p_advance(p1)), [name, ...acc], path, t)
    } else if p_at(p1, TkRbrace) {
      ok_d(p_advance(p1), DImport(IkSelective(path, list_reverse([name, ...acc])), t.line, t.col))
    } else {
      err_d(p_error_here(p1, "expected `,` or `}` in selective import"))
    }
  }
}

#[doc("Prepends names to an accumulator list.")]
pub fn names_onto(ns: [NEnt], acc: [NEnt]) : [NEnt] = match ns {
  []           -> acc
  [n, ...rest] -> names_onto(rest, [n, ...acc])
}

#[doc("Parses a `test` declaration after its keyword.")]
pub fn parse_test_decl(p: Parser, t: Token) : PDecl / Console {

  let desc_t = p_peek(p)
  if not tk_is(desc_t.kind, TkString) {
    err_d(p_error(p, desc_t, "expected string description after `test`"))
  } else {
    let desc_span = tok_source(p.src, desc_t)
    let p1 = p_skip_newlines(p_advance(p))
    if not p_at(p1, TkLbrace) {
      err_d(p_error_here(p1, "expected `{` for test body"))
    } else {
      let tb = p_peek(p1)
      let rb = parse_block(p1, tb)
      match rb.r {
        None -> err_d(rb.p)
        Some(body) -> ok_d(rb.p, DTest(desc_span, body, t.line, t.col, None))
      }
    }
  }
}

#[doc("""
Structural mirror of parse_test_decl. The runner times the body
N=1000 times and reports mean ns/iter.
""")]
pub fn parse_bench_decl(p: Parser, t: Token) : PDecl / Console {

  let desc_t = p_peek(p)
  if not tk_is(desc_t.kind, TkString) {
    err_d(p_error(p, desc_t, "expected string description after `bench`"))
  } else {
    let desc_span = tok_source(p.src, desc_t)
    let p1 = p_skip_newlines(p_advance(p))
    if not p_at(p1, TkLbrace) {
      err_d(p_error_here(p1, "expected `{` for bench body"))
    } else {
      let tb = p_peek(p1)
      let rb = parse_block(p1, tb)
      match rb.r {
        None -> err_d(rb.p)
        Some(body) -> ok_d(rb.p, DBench(desc_span, body, t.line, t.col, None))
      }
    }
  }
}

# Property-based test block.
# Syntax:
#   check "<description>" [with name: T, name: T, ...] { body }
# The body is evaluated KAI_CHECK_ITERS times (default 100). Each
# iteration generates random values for the `with`-clause params via
# arbitrary[T]() runtime helpers and runs the body. The body must
# produce a Bool — true means the property holds for that input,
# false records a counterexample and exits the check early. Only the
# counterexample that triggered the failure is reported (no
# shrinking).
fn parse_check_with_params(p: Parser, acc: [Param]) : PParams / Console {

  let t = p_peek(p)
  if not tk_is(t.kind, TkIdent) {
    PParams { p: p_error(p, t, "expected parameter name in `with` clause"), r: None }
  } else {
    let name = tok_source(p.src, t)
    let p1 = p_advance(p)
    if not p_at(p1, TkColon) {
      PParams { p: p_error_here(p1, "expected `:` after `with` parameter name"), r: None }
    } else {
      let rt = parse_type(p_advance(p1))
      match rt.r {
        None -> PParams { p: rt.p, r: None }
        Some(ty) -> {
          let param = Param { binder: binder_written(name), ptype: Some(ty), pline: t.line, pcol: t.col, pborrow: false }
          let p2 = p_skip_newlines(rt.p)
          if p_at(p2, TkComma) {
            parse_check_with_params(p_skip_newlines(p_advance(p2)), [param, ...acc])
          } else {
            PParams { p: p2, r: Some(list_reverse([param, ...acc])) }
          }
        }
      }
    }
  }
}

#[doc("Parses a `check` declaration after its keyword.")]
pub fn parse_check_decl(p: Parser, t: Token) : PDecl / Console {
  let desc_t = p_peek(p)
  if not tk_is(desc_t.kind, TkString) {
    err_d(p_error(p, desc_t, "expected string description after `check`"))
  } else {
    let p1 = p_skip_newlines(p_advance(p))
    let pwith = if p_at(p1, TkWith) {
      parse_check_with_params(p_skip_newlines(p_advance(p1)), [])
    } else {
      PParams { p: p1, r: Some([]) }
    }
    match pwith.r {
      None -> err_d(pwith.p)
      Some(params) -> parse_check_body(p_skip_newlines(pwith.p), tok_source(p.src, desc_t), params, t)
    }
  }
}

fn parse_check_body(p2: Parser, desc_span: String, params: [Param], t: Token) : PDecl / Console {
  if not p_at(p2, TkLbrace) {
    err_d(p_error_here(p2, "expected `{` for check body"))
  } else {
    let rb = parse_block(p2, p_peek(p2))
    match rb.r {
      None -> err_d(rb.p)
      Some(body) -> ok_d(rb.p, DCheck(desc_span, params, body, t.line, t.col, None))
    }
  }
}
