# Function, thunk, lambda-helper and handler-clause body emission.

import compiler.ast
import compiler.core_builtins
import compiler.ctor_ix
import compiler.emit_c
import compiler.emit_c_callargs
import compiler.emit_c_ctx
import compiler.emit_c_handle_env
import compiler.emit_c_match_scan
import compiler.emit_c_rawtypes
import compiler.emit_c_shims
import compiler.emit_c_sigs
import compiler.emit_c_tcrec_emit
import compiler.emit_c_tcrec_scan
import compiler.emit_ffi_c
import compiler.emit_reuse_donate
import compiler.emit_shared
import compiler.emit_unwind_c
import compiler.enc_unit
import compiler.evidence_frame
import compiler.fn_index
import compiler.fnreg
import compiler.handle_caps
import compiler.infer_clause_holes
import compiler.local_names
import compiler.marks
import compiler.rec_stamp
import compiler.region
