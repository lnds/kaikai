#[doc("""
State taking: a stateful clause that resumes with a new state built from the old one hands the old one over instead of dup'ing it, so a write through it finds the value unshared.

The state leaves the handler's slot at its last read before the `resume` that installs the next one, and only when nothing evaluated from that read up to the install can leave the clause: the call that consumes it has an empty effect row and the operands after the read hold no call. An exit by a perform, an unwind or a cancel therefore finds the state where it was.
""")]

import compiler.ast
import compiler.ast_ids
import compiler.ast_map
import compiler.expr_positions
import compiler.handler_alias
import compiler.util

#[doc("The expression with every `resume(v, f(.., state, ..))` that can take the handler state at its last read, taking it from the slot.")]
pub(pkg) fn pst_take_state(e: Expr) : Expr =
  if xp_exists(e, false, pst_is_resume_call) { pst_walk(e) } else { e }

fn pst_walk(e: Expr) : Expr = {
  let e1 = Expr { ...e, kind: prc_map_expr_kind(e.kind, (c) => pst_take_state(c)) }
  match e1.kind {
    ECall(f, xs) -> if pst_is_continuation(f) { pst_resume(e1, f, xs) } else { e1 }
    _            -> e1
  }
}

fn pst_is_resume_call(e: Expr) : Bool = match e.kind {
  ECall(f, _) -> pst_is_continuation(f)
  _           -> false
}

fn pst_is_continuation(f: Expr) : Bool = match f.kind {
  ELocal(c) -> local_eq(c, local_minted(canonical_continuation()))
  _         -> false
}

fn pst_resume(e: Expr, f: Expr, xs: [Expr]) : Expr = match xs {
  [a, ns] -> Expr { ...e, kind: ECall(f, [a, pst_next_state(ns)]) }
  _       -> e
}

fn pst_next_state(ns: Expr) : Expr = match ns.kind {
  ECall(g, args) ->
    if pst_cannot_exit(g) { Expr { ...ns, kind: ECall(g, pst_take_last(args)) } } else { ns }
  _ -> ns
}

# A callee whose row holds no effect: closed and empty.
fn pst_cannot_exit(g: Expr) : Bool = match g.ty {
  Some(TyFnT(_, _, r)) -> list_is_empty(r.labels) and pst_closed(r.tail)
  _                    -> false
}

fn pst_closed(tail: Option[Int]) : Bool = match tail {
  None    -> true
  Some(_) -> false
}

# The last direct read of the state is taken when no operand after it holds a call.
fn pst_take_last(args: [Expr]) : [Expr] = {
  let k = pst_last_read(args, 0, 0 - 1)
  if k >= 0 and all(pst_after(args, k), pst_quiet) { pst_swap_at(args, k, 0) } else { args }
}

fn pst_last_read(args: [Expr], i: Int, best: Int) : Int = match args {
  []           -> best
  [a, ...rest] -> pst_last_read(rest, i + 1, if pst_is_state_read(a) { i } else { best })
}

fn pst_after(args: [Expr], k: Int) : [Expr] = match args {
  []           -> []
  [_, ...rest] -> if k <= 0 { rest } else { pst_after(rest, k - 1) }
}

fn pst_swap_at(args: [Expr], k: Int, i: Int) : [Expr] = match args {
  []           -> []
  [a, ...rest] -> [if i == k { pst_swap(a) } else { a }, ...pst_swap_at(rest, k, i + 1)]
}

fn pst_is_alias(l: LocalId) : Bool = any(user_state_aliases(), (k) => local_eq(l, local_minted(k)))

# The state alias, bare or behind a dup.
fn pst_is_state_read(a: Expr) : Bool = match a.kind {
  ELocal(l) -> pst_is_alias(l)
  ECall(f, xs) -> match f.kind {
    EMark(MkDup) -> match xs {
      [x] -> match x.kind { ELocal(l) -> pst_is_alias(l)  _ -> false }
      _   -> false
    }
    _ -> false
  }
  _ -> false
}

# An operand that evaluates no call.
fn pst_quiet(a: Expr) : Bool = match a.kind {
  ELocal(_)    -> true
  ESym(_, _)   -> true
  ECall(f, xs) -> match f.kind {
    EMark(MkDup) -> all(xs, pst_quiet)
    _            -> false
  }
  _ -> list_is_empty(xp_positions(a))
}

fn pst_swap(a: Expr) : Expr =
  Expr { ...a, kind: ECall(Expr { ...a, kind: EMark(MkTakeState), ty: None }, []) }
