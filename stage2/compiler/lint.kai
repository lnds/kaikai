#[doc("kai lint: Clippy-style opinion linter over the typed AST. Warnings only, never blocks a build.")]

import compiler.ast
import compiler.expr_positions
import compiler.util
import compiler.infer
import compiler.diag_file
import compiler.lint_idiom
import compiler.lint_redundant
import compiler.lint_combinator
import compiler.lint_spread
import compiler.lint_deadcode
import compiler.lint_effects
import compiler.call_site_check
import compiler.sym_read
import compiler.kind_theory
import compiler.modules
import compiler.scope_file
import compiler.symtab

# `LintFinding` is defined in `compiler.lint_idiom` and re-exported via
# import; both modules build the same finding shape.

# ---- discard_pure_value ----------------------------------------------

#[doc("Run every lint over the decls a unit owns; returns each finding paired with the file that declares it. `src` is the pre-lowering AST, which the dead-code lint reads to tell a user-declared fn from a synthesised one.")]
pub fn lint_program(df: DiagFiles, owned_mods: [String], decls: [Decl],
                    src: [Decl]) : [FileFinding] {
  let owned = lint_owned(decls, module_name_of_path(df_root(df)), owned_mods, [])
  list_append(lint_walk_decls(owned, df, []),
              lint_program_wide(owned, decls, df, src))
}

# A unit merges every imported module into one decl stream, so linting it
# whole would report on the stdlib too. `owned_mods` names the modules the
# package itself declares; a decl from anywhere else is not its code.
fn lint_owned(ds: [Decl], root_mod: String, owned_mods: [String],
              acc: [Decl]) : [Decl] = match ds {
  [] -> list_reverse(acc)
  [d, ...rest] ->
    if decl_is_owned(d, root_mod, owned_mods) {
      lint_owned(rest, root_mod, owned_mods, [d, ...acc])
    } else { lint_owned(rest, root_mod, owned_mods, acc) }
}

# A pub decl of the root file is stamped with the root module's own name,
# so the root module belongs to the owned set alongside the imports.
# Whether `d` was declared by the unit under lint: the root file
# (unstamped or stamped with `root_mod`) or one of `owned_mods`.
fn decl_is_owned(d: Decl, root_mod: String, owned_mods: [String]) : Bool =
  match decl_home_module(d) {
    None    -> true
    Some(m) -> m == root_mod or list_has(owned_mods, m)
  }

# Reachability is judged against the whole unit while the report covers
# only what the package owns: a private fn called from anywhere in the
# unit is alive, and a stdlib decl is never reported on.
fn lint_program_wide(owned: [Decl], all: [Decl], df: DiagFiles,
                     src: [Decl]) : [FileFinding] {
  let dead = deadcode_file_findings(owned, all, deadcode_declared_fns(src), df)
  list_append(dead, lint_effects_per_file(owned, df, []))
}

# The effect-row lint reads the root module name, which differs per file.
fn lint_effects_per_file(ds: [Decl], df: DiagFiles, acc: [FileFinding]) : [FileFinding] =
  match ds {
    [] -> list_reverse(acc)
    [d, ...rest] -> {
      let f = decl_diag_file(d, df)
      lint_effects_per_file(rest, df,
        prepend_tagged(effect_findings([d], module_name_of_path(f)), f, acc))
    }
  }

fn lint_walk_decls(decls: [Decl], df: DiagFiles, acc: [FileFinding]) : [FileFinding] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> lint_walk_decls(rest, df, lint_decl(d, df, acc))
  }
}

fn lint_decl(d: Decl, df: DiagFiles, acc: [FileFinding]) : [FileFinding] {
  match d {
    DFn(_, _, _, _, _, _, body, _, _, _, _) ->
      prepend_tagged(lint_expr(body, []), decl_diag_file(d, df), acc)
    _ -> acc
  }
}

# Pair each finding with the file that declares it.
fn prepend_tagged(xs: [LintFinding], file: String,
                      acc: [FileFinding]) : [FileFinding] =
  prepend_tagged_loop(list_reverse(xs), file, acc)

fn prepend_tagged_loop(xs: [LintFinding], file: String,
                       acc: [FileFinding]) : [FileFinding] = match xs {
  [] -> acc
  [x, ...rest] -> prepend_tagged_loop(rest, file, [FF(file, x), ...acc])
}

# Recursion into sub-expressions is what reaches blocks nested inside
# lambda bodies, match arms, and if branches. Idiom nudges are judged at
# this node before descending; the discard scan lives in the block arm.
fn lint_expr(e: Expr, acc: [LintFinding]) : [LintFinding] {
  let here = list_append(idiom_findings(e),
                         list_append(redundant_findings(e),
                                     list_append(combinator_findings(e), spread_findings(e))))
  let a1 = prepend_all(here, acc)
  match e.kind {
    EBlock(stmts, tail) -> lint_block(stmts, tail, a1)
    _ -> lint_children(e, a1)
  }
}

fn prepend_all(xs: [LintFinding], acc: [LintFinding]) : [LintFinding] {
  match xs {
    []           -> acc
    [x, ...rest] -> prepend_all(rest, [x, ...acc])
  }
}

# The tail (or its absence) is the block's own value, never a discard;
# every other statement sits in non-tail position.
fn lint_block(stmts: [Stmt], tail: Option[Expr], acc: [LintFinding]) : [LintFinding] {
  let a1 = lint_stmts(stmts, acc)
  match tail {
    Some(t) -> lint_expr(t, a1)
    None    -> a1
  }
}

fn lint_stmts(ss: [Stmt], acc: [LintFinding]) : [LintFinding] {
  match ss {
    [] -> acc
    [s, ...rest] -> lint_stmts(rest, lint_stmt(s, acc))
  }
}

# Recurse into every sub-expression (to reach nested blocks), then add
# the discard finding when this statement drops a pure non-Unit value.
fn lint_stmt(s: Stmt, acc: [LintFinding]) : [LintFinding] {
  let inner = lint_exprs(stmt_expr_list(s), acc)
  match s {
    SExprStmt(x) -> if discard_is_smell(x) { [discard_finding(x), ...inner] } else { inner }
    _            -> inner
  }
}

# Point at the start of the discarded expression. An ECall's own
# line/col mark its argument parens, so prefer the callee's position;
# every other node already carries its leftmost span.
fn discard_finding(x: Expr) : LintFinding {
  let pos = discard_pos(x)
  LF("discard_pure_value", pos.line, pos.col, discard_message(x))
}

fn discard_pos(x: Expr) : Expr {
  match x.kind {
    ECall(callee, _) -> callee
    _                -> x
  }
}

fn discard_message(x: Expr) : String =
  concat_all(["pure value of type ", lint_ty_name(x), " discarded; bind it or drop the statement"])

# A non-Unit pure value dropped in statement position is dead code; an
# effectful discard is legitimate because the effect row tracks it.
fn discard_is_smell(x: Expr) : Bool =
  not ty_is_unit(x.ty) and expr_is_pure(x)

# None ("unknown") is not Unit; expr_is_pure keeps such nodes silent.
fn ty_is_unit(t: Option[Ty]) : Bool {
  match t {
    Some(TyUnit) -> true
    _            -> false
  }
}

# ---- purity ----------------------------------------------------------
#
# "Provably pure": the bias is false-negatives over false-positives.
# The only effect introducers are an effect-op reference, a handler,
# and an application of a function whose type carries a non-empty row;
# every other node only propagates the purity of its children. Any case
# that cannot be proven pure (a `?` op with no inferred type, an open
# row tail, an untyped node) reads as impure and stays silent.

fn expr_is_pure(e: Expr) : Bool =
  not expr_has_effect(e)

fn expr_has_effect(e: Expr) : Bool =
  expr_introduces_effect(e) or children_have_effect(e)

# Judged at this node only; children are covered by expr_has_effect.
fn expr_introduces_effect(e: Expr) : Bool {
  match e.kind {
    EHandle(_, _, _, _, _, _, _, _) -> true
    EVar(name)                   -> is_effect_op(name)
    ESym(_, _, name)                -> is_effect_op(name)
    ECall(callee, _)             -> callee_is_effectful(callee)
    _                            -> false
  }
}

# A flattened `Eff.op` reference carries no inferred type, so it is
# recognised by name with the same uppercase-prefix rule --effects-json
# uses: a `.` whose prefix starts with an uppercase letter (effects are
# PascalCase, so this skips record/field paths like `list.length`).
fn is_effect_op(name: String) : Bool =
  qualified_upper_prefix(name, 0, string_length(name))

fn qualified_upper_prefix(name: String, i: Int, n: Int) : Bool {
  if i >= n { false }
  else {
    match char_at(name, i) {
      Some('.') -> first_is_upper(name)
      Some(_)   -> qualified_upper_prefix(name, i + 1, n)
      None      -> false
    }
  }
}

fn first_is_upper(name: String) : Bool {
  match char_at(name, 0) {
    Some(c) -> c >= 'A' and c <= 'Z'
    None    -> false
  }
}

# A call is effectful when its callee's function type carries a non-empty
# row. An unresolved callee type reads as effectful unless it is a bare
# binding (then the call's purity rides on its arguments alone).
fn callee_is_effectful(callee: Expr) : Bool {
  match callee.ty {
    Some(TyFnT(_, _, row)) -> not row_is_pure(row)
    Some(_)                -> false
    None                   -> not is_known_pure_var(callee)
  }
}

fn is_known_pure_var(callee: Expr) : Bool {
  match callee.kind {
    EVar(name) -> not is_effect_op(name)
    ESym(_, _, name) -> not is_effect_op(name)
    _          -> false
  }
}

# Pure iff the row carries no labels. The tail is internal bookkeeping:
# a pure fn typically keeps a free row variable with no demand on it
# (the phantom fn_scheme_of_decl inserts for an empty signature), and
# the compiler itself treats label-free rows as pure regardless of the
# tail (see inf_row_to_string_suffix). Matching that is what lets a
# call to a pure user fn read as pure.
fn row_is_pure(row: Row) : Bool =
  labels_empty(row.labels)

# ---- structural recursion over children ------------------------------
#
# Both the effect scan and the finding walk descend through
# xp_positions, the exhaustive enumeration of expression positions.

fn children_have_effect(e: Expr) : Bool =
  any_position_effect(xp_positions(e))

fn lint_children(e: Expr, acc: [LintFinding]) : [LintFinding] =
  lint_positions(xp_positions(e), acc)

fn opt_list(o: Option[Expr]) : [Expr] {
  match o {
    Some(x) -> [x]
    None    -> []
  }
}

fn stmt_expr_list(s: Stmt) : [Expr] {
  match s {
    SExprStmt(x)            -> [x]
    SLet(_, _, rhs)         -> [rhs]
    SAssert(c, mo)          -> [c, ...opt_list(mo)]
    SIndexAssign(b, i, v, _, _) -> [b, i, v]
    SAssign(b, v, _, _) -> [b, v]
    SVar(_, _, rhs, _, _)   -> [rhs]
    SUse(_, _, _)           -> []
  }
}

fn any_position_effect(xs: [XPos]) : Bool {
  match xs {
    []                  -> false
    [XP(_, x), ...rest] -> if expr_has_effect(x) { true } else { any_position_effect(rest) }
  }
}

fn lint_positions(xs: [XPos], acc: [LintFinding]) : [LintFinding] {
  match xs {
    []                  -> acc
    [XP(_, x), ...rest] -> lint_positions(rest, lint_expr(x, acc))
  }
}

fn lint_exprs(xs: [Expr], acc: [LintFinding]) : [LintFinding] {
  match xs {
    []          -> acc
    [x, ...rest] -> lint_exprs(rest, lint_expr(x, acc))
  }
}

# ---- type display ----------------------------------------------------

fn lint_ty_name(e: Expr) : String {
  match e.ty {
    Some(t) -> inf_ty_to_string(t)
    None    -> "?"
  }
}

# ---- reporting -------------------------------------------------------

# Lints type the program themselves, so they need the driver's
# head-owner cache to dispatch `|`, `||` and `|?` exactly as a build
# does — without it every pipe is rejected as an unknown head.
fn lint_infer(file: String, decls: [Decl],
               head_owners: [HeadOwnerEntry]) : TypedProgram / Console + File =
  infer_program_with_protos_cached(file, diag_files_flat(file), decls, false, [], head_owners,
                                   atomic_kind_theories(decls), st_empty(), fv_empty())

#[doc("Run lints over a typed program and print human-readable findings; returns 0 (lints never block a build) unless a call statically violates a contract. `src` is the AST before protocol lowering.")]
pub fn run_lint(file: String, df: DiagFiles, owned_mods: [String], decls: [Decl],
                 src: [Decl], head_owners: [HeadOwnerEntry]) : Int / Console + File {
  let r = lint_infer(file, decls, head_owners)
  let contract_errs = check_call_site_refinements(file, r.decls)
  if contract_errs != 0 { contract_errs }
  else { lint_report_text(lint_program(df, owned_mods, sym_locals_read_decls(r.decls), src)); 0 }
}

fn lint_report_text(findings: [FileFinding]) : Unit / Console {
  match findings {
    [] -> ()
    [ff, ...rest] -> match ff {
      FF(file, f) -> { print(lint_finding_text(file, f)) lint_report_text(rest) }
    }
  }
}

fn lint_finding_text(file: String, f: LintFinding) : String {
  match f {
    LF(rule, line, col, msg) ->
      concat_all([file, ":", int_to_string(line), ":", int_to_string(col),
                  ": warning: ", msg, " [", rule, "]"])
  }
}

#[doc("Run lints over a typed program and print findings as a JSON array; returns 0 (lints never block a build) unless a call statically violates a contract. `src` is the AST before protocol lowering.")]
pub fn run_lint_json(file: String, df: DiagFiles, owned_mods: [String],
                      decls: [Decl], src: [Decl],
                      head_owners: [HeadOwnerEntry]) : Int / Console + File {
  let r = lint_infer(file, decls, head_owners)
  let contract_errs = check_call_site_refinements(file, r.decls)
  if contract_errs != 0 { contract_errs }
  else { print(concat_all(["[", lint_json_body(lint_program(df, owned_mods, sym_locals_read_decls(r.decls), src)), "]"])); 0 }
}

fn lint_json_body(findings: [FileFinding]) : String =
  string_join(map(findings, (ff) => match ff { FF(file, f) -> lint_finding_json(file, f) }), ", ")

fn lint_finding_json(file: String, f: LintFinding) : String {
  match f {
    LF(rule, line, col, msg) ->
      concat_all([
        "{\"file\": ", json_quote(file),
        ", \"line\": ", int_to_string(line),
        ", \"col\": ", int_to_string(col),
        ", \"rule\": ", json_quote(rule),
        ", \"severity\": \"warning\"",
        ", \"message\": ", json_quote(msg),
        "}"
      ])
  }
}
