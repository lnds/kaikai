#[doc("""
The program's entry point: the root module's function named `main`.

It is one declaration, so its identity is the id the symbol table
derives for it. Which declaration that is gets decided here, once, from
the root module's name; every pass below the resolver holds that id and
compares ids, and no other module spells the name to decide whether a
function is the entry point.

A non-root module may declare its own `main`: it is an ordinary function
there, with another id. The typer and the lints still ask about it: a
file types and lints the same whether it is the root or loaded as a
module, so they apply the entry point's rules to the function each module
would start at were it the root (`is_file_entry`).

A pass that runs before the resolver stamps declarations has only what
the source wrote. `entry_spelled` reads that for the root file's own
untagged declarations.
""")]

import compiler.ast
import compiler.decl_names
import compiler.symtab_build

fn entry_name() : String = "main"

#[doc("The id of the entry point of the program whose root module is `target`.")]
pub fn entry_id(target: String) : SymId = sym_derive(NCFn, entry_name(), target)

#[doc("The entry point's id given the root module as a pass holds it; `sym_none()` when the pass was handed no root.")]
pub fn entry_of_root(root: Option[String]) : SymId = match root {
  Some(t) -> entry_id(t)
  None    -> sym_none()
}

#[doc("True when the function `f` is the entry point `entry` itself, not a specialisation of it.")]
pub fn is_entry(entry: SymId, f: FnId) : Bool = fnid_eq(f, fnid_decl(entry))

#[doc("True when `f` is the function the module `mo` would start at were its file the root; `None` is the root module, homed at `root`.")]
pub fn is_file_entry(root: String, mo: Option[String], f: FnId) : Bool = match mo {
  Some(m) -> is_entry(entry_id(m), f)
  None    -> is_entry(entry_id(root), f)
}

#[doc("True when a root-file declaration written as `name` is the entry point, for a pass that runs before declarations carry ids.")]
pub fn entry_spelled(name: String) : Bool = name == entry_name()
