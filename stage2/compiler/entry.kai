#[doc("""
The program's entry point and the root modules of a compile.

A root module is a file the user handed to the compiler: the target of
a build, and each file of a grouped test run. Its `main` is typed as an
entry point, which is what it is when that file is built as a program:
it may leave its row out, and the row it declares is one startup can
supply.

The entry point is what the binary starts. A program starts the
target's `main`. A build that runs test, bench or check blocks starts
its runner, which no source declares: there every `main`, the target's
too, is a function like any other below the typer, which a block may
call.

Either way the entry point is one id, decided here once from the target
and the kind of build; every pass holds that id and compares ids.

A module that is not a root may declare its own `main`: an ordinary
function under no entry rule. A diagnostic may still say so
(`is_imported_main`).

Each predicate compares ids, and no other module spells the name.
""")]

import compiler.ast
import compiler.decl_names
import compiler.symtab_build

fn main_name() : String = "main"

# No identifier holds an `@`, so no source declares it.
fn runner_name() : String = "@runner"

#[doc("The id of the `main` the module homed at `home` may declare.")]
pub fn main_id(home: String) : SymId = sym_derive(NCFn, main_name(), home)

#[doc("True when the function `f` is the declaration `main`, a module's `main`, itself and not a specialisation of it.")]
pub fn is_main(main: SymId, f: FnId) : Bool = fnid_eq(f, fnid_decl(main))

#[doc("The id of what the binary built from `target` starts: its runner when the build runs test, bench or check blocks, the target's `main` otherwise.")]
pub fn entry_id(target: String, runs_blocks: Bool) : SymId =
  if runs_blocks { sym_derive(NCFn, runner_name(), target) } else { main_id(target) }

#[doc("True when the function `f` is the entry point `entry`: no function is in a build that starts its runner.")]
pub fn is_entry(entry: SymId, f: FnId) : Bool = fnid_eq(f, fnid_decl(entry))

#[doc("The root modules of one compile: the id of each module, and the id of the `main` each may declare.")]
pub type Roots = Roots([SymId], [SymId])

#[doc("The root modules of a compile whose target is `target` and whose grouped test files are homed at `test_homes`.")]
pub fn roots_of(target: String, test_homes: [String]) : Roots = {
  let homes = [target, ...test_homes]
  Roots(map(homes, (h) => st_module_id(h)), map(homes, (h) => main_id(h)))
}

#[doc("True when the module whose id is `m` is a root module.")]
pub fn is_root_module(roots: Roots, m: SymId) : Bool = match roots {
  Roots(mods, _) -> roots_hold(mods, m)
}

#[doc("True when `f` is the `main` of a root module: the function the entry point's typing rules apply to.")]
pub fn is_root_main(roots: Roots, f: FnId) : Bool = match roots {
  Roots(_, mains) -> fnid_inst(f) == spec_none() and roots_hold(mains, fnid_sym(f))
}

fn roots_hold(ids: [SymId], s: SymId) : Bool = match ids {
  []           -> false
  [x, ...rest] -> if sym_raw(s) >= 0 and sym_same(x, s) { true } else { roots_hold(rest, s) }
}

#[doc("True when `f` is the `main` of the module `mo` and that module is not a root. `None` is the target, always a root. It words a diagnostic; no rule reads it.")]
pub fn is_imported_main(roots: Roots, mo: Option[String], f: FnId) : Bool = match mo {
  Some(m) -> is_main(main_id(m), f) and not is_root_module(roots, st_module_id(m))
  None    -> false
}

#[doc("The note a diagnostic about an imported module's `main` carries.")]
pub fn imported_main_note() : String =
  "`main` is an entry point only in the root module; this file is imported here"
