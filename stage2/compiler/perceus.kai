#[doc("""
The dup rewrite: every in-scope read of a local that does not hand its
binder's birth reference on is wrapped in `__perceus_dup`.
""")]

import compiler.ast
import compiler.expr_positions
import compiler.perceus_payer
import compiler.borrow_map
import compiler.perceus_reads
import compiler.perceus_seg_request
import compiler.handler_alias
import compiler.perceus_arm_tails
import compiler.perceus_exit_drops
import compiler.perceus_linear
import compiler.perceus_arm_drops

# ---------- Borrow inference (Koka kk_borrow_t, B1) ----------
#
# A parameter is BORROWED when the body only INSPECTS it: every read of
# the param is the scrutinee of a `match` whose arms never use any
# binder of the matched pattern (the children never escape). `is_red`
# is the canonical case:
#
#   fn is_red(t) = match t { RBNode(Red,_,_,_,_) -> true; _ -> false }
#
# `t` is read once, as a match scrutinee, and the arms bind nothing —
# so no component of `t` escapes the call. A borrowed param is the dual
# of the #599 skip-set: the callee does NOT consume it (no scrutinee
# decref, no exit drop), and the caller does NOT dup it. This removes
# the `kai_internal_dup` the caller would otherwise emit on a multi-use
# argument — the 37%-of-wall RC traffic the rb-tree spends on
# inspection calls (is_red, comparisons).
#
# Soundness (asu trap #1): the danger is escape of a CHILD of the
# param, not the param itself. The rule is conservative toward owned —
# it only fires when the arms bind NOTHING that is later read, so there
# is provably no escape. Anything more (a binder used anywhere in the
# arm body) marks the param owned and falls back to the dup discipline.

pub fn pcs_borrow_params(pnames: [Binder], body: Expr) : [Binder] = match pnames {
  []           -> []
  [h, ...rest] -> {
    let rest_b = pcs_borrow_params(rest, body)
    if pcs_name_only_inspected(h, body) { [h, ...rest_b] } else { rest_b }
  }
}

# True iff every read of `nm` in `e` is an inspect-only position: the
# bare scrutinee of a match whose arms escape nothing. A use anywhere
# else (arg to a call, ctor slot, field, return, etc.) is NOT
# inspect-only → the param is owned. Conservative: returns false the
# moment it sees `nm` outside an inspecting match.
fn pcs_name_only_inspected(nm: Binder, e: Expr) : Bool =
  pcs_inspected_kind(nm, e.kind)

fn pcs_inspected_kind(nm: Binder, k: ExprKind) : Bool = match k {
  EMatch(s, arms) -> {
    # `nm` as the bare scrutinee is an inspect, IF the arms escape
    # nothing. `nm` appearing inside a non-bare scrutinee expression,
    # or inside any arm body, must itself be inspect-only.
    let scr_inspect = match s.kind {
      ELocal(u) -> if local_eq(u, nm.id) { pcs_arms_escape_nothing(arms) } else { true }
      _         -> pcs_name_only_inspected(nm, s)
    }
    scr_inspect and pcs_inspected_arms(nm, arms)
  }
  ELocal(u)           -> not local_eq(u, nm.id)   # a bare read NOT as scrutinee = owned use
  EField(x, _)        -> pcs_name_absent(nm, x)   # field read of nm = owned
  EIndex(a, b)        -> pcs_name_absent(nm, a) and pcs_name_only_inspected(nm, b)
  # Blocks scan only SLet / SExprStmt statements; the remaining
  # statement forms are ignored by this analysis.
  EBlock(stmts, tail) -> pcs_inspected_block(nm, stmts, tail)
  ELambda(_, b)       -> pcs_name_absent(nm, b)   # capture = owned
  EList(els)          -> pcs_inspected_elems(nm, els)
  EStr(_, _)          -> false   # conservative
  EHandle(_, _, _, _, _, _, _) -> false   # conservative: handlers are owned
  _ -> pcs_inspected_ps(nm, xp_positions_kind(k))
}

fn pcs_inspected_ps(nm: Binder, ps: [XPos]) : Bool = match ps {
  []                  -> true
  [XP(_, c), ...rest] -> pcs_name_only_inspected(nm, c) and pcs_inspected_ps(nm, rest)
}

# An arm escapes nothing iff none of its pattern's binders are read in
# the arm body. Conservative: a guard counts as the body too.
fn pcs_arms_escape_nothing(arms: [Arm]) : Bool = match arms {
  []           -> true
  [a, ...rest] -> match a {
    Arm(pat, opt_g, abody) -> {
      let binders = prc_pat_bindings(pat, [])
      let body_clean = pcs_no_binder_used(binders, abody)
      let guard_clean = match opt_g {
        None    -> true
        Some(g) -> pcs_no_binder_used(binders, g)
      }
      if body_clean and guard_clean { pcs_arms_escape_nothing(rest) } else { false }
    }
  }
}

# None of `binders` is read anywhere in `e`.
fn pcs_no_binder_used(binders: [Binder], e: Expr) : Bool = match binders {
  []           -> true
  [b, ...rest] -> if pcs_name_absent(b, e) { pcs_no_binder_used(rest, e) } else { false }
}

# `nm` does not appear as a read anywhere in `e`. Pure structural walk
# (no effects) — must stay effect-free so the borrow analysis carries
# no Console row (threading that row through the inference would be both
# heavy and wrong: inference is a pure query). Reuses the existing
# pcs_max_paths_in_expr, which counts reads of `nm` purely.
fn pcs_name_absent(nm: Binder, e: Expr) : Bool =
  pcs_max_paths_in_expr(nm, e) == 0

fn pcs_inspected_opt(nm: Binder, oe: Option[Expr]) : Bool = match oe {
  None    -> true
  Some(e) -> pcs_name_only_inspected(nm, e)
}

fn pcs_inspected_arms(nm: Binder, arms: [Arm]) : Bool = match arms {
  []           -> true
  [a, ...rest] -> match a {
    Arm(_, opt_g, abody) -> {
      let g_ok = match opt_g { None -> true Some(g) -> pcs_name_only_inspected(nm, g) }
      if g_ok and pcs_name_only_inspected(nm, abody) { pcs_inspected_arms(nm, rest) } else { false }
    }
  }
}

fn pcs_inspected_block(nm: Binder, stmts: [Stmt], tail: Option[Expr]) : Bool = {
  let s_ok = pcs_inspected_stmts(nm, stmts)
  s_ok and pcs_inspected_opt(nm, tail)
}

fn pcs_inspected_stmts(nm: Binder, stmts: [Stmt]) : Bool = match stmts {
  []           -> true
  [s, ...rest] -> if pcs_inspected_stmt(nm, s) { pcs_inspected_stmts(nm, rest) } else { false }
}

fn pcs_inspected_stmt(nm: Binder, s: Stmt) : Bool = pcs_inspected_exprs(nm, stmt_exprs(s))

fn pcs_inspected_exprs(nm: Binder, es: [Expr]) : Bool = match es {
  []           -> true
  [e, ...rest] -> pcs_name_only_inspected(nm, e) and pcs_inspected_exprs(nm, rest)
}

fn pcs_inspected_elems(nm: Binder, els: [ListElem]) : Bool = match els {
  []           -> true
  [el, ...rest] -> {
    let ok = match el {
      ElPlain(e)  -> pcs_name_only_inspected(nm, e)
      ElSpread(e) -> pcs_name_absent(nm, e)   # a spread consumes its operand
    }
    if ok { pcs_inspected_elems(nm, rest) } else { false }
  }
}

# ---- pcs_rewrite: wrap non-last in-scope local reads in __perceus_dup ----
#
# A scope lists the nearest binder first and a handle's state aliases last.

#[doc("`e` with each read of a binder in `scope` that is not its last wrapped in `__perceus_dup`.")]
pub fn pcs_rewrite_expr(e: Expr, scope: [Binder], uses: UseIx, in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : Expr / Console =

  Expr { kind: pcs_rewrite_kind(e.kind, e.line, e.col, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn pcs_rewrite_kind(k: ExprKind, line: Int, col: Int, scope: [Binder],
                    uses: UseIx, in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : ExprKind / Console {

  match k {
    # The actual rewrite: wrap a non-last local read in `__perceus_dup`.
    ELocal(l) -> {
      if pcs_has(scope, l) and pcs_is_non_last(l, line, col, uses, in_lam, skip_set, force_set, bmap, move_last_set) {
        ECall(
          Expr { kind: EMark(MkDup), line: line, col: col,
                 ty: None, mode: MUnknown , site: 0 },
          [Expr { kind: ELocal(l), line: line, col: col,
                  ty: None, mode: MUnknown , site: 0 }]
        )
      } else { k }
    }
    # RC tracks local bindings, and `scope` holds exactly those. A
    # reference to a declaration or to an effect operation owns nothing
    # to dup.
    ESym(_, _) -> k
    EOp(_)     -> k
    EName(_)   -> k
    # A mark holds no reference, so RC has nothing to dup on it.
    EMark(m) -> EMark(m)
    EStr(_, _) -> k
    # Scope-aware kinds: ELambda extends scope with params and flips
    # in_lam; EBlock threads scope through SLet/SVar bindings; EMatch
    # delegates to pcs_rewrite_arms which adds pattern bindings to the
    # arm's scope; EHandle's HReturn binder shadows; clauses get the
    # state/log/op-param scope.
    ELambda(ps, body) -> {
      let pn = map(ps, (p) => p.binder)
      # Issue #817 — the lambda's own params still leak (dup'd-and-never-
      # dropped, the `(w) => not is_empty(w)` residual slice). The fix is
      # to give them the param-drop discipline (`pcs_wrap_param_drops`) a top-level
      # `fn` gets — but that produces the `EBlock([SLet(__pcs_ret, body),
      # drop], __pcs_ret)` wrap, which the native/KIR backend cannot lower
      # in a CLOSURE body (it lowers it fine for `fn` bodies): it adds
      # native-parity gaps (huffman/weather/go/python/scala) and fails
      # tier1-native. This is the exact "coupled reshape lands with its
      # consumer" piece the issue (and #816's retro) flagged — DEFERRED to
      # the native/KIR lane. The dominant slices (the #3 raw-scrutinee drop
      # and the #4 arm-binder move) are emit_c/perceus-pure and ship here;
      # the lambda-param residual lands with the native lowering for the
      # closure-body drop wrap.
      ELambda(ps, pcs_rewrite_expr(body, list_append(pn, scope), uses, true, skip_set, force_set, bmap, []))
    }
    EBlock(stmts, opt_tail) -> {
      let r = pcs_rewrite_block(stmts, scope, uses, in_lam, [], skip_set, force_set, bmap, move_last_set)
      let new_tail = match opt_tail {
        None -> None
        Some(e) -> Some(pcs_rewrite_expr(e, r.scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
      }
      let exit_drops = pcs_collect_block_let_exit_drops(stmts, uses, opt_tail, move_last_set, force_set, [])
      EBlock(pcs_append_drops(r.stmts, exit_drops), new_tail)
    }
    EMatch(s, arms) -> EMatch(pcs_rewrite_expr(s, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                              pcs_rewrite_arms(arms, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    EHandle(body, eff, eff_tas, init_opt, alias, clauses, ret_opt) -> {
      let body1 = pcs_rewrite_expr(body, scope, uses, in_lam, skip_set, force_set, bmap, [])
      let init1 = match init_opt {
        None -> None
        Some(e2) -> Some(pcs_rewrite_expr(e2, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
      }
      # The aliases are borrowed views of the handler's slot, and a clause
      # borrows its captures from the handle's env: every read of either dups.
      let aliases = pcs_handle_aliases(init_opt)
      let alias_force = list_append(aliases, force_set)
      let cls1 = pcs_rewrite_clauses(clauses, list_append(scope, aliases), uses, in_lam, skip_set,
                                     list_append(scope, alias_force), bmap)
      let ret1 = match ret_opt {
        None -> None
        Some(hr) -> match hr {
          HR(pname, body2, hl, hc) -> {
            let body3 = pcs_rewrite_expr(body2, [pname, ...list_append(scope, aliases)], uses, in_lam, skip_set, alias_force, bmap, [])
            Some(HR(pname, pcs_return_binder_paid(pname, body3, uses, alias_force, hl, hc), hl, hc))
          }
        }
      }
      EHandle(body1, eff, eff_tas, init1, alias, cls1, ret1)
    }
    # Remaining kinds inlined for issue #528 (stage 1 has no row
    # polymorphism on function-param types, so the HOF `map_expr_kind`
    # cannot accept an effectful callback). The structural recursion
    # is replicated here with direct calls to `pcs_rewrite_expr`.
    EInt(_, _)        -> k
    EReal(_, _)       -> k
    EIntLit(_)        -> k
    EDecimalLit(_)    -> k
    EFixed(_, _)      -> k
    EBool(_)       -> k
    EChar(_)       -> k
    EUnit          -> k
    EUnder         -> k
    EPlaceholder   -> k
    EHole(_)       -> k
    ETodo(_)       -> k
    EExternBody(_, _) -> k
    EVariantsOf(_, _) -> k
    EModCall(_, _) -> k
    EIntrinsic(name, args_) ->
      EIntrinsic(name, pcs_rewrite_expr_list(args_, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    ESurface(sf) ->
      ESurface(surface_rebuild(sf, pcs_rewrite_expr_list(surface_children(sf), scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)))
    ECall(callee, args_) ->
      ECall(pcs_rewrite_expr(callee, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
            pcs_rewrite_expr_list(args_, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    EField(base, nm)     -> EField(pcs_rewrite_expr(base, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set), nm)
    EIndex(a, b)         -> EIndex(pcs_rewrite_expr(a, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                                    pcs_rewrite_expr(b, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    EBinop(op, a, b)     -> EBinop(op, pcs_rewrite_expr(a, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                                        pcs_rewrite_expr(b, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    EUnop(op, x)         -> EUnop(op, pcs_rewrite_expr(x, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    EIf(c, t_, eo)       -> EIf(pcs_rewrite_expr(c, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                                  pcs_rewrite_expr(t_, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                                  pcs_rewrite_expr_opt(eo, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    ERecordLit(rh, fs) -> ERecordLit(rh, pcs_rewrite_fields_init(fs, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    EList(els)           -> EList(pcs_rewrite_list_elems(els, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    ERange(a, b, opt_step) -> ERange(pcs_rewrite_expr(a, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                                       pcs_rewrite_expr(b, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                                       pcs_rewrite_expr_opt(opt_step, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    EPipe(a, b)          -> EPipe(pcs_rewrite_expr(a, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                                    pcs_rewrite_expr(b, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    EMapPipe(a, b)       -> EMapPipe(pcs_rewrite_expr(a, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                                       pcs_rewrite_expr(b, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    EFlatMapPipe(a, b)   -> EFlatMapPipe(pcs_rewrite_expr(a, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                                            pcs_rewrite_expr(b, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    EFilterPipe(a, b)    -> EFilterPipe(pcs_rewrite_expr(a, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                                           pcs_rewrite_expr(b, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    ELitUnit(inner, u)   -> ELitUnit(pcs_rewrite_expr(inner, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set), u)
    EBang(inner)         -> EBang(pcs_rewrite_expr(inner, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
  }
}

fn pcs_rewrite_expr_opt(opt: Option[Expr], scope: [Binder], uses: UseIx, in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : Option[Expr] / Console = match opt {
  None    -> None
  Some(x) -> Some(pcs_rewrite_expr(x, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
}

fn pcs_rewrite_expr_list(es: [Expr], scope: [Binder], uses: UseIx, in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : [Expr] / Console = match es {
  []           -> []
  [h, ...rest] -> [pcs_rewrite_expr(h, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                   ...pcs_rewrite_expr_list(rest, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)]
}

fn pcs_rewrite_fields_init(fs: [FieldInit], scope: [Binder], uses: UseIx, in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : [FieldInit] / Console = match fs {
  []           -> []
  [h, ...rest] -> [pcs_rewrite_field_init(h, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                   ...pcs_rewrite_fields_init(rest, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)]
}

fn pcs_rewrite_field_init(fi: FieldInit, scope: [Binder], uses: UseIx, in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : FieldInit / Console = match fi {
  FI(name, e) -> FI(name, pcs_rewrite_expr(e, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
}

fn pcs_rewrite_list_elems(els: [ListElem], scope: [Binder], uses: UseIx, in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : [ListElem] / Console = match els {
  []           -> []
  [h, ...rest] -> [pcs_rewrite_list_elem(h, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set),
                   ...pcs_rewrite_list_elems(rest, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)]
}

fn pcs_rewrite_list_elem(el: ListElem, scope: [Binder], uses: UseIx, in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : ListElem / Console = match el {
  ElPlain(e)  -> ElPlain(pcs_rewrite_expr(e, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
  ElSpread(e) -> ElSpread(pcs_rewrite_expr(e, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
}

fn pcs_rewrite_arms(arms: [Arm], scope: [Binder], uses: UseIx, in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : [Arm] / Console = match arms {
  [] -> []
  [Arm(pat, opt_g, body), ...rest] -> {
    let scope1 = prc_pat_bindings(pat, scope)
    let g1 = match opt_g {
      None -> None
      Some(g) -> Some(pcs_rewrite_expr(g, scope1, uses, in_lam, skip_set, force_set, bmap, move_last_set))
    }
    let body1 = pcs_rewrite_expr(body, scope1, uses, in_lam, skip_set, force_set, bmap, move_last_set)
    [Arm(pat, g1, body1), ...pcs_rewrite_arms(rest, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)]
  }
}

type PcsRwBlock = { stmts: [Stmt], scope: [Binder] }

fn pcs_rewrite_block(stmts: [Stmt], scope: [Binder], uses: UseIx, in_lam: Bool,
                     acc: [Stmt], skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : PcsRwBlock / Console {

  match stmts {
    [] -> PcsRwBlock { stmts: list_reverse(acc), scope: scope }
    [s, ...rest] -> {
      let r = pcs_rewrite_stmt(s, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)
      pcs_rewrite_block(rest, r.scope, uses, in_lam, [r.stmt, ...acc], skip_set, force_set, bmap, move_last_set)
    }
  }
}

type PcsRwStmt = { stmt: Stmt, scope: [Binder] }

fn pcs_rewrite_stmt(s: Stmt, scope: [Binder], uses: UseIx, in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : PcsRwStmt / Console {

  match s {
    SLet(pat, ty_opt, rhs) -> {
      let rhs1 = pcs_rewrite_expr(rhs, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)
      # See `pcs_collect_uses_in_block` SLet — raw locals stay
      # outside the Perceus scope so EVar reads of them are not
      # rewritten into `__perceus_dup` calls (which expect boxed
      # arguments).
      PcsRwStmt { stmt: SLet(pcs_let_pat_elide(pat, uses), ty_opt, rhs1),
                  scope: prc_pat_bindings_skip_raw(pat, rhs, scope) }
    }
    SVar(name, ty_opt, rhs, ln, cl) -> {
      let rhs1 = pcs_rewrite_expr(rhs, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)
      PcsRwStmt { stmt: SVar(name, ty_opt, rhs1, ln, cl), scope: [name, ...scope] }
    }
    SAssert(c, opt_m) -> {
      let c1 = pcs_rewrite_expr(c, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)
      let m1 = match opt_m {
        None -> None
        Some(m) -> Some(pcs_rewrite_expr(m, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set))
      }
      PcsRwStmt { stmt: SAssert(c1, m1), scope: scope }
    }
    SExprStmt(e) -> {
      let e1 = pcs_rewrite_expr(e, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)
      PcsRwStmt { stmt: SExprStmt(e1), scope: scope }
    }
    SIndexAssign(b, i, v, ln, cl) -> {
      let b1 = pcs_rewrite_expr(b, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)
      let i1 = pcs_rewrite_expr(i, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)
      let v1 = pcs_rewrite_expr(v, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)
      PcsRwStmt { stmt: SIndexAssign(b1, i1, v1, ln, cl), scope: scope }
    }
    SAssign(b, v, ln, cl) -> {
      let b1 = pcs_rewrite_expr(b, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)
      let v1 = pcs_rewrite_expr(v, scope, uses, in_lam, skip_set, force_set, bmap, move_last_set)
      PcsRwStmt { stmt: SAssign(b1, v1, ln, cl), scope: scope }
    }
    # m7e §25: SUse has no expression and binds nothing.
    SUse(n, ln, cl) -> PcsRwStmt { stmt: SUse(n, ln, cl), scope: scope }
  }
}

# Each op argument reaches its clause owned, so the clause pays the ones
# its reads do not hand on, as a fn pays its params.
fn pcs_rewrite_clauses(cs: [HClause], scope: [Binder], uses: UseIx,
                        in_lam: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap) : [HClause] / Console {

  match cs {
    [] -> []
    [h, ...rest] -> match h {
      HC(op, params, body, ln, cl) -> {
        let scope1 = list_append(pcs_filter_non_resume(params), scope)
        # A forwarder's arguments move into its request; the names around it dup through `force_set`.
        let moved = pcs_list_union(skip_set, pcs_clause_requested(params, body))
        let body1 = pcs_rewrite_expr(body, scope1, uses, pcs_clause_in_lam(in_lam, params, body), moved, force_set, bmap, [])
        let paid = pcs_wrap_param_drops(body1, pcs_clause_owned_params(params, body), uses,
                                        PcsParamSets { moved: moved, forced: force_set })
        [HC(op, params, paid, ln, cl), ...pcs_rewrite_clauses(rest, scope, uses, in_lam, skip_set, force_set, bmap)]
      }
    }
  }
}

# A `$extern_handler` body hands its arguments to the runtime shim, which
# releases them.
fn pcs_clause_owned_params(params: [Param], body: Expr) : [Param] = match body.kind {
  EIntrinsic(InExternHandler, _) -> []
  _                              -> clause_op_args(params)
}

# Dup predicate: wrap this read in `__perceus_dup` unless it hands the
# birth ref on, per `pcs_fate`. A read inside a lambda is a capture and
# always dups. `force_set` names are owned elsewhere (a check loop's
# params, a handler's state aliases) and dup on every read. `skip_set`
# names move on every read; a `move_last_set` name moves only at its
# last read.
fn pcs_is_non_last(l: LocalId, line: Int, col: Int, uses: UseIx,
                   in_lam_here: Bool, skip_set: [Binder], force_set: [Binder], bmap: BorrowMap, move_last_set: [Binder]) : Bool {
  if pcs_has(force_set, l) { true }
  else if in_lam_here { true }
  else {
    let lu = last_use_for(l, uses)
    let moved = pcs_has(skip_set, l) or (pcs_has(move_last_set, l) and pcs_lu_at(lu, line, col))
    pcs_fate_residual(pcs_fate(lu, l, uses, moved, false))
  }
}

# Splice exit-drop SExprStmts into the block. Drops fire LIFO (last
# let entered → first dropped); the collector accumulates head-first
# then reverses, so we reverse again here. Drops sit *between* the
# trailing SLets and the tail, leaving the tail position untouched
# so `tcrec_rewrite_decls` can detect a self-tail-call.
fn pcs_append_drops(stmts: [Stmt], drops: [Stmt]) : [Stmt] {
  match drops {
    [] -> stmts
    [_, ...__] -> list_append(stmts, list_reverse(drops))
  }
}
