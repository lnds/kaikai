#[doc("""
The builtin continuation type: `Cont[T]` in an `extern "handler"`
signature, and `Cont[T, S, e]`, the continuation a segment handle's
clause keeps. Every place the compiler names or recognises it goes
through here.
""")]

import compiler.ast

#[doc("A segment continuation's parts: what it resumes with, the handle's type, and the body's row carrier.")]
pub type ContParts = { arg: Ty, answer: Ty, row: Ty }

#[doc("The name source code writes the continuation type with.")]
pub fn cont_name() : String = "Cont"

#[doc("Whether a type name in source names the continuation type.")]
pub fn is_cont_name(n: String) : Bool = n == cont_name()

#[doc("Whether `t` is a continuation type, of any arity.")]
pub fn is_cont_ty(t: Ty) : Bool = match t {
  TyCon(_, n, _, s) -> tycon_is(n, s, CtCont)
  _ -> false
}

#[doc("The parts of `t` when it is a segment continuation `Cont[T, S, e]`.")]
pub fn cont_parts(t: Ty) : Option[ContParts] = match t {
  TyCon(_, n, [a, s, e], cs) -> if tycon_is(n, cs, CtCont) { Some(ContParts { arg: a, answer: s, row: e }) } else { None }
  _ -> None
}

#[doc("The segment continuation type `Cont[arg, answer, row]`.")]
pub fn cont_ty(arg: Ty, answer: Ty, row: Ty) : Ty = TyCon(None, cont_name(), [arg, answer, row], core_ty_sym(CtCont))
