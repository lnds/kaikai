#[doc("""
Tail calls written in a shape the rest of the pipeline does not read as one.

A call on the right of `or` / `and`, on the right of `|>`, or bound by a
`let` the block's tail reads back is still the value of the function. This
pass writes those as the `if` and call they mean, so fusion and the
self-tail rewrite, which recognise a call by the leaves of `tail_pos`,
see them.

Only a function that tail-calls itself or sits in a tail-call group is
rewritten: the pipe of any other function keeps its shape, which pipe
fusion and the diagnostics of a pipe stage read.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.call_site_target
import compiler.mutation_carriers
import compiler.tail_pos
import compiler.tailgraph

#[doc("`decls` with the tail calls of every function on a tail-call cycle written as plain calls under `if`.")]
pub(pkg) fn tailnorm_decls(decls: [Decl]) : [Decl] = {
  let norm = map(decls, tn_decl)
  tn_pick(decls, norm, tailgraph_group_syms(tailgraph_build(norm)))
}

# The rewritten declaration where its function is on a cycle, the original elsewhere.
fn tn_pick(decls: [Decl], norm: [Decl], cyc: [SymId]) : [Decl] = match decls {
  [] -> []
  [d, ...rest] -> match norm {
    [n, ...nrest] -> [if tn_cyclic(n, cyc) { n } else { d }, ...tn_pick(rest, nrest, cyc)]
    []            -> decls
  }
}

fn tn_cyclic(d: Decl, cyc: [SymId]) : Bool = match d {
  DFn(_, fid, _, _, _, _, body, _, _, _) ->
    any(cyc, (s) => sym_raw(s) == sym_raw(fnid_sym(fid))) or any(tail_leaves(body), (leaf) => tn_calls(leaf, fnid_sym(fid)))
  _ -> false
}

fn tn_calls(leaf: Expr, me: SymId) : Bool = match leaf.kind {
  ECall(f, _) -> match callee_id(f) {
    Some(c) -> sym_raw(c) == sym_raw(me)
    None    -> false
  }
  _ -> false
}

fn tn_decl(d: Decl) : Decl = match d {
  DFn(p, fid, tps, ps, ret, row, body, ln, cl, mo) -> DFn(p, fid, tps, ps, ret, row, tail_map(body, tn_leaf), ln, cl, mo)
  _ -> d
}

fn tn_leaf(e: Expr) : Expr = match e.kind {
  EBinop(BoOr, l, r)  -> Expr { ...e, kind: EIf(l, mk_expr(EBool(true), e.line, e.col), Some(tail_map(r, tn_leaf))) }
  EBinop(BoAnd, l, r) -> Expr { ...e, kind: EIf(l, tail_map(r, tn_leaf), Some(mk_expr(EBool(false), e.line, e.col))) }
  EPipe(l, r)         -> pipe_as_call(l, r)
  _                   -> e
}
