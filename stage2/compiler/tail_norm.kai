#[doc("""
Tail calls written in a shape the rest of the pipeline does not read as one.

A call on the right of `or` / `and`, or on the right of `|>`, is still the
value of the function. `tailnorm_leaves` reads those as the call they mean,
for the tail-call graph; `tailnorm_decls` writes them as the `if` and call
they spell in a function that tail-calls itself, so the self-tail rewrite
sees them; fusion writes them the same way in the members of a group. A
function that does not tail-call itself keeps its pipes, which pipe fusion
and the diagnostics of a pipe stage read.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.call_site_target
import compiler.mutation_carriers
import compiler.tail_pos

#[doc("The leaves of `e` with a tail `or`, `and` or pipe read as the call on its right.")]
pub(pkg) fn tailnorm_leaves(e: Expr) : [Expr] = {
  let ls = tail_leaves(e)
  if any(ls, tn_shaped) { flat_map(ls, tn_peel) } else { ls }
}

fn tn_peel(leaf: Expr) : [Expr] = match leaf.kind {
  EBinop(BoOr, _, r)  -> tailnorm_leaves(r)
  EBinop(BoAnd, _, r) -> tailnorm_leaves(r)
  EPipe(l, r)         -> [pipe_as_call(l, r)]
  _                   -> [leaf]
}

#[doc("`decls` with the tail self-calls of every function written as plain calls under `if`.")]
pub(pkg) fn tailnorm_decls(decls: [Decl]) : [Decl] = map(decls, tn_decl)

fn tn_decl(d: Decl) : Decl = match d {
  DFn(p, fid, tps, ps, ret, row, body, ln, cl, mo) ->
    if tn_self_shaped(fnid_sym(fid), body) { DFn(p, fid, tps, ps, ret, row, tail_map(body, tn_leaf), ln, cl, mo) } else { d }
  _ -> d
}

# A tail call to the function itself, possibly behind `or`, `and`, a pipe or a `let` read back by the tail.
fn tn_self_shaped(me: SymId, body: Expr) : Bool = any(tailnorm_leaves(body), (leaf) => tn_calls(leaf, me))

fn tn_shaped(e: Expr) : Bool = match e.kind {
  EBinop(BoOr, _, _)  -> true
  EBinop(BoAnd, _, _) -> true
  EPipe(_, _)         -> true
  _                   -> false
}

fn tn_calls(leaf: Expr, me: SymId) : Bool = match leaf.kind {
  ECall(f, _) -> match callee_id(f) {
    Some(c) -> sym_raw(c) == sym_raw(me)
    None    -> false
  }
  _ -> false
}

#[doc("The leaf `e` written as the `if` or call it spells; the right side of `or` and `and` is normalised in turn.")]
pub(pkg) fn tn_leaf(e: Expr) : Expr = match e.kind {
  EBinop(BoOr, l, r)  -> Expr { ...e, kind: EIf(l, mk_expr(EBool(true), e.line, e.col), Some(tail_map(r, tn_leaf))) }
  EBinop(BoAnd, l, r) -> Expr { ...e, kind: EIf(l, tail_map(r, tn_leaf), Some(mk_expr(EBool(false), e.line, e.col))) }
  EPipe(l, r)         -> pipe_as_call(l, r)
  _                   -> e
}
