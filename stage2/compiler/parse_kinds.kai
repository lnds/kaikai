#[doc("""
Habitant declarations (`unit`, user introducers), `kind` declarations, habitant slot
lists, and kind annotations and bounds on type parameters.
""")]

import compiler.util
import compiler.lex_tokens
import compiler.lex
import compiler.ast
import compiler.decl_names
import compiler.kinds
import compiler.parse_state
import compiler.parse_literals
import compiler.parse_units

type UnitHead = { is_pub: Bool, name: String, intro: String, t: Token }

fn unit_decl_ok(p: Parser, h: UnitHead, body: UnitBody) : PDecl =
  ok_dn(p, DUnit(h.is_pub, h.name, body, h.intro, h.t.line, h.t.col, None), [p_ent(p, NCUnit, h.name, h.is_pub)])

#[doc("""
Parses a habitant declaration after its introducer `t`, whose source is kept verbatim:
`unit USD` (atomic), `unit Newton = kg * m / sec^2` (alias) or `pct pct70 = 70` (measure).
An integer other than `1` after `=` is a measure payload; anything else is a unit alias.
""")]
pub fn parse_unit_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let intro = tok_source(p.src, t)
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) {
    err_d(p_error(p, id, concat_all(["expected a name after `", intro, "`"])))
  } else {
    let h = UnitHead { is_pub: is_pub, name: tok_source(p.src, id), intro: intro, t: t }
    let p1 = p_advance(p)
    if p_at(p1, TkEq) { parse_unit_rhs(p_advance_nl(p1), h) } else { unit_decl_ok(p1, h, UBNone) }
  }
}

fn parse_unit_rhs(p: Parser, h: UnitHead) : PDecl / Console {
  let mt = p_peek(p)
  if tk_is(mt.kind, TkInt) and decode_int(tok_source(p.src, mt)) != 1 { parse_unit_measure(p, h) }
  else {
    let rb = parse_unit_expr(p)
    match rb.r {
      None -> err_d(rb.p)
      Some(u) -> unit_decl_ok(rb.p, h, UBAlias(u))
    }
  }
}

fn at_arith_op(p: Parser) : Bool =
  p_at(p, TkStar) or p_at(p, TkSlash) or p_at(p, TkCaret) or p_at(p, TkPlus) or p_at(p, TkMinus) or p_at(p, TkPercent)

# A measure is one literal, not a term: the sum a measure-carrying theory verifies must be exact.
fn parse_unit_measure(p: Parser, h: UnitHead) : PDecl / Console {
  let p1 = p_advance(p)
  if at_arith_op(p1) { err_d(p_error_here(p1, "a habitant measure must be a single exact numeric literal (e.g. `= 70`)")) }
  else { unit_decl_ok(p1, h, UBMeasure(tok_source(p.src, p_peek(p)))) }
}

# `kind` is contextual: the head `kind IDENT :` is never a valid expression or pattern at module scope.
#[doc("Reports whether the head is the identifier `kind` followed by `IDENT :`.")]
pub fn decl_head_is_kind(p: Parser, hd: Token) : Bool =
  tk_is(hd.kind, TkIdent) and tok_source(p.src, hd) == "kind" and tk_is(p_peek1(p).kind, TkIdent) and tk_is(p_peek2(p).kind, TkColon)

#[doc("Reports whether the head is a registered introducer word (builtin or from a `kind ... with` in the file) followed by a name.")]
pub fn decl_head_is_user_introducer(p: Parser, hd: Token) : Bool =
  tk_is(hd.kind, TkIdent) and kind_reg_is_introducer(p.kind_reg, tok_source(p.src, hd)) and tk_is(p_peek1(p).kind, TkIdent)

# Theories whose operation crosses two type domains admit an `over <Domain>` clause.
fn is_known_theory(name: String) : Bool =
  name == "AbelianGroup" or name == "Module" or name == "Composition" or name == "Semilattice" or is_builtin_theory(name)

fn is_two_domain_theory(name: String) : Bool = name == "Module" or name == "Composition"

type KindHead = { is_pub: Bool, name: String, thy: String, over: String, t: Token }

fn kind_decl_ok(p: Parser, h: KindHead, hab: KindHab) : PDecl =
  ok_dn(p, DKind(h.is_pub, h.name, h.thy, h.over, hab, h.t.line, h.t.col, None), [p_ent(p, NCKind, h.name, h.is_pub)])

#[doc("Parses `[pub] kind Name : Theory [over Domain] [with intro]` once the contextual `kind` is consumed; `t` anchors diagnostics.")]
pub fn parse_kind_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not is_upper_ident(p.src, id) { err_d(p_error(p, id, "kind name must start with an uppercase letter")) }
  else { parse_kind_theory(p_advance(p_advance(p)), KindHead { is_pub: is_pub, name: tok_source(p.src, id), thy: "", over: "", t: t }) }
}

fn parse_kind_theory(p: Parser, h: KindHead) : PDecl / Console {
  let th = p_peek(p)
  if not tk_is(th.kind, TkIdent) { err_d(p_error(p, th, "expected a theory name after `:` in a `kind` declaration")) }
  else {
    let thy = tok_source(p.src, th)
    if is_known_theory(thy) { parse_kind_over(p_advance(p), KindHead { ...h, thy: thy }) }
    else { err_d(p_error(p, th, concat_all(["unknown theory `", thy, "`"]))) }
  }
}

# `over` is contextual: claimed only in this slot of a `kind` head.
fn parse_kind_over(p: Parser, h: KindHead) : PDecl / Console {
  let ov = p_peek(p)
  if not (tk_is(ov.kind, TkIdent) and tok_source(p.src, ov) == "over") { parse_kind_with(p, h) }
  else if is_two_domain_theory(h.thy) { parse_kind_domain(p_advance(p), h) }
  else {
    err_d(p_error(p, ov, concat_all(["theory `", h.thy, "` has one domain, so it takes no `over` clause",
                                     " (only Module and Composition cross two domains)"])))
  }
}

fn parse_kind_domain(p: Parser, h: KindHead) : PDecl / Console {
  let dom = p_peek(p)
  if tk_is(dom.kind, TkIdent) and is_upper_ident(p.src, dom) { parse_kind_with(p_advance(p), KindHead { ...h, over: tok_source(p.src, dom) }) }
  else { err_d(p_error_here(p, "expected a domain type after `over` (e.g. `over Int`)")) }
}

# A kind whose habitants are derived (every arity-1 `type`) has no `with` and an empty introducer.
fn parse_kind_with(p: Parser, h: KindHead) : PDecl / Console =
  if p_at(p, TkWith) { parse_kind_introducer(p_advance(p), h) } else { kind_decl_ok(p, h, HabNone) }

fn parse_kind_introducer(p: Parser, h: KindHead) : PDecl / Console =
  match p_peek(p).kind {
    TkType -> kind_decl_ok(p_advance(p), h, HabIntro("type"))
    TkEffect -> kind_decl_ok(p_advance(p), h, HabIntro("effect"))
    _ -> parse_kind_introducer_word(p, h)
  }

# An uppercase name is a value domain; a lowercase one an introducer word, whose `{` opens a closed habitant set.
fn parse_kind_introducer_word(p: Parser, h: KindHead) : PDecl / Console {
  let it = p_peek(p)
  if not tk_is(it.kind, TkIdent) {
    err_d(p_error_here(p, "expected an introducer word or a value domain after `with` (e.g. `with metric`, `with Int`)"))
  } else if is_upper_ident(p.src, it) { kind_value_domain(p, it, h) }
  else { kind_introducer_tail(p_advance(p), tok_source(p.src, it), h) }
}

fn kind_value_domain(p: Parser, it: Token, h: KindHead) : PDecl / Console =
  match value_domain_of_name(tok_source(p.src, it)) {
    Some(dom) -> kind_decl_ok(p_advance(p), h, HabDomain(dom))
    None -> err_d(p_error(p, it, "a value-habitant domain must be `Int` or `String`"))
  }

fn kind_introducer_tail(p: Parser, word: String, h: KindHead) : PDecl / Console =
  if p_at(p, TkLbrace) { parse_kind_closed_set(p_advance_nl(p), h, word, []) }
  else { kind_decl_ok(p, h, HabIntro(word)) }

fn parse_kind_closed_set(p: Parser, h: KindHead, word: String, acc: [String]) : PDecl / Console {
  let a = p_peek(p)
  if p_at(p, TkRbrace) { closed_set_done(p, h, word, acc) }
  else if tk_is(a.kind, TkIdent) { parse_kind_closed_set(p_advance_nl(p), h, word, [tok_source(p.src, a), ...acc]) }
  else { err_d(p_error_here(p, "expected a habitant atom or `}` in the closed habitant set")) }
}

fn closed_set_done(p: Parser, h: KindHead, word: String, acc: [String]) : PDecl / Console =
  match acc {
    [] -> err_d(p_error_here(p, "a closed habitant set cannot be empty"))
    _  -> kind_decl_ok(p_advance(p), h, HabClosed(word, list_reverse(acc)))
  }

#[doc("The parser state paired with a `<name: Kind, ...>` habitant-slot list, one `\"name:Kind\"` string per slot.")]
pub type PHSlots = { p: Parser, r: Option[[String]] }

fn slots_err(p: Parser) : PHSlots = PHSlots { p: p, r: None }

#[doc("Parses `name: Kind` slots separated by commas up to `>`; each kind must be registered.")]
pub fn parse_habitant_slots_loop(p: Parser, acc: [String]) : PHSlots / Console {
  let t = p_peek(p)
  if not tk_is(t.kind, TkIdent) { slots_err(p_error(p, t, "expected a slot name in the `<...>` habitant list")) }
  else {
    let p1 = p_advance_nl(p)
    if p_at(p1, TkColon) { parse_habitant_slot_kind(p_advance_nl(p1), tok_source(p.src, t), acc) }
    else { slots_err(p_error_here(p1, "expected `:` after a habitant-slot name (`<n: Dim>`)")) }
  }
}

fn parse_habitant_slot_kind(p: Parser, sname: String, acc: [String]) : PHSlots / Console {
  let kt = p_peek(p)
  if not tk_is(kt.kind, TkIdent) { slots_err(p_error_here(p, "expected a kind after `:` in the habitant slot")) }
  else {
    let kind = tok_source(p.src, kt)
    if kind == measure_kind_name() or kind_reg_has_kind(p.kind_reg, kind) {
      parse_habitant_slot_end(p_advance_nl(p), [concat_all([sname, ":", kind]), ...acc])
    } else {
      slots_err(p_error(p, kt, concat_all(["habitant-slot kind must be a declared kind — `", kind, "` is not a kind"])))
    }
  }
}

fn parse_habitant_slot_end(p: Parser, acc: [String]) : PHSlots / Console =
  if p_at(p, TkComma) { parse_habitant_slots_loop(p_advance_nl(p), acc) }
  else if p_at(p, TkGt) { PHSlots { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else { slots_err(p_error_here(p, "expected `,` or `>` after a habitant slot")) }

# `Unit` is the void return type, not a kind; a declared kind wins over the protocol-bound reading (`[u: Metric]`).
fn word_kind(p: Parser, kw: String) : Option[Kind] =
  match kw {
    "Measure" -> Some(KUnit(measure_kind_name()))
    "Type" -> Some(KType)
    "Shape" -> Some(KShape)
    "Unit" -> None
    _ -> if kind_reg_has_kind(p.kind_reg, kw) { Some(KUnit(kw)) } else { None }
  }

fn unit_not_kind_msg() : String = "expected kind `Measure`; `Unit` is the void return type, not a kind (renamed in #253)"

#[doc("A kind annotation on a type parameter, defaulting to `Type`.")]
pub type PKind = { p: Parser, kind: Kind }

fn kind_err(p: Parser) : PKind = PKind { p: p, kind: KType }

#[doc("Parses an optional `: Type` / `: Measure` / `: Shape` / declared-kind annotation on a type parameter.")]
pub fn parse_optional_kind_annotation(p: Parser) : PKind / Console =
  if not p_at(p, TkColon) { PKind { p: p, kind: KType } }
  else {
    let p1 = p_advance_nl(p)
    let t = p_peek(p1)
    if tk_is(t.kind, TkIdent) { parse_kind_word(p, p1, t) }
    else { kind_err(p_error_here(p1, "expected `Type` or `Measure` after `:` in type parameter")) }
  }

fn parse_kind_word(p: Parser, p1: Parser, t: Token) : PKind / Console {
  let kw = tok_source(p1.src, t)
  match word_kind(p, kw) {
    Some(k) -> PKind { p: p_advance(p1), kind: k }
    None -> kind_err(p_error(p1, t, if kw == "Unit" { unit_not_kind_msg() }
      else { concat_all(["type-parameter kind must be `Type`, `Measure`, or a declared kind — `", kw, "` is not a kind"]) }))
  }
}

#[doc("""
The colon suffix of a type parameter: a kind annotation (`: Measure`, `: Type`) or a
protocol bound list (`: Show + Eq`); the two do not mix.
""")]
pub type PKindBounds = { p: Parser, kind: Kind, bounds: [String] }

fn bounds_err(p: Parser) : PKindBounds = PKindBounds { p: p, kind: KType, bounds: [] }

#[doc("Parses an optional kind annotation or protocol bounds on a type parameter.")]
pub fn parse_optional_kind_or_bounds(p: Parser) : PKindBounds / Console =
  if not p_at(p, TkColon) { PKindBounds { p: p, kind: KType, bounds: [] } }
  else {
    let p1 = p_advance_nl(p)
    let t = p_peek(p1)
    if tk_is(t.kind, TkIdent) { parse_kind_or_bounds_word(p, p1, t) }
    else { bounds_err(p_error_here(p1, "expected protocol name, `Type`, or `Measure` after `:` in type parameter")) }
  }

fn parse_kind_or_bounds_word(p: Parser, p1: Parser, t: Token) : PKindBounds / Console {
  let kw = tok_source(p1.src, t)
  match word_kind(p, kw) {
    Some(k) -> PKindBounds { p: p_advance(p1), kind: k, bounds: [] }
    None ->
      if kw == "Unit" { bounds_err(p_error(p1, t, unit_not_kind_msg())) }
      else if is_upper_ident(p1.src, t) { parse_more_bounds_loop(p_advance(p1), [kw]) }
      else { bounds_err(p_error(p1, t, "type-parameter annotation must be `Type`, `Measure`, or an uppercase protocol name")) }
  }
}

fn parse_more_bounds_loop(p: Parser, acc: [String]) : PKindBounds / Console {
  let p_n = p_skip_newlines(p)
  if not p_at(p_n, TkPlus) { PKindBounds { p: p, kind: KType, bounds: list_reverse(acc) } }
  else {
    let p1 = p_advance_nl(p_n)
    let t = p_peek(p1)
    if tk_is(t.kind, TkIdent) and is_upper_ident(p1.src, t) { parse_more_bounds_loop(p_advance(p1), [tok_source(p1.src, t), ...acc]) }
    else { PKindBounds { p: p_error_here(p1, "expected uppercase protocol name after `+` in bound list"), kind: KType, bounds: list_reverse(acc) } }
  }
}
