#[doc("""
The `handle`s that run their body on a stack segment: `--explain` notes
each one of the root file with the clause shape that sent it there, and
the native backend, which does not lower them, reports each one.
""")]

import compiler.ast
import compiler.diag_file
import compiler.expr_positions
import compiler.effect_default
import compiler.infer

#[doc("Print a note for each `handle` of the root file that runs on a stack segment; returns the typer's error count.")]
pub fn dump_explain(df: DiagFiles, tp: TypedProgram) : Int / Console = {
  let root = df_root(df)
  each(tp.decls, (d) => if decl_diag_file(d, df) == root { explain_decl(root, d) } else { () })
  tp.errs
}

fn explain_decl(file: String, d: Decl) : Unit / Console = match decl_body(d) {
  Some(b) -> explain_expr(file, b)
  None    -> ()
}

fn explain_expr(file: String, e: Expr) : Unit / Console = {
  match e.kind {
    EIntrinsic(nm, args_) -> if nm == "seg_handle" { note(file, e, args_) } else { () }
    _ -> ()
  }
  each(xp_positions(e), (p) => match p { XP(_, x) -> explain_expr(file, x) })
}

fn note(file: String, at: Expr, args_: [Expr]) : Unit / Console = match args_ {
  [esc, why, ..._] -> {
    let reason = match why.kind { EStr(span, _) -> strip_string_quotes(span)  _ -> "" }
    let leaves = match esc.kind { EBool(true) -> "; the continuation can leave its clause"  _ -> "" }
    print("#{file}:#{at.line}:#{at.col}: note: this `handle` runs its body on a stack segment: #{reason}#{leaves}")
  }
  _ -> ()
}

#[doc("True when a declaration of `ds` holds a `handle` that runs on a stack segment.")]
pub fn holds_segment_handle(ds: [Decl]) : Bool = any(ds, (d) => match decl_body(d) {
  Some(b) -> expr_holds_segment(b)
  None    -> false
})

#[doc("Report each segment `handle` of `ds` as unsupported by the native backend; returns how many.")]
pub fn report_native_segments(df: DiagFiles, ds: [Decl]) : Int / Console =
  foldl(ds, 0, (n, d) => match decl_body(d) {
    Some(b) -> n + report_in(decl_diag_file(d, df), b)
    None    -> n
  })

fn report_in(file: String, e: Expr) : Int / Console = {
  let here = match e.kind {
    EIntrinsic(nm, _) -> if nm == "seg_handle" {
      eprint("error: the native backend does not compile a `handle` that runs on a stack segment yet")
      eprint("  --> #{file}:#{e.line}:#{e.col}")
      eprint("  = help: build with `--backend=c`")
      1
    } else { 0 }
    _ -> 0
  }
  foldl(xp_positions(e), here, (n, p) => match p { XP(_, x) -> n + report_in(file, x) })
}

fn decl_body(d: Decl) : Option[Expr] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _, _) -> Some(body)
  DTest(_, body, _, _, _)                 -> Some(body)
  _ -> None
}

fn expr_holds_segment(e: Expr) : Bool = match e.kind {
  EIntrinsic(nm, xs) -> nm == "seg_handle" or any(xs, expr_holds_segment)
  _ -> any(xp_positions(e), (p) => match p { XP(_, x) -> expr_holds_segment(x) })
}
