#[doc("""
The c-modular per-TU artifacts: header slices and the persistent TU cache.

compiler/emit_slices.kai -- per-TU header slices for the c-modular split.

The two whole-program headers the split used to share (types + decls)
defeat the per-.o content cache: one added type or prototype rewrites
the shared text and re-keys every translation unit. This module
projects those headers into per-TU slices (kai_types_<stem>.h /
kai_decls_<stem>.h) holding only the declarations the TU's C body
references, closed transitively over the selected declarations' own
text (a ctor struct pulls its base struct, a prototype pulls the
evidence struct types in its signature).

Selection is by C identifier token, which makes under-inclusion
impossible: C code can only reference a symbol through its identifier,
so any needed declaration's name occurs in the TU body or in an
already-selected declaration. Over-inclusion (a name that only occurs
in a string literal) merely widens a slice and costs nothing.

A header line whose declared name cannot be recognised lands in EVERY
slice -- the sound fallback is to over-include, never to drop.

Single-line #[doc(...)] only -- kaic1 still consumes the bundle.

compiler/emit_cache.kai - persistent cache of the core module set's
emitted C translation units (the c-modular backend's per-TU bodies).

The core's emitted C is a pure function of (core sources, toolchain,
edition, build mode): monomorphised instances of core generics land
in the root TU, protocol dispatch resolves through runtime impl
tables, and the modular emitter builds every TU body independently
from a shared immutable context. A warm entry therefore lets
`emit_program_modular` skip the body emission for every core TU and
splice the cached text into the stream unchanged; everything
downstream (linkage externalisation, header slicing, the wrapper's
content-hashed `.o` cache) runs identically, so a warm build is
byte-identical to a cold one.

INVALIDATION mirrors core_cache.kai: the entry filename embeds a key
hashed over the core source contents, the toolchain id, the edition,
and the build mode; the header echoes the key as a second line of
defense. A stale entry can never be spliced: it would have to be a
valid entry for a DIFFERENT (core, toolchain) pair, and the key is
exactly what distinguishes them. Any IO or parse failure is a miss,
never an error - the cache is a performance layer only.
""")]

import compiler.chars
import compiler.user_cache
import compiler.util

#[doc("One translation-unit input to the header slicer: filename stem + emitted C body.")]
pub type SliceTU = { stem: String, body: String }

#[doc("The sliced pair for one TU: the kai_types_<stem>.h and kai_decls_<stem>.h texts.")]
pub type SlicedHeaders = { stem: String, types_h: String, decls_h: String }

# One shared-header declaration unit: the declared C identifier (empty
# means unrecognised shape -> include everywhere) and the unit's text.
type SlUnit = { uname: String, utext: String }

# Unit store + name index. Types units occupy [0, ntypes), decls units
# [ntypes, nunits); each range keeps its header's original order, which
# is what makes the sliced output define-before-use like the whole text.
type SlIndex = { unames: Array[String], utexts: Array[String],
                 nunits: Int, ntypes: Int,
                 buckets: Array[[Int]], nbuckets: Int }

# Selection in progress: the per-unit chosen flags plus the worklist of
# freshly selected units whose text still awaits the closure scan.
type SlState = { sel: Array[Bool], work: [Int] }

#[doc("Project the two shared c-modular headers into per-TU slices, one pair per input TU, each holding only the declarations that TU references.")]
pub fn slice_headers(types_h: String, decls_h: String, tus: [SliceTU]) : [SlicedHeaders] / Mutable {
  let ix = sl_build_index(sl_type_units(types_h), sl_decl_units(decls_h))
  let alw = sl_always_units(ix, 0, [])
  sl_slice_tus(tus, ix, alw, [])
}

fn sl_slice_tus(tus: [SliceTU], ix: SlIndex, alw: [Int], acc: [SlicedHeaders]) : [SlicedHeaders] / Mutable = match tus {
  [] -> list_reverse(acc)
  [tu, ...rest] -> {
    let sel = sl_select(tu.body, ix, alw)
    let sh = SlicedHeaders { stem: tu.stem,
                             types_h: sl_types_header(tu.stem, ix, sel),
                             decls_h: sl_decls_header(tu.stem, ix, sel) }
    sl_slice_tus(rest, ix, alw, [sh, ...acc])
  }
}

# ---- shared-header parsing into units ------------------------------

# Decls header: every unit is one line (a prototype `RET name(args);` or
# an `extern <type> name;`). Guard/include/comment/blank lines drop --
# the per-TU assembly writes its own guard and include.
fn sl_decl_units(decls_h: String) : [SlUnit] =
  list_reverse(sl_decl_units_go(string_split(decls_h, "\n"), []))

fn sl_decl_units_go(lns: [String], acc: [SlUnit]) : [SlUnit] = match lns {
  [] -> acc
  [ln, ...rest] ->
    if sl_skip_line(ln) { sl_decl_units_go(rest, acc) }
    else { sl_decl_units_go(rest, [SlUnit { uname: sl_decl_name(ln), utext: ln }, ...acc]) }
}

# A prototype is named by the identifier before its `(`; an extern data
# decl by the identifier before its `;`.
fn sl_decl_name(ln: String) : String {
  let p = string_index_of_char(ln, '(')
  let n = string_length(ln)
  if p >= 0 { sl_ident_before(ln, p) }
  else if n >= 2 and char_at_or_zero(ln, n - 1) == ';' { sl_ident_before(ln, n - 1) }
  else { "" }
}

# Types header: units are struct blocks (`struct X {` ... `};`),
# one-line struct defs, `typedef struct X X;` forwards, and anonymous
# `typedef struct {` ... `} Name;` blocks (named at the close line).
# The fold state carries the units built so far (reversed) plus the
# open block, if any: its name and its reversed lines.
type SlParse = { units: [SlUnit], bname: String, blines: [String] }

fn sl_type_units(types_h: String) : [SlUnit] {
  let st = sl_type_units_go(string_split(types_h, "\n"),
                            SlParse { units: [], bname: "", blines: [] })
  list_reverse(st.units)
}

fn sl_type_units_go(lns: [String], st: SlParse) : SlParse = match lns {
  [] -> st
  [ln, ...rest] -> sl_type_units_go(rest, sl_type_line(ln, st))
}

fn sl_type_line(ln: String, st: SlParse) : SlParse =
  if not list_is_empty(st.blines) { sl_block_line(ln, st) }
  else if sl_has_prefix(ln, "struct ") or sl_has_prefix(ln, "typedef struct") { sl_open_line(ln, st) }
  else if sl_skip_line(ln) { st }
  else { sl_push_unit(st, "", ln) }

fn sl_block_line(ln: String, st: SlParse) : SlParse =
  if sl_has_prefix(ln, "}") {
    let nm = if st.bname == "" { sl_close_name(ln) } else { st.bname }
    sl_push_unit(SlParse { units: st.units, bname: "", blines: [] },
                 nm, join_with(list_reverse([ln, ...st.blines]), "\n"))
  }
  else { SlParse { units: st.units, bname: st.bname, blines: [ln, ...st.blines] } }

fn sl_open_line(ln: String, st: SlParse) : SlParse {
  let nm = sl_struct_name(ln)
  if sl_line_ends_semi(ln) { sl_push_unit(st, nm, ln) }
  else { SlParse { units: st.units, bname: nm, blines: [ln] } }
}

fn sl_push_unit(st: SlParse, nm: String, txt: String) : SlParse =
  SlParse { units: [SlUnit { uname: nm, utext: txt }, ...st.units], bname: "", blines: [] }

# The struct tag: the identifier after the (possibly typedef'd) `struct`
# keyword. Empty for an anonymous `typedef struct {`.
fn sl_struct_name(ln: String) : String {
  let s = if sl_has_prefix(ln, "typedef ") { 15 } else { 7 }
  let e = sl_ident_end(ln, s, string_length(ln))
  if e <= s { "" } else { string_slice(ln, s, e - s) }
}

# The typedef name on an anonymous block's `} Name;` close line.
fn sl_close_name(ln: String) : String {
  let n = string_length(ln)
  if n >= 2 and char_at_or_zero(ln, n - 1) == ';' { sl_ident_before(ln, n - 1) }
  else { "" }
}

fn sl_skip_line(ln: String) : Bool {
  let n = string_length(ln)
  if n == 0 { true }
  else {
    let c0 = char_at_or_zero(ln, 0)
    c0 == '#' or c0 == '/'
  }
}

fn sl_line_ends_semi(ln: String) : Bool {
  let n = string_length(ln)
  n >= 1 and char_at_or_zero(ln, n - 1) == ';'
}

fn sl_has_prefix(ln: String, pfx: String) : Bool {
  let pl = string_length(pfx)
  if pl > string_length(ln) { false }
  else { string_slice(ln, 0, pl) == pfx }
}

# ---- identifier helpers --------------------------------------------

fn sl_ident_before(ln: String, endp: Int) : String {
  let s = sl_ident_start(ln, endp)
  if s >= endp { "" } else { string_slice(ln, s, endp - s) }
}

fn sl_ident_start(ln: String, i: Int) : Int =
  if i <= 0 { 0 }
  else if ch_is_alnum(char_at_or_zero(ln, i - 1)) { sl_ident_start(ln, i - 1) }
  else { i }

fn sl_ident_end(txt: String, i: Int, n: Int) : Int =
  if i >= n { i }
  else if ch_is_alnum(char_at_or_zero(txt, i)) { sl_ident_end(txt, i + 1, n) }
  else { i }

# ---- unit index ----------------------------------------------------

# Fixed power-of-two bucket count, comfortably above the ~16k units a
# self-compile produces, so buckets stay short and lookups cheap.
fn sl_nbuckets() : Int = 32768

# string_hash may be negative; land in [0, n) for any sign.
fn sl_slot(h: Int, n: Int) : Int = ((h % n) + n) % n

fn sl_build_index(tunits: [SlUnit], dunits: [SlUnit]) : SlIndex / Mutable {
  let nt = list_length(tunits)
  let n = nt + list_length(dunits)
  let unames = array_make(n, "")
  let utexts = array_make(n, "")
  let n1 = sl_fill_units(tunits, 0, unames, utexts)
  let n2 = sl_fill_units(dunits, n1, unames, utexts)
  let nb = sl_nbuckets()
  let buckets = array_make(nb, [])
  let n3 = sl_fill_buckets(0, n2, unames, buckets, nb)
  SlIndex { unames: unames, utexts: utexts, nunits: n3, ntypes: nt,
            buckets: buckets, nbuckets: nb }
}

fn sl_fill_units(us: [SlUnit], i: Int, unames: Array[String], utexts: Array[String]) : Int / Mutable = match us {
  [] -> i
  [u, ...rest] -> {
    let a1 = array_set(unames, i, u.uname)
    let a2 = array_set(utexts, i, u.utext)
    sl_fill_units(rest, i + 1, a1, a2)
  }
}

fn sl_fill_buckets(i: Int, n: Int, unames: Array[String], buckets: Array[[Int]], nb: Int) : Int / Mutable =
  if i >= n { i }
  else {
    let nm = array_get(unames, i)
    if nm == "" { sl_fill_buckets(i + 1, n, unames, buckets, nb) }
    else {
      let s = sl_slot(string_hash(nm), nb)
      let b1 = array_set(buckets, s, list_append(array_get(buckets, s), [i]))
      sl_fill_buckets(i + 1, n, unames, b1, nb)
    }
  }

# Units with no recognised name are selected for every TU.
fn sl_always_units(ix: SlIndex, i: Int, acc: [Int]) : [Int] =
  if i >= ix.nunits { list_reverse(acc) }
  else if array_get(ix.unames, i) == "" { sl_always_units(ix, i + 1, [i, ...acc]) }
  else { sl_always_units(ix, i + 1, acc) }

# ---- per-TU selection ----------------------------------------------

fn sl_select(body: String, ix: SlIndex, alw: [Int]) : Array[Bool] / Mutable {
  let st0 = sl_mark_always(alw, SlState { sel: array_make(ix.nunits, false), work: [] })
  let st1 = sl_close(ix, sl_scan(body, ix, st0))
  st1.sel
}

fn sl_mark_always(uis: [Int], st: SlState) : SlState / Mutable = match uis {
  [] -> st
  [ui, ...rest] ->
    sl_mark_always(rest, SlState { sel: array_set(st.sel, ui, true), work: [ui, ...st.work] })
}

# Scan one text for identifier tokens, selecting every unit whose name
# matches; fresh selections queue for the closure scan.
fn sl_scan(txt: String, ix: SlIndex, st: SlState) : SlState / Mutable =
  sl_scan_go(txt, 0, string_length(txt), ix, st)

fn sl_scan_go(txt: String, i: Int, n: Int, ix: SlIndex, st: SlState) : SlState / Mutable =
  if i >= n { st }
  else if ch_is_alpha(char_at_or_zero(txt, i)) {
    let e = sl_ident_end(txt, i + 1, n)
    sl_scan_go(txt, e, n, ix, sl_mark(string_slice(txt, i, e - i), ix, st))
  }
  else { sl_scan_go(txt, i + 1, n, ix, st) }

fn sl_mark(tok: String, ix: SlIndex, st: SlState) : SlState / Mutable =
  sl_mark_bucket(array_get(ix.buckets, sl_slot(string_hash(tok), ix.nbuckets)), tok, ix, st)

fn sl_mark_bucket(bk: [Int], tok: String, ix: SlIndex, st: SlState) : SlState / Mutable = match bk {
  [] -> st
  [ui, ...rest] -> {
    let st2 = if array_get(ix.unames, ui) == tok and not array_get(st.sel, ui) {
      SlState { sel: array_set(st.sel, ui, true), work: [ui, ...st.work] }
    } else { st }
    sl_mark_bucket(rest, tok, ix, st2)
  }
}

# Transitive closure: scan each freshly selected unit's own text, so a
# selected declaration pulls the declarations it references.
fn sl_close(ix: SlIndex, st: SlState) : SlState / Mutable = match st.work {
  [] -> st
  [ui, ...rest] ->
    sl_close(ix, sl_scan(array_get(ix.utexts, ui), ix, SlState { sel: st.sel, work: rest }))
}

# ---- per-TU header assembly ----------------------------------------

fn sl_gather(ix: SlIndex, sel: Array[Bool], lo: Int, hi: Int, b: SB) : SB / Mutable =
  if lo >= hi { b }
  else {
    let b2 = if array_get(sel, lo) { sb_append(sb_append(b, array_get(ix.utexts, lo)), "\n") }
             else { b }
    sl_gather(ix, sel, lo + 1, hi, b2)
  }

fn sl_types_header(stem: String, ix: SlIndex, sel: Array[Bool]) : String / Mutable {
  let b = sb_append(sb_new(), concat_all([
    "/* generated by kaikai stage 2 - per-TU types slice */\n",
    "#ifndef KAI_TYPES_", stem, "_H\n#define KAI_TYPES_", stem, "_H\n",
    "#include \"runtime.h\"\n\n"]))
  sb_build(sb_append(sl_gather(ix, sel, 0, ix.ntypes, b), "\n#endif\n"))
}

fn sl_decls_header(stem: String, ix: SlIndex, sel: Array[Bool]) : String / Mutable {
  let b = sb_append(sb_new(), concat_all([
    "/* generated by kaikai stage 2 - per-TU decls slice */\n",
    "#ifndef KAI_DECLS_", stem, "_H\n#define KAI_DECLS_", stem, "_H\n",
    "#include \"kai_types_", stem, ".h\"\n\n"]))
  sb_build(sb_append(sl_gather(ix, sel, ix.ntypes, ix.nunits, b), "\n#endif\n"))
}

#[doc("One cached translation unit: the TU stem (module origin with dots as underscores), its pre-externalisation C body text, and the types and decls header slices the body is compiled against.")]
pub type CTU = CTU(String, String, String, String)

# A parsed header/stem line: the text and the position past its newline.
type EcLine = EL(String, Int)

#[doc("Bump on any change to the entry format or key derivation so old entries miss after an upgrade.")]
pub fn ec_format_tag() : String = "KCT3"

# ---- entry path ------------------------------------------------------

#[doc("Absolute path of the emit-cache entry for a key, under the given cache directory.")]
fn ec_entry_path(dir: String, key: String) : String =
  concat_all([dir, "/core-emit-", key, ".kct"])

# ---- serialisation ---------------------------------------------------

# Entry layout (text header, length-prefixed bodies):
#   KCT2\n<key>\n<n_tus>\n
#   then per TU: <stem>\n<body_len>\n<types_len>\n<decls_len>\n<body><types><decls>
# Length prefixes make the body split exact - no marker can collide
# with emitted C.

fn ec_render_tus(tus: [CTU], acc: [String]) : [String] = match tus {
  [] -> list_reverse(acc)
  [t, ...rest] -> match t {
    CTU(stem, body, types_h, decls_h) ->
      ec_render_tus(rest, [concat_all([stem, "\n",
                                       int_to_string(string_length(body)), "\n",
                                       int_to_string(string_length(types_h)), "\n",
                                       int_to_string(string_length(decls_h)), "\n",
                                       body, types_h, decls_h]), ...acc])
  }
}

# Read the line starting at `pos`. `EL("", -1)` on a missing
# terminator - the -1 position poisons every downstream bounds check,
# so a truncated blob decodes to None without per-call Option nesting.
fn ec_read_line(buf: String, pos: Int) : EcLine =
  if pos < 0 { EL("", 0 - 1) }
  else { ec_scan_nl(buf, pos, pos, string_length(buf)) }

fn ec_scan_nl(buf: String, start: Int, i: Int, n: Int) : EcLine =
  if i >= n { EL("", 0 - 1) }
  else if string_byte_at_int(buf, i) == 10 {
    EL(string_slice(buf, start, i - start), i + 1)
  }
  else { ec_scan_nl(buf, start, i + 1, n) }

# A non-negative int parsed from a line's text; -1 on malformation.
fn ec_nat_of(s: String) : Int = match string_to_int(s) {
  None -> 0 - 1
  Some(n) -> if n < 0 { 0 - 1 } else { n }
}

fn ec_line_nat(l: EcLine) : Int = match l {
  EL(s, p) -> if p < 0 { 0 - 1 } else { ec_nat_of(s) }
}

fn ec_line_pos(l: EcLine) : Int = match l { EL(_, p) -> p }

fn ec_line_is(l: EcLine, want: String) : Bool = match l {
  EL(s, p) -> p >= 0 and s == want
}

fn ec_parse_tus(buf: String, pos: Int, left: Int, acc: [CTU]) : Option[[CTU]] =
  if pos < 0 { None }
  else if left == 0 { Some(list_reverse(acc)) }
  else { ec_parse_one(buf, ec_read_line(buf, pos), left, acc) }

fn ec_parse_one(buf: String, stem_l: EcLine, left: Int, acc: [CTU]) : Option[[CTU]] = {
  let blen_l = ec_read_line(buf, ec_line_pos(stem_l))
  let tlen_l = ec_read_line(buf, ec_line_pos(blen_l))
  let dlen_l = ec_read_line(buf, ec_line_pos(tlen_l))
  let blen = ec_line_nat(blen_l)
  let tlen = ec_line_nat(tlen_l)
  let dlen = ec_line_nat(dlen_l)
  let at = ec_line_pos(dlen_l)
  if blen < 0 or tlen < 0 or dlen < 0 or at < 0 or at + blen + tlen + dlen > string_length(buf) { None }
  else {
    let stem = match stem_l { EL(s, _) -> s }
    let tu = CTU(stem, string_slice(buf, at, blen), string_slice(buf, at + blen, tlen),
                 string_slice(buf, at + blen + tlen, dlen))
    ec_parse_tus(buf, at + blen + tlen + dlen, left - 1, [tu, ...acc])
  }
}

#[doc("Deserialise an entry blob back into its TU set. None on any format drift, key mismatch, or truncation - the caller treats None as a miss.")]
fn ec_deserialize(blob: String, key: String) : Option[[CTU]] = {
  let tag_l = ec_read_line(blob, 0)
  let key_l = ec_read_line(blob, ec_line_pos(tag_l))
  let n_l = ec_read_line(blob, ec_line_pos(key_l))
  if ec_line_is(tag_l, ec_format_tag()) and ec_line_is(key_l, key) {
    ec_parse_tus(blob, ec_line_pos(n_l), ec_line_nat(n_l), [])
  } else { None }
}

# ---- lookup / write --------------------------------------------------

#[doc("Look up the emit cache: the deserialised TU set on a present, key-valid entry, or None on any miss.")]
pub fn ec_lookup(dir: String, key: String) : Option[[CTU]] / Console + File =
  match read_file(ec_entry_path(dir, key)) {
    Err(_) -> None
    Ok(blob) -> ec_deserialize(blob, key)
  }

#[doc("Publish the TU set atomically to its entry and return its content digest. IO failures are swallowed - an unwritable cache is a performance loss, never a correctness one.")]
pub fn ec_write(dir: String, key: String, tus: [CTU]) : String / Console + File = {
  let body = ec_render_body(ec_sort_tus(tus, []))
  let _p = cache_publish(ec_entry_path(dir, key),
                         concat_all([ec_format_tag(), "\n", key, "\n", int_to_string(list_length(tus)), "\n", body]))
  uc_content_hex(body)
}

fn ec_render_body(tus: [CTU]) : String = concat_all(ec_render_tus(tus, []))

#[doc("Find a cached TU body by stem. None when the stem is not in the set.")]
pub fn ec_find(tus: [CTU], stem: String) : Option[String] = match ec_find_tu(tus, stem) {
  Some(CTU(_, body, _, _)) -> Some(body)
  None -> None
}

#[doc("Find a cached TU by stem, with its header slices.")]
pub fn ec_find_tu(tus: [CTU], stem: String) : Option[CTU] = match tus {
  [] -> None
  [t, ...rest] -> match t {
    CTU(s, _, _, _) -> if s == stem { Some(t) } else { ec_find_tu(rest, stem) }
  }
}

#[doc("The stem of a cached TU.")]
fn ec_stem(t: CTU) : String = match t { CTU(s, _, _, _) -> s }

#[doc("A digest of a TU set that does not depend on the order the TUs were emitted in.")]
pub fn ec_content_hex(tus: [CTU]) : String = uc_content_hex(ec_render_body(ec_sort_tus(tus, [])))

fn ec_sort_tus(tus: [CTU], sorted: [CTU]) : [CTU] = match tus {
  [] -> sorted
  [t, ...rest] -> ec_sort_tus(rest, ec_insert_tu(t, sorted))
}

fn ec_insert_tu(t: CTU, sorted: [CTU]) : [CTU] = match sorted {
  [] -> [t]
  [h, ...rest] -> if string_lt(ec_stem(t), ec_stem(h)) { [t, h, ...rest] } else { [h, ...ec_insert_tu(t, rest)] }
}

# ---- pre-typing index -------------------------------------------------
#
# The entry key hashes the program's surface and so exists only after the
# whole core was typed. Every other input of it forms a pre-key. A full
# compile records which entry its pre-key and its variant produced, with a
# digest of the entry's TUs: the variant is what of the program shapes the
# core TUs. A later compile prunes the core only against a recorded entry
# of its own variant, and a variant whose TUs digest differently across
# full compiles is marked conflicting for good. A pre-key keeps at most
# `ec_index_cap` variants, the newest first.

#[doc("The pre-key of the core TU set: every input of the entry key except the program's surface.")]
pub fn ec_pre_key(toolchain: String, edition: String, srcs_hex: String, inputs: String) : String =
  uc_content_hex(concat_all([ec_format_tag(), "\nPRE\n", toolchain, "\n", edition, "\n", srcs_hex, "\n", inputs]))

fn ec_index_path(dir: String, pre: String) : String = concat_all([dir, "/core-emit-pre-", pre])

#[doc("How many variants one pre-key records.")]
fn ec_index_cap() : Int = 8

# A record line is `<variant> <content> <key>`, or `<variant> conflict`.
fn ec_index_lines(dir: String, pre: String) : [String] / Console + File =
  match read_file(ec_index_path(dir, pre)) {
    Err(_) -> []
    Ok(rec) -> filter(string_split(rec, "\n"), (l) => l != "")
  }

fn ec_line_fields(l: String) : [String] = string_split(l, " ")

fn ec_line_variant(l: String) : String = match ec_line_fields(l) {
  [v, ...rest] -> v
  []           -> ""
}

#[doc("Whether `variant` has a record under `pre`.")]
pub fn ec_index_has(dir: String, pre: String, variant: String) : Bool / Console + File =
  match filter(ec_index_lines(dir, pre), (l) => ec_line_variant(l) == variant) { [] -> false  _ -> true }

#[doc("Whether any non-conflicting variant is recorded under `pre`.")]
pub fn ec_index_any(dir: String, pre: String) : Bool / Console + File =
  match filter(ec_index_lines(dir, pre), (l) => list_length(ec_line_fields(l)) == 3) { [] -> false  _ -> true }

#[doc("The entry key recorded under `pre` for `variant`, when the record is not conflicting and its entry still decodes.")]
pub fn ec_index_pick(dir: String, pre: String, variant: String) : Option[String] / Console + File =
  match filter(ec_index_lines(dir, pre), (l) => ec_line_variant(l) == variant) {
    [l, ...more] -> match ec_line_fields(l) {
      [_, _, key] -> match ec_lookup(dir, key) { Some(_) -> Some(key)  None -> None }
      _ -> None
    }
    [] -> None
  }

#[doc("Record that a full compile under `pre` and `variant` produced the entry `key` whose TUs digest to `content`; a record of the variant with a different digest marks it as conflicting instead.")]
pub fn ec_index_record(dir: String, pre: String, variant: String, key: String, content: String, stats: Bool) : Unit / Console + File =
  if pre == "" { () } else {
    let lines = ec_index_lines(dir, pre)
    match filter(lines, (l) => ec_line_variant(l) == variant) {
      [l, ...more] -> match ec_line_fields(l) {
        [_, c, _] -> if c == content { () } else { ec_index_conflict(dir, pre, variant, lines, stats) }
        _ -> ()
      }
      [] -> cache_publish(ec_index_path(dir, pre),
              concat_all([string_join(ec_take([concat_all([variant, " ", content, " ", key]), ...lines], ec_index_cap()), "\n"), "\n"]))
    }
  }

fn ec_take(xs: [String], n: Int) : [String] =
  if n <= 0 { [] }
  else {
    match xs {
      []           -> []
      [h, ...rest] -> [h, ...ec_take(rest, n - 1)]
    }
  }

fn ec_index_conflict(dir: String, pre: String, variant: String, lines: [String], stats: Bool) : Unit / Console + File = {
  let _s = if stats { eprint("kaic2: core-emit-index: conflict, pruning disabled for this variant") } else { () }
  cache_publish(ec_index_path(dir, pre),
    concat_all([string_join(map(lines, (l) => if ec_line_variant(l) == variant { concat_all([variant, " conflict"]) } else { l }), "\n"), "\n"]))
}
