#[doc("""
The `default { }` block of an effect, read off the declaration a use
names by its id. A homonym elsewhere carries its own block, so the id is
what picks the ops installed, the struct they fill and the clauses a
coverage check may count on.
""")]

import compiler.ast

#[doc("The `effect` declaration whose identity is `s`; None when `s` is unset or names no effect.")]
pub fn effect_decl_of(s: SymId, decls: [Decl]) : Option[Decl] =
  if sym_raw(s) < 0 { None } else { edo_scan(sym_raw(s), decls) }

fn edo_scan(id: Int, ds: [Decl]) : Option[Decl] = match ds {
  [] -> None
  [d, ...rest] -> match d {
    DEffect(_, _, _, _, _, _, _, _, s) -> if sym_raw(s) == id { Some(d) } else { edo_scan(id, rest) }
    _ -> edo_scan(id, rest)
  }
}

#[doc("The `default { }` block an effect declaration carries; None when it carries none or is absent.")]
pub fn effect_decl_default(d: Option[Decl]) : Option[DefaultBlock] = match d {
  Some(DEffect(_, _, _, _, defblk, _, _, _, _)) -> defblk
  _ -> None
}

#[doc("True when the declaration carries a `default { }` block whose every clause bridges to `$extern_handler` — the only shape codegen installs.")]
pub fn effect_decl_default_all_extern(d: Option[Decl]) : Bool = match effect_decl_default(d) {
  Some(DBlk(clauses, _, _, _)) -> all_clauses_extern_handler(clauses)
  None -> false
}

#[doc("True when every clause body is a `$extern_handler` bridge.")]
pub fn all_clauses_extern_handler(cs: [HClause]) : Bool = match cs {
  [] -> true
  [HC(_, _, body, _, _), ...rest] -> match extern_handler_c_symbol(body) {
    None    -> false
    Some(_) -> all_clauses_extern_handler(rest)
  }
}

#[doc("The C symbol a `$extern_handler(\"c_symbol\")` body bridges to; None for any other body, a triple-quoted argument included.")]
pub fn extern_handler_c_symbol(body: Expr) : Option[String] = match body.kind {
  EIntrinsic(name, [a]) ->
    if name != "extern_handler" { None }
    else { match a.kind {
      EStr(span, is_triple) -> if is_triple { None } else { Some(strip_string_quotes(span)) }
      _ -> None
    } }
  _ -> None
}

#[doc("A string-literal span without its outer quotes; \"\" when shorter than two characters, the span unchanged when it is not quoted on both ends.")]
pub fn strip_string_quotes(span: String) : String = {
  let n = string_length(span)
  if n < 2 { "" }
  else if char_at(span, 0) == Some('"') and char_at(span, n - 1) == Some('"') {
    string_slice(span, 1, n - 2)
  } else { span }
}
