#[doc("""
The tokens the lexer produces, and the cursor it reads the source
through.
""")]



pub type TokKind
  = TkEof
  | TkNewline
  # keywords (alphabetical)
  | TkAnd | TkAs | TkAssert | TkAxiom | TkBench | TkCase | TkCheck | TkConst | TkEffect | TkElse | TkEnsures | TkExtern | TkFalse | TkFn | TkFor
  | TkHandle | TkIf | TkImpl | TkImport
  | TkLazy | TkLet | TkMatch | TkNot | TkOr | TkPriv | TkProtocol | TkPub | TkRequires | TkTest | TkTheory | TkTrue | TkType
  | TkUse | TkVar | TkWhen | TkWhere | TkWith
  # Issue #608: `#[...]` annotation form. `#[` is one token (TkHashOpen);
  # the parser then reads `ident (args)?` and expects a closing `]`.
  # Replaces the pre-#608 hard-coded `#derive`/`#unstable` reserved-word
  # scan. The `#` followed by anything other than `[` remains a comment.
  | TkHashOpen
  # m12.6.x #7: regex literal `/pattern/`, only emitted when the
  # previous non-newline token is the identifier `matches` (the
  # refinement-pure predicate). Outside that narrow context, `/` keeps
  # its arithmetic meaning as TkSlash. The token's source span covers
  # both delimiters so the parser can carve out the inner pattern with
  # `tok_source` + `string_slice`.
  | TkRegex
  # literals
  | TkInt | TkReal | TkChar | TkString
  # Fixed-width integer literals: a numeric scan followed *immediately*
  # by a width suffix (`42i32`, `42u32`, `42u64`, `42i128`). The token
  # span covers the digits AND the suffix; the parser strips the suffix
  # before decoding and pins the literal's type. `i128` keeps its
  # textual span (an EFixed node) because its value can exceed 2^63 and
  # would overflow the compiler's 64-bit decode.
  | TkInt32 | TkUInt32 | TkUInt64 | TkInt128
  # An integer literal followed *immediately* by `u8` (`200u8`) lexes as
  # TkUInt8, the surface literal for the `Byte` carrier. The span covers
  # the digits AND the suffix; the parser strips it and the typer
  # range-checks `0..255`, mirroring the `[Byte]` list-element path.
  | TkUInt8
  # A numeric literal followed *immediately* by `d` (`19.99d`, `42d`)
  # lexes as TkDecimal, the suffix form for the `Decimal` carrier. Unlike
  # the width and bigint suffixes it fires on both the integer and real
  # base. The span covers the digits AND the `d`; the parser strips it
  # and folds an exact `Decimal { raw, scale }` from the source lexeme.
  | TkDecimal
  # A decimal integer literal followed *immediately* by `n` (`99n`)
  # lexes as TkBigInt. The token span includes the trailing `n`; the
  # parser strips it and desugars to `bigint.from_literal("<digits>")`,
  # folding the digit string exactly so the suffix covers any magnitude,
  # not just the i64 range.
  | TkBigInt
  # m12.x: numeric literal followed *immediately* (no whitespace) by
  # `i` lexes as TkComplex. The token span includes the trailing `i`;
  # the parser strips it before decoding the imaginary value as Real
  # and desugars to `complex.mk(0.0, im)`. Phase 1 of #267; full
  # `Real + Complex` heterogeneous arithmetic awaits #180.
  | TkComplex
  # identifiers
  | TkIdent | TkUnderscore
  # punctuation
  | TkLparen | TkRparen | TkLbracket | TkRbracket | TkLbrace | TkRbrace
  | TkComma | TkColon | TkColonEq | TkSemi | TkDot | TkDotDot | TkEllipsis
  # operators
  | TkEq | TkArrow | TkFatArrow | TkPipe | TkPipeApply | TkBarBar | TkPipeQuestion | TkPipeEach
  | TkPlus | TkMinus | TkStar | TkSlash | TkPercent
  # m7d §23: `++` is the string / list concatenation operator.
  # Right-associative, lower precedence than `+`/`-`/`*`/`/`,
  # higher than comparison.
  | TkPlusPlus
  | TkEqEq | TkNeq | TkLt | TkGt | TkLe | TkGe
  | TkBang | TkAt | TkAmp
  # Issue #556: `$<ident>(args)` is the surface form of a compiler
  # intrinsic call. Reserved sigil; user code cannot define new
  # intrinsics. Lexer emits a bare `$` as TkDollar; the parser pairs
  # it with the following identifier to produce `EIntrinsic(name, args)`.
  | TkDollar
  # m12.5: caret used for integer power inside unit expressions, e.g.
  # `m^2`, `sec^-1`. Reserved exclusively for unit syntax — outside
  # `<...>` annotations it is a parser error.
  | TkCaret
  # typed holes (M10): TkHole is a bare `?`; TkHoleName carries the
  # identifier for `?foo`. The lexer recognises `?ident` as one token
  # so the parser does not have to re-synthesise the form.
  | TkHole | TkHoleName(String)
  # m7d §1: `todo!` is a single token. The lexer recognises the
  # `todo` identifier followed immediately by `!` as `TkTodoBang`,
  # so the parser sees one symbol at the call site.
  | TkTodoBang
  # error token carries a human-readable message
  | TkError(String)

pub type Token = { kind: TokKind, line: Int, col: Int, start: Int, length: Int }

#[doc("Convenience constructor — fewer characters at call sites.")]
pub fn tok(kind: TokKind, line: Int, col: Int, start: Int, end: Int) : Token {
  Token { kind: kind, line: line, col: col, start: start, length: end - start }
}

# Mnemonic for token kinds (for --tokens dump). Keep in sync with TokKind.
pub fn tk_name(k: TokKind) : String {
  match k {
    TkEof -> "EOF"
    TkNewline -> "NEWLINE"
    TkAnd -> "and" TkAs -> "as" TkAssert -> "assert" TkAxiom -> "axiom" TkBench -> "bench" TkCase -> "case" TkCheck -> "check" TkConst -> "const" TkEffect -> "effect" TkElse -> "else"
    TkEnsures -> "ensures"
    TkExtern -> "extern"
    TkFalse -> "false" TkFn -> "fn" TkFor -> "for" TkHandle -> "handle"
    TkIf -> "if" TkImpl -> "impl" TkImport -> "import"
    TkLazy -> "lazy" TkLet -> "let" TkMatch -> "match" TkNot -> "not" TkOr -> "or"
    TkPriv -> "priv" TkProtocol -> "protocol" TkPub -> "pub" TkRequires -> "requires"
    TkTest -> "test" TkTheory -> "theory" TkTrue -> "true" TkType -> "type"
    TkUse -> "use" TkVar -> "var" TkWhen -> "when" TkWhere -> "where" TkWith -> "with"
    TkHashOpen -> "#["
    TkRegex -> "REGEX"
    TkInt -> "INT" TkReal -> "REAL" TkChar -> "CHAR" TkString -> "STRING"
    TkInt32 -> "INT32" TkUInt32 -> "UINT32" TkUInt64 -> "UINT64" TkInt128 -> "INT128"
    TkUInt8 -> "UINT8" TkDecimal -> "DECIMAL"
    TkBigInt -> "BIGINT"
    TkComplex -> "COMPLEX"
    TkIdent -> "IDENT" TkUnderscore -> "_"
    TkLparen -> "(" TkRparen -> ")" TkLbracket -> "[" TkRbracket -> "]"
    TkLbrace -> "{" TkRbrace -> "}"
    TkComma -> "," TkColon -> ":" TkColonEq -> ":=" TkSemi -> ";"
    TkDot -> "." TkDotDot -> ".." TkEllipsis -> "..."
    TkEq -> "=" TkArrow -> "->" TkFatArrow -> "=>"
    TkPipe -> "|" TkPipeApply -> "|>" TkBarBar -> "||" TkPipeQuestion -> "|?"
    TkPipeEach -> "|!"
    TkPlus -> "+" TkMinus -> "-" TkStar -> "*" TkSlash -> "/"
    TkPercent -> "%" TkPlusPlus -> "++"
    TkEqEq -> "==" TkNeq -> "!=" TkLt -> "<" TkGt -> ">"
    TkLe -> "<=" TkGe -> ">=" TkBang -> "!" TkAt -> "@" TkAmp -> "&" TkCaret -> "^" TkDollar -> "$"
    TkHole -> "?" TkHoleName(_) -> "?NAME"
    TkTodoBang -> "todo!"
    TkError(_) -> "ERROR"
  }
}

#[doc("The source being read and the position, line and column reached in it.")]
pub type Lexer = { src: String, pos: Int, line: Int, col: Int }

#[doc("A cursor at the start of `src`.")]
pub fn lex_new(src: String) : Lexer = Lexer { src: src, pos: 0, line: 1, col: 1 }

#[doc("A token kind's case as a small integer, ignoring payloads; `-1` for `TkError`, which equals no kind.")]
pub fn tk_code(k: TokKind) : Int {
  match k {
    TkEof          -> 0
    TkNewline      -> 1
    TkAnd          -> 2
    TkAs           -> 3
    TkAssert       -> 4
    TkAxiom        -> 5
    TkBench        -> 6
    TkCase         -> 7
    TkCheck        -> 8
    TkConst        -> 9
    TkEffect       -> 10
    TkElse         -> 11
    TkEnsures      -> 12
    TkExtern       -> 13
    TkFalse        -> 14
    TkFn           -> 15
    TkFor          -> 16
    TkHandle       -> 17
    TkIf           -> 18
    TkImpl         -> 19
    TkImport       -> 20
    TkLazy         -> 21
    TkLet          -> 22
    TkMatch        -> 23
    TkNot          -> 24
    TkOr           -> 25
    TkPriv         -> 26
    TkProtocol     -> 27
    TkPub          -> 28
    TkRequires     -> 29
    TkTest         -> 30
    TkTheory       -> 31
    TkTrue         -> 32
    TkType         -> 33
    TkUse          -> 34
    TkVar          -> 35
    TkWhen         -> 36
    TkWhere        -> 37
    TkWith         -> 38
    TkInt          -> 39
    TkReal         -> 40
    TkInt32        -> 41
    TkUInt32       -> 42
    TkUInt64       -> 43
    TkInt128       -> 44
    TkUInt8        -> 45
    TkDecimal      -> 46
    TkBigInt       -> 47
    TkComplex      -> 48
    TkChar         -> 49
    TkString       -> 50
    TkIdent        -> 51
    TkUnderscore   -> 52
    TkLparen       -> 53
    TkRparen       -> 54
    TkLbracket     -> 55
    TkRbracket     -> 56
    TkLbrace       -> 57
    TkRbrace       -> 58
    TkComma        -> 59
    TkColon        -> 60
    TkColonEq      -> 61
    TkSemi         -> 62
    TkDot          -> 63
    TkDotDot       -> 64
    TkEllipsis     -> 65
    TkEq           -> 66
    TkArrow        -> 67
    TkFatArrow     -> 68
    TkPipe         -> 69
    TkPipeApply    -> 70
    TkBarBar       -> 71
    TkPipeQuestion -> 72
    TkPipeEach     -> 73
    TkPlus         -> 74
    TkMinus        -> 75
    TkStar         -> 76
    TkSlash        -> 77
    TkPercent      -> 78
    TkEqEq         -> 79
    TkNeq          -> 80
    TkLt           -> 81
    TkGt           -> 82
    TkLe           -> 83
    TkGe           -> 84
    TkBang         -> 85
    TkAt           -> 86
    TkAmp          -> 87
    TkDollar       -> 88
    TkCaret        -> 89
    TkHole         -> 90
    TkHoleName(_)  -> 91
    TkTodoBang     -> 92
    TkPlusPlus     -> 93
    TkHashOpen     -> 94
    TkRegex        -> 95
    TkError(_)     -> 0 - 1
  }
}
