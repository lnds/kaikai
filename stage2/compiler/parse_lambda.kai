#[doc("Block lambdas, trailing lambdas and the parenthesised lambda parameter scan.")]

import compiler.lex_tokens
import compiler.ast
import compiler.parse_state
import compiler.parse_types
import compiler.parse_pattern
import compiler.parse_stmt

#[doc("A parameter without a type annotation, located at a token.")]
pub fn param_at(binder: Binder, t: Token) : Param =
  Param { binder: binder, ptype: None, pline: t.line, pcol: t.col, pborrow: false }

#[doc("Skips to the `)` matching an already consumed `(` when `depth` starts at 1, stopping at end of input.")]
pub fn skip_balanced_parens(p: Parser, depth: Int) : Parser {
  let t = p_peek(p)
  if depth <= 0 or tk_is(t.kind, TkEof) { p }
  else if tk_is(t.kind, TkLparen) { skip_balanced_parens(p_advance(p), depth + 1) }
  else if tk_is(t.kind, TkRparen) { skip_balanced_parens(p_advance(p), depth - 1) }
  else { skip_balanced_parens(p_advance(p), depth) }
}

fn wrap_lam_block(lam: Expr, trailing: Bool, t: Token) : Expr =
  expr_at(ESurface(SfLamBlock(lam, trailing)), t)

fn lam_block_binder(params: [Param]) : LocalId =
  match params {
    [pm, ..._] -> pm.binder.id
    [] -> local_none()
  }

# A destructuring parameter is matched against the fresh binder in a single-arm `match`.
fn finish_block_lambda(res: LamBlockParams, body: Expr, t: Token) : Expr =
  match res.wrap {
    None -> expr_at(ELambda(res.params, body), t)
    Some(pat) -> {
      let scrut = mk_local(lam_block_binder(res.params), pat.line, pat.col)
      let m = mk_expr(EMatch(scrut, [Arm(pat, None, body)]), pat.line, pat.col)
      expr_at(ELambda(res.params, m), t)
    }
  }

#[doc("Parses the statements of a lambda block body up to its closing `}`.")]
pub fn parse_lambda_block_body(p: Parser, t: Token) : PExpr / Console =
  parse_block_body(p_skip_newlines_and_semis(p), [], t)

fn block_lambda(res: LamBlockParams, t: Token, trailing: Bool) : PExpr / Console {
  let body = parse_lambda_block_body(res.p, t)
  match body.r {
    None -> err_e(body.p)
    Some(b) -> ok_e(body.p, wrap_lam_block(finish_block_lambda(res, b, t), trailing, t))
  }
}

fn block_params_loop(p: Parser, acc: [Param]) : Option[LamBlockParams] {
  let t = p_peek(p)
  if not tk_is(t.kind, TkIdent) { None }
  else {
    let p1 = p_advance(p)
    let acc1 = [param_at(binder_written(tok_source(p.src, t)), t), ...acc]
    if p_at(p1, TkComma) { block_params_loop(p_advance_nl(p1), acc1) }
    else if p_at(p1, TkArrow) {
      Some(LamBlockParams { p: p_advance(p1), params: list_reverse(acc1), wrap: None })
    } else { None }
  }
}

# `{ (a, b) -> body }` is told from a block opening with `(a + b)` by the `->` after the matching `)`.
fn block_pattern_params(p: Parser) : Option[LamBlockParams] / Console {
  let pr = parse_pattern(p)
  match pr.r {
    None -> None
    Some(pat) -> {
      let p2 = p_skip_newlines(pr.p)
      if not p_at(p2, TkArrow) { None }
      else {
        let fresh = binder_minted(lam_pat_binder_name(pat.line, pat.col))
        let pm = Param { binder: fresh, ptype: None, pline: pat.line, pcol: pat.col, pborrow: false }
        Some(LamBlockParams { p: p_advance(p2), params: [pm], wrap: Some(pat) })
      }
    }
  }
}

fn block_lambda_params(p: Parser) : Option[LamBlockParams] / Console =
  if p_at(p, TkArrow) { Some(LamBlockParams { p: p_advance(p), params: [], wrap: None }) }
  else if p_at(p, TkIdent) { block_params_loop(p, []) }
  else if p_at(p, TkLparen) and p_at(skip_balanced_parens(p_advance(p), 1), TkArrow) { block_pattern_params(p) }
  else { None }

fn parse_trailing_lambda(p: Parser) : PExpr / Console {
  let t = p_peek(p)
  let p1 = p_advance(p)
  match block_lambda_params(p_skip_newlines(p1)) {
    Some(res) -> block_lambda(res, t, true)
    None -> block_lambda(LamBlockParams { p: p1, params: [], wrap: None }, t, true)
  }
}

fn second_trailing_lambda(p: Parser, acc: [Expr]) : PArgs / Console {
  if not p_at(p, TkLbrace) { ok_args(p, acc) }
  else {
    let r = parse_trailing_lambda(p)
    match r.r {
      None -> err_args(r.p)
      Some(lam) -> ok_args(r.p, list_append(acc, [lam]))
    }
  }
}

#[doc("Appends the one or two same-line `{ ... }` trailing lambdas at the parser to a call's arguments.")]
pub fn parse_trailing_lambdas(p: Parser, acc: [Expr]) : PArgs / Console {
  if not p_at(p, TkLbrace) { ok_args(p, acc) }
  else {
    let r = parse_trailing_lambda(p)
    match r.r {
      None -> err_args(r.p)
      Some(lam) -> second_trailing_lambda(r.p, list_append(acc, [lam]))
    }
  }
}

#[doc("Parses a `{` in expression position: a block lambda when `params ->` follows, else a block.")]
pub fn parse_brace_primary(p: Parser, t: Token) : PExpr / Console =
  match block_lambda_params(p_advance_nl(p)) {
    Some(res) -> block_lambda(res, t, false)
    None -> parse_block(p, t)
  }

fn lambda_params_if_arrow(p: Parser, acc: [Param]) : Option[LamParams] =
  if p_at(p, TkFatArrow) { Some(LamParams { p: p_advance(p), params: list_reverse(acc) }) }
  else { None }

fn typed_params_group(p: Parser, pending: [PendName], acc: [Param]) : Option[LamParams] / Console {
  let r = parse_type(p)
  match r.r {
    None -> None
    Some(te) -> {
      let acc1 = close_param_group(list_reverse(pending), te, acc)
      if p_at(r.p, TkComma) { lambda_params_loop(p_advance_nl(r.p), [], acc1) }
      else if p_at(r.p, TkRparen) { lambda_params_if_arrow(p_advance(r.p), acc1) }
      else { None }
    }
  }
}

# `pending` names await a `:` that types the group; `(a, b)` without `=>` is a tuple, so the scan fails.
fn params_after_name(p1: Parser, pending: [PendName], acc: [Param]) : Option[LamParams] / Console =
  if p_at(p1, TkComma) { lambda_params_loop(p_advance_nl(p1), pending, acc) }
  else if p_at(p1, TkColon) { typed_params_group(p_advance(p1), pending, acc) }
  else if p_at(p1, TkRparen) {
    lambda_params_if_arrow(p_advance(p1), close_param_group_untyped(list_reverse(pending), acc))
  } else { None }

fn lambda_params_loop(p: Parser, pending: [PendName], acc: [Param]) : Option[LamParams] / Console {
  let t = p_peek(p)
  if not tk_is(t.kind, TkIdent) { None }
  else {
    let name = PendName { nm: tok_source(p.src, t), nline: t.line, ncol: t.col, pborrow: false }
    params_after_name(p_advance(p), [name, ...pending], acc)
  }
}

#[doc("Scans `a, b: T, c) =>` after an opening `(`, or returns None without consuming anything.")]
pub fn try_parse_lambda_params(p: Parser) : Option[LamParams] / Console =
  lambda_params_loop(p, [], [])
