#[doc("The escape table for string and char literals, and the text scan of an interpolated string literal.")]

import compiler.util
import compiler.chars

# ====================================================================
# outcome
# ====================================================================

# Decoding either yields bytes and the offset just past the escape, or
# a message plus the offset OF THE BACKSLASH so the caret lands on the
# escape rather than on the opening quote.
pub(pkg) type EscStep = EscOk(String, Int) | EscBad(String, Int)

fn esc_max_cp() : Int = 1114111
fn esc_surrogate_lo() : Int = 55296
fn esc_surrogate_hi() : Int = 57343
fn esc_max_u_digits() : Int = 6

# ====================================================================
# small helpers
# ====================================================================

fn esc_hex_val(c: Char) : Int {
  if ch_is_digit(c) { char_to_int(c) - char_to_int('0') }
  else if c >= 'a' and c <= 'f' { char_to_int(c) - char_to_int('a') + 10 }
  else if c >= 'A' and c <= 'F' { char_to_int(c) - char_to_int('A') + 10 }
  else { 0 - 1 }
}

fn esc_char_str(c: Char) : String = int_to_byte_string(char_to_int(c))

fn esc_hex_digit(d: Int) : String =
  if d < 10 { int_to_string(d) } else { esc_hex_letter(d) }

fn esc_hex_letter(d: Int) : String {
  if d == 10 { "A" } else if d == 11 { "B" } else if d == 12 { "C" }
  else if d == 13 { "D" } else if d == 14 { "E" } else { "F" }
}

fn esc_hex_render(v: Int) : String =
  if v < 16 { esc_hex_digit(v) }
  else { string_concat(esc_hex_render(v / 16), esc_hex_digit(v % 16)) }

# ====================================================================
# the simple-escape table
# ====================================================================
#
# The ONE place a simple escape maps to its value. Both the byte
# decoder and the scalar (char-literal) decoder read it, so they cannot
# drift apart. `-1` means "not a simple escape".

fn esc_simple_val(c: Char) : Int {
  if c == 'n' { 10 }
  else if c == 't' { 9 }
  else if c == 'r' { 13 }
  else if c == '0' { 0 }
  else if c == '\\' { 92 }
  else if c == '"' { 34 }
  else if c == '\'' { 39 }
  else { 0 - 1 }
}

# The retired C escapes, each with the spelling that replaces it.
fn esc_retired_hint(c: Char) : String {
  if c == 'a' { "\\x07" }
  else if c == 'b' { "\\x08" }
  else if c == 'f' { "\\x0C" }
  else if c == 'v' { "\\x0B" }
  else { "" }
}

# ====================================================================
# UTF-8 encoding
# ====================================================================

fn esc_utf8_encode(cp: Int) : String {
  if cp < 128 { int_to_byte_string(cp) }
  else if cp < 2048 { esc_utf8_two(cp) }
  else if cp < 65536 { esc_utf8_three(cp) }
  else { esc_utf8_four(cp) }
}

fn esc_utf8_two(cp: Int) : String =
  string_concat(int_to_byte_string(192 + cp / 64),
                int_to_byte_string(128 + cp % 64))

fn esc_utf8_three(cp: Int) : String =
  concat_all([int_to_byte_string(224 + cp / 4096),
              int_to_byte_string(128 + (cp / 64) % 64),
              int_to_byte_string(128 + cp % 64)])

fn esc_utf8_four(cp: Int) : String =
  concat_all([int_to_byte_string(240 + cp / 262144),
              int_to_byte_string(128 + (cp / 4096) % 64),
              int_to_byte_string(128 + (cp / 64) % 64),
              int_to_byte_string(128 + cp % 64)])

# ====================================================================
# \u{...}
# ====================================================================

# A scanned `\u{...}` payload: the value plus the offset past the `}`,
# or a message when the form or the range is wrong.
type UScan = UOk(Int, Int) | UBad(String)

fn esc_u_range_check(acc: Int, next: Int) : UScan {
  if acc > esc_max_cp() {
    UBad(concat_all(["codepoint '\\u{", esc_hex_render(acc),
                     "}' is above the maximum U+10FFFF"]))
  }
  else if acc >= esc_surrogate_lo() and acc <= esc_surrogate_hi() {
    UBad(concat_all(["codepoint '\\u{", esc_hex_render(acc),
                     "}' is a UTF-16 surrogate and cannot be encoded as UTF-8"]))
  }
  else { UOk(acc, next) }
}

fn esc_u_digit_step(c: Char, acc: Int, digits: Int) : UScan {
  if digits >= esc_max_u_digits() {
    UBad("too many hex digits in '\\u{...}' escape: expected 1 to 6")
  }
  else {
    let v = esc_hex_val(c)
    if v < 0 {
      UBad(concat_all(["invalid hex digit '", esc_char_str(c),
                       "' in '\\u{...}' escape"]))
    }
    else { UOk(acc * 16 + v, 0) }
  }
}

fn esc_scan_u_digits(s: String, i: Int, n: Int, acc: Int, digits: Int) : UScan {
  if i >= n { UBad("unterminated '\\u{...}' escape: missing '}'") }
  else {
    match char_at(s, i) {
      None -> UBad("unterminated '\\u{...}' escape: missing '}'")
      Some(c) -> esc_u_at(s, i, n, acc, digits, c)
    }
  }
}

fn esc_u_at(s: String, i: Int, n: Int, acc: Int, digits: Int, c: Char) : UScan {
  if c == '}' { esc_u_close(acc, i + 1, digits) }
  else {
    match esc_u_digit_step(c, acc, digits) {
      UBad(m) -> UBad(m)
      UOk(acc2, _) -> esc_scan_u_digits(s, i + 1, n, acc2, digits + 1)
    }
  }
}

fn esc_u_close(acc: Int, next: Int, digits: Int) : UScan =
  if digits == 0 { UBad("empty '\\u{}' escape: expected 1 to 6 hex digits") }
  else { esc_u_range_check(acc, next) }

# `i` sits just past the `u`.
fn esc_scan_u(s: String, i: Int, n: Int) : UScan {
  match char_at(s, i) {
    Some(c) ->
      if c == '{' { esc_scan_u_digits(s, i + 1, n, 0, 0) }
      else { UBad("incomplete '\\u' escape: write '\\u{...}'") }
    None -> UBad("incomplete '\\u' escape: write '\\u{...}'")
  }
}

# ====================================================================
# \xHH — exactly two hex digits
# ====================================================================
#
# Unlike C, where `\xH...` consumes greedily and `"\x41" ++ "2"`
# differs from `"\x412"`.

type XScan = XOk(Int) | XBad(String)

fn esc_scan_x(s: String, i: Int, n: Int) : XScan {
  if i + 1 >= n { XBad("incomplete '\\x' escape: expected exactly two hex digits") }
  else { esc_scan_x_pair(char_at(s, i), char_at(s, i + 1)) }
}

fn esc_scan_x_pair(a: Option[Char], b: Option[Char]) : XScan {
  match a {
    None -> XBad("incomplete '\\x' escape: expected exactly two hex digits")
    Some(c1) -> match b {
      None -> XBad("incomplete '\\x' escape: expected exactly two hex digits")
      Some(c2) -> esc_scan_x_vals(esc_hex_val(c1), esc_hex_val(c2))
    }
  }
}

fn esc_scan_x_vals(v1: Int, v2: Int) : XScan =
  if v1 < 0 or v2 < 0 { XBad("invalid '\\x' escape: expected exactly two hex digits") }
  else { XOk(v1 * 16 + v2) }

# ====================================================================
# rejection messages for everything outside the table
# ====================================================================

fn esc_reject_msg(c: Char) : String {
  if c >= '1' and c <= '7' {
    "octal escapes are not supported; write the byte as '\\xHH'"
  }
  else if c == '?' { "escape '\\?' is not supported; write '?'" }
  else if esc_retired_hint(c) != "" {
    concat_all(["escape '\\", esc_char_str(c), "' is not supported; write '",
                esc_retired_hint(c), "'"])
  }
  else {
    concat_all(["unknown escape sequence '\\", esc_char_str(c),
                "'; write '\\\\", esc_char_str(c), "' for a literal backslash"])
  }
}

# ====================================================================
# byte decode — string literals
# ====================================================================

#[doc("Decode one escape sequence to bytes. `bs` is the backslash offset; `i` sits just past it.")]
pub(pkg) fn esc_decode_at(s: String, bs: Int, i: Int, n: Int) : EscStep {
  match char_at(s, i) {
    None -> EscBad("trailing '\\' with no escape character", bs)
    Some(c) -> esc_decode_kind(s, bs, i, n, c)
  }
}

fn esc_decode_kind(s: String, bs: Int, i: Int, n: Int, c: Char) : EscStep {
  let simple = esc_simple_val(c)
  if simple >= 0 { EscOk(int_to_byte_string(simple), i + 1) }
  else if c == 'x' {
    match esc_scan_x(s, i + 1, n) {
      XOk(v) -> EscOk(int_to_byte_string(v), i + 3)
      XBad(m) -> EscBad(m, bs)
    }
  }
  else if c == 'u' {
    match esc_scan_u(s, i + 1, n) {
      UOk(cp, next) -> EscOk(esc_utf8_encode(cp), next)
      UBad(m) -> EscBad(m, bs)
    }
  }
  else { EscBad(esc_reject_msg(c), bs) }
}

# Pieces are gathered newest-first and joined once at the end. One
# self-recursive loop: a call into a sibling is not a tail call once
# drops follow it, and a literal holds as many escapes as it likes.
fn esc_decode_loop(s: String, i: Int, n: Int, acc: [String]) : EscStep {
  if i >= n { EscOk(concat_all(list_reverse(acc)), i) }
  else {
    match char_at(s, i) {
      None -> EscOk(concat_all(list_reverse(acc)), i)
      Some(c) ->
        if c != '\\' { esc_decode_loop(s, i + 1, n, [byte_str(c), ...acc]) }
        else { match esc_decode_at(s, i, i + 1, n) {
          EscOk(bytes, next) -> esc_decode_loop(s, next, n, [bytes, ...acc])
          EscBad(msg, at) -> EscBad(msg, at)
        } }
    }
  }
}

#[doc("Decode every escape in `s[start..end)`, yielding the literal bytes.")]
pub(pkg) fn esc_decode_body(s: String, start: Int, end: Int) : EscStep =
  esc_decode_loop(s, start, end, [])

# ====================================================================
# scalar decode — char literals
# ====================================================================
#
# Same table, different output: a char literal names the scalar value
# directly, so `'\u{2603}'` is U+2603 rather than its three UTF-8 bytes.
# The lexer has already rejected anything outside the table.

#[doc("Decode the escape at `i` (just past the backslash) to a scalar value.")]
pub(pkg) fn esc_decode_scalar_at(s: String, i: Int, n: Int) : Option[Int] {
  match char_at(s, i) {
    None -> None
    Some(c) -> esc_scalar_kind(s, i, n, c)
  }
}

fn esc_scalar_kind(s: String, i: Int, n: Int, c: Char) : Option[Int] {
  let simple = esc_simple_val(c)
  if simple >= 0 { Some(simple) }
  else if c == 'x' {
    match esc_scan_x(s, i + 1, n) { XOk(v) -> Some(v)  XBad(_) -> None }
  }
  else if c == 'u' {
    match esc_scan_u(s, i + 1, n) { UOk(cp, _) -> Some(cp)  UBad(_) -> None }
  }
  else { None }
}

#[doc("One part of a string span: a literal piece (as written, and as the string literal that holds it) or the source of a `#{...}` body.")]
#[derive(BinSerialize)]
pub(pkg) type IPart = IpLit(String, String) | IpExp(String)

# The parts so far, in reverse; where the current literal piece starts; the cursor.
type IScan = { parts: [IPart], lit_start: Int, i: Int }

#[doc("A position in the source a string literal is written in.")]
pub(pkg) type InterpPos = { line: Int, col: Int }

#[doc("The parts of `span` between the opening and closing quotes, in source order.")]
pub(pkg) fn interp_parts(span: String, is_triple: Bool) : [IPart] {
  let lead = interp_lead(is_triple)
  iscan_collect(span, string_length(span) - lead, IScan { parts: [], lit_start: lead, i: lead })
}

#[doc("True when the literal `span` holds a `#{...}` body.")]
pub(pkg) fn span_interpolates(span: String, is_triple: Bool) : Bool {
  let lead = interp_lead(is_triple)
  has_interp(span, lead, string_length(span) - lead)
}

#[doc("The width of the quote that opens a literal: three for `\"\"\"`, else one.")]
pub(pkg) fn interp_lead(is_triple: Bool) : Int = if is_triple { 3 } else { 1 }

fn raw_lit_for_c(piece: String) : String =
  cat3("\"", escape_str_body_for_c(piece), "\"")

fn iscan_collect(span: String, end: Int, st: IScan) : [IPart] =
  list_reverse(iscan_collect_rev(span, end, st))

fn iscan_collect_rev(span: String, end: Int, st: IScan) : [IPart] {
  if st.i >= end { finish_iscan_rev(span, end, st) }
  else if iscan_opens(span, st.i, end) {
    let expr_start = st.i + 2
    let expr_end = iscan_expr_end(span, expr_start, end, 1)
    let parts = [IpExp(string_slice(span, expr_start, expr_end - expr_start)), ...iscan_flush(span, st)]
    let next_i = if expr_end < end { expr_end + 1 } else { expr_end }
    iscan_collect_rev(span, end, IScan { parts: parts, lit_start: next_i, i: next_i })
  }
  else { iscan_collect_rev(span, end, IScan { ...st, i: st.i + 1 }) }
}

fn iscan_opens(span: String, i: Int, end: Int) : Bool =
  i + 1 < end and char_at(span, i) == Some('#') and char_at(span, i + 1) == Some('{')

# The literal piece that ends at the cursor, prepended to the parts.
fn iscan_flush(span: String, st: IScan) : [IPart] =
  if st.i > st.lit_start {
    let piece = string_slice(span, st.lit_start, st.i - st.lit_start)
    [IpLit(piece, raw_lit_for_c(piece)), ...st.parts]
  } else { st.parts }

fn iscan_expr_end(span: String, i: Int, end: Int, depth: Int) : Int =
  if depth == 0 or i >= end { i }
  else {
    match char_at(span, i) {
      None      -> i
      Some('{') -> iscan_expr_end(span, i + 1, end, depth + 1)
      Some('}') -> if depth == 1 { i } else { iscan_expr_end(span, i + 1, end, depth - 1) }
      _         -> iscan_expr_end(span, i + 1, end, depth)
    }
  }

fn finish_iscan_rev(span: String, end: Int, st: IScan) : [IPart] =
  iscan_flush(span, IScan { ...st, i: end })

#[doc("Where the body of a `#{...}` that opens at `p` starts.")]
pub(pkg) fn interp_pos_body(p: InterpPos) : InterpPos = InterpPos { line: p.line, col: p.col + 2 }

#[doc("The position after the `}` that closes a body `src` starting at `body`.")]
pub(pkg) fn interp_pos_past(body: InterpPos, src: String) : InterpPos {
  let after = interp_pos_advance(body, src, 0)
  InterpPos { line: after.line, col: after.col + 1 }
}

#[doc("`p` moved past `s` from index `i` on. A triple-quoted literal spans lines, and a newline starts the next one at column 1.")]
pub(pkg) fn interp_pos_advance(p: InterpPos, s: String, i: Int) : InterpPos =
  if i >= string_length(s) { p }
  else {
    let nxt = if char_at(s, i) == Some('\n') { InterpPos { line: p.line + 1, col: 1 } }
              else { InterpPos { line: p.line, col: p.col + 1 } }
    interp_pos_advance(nxt, s, i + 1)
  }
