#[doc("Typer-internal helper `apply_label_args` shared across the infer modules.")]
pub fn apply_label_args(s: Subst, l: Label) : Label = match apply_label_args_opt(s, l) {
  None     -> l
  Some(l1) -> l1
}


#[doc("Typer-internal helper `synth_dim_pow` shared across the infer modules.")]
pub fn synth_dim_pow(st: InferState, lt: Ty, le: Expr,
                  rt: Ty, re: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  # The exponent of `^` is always Int — pin it. We probe with a
  # targeted diagnostic so `r ^ 3.0` or `r ^ "a"` say "exponent of `^`
  # must be Int" instead of leaking the generic unifier's
  # expected/found ordering (the previous
  # `st_unify(rt, TyInt, ...)` passed args in the wrong order and
  # reported "expected: Real, found: Int" when the user wrote
  # `Real ^ Real`).
  let rt_now = apply_ty(st.sub, rt)
  let s1 = match unify_env(st.env, rt_now, TyInt, st.sub) {
    Some(s2) -> st_set_sub(st, s2)
    None -> {
      let perr = mk_diag(SevError, st.file, line, col,
        "exponent of `^` must be Int", [])
      st_bump_err(st_help(st_note(st_push_diag(st, perr), string_concat("found: ", inf_ty_to_string(st.env.tab, rt_now))), "convert the exponent to Int (e.g. `real_to_int(x)`), or use a stdlib helper like `Numeric.pow_int(base, n)` if the integer exponent is available separately"))
    }
  }
  let ls = ty_split_dim(apply_ty(s1.sub, lt), s1.sub)
  let lit = try_int_literal(re)
  match lit {
    Some(n) -> {
      # Literal exponent: lift the unit. `unit_canon` simplifies
      # `m^0` → 1 and `m^1` → m so trivial cases collapse cleanly.
      let new_unit = unit_canon(UPow(ls.dim, n))
      let s2 = st_check_atomic_unit(s1, BoPow, new_unit, line, col)
      let ty = dim_collapse(apply_ty(s2.sub, ls.base), new_unit)
      mk_inferred(s2, ty, binop_root(BoPow, le, re, line, col, ty))
    }
    None -> {
      # Non-literal exponent. Only safe when the base has a trivial
      # unit; otherwise we would owe a dependent type.
      let canon_dim = unit_canon(ls.dim)
      if not unit_is_one(canon_dim) {
        let perr = mk_diag(SevError, st.file, line, col,
          "operator `^` requires a literal Int exponent when the base has a non-trivial unit", [])
        let ty = apply_ty(s1.sub, ls.base)
        mk_inferred(st_bump_err(st_help(st_push_diag(s1, perr), "annotate the exponent as a literal (e.g. `r ^ 3`) or strip the unit on the base before the call")), ty, binop_root(BoPow, le, re, line, col, ty))
      } else {
        # Bare numeric base: result keeps the base type.
        let ty = apply_ty(s1.sub, ls.base)
        mk_inferred(s1, ty, binop_root(BoPow, le, re, line, col, ty))
      }
    }
  }
}


# Primitive arithmetic never succeeds on a String operand (the runtime
# add/sub/mul/div traps on non-numeric payloads), so reject it at the
# operator. The dim wrapper is stripped first, so a String-carrier
# monetary value hits this exactly like a bare String.
#[doc("Typer-internal helper `st_check_arith_string` shared across the infer modules.")]
pub fn st_check_arith_string(st: InferState, op: BinOp, t: Ty,
                         line: Int, col: Int) : InferState / Console + File + Mutable {
  let split = ty_split_dim(t, st.sub)
  match split.base {
    TyString -> {
      let perr = mk_diag(SevError, st.file, line, col,
        concat_all(["arithmetic operator `", binop_text(op),
                    "` requires a numeric operand, found `String`"]), [])
      st_bump_err(st_help(st_push_diag(st, perr), "string concatenation is `++`"))
    }
    _ -> st
  }
}


#[doc("Typer-internal helper `synth_dim_mul_div` shared across the infer modules.")]
pub fn synth_dim_mul_div(st: InferState, op: BinOp, lt: Ty, le: Expr,
                     rt: Ty, re: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let ls = ty_split_dim(lt, st.sub)
  let rs = ty_split_dim(rt, st.sub)
  let what = string_concat("arithmetic operator '", string_concat(binop_text(op), "'"))
  let s0 = st_check_arith_string(st, op, lt, line, col)
  let s1 = st_unify(s0, ls.base, rs.base, what, line, col)
  let combined = if binop_eq(op, BoMul) {
    UMul(ls.dim, rs.dim)
  } else {
    UMul(ls.dim, UInv(rs.dim))
  }
  let s2 = st_check_atomic_unit(s1, op, combined, line, col)
  let ty = dim_collapse(apply_ty(s2.sub, ls.base), unit_canon(combined))
  mk_inferred(s2, ty, binop_root(op, le, re, line, col, ty))
}


# `++` typer. Two hardcoded rules:
#   String ++ String  : String
#   [a]    ++ [a]     : [a]
# We probe the lhs's resolved type first; if it is a TyVar we fall
# back to the rhs's resolved type (mirror case). If neither side
# pins the operator, we report a targeted diagnostic — the
# concatenation operator is intentionally not generic, the way `+`
# is intentionally not overloaded for strings.
#[doc("Typer-internal helper `synth_concat` shared across the infer modules.")]
pub fn synth_concat(st: InferState, lt: Ty, le: Expr, rt: Ty, re: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let lt_now = apply_ty(st.sub, lt)
  match lt_now {
    TyString -> concat_finish(st, TyString, lt, le, rt, re, line, col)
    TyListT(elem) -> concat_finish(st, TyListT(elem), lt, le, rt, re, line, col)
    _ -> {
      let rt_now = apply_ty(st.sub, rt)
      match rt_now {
        TyString -> concat_finish(st, TyString, lt, le, rt, re, line, col)
        TyListT(elem) -> concat_finish(st, TyListT(elem), lt, le, rt, re, line, col)
        _ -> {
          let perr = mk_diag(SevError, st.file, line, col,
            "operator `++` requires both operands to be `String` or both to be `[T]`", [])
          mk_inferred(st_bump_err(st_help(st_push_diag(st, perr), "annotate one of the operands so the compiler can pick the right rule")), TyAny,
            with_ty(mk_expr(EBinop(BoConcat, le, re), line, col), TyAny))
        }
      }
    }
  }
}


fn concat_finish(st: InferState, target: Ty, lt: Ty, le: Expr, rt: Ty, re: Expr, line: Int, col: Int) : Inferred / Console + File + Mutable {


  let s1 = st_unify(st, lt, target, "concat operator", line, col)
  let s2 = st_unify(s1, rt, target, "concat operator", line, col)
  let result_ty = apply_ty(s2.sub, target)
  let root = with_ty(mk_expr(EBinop(BoConcat, le, re), line, col), result_ty)
  mk_inferred(s2, result_ty, root)
}


# An annotated parameter pins to its own type: a clash with the domain is
# the call's to report.
#[doc("Typer-internal helper `expected_pins` shared across the infer modules.")]
pub fn expected_pins(st: InferState, ps: [Param], doms: [Ty]) : [Ty] = match ps {
  [] -> []
  [pm, ...rest] -> match doms {
    [] -> []
    [d, ...more] -> {
      let pin = match pm.ptype { Some(te) -> st_annot_ty(st, te)  None -> d }
      [pin, ...expected_pins(st, rest, more)]
    }
  }
}


#[doc("Typer-internal helper `pin_params` shared across the infer modules.")]
pub fn pin_params(st: InferState, tys: [Ty], pins: [Ty], why: String, line: Int, col: Int) : InferState / Console + File + Mutable =
  match tys {
    [t, ...rest] -> match pins {
      [p, ...more] -> pin_params(st_unify(st, t, p, why, line, col), rest, more, why, line, col)
      [] -> st
    }
    [] -> st
  }


# A signature row variable the lambda body performs is part of the
# lambda's own row. An inference variable is not joined: it may still
# bind to labels the lambda already carries, and rows keep duplicates.
#[doc("Typer-internal helper `join_tails` shared across the infer modules.")]
pub fn join_tails(st: InferState, tail: Int, us: [TailUse], every: Bool, line: Int, col: Int) : InferState / Console + File + Mutable = match us {
  [] -> st
  [TU(t, _, _), ...rest] -> {
    let root = row_root(st.sub, t)
    let st1 = if root < 0 or root == row_root(st.sub, tail) or not (every or is_sig_row(st.sub, st.sig_rows, root)) { st }
              else { st_unify(st, row_arg_carrier(row_with_tail(tail)), row_arg_carrier(row_with_tail(root)), "lambda effect row", line, col) }
    join_tails(st1, tail, rest, every, line, col)
  }
}


#[doc("The stage's parameter type when it takes the piped container but not its element: the `|` versus `|>` confusion.")]
pub fn pipe_stage_wants_container(env: TyEnv, sub: Subst, lhs_ty: Ty,
                                  stage_ty: Ty, elem: Option[Ty]) : Option[Ty] / Mutable =
  match apply_ty(sub, stage_ty) {
    TyFnT([p], _ret, _row) -> {
      let param = apply_ty(sub, p)
      let takes_elem = stage_takes_elem(env, sub, param, elem)
      if ty_is_flexible(param) or takes_elem { None }
      else if unify_ok(env, param, apply_ty(sub, lhs_ty), sub) { Some(apply_ty(sub, param)) }
      else { None }
    }
    _ -> None
  }

# The element trial comes first: unification mutates the shared substitution,
# so trying the container first would bind a stage metavariable to it and
# poison the trial that decides. An open param (a bare lambda's) unifies with
# the container for free and is no evidence the user meant apply.
fn stage_takes_elem(env: TyEnv, sub: Subst, param: Ty, elem: Option[Ty]) : Bool / Mutable =
  match elem {
    Some(et) -> unify_ok(env, param, apply_ty(sub, et), sub)
    None -> false
  }

fn unify_ok(env: TyEnv, a: Ty, b: Ty, sub: Subst) : Bool / Mutable =
  match unify_env(env, a, b, sub) {
    Some(_) -> true
    None -> false
  }


# `|!` runs its stage for effect, so the stage returns `Unit`, checked at
# the pipe rather than trusted to the owner's `each`. A rejected stage
# reads as `TyAny` so the call adds no second diagnostic.
#[doc("Typer-internal helper `each_stage_checked` shared across the infer modules.")]
pub fn each_stage_checked(pop: PipeOp, rf: Inferred, line: Int, col: Int) : Inferred / Console + File + Mutable =
  match pop {
    PoEach -> match apply_ty(rf.st.sub, rf.ty) {
      TyFnT(_, ret, _) -> match unify_env(rf.st.env, ret, TyUnit, rf.st.sub) {
        Some(s) -> mk_inferred(st_set_sub(rf.st, s), rf.ty, rf.expr)
        None    -> {
          let perr = mk_diag(SevError, rf.st.file, line, col,
            concat_all(["`|!` runs its stage for effect; the stage returns `",
              inf_ty_to_string(rf.st.env.tab, apply_ty(rf.st.sub, ret)),
              "`, not `Unit`. Use `|` to transform, or `|> ignore` the result."]), [])
          mk_inferred(st_bump_err(st_push_diag(rf.st, perr)), TyAny, rf.expr)
        }
      }
      _ -> rf
    }
    _ -> rf
  }


# Map-map deforestation (issue #1134). When an already-lowered `map`
# stage feeds another `map` stage and both stage closures are pure,
# collapse `map(map(xs, f), g)` into `map(xs, x => g(f(x)))` — one
# traversal, one result list, zero intermediates. Types are already
# resolved here; the composed lambda is built typed (never re-synthesised)
# so the shared, in-place-mutated substitution is not forked. Any other
# `op`, an impure stage, or a non-map LHS leaves the call untouched.
#[doc("Typer-internal helper `try_fuse_map_pipe` shared across the infer modules.")]
pub fn try_fuse_map_pipe(st: InferState, cf: CoreFn, callee: Expr,
                     lhs: Expr, stage: Expr, ty: Ty,
                     line: Int, col: Int) : FusedPipe {
  let unfused = with_ty(mk_expr(ECall(callee, [lhs, stage]), line, col), ty)
  let candidate = match cf { CfPipeMap -> pipe_fusion_as_map_call(lhs)  _ -> None }
  match candidate {
    None -> FusedPipe { root: unfused, st: st }
    Some(inner) ->
      if fuse_stages_pure(st.sub, inner.stage, stage) {
        fuse_emit(st, callee, inner, stage, ty, line, col)
      } else { FusedPipe { root: unfused, st: st } }
  }
}


# Both stage closures must be pure to reorder them. Reads the resolved
# effect row off each `TyFnT`; an unresolved tail is fine (lambdas are
# always open-tailed), only realised labels outside `{Mutable}` block.
fn fuse_stages_pure(sub: Subst, inner_stage: Expr, outer_stage: Expr) : Bool =
  fuse_stage_pure(sub, inner_stage) and fuse_stage_pure(sub, outer_stage)


#[doc("Typer-internal helper `fuse_stage_pure` shared across the infer modules.")]
pub fn fuse_stage_pure(sub: Subst, stage: Expr) : Bool =
  match pipe_fusion_fn_row(apply_ty(sub, fuse_expr_ty(stage))) {
    None      -> false
    Some(row) -> pipe_fusion_labels_pure(apply_row(sub, row).labels)
  }


# Emit the fused `map(source, compose(inner, outer))`, threading the
# fresh row tail the composed lambda needs into the substitution.
fn fuse_emit(st: InferState, callee: Expr, inner: FusedMapCall,
             stage: Expr, ty: Ty, line: Int, col: Int) : FusedPipe {
  let fr = subst_fresh_row(st.sub)
  let tys = fuse_types(fr.subst, inner.stage, stage, fr.id)
  let lam = pipe_fusion_compose(inner.stage, stage, tys, line, col)
  let fused = with_ty(mk_expr(ECall(callee, [inner.source, lam]), line, col), ty)
  FusedPipe { root: fused, st: st_set_sub(st, fr.subst) }
}


# Project the composed lambda's types off the resolved stage types:
# parameter = inner domain, mid = inner codomain, result = outer
# codomain, row = merged concrete labels under a fresh tail.
fn fuse_types(sub: Subst, inner: Expr, outer: Expr, tail: Int) : FuseTypes {
  let it = apply_ty(sub, fuse_expr_ty(inner))
  let ot = apply_ty(sub, fuse_expr_ty(outer))
  let row = Row { labels: label_concat(fuse_row_labels(sub, it), fuse_row_labels(sub, ot)),
                  tail: Some(tail), display_alias: None }
  FuseTypes { param: fuse_fn_domain(it), mid: fuse_fn_codomain(it),
              result: fuse_fn_codomain(ot), row: row }
}


fn fuse_row_labels(sub: Subst, t: Ty) : [Label] =
  match pipe_fusion_fn_row(t) {
    None      -> []
    Some(row) -> apply_row(sub, row).labels
  }


# The terminal of a chain with the callee the resolver left written
# settled, since the chain is recognised by the declaration its terminal
# reaches. A name one declaration answers is read as any callee is. One
# several functions share is read as applied to a list: the terminals
# that fuse by name are list functions, and any other choice is left to
# the call the unfused chain makes.
#[doc("Typer-internal helper `terminal_settled` shared across the infer modules.")]
pub fn terminal_settled(st: InferState, rhs: Expr) : Expr = match rhs.kind {
  ECall(f, xs) -> Expr { ...rhs, kind: ECall(terminal_callee(st, f), xs) }
  _            -> terminal_callee(st, rhs)
}


fn terminal_callee(st: InferState, f: Expr) : Expr = match f.kind {
  EName(w) -> match terminal_fn(st, w) {
    Some(s) -> Expr { ...f, kind: ESym(s, spec_none()) }
    None    -> f
  }
  _ -> f
}


fn terminal_fn(st: InferState, w: Written) : Option[SymId] = {
  let cs = bare_fn_candidates(st, w)
  if list_length(cs) > 1 { hom_choose(hom_cands_of(cs), TyListT(TyAny)) }
  else { match settle_name(st, None, w, TyAny, [NCFn]) {
    SetOne(s) -> Some(s)
    _         -> None
  } }
}


#[doc("Typer-internal helper `fuse_row_strict` shared across the infer modules.")]
pub fn fuse_row_strict(sub: Subst, stage: Expr) : Bool =
  match pipe_fusion_fn_row(apply_ty(sub, fuse_expr_ty(stage))) {
    None      -> false
    Some(row) -> match apply_row(sub, row).labels {
      [] -> true
      _  -> false
    }
  }


#[doc("Typer-internal helper `mask_local_mutable_demand` shared across the infer modules.")]
pub fn mask_local_mutable_demand(st: InferState, params: [Param], body: Expr) : InferState {
  if not labels_contain_mutable(st.row) { st }
  else {
    let body_resolved = finalise_typed_expr(st.sub, body)
    match external_demand(body_resolved, mut_scan(st, params, body_resolved)) {
      None    -> st_drop_effect(st, CeMutable)
      Some(_) -> st
    }
  }
}


fn param_cap_effects(st: InferState, ids: [LocalId]) : [SymId] = match ids {
  []           -> []
  [i, ...rest] -> match cap_effect_of_local(st, i) {
    Some(e) -> [e, ...param_cap_effects(st, rest)]
    None    -> param_cap_effects(st, rest)
  }
}


# A capability a parameter provides is not demanded of the scope that owns it.
#[doc("Typer-internal helper `st_drop_provided_caps` shared across the infer modules.")]
pub fn st_drop_provided_caps(st: InferState, params: [Param]) : InferState = {
  let effs = param_cap_effects(st, mut_collect_param_ids(params, []))
  let provided = (l: Label) => local_eq(l.cell, capture_cell()) and any(effs, (e) => sym_same(e, l.sym))
  InferState { ...st, row: filter(st.row, (h) => not provided(h)),
               eff_uses: filter(st.eff_uses, (u) => match u { EU(l, _, _) -> not provided(l) }) }
}


# A literal list or constructor call is checked part by part as it is
# built, and a lambda's result in its own body; anything else carries
# its refinements inside generic types only where variance allows.
#[doc("Typer-internal helper `refine_flow` shared across the infer modules.")]
pub fn refine_flow(m: MintedExpr, want: Ty, what: String, line: Int, col: Int) : MintedExpr / Console + File + Mutable = {
  let e = m.pair.expr
  let built = match e.kind {
    EList(_)      -> true
    ECall(c, _)   -> callee_is_ctor(m.st.env.tab, c)
    _             -> false
  }
  if built { m } else {
    let have = apply_ty(m.st.sub, m.pair.ty)
    let target = match e.kind {
      ELambda(_, _) -> rf_keep_result(want, have)
      _             -> want
    }
    match rv_flow(st_ty_defs(m.st), have, target) {
      None       -> m
      Some(miss) -> MintedExpr { st: refine_narrow_error(m.st, miss, have, target, what, line, col, call_widened_note(m.st, e)), pair: m.pair }
    }
  }
}


fn call_widened_note(st: InferState, e: Expr) : String = match e.kind {
  ECall(c, args_) -> match c.ty {
    Some(TyFnT(ps, _, _)) -> widened_note(args_, rv_call_binds(ps, map(args_, (a) => apply_ty(st.sub, typed_ty_or(a, TyAny)))))
    _                     -> ""
  }
  _ -> ""
}


# A declared refinement survives instantiation, while a type variable
# binds to an unrefined type, so a callee's own type tells which of
# its parameters can owe one; only a callee still unknown is resolved.
#[doc("Typer-internal helper `fn_param_tys` shared across the infer modules.")]
pub fn fn_param_tys(st: InferState, t: Ty) : [Ty] = match t {
  TyFnT(ps, _, _) -> ps
  TyVarT(_)       -> match apply_ty(st.sub, t) {
    TyFnT(ps, _, _) -> ps
    _               -> []
  }
  _ -> []
}


#[doc("Typer-internal helper `refine_call` shared across the infer modules.")]
pub fn refine_call(st: InferState, callee: Expr, callee_ty: Ty, args_: [Expr], arg_tys: [Ty], ty: Ty) : RefCall / Console + File + Mutable = match callee_ty {
  TyFnT(ps, ret, _) ->
    if not (rc_mentions(ret) or rc_any_mentions_in(st.sub, arg_tys) or rc_any_mentions_in(st.sub, ps)) { RefCall(st, ty) }
    else {
      let have = zip_with(args_, arg_tys, (a, t) => lambda_have(st, a, apply_ty(st.sub, t)))
      let binds = rv_call_binds(ps, have)
      let wants = map(ps, (p) => apply_ty(st.sub, rc_subst(p, rv_pairs_of(binds))))
      let st1 = refine_args_flow(st, args_, have, wants, binds, 1, callee_label(st, callee))
      let refined = if binds == [] and not rc_mentions(ret) { ty } else { apply_ty(st1.sub, rc_subst(ret, rv_pairs_of(binds))) }
      RefCall(st1, refined)
    }
  _ -> RefCall(st, ty)
}


# A lambda's own type has its result unified, refinements peeled; its
# body's type still carries what the body returns.
fn lambda_have(st: InferState, a: Expr, t: Ty) : Ty = match a.kind {
  ELambda(_, body) -> match t {
    TyFnT(ps, r, row) -> TyFnT(ps, apply_ty(st.sub, typed_ty_or(expr_tail(body), r)), row)
    _                 -> t
  }
  _ -> t
}


#[doc("Typer-internal helper `ctor_fresh_sig` shared across the infer modules.")]
pub fn ctor_fresh_sig(env: TyEnv, c: Expr) : Ty = match c.kind {
  ESym(s, _) -> match env_sym(env, s) {
    Some(sc) -> instantiate(env, sc).ty
    None     -> TyAny
  }
  _ -> TyAny
}


# validate `name : T` against the scrutinee type.
# Two scrutinee shapes are accepted:
#   - `TyUnion(parts)` (first-class union form, not currently produced
#     anywhere in stage 2 but kept symmetric for forward compat).
#   - a `TyCon` whose union row lists the narrow type as a component
#     (the dual-representation path: `type T = A | B` registers `A`
#     and `B` as zero-arg variants of `T`, their names validated
#     against pre-declared types by `validate_union_collisions`).
#[doc("Typer-internal helper `check_narrow_pattern` shared across the infer modules.")]
pub fn check_narrow_pattern(st: InferState, name: Binder, ty_expr: TypeExpr,
                         expected: Ty, line: Int, col: Int) : InferState / Console + File {


  let narrow_ty = st_annot_ty(st, ty_expr)
  let scrut_now = apply_ty(st.sub, expected)
  match scrut_now {
    TyUnion(parts) -> if ty_list_contains(parts, narrow_ty) {
      let env2 = env_bind_local(st.env, name, mono(narrow_ty))
      st_set_env(st, env2)
    } else {
      let env2 = env_bind_local(st.env, name, mono(narrow_ty))
      st_set_env(not_a_component(st, narrow_ty, scrut_now, line, col), env2)
    }
    TyCon(u_sym, _) -> {
      if ut_lists(st.env.unions, u_sym, ut_ty_sym(narrow_ty)) {
        let env2 = env_bind_local(st.env, name, mono(narrow_ty))
        st_set_env(st, env2)
      } else {
        let env2 = env_bind_local(st.env, name, mono(narrow_ty))
        st_set_env(not_a_component(st, narrow_ty, scrut_now, line, col), env2)
      }
    }
    _ -> {
      let msg = "type-narrowing pattern `#{name.name} : #{inf_ty_to_string(st.env.tab, narrow_ty)}` requires a union scrutinee, found `#{inf_ty_to_string(st.env.tab, scrut_now)}`"
      let env2 = env_bind_local(st.env, name, mono(narrow_ty))
      st_set_env(st_bump_err(st_push_diag(st, mk_diag(SevError, st.file, line, col, msg, []))), env2)
    }
  }
}


fn not_a_component(st: InferState, narrow_ty: Ty, scrut_now: Ty, line: Int, col: Int) : InferState = {
  let msg = "type-narrowing pattern targets `#{inf_ty_to_string(st.env.tab, narrow_ty)}`, which is not a component of `#{inf_ty_to_string(st.env.tab, scrut_now)}`"
  st_bump_err(st_help(st_push_diag(st, mk_diag(SevError, st.file, line, col, msg, [])),
                      "the narrow type must appear as one of the union's components, declared via `type T = A | B`"))
}


# A hole in pattern position behaves like PWild at runtime (matches
# anything, binds nothing) but additionally registers a HoleSite so
# the report surfaces the expected pattern type and the scope. For
# named pattern holes we reuse the same name-sharing rule as the
# expression form: two `?x` in the same decl unify to one TyVar.
#[doc("Typer-internal helper `check_hole_pattern` shared across the infer modules.")]
pub fn check_hole_pattern(st: InferState, nm_opt: Option[String], expected: Ty, line: Int, col: Int) : InferState / Console + File + Mutable {


  let expected_now = apply_ty(st.sub, expected)
  match nm_opt {
    Some(nm) -> match find_hole_by_name(st.holes, nm) {
      Some(prior_fresh) -> st_unify(st, TyVarT(prior_fresh), expected_now, "pattern hole", line, col)
      None -> register_fresh_pattern_hole(st, nm_opt, expected_now, line, col)
    }
    None -> register_fresh_pattern_hole(st, nm_opt, expected_now, line, col)
  }
}


fn register_fresh_pattern_hole(st: InferState, nm_opt: Option[String], expected: Ty, line: Int, col: Int) : InferState / Console + File + Mutable {


  let fresh_id = st.env.fresh
  let st1 = st_set_env(st, fresh_var(st.env))
  let site = HS(HKPattern(nm_opt, None), line, col, fresh_id, st1.env.entries, st1.env.fresh, [])
  let st2 = st_push_hole(st1, site)
  st_unify(st2, TyVarT(fresh_id), expected, "pattern hole", line, col)
}


# The constructor a variant pattern names. A reference born settled is
# that constructor. A written one is decided by the scrutinee's type:
# this is how a user variant `Response.Ok` shadows the core `Result.Ok`
# in patterns matching a `Response`. A scrutinee whose type declares no
# such constructor leaves the name to its qualifier, then to the scope.
#[doc("Typer-internal helper `pattern_ctor` shared across the infer modules.")]
pub fn pattern_ctor(st: InferState, r: DeclRef, expected: Ty) : Settled = match r {
  DrSym(c)        -> SetOne(c)
  DrWritten(q, w) -> settle_name(st, q, w, expected, [NCCtor])
}


# The record a `Name { … }` head names, in a literal or a pattern. A bare
# name is the expected type's record when that type is a record so named;
# else it climbs the reader's scope over the records of the name, where a
# type that is no record is no candidate. A name no record answers is
# read as a type name is, for the diagnostics about it.
fn record_head(st: InferState, r: DeclRef, expected: Ty) : Settled = match r {
  DrSym(s)              -> SetOne(s)
  DrWritten(Some(_), _) -> settle_sym(ref_ty_sym(st_home_view(st), r))
  DrWritten(None, w)    -> {
    let name = written_text(w)
    let t = ut_ty_sym(apply_ty(st.sub, expected))
    if record_named(st, t, name) { SetOne(t) }
    else { match rh_on_ladder(st.env.tab, st_scope(st), st.recs, name) {
      SvSym(s)    -> SetOne(s)
      SvAmbig(ss) -> SetTie(ss)
      _           -> settle_sym(ref_ty_sym(st_home_view(st), r))
    } }
  }
}


#[doc("Typer-internal helper `record_head_sym` shared across the infer modules.")]
pub fn record_head_sym(st: InferState, r: DeclRef, expected: Ty, line: Int, col: Int) : RecHead / Console + File =
  match record_head(st, r, expected) {
    SetOne(s)  -> RecHead { st: st, sym: Some(s) }
    SetTie(ss) -> RecHead { st: report_tie(st, ref_text(st.env.tab, r), ss, false, line, col), sym: None }
    _          -> RecHead { st: st, sym: None }
  }


# The open rows a range bound calls through: one of the enclosing
# signature is an effect, any other is closed.
#[doc("Typer-internal helper `lazy_close_tails` shared across the infer modules.")]
pub fn lazy_close_tails(st: InferState, us: [TailUse], at: Expr) : InferState / Console + File + Mutable = match us {
  [] -> st
  [TU(t, _, _), ...rest] -> {
    let root = row_root(st.sub, t)
    let st1 = if root < 0 { st }
              else if is_sig_row(st.sub, st.sig_rows, root) { lazy_impure(st, [], at) }
              else { st_unify(st, row_arg_carrier(row_with_tail(root)), row_arg_carrier(Row { labels: [], tail: None, display_alias: None }),
                              "lazy sequence", at.line, at.col) }
    lazy_close_tails(st1, rest, at)
  }
}


#[doc("Typer-internal helper `typed_ctor_entry` shared across the infer modules.")]
pub fn typed_ctor_entry(st: InferState, w: Written, expected: Ty) : Option[CtorPick] =
  match settle_name(st, None, w, expected, []) {
    SetOne(c) -> ctor_entry(st.env, c)
    _         -> None
  }


# A read of the declaration `s`, whose scheme is `sc`, at `e`.
#[doc("Typer-internal helper `synth_scheme_read` shared across the infer modules.")]
pub fn synth_scheme_read(st: InferState, sc: TyScheme, s: SymId, e: Expr) : Inferred / Console + File + Mutable = {
  let r = st_instantiate_report(st, sc)
  let st2 = if r.fresh == [] and r.unit_fresh == [] { r.st }
            else { st_push_inst(r.st, CS(s, e.line, e.col, r.fresh, r.unit_fresh, None)) }
  inferred_leaf(st2, r.ty, e)
}


# rewrite every `PNarrow(name, T)` arm into a
# sequence of `PAs(name, PVariant(Vi, []))` arms — one per variant
# of T plus one for the variant of the scrutinee's type that stands
# for T. Under
# the dual representation the parent `type U = A | B`
# decl registers `A` and `B` as zero-arg ctors of `U`, so a value
# may carry either the parent's variant tag (`A`) OR an inner-type
# variant tag (any variant of `A`'s own decl). Dispatching on both
# keeps narrowing observably correct under whichever runtime layout
# the user constructed the value with.
#[doc("Typer-internal helper `expand_narrow_arms` shared across the infer modules.")]
pub fn expand_narrow_arms(arms: [Arm], st: InferState, scr_ty: Ty) : [Arm] {
  match arms {
    [] -> []
    [a, ...rest] -> match a {
      Arm(pat, guard, body) -> match pat.pkind {
        PNarrow(name, ty_expr) -> {
          let tsym = ut_ty_sym(inf_resolve_ty(ty_expr, st_home_view(st)))
          # Cover both the parent's own variant for the component
          # (matches values built via the parent union's variant
          # ctor) and each inner variant (matches values built via
          # the component type's own ctors).
          let own = filter(sum_vars(st, ut_ty_sym(scr_ty)), (v) => sum_var_names(v, tsym))
          let all_vs = map(list_append(own, match_needs(st, tsym)), sum_var_ctor)
          let expanded = expand_narrow_one(all_vs, name, guard, body, pat.line, pat.col)
          list_append(expanded, expand_narrow_arms(rest, st, scr_ty))
        }
        _ -> [a, ...expand_narrow_arms(rest, st, scr_ty)]
      }
    }
  }
}


#[doc("Typer-internal helper `check_exhaustive` shared across the infer modules.")]
pub fn check_exhaustive(st: InferState, arms: [Arm], scr_ty: Ty, line: Int, col: Int) : InferState / Console + File = {
  let st1 = check_exhaustive_ctors(st, arms, scr_ty, line, col)
  if st1.errs == st.errs and x_needs_matrix(arms) { check_exhaustive_matrix(st1, arms, scr_ty, line, col) } else { st1 }
}


fn check_exhaustive_ctors(st: InferState, arms: [Arm], scr_ty: Ty, line: Int, col: Int) : InferState / Console + File =
  if has_catch_all(arms) { st }
  else {
    match scr_ty {
      TyCon(scr_sym, _) -> check_sum_exhaustive(st, arms, scr_sym, line, col)
      TyListT(_) -> check_list_exhaustive(st, arms, line, col)
      TyUnion(parts) -> check_union_exhaustive(st, arms, parts, line, col)
      _ -> st
    }
  }

# The declaration decides which constructors are needed: a type spelled alike
# elsewhere, of any arity, has its own. A `PNarrow` arm, or a scrutinee
# declared as a union of types, switches to per-component checking; a regular
# sum whose variant names collide with other type names keeps the flat check.
fn check_sum_exhaustive(st: InferState, arms: [Arm], scr_sym: SymId, line: Int, col: Int) : InferState / Console + File {
  let needed = match_needs(st, scr_sym)
  match needed {
    [] -> st
    _ ->
      if any_arm_is_narrow(arms) or is_union_of_types(st.env, scr_sym) {
        check_union_components_under_tycon(st, arms, scr_sym, needed, line, col)
      } else {
        report_missing_ctors(st, arms, scr_sym, needed, line, col)
      }
  }
}

fn report_missing_ctors(st: InferState, arms: [Arm], scr_sym: SymId, needed: [SumVar],
                        line: Int, col: Int) : InferState / Console + File {
  let missing = need_names(st.env.tab, find_missing_variants(st, needed, arms, []))
  match missing {
    [] -> st
    _ -> {
      let header = "non-exhaustive match on #{decl_name(st.env.tab, scr_sym)}: missing #{inf_join_with(missing, ", ")}"
      let covered = need_names(st.env.tab, find_covered_variants(st, needed, arms, []))
      let d = build_nonexhaustive_diag(st.file, line, col, header, missing, covered)
      st_bump_err(st_push_diag(st, d))
    }
  }
}


# per-component exhaustiveness over a union
# scrutinee. Iterates each component; for components fully covered
# by a `PNarrow` arm we are done; otherwise we walk the component's
# variants and report any not covered by an arm.
fn check_union_exhaustive(st: InferState, arms: [Arm], parts: [Ty],
                            line: Int, col: Int) : InferState / Console + File {


  match parts {
    [] -> st
    [p, ...rest] -> {
      let st1 = check_union_component(st, arms, p, line, col)
      check_union_exhaustive(st1, arms, rest, line, col)
    }
  }
}


fn check_union_component(st: InferState, arms: [Arm], comp: Ty,
                         line: Int, col: Int) : InferState / Console + File =
  match comp {
    TyCon(csym, _) ->
      if arms_cover_narrow(st, arms, csym) { st }
      else {
        let needed = match_needs(st, csym)
        match needed {
          [] -> st
          _ -> report_missing_in_component(st, needed, arms, written_text(decl_name(st.env.tab, csym)), line, col)
        }
      }
    _ -> st
  }

# Reports the variants of a union component no arm covers, with the ones
# that are covered as context.
fn report_missing_in_component(st: InferState, needed: [SumVar], arms: [Arm], comp_name: String,
                               line: Int, col: Int) : InferState / Console + File {
  let missing = need_names(st.env.tab, find_missing_variants(st, needed, arms, []))
  match missing {
    [] -> st
    _ -> {
      let header = "non-exhaustive match: missing #{inf_join_with(missing, ", ")} (component of #{comp_name})"
      let covered = need_names(st.env.tab, find_covered_variants(st, needed, arms, []))
      let help_msg = "add an arm for each missing variant, a `name : #{comp_name}` narrowing arm covering the whole component, or a wildcard `_` arm"
      let miss_notes = map(missing, (m) => ri_note(st.file, line, col, "missing variant: `#{m}`"))
      let cov_notes = match covered {
        [] -> []
        _ -> [ri_note(st.file, line, col, "covered: #{inf_join_with(covered, ", ")}")]
      }
      let related = list_append(miss_notes, list_append(cov_notes, [ri_help(st.file, line, col, help_msg)]))
      st_bump_err(st_push_diag(st, mk_diag(SevError, st.file, line, col, header, related)))
    }
  }
}

# walk the variants of a top-level TyCon. For
# each variant we ask: does it stand for a declared type with
# its own sub-variants (a component of a union-of-types parent)? If
# so, treat it as a component — covered iff a PNarrow arm targets
# it OR all of its sub-variants are covered. Otherwise it's an
# atomic variant and we check direct arm coverage.
fn check_union_components_under_tycon(st: InferState, arms: [Arm], psym: SymId,
                                        comps: [SumVar], line: Int, col: Int) : InferState / Console + File {


  match comps {
    [] -> st
    [c, ...rest] -> {
      let st1 = check_one_union_comp(st, arms, psym, c, line, col)
      check_union_components_under_tycon(st1, arms, psym, rest, line, col)
    }
  }
}


fn check_one_union_comp(st: InferState, arms: [Arm], psym: SymId, v: SumVar,
                        line: Int, col: Int) : InferState / Console + File {
  let csym = match v { SumVar(_, t) -> t }
  let comp = written_text(decl_name(st.env.tab, sum_var_ctor(v)))
  if arms_cover_narrow(st, arms, csym) { st }
  else {
    let sub_variants = match_needs(st, csym)
    match sub_variants {
      [] ->
        if arms_head(arms, sum_var_ctor(v)) or arms_head(arms, csym) { st }
        else { report_missing_atomic(st, psym, comp, line, col) }
      _ -> report_missing_in_component(st, sub_variants, arms, comp, line, col)
    }
  }
}

fn report_missing_atomic(st: InferState, psym: SymId, comp: String,
                         line: Int, col: Int) : InferState / Console + File {
  let parent = written_text(decl_name(st.env.tab, psym))
  let header = "non-exhaustive match on #{parent}: missing #{comp}"
  let help_msg = "add an arm `#{comp} -> ...` or a wildcard `_ -> ...`"
  let related = [
    ri_note(st.file, line, col, "missing variant: `#{comp}`"),
    ri_help(st.file, line, col, help_msg)
  ]
  st_bump_err(st_push_diag(st, mk_diag(SevError, st.file, line, col, header, related)))
}


# An unguarded `name : T` arm covers the whole component `T` names.
fn arms_cover_narrow(st: InferState, arms: [Arm], comp: SymId) : Bool =
  sym_raw(comp) >= 0 and any(arms, (a) => arm_narrows_to(st, a, comp))


fn arm_narrows_to(st: InferState, a: Arm, comp: SymId) : Bool = match a {
  Arm(pat, None, _) -> match pat.pkind {
    PNarrow(_, ty) -> sym_raw(ut_ty_sym(st_annot_ty(st, ty))) == sym_raw(comp)
    _              -> false
  }
  _ -> false
}


# Walk a typed Expr applying the per-decl substitution to every
# `Expr.ty`. Recurses through every kind that contains sub-Exprs.
# Patterns and Stmts are walked too because they hold Exprs whose
# `ty` field is read by downstream passes (notably the protocol-call
# rewrite). Pure structural; no type checking, no error production.
#[doc("Typer-internal helper `finalise_typed_expr` shared across the infer modules.")]
pub fn finalise_typed_expr(s: Subst, e: Expr) : Expr {
  let ty1 = match e.ty {
    Some(t) -> Some(apply_ty(s, t))
    None    -> None
  }
  Expr { kind: finalise_typed_kind(s, e.kind),
         line: e.line, col: e.col, ty: ty1, mode: e.mode,  site: e.site }
}


fn finalise_typed_kind(s: Subst, k: ExprKind) : ExprKind =
  # Pure structural recursion: every kind delegates to the visitor,
  # which threads `finalise_typed_expr` through every sub-Expr. The
  # per-Expr work (applying `apply_ty(s, t)` to `e.ty`) lives in
  # `finalise_typed_expr` itself, so the closure in the visitor
  # carries it through automatically.
  inf_map_expr_kind(k, (sub) => finalise_typed_expr(s, sub))


#[doc("Typer-internal helper `reject_predicate_effect` shared across the infer modules.")]
pub fn reject_predicate_effect(st: InferState, kind: String, performed: [Label], cond: Expr) : InferState / Console + File = match performed {
  [] -> st
  [lab, ..._] -> match lookup_eff_use(st.eff_uses, lab) {
    EU(_, uline, ucol) -> {
      let line = if uline >= 0 { uline } else { cond.line }
      let col  = if ucol  >= 0 { ucol  } else { cond.col }
      let what = match callee_at(cond, line, col) {
        Some(f) -> "calls effectful function `#{fmt_expr_text(f, st.env.tab, st_local_names(st))}`"
        None    -> "performs `#{label_display(st.env.tab, st.env.head_owners, apply_label_args(st.sub, lab))}`"
      }
      let header = concat_all(["`", kind, "` predicate ", what, ". Refinement / contract predicates may only ",
                               "call effect-pure functions (those with an empty effect row)."])
      st_bump_err(st_push_diag(st, mk_diag(SevError, st.file, line, col, header, [])))
    }
  }
}

