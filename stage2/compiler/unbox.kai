#[doc("""
Representation modes of the unboxing pass: which binders, arms and calls may stay raw.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.operators
import compiler.fn_index
import compiler.kinds
import compiler.expr_positions
import compiler.loop_lower
import compiler.vec_raw
import compiler.core_builtins
import compiler.kir_lower_raw
import compiler.real_lit
import compiler.refine_pred
import compiler.fnreg
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.diag_type_text

pub(pkg) fn ufn_param_env(params: [Param], mask: [Bool], acc: [LocBind]) : [LocBind] {
  match params {
    [] -> list_reverse(acc)
    [p, ...rest] -> {
      let is_raw = match mask {
        [m, ..._] -> m
        [] -> true
      }
      let mrest = match mask {
        [_, ...r] -> r
        [] -> []
      }
      let acc1 = if is_raw { [LB(p.binder.id, MUnboxed), ...acc] } else { acc }
      ufn_param_env(rest, mrest, acc1)
    }
  }
}

# True iff every arm body is raw (MUnboxed) OR divergent. A divergent
# arm (a `panic` / `exit` call — typically the `_ -> panic(...)`
# catch-all the native backend's KIR-node matches use) never produces a
# value, so it does not constrain result-rawness: `emit_match_arm_raw`
# emits it without assigning `_r`. Read from the already-promoted arms
# (bottom-up). An empty arm list is vacuously raw (the typer never
# produces a zero-arm match).
fn arms_all_raw(arms: [Arm]) : Bool = match arms {
  [] -> true
  [a, ...rest] -> match a { Arm(_, _, body) ->
    if child_is_raw(body) or arm_body_diverges(body) { arms_all_raw(rest) } else { false } }
}

pub(pkg) fn decide_mode_aware(k: ExprKind, opt_ty: Option[Ty], env: [LocBind], fns: FnIndex) : ValueMode =
  if ty_is_fixed_vec_opt(opt_ty) { fixed_vec_mode(k, env) }
  else if not ty_is_unboxable(opt_ty) { MBoxed }
  else { scalar_mode(k, opt_ty, env, fns) }

fn raw_if(raw: Bool) : ValueMode = if raw { MUnboxed } else { MBoxed }

# A fixed-width `Vec[e]<n>` is a flat by-value C aggregate with no boxed
# form, but only at its origin — the fixed-vec literal — and at a read of
# a binder that already holds one. A fixed-vec-typed value from anything
# else (a function return) is a dynamic heap vec at runtime and stays
# boxed; the let-site de-brands its binder so the two never disagree.
fn fixed_vec_mode(k: ExprKind, env: [LocBind]) : ValueMode = match k {
  ECall(callee, _) -> raw_if(is_fixed_vec_lit(callee))
  ELocal(l)        -> lb_lookup(env, l)
  _                -> MBoxed
}

fn is_fixed_vec_lit(callee: Expr) : Bool = match callee.kind {
  EMark(MkFixedVecLit) -> true
  _                    -> false
}

# A node of raw scalar type is raw when every operand it composes is. A
# match's arms and a block's tail are walked bottom-up, so their modes
# are final here; a match's scrutinee is an orthogonal axis and may stay
# boxed.
fn scalar_mode(k: ExprKind, opt_ty: Option[Ty], env: [LocBind], fns: FnIndex) : ValueMode = match k {
  EInt(_, _)     -> MUnboxed
  EReal(_, _)    -> MUnboxed
  EIntLit(_)     -> MUnboxed
  EDecimalLit(_) -> MUnboxed
  EFixed(_, _)   -> MUnboxed
  EBool(_)       -> MUnboxed
  EChar(_)       -> MUnboxed
  ELocal(l)      -> lb_lookup(env, l)
  ESym(_, _)     -> MBoxed
  ELitUnit(inner, _) -> raw_if(child_is_raw(inner) and kir_ty_is_real(inner.ty) and kir_ty_is_real(opt_ty))
  ECall(callee, args) -> raw_if(call_is_raw(callee, fns) or vec_reads_raw(fns.vraw, k, opt_ty) or coercion_of_raw(callee, args, opt_ty) or scalar_conv_of_raw(callee, args))
  EField(_, _)       -> raw_if(vec_reads_raw(fns.vraw, k, opt_ty))
  EBinop(op, a, b)   -> raw_if(binop_is_raw(op, a, b, opt_ty, env, fns))
  EUnop(op, x)       -> raw_if(unop_is_raw(op, x, env, fns))
  EIf(cnd, ath, Some(eth))  -> raw_if(child_is_raw(cnd) and child_is_raw(ath) and child_is_raw(eth))
  EBlock(stmts, Some(tail)) -> block_mode(stmts, tail)
  EMatch(_, arms)    -> raw_if(arms_all_raw(arms))
  EIntrinsic(inm, _) -> raw_if(intrinsic_is_raw(inm))
  _ -> MBoxed
}

# A call whose callee takes and returns raw scalars lowers to a direct
# call on raw arguments, with no round trip through a box.
fn call_is_raw(callee: Expr, fns: FnIndex) : Bool =
  call_resolves_to_ufn(callee, fns) or call_is_raw_core(callee, fns) or call_is_fixed_vec_get(callee)

# A unit coercion over a Real is the identity at runtime: raw exactly when its
# argument is. Other carriers keep the boxed border their consumers expect.
fn coercion_of_raw(callee: Expr, args: [Expr], opt_ty: Option[Ty]) : Bool = match builtin_ref(callee) {
  Some(b) -> match args {
    [a] -> builtin_is_unit_coercion(b) and child_is_raw(a) and kir_ty_is_real(a.ty) and kir_ty_is_real(opt_ty)
    _   -> false
  }
  None -> false
}

# `int_to_real` / `real_to_int` are one raw instruction when their operand is raw.
fn scalar_conv_of_raw(callee: Expr, args: [Expr]) : Bool = match (builtin_ref(callee), args) {
  (Some(CbIntToReal), [a]) -> child_is_raw(a) and kir_ty_is_int(a.ty)
  (Some(CbRealToInt), [a]) -> child_is_raw(a) and kir_ty_is_real(a.ty)
  _                        -> false
}

# A composite node is raw only when both operands already are: a boxed
# operand unboxed in place would leak its allocation, where the boxed
# operator consumes it. The result of a raw comparison or logical
# operator is a raw 0/1 the boundary re-boxes on demand.
fn binop_is_raw(op: BinOp, a: Expr, b: Expr, opt_ty: Option[Ty], env: [LocBind], fns: FnIndex) : Bool =
  if op_is_raw_arith(op) and both_raw_operands(a, b, env, fns) { arith_has_raw_form(op, opt_ty) }
  else if pow_is_unrolled(op, a, b, opt_ty) { true }
  else if op_is_raw_cmp(op) and both_raw_operands(a, b, env, fns) { true }
  else { op_is_raw_logical(op) and child_is_raw(a) and child_is_raw(b) and rhs_is_trap_free(b) }

fn both_raw_operands(a: Expr, b: Expr, env: [LocBind], fns: FnIndex) : Bool =
  child_is_raw_operand(a, env, fns) and child_is_raw_operand(b, env, fns)

# `%` has no C-native form on `double`, and no checked-division helper
# takes a 128-bit operand: both stay boxed and route through the runtime
# operator, which traps the zero divisor.
fn arith_has_raw_form(op: BinOp, opt_ty: Option[Ty]) : Bool =
  if binop_eq(op, BoMod) and not ty_is_integral_raw(opt_ty) { false }
  else if binop_is_division(op) and ty_is_int128_opt(opt_ty) { false }
  else { true }

# An integer `^` with a small literal exponent unrolls to bare
# multiplications. The unroll has no per-op masking, so a fixed-width
# `^` stays boxed to keep its width wrap.
fn pow_is_unrolled(op: BinOp, a: Expr, b: Expr, opt_ty: Option[Ty]) : Bool =
  binop_eq(op, BoPow) and child_is_raw(a) and child_is_raw(b) and ty_is_integral_raw(opt_ty) and
  not ty_is_fixed_width_opt(opt_ty) and pow_exp_is_inlinable(b)

fn unop_is_raw(op: UnOp, x: Expr, env: [LocBind], fns: FnIndex) : Bool = match op {
  UoNeg -> child_is_raw_operand(x, env, fns)
  UoNot -> child_is_raw(x)
}

# A block forwards its tail's mode. Its statements run for effects only,
# so a raw tail stays raw past statements that are RC-only; any other
# statement form keeps the block boxed.
fn block_mode(stmts: [Stmt], tail: Expr) : ValueMode = match stmts {
  [] -> tail.mode
  _  -> raw_if(child_is_raw(tail) and block_stmts_rc_safe(stmts))
}

# A promoted var cell's init and reads are raw by construction: the
# cell's type is a raw scalar and the emitters own both borders.
fn intrinsic_is_raw(inm: Intrinsic) : Bool = match inm {
  InCellInit -> true
  InCellGet  -> true
  InAbsent   -> true
  _          -> false
}

# True iff an arm body never produces a value — a `panic` / `exit`
# call (directly, or as the tail of a single-tail block). Such an arm
# does not constrain the match's result-rawness: it aborts before any
# `_r` assignment. Conservative: only the bare divergent-core call
# (or its block-tail) qualifies; anything else must be raw.
pub(pkg) fn arm_body_diverges(e: Expr) : Bool = match e.kind {
  ECall(callee, _) -> match builtin_ref(callee) {
    Some(b) -> builtin_never_returns(b)
    None    -> false
  }
  EBlock(_, Some(tail)) -> arm_body_diverges(tail)
  _ -> false
}

fn call_resolves_to_ufn(callee: Expr, fns: FnIndex) : Bool = match fnx_callee_sig(fns, callee) {
  Some(_) -> true
  None    -> false
}

fn call_is_raw_core(callee: Expr, fns: FnIndex) : Bool = match callee.kind {
  ESym(s, _) -> fnx_is_raw_prim(fns, s)
  _          -> false
}

fn call_is_fixed_vec_get(callee: Expr) : Bool {
  match callee.kind {
    EMark(MkFixedVecGet)    -> true
    EMark(MkFixedVecGetDyn) -> true
    _                       -> false
  }
}

pub(pkg) type LocBind = LB(LocalId, ValueMode) | LBLent(LocalId)

fn lb_lookup(env: [LocBind], nm: LocalId) : ValueMode {
  match env {
    [] -> MBoxed
    [LB(n, m), ...rest] -> if local_eq(n, nm) { m } else { lb_lookup(rest, nm) }
    [LBLent(n), ...rest] -> if local_eq(n, nm) { MBoxed } else { lb_lookup(rest, nm) }
  }
}

fn lb_lent(env: [LocBind], nm: LocalId) : Bool {
  match env {
    [] -> false
    [LB(n, _), ...rest] -> if local_eq(n, nm) { false } else { lb_lent(rest, nm) }
    [LBLent(n), ...rest] -> local_eq(n, nm) or lb_lent(rest, nm)
  }
}

pub(pkg) fn ty_is_unboxable(opt_t: Option[Ty]) : Bool {
  match opt_t {
    Some(t) -> ty_is_unboxable_t(t)
    None    -> false
  }
}

pub(pkg) fn ty_is_integral_raw(opt_t: Option[Ty]) : Bool {
  match opt_t {
    Some(t) -> ty_is_integral_raw_t(t)
    None    -> false
  }
}

fn ty_is_integral_raw_t(t: Ty) : Bool {
  match t {
    TyInt  -> true
    TyBool -> true
    TyChar -> true
    TyByte -> true
    TyInt32  -> true
    TyUInt32 -> true
    TyUInt64 -> true
    TyInt128 -> true
    TyDimT(inner, _)    -> ty_is_integral_raw_t(inner)
    TyRefineT(inner, _, _) -> ty_is_integral_raw_t(inner)
    _ -> false
  }
}

# Numeric binops whose raw form is a single C operator on `int64_t`.
# `^` (integer power) is not a native C operator, so it stays boxed
# for now and routes through `kai_op_pow_int` (M3 v1 conservative;
# follow-up if hot). Integer division on `Int / Int` lowers to native
# C `/` directly (issue #315 retired the dedicated `//` operator).
pub(pkg) fn op_is_raw_arith(op: BinOp) : Bool = binop_is_arith(op)

# Tier 2.5 M4 — comparison operators that produce a raw `int`
# (0 or 1) from two raw operands. Equality / inequality on raw
# `int64_t` reduce to native C `==` / `!=`.
pub(pkg) fn op_is_raw_cmp(op: BinOp) : Bool = binop_is_comparison(op)

# Tier 2.5 M4 — short-circuiting boolean operators. `and` / `or`
# in kaikai mirror C `&&` / `||` (short-circuit, evaluate left
# first).
pub(pkg) fn op_is_raw_logical(op: BinOp) : Bool = binop_is_logical(op)

fn rhs_is_trap_free(x: Expr) : Bool = match x.kind {
  EInt(_, _)         -> true
  EReal(_, _)        -> true
  EFixed(_, _)       -> true
  EChar(_)           -> true
  ELocal(_)          -> true
  ESym(_, _)         -> true
  ELitUnit(inner, _) -> rhs_is_trap_free(inner)
  # `/` and `%` trap on a zero divisor unless the divisor is a nonzero
  # literal; the other raw binops over raw operands are total.
  EBinop(op, a, b)   ->
    rhs_is_trap_free(a) and rhs_is_trap_free(b) and
    (if binop_is_division(op) { is_nonzero_literal(b) } else { true })
  EUnop(_, a)        -> rhs_is_trap_free(a)
  _                  -> false
}

fn is_nonzero_literal(x: Expr) : Bool = match x.kind {
  EInt(n, _)  -> n != 0
  EReal(RealLit(r), _) -> r != 0.0
  _           -> false
}

pub(pkg) fn raw_op_str(op: BinOp) : String = match op {
  BoAnd -> "&&"
  BoOr  -> "||"
  _     -> binop_text(op)
}

fn child_is_raw(e: Expr) : Bool {
  match e.mode { MUnboxed -> true _ -> false }
}

fn child_is_raw_operand(e: Expr, env: [LocBind], fns: FnIndex) : Bool =
  child_is_raw(e) or (ty_is_unboxable(e.ty) and (expr_is_perform(e, fns) or expr_is_lent(e, env)))

fn expr_is_lent(e: Expr, env: [LocBind]) : Bool = match e.kind {
  ELocal(l) -> lb_lent(env, l)
  _         -> false
}

fn expr_is_perform(e: Expr, fns: FnIndex) : Bool = match e.kind {
  ECall(callee, _) -> match callee.kind {
    EOp(r) -> fnx_is_effect(fns, r.eff)
    _      -> false
  }
  _ -> false
}

fn ty_is_fixed_width_opt(opt_t: Option[Ty]) : Bool {
  match opt_t {
    Some(t) -> ty_is_fixed_width_t(t)
    None    -> false
  }
}

fn ty_is_fixed_width_t(t: Ty) : Bool = match t {
  TyByte -> true    TyInt32 -> true   TyUInt32 -> true
  TyUInt64 -> true  TyInt128 -> true
  TyRefineT(inner, _, _) -> ty_is_fixed_width_t(inner)
  _ -> false
}

fn ty_is_int128_opt(opt_t: Option[Ty]) : Bool = match opt_t {
  Some(TyInt128) -> true
  Some(TyRefineT(inner, _, _)) -> match inner { TyInt128 -> true _ -> false }
  _ -> false
}

fn block_stmts_rc_safe(stmts: [Stmt]) : Bool = match stmts {
  [] -> true
  [s, ...rest] -> match s {
    SLet(_, _, _) -> block_stmts_rc_safe(rest)
    SExprStmt(_)  -> block_stmts_rc_safe(rest)
    _             -> false
  }
}

pub(pkg) fn pow_exp_is_inlinable(e: Expr) : Bool {
  match try_eval_int(e) {
    Some(n) -> n >= 0 and n <= 64
    None    -> false
  }
}

pub(pkg) fn seed_variant_int_binders(ctor: DeclRef, subs: [Pattern], body: Expr,
                            cis: CtorIntIx, nat: Bool, env: [LocBind], fns: FnIndex) : [LocBind] / Console =
  seed_variant_int_loop(subs, ctor_int_flags(cis, ref_sym(ctor)), 0, body, cis, nat, env, fns)

fn seed_variant_int_loop(subs: [Pattern], flags: [Bool], i: Int, body: Expr,
                         cis: CtorIntIx, nat: Bool, env: [LocBind], fns: FnIndex) : [LocBind] / Console {
  match subs {
    [] -> env
    [sp, ...rest] -> {
      let slot_is_int = match list_nth_bool(flags, i) { Some(b) -> b None -> false }
      let env1 = match sp.pkind {
        PBind(nm) ->
          # The C oracle's mode-slave border is TOTAL, so it seeds a kind-1
          # Int binder MUnboxed whenever it is not read via interp / a lambda
          # capture. The NATIVE load-border is NOT total: it re-boxes a raw
          # register only where a value flows through `nemit_load_reg_boxed`,
          # not at every tagged consumer. So under `nat` the binder is raw
          # ONLY in the shapes the native lowers raw-safe — a raw-op operand
          # or a same-ctor reuse-in-place slot (`native_arm_binder_raw_safe`).
          # This is the SINGLE rawness verdict: it governs the mode here, and
          # `bind_slot_kslot` reads that mode for the KSlot, so mode and KSlot
          # can never diverge (#1110).
          {
            let boxed_free = slot_is_int and not expr_captures(body, nm)
            let native_ok = not nat or native_arm_binder_raw_safe(nm.id, body, cis, fns)
            if boxed_free and native_ok { [LB(nm.id, MUnboxed), ...env] } else { env }
          }
        # Nested variant: its own sub-PBind binders may read kind-1 slots.
        PVariant(inner_ctor, inner_subs) ->
          seed_variant_int_binders(inner_ctor, inner_subs, body, cis, nat, env, fns)
        _ -> env
      }
      seed_variant_int_loop(rest, flags, i + 1, body, cis, nat, env1, fns)
    }
  }
}

fn list_nth_bool(xs: [Bool], i: Int) : Option[Bool] {
  match xs {
    [] -> None
    [h, ...rest] -> if i == 0 { Some(h) } else { list_nth_bool(rest, i - 1) }
  }
}

# The binder and position of every match-arm variant Int sub-binder the native
# backend seeds `MUnboxed` — the SAME verdict `seed_variant_int_binders` applies
# under `nat`, produced here as a position-keyed side table so perceus and
# KIR-lowering READ it instead of re-deriving rawness from the mutated body
# (#1229). One producer, three readers, no phase can disagree. Runs only under
# the native backend (the C oracle's total re-box border needs no such table).
pub(pkg) fn native_raw_arm_binders(decls: [Decl], cis: CtorIntIx, fns: FnIndex) : [RawArmBinder] / Console =
  nrab_decls(decls, cis, fns, [])

fn nrab_decls(ds: [Decl], cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match ds {
  []           -> acc
  [d, ...rest] -> nrab_decls(rest, cis, fns, nrab_decl(d, cis, fns, acc))
}

fn nrab_decl(d: Decl, cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match d {
  DFn(_, _, _, _, _, _, body, _, _, _)    -> nrab_expr(body, cis, fns, acc)
  DTest(_, body, _, _, _)                 -> nrab_expr(body, cis, fns, acc)
  DBench(_, body, _, _, _)                -> nrab_expr(body, cis, fns, acc)
  DCheck(_, _, body, _, _, _)             -> nrab_expr(body, cis, fns, acc)
  _                                    -> acc
}

# Every arm of every `match` in `e`; a `PVariant` arm seeds its Int sub-binders,
# then the arm body is descended for nested matches. Mirror of the emit-side
# walk (`nab_mentions`) so no arm-carrying form is skipped.
fn nrab_expr(e: Expr, cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match e.kind {
  EMatch(s, arms)      -> nrab_arms(arms, cis, fns, nrab_expr(s, cis, fns, acc))
  ECall(f, xs)         -> nrab_exprs(xs, cis, fns, nrab_expr(f, cis, fns, acc))
  EIntrinsic(_, xs)    -> nrab_exprs(xs, cis, fns, acc)
  ESurface(sf)    -> nrab_exprs(surface_children(sf), cis, fns, acc)
  EField(x, _)         -> nrab_expr(x, cis, fns, acc)
  EIndex(a, b)         -> nrab_expr(b, cis, fns, nrab_expr(a, cis, fns, acc))
  EBinop(_, a, b)      -> nrab_expr(b, cis, fns, nrab_expr(a, cis, fns, acc))
  EUnop(_, x)          -> nrab_expr(x, cis, fns, acc)
  EBang(x)             -> nrab_expr(x, cis, fns, acc)
  ELitUnit(x, _)       -> nrab_expr(x, cis, fns, acc)
  EIf(c, t, oe)        -> nrab_opt(oe, cis, fns, nrab_expr(t, cis, fns, nrab_expr(c, cis, fns, acc)))
  ELambda(_, b)        -> nrab_expr(b, cis, fns, acc)
  ERecordLit(_, fis)   -> nrab_fields(fis, cis, fns, acc)
  EList(els)           -> nrab_elems(els, cis, fns, acc)
  ERange(a, b, ob)     -> nrab_opt(ob, cis, fns, nrab_expr(b, cis, fns, nrab_expr(a, cis, fns, acc)))
  EBlock(ss, tl)       -> nrab_opt(tl, cis, fns, nrab_stmts(ss, tl, cis, fns, acc))
  EPipe(a, b)          -> nrab_expr(b, cis, fns, nrab_expr(a, cis, fns, acc))
  EDispatchPipe(_, a, b) -> nrab_expr(b, cis, fns, nrab_expr(a, cis, fns, acc))
  EHandle(b, _, _, io, _, cls, ro) -> nrab_ret(ro, cis, fns, nrab_clauses(cls, cis, fns, nrab_opt(io, cis, fns, nrab_expr(b, cis, fns, acc))))
  _                    -> acc
}

fn nrab_exprs(es: [Expr], cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match es {
  []           -> acc
  [e, ...rest] -> nrab_exprs(rest, cis, fns, nrab_expr(e, cis, fns, acc))
}
fn nrab_opt(oe: Option[Expr], cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match oe { None -> acc Some(e) -> nrab_expr(e, cis, fns, acc) }
fn nrab_fields(fis: [FieldInit], cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match fis {
  []           -> acc
  [f, ...rest] -> nrab_fields(rest, cis, fns, match f { FI(_, v) -> nrab_expr(v, cis, fns, acc) })
}
fn nrab_elems(els: [ListElem], cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match els {
  []            -> acc
  [el, ...rest] -> nrab_elems(rest, cis, fns, match el { ElPlain(e) -> nrab_expr(e, cis, fns, acc) ElSpread(e) -> nrab_expr(e, cis, fns, acc) })
}
pub(pkg) fn let_scope(rhs: Expr, rest: [Stmt], tl: Option[Expr]) : Expr =
  Expr { kind: EBlock(rest, tl), line: rhs.line, col: rhs.col, ty: rhs.ty, mode: MBoxed, site: rhs.site }

fn nrab_stmts(ss: [Stmt], tl: Option[Expr], cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match ss {
  []           -> acc
  [s, ...rest] -> nrab_stmts(rest, tl, cis, fns, nrab_stmt(s, rest, tl, cis, fns, acc))
}
fn nrab_stmt(s: Stmt, rest: [Stmt], tl: Option[Expr], cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match s {
  SExprStmt(e)                -> nrab_expr(e, cis, fns, acc)
  SLet(pat, _, rhs)           -> nrab_expr(rhs, cis, fns, nrab_pat(pat, let_scope(rhs, rest, tl), cis, fns, acc))
  SVar(_, _, rhs, _, _)       -> nrab_expr(rhs, cis, fns, acc)
  SAssert(e, oe)              -> nrab_opt(oe, cis, fns, nrab_expr(e, cis, fns, acc))
  SIndexAssign(b, i, v, _, _) -> nrab_expr(v, cis, fns, nrab_expr(i, cis, fns, nrab_expr(b, cis, fns, acc)))
  _                           -> acc
}
fn nrab_clauses(cls: [HClause], cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match cls {
  []           -> acc
  [c, ...rest] -> nrab_clauses(rest, cis, fns, match c { HC(_, _, b, _, _) -> nrab_expr(b, cis, fns, acc) })
}
fn nrab_ret(ro: Option[HReturn], cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match ro {
  None     -> acc
  Some(hr) -> match hr { HR(_, b, _, _) -> nrab_expr(b, cis, fns, acc) }
}

fn nrab_arms(arms: [Arm], cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match arms {
  []           -> acc
  [a, ...rest] -> nrab_arms(rest, cis, fns, match a { Arm(p, _, b) -> nrab_expr(b, cis, fns, nrab_pat(p, b, cis, fns, acc)) })
}

# Seed the raw table for a `PVariant` arm's Int sub-binders — the SAME
# condition `seed_variant_int_loop` applies under `nat`: a kind-1 Int slot,
# not read via interp / a captured lambda, and `native_arm_binder_raw_safe`.
# Recurses into nested `PVariant` sub-patterns, exactly as the seed does.
fn nrab_pat(p: Pattern, body: Expr, cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match p.pkind {
  PVariant(ctor, subs) -> nrab_variant(ctor, subs, body, cis, fns, acc)
  _                    -> acc
}
fn nrab_variant(ctor: DeclRef, subs: [Pattern], body: Expr, cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console =
  nrab_slot_loop(subs, ctor_int_flags(cis, ref_sym(ctor)), 0, body, cis, fns, acc)
fn nrab_slot_loop(subs: [Pattern], flags: [Bool], i: Int, body: Expr, cis: CtorIntIx, fns: FnIndex, acc: [RawArmBinder]) : [RawArmBinder] / Console = match subs {
  []           -> acc
  [sp, ...rest] -> {
    let slot_is_int = match list_nth_bool(flags, i) { Some(b) -> b None -> false }
    let acc1 = match sp.pkind {
      PBind(nm) -> {
        let boxed_free = slot_is_int and not expr_captures(body, nm)
        if boxed_free and native_arm_binder_raw_safe(nm.id, body, cis, fns) { [RAB(nm.id, sp.line, sp.col), ...acc] } else { acc }
      }
      PVariant(inner_ctor, inner_subs) -> nrab_variant(inner_ctor, inner_subs, body, cis, fns, acc)
      _ -> acc
    }
    nrab_slot_loop(rest, flags, i + 1, body, cis, fns, acc1)
  }
}

# True iff the `PBind` of the binder `nm` at `(line, col)` was seeded native-raw.
pub(pkg) fn raw_arm_binder_at(tbl: [RawArmBinder], nm: LocalId, line: Int, col: Int) : Bool = match tbl {
  []                     -> false
  [RAB(n, l, c), ...rest] -> if local_eq(n, nm) and l == line and c == col { true } else { raw_arm_binder_at(rest, nm, line, col) }
}

fn ctor_int_flags(cis: CtorIntIx, s: SymId) : [Bool] = match ctor_int_slots_of(cis, s) {
  Some(flags) -> flags
  None        -> []
}

pub(pkg) fn expr_captures(e: Expr, b: Binder) : Bool =
  uses_have_in_lam(scan_uses_expr(e, false), b.id)

# A read inside a closure that outlives its frame. A loop's condition and body
# run in place, so a binder read there is not captured.
fn closure_captures(e: Expr, id: LocalId, in_lam: Bool) : Bool = match e.kind {
  ELocal(l) -> in_lam and local_eq(l, id)
  EIntrinsic(inm, xs) -> any(xs, (x) => closure_captures(if is_loop_intrinsic(inm) { loop_arg_body(x) } else { x }, id, in_lam))
  EHandle(body, _, _, init_opt, _, clauses, ret_opt) ->
    closure_captures(body, id, in_lam)
      or (match init_opt { Some(x) -> closure_captures(x, id, in_lam)  None -> false })
      or any(clauses, (c) => match c { HC(_, _, b, _, _) -> closure_captures(b, id, true) })
      or (match ret_opt { Some(HR(_, b, _, _)) -> closure_captures(b, id, true)  None -> false })
  _ -> any(xp_positions(e), (p) => match p { XP(r, x) -> closure_captures(x, id, in_lam or not xrole_inline(r)) })
}

pub(pkg) fn name_captured_in_block(rest: [Stmt], opt_tail: Option[Expr], nm: Binder) : Bool / Console {
  let captures = (e: Expr) => closure_captures(e, nm.id, false)
  if any_stmt_captures(rest, captures) { true }
  else { match opt_tail {
    None -> false
    Some(e) -> captures(e)
  } }
}

fn any_stmt_captures(stmts: [Stmt], captures: (Expr) -> Bool) : Bool / Console {
  match stmts {
    [] -> false
    [s, ...rest] -> if stmt_captures(s, captures) { true }
                    else { any_stmt_captures(rest, captures) }
  }
}

fn stmt_captures(s: Stmt, captures: (Expr) -> Bool) : Bool / Console {
  match s {
    SLet(_, _, rhs)        -> captures(rhs)
    SVar(_, _, rhs, _, _)  -> captures(rhs)
    SAssert(c, opt_m)      -> {
      if captures(c) { true }
      else { match opt_m {
        None -> false
        Some(m) -> captures(m)
      } }
    }
    SExprStmt(e)           -> captures(e)
    SIndexAssign(b, i, v, _, _) -> captures(b) or captures(i) or captures(v)
    SAssign(b, v, _, _) -> captures(b) or captures(v)
    SUse(_, _, _)          -> false
  }
}

pub(pkg) fn uses_have_in_lam(uses: [Use], nm: LocalId) : Bool {
  match uses {
    [] -> false
    [u, ...rest] -> match u {
      U(n, _, _, in_lam) ->
        if local_eq(n, nm) and in_lam { true } else { uses_have_in_lam(rest, nm) }
    }
  }
}

# compiler/unbox_native_raw.kai — the NATIVE-backend strict raw-binder
# predicate (#1110).
#
# The unbox pass (`seed_variant_int_binders`) seeds a kind-1 Int arm binder
# `MUnboxed` so its reads lower to a raw `i64`. The C oracle's re-box border is
# TOTAL — it re-boxes a raw value at every tagged consumer — so it can seed a
# binder raw whenever it is not read via interp / a captured lambda. The NATIVE
# load-border is NOT total: it re-boxes a raw register only where a value flows
# through `nemit_load_reg_boxed`, not at every tagged consumer inline. So under
# the native backend the same binder is raw ONLY in the shapes the native
# lowers raw-safe, decided here.
#
# This is the ONE rawness verdict for a native arm binder: it governs the
# `unbox` mode, and `bind_slot_kslot` reads that mode for the register's KSlot,
# so mode and KSlot can never diverge — the classifier drift #1110 traced to
# two independent verdicts of the same binder's rawness.
#
# Split into its own module (not folded into the `unbox.kai` monolith) so the
# analysis carries its own grade and the import graph stays acyclic: it reads
# `compiler.ast` + the fn registry (`compiler.fnreg`), and `unbox` imports IT.


# True iff EVERY use of the kind-1 Int arm binder `nm` in `e` is a shape the
# native backend lowers raw-safe: an operand of a raw-arith / comparison
# `EBinop` whose SIBLING operand is itself a raw-Int form (a reference or an Int
# literal), so the emitter lowers the WHOLE binop raw (`icmp`/`iadd` over two
# raw i64), never the tagged `kaix_eq` shim that would read `nm` as a
# `KaiValue *`. This is the READ-side use that drives the rb-tree descent win
# (`k < kx` → `nemit_proj_slot` reads the key `.i64` inline). The WRITE-side
# use is also raw-safe: `nm` as a direct argument of a variant constructor in
# a kind-1 Int slot position (the rebuild `RBNode(..,kx,..)`) — the ctor's
# reuse-in-place slot init lowers that `SIInt64` through `nemit_atom_raw`,
# which loads `nm` at its OWN register slot (raw i64 direct, boxed unbox-
# borrowed), so a raw binder lands in the raw slot with no deref hazard. `cis`
# resolves the constructed ctor's Int-slot flags for that check, and carries
# the same builtin-tag guard as `typed_inits` (`build_ctor_int_slots`), so a
# mixed-writer ctor is never marked raw here. A third modelled consumer:
# `nm` as a DIRECT arg of a direct call whose callee param at that position
# is RAW (the UFnSig mask the raw-signature classifier produced, the same
# verdict the KIR call lowering reads) — the call site materialises each
# arg at its param slot, so a raw register passes straight through. Any
# other use — a field read, an index, a pipe, a mixed-operand compare, a
# nested-match pattern — is boxed on the native's non-total border, so the
# binder stays boxed. Conservative by exclusion: an unmodelled form forces
# boxed. STRICTER than the C oracle's mode-slave seeding, which the
# native's non-total load-border cannot match.
pub(pkg) fn native_arm_binder_raw_safe(nm: LocalId, e: Expr, cis: CtorIntIx, fns: FnIndex) : Bool / Console = match e.kind {
  EUnit -> false
  _     -> nab_uses_ok(nm, e, cis, fns)
}

fn nab_uses_ok(nm: LocalId, e: Expr, cis: CtorIntIx, fns: FnIndex) : Bool / Console = match e.kind {
  ELocal(n)        -> not local_eq(n, nm)
  ESym(_, _)       -> true
  EInt(_, _)       -> true
  EReal(_, _)      -> true
  EBinop(op, l, r) ->
    if nab_op_is_raw(op) and (nab_is_var(nm, l) or nab_is_var(nm, r)) {
      nab_operand(nm, l, cis, fns) and nab_operand(nm, r, cis, fns)
    } else { nab_uses_ok(nm, l, cis, fns) and nab_uses_ok(nm, r, cis, fns) }
  EUnop(_, x)      -> nab_uses_ok(nm, x, cis, fns)
  EIf(c, t, oe)    -> nab_uses_ok(nm, c, cis, fns) and nab_uses_ok(nm, t, cis, fns) and nab_opt(nm, oe, cis, fns)
  EBlock(ss, tl)   -> nab_stmts(nm, ss, cis, fns) and nab_opt(nm, tl, cis, fns)
  ECall(f, xs)     -> match nab_ctor_flags(f, cis) {
    Some(flags) -> nab_ctor_args_ok(nm, flags, xs, cis, fns)
    None        -> match nab_callee_raw_mask(f, fns) {
      Some(mask) -> nab_call_args_ok(nm, mask, xs, cis, fns)
      None       -> not nab_mentions(nm, e)
    }
  }
  _                -> not nab_mentions(nm, e)
}

# `nm` in a variant-ctor call: safe as a DIRECT arg in a kind-1 Int slot
# (the `SIInt64` init stores the register raw); any other position recurses
# (and forces boxed on an unmodelled shape as usual). `flags` is consumed in
# lockstep with the args, so each arg sees its own slot's flag.
fn nab_ctor_args_ok(nm: LocalId, flags: [Bool], xs: [Expr], cis: CtorIntIx, fns: FnIndex) : Bool / Console = match xs {
  []           -> true
  [x, ...rest] -> match flags {
    [f, ...fr] -> {
      let ok = if nab_is_var(nm, x) { f } else { nab_uses_ok(nm, x, cis, fns) }
      ok and nab_ctor_args_ok(nm, fr, rest, cis, fns)
    }
    # More args than declared slots: never raw here, but keep walking the
    # remaining args for other uses of `nm`.
    [] -> not nab_is_var(nm, x) and nab_uses_ok(nm, x, cis, fns) and nab_ctor_args_ok(nm, [], rest, cis, fns)
  }
}

# `nm` as a direct call arg: safe in a RAW param position (mask true — the
# call site passes the register at the param slot, no box mint); a boxed
# position or a non-var arg recurses. Mask and args walk in lockstep,
# mirroring `nab_ctor_args_ok`.
fn nab_call_args_ok(nm: LocalId, mask: [Bool], xs: [Expr], cis: CtorIntIx, fns: FnIndex) : Bool / Console = match xs {
  []           -> true
  [x, ...rest] -> match mask {
    [m, ...mr] -> {
      let ok = if nab_is_var(nm, x) { m } else { nab_uses_ok(nm, x, cis, fns) }
      ok and nab_call_args_ok(nm, mr, rest, cis, fns)
    }
    [] -> not nab_is_var(nm, x) and nab_uses_ok(nm, x, cis, fns) and nab_call_args_ok(nm, [], rest, cis, fns)
  }
}

# The raw-param mask of a direct callee, resolved through the SAME fn
# registry the raw-signature classifier filled, so the permit and the
# call lowering share one verdict. `int_to_real` takes its Int raw. Any other
# local or non-UFn head yields None
# (conservative). A raw binder feeding a call the KIR later takes
# indirect is still sound: the boxed-arg border re-boxes the raw register
# at the call, it just stops paying off.
fn nab_callee_raw_mask(f: Expr, fns: FnIndex) : Option[[Bool]] = match f.kind {
  ESym(_, _) -> match fnx_callee_sig(fns, f) {
    Some(US(_, _, mask)) -> Some(mask)
    None -> if is_builtin_ref(f, CbIntToReal) { Some([true]) } else { None }
  }
  _ -> None
}

# The Int-slot flags of a constructor call head, resolved through the same
# `CtorIntSlots` registry the seeding reads, so the permit and the ctor's
# write layout share one source. A callee with no entry (a fn) keeps the
# conservative path.
fn nab_ctor_flags(f: Expr, cis: CtorIntIx) : Option[[Bool]] = match f.kind {
  ESym(s, _) -> ctor_int_slots_of(cis, s)
  _          -> None
}

# The arith / comparison operators the native lowers to a raw `i`-family op
# over raw operands. Kept local (not imported from `unbox`) so the import graph
# stays acyclic — `unbox` imports this module, not the reverse.
fn nab_op_is_raw(op: BinOp) : Bool = binop_is_arith(op) or binop_is_comparison(op)

# A binop operand: a read of `nm` (the raw use) is safe iff its SIBLING is a
# raw-Int form; a non-`nm` operand must be a raw-Int form too (var / Int lit)
# for the whole binop to lower raw. Anything else keeps the binder boxed.
fn nab_operand(nm: LocalId, e: Expr, cis: CtorIntIx, fns: FnIndex) : Bool / Console = match e.kind {
  ELocal(_)  -> true
  ESym(_, _) -> true
  EInt(_, _) -> true
  EIntLit(_) -> true
  _          -> nab_uses_ok(nm, e, cis, fns)
}

fn nab_is_var(nm: LocalId, e: Expr) : Bool = match e.kind { ELocal(n) -> local_eq(n, nm) _ -> false }
fn nab_opt(nm: LocalId, oe: Option[Expr], cis: CtorIntIx, fns: FnIndex) : Bool / Console = match oe { None -> true Some(e) -> nab_uses_ok(nm, e, cis, fns) }
fn nab_stmts(nm: LocalId, ss: [Stmt], cis: CtorIntIx, fns: FnIndex) : Bool / Console = match ss {
  []           -> true
  [s, ...rest] -> nab_stmt(nm, s, cis, fns) and nab_stmts(nm, rest, cis, fns)
}
fn nab_stmt(nm: LocalId, s: Stmt, cis: CtorIntIx, fns: FnIndex) : Bool / Console = match s {
  SExprStmt(e)    -> nab_uses_ok(nm, e, cis, fns)
  SLet(_, _, rhs) -> nab_uses_ok(nm, rhs, cis, fns)
  _               -> not nab_stmt_mentions(nm, s)
}

# Exhaustive mention walk (every sub-Expr AND nested match patterns) — the
# conservative catch-all for a form `nab_uses_ok` does not model. Unlike
# `scan_uses_expr` this descends into arm patterns, so a binder read in a
# nested match pattern still forces boxed.
fn nab_mentions(nm: LocalId, e: Expr) : Bool / Console = match e.kind {
  ELocal(n)            -> local_eq(n, nm)
  ECall(f, xs)         -> nab_mentions(nm, f) or nab_mentions_list(nm, xs)
  EIntrinsic(_, xs)    -> nab_mentions_list(nm, xs)
  ESurface(sf)    -> nab_mentions_list(nm, surface_children(sf))
  EField(x, _)         -> nab_mentions(nm, x)
  EIndex(a, b)         -> nab_mentions(nm, a) or nab_mentions(nm, b)
  EBinop(_, a, b)      -> nab_mentions(nm, a) or nab_mentions(nm, b)
  EUnop(_, x)          -> nab_mentions(nm, x)
  EBang(x)             -> nab_mentions(nm, x)
  ELitUnit(x, _)       -> nab_mentions(nm, x)
  EIf(c, t, oe)        -> nab_mentions(nm, c) or nab_mentions(nm, t) or nab_mentions_opt(nm, oe)
  EMatch(s, arms)      -> nab_mentions(nm, s) or nab_mentions_arms(nm, arms)
  ELambda(_, b)        -> nab_mentions(nm, b)
  ERecordLit(_, fis)   -> nab_mentions_fields(nm, fis)
  EList(els)           -> nab_mentions_elems(nm, els)
  ERange(a, b, ob)     -> nab_mentions(nm, a) or nab_mentions(nm, b) or nab_mentions_opt(nm, ob)
  EBlock(ss, tl)       -> nab_mentions_stmts(nm, ss) or nab_mentions_opt(nm, tl)
  EPipe(a, b)          -> nab_mentions(nm, a) or nab_mentions(nm, b)
  EDispatchPipe(_, a, b) -> nab_mentions(nm, a) or nab_mentions(nm, b)
  _                    -> false
}
fn nab_mentions_list(nm: LocalId, es: [Expr]) : Bool / Console = match es {
  []        -> false
  [e, ...r] -> nab_mentions(nm, e) or nab_mentions_list(nm, r)
}
fn nab_mentions_opt(nm: LocalId, oe: Option[Expr]) : Bool / Console = match oe {
  None    -> false
  Some(e) -> nab_mentions(nm, e)
}
fn nab_mentions_arms(nm: LocalId, arms: [Arm]) : Bool / Console = match arms {
  []        -> false
  [a, ...r] -> (match a { Arm(p, g, b) -> nab_pat(nm, p) or nab_mentions_opt(nm, g) or nab_mentions(nm, b) }) or nab_mentions_arms(nm, r)
}
fn nab_mentions_fields(nm: LocalId, fis: [FieldInit]) : Bool / Console = match fis {
  []        -> false
  [f, ...r] -> (match f { FI(_, e) -> nab_mentions(nm, e) }) or nab_mentions_fields(nm, r)
}
fn nab_mentions_elems(nm: LocalId, els: [ListElem]) : Bool / Console = match els {
  []         -> false
  [el, ...r] -> (match el { ElPlain(e) -> nab_mentions(nm, e) ElSpread(e) -> nab_mentions(nm, e) }) or nab_mentions_elems(nm, r)
}
fn nab_mentions_stmts(nm: LocalId, ss: [Stmt]) : Bool / Console = match ss {
  []        -> false
  [s, ...r] -> nab_stmt_mentions(nm, s) or nab_mentions_stmts(nm, r)
}
fn nab_stmt_mentions(nm: LocalId, s: Stmt) : Bool / Console = match s {
  SExprStmt(e)                -> nab_mentions(nm, e)
  SLet(p, _, rhs)             -> nab_pat(nm, p) or nab_mentions(nm, rhs)
  SVar(_, _, rhs, _, _)       -> nab_mentions(nm, rhs)
  SAssert(e, oe)              -> nab_mentions(nm, e) or nab_mentions_opt(nm, oe)
  SIndexAssign(b, i, v, _, _) -> nab_mentions(nm, b) or nab_mentions(nm, i) or nab_mentions(nm, v)
  SAssign(b, v, _, _) -> nab_mentions(nm, b) or nab_mentions(nm, v)
  _                           -> false
}
fn nab_pat(nm: LocalId, p: Pattern) : Bool / Console = match p.pkind {
  PBind(n)              -> local_eq(n.id, nm)
  PLit(e)               -> nab_mentions(nm, e)
  PList(subs, orest)    -> nab_pats(nm, subs) or (match orest { Some(n) -> local_eq(n.id, nm) None -> false })
  PVariant(_, subs)     -> nab_pats(nm, subs)
  PVariantRecord(_, fs) -> nab_pfields(nm, fs)
  PRecord(fs)           -> nab_pfields(nm, fs)
  PAs(n, inner)         -> local_eq(n.id, nm) or nab_pat(nm, inner)
  PNarrow(n, _)         -> local_eq(n.id, nm)
  _                     -> false
}
fn nab_pats(nm: LocalId, ps: [Pattern]) : Bool / Console = match ps {
  []        -> false
  [p, ...r] -> nab_pat(nm, p) or nab_pats(nm, r)
}
fn nab_pfields(nm: LocalId, fs: [PField]) : Bool / Console = match fs {
  []        -> false
  [f, ...r] -> (match f { PField(_, sub, _) -> nab_pat(nm, sub) }) or nab_pfields(nm, r)
}
