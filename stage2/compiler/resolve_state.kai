#[doc("""
The resolution the resolver accumulates as it walks: the symbol table
it resolves against, the module symbol the declaration it is inside
belongs to, and the use table it fills.

The home is that module's `SymId`, resolved once when the walk enters
the module. Two homonymous modules hold two ids, so the home a use site
carries cannot be confused with another module's by spelling.

It rides the resolver's `Env` as one field rather than three so the
seven `Env` literals keep saying what they are about — scope, error
flag, diagnostics — and the resolution stays one thing that can be
lifted out whole when a consumer starts reading it.

`rs_off` carries the case where nothing is resolving: an empty symbol
table and no rows, so a caller that only wants the resolver's existing
scope check pays one `Bool` test per use site and nothing else.

Rows accumulate newest-first, the same shape the diagnostic list
already uses, and become columns once at the end of the walk. Keeping
the walk over a list is what lets the columns be built inside a single
function, where `Mutable` is masked.
""")]

import compiler.symtab
import compiler.usetab
import compiler.resolve_use

#[doc("Resolution accumulated across a resolver walk. `rows` is newest-first.")]
pub type ResState = { tab: SymTab, home: SymId, rows: [URow], on: Bool }

#[doc("An inert resolution state: use sites are walked but nothing is recorded.")]
pub fn rs_off() : ResState =
  ResState { tab: st_empty(), home: sym_none(), rows: [], on: false }

#[doc("A resolution state recording against `tab`, starting in the module named `home`.")]
pub fn rs_on(tab: SymTab, home: String) : ResState =
  ResState { tab: tab, home: rs_home_sym(tab, home), rows: [], on: true }

#[doc("The same state moved into the module named `home`, the one the next declaration belongs to.")]
pub fn rs_at_home(r: ResState, home: String) : ResState =
  ResState { tab: r.tab, home: rs_home_sym(r.tab, home), rows: r.rows, on: r.on }

# A home the table does not know declares nothing, so no declaration is
# owned by it and every contested use stays a candidate set.
fn rs_home_sym(tab: SymTab, home: String) : SymId = match st_module(tab, home) {
  Some(m) -> m
  None    -> sym_none()
}

#[doc("The same state with one more use site recorded.")]
pub fn rs_record(r: ResState, row: URow) : ResState =
  ResState { tab: r.tab, home: r.home, rows: [row, ...r.rows], on: r.on }

#[doc("The columnar use table for everything the walk recorded.")]
pub fn rs_uses(r: ResState) : UseTab = ut_of_rows(r.rows)

#[doc("How the state's current home is spelled. The walker that computes the next home reads names, not ids.")]
pub fn rs_home_name(r: ResState) : String = sym_name(r.tab, r.home)

#[doc("True when the state is recording.")]
pub fn rs_recording(r: ResState) : Bool = r.on

#[doc("The declaration `name` reaches from this state's home, or `None` when nothing declares it or the bare name is contested.")]
pub fn rs_decl_sym(r: ResState, name: String) : Option[SymId] =
  match ru_value(r.tab, name, r.home, false) {
    URSym(i) -> Some(SymId(i))
    _        -> None
  }
