#[doc("The resolver's running state and the resolution of `use`.")]

import compiler.symtab
import compiler.scope_view
import compiler.ast_ids
import compiler.modules_paths
import compiler.util
import compiler.written
import compiler.core_builtins

#[doc("Resolution accumulated across a resolver walk. `view` is the scope view of the file the walk is inside.")]
pub(pkg) type ResState = { tab: SymTab, home: SymId, on: Bool,
                      views: FileViews, view: ScopeView, prelude: [String],
                      # Effects whose operations a bare name may mean: the file's, then a block's.
                      use_file: [SymId], opens: [SymId],
                      # The core `nursery` function, and whether a call of it was read.
                      nursery: SymId, nursery_used: Bool,
                      # The binders read and written as cells: a `var`, and a `State` or `Reader` handler's alias.
                      cells: [LocalId], vars: Bool, aliased: Bool,
                      # The core `while`, `until` and `repeat` a literal loop call lowers to an intrinsic, and the `loop` module itself.
                      loops: [SymId], loop_home: SymId }

#[doc("An inert resolution state: use sites are walked but nothing is recorded.")]
pub(pkg) fn rs_off() : ResState =
  ResState { tab: st_empty(), home: sym_none(), on: false,
             views: fv_empty(), view: sv_of_home(sym_none()), prelude: [], use_file: [], opens: [], nursery: sym_none(), nursery_used: false, cells: [], vars: false, aliased: false, loops: [], loop_home: sym_none() }

#[doc("A resolution state recording against `tab`, starting in the module named `home`, with every file seeing only its own declarations.")]
pub(pkg) fn rs_on(tab: SymTab, home: String) : ResState =
  rs_on_views(tab, fv_empty(), home, [])

#[doc("A resolution state recording against `tab`, whose files resolve under `views`, starting in the module named `home`. `prelude` names the builtins every file sees without importing them.")]
pub(pkg) fn rs_on_views(tab: SymTab, views: FileViews, home: String,
      prelude: [String]) : ResState {
  let m = st_module_id(home)
  ResState { tab: tab, home: rs_known(tab, m), on: true,
             views: views, view: fv_of(views, m), prelude: prelude, use_file: [], opens: [], nursery: core_nursery_fn(tab), nursery_used: false, cells: [], vars: false, aliased: false,
             loops: core_loop_fns(tab), loop_home: core_loop_home(tab) }
}

#[doc("The same state moved into the module named `home`, the one the next declaration belongs to. The view follows: a declaration resolves under the imports of the file that declares it.")]
pub(pkg) fn rs_at_home(r: ResState, home: String) : ResState {
  let m = st_module_id(home)
  ResState { ...r, home: rs_known(r.tab, m), view: fv_of(r.views, m) }
}

# A home the table does not know declares nothing, so no declaration is
# owned by it and every contested use stays a candidate set.
fn rs_known(tab: SymTab, m: SymId) : SymId = if st_valid(tab, m) { m } else { sym_none() }

#[doc("How the state's current home is spelled. The walker that computes the next home reads names, not ids.")]
pub(pkg) fn rs_home_name(r: ResState) : String = written_text(sym_name(r.tab, r.home))

#[doc("Whether the module named `home` is the state's own home, one its file imports, or a core.")]
pub(pkg) fn rs_sees_home(r: ResState, home: String) : Bool = match st_module(r.tab, home) {
  Some(m) -> sym_raw(m) == sym_raw(r.home) or sv_sees(r.view, m)
  None    -> false
}

#[doc("""
The id `name` reaches when declared in class `cls` inside the state's
current home. A registration site asks this to bind the chain to the
same identity the table already minted, rather than a placeholder the
chain would have to re-resolve at every use.

`sym_none()` when the state is not recording, the home is unknown to
the table (a lint or test path with no whole-program build), or the
class genuinely has no such declaration there — the chain still binds
the name for shadowing, just with no identity behind it.
""")]
pub(pkg) fn rs_decl_owner_sym(r: ResState, cls: NCls, name: String) : SymId =
  match st_lookup(r.tab, cls, name, r.home) {
    Some(s) -> s
    None    -> sym_none()
  }

#[doc("""
The effect a handler head names: a qualifier picks that module's
declaration outright, a bare name climbs the file's scope ladder.

`sym_none()` when nothing declares it, or when two modules do and the
head names neither — the contested case a diagnostic already reports.
""")]
pub(pkg) fn rs_effect_sym(r: ResState, name: String) : SymId =
  match split_dotted_qualifier(name) {
    Some(QSplit(m, bare)) -> match st_module(r.tab, m) {
      Some(mh) -> rs_sym_or_none(st_lookup(r.tab, NCEffect, bare, mh))
      None     -> sym_none()
    }
    None -> match st_lookup(r.tab, NCEffect, name, r.home) {
      Some(s) -> s
      None    -> rs_effect_on_ladder(r, name)
    }
  }

fn rs_effect_on_ladder(r: ResState, name: String) : SymId =
  match sv_resolve(r.tab, r.view, NCEffect, name) {
    SvSym(s) -> s
    _        -> sym_none()
  }

fn rs_sym_or_none(o: Option[SymId]) : SymId = match o {
  Some(s) -> s
  None    -> sym_none()
}

#[doc("True when the state is recording.")]
pub(pkg) fn rs_recording(r: ResState) : Bool = r.on

#[doc("""
The declaration `name` reaches from this state's home, or `None` when
nothing declares it, the bare name is contested, or the name is one the
type decides rather than the scope.

A prelude builtin sits on the core rung: a declaration the reader's
module makes, picks or imports shadows it, and the name is stamped with
that declaration. Where none does, the name is stamped with the
builtin's own row.

A constructor stays unstamped on purpose: which variant a bare `Ok`
names is decided by the type its use site sits under — a return type, an
annotation, a scrutinee — and the builtin constructors it competes with
are not declarations this table holds. Fixing an answer here would
settle, from a partial candidate set, a question the typer answers from
the full one.

A protocol dispatcher is the same shape. One `__proto_show` stands for
every `show` any protocol declares, and which impl a call reaches is
decided by its receiver's type. Binding it to the declaration the
scope walk happened to reach would answer, from the scope, a question
only the type can settle.
""")]
pub(pkg) fn rs_decl_sym(r: ResState, name: String) : Option[SymId] =
  if rs_type_decides(name) { None }
  else if list_has(r.prelude, name) { rs_near_decl(r, name) }
  else {
    match ru_value_in(r.tab, r.view, name, false) {
      URSym(i) -> rs_stampable(r.tab, SymId(i))
      _        -> None
    }
  }

#[doc("True when the bare value name `name` reaches a declaration under this state's scope view, or a set of them the type narrows. A declaration another module keeps private is not reached.")]
pub(pkg) fn rs_reaches(r: ResState, name: String) : Bool = match rs_decl_sym(r, name) {
  Some(_) -> true
  None    -> match ru_value_in(r.tab, r.view, name, false) {
    URCands(_) -> true
    _          -> false
  }
}

#[doc("The function the qualified use `m.name` reaches: the one module `m` declares under `name`, or `None` when it declares none or the name is one the type decides.")]
pub(pkg) fn rs_qualified_fn(r: ResState, m: String, name: String) : Option[SymId] =
  if rs_type_decides(name) { None }
  else {
    match ru_qualified_class(r.tab, NCFn, m, name) {
      URSym(i) -> Some(SymId(i))
      _        -> None
    }
  }

# The synthesised dispatcher a protocol op lowers to. It is one
# declaration standing for every impl, so the scope has no answer to
# give about it.
fn rs_type_decides(name: String) : Bool = rs_has_prefix(name, "__proto_")

fn rs_has_prefix(name: String, p: String) : Bool = {
  let n = string_length(p)
  string_length(name) > n and string_slice(name, 0, n) == p
}

fn rs_near_decl(r: ResState, name: String) : Option[SymId] =
  match sv_resolve_near(r.tab, r.view, ru_value_classes(), name) {
    SvSym(s) -> rs_stampable(r.tab, s)
    SvNone   -> rs_builtin(r, name)
    _        -> None
  }

#[doc("The core builtin `name` is, when the table declares one and no module declares a value of that name: what a prelude name reaches once no nearer rung answers. A name some module also declares is left to the type, which picks among every candidate.")]
pub(pkg) fn rs_builtin(r: ResState, name: String) : Option[SymId] = {
  let s = builtin_sym(name)
  if st_valid(r.tab, s) and not rs_declared(r.tab, st_by_name(r.tab, name)) { Some(s) } else { None }
}

fn rs_declared(tab: SymTab, cands: [SymId]) : Bool = match cands {
  [] -> false
  [s, ...rest] -> match sym_class(tab, s) {
    NCFn    -> true
    NCConst -> true
    NCCtor  -> true
    _       -> rs_declared(tab, rest)
  }
}

fn rs_stampable(tab: SymTab, s: SymId) : Option[SymId] =
  match sym_class(tab, s) {
    NCCtor -> None
    _      -> Some(s)
  }

#[doc("Where a call's climb over the declaration rungs ended: a declaration the use is stamped with, a name left to the type (a constructor, a contest on one rung), no rung at all, or the core rung, whose builtin answers any arity.")]
pub(pkg) type RsAt = RcSym(SymId) | RcBare | RcNone | RcCore

#[doc("A climb's answer, and the nearest declaration it passed over because the call's arity did not fit it.")]
pub(pkg) type RsCall = RsCall(RsAt, Option[SymId])

#[doc("""
The declaration `name` reaches over `rungs` when `fits` says which
candidates the use may take. A builtin is a core binding that answers
any arity: the core rung answers with the builtin itself, and nearer
rungs climb as for any other name.
""")]
pub(pkg) fn rs_call_sym(r: ResState, name: String, rungs: [SvRung], fits: (SymId) -> Bool) : RsCall =
  if rs_type_decides(name) { RsCall(RcBare, None) }
  else if list_has(r.prelude, name) { rs_builtin_call(r, name, rungs, fits) }
  else if rs_minted(name) { rs_minted_call(r.tab, name) }
  else { rs_call_at(r.tab, sv_resolve_fit(r.tab, r.view, rungs, ru_value_classes(), name, fits)) }

fn rs_builtin_call(r: ResState, name: String, rungs: [SvRung], fits: (SymId) -> Bool) : RsCall =
  if rs_has_rung(rungs, SvCores) { RsCall(RcCore, None) }
  else { rs_call_at(r.tab, sv_resolve_fit(r.tab, r.view, rungs, ru_value_classes(), name, fits)) }

fn rs_has_rung(rungs: [SvRung], want: SvRung) : Bool = match rungs {
  [] -> false
  [r, ...rest] -> rs_same_rung(r, want) or rs_has_rung(rest, want)
}

fn rs_same_rung(a: SvRung, b: SvRung) : Bool = match a {
  SvOwn     -> match b { SvOwn -> true  _ -> false }
  SvPicks   -> match b { SvPicks -> true  _ -> false }
  SvImports -> match b { SvImports -> true  _ -> false }
  SvCores   -> match b { SvCores -> true  _ -> false }
  SvAny     -> match b { SvAny -> true  _ -> false }
}

fn rs_call_at(tab: SymTab, f: SvFit) : RsCall = match f {
  SvFit(SvSym(s), sk)   -> RsCall(rs_stamp_at(tab, s), sk)
  SvFit(SvAmbig(_), sk) -> RsCall(RcBare, sk)
  SvFit(_, sk)          -> RsCall(RcNone, sk)
}

# A derive body calls the writer or impl it minted for a field's type,
# which may be private to that type's module; privacy guards what a user
# spells, not these. A minted name carries its home whenever two modules
# would mint the same one, so it names one declaration.
fn rs_minted_call(tab: SymTab, name: String) : RsCall = match st_candidates(tab, NCFn, name) {
  [s] -> RsCall(rs_stamp_at(tab, s), None)
  _   -> RsCall(RcNone, None)
}

fn rs_minted(name: String) : Bool =
  rs_has_prefix(name, "__binser_put_") or rs_has_prefix(name, "__pimpl_")

fn rs_stamp_at(tab: SymTab, s: SymId) : RsAt = match rs_stampable(tab, s) {
  Some(s1) -> RcSym(s1)
  None     -> RcBare
}

#[doc("True when the declaration `s` lives in a core module: a binding the user never wrote.")]
pub(pkg) fn rs_is_core_sym(r: ResState, s: SymId) : Bool = sv_is_core(r.view, sym_owner(r.tab, s))

#[doc("True when the state's current home is a core module.")]
pub(pkg) fn rs_in_core(r: ResState) : Bool = sv_is_core(r.view, r.home)

#[doc("What the resolver decided a use site names. `URPrivate` carries the home of a declaration that exists but the use site cannot reach.")]
pub(pkg) type UseRes
  = URLocal
  | URSym(Int)
  | URCands([Int])
  | URUnres
  | URPrivate(Int)

fn ru_of(r: SvRes) : UseRes = match r {
  SvSym(s)     -> URSym(sym_raw(s))
  SvAmbig(ss)  -> URCands(ru_raw(ss))
  SvNone       -> URUnres
  SvPrivate(s) -> URPrivate(sym_raw(s))
}

# Value names live in three declaration classes: a function, a
# constant, or a variant constructor. They share one namespace at a use
# site, so a value lookup climbs the rungs once over all three rather
# than resolving each class apart and picking between the answers.
#[doc("The classes a bare value name answers to: a function, a constant or a constructor.")]
pub(pkg) fn ru_value_classes() : [NCls] = [NCFn, NCConst, NCCtor]

#[doc("Resolve the value name `name`, used under the scope view `v`, given whether a binder in scope shadows it.")]
pub(pkg) fn ru_value_in(t: SymTab, v: ScopeView, name: String, shadowed: Bool) : UseRes =
  if shadowed { URLocal }
  else { ru_of(sv_resolve_any(t, v, ru_value_classes(), name)) }

#[doc("Resolve the value name `name`, used inside the module symbol `home`, given whether a binder in scope shadows it. The home alone is the view: a caller with no import structure sees only its own module.")]
pub(pkg) fn ru_value(t: SymTab, name: String, home: SymId, shadowed: Bool) : UseRes =
  ru_value_in(t, sv_of_home(home), name, shadowed)

fn ru_raw(ids: [SymId]) : [Int] = match ids {
  []           -> []
  [s, ...rest] -> [sym_raw(s), ...ru_raw(rest)]
}

#[doc("Resolve the qualified use `mod.name` in class `cls`: the declaration the module named `mod` homes, ignoring every other home.")]
pub(pkg) fn ru_qualified_class(t: SymTab, cls: NCls, modn: String, name: String) : UseRes =
  ru_of(sv_qualified(t, cls, modn, name))

#[doc("What a scope binds a name to: a declaration, or a local binder.")]
pub(pkg) type Bound = BDecl(SymId) | BLocal(LocalId)

pub(pkg) type ChBind = ChBind(String, Bound)

pub(pkg) type ChIndex = { all: [ChBind], buckets: Array[[ChBind]], nb: Int }

#[doc("A stack of scopes, innermost first, the outermost scope's folded bindings, and the next local id to mint.")]
pub(pkg) type ScopeChain = { scopes: [[ChBind]], root: ChIndex, next_local: Int }

#[doc("A chain with one empty scope and no locals minted yet.")]
pub(pkg) fn ch_new() : ScopeChain =
  ScopeChain { scopes: [[]],
               root: ChIndex { all: [], buckets: array_make(0, []), nb: 0 },
               next_local: 1 }

#[doc("The same chain with a fresh innermost scope.")]
pub(pkg) fn ch_push(c: ScopeChain) : ScopeChain = match c.scopes {
  [top] -> if ch_at_least(top, 16) { ch_fold(c, top) } else { ch_pushed(c) }
  _     -> ch_pushed(c)
}

fn ch_pushed(c: ScopeChain) : ScopeChain =
  ScopeChain { scopes: [[], ...c.scopes], root: c.root, next_local: c.next_local }

fn ch_fold(c: ScopeChain, top: [ChBind]) : ScopeChain =
  ScopeChain { scopes: [[], []], root: ch_index(list_append(top, c.root.all)),
               next_local: c.next_local }

fn ch_at_least(bs: [ChBind], n: Int) : Bool =
  if n == 0 { true } else { match bs {
    [] -> false
    [_, ...rest] -> ch_at_least(rest, n - 1)
  } }

fn ch_index(all: [ChBind]) : ChIndex {
  let nb = ch_nbuckets(list_length(all), 16)
  ChIndex { all: all, buckets: ch_fill(list_reverse(all), array_make(nb, []), nb), nb: nb }
}

fn ch_nbuckets(n: Int, nb: Int) : Int = if nb >= 2 * n { nb } else { ch_nbuckets(n, 2 * nb) }

# Filled oldest first, so each bucket lists the newest binding of a name first.
fn ch_fill(bs: [ChBind], a: Array[[ChBind]], nb: Int) : Array[[ChBind]] / Mutable = match bs {
  [] -> a
  [b, ...rest] -> {
    let i = st_slot(ch_name(b), nb)
    ch_fill(rest, array_set(a, i, [b, ...array_get(a, i)]), nb)
  }
}

fn ch_name(b: ChBind) : String = match b { ChBind(n, _) -> n }

#[doc("The same chain with its innermost scope discarded. Popping the last scope is a no-op, so an unbalanced walk cannot empty the chain.")]
pub(pkg) fn ch_pop(c: ScopeChain) : ScopeChain = match c.scopes {
  [_, ...rest] -> match rest {
    [] -> c
    _  -> ScopeChain { scopes: rest, root: c.root, next_local: c.next_local }
  }
  [] -> c
}

#[doc("Bind `name` to `b` in the innermost scope, shadowing whatever the outer scopes bind it to.")]
pub(pkg) fn ch_bind(c: ScopeChain, name: String, b: Bound) : ScopeChain = match c.scopes {
  [top, ...rest] ->
    ScopeChain { scopes: [[ChBind(name, b), ...top], ...rest], root: c.root,
                 next_local: c.next_local }
  [] -> c
}

#[doc("The same chain whose next local id is `n`.")]
pub(pkg) fn ch_with_next_local(c: ScopeChain, n: Int) : ScopeChain =
  ScopeChain { scopes: c.scopes, root: c.root, next_local: n }

#[doc("The id the next `ch_declare_local` binds.")]
pub(pkg) fn ch_next_local(c: ScopeChain) : LocalId = LocalId(c.next_local)

#[doc("Declare `name` as a local binder: mint a fresh id and bind it in the innermost scope.")]
pub(pkg) fn ch_declare_local(c: ScopeChain, name: String) : ScopeChain =
  ch_bind(ScopeChain { scopes: c.scopes, root: c.root, next_local: c.next_local + 1 },
          name, BLocal(LocalId(c.next_local)))

#[doc("Bind `name` to the binder `l`, which already carries its id. The counter steps past a numbered one, so no later binder takes the same id.")]
pub(pkg) fn ch_bind_local(c: ScopeChain, name: String, l: LocalId) : ScopeChain = {
  let next = if local_raw(l) >= c.next_local { local_raw(l) + 1 } else { c.next_local }
  ch_bind(ScopeChain { scopes: c.scopes, root: c.root, next_local: next }, name, BLocal(l))
}

#[doc("What `name` reaches, walking innermost scope outward, or `None` when nothing binds it.")]
pub(pkg) fn ch_lookup(c: ScopeChain, name: String) : Option[Bound] = match ch_walk(c.scopes, name) {
  Some(b) -> Some(b)
  None    -> ch_probe(c.root, name)
}

fn ch_walk(ss: [[ChBind]], name: String) : Option[Bound] = match ss {
  [] -> None
  [top, ...rest] -> match ch_in(top, name) {
    Some(b) -> Some(b)
    None    -> ch_walk(rest, name)
  }
}

fn ch_in(bs: [ChBind], name: String) : Option[Bound] = match bs {
  [] -> None
  [ChBind(n, b), ...rest] -> if n == name { Some(b) } else { ch_in(rest, name) }
}

fn ch_probe(ix: ChIndex, name: String) : Option[Bound] =
  if ix.nb == 0 { None } else { ch_in(array_get(ix.buckets, st_slot(name, ix.nb)), name) }

#[doc("Every local binder of `name` in scope, innermost first.")]
pub(pkg) fn ch_locals(c: ScopeChain, name: String) : [LocalId] = ch_locals_in(c.scopes, name)

fn ch_locals_in(ss: [[ChBind]], name: String) : [LocalId] = match ss {
  [] -> []
  [top, ...rest] -> list_append(ch_locals_of(top, name), ch_locals_in(rest, name))
}

fn ch_locals_of(bs: [ChBind], name: String) : [LocalId] = match bs {
  [] -> []
  [ChBind(n, BLocal(l)), ...rest] -> if n == name { [l, ...ch_locals_of(rest, name)] } else { ch_locals_of(rest, name) }
  [_, ...rest] -> ch_locals_of(rest, name)
}

#[doc("True when `name` is bound anywhere in the chain.")]
pub(pkg) fn ch_has(c: ScopeChain, name: String) : Bool = match ch_lookup(c, name) {
  Some(_) -> true
  None    -> false
}

#[doc("True when a local binder shadows `name`. A declaration bound in the outermost scope does not shadow itself.")]
pub(pkg) fn ch_shadows(c: ScopeChain, name: String) : Bool = match ch_lookup(c, name) {
  Some(BLocal(_)) -> true
  _               -> false
}

#[doc("Every name the chain binds, innermost first. Only the did-you-mean suggestion reads this.")]
pub(pkg) fn ch_names(c: ScopeChain) : [String] =
  list_append(ch_names_loop(c.scopes, []), ch_scope_names(c.root.all))

fn ch_names_loop(ss: [[ChBind]], acc: [String]) : [String] = match ss {
  [] -> acc
  [top, ...rest] -> ch_names_loop(rest, list_append(acc, ch_scope_names(top)))
}

fn ch_scope_names(bs: [ChBind]) : [String] = match bs {
  [] -> []
  [ChBind(n, _), ...rest] -> [n, ...ch_scope_names(rest)]
}

fn sct_names() : [String] =
  ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o",
   "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z", "b", "k"]

fn sct_bind_all(c: ScopeChain, ns: [String], i: Int) : ScopeChain = match ns {
  [] -> c
  [n, ...rest] -> sct_bind_all(ch_bind(c, n, BDecl(SymId(i))), rest, i + 1)
}

fn sct_flat() : ScopeChain = sct_bind_all(ch_new(), sct_names(), 0)

fn sct_raw(o: Option[Bound]) : Int = match o {
  Some(BDecl(s))  -> sym_raw(s)
  Some(BLocal(_)) -> 0 - 99
  None            -> 0 - 100
}

fn sct_agree(a: ScopeChain, b: ScopeChain, ns: [String]) : Bool = match ns {
  [] -> true
  [n, ...rest] ->
    if sct_raw(ch_lookup(a, n)) == sct_raw(ch_lookup(b, n)) { sct_agree(a, b, rest) }
    else { false }
}

fn sct_index_agrees() : Bool {
  let flat = sct_flat()
  sct_agree(flat, ch_push(flat), ["zz", ...sct_names()])
}

fn sct_newest_wins() : Bool {
  let folded = ch_push(sct_flat())
  let rebound = ch_bind(ch_pop(folded), "k", BDecl(SymId(99)))
  sct_raw(ch_lookup(folded, "k")) == 27 and sct_raw(ch_lookup(folded, "zz")) == 0 - 100
    and sct_raw(ch_lookup(ch_push(rebound), "k")) == 99
}

fn sct_local_shadows() : Bool {
  let inner = ch_declare_local(ch_push(sct_flat()), "c")
  ch_shadows(inner, "c") and ch_shadows(ch_pop(inner), "c") == false
    and sct_raw(ch_lookup(ch_pop(inner), "c")) == 2
}

fn sct_names_keep_order() : Bool = ch_names(ch_push(sct_flat())) == ch_names(sct_flat())

#[doc("Runs every scope chain gate. Returns the empty string on success, the failed property otherwise.")]
pub(pkg) fn scope_chain_selftest() : String =
  if sct_index_agrees() == false { "the outermost-scope index disagrees with a scan" }
  else if sct_newest_wins() == false { "a name bound twice did not reach its newest binding" }
  else if sct_local_shadows() == false { "a local did not shadow a folded global" }
  else if sct_names_keep_order() == false { "folding reordered the chain's names" }
  else { "" }
