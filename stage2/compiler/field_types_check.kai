#[doc("""
`--check-field-types`: every field read of a program the typer accepted
carries the type of the field it reads.

A read left without one is looked up by name at run time, where a value
with no such field stops the program.
""")]

import compiler.ast
import compiler.decl_bodies
import compiler.util
import compiler.expr_positions
import compiler.symtab
import compiler.site_ids_check

#[doc("Report each field read the typer left untyped; the exit status is the number found. `tab` names the declaration a finding is in.")]
pub fn check_field_types(decls: [Decl], tab: SymTab) : Int / Console = {
  let found = flat_map(decls, (d) => ftc_bad(decl_bodies(d), decl_label(d, tab), []))
  each(found, (m) => eprint(m))
  list_length(found)
}

fn ftc_bad(es: [Expr], d: String, acc: [String]) : [String] = match es {
  [] -> acc
  [e, ...rest] -> {
    let next = list_append(map(xp_positions(e), (p) => match p { XP(_, c) -> c }), rest)
    match ftc_untyped(e) {
      Some(f) -> ftc_bad(next, d, [ftc_msg(d, f, e), ...acc])
      None    -> ftc_bad(next, d, acc)
    }
  }
}

# The field `e` reads, when it is a read with no type.
fn ftc_untyped(e: Expr) : Option[String] = match e.kind {
  EField(_, f) -> match e.ty {
    Some(TyAny) -> Some(f)
    None        -> Some(f)
    _           -> None
  }
  _ -> None
}

fn ftc_msg(d: String, f: String, e: Expr) : String =
  concat_all(["untyped field .", f, " in ", d, " at ", int_to_string(e.line), ":", int_to_string(e.col)])
