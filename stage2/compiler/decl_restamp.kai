#[doc("""Declaration identity after the typer's cache.

A cached typed module is stored with its declaration-level `SymId`s
dropped: they index the symbol table of the build that stamped them, and
the cache keys on the stored bytes, so carrying them would re-key every
module whenever an unrelated declaration shifts the table. An `ESym` keeps
its id, which the key covers.

The consequence is that a warm build reaches every later pass with
`fnid_none()` / `sym_none()` on its functions, types, effects and
protocols, while a cold build reaches them stamped. This pass gives the
warm build the ids the resolver minted for this build: the same
`(class, name, home)` lookup `resolve` does, against the same table.

A declaration that already carries an id keeps it, so a cold build is
unchanged.
""")]

import compiler.ast
import compiler.decl_names
import compiler.home_spell
import compiler.modules
import compiler.resolve_state
import compiler.symtab

#[doc("`ds` with every top-level function, type, effect and protocol that lost its id looked up again in `tab`. `target` names the root module.")]
pub fn restamp_decls(tab: SymTab, target: String, ds: [Decl]) : [Decl] =
  restamp_loop(rs_on(tab, target), target, ds, [])

fn restamp_loop(r: ResState, target: String, ds: [Decl], acc: [Decl]) : [Decl] = match ds {
  [] -> list_reverse(acc)
  [d, ...rest] -> {
    let at = rs_at_home(r, decl_home_hint_reset(d, rs_home_name(r), target))
    restamp_loop(at, target, rest, [restamp_one(at, d), ...acc])
  }
}

fn restamp_one(r: ResState, d: Decl) : Decl = match d {
  DFn(p, n, tps, ps, rt, row, b, l, c, mo, fid) ->
    if sym_raw(fnid_sym(fid)) >= 0 { d }
    else { DFn(p, n, tps, ps, rt, row, b, l, c, mo, fnid_decl(rs_decl_owner_sym(r, NCFn, n))) }
  DType(p, n, tps, b, l, c, mo, sl, s) ->
    if sym_raw(s) >= 0 { d }
    else { DType(p, n, tps, b, l, c, mo, sl, rs_decl_owner_sym(r, NCType, n)) }
  DEffect(p, n, tps, ops, db, l, c, mo, s) ->
    if sym_raw(s) >= 0 { d }
    else { DEffect(p, n, tps, ops, db, l, c, mo, rs_decl_owner_sym(r, NCEffect, hs_display(n, mo))) }
  DProtocol(p, n, tps, ops, l, c, mo, s) ->
    if sym_raw(s) >= 0 { d }
    else { DProtocol(p, n, tps, ops, l, c, mo, rs_decl_owner_sym(r, NCProtocol, n)) }
  DProtoLaws(th, inner, l, c, mo) -> DProtoLaws(th, restamp_one(r, inner), l, c, mo)
  DImplAxiom(th, inner, l, c, mo) -> DImplAxiom(th, restamp_one(r, inner), l, c, mo)
  DConstructor(inner, l, c)       -> DConstructor(restamp_one(r, inner), l, c)
  _ -> d
}
