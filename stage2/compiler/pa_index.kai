# Hash index over the privacy table.
#
# `pa_decide` and `pa_leak_kind` both filter the whole table down to
# one name's entries and only then apply their rule, so both are a
# scan over every top-level symbol in the program for every reference
# the enumerator yields. The index answers "this name's entries" and
# leaves the two rules untouched.
#
# Entry order within a name decides the verdict: `pa_decide` reports
# the FIRST private carrier it meets, so a bucket chain must preserve
# the table's source order. `idx_prepend` builds newest-first, so the
# table is indexed back to front and the chain comes out in source
# order. A hash collision mixes foreign names into a chain; both
# readers re-test `name`, so it costs a comparison, never a verdict.

import compiler.infer_index
import compiler.pub_access_table

#[doc("Hash index from a symbol name to its privacy-table entries, in source order.")]
pub type PaIndex = { ix: NameIndex[PaEntry] }

#[doc("Index a privacy table so each name's entries are reachable without scanning it.")]
pub fn pai_build(table: [PaEntry]) : PaIndex =
  PaIndex { ix: pai_add_rev(list_reverse(table), idx_empty()) }

fn pai_add_rev(rev: [PaEntry], ix: NameIndex[PaEntry]) : NameIndex[PaEntry] = match rev {
  []           -> ix
  [e, ...rest] -> pai_add_rev(rest, idx_prepend(ix, e.name, e))
}

#[doc("The entries registered under `name`, in source order; empty when the name is absent.")]
pub fn pai_entries(px: PaIndex, name: String) : [PaEntry] =
  idx_chain(px.ix, name)
