# compiler/fmt_expr.kai — the expression, statement and handle walkers of
# `kai fmt`.
#
# They recurse into one another and into compiler/fmt_form.kai (types, rows,
# parameters, patterns); the two modules are one declared import cycle.

import compiler.util
import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.written
import compiler.operators
import compiler.marks
import compiler.builtins
import compiler.fmt_writer
import compiler.fmt_shape
import compiler.fmt_layout
import compiler.fmt_form

# m7b #11: `handle { body } with Eff[tyargs](init) as alias { clauses }`.
# Each of `[tyargs]`, `(init)`, `as alias` is optional; the parser
# accepts them in that order. Renders block-style with the body and
# clause list each on their own indented lines.
fn fmt_handle(body: Expr, eff: DeclRef, eff_tyargs: [TypeExpr], init_opt: Option[Expr], alias_opt: Option[Binder], clauses: [HClause], ret_opt: Option[HReturn], s: FmtSt) : FmtSt {
  let s1 = fmt_emit(s, "handle {")
  let s2 = fmt_newline(s1)
  let s3 = fmt_indent_in(s2)
  # Inline the body's contents when it is a block; otherwise emit as
  # a single expression. Without this, `handle { body }` round-trips
  # to `handle { { body } }` because `fmt_expr` on an EBlock opens
  # its own braces.
  let s4 = match body.kind {
    EBlock(stmts, tail) -> fmt_block_inner(stmts, tail, s3)
    _                   -> fmt_expr(body, s3)
  }
  let s5 = fmt_ensure_newline(s4)
  let s6 = fmt_indent_out(s5)
  let s7 = fmt_emit(s6, "} with ")
  let s8 = fmt_emit(s7, fmt_ref_text(s7, eff))
  let s9 = fmt_type_arg_list(eff_tyargs, fmt_first_type_line(eff_tyargs), s8)
  # The handler state has two spellings that share this slot: `(init)`
  # and `initially { }`. Only the `(init)` form prints beside the
  # effect name; the clause form prints inside the block below.
  let init_clause = handle_init_clause(init_opt)
  let s10 = fmt_handle_init(init_opt, init_clause, s9)
  let s11 = fmt_handle_alias(alias_opt, s10)
  let s12 = fmt_emit(s11, " {")
  let s13 = fmt_newline(s12)
  let s14 = fmt_handle_initially(init_clause, fmt_indent_in(s13))
  let s15 = fmt_hclauses(clauses, s14)
  let s16 = match ret_opt {
    None    -> s15
    Some(r) -> fmt_hreturn(r, s15)
  }
  let s17 = fmt_indent_out(s16)
  fmt_emit(s17, "}")
}

# `(init)`, printed only when the author used that spelling.
fn fmt_handle_init(init_opt: Option[Expr], init_clause: Option[Expr], s: FmtSt) : FmtSt =
  match init_clause {
    Some(_) -> s
    None -> match init_opt {
      None     -> s
      Some(ie) -> {
        let a = fmt_emit(s, "(")
        let b = fmt_expr(ie, a)
        fmt_emit(b, ")")
      }
    }
  }

fn fmt_handle_alias(alias_opt: Option[Binder], s: FmtSt) : FmtSt = match alias_opt {
  None    -> s
  Some(b) -> fmt_emit(s, string_concat(" as ", written_text(b.name)))
}

# `initially { ... }`, the clause spelling of the same slot.
fn fmt_handle_initially(init_clause: Option[Expr], s: FmtSt) : FmtSt = match init_clause {
  None -> s
  Some(inner) -> {
    let a = fmt_emit(s, "initially ")
    fmt_newline(fmt_expr(inner, a))
  }
}

pub(pkg) fn fmt_hclauses(cs: [HClause], s: FmtSt) : FmtSt = match cs {
  []           -> s
  [c, ...rest] -> {
    let s1 = fmt_hclause(c, fmt_drain_before(s, hclause_line(c)))
    let s2 = fmt_drain_trailing_after(s1, hclause_trailing_limit(c, rest))
    fmt_hclauses(rest, fmt_newline(s2))
  }
}

# `op_name(params) -> body` — the trailing param is conventionally
# the `resume` continuation. Body uses block form when it is itself
# an EBlock so the result stays readable.
#
# A lifecycle clause (`finally { ... }`, param-less) prints in its own
# brace form: printing it as `finally() -> ...` would not reparse.
fn fmt_hclause(c: HClause, s: FmtSt) : FmtSt = match c {
  HC(head, params, body, line, _) ->
    if fmt_is_lifecycle_clause(head) {
      let s1 = fmt_emit(s, clause_head_word(head))
      let s2 = fmt_emit(s1, " ")
      fmt_expr(body, s2)
    } else {
      fmt_param_seq(params, line, fmt_emit(s, clause_head_word(head)), (t) => fmt_arrow_body(body, fmt_emit(t, " ->")))
    }
}

# `-> body` and `= body` share one shape: the body hangs off the arrow.
# A comment between the arrow and the body forces the hang, so the
# comment lands on its own line above the body.
fn fmt_arrow_body(body: Expr, s: FmtSt) : FmtSt {
  let head = fmt_leftmost(body)
  let broken = fmt_starts_line(s, head.line, head.col) or fmt_comment_pending_before(s, head.line)
  fmt_hang(s, broken, (t) => fmt_expr(body, t))
}

# `return(pname) -> body` — optional clause at the end of a handler
# (or default { }) block. Same body-rendering convention as fmt_hclause.
pub(pkg) fn fmt_hreturn(r: HReturn, s: FmtSt) : FmtSt = match r {
  HR(b, body, line, _) -> {
    let s1 = fmt_emit(fmt_drain_before(s, line), "return(")
    let s2 = fmt_emit(s1, written_text(b.name))
    fmt_newline(fmt_arrow_body(body, fmt_emit(s2, ") ->")))
  }
}

# ---- fn decls -------------------------------------------------------

fn fmt_bool_text(b: Bool) : String = if b { "true" } else { "false" }

# A call node prints as a call only when it is one: the pipe-placeholder
# desugar and the literal desugars (`3i`, `~r/../`) reach the writer as
# calls and must print back as what the author wrote.
fn fmt_call_form(e: Expr, callee: Expr, call_args: [Expr], s: FmtSt, tail: (FmtSt) -> FmtSt) : FmtSt =
  match fmt_region_operand(callee, call_args) {
    Some(operand) -> tail(fmt_region(operand, s))
    None -> match fmt_coalesce_operands(callee, call_args) {
     Some(ops) -> tail(fmt_coalesce(ops, s))
     None -> match fmt_pipe_under(callee, call_args) {
      Some(_) -> fmt_pipes(e, s, tail)
      None -> match fmt_call_literal(callee, call_args) {
        Some(lit) -> tail(fmt_emit(s, lit))
        None      -> tail(fmt_call(callee, call_args, e.line, s))
      }
     }
    }
  }

# `lhs ?? rhs` reaches the writer as a call of the `??` mark.
fn fmt_coalesce_operands(callee: Expr, call_args: [Expr]) : Option[[Expr]] = match callee.kind {
  EMark(MkCoalesce) -> match call_args {
    [_, _] -> Some(call_args)
    _      -> None
  }
  _ -> None
}

fn fmt_coalesce(ops: [Expr], s: FmtSt) : FmtSt = match ops {
  [l, r] -> {
    let s1 = fmt_emit(fmt_expr_atom(l, s), " ?? ")
    match r.kind {
      ECall(c, _) -> if fmt_is_coalesce_callee(c) { fmt_expr(r, s1) } else { fmt_expr_atom(r, s1) }
      EBang(_) -> fmt_expr(r, s1)
      _ -> fmt_expr_atom(r, s1)
    }
  }
  _ -> s
}

# The operand of a `region { }` block: the block itself, or the lambda
# whose parameter names the region.
fn fmt_region_operand(callee: Expr, call_args: [Expr]) : Option[Expr] = match callee.kind {
  EMark(MkRegion) -> match call_args {
    [operand] -> Some(operand)
    _         -> None
  }
  _ -> None
}

# Printed as a call, the block would parse back as a call of a function
# named `region`.
fn fmt_region(operand: Expr, s: FmtSt) : FmtSt = match operand.kind {
  ELambda(_, _) -> fmt_lam_block(operand, false, fmt_emit(s, "region "))
  _             -> fmt_expr(operand, fmt_emit(s, "region "))
}

# `.fld` point-free: the placeholder and the access share one dot.
fn fmt_field(obj: Expr, fld: String, s: FmtSt) : FmtSt = match obj.kind {
  EPlaceholder -> fmt_emit(fmt_emit(s, "."), fld)
  _ -> {
    let s1 = fmt_expr_atom(obj, s)
    let s2 = fmt_emit(s1, ".")
    fmt_emit(s2, fld)
  }
}

# A `__pl` binder means the author wrote a point-free section, not a
# lambda; restore the section rather than printing the desugar.
fn fmt_lambda_form(params: [Param], body: Expr, s: FmtSt) : FmtSt =
  match fmt_placeholder_body(params, body) {
    Some(pf_body) -> fmt_expr(pf_body, s)
    None          -> fmt_lambda(params, body, s)
  }

pub(pkg) fn fmt_expr(e: Expr, s: FmtSt) : FmtSt = fmt_expr_then(e, s, (t) => t)

# `tail` is what follows the expression on its line (` {` after an
# `if` condition, a signature's return type): a chain-headed expression
# counts it when deciding whether it fits. A dead probe has its verdict
# already, so the walk stops here.
fn fmt_expr_then(e: Expr, s: FmtSt, tail: (FmtSt) -> FmtSt) : FmtSt =
  if fmt_probe_dead(s) { s }
  else {
    let s0 = fmt_drain_before(s, fmt_leftmost(e).line)
    match e.kind {
      EBinop(op, l, r) -> fmt_binop(op, l, r, e, s0, tail)
      EPipe(_, _) -> fmt_pipes(e, s0, tail)
      EDispatchPipe(_, _, _) -> fmt_pipes(e, s0, tail)
      ECall(callee, call_args) -> fmt_call_form(e, callee, call_args, s0, tail)
      _ -> tail(fmt_expr_plain(e, s0))
    }
  }

fn fmt_expr_plain(e: Expr, s0: FmtSt) : FmtSt {
  match e.kind {
    EInt(v, raw) -> fmt_emit(s0, int_lit_text(v, raw))
    EReal(_, raw) -> fmt_emit(s0, raw)
    EFixed(span, ty) -> fmt_emit(s0, string_concat(span, fmt_fixed_suffix(ty)))
    EIntLit(span) -> fmt_emit(s0, span)
    EDecimalLit(span) -> fmt_emit(s0, string_concat(span, "d"))
    EBool(b) -> fmt_emit(s0, fmt_bool_text(b))
    EChar(c) -> match char_spelling_at(s0.chars, e.line, e.col) {
      Some(raw) -> fmt_emit(s0, raw)
      None      -> fmt_emit(s0, string_concat_all(["'", char_to_escaped(c), "'"]))
    }
    EStr(raw, _) -> fmt_emit(s0, raw)
    EUnit -> fmt_emit(s0, "()")
    EName(name) -> fmt_emit(s0, written_text(name))
    EMark(m) -> fmt_emit(s0, mark_name(m))
    ESym(sym, _) -> fmt_emit(s0, fmt_sym_text(s0, sym))
    ELocal(l) -> fmt_emit(s0, fmt_local_text(s0, l))
    EOp(r) -> fmt_emit(s0, fmt_op_text(s0, r))
    EUnder -> fmt_emit(s0, "_")
    EPlaceholder -> fmt_emit(s0, ".")
    EHole(opt) -> fmt_hole(opt, s0)
    ETodo(msg) -> fmt_emit(s0, string_concat_all(["todo!(\"", msg, "\")"]))
    # An extern-fn body never reaches the expression formatter — extern
    # fns print as a `DAxiom` decl, whose body is synthesised only after
    # desugar. This arm exists for match exhaustiveness.
    EExternBody(_, _) -> fmt_emit(s0, "todo!(\"extern\")")
    EBang(inner) -> {
      let s1 = fmt_expr_atom(inner, s0)
      fmt_emit(s1, "!")
    }
    ECall(callee, call_args) -> fmt_call_form(e, callee, call_args, s0, (t) => t)
    EField(obj, fld) -> fmt_field(obj, fld, s0)
    EIndex(obj, idx) -> {
      let s1 = fmt_expr_atom(obj, s0)
      let s2 = fmt_emit(s1, "[")
      let s3 = fmt_expr(idx, s2)
      fmt_emit(s3, "]")
    }
    EBinop(op, l, r) -> fmt_binop(op, l, r, e, s0, (t) => t)
    EUnop(op, inner) -> {
      let s1 = match op {
        UoNot -> fmt_emit(s0, string_concat(unop_text(op), " "))
        UoNeg -> fmt_emit(s0, unop_text(op))
      }
      fmt_expr_atom(inner, s1)
    }
    EIf(c, then_e, else_opt) -> fmt_if(c, then_e, else_opt, s0)
    EMatch(scrut, arms) -> fmt_match(scrut, arms, s0)
    ELambda(params, body) -> fmt_lambda_form(params, body, s0)
    ERecordLit(r, fields) -> fmt_record_lit(fmt_ref_text(s0, r), fields, e.line, s0)
    EList(elems) -> fmt_list(elems, e.line, s0)
    ERange(lo, hi, step) -> fmt_range(lo, hi, step, s0)
    EBlock(stmts, tail) -> fmt_block(stmts, tail, s0)
    EPipe(_, _) -> fmt_pipes(e, s0, (t) => t)
    EDispatchPipe(_, _, _) -> fmt_pipes(e, s0, (t) => t)
    # m12.5: `100<USD>`, `2.5<m>` — numeric literal with unit annotation.
    ELitUnit(inner, u) -> {
      let s1 = fmt_expr_atom(inner, s0)
      let s2 = fmt_emit(s1, "<")
      let s3 = fmt_emit(s2, fmt_unit_expr_str(u))
      fmt_emit(s3, ">")
    }
    # m7b #11: `handle { body } with Eff[tyargs](init) as alias { clauses }`.
    # Any of `[tyargs]`, `(init)`, `as alias` is optional. Closes with
    # the clause block whose contents are `op(args) -> body` lines
    # plus an optional `return(x) -> body`.
    EHandle(body, eff, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) ->
      fmt_handle(body, eff, eff_tyargs, init_opt, alias_opt, clauses, ret_opt, s0)
    # `variants[T]()` — m12.8 utility expanding to a list of every
    # constructor of the union T. The second slot is a stage-internal
    # name list filled by the resolver; surface form re-renders only
    # the type argument.
    EVariantsOf(ty, _) -> {
      let s1 = fmt_emit(s0, "variants[")
      let s2 = fmt_type(ty, s1)
      fmt_emit(s2, "]()")
    }
    # A module-qualified name, not a call: the argument list belongs to
    # the enclosing `ECall`, if there is one. Printing `()` here turned
    # every such callee into a zero-arg call applied to its own arguments.
    EModCall(m, fname) -> fmt_emit(s0, string_concat_all([written_text(m), ".", written_text(fname)]))
    EIntrinsic(name, args_) -> fmt_call(
      Expr { kind: EName(written(string_concat("$", intrinsic_name(name)))), line: e.line, col: e.col, ty: None, mode: MUnknown,  site: e.site },
      args_, e.line, s0)
    ESurface(sf) -> fmt_surface(sf, e, s0)
  }
}

# A settled perform as the source reaches it: through the effect's name,
# or through the alias or capability that holds the instance.
fn fmt_op_text(s: FmtSt, r: OpRef) : String = {
  let head = match r.via {
    ViaAmbient  -> fmt_sym_text(s, r.eff)
    ViaAlias(l) -> fmt_local_text(s, l)
    ViaRecv(l)  -> fmt_local_text(s, l)
  }
  string_concat_all([head, ".", written_text(r.op)])
}

# Surface forms print exactly what the author wrote. `SfContract` is
# body-position only and `fmt_fn` intercepts it before the expression
# walker can reach one.
fn fmt_surface(sf: SurfaceForm, e: Expr, s: FmtSt) : FmtSt = match sf {
  SfEnsure(value, pred) -> fmt_ensure(value, pred, e, s)
  SfContract(_, _, _) -> panic("kai fmt: contract clauses outside a fn body")
  SfLamBlock(lam, trailing) -> fmt_lam_block(lam, trailing, s)
  SfTuple(elems) -> fmt_expr_seq("(", ")", false, false, elems, e.line, s)
  SfHandleInit(_) -> panic("kai fmt: initially clause outside a handler")
  SfBigIntLit(digits) -> fmt_emit(s, string_concat(digits, "n"))
  SfRefMake(inner) -> fmt_expr_atom(inner, fmt_emit(s, "&"))
  SfDeref(target) -> fmt_expr(target, fmt_emit(s, "@"))
  SfMultiMatch(scruts, arms) -> {
    let s1 = fmt_emit(s, "match ")
    let s3 = fmt_scrut_list(scruts, s1)
    let s4 = fmt_indent_in(fmt_newline(s3))
    let s5 = fmt_mmarms(arms, "if", false, s4)
    fmt_emit(fmt_indent_out(s5), "}")
  }
  SfCaseBlock(arms) -> {
    let s1 = fmt_emit(s, "{")
    let s2 = fmt_indent_in(fmt_newline(s1))
    let s3 = fmt_mmarms(arms, "when", true, s2)
    fmt_emit(fmt_indent_out(s3), "}")
  }
  SfMapLit(spread, flat)  -> fmt_spread_lit("%{", "}", spread, flat, fmt_map_entries, e, s)
  SfSetLit(spread, elems) -> fmt_spread_lit("%[", "]", spread, elems, fmt_expr_items, e, s)
  SfFieldPun(_) -> panic("kai fmt: field pun outside a record literal")
  SfSteppedRange(first, second, last) -> fmt_stepped_range(first, second, last, s)
  SfEndlessRange(first, second) -> fmt_endless_range(first, second, s)
  SfLazy(bracket) -> fmt_expr(bracket, fmt_emit(s, "lazy "))
  SfInterp(span, _, _, _) -> fmt_emit(s, span)
}

# `ensure(v) where <pred>` — the predicate carries the same receiver
# elision a refinement does, minted at the `ensure` token's position.
fn fmt_ensure(value: Expr, pred: Expr, e: Expr, s: FmtSt) : FmtSt {
  let s1 = fmt_emit(s, "ensure(")
  let s2 = fmt_expr(value, s1)
  let s3 = fmt_emit(s2, ") where ")
  match fmt_elision_at(e.line, e.col, pred) {
    Some(RE(lead, rhs)) -> fmt_expr(rhs, fmt_emit(s3, lead))
    None                -> fmt_expr(pred, s3)
  }
}

# `%{ ...base, k: v }` and `%[ ...base, e ]` are one shape: an opener, an
# optional spread, then elements. Only the delimiters and the element
# printer differ, so both spellings share this emitter — the empty form
# closes tight (`%{}`), every other form pads inside its delimiters.
fn fmt_spread_lit(open: String, close: String, spread: Option[Expr], elems: [Expr],
                  items: ([Expr]) -> [SeqItem], e: Expr, s: FmtSt) : FmtSt {
  let head = match spread {
    None -> []
    Some(base) -> [SeqItem(base.line, (t) => fmt_expr(base, fmt_emit(t, "...")))]
  }
  let style = SeqStyle { open: open, close: close, pad: true, fill: false, hug: false }
  fmt_seq(s, style, e.line, list_append(head, items(elems)), (t) => t)
}

# The scrutinees of a multi-match, closed by the ` {` of the arm block.
fn fmt_scrut_list(es: [Expr], s: FmtSt) : FmtSt = match es {
  [] -> fmt_emit(s, " {")
  [e] -> fmt_head_expr(e, s, (t) => fmt_emit(t, " {"))
  [e, ...rest] -> fmt_scrut_list(rest, fmt_head_expr(e, s, (t) => fmt_emit(t, ", ")))
}

# Multi-pattern arms; the guard keyword differs by form (`if` in a
# multi-scrutinee match, `when` in a case-block) and a case-block arm
# opens with the `case` keyword.
fn fmt_mmarms(arms: [MMArm], guard_kw: String, case_led: Bool, s: FmtSt) : FmtSt =
  match arms {
    [] -> s
    [a, ...rest] ->
      fmt_mmarms(rest, guard_kw, case_led,
                 fmt_newline(fmt_drain_trailing_after(fmt_mmarm(a, guard_kw, case_led, s),
                                                      mmarm_trailing_limit(a, rest))))
  }

fn fmt_mmarm(a: MMArm, guard_kw: String, case_led: Bool, s: FmtSt) : FmtSt = match a {
  MMArm(pats, guard, body) -> {
    let s0 = match pats {
      [p, ..._more] -> fmt_drain_before(s, p.line)
      [] -> s
    }
    let s1 = if case_led { fmt_emit(s0, "case ") } else { s0 }
    let s2 = fmt_pat_list(pats, s1)
    let s3 = match guard {
      None -> s2
      Some(g) -> fmt_expr(g, fmt_emit(s2, string_concat_all([" ", guard_kw, " "])))
    }
    fmt_arrow_body(body, fmt_emit(s3, " ->"))
  }
}

# `k1: v1, k2: v2` from the flattened `[k1, v1, k2, v2, ...]` list.
fn fmt_map_entries(flat: [Expr]) : [SeqItem] = match flat {
  [] -> []
  [k, v, ...rest] -> [SeqItem(k.line, (t) => fmt_map_entry(k, v, t)), ...fmt_map_entries(rest)]
  _ -> panic("kai fmt: map literal with an odd entry list")
}

fn fmt_expr_items(es: [Expr]) : [SeqItem] = map(es, (x) => SeqItem(fmt_leftmost(x).line, (t) => fmt_expr(x, t)))

# A delimited expression list; `fill` packs scalar rows, `hug` lets a
# block-like last element open on the head line.
fn fmt_expr_seq(open: String, close: String, fill: Bool, hug: Bool, es: [Expr], open_line: Int, s: FmtSt) : FmtSt =
  fmt_expr_seq_then(open, close, fill, hug, es, open_line, s, (t) => t)

fn fmt_expr_seq_then(open: String, close: String, fill: Bool, hug: Bool, es: [Expr], open_line: Int, s: FmtSt, tail: (FmtSt) -> FmtSt) : FmtSt {
  let style = SeqStyle { open: open, close: close, pad: false, fill: fill and fmt_all_scalar(es), hug: hug and fmt_last_is_block_like(es) }
  fmt_seq(s, style, open_line, fmt_expr_items(es), tail)
}

fn fmt_map_entry(k: Expr, v: Expr, s: FmtSt) : FmtSt {
  let s1 = fmt_expr(k, s)
  let s2 = fmt_emit(s1, ": ")
  fmt_expr(v, s2)
}

# A lambda the author wrote as a block: `{ body }`, `{ params -> body }`,
# or `{ pat -> body }` (the destructuring form, recovered from its
# synthetic single-arm match). Prints on one line when the source kept
# the body on the `{`'s own line; expands otherwise. A zero-arity block
# in plain expression position keeps its `->` — without it the braces
# re-parse as an ordinary block, not a lambda.
fn fmt_lam_block(lam: Expr, trailing: Bool, s: FmtSt) : FmtSt = match lam.kind {
  ELambda(params, body) -> match lam_block_wrap_arm(params, body) {
    # The head parses back only when it opens with `(`: a tuple pattern
    # prints its own parens, anything else prints paren-grouped
    # (`(Some(n))`).
    Some(Arm(pat, _, abody)) -> {
      let s1 = fmt_emit(s, "{ ")
      let s2 = match pat.pkind {
        PSurface(PsTuple(_)) -> fmt_pat(pat, s1)
        _                    -> fmt_emit(fmt_pat(pat, fmt_emit(s1, "(")), ")")
      }
      let s3 = fmt_emit(s2, " ->")
      fmt_lam_block_body(abody, lam.line, s3)
    }
    None -> match params {
      [] -> {
        let s1 = if trailing { fmt_emit(s, "{") } else { fmt_emit(s, "{ ->") }
        fmt_lam_block_body(body, lam.line, s1)
      }
      _  -> {
        let names = map(params, (pm) => written_text(pm.binder.name))
        let s1 = fmt_emit(s, concat_all(["{ ", string_join(names, ", "), " ->"]))
        fmt_lam_block_body(body, lam.line, s1)
      }
    }
  }
  _ -> fmt_expr(lam, s)
}

# Body of a block lambda, after the `{` (and optional `params ->`)
# prefix. One line only when the whole body sat on the `{`'s source
# line — a single tail expression or a single statement.
fn fmt_lam_block_body(body: Expr, headline: Int, s: FmtSt) : FmtSt = match body.kind {
  EBlock(stmts, tail) -> match stmts {
    []   -> fmt_lam_block_tail(tail, headline, s)
    [st] -> match tail {
      None    -> fmt_lam_block_one(st, stmts, headline, s)
      Some(_) -> fmt_lam_block_expand(stmts, tail, s)
    }
    _ -> fmt_lam_block_expand(stmts, tail, s)
  }
  _ -> fmt_lam_block_inline(s, (t) => fmt_expr(body, t), (t) => fmt_lam_block_expand([], Some(body), t))
}

# ` body }` on the head line when it fits there, the expanded form
# otherwise.
fn fmt_lam_block_inline(s: FmtSt, body: (FmtSt) -> FmtSt, expand: (FmtSt) -> FmtSt) : FmtSt =
  match fmt_try_flat(s, (t) => fmt_emit(body(fmt_emit(t, " ")), " }")) {
    Some(r) -> r
    None -> expand(s)
  }

# An empty body closes on the head line; a lone tail expression stays
# inline only if the author wrote it there and it fits.
fn fmt_lam_block_tail(tail: Option[Expr], headline: Int, s: FmtSt) : FmtSt = match tail {
  None -> fmt_emit(s, " }")
  Some(t) ->
    if t.line == headline {
      fmt_lam_block_inline(s, (u) => fmt_expr(t, u), (u) => fmt_lam_block_expand([], tail, u))
    } else { fmt_lam_block_expand([], tail, s) }
}

fn fmt_lam_block_one(st: Stmt, stmts: [Stmt], headline: Int, s: FmtSt) : FmtSt =
  if stmt_line(st) == headline {
    fmt_lam_block_inline(s, (u) => fmt_stmt(st, u), (u) => fmt_lam_block_expand(stmts, None, u))
  } else { fmt_lam_block_expand(stmts, None, s) }

fn fmt_lam_block_expand(stmts: [Stmt], tail: Option[Expr], s: FmtSt) : FmtSt {
  let s1 = fmt_indent_in(fmt_newline(s))
  let s2 = fmt_block_inner(stmts, tail, s1)
  fmt_emit(fmt_indent_out(s2), "}")
}

# Atomic-or-paren wrapper: if `e` would print as a non-atomic
# expression at the top level (binop, lambda, match, if, pipe), wrap
# in parens. Used for sub-expressions of a call / field / index where
# precedence matters.
fn fmt_expr_atom(e: Expr, s: FmtSt) : FmtSt {
  if expr_is_atomic(e) {
    fmt_expr(e, s)
  } else {
    let s1 = fmt_emit(s, "(")
    let s2 = fmt_expr(e, s1)
    fmt_emit(s2, ")")
  }
}

# `callee(args) { trailing blocks }`; the argument list breaks one per
# line when it does not fit, a block-like last argument hugging the
# parenthesis instead. `open_line` is the source line of the `(`.
fn fmt_call(callee: Expr, call_args: [Expr], open_line: Int, s: FmtSt) : FmtSt {
  let n_trail = fmt_count_trailing(call_args, 0)
  let n_lead = list_length(call_args) - n_trail
  let blocks = fmt_args_drop(call_args, n_lead)
  let s1 = fmt_expr_atom(callee, s)
  if (n_trail > 0) and (n_lead == 0) { fmt_trailing_blocks(blocks, s1) }
  else {
    fmt_expr_seq_then("(", ")", false, true, fmt_args_take(call_args, n_lead), open_line, s1,
                      (t) => fmt_trailing_blocks(blocks, t))
  }
}

fn fmt_trailing_blocks(blocks: [Expr], s: FmtSt) : FmtSt = match blocks {
  [] -> s
  [b, ...rest] -> fmt_trailing_blocks(rest, fmt_expr(b, fmt_emit(s, " ")))
}

# A binary node prints as the chain it heads: `a + b + c` on one line
# when it fits, one operand per line otherwise, parenthesising only the
# operands the precedence ladder requires.
fn fmt_binop(op: BinOp, l: Expr, r: Expr, e: Expr, s: FmtSt, tail: (FmtSt) -> FmtSt) : FmtSt =
  match binop_chain(op, l, r, e.line, e.col) {
    Chain(first, links) -> {
      let head_op = match links {
        [ChainOp(o, _, _, _), ..._rest] -> o
        [] -> op
      }
      let lead = (t) => fmt_operand(first, head_op, false, t)
      let rest = map(links, (lk) => match lk {
        ChainOp(o, _, _, rhs) -> Link(binop_text(o), fmt_leftmost(rhs).line, (t) => fmt_operand(rhs, o, true, t))
      })
      fmt_chain(s, lead, rest, not chain_trails(links), fmt_chain_broken(s, links), tail)
    }
  }

# An operand that is itself a binary node takes parentheses only when
# the ladder demands them; any other non-atomic form keeps its own.
fn fmt_operand(x: Expr, parent_op: BinOp, is_right: Bool, s: FmtSt) : FmtSt = match x.kind {
  EBinop(child_op, _, _) ->
    if binop_operand_needs_parens(parent_op, child_op, is_right) { fmt_paren(x, s) }
    else { fmt_expr(x, s) }
  _ -> fmt_expr_atom(x, s)
}

fn fmt_paren(x: Expr, s: FmtSt) : FmtSt = fmt_emit(fmt_expr(x, fmt_emit(s, "(")), ")")

# `if c { a } else { b }` stays on one line when the author wrote every
# branch on the `if`'s line and the whole fits; otherwise, and whenever
# a branch holds more than one statement, the block form.
fn fmt_if(c: Expr, then_e: Expr, else_opt: Option[Expr], s: FmtSt) : FmtSt =
  if fmt_if_inline_written(fmt_leftmost(c).line, then_e, else_opt) {
    match fmt_try_flat(s, (t) => fmt_if_form(c, then_e, else_opt, fmt_branch_flat, t)) {
      Some(r) -> r
      None -> fmt_if_form(c, then_e, else_opt, fmt_brace_rest, s)
    }
  } else { fmt_if_form(c, then_e, else_opt, fmt_brace_rest, s) }

# `if c {` branch [` else {` branch | ` else ` if-chain]; `branch`
# renders one branch after its opening brace.
fn fmt_if_form(c: Expr, then_e: Expr, else_opt: Option[Expr], branch: (Expr, FmtSt) -> FmtSt, s: FmtSt) : FmtSt {
  let s1 = branch(then_e, fmt_stmt_head_expr(c, fmt_emit(s, "if ")))
  match else_opt {
    None -> s1
    Some(e) -> match e.kind {
      EIf(c2, t2, e2) ->
        fmt_if_form(c2, t2, e2, branch, fmt_drain_before(fmt_emit(s1, " else "), fmt_leftmost(e).line))
      _ -> branch(e, fmt_emit(s1, " else {"))
    }
  }
}

fn fmt_branch_flat(br: Expr, s: FmtSt) : FmtSt = match br.kind {
  EBlock(stmts, tail) -> match stmts {
    [st] -> fmt_emit(fmt_stmt(st, fmt_emit(s, " ")), " }")
    _ -> match tail {
      Some(t) -> fmt_emit(fmt_expr(t, fmt_emit(s, " ")), " }")
      None -> fmt_emit(s, " }")
    }
  }
  _ -> fmt_emit(fmt_expr(br, fmt_emit(s, " ")), " }")
}

# An if-condition / match-scrutinee, followed by its ` {`. One whose
# leftmost constituent is a record literal keeps delimiting
# parentheses: without them the literal's `{` is read as the start of
# the `if` / `match` block. The brace rides the fit of a chain head.
fn fmt_stmt_head_expr(e: Expr, s: FmtSt) : FmtSt = fmt_head_expr(e, s, (t) => fmt_emit(t, " {"))

fn fmt_head_expr(e: Expr, s: FmtSt, tail: (FmtSt) -> FmtSt) : FmtSt {
  if fmt_head_is_record_lit(e) {
    let s1 = fmt_emit(s, "(")
    let s2 = fmt_expr(e, s1)
    tail(fmt_emit(s2, ")"))
  } else {
    fmt_expr_then(e, s, tail)
  }
}

# The rest of a `{ ... }` body after its opening brace has been
# emitted: a block's statements below it, any other expression inline.
fn fmt_brace_rest(e: Expr, s: FmtSt) : FmtSt = match e.kind {
  EBlock(stmts, tail) -> fmt_block_rest(stmts, tail, s)
  _ -> fmt_branch_flat(e, s)
}

fn fmt_match(scrut: Expr, arms: [Arm], s: FmtSt) : FmtSt {
  let s1 = fmt_emit(s, "match ")
  let s3 = fmt_stmt_head_expr(scrut, s1)
  let s4 = fmt_newline(s3)
  let s5 = fmt_indent_in(s4)
  let s6 = fmt_arms(arms, s5)
  let s7 = fmt_indent_out(s6)
  fmt_emit(s7, "}")
}

fn fmt_arms(arms: [Arm], s: FmtSt) : FmtSt {
  match arms {
    [] -> s
    [a, ...rest] -> {
      let s1 = fmt_arm(a, fmt_drain_before(s, arm_line(a)))
      let s2 = fmt_drain_trailing_after(s1, arm_trailing_limit(a, rest))
      fmt_arms(rest, fmt_newline(s2))
    }
  }
}

fn fmt_arm(a: Arm, s: FmtSt) : FmtSt {
  match a {
    Arm(pat, guard, body) -> {
      let s1 = fmt_pat(pat, s)
      let s2 = match guard {
        None -> s1
        Some(g) -> {
          let a1 = fmt_emit(s1, " if ")
          fmt_expr(g, a1)
        }
      }
      fmt_arrow_body(body, fmt_emit(s2, " ->"))
    }
  }
}

fn fmt_lambda(params: [Param], body: Expr, s: FmtSt) : FmtSt {
  # A single untyped param prints bare (`x => ...`); a single *typed*
  # param needs parens (`(x: Int) => ...`) or the `:` re-parses as a
  # call-argument annotation rather than a lambda binder. Multiple
  # params always parenthesise.
  let s1 = match params {
    [p] -> match p.ptype {
      None -> fmt_lambda_param(p, s)
      Some(_) -> {
        let a = fmt_emit(s, "(")
        let b = fmt_lambda_param(p, a)
        fmt_emit(b, ")")
      }
    }
    _ -> {
      let a = fmt_emit(s, "(")
      let b = fmt_lambda_params(params, a)
      fmt_emit(b, ")")
    }
  }
  let s2 = fmt_emit(s1, " => ")
  if lam_body_needs_parens(body) {
    fmt_emit(fmt_expr(body, fmt_emit(s2, "(")), ")")
  } else {
    fmt_expr(body, s2)
  }
}

fn fmt_lambda_params(ps: [Param], s: FmtSt) : FmtSt {
  match ps {
    [] -> s
    [p] -> fmt_lambda_param(p, s)
    [p, ...rest] -> {
      let s1 = fmt_lambda_param(p, s)
      let s2 = fmt_emit(s1, ", ")
      fmt_lambda_params(rest, s2)
    }
  }
}

fn fmt_lambda_param(p: Param, s: FmtSt) : FmtSt {
  let s1 = fmt_emit(s, written_text(p.binder.name))
  match p.ptype {
    None -> s1
    Some(t) -> {
      let a = fmt_emit(s1, ": ")
      fmt_type(t, a)
    }
  }
}

fn fmt_record_lit(name: String, fields: [FieldInit], open_line: Int, s: FmtSt) : FmtSt {
  let style = SeqStyle { open: string_concat(name, " {"), close: "}", pad: true, fill: false, hug: false }
  let items = map(fields, (f) => match f { FI(_, x) -> SeqItem(fmt_leftmost(field_written(x)).line, (t) => fmt_record_field(f, t)) })
  fmt_seq(s, style, open_line, items, (t) => t)
}

# Each field prints its surface form back: `...src` for the spread
# slot, the bare value for a positional field, the bare name for a pun.
fn fmt_record_field(f: FieldInit, s: FmtSt) : FmtSt = match f {
  FI(name, e) -> fmt_field_init(name, e, s)
}

# Four spellings share the field slot: `...base`, a positional value, a
# pun (`x`), and the written-out `name: value`. A mark on the value
# tells the first two apart; a pun wraps its value in `SfFieldPun`.
fn fmt_field_init(name: String, e: Expr, s: FmtSt) : FmtSt =
  match field_spread_value(e) {
    Some(src) -> fmt_expr(src, fmt_emit(s, "..."))
    None -> match field_pos_value(e) {
      Some(v) -> fmt_expr(v, s)
      None -> match field_pun_value(e) {
        Some(_) -> fmt_emit(s, name)
        None -> {
          let s1 = fmt_emit(s, name)
          let s2 = fmt_emit(s1, ": ")
          fmt_expr(e, s2)
        }
      }
    }
  }

fn fmt_list(elems: [ListElem], open_line: Int, s: FmtSt) : FmtSt {
  let style = SeqStyle { open: "[", close: "]", pad: false, fill: fmt_all_scalar_elems(elems), hug: false }
  let items = map(elems, (el) => match el {
    ElPlain(x) -> SeqItem(fmt_leftmost(x).line, (t) => fmt_expr(x, t))
    ElSpread(x) -> SeqItem(x.line, (t) => fmt_expr(x, fmt_emit(t, "...")))
  })
  fmt_seq(s, style, open_line, items, (t) => t)
}

fn fmt_range(lo: Expr, hi: Expr, step: Option[Expr], s: FmtSt) : FmtSt {
  # `..` only parses in select contexts when bare; the `[ ]` form is
  # accepted everywhere a list literal is, so we canonicalise to it.
  let s0 = fmt_emit(s, "[")
  let s1 = fmt_expr_atom(lo, s0)
  let s2 = fmt_emit(s1, "..")
  let s3 = fmt_expr_atom(hi, s2)
  let s4 = match step {
    None -> s3
    Some(st) -> {
      let a = fmt_emit(s3, "..")
      fmt_expr_atom(st, a)
    }
  }
  fmt_emit(s4, "]")
}

fn fmt_stepped_range(first: Expr, second: Expr, last: Expr, s: FmtSt) : FmtSt {
  let s1 = fmt_emit(fmt_expr(first, fmt_emit(s, "[")), ", ")
  let s2 = fmt_emit(fmt_expr_atom(second, s1), "..")
  fmt_emit(fmt_expr_atom(last, s2), "]")
}

fn fmt_endless_range(first: Expr, second: Option[Expr], s: FmtSt) : FmtSt = match second {
  None      -> fmt_emit(fmt_expr_atom(first, fmt_emit(s, "[")), "..]")
  Some(sec) -> fmt_emit(fmt_expr_atom(sec, fmt_emit(fmt_expr(first, fmt_emit(s, "[")), ", ")), "..]")
}

fn fmt_block(stmts: [Stmt], tail: Option[Expr], s: FmtSt) : FmtSt =
  fmt_block_rest(stmts, tail, fmt_emit(s, "{"))

# The statements and closing brace of a block whose `{` is already out.
pub(pkg) fn fmt_block_rest(stmts: [Stmt], tail: Option[Expr], s: FmtSt) : FmtSt {
  let s2 = fmt_newline(s)
  let s3 = fmt_indent_in(s2)
  let s4 = fmt_block_inner(stmts, tail, s3)
  let s5 = fmt_indent_out(s4)
  fmt_emit(s5, "}")
}

pub(pkg) fn fmt_block_inner(stmts: [Stmt], tail: Option[Expr], s: FmtSt) : FmtSt {
  let last_limit = match tail {
    None -> 0
    Some(e) -> e.line
  }
  let s1 = fmt_stmts(stmts, s, last_limit)
  let s6 = match tail {
    None -> s1
    Some(e) -> {
      let s2 = fmt_ensure_newline(s1)
      let s2a = fmt_keep_blank(s2, stmts_last_line(stmts), fmt_leftmost(e).line)
      let s3 = fmt_drain_before(s2a, fmt_leftmost(e).line)
      let s4 = fmt_expr(e, s3)
      let s5 = fmt_drain_trailing_after(s4, fmt_leftmost(e).line + 1)
      fmt_ensure_newline(s5)
    }
  }
  fmt_drain_block_close(s6, block_first_line(stmts, tail), block_last_line(stmts, tail))
}

# A comment closing a block body belongs to the body, not to whatever
# follows the brace: without a drain here the next node's drain claims
# it, and the comment silently changes what it documents.
fn fmt_drain_block_close(s: FmtSt, first: Int, last: Int) : FmtSt =
  if last > 0 { fmt_drain_block_upto(s, last, fmt_close_line_at(s, first)) } else { s }

fn fmt_drain_block_upto(s: FmtSt, last: Int, close: Int) : FmtSt =
  if (close > last) and block_owns_pending(s, last, close) {
    fmt_ensure_newline(fmt_drain_before_close(s, last, close))
  } else {
    s
  }

# True when the comments still pending run from just below the body's
# last element to the closing brace with only blank or comment lines
# between: proof they were written inside this block. A body laid out
# on one source line records no interior of its own, so the close it
# reports is an enclosing block's — and some line between the two
# carries that outer block's code, which is what this rejects.
fn block_owns_pending(s: FmtSt, last: Int, close: Int) : Bool =
  fmt_comment_pending_before(s, close) and block_gap_is_clear(s, last + 1, close)

fn block_gap_is_clear(s: FmtSt, line: Int, close: Int) : Bool =
  if line >= close { true }
  else if fmt_line_is_blank(s, line) { block_gap_is_clear(s, line + 1, close) }
  else { false }

# The source line a block's first element opens on, 0 for an empty
# block. It is the block's own interior, so the close recorded for it
# is this block's brace — not an enclosing one, as the last element's
# line can be once the width model re-breaks a one-line block.
fn block_first_line(stmts: [Stmt], tail: Option[Expr]) : Int = match stmts {
  [st, ..._rest] -> stmt_line(st)
  [] -> match tail {
    Some(e) -> e.line
    None -> 0
  }
}

# The source line a block's last element opens on, 0 for an empty
# block.
fn block_last_line(stmts: [Stmt], tail: Option[Expr]) : Int = match tail {
  Some(e) -> e.line
  None -> stmts_last_line(stmts)
}

fn fmt_stmts(stmts: [Stmt], s: FmtSt, last_limit: Int) : FmtSt =
  fmt_stmts_loop(stmts, s, last_limit, 0)

# `prev` is the previous statement's source line, or 0 for the first:
# a blank the author left between the two is reproduced, collapsed to
# one. Starting at 0 is what keeps a blank opening the block from
# being minted — there is no statement above the first to space it from.
fn fmt_stmts_loop(stmts: [Stmt], s: FmtSt, last_limit: Int, prev: Int) : FmtSt {
  match stmts {
    [] -> s
    [st, ...rest] -> if fmt_probe_dead(s) { s } else {
      let line = stmt_line(st)
      let s0 = fmt_keep_blank(s, prev, line)
      let s1 = fmt_drain_before(s0, line)
      let s2 = fmt_stmt(st, s1)
      let s2a = fmt_drain_trailing_after(s2, stmts_trailing_limit(st, rest, last_limit))
      let s3 = fmt_ensure_newline(s2a)
      fmt_stmts_loop(rest, s3, last_limit, line)
    }
  }
}

# One blank line when the author left an empty source line above the
# next thing to be emitted. That thing is the statement, or a comment
# still pending above it — the blank belongs over the comment, and the
# drain reproduces any further gap below it.
fn fmt_keep_blank(s: FmtSt, prev: Int, line: Int) : FmtSt {
  if (prev > 0) and fmt_blank_between(s, prev + 1, fmt_next_emit_line(s, line)) {
    fmt_blank_line(s)
  } else {
    s
  }
}

# The line the next emitted thing sits on: the first comment pending
# above `line`, else `line` itself.
fn fmt_next_emit_line(s: FmtSt, line: Int) : Int = match s.cmts {
  [] -> line
  [Cmt(cl, _, _, _), ..._rest] -> if cl < line { cl } else { line }
}

fn fmt_blank_between(s: FmtSt, from: Int, to: Int) : Bool =
  if from >= to { false }
  else if fmt_line_is_blank(s, from) { true }
  else { fmt_blank_between(s, from + 1, to) }

# The line of a block's last statement, 0 when it has none: a tail
# expression alone in its block has nothing above it to space from.
fn stmts_last_line(stmts: [Stmt]) : Int = match stmts {
  [] -> 0
  [st] -> stmt_line(st)
  [_, ...rest] -> stmts_last_line(rest)
}

fn fmt_stmt(st: Stmt, s: FmtSt) : FmtSt {
  match st {
    SLet(pat, ty_opt, e) -> {
      let s1 = fmt_emit(s, "let ")
      let s2 = fmt_pat(pat, s1)
      let s3 = match ty_opt {
        None -> s2
        Some(t) -> {
          let a = fmt_emit(s2, ": ")
          fmt_type(t, a)
        }
      }
      fmt_assign_body(e, fmt_emit(s3, " ="))
    }
    SAssert(e, _) -> {
      let s1 = fmt_emit(s, "assert ")
      fmt_expr(e, s1)
    }
    SExprStmt(e) -> fmt_expr(e, s)
    # m7b #6: `a[i] := v` — indexed write. Surface form mirrors the
    # parser exactly (Stmt definition near line 1460).
    SIndexAssign(base, idx, val, _, _) -> {
      let s1 = fmt_expr(base, s)
      let s2 = fmt_emit(s1, "[")
      let s3 = fmt_expr(idx, s2)
      fmt_assign_body(val, fmt_emit(s3, "] :="))
    }
    # Scalar / field write `lhs := v` — surface form of the `.set`
    # call, printed as written.
    SAssign(lhs, val, _, _) -> {
      let s1 = fmt_expr(lhs, s)
      fmt_assign_body(val, fmt_emit(s1, " :="))
    }
    # m7b #5: local mutable cell `var name [: T] = init`.
    SVar(b, ty_opt, rhs, _, _) -> {
      let s1 = fmt_emit(s, "var ")
      let s2 = fmt_emit(s1, written_text(b.name))
      let s3 = match ty_opt {
        None -> s2
        Some(t) -> {
          let a = fmt_emit(s2, ": ")
          fmt_type(t, a)
        }
      }
      fmt_assign_body(rhs, fmt_emit(s3, " :="))
    }
    # m7e §25: `use Effect` at block scope.
    SUse(eff_name, _, _) -> fmt_emit(s, string_concat("use ", eff_name))
  }
}

# The right-hand side of a binding hangs off its `=` / `:=`.
pub(pkg) fn fmt_assign_body(e: Expr, s: FmtSt) : FmtSt = fmt_arrow_body(e, s)

# ---- patterns -------------------------------------------------------

# A pipe node prints as the chain it heads: `xs |> f | g` on one line
# when it fits, one stage per line — operator leading — otherwise. The
# four pipes are left-associative at one level, so a pipe to the left
# needs no parentheses; every other stage prints as an atom.
fn fmt_pipes(e: Expr, s: FmtSt, tail: (FmtSt) -> FmtSt) : FmtSt = match pipe_chain(e) {
  Chain(first, links) -> {
    let rest = map(links, (lk) => match lk {
      ChainOp(o, _, _, rhs) -> Link(o, fmt_leftmost(rhs).line, (t) => fmt_stage(rhs, t))
    })
    fmt_chain(s, (t) => fmt_expr_atom(first, t), rest, true, fmt_chain_broken(s, links), tail)
  }
}

# A stage that uses `.` is a section lambda; it prints as its body.
fn fmt_stage(rhs: Expr, s: FmtSt) : FmtSt = match rhs.kind {
  ELambda(ps, body) -> match fmt_placeholder_body(ps, body) {
    Some(b) -> fmt_expr_atom(b, s)
    None    -> fmt_expr_atom(rhs, s)
  }
  _ -> fmt_expr_atom(rhs, s)
}
