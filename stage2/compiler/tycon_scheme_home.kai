#[doc("""
The module declaring each nominal type name, and the declaration's
identity, as a scheme-build-time table.

Every resolver that turns a source `TypeExpr` into a `Ty` for the
typer takes a view of this table and builds each `TyCon` from it: the
`SymId` of the declaration the written name denotes.

A name the stream declares more than once denotes what the scope chain
answers from the module reading it: a root `Pair` and `core.tuple.Pair`
are both bare here, and only the reader's view tells which one it sees.
Those answers are settled when the table is built, so the typer reads
decisions; the symbol table is kept only to spell a declaration's name.

A name no type declares may still be a nominal type: a union component
named only by its constructor. Its identity is that constructor's, read
from `component_ids`.
""")]

import compiler.ast
import compiler.util
import compiler.decl_names
import compiler.entry
import compiler.diag_file
import compiler.symtab
import compiler.scope_view
import compiler.scope_file
import compiler.symtab_build
import compiler.name_contest
import compiler.infer_index
import compiler.component_ids
import compiler.scalar_ty
import compiler.written

#[doc("One nominal type declaration: the module declaring it, its identity, and the module symbol owning it (`sym_none()` when the table does not hold it).")]
pub type TyHomeEntry = THE(Option[String], SymId, SymId)

#[doc("What a contested type name denotes from one reading module: the reader's home and the declaration the scope chain picks there for the name that declaration spells. A name the chain picks nothing for has no entry.")]
pub type TyRes = TyRes(String, SymId)

#[doc("The type-home table keyed by name, the settled readings of its contested names, the target module that owns untagged declarations, every function declaration keyed by its name, the scope view of each file, the constructors a component names, the same type declarations keyed by id, the symbol table a declaration's name is read from, and the root modules of the compile.")]
pub type TyHomes = TyHomes(NameIndex[TyHomeEntry], [TyRes], String, NameIndex[NEnt], FileViews, CompIds, NameIndex[TyHomeEntry], SymTab, Roots)

#[doc("The declaring module and identity of every nominal type in `ds`, with each contested name resolved from every module of `ds` under `views`. Aliases are absent: they are expanded before a slot could be read. `roots` are the compile's root modules, the target among them.")]
pub fn tsh_homes(ds: [Decl], tab: SymTab, views: FileViews, target: String, roots: Roots) : TyHomes =
  match tsh_loop(ds, tab, target, THAcc([], [])) {
    THAcc(es, contested) -> {
      let ents = nt_collect(ds, tab, target)
      TyHomes(tsh_type_index(tab, list_reverse(es), idx_empty()),
              tsh_settle(tab, views, tsh_readers(ds, target, [target]), contested, []), target,
              tsh_fn_index(nt_only(ents, NCFn), idx_empty()), views, comp_ids(ents, views),
              tsh_decl_index(es, idx_empty()), tab, roots)
    }
  }

#[doc("A table with no declarations: every slot stays empty and every id is `sym_none()`.")]
pub fn tsh_none() : TyHomes = TyHomes(idx_empty(), [], "", idx_empty(), fv_empty(), comp_none(), idx_empty(), st_empty(), roots_of("", []))

fn tsh_name(tab: SymTab, s: SymId) : String = written_text(sym_name(tab, s))

fn tsh_type_index(tab: SymTab, es: [TyHomeEntry], ix: NameIndex[TyHomeEntry]) : NameIndex[TyHomeEntry] = match es {
  []           -> ix
  [e, ...rest] -> match e { THE(_, s, _) -> tsh_type_index(tab, rest, idx_prepend(ix, tsh_name(tab, s), e)) }
}

fn tsh_decl_index(es: [TyHomeEntry], ix: NameIndex[TyHomeEntry]) : NameIndex[TyHomeEntry] = match es {
  []           -> ix
  [e, ...rest] -> match e {
    THE(_, s, _) -> tsh_decl_index(rest, if sym_raw(s) < 0 { ix } else { idx_prepend_sym(ix, s, e) })
  }
}

fn tsh_fn_index(es: [NEnt], ix: NameIndex[NEnt]) : NameIndex[NEnt] = match es {
  []           -> ix
  [e, ...rest] -> match e { NEnt(_, n, _, _, _) -> tsh_fn_index(rest, idx_prepend(ix, n, e)) }
}

fn tsh_fn_ents(ds: [Decl], tab: SymTab, target: String) : [NEnt] = nt_only(nt_collect(ds, tab, target), NCFn)

#[doc("Each function declaration of `ds` whose name another module also declares, as `name@home;`: what `tsh_fn_settled` reads beyond the reader's own module.")]
pub fn tsh_fn_contests(ds: [Decl], tab: SymTab, target: String) : String = {
  let es = tsh_fn_ents(ds, tab, target)
  tsh_contest_text(es, tsh_fn_index(es, idx_empty()), [])
}

fn tsh_contest_text(es: [NEnt], fx: NameIndex[NEnt], acc: [String]) : String = match es {
  [] -> concat_all(list_reverse(acc))
  [NEnt(_, n, h, _, _), ...rest] ->
    if list_length(nt_homes(idx_chain(fx, n), NCFn, n)) > 1 {
      tsh_contest_text(rest, fx, [concat_all([n, "@", h, ";"]), ...acc])
    } else { tsh_contest_text(rest, fx, acc) }
}

# The entries so far and the names more than one module declares.
type THAcc = THAcc([TyHomeEntry], [String])

fn tsh_loop(ds: [Decl], tab: SymTab, target: String, acc: THAcc) : THAcc = match ds {
  [] -> acc
  [d, ...rest] -> match decl_transparent_inner(d) {
    Some(inner) -> tsh_loop([inner, ...rest], tab, target, acc)
    None -> match d {
      DType(_, s, _, body, _, _, mo, _) -> match body {
        TBAlias(_)       -> tsh_loop(rest, tab, target, acc)
        TBEffectAlias(_) -> tsh_loop(rest, tab, target, acc)
        _                -> tsh_loop(rest, tab, target, tsh_record(tab, acc, mo, s))
      }
      # An effect names a type where a capability is passed as a value
      # (`fn f(e: Emit)`), so its declaration has to be reachable here or
      # that `TyCon` carries no identity.
      DEffect(_, s, _, _, _, _, _, mo) -> tsh_loop(rest, tab, target, tsh_record(tab, acc, mo, s))
      # A foreign struct's declaration holds no id slot; its id is the one
      # the symbol table derives for it.
      DExternType(nm, _, _, _, mo) ->
        tsh_loop(rest, tab, target, tsh_record(tab, acc, mo, sym_derive(NCExternType, nm, tsh_reader(mo, target))))
      _ -> tsh_loop(rest, tab, target, acc)
    }
  }
}

# A core segment is re-injected alongside its own declaration, so the
# same pair arrives twice; recording it once keeps the uniqueness test
# in `tsh_home_of` meaningful.
fn tsh_record(tab: SymTab, acc: THAcc, mo: Option[String], s: SymId) : THAcc = match acc {
  THAcc(es, cs) -> {
    let nm = tsh_name(tab, s)
    match tsh_find(tab, es, nm, mo) {
      Some(_) -> acc
      None    -> THAcc([THE(mo, s, sym_owner(tab, s)), ...es], tsh_note_contest(tab, es, cs, nm))
    }
  }
}

# A declaration spelled like a core type always contests it: the core one
# is the other candidate.
fn tsh_note_contest(tab: SymTab, es: [TyHomeEntry], cs: [String], nm: String) : [String] =
  if list_has(cs, nm) { cs }
  else if is_core_type(nm) { [nm, ...cs] }
  else { match tsh_named(tab, es, nm, []) {
    [] -> cs
    _  -> [nm, ...cs]
  } }

fn tsh_find(tab: SymTab, hs: [TyHomeEntry], nm: String, mo: Option[String]) : Option[SymId] = match hs {
  [] -> None
  [THE(m, s, _), ...rest] ->
    if tsh_same(m, mo) and tsh_name(tab, s) == nm { Some(s) } else { tsh_find(tab, rest, nm, mo) }
}

fn tsh_same(a: Option[String], b: Option[String]) : Bool = match a {
  None    -> match b { None -> true   Some(_) -> false }
  Some(x) -> match b { None -> false  Some(y) -> x == y }
}

fn tsh_named(tab: SymTab, hs: [TyHomeEntry], nm: String, acc: [SymId]) : [SymId] = match hs {
  [] -> acc
  [THE(_, s, _), ...rest] ->
    if tsh_name(tab, s) == nm { tsh_named(tab, rest, nm, [s, ...acc]) } else { tsh_named(tab, rest, nm, acc) }
}

# Every module that declares something in `ds`: the modules that can
# read a type name.
fn tsh_readers(ds: [Decl], target: String, acc: [String]) : [String] = match ds {
  [] -> acc
  [d, ...rest] -> {
    let r = tsh_reader(decl_home_module(d), target)
    tsh_readers(rest, target, if list_has(acc, r) { acc } else { [r, ...acc] })
  }
}

# `st_build` files untagged declarations under the target module.
fn tsh_reader(cur: Option[String], target: String) : String = match cur {
  Some(m) -> m
  None    -> target
}

fn tsh_settle(tab: SymTab, views: FileViews, readers: [String], names: [String],
      acc: [TyRes]) : [TyRes] = match readers {
  [] -> acc
  [r, ...rest] -> tsh_settle(tab, views, rest, names,
                             tsh_settle_at(tab, fv_of(views, st_module_id(r)), r, names, acc))
}

fn tsh_settle_at(tab: SymTab, sv: ScopeView, r: String, names: [String],
      acc: [TyRes]) : [TyRes] = match names {
  [] -> acc
  [n, ...rest] -> {
    let s = tsh_seen(tab, sv, n, tsh_resolve(tab, sv, n))
    tsh_settle_at(tab, sv, r, rest, if sym_raw(s) < 0 { acc } else { [TyRes(r, s), ...acc] })
  }
}

# A declaration the reader's file does not see leaves a core type's name
# to the core type.
fn tsh_seen(tab: SymTab, sv: ScopeView, nm: String, s: SymId) : SymId =
  if sym_raw(s) >= 0 and is_core_type(nm) and not sv_reaches(sv, sym_owner(tab, s), nm) { sym_none() }
  else { s }

# Types and effects share the type namespace, since a capability is
# annotated by its effect's name: one climb over both, so a module's own
# effect beats a core type of the same name.
fn tsh_resolve(tab: SymTab, sv: ScopeView, nm: String) : SymId =
  match sv_resolve_any(tab, sv, [NCType, NCEffect], nm) {
    SvSym(s) -> s
    _        -> tsh_resolve_type(tab, sv, nm)
  }

# A type and an effect tied on one rung: a written type position names the type.
fn tsh_resolve_type(tab: SymTab, sv: ScopeView, nm: String) : SymId =
  match sv_resolve(tab, sv, NCType, nm) {
    SvSym(s) -> s
    _        -> sym_none()
  }

fn tsh_reading(tab: SymTab, rs: [TyRes], r: String, nm: String) : SymId = match rs {
  [] -> sym_none()
  [TyRes(rr, s), ...rest] -> if rr == r and tsh_name(tab, s) == nm { s } else { tsh_reading(tab, rest, r, nm) }
}

#[doc("The table paired with the module reading a type name (`None` is the root file): what a bare type name there denotes.")]
pub type TyHomeView = THV(TyHomes, Option[String])

#[doc("The view of `hs` from the module `cur`.")]
pub fn tsh_view(hs: TyHomes, cur: Option[String]) : TyHomeView = THV(hs, cur)

#[doc("The same table read from the module `cur`.")]
pub fn tsh_at(v: TyHomeView, cur: Option[String]) : TyHomeView =
  match v { THV(hs, _) -> THV(hs, cur) }

#[doc("The declaration a bare `nm` denotes from the reading module of `v`: a type, or the constructor of a component no type declares; `sym_none()` when it denotes neither.")]
pub fn tsh_sym(v: TyHomeView, nm: String) : SymId = match v {
  THV(TyHomes(tx, rs, target, _, _, comps, _, tab, _), cur) -> {
    let s = tsh_type_sym(tab, tx, rs, tsh_reader(cur, target), nm)
    if sym_raw(s) >= 0 or tsh_is_scalar(nm) { s } else { comp_sym(comps, tsh_reader(cur, target), nm) }
  }
}

# A scalar is never a component: a constructor spelled `Int` leaves the
# type `Int` what it is.
fn tsh_is_scalar(nm: String) : Bool = match scalar_ty_named(nm) {
  Some(_) -> true
  None    -> false
}

fn tsh_type_sym(tab: SymTab, tx: NameIndex[TyHomeEntry], rs: [TyRes], reader: String, nm: String) : SymId =
  match tsh_named(tab, idx_chain(tx, nm), nm, []) {
    []  -> core_type_sym_or_none(nm)
    [s] -> if is_core_type(nm) { tsh_core_reading(tab, rs, reader, nm) } else { s }
    _   -> tsh_core_reading(tab, rs, reader, nm)
  }

# What the reader sees under `nm`, or the core type when it sees no declaration.
fn tsh_core_reading(tab: SymTab, rs: [TyRes], r: String, nm: String) : SymId = {
  let s = tsh_reading(tab, rs, r, nm)
  if sym_raw(s) >= 0 { s } else { core_type_sym_or_none(nm) }
}

#[doc("The module that owns the table's untagged declarations: the root file's.")]
pub fn tsh_target(hs: TyHomes) : String = match hs { TyHomes(_, _, t, _, _, _, _, _, _) -> t }

#[doc("The root modules of the compile the table was built for.")]
pub fn tsh_roots(hs: TyHomes) : Roots = match hs { TyHomes(_, _, _, _, _, _, _, _, r) -> r }

#[doc("True when a bare `nm` read from module `reader` names one function: the reader declares one, or at most one module does.")]
pub fn tsh_fn_settled(hs: TyHomes, nm: String, reader: String) : Bool = match hs {
  TyHomes(_, _, _, fx, _, _, _, _, _) -> {
    let homes = nt_homes(idx_chain(fx, nm), NCFn, nm)
    list_has(homes, reader) or list_length(homes) <= 1
  }
}

#[doc("True when a bare `nm` read from module `reader` may reach the function module `home` declares: the reader's file declares, picks, opens or sees it as a core.")]
pub fn tsh_fn_visible(hs: TyHomes, reader: String, home: String, nm: String) : Bool = match hs {
  TyHomes(_, _, _, _, views, _, _, _, _) -> sv_reaches(fv_of(views, st_module_id(reader)), st_module_id(home), nm)
}

#[doc("The identity of the type `nm` declared by module `mo` (`None` is the root file), or `sym_none()` when it declares none.")]
pub fn tsh_decl_sym(hs: TyHomes, mo: Option[String], nm: String) : SymId = match hs {
  TyHomes(tx, _, _, _, _, _, _, tab, _) -> match tsh_find(tab, idx_chain(tx, nm), nm, mo) {
    Some(s) -> s
    None    -> sym_none()
  }
}

#[doc("The module that declares the type `s`, the root file's read as the target module; `None` when the table holds no type `s`.")]
pub fn tsh_decl_home(hs: TyHomes, s: SymId) : Option[String] = match hs {
  TyHomes(_, _, target, _, _, _, dx, _, _) -> match tsh_entry(dx, s) {
    Some(THE(mo, _, _)) -> Some(tsh_reader(mo, target))
    None                -> None
  }
}

fn tsh_entry(dx: NameIndex[TyHomeEntry], s: SymId) : Option[TyHomeEntry] =
  if sym_raw(s) < 0 { None }
  else { match idx_chain_sym(dx, s) {
    [e, ..._] -> Some(e)
    []        -> None
  } }

#[doc("The nominal type the variant `c` of a sum stands for. A member written under a qualifier is homed at the module it names, whose type of that name it is. Any other is read from the module of `v` that declares the sum: a type spelled like the variant, else the component `c` itself declares.")]
pub fn tsh_variant_sym(v: TyHomeView, c: SymId) : SymId = match v {
  THV(TyHomes(tx, rs, target, _, _, _, _, tab, _), cur) -> {
    let nm = tsh_name(tab, c)
    let reader = tsh_reader(cur, target)
    let named = if sym_raw(sym_owner(tab, c)) == sym_raw(st_module_id(reader)) { None } else { st_lookup(tab, NCType, nm, sym_owner(tab, c)) }
    match named {
      Some(t) -> t
      None    -> {
        let s = tsh_type_sym(tab, tx, rs, reader, nm)
        if sym_raw(s) >= 0 or tsh_is_scalar(nm) { s } else { c }
      }
    }
  }
}

#[doc("True when the module that declares the variant `c` also declares a type spelled like it, an alias included: the variant then refers to that declaration.")]
pub fn tsh_variant_has_type(hs: TyHomes, c: SymId) : Bool = match hs {
  TyHomes(_, _, _, _, _, _, _, tab, _) -> match st_lookup(tab, NCType, tsh_name(tab, c), sym_owner(tab, c)) {
    Some(_) -> true
    None    -> false
  }
}

#[doc("The scope view of the file that declares the module `reader`.")]
pub fn tsh_scope(hs: TyHomes, reader: String) : ScopeView = match hs {
  TyHomes(_, _, _, _, views, _, _, _, _) -> fv_of(views, st_module_id(reader))
}

#[doc("A nominal type from a name the source wrote, its identity decided by `v`: `sym_none()` when the name denotes no declaration.")]
pub fn tsh_tycon(v: TyHomeView, nm: String, args: [Ty]) : Ty = TyCon(tsh_sym(v, nm), args)

#[doc("The module slot of the type declaration `s` (`None` is the root file's), and `None` too when the table holds no such declaration.")]
pub fn tsh_sym_slot(v: TyHomeView, s: SymId) : Option[String] = match v {
  THV(TyHomes(_, _, _, _, _, _, dx, _, _), _) -> match tsh_entry(dx, s) {
    Some(THE(mo, _, _)) -> mo
    None                -> None
  }
}

#[doc("True unless the table holds the type declaration `s` and a module other than the reading module of `v` owns it.")]
pub fn tsh_reader_owns(v: TyHomeView, s: SymId) : Bool = match v {
  THV(TyHomes(_, _, target, _, _, _, dx, _, _), cur) -> match tsh_entry(dx, s) {
    # A declaration the symbol table does not hold has no owner to judge.
    Some(THE(_, _, o)) -> sym_raw(o) < 0 or sym_raw(o) == sym_raw(st_module_id(tsh_reader(cur, target)))
    None               -> true
  }
}
