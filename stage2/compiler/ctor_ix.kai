#[doc("The backends' rows for the constructors keyed by the constructor's id, and the declaration constructor sites carry.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_map
import compiler.core_builtins
import compiler.emit_shared_syms
import compiler.infer_index
import compiler.symtab
import compiler.util
import compiler.written

#[doc("The variant table's rows, each keyed by the id of the constructor it lays out.")]
pub(pkg) type CtorIx = { rows: NameIndex[VariantEntry] }

#[doc("The index over `variants`, the table registered from `decls`, whose declarations `tab` holds.")]
pub(pkg) fn ctor_ix_build(variants: [VariantEntry], decls: [Decl], tab: SymTab) : CtorIx =
  CtorIx { rows: cix_absorbed(decls, tab, cix_rows(builtin_variants(), cix_rows(variants, idx_empty()))) }

#[doc("The row of the constructor `s`, or None when `s` is the id of no constructor the table lays out.")]
pub(pkg) fn ctor_ix_row(ix: CtorIx, s: SymId) : Option[VariantEntry] =
  if sym_raw(s) < 0 { None }
  else { match idx_chain_sym(ix.rows, s) {
    [row, ..._] -> Some(row)
    []          -> None
  } }

#[doc("The row of the constructor `e` references by id, or None when `e` is any other expression.")]
pub(pkg) fn ctor_ix_site(ix: CtorIx, e: Expr) : Option[VariantEntry] = match e.kind {
  ESym(s, _) -> ctor_ix_row(ix, s)
  _          -> None
}

#[doc("True when `e` references a constructor by id.")]
pub(pkg) fn ctor_ix_names(ix: CtorIx, e: Expr) : Bool = match ctor_ix_site(ix, e) {
  Some(_) -> true
  None    -> false
}

#[doc("True when `s` is a constructor's row in the symbol table `t`.")]
pub(pkg) fn sym_is_ctor(t: SymTab, s: SymId) : Bool = match sym_class(t, s) {
  NCCtor -> st_valid(t, s)
  _      -> false
}

#[doc("The head tag of the row's constructor.")]
pub(pkg) fn ctor_row_tag(v: VariantEntry) : Int = match v { EV(_, _, t, _) -> t }

fn cix_rows(vs: [VariantEntry], ix: NameIndex[VariantEntry]) : NameIndex[VariantEntry] = match vs {
  []           -> ix
  [v, ...rest] -> cix_rows(rest, idx_prepend_sym(ix, evar_sym(v), v))
}

fn cix_absorbed(ds: [Decl], tab: SymTab, ix: NameIndex[VariantEntry]) : NameIndex[VariantEntry] = match ds {
  [] -> ix
  [DType(_, _, _, TBSum(vs), _, _, _, _), ...rest] -> cix_absorbed(rest, tab, cix_absorbed_vs(vs, tab, ix))
  [_, ...rest] -> cix_absorbed(rest, tab, ix)
}

fn cix_absorbed_vs(vs: [Variant], tab: SymTab, ix: NameIndex[VariantEntry]) : NameIndex[VariantEntry] = match vs {
  [] -> ix
  [Var(c, _), ...rest] -> match idx_chain_sym(ix, c) {
    [_, ..._] -> cix_absorbed_vs(rest, tab, ix)
    []        -> match variant_absorber(tab, c) {
      Some(row) -> cix_absorbed_vs(rest, tab, idx_prepend_sym(ix, c, row))
      None      -> cix_absorbed_vs(rest, tab, ix)
    }
  }
}

# The table, and the two homes a type with no module slot can have.
type CsCx = { tab: SymTab, root: SymId, core: SymId }

#[doc("`ds` with each constructor site carrying the id of the constructor its type declares; `target` is the root module.")]
pub(pkg) fn ctor_stamp_decls(tab: SymTab, target: String, ds: [Decl]) : [Decl] = {
  let cx = CsCx { tab: tab, root: st_module_id(target), core: st_module_id(core_type_home()) }
  map(ds, (d) => decl_map_bodies(d, (b) => cs_expr(cx, b)))
}

# A callee builds the call's type; any other site builds its own.
fn cs_expr(cx: CsCx, e: Expr) : Expr = match e.kind {
  ECall(f, args) -> {
    let f1 = match cs_ctor(cx, f.kind, e.ty) {
      Some(k) -> cs_re(f, k)
      None    -> if cs_is_ctor_sym(cx, f.kind) or cs_is_inline_sym(f.kind) { f } else { cs_expr(cx, f) }
    }
    cs_re(e, ECall(f1, map(args, (a) => cs_expr(cx, a))))
  }
  _ -> match cs_ctor(cx, e.kind, e.ty) {
    Some(k) -> cs_value(e, k)
    None    -> if cs_is_ctor_sym(cx, e.kind) or cs_is_inline_sym(e.kind) { cs_value(e, e.kind) }
               else { cs_re(e, prc_map_expr_kind(e.kind, (sub) => cs_expr(cx, sub))) }
  }
}

fn cs_is_ctor_sym(cx: CsCx, k: ExprKind) : Bool = match k {
  ESym(s, _) -> sym_is_ctor(cx.tab, s)
  _          -> false
}

# A builtin the backends lower in place has no symbol to read as a value.
fn cs_is_inline_sym(k: ExprKind) : Bool = match k {
  ESym(s, _) -> match builtin_of(s) { Some(b) -> builtin_is_inline(b)  None -> false }
  _          -> false
}

# A constructor or inline builtin that takes arguments, read as a value, is the function
# that applies it.
fn cs_value(e: Expr, k: ExprKind) : Expr = match e.ty {
  Some(TyFnT(ps, ret, _)) -> match ps { [] -> cs_re(e, k)  _ -> cs_eta(e, k, ps, ret) }
  _                       -> cs_re(e, k)
}

fn cs_eta(e: Expr, k: ExprKind, ps: [Ty], ret: Ty) : Expr = {
  let bs = cs_eta_binders(e, ps, 0)
  let args = cs_eta_args(e, bs, ps)
  let params = map(bs, (b) => Param { binder: b, ptype: None, pline: e.line, pcol: e.col, pborrow: false })
  let call = Expr { ...mk_expr(ECall(cs_re(e, k), args), e.line, e.col), ty: Some(ret) }
  cs_re(e, ELambda(params, call))
}

fn cs_eta_binders(e: Expr, ps: [Ty], i: Int) : [Binder] = match ps {
  []           -> []
  [_, ...rest] -> [binder_minted(concat_all(["__eta_", int_to_string(e.line), "_", int_to_string(e.col), "_", int_to_string(i)])),
                   ...cs_eta_binders(e, rest, i + 1)]
}

fn cs_eta_args(e: Expr, bs: [Binder], ps: [Ty]) : [Expr] = match bs {
  [b, ...brest] -> match ps {
    [t, ...prest] -> [Expr { ...mk_local(b.id, e.line, e.col), ty: Some(t) }, ...cs_eta_args(e, brest, prest)]
    []            -> []
  }
  [] -> []
}

fn cs_re(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode, site: e.site }

# A name still written after the typer is a constructor's: a local is
# read by its id and a function by its declaration's. A qualifier names
# the module that declares the constructor, or the type that does.
fn cs_ctor(cx: CsCx, k: ExprKind, t: Option[Ty]) : Option[ExprKind] = match k {
  EName(n)       -> cs_pick(cx, written_text(n), cs_owners(cx, t))
  EModCall(m, n) -> cs_pick(cx, written_text(n), [st_module_id(written_text(m)), ...cs_owners(cx, t)])
  _              -> None
}

fn cs_pick(cx: CsCx, n: String, owners: [SymId]) : Option[ExprKind] = match owners {
  [] -> None
  [o, ...rest] -> match st_lookup(cx.tab, NCCtor, n, o) {
    Some(s) -> Some(ESym(s, spec_none()))
    None    -> cs_pick(cx, n, rest)
  }
}

# The modules that may declare the constructors of the type a site builds.
fn cs_owners(cx: CsCx, t: Option[Ty]) : [SymId] = match t {
  Some(TyCon(s, _))         -> cs_type_owners(cx, s)
  Some(TyRefineT(inner, _)) -> cs_owners(cx, Some(inner))
  Some(TyDimT(inner, _))    -> cs_owners(cx, Some(inner))
  Some(TyFnT(_, ret, _))    -> cs_owners(cx, Some(ret))
  _                         -> []
}

# A type the table declares is owned by its module; one it does not is
# the core's; a type of no declaration leaves the root's and the core's.
fn cs_type_owners(cx: CsCx, s: SymId) : [SymId] =
  if st_valid(cx.tab, s) { [sym_owner(cx.tab, s)] }
  else if sym_raw(s) >= 0 { [cx.core] }
  else { [cx.root, cx.core] }
