#[doc("""
The qualified-type rewrite inside signatures, expressions and patterns:
a `mod.Type` head resolved against the module table.
""")]

import compiler.ast
import compiler.module_table
import compiler.written

#[doc("""
The name a reported qualified type is left with. A type name starts
uppercase, so no declaration can answer it: the typer fails on it and
the build stops. Nothing reads it back.
""")]
pub fn qualtype_unresolvable() : String = "__qualtype_bad__"

#[doc("Whether `mod` is an imported module that exports the type `ty`.")]
pub fn qualtype_exported(mod: String, ty: String, mt: [ModuleEntry]) : Bool = match mt_lookup_member(mt, mod, ty) {
  None     -> false
  Some(me) -> me_has_export(me, ty)
}

# The settled reference of the head `mod.ty`; `None` when it names no
# exported type, which the check pass reports.
fn qualtype_head(mod: String, ty: String, mt: [ModuleEntry]) : Option[DeclRef] =
  if qualtype_exported(mod, ty, mt) { Some(ref_qualified(mt_member_home(mt, mod, ty), ty)) } else { None }

#[doc("A type expression with every `mod.Type` head resolved against the module table.")]
pub fn qualtype_te(te: TypeExpr, mt: [ModuleEntry]) : TypeExpr = match te.tkind {

  TyName(r, targs) -> {
    let targs1 = qualtype_te_list(targs, mt)
    match r {
      DrWritten(Some(q), n) -> match qualtype_head(written_text(q), written_text(n), mt) {
        Some(home) -> TypeExpr { tkind: TyName(home, targs1), line: te.line, col: te.col }
        None       -> TypeExpr { tkind: TyName(ref_written(qualtype_unresolvable()), []), line: te.line, col: te.col }
      }
      _ -> TypeExpr { tkind: TyName(r, targs1), line: te.line, col: te.col }
    }
  }
  TyList(inner) ->
    TypeExpr { tkind: TyList(qualtype_te(inner, mt)), line: te.line, col: te.col }
  TyFn(ps, ret, row) ->
    TypeExpr { tkind: TyFn(qualtype_te_list(ps, mt),
                            qualtype_te(ret, mt),
                            qualtype_row(row, mt)),
                line: te.line, col: te.col }
  TyDim(base, u) ->
    TypeExpr { tkind: TyDim(qualtype_te(base, mt), u), line: te.line, col: te.col }
  TyRefine(base, pred) ->
    TypeExpr { tkind: TyRefine(qualtype_te(base, mt), qualtype_expr(pred, mt)),
                line: te.line, col: te.col }
  # A compound-row type argument (`Stream[Int, Stdout + Fail]`).
  # Rewrite any qualified labels it carries; the carrier is dissolved
  # later by alias substitution.
  TyRow(row) ->
    TypeExpr { tkind: TyRow(qualtype_row(row, mt)), line: te.line, col: te.col }
  TySurface(ts) ->
    TypeExpr { tkind: TySurface(tysurface_rebuild(ts, qualtype_te_list(tysurface_children(ts), mt))),
                line: te.line, col: te.col }
  TyParam(p, targs) ->
    TypeExpr { tkind: TyParam(p, qualtype_te_list(targs, mt)), line: te.line, col: te.col }
}

#[doc("`qualtype_te` over a list.")]
pub fn qualtype_te_list(tes: [TypeExpr], mt: [ModuleEntry]) : [TypeExpr] = match tes {

  [] -> []
  [t, ...rest] -> [qualtype_te(t, mt), ...qualtype_te_list(rest, mt)]
}

#[doc("An effect row with the types inside its labels resolved.")]
pub fn qualtype_row(re: RowExpr, mt: [ModuleEntry]) : RowExpr = match re {

  REmpty -> REmpty
  RClosed(labels) -> RClosed(qualtype_rls(labels, mt))
  ROpen(rv, labels) -> ROpen(rv, qualtype_rls(labels, mt))
}

fn qualtype_rls(ls: [RowLabel], mt: [ModuleEntry]) : [RowLabel] = match ls {

  [] -> []
  [rl, ...rest] -> match rl {
    RL(r, ts) -> [RL(r, qualtype_te_list(ts, mt)), ...qualtype_rls(rest, mt)]
  }
}

fn qualtype_param(pm: Param, mt: [ModuleEntry]) : Param =

  Param { binder: pm.binder,
          ptype: match pm.ptype {
            None -> None
            Some(te) -> Some(qualtype_te(te, mt))
          },
          pline: pm.pline, pcol: pm.pcol, pborrow: pm.pborrow }

#[doc("A parameter list with its type annotations resolved.")]
pub fn qualtype_params(ps: [Param], mt: [ModuleEntry]) : [Param] = match ps {

  [] -> []
  [p, ...rest] -> [qualtype_param(p, mt), ...qualtype_params(rest, mt)]
}

#[doc("""
Walk the (rare) TypeExprs that live inside expression bodies:
`let x : T = e` annotations and `p : T` match-arm narrows.
""")]
pub fn qualtype_expr(e: Expr, mt: [ModuleEntry]) : Expr =

  Expr { kind: qualtype_expr_kind(e.kind, mt),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn qualtype_expr_kind(k: ExprKind, mt: [ModuleEntry]) : ExprKind = match k {

  EBlock(stmts, opt_final) ->
    EBlock(qualtype_stmts(stmts, mt),
           match opt_final {
             None -> None
             Some(fe) -> Some(qualtype_expr(fe, mt))
           })
  EMatch(scrut, arms) ->
    EMatch(qualtype_expr(scrut, mt), qualtype_arms(arms, mt))
  EVariantsOf(te, _) ->
    EVariantsOf(qualtype_te(te, mt), [])
  ELambda(ps, body) ->
    ELambda(qualtype_params(ps, mt), qualtype_expr(body, mt))
  EHandle(body, eff, ty_args, init_opt, alias_opt, clauses, ret_opt) ->
    EHandle(qualtype_expr(body, mt), eff,
             qualtype_ty_list_opt(ty_args, mt),
             match init_opt { None -> None Some(ie) -> Some(qualtype_expr(ie, mt)) },
             alias_opt,
             qualtype_hclauses(clauses, mt),
             match ret_opt {
               None -> None
               Some(r) -> Some(qualtype_hreturn(r, mt))
             })
  # Leaves
  EInt(_, _)        -> k
  EReal(_, _)       -> k
  EIntLit(_)        -> k
  EDecimalLit(_)    -> k
  EFixed(_, _)      -> k
  EBool(_)       -> k
  EChar(_)       -> k
  EStr(_, _)     -> k
  EUnit          -> k
  EName(_)        -> k
  EMark(_)        -> k
  ESym(_, _)      -> k
  ELocal(_)       -> k
  EOp(_)          -> k
  EUnder         -> k
  EPlaceholder   -> k
  EHole(_)       -> k
  ETodo(_)       -> k
  EExternBody(_, _) -> k
  EModCall(_, _) -> k
  EIntrinsic(name, args_) ->
    EIntrinsic(name, qualtype_expr_list(args_, mt))
  ESurface(sf) ->
    ESurface(surface_rebuild(sf, qualtype_expr_list(surface_children(sf), mt)))
  ECall(callee, args_) ->
    ECall(qualtype_expr(callee, mt),
          qualtype_expr_list(args_, mt))
  EField(base, name)   -> EField(qualtype_expr(base, mt), name)
  EIndex(a, b)         -> EIndex(qualtype_expr(a, mt),
                                  qualtype_expr(b, mt))
  EBinop(op, a, b)     -> EBinop(op, qualtype_expr(a, mt),
                                      qualtype_expr(b, mt))
  EUnop(op, x)         -> EUnop(op, qualtype_expr(x, mt))
  EIf(c, t_, eo)       -> EIf(qualtype_expr(c, mt),
                                qualtype_expr(t_, mt),
                                qualtype_expr_opt(eo, mt))
  ERecordLit(r, fs)    -> {
    let fs1 = qualtype_fields_init(fs, mt)
    match r {
      DrWritten(Some(q), n) -> match qualtype_head(written_text(q), written_text(n), mt) {
        Some(home) -> ERecordLit(home, fs1)
        None       -> ERecordLit(ref_written(qualtype_unresolvable()), fs1)
      }
      _ -> ERecordLit(r, fs1)
    }
  }
  EList(els)           -> EList(qualtype_list_elems(els, mt))
  ERange(a, b, opt_step) -> ERange(qualtype_expr(a, mt),
                                     qualtype_expr(b, mt),
                                     qualtype_expr_opt(opt_step, mt))
  EPipe(a, b)          -> EPipe(qualtype_expr(a, mt),
                                  qualtype_expr(b, mt))
  EDispatchPipe(op, a, b) -> EDispatchPipe(op, qualtype_expr(a, mt),
                                     qualtype_expr(b, mt))
  ELitUnit(inner, u)   -> ELitUnit(qualtype_expr(inner, mt), u)
  EBang(inner)         -> EBang(qualtype_expr(inner, mt))
}

fn qualtype_expr_opt(opt: Option[Expr], mt: [ModuleEntry]) : Option[Expr] = match opt {
  None    -> None
  Some(e) -> Some(qualtype_expr(e, mt))
}

fn qualtype_expr_list(es: [Expr], mt: [ModuleEntry]) : [Expr] = match es {
  []           -> []
  [h, ...rest] -> [qualtype_expr(h, mt), ...qualtype_expr_list(rest, mt)]
}

fn qualtype_list_elems(els: [ListElem], mt: [ModuleEntry]) : [ListElem] = match els {
  []           -> []
  [h, ...rest] -> [qualtype_list_elem(h, mt), ...qualtype_list_elems(rest, mt)]
}

fn qualtype_list_elem(el: ListElem, mt: [ModuleEntry]) : ListElem = match el {
  ElPlain(e)  -> ElPlain(qualtype_expr(e, mt))
  ElSpread(e) -> ElSpread(qualtype_expr(e, mt))
}

fn qualtype_fields_init(fs: [FieldInit], mt: [ModuleEntry]) : [FieldInit] = match fs {

  [] -> []
  [fi, ...rest] -> match fi {
    FI(n, v) -> [FI(n, qualtype_expr(v, mt)), ...qualtype_fields_init(rest, mt)]
  }
}

fn qualtype_ty_list_opt(ts: [TypeExpr], mt: [ModuleEntry]) : [TypeExpr] =

  qualtype_te_list(ts, mt)

fn qualtype_arms(arms: [Arm], mt: [ModuleEntry]) : [Arm] = match arms {

  [] -> []
  [a, ...rest] -> [qualtype_arm(a, mt), ...qualtype_arms(rest, mt)]
}

fn qualtype_arm(a: Arm, mt: [ModuleEntry]) : Arm = match a {

  Arm(pat, opt_guard, body) ->
    Arm(qualtype_pat(pat, mt),
        match opt_guard {
          None -> None
          Some(g) -> Some(qualtype_expr(g, mt))
        },
        qualtype_expr(body, mt))
}

fn qualtype_pat(pat: Pattern, mt: [ModuleEntry]) : Pattern = match pat.pkind {

  PNarrow(name, te) ->
    Pattern { pkind: PNarrow(name, qualtype_te(te, mt)), line: pat.line, col: pat.col }
  PVariant(r, subs) ->
    Pattern { pkind: PVariant(r, qualtype_pat_list(subs, mt)),
               line: pat.line, col: pat.col }
  PVariantRecord(r, fs) ->
    Pattern { pkind: PVariantRecord(r, qualtype_pfields(fs, mt)),
               line: pat.line, col: pat.col }
  PRecord(fs) ->
    Pattern { pkind: PRecord(qualtype_pfields(fs, mt)),
               line: pat.line, col: pat.col }
  PList(subs, rest) ->
    Pattern { pkind: PList(qualtype_pat_list(subs, mt), rest),
               line: pat.line, col: pat.col }
  PAs(name, inner) ->
    Pattern { pkind: PAs(name, qualtype_pat(inner, mt)),
               line: pat.line, col: pat.col }
  _ -> pat
}

fn qualtype_pat_list(ps: [Pattern], mt: [ModuleEntry]) : [Pattern] = match ps {

  [] -> []
  [p, ...rest] -> [qualtype_pat(p, mt), ...qualtype_pat_list(rest, mt)]
}

fn qualtype_pfields(fs: [PField], mt: [ModuleEntry]) : [PField] = match fs {

  [] -> []
  [f, ...rest] -> match f {
    PField(name, sub, sh) -> [PField(name, qualtype_pat(sub, mt), sh),
                               ...qualtype_pfields(rest, mt)]
  }
}

fn qualtype_stmts(ss: [Stmt], mt: [ModuleEntry]) : [Stmt] = match ss {

  [] -> []
  [s, ...rest] -> [qualtype_stmt(s, mt), ...qualtype_stmts(rest, mt)]
}

fn qualtype_stmt(s: Stmt, mt: [ModuleEntry]) : Stmt = match s {

  SLet(pat, ty_opt, e) ->
    SLet(qualtype_pat(pat, mt),
         match ty_opt {
           None -> None
           Some(te) -> Some(qualtype_te(te, mt))
         },
         qualtype_expr(e, mt))
  SVar(name, ty_opt, init, l, c) ->
    SVar(name,
         match ty_opt {
           None -> None
           Some(te) -> Some(qualtype_te(te, mt))
         },
         qualtype_expr(init, mt), l, c)
  SAssert(e, om) ->
    SAssert(qualtype_expr(e, mt),
            match om { None -> None Some(m) -> Some(qualtype_expr(m, mt)) })
  SExprStmt(e) -> SExprStmt(qualtype_expr(e, mt))
  SIndexAssign(t, ix, v, l, c) ->
    SIndexAssign(qualtype_expr(t, mt),
                  qualtype_expr(ix, mt),
                  qualtype_expr(v, mt), l, c)
  SAssign(t, v, l, c) ->
    SAssign(qualtype_expr(t, mt), qualtype_expr(v, mt), l, c)
  SUse(eff, l, c) -> SUse(eff, l, c)
}

fn qualtype_hclauses(cs: [HClause], mt: [ModuleEntry]) : [HClause] = match cs {

  [] -> []
  [c, ...rest] -> match c {
    HC(name, ps, body, l, col) ->
      [HC(name, qualtype_params(ps, mt), qualtype_expr(body, mt), l, col),
       ...qualtype_hclauses(rest, mt)]
  }
}

fn qualtype_hreturn(r: HReturn, mt: [ModuleEntry]) : HReturn = match r {

  HR(name, body, l, c) -> HR(name, qualtype_expr(body, mt), l, c)
}
