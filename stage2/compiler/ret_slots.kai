#[doc("""
The locals the ownership pass mints to hold a value across drops.

A scope's drops run after its value exists, so the pass binds the value
to a local of its own, plants the drops, and reads the local back as
the tail: `{ let slot = value; drops; slot }`. A tail call's arguments
are held the same way while the drops run before the jump. The passes
downstream recognise each wrap by its binder.

A slot is a local minted under a key of its own, so a reader compares
ids and never reads a spelling back. The emitted C names these locals,
so the keys are fixed.
""")]

import compiler.ast

#[doc("A slot the ownership pass mints, by the value it holds.")]
pub type RetSlot
  # A fn's result, ahead of its exit drops.
  = RsFn
  # An arm's result, and a block's, ahead of that scope's drops.
  | RsArm | RsBlock
  # A block's result, ahead of the drops of its opaque handles.
  | RsOpaque
  # A tail value, ahead of the drops of the binders it read last.
  | RsTail
  # The i-th argument of a tail call, ahead of the drops the call jumps past.
  | RsTailArg(Int)

#[doc("The name of the local a slot binds.")]
pub fn ret_slot_name(s: RetSlot) : String = match s {
  RsFn         -> "__pcs_ret"
  RsArm        -> "__pcs_arm_ret"
  RsBlock      -> "__pcs_block_ret"
  RsOpaque     -> "__pcs_oret"
  RsTail       -> "__pcs_tret"
  RsTailArg(i) -> string_concat(tail_arg_stem(), int_to_string(i))
}

#[doc("The binder of a slot, where it is declared.")]
pub fn ret_slot_binder(s: RetSlot) : Binder = binder_minted(ret_slot_name(s))

#[doc("The identity of a slot's binder, as a read of it carries it.")]
pub fn ret_slot_local(s: RetSlot) : LocalId = local_minted(ret_slot_name(s))

#[doc("True when `l` is the slot of a fn's result.")]
pub fn ret_slot_id_is_fn(l: LocalId) : Bool = local_eq(l, ret_slot_local(RsFn))

#[doc("True when `l` is the slot of an arm's or a block's result.")]
pub fn ret_slot_id_is_scope(l: LocalId) : Bool =
  local_eq(l, ret_slot_local(RsArm)) or local_eq(l, ret_slot_local(RsBlock))

#[doc("True when `l` is a slot that holds a scope's value ahead of its drops: a fn's, an arm's, a block's, an opaque block's or a tail's.")]
pub fn ret_slot_id_is_value(l: LocalId) : Bool =
  local_is_minted(l) and (ret_slot_id_is_fn(l) or ret_slot_id_is_scope(l)
    or local_eq(l, ret_slot_local(RsOpaque)) or local_eq(l, ret_slot_local(RsTail)))

#[doc("True when the pattern binds the slot of the `i`-th hoisted tail-call argument. A hoist block binds them in order from 0, so a walk over its statements asks for the next one.")]
pub fn ret_slot_binds_tail_arg(p: Pattern, i: Int) : Bool = match p.pkind {
  PBind(b) -> local_is_minted(b.id) and local_eq(b.id, ret_slot_local(RsTailArg(i)))
  _        -> false
}

fn tail_arg_stem() : String = "__pcs_ta"
