#[doc("""
The locals the ownership pass mints to hold a value across drops.

A scope's drops run after its value exists, so the pass binds the value
to a local of its own, plants the drops, and reads the local back as
the tail: `{ let slot = value; drops; slot }`. A tail call's arguments
are held the same way while the drops run before the jump. The passes
downstream recognise each wrap by its binder.

A slot is a local, so its name is a string like any binder's. Which
slot a name is gets decided here and nowhere else: a minter takes the
spelling from `ret_slot_name` and a reader asks `ret_slot_of`. The
emitted C names these locals, so the spellings are fixed.
""")]

import compiler.fnreg

#[doc("A slot the ownership pass mints, by the value it holds.")]
pub type RetSlot
  # A fn's result, ahead of its exit drops.
  = RsFn
  # An arm's result, and a block's, ahead of that scope's drops.
  | RsArm | RsBlock
  # A block's result, ahead of the drops of its opaque handles.
  | RsOpaque
  # A tail value, ahead of the drops of the binders it read last.
  | RsTail
  # The i-th argument of a tail call, ahead of the drops the call jumps past.
  | RsTailArg(Int)

#[doc("The name of the local a slot binds.")]
pub fn ret_slot_name(s: RetSlot) : String = match s {
  RsFn         -> "__pcs_ret"
  RsArm        -> "__pcs_arm_ret"
  RsBlock      -> "__pcs_block_ret"
  RsOpaque     -> "__pcs_oret"
  RsTail       -> "__pcs_tret"
  RsTailArg(i) -> string_concat(tail_arg_stem(), int_to_string(i))
}

#[doc("The slot a binder name denotes, or `None` for any other local. The inverse of `ret_slot_name`.")]
pub fn ret_slot_of(name: String) : Option[RetSlot] =
  if not string_starts_with_q(name, "__pcs_") { None }
  else { match name {
    "__pcs_ret"       -> Some(RsFn)
    "__pcs_arm_ret"   -> Some(RsArm)
    "__pcs_block_ret" -> Some(RsBlock)
    "__pcs_oret"      -> Some(RsOpaque)
    "__pcs_tret"      -> Some(RsTail)
    _                 -> tail_arg_of(name)
  } }

fn tail_arg_stem() : String = "__pcs_ta"

fn tail_arg_of(name: String) : Option[RetSlot] = {
  let stem = tail_arg_stem()
  let n = string_length(stem)
  if not string_starts_with_q(name, stem) { None }
  else { match string_to_int(string_slice(name, n, string_length(name) - n)) {
    Some(i) -> Some(RsTailArg(i))
    None    -> None
  } }
}

#[doc("True when `name` is a slot of any kind.")]
pub fn ret_slot_is_any(name: String) : Bool = match ret_slot_of(name) {
  Some(_) -> true
  None    -> false
}

#[doc("True when `name` is the slot of a fn's result.")]
pub fn ret_slot_is_fn(name: String) : Bool = match ret_slot_of(name) {
  Some(s) -> slot_is_fn(s)
  None    -> false
}

#[doc("True when `name` is the slot of an arm's or a block's result, the wrap the tail-call passes look through.")]
pub fn ret_slot_is_scope(name: String) : Bool = match ret_slot_of(name) {
  Some(s) -> slot_is_scope(s)
  None    -> false
}

#[doc("True when `name` holds a hoisted tail-call argument.")]
pub fn ret_slot_is_tail_arg(name: String) : Bool = match ret_slot_of(name) {
  Some(s) -> slot_is_tail_arg(s)
  None    -> false
}

fn slot_is_fn(s: RetSlot) : Bool = match s {
  RsFn         -> true
  RsArm        -> false
  RsBlock      -> false
  RsOpaque     -> false
  RsTail       -> false
  RsTailArg(_) -> false
}

fn slot_is_scope(s: RetSlot) : Bool = match s {
  RsArm        -> true
  RsBlock      -> true
  RsFn         -> false
  RsOpaque     -> false
  RsTail       -> false
  RsTailArg(_) -> false
}

fn slot_is_tail_arg(s: RetSlot) : Bool = match s {
  RsTailArg(_) -> true
  RsFn         -> false
  RsArm        -> false
  RsBlock      -> false
  RsOpaque     -> false
  RsTail       -> false
}
