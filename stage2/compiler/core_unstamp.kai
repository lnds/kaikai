#[doc("""
What is left of the pass that spelled a core builtin back for the dump,
report and lint front ends.

A reference to a core builtin is its row on every path, and those front
ends read it by that id, so nothing is spelled back.
""")]

import compiler.ast
import compiler.symtab

#[doc("`ds` as they are: a reference to a core builtin keeps its id.")]
pub fn core_unstamp_decls(tab: SymTab, ds: [Decl]) : [Decl] = ds
