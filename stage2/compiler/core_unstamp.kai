#[doc("""
The line below which a core builtin is still read by its name.

The resolver stamps a reference to a builtin with the builtin's row.
The passes above this line read that id; the ones below it still look a
builtin up by spelling, so the reference is handed to them as a bare
name. The line moves down a pass at a time, and this module goes when it
reaches the emitters.
""")]

import compiler.ast
import compiler.ast_map
import compiler.decl_map
import compiler.symtab
import compiler.core_syms
import compiler.symtab_build
import compiler.decl_names
import compiler.written
import compiler.core_builtin_sets

#[doc("`ds` with every reference to a core builtin spelled as the bare name it carries.")]
pub fn core_unstamp_decls(tab: SymTab, ds: [Decl]) : [Decl] =
  map(ds, (d) => decl_map_bodies(d, (b) => cu_expr(tab, b)))

#[doc("`ds` with every constructor site spelled the way the passes below read one. `target` is the root module.")]
pub fn ctor_unstamp_decls(tab: SymTab, target: String, ds: [Decl]) : [Decl] = {
  let cx = CcCx { tab: tab, root: sym_raw(st_module_id(target)), core: sym_raw(st_module_id(core_type_home())) }
  map(ds, (d) => decl_map_bodies(d, (b) => cc_expr(cx, b)))
}

type CcCx = { tab: SymTab, root: Int, core: Int }

fn cc_expr(cx: CcCx, e: Expr) : Expr =
  Expr { kind: cc_kind(cx, e.kind), line: e.line, col: e.col, ty: e.ty, mode: e.mode, site: e.site }

fn cc_kind(cx: CcCx, k: ExprKind) : ExprKind = match k {
  ECall(f, args) -> {
    let f1 = match f.kind {
      ESym(s, _, n) -> if cc_is_ctor(cx, s) { Expr { ...f, kind: cc_spell(cx, s, n, true) } } else { f }
      _             -> cc_expr(cx, f)
    }
    ECall(f1, map(args, (a) => cc_expr(cx, a)))
  }
  ESym(s, _, n) -> if cc_is_ctor(cx, s) { cc_spell(cx, s, n, false) } else { k }
  _             -> prc_map_expr_kind(k, (sub) => cc_expr(cx, sub))
}

fn cc_is_ctor(cx: CcCx, s: SymId) : Bool = st_valid(cx.tab, s) and ncls_same(sym_class(cx.tab, s), NCCtor)

#[doc("The constructors whose value sites the passes below read qualified by their home: `cc_spell` of a site that is not called.")]
pub fn ctors_read_qualified(tab: SymTab) : SymSet = {
  let core = sym_raw(st_module_id(core_type_home()))
  sym_set_of(filter(st_ids(tab), (s) => cc_value_qualified(tab, core, s)))
}

fn cc_value_qualified(tab: SymTab, core: Int, s: SymId) : Bool =
  ncls_same(sym_class(tab, s), NCCtor) and sym_raw(sym_owner(tab, s)) != core
    and list_length(st_candidates(tab, NCCtor, written_text(sym_name(tab, s)))) > 1

# A core constructor is always bare. Another one names its module when a
# second declaration shares its name, and a call also when it is an
# imported module's.
fn cc_spell(cx: CcCx, s: SymId, n: String, called: Bool) : ExprKind = {
  let owner = sym_raw(sym_owner(cx.tab, s))
  let shared = list_length(st_candidates(cx.tab, NCCtor, n)) > 1
  if owner == cx.core { EVar(n) }
  else if shared or called and owner != cx.root { EModCall(written_text(sym_home(cx.tab, s)), n) }
  else { EVar(n) }
}

fn cu_expr(tab: SymTab, e: Expr) : Expr =
  Expr { kind: cu_kind(tab, e.kind), line: e.line, col: e.col, ty: e.ty, mode: e.mode, site: e.site }

fn cu_kind(tab: SymTab, k: ExprKind) : ExprKind = match k {
  ESym(s, _, n) -> if sym_is_builtin(tab, s) { EVar(n) } else { k }
  _             -> prc_map_expr_kind(k, (sub) => cu_expr(tab, sub))
}
