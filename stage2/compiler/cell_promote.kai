# compiler/cell_promote.kai — scalar var slots to raw local cells.
#
# The var desugar lowers a non-escaping `var` to a 1-cell array slot
# (`let x__slot = array_make(1, init)` + `array_get(x__slot, 0)` /
# `array_set(x__slot, 0, v)`). The cell is heap memory: every access
# is an array call over boxed values. When the element is a raw scalar
# and the binder never leaves the get/set protocol, the cell can be a
# plain mutable local instead — no allocation, no RC — and the unbox
# pass then marks arithmetic over its reads raw, so both backends
# compile the enclosing loop over registers.
#
# The rewrite maps the slot triple onto three intrinsics the emitters
# lower to a raw mutable local. A read or write carries the binder's own
# reference as its first argument, so every pass that follows a binder
# (a rename, a shadow) follows the cell with it:
#   let x = array_make(1, lit)  →  let x = __cell_init(lit)
#   array_get(x, 0)             →  __cell_get(x)
#   array_set(x, 0, v)          →  __cell_set(x, v)
#
# Runs post-monomorph / pre-unbox, on typed AST. Conditions:
#   * the init is a pure scalar of type Int, Real or Bool — a literal, a
#     local read (`var m := n`), or builtin arithmetic over those;
#   * every use of the binder in its scope is a whole-cell
#     `array_get(x, 0)` / `array_set(x, 0, v)` call;
#   * no use sits inside a `handle` body — a raw local written there does
#     not survive the longjmp an abandoning clause takes.
# The check is rewrite-then-verify: sanctioned uses are rewritten to
# the cell intrinsics (whose binder argument is not a use), and any read of
# the binder left in the scope — an unsanctioned use — reverts the slot
# to its array form (correct, just unpromoted).

import compiler.ast
import compiler.operators
import compiler.modules
import compiler.desugar
import compiler.loop_lower
import compiler.cell_scan
import compiler.core_builtins

#[doc("Promote every non-escaping scalar var slot (`array_make(1, lit)` cell) in the program to a raw local cell (`__cell_init`/`__cell_get`/`__cell_set` intrinsics).")]
pub fn promote_scalar_cells(ds: [Decl]) : [Decl] = map(ds, cp_decl)

#[doc("True for the cell intrinsics this pass mints (`__cell_init`, `__cell_get`, `__cell_set`).")]
pub fn is_cell_intrinsic(i: Intrinsic) : Bool = match i {
  InCellInit -> true
  InCellGet  -> true
  InCellSet  -> true
  _          -> false
}

#[doc("The cell a `__cell_get`/`__cell_set` reaches: the binder its first argument reads, `local_none()` when that is no local read.")]
pub fn cell_ref_local(args: [Expr]) : LocalId = match args {
  [r, ..._] -> match r.kind {
    ELocal(l) -> l
    _         -> local_none()
  }
  [] -> local_none()
}

# --- decl walk -------------------------------------------------------

fn cp_decl(d: Decl) : Decl = match d {
  DFn(pub_, f, tps, ps, ret, row, body, l, c, mo) ->
    DFn(pub_, f, tps, ps, ret, row, cp_expr(body), l, c, mo)
  DTest(desc, body, l, c, mo)         -> DTest(desc, cp_expr(body), l, c, mo)
  DBench(desc, body, l, c, mo)        -> DBench(desc, cp_expr(body), l, c, mo)
  DCheck(desc, ps, body, l, c, mo)    -> DCheck(desc, ps, cp_expr(body), l, c, mo)
  DImpl(p, tas, tgt, inner, l, c, tps, isym) -> DImpl(p, tas, tgt, map(inner, cp_decl), l, c, tps, isym)
  DDerive(ns, inner, l, c)        -> DDerive(ns, cp_decl(inner), l, c)
  DUnstable(inner, l, c)          -> DUnstable(cp_decl(inner), l, c)
  DProtoLaws(thy, inner, l, c, mo)    -> DProtoLaws(thy, cp_decl(inner), l, c, mo)
  DImplAxiom(thy, inner, l, c, mo)    -> DImplAxiom(thy, cp_decl(inner), l, c, mo)
  DConstructor(inner, l, c)       -> DConstructor(cp_decl(inner), l, c)
  DDoc(a, b, inner, l, c)         -> DDoc(a, b, cp_decl(inner), l, c)
  DConst(pub_, s, ty, init, mo, l, c) -> DConst(pub_, s, ty, cp_expr(init), mo, l, c)
  _ -> d
}

# --- promotion walk --------------------------------------------------

fn cp_expr(e: Expr) : Expr =
  Expr { kind: cp_kind(e.kind), line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn cp_kind(k: ExprKind) : ExprKind = match k {
  EBlock(stmts, tail) -> cp_block(stmts, tail, [])
  _ -> dsg_map_expr_kind(k, cp_expr)
}

fn cp_opt(o: Option[Expr]) : Option[Expr] = match o {
  Some(e) -> Some(cp_expr(e))
  None    -> None
}

# Scan a block for promotable slot decls. On a hit, the rest of the
# block (the binder's whole scope) is tentatively rewritten; a leftover
# read of the binder reverts to the original statements. Promoted or not, the
# fold continues over the (possibly rewritten) remainder so sibling and
# nested slots get their own chance.
fn cp_block(stmts: [Stmt], tail: Option[Expr], acc: [Stmt]) : ExprKind = match stmts {
  [] -> EBlock(list_reverse(acc), cp_opt(tail))
  [s, ...rest] -> match cp_slot_decl(s) {
    Some(hit) -> cp_block_slot(hit, s, rest, tail, acc)
    None      -> cp_block(rest, tail, [cp_stmt(s), ...acc])
  }
}

# One slot decl found at the head: rewrite its scope tentatively and
# promote, or revert on a residual mention.
fn cp_block_slot(hit: CpSlot, s: Stmt, rest: [Stmt], tail: Option[Expr], acc: [Stmt]) : ExprKind = match hit {
  CpSlot(pat, ann, slot, init, rhs_line, rhs_col) -> {
    let rw_rest = map(rest, (st) => cp_rw_stmt(slot, st))
    let rw_tail = cp_rw_opt(slot, tail)
    if cp_stmts_use(slot, rw_rest) or cp_opt_uses(slot, rw_tail) {
      cp_block(rest, tail, [cp_stmt(s), ...acc])
    } else {
      let cell = mk_cell_expr(EIntrinsic(InCellInit, [init]),
                              init.ty, rhs_line, rhs_col)
      cp_block(rw_rest, rw_tail, [SLet(pat, ann, cell), ...acc])
    }
  }
}

fn cp_stmt(s: Stmt) : Stmt = match s {
  SLet(p, ann, rhs)           -> SLet(p, ann, cp_expr(rhs))
  SAssert(c, m)               -> SAssert(cp_expr(c), cp_opt(m))
  SExprStmt(x)                -> SExprStmt(cp_expr(x))
  SIndexAssign(b, i, v, l, c) -> SIndexAssign(cp_expr(b), cp_expr(i), cp_expr(v), l, c)
  SAssign(b, v, l, c) -> SAssign(cp_expr(b), cp_expr(v), l, c)
  SVar(n, ty, rhs, l, c)      -> SVar(n, ty, cp_expr(rhs), l, c)
  SUse(n, l, c)               -> SUse(n, l, c)
}

fn mk_cell_expr(k: ExprKind, ty: Option[Ty], line: Int, col: Int) : Expr =
  Expr { kind: k, line: line, col: col, ty: ty, mode: MBoxed , site: 0 }

# --- slot-decl recognition -------------------------------------------

type CpSlot = CpSlot(Pattern, Option[TypeExpr], Binder, Expr, Int, Int)

# `let x = array_make(1, <pure scalar init>)`. A pure scalar init (literal,
# local read, or builtin arithmetic over those) lowers to a raw register;
# an effectful or non-scalar init keeps the array slot.
fn cp_slot_decl(s: Stmt) : Option[CpSlot] = match s {
  SLet(pat, ann, rhs) -> match pat.pkind {
    PBind(slot) -> match cp_one_cell_init(rhs) {
      Some(init) -> Some(CpSlot(pat, ann, slot, init, rhs.line, rhs.col))
      None       -> None
    }
    _ -> None
  }
  _ -> None
}

# The pure-scalar init of an `array_make(1, init)` rhs, or None.
fn cp_one_cell_init(rhs: Expr) : Option[Expr] = match rhs.kind {
  ECall(callee, args_) ->
    if is_builtin_ref(callee, CbArrayMake) { cp_one_cell_args(args_) } else { None }
  _ -> None
}

fn cp_one_cell_args(args_: [Expr]) : Option[Expr] = match args_ {
  [n, init] ->
    if cp_is_lit_one(n) and cp_init_is_pure_scalar(init) { Some(init) } else { None }
  _ -> None
}

fn cp_is_lit_one(e: Expr) : Bool = match e.kind {
  EInt(1, _) -> true
  _ -> false
}

# A cell init the raw register can hold: a scalar-typed value with no
# effects and a trivial box→raw border. Literals, a plain local read
# (`var m := n`), and builtin arithmetic over such operands all qualify —
# the result type being `Int`/`Real`/`Bool` (`cp_ty_is_cell_scalar`) rules
# out a user protocol op returning a boxed type. A call, field, or index
# init keeps the array slot: its lowering to raw is not locally provable.
fn cp_init_is_pure_scalar(e: Expr) : Bool =
  if not cp_ty_is_cell_scalar(e.ty) { false }
  else { match e.kind {
    EInt(_, _)      -> true
    EReal(_, _)     -> true
    EBool(_)        -> true
    ELocal(_)       -> true
    ESym(_, _)      -> true
    EUnop(UoNeg, x) -> cp_init_is_pure_scalar(x)
    EBinop(op, a, b) -> binop_is_arith(op) and cp_init_is_pure_scalar(a) and cp_init_is_pure_scalar(b)
    _               -> false
  } }

# Int / Real / Bool only: the exact scalars both backends hold in raw
# registers (`int64_t`/`double`/`int`, `SInt64`/`SReal`/`SBool`).
fn cp_ty_is_cell_scalar(opt_t: Option[Ty]) : Bool = match opt_t {
  Some(t) -> match t {
    TyInt  -> true
    TyReal -> true
    TyBool -> true
    _      -> false
  }
  None -> false
}

# --- sanctioned-use rewrite ------------------------------------------

# Rewrite `array_get(x, 0)` / `array_set(x, 0, v)` into the mangled
# cell intrinsics. A construct that declares the same binder again is
# left unrewritten: its reads then surface in the use-check and revert
# the promotion — conservative over clever.
fn cp_rw(slot: Binder, e: Expr) : Expr =
  Expr { kind: cp_rw_kind(slot, e.kind, e.line, e.col), line: e.line, col: e.col,
         ty: e.ty, mode: e.mode,  site: e.site }

fn cp_rw_kind(slot: Binder, k: ExprKind, line: Int, col: Int) : ExprKind = match k {
  ECall(callee, args_) -> match cp_getset_hit(slot, callee, args_) {
    CpGet(r) -> EIntrinsic(InCellGet, [cp_cell_ref(r)])
    CpSet(r, v) -> EIntrinsic(InCellSet, [cp_cell_ref(r), cp_rw(slot, v)])
    CpMiss -> ECall(cp_rw(slot, callee), map(args_, (a) => cp_rw(slot, a)))
  }
  # FUNCTION-EMISSION BOUNDARIES. A promoted cell is a local of the
  # declaring frame; a construct whose body emits as a SEPARATE fn
  # (a closure, a handler clause / return clause) cannot read it. The
  # rewrite stops at those boundaries, so a cell use inside one stays
  # an `array_get(x, ...)` — and the residual-use check reverts
  # the promotion. The ONE exception is a loop intrinsic's own wrapper
  # lambdas: both emitters paste those bodies inline into the
  # enclosing frame, so the rewrite must follow them.
  ELambda(_, _) -> k
  EIntrinsic(inm, args_) ->
    if is_loop_intrinsic(inm) { EIntrinsic(inm, map(args_, (a) => cp_rw_loop_arg(slot, a))) }
    else { EIntrinsic(inm, map(args_, (a) => cp_rw(slot, a))) }
  ESurface(sf) -> ESurface(surface_map(sf, (a) => cp_rw(slot, a)))
  EMatch(scr, arms) -> EMatch(cp_rw(slot, scr), map(arms, (a) => cp_rw_arm(slot, a)))
  EBlock(stmts, tail) -> cp_rw_block(slot, stmts, tail, [])
  # SETJMP BOUNDARY. A clause that drops `resume` longjmps back to the
  # install site, and a raw cell written in the body is indeterminate on
  # the second return (C99 §7.13.2.1; the native lowering loses it too).
  # Leaving the body unrewritten reverts the promotion, so the cell keeps
  # its array slot. The `init` still rewrites — it runs before the setjmp.
  EHandle(body, eff, tys, init, alias, cs, ret) ->
    EHandle(body, eff, tys, cp_rw_opt(slot, init), alias, cs, ret)
  _ -> dsg_map_expr_kind(k, (sub) => cp_rw(slot, sub))
}

# A loop intrinsic's arg: the pred/body wrapper lambdas are pasted
# inline, so the rewrite descends their bodies (a shadowing param still
# stops it); any other arg is an ordinary expression.
fn cp_rw_loop_arg(slot: Binder, a: Expr) : Expr = match a.kind {
  ELambda(ps, b) ->
    if cp_params_bind(ps, slot) { a }
    else { Expr { kind: ELambda(ps, cp_rw(slot, b)), line: a.line, col: a.col,
                  ty: a.ty, mode: a.mode,  site: a.site } }
  _ -> cp_rw(slot, a)
}

type CpHit = CpGet(Expr) | CpSet(Expr, Expr) | CpMiss

# The binder read a cell intrinsic carries: a raw read, so no pass counts
# it as a use of the slot it replaced.
fn cp_cell_ref(r: Expr) : Expr = Expr { ...r, ty: None, mode: MUnboxed }

fn cp_getset_hit(slot: Binder, callee: Expr, args_: [Expr]) : CpHit =
  match builtin_ref(callee) {
    Some(CbArrayGet) -> cp_get_hit(slot, args_)
    Some(CbArraySet) -> cp_set_hit(slot, args_)
    _                -> CpMiss
  }

fn cp_get_hit(slot: Binder, args_: [Expr]) : CpHit = match args_ {
  [a, i] -> if cp_cell_at_zero(slot, a, i) { CpGet(a) } else { CpMiss }
  _      -> CpMiss
}

fn cp_set_hit(slot: Binder, args_: [Expr]) : CpHit = match args_ {
  [a, i, v] -> if cp_cell_at_zero(slot, a, i) { CpSet(a, v) } else { CpMiss }
  _         -> CpMiss
}

fn cp_cell_at_zero(slot: Binder, a: Expr, i: Expr) : Bool =
  cp_is_var(a, slot) and cp_is_zero(i)

fn cp_is_var(e: Expr, slot: Binder) : Bool = match e.kind {
  ELocal(l) -> local_eq(l, slot.id)
  _ -> false
}

fn cp_binds(bs: [Binder], slot: Binder) : Bool = match bs {
  []           -> false
  [b, ...rest] -> local_eq(b.id, slot.id) or cp_binds(rest, slot)
}

fn cp_is_zero(e: Expr) : Bool = match e.kind {
  EInt(0, _) -> true
  _ -> false
}

fn cp_params_bind(ps: [Param], slot: Binder) : Bool = match ps {
  []           -> false
  [p, ...rest] -> if local_eq(p.binder.id, slot.id) { true } else { cp_params_bind(rest, slot) }
}

fn cp_rw_arm(slot: Binder, a: Arm) : Arm = match a {
  Arm(pat, guard, body) ->
    if cp_binds(pat_binders(pat, []), slot) { a }
    else { Arm(pat, cp_rw_opt(slot, guard), cp_rw(slot, body)) }
}

# A block statement that rebinds `nm` shuts the rewrite off for the
# rest of the block — the remaining mentions belong to the shadow.
fn cp_rw_block(slot: Binder, stmts: [Stmt], tail: Option[Expr], acc: [Stmt]) : ExprKind = match stmts {
  [] -> EBlock(list_reverse(acc), cp_rw_opt(slot, tail))
  [s, ...rest] -> {
    let s2 = cp_rw_stmt(slot, s)
    if cp_stmt_binds(s, slot) {
      EBlock(list_append(list_reverse([s2, ...acc]), rest), tail)
    } else {
      cp_rw_block(slot, rest, tail, [s2, ...acc])
    }
  }
}

fn cp_rw_stmt(slot: Binder, s: Stmt) : Stmt = match s {
  SLet(p, ann, rhs)           -> SLet(p, ann, cp_rw(slot, rhs))
  SAssert(c, m)               -> SAssert(cp_rw(slot, c), cp_rw_opt(slot, m))
  SExprStmt(x)                -> SExprStmt(cp_rw(slot, x))
  SIndexAssign(b, i, v, l, c) -> SIndexAssign(cp_rw(slot, b), cp_rw(slot, i), cp_rw(slot, v), l, c)
  SAssign(b, v, l, c) -> SAssign(cp_rw(slot, b), cp_rw(slot, v), l, c)
  SVar(n, ty, rhs, l, c)      -> SVar(n, ty, cp_rw(slot, rhs), l, c)
  SUse(n, l, c)               -> SUse(n, l, c)
}

fn cp_stmt_binds(s: Stmt, slot: Binder) : Bool = match s {
  SLet(p, _, _)          -> cp_binds(pat_binders(p, []), slot)
  SVar(n, _, _, _, _)    -> local_eq(n.id, slot.id)
  SAssert(_, _)          -> false
  SExprStmt(_)           -> false
  SIndexAssign(_, _, _, _, _) -> false
  SAssign(_, _, _, _) -> false
  SUse(_, _, _)          -> false
}

fn cp_rw_opt(slot: Binder, o: Option[Expr]) : Option[Expr] = match o {
  Some(e) -> Some(cp_rw(slot, e))
  None    -> None
}
