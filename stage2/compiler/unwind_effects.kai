#[doc("""
Which calls can exit non-locally, decided once per program.

A call unwinds when its effect row holds an effect some handler may
abandon its continuation for, or `Cancel`. A clause abandons when one of
its paths finishes without calling `resume`, and an effect whose clause
can itself unwind is as good as abandoning: the jump leaves through the
frames that performed it. When the program can cancel a fiber from
outside (`Spawn`, `Link`), every perform is a cancellation point, so
every call with a non-empty row unwinds.

The decision may only err toward "unwinds": a call wrongly taken for
one that cannot leaves its frame's references to leak on that jump.
""")]

import compiler.ast
import compiler.emit_shared
import compiler.enc_unit
import compiler.unwind_clauses
import compiler.unwind_carriers
import compiler.unwind_cx
import compiler.unwind_calls
import compiler.borrow_infer
import compiler.core_effects
import compiler.expr_exists

#[doc("The unwind context of a program: its decls and every handler clause in them.")]
pub fn unw_cx(decls: [Decl], clauses: [ClauseInfo]) : UnwCx = unw_cx_seeded(decls, clauses, unw_seed_none())

#[doc("`unw_cx` for a program whose analysis also starts from `seed`.")]
pub fn unw_cx_seeded(decls: [Decl], clauses: [ClauseInfo], seed: UnwSeed) : UnwCx = {
  let c = ue_cx_of(decls, unw_clauses(clauses, decls), seed)
  UnwCx { ...c, handles: ue_handle_fns(clauses, []) }
}

#[doc("Whether `d` feeds the unwind analysis, which reads every function: one that handles an effect or whose row may cancel. A cut that dropped it would change what the rest of the program unwinds through.")]
pub fn unw_feeds_analysis(d: Decl) : Bool = match d {
  DFn(_, _, _, _, _, row, body, _, _, _) -> ue_row_cancels(row) or xp_exists(body, false, ue_is_handle)
  _ -> false
}

# A `var` lowers to a handler, so a block that declares one handles too.
fn ue_is_handle(e: Expr) : Bool = match e.kind {
  EHandle(_, _, _, _, _, _, _) -> true
  EBlock(ss, _) -> ue_has_var(ss)
  _ -> false
}

fn ue_has_var(ss: [Stmt]) : Bool = match ss {
  [] -> false
  [s, ...rest] -> match s {
    SVar(_, _, _, _, _) -> true
    _ -> ue_has_var(rest)
  }
}

#[doc("The effects the handlers in `own` make unwind, within the program `decls`, and whether every fn row may cancel.")]
pub type UnwEffects = UnwEffects(Bool, [Int])

#[doc("The unwinding effects of the handlers `own` write, as the fixpoint over `decls` settles them.")]
pub fn unw_effects_of(own: [Decl], decls: [Decl]) : UnwEffects =
  if ue_rows_cancel(decls) { UnwEffects(true, []) }
  else {
    let hs = unw_handle_clauses(own)
    UnwEffects(false, ue_fix(hs, decls, unw_carriers(decls), unw_abandoning(hs, [sym_raw(core_effect_id(CeCancel))])))
  }

#[doc("The unwind context of `decls` before their clauses are lifted: each `handle` brings its own; no fn is marked as installing one.")]
pub fn unw_cx_decls(decls: [Decl]) : UnwCx = unw_cx_decls_seeded(decls, unw_seed_none())

#[doc("`unw_cx_decls` for a program whose analysis also starts from `seed`.")]
pub fn unw_cx_decls_seeded(decls: [Decl], seed: UnwSeed) : UnwCx = ue_cx_of(decls, unw_handle_clauses(decls), seed)

fn ue_cx_of(decls: [Decl], hs: [UnwClause], seed: UnwSeed) : UnwCx = {
  let all = ue_rows_cancel(decls) or seed.all
  let carriers = unw_carriers(decls)
  let start = ue_seeded(seed.effects, unw_abandoning(hs, [sym_raw(core_effect_id(CeCancel))]))
  let unw = if all { [] } else { ue_fix(hs, decls, carriers, start) }
  ue_cx(decls, carriers, unw, all)
}

fn ue_seeded(effects: [SymId], acc: [Int]) : [Int] = match effects {
  [] -> acc
  [s, ...rest] -> ue_seeded(rest, if sym_raw(s) < 0 or unw_has_id(acc, s) { acc } else { [sym_raw(s), ...acc] })
}

fn ue_cx(decls: [Decl], carriers: [Int], unw: [Int], all: Bool) : UnwCx = {
  let base = UnwCx { eff_ids: ue_effect_ids(decls, []), fns: array_make(1, []), unw: unw,
                     all: all, carriers: carriers, handles: [] }
  UnwCx { ...base, fns: ue_table(decls, base) }
}

fn ue_effect_ids(decls: [Decl], acc: [Int]) : [Int] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DEffect(_, s, _, _, _, _, _, _) -> ue_effect_ids(rest, if sym_raw(s) >= 0 { [sym_raw(s), ...acc] } else { acc })
    _ -> ue_effect_ids(rest, acc)
  }
}

fn ue_handle_fns(cs: [ClauseInfo], acc: [EncUnit]) : [EncUnit] = match cs {
  [] -> acc
  [CI(_, _, _, _, _, _, _, enc, _, _, _), ...rest] -> ue_handle_fns(rest, if unit_in(acc, enc.unit) { acc } else { [enc.unit, ...acc] })
}

fn ue_table(decls: [Decl], ucx: UnwCx) : Array[[UnwFn]] = {
  let t = array_make(1024, [])
  foreach(decls, (d) => match d {
    DFn(_, fid, _, ps, _, row, _, _, _, _) -> {
      let k = bv_fid_key(fid)
      let b = unw_bucket(k, 1024)
      t[b] := [UF(k, unw_row_class(row, ucx), ue_borrowed(ps, 0)), ...t[b]]
    }
    _ -> ()
  })
  t
}


fn ue_borrowed(ps: [Param], i: Int) : [Int] = match ps {
  [] -> []
  [p, ...rest] -> if p.pborrow { [i, ...ue_borrowed(rest, i + 1)] } else { ue_borrowed(rest, i + 1) }
}

# ---- cancellation from outside -------------------------------------------

fn ue_rows_cancel(decls: [Decl]) : Bool = match decls {
  [] -> false
  [d, ...rest] -> match d {
    DFn(_, _, _, _, _, row, _, _, _, _) -> ue_row_cancels(row) or ue_rows_cancel(rest)
    _ -> ue_rows_cancel(rest)
  }
}

fn ue_row_cancels(row: RowExpr) : Bool = match row {
  REmpty       -> false
  RClosed(ls)  -> ue_cancel_label(ls)
  ROpen(_, ls) -> ue_cancel_label(ls)
}

fn ue_cancel_label(ls: [RowLabel]) : Bool =
  any(ls, (l) => effect_is_any(rl_sym(l), [CeSpawn, CeLink]))

# Adds every effect one of whose clauses can unwind, until none is added.
fn ue_fix(hs: [UnwClause], decls: [Decl], carriers: [Int], unw: [Int]) : [Int] = {
  let ucx = ue_cx(decls, carriers, unw, false)
  let more = ue_unwinding_clauses(hs, ucx, unw)
  if list_length(more) == list_length(unw) { unw } else { ue_fix(hs, decls, carriers, more) }
}

fn ue_unwinding_clauses(hs: [UnwClause], ucx: UnwCx, acc: [Int]) : [Int] = match hs {
  [] -> acc
  [UnwC(eff, k, body), ...rest] ->
    if sym_raw(eff) < 0 or unw_has_id(acc, eff) or not ue_clause_unwinds(body, k, ucx) { ue_unwinding_clauses(rest, ucx, acc) }
    else { ue_unwinding_clauses(rest, ucx, [sym_raw(eff), ...acc]) }
}

# A clause's resume in tail position returns into the perform: only its
# arguments can unwind there.
fn ue_clause_unwinds(e: Expr, k: LocalId, ucx: UnwCx) : Bool = match e.kind {
  ECall(f, xs) -> if unw_reads_continuation(f, k) { ue_any_scan(xs, ucx) } else { unw_scan(e, ucx) }
  EBlock(ss, Some(t)) -> ue_stmts_scan(ss, ucx) or ue_clause_unwinds(t, k, ucx)
  EIf(c, t, Some(el)) -> unw_scan(c, ucx) or ue_clause_unwinds(t, k, ucx) or ue_clause_unwinds(el, k, ucx)
  _ -> unw_scan(e, ucx)
}

fn ue_any_scan(xs: [Expr], ucx: UnwCx) : Bool = match xs {
  [] -> false
  [x, ...rest] -> unw_scan(x, ucx) or ue_any_scan(rest, ucx)
}

fn ue_stmts_scan(ss: [Stmt], ucx: UnwCx) : Bool = unw_scan(mk_expr(EBlock(ss, None), 0, 0), ucx)
