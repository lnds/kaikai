#[doc("Refinement contracts: wrapping a body with its requires and ensures checks, classifying each call-site argument against a required predicate and reporting violations.")]

import compiler.util
import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.real_lit
import compiler.operators
import compiler.resolve_names
import compiler.expr_positions
import compiler.written
import compiler.refine_entail
import compiler.refine_pred

# m12.6.x #3 v2: the synthesised pred-fn name for a refinement-type
# alias. Centralised so the call-site builder and the post-parse
# generator agree on the spelling.
#[doc("Mint the synthesised predicate-fn name for a refinement-type alias (`__ref_pred_<Type>`).")]
pub(pkg) fn synth_refine_pred_fn_name(tyname: String) : String =
  string_concat("__ref_pred_", tyname)

# m12.6.b: desugar contracts into asserts inside the body. The
# semantics are:
#   requires P  -> assert P at function entry
#   ensures  Q  -> assert Q after binding `result` to the body's value
# The combined shape is a single EBlock:
#   { assert P1; ...; let result = body; assert Q1; ...; result }
# The block's final expression is `result` so the function still
# returns the body's value. When both lists are empty, the body is
# returned unchanged so functions without contracts cost nothing.
#[doc("Desugar a fn body, wrapping it in requires/ensures asserts; returns the body unchanged when both contract lists are empty.")]
pub(pkg) fn wrap_with_contracts(body: Expr, reqs: [Expr], enss: [Expr],
                       params: [Param], fn_name: Written,
                       line: Int, col: Int) : Expr {
  if reqs == [] and enss == [] { body } else {
    let pp = collect_param_preds(params, [])
    let req_stmts = preds_to_asserts(reqs, [], CkRequires, pp, fn_name, params)
    if enss == [] {
      if req_stmts == [] { body }
      else { mk_expr(EBlock(req_stmts, Some(body)), line, col) }
    } else {
      # m12.6.c: bind `result` to the body's value so `ensures`
      # predicates can reference it. The shape is
      #   { req_asserts; let result = body; ens_asserts; result }
      let bind_pat = mk_pat(PBind(binder_written("result")), line, col)
      let bind = SLet(bind_pat, None, body)
      let ens_stmts = preds_to_asserts(enss, [], CkEnsures, pp, fn_name, params)
      if req_stmts == [] and ens_stmts == [] { body }
      else {
        let res_var = mk_name("result", line, col)
        let stmts = list_append(req_stmts, [bind, ...ens_stmts])
        mk_expr(EBlock(stmts, Some(res_var)), line, col)
      }
    }
  }
}

#[doc("The contract clause an assert was lowered from.")]
pub(pkg) type ContractKind = CkRequires | CkEnsures

#[doc("The keyword a contract clause is written with.")]
pub(pkg) fn contract_kind_word(k: ContractKind) : String = match k {
  CkRequires -> "requires"
  CkEnsures  -> "ensures"
}

fn preds_to_asserts(preds: [Expr], acc: [Stmt], kind: ContractKind,
                     param_preds: [ParamPred], fn_name: Written,
                     params: [Param]) : [Stmt] {
  match preds {
    [] -> list_reverse(acc)
    # m12.6.d: drop trivially-true predicates at parse time.
    # m12.6.x #2: drop a predicate that is structurally identical to
    # some param's refinement — the type-system already guarantees
    # it. (Caller-side narrowing into the refined type is the proof
    # obligation; the callee body inherits the refinement for free.)
    # m12.6.x #8 v2 (#86): build a structured message containing the
    # clause kind, the function name, the rendered predicate text, and
    # the decl-site line/col. The leading `"requires violated` /
    # `"ensures violated` prefix is preserved so contract_assert_kind
    # / extract_requires_asserts (which key off the prefix) keep
    # working. Call-site span and runtime value formatting are
    # follow-up (see docs/refinements-and-contracts.md v2 sidebar).
    [p, ...rest] -> {
      if pred_entailed_by_params(p, param_preds) {
        preds_to_asserts(rest, acc, kind, param_preds, fn_name, params)
      } else { match try_eval_pred(p) {
        Some(true) -> preds_to_asserts(rest, acc, kind, param_preds, fn_name, params)
        _          -> {
          let msg_span = build_violation_msg_span(kind, fn_name, p, params)
          let msg = mk_expr(EStr(msg_span, false), p.line, p.col)
          preds_to_asserts(rest, [SAssert(p, Some(msg)), ...acc], kind, param_preds, fn_name, params)
        }
      } }
    }
  }
}

# m12.6.x #8 v2 (#86): assemble the multi-line panic message for a
# contract violation. The result is the *raw* EStr span (including
# surrounding double quotes and backslash-escaped newlines) so the
# emitter can pass it through as a C string literal unchanged. Format:
#
#   "requires violated in `<fn>`\nrequired: <pred>\ndeclared at line N, col C"
#
# When printed by `kai_core_panic` the `\n` escapes render as real
# line breaks, producing a multi-line diagnostic. The leading
# `"requires violated` / `"ensures violated` prefix is kept so the
# detectors at extract_requires_asserts / contract_assert_kind still
# classify the assert as contract-derived.
fn build_violation_msg_span(kind: ContractKind, fn_name: Written, p: Expr,
                            params: [Param]) : String {
  let ptext = escape_str_body_for_c(pred_text(p))
  let fn_text = escape_str_body_for_c(written_text(fn_name))
  concat_all([
    "\"", contract_kind_word(kind), " violated in `", fn_text, "`",
    "\\nrequired: ", ptext,
    "\\ndeclared at line ", int_to_string(p.line),
    ", col ", int_to_string(p.col),
    violation_help_suffix(kind, p, params), "\""
  ])
}

# Issue #750 (piece-3 of #86): the `help: narrow` suggestion. Only a
# `requires` clause whose predicate is the single-ident `<ident> <cmp>
# <literal>` shape (the same shape piece-2 attaches a runtime value to)
# carries a help line; `ensures` clauses reference `result`, not a
# param, so they never match and fall through to "". The base type comes
# from the offending param's declared annotation (see refine_help.kai),
# so an unannotated param also yields "" — piece-1 with no regression.
fn violation_help_suffix(kind: ContractKind, p: Expr, params: [Param]) : String = match kind {
  CkEnsures  -> ""
  CkRequires -> match contract_single_ident(p) {
    None -> ""
    Some(ident) -> requires_help_line(ident, p, params)
  }
}

# Refinement bindings visible inside a function body: each entry
# pairs a binder with its self-substituted refinement predicate.
# `let` bindings without explicit refinement annotations contribute
# nothing (interval inference is the lattice's job, not this analysis).
#[doc("A local binder paired with its refinement predicate, `self` already a read of that binder.")]
pub(pkg) type RefBinding = RBind(LocalId, Expr)

#[doc("Collect the refinement predicates of a resolved param list as RefBindings (self already substituted to a read of the param).")]
pub(pkg) fn collect_caller_refinements(params: [Param], acc: [RefBinding]) : [RefBinding] {
  match params {
    [] -> list_reverse(acc)
    [p, ...rest] -> match p.ptype {
      Some(t) -> match t.tkind {
        TyRefine(_, pred, _) ->
          collect_caller_refinements(rest, [RBind(p.binder.id, subst_self(pred, p.binder.id)), ...acc])
        _ -> collect_caller_refinements(rest, acc)
      }
      None -> collect_caller_refinements(rest, acc)
    }
  }
}

fn lookup_caller_refinement(refs: [RefBinding], l: LocalId) : Option[Expr] {
  match refs {
    [] -> None
    [r, ...rest] -> match r {
      RBind(n, p) -> if local_eq(n, l) { Some(p) } else { lookup_caller_refinement(rest, l) }
    }
  }
}

# The predicate reads the callee's binders and the caller's refinement
# the caller's: whoever reports the refutation holds both declarations'
# names, so the reason is kept as what it is about.
#[doc("Why a discharge is refuted: a literal that violates the predicate (literal, predicate), literal arguments that violate a clause, or a caller refinement that does not entail the predicate (refinement, predicate).")]
pub(pkg) type LooseWhy = LwLiteral(Expr, Expr) | LwArgs(Expr) | LwCaller(Expr, Expr)

#[doc("The message of a refuted discharge. `req` prints the callee's predicate, `own` an expression of the calling body.")]
pub(pkg) fn loose_text(w: LooseWhy, req: (Expr) -> String, own: (Expr) -> String) : String = match w {
  LwLiteral(lit, pred) -> concat_all(["literal ", own(lit), " violates `", req(pred), "`"])
  LwArgs(pred) -> concat_all(["literal args violate `", req(pred), "`"])
  LwCaller(caller_pred, pred) -> concat_all([
    "caller refinement `", own(caller_pred),
    "` does not entail callee precondition `", req(pred), "`"])
}

# Fixtures pin these via `--dump-call-elision`.
#[doc("Classification of a predicate discharge attempt: elided (proven), runtime (undecided), or loose (statically refuted, with reason).")]
pub(pkg) type CallSiteStatus = CSElided | CSRuntime | CSLoose(LooseWhy)

# Classify one (callee_param, caller_arg) discharge attempt.
#
# `req_pred` is the callee's predicate over its parameter `p` (already
# substituted from `self`). `arg` is the resolved expression at the call
# site. `caller_refs` is the refinement environment built from the
# enclosing fn's parameters.
#[doc("Classify one predicate-vs-value discharge: CSElided when provable, CSLoose when a closed value refutes it, CSRuntime otherwise.")]
pub(pkg) fn classify_arg_vs_pred(req_pred: Expr, p: LocalId, arg: Expr,
                        caller_refs: [RefBinding]) : CallSiteStatus =
  classify_value(req_pred, PvLocal(p), arg, caller_refs)

#[doc("`classify_arg_vs_pred` for a predicate over its own `self`, as a refinement inside a type is.")]
pub(pkg) fn classify_self_vs_pred(req_pred: Expr, arg: Expr, caller_refs: [RefBinding]) : CallSiteStatus =
  classify_value(req_pred, pv_self(), arg, caller_refs)

fn classify_value(req_pred: Expr, v: PredVar, arg: Expr,
                  caller_refs: [RefBinding]) : CallSiteStatus {
  match try_eval_num_lit(arg) {
    Some(lit) -> {
      let folded = pred_canon(subst_var(req_pred, v, lit))
      match try_eval_pred(folded) {
        Some(true) -> CSElided
        Some(false) -> CSLoose(LwLiteral(lit, req_pred))
        None -> CSRuntime
      }
    }
    None -> match arg.kind {
      ELocal(arg_l) -> match lookup_caller_refinement(caller_refs, arg_l) {
        Some(caller_pred) -> {
          # Substitute both predicates to talk about the same binder
          # (the arg's) so structural / interval entailment works
          # without per-pair alpha matching.
          let req_in_arg = pred_canon(subst_var(req_pred, v, mk_local(arg_l, arg.line, arg.col)))
          let caller_in_arg = pred_canon(caller_pred)
          if expr_struct_eq(req_in_arg, caller_in_arg) { CSElided }
          else if pred_entailed_by_refinement(req_in_arg, PvLocal(arg_l), caller_in_arg) { CSElided }
          else { CSLoose(LwCaller(caller_pred, req_pred)) }
        }
        None -> CSRuntime
      }
      _ -> CSRuntime
    }
  }
}

# Issue #86 (piece 2): when a contract predicate has the simple shape
# `<ident> <cmp> <literal>` (e.g. `b != 0.0`, `n >= 0`, `c == 'x'`),
# return the offending parameter so the emitter can attach the binding's
# runtime value to the violation panic. Returns None for any other shape
# (two idents, nested expressions, calls, unops) — the emitter then
# falls back to the value-less `kai_assert_check`, with no regression.
# The single-EVar / scalar-literal restriction is what lets the emitter
# safely reference the *one* already-bound local; richer predicates
# would need to evaluate sub-expressions, which the panic path must not
# do (re-emitting would double-evaluate side effects and break Perceus
# RC).
#
# A matched simple-shape predicate carries two nodes:
#   - the ident node — its `mode` is the *repr oracle*. The emitter
#     mirrors exactly what `emit_expr` would do for this same node: a
#     raw-unboxed read comes from `kair_<name>`, a boxed one from
#     `kai_<name>`. Using the ident node's own mode (not the literal's)
#     guarantees the emitter and `emit_expr` agree on which C local
#     name exists — the local's repr is a property of the *binding*,
#     not of how the comparison happened to be lowered.
#   - the literal node — its `ty` is the *box-type oracle* for the raw
#     case (Perceus never rewrites a literal, so its `ty` is always
#     present, whereas a dup-wrapped ident node's `ty` may be blank).
pub(pkg) type ContractIdent = CtrId(LocalId, Expr, Expr)
#                              ^binder ^ident ^literal

# The operands of a simple-shape predicate: the ident node and the literal.
pub(pkg) type IdentLit = IdLit(Expr, Expr)

fn single_ident_operands(pred: Expr) : Option[IdentLit] = match pred.kind {
  EBinop(op, a, b) ->
    if binop_is_comparison(op) {
      match expr_pred_ident_node(a) {
        Some(na) -> if expr_pred_is_scalar_lit(b) { Some(IdLit(na, b)) } else { None }
        None -> match expr_pred_ident_node(b) {
          Some(nb) -> if expr_pred_is_scalar_lit(a) { Some(IdLit(nb, a)) } else { None }
          None -> None
        }
      }
    } else { None }
  _ -> None
}

# Before the resolver: the name the single ident is written with.
fn contract_single_ident(pred: Expr) : Option[Written] = match single_ident_operands(pred) {
  Some(IdLit(n, _)) -> match n.kind {
    EName(w) -> Some(w)
    _        -> None
  }
  None -> None
}

# Simple-shape detector for the C / LLVM emitters: returns the binding,
# the ident node (repr oracle), and the comparison literal (box-ty
# oracle) so they can attach the binding's runtime value to a
# contract-violation panic. Only a local binding has a value to report.
fn contract_single_ident_node(pred: Expr) : Option[ContractIdent] = match single_ident_operands(pred) {
  Some(IdLit(n, lit)) -> match n.kind {
    ELocal(l) -> Some(CtrId(l, n, lit))
    _         -> None
  }
  None -> None
}

# Both backends decide here which asserts report a binding's value, so
# their panic text cannot drift apart.
#[doc("The binding whose runtime value a violated `requires` assert reports, or None for every other assert.")]
pub(pkg) fn assert_reported_binding(cond: Expr, opt_msg: Option[Expr]) : Option[ContractIdent] = match opt_msg {
  Some(m) -> match m.kind {
    EStr(span, false) -> if assert_span_is_requires(span) { contract_single_ident_node(cond) } else { None }
    _ -> None
  }
  None -> None
}

#[doc("A reported binding's name as the quoted string span the value-carrying assert takes.")]
pub(pkg) fn reported_binding_span(ident: String) : String =
  concat_all(["\"", escape_str_body_for_c(ident), "\""])

# Does this EStr span (raw — includes the opening quote) start with the
# load-bearing `requires violated` contract prefix? The value-carrying
# panic path (issue #86 piece 2) is narrowed to `requires` because a
# requires-assert runs before the body consumes any param, so the
# offending binding's local is guaranteed live; an ensures-assert may
# reference an already-consumed param. Shared by the C and LLVM emitters.
pub(pkg) fn assert_span_is_requires(span: String) : Bool =
  assert_span_prefix_loop(span, "\"requires violated", 0)

#[doc("The callee of the call written at (`line`, `col`) inside `e`, or None when no call starts there.")]
pub(pkg) fn callee_at(e: Expr, line: Int, col: Int) : Option[Expr] = match e.kind {
  ECall(f, _) -> if e.line == line and e.col == col { Some(f) } else { callee_at_xps(xp_positions(e), line, col) }
  _           -> callee_at_xps(xp_positions(e), line, col)
}

fn callee_at_xps(xps: [XPos], line: Int, col: Int) : Option[Expr] = match xps {
  [] -> None
  [XP(_, x), ...rest] -> match callee_at(x, line, col) {
    Some(f) -> Some(f)
    None    -> callee_at_xps(rest, line, col)
  }
}

#[doc("The contract clause (`requires` or `ensures`) an assert was lowered from, or None for a user-written assert.")]
pub(pkg) fn contract_assert_kind(opt_msg: Option[Expr]) : Option[ContractKind] = match opt_msg {
  Some(m) -> match m.kind {
    EStr(span, false) ->
      if assert_span_is_requires(span) { Some(CkRequires) }
      else if assert_span_prefix_loop(span, "\"ensures violated", 0) { Some(CkEnsures) }
      else { None }
    _ -> None
  }
  None -> None
}

fn assert_span_prefix_loop(s: String, prefix: String, i: Int) : Bool {
  let pn = string_length(prefix)
  if i >= pn { true }
  else { match char_at(s, i) {
    None -> false
    Some(sc) -> match char_at(prefix, i) {
      None -> true
      Some(pc) -> if sc == pc { assert_span_prefix_loop(s, prefix, i + 1) } else { false }
    }
  } }
}

# Recover the bare ident node behind a predicate operand. By emit time
# the Perceus pass may have wrapped a non-last read in a dup; unwrap
# that one layer so the simple-shape
# detector still fires on `b != 0.0` whether or not `b` is read again
# later in the body. The returned node carries the `mode`/`ty` the
# emitter needs to pick boxed vs raw repr; the emitter only references
# the bound local, never re-emits this sub-expression.
fn expr_pred_ident_node(e: Expr) : Option[Expr] = match e.kind {
  EName(_) -> Some(e)
  ELocal(_) -> Some(e)
  ECall(callee, cargs) -> match callee.kind {
    # An RC mark wraps the read it accounts for; the predicate is about
    # the read, so look through it.
    EMark(MkDup)       -> match cargs { [a] -> expr_pred_ident_node(a)  _ -> None }
    EMark(MkGuardDrop) -> match cargs { [a] -> expr_pred_ident_node(a)  _ -> None }
    EMark(MkDrop)      -> match cargs { [a] -> expr_pred_ident_node(a)  _ -> None }
    _ -> None
  }
  _ -> None
}

fn expr_pred_is_scalar_lit(e: Expr) : Bool = match e.kind {
  EInt(_, _)  -> true
  EReal(_, _) -> true
  EIntLit(_) -> true
  EDecimalLit(_) -> true
  EFixed(_, _) -> true
  EBool(_) -> true
  EChar(_) -> true
  _ -> false
}

# A `requires` predicate may mention any param; substitute each param
# with the corresponding arg expression (literal or refined binding)
# and either fold or check entailment.
#[doc("Classify a `requires` predicate against a call's arguments: substitute every parameter, then fold or check entailment by a refined caller binding.")]
pub(pkg) fn classify_requires_clause(pred: Expr, pnames: [LocalId], call_args: [Expr],
                             caller_refs: [RefBinding]) : CallSiteStatus {
  let subst = subst_params(pred, pnames, call_args)
  let folded = pred_canon(subst)
  match try_eval_pred(folded) {
    Some(true) -> CSElided
    Some(false) -> CSLoose(LwArgs(pred))
    None -> {
      # Try refinement-based discharge: if the substituted predicate
      # is a comparison whose only free var is a refined caller
      # binding, ask the lattice.
      match free_var_of_pred(folded) {
        Some(v) -> match lookup_caller_refinement(caller_refs, v) {
          Some(caller_pred) -> {
            let caller_canon = pred_canon(caller_pred)
            if expr_struct_eq(folded, caller_canon) { CSElided }
            else if pred_entailed_by_refinement(folded, PvLocal(v), caller_canon) { CSElided }
            else { CSLoose(LwCaller(caller_pred, pred)) }
          }
          None -> CSRuntime
        }
        None -> CSRuntime
      }
    }
  }
}

# Simultaneous: an argument that reads another parameter is never
# substituted again.
#[doc("Substitute each read of a parameter in an expression by the call argument in its position, in one pass.")]
pub(pkg) fn subst_params(pred: Expr, pnames: [LocalId], call_args: [Expr]) : Expr = match pred.kind {
  ELocal(l) -> match arg_for_param(pnames, call_args, l) { Some(a) -> a  None -> pred }
  EBinop(op, a, b) -> mk_expr(EBinop(op, subst_params(a, pnames, call_args), subst_params(b, pnames, call_args)), pred.line, pred.col)
  EUnop(op, x) -> mk_expr(EUnop(op, subst_params(x, pnames, call_args)), pred.line, pred.col)
  ECall(f, xs) -> mk_expr(ECall(subst_params(f, pnames, call_args), subst_params_list(xs, pnames, call_args)), pred.line, pred.col)
  _ -> pred
}

fn subst_params_list(es: [Expr], pnames: [LocalId], call_args: [Expr]) : [Expr] = match es {
  [] -> []
  [h, ...t] -> [subst_params(h, pnames, call_args), ...subst_params_list(t, pnames, call_args)]
}

#[doc("The call argument bound to the parameter `target`, by position.")]
pub(pkg) fn arg_for_param(pnames: [LocalId], call_args: [Expr], target: LocalId) : Option[Expr] = match pnames {
  [] -> None
  [n, ...rest_n] -> match call_args {
    [] -> None
    [a, ...rest_a] -> if local_eq(n, target) { Some(a) } else { arg_for_param(rest_n, rest_a, target) }
  }
}

# Find the unique free variable of a comparison predicate, or None
# if it has zero or more than one. Used by classify_requires_clause
# to decide which caller refinement to consult.
fn free_var_of_pred(e: Expr) : Option[LocalId] = match e.kind {
  EBinop(_, a, b) -> match free_var_of_pred(a) {
    Some(an) -> match free_var_of_pred(b) {
      Some(bn) -> if local_eq(an, bn) { Some(an) } else { None }
      None -> Some(an)
    }
    None -> free_var_of_pred(b)
  }
  EUnop(_, x) -> free_var_of_pred(x)
  ELocal(l) -> Some(l)
  _ -> None
}
