#[doc("""
The spelling of the compiler's intrinsics.

An intrinsic is an operation this compiler implements, not a
declaration: nothing binds `seg_request` and no symbol table knows it.
Which operation a node is rides the node as an `Intrinsic` constructor,
so a pass that plants one and the passes that read it back agree by
construction, and a reader that matches on them stops compiling until
it says what it does with a new one.

The name survives at two boundaries only. The parser receives it as
the identifier after `$` and turns it into the constructor with
`intrinsic_of_name`; the formatter, the dumps, the diagnostics and the
comments in emitted C print it back with `intrinsic_name`.
""")]

import compiler.ast

#[doc("The identifier an intrinsic is written with after the `$`.")]
pub fn intrinsic_name(i: Intrinsic) : String = match i {
  InExternHandler -> "extern_handler"
  InCellInit      -> "__cell_init"
  InCellGet       -> "__cell_get"
  InCellSet       -> "__cell_set"
  InLoopWhile     -> "__loop_while"
  InLoopUntil     -> "__loop_until"
  InLoopRepeat    -> "__loop_repeat"
  InResumeFrame   -> "resume_frame"
  InResumeBad     -> "resume_bad"
  InSegHandle     -> "seg_handle"
  InSegRequest    -> "seg_request"
  InSegState      -> "seg_state"
  InAbsent        -> "__kai_absent"
  InUnknown(n)    -> n
}

#[doc("The intrinsic an identifier after `$` denotes; `InUnknown` keeps a name that denotes none. The inverse of `intrinsic_name`.")]
pub fn intrinsic_of_name(n: String) : Intrinsic = match n {
  "extern_handler" -> InExternHandler
  "__cell_init"    -> InCellInit
  "__cell_get"     -> InCellGet
  "__cell_set"     -> InCellSet
  "__loop_while"   -> InLoopWhile
  "__loop_until"   -> InLoopUntil
  "__loop_repeat"  -> InLoopRepeat
  "resume_frame"   -> InResumeFrame
  "resume_bad"     -> InResumeBad
  "seg_handle"     -> InSegHandle
  "seg_request"    -> InSegRequest
  "seg_state"      -> InSegState
  "__kai_absent"   -> InAbsent
  _                -> InUnknown(n)
}
