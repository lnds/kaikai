#[doc("""
Dups at the top of an argument list: counted, tested for being a
binder's only reads, and unwrapped.
""")]

import compiler.ast
import compiler.perceus_arg_reads

#[doc("`es` with the top-level dups of `b` unwrapped, when those are its only reads.")]
pub fn pcs_strip_one_binder(es: [Expr], b: Binder) : [Expr] = {
  let top = pcs_top_dup_count(es, b)
  if top >= 1 and not pcs_occurs_outside_top_dups(es, b) {
    pcs_unwrap_nth_dup(es, b, top)
  } else { es }
}

fn pcs_top_dup_count(es: [Expr], b: Binder) : Int = match es {
  []           -> 0
  [e, ...rest] -> (if pcs_is_dup_read(e, b) { 1 } else { 0 }) + pcs_top_dup_count(rest, b)
}

fn pcs_is_dup_read(e: Expr, b: Binder) : Bool = match e.kind {
  ECall(f, xs) -> match f.kind {
    EMark(MkDup) ->
      match xs { [inner] -> pcs_is_bare(b.id, inner) _ -> false }
    _ -> false
  }
  _ -> false
}

fn pcs_occurs_outside_top_dups(es: [Expr], b: Binder) : Bool = match es {
  []           -> false
  [e, ...rest] ->
    if pcs_is_dup_read(e, b) { pcs_occurs_outside_top_dups(rest, b) }
    else if pcs_var_occurs(e, b) { true }
    else { pcs_occurs_outside_top_dups(rest, b) }
}

# Any appearance of `b`: reads at any depth, shadowed rebinds included.
# Over-approximates on purpose — a true verdict only forfeits the unwrap.
fn pcs_var_occurs(e: Expr, b: Binder) : Bool = match e.kind {
  ELocal(u)          -> local_eq(u, b.id)
  ESym(_, _)         -> false
  EOp(_)             -> false
  EMark(MkDup)       -> false
  EStr(_, _)         -> false
  ECall(f, xs)       -> pcs_var_occurs(f, b) or pcs_var_occurs_list(xs, b)
  EIntrinsic(_, xs)  -> pcs_var_occurs_list(xs, b)
  EField(x, _)       -> pcs_var_occurs(x, b)
  EIndex(x, i)       -> pcs_var_occurs(x, b) or pcs_var_occurs(i, b)
  EBinop(_, l, r)    -> pcs_var_occurs(l, b) or pcs_var_occurs(r, b)
  EUnop(_, x)        -> pcs_var_occurs(x, b)
  EIf(c, t, eo)      -> pcs_var_occurs(c, b) or pcs_var_occurs(t, b) or pcs_var_occurs_opt(eo, b)
  ELambda(_, lb)     -> pcs_var_occurs(lb, b)
  ERecordLit(_, fs)  -> pcs_var_occurs_fields(fs, b)
  EList(els)         -> pcs_var_occurs_elems(els, b)
  ERange(l, r, so)   -> pcs_var_occurs(l, b) or pcs_var_occurs(r, b) or pcs_var_occurs_opt(so, b)
  ELitUnit(x, _)     -> pcs_var_occurs(x, b)
  EBang(x)           -> pcs_var_occurs(x, b)
  EInt(_, _)         -> false
  EReal(_, _)        -> false
  EIntLit(_)         -> false
  EDecimalLit(_)     -> false
  EFixed(_, _)       -> false
  EBool(_)           -> false
  EChar(_)           -> false
  EUnit              -> false
  EUnder             -> false
  _                  -> true
}

fn pcs_var_occurs_list(es: [Expr], b: Binder) : Bool = match es {
  []           -> false
  [e, ...rest] -> pcs_var_occurs(e, b) or pcs_var_occurs_list(rest, b)
}

fn pcs_var_occurs_opt(oe: Option[Expr], b: Binder) : Bool = match oe {
  None    -> false
  Some(e) -> pcs_var_occurs(e, b)
}

fn pcs_var_occurs_fields(fs: [FieldInit], b: Binder) : Bool = match fs {
  []            -> false
  [fi, ...rest] -> match fi { FI(_, v) -> pcs_var_occurs(v, b) or pcs_var_occurs_fields(rest, b) }
}

fn pcs_var_occurs_elems(els: [ListElem], b: Binder) : Bool = match els {
  []            -> false
  [el, ...rest] -> match el {
    ElPlain(e)  -> pcs_var_occurs(e, b) or pcs_var_occurs_elems(rest, b)
    ElSpread(e) -> pcs_var_occurs(e, b) or pcs_var_occurs_elems(rest, b)
  }
}

fn pcs_unwrap_nth_dup(es: [Expr], b: Binder, n: Int) : [Expr] = match es {
  []           -> []
  [e, ...rest] ->
    if pcs_is_dup_read(e, b) {
      if n == 1 { [pcs_dup_inner_read(e), ...rest] }
      else { [e, ...pcs_unwrap_nth_dup(rest, b, n - 1)] }
    } else { [e, ...pcs_unwrap_nth_dup(rest, b, n)] }
}

fn pcs_dup_inner_read(e: Expr) : Expr = match e.kind {
  ECall(_, xs) -> match xs { [inner] -> inner _ -> e }
  _            -> e
}
