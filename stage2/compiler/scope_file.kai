#[doc("""
The scope view one file resolves under, built from what the loader
already knows: the modules the file opens with a plain `import m`, the
names its selective imports pick, and the prelude cores. An alias binds
a qualifier and opens nothing.

The loader's tables are the source: `[ModImports]` says which modules a
file opens, `[SelImport]` which names it picks from which module, and
the core list names the prelude. Each is a module *name*; the view
holds ids, so every name is turned into its id once here rather than
compared as a string at each rung.

A module's id is a function of its name, so a view needs no symbol
table: the views built before a pass adds declarations stay exact after
it. A module no table holds owns no row, so naming it widens no rung.
""")]

import compiler.ast
import compiler.modules
import compiler.symtab_build
import compiler.scope_view
import compiler.name_contest
import compiler.module_table
import compiler.infer_index

#[doc("Every file's scope view, each found by its home module's id, and the view a home with no recorded file falls back to.")]
pub type FileViews = FileViews([ScopeView], ScopeView)

#[doc("""
The per-file views for a program: for each file the loader recorded,
the modules it opens, the names it picks, and the cores every file
sees without importing them.

`root` is the target module's name — the home of every untagged
declaration, and the owner an import table spells `""`. A pick names its
module as its file wrote it, which `scopes` over `global` turns into the
home the module's declarations carry.
""")]
pub fn fv_build(imports: [ModImports], sels: [SelImport], scopes: [ModScope],
      global: [ModuleEntry], cores: [String], root: String) : FileViews {
  let core_ids = fv_ids(cores, [])
  FileViews(fv_entries(imports, fv_tag_sels(sels, scopes, global), scopes, fv_origins(global, idx_empty()), core_ids, root, []),
            fv_bare(core_ids, root))
}

#[doc("""
Every selective import with the constructors of each sum type it picks
added: `import m.{Shape}` lets the file write `Circle(1)`. The type and
its variants are exported as one, and a constructor is read under its
type. `decls` is the stream the picked modules' declarations are in.
""")]
pub fn sel_with_ctors(sels: [SelImport], scopes: [ModScope], global: [ModuleEntry],
      decls: [Decl], root: String) : [SelImport] = match sels {
  [] -> []
  _  -> {
    let sums = fv_sums(decls, root, [])
    map(sels, (s) => match s {
      SelImport(o, written, names) ->
        SelImport(o, written, fv_with_ctors(names, sums, mt_tagged_name(ms_table(scopes, o, global), written), names))
    })
  }
}

#[doc("No file views: every home resolves seeing only its own declarations, the shape a caller with no loader tables gets.")]
pub fn fv_empty() : FileViews = FileViews([], sv_of_home(sym_none()))

#[doc("The view of the file owned by the module `home`; a view seeing only that home and the cores when no file was recorded for it.")]
pub fn fv_of(v: FileViews, home: SymId) : ScopeView = match v {
  FileViews(vs, fallback) -> match fv_find(vs, home) {
    Some(sv) -> sv
    None     -> sv_at_home(fallback, home)
  }
}

fn fv_find(vs: [ScopeView], home: SymId) : Option[ScopeView] = match vs {
  [] -> None
  [sv, ...rest] -> if sym_raw(sv.home) == sym_raw(home) { Some(sv) } else { fv_find(rest, home) }
}

fn fv_tag_sels(sels: [SelImport], scopes: [ModScope], global: [ModuleEntry]) : [SelImport] =
  map(sels, (s) => match s {
    SelImport(o, written, names) -> SelImport(o, mt_tagged_name(ms_table(scopes, o, global), written), names)
  })

# A file the loader spells `""` is the root file, whose declarations are
# homed in the target module.
fn fv_owner(owner: String, root: String) : String =
  if owner == "" { root } else { owner }

fn fv_entries(imports: [ModImports], sels: [SelImport], scopes: [ModScope],
      origins: NameIndex[FvOrigin], core_ids: [SymId], root: String, acc: [ScopeView]) : [ScopeView] =
  match imports {
    [] -> list_reverse(acc)
    [MImp(owner, names), ...rest] -> {
      let home = fv_owner(owner, root)
      let v = sv_with_quals(fv_view(home, names, sels, core_ids, root), fv_quals(scopes, owner, origins))
      fv_entries(rest, sels, scopes, origins, core_ids, root, [v, ...acc])
    }
  }

# The qualifiers the file `owner` wrote, each bound to the module it names.
fn fv_quals(scopes: [ModScope], owner: String, origins: NameIndex[FvOrigin]) : [SvPick] = match scopes {
  [] -> []
  [MScope(o, mes, _), ...rest] ->
    if o == owner {
      map(mes, (me) => match me {
        ME(written, _, origin, _) -> SvPick(written, st_module_id(fv_origin_name(origins, origin, written)))
      })
    } else { fv_quals(rest, owner, origins) }
}

# The name the global table last binds a file under, keyed by the file's
# origin: one pass over the table instead of one per import.
type FvOrigin = FvOrigin(String, String)

fn fv_origins(global: [ModuleEntry], ix: NameIndex[FvOrigin]) : NameIndex[FvOrigin] = match global {
  [] -> ix
  [ME(n, _, o, _), ...rest] -> fv_origins(rest, idx_prepend(ix, o, FvOrigin(o, n)))
}

fn fv_origin_name(ix: NameIndex[FvOrigin], origin: String, fallback: String) : String =
  fv_origin_first(idx_chain(ix, origin), origin, fallback)

fn fv_origin_first(es: [FvOrigin], origin: String, fallback: String) : String = match es {
  [] -> fallback
  [FvOrigin(o, n), ...rest] -> if o == origin { n } else { fv_origin_first(rest, origin, fallback) }
}

fn fv_view(home: String, names: [String], sels: [SelImport],
      core_ids: [SymId], root: String) : ScopeView =
  sv_new(st_module_id(home), fv_picks(sels, home, root, []),
         fv_ids(names, []), core_ids)

# A sum type a module declares: its name, its home, its constructors.
type FvSum = FvSum(String, String, [String])

fn fv_sums(ds: [Decl], root: String, acc: [FvSum]) : [FvSum] = match ds {
  [] -> acc
  [d, ...rest] -> fv_sums(rest, root, fv_sum(d, root, acc))
}

fn fv_sum(d: Decl, root: String, acc: [FvSum]) : [FvSum] = match d {
  DType(_, name, _, TBSum(vs), _, _, mo, _, _) ->
    [FvSum(name, fv_mo_home(mo, root), fv_variant_names(vs)), ...acc]
  DDoc(_, _, inner, _, _) -> fv_sum(inner, root, acc)
  DAttr(_, inner, _, _)   -> fv_sum(inner, root, acc)
  _ -> acc
}

fn fv_mo_home(mo: Option[String], root: String) : String = match mo {
  Some(m) -> m
  None    -> root
}

fn fv_variant_names(vs: [Variant]) : [String] = map(vs, (v) => match v { Var(n, _) -> n })

fn fv_with_ctors(ns: [String], sums: [FvSum], home: String, acc: [String]) : [String] = match ns {
  [] -> acc
  [n, ...rest] -> fv_with_ctors(rest, sums, home, list_append(acc, fv_ctors_of(sums, n, home)))
}

fn fv_ctors_of(sums: [FvSum], n: String, home: String) : [String] = match sums {
  [] -> []
  [FvSum(t, h, cs), ...rest] -> if t == n and h == home { cs } else { fv_ctors_of(rest, n, home) }
}

fn fv_bare(core_ids: [SymId], root: String) : ScopeView =
  sv_new(st_module_id(root), [], [], core_ids)

# Only the picks the file itself wrote. A pick names one module, so it
# outranks the plain import list even when a second import exports the
# same name.
fn fv_picks(sels: [SelImport], home: String, root: String,
      acc: [SvPick]) : [SvPick] = match sels {
  [] -> list_reverse(acc)
  [SelImport(owner, picked, names), ...rest] ->
    if fv_owner(owner, root) == home {
      fv_picks(rest, home, root, fv_pick_loop(names, st_module_id(picked), acc))
    } else { fv_picks(rest, home, root, acc) }
}

fn fv_pick_loop(names: [String], m: SymId, acc: [SvPick]) : [SvPick] =
  match names {
    [] -> acc
    [n, ...rest] -> fv_pick_loop(rest, m, [SvPick(n, m), ...acc])
  }

fn fv_ids(names: [String], acc: [SymId]) : [SymId] = match names {
  [] -> list_reverse(acc)
  [n, ...rest] -> fv_ids(rest, [st_module_id(n), ...acc])
}
