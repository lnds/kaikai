# The passes every declaration goes through right after resolution, kept in one
# place so a stream declaration and one completed on its own cannot drift apart.

import compiler.ast_decl
import compiler.ast_ids
import compiler.brand_transp
import compiler.desugar_brand
import compiler.desugar_nursery
import compiler.desugar_var
import compiler.diag
import compiler.diag_file
import compiler.symtab
import compiler.util

#[doc("What the post-resolve passes need: whether to lower `var` cells and expand the nursery capability sugar, the `nursery` function and the core modules whose bodies are not walked, and the tables the brand check reads. `transp` is the program's brand-transparency table when the declarations given are not the whole program.")]
pub(pkg) type PostCx = {
  vars: Bool,
  rewrite: Bool,
  nursery: SymId,
  cores: [String],
  df: DiagFiles,
  tab: SymTab,
  transp: Option[BrandTranspIndex]
}

#[doc("The declarations after the passes, the brand registry and attributions the nursery rewrite minted, and the diagnostics of the brand check.")]
pub(pkg) type PostResolved = {
  decls: [Decl],
  brands: [BrandRec],
  calls: [BrandCall],
  diags: [Diagnostic]
}

#[doc("Lowers `var` cells, expands `nursery { n -> .. }`, then rejects a fiber consumed by a sibling nursery, in that order.")]
pub(pkg) fn post_resolve_decls(ds: [Decl], px: PostCx) : PostResolved / Console + File {
  let lowered = if px.vars { lower_vars_decls(ds) } else { ds }
  let rw = if px.rewrite {
    rewrite_nursery_caps_decls(lowered, px.nursery, px.cores, px.df)
  } else {
    NurseryRwProgram { decls: lowered, brands: [], calls: [] }
  }
  let diags = if df_quiet(px.df) or list_is_empty(rw.brands) {
    []
  } else {
    check_nursery_brand_mismatch_decls(rw.decls, px.tab, px.df, rw.calls, rw.brands, px.transp)
  }
  PostResolved { decls: rw.decls, brands: rw.brands, calls: rw.calls, diags: diags }
}
