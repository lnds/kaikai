#[doc("""
The identity of a union component no type declares.

`type U = A | B` makes `A` a nominal type whose only declaration is the
constructor `A`: a parameter may be annotated `x: A`, and a narrowing
arm binds at it. Such a type takes its constructor's id, so a nominal
type always names one declaration and two modules that each declare an
`A` name two types.

A name one module declares needs no reader. A contested one climbs the
reader's ladder rung by rung, as a constructor written in an expression
does. The climb reads the declared names and the file views alone: the
typing environment carries this table, and it holds no symbol table.
""")]

import compiler.ast
import compiler.util
import compiler.decl_names
import compiler.symtab_build
import compiler.scope_view
import compiler.scope_file
import compiler.name_contest
import compiler.infer_index

#[doc("Every constructor declaration keyed by its name, and the file views a contested name is resolved against.")]
pub type CompIds = CompIds(NameIndex[NEnt], FileViews)

#[doc("The component table over the declared names `ents`.")]
pub fn comp_ids(ents: [NEnt], views: FileViews) : CompIds =
  CompIds(nt_index(nt_only(ents, NCCtor)), views)

#[doc("A table with no constructors: every component stays without identity.")]
pub fn comp_none() : CompIds = CompIds(idx_empty(), fv_empty())

#[doc("The constructor a type-position `nm` denotes from the module `reader`, or `sym_none()` when no constructor is spelled `nm`.")]
pub fn comp_sym(c: CompIds, reader: String, nm: String) : SymId = match c {
  CompIds(cx, views) -> {
    let cands = idx_chain(cx, nm)
    match nt_homes(cands, NCCtor, nm) {
      []  -> sym_none()
      [h] -> sym_derive(NCCtor, nm, h)
      hs  -> if list_has(hs, reader) { sym_derive(NCCtor, nm, reader) }
             else { sym_derive(NCCtor, nm, comp_climb(fv_of(views, st_module_id(reader)), sv_rungs(), nm, cands, hs)) }
    }
  }
}

# The first rung that admits a candidate answers. A rung that cannot
# tell two apart, and a name no rung reaches, still name one type: the
# first in stream order.
fn comp_climb(v: ScopeView, rungs: [SvRung], nm: String, cands: [NEnt], homes: [String]) : String =
  match rungs {
    [] -> comp_first(homes)
    [r, ...rest] -> match comp_on_rung(v, r, nm, cands, []) {
      [] -> comp_climb(v, rest, nm, cands, homes)
      on -> comp_first(on)
    }
  }

fn comp_first(homes: [String]) : String = match homes {
  [h, ..._] -> h
  []        -> ""
}

# A foreign constructor must be exported to sit on a rung; one at home
# need not be.
fn comp_on_rung(v: ScopeView, r: SvRung, nm: String, cands: [NEnt], acc: [String]) : [String] =
  match cands {
    [] -> list_reverse(acc)
    [NEnt(c, n, h, exported, _), ...rest] -> {
      let owner = st_module_id(h)
      let ok = n == nm and ncls_same(c, NCCtor) and not list_has(acc, h) and
               (exported or sym_raw(owner) == sym_raw(v.home)) and sv_admits(v, r, owner, nm)
      comp_on_rung(v, r, nm, rest, if ok { [h, ...acc] } else { acc })
    }
  }
