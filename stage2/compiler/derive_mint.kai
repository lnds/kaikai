#[doc("""
What a derive generator mints, born with the id of what it names.

A derived body is expanded before the resolver runs, so a name it spelled
would resolve like source text: a function of the deriving file that
shares the name would capture the call. A mint here carries the id of the
declaration it means, which the resolver leaves alone.

A generator also declares: the methods of the impl it builds and the
entry point beside it. Each is minted with its id, and its symbol-table
row goes back to the caller with the declarations.
""")]

import compiler.ast
import compiler.written
import compiler.decl_names
import compiler.symtab
import compiler.symtab_build
import compiler.decl_text
import compiler.core_syms
import compiler.core_protos
import compiler.core_modules
import compiler.proto_ids

#[doc("How a derived body names the operation `op` of the core protocol `g`: its dispatcher by id, through its home when `homed` so that only that home's protocols answer. The bare operation when the program holds no such dispatcher.")]
pub fn derive_op_ref(ids: ProtoIds, homed: Bool, g: CoreProto, op: String) : ExprKind = {
  let named = match pid_op_disp(ids, core_proto_id(g), op) {
    Some(s) -> if homed { pid_disp_homed_ref(ids, s) } else { pid_disp_ref(ids, s) }
    None    -> None
  }
  match named {
    Some(k) -> k
    None    -> EName(written(op))
  }
}

#[doc("A reference to the function `name` the core module `m` declares.")]
pub fn derive_lib_ref(m: CoreModule, name: String, line: Int, col: Int) : Expr =
  mk_sym(sym_derive(NCFn, name, core_module_name(m)), line, col)

#[doc("A reference to the core builtin named `name`.")]
pub fn derive_builtin_ref(name: String, line: Int, col: Int) : Expr =
  mk_sym(builtin_sym(name), line, col)

#[doc("What a derive generator hands back: the declarations it built, and the symbol-table row of every function among them, impl methods included.")]
pub type Minted = { decls: [Decl], rows: [NEnt] }

#[doc("Nothing derived.")]
pub fn minted_none() : Minted = Minted { decls: [], rows: [] }

#[doc("What a derive is for: the type's id, and the table that names it, its constructors and the module its functions are minted in.")]
pub type DeriveFor = { tab: SymTab, t: SymId }

#[doc("The name the derived type is declared with: what a generated symbol and a runtime message spell.")]
pub fn derive_type_name(f: DeriveFor) : String = written_text(sym_name(f.tab, f.t))

# The module that declares the derived type: the home its ids, and those
# of the functions derived for it, are minted with.
fn derive_home(f: DeriveFor) : String =
  if st_valid(f.tab, f.t) { written_text(sym_home(f.tab, f.t)) }
  else { panic("identity: the derived type has no row in the symbol table (derive_home)") }

#[doc("The derived type as a type expression: its declaration by id, which no homonym of another module can capture.")]
pub fn derive_self_ty(f: DeriveFor, line: Int, col: Int) : TypeExpr =
  mk_ty(TyName(DrSym(f.t), []), line, col)

#[doc("The text of a type head: its declaration's name once the reference is settled, what the source wrote before.")]
pub fn derive_ref_text(tab: SymTab, r: DeclRef) : String = match r {
  DrSym(s)              -> written_text(decl_name(tab, s))
  DrWritten(None, n)    -> written_text(n)
  DrWritten(Some(q), n) -> string_concat_all([written_text(q), ".", written_text(n)])
}

#[doc("The text of a type head written bare: empty for a qualified head, and for one already settled, which names a declared type.")]
pub fn derive_bare_text(r: DeclRef) : String = match r {
  DrWritten(None, n) -> written_text(n)
  _                  -> ""
}

# The scope the methods of the derived impl of `g` are minted in: one per
# protocol and type, so two derives of a module never share a method id.
fn derive_impl_scope(f: DeriveFor, g: CoreProto) : String =
  impl_scope_keyed(derive_home(f), string_concat_all(["derive ", core_proto_name(g), " ", derive_type_name(f)]))

#[doc("One method of a derived impl: the operation it implements, its parameters, return type and body.")]
pub type DeriveMethod = DeriveMethod(String, [Param], TypeExpr, Expr)

#[doc("The impl of the core protocol `g` for the derived type, its `methods` minted in the impl's own scope, with the row of each.")]
pub fn derive_impl(f: DeriveFor, g: CoreProto, methods: [DeriveMethod], line: Int, col: Int) : Minted = {
  let scope = derive_impl_scope(f, g)
  let fns = map(methods, (m) => match m {
    DeriveMethod(op, params, ret, body) ->
      DFn(false, fnid_decl(method_sym(op, scope)), [], params, Some(ret), REmpty, body, line, col, None)
  })
  let rows = map(methods, (m) => match m { DeriveMethod(op, _, _, _) -> method_ent(op, scope) })
  Minted { decls: [DImpl(DrSym(core_proto_id(g)), [], derive_self_ty(f, line, col), fns, line, col, [], sym_none())],
           rows: rows }
}

#[doc("The public function `name` of the deriving module, with its row.")]
pub fn derive_fn(f: DeriveFor, name: String, params: [Param], ret: TypeExpr, body: Expr,
                 line: Int, col: Int) : Minted = {
  let home = derive_home(f)
  Minted { decls: [DFn(true, fnid_decl(sym_derive(NCFn, name, home)), [], params, Some(ret), REmpty, body, line, col, None)],
           rows: [NEnt(NCFn, name, home, true)] }
}

#[doc("Both mints, the declarations and rows of `a` before those of `b`.")]
pub fn minted_append(a: Minted, b: Minted) : Minted =
  Minted { decls: list_append(a.decls, b.decls), rows: list_append(a.rows, b.rows) }
