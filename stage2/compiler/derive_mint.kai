#[doc("""
References a derive generator mints, born with the id of what they name.

A derived body is expanded before the resolver runs, so a name it spelled
would resolve like source text: a function of the deriving file that
shares the name would capture the call. A mint here carries the id of the
declaration it means, which the resolver leaves alone.
""")]

import compiler.ast
import compiler.decl_names
import compiler.symtab_build
import compiler.core_syms
import compiler.core_protos
import compiler.core_modules
import compiler.proto_ids

#[doc("How a derived body names the operation `op` of the core protocol `g`: its dispatcher by id, through its home when `homed` so that only that home's protocols answer. The bare operation when the program holds no such dispatcher.")]
pub fn derive_op_ref(ids: ProtoIds, homed: Bool, g: CoreProto, op: String) : ExprKind = {
  let named = match pid_op_disp(ids, core_proto_id(g), op) {
    Some(s) -> if homed { pid_disp_homed_ref(ids, s) } else { pid_disp_ref(ids, s) }
    None    -> None
  }
  match named {
    Some(k) -> k
    None    -> EVar(op)
  }
}

#[doc("A reference to the function `name` the core module `m` declares.")]
pub fn derive_lib_ref(m: CoreModule, name: String, line: Int, col: Int) : Expr =
  mk_expr(ESym(sym_derive(NCFn, name, core_module_name(m)), spec_none(), name), line, col)

#[doc("A reference to the core builtin named `name`.")]
pub fn derive_builtin_ref(name: String, line: Int, col: Int) : Expr =
  mk_expr(ESym(builtin_sym(name), spec_none(), name), line, col)
