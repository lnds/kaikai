#[doc("""
Exhaustiveness of a `handle ... with E { ... }`: every op of `E` needs a
clause, unless the effect's `default { }` bridges it.

A handle installs its own evidence node, which masks any enclosing handler
of the same effect. An op with no clause is a null slot in that node, so
the handler must cover it the way a `match` must cover every variant.
""")]

import compiler.ast
import compiler.diag
import compiler.util

#[doc("The ops of `eff` that neither a clause in `clause_ops` nor a bridged default in `default_ops` covers, in declaration order.")]
pub fn handler_missing_ops(decls: [Decl], eff: String, clause_ops: [String],
                           default_ops: [String]) : [String] =
  match hc_effect_ops(decls, eff, None) {
    None      -> []
    Some(ops) -> hc_uncovered(ops, clause_ops, default_ops)
  }

#[doc("Report a handle of `eff` that leaves `missing` without a clause; returns the error count it adds.")]
pub fn report_partial_handler(file: String, eff: String, missing: [String],
                              line: Int, col: Int) : Int / Console + File = match missing {
  [] -> 0
  _  -> {
    let names = join_with(map(missing, (op) => "`#{op}`"), ", ")
    diag_error(file, line, col, "handler for `#{eff}` does not cover every op: missing #{names}")
    diag_note("an op without a clause has no handler inside this `handle`; a clause is needed even when nothing calls it")
    diag_help("add a clause for each missing op, e.g. `#{hc_first(missing)}(args, resume) -> resume(...)`")
    1
  }
}

# A source-declared effect shadows the builtin of the same name, which is
# injected at line 0.
fn hc_effect_ops(decls: [Decl], eff: String, builtin: Option[[String]]) : Option[[String]] = match decls {
  []           -> builtin
  [d, ...rest] -> match d {
    DEffect(_, name, _, ops, _, line, _, _, _) ->
      if name != eff { hc_effect_ops(rest, eff, builtin) }
      else if line != 0 { Some(hc_op_names(ops)) }
      else { hc_effect_ops(rest, eff, hc_or(builtin, hc_op_names(ops))) }
    _ -> hc_effect_ops(rest, eff, builtin)
  }
}

fn hc_or(o: Option[[String]], ops: [String]) : Option[[String]] = match o {
  Some(_) -> o
  None    -> Some(ops)
}

fn hc_op_names(ops: [EffectOp]) : [String] = match ops {
  []           -> []
  [o, ...rest] -> match o { EOp(n, _, _, _, _, _) -> [n, ...hc_op_names(rest)] }
}

fn hc_uncovered(ops: [String], have: [String], dflt: [String]) : [String] = match ops {
  []           -> []
  [o, ...rest] ->
    if hc_has(have, o) or hc_has(dflt, o) { hc_uncovered(rest, have, dflt) }
    else { [o, ...hc_uncovered(rest, have, dflt)] }
}

fn hc_has(xs: [String], s: String) : Bool = match xs {
  []           -> false
  [x, ...rest] -> x == s or hc_has(rest, s)
}

fn hc_first(xs: [String]) : String = match xs {
  []      -> ""
  [x, ..._] -> x
}
