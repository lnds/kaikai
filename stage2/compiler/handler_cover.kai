#[doc("""
Exhaustiveness of a `handle ... with E { ... }`: every op of `E` needs a
clause, unless the effect's `default { }` bridges it.

A handle installs its own evidence node, which masks any enclosing handler
of the same effect. An op with no clause is a null slot in that node, so
the handler must cover it the way a `match` must cover every variant.
""")]

import compiler.ast
import compiler.diag
import compiler.util

#[doc("The ops of the handled effect declaration `d` that neither a clause in `clause_ops` nor a bridged default in `default_ops` covers, in declaration order.")]
pub fn handler_missing_ops(d: Option[Decl], clause_ops: [String],
                           default_ops: [String]) : [String] = match d {
  Some(DEffect(_, _, _, ops, _, _, _, _)) -> hc_uncovered(hc_op_names(ops), clause_ops, default_ops)
  _ -> []
}

#[doc("Report a handle of `eff` that leaves `missing` without a clause; returns the diagnostic it rendered, if any.")]
pub fn report_partial_handler(file: String, eff: String, missing: [String],
                              line: Int, col: Int) : [Diagnostic] / Console + File = match missing {
  [] -> []
  _  -> {
    let names = join_with(map(missing, (op) => "`#{op}`"), ", ")
    let d = mk_diag(SevError, file, line, col, "handler for `#{eff}` does not cover every op: missing #{names}",
                    [ri_note(file, line, col, "an op without a clause has no handler inside this `handle`; a clause is needed even when nothing calls it"),
                     ri_help(file, line, col, "add a clause for each missing op, e.g. `#{hc_first(missing)}(args, resume) -> resume(...)`")])
    render_diag(d)
    [d]
  }
}

fn hc_op_names(ops: [EffectOp]) : [String] = match ops {
  []           -> []
  [o, ...rest] -> match o { EffOp(n, _, _, _, _, _) -> [n, ...hc_op_names(rest)] }
}

fn hc_uncovered(ops: [String], have: [String], dflt: [String]) : [String] = match ops {
  []           -> []
  [o, ...rest] ->
    if hc_has(have, o) or hc_has(dflt, o) { hc_uncovered(rest, have, dflt) }
    else { [o, ...hc_uncovered(rest, have, dflt)] }
}

fn hc_has(xs: [String], s: String) : Bool = match xs {
  []           -> false
  [x, ...rest] -> x == s or hc_has(rest, s)
}

fn hc_first(xs: [String]) : String = match xs {
  []      -> ""
  [x, ..._] -> x
}
