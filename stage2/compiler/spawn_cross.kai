#[doc("""
The row variables of each function's scheme that a spawned fiber runs, read
from the call-site instantiations the typer recorded.

A child fiber does not see the handlers around its spawner, so an effect
it runs through a row variable of its spawner's scheme is covered only if
what the caller instantiates that variable with is checked where the call
is made. A read that hands a thunk to a fiber seeds the variables of the
function it sits in; a read of a function that has such variables passes
them on to its own caller.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.util
import compiler.spawn_capture
import compiler.spawn_param
import compiler.infer_index
import compiler.infer_env_exhaust

#[doc("The call-site instantiations that matter at the spawn boundary: those that bind a row variable, and the reads that hand a thunk to a fiber without binding anything.")]
pub fn spawn_edges(insts: [ResolvedCS]) : [ResolvedCS] = filter(insts, (c) => match c {
  RCS(_, _, _, tys, units, rows, _, _) -> not list_is_empty(rows) or (list_is_empty(tys) and list_is_empty(units))
})

#[doc("The reads among `edges` that hand a thunk to a fiber.")]
pub fn spawn_sites(edges: [ResolvedCS]) : [ResolvedCS] = filter(edges, (c) => match c {
  RCS(s, _, _, _, _, _, _, _) -> sym_hands_thunk(s)
})

#[doc("The spawn-reaching row variables of every function, indexed by the function's declaration.")]
pub type SpawnReqs = { ix: NameIndex[SpawnParam], n: Int }

#[doc("The spawn-reaching row variables of every function whose reads are in `edges`, seeded by the reads `sites` that hand a thunk to a fiber.")]
pub fn spawn_reqs_of(edges: [ResolvedCS], sites: [ResolvedCS]) : SpawnReqs = {
  let seeded = foldl(sites, SpawnReqs { ix: idx_empty(), n: 0 }, seed_edge)
  if seeded.n == 0 { seeded } else { reqs_fix(edges, seeded) }
}

fn seed_edge(r: SpawnReqs, c: ResolvedCS) : SpawnReqs = match c {
  RCS(_, _, _, _, _, rows, _, owner) -> foldl(rows, r, (a, b) => req_add_tail(a, owner, b))
}

fn reqs_fix(edges: [ResolvedCS], prev: SpawnReqs) : SpawnReqs = {
  let next = foldl(edges, prev, pass_on)
  if next.n == prev.n { next } else { reqs_fix(edges, next) }
}

fn pass_on(r: SpawnReqs, c: ResolvedCS) : SpawnReqs = match c {
  RCS(s, _, _, _, _, rows, _, owner) -> match idx_chain_sym(r.ix, s) {
    []    -> r
    chain -> foldl(chain, r, (a, m) => match m {
      SPm(_, v) -> match bind_of(rows, v) {
        Some(b) -> req_add_tail(a, owner, b)
        None    -> a
      }
    })
  }
}

fn req_add_tail(r: SpawnReqs, owner: SymId, b: RowBind) : SpawnReqs = match b {
  RwB(_, row) -> match row.tail {
    Some(v) -> if sym_raw(owner) < 0 { r } else { req_add(r, owner, v) }
    None    -> r
  }
}

fn req_add(r: SpawnReqs, f: SymId, v: Int) : SpawnReqs =
  if any(idx_chain_sym(r.ix, f), (m) => match m { SPm(_, x) -> x == v }) { r }
  else { SpawnReqs { ix: idx_prepend_sym(r.ix, f, SPm(f, v)), n: r.n + 1 } }

#[doc("The row variables of `f`'s scheme that a spawned fiber runs.")]
pub fn req_vars(r: SpawnReqs, f: SymId) : [Int] = map(idx_chain_sym(r.ix, f), (m) => match m { SPm(_, v) -> v })

#[doc("What the read `c` of a function instantiates the row variables `vars` with.")]
pub fn read_rows(c: ResolvedCS, vars: [Int]) : [Row] = match c {
  RCS(_, _, _, _, _, rows, _, _) -> foldl(vars, [], (acc, v) => match bind_of(rows, v) {
    Some(b) -> match b { RwB(_, row) -> [row, ...acc] }
    None    -> acc
  })
}

fn bind_of(binds: [RowBind], v: Int) : Option[RowBind] = match binds {
  []           -> None
  [b, ...rest] -> match b {
    RwB(x, _) -> if x == v { Some(b) } else { bind_of(rest, v) }
  }
}

#[doc("The functions that contain a read handing a thunk to a fiber.")]
pub fn spawn_owners(sites: [ResolvedCS]) : [SymId] =
  foldl(sites, [], (acc, c) => match c {
    RCS(_, _, _, _, _, _, _, owner) ->
      if sym_raw(owner) >= 0 and not any(acc, (o) => sym_raw(o) == sym_raw(owner)) { [owner, ...acc] } else { acc }
  })

#[doc("The module a function was declared in.")]
pub fn decl_module_origin(d: Decl) : Option[String] = match d {
  DFn(_, _, _, _, _, _, _, _, _, _, _, mo) -> mo
  _                                  -> None
}
