#[doc("""
Which parameters of a function reach a spawned fiber, read from one walk of each
function that also feeds the spawn-boundary check.

A child fiber does not see the handlers around its spawner, so an
effect a function runs in a child on its caller's behalf is covered only
if the caller's argument is checked where it is passed. A parameter
reaches a spawn when the value it holds is read inside a spawned thunk,
or is passed to a parameter that does. Reading it through a local that
was bound from it counts.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.util
import compiler.expr_positions
import compiler.handler_alias
import compiler.spawn_capture
import compiler.spawn_param

#[doc("A local bound to an expression.")]
pub type LetBind = LB(LocalId, Expr)

#[doc("What one function does at the spawn boundary: its declaration, the calls that start a fiber, the other calls into a function, and the locals it binds.")]
pub type SpawnFacts = SF(Decl, [Expr], [Expr], [LetBind])

type FactAcc = FA([Expr], [Expr], [LetBind])

#[doc("The spawn facts of every function in `decls`, each read in a single walk.")]
pub fn spawn_facts_of(decls: [Decl]) : [SpawnFacts] = map(fn_decls(decls, []), spawn_facts)

fn spawn_facts(d: Decl) : SpawnFacts = match d {
  DFn(_, _, _, _, _, _, body, _, _, _) -> match collect_facts(body, FA([], [], [])) {
    FA(sp, cs, ls) -> SF(d, list_reverse(sp), list_reverse(cs), ls)
  }
  _ -> SF(d, [], [], [])
}

fn collect_facts(e: Expr, a: FactAcc) : FactAcc =
  foldl(xp_positions(e), fact_here(e, a), (x, p) => match p { XP(_, c) -> collect_facts(c, x) })

fn fact_here(e: Expr, a: FactAcc) : FactAcc = match a {
  FA(sp, cs, ls) -> match e.kind {
    ECall(callee, _) -> if callee_is_spawn(callee) { FA([e, ...sp], cs, ls) } else { fact_call(e, a) }
    EPipe(_, _)      -> fact_call(e, a)
    EBlock(stmts, _) -> FA(sp, cs, foldl(stmts, ls, (l, s) => match s {
      SLet(pat, _, rhs) -> match pat.pkind { PBind(b) -> [LB(b.id, rhs), ...l]  _ -> l }
      _                 -> l
    }))
    _ -> a
  }
}

fn fact_call(e: Expr, a: FactAcc) : FactAcc = match a {
  FA(sp, cs, ls) -> match call_target(e) {
    Some(_) -> FA(sp, [e, ...cs], ls)
    None    -> a
  }
}

#[doc("The reaching parameters of every function in `facts`, given those already known for the functions they call.")]
pub fn spawn_params_from(facts: [SpawnFacts], known: [SpawnParam]) : [SpawnParam] =
  spawn_params_fix(facts, known, [])

#[doc("The entries of `table` that belong to functions declared in `decls`.")]
pub fn spawn_params_in(table: [SpawnParam], decls: [Decl]) : [SpawnParam] = {
  let own = fn_decls(decls, [])
  filter(table, (m) => match m {
    SPm(s, _) -> any(own, (d) => match d {
      DFn(_, fid, _, _, _, _, _, _, _, _) -> sym_raw(fnid_sym(fid)) == sym_raw(s)
      _                                   -> false
    })
  })
}

#[doc("The positions of the parameters of `f` that reach a spawned fiber.")]
pub fn spawn_params_for(table: [SpawnParam], f: SymId) : [Int] = match table {
  []                  -> []
  [SPm(s, ps), ...rest] -> if sym_raw(s) >= 0 and sym_raw(s) == sym_raw(f) { ps } else { spawn_params_for(rest, f) }
}

#[doc("The function a call or a pipe into a function reaches, with the arguments it passes.")]
pub fn call_target(e: Expr) : Option[(SymId, [Expr])] = match e.kind {
  ECall(callee, args_) -> match callee.kind {
    ESym(s, _) -> Some((s, args_))
    _          -> None
  }
  EPipe(a, b) -> match b.kind {
    ESym(s, _) -> Some((s, [a]))
    ECall(callee, rest) -> match callee.kind {
      ESym(s, _) -> Some((s, [a, ...rest]))
      _          -> None
    }
    _ -> None
  }
  _ -> None
}

#[doc("The arguments of `args_` at the positions in `idxs`.")]
pub fn args_at(args_: [Expr], idxs: [Int]) : [Expr] = args_at_from(args_, idxs, 0)

fn args_at_from(args_: [Expr], idxs: [Int], i: Int) : [Expr] = match args_ {
  []           -> []
  [a, ...rest] -> if any(idxs, (x) => x == i) { [a, ...args_at_from(rest, idxs, i + 1)] } else { args_at_from(rest, idxs, i + 1) }
}

fn fn_decls(ds: [Decl], acc: [Decl]) : [Decl] = match ds {
  []           -> list_reverse(acc)
  [d, ...rest] -> match d {
    DFn(_, _, _, _, _, _, _, _, _, _) -> fn_decls(rest, [d, ...acc])
    DUnstable(inner, _, _)            -> fn_decls([inner, ...rest], acc)
    DProtoLaws(_, inner, _, _, _)     -> fn_decls([inner, ...rest], acc)
    DImplAxiom(_, inner, _, _, _)     -> fn_decls([inner, ...rest], acc)
    DConstructor(inner, _, _)         -> fn_decls([inner, ...rest], acc)
    _                                 -> fn_decls(rest, acc)
  }
}

fn spawn_params_fix(facts: [SpawnFacts], known: [SpawnParam], prev: [SpawnParam]) : [SpawnParam] = {
  let table = list_append(prev, known)
  let next = filter(map(facts, (f) => fn_spawn_params(table, f)), (m) => match m { SPm(_, ps) -> not list_is_empty(ps) })
  if spawn_params_size(next) == spawn_params_size(prev) { next } else { spawn_params_fix(facts, known, next) }
}

fn spawn_params_size(t: [SpawnParam]) : Int = foldl(t, 0, (n, m) => match m { SPm(_, ps) -> n + list_length(ps) })

fn fn_spawn_params(table: [SpawnParam], f: SpawnFacts) : SpawnParam = match f {
  SF(d, sp, cs, lets) -> match d {
    DFn(_, fid, _, params, _, _, _, _, _, _) -> {
      let sinks = list_append(foldl(sp, [], (a, e) => list_append(spawn_thunk_of(e), a)),
                              foldl(cs, [], (a, e) => list_append(marked_args(table, e), a)))
      if list_is_empty(sinks) { SPm(fnid_sym(fid), []) }
      else { SPm(fnid_sym(fid), reaching_params(params, sinks, lets, 0, [])) }
    }
    _ -> SPm(sym_none(), [])
  }
}

fn spawn_thunk_of(e: Expr) : [Expr] = match e.kind {
  ECall(_, args_) -> last_arg(args_)
  _               -> []
}

fn reaching_params(params: [Param], sinks: [Expr], lets: [LetBind], i: Int, acc: [Int]) : [Int] = match params {
  []           -> list_reverse(acc)
  [p, ...rest] ->
    if any(sinks, (s) => reads_through(p.binder.id, s, lets)) { reaching_params(rest, sinks, lets, i + 1, [i, ...acc]) }
    else { reaching_params(rest, sinks, lets, i + 1, acc) }
}

fn reads_through(l: LocalId, e: Expr, lets: [LetBind]) : Bool =
  expr_reads_local(l, e) or any(lets, (b) => match b {
    LB(x, rhs) -> expr_reads_local(x, e) and reads_through(l, rhs, lets_without(lets, x))
  })

fn lets_without(lets: [LetBind], x: LocalId) : [LetBind] =
  filter(lets, (b) => match b { LB(y, _) -> not local_eq(x, y) })

fn marked_args(table: [SpawnParam], e: Expr) : [Expr] =
  if list_is_empty(table) { [] }
  else { match call_target(e) {
    Some((s, args_)) -> args_at(args_, spawn_params_for(table, s))
    None             -> []
  } }

fn last_arg(args_: [Expr]) : [Expr] = match args_ {
  []           -> []
  [a]          -> [a]
  [_, ...rest] -> last_arg(rest)
}
