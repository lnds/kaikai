# A literal pattern test compares with `kai_eq_raw`, which borrows both
# operands. A String, Real or fixed-width literal materialises a fresh box
# for the comparison, so the test binds it, compares, and releases it before
# branching. An Int, Bool or Char literal is an immediate and needs none.

import compiler.ast
import compiler.kir
import compiler.kir_lower

#[doc("Seal `condbr (kai_eq_raw v lit) ? ok_lbl : fail_lbl`, releasing a boxed literal before the branch.")]
pub fn kle_seal_eq(v: KVal, lit: KVal, ok_lbl: String, fail_lbl: String, pos: KPos,
                   st: LowerSt) : LowerSt / Console =
  if kle_lit_is_boxed(lit) {
    match bind_op(st, KLitOp(lit), pos) { LRes(lv, st1) ->
      match bind_op(st1, KPrim(KpEqRaw, [v, lv]), pos) { LRes(cond, st2) ->
        ls_seal(ls_emit(st2, KRC(KDrop(lv), pos)), KCondBr(cond, ok_lbl, fail_lbl, pos), fail_lbl) } }
  } else {
    match bind_op(st, KPrim(KpEqRaw, [v, lit]), pos) { LRes(cond, st1) ->
      ls_seal(st1, KCondBr(cond, ok_lbl, fail_lbl, pos), fail_lbl) }
  }

fn kle_lit_is_boxed(lit: KVal) : Bool = match lit {
  KStrV(_)      -> true
  KRealV(_)     -> true
  KFixedV(_, _) -> true
  _             -> false
}
