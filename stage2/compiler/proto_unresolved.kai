#[doc("""
The check that no protocol operation survives monomorphisation with a receiver the compiler could not settle.
A generic declaration is a template: each instantiation is a declaration of its own and is checked at its concrete types.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.proto_ids
import compiler.protos_find_impl
import compiler.protos_calls
import compiler.expr_positions
import compiler.type_text
import compiler.diag_file
import compiler.diag
import compiler.util

#[doc("Error for every protocol operation, called or taken as a value, whose receiver type is still unknown, or fixed only by the return type, in a declaration that is not a generic template.")]
pub(pkg) fn unresolved_dispatch_diags(ds: [Decl], reg: ProtocolReg, df: DiagFiles) : [Diagnostic] / Console + File =
  finalize_diags(unresolved_in_decls(ds, reg, df, []))

fn unresolved_in_decls(ds: [Decl], reg: ProtocolReg, df: DiagFiles, errs: [Diagnostic]) : [Diagnostic] / Console + File = match ds {
  [] -> errs
  [d, ...rest] -> {
    let file = decl_diag_file(d, df)
    let e1 = match d {
      DFn(_, _, tps, _, _, _, body, _, _, _) ->
        if any(tps, (b) => tb_is_type(b) or tb_is_shape(b)) { errs } else { unresolved_in_expr(body, reg, file, errs) }
      DTest(_, body, _, _, _)     -> unresolved_in_expr(body, reg, file, errs)
      DBench(_, body, _, _, _)    -> unresolved_in_expr(body, reg, file, errs)
      DCheck(_, _, body, _, _, _) -> unresolved_in_expr(body, reg, file, errs)
      _ -> errs
    }
    unresolved_in_decls(rest, reg, df, e1)
  }
}

fn unresolved_in_expr(e: Expr, reg: ProtocolReg, file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File {
  match e.kind {
    ECall(callee, args_) -> {
      let here = unresolved_site(callee, args_, e, reg, file, errs)
      let under = match callee.kind { ESym(_, _) -> here  _ -> unresolved_in_expr(callee, reg, file, here) }
      unresolved_in_exprs(args_, reg, file, under)
    }
    ESym(_, _) -> match e.ty {
      Some(TyFnT(ps, _, _)) -> unresolved_site(e, map(ps, (p) => probe_of(e, p)), e, reg, file, errs)
      _ -> errs
    }
    _ -> unresolved_in_children(xp_positions(e), reg, file, errs)
  }
}

fn unresolved_in_exprs(es: [Expr], reg: ProtocolReg, file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File = match es {
  [] -> errs
  [x, ...rest] -> unresolved_in_exprs(rest, reg, file, unresolved_in_expr(x, reg, file, errs))
}

fn unresolved_in_children(ps: [XPos], reg: ProtocolReg, file: String, errs: [Diagnostic]) : [Diagnostic] / Console + File = match ps {
  [] -> errs
  [XP(_, c), ...rest] -> unresolved_in_children(rest, reg, file, unresolved_in_expr(c, reg, file, errs))
}

fn unresolved_site(callee: Expr, args_: [Expr], at: Expr, reg: ProtocolReg, file: String,
                   errs: [Diagnostic]) : [Diagnostic] / Console + File = match pid_bare_disp(reg.ids, callee) {
  None -> errs
  Some(row) -> match args_ {
    [] -> errs
    [recv, ..._] -> if is_some(recv.ty |> and_then(ty_disp_head)) and not disp_dispatches_on_return(reg, row) { errs } else {
      let d = mk_diag(SevError, file, at.line, at.col,
        concat_all(["`", disp_op(row), "` is a protocol operation whose receiver type is not known here"]), [])
      push_diag(errs, d)
    }
  }
}

fn probe_of(at: Expr, p: Ty) : Expr =
  Expr { kind: EUnit, line: at.line, col: at.col, ty: Some(p), mode: MUnknown, site: 0 }
