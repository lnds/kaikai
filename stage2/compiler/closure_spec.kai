# compiler/closure_spec.kai — specialise higher-order calls on known
# env-empty pure closures. When a root-file call passes a pure lambda (or
# a top-level fn) to a higher-order callee, emit a per-call-site copy with
# the functional parameter beta-reduced into the body: the per-element
# indirect closure call inside the monomorphised loop collapses to the
# inlined body, and the fold's accumulator unboxes like hand-written
# recursion.
#
# Runs before monomorphise on the typed AST. The spec closes its effect
# row to pure (the inlined stage performs nothing), so mono grounds it to
# concrete types and unbox lands the loop's scalars; the caller's TCO/TRMC
# shape is recomputed downstream. An effectful or capturing stage, or one
# reached from a non-root call site, is left indirect.

import compiler.ast
import compiler.marks
import compiler.util
import compiler.pipe_fusion
import compiler.closure_spec_ast
import compiler.closure_spec_emit
import compiler.self_call
import compiler.symtab_build
import compiler.decl_names
import compiler.emit_shared
import compiler.symtab
import compiler.core_syms
import compiler.proto_ids

#[doc("What closure specialisation hands back: the decls with the per-site specs appended and their call sites retargeted, and the table row of each spec.")]
pub type CSpecOut = { decls: [Decl], rows: [NEnt] }

#[doc("Specialise every higher-order call on a known env-empty closure. Runs before monomorphisation, which then grounds each spec to concrete types — the inlined loop body unboxes exactly like the hand-written recursion. `tab` holds the declarations of `ds`.")]
pub fn closure_spec_pass(ds: [Decl], target: String, tab: SymTab, ids: ProtoIds) : CSpecOut = {
  let hofns = collect_hofns(ds)
  if list_length(hofns) == 0 { CSpecOut { decls: ds, rows: [] } }
  else { cspec_fixpoint(ds, hofns, [], [], cspec_fuel(), target, tab, ids) }
}

# Specialisation propagates across fn boundaries: specialising `foldl`
# on lambda L rewrites its body's `foldl_loop(..., f)` — where `f` is
# now bound to L — into a fresh higher-order call that discovers a new
# request. A bounded fixpoint drains the worklist; the fuel is a
# runaway backstop, never reached for real programs (the (fn, site)
# key set is finite).
fn cspec_fuel() : Int = 64

# Discover + emit specs to a fixpoint over the UN-rewritten decls, then
# rewrite once at the end. A newly emitted spec's body still carries
# the raw `inner(..., L)` call whose request the next round must find;
# rewriting inside the loop would retarget it away before it is seen,
# stranding the transitive spec (`foldl → foldl_loop`).
# A spec is a declaration of its own, so each round's specs enter the
# table: the next round spells a spec's host and callee from it.
fn cspec_fixpoint(ds: [Decl], hofns: [Decl], emitted: [SymId], rows: [NEnt], fuel: Int, target: String, tab: SymTab, ids: ProtoIds) : CSpecOut =
  if fuel <= 0 { CSpecOut { decls: rewrite_all(ds, ds, tab, ids, hofns, target), rows: rows } }
  else {
    let reqs = dedup_reqs(cs_collect_decls(ds, ds, tab, ids, hofns), tab, target, emitted, [])
    if list_length(reqs) == 0 { CSpecOut { decls: rewrite_all(ds, ds, tab, ids, hofns, target), rows: rows } }
    else {
      let specs = map(reqs, (r) => emit_cspec(r, req_spec_name(tab, r), target))
      let rows1 = map(reqs, (r) => req_spec_row(tab, r, target))
      let ds1 = list_append(ds, specs)
      let hofns1 = list_append(hofns, filter_hofns(specs))
      let emitted1 = list_append(emitted, map(reqs, (r) => req_spec_sym(tab, r, target)))
      cspec_fixpoint(ds1, hofns1, emitted1, list_append(rows, rows1), fuel - 1, target, st_extend(tab, rows1), ids)
    }
  }

fn req_spec_name(tab: SymTab, r: CSpecReq) : String =
  match r { CSReq(callee, _, _, disc) -> cs_spec_name(tab, callee, disc) }

# The name of the spec of the callee `hd` on the closure `disc` identifies.
fn cs_spec_name(tab: SymTab, hd: Decl, disc: String) : String =
  cspec_name(cs_decl_mo(hd), cs_decl_text(tab, hd), disc)

fn req_spec_sym(tab: SymTab, r: CSpecReq, target: String) : SymId = cspec_sym(req_spec_name(tab, r), target)

# A spec is exported exactly when its callee is: it is declared with the callee's own flag.
fn req_spec_row(tab: SymTab, r: CSpecReq, target: String) : NEnt =
  match r { CSReq(callee, _, _, _) -> NEnt(NCFn, req_spec_name(tab, r), target, decl_is_pub(callee), NmSpec) }

fn decl_is_pub(d: Decl) : Bool =
  match d { DFn(p, _, _, _, _, _, _, _, _, _) -> p  _ -> false }

fn dedup_reqs(reqs: [CSpecReq], tab: SymTab, target: String, emitted: [SymId], seen: [SymId]) : [CSpecReq] =
  match reqs {
    [] -> []
    [r, ...rest] -> {
      let s = req_spec_sym(tab, r, target)
      if syms_have(emitted, s) or syms_have(seen, s) { dedup_reqs(rest, tab, target, emitted, seen) }
      else { [r, ...dedup_reqs(rest, tab, target, emitted, [s, ...seen])] }
    }
  }

fn syms_have(ss: [SymId], s: SymId) : Bool =
  match ss {
    [] -> false
    [x, ...rest] -> sym_raw(x) == sym_raw(s) or syms_have(rest, s)
  }

fn filter_hofns(specs: [Decl]) : [Decl] =
  match specs {
    [] -> []
    [d, ...rest] -> if decl_is_hofn(d) { [d, ...filter_hofns(rest)] } else { filter_hofns(rest) }
  }

# ---- higher-order fn discovery ----

fn collect_hofns(ds: [Decl]) : [Decl] =
  match ds {
    [] -> []
    [d, ...rest] -> if decl_is_hofn(d) { [d, ...collect_hofns(rest)] } else { collect_hofns(rest) }
  }

# A higher-order fn declares at least one parameter whose annotated
# type is a function type. That parameter is the inlining target.
fn decl_is_hofn(d: Decl) : Bool =
  first_fn_param_idx(decl_params(d), 0) >= 0

fn is_fn_param(p: Param) : Bool =
  match p.ptype {
    Some(te) -> match te.tkind { TyFn(_, _, _) -> true  _ -> false }
    None     -> false
  }

# Index of the first functional parameter, or -1 if none.
fn first_fn_param_idx(ps: [Param], i: Int) : Int =
  match ps {
    [] -> 0 - 1
    [p, ...rest] -> if is_fn_param(p) { i } else { first_fn_param_idx(rest, i + 1) }
  }

# The higher-order fn a call names: the declaration its id names. A
# specialisation is already specialised, and a local is no declaration,
# so neither names one.
fn callee_hofn(hofns: [Decl], callee: Expr) : Option[Decl] = match callee.kind {
  ESym(s, inst) -> if inst == spec_none() { lookup_hofn_sym(hofns, s) } else { None }
  _             -> None
}

fn lookup_hofn_sym(hofns: [Decl], s: SymId) : Option[Decl] = match hofns {
  [] -> None
  [d, ...rest] -> if sym_raw(s) >= 0 and sym_raw(cs_decl_sym(d)) == sym_raw(s) { Some(d) } else { lookup_hofn_sym(rest, s) }
}

# ---- request collection (read-only walk) ----

# Only root-file decls (`mo == None`) seed specialisation requests: the
# stdlib/compiler's own internal higher-order call sites (`mo != None`)
# carry elaborate types whose specs miscompile, and the user's win comes
# entirely from root call sites. A generated spec is itself `mo == None`,
# so the transitive chain (a fold's spec calling its loop) is still walked.
fn cs_collect_decls(ds: [Decl], all: [Decl], tab: SymTab, ids: ProtoIds, hofns: [Decl]) : [CSpecReq] =
  match ds {
    [] -> []
    [d, ...rest] -> {
      let here = if cs_specialisable_host(tab, d) { cs_collect_expr(decl_body(d), cs_decl_sym(d), all, tab, ids, hofns) } else { [] }
      list_append(here, cs_collect_decls(rest, all, tab, ids, hofns))
    }
  }

# A spec is named for its lambda's body position. A derived body
# carries the position of the `type` it was derived from, so two nested
# combinators inside one derive share a key and their specs collide —
# the encoder that writes a payload gets the decoder's inlined stage.
# Only a hand-written root-file body has positions that separate.
fn cs_specialisable_host(tab: SymTab, d: Decl) : Bool =
  match cs_decl_mo(d) { Some(_) -> false  None -> not cs_decl_is_derived(tab, d) }

# An impl method or a derived writer: the functions a derive writes.
fn cs_decl_is_derived(tab: SymTab, d: Decl) : Bool = match d {
  DFn(_, f, _, _, _, _, _, _, _, _) -> match sym_mint(tab, fnid_sym(f)) {
    NmImpl      -> true
    NmBinWriter -> true
    _           -> false
  }
  _ -> false
}

# Bottom-up read walk: a request per specialisable `G(args)`. Children
# first so nested folds are discovered too.
fn cs_collect_expr(e: Expr, host: SymId, all: [Decl], tab: SymTab, ids: ProtoIds, hofns: [Decl]) : [CSpecReq] = {
  let kid_reqs = collect_kids(cspec_kids(e), host, all, tab, ids, hofns)
  list_append(kid_reqs, site_req(e, host, all, tab, ids, hofns))
}

fn collect_kids(es: [Expr], host: SymId, all: [Decl], tab: SymTab, ids: ProtoIds, hofns: [Decl]) : [CSpecReq] =
  match es {
    [] -> []
    [k, ...rest] -> list_append(cs_collect_expr(k, host, all, tab, ids, hofns), collect_kids(rest, host, all, tab, ids, hofns))
  }

# A specialisation request for this node when it is a higher-order call
# on an env-empty closure; empty otherwise.
fn site_req(e: Expr, host: SymId, all: [Decl], tab: SymTab, ids: ProtoIds, hofns: [Decl]) : [CSpecReq] =
  match e.kind {
    ECall(callee, args_) -> match callee_hofn(hofns, callee) {
      Some(hd) -> req_of(args_, hd, host, all, tab, ids)
      None     -> []
    }
    _ -> []
  }

fn req_of(args_: [Expr], hd: Decl, host: SymId, all: [Decl], tab: SymTab, ids: ProtoIds) : [CSpecReq] = {
  let idx = first_fn_param_idx(decl_params(hd), 0)
  if idx < 0 or idx >= list_length(args_) or not hofn_specialisable(ids, hd, idx) { [] }
  else {
    match classify_closure(ids, elem_at(args_, idx), all, tab) {
      Some(ca) -> [CSReq(hd, idx, ca, closure_disc(tab, host, ca))]
      None     -> []
    }
  }
}

# ---- call-site rewrite (pure map) ----

fn rewrite_all(ds: [Decl], all: [Decl], tab: SymTab, ids: ProtoIds, hofns: [Decl], target: String) : [Decl] =
  map(ds, (d) => rewrite_decl(d, all, tab, ids, hofns, target))

# Retarget call sites only in the decls that seeded requests — root-file
# decls and the generated specs (all `mo == None`). A stdlib/compiler
# decl is left untouched: no spec was discovered for its internal calls.
fn rewrite_decl(d: Decl, all: [Decl], tab: SymTab, ids: ProtoIds, hofns: [Decl], target: String) : Decl =
  match d {
    DFn(p, f, tp, ps, rt, row, body, l, c, mo) ->
      if cs_specialisable_host(tab, d) {
        DFn(p, f, tp, ps, rt, row, rewrite_expr(body, fnid_sym(f), all, tab, ids, hofns, target), l, c, mo)
      } else { d }
    _ -> d
  }

# Rewrite bottom-up: children via the shared functor, then this node.
fn rewrite_expr(e: Expr, host: SymId, all: [Decl], tab: SymTab, ids: ProtoIds, hofns: [Decl], target: String) : Expr = {
  let e1 = Expr { kind: map_expr_kind(e.kind, (k) => rewrite_expr(k, host, all, tab, ids, hofns, target)),
                  line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
  retarget_site(e1, host, all, tab, ids, hofns, target)
}

# A specialisable higher-order call `G(args)` becomes `G__cspec__<disc>(rest)`
# with the functional argument dropped; other nodes pass through.
fn retarget_site(e: Expr, host: SymId, all: [Decl], tab: SymTab, ids: ProtoIds, hofns: [Decl], target: String) : Expr =
  match e.kind {
    ECall(callee, args_) -> match callee_hofn(hofns, callee) {
      Some(hd) -> retarget_call(e, callee, args_, hd, host, all, tab, ids, target)
      None     -> e
    }
    _ -> e
  }

fn retarget_call(e: Expr, callee: Expr, args_: [Expr], hd: Decl, host: SymId, all: [Decl], tab: SymTab, ids: ProtoIds, target: String) : Expr = {
  let idx = first_fn_param_idx(decl_params(hd), 0)
  if idx < 0 or idx >= list_length(args_) or not hofn_specialisable(ids, hd, idx) { e }
  else {
    match classify_closure(ids, elem_at(args_, idx), all, tab) {
      Some(ca) -> {
        let nm = cs_spec_name(tab, hd, closure_disc(tab, host, ca))
        Expr { kind: ECall(retarget_callee(callee, cspec_sym(nm, target)), drop_at(args_, idx)),
               line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
      }
      None -> e
    }
  }
}

# A callee is safe to specialise only if every type variable in its
# result is grounded by mono from an argument — i.e. it also appears in a
# surviving parameter's type. A type variable that lives ONLY in the
# result (`b` in `map_sum: (a)->b : b`, a collect's or `flat_map`'s
# element type) stays a tyvar after the spec closes its row, so mono
# cannot land it; the loop boxes, and an arity-0 protocol op resolved
# through it (`zero()`) or an RC-shape it disturbs then misbehaves.
# Declining keeps those calls indirect (correct). Type variables are
# lowercase-initial names (declared `[a, b]` OR implicit); concrete types
# (`Int`, `Vec`) are capital and never match. The effect row is exempt —
# it lives in the row, not a `TyName`, and the spec closes it.
fn hofn_specialisable(ids: ProtoIds, hd: Decl, idx: Int) : Bool =
  match hd {
    DFn(_, me, _, ps, rt, _, body, _, _, _) -> {
      # A return-only tparam alone is fine — mono grounds it from the call
      # site's resolved return type, and unbox lands the loop's element.
      # The unsound case is narrower: a return-only tparam that the body
      # resolves through an ARITY-0 protocol op (`zero()`/`one()`), whose
      # result type IS that tparam and so cannot be pinned from any datum.
      # A collect uses `vec_push`/`vec_reserve` (parametric, element opaque)
      # and specialises; `map_sum`'s `zero()` still declines.
      let unsound_ret = any_return_only(drop_param_at(ps, idx), rt) and body_has_arity0_proto_op(ids, body)
      let flow_ok = functional_param_safe(body, param_id_at(ps, idx), SelfRef(me))
      not unsound_ret and flow_ok
    }
    _ -> false
  }

# True when the body applies an arity-0 protocol op — a bare op reference
# reified to a dispatcher, called with no arguments. Such an
# op's result type is the protocol's own tparam, unpinnable from any datum,
# so inlining a callee that resolves one through a return-only tparam
# leaves the op's runtime dispatch stranded (`no impl of … for runtime
# head`). `zero()`/`one()` are the ring cases.
fn body_has_arity0_proto_op(ids: ProtoIds, e: Expr) : Bool =
  match e.kind {
    ECall(callee, args_) -> arity0_proto_call(ids, callee, args_) or body_has_arity0_proto_op(ids, callee) or kids_have_arity0_proto_op(ids, args_)
    _ -> kids_have_arity0_proto_op(ids, cspec_kids(e))
  }

fn arity0_proto_call(ids: ProtoIds, callee: Expr, args_: [Expr]) : Bool =
  list_length(args_) == 0 and callee_is_proto_op(ids, callee)

fn kids_have_arity0_proto_op(ids: ProtoIds, es: [Expr]) : Bool =
  match es {
    [] -> false
    [k, ...rest] -> body_has_arity0_proto_op(ids, k) or kids_have_arity0_proto_op(ids, rest)
  }

fn callee_is_proto_op(ids: ProtoIds, callee: Expr) : Bool = match pid_ref_disp(ids, callee) {
  Some(_) -> true
  None    -> false
}

# The functional parameter's flow must not fork across a function
# boundary. Within one callee body, if the param is BOTH applied
# (`key(h)`) AND passed as a value to a DIFFERENT fn (`group_by_loop`),
# specialising forces a second independent specialisation that re-inlines
# the same closure transitively; the two specialisations' RC bookkeeping
# does not reconcile and a use-after-free results. A body that only passes
# it to another fn (a fold's `foldl_loop(..., f)` — no application) is
# safe: the value flows through untouched and the inner spec inlines it
# once. A body that applies it and passes it only to its OWN recursion (a
# fold's loop step `foldl_loop(..., f(acc,x), f)`) is safe too, since
# `retarget_self` folds that into the same spec.
fn functional_param_safe(body: Expr, f: LocalId, me: SelfRef) : Bool =
  not (param_applied(body, f) and passed_to_other(body, f, me))

# The parameter `f` appears in callee position (`f(...)`).
fn param_applied(e: Expr, f: LocalId) : Bool =
  match e.kind {
    ECall(callee, args_) ->
      reads_local(callee, f) or param_applied(callee, f) or kids_applied(args_, f)
    _ -> kids_applied(cspec_kids(e), f)
  }

fn kids_applied(es: [Expr], f: LocalId) : Bool =
  match es {
    [] -> false
    [k, ...rest] -> param_applied(k, f) or kids_applied(rest, f)
  }

# The parameter `f` appears as a plain argument in a call to a fn other than `me`.
fn passed_to_other(e: Expr, f: LocalId, me: SelfRef) : Bool =
  match e.kind {
    ECall(callee, args_) -> call_passes_to_other(callee, args_, f, me)
    _ -> kids_passed(cspec_kids(e), f, me)
  }

fn call_passes_to_other(callee: Expr, args_: [Expr], f: LocalId, me: SelfRef) : Bool = {
  let here = not is_self_callee(callee, me) and args_read_local(args_, f)
  here or passed_to_other(callee, f, me) or kids_passed(args_, f, me)
}

fn kids_passed(es: [Expr], f: LocalId, me: SelfRef) : Bool =
  match es {
    [] -> false
    [k, ...rest] -> passed_to_other(k, f, me) or kids_passed(rest, f, me)
  }

fn args_read_local(args_: [Expr], f: LocalId) : Bool =
  match args_ {
    [] -> false
    [a, ...rest] -> reads_local(a, f) or args_read_local(rest, f)
  }

# True when `e` is a read of the binder `l`.
fn reads_local(e: Expr, l: LocalId) : Bool =
  match e.kind { ELocal(x) -> local_eq(x, l)  _ -> false }

# True when some lowercase type-variable name appears in the result type
# but in no surviving parameter type — a return-only tparam.
fn any_return_only(ps: [Param], rt: Option[TypeExpr]) : Bool = {
  let in_params = sig_tparam_names(ps, None)
  return_only_exists(opt_te_names(rt), in_params)
}

fn return_only_exists(in_ret: [String], in_params: [String]) : Bool =
  match in_ret {
    [] -> false
    [t, ...rest] ->
      (is_tyvar_name(t) and not list_has(in_params, t)) or return_only_exists(rest, in_params)
  }

# A type-variable name is lowercase-initial (a concrete type ctor is
# capital). Empty names never occur in a resolved signature.
fn is_tyvar_name(n: String) : Bool = not name_is_global(n)

# A functional argument qualifies iff it is a syntactic lambda that
# captures nothing beyond its own params, or a reference to a
# monomorphic top-level fn — and its resolved row is PURE. A local is
# never a top-level fn. An effectful closure is
# left alone: a `map`/pipe over it observes per-element effect ordering
# that inlining the stage into the loop would reorder (soundness, the
# same gate pipe fusion applies).
fn classify_closure(ids: ProtoIds, a: Expr, all: [Decl], tab: SymTab) : Option[ClosureArg] =
  if not fn_ty_pure(a.ty) { None }
  else {
    match a.kind {
      ELambda(ps, b) ->
        if captures_free(tab, b, cs_param_ids(ps)) { None } else { Some(CaLambda(ps, b)) }
      ESym(s, _) -> cs_named(ids, s, all)
      _ -> None
    }
  }

# The declaration a reference names, found by its id. A protocol
# dispatcher or impl method is one impl among many, so it is never inlined.
fn cs_named(ids: ProtoIds, s: SymId, all: [Decl]) : Option[ClosureArg] =
  if sym_raw(s) < 0 or pid_is_disp(ids, s) or pid_is_impl(ids, s) { None }
  else { match monomorphic_fn_with_sym(all, sym_raw(s)) { Some(d) -> Some(CaNamedFn(d))  None -> None } }

fn monomorphic_fn_with_sym(ds: [Decl], id: Int) : Option[Decl] =
  match ds {
    [] -> None
    [d, ...rest] -> match d {
      DFn(_, ds_sym, tps, _, _, _, body, _, _, _) ->
        if sym_raw(fnid_sym(ds_sym)) == id {
          if list_length(tps) == 0 and not cs_is_extern(body) { Some(d) } else { None }
        } else { monomorphic_fn_with_sym(rest, id) }
      _ -> monomorphic_fn_with_sym(rest, id)
    }
  }

# An extern fn's body is a marker the backends replace with a shim, not an
# expression a spec could inline.
fn cs_is_extern(body: Expr) : Bool = match body.kind {
  EExternBody(_, _) -> true
  _                 -> false
}

# The closure's resolved type is a function whose effect row is pure —
# empty, or masked to pure (only `Mutable`, per pipe fusion's rule). A
# non-function or effectful type declines specialisation.
fn fn_ty_pure(t: Option[Ty]) : Bool =
  match t {
    Some(TyFnT(_, _, row)) -> pipe_fusion_labels_pure(row.labels)
    _                      -> false
  }

# ---- capture analysis (scoped) ----

# True when the body reads a binder declared neither by its own params
# nor inside it. Such a read is a captured caller local, so the closure
# carries an env.
fn captures_free(tab: SymTab, e: Expr, bound: [LocalId]) : Bool =
  match e.kind {
    ELocal(l)         -> not cs_has(bound, l)
    # A core builtin is no global here: a lambda that calls one is not specialised.
    ESym(s, _)        -> sym_is_builtin(tab, s)
    # A lambda that calls a primitive mark is not specialised.
    EMark(m)          -> mark_is_prim(m)
    ELambda(ps, b)    -> captures_free(tab, b, list_append(bound, cs_param_ids(ps)))
    EBlock(ss, t)     -> block_captures(tab, ss, t, bound)
    EMatch(scr, arms) -> captures_free(tab, scr, bound) or arms_capture(tab, arms, bound)
    _                 -> kids_capture(tab, cspec_kids(e), bound)
  }

fn kids_capture(tab: SymTab, es: [Expr], bound: [LocalId]) : Bool =
  match es {
    [] -> false
    [c, ...rest] -> captures_free(tab, c, bound) or kids_capture(tab, rest, bound)
  }

# A `let` binder extends `bound` for the rest of the block. A stmt shape
# we do not model (index-assign, var, use) is treated as a capture — err
# strict, skip.
fn block_captures(tab: SymTab, ss: [Stmt], t: Option[Expr], bound: [LocalId]) : Bool =
  match ss {
    [] -> opt_captures(tab, t, bound)
    [s, ...rest] -> match s {
      SLet(pat, _, rhs) ->
        captures_free(tab, rhs, bound) or block_captures(tab, rest, t, list_append(bound, cs_pat_binders(pat, [])))
      SExprStmt(x)  -> captures_free(tab, x, bound) or block_captures(tab, rest, t, bound)
      SAssert(c, m) -> captures_free(tab, c, bound) or opt_captures(tab, m, bound) or block_captures(tab, rest, t, bound)
      _ -> true
    }
  }

fn opt_captures(tab: SymTab, o: Option[Expr], bound: [LocalId]) : Bool =
  match o { Some(e) -> captures_free(tab, e, bound)  None -> false }

fn arms_capture(tab: SymTab, arms: [Arm], bound: [LocalId]) : Bool =
  match arms {
    [] -> false
    [Arm(pat, g, b), ...rest] -> {
      let b2 = list_append(bound, cs_pat_binders(pat, []))
      opt_captures(tab, g, b2) or captures_free(tab, b, b2) or arms_capture(tab, rest, bound)
    }
  }
