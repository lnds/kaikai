# compiler/scope_walk.kai — the scope-aware expression rewrite the
# name-scoping passes share. `sh` accumulates the lexically bound
# names; a pass decides what a free name means through `lf`, which
# sees every `EVar` / `EField` node and either replaces it whole or
# yields to the generic descent. `tyf` rewrites each annotation the
# walk crosses and `hdf` each handler head.

import compiler.ast
import compiler.modules

#[doc("Names bound by a param list, prepended onto `acc`.")]
pub fn sw_params(ps: [Param], acc: [String]) : [String] = match ps {
  [] -> acc
  [p, ...rest] -> sw_params(rest, [p.pname, ...acc])
}

fn sw_re(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode }

#[doc("Rewrite one expression; `sh` holds the names already bound in scope. `lf` answers for a free `EVar`/`EField` (None = descend), `tyf` maps each annotation, `hdf` each `with E` head.")]
pub fn sw_expr(e: Expr, sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (String) -> String) : Expr = match e.kind {
  EVar(_) -> match lf(e, sh) { Some(r) -> r  None -> e }
  EField(obj, f) -> match lf(e, sh) {
    Some(r) -> r
    None -> sw_re(e, EField(sw_expr(obj, sh, lf, tyf, hdf), f))
  }
  ECall(callee, args_) ->
    sw_re(e, ECall(sw_expr(callee, sh, lf, tyf, hdf), sw_exprs(args_, sh, lf, tyf, hdf)))
  EIndex(a, b) -> sw_re(e, EIndex(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf)))
  EBinop(op, a, b) ->
    sw_re(e, EBinop(op, sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf)))
  EUnop(op, x) -> sw_re(e, EUnop(op, sw_expr(x, sh, lf, tyf, hdf)))
  EIf(c, t_, eo) ->
    sw_re(e, EIf(sw_expr(c, sh, lf, tyf, hdf), sw_expr(t_, sh, lf, tyf, hdf),
                 sw_expr_opt(eo, sh, lf, tyf, hdf)))
  EMatch(scr, arms) ->
    sw_re(e, EMatch(sw_expr(scr, sh, lf, tyf, hdf), sw_arms(arms, sh, lf, tyf, hdf)))
  ELambda(ps, body) ->
    sw_re(e, ELambda(sw_typed_params(ps, tyf),
                     sw_expr(body, sw_params(ps, sh), lf, tyf, hdf)))
  ERecordLit(n, fis) -> sw_re(e, ERecordLit(n, sw_fis(fis, sh, lf, tyf, hdf)))
  EList(els) -> sw_re(e, EList(sw_elems(els, sh, lf, tyf, hdf)))
  ERange(a, b, stp) ->
    sw_re(e, ERange(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf),
                    sw_expr_opt(stp, sh, lf, tyf, hdf)))
  EBlock(ss, tail) -> match sw_stmts(ss, sh, lf, tyf, hdf, []) {
    SWS(ss1, sh1) -> sw_re(e, EBlock(ss1, sw_expr_opt(tail, sh1, lf, tyf, hdf)))
  }
  EPipe(a, b) -> sw_re(e, EPipe(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf)))
  EMapPipe(a, b) ->
    sw_re(e, EMapPipe(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf)))
  EFlatMapPipe(a, b) ->
    sw_re(e, EFlatMapPipe(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf)))
  EFilterPipe(a, b) ->
    sw_re(e, EFilterPipe(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf)))
  EBang(x) -> sw_re(e, EBang(sw_expr(x, sh, lf, tyf, hdf)))
  ELitUnit(x, u) -> sw_re(e, ELitUnit(sw_expr(x, sh, lf, tyf, hdf), u))
  EHandle(body, eff, tas, init, alias, hcs, ret) -> {
    let shb = match alias { Some(a) -> [a, ...sh]  None -> sh }
    sw_re(e, EHandle(sw_expr(body, shb, lf, tyf, hdf), hdf(eff), map(tas, tyf),
                     sw_expr_opt(init, sh, lf, tyf, hdf), alias,
                     sw_hclauses(hcs, sh, lf, tyf, hdf),
                     sw_hreturn_opt(ret, sh, lf, tyf, hdf)))
  }
  EIntrinsic(n, args_) -> sw_re(e, EIntrinsic(n, sw_exprs(args_, sh, lf, tyf, hdf)))
  _ -> e
}

fn sw_typed_params(ps: [Param], tyf: (TypeExpr) -> TypeExpr) : [Param] =
  map(ps, (p) => Param { pname: p.pname, ptype: sw_ty_opt(p.ptype, tyf),
                         pline: p.pline, pcol: p.pcol, pborrow: p.pborrow })

fn sw_ty_opt(o: Option[TypeExpr], tyf: (TypeExpr) -> TypeExpr) : Option[TypeExpr] = match o {
  None -> None
  Some(t) -> Some(tyf(t))
}

fn sw_exprs(es: [Expr], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (String) -> String) : [Expr] = match es {
  [] -> []
  [x, ...rest] -> [sw_expr(x, sh, lf, tyf, hdf), ...sw_exprs(rest, sh, lf, tyf, hdf)]
}

fn sw_expr_opt(o: Option[Expr], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (String) -> String) : Option[Expr] = match o {
  None -> None
  Some(x) -> Some(sw_expr(x, sh, lf, tyf, hdf))
}

fn sw_fis(fis: [FieldInit], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (String) -> String) : [FieldInit] = match fis {
  [] -> []
  [FI(f, x), ...rest] ->
    [FI(f, sw_expr(x, sh, lf, tyf, hdf)), ...sw_fis(rest, sh, lf, tyf, hdf)]
}

fn sw_elems(els: [ListElem], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (String) -> String) : [ListElem] = match els {
  [] -> []
  [el, ...rest] -> {
    let el1 = match el {
      ElPlain(x)  -> ElPlain(sw_expr(x, sh, lf, tyf, hdf))
      ElSpread(x) -> ElSpread(sw_expr(x, sh, lf, tyf, hdf))
    }
    [el1, ...sw_elems(rest, sh, lf, tyf, hdf)]
  }
}

fn sw_arms(arms: [Arm], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (String) -> String) : [Arm] = match arms {
  [] -> []
  [Arm(p, g, body), ...rest] -> {
    let shb = pat_binders(p, sh)
    [Arm(p, sw_expr_opt(g, shb, lf, tyf, hdf), sw_expr(body, shb, lf, tyf, hdf)),
     ...sw_arms(rest, sh, lf, tyf, hdf)]
  }
}

#[doc("Rewrite the bodies of a handler-clause list; each clause binds its op params and `resume`.")]
pub fn sw_hclauses(hcs: [HClause], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (String) -> String) : [HClause] = match hcs {
  [] -> []
  [HC(op, ps, body, l, c), ...rest] -> {
    let shc = ["resume", ...sw_params(ps, sh)]
    [HC(op, sw_typed_params(ps, tyf), sw_expr(body, shc, lf, tyf, hdf), l, c),
     ...sw_hclauses(rest, sh, lf, tyf, hdf)]
  }
}

#[doc("Rewrite a handler `return(x)` clause body; `x` is bound inside it.")]
pub fn sw_hreturn_opt(o: Option[HReturn], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (String) -> String) : Option[HReturn] = match o {
  None -> None
  Some(HR(x, body, l, c)) -> Some(HR(x, sw_expr(body, [x, ...sh], lf, tyf, hdf), l, c))
}

# A statement list threads its binders forward: a `let` / `var` name
# scopes over the remaining statements and the block tail.
type SwStmts = SWS([Stmt], [String])

fn sw_stmts(ss: [Stmt], sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (String) -> String, acc: [Stmt]) : SwStmts = match ss {
  [] -> SWS(list_reverse(acc), sh)
  [s, ...rest] ->
    sw_stmts(rest, sw_stmt_binders(s, sh), lf, tyf, hdf, [sw_stmt(s, sh, lf, tyf, hdf), ...acc])
}

fn sw_stmt(s: Stmt, sh: [String], lf: (Expr, [String]) -> Option[Expr],
      tyf: (TypeExpr) -> TypeExpr, hdf: (String) -> String) : Stmt = match s {
  SLet(p, t, x) -> SLet(p, sw_ty_opt(t, tyf), sw_expr(x, sh, lf, tyf, hdf))
  SAssert(x, mo) -> SAssert(sw_expr(x, sh, lf, tyf, hdf), sw_expr_opt(mo, sh, lf, tyf, hdf))
  SExprStmt(x) -> SExprStmt(sw_expr(x, sh, lf, tyf, hdf))
  SIndexAssign(a, b, c, l, cc) ->
    SIndexAssign(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf),
                 sw_expr(c, sh, lf, tyf, hdf), l, cc)
  SAssign(a, b, l, c) -> SAssign(sw_expr(a, sh, lf, tyf, hdf), sw_expr(b, sh, lf, tyf, hdf), l, c)
  SVar(n, t, x, l, c) -> SVar(n, sw_ty_opt(t, tyf), sw_expr(x, sh, lf, tyf, hdf), l, c)
  SUse(n, l, c) -> SUse(hdf(n), l, c)
}

fn sw_stmt_binders(s: Stmt, sh: [String]) : [String] = match s {
  SLet(p, _, _)       -> pat_binders(p, sh)
  SVar(n, _, _, _, _) -> [n, ...sh]
  _ -> sh
}
