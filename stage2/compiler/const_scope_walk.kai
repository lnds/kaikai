# compiler/const_scope_walk.kai — the const_scope leaf over the
# shared scope walk: a free read of a colliding const name is keyed to
# its owning module; a bound name is never rewritten.

import compiler.util
import compiler.ast
import compiler.modules
import compiler.scope_walk
import compiler.const_scope_table

#[doc("Names bound by a param list, prepended onto `acc`.")]
pub fn cs_params(ps: [Param], acc: [String]) : [String] = sw_params(ps, acc)

fn cs_re(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode }

#[doc("Rewrite the free reads of colliding const names in one expression; `sh` holds the names already bound in scope.")]
pub fn cs_expr(e: Expr, sh: [String], cx: CSCtx) : Expr =
  sw_expr(e, sh, (x, s) => cs_leaf(x, s, cx), (t) => t, (n) => n)

# `mod.NAME` where NAME is a colliding pub const of `mod`: key it
# here — rqc collapses an uppercase qualified export to a bare
# `EVar` (the variant-ctor rule), which would lose the module. The
# qualifier maps through `mt` first: an aliased import collides
# under its tagged name, not the name the file wrote.
# Private consts fall through so rqc / pub-access still diagnose.
fn cs_leaf(e: Expr, sh: [String], cx: CSCtx) : Option[Expr] = match e.kind {
  EVar(nm) ->
    if not cx.free or list_has(sh, nm) { Some(e) }
    else { match cs_owner(cx, nm) {
      Some(m) -> if m == cx.target { Some(e) } else { Some(cs_re(e, EModCall(m, nm))) }
      None    -> Some(e)
    } }
  EField(obj, f) -> match obj.kind {
    EVar(m) -> {
      let tm = mt_tagged_name(cx.mt, m)
      if not list_has(sh, m) and cs_is_pub_const(cx.coll, f, tm) {
        Some(cs_re(e, EModCall(tm, f)))
      } else { None }
    }
    _ -> None
  }
  _ -> None
}

#[doc("Rewrite the bodies of a handler-clause list; each clause binds its op params and `resume`.")]
pub fn cs_hclauses(hcs: [HClause], sh: [String], cx: CSCtx) : [HClause] =
  sw_hclauses(hcs, sh, (x, s) => cs_leaf(x, s, cx), (t) => t, (n) => n)

#[doc("Rewrite a handler `return(x)` clause body; `x` is bound inside it.")]
pub fn cs_hreturn_opt(o: Option[HReturn], sh: [String], cx: CSCtx) : Option[HReturn] =
  sw_hreturn_opt(o, sh, (x, s) => cs_leaf(x, s, cx), (t) => t, (n) => n)
