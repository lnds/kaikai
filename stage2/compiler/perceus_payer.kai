#[doc("""
Who releases a binder's birth reference, and the branch rewrites that pay it on entry to the paths that skip its reads.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.perceus_reads
import compiler.ret_slots
import compiler.operators
import compiler.ast_map
import compiler.expr_positions
import compiler.marks

# Who releases a binder's birth reference.
#
# Every binding perceus tracks starts out holding one reference: a param
# the caller handed over, a `let` the value its rhs produced, an arm binder
# its bind-time incref. A read either hands that reference on (a bare read
# at the last use) or dups it. Whatever no read hands on is owed, and
# exactly one payer releases it.
#
# `pcs_fate` is the single statement of when a read hands the reference on;
# the dup decision and every drop collector ask it. The `*_payer` functions
# name the one site that pays, and each collector plants a release only
# where it is named, so two collectors can never both decide to pay the
# same binder.
#
# Invariant: pay iff a birth reference exists. A binder that never took one
# (an arm binder elided to `_`, a borrowed or raw param) owes nothing, and
# releasing it would over-free.


pub(pkg) type PcsFate = FUnread | FTransfer | FResidual

pub(pkg) type PcsPayer
  = PyNone
  | PyRead
  | PyEntry
  | PyExit
  | PyInline

#[doc("The binder sets a param's payer depends on: reads that hand the reference on, and reads forced to dup.")]
pub type PcsParamSets = { moved: [Binder], forced: [Binder] }

pub(pkg) fn pcs_fate(lu: LastUse, b: LocalId, uses: UseIx, moved: Bool, forced: Bool) : PcsFate = match lu {
  LuUnused   -> FUnread
  LuBlocked  -> FResidual
  LuAt(l, c) ->
    if forced or pcs_read_raw_at(b, uses, l, c) { FResidual }
    else if moved { FTransfer }
    else if pcs_uses_have_in_lam(uses, b) { FResidual }
    else if pcs_read_count(b, uses) >= 2 { FResidual }
    else { FTransfer }
}

pub(pkg) fn pcs_fate_of(b: LocalId, uses: UseIx, moved: Bool, forced: Bool) : PcsFate =
  pcs_fate(last_use_for(b, uses), b, uses, moved, forced)

pub(pkg) fn pcs_fate_residual(f: PcsFate) : Bool = match f {
  FResidual -> true
  _         -> false
}

pub(pkg) fn pcs_fate_transfers(f: PcsFate) : Bool = match f {
  FTransfer -> true
  _         -> false
}

pub(pkg) fn pcs_unread(b: LocalId, uses: UseIx) : Bool = match last_use_for(b, uses) {
  LuUnused -> true
  _        -> false
}

pub(pkg) fn pcs_lu_at(lu: LastUse, line: Int, col: Int) : Bool = match lu {
  LuAt(ll, lc) -> ll == line and lc == col
  _            -> false
}

fn pcs_payer_tag(p: PcsPayer) : Int = match p {
  PyNone   -> 0
  PyRead   -> 1
  PyEntry  -> 2
  PyExit   -> 3
  PyInline -> 4
}

pub(pkg) fn pcs_pays(p: PcsPayer, want: PcsPayer) : Bool = pcs_payer_tag(p) == pcs_payer_tag(want)

pub(pkg) fn pcs_param_payer(b: LocalId, uses: UseIx, sets: PcsParamSets) : PcsPayer =
  match pcs_fate_of(b, uses, pcs_has(sets.moved, b), pcs_has(sets.forced, b)) {
    FUnread   -> PyEntry
    FResidual -> PyExit
    FTransfer -> PyRead
  }

pub(pkg) fn pcs_let_payer(b: LocalId, rhs: Expr, uses: UseIx, moved: Bool, forced: Bool) : PcsPayer =
  match pcs_fate_of(b, uses, moved, forced) {
    FUnread   -> if pcs_let_paid_inline(rhs) { PyInline } else { PyExit }
    FResidual -> PyExit
    FTransfer -> PyRead
  }

pub(pkg) fn pcs_arm_payer(b: LocalId, uses: UseIx, moved: Bool, forced: Bool) : PcsPayer =
  match pcs_fate_of(b, uses, moved, forced) {
    FUnread   -> PyExit
    FResidual -> PyExit
    FTransfer -> PyRead
  }

pub(pkg) fn pcs_let_paid_inline(rhs: Expr) : Bool = match rhs.kind {
  EInt(_, _)       -> true
  EReal(_, _)      -> true
  EIntLit(_)       -> true
  EDecimalLit(_)   -> true
  EFixed(_, _)     -> true
  EBool(_)         -> true
  EChar(_)         -> true
  EStr(_, _)       -> true
  EUnit            -> true
  ECall(_, _)      -> true
  EList(_)         -> true
  ERecordLit(_, _) -> true
  ERange(_, _, _)  -> true
  ELambda(_, _)    -> true
  EBinop(_, _, _)  -> true
  EUnop(_, _)      -> true
  _                -> false
}

pub(pkg) fn pcs_names_paid_by(names: [Binder], uses: UseIx, sets: PcsParamSets, want: PcsPayer) : [Binder] = match names {
  []           -> []
  [b, ...rest] -> {
    let tl = pcs_names_paid_by(rest, uses, sets, want)
    if pcs_pays(pcs_param_payer(b.id, uses, sets), want) { [b, ...tl] } else { tl }
  }
}

fn pcs_param_drops(params: [Param], uses: UseIx, sets: PcsParamSets, want: PcsPayer) : [Stmt] = match params {
  []           -> []
  [p, ...rest] -> {
    let tl = pcs_param_drops(rest, uses, sets, want)
    if pcs_pays(pcs_param_payer(p.binder.id, uses, sets), want) {
      [pcs_make_drop_stmt(p.binder.id, p.pline, p.pcol), ...tl]
    } else { tl }
  }
}

pub(pkg) fn pcs_wrap_param_drops(body: Expr, params: [Param], uses: UseIx, sets: PcsParamSets) : Expr {
  let entry = pcs_param_drops(params, uses, sets, PyEntry)
  let exit_ = pcs_param_drops(params, uses, sets, PyExit)
  match entry {
    [] -> match exit_ {
      []         -> body
      [_, ...__] -> pcs_wrap_with_exit(body, [], exit_)
    }
    [_, ...__] -> pcs_wrap_with_exit(body, entry, exit_)
  }
}

# `EBlock([entry..., SLet(__pcs_ret, body), exit...], Some(__pcs_ret))`. The
# goto lowering recognises this shape and jumps past the exit drops, so it
# pays the same params per iteration from `pcs_param_payer` itself.
fn pcs_wrap_with_exit(body: Expr, entry: [Stmt], exit_: [Stmt]) : Expr {
  match exit_ {
    [] -> Expr { kind: EBlock(entry, Some(body)), line: body.line, col: body.col,
                 ty: body.ty, mode: body.mode,  site: body.site }
    [_, ...__] -> {
      let ret_let = SLet(
        Pattern { pkind: PBind(ret_slot_binder(RsFn)), line: body.line, col: body.col },
        None,
        body
      )
      let stmts = list_append(entry, [ret_let, ...exit_])
      let tail = Expr { kind: ELocal(ret_slot_local(RsFn)), line: body.line, col: body.col,
                        ty: body.ty, mode: body.mode,  site: body.site }
      Expr { kind: EBlock(stmts, Some(tail)), line: body.line, col: body.col,
             ty: body.ty, mode: body.mode,  site: body.site }
    }
  }
}

pub(pkg) fn pcs_make_drop_stmt(b: LocalId, ln: Int, cl: Int) : Stmt =
  SExprStmt(Expr {
    kind: ECall(
      Expr { kind: EMark(MkDrop), line: ln, col: cl,
             ty: None, mode: MUnknown , site: 0 },
      [Expr { kind: ELocal(b), line: ln, col: cl,
              ty: None, mode: MUnknown , site: 0 }]
    ),
    line: ln, col: cl, ty: None, mode: MUnknown
  , site: 0 })

pub(pkg) fn pbl_paid(nm: Binder, scope: Expr) : Expr = match pbl_plant(nm, scope) {
  PbPaid(e) -> e
  _         -> scope
}

pub(pkg) fn pbl_plantable(nm: Binder, scope: Expr) : Bool = match pbl_plant(nm, scope) {
  PbDecline -> false
  _         -> true
}

# Planting outcome: some read is not a plain move reachable here, every
# path reaches a read (nothing to release), or `e` rebuilt with the
# skipping alternatives paying on entry.
type PblOut = PbDecline | PbSame | PbPaid(Expr)

# A lambda, handler clause or assert message hides the path, a read that
# only dups leaves the birth reference owed, and a path that reaches a read
# after another consumes twice; each declines.
fn pbl_plant(nm: Binder, e: Expr) : PblOut = match e.kind {
  ELocal(u)        -> if local_eq(u, nm.id) { PbSame } else { PbDecline }
  ESym(_, _)       -> PbDecline
  EOp(_)           -> PbDecline
  EIf(c, t, oe)    -> pbl_plant_if(nm, e, c, t, oe)
  EMatch(s, arms)  -> pbl_plant_match(nm, e, s, arms)
  EBinop(op, a, b) -> if binop_is_logical(op) { pbl_plant_sc(nm, e, op, a, b) } else { pbl_plant_plain(nm, e) }
  ECall(f, _)      -> if pbl_is_dup(f) { PbDecline } else { pbl_plant_plain(nm, e) }
  _                -> pbl_plant_plain(nm, e)
}

# Through a plain position: rebuild only when something below was paid.
fn pbl_lift(o: PblOut, f: (Expr) -> Expr) : PblOut = match o {
  PbPaid(x) -> PbPaid(f(x))
  _         -> o
}

fn pbl_plant_plain(nm: Binder, e: Expr) : PblOut = match pbl_reader(nm, xp_positions(e)) {
  Some(XP(XAll, c)) ->
    pbl_lift(pbl_plant(nm, c), (c1) => pbl_rekind(e, prc_map_expr_kind(e.kind, (x) => if pbl_bare(nm, x) { c1 } else { x })))
  _ -> PbDecline
}

# One alternative: planted when it reads `nm`, released on entry when not.
fn pbl_alt(nm: Binder, alt: Expr) : PblOut =
  if pcs_mentions(nm, alt) { pbl_plant(nm, alt) } else { PbPaid(pbl_entry_drop(nm, alt)) }

fn pbl_or_same(o: PblOut, e: Expr) : Expr = match o {
  PbPaid(x) -> x
  _         -> e
}

fn pbl_plant_if(nm: Binder, e: Expr, c: Expr, t: Expr, oe: Option[Expr]) : PblOut =
  if pbl_bare(nm, c) {
    if pcs_mentions(nm, t) or pcs_mentions(nm, pbl_else(t, oe)) { PbDecline }
    else { pbl_lift(pbl_plant(nm, c), (c1) => pbl_rekind(e, EIf(c1, t, oe))) }
  }
  else {
    let el = pbl_else(t, oe)
    pbl_both(pbl_alt(nm, t), pbl_alt(nm, el), (t1, e1) => pbl_rekind(e, EIf(c, pbl_or_same(t1, t), Some(pbl_or_same(e1, el)))))
  }

# Two sibling alternatives: rebuilt when either was paid.
fn pbl_both(a: PblOut, b: PblOut, f: (PblOut, PblOut) -> Expr) : PblOut = match a {
  PbDecline -> PbDecline
  PbSame    -> match b {
    PbDecline -> PbDecline
    PbSame    -> PbSame
    PbPaid(_) -> PbPaid(f(a, b))
  }
  PbPaid(_) -> match b {
    PbDecline -> PbDecline
    _         -> PbPaid(f(a, b))
  }
}

fn pbl_else(t: Expr, oe: Option[Expr]) : Expr = match oe {
  Some(e1) -> e1
  None     -> Expr { kind: EUnit, line: t.line, col: t.col, ty: t.ty, mode: t.mode,  site: t.site }
}

# The skipped edge pays inside the expression: `a and b` becomes
# `(a or { drop; false }) and b`, `a or b` becomes `(a and { drop; true }) or b`.
# Lowering to an `if` instead would put `b` in tail position, a goto the
# short circuit never made.
fn pbl_plant_sc(nm: Binder, e: Expr, op: BinOp, a: Expr, b: Expr) : PblOut =
  if pbl_bare(nm, a) {
    if pcs_mentions(nm, b) { PbDecline } else { pbl_lift(pbl_plant(nm, a), (a1) => pbl_rekind(e, EBinop(op, a1, b))) }
  }
  else { pbl_sc_paid(nm, e, op, a, b, pbl_plant(nm, b)) }

fn pbl_sc_paid(nm: Binder, e: Expr, op: BinOp, a: Expr, b: Expr, ob: PblOut) : PblOut = match ob {
  PbDecline -> PbDecline
  _         -> {
    let skip = pbl_entry_drop(nm, pbl_rekind(b, EBool(pbl_is_or(op))))
    PbPaid(pbl_rekind(e, EBinop(op, pbl_rekind(e, EBinop(pbl_dual(op), a, skip)), pbl_or_same(ob, b))))
  }
}

fn pbl_dual(op: BinOp) : BinOp = match op {
  BoAnd -> BoOr
  _     -> BoAnd
}

fn pbl_is_or(op: BinOp) : Bool = match op {
  BoOr -> true
  _    -> false
}

fn pbl_plant_match(nm: Binder, e: Expr, s: Expr, arms: [Arm]) : PblOut =
  if pbl_bare(nm, s) {
    if pbl_arms_mention(nm, arms) { PbDecline } else { pbl_lift(pbl_plant(nm, s), (s1) => pbl_rekind(e, EMatch(s1, arms))) }
  }
  else {
    match pbl_arms(nm, arms) {
      PaDecline          -> PbDecline
      PaArms(_, false)   -> PbSame
      PaArms(arms1, true) -> PbPaid(pbl_rekind(e, EMatch(s, arms1)))
    }
  }

# The arms with each body planted or paid on entry, and whether any changed.
type PblArms = PaDecline | PaArms([Arm], Bool)

fn pbl_arms(nm: Binder, arms: [Arm]) : PblArms = match arms {
  []                       -> PaArms([], false)
  [Arm(p, og, b), ...rest] -> match pbl_arms(nm, rest) {
    PaDecline         -> PaDecline
    PaArms(rest1, ch) -> match pbl_guard(nm, og) {
      PgKeep         -> pbl_arm_body(nm, Arm(p, og, b), rest1, ch)
      PgDup(g1)      -> pbl_arm_body(nm, Arm(p, Some(g1), b), rest1, true)
    }
  }
}

fn pbl_arm_body(nm: Binder, a: Arm, rest1: [Arm], ch: Bool) : PblArms = match a {
  Arm(p, og, b) -> match pbl_alt(nm, b) {
    PbDecline  -> PaDecline
    PbSame     -> PaArms([a, ...rest1], ch)
    PbPaid(b1) -> PaArms([Arm(p, og, b1), ...rest1], true)
  }
}

# A guard read may fall through to a later arm, which no static entry drop
# can tell from an arm the guard never ran for: the read becomes a dup and
# the arm bodies pay.
type PblGuard = PgKeep | PgDup(Expr)

fn pbl_guard(nm: Binder, og: Option[Expr]) : PblGuard = match og {
  Some(g) ->
    if not pcs_mentions(nm, g) { PgKeep }
    else { PgDup(pbl_dup_reads(nm, g)) }
  None -> PgKeep
}

fn pbl_dup_reads(nm: Binder, e: Expr) : Expr = match e.kind {
  ELocal(u) -> if local_eq(u, nm.id) { pbl_rekind(e, ECall(mk_expr(EMark(MkDup), e.line, e.col), [e])) } else { e }
  _         -> pbl_rekind(e, prc_map_expr_kind(e.kind, (c) => pbl_dup_reads(nm, c)))
}

fn pbl_entry_drop(nm: Binder, alt: Expr) : Expr =
  Expr { kind: EBlock([pcs_make_drop_stmt(nm.id, alt.line, alt.col)], Some(alt)),
         line: alt.line, col: alt.col, ty: alt.ty, mode: alt.mode,  site: alt.site }

fn pbl_is_dup(f: Expr) : Bool = match f.kind {
  EMark(MkDup) -> true
  _            -> false
}

# The one position holding a consuming read: earlier positions may only
# dup, later ones must not read at all.
fn pbl_reader(nm: Binder, ps: [XPos]) : Option[XPos] = match ps {
  []                  -> None
  [XP(r, c), ...rest] ->
    if pbl_bare(nm, c) { if pbl_mentions_ps(nm, rest) { None } else { Some(XP(r, c)) } }
    else { pbl_reader(nm, rest) }
}

fn pbl_mentions_ps(nm: Binder, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> pcs_mentions(nm, c) or pbl_mentions_ps(nm, rest)
}

# A read of `nm` that is not the argument of a dup.
fn pbl_bare(nm: Binder, e: Expr) : Bool = match e.kind {
  ELocal(u)   -> local_eq(u, nm.id)
  ECall(f, _) -> if pbl_is_dup(f) { false } else { pbl_bare_ps(nm, xp_positions(e)) }
  _           -> pbl_bare_ps(nm, xp_positions(e))
}

fn pbl_bare_ps(nm: Binder, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(r, c), ...rest] -> (match r { XLam -> pcs_mentions(nm, c)  _ -> pbl_bare(nm, c) }) or pbl_bare_ps(nm, rest)
}

fn pbl_arms_mention(nm: Binder, arms: [Arm]) : Bool = match arms {
  [] -> false
  [Arm(_, og, b), ...rest] -> pbl_guard_mentions(nm, og) or pcs_mentions(nm, b) or pbl_arms_mention(nm, rest)
}

fn pbl_guard_mentions(nm: Binder, og: Option[Expr]) : Bool = match og {
  Some(g) -> pcs_mentions(nm, g)
  None    -> false
}

fn pbl_rekind(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

type PbpCx = { pnames: [Binder], uses: UseIx, moved: [Binder] }

pub(pkg) fn pbp_branch_drops(body: Expr, pnames: [Binder], uses: UseIx, moved: [Binder], read_params: [Binder]) : Expr =
  pbp_params(read_params, pbp_expr(body, PbpCx { pnames: pnames, uses: uses, moved: moved }))

fn pbp_params(ps: [Binder], body: Expr) : Expr = match ps {
  []           -> body
  [p, ...rest] -> pbp_params(rest, pbl_paid(p, body))
}

fn pbp_expr(e: Expr, cx: PbpCx) : Expr = {
  let k1 = prc_map_expr_kind(e.kind, (c) => pbp_expr(c, cx))
  pbp_rekind(e, match k1 {
    EMatch(s, arms) -> EMatch(s, map(arms, (a) => pbp_arm(a, cx)))
    EBlock(ss, ot)  -> pbp_block(ss, ot, cx)
    _               -> k1
  })
}

fn pbp_arm(a: Arm, cx: PbpCx) : Arm = match a {
  Arm(pat, og, body) -> Arm(pat, og, pbp_pay_all(pbp_body_owed(prc_pat_bindings(pat, []), og, cx), body, cx))
}

# A binder whose single read sits in its own arm's guard reaches the body
# already paid: a bare guard read moved it, a dup'd one left it to the arm drop.
fn pbp_body_owed(names: [Binder], og: Option[Expr], cx: PbpCx) : [Binder] = match og {
  None    -> names
  Some(g) -> filter(names, (nm) => not (pcs_read_once(nm.id, cx.uses) and pbp_reads(nm, g)))
}

# `pcs_mentions` minus the guard-fail drops already planted in the guard.
fn pbp_reads(nm: Binder, e: Expr) : Bool = match e.kind {
  ELocal(u)      -> local_eq(u, nm.id)
  ECall(f, _)    -> not pbp_is_drop(f) and pbp_reads_ps(nm, xp_positions(e))
  _              -> pbp_reads_ps(nm, xp_positions(e))
}

fn pbp_reads_ps(nm: Binder, ps: [XPos]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> pbp_reads(nm, c) or pbp_reads_ps(nm, rest)
}

fn pbp_is_drop(f: Expr) : Bool = match f.kind {
  EMark(m) -> mark_is_drop(m)
  _        -> false
}

fn pbp_pay_all(names: [Binder], scope: Expr, cx: PbpCx) : Expr = match names {
  []            -> scope
  [nm, ...rest] -> pbp_pay_all(rest, pbp_pay(nm, scope, cx), cx)
}

fn pbp_block(ss: [Stmt], ot: Option[Expr], cx: PbpCx) : ExprKind = match ss {
  []           -> EBlock([], ot)
  [s, ...rest] -> match pbp_block(rest, ot, cx) {
    EBlock(rest1, ot1) -> pbp_let(s, rest1, ot1, cx)
    k                  -> k
  }
}

fn pbp_let(s: Stmt, rest: [Stmt], ot: Option[Expr], cx: PbpCx) : ExprKind = match pbp_let_owner(s) {
  None     -> EBlock([s, ...rest], ot)
  Some(nm) -> match pbp_pay(nm, mk_expr(EBlock(rest, ot), 0, 0), cx).kind {
    EBlock(rest1, ot1) -> EBlock([s, ...rest1], ot1)
    _                  -> EBlock([s, ...rest], ot)
  }
}

# A raw `let` carries no rc, so it has no birth reference to release.
fn pbp_let_owner(s: Stmt) : Option[Binder] = match s {
  SLet(pat, _, rhs) -> match pat.pkind {
    PBind(nm) -> if pbp_is_raw(rhs) { None } else { Some(nm) }
    _         -> None
  }
  _ -> None
}

fn pbp_is_raw(e: Expr) : Bool = match e.mode {
  MUnboxed -> true
  _        -> false
}

fn pbp_pay(nm: Binder, scope: Expr, cx: PbpCx) : Expr =
  if pbp_qualifies(nm, cx) { pbl_paid(nm, scope) } else { scope }

fn pbp_qualifies(nm: Binder, cx: PbpCx) : Bool =
  not pcs_has(cx.pnames, nm.id) and
  (pcs_read_once(nm.id, cx.uses) or pcs_has(cx.moved, nm.id))

fn pbp_rekind(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

type PpmCx = { uses: UseIx, skip: [Binder], borrowed: [Binder],
               slots_ok: (Binder, Expr) -> Bool, bpos: (Expr) -> [Int],
               lends_move: (Binder, Expr) -> Bool }

pub(pkg) fn ppm_path_moves(body: Expr, uses: UseIx, skip: [Binder], borrowed: [Binder],
                      slots_ok: (Binder, Expr) -> Bool, bpos: (Expr) -> [Int],
                      lends_move: (Binder, Expr) -> Bool) : [Binder] =
  ppm_expr(body, PpmCx { uses: uses, skip: skip, borrowed: borrowed, slots_ok: slots_ok, bpos: bpos,
                         lends_move: lends_move }, [])

fn ppm_expr(e: Expr, cx: PpmCx, acc: [Binder]) : [Binder] = match e.kind {
  EMatch(s, arms) -> ppm_arms(arms, ppm_scr_owned(s, cx.borrowed), cx, ppm_expr(s, cx, acc))
  _               -> ppm_ps(xp_positions(e), cx, acc)
}

fn ppm_ps(ps: [XPos], cx: PpmCx, acc: [Binder]) : [Binder] = match ps {
  []                  -> acc
  [XP(r, c), ...rest] -> ppm_ps(rest, cx, if xrole_inline(r) { ppm_expr(c, cx, acc) } else { acc })
}

fn ppm_arms(arms: [Arm], owned: Bool, cx: PpmCx, acc: [Binder]) : [Binder] = match arms {
  []                        -> acc
  [Arm(p, og, b), ...rest] -> {
    let acc1 = if owned { ppm_binders(prc_pat_bindings(p, []), og, b, cx, acc) } else { acc }
    let acc2 = match og {
      Some(g) -> ppm_expr(g, cx, acc1)
      None    -> acc1
    }
    ppm_arms(rest, owned, cx, ppm_expr(b, cx, acc2))
  }
}

fn ppm_binders(names: [Binder], og: Option[Expr], b: Expr, cx: PpmCx, acc: [Binder]) : [Binder] = match names {
  []            -> acc
  [nm, ...rest] -> ppm_binders(rest, og, b, cx, if ppm_qualifies(nm, og, b, cx) { [nm, ...acc] } else { acc })
}

fn ppm_qualifies(nm: Binder, og: Option[Expr], b: Expr, cx: PpmCx) : Bool =
  not pcs_has(cx.skip, nm.id) and
  pcs_read_count(nm.id, cx.uses) >= 2 and not pcs_uses_have_in_lam(cx.uses, nm.id) and
  not ppm_guard_mentions(nm, og) and
  ((cx.slots_ok(nm, b) and not ppm_borrowed_read(nm.id, b, cx.bpos) and pbl_plantable(nm, b)) or cx.lends_move(nm, b))

fn ppm_guard_mentions(nm: Binder, og: Option[Expr]) : Bool = match og {
  Some(g) -> pcs_mentions(nm, g)
  None    -> false
}

fn ppm_scr_owned(s: Expr, borrowed: [Binder]) : Bool = match s.kind {
  ELocal(l)   -> not pcs_has(borrowed, l)
  ECall(f, _) -> match f.kind {
    EMark(MkBorrow) -> false
    _               -> true
  }
  _ -> true
}

# A bare read in a borrowed slot hands nothing on: the callee takes no reference.
fn ppm_borrowed_read(nm: LocalId, e: Expr, bpos: (Expr) -> [Int]) : Bool = match e.kind {
  ECall(f, xs) -> ppm_bare_at(nm, xs, bpos(f), 0) or ppm_borrowed_read_ps(nm, xp_positions(e), bpos)
  _            -> ppm_borrowed_read_ps(nm, xp_positions(e), bpos)
}

fn ppm_borrowed_read_ps(nm: LocalId, ps: [XPos], bpos: (Expr) -> [Int]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> ppm_borrowed_read(nm, c, bpos) or ppm_borrowed_read_ps(nm, rest, bpos)
}

fn ppm_bare_at(nm: LocalId, xs: [Expr], positions: [Int], i: Int) : Bool = match xs {
  []           -> false
  [x, ...rest] -> (contains(positions, i) and pcs_is_bare(nm, x)) or ppm_bare_at(nm, rest, positions, i + 1)
}
