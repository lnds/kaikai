# Who releases a binder's birth reference.
#
# Every binding perceus tracks starts out holding one reference: a param
# the caller handed over, a `let` the value its rhs produced, an arm binder
# its bind-time incref. A read either hands that reference on (a bare read
# at the last use) or dups it. Whatever no read hands on is owed, and
# exactly one payer releases it.
#
# `pcs_fate` is the single statement of when a read hands the reference on;
# the dup decision and every drop collector ask it. The `*_payer` functions
# name the one site that pays, and each collector plants a release only
# where it is named, so two collectors can never both decide to pay the
# same binder.
#
# Invariant: pay iff a birth reference exists. A binder that never took one
# (an arm binder elided to `_`, a borrowed or raw param) owes nothing, and
# releasing it would over-free.

import compiler.ast
import compiler.util
import compiler.infer

#[doc("What a binder's reads do with its birth reference: nothing reads it, the last read hands it on, or every read dups and it stays owed.")]
pub type PcsFate = FUnread | FTransfer | FResidual

#[doc("The single site that releases a binder's birth reference.")]
pub type PcsPayer
  = PyNone
  | PyRead
  | PyEntry
  | PyExit
  | PyBranch
  | PyInline

#[doc("The name sets a param's payer depends on: reads that hand the reference on, reads forced to dup, and params paid in the arms that never read them.")]
pub type PcsParamSets = { moved: [String], forced: [String], branch: [String] }

#[doc("Classify a binder's reads from its last-use class. `forced` dups every read; `moved` hands the reference on at the last read whatever the count.")]
pub fn pcs_fate(lu: LU, nm: String, uses: [Use], moved: Bool, forced: Bool) : PcsFate = match lu {
  LUUnused(_)   -> FUnread
  LUBlocked(_)  -> FResidual
  LUAt(_, _, _) ->
    if forced { FResidual }
    else if moved { FTransfer }
    else if pcs_count_non_lam_uses(nm, uses, 0) >= 2 { FResidual }
    else { FTransfer }
}

#[doc("`pcs_fate` of a name over a use table.")]
pub fn pcs_fate_of(nm: String, uses: [Use], moved: Bool, forced: Bool) : PcsFate =
  pcs_fate(last_use_for(nm, uses), nm, uses, moved, forced)

#[doc("True when every read dups and the birth reference stays owed.")]
pub fn pcs_fate_residual(f: PcsFate) : Bool = match f {
  FResidual -> true
  _         -> false
}

#[doc("True when the last read hands the birth reference on.")]
pub fn pcs_fate_transfers(f: PcsFate) : Bool = match f {
  FTransfer -> true
  _         -> false
}

#[doc("True when `nm` is never read in `uses`.")]
pub fn pcs_unread(nm: String, uses: [Use]) : Bool = match last_use_for(nm, uses) {
  LUUnused(_) -> true
  _           -> false
}

#[doc("True when `lu` puts the last read at `(line, col)`.")]
pub fn pcs_lu_at(lu: LU, line: Int, col: Int) : Bool = match lu {
  LUAt(_, ll, lc) -> ll == line and lc == col
  _               -> false
}

fn pcs_payer_tag(p: PcsPayer) : Int = match p {
  PyNone   -> 0
  PyRead   -> 1
  PyEntry  -> 2
  PyExit   -> 3
  PyBranch -> 4
  PyInline -> 5
}

#[doc("True when `p` is the payer `want`.")]
pub fn pcs_pays(p: PcsPayer, want: PcsPayer) : Bool = pcs_payer_tag(p) == pcs_payer_tag(want)

#[doc("The payer of a param's birth reference. A never-read param pays on entry even when the owned-in-scope move selected it.")]
pub fn pcs_param_payer(nm: String, uses: [Use], sets: PcsParamSets) : PcsPayer =
  match pcs_fate_of(nm, uses, list_has(sets.moved, nm), list_has(sets.forced, nm)) {
    FUnread   -> PyEntry
    FResidual -> PyExit
    FTransfer -> if list_has(sets.branch, nm) { PyBranch } else { PyRead }
  }

#[doc("The payer of a block `let`'s birth reference. A never-read `let` is paid inline by the emitter exactly when `pcs_let_paid_inline` holds for its rhs, and at block exit otherwise.")]
pub fn pcs_let_payer(nm: String, rhs: Expr, uses: [Use], moved: Bool, forced: Bool) : PcsPayer =
  match pcs_fate_of(nm, uses, moved, forced) {
    FUnread   -> if pcs_let_paid_inline(rhs) { PyInline } else { PyExit }
    FResidual -> PyExit
    FTransfer -> PyRead
  }

#[doc("The payer of a match-arm binder's bind-time incref, over the arm's own reads. An `_`-named binder takes no incref and owes nothing.")]
pub fn pcs_arm_payer(nm: String, arm_uses: [Use]) : PcsPayer =
  match pcs_fate_of(nm, arm_uses, false, false) {
    FUnread   -> if name_is_unused_binder(nm) { PyNone } else { PyExit }
    FResidual -> PyExit
    FTransfer -> PyRead
  }

#[doc("True when the emitter pays a never-read `let` inline: its rhs is a fresh allocation, rc 1 and aliased by nothing. The emitter and perceus both ask this one predicate, so a never-read `let` has exactly one payer.")]
pub fn pcs_let_paid_inline(rhs: Expr) : Bool = match rhs.kind {
  EInt(_, _)       -> true
  EReal(_, _)      -> true
  EIntLit(_)       -> true
  EDecimalLit(_)   -> true
  EFixed(_, _)     -> true
  EBool(_)         -> true
  EChar(_)         -> true
  EStr(_, _)       -> true
  EUnit            -> true
  ECall(_, _)      -> true
  EList(_)         -> true
  ERecordLit(_, _) -> true
  ERange(_, _, _)  -> true
  ELambda(_, _)    -> true
  EBinop(_, _, _)  -> true
  EUnop(_, _)      -> true
  _                -> false
}

#[doc("The names in `names` whose birth reference `want` pays.")]
pub fn pcs_names_paid_by(names: [String], uses: [Use], sets: PcsParamSets, want: PcsPayer) : [String] = match names {
  []            -> []
  [nm, ...rest] -> {
    let tl = pcs_names_paid_by(rest, uses, sets, want)
    if pcs_pays(pcs_param_payer(nm, uses, sets), want) { [nm, ...tl] } else { tl }
  }
}

#[doc("Drops for the params whose birth reference `want` pays, in declaration order.")]
pub fn pcs_param_drops(params: [Param], uses: [Use], sets: PcsParamSets, want: PcsPayer) : [Stmt] = match params {
  []           -> []
  [p, ...rest] -> {
    let tl = pcs_param_drops(rest, uses, sets, want)
    if pcs_pays(pcs_param_payer(p.pname, uses, sets), want) {
      [pcs_make_drop_stmt(p.pname, p.pline, p.pcol), ...tl]
    } else { tl }
  }
}

#[doc("Wrap a fn body with the drops its params pay on entry and at exit; unchanged when there are none.")]
pub fn pcs_wrap_param_drops(body: Expr, params: [Param], uses: [Use], sets: PcsParamSets) : Expr {
  let entry = pcs_param_drops(params, uses, sets, PyEntry)
  let exit_ = pcs_param_drops(params, uses, sets, PyExit)
  match entry {
    [] -> match exit_ {
      []         -> body
      [_, ...__] -> pcs_wrap_with_exit(body, [], exit_)
    }
    [_, ...__] -> pcs_wrap_with_exit(body, entry, exit_)
  }
}

# `EBlock([entry..., SLet(__pcs_ret, body), exit...], Some(__pcs_ret))`. The
# goto lowering recognises this shape and jumps past the exit drops, so it
# pays the same params per iteration from `pcs_param_payer` itself.
fn pcs_wrap_with_exit(body: Expr, entry: [Stmt], exit_: [Stmt]) : Expr {
  match exit_ {
    [] -> Expr { kind: EBlock(entry, Some(body)), line: body.line, col: body.col,
                 ty: body.ty, mode: body.mode }
    [_, ...__] -> {
      let ret_let = SLet(
        Pattern { pkind: PBind("__pcs_ret"), line: body.line, col: body.col },
        None,
        body
      )
      let stmts = list_append(entry, [ret_let, ...exit_])
      let tail = Expr { kind: EVar("__pcs_ret"), line: body.line, col: body.col,
                        ty: body.ty, mode: body.mode }
      Expr { kind: EBlock(stmts, Some(tail)), line: body.line, col: body.col,
             ty: body.ty, mode: body.mode }
    }
  }
}

#[doc("A `__perceus_drop(nm)` statement.")]
pub fn pcs_make_drop_stmt(nm: String, ln: Int, cl: Int) : Stmt =
  SExprStmt(Expr {
    kind: ECall(
      Expr { kind: EMark(MkDrop), line: ln, col: cl,
             ty: None, mode: MUnknown },
      [Expr { kind: EVar(nm), line: ln, col: cl,
              ty: None, mode: MUnknown }]
    ),
    line: ln, col: cl, ty: None, mode: MUnknown
  })

#[doc("Last-use class of a name over a use table: never read, read inside a lambda (a capture blocks the last-use transfer), or last read at a position.")]
pub fn last_use_for(nm: String, uses: [Use]) : LU =
  last_use_for_loop(nm, uses, false, -1, -1)

fn last_use_for_loop(nm: String, uses: [Use], blocked: Bool,
                     mx_line: Int, mx_col: Int) : LU = match uses {
  []           -> pcs_lu_verdict(nm, blocked, mx_line, mx_col)
  [u, ...rest] -> match u {
    U(un, ln, cl, in_lam) ->
      if un != nm { last_use_for_loop(nm, rest, blocked, mx_line, mx_col) }
      else if in_lam { last_use_for_loop(nm, rest, true, mx_line, mx_col) }
      else if pcs_pos_after(ln, cl, mx_line, mx_col) { last_use_for_loop(nm, rest, blocked, ln, cl) }
      else { last_use_for_loop(nm, rest, blocked, mx_line, mx_col) }
  }
}

fn pcs_lu_verdict(nm: String, blocked: Bool, ln: Int, cl: Int) : LU =
  if blocked { LUBlocked(nm) }
  else if ln < 0 { LUUnused(nm) }
  else { LUAt(nm, ln, cl) }

fn pcs_pos_after(ln: Int, cl: Int, l0: Int, c0: Int) : Bool =
  ln > l0 or (ln == l0 and cl > c0)

#[doc("Count the reads of a name outside lambdas; a lambda read is a capture, paid by the closure's own incref.")]
pub fn pcs_count_non_lam_uses(nm: String, uses: [Use], acc: Int) : Int = match uses {
  []           -> acc
  [u, ...rest] -> pcs_count_non_lam_uses(nm, rest, acc + pcs_plain_read(nm, u))
}

fn pcs_plain_read(nm: String, u: Use) : Int = match u {
  U(un, _, _, in_lam) -> if un == nm and not in_lam { 1 } else { 0 }
}

#[doc("True when some read of `nm` sits inside a lambda.")]
pub fn pcs_uses_have_in_lam(uses: [Use], nm: String) : Bool = match uses {
  []           -> false
  [u, ...rest] -> if pcs_lam_read(nm, u) { true } else { pcs_uses_have_in_lam(rest, nm) }
}

fn pcs_lam_read(nm: String, u: Use) : Bool = match u {
  U(un, _, _, in_lam) -> in_lam and un == nm
}
