#[doc("""
Signature comparison for tail-call fusion.

Fusing a mutually recursive group behind one entry only works when the
members already agree on how they are called, so this module answers
the one question the fusion asks of a candidate group: do these
declarations share a signature?

The comparison is deliberately narrow. It recognises the shapes a
fusable signature is made of — named types, lists of them, and effect
rows — and reports anything else as a mismatch. Being unable to compare
a type therefore keeps a group unfused, which is the safe direction: a
group wrongly judged uniform would be fused behind a calling convention
that does not hold for every member.
""")]

import compiler.ast
import compiler.util

#[doc("True when every declaration in `ds` shares `lead`'s signature: same parameter types and borrow modes, same return type, same effect row, and no type parameters anywhere.")]
pub fn tfsig_members_match(ds: [Decl], lead: Decl) : Bool {
  match ds {
    [] -> tf_sig_is_plain(lead)
    [d, ...rest] ->
      if tf_sig_eq(d, lead) { tfsig_members_match(rest, lead) } else { false }
    _ -> true
  }
}

fn tf_sig_is_plain(d: Decl) : Bool = match d {
  DFn(_, _, tparams, params, opt_ret, _, _, _, _, _) ->
    list_is_empty(tparams) and tf_all_typed(params) and tf_opt_ty_known(opt_ret)
  _ -> false
}

fn tf_all_typed(params: [Param]) : Bool = match params {
  [] -> true
  [p, ...rest] -> if tf_opt_ty_known(p.ptype) { tf_all_typed(rest) } else { false }
  _ -> true
}

fn tf_opt_ty_known(t: Option[TypeExpr]) : Bool = match t {
  None    -> false
  Some(te) -> tf_ty_known(te)
}

fn tf_sig_eq(a: Decl, b: Decl) : Bool = match a {
  DFn(_, _, ta, pa, ra, rowa, _, _, _, _) -> match b {
    DFn(_, _, tb, pb, rb, rowb, _, _, _, _) ->
      list_is_empty(ta) and list_is_empty(tb) and
      tf_params_eq(pa, pb) and tf_opt_ty_eq(ra, rb) and tf_row_eq(rowa, rowb)
    _ -> false
  }
  _ -> false
}

fn tf_params_eq(a: [Param], b: [Param]) : Bool = match a {
  [] -> list_is_empty(b)
  [pa, ...arest] -> match b {
    [] -> false
    [pb, ...brest] ->
      if pa.pborrow == pb.pborrow and tf_opt_ty_eq(pa.ptype, pb.ptype) {
        tf_params_eq(arest, brest)
      } else { false }
    _ -> false
  }
  _ -> false
}

fn tf_opt_ty_eq(a: Option[TypeExpr], b: Option[TypeExpr]) : Bool = match a {
  None -> false
  Some(ta) -> match b {
    None     -> false
    Some(tb) -> tf_ty_eq(ta, tb)
  }
}

# Only the shapes a fusable signature is made of; anything else reports
# unequal so the group stays unfused.
fn tf_ty_eq(a: TypeExpr, b: TypeExpr) : Bool = match a.tkind {
  TyName(na, argsa) -> match b.tkind {
    TyName(nb, argsb) -> na == nb and tf_ty_list_eq(argsa, argsb)
    _                 -> false
  }
  TyList(ea) -> match b.tkind {
    TyList(eb) -> tf_ty_eq(ea, eb)
    _          -> false
  }
  _ -> false
}

fn tf_ty_known(t: TypeExpr) : Bool = match t.tkind {
  TyName(_, targs) -> tf_ty_all_known(targs)
  TyList(e)       -> tf_ty_known(e)
  _               -> false
}

fn tf_ty_all_known(ts: [TypeExpr]) : Bool = match ts {
  [] -> true
  [t, ...rest] -> if tf_ty_known(t) { tf_ty_all_known(rest) } else { false }
  _ -> true
}

fn tf_ty_list_eq(a: [TypeExpr], b: [TypeExpr]) : Bool = match a {
  [] -> list_is_empty(b)
  [ta, ...arest] -> match b {
    [] -> false
    [tb, ...brest] -> if tf_ty_eq(ta, tb) { tf_ty_list_eq(arest, brest) } else { false }
    _ -> false
  }
  _ -> false
}

fn tf_row_eq(a: RowExpr, b: RowExpr) : Bool = match a {
  REmpty -> match b { REmpty -> true  _ -> false }
  RClosed(la) -> match b {
    RClosed(lb) -> tf_labels_eq(la, lb)
    _           -> false
  }
  ROpen(va, la) -> match b {
    ROpen(vb, lb) -> va == vb and tf_labels_eq(la, lb)
    _             -> false
  }
}

fn tf_labels_eq(a: [RowLabel], b: [RowLabel]) : Bool = match a {
  [] -> list_is_empty(b)
  [RL(na, argsa), ...arest] -> match b {
    [] -> false
    [RL(nb, argsb), ...brest] ->
      if na == nb and tf_ty_list_eq(argsa, argsb) { tf_labels_eq(arest, brest) } else { false }
    _ -> false
  }
  _ -> false
}
