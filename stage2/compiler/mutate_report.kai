# compiler/mutate_report.kai — rendering the mutation site list.
#
# `kai mutate` reports SURVIVORS, never a percentage: a survivor is a
# file, a line, an operator and a diff a reader can act on, while a
# score is a number nobody acts on. This module renders the site
# catalogue the driver enumerates; the shell driver owns the run loop
# and the survivor verdict, since only it knows the oracle's exit code.

import compiler.ast
import compiler.util
import compiler.mutate
import compiler.mutate_ops

#[doc("Render one mutation site as a tab-separated record: index, operator, line, column, description.")]
pub fn mut_site_line(idx: Int, file: String, site: MutSite) : String =
  join_with([int_to_string(idx), mut_op_name(ms_op(site)),
             int_to_string(ms_line(site)), int_to_string(ms_col(site)),
             mut_op_blurb(ms_op(site))], "\t")

#[doc("Render the whole site catalogue, one tab-separated record per line.")]
pub fn mut_sites_text(file: String, sites: [MutSite]) : String =
  join_with(mut_numbered(sites, 0, []), "\n")

fn mut_numbered(sites: [MutSite], i: Int, acc: [String]) : [String] {
  match sites {
    [] -> list_reverse(acc)
    [s, ...rest] -> mut_numbered(rest, i + 1, list_append([mut_site_line(i, "", s)], acc))
  }
}

#[doc("Render the site catalogue as a JSON array, matching the `--lint-json` discipline.")]
pub fn mut_sites_json(file: String, sites: [MutSite]) : String =
  concat_all(["[", join_with(mut_json_items(file, sites, 0, []), ", "), "]"])

fn mut_json_items(file: String, sites: [MutSite], i: Int, acc: [String]) : [String] {
  match sites {
    [] -> list_reverse(acc)
    [s, ...rest] ->
      mut_json_items(file, rest, i + 1, list_append([mut_site_json(file, i, s)], acc))
  }
}

fn mut_site_json(file: String, i: Int, s: MutSite) : String =
  concat_all([
    "{\"id\": ", int_to_string(i),
    ", \"file\": ", json_quote(file),
    ", \"line\": ", int_to_string(ms_line(s)),
    ", \"col\": ", int_to_string(ms_col(s)),
    ", \"operator\": ", json_quote(mut_op_name(ms_op(s))),
    ", \"description\": ", json_quote(mut_op_blurb(ms_op(s))),
    "}"
  ])
