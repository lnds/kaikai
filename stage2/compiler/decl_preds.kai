#[doc("""
The refinement predicates a declaration writes outside its bodies' own
expressions: in its signature, and in the types a body annotates.

A predicate is an expression in a type's position, so a walk over
expressions does not meet it; a check that must read every expression
asks for them here.
""")]

import compiler.ast
import compiler.refine_types
import compiler.refine_slots

#[doc("The predicates of the types the signature of `d` writes: parameters and result, a const's annotation, a type's body, an effect's operations, and the same of an impl's methods.")]
pub fn decl_preds(d: Decl) : [Expr] = tys_preds(sig_types(d))

#[doc("The predicates of the types `e` itself annotates: a lambda's parameters, a block's `let`s, a handler's type arguments.")]
pub fn expr_preds(e: Expr) : [Expr] = match e.kind {
  ELambda(ps, _)                -> tys_preds(params_types(ps))
  EBlock(stmts, _)              -> tys_preds(stmts_types(stmts))
  EHandle(_, _, ta, _, _, _, _) -> tys_preds(ta)
  _                             -> []
}

fn sig_types(d: Decl) : [TypeExpr] = match decl_transparent_inner(d) {
  Some(inner) -> sig_types(inner)
  None        -> match d {
    DFn(_, _, _, ps, ret, _, _, _, _, _) -> list_append(params_types(ps), opt_types(ret))
    DCheck(_, ps, _, _, _, _)            -> params_types(ps)
    DConst(_, _, ta, _, _, _, _)         -> [ta]
    DType(_, _, _, body, _, _, _, _)     -> body_types(body)
    DEffect(_, _, _, ops, _, _, _, _)    -> flat_map(ops, op_types)
    DImpl(_, _, _, subs, _, _, _, _)     -> flat_map(subs, sig_types)
    _                                    -> []
  }
}

fn op_types(op: EffectOp) : [TypeExpr] = match op {
  EffOp(_, _, ps, ret, _, _) -> [ret, ...params_types(ps)]
}

fn opt_types(o: Option[TypeExpr]) : [TypeExpr] = match o {
  Some(t) -> [t]
  None    -> []
}

# Most blocks annotate nothing: no list is built for those.
fn stmts_types(ss: [Stmt]) : [TypeExpr] = match ss {
  []           -> []
  [s, ...rest] -> match s {
    SLet(_, Some(t), _) -> [t, ...stmts_types(rest)]
    _                   -> stmts_types(rest)
  }
}
