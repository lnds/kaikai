#[doc("""
The `#[derive(Layout)]` and JSON derive checks: which field and payload
types each one accepts.
""")]

import compiler.ast
import compiler.written
import compiler.symtab
import compiler.core_protos
import compiler.diag_file
import compiler.diag
import compiler.util
import compiler.proto_resolve
import compiler.layout_validate
import compiler.json_shape
import compiler.derive_pick
import compiler.protos_derive_check
import compiler.protos_heads

#[doc("""
Pre-expansion validator for `#[derive(Layout)]`. `derive_layout_impl`
returns no decls when the record is not Layout-bearing, so without this
pass the omission surfaces only as a missing `to_bytes` at the first
call site. Walks the original decl stream and reports each offending
field with the remedy that applies to it.
""")]
pub fn validate_derive_layout(ps: PScope, decls: [Decl], df: DiagFiles) : [Diagnostic] / Console =
  list_reverse(validate_derive_layout_loop(ps, decls, df, []))

fn validate_derive_layout_loop(ps: PScope, decls: [Decl], df: DiagFiles,
                                 errs: [Diagnostic]) : [Diagnostic] / Console {
  match decls {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, _, body, line, col, _, _) ->
          if derives_core(ps, names, derive_from(ps, inner), CpLayout) {
            let file = decl_diag_file(d, df)
            let errs1 = validate_derive_layout_body(ps_tab(ps), file, vdv_type_name(ps, tsym), body,
                                                     line, col, errs)
            validate_derive_layout_loop(ps, rest, df, errs1)
          } else {
            validate_derive_layout_loop(ps, rest, df, errs)
          }
        _ -> validate_derive_layout_loop(ps, rest, df, errs)
      }
      DUnstable(inner, _, _) ->
        validate_derive_layout_loop(ps, [inner, ...rest], df, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derive_layout_loop(ps, [inner, ...rest], df, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derive_layout_loop(ps, [inner, ...rest], df, errs)
      DConstructor(inner, _, _) ->
        validate_derive_layout_loop(ps, [inner, ...rest], df, errs)
      _ -> validate_derive_layout_loop(ps, rest, df, errs)
    }
  }
}

fn validate_derive_layout_body(tab: SymTab, file: String, tname: String, body: TypeBody,
                                 line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match body {
    TBRecord(fields) -> match fields {
      [] -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Layout)]` for `", tname,
          "`: a Layout record needs at least one field"]))
        [derr, ...errs]
      }
      _ -> validate_derive_layout_fields(tab, file, tname, fields, line, col, errs)
    }
    _ -> {
      let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Layout)]` for `", tname,
        "`: Layout applies to records, not sum types"]))
      [derr, ...errs]
    }
  }
}

fn validate_derive_layout_fields(tab: SymTab, file: String, tname: String,
                                   fields: [FieldDecl], line: Int, col: Int,
                                   errs: [Diagnostic]) : [Diagnostic] / Console {
  match fields {
    [] -> errs
    [fd, ...rest] -> {
      let errs1 = validate_derive_layout_one(tab, file, tname, fd, line, col, errs)
      validate_derive_layout_fields(tab, file, tname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_layout_one(tab: SymTab, file: String, tname: String, fd: FieldDecl,
                                line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  let rej = layout_reject_of(tab, fd)
  if layout_reject_is_err(rej) {
    match fd {
      FD(_, fname, ftype, _) -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Layout)]` for `", tname,
          "`: field `", fname, "` of type `", layout_head_name(tab, ftype),
          "` is not Layout-bearing: ", layout_reject_why(rej)]))
        [derr, ...errs]
      }
    }
  } else { errs }
}

#[doc("""
Pre-expansion validator for `#[derive(Json)]`. Same shape as the
Layout one: `derive_json_impl` returns no decls when a field has no
JSON denotation, so without this pass the omission surfaces only as a
missing `to_json` at the first call site.
""")]
pub fn validate_derive_json(ps: PScope, decls: [Decl], df: DiagFiles) : [Diagnostic] / Console =
  list_reverse(validate_derive_json_loop(ps, decls, df, []))

fn validate_derive_json_loop(ps: PScope, decls: [Decl], df: DiagFiles,
                              errs: [Diagnostic]) : [Diagnostic] / Console {
  match decls {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, tps, body, line, col, _, _) ->
          if derives_core(ps, names, derive_from(ps, inner), CpJson) {
            let file = decl_diag_file(d, df)
            let settled = heads_body(HeadScope(ps, derive_from(ps, inner)), body)
            let errs1 = validate_derive_json_body(ps_tab(ps), file, vdv_type_name(ps, tsym), settled, line, col, errs)
            validate_derive_json_loop(ps, rest, df, errs1)
          } else {
            validate_derive_json_loop(ps, rest, df, errs)
          }
        _ -> validate_derive_json_loop(ps, rest, df, errs)
      }
      DUnstable(inner, _, _) ->
        validate_derive_json_loop(ps, [inner, ...rest], df, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derive_json_loop(ps, [inner, ...rest], df, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derive_json_loop(ps, [inner, ...rest], df, errs)
      DConstructor(inner, _, _) ->
        validate_derive_json_loop(ps, [inner, ...rest], df, errs)
      _ -> validate_derive_json_loop(ps, rest, df, errs)
    }
  }
}

fn validate_derive_json_body(tab: SymTab, file: String, tname: String, body: TypeBody,
                              line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match body {
    TBRecord(fields) -> match fields {
      [] -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
          "`: a Json record needs at least one field"]))
        [derr, ...errs]
      }
      _ -> validate_derive_json_fields(tab, file, tname, fields, line, col, errs)
    }
    TBSum(variants) -> match variants {
      [] -> {
        let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
          "`: a Json sum needs at least one variant"]))
        [derr, ...errs]
      }
      _ -> validate_derive_json_variants(tab, file, tname, variants, line, col, errs)
    }
    _ -> {
      let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
        "`: Json applies to records and sum types, not type aliases"]))
      [derr, ...errs]
    }
  }
}

# Each variant payload must be JSON-bindable. The adjacently-tagged
# envelope encodes the payload under `value`, so an unbindable payload
# type is reported the same way an unbindable record field is.
fn validate_derive_json_variants(tab: SymTab, file: String, tname: String, variants: [Variant],
                                  line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match variants {
    [] -> errs
    [v, ...rest] -> {
      let errs1 = validate_derive_json_variant(tab, file, tname, v, line, col, errs)
      validate_derive_json_variants(tab, file, tname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_json_variant(tab: SymTab, file: String, tname: String, v: Variant,
                                 line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match v {
    Var(vsym, vargs) ->
      validate_derive_json_payload(tab, file, tname, written_text(sym_name(tab, vsym)), vargs, line, col, errs)
  }
}

fn validate_derive_json_payload(tab: SymTab, file: String, tname: String, vname: String,
                                 vargs: [TypeExpr], line: Int, col: Int,
                                 errs: [Diagnostic]) : [Diagnostic] / Console {
  match vargs {
    [] -> errs
    [t, ...rest] -> {
      let errs1 = match json_field_reject(tab, t) {
        None -> errs
        Some(why) -> {
          let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
            "`: variant `", vname, "` payload of type `", json_head_name(tab, t),
            "` is not JSON-bindable: ", why]))
          [derr, ...errs]
        }
      }
      validate_derive_json_payload(tab, file, tname, vname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_json_fields(tab: SymTab, file: String, tname: String, fields: [FieldDecl],
                                line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match fields {
    [] -> errs
    [fd, ...rest] -> {
      let errs1 = validate_derive_json_one(tab, file, tname, fd, line, col, errs)
      validate_derive_json_fields(tab, file, tname, rest, line, col, errs1)
    }
  }
}

fn validate_derive_json_one(tab: SymTab, file: String, tname: String, fd: FieldDecl,
                             line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  match fd {
    FD(_, fname, ftype, attrs) ->
      # A `#[json(skip)]` field never touches the wire, so its type need
      # not be JSON-bindable — but decode must be able to reconstruct it,
      # which requires a `#[json(default)]` or an `Option` type.
      if field_attr_json_skip(attrs) {
        let has_default = match field_attr_json_default(attrs) { Some(_) -> true None -> false }
        if has_default or json_head_is_option(ftype) { errs }
        else {
          let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
            "`: field `", fname, "` carries `#[json(skip)]` but has no `#[json(default)]` and is not `Option` — decode cannot reconstruct a skipped field"]))
          [derr, ...errs]
        }
      } else { match json_field_reject(tab, ftype) {
        None -> errs
        Some(why) -> {
          let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Json)]` for `", tname,
            "`: field `", fname, "` of type `", json_head_name(tab, ftype),
            "` is not JSON-bindable: ", why]))
          [derr, ...errs]
        }
      } }
  }
}
