# compiler/mutate_ops.kai — the mutation operators.
#
# Each operator names a class of defect the corpus is being asked
# about. They are ordered by diagnostic value, not by ease:
#
#   arm deletion       a `match` that stops handling a case. This is
#                      the shape of an encoder emitting a tag its
#                      decoder never learned to read — silent, because
#                      a miss is indistinguishable from a cold start.
#                      A compiler is mostly `match`, so it comes first.
#   comparison boundary  `>=` -> `>`: the off-by-one in a gate.
#   boolean connective   `and` -> `or`: a gate that never fires, or
#                        always does.
#   condition negation   `if c` -> `if not c`: an inverted guard.
#   literal perturbation `0` -> `1`: seeds and base cases.
#   call elision         `f(x)` -> `x`: a pass that silently does
#                        nothing.
#
# An operator only ever proposes a REPLACEMENT SPAN. It never rewrites
# the AST it walked: the AST locates the site, the source keeps its own
# formatting, and the mutant differs by the mutation alone.

#[doc("The class of defect a mutation site simulates.")]
pub type MutOp
  = MOpArm        # drop a `match` arm
  | MOpCompare    # shift a comparison boundary
  | MOpConnect    # swap a boolean connective
  | MOpNegate     # invert a condition
  | MOpLiteral    # perturb a literal
  | MOpCall       # elide a call, keeping its first argument

#[doc("Stable short name of an operator, used in reports and in the known-equivalent file's key.")]
pub fn mut_op_name(o: MutOp) : String = match o {
  MOpArm     -> "arm"
  MOpCompare -> "compare"
  MOpConnect -> "connect"
  MOpNegate  -> "negate"
  MOpLiteral -> "literal"
  MOpCall    -> "call"
}

#[doc("One-line description of what an operator breaks, shown by `kai mutate --list`.")]
pub fn mut_op_blurb(o: MutOp) : String = match o {
  MOpArm     -> "drop a match arm"
  MOpCompare -> "shift a comparison boundary"
  MOpConnect -> "swap a boolean connective"
  MOpNegate  -> "invert a condition"
  MOpLiteral -> "perturb a literal"
  MOpCall    -> "elide a call"
}

#[doc("Parse an operator's short name. None for a name no operator carries.")]
pub fn mut_op_of_name(n: String) : Option[MutOp] = {
  if n == "arm" { Some(MOpArm) }
  else if n == "compare" { Some(MOpCompare) }
  else if n == "connect" { Some(MOpConnect) }
  else if n == "negate" { Some(MOpNegate) }
  else if n == "literal" { Some(MOpLiteral) }
  else if n == "call" { Some(MOpCall) }
  else { None }
}

#[doc("Every operator, in the order `kai mutate` applies them.")]
pub fn mut_all_ops() : [MutOp] =
  [MOpArm, MOpCompare, MOpConnect, MOpNegate, MOpLiteral, MOpCall]

# --- per-operator replacement rules -----------------------------------

# A comparison boundary moves by one: the mutant accepts (or rejects)
# exactly the edge case. `==`/`!=` have no boundary to shift, so they
# are left to the connective and negation operators instead.
#[doc("The boundary-shifted form of a comparison operator, or None when the operator has no boundary.")]
pub fn mut_compare_swap(op: String) : Option[String] = {
  if op == ">=" { Some(">") }
  else if op == "<=" { Some("<") }
  else if op == ">" { Some(">=") }
  else if op == "<" { Some("<=") }
  else { None }
}

#[doc("The opposite boolean connective, or None for an operator that is not one.")]
pub fn mut_connect_swap(op: String) : Option[String] = {
  if op == "and" { Some("or") }
  else if op == "or" { Some("and") }
  else { None }
}

# A perturbed literal must stay the same TYPE, or the mutant fails to
# compile for a reason that has nothing to do with the corpus. `0`/`1`
# swap so both the zero seed and the unit step get probed.
#[doc("The perturbed form of an integer literal's source text.")]
pub fn mut_int_perturb(raw: String) : String =
  if raw == "0" { "1" } else { "0" }

#[doc("The perturbed form of a boolean literal.")]
pub fn mut_bool_perturb(b: Bool) : String = if b { "false" } else { "true" }
