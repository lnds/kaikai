# compiler/import_unit.kai — which unused imports the unit can drop.
#
# Files merge into one unit, so an import also brings its module's names
# to every other file. An import its own file never mentions can go only
# when its module still enters the unit another way, or nothing left in
# the unit needs it — known only once the whole import graph is loaded,
# so the verdict waits for the end of resolution. Dropping every import
# reported as unused, all at once, loses no module the rest still needs.

import compiler.util
import compiler.diag
import compiler.lex
import compiler.ast_decl
import compiler.modules_paths
import compiler.module_table
import compiler.import_uses
import compiler.infer_index
import compiler.diag_file
import compiler.derive_reach

#[doc("What the import check gathers while the unit loads: each loaded module's names and each scanned file, newest first.")]
pub type ImportLedger = { names: [ModNames], names_ix: ModNamesIndex, rev_files: [FileImports] }

#[doc("A ledger that knows only `names`, those of the auto-loaded modules.")]
pub fn ledger_new(names: [ModNames]) : ImportLedger = ImportLedger { names: names, names_ix: mod_names_index(names), rev_files: [] }

#[doc("Record what the module loaded from `origin` can be referred to by.")]
pub fn ledger_note_names(l: ImportLedger, origin: String, exports: [String], decls: [Decl]) : ImportLedger = {
  let mn = mod_names(origin, exports, decls)
  ImportLedger { names: [mn, ...l.names], names_ix: mod_names_add(l.names_ix, mn), rev_files: l.rev_files }
}

#[doc("Scan the imports of the file at `origin`, reported as `path`, once its own imports have loaded; `bindings` are the entries it wrote.")]
pub fn ledger_scan(l: ImportLedger, origin: String, path: String, src: String, tokens: [Token],
                   decls: [Decl], bindings: [ModuleEntry]) : ImportLedger =
  ImportLedger { ...l, rev_files: [file_imports(origin, path, src, tokens, decls, bindings, l.names_ix), ...l.rev_files] }

#[doc("Count what each derived declaration of `minted` refers to as a mention in the file it is homed in. A derive's expansion is source the scan never read.")]
pub fn ledger_note_derived(l: ImportLedger, minted: [Decl], df: DiagFiles) : ImportLedger =
  if any_unused(l.rev_files) {
    ImportLedger { ...l, rev_files: map(l.rev_files, (f) => file_note_derived(f, minted, df)) }
  } else { l }

fn file_note_derived(f: FileImports, minted: [Decl], df: DiagFiles) : FileImports =
  if list_length(f.unused) == 0 { f }
  else { file_also_mentions(f, flat_map(filter(minted, (d) => decl_diag_file(d, df) == f.path), (d) => derive_mentions(d))) }

#[doc("Warn about every import of the unit rooted at `root` that its file never mentions: as unused when the unit loses nothing without it, else naming the file that needs what it loads.")]
pub fn report_imports(l: ImportLedger, root: String) : [Diagnostic] / Console + File = {
  let files = list_reverse(l.rev_files)
  if any_unused(files) { map(verdicts(files, keep_set(files, root, l.names_ix), []), report_verdict) } else { [] }
}

# A load-bearing unused import: its file's origin, its written name, the
# module it loads, the lost module it keeps in the unit, and the file that
# needs that one ("" when loading it is the use).
type Keep = Kp(String, String, String, String, String)

# A lost module the unit still needs, and the file that needs it.
type Need = Nd(String, String)

# A file and the lost modules it mentions.
type Scanned = Sc(FileImports, [String])

type Verdict = Unused(String, UnusedImport) | Misplaced(String, UnusedImport, String, String)

fn any_unused(fs: [FileImports]) : Bool = match fs {
  []           -> false
  [f, ...rest] -> list_length(f.unused) > 0 or any_unused(rest)
}

# A set of origins, and the files by origin.
type Origins = NameIndex[String]
type FileIx = NameIndex[FileImports]

fn og_has(set: Origins, o: String) : Bool = list_has(idx_chain(set, o), o)

fn og_add(set: Origins, o: String) : Origins = idx_prepend(set, o, o)

fn file_index(files: [FileImports]) : FileIx = fx_fill(list_reverse(files), idx_empty())

fn fx_fill(files: [FileImports], ix: FileIx) : FileIx = match files {
  []           -> ix
  [f, ...rest] -> fx_fill(rest, idx_prepend(ix, f.origin, f))
}

# The unused imports the unit cannot lose. Without them the unit is what
# the used imports reach from the root; a module left out that something
# still inside mentions, or that is used by being loaded, pulls back the
# unused imports leading to it, until nothing needed is left out.
fn keep_set(files: [FileImports], root: String, table: ModNamesIndex) : [Keep] = {
  let fx = file_index(files)
  match lost_names(files, reach(fx, [], [root], idx_empty(), false), table, []) {
    []   -> []
    lost -> settle(files, fx, root, lost, scan_all(files, mention_scan(lost), []), [])
  }
}

fn settle(files: [FileImports], fx: FileIx, root: String, lost: [ModNames], scans: [Scanned], keep: [Keep]) : [Keep] = {
  let r = reach(fx, keep, [root], idx_empty(), false)
  match needs(lost, scans, r, []) {
    [] -> keep
    ns -> match keeps_for(fx, files, r, ns, []) {
      []  -> keep
      add -> settle(files, fx, root, lost, scans, list_append(keep, add))
    }
  }
}

fn lost_names(files: [FileImports], r: Origins, table: ModNamesIndex, acc: [ModNames]) : [ModNames] = match files {
  [] -> acc
  [f, ...rest] ->
    if og_has(r, f.origin) { lost_names(rest, r, table, acc) }
    else { match mod_names_find(table, f.origin) {
      Some(mn) -> lost_names(rest, r, table, [mn, ...acc])
      None     -> lost_names(rest, r, table, acc)
    } }
}

fn scan_all(files: [FileImports], ms: MentionScan, acc: [Scanned]) : [Scanned] = match files {
  []           -> list_reverse(acc)
  [f, ...rest] -> scan_all(rest, ms, [Sc(f, file_mentions(f, ms)), ...acc])
}

fn needs(lost: [ModNames], scans: [Scanned], r: Origins, acc: [Need]) : [Need] = match lost {
  [] -> acc
  [MNames(o, _, silent), ...rest] ->
    if og_has(r, o) { needs(rest, scans, r, acc) }
    else if silent { needs(rest, scans, r, [Nd(o, ""), ...acc]) }
    else { match consumer(scans, r, o) {
      Some(path) -> needs(rest, scans, r, [Nd(o, path), ...acc])
      None       -> needs(rest, scans, r, acc)
    } }
}

fn consumer(scans: [Scanned], r: Origins, o: String) : Option[String] = match scans {
  [] -> None
  [Sc(f, hits), ...rest] ->
    if og_has(r, f.origin) and list_has(hits, o) { Some(f.path) } else { consumer(rest, r, o) }
}

# Every unused import leaving `r` whose module leads to a needed one.
fn keeps_for(fx: FileIx, files: [FileImports], r: Origins, ns: [Need], acc: [Keep]) : [Keep] = match files {
  [] -> acc
  [f, ...rest] ->
    if og_has(r, f.origin) { keeps_for(fx, rest, r, ns, file_keeps(fx, f.origin, f.unused, r, ns, acc)) }
    else { keeps_for(fx, rest, r, ns, acc) }
}

fn file_keeps(fx: FileIx, file: String, us: [UnusedImport], r: Origins, ns: [Need], acc: [Keep]) : [Keep] =
  match us {
    [] -> acc
    [UImp(w, o, _, _), ...rest] ->
      if og_has(r, o) { file_keeps(fx, file, rest, r, ns, acc) }
      else { match need_via(fx, ns, o) {
        Some(Nd(x, c)) -> file_keeps(fx, file, rest, r, ns, [Kp(file, w, o, x, c), ...acc])
        None           -> file_keeps(fx, file, rest, r, ns, acc)
      } }
  }

# The need an import of `o` answers: `o`'s own when it has one, else the
# first need among the modules `o` leads to.
fn need_via(fx: FileIx, ns: [Need], o: String) : Option[Need] = match need_below(ns, og_add(idx_empty(), o)) {
  Some(n) -> Some(n)
  None    -> need_below(ns, reach(fx, [], [o], idx_empty(), true))
}

fn need_below(ns: [Need], below: Origins) : Option[Need] = match ns {
  [] -> None
  [Nd(x, c), ...rest] -> if og_has(below, x) { Some(Nd(x, c)) } else { need_below(rest, below) }
}

# The origins reachable from `todo` through used imports and `keep`, or
# through every import when `all`.
fn reach(fx: FileIx, keep: [Keep], todo: [String], seen: Origins, all: Bool) : Origins = match todo {
  [] -> seen
  [o, ...rest] ->
    if og_has(seen, o) { reach(fx, keep, rest, seen, all) }
    else { reach(fx, keep, list_append(out_edges(fx, keep, o, all), rest), og_add(seen, o), all) }
}

fn out_edges(fx: FileIx, keep: [Keep], o: String, all: Bool) : [String] = match find_file(fx, o) {
  None    -> []
  Some(f) -> list_append(f.edges, if all { unused_origins(f.unused, []) } else { kept_from(keep, o, []) })
}

fn find_file(fx: FileIx, o: String) : Option[FileImports] = ff_pick(idx_chain(fx, o), o)

fn ff_pick(xs: [FileImports], o: String) : Option[FileImports] = match xs {
  []           -> None
  [f, ...rest] -> if f.origin == o { Some(f) } else { ff_pick(rest, o) }
}

fn unused_origins(us: [UnusedImport], acc: [String]) : [String] = match us {
  []                          -> acc
  [UImp(_, o, _, _), ...rest] -> unused_origins(rest, [o, ...acc])
}

fn kept_from(keep: [Keep], file: String, acc: [String]) : [String] = match keep {
  [] -> acc
  [Kp(f, _, o, _, _), ...rest] -> if f == file { kept_from(rest, file, [o, ...acc]) } else { kept_from(rest, file, acc) }
}

fn verdicts(files: [FileImports], keep: [Keep], acc: [Verdict]) : [Verdict] = match files {
  []           -> list_reverse(acc)
  [f, ...rest] -> verdicts(rest, keep, file_verdicts(f, f.unused, keep, acc))
}

fn file_verdicts(f: FileImports, us: [UnusedImport], keep: [Keep], acc: [Verdict]) : [Verdict] = match us {
  []           -> acc
  [u, ...rest] -> file_verdicts(f, rest, keep, match find_keep(keep, f.origin, u) {
    None                    -> [Unused(f.path, u), ...acc]
    Some(Kp(_, _, _, x, c)) -> if c == "" { acc } else { [Misplaced(f.path, u, x, c), ...acc] }
  })
}

fn find_keep(keep: [Keep], file: String, u: UnusedImport) : Option[Keep] = match keep {
  [] -> None
  [Kp(f, w, o, x, c), ...rest] ->
    if f == file and w == imp_written(u) { Some(Kp(f, w, o, x, c)) } else { find_keep(rest, file, u) }
}

fn imp_written(u: UnusedImport) : String = match u { UImp(w, _, _, _) -> w }

fn report_verdict(v: Verdict) : Diagnostic / Console + File = {
  let d = match v {
    Unused(path, UImp(w, _, l, c)) -> mk_diag(SevWarning, path, l, c, "unused import `#{w}`", [])
    Misplaced(path, UImp(w, o, l, c), x, user) ->
      mk_diag(SevWarning, path, l, c, misplaced_message(w, o, x, file_base(user)),
              [ri_help(path, l, c, "import `#{module_stem(x)}` in `#{file_base(user)}`, the file that uses it")])
  }
  render_diag(d)
  d
}

fn misplaced_message(w: String, o: String, x: String, user: String) : String =
  if o == x { "import `#{w}` is not used in this file, but `#{user}` needs it loaded" }
  else { "import `#{w}` is not used in this file, but it brings in `#{module_stem(x)}`, which `#{user}` needs" }

fn file_base(path: String) : String =
  string_slice(path, last_slash(path, string_length(path) - 1) + 1, string_length(path))

fn module_stem(path: String) : String = {
  let base = file_base(path)
  let n = string_length(base)
  if n > 4 and string_slice(base, n - 4, n) == ".kai" { string_slice(base, 0, n - 4) } else { base }
}
