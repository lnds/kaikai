#[doc("""
Spawn-boundary capture check.

Fibers have private heaps: a value a thunk captures is copied into the
child, so a mutation the child performs lands on the copy and the
parent never sees it. Where the row check rejects an effect the child
cannot resolve, this rejects a VALUE whose mutation the child cannot
share — the same boundary, read on the other side.

What counts as a carrier is `mutation_carriers`, not a list spelled
here: any record reaching an `Array`/`Ref` through its fields is
classified without touching this module.

Only a FREE name is a capture. A carrier built inside the thunk, and a
plain value read before the spawn, both stay legal — they are what
keeps the check from rejecting correct code.
""")]

import compiler.ast
import compiler.written
import compiler.symtab
import compiler.decl_text
import compiler.local_names
import compiler.handler_alias
import compiler.closure_spec_ast
import compiler.diag
import compiler.mutation_carriers
import compiler.util
import compiler.core_effects
import compiler.core_builtins
import compiler.core_fns

#[doc("Where a spawn sits: the file a diagnostic names, the table that names a declaration, and the declaration whose binders its thunk can capture.")]
pub type SpawnSite = { file: String, tab: SymTab, owner: Decl }

#[doc("Reject a spawned thunk capturing a value of one of the types `carriers` (`mutating_record_type_names`) from the enclosing fiber. Returns the diagnostics it rendered.")]
pub fn check_thunk_captures(site: SpawnSite, carriers: [SymId],
                            thunk: Expr) : [Diagnostic] / Console + File {
  match thunk.kind {
    ELambda(ps, body) -> {
      let bound = param_ids(ps, [])
      map(free_carriers(body, bound, carriers, []), (c) => report_capture(site, c))
    }
    _ -> []
  }
}


fn param_ids(ps: [Param], acc: [LocalId]) : [LocalId] = match ps {
  []           -> acc
  [p, ...rest] -> param_ids(rest, [p.binder.id, ...acc])
}


# What a thunk holds from outside itself: a binder of the enclosing
# fiber, or a declaration.
type Held = HeldLocal(LocalId) | HeldDecl(SymId)

fn held_same(a: Held, b: Held) : Bool = match a {
  HeldLocal(x) -> match b { HeldLocal(y) -> local_eq(x, y)  HeldDecl(_) -> false }
  HeldDecl(x)  -> match b { HeldDecl(y) -> sym_raw(x) == sym_raw(y)  HeldLocal(_) -> false }
}

# The enclosing declaration's binders, and the handler-state aliases no
# node declares.
fn held_name(site: SpawnSite, h: Held) : Written = match h {
  HeldDecl(s)  -> decl_name(site.tab, s)
  HeldLocal(l) -> ln_text(foldl(user_state_aliases(), ln_of_decl(site.owner),
                                (ns, k) => ln_with_binder(ns, binder_minted(k))), l)
}

# A capture: what is held, its type for the diagnostic, and where it
# is read. The first read is the one reported.
type Carried = Cap(Held, Ty, Int, Int)


# The row check's help ("handle it inside") is wrong here: when the
# point IS to share, moving the state inside gives each child its own
# copy. Actors are the supported route.
fn report_capture(site: SpawnSite, c: Carried) : Diagnostic / Console + File = match c {
  Cap(held, ty, line, col) -> {
    let file = site.file
    let d = mk_diag(SevError, file, line, col,
                    concat_all(["a spawned fiber cannot capture `", carrier_display(site.tab, ty), "`"]),
                    [ri_note(file, line, col, concat_all(["`", written_text(held_name(site, held)), "` is owned by the parent fiber"])),
                     ri_note(file, line, col, "fibers have private heaps; the child would mutate a copy"),
                     ri_help(file, line, col, "let one fiber own the state and message it (`kai info actors`)")])
    render_diag(d)
    d
  }
}


# Free reads of carrier type, in source order, one entry per binder or
# declaration.
fn free_carriers(e: Expr, bound: [LocalId], dmut: [SymId],
                 acc: [Carried]) : [Carried] {
  match e.kind {
    ELocal(l)  -> add_carrier(e, HeldLocal(l), bound, dmut, acc)
    ESym(s, _) -> add_carrier(e, HeldDecl(s), bound, dmut, acc)
    ELambda(ps, body) ->
      free_carriers(body, param_ids(ps, bound), dmut, acc)
    EBlock(stmts, tail) -> {
      let st = free_in_stmts(stmts, bound, dmut, acc)
      match st {
        Scan(bound1, acc1) -> match tail {
          Some(t) -> free_carriers(t, bound1, dmut, acc1)
          None    -> acc1
        }
      }
    }
    EMatch(scr, arms) -> {
      let a1 = free_carriers(scr, bound, dmut, acc)
      free_in_arms(arms, bound, dmut, a1)
    }
    # A nested spawn runs its own capture check, and its thunk's frame
    # of reference is that inner child, not this one. Descending would
    # report the same name once per enclosing spawn.
    ECall(callee, args_) ->
      if callee_is_spawn(callee) { acc }
      else { free_in_list([callee, ...args_], bound, dmut, acc) }
    _ -> free_in_list(capture_kids(e), bound, dmut, acc)
  }
}


#[doc("True iff `callee` hands a thunk to a fresh fiber: a function that starts one, the actor surface's runtime entry, or the `spawn` operation of `Spawn`.")]
pub fn callee_is_spawn(callee: Expr) : Bool = match callee.kind {
  ESym(s, _) -> sym_is_spawn_boundary(s)
  # The op both `n.spawn` (rewritten by the nursery cap pass) and the free
  # `spawn` wrapper reach.
  EOp(r)     -> effect_is(r.eff, CeSpawn) and written_text(r.op) == "spawn"
  _          -> false
}

# `spawn_actor_fiber` is the actor surface's own runtime entry, which
# does not route through the op.
fn sym_is_spawn_boundary(s: SymId) : Bool = match known_fn_of(s) {
  Some(f) -> known_fn_starts_fiber(f)
  None    -> match builtin_of(s) {
    Some(CbSpawnActorFiber) -> true
    _                       -> false
  }
}


fn add_carrier(e: Expr, h: Held, bound: [LocalId], dmut: [SymId],
               acc: [Carried]) : [Carried] {
  if held_bound(h, bound) { acc }
  else if has_capture(acc, h) { acc }
  else { match e.ty {
    Some(t) -> if ty_carries_mutation(t, dmut) {
                 [Cap(h, t, e.line, e.col), ...acc]
               } else { acc }
    None    -> acc
  } }
}


fn held_bound(h: Held, bound: [LocalId]) : Bool = match h {
  HeldLocal(l) -> any(bound, (b) => local_eq(b, l))
  HeldDecl(_)  -> false
}


fn has_capture(cs: [Carried], h: Held) : Bool = match cs {
  []           -> false
  [c, ...rest] -> match c {
    Cap(held, _, _, _) -> if held_same(held, h) { true } else { has_capture(rest, h) }
  }
}


# Carrier types only, so the head plus its arguments is the whole
# rendering; anything else is not reported and never reaches here.
fn carrier_display(tab: SymTab, t: Ty) : String = match t {
  TyCon(s, targs) -> carrier_head(tab, s, targs)
  _ -> "a mutable value"
}


fn carrier_head(tab: SymTab, s: SymId, targs: [Ty]) : String = match targs {
  [] -> written_text(decl_name(tab, s))
  _  -> concat_all([written_text(decl_name(tab, s)), "[", join_with(display_args(tab, targs), ", "), "]"])
}


fn display_args(tab: SymTab, ts: [Ty]) : [String] = match ts {
  []           -> []
  [t, ...rest] -> [carrier_display_arg(tab, t), ...display_args(tab, rest)]
}


fn carrier_display_arg(tab: SymTab, t: Ty) : String = match t {
  TyInt    -> "Int"
  TyReal   -> "Real"
  TyBool   -> "Bool"
  TyString -> "String"
  TyChar   -> "Char"
  TyUnit   -> "Unit"
  TyListT(inner) -> concat_all(["[", carrier_display_arg(tab, inner), "]"])
  TyCon(s, targs) -> carrier_head(tab, s, targs)
  _ -> "_"
}


# A block binds as it goes: a name bound by an earlier `let` is not
# free in the statements that follow it.
type ScanState = Scan([LocalId], [Carried])


fn free_in_stmts(ss: [Stmt], bound: [LocalId], dmut: [SymId],
                 acc: [Carried]) : ScanState {
  match ss {
    []           -> Scan(bound, acc)
    [s, ...rest] -> match stmt_scan(s, bound, dmut, acc) {
      Scan(bound1, acc1) -> free_in_stmts(rest, bound1, dmut, acc1)
    }
  }
}


fn stmt_scan(s: Stmt, bound: [LocalId], dmut: [SymId],
             acc: [Carried]) : ScanState {
  match s {
    SLet(pat, _, rhs) ->
      Scan(cs_pat_binders(pat, bound), free_carriers(rhs, bound, dmut, acc))
    SVar(b, _, rhs, _, _) ->
      Scan([b.id, ...bound], free_carriers(rhs, bound, dmut, acc))
    SExprStmt(e) -> Scan(bound, free_carriers(e, bound, dmut, acc))
    SAssert(e, og) -> {
      let a1 = free_carriers(e, bound, dmut, acc)
      Scan(bound, free_in_opt(og, bound, dmut, a1))
    }
    _ -> Scan(bound, acc)
  }
}


fn free_in_arms(arms: [Arm], bound: [LocalId], dmut: [SymId],
                acc: [Carried]) : [Carried] {
  match arms {
    []           -> acc
    [a, ...rest] -> match a {
      Arm(pat, og, body) -> {
        let bound1 = cs_pat_binders(pat, bound)
        let a1 = free_in_opt(og, bound1, dmut, acc)
        free_in_arms(rest, bound, dmut,
                     free_carriers(body, bound1, dmut, a1))
      }
    }
  }
}


fn free_in_opt(o: Option[Expr], bound: [LocalId], dmut: [SymId],
               acc: [Carried]) : [Carried] = match o {
  Some(e) -> free_carriers(e, bound, dmut, acc)
  None    -> acc
}


fn free_in_list(es: [Expr], bound: [LocalId], dmut: [SymId],
                acc: [Carried]) : [Carried] {
  match es {
    []           -> acc
    [h, ...rest] ->
      free_in_list(rest, bound, dmut, free_carriers(h, bound, dmut, acc))
  }
}


# Sub-expressions of the forms that bind nothing; the binding forms
# (block, match, lambda) are handled by `free_carriers` directly.
fn capture_kids(e: Expr) : [Expr] {
  match e.kind {
    EField(base, _)      -> [base]
    EIndex(a, b)         -> [a, b]
    EBinop(_, a, b)      -> [a, b]
    EUnop(_, x)          -> [x]
    EBang(x)             -> [x]
    ELitUnit(x, _)       -> [x]
    EPipe(a, b)          -> [a, b]
    EMapPipe(a, b)       -> [a, b]
    EFlatMapPipe(a, b)   -> [a, b]
    EFilterPipe(a, b)    -> [a, b]
    EIntrinsic(_, args_) -> args_
    EList(els)           -> capture_list_elems(els)
    ERecordLit(_, fs)    -> capture_field_inits(fs)
    EIf(c, t, eo)        -> [c, t, ...capture_opt(eo)]
    ERange(a, b, os)     -> [a, b, ...capture_opt(os)]
    _ -> []
  }
}


fn capture_opt(o: Option[Expr]) : [Expr] = match o {
  Some(x) -> [x]
  None    -> []
}


fn capture_list_elems(els: [ListElem]) : [Expr] = match els {
  []            -> []
  [el, ...rest] -> match el {
    ElPlain(e)  -> [e, ...capture_list_elems(rest)]
    ElSpread(e) -> [e, ...capture_list_elems(rest)]
  }
}


fn capture_field_inits(fs: [FieldInit]) : [Expr] = match fs {
  []           -> []
  [f, ...rest] -> match f { FI(_, e) -> [e, ...capture_field_inits(rest)] }
}
