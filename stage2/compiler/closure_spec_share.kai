# Whether a specialised callee pastes its closure argument's body at each
# application or calls the closure's literal there. A lambda or a handler
# clause is lifted under its source position, so two pasted copies of one
# would lift two symbols under a single name.

import compiler.ast
import compiler.expr_positions
import compiler.closure_spec_ast

#[doc("True when the closure's body must stay one copy: it lifts a lambda or a handler clause and the callee applies its parameter `f` more than once.")]
pub fn shares_closure(ca: ClosureArg, body: Expr, f: LocalId) : Bool =
  holds_lifted(closure_body(ca)) and applications(body, f) > 1

fn closure_body(ca: ClosureArg) : Expr = match ca {
  CaLambda(_, b) -> b
  CaNamedFn(d)   -> decl_body(d)
}

fn applications(e: Expr, f: LocalId) : Int = {
  let here = match e.kind {
    ECall(callee, _) -> match callee.kind { ELocal(l) -> if local_eq(l, f) { 1 } else { 0 }  _ -> 0 }
    _ -> 0
  }
  foldl(xp_positions(e), here, (acc, p) => match p { XP(_, c) -> acc + applications(c, f) })
}

fn holds_lifted(e: Expr) : Bool = match e.kind {
  ELambda(_, _) -> true
  EHandle(_, _, _, _, _, _, _) -> true
  _ -> any(xp_positions(e), (p) => match p { XP(_, c) -> holds_lifted(c) })
}
