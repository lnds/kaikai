#[doc("""
Arm binders moved on every read because no path reads them twice.

A binder read on several alternatives, at most once on any path, needs no
dup: each read hands the birth reference on, and the branch payer releases
it on entry to the alternatives that reach none of its reads. Without the
move every read dups and one exit drop is owed, which a body whose tails
are self-calls cannot place on its value and modulo-cons leaves.

The move needs every read to land in a slot that consumes it (the caller's
`slots_ok`, and no bare read in a slot `bpos` names as borrowed), no read
in the arm's own guard, no read in a lambda, and a scrutinee that owns its
cell: a borrowed scrutinee's binders own nothing.
""")]

import compiler.ast
import compiler.expr_positions
import compiler.infer
import compiler.perceus_branch_plant
import compiler.perceus_reads
import compiler.sym_read
import compiler.util

type PpmCx = { uses: [Use], skip: [String], borrowed: [String],
               slots_ok: (String, Expr) -> Bool, bpos: (Expr) -> [Int] }

#[doc("The arm binders of `body` read on several paths but at most once on each, that the branch payer can pay. `skip` names binders already moved; `bpos` gives a callee's borrowed positions.")]
pub fn ppm_path_moves(body: Expr, uses: [Use], skip: [String], borrowed: [String],
                      slots_ok: (String, Expr) -> Bool, bpos: (Expr) -> [Int]) : [String] =
  ppm_expr(body, PpmCx { uses: uses, skip: skip, borrowed: borrowed, slots_ok: slots_ok, bpos: bpos }, [])

fn ppm_expr(e: Expr, cx: PpmCx, acc: [String]) : [String] = match e.kind {
  EMatch(s, arms) -> ppm_arms(arms, ppm_scr_owned(s, cx.borrowed), cx, ppm_expr(s, cx, acc))
  _               -> ppm_ps(xp_positions(e), cx, acc)
}

fn ppm_ps(ps: [XPos], cx: PpmCx, acc: [String]) : [String] = match ps {
  []                  -> acc
  [XP(r, c), ...rest] -> ppm_ps(rest, cx, if xrole_inline(r) { ppm_expr(c, cx, acc) } else { acc })
}

fn ppm_arms(arms: [Arm], owned: Bool, cx: PpmCx, acc: [String]) : [String] = match arms {
  []                        -> acc
  [Arm(p, og, b), ...rest] -> {
    let acc1 = if owned { ppm_binders(prc_pat_bindings(p, []), og, b, cx, acc) } else { acc }
    let acc2 = match og {
      Some(g) -> ppm_expr(g, cx, acc1)
      None    -> acc1
    }
    ppm_arms(rest, owned, cx, ppm_expr(b, cx, acc2))
  }
}

fn ppm_binders(names: [String], og: Option[Expr], b: Expr, cx: PpmCx, acc: [String]) : [String] = match names {
  []            -> acc
  [nm, ...rest] -> ppm_binders(rest, og, b, cx, if ppm_qualifies(nm, og, b, cx) { [nm, ...acc] } else { acc })
}

fn ppm_qualifies(nm: String, og: Option[Expr], b: Expr, cx: PpmCx) : Bool =
  not name_is_unused_binder(nm) and not list_has(cx.skip, nm) and
  pcs_read_count(nm, cx.uses) >= 2 and not pcs_uses_have_in_lam(cx.uses, nm) and
  not ppm_guard_mentions(nm, og) and cx.slots_ok(nm, b) and
  not ppm_borrowed_read(nm, b, cx.bpos) and pbl_plantable(nm, b)

fn ppm_guard_mentions(nm: String, og: Option[Expr]) : Bool = match og {
  Some(g) -> pcs_mentions(nm, g)
  None    -> false
}

fn ppm_scr_owned(s: Expr, borrowed: [String]) : Bool = match sym_read_kind(s.kind) {
  EVar(nm)    -> not list_has(borrowed, nm)
  ECall(f, _) -> match sym_read_kind(f.kind) {
    EMark(MkBorrow) -> false
    _               -> true
  }
  _ -> true
}

# A bare read in a borrowed slot hands nothing on: the callee takes no reference.
fn ppm_borrowed_read(nm: String, e: Expr, bpos: (Expr) -> [Int]) : Bool = match e.kind {
  ECall(f, xs) -> ppm_bare_at(nm, xs, bpos(f), 0) or ppm_borrowed_read_ps(nm, xp_positions(e), bpos)
  _            -> ppm_borrowed_read_ps(nm, xp_positions(e), bpos)
}

fn ppm_borrowed_read_ps(nm: String, ps: [XPos], bpos: (Expr) -> [Int]) : Bool = match ps {
  []                  -> false
  [XP(_, c), ...rest] -> ppm_borrowed_read(nm, c, bpos) or ppm_borrowed_read_ps(nm, rest, bpos)
}

fn ppm_bare_at(nm: String, xs: [Expr], positions: [Int], i: Int) : Bool = match xs {
  []           -> false
  [x, ...rest] -> (contains(positions, i) and ppm_is_read(nm, x)) or ppm_bare_at(nm, rest, positions, i + 1)
}

fn ppm_is_read(nm: String, x: Expr) : Bool = match sym_read_kind(x.kind) {
  EVar(u) -> u == nm
  _       -> false
}
