#[doc("""
The diagnostic for a declared type standing where a builtin of the same
name was meant.

A bare name reaches a declaration the file sees before the builtin: its
own, then one a module it opens exports. When the declaration and the builtin meet in
one mismatch, the message names the declaration the bare name reached
and how to reach the builtin instead.
""")]

import compiler.ast
import compiler.diag
import compiler.written
import compiler.symtab
import compiler.decl_text
import compiler.tycon_scheme_home

#[doc("Notes and help for a mismatch between a declared type and the builtin it shadows; false, emitting nothing, when the pair is not one.")]
pub fn core_shadow_notes(tab: SymTab, hs: TyHomes, expected: Ty, found: Ty) : Bool / Console =
  match core_shadow_pair(tab, expected, found) {
    None -> false
    Some(s) -> {
      core_shadow_emit(written_text(decl_name(tab, s)), tsh_sym_slot(tsh_view(hs, None), s))
      true
    }
  }

fn core_shadow_emit(nm: String, home: Option[String]) : Unit / Console = match home {
  Some(m) -> {
    diag_note("`#{nm}` here names `#{m}.#{nm}`, the type module `#{m}` declares, not the builtin `#{nm}`")
    diag_help("import `#{m}` selectively without `#{nm}` (`import #{m}.{…}`) or under a qualifier (`import #{m} as …`) so a bare `#{nm}` names the builtin")
  }
  None -> {
    diag_note("`#{nm}` here names the `#{nm}` this file declares, not the builtin `#{nm}`")
    diag_help("rename this file's `#{nm}` so a bare `#{nm}` names the builtin")
  }
}

# The declared type of the pair, when the other is the builtin it is spelled like.
fn core_shadow_pair(tab: SymTab, e: Ty, f: Ty) : Option[SymId] = match e {
  TyCon(es, _) -> match f {
    TyCon(fs, _) ->
      if core_shadowed_by(tab, fs, es) { Some(es) }
      else if core_shadowed_by(tab, es, fs) { Some(fs) }
      else { None }
    _ -> None
  }
  _ -> None
}

fn core_shadowed_by(tab: SymTab, core: SymId, decl: SymId) : Bool = match core_type_name_of(core) {
  Some(n) -> sym_raw(decl) >= 0 and sym_raw(decl) != sym_raw(core) and written_text(decl_name(tab, decl)) == n
  None    -> false
}
