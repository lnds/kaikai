#[doc("Type and `extern` declarations with FFI-safety validation.")]

import compiler.lex_tokens
import compiler.ast
import compiler.decl_names
import compiler.parse_state
import compiler.parse_types
import compiler.parse_fns
import compiler.util
import compiler.chars
import compiler.written
import compiler.tbinder

# The module that declares the tuple types the `(A, B)` sugar names.
fn tuple_type_home() : String = "tuple"

#[doc("The core tuple declaration named `n`: tuple sugar denotes it whatever the file declares under that name.")]
pub fn tuple_type_ref(n: String) : DeclRef = DrSym(sym_derive_word("type", n, tuple_type_home()))

# Fields of Pair / Triple / Quad by position.
fn tuple_field_name(i: Int) : String = match i {
  0 -> "fst"
  1 -> "snd"
  2 -> "trd"
  _ -> "frt"
}

#[doc("The field initialisers of a tuple literal's elements, named by position.")]
pub fn build_tuple_field_inits(elems: [Expr], i: Int, acc: [FieldInit]) : [FieldInit] =
  match elems {
    [] -> list_reverse(acc)
    [e, ...rest] -> build_tuple_field_inits(rest, i + 1, [FI(tuple_field_name(i), e), ...acc])
  }

#[doc("The field patterns of a tuple pattern's elements, named by position.")]
pub fn build_tuple_pfields(pats: [Pattern], i: Int, acc: [PField]) : [PField] =
  match pats {
    [] -> list_reverse(acc)
    [pat, ...rest] -> build_tuple_pfields(rest, i + 1, [PField(tuple_field_name(i), pat, false), ...acc])
  }

#[doc("The tuple literal `(x0, …)` of 2 to 4 elements, as the parser builds it.")]
pub fn tuple_lit_expr(xs: [Expr], line: Int, col: Int) : Expr = match tuple_type_for_arity(list_length(xs)) {
  Some(n) -> mk_expr(ERecordLit(tuple_type_ref(n), build_tuple_field_inits(xs, 0, [])), line, col)
  None -> mk_expr(EUnit, line, col)
}

#[doc("The tuple pattern `(p0, …)` of 2 to 4 elements, as the parser builds it.")]
pub fn tuple_pat_of(ps: [Pattern], line: Int, col: Int) : Pattern = match tuple_type_for_arity(list_length(ps)) {
  Some(n) -> mk_pat(PVariantRecord(tuple_type_ref(n), build_tuple_pfields(ps, 0, [])), line, col)
  None -> mk_pat(PWild, line, col)
}

#[doc("The parser state paired with the result of parsing a `derive` name list.")]
pub type PDeriveNames = { p: Parser, r: Option[[String]] }

#[doc("Parses the names of `#[derive(...)]`, each `P` or `m.P` folded into one spelling like an `impl` head.")]
pub fn parse_derive_names(p: Parser, acc: [String]) : PDeriveNames / Console {
  let id = p_peek(p)
  if not at_type_head(p, id) {
    PDeriveNames { p: p_error(p, id, "expected a protocol name in `#[derive(...)]`"), r: None }
  } else {
    let pq = parse_qualified_head_name(p, id)
    derive_names_end(p_skip_newlines(pq.p), [pq.name, ...acc])
  }
}

fn derive_names_end(p: Parser, acc: [String]) : PDeriveNames / Console =
  if p_at(p, TkComma) { parse_derive_names(p_advance_nl(p), acc) }
  else if p_at(p, TkRparen) { PDeriveNames { p: p_advance(p), r: Some(list_reverse(acc)) } }
  else { PDeriveNames { p: p_error_here(p, "expected `,` or `)` in `#[derive(...)]`"), r: None } }

type TypeHead = { at: Parser, is_pub: Bool, name: String, tparams: [TBinder], slots: [String], t: Token }

fn type_ok(p: Parser, h: TypeHead, body: TypeBody, ctors: [NEnt]) : PDecl =
  ok_dn(p, DType(h.is_pub, p_sym(h.at, NCType, h.name), h.tparams, body, h.t.line, h.t.col, None, h.slots),
        [p_ent(h.at, NCType, h.name, h.is_pub), ...ctors])

#[doc("Parses a `type` declaration after its keyword.")]
pub fn parse_type_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) or not is_upper_ident(p.src, id) {
    err_d(p_error(p, id, "expected an uppercase type name after `type`"))
  } else {
    let p1 = p_advance_nl(p)
    let tps =
      if p_at(p1, TkLbracket) { parse_type_params_loop(p_advance_nl(p1), []) }
      else { PTParams { p: p1, r: Some([]) } }
    match tps.r {
      None -> err_d(tps.p)
      Some(tparams) -> type_slots(tps.p, TypeHead { at: p, is_pub: is_pub, name: tok_source(p.src, id), tparams: tparams, slots: [], t: t })
    }
  }
}

fn type_slots(p: Parser, h: TypeHead) : PDecl / Console {
  let sr =
    if p_at(p, TkLt) { parse_habitant_slots_loop(p_advance_nl(p), []) }
    else { PHSlots { p: p, r: Some([]) } }
  match sr.r {
    None -> err_d(sr.p)
    Some(slots) -> {
      let pe = p_eat(p_skip_newlines(sr.p), TkEq, "expected `=` in type declaration")
      if p_failed(pe) { err_d(pe) } else { type_body(p_skip_newlines(pe), TypeHead { ...h, slots: slots }) }
    }
  }
}

# A leading `|` marks a sum outright, so a one-member sum can exist; without it `= X` is an alias.
fn type_body(p: Parser, h: TypeHead) : PDecl / Console =
  if p_at(p, TkLbrace) { record_fields(p_advance_nl(p), [], h) }
  else if p_at(p, TkPipe) { sum_variants(p_advance_nl(p), [], [], h) }
  else { type_body_head(p, h) }

# A qualified head enters the sum path only when a `|` follows: on its own, `type T = m.U` is an alias.
fn type_body_head(p: Parser, h: TypeHead) : PDecl / Console {
  let hd = p_peek(p)
  if tk_is(hd.kind, TkIdent) and at_qualified_member(p, hd) and looks_like_sum(p) { sum_variants(p, [], [], h) }
  else if tk_is(hd.kind, TkIdent) and is_upper_ident(p.src, hd) { type_body_upper(p, hd, h) }
  else { alias_body(p, h) }
}

# A `+` right after the first uppercase ident marks an effect alias; type aliases never use `+`.
fn type_body_upper(p: Parser, hd: Token, h: TypeHead) : PDecl / Console =
  if tk_is(p_peek1(p).kind, TkPlus) {
    let label = RL(ref_written(tok_source(p.src, hd)), [])
    parse_effect_alias_body(p_advance(p_advance(p)), [label], h.is_pub, h.name, h.tparams, h.slots, h.t)
  } else if looks_like_sum(p) { sum_variants(p, [], [], h) }
  else { alias_body(p, h) }

# A `+` after the aliased type (`Actor[Msg] + ...`, `m.E + ...`) also marks an effect alias.
fn alias_body(p: Parser, h: TypeHead) : PDecl / Console {
  let rt = parse_type(p)
  match rt.r {
    None -> err_d(rt.p)
    Some(aliased) -> match effect_alias_head(rt.p, aliased) {
      Some(l) -> parse_effect_alias_body(p_advance(rt.p), [l], h.is_pub, h.name, h.tparams, h.slots, h.t)
      None -> type_ok(rt.p, h, TBAlias(aliased), [])
    }
  }
}

# A sum has a `|` at depth 0 or a `Variant(` head, or continues with `|` on the next line.
fn looks_like_sum(p: Parser) : Bool =
  (is_upper_ident(p.src, p_peek(p)) and tk_is(p_peek1(p).kind, TkLparen)) or looks_like_sum_scan(p.rest, 0)

fn bracket_delta(k: TokKind) : Int = match k {
  TkLparen -> 1
  TkLbracket -> 1
  TkLbrace -> 1
  TkRparen -> 0 - 1
  TkRbracket -> 0 - 1
  TkRbrace -> 0 - 1
  _ -> 0
}

fn looks_like_sum_scan(toks: [Token], depth: Int) : Bool = match toks {
  [] -> false
  [t, ...rs] ->
    if tk_is(t.kind, TkEof) { false }
    else if depth != 0 { looks_like_sum_scan(rs, depth + bracket_delta(t.kind)) }
    else if tk_is(t.kind, TkPipe) { true }
    else if tk_is(t.kind, TkNewline) { pipe_after_newlines(rs) }
    else { looks_like_sum_scan(rs, depth + bracket_delta(t.kind)) }
}

fn pipe_after_newlines(toks: [Token]) : Bool = match toks {
  [t, ...rs] -> if tk_is(t.kind, TkNewline) { pipe_after_newlines(rs) } else { tk_is(t.kind, TkPipe) }
  [] -> false
}

#[doc("Parses the fields of a record type up to its closing brace.")]
pub fn parse_record_body(p: Parser, acc: [FieldDecl], is_pub: Bool, name: String, tparams: [TBinder], slots: [String], t: Token) : PDecl / Console =
  record_fields(p, acc, TypeHead { at: p, is_pub: is_pub, name: name, tparams: tparams, slots: slots, t: t })

fn record_fields(p: Parser, acc: [FieldDecl], h: TypeHead) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) { type_ok(p_advance(p0), h, TBRecord(list_reverse(acc)), []) }
  else {
    let fa = parse_field_attrs(p0, [])
    match fa.r {
      None -> err_d(fa.p)
      Some(attrs) -> record_field(p_skip_newlines(fa.p), attrs, acc, h)
    }
  }
}

# Fields are public unless marked `priv`.
fn record_field(p: Parser, attrs: [FieldAttr], acc: [FieldDecl], h: TypeHead) : PDecl / Console {
  let is_priv = p_at(p, TkPriv)
  let pn = if is_priv { p_advance(p) } else { p }
  let ft = p_peek(pn)
  if not tk_is(ft.kind, TkIdent) { err_d(p_error(pn, ft, "expected field name in record type")) }
  else {
    let pc = p_eat(p_advance(pn), TkColon, "expected `:` after field name")
    if p_failed(pc) { err_d(pc) } else { record_field_ty(parse_type(pc), not is_priv, tok_source(pn.src, ft), attrs, acc, h) }
  }
}

fn record_field_ty(rt: PTy, is_pub: Bool, fname: String, attrs: [FieldAttr], acc: [FieldDecl], h: TypeHead) : PDecl / Console =
  match rt.r {
    None -> err_d(rt.p)
    Some(ty) -> record_field_end(rt.p, [FD(is_pub, fname, ty, attrs), ...acc], h)
  }

fn record_field_end(p: Parser, acc: [FieldDecl], h: TypeHead) : PDecl / Console {
  let p2 = p_skip_newlines(p)
  if p_at(p2, TkComma) { record_fields(p_advance_nl(p2), acc, h) }
  else if p_at(p2, TkRbrace) { type_ok(p_advance(p2), h, TBRecord(list_reverse(acc)), []) }
  else { err_d(p_error_here(p2, "expected `,` or `}` in record type")) }
}

fn sum_variants(p: Parser, acc: [Variant], racc: [NEnt], h: TypeHead) : PDecl / Console {
  let p0 = p_skip_newlines(p)
  let vt = p_peek(p0)
  if not at_type_head(p0, vt) { err_d(p_error(p0, vt, "expected variant constructor name")) }
  else {
    let qn = parse_qualified_head_name(p0, vt)
    let args = sum_variant_args(qn.p, p0, vt)
    match args.r {
      None -> err_d(args.p)
      Some(vargs) -> sum_next(p_skip_newlines(args.p), [Var(p_sym(h.at, NCCtor, qn.name), vargs), ...acc],
                              [p_ent(h.at, NCCtor, qn.name, h.is_pub), ...racc], h)
    }
  }
}

fn sum_next(p: Parser, acc: [Variant], racc: [NEnt], h: TypeHead) : PDecl / Console =
  if p_at(p, TkPipe) { sum_variants(p_advance_nl(p), acc, racc, h) }
  else { type_ok(p, h, TBSum(list_reverse(acc)), list_reverse(racc)) }

fn sum_variant_args(p: Parser, p0: Parser, vt: Token) : PTypes / Console =
  if not p_at(p, TkLparen) { PTypes { p: p, r: Some([]) } }
  else if at_qualified_member(p0, vt) { PTypes { p: p_error_here(p, "a qualified union member names a declared type, so it takes no payload"), r: None } }
  else { variant_args(p_advance_nl(p)) }

fn variant_args(p: Parser) : PTypes / Console =
  if p_at(p, TkRparen) {
    PTypes { p: p_error_here(p, "a variant with no payload takes no parentheses — write `X`, and for a one-member sum `type T = | X`"), r: None }
  } else {
    parse_type_list(p, TkRparen, "expected `,` or `)` in variant payload", [])
  }

#[doc("True when `d` is a `pub fn`, seeing through a `#[doc(...)]` wrapper.")]
pub fn constructor_wraps_fn(d: Decl) : Bool = match d {
  DFn(is_pub, _, _, _, _, _, _, _, _, _) -> is_pub
  DDoc(_, _, inner, _, _) -> constructor_wraps_fn(inner)
  DAttr(_, inner, _, _) -> constructor_wraps_fn(inner)
  _ -> false
}

#[doc("""
Wrap the `pub fn` in `DConstructor`, hoisting any `#[doc(...)]` wrapper
to the outside so `doc_strip_collect` still lifts it and every walker
sees `DConstructor(DFn)`, not `DConstructor(DDoc(DFn))`.
""")]
pub fn constructor_wrap(d: Decl, l: Int, c: Int) : Decl = match d {
  DDoc(raw, text, inner, dl, dc) -> DDoc(raw, text, constructor_wrap(inner, l, c), dl, dc)
  DAttr(raw, inner, al, ac) -> DAttr(raw, constructor_wrap(inner, l, c), al, ac)
  _ -> DConstructor(d, l, c)
}

type FnHead = { p: Parser, is_pub: Bool }

type PStr = { p: Parser, r: Option[String] }

type AxiomHead = {
  p0: Parser,
  is_pub: Bool,
  abi: Option[ExternAbi],
  c_sym: String,
  t: Token,
  aname: String,
  tparams: [TBinder]
}

fn fail_d(p: Parser, msg: String) : PDecl / Console = err_d(p_error_here(p, msg))

fn fail_d_at(p: Parser, t: Token, msg: String) : PDecl / Console = err_d(p_error(p, t, msg))

fn at_upper_ident(p: Parser, t: Token) : Bool = tk_is(t.kind, TkIdent) and is_upper_ident(p.src, t)

#[doc("Reports whether the parser sits on the retired `[<extern_c>]` attribute prefix.")]
pub fn parse_at_legacy_extern_c_attribute(p: Parser) : Bool =
  p_at(p, TkLbracket) and tk_is(p_peek1(p).kind, TkLt) and tk_is(p_peek2(p).kind, TkIdent)
    and tok_source(p.src, p_peek2(p)) == "extern_c"

#[doc("""
Parses `extern "C"|"kai" [("symbol")] [pub] fn name(...) : T [/ row]`, `extern "C" type`
and `extern "C" opaque` after the `extern` token `t`. A C symbol override must be a valid
C identifier; under `"kai"` the symbol is mandatory.
""")]
pub fn parse_extern_decl(p: Parser, t: Token) : PDecl / Console {
  let pa = p_skip_newlines(p)
  let abi_tok = p_peek(pa)
  if not tk_is(abi_tok.kind, TkString) {
    fail_d_at(pa, abi_tok, "expected an ABI string literal after `extern` (only `\"C\"` is supported)")
  } else {
    let abi = tok_source(pa.src, abi_tok)
    if abi == "\"C\"" { extern_c_decl(p_advance(pa), t) }
    else if abi == "\"kai\"" { extern_kai_decl(p_advance(pa), t) }
    else { fail_d_at(pa, abi_tok, concat_all(["unsupported FFI ABI ", abi, " — only \"C\" is supported"])) }
  }
}

fn extern_c_decl(p: Parser, t: Token) : PDecl / Console {
  let head = p_peek(p)
  if tk_is(head.kind, TkType) { extern_struct_decl(p_advance(p), t) }
  else if tk_is(head.kind, TkIdent) and tok_source(p.src, head) == "opaque" { extern_opaque_decl(p_advance(p), t) }
  else {
    let over = parse_optional_c_override(p)
    match over.r {
      None -> err_d(over.p)
      Some(sym) -> validate_extern_c_decl(
        extern_fn(over.p, "expected `fn`, `type`, or `opaque` after `extern \"C\"` (FFI declarations look like `extern \"C\" fn name(...) : T / Ffi`)", AbiC, sym, t), t)
    }
  }
}

fn extern_kai_decl(p: Parser, t: Token) : PDecl / Console {
  let over = parse_optional_c_override(p)
  match over.r {
    None -> err_d(over.p)
    Some("") -> fail_d(p, "`extern \"kai\"` needs its runtime symbol: `extern \"kai\"(\"kai_core_<name>\") fn ...`")
    Some(sym) -> extern_fn(over.p, "expected `fn` after `extern \"kai\"(\"<symbol>\")`", AbiKai, sym, t)
  }
}

fn extern_fn_head(p: Parser, msg: String) : FnHead / Console {
  let p1 = p_skip_newlines(p)
  let is_pub = p_at(p1, TkPub)
  FnHead { p: p_eat(if is_pub { p_advance_nl(p1) } else { p1 }, TkFn, msg), is_pub: is_pub }
}

fn extern_fn(p: Parser, msg: String, abi: ExternAbi, sym: String, t: Token) : PDecl / Console {
  let h = extern_fn_head(p, msg)
  if p_failed(h.p) { err_d(h.p) } else { parse_axiom_decl(h.p, h.is_pub, Some(abi), sym, t) }
}

fn parse_optional_c_override(p: Parser) : PStr / Console =
  if not p_at(p, TkLparen) { PStr { p: p, r: Some("") } }
  else {
    let p1 = p_advance(p)
    let tok = p_peek(p1)
    if tk_is(tok.kind, TkString) { c_symbol_override(p1, tok) }
    else { PStr { p: p_error(p1, tok, "expected a C-symbol string literal inside `extern \"C\"(...)`"), r: None } }
  }

fn c_symbol_override(p: Parser, tok: Token) : PStr / Console {
  let span = tok_source(p.src, tok)
  let n = string_length(span)
  let sym = if n >= 2 { string_slice(span, 1, n - 2) } else { "" }
  if not is_valid_c_identifier(sym) {
    PStr { p: p_error(p, tok, concat_all(["invalid C symbol override ", span, " — must match `[A-Za-z_][A-Za-z0-9_]*`"])), r: None }
  } else {
    let p1 = p_eat(p_advance(p), TkRparen, "expected `)` to close `extern \"C\"(\"<symbol>\")` override")
    PStr { p: p1, r: if p_failed(p1) { None } else { Some(sym) } }
  }
}

fn extern_struct_decl(p: Parser, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not at_upper_ident(p, id) { fail_d_at(p, id, "expected an uppercase type name after `extern \"C\" type`") }
  else {
    let p1 = p_eat(p_advance_nl(p), TkEq, "expected `=` in `extern \"C\" type` declaration")
    if p_failed(p1) { err_d(p1) } else { extern_struct_body(p_skip_newlines(p1), tok_source(p.src, id), t) }
  }
}

fn extern_struct_body(p: Parser, name: String, t: Token) : PDecl / Console {
  let p1 = p_eat(p, TkLbrace, "expected `{` — `extern \"C\" type` must be a struct body `{ field: T, ... }`")
  if p_failed(p1) { err_d(p1) }
  else {
    let body = parse_record_body(p_skip_newlines(p1), [], false, name, [], [], t)
    match body.r {
      None -> body
      Some(DType(_, _, _, TBRecord(fields), _, _, _, _)) -> validate_extern_struct_decl(name, fields, body.p, t)
      Some(_) -> fail_d_at(body.p, t, "internal: extern struct body did not parse as a record")
    }
  }
}

fn extern_opaque_decl(p: Parser, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not at_upper_ident(p, id) { fail_d_at(p, id, "expected an uppercase type name after `extern \"C\" opaque`") }
  else {
    let name = tok_source(p.src, id)
    ok_dn(p_advance(p), DExternType(name, ETOpaque, t.line, t.col, None), [p_ent(p, NCExternType, name, true)])
  }
}

#[doc("""
Parses `name[tparams](params) : T / row` of an axiom; the return type is required and
a body is rejected. `c_sym_over` is the C-symbol override, empty when absent.
""")]
pub fn parse_axiom_decl(p: Parser, is_pub: Bool, abi: Option[ExternAbi], c_sym_over: String, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) { fail_d_at(p, id, "expected axiom name") }
  else if is_some(abi) and is_upper_ident(p.src, id) { fail_d_at(p, id, "function names must start with a lowercase letter") }
  else {
    let tp = parse_opt_type_params(p_advance(p))
    match tp.r {
      None -> err_d(tp.p)
      Some(tparams) -> axiom_params(tp.p, AxiomHead { p0: p, is_pub: is_pub, abi: abi, c_sym: c_sym_over,
                                                      t: t, aname: tok_source(p.src, id), tparams: tparams })
    }
  }
}

fn axiom_params(p: Parser, h: AxiomHead) : PDecl / Console {
  let p1 = p_eat(p, TkLparen, "expected `(` after axiom name")
  if p_failed(p1) { err_d(p1) }
  else {
    let ps = parse_fn_params(p_skip_newlines(p1), [])
    match ps.r {
      None -> err_d(ps.p)
      Some(params) -> axiom_ret(p_skip_newlines(ps.p), h, params)
    }
  }
}

fn axiom_ret(p: Parser, h: AxiomHead, params: [Param]) : PDecl / Console {
  let p1 = p_eat(p, TkColon, "axiom requires a return type — write `axiom name(...) : T`")
  if p_failed(p1) { err_d(p1) }
  else {
    let rt = parse_type(p1)
    match rt.r {
      None -> err_d(rt.p)
      Some(ty) -> axiom_tail(rt.p, h, params, ty)
    }
  }
}

fn axiom_tail(p: Parser, h: AxiomHead, params: [Param], ty: TypeExpr) : PDecl / Console {
  let row = parse_row_suffix(p)
  let p1 = p_skip_newlines(row.p)
  if p_at(p1, TkEq) or p_at(p1, TkLbrace) { fail_d(p1, "axiom must not have a body — drop the `=` / `{` and trailing block") }
  else {
    ok_dn(row.p, DAxiom(h.is_pub, h.abi, h.aname, h.c_sym, h.tparams, params, ty, row.r, h.t.line, h.t.col),
          [p_ent(h.p0, NCFn, h.aname, h.is_pub)])
  }
}

# Nothing is resolved while a file is parsed, so these checks see only the
# text a reference was written with.
fn ref_bare_text(r: DeclRef) : String = match r {
  DrWritten(None, n) -> written_text(n)
  _ -> ""
}

fn ref_surface(r: DeclRef) : String = match r {
  DrWritten(None, n) -> written_text(n)
  DrWritten(Some(q), n) -> concat_all([written_text(q), ".", written_text(n)])
  DrSym(_) -> ""
}

fn row_labels(row: RowExpr) : [RowLabel] = match row {
  REmpty -> []
  RClosed(lbs) -> lbs
  ROpen(_, lbs) -> lbs
}

fn extern_row_has_ffi(row: RowExpr) : Bool =
  any(row_labels(row), (l) => match l { RL(r, _) -> ref_bare_text(r) == "Ffi" })

# The fixed-width boundary scalars: plain `Int` (`Real` for `F32`) boxes on the
# kaikai side, C-cast at the shim.
fn is_fixed_width_ffi_name(name: String) : Bool =
  name == "U8" or name == "U16" or name == "U32" or name == "U64" or
  name == "I8" or name == "I16" or name == "I32" or name == "I64" or name == "F32"

fn is_v1_primitive_name(name: String) : Bool =
  name == "Int" or name == "Real" or name == "Bool" or
  name == "String" or name == "Char" or name == "Unit"

fn is_upper_first(name: String) : Bool =
  match char_at(name, 0) {
    Some(c) -> c >= 'A' and c <= 'Z'
    None -> false
  }

# A bare uppercase name may be a declared foreign type; the registry is not
# visible here, so the resolver rejects an undeclared one.
fn is_c_abi_safe_name(name: String, is_return_slot: Bool) : Bool =
  if name == "Unit" { is_return_slot }
  else { (is_v1_primitive_name(name) or is_fixed_width_ffi_name(name) or is_upper_first(name)) }

fn is_c_abi_safe_type(t: TypeExpr, is_return_slot: Bool) : Bool =
  match t.tkind {
    TyName(r, targs) -> targs == [] and is_c_abi_safe_name(ref_bare_text(r), is_return_slot)
    _ -> false
  }

# A C struct field needs an exact width, so the primitives are rejected.
fn is_c_field_type(t: TypeExpr) : Bool =
  match t.tkind {
    TyName(r, targs) -> {
      let name = ref_bare_text(r)
      targs == [] and (is_fixed_width_ffi_name(name) or (not is_v1_primitive_name(name) and is_upper_first(name)))
    }
    _ -> false
  }

fn type_surface(t: TypeExpr) : String =
  match t.tkind {
    TyName(r, []) -> ref_surface(r)
    TyName(r, targs) -> concat_all([ref_surface(r), "[", type_args_surface(targs), "]"])
    TyList(inner) -> concat_all(["[", type_surface(inner), "]"])
    TyFn(_, _, _) -> "fn(...)"
    TyDim(base, _) -> concat_all([type_surface(base), "<...>"])
    TyRefine(base, _) -> concat_all([type_surface(base), " where ..."])
    TyRow(row) -> row_surface(row)
    TySurface(TsTuple(tys)) -> concat_all(["(", type_args_surface(tys), ")"])
    TySurface(TsUnitSpan(_, inner)) -> type_surface(inner)
    TyParam(_, _) -> "_"
  }

fn row_surface(r: RowExpr) : String =
  match r {
    REmpty -> ""
    RClosed(labels) -> row_labels_surface(labels)
    ROpen(tail, []) -> tail_written_text(tail)
    ROpen(tail, labels) -> concat_all([row_labels_surface(labels), " + ", tail_written_text(tail)])
  }

fn row_labels_surface(ls: [RowLabel]) : String =
  string_join(map(ls, (l) => match l { RL(r, _) -> ref_surface(r) }), " + ")

fn type_args_surface(ts: [TypeExpr]) : String = string_join(map(ts, type_surface), ", ")

#[doc("""
Rejects an `extern "C" type` struct with a field that has no C struct layout; the
nested-struct existence check is the resolver's.
""")]
pub fn validate_extern_struct_decl(name: String, fields: [FieldDecl], p: Parser, t: Token) : PDecl / Console =
  match find(fields, (fd) => match fd { FD(_, _, fty, _) -> not is_c_field_type(fty) }) {
    Some(FD(_, fname, fty, _)) -> err_d(p_error(p, t, concat_all([
      "`extern \"C\" type ", name, "` field `", fname,
      "` has type `", type_surface(fty),
      "` which has no C struct layout — fields must be fixed-width (U8 U16 U32 U64 I8 I16 I32 I64 F32) or another `extern \"C\" type`"
    ])))
    None -> ok_dn(p, DExternType(name, ETStruct(fields), t.line, t.col, None), [p_ent(p, NCExternType, name, true)])
  }

#[doc("""
Turns a parsed `extern "C" fn` into an error at the `extern` token unless its row
declares `Ffi` and every parameter and the return type are C-ABI compatible.
""")]
pub fn validate_extern_c_decl(decl_r: PDecl, t: Token) : PDecl / Console =
  match decl_r.r {
    Some(DAxiom(_, _, name, _, _, params, ret_ty, row, _, _)) ->
      match extern_c_problem(name, params, ret_ty, row) {
        Some(msg) -> err_d(p_error(decl_r.p, t, msg))
        None -> decl_r
      }
    _ -> decl_r
  }

fn extern_c_problem(name: String, params: [Param], ret_ty: TypeExpr, row: RowExpr) : Option[String] =
  if not extern_row_has_ffi(row) {
    Some(concat_all([
      "`extern \"C\" fn ", name,
      "` must declare `/ Ffi` in its row — FFI declarations always cross the Ffi capability boundary"
    ]))
  } else {
    match find(params, (pm) => not param_c_abi_safe(pm)) {
      Some(pm) -> Some(extern_param_message(name, pm))
      None -> if is_c_abi_safe_type(ret_ty, true) { None } else { Some(extern_return_message(name, ret_ty)) }
    }
  }

fn param_c_abi_safe(p: Param) : Bool = match p.ptype {
  Some(ty) -> is_c_abi_safe_type(ty, false)
  None -> false
}

fn extern_return_message(name: String, ret_ty: TypeExpr) : String =
  concat_all([
    "`extern \"C\" fn ", name,
    "` return type `", type_surface(ret_ty),
    "` is not C-ABI compatible — allowed: Int, Real, Bool, Char, String, Unit, fixed-width (U8..F32), an `extern \"C\" type` struct, or an `extern \"C\" opaque` handle"
  ])

fn extern_param_message(name: String, p: Param) : String {
  let ty_s = match p.ptype {
    Some(ty) -> type_surface(ty)
    None -> "<missing>"
  }
  concat_all([
    "`extern \"C\" fn ", name,
    "` parameter `", written_text(p.binder.name),
    "` has type `", ty_s,
    "` which is not C-ABI compatible — allowed: Int, Real, Bool, Char, String, fixed-width (U8..F32), an `extern \"C\" type` struct, or an `extern \"C\" opaque` handle"
  ])
}

#[doc("Reports whether a string is a valid C identifier.")]
pub fn is_valid_c_identifier(s: String) : Bool =
  string_length(s) > 0 and ch_is_alpha(char_at_or_zero(s, 0)) and c_ident_rest(s, 1, string_length(s))

fn c_ident_rest(s: String, i: Int, n: Int) : Bool =
  if i >= n { true }
  else if ch_is_alnum(char_at_or_zero(s, i)) { c_ident_rest(s, i + 1, n) }
  else { false }
