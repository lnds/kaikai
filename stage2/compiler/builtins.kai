#[doc("The core builtins: every name, runtime entry and type the compiler gives a program before it declares anything.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.core_types
import compiler.util
import compiler.written
import compiler.symtab

#[doc("Every core builtin, in registry order.")]
pub(pkg) fn builtin_table() : [Builtin] =
  list_append(io_builtins(),
  list_append(lowered_builtins(), list_append(collection_builtins(),
  list_append(mailbox_builtins(), intrinsic_builtins()))))

fn collection_builtins() : [Builtin] = [
  BF("array_make",        BRuntime, poly([0], fun([TyInt, tv(0)], arr(tv(0))))),
  BF("array_length",      BRuntime, poly([0], fun([arr(tv(0))], TyInt))),
  BF("array_get",         BRuntime, poly([0], fun([arr(tv(0)), TyInt], tv(0)))),
  # Never written by a program: the compiler pairs it with the write that refills the slot.
  BF("array_take",        BRuntimeUnbound, poly([0], fun_e([arr(tv(0)), TyInt], tv(0), [CeMutable]))),
  BF("array_set",         BRuntime, poly([0], fun_e([arr(tv(0)), TyInt, tv(0)], arr(tv(0)), [CeMutable]))),
  BF("array_grow",        BRuntime, poly([0], fun_e([arr(tv(0)), TyInt, tv(0)], arr(tv(0)), [CeMutable]))),
  # Vec is a value: writes return the result, so no op raises `Mutable`.
  BF("vec_make",          BRuntime, poly([0], fun([TyInt, tv(0)], vec(tv(0))))),
  BF("vec_empty",         BRuntime, poly([0], fun([], vec(tv(0))))),
  BF("vec_length",        BRuntime, poly([0], fun([vec(tv(0))], TyInt))),
  BF("vec_get",           BRuntime, poly([0], fun([vec(tv(0)), TyInt], tv(0)))),
  BF("vec_set",           BRuntime, poly([0], fun([vec(tv(0)), TyInt, tv(0)], vec(tv(0))))),
  BF("vec_push",          BRuntime, poly([0], fun([vec(tv(0)), tv(0)], vec(tv(0))))),
  BF("vec_slice",         BRuntime, poly([0], fun([vec(tv(0)), TyInt, TyInt], vec(tv(0))))),
  BF("vec_tail_from",     BRuntime, poly([0], fun([vec(tv(0)), TyInt], vec(tv(0))))),
  BF("vec_reserve",       BRuntime, poly([0], fun([TyInt], vec(tv(0))))),
  BF("vec_from_list",     BRuntime, poly([0], fun([lst(tv(0))], vec(tv(0)))))
]

fn mailbox_builtins() : [Builtin] = [
  # A declared signature returning a `Pid` is held to the actor-scope escape rule; these allocate one.
  BF("mailbox_alloc",         BRuntime, poly([0], fun([], pid(tv(0))))),
  BF("mailbox_alloc_bounded", BRuntime, poly([0], fun([TyInt, TyInt], pid(tv(0))))),
  BF("mailbox_alloc_unowned", BRuntime, poly([0], fun([], pid(tv(0))))),
  BF("mailbox_alloc_bounded_unowned", BRuntime, poly([0], fun([TyInt, TyInt], pid(tv(0))))),
  BF("spawn_actor_fiber",     BRuntime, poly([0, 1], fun([pid(tv(0)), tv(1)], nominal("Fiber", [TyUnit]))))
]

fn intrinsic_builtins() : [Builtin] = [
  # The canonical unit symbol of the argument, a string constant at emit time.
  BF("unit_name",         BIntrinsic, poly_unit([], fun([dim(TyReal)], TyString))),
  # Unit erasure and tagging, identity at runtime; the `__` prefix keeps them out of user code.
  BF("__strip_unit",      BIntrinsic, poly_unit([], fun([dim(TyReal)], TyReal))),
  BF("__attach_unit",     BIntrinsic, poly_unit([0], fun([tv(0)], dim(tv(0))))),
  BF("__detach_unit",     BIntrinsic, poly_unit([0], fun([dim(tv(0))], tv(0)))),
  # Each lowers to its C operator; `bit_shr` is arithmetic, `bit_ushr` logical.
  BF("bit_and",           BIntrinsic, int2()),
  BF("bit_or",            BIntrinsic, int2()),
  BF("bit_xor",           BIntrinsic, int2()),
  BF("bit_not",           BIntrinsic, mono(fun([TyInt], TyInt))),
  BF("bit_shl",           BIntrinsic, int2()),
  BF("bit_shr",           BIntrinsic, int2()),
  BF("bit_ushr",          BIntrinsic, int2()),
  BF("bit_count",         BIntrinsic, mono(fun([TyInt], TyInt))),
  BF("bit_test",          BIntrinsic, mono(fun([TyInt, TyInt], TyBool))),
  BF("bit_set",           BIntrinsic, int2()),
  BF("bit_clear",         BIntrinsic, int2()),
  BF("bit_toggle",        BIntrinsic, int2())
]

fn io_builtins() : [Builtin] = [
  # `exit` and `panic` never return: a polymorphic result unifies with any context.
  BF("panic",             BRuntime, poly([0], fun([TyString], tv(0)))),
  BF("exit",              BRuntime, poly([0], fun_e([TyInt], tv(0), [CeProcess])))
]

fn lowered_builtins() : [Builtin] = [
  # The backends lower these two to unboxed conversions.
  BF("int_to_real",       BRuntime, mono(fun([TyInt], TyReal))),
  BF("real_to_int",       BRuntime, mono(fun([TyReal], TyInt))),
  # The writers mutate their first argument in place and return it.
  BF("bytes_blit",        BRuntime, mono(fun_e([bytes(), TyInt, bytes(), TyInt, TyInt], bytes(), [CeMutable]))),
  BF("bytes_put_le",      BRuntime, mono(fun_e([bytes(), TyInt, TyInt, TyInt], bytes(), [CeMutable]))),
  BF("bytes_put_string",  BRuntime, mono(fun_e([bytes(), TyInt, TyString], bytes(), [CeMutable])))
]

#[doc("A scheme binding no variable.")]
fn mono(t: Ty) : BSig = BS([], [], [], t)
#[doc("A scheme binding the type variables `vs`.")]
pub fn poly(vs: [Int], t: Ty) : BSig = BS(vs, [], [], t)
#[doc("A scheme binding `vs` and unit variable 0.")]
fn poly_unit(vs: [Int], t: Ty) : BSig = BS(vs, [], [0], t)

#[doc("Type variable `n`.")]
fn tv(n: Int) : Ty = TyVarT(n)
#[doc("The list type over `t`.")]
pub fn lst(t: Ty) : Ty = TyListT(t)
#[doc("The core nominal type `name` applied to `args`.")]
pub fn nominal(name: String, args: [Ty]) : Ty = TyCon(core_type_sym_or_none(name), args)
#[doc("`Array[t]`.")]
pub fn arr(t: Ty) : Ty = nominal("Array", [t])
#[doc("`Vec[t]`.")]
pub fn vec(t: Ty) : Ty = nominal("Vec", [t])
#[doc("`Option[t]`.")]
pub fn opt(t: Ty) : Ty = nominal("Option", [t])
#[doc("`Result[ok, String]`.")]
pub fn res(ok: Ty) : Ty = nominal("Result", [ok, TyString])
#[doc("`Pid[t]`.")]
pub fn pid(t: Ty) : Ty = nominal("Pid", [t])
#[doc("`Array[Byte]`.")]
pub fn bytes() : Ty = arr(TyByte)
#[doc("`t` carrying unit variable 0.")]
pub fn dim(t: Ty) : Ty = TyDimT(t, UVar(0))

fn pure_row() : Row = Row { labels: [], tail: None, display_alias: None }
fn eff_row(effs: [CoreEffect]) : Row =
  Row { labels: map(effs, core_effect_label), tail: None, display_alias: None }

#[doc("A pure function type.")]
pub fn fun(ps: [Ty], r: Ty) : Ty = TyFnT(ps, r, pure_row())
#[doc("A function type raising the core effects `effs`.")]
fn fun_e(ps: [Ty], r: Ty, effs: [CoreEffect]) : Ty = TyFnT(ps, r, eff_row(effs))
#[doc("`(Int, Int) -> Int`.")]
fn int2() : BSig = mono(fun([TyInt, TyInt], TyInt))

#[doc("Where a builtin's calls go: the runtime entry `kai_core_<name>`, a runtime entry named explicitly, `kai_core_<name>` reached only by the pipe that lowers to it, or nowhere because the backends lower it in place.")]
pub(pkg) type BEntry = BRuntime | BRuntimeAs(String) | BRuntimeUnbound | BIntrinsic

#[doc("A builtin's type scheme: the bound type, row and unit variables, and the function type over them.")]
pub type BSig = BS([Int], [Int], [Int], Ty)

#[doc("A core builtin: its kaikai name, where its calls go, and its type scheme.")]
pub type Builtin = BF(String, BEntry, BSig)

#[doc("The C runtime entry a builtin's calls bind, or None for an intrinsic.")]
pub(pkg) fn builtin_cname(name: String, entry: BEntry) : Option[String] = match entry {
  BRuntime        -> Some(string_concat("kai_core_", name))
  BRuntimeAs(c)   -> Some(c)
  BRuntimeUnbound -> Some(string_concat("kai_core_", name))
  BIntrinsic      -> None
}

#[doc("True when a program's bare use of the builtin's name binds it.")]
pub(pkg) fn builtin_bound(entry: BEntry) : Bool = match entry {
  BRuntimeUnbound -> false
  _               -> true
}

#[doc("The number of arguments a builtin's scheme takes.")]
pub(pkg) fn bsig_arity(s: BSig) : Int = match s {
  BS(_, _, _, TyFnT(ps, _, _)) -> list_length(ps)
  BS(_, _, _, _)               -> 0
}

#[doc("The identifier an intrinsic is written with after the `$`.")]
pub(pkg) fn intrinsic_name(i: Intrinsic) : String = match i {
  InExternHandler -> "extern_handler"
  InCellInit      -> "__cell_init"
  InCellGet       -> "__cell_get"
  InCellSet       -> "__cell_set"
  InLoopWhile     -> "__loop_while"
  InLoopUntil     -> "__loop_until"
  InLoopRepeat    -> "__loop_repeat"
  InResumeFrame   -> "resume_frame"
  InResumeBad     -> "resume_bad"
  InSegHandle     -> "seg_handle"
  InSegRequest    -> "seg_request"
  InSegState      -> "seg_state"
  InAbsent        -> "__kai_absent"
  InCovHit(_)     -> "__cov_hit"
  InUnknown(n)    -> n
}

#[doc("The intrinsic an identifier after `$` denotes; `InUnknown` keeps a name that denotes none. The inverse of `intrinsic_name`, save for a coverage probe, which is never written.")]
pub(pkg) fn intrinsic_of_name(n: String) : Intrinsic = match n {
  "extern_handler" -> InExternHandler
  "__cell_init"    -> InCellInit
  "__cell_get"     -> InCellGet
  "__cell_set"     -> InCellSet
  "__loop_while"   -> InLoopWhile
  "__loop_until"   -> InLoopUntil
  "__loop_repeat"  -> InLoopRepeat
  "resume_frame"   -> InResumeFrame
  "resume_bad"     -> InResumeBad
  "seg_handle"     -> InSegHandle
  "seg_request"    -> InSegRequest
  "seg_state"      -> InSegState
  "__kai_absent"   -> InAbsent
  _                -> InUnknown(n)
}

#[doc("A declared core builtin: the declaring fn's identity and the runtime symbol its calls bind.")]
pub type KaiBuiltin = KB(FnId, String)

#[doc("The declared core builtins among the post-desugar decls `ds`.")]
pub(pkg) fn kai_builtins(ds: [Decl]) : [KaiBuiltin] = match ds {
  []           -> []
  [d, ...rest] -> match kai_builtin_of_decl(d) {
    Some(kb) -> [kb, ...kai_builtins(rest)]
    None     -> kai_builtins(rest)
  }
}

fn kai_builtin_of_decl(d: Decl) : Option[KaiBuiltin] = match d {
  DFn(_, fid, _, _, _, _, body, _, _, _) -> match body.kind {
    EExternBody(AbiKai, sym) -> Some(KB(fid, sym))
    _                        -> None
  }
  DDoc(_, _, inner, _, _) -> kai_builtin_of_decl(inner)
  DAttr(_, inner, _, _)   -> kai_builtin_of_decl(inner)
  _                       -> None
}

# A declaration shadows the row it is spelled like, so the name stops being
# a builtin every file sees bare and resolves to the declaration instead.
#[doc("The builtin names `names` less the ones the post-desugar decls `ds` declare with `extern \"kai\"`; `tab` holds those declarations.")]
pub(pkg) fn kai_unshadowed(names: [String], ds: [Decl], tab: SymTab) : [String] = match kai_builtins(ds) {
  []  -> names
  kbs -> {
    let declared = map(kbs, (kb) => kai_builtin_name(tab, kb))
    filter(names, (n) => not list_has(declared, n))
  }
}


#[doc("True when the declared builtin `kb` binds a `kai_core_` runtime entry, whose value thunk the runtime defines: its declaration emits no fn and no thunk.")]
pub(pkg) fn kai_builtin_has_runtime_thunk(kb: KaiBuiltin) : Bool = match kb { KB(_, sym) -> starts_with(sym, "kai_core_") }

#[doc("True when `d` declares a builtin that rides the runtime's own value thunk.")]
pub(pkg) fn decl_is_runtime_thunk_builtin(d: Decl) : Bool = match kai_builtin_of_decl(d) {
  Some(kb) -> kai_builtin_has_runtime_thunk(kb)
  None     -> false
}

#[doc("True when the symbol `s` is a fn of `kbs`.")]
pub(pkg) fn kai_builtin_declares(kbs: [KaiBuiltin], s: SymId) : Bool = match kbs {
  []            -> false
  [kb, ...rest] -> match kb {
    KB(f, _) -> if sym_raw(fnid_sym(f)) == sym_raw(s) { true } else { kai_builtin_declares(rest, s) }
  }
}

#[doc("The runtime symbol a C-backend call to the declared builtin binds.")]
pub(pkg) fn kai_builtin_csym(kb: KaiBuiltin) : String = match kb { KB(_, sym) -> sym }

#[doc("A declared builtin with a raw entry `<symbol>_raw`: its runtime symbol, one character per param (`i` an Int crossing unboxed, `b` a boxed value the entry only reads) and the result character (`i`).")]
pub type RawEntry = RE(String, String, String)

#[doc("The declared builtins that have a raw entry.")]
pub(pkg) fn core_raw_table() : [RawEntry] = [
  RE("kai_core_string_byte_at_int", "bi", "i"),
  RE("kai_core_string_length", "b", "i")
]

#[doc("The runtime symbols of the declared builtins that have a raw entry.")]
pub(pkg) fn core_raw_entries() : [String] = map(core_raw_table(), (r) => match r { RE(sym, _, _) -> sym })

#[doc("The raw entry the native symbol `sym` (`kaix_core_<name>_raw`) binds, or None for any other symbol.")]
pub(pkg) fn core_raw_native(sym: String) : Option[RawEntry] = raw_native_in(core_raw_table(), sym)

fn raw_native_in(rows: [RawEntry], sym: String) : Option[RawEntry] = match rows {
  []           -> None
  [r, ...rest] -> match r {
    RE(c, _, _) -> if cat3("kaix_core_", string_slice(c, 9, string_length(c) - 9), "_raw") == sym { Some(r) } else { raw_native_in(rest, sym) }
  }
}

#[doc("True when the declared builtin `kb` has a raw entry.")]
pub(pkg) fn kai_builtin_has_raw(kb: KaiBuiltin) : Bool = list_has(core_raw_entries(), kai_builtin_csym(kb))

#[doc("The kaikai name of the declared builtin, which keys its native entry `kaix_core_<name>`.")]
fn kai_builtin_name(tab: SymTab, kb: KaiBuiltin) : String = match kb { KB(f, _) -> written_text(decl_name(tab, fnid_sym(f))) }
