#[doc("""
The core builtins: every name, runtime entry and type the compiler gives a
program before it declares anything.

The resolver's core names, the typer's seed and the backends' registry all
derive from `builtin_table`, so adding a builtin is one row plus its runtime
forwarders, which `tools/builtin-table-gate.sh` checks against the rows.
""")]

import compiler.builtin_types
import compiler.builtins_sys
import compiler.builtins_text
import compiler.builtins_heap

#[doc("Every core builtin, in registry order.")]
pub fn builtin_table() : [Builtin] =
  list_append(io_builtins(), list_append(real_builtins(), list_append(list_builtins(),
  list_append(fs_builtins(), list_append(text_builtins(), list_append(num_builtins(),
  list_append(collection_builtins(), list_append(mailbox_builtins(), intrinsic_builtins()))))))))
