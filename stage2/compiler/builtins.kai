  BF("int_to_string",     BRuntime, mono(fun([TyInt], TyString))),
  BF("real_to_string",    BRuntime, mono(fun([TyReal], TyString))),
  BF("int_to_real",       BRuntime, mono(fun([TyInt], TyReal))),
  BF("real_to_int",       BRuntime, mono(fun([TyReal], TyInt))),
  BF("real_sqrt",         BRuntime, real1()),
  BF("real_cbrt",         BRuntime, real1()),
  BF("real_exp",          BRuntime, real1()),
  BF("real_log",          BRuntime, real1()),
  BF("real_log2",         BRuntime, real1()),
  BF("real_log10",        BRuntime, real1()),
  BF("real_sin",          BRuntime, real1()),
  BF("real_cos",          BRuntime, real1()),
  BF("real_tan",          BRuntime, real1()),
  BF("real_asin",         BRuntime, real1()),
  BF("real_acos",         BRuntime, real1()),
  BF("real_atan",         BRuntime, real1()),
  BF("real_sinh",         BRuntime, real1()),
  BF("real_cosh",         BRuntime, real1()),
  BF("real_tanh",         BRuntime, real1()),
  BF("real_signum",       BRuntime, real1()),
  BF("real_is_nan",       BRuntime, mono(fun([TyReal], TyBool))),
  BF("real_is_inf",       BRuntime, mono(fun([TyReal], TyBool))),
  BF("real_pow",          BRuntime, real2()),
  BF("real_atan2",        BRuntime, real2()),
  BF("real_rem",          BRuntime, real2())
]

fn fs_builtins() : [Builtin] = [
  BF("args",              BRuntime, mono(fun_e([], lst(TyString), [CeEnv]))),
  # argv[0] is a pure read of a process-wide constant, so it carries no effect.
  BF("program_name",      BRuntime, mono(fun([], TyString))),
  # A stdlib wrapper spelled like the builtin it forwards to shadows it,
  # so this second spelling is the way in.
  BF("core_program_name", BRuntimeAs("kai_core_program_name"), mono(fun([], TyString))),
  BF("stdlib_path",       BRuntime, mono(fun([], TyString))),
  BF("abspath",           BRuntime, mono(fun([TyString], TyString))),
  BF("read_file",         BRuntime, mono(fun_e([TyString], res(TyString), [CeFile]))),
  BF("write_file",        BRuntime, mono(fun_e([TyString, TyString], res(TyUnit), [CeFile]))),
  BF("file_append",       BRuntime, mono(fun_e([TyString, TyString], res(TyUnit), [CeFile]))),
  BF("file_exists",       BRuntime, mono(fun_e([TyString], TyBool, [CeFile]))),
  BF("file_delete",       BRuntime, mono(fun_e([TyString], res(TyUnit), [CeFile]))),
  BF("file_rename",       BRuntime, mono(fun_e([TyString, TyString], res(TyUnit), [CeFile]))),
  BF("file_read_bytes",   BRuntime, mono(fun_e([TyString], res(bytes()), [CeFile]))),
  BF("file_write_bytes",  BRuntime, mono(fun_e([TyString, bytes()], res(TyUnit), [CeFile]))),
  BF("dir_list_dir",      BRuntime, mono(fun_e([TyString], lst(TyString), [CeFile]))),
  BF("dir_create_dir",    BRuntime, mono(fun_e([TyString], res(TyUnit), [CeFile]))),
  BF("dir_remove_dir",    BRuntime, mono(fun_e([TyString], res(TyUnit), [CeFile]))),
  BF("dir_walk",          BRuntime, mono(fun_e([TyString], lst(TyString), [CeFile]))),
  BF("read_line",         BRuntime, mono(fun_e([], res(TyString), [CeStdin]))),
  # A short read is end of stream: no Result wrapper.
  BF("read_bytes",        BRuntime, mono(fun_e([TyInt], TyString, [CeStdin])))
]

fn list_builtins() : [Builtin] = [
  BF("string_length",     BRuntime, mono(fun([TyString], TyInt))),
  BF("string_concat",     BRuntime, mono(fun([TyString, TyString], TyString))),
  BF("string_concat_all", BRuntime, mono(fun([lst(TyString)], TyString))),
  BF("string_join",       BRuntime, mono(fun([lst(TyString), TyString], TyString))),
  BF("list_length",       BRuntime, poly([0], fun([lst(tv(0))], TyInt))),
  BF("list_append",       BRuntime, poly([0], fun([lst(tv(0)), lst(tv(0))], lst(tv(0))))),
  BF("list_reverse",      BRuntime, poly([0], fun([lst(tv(0))], lst(tv(0))))),
  BF("map",               BRuntime, poly_row([0, 1], combinator([lst(tv(0))], [tv(0)], tv(1), lst(tv(1))))),
  # Backs the `||` pipe over a bare list; a bare `flat_map` names core's `list.flat_map`.
  BF("flat_map",          BRuntimeUnbound, poly_row([0, 1], combinator([lst(tv(0))], [tv(0)], lst(tv(1)), lst(tv(1))))),
  BF("__deep_apply1",     BRuntime, poly_row([0, 1], combinator([tv(0)], [tv(0)], tv(1), tv(1)))),
  BF("__deep_apply2",     BRuntime, poly_row([0, 1, 2], combinator([tv(0), tv(1)], [tv(0), tv(1)], tv(2), tv(2)))),
  BF("filter",            BRuntime, poly_row([0], combinator([lst(tv(0))], [tv(0)], TyBool, lst(tv(0))))),
  BF("reduce",            BRuntime, poly_row([0, 1], combinator([lst(tv(0)), tv(1)], [tv(1), tv(0)], tv(1), tv(1)))),
  BF("each",              BRuntime, poly_row([0], combinator([lst(tv(0))], [tv(0)], TyUnit, TyUnit)))
]

fn text_builtins() : [Builtin] = [
  BF("string_to_int",     BRuntime, mono(fun([TyString], opt(TyInt)))),
  BF("string_to_real",    BRuntime, mono(fun([TyString], opt(TyReal)))),
  BF("char_at",           BRuntime, mono(fun([TyString, TyInt], opt(TyChar)))),
  BF("string_split",      BRuntime, mono(fun([TyString, TyString], lst(TyString)))),
  BF("string_contains",   BRuntime, mono(fun([TyString, TyString], TyBool))),
  BF("string_slice",      BRuntime, mono(fun([TyString, TyInt, TyInt], TyString))),
  BF("char_to_int",       BRuntime, mono(fun([TyChar], TyInt))),
  BF("int_to_char",       BRuntime, mono(fun([TyInt], TyChar))),
  # Every byte value 0..255 round-trips: no `Show for Char` escaping.
  BF("int_to_byte_string", BRuntime, mono(fun([TyInt], TyString))),
  # The byte at an offset as 0..255, or -1 out of bounds.
  BF("string_byte_at_int", BRuntime, mono(fun([TyString, TyInt], TyInt))),
  # The codepoint at a byte offset (-1 out of bounds) and its width (0 out of bounds).
  BF("string_cp_at",      BRuntime, mono(fun([TyString, TyInt], TyInt))),
  BF("string_cp_len",     BRuntime, mono(fun([TyString, TyInt], TyInt))),
  BF("string_reverse",    BRuntime, mono(fun([TyString], TyString))),
  BF("string_hash",       BRuntime, mono(fun([TyString], TyInt))),
  BF("int_to_le4",        BRuntime, mono(fun([TyInt], TyString))),
  BF("int_to_le8",        BRuntime, mono(fun([TyInt], TyString))),
  BF("real_bits",         BRuntime, mono(fun([TyReal], TyInt))),
  # The writers mutate their first argument in place and return it.
  BF("bytes_blit",        BRuntime, mono(fun_e([bytes(), TyInt, bytes(), TyInt, TyInt], bytes(), [CeMutable]))),
  BF("bytes_put_le",      BRuntime, mono(fun_e([bytes(), TyInt, TyInt, TyInt], bytes(), [CeMutable]))),
  BF("bytes_get_le",      BRuntime, mono(fun([bytes(), TyInt, TyInt], TyInt))),
  BF("bytes_put_string",  BRuntime, mono(fun_e([bytes(), TyInt, TyString], bytes(), [CeMutable]))),
  BF("bytes_get_string",  BRuntime, mono(fun([bytes(), TyInt, TyInt], TyString)))
]

