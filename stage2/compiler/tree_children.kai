#[doc("""
The one exhaustive enumeration of the children of a pattern and of a resolved type.

`xp_positions` does the same for expressions. A walker over patterns or types
asks `pat_kids` / `ty_kids` and keeps explicit arms only for the variants it
treats specially, so a variant added to `PatKind` or `Ty` is a compile error
here, once.
""")]

import compiler.ast
import compiler.ast_ids

#[doc("The sub-patterns of `p`, in source order.")]
pub(pkg) fn pat_kids(p: Pattern) : [Pattern] = match p.pkind {
  PWild -> []
  PLit(_) -> []
  PRange(_, _) -> []
  PBind(_) -> []
  PList(subs, _) -> subs
  PVariant(_, subs) -> subs
  PVariantRecord(_, fs) -> pfield_pats(fs)
  PRecord(_, fs) -> pfield_pats(fs)
  PHole(_) -> []
  PAs(_, inner) -> [inner]
  PSurface(sf) -> psurface_kids(sf)
  PNarrow(_, _) -> []
}

fn psurface_kids(sf: PatSurface) : [Pattern] = match sf {
  PsTuple(ps) -> ps
  PsQualified(_, inner) -> [inner]
  PsAs(_, inner) -> [inner]
  PsRefine(_, _) -> []
  PsAnonRest(ps, _) -> ps
}

fn pfield_pats(fs: [PField]) : [Pattern] = match fs {
  [] -> []
  [PField(_, sub, _), ...rest] -> [sub, ...pfield_pats(rest)]
}

#[doc("The expressions `p` itself carries (literal and range bounds), not those of its sub-patterns.")]
pub(pkg) fn pat_exprs(p: Pattern) : [Expr] = match p.pkind {
  PLit(e) -> [e]
  PRange(lo, hi) -> [lo, hi]
  PWild -> []
  PBind(_) -> []
  PList(_, _) -> []
  PVariant(_, _) -> []
  PVariantRecord(_, _) -> []
  PRecord(_, _) -> []
  PHole(_) -> []
  PAs(_, _) -> []
  PSurface(_) -> []
  PNarrow(_, _) -> []
}

#[doc("The binders `p` itself introduces, not those of its sub-patterns.")]
pub(pkg) fn pat_binders(p: Pattern) : [Binder] = match p.pkind {
  PBind(b) -> [b]
  PList(_, Some(rest)) -> [rest]
  PList(_, None) -> []
  PAs(b, _) -> [b]
  PNarrow(b, _) -> [b]
  PWild -> []
  PLit(_) -> []
  PRange(_, _) -> []
  PVariant(_, _) -> []
  PVariantRecord(_, _) -> []
  PRecord(_, _) -> []
  PHole(_) -> []
  PSurface(_) -> []
}

#[doc("True when `f` holds for `p` or a pattern below it.")]
pub(pkg) fn pat_exists(p: Pattern, f: (Pattern) -> Bool) : Bool =
  f(p) or pats_exist(pat_kids(p), f)

#[doc("True when `f` holds for one of `ps` or a pattern below it.")]
pub(pkg) fn pats_exist(ps: [Pattern], f: (Pattern) -> Bool) : Bool = match ps {
  [] -> false
  [h, ...rest] -> pat_exists(h, f) or pats_exist(rest, f)
}

#[doc("The types directly inside `t`, in source order: arguments, parameters, result and the arguments of the row labels.")]
pub(pkg) fn ty_kids(t: Ty) : [Ty] = match t {
  TyInt -> []
  TyReal -> []
  TyBool -> []
  TyString -> []
  TyChar -> []
  TyUnit -> []
  TyByte -> []
  TyInt32 -> []
  TyUInt32 -> []
  TyUInt64 -> []
  TyInt128 -> []
  TyHandle -> []
  TyListT(x) -> [x]
  TyFnT(ps, r, row) -> list_append(ps, [r, ...label_args(row.labels)])
  TyCon(_, args) -> args
  TyVarT(_) -> []
  TyAny -> []
  TyDimT(x, _) -> [x]
  TyRefineT(x, _, _) -> [x]
  TyUnion(ts) -> ts
  TyShapeApp(_, x) -> [x]
  TyNothing -> []
}

fn label_args(ls: [Label]) : [Ty] = flat_map(ls, .ty_args)

#[doc("True when `f` holds for `t` or a type below it.")]
pub(pkg) fn ty_exists(t: Ty, f: (Ty) -> Bool) : Bool = f(t) or tys_exist(ty_kids(t), f)

#[doc("True when `f` holds for one of `ts` or a type below it.")]
pub(pkg) fn tys_exist(ts: [Ty], f: (Ty) -> Bool) : Bool = match ts {
  [] -> false
  [h, ...rest] -> ty_exists(h, f) or tys_exist(rest, f)
}
