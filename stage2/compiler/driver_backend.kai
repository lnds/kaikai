pub(pkg) type NativeKir = { kp: KProgram, nfns: [EFn], nvariants: [VariantEntry] }

fn native_kir(req: Req, cx: PerceusRun) : NativeKir / Console + File + Mutable {
  let bmode = cx.unboxrun.bmode
  let emit_tab = cx.monoed.emit_tab
  let entry = entry_id(root_module_name(req.path), runs_blocks(req.mode))
  let perceus_decls = cx.perceusrun.perceus_decls
  let proto_reg = cx.checked.proto_reg
  let raw_arm_binders = cx.unboxrun.raw_arm_binders
  let specs = cx.monoed.specs
  let stamp_ids = cx.stamprun.stamp_ids
  let target_mod_name = root_module_name(req.path)
  let nfns = register_fn_decls(perceus_decls, emit_tab, specs, entry)
  let nvariants = register_variants(perceus_decls, emit_tab)
  let kp = kir_lin_hook(
    ncore_prune_unreachable(
      kir_tail_program(
        kir_inline_program(
          lower_to_kir(
            perceus_decls,
            emit_tab,
            specs,
            proto_reg.ids,
            nfns,
            nvariants,
            Some(target_mod_name),
            raw_arm_binders,
            true,
            stamp_ids,
            entry
          )
        ),
        target_mod_name
      ),
      perceus_decls,
      nfns,
      bmode,
      core_mod_names(req.core_mods, [])
    ),
    req.kir_verify
  )
  NativeKir { kp: kp, nfns: nfns, nvariants: nvariants }
}

#[doc("""
The core object of a program typed against the whole core, stored in the
cache before the program is cut; none when this run does not store one.
""")]
pub(pkg) fn native_core_stored(
  req: Req,
  cx: PerceusRun
) : Option[String] / Console + File + Mutable {
  let core_cache = req.core_cache
  let nsrcs = cx.cutrun.nsrcs
  if cx.unboxrun.use_native
    and (not cx.inferrun.pruned)
    and core_settles(req.mode, req.backend, core_cache, cx.solved.core_hit)
    and nsrcs != "" {
    let nk = native_kir(req, cx)
    let obj_path = native_object_in(core_cache.nmod_dir, req.path)
    build_native_core_stored(
      nk.kp,
      cx.perceusrun.perceus_decls,
      nk.nvariants,
      nk.nfns,
      cx.unboxrun.bmode,
      obj_path,
      req.path,
      NCoreCfg {
        dir: core_cache.dir,
        toolchain: core_cache.toolchain,
        edition: edition_key_text(req.edition),
        tag: llvm_backend_tag(),
        srcs_hex: nsrcs,
        stats: core_cache.stats,
        pre: cx.cutrun.npre
      },
      core_mod_names(req.core_mods, [])
    )
  } else {
    None
  }
}

#[doc("""
The program cut against the core object just stored, as the compile of a
later build with that object in the cache starts from it: its decls are
the ones the program reaches, so a build's output does not depend on the
cache holding the object beforehand. None when no object was stored or
the cut leaves a reference behind.
""")]
pub(pkg) fn stage_settle(
  req: Req,
  mn: Monoed,
  cx: PerceusRun
) : Option[Monoed] / Console + File + Mutable =
  and_then(native_core_stored(req, cx), co => settled_cut(req, mn, co))

fn settled_cut(req: Req, mn: Monoed, co: String) : Option[Monoed] / Console =
  match core_typed_cut(
    mn.monoed.mono_decls,
    core_mod_names(req.core_mods, []),
    mn.checked.proto_reg,
    []
  ) {
    TypedCut(ds, []) -> Some(Monoed {
      ...mn,
      solved: SolvedOut { ...mn.solved, core_hit: Some(co) },
      inferrun: InferRunOut { ...mn.inferrun, pruned: true },
      monoed: MonoedOut { ...mn.monoed, tcut: TypedCut(ds, []), mono_decls: ds }
    })
    TypedCut(_, _) -> None
  }

pub(pkg) fn emit_native(req: Req, cx: PerceusRun) : Int / Console + File + Mutable {
  let bmode = cx.unboxrun.bmode
  let core_cache = req.core_cache
  let core_hit = cx.solved.core_hit
  let core_mods = req.core_mods
  let edition = req.edition
  let npre = cx.cutrun.npre
  let nsrcs = cx.cutrun.nsrcs
  let path = req.path
  let perceus_decls = cx.perceusrun.perceus_decls
  let pruned = cx.inferrun.pruned
  # In-process libLLVM native backend. Lower to
  # KIR (same preamble as the KIR dumper: the decls
  # are post-perceus / post-tcrec; only the
  # symbol/variant tables are rebuilt), build the
  # module via the C API in memory, and emit a
  # native object. The output path is `<source>.o`;
  # the `bin/kai` wrapper (or the test harness)
  # links it against the effects runtime to the
  # final executable.
  let ncore_names = core_mod_names(core_mods, [])
  let nk = native_kir(req, cx)
  let kp = nk.kp
  let nfns = nk.nfns
  let nvariants = nk.nvariants
  let obj_path = native_object_in(core_cache.nmod_dir, path)
  # Core-object split: with the shared core cache
  # available (dir + toolchain id) and a backend tag
  # that allows it (libLLVM present, not a debug
  # build), emit user + core as two raw objects and
  # reuse the content-addressed core object across
  # builds. Any missing ingredient falls back to the
  # whole-program single object. One path per line on
  # stdout; the wrapper links every listed object.
  # llvm_backend_tag() is called at each use, never
  # bound to a shared let: the ownership pass
  # mis-counts a let consumed in this condition and
  # reused in the branch below, so the record would
  # capture a freed (empty) tag and every backend-tag
  # component (triple, opt level, bitcode ids) would
  # silently drop out of the core-object key.
  native_single_emit(
    kp,
    perceus_decls,
    nvariants,
    nfns,
    bmode,
    obj_path,
    path,
    ncore_names,
    if pruned { core_hit } else { None },
    NCoreCfg {
      dir: core_cache.dir,
      toolchain: core_cache.toolchain,
      edition: edition_key_text(edition),
      tag: llvm_backend_tag(),
      srcs_hex: nsrcs,
      stats: core_cache.stats,
      pre: npre
    }
  )
}

pub(pkg) fn emit_native_modular(req: Req, cx: PerceusRun) : Int / Console + File + Mutable {
  let bmode = cx.unboxrun.bmode
  let core_cache = req.core_cache
  let core_mods = req.core_mods
  let emit_tab = cx.monoed.emit_tab
  let entry = entry_id(root_module_name(req.path), runs_blocks(req.mode))
  let kir_verify = req.kir_verify
  let path = req.path
  let perceus_decls = cx.perceusrun.perceus_decls
  let proto_reg = cx.checked.proto_reg
  let raw_arm_binders = cx.unboxrun.raw_arm_binders
  let specs = cx.monoed.specs
  let stamp_ids = cx.stamprun.stamp_ids
  let target_mod_name = root_module_name(req.path)
  # Native separate compilation: partition the KIR by
  # `KFn.mo` into N content-addressed objects, reused by
  # any build that projects the same partition, and print
  # one object path per line for the wrapper to link.
  let nfns = register_fn_decls(perceus_decls, emit_tab, specs, entry)
  let nvariants = register_variants(perceus_decls, emit_tab)
  let kp = kir_lin_hook(
    ncore_prune_unreachable(
      kir_tail_program(
        kir_inline_program(
          lower_to_kir(
            perceus_decls,
            emit_tab,
            specs,
            proto_reg.ids,
            nfns,
            nvariants,
            Some(target_mod_name),
            raw_arm_binders,
            true,
            stamp_ids,
            entry
          )
        ),
        target_mod_name
      ),
      perceus_decls,
      nfns,
      bmode,
      core_mod_names(core_mods, [])
    ),
    kir_verify
  )
  let obj_dir = if core_cache.nmod_dir == "" { dir_of(path) } else { core_cache.nmod_dir }
  let objs = build_native_modular(
    kp,
    perceus_decls,
    nvariants,
    nfns,
    bmode,
    dir_of(path),
    Some(obj_dir),
    path,
    ck_compose([
      core_cache.toolchain,
      edition_key_text(req.edition),
      llvm_backend_tag(),
      core_cache.object_env
    ])
  )
  match objs {
    [] -> 1
    _ -> {
      print(string_join(objs, "\n"))
      0
    }
  }
}

pub(pkg) fn emit_c(req: Req, cx: PerceusRun) : Int / Console + File + Mutable {
  let batch_out = req.batch_out
  let bmode = cx.unboxrun.bmode
  let emit_tab = cx.monoed.emit_tab
  let entry = entry_id(root_module_name(req.path), runs_blocks(req.mode))
  let kir_inline_on = cx.unboxrun.kir_inline_on
  let perceus_decls = cx.perceusrun.perceus_decls
  let proto_reg = cx.checked.proto_reg
  let raw_arm_binders = cx.unboxrun.raw_arm_binders
  let specs = cx.monoed.specs
  let stamp_ids = cx.stamprun.stamp_ids
  let target_mod_name = root_module_name(req.path)
  let use_kir = cx.unboxrun.use_kir
  let out = if use_kir {
    emit_kir(perceus_decls, emit_tab, specs, kir_inline_on, stamp_ids, entry)
  } else {
    let nfns = register_fn_decls(perceus_decls, emit_tab, specs, entry)
    let nvariants = register_variants(perceus_decls, emit_tab)
    let lowered = lower_to_kir(
      perceus_decls,
      emit_tab,
      specs,
      proto_reg.ids,
      nfns,
      nvariants,
      Some(target_mod_name),
      raw_arm_binders,
      false,
      stamp_ids,
      entry
    )
    let kp = ncore_prune_unreachable(
      kir_tail_program(kir_inline_program(lowered), target_mod_name),
      perceus_decls,
      nfns,
      bmode,
      []
    )
    let ps = KcFnPrinters { def: kc_fn_def, proto: kc_fn_proto, thunk: kc_fn_thunk }
    if cx.unboxrun.use_modular {
      kc_modular_stream(
        kc_program_modular(kp, ps, bmode, perceus_decls, nfns, nvariants),
        cat2("k748x", int_to_string(string_length(req.src)))
      )
    } else {
      kc_program(kp, ps, bmode, perceus_decls, nfns, nvariants, cx.unboxrun.use_owner)
    }
  }
  match batch_out {
    Some(op) -> match __file_write(op, cat2(out, "\n")) {
      Ok(_) -> 0
      Err(e) -> {
        eprint("kaic2: cannot write `#{op}`: #{e}")
        1
      }
    }
    None -> {
      print(out)
      0
    }
  }
}
