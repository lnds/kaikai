#[doc("""Machine-readable typed-hole and effect reports for the typer driver.

Emits the `--holes-json`, `--holes-json-scope`, `--effects-json` and
`--effect-holes-json` payloads over an already-typed program, plus the
`--strict-holes` gate. Schema is stable per `docs/typed-holes.md`.
""")]

import compiler.util
import compiler.diag
import compiler.diag_file
import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.infer_env_exhaust
import compiler.infer_handle_walk
import compiler.diag_type_text
import compiler.infer_program
import compiler.infer_dump
import compiler.hole_scope
import compiler.doc_attr
import compiler.written
import compiler.symtab
import compiler.expr_positions
import compiler.type_text

# ---- `--holes-json`: machine-readable hole reports ----
#
# Emits a single JSON array, stable schema per docs/typed-holes.md.
# Each element carries {file, line, col, name, expected_type, in_scope,
# candidates, candidates_needing_effects, scope_elided}. By default `in_scope` lists the hole's
# LOCAL bindings (params + lets) and `scope_elided` counts the
# reachable bindings not listed; `--holes-json-scope` lists everything
# (core included) with `scope_elided: 0`.

fn json_scope_entry(tab: SymTab, te: TyEntry) : String =
  concat_all([
    "{\"name\": ", json_str(env_key_text(tab, te.key)),
    ", \"type\": ", json_str(scheme_to_string(tab, te.scheme)), "}"
  ])

fn json_scope_entries(tab: SymTab, es: [TyEntry]) : String =
  concat_all(["[", inf_join_with(map(es, (te) => json_scope_entry(tab, te)), ", "), "]"])

fn json_candidate(expr: String) : String =
  concat_all(["{\"expr\": ", json_str(expr), ", \"kind\": \"synth\"}"])

fn json_candidates(cs: [String]) : String =
  concat_all(["[", inf_join_with(map(cs, json_candidate), ", "), "]"])

fn json_eff_candidate(c: EffCand) : String =
  concat_all(["{\"expr\": ", json_str(c.expr), ", \"kind\": \"synth\", \"effects\": [",
              inf_join_with(map(c.effects, json_str), ", "), "]}"])

fn json_eff_candidates(cs: [EffCand]) : String =
  concat_all(["[", inf_join_with(map(cs, json_eff_candidate), ", "), "]"])

fn json_hole_report(file: String, doc_items: [DocItem], rh: ResolvedHole, tp: TypedProgram, tab: SymTab,
                    hidden: [SymId], full: Bool) : String {
  match rh {
    RH(kind, line, col, ty, scope, env_fresh, owner, hr) -> {
      let toplevel_len = tp.toplevel_len
      let kj = hole_kind_json(kind)
      let visible = hole_visible_scope(tab, scope, toplevel_len, hidden)
      let shown = if full { visible } else { hole_local_scope(tab, scope, toplevel_len) }
      let elided = list_length(visible) - list_length(shown)
      let cands = synth_candidates(tab, visible, ty, env_fresh, owner, hr, tp.decls)
      # the surrounding declaration's `#[doc(...)]` text,
      # resolved by source position against the root file's doc side
      # table. null when the surrounding decl is undocumented.
      let doc_field = match doc_for_line(doc_items, line) {
        Some(s) -> json_str(s)
        None    -> json_null()
      }
      concat_all([
        "{",
        "\"file\": ", json_str(file),
        ", \"line\": ", int_to_string(line),
        ", \"col\": ", int_to_string(col),
        ", \"kind\": ", kj.kind,
        ", \"name\": ", kj.name,
        ", \"message\": ", kj.message,
        ", \"remaining\": ", kj.remaining,
        ", \"expected_type\": ", json_str(inf_ty_to_string(tab, ty)),
        ", \"in_scope\": ", json_scope_entries(tab, shown),
        ", \"scope_elided\": ", int_to_string(elided),
        ", \"candidates\": ", json_candidates(cands.fit),
        ", \"candidates_needing_effects\": ", json_eff_candidates(cands.needs),
        ", \"doc\": ", doc_field,
        "}"
      ])
    }
  }
}

# Triple of JSON fields derived from a HoleKind: the discriminator
# string, the optional `name` payload (only `?name` populates it),
# and the optional `message` payload (only `todo!(msg)` populates).
type HoleKindJson = { kind: String, name: String, message: String, remaining: String }

fn hole_kind_json(k: HoleKind) : HoleKindJson {
  match k {
    HKHole(nm_opt) -> {
      let nm_field = match nm_opt {
        Some(nm) -> json_str(nm)
        None     -> json_null()
      }
      HoleKindJson { kind: json_str("hole"), name: nm_field, message: json_null(), remaining: json_null() }
    }
    HKTodo(msg) ->
      HoleKindJson { kind: json_str("todo"), name: json_null(), message: json_str(msg), remaining: json_null() }
    HKPattern(nm_opt, rem) -> {
      let nm_field = match nm_opt {
        Some(nm) -> json_str(nm)
        None     -> json_null()
      }
      let rem_field = match rem {
        Some(ws) -> concat_all(["[", inf_join_with(map(ws, json_str), ", "), "]"])
        None     -> json_null()
      }
      HoleKindJson { kind: json_str("pattern"), name: nm_field, message: json_null(), remaining: rem_field }
    }
  }
}

#[doc("infer: --holes-json structured typed-hole report over the build front-end's typed program. `tab` names the program's declarations; doc_items is the root file's doc side table; `hidden` holds the top-level declarations the root file cannot reach; `full` lists every reachable binding instead of the hole's locals.")]
pub(pkg) fn dump_holes_json(file: String, tp: TypedProgram, tab: SymTab, doc_items: [DocItem], hidden: [SymId], full: Bool) : Int / Console + File {
  let body = inf_join_with(map(tp.holes, (h) => json_hole_report(file, doc_items, h, tp, tab, hidden, full)), ", ")
  print(concat_all(["[", body, "]"]))
  tp.errs
}

# ---- `--effects-json`: per-fn effect graph as data ----
#
# Schema (stable):
#   [{"file": String, "fn": String, "line": Int, "col": Int,
#     "effects": [String], "row_open": Bool,
#     "handlers_installed": [{"effect": String, "line": Int, "col": Int}]}]
#
# `effects` is the function's row (what a caller must handle); `row_open`
# marks a row polymorphic in further effects. Every function the
# compilation sees is reported, auto-loaded core included; `file` is the
# one declaring it, so a consumer filters on it.

#[doc("infer: --effects-json structured effect-row report over the build front-end's typed program; `tab` names its declarations, `df` attributes each function to its file.")]
pub(pkg) fn dump_effects_json(df: DiagFiles, tp: TypedProgram, tab: SymTab) : Int / Console + File {
  let entries = effects_walk_decls(tp.decls, tab, df, [])
  let body = inf_join_with(map(entries, effects_json_entry), ", ")
  print(concat_all(["[", body, "]"]))
  tp.errs
}

# ---- `--effect-holes-json`: typed effect-hole resolutions as data ----
#
# For each `?` or `?name` that appeared in a row tail position, emit
# what the inferencer resolved it to. Consumers (LLMs, IDEs, the
# author themselves) read this to know which effect row goes where
# the hole was written.
#
# Schema (stable):
#   [{
#     "file": String, "fn": String,
#     "line": Int, "col": Int,
#     "name": String | null,        # `?e` → "e"; bare `?` → null
#     "labels": [String],           # resolved effect labels (sorted)
#     "open": Bool,                 # true if the tail is still a free row var
#     "tail_var": String | null     # "?eN" id when open, else null
#   }]
#[doc("infer: structured effect-hole report over the build front-end's typed program; `tab` names its declarations.")]
pub(pkg) fn dump_effect_holes_json(file: String, tp: TypedProgram, tab: SymTab) : Int / Console + File {

  let body = inf_join_with(map(tp.row_holes, (rh) => json_row_hole_report(file, tab, rh)), ", ")
  print(concat_all(["[", body, "]"]))
  tp.errs
}

fn json_row_hole_report(file: String, tab: SymTab, rrh: ResolvedRowHole) : String {
  match rrh {
    RRH(nm_opt, line, col, fn_sym, row, body_labels) -> {
      let name_field = match nm_opt {
        Some(n) -> json_str(n)
        None    -> json_null()
      }
      let label_strs = map(row.labels, (l) => json_str(written_text(decl_name(tab, l.sym))))
      let labels_field = concat_all(["[", inf_join_with(label_strs, ", "), "]"])
      let body_strs = map(body_labels, (s) => json_str(written_text(decl_name(tab, s))))
      let body_field = concat_all(["[", inf_join_with(body_strs, ", "), "]"])
      let open = match row.tail { Some(_) -> true None -> false }
      let tail_field = match row.tail {
        Some(v) -> json_str(concat_all(["?e", int_to_string(v)]))
        None    -> json_null()
      }
      concat_all([
        "{",
        "\"file\": ", json_str(file),
        ", \"fn\": ", json_str(written_text(decl_name(tab, fn_sym))),
        ", \"line\": ", int_to_string(line),
        ", \"col\": ", int_to_string(col),
        ", \"name\": ", name_field,
        ", \"labels\": ", labels_field,
        ", \"open\": ", if open { "true" } else { "false" },
        ", \"tail_var\": ", tail_field,
        ", \"body_row\": ", body_field,
        "}"
      ])
    }
  }
}
fn strict_hole_diag(file: String, tab: SymTab, h: ResolvedHole) : Diagnostic / Console + File = match h {
  RH(kind, line, col, ty, _, _, _, _) -> {
    let label = hole_kind_label(kind)
    let ty_s = inf_ty_to_string(tab, ty)
    let d = mk_diag(SevError, file, line, col, "unfilled hole #{label} : #{ty_s}",
      [ri_help(file, line, col, "replace `#{label}` with an expression of type `#{ty_s}`"),
       ri_note(file, line, col, "--strict-holes blocks emission until every `?` / `?name` / `todo!` is filled")])
    render_diag(d)
    d
  }
}

#[doc("infer: --strict-holes gate that fails the build on any unfilled hole: the error count and the holes reported.")]
pub(pkg) fn strict_holes_check(file: String, decls: [Decl], tin: TyperIn) : (Int, [Diagnostic]) / Console + File + Mutable {

  let tab = tin.tab
  let r = infer_program(file, decls, tin, false)
  let n = list_length(r.holes)
  if n == 0 { (r.errs, []) }
  else {
    let ds = map(r.holes, (h) => strict_hole_diag(file, tab, h))
    eprint("#{file}: #{int_to_string(n)} unfilled hole(s) (--strict-holes)")
    (r.errs + n, ds)
  }
}

#[doc("infer: per-function effect record behind `--effects-json`; `row_open` marks a row polymorphic in further effects.")]
type EffEntry = { file: String, fn_name: String, line: Int, col: Int,
                  effs: [String], row_open: Bool, handlers: [EffHandle] }

#[doc("infer: collect per-function effect records across a typed declaration list; `tab` names the functions and effects, `df` the file each function is declared in.")]
fn effects_walk_decls(decls: [Decl], tab: SymTab, df: DiagFiles, acc: [EffEntry]) : [EffEntry] {
  match decls {
    [] -> list_reverse(acc)
    [d, ...rest] -> match d {
      DFn(_, fid, _, _, _, row, body, line, col, _) -> {
        if sym_internal(tab, fnid_sym(fid)) {
          effects_walk_decls(rest, tab, df, acc)
        } else {
          let entry = EffEntry { file: decl_diag_file(d, df), fn_name: written_text(decl_name(tab, fnid_sym(fid))),
                                  line: line, col: col,
                                  effs: effects_row_labels(tab, row), row_open: effects_row_open(row),
                                  handlers: effects_handlers(tab, body, []) }
          effects_walk_decls(rest, tab, df, [entry, ...acc])
        }
      }
      _ -> effects_walk_decls(rest, tab, df, acc)
    }
  }
}

fn effects_row_labels(tab: SymTab, row: RowExpr) : [String] = match row {
  REmpty         -> []
  RClosed(ls)    -> effects_label_names(tab, ls, [])
  ROpen(_, ls)   -> effects_label_names(tab, ls, [])
}

fn effects_row_open(row: RowExpr) : Bool = match row {
  ROpen(_, _) -> true
  _           -> false
}

fn effects_label_names(tab: SymTab, ls: [RowLabel], acc: [String]) : [String] = match ls {
  []                  -> acc
  [RL(r, _), ...rest] -> effects_label_names(tab, rest, effects_add_unique(ref_decl_name(tab, r), acc))
}

fn effects_handlers(tab: SymTab, e: Expr, acc: [EffHandle]) : [EffHandle] = match e.kind {
  EHandle(_, r, _, _, _, _, _) -> effects_handlers_ps(tab, xp_positions(e), [EH(ref_decl_name(tab, r), e.line, e.col), ...acc])
  _                            -> effects_handlers_ps(tab, xp_positions(e), acc)
}

fn effects_handlers_ps(tab: SymTab, ps: [XPos], acc: [EffHandle]) : [EffHandle] = match ps {
  []                  -> acc
  [XP(_, c), ...rest] -> effects_handlers_ps(tab, rest, effects_handlers(tab, c, acc))
}

#[doc("infer: one `--effects-json` record, rendered as a JSON object.")]
fn effects_json_entry(e: EffEntry) : String =
  concat_all([
    "{",
    "\"file\": ", json_str(e.file),
    ", \"fn\": ", json_str(e.fn_name),
    ", \"line\": ", int_to_string(e.line),
    ", \"col\": ", int_to_string(e.col),
    ", \"effects\": [",
    inf_join_with(map(e.effs, json_str), ", "),
    "], \"row_open\": ", if e.row_open { "true" } else { "false" },
    ", \"handlers_installed\": [",
    inf_join_with(map(e.handlers, effects_json_handler), ", "),
    "]}"
  ])

fn effects_json_handler(h: EffHandle) : String {
  match h {
    EH(eff, line, col) -> concat_all([
      "{\"effect\": ", json_str(eff),
      ", \"line\": ", int_to_string(line),
      ", \"col\": ", int_to_string(col), "}"
    ])
  }
}

#[doc("infer: append an effect label unless the list already carries it.")]
fn effects_add_unique(eff: String, effs: [String]) : [String] {
  if list_has(effs, eff) { effs } else { list_append(effs, [eff]) }
}

# the JSON string escaper moved to compiler/util.kai
# (json_escape / json_quote) so doc_attr.kai can share it without
# importing the typer. json_str stays as the typer-side alias.
#[doc("infer: `json_str` — typer entry point invoked by the driver.")]
pub fn json_str(s: String) : String = json_quote(s)

#[doc("infer: `json_null` — typer entry point invoked by the driver.")]
pub fn json_null() : String = "null"

#[doc("infer: one handler installation site, as `--effects-json` reports it.")]
type EffHandle = EH(String, Int, Int)
