#[doc("""
Dissolve the parser's surface-fidelity nodes into their semantic
lowerings, after `kai fmt` / `kai migrate` have printed and before
resolution.

The parser preserves what the author wrote — `ESurface` wrappers,
`TySurface` / `PSurface` wrappers, `SAssign` writes, anonymous
rest-binder spellings, impl-site tparams — so the writer can reproduce
it verbatim. Everything downstream of this pass sees only the lowered
shapes it always saw:

  - `SfContract(reqs, enss, body)`  -> contract asserts in the body
    (`wrap_with_contracts`, elision included).
  - `SfEnsure(value, pred)`         -> `{ let self = value;
    if pred { Some(self) } else { None } }`.
  - `SAssign(lhs, v)`               -> `lhs.set(v)` statement.
  - `PList` rest spelling `""`/`"_"` -> unique `__list_rest_L_C__`
    sentinel binder.
  - `DImpl` tparams                 -> prepended (bounds stripped) to
    each method's own tparams; the raw slot stays for the writer.
  - `DFn` tparams                   -> protocol bounds stripped; the
    parser stores them raw so the writer can print the signature.
  - `SfLamBlock(lam, _)`            -> the plain lambda.
  - `SfTuple(elems)`                -> `Pair`/`Triple`/`Quad` record
    literal; `PsTuple` -> the variant-record pattern; `TsTuple` ->
    `Pair[..]`/`Triple[..]`/`Quad[..]`.

The type walk visits every `TypeExpr` position a declaration can
carry — signatures, type bodies, effect/protocol ops, annotations,
row-label arguments — because a tuple type can appear in any of them.

The driver runs `surface_lower_decls` once, on the flat post-import
decl list; no `ESurface` / `TySurface` / `PSurface` / `SAssign`
survives it.
""")]

import compiler.util
import compiler.ast
import compiler.ast_map
import compiler.parse
import compiler.refinements

#[doc("Lower every surface-fidelity node in the decl list; the result is the AST the rest of the pipeline consumes.")]
pub fn surface_lower_decls(ds: [Decl]) : [Decl] = map(ds, (d) => sfl_decl(d))

# String-interpolation content is parsed after the decl-level pass ran,
# so that late parse re-enters lowering through this entry point.
#[doc("Lower the surface-fidelity nodes of one expression parsed after the decl pass.")]
pub fn surface_lower_expr(e: Expr) : Expr = sfl_expr(e)

fn sfl_decl(d: Decl) : Decl = match d {
  DFn(is_pub, name, tps, ps, ret, row, body, l, c, mo) ->
    DFn(is_pub, name, map(tps, tp_strip_bounds), sfl_params(ps),
        sfl_ty_opt(ret), sfl_row(row), sfl_fn_body(body, ps, name), l, c, mo)
  DImpl(pn, pargs, tgt, ms, l, c, impl_tps) ->
    DImpl(pn, map(pargs, (x) => sfl_ty(x)), sfl_ty(tgt),
          sfl_impl_methods(impl_tps, ms), l, c, impl_tps)
  DType(is_pub, name, tps, body, l, c, mo, slots) ->
    DType(is_pub, name, tps, sfl_type_body(body), l, c, mo, slots)
  DTest(label, body, l, c, mo)      -> DTest(label, sfl_expr(body), l, c, mo)
  DBench(label, body, l, c, mo)     -> DBench(label, sfl_expr(body), l, c, mo)
  DCheck(label, ps, body, l, c, mo) -> DCheck(label, sfl_params(ps), sfl_expr(body), l, c, mo)
  DConst(is_pub, name, ty, body, mo, l, c) ->
    DConst(is_pub, name, sfl_ty(ty), sfl_expr(body), mo, l, c)
  DEffect(is_pub, name, tps, ops, default_opt, l, c, mo) ->
    DEffect(is_pub, name, tps, map(ops, (op) => sfl_effect_op(op)),
            sfl_default(default_opt), l, c, mo)
  DProtocol(is_pub, name, tps, ops, l, c, mo) ->
    DProtocol(is_pub, name, tps, map(ops, (op) => sfl_proto_op(op)), l, c, mo)
  DAxiom(ec, ov, name, sym, tps, ps, ret, row, l, c) ->
    DAxiom(ec, ov, name, sym, tps, sfl_params(ps), sfl_ty(ret), sfl_row(row), l, c)
  DExternType(name, body, l, c, mo) -> DExternType(name, sfl_extern_body(body), l, c, mo)
  DDerive(names, inner, l, c)   -> DDerive(names, sfl_decl(inner), l, c)
  DUnstable(inner, l, c)        -> DUnstable(sfl_decl(inner), l, c)
  DConstructor(inner, l, c)     -> DConstructor(sfl_decl(inner), l, c)
  DProtoLaws(thy, inner, l, c, mo)  -> DProtoLaws(thy, sfl_decl(inner), l, c, mo)
  DImplAxiom(thy, inner, l, c, mo)  -> DImplAxiom(thy, sfl_decl(inner), l, c, mo)
  DDoc(raw, syn, inner, l, c)   -> DDoc(raw, syn, sfl_decl(inner), l, c)
  # Attribute wrappers are dissolved by the doc strip before lowering
  # runs; dissolve here too so a stray one cannot leak downstream.
  DAttr(_, inner, _, _)         -> sfl_decl(inner)
  _ -> d
}

# Contract clauses are legal only at the top of a fn body, where the
# owning decl supplies the params and name their lowering needs.
fn sfl_fn_body(body: Expr, ps: [Param], fn_name: String) : Expr = match body.kind {
  ESurface(sf) -> match sf {
    SfContract(reqs, enss, inner) ->
      wrap_with_contracts(sfl_expr(inner), map(reqs, (e) => sfl_expr(e)),
                          map(enss, (e) => sfl_expr(e)), ps, fn_name,
                          body.line, body.col)
    SfEnsure(_, _) -> sfl_expr(body)
    SfLamBlock(_, _) -> sfl_expr(body)
    SfTuple(_) -> sfl_expr(body)
    SfHandleInit(_) -> sfl_expr(body)
    SfBigIntLit(_) -> sfl_expr(body)
    SfMapLit(_, _) -> sfl_expr(body)
    SfSetLit(_, _) -> sfl_expr(body)
    SfRefMake(_) -> sfl_expr(body)
    SfDeref(_) -> sfl_expr(body)
    SfMultiMatch(_, _) -> sfl_expr(body)
    # `case`-arms discriminate on the owning fn's params: one param
    # lowers to a plain match, several to the multi-match chain.
    SfCaseBlock(arms) -> {
      let low = map(arms, (a) => sfl_mmarm(a))
      match ps {
        [pm] -> mk_expr(EMatch(sfl_param_var(pm), map(low, (a) => sfl_mmarm_to_arm(a))),
                        body.line, body.col)
        _    -> desugar_multi_match(map(ps, (pm) => sfl_param_var(pm)), low,
                                    body.line, body.col)
      }
    }
  }
  _ -> sfl_expr(body)
}

fn sfl_mmarm(a: MMArm) : MMArm = match a {
  MMArm(pats, guard, body) ->
    MMArm(map(pats, (x) => sfl_pat(x)), sfl_opt(guard), sfl_expr(body))
}

fn sfl_mmarm_to_arm(a: MMArm) : Arm = match a {
  MMArm(pats, guard, body) -> match pats {
    [p] -> Arm(p, guard, body)
    _   -> panic("surface_lower: case-block arm arity does not match the params")
  }
}

fn sfl_param_var(pm: Param) : Expr = mk_expr(EVar(pm.pname), pm.pline, pm.pcol)

# Prepend the impl-level tparams to each method's own tparams. Bounds
# are stripped: the pipeline uses these strings as plain ident keys.
fn sfl_impl_methods(impl_tps: [String], ms: [Decl]) : [Decl] {
  let stripped = map(impl_tps, tp_strip_bounds)
  map(ms, (m) => sfl_impl_method(stripped, m))
}

fn sfl_impl_method(stripped: [String], m: Decl) : Decl = match sfl_decl(m) {
  DFn(is_pub, n, tps, ps, ret, row, body, l, c, mo) ->
    DFn(is_pub, n, list_append(stripped, tps), ps, ret, row, body, l, c, mo)
  other -> other
}

fn sfl_default(o: Option[DefaultBlock]) : Option[DefaultBlock] = match o {
  None -> None
  Some(DBlk(cs, ret, l, c)) ->
    Some(DBlk(map(cs, (cl) => sfl_hclause(cl)), sfl_hreturn_opt(ret), l, c))
}

fn sfl_expr(e: Expr) : Expr = match e.kind {
  ESurface(sf) -> match sf {
    SfEnsure(value, pred) -> sfl_ensure(sfl_expr(value), sfl_expr(pred), e.line, e.col)
    SfContract(_, _, _) -> panic("surface_lower: contract clauses outside a fn body")
    SfLamBlock(lam, _) -> sfl_expr(lam)
    SfTuple(elems) ->
      mk_expr(ERecordLit(sfl_tuple_name(list_length(elems)),
                         build_tuple_field_inits(map(elems, (x) => sfl_expr(x)), 0, [])),
              e.line, e.col)
    SfHandleInit(init) -> sfl_expr(init)
    SfBigIntLit(digits) -> sfl_bigint(digits, e.line, e.col)
    SfRefMake(inner) ->
      sfl_coll_call("Mutable", "ref_make", [sfl_expr(inner)], e.line, e.col)
    # A bare `@ident` lowers to the sentinel `ident.__deref()` — a
    # reserved name the user cannot spell — so the cell-read lowering
    # can tell a `@`-deref from a literal `ident.get()`. A dotted
    # `@r.field` cannot be a cell, so it lowers straight to `.get()`.
    SfDeref(target) -> {
      let tgt = sfl_expr(target)
      let sentinel = match tgt.kind { EVar(_) -> "__deref" _ -> "get" }
      mk_expr(ECall(mk_expr(EField(tgt, sentinel), e.line, e.col), []), e.line, e.col)
    }
    SfMultiMatch(scruts, arms) ->
      desugar_multi_match(map(scruts, (x) => sfl_expr(x)),
                          map(arms, (a) => sfl_mmarm(a)), e.line, e.col)
    # Only legal as a fn body; sfl_fn_body dissolves it there.
    SfCaseBlock(_) -> panic("surface_lower: case-block outside a fn body")
    SfMapLit(spread, flat) -> sfl_map_lit(sfl_spread(spread), sfl_pairs(flat), e.line, e.col)
    SfSetLit(spread, elems) -> sfl_set_lit(sfl_spread(spread), map(elems, (x) => sfl_expr(x)), e.line, e.col)
  }
  # EMatch and EBlock carry patterns / statement shapes the generic
  # child-mapper does not rewrite; ELambda / EHandle / EVariantsOf
  # carry type annotations it does not reach. They recurse here.
  EMatch(scrut, arms) ->
    sfl_rebuild(e, EMatch(sfl_expr(scrut), map(arms, (a) => sfl_arm(a))))
  EBlock(stmts, tail) ->
    sfl_rebuild(e, EBlock(map(stmts, (st) => sfl_stmt(st)), sfl_opt(tail)))
  ELambda(ps, body) -> sfl_rebuild(e, ELambda(sfl_params(ps), sfl_expr(body)))
  EHandle(body, eff, tyargs, init, alias, cs, ret) ->
    sfl_rebuild(e, EHandle(sfl_expr(body), eff, map(tyargs, (x) => sfl_ty(x)),
                           sfl_opt(init), alias, map(cs, (cl) => sfl_hclause(cl)),
                           sfl_hreturn_opt(ret)))
  EVariantsOf(t, names) -> sfl_rebuild(e, EVariantsOf(sfl_ty(t), names))
  # Pun markers normalise to the plain field name; the spread and
  # positional sentinels stay for the record desugar downstream.
  ERecordLit(name, fields) ->
    sfl_rebuild(e, ERecordLit(name, map(fields, (f) => sfl_field_init(f))))
  _ -> sfl_rebuild(e, prc_map_expr_kind(e.kind, (x) => sfl_expr(x)))
}

fn sfl_field_init(f: FieldInit) : FieldInit = match f {
  FI(n, v) ->
    if is_pun_field_marker(n) { FI(pun_field_name(n), sfl_expr(v)) }
    else { FI(n, sfl_expr(v)) }
}

fn sfl_rebuild(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode }

fn sfl_opt(o: Option[Expr]) : Option[Expr] = match o {
  None -> None
  Some(x) -> Some(sfl_expr(x))
}

# `ensure(value) where pred` expansion: `self` is bound to the value so
# the predicate (which conventionally reads `self`) sees a regular
# local.
fn sfl_ensure(value: Expr, pred: Expr, line: Int, col: Int) : Expr {
  let self_let = SLet(mk_pat(PBind("self"), line, col), None, value)
  let some_call = mk_expr(ECall(mk_expr(EVar("Some"), line, col),
                                [mk_expr(EVar("self"), line, col)]), line, col)
  let if_expr = mk_expr(EIf(pred, some_call,
                            Some(mk_expr(EVar("None"), line, col))), line, col)
  mk_expr(EBlock([self_let], Some(if_expr)), line, col)
}

# `123n` expansion: `bigint.from_literal("123")`. The callee is
# `EField(EVar("bigint"), ..)` so the qualified-call resolver rewrites
# it to an `EModCall` once the module is imported, as the numeric
# literal sugars do.
fn sfl_bigint(digits: String, line: Int, col: Int) : Expr {
  let s_e = mk_expr(EStr(concat_all(["\"", digits, "\""]), false), line, col)
  sfl_coll_call("bigint", "from_literal", [s_e], line, col)
}

# `EField(EVar(mod), fn)`: the unresolved qualified callee the
# qualified-call resolver rewrites into an `EModCall`.
fn sfl_coll_call(mod: String, fn_name: String, args: [Expr], line: Int, col: Int) : Expr {
  let callee = mk_expr(EField(mk_expr(EVar(mod), line, col), fn_name), line, col)
  mk_expr(ECall(callee, args), line, col)
}

fn sfl_spread(o: Option[Expr]) : Option[Expr] = match o {
  None -> None
  Some(b) -> Some(sfl_expr(b))
}

# Re-pair a map literal's flattened `[k1, v1, ...]` children.
fn sfl_pairs(flat: [Expr]) : [Expr] = map(flat, (x) => sfl_expr(x))

# `%{}` -> map.empty(); `%{ k: v }` -> map.from([Pair]); with a spread,
# a `map.put` chain over the base so a repeated key's override wins.
fn sfl_map_lit(spread: Option[Expr], flat: [Expr], line: Int, col: Int) : Expr =
  match spread {
    None -> match flat {
      [] -> sfl_coll_call("map", "empty", [], line, col)
      _  -> sfl_coll_call("map", "from",
              [mk_expr(EList(sfl_pair_elems(flat, [])), line, col)], line, col)
    }
    Some(base) -> sfl_map_puts(base, flat, line, col)
  }

fn sfl_pair_elems(flat: [Expr], acc: [ListElem]) : [ListElem] = match flat {
  [] -> list_reverse(acc)
  [k, v, ...rest] ->
    sfl_pair_elems(rest, [ElPlain(mk_expr(ERecordLit("Pair", [FI("fst", k), FI("snd", v)]),
                                          k.line, k.col)), ...acc])
  _ -> panic("surface_lower: map literal with an odd entry list")
}

fn sfl_map_puts(base: Expr, flat: [Expr], line: Int, col: Int) : Expr = match flat {
  [] -> base
  [k, v, ...rest] ->
    sfl_map_puts(sfl_coll_call("map", "put", [base, k, v], line, col), rest, line, col)
  _ -> panic("surface_lower: map literal with an odd entry list")
}

# `%[]` -> set.empty(); `%[ e ]` -> set.from([e]); with a spread, a
# `set.insert` chain over the base.
fn sfl_set_lit(spread: Option[Expr], elems: [Expr], line: Int, col: Int) : Expr =
  match spread {
    None -> match elems {
      [] -> sfl_coll_call("set", "empty", [], line, col)
      _  -> sfl_coll_call("set", "from",
              [mk_expr(EList(map(elems, (e) => ElPlain(e))), line, col)], line, col)
    }
    Some(base) -> sfl_set_inserts(base, elems, line, col)
  }

fn sfl_set_inserts(base: Expr, elems: [Expr], line: Int, col: Int) : Expr = match elems {
  [] -> base
  [e, ...rest] ->
    sfl_set_inserts(sfl_coll_call("set", "insert", [base, e], line, col), rest, line, col)
}

fn sfl_stmt(st: Stmt) : Stmt = match st {
  SAssign(lhs, v, l, c) -> {
    let setter = mk_expr(EField(sfl_expr(lhs), "set"), l, c)
    SExprStmt(mk_expr(ECall(setter, [sfl_expr(v)]), l, c))
  }
  SLet(pat, ty, e)            -> SLet(sfl_pat(pat), sfl_ty_opt(ty), sfl_expr(e))
  SAssert(e, msg)             -> SAssert(sfl_expr(e), sfl_opt(msg))
  SExprStmt(e)                -> SExprStmt(sfl_expr(e))
  SIndexAssign(b, i, v, l, c) -> SIndexAssign(sfl_expr(b), sfl_expr(i), sfl_expr(v), l, c)
  SVar(n, ty, e, l, c)        -> SVar(n, sfl_ty_opt(ty), sfl_expr(e), l, c)
  SUse(_, _, _)               -> st
}

# A `PsRefine` narrowing dissolves at the arm, where the user guard is
# in reach: `name : Base where pred` becomes `PBind(name)` plus a guard
# `{ let self = name; pred }`, welded ahead of any user guard with `and`
# so a violated refinement short-circuits before the user predicate.
fn sfl_arm(a: Arm) : Arm = match a {
  Arm(pat, guard, body) -> match pat.pkind {
    PSurface(ps) -> match ps {
      PsRefine(name, ty) ->
        Arm(mk_pat(PBind(name), pat.line, pat.col),
            Some(sfl_weld_guard(sfl_refine_guard(name, ty, pat.line, pat.col),
                                sfl_opt(guard))),
            sfl_expr(body))
      _ -> Arm(sfl_pat(pat), sfl_opt(guard), sfl_expr(body))
    }
    _ -> Arm(sfl_pat(pat), sfl_opt(guard), sfl_expr(body))
  }
}

fn sfl_refine_guard(name: String, ty: TypeExpr, line: Int, col: Int) : Expr =
  match ty.tkind {
    TyRefine(_, pred) -> {
      let self_let = SLet(mk_pat(PBind("self"), line, col), None,
                          mk_expr(EVar(name), line, col))
      mk_expr(EBlock([self_let], Some(sfl_expr(pred))), line, col)
    }
    _ -> panic("surface_lower: PsRefine without a refinement type")
  }

fn sfl_weld_guard(narrow: Expr, user: Option[Expr]) : Expr = match user {
  None -> narrow
  Some(u) -> mk_expr(EBinop("and", narrow, u), narrow.line, narrow.col)
}

fn sfl_hclause(cl: HClause) : HClause = match cl {
  HC(n, ps, body, l, c) -> HC(n, sfl_params(ps), sfl_expr(body), l, c)
}

fn sfl_hreturn_opt(o: Option[HReturn]) : Option[HReturn] = match o {
  None -> None
  Some(HR(n, body, l, c)) -> Some(HR(n, sfl_expr(body), l, c))
}

fn sfl_pat(p: Pattern) : Pattern = match p.pkind {
  PSurface(ps) -> match ps {
    PsTuple(pats) ->
      mk_pat(PVariantRecord(None, sfl_tuple_name(list_length(pats)),
                            build_tuple_pfields(map(pats, (x) => sfl_pat(x)), 0, [])),
             p.line, p.col)
    PsQualified(q, sub) -> sfl_qualified(q, sfl_pat(sub), p.line, p.col)
    PsAs(n, sub) -> mk_pat(PAs(n, sfl_pat(sub)), p.line, p.col)
    # Only legal as an arm's top-level pattern; sfl_arm dissolves it.
    PsRefine(_, _) -> panic("surface_lower: PsRefine outside a match arm")
  }
  PList(subs, rest) ->
    mk_pat(PList(map(subs, (x) => sfl_pat(x)), sfl_rest(rest, p.line, p.col)),
           p.line, p.col)
  PVariant(home, n, subs) ->
    mk_pat(PVariant(home, n, map(subs, (x) => sfl_pat(x))), p.line, p.col)
  PVariantRecord(home, n, fs) ->
    mk_pat(PVariantRecord(home, n, map(fs, (f) => sfl_pfield(f))), p.line, p.col)
  PRecord(fs) -> mk_pat(PRecord(map(fs, (f) => sfl_pfield(f))), p.line, p.col)
  PAs(n, sub) -> mk_pat(PAs(n, sfl_pat(sub)), p.line, p.col)
  PNarrow(n, ty) -> mk_pat(PNarrow(n, sfl_ty(ty)), p.line, p.col)
  _ -> p
}

# The qualifier lands in the variant's home slot, positional or
# record-shaped alike; any other pattern shape has nothing to qualify.
fn sfl_qualified(q: String, sub: Pattern, line: Int, col: Int) : Pattern = match sub.pkind {
  PVariant(_, n, subs) -> mk_pat(PVariant(Some(q), n, subs), line, col)
  PVariantRecord(_, n, fs) -> mk_pat(PVariantRecord(Some(q), n, fs), line, col)
  _ -> sub
}

fn sfl_pfield(f: PField) : PField = match f {
  PField(name, sub, is_short) -> PField(name, sfl_pat(sub), is_short)
}

# The anonymous rest spellings (`""` for `...`, `"_"` for `..._`) get a
# binder the pipeline can key on. The owning PList's position makes it
# unique: two rest binders can never share a `[` token.
fn sfl_rest(rest: Option[String], line: Int, col: Int) : Option[String] = match rest {
  Some(sp) ->
    if sp == "" or sp == "_" {
      Some(concat_all(["__list_rest_", int_to_string(line), "_",
                       int_to_string(col), "__"]))
    } else { rest }
  None -> None
}

# ---- type walk ------------------------------------------------------

fn sfl_ty(t: TypeExpr) : TypeExpr = match t.tkind {
  TySurface(ts) -> match ts {
    TsTuple(tys) ->
      mk_ty(TyName(sfl_tuple_name(list_length(tys)), map(tys, (x) => sfl_ty(x))),
            t.line, t.col)
    TsUnitSpan(_, inner) -> sfl_ty(inner)
  }
  TyName(n, tys)    -> mk_ty(TyName(n, map(tys, (x) => sfl_ty(x))), t.line, t.col)
  TyList(inner)     -> mk_ty(TyList(sfl_ty(inner)), t.line, t.col)
  TyFn(ps, ret, row) ->
    mk_ty(TyFn(map(ps, (x) => sfl_ty(x)), sfl_ty(ret), sfl_row(row)), t.line, t.col)
  TyDim(base, u)    -> mk_ty(TyDim(sfl_ty(base), u), t.line, t.col)
  TyRefine(base, pred) -> mk_ty(TyRefine(sfl_ty(base), sfl_expr(pred)), t.line, t.col)
  TyRow(row)        -> mk_ty(TyRow(sfl_row(row)), t.line, t.col)
}

fn sfl_ty_opt(o: Option[TypeExpr]) : Option[TypeExpr] = match o {
  None -> None
  Some(t) -> Some(sfl_ty(t))
}

fn sfl_row(r: RowExpr) : RowExpr = match r {
  REmpty -> REmpty
  RClosed(labels) -> RClosed(map(labels, (rl) => sfl_row_label(rl)))
  ROpen(tail, labels) -> ROpen(tail, map(labels, (rl) => sfl_row_label(rl)))
}

fn sfl_row_label(rl: RowLabel) : RowLabel = match rl {
  RL(n, tys) -> RL(n, map(tys, (x) => sfl_ty(x)))
}

fn sfl_params(ps: [Param]) : [Param] = map(ps, (pm) => sfl_param(pm))

fn sfl_param(pm: Param) : Param =
  Param { pname: pm.pname, ptype: sfl_ty_opt(pm.ptype), pline: pm.pline,
          pcol: pm.pcol, pborrow: pm.pborrow }

fn sfl_type_body(b: TypeBody) : TypeBody = match b {
  TBAlias(t)     -> TBAlias(sfl_ty(t))
  TBRecord(fs)   -> TBRecord(map(fs, (f) => sfl_field_decl(f)))
  TBSum(vs)      -> TBSum(map(vs, (v) => sfl_variant(v)))
  TBEffectAlias(_) -> b
}

fn sfl_field_decl(f: FieldDecl) : FieldDecl = match f {
  FD(is_pub, n, t, attrs) -> FD(is_pub, n, sfl_ty(t), attrs)
}

fn sfl_variant(v: Variant) : Variant = match v {
  Var(n, tys) -> Var(n, map(tys, (x) => sfl_ty(x)))
}

fn sfl_extern_body(b: ExternTypeBody) : ExternTypeBody = match b {
  ETStruct(fs) -> ETStruct(map(fs, (f) => sfl_field_decl(f)))
  ETOpaque     -> b
}

fn sfl_effect_op(op: EffectOp) : EffectOp = match op {
  EOp(n, tps, ps, ret, l, c) -> EOp(n, tps, sfl_params(ps), sfl_ty(ret), l, c)
}

fn sfl_proto_op(op: ProtoOp) : ProtoOp = match op {
  POp(n, tps, ps, ret, l, c) -> POp(n, tps, sfl_params(ps), sfl_ty(ret), l, c)
}

# Parse rejects tuple arities outside 2..4, so the lookup cannot miss.
fn sfl_tuple_name(n: Int) : String = match tuple_type_for_arity(n) {
  Some(name) -> name
  None -> panic("surface_lower: tuple arity outside 2..4 survived the parser")
}
