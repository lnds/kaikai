#[doc("""
Erases resolved identity back to a spelling, at the one boundary where
a name stops being a reference and becomes a C symbol.

Identity is what the resolver decided and what the typer and the
monomorphiser consume. Below them the passes no longer ask *which*
declaration a name means — that question is settled — they spell an
identifier for the backend. Feeding them an `ESym` would make every one
of those spelling sites carry a second shape for no decision it makes.

So the boundary is explicit and lives in one place, rather than each
downstream pass growing its own `ESym` arm that quietly means `EVar`.
A pass that ever needs the identity again reads it above this line.
""")]

import compiler.ast
import compiler.ast_map

#[doc("The same declarations with every resolved reference spelled back as a plain name.")]
pub fn sym_erase_decls(ds: [Decl]) : [Decl] = match ds {
  []           -> []
  [d, ...rest] -> [sym_erase_decl(d), ...sym_erase_decls(rest)]
}

#[doc("The same declaration with every resolved reference in its body spelled back as a plain name.")]
pub fn sym_erase_decl(d: Decl) : Decl = match d {
  DFn(p, n, tp, ps, rt, row, body, l, c, mo) ->
    DFn(p, n, tp, ps, rt, row, sym_erase_expr(body), l, c, mo)
  DTest(desc, body, l, c, mo)      -> DTest(desc, sym_erase_expr(body), l, c, mo)
  DBench(desc, body, l, c, mo)     -> DBench(desc, sym_erase_expr(body), l, c, mo)
  DCheck(desc, ps, body, l, c, mo) -> DCheck(desc, ps, sym_erase_expr(body), l, c, mo)
  DConst(p, n, ta, body, mo, l, c) -> DConst(p, n, ta, sym_erase_expr(body), mo, l, c)
  DConstructor(inner, l, c)        -> DConstructor(sym_erase_decl(inner), l, c)
  DProtoLaws(th, inner, l, c, mo)  -> DProtoLaws(th, sym_erase_decl(inner), l, c, mo)
  DImplAxiom(th, inner, l, c, mo)  -> DImplAxiom(th, sym_erase_decl(inner), l, c, mo)
  DDoc(raw, txt, inner, l, c)      -> DDoc(raw, txt, sym_erase_decl(inner), l, c)
  DAttr(raw, inner, l, c)          -> DAttr(raw, sym_erase_decl(inner), l, c)
  _ -> d
}

#[doc("The same expression with every resolved reference in it spelled back as a plain name.")]
pub fn sym_erase_expr(e: Expr) : Expr =
  Expr { kind: sym_erase_kind(e.kind), line: e.line, col: e.col, ty: e.ty, mode: e.mode }

fn sym_erase_kind(k: ExprKind) : ExprKind = match k {
  ESym(_, n) -> EVar(n)
  _          -> prc_map_expr_kind(k, (sub) => sym_erase_expr(sub))
}
