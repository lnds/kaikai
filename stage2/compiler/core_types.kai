#[doc("The types and effects the core declares.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.symtab
import compiler.scalar_ty

#[doc("A stdlib-declared type the compiler treats specially, named without building its spelling.")]
pub(pkg) type CoreDeclTy = CdDecimal | CdDecimalBig | CdBigInt | CdSeq

fn core_decl_tys() : [CoreDeclTy] = [CdDecimal, CdDecimalBig, CdBigInt, CdSeq]

#[doc("True when the type `t` carries numeric literals.")]
pub(pkg) fn core_decl_ty_is_numeric(t: CoreDeclTy) : Bool = match t {
  CdSeq -> false
  _     -> true
}

#[doc("The literal suffix that writes the type `t` (`19.99d` is a `Decimal`, `99n` a `BigInt`), or the empty string for a type no suffix writes.")]
pub(pkg) fn core_decl_ty_suffix(t: CoreDeclTy) : String = match t {
  CdDecimal    -> "d"
  CdBigInt     -> "n"
  CdDecimalBig -> ""
  CdSeq        -> ""
}

#[doc("The function the `n` suffix calls with the literal's digits: the `from_literal` of the module that declares `BigInt`.")]
pub(pkg) fn core_bigint_literal_fn() : SymId = SymId(core_bigint_literal_raw())

# Tabulated like the type ids: every call is asked whether it is this one.
fn core_bigint_literal_raw() : Int = 2815187083899997346

#[doc("`once(() => body)` of the module that declares `Seq`, by id: the initialiser of a constant whose type holds one, so a fiber evaluates `body` a single time.")]
pub(pkg) fn seq_once_call(body: Expr) : Expr = {
  let once = mk_expr(ESym(sym_derive(NCFn, "once", core_decl_ty_home(CdSeq)), spec_none()), body.line, body.col)
  mk_expr(ECall(once, [mk_expr(ELambda([], body), body.line, body.col)]), body.line, body.col)
}

#[doc("The name the type `t` is declared with.")]
pub(pkg) fn core_decl_ty_name(t: CoreDeclTy) : String = match t {
  CdDecimal    -> "Decimal"
  CdDecimalBig -> "DecimalBig"
  CdBigInt     -> "BigInt"
  CdSeq        -> "Seq"
}

#[doc("The stdlib module that declares the type `t`.")]
pub(pkg) fn core_decl_ty_home(t: CoreDeclTy) : String = match t {
  CdDecimal    -> "decimal"
  CdDecimalBig -> "decimal_big"
  CdBigInt     -> "math__bigint"
  CdSeq        -> "seq"
}

#[doc("The identity of the type `t`: the id the symbol table gives its declaration.")]
pub(pkg) fn core_decl_ty_id(t: CoreDeclTy) : SymId = SymId(core_decl_ty_raw(t))

# The id each declaration's name and home derive, tabulated: the test
# below runs on every match and every carrier check, and a derivation
# builds a string and hashes it.
fn core_decl_ty_raw(t: CoreDeclTy) : Int = match t {
  CdDecimal    -> 955402778915999600
  CdDecimalBig -> 1424877753137465621
  CdBigInt     -> 9083907095363097190
  CdSeq        -> 7541083128454955404
}

#[doc("True when each tabulated identity is the one its declaration's name and home derive.")]
pub(pkg) fn core_decl_tys_are_derived() : Bool =
  all(core_decl_tys(), (t) => core_decl_ty_raw(t) == sym_raw(sym_derive(NCType, core_decl_ty_name(t), core_decl_ty_home(t))))
    and core_bigint_literal_raw() == sym_raw(sym_derive(NCFn, "from_literal", core_decl_ty_home(CdBigInt)))

#[doc("True when the nominal type `s` is the stdlib type `t`. An absent id is no type.")]
pub(pkg) fn ty_is(s: SymId, t: CoreDeclTy) : Bool =
  sym_raw(s) >= 0 and sym_raw(s) == core_decl_ty_raw(t)

#[doc("The stdlib type `s` is the declaration of, or `None` for any other symbol.")]
pub(pkg) fn core_decl_ty_of(s: SymId) : Option[CoreDeclTy] =
  if sym_raw(s) < 0 { None } else { find(core_decl_tys(), (t) => ty_is(s, t)) }

#[doc("The identity of `linalg`'s `Matrix`, whose two `Dim` habitant slots the compiler states for it.")]
pub(pkg) fn linalg_matrix_id() : SymId = sym_derive(NCType, "Matrix", "math__linalg")

#[doc("A stdlib collection the index sugar reads through the `get` of its own module.")]
pub(pkg) type CoreColl = CcMap | CcHashMap

fn core_coll_name(c: CoreColl) : String = match c {
  CcMap     -> "Map"
  CcHashMap -> "HashMap"
}

#[doc("The stdlib module that declares the collection `c`.")]
pub(pkg) fn core_coll_home(c: CoreColl) : String = match c {
  CcMap     -> "collections__map"
  CcHashMap -> "collections__hashmap"
}

#[doc("The stdlib collection `s` is the declaration of, or `None` for any other symbol.")]
pub(pkg) fn core_coll_of(s: SymId) : Option[CoreColl] =
  if sym_raw(s) < 0 { None }
  else { find([CcMap, CcHashMap], (c) => sym_raw(s) == sym_raw(sym_derive(NCType, core_coll_name(c), core_coll_home(c)))) }

# Asked by spelling because the name has no declaration to carry an id:
# only the diagnostic for an unknown type reads this.
#[doc("The stdlib module that declares a type the compiler knows under `name`, or `None` for any other name.")]
pub(pkg) fn stdlib_type_home(name: String) : Option[String] =
  match find(core_decl_tys(), (t) => core_decl_ty_name(t) == name) {
    Some(t) -> Some(core_decl_ty_home(t))
    None    -> match find([CcMap, CcHashMap], (c) => core_coll_name(c) == name) {
      Some(c) -> Some(core_coll_home(c))
      None    -> None
    }
  }

#[doc("A type the runtime impl table numbers with a fixed head tag.")]
pub(pkg) type RtHead = RhUnit | RhBool | RhInt | RhReal | RhChar | RhString | RhList | RhArray
                | RhByte | RhVec | RhOption | RhResult | RhSignal | RhProcessExit
                | RhPair | RhTriple | RhQuad

#[doc("Every runtime head.")]
pub(pkg) fn rt_heads() : [RtHead] =
  [RhUnit, RhBool, RhInt, RhReal, RhChar, RhString, RhList, RhArray,
   RhByte, RhVec, RhOption, RhResult, RhSignal, RhProcessExit, RhPair, RhTriple, RhQuad]

#[doc("The tag the runtime impl table numbers the head `h` with.")]
pub(pkg) fn rt_head_tag(h: RtHead) : Int = match h {
  RhUnit        -> 1
  RhBool        -> 2
  RhInt         -> 3
  RhReal        -> 4
  RhChar        -> 5
  RhString      -> 6
  RhList        -> 7
  RhArray       -> 8
  RhByte        -> 9
  RhVec         -> 14
  RhOption      -> 16
  RhResult      -> 17
  RhSignal      -> 18
  RhProcessExit -> 19
  RhPair        -> 20
  RhTriple      -> 21
  RhQuad        -> 22
}

#[doc("The first head tag a user record or sum takes; the tags below it are the runtime's.")]
pub(pkg) fn user_head_base() : Int = 23

#[doc("The home of the core module `effects/os.kai`: a core file's declarations take its basename.")]
pub(pkg) fn os_module_home() : String = "os"

#[doc("The home of the core module `tuple.kai`.")]
pub(pkg) fn tuple_module_home() : String = "tuple"

#[doc("True for the head of a tuple type.")]
pub(pkg) fn rt_head_is_tuple(h: RtHead) : Bool = match h {
  RhPair   -> true
  RhTriple -> true
  RhQuad   -> true
  _        -> false
}

#[doc("The declaration the head `h` numbers; the head of a scalar has none, which reads as no declaration.")]
pub(pkg) fn rt_head_decl_sym(h: RtHead) : SymId = match rt_head_decl(h) {
  Some(s) -> s
  None    -> sym_none()
}

# The declaration a head numbers. A scalar has none.
fn rt_head_decl(h: RtHead) : Option[SymId] = match h {
  RhList        -> Some(core_ty_sym(CtList))
  RhArray       -> Some(core_ty_sym(CtArray))
  RhVec         -> Some(core_ty_sym(CtVec))
  RhOption      -> Some(core_ty_sym(CtOption))
  RhResult      -> Some(core_ty_sym(CtResult))
  RhSignal      -> Some(sym_derive(NCType, "Signal", os_module_home()))
  RhProcessExit -> Some(sym_derive(NCType, "ProcessExit", os_module_home()))
  RhPair        -> Some(sym_derive(NCType, "Pair", tuple_module_home()))
  RhTriple      -> Some(sym_derive(NCType, "Triple", tuple_module_home()))
  RhQuad        -> Some(sym_derive(NCType, "Quad", tuple_module_home()))
  _             -> None
}

fn rt_head_of_scalar(t: Ty) : Option[RtHead] = match t {
  TyUnit   -> Some(RhUnit)
  TyBool   -> Some(RhBool)
  TyInt    -> Some(RhInt)
  TyReal   -> Some(RhReal)
  TyChar   -> Some(RhChar)
  TyString -> Some(RhString)
  TyByte   -> Some(RhByte)
  _        -> None
}

fn rt_head_of_sym(s: SymId) : Option[RtHead] =
  if sym_raw(s) < 0 { None }
  else { find(rt_heads(), (h) => match rt_head_decl(h) { Some(d) -> sym_same(d, s) None -> false }) }

#[doc("The runtime head the type reference `r` names: a declaration's by its id, a scalar's by the scalar it spells. `None` for a type the runtime gives no fixed head.")]
pub(pkg) fn rt_head_of_ref(r: DeclRef) : Option[RtHead] = match r {
  DrSym(s)        -> rt_head_of_sym(s)
  DrWritten(_, _) -> match scalar_ty_named(ref_spelled(r)) {
    Some(t) -> rt_head_of_scalar(t)
    None    -> None
  }
}

#[doc("The stdlib modules whose functions the compiler writes into a program by identity: the homes of the special types and of the index-sugar collections.")]
pub(pkg) fn core_special_homes() : [String] =
  list_append(map(core_decl_tys(), core_decl_ty_home), map([CcMap, CcHashMap], core_coll_home))

#[doc("A core effect the compiler names: the closed set of declarations a pass may single out.")]
pub(pkg) type CoreEffect = CeState | CeReader | CeWriter | CeMutable | CeFfi | CeJs
  | CeSpawn | CeCancel | CeLink | CeMonitor | CeActor
  | CeStdout | CeStderr | CeStdin | CeEnv | CeFile | CeProcess
  | CeClock | CeRandom | CeSecureRandom | CeNetTcp | CeNetUdp | CeNetUnix | CeNetDns | CeSignal | CeLog

#[doc("The name a core effect is declared with: what a diagnostic, a dump and the runtime label spell.")]
pub(pkg) fn core_effect_name(c: CoreEffect) : String = match c {
  CeState   -> "State"
  CeReader  -> "Reader"
  CeWriter  -> "Writer"
  CeMutable -> "Mutable"
  CeFfi     -> "Ffi"
  CeJs      -> "Js"
  CeSpawn   -> "Spawn"
  CeCancel  -> "Cancel"
  CeLink    -> "Link"
  CeMonitor -> "Monitor"
  CeActor   -> "Actor"
  CeStdout  -> "Stdout"
  CeStderr  -> "Stderr"
  CeStdin   -> "Stdin"
  CeEnv     -> "Env"
  CeFile    -> "File"
  CeProcess -> "Process"
  CeClock   -> "Clock"
  CeRandom  -> "Random"
  CeSecureRandom -> "SecureRandom"
  CeNetTcp  -> "NetTcp"
  CeNetUdp  -> "NetUdp"
  CeNetUnix -> "NetUnix"
  CeNetDns  -> "NetDns"
  CeSignal  -> "Signal"
  CeLog     -> "Log"
}

# The module whose stream declares the effect.
fn core_effect_home(c: CoreEffect) : String = match c {
  CeState   -> "concurrent"
  CeReader  -> "concurrent"
  CeWriter  -> "concurrent"
  CeSpawn   -> "concurrent"
  CeCancel  -> "concurrent"
  CeLink    -> "concurrent"
  CeMonitor -> "concurrent"
  CeActor   -> "concurrent"
  CeProcess -> "os"
  CeMutable -> "effects"
  CeFfi     -> "effects"
  CeJs      -> "effects"
  CeStdout  -> "effects"
  CeStderr  -> "effects"
  CeStdin   -> "effects"
  CeEnv     -> "effects"
  CeFile    -> "effects"
  CeRandom  -> "effects"
  CeSecureRandom -> "effects"
  CeLog     -> "effects"
  CeSignal  -> "os"
  CeClock   -> "time"
  CeNetTcp  -> "net__tcp"
  CeNetUdp  -> "net__udp"
  CeNetUnix -> "net__unix"
  CeNetDns  -> "net__dns"
}

#[doc("The declaration a core effect is: the id the symbol table holds for it.")]
pub(pkg) fn core_effect_id(c: CoreEffect) : SymId = SymId(core_effect_raw(c))

# The id each effect's name and home derive, tabulated: passes ask which
# core effect a label is on every row they read, and a derivation builds
# a string and hashes it.
fn core_effect_raw(c: CoreEffect) : Int = match c {
  CeState        -> 1793337584142949932
  CeReader       -> 9118086695842773681
  CeWriter       -> 3742621026940645377
  CeMutable      -> 5284387685190924345
  CeFfi          -> 7458743709468539139
  CeJs           -> 4908531098805431514
  CeSpawn        -> 4982727092969191890
  CeCancel       -> 4073248305964767003
  CeLink         -> 3536290541108258182
  CeMonitor      -> 7194965815363612335
  CeActor        -> 5523920262146478775
  CeStdout       -> 7011661366081257046
  CeStderr       -> 3365168435483099045
  CeStdin        -> 39558678912747917
  CeEnv          -> 9184442853664428740
  CeFile         -> 1185392000373346643
  CeProcess      -> 772543352024307631
  CeClock        -> 3930682887202962661
  CeRandom       -> 7113299721127038226
  CeSecureRandom -> 7501162831799159192
  CeNetTcp       -> 1053914643869103684
  CeNetUdp       -> 2913781182555034144
  CeNetUnix      -> 9045631927227930985
  CeNetDns       -> 1481266202576392499
  CeSignal       -> 8602324383868402738
  CeLog          -> 3542305281035147134
}

fn core_effects() : [CoreEffect] =
  [CeState, CeReader, CeWriter, CeMutable, CeFfi, CeJs, CeSpawn, CeCancel, CeLink, CeMonitor, CeActor,
   CeStdout, CeStderr, CeStdin, CeEnv, CeFile, CeProcess, CeClock, CeRandom, CeSecureRandom,
   CeNetTcp, CeNetUdp, CeNetUnix, CeNetDns, CeSignal, CeLog]

#[doc("True when each tabulated identity is the one its declaration's name and home derive.")]
pub(pkg) fn core_effects_are_derived() : Bool =
  all(core_effects(), (c) => core_effect_raw(c) == sym_raw(sym_derive(NCEffect, core_effect_name(c), core_effect_home(c))))

#[doc("True when `s` is the declaration of the core effect `c`. An unresolved id is no core effect.")]
pub(pkg) fn effect_is(s: SymId, c: CoreEffect) : Bool =
  sym_raw(s) >= 0 and sym_raw(s) == core_effect_raw(c)

#[doc("True when `s` is a capability tag that crosses to foreign code and has no handler: `Ffi` or `Js`.")]
pub(pkg) fn effect_is_foreign(s: SymId) : Bool = effect_is(s, CeFfi) or effect_is(s, CeJs)

#[doc("True when `s` is the declaration of one of the core effects `cs`.")]
pub(pkg) fn effect_is_any(s: SymId, cs: [CoreEffect]) : Bool = match cs {
  []           -> false
  [c, ...rest] -> effect_is(s, c) or effect_is_any(s, rest)
}

#[doc("The resolved row label of a core effect that takes no type argument.")]
pub(pkg) fn core_effect_label(c: CoreEffect) : Label =
  Label { sym: core_effect_id(c), ty_args: [], cell: local_none() }

#[doc("The row label, in a signature, of a core effect that takes no type argument.")]
pub(pkg) fn core_effect_row_label(c: CoreEffect) : RowLabel =
  RL(DrSym(core_effect_id(c)), [])

#[doc("The effects whose default handlers the runtime installs first, in its order; every other effect of the entry point's row follows in row order.")]
pub(pkg) fn default_install_first() : [CoreEffect] =
  [CeStdout, CeStderr, CeStdin, CeEnv, CeFile, CeClock,
   CeRandom, CeSecureRandom, CeNetTcp, CeNetDns, CeSignal, CeProcess, CeLog,
   CeMutable, CeCancel, CeLink, CeMonitor, CeSpawn]

#[doc("The effects of `row` in the order their default handlers install: those the runtime installs first, in its order, then the others in row order.")]
pub(pkg) fn default_install_order(row: [SymId]) : [SymId] = {
  let first = map(default_install_first(), core_effect_id)
  list_append(filter(first, (b) => effect_among(row, b)), filter(row, (s) => not effect_among(first, s)))
}

#[doc("True when the declared effect `s` is one of `ss`.")]
pub(pkg) fn effect_among(ss: [SymId], s: SymId) : Bool = match ss {
  []           -> false
  [h, ...rest] -> (sym_raw(s) >= 0 and sym_raw(h) == sym_raw(s)) or effect_among(rest, s)
}

#[doc("An op of a cell effect: the read and write of `State`, and the read of `Reader`.")]
pub(pkg) type CellOp = CellGet | CellSet | CellAsk

#[doc("The name a cell op is declared with in its effect.")]
pub(pkg) fn cell_op_name(o: CellOp) : String = match o {
  CellGet -> "get"
  CellSet -> "set"
  CellAsk -> "ask"
}

#[doc("The cell op declared under `name`, where an op is known only by its text.")]
pub(pkg) fn cell_op_named(name: String) : Option[CellOp] =
  if name == cell_op_name(CellGet) { Some(CellGet) }
  else if name == cell_op_name(CellSet) { Some(CellSet) }
  else if name == cell_op_name(CellAsk) { Some(CellAsk) }
  else { None }

#[doc("The op that reads a cell of effect `s`.")]
pub(pkg) fn cell_read_op(s: SymId) : CellOp = if effect_is(s, CeReader) { CellAsk } else { CellGet }

#[doc("The label an `as`-bound instance is installed under: a bare-name walk never matches it, the label of an op through the alias does.")]
pub(pkg) fn named_label(label: String) : String = string_concat("as#", label)

#[doc("The route of an op through an `as` alias whose binder is not in scope: the instance's own label for a user effect, the ambient walk for an id-addressed cell.")]
pub(pkg) fn untagged_alias_via(eff: SymId) : OpVia =
  if effect_is(eff, CeState) or effect_is(eff, CeReader) { ViaAmbient } else { ViaNamed }
