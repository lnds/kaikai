#[doc("""
The types the compiler treats specially beyond the always-available ones.

`Decimal`, `DecimalBig` and `BigInt` carry numeric literals, and `Seq`
is the lazy sequence whose cell the runtime owns. Each is a declaration
of a stdlib module, so its identity is the id the symbol table derives
for that declaration. A pass holding a nominal type's `SymId` asks
`ty_is` or `core_decl_ty_of` which of them it is.

`Map` and `HashMap` are the stdlib collections the index sugar reads
through their own module, each likewise a declaration with its id.

The runtime impl table numbers a closed set of heads. An impl names its
target by reference, and `rt_head_of_ref` says which head that is: a
declaration's by its id, a scalar's by the scalar it spells.

No other module spells one of these names to decide which type it has
in hand.
""")]

import compiler.ast
import compiler.decl_names
import compiler.symtab_build
import compiler.scalar_ty

#[doc("A stdlib-declared type the compiler treats specially, named without building its spelling.")]
pub type CoreDeclTy = CdDecimal | CdDecimalBig | CdBigInt | CdSeq

#[doc("Every stdlib-declared type the compiler treats specially.")]
pub fn core_decl_tys() : [CoreDeclTy] = [CdDecimal, CdDecimalBig, CdBigInt, CdSeq]

#[doc("True when the type `t` carries numeric literals.")]
pub fn core_decl_ty_is_numeric(t: CoreDeclTy) : Bool = match t {
  CdSeq -> false
  _     -> true
}

#[doc("The literal suffix that writes the type `t` (`19.99d` is a `Decimal`, `99n` a `BigInt`), or the empty string for a type no suffix writes.")]
pub fn core_decl_ty_suffix(t: CoreDeclTy) : String = match t {
  CdDecimal    -> "d"
  CdBigInt     -> "n"
  CdDecimalBig -> ""
  CdSeq        -> ""
}

#[doc("The function the `n` suffix calls with the literal's digits: the `from_literal` of the module that declares `BigInt`.")]
pub fn core_bigint_literal_fn() : SymId = SymId(core_bigint_literal_raw())

# Tabulated like the type ids: every call is asked whether it is this one.
fn core_bigint_literal_raw() : Int = 2815187083899997346

#[doc("`once(() => body)` of the module that declares `Seq`, by id: the initialiser of a constant whose type holds one, so a fiber evaluates `body` a single time.")]
pub fn seq_once_call(body: Expr) : Expr = {
  let once = mk_expr(ESym(sym_derive(NCFn, "once", core_decl_ty_home(CdSeq)), spec_none()), body.line, body.col)
  mk_expr(ECall(once, [mk_expr(ELambda([], body), body.line, body.col)]), body.line, body.col)
}

#[doc("The name the type `t` is declared with.")]
pub fn core_decl_ty_name(t: CoreDeclTy) : String = match t {
  CdDecimal    -> "Decimal"
  CdDecimalBig -> "DecimalBig"
  CdBigInt     -> "BigInt"
  CdSeq        -> "Seq"
}

#[doc("The stdlib module that declares the type `t`.")]
pub fn core_decl_ty_home(t: CoreDeclTy) : String = match t {
  CdDecimal    -> "decimal"
  CdDecimalBig -> "decimal_big"
  CdBigInt     -> "math__bigint"
  CdSeq        -> "seq"
}

#[doc("The identity of the type `t`: the id the symbol table gives its declaration.")]
pub fn core_decl_ty_id(t: CoreDeclTy) : SymId = SymId(core_decl_ty_raw(t))

# The id each declaration's name and home derive, tabulated: the test
# below runs on every match and every carrier check, and a derivation
# builds a string and hashes it.
fn core_decl_ty_raw(t: CoreDeclTy) : Int = match t {
  CdDecimal    -> 955402778915999600
  CdDecimalBig -> 1424877753137465621
  CdBigInt     -> 9083907095363097190
  CdSeq        -> 7541083128454955404
}

#[doc("True when each tabulated identity is the one its declaration's name and home derive.")]
pub fn core_decl_tys_are_derived() : Bool =
  all(core_decl_tys(), (t) => core_decl_ty_raw(t) == sym_raw(sym_derive(NCType, core_decl_ty_name(t), core_decl_ty_home(t))))
    and core_bigint_literal_raw() == sym_raw(sym_derive(NCFn, "from_literal", core_decl_ty_home(CdBigInt)))

#[doc("True when the nominal type `s` is the stdlib type `t`. An absent id is no type.")]
pub fn ty_is(s: SymId, t: CoreDeclTy) : Bool =
  sym_raw(s) >= 0 and sym_raw(s) == core_decl_ty_raw(t)

#[doc("The stdlib type `s` is the declaration of, or `None` for any other symbol.")]
pub fn core_decl_ty_of(s: SymId) : Option[CoreDeclTy] =
  if sym_raw(s) < 0 { None } else { find(core_decl_tys(), (t) => ty_is(s, t)) }

#[doc("The identity of `linalg`'s `Matrix`, whose two `Dim` habitant slots the compiler states for it.")]
pub fn linalg_matrix_id() : SymId = sym_derive(NCType, "Matrix", "math__linalg")

#[doc("A stdlib collection the index sugar reads through the `get` of its own module.")]
pub type CoreColl = CcMap | CcHashMap

#[doc("The name the collection `c` is declared with.")]
pub fn core_coll_name(c: CoreColl) : String = match c {
  CcMap     -> "Map"
  CcHashMap -> "HashMap"
}

#[doc("The stdlib module that declares the collection `c`.")]
pub fn core_coll_home(c: CoreColl) : String = match c {
  CcMap     -> "collections__map"
  CcHashMap -> "collections__hashmap"
}

#[doc("The stdlib collection `s` is the declaration of, or `None` for any other symbol.")]
pub fn core_coll_of(s: SymId) : Option[CoreColl] =
  if sym_raw(s) < 0 { None }
  else { find([CcMap, CcHashMap], (c) => sym_raw(s) == sym_raw(sym_derive(NCType, core_coll_name(c), core_coll_home(c)))) }

# Asked by spelling because the name has no declaration to carry an id:
# only the diagnostic for an unknown type reads this.
#[doc("The stdlib module that declares a type the compiler knows under `name`, or `None` for any other name.")]
pub fn stdlib_type_home(name: String) : Option[String] =
  match find(core_decl_tys(), (t) => core_decl_ty_name(t) == name) {
    Some(t) -> Some(core_decl_ty_home(t))
    None    -> match find([CcMap, CcHashMap], (c) => core_coll_name(c) == name) {
      Some(c) -> Some(core_coll_home(c))
      None    -> None
    }
  }

#[doc("A type the runtime impl table numbers with a fixed head tag.")]
pub type RtHead = RhUnit | RhBool | RhInt | RhReal | RhChar | RhString | RhList | RhArray
                | RhByte | RhVec | RhOption | RhResult | RhSignal | RhProcessExit
                | RhPair | RhTriple | RhQuad

#[doc("Every runtime head.")]
pub fn rt_heads() : [RtHead] =
  [RhUnit, RhBool, RhInt, RhReal, RhChar, RhString, RhList, RhArray,
   RhByte, RhVec, RhOption, RhResult, RhSignal, RhProcessExit, RhPair, RhTriple, RhQuad]

#[doc("The tag the runtime impl table numbers the head `h` with.")]
pub fn rt_head_tag(h: RtHead) : Int = match h {
  RhUnit        -> 1
  RhBool        -> 2
  RhInt         -> 3
  RhReal        -> 4
  RhChar        -> 5
  RhString      -> 6
  RhList        -> 7
  RhArray       -> 8
  RhByte        -> 9
  RhVec         -> 14
  RhOption      -> 16
  RhResult      -> 17
  RhSignal      -> 18
  RhProcessExit -> 19
  RhPair        -> 20
  RhTriple      -> 21
  RhQuad        -> 22
}

#[doc("The first head tag a user record or sum takes; the tags below it are the runtime's.")]
pub fn user_head_base() : Int = 23

#[doc("The home of the core module `effects/os.kai`: a core file's declarations take its basename.")]
pub fn os_module_home() : String = "os"

#[doc("The home of the core module `core/tuple.kai`.")]
pub fn tuple_module_home() : String = "tuple"

#[doc("True for the head of a tuple type.")]
pub fn rt_head_is_tuple(h: RtHead) : Bool = match h {
  RhPair   -> true
  RhTriple -> true
  RhQuad   -> true
  _        -> false
}

#[doc("The declaration the head `h` numbers; the head of a scalar has none, which reads as no declaration.")]
pub fn rt_head_decl_sym(h: RtHead) : SymId = match rt_head_decl(h) {
  Some(s) -> s
  None    -> sym_none()
}

# The declaration a head numbers. A scalar has none.
fn rt_head_decl(h: RtHead) : Option[SymId] = match h {
  RhList        -> Some(core_ty_sym(CtList))
  RhArray       -> Some(core_ty_sym(CtArray))
  RhVec         -> Some(core_ty_sym(CtVec))
  RhOption      -> Some(core_ty_sym(CtOption))
  RhResult      -> Some(core_ty_sym(CtResult))
  RhSignal      -> Some(sym_derive(NCType, "Signal", os_module_home()))
  RhProcessExit -> Some(sym_derive(NCType, "ProcessExit", os_module_home()))
  RhPair        -> Some(sym_derive(NCType, "Pair", tuple_module_home()))
  RhTriple      -> Some(sym_derive(NCType, "Triple", tuple_module_home()))
  RhQuad        -> Some(sym_derive(NCType, "Quad", tuple_module_home()))
  _             -> None
}

fn rt_head_of_scalar(t: Ty) : Option[RtHead] = match t {
  TyUnit   -> Some(RhUnit)
  TyBool   -> Some(RhBool)
  TyInt    -> Some(RhInt)
  TyReal   -> Some(RhReal)
  TyChar   -> Some(RhChar)
  TyString -> Some(RhString)
  TyByte   -> Some(RhByte)
  _        -> None
}

#[doc("The runtime head the declaration `s` is numbered with, or `None` when the runtime gives it no fixed head.")]
pub fn rt_head_of_sym(s: SymId) : Option[RtHead] =
  if sym_raw(s) < 0 { None }
  else { find(rt_heads(), (h) => match rt_head_decl(h) { Some(d) -> sym_same(d, s) None -> false }) }

#[doc("The runtime head the type reference `r` names: a declaration's by its id, a scalar's by the scalar it spells. `None` for a type the runtime gives no fixed head.")]
pub fn rt_head_of_ref(r: DeclRef) : Option[RtHead] = match r {
  DrSym(s)        -> rt_head_of_sym(s)
  DrWritten(_, _) -> match scalar_ty_named(ref_spelled(r)) {
    Some(t) -> rt_head_of_scalar(t)
    None    -> None
  }
}

#[doc("The stdlib modules whose functions the compiler writes into a program by identity: the homes of the special types and of the index-sugar collections.")]
pub fn core_special_homes() : [String] =
  list_append(map(core_decl_tys(), core_decl_ty_home), map([CcMap, CcHashMap], core_coll_home))
