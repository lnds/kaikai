#[doc("""
The types the compiler treats specially beyond the always-available ones.

`Decimal`, `DecimalBig` and `BigInt` carry numeric literals. Each is a
declaration of a stdlib module, so its identity is the id the symbol
table derives for that declaration. A pass holding a nominal type's
`SymId` asks `ty_is` or `core_decl_ty_of` which of them it is; one
holding a head that may name no declaration asks `core_decl_ty_head`.

`Map` and `HashMap` are the stdlib collections the index sugar reads
through their own module, each likewise a declaration with its id.

The runtime impl table numbers a closed set of heads. A lowered impl
symbol carries its target type as a spelling and no id, and
`rt_head_named` reads that spelling against the one name table.

No other module spells one of these names to decide which type it has
in hand.
""")]

import compiler.ast
import compiler.decl_names
import compiler.symtab_build

#[doc("A stdlib-declared type the compiler treats specially, named without building its spelling.")]
pub type CoreDeclTy = CdDecimal | CdDecimalBig | CdBigInt

#[doc("Every stdlib-declared type the compiler treats specially.")]
pub fn core_decl_tys() : [CoreDeclTy] = [CdDecimal, CdDecimalBig, CdBigInt]

#[doc("The name the type `t` is declared with.")]
pub fn core_decl_ty_name(t: CoreDeclTy) : String = match t {
  CdDecimal    -> "Decimal"
  CdDecimalBig -> "DecimalBig"
  CdBigInt     -> "BigInt"
}

#[doc("The stdlib module that declares the type `t`.")]
pub fn core_decl_ty_home(t: CoreDeclTy) : String = match t {
  CdDecimal    -> "decimal"
  CdDecimalBig -> "decimal_big"
  CdBigInt     -> "math__bigint"
}

#[doc("The identity of the type `t`: the id the symbol table gives its declaration.")]
pub fn core_decl_ty_id(t: CoreDeclTy) : SymId =
  sym_derive(NCType, core_decl_ty_name(t), core_decl_ty_home(t))

#[doc("True when the nominal type `s` is the stdlib type `t`. An absent id is no type.")]
pub fn ty_is(s: SymId, t: CoreDeclTy) : Bool =
  sym_raw(s) >= 0 and sym_raw(s) == sym_raw(core_decl_ty_id(t))

#[doc("The stdlib type `s` is the declaration of, or `None` for any other symbol.")]
pub fn core_decl_ty_of(s: SymId) : Option[CoreDeclTy] =
  if sym_raw(s) < 0 { None } else { find(core_decl_tys(), (t) => ty_is(s, t)) }

# A program that never imports the declaring module can still write one
# of these names: the type then has no declaration, and its spelling is
# all it carries.
#[doc("The stdlib type the nominal head `n` (identity `s`) is: by identity whenever it carries one, by its name when it carries none.")]
pub fn core_decl_ty_head(n: String, s: SymId) : Option[CoreDeclTy] =
  if sym_raw(s) >= 0 { core_decl_ty_of(s) }
  else { find(core_decl_tys(), (t) => core_decl_ty_name(t) == n) }

#[doc("A stdlib collection the index sugar reads through the `get` of its own module.")]
pub type CoreColl = CcMap | CcHashMap

#[doc("The name the collection `c` is declared with.")]
pub fn core_coll_name(c: CoreColl) : String = match c {
  CcMap     -> "Map"
  CcHashMap -> "HashMap"
}

#[doc("The stdlib module that declares the collection `c`.")]
pub fn core_coll_home(c: CoreColl) : String = match c {
  CcMap     -> "collections__map"
  CcHashMap -> "collections__hashmap"
}

#[doc("The stdlib collection `s` is the declaration of, or `None` for any other symbol.")]
pub fn core_coll_of(s: SymId) : Option[CoreColl] =
  if sym_raw(s) < 0 { None }
  else { find([CcMap, CcHashMap], (c) => sym_raw(s) == sym_raw(sym_derive(NCType, core_coll_name(c), core_coll_home(c)))) }

#[doc("A type the runtime impl table numbers with a fixed head tag.")]
pub type RtHead = RhUnit | RhBool | RhInt | RhReal | RhChar | RhString | RhList | RhArray
                | RhByte | RhVec | RhOption | RhResult | RhSignal | RhProcessExit

#[doc("Every runtime head.")]
pub fn rt_heads() : [RtHead] =
  [RhUnit, RhBool, RhInt, RhReal, RhChar, RhString, RhList, RhArray,
   RhByte, RhVec, RhOption, RhResult, RhSignal, RhProcessExit]

#[doc("The name a lowered impl symbol spells the runtime head `h` with.")]
pub fn rt_head_name(h: RtHead) : String = match h {
  RhUnit        -> "Unit"
  RhBool        -> "Bool"
  RhInt         -> "Int"
  RhReal        -> "Real"
  RhChar        -> "Char"
  RhString      -> "String"
  RhList        -> core_ty_name(CtList)
  RhArray       -> core_ty_name(CtArray)
  RhByte        -> "Byte"
  RhVec         -> core_ty_name(CtVec)
  RhOption      -> core_ty_name(CtOption)
  RhResult      -> core_ty_name(CtResult)
  RhSignal      -> "Signal"
  RhProcessExit -> "ProcessExit"
}

#[doc("The tag the runtime impl table numbers the head `h` with.")]
pub fn rt_head_tag(h: RtHead) : Int = match h {
  RhUnit        -> 1
  RhBool        -> 2
  RhInt         -> 3
  RhReal        -> 4
  RhChar        -> 5
  RhString      -> 6
  RhList        -> 7
  RhArray       -> 8
  RhByte        -> 9
  RhVec         -> 14
  RhOption      -> 16
  RhResult      -> 17
  RhSignal      -> 18
  RhProcessExit -> 19
}

#[doc("The runtime head spelled `name`, or `None`: what the type part of a lowered impl symbol names.")]
pub fn rt_head_named(name: String) : Option[RtHead] =
  find(rt_heads(), (h) => rt_head_name(h) == name)
