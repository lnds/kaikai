#[doc("The formatter's shapes: bodies, chains, names and refinements.")]

# compiler/fmt_shape.kai — the questions `kai fmt` asks about a node
# before it picks a layout.
#
# Every entry here is a pure query over the AST: does this expression
# print as an atom, does it start with a `{`, how many trailing block
# lambdas does an argument list end in, which source line does a
# statement sit on. The writer branches on the answers; nothing here
# emits, so nothing here belongs in the mutually-recursive walker
# (compiler/fmt_expr.kai) that does.
#
# The walker's recursion cycle survives the split because no query
# calls back into it. The width model (compiler/fmt_layout.kai) asks
# its shape questions here too: where an expression starts, whether it
# opens a block, whether a list packs into rows.

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_map
import compiler.operators
import compiler.util
import compiler.written
import compiler.kinds
import compiler.type_text
import compiler.symtab

#[doc("The literal suffix that reproduces an `EFixed` node's width type.")]
pub(pkg) fn fmt_fixed_suffix(ty: Ty) : String = match ty {
  TyByte   -> "u8"
  TyInt32  -> "i32"
  TyUInt32 -> "u32"
  TyUInt64 -> "u64"
  _        -> "i128"
}

fn fmt_is_scalar(e: Expr) : Bool = match e.kind {
  EInt(_, _) -> true
  EReal(_, _) -> true
  EIntLit(_) -> true
  EDecimalLit(_) -> true
  EFixed(_, _) -> true
  EBool(_) -> true
  EChar(_) -> true
  EStr(_, _) -> true
  EUnit -> true
  EName(_) -> true
  ESym(_, _) -> true
  ELocal(_) -> true
  EOp(_) -> true
  ELitUnit(inner, _) -> fmt_is_scalar(inner)
  ESurface(sf) -> match sf {
    SfBigIntLit(_)    -> true
    SfInterp(_, _, _, _) -> true
    _                 -> false
  }
  _ -> false
}

#[doc("True when the callee is the `??` mark, whose call prints as an infix operator.")]
pub(pkg) fn fmt_is_coalesce_callee(callee: Expr) : Bool = match callee.kind {
  EMark(MkCoalesce) -> true
  _ -> false
}

# A unit annotation binds by lexical adjacency to its literal, so
# `3<m>` is self-delimiting exactly when its interior is.
#[doc("True when the expression prints as a self-delimiting form, so an enclosing operator needs no parentheses around it.")]
pub(pkg) fn expr_is_atomic(e: Expr) : Bool {
  match e.kind {
    ELitUnit(inner, _) -> expr_is_atomic(inner)
    EUnder -> true
    EPlaceholder -> true
    EHole(_) -> true
    ETodo(_) -> true
    EExternBody(_, _) -> true
    # A `lhs |> f(_)` placeholder pipe is a call underneath, but it prints
    # as a pipe and binds as loosely as one.
    ECall(callee, _) -> not is_pipe_apply_lambda(callee) and not fmt_is_coalesce_callee(callee)
    EField(_, _) -> true
    EModCall(_, _) -> true
    EIndex(_, _) -> true
    ERecordLit(_, _) -> true
    EList(_) -> true
    EBlock(_, _) -> true
    ERange(_, _, _) ->
    # `[lo..hi]` form prints as a self-bounded literal, no paren needed.
    true
    # A block lambda prints as its own `{ ... }` delimiters.
    ESurface(sf) -> match sf {
      SfLamBlock(_, _)        -> true
      SfSteppedRange(_, _, _) -> true
      SfEndlessRange(_, _)    -> true
      SfLazy(_)               -> true
      SfBigIntLit(_)          -> true
      SfInterp(_, _, _, _)       -> true
      _                       -> false
    }
    _ -> fmt_is_scalar(e)
  }
}

# Postfix and infix forms inherit the answer from their leftmost
# operand; everything else opens with its own token and is safe.
#[doc("Leftmost-constituent descent: true when the expression prints starting with a `Name {` record literal.")]
pub(pkg) fn fmt_head_is_record_lit(e: Expr) : Bool = match e.kind {
  ERecordLit(_, _)      -> true
  EBlock(_, _)       -> true
  ESurface(sf)       -> match sf { SfLamBlock(_, _) -> true  _ -> false }
  EField(obj, _)     -> fmt_head_is_record_lit(obj)
  EIndex(obj, _)     -> fmt_head_is_record_lit(obj)
  ECall(callee, _)   -> fmt_head_is_record_lit(callee)
  EBang(inner)       -> fmt_head_is_record_lit(inner)
  EBinop(_, l, _)    -> fmt_head_is_record_lit(l)
  EPipe(l, _)        -> fmt_head_is_record_lit(l)
  EDispatchPipe(_, l, _) -> fmt_head_is_record_lit(l)
  ELitUnit(inner, _) -> fmt_head_is_record_lit(inner)
  _ -> false
}

#[doc("The arm behind a `{ pat -> body }` block lambda: the synthetic position-keyed binder matched by a single irrefutable arm, or None for a lambda the author wrote in full.")]
pub(pkg) fn lam_block_wrap_arm(params: [Param], body: Expr) : Option[Arm] = match params {
  [pm] -> match body.kind {
    EMatch(scrut, arms) -> match arms {
      [Arm(pat, None, abody)] ->
        if fmt_reads_local(scrut, pm.binder.id) and local_eq(pm.binder.id, local_minted(lam_pat_binder_name(pat.line, pat.col))) {
          Some(Arm(pat, None, abody))
        } else { None }
      _ -> None
    }
    _ -> None
  }
  _ -> None
}

fn is_pipe_apply_lambda(callee: Expr) : Bool = match callee.kind {
  ELambda([prm], _) -> local_eq(prm.binder.id, pipe_apply_binder().id)
  _                 -> false
}

# The pipe-placeholder desugar (`lhs |> f(_, y)` into
# `((__pipe) => f(__pipe, y))(lhs)`) and the point-free argument
# desugar (`f(. < 3)` into `f((__pl) => __pl < 3)`) both mint a fixed
# reserved binder, so the writer restores the author's spelling by
# structure: the parser is the only producer of those binders.
#[doc("The body of a point-free section with its `__pl` binder restored to `.`, or None when the lambda is the author's own.")]
pub(pkg) fn fmt_placeholder_body(params: [Param], body: Expr) : Option[Expr] =
  if params_point_free(params) { Some(fmt_subst_var(body, point_free_binder().id, EPlaceholder)) }
  else { None }

fn fmt_reads_local(e: Expr, l: LocalId) : Bool = match e.kind {
  ELocal(r) -> local_eq(r, l)
  _         -> false
}

fn fmt_subst_var(e: Expr, l: LocalId, to: ExprKind) : Expr = match e.kind {
  ELocal(r) ->
    if local_eq(r, l) { Expr { kind: to, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site } }
    else { e }
  # A nested lambda re-binding the same binder shadows it; stop there.
  ELambda(ps, _) ->
    if fsv_binds(ps, l) { e }
    else { Expr { kind: prc_map_expr_kind(e.kind, (x) => fmt_subst_var(x, l, to)),
                  line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site } }
  _ -> Expr { kind: prc_map_expr_kind(e.kind, (x) => fmt_subst_var(x, l, to)),
              line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
}

fn fsv_binds(ps: [Param], l: LocalId) : Bool = match ps {
  [] -> false
  [prm, ...rest] -> local_eq(prm.binder.id, l) or fsv_binds(rest, l)
}

# ---- width-model queries ---------------------------------------------

# Anything that opens a delimiter and lays its contents out below it.
fn fmt_is_block_like(e: Expr) : Bool = match e.kind {
  EList(_) -> true
  ERecordLit(_, _) -> true
  EBlock(_, _) -> true
  EMatch(_, _) -> true
  EIf(_, _, _) -> true
  EHandle(_, _, _, _, _, _, _) -> true
  ELambda(_, body) -> match body.kind { EBlock(_, _) -> true  _ -> false }
  ESurface(sf) -> match sf {
    SfLamBlock(_, _) -> true
    SfMapLit(_, _) -> true
    SfSetLit(_, _) -> true
    SfCaseBlock(_) -> true
    SfMultiMatch(_, _) -> true
    _ -> false
  }
  _ -> false
}

#[doc("True when every expression is a single literal or name.")]
pub(pkg) fn fmt_all_scalar(es: [Expr]) : Bool = match es {
  [] -> true
  [x, ...rest] -> fmt_is_scalar(x) and fmt_all_scalar(rest)
}

#[doc("True when every list element is a plain literal or name; a spread is not.")]
pub(pkg) fn fmt_all_scalar_elems(elems: [ListElem]) : Bool = match elems {
  [] -> true
  [ElPlain(x), ...rest] -> fmt_is_scalar(x) and fmt_all_scalar_elems(rest)
  [ElSpread(_), ..._rest] -> false
}

#[doc("True when the last expression of the list is block-like.")]
pub(pkg) fn fmt_last_is_block_like(es: [Expr]) : Bool = match es {
  [] -> false
  [x] -> fmt_is_block_like(x)
  [_, ...rest] -> fmt_last_is_block_like(rest)
}

# Contract clauses and case-blocks bring their own opener.
#[doc("The token that opens a function body on the signature line: ` {` for a block, ` =` for an expression, nothing for a form that opens itself.")]
pub(pkg) fn fmt_fn_opener(body: Expr) : String = match body.kind {
  EBlock(_, _) -> " {"
  ESurface(sf) -> match sf {
    SfContract(_, _, _) -> ""
    SfCaseBlock(_) -> ""
    _ -> " ="
  }
  _ -> " ="
}

# A run counter: an interior block arg (`f({ x -> x }, y)`) resets it.
#[doc("Length of the suffix of `args` written as trailing blocks (`f(a) { .. } { .. }`), at most two by the grammar.")]
pub(pkg) fn fmt_count_trailing(args: [Expr], run: Int) : Int = match args {
  [] -> run
  [a, ...rest] -> fmt_count_trailing(rest, match a.kind {
    ESurface(sf) -> match sf { SfLamBlock(_, true) -> run + 1  _ -> 0 }
    _ -> 0
  })
}

#[doc("The first `n` arguments, or all of them when `n` exceeds the list.")]
pub(pkg) fn fmt_args_take(args: [Expr], n: Int) : [Expr] =
  if n <= 0 { [] } else { match args {
    [] -> []
    [a, ...rest] -> [a, ...fmt_args_take(rest, n - 1)]
  } }

#[doc("The arguments after the first `n`.")]
pub(pkg) fn fmt_args_drop(args: [Expr], n: Int) : [Expr] =
  if n <= 0 { args } else { match args {
    [] -> []
    [_, ...rest] -> fmt_args_drop(rest, n - 1)
  } }

# Both spellings fill one AST slot; the clause form arrives wrapped in
# `SfHandleInit`, which is what tells them apart.
#[doc("The body of a handler's `initially { }` clause, or None when the state was written as `(init)` or omitted.")]
pub(pkg) fn handle_init_clause(init_opt: Option[Expr]) : Option[Expr] = match init_opt {
  None -> None
  Some(ie) -> match ie.kind {
    ESurface(sf) -> match sf {
      SfHandleInit(inner) -> Some(inner)
      _ -> None
    }
    _ -> None
  }
}

#[doc("True for a handler's `initially`/`finally` clause, as opposed to an operation clause.")]
pub(pkg) fn fmt_is_lifecycle_clause(h: ClauseHead) : Bool = match h {
  ChInitially -> true
  ChFinally   -> true
  ChOp(_)     -> false
}

#[doc("Source line of the first type in the list, 0 when empty: the opener line a row label's arguments are measured against.")]
pub(pkg) fn fmt_first_type_line(tys: [TypeExpr]) : Int = match tys {
  [] -> 0
  [t, ..._rest] -> t.line
}

#[doc("True when an arrow lambda's body must be parenthesised to reparse as the same expression: its top node binds looser than the `or` rung the body is read at.")]
pub(pkg) fn lam_body_needs_parens(body: Expr) : Bool = match body.kind {
  EPipe(_, _) -> true
  EDispatchPipe(_, _, _) -> true
  _ -> false
}

# The ladder, tightest last. `-` and `%` share their levels but never
# lead a continuation line (both can open an expression).
fn binop_prec(op: BinOp) : Int = match op {
  BoOr     -> 1
  BoAnd    -> 2
  BoEq     -> 3
  BoNe     -> 3
  BoLt     -> 3
  BoGt     -> 3
  BoLe     -> 3
  BoGe     -> 3
  BoConcat -> 4
  BoAdd    -> 5
  BoSub    -> 5
  BoMul    -> 6
  BoDiv    -> 6
  BoMod    -> 6
  BoPow    -> 7
}

fn binop_right_assoc(op: BinOp) : Bool = match op {
  BoConcat -> true
  BoPow    -> true
  _        -> false
}

#[doc("True when a `child` operator's expression must be parenthesised as the left or right operand of `parent`.")]
pub(pkg) fn binop_operand_needs_parens(parent: BinOp, child: BinOp, is_right: Bool) : Bool {
  let pp = binop_prec(parent)
  let cp = binop_prec(child)
  if cp != pp { cp < pp }
  else if binop_is_comparison(parent) { true }
  else if binop_right_assoc(parent) { not is_right }
  else { is_right }
}

#[doc("An operator chain flattened from a nest of same-level operators: the first operand and each following (operator, operand) link.")]
pub(pkg) type Chain[o] = Chain(Expr, [ChainOp[o]])

#[doc("One link of a chain: the operator (a `BinOp`, or a pipe's text), its source position, and its right operand.")]
pub(pkg) type ChainOp[o] = ChainOp(o, Int, Int, Expr)

# Same level and same associativity flatten; a comparison never chains.
fn binop_same_level(op: BinOp, other: BinOp) : Bool =
  ((binop_prec(op) == binop_prec(other)) and (not binop_is_comparison(op))) and (binop_right_assoc(op) == binop_right_assoc(other))

#[doc("The chain a binary node heads: a left-associative nest flattens down its left spine, a right-associative one down its right spine.")]
pub(pkg) fn binop_chain(op: BinOp, l: Expr, r: Expr, line: Int, col: Int) : Chain[BinOp] =
  if binop_right_assoc(op) { Chain(l, binop_right_spine(op, r, line, col)) }
  else {
    match binop_left_spine(op, l) {
      Chain(first, links) -> Chain(first, list_append(links, [ChainOp(op, line, col, r)]))
    }
  }

fn binop_left_spine(op: BinOp, l: Expr) : Chain[BinOp] = match l.kind {
  EBinop(op2, l2, r2) ->
    if binop_same_level(op, op2) {
      match binop_left_spine(op2, l2) {
        Chain(first, links) -> Chain(first, list_append(links, [ChainOp(op2, l.line, l.col, r2)]))
      }
    } else { Chain(l, []) }
  _ -> Chain(l, [])
}

fn binop_right_spine(op: BinOp, r: Expr, line: Int, col: Int) : [ChainOp[BinOp]] = match r.kind {
  EBinop(op2, l2, r2) ->
    if binop_same_level(op, op2) { [ChainOp(op, line, col, l2), ...binop_right_spine(op2, r2, r.line, r.col)] }
    else { [ChainOp(op, line, col, r)] }
  _ -> [ChainOp(op, line, col, r)]
}

#[doc("True when a chain holding `-` or `%` must trail its operators: neither may open a continuation line.")]
pub(pkg) fn chain_trails(links: [ChainOp[BinOp]]) : Bool = match links {
  [] -> false
  [ChainOp(op, _, _, _), ...rest] -> binop_trails(op) or chain_trails(rest)
}

fn binop_trails(op: BinOp) : Bool = match op {
  BoSub -> true
  BoMod -> true
  _     -> false
}

# The four pipes share one level and one associativity; the placeholder
# desugar (`lhs |> f(_, y)`) reaches the writer as a call and joins the
# spine like any other stage.
#[doc("The pipe chain a pipe node heads, flattened down its left spine; the operand of each link is the stage as the author wrote it.")]
pub(pkg) fn pipe_chain(e: Expr) : Chain[String] = match e.kind {
  EPipe(l, r) -> pipe_extend(l, "|>", e, r)
  EDispatchPipe(op, l, r) -> pipe_extend(l, pipe_op_text(op), e, r)
  ECall(callee, call_args) -> match fmt_pipe_under(callee, call_args) {
    Some(PU(lhs, rhs)) -> pipe_extend(lhs, "|>", e, rhs)
    None -> Chain(e, [])
  }
  _ -> Chain(e, [])
}

fn pipe_extend(l: Expr, op: String, at: Expr, r: Expr) : Chain[String] = match pipe_chain(l) {
  Chain(first, links) -> Chain(first, list_append(links, [ChainOp(op, at.line, at.col, r)]))
}

# ---- expression heads --------------------------------------------------

# Postfix and infix nodes are positioned at their operator token; the
# author's line break sits before the leftmost operand instead.
#[doc("The node whose position is the expression's first source token.")]
pub(pkg) fn fmt_leftmost(e: Expr) : Expr = match e.kind {
  ECall(callee, call_args) -> match fmt_pipe_under(callee, call_args) {
    Some(PU(lhs, _)) -> fmt_leftmost(lhs)
    None -> match fmt_call_literal(callee, call_args) {
      Some(_) -> e
      None -> fmt_leftmost(callee)
    }
  }
  EField(obj, _) -> match obj.kind { EPlaceholder -> e  _ -> fmt_leftmost(obj) }
  EIndex(obj, _) -> fmt_leftmost(obj)
  EBang(inner) -> fmt_leftmost(inner)
  EBinop(_, l, _) -> fmt_leftmost(l)
  EPipe(l, _) -> fmt_leftmost(l)
  EDispatchPipe(_, l, _) -> fmt_leftmost(l)
  ELitUnit(inner, _) -> fmt_leftmost(inner)
  _ -> e
}

pub(pkg) type PipeUnder = PU(Expr, Expr)

#[doc("Recover a placeholder pipe from the call the parser desugared it to.")]
pub(pkg) fn fmt_pipe_under(callee: Expr, call_args: [Expr]) : Option[PipeUnder] =
  match callee.kind {
    ELambda(params, body) -> match params {
      [prm] ->
        if local_eq(prm.binder.id, pipe_apply_binder().id) {
          match call_args {
            [lhs] -> Some(PU(lhs, fmt_subst_var(body, prm.binder.id, EUnder)))
            _     -> None
          }
        } else { None }
      _ -> None
    }
    _ -> None
  }

#[doc("The source line a statement sits on.")]
pub(pkg) fn stmt_line(st: Stmt) : Int {
  match st {
    SLet(p, _, _) -> p.line
    SAssert(e, _) -> fmt_leftmost(e).line
    SExprStmt(e) -> fmt_leftmost(e).line
    SIndexAssign(_, _, _, line, _) -> line
    SAssign(_, _, line, _) -> line
    SVar(_, _, _, line, _) -> line
    SUse(_, line, _) -> line
  }
}

#[doc("True when the author wrote every branch of an `if` on its head line `line`, each branch a lone tail expression or statement: the shape that may stay on one line.")]
pub(pkg) fn fmt_if_inline_written(line: Int, then_e: Expr, else_opt: Option[Expr]) : Bool =
  fmt_branch_inline_written(line, then_e) and match else_opt {
    None -> true
    Some(e) -> match e.kind {
      EIf(_, t2, e2) -> fmt_if_inline_written(line, t2, e2)
      _ -> fmt_branch_inline_written(line, e)
    }
  }

fn fmt_branch_inline_written(line: Int, br: Expr) : Bool = match br.kind {
  EBlock(stmts, tail) -> match stmts {
    [] -> match tail { Some(t) -> fmt_leftmost(t).line == line  None -> false }
    [st] -> match tail { None -> stmt_line(st) == line  Some(_) -> false }
    _ -> false
  }
  _ -> fmt_leftmost(br).line == line
}

# Same shape as `decls_trailing_limit` — see that comment for the
# rationale. For the last stmt, callers pass `last_limit`:
#   > 0   = the line of the next AST anchor after the block (e.g.
#            the tail expression's line). Lets multi-line trailings
#            on the last stmt drain inline.
#   == 0  = no anchor known (block has no tail). Falls back to
#            `stmt_line(st) + 1` — single-line trailings still
#            drain, multi-line trailings on the last stmt of a
#            tail-less block stay full-line-demoted.
#[doc("Exclusive upper source line for draining a statement's trailing comment: the next statement's line, or `last_limit` for the last one.")]
pub(pkg) fn stmts_trailing_limit(st: Stmt, rest: [Stmt], last_limit: Int) : Int {
  match rest {
    [] -> if last_limit > 0 {
      last_limit
    } else {
      stmt_line(st) + 1
    }
    [next, ..._tail] -> stmt_line(next)
  }
}

# ---- arms and clauses -------------------------------------------------

#[doc("The source line a match arm opens on.")]
pub(pkg) fn arm_line(a: Arm) : Int = match a { Arm(pat, _, _) -> pat.line }

# A trailing comment belongs to the arm until the next arm opens; for
# the last arm, until the line below its body's head.
#[doc("Exclusive upper source line for draining a match arm's trailing comment.")]
pub(pkg) fn arm_trailing_limit(a: Arm, rest: [Arm]) : Int = match rest {
  [next, ..._more] -> arm_line(next)
  [] -> match a { Arm(_, _, body) -> fmt_leftmost(body).line + 1 }
}

fn mmarm_line(a: MMArm) : Int = match a {
  MMArm([p, ..._more], _, _) -> p.line
  MMArm([], _, body) -> fmt_leftmost(body).line
}

#[doc("Exclusive upper source line for draining a multi-pattern arm's trailing comment.")]
pub(pkg) fn mmarm_trailing_limit(a: MMArm, rest: [MMArm]) : Int = match rest {
  [next, ..._more] -> mmarm_line(next)
  [] -> match a { MMArm(_, _, body) -> fmt_leftmost(body).line + 1 }
}

#[doc("The source line a handler clause opens on.")]
pub(pkg) fn hclause_line(c: HClause) : Int = match c { HC(_, _, _, line, _) -> line }

#[doc("Exclusive upper source line for draining a handler clause's trailing comment: the next clause's line, or the line below the last clause's body head.")]
pub(pkg) fn hclause_trailing_limit(c: HClause, rest: [HClause]) : Int = match rest {
  [next, ..._more] -> hclause_line(next)
  [] -> match c { HC(_, _, body, _, _) -> fmt_leftmost(body).line + 1 }
}

#[doc("A type parameter as the source spells it, kind or bounds included.")]
pub(pkg) fn fmt_tparam(b: TBinder) : String = match b.kind {
  KUnit(k) -> string_concat_all([written_text(b.name), ": ", k])
  KShape   -> string_concat_all([written_text(b.name), ": Shape"])
  _        -> match b.bounds {
    [] -> written_text(b.name)
    bs -> string_concat_all([written_text(b.name), ": ", string_join(map(bs, fmt_bound), " + ")])
  }
}

fn fmt_bound(r: DeclRef) : String = match r {
  DrWritten(Some(q), n) -> string_concat_all([written_text(q), ".", written_text(n)])
  DrWritten(None, n)    -> written_text(n)
  DrSym(_)              -> "?"
}

#[doc("A row's open tail as the source spells it: a row variable's name, or `?` / `?name` for a hole.")]
pub(pkg) fn fmt_row_tail(tail: TParamRef) : String = tail_written_text(tail)

# Emit a UnitExprT in surface form the parser accepts. This is
# stricter than `unit_expr_display` (which uses bare juxtaposition
# `kg m` for products); the parser only recognises `*`, `/` and `+`
# between unit terms (see `parse_unit_expr_rest`).
# Used by `fmt` for `unit` declarations and `<...>` literal/type
# annotations so the formatter's output re-parses cleanly.
#[doc("Render a unit expression in the surface form the parser accepts, with explicit `*`, `/` and `+`.")]
pub(pkg) fn fmt_unit_expr_str(u: UnitExprT) : String = match u {
  UOne -> "1"
  USym(s) -> if kind_sym_is_qualified(s) {
    concat_all([kind_sym_kind(s), ".", kind_sym_bare(s)])
  } else { kind_sym_bare(s) }
  UMul(a, b) -> match b {
    UInv(bi) -> match a {
      UOne -> concat_all(["1/", fmt_unit_expr_str(bi)])
      _    -> concat_all([fmt_unit_expr_str(a), "/", fmt_unit_expr_str(bi)])
    }
    UOne -> fmt_unit_expr_str(a)
    _ -> match a {
      UOne          -> fmt_unit_expr_str(b)
      UInv(ai)      -> concat_all([fmt_unit_expr_str(b), "/", fmt_unit_expr_str(ai)])
      _             -> concat_all([fmt_unit_expr_str(a), "*", fmt_unit_expr_str(b)])
    }
  }
  UInv(a) -> concat_all(["1/", fmt_unit_expr_str(a)])
  UPow(a, n) -> concat_all([fmt_unit_expr_str(a), "^", int_to_string(n)])
  UJoin(a, b) -> concat_all([fmt_unit_expr_str(a), " + ", fmt_unit_expr_str(b)])
  UVar(n) -> cat2("?u", int_to_string(n))
  UDims(us) -> fmt_unit_exprs_str(us)
  UParam(_) -> "?"
}

fn fmt_unit_exprs_str(us: [UnitExprT]) : String = match us {
  [] -> ""
  [u] -> fmt_unit_expr_str(u)
  [u, ...rest] -> concat_all([fmt_unit_expr_str(u), ", ", fmt_unit_exprs_str(rest)])
}

#[doc("A recovered `where` elision: the leading keyword or operator, and the expression that follows it.")]
pub(pkg) type RefineElision = RE(String, Expr)

fn fmt_regex_sigil(callee: Expr, call_args: [Expr]) : Option[String] =
  match call_args {
    [arg0] -> if fmt_callee_is_regex_compile(callee) { fmt_sigil_of(arg0) } else { None }
    _      -> None
  }

#[doc("The receiver elision behind a `where` predicate refining `base`, or None when the predicate was written in full.")]
pub(pkg) fn fmt_refine_elision(base: TypeExpr, pred: Expr) : Option[RefineElision] =
  fmt_elision_at(base.line, base.col, pred)

#[doc("The receiver elision behind a `where` predicate whose synthetic `self` was minted at (line, col) — the base type's position for a refinement, the `ensure` token's for `ensure(v) where`.")]
pub(pkg) fn fmt_elision_at(line: Int, col: Int, pred: Expr) : Option[RefineElision] = match pred.kind {
  EBinop(op, lhs, rhs) ->
    if binop_is_comparison(op) and fmt_is_elided_self(lhs, line, col) {
      Some(RE(concat_all([binop_text(op), " "]), rhs))
    } else { None }
  ECall(callee, cargs) -> fmt_matches_elision(callee, cargs, line, col)
  _ -> None
}

# `matches(self, rhs)`, where the sugar minted the receiver. The callee
# sits at the `matches` token, so it is the `self` argument alone that
# betrays the elision.
fn fmt_matches_elision(callee: Expr, cargs: [Expr], line: Int, col: Int) : Option[RefineElision] =
  match cargs {
    [recv, rhs] ->
      if fmt_var_is(callee, "matches") and fmt_is_elided_self(recv, line, col) {
        Some(RE("matches ", rhs))
      } else { None }
    _ -> None
  }

# The synthetic receiver is minted at the anchor position — the one
# place inside the predicate no operand can occupy, since every operand
# is written after the `where`. A written-out `self` never lands on it.
fn fmt_is_elided_self(e: Expr, line: Int, col: Int) : Bool =
  fmt_var_is(e, "self") and e.line == line and e.col == col

fn fmt_var_is(e: Expr, name: String) : Bool = match e.kind {
  EName(n) -> written_text(n) == name
  _        -> false
}

# Only the sigil parser mints an `EModCall` this early — a hand-written
# `regexp.compile_or_panic(p)` is still an `EField` when the writer runs,
# since the qualified-call resolver has not yet rewritten it. A resolved
# predicate printed in a message names that function by its id.
fn fmt_callee_is_regex_compile(callee: Expr) : Bool = match callee.kind {
  EModCall(m, fname) -> written_text(m) == "regexp" and written_text(fname) == "compile_or_panic"
  ESym(s, _)         -> sym_raw(s) == sym_raw(sym_derive(NCFn, "compile_or_panic", "regexp"))
  _                  -> false
}

# Re-wrap the desugared pattern in its sigil delimiters. The string span
# holds the pattern escaped as a kaikai string literal; decoding it
# recovers the bytes that stood between `~r/` and `/`. A pattern
# containing `/` could not have been written as a sigil in the first
# place, so it stays a call.
fn fmt_sigil_of(arg0: Expr) : Option[String] = match arg0.kind {
  EStr(span, false) -> {
    let pat = decode_regex_str_span(span)
    if pat == "" or fmt_has_slash(pat, 0, string_length(pat)) { None }
    else { Some(concat_all(["~r/", pat, "/"])) }
  }
  _ -> None
}

# Strip leading/trailing `"` and decode `\\`/`\"` back to literal `\`
# and `"`. Mirrors the encoding done by `regex_pattern_to_kai_str_body`
# in the sigil parser. Returns the empty string when the span is
# malformed (which `EStr(_, false)` never is in practice — the
# parser would have rejected it).
#[doc("Decode a sigil-desugar string span back to the raw regex pattern bytes.")]
pub(pkg) fn decode_regex_str_span(span: String) : String {
  let n = string_length(span)
  if n < 2 { "" } else { decode_regex_loop(span, 1, n - 1, "") }
}

fn decode_regex_loop(span: String, i: Int, end: Int, acc: String) : String {
  if i >= end { acc } else {
    let c = char_at_or_zero(span, i)
    if c == '\\' and i + 1 < end {
      let c2 = char_at_or_zero(span, i + 1)
      decode_regex_loop(span, i + 2, end, string_concat(acc, "#{c2}"))
    } else {
      decode_regex_loop(span, i + 1, end, string_concat(acc, "#{c}"))
    }
  }
}

fn fmt_has_slash(s: String, i: Int, n: Int) : Bool {
  if i >= n { false }
  else if char_at_or_zero(s, i) == '/' { true }
  else { fmt_has_slash(s, i + 1, n) }
}

# ---- imaginary literals ----------------------------------------------
# A fourth desugar, same discipline: `3i` reaches the writer as
# `complex.mk(0.0, 3)`. The parser mints callee and both arguments from
# the one token, so all three share its position and the real part is
# the synthetic `0.0`; a hand-written `complex.mk(0.0, n)` spreads
# across distinct columns and keeps its call form.

#[doc("The surface literal a call node stands for — an imaginary literal or a regex sigil — or None when the author wrote a call.")]
pub(pkg) fn fmt_call_literal(callee: Expr, call_args: [Expr]) : Option[String] =
  match fmt_imaginary_span(callee, call_args) {
    Some(im) -> Some(string_concat(im, "i"))
    None     -> fmt_regex_sigil(callee, call_args)
  }

# The imaginary part's span, which is what `<digits>i` prints from.
fn fmt_imaginary_span(callee: Expr, call_args: [Expr]) : Option[String] = match call_args {
  [re, im] -> if fmt_is_imaginary_desugar(callee, re, im) {
    fmt_nonempty(fmt_real_span(im))
  } else { None }
  _ -> None
}

fn fmt_is_imaginary_desugar(callee: Expr, re: Expr, im: Expr) : Bool {
  let shape_ok = fmt_callee_is_complex_mk(callee) and fmt_real_span(re) == "0.0"
  shape_ok and fmt_same_pos(callee, re) and fmt_same_pos(callee, im)
}

fn fmt_callee_is_complex_mk(callee: Expr) : Bool = match callee.kind {
  EField(obj, fld) -> fld == "mk" and fmt_var_is(obj, "complex")
  _                -> false
}

# The raw span of a real literal, or "" for any other node.
fn fmt_real_span(e: Expr) : String = match e.kind {
  EReal(_, span) -> span
  _              -> ""
}

fn fmt_same_pos(a: Expr, b: Expr) : Bool = a.line == b.line and a.col == b.col

fn fmt_nonempty(s: String) : Option[String] = if s == "" { None } else { Some(s) }
