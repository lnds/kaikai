# compiler/vec_raw.kai — the ONE compile-time verdict for the Vec[T]
# raw element paths (the #1110 discipline: one classifier, not two).
#
# Mirror of the runtime element classifier (kai_vec_classify): an
# element type is an inline-record carrier iff it is a known record of
# 1..8 fields whose every field is a concrete raw scalar (Int / Real /
# Bool / Char / Byte). Both emitters consult THIS verdict before
# fusing `vec_get(v, i).f` / `vec_push(v, Rec{..})` / `vec_set(v, i,
# Rec{..})` into the raw runtime entry points; any other element shape
# keeps the boxed path, which is sound for every storage kind. The
# mirror must stay exact in the fuse direction: a raw fuse over a
# buffer the runtime classified BOXED would move the wrong bytes — the
# raw helpers trap on ekind/arity/tag mismatch as the last line of
# defence.

import compiler.ast
import compiler.sym_read

# KAI_VEC_REC_MAX in the runtime.
fn vr_rec_max() : Int = 8

# kai_vec_scalar_tag's accept set. Fixed-width ints (Int32 & co)
# deliberately fall to boxed, exactly like the runtime.
fn vr_scalar_name(nm: String) : Bool =
  nm == "Int" or nm == "Real" or nm == "Bool" or nm == "Char" or nm == "Byte"

# A field stored as one raw 8-byte column: a bare concrete scalar
# name. Dimensioned / refined / generic field types keep the record on
# the boxed path — the static verdict cannot see through them, and
# conservative-by-exclusion is sound.
fn vr_field_is_scalar(fd: FieldDecl) : Bool = match fd {
  FD(_, _, te, _) -> match te.tkind {
    TyName(_, nm, targs) -> (match targs { [] -> vr_scalar_name(nm) _ -> false })
    _                 -> false
  }
}

fn vr_fields_all_scalar(fs: [FieldDecl]) : Bool = match fs {
  []           -> true
  [f, ...rest] -> vr_field_is_scalar(f) and vr_fields_all_scalar(rest)
}

#[doc("True iff `opt_t` is an element type the Vec runtime stores as an inline all-scalar record (the REC carrier): a known record of 1..8 concrete raw-scalar fields. Both backends gate the raw get/set/push fusion on this one verdict.")]
pub fn vec_elem_is_rec_carrier(recs: [RecInfo], opt_t: Option[Ty]) : Bool = match vec_rec_arity(recs, opt_t) {
  Some(_) -> true
  None    -> false
}

#[doc("Field count of a REC-carrier element type, which fixes its stride at 8 bytes per field. `None` for any other element type.")]
pub fn vec_rec_arity(recs: [RecInfo], opt_t: Option[Ty]) : Option[Int] = match opt_t {
  Some(t) -> vr_carrier_arity(recs, t)
  None    -> None
}

fn vr_carrier_arity(recs: [RecInfo], t: Ty) : Option[Int] = match t {
  TyCon(_, cname, cargs, _) ->
    match rec_find_arity_loop(recs, cname, list_length(cargs), None) {
      None     -> None
      Some(ri) -> match ri {
        RI(_, _, fs, _, _) -> {
          let n = list_length(fs)
          if n >= 1 and n <= vr_rec_max() and vr_fields_all_scalar(fs) { Some(n) } else { None }
        }
      }
    }
  _ -> None
}

#[doc("Declaration-order column of `field` when `elem_t` is a REC-carrier record: the slot a fused `vec_get(v, i).field` loads raw. `None` keeps the unfused boxed path.")]
pub fn vec_rec_field_slot(recs: [RecInfo], elem_t: Option[Ty], field: String) : Option[Int] =
  if vec_elem_is_rec_carrier(recs, elem_t) { field_index_of(recs, elem_t, field) }
  else { None }

# ---- bare-word paths ------------------------------------------------
#
# An Int or Real payload can cross the buffer as its bare 8-byte word.
# Only a value typed EXACTLY `Int` / `Real` qualifies: the runtime
# guards trap when the buffer holds any other shape, so a wider static
# verdict would turn a working boxed access into a trap.

#[doc("How a fused Vec access moves one payload: a bare Int word or a bare Real word.")]
pub type VecBits = VbInt | VbReal

#[doc("The word kind of a value typed exactly `Int` or `Real`; `None` keeps the boxed path.")]
pub fn vec_bits_of(opt_t: Option[Ty]) : Option[VecBits] = match opt_t {
  Some(t) -> match t {
    TyInt  -> Some(VbInt)
    TyReal -> Some(VbReal)
    _      -> None
  }
  None -> None
}

#[doc("The operands of a `vec_get(v, i)` call, and whether it borrows `v` instead of consuming it.")]
pub type VecGet = { v: Expr, i: Expr, borrows: Bool }

#[doc("The operands of a `vec_get` / `vec_get_borrow` call; `None` for any other expression.")]
pub fn vec_get_call(k: ExprKind) : Option[VecGet] = match k {
  ECall(f, cargs) -> match sym_read_kind(f.kind) {
    EVar(callee) ->
      if callee == "vec_get" or callee == "vec_get_borrow" {
        match cargs {
          [v, i] -> Some(VecGet { v: v, i: i, borrows: callee == "vec_get_borrow" })
          _      -> None
        }
      } else { None }
    _ -> None
  }
  _ -> None
}

#[doc("Column and arity of a REC-carrier field read.")]
pub type VecCol = VecCol(Int, Int)

#[doc("A Vec read lowered to one bare word: `vec_get(v, i).f` on a REC carrier (`col` set) or `vec_get(v, i)` on a flat-scalar vec.")]
pub type VecRawRead = { get: VecGet, col: Option[VecCol], bits: VecBits }

#[doc("The bare-word read a node of kind `k` and type `opt_t` lowers to; `None` keeps the boxed path.")]
pub fn vec_raw_read(recs: [RecInfo], k: ExprKind, opt_t: Option[Ty]) : Option[VecRawRead] = match vec_bits_of(opt_t) {
  None       -> None
  Some(bits) -> match k {
    EField(base, fname) -> vr_field_read(recs, base, fname, bits)
    ECall(_, _)         -> match vec_get_call(k) {
      Some(g) -> Some(VecRawRead { get: g, col: None, bits: bits })
      None    -> None
    }
    _ -> None
  }
}

fn vr_field_read(recs: [RecInfo], base: Expr, fname: String, bits: VecBits) : Option[VecRawRead] = match vec_field_read(recs, base, fname) {
  Some(fr) -> Some(VecRawRead { get: fr.get, col: Some(fr.col), bits: bits })
  None     -> None
}

#[doc("A fused `vec_get(v, i).f` on a REC carrier: the call's operands and the column read.")]
pub type VecFieldRead = { get: VecGet, col: VecCol }

#[doc("The fused read `base.fname` lowers to when `base` is a `vec_get` over a REC carrier; `None` keeps the unfused path.")]
pub fn vec_field_read(recs: [RecInfo], base: Expr, fname: String) : Option[VecFieldRead] = match vec_get_call(base.kind) {
  None    -> None
  Some(g) -> match vec_rec_field_slot(recs, base.ty, fname) {
    None       -> None
    Some(fidx) -> match vec_rec_arity(recs, base.ty) {
      Some(n) -> Some(VecFieldRead { get: g, col: VecCol(fidx, n) })
      None    -> None
    }
  }
}

#[doc("Whether a backend takes bare-word Vec reads, and the records its verdict consults.")]
pub type VecRawCx = VrOff | VrOn([RecInfo])

#[doc("True when the backend lowers this node to a bare-word Vec read, so its value is a raw scalar.")]
pub fn vec_reads_raw(cx: VecRawCx, k: ExprKind, opt_t: Option[Ty]) : Bool = match cx {
  VrOff      -> false
  VrOn(recs) -> match vec_raw_read(recs, k, opt_t) {
    Some(_) -> true
    None    -> false
  }
}

#[doc("The word kind of each field of a record literal stored into a REC carrier, in literal order. `None` unless the literal spells every field and each is exactly `Int` or `Real`.")]
pub fn vec_rec_lit_bits(recs: [RecInfo], lit_t: Option[Ty], fis: [FieldInit]) : Option[[VecBits]] = match vec_rec_arity(recs, lit_t) {
  None    -> None
  Some(n) -> if list_length(fis) == n { vr_field_bits(fis, []) } else { None }
}

fn vr_field_bits(fis: [FieldInit], acc: [VecBits]) : Option[[VecBits]] = match fis {
  []            -> Some(list_reverse(acc))
  [fi, ...rest] -> match fi {
    FI(_, e) -> match vec_bits_of(e.ty) {
      Some(b) -> vr_field_bits(rest, [b, ...acc])
      None    -> None
    }
  }
}
