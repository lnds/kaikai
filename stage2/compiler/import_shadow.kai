#[doc("""
The bare uses an opened import binds over a core function of the same
name: the sites the same-type check judges once every signature is
typed.
""")]

import compiler.ast
import compiler.symtab
import compiler.decl_names
import compiler.scope_view
import compiler.resolve_state
import compiler.core_syms
import compiler.util

#[doc("A bare use at a file position, read under a scope view, that reached an opened import's function over the core function of its name: the import's function, the core one, the view, the file, the line and the column.")]
pub type ShadowUse = ShadowUse(SymId, SymId, ScopeView, String, Int, Int)

#[doc("The core function or builtin the bare `name` names had the opened import declaring `s` not shadowed it; `None` when `s` is no function of such an import.")]
pub fn shadowed_core(rs: ResState, name: String, s: SymId) : Option[SymId] =
  if not rs_recording(rs) or sym_raw(s) < 0 { None }
  else if not sv_opened(rs.view, sym_owner(rs.tab, s), name) { None }
  else if not ncls_same(sym_class(rs.tab, s), NCFn) { None }
  else { core_fn(rs, name) }

fn core_fn(rs: ResState, name: String) : Option[SymId] =
  match sv_nearest(rs.tab, rs.view, [SvCores], st_candidates(rs.tab, NCFn, name)) {
    SvSym(c) -> Some(c)
    _        -> {
      let b = builtin_sym(name)
      if st_valid(rs.tab, b) and list_has(rs.prelude, name) { Some(b) } else { None }
    }
  }
