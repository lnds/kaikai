#[doc("""
Functions that hand a tail call through a closure to the nearest resolver.

A call through a closure cannot be a jump: the arguments live in the caller's
frame and the callee returns a different representation. A function that makes
such a call in tail position is split in two. Its body returns a boxed value
that may be the bounce token, the stand-in for a call parked in the runtime;
its stub keeps the declared signature, runs the body and resolves the token.
Closures made over the function enter through the body, so the stack unwinds
to a resolver between two hops of a cycle.
""")]

import compiler.emit_shared_syms
import compiler.enc_unit
import compiler.kir
import compiler.kir_syms
import compiler.kir_tail_exit
import compiler.util

#[doc("A function split in two: the stub under its own symbol, the body under another, and the thunks closures over each are made of.")]
pub(pkg) type KbMember = { stub: String, body: String, stub_thunk: String, body_thunk: String }

#[doc("The functions that have a body, by the symbol of their stub, and the names the functions that check a postcondition are emitted under, once known.")]
pub(pkg) type KbPlan = { members: [KbMember], nm: Option[KNames] }

#[doc("No function has a body.")]
pub(pkg) fn kb_none() : KbPlan = KbPlan { members: [], nm: None }

#[doc("`p` with the names its functions are emitted under.")]
pub(pkg) fn kb_named(p: KbPlan, nm: KNames) : KbPlan = KbPlan { members: p.members, nm: Some(nm) }

#[doc("True when no function has a body.")]
pub(pkg) fn kb_is_empty(p: KbPlan) : Bool = list_is_empty(p.members)

#[doc("`p` with the function whose stub is `stub` and whose body is `body` split in two.")]
pub(pkg) fn kb_with(p: KbPlan, stub: String, body: String) : KbPlan =
  KbPlan { nm: p.nm, members: [KbMember { stub: stub, body: body, stub_thunk: c_user_thunk_sym(stub), body_thunk: c_user_thunk_sym(body) }, ...p.members] }

#[doc("The symbol of the body of the function whose stub is `sym`.")]
pub(pkg) fn kb_body_of(p: KbPlan, sym: String) : Option[String] = map(find(p.members, (m) => m.stub == sym), .body)

#[doc("True when `sym` is the stub of a function that has a body.")]
pub(pkg) fn kb_has(p: KbPlan, sym: String) : Bool = is_some(kb_body_of(p, sym))

#[doc("True when `f` may return the bounce token: a body, or a lambda, which closures enter directly.")]
pub(pkg) fn kb_returns_token(f: KFn) : Bool = match f.unit {
  EuTail(_) -> true
  _         -> match f.kind {
    KFnLambda -> f.ret == SBoxed
    _         -> false
  }
}

#[doc("The body of the declared function `f` before its blocks are shaped: its code under a boxed result, owning the parameters `f` borrows and releasing them where it returns.")]
pub(pkg) fn kb_body_shell(f: KFn) : KFn = {
  let owned = kb_owned_params(f)
  KFn { unit: EuTail(f.unit), kind: f.kind, params: map(f.params, (p) => kb_own(p, owned)), ret: SBoxed,
        blocks: if list_is_empty(owned) { f.blocks } else { map(f.blocks, (b) => kb_release_at_ret(b, owned)) },
        region_id: f.region_id, stateful: f.stateful, mo: f.mo, donor: f.donor, entry: f.entry }
}

#[doc("The boxed parameters of `f` that its body owns: those `f` borrows, unless a loop rebinds parameters in place, which leaves their ownership to the loop.")]
pub(pkg) fn kb_owned_params(f: KFn) : [KParam] =
  if any(f.blocks, kb_loops) { [] } else { filter(f.params, kb_borrowed_boxed) }

fn kb_borrowed_boxed(p: KParam) : Bool = match p.mode {
  KBorrow -> kb_boxed_slot(p.slot)
  KOwn    -> false
}

fn kb_boxed_slot(s: KSlot) : Bool = match s {
  SBoxed -> true
  _      -> false
}

fn kb_loops(b: KBlock) : Bool = match b.term {
  KTcrecGoto(_, _, _, _)                       -> true
  KTrmcStep(_, _, _, _, _, _, _, _, _, _)      -> true
  _                                            -> false
}

fn kb_own(p: KParam, owned: [KParam]) : KParam =
  if any(owned, (o) => o.name == p.name) { KParam { ...p, mode: KOwn } } else { p }

fn kb_release_at_ret(b: KBlock, owned: [KParam]) : KBlock = match b.term {
  KRet(_, pos) -> KBlock { ...b, stmts: list_append(b.stmts, map(owned, (p) => KRC(KDrop(KVar(p.name)), pos))) }
  _            -> b
}

#[doc("True when a result of the slot `s` can be boxed back and forth, so a function returning it can have a body.")]
pub(pkg) fn kb_boxable(s: KSlot) : Bool = match s {
  SBoxed -> true
  _      -> is_some(kb_box_prim(s))
}

fn kb_box_prim(s: KSlot) : Option[PrimOp] = match s {
  SInt64  -> Some(KpBox(RwInt))
  SReal   -> Some(KpBox(RwReal))
  SBool   -> Some(KpBox(RwBool))
  SChar   -> Some(KpBox(RwChar))
  SByte   -> Some(KpBox(RwByte))
  SInt32T -> Some(KpBox(RwInt32))
  SUInt32 -> Some(KpBox(RwUInt32))
  SUInt64 -> Some(KpBox(RwUInt64))
  SInt128 -> Some(KpBox(RwInt128))
  _       -> None
}

fn kb_unbox_prim(s: KSlot) : Option[PrimOp] = match s {
  SInt64  -> Some(KpUnbox(RwInt))
  SReal   -> Some(KpUnbox(RwReal))
  SBool   -> Some(KpUnbox(RwBool))
  SChar   -> Some(KpUnbox(RwChar))
  SByte   -> Some(KpUnbox(RwByte))
  SInt32T -> Some(KpUnbox(RwInt32))
  SUInt32 -> Some(KpUnbox(RwUInt32))
  SUInt64 -> Some(KpUnbox(RwUInt64))
  SInt128 -> Some(KpUnbox(RwInt128))
  _       -> None
}

#[doc("The stub of `f`: its signature, running the body `body` and resolving what it returns.")]
pub(pkg) fn kb_stub(f: KFn, body: String) : KFn = {
  let called = KLet("__bnc_r", SBoxed, KCall(body, map(f.params, (p) => KVar(p.name))), KNoPos)
  let resolved = KLet("__bnc_v", SBoxed, KPrim(KpBounce, [KVar("__bnc_r")]), KNoPos)
  let lend = map(kb_owned_params(f), (p) => KRC(KDup(KVar(p.name)), KNoPos))
  let entry = KBlock { label: "entry", stmts: list_append(lend, [called, resolved, ...kb_stub_result(f.ret)]), term: KRet(kb_stub_value(f.ret), KNoPos), region_id: None }
  KFn { unit: f.unit, kind: f.kind, params: f.params, ret: f.ret, blocks: [entry], region_id: None,
        stateful: f.stateful, mo: f.mo, donor: f.donor, entry: f.entry }
}

fn kb_stub_value(s: KSlot) : KVal = match s {
  SBoxed -> KVar("__bnc_v")
  _      -> KVar("__bnc_u")
}

fn kb_stub_result(s: KSlot) : [KStmt] = match kb_unbox_prim(s) {
  None    -> []
  Some(u) -> [KLet("__bnc_u", s, KPrim(u, [KVar("__bnc_v")]), KNoPos), ...kb_stub_release(s)]
}

fn kb_stub_release(s: KSlot) : [KStmt] = match s {
  SBool -> []
  SByte -> []
  _     -> [KRC(KDrop(KVar("__bnc_v")), KNoPos)]
}

#[doc("`bs` with every return of a result in `ret` boxed, but the return of a call that already yields a box.")]
pub(pkg) fn kb_box_rets(ret: KSlot, bs: [KBlock]) : [KBlock] = match kb_box_prim(ret) {
  None     -> bs
  Some(bp) -> map(bs, (b) => kb_box_block(b, bp))
}

fn kb_box_block(b: KBlock, bp: PrimOp) : KBlock = match b.term {
  KRet(v, pos) -> if kb_boxed_here(b.stmts, v) { b } else {
    let reg = cat2("__bnc.", b.label)
    KBlock { ...b, stmts: list_append(b.stmts, [KLet(reg, SBoxed, KPrim(bp, [v]), pos)]), term: KRet(KVar(reg), pos) }
  }
  _ -> b
}

fn kb_boxed_here(stmts: [KStmt], v: KVal) : Bool = match v {
  KVar(n) -> any(stmts, (s) => match s {
    KLet(r, SBoxed, _, _) -> r == n
    _                     -> false
  })
  _ -> false
}

#[doc("`f` with each closure over a function that has a body made over the body.")]
pub(pkg) fn kb_retarget(f: KFn, p: KbPlan) : KFn =
  if kb_is_empty(p) or not any(f.blocks, (b) => any(b.stmts, (s) => kb_closes_over(s, p))) { f }
  else { kfn_with_blocks(f, map(f.blocks, (b) => KBlock { ...b, stmts: map(b.stmts, (s) => kb_retarget_stmt(s, p)) })) }

fn kb_closes_over(s: KStmt, p: KbPlan) : Bool = match s {
  KLet(_, _, KClosure(sym, _, _), _) -> kb_has_thunk(p, sym)
  KDo(KClosure(sym, _, _), _)        -> kb_has_thunk(p, sym)
  _                                  -> false
}

fn kb_has_thunk(p: KbPlan, sym: String) : Bool = any(p.members, (m) => m.stub_thunk == sym)

fn kb_retarget_stmt(s: KStmt, p: KbPlan) : KStmt = match s {
  KLet(x, slot, KClosure(sym, ar, caps), pos) -> KLet(x, slot, KClosure(kb_thunk(p, sym), ar, caps), pos)
  KDo(KClosure(sym, ar, caps), pos)           -> KDo(KClosure(kb_thunk(p, sym), ar, caps), pos)
  _                                           -> s
}

fn kb_thunk(p: KbPlan, sym: String) : String = match find(p.members, (m) => m.stub_thunk == sym) {
  Some(m) -> m.body_thunk
  None    -> sym
}

#[doc("The function that checks a postcondition on the value of the block `label` of `f`: it takes the value, runs the check and returns the value boxed.")]
pub(pkg) fn kb_post_fn(f: KFn, label: String, p: KtPost) : KFn = {
  let entry = KBlock { label: "entry", stmts: kb_declare(p.stmts, [p.x], []), term: KRet(KVar(p.value), p.pos), region_id: None }
  KFn { unit: EuPost(f.unit, label), kind: KFnNormal, params: [KParam { name: p.x, slot: SBoxed, mode: KOwn, origin: PDirect(0) }], ret: SBoxed,
        blocks: kb_box_rets(kb_value_slot(p.stmts, p.value), [entry]), region_id: None, stateful: false, mo: f.mo, donor: false, entry: false }
}

#[doc("The symbol of the thunk a closure over the check `post` is made of, when `p` knows the names.")]
pub(pkg) fn kb_post_thunk(p: KbPlan, post: KFn) : Option[String] = map(p.nm, (nm) => c_user_thunk_sym(kfn_sym(nm, post)))

fn kb_value_slot(stmts: [KStmt], v: String) : KSlot = kb_value_slot_in(list_reverse(stmts), v)

fn kb_value_slot_in(rev: [KStmt], v: String) : KSlot = match rev {
  []           -> SBoxed
  [s, ...rest] -> match s {
    KLet(r, slot, _, _) -> if r == v { slot } else { kb_value_slot_in(rest, v) }
    _                   -> kb_value_slot_in(rest, v)
  }
}

# A store to a register the check has not bound is its binding.
fn kb_declare(stmts: [KStmt], bound: [String], acc: [KStmt]) : [KStmt] = match stmts {
  []           -> list_reverse(acc)
  [s, ...rest] -> match s {
    KStore(n, v, pos) ->
      if any(bound, (b) => b == n) { kb_declare(rest, bound, [s, ...acc]) }
      else { kb_declare(rest, [n, ...bound], [KLet(n, SBoxed, KLitOp(v), pos), ...acc]) }
    KLet(r, _, _, _) -> kb_declare(rest, [r, ...bound], [s, ...acc])
    _                -> kb_declare(rest, bound, [s, ...acc])
  }
}
