#[doc("Clause merge: a `handle` that omits an op, or the `return` clause, takes the effect's default clause for it, as if the handle had spelled it.")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.desugar_refine_pred
import compiler.handler_alias
import compiler.symtab
import compiler.infer_clause_holes

#[doc("`ds` with every `handle` completed by the default clauses of its effect, looked up in `all`.")]
pub fn inherit_default_decls(ds: [Decl], all: [Decl]) : [Decl] =
  if any(all, has_kaikai_default) {
    map(ds, d => decl_map_exprs(d, e => ih_expr(e, all)))
  } else {
    ds
  }

#[doc("True when `d` is an effect whose default block has a clause that is not a runtime bridge, or a `return` clause.")]
pub fn has_kaikai_default(d: Decl) : Bool = match d {
  DEffect(_, _, _, _, Some(DBlk(cs, ret, _, _)), _, _, _, _, _) ->
    is_some(ret) or any(cs, c => not clause_is_extern_bridge(c))
  _ -> false
}

fn ih_expr(e: Expr, all: [Decl]) : Expr {
  let mapped = dsg_map_expr_kind(e.kind, c => ih_expr(c, all))
  Expr { ...e, kind: ih_kind(mapped, all) }
}

fn ih_kind(k: ExprKind, all: [Decl]) : ExprKind = match k {
  EHandle(body, eff, tys, None, alias, cs, ret) ->
    match effect_decl_default(effect_decl_of(ref_sym(eff), all)) {
      Some(DBlk(dcs, dret, _, _)) -> EHandle(
        body,
        eff,
        tys,
        None,
        alias,
        list_append(cs, inherited_clauses(dcs, cs)),
        match ret {
          Some(_) -> ret
          None -> dret
        }
      )
      None -> k
    }
  _ -> k
}

fn inherited_clauses(dcs: [HClause], user: [HClause]) : [HClause] = filter(
  dcs,
  c => match c {
    HC(h, _, _, _, _) ->
      (not clause_is_extern_bridge(c))
        and (not is_lifecycle_clause(h))
        and (not any(
          user,
          u => match u {
            HC(uh, _, _, _, _) -> clause_head_word(uh) == clause_head_word(h)
          }
        ))
  }
)
