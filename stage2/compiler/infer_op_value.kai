#[doc("An effect operation named without a call: the lambda that performs it.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.written
import compiler.infer_env
import compiler.infer_state
import compiler.infer_call_labels
import compiler.infer_row_kinds
import compiler.infer_tparam_escape

#[doc("The lambda that applies the operation `obj.fnm` when `obj` names an effect, a `with … as` alias or a capability and `fnm` is one of its operations; None for any other field read.")]
pub(pkg) fn op_value_lambda(st: InferState, obj: Expr, fnm: String, line: Int, col: Int) : Option[Expr] =
  and_then(op_value_effect(st, obj), (esym) => match env_op(st.env, esym, written(fnm)) {
    Some(Scheme(_, _, _, _, TyFnT(ps, _, _))) ->
      Some(mk_eta_lambda(mk_expr(EField(obj, fnm), line, col), eta_binders(line, col, length(ps)), line, col))
    _ -> None
  })

fn op_value_effect(st: InferState, obj: Expr) : Option[SymId] = match obj.kind {
  ESym(s, _) -> Some(s)
  ELocal(l)  -> match lookup_alias_taggable(st.aliases, l) {
    Some(_) -> Some(lookup_alias_sym(st.aliases, l))
    None    -> cap_eff_of_var(st, l)
  }
  _ -> None
}
