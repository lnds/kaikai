# compiler/scc.kai — strongly connected components of a graph over the
# node indices `0..n`, linear in nodes plus edges (Kosaraju).
#
# A component's member order is output wherever a caller numbers the
# members by it (tailfuse tags them), so it is fixed here: the reverse
# of the order a breadth-first walk from the component's lowest index
# dequeues them, each node counted once.

import compiler.util

#[doc("The components of two or more members of the graph with `n` nodes and edges `es` (source, target), ordered by their lowest index. Members run in the reverse of the order a breadth-first walk from that index dequeues them, successors in edge order.")]
pub fn scc_groups(n: Int, es: [(Int, Int)]) : [[Int]] {
  let succ = scc_adjacency(es, n)
  let pred = scc_adjacency(map(es, (e) => (e.snd, e.fst)), n)
  let comp = scc_component_ids(pred, scc_finish_order(succ, n), n)
  scc_groups_in(succ, comp, n)
}

# One successor list per node, in edge order.
fn scc_adjacency(es: [(Int, Int)], n: Int) : Array[[Int]] =
  scc_adj_fill(list_reverse(es), array_make(n, []))

fn scc_adj_fill(es: [(Int, Int)], adj: Array[[Int]]) : Array[[Int]] / Mutable = match es {
  [] -> adj
  [(a, b), ...rest] -> {
    let cur = array_get(adj, a)
    scc_adj_fill(rest, array_set(adj, a, [b, ...cur]))
  }
}

# Every node, latest-finishing first, of a depth-first walk over `succ`.
# Reads go through closures: handing the arrays themselves to a
# `/ Mutable` helper would make its writes the caller's effect.
fn scc_finish_order(succ: Array[[Int]], n: Int) : [Int] =
  scc_dfs_roots((v) => array_get(succ, v), 0, n, array_make(n, false), [])

fn scc_dfs_roots(succ: (Int) -> [Int], i: Int, n: Int, seen: Array[Bool], fin: [Int]) : [Int] / Mutable =
  if i >= n { fin }
  else if array_get(seen, i) { scc_dfs_roots(succ, i + 1, n, seen, fin) }
  else { match scc_dfs(succ, [(i, succ(i))], array_set(seen, i, true), fin) {
    (seen1, fin1) -> scc_dfs_roots(succ, i + 1, n, seen1, fin1)
  } }

# Each stack frame is an open node and the successors it has yet to try.
fn scc_dfs(succ: (Int) -> [Int], stack: [(Int, [Int])], seen: Array[Bool], fin: [Int]) : (Array[Bool], [Int]) / Mutable = match stack {
  [] -> (seen, fin)
  [(v, ws), ...rest] -> match ws {
    [] -> scc_dfs(succ, rest, seen, [v, ...fin])
    [w, ...more] ->
      if array_get(seen, w) { scc_dfs(succ, [(v, more), ...rest], seen, fin) }
      else { scc_dfs(succ, [(w, succ(w)), (v, more), ...rest], array_set(seen, w, true), fin) }
  }
}

# Each root of `order` claims, as one component, what it reaches over
# `pred` that no earlier root claimed.
fn scc_component_ids(pred: Array[[Int]], order: [Int], n: Int) : Array[Int] =
  scc_assign((v) => array_get(pred, v), order, array_make(n, 0 - 1), 0)

fn scc_assign(pred: (Int) -> [Int], order: [Int], comp: Array[Int], c: Int) : Array[Int] / Mutable = match order {
  [] -> comp
  [v, ...rest] ->
    if array_get(comp, v) >= 0 { scc_assign(pred, rest, comp, c) }
    else { scc_assign(pred, rest, scc_claim(pred, [v], comp, c), c + 1) }
}

fn scc_claim(pred: (Int) -> [Int], todo: [Int], comp: Array[Int], c: Int) : Array[Int] / Mutable = match todo {
  [] -> comp
  [v, ...rest] ->
    if array_get(comp, v) >= 0 { scc_claim(pred, rest, comp, c) }
    else { scc_claim(pred, list_append(pred(v), rest), array_set(comp, v, c), c) }
}

fn scc_groups_in(succ: Array[[Int]], comp: Array[Int], n: Int) : [[Int]] =
  scc_groups_at((v) => array_get(succ, v), (v) => array_get(comp, v), 0, n, array_make(n, false), [])

fn scc_groups_at(succ: (Int) -> [Int], comp: (Int) -> Int, i: Int, n: Int, done: Array[Bool], acc: [[Int]]) : [[Int]] / Mutable =
  if i >= n { list_reverse(acc) }
  else if array_get(done, i) { scc_groups_at(succ, comp, i + 1, n, done, acc) }
  else { match scc_bfs(succ, comp, comp(i), [i], [], done, []) {
    (ms, done1) -> scc_groups_at(succ, comp, i + 1, n, done1, if list_length(ms) >= 2 { [ms, ...acc] } else { acc })
  } }

# The queue is `front` plus reversed `back`. Staying inside component
# `c` keeps its members' dequeue order: a path that leaves it never
# comes back.
fn scc_bfs(succ: (Int) -> [Int], comp: (Int) -> Int, c: Int, front: [Int], back: [Int],
           done: Array[Bool], acc: [Int]) : ([Int], Array[Bool]) / Mutable = match front {
  [] -> if list_is_empty(back) { (acc, done) } else { scc_bfs(succ, comp, c, list_reverse(back), [], done, acc) }
  [v, ...rest] ->
    if array_get(done, v) or comp(v) != c { scc_bfs(succ, comp, c, rest, back, done, acc) }
    else { scc_bfs(succ, comp, c, rest, list_append(list_reverse(succ(v)), back), array_set(done, v, true), [v, ...acc]) }
}
