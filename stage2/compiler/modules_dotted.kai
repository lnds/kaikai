#[doc("""
A dotted name split at its module qualifier, and the diagnostics of a
qualified type that names no module or no export.
""")]

import compiler.util
import compiler.diag
import compiler.modules_paths

fn first_dot_index(s: String, i: Int, n: Int) : Int {
  if i >= n { -1 }
  else if string_byte_at_int(s, i) == char_to_int('.') { i }
  else { first_dot_index(s, i + 1, n) }
}

#[doc("A dotted name split at its first dot: the qualifier and the remainder.")]
pub type QtSplit = QSplit(String, String)

#[doc("Split `mod.Name` into its qualifier and its bare name; `None` when undotted.")]
pub fn split_dotted_qualifier(name: String) : Option[QtSplit] {
  let n = string_length(name)
  let i = first_dot_index(name, 0, n)
  if i < 0 { None }
  else { Some(QSplit(string_slice(name, 0, i), string_slice(name, i + 1, n - i - 1))) }
}

#[doc("The bare name behind a possibly module-qualified spelling: `m.P` -> `P`, `P` -> `P`.")]
pub fn dotted_bare(name: String) : String = match split_dotted_qualifier(name) {
  None -> name
  Some(q) -> match q { QSplit(_, bare) -> bare }
}

#[doc("Reports a qualified type whose qualifier names no imported module.")]
pub fn qt_diag_unknown_mod(mod: String, ty: String, file: String, line: Int, col: Int) : Unit / Console + File =

  diag_error(file, line, col,
    concat_all(["unknown module qualifier '", mod, "' in qualified type '",
                mod, ".", ty, "'"]))

#[doc("Reports a qualified type its module does not export, listing what the module does export.")]
pub fn qt_diag_missing_type(mod: String, ty: String, exports: [String], file: String, line: Int, col: Int) : Unit / Console + File =

  diag_error(file, line, col,
    concat_all(["module '", mod, "' does not export type '", ty,
                "'; available exports: ", mods_join_with(exports, ", ")]))
