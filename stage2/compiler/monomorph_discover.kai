#[doc("Instance discovery: tuple and recorded instances, the walk that finds instances in bodies and the call sites that name them.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.type_text
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_unit_tables
import compiler.infer_state
import compiler.infer_clause_holes
import compiler.infer_env_exhaust
import compiler.infer_index
import compiler.monomorph_polys
import compiler.effect_instance
import compiler.monomorph
import compiler.infer_dump_text
import compiler.monomorph_subst
import compiler.symtab

#[doc("True when both are the same specialisation: same generic, equal types and units.")]
pub(pkg) fn tuple_eq(a: MonoTuple, b: MonoTuple) : Bool =
  match a { MT(ag, atys, aus) -> match b { MT(bg, btys, bus) ->
    sym_same(ag, bg) and ty_list_eq(atys, btys) and unit_list_eq(aus, bus)
  }}

#[doc("True when two unit lists are equal element by element.")]
pub(pkg) fn unit_list_eq(a: [UnitExprT], b: [UnitExprT]) : Bool =
  match a {
    [] -> match b { [] -> true _ -> false }
    [ah, ...arest] -> match b {
      [] -> false
      [bh, ...brest] -> if unit_eq(ah, bh) { unit_list_eq(arest, brest) } else { false }
    }
  }

# Structural equality on canonical units. Both sides are canonicalised
# first so `m * sec` and `sec * m` collapse to the same shape.
fn unit_eq(a: UnitExprT, b: UnitExprT) : Bool {
  let ca = unit_canon(a)
  let cb = unit_canon(b)
  unit_key(ca) == unit_key(cb)
}

fn tuple_in(tuples: [MonoTuple], t: MonoTuple) : Bool {
  match tuples {
    [] -> false
    [h, ...rest] -> if tuple_eq(h, t) { true } else { tuple_in(rest, t) }
  }
}

#[doc("""
The growing spec set carried through the fixpoint, with an index by
generic beside the list: a bucket holds one generic's distinct tuples.

Each distinct tuple is numbered among its generic's instances, in the
order it first joins the set; that number is the instance index of
the spec's `FnId`. A number never changes once given.
""")]
pub(pkg) type TupleSet = { items: [MonoTuple], idx: NameIndex[TupleAt] }

#[doc("A specialisation and its instance index.")]
pub(pkg) type TupleAt = TA(MonoTuple, Int)

fn ts_empty() : TupleSet = TupleSet { items: [], idx: idx_empty() }

fn ts_add(ts: TupleSet, t: MonoTuple) : TupleSet = {
  let known = idx_chain_sym(ts.idx, mt_sym(t))
  if ta_find(known, t) != spec_none() { TupleSet { items: [t, ...ts.items], idx: ts.idx } }
  else { TupleSet { items: [t, ...ts.items], idx: idx_prepend_sym(ts.idx, mt_sym(t), TA(t, list_length(known))) } }
}

#[doc("`ts` with each of `ts_new` added.")]
pub(pkg) fn ts_add_all(ts: TupleSet, ts_new: [MonoTuple]) : TupleSet = match ts_new {
  []           -> ts
  [h, ...rest] -> ts_add_all(ts_add(ts, h), rest)
}

#[doc("The set holding `xs`.")]
pub(pkg) fn ts_of(xs: [MonoTuple]) : TupleSet = ts_add_all(ts_empty(), xs)

#[doc("True when the set holds `t`.")]
pub(pkg) fn ts_mem(ts: TupleSet, t: MonoTuple) : Bool = ts_inst(ts, t) != spec_none()

#[doc("The instance index of `t` among its generic's tuples, or `spec_none()`.")]
pub(pkg) fn ts_inst(ts: TupleSet, t: MonoTuple) : Int = ta_find(idx_chain_sym(ts.idx, mt_sym(t)), t)

fn ta_find(chain: [TupleAt], t: MonoTuple) : Int = match chain {
  []           -> spec_none()
  [h, ...rest] -> match h { TA(u, k) -> if tuple_eq(u, t) { k } else { ta_find(rest, t) } }
}

#[doc("""
Reduce `tp.insts` to the distinct tuples that instantiate a
polymorphic DFn. Tuples containing unresolved `TyVarT` slots or
`UVar` units are filtered out — specialisation requires concrete
types.
""")]
pub(pkg) fn collect_distinct_tuples(insts: InstIndex, polys: PolyIx,
                           acc: [MonoTuple]) : [MonoTuple] =
  collect_distinct_loop(iix_all(insts), polys, acc)

fn collect_distinct_loop(insts: [ResolvedCS], polys: PolyIx,
                         acc: [MonoTuple]) : [MonoTuple] {
  match insts {
    [] -> list_reverse(acc)
    [cs, ...rest] -> match cs {
      RCS(s, _, _, tys0, units, _) -> match lookup_poly_fn_sym(poly_ix_fns(polys), s) {
        None -> collect_distinct_loop(rest, polys, acc)
        Some(_) -> {
          let tys = inst_spec_tys(polys, s, tys0)
          let any_slot = list_length(tys) > 0 or list_length(units) > 0
          let concrete = any_slot and tuple_concrete(tys) and units_concrete(units)
          let mt = MT(s, tys, units)
          if concrete and not tuple_in(acc, mt) {
            collect_distinct_loop(rest, polys, [mt, ...acc])
          } else {
            collect_distinct_loop(rest, polys, acc)
          }
        }
      }
    }
  }
}

#[doc("""
A generic whose `handle` takes a type parameter as its instance is
specialised per instance even when another slot stays free: the handler's
evidence label is that instance. The free slots that are not instances
erase to `Any`.
""")]
pub(pkg) fn inst_spec_tys(polys: PolyIx, s: SymId, tys: [Ty]) : [Ty] =
  if tuple_concrete(tys) { tys }
  else { match lookup_poly_fn_sym(poly_ix_inst(polys), s) {
    Some(d) -> erase_free_slots(sig_type_names(d), tys, handle_instance_tparams(d))
    None    -> tys
  } }

fn erase_free_slots(names: [TBinder], tys: [Ty], inst: [TBinder]) : [Ty] = match tys {
  []           -> []
  [t, ...rest] -> match names {
    []            -> tys
    [n, ...nrest] -> [if tbs_has(inst, n.id) or ty_concrete(t) { t } else { TyAny }, ...erase_free_slots(nrest, rest, inst)]
  }
}

# Collect every RCS recorded for the generic `s` at one `(line, col)`
# source position. A position is shared by more than one instantiation
# when distinct `#{...}` interpolation bodies reparse to call sites that
# all start at the slice-local `(1,1)` — the lexer restarts each
# `#{...}` reparse at line 1, col 1, so the callee of every
# interpolated `f(...)` lands at the same coordinate.
fn find_mono_insts_at(insts: InstIndex, s: SymId,
                       line: Int, col: Int) : [MonoInstPair] =
  mono_insts_at_loop(iix_chain(insts, s), line, col)

fn mono_insts_at_loop(insts: [ResolvedCS], line: Int, col: Int) : [MonoInstPair] {
  match insts {
    [] -> []
    [r, ...rest] -> match r {
      RCS(_, rl, rc, tys, units, _) ->
        if rl == line and rc == col {
          [MIPair(tys, units), ...mono_insts_at_loop(rest, line, col)]
        } else {
          mono_insts_at_loop(rest, line, col)
        }
    }
  }
}

# True when two or more recorded instantiations share a position but
# disagree on (tys, units) — the position cannot pick a single spec by
# first-match, so the call site's actual arg types must disambiguate.
fn mono_insts_collide(pairs: [MonoInstPair]) : Bool {
  match pairs {
    [] -> false
    [_] -> false
    [MIPair(t0, u0), ...rest] -> mono_insts_collide_rest(t0, u0, rest)
  }
}

fn mono_insts_collide_rest(t0: [Ty], u0: [UnitExprT], rest: [MonoInstPair]) : Bool {
  match rest {
    [] -> false
    [MIPair(ti, ui), ...more] ->
      if ty_list_eq(t0, ti) and unit_list_eq(u0, ui) {
        mono_insts_collide_rest(t0, u0, more)
      } else { true }
  }
}

# Resolve the (tys, units) tuple of a call to the generic `d`, applying
# `sm`. The lookup prefers the typer-recorded RCS at the callee's
# position when it exists; it falls back to inline synthesis from
# `args`' types when no inst was recorded (an impl function a
# dispatcher call was retargeted to AFTER tp.insts was populated). The
# inline synth path uses `synthesize_inst_for_decl` to extract
# bindings by unifying the polymorphic DFn's formal param types
# with the actual arg types. This also disambiguates multiple impl
# calls that coalesce onto one source position under string
# interpolation (each `#{x}` becomes a `show` impl call at the same
# outer (line, col) for distinct `x.ty`).
#
# A bare `fn[T:P]` instantiated at >=2 types inside `#{...}` records
# several distinct-type RCS at one slice-local position; first-match
# would resolve every such site to the first spec (wrong ABI). When
# the position collides, synthesise from the call's actual arg types
# so each site retargets its own spec.
#[doc("The types and units a call of the generic `d` is instantiated at, or `None` when they cannot be settled.")]
pub(pkg) fn resolve_call_inst(insts: InstIndex, polys: PolyIx, d: Decl,
                      callee: Expr, args_: [Expr], ret_ty: Option[Ty],
                      sm: SubstMap) : Option[MonoInstPair] =
  match resolve_call_inst_raw(insts, d, callee, args_, ret_ty, sm) {
    Some(MIPair(tys, units)) -> Some(MIPair(inst_spec_tys(polys, poly_decl_sym(d), tys), units))
    None                     -> None
  }

fn resolve_call_inst_raw(insts: InstIndex, d: Decl,
                         callee: Expr, args_: [Expr], ret_ty: Option[Ty],
                         sm: SubstMap) : Option[MonoInstPair] {
  let at_pos = find_mono_insts_at(insts, poly_decl_sym(d), callee.line, callee.col)
  if mono_insts_collide(at_pos) {
    match synth_inst_pair(d, callee, args_, ret_ty, sm) {
      Some(p) -> Some(p)
      None -> resolve_call_inst_first(at_pos, d, callee, args_, ret_ty, sm)
    }
  } else {
    resolve_call_inst_first(at_pos, d, callee, args_, ret_ty, sm)
  }
}

fn resolve_call_inst_first(at_pos: [MonoInstPair], d: Decl,
                            callee: Expr, args_: [Expr], ret_ty: Option[Ty],
                            sm: SubstMap) : Option[MonoInstPair] {
  match at_pos {
    [MIPair(tys0, units0), ..._] -> {
      let tys = map(tys0, (t) => subst_ty(t, sm))
      let units = map(units0, (u) => unit_canon(subst_unit(u, sm)))
      Some(MIPair(tys, units))
    }
    [] -> synth_inst_pair(d, callee, args_, ret_ty, sm)
  }
}

fn synth_inst_pair(d: Decl, callee: Expr,
                    args_: [Expr], ret_ty: Option[Ty], sm: SubstMap) : Option[MonoInstPair] =
  match synthesize_inst_for_decl(d, args_, ret_ty, callee.line, callee.col) {
    Some(RCS(_, _, _, tys0, units0, _)) -> {
      let tys = map(tys0, (t) => subst_ty(t, sm))
      let units = map(units0, (u) => unit_canon(subst_unit(u, sm)))
      Some(MIPair(tys, units))
    }
    None -> None
  }

#[doc("The types and units of one instantiation.")]
pub(pkg) type MonoInstPair = MIPair([Ty], [UnitExprT])

# Pre-mono pass: walk every decl looking for calls to a generic whose
# tuple isn't in the typer's `tp.insts` (an impl function a dispatcher
# call was retargeted to) and synthesise the per-call tuple via
# `synthesize_inst_for_decl`. With no SubstMap the resolver returns
# the actual call-site tuple; only concrete tuples enter the spec
# worklist. This is what gives `print("...#{x}...#{y}...")` distinct
# specialisations of `show` even though the interpolation desugar
# collapses every show callee onto the enclosing print's source position.
#[doc("The specialisations the impl-side calls of `ds` need that `existing` does not hold.")]
pub(pkg) fn collect_impl_tuples_in_decls(ds: [Decl], polys: PolyIx,
                                 existing: TupleSet) : [MonoTuple] {
  let r = collect_impl_tuples_in_decls_loop(ds, polys, existing, [])
  list_reverse(r)
}

fn collect_impl_tuples_in_decls_loop(ds: [Decl], polys: PolyIx,
                                      existing: TupleSet,
                                      acc: [MonoTuple]) : [MonoTuple] {
  match ds {
    [] -> acc
    [d, ...rest] ->
      collect_impl_tuples_in_decls_loop(rest, polys, existing,
        discover_new_tuples_args(decl_bodies(d), iix_empty(), polys, existing, subst_map_empty(), acc))
  }
}

#[doc("""
Walk a decl's bodies collecting concrete poly tuples introduced by
applying `sm` to each call site's recorded `(tys, units)`.
""")]
pub(pkg) fn discover_new_tuples_decl(d: Decl, insts: InstIndex, polys: PolyIx,
                             existing: TupleSet, sm: SubstMap) : [MonoTuple] =
  list_reverse(discover_new_tuples_args(decl_bodies(d), insts, polys, existing, sm, []))

fn discover_new_tuples_expr(e: Expr, insts: InstIndex, polys: PolyIx,
                             existing: TupleSet, sm: SubstMap,
                             acc: [MonoTuple]) : [MonoTuple] {
  let acc1 = discover_new_tuples_kind(e.kind, insts, polys, existing, sm, acc)
  match e.kind {
    ECall(callee, args_) -> match lookup_poly_fn_at(polys, callee) {
      Some(d) -> discover_call_tuple(d, callee, args_, e.ty, insts, polys, existing, sm, acc1)
      None    -> acc1
    }
    _ -> acc1
  }
}

# The tuple a call to the generic `d` instantiates, when it is concrete
# and not known yet.
fn discover_call_tuple(d: Decl, callee: Expr, args_: [Expr],
                        ret_ty: Option[Ty], insts: InstIndex, polys: PolyIx,
                        existing: TupleSet, sm: SubstMap,
                        acc1: [MonoTuple]) : [MonoTuple] =
  match resolve_call_inst(insts, polys, d, callee, args_, ret_ty, sm) {
    Some(MIPair(tys, units)) -> {
      let any_slot = list_length(tys) > 0 or list_length(units) > 0
      let concrete = any_slot and tuple_concrete(tys) and units_concrete(units)
      let mt = MT(poly_decl_sym(d), tys, units)
      let is_new = concrete and not ts_mem(existing, mt) and not mt_in_acc(acc1, mt)
      if is_new { [mt, ...acc1] } else { acc1 }
    }
    None -> acc1
  }

fn mt_in_acc(acc: [MonoTuple], t: MonoTuple) : Bool {
  match acc {
    [] -> false
    [h, ...rest] -> if tuple_eq(h, t) { true } else { mt_in_acc(rest, t) }
  }
}

# Recurse through every direct sub-Expr inside an ExprKind so the
# discovery walker can find calls in nested positions. Uses
# mono_map_expr_kind shape but with a fold accumulator.
fn discover_new_tuples_kind(k: ExprKind, insts: InstIndex, polys: PolyIx,
                             existing: TupleSet, sm: SubstMap,
                             acc: [MonoTuple]) : [MonoTuple] {
  match k {
    EInt(_, _)        -> acc
    EReal(_, _)       -> acc
    EIntLit(_)        -> acc
    EDecimalLit(_)    -> acc
    EFixed(_, _)      -> acc
    EBool(_)       -> acc
    EChar(_)       -> acc
    EStr(_, _)     -> acc
    EUnit          -> acc
    EName(_)        -> acc
    EMark(_)        -> acc
    ESym(_, _)      -> acc
    ELocal(_)       -> acc
    EOp(_)          -> acc
    EUnder         -> acc
    EPlaceholder   -> acc
    EHole(_)       -> acc
    ETodo(_)       -> acc
    EExternBody(_, _) -> acc
    EVariantsOf(_, _) -> acc
    EModCall(_, _) -> acc
    EIntrinsic(_, args_) -> discover_new_tuples_args(args_, insts, polys, existing, sm, acc)
    ESurface(sf) -> discover_new_tuples_args(surface_children(sf), insts, polys, existing, sm, acc)
    ECall(callee, args_) -> {
      let acc1 = discover_new_tuples_expr(callee, insts, polys, existing, sm, acc)
      discover_new_tuples_args(args_, insts, polys, existing, sm, acc1)
    }
    EField(base, _)   -> discover_new_tuples_expr(base, insts, polys, existing, sm, acc)
    EIndex(a, b)      -> discover_new_tuples_expr(b, insts, polys, existing, sm,
                          discover_new_tuples_expr(a, insts, polys, existing, sm, acc))
    EBinop(_, a, b)   -> discover_new_tuples_expr(b, insts, polys, existing, sm,
                          discover_new_tuples_expr(a, insts, polys, existing, sm, acc))
    EUnop(_, x)       -> discover_new_tuples_expr(x, insts, polys, existing, sm, acc)
    EIf(c, t_, eo)    -> {
      let a1 = discover_new_tuples_expr(c, insts, polys, existing, sm, acc)
      let a2 = discover_new_tuples_expr(t_, insts, polys, existing, sm, a1)
      match eo { Some(eb) -> discover_new_tuples_expr(eb, insts, polys, existing, sm, a2) None -> a2 }
    }
    EMatch(scr, arms) -> {
      let a1 = discover_new_tuples_expr(scr, insts, polys, existing, sm, acc)
      discover_new_tuples_arms(arms, insts, polys, existing, sm, a1)
    }
    ELambda(_, b)     -> discover_new_tuples_expr(b, insts, polys, existing, sm, acc)
    ERecordLit(_, fs) -> discover_new_tuples_fields(fs, insts, polys, existing, sm, acc)
    EList(els)        -> discover_new_tuples_elems(els, insts, polys, existing, sm, acc)
    ERange(a, b, opt_step) -> {
      let a1 = discover_new_tuples_expr(a, insts, polys, existing, sm, acc)
      let a2 = discover_new_tuples_expr(b, insts, polys, existing, sm, a1)
      match opt_step { Some(e3) -> discover_new_tuples_expr(e3, insts, polys, existing, sm, a2) None -> a2 }
    }
    EBlock(stmts, tail) -> {
      let a1 = discover_new_tuples_stmts(stmts, insts, polys, existing, sm, acc)
      match tail { Some(e3) -> discover_new_tuples_expr(e3, insts, polys, existing, sm, a1) None -> a1 }
    }
    EPipe(a, b)      -> discover_new_tuples_expr(b, insts, polys, existing, sm,
                         discover_new_tuples_expr(a, insts, polys, existing, sm, acc))
    EDispatchPipe(_, a, b) -> discover_new_tuples_expr(b, insts, polys, existing, sm,
                         discover_new_tuples_expr(a, insts, polys, existing, sm, acc))
    EHandle(body, _, _, init_opt, _, clauses, ret_opt) -> {
      let a1 = discover_new_tuples_expr(body, insts, polys, existing, sm, acc)
      let a2 = match init_opt { Some(e3) -> discover_new_tuples_expr(e3, insts, polys, existing, sm, a1) None -> a1 }
      let a3 = discover_new_tuples_clauses(clauses, insts, polys, existing, sm, a2)
      match ret_opt { Some(r) -> match r { HR(_, b, _, _) -> discover_new_tuples_expr(b, insts, polys, existing, sm, a3) } None -> a3 }
    }
    ELitUnit(inner, _) -> discover_new_tuples_expr(inner, insts, polys, existing, sm, acc)
    EBang(inner)       -> discover_new_tuples_expr(inner, insts, polys, existing, sm, acc)
  }
}

fn discover_new_tuples_args(args: [Expr], insts: InstIndex, polys: PolyIx,
                             existing: TupleSet, sm: SubstMap,
                             acc: [MonoTuple]) : [MonoTuple] {
  match args {
    [] -> acc
    [a, ...rest] -> discover_new_tuples_args(rest, insts, polys, existing, sm,
                      discover_new_tuples_expr(a, insts, polys, existing, sm, acc))
  }
}

fn discover_new_tuples_arms(arms: [Arm], insts: InstIndex, polys: PolyIx,
                             existing: TupleSet, sm: SubstMap,
                             acc: [MonoTuple]) : [MonoTuple] {
  match arms {
    [] -> acc
    [arm, ...rest] -> match arm {
      Arm(_, g, b) -> {
        let a1 = match g { Some(ge) -> discover_new_tuples_expr(ge, insts, polys, existing, sm, acc) None -> acc }
        let a2 = discover_new_tuples_expr(b, insts, polys, existing, sm, a1)
        discover_new_tuples_arms(rest, insts, polys, existing, sm, a2)
      }
    }
  }
}

fn discover_new_tuples_fields(fs: [FieldInit], insts: InstIndex, polys: PolyIx,
                               existing: TupleSet, sm: SubstMap,
                               acc: [MonoTuple]) : [MonoTuple] {
  match fs {
    [] -> acc
    [f, ...rest] -> match f {
      FI(_, v) -> discover_new_tuples_fields(rest, insts, polys, existing, sm,
                    discover_new_tuples_expr(v, insts, polys, existing, sm, acc))
    }
  }
}

fn discover_new_tuples_elems(els: [ListElem], insts: InstIndex, polys: PolyIx,
                              existing: TupleSet, sm: SubstMap,
                              acc: [MonoTuple]) : [MonoTuple] {
  match els {
    [] -> acc
    [el, ...rest] -> {
      let acc1 = match el {
        ElPlain(x)  -> discover_new_tuples_expr(x, insts, polys, existing, sm, acc)
        ElSpread(x) -> discover_new_tuples_expr(x, insts, polys, existing, sm, acc)
      }
      discover_new_tuples_elems(rest, insts, polys, existing, sm, acc1)
    }
  }
}

fn discover_new_tuples_stmts(stmts: [Stmt], insts: InstIndex, polys: PolyIx,
                              existing: TupleSet, sm: SubstMap,
                              acc: [MonoTuple]) : [MonoTuple] {
  match stmts {
    [] -> acc
    [s, ...rest] -> {
      let acc1 = match s {
        SLet(_, _, rhs)            -> discover_new_tuples_expr(rhs, insts, polys, existing, sm, acc)
        SAssert(c, m)              -> match m { Some(me) -> discover_new_tuples_expr(me, insts, polys, existing, sm, discover_new_tuples_expr(c, insts, polys, existing, sm, acc)) None -> discover_new_tuples_expr(c, insts, polys, existing, sm, acc) }
        SExprStmt(x)               -> discover_new_tuples_expr(x, insts, polys, existing, sm, acc)
        SIndexAssign(b, i, v, _, _)-> discover_new_tuples_expr(v, insts, polys, existing, sm,
                                        discover_new_tuples_expr(i, insts, polys, existing, sm,
                                          discover_new_tuples_expr(b, insts, polys, existing, sm, acc)))
        SAssign(b, v, _, _)        -> discover_new_tuples_expr(v, insts, polys, existing, sm,
                                        discover_new_tuples_expr(b, insts, polys, existing, sm, acc))
        SVar(_, _, rhs, _, _)      -> discover_new_tuples_expr(rhs, insts, polys, existing, sm, acc)
        SUse(_, _, _)              -> acc
      }
      discover_new_tuples_stmts(rest, insts, polys, existing, sm, acc1)
    }
  }
}

fn discover_new_tuples_clauses(cs: [HClause], insts: InstIndex, polys: PolyIx,
                                existing: TupleSet, sm: SubstMap,
                                acc: [MonoTuple]) : [MonoTuple] {
  match cs {
    [] -> acc
    [c, ...rest] -> match c {
      HC(_, _, b, _, _) -> discover_new_tuples_clauses(rest, insts, polys, existing, sm,
                            discover_new_tuples_expr(b, insts, polys, existing, sm, acc))
    }
  }
}

#[doc("""
The retargeted callee of a call: the spec by its identity, at the
callee's own position.
""")]
pub(pkg) fn spec_callee(callee: Expr, fid: FnId) : Expr =
  Expr { kind: ESym(fnid_sym(fid), fnid_inst(fid)), line: callee.line, col: callee.col, ty: callee.ty, mode: callee.mode,  site: callee.site }

#[doc("""
Retarget a spec body's calls to its own generic onto the spec. A
reference to the generic outside callee position (function-as-value)
is left alone, so the polymorphic surface stays for partial
application and higher-order use.
""")]
pub(pkg) fn retarget_self_calls_decl(d: Decl) : Decl = match d {
  DFn(p, fid, tp, ps, rt, row, body, ln, cl, mo) ->
    DFn(p, fid, tp, ps, rt, row, retarget_self_calls_expr(body, fid), ln, cl, mo)
  _ -> d
}

fn retarget_self_calls_expr(e: Expr, me: FnId) : Expr =
  Expr { kind: retarget_self_calls_kind(e.kind, me),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn retarget_self_calls_kind(k: ExprKind, me: FnId) : ExprKind {
  match k {
    ECall(callee, args_) -> {
      let new_args = map(args_, (a) => retarget_self_calls_expr(a, me))
      if rsc_is_self(callee.kind, me) { ECall(spec_callee(callee, me), new_args) }
      else { ECall(retarget_self_calls_expr(callee, me), new_args) }
    }
    _ -> mono_map_expr_kind(k, (sub) => retarget_self_calls_expr(sub, me))
  }
}

# A callee already naming an instance is a sibling spec (an impl
# recursing on its own type at another instantiation), never the generic.
fn rsc_is_self(callee: ExprKind, me: FnId) : Bool =
  match callee {
    ESym(s, k) -> sym_raw(s) >= 0 and sym_same(s, fnid_sym(me)) and k == spec_none()
    _          -> false
  }

#[doc("""
rewrite_callsites_decl with an explicit SubstMap. Pre-mono uses
`subst_map_empty()`; per-spec uses the spec's own map. Subst is
applied to the looked-up `(tys, units)` at each call site so that
internal polymorphic-flow-through calls retarget to their specs.
""")]
pub(pkg) fn rewrite_callsites_decl_sm(d: Decl, insts: InstIndex,
                              tuples: TupleSet, polys: PolyIx,
                              sm: SubstMap) : Decl =
  decl_map_bodies(d, (body) => rewrite_callsites_expr_sm(body, insts, tuples, polys, sm))

fn rewrite_callsites_expr_sm(e: Expr, insts: InstIndex,
                              tuples: TupleSet, polys: PolyIx,
                              sm: SubstMap) : Expr =
  Expr { kind: rewrite_callsites_kind_sm(e.kind, e.ty, insts, tuples, polys, sm),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn rewrite_callsites_kind_sm(k: ExprKind, ret_ty: Option[Ty], insts: InstIndex,
                              tuples: TupleSet, polys: PolyIx,
                              sm: SubstMap) : ExprKind {
  match k {
    ECall(callee, args_) -> {
      let new_args = map(args_, (a) => rewrite_callsites_expr_sm(a, insts, tuples, polys, sm))
      match lookup_poly_fn_at(polys, callee) {
        Some(d) -> rewrite_poly_call(d, callee, new_args, ret_ty, insts, tuples, polys, sm)
        None    -> ECall(rewrite_callsites_expr_sm(callee, insts, tuples, polys, sm), new_args)
      }
    }
    _ -> mono_map_expr_kind(k, (sub) => rewrite_callsites_expr_sm(sub, insts, tuples, polys, sm))
  }
}

# Retarget a call to the generic `d` to the spec of the tuple it
# instantiates, when that tuple has one.
fn rewrite_poly_call(d: Decl, callee: Expr, new_args: [Expr], ret_ty: Option[Ty],
                      insts: InstIndex, tuples: TupleSet, polys: PolyIx,
                      sm: SubstMap) : ExprKind =
  match resolve_call_inst(insts, polys, d, callee, new_args, ret_ty, sm) {
    Some(MIPair(tys, units)) -> {
      let inst = ts_inst(tuples, MT(poly_decl_sym(d), tys, units))
      if inst == spec_none() { ECall(callee, new_args) }
      else { ECall(spec_callee(callee, FnId(poly_decl_sym(d), inst)), new_args) }
    }
    None -> ECall(callee, new_args)
  }

#[doc("""
---- m4c Phase 2 — call-site rewrite ----

Walk every DFn / DTest body and rewrite each call to a generic whose
`(id, callee.line, callee.col)` matches a `ResolvedCS` with concrete
tys+units that produced a specialisation in `tuples`. The rewritten
callee names the spec by its identity at the same source position;
args recurse under the same walker.

Keying is `(id, line, col)` against insts because the typer pushes
one call site per polymorphic instantiation, at the reference's
position.

A reference to a generic outside callee position (function-as-value,
partial application) is left untouched: the polymorphic original stays
in the decl list specifically to support those uses.
Pre-mono rewrite over the whole program. Delegates to the SM-aware
rewriter with an empty SubstMap, so call sites whose recorded tys/
units are already concrete retarget to their specs; ones
whose tuples still contain `TyVarT` / `UVar` (polymorphic flow-
through) leave the callee alone — those become concrete only inside
specs, where `rewrite_callsites_decl_sm` runs with the spec's map.
""")]
pub(pkg) fn rewrite_callsites_decls_full(ds: [Decl], insts: InstIndex,
                                 tuples: TupleSet, polys: PolyIx) : [Decl] =
  map(ds, (d) => rewrite_callsites_decl_sm(d, insts, tuples, polys, subst_map_empty()))
