#[doc("""
Surface lowering before the resolver. This module holds the walkers over
a whole expression tree: reads of a cell lowered to gets, calls on a
nursery capability rewritten to the operations they perform, and the
escape analysis of a body.
""")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.loop_lower
import compiler.core_builtins
import compiler.written
import compiler.desugar_map
import compiler.desugar_pat_names
import compiler.desugar_rename
import compiler.desugar_record_lit
import compiler.desugar_cell_access
import compiler.desugar_nursery_types
import compiler.desugar_cell_escape
import compiler.desugar_contains
import compiler.desugar_brand_env

# Expand `T { ...src, x: 10, y: 20 }` into a let-block:
#
#     {
#       let __spread_src_<line>_<col>__ = src
#       T { f1: __spread_src_*.f1, ..., x: 10, y: 20, ... }
#     }
#
# The let captures `src` once so a side-effecting source expression
# isn't replayed across N field accesses. The fields are emitted
# in declared order: an override wins over the spread copy. Errors:
#   * unknown record type for `T` → "unknown record type T"
#   * any override field that isn't a declared field of `T`
#   * duplicate override of the same field

#[doc("A record literal with a spread, lowered: the declared fields in order, an override winning over the spread copy.")]
pub fn dpr_record_spread(
  rh: DeclRef,
  fis: [FieldInit],
  line: Int,
  col: Int,
  recs: RecScope,
  file: String,
  errs: Int
) : DPRSpread / Console + File {

  # Split: head FI is the spread field carrying `src`; rest are
  # named overrides (parser already rejected pun / positional /
  # second-spread, so each FI here pairs a real field name with an
  # already-recursed expression).
  match fis {
    [] -> DPRSpread { expr: mk_expr(ERecordLit(rh, fis), line, col), errs: errs }
    [head, ...overrides] -> match head {
      FI(_, marked) -> {
        let src = field_written(marked)
        match rec_of_head(recs, rh) {
          None -> {
            diag_error(file, line, col,
              concat_all(["unknown record type `", rec_head_text(recs, rh),
                          "` in `...` spread; declare the type before constructing it"]))
            DPRSpread { expr: mk_expr(ERecordLit(rh, fis), line, col), errs: errs + 1 }
          }
          Some(ri) -> match ri {
            RI(_, tparams, fds, _) -> {
              # Diagnose duplicate overrides (same field listed twice).
              let dup_errs = check_spread_dup_overrides(overrides, [], file, line, col, 0)
              # Diagnose overrides naming a field not declared on `T`.
              let bad_errs = check_spread_unknown_overrides(overrides, fds, rec_head_text(recs, rh), file, line, col, 0)
              let errs1 = errs + dup_errs + bad_errs
              if dup_errs + bad_errs > 0 {
                DPRSpread { expr: mk_expr(ERecordLit(rh, fis), line, col), errs: errs1 }
              } else {
                let var_name = spread_src_var_name(line, col)
                let head = head_settled(rh, ri)
                let bind_pat = mk_pat(PBind(binder_minted(var_name)), line, col)
                # Annotate the let with `T` for non-generic records so
                # the existing nominal let-annotation check fires when
                # `src : Q` with `Q != T` — spec's "spread source must
                # match record type" reusing the typer's normal error
                # path. Skipped for generic records: `T[a, b]` cannot
                # be spelled without committing to a concrete arg
                # tuple, so we let the typer infer and rely on its
                # field-by-field check instead.
                let ann_opt = match tparams {
                  []           -> Some(mk_ty(TyName(head, []), line, col))
                  [_, ..._rest] -> None
                }
                let bind_stmt = SLet(bind_pat, ann_opt, src)
                let var_ref = mk_name(var_name, line, col)
                let expanded = expand_spread_fields(fds, overrides, var_ref, line, col)
                let lit = mk_expr(ERecordLit(head, expanded), line, col)
                DPRSpread { expr: mk_expr(EBlock([bind_stmt], Some(lit)), line, col), errs: errs1 }
              }
            }
          }
        }
      }
    }
  }
}

#[doc("`e` with each read of a cell of `caps` lowered to a get of that cell.")]
pub fn lcr_expr(e: Expr, caps: [String], reject_at: Bool, file: String, errs: Int) : VLExpr / Console + File {

  let r = lcr_kind(e.kind, caps, reject_at, e.line, e.col, file, errs)
  VLExpr { expr: Expr { kind: r.expr.kind, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site },
           errs: r.errs }
}

fn lcr_opt(o: Option[Expr], caps: [String], reject_at: Bool, file: String, errs: Int) : VLOpt / Console + File {

  match o {
    Some(e) -> { let r = lcr_expr(e, caps, reject_at, file, errs)
                 VLOpt { opt: Some(r.expr), errs: r.errs } }
    None    -> VLOpt { opt: None, errs: errs }
  }
}

fn lcr_exprs(es: [Expr], caps: [String], reject_at: Bool, file: String, errs: Int) : VLExprs / Console + File {

  match es {
    [] -> VLExprs { exprs: [], errs: errs }
    [h, ...rest] -> {
      let r1 = lcr_expr(h, caps, reject_at, file, errs)
      let r2 = lcr_exprs(rest, caps, reject_at, file, r1.errs)
      VLExprs { exprs: [r1.expr, ...r2.exprs], errs: r2.errs }
    }
  }
}

fn lcr_elems(les: [ListElem], caps: [String], reject_at: Bool, file: String, errs: Int) : VLElems / Console + File {

  match les {
    [] -> VLElems { elems: [], errs: errs }
    [h, ...rest] -> {
      let r1 = match h {
        ElPlain(e)  -> { let r = lcr_expr(e, caps, reject_at, file, errs)
                         VLExpr { expr: r.expr, errs: r.errs } }
        ElSpread(e) -> { let r = lcr_expr(e, caps, reject_at, file, errs)
                         VLExpr { expr: r.expr, errs: r.errs } }
      }
      let wrapped = match h { ElPlain(_) -> ElPlain(r1.expr)  ElSpread(_) -> ElSpread(r1.expr) }
      let r2 = lcr_elems(rest, caps, reject_at, file, r1.errs)
      VLElems { elems: [wrapped, ...r2.elems], errs: r2.errs }
    }
  }
}

fn lcr_fields(fs: [FieldInit], caps: [String], reject_at: Bool, file: String, errs: Int) : VLFields / Console + File {

  match fs {
    [] -> VLFields { fields: [], errs: errs }
    [FI(nm, v), ...rest] -> {
      let r1 = lcr_expr(v, caps, reject_at, file, errs)
      let r2 = lcr_fields(rest, caps, reject_at, file, r1.errs)
      VLFields { fields: [FI(nm, r1.expr), ...r2.fields], errs: r2.errs }
    }
  }
}

fn lcr_arms(arms: [Arm], caps: [String], reject_at: Bool, file: String, errs: Int) : VLArms / Console + File {

  match arms {
    [] -> VLArms { arms: [], errs: errs }
    [Arm(p, g, b), ...rest] -> {
      let names = dsg_rename_pat_names(p, [])
      let caps1 = caps_minus_names(caps, names)
      let rg = lcr_opt(g, caps1, reject_at, file, errs)
      let rb = lcr_expr(b, caps1, reject_at, file, rg.errs)
      let r2 = lcr_arms(rest, caps, reject_at, file, rb.errs)
      VLArms { arms: [Arm(p, rg.opt, rb.expr), ...r2.arms], errs: r2.errs }
    }
  }
}

fn lcr_clauses(cs: [HClause], caps: [String], reject_at: Bool, file: String, errs: Int) : VLClauses / Console + File {

  match cs {
    [] -> VLClauses { clauses: [], errs: errs }
    [HC(nm, ps, b, l, c), ...rest] -> {
      let pnames = dsg_rename_param_names(ps, [])
      let rb = lcr_expr(b, caps_minus_names(caps, pnames), reject_at, file, errs)
      let r2 = lcr_clauses(rest, caps, reject_at, file, rb.errs)
      VLClauses { clauses: [HC(nm, ps, rb.expr, l, c), ...r2.clauses], errs: r2.errs }
    }
  }
}

# `@x`, the operand `x` of a `MkDeref` call. On a `Ref[T]` named `n` it
# is the read `n.get()`, which the alias rewrite maps to
# `Mutable.ref_get(n)`. A `var`/`State`/`Reader` cell reads naked and is
# not a `Ref`, so `@` on one is rejected and the node stays as written.
fn lcr_deref(callee: Expr, x: Expr, caps: [String], reject_at: Bool, line: Int, col: Int, file: String, errs: Int) : VLExpr / Console + File = match x.kind {
  EName(w) -> {
    let n = written_text(w)
    if list_has(caps, n) {
      diag_error(file, line, col, concat_all([
        "`@", n, "` is not how a `var` cell is read — read it naked, as `", n, "`"
      ]))
      diag_help(concat_all([
        "`@` dereferences a first-class `Ref[T]`; a `var`/`State`/`Reader` cell is block-local and reads without `@`"
      ]))
      VLExpr { expr: mk_expr(ECall(callee, [x]), line, col), errs: errs + 1 }
    } else {
      let getter = mk_expr(EField(mk_name(n, x.line, x.col), "get"), line, col)
      VLExpr { expr: mk_expr(ECall(getter, []), line, col), errs: errs }
    }
  }
  _ -> {
    let r = lcr_expr(x, caps, reject_at, file, errs)
    VLExpr { expr: mk_expr(ECall(callee, [r.expr]), line, col), errs: r.errs }
  }
}

fn lcr_kind(k: ExprKind, caps: [String], reject_at: Bool, line: Int, col: Int, file: String, errs: Int) : VLExpr / Console + File {

  match k {
    EName(w) -> {
      let n = written_text(w)
      if list_has(caps, n) {
        VLExpr { expr: mk_expr(mk_cell_get(n, line, col), line, col), errs: errs }
      } else { VLExpr { expr: mk_name(n, line, col), errs: errs } }
    }
    # `caps` are capability binders, so a resolved reference is never
    # one and needs no cell read.
    ESym(_, _) -> VLExpr { expr: mk_expr(k, line, col), errs: errs }
    ECall(callee, args_) -> match callee.kind {
      EMark(MkDeref) -> match args_ {
        [x] -> lcr_deref(callee, x, caps, reject_at, line, col, file, errs)
        _   -> VLExpr { expr: mk_expr(k, line, col), errs: errs }
      }
      # A var's slot: every late read of the var is sent to it by the
      # enclosing block, so it becomes the allocation it stood for.
      EMark(MkVarSlot(_)) -> {
        let ra = lcr_exprs(args_, caps, reject_at, file, errs)
        VLExpr { expr: mk_expr(var_slot_call(k, ra.exprs), line, col), errs: ra.errs }
      }
      EField(base, fname) -> match base.kind {
        EName(w) ->
          if list_has(caps, written_text(w)) and (fname == "get" or fname == "set") {
            # A real State op on the cell: `n.get()` (also what a naked
            # read lowers to) or `n.set(v)` (also what `n := v` lowers
            # to). Legal — recurse into the args only, NOT the callee,
            # whose `EName(n)` base would re-lower to `n.get()` and yield
            # `n.get().get()`. Escape is rejected separately.
            let ra = lcr_exprs(args_, caps, reject_at, file, errs)
            VLExpr { expr: mk_expr(ECall(callee, ra.exprs), line, col), errs: ra.errs }
          } else {
            let rc = lcr_expr(callee, caps, reject_at, file, errs)
            let ra = lcr_exprs(args_, caps, reject_at, file, rc.errs)
            VLExpr { expr: mk_expr(ECall(rc.expr, ra.exprs), line, col), errs: ra.errs }
          }
        _ -> {
          let rc = lcr_expr(callee, caps, reject_at, file, errs)
          let ra = lcr_exprs(args_, caps, reject_at, file, rc.errs)
          VLExpr { expr: mk_expr(ECall(rc.expr, ra.exprs), line, col), errs: ra.errs }
        }
      }
      _ -> {
        let rc = lcr_expr(callee, caps, reject_at, file, errs)
        let ra = lcr_exprs(args_, caps, reject_at, file, rc.errs)
        VLExpr { expr: mk_expr(ECall(rc.expr, ra.exprs), line, col), errs: ra.errs }
      }
    }
    EBlock(stmts, tail) -> {
      let r = lcr_block(stmts, tail, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EBlock(r.stmts, r.opt), line, col), errs: r.errs }
    }
    ELambda(ps, body) -> {
      let pnames = dsg_rename_param_names(ps, [])
      let r = lcr_expr(body, caps_minus_names(caps, pnames), reject_at, file, errs)
      VLExpr { expr: mk_expr(ELambda(ps, r.expr), line, col), errs: r.errs }
    }
    EMatch(scr, arms) -> {
      let rs = lcr_expr(scr, caps, reject_at, file, errs)
      let ra = lcr_arms(arms, caps, reject_at, file, rs.errs)
      VLExpr { expr: mk_expr(EMatch(rs.expr, ra.arms), line, col), errs: ra.errs }
    }
    EHandle(body, eff, tys, init_opt, alias_opt, clauses, ret_opt) -> {
      let ri = lcr_opt(init_opt, caps, reject_at, file, errs)
      let body_caps = match alias_opt {
        Some(a) ->
          if eff_is_cell(ref_sym(eff)) { [written_text(a.name), ...caps_remove_name(caps, written_text(a.name))] }
          else { caps_remove_name(caps, written_text(a.name)) }
        None -> caps
      }
      let rb = lcr_expr(body, body_caps, reject_at, file, ri.errs)
      # A `with Eff as a` capability — a `var`/State/Reader cell OR a §6 named
      # instance — may not outlive the handle that installed it: its evidence
      # node is torn down at the closing brace. The same positional escape check
      # (a closure that captures `a` and survives the block) applies to both.
      let esc = match alias_opt {
        Some(a) -> lcr_escape_in_value(rb.expr, written_text(a.name), file)
        None -> 0
      }
      let rc = lcr_clauses(clauses, caps, reject_at, file, rb.errs + esc)
      let rr = match ret_opt {
        Some(HR(p, rbody, hl, hc)) -> {
          let r = lcr_expr(rbody, caps_remove_name(caps, written_text(p.name)), reject_at, file, rc.errs)
          VLExpr { expr: r.expr, errs: r.errs }
        }
        None -> VLExpr { expr: mk_expr(EUnit, line, col), errs: rc.errs }
      }
      let ret_opt1 = match ret_opt {
        Some(HR(p, _, hl, hc)) -> Some(HR(p, rr.expr, hl, hc))
        None -> None
      }
      VLExpr { expr: mk_expr(EHandle(rb.expr, eff, tys, ri.opt, alias_opt, rc.clauses, ret_opt1), line, col), errs: rr.errs }
    }
    EField(base, nm) -> {
      let r = lcr_expr(base, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EField(r.expr, nm), line, col), errs: r.errs }
    }
    EIndex(b, i) -> {
      let r1 = lcr_expr(b, caps, reject_at, file, errs)
      let r2 = lcr_expr(i, caps, reject_at, file, r1.errs)
      VLExpr { expr: mk_expr(EIndex(r1.expr, r2.expr), line, col), errs: r2.errs }
    }
    EBinop(op, a, b) -> {
      let r1 = lcr_expr(a, caps, reject_at, file, errs)
      let r2 = lcr_expr(b, caps, reject_at, file, r1.errs)
      VLExpr { expr: mk_expr(EBinop(op, r1.expr, r2.expr), line, col), errs: r2.errs }
    }
    EUnop(op, x) -> {
      let r = lcr_expr(x, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EUnop(op, r.expr), line, col), errs: r.errs }
    }
    EIf(c, t_, eo) -> {
      let r1 = lcr_expr(c, caps, reject_at, file, errs)
      let r2 = lcr_expr(t_, caps, reject_at, file, r1.errs)
      let r3 = lcr_opt(eo, caps, reject_at, file, r2.errs)
      VLExpr { expr: mk_expr(EIf(r1.expr, r2.expr, r3.opt), line, col), errs: r3.errs }
    }
    EList(elems) -> {
      let r = lcr_elems(elems, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EList(r.elems), line, col), errs: r.errs }
    }
    EPipe(a, b) -> {
      let r1 = lcr_expr(a, caps, reject_at, file, errs)
      let r2 = lcr_expr(b, caps, reject_at, file, r1.errs)
      VLExpr { expr: mk_expr(EPipe(r1.expr, r2.expr), line, col), errs: r2.errs }
    }
    EMapPipe(a, b) -> {
      let r1 = lcr_expr(a, caps, reject_at, file, errs)
      let r2 = lcr_expr(b, caps, reject_at, file, r1.errs)
      VLExpr { expr: mk_expr(EMapPipe(r1.expr, r2.expr), line, col), errs: r2.errs }
    }
    EFlatMapPipe(a, b) -> {
      let r1 = lcr_expr(a, caps, reject_at, file, errs)
      let r2 = lcr_expr(b, caps, reject_at, file, r1.errs)
      VLExpr { expr: mk_expr(EFlatMapPipe(r1.expr, r2.expr), line, col), errs: r2.errs }
    }
    EFilterPipe(a, b) -> {
      let r1 = lcr_expr(a, caps, reject_at, file, errs)
      let r2 = lcr_expr(b, caps, reject_at, file, r1.errs)
      VLExpr { expr: mk_expr(EFilterPipe(r1.expr, r2.expr), line, col), errs: r2.errs }
    }
    ERange(a, b, opt_step) -> {
      let r1 = lcr_expr(a, caps, reject_at, file, errs)
      let r2 = lcr_expr(b, caps, reject_at, file, r1.errs)
      let r3 = lcr_opt(opt_step, caps, reject_at, file, r2.errs)
      VLExpr { expr: mk_expr(ERange(r1.expr, r2.expr, r3.opt), line, col), errs: r3.errs }
    }
    ERecordLit(rh, fields) -> {
      let r = lcr_fields(fields, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(ERecordLit(rh, r.fields), line, col), errs: r.errs }
    }
    EBang(inner) -> {
      let r = lcr_expr(inner, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EBang(r.expr), line, col), errs: r.errs }
    }
    ELitUnit(inner, u) -> {
      let r = lcr_expr(inner, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(ELitUnit(r.expr, u), line, col), errs: r.errs }
    }
    # A loop intrinsic's lambdas read cells like any eagerly-applied
    # closure; the post-interp relower must reach the reads the interp
    # lift plants inside them.
    EIntrinsic(nm, args_) -> {
      let r = lcr_exprs(args_, caps, reject_at, file, errs)
      VLExpr { expr: mk_expr(EIntrinsic(nm, r.exprs), line, col), errs: r.errs }
    }
    _ -> VLExpr { expr: mk_expr(k, line, col), errs: errs }
  }
}

fn lcr_block(stmts: [Stmt], tail: Option[Expr], caps: [String], reject_at: Bool, file: String, errs: Int) : VLStmts / Console + File {

  match stmts {
    [] -> { let r = lcr_opt(tail, caps, reject_at, file, errs)
            VLStmts { stmts: [], opt: r.opt, errs: r.errs } }
    [s, ...rest] -> match s {
      SLet(p, ann, rhs) -> {
        let r = lcr_expr(rhs, caps, reject_at, file, errs)
        let names = dsg_rename_pat_names(p, [])
        match var_slot_of(p, rhs) {
          Some(VarSlot(n, slot)) -> {
            # A var lowered to a slot: a read of it surfacing only now, from
            # an interpolation, lowers to `n.get()` and then to the slot.
            let r2 = lcr_block(rest, tail, [n, ...caps_minus_names(caps, names)], reject_at, file, r.errs)
            let body = specialise_body(n, slot, mk_expr(EBlock(r2.stmts, r2.opt), rhs.line, rhs.col))
            match body.kind {
              EBlock(ss, t) -> VLStmts { stmts: [SLet(p, ann, r.expr), ...ss], opt: t, errs: r2.errs }
              _             -> VLStmts { stmts: [SLet(p, ann, r.expr), ...r2.stmts], opt: r2.opt, errs: r2.errs }
            }
          }
          None -> {
            let r2 = lcr_block(rest, tail, caps_minus_names(caps, names), reject_at, file, r.errs)
            VLStmts { stmts: [SLet(p, ann, r.expr), ...r2.stmts], opt: r2.opt, errs: r2.errs }
          }
        }
      }
      SVar(b, ty, rhs, l, c) -> {
        let n = written_text(b.name)
        # The init runs under the *outer* caps (`var n := n` self-shadows
        # only after the binder, F# / Rust convention).
        let r = lcr_expr(rhs, caps, reject_at, file, errs)
        let caps1 = [n, ...caps_remove_name(caps, n)]
        let r2 = lcr_block(rest, tail, caps1, reject_at, file, r.errs)
        # `rest` + `tail` is exactly the block the var's `State[n]`
        # handler wraps. Reject a closure that reads/writes `n` and whose
        # value reaches the block's exit (tail / returned / stored) — the
        # handler is gone by the time such a closure could run.
        let esc = lcr_escape_check(r2.stmts, r2.opt, n, file)
        VLStmts { stmts: [SVar(b, ty, r.expr, l, c), ...r2.stmts], opt: r2.opt, errs: r2.errs + esc }
      }
      SExprStmt(x) -> {
        let r = lcr_expr(x, caps, reject_at, file, errs)
        let r2 = lcr_block(rest, tail, caps, reject_at, file, r.errs)
        VLStmts { stmts: [SExprStmt(r.expr), ...r2.stmts], opt: r2.opt, errs: r2.errs }
      }
      SIndexAssign(b, i, v, l, c) -> {
        let r1 = lcr_expr(b, caps, reject_at, file, errs)
        let r2 = lcr_expr(i, caps, reject_at, file, r1.errs)
        let r3 = lcr_expr(v, caps, reject_at, file, r2.errs)
        let r4 = lcr_block(rest, tail, caps, reject_at, file, r3.errs)
        VLStmts { stmts: [SIndexAssign(r1.expr, r2.expr, r3.expr, l, c), ...r4.stmts], opt: r4.opt, errs: r4.errs }
      }
      SAssign(b, v, l, c) -> {
        let r1 = lcr_expr(b, caps, reject_at, file, errs)
        let r3 = lcr_expr(v, caps, reject_at, file, r1.errs)
        let r4 = lcr_block(rest, tail, caps, reject_at, file, r3.errs)
        VLStmts { stmts: [SAssign(r1.expr, r3.expr, l, c), ...r4.stmts], opt: r4.opt, errs: r4.errs }
      }
      SAssert(c, m) -> {
        let r1 = lcr_expr(c, caps, reject_at, file, errs)
        let r2 = lcr_opt(m, caps, reject_at, file, r1.errs)
        let r3 = lcr_block(rest, tail, caps, reject_at, file, r2.errs)
        VLStmts { stmts: [SAssert(r1.expr, r2.opt), ...r3.stmts], opt: r3.opt, errs: r3.errs }
      }
      SUse(nm, l, c) -> {
        let r = lcr_block(rest, tail, caps, reject_at, file, errs)
        VLStmts { stmts: [SUse(nm, l, c), ...r.stmts], opt: r.opt, errs: r.errs }
      }
    }
  }
}

#[doc("""
Trigger 3: name appears in body ONLY as the immediate base of a
`name.get` or `name.set` field on the callee of a call. Any other
occurrence — closure capture, function-argument position, plain
value reference — is treated as escape and disables specialisation.
""")]
pub fn body_escapes(name: String, e: Expr) : Bool {
  match e.kind {
    EInt(_, _)  -> false
    EReal(_, _) -> false
    EIntLit(_) -> false
    EDecimalLit(_) -> false
    EFixed(_, _) -> false
    EBool(_) -> false
    EChar(_) -> false
    # A read inside a `#{...}` interpolation is still a raw span here; it
    # surfaces after the interpolation is lifted, and the cell-read
    # relowering sends it to the slot (`var_slot_of`), so it is a read.
    EStr(_, _) -> false
    EUnit -> false
    EUnder -> false
    EPlaceholder -> false
    EHole(_) -> false
    ETodo(_) -> false
    EExternBody(_, _) -> false
    EName(n) -> written_text(n) == name
    # Same reason as the cell scan: an `ESym` is a declaration, and
    # the binder whose escapes this measures is a local the source wrote.
    ESym(_, _) -> false
    ELocal(_) -> false
    EOp(_) -> false
    # A mark is planted after this pass; nothing it stands for can escape.
    EMark(_) -> false
    ECall(callee, args_) -> {
      let callee_is_get_set = match callee.kind {
        EField(base, fname) -> match base.kind {
          EName(n) ->
            if written_text(n) == name and (fname == "get" or fname == "set") { true }
            else { false }
          _ -> false
        }
        _ -> false
      }
      let callee_escape =
        if callee_is_get_set { false } else { body_escapes(name, callee) }
      callee_escape or args_escape(name, args_)
    }
    EField(base, _) -> body_escapes(name, base)
    EIndex(a, b) -> body_escapes(name, a) or body_escapes(name, b)
    EBinop(_, a, b) -> body_escapes(name, a) or body_escapes(name, b)
    EUnop(_, x) -> body_escapes(name, x)
    EIf(c, t_, eo) -> body_escapes(name, c) or body_escapes(name, t_) or opt_escapes(name, eo)
    EBlock(stmts, tail) -> stmts_escape(name, stmts) or opt_escapes(name, tail)
    EPipe(a, b) -> body_escapes(name, a) or body_escapes(name, b)
    EMapPipe(a, b) -> body_escapes(name, a) or body_escapes(name, b)
    EFlatMapPipe(a, b) -> body_escapes(name, a) or body_escapes(name, b)
    EFilterPipe(a, b) -> body_escapes(name, a) or body_escapes(name, b)
    EMatch(scr, arms) -> body_escapes(name, scr) or arms_escape(name, arms)
    ELambda(_, _) -> contains_var(name, e)
    EList(elems) -> elems_escape(name, elems)
    ERange(a, b, opt_step) -> body_escapes(name, a) or body_escapes(name, b) or opt_escapes(name, opt_step)
    ERecordLit(_, fields) -> fields_escape(name, fields)
    EHandle(body, _, _, init_opt, _, clauses, ret_opt) -> body_escapes(name, body) or opt_escapes(name, init_opt) or clauses_escape(name, clauses) or ret_opt_escapes(name, ret_opt)
    EBang(inner) -> body_escapes(name, inner)
    ELitUnit(inner, _) -> body_escapes(name, inner)
    # `variants[T]()` has no value-level sub-expressions —
    # nothing can mention `name` inside it.
    EVariantsOf(_, _) -> false
    # A qualified module call names a module and a function, never the
    # local `name`.
    EModCall(_, _) -> false
    # A loop intrinsic's lambda args are applied in place (the C emitter
    # pastes their bodies into an inline loop in the enclosing frame), so
    # a cell name under them is judged by the get/set-only rule, not the
    # closure-capture rule — the whole point of the loop lowering.
    EIntrinsic(nm, args_) ->
      if is_loop_intrinsic(nm) { loop_args_escape(name, args_) }
      else { args_escape(name, args_) }
    ESurface(sf) -> args_escape(name, surface_children(sf))
  }
}

fn loop_args_escape(name: String, es: [Expr]) : Bool {
  match es {
    [] -> false
    [h, ...rest] -> {
      let here = match h.kind {
        ELambda(ps, b) -> match ps { [] -> body_escapes(name, b) _ -> body_escapes(name, h) }
        _ -> body_escapes(name, h)
      }
      if here { true } else { loop_args_escape(name, rest) }
    }
  }
}

fn args_escape(name: String, es: [Expr]) : Bool {
  match es {
    [] -> false
    [h, ...rest] -> if body_escapes(name, h) { true } else { args_escape(name, rest) }
  }
}

fn opt_escapes(name: String, opt: Option[Expr]) : Bool {
  match opt {
    None -> false
    Some(e) -> body_escapes(name, e)
  }
}

fn stmts_escape(name: String, ss: [Stmt]) : Bool {
  match ss {
    [] -> false
    [s, ...rest] -> if stmt_escapes(name, s) { true } else { stmts_escape(name, rest) }
  }
}

fn stmt_escapes(name: String, s: Stmt) : Bool {
  match s {
    SLet(_, _, rhs) -> body_escapes(name, rhs)
    SAssert(c, msg) -> body_escapes(name, c) or opt_escapes(name, msg)
    SExprStmt(x) -> body_escapes(name, x)
    SIndexAssign(b, i, v, _, _) ->
      body_escapes(name, b) or body_escapes(name, i) or body_escapes(name, v)
    SAssign(b, v, _, _) ->
      body_escapes(name, b) or body_escapes(name, v)
    SVar(_, _, rhs, _, _) -> body_escapes(name, rhs)
    # SUse has no expr — name cannot escape through it.
    SUse(_, _, _) -> false
  }
}

fn arms_escape(name: String, arms: [Arm]) : Bool {
  match arms {
    [] -> false
    [a, ...rest] -> if arm_escapes(name, a) { true } else { arms_escape(name, rest) }
  }
}

fn arm_escapes(name: String, a: Arm) : Bool {
  match a {
    Arm(_, opt_g, b) -> opt_escapes(name, opt_g) or body_escapes(name, b)
  }
}

fn elems_escape(name: String, es: [ListElem]) : Bool {
  match es {
    [] -> false
    [el, ...rest] -> match el {
      ElPlain(x)  -> if body_escapes(name, x) { true } else { elems_escape(name, rest) }
      ElSpread(x) -> if body_escapes(name, x) { true } else { elems_escape(name, rest) }
    }
  }
}

fn fields_escape(name: String, fs: [FieldInit]) : Bool {
  match fs {
    [] -> false
    [f, ...rest] -> match f {
      FI(_, v) -> if body_escapes(name, v) { true } else { fields_escape(name, rest) }
    }
  }
}

fn clauses_escape(name: String, cs: [HClause]) : Bool {
  match cs {
    [] -> false
    [c, ...rest] -> match c {
      HC(_, _, b, _, _) ->
        if body_escapes(name, b) { true } else { clauses_escape(name, rest) }
    }
  }
}

fn ret_opt_escapes(name: String, opt: Option[HReturn]) : Bool {
  match opt {
    None -> false
    Some(r) -> match r { HR(_, b, _, _) -> body_escapes(name, b) }
  }
}

# The two operations of a var: its read and its write.
type VarSlotOp = VsGet | VsSet

#[doc("`e` with every `name.get()` and `name.set(v)` lowered to a read and a write of the slot `slot_name`.")]
pub fn specialise_body(name: String, slot_name: String, e: Expr) : Expr {
  Expr { kind: specialise_kind(name, slot_name, e.kind, e.line, e.col),
         line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
}

fn specialise_kind(name: String, slot_name: String, k: ExprKind, line: Int, col: Int) : ExprKind {
  match k {
    # The only kind that needs special handling: a call site that
    # matches `name.get()` or `name.set(v)` gets lowered to
    # `array_get(slot, 0)` / `array_set(slot, 0, v)`. All other
    # kinds (and non-matching ECalls) recurse purely structurally.
    ECall(callee, args_) -> {
      let getset = match callee.kind {
        EField(base, fname) -> match base.kind {
          EName(n) ->
            if written_text(n) == name and fname == "get" { Some(VsGet) }
            else if written_text(n) == name and fname == "set" { Some(VsSet) }
            else { None }
          _ -> None
        }
        _ -> None
      }
      match getset {
        Some(op) -> {
          let slot_e = mk_name(slot_name, line, col)
          let zero = mk_expr(mk_int_synth(0), line, col)
          match op {
            VsGet -> ECall(builtin_mk(CbArrayGet, line, col), [slot_e, zero])
            # `name.set(v)`: emit `{ let _ = array_set(slot, 0, v); () }`
            # so the result type stays Unit (matches the canonical clause).
            VsSet -> {
              let v = match args_ {
                [a, ..._ignore] -> specialise_body(name, slot_name, a)
                [] -> mk_expr(EUnit, line, col)
              }
              let set_call = mk_expr(
                ECall(builtin_mk(CbArraySet, line, col), [slot_e, zero, v]),
                line, col)
              let let_pat = mk_pat(PWild, line, col)
              let let_stmt = SLet(let_pat, None, set_call)
              EBlock([let_stmt], Some(mk_expr(EUnit, line, col)))
            }
          }
        }
        None ->
          ECall(specialise_body(name, slot_name, callee),
                map(args_, (a) => specialise_body(name, slot_name, a)))
      }
    }
    _ -> dsg_map_expr_kind(k, (sub) => specialise_body(name, slot_name, sub))
  }
}

#[doc("`e` with each call on a nursery capability of `s` rewritten to the operation it performs.")]
pub fn rewrite_nursery_caps_expr(e: Expr, s: NCapStack, file: String,
                               bw: BrandWalk) : NurseryRwExpr {
  let r = rewrite_nursery_caps_kind(e.kind, s, file, bw, e.line, e.col)
  NurseryRwExpr { expr: Expr { kind: r.kind, line: e.line, col: e.col,
                                ty: e.ty, mode: e.mode,  site: e.site },
                   bw: r.bw }
}

# Rewrite an expression kind. The cap rewrite proper handles three
# cases: (1) a `nursery` call with a 1-arg trailing lambda (mints a
# brand and recurses with cap pushed), (2) a `EField(EName(n), op)`
# whose `n` matches an active cap and `op` is a Spawn primitive
# (rewrites to `Spawn.op` on the core effect), and (3) every other
# kind, which recurses structurally.
fn rewrite_nursery_caps_kind(k: ExprKind, s: NCapStack, file: String,
                               bw: BrandWalk, line: Int, col: Int) : NurseryRwKind {
  match k {
    ECall(callee, args_) -> {
      # Detect three shapes:
      #   (a) `nursery { n -> body }` — the cap-binding scope.
      #   (b) `n.<op>(args)` where `n` is an active cap binder —
      #       rewrite the callee + record the (line, col, brand) so
      #       the post-rewrite brand-mismatch check can attribute
      #       this call to its scope.
      #   (c) anything else — recurse structurally.
      match callee.kind {
        EName(callee_name) ->
          if written_text(callee_name) == "nursery" {
            rewrite_nursery_call(callee, args_, s, file, bw, line, col)
          } else {
            let cr = rewrite_nursery_caps_expr(callee, s, file, bw)
            let ar = rewrite_nursery_caps_exprs(args_, s, file, cr.bw, [])
            NurseryRwKind { kind: ECall(cr.expr, ar.exprs), bw: ar.bw }
          }
        EField(base, op_name) -> match base.kind {
          EName(name) -> {
            if is_nursery_cap_op(op_name) {
              match ncs_lookup(s, written_text(name)) {
                Some(bid) -> {
                  # Record this call site's brand attribution.
                  let bw1 = bw_record_call(bw, file, line, col, bid, op_name)
                  let ar = rewrite_nursery_caps_exprs(args_, s, file, bw1, [])
                  let new_callee = mk_expr(
                    EField(spawn_ref(base.line, base.col), op_name),
                    callee.line, callee.col)
                  NurseryRwKind { kind: ECall(new_callee, ar.exprs), bw: ar.bw }
                }
                None -> {
                  let cr = rewrite_nursery_caps_expr(callee, s, file, bw)
                  let ar = rewrite_nursery_caps_exprs(args_, s, file, cr.bw, [])
                  NurseryRwKind { kind: ECall(cr.expr, ar.exprs), bw: ar.bw }
                }
              }
            } else {
              let cr = rewrite_nursery_caps_expr(callee, s, file, bw)
              let ar = rewrite_nursery_caps_exprs(args_, s, file, cr.bw, [])
              NurseryRwKind { kind: ECall(cr.expr, ar.exprs), bw: ar.bw }
            }
          }
          _ -> {
            let cr = rewrite_nursery_caps_expr(callee, s, file, bw)
            let ar = rewrite_nursery_caps_exprs(args_, s, file, cr.bw, [])
            NurseryRwKind { kind: ECall(cr.expr, ar.exprs), bw: ar.bw }
          }
        }
        _ -> {
          let cr = rewrite_nursery_caps_expr(callee, s, file, bw)
          let ar = rewrite_nursery_caps_exprs(args_, s, file, cr.bw, [])
          NurseryRwKind { kind: ECall(cr.expr, ar.exprs), bw: ar.bw }
        }
      }
    }
    EField(base, op_name) -> {
      # Bare `n.op` (without call): rewrite to `Spawn.op` if `n` is
      # an active cap. The typer rejects bare effect ops at use
      # sites, so this branch is mostly defensive; we still rewrite
      # so the diagnostic surface is consistent.
      match base.kind {
        EName(name) -> {
          if is_nursery_cap_op(op_name) {
            match ncs_lookup(s, written_text(name)) {
              Some(_) ->
                NurseryRwKind {
                  kind: EField(spawn_ref(base.line, base.col), op_name),
                  bw: bw }
              None -> {
                let br = rewrite_nursery_caps_expr(base, s, file, bw)
                NurseryRwKind { kind: EField(br.expr, op_name), bw: br.bw }
              }
            }
          } else {
            let br = rewrite_nursery_caps_expr(base, s, file, bw)
            NurseryRwKind { kind: EField(br.expr, op_name), bw: br.bw }
          }
        }
        _ -> {
          let br = rewrite_nursery_caps_expr(base, s, file, bw)
          NurseryRwKind { kind: EField(br.expr, op_name), bw: br.bw }
        }
      }
    }
    ELambda(ps, body) -> {
      # Lambda params shadow outer caps with the same name.
      let pnames = map(ps, (p) => written_text(p.binder.name))
      let s1 = ncs_remove_all(s, pnames)
      let r = rewrite_nursery_caps_expr(body, s1, file, bw)
      NurseryRwKind { kind: ELambda(ps, r.expr), bw: r.bw }
    }
    EBlock(stmts, tail) -> {
      let sr = rewrite_nursery_caps_stmts(stmts, s, file, bw, [])
      let tr = rewrite_nursery_caps_opt(tail, sr.s, file, sr.bw)
      NurseryRwKind { kind: EBlock(sr.stmts, tr.expr), bw: tr.bw }
    }
    EMatch(scr, arms) -> {
      let sr = rewrite_nursery_caps_expr(scr, s, file, bw)
      let ar = rewrite_nursery_caps_arms(arms, s, file, sr.bw, [])
      NurseryRwKind { kind: EMatch(sr.expr, ar.arms), bw: ar.bw }
    }
    EHandle(body, eff, eff_tyargs, init_opt, alias_opt, clauses, ret_opt) -> {
      let br = rewrite_nursery_caps_expr(body, s, file, bw)
      let ir = rewrite_nursery_caps_opt(init_opt, s, file, br.bw)
      let cr = rewrite_nursery_caps_clauses(clauses, s, file, ir.bw, [])
      let rr = rewrite_nursery_caps_opt_return(ret_opt, s, file, cr.bw)
      NurseryRwKind { kind: EHandle(br.expr, eff, eff_tyargs,
                                      ir.expr, alias_opt, cr.clauses, rr.ret),
                       bw: rr.bw }
    }
    # All other composites: fold sub-expressions through dsg_map_expr_kind
    # by hand — but we need to thread `bw`. The simplest path is to
    # emulate dsg_map_expr_kind here for composites that may carry sub-
    # exprs. We handle them explicitly to keep the brand counter
    # threaded.
    EIf(c, t_, eo) -> {
      let cr = rewrite_nursery_caps_expr(c, s, file, bw)
      let tr = rewrite_nursery_caps_expr(t_, s, file, cr.bw)
      let er = rewrite_nursery_caps_opt(eo, s, file, tr.bw)
      NurseryRwKind { kind: EIf(cr.expr, tr.expr, er.expr), bw: er.bw }
    }
    EBinop(op, a, b) -> {
      let ar = rewrite_nursery_caps_expr(a, s, file, bw)
      let br = rewrite_nursery_caps_expr(b, s, file, ar.bw)
      NurseryRwKind { kind: EBinop(op, ar.expr, br.expr), bw: br.bw }
    }
    EUnop(op, x) -> {
      let r = rewrite_nursery_caps_expr(x, s, file, bw)
      NurseryRwKind { kind: EUnop(op, r.expr), bw: r.bw }
    }
    EIndex(a, b) -> {
      let ar = rewrite_nursery_caps_expr(a, s, file, bw)
      let br = rewrite_nursery_caps_expr(b, s, file, ar.bw)
      NurseryRwKind { kind: EIndex(ar.expr, br.expr), bw: br.bw }
    }
    EPipe(a, b) -> {
      let ar = rewrite_nursery_caps_expr(a, s, file, bw)
      let br = rewrite_nursery_caps_expr(b, s, file, ar.bw)
      NurseryRwKind { kind: EPipe(ar.expr, br.expr), bw: br.bw }
    }
    EMapPipe(a, b) -> {
      let ar = rewrite_nursery_caps_expr(a, s, file, bw)
      let br = rewrite_nursery_caps_expr(b, s, file, ar.bw)
      NurseryRwKind { kind: EMapPipe(ar.expr, br.expr), bw: br.bw }
    }
    EFlatMapPipe(a, b) -> {
      let ar = rewrite_nursery_caps_expr(a, s, file, bw)
      let br = rewrite_nursery_caps_expr(b, s, file, ar.bw)
      NurseryRwKind { kind: EFlatMapPipe(ar.expr, br.expr), bw: br.bw }
    }
    EFilterPipe(a, b) -> {
      let ar = rewrite_nursery_caps_expr(a, s, file, bw)
      let br = rewrite_nursery_caps_expr(b, s, file, ar.bw)
      NurseryRwKind { kind: EFilterPipe(ar.expr, br.expr), bw: br.bw }
    }
    ERecordLit(rh, fs) -> {
      let r = rewrite_nursery_caps_fields(fs, s, file, bw, [])
      NurseryRwKind { kind: ERecordLit(rh, r.fields), bw: r.bw }
    }
    EList(els) -> {
      let r = rewrite_nursery_caps_elems(els, s, file, bw, [])
      NurseryRwKind { kind: EList(r.elems), bw: r.bw }
    }
    ERange(a, b, opt_step) -> {
      let ar = rewrite_nursery_caps_expr(a, s, file, bw)
      let br = rewrite_nursery_caps_expr(b, s, file, ar.bw)
      let stepr = rewrite_nursery_caps_opt(opt_step, s, file, br.bw)
      NurseryRwKind { kind: ERange(ar.expr, br.expr, stepr.expr), bw: stepr.bw }
    }
    ELitUnit(inner, u) -> {
      let r = rewrite_nursery_caps_expr(inner, s, file, bw)
      NurseryRwKind { kind: ELitUnit(r.expr, u), bw: r.bw }
    }
    EBang(inner) -> {
      let r = rewrite_nursery_caps_expr(inner, s, file, bw)
      NurseryRwKind { kind: EBang(r.expr), bw: r.bw }
    }
    # Leaves and forms with no sub-Exprs.
    _ -> NurseryRwKind { kind: k, bw: bw }
  }
}

fn rewrite_nursery_caps_exprs(es: [Expr], s: NCapStack, file: String,
                                bw: BrandWalk, acc: [Expr]) : NurseryRwExprs {
  match es {
    [] -> NurseryRwExprs { exprs: list_reverse(acc), bw: bw }
    [h, ...rest] -> {
      let r = rewrite_nursery_caps_expr(h, s, file, bw)
      rewrite_nursery_caps_exprs(rest, s, file, r.bw, [r.expr, ...acc])
    }
  }
}

fn rewrite_nursery_caps_opt(opt: Option[Expr], s: NCapStack, file: String,
                              bw: BrandWalk) : NurseryRwOpt {
  match opt {
    None -> NurseryRwOpt { expr: None, bw: bw }
    Some(e) -> {
      let r = rewrite_nursery_caps_expr(e, s, file, bw)
      NurseryRwOpt { expr: Some(r.expr), bw: r.bw }
    }
  }
}

# Statement-list walk. Tracks SLet / SVar bindings to drop them from
# the cap stack so a re-bind of `n` inside the body shadows.
fn rewrite_nursery_caps_stmts(ss: [Stmt], s: NCapStack, file: String,
                                bw: BrandWalk, acc: [Stmt]) : NurseryRwStmts {
  match ss {
    [] -> NurseryRwStmts { stmts: list_reverse(acc), s: s, bw: bw }
    [stmt, ...rest] -> match stmt {
      SLet(pat, ann, rhs) -> {
        let r = rewrite_nursery_caps_expr(rhs, s, file, bw)
        let s1 = ncs_remove_all(s, dsg_pat_bindings(pat, []))
        rewrite_nursery_caps_stmts(rest, s1, file, r.bw, [SLet(pat, ann, r.expr), ...acc])
      }
      SVar(n, ty, rhs, l, c) -> {
        let r = rewrite_nursery_caps_expr(rhs, s, file, bw)
        let s1 = ncs_remove(s, written_text(n.name))
        rewrite_nursery_caps_stmts(rest, s1, file, r.bw, [SVar(n, ty, r.expr, l, c), ...acc])
      }
      SAssert(c, m) -> {
        let cr = rewrite_nursery_caps_expr(c, s, file, bw)
        let mr = rewrite_nursery_caps_opt(m, s, file, cr.bw)
        rewrite_nursery_caps_stmts(rest, s, file, mr.bw, [SAssert(cr.expr, mr.expr), ...acc])
      }
      SExprStmt(x) -> {
        let r = rewrite_nursery_caps_expr(x, s, file, bw)
        rewrite_nursery_caps_stmts(rest, s, file, r.bw, [SExprStmt(r.expr), ...acc])
      }
      SIndexAssign(b, i, v, l, c) -> {
        let br = rewrite_nursery_caps_expr(b, s, file, bw)
        let ir = rewrite_nursery_caps_expr(i, s, file, br.bw)
        let vr = rewrite_nursery_caps_expr(v, s, file, ir.bw)
        rewrite_nursery_caps_stmts(rest, s, file, vr.bw,
          [SIndexAssign(br.expr, ir.expr, vr.expr, l, c), ...acc])
      }
      SAssign(b, v, l, c) -> {
        let br = rewrite_nursery_caps_expr(b, s, file, bw)
        let vr = rewrite_nursery_caps_expr(v, s, file, br.bw)
        rewrite_nursery_caps_stmts(rest, s, file, vr.bw,
          [SAssign(br.expr, vr.expr, l, c), ...acc])
      }
      SUse(n, l, c) ->
        rewrite_nursery_caps_stmts(rest, s, file, bw, [SUse(n, l, c), ...acc])
    }
  }
}

fn rewrite_nursery_caps_arms(arms: [Arm], s: NCapStack, file: String,
                               bw: BrandWalk, acc: [Arm]) : NurseryRwArms {
  match arms {
    [] -> NurseryRwArms { arms: list_reverse(acc), bw: bw }
    [a, ...rest] -> match a {
      Arm(p, g, b) -> {
        let s1 = ncs_remove_all(s, dsg_pat_bindings(p, []))
        let gr = rewrite_nursery_caps_opt(g, s1, file, bw)
        let br = rewrite_nursery_caps_expr(b, s1, file, gr.bw)
        rewrite_nursery_caps_arms(rest, s, file, br.bw, [Arm(p, gr.expr, br.expr), ...acc])
      }
    }
  }
}

fn rewrite_nursery_caps_clauses(cs: [HClause], s: NCapStack, file: String,
                                  bw: BrandWalk, acc: [HClause]) : NurseryRwClauses {
  match cs {
    [] -> NurseryRwClauses { clauses: list_reverse(acc), bw: bw }
    [c, ...rest] -> match c {
      HC(n, ps, b, l, co) -> {
        let pnames = map(ps, (pm) => written_text(pm.binder.name))
        let s1 = ncs_remove_all(s, pnames)
        let r = rewrite_nursery_caps_expr(b, s1, file, bw)
        rewrite_nursery_caps_clauses(rest, s, file, r.bw, [HC(n, ps, r.expr, l, co), ...acc])
      }
    }
  }
}

fn rewrite_nursery_caps_opt_return(opt: Option[HReturn], s: NCapStack,
                                     file: String, bw: BrandWalk) : NurseryRwRet {
  match opt {
    None -> NurseryRwRet { ret: None, bw: bw }
    Some(r) -> match r {
      HR(p, b, l, c) -> {
        let s1 = ncs_remove(s, written_text(p.name))
        let br = rewrite_nursery_caps_expr(b, s1, file, bw)
        NurseryRwRet { ret: Some(HR(p, br.expr, l, c)), bw: br.bw }
      }
    }
  }
}

fn rewrite_nursery_caps_fields(fs: [FieldInit], s: NCapStack, file: String,
                                 bw: BrandWalk, acc: [FieldInit]) : NurseryRwFields {
  match fs {
    [] -> NurseryRwFields { fields: list_reverse(acc), bw: bw }
    [f, ...rest] -> match f {
      FI(n, v) -> {
        let r = rewrite_nursery_caps_expr(v, s, file, bw)
        rewrite_nursery_caps_fields(rest, s, file, r.bw, [FI(n, r.expr), ...acc])
      }
    }
  }
}

fn rewrite_nursery_caps_elems(els: [ListElem], s: NCapStack, file: String,
                                bw: BrandWalk, acc: [ListElem]) : NurseryRwElems {
  match els {
    [] -> NurseryRwElems { elems: list_reverse(acc), bw: bw }
    [el, ...rest] -> match el {
      ElPlain(x) -> {
        let r = rewrite_nursery_caps_expr(x, s, file, bw)
        rewrite_nursery_caps_elems(rest, s, file, r.bw, [ElPlain(r.expr), ...acc])
      }
      ElSpread(x) -> {
        let r = rewrite_nursery_caps_expr(x, s, file, bw)
        rewrite_nursery_caps_elems(rest, s, file, r.bw, [ElSpread(r.expr), ...acc])
      }
    }
  }
}

# `nursery { n -> body }` → mint a brand, push `(n, brand)`, walk
# body, strip `n` from the lambda. The trailing-lambda parser
# always leaves the lambda as the LAST argument (per
# parse_trailing_lambdas), and `nursery` takes only the body, so
# args is typically `[lam]` — we still loop over args so a future
# multi-arg `nursery(extra) { n -> body }` form would not silently
# misbehave.
fn rewrite_nursery_call(callee: Expr, args_: [Expr], s: NCapStack,
                          file: String, bw: BrandWalk,
                          line: Int, col: Int) : NurseryRwKind {
  let lr = split_last_arg(args_)
  match lr {
    NoLast -> {
      let ar = rewrite_nursery_caps_exprs(args_, s, file, bw, [])
      NurseryRwKind { kind: ECall(callee, ar.exprs), bw: ar.bw }
    }
    HasLast(prefix, last) -> match last.kind {
      ELambda(ps, body) -> match ps {
        [p0] -> {
          let p_name = written_text(p0.binder.name)
          let alloc = bw_alloc(bw, p_name, file, last.line, last.col)
          let s1 = ncs_push(s, p_name, alloc.bid)
          let pr = rewrite_nursery_caps_exprs(prefix, s, file, alloc.bw, [])
          let br = rewrite_nursery_caps_expr(body, s1, file, pr.bw)
          let stripped_lam = mk_expr(ELambda([], br.expr), last.line, last.col)
          let new_args = list_append(pr.exprs, [stripped_lam])
          NurseryRwKind { kind: ECall(callee, new_args), bw: br.bw }
        }
        _ -> {
          let pr = rewrite_nursery_caps_exprs(prefix, s, file, bw, [])
          let lr2 = rewrite_nursery_caps_expr(last, s, file, pr.bw)
          NurseryRwKind { kind: ECall(callee, list_append(pr.exprs, [lr2.expr])),
                           bw: lr2.bw }
        }
      }
      _ -> {
        let pr = rewrite_nursery_caps_exprs(prefix, s, file, bw, [])
        let lr2 = rewrite_nursery_caps_expr(last, s, file, pr.bw)
        NurseryRwKind { kind: ECall(callee, list_append(pr.exprs, [lr2.expr])),
                         bw: lr2.bw }
      }
    }
  }
}

# Diagnostic emitter. The two sides of the mismatch carry
# `(brand_id, allocation_site)` so the user can see which two
# nurseries produced the conflicting brands.
fn emit_brand_mismatch(file: String, line: Int, col: Int,
                         expected_bid: Int, found_bid: Int,
                         brs: [BrandRec], op_name: String) : Unit / Console + File {


  diag_error(file, line, col,
    concat_all(["sibling-nursery brand mismatch on `", op_name,
                "`: fiber from a different nursery scope"]))
  match brand_rec_lookup(brs, expected_bid) {
    Some(b) -> match b {
      BR(_, name, bf, bl, bc) ->
        diag_note(concat_all(["expected brand from nursery `",
                               name, "` at ", bf, ":",
                               int_to_string(bl), ":",
                               int_to_string(bc)]))
    }
    None -> ()
  }
  match brand_rec_lookup(brs, found_bid) {
    Some(b) -> match b {
      BR(_, name, bf, bl, bc) ->
        diag_note(concat_all(["fiber argument carries brand from nursery `",
                               name, "` at ", bf, ":",
                               int_to_string(bl), ":",
                               int_to_string(bc)]))
    }
    None -> ()
  }
  diag_help("each `n.spawn(...)` returns a Fiber bound to that nursery; pass it only to the same nursery's await/select/cancel — or restructure so the consume site shares the spawn site's `n` cap")
}

#[doc("""
Consume-op brand check. For await/cancel/select the first arg
carries the fiber(s); for the other ops there is nothing to
check (spawn produces a brand, set_trap_exit/yield/cancel_all
don't take a fiber).
""")]
pub fn check_brand_consume(op_name: String, args_: [Expr], expected_bid: Int,
                        env: BrandEnv, file: String, calls: [BrandCall],
                        brs: [BrandRec], errs: Int) : Int / Console + File {

  if op_name == "await" or op_name == "cancel" {
    match args_ {
      [arg, ..._other_args] -> match expr_brand(arg, env, calls) {
        Some(found) ->
          if found == expected_bid { errs }
          else {
            emit_brand_mismatch(file, arg.line, arg.col,
                                  expected_bid, found, brs, op_name)
            errs + 1
          }
        None -> errs
      }
      _ -> errs
    }
  } else if op_name == "select" {
    match args_ {
      [arg, ..._other_args] -> match arg.kind {
        EList(els) -> check_brand_select_elems(els, expected_bid, env, file, calls, brs, errs)
        _ -> match expr_brand(arg, env, calls) {
          Some(found) ->
            if found == expected_bid { errs }
            else {
              emit_brand_mismatch(file, arg.line, arg.col,
                                    expected_bid, found, brs, op_name)
              errs + 1
            }
          None -> errs
        }
      }
      _ -> errs
    }
  } else { errs }
}

fn check_brand_select_elems(els: [ListElem], expected_bid: Int,
                              env: BrandEnv, file: String,
                              calls: [BrandCall], brs: [BrandRec],
                              errs: Int) : Int / Console + File {

  match els {
    [] -> errs
    [el, ...rest] -> {
      let e1 = match el {
        ElPlain(x) -> match expr_brand(x, env, calls) {
          Some(found) ->
            if found == expected_bid { errs }
            else {
              emit_brand_mismatch(file, x.line, x.col,
                                    expected_bid, found, brs, "select")
              errs + 1
            }
          None -> errs
        }
        ElSpread(_) -> errs
      }
      check_brand_select_elems(rest, expected_bid, env, file, calls, brs, e1)
    }
  }
}
