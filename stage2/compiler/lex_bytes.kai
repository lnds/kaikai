#[doc("""
Byte classes and scans over the raw source: where whitespace, a comment,
an identifier or a run of digits ends.
""")]



# Source is read as byte Ints, -1 past the end: an `Option[Char]` per
# read, or a `Lexer` per byte stepped over, would allocate on every byte.
# Scanners walk positions and the cursor moves once per token.
const B_TAB : Int = 9
#[doc("The byte of a newline.")]
pub const B_NL : Int = 10
const B_CR : Int = 13
const B_SPACE : Int = 32
#[doc("The byte of a double quote.")]
pub const B_DQUOTE : Int = 34
#[doc("The byte of a `#`.")]
pub const B_HASH : Int = 35
#[doc("The byte of a single quote.")]
pub const B_SQUOTE : Int = 39
#[doc("The byte of a `/`.")]
pub const B_SLASH : Int = 47
#[doc("The byte of a `[`.")]
pub const B_LBRACKET : Int = 91
#[doc("The byte of a backslash.")]
pub const B_BACKSLASH : Int = 92
#[doc("The byte of a `]`.")]
pub const B_RBRACKET : Int = 93
#[doc("The byte of a `_`.")]
pub const B_UNDERSCORE : Int = 95
#[doc("The byte of a `{`.")]
pub const B_LBRACE : Int = 123
#[doc("The byte of a `}`.")]
pub const B_RBRACE : Int = 125

#[doc("The byte of `src` at `i`, negative past the end.")]
pub fn byte_at(src: String, i: Int) : Int = string_byte_at_int(src, i)

#[doc("True for an ASCII digit.")]
pub fn b_is_digit(b: Int) : Bool = b >= 48 and b <= 57

#[doc("True for an ASCII letter or `_`.")]
pub fn b_is_alpha(b: Int) : Bool = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or b == B_UNDERSCORE

#[doc("True for an ASCII letter, digit or `_`.")]
pub fn b_is_alnum(b: Int) : Bool = b_is_alpha(b) or b_is_digit(b)

fn b_is_space(b: Int) : Bool = b == B_SPACE or b == B_TAB or b == B_CR

fn b_is_hex_digit(b: Int) : Bool = b_is_digit(b) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)

#[doc("`s` spelled at `i`, byte for byte.")]
pub fn src_has_at(src: String, i: Int, s: String, k: Int) : Bool =
  k >= string_length(s) or (byte_at(src, i + k) == byte_at(s, k) and src_has_at(src, i, s, k + 1))

#[doc("`s` at `i` and not continued by an identifier byte (`#derive(` but not `#deriveable`).")]
pub fn word_at(src: String, i: Int, s: String) : Bool =
  src_has_at(src, i, s, 0) and not b_is_alnum(byte_at(src, i + string_length(s)))

#[doc("""
Spaces and `#` line comments; the newline itself is a token. `#[` opens
an attribute, and a bare `#derive`/`#unstable` stays for `lex_punct` to
report as legacy syntax.
""")]
pub fn ws_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b_is_space(b) { ws_end(src, i + 1) }
  else if b != B_HASH { i }
  else if byte_at(src, i + 1) == B_LBRACKET or word_at(src, i + 1, "derive") or word_at(src, i + 1, "unstable") { i }
  else { ws_end(src, comment_end(src, i + 1)) }
}

fn comment_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b < 0 or b == B_NL { i } else { comment_end(src, i + 1) }
}

#[doc("The index after the identifier bytes starting at `i`.")]
pub fn ident_end(src: String, i: Int) : Int =
  if b_is_alnum(byte_at(src, i)) { ident_end(src, i + 1) } else { i }

#[doc("The index after the decimal digits and `_` starting at `i`.")]
pub fn digits_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b_is_digit(b) or b == B_UNDERSCORE { digits_end(src, i + 1) } else { i }
}

#[doc("The index after the hexadecimal digits and `_` starting at `i`.")]
pub fn hex_digits_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b_is_hex_digit(b) or b == B_UNDERSCORE { hex_digits_end(src, i + 1) } else { i }
}

#[doc("The index after the binary digits and `_` starting at `i`.")]
pub fn bin_digits_end(src: String, i: Int) : Int {
  let b = byte_at(src, i)
  if b == 48 or b == 49 or b == B_UNDERSCORE { bin_digits_end(src, i + 1) } else { i }
}

#[doc("True when the half-open span holds at least one non-`_` byte.")]
pub fn lex_span_has_digit(src: String, i: Int, end: Int) : Bool =
  i < end and (byte_at(src, i) != B_UNDERSCORE or lex_span_has_digit(src, i + 1, end))
