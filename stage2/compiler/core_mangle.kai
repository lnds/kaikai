#[doc("""
The private sum types of each core module, so one core declaration can be
settled against them without the segment around it.
""")]

import compiler.ast
import compiler.symtab
import compiler.modules_homes
import compiler.emit_c
import compiler.modules_segments

#[doc("The private sum types of the core modules that have any, with the table that names them.")]
pub type MangleSegs = MangleSegs(SymTab, [MangleSeg])

#[doc("A core module and its private sum types.")]
pub type MangleSeg = MangleSeg(String, [SymId])

#[doc("The private sum types of every segment of `core_decls`, which holds the core declarations segment by segment as `segs` gives their lengths.")]
pub fn mangle_core_plan(core_decls: [Decl], tab: SymTab, segs: [CoreSegment]) : MangleSegs =
  MangleSegs(tab, plan_loop(core_decls, segs, []))

fn plan_loop(core_decls: [Decl], segs: [CoreSegment], acc: [MangleSeg]) : [MangleSeg] = match segs {
  [] -> acc
  [PSeg(mod_name, seg_template), ...rest] -> {
    let n_seg = list_length(seg_template)
    let seg_types = collect_private_segment_types(pae_take(core_decls, n_seg), [])
    plan_loop(pae_drop(core_decls, n_seg), rest,
              if seg_types == [] { acc } else { [MangleSeg(mod_name, seg_types), ...acc] })
  }
}

#[doc("`d`, a declaration of the core module `mod_name`, with its references to that module's private sum types settled.")]
pub fn mangle_core_decl(plan: MangleSegs, d: Decl, mod_name: String) : Decl = match plan {
  MangleSegs(tab, segs) -> match find_seg(segs, mod_name) {
    Some(types) -> mangle_one_decl(d, PrivTys { tab: tab, types: types }, mod_name)
    None        -> d
  }
}

fn find_seg(segs: [MangleSeg], mod_name: String) : Option[[SymId]] = match segs {
  [] -> None
  [MangleSeg(m, ts), ...rest] -> if m == mod_name { Some(ts) } else { find_seg(rest, mod_name) }
}
