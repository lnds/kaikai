#[doc("Typer-internal helper `build_uvar_canon_map` shared across the infer modules.")]
pub fn build_uvar_canon_map(bound: [Int], sub: Subst, acc: [IntPair]) : [IntPair] {
  match bound {
    [] -> list_reverse(acc)
    [b, ...rest] -> {
      let resolved = apply_unit(sub, UVar(b))
      let acc1 = match resolved {
        UVar(f) -> if f != b { [IPair(f, b), ...acc] } else { acc }
        _ -> acc
      }
      build_uvar_canon_map(rest, sub, acc1)
    }
  }
}


#[doc("Typer-internal helper `build_tvar_canon_map` shared across the infer modules.")]
pub fn build_tvar_canon_map(bound: [Int], sub: Subst, acc: [IntPair]) : [IntPair] {
  match bound {
    [] -> list_reverse(acc)
    [b, ...rest] -> {
      let resolved = apply_ty(sub, TyVarT(b))
      let acc1 = match resolved {
        TyVarT(f) -> if f != b { [IPair(f, b), ...acc] } else { acc }
        _ -> acc
      }
      build_tvar_canon_map(rest, sub, acc1)
    }
  }
}


# Remove every id in `drop` from `xs` (order-preserving).
fn remove_ints(xs: [Int], drop: [Int]) : [Int] = match xs {
  [] -> []
  [x, ...rest] ->
    if list_has_int(drop, x) { remove_ints(rest, drop) }
    else { [x, ...remove_ints(rest, drop)] }
}


# The head `TyCon`'s slot for declared-tparam id `i`: a row carrier
# when `i` is a row-kind tparam, an ordinary type-var slot otherwise.
fn head_slot_for(i: Int, rvar_ids: [Int]) : Ty =
  if list_has_int(rvar_ids, i) { row_arg_carrier(row_with_tail(i)) } else { tv(i) }


# The constructed type and its fields are stamped from `hv`, the same
# view the annotation side uses: a stamped head only meets an unstamped
# one by the permissive rule, so both sides have to share it.
fn scheme_of_variant(tsym: SymId, tparams: [TBinder], v: Variant,
                     hv: TyHomeView) : TyScheme {
  match v {
    Var(_ctor, vargs, _, _) -> {
      # A tparam that appears in *row* position inside a ctor field
      # (e.g. `Stream[t, e] = Stream(((t) -> Bool / e) -> Unit / e)`)
      # must be resolved as a row variable, not a type variable —
      # otherwise the field's effect row is dropped and any effectful
      # producer fails to unify (the bug behind the nominal Stream
      # carrier). We split the declared tparams: those used in row
      # position become `rbinds` (resolved via `resolve_ty_with_binds`,
      # which preserves `TyFn` rows); the rest stay type-level `binds`.
      let rvar_names = cont_row_names_all(vargs, collect_rvars_in_typeexprs(vargs, []))
      let tvar_names = names_excluding(tbs_ids(tparams), rvar_names)
      let binds = mk_tpbinds(tparams)
      # The row-var binds REUSE the ids `mk_tpbinds` already assigned to
      # each name (rather than re-numbering from zero with `mk_rvbinds`):
      # if `e` is the second tparam it has tpbind id 1, and the rbind for
      # `e` must carry that same 1. Otherwise a stray `e` in *type*
      # position would resolve via `binds` to `tv(1)` — an id that is in
      # neither `vars` nor `rvars`, leaving an ungeneralised free type-var
      # in the scheme. Type-var ids (for `tvar_names`) and row-var ids
      # (for `rvar_names`) are disjoint by construction, so the
      # type-pool / row-pool substitutions never collide.
      let rbinds = map(rvar_names, (n) => RVB(n, tpbind_id_of(binds, n)))
      let arg_tys = map(vargs, (a) => resolve_ty_with_binds(a, binds, rbinds, [], hv))
      # The result `TyCon` carries one type-arg slot per declared tparam,
      # in declaration order, so use-site unification lines up positionally.
      # A row-kind tparam's slot carries its effect row as a degenerate
      # `TyFnT([], TyUnit, row)` keyed on the SAME row-var id the ctor
      # field's `/ e` uses, so unifying the head slot threads the row (the
      # bug behind the nominal Stream carrier was that the slot was a `tv`
      # disjoint from that row id — the effect leaked uncheck).
      let ids = tparam_ids(tparams)
      let tvar_ids = map(tvar_names, (n) => tpbind_id_of(binds, n))
      let rvar_ids = map(rvar_names, (n) => tpbind_id_of(binds, n))
      let result = TyCon(tsym, map(ids, (i) => head_slot_for(i, rvar_ids)))
      match vargs {
        [] -> scheme(ids, result)
        _  -> scheme_full(tvar_ids, rvar_ids, fn_ty(arg_tys, result))
      }
    }
  }
}


fn add_variants_of_decl(env: TyEnv, d: Decl, homes: TyHomes) : TyEnv {
  match d {
    DType(_, tsym, tparams, body, _, _, _, _, mo, _) -> match body {
      TBSum(vs) -> add_variants_loop(env, tsym, tparams, vs, homes, tsh_view(homes, mo))
      _ -> env
    }
    _ -> env
  }
}


# A nullary variant spelled like a type its own module declares refers
# to that type and registers no constructor: the declaration is the
# handle, and a second one returning the sum would compete with that
# type's own constructor of the name. The component is still listed in
# `env.unions`, and `component_tag` reads the variant as a value where no
# constructor answers. A variant with a payload always builds, and so
# does one named like the sum that declares it.
fn add_variants_loop(env: TyEnv, tsym: SymId, tparams: [TBinder],
                       vs: [Variant], homes: TyHomes, hv: TyHomeView) : TyEnv {
  match vs {
    [] -> env
    [v, ...rest] -> match v {
      Var(csym, vargs, _, _) -> {
        let shadows = match vargs {
          [] -> tsh_variant_has_type(homes, csym) and not sym_same(tsh_variant_sym(hv, csym), tsym)
          _  -> false
        }
        if shadows {
          add_variants_loop(env, tsym, tparams, rest, homes, hv)
        } else {
          add_variants_loop(env_bind_ctor(env, csym, scheme_of_variant(tsym, tparams, v, hv)),
                            tsym, tparams, rest, homes, hv)
        }
      }
    }
  }
}


# Collect names a fn signature places in a row-kind slot of a nominal
# type (`e` in `from_list(...) : Stream[t, e]`), consulting the
# per-type row-kind table. These join `collect_decl_rvars` so the row
# var is bound + generalised even when it never appears after a `/`.
#[doc("Typer-internal helper `collect_rowkind_args_decl` shared across the infer modules.")]
pub fn collect_rowkind_args_decl(d: Decl, table: [RowKindEntry], hv: TyHomeView) : [TLocalId] = match d {
  DFn(_, _, _, params, opt_ret, _, _, _, _, _, _, _) -> {
    let a0 = collect_rowkind_args_params(params, table, [], hv)
    match opt_ret {
      Some(rty) -> collect_rowkind_args_te(rty, table, a0, hv)
      None      -> a0
    }
  }
  _ -> []
}


fn collect_rowkind_args_params(ps: [Param], table: [RowKindEntry], acc: [TLocalId], hv: TyHomeView) : [TLocalId] = match ps {
  [] -> acc
  [p, ...rest] -> {
    let a1 = match p.ptype {
      Some(te) -> collect_rowkind_args_te(te, table, acc, hv)
      None     -> acc
    }
    collect_rowkind_args_params(rest, table, a1, hv)
  }
}


fn collect_rowkind_args_te(t: TypeExpr, table: [RowKindEntry], acc: [TLocalId], hv: TyHomeView) : [TLocalId] = match t.tkind {
  TyName(r, tas) -> {
    let here = collect_rowkind_args_at(tas, row_kind_slots_of(table, r, hv), 0, acc)
    collect_rowkind_args_tes(tas, table, here, hv)
  }
  TyParam(_, tas) -> collect_rowkind_args_tes(tas, table, acc, hv)
  TyList(inner) -> collect_rowkind_args_te(inner, table, acc, hv)
  TyFn(ps, ret, _) -> collect_rowkind_args_te(ret, table, collect_rowkind_args_tes(ps, table, acc, hv), hv)
  TyDim(base, _) -> collect_rowkind_args_te(base, table, acc, hv)
  TyRefine(base, _, _) -> collect_rowkind_args_te(base, table, acc, hv)
  TyRow(_) -> acc
  TySurface(ts) -> collect_rowkind_args_tes(tysurface_children(ts), table, acc, hv)
}


fn collect_rowkind_args_tes(ts: [TypeExpr], table: [RowKindEntry], acc: [TLocalId], hv: TyHomeView) : [TLocalId] = match ts {
  [] -> acc
  [t, ...rest] -> collect_rowkind_args_tes(rest, table, collect_rowkind_args_te(t, table, acc, hv), hv)
}


# For each slot index in `idxs`, collect the slot's argument when it is
# a type parameter: a row *variable*. A row-kind slot also accepts a
# concrete effect (`Box[Log]`), which must NOT be bound here: binding it
# would generalise the scheme over it, and every call site would
# instantiate a fresh free row that unifies with any other row —
# `Box[Beep]` would pass where `Box[Log]` is expected.
fn collect_rowkind_args_at(tas: [TypeExpr], idxs: [Int], i: Int,
                           acc: [TLocalId]) : [TLocalId] = match tas {
  [] -> acc
  [a, ...rest] -> {
    let a1 = if list_has_int(idxs, i) {
      match a.tkind {
        TyParam(n, []) -> tids_add(acc, n)
        _ -> acc
      }
    } else { acc }
    collect_rowkind_args_at(rest, idxs, i + 1, a1)
  }
}


fn param_ty_with_binds(pm: Param, tpbinds: [TPBind], rbinds: [RVBind],
                       rk: [RowKindEntry], hv: TyHomeView) : Ty {
  match pm.ptype {
    Some(te) -> resolve_ty_with_binds(te, tpbinds, rbinds, rk, hv)
    None     -> TyAny
  }
}


#[doc("""
infer: project a function declaration to its quantified type scheme.

The row-kind table binds a row var sourced only in a `T[..., e]`
position (`from_list(...) : Stream[t, e]`) as a row var; `homes`
stamps each nominal type in the signature with its declaring module
and identity.
""")]
pub fn fn_scheme_of_decl(d: Decl, row_kind_table: [RowKindEntry],
                         homes: TyHomes) : Option[TyScheme] {
  match d {
    DFn(_, fid, tparams, params, opt_ret, rexpr, _, _, _, _, _, dmo) -> {
      let hv = tsh_view(homes, dmo)
      let phantom = elaborate_phantom_row(rexpr, decl_types_as_entry(homes, fid))
      # collect row-variable names per decl, allocate small
      # bound ids (0, 1, ...) in order of appearance, build the body
      # type with those ids in tail positions. The scheme generalises
      # over them so each call site fresh-instantiates.
      # same idea for declared type parameters (`fn id[T]...`).
      # tparam ids are 0..len(tparams)-1; row-var ids live in their
      # own dimension, so the two namespaces don't collide.
      # also auto-collect lowercase TyName
      # identifiers that appear in the signature but were not
      # declared in `[T1, T2]`. Treat them as *implicit* tparams.
      # Without this, `pub fn list_contains(xs: [a], x: a) : Bool`
      # ends up with `a` as a nominal `TyCon` and the
      # call site fails to unify with `[Int], Int`. The implicit
      # set is appended to the declared one so explicit `[a]` still
      # wins on collisions; their ids form a contiguous block.
      let rk_names = collect_rowkind_args_decl(d, row_kind_table, hv)
      let names = list_append(collect_decl_rvars(d), rk_names)
      let rbinds = mk_rvbinds(names)
      let effective_tparams = tbs_positional(tparams)
      let tpbinds = mk_tpbinds(effective_tparams)
      let pts = map(params, (p) => param_ty_with_binds(p, tpbinds, rbinds, row_kind_table, hv))
      let ret = match opt_ret {
        Some(rty) -> resolve_ty_with_binds(rty, tpbinds, rbinds, row_kind_table, hv)
        None      -> TyUnit
      }
      # elaboration for pure named callbacks. When a fn
      # decl omits the row clause (`fn foo(...) : T` without `/`), the
      # scheme gains a fresh phantom row variable in the outermost
      # TyFnT tail. Effect: each call site instantiates the row to a
      # fresh free variable instead of empty-closed, so passing a pure
      # named callback to a slot expecting `(args) -> ret / e` no
      # longer pins `e := ε`. `check_body_row` (line ~36939) still
      # enforces empty-closed for the *body*, so soundness is
      # preserved: pure → effectful lifts, effectful → pure stays
      # rejected. The asymmetry holds because RClosed/ROpen signatures
      # carry their declared row verbatim — only REmpty triggers
      # elaboration. Excludes `main` (which absorbs builtin effects
      # under its REmpty branch in check_body_row).
      let phantom_id = list_length(rbinds)
      let row = if phantom {
        Row { labels: [], tail: Some(phantom_id), display_alias: None }
      } else {
        row_of_expr_with_binds(rexpr, tpbinds, rbinds, hv)
      }
      let body = TyFnT(pts, ret, row)
      # split tparam IDs by kind so unit-vars live in their own
      # pool and get fresh-instantiated by st_instantiate_report. A
      # row-kind tparam (sourced in a `T[..., e]` slot) is generalised
      # as a row var, not a type var, so drop its type-var id from the
      # split — its `tv(id)` never appears in the body (the slot is a
      # carrier), and leaving it would generalise a dead type var.
      let split = tparam_id_split(effective_tparams)
      let rk_tvar_ids = tparam_type_ids_of(effective_tparams, rk_names)
      let tvars = remove_ints(split.tvars, rk_tvar_ids)
      let rvars = if phantom {
        list_append(rvbind_ids(rbinds), [phantom_id])
      } else {
        rvbind_ids(rbinds)
      }
      Some(scheme_uvars(tvars, rvars, split.uvars,
                        tparam_unit_kinds(effective_tparams), body))
    }
    _ -> None
  }
}


# The type-home table stamps each signature's nominal types with their
# declaring module as the scheme is built, not after the typer unified.
fn add_decls_loop(env: TyEnv, ar_acc: [OpEffArity], ds: [Decl],
                    rk_table: [RowKindEntry],
                    homes: TyHomes) : EnvWithArities {
  match ds {
    [] -> EnvWithArities { env: env, arities: ar_acc }
    [d, ...rest] -> {
      let r = match d {
        # Each declaration registers under its own id: a homonym in
        # another module is another entry, and no spelling is consulted.
        DFn(_, fid, _, _, _, _, _, _, _, _, _, _) -> match fn_scheme_of_decl(d, rk_table, homes) {
          Some(sc) -> EnvWithArities { env: env_bind_sym(env, fnid_sym(fid), sc), arities: ar_acc }
          None     -> EnvWithArities { env: env, arities: ar_acc }
        }
        DType(_, _, _, _, _, _, _, _, _, _) ->
          EnvWithArities { env: add_variants_of_decl(env, d, homes), arities: ar_acc }
        DEffect(_, esym, tparams, ops, _, _, _, _, _, emo) -> {
          let r2 = add_effect_op_sigs(env, tparams, ops, esym, tsh_view(homes, emo))
          # merge per-effect arities into the running accumulator.
          EnvWithArities { env: r2.env, arities: append_op_arities(r2.arities, ar_acc) }
        }
        # A const binds to its declared type T monomorphically — `T`,
        # NOT `() -> T`. So a reference reads as a value of type T (no
        # call, no instantiation).
        DConst(_, csym, cte, _, mo, _, _, _, _) -> {
          let csc = mono(resolve_ty_with_binds(cte, [], [], [], tsh_view(homes, mo)))
          EnvWithArities { env: env_bind_sym(env, csym, csc), arities: ar_acc }
        }
        # `#[constructor]` wrapper: register the inner `pub fn` exactly
        # as a bare `DFn` would be, then record its `type -> fn`
        # binding so `try_constructor_call` can desugar `Type(args)`.
        DProtoLaws(_, inner, cl, cc, _) -> {
          let r = add_decls_loop(env, ar_acc, [inner], rk_table, homes)
          EnvWithArities { env: register_constructor(r.env, inner, cl, cc), arities: r.arities }
        }
        DImplAxiom(_, inner, cl, cc, _) -> {
          let r = add_decls_loop(env, ar_acc, [inner], rk_table, homes)
          EnvWithArities { env: register_constructor(r.env, inner, cl, cc), arities: r.arities }
        }
        DConstructor(inner, cl, cc) -> {
          let r = add_decls_loop(env, ar_acc, [inner], rk_table, homes)
          EnvWithArities { env: register_constructor(r.env, inner, cl, cc), arities: r.arities }
        }
        _ -> EnvWithArities { env: env, arities: ar_acc }
      }
      add_decls_loop(r.env, r.arities, rest, rk_table, homes)
    }
  }
}


fn add_effect_op_sigs(env: TyEnv, tparams: [TBinder],
                       ops: [EffectOp], esym: SymId, hv: TyHomeView) : EnvWithArities {
  let binds = mk_tpbinds(tparams)
  let ids = tparam_ids(tparams)
  add_effect_op_sigs_loop(env, binds, ids, ops, [], esym, hv)
}


# register each op of `Eff[T1, T2]` with a polymorphic scheme that quantifies
# over BOTH the effect's type parameters AND the op's own
# per-op tparams (`op[U](...)`). Op tparam ids are
# allocated from `next_id` so they never collide with effect
# tparams. Stateless effects with monomorphic ops yield the same
# monomorphic scheme as before.
#
# Per-op ROW generics: collect any row-variable name
# appearing in an `ROpen(rv, _)` tail of the op's parameter or
# return types (the analog of `collect_decl_rvars` for fns).
# `Spawn.spawn[T](thunk: () -> T / e) : Fiber[T]` therefore picks
# up `e` as a per-op row variable. The scheme generalises over it
# so each call site fresh-instantiates a row var that unifies with
# the lambda argument's row tail. Effect-level row generics are
# not (yet) a thing; the offset for `mk_rvbinds_from` stays 0.
fn op_row(esym: SymId, op_name: String, rv_ids: [Int]) : Row = match rv_ids {
  [rv, ..._] -> if effect_is(esym, CeSpawn) and op_name == "spawn" { row_with_tail(rv) } else { inf_row_empty() }
  []         -> inf_row_empty()
}


fn add_effect_op_sigs_loop(env: TyEnv, binds: [TPBind],
                            ids: [Int], ops: [EffectOp],
                            ar_acc: [OpEffArity], esym: SymId, hv: TyHomeView) : EnvWithArities {
  match ops {
    [] -> EnvWithArities { env: env, arities: ar_acc }
    [op, ...rest] -> match op {
      EffOp(op_name, op_tparams, params, ret, _, _) -> {
        let next_id = list_length(binds)
        let op_binds = mk_tpbinds_from(op_tparams, next_id)
        let op_ids   = tparam_ids_from(op_tparams, next_id)
        let all_binds = append_tpbinds(binds, op_binds)
        let all_ids   = append_ints(ids, op_ids)
        let op_rv_names = collect_op_rvars(params, ret)
        let op_rvbinds  = mk_rvbinds_from(op_rv_names, 0)
        let op_rv_ids   = rvbind_ids(op_rvbinds)
        let pts = param_tys_with_op_binds(params, all_binds, op_rvbinds, hv)
        let ret_ty = resolve_ty_with_binds(ret, all_binds, op_rvbinds, [], hv)
        let body_ty = TyFnT(pts, ret_ty, op_row(esym, op_name, op_rv_ids))
        let sc = match op_rv_ids {
          [] -> match all_ids {
            [] -> mono(body_ty)
            _  -> scheme(all_ids, body_ty)
          }
          _ -> scheme_full(all_ids, op_rv_ids, body_ty)
        }
        let op = written(op_name)
        let env1 = env_bind_op(env, esym, op, sc)
        # Record only the effect-level arity per op. The
        # synth_op_call_with_scheme caller uses this to take the
        # first N entries of `inst.fresh` as the row label's ty_args.
        let ar1 = [OEA(esym, op, list_length(ids)), ...ar_acc]
        add_effect_op_sigs_loop(env1, binds, ids, rest, ar1, esym, hv)
      }
    }
  }
}


# variant of `param_tys_with_binds` that resolves
# parameter types under both type-param and row-variable binding
# contexts. Used by the op-signature builder so a thunk parameter
# `f: () -> T / e` records `e` as a bound row id rather than
# losing it to `Some(-1)` (the unbound-rv sentinel).
fn param_tys_with_op_binds(params: [Param], tpbinds: [TPBind],
                            rbinds: [RVBind], hv: TyHomeView) : [Ty] {
  match params {
    [] -> []
    [pm, ...rest] -> {
      let here = match pm.ptype {
        Some(te) -> resolve_ty_with_binds(te, tpbinds, rbinds, [], hv)
        None     -> TyAny
      }
      [here, ...param_tys_with_op_binds(rest, tpbinds, rbinds, hv)]
    }
  }
}


fn build_ty_env_module(seed: BuiltEnv, decls: [Decl], unions: UnionTable,
                        tab: SymTab, homes: TyHomes) : BuiltEnv {
  let rk_table = compute_row_kind_slots(decls)
  let env_with_unions = TyEnv { ...seed.env, unions: unions, row_kind: rk_table, ty_homes: homes, tab: tab }
  let r = add_decls_loop(env_with_unions, seed.op_eff_arities, decls, rk_table, homes)
  BuiltEnv { env: r.env, core_len: seed.core_len,
             op_eff_arities: r.arities, new_arities: r.arities }
}


# `build_ty_env_module` over an env that already carries the inherited
# entries (`inh`, extended by the fold): `core_len` stays the built-in
# seed length. The row-kind and type-home tables span the FULL program
# decl stream, so a `T[..., e]` annotation resolves the row slot of a
# type declared in another module.
#[doc("Typer-internal helper `build_ty_env_inherited` shared across the infer modules.")]
pub fn build_ty_env_inherited(seed: BuiltEnv, inh: TyEnvParts, inherited: ModuleEnvDelta,
                            decls: [Decl], unions: UnionTable,
                            rk_table: [RowKindEntry],
                            tab: SymTab, homes: TyHomes) : BuiltEnv {
  # `inh` already carries `inherited.ty_entries` on top of the seed, in
  # entries and indexes alike: the fold extends it module by module.
  let env_in = match inh {
    TEP(seeded_entries, seeded_index, seeded_vindex, _) -> TyEnv {
      ...seed.env, entries: seeded_entries, added: 0, unions: unions,
      constructors: list_append(inherited.constructors, seed.env.constructors),
      row_kind: rk_table, ty_homes: homes, tab: tab,
      index: seeded_index, vindex: seeded_vindex
    }
  }
  let ar_in = list_append(inherited.op_eff_arities, seed.op_eff_arities)
  let r = add_decls_loop(env_in, [], decls, rk_table, homes)
  BuiltEnv { env: r.env, core_len: seed.core_len,
             op_eff_arities: list_append(r.arities, ar_in), new_arities: r.arities }
}


#[doc("infer: build the initial typing environment (core + user sigs) for a decl list.")]
pub fn build_ty_env(decls: [Decl], tab: SymTab) : BuiltEnv {
  let seed = build_ty_env_seed()
  # harvest the union summary once and stash it on the
  # env so every downstream typer query (`variants_of_type`,
  # `union_upcast_ok`, the collision diagnostic) sees the same data.
  let homes = tsh_homes(decls, tab, fv_empty(), "", roots_of("", []))
  let unions = ut_add(ut_empty(), collect_union_rows(decls, tab, tsh_view(homes, None)))
  build_ty_env_module(seed, decls, unions, tab, homes)
}


# Unify two types under substitution `s`. Returns Some(s') with the
# extended substitution, or None on failure. The caller is responsible
# for reporting the mismatch at the right source position.
#
# TyAny is the "unresolved" placeholder the walker emits when it cannot
# determine a type (unknown record field, opaque lookup). It must match
# *anything* without entering the substitution: if TyAny leaked into
# `sub`, it would pollute unrelated TyVars through later lookups and
# turn clean `[?t1]` inferences into `[?]` noise. So short-circuit it
# at the top of unify, before the var-binding branches.
#[doc("Typer-internal helper `unify` shared across the infer modules.")]
pub fn unify(expected: Ty, actual: Ty, s: Subst) : Option[Subst] / Mutable = unify_flow(ty_env_empty(), expected, actual, s)


#[doc("Typer-internal helper `st_annot_labels` shared across the infer modules.")]
pub fn st_annot_labels(st: InferState, ls: [RowLabel]) : [Label] = match rigid_binds(st.sub.rigid) {
  []    -> inf_row_labels_of_rls(ls, st_home_view(st))
  binds -> row_labels_of_rls_with_binds(ls, binds, [], st_home_view(st))
}


# variant that also resolves type names against the fn-level
# tparams declared on the surrounding decl.
fn param_ty_or_fresh_with_binds(st: InferState, pm: Param,
                                tpbinds: [TPBind], rbinds: [RVBind]) : StTy {
  match pm.ptype {
    Some(te) -> ty_res(st, resolve_ty_with_binds(te, tpbinds, rbinds, st.env.row_kind, st_home_view(st)))
    None     -> st_fresh_ty(st)
  }
}


# variant of `add_infer_params` that resolves param types
# under a row-variable binding context — used by `infer_decl` so the
# function body's view of every parameter type carries the same
# bound row-var ids that `fn_scheme_of_decl` chose for the scheme.
# The tpbinds half lets the body also see fn-level tparams as bound
# type variables (`fn id[T](x: T) : T = x`).
fn add_infer_params_with_binds_loop(st: InferState, ps: [Param],
                                    tpbinds: [TPBind], rbinds: [RVBind],
                                    acc: [Ty]) : InferredParams {
  match ps {
    [] -> InferredParams { st: st, tys: list_reverse(acc) }
    [pm, ...rest] -> {
      let pr = param_ty_or_fresh_with_binds(st, pm, tpbinds, rbinds)
      let env2 = env_bind_local(pr.st.env, pm.binder, mono(pr.ty))
      let st2 = st_set_env(pr.st, env2)
      add_infer_params_with_binds_loop(st2, rest, tpbinds, rbinds, [pr.ty, ...acc])
    }
  }
}


#[doc("Typer-internal helper `add_infer_params_with_binds` shared across the infer modules.")]
pub fn add_infer_params_with_binds(st: InferState, ps: [Param],
                               tpbinds: [TPBind], rbinds: [RVBind]) : InferredParams =
  add_infer_params_with_binds_loop(st, ps, tpbinds, rbinds, [])


# An operation left between dispatchers waits for the type that receives
# it. One whose parameter or result is still a variable the declaration's
# own signature `sig` does not mention has nothing left to wait for.
#[doc("Typer-internal helper `report_stranded_ops` shared across the infer modules.")]
pub fn report_stranded_ops(st: InferState, hs: [DeferredHom], sig: [Ty]) : InferState / Console + File = match hs {
  [] -> st
  [h, ...rest] -> match h {
    DOp(ss, want, line, col) ->
      report_stranded_ops(if op_stranded(st, apply_ty(st.sub, want), sig) { report_op_stranded(st, ss, line, col) } else { st }, rest, sig)
    DHom(_, _, _, _) -> report_stranded_ops(st, rest, sig)
  }
}


fn op_stranded(st: InferState, want: Ty, sig: [Ty]) : Bool = match want {
  TyFnT(ps, ret, _) -> any([ret, ...ps], (t) => match t {
    TyVarT(v) -> not occurs_any(v, sig, st.sub)
    _         -> false
  })
  _ -> false
}


# resolve every deferred bare call now that the body has settled: the
# first argument's head names one candidate. A first argument still
# without a head leaves the name to the scope, which answers alone or
# reports the tie.
#[doc("Typer-internal helper `drain_deferred_homs` shared across the infer modules.")]
pub fn drain_deferred_homs(st: InferState, hs: [DeferredHom],
                        picks: [HomPick]) : HomDrain / Console + File + Mutable {
  match hs {
    [] -> HomDrain { st: st, picks: picks }
    [h, ...rest] -> match h {
      DHom(w, want, line, col) -> {
        let r = drain_one_deferred_hom(st, w, apply_ty(st.sub, want), line, col)
        drain_deferred_homs(r.st, rest, list_append(picks, r.picks))
      }
      DOp(_, _, _, _) -> drain_deferred_homs(st, rest, picks)
    }
  }
}


fn drain_one_deferred_hom(st: InferState, w: Written, want: Ty,
                           line: Int, col: Int) : HomDrain / Console + File + Mutable {
  let cands = hom_cands_of(bare_fn_candidates(st, w))
  match hom_first_param(want) {
    None      -> HomDrain { st: st, picks: [] }
    Some(arg) -> match hom_choose(cands, arg) {
      Some(s) -> hom_commit(st, s, want, line, col)
      None    -> match settle_name(st, None, w, TyAny, value_classes()) {
        SetOne(s)  -> hom_commit(st, s, want, line, col)
        SetTie(ss) -> HomDrain { st: report_name_tie(st, w, ss, true, line, col), picks: [] }
        _          -> HomDrain { st: st, picks: [] }
      }
    }
  }
}


fn hom_commit(st: InferState, s: SymId, want: Ty,
               line: Int, col: Int) : HomDrain / Console + File + Mutable {
  match env_sym(st.env, s) {
    None     -> HomDrain { st: st, picks: [] }
    Some(sc) -> {
      let inst = st_instantiate_report(st, sc)
      let st1 = if inst.fresh == [] and inst.unit_fresh == [] and inst.row_fresh == [] { inst.st }
                else { st_push_inst(inst.st, CS(s, line, col, inst.fresh, inst.unit_fresh, inst.row_fresh, None)) }
      let st2 = st_unify_callee(st1, inst.ty, want, "function call", line, col)
      HomDrain { st: st2, picks: [HPick(line, col, s)] }
    }
  }
}


# drain the deferred field-access worklist. Called by
# `infer_decl` after `check_body_row`, so each receiver tyvar that was
# unbound at synth time (a generic effect-op payload, the canonical
# case) is now resolved. For each constraint, resolve the receiver:
#   - concrete record `TyCon` with the field  -> unify the result tyvar
#     with the field type (so the typed AST's stamped fresh var becomes
#     concrete via the finalise pass) and the access type-checks.
#   - concrete `TyCon` WITHOUT the field       -> the missing-field error
#     on that type (closes the Tier 1 escape: `b.zzz` on a generic-effect
#     payload is now rejected at compile time, not silently accepted).
#   - any other concrete type                  -> field access on a
#     non-record value.
#   - still an unbound tyvar                    -> "type annotation needed"
#     (the body never pins the receiver; mirrors OCaml's warning 18).
#[doc("Typer-internal helper `drain_deferred_fields` shared across the infer modules.")]
pub fn drain_deferred_fields(st: InferState, dfs: [DeferredField],
                          declared: [Label]) : InferState / Console + File + Mutable {
  match dfs {
    [] -> st
    [df, ...rest] -> match df {
      DFd(recv_id, fnm, res_id, line, col, in_pat) -> {
        # a receiver still free here had its only carrier
        # (`Repo.find`'s `Repo[?a, Int]` label) dropped by `st_add_label`
        # dedup against a sibling op's concrete label. Pin it from the
        # DECLARED row — the authoritative source — by unifying the
        # stashed op label that carries `recv_id` against its declared
        # counterpart. A no-op when the receiver is already concrete
        # (every other op's payload, pinned by usage) or no stashed label
        # carries it; never touches the row partition, so it cannot
        # perturb the row-mismatch diagnostic (m7b_11).
        let stp = pin_free_receiver_from_decl(st, recv_id, declared)
        let recv = apply_ty(stp.sub, TyVarT(recv_id))
        let st1 = drain_one_deferred_field(stp, recv, fnm, res_id, line, col, in_pat)
        drain_deferred_fields(st1, rest, declared)
      }
    }
  }
}


# if `recv_id` is still a free tyvar after the body settled,
# find a stashed op whose payload shares the receiver's final
# representative — i.e. the body genuinely connected the receiver to that
# op's payload (the `match` binder did so) — and unify that op's label,
# resolved under the FINAL sub, against the declared row. That binds the
# receiver from the signature, the only sound source. An already-concrete
# receiver, no co-class op, or no matching declared label → `st`
# unchanged. The co-class precondition is what makes this sound for a
# discarded payload-free op (`let _ = self()` in a multi-instance row):
# its payload never joins the receiver's class, so no arbitrary binding.
fn pin_free_receiver_from_decl(st: InferState, recv_id: Int,
                                declared: [Label]) : InferState / Console + File + Mutable {
  match apply_ty(st.sub, TyVarT(recv_id)) {
    TyVarT(rrep) -> pin_via_op_vars(st, rrep, st.op_payload_labels, declared)
    _            -> st
  }
}


fn pin_via_op_vars(st: InferState, rrep: Int, ops: [OpPayloadVars],
                    declared: [Label]) : InferState / Console + File + Mutable {
  match ops {
    [] -> st
    [op, ...rest] -> match op {
      OPV(esym, cell, ids) ->
        if ids_share_rep(ids, rrep, st.sub) {
          # The receiver is in this op's payload class. Rebuild the op's
          # label with ty_args resolved under the FINAL sub, then unify
          # it against its declared counterpart — pinning the receiver's
          # still-free class members (the payload position) to the
          # declared concrete type.
          let lab = label_in_cell(esym, resolve_fresh_ids(ids, st.sub), cell)
          match find_matching_declared(declared, lab, st) {
            Some(st1) -> st1
            None      -> pin_via_op_vars(st, rrep, rest, declared)
          }
        } else {
          pin_via_op_vars(st, rrep, rest, declared)
        }
    }
  }
}


# True iff some id resolves, under the final sub, to the receiver's final
# representative `rrep`. This is the co-class test: the body unified that
# payload position with the receiver. A position that resolved to a
# concrete type (already pinned by usage) is not a free `TyVarT(rrep)`
# and so does not match — correctly, it needs no pinning.
fn ids_share_rep(ids: [Int], rrep: Int, s: Subst) : Bool {
  match ids {
    [] -> false
    [i, ...rest] -> match apply_ty(s, TyVarT(i)) {
      TyVarT(n) -> if n == rrep { true } else { ids_share_rep(rest, rrep, s) }
      _         -> ids_share_rep(rest, rrep, s)
    }
  }
}


# declared-row labels with their ty_args resolved to Ty,
# for the deferred-field pinning step. Bare-name (stateless) labels and
# open / absent rows contribute nothing a payload tyvar could bind to.
#[doc("Typer-internal helper `decl_row_concrete_labels` shared across the infer modules.")]
pub fn decl_row_concrete_labels(row: RowExpr, hv: TyHomeView) : [Label] {
  match row {
    RClosed(lbs)  -> inf_row_labels_of_rls(lbs, hv)
    ROpen(_, lbs) -> inf_row_labels_of_rls(lbs, hv)
    REmpty        -> []
  }
}


fn drain_one_deferred_field(st: InferState, settled: Ty, fnm: String,
                             res_id: Int, line: Int, col: Int, in_pat: Bool) : InferState / Console + File + Mutable {
  let recv = ty_dispatch_head(settled)
  match recv {
    TyCon(tsym, _) -> match rec_pick(st.recs, tsym) {
      Some(ri) -> {
        let inst = rec_instantiate(st, ri)
        let st0 = st_unify_join(inst.st, inst.result_ty, recv, "deferred field access", line, col)
        let st1 = if in_pat { check_pfield_visible(st0, ri, fnm, line, col) } else { st0 }
        match fty_find(inst.fields, fnm) {
          Some(t) -> st_unify_flow(st1, TyVarT(res_id), apply_ty(st1.sub, t), "deferred field access", line, col)
          None -> {
            let perr = mk_diag(SevError, st.file, line, col, "no field '#{fnm}' on #{decl_name(st.env.tab, tsym)}#{field_hint(inst.fields, fnm)}", [])
            st_bump_err(st_push_diag(st1, perr))
          }
        }
      }
      None -> field_absent_error(st, recv, fnm, line, col)
    }
    TyVarT(_) -> {
      let perr = mk_diag(SevError, st.file, line, col,
        concat_all(["type annotation needed: the receiver of `.", fnm,
                    "` is not resolved by the body — annotate it so the field can be checked"]), [])
      st_bump_err(st_push_diag(st, perr))
    }
    _ -> field_absent_error(st, recv, fnm, line, col)
  }
}


# find a declared label whose effect and ty_args unify
# with the body's label. Side effect: if a match is found, the unifier
# may bind tyvars on the body label's ty_args to concrete declared
# types. Returns the post-unification InferState, or None on no match.
#[doc("Typer-internal helper `find_matching_declared` shared across the infer modules.")]
pub fn find_matching_declared(declared: [Label], target: Label,
                            st: InferState) : Option[InferState] / Console + File + Mutable {


  match declared_candidates(declared, target, st.sub) {
    []  -> None
    [d] -> Some(unify_label_args_into(d.ty_args, target.ty_args, st))
    # A phantom label demands some instance, so any candidate serves it.
    ds  -> if label_is_phantom(target) { Some(st) } else { match filter(ds, (d) => label_args_identical(d.ty_args, target.ty_args, st.sub)) {
      [d] -> Some(unify_label_args_into(d.ty_args, target.ty_args, st))
      _   -> Some(report_ambiguous_instance(st, target, ds))
    } }
  }
}


fn label_args_identical(a: [Ty], b: [Ty], s: Subst) : Bool = match a {
  [] -> match b { [] -> true _ -> false }
  [ah, ...arest] -> match b {
    [] -> false
    [bh, ...brest] -> ty_identical(apply_ty(s, ah), apply_ty(s, bh)) and label_args_identical(arest, brest, s)
  }
}


fn ty_identical(a: Ty, b: Ty) : Bool = match a {
  TyVarT(i) -> match b { TyVarT(j) -> i == j  _ -> false }
  _         -> ty_eq_shape_concrete(a, b)
}


# Two declared instances fit the perform and nothing pins which one it means.
fn report_ambiguous_instance(st: InferState, target: Label, cands: [Label]) : InferState / Console + File + Mutable = {
  let at = lookup_eff_use(st.eff_uses, target)
  let line = match at { EU(_, l, _) -> l }
  let col = match at { EU(_, _, c) -> c }
  let shown = label_diag_display(st, apply_label_args(st.sub, target))
  let header = "ambiguous effect instance: `#{shown}`"
  let n1 = "it fits #{join_with(map(cands, (c) => label_diag_display(st, apply_label_args(st.sub, c))), " and ")}"
  let h1 = "pin the instance with a type the op's result or arguments must have, or call a helper whose row names one instance"
  let d = mk_diag(SevError, st.file, line, col, header, [ri_note(st.file, line, col, n1), ri_help(st.file, line, col, h1)])
  st_bump_err(st_push_diag(st, d))
}


# Unify two ty_arg lists, propagating any new bindings into st.sub.
# Mismatched length → no-op (caller already excluded that case via
# labels_args_unify which requires equal length).
fn unify_label_args_into(a: [Ty], b: [Ty], st: InferState) : InferState / Console + File + Mutable {


  match a {
    [] -> st
    [ah, ...arest] -> match b {
      [] -> st
      [bh, ...brest] -> {
        let st1 = st_unify_join(st, ah, bh, "row label type argument", -1, -1)
        unify_label_args_into(arest, brest, st1)
      }
    }
  }
}

