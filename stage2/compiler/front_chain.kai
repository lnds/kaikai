#[doc("The per-declaration chain that runs before typing, shared by the whole-program stream and the completion of a single library function.")]

import compiler.ast_decl
import compiler.ast_ids
import compiler.symtab
import compiler.diag_file
import compiler.scope_view
import compiler.module_table
import compiler.modules
import compiler.modules_segments
import compiler.name_uses
import compiler.qual_head
import compiler.effect_scope
import compiler.type_scope
import compiler.surface_lower
import compiler.tparam_bind
import compiler.protos_check
import compiler.driver_cli

#[doc("Surface declarations lowered to the core language, with the law registry the lowering recorded.")]
pub(pkg) type LoweredSurface = { laws: StrippedLaws, decls: [Decl] }

#[doc("Lower the import stream `decls`, partitioned by `segs`, and probe the files `cover` names.")]
pub(pkg) fn lower_surface(cover: CoverSpec, segs: [ImportSeg], mods: [ModuleEntry], tab0: SymTab, decls: [Decl]) : LoweredSurface / Console + File = {
  let laws = strip_law_wrappers(tparam_bind_decls(surface_lower_decls(decls, tab0)))
  LoweredSurface { laws: laws, decls: cover_decls(cover, segs, mods, strip_sl_decls(laws)) }
}

#[doc("The tables the scoping passes read, all built from signatures.")]
pub(pkg) type ScopeCx = {
  tab0: SymTab,
  target: String,
  mod_tabs: ModTables,
  mod_imps: [ModImports],
  sym_views: FileViews,
  cores: [String],
  sel_imports: [SelImport],
  diag_ctx: DiagFiles,
  aliases: [SymId]
}

#[doc("The tables collected from the scoped stream after type qualifiers settle: the symbol table the rows extend, the colliding constants and values, and the effect ops a qualifier may defer to.")]
pub(pkg) type ScopePost = { tab1: SymTab, cs_coll: [NEnt], rqc_fx: [RqcFx], vs_coll: [VSEntry] }

#[doc("Every stage of the scoping chain, for the checks that read an intermediate.")]
pub(pkg) type ScopeRun = {
  eff: [Decl],
  ts_coll: [TSEntry],
  scoped: [Decl],
  qt: QualTyped,
  post: ScopePost,
  valued: [Decl],
  qualified: [Decl]
}

#[doc("Settle effects, types, qualifiers, values and constants of the segmented stream `decls`, in that order. `ts_of` collects the contested types from the effect-settled stream; `post_of` collects the post tables from the qualifier-settled stream and its rows.")]
pub(pkg) fn scope_segments(sc: ScopeCx, segs: [ImportSeg], decls: [Decl], ts_of: ([Decl]) -> [TSEntry],
                           post_of: ([Decl], QualTyped) -> ScopePost) : ScopeRun / Console + File = {
  let eff = es_segmented(segs, decls, sc.mod_tabs, sc.target, sc.tab0, sc.sym_views, sc.aliases)
  let ts_coll = ts_of(eff)
  let scoped = ts_segmented(segs, eff, ts_coll, sc.mod_tabs, sc.mod_imps, sc.target, sc.cores, sc.sel_imports)
  let qt = qualtype_segmented(segs, scoped, sc.tab0, sc.mod_tabs, sc.mod_imps)
  let headed = qh_segmented(segs, qt.decls, sc.mod_tabs)
  let post = post_of(headed, qt)
  let valued = vs_segmented(segs, headed, post.vs_coll, sc.mod_tabs, sc.mod_imps, sc.target, sc.cores)
  let consts = nu_scope_const_decls(valued, post.cs_coll, sc.target, sc.mod_tabs)
  ScopeRun { eff: eff, ts_coll: ts_coll, scoped: scoped, qt: qt, post: post, valued: valued,
             qualified: rqc_segmented(segs, consts, sc.mod_tabs, post.rqc_fx, sc.diag_ctx) }
}
