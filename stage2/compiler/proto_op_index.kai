# compiler/proto_op_index.kai -- the protocols declaring each operation
# name. Two protocols may declare an operation of the same name and share
# its dispatcher, so a name maps to every protocol that declares it.

import compiler.ast
import compiler.infer_index

#[doc("The protocols of the program indexed by the names of their operations.")]
pub type OpIndex = OpIndex(NameIndex[OpEntry])

#[doc("One operation name and the protocol declaring it.")]
pub type OpEntry = OpEntry(String, String)

#[doc("Index every operation of `ops` by its name.")]
pub fn op_index(ops: [ProtoOpReg]) : OpIndex = OpIndex(op_index_loop(ops, idx_empty()))

fn op_index_loop(ops: [ProtoOpReg], ix: NameIndex[OpEntry]) : NameIndex[OpEntry] = match ops {
  [] -> ix
  [POR(p, op, _, _, _, _, _, _), ...rest] -> op_index_loop(rest, idx_prepend(ix, op, OpEntry(op, p)))
}

#[doc("Fold `f` over every protocol declaring an operation named `op`; buckets are keyed by hash, so each entry re-tests the name.")]
pub fn op_protocols_fold(ix: OpIndex, op: String, acc: a, f: (a, String) -> a) : a = match ix {
  OpIndex(t) -> op_fold(idx_chain(t, op), op, acc, f)
}

fn op_fold(xs: [OpEntry], op: String, acc: a, f: (a, String) -> a) : a = match xs {
  [] -> acc
  [OpEntry(o, p), ...rest] -> op_fold(rest, op, if o == op { f(acc, p) } else { acc }, f)
}
