#[doc("""
The parts of an interpolated string, each `#{...}` body parsed.

A string literal reaches surface lowering as the span the author wrote.
This is where a body stops being text: it is parsed once, at the
position it occupies in the file, so every pass from there on reads the
body as it reads any other expression.
""")]

import compiler.util
import compiler.ast
import compiler.fnreg
import compiler.infer
import compiler.parse

#[doc("One part of an interpolated string: literal text, spelled as the string literal that holds it and placed where it starts, or the expression of a `#{...}` body.")]
pub type InterpPiece = IpcText(String, InterpPos) | IpcHole(Expr)

#[doc("A position in the source a string literal is written in.")]
pub type InterpPos = { line: Int, col: Int }

#[doc("The parts of the string literal `span` written at `line:col`, in source order. `None` when it interpolates nothing, or when a body does not parse.")]
pub fn interp_pieces(span: String, is_triple: Bool, line: Int, col: Int) : Option[[InterpPiece]] / Console {
  let lead = if is_triple { 3 } else { 1 }
  let end = string_length(span) - lead
  if has_interp(span, lead, end) {
    ih_pieces(iscan_collect(span, end, IScan { parts: [], lit_start: lead, i: lead }),
              InterpPos { line: line, col: col + lead }, [])
  } else { None }
}

fn ih_pieces(parts: [IPart], pos: InterpPos, acc: [InterpPiece]) : Option[[InterpPiece]] / Console = match parts {
  [] -> Some(list_reverse(acc))
  [IpLit(piece, quoted), ...rest] -> ih_pieces(rest, interp_pos_advance(pos, piece, 0), [IpcText(quoted, pos), ...acc])
  [IpExp(src), ...rest] -> {
    let body = interp_pos_body(pos)
    match parse_interp_expr_at(src, body.line, body.col) {
      None    -> None
      Some(e) -> ih_pieces(rest, interp_pos_past(body, src), [IpcHole(e), ...acc])
    }
  }
}

#[doc("Where the body of a `#{...}` that opens at `p` starts.")]
pub fn interp_pos_body(p: InterpPos) : InterpPos = InterpPos { line: p.line, col: p.col + 2 }

#[doc("The position after the `}` that closes a body `src` starting at `body`.")]
pub fn interp_pos_past(body: InterpPos, src: String) : InterpPos {
  let after = interp_pos_advance(body, src, 0)
  InterpPos { line: after.line, col: after.col + 1 }
}

#[doc("`p` moved past `s` from index `i` on. A triple-quoted literal spans lines, and a newline starts the next one at column 1.")]
pub fn interp_pos_advance(p: InterpPos, s: String, i: Int) : InterpPos {
  if i >= string_length(s) { p }
  else {
    let nxt = match char_at(s, i) {
      Some('\n') -> InterpPos { line: p.line + 1, col: 1 }
      _          -> InterpPos { line: p.line, col: p.col + 1 }
    }
    interp_pos_advance(nxt, s, i + 1)
  }
}
