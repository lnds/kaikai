#[doc("""
The interprocedural borrow map Perceus reads: a callee's identity to the
parameter positions it borrows. A map's own rows are searched first, then
the rows it extends, bucketed by the identity.
""")]

import compiler.ast

#[doc("One borrow-map row: a callee's identity and the parameter positions the callee borrows.")]
pub type BorrowEntry = BwE(FnId, [Int])

#[doc("A borrow map: none, or its own rows, searched first, then the bucketed rows it extends.")]
pub type BorrowMap = BEmpty | BMap([BorrowEntry], Array[[BorrowEntry]])

const BUCKETS : Int = 4096

#[doc("The borrow map with no rows.")]
pub fn bm_empty() : BorrowMap = BEmpty

#[doc("The borrow map of `es`; an identity several rows share answers with the first.")]
pub fn bm_of(es: [BorrowEntry]) : BorrowMap = BMap([], bm_fill(array_make(BUCKETS, []), list_reverse(es)))

#[doc("`base` with the rows `own` ahead of its own.")]
pub fn bm_extend(own: [BorrowEntry], base: BorrowMap) : BorrowMap = match base {
  BEmpty           -> BMap(own, array_make(1, []))
  BMap(_, buckets) -> BMap(own, buckets)
}

#[doc("The positions the first row of the function `key` borrows, or none. No row borrows nothing, so an empty answer means no row.")]
pub fn bm_lookup(bm: BorrowMap, key: FnId) : [Int] = match bm {
  BEmpty -> []
  BMap(own, buckets) -> match bm_first(own, key) {
    [] -> bm_first(array_get(buckets, bm_bucket(buckets, key)), key)
    ps -> ps
  }
}

# Filled back to front, so each bucket keeps its rows in list order.
fn bm_fill(buckets: Array[[BorrowEntry]], es: [BorrowEntry]) : Array[[BorrowEntry]] / Mutable = match es {
  [] -> buckets
  [BwE(k, ps), ...rest] -> {
    let b = bm_bucket(buckets, k)
    buckets[b] := [BwE(k, ps), ...array_get(buckets, b)]
    bm_fill(buckets, rest)
  }
}

fn bm_bucket(buckets: Array[[BorrowEntry]], key: FnId) : Int = {
  let m = array_length(buckets)
  (((sym_raw(fnid_sym(key)) + fnid_inst(key)) % m) + m) % m
}

# A bucket holds every key that falls in it, so each row re-tests the key.
# An unresolved identity equals none.
fn bm_first(es: [BorrowEntry], key: FnId) : [Int] = match es {
  [] -> []
  [BwE(k, ps), ...rest] -> if fnid_eq(k, key) { ps } else { bm_first(rest, key) }
}
