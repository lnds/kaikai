#[doc("""
Sets of core builtin ids, for the groups too large to enumerate.

A pass builds the set it needs once, where it builds its context, and
asks membership of a reference's id from then on.
""")]

import compiler.ast
import compiler.infer_index
import compiler.core_syms
import compiler.core_prims
import compiler.native_prims

#[doc("A set of symbol ids.")]
pub type SymSet = { ix: NameIndex[SymId] }

#[doc("The set holding no id.")]
pub fn sym_set_empty() : SymSet = SymSet { ix: idx_empty() }

#[doc("The set of the ids `ss`.")]
pub fn sym_set_of(ss: [SymId]) : SymSet = SymSet { ix: ss_add(ss, idx_empty()) }

#[doc("True when `set` holds `s`.")]
pub fn sym_set_has(set: SymSet, s: SymId) : Bool = match idx_chain_sym(set.ix, s) {
  [] -> false
  _  -> true
}

fn ss_add(ss: [SymId], ix: NameIndex[SymId]) : NameIndex[SymId] = match ss {
  []           -> ix
  [s, ...rest] -> ss_add(rest, idx_prepend_sym(ix, s, s))
}

#[doc("The raw core primitives: a call to one crosses unboxed.")]
pub fn raw_prim_syms() : SymSet = sym_set_of(map(native_prim_names(), builtin_sym))

#[doc("The builtins a program can name as a value: every bound row of the builtin table, and the lending sibling of one that has it.")]
pub fn bound_builtin_syms() : SymSet = sym_set_of(map(core_builtin_names(), builtin_sym))
