#[doc("""
Leaf helpers of expression parsing: lambdas, handler assembly, ranges,
regex sigils and collection literals.
""")]

import compiler.util
import compiler.chars
import compiler.diag
import compiler.lex_tokens
import compiler.ast
import compiler.written
import compiler.interp_scan
import compiler.parse_state
import compiler.parse_literals
import compiler.parse_units

#[doc("""
Consume a `.field` chain after the base of a `@`-deref, building an
`EField` path. `@n.a.b` derefs the ref `n.a.b`; the chain stops at
the first non-`.field` token (no calls or indices — a deref target is
a plain `.`-path). A bare `@n` leaves `acc` as the base `EVar`.
""")]
pub fn parse_deref_path(p: Parser, acc: Expr) : PExpr / Console {
  if not p_at(p, TkDot) { ok_e(p, acc) }
  else {
    let p1 = p_advance(p)
    let f = p_peek(p1)
    if not tk_is(f.kind, TkIdent) {
      err_e(p_error(p1, f, "expected a field name after `.` in a `@`-deref path"))
    } else {
      let fld = tok_source(p1.src, f)
      parse_deref_path(p_advance(p1), mk_expr(EField(acc, fld), acc.line, acc.col))
    }
  }
}

#[doc("""
Preserve the block spelling of a lambda so the writer can print it
back; `surface_lower_decls` dissolves the wrapper to the plain
lambda before resolution.
""")]
pub fn wrap_lam_block(lam: Expr, trailing: Bool, t: Token) : Expr =
  mk_expr(ESurface(SfLamBlock(lam, trailing)), t.line, t.col)

#[doc("""
Build a block-lambda expression, rewriting the body to a single-arm
`match` over the fresh binder when the parameter is a destructuring
pattern. The match's exhaustiveness check rejects a refutable pattern
(e.g. `Some(x)`) with the standard non-exhaustive diagnostic.
""")]
pub fn finish_block_lambda(res: LamBlockParams, body: Expr, t: Token) : Expr {
  match res.wrap {
    None -> mk_expr(ELambda(res.params, body), t.line, t.col)
    Some(pat) -> {
      let scrut = mk_local(lam_block_binder(res.params), pat.line, pat.col)
      let m = mk_expr(EMatch(scrut, [Arm(pat, None, body)]), pat.line, pat.col)
      mk_expr(ELambda(res.params, m), t.line, t.col)
    }
  }
}

fn lam_block_binder(params: [Param]) : LocalId {
  match params {
    [pm, ..._] -> pm.binder.id
    [] -> local_none()
  }
}

#[doc("Parses the parameters of a block lambda up to its closing bar.")]
pub fn try_parse_lambda_block_params_loop(p: Parser, acc: [Param]) : Option[LamBlockParams] {
  let t = p_peek(p)
  if not tk_is(t.kind, TkIdent) { None }
  else {
    let name = tok_source(p.src, t)
    let p1 = p_advance(p)
    let pm = Param { binder: binder_written(name), ptype: None, pline: t.line, pcol: t.col, pborrow: false }
    let acc1 = [pm, ...acc]
    if p_at(p1, TkComma) {
      try_parse_lambda_block_params_loop(p_skip_newlines(p_advance(p1)), acc1)
    } else if p_at(p1, TkArrow) {
      Some(LamBlockParams { p: p_advance(p1), params: list_reverse(acc1), wrap: None })
    } else {
      None
    }
  }
}

#[doc("""
After a numeric literal, peek for an *adjacent* `<` (no whitespace
between the literal and the `<`). When found, parse the
unit expression and wrap the literal in an ELitUnit. Adjacency is
the only disambiguator from a comparison `1 < 2`; the spec explicitly
requires no space between the number and `<`.
""")]
pub fn try_lit_unit_annotation(p: Parser, lit: Expr, lit_tok: Token) : PExpr / Console {

  let nxt = p_peek(p)
  let lit_end = lit_tok.start + lit_tok.length
  if tk_is(nxt.kind, TkLt) and nxt.start == lit_end {
    let p2 = p_skip_newlines(p_advance(p))
    let ru = parse_unit_expr(p2)
    match ru.r {
      None -> err_e(ru.p)
      Some(u) -> {
        let p3 = p_skip_newlines(ru.p)
        if not p_at(p3, TkGt) {
          err_e(p_error_here(p3, "expected `>` to close the unit annotation on a literal"))
        } else {
          ok_e(p_advance(p3), mk_expr(ELitUnit(lit, u), lit_tok.line, lit_tok.col))
        }
      }
    }
  } else {
    ok_e(p, lit)
  }
}

fn interp_fail_head() : String = "cannot parse the interpolated expression"

#[doc("""
A nested body that fails has already named itself; any other failure
names the body and keeps the parser's reason as a note.
""")]
pub fn p_interp_fail(p: Parser, src: String, body: InterpPos, inner: Option[Diagnostic]) : Parser / Console = {
  let own = concat_all([interp_fail_head(), " `", src, "`"])
  match inner {
    None -> p_interp_report(p, mk_diag(SevError, p.file, body.line, body.col, own, []))
    Some(D(_, _, l, c, msg, notes)) ->
      if starts_with(msg, interp_fail_head()) { p_interp_report(p, mk_diag(SevError, p.file, l, c, msg, notes)) }
      else { p_interp_report(p, mk_diag(SevError, p.file, body.line, body.col, concat_all([own, ": ", msg]), notes)) }
  }
}

fn p_interp_report(p: Parser, d: Diagnostic) : Parser / Console = match d {
  D(sev, _, l, c, msg, notes) ->
    if p.file == interp_parse_file() { p_mark_err(p, d) }
    else {
      diag_error_from_src(p.file, p.src, l, c, msg)
      notes |> each((n) => match n { DR(_, _, _, m) -> diag_note(m) })
      p_mark_err(p, D(sev, p.file, l, c, msg, map(notes, (n) => match n { DR(_, nl, nc, m) -> DR(p.file, nl, nc, m) })))
    }
}

#[doc("""
`todo!(msg)` — `todo!` is a single token (lexer-fused).
The message must be a plain (non-triple, no interpolation) string
literal so the compile-time `--holes-json` report and the runtime
panic message agree on a single static value. The token at `t` is
the `todo!`, and `p` is positioned right after it.
""")]
pub fn parse_todo_bang(p: Parser, t: Token) : PExpr / Console {
  let p1 = p_advance(p)
  if not p_at(p1, TkLparen) {
    err_e(p_error_here(p1, "expected `(` after `todo!`"))
  } else {
    let p2 = p_skip_newlines(p_advance(p1))
    let st = p_peek(p2)
    if not tk_is(st.kind, TkString) {
      err_e(p_error(p2, st, "`todo!` requires a literal string message: `todo!(\"...\")`"))
    } else {
      parse_todo_message(p2, st, t)
    }
  }
}

fn is_triple_quoted(span: String) : Bool =
  string_length(span) >= 6 and char_is_quote(span, 0) and char_is_quote(span, 1) and char_is_quote(span, 2)

fn char_is_quote(s: String, i: Int) : Bool =
  match char_at(s, i) {
    Some(c) -> c == '"'
    None -> false
  }

fn parse_todo_message(p2: Parser, st: Token, t: Token) : PExpr / Console {
  let span = tok_source(p2.src, st)
  let body_end = string_length(span) - 1
  if is_triple_quoted(span) {
    err_e(p_error(p2, st, "`todo!` does not accept triple-quoted strings"))
  } else if has_interp(span, 1, body_end) {
    err_e(p_error(p2, st, "`todo!` message must be a plain string literal (no interpolation)"))
  } else {
    let p3 = p_skip_newlines(p_advance(p2))
    if not p_at(p3, TkRparen) {
      err_e(p_error_here(p3, "expected `)` after `todo!` message"))
    } else {
      ok_e(p_advance(p3), mk_expr(ETodo(string_slice(span, 1, body_end - 1)), t.line, t.col))
    }
  }
}

#[doc("Parses an optional `as name` alias after a handler head.")]
pub fn parse_handle_alias(p: Parser) : PAlias / Console {

  if not p_at(p, TkAs) { PAlias { p: p, r: None } }
  else {
    let p1 = p_advance(p)
    let nt = p_peek(p1)
    if not tk_is(nt.kind, TkIdent) {
      PAlias { p: p_error(p1, nt, "expected alias name after `as`"), r: None }
    } else {
      PAlias { p: p_advance(p1), r: Some(binder_written(tok_source(p1.src, nt))) }
    }
  }
}

#[doc("""
`initially { }` / `finally { }` — the acquire/release pair inside a
handler. Contextual idents, not lexer keywords: an op clause always
has `(` after the name, so the `{` lookahead disambiguates and user
code may still declare an op called `finally`.
""")]
pub fn is_lifecycle_clause_at(p: Parser, id_t: Token) : Bool =
  match clause_lifecycle_of_word(tok_source(p.src, id_t)) {
    Some(_) -> p_at(p_skip_newlines(p_advance(p)), TkLbrace)
    None    -> false
  }

#[doc("""
Assemble the `EHandle` once the clause block has parsed: lift
`initially` into the handler-state slot, then wrap in the `var`/`let`
prelude block if the clause list opened with one.
""")]
pub fn finish_handle(p4: Parser, t: Token, body: Expr, eff_name: DeclRef,
                 eff_tyargs: [TypeExpr], init_r: PInit,
                 alias: Option[Binder], cr: PClauses) : PExpr / Console {

  # `initially { }` fills the same handler-state slot as the `(init)`
  # form, so the two are mutually exclusive.
  let init_cl = find_initially_clause(cr.clauses)
  let dup_init = match init_cl { Some(_) -> init_r.has_init None -> false }
  if dup_init {
    err_e(p_error(p4, t, "a handler takes either `(init)` or `initially { }`, not both"))
  } else {
    # The clause spelling rides a surface wrapper so the writer can
    # reproduce `initially { }` instead of guessing from the init's shape.
    let eff_init = match init_cl {
      Some(HC(_, _, ib, il, ic)) -> Some(mk_expr(ESurface(SfHandleInit(ib)), il, ic))
      None                       -> init_r.r
    }
    let handle_e = mk_expr(
      EHandle(body, eff_name, eff_tyargs, eff_init, alias,
              drop_initially_clauses(cr.clauses), cr.return_clause),
      t.line, t.col)
    # A `var` / `let` prelude lifts to a sibling block whose tail is the
    # handler; `desugar_var_block` then wraps each `SVar` in its own
    # `with State[T] as name`. An empty prelude emits the bare `EHandle`.
    match cr.prelude {
      [] -> ok_e(cr.p, handle_e)
      _  -> ok_e(cr.p, mk_expr(EBlock(cr.prelude, Some(handle_e)), t.line, t.col))
    }
  }
}

fn find_initially_clause(cs: [HClause]) : Option[HClause] = match cs {
  [] -> None
  [c, ...rest] -> match c {
    HC(ChInitially, _, _, _, _) -> Some(c)
    _                           -> find_initially_clause(rest)
  }
}

fn drop_initially_clauses(cs: [HClause]) : [HClause] = match cs {
  [] -> []
  [c, ...rest] -> match c {
    HC(ChInitially, _, _, _, _) -> drop_initially_clauses(rest)
    _                           -> [c, ...drop_initially_clauses(rest)]
  }
}

#[doc("Reports whether a lifecycle clause of the given head was already parsed.")]
pub fn lifecycle_clause_seen(acc: [HClause], head: ClauseHead) : Bool = match acc {
  [] -> false
  [HC(h, _, _, _, _), ...rest] -> same_lifecycle(h, head) or lifecycle_clause_seen(rest, head)
}

fn same_lifecycle(a: ClauseHead, b: ClauseHead) : Bool = match a {
  ChInitially -> match b { ChInitially -> true  _ -> false }
  ChFinally   -> match b { ChFinally -> true  _ -> false }
  ChOp(_)     -> false
}

#[doc("""
Bounded, side-effect-free lookahead for the `region { r -> ... }`
binder: a single `Ident` immediately followed by `->`. A tuple
pattern or multi-param list is not a region binder (a region names one
arena), so those and the bare `{ ... }` form return None and fall
through to the plain-block path.
""")]
pub fn region_binder_name(p: Parser) : Option[RegionBinder] / Console {
  if not p_at(p, TkIdent) { None }
  else {
    let t = p_peek(p)
    let p1 = p_advance(p)
    if p_at(p1, TkArrow) {
      Some(RegionBinder { p: p_advance(p1), name: tok_source(p.src, t) })
    } else { None }
  }
}

# Parse a `~r/pattern/` sigil token into an expression.
# The lexer has already validated the delimiter shape and stored the
# full sigil source span on the token. We desugar to a runtime call
# `regex_compile_or_panic("<pattern>")` whose result is a `Regex`
# value — meaning `~r/pat/` works as a first-class expression in any
# position, not just inside refinement predicates.
#
# The pattern body is wrapped as a kaikai string literal with two
# byte-level escapes (`\` -> `\\`, `"` -> `\"`) so the post-decode
# bytes match the regex source verbatim. `#` is forbidden in the body
# because it would collide with kaikai's `#{...}` string
# interpolation; a pattern containing `#` must use `regex_compile`
# directly.
#[doc("Parses a regex sigil literal into a string expression.")]
pub fn parse_regex_sigil(p: Parser, t: Token) : PExpr / Console {

  let span = tok_source(p.src, t)
  let n = string_length(span)
  # Span shape: `~r/pattern/`. Strip the 3-char prefix `~r/` and the
  # trailing `/`. The lexer guarantees both delimiters are present
  # (otherwise it emitted TkError, never TkRegex).
  let pattern = string_slice(span, 3, n - 4)
  if regex_pattern_has_hash(pattern, 0, string_length(pattern)) {
    err_e(p_error_here(p,
      "regex sigil contains `#`, which v1 forbids (would collide with kaikai string interpolation); use `regex_compile` directly for patterns containing `#`"))
  } else {
    let escaped = regex_pattern_to_kai_str_body(pattern, 0, string_length(pattern), "")
    let str_span = concat_all(["\"", escaped, "\""])
    let pat_str = mk_expr(EStr(str_span, false), t.line, t.col)
    let callee = mk_expr(EModCall(written("regexp"), written("compile_or_panic")), t.line, t.col)
    let call = mk_expr(ECall(callee, [pat_str]), t.line, t.col)
    ok_e(p_advance(p), call)
  }
}

# Walk the regex pattern body byte-by-byte, escaping the two
# characters that have a load-bearing meaning inside a kaikai
# string literal: `\` (escape introducer) and `"` (terminator).
# Every other byte passes through verbatim — including bytes that
# would be metacharacters at the regex level. The result is the
# *body* of a kaikai string literal; the caller wraps it in `"..."`.
fn regex_pattern_to_kai_str_body(s: String, i: Int, n: Int, acc: String) : String {
  if i >= n { acc }
  else {
    match char_at(s, i) {
      None -> acc
      Some(c) -> {
        let piece =
          if c == '\\' { "\\\\" }
          else if c == '"' { "\\\"" }
          else { int_to_byte_string(char_to_int(c)) }
        regex_pattern_to_kai_str_body(s, i + 1, n, string_concat(acc, piece))
      }
    }
  }
}

fn regex_pattern_has_hash(s: String, i: Int, n: Int) : Bool {
  if i >= n { false }
  else {
    match char_at(s, i) {
      None -> false
      Some(c) -> if c == '#' { true } else { regex_pattern_has_hash(s, i + 1, n) }
    }
  }
}

# Map arity → stdlib tuple type name. `None` for unsupported arities.
pub fn tuple_type_for_arity(n: Int) : Option[String] {
  match n {
    2 -> Some("Pair")
    3 -> Some("Triple")
    4 -> Some("Quad")
    _ -> None
  }
}

#[doc("""
Close an unannotated group: every pending name becomes a `ptype: None`
Param. Lambda params may go unannotated (the typer infers them); `fn`
params may not — that path errors instead (see parse_fn_params_group).
""")]
pub fn close_param_group_untyped(names: [PendName], acc: [Param]) : [Param] {
  match names {
    [] -> acc
    [pn, ...rest] ->
      close_param_group_untyped(rest,
        [Param { binder: binder_written(pn.nm), ptype: None, pline: pn.nline, pcol: pn.ncol, pborrow: pn.pborrow }, ...acc])
  }
}

#[doc("Reports whether a spread entry appears before the last element.")]
pub fn spread_before_last(bracket: Expr) : Bool = match bracket.kind {
  EList(elems) -> any(drop(list_reverse(elems), 1), (el) => match el { ElSpread(_) -> true ElPlain(_) -> false })
  _            -> false
}

#[doc("""
A list has an end: `r` is the bracket `p` opens, and a range without
one is an error that spells the lazy sequence it is.
""")]
pub fn reject_endless(p: Parser, r: PExpr) : PExpr / Console = match r.r {
  None    -> r
  Some(e) -> match e.kind {
    ESurface(SfEndlessRange(_, _)) ->
      err_e(p_error(r.p, p_peek(p), concat_all(["a list has an end; a range without one is a lazy sequence — write `lazy ", src_between(p, r.p, 0), "`"])))
    _ -> r
  }
}

#[doc("The source between the token at `a`, less its first `skip` bytes, and the token at `b`.")]
pub fn src_between(a: Parser, b: Parser, skip: Int) : String {
  let lo = p_peek(a).start + skip
  trim(string_slice(a.src, lo, p_peek(b).start - lo))
}

#[doc("The step of a stepped range whose leading elements fix it: two Int literals, two Char literals, or `second` written as the name `first` plus a literal.")]
pub fn literal_step(first: Expr, second: Expr) : Option[Int] = match first.kind {
  EChar(a) -> match second.kind {
    EChar(b) -> Some(char_to_int(b) - char_to_int(a))
    _        -> None
  }
  EName(_) -> match second.kind {
    EBinop(BoAdd, base, k) -> if same_name(first, base) { try_int_literal(k) } else { None }
    _                      -> None
  }
  _ -> match try_int_literal(first) {
    Some(a) -> match try_int_literal(second) {
      Some(b) -> Some(b - a)
      None    -> None
    }
    None -> None
  }
}

fn same_name(a: Expr, b: Expr) : Bool = match a.kind {
  EName(x) -> match b.kind {
    EName(y) -> written_text(x) == written_text(y)
    _        -> false
  }
  _ -> false
}

#[doc("`p` is at the `]` closing a stepped range; with no `last` it is endless.")]
pub fn stepped_range_at(p: Parser, first: Expr, second: Expr, last: Option[Expr], t: Token) : PExpr / Console = match literal_step(first, second) {
  Some(0) -> err_e(p_error(p, t, "the first two elements of a stepped range must differ: their difference is the step, and a step of zero never ends"))
  _       -> ok_e(p_advance(p), mk_expr(ESurface(match last {
    Some(hi) -> SfSteppedRange(first, second, hi)
    None     -> SfEndlessRange(first, Some(second))
  }), t.line, t.col))
}

#[doc("Builds a map literal expression.")]
pub fn mk_map_lit(spread: Option[Expr], entries: [MapEntry], t: Token) : Expr =
  mk_expr(ESurface(SfMapLit(spread, entries_flatten(entries, []))), t.line, t.col)

fn entries_flatten(entries: [MapEntry], acc: [Expr]) : [Expr] = match entries {
  [] -> list_reverse(acc)
  [MapE(k, v), ...rest] -> entries_flatten(rest, [v, k, ...acc])
}

#[doc("""
`%[]` -> set.empty(); `%[ e ]` -> set.from([e]);
`%[ ...base, e ]` -> set.insert chain over base.
""")]
pub fn mk_set_lit(spread: Option[Expr], elems: [Expr], t: Token) : Expr =
  mk_expr(ESurface(SfSetLit(spread, elems)), t.line, t.col)

#[doc("A statement that opens with `.` and is nothing but the section.")]
pub fn stmt_is_bare_section(first: Token, s: Stmt) : Bool =
  tk_is(first.kind, TkDot) and match s {
    SExprStmt(e) -> match e.kind { ELambda(_, _) -> true _ -> false }
    _ -> false
  }

#[doc("""
IndexLhs ::= Ident ("." Ident)*  — used to reject call-LHS index
writes like `get_array()[0] := v`.
""")]
pub fn is_index_lhs_path(e: Expr) : Bool {
  match e.kind {
    EName(_) -> true
    ESym(_, _) -> true
    EField(base, _) -> is_index_lhs_path(base)
    _ -> false
  }
}

#[doc("""
A just-parsed literal `lo` becomes a `PRange` when `..` follows, else a
plain `PLit`. Both bounds must be Int/Char literals (a non-literal upper
bound is a parse error) so exhaustiveness stays decidable — the pattern
never carries an expression the checker would have to evaluate.
""")]
pub fn pat_lit_or_range(p: Parser, lo: Expr, t: Token) : PPat / Console {

  if p_at(p, TkDotDot) {
    match parse_range_bound(p_advance(p)) {
      None -> err_p(p_error_here(p, "range pattern bounds must be Int or Char literals"))
      Some(hi) -> ok_p(hi.p, mk_pat(PRange(lo, hi.e), t.line, t.col))
    }
  } else {
    ok_p(p, mk_pat(PLit(lo), t.line, t.col))
  }
}

fn parse_range_bound(p: Parser) : Option[RangeBound] / Console {

  let t = p_peek(p)
  if tk_is(t.kind, TkInt) {
    let span = tok_source(p.src, t)
    let e = mk_expr(mk_int_lit(decode_int(span), span), t.line, t.col)
    Some(RangeBound { p: p_advance(p), e: e })
  } else if tk_is(t.kind, TkChar) {
    let e = mk_expr(EChar(decode_char(tok_source(p.src, t))), t.line, t.col)
    Some(RangeBound { p: p_advance(p), e: e })
  } else if tk_is(t.kind, TkMinus) {
    let nxt = p_peek1(p)
    if tk_is(nxt.kind, TkInt) {
      let span = tok_source(p.src, nxt)
      let v = 0 - decode_int(span)
      Some(RangeBound { p: p_advance(p_advance(p)),
                        e: mk_expr(mk_int_lit(v, string_concat("-", span)), t.line, t.col) })
    } else {
      None
    }
  } else {
    None
  }
}

#[doc("Reports whether the parser is at a `matches` refinement sugar.")]
pub fn is_matches_sugar_start(p: Parser, t: Token) : Bool {
  if not tk_is(t.kind, TkIdent) { false }
  else if tok_source(p.src, t) != "matches" { false }
  else { refinement_matches_sugar_at(p_advance(p)) }
}

# True when the token after `matches` looks like the start of an
# expression argument (rather than `(` — which signals an explicit
# call — or `.` — a member access on a value named `matches`). Used
# to gate the `where matches <expr>` receiver-elision sugar.
fn refinement_matches_sugar_at(p: Parser) : Bool {
  let t = p_peek(p)
  if tk_is(t.kind, TkLparen) { false }
  else if tk_is(t.kind, TkDot) { false }
  else if tk_is(t.kind, TkRegex) { true }
  else if tk_is(t.kind, TkIdent) { true }
  else if tk_is(t.kind, TkString) { true }
  else { false }
}

#[doc("""
A row label is a plain *uppercase* name (`Stdout`) or a parameterised
effect (`Reader[Int]`). Convert the parsed `TypeExpr` form into the
`RowLabel` the row carries. A lowercase name is a row *variable*,
which may only be the last item in a row — so it is rejected as the
leading label of a compound row argument (`a + Stdout` is malformed,
matching the `parse_row_labels` discipline). A function/list/dim/
refine type in label position is also rejected.
""")]
pub fn te_as_row_label(te: TypeExpr) : Option[RowLabel] = match te.tkind {
  TyName(r, targs) -> match r {
    DrWritten(None, nm) -> if row_label_name_is_upper(written_text(nm)) { Some(RL(r, targs)) } else { None }
    _                   -> None
  }
  _ -> None
}

fn row_label_name_is_upper(s: String) : Bool = match char_at(s, 0) {
  Some(c) -> ch_is_upper(c)
  None    -> false
}

#[doc("""
Back-fill `ty` onto every pending name in a type group (Go/Pony-style
grouping: `fn foo(a, b: Int)` ≡ `fn foo(a: Int, b: Int)`). `names` is in
left-to-right reading order; prepending each yields the group in
reverse-reading order on top of `acc`, matching the caller's invariant
(acc is reversed once at the end). Every emitted Param is `Some(ty)`, so
the public-signature-fully-annotated invariant holds.
""")]
pub fn close_param_group(names: [PendName], ty: TypeExpr, acc: [Param]) : [Param] {
  match names {
    [] -> acc
    [pn, ...rest] ->
      close_param_group(rest, ty,
        [Param { binder: binder_written(pn.nm), ptype: Some(ty), pline: pn.nline, pcol: pn.ncol, pborrow: pn.pborrow }, ...acc])
  }
}

#[doc("""
Skip tokens until the matching `)` (the caller has already consumed the
opening `(` and `depth` starts at 1). Used by unknown-attribute parsing
to ignore arbitrary argument shapes. Bails on EOF.
""")]
pub fn skip_balanced_parens(p: Parser, depth: Int) : Parser {
  if depth <= 0 { p }
  else {
    let t = p_peek(p)
    if tk_is(t.kind, TkEof) { p }
    else if tk_is(t.kind, TkLparen) { skip_balanced_parens(p_advance(p), depth + 1) }
    else if tk_is(t.kind, TkRparen) { skip_balanced_parens(p_advance(p), depth - 1) }
    else { skip_balanced_parens(p_advance(p), depth) }
  }
}
