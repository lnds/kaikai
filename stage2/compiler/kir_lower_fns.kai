# compiler/kir_lower_fns.kai — function/program-level lowering: the
# entry point `lower_to_kir`, the per-decl fn walk, and the lifted
# `KFnLambda` / `KFnClause` generation (+ handler decls, install order).
#
# These drive ON `lower_expr` (in `kir_lower_walk.kai`) but `lower_expr`
# never calls back into them, so the import graph stays acyclic
# (`kir_lower_fns → kir_lower_walk → kir_lower`). Splitting them out of
# the Expr-SCC walk keeps each file within the quality-gate size cap
# (the walk is the mutual-recursion core; this file is the orchestration
# layer around it).

import compiler.ast
import compiler.written
import compiler.symtab
import compiler.decl_text
import compiler.spec_names
import compiler.local_names
import compiler.entry
import compiler.reuse_ctors
import compiler.home_tu
import compiler.util
import compiler.fnreg
import compiler.fn_index
import compiler.core_prims
import compiler.fn_csym
import compiler.emit_shared
import compiler.emit_reuse_donate
import compiler.ffi_v2
import compiler.region
import compiler.kir
import compiler.kir_lower
import compiler.ctor_ix
import compiler.unwind_pend
import compiler.unwind_effects
import compiler.unwind_cx
import compiler.kir_lower_walk
import compiler.rec_stamp
import compiler.infer.{is_lifecycle_clause}

# --- Top-level: lower the whole program --------------------------------

# Entry point (design §7 Lane 0). `raw_decls` is the post-perceus /
# post-tcrec `[Decl]`; `regions` the region-mark metadata. Produces a
# `KProgram` with everything resolved, so the translators resolve nothing
# (design §5).
pub fn lower_to_kir(raw_decls: [Decl], tab: SymTab, specs: SpecNames, ids: ProtoIds, regions: [RegionMark],
                    fns: [EFn], variants: [VariantEntry], target_origin: Option[String], raw_binders: [RawArmBinder],
                    traps: Bool, stamp_ids: [SymId], entry: SymId) : KProgram / Console {
  let ctors = ctor_ix_build(variants, raw_decls, tab, target_origin)
  let types = lower_types(raw_decls, tab, ctors, [])
  # The lifted-lambda table is the SAME analysis the emitters run
  # (`collect_decls` over the global-name set) — reused, not re-derived.
  let lc      = collect_decls(raw_decls, lc_new(tab, specs))
  let st0     = ls_with_unw(ls_new(fns, fnx_build_decls(raw_decls, fns), variants, ctors, lc.lams,
                                   kir_const_decls(raw_decls, []), ffi_extern_syms(raw_decls, []),
                                   collect_records(raw_decls), rec_stamps(raw_decls, stamp_ids), regions, raw_binders, target_origin,
                                   tab, specs),
                            kir_unw_root(unw_cx(raw_decls, lc.clauses), traps))
  # The extern-type registry classifies struct / opaque FFI types for
  # the native shim. Threaded explicitly to the FFI-fn lowering
  # (narrower than a LowerSt field).
  let freg    = collect_extern_types(raw_decls, tab)
  # Donation-capable fns — the SAME structural scan the C backend runs
  # (`emit_reuse_donate`), keyed on the mangled symbol, so both backends
  # pick one capable set and the reuse ABI cannot diverge between them.
  let capable = rd_scan_capable(raw_decls, tab, specs)
  let kfns    = lower_fns(raw_decls, st0, freg, capable, entry, [])
  # Each lifted lambda becomes a top-level `KFnLambda`, and each handler
  # clause a `KFnClause` (mirror of emit_c's `emit_lam_helpers` /
  # `emit_clause_bodies`), appended after the ordinary fns.
  let lamfns  = lower_lam_fns(lc.lams, st0, [])
  let clsfns  = lower_clause_fns(lc.clauses, lc.clauses, st0, [])
  # Each test / bench body becomes a runner `KFn` returning the block's
  # final boxed value (mirror of emit_c's `emit_test_fn` / `emit_bench_fn`,
  # minus the inline setjmp — the native runtime helper holds the landing
  # pad). The native `kai_main` driver calls them via the runner list; the
  # C-direct backend never reads either. `target_origin` rotates the EFn
  # table file-local exactly as the C emitters do (issue #335).
  let rs = lower_runner_decls(raw_decls, target_origin, st0, freg)
  KProgram { types: types,
             fns: list_append(kfns, list_append(lamfns, list_append(clsfns, rs.fns))),
             handlers: canon_handler_op_order(lower_handler_decls(lc.clauses, lc.clauses, []), raw_decls),
             install_order: kir_install_order(raw_decls, tab, entry),
             defaults: kir_default_handlers(raw_decls, tab, entry),
             runner_defaults: kir_runner_default_handlers(raw_decls, tab),
             synth_defaults: kir_synth_handler_effects(raw_decls, tab),
             regions: lower_regions(regions, []), runners: rs.runners, entry: entry, tab: tab, specs: specs, ids: ids,
             reuse_tags: reusable_tags(raw_decls, ids, ctors, entry) }
}

# The runner KFns + the KRunner index, built together so the emitted
# symbol and the index agree. `_kai_test_<i>` / `_kai_bench_<i>` are
# numbered per-kind in source order (the same scheme emit_c uses), so the
# native driver and any cross-backend reasoning name the same block.
pub type RunnerLower = { fns: [KFn], runners: [KRunner] }

fn runner_home(mo: Option[String]) : String = match mo { Some(m) -> m None -> "" }

fn lower_runner_decls(decls: [Decl], target_origin: Option[String],
                      st0: LowerSt, freg: [ExternTypeReg]) : RunnerLower / Console = {
  lower_runner_loop(decls, st0, freg, st0.fns, 0, 0, [], [])
}

# Walk the decls accumulating one runner KFn + KRunner per test/bench
# block. `ti`/`bi` are the per-kind counters. The runner sym is passed as
# the fn name with `mo = None`, so `c_sym` keeps it literal
# (`_kai_test_0`) and the native driver names the same symbol. A check
# body takes its `with` params as fn params; Perceus already made the body
# borrow them, so the runtime loop keeps ownership across iterations and
# shrink attempts.
fn lower_runner_loop(decls: [Decl], st: LowerSt, freg: [ExternTypeReg],
                     body_fns: [EFn], ti: Int, bi: Int,
                     fns_acc: [KFn], run_acc: [KRunner]) : RunnerLower / Console = match decls {
  [] -> RunnerLower { fns: list_reverse(fns_acc), runners: list_reverse(run_acc) }
  [d, ...rest] -> match d {
    DTest(desc, body, line, col, mo) -> {
      # The sym IS the runner enc_fn the lambda collector stamped on this
      # body's lambdas, so `find_lam` resolves a lambda inside the test
      # body (a bare `_kai_test_<i>` sym would leave it "non-callable").
      let sym = runner_enc_fn("test", mo, line, col)
      let kfn = lower_fn(FnHead { name: sym, usig: None, locals: ln_of_decl(d) }, [], None, None, body, None, body_fns, st, freg, false, false)
      let r = KRunner { sym: sym, desc: desc, kind: KRTest, line: line, home: runner_home(mo) }
      lower_runner_loop(rest, st, freg, body_fns, ti + 1, bi, [kfn, ...fns_acc], [r, ...run_acc])
    }
    DBench(desc, body, line, col, mo) -> {
      let sym = runner_enc_fn("bench", mo, line, col)
      let kfn = lower_fn(FnHead { name: sym, usig: None, locals: ln_of_decl(d) }, [], None, None, body, None, body_fns, st, freg, false, false)
      let r = KRunner { sym: sym, desc: desc, kind: KRBench, line: line, home: runner_home(mo) }
      lower_runner_loop(rest, st, freg, body_fns, ti, bi + 1, [kfn, ...fns_acc], [r, ...run_acc])
    }
    DCheck(desc, ps, body, line, col, mo) -> {
      let sym = runner_enc_fn("check", mo, line, col)
      let kfn = lower_fn(FnHead { name: sym, usig: None, locals: ln_of_decl(d) }, ps, None, None, body, None, body_fns, st, freg, false, false)
      let r = KRunner { sym: sym, desc: desc, kind: KRCheck(check_param_specs(st.tab, ps)), line: line, home: runner_home(mo) }
      lower_runner_loop(rest, st, freg, body_fns, ti, bi, [kfn, ...fns_acc], [r, ...run_acc])
    }
    _ -> lower_runner_loop(rest, st, freg, body_fns, ti, bi, fns_acc, run_acc)
  }
}

# `name:Type` per check param. The type label is the one the C oracle's
# generator panic names, so both backends reject an unsupported type alike.
fn check_param_specs(tab: SymTab, ps: [Param]) : [String] = match ps {
  [] -> []
  [p, ...rest] -> [concat_all([written_text(p.binder.name), ":", check_type_label(tab, p.ptype)]), ...check_param_specs(tab, rest)]
}

fn check_type_label(tab: SymTab, t: Option[TypeExpr]) : String = match t {
  None -> "<missing>"
  Some(ty) -> match ty.tkind {
    TyName(r, _) -> type_ref_label(tab, r)
    TyList(inner) -> match inner.tkind {
      TyName(r, _) -> concat_all(["[", type_ref_label(tab, r), "]"])
      _ -> "[<complex>]"
    }
    _ -> "<complex>"
  }
}

fn type_ref_label(tab: SymTab, r: DeclRef) : String = match r {
  DrSym(s)        -> written_text(decl_name(tab, s))
  DrWritten(_, n) -> written_text(n)
}

# --- Ordinary functions -------------------------------------------------

fn lower_fns(ds: [Decl], st: LowerSt, freg: [ExternTypeReg], capable: [String], entry: SymId, acc: [KFn]) : [KFn] / Console = match ds {
  [] -> list_reverse(acc)
  [d, ...rest] -> match d {
    DFn(_, fid, _, params, ret_ty, row, body, _, _, _) -> {
      # `home_tu(d)` is the fn's home TU (== its `mo` for a DFn); the
      # KFn carries it so the native partitioner reads the partition off
      # the KFn instead of re-deriving it.
      let mo = home_tu(d)
      let name = ls_fn_name(st, fid)
      # The entry point never takes the donor param: the runtime calls it
      # directly, outside the donor-aware call funnel.
      let ent = is_entry(entry, fid)
      let dn = not ent and rd_is_capable(c_sym(name, mo), capable)
      let head = FnHead { name: name, usig: fnx_ufn_sig_first(st.fx, fid), locals: ln_of_decl(d) }
      let kfn = lower_fn(head, params, ret_ty, Some(row), body, mo, st.fns, st, freg, dn, ent)
      lower_fns(rest, st, freg, capable, entry, [kfn, ...acc])
    }
    _ -> lower_fns(rest, st, freg, capable, entry, acc)
  }
}

# What `lower_fn` is told about the fn it lowers: the name it is emitted
# under, its unboxed signature, and its binders.
type FnHead = { name: String, usig: Option[UFnSig], locals: LocalNames }

# Lower one function to a KFn. Counters reset (Risk 2b); the enclosing-fn
# key is the fn's own symbol so nested lambdas resolve to their LamInfo.
# The body lowers into the entry block and whatever blocks the control
# flow forks off; the final value seals the last block with `KRet`.
fn lower_fn(head: FnHead, params: [Param], ret_ty: Option[TypeExpr], row: Option[RowExpr],
            body: Expr, mo: Option[String], body_fns: [EFn], st0: LowerSt, freg: [ExternTypeReg], dn: Bool, ent: Bool) : KFn / Console {
  let name = head.name
  let sym = c_sym(name, mo)
  # Enter WITH the EFn table already rotated to prefer `mo` (this fn's
  # module) by the cached `lower_fns` loop.
  let st1 = ls_enter_fn_with(st0, sym, param_regs(params, []), head.locals, body_fns)
  # P3 raw scalar params: resolve this fn's UFnSig (the classifier already
  # applied the no-tparams / no-FFI / no-effect-row gates and computed the
  # per-param `raw_mask`). A `Some(US(...))` lowers each raw param to its
  # scalar KSlot + a raw return slot, so the native backend declares an
  # `i64`/`f64`/`i1` signature instead of all-`ptr`. `None` (FFI shims,
  # proto dispatchers, effectful / generic fns) keeps the all-boxed shape.
  # The unbox pass reads the SAME mask (`ufn_param_env`), so the body's raw
  # param reads and these slots can never disagree.
  let usig = head.usig
  let st = kir_unw_enter(ls_with_unw(st1, unw_fn_frame(st1.unw, sym, row, unw_param_seeds(params, usig, st1.unw.ucx),
                                                        param_ids(params), body)))
  let kparams = lower_params_sig(params, usig)
  # An `extern "C" fn` (issue #260) lowers to a DFn whose body is the magic
  # `ETodo("__kai_ffi__"[:override])` tag. C / LLVM-text intercept it in
  # `emit_fn_body` and synthesise an unbox→extern-call→re-box shim from the
  # params + ret type — NOT from the body expr. The native path consumes
  # KIR, so the body would reach `lower_expr` and become a panic stub
  # (`panic: todo: __kai_ffi__`). Classify it HERE into a body-less
  # `KFnFfi`: the C-side symbol is resolved now (the issue #261 override
  # carved out of the tag via `ffi_extern_symbol_of`) and the marshalling
  # kinds are read from the AST types, so the native backend synthesises the
  # shim without re-parsing the tag (one resolver, not three — asu review).
  if body_is_ffi_extern(body) {
    # The kaikai-visible wrapper symbol is `kai_<c_sym>` (NOT the bare
    # `c_sym`): it must differ from the bare C symbol the shim calls, which
    # IS the kaikai identifier verbatim (`puts`, `abs`). The native backend
    # emits both into one module; sharing `@abs` made the wrapper recurse
    # into itself. The C / LLVM-text oracles `kai_`-prefix every symbol, so
    # they never clashed — this mangling brings the FFI wrapper into line
    # WITHOUT prefixing the whole native backend (a separate concern).
    let c_symbol = ffi_extern_symbol_of(body, name)
    KFn { sym: ffi_wrapper_sym(name, mo), kind: KFnFfi(c_symbol, ffi_param_kinds(params, freg, st.tab), kffi_kind_of_ret(ret_ty, freg, st.tab)),
          params: kparams, ret: slot_of_ty(ret_ty), blocks: [],
          region_id: None, stateful: false, mo: mo, donor: false, entry: false }
  } else {
    # A `__proto_<op>` dispatcher's body is an `ETodo` marker that the shared
    # lowering would otherwise reduce to a panic stub (the native path then
    # aborts every protocol call). C / LLVM-text re-emit the dispatcher's body
    # from the AST (`body_is_proto_dispatch`); the native path consumes KIR, so
    # we lower the marker to a real dispatch HERE — a boxed call to the runtime
    # `kaix_proto_dispatch<N>` shim, which derives the head tag, resolves the
    # impl table, and indirect-calls (one ABI source of truth, shared with the
    # oracle). C / LLVM never reach this branch (they intercept upstream).
    # The body lowers AT the return slot: a raw-return UFn must not pay a
    # box the `KRet` immediately unboxes back off (`lower_fn_body_at`).
    # A region-branded signature routes EVERY ctor in the body to the ambient
    # arena (`build_tree` / `tree_insert` bump-allocate their `Node(...)` in the
    # caller's arena even though the ctor sits outside the `region { }`). Same
    # signature-keyed predicate the C oracle reads via `params_have_region`.
    # The verdict rides `LowerSt.in_region` → each `KCon.in_region`; the `KFn`'s
    # own `region_id` stays `None` so a branded fn is still inline-eligible (the
    # ctor flag survives inline cloning pass-through, so routing does not depend
    # on the fn body staying un-inlined).
    let stb = if fn_has_region_brand(params, ret_ty) { ls_set_in_region(st, true) } else { st }
    let ret_slot = ret_slot_of_sig(usig)
    let r = if body_is_proto_dispatch(body) {
      lower_proto_dispatch(proto_dispatch_parts(body), params, kpos_of(body), stb)
    } else if is_some(body_kai_builtin(body)) { lower_kai_forwarder(body, name, params, stb) }
    else { lower_fn_body_at(body, ret_slot, stb) }
    match r {
      LRes(val, st1) -> KFn { sym: sym, kind: KFnNormal, params: kparams,
                              ret: ret_slot, blocks: ls_finish(st1, KRet(val, kpos_of(body))),
                              region_id: None, stateful: false, mo: mo, donor: dn, entry: ent }
    }
  }
}

# The fn a declared core builtin's declaration emits, so the builtin is a
# value through its thunk: it hands its owned params to the native entry.
fn lower_kai_forwarder(body: Expr, name: String, params: [Param], st: LowerSt) : LRes / Console =
  lower_direct_call(body, core_native_call_sym(name),
                    map(params, (p) => mk_local(p.binder.id, body.line, body.col)), st)

# The KIR FFI marshalling kind of each `extern "C" fn` param, in
# declaration order — the unbox direction the native shim applies before
# the raw call. Reuses emit_shared's type→`FfiRetKind` classifier (the
# typer's supported-FFI-type gate) and translates into the KIR's own
# `KFfiKind`, so kir.kai stays free of an emit_shared dependency (Lane 0).
fn ffi_param_kinds(params: [Param], freg: [ExternTypeReg], tab: SymTab) : [KFfiKind] = match params {
  []           -> []
  [p, ...rest] -> [kffi_kind_of_param(p, freg, tab), ...ffi_param_kinds(rest, freg, tab)]
}

fn kffi_kind_of_param(p: Param, freg: [ExternTypeReg], tab: SymTab) : KFfiKind = match p.ptype {
  None    -> KFfiUnknown("missing")
  Some(t) -> kffi_of_ret_kind(ffi_kind_of_ty_reg(t, freg, tab), freg, tab)
}

fn kffi_kind_of_ret(ret_ty: Option[TypeExpr], freg: [ExternTypeReg], tab: SymTab) : KFfiKind =
  kffi_of_ret_kind(ffi_ret_kind_of_reg(ret_ty, freg, tab), freg, tab)

# Translate emit_shared's `FfiRetKind` to the KIR-local `KFfiKind`. An
# opaque handle becomes `KFfiForeign`; a fixed-width annotation becomes
# `KFfiFixed(bits, signed, is_float)`; a struct resolves its fields from
# the registry into `KFfiStruct`. The native backend marshals all of
# them directly.
fn kffi_of_ret_kind(k: FfiRetKind, freg: [ExternTypeReg], tab: SymTab) : KFfiKind = match k {
  FfiRetUnit       -> KFfiUnit
  FfiRetInt        -> KFfiInt
  FfiRetReal       -> KFfiReal
  FfiRetBool       -> KFfiBool
  FfiRetChar       -> KFfiChar
  FfiRetString     -> KFfiString
  FfiRetForeign(_) -> KFfiForeign
  FfiRetFixed(fx)  -> KFfiFixed(ffi_fixed_bits(fx), ffi_fixed_is_signed(fx), ffi_fixed_is_float(fx))
  FfiRetFixedVal(t) -> kffi_of_fixed_val(t)
  FfiRetStruct(n)  -> KFfiStruct(kffi_struct_fields(extern_struct_fields(freg, n), freg, tab))
  FfiRetUnknown(t) -> KFfiUnknown(t)
}

# Native FFI marshalling kind for an honest fixed-width VALUE type. The
# box already carries the exact width (KAI_INT32/...), so it crosses as a
# `KFfiFixedVal` whose shim reads the width field directly instead of the
# `kai_intf` path the legacy `KFfiFixed` (Int-boxed annotation) uses.
fn kffi_of_fixed_val(t: Ty) : KFfiKind = match t {
  TyInt32  -> KFfiFixedVal(32, true)
  TyUInt32 -> KFfiFixedVal(32, false)
  TyUInt64 -> KFfiFixedVal(64, false)
  _        -> KFfiUnknown("Int128 across the FFI boundary is not supported")
}

# Resolve each declared struct field into a `KFfiField` carrying its
# marshalling kind (recursively, for nested structs).
fn kffi_struct_fields(fields: [FieldDecl], freg: [ExternTypeReg], tab: SymTab) : [KFfiField] = match fields {
  []            -> []
  [fd, ...rest] -> match fd {
    FD(_, fname, fty, _) ->
      [KFF(fname, kffi_of_ret_kind(ffi_kind_of_ty_reg(fty, freg, tab), freg, tab)),
       ...kffi_struct_fields(rest, freg, tab)]
  }
}

# Every `extern "C" fn` declaration (a DFn whose body is the magic FFI
# tag). Seeds `LowerSt.ffi`, the set a call site consults to decide whether
# to mangle the callee.
pub fn ffi_extern_syms(ds: [Decl], acc: [SymId]) : [SymId] = match ds {
  [] -> list_reverse(acc)
  [d, ...rest] -> match d {
    DFn(_, fid, _, _, _, _, body, _, _, _) ->
      if body_is_ffi_extern(body) { ffi_extern_syms(rest, [fnid_sym(fid), ...acc]) }
      else { ffi_extern_syms(rest, acc) }
    _ -> ffi_extern_syms(rest, acc)
  }
}

# Lower a protocol dispatcher body to a boxed call to the runtime dispatch
# shim. The shim takes the proto id (boxed Int), the proto + op names (boxed
# Strings, for the no-impl panic message) and the op's args; it derives the
# receiver's head tag, resolves `kai_lookup_impl`, and indirect-calls the
# impl (mirror of `emit_proto_dispatch_shim_c`). An arity-0 op (`Default.
# default`) has no receiver to dispatch on — the monomorphiser is meant to
# have pinned `Self`; reaching the body is an unresolved-call bug, so we keep
# the loud panic stub the oracle also emits.
fn lower_proto_dispatch(parts: ProtoDispatchParts, params: [Param],
                        pos: KPos, st: LowerSt) : LRes / Console = match parts {
  PDP(pname, opname) -> {
    let arity = list_length(params)
    if arity == 0 {
      lower_panic_stub(kir_quote(concat_all(["no impl of ", pname, ".", opname,
        " for runtime head (arity 0 op: caller must annotate Self)"])), st)
    } else {
      let shim = cat2("kaix_proto_dispatch", int_to_string(arity))
      let args = [KIntV(pdp_proto_id_int(parts)), KIntV(pdp_op_id_int(parts)),
                  KStrV(kir_quote(pname)), KStrV(kir_quote(opname)), ...proto_dispatch_arg_vals(params)]
      bind_op(st, KCall(shim, args), pos)
    }
  }
}

# The dispatcher's params as `KVar` atoms in declaration order (the op's
# receiver first), the boxed args the shim forwards to the resolved impl.
fn proto_dispatch_arg_vals(params: [Param]) : [KVal] = match params {
  []           -> []
  [p, ...rest] -> [KVar(written_text(p.binder.name)), ...proto_dispatch_arg_vals(rest)]
}

# --- Lambdas: lifted bodies as top-level `KFnLambda`s -------------------

# One `KFnLambda` per lifted lambda. Its params are the lambda's own
# params (`PDirect`) plus its captures (`PCapture`, read from `self`);
# the body lowers with the lambda's id as the enclosing-fn key so a
# nested lambda resolves to ITS LamInfo (mirror of emit_c's
# `lam_symbol` enc_fn). Same body shape as a normal fn — only the
# `kind` + param origins differ (asu review).
fn lower_lam_fns(lams: [LamInfo], st0: LowerSt, acc: [KFn]) : [KFn] / Console = match lams {
  [] -> acc
  [l, ...rest] -> {
    lower_lam_fns(rest, st0, list_append(acc, [lower_lam_fn(l, st0, st0.fns)]))
  }
}

fn lower_lam_fn(l: LamInfo, st0: LowerSt, body_fns: [EFn]) : KFn / Console = match l {
  LamInfo(_, _, _, _, params, caps, body, _) -> {
    let sym = lam_symbol(l)
    let locals = kir_body_locals(lam_locals(l))
    let pids = param_ids(params)
    let st = kir_unw_enter(ls_with_unw(ls_enter_fn_with(st0, sym, param_regs(params, capture_names(caps, locals)), locals, body_fns),
                                       unw_frame(st0.unw, pids, pids, body)))
    let kparams = list_append(lower_params(params, []), lower_captures(caps, locals, 0, []))
    match lower_expr(body, st) { LRes(val, st1) -> {
      # Each param is owned per-invocation yet the closure body only DUPs
      # its reads (`in_lam` forces a dup on every read), so the birth ref
      # is never consumed and leaks one box per call. Drop it after the
      # body computes `val`. Captures are NOT dropped: the closure owns
      # them (released in its destructor); a per-call drop would UAF after
      # the first invocation. All lambda params are `SBoxed` (`lower_params`).
      let st2 = lam_drop_params(params, st1)
      KFn { sym: sym, kind: KFnLambda, params: kparams, ret: SBoxed,
            blocks: ls_finish(st2, KRet(val, kpos_of(body))), region_id: None,
            stateful: false, mo: None, donor: false, entry: false } } }
  }
}

fn lam_drop_params(params: [Param], st: LowerSt) : LowerSt / Console = match params {
  []           -> st
  [p, ...rest] -> lam_drop_params(rest, ls_emit(st, KRC(KDrop(KVar(written_text(p.binder.name))), KNoPos)))
}

# Each capture becomes a `PCapture(j)` param read from `self->as.clo`
# at the matching index (the order the collector recorded in the lambda's
# own caps list). Lambda-only — a clause uses `lower_env_captures`.
fn lower_captures(caps: [Capture], locals: LocalNames, j: Int, acc: [KParam]) : [KParam] = match caps {
  [] -> acc
  [c, ...rest] -> lower_captures(rest, locals, j + 1, list_append(acc, [capture_param(kir_capture_name(locals, c), j)]))
}

# The registers a lambda or clause reads its captures from, in capture order.
fn capture_names(caps: [Capture], locals: LocalNames) : [String] = map(caps, (c) => kir_capture_name(locals, c))

# A clause's captures become `PEnvCapture(j)` params, where `j` is the
# capture's index in the HANDLE's cross-clause union (`env_caps`), NOT in
# the clause's own caps list. The Ev `env` array the install fills is
# laid out in union order, shared by every clause of the handle, so a
# clause that captures a subset must still index by the union position.
# `caps` are the clause's own capture registers; `env_caps` the handle
# union (resolved for the INDEX).
fn lower_env_captures(caps: [String], env_caps: [String], acc: [KParam]) : [KParam] / Console = match caps {
  [] -> acc
  [c, ...rest] -> {
    let j = list_index_of_str(env_caps, c, 0)
    # The clause's caps are a subset of the handle union by construction
    # (`kir_merge_str_set` unions every clause's caps), so a miss is a
    # lowering invariant break — fail loud rather than emit `PEnvCapture(-1)`
    # (an out-of-bounds env read the backend would silently corrupt on).
    let _ = if j < 0 { eprint(cat2("kir: clause capture not in handle union: ", c)) } else { () }
    lower_env_captures(rest, env_caps, list_append(acc, [env_capture_param(c, j)]))
  }
}

# A `PEnvCapture(j)` param: a boxed cell the clause prologue borrows from
# `self->env[j]`, the same contract as a lambda capture — Perceus dups
# every read and the enclosing scope releases it.
fn env_capture_param(name: String, j: Int) : KParam =
  KParam { name: name, slot: SBoxed, mode: KBorrow, origin: PEnvCapture(j) }

# Index of `s` in `xs`, or -1 if absent. Local mirror to keep this off
# the util import surface (the clause caps are always a subset of the
# handle union, so the -1 is a should-not-happen defensive fallback).
fn list_index_of_str(xs: [String], s: String, i: Int) : Int = match xs {
  [] -> 0 - 1
  [h, ...rest] -> if h == s { i } else { list_index_of_str(rest, s, i + 1) }
}

# The cross-clause union of every clause's captures for the handle pinned
# at (enc_fn, line, col) — mirror of emit_c's `handle_captures_at`. The
# enclosing fn is part of the key: position alone merges the captures of
# two unrelated handles that happen to share a line and column. Stable
# "first-occurrence-wins" order, shared by the install (env fill) and the
# clause prologue (env index) so both agree by construction.
fn kir_handle_captures_at(cls: [ClauseInfo], enc: String, hline: Int, hcol: Int) : [String] = match cls {
  [] -> []
  [c, ...rest] -> match c {
    CI(line, col, _, _, _, _, _, enc_fn, caps, _, _) ->
      if line == hline and col == hcol and enc_fn == enc {
        kir_merge_str_set(capture_names(caps, kir_body_locals(clause_locals(c))), kir_handle_captures_at(rest, enc, hline, hcol))
      } else {
        kir_handle_captures_at(rest, enc, hline, hcol)
      }
  }
}

# Stable-order union of two string lists (mirror of emit_c's
# `merge_string_set`): every element of `a` not already in `b`, prepended
# in order, then `b`. Field order MUST match across install/read.
fn kir_merge_str_set(a: [String], b: [String]) : [String] = match a {
  [] -> b
  [h, ...rest] ->
    if list_has(b, h) { kir_merge_str_set(rest, b) }
    else { [h, ...kir_merge_str_set(rest, b)] }
}

# The registers a fn/lambda/clause binds at entry — its params' on top of
# its captures'. Seeded into `LowerSt.regs`; match binders / `let`s extend
# the set further as the body lowers.
fn param_regs(params: [Param], acc: [String]) : [String] = match params {
  [] -> acc
  [p, ...rest] -> param_regs(rest, [written_text(p.binder.name), ...acc])
}

fn param_ids(params: [Param]) : [LocalId] = map(params, (p) => p.binder.id)

# --- Clauses: lifted bodies as top-level `KFnClause`s -------------------

# One `KFnClause` per handler clause. Params = the clause's args
# (`PDirect`), the trailing `resume` continuation (`PResume`, used by the
# body so it enters Perceus one-shot analysis), and the captures
# (`PEnvCapture`, read from the Ev `env` array at the handle-union index).
# The body lowers under the clause's own symbol, the scoping key of the
# lambdas and handles nested in it.
# `all_cls` is the whole program's clause list (threaded so each clause
# can resolve its handle's cross-clause capture union).
fn lower_clause_fns(clauses: [ClauseInfo], all_cls: [ClauseInfo], st0: LowerSt, acc: [KFn]) : [KFn] / Console = match clauses {
  [] -> acc
  [c, ...rest] -> {
    lower_clause_fns(rest, all_cls, st0, list_append(acc, [lower_clause_fn(c, all_cls, st0, st0.fns)]))
  }
}

fn lower_clause_fn(c: ClauseInfo, all_cls: [ClauseInfo], st0: LowerSt, body_fns: [EFn]) : KFn / Console = match c {
  CI(line, col, _, head, params, body, stateful, enc_fn, caps, _, _) -> {
    let is_fin = is_lifecycle_clause(head)
    let sym = clause_sym(c)
    let locals = kir_body_locals(clause_locals(c))
    let cnames = capture_names(caps, locals)
    let owned = if is_fin { [] } else { unw_clause_seeds(c) }
    let st = kir_unw_enter(ls_with_unw(ls_enter_fn_with(st0, sym, param_regs(params, cnames), locals, body_fns),
                                       unw_frame(st0.unw, owned, owned, body)))
    # `PEnvCapture(j)` indexes the handle UNION, not the clause's own caps.
    let env_caps = kir_handle_captures_at(all_cls, enc_fn, line, col)
    # A `finally` has no surface params and never resumes: captures only.
    let own_params = if is_fin { [] } else { lower_clause_params(params) }
    let kparams = list_append(own_params, lower_env_captures(cnames, env_caps, []))
    match lower_expr(body, if stateful { bind_self_state(st) } else { st }) { LRes(val, st1) -> {
      let blocks = ls_finish(st1, KRet(val, kpos_of(body)))
      check_resume_one_shot(sym, blocks)
      KFn { sym: sym, kind: if is_fin { KFnCleanup } else { KFnClause },
            params: kparams, ret: SBoxed,
            blocks: blocks, region_id: None, stateful: stateful, mo: None, donor: false, entry: false }
    } }
  }
}

# A clause's surface params: all but the last are ordinary args
# (`PDirect`); the last is the `resume` continuation (`PResume`).
fn lower_clause_params(params: [Param]) : [KParam] = {
  let n = list_length(params)
  lower_clause_params_idx(params, 0, n, [])
}

fn lower_clause_params_idx(params: [Param], i: Int, n: Int, acc: [KParam]) : [KParam] = match params {
  [] -> acc
  [p, ...rest] -> {
    let origin = if i == n - 1 { PResume } else { PDirect(i) }
    lower_clause_params_idx(rest, i + 1, n, list_append(acc, [KParam { name: written_text(p.binder.name), slot: SBoxed, mode: kparam_mode(p), origin: origin }]))
  }
}

# --- Handler decls + one-shot resume check ------------------------------

# Canonicalise op-thunk layout so the Ev field index of an op is intrinsic
# to the EFFECT, not to a particular handler. A `KPerform` resolves an op's
# field statically from one handler decl of the effect, but derefs whichever
# node the fiber carries at runtime — any other handler of the same effect, or
# its default node. A DEFAULT-carrying effect's handlers take the default-block
# order, omitted ops filled with the default forwarder; every other handler
# takes the effect's declaration order (the C backend's `Ev` struct layout).
fn canon_handler_op_order(hs: [KHandlerDecl], decls: [Decl]) : [KHandlerDecl] = match hs {
  [] -> []
  [h, ...rest] -> [canon_one_handler(h, decls), ...canon_handler_op_order(rest, decls)]
}

# The default block is the one of the declaration the handler handles. It
# orders the handler only when it covers the handler's ops; otherwise the
# handler is laid out by the effect's declaration.
fn canon_one_handler(h: KHandlerDecl, decls: [Decl]) : KHandlerDecl =
  match kir_default_of_decl(h.eff_sym, decls) {
    None     -> canon_decl_order(h, decls)
    Some(kd) -> match kd {
      KDef(_, defops) ->
        if op_thunks_covered_by(h.op_thunks, defops) {
          KHandlerDecl { ...h, op_thunks: reorder_op_thunks(defops, h.op_thunks) }
        } else { canon_decl_order(h, decls) }
    }
  }

# The typer rejects a handler that omits an op, so a handler of the effect is
# a permutation of its declared ops; a decl it is not a permutation of belongs
# to a homonym and leaves the handler as written.
fn canon_decl_order(h: KHandlerDecl, decls: [Decl]) : KHandlerDecl =
  match find_effect_ops(h, decls) {
    None      -> h
    Some(ops) ->
      if op_thunks_covered_by(h.op_thunks, ops) and defops_handled_by(ops, h.op_thunks) {
        KHandlerDecl { ...h, op_thunks: reorder_op_thunks(ops, h.op_thunks) }
      } else { h }
  }

# The handled effect's ops as `KDefOp`s in declaration order.
fn find_effect_ops(h: KHandlerDecl, decls: [Decl]) : Option[[KDefOp]] = match decls {
  [] -> None
  [d, ...rest] -> match d {
    DEffect(_, esym, _, ops, _, _, _, _) ->
      if effect_decl_matches(h, esym) { Some(decl_op_names(ops)) }
      else { find_effect_ops(h, rest) }
    _ -> find_effect_ops(h, rest)
  }
}

fn defops_handled_by(ops: [KDefOp], thunks: [KOpThunk]) : Bool = match ops {
  []                     -> true
  [KDOp(op, _, _), ...rest] -> match find_op_thunk(thunks, op) {
    None    -> false
    Some(_) -> defops_handled_by(rest, thunks)
  }
}

fn effect_decl_matches(h: KHandlerDecl, esym: SymId) : Bool =
  sym_raw(h.eff_sym) >= 0 and sym_raw(h.eff_sym) == sym_raw(esym)

fn decl_op_names(ops: [EffectOp]) : [KDefOp] = match ops {
  [] -> []
  [EffOp(op, _, ps, _, _, _), ...rest] -> [KDOp(op, "", list_length(ps) + 2), ...decl_op_names(rest)]
}

# True when every op the handler provides appears in `defops` (the resolved
# default block's op set) — the guard that a name-resolved default belongs to
# the same effect the handler handles.
fn op_thunks_covered_by(thunks: [KOpThunk], defops: [KDefOp]) : Bool = match thunks {
  []                    -> true
  [KOT(nm, _, _), ...rest] -> match find_defop(defops, nm) {
    None    -> false
    Some(_) -> op_thunks_covered_by(rest, defops)
  }
}

fn find_defop(defops: [KDefOp], op: String) : Option[KDefOp] = match defops {
  []                          -> None
  [KDOp(nm, sym, n), ...rest] -> if nm == op { Some(KDOp(nm, sym, n)) } else { find_defop(rest, op) }
}

# The handler's op-thunks in default-block (declaration) order. An op the
# handler provides keeps its clause thunk; an op it omits is filled with the
# effect's default forwarder, so the field index of every op equals its
# declaration position on BOTH the handler and the default node. Zero drop —
# the list is exactly as long as the effect's op set.
fn reorder_op_thunks(defops: [KDefOp], thunks: [KOpThunk]) : [KOpThunk] = match defops {
  []                        -> []
  [KDOp(op, dsym, n), ...rest] -> match find_op_thunk(thunks, op) {
    None    -> [KOT(op, dsym, n), ...reorder_op_thunks(rest, thunks)]
    Some(t) -> [t, ...reorder_op_thunks(rest, thunks)]
  }
}

fn find_op_thunk(thunks: [KOpThunk], op: String) : Option[KOpThunk] = match thunks {
  []                      -> None
  [KOT(nm, sym, n), ...rest] -> if nm == op { Some(KOT(nm, sym, n)) } else { find_op_thunk(rest, op) }
}

# One `KHandlerDecl` per (effect, handler-site) the clauses belong to.
# Groups clauses by their (line, col) handler key, mapping each op to its
# clause-thunk symbol so a `KInstall` resolves the right clause set. Each
# decl carries `env_caps` (the handle's cross-clause capture union) so the
# native install fills the Ev `env` array in the order the clause prologue
# (`PEnvCapture`) indexes. `all_cls` is the whole program's clause list
# (the union must see every clause of the handle, not just the head).
fn lower_handler_decls(clauses: [ClauseInfo], all_cls: [ClauseInfo], acc: [KHandlerDecl]) : [KHandlerDecl] = match clauses {
  [] -> acc
  [CI(line, col, _, head, _, _, _, enc_fn, _, _, esym), ...rest] ->
    # `finally` carries no Ev field — it is armed on the evidence node, not
    # stored as an op thunk — so it never joins `op_thunks`.
    if is_lifecycle_clause(head) {
      lower_handler_decls(rest, all_cls, acc)
    } else {
      let op = clause_head_word(head)
      let sym = user_handler_sym(enc_fn, line, col)
      let ot  = KOT(op, user_clause_sym(enc_fn, line, col, op), 0)
      let ecaps = kir_handle_captures_at(all_cls, enc_fn, line, col)
      lower_handler_decls(rest, all_cls, hdecl_add(acc, esym, sym, ot, ecaps))
    }
}

# Add an op-thunk to the matching handler decl, or create the decl. The
# `env_caps` of the first clause that opens the decl wins (all clauses of
# one handle resolve the same union, so later ops carry the same list).
fn hdecl_add(acc: [KHandlerDecl], esym: SymId, sym: String, ot: KOpThunk, ecaps: [String]) : [KHandlerDecl] = match acc {
  [] -> [KHandlerDecl { eff_sym: esym, sym: sym, op_thunks: [ot], ret_thunk: None, env_caps: ecaps }]
  [h, ...rest] ->
    if h.sym == sym { [KHandlerDecl { ...h, op_thunks: list_append(h.op_thunks, [ot]) }, ...rest] }
    else { [h, ...hdecl_add(rest, esym, sym, ot, ecaps)] }
}


# One-shot resume is PINNED (design decision): a clause must not resume
# the continuation more than once on any path. A `resume` is now a
# `KResumeOp`/`KResume2Op` STATEMENT (an expression-call, mirror of the
# C-direct oracle), so a LINEAR multi-resume (`let _ = resume(()) resume(())`)
# is left to the runtime one-shot check (`kai_cont_resume` aborts on the
# second), which is EXACTLY what the oracle does — the m7a #6d parity gap.
# The structural check stays only for the shape the runtime cannot phrase as
# helpfully: a resume reachable via a BACK-EDGE (a loop re-entering a block
# that already resumed). Flag a clause that has BOTH a resume op and a
# loop-forming terminator (loud, not silent).
fn check_resume_one_shot(sym: String, blocks: [KBlock]) : Unit / Console =
  if resume_count(blocks, 0) > 1 and blocks_have_backedge(blocks) {
    eprint(concat_all(["kir: one-shot resume violation in clause ", sym,
                       " (resume reachable more than once)"]))
  } else { () }

# Count `resume` ops across every block's statements (a resume is no longer a
# terminator). A `KResumeOp`/`KResume2Op` only appears as a `KLet`/`KDo` RHS.
fn resume_count(blocks: [KBlock], acc: Int) : Int = match blocks {
  [] -> acc
  [b, ...rest] -> resume_count(rest, acc + stmts_resume_count(b.stmts, 0))
}

fn stmts_resume_count(stmts: [KStmt], acc: Int) : Int = match stmts {
  [] -> acc
  [s, ...rest] -> stmts_resume_count(rest, acc + stmt_is_resume(s))
}

fn stmt_is_resume(s: KStmt) : Int = match s {
  KLet(_, _, op, _) -> op_is_resume(op)
  KDo(op, _)        -> op_is_resume(op)
  _                 -> 0
}

fn op_is_resume(op: KOp) : Int = match op {
  KResumeOp(_, _)     -> 1
  KResume2Op(_, _, _) -> 1
  _                   -> 0
}

# A back-edge is a tcrec/trmc goto (the only loop-forming terminators the
# lowering emits); a plain `KBr` always targets a forward continuation.
fn blocks_have_backedge(blocks: [KBlock]) : Bool = match blocks {
  [] -> false
  [b, ...rest] -> match b.term {
    KTcrecGoto(_, _, _, _)            -> true
    KTrmcStep(_, _, _, _, _, _, _, _, _, _) -> true
    _                                 -> blocks_have_backedge(rest)
  }
}

# The native backend asks for landing pads; `--emit=kir` shows the brackets alone.
fn kir_unw_root(ucx: UnwCx, traps: Bool) : UnwFrame =
  if traps { unw_with_traps(unw_frame_none(ucx)) } else { unw_frame_none(ucx) }
