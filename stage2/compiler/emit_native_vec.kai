#[doc("""
Native vector lowering: dynamic vec prims and fixed-width vec aggregates.

Native codegen for the fused `Vec` prims (kir_lower_vec): each is one call to a runtime entry, raw scalars in and, but for the boxed field read, out.

Native (libLLVM) inline codegen for a fixed-width `Vec[t]<n>` — a flat, header-less `[n x elem]` aggregate, no dynamic `Vec`.

The runtime entry owns the buffer layout and every guard; this module only
marshals. A record write passes its fields as a stack `[n x i64]` plus the
kind string and (push only) the field names the first push classifies with.

The KIR lowering plants a `KpFixedVecLit` handle binder and a
`KpFixedVecGet` read (kir_lower_walk). This module turns them into IR:
the literal allocas an `[n x elem]` array and stores each
element raw (returning the array pointer, the header-less value); the read
GEPs the static element and re-boxes it. No `vec_reserve`/`vec_push`/
`vec_get` — mirroring the C backend's inline `KaiFixedVec_<elem>_<n>`.

HAZARD (#923): an LLVM `Type*`/`Value*` handle must never live in a `let`
binder unless its RHS is a native-prim call (kaic1 excludes only those from
the type-blind RC regime — a kaikai-fn result in a binder gets refcounted
and corrupts the raw pointer). So an element-type handle (`nfixed_elem_ty`,
a plain fn) is only ever passed INLINE as a prim-call argument, never bound;
an `arrty` from `llvm_array_type` (a prim call) is safe to bind. The
`[n x elem]` type is rebuilt on demand (LLVM dedups, so write and read
agree). Perceus already left the fixed-vec binder hands-off.
""")]

import compiler.emit_native_fn
import compiler.kir
import compiler.kir_syms
import compiler.util

#[doc("Emit a fused Vec prim: a read yields its payload, a write the result vec.")]
pub fn nemit_vec_raw_prim(ctx: Handle, p: PrimOp, cargs: [KVal]) : Handle / Console = match p {
  KpVecReadField(VbInt)  -> nvec_read_field(ctx, "kaix_vec_field_i64", SInt64, cargs)
  KpVecReadField(VbReal) -> nvec_read_field(ctx, "kaix_vec_field_f64", SReal, cargs)
  KpVecReadFieldBoxed    -> nvec_read_field_boxed(ctx, cargs)
  KpVecRead(VbInt)       -> nvec_read(ctx, "kaix_vec_get_i64", SInt64, cargs)
  KpVecRead(VbReal)      -> nvec_read(ctx, "kaix_vec_get_f64", SReal, cargs)
  KpVecPushRec           -> nvec_push_rec(ctx, cargs)
  KpVecSetRec            -> nvec_set_rec(ctx, cargs)
  KpVecPush(VbInt)       -> nvec_push(ctx, "kaix_vec_push_i64", SInt64, cargs)
  KpVecPush(VbReal)      -> nvec_push(ctx, "kaix_vec_push_f64", SReal, cargs)
  KpVecSet(VbInt)        -> nvec_set(ctx, "kaix_vec_set_i64", SInt64, cargs)
  KpVecSet(VbReal)       -> nvec_set(ctx, "kaix_vec_set_f64", SReal, cargs)
  _                      -> nvec_bad(ctx, kprim_text(p))
}

fn nvec_bad(ctx: Handle, what: String) : Handle / Console = {
  nemit_unsupported(ctx, cat2("malformed bare-word vec prim ", what))
  nemit_null(ctx)
}

fn nvec_ty(ctx: Handle, slot: KSlot) : Handle = match slot {
  SReal -> native_ctx_f64t(ctx)
  _     -> native_ctx_i64t(ctx)
}

# `sym(ptr vec, i64 i, i32 fidx, i32 n, i32 owned) -> i64 | double`.
fn nvec_read_field(ctx: Handle, sym: String, slot: KSlot, cargs: [KVal]) : Handle / Console = match cargs {
  [v, i, KIntV(fidx), KIntV(n), KIntV(owned)] -> {
    let i32t = native_ctx_i32t(ctx)
    let vh = nemit_atom(ctx, v)
    let ih = nemit_atom_raw(ctx, i, SInt64)
    let ptb = llvm_buf_new(); llvm_buf_push(ptb, native_ctx_ptrt(ctx)); llvm_buf_push(ptb, native_ctx_i64t(ctx)); llvm_buf_push(ptb, i32t); llvm_buf_push(ptb, i32t); llvm_buf_push(ptb, i32t)
    let ab = llvm_buf_new(); llvm_buf_push(ab, vh); llvm_buf_push(ab, ih); llvm_buf_push(ab, llvm_const_i32(i32t, fidx)); llvm_buf_push(ab, llvm_const_i32(i32t, n)); llvm_buf_push(ab, llvm_const_i32(i32t, owned))
    ncall_finish(ctx, sym, nvec_ty(ctx, slot), ptb, ab)
  }
  _ -> nvec_bad(ctx, sym)
}

# `kaix_vec_field_boxed(ptr vec, i64 i, i32 fidx, i32 owned) -> ptr`.
fn nvec_read_field_boxed(ctx: Handle, cargs: [KVal]) : Handle / Console = match cargs {
  [v, i, KIntV(fidx), KIntV(owned)] -> {
    let p = native_ctx_ptrt(ctx)
    let i32t = native_ctx_i32t(ctx)
    let vh = nemit_atom(ctx, v)
    let ih = nemit_atom_raw(ctx, i, SInt64)
    ncall_sig4(ctx, "kaix_vec_field_boxed", p, p, native_ctx_i64t(ctx), i32t, i32t, vh, ih, llvm_const_i32(i32t, fidx), llvm_const_i32(i32t, owned))
  }
  _ -> nvec_bad(ctx, "vec.read.field.boxed")
}

# `sym(ptr vec, i64 i, i32 owned) -> i64 | double`.
fn nvec_read(ctx: Handle, sym: String, slot: KSlot, cargs: [KVal]) : Handle / Console = match cargs {
  [v, i, KIntV(owned)] -> {
    let i32t = native_ctx_i32t(ctx)
    let vh = nemit_atom(ctx, v)
    let ih = nemit_atom_raw(ctx, i, SInt64)
    ncall_sig3(ctx, sym, nvec_ty(ctx, slot), native_ctx_ptrt(ctx), native_ctx_i64t(ctx), i32t, vh, ih, llvm_const_i32(i32t, owned))
  }
  _ -> nvec_bad(ctx, sym)
}

# `sym(ptr vec, i64 | double x) -> ptr`.
fn nvec_push(ctx: Handle, sym: String, slot: KSlot, cargs: [KVal]) : Handle / Console = match cargs {
  [v, x] -> {
    let vh = nemit_atom(ctx, v)
    let xh = nemit_atom_raw(ctx, x, slot)
    ncall_sig2(ctx, sym, native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), nvec_ty(ctx, slot), vh, xh)
  }
  _ -> nvec_bad(ctx, sym)
}

# `sym(ptr vec, i64 i, i64 | double x) -> ptr`.
fn nvec_set(ctx: Handle, sym: String, slot: KSlot, cargs: [KVal]) : Handle / Console = match cargs {
  [v, i, x] -> {
    let p = native_ctx_ptrt(ctx)
    let vh = nemit_atom(ctx, v)
    let ih = nemit_atom_raw(ctx, i, SInt64)
    let xh = nemit_atom_raw(ctx, x, slot)
    ncall_sig3(ctx, sym, p, p, native_ctx_i64t(ctx), nvec_ty(ctx, slot), vh, ih, xh)
  }
  _ -> nvec_bad(ctx, sym)
}

# `kaix_vec_push_rec_bits(ptr vec, i64 n, ptr bits, ptr kinds, ptr names) -> ptr`
# over `[v, kinds, (value, name)...]`.
fn nvec_push_rec(ctx: Handle, cargs: [KVal]) : Handle / Console = match cargs {
  [v, KStrV(kinds), ...pairs] -> {
    let p = native_ctx_ptrt(ctx)
    let i64t = native_ctx_i64t(ctx)
    let vh = nemit_atom(ctx, v)
    let bits = nvec_bits_array(ctx, kinds, nvec_evens(pairs))
    let names = nvec_names_array(ctx, nvec_evens(nvec_tail(pairs)))
    let kh = llvm_build_global_string(native_ctx_b(ctx), kinds)
    let ptb = llvm_buf_new(); llvm_buf_push(ptb, p); llvm_buf_push(ptb, i64t); llvm_buf_push(ptb, p); llvm_buf_push(ptb, p); llvm_buf_push(ptb, p)
    let ab = llvm_buf_new(); llvm_buf_push(ab, vh); llvm_buf_push(ab, llvm_const_int(i64t, string_length(kinds))); llvm_buf_push(ab, bits); llvm_buf_push(ab, kh); llvm_buf_push(ab, names)
    ncall_finish(ctx, "kaix_vec_push_rec_bits", p, ptb, ab)
  }
  _ -> nvec_bad(ctx, "vec.write.push.rec")
}

# `kaix_vec_set_rec_bits(ptr vec, i64 i, i64 n, ptr bits, ptr kinds) -> ptr`
# over `[v, i, kinds, value...]`.
fn nvec_set_rec(ctx: Handle, cargs: [KVal]) : Handle / Console = match cargs {
  [v, i, KStrV(kinds), ...vals] -> {
    let p = native_ctx_ptrt(ctx)
    let i64t = native_ctx_i64t(ctx)
    let vh = nemit_atom(ctx, v)
    let ih = nemit_atom_raw(ctx, i, SInt64)
    let bits = nvec_bits_array(ctx, kinds, vals)
    let kh = llvm_build_global_string(native_ctx_b(ctx), kinds)
    let ptb = llvm_buf_new(); llvm_buf_push(ptb, p); llvm_buf_push(ptb, i64t); llvm_buf_push(ptb, i64t); llvm_buf_push(ptb, p); llvm_buf_push(ptb, p)
    let ab = llvm_buf_new(); llvm_buf_push(ab, vh); llvm_buf_push(ab, ih); llvm_buf_push(ab, llvm_const_int(i64t, string_length(kinds))); llvm_buf_push(ab, bits); llvm_buf_push(ab, kh)
    ncall_finish(ctx, "kaix_vec_set_rec_bits", p, ptb, ab)
  }
  _ -> nvec_bad(ctx, "vec.write.set.rec")
}

fn nvec_tail(xs: [KVal]) : [KVal] = match xs {
  []           -> []
  [_, ...rest] -> rest
}

fn nvec_evens(xs: [KVal]) : [KVal] = match xs {
  []           -> []
  [x, ...rest] -> [x, ...nvec_evens(nvec_tail(rest))]
}

fn nvec_kind_slot(kinds: String, k: Int) : KSlot =
  if string_slice(kinds, k, 1) == "r" { SReal } else { SInt64 }

# The fields as a stack `[n x i64]`; a Real stores its `double` into the
# same 8-byte slot, which is the word the buffer holds.
fn nvec_bits_array(ctx: Handle, kinds: String, vals: [KVal]) : Handle / Console = {
  let arrty = llvm_array_type(native_ctx_i64t(ctx), list_length(vals))
  let arr = llvm_build_alloca_entry(ctx, arrty, "vecbits")
  nvec_store_bits(ctx, arr, arrty, kinds, vals, 0)
  arr
}

fn nvec_store_bits(ctx: Handle, arr: Handle, arrty: Handle, kinds: String, vals: [KVal], k: Int) : Unit / Console = match vals {
  []           -> ()
  [x, ...rest] -> {
    let raw = nemit_atom_raw(ctx, x, nvec_kind_slot(kinds, k))
    let dst = llvm_build_array_gep(native_ctx_b(ctx), arrty, arr, llvm_const_i32(native_ctx_i32t(ctx), k))
    let _s = llvm_build_store(native_ctx_b(ctx), raw, dst)
    nvec_store_bits(ctx, arr, arrty, kinds, rest, k + 1)
  }
}

fn nvec_names_array(ctx: Handle, names: [KVal]) : Handle / Console = {
  let arrty = llvm_array_type(native_ctx_ptrt(ctx), list_length(names))
  let arr = llvm_build_alloca_entry(ctx, arrty, "vecnames")
  nvec_store_names(ctx, arr, arrty, names, 0)
  arr
}

fn nvec_store_names(ctx: Handle, arr: Handle, arrty: Handle, names: [KVal], k: Int) : Unit / Console = match names {
  [] -> ()
  [KStrV(nm), ...rest] -> {
    let nh = llvm_build_global_string(native_ctx_b(ctx), nm)
    let dst = llvm_build_array_gep(native_ctx_b(ctx), arrty, arr, llvm_const_i32(native_ctx_i32t(ctx), k))
    let _s = llvm_build_store(native_ctx_b(ctx), nh, dst)
    nvec_store_names(ctx, arr, arrty, rest, k + 1)
  }
  _ -> nemit_unsupported(ctx, "bare-word vec push with a non-literal field name")
}

#[doc("Emit a fixed-vec inline prim: the literal yields the `[n x elem]` array pointer, a read yields the element (re-boxed, or raw for a `raw` read), the materialise yields a dynamic `Vec`.")]
pub fn nemit_fixed_vec_prim(ctx: Handle, p: PrimOp, cargs: [KVal]) : Handle / Console = match p {
  KpFixedVecLit(elem, _)         -> nemit_fixed_vec_lit(ctx, elem, cargs)
  KpFixedVecMaterialize(elem, n) -> nemit_fixed_vec_materialize(ctx, elem, n, cargs)
  KpFixedVecGet(r, elem, n)      ->
    if r.heap { nemit_fixed_vec_dget(ctx, elem, n, cargs, r.dyn, r.raw) }
    else { nemit_fixed_vec_read(ctx, elem, n, cargs, r.dyn, r.raw) }
  _                              -> nemit_null(ctx)
}

# `[e0, ..., en]` → an entry-block `[n x elem]` alloca, each element stored
# raw at its GEP; the array pointer is the value (a handle slot binds it).
fn nemit_fixed_vec_lit(ctx: Handle, tag: RawScalar, cargs: [KVal]) : Handle / Console = {
  let arrty = llvm_array_type(nfixed_elem_ty(ctx, tag), list_length(cargs))
  let slot  = llvm_build_alloca_entry(ctx, arrty, "fixedvec")
  nfixed_store_elems(ctx, arrty, slot, tag, cargs, 0)
  slot
}

fn nfixed_store_elems(ctx: Handle, arrty: Handle, slot: Handle, tag: RawScalar, es: [KVal], i: Int) : Unit / Console = match es {
  []           -> ()
  [e, ...rest] -> {
    let raw = nemit_atom_raw(ctx, e, nfixed_elem_slot(tag))
    let dst = llvm_build_array_gep(native_ctx_b(ctx), arrty, slot, llvm_const_i32(native_ctx_i32t(ctx), i))
    let _s  = llvm_build_store(native_ctx_b(ctx), raw, dst)
    nfixed_store_elems(ctx, arrty, slot, tag, rest, i + 1)
  }
}

# `v[k]` → the base array pointer, a GEP + raw load. A static index is used
# as-is (the typer proved it in range); a dynamic one is first gated by
# `kaix_fixed_vec_idx`, which traps out of range and returns the word — an
# i64 GEP index is as valid as an i32 one. `raw_out` keeps the loaded scalar
# for a raw-position consumer; otherwise it re-boxes at the element ctor.
fn nemit_fixed_vec_read(ctx: Handle, tag: RawScalar, n: Int, cargs: [KVal],
                        dyn: Bool, raw_out: Bool) : Handle / Console = match cargs {
  [base, idx] -> {
    let arrty = llvm_array_type(nfixed_elem_ty(ctx, tag), n)
    let ptr   = nemit_atom(ctx, base)
    let ix    = if dyn { nfixed_idx_checked(ctx, idx, n) } else { nfixed_idx_val(ctx, idx) }
    let gep   = llvm_build_array_gep(native_ctx_b(ctx), arrty, ptr, ix)
    let raw   = llvm_build_load(native_ctx_b(ctx), nfixed_elem_ty(ctx, tag), gep)
    if raw_out { raw } else { nfixed_box(ctx, tag, raw) }
  }
  _ -> nemit_null(ctx)
}

# `v[k]` where the base is a BOXED fixed-vec-typed value — it crossed the
# boxed border and is a dynamic heap `Vec`, so the element slot is reached
# through the runtime instead of GEPing into a `[n x elem]` aggregate that
# is not there. Perceus hands the read an owned base, as for `vec_get`, so
# the read releases it after the load.
fn nemit_fixed_vec_dget(ctx: Handle, tag: RawScalar, n: Int, cargs: [KVal],
                        dyn: Bool, raw_out: Bool) : Handle / Console = match cargs {
  [base, idx] -> {
    let vec  = nemit_atom(ctx, base)
    let ix   = if dyn { nfixed_idx_checked(ctx, idx, n) } else { nfixed_idx_i64(ctx, idx) }
    let slot = ncall_sig2(ctx, "kaix_vec_raw_slot", native_ctx_ptrt(ctx),
                          native_ctx_ptrt(ctx), native_ctx_i64t(ctx), vec, ix)
    let raw  = llvm_build_load(native_ctx_b(ctx), nfixed_elem_ty(ctx, tag), slot)
    let _d   = ncall_sig1(ctx, "kaix_decref", native_ctx_voidt(ctx), native_ctx_ptrt(ctx), vec)
    if raw_out { raw } else { nfixed_box(ctx, tag, raw) }
  }
  _ -> nemit_null(ctx)
}

fn nfixed_idx_i64(ctx: Handle, idx: KVal) : Handle / Console = match idx {
  KIntV(k) -> llvm_const_int(native_ctx_i64t(ctx), k)
  _        -> llvm_const_int(native_ctx_i64t(ctx), 0)
}

# The inline `[n x elem]` aggregate → a dynamic heap `Vec`: one pre-sized
# `vec_reserve` filled by a boxed `vec_push` per element. The boxed border
# a fixed vec crosses when it flows to a `KaiValue *` consumer — one copy,
# mirroring the C backend's `materialize_fixed_vec`.
fn nemit_fixed_vec_materialize(ctx: Handle, tag: RawScalar, n: Int, cargs: [KVal]) : Handle / Console = match cargs {
  [base] -> {
    let ptr = nemit_atom(ctx, base)
    let cap = ncall_sig1(ctx, "kaix_int", native_ctx_ptrt(ctx), native_ctx_i64t(ctx),
                         llvm_const_int(native_ctx_i64t(ctx), n))
    let vec = ncall_sig1(ctx, "kaix_core_vec_reserve", native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), cap)
    nfixed_push_elems(ctx, tag, n, ptr, vec, 0)
  }
  _ -> nemit_null(ctx)
}

fn nfixed_push_elems(ctx: Handle, tag: RawScalar, n: Int, ptr: Handle, vec: Handle, i: Int) : Handle / Console =
  if i >= n { vec }
  else {
    let arrty = llvm_array_type(nfixed_elem_ty(ctx, tag), n)
    let gep   = llvm_build_array_gep(native_ctx_b(ctx), arrty, ptr, llvm_const_i32(native_ctx_i32t(ctx), i))
    let raw   = llvm_build_load(native_ctx_b(ctx), nfixed_elem_ty(ctx, tag), gep)
    let boxed = nfixed_box(ctx, tag, raw)
    let next  = ncall_sig2(ctx, "kaix_core_vec_push", native_ctx_ptrt(ctx),
                           native_ctx_ptrt(ctx), native_ctx_ptrt(ctx), vec, boxed)
    nfixed_push_elems(ctx, tag, n, ptr, next, i + 1)
  }

fn nfixed_idx_checked(ctx: Handle, idx: KVal, n: Int) : Handle / Console =
  ncall_sig2(ctx, "kaix_fixed_vec_idx", native_ctx_i64t(ctx),
             native_ctx_i64t(ctx), native_ctx_i64t(ctx),
             nemit_atom_raw(ctx, idx, SInt64), llvm_const_int(native_ctx_i64t(ctx), n))

fn nfixed_idx_val(ctx: Handle, idx: KVal) : Handle / Console = match idx {
  KIntV(k) -> llvm_const_i32(native_ctx_i32t(ctx), k)
  _        -> llvm_const_i32(native_ctx_i32t(ctx), 0)
}

# The scalar LLVM type of one element. Only ever passed inline to a prim
# call (never bound — see the HAZARD note).
fn nfixed_elem_ty(ctx: Handle, tag: RawScalar) : Handle = match tag {
  RwReal   -> native_ctx_f64t(ctx)
  RwInt    -> native_ctx_i64t(ctx)
  RwUInt64 -> native_ctx_i64t(ctx)
  _        -> native_ctx_i32t(ctx)
}

# The raw KSlot the element atom lowers to (drives `nemit_atom_raw`). The
# lowering never plants an Int128 element.
fn nfixed_elem_slot(tag: RawScalar) : KSlot = match tag {
  RwInt128 -> SInt64
  _        -> raw_scalar_slot(tag)
}

# Re-box one raw element by its constructor, mirroring the C backend's box of
# a `.a[k]` load.
fn nfixed_box(ctx: Handle, tag: RawScalar, raw: Handle) : Handle / Console = match tag {
  RwReal   -> ncall_sig1(ctx, "kaix_real", native_ctx_ptrt(ctx), native_ctx_f64t(ctx), raw)
  RwInt    -> ncall_sig1(ctx, "kaix_int", native_ctx_ptrt(ctx), native_ctx_i64t(ctx), raw)
  RwBool   -> ncall_sig1(ctx, "kaix_bool", native_ctx_ptrt(ctx), native_ctx_i32t(ctx), raw)
  RwChar   -> ncall_sig1(ctx, "kaix_char", native_ctx_ptrt(ctx), native_ctx_i32t(ctx), raw)
  RwByte   -> ncall_sig1(ctx, "kaix_byte", native_ctx_ptrt(ctx), native_ctx_i32t(ctx), raw)
  RwInt32  -> ncall_sig1(ctx, "kaix_int32", native_ctx_ptrt(ctx), native_ctx_i64t(ctx), raw)
  RwUInt32 -> ncall_sig1(ctx, "kaix_uint32", native_ctx_ptrt(ctx), native_ctx_i64t(ctx), raw)
  RwUInt64 -> ncall_sig1(ctx, "kaix_uint64", native_ctx_ptrt(ctx), native_ctx_i64t(ctx), raw)
  RwInt128 -> ncall_sig1(ctx, "kaix_int", native_ctx_ptrt(ctx), native_ctx_i64t(ctx), raw)
}
