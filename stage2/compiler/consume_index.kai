# compiler/consume_index.kai -- hash index over Perceus' consume map.
#
# Answers "which parameter positions does the callee at this key
# consume". Perceus asks at every `ECall` node, from two walkers, for
# every name under test, against one entry per `DFn` in the program plus
# a bare-name entry per module fn -- so the lookup must not be a scan.
#
# Precedence, and the trap: a key may be registered more than once, and
# the winner is the LAST registration. Entries go in as the decl list is
# walked and each is prepended within its bucket, so the newest-first
# chain's first exact-key match is that winner. A module fn registers
# its bare name after its qualified one for the same reason.
#
# Hash collisions land foreign keys in one chain; the read re-applies
# exact key equality, so a collision costs a comparison, never an answer.

import compiler.infer_index

#[doc("One consume-map row: a callee key and the parameter positions it consumes.")]
pub type ConsumeEntry = CE(String, [Int])

#[doc("Hash index from a Perceus consume-map key to the callee's consumed parameter positions.")]
pub type ConsumeIndex = { ix: NameIndex[ConsumeEntry] }

#[doc("The empty consume index.")]
pub fn cix_empty() : ConsumeIndex = ConsumeIndex { ix: idx_empty() }

#[doc("Register one consume-map entry, newest-first within its bucket.")]
pub fn cix_add(cx: ConsumeIndex, e: ConsumeEntry) : ConsumeIndex = match e {
  CE(k, _) -> ConsumeIndex { ix: idx_prepend(cx.ix, k, e) }
}

#[doc("Register a decl's entries listed newest-first, so the head stays the winner.")]
pub fn cix_add_newest_first(cx: ConsumeIndex, entries: [ConsumeEntry]) : ConsumeIndex = match entries {
  []           -> cx
  [e, ...rest] -> cix_add(cix_add_newest_first(cx, rest), e)
}

#[doc("The consumed positions registered under a key; empty when the key is absent.")]
pub fn cix_lookup(cx: ConsumeIndex, key: String) : [Int] =
  cix_chain_first(idx_chain(cx.ix, key), key)

fn cix_chain_first(chain: [ConsumeEntry], key: String) : [Int] = match chain {
  []           -> []
  [e, ...rest] -> match e { CE(k, ps) -> if k == key { ps } else { cix_chain_first(rest, key) } }
}
