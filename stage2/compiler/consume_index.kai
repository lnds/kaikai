# compiler/consume_index.kai -- hash index over Perceus' consume map.
#
# Answers "which parameter positions does this callee consume". Perceus
# asks at every `ECall` node, from two walkers, for every binder under
# test, against one entry per `DFn` in the program -- so the lookup must
# not be a scan.
#
# Precedence, and the trap: a function may be registered more than once,
# and the winner is the LAST registration. Entries go in as the decl list
# is walked and each is prepended within its bucket, so the newest-first
# chain's first match is that winner.
#
# A chain holds every instance of one declaration; the read re-applies
# identity, so a specialisation never answers for its generic.

import compiler.ast
import compiler.infer_index

#[doc("One consume-map row: a callee's identity and the parameter positions it consumes.")]
pub type ConsumeEntry = CE(FnId, [Int])

#[doc("Index from a function's identity to its consumed parameter positions.")]
pub type ConsumeIndex = { ix: NameIndex[ConsumeEntry] }

#[doc("The empty consume index.")]
pub fn cix_empty() : ConsumeIndex = ConsumeIndex { ix: idx_empty() }

#[doc("Register one consume-map entry, newest-first within its bucket.")]
pub fn cix_add(cx: ConsumeIndex, e: ConsumeEntry) : ConsumeIndex = match e {
  CE(k, _) -> if sym_raw(fnid_sym(k)) < 0 { cx } else { ConsumeIndex { ix: idx_prepend_sym(cx.ix, fnid_sym(k), e) } }
}


#[doc("The consumed positions registered for the function `key`; empty when it has no row or is unresolved.")]
pub fn cix_lookup(cx: ConsumeIndex, key: FnId) : [Int] =
  if sym_raw(fnid_sym(key)) < 0 { [] } else { cix_chain_first(idx_chain_sym(cx.ix, fnid_sym(key)), key) }

fn cix_chain_first(chain: [ConsumeEntry], key: FnId) : [Int] = match chain {
  []           -> []
  [e, ...rest] -> match e { CE(k, ps) -> if fnid_eq(k, key) { ps } else { cix_chain_first(rest, key) } }
}
