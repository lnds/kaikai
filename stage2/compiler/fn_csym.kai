#[doc("The C symbol a function is emitted under.")]

import compiler.fnreg
import compiler.written

#[doc("The C symbol, after the `kai_` prefix, of the fn declared as `name` by `mo`: `<mo>__<name>`, or the bare name outside a module.")]
pub fn c_sym(name: String, mo: Option[String]) : String = match mo {
  None    -> name
  Some(m) -> string_concat(m, string_concat("__", name))
}

#[doc("The C symbol, after the `kai_` prefix, of the registry entry `f`.")]
pub fn efn_c_sym(f: EFn) : String = match f {
  EFn(n, _, mo, _, _) -> c_sym(written_text(n), mo)
}
