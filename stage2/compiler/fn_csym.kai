#[doc("Functions keyed by the C symbol they are emitted under.")]

import compiler.infer_index
import compiler.fnreg
import compiler.written

#[doc("The C symbol, after the `kai_` prefix, of the fn declared as `name` by `mo`: `<mo>__<name>`, or the bare name outside a module.")]
pub fn c_sym(name: String, mo: Option[String]) : String = match mo {
  None    -> name
  Some(m) -> string_concat(m, string_concat("__", name))
}

#[doc("A registry indexed by C symbol.")]
pub fn csym_index(fns: [EFn]) : NameIndex[EFn] = csym_add(fns, idx_empty())

fn csym_add(fns: [EFn], ix: NameIndex[EFn]) : NameIndex[EFn] = match fns {
  []           -> ix
  [f, ...rest] -> match f {
    EFn(n, _, mo, _, _) -> csym_add(rest, idx_prepend(ix, c_sym(written_text(n), mo), f))
  }
}

# A chain is newest-first, so the last match is the registry's first.
#[doc("The unboxed-signature classification of the first indexed entry whose C symbol is `csym`.")]
pub fn csym_sig(ix: NameIndex[EFn], csym: String) : Option[UFnSig] = csym_oldest(idx_chain(ix, csym), csym, None)

fn csym_oldest(chain: [EFn], csym: String, found: Option[UFnSig]) : Option[UFnSig] = match chain {
  []           -> found
  [f, ...rest] -> match f {
    EFn(n, _, mo, Some(us), _) -> csym_oldest(rest, csym, if c_sym(written_text(n), mo) == csym { Some(us) } else { found })
    _                          -> csym_oldest(rest, csym, found)
  }
}
