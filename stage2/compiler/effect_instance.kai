#[doc("""
Effect instances: the identity a handler installs, a frame slot carries
and a perform reaches.

An instance is an effect and, once it is pinned to concrete types, the key
text of each type argument. An instance the compiler cannot pin (a
polymorphic body, a phantom op) carries no argument and matches every
instance of its effect; two pinned instances match only when equal.
Instances are read from monomorphised types, so a handler and a perform
agree exactly when the typer resolved them to the same instance.

The run time finds a handler by a label, `Eff` or `Eff[A,B]`: the
instance spelled with the name its effect is emitted under.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.util
import compiler.infer_glue
import compiler.infer_env
import compiler.infer_state
import compiler.diag_type_text
import compiler.scalar_ty
import compiler.symtab
import compiler.spec_names
import compiler.type_text
import compiler.ast_map
import compiler.expr_positions
import compiler.written
import compiler.infer_index
import compiler.core_types
import compiler.enc_unit

#[doc("An effect instance: the effect, and the key text of each type argument that pins it. No argument when the effect takes none or one of them is unpinned.")]
pub(pkg) type InstKey = { eff: SymId, args: [String] }

#[doc("The instance of `eff` whose argument key texts are `texts`: unpinned when one of them is.")]
fn inst_key(eff: SymId, texts: [String]) : InstKey =
  InstKey { eff: eff, args: if any(texts, is_unpinned) { [] } else { texts } }

#[doc("The instance of `eff` at the written type arguments `args`.")]
pub(pkg) fn inst_key_of_tes(eff: SymId, args: [TypeExpr]) : InstKey = inst_key(eff, map(args, te_text))

#[doc("The instance of `eff` at the type arguments `targs`.")]
pub(pkg) fn inst_key_of_tys(eff: SymId, targs: [Ty]) : InstKey = inst_key(eff, map(targs, ty_text))

#[doc("The instance a typed perform of `eff` reaches: its callee carries the resolved `Eff[args]` as its type.")]
pub(pkg) fn inst_key_of_callee(eff: SymId, callee_ty: Option[Ty]) : InstKey = match callee_ty {
  Some(TyCon(_, args)) -> inst_key_of_tys(eff, args)
  _                    -> inst_key(eff, [])
}

#[doc("The label the run time knows the instance `k` by; `tab` names its effect.")]
pub(pkg) fn inst_key_text(tab: SymTab, k: InstKey) : String = key_of(rt_name(tab, k.eff), k.args)

#[doc("The effect's emitted name in an instance label.")]
pub(pkg) fn inst_key_eff(key: String) : String = {
  let i = string_index_of_char(key, '[')
  if i < 0 { key } else { string_slice(key, 0, i) }
}

#[doc("True when a site of instance `a` may resolve through evidence of instance `b`.")]
pub(pkg) fn inst_keys_match(a: InstKey, b: InstKey) : Bool = inst_key_index([b], a) >= 0

#[doc("The index of the first instance in `keys` that `key` matches, an exact match first; -1 when none does.")]
fn inst_key_index(keys: [InstKey], key: InstKey) : Int = key_scan(keys, key, 0, 0 - 1)

fn key_scan(keys: [InstKey], key: InstKey, i: Int, first: Int) : Int = match keys {
  []           -> first
  [k, ...rest] ->
    if not same_effect(k, key) { key_scan(rest, key, i + 1, first) }
    else if k.args == key.args { i }
    else { key_scan(rest, key, i + 1, if first < 0 and pairs_bare(k, key) { i } else { first }) }
}

#[doc("True when `a` and `b` are one instance: the same effect at the same arguments.")]
fn inst_key_eq(a: InstKey, b: InstKey) : Bool = same_effect(a, b) and a.args == b.args

# An unresolved effect is no instance of anything.
fn same_effect(a: InstKey, b: InstKey) : Bool = sym_raw(a.eff) >= 0 and sym_raw(a.eff) == sym_raw(b.eff)

# One of two instances of an effect is the unpinned one the other pins.
fn pairs_bare(k: InstKey, key: InstKey) : Bool = list_is_empty(k.args) or list_is_empty(key.args)

#[doc("The instances of the row labels `ls`.")]
fn row_label_keys(ls: [RowLabel]) : [InstKey] =
  map(ls, (l) => match l { RL(r, args) -> inst_key_of_tes(ref_sym(r), args) })

#[doc("The label of the effect emitted as `eff` at the instance whose argument texts are `texts`; bare when one is unpinned.")]
pub fn key_of(eff: String, texts: [String]) : String = match texts {
  [] -> eff
  _  -> if any(texts, is_unpinned) { eff } else { concat_all([eff, "[", join_with(texts, ","), "]"]) }
}

#[doc("True when a key text has a part no instance pins.")]
fn is_unpinned(text: String) : Bool = string_index_of_char(text, '?') >= 0

#[doc("A written type's key text, `?` where it names nothing concrete.")]
fn te_text(te: TypeExpr) : String = match te.tkind {
  TyName(r, args) -> ref_key(r, map(args, te_text))
  TyList(inner)   -> cat3("[", te_text(inner), "]")
  TyFn(ps, r, _)  -> fn_text(map(ps, te_text), te_text(r))
  TyDim(b, _)     -> te_text(b)
  TyRefine(b, _)  -> te_text(b)
  _               -> "?"
}

# A settled name keys as its declaration, never its spelling: two types
# that share a name are two instances. A name still written is a scalar,
# or a type parameter, which pins nothing.
fn ref_key(r: DeclRef, args: [String]) : String = match r {
  DrSym(s)        -> con_text(id_text(s), args)
  DrWritten(_, _) -> match scalar_ty_named(ref_spelled(r)) {
    Some(t) -> prim_text(t)
    None    -> "?"
  }
}

fn id_text(s: SymId) : String = string_concat("#", int_to_string(sym_raw(s)))

#[doc("A resolved type's key text, `?` where no instance pins it.")]
pub(pkg) fn ty_text(t: Ty) : String = match t {
  TyListT(x)          -> cat3("[", ty_text(x), "]")
  TyFnT(ps, r, _)     -> fn_text(map(ps, ty_text), ty_text(r))
  TyCon(s, args)      -> con_text(id_text(s), map(args, ty_text))
  TyDimT(b, _)        -> ty_text(b)
  TyRefineT(b, _)     -> ty_text(b)
  _                   -> prim_text(t)
}

#[doc("True when a part of `t` is unpinned: the holes `ty_text` spells `?`.")]
fn ty_unpinned(t: Ty) : Bool = match t {
  TyListT(x)           -> ty_unpinned(x)
  TyFnT(ps, r, _)      -> any(ps, ty_unpinned) or ty_unpinned(r)
  TyCon(_, args)       -> any(args, ty_unpinned)
  TyDimT(b, _)         -> ty_unpinned(b)
  TyRefineT(b, _)      -> ty_unpinned(b)
  _                    -> match scalar_ty_name(t) {
    Some(_) -> false
    None    -> true
  }
}

#[doc("The name of a primitive type, or `?` for any other.")]
fn prim_text(t: Ty) : String = match scalar_ty_name(t) {
  Some(n) -> n
  None    -> "?"
}

fn con_text(n: String, args: [String]) : String = match args {
  [] -> n
  _  -> concat_all([n, "[", join_with(args, ","), "]"])
}

fn fn_text(ps: [String], r: String) : String = concat_all(["fn(", join_with(ps, ","), ")->", r])

#[doc("The type parameters of a function that hold a position among its type arguments.")]
fn decl_tparams(d: Decl) : [TBinder] = match d {
  DFn(_, _, tps, _, _, _, _, _, _, _) -> tbs_positional(tps)
  _ -> []
}

#[doc("""
Spell every instance in its final form. A `handle`'s type arguments name its
instance: an `(init)` handler of a parametric effect gets them from the init's
type, and one whose arguments name a type parameter of its function is left
unpinned. An op the typer left unpinned (a phantom one) takes the instance of a
function row that carries exactly one of its effect, unless a lambda or a
`handle` of that effect stands between them.
""")]
pub(pkg) fn canon_handle_instances(decls: [Decl]) : [Decl] = {
  let arities = effect_arities(decls)
  map(decls, (d) => canon_decl(d, arities))
}

type RowPin = RP(SymId, [TypeExpr])

# One effect declaration; an unresolved id is none.
fn eff_same(a: SymId, b: SymId) : Bool = sym_raw(a) >= 0 and sym_raw(a) == sym_raw(b)

type CanonCx = { arities: [EffArity], pins: [RowPin] }

fn canon_decl(d: Decl, arities: [EffArity]) : Decl = match d {
  DFn(p, fid, tps, ps, ret, row, body, l, c, mo) -> if not xp_exists(body, false, may_canon) { d } else {
    let cx = CanonCx { arities: arities, pins: row_pins(row_labels_of(row)) }
    if xp_exists(body, false, (e) => needs_canon(e, cx)) { DFn(p, fid, tps, ps, ret, row, canon_expr(body, cx), l, c, mo) }
    else { d }
  }
  _ -> d
}

fn may_canon(e: Expr) : Bool = match e.kind {
  EHandle(_, _, _, _, _, _, _) -> true
  ECall(f, _) -> match f.ty {
    Some(TyCon(_, args)) -> any(args, ty_unpinned)
    _ -> false
  }
  _ -> false
}

# Conservative: a pinnable op under a lambda or a same-effect `handle` is
# left as it is by `canon_expr`, at the cost of one rebuild.
fn needs_canon(e: Expr, cx: CanonCx) : Bool = match e.kind {
  EHandle(_, r, args, init, _, _, _) -> handle_args(ref_sym(r), args, init, cx) != args
  ECall(f, _) -> match f.ty {
    Some(TyCon(s, args)) -> any(args, ty_unpinned) and any(cx.pins, (p) => match p { RP(ps, _) -> eff_same(ps, s) })
    _ -> false
  }
  _ -> false
}

fn canon_expr(e: Expr, cx: CanonCx) : Expr = {
  let k1 = match e.kind {
    # Clauses run outside their own `handle`, so only the body loses the pin.
    EHandle(body, r, args, init, alias, cls, ret) -> {
      let outer = (sub) => canon_expr(sub, cx)
      let hsym = ref_sym(r)
      EHandle(canon_expr(body, CanonCx { ...cx, pins: filter(cx.pins, (p) => match p { RP(ps, _) -> not eff_same(ps, hsym) }) }),
              r, handle_args(hsym, args, init, cx), prc_map_opt_expr(init, outer), alias,
              map(cls, (c) => prc_map_clause_exprs(c, outer)), prc_map_opt_return_exprs(ret, outer))
    }
    ELambda(ps, body) -> ELambda(ps, canon_expr(body, CanonCx { ...cx, pins: [] }))
    ECall(f, xs) -> ECall(pin_op(canon_expr(f, cx), cx.pins), map(xs, (x) => canon_expr(x, cx)))
    k -> prc_map_expr_kind(k, (sub) => canon_expr(sub, cx))
  }
  Expr { kind: k1, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }
}

fn pin_op(f: Expr, pins: [RowPin]) : Expr = match f.ty {
  Some(TyCon(s, args)) ->
    if any(args, ty_unpinned) { match filter(pins, (p) => match p { RP(ps, _) -> eff_same(ps, s) }) {
      [RP(_, tes)] -> Expr { kind: f.kind, line: f.line, col: f.col, ty: Some(TyCon(s, map(tes, te_as_ty))), mode: f.mode,  site: f.site }
      _            -> f
    } } else { f }
  _ -> f
}

# The effects a row carries exactly once, at a pinned instance.
fn row_pins(ls: [RowLabel]) : [RowPin] =
  map(filter(ls, (l) => is_sole_pinned(ls, l)), (l) => match l { RL(r, args) -> RP(ref_sym(r), args) })

fn is_sole_pinned(ls: [RowLabel], l: RowLabel) : Bool = match l {
  RL(r, args) -> list_length(filter(ls, (o) => eff_same(rl_sym(o), ref_sym(r)))) == 1 and not any(args, (a) => is_unpinned(te_text(a)))
}

fn row_labels_of(row: RowExpr) : [RowLabel] = match row {
  REmpty       -> []
  RClosed(ls)  -> ls
  ROpen(_, ls) -> ls
}

fn handle_args(hsym: SymId, args: [TypeExpr], init: Option[Expr], cx: CanonCx) : [TypeExpr] = match args {
  [] -> match init {
    Some(ie) -> if arity_of(cx.arities, hsym) > 0 { init_args(ie) } else { [] }
    None     -> []
  }
  _ -> if any(args, (a) => is_unpinned(te_text(a))) { [] } else { args }
}

fn init_args(ie: Expr) : [TypeExpr] = match ie.ty {
  Some(t) -> if ty_unpinned(t) { [] } else { [ty_as_te(t)] }
  None    -> []
}

# Only the shapes `ty_text` reads back: a pinned type has no other part.
fn ty_as_te(t: Ty) : TypeExpr = mk_ty(match t {
  TyListT(x)           -> TyList(ty_as_te(x))
  TyFnT(ps, r, _)      -> TyFn(map(ps, ty_as_te), ty_as_te(r), REmpty)
  TyCon(s, args)       -> TyName(DrSym(s), map(args, ty_as_te))
  TyDimT(b, _)         -> ty_as_te(b).tkind
  TyRefineT(b, _)      -> ty_as_te(b).tkind
  _                    -> TyName(ref_written(prim_text(t)), [])
}, 0, 0)

# The inverse of `ty_as_te` over the pinned shapes a row label spells.
fn te_as_ty(te: TypeExpr) : Ty = match te.tkind {
  TyName(r, args) -> match args {
    [] -> match scalar_ty_named(ref_spelled(r)) {
      Some(t) -> t
      None    -> TyCon(canon_ref_sym(r), [])
    }
    _  -> TyCon(canon_ref_sym(r), map(args, te_as_ty))
  }
  TyParam(_, args) -> TyCon(sym_none(), map(args, te_as_ty))
  TyList(inner)  -> TyListT(te_as_ty(inner))
  TyFn(ps, r, _) -> TyFnT(map(ps, te_as_ty), te_as_ty(r), Row { labels: [], tail: None, display_alias: None })
  TyDim(b, _)    -> te_as_ty(b)
  TyRefine(b, _) -> te_as_ty(b)
  _              -> TyAny
}

# A reference's declaration, or the core identity of a runtime-built type still written.
fn canon_ref_sym(r: DeclRef) : SymId = ref_sym_or_core(r)

#[doc("The type parameters of `d` that a `handle` in its body takes as instance arguments.")]
pub(pkg) fn handle_instance_tparams(d: Decl) : [TBinder] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _) ->
    if not xp_exists(body, false, has_handle_args) { [] }
    else { filter(decl_tparams(d), (tp) => xp_exists(body, false, (e) => handle_names(e, tp))) }
  _ -> []
}

fn has_handle_args(e: Expr) : Bool = match e.kind {
  EHandle(_, _, args, _, _, _, _) -> args != []
  _ -> false
}

fn handle_names(e: Expr, tp: TBinder) : Bool = match e.kind {
  EHandle(_, _, args, _, _, _, _) -> any(args, (a) => te_mentions(a, tp))
  _ -> false
}

fn te_mentions(te: TypeExpr, tp: TBinder) : Bool = match te.tkind {
  TyParam(id, args) -> tlocal_eq(id, tp.id) or any(args, (a) => te_mentions(a, tp))
  TyName(_, args) -> any(args, (a) => te_mentions(a, tp))
  TyList(inner)   -> te_mentions(inner, tp)
  TyFn(ps, r, _)  -> any(ps, (a) => te_mentions(a, tp)) or te_mentions(r, tp)
  TyDim(b, _)     -> te_mentions(b, tp)
  TyRefine(b, _)  -> te_mentions(b, tp)
  _               -> false
}

type EffArity = EA(SymId, Int)

fn effect_arities(decls: [Decl]) : [EffArity] = match decls {
  []           -> []
  [d, ...rest] -> match d {
    DEffect(_, s, tps, _, _, _, _, _) -> [EA(s, list_length(tps)), ...effect_arities(rest)]
    _ -> effect_arities(rest)
  }
}

fn arity_of(arities: [EffArity], hsym: SymId) : Int = match arities {
  []                 -> 0
  [EA(s, k), ...rest] -> if eff_same(s, hsym) { k } else { arity_of(rest, hsym) }
}

# the per-function evidence-frame ABI. One hidden frame pointer per function
# whose row demands an effect — a Koka-style evidence vector whose slots the
# call site fills per its own supplier classification. The perform site reads
# its slot by index instead of the by-name walk; the walk stays live as the
# retreatable fallback. Frame slots are derived from the ROW, not from local
# op calls: a pure forwarder (`mid() : T / E` whose body only calls a callee
# that performs E) has no dotted op call, yet its row demands E and it must
# thread evidence to its callee. The frame ABI is a property of the row's
# distinct effect labels — exactly the param set the signature carries. Every
# declared effect rides the frame, builtin-default ones included: the
# default-bearing property no longer decides whether an effect uses the frame,
# only which supplier fills its slot (a startup-minted default node when no
# lexical handler is in scope). `frame_effect_is_carried` draws the line.

# The distinct effect instances a function's row demands, in canonical
# (row, deduped) order — the slot layout caller and callee agree on. Keyed
# by the function, so both the perform site (its own frame) and the call
# site (the callee's frame) resolve the same layout.
pub(pkg) type FnEvidenceFrame = FEF(FnId, [InstKey])

#[doc("evidence-frame: per function, the distinct effect instances its row demands, in canonical slot order. The entry point `entry` carries no frame.")]
pub(pkg) fn build_evidence_frames(decls: [Decl], entry: SymId) : [FnEvidenceFrame] =
  build_frames_loop(decls, decls, entry, [])

fn build_frames_loop(all: [Decl], ds: [Decl], entry: SymId, acc: [FnEvidenceFrame]) : [FnEvidenceFrame] = match ds {
  []           -> list_reverse(acc)
  [d, ...rest] -> match d {
    # The entry point is the root of the transport: it has no caller to fill a
    # frame, and its row effects are satisfied by the startup defaults the
    # `main` wrapper installs (found via the live walk). So it never takes
    # a frame param — an empty slot list keeps its performs on the walk.
    DFn(_, fid, _, _, _, row, _, _, _, _) -> {
      let slots = if is_entry(entry, fid) { [] } else { frame_carried_slots(all, row) }
      build_frames_loop(all, rest, entry, [FEF(fid, slots), ...acc])
    }
    _ -> build_frames_loop(all, rest, entry, acc)
  }
}

# The slot layout: distinct effect instances in the row, KEPT when the effect
# is a declared effect (every one rides the frame; the supplier is decided per
# call site, not whether it takes a slot).
fn frame_carried_slots(decls: [Decl], row: RowExpr) : [InstKey] = {
  let ls = frame_row_labels(row)
  frame_keep_carried(row_label_keys(ls), ls, decls, [])
}

fn frame_row_labels(row: RowExpr) : [RowLabel] = match row {
  REmpty       -> []
  RClosed(ls)  -> ls
  ROpen(_, ls) -> ls
}

fn frame_keep_carried(keys: [InstKey], ls: [RowLabel], decls: [Decl], seen: [InstKey]) : [InstKey] = match keys {
  []           -> []
  [k, ...krest] -> match ls {
    []           -> []
    [l, ...lrest] ->
      if frame_has(seen, k) { frame_keep_carried(krest, lrest, decls, seen) }
      else if frame_effect_is_carried(rl_sym(l), decls) { [k, ...frame_keep_carried(krest, lrest, decls, [k, ...seen])] }
      else { frame_keep_carried(krest, lrest, decls, [k, ...seen]) }
  }
}

# A frame-carried effect: declared as an `effect` whose evidence is transportable
# by value. A builtin-default IO effect (`Stdout`/`File`/`Clock`/`Mutable` …)
# rides the frame; the `default {}` property decides only which supplier fills
# the slot. The exception is an effect whose evidence the scheduler installs
# per-fiber (cancel_pad, link-set, mailbox, nursery) — transporting it would
# carry a parent's handler across a `spawn`, where capabilities must not cross.
# Those stay on the dynamic walk so a perform inside a fiber binds the fiber's
# own disposition. `Ffi` declares no ops and is routed around the dispatcher.
#[doc("evidence-frame: true when an effect's evidence is transportable by value; false for an effect the scheduler installs per-fiber (it stays on the dynamic walk so it does not cross a spawn).")]
fn frame_effect_is_carried(s: SymId, decls: [Decl]) : Bool =
  frame_is_declared_effect(s, decls) and not frame_is_fiber_local(s)

fn frame_is_declared_effect(s: SymId, decls: [Decl]) : Bool = match decls {
  []           -> false
  [d, ...rest] -> match d {
    DEffect(_, es, _, _, _, _, _, _) -> if sym_raw(s) >= 0 and sym_raw(es) == sym_raw(s) { true } else { frame_is_declared_effect(s, rest) }
    _ -> frame_is_declared_effect(s, rest)
  }
}

# Effects whose evidence the scheduler installs per-fiber, so it must not ride a
# frame slot (that would transport a parent's handler across a `spawn`).
fn frame_is_fiber_local(s: SymId) : Bool =
  effect_is_any(s, [CeCancel, CeLink, CeMonitor, CeSpawn, CeActor])

#[doc("evidence-frame: a lexical `handle` of an instance, and the unit it stands in.")]
pub(pkg) type FrameShadow = FSh(EncUnit, InstKey)

#[doc("evidence-frame: the frame table indexed by function, plus the lexical `handle` shadows the body being emitted has entered.")]
pub(pkg) type EvFrames = { shadows: [FrameShadow], ix: NameIndex[FnEvidenceFrame] }

#[doc("evidence-frame: index a frame table by function; of a function listed twice, the first frame answers.")]
pub(pkg) fn frames_index(frames: [FnEvidenceFrame]) : EvFrames =
  EvFrames { shadows: [], ix: frames_ix(list_reverse(frames), idx_empty()) }

fn frames_ix(rev: [FnEvidenceFrame], ix: NameIndex[FnEvidenceFrame]) : NameIndex[FnEvidenceFrame] = match rev {
  []           -> ix
  [f, ...rest] -> match f {
    FEF(fid, _) -> frames_ix(rest, if sym_raw(fnid_sym(fid)) >= 0 { idx_prepend_sym(ix, fnid_sym(fid), f) } else { ix })
  }
}

#[doc("evidence-frame: slot index of an effect instance in the frame of the function `f`, or -1 when the frame does not carry it (perform falls back to the walk).")]
fn frame_slot_index(frames: EvFrames, f: FnId, key: InstKey) : Int =
  match frame_lookup(frames, f) {
    Some(slots) -> inst_key_index(slots, key)
    None        -> 0 - 1
  }

#[doc("evidence-frame: the ordered slot instances of the frame of the function `f` (its ABI arity), or [] when `f` has none.")]
pub(pkg) fn frame_slots_of(frames: EvFrames, f: FnId) : [InstKey] =
  match frame_lookup(frames, f) {
    Some(slots) -> slots
    None        -> []
  }

fn frame_lookup(frames: EvFrames, f: FnId) : Option[[InstKey]] =
  if sym_raw(fnid_sym(f)) < 0 { None } else { frame_chain(idx_chain_sym(frames.ix, fnid_sym(f)), f) }

# A bucket holds a declaration and its specialisations.
fn frame_chain(chain: [FnEvidenceFrame], f: FnId) : Option[[InstKey]] = match chain {
  []            -> None
  [fr, ...rest] -> match fr { FEF(g, slots) -> if fnid_eq(g, f) { Some(slots) } else { frame_chain(rest, f) } }
}

fn frame_has(xs: [InstKey], k: InstKey) : Bool = match xs {
  []           -> false
  [h, ...rest] -> if inst_key_eq(h, k) { true } else { frame_has(rest, k) }
}

#[doc("Mark the effect instance `key` as handled by a `handle` lexically inside the unit `enc`.")]
pub(pkg) fn frame_shadow(frames: EvFrames, enc: EncFn, key: InstKey) : EvFrames =
  EvFrames { shadows: [FSh(enc.unit, key), ...frames.shadows], ix: frames.ix }

#[doc("The frame slot of the instance `key` in the unit `enc` that an op or call here may use, or -1 when there is none or a lexical `handle` shadows it. A runner and a lifted body carry no frame.")]
pub(pkg) fn frame_slot_here(frames: EvFrames, enc: EncFn, key: InstKey) : Int =
  if is_shadowed(frames.shadows, enc.unit, key) { 0 - 1 }
  else { frame_slot_index(frames, enc_fn_id(enc), key) }

fn is_shadowed(shadows: [FrameShadow], at: EncUnit, key: InstKey) : Bool = match shadows {
  []                   -> false
  [FSh(u, k), ...rest] -> (inst_keys_match(key, k) and unit_same(u, at)) or is_shadowed(rest, at, key)
}


#[doc("True when a handle binds its instance with `as` and the effect is not an id-addressed cell: only its name reaches it, never a bare op.")]
pub(pkg) fn is_named_instance(eff: SymId, alias: Option[Binder]) : Bool =
  is_some(alias) and not (effect_is(eff, CeState) or effect_is(eff, CeReader))
