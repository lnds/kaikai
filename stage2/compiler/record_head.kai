#[doc("""
What a `Name { … }` head names when no type is known, and how the fields
it builds lie.

A head names a record: a type of that spelling which is no record is no
candidate. A record's fields occupy the slots its declaration orders them
in, whatever order a literal writes them in.
""")]

import compiler.ast
import compiler.symtab
import compiler.scope_view
import compiler.decl_names

#[doc("The record a bare head `name` reaches from the view `v`: the one of that name on the nearest rung declaring any, the tie when that rung declares several.")]
pub fn rh_on_ladder(t: SymTab, v: ScopeView, recs: [RecInfo], name: String) : SvRes =
  match sv_resolve_fit(t, v, [SvOwn, SvPicks, SvImports, SvCores], [NCType, NCExternType], name, (s) => is_some(rec_find(recs, s))) {
    SvFit(r, _) -> r
  }

#[doc("The type or extern type of module `modn` named `name`.")]
pub fn rh_qualified(t: SymTab, modn: String, name: String) : SvRes = match sv_qualified(t, NCType, modn, name) {
  SvSym(s) -> SvSym(s)
  _        -> sv_qualified(t, NCExternType, modn, name)
}

#[doc("True when `fis` names every field of `fds` exactly once, in another order than the declared one.")]
pub fn rh_out_of_order(fis: [FieldInit], fds: [FieldDecl]) : Bool =
  list_length(fis) == list_length(fds)
    and all(fds, (fd) => match fd { FD(_, dnm, _, _) -> init_index(fis, dnm, 0) >= 0 })
    and not in_declared_order(fis, fds)

#[doc("The binder a literal at `line`:`col` holds its `i`-th written field value in while the record is laid in declared order.")]
pub fn rh_temp_binder(line: Int, col: Int, i: Int) : Binder =
  binder_minted("__rf_#{int_to_string(line)}_#{int_to_string(col)}_#{int_to_string(i)}__")

#[doc("The position the field `name` is written at in `fis`; -1 when it is not.")]
pub fn rh_written_at(fis: [FieldInit], name: String) : Int = init_index(fis, name, 0)

fn in_declared_order(fis: [FieldInit], fds: [FieldDecl]) : Bool = match fis {
  [] -> true
  [FI(fnm, _), ...frest] -> match fds {
    [] -> true
    [FD(_, dnm, _, _), ...drest] -> fnm == dnm and in_declared_order(frest, drest)
  }
}

# The position `target` is written at in `fis`; -1 when it is not.
fn init_index(fis: [FieldInit], target: String, i: Int) : Int = match fis {
  [] -> -1
  [FI(nm, _), ...rest] -> if nm == target { i } else { init_index(rest, target, i + 1) }
}
