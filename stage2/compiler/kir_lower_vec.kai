#[doc("KIR ops for the bare-word `Vec` paths: an Int / Real payload read from or written into the buffer with no box on either side (verdict in vec_raw.kai).")]

import compiler.util
import compiler.kir
import compiler.vec_raw

#[doc("The raw slot a bare word of kind `b` rides.")]
pub fn vec_bits_slot(b: VecBits) : KSlot = match b {
  VbInt  -> SInt64
  VbReal -> SReal
}

# The runtime's per-field kind char (kai_vec_kind_tag).
fn vb_kind(b: VecBits) : String = match b {
  VbInt  -> "i"
  VbReal -> "r"
}

# The last operand tells the runtime the read owns its vec, so a trap pays
# the reference the unwind would skip.
#[doc("The read of `rd` over the lowered vec `vv` and raw index `iv`; `owned` when the caller releases the vec after it.")]
pub fn vec_raw_read_op(rd: VecRawRead, vv: KVal, iv: KVal, owned: Bool) : KOp = match rd.col {
  Some(c) -> match c {
    VecCol(fidx, n) -> KPrim(KpVecReadField(rd.bits), [vv, iv, KIntV(fidx), KIntV(n), vec_own(owned)])
  }
  None -> KPrim(KpVecRead(rd.bits), [vv, iv, vec_own(owned)])
}

#[doc("The read of column `c` as the box its buffer tag builds, for a field the bare-word paths do not carry; operands as in `vec_raw_read_op`.")]
pub fn vec_boxed_field_op(c: VecCol, vv: KVal, iv: KVal, owned: Bool) : KOp = match c {
  VecCol(fidx, _) -> KPrim(KpVecReadFieldBoxed, [vv, iv, KIntV(fidx), vec_own(owned)])
}

fn vec_own(owned: Bool) : KVal = KIntV(if owned { 1 } else { 0 })

#[doc("One record field on its way into a REC carrier: name, word kind, lowered raw value.")]
pub type VecField = VecField(String, VecBits, KVal)

#[doc("`vec_push(v, Rec{..})` over raw fields: the vec, then the kind string, then (value, name) pairs.")]
pub fn vec_push_rec_op(vv: KVal, fs: [VecField]) : KOp =
  KPrim(KpVecPushRec, [vv, KStrV(vf_kinds(fs)), ...vf_pairs(fs)])

#[doc("`vec_set(v, i, Rec{..})` over raw fields: the vec, the raw index, the kind string, then the values.")]
pub fn vec_set_rec_op(vv: KVal, iv: KVal, fs: [VecField]) : KOp =
  KPrim(KpVecSetRec, [vv, iv, KStrV(vf_kinds(fs)), ...vf_vals(fs)])

#[doc("`vec_push(v, x)` of one raw scalar.")]
pub fn vec_push_scalar_op(b: VecBits, vv: KVal, xv: KVal) : KOp =
  KPrim(KpVecPush(b), [vv, xv])

#[doc("`vec_set(v, i, x)` of one raw scalar at a raw index.")]
pub fn vec_set_scalar_op(b: VecBits, vv: KVal, iv: KVal, xv: KVal) : KOp =
  KPrim(KpVecSet(b), [vv, iv, xv])

fn vf_kinds(fs: [VecField]) : String = match fs {
  []           -> ""
  [f, ...rest] -> match f { VecField(_, b, _) -> cat2(vb_kind(b), vf_kinds(rest)) }
}

fn vf_pairs(fs: [VecField]) : [KVal] = match fs {
  []           -> []
  [f, ...rest] -> match f { VecField(nm, _, v) -> [v, KStrV(nm), ...vf_pairs(rest)] }
}

fn vf_vals(fs: [VecField]) : [KVal] = match fs {
  []           -> []
  [f, ...rest] -> match f { VecField(_, _, v) -> [v, ...vf_vals(rest)] }
}
