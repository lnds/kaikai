#[doc("The type parameters `kai migrate` respells lowercase: each binder where it is declared and exactly the uses the binding pass bound to it.")]

import compiler.ast_binders
import compiler.ast_ids
import compiler.lex
import compiler.parse_naming
import compiler.parse_state
import compiler.util

#[doc("A span of source to respell: byte offset, length and replacement.")]
pub(pkg) type Span = Span(Int, Int, String)

#[doc("The spans that respell every uppercase type parameter among `facts`: its declaration and each use bound to its id.")]
pub(pkg) fn tparam_spans(src: String, toks: [Token], facts: [AstFact]) : [Span] =
  flat_map(facts, (f) => binder_spans(src, toks, facts, f))

fn binder_spans(src: String, toks: [Token], facts: [AstFact], f: AstFact) : [Span] = match f {
  FTParam(id, name, implicit, l, c) ->
    if name_bad(NkTypeParam, name) {
      let new = fresh_name(snake_of(name), siblings_at(facts, l, c))
      list_append(if implicit { [] } else { first_ident_span(src, toks, l, c, name, new) },
                  flat_map(facts, (u) => use_span(src, toks, u, id, name, new)))
    } else { [] }
  FBind(_, _, _, _) -> []
  FTyUse(_, _, _) -> []
}

fn use_span(src: String, toks: [Token], u: AstFact, id: TLocalId, name: String, new: String) : [Span] = match u {
  FTyUse(uid, l, c) -> if tlocal_eq(uid, id) { exact_ident_span(src, toks, l, c, name, new) } else { [] }
  FBind(_, _, _, _) -> []
  FTParam(_, _, _, _, _) -> []
}

fn siblings_at(facts: [AstFact], l: Int, c: Int) : [String] =
  flat_map(facts, (f) => match f {
    FTParam(_, n, _, fl, fc) -> if fl == l and fc == c { [n] } else { [] }
    FBind(_, _, _, _) -> []
    FTyUse(_, _, _) -> []
  })

fn fresh_name(candidate: String, siblings: [String]) : String =
  if list_has(siblings, candidate) { fresh_name("#{candidate}_", siblings) } else { candidate }

fn snake_of(name: String) : String =
  if to_upper(name) == name { to_lower(name) } else { snake_chars(name, 0, []) }

fn snake_chars(name: String, i: Int, acc: [String]) : String = match char_at(name, i) {
  None -> concat_all(list_reverse(acc))
  Some(c) ->
    if c >= 'A' and c <= 'Z' {
      let lower = to_lower(string_slice(name, i, 1))
      snake_chars(name, i + 1, [if i == 0 { lower } else { "_#{lower}" }, ...acc])
    } else { snake_chars(name, i + 1, [string_slice(name, i, 1), ...acc]) }
}

# The declaring bracket records the declaration's position, not the name's: the name is the first matching identifier after it.
fn first_ident_span(src: String, toks: [Token], l: Int, c: Int, name: String, new: String) : [Span] = match toks {
  [] -> []
  [t, ...rest] ->
    if tk_is(t.kind, TkIdent) and (t.line > l or (t.line == l and t.col >= c)) and tok_source(src, t) == name { [Span(t.start, t.length, new)] }
    else { first_ident_span(src, rest, l, c, name, new) }
}

fn exact_ident_span(src: String, toks: [Token], l: Int, c: Int, name: String, new: String) : [Span] = match toks {
  [] -> []
  [t, ...rest] ->
    if tk_is(t.kind, TkIdent) and t.line == l and t.col == c and tok_source(src, t) == name { [Span(t.start, t.length, new)] }
    else { exact_ident_span(src, rest, l, c, name, new) }
}
