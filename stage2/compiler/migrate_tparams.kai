#[doc("The type parameters `kai migrate` respells lowercase: each binder where it is declared and exactly the uses the binding pass bound to it.")]

import compiler.ast_binders
import compiler.ast_ids
import compiler.parse_naming
import compiler.lex
import compiler.parse_state
import compiler.util

#[doc("A span of source to respell: byte offset, length and replacement.")]
pub(pkg) type Span = Span(Int, Int, String)

#[doc("The lowercase spelling an uppercase type parameter takes, avoiding its siblings'.")]
pub(pkg) fn respelled_param(name: String, siblings: [String]) : String = fresh_name(snake_of(name), siblings)

#[doc("The respellings of every uppercase type parameter among `facts`: its declaration and each use bound to its id.")]
pub(pkg) fn tparam_spans(src: String, facts: [AstFact]) : [Located] =
  flat_map(facts, (f) => binder_spans(src, facts, f))

fn binder_spans(src: String, facts: [AstFact], f: AstFact) : [Located] = match f {
  FTParam(id, name, implicit, l, c, siblings) ->
    if name_bad(NkTypeParam, name) and not implicit {
      let new = fresh_name(snake_of(name), siblings)
      list_append([locate_ident(src, l, c, name, new)],
                  flat_map(facts, (u) => use_span(src, u, id, name, new)))
    } else { [] }
  FBind(_, _, _, _) -> []
  FTyUse(_, _, _) -> []
  FUnitUse(_, _, _) -> []
}

fn use_span(src: String, u: AstFact, id: TLocalId, name: String, new: String) : [Located] = match u {
  FTyUse(uid, l, c) -> if tlocal_eq(uid, id) { [locate_ident(src, l, c, name, new)] } else { [] }
  FUnitUse(uid, l, c) -> if tlocal_eq(uid, id) { locate_unit(src, l, c, name, new) } else { [] }
  FBind(_, _, _, _) -> []
  FTParam(_, _, _, _, _, _) -> []
}

fn fresh_name(candidate: String, siblings: [String]) : String =
  if list_has(siblings, candidate) { fresh_name("#{candidate}_", siblings) } else { candidate }

fn snake_of(name: String) : String =
  if to_upper(name) == name { to_lower(name) } else { snake_chars(name, 0, []) }

fn snake_chars(name: String, i: Int, acc: [String]) : String = match char_at(name, i) {
  None -> concat_all(list_reverse(acc))
  Some(c) ->
    if c >= 'A' and c <= 'Z' {
      let lower = to_lower(string_slice(name, i, 1))
      snake_chars(name, i + 1, [if i == 0 { lower } else { "_#{lower}" }, ...acc])
    } else { snake_chars(name, i + 1, [string_slice(name, i, 1), ...acc]) }
}

#[doc("A respelling the walk could place, or the reason it could not.")]
pub(pkg) type Located = Found(Span) | Missing(String)

#[doc("""
Places the respelling of `name` for the reference the resolver recorded at `line`/`col`:
the identifier at that position, or, when the position is the last dot of a qualified
path, the identifier right after it. Anything else is `Missing`.
""")]
pub(pkg) fn locate_ident(src: String, l: Int, c: Int, name: String, new: String) : Located = {
  let off = line_start(src, l, 1, 0) + c - 1
  let slice = string_slice(src, off, run_to(src, off, '\n') - off)
  match recorded_ident(slice, tokenize(slice), name) {
    Some(t) -> Found(Span(off + t.start, t.length, new))
    None -> Missing("no `#{name}` at line #{int_to_string(l)}, column #{int_to_string(c)}")
  }
}

fn recorded_ident(slice: String, ts: [Token], name: String) : Option[Token] = match ts {
  [t, ...rest] ->
    if tk_is(t.kind, TkIdent) and t.start == 0 { named(slice, t, name) }
    else if tk_is(t.kind, TkDot) and t.start == 0 { after_dot(slice, rest, name) }
    else { None }
  [] -> None
}

fn after_dot(slice: String, ts: [Token], name: String) : Option[Token] = match ts {
  [i, ..._] -> if tk_is(i.kind, TkIdent) and i.start == 1 { named(slice, i, name) } else { None }
  [] -> None
}

fn named(slice: String, t: Token, name: String) : Option[Token] =
  if tok_source(slice, t) == name { Some(t) } else { None }

fn run_to(src: String, i: Int, stop: Char) : Int = match char_at(src, i) {
  None -> i
  Some(ch) -> if ch == stop { i } else { run_to(src, i + 1, stop) }
}

#[doc("""
Places the respelling of `name` in the selector list of the `import` that starts at `line`/`col`:
the first identifier between its braces spelled `name`.
""")]
pub(pkg) fn locate_selector(src: String, l: Int, c: Int, name: String, new: String) : Located = {
  let off = line_start(src, l, 1, 0) + c - 1
  let slice = string_slice(src, off, run_to(src, off, '}') - off)
  match selector_token(slice, tokenize(slice), name, false) {
    Some(t) -> Found(Span(off + t.start, t.length, new))
    None -> Missing("no selector `#{name}` in the import at line #{int_to_string(l)}")
  }
}

fn selector_token(slice: String, ts: [Token], name: String, inside: Bool) : Option[Token] = match ts {
  [] -> None
  [t, ...rest] ->
    if tk_is(t.kind, TkRbrace) { None }
    else if tk_is(t.kind, TkLbrace) { selector_token(slice, rest, name, true) }
    else if inside and tk_is(t.kind, TkIdent) and tok_source(slice, t) == name { Some(t) }
    else { selector_token(slice, rest, name, inside) }
}

#[doc("""
Places the respellings of `name` in the unit written after the base type that starts at
`line`/`col`: every identifier spelled `name` between its `<` and the matching `>`.
""")]
pub(pkg) fn locate_unit(src: String, l: Int, c: Int, name: String, new: String) : [Located] = {
  let off = line_start(src, l, 1, 0) + c - 1
  let slice = string_slice(src, off, run_to(src, off, '\n') - off)
  match unit_tokens(slice, tokenize(slice), name, 0, []) {
    [] -> [Missing("no unit `#{name}` after the type at line #{int_to_string(l)}, column #{int_to_string(c)}")]
    hits -> map(hits, (t) => Found(Span(off + t.start, t.length, new)))
  }
}

fn unit_tokens(slice: String, ts: [Token], name: String, depth: Int, acc: [Token]) : [Token] = match ts {
  [] -> acc
  [t, ...rest] ->
    if tk_is(t.kind, TkLt) { unit_tokens(slice, rest, name, depth + 1, acc) }
    else if tk_is(t.kind, TkGt) { if depth <= 1 { acc } else { unit_tokens(slice, rest, name, depth - 1, acc) } }
    else if depth > 0 and tk_is(t.kind, TkIdent) and tok_source(slice, t) == name { unit_tokens(slice, rest, name, depth, [t, ...acc]) }
    else { unit_tokens(slice, rest, name, depth, acc) }
}

fn line_start(src: String, l: Int, cur: Int, i: Int) : Int =
  if cur >= l { i }
  else {
    match char_at(src, i) {
      None -> i
      Some('\n') -> line_start(src, l, cur + 1, i + 1)
      Some(_) -> line_start(src, l, cur, i + 1)
    }
  }
