#[doc("""
In-process gate for the emitted name of a declaration, run with the
symbol-table gates behind `--symtab-selftest`.

Every emitter spells a contested effect or type through `rt_name`, so
the rule is pinned here once, against a table that knows its root and
core modules: who keeps the bare name, who takes its home, and that a
table extended or grown still answers the same.
""")]

import compiler.ast
import compiler.decl_names
import compiler.symtab
import compiler.symtab_build
import compiler.rt_name

# A core `effects`, the root `main`, and three user modules. `Log` is an
# effect of the core, the root and two modules; `Emit` of the root and
# one module; `Item` a type of the root and two modules; `Cfg` a type of
# the core and one module. `Solo` and `One` are declared once.
fn rnt_rows() : [NEnt] = [
  NEnt(NCEffect, "Log",  "effects", true),
  NEnt(NCEffect, "Log",  "main",    true),
  NEnt(NCEffect, "Log",  "ra",      true),
  NEnt(NCEffect, "Log",  "rb",      true),
  NEnt(NCEffect, "Emit", "main",    true),
  NEnt(NCEffect, "Emit", "ra",      true),
  NEnt(NCEffect, "Solo", "ra",      true),
  NEnt(NCType,   "Item", "main",    true),
  NEnt(NCType,   "Item", "ra",      true),
  NEnt(NCType,   "Item", "pkg.b",   true),
  NEnt(NCType,   "Cfg",  "effects", true),
  NEnt(NCType,   "Cfg",  "ra",      true),
  NEnt(NCType,   "One",  "ra",      true),
  NEnt(NCFn,     "run",  "ra",      true),
  NEnt(NCFn,     "run",  "rb",      true)
]

# What each row above is emitted under, in the same order.
fn rnt_want() : [String] = [
  "Log", "Log__main", "Log__ra", "Log__rb",
  "Emit", "Emit__ra", "Solo",
  "Item", "Item__ra", "Item__pkg_b",
  "Cfg", "Cfg__ra", "One",
  "run", "run"
]

fn rnt_spelled(t: SymTab, rows: [NEnt], want: [String]) : Bool = match rows {
  [] -> match want { [] -> true  _ -> false }
  [e, ...rest] -> match want {
    []         -> false
    [w, ...ws] -> rt_name(t, nent_sym(e)) == w and rnt_spelled(t, rest, ws)
  }
}

# Enough unrelated rows to push an extended table through a doubling.
fn rnt_filler(n: Int, acc: [NEnt]) : [NEnt] =
  if n == 0 { acc }
  else { rnt_filler(n - 1, [NEnt(NCFn, "pad", string_concat("m", int_to_string(n)), true), ...acc]) }

#[doc("True when `rt_name` spells every row of a program's table as the rule says, before and after the table is extended.")]
pub fn rt_names_hold() : Bool {
  let rows = rnt_rows()
  let t = st_build(rows, "main", ["effects"])
  rnt_spelled(t, rows, rnt_want()) and rnt_spelled(st_extend(t, rnt_filler(40, [])), rows, rnt_want())
}
