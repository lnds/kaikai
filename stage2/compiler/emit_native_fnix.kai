#[doc("The program's KFns indexed by the symbol a direct call names.")]

import compiler.infer_index
import compiler.kir

#[doc("A KFn list plus a hash index from each fn's symbol to the fns carrying it.")]
pub type NFnIndex = { ix: NameIndex[KFn], all: [KFn] }

#[doc("Index the KFns so a direct call resolves its callee without scanning them.")]
pub fn nfnx_build(fns: [KFn]) : NFnIndex = NFnIndex { ix: nfnx_add(fns, idx_empty()), all: fns }

fn nfnx_add(fns: [KFn], ix: NameIndex[KFn]) : NameIndex[KFn] = match fns {
  []           -> ix
  [f, ...rest] -> nfnx_add(rest, idx_prepend(ix, f.sym, f))
}

# A chain is newest-first and holds hash-colliding symbols, so the last exact match is the list's first.
#[doc("The first KFn, in list order, whose symbol is `sym`.")]
pub fn nfnx_by_sym(fx: NFnIndex, sym: String) : Option[KFn] = nfnx_oldest(idx_chain(fx.ix, sym), sym, None)

fn nfnx_oldest(chain: [KFn], sym: String, found: Option[KFn]) : Option[KFn] = match chain {
  []           -> found
  [f, ...rest] -> nfnx_oldest(rest, sym, if f.sym == sym { Some(f) } else { found })
}
