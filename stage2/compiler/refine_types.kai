#[doc("""
Refinement types: names, slots and type forms.
""")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.util
import compiler.symtab
import compiler.scope_view

fn pred_self_key() : String = "self"

#[doc("The identity of the `self` a refinement predicate reads.")]
pub(pkg) fn pred_self() : LocalId = local_minted(pred_self_key())

#[doc("The binder of a refinement predicate's `self`.")]
pub(pkg) fn pred_self_binder() : Binder = binder_minted(pred_self_key())

#[doc("True when one of `ts` holds a refinement predicate anywhere inside it.")]
pub(pkg) fn tys_refined(ts: [TypeExpr]) : Bool = match ts {
  []           -> false
  [t, ...rest] -> ty_refined(t) or tys_refined(rest)
}

fn ty_refined(t: TypeExpr) : Bool = match t.tkind {
  TyName(_, targs) -> tys_refined(targs)
  TyParam(_, targs) -> tys_refined(targs)
  TyList(x)        -> ty_refined(x)
  TyFn(ps, r, row) -> tys_refined(ps) or ty_refined(r) or tys_refined(row_types(row))
  TyDim(b, _)      -> ty_refined(b)
  TyRefine(_, _)   -> true
  TyRow(row)       -> tys_refined(row_types(row))
  TySurface(ts)    -> tys_refined(tysurface_children(ts))
}

fn row_labels(r: RowExpr) : [RowLabel] = match r {
  REmpty       -> []
  RClosed(ls)  -> ls
  ROpen(_, ls) -> ls
}

fn row_types(r: RowExpr) : [TypeExpr] = flat_map(row_labels(r), (l) => match l { RL(_, targs) -> targs })

fn row_with_types(r: RowExpr, ts: [TypeExpr]) : RowExpr = match r {
  REmpty       -> REmpty
  RClosed(ls)  -> RClosed(labels_with_types(ls, ts))
  ROpen(v, ls) -> ROpen(v, labels_with_types(ls, ts))
}

fn labels_with_types(ls: [RowLabel], ts: [TypeExpr]) : [RowLabel] = match ls {
  []                    -> []
  [RL(r, own), ...rest] -> {
    let n = list_length(own)
    [RL(r, types_take(ts, n)), ...labels_with_types(rest, types_drop(ts, n))]
  }
}

fn types_take(ts: [TypeExpr], n: Int) : [TypeExpr] = match ts {
  []           -> []
  [t, ...rest] -> if n <= 0 { [] } else { [t, ...types_take(rest, n - 1)] }
}

fn types_drop(ts: [TypeExpr], n: Int) : [TypeExpr] = match ts {
  []           -> []
  [_, ...rest] -> if n <= 0 { ts } else { types_drop(rest, n - 1) }
}

# The types a type is written from: a function's parameters, its result,
# then its row's arguments.
fn kids(k: TyKind) : [TypeExpr] = match k {
  TyName(_, targs) -> targs
  TyParam(_, targs) -> targs
  TyList(x)        -> [x]
  TyFn(ps, r, row) -> list_append(ps, [r, ...row_types(row)])
  TyDim(b, _)      -> [b]
  TyRefine(b, _)   -> [b]
  TyRow(row)       -> row_types(row)
  TySurface(ts)    -> tysurface_children(ts)
}

# `k` written from `xs`, which holds as many types as `kids(k)`.
fn with_kids(k: TyKind, xs: [TypeExpr]) : TyKind = match k {
  TyName(r, _)     -> TyName(r, xs)
  TyFn(ps, _, row) -> fn_with_kids(types_take(xs, list_length(ps)), types_drop(xs, list_length(ps)), row, k)
  TyRow(row)       -> TyRow(row_with_types(row, xs))
  TySurface(ts)    -> TySurface(tysurface_rebuild(ts, xs))
  _                -> match xs {
    [x, ..._] -> with_kid(k, x)
    []        -> k
  }
}

fn with_kid(k: TyKind, x: TypeExpr) : TyKind = match k {
  TyList(_)      -> TyList(x)
  TyDim(_, u)    -> TyDim(x, u)
  TyRefine(_, p) -> TyRefine(x, p)
  _              -> k
}

fn fn_with_kids(ps: [TypeExpr], rest: [TypeExpr], row: RowExpr, k: TyKind) : TyKind = match rest {
  [r, ...targs] -> TyFn(ps, r, row_with_types(row, targs))
  []            -> k
}

#[doc("The predicates of `ts` in the order they are written: a refinement's base before its own predicate.")]
pub(pkg) fn tys_preds(ts: [TypeExpr]) : [Expr] = list_reverse(preds_tys(ts, []))

fn preds_tys(ts: [TypeExpr], acc: [Expr]) : [Expr] = match ts {
  []           -> acc
  [t, ...rest] -> preds_tys(rest, preds_ty(t, acc))
}

fn preds_ty(t: TypeExpr, acc: [Expr]) : [Expr] =
  if not ty_refined(t) { acc }
  else { match t.tkind {
    TyRefine(b, p) -> [p, ...preds_ty(b, acc)]
    k              -> preds_tys(kids(k), acc)
  } }

#[doc("The type each predicate of `ts` refines, in `tys_preds` order.")]
pub(pkg) fn tys_bases(ts: [TypeExpr]) : [TypeExpr] = list_reverse(bases_tys(ts, []))

fn bases_tys(ts: [TypeExpr], acc: [TypeExpr]) : [TypeExpr] = match ts {
  []           -> acc
  [t, ...rest] -> bases_tys(rest, bases_ty(t, acc))
}

fn bases_ty(t: TypeExpr, acc: [TypeExpr]) : [TypeExpr] =
  if not ty_refined(t) { acc }
  else { match t.tkind {
    TyRefine(b, _) -> [b, ...bases_ty(b, acc)]
    k              -> bases_tys(kids(k), acc)
  } }

# A rebuilt piece and the predicates the rest of the walk still places.
type Filled[a] = Filled(a, [Expr])

#[doc("`ts` with the predicates `ps` in the place of their own, taken in `tys_preds` order.")]
pub(pkg) fn tys_with_preds(ts: [TypeExpr], ps: [Expr]) : [TypeExpr] = match fill_tys(ts, ps) {
  Filled(out, _) -> out
}

fn fill_tys(ts: [TypeExpr], ps: [Expr]) : Filled[[TypeExpr]] = match ts {
  []           -> Filled([], ps)
  [t, ...rest] -> match fill_ty(t, ps) {
    Filled(t1, ps1) -> match fill_tys(rest, ps1) {
      Filled(rest1, ps2) -> Filled([t1, ...rest1], ps2)
    }
  }
}

fn fill_ty(t: TypeExpr, ps: [Expr]) : Filled[TypeExpr] =
  if not ty_refined(t) { Filled(t, ps) }
  else { match fill_tys(kids(t.tkind), ps) {
    Filled(xs, rest) -> fill_own(t, with_kids(t.tkind, xs), rest)
  } }

# A refinement takes the next predicate once its base took its own.
fn fill_own(t: TypeExpr, k: TyKind, ps: [Expr]) : Filled[TypeExpr] = match k {
  TyRefine(b, _) -> match ps {
    [p, ...rest] -> Filled(TypeExpr { tkind: TyRefine(b, p), line: t.line, col: t.col }, rest)
    []           -> Filled(TypeExpr { tkind: k, line: t.line, col: t.col }, [])
  }
  _ -> Filled(TypeExpr { tkind: k, line: t.line, col: t.col }, ps)
}

#[doc("What the settle reads: the symbol table, every file's scope, and the declarations, which say what each sum constructs and what each function takes first.")]
pub(pkg) type PredCx = { tab: SymTab, views: FileViews, decls: [Decl] }

#[doc("A context that settles nothing: no declaration answers.")]
pub(pkg) fn pn_none() : PredCx = PredCx { tab: st_empty(), views: fv_empty(), decls: [] }

fn pn_settle(pred: Expr, base: TypeExpr, v: ScopeView, cx: PredCx) : Expr =
  walk(pred, At { cx: cx, v: v, base: type_sym(cx.tab, v, base) })

#[doc("`pn_settle` over the predicates `ps` of some types and the bases `bs` they refine, both in `tys_preds` order.")]
pub(pkg) fn pn_settle_all(ps: [Expr], bs: [TypeExpr], v: ScopeView, cx: PredCx) : [Expr] = match ps {
  []           -> []
  [p, ...rest] -> match bs {
    [b, ...more] -> [pn_settle(p, b, v, cx), ...pn_settle_all(rest, more, v, cx)]
    []           -> ps
  }
}

# One predicate's position: the file it is written in and the type it refines.
type At = { cx: PredCx, v: ScopeView, base: SymId }

# Only the forms that bind nothing are walked, so every name met is free
# in the predicate.
fn walk(e: Expr, at: At) : Expr = match e.kind {
  EName(w)         -> read(e, written_text(w), at)
  ECall(f, xs)     -> call(e, f, map(xs, (x) => walk(x, at)), at)
  EBinop(op, a, b) -> with_kind(e, EBinop(op, walk(a, at), walk(b, at)))
  EUnop(op, x)     -> with_kind(e, EUnop(op, walk(x, at)))
  EField(b, f)     -> with_kind(e, EField(walk(b, at), f))
  EIndex(a, b)     -> with_kind(e, EIndex(walk(a, at), walk(b, at)))
  _                -> e
}

# The arguments are settled first: a tied callee reads their types.
fn call(e: Expr, f: Expr, xs: [Expr], at: At) : Expr = with_kind(e, ECall(callee(f, xs, at), xs))

fn with_kind(e: Expr, k: ExprKind) : Expr = Expr { ...e, kind: k }

fn settled(e: Expr, s: SymId) : Expr = with_kind(e, ESym(s, spec_none()))

# A name read as a value: the refined type's own constructor, else the
# one declaration on the nearest rung.
fn read(e: Expr, name: String, at: At) : Expr = match own_ctor(at, name) {
  Some(c) -> settled(e, c)
  None    -> match on_ladder(at, name) {
    SvSym(s) -> settled(e, s)
    _        -> e
  }
}

# A bare callee settles as a read does; a tie between functions is
# broken by the type of the first argument.
fn callee(f: Expr, xs: [Expr], at: At) : Expr = match f.kind {
  EName(w) -> match own_ctor(at, written_text(w)) {
    Some(c) -> settled(f, c)
    None    -> match on_ladder(at, written_text(w)) {
      SvSym(s)    -> settled(f, s)
      SvAmbig(ss) -> match taking_first(ss, xs, at) {
        Some(s) -> settled(f, s)
        None    -> f
      }
      _ -> f
    }
  }
  _ -> walk(f, at)
}

fn on_ladder(at: At, name: String) : SvRes =
  match sv_resolve_fit(at.cx.tab, at.v, [SvOwn, SvPicks, SvImports, SvCores], [NCFn, NCConst, NCCtor], name, (_s) => true) {
    SvFit(r, _) -> r
  }

# ---- the refined type's constructors ----

fn own_ctor(at: At, name: String) : Option[SymId] =
  if sym_raw(at.base) < 0 { None }
  else if is_core(at.base, CtOption) { core_ctor(name, ["Some", "None"]) }
  else if is_core(at.base, CtResult) { core_ctor(name, ["Ok", "Err"]) }
  else { find(sum_ctors(at.cx.decls, at.base), (c) => written_text(decl_name(at.cx.tab, c)) == name) }

fn is_core(t: SymId, c: CoreTy) : Bool = sym_same(t, core_ty_sym(c))

fn core_ctor(name: String, declared: [String]) : Option[SymId] =
  if list_has(declared, name) { Some(sym_derive(NCCtor, name, core_type_home())) } else { None }

# The constructors the declaration of the sum `t` lists.
fn sum_ctors(ds: [Decl], t: SymId) : [SymId] = match ds {
  []           -> []
  [d, ...rest] -> match decl_transparent_inner(d) {
    Some(inner) -> sum_ctors([inner, ...rest], t)
    None        -> match d {
      DType(_, s, _, TBSum(vs), _, _, _, _) ->
        if sym_same(s, t) { map(vs, (v) => match v { Var(c, _) -> c }) } else { sum_ctors(rest, t) }
      _ -> sum_ctors(rest, t)
    }
  }
}

# ---- a function tie, broken by its first argument ----

# The one of `ss` whose first parameter is the type of the call's first
# argument. Core modules restating one function leave the last the core
# set lists.
fn taking_first(ss: [SymId], xs: [Expr], at: At) : Option[SymId] = match xs {
  [x, ..._] -> {
    let t = arg_type(x, at)
    if sym_raw(t) < 0 { None } else {
      match filter(ss, (s) => sym_same(first_param(at.cx, s), t)) {
        [s] -> Some(s)
        fit -> sv_last_listed_core(at.cx.tab, at.v, fit)
      }
    }
  }
  [] -> None
}

# The type of an argument as far as the declarations say it: the refined
# value has the refined type, a call the result its function declares.
fn arg_type(x: Expr, at: At) : SymId = match x.kind {
  ELocal(l)   -> if local_eq(l, pred_self()) { at.base } else { sym_none() }
  ECall(f, _) -> match f.kind {
    ESym(s, _) -> result_type(at.cx, s)
    _          -> sym_none()
  }
  _ -> sym_none()
}

# The type the function `f` takes first, read from the file that
# declares it; none when it takes nothing or names no declared type.
fn first_param(cx: PredCx, f: SymId) : SymId = match fn_decl(cx.decls, f) {
  Some(DFn(_, _, _, ps, _, _, _, _, _, _)) -> match ps {
    [p, ..._] -> opt_type_sym(cx, f, p.ptype)
    []        -> sym_none()
  }
  _ -> sym_none()
}

fn result_type(cx: PredCx, f: SymId) : SymId = match fn_decl(cx.decls, f) {
  Some(DFn(_, _, _, _, ret, _, _, _, _, _)) -> opt_type_sym(cx, f, ret)
  _ -> sym_none()
}

fn opt_type_sym(cx: PredCx, f: SymId, t: Option[TypeExpr]) : SymId = match t {
  Some(te) -> type_sym(cx.tab, fv_of(cx.views, sym_owner(cx.tab, f)), te)
  None     -> sym_none()
}

fn fn_decl(ds: [Decl], f: SymId) : Option[Decl] = match ds {
  []           -> None
  [d, ...rest] -> match decl_transparent_inner(d) {
    Some(inner) -> fn_decl([inner, ...rest], f)
    None        -> match d {
      DFn(_, id, _, _, _, _, _, _, _, _) -> if sym_same(fnid_sym(id), f) { Some(d) } else { fn_decl(rest, f) }
      _ -> fn_decl(rest, f)
    }
  }
}

# ---- the type a type expression names ----

# The declaration `t` names from the view `v`: a builtin is named by
# its own spelling, a list by the list type, a refinement or a
# dimensioned type by its carrier.
fn type_sym(tab: SymTab, v: ScopeView, t: TypeExpr) : SymId = match t.tkind {
  TyName(DrSym(s), _)               -> s
  TyName(DrWritten(Some(q), n), _)  -> sv_sym(sv_qualified_type(tab, written_text(q), written_text(n)))
  TyName(DrWritten(None, n), _)     -> declared_or_builtin(sv_sym(sv_resolve_type(tab, v, written_text(n))), written_text(n))
  TyList(_)      -> core_ty_sym(CtList)
  TyRefine(b, _) -> type_sym(tab, v, b)
  TyDim(b, _)    -> type_sym(tab, v, b)
  _              -> sym_none()
}

fn declared_or_builtin(s: SymId, name: String) : SymId =
  if sym_raw(s) >= 0 { s } else { core_type_sym_or_none(name) }

fn sv_sym(r: SvRes) : SymId = match r {
  SvSym(s) -> s
  _        -> sym_none()
}

#[doc("The annotations of the parameters `ps`, in order; an unannotated parameter has none.")]
pub(pkg) fn params_types(ps: [Param]) : [TypeExpr] = match ps {
  []           -> []
  [p, ...rest] -> match p.ptype {
    Some(t) -> [t, ...params_types(rest)]
    None    -> params_types(rest)
  }
}

#[doc("`ps` annotated with `ts`, taken in `params_types` order.")]
pub(pkg) fn params_with_types(ps: [Param], ts: [TypeExpr]) : [Param] = match ps {
  []           -> []
  [p, ...rest] -> match p.ptype {
    None    -> [p, ...params_with_types(rest, ts)]
    Some(_) -> match ts {
      [t, ...more] -> [Param { ...p, ptype: Some(t) }, ...params_with_types(rest, more)]
      []           -> ps
    }
  }
}

#[doc("The types a type declaration's body is written with: an alias's target, a record's fields, a sum's payloads.")]
pub(pkg) fn body_types(b: TypeBody) : [TypeExpr] = match b {
  TBAlias(t)       -> [t]
  TBRecord(fs)     -> map(fs, (f) => match f { FD(_, _, t, _) -> t })
  TBSum(vs)        -> flat_map(vs, (v) => match v { Var(_, ts) -> ts })
  TBEffectAlias(_) -> []
}

#[doc("`b` written with `ts`, taken in `body_types` order.")]
pub(pkg) fn body_with_types(b: TypeBody, ts: [TypeExpr]) : TypeBody = match b {
  TBAlias(_)       -> match ts {
    [t1, ..._] -> TBAlias(t1)
    []         -> b
  }
  TBRecord(fs)     -> TBRecord(fields_with_types(fs, ts))
  TBSum(vs)        -> TBSum(variants_with_types(vs, ts))
  TBEffectAlias(_) -> b
}

fn fields_with_types(fs: [FieldDecl], ts: [TypeExpr]) : [FieldDecl] = match fs {
  []                         -> []
  [FD(p, n, t, at), ...rest] -> match ts {
    [t1, ...more] -> [FD(p, n, t1, at), ...fields_with_types(rest, more)]
    []            -> fs
  }
}

fn variants_with_types(vs: [Variant], ts: [TypeExpr]) : [Variant] = match vs {
  []                     -> []
  [Var(c, own), ...rest] -> {
    let n = list_length(own)
    [Var(c, types_take(ts, n)), ...variants_with_types(rest, types_drop(ts, n))]
  }
}
