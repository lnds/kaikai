#[doc("A record literal against its declaration: positional fields named, a spread expanded, overrides checked, and what a `Name { … }` head names when no type is known.")]

import compiler.util
import compiler.diag
import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.modules_homes
import compiler.symtab
import compiler.written
import compiler.scope_view
import compiler.type_home

#[doc("""
What a name written before the resolver is settled against: the symbol
table and the view of the file the name sits in, the one homed at `home`.
""")]
pub(pkg) type DsgScope = { tab: SymTab, views: FileViews, home: String }

#[doc("""
The scope of the file `d` sits in; a declaration with no module origin
is the root's.
""")]
pub(pkg) fn dsg_scope_of(d: Decl, tab: SymTab, views: FileViews, root: String) : DsgScope =
  DsgScope { tab: tab, views: views, home: decl_home_hint_reset(d, root, root) }

#[doc("""
The declaration of class `cls` a written `name` denotes: the only one
of that name, else the one the scope ladder settles; `sym_none()` when
neither answers.
""")]
pub(pkg) fn dsg_written_sym(sc: DsgScope, cls: NCls, name: String) : SymId = match st_candidates(sc.tab, cls, name) {
  []  -> sym_none()
  [s] -> s
  _   -> match sv_resolve(sc.tab, fv_of(sc.views, st_module_id(sc.home)), cls, name) {
    SvSym(s) -> s
    _        -> sym_none()
  }
}

#[doc("""
The type a reference denotes: its declaration once resolved, else what
its written name settles to. A written qualifier is not consulted.
""")]
pub(pkg) fn dsg_type_sym(sc: DsgScope, r: DeclRef) : SymId = match r {
  DrSym(s)        -> s
  DrWritten(_, n) -> dsg_type_named(sc, written_text(n))
}

fn dsg_type_named(sc: DsgScope, name: String) : SymId = {
  let s = dsg_written_sym(sc, NCType, name)
  if sym_raw(s) < 0 { dsg_written_sym(sc, NCExternType, name) } else { s }
}

#[doc("True when `s` is one of `xs`.")]
pub(pkg) fn dsg_sym_in(xs: [SymId], s: SymId) : Bool =
  sym_raw(s) >= 0 and any(xs, (x) => sym_raw(x) == sym_raw(s))

#[doc("The record table and the scope a literal's head is settled in.")]
pub(pkg) type RecScope = { recs: [RecInfo], sc: DsgScope }

#[doc("""
The record a literal's head names, if it names one. A qualifier is the
choice: the record its module declares. No type is known here, so a
bare name climbs the file's scope over the records of that name; one
no record answers is read as a type name is.
""")]
pub(pkg) fn rec_of_head(rs: RecScope, rh: DeclRef) : Option[RecInfo] = match rh {
  DrSym(s)              -> rec_find(rs.recs, s)
  DrWritten(Some(q), n) -> match sv_qualified_type(rs.sc.tab, written_text(q), written_text(n)) {
    SvSym(s) -> rec_find(rs.recs, s)
    _        -> None
  }
  DrWritten(None, n)    -> match rh_on_ladder(rs.sc.tab, fv_of(rs.sc.views, st_module_id(rs.sc.home)), rs.recs, written_text(n)) {
    SvSym(s)   -> rec_find(rs.recs, s)
    SvAmbig(_) -> None
    _          -> rec_find(rs.recs, dsg_type_sym(rs.sc, rh))
  }
}

#[doc("""
The head of a literal whose fields were read off `ri` here. A bare name
becomes that record, so no later reading of the name pairs those fields
with another record's.
""")]
pub(pkg) fn head_settled(rh: DeclRef, ri: RecInfo) : DeclRef = match rh {
  DrWritten(None, _) -> match ri { RI(s, _, _, _) -> DrSym(s) }
  _                  -> rh
}

#[doc("A positional literal's head, settled to the record that named its fields.")]
pub(pkg) fn pos_head(rs: RecScope, rh: DeclRef, fis: [FieldInit]) : DeclRef = match fis {
  [] -> rh
  [FI(_, v), ..._] ->
    if field_is_pos(v) {
      match rec_of_head(rs, rh) {
        Some(ri) -> head_settled(rh, ri)
        None     -> rh
      }
    } else { rh }
}

#[doc("A literal's head as a diagnostic spells it.")]
pub(pkg) fn rec_head_text(rs: RecScope, rh: DeclRef) : String = match rh {
  DrWritten(_, n) -> written_text(n)
  DrSym(s)        -> written_text(decl_name(rs.sc.tab, s))
}
#[doc("Prints an error and returns it as a diagnostic.")]
pub(pkg) fn rl_error(file: String, line: Int, col: Int, msg: String) : Diagnostic / Console + File = {
  let d = mk_diag(SevError, file, line, col, msg, [])
  render_diag(d)
  d
}

#[doc("Lowered field initialisers and the errors so far, newest first.")]
pub(pkg) type DPRFields = { fields: [FieldInit], errs: [Diagnostic] }

#[doc("""
Rewrite positional fields `[e0, ...]` into named `[FI(field0, e0), ...]`
using the record's declared field order. Reports diagnostics for
unknown record names and arity mismatches.
""")]
pub(pkg) fn dpr_record_lit(rh: DeclRef, fis: [FieldInit], line: Int, col: Int, recs: RecScope, file: String, errs: [Diagnostic]) : DPRFields / Console + File {

  let is_pos = match fis {
    [] -> false
    [f, ..._rest] -> match f { FI(_, v) -> field_is_pos(v) }
  }
  if not is_pos {
    DPRFields { fields: fis, errs: errs }
  } else {
    match rec_of_head(recs, rh) {
      None -> {
        let d = rl_error(file, line, col,
          string_concat("unknown record type `",
            string_concat(rec_head_text(recs, rh),
              "` for positional construction; declare the type or use named-field form")))
        DPRFields { fields: fis, errs: [d, ...errs] }
      }
      Some(ri) -> match ri {
        RI(_, _, fds, _) -> {
          let n_pos = list_length(fis)
          let n_decl = list_length(fds)
          if n_pos != n_decl {
            let d = rl_error(file, line, col,
              concat_all([ "`", rec_head_text(recs, rh), "` expects ", int_to_string(n_decl),
                           " positional fields, got ", int_to_string(n_pos) ]))
            DPRFields { fields: fis, errs: [d, ...errs] }
          } else {
            DPRFields { fields: rename_pos_fields(fis, fds), errs: errs }
          }
        }
      }
    }
  }
}

fn rename_pos_fields(fis: [FieldInit], fds: [FieldDecl]) : [FieldInit] {
  match fis {
    [] -> []
    [fi, ...frest] -> match fds {
      [] -> [fi, ...frest]
      [fd, ...drest] -> match fi {
        FI(_, val) -> match fd {
          FD(_, real_name, _, _, _, _) -> [FI(real_name, field_written(val)), ...rename_pos_fields(frest, drest)]
        }
      }
    }
  }
}

#[doc("A lowered spread literal and the errors so far.")]
pub(pkg) type DPRSpread = { expr: Expr, errs: [Diagnostic] }

#[doc("""
Build a stable, position-derived var name for the spread source.
Two literals on the same line/col can't collide because the parser
rules them out at the source level; nesting is fine because each
spread sits inside its own EBlock scope.
""")]
pub(pkg) fn spread_src_var_name(line: Int, col: Int) : String =
  concat_all(["__spread_src_", int_to_string(line), "_", int_to_string(col), "__"])

#[doc("""
Walk declared field order; for each field, prefer the override
expression if present, else `var_ref.field_name`.
""")]
pub(pkg) fn expand_spread_fields(
  fds: [FieldDecl],
  overrides: [FieldInit],
  var_ref: Expr,
  line: Int,
  col: Int
) : [FieldInit] {
  match fds {
    [] -> []
    [fd, ...rest] -> match fd {
      FD(_, fname, _, _, _, _) -> {
        let val = match find_override(overrides, fname) {
          Some(ov) -> ov
          None -> mk_expr(EField(var_ref, fname), line, col)
        }
        [FI(fname, val), ...expand_spread_fields(rest, overrides, var_ref, line, col)]
      }
    }
  }
}

pub(pkg) fn find_override(overrides: [FieldInit], name: String) : Option[Expr] {
  match overrides {
    [] -> None
    [h, ...rest] -> match h {
      FI(n, val) -> if n == name { Some(val) } else { find_override(rest, name) }
    }
  }
}

#[doc("""
Returns `errs` with a diagnostic per repeat. Each duplicated override name is reported
once (subsequent occurrences are flagged at their first repeat).
""")]
pub(pkg) fn check_spread_dup_overrides(
  overrides: [FieldInit],
  seen: [String],
  file: String,
  line: Int,
  col: Int,
  errs: [Diagnostic]
) : [Diagnostic] / Console + File {

  match overrides {
    [] -> errs
    [h, ...rest] -> match h {
      FI(n, _) -> {
        if str_in_list(n, seen) {
          let d = rl_error(file, line, col,
            concat_all(["record-spread override `", n,
                        "` listed more than once"]))
          check_spread_dup_overrides(rest, seen, file, line, col, [d, ...errs])
        } else {
          check_spread_dup_overrides(rest, [n, ...seen], file, line, col, errs)
        }
      }
    }
  }
}

#[doc("`errs` plus a diagnostic per override that names a field the record does not declare, each reported.")]
pub(pkg) fn check_spread_unknown_overrides(
  overrides: [FieldInit],
  fds: [FieldDecl],
  rec_name: String,
  file: String,
  line: Int,
  col: Int,
  errs: [Diagnostic]
) : [Diagnostic] / Console + File {

  match overrides {
    [] -> errs
    [h, ...rest] -> match h {
      FI(n, _) -> {
        if field_decl_has(fds, n) {
          check_spread_unknown_overrides(rest, fds, rec_name, file, line, col, errs)
        } else {
          let d = rl_error(file, line, col,
            concat_all(["record-spread override `", n,
                        "` is not a field of `", rec_name, "`"]))
          check_spread_unknown_overrides(rest, fds, rec_name, file, line, col, [d, ...errs])
        }
      }
    }
  }
}

fn field_decl_has(fds: [FieldDecl], name: String) : Bool {
  match fds {
    [] -> false
    [h, ...rest] -> match h {
      FD(_, n, _, _, _, _) -> if n == name { true } else { field_decl_has(rest, name) }
    }
  }
}

fn str_in_list(s: String, xs: [String]) : Bool {
  match xs {
    [] -> false
    [h, ...rest] -> if h == s { true } else { str_in_list(s, rest) }
  }
}

#[doc("The record a bare head `name` reaches from the view `v`: the one of that name on the nearest rung declaring any, the tie when that rung declares several.")]
pub(pkg) fn rh_on_ladder(t: SymTab, v: ScopeView, recs: [RecInfo], name: String) : SvRes =
  match sv_resolve_fit(t, v, [SvOwn, SvPicks, SvImports, SvCores], [NCType, NCExternType], name, (s) => is_some(rec_find(recs, s))) {
    SvFit(r, _) -> r
  }


#[doc("True when `fis` names every field of `fds` exactly once, in another order than the declared one.")]
pub(pkg) fn rh_out_of_order(fis: [FieldInit], fds: [FieldDecl]) : Bool =
  list_length(fis) == list_length(fds)
    and all(fds, (fd) => match fd { FD(_, dnm, _, _, _, _) -> init_index(fis, dnm, 0) >= 0 })
    and not in_declared_order(fis, fds)

#[doc("The binder a literal at `line`:`col` holds its `i`-th written field value in while the record is laid in declared order.")]
pub(pkg) fn rh_temp_binder(line: Int, col: Int, i: Int) : Binder =
  binder_minted("__rf_#{int_to_string(line)}_#{int_to_string(col)}_#{int_to_string(i)}__")

#[doc("The position the field `name` is written at in `fis`; -1 when it is not.")]
pub(pkg) fn rh_written_at(fis: [FieldInit], name: String) : Int = init_index(fis, name, 0)

fn in_declared_order(fis: [FieldInit], fds: [FieldDecl]) : Bool = match fis {
  [] -> true
  [FI(fnm, _), ...frest] -> match fds {
    [] -> true
    [FD(_, dnm, _, _, _, _), ...drest] -> fnm == dnm and in_declared_order(frest, drest)
  }
}

# The position `target` is written at in `fis`; -1 when it is not.
fn init_index(fis: [FieldInit], target: String, i: Int) : Int = match fis {
  [] -> -1
  [FI(nm, _), ...rest] -> if nm == target { i } else { init_index(rest, target, i + 1) }
}

# a named record literal lists each declared field exactly once.

#[doc("The diagnostics for a record literal whose field names are not exactly its declared ones.")]
pub(pkg) fn record_lit_field_errors(rec: String, given: [String], declared: [String]) : [String] =
  duplicate_errors(rec, given) ++ unknown_errors(rec, given, declared) ++ missing_errors(rec, given, declared)

fn duplicate_errors(rec: String, given: [String]) : [String] =
  uniq(given)
    |> filter((g) => count(given, (x) => x == g) > 1)
    |> map((g) => "field '#{g}' given more than once in #{rec} literal")

fn unknown_errors(rec: String, given: [String], declared: [String]) : [String] =
  uniq(given)
    |> filter((g) => not any(declared, (d) => d == g))
    |> map((g) => "no field '#{g}' on #{rec}#{literal_hint(g, absent(declared, given))}")

fn missing_errors(rec: String, given: [String], declared: [String]) : [String] =
  match absent(declared, given) {
    []    -> []
    [one] -> ["missing field '#{one}' in #{rec} literal"]
    many  -> ["missing fields #{quoted(many)} in #{rec} literal"]
  }

fn absent(declared: [String], given: [String]) : [String] =
  filter(declared, (d) => not any(given, (g) => g == d))

fn literal_hint(target: String, declared: [String]) : String =
  match closest_name(target, declared) {
    Some(sug) -> " (did you mean `#{sug}`?)"
    None      -> ""
  }

fn quoted(names: [String]) : String = join(map(names, (n) => "'#{n}'"), ", ")

#[doc("True when `fd` is `priv` and the reading module of `v` does not own `rec`, the declaration of the record type `rec_name`.")]
pub(pkg) fn field_hidden(v: TyHomeView, rec_name: String, rec: SymId, fd: FieldDecl) : Bool =
  match fd {
    FD(true, _, _, _, _, _)  -> false
    FD(false, _, _, _, _, _) -> not tsh_reader_owns(v, rec)
  }

#[doc("The error for reading the `priv` field `fname` of `rec_name` from outside `owner`, the module declaring it.")]
pub(pkg) fn priv_read_diag(file: String, line: Int, col: Int, fname: String,
                      rec_name: String, owner: Option[String]) : Diagnostic = {
  let o = owner_text(owner)
  mk_diag(SevError, file, line, col,
    "field `#{fname}` of `#{rec_name}` is private to module `#{o}`",
    [ri_help(file, line, col,
      "the field is declared `priv` in module `#{o}`; only fns inside that module can read it")])
}

#[doc("The error for a record literal naming the `priv` field `fname` of `rec_name` from outside `owner`, the module declaring it.")]
pub(pkg) fn priv_construct_diag(file: String, line: Int, col: Int, fname: String,
                           rec_name: String, owner: Option[String]) : Diagnostic = {
  let o = owner_text(owner)
  mk_diag(SevError, file, line, col,
    "cannot construct `#{rec_name}` from outside module `#{o}`: field `#{fname}` is private",
    [ri_help(file, line, col,
      "the field is declared `priv` in module `#{o}`; ask that module for a constructor fn")])
}

fn owner_text(owner: Option[String]) : String = match owner {
  Some(m) -> m
  None    -> "<root>"
}
