#[doc("""
The resolution resolve produces: one row per use site, keyed by the
ordinal the resolver's walk assigns it.

A use site is identified by *when the walk reaches it*, not by where it
sits in the source. Position keying is unsound here — desugaring mints
nodes carrying a parent's `(line, col)`, so distinct sites share one
span — and annotating the parser's `Expr` in place would push identity
into a tree three passes build before this one runs. The walk order is
the cheapest identity that is actually unique: deterministic for a
given decl stream, so a consumer replaying the walk indexes the same
row, and an integer, so a row costs one slot instead of a node.

Storage is columnar `Array` for the same reason `symtab.kai` is: a row
carries no cons cell and no per-row header, and a read never walks. The
columns are laid out once, at the end of the walk, from the rows the
resolver collected — see `ut_of_rows` for why that ordering is what
keeps `Mutable` out of every walker.

What a row records is the resolver's decision, not a guess a consumer
would have to re-derive: `URLocal` for a binder in scope, `URSym` for
the single declaration a name reaches, `URCands` when the bare name is
contested and the typer must narrow, `URUnres` when nothing declares
it (the site the resolver already reports on).
""")]

import compiler.symtab

#[doc("What the resolver decided a use site names.")]
pub type UseRes
  = URLocal
  | URSym(Int)
  | URCands([Int])
  | URUnres

#[doc("Columnar table of resolved use sites, indexed by walk ordinal `0 .. count - 1`.")]
pub type UseTab = { count: Int,
                    names: Array[String],
                    res: Array[UseRes],
                    lines: Array[Int],
                    cols: Array[Int] }

#[doc("The empty table: no use sites recorded.")]
pub fn ut_new() : UseTab =
  UseTab { count: 0,
           names: array_make(0, ""),
           res: array_make(0, URUnres),
           lines: array_make(0, 0),
           cols: array_make(0, 0) }

#[doc("How many use sites the table holds.")]
pub fn ut_count(t: UseTab) : Int = t.count

#[doc("True when `i` indexes a row of `t`.")]
pub fn ut_valid(t: UseTab, i: Int) : Bool = i >= 0 and i < t.count

#[doc("The name written at use site `i`, or the empty string when `i` is out of range.")]
pub fn ut_name(t: UseTab, i: Int) : String =
  if ut_valid(t, i) { array_get(t.names, i) } else { "" }

#[doc("What the resolver decided site `i` names. An out-of-range index reports `URUnres`.")]
pub fn ut_res(t: UseTab, i: Int) : UseRes =
  if ut_valid(t, i) { array_get(t.res, i) } else { URUnres }

#[doc("The source line of use site `i`, or 0 when `i` is out of range.")]
pub fn ut_line(t: UseTab, i: Int) : Int =
  if ut_valid(t, i) { array_get(t.lines, i) } else { 0 }

#[doc("The source column of use site `i`, or 0 when `i` is out of range.")]
pub fn ut_col(t: UseTab, i: Int) : Int =
  if ut_valid(t, i) { array_get(t.cols, i) } else { 0 }

#[doc("The symbol site `i` resolves to, or `None` when it names a local, is contested, or is unresolved.")]
pub fn ut_sym(t: UseTab, i: Int) : Option[SymId] = match ut_res(t, i) {
  URSym(s)  -> Some(SymId(s))
  URLocal   -> None
  URCands(_) -> None
  URUnres   -> None
}

#[doc("The candidate symbols site `i` is narrowed from, empty unless the bare name is contested.")]
pub fn ut_cands(t: UseTab, i: Int) : [SymId] = match ut_res(t, i) {
  URCands(is) -> ut_wrap(is)
  _           -> []
}

fn ut_wrap(is: [Int]) : [SymId] = match is {
  []           -> []
  [i, ...rest] -> [SymId(i), ...ut_wrap(rest)]
}

#[doc("One use site as the walk saw it, before the columns are laid out.")]
pub type URow = URow(String, UseRes, Int, Int)

#[doc("""
The columnar table for `rows`, which the walk collected newest-first.

Building here rather than pushing during the walk is what keeps
`Mutable` out of the resolver: the buffers are born in this function
and never cross a call boundary before it returns, so the writes are
unobservable and the effect is masked. A push-per-site table would
instead thread a live `Array` through every walker, making each one
declare a mutation its callers can witness.
""")]
pub fn ut_of_rows(rows: [URow]) : UseTab {
  let n = list_length(rows)
  ut_fill(rows, n - 1, UseTab { count: n,
                                names: array_make(n, ""),
                                res: array_make(n, URUnres),
                                lines: array_make(n, 0),
                                cols: array_make(n, 0) })
}

# `rows` is newest-first, so the fill walks it while counting the index
# down: site `k` of the walk lands at column `k`.
fn ut_fill(rows: [URow], i: Int, t: UseTab) : UseTab / Mutable = match rows {
  [] -> t
  [r, ...rest] -> ut_fill(rest, i - 1, ut_put(t, i, r))
}

fn ut_put(t: UseTab, i: Int, r: URow) : UseTab / Mutable = match r {
  URow(name, res, line, col) ->
    UseTab { count: t.count,
             names: array_set(t.names, i, name),
             res: array_set(t.res, i, res),
             lines: array_set(t.lines, i, line),
             cols: array_set(t.cols, i, col) }
}
