#[doc("""
Derive checks on field types: `Ord` and `BinSerialize` impls, the providers they accept, and law wrappers.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.core_refs
import compiler.diag_file
import compiler.diag
import compiler.util
import compiler.proto_resolve
import compiler.derive_reach
import compiler.protos_registry
import compiler.protos_derive_check
import compiler.protos_impls
import compiler.fnreg
import compiler.protos_derive_binser
import compiler.spec_names
import compiler.home_dup

#[doc("""
m12.8.z: pre-expansion validation for `#derive(Ord)`. Walks the
decl stream once to collect every type that has — or will have
after derivation — an `Ord` impl, then rejects any
`#derive(Ord) type T` whose fields/payloads reference a type that
does not appear in that set. The `T` itself is one of them, which
allows recursive types. Parametric type heads (`List`, `Option`,
`Result`, `Fn`) collapse to their constructor via `proto_type_ref`,
so a field of type `[Int]` is headed by `List` — and unless
`impl Ord for List` is declared, the derive is rejected.
""")]
pub(pkg) fn validate_derive_ord(ps: PScope, sg: ShapedGens, decls: [Decl], df: DiagFiles) : [Diagnostic] / Console {

  let providers = collect_ord_providers(ps, sg, decls, [])
  list_reverse(validate_derive_ord_loop(ps, sg, decls, df, providers, []))
}

fn validate_derive_ord_loop(ps: PScope, sg: ShapedGens, decls: [Decl], df: DiagFiles,
                              providers: [DeclRef], errs: [Diagnostic]) : [Diagnostic] / Console {

  match decls {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, tps, body, line, col, _, _, _, _) ->
          if derives_gen(ps, sg, names, derive_from(ps, inner), CpOrd) {
            let file = decl_diag_file(d, df)
            let cx = VdvCx { ps: ps, from: derive_from(ps, inner) }
            let errs1 = validate_derive_ord_body(cx, file, vdv_type_name(ps, tsym), body,
                                                  derive_bound_params(tps), providers,
                                                  line, col, errs)
            validate_derive_ord_loop(ps, sg, rest, df, providers, errs1)
          } else {
            validate_derive_ord_loop(ps, sg, rest, df, providers, errs)
          }
        _ -> validate_derive_ord_loop(ps, sg, rest, df, providers, errs)
      }
      DUnstable(inner, _, _) ->
        validate_derive_ord_loop(ps, sg, [inner, ...rest], df, providers, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derive_ord_loop(ps, sg, [inner, ...rest], df, providers, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derive_ord_loop(ps, sg, [inner, ...rest], df, providers, errs)
      DConstructor(inner, _, _) ->
        validate_derive_ord_loop(ps, sg, [inner, ...rest], df, providers, errs)
      _ -> validate_derive_ord_loop(ps, sg, rest, df, providers, errs)
    }
  }
}

# `params` names the type parameters the derive bounds by `Ord`: a
# field typed by one of them is covered by that bound.
fn validate_derive_ord_body(cx: VdvCx, file: String, tname: String, body: TypeBody,
                              params: [TBinder], providers: [DeclRef], line: Int, col: Int,
                              errs: [Diagnostic]) : [Diagnostic] / Console {

  match body {
    TBRecord(fields) -> validate_derive_ord_fields(cx, file, tname, fields,
                                                     params, providers, line, col, errs)
    TBSum(variants) -> validate_derive_ord_variants(cx, file, tname, variants,
                                                      params, providers, line, col, errs)
    # Aliases / effect-aliases never reach derive — `derive_ord_impl`
    # returns None for them and the existing pipeline handles the
    # resulting "no impl" surface elsewhere. Nothing to validate here.
    _ -> errs
  }
}

fn validate_derive_ord_fields(cx: VdvCx, file: String, tname: String,
                                fields: [FieldDecl], params: [TBinder], providers: [DeclRef],
                                line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {

  match fields {
    [] -> errs
    [fd, ...rest] -> match fd {
      FD(_, fname, ftype, _, _, _) -> {
        let errs1 = validate_derive_ord_one(cx, file, tname, fname, "field",
                                              ftype, params, providers, line, col, errs)
        validate_derive_ord_fields(cx, file, tname, rest, params, providers, line, col, errs1)
      }
    }
  }
}

fn validate_derive_ord_variants(cx: VdvCx, file: String, tname: String,
                                  variants: [Variant], params: [TBinder], providers: [DeclRef],
                                  line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {

  match variants {
    [] -> errs
    [v, ...rest] -> match v {
      Var(vsym, vargs, _, _) -> {
        let vname = written_text(sym_name(ps_tab(cx.ps), vsym))
        let errs1 = validate_derive_ord_payload(cx, file, tname, vname, vargs, 0,
                                                  params, providers, line, col, errs)
        validate_derive_ord_variants(cx, file, tname, rest, params, providers, line, col, errs1)
      }
    }
  }
}

fn validate_derive_ord_payload(cx: VdvCx, file: String, tname: String, vname: String,
                                 vargs: [TypeExpr], idx: Int,
                                 params: [TBinder], providers: [DeclRef], line: Int, col: Int,
                                 errs: [Diagnostic]) : [Diagnostic] / Console {

  match vargs {
    [] -> errs
    [vt, ...rest] -> {
      let label = concat_all([vname, " payload #", int_to_string(idx)])
      let errs1 = validate_derive_ord_one(cx, file, tname, label, "variant",
                                            vt, params, providers, line, col, errs)
      validate_derive_ord_payload(cx, file, tname, vname, rest, idx + 1,
                                    params, providers, line, col, errs1)
    }
  }
}

fn validate_derive_ord_one(cx: VdvCx, file: String, tname: String, fname: String,
                             kind: String, ftype: TypeExpr,
                             params: [TBinder], providers: [DeclRef], line: Int, col: Int,
                             errs: [Diagnostic]) : [Diagnostic] / Console {
  let tab = ps_tab(cx.ps)
  let href = vdv_head(cx.ps, ftype, cx.from)
  if is_some(te_param_of(ftype, params)) {
    errs
  } else if vdv_provided(tab, providers, href) {
    errs
  } else {
    let head = ref_text(tab, href)
    let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(Ord)]` for `", tname,
      "`: no `Ord` impl for ", kind, " `", fname, "` of type `", head,
      "` (declare `impl Ord for ", head, "` or `#[derive(Ord)]` on `", head, "`)"]))
    [derr, ...errs]
  }
}

#[doc("""
Pre-expansion validator for `#derive(BinSerialize)`. Same shape as
`validate_derive_ord`: collect every type that has — or will have —
a BinSerialize impl, then reject any derive whose fields/payloads
reference a type outside that set. The type itself is one of them
(recursive types are legal). The user gets a typer-time message
pointing at the offending field instead of the dispatcher's
generic runtime panic.
""")]
pub(pkg) fn validate_derive_binserialize(ps: PScope, decls: [Decl], df: DiagFiles) : [Diagnostic] / Console {

  let providers = binser_type_refs(ps, decls, true, [])
  list_reverse(validate_derive_binser_loop(ps, decls, df, providers, []))
}

fn validate_derive_binser_loop(ps: PScope, decls: [Decl], df: DiagFiles,
                                 providers: [DeclRef], errs: [Diagnostic]) : [Diagnostic] / Console {

  match decls {
    [] -> errs
    [d, ...rest] -> match d {
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, _, body, line, col, _, _, _, _) ->
          if derives_core(ps, names, derive_from(ps, inner), CpBinSerialize) {
            let file = decl_diag_file(d, df)
            let cx = VdvCx { ps: ps, from: derive_from(ps, inner) }
            let errs1 = validate_derive_binser_body(cx, file, vdv_type_name(ps, tsym), body,
                                                     providers, line, col, errs)
            validate_derive_binser_loop(ps, rest, df, providers, errs1)
          } else {
            validate_derive_binser_loop(ps, rest, df, providers, errs)
          }
        _ -> validate_derive_binser_loop(ps, rest, df, providers, errs)
      }
      DUnstable(inner, _, _) ->
        validate_derive_binser_loop(ps, [inner, ...rest], df, providers, errs)
      DProtoLaws(_, inner, _, _, _) ->
        validate_derive_binser_loop(ps, [inner, ...rest], df, providers, errs)
      DImplAxiom(_, inner, _, _, _) ->
        validate_derive_binser_loop(ps, [inner, ...rest], df, providers, errs)
      DConstructor(inner, _, _) ->
        validate_derive_binser_loop(ps, [inner, ...rest], df, providers, errs)
      _ -> validate_derive_binser_loop(ps, rest, df, providers, errs)
    }
  }
}

fn validate_derive_binser_body(cx: VdvCx, file: String, tname: String, body: TypeBody,
                                 providers: [DeclRef], line: Int, col: Int,
                                 errs: [Diagnostic]) : [Diagnostic] / Console {

  match body {
    TBRecord(fields) -> validate_derive_binser_fields(cx, file, tname, fields,
                                                        providers, line, col, errs)
    TBSum(variants) -> validate_derive_binser_variants(cx, file, tname, variants,
                                                         providers, line, col, errs)
    _ -> errs
  }
}

fn validate_derive_binser_fields(cx: VdvCx, file: String, tname: String,
                                   fields: [FieldDecl], providers: [DeclRef],
                                   line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {

  match fields {
    [] -> errs
    [fd, ...rest] -> match fd {
      FD(_, fname, ftype, _, _, _) -> {
        let errs1 = validate_derive_binser_one(cx, file, tname, fname, "field",
                                                 ftype, providers, line, col, errs)
        validate_derive_binser_fields(cx, file, tname, rest, providers,
                                        line, col, errs1)
      }
    }
  }
}

fn validate_derive_binser_variants(cx: VdvCx, file: String, tname: String,
                                     variants: [Variant], providers: [DeclRef],
                                     line: Int, col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {

  match variants {
    [] -> errs
    [v, ...rest] -> match v {
      Var(vsym, vargs, _, _) -> {
        let vname = written_text(sym_name(ps_tab(cx.ps), vsym))
        let errs1 = validate_derive_binser_payload(cx, file, tname, vname, vargs, 0,
                                                     providers, line, col, errs)
        validate_derive_binser_variants(cx, file, tname, rest, providers,
                                          line, col, errs1)
      }
    }
  }
}

fn validate_derive_binser_payload(cx: VdvCx, file: String, tname: String, vname: String,
                                    vargs: [TypeExpr], idx: Int,
                                    providers: [DeclRef], line: Int, col: Int,
                                    errs: [Diagnostic]) : [Diagnostic] / Console {

  match vargs {
    [] -> errs
    [vt, ...rest] -> {
      let label = concat_all([vname, " payload #", int_to_string(idx)])
      let errs1 = validate_derive_binser_one(cx, file, tname, label, "variant",
                                               vt, providers, line, col, errs)
      validate_derive_binser_payload(cx, file, tname, vname, rest, idx + 1,
                                       providers, line, col, errs1)
    }
  }
}

fn validate_derive_binser_one(cx: VdvCx, file: String, tname: String, fname: String,
                                kind: String, ftype: TypeExpr,
                                providers: [DeclRef], line: Int, col: Int,
                                errs: [Diagnostic]) : [Diagnostic] / Console {
  let tab = ps_tab(cx.ps)
  let href = vdv_head(cx.ps, ftype, cx.from)
  if vdv_provided(tab, providers, href) {
    errs
  } else if binser_builtin_impl(ftype) {
    errs
  } else if binser_collection_head(ftype) {
    # `List` and `Option` route through `bin_list_*` / `bin_option_*`
    # combinators emitted by the derive. Validate that the element
    # type still has a usable impl/derive, recursively.
    validate_derive_binser_collection_elem(cx, file, tname, fname, kind, ftype,
                                             ref_text(tab, href), providers, line, col, errs)
  } else {
    let head = ref_text(tab, href)
    let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(BinSerialize)]` for `", tname,
      "`: no `BinSerialize` impl for ", kind, " `", fname, "` of type `", head,
      "` (declare `impl BinSerialize for ", head,
      "` or `#[derive(BinSerialize)]` on `", head, "`)"]))
    [derr, ...errs]
  }
}

fn binser_collection_head(ftype: TypeExpr) : Bool = match binser_leaf_ty(resolve_ty(ftype)) {
  TyListT(_)  -> true
  TyCon(s, _) -> core_ty_is(s, CtList) or core_ty_is(s, CtOption)
  _           -> false
}

# `TyList(elem)` and `Option[elem]` are valid only when `elem` is
# itself a builtin, a collection (recursive case for `[[Foo]]`), or a
# provider in scope. Anything else is reported as missing — but the
# message names the *element* type, not the outer `List`/`Option`,
# because the user's mental model is "BinSerialize for Foo is what
# I need to add".
fn validate_derive_binser_collection_elem(cx: VdvCx, file: String, tname: String,
                                            fname: String, kind: String,
                                            ftype: TypeExpr, head: String,
                                            providers: [DeclRef], line: Int,
                                            col: Int, errs: [Diagnostic]) : [Diagnostic] / Console {
  let elem_opt = binser_collection_elem(ftype)
  match elem_opt {
    None -> {
      # `Option` without a type arg, or other malformed shape. Report
      # against the outer head so the user knows the shape is wrong.
      let derr = derive_error(file, line, col, concat_all(["cannot `#[derive(BinSerialize)]` for `", tname,
        "`: ", kind, " `", fname, "` has shape `", head,
        "` without an element type"]))
      [derr, ...errs]
    }
    Some(elem) -> validate_derive_binser_one(cx, file, tname, fname, kind, elem,
                                                providers, line, col, errs)
  }
}

fn binser_collection_elem(ftype: TypeExpr) : Option[TypeExpr] {
  match ftype.tkind {
    TyList(elem) -> Some(elem)
    _            -> binser_option_elem(ftype)
  }
}

# Atomic types with hand-written impls in stdlib/protocols.kai.
# Mirrors `derive_builtin_impl` for Eq/Hash/Show; kept separate to
# avoid coupling BinSerialize's whitelist to the protocols that
# pre-existed it. `Byte` is written and read as one raw byte by code the
# derive emits; `Char` rides hand-written `bin_char_*` helpers.
fn binser_builtin_impl(ftype: TypeExpr) : Bool = match binser_leaf_ty(resolve_ty(ftype)) {
  TyInt    -> true
  TyReal   -> true
  TyBool   -> true
  TyString -> true
  TyByte   -> true
  TyChar   -> true
  _        -> false
}

#[doc("""
The emitted names of the types deriving BinSerialize, plus with `impls`
those with a hand-written impl.
""")]
pub(pkg) fn collect_binser_types(ps: PScope, decls: [Decl], impls: Bool, acc: [String]) : [String] =
  list_append(map(binser_type_refs(ps, decls, impls, []), (r) => rt_ref_name(ps_tab(ps), r)), acc)

fn binser_type_refs(ps: PScope, decls: [Decl], impls: Bool, acc: [DeclRef]) : [DeclRef] {
  match decls {
    [] -> acc
    [d, ...rest] -> match d {
      DImpl(pref, _, target, ms, _, _, _, _) ->
        if impls and proto_is(proto_ref_sym(ps, pref, impl_home_of(ms)), CpBinSerialize) {
          binser_type_refs(ps, rest, impls, [vdv_head(ps, target, impl_home_of(ms)), ...acc])
        } else {
          binser_type_refs(ps, rest, impls, acc)
        }
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, _, _, _, _, _, _, _, _) ->
          if derives_core(ps, names, derive_from(ps, inner), CpBinSerialize) {
            binser_type_refs(ps, rest, impls, [DrSym(tsym), ...acc])
          } else {
            binser_type_refs(ps, rest, impls, acc)
          }
        _ -> binser_type_refs(ps, rest, impls, acc)
      }
      DUnstable(inner, _, _) ->
        binser_type_refs(ps, [inner, ...rest], impls, acc)
      DProtoLaws(_, inner, _, _, _) ->
        binser_type_refs(ps, [inner, ...rest], impls, acc)
      DImplAxiom(_, inner, _, _, _) ->
        binser_type_refs(ps, [inner, ...rest], impls, acc)
      DConstructor(inner, _, _) ->
        binser_type_refs(ps, [inner, ...rest], impls, acc)
      _ -> binser_type_refs(ps, rest, impls, acc)
    }
  }
}

fn collect_ord_providers(ps: PScope, sg: ShapedGens, decls: [Decl], acc: [DeclRef]) : [DeclRef] {
  match decls {
    [] -> acc
    [d, ...rest] -> match d {
      DImpl(pref, _, target, ms, _, _, _, _) ->
        if gen_is(proto_gen(sg, proto_ref_sym(ps, pref, impl_home_of(ms))), CpOrd) {
          collect_ord_providers(ps, sg, rest, [vdv_head(ps, target, impl_home_of(ms)), ...acc])
        } else {
          collect_ord_providers(ps, sg, rest, acc)
        }
      DDerive(names, inner, _, _) -> match inner {
        DType(_, tsym, _, _, _, _, _, _, _, _) ->
          if derives_gen(ps, sg, names, derive_from(ps, inner), CpOrd) {
            collect_ord_providers(ps, sg, rest, [DrSym(tsym), ...acc])
          } else {
            collect_ord_providers(ps, sg, rest, acc)
          }
        _ -> collect_ord_providers(ps, sg, rest, acc)
      }
      DUnstable(inner, _, _) ->
        collect_ord_providers(ps, sg, [inner, ...rest], acc)
      DProtoLaws(_, inner, _, _, _) ->
        collect_ord_providers(ps, sg, [inner, ...rest], acc)
      DImplAxiom(_, inner, _, _, _) ->
        collect_ord_providers(ps, sg, [inner, ...rest], acc)
      DConstructor(inner, _, _) ->
        collect_ord_providers(ps, sg, [inner, ...rest], acc)
      _ -> collect_ord_providers(ps, sg, rest, acc)
    }
  }
}

# The theory each protocol declares, and the impls exempted by
# `axiom <Theory>`. An impl has neither an id nor a name: it is the one
# written at that position of its module, so an exemption cannot reach
# an unrelated impl, which would silently bypass a verification.
pub(pkg) type LawReg = LR([ProtoLaw], [AxiomImpl])
pub(pkg) type ProtoLaw = PL(SymId, String)                    # protocol, theory
pub(pkg) type AxiomImpl = AI(Option[String], Int, Int, String) # home, impl line, impl col, theory

fn law_reg_protocols(r: LawReg) : [ProtoLaw] = match r { LR(ps, _) -> ps }
fn law_reg_axioms(r: LawReg) : [AxiomImpl] = match r { LR(_, xs) -> xs }

#[doc("The theory the protocol `proto` declares its ops obey via `laws`, if any.")]
pub(pkg) fn law_theory_of(r: LawReg, proto: SymId) : Option[String] =
  law_theory_loop(law_reg_protocols(r), proto)

fn law_theory_loop(ps: [ProtoLaw], proto: SymId) : Option[String] = match ps {
  [] -> None
  [PL(p, thy), ...rest] ->
    if sym_raw(proto) >= 0 and sym_raw(p) == sym_raw(proto) { Some(thy) }
    else { law_theory_loop(rest, proto) }
}

#[doc("True when the impl written at `line:col` of the module `home` is exempted from law-checks by an `axiom` clause.")]
pub(pkg) fn law_impl_axiomed(r: LawReg, home: Option[String], line: Int, col: Int) : Bool =
  law_axiom_loop(law_reg_axioms(r), home, line, col)

fn law_axiom_loop(xs: [AxiomImpl], home: Option[String], line: Int, col: Int) : Bool = match xs {
  [] -> false
  [AI(h, l, c, _), ...rest] ->
    if l == line and c == col and home_eq(h, home) { true }
    else { law_axiom_loop(rest, home, line, col) }
}

#[doc("""
Unwrap every `DProtoLaws` / `DImplAxiom` wrapper to its bare inner decl,
returning the flattened decl stream and the law registry. Runs before
any other Decl walker so downstream passes see only plain
protocols/impls, mirroring `lower_axioms`.
""")]
pub(pkg) fn strip_law_wrappers(decls: [Decl]) : StrippedLaws =
  strip_law_loop(decls, [], [], [])

pub(pkg) type StrippedLaws = SL([Decl], LawReg)

pub(pkg) fn strip_sl_decls(s: StrippedLaws) : [Decl] = match s { SL(ds, _) -> ds }
pub(pkg) fn strip_sl_reg(s: StrippedLaws) : LawReg = match s { SL(_, r) -> r }

fn strip_law_loop(decls: [Decl], acc: [Decl], laws: [ProtoLaw],
                  axioms: [AxiomImpl]) : StrippedLaws = match decls {
  [] -> SL(list_reverse(acc), LR(list_reverse(laws), list_reverse(axioms)))
  [d, ...rest] -> match d {
    DProtoLaws(thy, DProtocol(a, psym, b, c, l, cc, nl, nc, mo), _, _, _) ->
      strip_law_loop(rest, [DProtocol(a, psym, b, c, l, cc, nl, nc, mo), ...acc],
                     [PL(psym, thy), ...laws], axioms)
    DImplAxiom(thy, DImpl(pref, pa, target, ms, l, cc, tps, _), _, _, amo) ->
      strip_law_loop(rest, [DImpl(pref, pa, target, ms, l, cc, tps, sym_none()), ...acc],
                     laws, [AI(amo, l, cc, thy), ...axioms])
    _ -> strip_law_loop(rest, [d, ...acc], laws, axioms)
  }
}
