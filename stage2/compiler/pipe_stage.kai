#[doc("""
The `.` placeholders a `|`, `||`, `|?` or `|!` stage owns.

Every `.` on a stage's right side stands for the stage's element: a bare
`.`, a point-free section, a `.` the call-argument rule already wrapped,
and one inside a `#{...}` body. They all share the section binder, so a
wrapped `.` joins the stage by dropping its wrapper. Explicit lambdas
and handlers are barriers; a nested stage owns the dots on its own right
side.
""")]

import compiler.ast
import compiler.ast_map
import compiler.expr_positions

#[doc("A stage's right side with its dots claimed (unchanged when it has none), or the nested stage that uses `.` too.")]
pub type StageRhs = SrOwn(Expr) | SrNested(Expr)

#[doc("Claim every `.` on the right side `rhs` of a dispatch pipe for the stage's element.")]
pub fn stage_claim(rhs: Expr) : StageRhs {
  let sc = sd_scan(rhs, SdScan { owns: false, nested: None })
  match sc.nested {
    Some(inner) -> if sc.owns { SrNested(inner) } else { SrOwn(rhs) }
    None        -> if sc.owns { SrOwn(stage_lambda(rhs)) } else { SrOwn(rhs) }
  }
}

fn stage_lambda(rhs: Expr) : Expr {
  let param = Param { binder: point_free_binder(), ptype: None,
                      pline: rhs.line, pcol: rhs.col, pborrow: false }
  mk_expr(ELambda([param], sd_claim(rhs)), rhs.line, rhs.col)
}

# Whether the stage owns a `.`, and the first nested stage that owns one.
type SdScan = { owns: Bool, nested: Option[Expr] }

fn sd_scan(e: Expr, acc: SdScan) : SdScan = match e.kind {
  EPlaceholder -> SdScan { ...acc, owns: true }
  ELambda(ps, body) ->
    if params_point_free(ps) { sd_scan(body, SdScan { ...acc, owns: true }) }
    else if params_pipe_apply(ps) { sd_scan(body, acc) }
    else { acc }
  EHandle(_, _, _, _, _, _, _) -> acc
  EDispatchPipe(_, a, b) -> sd_scan(a, sd_inner(e, b, acc))
  _ -> sd_kids(xp_positions(e), acc)
}

fn sd_kids(ps: [XPos], acc: SdScan) : SdScan = match ps {
  [] -> acc
  [XP(_, x), ...rest] -> sd_kids(rest, sd_scan(x, acc))
}

# A nested stage claimed its dots exactly when its right side is a section.
fn sd_inner(stage: Expr, rhs: Expr, acc: SdScan) : SdScan = match rhs.kind {
  ELambda(ps, _) -> match acc.nested {
    None    -> if params_point_free(ps) { SdScan { ...acc, nested: Some(stage) } } else { acc }
    Some(_) -> acc
  }
  _ -> acc
}

fn sd_claim(e: Expr) : Expr = match e.kind {
  EPlaceholder -> mk_local(point_free_binder().id, e.line, e.col)
  ELambda(ps, body) ->
    if params_point_free(ps) { sd_claim(body) }
    else if params_pipe_apply(ps) { sd_with(e, ELambda(ps, sd_claim(body))) }
    else { e }
  EHandle(_, _, _, _, _, _, _) -> e
  EDispatchPipe(op, a, b) -> sd_with(e, EDispatchPipe(op, sd_claim(a), b))
  k -> sd_with(e, prc_map_expr_kind(k, sd_claim))
}

fn sd_with(e: Expr, k: ExprKind) : Expr = Expr { ...e, kind: k }

#[doc("True when `e` calls a method on the local `l`, which only the type of `l` can resolve.")]
pub fn stage_receiver_of(l: LocalId, e: Expr) : Bool = match e.kind {
  ECall(callee, _) -> match callee.kind {
    EField(obj, _) -> sr_is_local(l, obj) or sr_kids(l, xp_positions(e))
    _              -> sr_kids(l, xp_positions(e))
  }
  _ -> sr_kids(l, xp_positions(e))
}

fn sr_is_local(l: LocalId, e: Expr) : Bool = match e.kind {
  ELocal(x) -> local_eq(x, l)
  _         -> false
}

fn sr_kids(l: LocalId, ps: [XPos]) : Bool = match ps {
  [] -> false
  [XP(_, c), ...rest] -> stage_receiver_of(l, c) or sr_kids(l, rest)
}
