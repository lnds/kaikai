#[doc("""
Mutually recursive groups of a tail-call graph: its strongly connected
components of two or more members.

Each unresolved root, in ascending index order, takes a forward BFS over
a successor index and a backward BFS over the predecessor index kept
inside the forward set; the component is the nodes both reach. Members
come out in reverse forward-visit order and a single-node component
resolves only its root. The fusion output depends on both, so the order
is part of the contract.
""")]

import compiler.tailgraph
import compiler.tailgraph_csr

#[doc("The mutually recursive tail-call groups of `g`: every strongly connected component with two or more members, ordered by lowest member index. Self-loops are excluded — a component of one member is the self-tail case the existing rewrite already handles.")]
pub fn tailgraph_groups(g: TailGraph) : [TgGroup] {
  let n = list_length(tailgraph_nodes(g))
  tg_groups_from(tg_scc_new(n, tailgraph_edges(g)), 0, n)
}

# `mark[v] == root` means `v` was reached from `root`; a bounded walk
# only enters nodes with `within[v] == root`.
type TgBfs = { adj: TgCsr, mark: Array[Int], queue: Array[Int], within: Array[Int], bounded: Bool }

type TgScc = { fwd: TgBfs, bwd: TgBfs, done: Array[Int] }

fn tg_scc_new(n: Int, es: [TgEdge]) : TgScc {
  let fmark = array_make(n, 0 - 1)
  let fwd = TgBfs { adj: tg_csr(n, es), mark: fmark, queue: array_make(n, 0),
                    within: fmark, bounded: false }
  let bwd = TgBfs { adj: tg_csr(n, tg_flip(es, [])), mark: array_make(n, 0 - 1),
                    queue: array_make(n, 0), within: fmark, bounded: true }
  TgScc { fwd, bwd, done: array_make(n, 0) }
}

fn tg_groups_from(s: TgScc, i: Int, n: Int) : [TgGroup] / Mutable =
  if i >= n { [] }
  else if s.done[i] == 1 { tg_groups_from(s, i + 1, n) }
  else {
    let comp = tg_component_of(s, i)
    if list_length(comp) >= 2 {
      let _ = tg_mark_done(s.done, comp)
      [TgGrp(comp), ...tg_groups_from(s, i + 1, n)]
    } else {
      s.done[i] := 1
      tg_groups_from(s, i + 1, n)
    }
  }

fn tg_mark_done(done: Array[Int], xs: [Int]) : Array[Int] / Mutable = match xs {
  [] -> done
  [x, ...rest] -> {
    done[x] := 1
    tg_mark_done(done, rest)
  }
  _ -> done
}

# The component of `i` is every node reachable from `i` that also
# reaches `i` back.
fn tg_component_of(s: TgScc, i: Int) : [Int] / Mutable = {
  let nf = tg_bfs_from(s.fwd, i)
  let _ = tg_bfs_from(s.bwd, i)
  tg_keep_back(s.fwd.queue, s.bwd.mark, i, 0, nf, [])
}

fn tg_keep_back(order: Array[Int], back: Array[Int], i: Int, k: Int, n: Int, acc: [Int]) : [Int] =
  if k >= n { acc }
  else if back[order[k]] == i { tg_keep_back(order, back, i, k + 1, n, [order[k], ...acc]) }
  else { tg_keep_back(order, back, i, k + 1, n, acc) }

# The number of nodes reached; they sit in visit order at the front of
# the walk's queue.
fn tg_bfs_from(b: TgBfs, root: Int) : Int / Mutable = {
  b.mark[root] := root
  b.queue[0] := root
  tg_bfs(b, root, 0, 1)
}

fn tg_bfs(b: TgBfs, root: Int, head: Int, tail: Int) : Int / Mutable =
  if head >= tail { tail }
  else {
    let v = b.queue[head]
    tg_bfs(b, root, head + 1, tg_push_succs(b, root, b.adj.off[v], b.adj.off[v + 1], tail))
  }

fn tg_push_succs(b: TgBfs, root: Int, k: Int, end: Int, tail: Int) : Int / Mutable =
  if k >= end { tail }
  else {
    let w = b.adj.dst[k]
    if b.mark[w] == root or (b.bounded and b.within[w] != root) {
      tg_push_succs(b, root, k + 1, end, tail)
    } else {
      b.mark[w] := root
      b.queue[tail] := w
      tg_push_succs(b, root, k + 1, end, tail + 1)
    }
  }
