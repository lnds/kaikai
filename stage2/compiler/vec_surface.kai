import compiler.ast
import compiler.ast_build
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_ids
import compiler.core_builtins
import compiler.util
import compiler.kinds
import compiler.core_types
import compiler.lazy_seq

# Vec surface rewrites: the AST-only halves of the Vec literal build
# and the Vec-scrutinee match lowering. The typer owns the gates
# (types, diagnostics, exhaustiveness) and synthesises what is built
# here ONCE.

# ---- node builders ----

fn vs_int(n: Int, line: Int, col: Int) : Expr = mk_expr(mk_int_synth(n), line, col)

# A call of the core builtin `f`.
fn vs_call(f: String, args: [Expr], line: Int, col: Int) : Expr =
  mk_expr(ECall(mk_sym(builtin_sym(f), line, col), args), line, col)

fn vs_let(b: Binder, rhs: Expr, line: Int, col: Int) : Stmt =
  SLet(Pattern { pkind: PBind(b), line: line, col: col }, None, rhs)

# ---- Vec literal ----

# The chain is built ALREADY TYPED (every call node carries `vty`) and
# is never re-synthesised: the elements arrive typed from the element
# check, and a re-synth would undo context retags (a Byte-minted `65`
# reverts to Int). Same discipline as the fusion's composed lambda.
#[doc("Build the typed `vec_reserve`/`vec_push` chain for a Vec-minted `[e1, ..., en]` literal — one pre-sized buffer, n in-place appends.")]
pub(pkg) fn vec_lit_build(elems: [Expr], vty: Ty, line: Int, col: Int) : Expr =
  match elems {
    [] -> with_ty(vs_call("vec_empty", [], line, col), vty)
    _  -> {
      let n = with_ty(vs_int(list_length(elems), line, col), TyInt)
      let reserve = with_ty(vs_call("vec_reserve", [n], line, col), vty)
      vec_lit_pushes(elems, reserve, vty, line, col)
    }
  }

# A fixed-width `Vec[e]<n>` literal lowers NOT to a `vec_reserve`/`vec_push`
# chain (that builds the dynamic heap vec) but to the `__fixed_vec_lit`
# intrinsic the C emitter renders as a flat by-value aggregate. Elements
# arrive typed from the element check; the branded type rides the call node.
#[doc("Build the `__fixed_vec_lit` intrinsic for a concrete `Vec[e]<n>` literal — a flat inline aggregate, no heap, no header.")]
pub(pkg) fn fixed_vec_lit_build(elems: [Expr], bty: Ty, line: Int, col: Int) : Expr =
  with_ty(mk_expr(ECall(mk_expr(EMark(MkFixedVecLit), line, col), elems), line, col), bty)

fn vec_lit_pushes(elems: [Expr], acc: Expr, vty: Ty, line: Int, col: Int) : Expr =
  match elems {
    [] -> acc
    [x, ...rest] -> {
      let push = with_ty(vs_call("vec_push", [acc, x], line, col), vty)
      vec_lit_pushes(rest, push, vty, line, col)
    }
  }

# ---- Vec-scrutinee match ----

# A `match` over a `Vec[T]` whose arms are list patterns cannot ride
# the cons/nil machinery: a vec is one flat node, not a spine. Instead
# the typer rewrites the whole match into an `if`-chain of O(1) length
# tests, `vec_get` element binds and ONE `vec_tail_from` slice per rest
# binder — every downstream pass (perceus, tcrec, reuse, both emitters)
# sees only standard lets, ifs and prims. The tail bind is an O(1)
# view: consuming a unique view re-slices the same node in place, so a
# `[h, ...t]` descent allocates nothing per level.

# The supported arm shapes. Heads must be simple binders (`PBind` /
# `PWild` / `PHole`) — a discriminating head would need arm fallthrough
# out of an already-taken branch, which an if-chain cannot express.
pub(pkg) type VecArmKind
  # `[a, b, ...rest]`: fixed head patterns + optional rest binder.
  = VArmList([Pattern], Option[Binder])
  # `name as [a, ...rest]`: bind the whole vec, then the list shape.
  | VArmAs(Binder, [Pattern], Option[Binder])
  # catch-all: `_`, a whole-vec binder, or `name as _`.
  | VArmCatch(Option[Binder])
  # anything else — the typer diagnoses and declines the rewrite.
  | VArmUnsupported

#[doc("Classify one Vec-match arm pattern into its supported shape (or `VArmUnsupported`).")]
pub(pkg) fn vec_arm_kind(p: Pattern) : VecArmKind =
  match p.pkind {
    PList(pats, rest) ->
      if vec_heads_simple(pats) { VArmList(pats, rest) } else { VArmUnsupported }
    PWild      -> VArmCatch(None)
    PHole(_)   -> VArmCatch(None)
    PBind(nm)  -> VArmCatch(Some(nm))
    PAs(nm, inner) -> vec_as_arm_kind(nm, inner)
    _ -> VArmUnsupported
  }

fn vec_as_arm_kind(nm: Binder, inner: Pattern) : VecArmKind =
  match inner.pkind {
    PList(pats, rest) ->
      if vec_heads_simple(pats) { VArmAs(nm, pats, rest) } else { VArmUnsupported }
    PWild -> VArmCatch(Some(nm))
    _     -> VArmUnsupported
  }

fn vec_heads_simple(pats: [Pattern]) : Bool =
  match pats {
    [] -> true
    [p, ...rest] -> match p.pkind {
      PBind(_) -> vec_heads_simple(rest)
      PWild    -> vec_heads_simple(rest)
      PHole(_) -> vec_heads_simple(rest)
      _        -> false
    }
  }

#[doc("True when some arm pattern is a list shape — the trigger for the Vec-match rewrite.")]
pub(pkg) fn vec_match_has_list_arm(arms: [Arm]) : Bool =
  match arms {
    [] -> false
    [Arm(p, _, _), ...rest] ->
      if vec_pat_is_list(p) { true } else { vec_match_has_list_arm(rest) }
  }

fn vec_pat_is_list(p: Pattern) : Bool =
  match p.pkind {
    PList(_, _)   -> true
    PAs(_, inner) -> vec_pat_is_list(inner)
    _             -> false
  }

# Perceus identity invariant, load-bearing: every read of the scrutinee this
# builder emits carries a DISTINCT (line, col) — perceus keys last-use
# and move-at-last-use decisions on node positions, and a duplicated
# position silently mis-plans RC. Each use takes the arm pattern's
# position plus a small per-role column offset (test +0, as-bind +1,
# element i +2+i, tail +2+n), all smaller than the pattern's own width.
#
# A bare local scrutinee is used DIRECTLY (no alias let): the borrowed
# length/get reads discount to zero and the consuming `vec_tail_from`
# re-thread is the param's single real consumer, which is exactly the
# shape perceus moves raw — the unique view then re-slices in place.
# An alias let would be multi-use and dup every read.
#[doc("Build the if-chain replacing a Vec-scrutinee match. Arms must already be validated.")]
pub(pkg) fn vec_match_build(scr: Expr, arms: [Arm], line: Int, col: Int) : Expr =
  match scr.kind {
    ELocal(l) ->
      if vec_match_binds(arms, l) { vec_match_build_alias(scr, arms, line, col) }
      else { vm_chain(arms, l, line, col) }
    _ -> vec_match_build_alias(scr, arms, line, col)
  }

# Complex scrutinee (or an arm rebinding the scrutinee's binder):
# bind it once and chain over the alias. The alias is a multi-use let,
# so its reads dup conservatively — correct, just not the zero-alloc
# descent shape.
fn vec_match_build_alias(scr: Expr, arms: [Arm], line: Int, col: Int) : Expr {
  let vn = binder_minted(concat_all(["__vecm_", int_to_string(line), "_", int_to_string(col)]))
  let chain = vm_chain(arms, vn.id, line, col)
  mk_expr(EBlock([vs_let(vn, scr, line, col)], Some(chain)), line, col)
}

# True when any arm declares the binder `l` (head, rest, as-name or
# catch-all) — the direct chain would rebind the scrutinee mid-arm.
fn vec_match_binds(arms: [Arm], l: LocalId) : Bool =
  match arms {
    [] -> false
    [Arm(p, _, _), ...rest] ->
      if vec_pat_binds(p, l) { true } else { vec_match_binds(rest, l) }
  }

fn vec_pat_binds(p: Pattern, l: LocalId) : Bool =
  match p.pkind {
    PBind(b)          -> local_eq(b.id, l)
    PAs(b, inner)     -> local_eq(b.id, l) or vec_pat_binds(inner, l)
    PList(pats, rest) -> vec_rest_is(rest, l) or vec_pats_bind(pats, l)
    _                 -> false
  }

fn vec_rest_is(rest: Option[Binder], l: LocalId) : Bool =
  match rest { Some(r) -> local_eq(r.id, l)  None -> false }

fn vec_pats_bind(pats: [Pattern], l: LocalId) : Bool =
  match pats {
    [] -> false
    [p, ...rest] ->
      if vec_pat_binds(p, l) { true } else { vec_pats_bind(rest, l) }
  }

# The last arm becomes the bare else branch: exhaustiveness (validated
# by the typer) guarantees a value that failed every earlier test
# matches it.
fn vm_chain(arms: [Arm], vn: LocalId, line: Int, col: Int) : Expr =
  match arms {
    [only]       -> vm_arm_body(only, vn)
    [a, ...rest] -> match a {
      Arm(p, _, _) -> {
        let alt = vm_chain(rest, vn, line, col)
        mk_expr(EIf(vm_test(p, vn), vm_arm_body(a, vn), Some(alt)), p.line, p.col)
      }
    }
    [] -> mk_expr(EUnit, line, col)
  }

# `vec_length(v) == n` for an exact arm, `>= n` for a rest arm. A
# non-list arm mid-chain (catch-all before the end) always passes.
fn vm_test(p: Pattern, vn: LocalId) : Expr =
  match vec_arm_kind(p) {
    VArmList(pats, rest)  -> vm_len_test(pats, rest, vn, p)
    VArmAs(_, pats, rest) -> vm_len_test(pats, rest, vn, p)
    _                     -> mk_expr(EBool(true), p.line, p.col)
  }

fn vm_len_test(pats: [Pattern], rest: Option[Binder], vn: LocalId, p: Pattern) : Expr {
  let len_call = vs_call("vec_length", [mk_local(vn, p.line, p.col)], p.line, p.col)
  let op = match rest { None -> BoEq Some(_) -> BoGe }
  mk_expr(EBinop(op, len_call, vs_int(list_length(pats), p.line, p.col)), p.line, p.col)
}

# One scrutinee read with its per-role unique position.
fn vm_scr_use(vn: LocalId, p: Pattern, off: Int) : Expr =
  mk_local(vn, p.line, p.col + off)

# One arm's body: element binds (`vec_get`), the rest slice
# (`vec_tail_from` — the scrutinee's LAST use on this path, so a moved
# unique view re-slices in place), then the user body.
fn vm_arm_body(a: Arm, vn: LocalId) : Expr =
  match a {
    Arm(p, _, body) -> match vec_arm_kind(p) {
      VArmList(pats, rest)   -> vm_block(vm_binds(pats, rest, vn, p), body, p)
      VArmAs(nm, pats, rest) -> {
        let as_bind = vs_let(nm, vm_scr_use(vn, p, 1), p.line, p.col)
        vm_block([as_bind, ...vm_binds(pats, rest, vn, p)], body, p)
      }
      VArmCatch(Some(nm)) ->
        vm_block([vs_let(nm, vm_scr_use(vn, p, 1), p.line, p.col)], body, p)
      VArmCatch(None)     -> body
      VArmUnsupported     -> body
    }
  }

fn vm_block(binds: [Stmt], body: Expr, p: Pattern) : Expr =
  match binds {
    [] -> body
    _  -> mk_expr(EBlock(binds, Some(body)), p.line, p.col)
  }

fn vm_binds(pats: [Pattern], rest: Option[Binder], vn: LocalId, p: Pattern) : [Stmt] {
  let heads = vm_head_binds(pats, 0, vn, p)
  match rest {
    None -> heads
    Some(rnm) -> {
      let n = list_length(pats)
      let args = [vm_scr_use(vn, p, 2 + n), vs_int(n, p.line, p.col)]
      let tail_call = vs_call("vec_tail_from", args, p.line, p.col)
      list_append(heads, [vs_let(rnm, tail_call, p.line, p.col)])
    }
  }
}

fn vm_head_binds(pats: [Pattern], i: Int, vn: LocalId, arm_p: Pattern) : [Stmt] =
  match pats {
    [] -> []
    [p, ...rest] -> match p.pkind {
      PBind(nm) -> {
        let args = [vm_scr_use(vn, arm_p, 2 + i), vs_int(i, p.line, p.col)]
        let get_call = vs_call("vec_get", args, p.line, p.col)
        [vs_let(nm, get_call, p.line, p.col), ...vm_head_binds(rest, i + 1, vn, arm_p)]
      }
      _ -> vm_head_binds(rest, i + 1, vn, arm_p)
    }
  }

#[doc("The arm a fixed-width `Vec` of length `n` selects, or `None` when no arm covers it.")]
pub(pkg) fn fixed_vec_match_arm(arms: [Arm], n: Int) : Option[Arm] = match arms {
  [] -> None
  [a, ...rest] -> if fixed_vec_arm_matches(a, n) { Some(a) } else { fixed_vec_match_arm(rest, n) }
}

fn fixed_vec_arm_matches(a: Arm, n: Int) : Bool = match a {
  Arm(p, _, _) -> match vec_arm_kind(p) {
    VArmList(pats, rest)  -> fixed_vec_len_ok(list_length(pats), rest, n)
    VArmAs(_, pats, rest) -> fixed_vec_len_ok(list_length(pats), rest, n)
    VArmCatch(_)          -> true
    VArmUnsupported       -> false
  }
}

fn fixed_vec_len_ok(k: Int, rest: Option[Binder], n: Int) : Bool =
  match rest { None -> k == n  Some(_) -> k <= n }

#[doc("Build the body of the one arm a fixed `Vec[e]<n>` selects: element binds as literal-index reads, a rest binder as the trailing fixed-vec literal.")]
pub(pkg) fn fixed_vec_arm_build(a: Arm, scr: Expr, vty: Ty) : Expr = match a {
  Arm(p, _, body) -> match vec_arm_kind(p) {
    VArmList(pats, rest)   -> fvm_block(fvm_binds(pats, rest, scr, vty, p), body, p)
    VArmAs(nm, pats, rest) ->
      fvm_block([fvm_let(nm, scr, p), ...fvm_binds(pats, rest, scr, vty, p)], body, p)
    VArmCatch(Some(nm)) -> fvm_block([fvm_let(nm, scr, p)], body, p)
    VArmCatch(None)     -> body
    VArmUnsupported     -> body
  }
}

fn fvm_block(binds: [Stmt], body: Expr, p: Pattern) : Expr = match binds {
  [] -> body
  _  -> mk_expr(EBlock(binds, Some(body)), p.line, p.col)
}

fn fvm_let(nm: Binder, rhs: Expr, p: Pattern) : Stmt =
  SLet(Pattern { pkind: PBind(nm), line: p.line, col: p.col }, None, rhs)

fn fvm_binds(pats: [Pattern], rest: Option[Binder], scr: Expr, vty: Ty, p: Pattern) : [Stmt] {
  let heads = fvm_head_binds(pats, 0, scr, p)
  match rest {
    None -> heads
    Some(rnm) -> list_append(heads, [fvm_rest_bind(rnm, scr, vty, list_length(pats), p)])
  }
}

fn fvm_head_binds(pats: [Pattern], i: Int, scr: Expr, arm_p: Pattern) : [Stmt] =
  match pats {
    [] -> []
    [p, ...rest] -> {
      let tail = fvm_head_binds(rest, i + 1, scr, arm_p)
      match p.pkind {
        PBind(nm) -> [fvm_let(nm, fvm_elem_read(scr, i, p), p), ...tail]
        _         -> tail
      }
    }
  }

# One element read as `v[i]`: the typer's index path routes a literal
# index on a fixed vec to the bare field load.
fn fvm_elem_read(scr: Expr, i: Int, p: Pattern) : Expr =
  mk_expr(EIndex(scr, mk_expr(mk_int_synth(i), p.line, p.col)), p.line, p.col)

# `...rest` over a fixed vec of length `n` after `k` heads is itself a
# fixed vec of length `n - k`: an annotated literal over the trailing
# element reads, so the descent stays inline (no heap vec, no slice op).
fn fvm_rest_bind(rnm: Binder, scr: Expr, vty: Ty, k: Int, p: Pattern) : Stmt {
  let n = fixed_vec_n(vty)
  let elems = fvm_rest_elems(scr, k, n, p)
  let lit = mk_expr(EList(elems), p.line, p.col)
  let ann = fvm_rest_ann(fixed_vec_elem(vty), n - k, p)
  SLet(Pattern { pkind: PBind(rnm), line: p.line, col: p.col }, Some(ann), lit)
}

fn fvm_rest_elems(scr: Expr, i: Int, n: Int, p: Pattern) : [ListElem] =
  if i >= n { [] }
  else { [ElPlain(fvm_elem_read(scr, i, p)), ...fvm_rest_elems(scr, i + 1, n, p)] }

# The `Vec[e]<m>` annotation the rest binder carries, so the literal is
# checked in fixed-vec context and mints the inline aggregate. The element
# is a flat scalar (the fixed-vec representation gate), so its type always
# has a surface name; a scalar has no declaration, so it stays written.
fn fvm_rest_ann(elem: Ty, m: Int, p: Pattern) : TypeExpr {
  let en = TypeExpr { tkind: TyName(ref_written(fvm_scalar_name(elem)), []), line: p.line, col: p.col }
  let vt = TypeExpr { tkind: TyName(DrSym(core_ty_sym(CtVec)), [en]), line: p.line, col: p.col }
  TypeExpr { tkind: TyDim(vt, USym(int_to_string(m))), line: p.line, col: p.col }
}

fn fvm_scalar_name(t: Ty) : String = match t {
  TyReal   -> "Real"
  TyInt    -> "Int"
  TyBool   -> "Bool"
  TyChar   -> "Char"
  TyByte   -> "Byte"
  TyInt32  -> "Int32"
  TyUInt32 -> "UInt32"
  TyUInt64 -> "UInt64"
  _        -> "Int"
}

#[doc("True when a match of `arms` on a scrutinee of type `scr_ty` is rewritten here: the type is `Seq` and an arm writes a list pattern.")]
pub(pkg) fn seq_match_route(scr_ty: Ty, arms: [Arm]) : Bool = match scr_ty {
  TyCon(s, _) -> ty_is(s, CdSeq) and not all(arms, (a) => sm_is(a, SmOther))
  _           -> false
}

#[doc("What is wrong with a match on a `Seq`, where to report it and how to fix it.")]
pub(pkg) type SeqFault = { line: Int, col: Int, msg: String, help: String }

#[doc("The first fault in `arms`, the arms of the match at `line:col` on a `Seq`: a pattern the rewrite does not read, or values no arm covers. `None` when the match can be rewritten.")]
pub(pkg) fn seq_match_fault(arms: [Arm], line: Int, col: Int) : Option[SeqFault] =
  match find(arms, (a) => sm_is(a, SmUnread)) {
    Some(Arm(p, _, _)) ->
      Some(SeqFault { line: p.line, col: p.col,
                      msg: "a `Seq` is matched by `[]`, by `[first, ...rest]`, or by a catch-all",
                      help: "reading a cell decides one element: match `rest` in the arm's body to read further" })
    None -> sm_uncovered(arms, line, col)
  }

fn sm_uncovered(arms: [Arm], line: Int, col: Int) : Option[SeqFault] = {
  let open = filter(arms, sm_unguarded)
  let ends = any(open, (a) => sm_is(a, SmEnd))
  let conses = any(open, (a) => sm_is(a, SmCons))
  if (ends and conses) or any(open, sm_catches) { None }
  else {
    Some(SeqFault { line: line, col: col,
                    msg: "non-exhaustive match on a `Seq`: missing #{sm_missing(ends, conses)}",
                    help: "cover both `[]` and `[first, ...rest]`, or add a wildcard `_` arm" })
  }
}

# A guarded arm covers nothing on its own.
fn sm_unguarded(a: Arm) : Bool = match a {
  Arm(_, None, _) -> true
  _               -> false
}

fn sm_catches(a: Arm) : Bool = sm_is(a, SmCatch) or sm_is(a, SmBinds)

fn sm_missing(ends: Bool, conses: Bool) : String =
  if ends { "sequences with a first element (`[_, ...rest]`)" }
  else if conses { "the empty sequence `[]`" }
  else { "the empty sequence `[]` and sequences with a first element (`[_, ...rest]`)" }

#[doc("The match at `line:col` of `arms` on the `Seq` `scr`, rewritten over what reading `scr` yields. `arms` has no fault.")]
pub(pkg) fn seq_match_build(scr: Expr, arms: [Arm], line: Int, col: Int) : Expr =
  if any(arms, (a) => sm_is(a, SmBinds)) {
    let held = binder_minted(string_concat_all(["__seq_scr_", int_to_string(line), "_", int_to_string(col), "__"]))
    let read = sm_match(mk_local(held.id, line, col), map(arms, (a) => sm_arm(a, Some(held))), line, col)
    mk_expr(EBlock([SLet(mk_pat(PBind(held), line, col), None, scr)], Some(read)), line, col)
  } else { sm_match(scr, map(arms, (a) => sm_arm(a, None)), line, col) }

fn sm_match(seq: Expr, arms: [Arm], line: Int, col: Int) : Expr =
  mk_expr(EMatch(mk_expr(ECall(mk_sym(seq_fn_id(SqForce), line, col), [seq]), line, col), arms), line, col)

# How an arm reads the sequence: not at all, as exhausted, as a first
# element and the rest, bound whole to a name, or in a way one read
# cannot decide.
type SmKind = SmCatch | SmEnd | SmCons | SmBinds | SmUnread | SmOther

fn sm_is(a: Arm, k: SmKind) : Bool = sm_rank(sm_kind(a)) == sm_rank(k)

fn sm_rank(k: SmKind) : Int = match k {
  SmCatch  -> 0
  SmEnd    -> 1
  SmCons   -> 2
  SmBinds  -> 3
  SmUnread -> 4
  SmOther  -> 5
}

fn sm_kind(a: Arm) : SmKind = match a {
  Arm(p, _, _) -> match p.pkind {
    PWild               -> SmCatch
    PBind(_)            -> SmBinds
    PList([], None)     -> SmEnd
    PList([_], Some(_)) -> SmCons
    PList(_, _)         -> SmUnread
    PAs(_, _)           -> SmUnread
    _                   -> SmOther
  }
}

# `held` is the binder the scrutinee was bound to, present when some arm
# binds the sequence whole.
fn sm_arm(a: Arm, held: Option[Binder]) : Arm = match a {
  Arm(p, guard, body) -> match p.pkind {
    PList([], None)            -> Arm(sm_step(p, seq_end_id(), []), guard, body)
    PList([first], Some(rest)) -> Arm(sm_step(p, seq_cons_id(), [first, mk_pat(PBind(rest), p.line, p.col)]), guard, body)
    PBind(name)                -> sm_whole(a, name, held)
    _                          -> a
  }
}

fn sm_step(p: Pattern, ctor: SymId, subs: [Pattern]) : Pattern =
  mk_pat(PVariant(DrSym(ctor), subs), p.line, p.col)

# The arm that binds the sequence whole reads nothing: it binds its name
# to the held scrutinee, in the guard and in the body.
fn sm_whole(a: Arm, name: Binder, held: Option[Binder]) : Arm = match a {
  Arm(p, guard, body) -> match held {
    Some(h) -> Arm(mk_pat(PWild, p.line, p.col), sm_opt(guard, (g) => sm_bound(name, h, g)), sm_bound(name, h, body))
    None    -> a
  }
}

fn sm_bound(name: Binder, held: Binder, e: Expr) : Expr =
  mk_expr(EBlock([SLet(mk_pat(PBind(name), e.line, e.col), None, mk_local(held.id, e.line, e.col))], Some(e)), e.line, e.col)

fn sm_opt(o: Option[Expr], f: (Expr) -> Expr) : Option[Expr] = match o {
  None    -> None
  Some(e) -> Some(f(e))
}
