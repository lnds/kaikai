# A constructor is filed under the sum its scheme builds.
#[doc("Typer-internal helper `env_vix_add` shared across the infer modules.")]
pub fn env_vix_add(vx: VariantIndex[TyEntry], e: TyEntry) : VariantIndex[TyEntry] = match e.key {
  KCtor(c) -> {
    let tsym = scheme_ret_sym(e.scheme)
    if sym_raw(tsym) < 0 { vx } else { vix_prepend(vx, tsym, c, e) }
  }
  _ -> vx
}


#[doc("Typer-internal helper `env_entry_add` shared across the infer modules.")]
pub fn env_entry_add(env: TyEnv, e: TyEntry) : TyEnv = match e.key {
  KLocal(b) -> TyEnv { ...env, entries: [e, ...env.entries], added: env.added + 1,
                       max_local: if local_raw(b.id) > env.max_local { local_raw(b.id) } else { env.max_local },
                       locals: idx_prepend_local(env.locals, b.id, e) }
  _         -> TyEnv { ...env, entries: [e, ...env.entries], added: env.added + 1,
                       index: env_ix_add(env.index, e), vindex: env_vix_add(env.vindex, e) }
}


# Bind the local `b` declares. A later binder of the same id (a minted
# key reused in an inner scope) shadows this one.
#[doc("Typer-internal helper `env_bind_local` shared across the infer modules.")]
pub fn env_bind_local(env: TyEnv, b: Binder, sc: TyScheme) : TyEnv =
  env_entry_add(env, TyEntry { key: KLocal(b), scheme: sc })


#[doc("Wrap `base` in the unit `u`: units nest only as written, refinements lift outside, and a dimensionless unit vanishes except on a fixed-width vec.")]
pub fn dim_collapse(base: Ty, u: UnitExprT) : Ty {
  match base {
    TyDimT(inner, u_inner) ->
      if unit_is_dims(u_inner) or unit_is_dims(u) { TyDimT(base, unit_canon(u)) }
      else { dim_collapse(inner, unit_canon(UMul(u_inner, u))) }
    TyRefineT(inner, p) -> TyRefineT(dim_collapse(inner, u), p)
    _ -> dim_over_base(base, unit_canon(u))
  }
}

# A `Vec[e]<1>` keeps its brand: a fixed-width vec has its own inline layout
# and must not collapse into the dynamic `Vec[e]`.
fn dim_over_base(base: Ty, uc: UnitExprT) : Ty =
  if unit_is_one(uc) and not ty_vec_headed(base) { base } else { TyDimT(base, uc) }


# The constructor the sum `tsym` declares as `name`: the one its module
# declares under that name, when it builds `tsym`. What the runtime
# builds is no module's.
#[doc("Typer-internal helper `own_ctor` shared across the infer modules.")]
pub fn own_ctor(env: TyEnv, tsym: SymId, name: String) : Option[SymId] = {
  let c = if sym_is_core_sum(tsym) { Some(core_ctor_sym(name)) }
          else { st_lookup(env.tab, NCCtor, name, sym_owner(env.tab, tsym)) }
  match c {
    Some(s) -> if ctor_builds(env, s, tsym) { Some(s) } else { None }
    None    -> None
  }
}


fn ctor_builds(env: TyEnv, c: SymId, tsym: SymId) : Bool =
  any(vix_of_ctor(env.vindex, c), (e) => sym_same(scheme_ret_sym(e.scheme), tsym))


# Bind the stateful handler's magic aliases (`state` / `log`, both the
# handler-state slot) into a clause env, each as the binder minted under
# its name. A read the resolver sent to an enclosing `log` carries that
# binder's own id, so an outer array keeps its type inside the clause.
#[doc("Typer-internal helper `add_state_aliases` shared across the infer modules.")]
pub fn add_state_aliases(env: TyEnv, sty: Ty) : TyEnv =
  add_state_aliases_loop(env, clause_state_aliases((nm) => false), sty)


fn add_state_aliases_loop(env: TyEnv, names: [String], sty: Ty) : TyEnv = match names {
  []            -> env
  [nm, ...rest] -> add_state_aliases_loop(env_bind_local(env, binder_minted(nm), mono(sty)), rest, sty)
}


# stateless clauses bind `resume : (answer_ty) -> result_ty`.
# Stateful clauses still bind `resume` to mono(TyAny) at the env
# level (so a read of it has a type); the actual precise typing of `resume(v)` and
# `resume(v, ns)` is performed by synth_call's special-case using the
# st.clause_resume binding pushed by check_clauses_types.
#[doc("Typer-internal helper `bind_resume_param_typed` shared across the infer modules.")]
pub fn bind_resume_param_typed(st: InferState, p: Param, ret_ty: Ty,
                            stateful: Bool, result_ty: Ty) : InferState {
  if stateful {
    st_set_env(st, env_bind_local(st.env, p.binder, mono(TyAny)))
  } else {
    st_set_env(st, env_bind_local(st.env, p.binder, mono(TyFnT([ret_ty], result_ty, inf_row_empty()))))
  }
}


#[doc("Typer-internal helper `bind_params_lenient` shared across the infer modules.")]
pub fn bind_params_lenient(st: InferState, params: [Param]) : InferState {
  match params {
    []      -> st
    [p, ...rest] -> {
      let f = st_fresh_ty(st)
      let env1 = env_bind_local(f.st.env, p.binder, mono(f.ty))
      bind_params_lenient(st_set_env(f.st, env1), rest)
    }
  }
}


# The type a `let` binder takes from a value of type `t`. The fixed-width
# inline representation belongs to a LITERAL: a `<n>`-typed value from
# anything else is a dynamic heap `Vec` at run time, so its binder
# de-brands to `Vec[e]`.
#[doc("Typer-internal helper `let_binder_ty` shared across the infer modules.")]
pub fn let_binder_ty(t: Ty, rhs: Expr) : Ty =
  if ty_is_fixed_vec(t) and not is_fixed_vec_lit(rhs) { fixed_vec_unbrand(t) } else { t }


# The synth-side entry for the textual literal nodes that carry no shape
# default. A `d` suffix mints to `Decimal` unconditionally; a bare
# past-i64 integer with no concrete carrier in context is out of range
# and names the `n` / `bigint.from_string` escape hatch.
#[doc("Typer-internal helper `synth_lit_mint_or_err` shared across the infer modules.")]
pub fn synth_lit_mint_or_err(st: InferState, e: Expr, kind: ExprKind) : Inferred / Console + File + Mutable {
  match kind {
    EDecimalLit(_) -> synth_mint_decimal(st, e)
    EIntLit(span)  -> {
      let perr = mk_diag(SevError, st.file, e.line, e.col, lit_mint_int_range_error(span), [])
      mk_inferred(st_bump_err(st_push_diag(st, perr)), TyInt, e)
    }
    _ -> {
      let perr = mk_diag(SevError, st.file, e.line, e.col, "numeric literal has no concrete type in context", [])
      mk_inferred(st_bump_err(st_push_diag(st, perr)), TyInt, e)
    }
  }
}


# Local record so the two `match tail` branches return the same
# shape; kaikai-minimal has no tuples.
#[doc("Typer-internal type `BlockTail` shared across the infer modules.")]
pub type BlockTail = { st: InferState, ty: Ty, expr_opt: Option[Expr] }


#[doc("Typer-internal type `OneStmt` shared across the infer modules.")]
pub type OneStmt = { st: InferState, stmt: Stmt }

#[doc("Typer-internal type `InferredOptExpr` shared across the infer modules.")]
pub type InferredOptExpr = { st: InferState, expr: Option[Expr] }


# A pattern as the typer leaves it: its binders bound in `st`, and each
# constructor it names settled to that constructor's id.
#[doc("Typer-internal type `PatChecked` shared across the infer modules.")]
pub type PatChecked = { st: InferState, pat: Pattern }


#[doc("Typer-internal type `PatsChecked` shared across the infer modules.")]
pub type PatsChecked = { st: InferState, pats: [Pattern] }


#[doc("Typer-internal type `PFieldsChecked` shared across the infer modules.")]
pub type PFieldsChecked = { st: InferState, fields: [PField] }


#[doc("Typer-internal helper `ty_list_contains` shared across the infer modules.")]
pub fn ty_list_contains(tys: [Ty], target: Ty) : Bool {
  match tys {
    [] -> false
    [t, ...rest] -> if inf_ty_eq(t, target) { true } else { ty_list_contains(rest, target) }
  }
}


# The type a reference names to the reader `hv`; a written qualifier's
# module decides when there is one.
#[doc("Typer-internal helper `ref_ty_sym` shared across the infer modules.")]
pub fn ref_ty_sym(hv: TyHomeView, r: DeclRef) : SymId = ut_ty_sym(tsh_tycon_at(hv, r, []))


#[doc("Typer-internal helper `settle_sym` shared across the infer modules.")]
pub fn settle_sym(s: SymId) : Settled = if sym_raw(s) >= 0 { SetOne(s) } else { SetNone }


# True when `t` is the record its own module declares as `name`.
#[doc("Typer-internal helper `record_named` shared across the infer modules.")]
pub fn record_named(st: InferState, t: SymId, name: String) : Bool =
  sym_raw(t) >= 0 and is_some(rec_find(st.recs, t)) and match st_lookup(st.env.tab, NCType, name, sym_owner(st.env.tab, t)) {
    Some(s) -> sym_same(s, t)
    None    -> false
  }


# A record head settled, its tie reported: no declaration when it names
# none.
#[doc("Typer-internal type `RecHead` shared across the infer modules.")]
pub type RecHead = { st: InferState, sym: Option[SymId] }


#[doc("Typer-internal helper `head_record` shared across the infer modules.")]
pub fn head_record(recs: [RecInfo], s: Option[SymId]) : Option[RecInfo] = match s {
  Some(x) -> rec_pick(recs, x)
  None    -> None
}


# Naming a field in a pattern reads it, whatever the sub-pattern is.
#[doc("Typer-internal helper `check_pfield_visible` shared across the infer modules.")]
pub fn check_pfield_visible(st: InferState, ri: RecInfo, fnm: String, line: Int, col: Int) : InferState / Console + File =
  match ri {
    RI(rsym, _, fds, mo) -> match find_field_in_decls(fds, fnm) {
      Some(fd) -> {
        let rn = written_text(decl_name(st.env.tab, rsym))
        if field_hidden(st_home_view(st), rn, rsym, fd) {
          let d = priv_read_diag(st.file, line, col, fnm, rn, mo)
          st_bump_err(st_push_diag(st, d))
        } else { st }
      }
      None -> st
    }
  }


# redundant arms in a `match`. Two
# arms whose patterns trivially overlap and that share guard
# shape (both unguarded) make the second arm dead code. Today
# the language accepts; the user's intent (compute via the
# second arm) is silently dropped. We fingerprint each arm's
# head: literal value, or catch-all marker.
# Two arms with the same fingerprint, both unguarded, is a hard
# error. A catch-all (`_`, bare binding) unguarded arm makes any
# later arm unreachable; we flag the first such later arm. We
# stay deliberately syntactic: nothing here recurses into
# variant payloads (`Some(x)` vs `Some(y)` is shape 2; `Some(x)`
# vs `Some(Just z)` is NOT). The shape matches what real ML/HM
# frontends report. Two arms of one constructor are told apart by its
# id, which an arm holds once it is typed: `check_arms_ctor_repeats`.
#[doc("Typer-internal type `ArmHead` shared across the infer modules.")]
pub type ArmHead
  = AhCatchAll                          # PWild / PBind / PAs over wild — covers everything
  | AhLitInt(Int)
  | AhLitBool(Bool)
  | AhLitChar(Char)
  | AhLitStr(String)                    # raw source span, includes quotes (EStr shape)
  | AhUnclassified                      # nested / record / list / hole / narrow — skip


# Returns true when a sub-pattern carries no discriminating
# information — it matches every value at its type. We use this
# to decide if a `PVariant(c, subs)` arm is "totally open"; two
# such arms of the same constructor overlap completely and the
# second is dead code. A variant arm with a literal payload like
# `Some(true)` is NOT totally open — `Some(true)` and `Some(false)`
# are legitimately distinct arms.
fn pat_is_catch_all_subpat(pat: Pattern) : Bool {
  match pat.pkind {
    PWild       -> true
    PBind(_)    -> true
    PHole(_)    -> true
    PAs(_, sub) -> pat_is_catch_all_subpat(sub)
    _           -> false
  }
}


fn all_subpats_catch_all(ps: [Pattern]) : Bool {
  match ps {
    [] -> true
    [p, ...rest] -> if pat_is_catch_all_subpat(p) { all_subpats_catch_all(rest) } else { false }
  }
}


fn all_pfields_catch_all(pfs: [PField]) : Bool {
  match pfs {
    [] -> true
    [pf, ...rest] -> match pf {
      PField(_, sub, _) -> if pat_is_catch_all_subpat(sub) { all_pfields_catch_all(rest) } else { false }
    }
  }
}


fn arm_head_of(pat: Pattern) : ArmHead {
  match pat.pkind {
    PWild       -> AhCatchAll
    PBind(_)    -> AhCatchAll
    PHole(_)    -> AhCatchAll
    PAs(_, sub) -> arm_head_of(sub)
    PVariant(_, _) -> AhUnclassified
    PVariantRecord(_, _) -> AhUnclassified
    PLit(lit_expr) -> match lit_expr.kind {
      EInt(n, _) -> AhLitInt(n)
      EBool(b)    -> AhLitBool(b)
      EChar(c)    -> AhLitChar(c)
      EStr(s, _)  -> AhLitStr(s)
      _           -> AhUnclassified
    }
    PList(_, _)    -> AhUnclassified
    PRecord(_)     -> AhUnclassified
    PNarrow(_, _)  -> AhUnclassified
    PRange(_, _)   -> AhUnclassified
    PSurface(_)    -> AhUnclassified
  }
}


fn arm_head_eq(a: ArmHead, b: ArmHead) : Bool = match (a, b) {
  (AhCatchAll, AhCatchAll) -> true
  (AhLitInt(x), AhLitInt(y)) -> x == y
  (AhLitBool(x), AhLitBool(y)) -> x == y
  (AhLitChar(x), AhLitChar(y)) -> x == y
  (AhLitStr(x), AhLitStr(y)) -> x == y
  _ -> false
}


fn arm_head_describe(h: ArmHead) : String {
  match h {
    AhCatchAll       -> "catch-all"
    AhLitInt(n)      -> "literal `#{int_to_string(n)}`"
    AhLitBool(b)     -> if b { "literal `true`" } else { "literal `false`" }
    AhLitChar(_)     -> "this character literal"
    AhLitStr(s)      -> "literal #{s}"
    AhUnclassified   -> "this pattern"
  }
}


fn arm_is_unguarded(a: Arm) : Bool = match a {
  Arm(_, None, _) -> true
  Arm(_, Some(_), _) -> false
}


fn arm_pat_of(a: Arm) : Pattern {
  match a {
    Arm(pat, _, _) -> pat
  }
}


# The multi-arg match desugar emits a wildcard fallthrough carrying the outer
# match header's span; a user-written wildcard has a span of its own. Those
# synthetic arms are skipped so a desugared chain never flags itself.
fn arm_is_synthetic_fallthrough(a: Arm, match_line: Int, match_col: Int) : Bool = match a {
  Arm(pat, None, _) -> pat.line == match_line and pat.col == match_col and pat_is_wild(pat)
  Arm(_, Some(_), _) -> false
}

fn pat_is_wild(pat: Pattern) : Bool = match pat.pkind {
  PWild -> true
  _ -> false
}


type ArmScan = { st: InferState, seen: [ArmHead], saw_catch_all: Bool }

# Scan arms in order, accumulating the heads of unguarded arms already seen.
# Each redundant arm is reported once, so `1 -> 1 -> 1 -> _` yields two
# errors. `match_line`/`match_col` pin the outer match header: desugared
# fallthrough arms carry its span and are skipped.
#[doc("Report every unguarded match arm that an earlier arm already covers.")]
pub fn check_arms_redundancy(st: InferState, arms: [Arm], seen: [ArmHead],
                             saw_catch_all: Bool,
                             match_line: Int, match_col: Int) : InferState / Console + File =
  match arms {
    [] -> st
    [a, ...rest] -> {
      let n = if arm_is_synthetic_fallthrough(a, match_line, match_col) {
        ArmScan { st: st, seen: seen, saw_catch_all: saw_catch_all }
      } else {
        scan_arm_head(st, a, seen, saw_catch_all)
      }
      check_arms_redundancy(n.st, rest, n.seen, n.saw_catch_all, match_line, match_col)
    }
  }

fn scan_arm_head(st: InferState, a: Arm, seen: [ArmHead], saw_catch_all: Bool) : ArmScan / Console + File {
  let pat = arm_pat_of(a)
  let head = arm_head_of(pat)
  let unguarded = arm_is_unguarded(a)
  if saw_catch_all and unguarded {
    let perr = mk_diag(SevError, st.file, pat.line, pat.col,
      "unreachable match arm: previous arm matched every value", [])
    ArmScan { st: st_bump_err(st_help(st_note(st_push_diag(st, perr), "an earlier unguarded `_` or bare binding already covers this case"), "remove this arm, or move it before the catch-all")), seen: seen, saw_catch_all: saw_catch_all }
  } else if unguarded and arm_head_classified(head) and arm_head_in(seen, head) {
    let perr = mk_diag(SevError, st.file, pat.line, pat.col,
      "duplicate match arm: #{arm_head_describe(head)} is already matched above", [])
    ArmScan { st: st_bump_err(st_help(st_push_diag(st, perr), "remove this arm, or distinguish it with a guard (`#{arm_head_describe(head)} if cond -> ...`)")), seen: seen, saw_catch_all: saw_catch_all }
  } else {
    let counted = unguarded and arm_head_classified(head)
    ArmScan {
      st: st,
      seen: if counted { [head, ...seen] } else { seen },
      saw_catch_all: saw_catch_all or (unguarded and arm_head_is_catch_all(head))
    }
  }
}


# The constructor an arm tests over a totally open payload, once the
# typer settled it.
fn arm_open_ctor(pat: Pattern) : Option[SymId] = match pat.pkind {
  PAs(_, sub)                  -> arm_open_ctor(sub)
  PVariant(DrSym(c), subs)     -> if all_subpats_catch_all(subs) { Some(c) } else { None }
  PVariantRecord(DrSym(c), fs) -> if all_pfields_catch_all(fs) { Some(c) } else { None }
  _                            -> None
}


type CtorScan = { st: InferState, seen: [SymId], dead: Bool }

# The constructor half of `check_arms_redundancy`, over typed arms: a second
# unguarded arm of one constructor is dead. `dead` follows the catch-all the
# first pass already reported the arms after.
#[doc("Report a second unguarded arm of a constructor an earlier arm already matches.")]
pub fn check_arms_ctor_repeats(st: InferState, arms: [Arm], seen: [SymId], dead: Bool,
                               match_line: Int, match_col: Int) : InferState / Console + File =
  match arms {
    [] -> st
    [a, ...rest] -> {
      let n = if arm_is_synthetic_fallthrough(a, match_line, match_col) {
        CtorScan { st: st, seen: seen, dead: dead }
      } else {
        scan_ctor_arm(st, a, seen, dead)
      }
      check_arms_ctor_repeats(n.st, rest, n.seen, n.dead, match_line, match_col)
    }
  }

fn scan_ctor_arm(st: InferState, a: Arm, seen: [SymId], dead: Bool) : CtorScan / Console + File {
  let pat = arm_pat_of(a)
  let unguarded = arm_is_unguarded(a)
  match arm_open_ctor(pat) {
    None -> CtorScan { st: st, seen: seen,
                       dead: dead or (unguarded and arm_head_is_catch_all(arm_head_of(pat))) }
    Some(c) ->
      if dead and unguarded { CtorScan { st: st, seen: seen, dead: dead } }
      else if unguarded and sym_list_has(seen, c) {
        CtorScan { st: report_repeated_ctor(st, pat, c), seen: seen, dead: dead }
      }
      else { CtorScan { st: st, seen: if unguarded { [c, ...seen] } else { seen }, dead: dead } }
  }
}

fn report_repeated_ctor(st: InferState, pat: Pattern, c: SymId) : InferState / Console + File {
  let shown = "variant `#{decl_name(st.env.tab, c)}`"
  let perr = mk_diag(SevError, st.file, pat.line, pat.col,
    "duplicate match arm: #{shown} is already matched above", [])
  st_bump_err(st_help(st_push_diag(st, perr), "remove this arm, or distinguish it with a guard (`#{shown} if cond -> ...`)"))
}


#[doc("Typer-internal helper `sym_list_has` shared across the infer modules.")]
pub fn sym_list_has(xs: [SymId], s: SymId) : Bool = match xs {
  []           -> false
  [x, ...rest] -> sym_same(x, s) or sym_list_has(rest, s)
}


fn arm_head_classified(h: ArmHead) : Bool {
  match h {
    AhUnclassified -> false
    AhCatchAll     -> false              # tracked via the saw_catch_all flag
    _              -> true
  }
}


fn arm_head_is_catch_all(h: ArmHead) : Bool {
  match h {
    AhCatchAll -> true
    _          -> false
  }
}


fn arm_head_in(seen: [ArmHead], target: ArmHead) : Bool {
  match seen {
    [] -> false
    [h, ...rest] -> if arm_head_eq(h, target) { true } else { arm_head_in(rest, target) }
  }
}


# A match routes through the Vec rewrite when the scrutinee resolved to
# `Vec[T]` and some arm is list-shaped. List arms over a Vec never reach
# the cons/nil machinery: `synth_vec_match` rebuilds the whole match as
# an if-chain over `vec_length` / `vec_get` / `vec_tail_from`.
#[doc("Typer-internal helper `vec_match_route` shared across the infer modules.")]
pub fn vec_match_route(scr_ty: Ty, arms: [Arm]) : Bool =
  match scr_ty {
    TyCon(tcs, _) -> core_ty_is(tcs, CtVec) and vec_match_has_list_arm(arms)
    _             -> false
  }


# A fixed-width `Vec[T]<n>` scrutinee routes to the static rewrite: the
# length is the type, so `synth_fixed_vec_match` picks the one matching
# arm at compile time — no if-chain, no dynamic-vec op.
#[doc("Typer-internal helper `fixed_vec_match_route` shared across the infer modules.")]
pub fn fixed_vec_match_route(scr_ty: Ty, arms: [Arm]) : Bool =
  ty_is_fixed_vec(scr_ty) and vec_match_has_list_arm(arms)


#[doc("Typer-internal type `VecMatchGate` shared across the infer modules.")]
pub type VecMatchGate = { st: InferState, ok: Bool }


#[doc("Typer-internal helper `vec_arm_catchall` shared across the infer modules.")]
pub fn vec_arm_catchall(a: Arm) : Bool =
  match a {
    Arm(p, guard, _) -> match guard {
      Some(_) -> false
      None -> match vec_arm_kind(p) {
        VArmCatch(_) -> true
        _            -> false
      }
    }
  }


#[doc("Typer-internal helper `vec_match_check_arms` shared across the infer modules.")]
pub fn vec_match_check_arms(st: InferState, arms: [Arm]) : VecMatchGate / Console + File =
  match arms {
    [] -> VecMatchGate { st: st, ok: true }
    [Arm(p, guard, _), ...rest] -> {
      let g1 = match guard {
        None -> VecMatchGate { st: st, ok: true }
        Some(gx) -> {
          let perr = mk_diag(SevError, st.file, gx.line, gx.col,
            "guards are not supported on Vec match arms", [])
          VecMatchGate { st: st_bump_err(st_help(st_push_diag(st, perr), "test the condition with `if` inside the arm body")), ok: false }
        }
      }
      let g2 = match vec_arm_kind(p) {
        VArmUnsupported -> {
          let perr = mk_diag(SevError, g1.st.file, p.line, p.col,
            "Vec match arms support `[]` / `[a, b, ...rest]` with simple binders, and a catch-all", [])
          VecMatchGate { st: st_bump_err(st_help(st_push_diag(g1.st, perr), "bind the element and match it separately: `[h, ...t] -> match h { ... }`")), ok: false }
        }
        _ -> g1
      }
      let gr = vec_match_check_arms(g2.st, rest)
      VecMatchGate { st: gr.st, ok: g2.ok and gr.ok }
    }
  }


#[doc("Typer-internal helper `sym_names` shared across the infer modules.")]
pub fn sym_names(tab: SymTab, ss: [SymId]) : [String] = map(ss, (s) => written_text(decl_name(tab, s)))


#[doc("Typer-internal helper `ctor_first_parent` shared across the infer modules.")]
pub fn ctor_first_parent(parents: [String]) : String = match parents {
  []        -> "<Type>"
  [p, ..._] -> p
}


# The two sums whose constructors the runtime builds.
fn sym_is_core_sum(s: SymId) : Bool = core_ty_is(s, CtResult) or core_ty_is(s, CtOption)


# Helper: render `Result.Ok, Response.Ok` for the ambiguity note.
#[doc("Typer-internal helper `format_ctor_candidates` shared across the infer modules.")]
pub fn format_ctor_candidates(cname: String, parents: [String]) : String =
  format_ctor_candidates_loop(cname, parents, "")


fn format_ctor_candidates_loop(cname: String, parents: [String], acc: String) : String {
  match parents {
    [] -> acc
    [p, ...rest] -> {
      let one = concat_all([p, ".", cname])
      let sep = if string_length(acc) == 0 { "" } else { ", " }
      format_ctor_candidates_loop(cname, rest, concat_all([acc, sep, one]))
    }
  }
}


# Fix B helper: walk list elements, type-check each against expected
# element type. For plain `mk_int_synth(n)` literals expected to be Byte,
# validate 0..255 and retag the node as TyByte; the emitter handles
# the kai_byte(...) lowering.
#[doc("Typer-internal helper `ty_is_vec_head` shared across the infer modules.")]
pub fn ty_is_vec_head(t: Ty) : Bool =
  match t {
    TyCon(tcs, _) -> core_ty_is(tcs, CtVec)
    _             -> false
  }


#[doc("Typer-internal helper `unboxed_expr` shared across the infer modules.")]
pub fn unboxed_expr(e: Expr) : Expr =
  Expr { kind: e.kind, line: e.line, col: e.col, ty: e.ty, mode: MUnboxed,  site: e.site }


# True when `e` already HOLDS the flat inline representation: the
# `__fixed_vec_lit` intrinsic itself, or a read of a binder that holds
# one (an aliasing `let`, the fixed-vec match's whole-vec binder). Any
# other `Vec[e]<n>`-typed expression (a function return, a field read) is
# a dynamic heap vec at runtime, so its binder de-brands.
fn is_fixed_vec_lit(e: Expr) : Bool = match e.kind {
  ECall(callee, _) -> match callee.kind { EMark(MkFixedVecLit) -> true  _ -> false }
  ELocal(_) -> match e.ty { Some(t) -> ty_is_fixed_vec(t)  None -> false }
  ESym(_, _) -> match e.ty { Some(t) -> ty_is_fixed_vec(t)  None -> false }
  _ -> false
}


# Drop the `Dim` brand off a fixed vec, yielding the dynamic `Vec[e]`.
fn fixed_vec_unbrand(t: Ty) : Ty = match t { TyDimT(base, _) -> base  _ -> t }


# The verdict on a fixed-Vec habitant against a literal of `n`
# elements: the habitant to brand with, a length mismatch carrying
# the fixed length, or a non-index habitant.
#[doc("Typer-internal type `FixedVecHab` shared across the infer modules.")]
pub type FixedVecHab = FVOk(UnitExprT) | FVLen(Int) | FVCarrier


#[doc("Typer-internal helper `fixed_vec_hab` shared across the infer modules.")]
pub fn fixed_vec_hab(hab: UnitExprT, n: Int) : FixedVecHab = match hab {
  UOne -> if n == 1 { FVOk(UOne) } else { FVLen(1) }
  USym(s) -> {
    let bare = kind_sym_bare(s)
    if unit_sym_is_int_value(bare) {
      if decode_int(bare) == n { FVOk(hab) } else { FVLen(decode_int(bare)) }
    } else { FVCarrier }
  }
  UVar(_) -> FVOk(USym(kind_qualify_sym(dim_kind_name(), int_to_string(n))))
  _ -> FVCarrier
}


#[doc("Typer-internal helper `brand_vec_lit` shared across the infer modules.")]
pub fn brand_vec_lit(r: Inferred, hab: UnitExprT) : Inferred {
  let bty = TyDimT(r.ty, hab)
  mk_inferred(r.st, bty, with_ty(r.expr, bty))
}


#[doc("Typer-internal type `VecElems` shared across the infer modules.")]
pub type VecElems = { st: InferState, elems: [Expr] }


#[doc("Typer-internal helper `vec_lit_has_spread` shared across the infer modules.")]
pub fn vec_lit_has_spread(els: [ListElem]) : Bool =
  match els {
    [] -> false
    [el, ...rest] -> match el {
      ElSpread(_) -> true
      ElPlain(_)  -> vec_lit_has_spread(rest)
    }
  }


#[doc("Typer-internal helper `vec_collect_via_list` shared across the infer modules.")]
pub fn vec_collect_via_list(e: Expr, line: Int, col: Int) : Expr =
  mk_expr(ECall(builtin_mk(CbVecFromList, line, col), [e]), line, col)


# Unroll `[e0, ..., ek] | f | g` into `[g(f(e0)), ..., g(f(ek))]`. Only a
# spread-free literal head qualifies: its length is the count, and each
# element is applied independently so no stage runs more than once per
# element (the map semantics). The result is a bare literal, so it rides
# the fixed-vec literal path unchanged.
#[doc("Typer-internal helper `fixed_collect_unroll` shared across the infer modules.")]
pub fn fixed_collect_unroll(fc: FusedCollect, line: Int, col: Int) : Option[Expr] =
  match fc.source.kind {
    EList(els) ->
      if vec_lit_has_spread(els) { None }
      else { Some(mk_expr(EList(fixed_collect_elems(els, fc.stages, line, col)), line, col)) }
    _ -> None
  }


fn fixed_collect_elems(els: [ListElem], stages: [Expr], line: Int, col: Int) : [ListElem] =
  fixed_collect_elems_at(els, stages, 0, line, col)


# Every per-element copy of a stage takes its own column: perceus keys
# last-use on node position, and a lambda stage lifts to a symbol named
# after its position — duplicate positions would collide on both.
fn fixed_collect_elems_at(els: [ListElem], stages: [Expr], i: Int,
                          line: Int, col: Int) : [ListElem] =
  match els {
    [] -> []
    [el, ...rest] -> {
      let tail = fixed_collect_elems_at(rest, stages, i + 1, line, col)
      match el {
        ElPlain(x) -> [ElPlain(fixed_collect_apply(x, stages, i, 0, line, col)), ...tail]
        ElSpread(_) -> tail
      }
    }
  }


fn fixed_collect_apply(x: Expr, stages: [Expr], i: Int, j: Int, line: Int, col: Int) : Expr =
  match stages {
    [] -> x
    [s, ...rest] -> {
      let sref = Expr { kind: s.kind, line: s.line, col: col + i * 100 + j, ty: s.ty, mode: s.mode,  site: s.site }
      fixed_collect_apply(mk_expr(ECall(sref, [x]), line, col), rest, i, j + 1, line, col)
    }
  }


#[doc("True when a type is `Vec`-headed, seeing through any `Dim` brand — the fixed-width representation reads this to keep a `Vec<1>` distinct from the dynamic `Vec`.")]
pub fn ty_vec_headed(t: Ty) : Bool = match t {
  TyDimT(inner, _) -> ty_vec_headed(inner)
  TyCon(tcs, _) -> core_ty_is(tcs, CtVec)
  _ -> false
}


# walk arms and rewrite `PVariantRecord(name, fields)` to
# `PRecord(fields)` whenever `name` is a record-alias declaration
# (registered in `recs` via `collect_records`). Recurses into nested
# patterns so a `PVariantRecord` buried inside `PAs` / `PList` /
# another record field is also rewritten.
#[doc("Typer-internal helper `rewrite_record_alias_arms` shared across the infer modules.")]
pub fn rewrite_record_alias_arms(arms: [Arm], recs: [RecInfo]) : [Arm] {
  match arms {
    [] -> []
    [a, ...rest] -> match a {
      Arm(pat, guard, body) ->
        [Arm(rewrite_record_alias_pat(pat, recs), guard, body),
         ...rewrite_record_alias_arms(rest, recs)]
    }
  }
}


fn rewrite_record_alias_pat(pat: Pattern, recs: [RecInfo]) : Pattern {
  match pat.pkind {
    PVariantRecord(r, fs) -> {
      let fs_r = rewrite_record_alias_pfields(fs, recs)
      match rec_find(recs, ref_sym(r)) {
        Some(_) -> Pattern { pkind: PRecord(fs_r), line: pat.line, col: pat.col }
        None    -> Pattern { pkind: PVariantRecord(r, fs_r), line: pat.line, col: pat.col }
      }
    }
    PRecord(fs) ->
      Pattern { pkind: PRecord(rewrite_record_alias_pfields(fs, recs)),
                line: pat.line, col: pat.col }
    PVariant(r, subs) ->
      Pattern { pkind: PVariant(r, rewrite_record_alias_pat_list(subs, recs)),
                line: pat.line, col: pat.col }
    PList(subs, rest) ->
      Pattern { pkind: PList(rewrite_record_alias_pat_list(subs, recs), rest),
                line: pat.line, col: pat.col }
    PAs(name, inner) ->
      Pattern { pkind: PAs(name, rewrite_record_alias_pat(inner, recs)),
                line: pat.line, col: pat.col }
    _ -> pat
  }
}


fn rewrite_record_alias_pat_list(ps: [Pattern], recs: [RecInfo]) : [Pattern] {
  match ps {
    [] -> []
    [p, ...rest] -> [rewrite_record_alias_pat(p, recs),
                     ...rewrite_record_alias_pat_list(rest, recs)]
  }
}


fn rewrite_record_alias_pfields(fs: [PField], recs: [RecInfo]) : [PField] {
  match fs {
    [] -> []
    [f, ...rest] -> match f {
      PField(name, sub, sh) -> [PField(name, rewrite_record_alias_pat(sub, recs), sh),
                                ...rewrite_record_alias_pfields(rest, recs)]
    }
  }
}


#[doc("Typer-internal helper `expand_narrow_one` shared across the infer modules.")]
pub fn expand_narrow_one(vs: [SymId], name: Binder, guard: Option[Expr],
                      body: Expr, line: Int, col: Int) : [Arm] {
  match vs {
    [] -> []
    [v, ...rest] -> {
      let inner = mk_pat(PVariant(DrSym(v), []), line, col)
      let pas = mk_pat(PAs(name, inner), line, col)
      [Arm(pas, guard, body), ...expand_narrow_one(rest, name, guard, body, line, col)]
    }
  }
}


fn is_catch_all_pat(pat: Pattern) : Bool {
  match pat.pkind {
    PWild     -> true
    PBind(_)  -> true
    PHole(_)  -> true
    # `name @ catch_all` is itself a catch-all — the binding
    # does not narrow the cases the arm covers.
    PAs(_, sub) -> is_catch_all_pat(sub)
    _         -> false
  }
}


#[doc("True when an unguarded arm matches every value.")]
pub fn has_catch_all(arms: [Arm]) : Bool = match arms {
  [] -> false
  [Arm(pat, None, _), ...rest] -> if is_catch_all_pat(pat) { true } else { has_catch_all(rest) }
  [_, ...rest] -> has_catch_all(rest)
}


# The declaration an arm's head names: a constructor, or the record
# type of a record pattern. Drills through `name @ inner` so
# `Some(x) @ pat` and similar shapes still report their variant.
fn arm_head_sym(pat: Pattern) : SymId {
  match pat.pkind {
    PVariant(r, _)       -> ref_sym(r)
    PVariantRecord(r, _) -> ref_sym(r)
    PAs(_, sub)          -> arm_head_sym(sub)
    _                    -> sym_none()
  }
}


#[doc("Typer-internal helper `arms_head` shared across the infer modules.")]
pub fn arms_head(arms: [Arm], target: SymId) : Bool {
  match arms {
    [] -> false
    [Arm(pat, _, _), ...rest] ->
      if sym_raw(target) >= 0 and sym_same(arm_head_sym(pat), target) { true } else { arms_head(rest, target) }
  }
}


# The declaration of the nominal type a scheme builds, as a function's
# result or as the type itself; absent when it builds none.
#[doc("Typer-internal helper `scheme_ret_sym` shared across the infer modules.")]
pub fn scheme_ret_sym(sc: TyScheme) : SymId = match sc {
  Scheme(_, _, _, _, TyFnT(_, ret, _)) -> ut_ty_sym(ret)
  Scheme(_, _, _, _, ty)               -> ut_ty_sym(ty)
}

