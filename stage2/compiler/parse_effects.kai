#[doc("""
`effect` declarations and their operations.
""")]

import compiler.lex_tokens
import compiler.ast
import compiler.decl_names
import compiler.parse_state
import compiler.parse
import compiler.parse_fns

#[doc("""
`effect Eff[T1, T2] { op_decl ... }`. No name resolution and no
evidence-type emission live here. Each op_decl is
`name(params) : ReturnType`, body-less. The optional `[T1, T2]`
tparam list after the effect name puts its tparams in scope inside
every op signature's parameter and return types.
""")]
pub fn parse_effect_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) {
    err_d(p_error(p, id, "expected effect name"))
  } else {
    let p1n = p_skip_newlines(p_advance(p))
    let tparams_r =
      if p_at(p1n, TkLbracket) {
        parse_type_params_loop(p_skip_newlines(p_advance(p1n)), [])
      } else {
        PTParams { p: p1n, r: Some([]) }
      }
    match tparams_r.r {
      None -> err_d(tparams_r.p)
      Some(tparams) -> parse_effect_body(p_skip_newlines(tparams_r.p), p, is_pub, t, tok_source(p.src, id), tparams)
    }
  }
}

fn parse_effect_body(p2: Parser, p: Parser, is_pub: Bool, t: Token, name: String,
                     tparams: [TBinder]) : PDecl / Console {
  if not p_at(p2, TkLbrace) {
    err_d(p_error_here(p2, "expected `{` to start effect body"))
  } else {
    let ops_r = parse_effect_ops(p_skip_newlines(p_advance(p2)), [])
    match ops_r.r {
      None -> err_d(ops_r.p)
      Some(ops) -> {
        let after_ops = p_skip_newlines(ops_r.p)
        let id_t = p_peek(after_ops)
        if tk_is(id_t.kind, TkIdent) and tok_source(after_ops.src, id_t) == "default" {
          parse_effect_default(after_ops, id_t, p, is_pub, t, name, tparams, ops)
        } else {
          ok_dn(ops_r.p, DEffect(is_pub, p_sym(p, NCEffect, name), tparams, ops, None, t.line, t.col, None),
                [p_ent(p, NCEffect, name, is_pub)])
        }
      }
    }
  }
}

fn parse_effect_default(after_ops: Parser, id_t: Token, p: Parser, is_pub: Bool, t: Token,
                        name: String, tparams: [TBinder], ops: [EffectOp]) : PDecl / Console {
  let p_after_default = p_skip_newlines(p_advance(after_ops))
  if not p_at(p_after_default, TkLbrace) {
    err_d(p_error_here(p_after_default, "expected `{` after `default`"))
  } else {
    let cr = parse_handle_clauses(p_skip_newlines(p_advance(p_after_default)), [], None, [])
    match cr.r {
      None -> err_d(cr.p)
      Some(_) -> {
        let p_after_block = p_skip_newlines(cr.p)
        if not p_at(p_after_block, TkRbrace) {
          err_d(p_error_here(p_after_block,
            "expected `}` to close effect body after `default` block"))
        } else {
          let defblk = DBlk(cr.clauses, cr.return_clause, id_t.line, id_t.col)
          ok_dn(p_advance(p_after_block), DEffect(is_pub, p_sym(p, NCEffect, name), tparams, ops,
                                                  Some(defblk), t.line, t.col, None),
                [p_ent(p, NCEffect, name, is_pub)])
        }
      }
    }
  }
}

type PEffectOps = { p: Parser, r: Option[[EffectOp]] }

# Stops before `default {` without consuming it; the effect decl parses that block.
fn parse_effect_ops(p: Parser, acc: [EffectOp]) : PEffectOps / Console {
  let p0 = p_skip_newlines(p)
  if p_at(p0, TkRbrace) {
    PEffectOps { p: p_advance(p0), r: Some(list_reverse(acc)) }
  } else {
    let id = p_peek(p0)
    if not tk_is(id.kind, TkIdent) {
      PEffectOps { p: p_error(p0, id, "expected operation name"), r: None }
    } else if is_upper_ident(p0.src, id) {
      PEffectOps { p: p_error(p0, id, "effect operation names must start with a lowercase letter"), r: None }
    } else if tok_source(p0.src, id) == "default" and p_at(p_skip_newlines(p_advance(p0)), TkLbrace) {
      PEffectOps { p: p0, r: Some(list_reverse(acc)) }
    } else {
      parse_effect_op(p0, id, acc)
    }
  }
}

fn parse_effect_op(p0: Parser, id: Token, acc: [EffectOp]) : PEffectOps / Console {
  let p1 = p_advance(p0)
  let op_tparams_r =
    if p_at(p1, TkLbracket) {
      parse_type_params_loop(p_skip_newlines(p_advance(p1)), [])
    } else {
      PTParams { p: p1, r: Some([]) }
    }
  match op_tparams_r.r {
    None -> PEffectOps { p: op_tparams_r.p, r: None }
    Some(op_tparams) -> parse_effect_op_sig(op_tparams_r.p, id, op_tparams, acc)
  }
}

fn parse_effect_op_sig(pp: Parser, id: Token, op_tparams: [TBinder], acc: [EffectOp]) : PEffectOps / Console {
  if not p_at(pp, TkLparen) {
    PEffectOps { p: p_error_here(pp, "expected `(` after operation name"), r: None }
  } else {
    let params_r = parse_fn_params(p_skip_newlines(p_advance(pp)), [])
    match params_r.r {
      None -> PEffectOps { p: params_r.p, r: None }
      Some(params) -> parse_effect_op_ret(p_skip_newlines(params_r.p), id, op_tparams, params, acc)
    }
  }
}

fn parse_effect_op_ret(p3: Parser, id: Token, op_tparams: [TBinder], params: [Param],
                       acc: [EffectOp]) : PEffectOps / Console {
  if not p_at(p3, TkColon) {
    PEffectOps { p: p_error_here(p3, "expected `:` before operation return type"), r: None }
  } else {
    let rt = parse_type(p_advance(p3))
    match rt.r {
      None -> PEffectOps { p: rt.p, r: None }
      Some(ty) -> {
        let op : EffectOp = EffOp(tok_source(p3.src, id), op_tparams, params, ty, id.line, id.col)
        parse_effect_ops(rt.p, [op, ...acc])
      }
    }
  }
}

#[doc("""
Closed effect-alias body. Caller has consumed the first label and
the `+` separator; `acc` holds the labels parsed so far in reverse
order. Subsequent labels are effect names, optionally module-qualified,
each with optional `[T1, T2]` arguments, separated by `+`. Validation
that each label refers to a declared effect, plus cycle detection,
happens at resolve time.
""")]
pub fn parse_effect_alias_body(p: Parser, acc: [RowLabel], is_pub: Bool, name: String, tparams: [TBinder], slots: [String], t: Token) : PDecl / Console {

  let hd = p_peek(p)
  if not tk_is(hd.kind, TkIdent) or not (is_upper_ident(p.src, hd) or at_qualified_member(p, hd)) {
    err_d(p_error(p, hd, "expected uppercase effect name in effect alias"))
  } else {
    let qn = parse_qualified_head_name(p, hd)
    let p1 = qn.p
    let args_r =
      if p_at(p1, TkLbracket) { parse_row_label_args(p_skip_newlines(p_advance(p1)), []) }
      else { PRowArgs { p: p1, r: Some([]) } }
    match args_r.r {
      None -> err_d(args_r.p)
      Some(targs) -> {
        let acc1 = [RL(qn.dref, targs), ...acc]
        if p_at(args_r.p, TkPlus) {
          parse_effect_alias_body(p_advance(args_r.p), acc1, is_pub, name, tparams, slots, t)
        } else {
          ok_dn(args_r.p, DType(is_pub, p_sym(p, NCType, name), tparams, TBEffectAlias(list_reverse(acc1)), t.line, t.col, None, slots), [p_ent(p, NCType, name, is_pub)])
        }
      }
    }
  }
}

#[doc("The label a parsed alias body turns out to head, when a `+` follows it.")]
pub fn effect_alias_head(p: Parser, ty: TypeExpr) : Option[RowLabel] =
  if not p_at(p, TkPlus) { None }
  else { match ty.tkind {
    TyName(DrWritten(q, n), targs) -> Some(RL(DrWritten(q, n), targs))
    _                              -> None
  } }

#[doc("""
`mod.Type` in member position. A constructor never carries a module
qualifier, so this spelling only ever reads as a union over a
pre-declared type. A variant has no slot for what was written, so the
member's entry carries the qualified spelling until the module pass
settles it.
""")]
pub fn at_qualified_member(p: Parser, t: Token) : Bool =
  (not is_upper_ident(p.src, t)) and tk_is(p_peek1(p).kind, TkDot) and tk_is(p_peek2(p).kind, TkIdent) and is_upper_ident(p.src, p_peek2(p))
