#[doc("`effect` declarations, their operations and effect aliases.")]

import compiler.lex_tokens
import compiler.ast
import compiler.decl_names
import compiler.parse_state
import compiler.parse_types
import compiler.parse_handle
import compiler.parse_fns

type EffHead = { p: Parser, is_pub: Bool, t: Token, name: String, tparams: [TBinder] }

type PEffectOps = { p: Parser, r: Option[[EffectOp]] }

#[doc("Parses an optional `[T, ...]` type-parameter list.")]
pub fn parse_opt_type_params(p: Parser) : PTParams / Console =
  if p_at(p, TkLbracket) { parse_type_params_loop(p_advance_nl(p), []) }
  else { PTParams { p: p, r: Some([]) } }

#[doc("Parses `effect Eff[T, ...] { op(params) : Ret ... [default { clauses }] }`.")]
pub fn parse_effect_decl(p: Parser, is_pub: Bool, t: Token) : PDecl / Console {
  let id = p_peek(p)
  if not tk_is(id.kind, TkIdent) { err_d(p_error(p, id, "expected effect name")) }
  else {
    let tp = parse_opt_type_params(p_skip_newlines(p_advance(p)))
    match tp.r {
      None -> err_d(tp.p)
      Some(tparams) -> effect_body(p_skip_newlines(tp.p), EffHead { p: p, is_pub: is_pub, t: t, name: tok_source(p.src, id), tparams: tparams })
    }
  }
}

fn effect_decl(h: EffHead, ops: [EffectOp], default: Option[DefaultBlock], p: Parser) : PDecl =
  ok_dn(p, DEffect(h.is_pub, p_sym(h.p, NCEffect, h.name), h.tparams, ops, default, h.t.line, h.t.col, None),
        [p_ent(h.p, NCEffect, h.name, h.is_pub)])

fn effect_body(p: Parser, h: EffHead) : PDecl / Console {
  let p1 = p_eat(p, TkLbrace, "expected `{` to start effect body")
  if p_failed(p1) { err_d(p1) }
  else {
    let ops = parse_effect_ops(p_skip_newlines(p1), [])
    match ops.r {
      None -> err_d(ops.p)
      Some(xs) -> effect_after_ops(ops.p, h, xs)
    }
  }
}

fn effect_after_ops(p: Parser, h: EffHead, ops: [EffectOp]) : PDecl / Console {
  let after = p_skip_newlines(p)
  let id_t = p_peek(after)
  if tk_is(id_t.kind, TkIdent) and tok_source(after.src, id_t) == "default" { effect_default(after, id_t, h, ops) }
  else { effect_decl(h, ops, None, p) }
}

fn effect_default(after: Parser, id_t: Token, h: EffHead, ops: [EffectOp]) : PDecl / Console {
  let p1 = p_eat(p_advance_nl(after), TkLbrace, "expected `{` after `default`")
  if p_failed(p1) { err_d(p1) }
  else {
    let cr = parse_handle_clauses(p_skip_newlines(p1), [], None, [])
    match cr.r {
      None -> err_d(cr.p)
      Some(_) -> {
        let p2 = p_eat(p_skip_newlines(cr.p), TkRbrace, "expected `}` to close effect body after `default` block")
        if p_failed(p2) { err_d(p2) }
        else { effect_decl(h, ops, Some(DBlk(cr.clauses, cr.return_clause, id_t.line, id_t.col)), p2) }
      }
    }
  }
}

fn ops_err(p: Parser, t: Token, msg: String) : PEffectOps / Console = PEffectOps { p: p_error(p, t, msg), r: None }

fn ops_failed(p: Parser) : PEffectOps = PEffectOps { p: p, r: None }

fn parse_effect_ops(p: Parser, acc: [EffectOp]) : PEffectOps / Console {
  let p0 = p_skip_newlines(p)
  let id = p_peek(p0)
  if p_at(p0, TkRbrace) { PEffectOps { p: p_advance(p0), r: Some(list_reverse(acc)) } }
  else if not tk_is(id.kind, TkIdent) { ops_err(p0, id, "expected operation name") }
  else if is_upper_ident(p0.src, id) { ops_err(p0, id, "effect operation names must start with a lowercase letter") }
  else if tok_source(p0.src, id) == "default" and p_at(p_advance_nl(p0), TkLbrace) {
    PEffectOps { p: p0, r: Some(list_reverse(acc)) }
  } else {
    parse_effect_op(p0, id, acc)
  }
}

fn parse_effect_op(p: Parser, id: Token, acc: [EffectOp]) : PEffectOps / Console {
  let tp = parse_opt_type_params(p_advance(p))
  match tp.r {
    None -> ops_failed(tp.p)
    Some(tparams) -> effect_op_sig(tp.p, id, tparams, acc)
  }
}

fn effect_op_sig(p: Parser, id: Token, tparams: [TBinder], acc: [EffectOp]) : PEffectOps / Console {
  let p1 = p_eat(p, TkLparen, "expected `(` after operation name")
  if p_failed(p1) { ops_failed(p1) }
  else {
    let ps = parse_fn_params(p_skip_newlines(p1), [])
    match ps.r {
      None -> ops_failed(ps.p)
      Some(params) -> effect_op_ret(p_skip_newlines(ps.p), id, tparams, params, acc)
    }
  }
}

fn effect_op_ret(p: Parser, id: Token, tparams: [TBinder], params: [Param], acc: [EffectOp]) : PEffectOps / Console {
  let p1 = p_eat(p, TkColon, "expected `:` before operation return type")
  if p_failed(p1) { ops_failed(p1) }
  else {
    let rt = parse_type(p1)
    match rt.r {
      None -> ops_failed(rt.p)
      Some(ty) -> parse_effect_ops(rt.p, [EffOp(tok_source(p.src, id), tparams, params, ty, id.line, id.col), ...acc])
    }
  }
}

#[doc("""
Parses the labels of an effect alias after the first `+`; `acc` holds the
labels so far in reverse. Whether each label names a declared effect is a
resolve-time check.
""")]
pub fn parse_effect_alias_body(p: Parser, acc: [RowLabel], is_pub: Bool, name: String, tparams: [TBinder], slots: [String], t: Token) : PDecl / Console {
  let hd = p_peek(p)
  if not at_type_head(p, hd) { err_d(p_error(p, hd, "expected uppercase effect name in effect alias")) }
  else {
    let qn = parse_qualified_head_name(p, hd)
    let a = parse_opt_row_args(qn.p)
    match a.r {
      None -> err_d(a.p)
      Some(targs) -> {
        let acc1 = [RL(qn.dref, targs), ...acc]
        if p_at(a.p, TkPlus) { parse_effect_alias_body(p_advance(a.p), acc1, is_pub, name, tparams, slots, t) }
        else {
          ok_dn(a.p, DType(is_pub, p_sym(p, NCType, name), tparams, TBEffectAlias(list_reverse(acc1)), t.line, t.col, None, slots),
                [p_ent(p, NCType, name, is_pub)])
        }
      }
    }
  }
}

#[doc("The label a parsed alias body turns out to head, when a `+` follows it.")]
pub fn effect_alias_head(p: Parser, ty: TypeExpr) : Option[RowLabel] =
  match ty.tkind {
    TyName(DrWritten(q, n), targs) if p_at(p, TkPlus) -> Some(RL(DrWritten(q, n), targs))
    _ -> None
  }
