#[doc("""
Parameter slots for tail-call fusion.

A fused group's entry takes one slot per parameter it has to carry.
Members share a slot when `tailsig` says their parameters may, so a
group whose members already agree costs no more slots than one member,
and a call to a member fills its own slots and passes the absent value
in the rest.
""")]

import compiler.ast
import compiler.tailsig

#[doc("The fused entry's parameter slots and, per member, the slot each of its parameters lands in. Members share a slot when type and borrow mode agree, and the first member's parameters take slots 0 to k-1 in order.")]
pub type TfSlots = TfSlots([Param], [[Int]])

#[doc("Assign the parameters of `ds`, in order, to shared slots.")]
pub fn tfslots_layout(ds: [Decl]) : TfSlots = tf_slots_go(ds, [], [])

fn tf_slots_go(ds: [Decl], slots: [Param], acc: [[Int]]) : TfSlots = match ds {
  [] -> TfSlots(slots, list_reverse(acc))
  [d, ...rest] -> match d {
    DFn(_, _, _, ps, _, _, _, _, _, _, _) -> match tf_place(ps, slots, []) {
      TfPlaced(slots2, idxs) -> tf_slots_go(rest, slots2, [idxs, ...acc])
    }
    _ -> tf_slots_go(rest, slots, acc)
  }
}

# The slots after placing one member, and the slot of each of its parameters.
type TfPlaced = TfPlaced([Param], [Int])

# `used` holds the slots the member already took, newest first.
fn tf_place(ps: [Param], slots: [Param], used: [Int]) : TfPlaced = match ps {
  [] -> TfPlaced(slots, list_reverse(used))
  [p, ...rest] -> match tf_free_slot(slots, p, used, 0) {
    Some(i) -> tf_place(rest, slots, [i, ...used])
    None    -> tf_place(rest, list_append(slots, [p]), [list_length(slots), ...used])
  }
}

fn tf_free_slot(slots: [Param], p: Param, used: [Int], i: Int) : Option[Int] = match slots {
  [] -> None
  [s, ...rest] ->
    if not tf_int_has(used, i) and tfsig_param_shares(s, p) { Some(i) }
    else { tf_free_slot(rest, p, used, i + 1) }
}

fn tf_int_has(xs: [Int], x: Int) : Bool = match xs {
  [] -> false
  [h, ...rest] -> h == x or tf_int_has(rest, x)
}

#[doc("The intrinsic a fused call passes in the slots its target member does not take: it types as any type, lowers to the immortal unit value when boxed and to a zero when raw, and is never read.")]
pub fn tfslots_absent() : String = "__kai_absent"

#[doc("True for the absent-value intrinsic's name.")]
pub fn tfslots_is_absent(nm: String) : Bool = nm == tfslots_absent()
