# compiler/core_reach.kai -- the core functions a build can
# reach, so the rest are never typed, lowered or emitted.
#
# Runs on the resolved program, after protocol lowering has turned every
# impl method into a `__pimpl_*` function and every protocol operation
# into a `__proto_*` dispatcher. Every decl outside the core is a
# root, and so is every core decl that is not a function. A function is
# reached by name, homonyms included. A field access reaches its name
# too, since `x.f(..)` may be method sugar the typer resolves to `f`. A
# protocol is reached through an operation's name, its dispatcher or an
# operator that is sugar for it, and keeps every impl, because the
# dispatcher picks one at run time. Protocols declaring an operation of the
# same name share one dispatcher, so the name reaches all of them. A pipe
# keeps the core functions the typer inserts for it.

import compiler.util
import compiler.ast
import compiler.expr_positions
import compiler.infer_index
import compiler.core_refs
import compiler.emit_shared
import compiler.evidence_inject
import compiler.proto_op_index

#[doc("A pruned program: the decls a build keeps and the names of the core functions it dropped.")]
pub type CoreCut = CoreCut([Decl], [String])

#[doc("Drop the core functions nothing in `decls` can reach. `core_mods` are the core modules; `reg` the protocol registry, whose impl entries map each `__pimpl_*` to its protocol.")]
pub fn core_reach(decls: [Decl], core_mods: [String], reg: ProtocolReg) : CoreCut / Console = {
  let core_fns = filter(decls, (d) => cr_is_core_fn(d, core_mods))
  let st0 = CrSt { live: idx_empty(), fns: cr_index(core_fns, idx_empty()), impls: reg.impls,
                   disps: cr_dispatchers(core_fns, []), ops: op_index(reg.ops),
                   protos: [], bps: [], trigs: [], work: [] }
  let st = cr_drain(cr_decls(filter(decls, (d) => not cr_is_core_fn(d, core_mods)), st0))
  CoreCut(filter(decls, (d) => not cr_is_core_fn(d, core_mods) or cr_in(st.live, cr_name(d))),
             map(filter(core_fns, (d) => not cr_in(st.live, cr_name(d))), cr_name))
}

#[doc("The dropped core functions `decls` still reference, each a reachability rule pruning is missing. A specialisation counts as its template; a name some decl in `decls` declares is never a miss. Run it on the monomorphised program: later passes read and drop local binders, whose names can coincide with a dropped function.")]
pub fn core_cut_misses(decls: [Decl], dropped: [String]) : [String] / Console = {
  let declared = cr_name_set(map(filter(decls, cr_is_fn), (d) => evi_demangle_base(cr_name(d))), idx_empty())
  let ck = CrCheck { gone: cr_name_set(dropped, idx_empty()), declared: declared, misses: [] }
  list_uniq(cr_check_decls(decls, ck).misses)
}

# ---- names -------------------------------------------------------------

fn cr_is_core_fn(d: Decl, core_mods: [String]) : Bool = match d {
  DFn(_, _, _, _, _, _, _, _, _, mo, _) -> match mo {
    Some(m) -> list_has(core_mods, m)
    None    -> false
  }
  _ -> false
}

fn cr_is_fn(d: Decl) : Bool = match d {
  DFn(_, _, _, _, _, _, _, _, _, _, _) -> true
  _ -> false
}

fn cr_name(d: Decl) : String = match d {
  DFn(_, n, _, _, _, _, _, _, _, _, _) -> n
  _ -> ""
}

fn cr_index(fns: [Decl], ix: NameIndex[Decl]) : NameIndex[Decl] = match fns {
  [] -> ix
  [d, ...rest] -> cr_index(rest, idx_prepend(ix, cr_name(d), d))
}

fn cr_name_set(ns: [String], ix: NameIndex[String]) : NameIndex[String] = match ns {
  [] -> ix
  [n, ...rest] -> cr_name_set(rest, idx_prepend(ix, n, n))
}

# Buckets are keyed by hash, so membership re-tests the name.
fn cr_in(ix: NameIndex[String], n: String) : Bool = list_has(idx_chain(ix, n), n)

fn cr_named(ds: [Decl], n: String) : Bool = match ds {
  [] -> false
  [d, ...rest] -> cr_name(d) == n or cr_named(rest, n)
}

# ---- reachability ------------------------------------------------------

# `live` holds the reached core function names; `work` the reached
# functions whose bodies are still to scan.
type CrSt = { live: NameIndex[String], fns: NameIndex[Decl], impls: [ProtoImplReg],
              disps: [CrDisp], ops: OpIndex, protos: [String], bps: [Int], trigs: [Int],
              work: [Decl] }

fn cr_op(st: CrSt, op: String) : CrSt = op_protocols_fold(st.ops, op, st, cr_proto)

# A dispatcher and its protocol. The typer calls a dispatcher by name
# when it lowers an operator, so a reached protocol reaches them too.
type CrDisp = CrDisp(String, String)

fn cr_dispatchers(fns: [Decl], acc: [CrDisp]) : [CrDisp] = match fns {
  [] -> acc
  [d, ...rest] -> cr_dispatchers(rest, match d {
    DFn(_, n, _, _, _, _, body, _, _, _, _) ->
      if not proto_dispatch_marker_in(body) { acc }
      else { match proto_dispatch_parts(body) { PDP(p, _) -> [CrDisp(p, n), ...acc] } }
    _ -> acc
  })
}

fn cr_disp_fns(ds: [CrDisp], p: String, acc: [String]) : [String] = match ds {
  [] -> acc
  [CrDisp(proto, n), ...rest] -> cr_disp_fns(rest, p, if proto == p { [n, ...acc] } else { acc })
}

fn cr_drain(st: CrSt) : CrSt / Console = match st.work {
  [] -> st
  [d, ...rest] -> cr_drain(cr_decl(d, cr_with_work(st, rest)))
}

fn cr_with_work(st: CrSt, w: [Decl]) : CrSt =
  CrSt { ...st, work: w }

# Reaching a name reaches every core function spelled so; references to
# anything else cost one lookup and no allocation.
fn cr_ref(st: CrSt, n: String) : CrSt = cr_op(cr_ref_fn(st, n), n)

fn cr_ref_fn(st: CrSt, n: String) : CrSt =
  if cr_in(st.live, n) { st }
  else {
    let ds = idx_chain(st.fns, n)
    if not cr_named(ds, n) { st }
    else {
      CrSt { ...st, live: idx_prepend(st.live, n, n), work: cr_push_named(ds, n, st.work) }
    }
  }

fn cr_push_named(ds: [Decl], n: String, w: [Decl]) : [Decl] = match ds {
  [] -> w
  [d, ...rest] -> cr_push_named(rest, n, if cr_name(d) == n { [d, ...w] } else { w })
}

fn cr_refs(st: CrSt, ns: [String]) : CrSt = match ns {
  [] -> st
  [n, ...rest] -> cr_refs(cr_ref(st, n), rest)
}

# A reached protocol reaches every impl and dispatcher of it.
fn cr_proto(st: CrSt, p: String) : CrSt =
  if p == "" or list_has(st.protos, p) { st }
  else {
    cr_refs(CrSt { ...st, protos: [p, ...st.protos] }, cr_impl_fns(st.impls, p, cr_disp_fns(st.disps, p, [])))
  }

fn cr_impl_fns(impls: [ProtoImplReg], p: String, acc: [String]) : [String] = match impls {
  [] -> acc
  [PIR(proto, _, _, fname, _, _, _, _), ...rest] ->
    cr_impl_fns(rest, p, if proto == p { [fname, ...acc] } else { acc })
}

fn cr_binop(st: CrSt, op: String) : CrSt = {
  let bp = binop_proto(op)
  let k = cr_bp_rank(bp)
  if k == 0 or list_has_int(st.bps, k) { st }
  else {
    cr_proto(CrSt { ...st, bps: [k, ...st.bps] }, op_proto_protocol(bp))
  }
}

fn cr_bp_rank(bp: BinopProto) : Int = match bp {
  BpNone -> 0
  BpAdd  -> 1
  BpSub  -> 2
  BpMul  -> 3
  BpDiv  -> 4
  BpRem  -> 5
  BpEq   -> 6
  BpOrd  -> 7
}

# A pipe reaches the core functions the typer inserts for it.
fn cr_trig(st: CrSt, t: CoreTrigger) : CrSt = {
  let k = cr_trig_rank(t)
  if list_has_int(st.trigs, k) { st }
  else {
    cr_refs(CrSt { ...st, trigs: [k, ...st.trigs] },
            map(filter(variants[CoreFn](), (cf) => core_fn_fires_on(cf, t)), core_fn_name))
  }
}

fn cr_trig_rank(t: CoreTrigger) : Int = match t {
  TrMapPipe     -> 1
  TrFlatMapPipe -> 2
  TrFilterPipe  -> 3
  TrRangeApply  -> 4
}

fn list_has_int(xs: [Int], k: Int) : Bool = match xs {
  [] -> false
  [h, ...rest] -> h == k or list_has_int(rest, k)
}

fn cr_decls(ds: [Decl], st: CrSt) : CrSt / Console = match ds {
  [] -> st
  [d, ...rest] -> cr_decls(rest, cr_decl(d, st))
}

fn cr_decl(d: Decl, st: CrSt) : CrSt / Console =
  cr_exprs(cr_decl_exprs(d), st)

fn cr_exprs(es: [Expr], st: CrSt) : CrSt / Console = match es {
  [] -> st
  [e, ...rest] -> cr_exprs(rest, cr_expr(e, st))
}

fn cr_expr(e: Expr, st: CrSt) : CrSt / Console = match e.kind {
  EVar(n)        -> cr_ref(st, n)
  ESym(_, _, n)  -> cr_ref(st, n)
  EModCall(_, n) -> cr_ref(st, n)
  ETodo(_)       ->
    if proto_dispatch_marker_in(e) { match proto_dispatch_parts(e) { PDP(p, op) -> cr_op(cr_proto(st, p), op) } }
    else { st }
  k -> cr_positions(xp_positions(e), cr_node(k, st))
}

# What a node reaches beyond its children's references.
fn cr_node(k: ExprKind, st: CrSt) : CrSt = match k {
  EField(_, n)       -> cr_ref(st, n)
  EBinop(op, _, _)   -> cr_binop(st, op)
  EMapPipe(_, _)     -> cr_trig(st, TrMapPipe)
  EFlatMapPipe(_, _) -> cr_trig(st, TrFlatMapPipe)
  EFilterPipe(_, _)  -> cr_trig(st, TrFilterPipe)
  EPipe(head, _)     -> match head.kind { ERange(_, _, _) -> cr_trig(st, TrRangeApply)  _ -> st }
  _ -> st
}

fn cr_positions(ps: [XPos], st: CrSt) : CrSt / Console = match ps {
  [] -> st
  [XP(_, x), ...rest] -> cr_positions(rest, cr_expr(x, st))
}

#[doc("The expressions a decl evaluates: bodies, constant initialisers and the clauses of an effect's default handler.")]
pub fn cr_decl_exprs(d: Decl) : [Expr] = match d {
  DFn(_, _, _, _, _, _, body, _, _, _, _)   -> [body]
  DTest(_, body, _, _, _)                   -> [body]
  DBench(_, body, _, _, _)                  -> [body]
  DCheck(_, _, body, _, _, _)               -> [body]
  DConst(_, _, _, body, _, _, _, _)         -> [body]
  DEffect(_, _, _, _, Some(DBlk(cs, ret, _, _)), _, _, _, _) ->
    list_append(map(cs, cr_clause_body), cr_ret_body(ret))
  DUnstable(inner, _, _)                    -> cr_decl_exprs(inner)
  DConstructor(inner, _, _)                 -> cr_decl_exprs(inner)
  DDoc(_, _, inner, _, _)                   -> cr_decl_exprs(inner)
  DAttr(_, inner, _, _)                     -> cr_decl_exprs(inner)
  _ -> []
}

fn cr_clause_body(c: HClause) : Expr = match c { HC(_, _, b, _, _) -> b }

fn cr_ret_body(o: Option[HReturn]) : [Expr] = match o {
  Some(HR(_, b, _, _)) -> [b]
  None -> []
}

# ---- the post-lowering check -------------------------------------------

type CrCheck = { gone: NameIndex[String], declared: NameIndex[String], misses: [String] }

fn cr_check_decls(ds: [Decl], ck: CrCheck) : CrCheck / Console = match ds {
  [] -> ck
  [d, ...rest] -> cr_check_decls(rest, cr_check_exprs(cr_decl_exprs(d), ck))
}

fn cr_check_exprs(es: [Expr], ck: CrCheck) : CrCheck / Console = match es {
  [] -> ck
  [e, ...rest] -> cr_check_exprs(rest, cr_check_expr(e, ck))
}

fn cr_check_expr(e: Expr, ck: CrCheck) : CrCheck / Console = match e.kind {
  EVar(n)        -> cr_check_ref(ck, n)
  ESym(_, _, n)  -> cr_check_ref(ck, n)
  EModCall(_, n) -> cr_check_ref(ck, n)
  _ -> cr_check_positions(xp_positions(e), ck)
}

fn cr_check_positions(ps: [XPos], ck: CrCheck) : CrCheck / Console = match ps {
  [] -> ck
  [XP(_, x), ...rest] -> cr_check_positions(rest, cr_check_expr(x, ck))
}

fn cr_check_ref(ck: CrCheck, n0: String) : CrCheck = {
  let n = evi_demangle_base(n0)
  if cr_in(ck.gone, n) and not cr_in(ck.declared, n) {
    CrCheck { gone: ck.gone, declared: ck.declared, misses: [n, ...ck.misses] }
  } else { ck }
}
