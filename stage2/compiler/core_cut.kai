#[doc("What a build keeps of the core: the cut, the demand scan that asks for functions, and the pruning that precedes it.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.util
import compiler.expr_positions
import compiler.infer_index
import compiler.core_refs
import compiler.symtab
import compiler.type_text
import compiler.user_cache
import compiler.impl_identity
import compiler.proto_ids
import compiler.scalar_ty
import compiler.unwind_clauses
import compiler.driver_exports
import compiler.written

#[doc("A pruned program: the decls a build keeps, the core functions it dropped, and the functions an earlier cut emptied that it keeps.")]
pub(pkg) type CoreCut = CoreCut([Decl], [SymId], [SymId])

#[doc("The declared names of `ss`, for the note a cut prints.")]
pub(pkg) fn core_cut_names(tab: SymTab, ss: [SymId]) : [String] = map(ss, (s) => written_text(sym_name(tab, s)))

fn cut_is_core_fn(d: Decl, core_mods: [String], keep_unw: Bool) : Bool = match d {
  DFn(_, _, _, _, _, _, _, _, _, mo) -> match mo {
    Some(m) -> list_has(core_mods, m) and not (keep_unw and unw_feeds_analysis(d))
    None    -> false
  }
  _ -> false
}

fn cut_prim_impl(i: ProtoImplReg) : Bool = match i {
  PIR(_, t, _, _, args, _, _) -> cut_prim_homogeneous(t, args, DhScalar(TyInt)) or cut_prim_homogeneous(t, args, DhScalar(TyReal))
}

fn cut_prim_homogeneous(t: DeclRef, args: [DeclRef], h: DispHead) : Bool =
  dh_ref_is(t, h) and match args {
    []  -> true
    [a] -> dh_ref_is(a, h)
    _   -> false
  }

#[doc("The expressions a decl evaluates: bodies, constant initialisers and the clauses of an effect's default handler.")]
pub(pkg) fn cut_decl_exprs(d: Decl) : [Expr] = match decl_transparent_inner(d) {
  Some(inner) -> cut_decl_exprs(inner)
  None -> match d {
    DEffect(_, _, _, _, Some(DBlk(cs, ret, _, _)), _, _, _) -> list_append(map(cs, cut_clause_body), cut_ret_body(ret))
    _ -> decl_bodies(d)
  }
}

fn cut_clause_body(c: HClause) : Expr = match c { HC(_, _, b, _, _) -> b }

fn cut_ret_body(o: Option[HReturn]) : [Expr] = match o {
  Some(HR(_, b, _, _)) -> [b]
  None -> []
}

#[doc("What the demand scan looks functions up in: the candidates, those and the ones an earlier cut left without a body by function for their signatures, and the protocol registry that names the impls and dispatchers of each protocol.")]
pub(pkg) type Demand = { decls: [Decl], pool: NameIndex[Decl], sigs: NameIndex[Decl], emptied: NameIndex[SymId], completes: Bool, impls: [ProtoImplReg], ops: [ProtoOpReg], cores: [String], ids: ProtoIds }

#[doc("The scan so far: the functions asked for, the protocols whose impls were asked for in full or without the primitive ones, the functions to type next and the ones asked for that have no body.")]
pub(pkg) type DmSt = { live: NameIndex[SymId], fulls: [SymId], lites: [SymId], want: [SymId], miss: [SymId] }

#[doc("A scan that has asked for nothing.")]
pub(pkg) fn dm_empty() : DmSt = DmSt { live: idx_empty(), fulls: [], lites: [], want: [], miss: [] }

#[doc("The candidates among `fused`, the program in the form the front end gets it, under the cut `pc` and the protocol registry `reg`.")]
pub(pkg) fn demand_new(fused: [Decl], pc: PoolCut, reg: ProtocolReg, completes: Bool) : Demand = {
  let pool = filter(fused, (d) => dm_has(pc.live, dm_sym_of(d)) or (completes and dm_has(pc.held, dm_sym_of(d))))
  let ix = foldl(pool, idx_empty(), (acc, d) => idx_prepend_sym(acc, dm_sym_of(d), d))
  Demand { decls: pool, pool: ix, sigs: foldl(pc.gone, ix, (acc, d) => idx_prepend_sym(acc, dm_sym_of(d), d)), emptied: pc.held, completes: completes, impls: reg.impls, ops: reg.ops, cores: reg.cores, ids: reg.ids }
}

#[doc("True when `s` is a function the cut emptied, so its body has to be completed before it is typed.")]
pub(pkg) fn demand_emptied(dm: Demand, s: SymId) : Bool = dm.completes and dm_has(dm.emptied, s)

#[doc("True when `s` is a candidate function.")]
pub(pkg) fn demand_pooled(dm: Demand, s: SymId) : Bool = dm_has(dm.pool, s)

fn demand_syms(dm: Demand, ds: [Decl]) : [SymId] = map(filter(ds, (d) => dm_has(dm.pool, dm_sym_of(d))), dm_sym_of)

fn dm_sym_of(d: Decl) : SymId = match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) -> fnid_sym(fid)
  _ -> sym_none()
}

fn dm_has(ix: NameIndex[a], s: SymId) : Bool = match idx_chain_sym(ix, s) {
  [] -> false
  _  -> true
}

#[doc("`st` after asking for what the typed declarations `typed` need.")]
pub(pkg) fn demand_scan(dm: Demand, st: DmSt, typed: [Decl]) : DmSt / Console =
  foldl(typed, st, (acc, d) => dm_exprs(dm, cut_decl_exprs(d), acc))

#[doc("The functions `st` asks for next, and `st` with none pending.")]
pub(pkg) fn demand_take(st: DmSt) : DmTake = DmTake(st.want, st.miss, DmSt { ...st, want: [], miss: [] })

#[doc("The functions to type next, the ones asked for without a body, and the scan to go on with.")]
pub(pkg) type DmTake = DmTake([SymId], [SymId], DmSt)

fn dm_exprs(dm: Demand, es: [Expr], st: DmSt) : DmSt / Console = match es {
  [] -> st
  [e, ...rest] -> dm_exprs(dm, rest, dm_expr(dm, e, st))
}

fn dm_expr(dm: Demand, e: Expr, st: DmSt) : DmSt / Console =
  dm_positions(dm, xp_positions(e), dm_node(dm, e, st))

fn dm_positions(dm: Demand, ps: [XPos], st: DmSt) : DmSt / Console = match ps {
  [] -> st
  [XP(_, x), ...rest] -> dm_positions(dm, rest, dm_expr(dm, x, st))
}

fn dm_node(dm: Demand, e: Expr, st: DmSt) : DmSt = match e.kind {
  ESym(s, _)           -> dm_ref(dm, st, s, e.ty)
  EMark(MkProtoOp(ss)) -> foldl(ss, st, (acc, s) => dm_ref(dm, acc, s, None))
  EBinop(op, l, r)     -> dm_binop(dm, st, binop_proto(op), l, r)
  EUnop(UoNeg, x)      -> if dm_negatable(x) { st } else { dm_operator(dm, st, core_proto_id(CpNeg), x) }
  _                    -> st
}

fn dm_ref(dm: Demand, st: DmSt, s: SymId, t: Option[Ty]) : DmSt =
  if sym_raw(s) < 0 { st }
  else if pid_is_disp(dm.ids, s) { dm_dispatch(dm, dm_ask(dm, st, s), s, t) }
  else if dm_has(st.live, s) { st }
  else { dm_ask(dm, st, s) }

fn dm_ask(dm: Demand, st: DmSt, s: SymId) : DmSt =
  if dm_has(st.live, s) { st }
  else if dm_has(dm.emptied, s) or dm_has(dm.pool, s) { dm_want(dm, DmSt { ...st }, s) }
  else { DmSt { ...st, live: idx_prepend_sym(st.live, s, s) } }

# A dispatcher called at a settled receiver type needs only the impl that serves it; a receiver not settled may be any type, so every impl.
fn dm_dispatch(dm: Demand, st: DmSt, s: SymId, t: Option[Ty]) : DmSt = {
  let head = dm_receiver_head(t)
  foldl(dm_protos(dm, s), st, (acc, p) => match head {
    Some(h) -> dm_served(dm, acc, p, h)
    None    -> dm_full(dm, acc, p)
  })
}

# Only a protocol whose every operation takes `Self` first dispatches on its first argument; one whose `Self` rides in a return type is picked by the expected type.
fn dm_receiver_first(dm: Demand, p: SymId) : Bool =
  all(filter(dm.ops, (o) => match o { POR(q, _, _, _, _, _, _, _) -> sym_same(q, p) }), (o) => match o {
    POR(_, _, [a, ..._], _, _, _, _, _) -> match a.ptype {
      Some(te) -> match te.tkind {
        TyParam(id, _) -> tlocal_is_self(id)
        _              -> false
      }
      None -> false
    }
    _ -> false
  })

fn dm_receiver_head(t: Option[Ty]) : Option[DispHead] = match t {
  Some(TyFnT([r, ..._], _, _)) -> dm_ty_head(r)
  _ -> None
}

fn dm_ty_head(t: Ty) : Option[DispHead] = match t {
  TyDimT(b, _)    -> dm_ty_head(b)
  TyRefineT(b, _) -> dm_ty_head(b)
  TyCon(s, _)     -> Some(DhSym(s))
  TyListT(_)      -> Some(DhSym(ty_head_sym(t)))
  _               -> match scalar_ty_name(t) {
    Some(_) -> Some(DhScalar(t))
    None    -> None
  }
}

fn dm_served(dm: Demand, st: DmSt, p: SymId, h: DispHead) : DmSt =
  if sym_raw(p) < 0 or list_has_sym(st.fulls, p) { st }
  else if not dm_receiver_first(dm, p) { dm_full(dm, st, p) }
  else {
    let fs = flat_map(dm.impls, (i) => match i {
      PIR(proto, _, _, f, _, _, _) -> if sym_same(proto, p) and pir_serves(i, h) { [f] } else { [] }
    })
    if list_is_empty(fs) { dm_full(dm, st, p) } else { dm_dispatchers(dm, dm_wants(dm, st, fs), p) }
  }

# Every protocol with a dispatcher that answers the same operation: a protocol of another home with that operation is picked among them by the receiver.
fn dm_protos(dm: Demand, s: SymId) : [SymId] =
  if pid_is_disp(dm.ids, s) {
    flat_map(dm.ids.shared, (pd) => match pd {
      ProtoDisp(p, q) -> if pid_same_op(dm.ids, s, q) { [p] } else { [] }
    })
  } else { [] }

fn dm_want(dm: Demand, st: DmSt, s: SymId) : DmSt =
  if sym_raw(s) < 0 or dm_has(st.live, s) { st }
  else if dm_has(dm.emptied, s) and not dm.completes { DmSt { ...st, live: idx_prepend_sym(st.live, s, s), miss: [s, ...st.miss] } }
  else if dm_has(dm.pool, s) { DmSt { ...st, live: idx_prepend_sym(st.live, s, s), want: [s, ...st.want] } }
  else { st }

fn dm_wants(dm: Demand, st: DmSt, ss: [SymId]) : DmSt = foldl(ss, st, (acc, s) => dm_want(dm, acc, s))

fn dm_full(dm: Demand, st: DmSt, p: SymId) : DmSt =
  if sym_raw(p) < 0 or list_has_sym(st.fulls, p) { st }
  else { dm_group(dm, DmSt { ...st, fulls: [p, ...st.fulls] }, p, (i) => true) }

fn dm_lite(dm: Demand, st: DmSt, p: SymId) : DmSt =
  if sym_raw(p) < 0 or list_has_sym(st.fulls, p) or list_has_sym(st.lites, p) { st }
  else { dm_group(dm, DmSt { ...st, lites: [p, ...st.lites] }, p, (i) => not cut_prim_impl(i)) }

# The impls of `p` among the candidates that `keep` takes, and its dispatchers.
fn dm_group(dm: Demand, st: DmSt, p: SymId, keep: (ProtoImplReg) -> Bool) : DmSt =
  dm_dispatchers(dm, dm_wants(dm, st, flat_map(dm.impls, (i) => match i {
    PIR(proto, _, _, f, _, _, _) -> if sym_same(proto, p) and keep(i) { [f] } else { [] }
  })), p)

fn dm_dispatchers(dm: Demand, st: DmSt, p: SymId) : DmSt =
  dm_wants(dm, st, flat_map(dm.ids.shared, (pd) => match pd {
    ProtoDisp(q, f) -> if sym_same(q, p) { [f] } else { [] }
  }))

fn list_has_sym(ss: [SymId], s: SymId) : Bool = any(ss, (t) => sym_same(t, s))

fn dm_binop(dm: Demand, st: DmSt, bp: BinopProto, l: Expr, r: Expr) : DmSt = match op_proto_core(bp) {
  None     -> st
  Some(cp) -> match bp {
    BpEq  -> dm_operands(dm, st, bp, cp, l)
    BpOrd -> dm_operands(dm, st, bp, cp, l)
    _     -> if dm_native(l, r) { st } else { dm_operator(dm, st, core_proto_id(cp), l) }
  }
}

fn dm_operands(dm: Demand, st: DmSt, bp: BinopProto, cp: CoreProto, l: Expr) : DmSt =
  if dm_runtime_native(bp, l.ty) { st }
  else if dm_ord_on_data(bp, l.ty) { dm_full(dm, st, core_proto_id(cp)) }
  else if dm_generic(l.ty) or not dm_is_eq(bp) { dm_operator(dm, st, core_proto_id(cp), l) }
  else { dm_group(dm, st, core_proto_id(cp), (i) => not dm_core_impl(dm.cores, i)) }

# On an operand whose type is not known the instantiation may be a primitive, whose impl a specialised call selects.
fn dm_operator(dm: Demand, st: DmSt, p: SymId, l: Expr) : DmSt =
  if dm_generic(l.ty) { dm_full(dm, st, p) } else { dm_lite(dm, st, p) }

fn dm_native(l: Expr, r: Expr) : Bool = {
  let k = dm_prim(l)
  k != 0 and k == dm_prim(r)
}

fn dm_prim(e: Expr) : Int = match e.ty {
  Some(TyInt)    -> 1
  Some(TyReal)   -> 2
  Some(TyInt32)  -> 3
  Some(TyUInt32) -> 4
  Some(TyUInt64) -> 5
  Some(TyInt128) -> 6
  _              -> 0
}

# A negated number literal is a primitive: nothing mints it to a type with an impl.
fn dm_negatable(x: Expr) : Bool = match x.kind {
  EInt(_, _)   -> true
  EReal(_, _)  -> true
  EFixed(_, _) -> true
  _            -> dm_native(x, x)
}

fn dm_generic(t: Option[Ty]) : Bool = match t {
  Some(TyVarT(_)) -> true
  Some(TyAny)     -> true
  None            -> true
  _               -> false
}

# An ordering over a data type calls its impl, whose body orders the members through the primitive impls.
fn dm_ord_on_data(bp: BinopProto, t: Option[Ty]) : Bool = match bp {
  BpOrd -> match t {
    Some(TyCon(_, _))  -> true
    Some(TyListT(_))   -> true
    _                  -> false
  }
  _ -> false
}

fn dm_is_eq(bp: BinopProto) : Bool = match bp {
  BpEq -> true
  _    -> false
}

# The runtime compares these without looking an impl up: `kai_op_eq` and `kai_op_lt`.
fn dm_runtime_native(bp: BinopProto, t: Option[Ty]) : Bool = match t {
  Some(TyDimT(inner, _))    -> dm_runtime_native(bp, Some(inner))
  Some(TyRefineT(inner, _)) -> dm_runtime_native(bp, Some(inner))
  Some(TyInt)    -> true
  Some(TyReal)   -> true
  Some(TyChar)   -> true
  Some(TyString) -> true
  Some(TyByte)   -> true
  Some(TyInt32)  -> true
  Some(TyUInt32) -> true
  Some(TyUInt64) -> true
  Some(TyInt128) -> true
  Some(TyBool)   -> dm_is_eq(bp)
  Some(TyUnit)   -> dm_is_eq(bp)
  _              -> false
}

pub(pkg) type PoolCut = { cut: CoreCut, live: NameIndex[SymId], held: NameIndex[SymId], gone: [Decl], stream: [Decl] }

#[doc("A program nothing is left to ask for.")]
pub(pkg) fn pool_none(decls: [Decl]) : PoolCut = PoolCut { cut: CoreCut(decls, [], []), live: idx_empty(), held: idx_empty(), gone: [], stream: decls }

#[doc("""
The candidates and the cut of a program under them: every declaration
that is not a core function, whose own references start the scan, and
the symbols of the functions left to ask for. An impl an imported
module defines may be selected by any value of its type, so a structural
comparison asks for it. A function the early cut emptied that is not a
candidate is returned too; the compile refuses it.
""")]
pub(pkg) fn core_pool(decls: [Decl], core_mods: [String], reg: ProtocolReg, emptied: [SymId], keep_unw: Bool) : PoolCut = {
  let held = foldl(emptied, idx_empty(), (acc, s) => idx_prepend_sym(acc, s, s))
  let is_pool = (d) => cut_is_core_fn(d, core_mods, keep_unw) or (dm_has(held, dm_sym_of(d)) and cut_is_core_fn(d, core_mods, false))
  let roots = filter(decls, (d) => not is_pool(d))
  let pool = filter(decls, is_pool)
  PoolCut { cut: CoreCut(roots, map(pool, dm_sym_of), filter(map(filter(roots, dm_is_fn), dm_sym_of), (s) => dm_has(held, s))),
            live: foldl(filter(pool, (d) => not dm_has(held, dm_sym_of(d))), idx_empty(), (acc, d) => idx_prepend_sym(acc, dm_sym_of(d), dm_sym_of(d))),
            held: held, gone: filter(pool, (d) => dm_has(held, dm_sym_of(d))),
            stream: decls }
}

fn dm_is_fn(d: Decl) : Bool = match d {
  DFn(_, _, _, _, _, _, _, _, _, _) -> true
  _ -> false
}

fn dm_core_impl(cores: [String], i: ProtoImplReg) : Bool = match i {
  PIR(_, _, _, _, _, _, Some(h)) -> list_has(cores, h)
  _ -> false
}

fn dm_typed(dm: Demand, typed: [Decl]) : NameIndex[SymId] =
  foldl(demand_syms(dm, typed), idx_empty(), (acc, s) => idx_prepend_sym(acc, s, s))

#[doc("`reg` without the impls of candidates that `typed` does not declare, the ones the program did not ask for; the `Int` and `Real` impls stay, which a bound may name and no call selects.")]
pub(pkg) fn demand_registry(reg: ProtocolReg, dm: Demand, typed: [Decl]) : ProtocolReg = {
  let asked = dm_typed(dm, typed)
  reg_with_impls(reg, filter(reg.impls, (p) => match p {
    PIR(_, _, _, f, _, _, _) -> not dm_has(dm.pool, f) or dm_has(asked, f) or cut_prim_impl(p)
  }))
}

#[doc("`dropped` without the functions `typed` declares: the ones the program asked for.")]
pub(pkg) fn demand_dropped(dropped: [SymId], dm: Demand, typed: [Decl]) : [SymId] = {
  let asked = dm_typed(dm, typed)
  filter(dropped, (s) => not dm_has(asked, s))
}

#[doc("A digest of the candidates' signatures: what a key over typed modules folds in, since their schemes are not among the entries the modules inherit.")]
pub(pkg) fn demand_digest(tab: SymTab, dm: Demand) : String =
  uc_content_hex(string_join(map(dm.decls, (d) => dm_signature(tab, d)), "\n"))

fn dm_signature(tab: SymTab, d: Decl) : String = match d {
  DFn(_, fid, tbs, ps, ret, row, _, _, _, _) ->
    concat_all([int_to_string(sym_raw(fnid_sym(fid))), "(", string_join(map(ps, (p) => dm_param(tab, p)), ","), "):",
                match ret { Some(t) -> type_key(tab, t)  None -> "" }, "/", row_key(tab, row), "[", string_join(map(tbs, dm_tparam), ","), "]"])
  _ -> ""
}

# A type parameter is its kind and bounds: its name is not part of the scheme.
fn dm_tparam(tb: TBinder) : String =
  concat_all([dm_kind(tb.kind), ":", string_join(map(tb.bounds, dm_bound), "+")])

fn dm_bound(r: DeclRef) : String = match r {
  DrSym(s)      -> int_to_string(sym_raw(s))
  DrWritten(_, _) -> "?"
}

fn dm_kind(k: Kind) : String = match k {
  KType         -> "t"
  KUnit(u)      -> cat2("u", u)
  KShape        -> "s"
  KRow          -> "r"
  KRowHole(a, b) -> concat_all(["h", int_to_string(a), ".", int_to_string(b)])
}

fn dm_param(tab: SymTab, p: Param) : String = match p.ptype {
  Some(t) -> type_key(tab, t)
  None    -> "_"
}

#[doc("The functions of the core and the libraries that keep their body.")]
pub(pkg) type PreCut = { tab: SymTab, live: NameIndex[SymId], keep_unw: Bool }

#[doc("Whether the core and the libraries are emptied.")]
pub(pkg) type EarlyCut = EcOn | EcOff

#[doc("The functions of `ds` that belong to one of the modules `mods`: the imported library functions the cut may empty.")]
pub(pkg) fn precut_lib_fns(ds: [Decl], mods: [String]) : [Decl] = filter(ds, (d) => pc_in_mods(d, mods))

#[doc("`ds` with the body of each function of `mods` the cut `pc` empties replaced by the unit value.")]
pub(pkg) fn precut_imported(pc: PreCut, mods: [String], ds: [Decl]) : [Decl] =
  map(ds, (d) => if not pc_in_mods(d, mods) or pc_live(pc.live, pc_fn_sym(d)) { d } else { pc_stub(d) })

#[doc("The cut of `core`: every function but the ones that keep their body. `tab` names the declarations; `keep_unw` keeps the functions that feed the unwind analysis.")]
pub(pkg) fn core_precut(core: [Decl], tab: SymTab, keep_unw: Bool) : PreCut = {
  let kept = filter(core, (d) => pc_is_fn(d) and (pc_extern_kai(d) or (keep_unw and unw_feeds_analysis(pc_bare(d)))))
  PreCut { tab: tab, live: foldl(kept, idx_empty(), (ix, d) => idx_prepend_sym(ix, pc_fn_sym(d), pc_fn_sym(d))), keep_unw: keep_unw }
}

#[doc("True when `d` is a function the cut `pc` empties or an `extern \"kai\"` one: a declaration only a program that names it needs.")]
pub(pkg) fn precut_droppable(pc: PreCut, d: Decl) : Bool = pc_is_fn(d) and (pc_extern_kai(d) or not pc_live(pc.live, pc_fn_sym(d)))

#[doc("The id of the function `d` declares, or none.")]
pub(pkg) fn precut_sym(d: Decl) : SymId = pc_fn_sym(d)

#[doc("The functions of `core` the cut `pc` empties.")]
pub(pkg) fn precut_emptied(pc: PreCut, core: [Decl]) : [SymId] =
  map(filter(core, (d) => pc_is_fn(d) and not pc_live(pc.live, pc_fn_sym(d))), pc_fn_sym)

#[doc("`core` with the body of each function the cut `pc` empties, and of each method of an impl but those that feed the unwind analysis, replaced by the unit value.")]
pub(pkg) fn precut_decls(pc: PreCut, core: [Decl]) : [Decl] =
  map(core, (d) => if pc_is_impl(d) { pc_stub_impl(pc, d) }
                   else if not pc_is_fn(d) or pc_live(pc.live, pc_fn_sym(d)) { d } else { pc_stub(d) })

fn pc_is_impl(d: Decl) : Bool = match pc_bare(d) {
  DImpl(_, _, _, _, _, _, _, _) -> true
  _ -> false
}

fn pc_stub_impl(pc: PreCut, d: Decl) : Decl = match d {
  DDoc(a, b, inner, l, c) -> DDoc(a, b, pc_stub_impl(pc, inner), l, c)
  DAttr(a, inner, l, c)   -> DAttr(a, pc_stub_impl(pc, inner), l, c)
  DImpl(a, b, c, ms, l, co, tbs, id) ->
    DImpl(a, b, c, map(ms, (m) => if pc.keep_unw and unw_feeds_analysis(pc_bare(m)) { m } else { pc_stub(m) }), l, co, tbs, id)
  _ -> d
}

#[doc("`d` with its body replaced by the unit value.")]
pub(pkg) fn pc_stub(d: Decl) : Decl = match d {
  DDoc(a, b, inner, l, c) -> DDoc(a, b, pc_stub(inner), l, c)
  DAttr(a, inner, l, c)   -> DAttr(a, pc_stub(inner), l, c)
  DFn(p, id, tbs, ps, ret, row, body, l, c, m) ->
    DFn(p, id, tbs, ps, ret, row, mk_expr(EUnit, body.line, body.col), l, c, m)
  _ -> d
}

fn pc_extern_kai(d: Decl) : Bool = match pc_bare(d) {
  DFn(_, _, _, _, _, _, body, _, _, _) -> match body.kind {
    EExternBody(AbiKai, _) -> true
    _ -> false
  }
  _ -> false
}

fn pc_is_fn(d: Decl) : Bool = match pc_bare(d) {
  DFn(_, _, _, _, _, _, _, _, _, _) -> true
  _ -> false
}

fn pc_in_mods(d: Decl, mods: [String]) : Bool = match pc_bare(d) {
  DFn(_, _, _, _, _, _, _, _, _, Some(m)) -> list_has(mods, m)
  _ -> false
}

fn pc_fn_sym(d: Decl) : SymId = match pc_bare(d) {
  DFn(_, id, _, _, _, _, _, _, _, _) -> fnid_sym(id)
  _ -> sym_none()
}

fn pc_bare(d: Decl) : Decl = match d {
  DDoc(_, _, inner, _, _) -> pc_bare(inner)
  DAttr(_, inner, _, _)   -> pc_bare(inner)
  _ -> d
}

fn pc_live(live: NameIndex[SymId], s: SymId) : Bool = match idx_chain_sym(live, s) {
  [] -> false
  _  -> true
}

type TcEnt = TcFn(Decl) | TcDisp(SymId) | TcGone

type TcSt = { ix: NameIndex[TcEnt], all: [Decl], live: NameIndex[SymId], impls: [ProtoImplReg],
              full: [SymId], lite: [SymId], work: [Decl], misses: [SymId] }

#[doc("A pruned program and the dropped core functions it still references: each a reachability rule the earlier cut is missing.")]
pub(pkg) type TypedCut = TypedCut([Decl], [SymId])

#[doc("`decls` without the core functions nothing in it can reach, and the functions of `dropped`, which an earlier cut removed, that it still references. `core_mods` are the core modules; `reg` the protocol registry.")]
pub(pkg) fn core_typed_cut(decls: [Decl], core_mods: [String], reg: ProtocolReg, dropped: [SymId]) : TypedCut / Console = {
  let mods = tc_mods(core_mods, idx_empty())
  let core = filter(decls, (d) => tc_core_fn(d, mods))
  let ix0 = tc_gone(dropped, disp_protos_fold(reg.ids, tc_fns(core, idx_empty()), (ix, s, p) => idx_prepend_sym(ix, s, TcDisp(p))))
  let st0 = TcSt { ix: ix0, all: decls, live: idx_empty(), impls: reg.impls,
                   full: [], lite: [], work: [], misses: [] }
  let st = tc_drain(tc_decls(filter(decls, (d) => not tc_is_core(ix0, d)), st0))
  TypedCut(filter(decls, (d) => not tc_is_core(ix0, d) or tc_in(st.live, tc_sym(d))), st.misses)
}

fn tc_mods(ms: [String], ix: NameIndex[Bool]) : NameIndex[Bool] = match ms {
  [] -> ix
  [m, ...rest] -> tc_mods(rest, idx_prepend(ix, m, true))
}

fn tc_core_fn(d: Decl, mods: NameIndex[Bool]) : Bool = match d {
  DFn(_, _, _, _, _, _, _, _, _, Some(m)) -> match idx_chain(mods, m) {
    [] -> false
    _  -> true
  }
  _ -> false
}

fn tc_sym(d: Decl) : SymId = match d {
  DFn(_, fid, _, _, _, _, _, _, _, _) -> fnid_sym(fid)
  _ -> sym_none()
}

fn tc_fns(ds: [Decl], ix: NameIndex[TcEnt]) : NameIndex[TcEnt] = match ds {
  [] -> ix
  [d, ...rest] -> tc_fns(rest, idx_prepend_sym(ix, tc_sym(d), TcFn(d)))
}

fn tc_gone(ss: [SymId], ix: NameIndex[TcEnt]) : NameIndex[TcEnt] = match ss {
  [] -> ix
  [s, ...rest] -> tc_gone(rest, idx_prepend_sym(ix, s, TcGone))
}

# The core functions are exactly the declarations the index holds a function entry for.
fn tc_is_core(ix: NameIndex[TcEnt], d: Decl) : Bool = match d {
  DFn(_, _, _, _, _, _, _, _, _, _) -> tc_has_fn(idx_chain_sym(ix, tc_sym(d)))
  _ -> false
}

fn tc_has_fn(es: [TcEnt]) : Bool = match es {
  [] -> false
  [TcFn(_), ..._] -> true
  [_, ...rest] -> tc_has_fn(rest)
}

fn tc_declares(ds: [Decl], s: SymId) : Bool = match ds {
  [] -> false
  [d, ...rest] -> (tc_is_fn_decl(d) and sym_same(tc_sym(d), s)) or tc_declares(rest, s)
}

fn tc_is_fn_decl(d: Decl) : Bool = match d {
  DFn(_, _, _, _, _, _, _, _, _, _) -> true
  _ -> false
}

fn tc_in(ix: NameIndex[SymId], s: SymId) : Bool = match idx_chain_sym(ix, s) {
  [] -> false
  _  -> true
}

fn tc_has(ss: [SymId], s: SymId) : Bool = match ss {
  [] -> false
  [h, ...rest] -> sym_same(h, s) or tc_has(rest, s)
}

fn tc_drain(st: TcSt) : TcSt / Console = match st.work {
  [] -> st
  [d, ...rest] -> tc_drain(tc_decl(d, TcSt { ...st, work: rest }))
}

fn tc_decls(ds: [Decl], st: TcSt) : TcSt / Console = match ds {
  [] -> st
  [d, ...rest] -> tc_decls(rest, tc_decl(d, st))
}

fn tc_decl(d: Decl, st: TcSt) : TcSt / Console = tc_exprs(cut_decl_exprs(d), st)

fn tc_exprs(es: [Expr], st: TcSt) : TcSt / Console = match es {
  [] -> st
  [e, ...rest] -> tc_exprs(rest, tc_expr(e, st))
}

fn tc_expr(e: Expr, st: TcSt) : TcSt / Console = match e.kind {
  ESym(s, _)       -> tc_ref(st, s)
  ECall(f, xs)     -> tc_exprs(xs, tc_expr(f, st))
  EBinop(op, l, r) -> tc_expr(r, tc_expr(l, tc_binop(st, op, l, r)))
  EUnop(UoNeg, x)  -> tc_expr(x, if tc_native(x, x) { st } else { tc_lite(st, core_proto_id(CpNeg)) })
  EUnop(_, x)      -> tc_expr(x, st)
  EField(b, _)     -> tc_expr(b, st)
  EIf(c, a, oe)    -> tc_opt(oe, tc_expr(a, tc_expr(c, st)))
  _                -> tc_positions(xp_positions(e), st)
}

fn tc_opt(o: Option[Expr], st: TcSt) : TcSt / Console = match o {
  Some(x) -> tc_expr(x, st)
  None    -> st
}

fn tc_positions(ps: [XPos], st: TcSt) : TcSt / Console = match ps {
  [] -> st
  [XP(_, x), ...rest] -> tc_positions(rest, tc_expr(x, st))
}

# Two operands of one primitive type are compared and combined natively.
fn tc_binop(st: TcSt, op: BinOp, l: Expr, r: Expr) : TcSt = match op_proto_core(binop_proto(op)) {
  Some(cp) -> if tc_native(l, r) { st } else { tc_lite(st, core_proto_id(cp)) }
  None     -> st
}

fn tc_native(l: Expr, r: Expr) : Bool = {
  let k = tc_prim(l)
  k != 0 and k == tc_prim(r)
}

fn tc_prim(e: Expr) : Int = match e.ty {
  Some(TyInt)  -> 1
  Some(TyReal) -> 2
  _            -> 0
}

fn tc_ref(st: TcSt, s: SymId) : TcSt = match idx_chain_sym(st.ix, s) {
  [] -> st
  es -> if tc_in(st.live, s) { st }
        else { tc_ents(TcSt { ...st, live: idx_prepend_sym(st.live, s, s) }, s, es) }
}

fn tc_ents(st: TcSt, s: SymId, es: [TcEnt]) : TcSt = match es {
  [] -> st
  [e, ...rest] -> tc_ents(tc_ent(st, s, e), s, rest)
}

fn tc_ent(st: TcSt, s: SymId, e: TcEnt) : TcSt = match e {
  TcFn(d)   -> TcSt { ...st, work: [d, ...st.work] }
  TcDisp(p) -> tc_full(st, p)
  TcGone    -> if tc_declares(st.all, s) { st } else { TcSt { ...st, misses: [s, ...st.misses] } }
}

# A dispatcher picks any impl of its protocol by the runtime head of its first argument.
fn tc_full(st: TcSt, p: SymId) : TcSt =
  if sym_raw(p) < 0 or tc_has(st.full, p) { st }
  else { tc_impls(TcSt { ...st, full: [p, ...st.full] }, p, (i) => true) }

# An operator on a compound operand walks it at run time and reaches the impl of each member by its head.
fn tc_lite(st: TcSt, p: SymId) : TcSt =
  if sym_raw(p) < 0 or tc_has(st.full, p) or tc_has(st.lite, p) { st }
  else { tc_impls(TcSt { ...st, lite: [p, ...st.lite] }, p, (i) => not cut_prim_impl(i)) }

# An impl selected at run time is kept when the program still holds it; one an earlier cut dropped is not a reference to it.
fn tc_impl_ref(st: TcSt, f: SymId) : TcSt =
  if tc_has_fn(idx_chain_sym(st.ix, f)) { tc_ref(st, f) } else { st }

fn tc_impls(st: TcSt, p: SymId, keep: (ProtoImplReg) -> Bool) : TcSt =
  tc_impl_refs(st, p, keep, st.impls)

fn tc_impl_refs(st: TcSt, p: SymId, keep: (ProtoImplReg) -> Bool, is: [ProtoImplReg]) : TcSt = match is {
  [] -> st
  [i, ...rest] -> match i {
    PIR(proto, _, _, f, _, _, _) ->
      tc_impl_refs(if sym_same(proto, p) and keep(i) { tc_impl_ref(st, f) } else { st }, p, keep, rest)
  }
}

#[doc("The part of a program that shapes core TUs: a digest of it, and the same as an analysis seed.")]
pub(pkg) type CoreVariant = { digest: String, seed: UnwSeed }

#[doc("The variant of the resolved program `decls`, core included: whether a row may cancel and which core effects the handlers anywhere in it make unwind. `core_mods` are the core modules.")]
pub(pkg) fn core_variant(decls: [Decl], tab: SymTab, core_mods: [String]) : CoreVariant =
  match unw_effects_of(decls, decls) {
    UnwEffects(all, unw) -> {
      let effects = cv_effects(decls, unw, core_mods, [])
      CoreVariant { digest: uc_content_hex(concat_all([
                      if all { "all" } else { "some" }, "\n",
                      string_join(cv_sort(map(effects, (s) => export_name(tab, s)), []), "\n")])),
                    seed: UnwSeed { all: all, effects: effects } }
    }
  }

#[doc("The variant that is none: no program.")]
pub(pkg) fn core_variant_none() : CoreVariant = CoreVariant { digest: "", seed: unw_seed_none() }

fn cv_has(mods: [String], mo: Option[String]) : Bool = match mo {
  Some(m) -> list_has(mods, m)
  None    -> false
}

fn cv_effects(decls: [Decl], unw: [Int], core_mods: [String], acc: [SymId]) : [SymId] = match decls {
  [] -> acc
  [d, ...rest] -> match d {
    DEffect(_, s, _, _, _, _, _, mo) ->
      cv_effects(rest, unw, core_mods, if cv_has(core_mods, mo) and unw_has_id(unw, s) { [s, ...acc] } else { acc })
    _ -> cv_effects(rest, unw, core_mods, acc)
  }
}

fn cv_sort(xs: [String], sorted: [String]) : [String] = match xs {
  [] -> sorted
  [h, ...rest] -> cv_sort(rest, cv_insert(h, sorted))
}

fn cv_insert(x: String, sorted: [String]) : [String] = match sorted {
  [] -> [x]
  [h, ...rest] -> if string_lt(x, h) { [x, h, ...rest] } else { [h, ...cv_insert(x, rest)] }
}
