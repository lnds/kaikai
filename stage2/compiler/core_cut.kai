# compiler/core_cut.kai -- what a build keeps of the core: the cut's result
# and the predicates that tell core functions and primitive impls apart.

import compiler.util
import compiler.ast
import compiler.decl_bodies
import compiler.written
import compiler.symtab
import compiler.impl_identity
import compiler.unwind_effects

#[doc("A pruned program: the decls a build keeps, the core functions it dropped, and the functions an earlier cut emptied that it keeps.")]
pub type CoreCut = CoreCut([Decl], [SymId], [SymId])

#[doc("The declared names of `ss`, for the note a cut prints.")]
pub fn core_cut_names(tab: SymTab, ss: [SymId]) : [String] = map(ss, (s) => written_text(sym_name(tab, s)))

#[doc("True when `d` is a function of one of the modules `core_mods`, other than one that feeds the unwind analysis when `keep_unw` asks to keep those.")]
pub fn cut_is_core_fn(d: Decl, core_mods: [String], keep_unw: Bool) : Bool = match d {
  DFn(_, _, _, _, _, _, _, _, _, mo) -> match mo {
    Some(m) -> list_has(core_mods, m) and not (keep_unw and unw_feeds_analysis(d))
    None    -> false
  }
  _ -> false
}

#[doc("True when the impl is for `Int` alone or `Real` alone, which a primitive operand never selects.")]
pub fn cut_prim_impl(i: ProtoImplReg) : Bool = match i {
  PIR(_, t, _, _, args, _, _) -> cut_prim_homogeneous(t, args, DhScalar(TyInt)) or cut_prim_homogeneous(t, args, DhScalar(TyReal))
}

fn cut_prim_homogeneous(t: DeclRef, args: [DeclRef], h: DispHead) : Bool =
  dh_ref_is(t, h) and match args {
    []  -> true
    [a] -> dh_ref_is(a, h)
    _   -> false
  }


#[doc("The expressions a decl evaluates: bodies, constant initialisers and the clauses of an effect's default handler.")]
pub fn cut_decl_exprs(d: Decl) : [Expr] = match decl_transparent_inner(d) {
  Some(inner) -> cut_decl_exprs(inner)
  None -> match d {
    DEffect(_, _, _, _, Some(DBlk(cs, ret, _, _)), _, _, _) -> list_append(map(cs, cut_clause_body), cut_ret_body(ret))
    _ -> decl_bodies(d)
  }
}

fn cut_clause_body(c: HClause) : Expr = match c { HC(_, _, b, _, _) -> b }

fn cut_ret_body(o: Option[HReturn]) : [Expr] = match o {
  Some(HR(_, b, _, _)) -> [b]
  None -> []
}
