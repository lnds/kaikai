fn check_default_coverage(df: DiagFiles, tab: SymTab, mod_decls: [Decl], all_decls: [Decl],
                          effs: [EffDefaultOps], homes: TyHomes) : [Diagnostic] / Console + File {
  let cx = CovCx { tab: tab, effs: effs }
  list_reverse(check_default_coverage_loop(df, all_decls, cx, homes, mod_decls, []))
}


type CovWalk = { file: String, decls: [Decl], cx: CovCx, entry: Bool }

fn check_default_coverage_loop(df: DiagFiles, all_decls: [Decl],
                               cx: CovCx, homes: TyHomes, ds: [Decl],
                               acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match ds {
    [] -> acc
    [d, ...rest] -> match d {
      DFn(_, fid, _, _, _, _, body, _, _, _) -> {
        let w = CovWalk { file: decl_diag_file(d, df), decls: all_decls, cx: cx,
                          entry: decl_types_as_entry(homes, fid) }
        check_default_coverage_loop(df, all_decls, cx, homes, rest, cov_expr(w, body, [], acc))
      }
      _ -> check_default_coverage_loop(df, all_decls, cx, homes, rest, acc)
    }
  }
}

fn cov_expr(w: CovWalk, e: Expr, stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File =
  match e.kind {
    EInt(_, _) -> acc
    EReal(_, _) -> acc
    EIntLit(_) -> acc
    EDecimalLit(_) -> acc
    EFixed(_, _) -> acc
    EBool(_) -> acc
    EChar(_) -> acc
    EStr(_, _) -> acc
    EUnit -> acc
    EName(_) -> acc
    EMark(_) -> acc
    ESym(_, _) -> acc
    ELocal(_) -> acc
    EOp(_) -> acc
    EUnder -> acc
    EPlaceholder -> acc
    EHole(_) -> acc
    ETodo(_) -> acc
    EExternBody(_, _) -> acc
    EVariantsOf(_, _) -> acc
    EModCall(_, _) -> acc
    ELambda(_, _) -> acc
    EIntrinsic(_, args_) -> cov_exprs(w, args_, stack, acc)
    ESurface(sf) -> cov_exprs(w, surface_children(sf), stack, acc)
    ECall(callee, args_) -> {
      let head_errs = match callee.kind {
        EOp(r) -> check_op_call_coverage(w, r, stack, e.line, e.col)
        _ -> []
      }
      cov_exprs(w, args_, stack, cov_expr(w, callee, stack, list_append(head_errs, acc)))
    }
    EField(base, _) -> cov_expr(w, base, stack, acc)
    EIndex(a, b) -> cov_pair(w, a, b, stack, acc)
    EBinop(_, a, b) -> cov_pair(w, a, b, stack, acc)
    EUnop(_, x) -> cov_expr(w, x, stack, acc)
    EIf(c, t, eo) -> cov_opt(w, eo, stack, cov_pair(w, c, t, stack, acc))
    EMatch(scr, arms) -> cov_arms(w, arms, stack, cov_expr(w, scr, stack, acc))
    ERecordLit(_, fs) -> cov_fields(w, fs, stack, acc)
    EList(els) -> cov_elems(w, els, stack, acc)
    ERange(a, b, opt) -> cov_opt(w, opt, stack, cov_pair(w, a, b, stack, acc))
    EBlock(stmts, tail) -> cov_opt(w, tail, stack, cov_stmts(w, stmts, stack, acc))
    EPipe(a, b) -> cov_pair(w, a, b, stack, acc)
    EDispatchPipe(_, a, b) -> cov_pair(w, a, b, stack, acc)
    EBang(inner) -> cov_expr(w, inner, stack, acc)
    ELitUnit(inner, _) -> cov_expr(w, inner, stack, acc)
    EHandle(body, eff, _, init_opt, _, clauses, ret_opt) ->
      cov_handle(w, e, body, eff, init_opt, clauses, ret_opt, stack, acc)
  }

fn cov_exprs(w: CovWalk, es: [Expr], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File =
  match es {
    [] -> acc
    [x, ...rest] -> cov_exprs(w, rest, stack, cov_expr(w, x, stack, acc))
  }

fn cov_arms(w: CovWalk, arms: [Arm], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File =
  match arms {
    [] -> acc
    [Arm(_, og, body), ...rest] -> cov_arms(w, rest, stack, cov_expr(w, body, stack, cov_opt(w, og, stack, acc)))
  }

fn cov_fields(w: CovWalk, fs: [FieldInit], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File =
  match fs {
    [] -> acc
    [FI(_, x), ...rest] -> cov_fields(w, rest, stack, cov_expr(w, x, stack, acc))
  }

fn cov_elems(w: CovWalk, els: [ListElem], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File =
  match els {
    [] -> acc
    [ElPlain(x), ...rest] -> cov_elems(w, rest, stack, cov_expr(w, x, stack, acc))
    [ElSpread(x), ...rest] -> cov_elems(w, rest, stack, cov_expr(w, x, stack, acc))
  }

fn cov_stmts(w: CovWalk, ss: [Stmt], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File =
  match ss {
    [] -> acc
    [s, ...rest] -> cov_stmts(w, rest, stack, cov_stmt(w, s, stack, acc))
  }

fn cov_clauses(w: CovWalk, cs: [HClause], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File =
  match cs {
    [] -> acc
    [HC(_, _, b, _, _), ...rest] -> cov_clauses(w, rest, stack, cov_expr(w, b, stack, acc))
  }

fn cov_pair(w: CovWalk, a: Expr, b: Expr, stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File =
  cov_expr(w, b, stack, cov_expr(w, a, stack, acc))

fn cov_opt(w: CovWalk, o: Option[Expr], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File =
  match o {
    Some(x) -> cov_expr(w, x, stack, acc)
    None -> acc
  }

fn cov_stmt(w: CovWalk, s: Stmt, stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File =
  match s {
    SLet(_, _, e) -> cov_expr(w, e, stack, acc)
    SVar(_, _, e, _, _) -> cov_expr(w, e, stack, acc)
    SAssert(e, og) -> cov_opt(w, og, stack, cov_expr(w, e, stack, acc))
    SExprStmt(e) -> cov_expr(w, e, stack, acc)
    SIndexAssign(a, b, c, _, _) -> cov_expr(w, c, stack, cov_pair(w, a, b, stack, acc))
    SAssign(a, c, _, _) -> cov_pair(w, a, c, stack, acc)
    SUse(_, _, _) -> acc
  }

# Clause bodies run outside `with eff`: they are walked under the outer stack,
# so an `Eff.op` call in a clause of `Eff` is not taken as discharged by it.
fn cov_handle(w: CovWalk, e: Expr, body: Expr, eff: DeclRef, init_opt: Option[Expr],
              clauses: [HClause], ret_opt: Option[HReturn],
              stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File {
  let hsym = ref_sym(eff)
  let clause_ops = handle_clause_op_names(clauses)
  let default_ops = effect_default_op_map_get(w.cx.effs, hsym)
  let frame = HF(hsym, clause_ops, default_ops, e.line, e.col)
  let missing = handler_missing_ops(effect_decl_of(hsym, w.decls), clause_ops, default_ops)
  let a0 = list_append(report_partial_handler(w.file, ref_text(w.cx.tab, eff), missing, e.line, e.col), acc)
  let a1 = cov_opt(w, init_opt, stack, a0)
  let a2 = cov_clauses(w, clauses, stack, a1)
  let a3 = match ret_opt {
    Some(HR(_, b, _, _)) -> cov_expr(w, b, stack, a2)
    None -> a2
  }
  cov_expr(w, body, [frame, ...stack], a3)
}

# An op call is discharged by the nearest enclosing handle of its effect when
# that handle has a clause for it: an inner handle's evidence masks the
# effect's `default` block, so the block does not cover it. Outside any
# handle only `main` can discharge it, through the default block.
fn check_op_call_coverage(w: CovWalk, r: OpRef, stack: [HandleFrame],
                          line: Int, col: Int) : [Diagnostic] / Console + File {
  let esym = r.eff
  let op_name = written_text(r.op)
  if not is_effect_declared(esym, w.decls) { [] }
  else {
    match find_top_eff_frame(stack, esym) {
      Some(HF(_, clause_ops, _, _, _)) ->
        uncovered_op_unless(list_has_string(clause_ops, op_name), w, op_name, esym, line, col, false)
      None ->
        if w.entry {
          uncovered_op_unless(list_has_string(effect_default_op_map_get(w.cx.effs, esym), op_name),
                              w, op_name, esym, line, col, true)
        } else { [] }
    }
  }
}

fn uncovered_op_unless(covered: Bool, w: CovWalk, op_name: String, esym: SymId,
                       line: Int, col: Int, at_main: Bool) : [Diagnostic] / Console + File =
  if covered { [] }
  else { [report_uncovered_op(w.file, w.cx.tab, op_name, esym, w.decls, line, col, at_main)] }


























fn report_uncovered_op(file: String, tab: SymTab,
                        op_name: String, esym: SymId, decls: [Decl],
                        line: Int, col: Int, at_main: Bool) : Diagnostic / Console + File {
  # What the reader is told to write is the name their source spells.
  let eff_name = inf_tycon_display_ow(tab, spelled_head_owners(decls, tab, []), esym)
  let qualified = concat_all([eff_name, ".", op_name])
  let header = concat_all(["effect not handled: ", qualified])
  let default_status = describe_default_status(eff_name, op_name, effect_decl_default(effect_decl_of(esym, decls)))
  let help = if at_main {
    concat_all(["wrap the call in `handle { ... } with ",
                eff_name, " { ", op_name,
                "(args, resume) -> ... }`, or add `",
                op_name, "(args, resume) -> ...` to `effect ",
                eff_name, "`'s `default { }` block"])
  } else {
    concat_all(["add a `", op_name,
                "(args, resume) -> ...` clause to the enclosing `handle ... with ",
                eff_name, "`, or add `", op_name,
                "(args, resume) -> ...` to `effect ", eff_name,
                "`'s `default { }` block"])
  }
  let d = mk_diag(SevError, file, line, col, header, [ri_note(file, line, col, default_status), ri_help(file, line, col, help)])
  d
}


fn describe_default_status(eff_name: String, op_name: String,
                           dblk: Option[DefaultBlock]) : String =
  match dblk {
    None ->
      concat_all(["effect `", eff_name,
                  "` declares no `default { }` block, so no fallback handler exists"])
    Some(DBlk(clauses, _, _, _)) -> default_clause_status(eff_name, op_name, clauses)
  }

fn default_clause_status(eff_name: String, op_name: String, clauses: [HClause]) : String =
  if list_has_string(extern_handler_op_names(clauses), op_name) {
    concat_all(["effect `", eff_name,
                "`'s `default { }` block does declare `", op_name,
                "` via `$extern_handler`, but the enclosing `handle ... with ",
                eff_name, "` masks the main-level default — Stage C will let the handle inherit unmissed default clauses; until then the partial handle must add `",
                op_name, "`"])
  } else if list_has_string(handle_clause_op_names(clauses), op_name) {
    concat_all(["effect `", eff_name,
                "`'s `default { }` block declares `", op_name,
                "` but its body is not an `$extern_handler(...)` bridge — Stage C will lower kaikai-bodied default clauses; for now the clause must use the intrinsic"])
  } else {
    concat_all(["effect `", eff_name,
                "`'s `default { }` block does not declare `",
                op_name, "`"])
  }


#[doc("infer: run HM + bidirectional inference over a program, returning the TypedProgram.")]
pub fn infer_program(file: String, decls: [Decl], tin: TyperIn, verbose: Bool) : TypedProgram / Console + File + Mutable = {
  let tp = infer_program_collect(file, decls, tin, verbose)
  each(tp.diags, render_diag)
  tp
}

#[doc("infer: `infer_program` without rendering: the diagnostics stay in the result for the caller to render once.")]
pub fn infer_program_collect(file: String, decls: [Decl], tin: TyperIn, verbose: Bool) : TypedProgram / Console + File + Mutable =
  infer_program_with_protos_cached(file, tin.df, decls, verbose, tin.protos, tin.head_owners,
                                   tin.kind_theories, tin.tab, tin.views, tin.roots)


#[doc("infer: what a module's declarations alone give the typer: its program data over the inherited env, the sums, records and hold marks it adds, and the `ModuleEnvDelta` it contributes. No body is read.")]
pub type ModuleFront = { data: ProgramData, sums_here: [SumInfo], recs_here: [RecInfo], holds: [HoldAt], delta: ModuleEnvDelta }

fn pool_env(env: TyEnv, sh: TcShared) : TyEnv = {
  let pool = sh.pool
  let rk = sh.rk_table
  let homes = sh.homes
  TyEnv { ...env, late: (s) => match idx_chain_sym(pool, s) {
    [d, ..._] -> fn_scheme_of_decl(d, rk, homes)
    []        -> None
  } }
}

#[doc("infer: the declaration half of `typecheck_module`.")]
pub fn module_front(file: String, mod: ModuleDecls, inherited: ModuleEnvDelta, head_owners: [HeadOwnerEntry],
                    tab: SymTab, sh: TcShared) : ModuleFront / Console + File + Mutable = {
  let data0 = collect_program_data_inherited(file, mod.decls, inherited, sh, tab)
  let env_with_owners = ty_env_with_head_owners(data0.built.env, head_owners)
  let built1 = BuiltEnv { env: pool_env(ty_env_with_carriers(env_with_owners, sh.carriers), sh),
                          core_len: data0.built.core_len,
                          op_eff_arities: data0.built.op_eff_arities,
                          new_arities: data0.built.new_arities }
  let data = ProgramData { decls_a: data0.decls_a, built: built1,
                            recs: data0.recs, alias_res: data0.alias_res,
                            op_to_eff: data0.op_to_eff, sums: data0.sums,
                            homes: data0.homes }
  let sums_here = collect_sums(data.decls_a)
  let recs_here = typer_records(data.decls_a, tab)
  let holds = hold_extend(data.built.env, sums_here, recs_here, sh.holds)
  let new_entries = take_entries(data.built.env.entries, data.built.env.added, [])
  let delta = ModuleEnvDelta {
    name:           mod.name,
    ty_entries:     new_entries,
    unions:         collect_unions(data.decls_a, tab, tsh_view(data.homes, None)),
    op_eff_arities: data.built.new_arities,
    recs:           recs_here,
    sums:           sums_here,
    op_to_eff:      inf_collect_op_to_eff(data.decls_a),
    unit_aliases:   collect_unit_alias_table(mod.decls),
    constructors:   collect_constructors(data.decls_a, sh.homes, [])
  }
  ModuleFront { data: data, sums_here: sums_here, recs_here: recs_here, holds: holds, delta: delta }
}

#[doc("infer: typecheck one module against an inherited `ModuleEnvDelta`, returning its typed program plus the delta it contributes. `df` attributes each diagnostic to the file declaring the decl it fires on; `file` stays the root and keeps naming the target module.")]
pub fn typecheck_module(file: String, df: DiagFiles, mod: ModuleDecls,
                     inherited: ModuleEnvDelta,
                     all_program_decls: [Decl],
                     protos: ProtoView,
                     head_owners: [HeadOwnerEntry],
                     kind_theories: [KindTheory],
                     tab: SymTab, sh: TcShared,
                     verbose: Bool) : TypecheckedModule / Console + File + Mutable = {
  let fr = module_front(file, mod, inherited, head_owners, tab, sh)
  module_bodies(file, df, mod, fr, all_program_decls, protos, kind_theories, tab, sh, verbose)
}

#[doc("infer: typecheck the modules of one import cycle, in order. Every member's declarations are in the environment before any body is typed, so a body resolves against all of them.")]
pub fn typecheck_unit(file: String, df: DiagFiles, ms: [ModuleDecls], inherited: ModuleEnvDelta,
                      all_program_decls: [Decl], protos: ProtoView, head_owners: [HeadOwnerEntry],
                      kind_theories: [KindTheory], tab: SymTab, sh: TcShared,
                      verbose: Bool) : [TypecheckedModule] / Console + File + Mutable = {
  let deltas = unit_deltas(file, ms, inherited, head_owners, tab, sh, [])
  unit_members(file, df, ms, deltas, [], [], inherited, all_program_decls, protos, head_owners,
               kind_theories, tab, sh, verbose)
}

fn unit_deltas(file: String, ms: [ModuleDecls], inh: ModuleEnvDelta, head_owners: [HeadOwnerEntry],
               tab: SymTab, sh: TcShared, acc: [ModuleEnvDelta]) : [ModuleEnvDelta] / Console + File + Mutable = match ms {
  [] -> list_reverse(acc)
  [m, ...rest] -> {
    let fr = module_front(file, m, inh, head_owners, tab, sh)
    unit_deltas(file, rest, merge_env_deltas(inh, fr.delta), head_owners, tab, tc_shared_extend(sh, fr.delta), [fr.delta, ...acc])
  }
}

fn unit_members(file: String, df: DiagFiles, ms: [ModuleDecls], after: [ModuleEnvDelta], before: [ModuleEnvDelta],
                done: [TypecheckedModule], inherited: ModuleEnvDelta, all_program_decls: [Decl], protos: ProtoView,
                head_owners: [HeadOwnerEntry], kind_theories: [KindTheory], tab: SymTab, sh: TcShared,
                verbose: Bool) : [TypecheckedModule] / Console + File + Mutable = match ms {
  [] -> list_reverse(done)
  [m, ...rest] -> match after {
    [own, ...later] -> {
      let others = list_append(list_reverse(before), later)
      let inh = foldl(others, inherited, (a, d) => merge_env_deltas(a, d))
      let shm = foldl(others, sh, (s, d) => tc_shared_extend(s, d))
      let fr = module_front(file, m, inh, head_owners, tab, shm)
      let tm = module_bodies(file, df, m, fr, all_program_decls, protos, kind_theories, tab, shm, verbose)
      unit_members(file, df, rest, later, [own, ...before], [tm, ...done], inherited, all_program_decls, protos,
                   head_owners, kind_theories, tab, sh, verbose)
    }
    [] -> list_reverse(done)
  }
}

#[doc("infer: the body half of `typecheck_module`, over the front the module's declarations gave.")]
pub fn module_bodies(file: String, df: DiagFiles, mod: ModuleDecls, fr: ModuleFront,
                     all_program_decls: [Decl],
                     protos: ProtoView,
                     kind_theories: [KindTheory],
                     tab: SymTab, sh: TcShared,
                     verbose: Bool) : TypecheckedModule / Console + File + Mutable = {
  let data = fr.data
  let n_inh = match sh.inh {
    TEP(_, _, _, n) -> n
  }
  # `infer_all_loop` and the coverage checks look up `DEffect default`
  # blocks from any module, so they see the whole program's decls.
  let all_decls_for_typer = if not list_is_empty(all_program_decls) {
    all_program_decls
  } else { data.decls_a }
  let tp = infer_all_loop(df, data.built.env, data.built.core_len, data.recs,
                 data.built.op_eff_arities, data.decls_a, verbose, [], 0, [], [], [], [], [],
                 data.alias_res.aliases, data.op_to_eff, data.sums,
                 handle_tab_of(fr.holds), protos,
                 all_decls_for_typer, kind_theories)
  let cov_diags = check_default_coverage(df, tab, tp.decls, all_decls_for_typer,
    if not list_is_empty(all_program_decls) { sh.effs } else { build_effect_default_op_map(all_decls_for_typer) }, sh.homes)
  let priv_diags = check_field_privacy(df, tab, tsh_view(sh.homes, mod.name), tp.decls,
    if not list_is_empty(all_program_decls) { sh.field_recs } else { field_recs_of(data.decls_a) })
  let spawn_diags = check_spawn_rows(df, tab, sh.cell_carriers, tp.decls, all_decls_for_typer)
  let typed = TypedProgram {
    decls: tp.decls, errs: tp.errs + list_length(cov_diags) + list_length(priv_diags) + list_length(spawn_diags),
    insts: tp.insts, holes: tp.holes, row_holes: tp.row_holes,
    core_len: tp.core_len, toplevel_len: n_inh + data.built.env.added,
    module_doc: doc_module_doc_text(data.decls_a),
    diags: list_append(tp.diags, list_append(cov_diags, list_append(priv_diags, spawn_diags))), op_res: tp.op_res
  }
  TypecheckedModule { typed: typed, delta: fr.delta }
}


# Fold `typecheck_module` left-to-right across the per-module decl
# streams, threading the accumulating `ModuleEnvDelta` as `inherited`
# for each segment.
# variant accepting the per-compile head-owner cache. The
# cache is built once by `compile_source` after `expand_imports`
# completes.
fn typecheck_program_with_head_owners(file: String, df: DiagFiles, modules: [ModuleDecls],
                                       protos: ProtoView,
                                       head_owners: [HeadOwnerEntry],
                                       kind_theories: [KindTheory],
                                       tab: SymTab, views: FileViews, roots: Roots,
                                       verbose: Bool) : TypedProgram / Console + File + Mutable {


  # Flatten every bucket's decls in the order they appear in
  # `modules` so the per-module typechecker can still cross-reference
  # `DEffect default { ... }` blocks (and other program-wide
  # decl-shaped data) without seeing the partition boundary.
  let all_program_decls = flatten_module_decls(modules, [])
  let sh = tc_shared(file, df, all_program_decls, tab, views, roots)
  typecheck_program_loop(file, df, modules, module_env_delta_empty(),
                          all_program_decls,
                          protos, head_owners, kind_theories, tab, sh, verbose,
                          [], 0, [], [], [], [], [], 0, 0)
}


# Tail-recursive fold accumulator. Each iteration typechecks one
# `ModuleDecls` against the running delta, merges the produced delta
# into the accumulator, and appends the typed module's pieces to
# `acc_*`. `core_len_acc` keeps the first non-zero `core_len`
# returned by any module — every call shares the
# same built-in seed length, so the value is identical regardless of
# which module reports it. The reverse step at the terminal restores
# document order on the accumulated lists.
fn typecheck_program_loop(file: String, df: DiagFiles, modules: [ModuleDecls],
                            acc_delta: ModuleEnvDelta,
                            all_program_decls: [Decl],
                            protos: ProtoView,
                            head_owners: [HeadOwnerEntry],
                            kind_theories: [KindTheory],
                            tab: SymTab, sh: TcShared,
                            verbose: Bool,
                            acc_decls: [Decl],
                            acc_errs: Int,
                            acc_insts: [ResolvedCS],
                            acc_holes: [ResolvedHole],
                            acc_row_holes: [ResolvedRowHole],
                            acc_diags: [Diagnostic],
                            acc_op_res: [OpResolution],
                            core_len_acc: Int,
                            # last module's top-level env length. The
                            # target file is typed last, so this is the
                            # boundary its holes' locals sit above.
                            toplevel_len_acc: Int) : TypedProgram / Console + File + Mutable {

  match modules {
    [] -> TypedProgram {
      decls: list_reverse(acc_decls), errs: acc_errs,
      insts: list_reverse(acc_insts), holes: list_reverse(acc_holes),
      row_holes: list_reverse(acc_row_holes),
      core_len: core_len_acc,
      toplevel_len: toplevel_len_acc,
      module_doc: doc_module_doc_text(all_program_decls),
      diags: list_reverse(acc_diags),
      op_res: list_reverse(acc_op_res)
    }
    [m, ...rest] -> {
      let r = typecheck_module(file, df, m, acc_delta, all_program_decls,
                                  protos, head_owners, kind_theories, tab, sh, verbose)
      let next_delta = merge_env_deltas(acc_delta, r.delta)
      let next_sh = tc_shared_extend(sh, r.delta)
      let next_core_len = match core_len_acc {
        0 -> r.typed.core_len
        _ -> core_len_acc
      }
      typecheck_program_loop(file, df, rest, next_delta, all_program_decls,
                              protos, head_owners, kind_theories, tab, next_sh, verbose,
                              prepend_reverse_decls(r.typed.decls, acc_decls),
                              acc_errs + r.typed.errs,
                              llvm_prepend_reverse(r.typed.insts, acc_insts),
                              prepend_reverse_holes(r.typed.holes, acc_holes),
                              prepend_reverse_row_holes(r.typed.row_holes,
                                                         acc_row_holes),
                              prepend_reverse_diags(r.typed.diags, acc_diags),
                              prepend_reverse_op_res(r.typed.op_res, acc_op_res),
                              next_core_len, r.typed.toplevel_len)
    }
  }
}


# variant accepting the per-compile head-owner cache. The
# `compile_source` driver builds the cache from the post-`expand_imports`
# decl stream + module table once per invocation and passes it here so
# `synth_pipe_dispatch` can resolve any in-scope `pub type T` against
# its declaring module without a hardcoded compiler table.
fn infer_program_with_protos_cached(file: String, df: DiagFiles, decls: [Decl], verbose: Bool,
                                       protos: ProtoView,
                                       head_owners: [HeadOwnerEntry],
                                       kind_theories: [KindTheory],
                                       tab: SymTab, views: FileViews, roots: Roots) : TypedProgram / Console + File + Mutable {


  # Hanga Roa modular typecheck: partition the post-cascade decl
  # stream by home module so each core is typed against the
  # inherited delta of the modules loaded before it, and the target
  # file is typed last. Without this partition, every module sees
  # every other module's records (and sums), so a user `type Pair =
  # ...` in the target file leaks into the typecheck of `core/list.kai`
  # and clobbers `tuple.Pair[a, b]`. The fold is byte-identical to
  # the pre-refactor flatten-and-call path when there is only one
  # bucket — which is the case for legacy callers passing a target-
  # only decl stream.
  let target_mod = root_module_name(file)
  let mods0 = partition_decls_by_home(decls, target_mod)
  let mods = match mods0 {
    []           -> [ModuleDecls { name: None, decls: decls }]
    [_]          -> [ModuleDecls { name: None, decls: decls }]
    _            -> mods0
  }
  typecheck_program_with_head_owners(file, df, mods, protos, head_owners, kind_theories, tab, views, roots, verbose)
}


# Walk scope looking for the first entry whose instantiated type
# unifies with `want`. Returns the entry's key on hit, None otherwise.
# `avoid` prevents obvious circular fills like `f(f)` when f itself
# is the candidate head.
type ArgMatch = { key: EnvKey, sub: Subst, fresh: Int }


# Two keys bind the same thing.
fn env_key_same(a: EnvKey, b: EnvKey) : Bool = env_key_ord(a) == env_key_ord(b)


fn synth_find_arg(scope: [TyEntry], want: Ty, fresh: Int, avoid: [EnvKey], sub: Subst) : Option[ArgMatch] / Mutable {
  match scope {
    [] -> None
    [te, ...rest] -> {
      if any(avoid, (k) => env_key_same(k, te.key)) or (not synth_return_structural(te.scheme)) {
        synth_find_arg(rest, want, fresh, avoid, sub)
      } else {
        let inst = instantiate(TyEnv { ...ty_env_empty(), fresh: fresh }, te.scheme)
        match unify(inst.ty, want, sub) {
          Some(sub1) -> Some(ArgMatch { key: te.key, sub: sub1, fresh: inst.env.fresh })
          None       -> synth_find_arg(rest, want, fresh, avoid, sub)
        }
      }
    }
  }
}


type ArgsMatch = { keys: [EnvKey], sub: Subst, fresh: Int }


fn synth_find_args(scope: [TyEntry], params: [Ty], fresh: Int, avoid: [EnvKey],
                   sub: Subst, acc: [EnvKey]) : Option[ArgsMatch] / Mutable {
  match params {
    [] -> Some(ArgsMatch { keys: list_reverse(acc), sub: sub, fresh: fresh })
    [p, ...rest] -> {
      let p_now = apply_ty(sub, p)
      match synth_find_arg(scope, p_now, fresh, avoid, sub) {
        Some(am) -> synth_find_args(scope, rest, am.fresh, avoid, am.sub, [am.key, ...acc])
        None     -> None
      }
    }
  }
}


# A candidate: the entry it reads, the entries it applies it to when it
# is a call, and the labels evaluating it performs.
type Synth = { head: EnvKey, args: Option[[EnvKey]], performs: [Label] }


fn synth_text(tab: SymTab, c: Synth) : String = match c.args {
  None     -> env_key_text(tab, c.head)
  Some(ks) -> concat_all([env_key_text(tab, c.head), "(", inf_join_with(map(ks, (k) => env_key_text(tab, k)), ", "), ")"])
}


# Try entry `te` as a direct match or a 1-level application against
# `expected`.
fn synth_try_entry(cx: SynthCtx, te: TyEntry) : Option[Synth] / Mutable {
  let inst = instantiate(TyEnv { ...ty_env_empty(), fresh: cx.fresh }, te.scheme)
  match unify(inst.ty, cx.expected, subst_empty()) {
    Some(_) -> Some(Synth { head: te.key, args: None, performs: [] })
    None -> synth_try_application(cx, te, inst)
  }
}

fn synth_try_application(cx: SynthCtx, te: TyEntry, inst: Instantiated) : Option[Synth] / Mutable =
  match inst.ty {
    TyFnT(ps, r, rw) ->
      if synth_return_structural(te.scheme) { synth_apply_args(cx, te, inst, ps, r, rw) } else { None }
    _ -> None
  }

fn synth_apply_args(cx: SynthCtx, te: TyEntry, inst: Instantiated, ps: [Ty], r: Ty, rw: Row) : Option[Synth] / Mutable =
  match unify(r, cx.expected, subst_empty()) {
    None -> None
    Some(s0) -> match synth_find_args(cx.all, ps, inst.env.fresh, [te.key], s0, []) {
      None -> None
      Some(m) ->
        if synth_reenters_owner(cx.owner, te.key, m.keys) { None }
        else {
          let performs = label_concat(apply_labels(m.sub, rw.labels),
                                      synth_op_label(cx.decls, te.key, synth_inst_vars(te.scheme, inst, m.sub)))
          Some(Synth { head: te.key, args: Some(m.keys), performs: performs })
        }
    }
  }


# The scheme's bound variables as instantiated, in quantification order.
fn synth_inst_vars(sc: TyScheme, inst: Instantiated, sub: Subst) : [Ty] = match sc {
  Scheme(vars, _, _, _, _) -> fresh_vars_from(inst.env.fresh - list_length(vars), inst.env.fresh, sub)
}


fn fresh_vars_from(i: Int, end: Int, sub: Subst) : [Ty] =
  if i >= end { [] } else { [apply_ty(sub, TyVarT(i)), ...fresh_vars_from(i + 1, end, sub)] }


# An effect op's scheme carries no row: calling `Eff.op` performs `Eff`,
# whose type arguments lead the op's quantified variables.
fn synth_op_label(decls: [Decl], key: EnvKey, vars: [Ty]) : [Label] = match key {
  KOp(eff, _) -> match effect_decl_of(eff, decls) {
    Some(DEffect(_, s, tps, _, _, _, _, _)) -> [row_label(s, take_first_tys(vars, list_length(tps)))]
    _ -> []
  }
  _ -> []
}


# The function a hole sits in, applied to its own parameters unchanged,
# type-checks as a filler for its body and never terminates.
fn synth_reenters_owner(owner: HoleOwner, head: EnvKey, args: [EnvKey]) : Bool = match owner {
  HOwner(f, params) -> match head {
    KSym(s) -> sym_same(s, f) and keys_are_locals(args, params)
    _       -> false
  }
  HNoOwner -> false
}


fn keys_are_locals(ks: [EnvKey], ls: [LocalId]) : Bool = match ks {
  [] -> list_is_empty(ls)
  [KLocal(b), ...rest] -> match ls {
    [l, ...more] -> local_eq(b.id, l) and keys_are_locals(rest, more)
    []           -> false
  }
  _ -> false
}


#[doc("infer: a candidate that fits a hole once its row adds `effects`.")]
pub type EffCand = { expr: String, effects: [String] }


#[doc("infer: a hole's candidates — those that fit as written, and those that fit once the hole's row adds effects.")]
pub type HoleCands = { fit: [String], needs: [EffCand] }


#[doc("Typer-internal type `SynthCtx` shared across the infer modules.")]
pub type SynthCtx = { all: [TyEntry], expected: Ty, fresh: Int, owner: HoleOwner, row: HoleRow, decls: [Decl] }


fn synth_candidates_loop(tab: SymTab, cx: SynthCtx, cur: [TyEntry], acc: HoleCands, max: Int) : HoleCands {
  if list_length(acc.fit) >= max { HoleCands { fit: list_reverse(acc.fit), needs: list_reverse(acc.needs) } }
  else { match cur {
    [] -> HoleCands { fit: list_reverse(acc.fit), needs: list_reverse(acc.needs) }
    [te, ...rest] -> match synth_try_entry(cx, te) {
      Some(c) -> synth_candidates_loop(tab, cx, rest, synth_classify(tab, acc, c, hole_row_missing(cx.row, c.performs, cx.decls), max), max)
      None    -> synth_candidates_loop(tab, cx, rest, acc, max)
    }
  } }
}


fn synth_classify(tab: SymTab, acc: HoleCands, c: Synth, missing: [Label], max: Int) : HoleCands = match missing {
  [] -> HoleCands { ...acc, fit: [synth_text(tab, c), ...acc.fit] }
  _  -> if list_length(acc.needs) >= max { acc }
        else { HoleCands { ...acc, needs: [EffCand { expr: synth_text(tab, c), effects: map(missing, (l) => label_to_string(tab, l)) }, ...acc.needs] } }
}


#[doc("infer: names in scope whose type unifies with a hole's expected type, split by whether the effects they perform fit the hole's row `hr`; `decls` resolves the effects `main` absorbs.")]
pub fn synth_candidates(tab: SymTab, scope: [TyEntry], expected: Ty, fresh: Int, owner: HoleOwner, hr: HoleRow, decls: [Decl]) : HoleCands =
  synth_candidates_loop(tab, SynthCtx { all: scope, expected: expected, fresh: fresh, owner: owner, row: hr, decls: decls },
                        scope, HoleCands { fit: [], needs: [] }, 8)
