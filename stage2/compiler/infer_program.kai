fn check_default_coverage(df: DiagFiles, tab: SymTab, mod_decls: [Decl], all_decls: [Decl],
                          homes: TyHomes) : [Diagnostic] / Console + File {
  # Precompute the `eff_name -> default ops` table once over `all_decls`,
  # then thread it through every per-DFn body walk so each `EHandle`
  # resolves its effect's default ops by assoc-list lookup instead of
  # re-scanning all declarations.
  let cx = CovCx { tab: tab, effs: build_effect_default_op_map(all_decls) }
  list_reverse(check_default_coverage_loop(df, all_decls, cx, homes, mod_decls, []))
}


fn check_default_coverage_loop(df: DiagFiles, all_decls: [Decl],
                                cx: CovCx, homes: TyHomes, ds: [Decl],
                                acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match ds {
    [] -> acc
    [d, ...rest] -> match d {
      DFn(_, fid, _, _, _, _, body, _, _, _) -> {
        let acc1 = walk_coverage_expr(decl_diag_file(d, df), all_decls, cx, decl_types_as_entry(homes, fid), body, [], acc)
        check_default_coverage_loop(df, all_decls, cx, homes, rest, acc1)
      }
      _ -> check_default_coverage_loop(df, all_decls, cx, homes, rest, acc)
    }
  }
}

# Field-privacy walker: every `.f` read and record literal in this
# module's typed bodies, judged by `field_hidden` once `Expr.ty` is the
# resolved record type. Record patterns are judged where the typer
# resolves their fields (`check_pfield_list`).


fn walk_coverage_expr(file: String, decls: [Decl], cx: CovCx,
                       entry: Bool,
                       e: Expr, stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match e.kind {
    EInt(_, _)           -> acc
    EReal(_, _)          -> acc
    EIntLit(_)           -> acc
    EDecimalLit(_)       -> acc
    EFixed(_, _)         -> acc
    EBool(_)          -> acc
    EChar(_)          -> acc
    EStr(_, _)        -> acc
    EUnit             -> acc
    EName(_)           -> acc
    EMark(_)           -> acc
    ESym(_, _)        -> acc
    ELocal(_)         -> acc
    EOp(_)            -> acc
    EUnder            -> acc
    EPlaceholder      -> acc
    EHole(_)          -> acc
    ETodo(_)          -> acc
    EExternBody(_, _) -> acc
    EVariantsOf(_, _) -> acc
    EModCall(_, _)    -> acc
    EIntrinsic(_, args_) ->
      walk_coverage_list(file, decls, cx, entry, args_, stack, acc)
    ESurface(sf) ->
      walk_coverage_list(file, decls, cx, entry, surface_children(sf), stack, acc)
    ECall(callee, args_) -> {
      let head_errs = match callee.kind {
        EOp(r) -> check_op_call_coverage(file, decls, cx, entry, r,
                                         stack, e.line, e.col)
        _ -> []
      }
      let acc1 = list_append(head_errs, acc)
      let acc2 = walk_coverage_expr(file, decls, cx, entry, callee, stack, acc1)
      walk_coverage_list(file, decls, cx, entry, args_, stack, acc2)
    }
    EField(base, _) -> walk_coverage_expr(file, decls, cx, entry, base, stack, acc)
    EIndex(a, b)    -> {
      let a1 = walk_coverage_expr(file, decls, cx, entry, a, stack, acc)
      walk_coverage_expr(file, decls, cx, entry, b, stack, a1)
    }
    EBinop(_, a, b) -> {
      let a1 = walk_coverage_expr(file, decls, cx, entry, a, stack, acc)
      walk_coverage_expr(file, decls, cx, entry, b, stack, a1)
    }
    EUnop(_, x)     -> walk_coverage_expr(file, decls, cx, entry, x, stack, acc)
    EIf(c, t, eo)   -> {
      let a1 = walk_coverage_expr(file, decls, cx, entry, c, stack, acc)
      let a2 = walk_coverage_expr(file, decls, cx, entry, t, stack, a1)
      match eo {
        Some(b) -> walk_coverage_expr(file, decls, cx, entry, b, stack, a2)
        None    -> a2
      }
    }
    EMatch(scr, arms) -> {
      let a1 = walk_coverage_expr(file, decls, cx, entry, scr, stack, acc)
      walk_coverage_arms(file, decls, cx, entry, arms, stack, a1)
    }
    ELambda(_, _) -> acc           # lambda bodies have their own row
    ERecordLit(_, fs) -> walk_coverage_fields(file, decls, cx, entry, fs, stack, acc)
    EList(els)        -> walk_coverage_elems(file, decls, cx, entry, els, stack, acc)
    ERange(a, b, opt) -> {
      let a1 = walk_coverage_expr(file, decls, cx, entry, a, stack, acc)
      let a2 = walk_coverage_expr(file, decls, cx, entry, b, stack, a1)
      match opt {
        Some(s) -> walk_coverage_expr(file, decls, cx, entry, s, stack, a2)
        None    -> a2
      }
    }
    EBlock(stmts, tail) -> {
      let a1 = walk_coverage_stmts(file, decls, cx, entry, stmts, stack, acc)
      match tail {
        Some(t) -> walk_coverage_expr(file, decls, cx, entry, t, stack, a1)
        None    -> a1
      }
    }
    EPipe(a, b)        -> {
      let a1 = walk_coverage_expr(file, decls, cx, entry, a, stack, acc)
      walk_coverage_expr(file, decls, cx, entry, b, stack, a1)
    }
    EDispatchPipe(_, a, b) -> {
      let a1 = walk_coverage_expr(file, decls, cx, entry, a, stack, acc)
      walk_coverage_expr(file, decls, cx, entry, b, stack, a1)
    }
    EBang(inner)       -> walk_coverage_expr(file, decls, cx, entry, inner, stack, acc)
    ELitUnit(inner, _) -> walk_coverage_expr(file, decls, cx, entry, inner, stack, acc)
    EHandle(body, eff, _, init_opt, _, clauses, ret_opt) -> {
      let hsym = ref_sym(eff)
      let clause_ops = handle_clause_op_names(clauses)
      let default_ops = effect_default_op_map_get(cx.effs, hsym)
      let frame = HF(hsym, clause_ops, default_ops, e.line, e.col)
      let missing = handler_missing_ops(effect_decl_of(hsym, decls), clause_ops, default_ops)
      let a0 = list_append(report_partial_handler(file, ref_text(cx.tab, eff), missing, e.line, e.col), acc)
      let a1 = match init_opt {
        Some(i) -> walk_coverage_expr(file, decls, cx, entry, i, stack, a0)
        None    -> a0
      }
      # Clause bodies execute outside `with eff_name` (the typer enforces
      # this; clauses are separate functions). Walk them under the outer
      # stack so a Eff.op clause body that itself calls Eff.op is not
      # silently treated as discharged by this frame.
      let a2 = walk_coverage_clauses(file, decls, cx, entry, clauses, stack, a1)
      let a3 = match ret_opt {
        Some(r) -> match r {
          HR(_, b, _, _) -> walk_coverage_expr(file, decls, cx, entry, b, stack, a2)
        }
        None -> a2
      }
      walk_coverage_expr(file, decls, cx, entry, body, [frame, ...stack], a3)
    }
  }
}



fn walk_coverage_list(file: String, decls: [Decl], cx: CovCx,
                       entry: Bool,
                       es: [Expr], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match es {
    []           -> acc
    [h, ...rest] -> {
      let a1 = walk_coverage_expr(file, decls, cx, entry, h, stack, acc)
      walk_coverage_list(file, decls, cx, entry, rest, stack, a1)
    }
  }
}



fn walk_coverage_arms(file: String, decls: [Decl], cx: CovCx,
                       entry: Bool,
                       arms: [Arm], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match arms {
    []           -> acc
    [a, ...rest] -> match a {
      Arm(_, og, body) -> {
        let a1 = match og {
          Some(g) -> walk_coverage_expr(file, decls, cx, entry, g, stack, acc)
          None    -> acc
        }
        let a2 = walk_coverage_expr(file, decls, cx, entry, body, stack, a1)
        walk_coverage_arms(file, decls, cx, entry, rest, stack, a2)
      }
    }
  }
}



fn walk_coverage_fields(file: String, decls: [Decl], cx: CovCx,
                         entry: Bool,
                         fs: [FieldInit], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match fs {
    []           -> acc
    [f, ...rest] -> match f {
      FI(_, e) -> {
        let a1 = walk_coverage_expr(file, decls, cx, entry, e, stack, acc)
        walk_coverage_fields(file, decls, cx, entry, rest, stack, a1)
      }
    }
  }
}



fn walk_coverage_elems(file: String, decls: [Decl], cx: CovCx,
                        entry: Bool,
                        els: [ListElem], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match els {
    []            -> acc
    [el, ...rest] -> match el {
      ElPlain(e)  -> {
        let a1 = walk_coverage_expr(file, decls, cx, entry, e, stack, acc)
        walk_coverage_elems(file, decls, cx, entry, rest, stack, a1)
      }
      ElSpread(e) -> {
        let a1 = walk_coverage_expr(file, decls, cx, entry, e, stack, acc)
        walk_coverage_elems(file, decls, cx, entry, rest, stack, a1)
      }
    }
  }
}



fn walk_coverage_stmts(file: String, decls: [Decl], cx: CovCx,
                        entry: Bool,
                        ss: [Stmt], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match ss {
    []           -> acc
    [s, ...rest] -> match s {
      SLet(_, _, e) -> {
        let a1 = walk_coverage_expr(file, decls, cx, entry, e, stack, acc)
        walk_coverage_stmts(file, decls, cx, entry, rest, stack, a1)
      }
      SVar(_, _, e, _, _) -> {
        let a1 = walk_coverage_expr(file, decls, cx, entry, e, stack, acc)
        walk_coverage_stmts(file, decls, cx, entry, rest, stack, a1)
      }
      SAssert(e, og) -> {
        let a1 = walk_coverage_expr(file, decls, cx, entry, e, stack, acc)
        let a2 = match og {
          Some(g) -> walk_coverage_expr(file, decls, cx, entry, g, stack, a1)
          None    -> a1
        }
        walk_coverage_stmts(file, decls, cx, entry, rest, stack, a2)
      }
      SExprStmt(e) -> {
        let a1 = walk_coverage_expr(file, decls, cx, entry, e, stack, acc)
        walk_coverage_stmts(file, decls, cx, entry, rest, stack, a1)
      }
      SIndexAssign(a, b, c, _, _) -> {
        let a1 = walk_coverage_expr(file, decls, cx, entry, a, stack, acc)
        let a2 = walk_coverage_expr(file, decls, cx, entry, b, stack, a1)
        let a3 = walk_coverage_expr(file, decls, cx, entry, c, stack, a2)
        walk_coverage_stmts(file, decls, cx, entry, rest, stack, a3)
      }
      SAssign(a, c, _, _) -> {
        let a1 = walk_coverage_expr(file, decls, cx, entry, a, stack, acc)
        let a3 = walk_coverage_expr(file, decls, cx, entry, c, stack, a1)
        walk_coverage_stmts(file, decls, cx, entry, rest, stack, a3)
      }
      SUse(_, _, _) -> walk_coverage_stmts(file, decls, cx, entry, rest, stack, acc)
    }
  }
}



fn walk_coverage_clauses(file: String, decls: [Decl], cx: CovCx,
                          entry: Bool,
                          cs: [HClause], stack: [HandleFrame], acc: [Diagnostic]) : [Diagnostic] / Console + File {
  match cs {
    []           -> acc
    [c, ...rest] -> match c {
      HC(_, _, body, _, _) -> {
        let a1 = walk_coverage_expr(file, decls, cx, entry, body, stack, acc)
        walk_coverage_clauses(file, decls, cx, entry, rest, stack, a1)
      }
    }
  }
}

# Op-call discharge for the perform `r`: returns the diagnostic it
# emitted, if any.


fn check_op_call_coverage(file: String, decls: [Decl],
                           cx: CovCx, entry: Bool,
                           r: OpRef, stack: [HandleFrame],
                           line: Int, col: Int) : [Diagnostic] / Console + File {
  let esym = r.eff
  let op_name = written_text(r.op)
  # Skip the row-level absorbed labels (Ffi etc.) — they have no per-op
  # discharge surface. The walker only fires for declared effects that
  # come through `effect E { ops }`. Builtins are injected as DEffect
  # by `inject_builtin_effects` before this check runs, so they all
  # show up via `is_effect_declared`.
  if not is_effect_declared(esym, decls) { [] }
  else {
    match find_top_eff_frame(stack, esym) {
      Some(frame) -> match frame {
        HF(_, clause_ops, _default_ops, _, _) ->
          if list_has_string(clause_ops, op_name) { [] }
          else {
            # Spec step 3 ("enclosing handle exists, op not in
            # clauses, default block covers op → clause-merge from
            # default fires") is DISABLED in Stage B: codegen Stage
            # A's `emit_clause_assignments` only wires `_ev.<op>` for
            # ops the user typed in the handle. The inner handle's
            # evidence node masks any enclosing default, so the
            # dispatch hits a NULL function pointer at runtime
            # regardless of what `default { }` declares. Stage C
            # extends the handle emitter to consult the effect's
            # default block and synthesize the missing clauses; at
            # that point this branch flips to check `_default_ops`
            # and discharges.
            [report_uncovered_op(file, cx.tab, op_name, esym, decls,
                                 line, col, false)]
          }
      }
      None ->
        # No enclosing handle for the effect. The op either fires from
        # main (step 4) or escapes to the caller's row.
        if entry {
          # every effect (builtin or user) with a
          # source-level `default { }` block bridging via
          # `$extern_handler` gets auto-installed at main. The
          # check is now uniform — no special builtin list.
          let default_ops = effect_default_op_map_get(cx.effs, esym)
          if list_has_string(default_ops, op_name) { [] }
          else {
            [report_uncovered_op(file, cx.tab, op_name, esym, decls,
                                 line, col, true)]
          }
        }
        else { [] }
    }
  }
}


fn report_uncovered_op(file: String, tab: SymTab,
                        op_name: String, esym: SymId, decls: [Decl],
                        line: Int, col: Int, at_main: Bool) : Diagnostic / Console + File {
  # What the reader is told to write is the name their source spells.
  let eff_name = inf_tycon_display_ow(tab, spelled_head_owners(decls, tab, []), esym)
  let qualified = concat_all([eff_name, ".", op_name])
  let header = concat_all(["effect not handled: ", qualified])
  let default_status = describe_default_status(eff_name, op_name, effect_decl_default(effect_decl_of(esym, decls)))
  let help = if at_main {
    concat_all(["wrap the call in `handle { ... } with ",
                eff_name, " { ", op_name,
                "(args, resume) -> ... }`, or add `",
                op_name, "(args, resume) -> ...` to `effect ",
                eff_name, "`'s `default { }` block"])
  } else {
    concat_all(["add a `", op_name,
                "(args, resume) -> ...` clause to the enclosing `handle ... with ",
                eff_name, "`, or add `", op_name,
                "(args, resume) -> ...` to `effect ", eff_name,
                "`'s `default { }` block"])
  }
  let d = mk_diag(SevError, file, line, col, header, [ri_note(file, line, col, default_status), ri_help(file, line, col, help)])
  render_diag(d)
  d
}



fn describe_default_status(eff_name: String, op_name: String,
                            dblk: Option[DefaultBlock]) : String {
  match dblk {
    None ->
      concat_all(["effect `", eff_name,
                  "` declares no `default { }` block, so no fallback handler exists"])
    Some(defblk) -> match defblk {
      DBlk(clauses, _, _, _) -> {
        let all_names = handle_clause_op_names(clauses)
        let extern_names = extern_handler_op_names(clauses)
        if list_has_string(extern_names, op_name) {
          # The default block does declare the op AND its body is an
          # `$extern_handler(...)` bridge — codegen Stage A can lower it
          # at `main` level. The reason discharge failed is that we are
          # inside a partial `handle ... with E`: Stage A's
          # `emit_clause_assignments` only wires the user-declared
          # clauses, so an inner handle's evidence node masks the
          # main-level default. Stage C lifts the masking by emitting
          # the default's clauses inside every enclosing handle's `_ev`.
          concat_all(["effect `", eff_name,
                      "`'s `default { }` block does declare `", op_name,
                      "` via `$extern_handler`, but the enclosing `handle ... with ",
                      eff_name, "` masks the main-level default — Stage C will let the handle inherit unmissed default clauses; until then the partial handle must add `",
                      op_name, "`"])
        } else if list_has_string(all_names, op_name) {
          # The user wrote the clause but its body is a kaikai expression.
          # Stage A lowers only `$extern_handler(...)` bridges; Stage C
          # will close this gap.
          concat_all(["effect `", eff_name,
                      "`'s `default { }` block declares `", op_name,
                      "` but its body is not an `$extern_handler(...)` bridge — Stage C will lower kaikai-bodied default clauses; for now the clause must use the intrinsic"])
        } else {
          concat_all(["effect `", eff_name,
                      "`'s `default { }` block does not declare `",
                      op_name, "`"])
        }
      }
    }
  }
}

# Build a single shim declaration from a clause whose body bridges to
# a C symbol via `$extern_handler("c_sym")`. Returns "" if the body is
# not an extern_handler intrinsic — Stage A does not emit kaikai-bodied
# default clauses.
# NOTE: do NOT name a local binding `c_sym` here — `c_sym` is also a
# pre-existing fn in compiler.kai (FFI C-symbol minter), and
# the resolver picks the global fn over the let-binding, emitting the
# expression as a closure reference instead of a string read. Use
# `csym_name` or similar to dodge the collision.

# register a `[unstable] <pkg> = true` opt-in from
# kai.toml. Repeated flags accumulate.

# ====================================================================
# HM type schemes, substitution/unification, bidirectional inference,
# and the infer driver
# ====================================================================

# type schemes + environment
# ====================================================================
#
# A TyScheme is `Scheme(bound_vars, bound_rvars, Ty)`: the type-var
# ids in `bound_vars` appear as TyVarT(n) inside `Ty`; the row-var
# ids in `bound_rvars` appear as `Row { tail: Some(n) }` inside any
# TyFnT in `Ty`. Both kinds are instantiated to fresh ids at each
# use site. The bound ids
# are scheme-local — bound-id 0 in scheme A and bound-id 0 in scheme
# B refer to different vars; the instantiation step rewrites them
# through a temporary substitution before they reach the inferencer's
# main subst slots.
#
# A TyEnv holds its entries newest first, each indexed by the identity
# it binds, plus a fresh-variable counter.


#[doc("infer: run HM + bidirectional inference over a program, returning the TypedProgram.")]
pub fn infer_program(file: String, decls: [Decl], tin: TyperIn, verbose: Bool) : TypedProgram / Console + File + Mutable =
  infer_program_with_protos_cached(file, tin.df, decls, verbose, tin.protos, tin.head_owners,
                                   tin.kind_theories, tin.tab, tin.views, tin.roots)


#[doc("infer: typecheck one module against an inherited `ModuleEnvDelta`, returning its typed program plus the delta it contributes. `df` attributes each diagnostic to the file declaring the decl it fires on; `file` stays the root and keeps naming the target module.")]
pub fn typecheck_module(file: String, df: DiagFiles, mod: ModuleDecls,
                     inherited: ModuleEnvDelta,
                     all_program_decls: [Decl],
                     protos: ProtoView,
                     head_owners: [HeadOwnerEntry],
                     kind_theories: [KindTheory],
                     tab: SymTab, sh: TcShared,
                     verbose: Bool) : TypecheckedModule / Console + File + Mutable {

  let data0 = collect_program_data_inherited(file, mod.decls, inherited, sh, tab)
  # attach the per-compile head-owner cache to the env
  # the typer walks. The cache is built once per `compile_source`
  # invocation from the post-`expand_imports` decl stream + module
  # table; threading it here keeps `synth_pipe_dispatch`'s lookup
  # `O(1)` per call site.
  let env_with_owners = ty_env_with_head_owners(data0.built.env, head_owners)
  let built1 = BuiltEnv { env: ty_env_with_carriers(env_with_owners, sh.carriers),
                          core_len: data0.built.core_len,
                          op_eff_arities: data0.built.op_eff_arities }
  let data = ProgramData { decls_a: data0.decls_a, built: built1,
                            recs: data0.recs, alias_res: data0.alias_res,
                            op_to_eff: data0.op_to_eff, sums: data0.sums,
                            homes: data0.homes }
  # Hanga Roa modular typecheck: `infer_all_loop` keeps a per-decl
  # `all_decls` pointer so `check_main_row_handlable` /
  # `check_body_row` can look up `DEffect default { ... }` blocks
  # from any module. Pass the full program's decl list (not just
  # this module's) so cross-module effect-default lookups stay
  # honest after the partition.
  let all_decls_for_typer = if list_length(all_program_decls) > 0 {
    all_program_decls
  } else { data.decls_a }
  let tp = infer_all_loop(df, data.built.env, data.built.core_len, data.recs,
                 data.built.op_eff_arities, data.decls_a, verbose, [], 0, [], [], [], [], [],
                 data.alias_res.aliases, data.op_to_eff, data.sums,
                 handle_tab(data.built.env, data.sums, data.recs), protos,
                 all_decls_for_typer, kind_theories)
  # Stage B coverage check. Runs after row-level inference
  # is complete so the typed body carries the resolved effect-op
  # callees the walker keys on. Its diagnostics are rendered as found and
  # join TypedProgram.diags.
  #
  # Pass `all_decls_for_typer` (whole program) as the second list so
  # effect-existence and default-block lookups see DEffects that the
  # modular partition placed in a different pass than the body that
  # performs the op. Without this, `is_effect_declared` returns false
  # for any user effect declared in the same file but partitioned away
  # from its `fn main()`, silencing the per-op coverage walker.
  let cov_diags = check_default_coverage(df, tab, tp.decls, all_decls_for_typer, sh.homes)
  let priv_diags = check_field_privacy(df, tab, tsh_view(sh.homes, mod.name), tp.decls,
    if list_length(all_program_decls) > 0 { sh.field_recs } else { field_recs_of(data.decls_a) })
  let spawn_diags = check_spawn_rows(df, tab, sh.cell_carriers, tp.decls, all_decls_for_typer)
  let typed = TypedProgram {
    decls: tp.decls, errs: tp.errs + list_length(cov_diags) + list_length(priv_diags) + list_length(spawn_diags),
    insts: tp.insts, holes: tp.holes, row_holes: tp.row_holes,
    core_len: tp.core_len, toplevel_len: tp.toplevel_len,
    module_doc: tp.module_doc,
    diags: list_append(tp.diags, list_append(cov_diags, list_append(priv_diags, spawn_diags))), op_res: tp.op_res
  }
  # the returned delta carries ONLY this module's
  # contribution (i.e. the slice of working-table state that
  # `decls_a` added on top of `inherited`). The fold's `acc_delta`
  # composes these per-module slices via `merge_env_deltas`, so a
  # downstream cache hit can serialise this slice in isolation and
  # the next loader hands it back through `inherited` to skip the
  # work this call did.
  #
  # `ty_entries` extracted by length-diff against `inherited`: every
  # entry past `len(inherited.ty_entries) + len(seed_entries)` was
  # added by `add_decls_loop` over this module. `add_decls_loop`
  # cons-prepends, so the new entries occupy the head of the list;
  # the same shape holds for `op_eff_arities`.
  let n_inherited = list_length(inherited.ty_entries) +
                     sh.seed.core_len
  let n_total = list_length(data.built.env.entries)
  let n_new = n_total - n_inherited
  let new_entries = take_entries(data.built.env.entries, n_new, [])
  let n_ar_inherited = list_length(inherited.op_eff_arities)
  let n_ar_total = list_length(data.built.op_eff_arities)
  let new_arities = take_op_eff_arities(data.built.op_eff_arities,
                                          n_ar_total - n_ar_inherited, [])
  let delta = ModuleEnvDelta {
    name:           mod.name,
    ty_entries:     new_entries,
    unions:         collect_unions(data.decls_a, tab, tsh_view(data.homes, None)),
    op_eff_arities: new_arities,
    recs:           typer_records(data.decls_a, tab),
    sums:           collect_sums(data.decls_a),
    op_to_eff:      inf_collect_op_to_eff(data.decls_a),
    unit_aliases:   collect_unit_alias_table(mod.decls),
    constructors:   collect_constructors(data.decls_a, sh.homes, [])
  }
  TypecheckedModule { typed: typed, delta: delta }
}


# Fold `typecheck_module` left-to-right across the per-module decl
# streams, threading the accumulating `ModuleEnvDelta` as `inherited`
# for each segment.
# variant accepting the per-compile head-owner cache. The
# cache is built once by `compile_source` after `expand_imports`
# completes.
fn typecheck_program_with_head_owners(file: String, df: DiagFiles, modules: [ModuleDecls],
                                       protos: ProtoView,
                                       head_owners: [HeadOwnerEntry],
                                       kind_theories: [KindTheory],
                                       tab: SymTab, views: FileViews, roots: Roots,
                                       verbose: Bool) : TypedProgram / Console + File + Mutable {


  # Flatten every bucket's decls in the order they appear in
  # `modules` so the per-module typechecker can still cross-reference
  # `DEffect default { ... }` blocks (and other program-wide
  # decl-shaped data) without seeing the partition boundary.
  let all_program_decls = flatten_module_decls(modules, [])
  let sh = tc_shared(file, df, all_program_decls, tab, views, roots)
  typecheck_program_loop(file, df, modules, module_env_delta_empty(),
                          all_program_decls,
                          protos, head_owners, kind_theories, tab, sh, verbose,
                          [], 0, [], [], [], [], [], 0, 0)
}


# Tail-recursive fold accumulator. Each iteration typechecks one
# `ModuleDecls` against the running delta, merges the produced delta
# into the accumulator, and appends the typed module's pieces to
# `acc_*`. `core_len_acc` keeps the first non-zero `core_len`
# returned by any module — every call shares the
# same built-in seed length, so the value is identical regardless of
# which module reports it. The reverse step at the terminal restores
# document order on the accumulated lists.
fn typecheck_program_loop(file: String, df: DiagFiles, modules: [ModuleDecls],
                            acc_delta: ModuleEnvDelta,
                            all_program_decls: [Decl],
                            protos: ProtoView,
                            head_owners: [HeadOwnerEntry],
                            kind_theories: [KindTheory],
                            tab: SymTab, sh: TcShared,
                            verbose: Bool,
                            acc_decls: [Decl],
                            acc_errs: Int,
                            acc_insts: [ResolvedCS],
                            acc_holes: [ResolvedHole],
                            acc_row_holes: [ResolvedRowHole],
                            acc_diags: [Diagnostic],
                            acc_op_res: [OpResolution],
                            core_len_acc: Int,
                            # last module's top-level env length. The
                            # target file is typed last, so this is the
                            # boundary its holes' locals sit above.
                            toplevel_len_acc: Int) : TypedProgram / Console + File + Mutable {

  match modules {
    [] -> TypedProgram {
      decls: list_reverse(acc_decls), errs: acc_errs,
      insts: list_reverse(acc_insts), holes: list_reverse(acc_holes),
      row_holes: list_reverse(acc_row_holes),
      core_len: core_len_acc,
      toplevel_len: toplevel_len_acc,
      module_doc: doc_module_doc_text(all_program_decls),
      diags: list_reverse(acc_diags),
      op_res: list_reverse(acc_op_res)
    }
    [m, ...rest] -> {
      let r = typecheck_module(file, df, m, acc_delta, all_program_decls,
                                  protos, head_owners, kind_theories, tab, sh, verbose)
      let next_delta = merge_env_deltas(acc_delta, r.delta)
      let next_sh = tc_shared_extend(sh, r.delta)
      let next_core_len = match core_len_acc {
        0 -> r.typed.core_len
        _ -> core_len_acc
      }
      typecheck_program_loop(file, df, rest, next_delta, all_program_decls,
                              protos, head_owners, kind_theories, tab, next_sh, verbose,
                              prepend_reverse_decls(r.typed.decls, acc_decls),
                              acc_errs + r.typed.errs,
                              llvm_prepend_reverse(r.typed.insts, acc_insts),
                              prepend_reverse_holes(r.typed.holes, acc_holes),
                              prepend_reverse_row_holes(r.typed.row_holes,
                                                         acc_row_holes),
                              prepend_reverse_diags(r.typed.diags, acc_diags),
                              prepend_reverse_op_res(r.typed.op_res, acc_op_res),
                              next_core_len, r.typed.toplevel_len)
    }
  }
}


# variant accepting the per-compile head-owner cache. The
# `compile_source` driver builds the cache from the post-`expand_imports`
# decl stream + module table once per invocation and passes it here so
# `synth_pipe_dispatch` can resolve any in-scope `pub type T` against
# its declaring module without a hardcoded compiler table.
fn infer_program_with_protos_cached(file: String, df: DiagFiles, decls: [Decl], verbose: Bool,
                                       protos: ProtoView,
                                       head_owners: [HeadOwnerEntry],
                                       kind_theories: [KindTheory],
                                       tab: SymTab, views: FileViews, roots: Roots) : TypedProgram / Console + File + Mutable {


  # Hanga Roa modular typecheck: partition the post-cascade decl
  # stream by home module so each core is typed against the
  # inherited delta of the modules loaded before it, and the target
  # file is typed last. Without this partition, every module sees
  # every other module's records (and sums), so a user `type Pair =
  # ...` in the target file leaks into the typecheck of `core/list.kai`
  # and clobbers `tuple.Pair[a, b]`. The fold is byte-identical to
  # the pre-refactor flatten-and-call path when there is only one
  # bucket — which is the case for legacy callers passing a target-
  # only decl stream.
  let target_mod = root_module_name(file)
  let mods0 = partition_decls_by_home(decls, target_mod)
  let mods = match mods0 {
    []           -> [ModuleDecls { name: None, decls: decls }]
    [_]          -> [ModuleDecls { name: None, decls: decls }]
    _            -> mods0
  }
  typecheck_program_with_head_owners(file, df, mods, protos, head_owners, kind_theories, tab, views, roots, verbose)
}


# ---- bounded candidate synthesis ----
#
# Given a hole's expected type `E` and the visible scope, enumerate a
# small set of expressions the user (or an LLM) might plug in. The
# doc calls this a "bounded enumeration": we do not explore beyond a
# single application, and we never nest candidates. Two classes:
#   1. direct: `name` where `name : T` and `T ~= E`.
#   2. application: `f(x1, .., xn)` where `f : (T1..Tn) -> R`, `R ~= E`,
#      and each `Ti` unifies with some in-scope name's type.
# Entries whose *immediate* return type is a bare polymorphic var (e.g.
# `panic`, `exit`) are rejected from class 2 — they'd match any hole
# and drown useful suggestions. A shared `env_fresh` counter keeps
# each instantiation's fresh TyVars disjoint from the hole's own
# residual vars.


# Walk scope looking for the first entry whose instantiated type
# unifies with `want`. Returns the entry's key on hit, None otherwise.
# `avoid` prevents obvious circular fills like `f(f)` when f itself
# is the candidate head.
type ArgMatch = { key: EnvKey, sub: Subst, fresh: Int }


# Two keys bind the same thing.
fn env_key_same(a: EnvKey, b: EnvKey) : Bool = env_key_ord(a) == env_key_ord(b)


fn synth_find_arg(scope: [TyEntry], want: Ty, fresh: Int, avoid: [EnvKey], sub: Subst) : Option[ArgMatch] / Mutable {
  match scope {
    [] -> None
    [te, ...rest] -> {
      if any(avoid, (k) => env_key_same(k, te.key)) or (not synth_return_structural(te.scheme)) {
        synth_find_arg(rest, want, fresh, avoid, sub)
      } else {
        let inst = instantiate(TyEnv { ...ty_env_empty(), fresh: fresh }, te.scheme)
        match unify(inst.ty, want, sub) {
          Some(sub1) -> Some(ArgMatch { key: te.key, sub: sub1, fresh: inst.env.fresh })
          None       -> synth_find_arg(rest, want, fresh, avoid, sub)
        }
      }
    }
  }
}


type ArgsMatch = { keys: [EnvKey], sub: Subst, fresh: Int }


fn synth_find_args(scope: [TyEntry], params: [Ty], fresh: Int, avoid: [EnvKey],
                   sub: Subst, acc: [EnvKey]) : Option[ArgsMatch] / Mutable {
  match params {
    [] -> Some(ArgsMatch { keys: list_reverse(acc), sub: sub, fresh: fresh })
    [p, ...rest] -> {
      let p_now = apply_ty(sub, p)
      match synth_find_arg(scope, p_now, fresh, avoid, sub) {
        Some(am) -> synth_find_args(scope, rest, am.fresh, avoid, am.sub, [am.key, ...acc])
        None     -> None
      }
    }
  }
}


# A candidate: the entry it reads, the entries it applies it to when it
# is a call, and the labels evaluating it performs.
type Synth = { head: EnvKey, args: Option[[EnvKey]], performs: [Label] }


fn synth_text(tab: SymTab, c: Synth) : String = match c.args {
  None     -> env_key_text(tab, c.head)
  Some(ks) -> concat_all([env_key_text(tab, c.head), "(", inf_join_with(map(ks, (k) => env_key_text(tab, k)), ", "), ")"])
}


# Try entry `te` as a direct match or a 1-level application against
# `expected`.
fn synth_try_entry(cx: SynthCtx, te: TyEntry) : Option[Synth] / Mutable {
  let inst = instantiate(TyEnv { ...ty_env_empty(), fresh: cx.fresh }, te.scheme)
  match unify(inst.ty, cx.expected, subst_empty()) {
    Some(_) -> Some(Synth { head: te.key, args: None, performs: [] })
    None    -> match inst.ty {
      TyFnT(ps, r, rw) -> {
        if synth_return_structural(te.scheme) {
          match unify(r, cx.expected, subst_empty()) {
            None     -> None
            Some(s0) -> match synth_find_args(cx.all, ps, inst.env.fresh, [te.key], s0, []) {
              None    -> None
              Some(m) ->
                if synth_reenters_owner(cx.owner, te.key, m.keys) { None }
                else { Some(Synth { head: te.key, args: Some(m.keys),
                                    performs: label_concat(apply_labels(m.sub, rw.labels),
                                                           synth_op_label(cx.decls, te.key, synth_inst_vars(te.scheme, inst, m.sub))) }) }
            }
          }
        } else { None }
      }
      _ -> None
    }
  }
}


# The scheme's bound variables as instantiated, in quantification order.
fn synth_inst_vars(sc: TyScheme, inst: Instantiated, sub: Subst) : [Ty] = match sc {
  Scheme(vars, _, _, _, _) -> fresh_vars_from(inst.env.fresh - list_length(vars), inst.env.fresh, sub)
}


fn fresh_vars_from(i: Int, end: Int, sub: Subst) : [Ty] =
  if i >= end { [] } else { [apply_ty(sub, TyVarT(i)), ...fresh_vars_from(i + 1, end, sub)] }


# An effect op's scheme carries no row: calling `Eff.op` performs `Eff`,
# whose type arguments lead the op's quantified variables.
fn synth_op_label(decls: [Decl], key: EnvKey, vars: [Ty]) : [Label] = match key {
  KOp(eff, _) -> match effect_decl_of(eff, decls) {
    Some(DEffect(_, s, tps, _, _, _, _, _)) -> [row_label(s, take_first_tys(vars, list_length(tps)))]
    _ -> []
  }
  _ -> []
}


# The function a hole sits in, applied to its own parameters unchanged,
# type-checks as a filler for its body and never terminates.
fn synth_reenters_owner(owner: HoleOwner, head: EnvKey, args: [EnvKey]) : Bool = match owner {
  HOwner(f, params) -> match head {
    KSym(s) -> sym_same(s, f) and keys_are_locals(args, params)
    _       -> false
  }
  HNoOwner -> false
}


fn keys_are_locals(ks: [EnvKey], ls: [LocalId]) : Bool = match ks {
  [] -> list_is_empty(ls)
  [KLocal(b), ...rest] -> match ls {
    [l, ...more] -> local_eq(b.id, l) and keys_are_locals(rest, more)
    []           -> false
  }
  _ -> false
}


#[doc("infer: a candidate that fits a hole once its row adds `effects`.")]
pub type EffCand = { expr: String, effects: [String] }


#[doc("infer: a hole's candidates — those that fit as written, and those that fit once the hole's row adds effects.")]
pub type HoleCands = { fit: [String], needs: [EffCand] }


#[doc("Typer-internal type `SynthCtx` shared across the infer modules.")]
pub type SynthCtx = { all: [TyEntry], expected: Ty, fresh: Int, owner: HoleOwner, row: HoleRow, decls: [Decl] }


fn synth_candidates_loop(tab: SymTab, cx: SynthCtx, cur: [TyEntry], acc: HoleCands, max: Int) : HoleCands {
  if list_length(acc.fit) >= max { HoleCands { fit: list_reverse(acc.fit), needs: list_reverse(acc.needs) } }
  else { match cur {
    [] -> HoleCands { fit: list_reverse(acc.fit), needs: list_reverse(acc.needs) }
    [te, ...rest] -> match synth_try_entry(cx, te) {
      Some(c) -> synth_candidates_loop(tab, cx, rest, synth_classify(tab, acc, c, hole_row_missing(cx.row, c.performs, cx.decls), max), max)
      None    -> synth_candidates_loop(tab, cx, rest, acc, max)
    }
  } }
}


fn synth_classify(tab: SymTab, acc: HoleCands, c: Synth, missing: [Label], max: Int) : HoleCands = match missing {
  [] -> HoleCands { ...acc, fit: [synth_text(tab, c), ...acc.fit] }
  _  -> if list_length(acc.needs) >= max { acc }
        else { HoleCands { ...acc, needs: [EffCand { expr: synth_text(tab, c), effects: map(missing, (l) => label_to_string(tab, l)) }, ...acc.needs] } }
}


#[doc("infer: names in scope whose type unifies with a hole's expected type, split by whether the effects they perform fit the hole's row `hr`; `decls` resolves the effects `main` absorbs.")]
pub fn synth_candidates(tab: SymTab, scope: [TyEntry], expected: Ty, fresh: Int, owner: HoleOwner, hr: HoleRow, decls: [Decl]) : HoleCands =
  synth_candidates_loop(tab, SynthCtx { all: scope, expected: expected, fresh: fresh, owner: owner, row: hr, decls: decls },
                        scope, HoleCands { fit: [], needs: [] }, 8)
