#[doc("""
A segment request takes its arguments, and it may never return: a body
discontinued while suspended unwinds without coming back. An op argument
its forwarding clause kept across the request would leak, so an argument
read only by the request moves into it.
""")]

import compiler.ast
import compiler.sym_read
import compiler.expr_positions
import compiler.handler_alias

#[doc("Whether a clause body is read as under a lambda: a forwarding clause's own arguments are not captures, and what it reads around it is.")]
pub fn pcs_clause_in_lam(in_lam: Bool, params: [Param], body: Expr) : Bool = match pcs_clause_requested(params, body) {
  [] -> in_lam
  _ -> false
}

#[doc("The op arguments of a clause that move into its `$seg_request`.")]
pub fn pcs_clause_requested(params: [Param], body: Expr) : [String] =
  pcs_seg_request_moves(map(clause_op_args(params), (p) => p.pname), body)

#[doc("The names of `names` that `body` reads once, as a bare `$seg_request` argument.")]
pub fn pcs_seg_request_moves(names: [String], body: Expr) : [String] =
  filter(names, (nm) => psr_reads(nm, body) == 1 and psr_requested(nm, body))

fn psr_is(nm: String, e: Expr) : Bool = match sym_read_kind(e.kind) {
  EVar(u) -> u == nm
  _ -> false
}

fn psr_requested(nm: String, e: Expr) : Bool = match e.kind {
  EIntrinsic(n, xs) -> (n == "seg_request" and any(xs, (x) => psr_is(nm, x))) or any(xs, (x) => psr_requested(nm, x))
  _ -> any(psr_inline_ps(xp_positions(e)), (x) => psr_requested(nm, x))
}

# A read under a lambda is a capture: it disqualifies the move.
fn psr_reads(nm: String, e: Expr) : Int = if psr_is(nm, e) { 1 } else { psr_reads_ps(nm, xp_positions(e), 0) }

fn psr_reads_ps(nm: String, ps: [XPos], n: Int) : Int = match ps {
  [] -> n
  [XP(r, c), ...rest] -> {
    let here = psr_reads(nm, c)
    psr_reads_ps(nm, rest, n + (if xrole_inline(r) { here } else { here * 2 }))
  }
}

fn psr_inline_ps(ps: [XPos]) : [Expr] = match ps {
  [] -> []
  [XP(r, c), ...rest] -> if xrole_inline(r) { [c, ...psr_inline_ps(rest)] } else { psr_inline_ps(rest) }
}
