#[doc("KIR to C printer: program assembly, default evidence, runner driver and the single translation unit.")]

import compiler.ast_decl
import compiler.effect_instance
import compiler.emit_native
import compiler.emit_native_def
import compiler.emit_native_fn
import compiler.emit_native_fx
import compiler.emit_shared_syms
import compiler.fnreg
import compiler.infer_index
import compiler.kir
import compiler.kir_c_core
import compiler.kir_c_prog_ffi
import compiler.kir_c_prog_proto
import compiler.kir_syms
import compiler.spec_names
import compiler.symtab
import compiler.util

#[doc("The per-fn printers the program assembly calls: a full definition, a forward declaration and the thunk forwarder ('' when the fn has none).")]
pub type KcFnPrinters = { def: (KcCx, KFn) -> String, proto: (KcCx, KFn) -> String, thunk: (KcCx, KFn) -> String }

#[doc("The definition of an `extern \"C\"` shim.")]
pub fn kc_ffi_shim(cx: KcCx, f: KFn, csym: String, pks: [KFfiKind], rk: KFfiKind) : String =
  kc_ffi_fn(cx, f, csym, pks, rk)

fn kcg_prelude(modular: Bool) : String = concat_all([
  if modular { "#include <runtime/runtime_llvm_decls.h>\n" } else { "#include <runtime_llvm.c>\n" },
  "#if defined(__clang__)\n#pragma clang diagnostic ignored \"-Wunused-label\"\n#pragma clang diagnostic ignored \"-Wunused-but-set-variable\"\n#elif defined(__GNUC__)\n#pragma GCC diagnostic ignored \"-Wunused-label\"\n#pragma GCC diagnostic ignored \"-Wunused-but-set-variable\"\n#endif\n",
  "#ifdef __APPLE__\n#define KC_ASM(s) \"_\" s\n#else\n#define KC_ASM(s) s\n#endif\n",
  "#if defined(__clang__)\n#define KC_MUSTTAIL __attribute__((musttail))\n#define KC_TAIL_FN\n#elif defined(__GNUC__) && __GNUC__ >= 15\n#define KC_MUSTTAIL [[gnu::musttail]]\n#define KC_TAIL_FN __attribute__((noinline))\n#else\n#define KC_MUSTTAIL\n#define KC_TAIL_FN\n#endif\n",
  "#define KD(x) kaix_internal_drop(x)\n#define KU(x) kaix_internal_dup(x)\n",
  "static inline int kc_unsupported(const char *m) { fprintf(stderr, \"kaikai: unsupported: %s\\n\", m); abort(); return 0; }\n"
])

# ---- the base context --------------------------------------------------------

fn kcg_base(kp: KProgram, decls: [Decl]) : KcCx = {
  let nm = kp_names(kp)
  let frames = frames_index(build_evidence_frames(decls, kp.entry))
  KcCx { tab: kp.tab, nm: nm, fx: nfnx_build(kp.fns, nm, kp.ids, frames),
         hs: list_append(kp.handlers, ndef_synth_handlers(kp.tab, kp.synth_defaults)),
         defs: kp.synth_defaults, cur: "", regs: idx_empty(), evf_pass: false }
}

fn kcg_is_ffi(f: KFn) : Bool = match f.kind {
  KFnFfi(_, _, _) -> true
  _ -> false
}

fn kcg_is_normal(f: KFn) : Bool = match f.kind {
  KFnNormal -> true
  _ -> false
}

fn kcg_sym_index(nm: KNames, fns: [KFn]) : NameIndex[String] = kcg_sym_index_loop(nm, fns, idx_empty())

fn kcg_sym_index_loop(nm: KNames, fns: [KFn], ix: NameIndex[String]) : NameIndex[String] = match fns {
  [] -> ix
  [f, ...rest] -> {
    let s = nfn_sym(nm, f)
    kcg_sym_index_loop(nm, rest, idx_prepend(ix, s, s))
  }
}

# ---- forward declarations ------------------------------------------------------

fn kcg_boxed_params(n: Int) : String =
  if n == 0 { "void" } else { string_join(map(kcg_n_list(0, n), (_u) => "KaiValue *"), ", ") }

fn kcg_n_list(i: Int, n: Int) : [Int] = if i >= n { [] } else { [i, ...kcg_n_list(i + 1, n)] }

fn kcg_proto(base: KcCx, ps: KcFnPrinters, f: KFn) : String = {
  let sym = nfn_sym(base.nm, f)
  if kcg_is_ffi(f) { concat_all(["KaiValue *", sym, "(", kcf_boxed_params(not list_is_empty(nfnx_frame_keys(base.fx, f)), list_length(f.params)), ");\n"]) }
  else { ps.proto(kc_cx_head(base, sym), f) }
}

fn kcg_thunk_proto(f: KFn, base: KcCx, valued: NameIndex[String]) : String = {
  let t = c_user_thunk_sym(kfn_sym(base.nm, f))
  if (kcg_is_normal(f) or kcg_is_ffi(f)) and nrefs_valued(valued, t) { concat_all(["KaiValue *", t, "(KaiValue *p_self, KaiValue **p_args, int p_n);\n"]) }
  else { "" }
}

# ---- default evidence ------------------------------------------------------------

fn kcg_default_globals(tab: SymTab, d: KDefault) : String = match d {
  KDef(esym, ops) -> {
    let eff = rt_name(tab, esym)
    concat_all([
      "static int64_t _kai_default_ev_", eff, "[", int_to_string(nfx_op_base() + list_length(ops)), "] __attribute__((aligned(16)));\n",
      "static int64_t _kai_default_node_", eff, "[", int_to_string(nfx_node_slots()), "] __attribute__((aligned(16)));\n"
    ])
  }
}

fn kcg_op_set(ev: String, i: Int, op: KDefOp) : String = match op {
  KDOp(_, sym, _) ->
    concat_all(["    ", kc_call("kaix_ev_set_op", [ev, int_to_string(nfx_op_base() + i), cat2("(void *)", sym)]), ";\n"])
}

fn kcg_op_sets(ev: String, ops: [KDefOp], i: Int) : [String] = match ops {
  [] -> []
  [op, ...rest] -> [kcg_op_set(ev, i, op), ...kcg_op_sets(ev, rest, i + 1)]
}

fn kcg_install_one(tab: SymTab, d: KDefault) : String = match d {
  KDef(esym, ops) -> {
    let eff = rt_name(tab, esym)
    let ev = cat2("_kai_default_ev_", eff)
    let node = cat2("(KaiEvidence *)_kai_default_node_", eff)
    concat_all([
      "    {\n        static const char *lbl;\n",
      "        ", kc_call("kaix_ev_set_handler_id", [ev, "kaix_fresh_handler_id()"]), ";\n",
      concat_all(kcg_op_sets(ev, ops, 0)),
      "        ", kc_call("kaix_evidence_init_default_l", [node, kc_call("kaix_eff_label", ["&lbl", kc_cstr(eff)]), ev]), ";\n",
      "    }\n"
    ])
  }
}

# A forwarder the runtime defines (`kaix_`) or the program defines is already declared.
fn kcg_op_decl(declared: NameIndex[String], op: KDefOp) : String = match op {
  KDOp(_, sym, n) ->
    if (string_length(sym) >= 5 and string_slice(sym, 0, 5) == "kaix_") or list_has(idx_chain(declared, sym), sym) { "" }
    else { concat_all(["KaiValue *", sym, "(", kcg_boxed_params(n), ");\n"]) }
}

fn kcg_default_decls(declared: NameIndex[String], d: KDefault) : String = match d {
  KDef(_, ops) -> concat_all(map(ops, (op) => kcg_op_decl(declared, op)))
}

fn kcg_defaults_hooks(tab: SymTab, defaults: [KDefault]) : String = concat_all([
  "void kai_main_install_defaults(void) {\n",
  concat_all(map(defaults, (d) => kcg_install_one(tab, d))),
  "}\nvoid kai_main_teardown_defaults(void) {\n}\n"
])

# ---- the runner driver -----------------------------------------------------------

fn kcg_runner_call(base: KcCx, r: KRunner) : String = {
  let desc = kc_cstr(nemit_decode_span(r.desc))
  match r.kind {
    KRCheck(specs) ->
      concat_all(["    ", kc_call("kaix_check_run_one", [desc, kc_cstr(string_join(specs, ";")),
                                                       cat2("(KaiFn)", c_user_thunk_sym(r.sym))]), ";\n"])
    KRTest ->
      concat_all(["    ", kc_call("kaix_test_register", [desc, r.sym, int_to_string(r.line), kc_cstr(r.home)]), ";\n"])
    KRBench ->
      concat_all(["    ", kc_call("kaix_bench_run_one", [desc, r.sym]), ";\n"])
  }
}

fn kcg_runner_driver(base: KcCx, runners: [KRunner], bmode: BuildMode) : String =
  if nemit_is_runner_mode(bmode) {
    concat_all([
      "KaiValue *kai_main(void) {\n",
      concat_all(map(filter(runners, (r) => nrunner_in_mode(r.kind, bmode)), (r) => kcg_runner_call(base, r))),
      match bmode {
        BMTest -> "    kaix_test_drive();\n"
        _ -> ""
      },
      "    ", ndriver_exit_sym(bmode), "();\n    return NULL;\n}\n"
    ])
  } else { "" }

# ---- definitions -------------------------------------------------------------------

fn kcg_thunk_if_valued(base: KcCx, ps: KcFnPrinters, valued: NameIndex[String], cx: KcCx, f: KFn) : String =
  if nrefs_valued(valued, c_user_thunk_sym(kfn_sym(base.nm, f))) { ps.thunk(cx, f) } else { "" }

fn kcg_def(base: KcCx, ps: KcFnPrinters, valued: NameIndex[String], f: KFn) : String = {
  let sym = nfn_sym(base.nm, f)
  let cx = kc_cx_head(base, sym)
  match f.kind {
    KFnFfi(csym, pks, rk) -> cat2(kc_ffi_fn(cx, f, csym, pks, rk), kcg_thunk_if_valued(base, ps, valued, cx, f))
    _ -> cat2(ps.def(cx, f), kcg_thunk_if_valued(base, ps, valued, cx, f))
  }
}

#[doc("The whole single-translation-unit C text of the program: prelude, forward declarations, default evidence, fn definitions, runtime hooks, protocol tables, the runner driver in a test, bench or check build, exports.")]
pub fn kc_program(kp: KProgram, ps: KcFnPrinters, bmode: BuildMode, decls: [Decl], nfns: [EFn], nvariants: [VariantEntry], owner: Bool) : String = {
  let base = kcg_base(kp, decls)
  let valued = ndecl_valued(kp)
  let declared = kcg_sym_index(base.nm, kp.fns)
  let defaults = nemit_entry_defaults(kp, bmode)
  let pieces = [
    kcg_prelude(owner),
    concat_all(map(kp.fns, (f) => kcg_proto(base, ps, f))),
    concat_all(map(kp.fns, (f) => kcg_thunk_proto(f, base, valued))),
    concat_all(map(kp.synth_defaults, (d) => kcg_default_decls(declared, d))),
    concat_all(map(kp.synth_defaults, (d) => kcg_default_globals(kp.tab, d))),
    concat_all(map(kp.fns, (f) => kcg_def(base, ps, valued, f))),
    kcg_defaults_hooks(kp.tab, defaults),
    kc_proto_section(decls, kp.tab, kp.ids, nvariants, nfns, kp.reuse_tags, declared),
    kcg_runner_driver(base, kp.runners, bmode),
    kc_exports(kp.exports, (s) => c_user_thunk_sym(s))
  ]
  concat_all(pieces)
}

# ---- separate translation units ----------------------------------------------------

#[doc("One translation unit of the separately compiled program: the stem it is named by and its C text.")]
pub type KcTu = { stem: String, header: String, body: String }

#[doc("The program split by module: one unit per module, each with the header slice it includes, the root unit holding the program-wide definitions.")]
pub type KcModular = { tus: [KcTu] }

type KcSymText = KST(String, String)

type KcStemFn = KSF(String, KFn)

fn kcg_stem(mo: Option[String]) : String = match mo {
  None    -> "__root__"
  Some(m) -> string_join(string_split(m, "."), "_")
}

fn kcg_default_extern(tab: SymTab, d: KDefault) : String = match d {
  KDef(esym, ops) -> {
    let eff = rt_name(tab, esym)
    concat_all([
      "extern int64_t _kai_default_ev_", eff, "[", int_to_string(nfx_op_base() + list_length(ops)), "];\n",
      "extern int64_t _kai_default_node_", eff, "[", int_to_string(nfx_node_slots()), "];\n"
    ])
  }
}

fn kcg_default_defs(tab: SymTab, d: KDefault) : String = match d {
  KDef(esym, ops) -> {
    let eff = rt_name(tab, esym)
    concat_all([
      "int64_t _kai_default_ev_", eff, "[", int_to_string(nfx_op_base() + list_length(ops)), "] __attribute__((aligned(16)));\n",
      "int64_t _kai_default_node_", eff, "[", int_to_string(nfx_node_slots()), "] __attribute__((aligned(16)));\n"
    ])
  }
}

type KcGroup = { ix: NameIndex[KcStemFn], seen: NameIndex[String], stems: [String] }

fn kcg_group(fns: [KFn], g: KcGroup) : KcGroup = match fns {
  [] -> KcGroup { ix: g.ix, seen: g.seen, stems: list_reverse(g.stems) }
  [f, ...rest] -> {
    let st = kcg_stem(f.mo)
    let fresh = not list_has(idx_chain(g.seen, st), st)
    kcg_group(rest, KcGroup {
      ix: idx_prepend(g.ix, st, KSF(st, f)),
      seen: if fresh { idx_prepend(g.seen, st, st) } else { g.seen },
      stems: if fresh { [st, ...g.stems] } else { g.stems } })
  }
}

fn kcg_stem_fns(g: KcGroup, st: String) : [KFn] = list_reverse(kcg_stem_fns_in(idx_chain(g.ix, st), st))

fn kcg_stem_fns_in(es: [KcStemFn], st: String) : [KFn] = match es {
  [] -> []
  [KSF(n, f), ...rest] -> if n == st { [f, ...kcg_stem_fns_in(rest, st)] } else { kcg_stem_fns_in(rest, st) }
}

fn kcg_sym_texts(base: KcCx, ps: KcFnPrinters, valued: NameIndex[String], fns: [KFn], ix: NameIndex[KcSymText]) : NameIndex[KcSymText] = match fns {
  [] -> ix
  [f, ...rest] -> {
    let k = kfn_sym(base.nm, f)
    let t = kcg_thunk_proto(f, base, valued)
    let ix1 = idx_prepend(ix, k, KST(k, kcg_proto(base, ps, f)))
    kcg_sym_texts(base, ps, valued, rest, if t == "" { ix1 } else { idx_prepend(ix1, c_user_thunk_sym(k), KST(c_user_thunk_sym(k), t)) })
  }
}

fn kcg_text_of(ix: NameIndex[KcSymText], sym: String) : String = kcg_text_pick(idx_chain(ix, sym), sym)

fn kcg_text_pick(es: [KcSymText], sym: String) : String = match es {
  [] -> ""
  [KST(n, t), ...rest] -> if n == sym { t } else { kcg_text_pick(rest, sym) }
}

fn kcg_stem_refs(fns: [KFn], hs: [KHandlerDecl], seen: NameIndex[String], acc: [String]) : [String] = match fns {
  [] -> acc
  [f, ...rest] -> {
    let r = kcg_refs_fresh(kfn_refs(f, hs), seen, acc)
    kcg_stem_refs(rest, hs, r.seen, r.acc)
  }
}

type KcRefAcc = { seen: NameIndex[String], acc: [String] }

fn kcg_refs_fresh(rs: [String], seen: NameIndex[String], acc: [String]) : KcRefAcc = match rs {
  [] -> KcRefAcc { seen: seen, acc: acc }
  [r, ...rest] ->
    if list_has(idx_chain(seen, r), r) { kcg_refs_fresh(rest, seen, acc) }
    else { kcg_refs_fresh(rest, idx_prepend(seen, r, r), [r, ...acc]) }
}

fn kcg_own_syms(base: KcCx, fns: [KFn]) : [String] = map(fns, (f) => kfn_sym(base.nm, f))

fn kcg_slice(base: KcCx, hs: [KHandlerDecl], texts: NameIndex[KcSymText], fns: [KFn]) : String = {
  let refs = kcg_stem_refs(fns, hs, idx_empty(), kcg_own_syms(base, fns))
  let own_thunks = map(kcg_own_syms(base, fns), c_user_thunk_sym)
  concat_all(map(sort_by(list_append(refs, own_thunks), (a, b) => if a < b { 0 - 1 } else if a == b { 0 } else { 1 }), (sy) => kcg_text_of(texts, sy)))
}

#[doc("As `kc_program`, split by module for separate compilation: each unit includes a header slice (prelude, the prototypes its fns name, `extern` default evidence); a module's unit defines its fns, and the root unit also holds the program-wide definitions (default evidence, hooks, protocol tables, the runner driver, exports) and sees every prototype.")]
pub fn kc_program_modular(kp: KProgram, ps: KcFnPrinters, bmode: BuildMode, decls: [Decl], nfns: [EFn], nvariants: [VariantEntry]) : KcModular = {
  let base = kcg_base(kp, decls)
  let valued = ndecl_valued(kp)
  let declared = kcg_sym_index(base.nm, kp.fns)
  let defaults = nemit_entry_defaults(kp, bmode)
  let texts = kcg_sym_texts(base, ps, valued, kp.fns, idx_empty())
  let g = kcg_group(kp.fns, KcGroup { ix: idx_empty(), seen: idx_empty(), stems: [] })
  let root = kcg_stem(None)
  let stems = if list_has(g.stems, root) { g.stems } else { [root, ...g.stems] }
  let common = concat_all([
    kcg_prelude(true),
    concat_all(map(kp.synth_defaults, (d) => kcg_default_decls(declared, d))),
    concat_all(map(kp.synth_defaults, (d) => kcg_default_extern(kp.tab, d)))
  ])
  let root_header = concat_all([common, concat_all(map(kp.fns, (f) => kcg_proto(base, ps, f))), concat_all(map(kp.fns, (f) => kcg_thunk_proto(f, base, valued)))])
  let root_extra = concat_all([
    concat_all(map(kp.synth_defaults, (d) => kcg_default_defs(kp.tab, d))),
    kcg_defaults_hooks(kp.tab, defaults),
    kc_proto_section(decls, kp.tab, kp.ids, nvariants, nfns, kp.reuse_tags, declared),
    kcg_runner_driver(base, kp.runners, bmode),
    kc_exports(kp.exports, (s) => c_user_thunk_sym(s))
  ])
  KcModular { tus: map(stems, (st) => {
    let fns = kcg_stem_fns(g, st)
    let body = concat_all(map(fns, (f) => kcg_def(base, ps, valued, f)))
    if st == root { KcTu { stem: st, header: root_header, body: cat2(body, root_extra) } }
    else { KcTu { stem: st, header: cat2(common, kcg_slice(base, kp.handlers, texts, fns)), body: body } }
  }) }
}
