# compiler/cell_scan.kai — residual-use scan for the var-cell promotion.
#
# After `cell_promote` rewrites a slot's sanctioned `array_get`/`array_set`
# uses into `__cell_*` intrinsics, any read of the binder left in its
# scope is an unsanctioned use and must revert the promotion. This walk
# answers exactly that question.

import compiler.ast
import compiler.written

# --- residual-use check ----------------------------------------------

# True when the binder `slot` is still read after the sanctioned-use
# rewrite. The match is EXHAUSTIVE on purpose — a defaulted `_ -> false`
# here would silently skip uses hiding in a future ExprKind (the trap
# the loop-lowering scanners hit).
pub fn cp_uses(slot: Binder, e: Expr) : Bool = match e.kind {
  EInt(_, _)        -> false
  EReal(_, _)       -> false
  EIntLit(_)        -> false
  EDecimalLit(_)    -> false
  EFixed(_, _)      -> false
  EBool(_)          -> false
  EChar(_)          -> false
  EStr(_, _)        -> false
  EUnit             -> false
  ELocal(l)         -> local_eq(l, slot.id)
  EName(_)          -> false
  EMark(_)          -> false
  ESym(_, _)        -> false
  # An operation through an alias or a receiver reads that local.
  EOp(r)            -> match r.via {
    ViaAmbient  -> false
    ViaAlias(a) -> local_eq(a, slot.id)
    ViaRecv(x)  -> local_eq(x, slot.id)
  }
  EUnder            -> false
  EPlaceholder      -> false
  EHole(_)          -> false
  ETodo(_)          -> false
  EExternBody(_, _) -> false
  EVariantsOf(_, _) -> false
  EModCall(_, _)    -> false
  EIntrinsic(inm, xs) -> cp_exprs_use(slot, cp_intrinsic_operands(inm, xs))
  ESurface(sf) -> cp_exprs_use(slot, surface_children(sf))
  ECall(c, xs)      -> cp_uses(slot, c) or cp_exprs_use(slot, xs)
  EField(b, _)      -> cp_uses(slot, b)
  EIndex(a, b)      -> cp_exprs_use(slot, [a, b])
  EBinop(_, a, b)   -> cp_exprs_use(slot, [a, b])
  EUnop(_, x)       -> cp_uses(slot, x)
  EIf(c, t, eo)     -> cp_exprs_use(slot, [c, t]) or cp_opt_uses(slot, eo)
  EMatch(scr, arms) -> cp_uses(slot, scr) or cp_arms_use(slot, arms)
  ELambda(_, b)     -> cp_uses(slot, b)
  ERecordLit(_, fs) -> cp_fields_use(slot, fs)
  EList(els)        -> cp_elems_use(slot, els)
  ERange(a, b, st)  -> cp_exprs_use(slot, [a, b]) or cp_opt_uses(slot, st)
  EBlock(ss, tl)    -> cp_stmts_use(slot, ss) or cp_opt_uses(slot, tl)
  EPipe(a, b)       -> cp_exprs_use(slot, [a, b])
  EMapPipe(a, b)    -> cp_exprs_use(slot, [a, b])
  EFlatMapPipe(a, b) -> cp_exprs_use(slot, [a, b])
  EFilterPipe(a, b) -> cp_exprs_use(slot, [a, b])
  EHandle(body, _, _, init, _, cs, ret) -> cp_handle_uses(slot, body, init, cs, ret)
  ELitUnit(x, _)    -> cp_uses(slot, x)
  EBang(x)          -> cp_uses(slot, x)
}

fn cp_handle_uses(slot: Binder, body: Expr, init: Option[Expr], cs: [HClause],
                  ret: Option[HReturn]) : Bool =
  cp_uses(slot, body) or cp_opt_uses(slot, init) or cp_clauses_use(slot, cs) or cp_ret_uses(slot, ret)

fn cp_exprs_use(slot: Binder, es: [Expr]) : Bool = match es {
  []           -> false
  [h, ...rest] -> cp_uses(slot, h) or cp_exprs_use(slot, rest)
}

pub fn cp_opt_uses(slot: Binder, o: Option[Expr]) : Bool = match o {
  Some(e) -> cp_uses(slot, e)
  None    -> false
}

fn cp_arms_use(slot: Binder, arms: [Arm]) : Bool = match arms {
  []           -> false
  [a, ...rest] -> (match a {
    Arm(_, g, b) -> cp_opt_uses(slot, g) or cp_uses(slot, b)
  }) or cp_arms_use(slot, rest)
}

fn cp_fields_use(slot: Binder, fs: [FieldInit]) : Bool = match fs {
  []            -> false
  [fi, ...rest] -> (match fi { FI(_, v) -> cp_uses(slot, v) }) or cp_fields_use(slot, rest)
}

fn cp_elems_use(slot: Binder, els: [ListElem]) : Bool = match els {
  []            -> false
  [el, ...rest] -> (match el {
    ElPlain(e)  -> cp_uses(slot, e)
    ElSpread(e) -> cp_uses(slot, e)
  }) or cp_elems_use(slot, rest)
}

fn cp_clauses_use(slot: Binder, cs: [HClause]) : Bool = match cs {
  []           -> false
  [c, ...rest] -> (match c { HC(_, _, b, _, _) -> cp_uses(slot, b) }) or cp_clauses_use(slot, rest)
}

fn cp_ret_uses(slot: Binder, ret: Option[HReturn]) : Bool = match ret {
  None -> false
  Some(hr) -> match hr { HR(_, b, _, _) -> cp_uses(slot, b) }
}

pub fn cp_stmts_use(slot: Binder, ss: [Stmt]) : Bool = match ss {
  []           -> false
  [s, ...rest] -> cp_stmt_uses(slot, s) or cp_stmts_use(slot, rest)
}

fn cp_stmt_uses(slot: Binder, s: Stmt) : Bool = match s {
  SLet(_, _, rhs)             -> cp_uses(slot, rhs)
  SAssert(c, m)               -> cp_uses(slot, c) or cp_opt_uses(slot, m)
  SExprStmt(x)                -> cp_uses(slot, x)
  SIndexAssign(b, i, v, _, _) -> cp_uses(slot, b) or cp_uses(slot, i) or cp_uses(slot, v)
  SAssign(b, v, _, _) -> cp_uses(slot, b) or cp_uses(slot, v)
  SVar(_, _, rhs, _, _)       -> cp_uses(slot, rhs)
  SUse(_, _, _)               -> false
}

# A cell read or write names its cell by its first argument, which is not a use.
fn cp_intrinsic_operands(i: Intrinsic, xs: [Expr]) : [Expr] = match i {
  InCellGet -> cp_tail(xs)
  InCellSet -> cp_tail(xs)
  _         -> xs
}

fn cp_tail(xs: [Expr]) : [Expr] = match xs {
  [_, ...rest] -> rest
  []           -> []
}
