#[doc("""
C FFI shims: scalar and boundary-type bridge bodies, typedefs and protocol-dispatch shims.

compiler/emit_ffi_c.kai — C-direct shim synthesis for boundary types.

Extends the scalar shim (emit_c.kai's `emit_ffi_shim_body`) with:
  - fixed-width boundary scalars (U8..F32) — C-cast at the call;
  - struct-by-value — unwrap the KAI_RECORD box into a local C struct
    with correct C field widths, pass by value, re-box on return;
  - opaque handles — pass `kai_foreign_ptr(box)` as `void *`, re-box
    a returned pointer with `kai_foreign`.

The C struct layout lives in a `typedef struct { ... } <Name>;` emitted
into the shared `kai_ffi.h` (`emit_ffi_struct_typedefs`); `out.c`
includes it and a hand-written shim includes the SAME header, so both
name one nominal type (the C compiler catches a layout mismatch instead
of corrupting the value silently). Own-and-release discipline: boxed
inputs are decref'd AFTER the extern returns (a struct/string field
unboxed to a borrow must outlive the call).

FFI bridge and protocol-dispatch shim bodies.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.core_refs
import compiler.emit_shared_proto
import compiler.emit_shared_rows
import compiler.emit_shared_syms
import compiler.extern_fn_types
import compiler.local_names
import compiler.symtab
import compiler.util
import compiler.written

# Emit one C `typedef struct { ... } <Name>;` per extern struct in the
# registry, for the shared `kai_ffi.h`. Opaque handles need no typedef
# (they cross as `void *`).
#[doc("Emit the C struct typedefs for every `extern \"C\" type` in the registry; `tab` names a field type already settled.")]
pub fn emit_ffi_struct_typedefs(reg: [ExternTypeReg], tab: SymTab) : String = match reg {
  [] -> ""
  [e, ...rest] -> match e {
    ExtStruct(s, fields) -> cat2(emit_ffi_one_struct_typedef(extern_struct_c_tag(tab, s), fields, reg, tab),
                                    emit_ffi_struct_typedefs(rest, tab))
    ExtOpaque(_) -> emit_ffi_struct_typedefs(rest, tab)
  }
}

#[doc("The shared FFI header filename a struct-by-value shim `#include`s.")]
pub fn ffi_header_name() : String = "kai_ffi.h"

# An opaque crosses as `void *` and needs no typedef, so only a struct triggers the header.
#[doc("Whether the registry holds an `extern \"C\" type` struct.")]
pub fn has_ffi_struct(reg: [ExternTypeReg]) : Bool = match reg {
  [] -> false
  [e, ...rest] -> match e { ExtStruct(_, _) -> true  ExtOpaque(_) -> has_ffi_struct(rest) }
}

#[doc("The text of `kai_ffi.h` for the registry's structs; empty when it holds none.")]
pub fn ffi_header_text(reg: [ExternTypeReg], tab: SymTab) : String =
  if has_ffi_struct(reg) {
    concat_all([
      "/* generated by kaikai stage 2 — shared FFI struct header */\n",
      "#ifndef KAI_FFI_H\n#define KAI_FFI_H\n#include <stdint.h>\n\n",
      emit_ffi_struct_typedefs(reg, tab),
      "\n#endif /* KAI_FFI_H */\n"
    ])
  } else {
    ""
  }

#[doc("Write `kai_ffi.h` to `path` when the registry holds a struct, else remove a file left there; nothing when `path` is empty.")]
pub fn write_ffi_header(path: String, reg: [ExternTypeReg], tab: SymTab) : Unit / File =
  if path == "" {
    ()
  } else if has_ffi_struct(reg) {
    let _ = __file_write(path, ffi_header_text(reg, tab))
  } else {
    let _ = __file_delete(path)
  }

# A `typedef struct { ... } <Name>;` over the declared name. Every
# reference (shim param/return/local, the extern forward-decl) uses the
# bare `<Name>` (`extern_struct_c_tag`), so `out.c` and a shim that
# `#include`s `kai_ffi.h` share one nominal C type — a layout mismatch is
# a C compile error, not silent boundary corruption.
fn emit_ffi_one_struct_typedef(name: String, fields: [FieldDecl], reg: [ExternTypeReg], tab: SymTab) : String =
  concat_all([
    "typedef struct {\n",
    emit_ffi_struct_fields(fields, reg, tab),
    "} ", name, ";\n"
  ])

fn emit_ffi_struct_fields(fields: [FieldDecl], reg: [ExternTypeReg], tab: SymTab) : String = match fields {
  [] -> ""
  [fd, ...rest] -> match fd {
    FD(_, fname, _, _) -> concat_all([
      "    ", extern_field_c_type(fd, reg, tab), " ", fname, ";\n",
      emit_ffi_struct_fields(rest, reg, tab)
    ])
  }
}

# The v2 shim body. `reg` resolves struct/opaque param + return kinds.
# Falls back to nothing special for the v1 scalar kinds (the caller
# handles those via the v1 path — this is only reached for a fn that
# mentions at least one v2 type).
#[doc("Synthesise the C body of an `extern \"C\" fn` whose signature uses an FFI v2 type (struct / opaque / fixed-width).")]
pub fn emit_ffi_v2_shim_body(sig: String, cname: String, params: [Param],
                             ret_ty_opt: Option[TypeExpr], reg: [ExternTypeReg], tab: SymTab, ns: LocalNames) : String {
  let ret_kind = ffi_ret_kind_of_reg(ret_ty_opt, reg, tab)
  let extern_decl = ffi_v2_extern_decl(cname, params, ret_kind, reg, tab)
  let arg_setup = ffi_v2_arg_setup(params, 0, reg, tab, ns)
  let arg_list = ffi_v2_arg_list(params, 0)
  let call_expr = concat_all([cname, "(", arg_list, ")"])
  # Callee-owns: the shim decrefs each boxed input after the call. An
  # opaque handle's box is the deconstructor's job here — the shim reads
  # the void* and releases the box, so a handle threaded through several
  # calls is dup'd before each non-final call and moved on the last.
  let body = ffi_v2_ret_body(ret_kind, call_expr, arg_setup, ffi_v2_arg_decrefs(params, 0, reg, tab, ns), reg, tab)
  concat_all([extern_decl, sig, " {\n", body, "}\n\n"])
}

# Release each boxed input after the call. A Unit param carries no boxed
# value (elided in arg setup), so it is skipped.
pub(pkg) fn ffi_v2_arg_decrefs(params: [Param], i: Int, reg: [ExternTypeReg], tab: SymTab, ns: LocalNames) : String = match params {
  [] -> ""
  [p, ...rest] -> {
    let kind = match p.ptype { None -> FfiRetUnknown("") Some(t) -> ffi_kind_of_ty_reg(t, reg, tab) }
    let head = match kind {
      FfiRetUnit -> ""
      _          -> concat_all(["    kai_decref(", c_local(ln_emitted(ns, p.binder.id)), ");\n"])
    }
    cat2(head, ffi_v2_arg_decrefs(rest, i + 1, reg, tab, ns))
  }
}

# A v2 shim DOES forward-declare the extern symbol: a struct/opaque
# signature has no libc equivalent, so the C compiler needs the
# prototype with the right struct-by-value / void* shape to lay out
# the call ABI.
fn ffi_v2_extern_decl(cname: String, params: [Param], ret_kind: FfiRetKind,
                      reg: [ExternTypeReg], tab: SymTab) : String =
  concat_all([
    "extern ", ffi_v2_c_ret_type(ret_kind, tab), " ", cname,
    "(", ffi_v2_c_param_list(params, reg, tab), ");\n"
  ])

fn ffi_v2_c_param_list(params: [Param], reg: [ExternTypeReg], tab: SymTab) : String = match params {
  [] -> "void"
  _  -> join_with(map(params, (p) => ffi_v2_c_param_type(p, reg, tab)), ", ")
}

fn ffi_v2_c_param_type(p: Param, reg: [ExternTypeReg], tab: SymTab) : String = match p.ptype {
  None    -> "void *"
  Some(t) -> ffi_v2_c_type(ffi_kind_of_ty_reg(t, reg, tab), tab)
}

pub(pkg) fn ffi_v2_c_ret_type(k: FfiRetKind, tab: SymTab) : String = match k {
  FfiRetUnit -> "void"
  _          -> ffi_v2_c_type(k, tab)
}

# The C type for one v2 kind. Struct → the `kai_ffi.h` `typedef` name,
# opaque → `void *`, fixed-width → its C scalar, v1 scalars unchanged.
pub(pkg) fn ffi_v2_c_type(k: FfiRetKind, tab: SymTab) : String = match k {
  FfiRetUnit       -> "void"
  FfiRetInt        -> "int64_t"
  FfiRetReal       -> "double"
  FfiRetBool       -> "int"
  FfiRetChar       -> "int32_t"
  FfiRetString     -> "const char *"
  FfiRetFixed(fx)  -> ffi_fixed_c_type(fx)
  FfiRetFixedVal(t) -> fixed_val_c_type(t)
  FfiRetStruct(s)  -> extern_struct_c_tag(tab, s)
  FfiRetForeign(_) -> "void *"
  FfiRetUnknown(_) -> "void *"
}

# Per-param: unbox the boxed kaikai arg into a C local `_kai_ffi_argN`
# of the matching C type. A struct unwraps field-by-field into a C
# struct literal; an opaque reads `kai_foreign_ptr`; a fixed-width
# C-casts the underlying Int/Real; v1 scalars match the v1 shim.
pub(pkg) fn ffi_v2_arg_setup(params: [Param], i: Int, reg: [ExternTypeReg], tab: SymTab, ns: LocalNames) : String = match params {
  [] -> ""
  [p, ...rest] -> {
    let kind = match p.ptype {
      None    -> FfiRetUnknown("missing")
      Some(t) -> ffi_kind_of_ty_reg(t, reg, tab)
    }
    let arg = concat_all(["_kai_ffi_arg", int_to_string(i)])
    let box = c_local(ln_emitted(ns, p.binder.id))
    let stmt = ffi_v2_unbox_one(kind, arg, box, reg, tab)
    cat2(stmt, ffi_v2_arg_setup(rest, i + 1, reg, tab, ns))
  }
}

pub(pkg) fn ffi_v2_unbox_one(kind: FfiRetKind, arg: String, box: String, reg: [ExternTypeReg], tab: SymTab) : String = match kind {
  FfiRetInt    -> concat_all(["    int64_t ", arg, " = kai_intf(", box, ");\n"])
  FfiRetReal   -> concat_all(["    double ", arg, " = ", box, "->as.r;\n"])
  FfiRetBool   -> concat_all(["    int ", arg, " = ", box, "->as.b ? 1 : 0;\n"])
  FfiRetChar   -> concat_all(["    int32_t ", arg, " = (int32_t) ", box, "->as.c;\n"])
  FfiRetString -> concat_all(["    const char *", arg, " = ", box, "->as.s.bytes;\n"])
  FfiRetUnit   -> concat_all(["    /* Unit arg elided */\n"])
  FfiRetFixed(fx) ->
    if ffi_fixed_is_float(fx) {
      concat_all(["    ", ffi_fixed_c_type(fx), " ", arg, " = (", ffi_fixed_c_type(fx), ") ", box, "->as.r;\n"])
    } else {
      concat_all(["    ", ffi_fixed_c_type(fx), " ", arg, " = (", ffi_fixed_c_type(fx), ") kai_intf(", box, ");\n"])
    }
  FfiRetFixedVal(t) ->
    concat_all(["    ", fixed_val_c_type(t), " ", arg, " = ", box, fixed_val_box_field(t), ";\n"])
  FfiRetForeign(_) -> concat_all(["    void *", arg, " = kai_foreign_ptr(", box, ");\n"])
  FfiRetStruct(s)  -> ffi_v2_unbox_struct(s, arg, box, reg, tab)
  FfiRetUnknown(t) -> concat_all(["#error \"FFI arg type `", t, "` is not supported\"\n"])
}

# Unwrap a boxed record into a C struct literal. Each field is read by
# name (`kai_record_get_borrow`) and unboxed at its C width.
fn ffi_v2_unbox_struct(s: SymId, arg: String, box: String, reg: [ExternTypeReg], tab: SymTab) : String {
  let fields = extern_struct_fields(reg, s)
  concat_all([
    "    ", extern_struct_c_tag(tab, s), " ", arg, " = { ",
    ffi_v2_struct_field_inits(fields, box, reg, tab), " };\n"
  ])
}

fn ffi_v2_struct_field_inits(fields: [FieldDecl], box: String, reg: [ExternTypeReg], tab: SymTab) : String = match fields {
  [] -> ""
  [fd] -> ffi_v2_struct_field_init(fd, box, reg, tab)
  [fd, ...rest] -> concat_all([ffi_v2_struct_field_init(fd, box, reg, tab), ", ",
                               ffi_v2_struct_field_inits(rest, box, reg, tab)])
}

fn ffi_v2_struct_field_init(fd: FieldDecl, box: String, reg: [ExternTypeReg], tab: SymTab) : String = match fd {
  FD(_, fname, fty, _) -> {
    let fbox = concat_all(["kai_op_field_borrow(", box, ", \"", fname, "\")"])
    let kind = ffi_kind_of_ty_reg(fty, reg, tab)
    ffi_v2_field_read(kind, fbox)
  }
}

# Read one boxed field at its C width (a borrow — the struct value
# copies it, the box keeps owning the cell).
fn ffi_v2_field_read(kind: FfiRetKind, fbox: String) : String = match kind {
  FfiRetInt    -> concat_all(["kai_intf(", fbox, ")"])
  FfiRetReal   -> concat_all([fbox, "->as.r"])
  FfiRetBool   -> concat_all([fbox, "->as.b ? 1 : 0"])
  FfiRetFixed(fx) ->
    if ffi_fixed_is_float(fx) { concat_all(["(", ffi_fixed_c_type(fx), ") ", fbox, "->as.r"]) }
    else { concat_all(["(", ffi_fixed_c_type(fx), ") kai_intf(", fbox, ")"]) }
  FfiRetFixedVal(t) -> concat_all([fbox, fixed_val_box_field(t)])
  _ -> concat_all(["/* unsupported struct field */ 0"])
}

fn ffi_v2_arg_list(params: [Param], i: Int) : String = match params {
  [] -> ""
  [_, ...rest] -> {
    let head = concat_all(["_kai_ffi_arg", int_to_string(i)])
    match rest {
      [] -> head
      _  -> concat_all([head, ", ", ffi_v2_arg_list(rest, i + 1)])
    }
  }
}

# Re-box the C return into a fresh KaiValue. A struct copies into a
# KAI_RECORD; an opaque parks the pointer in a KAI_FOREIGN; fixed-width
# widens to Int/Real; v1 scalars unchanged.
pub(pkg) fn ffi_v2_ret_body(ret_kind: FfiRetKind, call_expr: String, arg_setup: String,
                   arg_decrefs: String, reg: [ExternTypeReg], tab: SymTab) : String = match ret_kind {
  FfiRetUnit -> concat_all([arg_setup, "    ", call_expr, ";\n", arg_decrefs, "    return kai_unit();\n"])
  FfiRetInt -> concat_all([arg_setup, "    int64_t _kai_ffi_ret = (int64_t) ", call_expr, ";\n", arg_decrefs, "    return kai_int(_kai_ffi_ret);\n"])
  FfiRetReal -> concat_all([arg_setup, "    double _kai_ffi_ret = (double) ", call_expr, ";\n", arg_decrefs, "    return kai_real(_kai_ffi_ret);\n"])
  FfiRetBool -> concat_all([arg_setup, "    int _kai_ffi_ret = (int) ", call_expr, ";\n", arg_decrefs, "    return kai_bool(_kai_ffi_ret != 0);\n"])
  FfiRetChar -> concat_all([arg_setup, "    int32_t _kai_ffi_ret = (int32_t) ", call_expr, ";\n", arg_decrefs, "    return kai_char((uint32_t) _kai_ffi_ret);\n"])
  FfiRetString -> concat_all([arg_setup, "    const char *_kai_ffi_ret = ", call_expr, ";\n", arg_decrefs, "    return kai_str(_kai_ffi_ret == NULL ? \"\" : _kai_ffi_ret);\n"])
  FfiRetFixed(fx) ->
    if ffi_fixed_is_float(fx) {
      concat_all([arg_setup, "    ", ffi_fixed_c_type(fx), " _kai_ffi_ret = ", call_expr, ";\n", arg_decrefs, "    return kai_real((double) _kai_ffi_ret);\n"])
    } else {
      concat_all([arg_setup, "    ", ffi_fixed_c_type(fx), " _kai_ffi_ret = ", call_expr, ";\n", arg_decrefs, "    return kai_int((int64_t) _kai_ffi_ret);\n"])
    }
  FfiRetFixedVal(t) ->
    concat_all([arg_setup, "    ", fixed_val_c_type(t), " _kai_ffi_ret = ", call_expr, ";\n", arg_decrefs,
                "    return ", fixed_val_box_ctor(t), "(_kai_ffi_ret);\n"])
  FfiRetForeign(_) -> concat_all([arg_setup, "    void *_kai_ffi_ret = ", call_expr, ";\n", arg_decrefs, "    return kai_foreign(_kai_ffi_ret);\n"])
  FfiRetStruct(s) -> ffi_v2_rebox_struct(s, call_expr, arg_setup, arg_decrefs, reg, tab)
  FfiRetUnknown(t) -> concat_all(["#error \"FFI return type `", t, "` is not supported\"\n"])
}

# Re-box a returned C struct into a fresh KAI_RECORD: stash the C
# struct in a local, then build a record whose fields box each member
# at its kaikai width (a fixed-width field re-boxes as Int / Real).
fn ffi_v2_rebox_struct(s: SymId, call_expr: String, arg_setup: String,
                       arg_decrefs: String, reg: [ExternTypeReg], tab: SymTab) : String {
  let fields = extern_struct_fields(reg, s)
  let n = list_length(fields)
  let ns = int_to_string(n)
  concat_all([
    arg_setup,
    "    ", extern_struct_c_tag(tab, s), " _kai_ffi_ret = ", call_expr, ";\n",
    arg_decrefs,
    "    KaiValue *_kai_ffi_fields[", ns, "];\n",
    "    const char *_kai_ffi_names[", ns, "];\n",
    ffi_v2_rebox_struct_fields(fields, 0, reg, tab),
    "    return kai_record(", ns, ", _kai_ffi_fields, _kai_ffi_names);\n"
  ])
}

fn ffi_v2_rebox_struct_fields(fields: [FieldDecl], i: Int, reg: [ExternTypeReg], tab: SymTab) : String = match fields {
  [] -> ""
  [fd, ...rest] -> match fd {
    FD(_, fname, fty, _) -> {
      let ix = int_to_string(i)
      let member = concat_all(["_kai_ffi_ret.", fname])
      let boxed = ffi_v2_rebox_member(ffi_kind_of_ty_reg(fty, reg, tab), member)
      concat_all([
        "    _kai_ffi_fields[", ix, "] = ", boxed, ";\n",
        "    _kai_ffi_names[", ix, "] = \"", fname, "\";\n",
        ffi_v2_rebox_struct_fields(rest, i + 1, reg, tab)
      ])
    }
  }
}

fn ffi_v2_rebox_member(kind: FfiRetKind, member: String) : String = match kind {
  FfiRetInt    -> concat_all(["kai_int((int64_t) ", member, ")"])
  FfiRetReal   -> concat_all(["kai_real((double) ", member, ")"])
  FfiRetBool   -> concat_all(["kai_bool(", member, " != 0)"])
  FfiRetFixed(fx) ->
    if ffi_fixed_is_float(fx) { concat_all(["kai_real((double) ", member, ")"]) }
    else { concat_all(["kai_int((int64_t) ", member, ")"]) }
  FfiRetFixedVal(t) -> concat_all([fixed_val_box_ctor(t), "(", member, ")"])
  _ -> "kai_unit()"
}

# True when an `extern "C" fn` signature mentions a struct / opaque /
# fixed-width type — the trigger for the extended shim path. A
# purely-scalar signature stays on the basic shim.
#[doc("True when an extern fn signature uses a struct/opaque/fixed-width boundary type, per the registry.")]
pub fn ffi_sig_uses_v2(params: [Param], ret_ty_opt: Option[TypeExpr], reg: [ExternTypeReg], tab: SymTab) : Bool =
  ffi_kind_is_v2(ffi_ret_kind_of_reg(ret_ty_opt, reg, tab)) or ffi_params_use_v2(params, reg, tab)

fn ffi_params_use_v2(params: [Param], reg: [ExternTypeReg], tab: SymTab) : Bool = match params {
  [] -> false
  [p, ...rest] -> {
    let k = match p.ptype { None -> FfiRetUnknown("") Some(t) -> ffi_kind_of_ty_reg(t, reg, tab) }
    if ffi_kind_is_v2(k) { true } else { ffi_params_use_v2(rest, reg, tab) }
  }
}

fn ffi_kind_is_v2(k: FfiRetKind) : Bool = match k {
  FfiRetFixed(_)    -> true
  FfiRetFixedVal(_) -> true
  FfiRetStruct(_)   -> true
  FfiRetForeign(_)  -> true
  _                 -> false
}

# FFI v1: the C body of a scalar `extern "C" fn`. The shim
# - forward-declares the extern symbol with the call site's C ABI types,
# - unboxes each kaikai parameter into its C-side equivalent,
# - calls the extern, releases the input args, and
# - boxes the return value back into a `KaiValue *` (or `kai_unit()`
#   for a `void`-returning extern).
#
# Boundary type translation:
#   Int  ↔ int64_t    Real ↔ double      Bool ↔ int
#   Char ↔ int32_t    String ↔ const char *    Unit ↔ void (return only)
# Anything else surfaces as an `#error` so the C compiler flags it
# at build time — silently emitting a wrong shim would be worse than
# refusing the cast.
pub(pkg) fn emit_ffi_shim_body(sig: String, name: String, params: [Param],
                      ret_ty_opt: Option[TypeExpr], tab: SymTab, ns: LocalNames) : String {
  let ret_kind = ffi_ret_kind_of(ret_ty_opt, tab)
  # Forward-declare the extern symbol with the C ABI types the call site
  # uses (`extern <ret> sym(<params>);`), so `cc` compiles the call
  # without an implicit declaration. The declaration IS the binding
  # contract: a user binding a libc symbol must declare a type whose C
  # mapping matches the system header, or `cc` rejects the redeclaration
  # at compile time — the binding is honoured literally, not silently
  # reconciled. A `FfiRetUnknown` signature emits an `#error` body
  # instead, so it gets no declaration.
  let extern_decl = ffi_v1_extern_decl(name, params, ret_kind, tab)
  let arg_setup = ffi_emit_arg_setup(params, tab, 0, ns)
  let arg_list = ffi_emit_arg_list(params, 0)
  let call_expr = concat_all([name, "(", arg_list, ")"])
  let arg_decrefs = ffi_emit_arg_decrefs(params, 0, ns)
  let body = match ret_kind {
    FfiRetUnit -> concat_all([
      arg_setup,
      "    ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_unit();\n"
    ])
    FfiRetInt -> concat_all([
      arg_setup,
      "    int64_t _kai_ffi_ret = (int64_t) ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_int(_kai_ffi_ret);\n"
    ])
    FfiRetReal -> concat_all([
      arg_setup,
      "    double _kai_ffi_ret = (double) ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_real(_kai_ffi_ret);\n"
    ])
    FfiRetBool -> concat_all([
      arg_setup,
      "    int _kai_ffi_ret = (int) ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_bool(_kai_ffi_ret != 0);\n"
    ])
    FfiRetChar -> concat_all([
      arg_setup,
      "    int32_t _kai_ffi_ret = (int32_t) ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_char((uint32_t) _kai_ffi_ret);\n"
    ])
    FfiRetString -> concat_all([
      arg_setup,
      "    const char *_kai_ffi_ret = ", call_expr, ";\n",
      arg_decrefs,
      "    return kai_str(_kai_ffi_ret == NULL ? \"\" : _kai_ffi_ret);\n"
    ])
    # Struct / opaque / fixed-width kinds never reach the basic shim —
    # a signature using one routes to `emit_ffi_v2_shim_body`. Belt for
    # exhaustiveness.
    FfiRetFixed(_)    -> ffi_v1_v2_kind_error("fixed-width")
    FfiRetFixedVal(_) -> ffi_v1_v2_kind_error("fixed-width")
    FfiRetStruct(_)  -> ffi_v1_v2_kind_error("struct")
    FfiRetForeign(_) -> ffi_v1_v2_kind_error("opaque")
    FfiRetUnknown(t) -> concat_all([
      "#error \"FFI return type `", t,
      "` is not supported in m12.7.x — use Int / Real / Bool / String / Char / Unit\"\n"
    ])
  }
  concat_all([extern_decl, sig, " {\n", body, "}\n\n"])
}

# Forward declaration for an `extern "C"` scalar symbol: `extern <ret>
# sym(<params>);` over the C ABI types the shim's call site uses. A
# `FfiRetUnknown` return yields the empty string — that signature emits
# an `#error` body, so a declaration would only add noise.
fn ffi_v1_extern_decl(name: String, params: [Param], ret_kind: FfiRetKind, tab: SymTab) : String =
  match ret_kind {
    FfiRetUnknown(_) -> ""
    _ -> concat_all(["extern ", ffi_c_ret_type_str(ret_kind), " ", name,
                     "(", ffi_c_param_list(params, tab), ");\n"])
  }

# A struct / opaque / fixed-width kind reaching the basic scalar shim
# is a routing bug (`ffi_sig_uses_v2` should have sent it to
# `emit_ffi_v2_shim_body`). Emit a `#error` naming the offending type
# so the C compile fails loud.
fn ffi_v1_v2_kind_error(name: String) : String =
  concat_all(["#error \"FFI v2 type `", name,
              "` reached the v1 scalar shim — internal routing bug\"\n"])

# The fn a declared core builtin's declaration emits, so the builtin is a
# value through its thunk: it hands its owned args to the runtime symbol.
pub(pkg) fn emit_kai_forwarder_body(sig: String, body: Expr, params: [Param], ns: LocalNames) : String =
  concat_all([sig, " {\n    return ", ffi_extern_symbol_of(body, ""), "(",
              join_with(map(params, (p) => c_local(ln_emitted(ns, p.binder.id))), ", "), ");\n}\n\n"])

# Option C: runtime-dispatch shim body for `__proto_<op>`. Looks up
# the matching `__pimpl_*` in the impl-table by `(proto_id,
# head_tag(self))` and tail-calls it.
#
# The shim signature must match the dispatcher's kaikai signature
# byte-for-byte — `sig` already encodes that. The first parameter is
# always `Self`-shaped (the receiver carries the dispatch tag); we
# read its head tag and look up.
#
# If the lookup misses (no impl registered for the receiver's runtime
# head), panic with a useful message. The validator pass
# (`validate_resolved_protocols`) catches the static cases at compile
# time; reaching the panic at runtime means either (a) a user wrote a
# polymorphic helper without the required `T : P` bound and the bound
# was not enforced at instantiation, or (b) impl-table corruption.
#
# `Eq.eq` has no lookup of its own: its dispatch is the `==` compare.
pub(pkg) fn emit_proto_dispatch_shim_c(sig: String, parts: ProtoDispatchParts, tab: SymTab,
                                params: [Param],
                                ret_ty_opt: Option[TypeExpr], ns: LocalNames) : String =
  if pdp_is_eq(parts) {
    concat_all([sig, " {\n    return kai_op_eq_v(", proto_dispatch_arg_list(params, 0, ns), ");\n}\n\n"])
  } else { emit_proto_lookup_shim_c(sig, parts, tab, params, ns) }

fn emit_proto_lookup_shim_c(sig: String, parts: ProtoDispatchParts, tab: SymTab,
                            params: [Param], ns: LocalNames) : String {
  match parts {
    PDP(_, opname) -> {
      let pname = pdp_proto_name(tab, parts)
      let proto_id_c = match pdp_core(parts) {
        Some(cp) -> stdlib_proto_id_c(cp)
        None     -> concat_all(["-1 /* unknown protocol ", pname,
                                " — user protocols not supported in v1 */"])
      }
      let op_id_c = int_to_string(pdp_op_id_int(parts))
      let arity = list_length(params)
      let miss_msg = concat_all(["no impl of ", pname, ".", opname,
                                  " for runtime head (arity 0 op: caller must annotate Self)"])
      if arity == 0 {
        # Arity-0 ops (`Default.default() : Self`) cannot be runtime-
        # dispatched: there is no value to derive the head tag from,
        # and Self is meant to be pinned by the caller's annotation
        # so the monomorphiser resolves the impl statically. Reaching
        # this body means the validator missed an unresolved call —
        # panic with the diagnostic and never call back into the
        # impl-table.
        concat_all([
          sig, " {\n",
          "    fprintf(stderr, \"panic: ", miss_msg, "\\n\");\n",
          "    kai_exit(1);\n",
          "}\n\n"
        ])
      } else {
        let cast = proto_dispatch_cast(arity)
        let arg_list = proto_dispatch_arg_list(params, 0, ns)
        let head_param = match params {
          [p, ..._] -> c_local(ln_emitted(ns, p.binder.id))
          []        -> c_temp("self")
        }
        concat_all([
          sig, " {\n",
          "    int32_t _kai_head = kai_head_tag(", head_param, ");\n",
          "    void *_kai_fn_p = kai_lookup_impl(", proto_id_c, ", ", op_id_c, ", _kai_head);\n",
          "    if (_kai_fn_p == NULL) {\n",
          "        fprintf(stderr, \"panic: no impl of ", pname, ".", opname,
                  " for runtime head %d\\n\", (int) _kai_head);\n",
          "        kai_exit(1);\n",
          "    }\n",
          "    return ", cast, "_kai_fn_p)(", arg_list, ");\n",
          "}\n\n"
        ])
      }
    }
  }
}

# The KAI_PROTO_* C constant the runtime impl table numbers a core
# protocol with.
pub(pkg) fn stdlib_proto_id_c(p: CoreProto) : String = match p {
  CpShow         -> "KAI_PROTO_SHOW"
  CpEq           -> "KAI_PROTO_EQ"
  CpOrd          -> "KAI_PROTO_ORD"
  CpHash         -> "KAI_PROTO_HASH"
  CpSerialize    -> "KAI_PROTO_SERIALIZE"
  CpBinSerialize -> "KAI_PROTO_BIN_SERIALIZE"
  CpDefault      -> "KAI_PROTO_DEFAULT"
  CpAdd          -> "KAI_PROTO_ADD"
  CpSub          -> "KAI_PROTO_SUB"
  CpMul          -> "KAI_PROTO_MUL"
  CpDiv          -> "KAI_PROTO_DIV"
  CpRem          -> "KAI_PROTO_REM"
  CpNumeric      -> "KAI_PROTO_NUMERIC"
  CpLayout       -> "KAI_PROTO_LAYOUT"
  CpJson         -> "KAI_PROTO_JSON"
  CpNeg          -> "KAI_PROTO_NEG"
}

# Build the C cast prefix for indirect call of a dispatcher of N
# params. All params and the return are `KaiValue *`. The caller emits
# the closing `)` after the cast and the arg list:
# `return ((KaiValue *(*)(KaiValue *)) _kai_fn_p)(kai_a);`

# Build the C cast prefix for indirect call of a dispatcher of N
# params. All params and the return are `KaiValue *`. The caller emits
# the closing `)` after the cast and the arg list:
# `return ((KaiValue *(*)(KaiValue *)) _kai_fn_p)(kai_a);`
fn proto_dispatch_cast(arity: Int) : String {
  let args = proto_dispatch_kaivalueptr_list(arity, 0)
  concat_all(["((KaiValue *(*)(", args, ")) "])
}

fn proto_dispatch_kaivalueptr_list(arity: Int, i: Int) : String {
  if i >= arity { "" }
  else if i == 0 { concat_all(["KaiValue *", proto_dispatch_kaivalueptr_list(arity, i + 1)]) }
  else { concat_all([", KaiValue *", proto_dispatch_kaivalueptr_list(arity, i + 1)]) }
}

# Emit the kaikai params as a C call-arg list `kai_p0, kai_p1, ...`.

# Emit the kaikai params as a C call-arg list `kai_p0, kai_p1, ...`.
fn proto_dispatch_arg_list(params: [Param], i: Int, ns: LocalNames) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let head = if i == 0 { c_local(ln_emitted(ns, p.binder.id)) }
                 else { cat2(", ", c_local(ln_emitted(ns, p.binder.id))) }
      concat_all([head, proto_dispatch_arg_list(rest, i + 1, ns)])
    }
  }
}

fn ffi_c_ret_type_str(k: FfiRetKind) : String {
  match k {
    FfiRetUnit -> "void"
    FfiRetInt -> "int64_t"
    FfiRetReal -> "double"
    FfiRetBool -> "int"
    FfiRetChar -> "int32_t"
    FfiRetString -> "const char *"
    # FFI v2 kinds never reach these v1 helpers (the v2 shim path owns
    # them); the body is `#error`, never compiled. Belt for exhaustiveness.
    FfiRetFixed(_)    -> "void"
    FfiRetFixedVal(_) -> "void"
    FfiRetStruct(_)  -> "void"
    FfiRetForeign(_) -> "void"
    FfiRetUnknown(_) -> "void"  # body is `#error`, never compiled
  }
}

fn ffi_c_param_type_str(p: Param, tab: SymTab) : String {
  match p.ptype {
    None -> "/* missing type */ void *"
    Some(t) -> match ffi_kind_of_ty(t, tab) {
      FfiRetInt -> "int64_t"
      FfiRetReal -> "double"
      FfiRetBool -> "int"
      FfiRetChar -> "int32_t"
      FfiRetString -> "const char *"
      FfiRetUnit -> "/* Unit param not supported */ void *"
      FfiRetFixed(_)    -> "/* v2 fixed-width — v2 shim path */ void *"
      FfiRetFixedVal(_) -> "/* v2 fixed-width — v2 shim path */ void *"
      FfiRetStruct(_)  -> "/* v2 struct — v2 shim path */ void *"
      FfiRetForeign(_) -> "/* v2 opaque — v2 shim path */ void *"
      FfiRetUnknown(_) -> "/* unsupported FFI param */ void *"
    }
  }
}

fn ffi_c_param_list(params: [Param], tab: SymTab) : String {
  match params {
    [] -> "void"
    _ -> join_with(map(params, (p) => ffi_c_param_type_str(p, tab)), ", ")
  }
}

# Emit a sequence of local C bindings that unbox each kaikai
# parameter into the matching C scalar. The shim stores the inputs
# in `_kai_ffi_argN` so they survive across the extern call long
# enough for the caller to release the boxed inputs after the call.

# Emit a sequence of local C bindings that unbox each kaikai
# parameter into the matching C scalar. The shim stores the inputs
# in `_kai_ffi_argN` so they survive across the extern call long
# enough for the caller to release the boxed inputs after the call.
fn ffi_emit_arg_setup(params: [Param], tab: SymTab, i: Int, ns: LocalNames) : String {
  match params {
    [] -> ""
    [p, ...rest] -> {
      let kind = match p.ptype {
        None -> FfiRetUnknown("missing")
        Some(t) -> ffi_kind_of_ty(t, tab)
      }
      let arg_name = concat_all(["_kai_ffi_arg", int_to_string(i)])
      let stmt = match kind {
        FfiRetInt -> concat_all([
          "    int64_t ", arg_name, " = kai_intf(", c_local(ln_emitted(ns, p.binder.id)), ");\n"
        ])
        FfiRetReal -> concat_all([
          "    double ", arg_name, " = ", c_local(ln_emitted(ns, p.binder.id)), "->as.r;\n"
        ])
        FfiRetBool -> concat_all([
          "    int ", arg_name, " = ", c_local(ln_emitted(ns, p.binder.id)), "->as.b ? 1 : 0;\n"
        ])
        FfiRetChar -> concat_all([
          "    int32_t ", arg_name, " = (int32_t) ", c_local(ln_emitted(ns, p.binder.id)), "->as.c;\n"
        ])
        FfiRetString -> concat_all([
          "    const char *", arg_name, " = ", c_local(ln_emitted(ns, p.binder.id)), "->as.s.bytes;\n"
        ])
        FfiRetUnit -> concat_all([
          "    /* Unit FFI arg #", int_to_string(i), " elided */\n"
        ])
        # FFI v2 kinds are handled by the v2 shim path, never here.
        FfiRetFixed(_)    -> ffi_v1_v2_kind_error("fixed-width")
        FfiRetFixedVal(_) -> ffi_v1_v2_kind_error("fixed-width")
        FfiRetStruct(_)  -> ffi_v1_v2_kind_error("struct")
        FfiRetForeign(_) -> ffi_v1_v2_kind_error("opaque")
        FfiRetUnknown(t) -> concat_all([
          "#error \"FFI arg type `", t, "` is not supported\"\n"
        ])
      }
      cat2(stmt, ffi_emit_arg_setup(rest, tab, i + 1, ns))
    }
  }
}

fn ffi_emit_arg_list(params: [Param], i: Int) : String {
  match params {
    [] -> ""
    [_, ...rest] -> {
      let head = concat_all(["_kai_ffi_arg", int_to_string(i)])
      match rest {
        [] -> head
        _ -> concat_all([head, ", ", ffi_emit_arg_list(rest, i + 1)])
      }
    }
  }
}

# After the extern returns we must release the boxed kaikai inputs;
# the calling convention hands ownership to the callee.

# After the extern returns we must release the boxed kaikai inputs;
# the calling convention hands ownership to the callee.
fn ffi_emit_arg_decrefs(params: [Param], i: Int, ns: LocalNames) : String {
  match params {
    [] -> ""
    [p, ...rest] -> cat2(
      concat_all(["    kai_decref(", c_local(ln_emitted(ns, p.binder.id)), ");\n"]),
      ffi_emit_arg_decrefs(rest, i + 1, ns)
    )
  }
}
