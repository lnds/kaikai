#[doc("KIR clone, use counting and beta reduction: the substitution machinery the inliner builds on.")]

import compiler.kir
import compiler.util
import compiler.ast

# compiler/kir_uses.kai — register-use queries over KIR blocks.
#
# One exhaustive atom walk, shared by every pass that asks "is register
# `n` read anywhere?" (the inliner's dead-closure sweep, the var-slot
# escape check). A binder position is never a use; only atom reads
# count.

#[doc("True when register `n` is read as an atom anywhere in the blocks; `rc` selects whether dup/drop-family operands count as reads.")]
pub(pkg) fn kir_reg_used(bs: [KBlock], n: String, rc: Bool) : Bool = match bs {
  []           -> false
  [b, ...rest] -> kir_used_stmts(b.stmts, n, rc) or kir_used_term(b.term, n) or kir_reg_used(rest, n, rc)
}

fn kir_used_stmts(ss: [KStmt], n: String, rc: Bool) : Bool = match ss {
  []           -> false
  [s, ...rest] -> kir_used_stmt(s, n, rc) or kir_used_stmts(rest, n, rc)
}

fn kir_used_stmt(s: KStmt, n: String, rc: Bool) : Bool = match s {
  KLet(_, _, op, _)        -> kir_used_op(op, n)
  KDo(op, _)               -> kir_used_op(op, n)
  KRC(rcop, _)             -> rc and kir_used_rc(rcop, n)
  KStore(_, v, _)          -> kir_v(v, n)
  KInstall(_, _, iv, _, env, _) -> kir_env_reads(env, n) or (match iv { Some(v) -> kir_v(v, n) None -> false })
  _                        -> false
}

fn kir_env_reads(env: [Option[String]], n: String) : Bool = any(env, (r) => match r { Some(x) -> x == n None -> false })

fn kir_used_rc(rcop: KRCOp, n: String) : Bool = match rcop {
  KDup(v)               -> kir_v(v, n)
  KDrop(v)              -> kir_v(v, n)
  KFreeToken(v)         -> kir_v(v, n)
  KIncrefIfShared(d, c) -> kir_v(d, n) or kir_v(c, n)
  KArmTopReuse(v, _, _, _) -> kir_v(v, n)
  KArmTokenFree         -> false
  KArmTake(v, bs, _)    -> kir_v(v, n) or kir_vs(bs, n)
}

fn kir_used_op(op: KOp, n: String) : Bool = match op {
  KCall(_, vs)                -> kir_vs(vs, n)
  KCallIndirect(f, vs)        -> kir_v(f, n) or kir_vs(vs, n)
  KCallIndirectBorrow(f, vs)  -> kir_v(f, n) or kir_vs(vs, n)
  KPrim(_, vs)                -> kir_vs(vs, n)
  KCon(_, _, _, inits, _)     -> kir_inits(inits, n)
  KConReuse(_, d, _, _, inits) -> kir_v(d, n) or kir_inits(inits, n)
  KRecord(fs, _, _)           -> kir_fields(fs, n)
  KRecordReuse(d, fs, _, _)   -> kir_v(d, n) or kir_fields(fs, n)
  KTokenSteal(v, _)           -> kir_v(v, n)
  KProj(v, _)                 -> kir_v(v, n)
  KProjBorrow(v, _)           -> kir_v(v, n)
  KProjKind(v, _, _)          -> kir_v(v, n)
  KTagOf(v)                   -> kir_v(v, n)
  KClosure(_, _, caps)        -> kir_vs(caps, n)
  KPerform(_, _, _, _, vs)       -> kir_vs(vs, n)
  KSetjmp(_, _)               -> false
  KResumeOp(k, v)             -> kir_v(k, n) or kir_v(v, n)
  KResume2Op(k, v, s2)        -> kir_v(k, n) or kir_v(v, n) or kir_v(s2, n)
  KLitOp(v)                   -> kir_v(v, n)
}

fn kir_used_term(t: KTerm, n: String) : Bool = match t {
  KRet(v, _)               -> kir_v(v, n)
  KCondBr(v, _, _, _)      -> kir_v(v, n)
  KSwitch(v, _, _, _)      -> kir_v(v, n)
  KTcrecGoto(_, asg, _, _) -> kir_asg(asg, n)
  KTrmcStep(_, _, _, _, _, _, hs, asg, _, _) -> kir_vs(hs, n) or kir_asg(asg, n)
  KTrmcApply(v, _)         -> kir_v(v, n)
  _                        -> false
}

fn kir_asg(asg: [KAssign], n: String) : Bool = match asg {
  []                    -> false
  [KAsg(_, v), ...rest] -> kir_v(v, n) or kir_asg(rest, n)
}

fn kir_v(v: KVal, n: String) : Bool = match v {
  KVar(m) -> m == n
  _       -> false
}

fn kir_vs(vs: [KVal], n: String) : Bool = match vs {
  []           -> false
  [v, ...rest] -> kir_v(v, n) or kir_vs(rest, n)
}

fn kir_inits(inits: [KSlotInit], n: String) : Bool = match inits {
  []            -> false
  [si, ...rest] -> match si {
    SIBoxed(v) -> kir_v(v, n) or kir_inits(rest, n)
    SIInt64(v) -> kir_v(v, n) or kir_inits(rest, n)
    SIReal(v)  -> kir_v(v, n) or kir_inits(rest, n)
    SIEnum(v)  -> kir_v(v, n) or kir_inits(rest, n)
  }
}

fn kir_fields(fs: [KFieldInit], n: String) : Bool = match fs {
  []                   -> false
  [KFI(_, v), ...rest] -> kir_v(v, n) or kir_fields(rest, n)
}

# compiler/kir_inline_clone.kai — alpha-renaming clone for the KIR
# inliner: paste one admitted template body into a call site.
#
# The clone substitutes param reads with the site's argument atoms,
# suffixes every template-local binder and label with the site-unique
# tag, rewrites `KRet v` into `x <- v; br join`, and leaves every other
# terminator's shape intact. The fall-through arms (`_ -> …`) are
# unreachable on an admitted template — the admission whitelist in
# `kir_inline.kai` and these matches move together.

# Clone context for one paste: param name → argument atom, the
# site-unique suffix every local binder and label takes, the template's
# param list + entry label (consumed by the `KTcrecGoto` back-edge
# rewrite; empty/params-unused for straight-line templates).
pub(pkg) type KinArg = KA(String, KVal)
pub(pkg) type KinSub = { pargs: [KinArg], sfx: String, params: [KParam], entry: String }

#[doc("One admitted template, keyed by its resolved symbol.")]
pub(pkg) type KinTmpl = KT(String, KFn)

#[doc("The declared-slot zero init for a paste's result register, so every path through the clone stores over an initialised alloca of the right width.")]
pub(pkg) fn kin_zero(s: KSlot) : KVal = match s {
  SInt64 -> KIntV(0)
  SReal  -> KRealV(0.0)
  SBool  -> KBoolV(false)
  SChar  -> KCharV(' ')
  SByte  -> KIntV(0)
  SInt32T -> KIntV(0)
  SUInt32 -> KIntV(0)
  SUInt64 -> KIntV(0)
  SInt128 -> KFixedV("0", TyInt128)
  _      -> KUnitV
}

#[doc("Head-block KLets for the materialised params, REVERSED (the head accumulator is a reversed list): `param+sfx: slot = arg`. `all` takes every param (loop templates); otherwise the raw ones and the boxed ones whose argument is not a register.")]
pub(pkg) fn kin_param_lets(ps: [KParam], cargs: [KVal], sfx: String, all: Bool, pos: KPos, acc: [KStmt]) : [KStmt] = match ps {
  [] -> acc
  [p, ...prest] -> match cargs {
    []            -> acc
    [a, ...arest] -> kin_param_lets(prest, arest, sfx, all, pos, match p.slot {
      SBoxed -> if all or not kin_is_reg(a) { [KLet(cat2(p.name, sfx), p.slot, KLitOp(a), pos), ...acc] } else { acc }
      _      -> [KLet(cat2(p.name, sfx), p.slot, KLitOp(a), pos), ...acc]
    })
  }
}

# Bind only the BOXED params whose argument is a register; every other
# param is left unbound so the fallback rename reads its head-block
# materialised register (`param+sfx`). A boxed literal atom is materialised
# afresh at each read, so substituting it would give every read of the param
# its own allocation and break the aliasing the template's RC relies on.
pub(pkg) fn kin_bind_boxed_args(ps: [KParam], cargs: [KVal], acc: [KinArg]) : [KinArg] = match ps {
  [] -> list_reverse(acc)
  [p, ...prest] -> match cargs {
    []            -> list_reverse(acc)
    [a, ...arest] -> kin_bind_boxed_args(prest, arest, match p.slot {
      SBoxed -> if kin_is_reg(a) { [KA(p.name, a), ...acc] } else { acc }
      _      -> acc
    })
  }
}

fn kin_is_reg(a: KVal) : Bool = match a {
  KVar(_) -> true
  _       -> false
}

pub(pkg) fn kin_clone_blocks(bs: [KBlock], sub: KinSub, x: String, join: String, acc: [KBlock]) : [KBlock] = match bs {
  []           -> list_reverse(acc)
  [b, ...rest] -> kin_clone_blocks(rest, sub, x, join, [kin_clone_block(b, sub, x, join), ...acc])
}

# `KRet v` becomes `x <- v; br join`; a `KTcrecGoto` back-edge becomes
# the same eval → masked-drop → store sequence the backend lowers it to,
# closed by a branch to the clone's entry (the pasted loop header);
# every other terminator renames its labels in place.
fn kin_clone_block(b: KBlock, sub: KinSub, x: String, join: String) : KBlock = match b.term {
  KRet(v, p) -> KBlock { label: kin_lbl(sub, b.label),
                         stmts: list_append(kin_sub_stmts(b.stmts, sub, []),
                                            [KStore(x, kin_sub_val(sub, v), p)]),
                         term: KBr(join, p), region_id: None }
  KTcrecGoto(_, asg, mask, p) ->
    KBlock { label: kin_lbl(sub, b.label),
             stmts: list_append(kin_sub_stmts(b.stmts, sub, []), kin_reloop_stmts(sub, asg, mask, p)),
             term: KBr(kin_lbl(sub, sub.entry), p), region_id: None }
  _          -> KBlock { label: kin_lbl(sub, b.label),
                         stmts: kin_sub_stmts(b.stmts, sub, []),
                         term: kin_sub_term(sub, b.term), region_id: None }
}

# The pasted back-edge, mirroring `nemit_tcrec`: every non-identity
# reloop value is evaluated FIRST (it reads the OLD param registers)
# into a fresh temp at the destination param's slot; the dropmask then
# releases each dead BOXED old param (raw scalars are never dropped);
# the temps store last. An identity assign (`p <- p`) skips its eval
# and store but keeps its masked drop — the block's own `dup` minted
# the ref the back-edge retires.
fn kin_reloop_stmts(sub: KinSub, asg: [KAssign], mask: Int, p: KPos) : [KStmt] =
  list_append(kin_reloop_evals(sub, asg, p, []),
              list_append(kin_reloop_drops(sub, asg, mask, p, []),
                          kin_reloop_stores(sub, asg, p, [])))

fn kin_reloop_evals(sub: KinSub, asg: [KAssign], p: KPos, acc: [KStmt]) : [KStmt] = match asg {
  [] -> list_reverse(acc)
  [KAsg(idx, v), ...rest] -> kin_reloop_evals(sub, rest, p,
    if kin_asg_identity(sub, idx, v) { acc }
    else { [KLet(kin_reloop_tmp(sub, idx), kin_param_slot(sub, idx), KLitOp(kin_sub_val(sub, v)), p), ...acc] })
}

fn kin_reloop_drops(sub: KinSub, asg: [KAssign], mask: Int, p: KPos, acc: [KStmt]) : [KStmt] = match asg {
  [] -> list_reverse(acc)
  [KAsg(idx, _), ...rest] -> kin_reloop_drops(sub, rest, mask, p,
    if kin_mask_bit(mask, idx) and kin_param_is_boxed(sub, idx) {
      [KRC(KDrop(KVar(kin_param_reg(sub, idx))), p), ...acc]
    } else { acc })
}

fn kin_reloop_stores(sub: KinSub, asg: [KAssign], p: KPos, acc: [KStmt]) : [KStmt] = match asg {
  [] -> list_reverse(acc)
  [KAsg(idx, v), ...rest] -> kin_reloop_stores(sub, rest, p,
    if kin_asg_identity(sub, idx, v) { acc }
    else { [KStore(kin_param_reg(sub, idx), KVar(kin_reloop_tmp(sub, idx)), p), ...acc] })
}

fn kin_asg_identity(sub: KinSub, idx: Int, v: KVal) : Bool = match v {
  KVar(n) -> n == kin_param_name(sub, idx)
  _       -> false
}

fn kin_reloop_tmp(sub: KinSub, idx: Int) : String =
  concat_all([kin_param_name(sub, idx), sub.sfx, "$re"])

# The cloned register carrying param `idx` (the head block materialised
# it as `name+sfx`).
fn kin_param_reg(sub: KinSub, idx: Int) : String = cat2(kin_param_name(sub, idx), sub.sfx)

fn kin_param_name(sub: KinSub, idx: Int) : String = match kin_param_at(sub.params, idx) {
  Some(pp) -> pp.name
  None     -> ""
}

fn kin_param_slot(sub: KinSub, idx: Int) : KSlot = match kin_param_at(sub.params, idx) {
  Some(pp) -> pp.slot
  None     -> SBoxed
}

fn kin_param_is_boxed(sub: KinSub, idx: Int) : Bool = match kin_param_slot(sub, idx) {
  SBoxed -> true
  _      -> false
}

fn kin_param_at(ps: [KParam], idx: Int) : Option[KParam] = match ps {
  []            -> None
  [pp, ...rest] -> if idx == 0 { Some(pp) } else { kin_param_at(rest, idx - 1) }
}

fn kin_mask_bit(mask: Int, i: Int) : Bool = (mask / kin_pow2(i)) % 2 == 1

fn kin_pow2(n: Int) : Int = if n <= 0 { 1 } else { 2 * kin_pow2(n - 1) }

pub(pkg) fn kin_lbl(sub: KinSub, l: String) : String = cat2(l, sub.sfx)

# A `KVar` naming a param reads the bound argument atom; any other name
# is a template-local binder and takes the site suffix (admission
# guarantees no third kind of name appears in atom position).
fn kin_sub_val(sub: KinSub, v: KVal) : KVal = match v {
  KVar(n) -> match kin_arg_find(sub.pargs, n) {
    Some(a) -> a
    None    -> KVar(cat2(n, sub.sfx))
  }
  _ -> v
}

fn kin_arg_find(pargs: [KinArg], n: String) : Option[KVal] = match pargs {
  []                  -> None
  [KA(p, a), ...rest] -> if p == n { Some(a) } else { kin_arg_find(rest, n) }
}

fn kin_sub_vals(vs: [KVal], sub: KinSub, acc: [KVal]) : [KVal] = match vs {
  []           -> list_reverse(acc)
  [v, ...rest] -> kin_sub_vals(rest, sub, [kin_sub_val(sub, v), ...acc])
}

fn kin_sub_stmts(ss: [KStmt], sub: KinSub, acc: [KStmt]) : [KStmt] = match ss {
  []           -> list_reverse(acc)
  [s, ...rest] -> kin_sub_stmts(rest, sub, [kin_sub_stmt(sub, s), ...acc])
}

fn kin_sub_stmt(sub: KinSub, s: KStmt) : KStmt = match s {
  KLet(n, slot, op, p) -> KLet(cat2(n, sub.sfx), slot, kin_sub_op(sub, op), p)
  KDo(op, p)           -> KDo(kin_sub_op(sub, op), p)
  KRC(rc, p)           -> KRC(kin_sub_rc(sub, rc), p)
  KStore(n, v, p)      -> KStore(cat2(n, sub.sfx), kin_sub_val(sub, v), p)
  _                    -> s
}

fn kin_sub_rc(sub: KinSub, rc: KRCOp) : KRCOp = match rc {
  KDup(v)               -> KDup(kin_sub_val(sub, v))
  KDrop(v)              -> KDrop(kin_sub_val(sub, v))
  KFreeToken(v)         -> KFreeToken(kin_sub_val(sub, v))
  KIncrefIfShared(d, c) -> KIncrefIfShared(kin_sub_val(sub, d), kin_sub_val(sub, c))
  KArmTake(d, bs, m)    -> KArmTake(kin_sub_val(sub, d), kin_sub_vals(bs, sub, []), m)
  _                     -> rc
}

fn kin_sub_op(sub: KinSub, op: KOp) : KOp = match op {
  KPrim(nm, vs)              -> KPrim(nm, kin_sub_vals(vs, sub, []))
  KCon(nm, tag, mask, inits, rgn) -> KCon(nm, tag, mask, kin_sub_inits(inits, sub, []), rgn)
  KRecord(fs, rgn, tag)      -> KRecord(kin_sub_fields(fs, sub, []), rgn, tag)
  KProj(v, i)                -> KProj(kin_sub_val(sub, v), i)
  KProjBorrow(v, i)          -> KProjBorrow(kin_sub_val(sub, v), i)
  KProjKind(v, i, k)         -> KProjKind(kin_sub_val(sub, v), i, k)
  KTagOf(v)                  -> KTagOf(kin_sub_val(sub, v))
  KLitOp(v)                  -> KLitOp(kin_sub_val(sub, v))
  KConReuse(rk, d, nm, tag, inits) ->
    KConReuse(rk, kin_sub_val(sub, d), nm, tag, kin_sub_inits(inits, sub, []))
  KRecordReuse(d, fs, kept, tag) -> KRecordReuse(kin_sub_val(sub, d), kin_sub_fields(fs, sub, []), kept, tag)
  KTokenSteal(v, n)          -> KTokenSteal(kin_sub_val(sub, v), n)
  KCall(nm, vs)              -> KCall(nm, kin_sub_vals(vs, sub, []))
  KCallIndirect(f, vs)       -> KCallIndirect(kin_sub_val(sub, f), kin_sub_vals(vs, sub, []))
  KCallIndirectBorrow(f, vs) -> KCallIndirectBorrow(kin_sub_val(sub, f), kin_sub_vals(vs, sub, []))
  KPerform(eff, ts, o, via, vs) -> KPerform(eff, ts, o, via, kin_sub_vals(vs, sub, []))
  _                          -> op
}

fn kin_sub_inits(inits: [KSlotInit], sub: KinSub, acc: [KSlotInit]) : [KSlotInit] = match inits {
  []            -> list_reverse(acc)
  [si, ...rest] -> kin_sub_inits(rest, sub, [kin_sub_init(sub, si), ...acc])
}

fn kin_sub_init(sub: KinSub, si: KSlotInit) : KSlotInit = match si {
  SIBoxed(v) -> SIBoxed(kin_sub_val(sub, v))
  SIInt64(v) -> SIInt64(kin_sub_val(sub, v))
  SIReal(v)  -> SIReal(kin_sub_val(sub, v))
  SIEnum(v)  -> SIEnum(kin_sub_val(sub, v))
}

fn kin_sub_fields(fs: [KFieldInit], sub: KinSub, acc: [KFieldInit]) : [KFieldInit] = match fs {
  []                   -> list_reverse(acc)
  [KFI(n, v), ...rest] -> kin_sub_fields(rest, sub, [KFI(n, kin_sub_val(sub, v)), ...acc])
}

fn kin_sub_term(sub: KinSub, t: KTerm) : KTerm = match t {
  KBr(l, p)             -> KBr(kin_lbl(sub, l), p)
  KCondBr(v, a, b, p)   -> KCondBr(kin_sub_val(sub, v), kin_lbl(sub, a), kin_lbl(sub, b), p)
  KSwitch(v, cs, d, p)  -> KSwitch(kin_sub_val(sub, v), kin_sub_cases(cs, sub, []), kin_lbl(sub, d), p)
  KUnreachable(p)       -> KUnreachable(p)
  _                     -> t
}

fn kin_sub_cases(cs: [KCase], sub: KinSub, acc: [KCase]) : [KCase] = match cs {
  []                  -> list_reverse(acc)
  [KC(t, l), ...rest] -> kin_sub_cases(rest, sub, [KC(t, kin_lbl(sub, l)), ...acc])
}

# compiler/kir_inline_beta.kai — indirect-call beta reduction on KIR.
#
# After the direct-call inliner pastes a loop combinator into its
# caller, the loop's `KCallIndirect(pred/body)` sites sit next to the
# `KClosure` bindings that feed them. This pass resolves such a site to
# its lambda and pastes the lambda body, binding `PDirect` params to
# the call args and `PCapture` params to the closure's capture atoms.
# A consuming apply's closure ref is retired by a `KDrop` in the JOIN
# block — after the pasted body — so the captures outlive every read.
#
# The dead-closure sweep then removes a `KClosure` binding whose only
# remaining uses are its own dup/drop RC ops. The build borrows its
# capture atoms (the runtime closure ctor increfs each one; the
# closure's free decrefs them), and a pasted body reads those captures
# from the caller's registers — alive only through the closure's hold
# when the caller dropped its own ref before the site.

# One resolvable closure binding: register name, lambda sym, capture atoms,
# and the register it copies when it is an alias rather than the build.
pub(pkg) type KinClo = KCl(String, String, [KVal], Option[String])

# A processed block list plus the threaded per-fn site counter.
type KinBBlks = KBB([KBlock], Int)

#[doc("Beta-reduce a fn's KCallIndirect sites over its single-assignment KClosure bindings, pasting admitted lambda bodies; then sweep closures left dead by the reduction.")]
pub(pkg) fn kin_beta_fn(f: KFn, lams: [KinTmpl]) : KFn = {
  let env = kin_clo_env(f.blocks)
  match env {
    [] -> f
    _  -> match kin_beta_blocks(f.blocks, env, lams, 0, []) {
      KBB(bs, _) -> kfn_with_blocks(f, kin_dce_closures(bs))
    }
  }
}

# --- Closure environment -------------------------------------------------

# Every `KLet(n, _, KClosure)` whose register is single-assignment (so a
# later read sees exactly this closure), plus the single-assignment
# `KLitOp` register aliases that resolve to one — the shape the
# loop-template paste leaves behind (`pred$in0: box = .t6`). Alias chains
# are short; three rounds cover a paste-of-paste. A register is not
# single-assignment when it is re-stored or bound by more than one `KLet`:
# sibling scopes reuse a binder's name (`__pcs_tret` in two arms).
fn kin_clo_env(bs: [KBlock]) : [KinClo] = {
  let stores = kin_store_names(bs, [])
  let direct = kin_clo_collect(bs, bs, stores, [])
  kin_clo_alias_round(bs, stores, kin_clo_alias_round(bs, stores, kin_clo_alias_round(bs, stores, direct)))
}

fn kin_clo_alias_round(bs: [KBlock], stores: [String], env: [KinClo]) : [KinClo] =
  kin_clo_alias_blocks(bs, bs, stores, env, env)

fn kin_clo_alias_blocks(bs_all: [KBlock], bs: [KBlock], stores: [String], env: [KinClo], acc: [KinClo]) : [KinClo] = match bs {
  []           -> acc
  [b, ...rest] -> kin_clo_alias_blocks(bs_all, rest, stores, env, kin_clo_alias_stmts(bs_all, b.stmts, stores, env, acc))
}

fn kin_clo_alias_stmts(bs_all: [KBlock], ss: [KStmt], stores: [String], env: [KinClo], acc: [KinClo]) : [KinClo] = match ss {
  []           -> acc
  [s, ...rest] -> kin_clo_alias_stmts(bs_all, rest, stores, env, match s {
    KLet(n, _, KLitOp(KVar(m)), _) ->
      if list_has(stores, n) { acc }
      else { match kin_clo_find(acc, n) {
        Some(_) -> acc
        None -> match kin_clo_find(env, m) {
          Some(KCl(_, sym, caps, _)) -> if kin_single_let(bs_all, n) { [KCl(n, sym, caps, Some(m)), ...acc] } else { acc }
          None                    -> acc
        }
      } }
    _ -> acc
  })
}

fn kin_store_names(bs: [KBlock], acc: [String]) : [String] = match bs {
  []           -> acc
  [b, ...rest] -> kin_store_names(rest, kin_store_names_stmts(b.stmts, acc))
}

fn kin_store_names_stmts(ss: [KStmt], acc: [String]) : [String] = match ss {
  []           -> acc
  [s, ...rest] -> kin_store_names_stmts(rest, match s {
    KStore(n, _, _) -> [n, ...acc]
    _               -> acc
  })
}

fn kin_clo_collect(bs_all: [KBlock], bs: [KBlock], stores: [String], acc: [KinClo]) : [KinClo] = match bs {
  []           -> list_reverse(acc)
  [b, ...rest] -> kin_clo_collect(bs_all, rest, stores, kin_clo_stmts(bs_all, b.stmts, stores, acc))
}

fn kin_clo_stmts(bs_all: [KBlock], ss: [KStmt], stores: [String], acc: [KinClo]) : [KinClo] = match ss {
  []           -> acc
  [s, ...rest] -> kin_clo_stmts(bs_all, rest, stores, match s {
    KLet(n, _, KClosure(sym, _, caps), _) ->
      if list_has(stores, n) or not kin_single_let(bs_all, n) or not kin_caps_single(bs_all, caps) { acc }
      else { [KCl(n, sym, caps, None), ...acc] }
    _ -> acc
  })
}

fn kin_caps_single(bs: [KBlock], caps: [KVal]) : Bool = match caps {
  []                 -> true
  [KVar(c), ...rest] -> kin_let_count(bs, c, 0) <= 1 and kin_caps_single(bs, rest)
  [_, ...rest]       -> kin_caps_single(bs, rest)
}

fn kin_single_let(bs: [KBlock], n: String) : Bool = kin_let_count(bs, n, 0) == 1

fn kin_let_count(bs: [KBlock], n: String, k: Int) : Int = match bs {
  []           -> k
  [b, ...rest] -> if k > 1 { k } else { kin_let_count(rest, n, kin_let_count_stmts(b.stmts, n, k)) }
}

fn kin_let_count_stmts(ss: [KStmt], n: String, k: Int) : Int = match ss {
  []           -> k
  [s, ...rest] -> kin_let_count_stmts(rest, n, match s {
    KLet(m, _, _, _) -> if m == n { k + 1 } else { k }
    _                -> k
  })
}

fn kin_clo_find(env: [KinClo], n: String) : Option[KinClo] = match env {
  [] -> None
  [KCl(cn, sym, caps, src), ...rest] ->
    if cn == n { Some(KCl(cn, sym, caps, src)) } else { kin_clo_find(rest, n) }
}

# --- Site scan ------------------------------------------------------------

fn kin_beta_blocks(bs: [KBlock], env: [KinClo], lams: [KinTmpl], c: Int, acc: [KBlock]) : KinBBlks = match bs {
  []           -> KBB(list_reverse(acc), c)
  [b, ...rest] -> match kin_beta_scan(b.label, b.stmts, b.term, env, lams, c, []) {
    KBB(nbs, c2) -> kin_beta_blocks(rest, env, lams, c2, kin_prepend_rev_b(nbs, acc))
  }
}

fn kin_prepend_rev_b(xs: [KBlock], acc: [KBlock]) : [KBlock] = match xs {
  []           -> acc
  [x, ...rest] -> kin_prepend_rev_b(rest, [x, ...acc])
}

# Mirror of the direct-call scan: head block → alpha-renamed lambda
# clone → join block. The join opens with the closure-consuming `KDrop`
# (a borrowing apply skips it), then the site's remaining statements.
fn kin_beta_scan(label: String, ss: [KStmt], term: KTerm, env: [KinClo],
                 lams: [KinTmpl], c: Int, pre_rev: [KStmt]) : KinBBlks = match ss {
  [] -> KBB([KBlock { label: label, stmts: list_reverse(pre_rev), term: term, region_id: None }], c)
  [s, ...rest] -> match kin_beta_site(s, env, lams) {
    Some(hit) -> match hit { KBH(x, slot, cn, lam, caps, vargs, consuming, pos) -> {
      let sfx  = cat2("$bt", int_to_string(c))
      let ordered = kin_origin_args(lam.params, vargs, caps, [])
      let sub  = KinSub { pargs: kin_bind_boxed_args(lam.params, ordered, []),
                          sfx: sfx, params: lam.params, entry: kin_beta_entry(lam) }
      let plets = kin_param_lets(lam.params, ordered, sfx, false, pos, [])
      let join = cat2("Lj", sfx)
      let head = KBlock { label: label,
                          stmts: list_reverse([KLet(x, slot, KLitOp(kin_zero(slot)), pos), ...list_append(plets, pre_rev)]),
                          term: KBr(kin_lbl(sub, kin_beta_entry(lam)), pos),
                          region_id: None }
      let cloned = kin_clone_blocks(lam.blocks, sub, x, join, [])
      let jdrop = if consuming { [KRC(KDrop(KVar(cn)), pos)] } else { [] }
      match kin_beta_scan(join, rest, term, env, lams, c + 1, list_reverse(jdrop)) {
        KBB(tail, c2) -> KBB([head, ...list_append(cloned, tail)], c2)
      }
    } }
    None -> kin_beta_scan(label, rest, term, env, lams, c, [s, ...pre_rev])
  }
}

# One matched site: result register + slot, the closure register, the
# lambda template, the closure's capture atoms, the call args, whether
# the apply consumes the closure, and the site position.
type KinBetaHit = KBH(String, KSlot, String, KFn, [KVal], [KVal], Bool, KPos)

fn kin_beta_site(s: KStmt, env: [KinClo], lams: [KinTmpl]) : Option[KinBetaHit] = match s {
  KLet(x, slot, KCallIndirect(KVar(cn), vargs), pos) ->
    kin_beta_resolve(x, slot, cn, vargs, true, pos, env, lams)
  KLet(x, slot, KCallIndirectBorrow(KVar(cn), vargs), pos) ->
    kin_beta_resolve(x, slot, cn, vargs, false, pos, env, lams)
  _ -> None
}

fn kin_beta_resolve(x: String, slot: KSlot, cn: String, vargs: [KVal], consuming: Bool,
                    pos: KPos, env: [KinClo], lams: [KinTmpl]) : Option[KinBetaHit] =
  match kin_clo_find(env, cn) {
    None -> None
    Some(KCl(_, sym, caps, _)) -> match kin_tmpl_find(lams, sym) {
      None      -> None
      Some(lam) ->
        if kin_beta_arity_ok(lam.params, vargs, caps) and kin_lam_alias_site_ok(lam, caps) {
          Some(KBH(x, slot, cn, lam, caps, vargs, consuming, pos))
        } else { None }
    }
  }

fn kin_tmpl_find(ts: [KinTmpl], sym: String) : Option[KFn] = match ts {
  [] -> None
  [KT(s, f), ...rest] -> if s == sym { Some(f) } else { kin_tmpl_find(rest, sym) }
}

fn kin_beta_entry(f: KFn) : String = match f.blocks {
  [b, ..._] -> b.label
  []        -> ""
}

# Each param must resolve through its origin: `PDirect(i)` within the
# args, `PCapture(j)` within the captures.
fn kin_beta_arity_ok(ps: [KParam], vargs: [KVal], caps: [KVal]) : Bool = match ps {
  [] -> true
  [p, ...rest] -> match p.origin {
    PDirect(i)  -> i >= 0 and i < list_length(vargs) and kin_beta_arity_ok(rest, vargs, caps)
    PCapture(j) -> j >= 0 and j < list_length(caps) and kin_beta_arity_ok(rest, vargs, caps)
    _           -> false
  }
}

# The params in template order, each resolved to its site atom.
fn kin_origin_args(ps: [KParam], vargs: [KVal], caps: [KVal], acc: [KVal]) : [KVal] = match ps {
  [] -> list_reverse(acc)
  [p, ...rest] -> kin_origin_args(rest, vargs, caps, [match p.origin {
    PDirect(i)  -> kin_val_at(vargs, i)
    PCapture(j) -> kin_val_at(caps, j)
    _           -> KUnitV
  }, ...acc])
}

fn kin_val_at(vs: [KVal], i: Int) : KVal = match vs {
  []           -> KUnitV
  [v, ...rest] -> if i == 0 { v } else { kin_val_at(rest, i - 1) }
}

# --- Aliased performs -----------------------------------------------------

# An `op@a` perform names the register its alias is bound to, and reads
# the handler id from that register's id register; it carries no atom the
# paste could re-point. The paste is sound only when the lambda captured
# the id register under the SAME name and the site's capture atom IS that
# register — then the pasted perform reads the caller's own alias id.

#[doc("Template-side alias shape: every perform through an alias `a` names a `__alias_id__a` param captured (not direct) by the lambda.")]
pub(pkg) fn kin_lam_alias_shape_ok(f: KFn) : Bool =
  kin_alias_names_ok(kin_perform_aliases(f.blocks, []), f.params)

# Site-side: the capture atom bound to each `__alias_id__a` param is
# the caller register of the same name.
fn kin_lam_alias_site_ok(f: KFn, caps: [KVal]) : Bool =
  kin_alias_caps_ok(kin_perform_aliases(f.blocks, []), f.params, caps)

fn kin_perform_aliases(bs: [KBlock], acc: [String]) : [String] = match bs {
  []           -> acc
  [b, ...rest] -> kin_perform_aliases(rest, kin_perform_aliases_stmts(b.stmts, acc))
}

fn kin_perform_aliases_stmts(ss: [KStmt], acc: [String]) : [String] = match ss {
  []           -> acc
  [s, ...rest] -> kin_perform_aliases_stmts(rest, match s {
    KLet(_, _, KPerform(_, _, _, via, _), _) -> kin_alias_of(via, acc)
    KDo(KPerform(_, _, _, via, _), _)        -> kin_alias_of(via, acc)
    _                                        -> acc
  })
}

fn kin_alias_of(via: KVia, acc: [String]) : [String] = match via {
  KvAlias(a, _) -> [a, ...acc]
  _          -> acc
}

fn kin_alias_names_ok(aliases: [String], ps: [KParam]) : Bool = match aliases {
  []           -> true
  [a, ...rest] -> kin_alias_param_ok(kir_alias_id_reg(a), ps) and kin_alias_names_ok(rest, ps)
}

fn kin_alias_param_ok(nm: String, ps: [KParam]) : Bool = match ps {
  [] -> false
  [p, ...rest] -> if p.name == nm {
    match p.origin { PCapture(_) -> true  _ -> false }
  } else { kin_alias_param_ok(nm, rest) }
}

fn kin_alias_caps_ok(aliases: [String], ps: [KParam], caps: [KVal]) : Bool = match aliases {
  []           -> true
  [a, ...rest] -> kin_alias_cap_is_self(kir_alias_id_reg(a), ps, caps) and kin_alias_caps_ok(rest, ps, caps)
}

fn kin_alias_cap_is_self(nm: String, ps: [KParam], caps: [KVal]) : Bool = match ps {
  [] -> false
  [p, ...rest] -> if p.name == nm {
    match p.origin {
      PCapture(j) -> match kin_val_at(caps, j) {
        KVar(cv) -> cv == nm
        _        -> false
      }
      _ -> false
    }
  } else { kin_alias_cap_is_self(nm, rest, caps) }
}

# --- Dead-closure sweep ---------------------------------------------------

# A closure binding (or a register alias of one) whose only remaining
# uses are its own dup/drop RC ops is dead: nothing calls, stores,
# passes or returns it. Removal keeps the closure's hold on its
# captures: the build and each dup become a dup of every capture, each
# drop a drop of every capture, so no capture is released before the
# closure would have been. A dead alias's RC ops move to the register it
# copies, which still owns the closure; only a dead build releases the
# captures. Runs to a bounded fixpoint: removing an alias exposes the
# closure build it read.
fn kin_dce_closures(bs: [KBlock]) : [KBlock] = kin_dce_fix(bs, 4)

fn kin_dce_fix(bs: [KBlock], fuel: Int) : [KBlock] =
  if fuel <= 0 { bs }
  else {
    let dead = kin_dce_candidates(kin_clo_env(bs), bs, kin_store_names(bs, []), [])
    match dead {
      [] -> bs
      _  -> kin_dce_fix(kin_dce_rewrite(bs, dead, []), fuel - 1)
    }
  }

# A re-stored capture register would hand the moved RC ops a different
# value than the one captured, so such a closure stays.
fn kin_dce_candidates(env: [KinClo], bs: [KBlock], stores: [String], acc: [KinClo]) : [KinClo] = match env {
  [] -> acc
  [KCl(n, sym, caps, src), ...rest] ->
    kin_dce_candidates(rest, bs, stores,
      if kin_name_used(bs, n) or kin_caps_stored(caps, stores) { acc }
      else { [KCl(n, sym, caps, src), ...acc] })
}

fn kin_caps_stored(caps: [KVal], stores: [String]) : Bool = match caps {
  []                 -> false
  [KVar(c), ...rest] -> list_has(stores, c) or kin_caps_stored(rest, stores)
  [_, ...rest]       -> kin_caps_stored(rest, stores)
}

# Any non-RC use of register `n` across the fn (op atoms, store
# values, terminator atoms). The closure's own dup/drop do not count.
fn kin_name_used(bs: [KBlock], n: String) : Bool = kir_reg_used(bs, n, false)

fn kin_dce_rewrite(bs: [KBlock], dead: [KinClo], acc: [KBlock]) : [KBlock] = match bs {
  []           -> list_reverse(acc)
  [b, ...rest] -> kin_dce_rewrite(rest, dead,
    [KBlock { label: b.label, stmts: kin_dce_stmts(b.stmts, dead, []), term: b.term,
              region_id: b.region_id }, ...acc])
}

fn kin_dce_stmts(ss: [KStmt], dead: [KinClo], acc: [KStmt]) : [KStmt] = match ss {
  []           -> list_reverse(acc)
  [s, ...rest] -> kin_dce_stmts(rest, dead, kin_dce_stmt(s, dead, acc))
}

fn kin_dce_stmt(s: KStmt, dead: [KinClo], acc: [KStmt]) : [KStmt] = match s {
  KLet(n, _, KClosure(_, _, _), pos) -> kin_dce_hold(dead, kin_clo_find(dead, n), true, pos, s, acc)
  KLet(n, _, KLitOp(KVar(_)), _)     -> match kin_clo_find(dead, n) { Some(_) -> acc  None -> [s, ...acc] }
  KRC(KDup(KVar(n)), pos)            -> kin_dce_hold(dead, kin_clo_find(dead, n), true, pos, s, acc)
  KRC(KDrop(KVar(n)), pos)           -> kin_dce_hold(dead, kin_clo_find(dead, n), false, pos, s, acc)
  _                                  -> [s, ...acc]
}

fn kin_dce_hold(dead: [KinClo], hit: Option[KinClo], dup: Bool, pos: KPos, s: KStmt, acc: [KStmt]) : [KStmt] = match hit {
  None -> [s, ...acc]
  Some(KCl(_, _, caps, src)) -> match src {
    None    -> kin_caps_rc(caps, dup, pos, acc)
    Some(m) -> kin_dce_hold(dead, kin_clo_find(dead, m), dup, pos, kin_rc_of(m, dup, pos), acc)
  }
}

fn kin_rc_of(n: String, dup: Bool, pos: KPos) : KStmt =
  KRC(if dup { KDup(KVar(n)) } else { KDrop(KVar(n)) }, pos)

fn kin_caps_rc(caps: [KVal], dup: Bool, pos: KPos, acc: [KStmt]) : [KStmt] = match caps {
  []                 -> acc
  [KVar(c), ...rest] -> kin_caps_rc(rest, dup, pos, [KRC(if dup { KDup(KVar(c)) } else { KDrop(KVar(c)) }, pos), ...acc])
  [_, ...rest]       -> kin_caps_rc(rest, dup, pos, acc)
}
