#[doc("""
How tall the operand chains of an expression stand, and which operands a
binding may rise past.

The operand forms are read in place rather than through `xp_positions`:
the height runs over every body the C backend emits.
""")]

import compiler.ast
import compiler.expr_positions

#[doc("The tallest operand chain an expression keeps before a `let` takes its bottom.")]
pub fn dh_max() : Int = 32

#[doc("The operand height of `e`, or above `dh_max` when any chain inside is taller.")]
pub fn dh_height(e: Expr) : Int = match e.kind {
  ECall(f, xs)     -> if dh_name(f) { 1 + dh_tallest(xs, 0) } else { dh_enclosed(e) }
  EBinop(op, a, b) -> if op == "and" or op == "or" { dh_enclosed(e) } else { 1 + dh_hi(dh_height(a), dh_height(b)) }
  EUnop(_, a)      -> 1 + dh_height(a)
  EField(a, _)     -> 1 + dh_height(a)
  EIndex(a, b)     -> 1 + dh_hi(dh_height(a), dh_height(b))
  EPipe(a, f)      -> {
    let rhs = dh_height(f)
    if rhs > dh_max() { rhs } else { 1 + dh_height(a) }
  }
  _                -> dh_literal_height(e)
}

fn dh_literal_height(e: Expr) : Int = match e.kind {
  EList(_)         -> 1 + dh_tallest_at(xp_positions(e), 0)
  ERecordLit(_, _, _) -> 1 + dh_tallest_at(xp_positions(e), 0)
  _                -> dh_enclosed(e)
}

# A node that keeps its bindings: height 1, unless a chain inside is too tall.
fn dh_enclosed(e: Expr) : Int = {
  let inner = dh_tallest_at(xp_positions(e), 0)
  if inner > dh_max() { inner } else { 1 }
}

fn dh_tallest(xs: [Expr], acc: Int) : Int = match xs {
  []           -> acc
  [x, ...rest] -> dh_tallest(rest, dh_hi(dh_height(x), acc))
}

fn dh_tallest_at(ps: [XPos], acc: Int) : Int = match ps {
  []                  -> acc
  [XP(_, c), ...rest] -> dh_tallest_at(rest, dh_hi(dh_height(c), acc))
}

#[doc("Whether `e` holds a past-i64 integer literal.")]
pub fn dh_has_wide_lit(e: Expr) : Bool = match e.kind {
  EIntLit(_) -> true
  _          -> any(xp_positions(e), (p) => match p { XP(_, c) -> dh_has_wide_lit(c) })
}

#[doc("The operands a binding may rise past, in evaluation order; `None` for a node that keeps its bindings to itself.")]
pub fn dh_operands(e: Expr) : Option[[Expr]] = match e.kind {
  ECall(f, xs)     -> if dh_name(f) { Some(xs) } else { None }
  EBinop(op, a, b) -> if op == "and" or op == "or" { None } else { Some([a, b]) }
  EUnop(_, a)      -> Some([a])
  EField(a, _)     -> Some([a])
  EIndex(a, b)     -> Some([a, b])
  EPipe(a, _)      -> Some([a])
  _                -> dh_literal_operands(e)
}

fn dh_literal_operands(e: Expr) : Option[[Expr]] = match e.kind {
  EList(els)        -> Some(map(els, (el) => match el { ElPlain(x) -> x  ElSpread(x) -> x }))
  ERecordLit(_, _, fs) -> Some(map(fs, (fi) => match fi { FI(_, v) -> v }))
  _                 -> None
}

fn dh_name(f: Expr) : Bool = match f.kind {
  EVar(_)          -> true
  ESym(_, _, _)    -> true
  EModCall(_, _)   -> true
  EField(base, _)  -> dh_name(base)
  _                -> false
}

#[doc("The larger of `a` and `b`.")]
pub fn dh_hi(a: Int, b: Int) : Int = if a > b { a } else { b }
