#[doc("""
The identity side of protocol dispatch.

An impl entry names the type it is for by the declaration its written
target denotes from the impl's module. A call dispatches on its
receiver's type the same way, by the `TyCon`'s identity. An entry serves
a receiver only when the two are one declaration, so a root `Pair` and
`core.tuple.Pair` share a name and never an impl. A scalar has no
declaration: an entry for one keeps the name its source wrote, and a
receiver is that scalar when the name spells it.

The registry is stamped with the resolver the typer stamps `TyCon`s
with, over the same table, so the two identities agree by construction
rather than by comparing spellings.

Two impls may still mint functions that spell alike, one for each of two
homonymous types. A root impl's function then names the root module in
its type part: the root file is read last, so no other module's symbols
depend on how the root spells its own.
""")]

import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_map
import compiler.symtab
import compiler.proto_ids
import compiler.scalar_ty
import compiler.type_home
import compiler.util
import compiler.written

#[doc("A dispatch receiver: the declaration a nominal head names, the scalar a head with no declaration is, or a refinement alias with the head it refines. An alias's own impls are tried before its base's.")]
pub(pkg) type DispHead = DhSym(SymId) | DhScalar(Ty) | DhAlias(SymId, DispHead)

#[doc("True when two dispatch receivers are the same head. An absent id is no head.")]
pub(pkg) fn dh_same(a: DispHead, b: DispHead) : Bool = match a {
  DhSym(x) -> match b {
    DhSym(y)      -> sym_raw(x) >= 0 and sym_raw(x) == sym_raw(y)
    DhAlias(y, base) -> (sym_raw(x) >= 0 and sym_raw(x) == sym_raw(y)) or dh_same(a, base)
    DhScalar(_)   -> false
  }
  DhScalar(t) -> match b {
    DhScalar(u)   -> dh_scalar_same(t, u)
    DhAlias(_, u) -> dh_same(a, u)
    DhSym(_)      -> false
  }
  DhAlias(x, base) -> dh_same(DhSym(x), b) or dh_same(base, b)
}

fn dh_scalar_same(t: Ty, u: Ty) : Bool = match scalar_ty_name(t) {
  Some(n) -> scalar_ty_name(u) == Some(n)
  None    -> false
}

#[doc("True when the registry reference `r` names the head `h`: a settled reference by its declaration, a written one when it spells the scalar `h` is.")]
pub(pkg) fn dh_ref_is(r: DeclRef, h: DispHead) : Bool = match r {
  DrSym(s) -> match h {
    DhSym(hs)        -> sym_raw(s) >= 0 and sym_raw(s) == sym_raw(hs)
    DhScalar(_)      -> false
    DhAlias(hs, base) -> (sym_raw(s) >= 0 and sym_raw(s) == sym_raw(hs)) or dh_ref_is(r, base)
  }
  DrWritten(None, w) -> match h {
    DhScalar(t) -> match scalar_ty_named(written_text(w)) {
      Some(u) -> dh_scalar_same(u, t)
      None    -> false
    }
    DhSym(_) -> false
    DhAlias(_, base) -> dh_ref_is(r, base)
  }
  DrWritten(Some(_), _) -> false
}

#[doc("How a diagnostic names the head `h`.")]
pub(pkg) fn dh_text(tab: SymTab, h: DispHead) : String = match h {
  DhSym(s)    -> written_text(decl_name(tab, s))
  DhScalar(t) -> match scalar_ty_name(t) {
    Some(n) -> n
    None    -> ""
  }
  DhAlias(s, _) -> dh_text(tab, DhSym(s))
}

fn dh_key(h: DispHead) : Int = match h {
  DhSym(s)    -> sym_raw(s)
  DhScalar(t) -> ii_scalar_key(t)
  DhAlias(s, _) -> sym_raw(s)
}

#[doc("The impl entries a lookup of `(proto, h)` must consider, in `impls` order. Empty when the index is unbuilt.")]
pub(pkg) fn ii_key_bucket(idx: ImplIndex, proto: SymId, h: DispHead) : [ProtoImplReg] = match h {
  DhAlias(_, base) -> list_append(ii_bucket(idx, proto, dh_key(h)), ii_key_bucket(idx, proto, base))
  _                -> ii_bucket(idx, proto, dh_key(h))
}

#[doc("The function an impl entry lowers to.")]
pub(pkg) fn pir_sym(p: ProtoImplReg) : SymId = match p { PIR(_, _, _, m, _, _, _) -> m }

#[doc("The protocol an impl entry belongs to; `sym_none()` when its written name resolved to none.")]
pub(pkg) fn pir_proto(p: ProtoImplReg) : SymId = match p { PIR(s, _, _, _, _, _, _) -> s }

#[doc("True when `p` is an impl of the protocol `proto`. An absent id is no protocol.")]
pub(pkg) fn pir_of_proto(p: ProtoImplReg, proto: SymId) : Bool =
  sym_raw(proto) >= 0 and sym_raw(pir_proto(p)) == sym_raw(proto)

#[doc("The identity a type's dispatch head carries: the `TyCon`'s id, looking through units and refinements.")]
pub(pkg) fn ty_head_sym(t: Ty) : SymId = match t {
  TyCon(s, _)        -> s
  TyListT(_)         -> core_ty_sym(CtList)
  TyDimT(base, _)    -> ty_head_sym(base)
  TyRefineT(base, _, _) -> ty_head_sym(base)
  _ -> sym_none()
}

#[doc("True when `p` is an impl for the receiver `h`.")]
pub(pkg) fn pir_serves(p: ProtoImplReg, h: DispHead) : Bool = match p {
  PIR(_, t, _, _, _, _, _) -> dh_ref_is(t, h)
}

#[doc("The registry with every impl entry's target, protocol arguments and return head settled to the type each names, read from `homes` at the impl's own module.")]
pub(pkg) fn reg_with_target_ids(reg: ProtocolReg, homes: TyHomes) : ProtocolReg = {
  let impls = map(reg.impls, (p) => pir_stamp(p, homes))
  ProtocolReg { ops: reg.ops, impls: impls, op_names: reg.op_names,
                tparams: reg.tparams, origins: reg.origins, dkeys: reg.dkeys,
                impl_index: build_impl_index(impls), cores: reg.cores,
                imports: reg.imports, root: reg.root,
                ids: pid_with_impls(reg.ids, impls, reg.root) }
}

#[doc("The registry restricted to `impls`.")]
pub(pkg) fn reg_with_impls(reg: ProtocolReg, impls: [ProtoImplReg]) : ProtocolReg =
  ProtocolReg { ops: reg.ops, impls: impls, op_names: reg.op_names,
                tparams: reg.tparams, origins: reg.origins, dkeys: reg.dkeys,
                impl_index: build_impl_index(impls), cores: reg.cores,
                imports: reg.imports, root: reg.root,
                ids: pid_with_impls(reg.ids, impls, reg.root) }

fn pir_stamp(p: ProtoImplReg, homes: TyHomes) : ProtoImplReg = match p {
  PIR(ps, t, o, m, ans, rh, home) -> {
    let v = tsh_view(homes, home)
    PIR(ps, ref_settled(v, t), o, m, map(ans, (a) => ref_settled(v, a)), ref_settled(v, rh), home)
  }
}

# A scalar has no declaration and stays as written.
fn ref_settled(v: TyHomeView, r: DeclRef) : DeclRef = match r {
  DrSym(_)        -> r
  DrWritten(_, n) -> {
    let s = tsh_sym(v, written_text(n))
    if sym_raw(s) >= 0 { DrSym(s) } else { r }
  }
}

#[doc("The type an impl method's call returns, headed by its declared return; none while that head is unsettled text.")]
pub(pkg) fn pir_ret_ty(p: ProtoImplReg) : Option[Ty] = match p {
  PIR(_, _, _, _, _, rh, _) -> match rh {
    DrSym(s)              -> Some(TyCon(s, []))
    DrWritten(None, w)    -> scalar_ty_named(written_text(w))
    DrWritten(Some(_), _) -> None
  }
}

#[doc("A root impl function another module's impl spells alike, and the row of the function it becomes.")]
pub(pkg) type ImplRename = ImplRename(SymId, NEnt)

#[doc("The renames that keep every impl function's spelling unique: each root entry whose function a non-root entry also spells takes the root module into its type part. `tab` holds the impl functions.")]
pub(pkg) fn impl_symbol_renames(impls: [ProtoImplReg], tab: SymTab, root: String) : [ImplRename] =
  isr_collect(impls, impls, tab, root, [])

fn isr_collect(ps: [ProtoImplReg], all: [ProtoImplReg], tab: SymTab, root: String,
      acc: [ImplRename]) : [ImplRename] = match ps {
  [] -> acc
  [p, ...rest] -> match p {
    PIR(_, _, op, m, _, _, None) -> {
      let spelled = written_text(sym_name(tab, m))
      if isr_has(acc, m) or not isr_minted_elsewhere(all, st_candidates(tab, NCFn, spelled)) {
        isr_collect(rest, all, tab, root, acc)
      } else {
        match isr_spell(written_text(op), spelled, root) {
          Some(n) -> isr_collect(rest, all, tab, root, [ImplRename(m, NEnt(NCFn, n, root, false, NmImpl)), ...acc])
          None    -> isr_collect(rest, all, tab, root, acc)
        }
      }
    }
    _ -> isr_collect(rest, all, tab, root, acc)
  }
}

# True when a non-root entry lowers to one of `cands`, the functions spelled like a root entry's.
fn isr_minted_elsewhere(ps: [ProtoImplReg], cands: [SymId]) : Bool = match ps {
  [] -> false
  [PIR(_, _, _, qm, _, _, qh), ...rest] -> match qh {
    Some(_) -> if isr_among(cands, qm) { true } else { isr_minted_elsewhere(rest, cands) }
    None    -> isr_minted_elsewhere(rest, cands)
  }
}

fn isr_among(ss: [SymId], s: SymId) : Bool = match ss {
  [] -> false
  [x, ...rest] -> sym_raw(x) == sym_raw(s) or isr_among(rest, s)
}

fn isr_has(rs: [ImplRename], m: SymId) : Bool = match rs {
  [] -> false
  [ImplRename(o, _), ...rest] -> if sym_raw(o) == sym_raw(m) { true } else { isr_has(rest, m) }
}

# `__pimpl_<key>_<type>` leads every impl symbol and `_<op>`, then any
# proto-arg suffix, ends it; the root module goes right after the type,
# so the op and the suffix stay put. None when the symbol is not so spelled.
fn isr_spell(op: String, m: String, root: String) : Option[String] = {
  let n = isr_op_at(m, concat_all(["_", op]))
  if n <= 0 { None }
  else { Some(concat_all([string_slice(m, 0, n), "__", root, string_slice(m, n, string_length(m) - n)])) }
}

# Where `tail`, the op, starts in `m`: at its end, or ahead of the proto-arg suffix.
fn isr_op_at(m: String, tail: String) : Int = {
  let n = string_length(m) - string_length(tail)
  if n > 0 and string_slice(m, n, string_length(tail)) == tail { n }
  else { string_find(m, concat_all([tail, "__a_"])) }
}

fn isr_row_sym(e: NEnt) : SymId = match e { NEnt(cls, name, home, _, _) -> sym_derive(cls, name, home) }

#[doc("The function the impl function `s` is after the renames `rs`: the renamed one, or `s` itself.")]
pub(pkg) fn impl_renamed(rs: [ImplRename], s: SymId) : SymId = match rs {
  [] -> s
  [ImplRename(o, row), ...rest] -> if sym_raw(o) == sym_raw(s) { isr_row_sym(row) } else { impl_renamed(rest, s) }
}

#[doc("The rows with each renamed root impl function under the name it takes.")]
pub(pkg) fn rows_with_renames(rows: [NEnt], rs: [ImplRename]) : [NEnt] = match rs {
  [] -> rows
  _  -> map(rows, (e) => isr_row_renamed(rs, isr_row_sym(e), e))
}

fn isr_row_renamed(rs: [ImplRename], s: SymId, e: NEnt) : NEnt = match rs {
  [] -> e
  [ImplRename(o, row), ...rest] -> if sym_raw(o) == sym_raw(s) { row } else { isr_row_renamed(rest, s, e) }
}

#[doc("The registry with each renamed root entry lowering to its new function.")]
pub(pkg) fn reg_with_renames(reg: ProtocolReg, rs: [ImplRename]) : ProtocolReg = match rs {
  [] -> reg
  _  -> ProtocolReg { ops: reg.ops, impls: map(reg.impls, (p) => pir_renamed(p, rs)),
                      op_names: reg.op_names, tparams: reg.tparams,
                      origins: reg.origins, dkeys: reg.dkeys,
                      impl_index: reg.impl_index, cores: reg.cores,
                      imports: reg.imports, root: reg.root, ids: reg.ids }
}

fn pir_renamed(p: ProtoImplReg, rs: [ImplRename]) : ProtoImplReg = match p {
  PIR(k, t, o, m, ans, rh, None) -> PIR(k, t, o, impl_renamed(rs, m), ans, rh, None)
  _ -> p
}

#[doc("The root file's declarations with each renamed impl function under its new identity, at its definition and at every reference. A bare name read in the root file denotes the root's own declaration, so the rename changes no reference's meaning.")]
pub(pkg) fn decls_with_renames(ds: [Decl], rs: [ImplRename]) : [Decl] = match rs {
  [] -> ds
  _  -> map(ds, (d) => decl_renamed(d, rs))
}

fn decl_renamed(d: Decl, rs: [ImplRename]) : Decl = match d {
  DFn(p, f, tp, ps, rt, row, body, l, c, nl, nc, None) ->
    DFn(p, FnId(impl_renamed(rs, fnid_sym(f)), fnid_inst(f)), tp, ps, rt, row, expr_renamed(body, rs), l, c, nl, nc, None)
  _ -> d
}

fn expr_renamed(e: Expr, rs: [ImplRename]) : Expr =
  Expr { kind: kind_renamed(e.kind, rs), line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn kind_renamed(k: ExprKind, rs: [ImplRename]) : ExprKind = match k {
  ESym(s, inst) -> ESym(impl_renamed(rs, s), inst)
  EName(w)      -> EName(isr_written(rs, w))
  _ -> prc_map_expr_kind(k, (sub) => expr_renamed(sub, rs))
}

# A name the root file has not resolved yet reads the root's own function.
fn isr_written(rs: [ImplRename], w: Written) : Written = match rs {
  [] -> w
  [ImplRename(_, NEnt(_, _, root, _, _)), ..._] -> isr_written_as(rs, sym_derive(NCFn, written_text(w), root), w)
}

fn isr_written_as(rs: [ImplRename], s: SymId, w: Written) : Written = match rs {
  [] -> w
  [ImplRename(o, NEnt(_, name, _, _, _)), ...rest] ->
    if sym_raw(o) == sym_raw(s) { written(name) } else { isr_written_as(rest, s, w) }
}

# O(1) lookup index over a ProtocolReg's immutable impl table (issue #916).
# reg.impls is one flat, prepend-built list of every registered impl. The
# post-inference rewrite scans it linearly per call site and per nominal
# cmp-binop, once per monomorphised spec. This module buckets the table once
# at the lower_protocols boundary so each scan consults a short bucket instead
# of the whole list. Equivalence to the linear scan rests on one invariant: a
# bucket holds its entries in the SAME order as reg.impls, so the first bucket
# entry matching a predicate is the first list entry matching it. The builder
# folds impls front-to-back and appends, preserving that order; the fine
# predicate (op + arg-names) runs over the bucket, as in the linear path.
# Single-line `#[doc(...)]` only — kaic1 still consumes the bundle and does
# not accept triple-quoted strings inside attributes.

# 256 is a fixed, power-of-two bucket count: deterministic (no input
# affects it), and comfortably larger than the ~hundred impls a self-
# compile registers, so collisions stay rare and buckets stay short.
fn ii_nbuckets() : Int = 256

#[doc("The unbuilt placeholder index. Lookups fall back to a linear scan.")]
pub(pkg) fn impl_index_empty() : ImplIndex =
  ImplIndex { by_key: array_make(0, []), nbuckets: 0 }

# `string_hash` is FNV-1a cast through int64_t, so it may be negative.
# `((h % n) + n) % n` lands in `[0, n)` for any sign; stage1 supports
# only `%` and `+`, so no bit ops here.
fn ii_slot(h: Int, n: Int) : Int = ((h % n) + n) % n

# The slot of a `(protocol, type)` key: the protocol by its identity,
# the type by its head key. Each part is reduced before the sum so it
# cannot overflow. Bucketing only affects distribution, never
# correctness: the fine `(protocol, type)` filter inside a bucket
# disambiguates any collision.
fn ii_key_slot(proto: SymId, head: Int, n: Int) : Int =
  ii_slot(ii_slot(sym_raw(proto), n) + ii_slot(head, n), n)

#[doc("The head key of a scalar type, which has no declaration; 0 for any other type.")]
fn ii_scalar_key(t: Ty) : Int = match scalar_ty_name(t) {
  Some(n) -> string_hash(n)
  None    -> 0
}

#[doc("The head key of the type a registry reference names: its declaration, a scalar's key for a written scalar, 0 while it is any other text.")]
fn ii_ref_key(r: DeclRef) : Int = match r {
  DrSym(s)              -> sym_raw(s)
  DrWritten(None, w)    -> match scalar_ty_named(written_text(w)) {
    Some(t) -> ii_scalar_key(t)
    None    -> 0
  }
  DrWritten(Some(_), _) -> 0
}

#[doc("Build the lookup index from an impl table. Bucket order mirrors `impls`.")]
pub(pkg) fn build_impl_index(impls: [ProtoImplReg]) : ImplIndex =
  ImplIndex { by_key: ii_fill(impls, array_make(ii_nbuckets(), [])), nbuckets: ii_nbuckets() }

# Fold `impls` front-to-back, appending each entry to the tail of its
# `(proto, type)` bucket. Appending (not prepending) is what preserves
# the `impls` order inside a bucket.
fn ii_fill(impls: [ProtoImplReg], by_key: Array[[ProtoImplReg]]) : Array[[ProtoImplReg]] / Mutable {
  match impls {
    [] -> by_key
    [pir, ...rest] -> match pir {
      PIR(proto, target, _, _, _, _, _) -> {
        let ks = ii_key_slot(proto, ii_ref_key(target), ii_nbuckets())
        ii_fill(rest, array_set(by_key, ks, list_append(array_get(by_key, ks), [pir])))
      }
    }
  }
}

#[doc("Impls sharing the `(protocol, head key)` slot, in `impls` order. Empty when unbuilt.")]
fn ii_bucket(idx: ImplIndex, proto: SymId, head: Int) : [ProtoImplReg] =
  if idx.nbuckets == 0 { [] }
  else { array_get(idx.by_key, ii_key_slot(proto, head, idx.nbuckets)) }

#[doc("True when the index is built (lookups use buckets, not the linear fallback).")]
pub(pkg) fn ii_built(idx: ImplIndex) : Bool = idx.nbuckets != 0
