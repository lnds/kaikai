#[doc("""
An interpolation body, read as Perceus reads any body.

A `#{...}` body stays source text until emit, so a parse of it names
everything by spelling. A name spelled as a binder in scope is a read of
that binder, the nearest one first. A binder the body declares itself is
numbered from its name: two bodies spelling one name share the binder, as
they shared the spelling. Any other name is a declaration's and stays as
written.
""")]

import compiler.ast
import compiler.written
import compiler.ast_map
import compiler.perceus_reads

#[doc("The parsed interpolation body `e` with each name that spells a binder of `scope`, or one the body declares, read as that binder. `scope` lists the nearest binder first.")]
pub fn pcs_span_expr(e: Expr, scope: [Binder]) : Expr =
  Expr { kind: psn_kind(e.kind, scope), line: e.line, col: e.col, ty: e.ty, mode: e.mode, site: e.site }

fn psn_kind(k: ExprKind, env: [Binder]) : ExprKind = match k {
  EName(w) -> match psn_find(env, written_text(w)) {
    Some(b) -> ELocal(b.id)
    None    -> k
  }
  ELambda(ps, body) -> {
    let ps1 = map(ps, psn_param)
    ELambda(ps1, pcs_span_expr(body, psn_with_params(ps1, env)))
  }
  EMatch(s, arms) -> EMatch(pcs_span_expr(s, env), map(arms, (a) => psn_arm(a, env)))
  EBlock(ss, ot)  -> psn_block(ss, ot, env, [])
  EHandle(body, eff, targs, init, alias, cls, ret) -> {
    let inner = list_append(env, pcs_handle_aliases(init))
    EHandle(pcs_span_expr(body, env), eff, targs, prc_map_opt_expr(init, (x) => pcs_span_expr(x, env)), alias,
            map(cls, (c) => psn_clause(c, inner)), psn_return(ret, inner))
  }
  _ -> prc_map_expr_kind(k, (c) => pcs_span_expr(c, env))
}

fn psn_find(env: [Binder], text: String) : Option[Binder] = match env {
  []           -> None
  [b, ...rest] -> if written_text(b.name) == text { Some(b) } else { psn_find(rest, text) }
}

fn psn_mint(b: Binder) : Binder = binder_minted(written_text(b.name))

fn psn_param(p: Param) : Param =
  Param { binder: psn_mint(p.binder), ptype: p.ptype, pline: p.pline, pcol: p.pcol, pborrow: p.pborrow }

fn psn_with_params(ps: [Param], env: [Binder]) : [Binder] = match ps {
  []           -> env
  [p, ...rest] -> [p.binder, ...psn_with_params(rest, env)]
}

fn psn_arm(a: Arm, env: [Binder]) : Arm = match a {
  Arm(pat, og, body) -> {
    let pat1 = psn_pat(pat)
    let env1 = prc_pat_bindings(pat1, env)
    Arm(pat1, prc_map_opt_expr(og, (g) => pcs_span_expr(g, env1)), pcs_span_expr(body, env1))
  }
}

fn psn_block(ss: [Stmt], ot: Option[Expr], env: [Binder], acc: [Stmt]) : ExprKind = match ss {
  [] -> EBlock(list_reverse(acc), prc_map_opt_expr(ot, (t) => pcs_span_expr(t, env)))
  [s, ...rest] -> match s {
    SLet(pat, te, rhs) -> {
      let pat1 = psn_pat(pat)
      psn_block(rest, ot, prc_pat_bindings(pat1, env), [SLet(pat1, te, pcs_span_expr(rhs, env)), ...acc])
    }
    SVar(b, te, rhs, l, c) -> {
      let b1 = psn_mint(b)
      psn_block(rest, ot, [b1, ...env], [SVar(b1, te, pcs_span_expr(rhs, env), l, c), ...acc])
    }
    _ -> psn_block(rest, ot, env, [prc_map_stmt_exprs(s, (x) => pcs_span_expr(x, env)), ...acc])
  }
}

fn psn_clause(c: HClause, env: [Binder]) : HClause = match c {
  HC(head, ps, body, l, col) -> {
    let ps1 = map(ps, psn_param)
    HC(head, ps1, pcs_span_expr(body, psn_with_params(ps1, env)), l, col)
  }
}

fn psn_return(ret: Option[HReturn], env: [Binder]) : Option[HReturn] = match ret {
  None -> None
  Some(HR(b, body, l, c)) -> {
    let b1 = psn_mint(b)
    Some(HR(b1, pcs_span_expr(body, [b1, ...env]), l, c))
  }
}

fn psn_pat(p: Pattern) : Pattern = Pattern { pkind: psn_pkind(p.pkind), line: p.line, col: p.col }

fn psn_pkind(k: PatKind) : PatKind = match k {
  PBind(b)              -> PBind(psn_mint(b))
  PList(ps, rest)       -> PList(map(ps, psn_pat), match rest { Some(b) -> Some(psn_mint(b))  None -> None })
  PVariant(r, ps)       -> PVariant(r, map(ps, psn_pat))
  PVariantRecord(r, fs) -> PVariantRecord(r, map(fs, psn_pfield))
  PRecord(fs)           -> PRecord(map(fs, psn_pfield))
  PAs(b, inner)         -> PAs(psn_mint(b), psn_pat(inner))
  PNarrow(b, te)        -> PNarrow(psn_mint(b), te)
  PSurface(sp)          -> PSurface(patsurface_rebuild(sp, map(patsurface_children(sp), psn_pat)))
  _                     -> k
}

fn psn_pfield(f: PField) : PField = match f { PField(n, p, sh) -> PField(n, psn_pat(p), sh) }
