#[doc("The scope of type names, and the table it is read from.")]

# compiler/type_scope.kai — module scoping for type names.
#
# Every annotation, record literal and type-qualified constructor path
# of a contested type name is settled to the declaration its module
# means (type_scope_table); transparent aliases settle unconditionally,
# gated on use-site arity so a 0-argument alias never captures a generic
# use. Runs on the parsed stream before the qualifier passes: a
# qualified `m.T` picks the home here, and the unscoped forms are left
# for those passes to validate and strip.

import compiler.util
import compiler.ast
import compiler.ast_decl
import compiler.ast_ids
import compiler.ast_decl
import compiler.ast_ids
import compiler.modules_paths
import compiler.modules_segments
import compiler.scope_view
import compiler.symtab
import compiler.written
import compiler.module_table
import compiler.infer_index

#[doc("Settle the contested type names of each import segment under its own module's viewpoint; the decls past the marks are the root file's. `sels` carries every file's selective imports, which outrank the plain import list on a contested bare name.")]
pub(pkg) fn ts_segmented(segs: [ImportSeg], decls: [Decl], coll: [TSEntry],
      tabs: ModTables, imps: [ModImports], target: String,
      cores: [String], sels: [SelImport]) : [Decl] =
  if list_length(coll) == 0 { decls }
  else { ts_seg_loop(segs, decls, coll, tabs, target, cores, imps, sels) }

fn ts_seg_loop(segs: [ImportSeg], decls: [Decl], coll: [TSEntry],
      tabs: ModTables, target: String,
      cores: [String], imps: [ModImports], sels: [SelImport]) : [Decl] = match segs {
  [] -> ts_decls(decls, ts_ctx(coll, target, target, cores, tabs, imps, sels))
  [ISeg(home, n), ...rest] -> {
    list_append(ts_decls(seg_take(decls, n),
                         ts_ctx(coll, home, target, cores, tabs, imps, sels)),
                ts_seg_loop(rest, seg_drop(decls, n), coll, tabs, target, cores,
                            imps, sels))
  }
}

fn ts_ctx(coll: [TSEntry], home: String, target: String, cores: [String],
      tabs: ModTables, imps: [ModImports],
      sels: [SelImport]) : TSCtx = {
  let owner = if home == target { "" } else { home }
  let mt = mtabs_of(tabs, owner).entries
  TSCtx { coll: coll, home: home, target: target, cores: cores,
          imports: ts_imports_of(imps, owner), picks: nt_picks_of(sels, owner, mt), mt: mt }
}

fn ts_imports_of(imps: [ModImports], owner: String) : [String] = match imps {
  [] -> []
  [MImp(o, names), ...rest] -> if o == owner { names } else { ts_imports_of(rest, owner) }
}

fn ts_decls(ds: [Decl], cx: TSCtx) : [Decl] = match ds {
  [] -> []
  [d, ...rest] -> [ts_decl(d, cx), ...ts_decls(rest, cx)]
}

fn ts_decl(d: Decl, cx: TSCtx) : Decl = decl_map_inner(d, (x) => ts_decl_leaf(x, cx))

fn ts_decl_leaf(d: Decl, cx: TSCtx) : Decl = match d {
  DFn(p, fid, tps, ps, ret, row, body, l, c, mo) ->
    DFn(p, fid, tps, ts_params(ps, cx), ts_ty_opt(ret, cx), ts_row(row, cx),
        ts_expr(body, sw_params(ps, []), cx), l, c, mo)
  DType(p, s, tps, body, l, c, mo, slots) -> DType(p, s, tps, ts_tbody(body, cx), l, c, mo, slots)
  DEffect(p, s, tps, ops, dblk, l, c, mo) ->
    DEffect(p, s, tps, map(ops, (o) => ts_eop(o, cx)), ts_dblk(dblk, cx), l, c, mo)
  DConst(p, s, ty, body, mo, l, c) -> DConst(p, s, ts_ty(ty, cx), ts_expr(body, [], cx), mo, l, c)
  DTest(n, body, l, c, mo)  -> DTest(n, ts_expr(body, [], cx), l, c, mo)
  DBench(n, body, l, c, mo) -> DBench(n, ts_expr(body, [], cx), l, c, mo)
  DCheck(n, ps, body, l, c, mo) ->
    DCheck(n, ts_params(ps, cx), ts_expr(body, sw_params(ps, []), cx), l, c, mo)
  DProtocol(p, s, tps, ops, l, c, mo) -> DProtocol(p, s, tps, map(ops, (o) => ts_pop(o, cx)), l, c, mo)
  DImpl(pn, tas, fty, subs, l, c, ss, isym) ->
    DImpl(pn, map(tas, (t) => ts_ty(t, cx)), ts_ty(fty, cx), ts_decls(subs, cx), l, c, ss, isym)
  DAxiom(p, sm, n, cso, tps, ps, ret, row, l, c) ->
    DAxiom(p, sm, n, cso, tps, ts_params(ps, cx), ts_ty(ret, cx), ts_row(row, cx), l, c)
  _ -> d
}

fn ts_eop(o: EffectOp, cx: TSCtx) : EffectOp = match o {
  EffOp(n, tps, ps, ret, l, c) -> EffOp(n, tps, ts_params(ps, cx), ts_ty(ret, cx), l, c)
}

fn ts_pop(o: ProtoOp, cx: TSCtx) : ProtoOp = match o {
  POp(n, tps, ps, ret, l, c) -> POp(n, tps, ts_params(ps, cx), ts_ty(ret, cx), l, c)
}

fn ts_dblk(o: Option[DefaultBlock], cx: TSCtx) : Option[DefaultBlock] = match o {
  None -> None
  Some(DBlk(hcs, ret, l, c)) ->
    Some(DBlk(sw_hclauses(hcs, [], (x, s) => ts_leaf(x, s, cx), (t) => ts_ty(t, cx), (r) => sw_head_same(r)),
              sw_hreturn_opt(ret, [], (x, s) => ts_leaf(x, s, cx), (t) => ts_ty(t, cx), (r) => sw_head_same(r)),
              l, c))
}

fn ts_tbody(b: TypeBody, cx: TSCtx) : TypeBody = match b {
  TBAlias(t) -> TBAlias(ts_ty(t, cx))
  TBRecord(fs) -> TBRecord(map(fs, (f) => ts_field(f, cx)))
  TBSum(vs) -> TBSum(map(vs, (v) => ts_variant(v, cx)))
  TBEffectAlias(ls) -> TBEffectAlias(ls)
}

fn ts_field(f: FieldDecl, cx: TSCtx) : FieldDecl = match f {
  FD(p, n, t, attrs) -> FD(p, n, ts_ty(t, cx), attrs)
}

fn ts_variant(v: Variant, cx: TSCtx) : Variant = match v {
  Var(c, ts) -> Var(c, map(ts, (t) => ts_ty(t, cx)))
}

fn ts_params(ps: [Param], cx: TSCtx) : [Param] =
  map(ps, (p) => Param { ...p, ptype: ts_ty_opt(p.ptype, cx) })

fn ts_ty_opt(o: Option[TypeExpr], cx: TSCtx) : Option[TypeExpr] = match o {
  None -> None
  Some(t) -> Some(ts_ty(t, cx))
}

fn ts_ty(t: TypeExpr, cx: TSCtx) : TypeExpr = {
  let k = match t.tkind {
    TyName(r, ts) -> TyName(ts_ref(r, list_length(ts), cx), map(ts, (x) => ts_ty(x, cx)))
    TyParam(p, ts) -> TyParam(p, map(ts, (x) => ts_ty(x, cx)))
    TyList(x) -> TyList(ts_ty(x, cx))
    TyFn(ps, r, row) -> TyFn(map(ps, (x) => ts_ty(x, cx)), ts_ty(r, cx), ts_row(row, cx))
    TyDim(x, u) -> TyDim(ts_ty(x, cx), u)
    TyRefine(x, pred) -> TyRefine(ts_ty(x, cx), pred)
    TyRow(row) -> TyRow(ts_row(row, cx))
    _ -> t.tkind
  }
  TypeExpr { tkind: k, line: t.line, col: t.col }
}

fn ts_row(r: RowExpr, cx: TSCtx) : RowExpr = match r {
  REmpty -> REmpty
  RClosed(ls) -> RClosed(map(ls, (l) => ts_label(l, cx)))
  ROpen(v, ls) -> ROpen(v, map(ls, (l) => ts_label(l, cx)))
}

fn ts_label(l: RowLabel, cx: TSCtx) : RowLabel = match l {
  RL(r, ts) -> RL(r, map(ts, (x) => ts_ty(x, cx)))
}

# A type head taking `nargs` type arguments: `m.T` picks the home, a bare
# `T` follows the ladder, and a head neither settles stays as written. A
# head already settled keeps its declaration.
fn ts_ref(r: DeclRef, nargs: Int, cx: TSCtx) : DeclRef = match r {
  DrSym(_)              -> r
  DrWritten(Some(m), n) -> ts_ref_qualified(r, written_text(m), written_text(n), nargs, cx)
  DrWritten(None, n)    -> match split_dotted_qualifier(written_text(n)) {
    Some(QSplit(m, bare)) -> ts_ref_qualified(r, m, bare, nargs, cx)
    None                  -> ts_ref_of(r, ts_resolve(cx, written_text(n), nargs))
  }
}

fn ts_ref_qualified(r: DeclRef, m: String, bare: String, nargs: Int, cx: TSCtx) : DeclRef =
  match ts_resolve_qualified(cx, m, bare, nargs) {
    Some(s) -> DrSym(s)
    None    -> r
  }

fn ts_ref_of(r: DeclRef, s: SymId) : DeclRef = if sym_raw(s) < 0 { r } else { DrSym(s) }

fn ts_expr(e: Expr, sh: [String], cx: TSCtx) : Expr =
  sw_expr(e, sh, (x, s) => ts_leaf(x, s, cx), (t) => ts_ty(t, cx), (r) => sw_head_same(r))

# A type-qualified constructor path: `T.Ctor` with `T` free and not a
# module, or `m.T.Ctor` with `m` free.
fn ts_leaf(e: Expr, sh: [String], cx: TSCtx) : Option[Expr] = match e.kind {
  EField(obj, f) -> match obj.kind {
    EName(w) ->
      if list_has(sh, written_text(w)) or ts_is_module(cx, written_text(w)) { None }
      else { ts_bare_path(e, obj, written_text(w), f, cx) }
    EField(inner, mid) -> ts_qualified_path(e, inner, mid, f, sh, cx)
    _ -> None
  }
  _ -> None
}

fn ts_bare_path(e: Expr, obj: Expr, n: String, f: String, cx: TSCtx) : Option[Expr] = {
  let s = ts_resolve(cx, n, 0)
  if sym_raw(s) < 0 { None }
  else { Some(ts_re(e, EField(ts_re(obj, ESym(s, spec_none())), f))) }
}

fn ts_qualified_path(e: Expr, inner: Expr, mid: String, f: String,
      sh: [String], cx: TSCtx) : Option[Expr] = match inner.kind {
  EName(w) ->
    if list_has(sh, written_text(w)) { None }
    else { match ts_resolve_qualified(cx, written_text(w), mid, 0) {
      Some(s) -> Some(ts_re(e, EField(ts_re(inner, ESym(s, spec_none())), f)))
      None -> None
    } }
  _ -> None
}

fn ts_re(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

#[doc("One scoped type declaration: `TSE(name, home, pub, arity, is_alias)`. Nominal entries exist only when contested; alias entries always. Root declarations carry the target module as home.")]
pub(pkg) type TSEntry = TSE(String, String, Bool, Int, Bool)

type TSCtx = { coll: [TSEntry], home: String, target: String, cores: [String],
                   imports: [String], picks: [NPick], mt: [ModuleEntry] }

#[doc("The type declarations of `decls` that carry per-home identity: contested nominals and aliases, plus every remaining transparent alias. Single-name bodies resolving to effects stay with the effect-alias machinery.")]
pub(pkg) fn ts_collect(decls: [Decl], tab: SymTab, target: String, effs: [String]) : [TSEntry] = {
  let all = ts_entries(decls, tab, target, effs, [])
  let kept = ts_keep_contested(all, all, [])
  ts_add_uncontested_aliases(all, kept, kept)
}

fn ts_entries(ds: [Decl], tab: SymTab, target: String, effs: [String], acc: [TSEntry]) : [TSEntry] = match ds {
  [] -> list_reverse(acc)
  [d, ...rest] -> ts_entries(rest, tab, target, effs, ts_entry(d, tab, target, effs, acc))
}

fn ts_entry(d: Decl, tab: SymTab, target: String, effs: [String], acc: [TSEntry]) : [TSEntry] = match decl_transparent_inner(d) {
  Some(inner) -> ts_entry(inner, tab, target, effs, acc)
  None -> match d {
    DType(p, s, tps, body, _, _, mo, _) ->
      if ts_scoped_body(body, effs) {
        [TSE(written_text(sym_name(tab, s)), match mo { Some(m) -> m  None -> target }, p,
             list_length(tps), ts_is_alias_body(body)), ...acc]
      } else { acc }
    _ -> acc
  }
}

fn ts_scoped_body(body: TypeBody, effs: [String]) : Bool = match body {
  TBRecord(_) -> true
  TBSum(_)    -> true
  TBAlias(t)  -> not ts_effect_named(t, effs)
  TBEffectAlias(_) -> false
}

fn ts_is_alias_body(body: TypeBody) : Bool = match body {
  TBAlias(_) -> true
  _          -> false
}

fn ts_effect_named(t: TypeExpr, effs: [String]) : Bool = match t.tkind {
  TyName(DrWritten(None, n), []) -> list_has(effs, written_text(n))
  _ -> false
}

fn ts_keep_contested(all: [TSEntry], todo: [TSEntry], acc: [TSEntry]) : [TSEntry] = match todo {
  [] -> list_reverse(acc)
  [e, ...rest] -> match e {
    TSE(n, home, _, _, _) ->
      if ts_other_home(all, n, home) { ts_keep_contested(all, rest, [e, ...acc]) }
      else { ts_keep_contested(all, rest, acc) }
  }
}

fn ts_other_home(t: [TSEntry], name: String, home: String) : Bool = match t {
  [] -> false
  [TSE(n, h, _, _, _), ...rest] ->
    if n == name and h != home { true } else { ts_other_home(rest, name, home) }
}

# An uncontested alias still settles always, so its name can never be
# captured by an unrelated module at expansion time.
fn ts_add_uncontested_aliases(all: [TSEntry], kept: [TSEntry], acc: [TSEntry]) : [TSEntry] =
  match all {
    [] -> acc
    [e, ...rest] -> match e {
      TSE(n, h, _, _, is_alias) ->
        if is_alias and not ts_declares(kept, n, h) {
          ts_add_uncontested_aliases(rest, kept, [e, ...acc])
        } else { ts_add_uncontested_aliases(rest, kept, acc) }
    }
  }

# The declaration `name` of `home` is, when the scope tells it from its
# homonyms: an entry of a module that is neither core nor root.
# `sym_none()` otherwise, and the name stays as written.
fn ts_scoped_sym(cx: TSCtx, name: String, home: String) : SymId =
  if home == cx.target or list_has(cx.cores, home) { sym_none() }
  else { match ts_entry_of(cx.coll, name, home) {
    Some(_) -> sym_derive(NCType, name, home)
    None    -> sym_none()
  } }

fn ts_entry_of(t: [TSEntry], name: String, home: String) : Option[TSEntry] =
  match t {
    [] -> None
    [e, ...rest] -> match e {
      TSE(n, h, _, _, _) ->
        if n == name and h == home { Some(e) } else { ts_entry_of(rest, name, home) }
    }
  }

fn ts_declares(t: [TSEntry], name: String, home: String) : Bool = match t {
  [] -> false
  [TSE(n, h, _, _, _), ...rest] ->
    if n == name and h == home { true } else { ts_declares(rest, name, home) }
}

# Only an alias entry is arity-gated: a 0-argument alias must not answer
# a generic use like `Option[Int]` (the generic core type wins those),
# and a parameterised alias must not answer a bare use. Nominal entries
# stay arity-agnostic, exactly as before.
fn ts_arity_ok(e: TSEntry, nargs: Int) : Bool = match e {
  TSE(_, _, _, arity, is_alias) -> not is_alias or arity == nargs
}

fn ts_resolve(cx: TSCtx, name: String, nargs: Int) : SymId =
  match ts_entry_of(cx.coll, name, cx.home) {
    Some(e) ->
      if ts_arity_ok(e, nargs) { ts_scoped_sym(cx, name, cx.home) }
      else { ts_resolve_imported(cx, name, nargs) }
    None -> ts_resolve_imported(cx, name, nargs)
  }

# A selective import naming the type outranks the plain import list:
# `import m.{T}` says which `T` the file means, so it decides even when
# a second import also exports one.
fn ts_resolve_imported(cx: TSCtx, name: String, nargs: Int) : SymId =
  match ts_imported(cx.coll, name, nargs, nt_pick_homes(cx.picks, name, []), []) {
    [h] -> ts_scoped_sym(cx, name, h)
    _   -> match ts_imported(cx.coll, name, nargs, cx.imports, []) {
      [h] -> ts_scoped_sym(cx, name, h)
      _   -> sym_none()
    }
  }

fn ts_imported(t: [TSEntry], name: String, nargs: Int, imports: [String],
      acc: [String]) : [String] = match t {
  [] -> acc
  [e, ...rest] -> match e {
    TSE(n, h, p, _, _) -> {
      let cand = n == name and p and list_has(imports, h)
      let ok = cand and ts_arity_ok(e, nargs) and not list_has(acc, h)
      if ok { ts_imported(rest, name, nargs, imports, [h, ...acc]) }
      else { ts_imported(rest, name, nargs, imports, acc) }
    }
  }
}

fn ts_resolve_qualified(cx: TSCtx, mod: String, name: String, nargs: Int) : Option[SymId] =
  match mt_lookup_member(cx.mt, mod, name) {
    None -> None
    Some(me) -> {
      let home = mt_member_home(cx.mt, mod, name)
      match ts_entry_of(cx.coll, name, home) {
        None -> None
        Some(e) ->
          if me_has_export(me, name) and ts_arity_ok(e, nargs) {
            Some(sym_derive(NCType, name, home))
          } else { None }
      }
    }
  }

fn ts_is_module(cx: TSCtx, name: String) : Bool = match mt_lookup(cx.mt, name) {
  Some(_) -> true
  None    -> false
}

# module scoping for bare value names. A free read of a contested function or
# constructor name is rewritten to `EModCall(home, name)`, the form that
# already carries a home through the typer, monomorph and codegen. The home
# comes from the reading module's own viewpoint, so a call reaches the
# declaration that module declared or imported, never the one that happened to
# register last. The walk is scope-aware: a lexical binder shadows every
# import, so a `let` named like an export is left alone rather than rewritten.
# That is what makes the viewpoint sound where a positional heuristic — only
# rewriting names in call position — is not.

#[doc("Rewrite each import segment's free reads of contested value names under its own module's viewpoint; the decls past the marks are the root file's.")]
pub(pkg) fn vs_segmented(segs: [ImportSeg], decls: [Decl], coll: [VSEntry],
      tabs: ModTables, imps: [ModImports], target: String,
      cores: [String]) : [Decl] =
  if list_length(coll) == 0 { decls }
  else { vs_seg_loop(segs, decls,
                     VSView { ix: vs_index(coll), target: target, cores: cores,
                              imps: imps, tabs: tabs }) }

# What every segment shares: the contested names and the three tables a
# viewpoint is cut from. Only the home varies per segment.
type VSView = { ix: NameIndex[VSEntry], target: String, cores: [String],
                imps: [ModImports], tabs: ModTables }

fn vs_view_ctx(v: VSView, home: String) : VSCtx =
  vs_ctx(v.ix, home, v.target, v.cores, v.imps, v.tabs)

fn vs_seg_loop(segs: [ImportSeg], decls: [Decl], v: VSView) : [Decl] = match segs {
  [] -> vs_decls(decls, vs_view_ctx(v, v.target))
  [ISeg(home, n), ...rest] -> {
    list_append(vs_decls(seg_take(decls, n), vs_view_ctx(v, home)),
                vs_seg_loop(rest, seg_drop(decls, n), v))
  }
}

# A name the reader's own home declares keeps its bare spelling: the
# typer already registers that declaration, and rewriting it would push
# every intra-module call through the qualified key for no gain.
#
# A module qualifier is not a value read: `map.from(...)` names the
# module `map`, which a contested function `map` must never displace.
# A name bound as a module therefore outranks every value of the same
# spelling, exactly as it does on the type side.
fn vs_leaf(e: Expr, sh: [String], cx: VSCtx) : Option[Expr] = match e.kind {
  EName(w) -> {
    let nm = written_text(w)
    if list_has(sh, nm) or vs_is_module(cx, nm) { Some(e) }
    else { match vs_resolve(cx, nm) {
      Some(h) -> if h == cx.home or h == cx.target or list_has(cx.cores, h) { Some(e) }
                 else { Some(vs_re(e, EModCall(written(h), w))) }
      None    -> Some(e)
    } }
  }
  _ -> None
}

fn vs_re(e: Expr, k: ExprKind) : Expr =
  Expr { kind: k, line: e.line, col: e.col, ty: e.ty, mode: e.mode,  site: e.site }

fn vs_expr(e: Expr, sh: [String], cx: VSCtx) : Expr =
  sw_expr(e, sh, (x, s) => vs_leaf(x, s, cx), (t) => t, (r) => r)

fn vs_decls(ds: [Decl], cx: VSCtx) : [Decl] = match ds {
  [] -> []
  [d, ...rest] -> [vs_decl(d, cx), ...vs_decls(rest, cx)]
}

fn vs_sub_decls(ds: [Decl], cx: VSCtx) : [Decl] = match ds {
  [] -> []
  [d, ...rest] -> [vs_decl(d, cx), ...vs_sub_decls(rest, cx)]
}

fn vs_decl(d: Decl, cx: VSCtx) : Decl = match d {
  DFn(p, n, tps, ps, ret, row, body, l, c, mo) ->
    DFn(p, n, tps, ps, ret, row, vs_expr(body, sw_params(ps, []), cx), l, c, mo)
  DConst(p, n, ty, body, mo, l, c) -> DConst(p, n, ty, vs_expr(body, [], cx), mo, l, c)
  DTest(n, body, l, c, mo)  -> DTest(n, vs_expr(body, [], cx), l, c, mo)
  DBench(n, body, l, c, mo) -> DBench(n, vs_expr(body, [], cx), l, c, mo)
  DCheck(n, ps, body, l, c, mo) ->
    DCheck(n, ps, vs_expr(body, sw_params(ps, []), cx), l, c, mo)
  DEffect(p, n, tps, ops, dblk, l, c, mo) -> match dblk {
    Some(DBlk(hcs, ret, bl, bc)) ->
      DEffect(p, n, tps, ops,
              Some(DBlk(vs_hclauses(hcs, cx), vs_hreturn_opt(ret, cx), bl, bc)), l, c, mo)
    None -> d
  }
  DImpl(pn, tas, fty, subs, l, c, ss, isym) -> DImpl(pn, tas, fty, vs_sub_decls(subs, cx), l, c, ss, isym)
  DDerive(ps, inner, l, c)       -> DDerive(ps, vs_decl(inner, cx), l, c)
  DUnstable(inner, l, c)         -> DUnstable(vs_decl(inner, cx), l, c)
  DProtoLaws(t, inner, l, c, mo) -> DProtoLaws(t, vs_decl(inner, cx), l, c, mo)
  DImplAxiom(t, inner, l, c, mo) -> DImplAxiom(t, vs_decl(inner, cx), l, c, mo)
  DConstructor(inner, l, c)      -> DConstructor(vs_decl(inner, cx), l, c)
  DDoc(r, t, inner, l, c)        -> DDoc(r, t, vs_decl(inner, cx), l, c)
  DAttr(r, inner, l, c)          -> DAttr(r, vs_decl(inner, cx), l, c)
  _ -> d
}

fn vs_hclauses(hcs: [HClause], cx: VSCtx) : [HClause] =
  sw_hclauses(hcs, [], (x, s) => vs_leaf(x, s, cx), (t) => t, (r) => r)

fn vs_hreturn_opt(o: Option[HReturn], cx: VSCtx) : Option[HReturn] =
  sw_hreturn_opt(o, [], (x, s) => vs_leaf(x, s, cx), (t) => t, (r) => r)

# which module a bare value name means from one module's viewpoint. A function
# or constructor name is registered globally by its bare spelling, so two
# modules exporting one name shadow each other and the last registration wins.
# Import order alone then decides which one a call reaches, and a module can
# reach a name it never imported. The viewpoint fixes that: a bare name
# resolves against the reader's own declarations and the modules that reader
# actually imports, never against the whole program. The ladder mirrors the
# type side — own home first, then the single visible import that exports it —
# so both name sides answer a bare use the same way.

#[doc("One value declaration that carries per-home identity: `VSE(name, home, pub)`. Entries exist only for names two homes both declare.")]
pub(pkg) type VSEntry = VSE(String, String, Bool)

#[doc("What one module sees when it reads a bare value name: the contested declarations by name, its own home, the root's, the core homes, the tagged names of its imports, and its qualifier table.")]
type VSCtx = { ix: NameIndex[VSEntry], home: String, target: String,
                   cores: [String], imports: [String], mt: ModTable }

#[doc("The value declarations of `decls` whose bare name another home also declares, in stream order; `tab` holds their names. An uncontested name needs no viewpoint.")]
pub(pkg) fn vs_collect(decls: [Decl], tab: SymTab, target: String) : [VSEntry] {
  let all = vs_entries(nt_collect(decls, tab, target), [])
  vs_keep_contested(vs_index(all), all, [])
}

# Functions and constructors share one namespace at a use site, so both
# classes enter the table; a const is keyed by its own pass.
fn vs_entries(es: [NEnt], acc: [VSEntry]) : [VSEntry] = match es {
  [] -> list_reverse(acc)
  [NEnt(c, n, h, p, _), ...rest] ->
    if vs_is_value(c) { vs_entries(rest, [VSE(n, h, p), ...acc]) }
    else { vs_entries(rest, acc) }
}

fn vs_is_value(c: NCls) : Bool = match c {
  NCFn   -> true
  NCCtor -> true
  _      -> false
}

fn vs_keep_contested(ix: NameIndex[VSEntry], todo: [VSEntry], acc: [VSEntry]) : [VSEntry] =
  match todo {
    [] -> list_reverse(acc)
    [e, ...rest] -> match e {
      VSE(n, h, _) ->
        if vs_other_home(idx_chain(ix, n), n, h) { vs_keep_contested(ix, rest, [e, ...acc]) }
        else { vs_keep_contested(ix, rest, acc) }
    }
  }

fn vs_other_home(t: [VSEntry], name: String, home: String) : Bool = match t {
  [] -> false
  [VSE(n, h, _), ...rest] ->
    if n == name and h != home { true } else { vs_other_home(rest, name, home) }
}

#[doc("True when `home` declares `name` in the contested table.")]
fn vs_declares(t: [VSEntry], name: String, home: String) : Bool = match t {
  [] -> false
  [VSE(n, h, _), ...rest] ->
    if n == name and h == home { true } else { vs_declares(rest, name, home) }
}

#[doc("A value table keyed by name, each chain in stream order.")]
fn vs_index(coll: [VSEntry]) : NameIndex[VSEntry] =
  vs_index_loop(list_reverse(coll), idx_empty())

# A chain is newest-first, so prepending in reverse leaves it in stream order.
fn vs_index_loop(es: [VSEntry], ix: NameIndex[VSEntry]) : NameIndex[VSEntry] = match es {
  [] -> ix
  [e, ...rest] -> match e { VSE(n, _, _) -> vs_index_loop(rest, idx_prepend(ix, n, e)) }
}

#[doc("The home a bare `name` denotes from the context's viewpoint, or `None` when no rule settles it: the reader's own declaration wins, else the single visible import that exports it. Several visible exporters leave the name contested for the report.")]
fn vs_resolve(cx: VSCtx, name: String) : Option[String] = {
  let es = idx_chain(cx.ix, name)
  if vs_declares(es, name, cx.home) { Some(cx.home) }
  else { match vs_visible_homes(es, name, cx.imports, []) {
    [h] -> Some(h)
    _   -> None
  } }
}

#[doc("The homes that export `name` and are visible to the reader, deduplicated. More than one means the bare use cannot be settled by import alone.")]
fn vs_visible_homes(t: [VSEntry], name: String, imports: [String],
      acc: [String]) : [String] = match t {
  [] -> list_reverse(acc)
  [VSE(n, h, p), ...rest] ->
    if n == name and p and list_has(imports, h) and not list_has(acc, h) {
      vs_visible_homes(rest, name, imports, [h, ...acc])
    } else { vs_visible_homes(rest, name, imports, acc) }
}

#[doc("The tagged names one module imports directly, from the per-file import view.")]
fn vs_imports_of(imps: [ModImports], owner: String) : [String] = match imps {
  [] -> []
  [MImp(o, names), ...rest] -> if o == owner { names } else { vs_imports_of(rest, owner) }
}

#[doc("One module's viewpoint over the contested value names.")]
fn vs_ctx(ix: NameIndex[VSEntry], home: String, target: String, cores: [String],
      imps: [ModImports], tabs: ModTables) : VSCtx {
  let owner = if home == target { "" } else { home }
  VSCtx { ix: ix, home: home, target: target, cores: cores,
          imports: vs_imports_of(imps, owner), mt: mtabs_of(tabs, owner) }
}

#[doc("True when `name` is bound as a module in the context's qualifier table. A module qualifier outranks a value of the same spelling, so `map.from(...)` keeps its qualifier even where `map` is also a contested function.")]
fn vs_is_module(cx: VSCtx, name: String) : Bool = match mtab_lookup(cx.mt, name) {
  Some(_) -> true
  None    -> false
}

#[doc("The package of every module, as the directory of the nearest `kai.toml`; empty when no declaration is exported to its package alone, so a program without one pays nothing.")]
pub(pkg) fn package_picks(rows: [NEnt], mods: [ModuleEntry], root_path: String, root_home: String) : [SvPick] / File =
  if any(rows, is_package_row) {
    [SvPick(package_root(abspath(root_path)), st_module_id(root_home)),
     ...flat_map(mods, (m) => match m {
       ME(home, _, origin, _) -> [SvPick(package_root(origin), st_module_id(home))]
     })]
  } else { [] }

#[doc("The markers of the exports the rows of the module at `path` declare `pub(pkg)`, each naming the package that sees it.")]
pub(pkg) fn package_markers(rows: [NEnt], path: String) : [String] / File =
  if any(rows, is_package_row) {
    let root = package_root(path)
    flat_map(rows, (e) => match e { NEnt(_, name, _, _, mint) -> if mint_package(mint) { [pkg_marker(root, name)] } else { [] } })
  } else { [] }

#[doc("The package a reader at `path` belongs to; empty when the module it reads keeps nothing to its package, so the answer is never looked up for nothing.")]
pub(pkg) fn reader_root(marks: [String], path: String) : String / File =
  if list_is_empty(marks) { "" } else { package_root(path) }

fn is_package_row(e: NEnt) : Bool = match e {
  NEnt(_, _, _, _, mint) -> mint_package(mint)
}
