#[doc("Lints for idiom: dead code, effects and recursion that is not in tail position.")]

import compiler.ast
import compiler.ast_build
import compiler.ast_decl
import compiler.ast_ids
import compiler.written
import compiler.symtab
import compiler.expr_positions
import compiler.diag_file
import compiler.util
import compiler.call_site_target
import compiler.core_types
import compiler.trmc_self_call
import compiler.ret_slots
import compiler.ctor_ix

# A single lint hit, addressed by source position. The first field
# names the lint so it can be allowed/denied individually.
pub(pkg) type LintFinding = LF(String, Int, Int, String)

#[doc("A lint finding paired with the source file that declares it.")]
pub(pkg) type FileFinding = FF(String, LintFinding)

#[doc("The id of the constructor `name` the runtime builds (`Some`, `None`, `Ok`, `Err`), which no declaration spells.")]
pub(pkg) fn lint_core_ctor(name: String) : SymId = sym_derive(NCCtor, name, core_type_home())

#[doc("Idiom-nudge findings rooted at this node (point-free, and_then→map); children are visited by the caller's walk. `tab` names the function a call reaches.")]
pub(pkg) fn idiom_findings(e: Expr, tab: SymTab) : [LintFinding] {
  match e.kind {
    EDispatchPipe(_, _, f) -> pf_nudge(f)
    ECall(callee, cargs) -> call_nudges(e, callee, cargs, tab)
    _                   -> []
  }
}

# A combinator call carries two nudges: its function argument may be a
# point-free candidate, and an `and_then` whose lambda always wraps in
# `Some` is a `map` in disguise. The function is the call's last
# argument.
fn call_nudges(e: Expr, callee: Expr, cargs: [Expr], tab: SymTab) : [LintFinding] {
  match fn_arg_of(cargs) {
    None    -> []
    Some(f) -> {
      let pf = if callee_is_combinator(callee, tab) { pf_nudge(f) } else { [] }
      let am = if callee_named(callee, tab, "and_then") or callee_named(callee, tab, "flat_map") { at_map_nudge(e, f) } else { [] }
      list_append(pf, am)
    }
  }
}

# ---- point_free_nudge ------------------------------------------------

# A lambda whose whole body is a field chain over its single
# parameter reads cleaner as a leading-dot section (`.name`,
# `.addr.city`).
fn pf_nudge(f: Expr) : [LintFinding] {
  match f.kind {
    ELambda(ps, body) -> pf_lambda(f, ps, body)
    _                  -> []
  }
}

# A unary lambda whose param is user-written and whose body is a
# point-free chain over that param. A point-free section desugars to a
# lambda over the parser's own binder, so a lambda binding it is ALREADY
# point-free and must never be nudged.
fn pf_lambda(f: Expr, ps: [Param], body: Expr) : [LintFinding] {
  match ps {
    [p] ->
      if params_point_free(ps) { [] }
      else if pf_chain(body, p.binder.id) {
        [LF("point_free_nudge", f.line, f.col,
            "lambda is a field access on its argument; a point-free section reads cleaner")]
      } else { [] }
    _ -> []
  }
}

fn is_unary(ps: [Param]) : Bool {
  match ps {
    []           -> false
    [_, ...rest] -> match rest { [] -> true _ -> false }
  }
}

# A point-free chain is a field chain rooted exactly at the parameter.
fn pf_chain(body: Expr, pn: LocalId) : Bool {
  match body.kind {
    EField(base, _) -> pf_receiver(base, pn)
    _               -> false
  }
}

# The receiver is either the bare parameter (chain root) or a further
# field link over it.
fn pf_receiver(base: Expr, pn: LocalId) : Bool {
  match base.kind {
    ELocal(l) -> local_eq(l, pn)
    _         -> pf_chain(base, pn)
  }
}

# ---- and_then_to_map_nudge -------------------------------------------

# `o.and_then((x) => Some(expr))` is `o.map((x) => expr)` when the lambda
# ALWAYS returns `Some(...)`. If any return position can yield `None`
# (or a non-`Some` value), the rewrite changes meaning and is not made.
fn at_map_nudge(e: Expr, f: Expr) : [LintFinding] {
  match f.kind {
    ELambda(ps, body) ->
      if is_unary(ps) and always_some(body) {
        [LF("and_then_to_map_nudge", e.line, e.col,
            "and_then whose function always wraps its result in Some; use map")]
      } else { [] }
    _ -> []
  }
}

# Every tail position of the body is a `Some(_)` construction. `if`
# without an else, a block without a tail, or a non-`Some` tail all read
# as "can be other than Some" and stop the nudge.
fn always_some(body: Expr) : Bool {
  match body.kind {
    EIf(_, t, Some(el)) -> always_some(t) and always_some(el)
    EMatch(_, arms)     -> all_arms_some(arms)
    EBlock(_, Some(t))  -> always_some(t)
    ECall(c, cargs)     -> is_some_ctor(c, cargs)
    _                   -> false
  }
}

fn is_some_ctor(c: Expr, cargs: [Expr]) : Bool {
  match c.kind {
    ESym(s, _) -> sym_same(s, lint_core_ctor("Some")) and arity_one(cargs)
    _          -> false
  }
}

fn arity_one(xs: [Expr]) : Bool {
  match xs {
    []           -> false
    [_, ...rest] -> match rest { [] -> true _ -> false }
  }
}

fn all_arms_some(arms: [Arm]) : Bool {
  match arms {
    []           -> true
    [a, ...rest] -> always_some(arm_body(a)) and all_arms_some(rest)
  }
}

fn arm_body(a: Arm) : Expr {
  match a {
    Arm(_, _, b) -> b
  }
}

# ---- callee recognition ----------------------------------------------
#
# A combinator is any function DECLARED under the name, in any module, a
# user's own included: after inference the call reads as a reference to
# that declaration. The pre-rewrite `EField(_, name)` is matched too so
# the lint is independent of how far the typer has rewritten the call.

fn callee_is_combinator(callee: Expr, tab: SymTab) : Bool {
  callee_named(callee, tab, "map") or callee_named(callee, tab, "filter") or callee_named(callee, tab, "and_then") or callee_named(callee, tab, "flat_map")
}

fn callee_named(callee: Expr, tab: SymTab, name: String) : Bool {
  match callee.kind {
    EField(_, n) -> n == name
    ESym(s, _)   -> written_text(decl_name(tab, s)) == name
    _            -> false
  }
}

# ---- small helpers ---------------------------------------------------

# The function argument of a combinator call is its last argument: after
# inference `o.map(f)` reads as `map(o, f)`, and pre-rewrite as `o.map(f)`
# with a single arg. Either way the function is last.
fn fn_arg_of(cargs: [Expr]) : Option[Expr] {
  match cargs {
    []           -> None
    [x, ...rest] -> match rest {
      []  -> Some(x)
      _   -> fn_arg_of(rest)
    }
  }
}

fn any_mentions(xs: [Expr], pn: LocalId) : Bool {
  match xs {
    []           -> false
    [x, ...rest] -> if mentions(x, pn) { true } else { any_mentions(rest, pn) }
  }
}

# Does `pn` appear free anywhere in `e`? Lambda params can shadow it,
# but the only callers pass method-argument expressions, where a shadow
# binding of the chain's own parameter would be a different variable; a
# conservative structural scan is enough to keep the nudge sound.
fn mentions(e: Expr, pn: LocalId) : Bool {
  match e.kind {
    ELocal(l) -> local_eq(l, pn)
    EOp(r)    -> op_reads(r.via, pn)
    _         -> any_position_mentions(xp_positions(e), pn)
  }
}

# An operation performed through a local reads it.
fn op_reads(via: OpVia, pn: LocalId) : Bool {
  match via {
    ViaAmbient  -> false
    ViaAlias(a) -> local_eq(a, pn)
    ViaRecv(x)  -> local_eq(x, pn)
  }
}

fn any_position_mentions(xs: [XPos], pn: LocalId) : Bool {
  match xs {
    []                  -> false
    [XP(_, x), ...rest] -> if mentions(x, pn) { true } else { any_position_mentions(rest, pn) }
  }
}

# `LintFinding` is defined in `compiler.lint_idiom` and shared by every
# lint module.

#[doc("dead_code_unused_priv findings over the decls a unit owns, each paired with the file declaring it. Reachability is judged against `all` — every decl in the unit — so a private fn referenced from anywhere is alive. `tab` names a function in its finding; `root` is the root module.")]
pub(pkg) fn deadcode_file_findings(owned: [Decl], all: [Decl], tab: SymTab, declared: [SymId],
                               df: DiagFiles, root: String) : [FileFinding] {
  let cx = DcCx { tab: tab, used: collect_used(all, []), declared: declared, roots: roots_of(root, []) }
  dc_file_loop(owned, cx, df, [])
}

type DcCx = { tab: SymTab, used: [SymId], declared: [SymId], roots: Roots }

fn dc_file_loop(ds: [Decl], cx: DcCx, df: DiagFiles, acc: [FileFinding]) : [FileFinding] = match ds {
  [] -> list_reverse(acc)
  [d, ...rest] -> {
    let here = dc_decl(d, cx, [])
    dc_file_loop(rest, cx, df, dc_tag(here, decl_diag_file(d, df), acc))
  }
}

fn dc_tag(xs: [LintFinding], file: String, acc: [FileFinding]) : [FileFinding] = match xs {
  [] -> acc
  [x, ...rest] -> dc_tag(rest, file, [FF(file, x), ...acc])
}

# ---- the declared set ------------------------------------------------
#
# The fns the source declares at top level, read off the AST as the
# parser produced it (before protocol lowering synthesises its own).
# Attribute wrappers are transparent; an `impl`/`derive` body is not
# descended into, because its methods are not top-level declarations.

#[doc("The top-level fns a source AST declares, seeing through attribute wrappers. Methods inside `impl` / `derive` are excluded: they are lowered into top-level DFns but the user never declared them as such.")]
pub(pkg) fn deadcode_declared_fns(decls: [Decl]) : [SymId] =
  declared_loop(decls, [])

fn declared_loop(decls: [Decl], acc: [SymId]) : [SymId] {
  match decls {
    []           -> acc
    [d, ...rest] -> declared_loop(rest, declared_in_decl(d, acc))
  }
}

fn declared_in_decl(d: Decl, acc: [SymId]) : [SymId] {
  match d {
    DFn(_, fid, _, _, _, _, _, _, _, _) -> [fnid_sym(fid), ...acc]
    DUnstable(inner, _, _)               -> declared_in_decl(inner, acc)
    DConstructor(inner, _, _)            -> declared_in_decl(inner, acc)
    DDoc(_, _, inner, _, _)              -> declared_in_decl(inner, acc)
    _                                    -> acc
  }
}

# ---- the reference set -----------------------------------------------
#
# What any fn, test, bench or check body references: the declaration a
# resolved reference names, by id. A private function the set does not
# hold is referenced nowhere and is dead; a local binder spelled like it
# is no reference to it.

fn collect_used(decls: [Decl], acc: [SymId]) : [SymId] {
  match decls {
    []           -> acc
    [d, ...rest] -> collect_used(rest, used_in_decl(d, acc))
  }
}

fn used_in_decl(d: Decl, acc: [SymId]) : [SymId] {
  match d {
    DFn(_, _, _, _, _, _, body, _, _, _) -> names_in_expr(body, acc)
    DTest(_, body, _, _, _)              -> names_in_expr(body, acc)
    DBench(_, body, _, _, _)             -> names_in_expr(body, acc)
    DCheck(_, _, body, _, _, _)          -> names_in_expr(body, acc)
    _                                    -> acc
  }
}

fn names_in_expr(e: Expr, acc: [SymId]) : [SymId] =
  names_in_positions(xp_positions(e), name_here(e, acc))

fn name_here(e: Expr, acc: [SymId]) : [SymId] = match callee_id(e) {
  Some(s) -> [s, ...acc]
  None    -> acc
}

fn names_in_positions(xs: [XPos], acc: [SymId]) : [SymId] {
  match xs {
    []                  -> acc
    [XP(_, x), ...rest] -> names_in_positions(rest, names_in_expr(x, acc))
  }
}

fn dc_has_id(ids: [SymId], s: SymId) : Bool = match ids {
  []           -> false
  [x, ...rest] -> if sym_raw(x) == sym_raw(s) { true } else { dc_has_id(rest, s) }
}

# ---- the unused scan -------------------------------------------------

# A private function (not pub, not the root module's `main`) no reference
# names is dead code. pub functions are reachable from other modules.
fn dc_decl(d: Decl, cx: DcCx, acc: [LintFinding]) : [LintFinding] {
  match d {
    DFn(is_pub, fid, _, _, _, _, _, line, col, mo) ->
      if dc_is_dead(is_pub, is_root_main(cx.roots, fid), fnid_sym(fid), cx) {
        [LF("dead_code_unused_priv", line, col,
            concat_all(["private function `", written_text(decl_name(cx.tab, fnid_sym(fid))), "` is never used; remove it or export it",
                        dc_imported_main(cx.roots, mo, fid)])), ...acc]
      } else { acc }
    _ -> acc
  }
}

fn dc_imported_main(roots: Roots, mo: Option[String], fid: FnId) : String =
  if is_imported_main(roots, mo, fid) { " (#{imported_main_note()})" } else { "" }

# The lint runs on the lowered AST, where an `impl`/`derive` method has
# already become a top-level `__pimpl_*` DFn indistinguishable from a
# private fn. Requiring the fn in `declared` — the fns the source
# text itself declares at top level — is what keeps the two apart: the
# remedies the message proposes only exist for a fn the user wrote.
fn dc_is_dead(is_pub: Bool, root_main: Bool, s: SymId, cx: DcCx) : Bool =
  not is_pub and not root_main and dc_has_id(cx.declared, s) and not dc_has_id(cx.used, s)

# `LintFinding` is defined in `compiler.lint_idiom` and shared by every
# lint module.

#[doc("Effect-row findings over a typed program's root-file public functions, given the table that names them and the root module name.")]
pub(pkg) fn effect_findings(decls: [Decl], tab: SymTab, root_mod: String) : [LintFinding] =
  scan_overdeclared(decls, tab, root_mod, [])

# ---- the over-declared scan ------------------------------------------

fn scan_overdeclared(decls: [Decl], tab: SymTab, root_mod: String, acc: [LintFinding]) : [LintFinding] {
  match decls {
    []           -> list_reverse(acc)
    [d, ...rest] -> scan_overdeclared(rest, tab, root_mod, fx_decl(d, tab, root_mod, acc))
  }
}

# A public root-file function whose declared row carries a closed,
# monomorphic label that ITS OWN body never demands over-declares it. The
# used-set is per-function: the typer already stamped each call's row, so
# an effect reached through a helper shows on that helper-call's type and
# counts as used. An open row (a tail variable) or a parametric label is
# left alone — the typer may satisfy it in ways this scan cannot see.
fn fx_decl(d: Decl, tab: SymTab, root_mod: String, acc: [LintFinding]) : [LintFinding] {
  match d {
    DFn(is_pub, fid, _, _, _, row, body, line, col, mo) ->
      if is_pub and fx_is_root_origin(mo, root_mod) {
        fx_labels(declared_closed_labels(row), FxFn(tab, fnid_sym(fid), line, col), effects_in_expr(body, []), acc)
      } else { acc }
    _ -> acc
  }
}

# A root-file decl: unstamped, or stamped with the root module's own name
# (pub root decls carry `Some(root_mod)`).
fn fx_is_root_origin(mo: Option[String], root_mod: String) : Bool {
  match mo {
    None    -> true
    Some(m) -> m == root_mod
  }
}

# Each declared label absent from the used-set is over-declared. `Ffi`
# carries its own lint id and message; every other effect is
# effect_over_declared.
fn fx_labels(labels: [RowLabel], f: FxFn, used: [SymId], acc: [LintFinding]) : [LintFinding] {
  match labels {
    []           -> acc
    [l, ...rest] -> {
      let a1 = if mem_sym(rl_sym(l), used) { acc } else { [fx_finding(l, f), ...acc] }
      fx_labels(rest, f, used, a1)
    }
  }
}

# The function a finding is about: the table that names it, its id, its position.
type FxFn = FxFn(SymTab, SymId, Int, Int)

fn fx_finding(l: RowLabel, f: FxFn) : LintFinding = match f {
  FxFn(tab, s, line, col) -> {
    let fn_name = written_text(decl_name(tab, s))
    if effect_is(rl_sym(l), CeFfi) {
      LF("effect_ffi_without_extern", line, col,
         concat_all(["pub fn `", fn_name, "` declares `/ Ffi` but its body calls no extern function"]))
    } else {
      LF("effect_over_declared", line, col,
         concat_all(["pub fn `", fn_name, "` declares effect `", written_text(fx_label_text(tab, l)), "` its body never uses"]))
    }
  }
}

fn fx_label_text(tab: SymTab, l: RowLabel) : Written = match l {
  RL(DrSym(s), _)        -> decl_name(tab, s)
  RL(DrWritten(_, n), _) -> n
}

# ---- declared row ----------------------------------------------------
#
# Only a CLOSED row contributes labels; an open row (tail variable) is a
# polymorphic promise the body may satisfy elsewhere, so it is skipped
# entirely (conservative: no labels => no findings).

fn declared_closed_labels(row: RowExpr) : [RowLabel] {
  match row {
    RClosed(ls) -> ls
    REmpty      -> []
    ROpen(_, _) -> []
  }
}

# ---- effects demanded by a body --------------------------------------
#
# An effect is demanded when the body performs one of its ops, calls a
# function whose resolved type carries it in its row, or installs a
# handler for it. Mirrors `lint.kai`'s purity sources, but collects the
# effect declarations rather than a yes/no.

fn effects_in_expr(e: Expr, acc: [SymId]) : [SymId] {
  let a1 = effects_here(e, acc)
  effects_in_positions(xp_positions(e), a1)
}

# An `EExternBody` is the body of an `extern "C" fn`: it IS the foreign
# call, so it demands `Ffi` even though there is no `ECall` node.
fn effects_here(e: Expr, acc: [SymId]) : [SymId] {
  match e.kind {
    EOp(r)           -> [r.eff, ...acc]
    ECall(callee, _) -> add_callee_effects(callee, acc)
    EHandle(_, head, _, _, _, _, _) -> [ref_sym(head), ...acc]
    EExternBody(AbiC, _)  -> [core_effect_id(CeFfi), ...acc]
    EExternBody(AbiJs, _) -> [core_effect_id(CeJs), ...acc]
    _                -> acc
  }
}

# A call demands every effect on its callee's resolved function row.
fn add_callee_effects(callee: Expr, acc: [SymId]) : [SymId] {
  match callee.ty {
    Some(TyFnT(_, _, row)) -> add_row_effects(row, acc)
    _                      -> acc
  }
}

fn add_row_effects(row: Row, acc: [SymId]) : [SymId] =
  add_label_effects(row.labels, acc)

fn add_label_effects(ls: [Label], acc: [SymId]) : [SymId] {
  match ls {
    []           -> acc
    [l, ...rest] -> add_label_effects(rest, [l.sym, ...acc])
  }
}

# ---- small helpers ---------------------------------------------------

fn effects_in_positions(xs: [XPos], acc: [SymId]) : [SymId] {
  match xs {
    []                  -> acc
    [XP(_, x), ...rest] -> effects_in_positions(rest, effects_in_expr(x, acc))
  }
}

# An unresolved id is no declaration, so it is in no set.
fn mem_sym(s: SymId, xs: [SymId]) : Bool {
  match xs {
    []           -> false
    [x, ...rest] -> if sym_raw(s) >= 0 and sym_raw(x) == sym_raw(s) { true } else { mem_sym(s, rest) }
  }
}

# A rest binder in scope, with the parameter it was split from.
type RestOf = RestOf(Binder)

# What the walk knows at a node: the fn under check with its arity, the
# table, whether its row admits the modulo-cons rewrite, its parameters,
# the rest binders in scope, and whether the node is in tail position.
type TrCtx = TrCtx(SelfRef, Int, SymTab, Bool, [LocalId], [RestOf], Bool)

#[doc("non_tail_list_recursion findings of one fn: direct self-calls fed the tail of a destructured parameter from outside tail position. Mutual recursion is not tracked.")]
pub(pkg) fn tail_recursion_findings(fid: FnId, params: [Param], row: RowExpr, body: Expr, tab: SymTab) : [LintFinding] =
  tr_walk(body, TrCtx(SelfRef(fid), list_length(params), tab, tr_row_is_affine(row), map(params, (p) => p.binder.id), [], true), [])

fn tr_row_is_affine(row: RowExpr) : Bool = match row {
  REmpty -> true
  _      -> false
}

fn tr_walk(e: Expr, cx: TrCtx, acc: [LintFinding]) : [LintFinding] =
  match e.kind {
    ECall(callee, args) -> tr_call_node(e, callee, args, cx, acc)
    EList(els)          -> tr_list(e, els, cx, acc)
    EMatch(scrut, arms) -> tr_match(scrut, arms, cx, tr_walk(scrut, tr_inner(cx), acc))
    EIf(c, t, oe)       -> tr_if(c, t, oe, cx, acc)
    EBlock(ss, ot)      -> tr_block(ss, ot, cx, acc)
    ELambda(_, _)       -> tr_children(e, tr_reset(cx), acc)
    _                   -> tr_children(e, tr_inner(cx), acc)
  }

fn tr_inner(cx: TrCtx) : TrCtx = match cx { TrCtx(f, n, t, a, ps, rs, _) -> TrCtx(f, n, t, a, ps, rs, false) }

fn tr_reset(cx: TrCtx) : TrCtx = match cx { TrCtx(f, n, t, a, ps, _, _) -> TrCtx(f, n, t, a, ps, [], false) }

fn tr_children(e: Expr, cx: TrCtx, acc: [LintFinding]) : [LintFinding] =
  tr_positions(xp_positions(e), tr_inner(cx), acc)

fn tr_positions(xs: [XPos], cx: TrCtx, acc: [LintFinding]) : [LintFinding] =
  match xs {
    []                  -> acc
    [XP(_, x), ...rest] -> tr_positions(rest, cx, tr_walk(x, cx, acc))
  }

fn tr_if(c: Expr, t: Expr, oe: Option[Expr], cx: TrCtx, acc: [LintFinding]) : [LintFinding] {
  let a1 = tr_walk(t, cx, tr_walk(c, tr_inner(cx), acc))
  match oe {
    Some(x) -> tr_walk(x, cx, a1)
    None    -> a1
  }
}

fn tr_match(scrut: Expr, arms: [Arm], cx: TrCtx, acc: [LintFinding]) : [LintFinding] =
  match arms {
    []                        -> acc
    [Arm(p, g, body), ...rest] -> {
      let cx2 = tr_with_rests(cx, tr_rests_of(scrut, p, cx))
      let a1 = match g {
        Some(ge) -> tr_walk(ge, tr_inner(cx2), acc)
        None     -> acc
      }
      tr_match(scrut, rest, cx, tr_walk(body, cx2, a1))
    }
  }

fn tr_with_rests(cx: TrCtx, rs: [RestOf]) : TrCtx =
  match cx { TrCtx(f, n, t, a, ps, old, tl) -> TrCtx(f, n, t, a, ps, list_append(rs, old), tl) }

fn tr_rests_of(scrut: Expr, p: Pattern, cx: TrCtx) : [RestOf] =
  match scrut.kind {
    ELocal(l) -> match cx { TrCtx(_, _, _, _, ps, _, _) ->
      if tr_has_local(ps, l) { tr_pattern_rest(p) } else { [] }
    }
    _ -> []
  }

fn tr_pattern_rest(p: Pattern) : [RestOf] = match p.pkind {
  PList(_, Some(b)) -> [RestOf(b)]
  _                 -> []
}

fn tr_has_local(ls: [LocalId], l: LocalId) : Bool = match ls {
  []           -> false
  [x, ...rest] -> local_eq(x, l) or tr_has_local(rest, l)
}

# The tail of a block is the block's value; a `let` that the tail merely
# reads back (a return-slot) holds the real tail.
fn tr_block(ss: [Stmt], ot: Option[Expr], cx: TrCtx, acc: [LintFinding]) : [LintFinding] {
  let slot = tr_slot_of(ot)
  let a1 = tr_stmts(ss, slot, cx, acc)
  match ot {
    Some(t) -> tr_walk(t, cx, a1)
    None    -> a1
  }
}

fn tr_slot_of(ot: Option[Expr]) : Option[LocalId] = match ot {
  Some(t) -> match t.kind {
    ELocal(l) -> if ret_slot_id_is_scope(l) { Some(l) } else { None }
    _         -> None
  }
  None -> None
}

fn tr_stmts(ss: [Stmt], slot: Option[LocalId], cx: TrCtx, acc: [LintFinding]) : [LintFinding] =
  match ss {
    []           -> acc
    [s, ...rest] -> tr_stmts(rest, slot, cx, tr_stmt(s, slot, cx, acc))
  }

fn tr_stmt(s: Stmt, slot: Option[LocalId], cx: TrCtx, acc: [LintFinding]) : [LintFinding] =
  match s {
    SLet(p, _, rhs) -> tr_walk(rhs, if tr_binds_slot(p, slot) { cx } else { tr_inner(cx) }, acc)
    _               -> tr_positions(xp_stmt_positions(s), tr_inner(cx), acc)
  }

fn tr_binds_slot(p: Pattern, slot: Option[LocalId]) : Bool = match slot {
  Some(l) -> match p.pkind {
    PBind(b) -> local_eq(b.id, l)
    _        -> false
  }
  None -> false
}

fn tr_call(callee: Expr, args: [Expr], cx: TrCtx, acc: [LintFinding]) : [LintFinding] =
  match cx {
    TrCtx(me, _, _, _, _, rs, tail) ->
      if tail or not tcrec_callee_is_self(callee, me) { acc }
      else { tr_arg_findings(callee, args, cx, rs, acc) }
  }

# A constructor or cons whose only self-call sits in one slot is rewritten
# to a loop when the row is affine, so that slot counts as tail.
fn tr_call_node(e: Expr, callee: Expr, args: [Expr], cx: TrCtx, acc: [LintFinding]) : [LintFinding] =
  match tr_ctor_hole(callee, args, cx) {
    Some(i) -> tr_slots(args, i, 0, cx, tr_walk(callee, tr_inner(cx), acc))
    None    -> tr_children(e, cx, tr_call(callee, args, cx, acc))
  }

fn tr_ctor_hole(callee: Expr, args: [Expr], cx: TrCtx) : Option[Int] = match cx {
  TrCtx(me, n, tab, affine, _, _, tail) ->
    if tail and affine and tr_is_ctor(tab, callee) { tcrec_ctor_modcons_slot(args, me, n) } else { None }
}

fn tr_is_ctor(tab: SymTab, f: Expr) : Bool = match f.kind {
  ESym(s, _) -> sym_is_ctor(tab, s)
  _          -> false
}

fn tr_slots(xs: [Expr], hole: Int, i: Int, cx: TrCtx, acc: [LintFinding]) : [LintFinding] =
  match xs {
    []           -> acc
    [x, ...rest] -> tr_slots(rest, hole, i + 1, cx,
                             tr_walk(x, if i == hole { cx } else { tr_inner(cx) }, acc))
  }

fn tr_list(e: Expr, els: [ListElem], cx: TrCtx, acc: [LintFinding]) : [LintFinding] =
  match cx {
    TrCtx(me, n, _, affine, _, _, tail) -> match els {
      [ElPlain(h), ElSpread(t)] ->
        if tail and affine and tcrec_is_direct_self_call(t, me, n) and not tcrec_expr_has_self_call(h, me, n) {
          tr_walk(t, cx, tr_walk(h, tr_inner(cx), acc))
        } else { tr_children(e, cx, acc) }
      _ -> tr_children(e, cx, acc)
    }
  }

fn tr_arg_findings(callee: Expr, args: [Expr], cx: TrCtx, rs: [RestOf], acc: [LintFinding]) : [LintFinding] =
  match args {
    []           -> acc
    [a, ...rest] -> match a.kind {
      ELocal(l) -> match tr_find_rest(rs, l) {
        Some(RestOf(b)) -> [tr_finding(callee, cx, b), ...acc]
        None            -> tr_arg_findings(callee, rest, cx, rs, acc)
      }
      _ -> tr_arg_findings(callee, rest, cx, rs, acc)
    }
  }

fn tr_find_rest(rs: [RestOf], l: LocalId) : Option[RestOf] = match rs {
  []                    -> None
  [RestOf(b), ...rest] -> if local_eq(b.id, l) { Some(RestOf(b)) } else { tr_find_rest(rest, l) }
}

fn tr_finding(callee: Expr, cx: TrCtx, rest_binder: Binder) : LintFinding = match cx {
  TrCtx(SelfRef(fid), _, tab, _, _, _, _) ->
    LF("non_tail_list_recursion", callee.line, callee.col,
       concat_all(["`", written_text(sym_name(tab, fnid_sym(fid))), "` recurses on `", written_text(rest_binder.name), "`, the tail of a list it destructured, outside tail position: one stack frame per element; help: accumulate into a parameter, make the recursive call the last thing the arm does, and reverse once if order matters"]))
}
