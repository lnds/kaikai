#[doc("""
Self-call recognition for the tail-call and modulo-cons rewrites.

A modulo-cons site is admitted only when exactly one constructor slot is
a direct self-call and every other slot is free of self-calls at any
depth. The search descends every position `xp_positions` enumerates,
deferred ones included, so a self-call inside a lambda body or a handler
clause still disqualifies the site. Koka's `isTotal` demand on the other
slots is met by the affine-row gate, not by their shape: with no
suspendable effect, nothing re-enters the open spine while a slot runs.
""")]

import compiler.ast
import compiler.expr_positions
import compiler.self_call
import compiler.symtab_build

#[doc("True when `e` is itself a call of the function `me` with `arity` arguments.")]
pub fn tcrec_is_direct_self_call(e: Expr, me: SelfRef, arity: Int) : Bool =
  match e.kind {
    ECall(f, xs) -> list_length(xs) == arity and tcrec_callee_is_self(f, me)
    _ -> false
  }

#[doc("True when `f` names the function `me`, by its identity or by the qualified spelling of that identity.")]
pub fn tcrec_callee_is_self(f: Expr, me: SelfRef) : Bool = match f.kind {
  EModCall(m, c) -> match me {
    SelfRef(id, _) -> fnid_inst(id) == spec_none() and sym_raw(fnid_sym(id)) >= 0 and
                      sym_raw(sym_derive(NCFn, c, m)) == sym_raw(fnid_sym(id))
  }
  _ -> is_self_callee(f, me)
}

#[doc("True when `e` contains a self-call of `me` in any position, including lambda bodies and handler clauses.")]
pub fn tcrec_expr_has_self_call(e: Expr, me: SelfRef, arity: Int) : Bool =
  tcrec_is_direct_self_call(e, me, arity) or tcrec_positions_have_self_call(xp_positions(e), me, arity)

fn tcrec_positions_have_self_call(ps: [XPos], me: SelfRef, arity: Int) : Bool =
  match ps {
    [] -> false
    [XP(_, c), ...rest] -> tcrec_expr_has_self_call(c, me, arity) or tcrec_positions_have_self_call(rest, me, arity)
  }

#[doc("The slot index of a modulo-cons site's hole: the one direct self-call among `xs`, provided no other slot hides a self-call.")]
pub fn tcrec_ctor_modcons_slot(xs: [Expr], me: SelfRef, arity: Int) : Option[Int] =
  match tcrec_sole_direct_slot(xs, me, arity, 0, None) {
    Some(h) -> if tcrec_slots_hide_self_call(xs, h, me, arity, 0) { None } else { Some(h) }
    None    -> None
  }

# The hole is located before any deep search, so a tail constructor with no
# direct self-call costs one shallow pass over its slots.
fn tcrec_sole_direct_slot(xs: [Expr], me: SelfRef, arity: Int, i: Int, found: Option[Int]) : Option[Int] =
  match xs {
    [] -> found
    [a, ...rest] ->
      if not tcrec_is_direct_self_call(a, me, arity) { tcrec_sole_direct_slot(rest, me, arity, i + 1, found) }
      else { match found {
        Some(_) -> None
        None    -> tcrec_sole_direct_slot(rest, me, arity, i + 1, Some(i))
      } }
  }

fn tcrec_slots_hide_self_call(xs: [Expr], hole: Int, me: SelfRef, arity: Int, i: Int) : Bool =
  match xs {
    [] -> false
    [a, ...rest] ->
      (i != hole and tcrec_expr_has_self_call(a, me, arity)) or tcrec_slots_hide_self_call(rest, hole, me, arity, i + 1)
  }
