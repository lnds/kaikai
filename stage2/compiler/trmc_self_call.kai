#[doc("""
Self-call recognition for the tail-call and modulo-cons rewrites.

A modulo-cons site is admitted only when exactly one constructor slot is
a direct self-call and every other slot is free of self-calls at any
depth. The search descends every position `xp_positions` enumerates,
deferred ones included, so a self-call inside a lambda body or a handler
clause still disqualifies the site.
""")]

import compiler.ast
import compiler.expr_positions
import compiler.sym_read

#[doc("True when a call qualified by `callmod` targets the function's own module; a root-file function (`own_mod = None`) never self-calls through a qualified name.")]
pub fn tcrec_modcall_is_self(callmod: String, own_mod: Option[String]) : Bool =
  match own_mod {
    None    -> false
    Some(m) -> callmod == m
  }

#[doc("True when `e` is itself a call to `nm` with `arity` arguments, bare or qualified by the function's own module.")]
pub fn tcrec_is_direct_self_call(e: Expr, nm: String, arity: Int, own_mod: Option[String]) : Bool =
  match e.kind {
    ECall(f, xs) -> list_length(xs) == arity and tcrec_callee_is_self(f, nm, own_mod)
    _ -> false
  }

fn tcrec_callee_is_self(f: Expr, nm: String, own_mod: Option[String]) : Bool =
  match sym_read_kind(f.kind) {
    EVar(callee)              -> callee == nm
    EModCall(callmod, callee) -> callee == nm and tcrec_modcall_is_self(callmod, own_mod)
    _ -> false
  }

#[doc("True when `e` contains a self-call to `nm` in any position, including lambda bodies and handler clauses.")]
pub fn tcrec_expr_has_self_call(e: Expr, nm: String, arity: Int, own_mod: Option[String]) : Bool =
  tcrec_is_direct_self_call(e, nm, arity, own_mod) or tcrec_positions_have_self_call(xp_positions(e), nm, arity, own_mod)

fn tcrec_positions_have_self_call(ps: [XPos], nm: String, arity: Int, own_mod: Option[String]) : Bool =
  match ps {
    [] -> false
    [XP(_, c), ...rest] -> tcrec_expr_has_self_call(c, nm, arity, own_mod) or tcrec_positions_have_self_call(rest, nm, arity, own_mod)
  }
