#[doc("Where an owned match arm may release its scrutinee early, take its fields, or capture its cell as a reuse token: one answer for both emitters.")]

import compiler.arm_release
import compiler.arm_top_plan
import compiler.ast
import compiler.ctor_ix

#[doc("What an arm site knows before its shape: the scrutinee is owned, a guard may still reject the arm, a region owns the cells, a reuse token is already held.")]
pub type ArmSite = { owned: Bool, guarded: Bool, in_region: Bool, token_held: Bool }

#[doc("How the arm `pat -> body` at `site` releases its scrutinee. A guard may still reject the arm and a region frees its cells itself: neither takes the cell apart.")]
pub fn site_release(site: ArmSite, pat: Pattern, body: Expr) : ScrRelease =
  if site.owned { arm_release(pat, body, not site.guarded and not site.in_region) } else { ScrKept }

#[doc("True when the arm over a record pattern at `site` binds its fields by taking them from the cell.")]
pub fn site_takes_fields(site: ArmSite, pat: Pattern) : Bool =
  site.owned and arm_takes_fields(pat, not site.guarded and not site.in_region)

#[doc("True when a guarded arm over a record pattern at `site` gives the cell's references back to the binders its guard did not read.")]
pub fn site_untakes_fields(site: ArmSite, pat: Pattern) : Bool =
  site.owned and not site.in_region and arm_untakes_fields(pat)

#[doc("True when rebuilds at `site` may overwrite a donor cell in place: a region bump-allocates every cell fresh, so none does.")]
pub fn site_may_reuse(site: ArmSite) : Bool = not site.in_region

#[doc("The arm-top reuse plan of `pat -> body` at `site`. The token is taken by an owned, unguarded arm outside a region that holds no token yet: a guard may still reject after the shell was stolen.")]
pub fn site_arm_top(site: ArmSite, pat: Pattern, body: Expr, ix: CtorIx) : Option[ArmTopReuse] =
  if not site.owned or site.guarded or site.in_region or site.token_held { None } else { arm_top_reuse_plan(pat, body, ix) }

#[doc("True when a rebuild argument is a constructor call with arguments of its own: the non-bijective shape that embeds a child of the reused cell. `names_ctor` says whether a callee names a constructor.")]
pub fn rebuild_nests_ctor(cargs: [Expr], names_ctor: (Expr) -> Bool) : Bool = any(cargs, (e) => match e.kind {
  ECall(f, xs) -> names_ctor(f) and xs != []
  _            -> false
})
