#!/bin/sh
# kai — hands every command to the kai binary (tools/kai), building it,
# and the stage 0/1/2 compilers it needs, on first use in a checkout.
# Paths resolve relative to this script's own location, so it works from
# any working directory and through a symlink.

set -eu

SCRIPT="$0"
case "$SCRIPT" in
  /*) ;;
  *)  SCRIPT="$(pwd)/$SCRIPT" ;;
esac
_hops=0
while [ -L "$SCRIPT" ] && [ "$_hops" -lt 40 ]; do
  _t="$(readlink "$SCRIPT")"
  case "$_t" in
    /*) SCRIPT="$_t" ;;
    *)  SCRIPT="$(cd "$(dirname "$SCRIPT")" && pwd)/$_t" ;;
  esac
  _hops=$((_hops + 1))
done
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"

die() {
  echo "kai: error: $*" >&2
  exit 2
}

if [ -d "$ROOT/stage0" ] && [ -d "$ROOT/stdlib" ]; then
  KAI_CLI="$ROOT/tools/kai/kai"
elif [ -x "$ROOT/libexec/kaikai/kaic2" ] && [ -d "$ROOT/share/kaikai/stdlib" ]; then
  KAI_CLI="$ROOT/libexec/kaikai/kai"
  [ -x "$KAI_CLI" ] || die "kai binary missing at $KAI_CLI — installation is corrupt"
  exec "$KAI_CLI" "$@"
else
  echo "kai: error: cannot find kaikai installation under $ROOT" >&2
  echo "  expected dev layout (stage0/, stdlib/) or installed layout (libexec/kaikai/, share/kaikai/)" >&2
  exit 2
fi

# A user CFLAGS may carry `.c` shim sources meant for their program: the
# bootstrap make gets the flags alone, or its own defaults when none remain.
bootstrap_make() {
  if [ -n "${CFLAGS+x}" ]; then
    _cf_keep=""
    _cf_prev=""
    for _cf in $CFLAGS; do
      case "$_cf" in
        -*) _cf_keep="$_cf_keep $_cf" ;;
        *.c)
          case "$_cf_prev" in
            -include|-imacros|-x|-Xclang|-Xlinker|-Xpreprocessor|-MT|-MQ|-MF|-I|-L|-D|-U|-isystem|-iquote|-idirafter|-o|-z|-T) _cf_keep="$_cf_keep $_cf" ;;
          esac ;;
        *) _cf_keep="$_cf_keep $_cf" ;;
      esac
      _cf_prev="$_cf"
    done
    _cf_keep="${_cf_keep# }"
    if [ -n "$_cf_keep" ]; then
      (cd "$1" && CFLAGS="$_cf_keep" make "$2") >&2
    else
      (cd "$1" && unset CFLAGS && make "$2") >&2
    fi
  else
    (cd "$1" && make "$2") >&2
  fi
}

[ -x "$ROOT/stage0/kaic0" ] || bootstrap_make "$ROOT/stage0" kaic0
[ -x "$ROOT/stage1/kaic1" ] || bootstrap_make "$ROOT/stage1" kaic1
[ -x "$ROOT/stage2/kaic2" ] || bootstrap_make "$ROOT/stage2" kaic2

# tools/kai/Makefile decides staleness. An enclosing make's MAKEFLAGS
# (-n, -B, a jobserver) must not reach it.
cli_make() {
  (unset MAKEFLAGS MFLAGS MAKELEVEL; make -s -C "$ROOT/tools/kai" "$@" kai)
}

# Build tools/kai when missing or stale, under a lock so concurrent
# invocations never run a half-linked binary. Quiet on success: the first
# invocation's stderr is often a golden.
if ! cli_make -q 2>/dev/null; then
  lock="$KAI_CLI.lock"
  waited=0
  held=""
  while [ -z "$held" ]; do
    if mkdir "$lock" 2>/dev/null; then
      held=1
    elif [ "$waited" -ge 120 ]; then
      rm -rf "$lock" 2>/dev/null
    else
      sleep 1
      waited=$((waited + 1))
      cli_make -q 2>/dev/null && break
    fi
  done
  if [ -n "$held" ]; then
    trap 'rmdir "$lock" 2>/dev/null; exit 130' INT
    trap 'rmdir "$lock" 2>/dev/null; exit 143' TERM
    if ! cli_make -q 2>/dev/null; then
      mkdir -p "$ROOT/tools/kai/build"
      cli_log="$ROOT/tools/kai/build/make.log"
      if ! cli_make > "$cli_log" 2>&1; then
        cat "$cli_log" >&2
        rmdir "$lock" 2>/dev/null
        die "failed to build tools/kai"
      fi
    fi
    rmdir "$lock" 2>/dev/null
    trap - INT TERM
  fi
fi

exec "$KAI_CLI" "$@"
