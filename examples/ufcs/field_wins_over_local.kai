# A record field of function type wins over a local of the same name;
# the local is reached on a receiver that has no such field.

type Button = { id: Int, act: (Int) -> String }

fn main() {
  let b = Button { id: 1, act: (n) => "field:#{n}" }
  let act = (n: Int) => "local:#{n}"
  print(b.act(7))
  let n = 7
  print(n.act())
}
