# A local binder shadows the file's function of the same name, and an
# inner binder shadows an outer one, in a UFCS call as in a prefix call.

fn label(n: Int) : String = "function"

fn inner(n: Int) : String {
  let label = (k: Int) => "outer local"
  if n > 0 {
    let label = (k: Int) => "inner local"
    n.label()
  } else {
    n.label()
  }
}

fn main() {
  let n = 1
  print(n.label())
  print(inner(0))
  print(inner(1))
  let label = (k: Int) => "local"
  print(n.label())
}
