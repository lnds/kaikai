# A local binding holding a function is reachable through UFCS:
# `x.f(args)` reads `f(x, args)` on the binder in scope, whether a
# `let`, a pattern binder, or a capture of an enclosing one.

fn pick(o: Option[(Int) -> Int], x: Int) : Int = match o {
  Some(g) -> x.g()
  None    -> x
}

fn main() {
  let double = (n: Int) => n * 2
  let add = (a: Int, b: Int) => a + b
  let x = 21
  print(int_to_string(x.double()))
  print(int_to_string(x.add(4)))
  print(int_to_string(x.double().add(1)))
  let later = () => x.double()
  print(int_to_string(later()))
  print(int_to_string(pick(Some(double), 4)))
}
