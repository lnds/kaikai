# A module's function whose first parameter takes the receiver is picked
# before a local of the same name; the local answers a receiver the
# module's function does not take.

fn show(o: Option[Int]) : String = match o {
  Some(v) -> "some #{v}"
  None    -> "none"
}

fn main() {
  let xs = [1, 2, 3]
  let last = (n: Int) => n + 100
  print(show(xs.last()))
  let n = 1
  print(int_to_string(n.last()))
}
