# The same `ma` and `mc` as in `one`, in a program where a second module declares
# `twice`: its UFCS call is a settled contest, and the callee is still
# `mc`'s, by id, even when `ma`'s typed blob was cached by `one`.
import ma
import md

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(run()))
  Stdout.print(md.twice("a"))
}
