# A function-typed parameter is reachable through UFCS.

fn apply(x: Int, f: (Int) -> Int) : Int = x.f()

fn apply_with(s: String, n: Int, pad: (String, Int) -> String) : String = s.pad(n)

fn stars(s: String, n: Int) : String = if n <= 0 { s } else { stars("*" ++ s, n - 1) }

fn main() {
  print(int_to_string(apply(20, (n) => n + 1)))
  print(apply_with("x", 3, stars))
}
