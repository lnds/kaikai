import spawn

fn big() : [Int] = list.map([0..100000], (i) => i)

fn small() : String = {
  let c = list.concat([[1, 2], [], [3]])
  let o1 = option.collect([Some(1), Some(2)])
  let o2 = option.collect([Some(1), None, Some(3)])
  let o3 : Option[[Int]] = option.collect([])
  let r1 : Result[[Int], String] = result.collect([Ok(1), Ok(2)])
  let r2 : Result[[Int], String] = result.collect([Ok(1), Err("a"), Err("b")])
  "#{c} #{o1} #{o2} #{o3} #{r1} #{r2}"
}

fn large() : Int = {
  let nested = list.length(list.concat(list.map(big(), (i) => [i, i])))
  let opt = match option.collect(list.map(big(), (i) => Some(i))) {
    Some(l) -> list.length(l)
    None    -> 0
  }
  let res = match result.collect(list.map(big(), (i) => Ok(i))) {
    Ok(l)  -> list.length(l)
    Err(_) -> 0
  }
  nested + opt + res
}

fn main() : Unit / Spawn + Console = {
  Stdout.print(small())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber: #{spawn.await(f)}")
}
