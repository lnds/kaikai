import spawn
import regexp.engine
import regexp.syntax

fn small() : String = match syntax.parse_pattern("a[b-d]|e") {
  Ok(ast) -> "#{syntax.ast_show(ast)}\n#{engine.nfa_show(engine.compile_nfa(ast))}"
  Err(_)  -> "parse error"
}

fn shown(pattern: String) : Int = match syntax.parse_pattern(pattern) {
  Ok(ast) -> string.length(syntax.ast_show(ast)) + string.length(engine.nfa_show(engine.compile_nfa(ast)))
  Err(_)  -> 0 - 1
}

# Concatenation, alternation and a class each walk a list as long as the pattern.
fn large() : Int =
  shown(string.repeat("a", 20000)) + shown(string.repeat("a|", 5000) ++ "b") + shown("[" ++ string.repeat("a", 20000) ++ "]")

fn main() : Unit / Spawn + Console = {
  Stdout.print(small())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber: #{spawn.await(f)}")
}
