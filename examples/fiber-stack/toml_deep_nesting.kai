import spawn
import encoding.toml

fn small() : String = match toml.decode("a = [[1, 2], [\"x\", [true, {k = 1.5}]], []]\nb = [ # c\n  [1],\n  [2,],\n]\n") {
  Some(v) -> toml.encode(v)
  None    -> "none"
}

fn rejects() : String = ["a = [[1]", "a = [[1] 2]", "a = [1,, 2]", "a = [[", "a = []]"]
  |> list.map((s) => match toml.decode(s) { Some(_) -> "ok" None -> "none" })
  |> string.join(" ")

fn nest(n: Int, acc: TomlValue) : TomlValue =
  if n == 0 { acc } else { nest(n - 1, TArr([acc, TInt(n)])) }

fn depth(v: TomlValue, acc: Int) : Int = match v {
  TArr([inner, ..._]) -> depth(inner, acc + 1)
  _                   -> acc
}

fn large() : String = {
  let n = 100000
  let src = string_concat_all(["a = ", string.repeat("[", n), "1", string.repeat("]", n), "\n"])
  let decoded = match toml.decode(src) {
    Some(TTbl([p])) -> depth(p.snd, 0)
    _               -> 0 - 1
  }
  let text = toml.encode(TTbl([Pair { fst: "a", snd: nest(n, TStr("s")) }]))
  "#{decoded} #{string_length(text)} #{string_slice(text, 0, 16)}"
}

fn main() : Unit / Spawn + Console = {
  Stdout.print(small())
  Stdout.print(rejects())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber: #{spawn.await(f)}")
}
