import spawn
import regexp

fn small() : String = match regexp.parse_pattern("(a(?:b|c)*)+d{2,3}(e){2}|(x)") {
  Ok(ast) -> "#{regexp.ast_show(ast)}\n#{regexp.nfa_show(regexp.compile_nfa(ast))}"
  Err(e)  -> "parse error #{e.msg} at #{e.pos}"
}

fn errors() : String = [")", "(a", "a)", "(a|", "(?:a", "((a)", "a{2,1}"]
  |> list.map((p) => match regexp.parse_pattern(p) {
    Ok(_)  -> "ok"
    Err(e) -> "#{e.msg}@#{e.pos}"
  })
  |> string.join(" | ")

fn groups(n: Int, inner: String) : String =
  string_concat_all([string.repeat("(", n), inner, string.repeat(")", n)])

fn measured(pattern: String) : String = match regexp.parse_pattern(pattern) {
  Ok(ast) -> {
    let nfa = regexp.compile_nfa(ast)
    "#{string.length(regexp.ast_show(ast))} #{list.length(nfa.states)} #{nfa.num_groups}"
  }
  Err(e) -> "parse error #{e.msg}"
}

fn found(n: Int) : String = match regexp.compile(groups(n, "a+")) {
  Ok(re) -> match regexp.find(re, "xaaa") {
    Some(m) -> "#{m.start}-#{m.end} #{list.length(m.groups)}"
    None    -> "no match"
  }
  Err(msg) -> msg
}

fn large() : String = {
  let deep = measured(groups(100000, "a"))
  let noncap = measured(groups(100000, "a") |> string.replace("(", "(?:"))
  let stars = measured(string_concat_all([string.repeat("(", 100000), "a", string.repeat(")*", 100000)]))
  let unclosed = measured(string.repeat("(", 100000))
  "#{deep}\n#{noncap}\n#{stars}\n#{unclosed}\n#{found(3000)}"
}

fn main() : Unit / Spawn + Console = {
  Stdout.print(small())
  Stdout.print(errors())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber:\n#{spawn.await(f)}")
}
