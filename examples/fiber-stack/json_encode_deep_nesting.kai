import spawn
import encoding.json
import encoding.json_bind.{JsonValue, JNull, JBool, JNum, JReal, JStr, JArr, JObj}

fn nest_arr(n: Int, acc: JsonValue) : JsonValue =
  if n == 0 { acc } else { nest_arr(n - 1, JArr([acc])) }

fn nest_obj(n: Int, acc: JsonValue) : JsonValue =
  if n == 0 { acc } else { nest_obj(n - 1, JObj([Pair { fst: "a", snd: acc }])) }

fn small() : String = json_encode(JObj([
  Pair { fst: "k\"q", snd: JArr([JNull, JBool(true), JNum(-3), JReal(1.5), JStr("x\ny")]) },
  Pair { fst: "e", snd: JArr([]) },
  Pair { fst: "o", snd: JObj([]) },
  Pair { fst: "n", snd: JArr([JArr([JNum(1)]), JObj([Pair { fst: "z", snd: JArr([]) }]), JNum(2)]) }
]))

fn large() : String = {
  let arrs = json_encode(nest_arr(100000, JNull))
  let objs = json_encode(nest_obj(100000, JNum(7)))
  "#{string_length(arrs)} #{string_length(objs)} #{string_slice(arrs, 99998, 12)} #{string_slice(objs, 0, 12)}"
}

fn main() : Unit / Spawn + Console = {
  Stdout.print(small())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber: #{spawn.await(f)}")
}
