import spawn
import encoding.toml

fn pairs_of(n: Int) : String =
  string_concat_all(list.map([0..n], (i) => "k#{i} = #{i}, "))

fn small() : String = {
  match toml.decode("t = { a = 1, b = \"x\", c = true }") {
    Some(TTbl(top)) -> match toml.pairs_get(top, "t") {
      Some(TTbl(ps)) -> "#{list.length(ps)} #{toml.encode(TTbl(top))}"
      _              -> "not a table"
    }
    _ -> "none"
  }
}

fn large() : Int = match toml.decode("t = { " ++ pairs_of(20000) ++ "z = 0 }") {
  Some(TTbl(top)) -> match toml.pairs_get(top, "t") {
    Some(TTbl(ps)) -> list.length(ps)
    _              -> 0
  }
  _ -> 0
}

fn main() : Unit / Spawn + Console = {
  Stdout.print(small())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber: #{spawn.await(f)}")
}
