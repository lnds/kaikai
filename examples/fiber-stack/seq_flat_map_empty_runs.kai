import spawn
import seq

fn small() : String = {
  let s = seq.flat_map(seq.range(1, 4, 1), (x) => seq.take(seq.from(x), x))
  let e = seq.flat_map(seq.range(1, 3, 1), (x) => seq.take(seq.from(x), 0))
  "#{seq.to_list(s)} #{seq.to_list(e)}"
}

# One non-empty inner after 100000 empty ones: the read must loop, not recurse.
fn large() : Int = {
  let s = seq.flat_map(seq.range(0, 100000, 1), (x) => if x == 100000 { seq.take(seq.from(x), 2) } else { seq.take(seq.from(x), 0) })
  list.length(seq.to_list(s))
}

fn main() : Unit / Spawn + Console = {
  Stdout.print(small())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber: #{spawn.await(f)}")
}
