import spawn
import encoding.toml

fn path_of(n: Int) : String = string_concat_all(list.map([0..n], (i) => "k#{i}."))

fn small() : String = match toml.decode("[a.b.c]\nx = 1\n[[a.d]]\ny = 2\n[[a.d]]\ny = 3\n") {
  Some(v) -> toml.encode(v)
  None    -> "none"
}

# A header of N dotted segments nests N tables.
fn large() : Int = match toml.decode("[" ++ path_of(20000) ++ "z]\na = 1\n[[" ++ path_of(2000) ++ "w]]\nb = 2\n") {
  Some(TTbl(top)) -> list.length(top)
  _               -> 0
}

fn main() : Unit / Spawn + Console = {
  Stdout.print(small())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber: #{spawn.await(f)}")
}
