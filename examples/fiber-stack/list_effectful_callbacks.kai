import spawn

fn big() : [Int] = list.map([0..100000], (i) => i)

fn small() : String = {
  var calls := 0
  let a = list.map_indexed([10, 20, 30], (i, x) => { calls := calls + 1; i + x })
  let b = list.take_while([1, 2, 3, 4], (x) => { calls := calls + 1; x < 3 })
  let c = list.zip_with([1, 2, 3], [10, 20], (x, y) => { calls := calls + 1; x + y })
  "#{a} #{b} #{c} #{calls}"
}

# A callback with an effect keeps the row open, so these walks are not
# the pure instances the compiler can rewrite into loops.
fn large() : Int = {
  var calls := 0
  let a = list.map_indexed(big(), (i, x) => { calls := calls + 1; x })
  let b = list.take_while(big(), (x) => { calls := calls + 1; true })
  let c = list.zip_with(big(), big(), (x, y) => { calls := calls + 1; x + y })
  list.length(a) + list.length(b) + list.length(c) + calls
}

fn main() : Unit / Spawn + Console = {
  Stdout.print(small())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber: #{spawn.await(f)}")
}
