import spawn

fn big() : [Int] = list.map([0..100000], (i) => i)

fn compare() : String = {
  let a = big()
  let b = big()
  let c = list.map([0..100000], (i) => if i == 99999 { 0 } else { i })
  "#{a == b} #{a != b} #{a == c} #{a != c}"
}

fn main() : Unit / Spawn + Console = {
  Stdout.print(compare())
  let f = spawn.spawn(() => compare())
  Stdout.print("fiber: #{spawn.await(f)}")
}
