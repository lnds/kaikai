import regexp.engine
import regexp.syntax
import encoding.json
import encoding.toml
import encoding.json_bind.{JsonValue, JNull, JNum, JArr, JObj}

fn nest_json(n: Int, acc: JsonValue) : JsonValue =
  if n == 0 { acc } else { nest_json(n - 1, if n % 2 == 0 { JArr([acc, JNum(n)]) } else { JObj([Pair { fst: "k", snd: acc }, Pair { fst: "z", snd: JNull }]) }) }

fn nest_toml(n: Int, acc: TomlValue) : TomlValue =
  if n == 0 { acc } else { nest_toml(n - 1, if n % 3 == 0 { TTbl([Pair { fst: "t", snd: acc }]) } else { TArr([acc, TInt(n)]) }) }

fn groups(n: Int) : String = string_concat_all([string.repeat("(a|b(?:c", n), "x", string.repeat(")*)+d{2,3}", n)])

fn rx(n: Int) : String = match syntax.parse_pattern(groups(n)) {
  Ok(ast) -> string_concat_all([syntax.ast_show(ast), engine.nfa_show(engine.compile_nfa(ast))])
  Err(e)  -> "err #{e.msg}@#{e.pos}"
}

fn tm(n: Int) : String = {
  let v = TTbl([Pair { fst: "a", snd: nest_toml(n, TInt(1)) }])
  let text = toml.encode(v)
  match toml.decode(text) {
    Some(w) -> "#{text}|#{toml.encode(w) == text}"
    None    -> "#{text}|none"
  }
}

fn depths() : [Int] = [1, 11, 12, 13, 26, 40]

fn digest(s: String) : String = "#{string_length(s)}/#{string_hash(s)}"

fn main() : Unit / Console = {
  list.foreach(depths(), (n) => {
    Stdout.print("#{n} json #{digest(json_encode(nest_json(n, JNull)))} regexp #{digest(rx(n))} toml #{digest(tm(n))}")
  })
}
