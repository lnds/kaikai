import spawn
import collections.queue
import collections.stack
import collections.hashmap

fn big() : [Int] = list.map([0..100000], (i) => i)

fn small() : String = {
  let q = queue.flat_map(queue.from_list([1, 2, 3]), (x) => queue.from_list([x, x * 10]))
  let s = stack.flat_map(stack.from_list([1, 2, 3]), (x) => stack.from_list([x, x * 10]))
  let m = hashmap.from([Pair { fst: 1, snd: "a" }, Pair { fst: 17, snd: "b" }, Pair { fst: 33, snd: "c" }])
  hashmap.put(m, 17, "B")
  hashmap.remove(m, 1)
  hashmap.remove(m, 99)
  "#{queue.to_list(q)} #{stack.to_list(s)} #{hashmap.size(m)} #{hashmap.get(m, 17)} #{hashmap.get(m, 1)} #{hashmap.get(m, 33)}"
}

# Keys that are multiples of 2^20 share one bucket until the table
# outgrows them, so the chain is as long as the key count.
fn large() : Int = {
  let q = queue.size(queue.flat_map(queue.from_list(big()), (x) => queue.from_list([x])))
  let s = stack.size(stack.flat_map(stack.from_list(big()), (x) => stack.from_list([x])))
  let m = hashmap.from(list.map(list.take(big(), 5000), (x) => Pair { fst: x * 1048576, snd: x }))
  hashmap.put(m, 4999 * 1048576, 0)
  hashmap.remove(m, 2500 * 1048576)
  hashmap.remove(m, 4999 * 1048576)
  q + s + hashmap.size(m)
}

fn main() : Unit / Spawn + Console + Mutable = {
  Stdout.print(small())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber: #{spawn.await(f)}")
}
