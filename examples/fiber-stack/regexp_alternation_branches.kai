import spawn
import regexp

fn small() : String = {
  match regexp.compile("(a|b|cd)+") {
    Ok(re) -> match regexp.find(re, "xxabcdby") {
      Some(m) -> "#{m.start}-#{m.end}"
      None    -> "none"
    }
    Err(e) -> e
  }
}

# The start state of an alternation carries one transition per branch.
fn large() : Int = match regexp.compile(string.repeat("a|", 5000) ++ "b") {
  Ok(re) -> match regexp.find(re, "zzb") {
    Some(m) -> m.end - m.start
    None    -> 0
  }
  Err(_) -> 0 - 1
}

fn main() : Unit / Spawn + Console = {
  Stdout.print(small())
  let f = spawn.spawn(() => large())
  Stdout.print("fiber: #{spawn.await(f)}")
}
