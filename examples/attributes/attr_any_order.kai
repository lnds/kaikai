#[doc("Attributes on one declaration are accepted in any order.")]

import encoding.json
import encoding.json_bind

#[derive(Json)]
#[doc("A point.")]
pub type Point = { x: Int }

#[doc("A colour.")]
#[derive(Eq, Show)]
pub type Color = Red | Green

#[derive(Show)]
#[must_use]
#[doc("A size.")]
pub type Size = Small | Large

#[must_use]
#[unstable]
#[derive(Eq)]
#[doc("A tag.")]
pub type Tag = Tag(Int)

#[derive(Show)]
# kept above the doc
#[doc("A shade.")]
# kept above the declaration
pub type Shade = Dark | Light

pub type Meters = { v: Int }

#[unstable]
#[constructor]
#[doc("Builds meters.")]
pub fn meters(v: Int) : Meters = Meters { v: v }

#[must_use]
#[doc("A width.")]
#[derive(Eq, Show)]
pub type Width = Width(Int)

fn main() : Unit / Stdout {
  Stdout.print(json_encode(to_json(Point { x: 7 })))
  Stdout.print("#{Red} #{Red == Green} #{Large}")
  Stdout.print("#{Tag(1) == Tag(1)} #{Dark} #{Meters(3).v} #{Width(2)}")
}
