type P = { a: Int, b: Int }
type Box = { name: String, p: P, n: Int }
type W[t] = { v: t, k: Int }

fn sum_pair(pr: (Int, Int)) : Int = {
  let (x, y) = pr
  x * 10 + y
}

fn nested(bx: Box) : Int = match bx {
  { name, p: { a, b }, n } -> a + b + n + string_length(name)
}

fn aliased(bx: Box) : Int = match bx {
  { p: q @ { a, b }, n: _ } -> a * 100 + b + q.a
}

fn guarded(bx: Box) : Int = match bx {
  { p, n } if n > 100 -> p.a
  { p: { a, b }, n } if a == b -> n
  { name, n } -> string_length(name) + n
}

fn tuple3(t: (Int, String, Int)) : String = {
  let (a, s, c) = t
  "#{a}#{s}#{c}"
}

fn infer_only(xs: [(Int, Int)]) : Int =
  xs |> map(pr => match pr { (l, r) -> l - r }) |> sum

fn lam_rec(ps: [P]) : Int = ps |> map(r => match r { { a, b } -> a * b }) |> sum

fn generic[t](w: W[t]) : t = match w { { v, k: _ } -> v }

fn main() : Int / Stdout = {
  let bx = Box { name: "ab", p: P { a: 0, b: 4 }, n: 7 }
  let bx2 = Box { name: "xyz", p: P { a: 3, b: 3 }, n: 9 }
  let bx3 = Box { name: "q", p: P { a: 1, b: 2 }, n: 500 }
  Stdout.print("#{sum_pair((4, 2))}")
  Stdout.print("#{nested(bx)}")
  Stdout.print("#{aliased(bx)} #{aliased(bx2)}")
  Stdout.print("#{guarded(bx3)} #{guarded(bx2)} #{guarded(bx)}")
  Stdout.print(tuple3((1, "-", 3)))
  Stdout.print("#{infer_only([(5, 1), (9, 2)])}")
  Stdout.print("#{lam_rec([P { a: 2, b: 3 }, P { a: 4, b: 5 }])}")
  Stdout.print("#{generic(W { v: 42, k: 1 })}")
  0
}
