# A `#[derive(...)]` record still resolves in the `...` spread. The
# derive wrapper survives until lower-protocols, which runs after the
# spread desugar, so the record table must read through it.

#[derive(Eq)]
type R = { a: Int, b: Int }

#[derive(Eq, Show, Ord)]
type Multi = { p: Int, q: Int }

#[derive(Show)]
type Wrapped = Left(Int) | Right(Int)

fn bump(o: R) : R = R { ...o, a: o.a + 1 }

fn shift(m: Multi) : Multi = Multi { ...m, q: m.q * 2 }

fn main() : Unit / Console {
  let r = bump(R { a: 1, b: 2 })
  print("a=#{r.a}")
  print("b=#{r.b}")
  print("eq=#{r == R { a: 2, b: 2 }}")

  let m = shift(Multi { p: 7, q: 3 })
  print(show(m))

  print(show(Left(4)))
}
