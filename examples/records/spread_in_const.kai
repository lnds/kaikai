# A spread and a positional literal in a const initializer lower as in a function body.

type R = { a: Int, b: Int }
type Outer = { left: R, right: R }

const BASE : R = R { a: 1, b: 2 }
const SAME : R = R { ...BASE }
const MORE : R = R { ...BASE, b: 3 }
const POS : R = R { 7, 8 }
const NESTED : Outer = Outer { left: R { ...MORE, a: 5 }, right: R { ...POS } }
const LIST : [R] = [R { ...BASE, a: 9 }, R { ...MORE }]
const CHAIN : R = R { ...R { ...BASE, a: 4 }, b: 6 }

fn more() : R = R { ...BASE, b: 3 }

fn sum(rs: [R]) : Int = match rs {
  [] -> 0
  [r, ...rest] -> r.a + r.b + sum(rest)
}

fn main() : Unit / Console {
  print("same=#{SAME.a},#{SAME.b}")
  print("more=#{MORE.a},#{MORE.b}")
  print("fn=#{more().a},#{more().b}")
  print("pos=#{POS.a},#{POS.b}")
  print("nested=#{NESTED.left.a},#{NESTED.left.b},#{NESTED.right.a},#{NESTED.right.b}")
  print("list=#{sum(LIST)}")
  print("chain=#{CHAIN.a},#{CHAIN.b}")
  print("base=#{BASE.a},#{BASE.b}")
}
