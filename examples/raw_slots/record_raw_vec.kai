type P = { x: Int, y: Int }

type Q = { x: Int, w: Real, flag: Bool }

type M = { id: Int, name: String, score: Real }

fn fill_p(n: Int, v: Vec[P]) : Vec[P] =
  if n == 0 { v } else { fill_p(n - 1, vec_push(v, P { x: n, y: n * n })) }

fn fill_q(n: Int, v: Vec[Q]) : Vec[Q] =
  if n == 0 { v } else { fill_q(n - 1, vec_push(v, Q { x: n, w: 0.5, flag: n % 2 == 0 })) }

fn fill_m(n: Int, v: Vec[M]) : Vec[M] =
  if n == 0 { v } else { fill_m(n - 1, vec_push(v, M { id: n, name: "n#{n}", score: 1.25 })) }

fn sum_p(v: Vec[P], i: Int, acc: Int) : Int =
  if i == vec_length(v) {
    acc
  } else {
    let p = vec_get(v, i)
    sum_p(v, i + 1, acc + p.x + p.y)
  }

fn main() : Int / Stdout = {
  let ps = fill_p(5, [])
  let first = vec_get(ps, 0)
  Stdout.print("p=#{first.x} #{first.y} #{sum_p(ps, 0, 0)}")
  let ps2 = vec_set(ps, 1, P { x: 100, y: 200 })
  let second = vec_get(ps2, 1)
  Stdout.print("set=#{second.x} #{second.y} #{sum_p(ps2, 0, 0)}")
  let qs = fill_q(4, [])
  let q0 = vec_get(qs, 0)
  let q1 = vec_get(qs, 1)
  Stdout.print("q=#{q0.x} #{q0.w} #{q0.flag} #{q1.x} #{q1.flag}")
  let ms = fill_m(3, [])
  let m1 = vec_get(ms, 1)
  Stdout.print("m=#{m1.id} #{m1.name} #{m1.score}")
  let whole = vec_get(ps, 2)
  let empty: Vec[P] = []
  let rebuilt = vec_push(empty, whole)
  let back = vec_get(rebuilt, 0)
  Stdout.print("whole=#{back.x} #{back.y} #{back == whole}")
  0
}
