import spawn

#[derive(Show, Eq)]
type R = { a: Int, b: Int }

#[derive(Show, Eq)]
type Mixed = { n: Int, label: String, x: Real, ok: Bool, big: Int }

type Inner = { k: Int, tag: String }

type Outer = { inner: Inner, weight: Real, count: Int }

type Box[t] = { v: t, n: Int }

fn g(i: Int) : R = R { a: i % 7, b: i % 2 }

fn sum_to(i: Int, acc: Int) : Int =
  if i == 0 {
    acc
  } else {
    let r = g(i)
    sum_to(i - 1, acc + r.a + r.b)
  }

fn mk(n: Int) : Mixed =
  Mixed { n: n, label: "m#{n}", x: 1.5, ok: n > 2, big: 4611686018427387905 + n }

fn bump(m: Mixed) : Mixed = Mixed { ...m, n: m.n + 10, x: m.x * 2.0 }

fn weigh(o: Outer) : Int = match o {
  { inner: { k: k, tag: t }, weight: _, count: c } -> string_length(t) + k + c
}

fn classify(r: R) : String = match r {
  { a: 0, b: _ } -> "zero-a"
  { a: _, b: 1 } -> "odd-b"
  _ -> "other"
}

fn pair_of_box(b: Box[Int]) : Int = b.v + b.n

fn main() : Int / Stdout + Spawn {
  Stdout.print("sum=#{sum_to(1000, 0)}")
  let m = mk(3)
  Stdout.print("m=#{m.n} #{m.label} #{m.x} #{m.ok} #{m.big}")
  let m2 = bump(m)
  Stdout.print("m2=#{m2.n} #{m2.label} #{m2.x} #{m2.big}")
  Stdout.print("eq=#{m == mk(3)} #{m == m2}")
  Stdout.print("show=#{m}")
  let o = Outer { inner: Inner { k: 2, tag: "ab" }, weight: 0.5, count: 4 }
  Stdout.print("outer=#{weigh(o)} #{o.inner.k} #{o.count}")
  Stdout.print(
    "cls=#{classify(R { a: 0, b: 1 })} #{classify(R { a: 3, b: 1 })} #{classify(R { a: 3, b: 0 })}"
  )
  Stdout.print("box=#{pair_of_box(Box { v: 40, n: 2 })}")
  let neg = R { a: -9223372036854775807, b: 9223372036854775807 }
  Stdout.print("edge=#{neg.a} #{neg.b} #{neg.a + neg.b}")
  let rs = [R { a: 1, b: 2 }, R { a: 3, b: 4 }, g(5)]
  Stdout.print("list=#{rs} #{rs == [R { a: 1, b: 2 }, R { a: 3, b: 4 }, g(5)]}")
  let got = nursery { n ->
    let f = n.spawn(() => bump(m))
    n.await(f)
  }
  Stdout.print("fiber=#{got.n} #{got.label} #{got.x} #{got == m2}")
  0
}
