type Q = { a: Int, r: Real, tag: String }

type W = { inner: Q, n: Int }

fn int_lit(q: Q) : Int = match q {
  { a: 0, r: _, tag: _ } -> 1
  { a: 7, r: _, tag: _ } -> 2
  _ -> 3
}

fn real_lit(q: Q) : Int = match q {
  { a: _, r: 0.5, tag: _ } -> 1
  { a: _, r: 2.5, tag: _ } -> 2
  _ -> 3
}

fn both_lit(q: Q) : Int = match q {
  { a: 1, r: 1.5, tag: _ } -> 1
  { a: 1, r: _, tag: _ } -> 2
  _ -> 3
}

fn str_and_raw(q: Q) : Int = match q {
  { a: 4, r: _, tag: "x" } -> 1
  { a: _, r: _, tag: "y" } -> 2
  _ -> 3
}

fn nested(w: W) : Int = match w {
  { inner: { a: 0, r: 0.5, tag: _ }, n: 1 } -> 1
  { inner: { a: 0, r: _, tag: _ }, n: _ } -> 2
  { inner: { a: _, r: 9.0, tag: _ }, n: _ } -> 3
  _ -> 4
}

fn bind_and_guard(q: Q) : Int = match q {
  { a: x, r: y, tag: _ } if x > 3 and y > 1.0 -> x + 100
  { a: x, r: _, tag: _ } -> x
}

fn main() : Unit / Stdout {
  let tag = "k" ++ int_to_string(1)
  let qs = [
    Q { a: 0, r: 0.5, tag: tag },
    Q { a: 7, r: 2.5, tag: "x" },
    Q { a: 1, r: 1.5, tag: "y" },
    Q { a: 1, r: 3.0, tag: tag },
    Q { a: 4, r: 9.0, tag: "x" }
  ]
  qs
    |! Stdout.print(
      "#{int_lit(.)} #{real_lit(.)} #{both_lit(.)} #{str_and_raw(.)} #{bind_and_guard(.)}"
    )
  let ws = [
    W { inner: Q { a: 0, r: 0.5, tag: tag }, n: 1 },
    W { inner: Q { a: 0, r: 0.1, tag: tag }, n: 2 },
    W { inner: Q { a: 5, r: 9.0, tag: tag }, n: 3 },
    W { inner: Q { a: 5, r: 1.0, tag: tag }, n: 3 }
  ]
  ws |! Stdout.print("#{nested(.)}")
}
