# A row with `Actor[Request]` only cannot receive a `Reply`: the
# mailbox `receive` reads is the row's own, so the missing
# `Actor[Reply]` is still diagnosed even though sending to a
# `Pid[Reply]` needs no such label.

type Request = Query(String)
type Reply   = Answer(String)

fn only_request(rep: Pid[Reply]) : String / Actor[Request] = {
  Actor.send(rep, Answer("ok"))
  let got: Reply = Actor.receive()
  match got {
    Answer(a) -> a
  }
}

fn main() : Int / Console = 0
