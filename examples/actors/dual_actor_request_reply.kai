# A function declaring two distinct `Actor[T]` instances in its row
# invokes ops on both: the request/reply server of docs/actors.md
# §Request/reply receives a `Query` carrying the client's `Pid[Reply]`
# and answers through it.

import actor

type Request = Query(String, Pid[Reply])
type Reply   = Answer(String)

fn servidor() : Unit / Actor[Request] + Actor[Reply] + Console = {
  match Actor.receive() {
    Query(p, cliente) -> {
      Stdout.print(string_concat("servidor: ", p))
      Actor.send(cliente, Answer("ok"))
    }
  }
}

# Each `with_mailbox` discharges one of `servidor`'s instances; the
# reply lands in the outer `Reply` mailbox and is read once the inner
# scope closes.
fn main() : Int / Console = {
  with_mailbox {
    let me: Pid[Reply] = Actor.self()
    with_mailbox {
      let srv: Pid[Request] = Actor.self()
      Actor.send(srv, Query("ping", me))
      servidor()
    }
    match Actor.receive() {
      Answer(a) -> Stdout.print(string_concat("cliente: ", a))
    }
    0
  }
}
