import actor
import spawn

type Req = Echo(String, Pid[Reply]) | Stop

type Reply = Back(String)

fn serve() : Unit / Actor[Req] = match Actor.receive() {
  Echo(s, from) -> {
    Actor.send(from, Back(s ++ "+" ++ s))
    serve()
  }
  Stop -> ()
}

fn ask(srv: Pid[Req], s: String) : String / Actor[Reply] {
  Actor.send(srv, Echo(s, Actor.self()))
  match Actor.receive() {
    Back(r) -> r
  }
}

fn main() : Int / Spawn + Stdout = with_mailbox {
  let short = "short"
  let edge15 = "123456789012345"
  let edge16 = "1234567890123456"
  let srv = spawn_actor(() => serve())
  Stdout.print(ask(srv, short))
  Stdout.print(ask(srv, edge15))
  Stdout.print(ask(srv, edge16))
  Stdout.print(ask(srv, ""))
  Actor.send(srv, Stop)
  let joined = nursery { n ->
    let f = n.spawn(() => short ++ "/" ++ edge15 ++ "/" ++ edge16)
    n.await(f)
  }
  Stdout.print(joined)
  Stdout.print("#{short} #{edge15} #{edge16}")
  0
}
