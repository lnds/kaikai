fn same[t](x: t, n: Int) : Int = if n == 0 { 0 } else { 1 + same(x, n - 1) }

fn even[t](x: t, n: Int) : Int = if n == 0 { 0 } else { 1 + odd(x, n - 1) }

fn odd[t](x: t, n: Int) : Int = if n == 0 { 1 } else { 1 + even(x, n - 1) }

fn l4[t](x: t) : Int = 4

fn l3[t](x: t) : Int = l4([x]) + 1

fn l2[t](x: t) : Int = l3([x]) + 1

fn l1[t](x: t) : Int = l2([x]) + 1

fn main() : Unit / Console {
  println(int_to_string(same("a", 3)))
  println(int_to_string(even(1, 5)))
  println(int_to_string(l1(1)))
}
