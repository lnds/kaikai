# char.is_whitespace is exactly the Unicode White_Space set, and the
# string trim family and is_blank agree with it.

fn ws_codepoints() : [Int] =
  [
    9, 10, 11, 12, 13, 32, 0x85, 0xA0, 0x1680, 0x2000, 0x2001, 0x2002, 0x2003, 0x2004,
    0x2005, 0x2006, 0x2007, 0x2008, 0x2009, 0x200A, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000
  ]

fn near_misses() : [Int] =
  [
    8, 14, 31, 33, 0x84, 0x86, 0x9F, 0xA1, 0x167F, 0x1681, 0x180E, 0x1FFF, 0x200B, 0x200C,
    0x200D, 0x2027, 0x202A, 0x202E, 0x2030, 0x205E, 0x2060, 0x2FFF, 0x3001, 0xFEFF
  ]

fn count_ws(xs: [Int]) : Int =
  xs |> list.filter(n => char.is_whitespace(int_to_char(n))) |> list.length

fn show(label: String, s: String) : Unit / Console =
  print("#{label} blank=#{string.is_blank(s)} trim=#{string.byte_length(string.trim(s))}")

fn main() : Unit / Console {
  print("ws #{count_ws(ws_codepoints())}/#{list.length(ws_codepoints())}")
  print("non-ws #{count_ws(near_misses())}/#{list.length(near_misses())}")

  show("nbsp", "\u{A0}")
  show("vt", "\u{B}")
  show("ff", "\u{C}")
  show("ideographic", "\u{3000}")
  show("repro", "\u{A0}x\u{2003}")
  show("zwsp", "\u{200B}")
  show("bom", "\u{FEFF}")
  show("empty", "")
  show("mixed", " \u{2028}\u{85}\t\u{1680}")
  show("inner", "a\u{A0}b")

  print("[#{string.trim_left("\u{2003}\u{3000}é\u{A0}")}]")
  print("[#{string.trim_right("\u{2003}é\u{3000}\u{A0}")}]")
  print("[#{string.trim("\u{200B}x\u{200B}")}]")
}
