type Cmd[e] = { name: String, action: () -> Unit / e }

type App[e] = { cmds: [Cmd[e]] }

fn find(cs: [Cmd[e]], wanted: String) : Option[Cmd[e]] = list.find(cs, c => c.name == wanted)

fn run[e](a: App[e], wanted: String) : Bool = match find(a.cmds, wanted) {
  Some(_) -> true
  None -> false
}

fn main() : Int / Stdout {
  let a = App { cmds: [Cmd { name: "x", action: () => () }] }
  println("#{run(a, "x")}")
  println("#{run(a, "y")}")
  0
}
