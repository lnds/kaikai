type C[e] = { name: String, action: () -> Unit / e }

type B[e] = { inner: [C[e]] }

type A[e] = { mid: B[e] }

fn first[e](a: A[e]) : Option[C[e]] = match a.mid.inner {
  [c, ..._] -> Some(c)
  [] -> None
}

fn main() : Int / Stdout {
  let a = A { mid: B { inner: [C { name: "deep", action: () => println("hi") }] } }
  match first(a) {
    Some(c) -> {
      println(c.name)
      (c.action)()
    }
    None -> println("none")
  }
  0
}
