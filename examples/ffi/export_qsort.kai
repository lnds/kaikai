# An exported fn is the comparator `qsort` calls back, on the fiber that is
# inside the FFI call. The shim rides CFLAGS (`kai info ffi`).

extern "C" fn kai_cmp(a: Int, b: Int) : Int =
  if a < b { -1 } else if a > b { 1 } else { 0 }

extern "C" fn sort_weighted() : Int / Ffi

pub fn main() : Unit / Stdout + Ffi = {
  Stdout.print("weighted: #{sort_weighted()}")
}
