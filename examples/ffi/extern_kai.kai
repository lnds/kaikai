# Builtins called directly, through pipes, as values and from a generic
# caller. tools/kai-builtins-asan.sh runs it under ASAN twice: against the
# stdlib, and against a core that declares each of these builtins with
# `extern "kai"`; both runs print the same lines.

fn apply1(f: ([String]) -> [String], xs: [String]) : [String] = f(xs)

fn apply2(f: (String, String) -> String, a: String, b: String) : String = f(a, b)

fn pushes(v: Vec[String], n: Int) : Vec[String] =
  if n == 0 { v } else { pushes(vec_push(v, int_to_string(n)), n - 1) }

fn stamped(n: Int) : Array[String] = {
  let a = array_make(n, "-")
  array_set(a, 0, string_concat("first", "!"))
}

fn twice[T](xs: [T]) : [T] = list_reverse(list_reverse(xs))

fn main() : Unit / Stdout = {
  let s = string_concat("kai", string_concat("_", "builtin"))
  print(s)
  print(apply2(string_concat, s, "/value"))
  print(int_to_string(match string.index_of(s, "builtin") { Some(i) -> i  None -> -1 }))
  print(string_join(list_reverse(["c", "b", "a"]), ","))
  print(string_join(twice(["x", "y"]), ","))
  let r = list_reverse
  print(string_join(r(["1", "2"]), ""))
  print(string_join(apply1(list_reverse, ["3", "4"]), ""))
  let v = pushes(vec_empty(), 3)
  print(int_to_string(vec_length(v)))
  print(vec_get(v, 0))
  let a = stamped(2)
  print(array_get(a, 0))
  print(array_get(a, 1))
  let p = print
  p("print as a value")
  ["x", "y"] |> map((x) => string_concat(x, "!")) |> each(print)
}
