# A `test` / `bench` / `check` body absorbs the compiler-synthesised
# `Ffi` capability the program entry may declare, so a library that
# binds C can test its actual boundary instead of only pure wrappers.
# Libc-only so it links without extra cc flags; `puts` writing to
# stdout proves the extern really ran (the golden captures it).

extern "C" fn puts(s: String) : I32 / Ffi

fn shout(s: String) : I32 / Ffi = puts(s)

test "extern crosses the boundary directly" {
  assert puts("direct") >= 0
}

test "extern crosses via a declared / Ffi wrapper" {
  assert shout("wrapped") >= 0
}

bench "extern in a bench body" {
  let _ = puts("bench")
}

check "extern in a check body" with n: Int {
  puts("check") >= 0
}
