# Context travels as a value: the `Pid` of the actor that owns the state (here
# `main`, which then drains its mailbox) is parked behind a `Userdata` handle (`void *` to C), and the exported callback
# forwards what C reports to that actor. The shim rides CFLAGS.

import actor
import ffi

type Msg = Tick(Int) | Done

extern "C" fn on_event(ud: Userdata[Pid[Msg]], n: Int) : Unit / Ffi = {
  let pid: Pid[Msg] = take_userdata(ud)
  mailbox_send(pid, if n < 0 { Done } else { Tick(n) })
}

extern "C" fn fire_events(ud: Userdata[Pid[Msg]]) : Unit / Ffi

fn collector(seen: Int) : Unit / Actor[Msg] + Stdout =
  match Actor.receive() {
    Tick(n) -> collector(seen + n)
    Done    -> Stdout.print("sum=#{seen}")
  }

pub fn main() : Unit / Stdout + Ffi + Spawn = with_mailbox {
  let ud = retain_userdata(Actor.self())
  fire_events(ud)
  release_userdata(ud)
  collector(0)
}
