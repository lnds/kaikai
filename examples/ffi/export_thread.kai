# Four C threads call an exported fn whose body parks (it spawns a fiber and
# awaits it), so the body runs on a scheduler fiber while the caller blocks.
# Needs the worker pool: the shim rides CFLAGS and the target sweeps
# KAI_THREADS over values above 1.

import spawn

extern "C" fn square_via_fiber(n: Int) : Int / Spawn = {
  nursery { s ->
    let f = s.spawn(() => n * n)
    s.await(f)
  }
}

extern "C" fn run_threads() : Int / Ffi

pub fn main() : Unit / Stdout + Ffi = {
  Stdout.print("sum=#{run_threads()}")
}
