# The entry fiber must run on the OS thread the process entered `main` on,
# at every KAI_THREADS. A thread-affine C library (AppKit, and through it
# GLFW/SDL/GTK) traps if initialised anywhere else, so the pin is a
# guarantee kaikai owes any FFI caller — not a scheduler detail.
#
# The shim rides CFLAGS (`kai info ffi`).

import spawn

extern "C"("kai_on_main_thread") fn on_main_thread() : Int / Ffi

fn probe() : Int / Ffi = on_main_thread()

pub fn main() : Unit / Stdout + Ffi + Spawn = {
  Stdout.print("main on main thread: #{on_main_thread()}")
  # Spawned fibers stay freely stealable: the pin covers the entry fiber
  # only, so this still parks and resumes across the worker pool.
  let n = nursery { s ->
    let fibers = [1, 2, 3, 4, 5, 6, 7, 8] | (i => s.spawn(() => probe()))
    fibers | (f => s.await(f))
  }
  Stdout.print("children ran: #{n.length()}")
  Stdout.print("main still on main thread: #{on_main_thread()}")
}
