type Handlers[e] = { on_tick: (Int) -> Unit / e, on_done: () -> Unit / e }

fn dispatch[e](h: Handlers[e], n: Int) : Unit / e =
  if n == 0 { h.on_done() } else { notify(h, n - 1) }

fn notify[e](h: Handlers[e], n: Int) : Unit / e = {
  h.on_tick(n)
  dispatch(h, n)
}

fn main() : Unit / Stdout = {
  let h = Handlers { on_tick: (i) => if i % 250000 == 0 { Stdout.print("tick #{i}") }, on_done: () => Stdout.print("done") }
  dispatch(h, 1000000)
}
