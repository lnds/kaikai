fn same_a[t : Eq](n: Int, x: t, y: t) : Bool =
  if n == 0 { x == y } else { same_b(n - 1, y, x) }

fn same_b[t : Eq](n: Int, x: t, y: t) : Bool =
  if n == 0 { x != y } else { same_a(n - 1, y, x) }

fn main() : Unit / Stdout = {
  Stdout.print("#{same_a(1000000, 1, 1)}")
  Stdout.print("#{same_b(1000001, "a", "b")}")
}
