fn left[t, u](n: Int, x: t, unused: u) : Int =
  if n == 0 { 1 } else { right(n - 1, unused, x) }

fn right[t, u](n: Int, unused: u, x: t) : Int =
  if n == 0 { 2 } else { left(n - 1, x, unused) }

fn main() : Unit / Stdout = {
  Stdout.print("#{left(1000000, "a", 3)}")
  Stdout.print("#{right(1000001, 1.5, true)}")
}
