# A guaranteed tail call in an impl whose match also has a non-exhaustive join block.

pub type Tag = Tag(String)

impl BinSerialize for Tag {
  fn to_bytes(self: Tag) : Array[Byte] = match self {
    Tag(s) -> to_bytes(s)
  }
  fn from_bytes(buf: Array[Byte], pos: Int) : Result[BinCursor[Tag], String] = Err("unused")
}

fn main() : Unit / Stdout = {
  Stdout.print(bin_string_at(to_bytes(Tag("tail")), 0))
}
