import stream

fn serve(path: String) : Unit / Stdout + File + ReadFault =
  stream.read_lines(path) |> stream.each((l) => Stdout.print("each: #{l}"))

fn serve_pipe(path: String) : Unit / Stdout + File + ReadFault =
  stream.read_lines(path) |! Stdout.print("pipe: #{.}")

fn serve_stages(path: String) : Int / Stdout + File + ReadFault =
  stream.read_lines(path)
    |? ((l) => { Stdout.print("filter: #{l}"); l != "b" })
    | ((l) => { Stdout.print("map: #{l}"); l })
    |> stream.foldl(0, (n, l) => { Stdout.print("fold: #{l}"); n + 1 })

fn main() : Unit / Stdout = {
  let st = array_make(1, 0)
  handle {
    handle {
      serve("x")
      serve_pipe("x")
      let n = serve_stages("x")
      Stdout.print("count=#{int_to_string(n)}")
    }
    with ReadFault {
      bad_chunk(_m, resume)  -> resume(())
      open_fault(_m, _resume) -> ()
    }
  } with File {
    open_read(_p, resume)        -> resume(Ok(file_handle(1)))
    read_chunk(_h, _max, resume) -> {
      st[0] := st[0] + 1
      resume(Ok(if st[0] % 2 == 1 { "a\nb\nc\n" } else { "" }))
    }
    close_file(_h, resume)       -> resume(())
    open_write(_p, resume)       -> resume(Err("no write"))
    write_chunk(_h, _d, resume)  -> resume(Err("no write"))
    return(x)                    -> x
  }
}
