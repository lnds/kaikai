effect Dice {
  roll(n: Int) : Int
}

fn pure(n: Int) : Int = ?pure

fn declared(n: Int) : Int / Random = ?declared

fn handled(n: Int) : Int = handle { ?handled } with Dice {
  roll(k, resume) -> resume(k)
}

fn open[e](n: Int) : Int / e = ?open

fn main() : Unit = {
  let m = 3
  let k = ?in_main
  Stdout.print("#{pure(1)} #{declared(1)} #{handled(1)} #{open(1)} #{k + m}")
}
