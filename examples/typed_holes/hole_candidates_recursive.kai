# A recursive call on a sub-term is still a candidate.

type Arbol = Hoja | Nodo(Arbol, Arbol)

type Cuenta = Cuenta(Int)

fn contar(a: Arbol) : Cuenta = match a {
  Hoja -> Cuenta(1)
  Nodo(izq, _) -> ?sub
}

fn main() : Unit / Stdout = match contar(Nodo(Hoja, Hoja)) {
  Cuenta(n) -> println("#{n}")
}
