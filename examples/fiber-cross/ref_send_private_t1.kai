# fixture: threads=1
# A message crosses by value at any thread count: a closure over a Ref arrives
# as a copy, so the sender's cell is untouched by the receiver's write.
import actor

fn main() : Int / Spawn + Stdout + Mutable = with_mailbox {
  let r = &0
  let msg = (
    () => {
      r := 5
    },
    () => @r
  )
  Actor.send(Actor.self(), msg)
  let (set, got) = Actor.receive()
  set()
  println("sender sees #{@r}, receiver sees #{got()}")
  0
}
