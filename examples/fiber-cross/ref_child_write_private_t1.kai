# fixture: threads=1
# The spawned fiber runs on its own copy of the captured Ref at any thread count.
import spawn

fn main() : Int / Spawn + Stdout + Mutable {
  let r = &0
  let bump = () => {
    r := 5
    ()
  }
  nursery { n ->
    let _f = n.spawn(() => {
      let g = bump
      g()
      ()
    })
    ()
  }
  println("parent sees #{@r}")
  0
}
