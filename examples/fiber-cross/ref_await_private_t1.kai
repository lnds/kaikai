# fixture: threads=1
# A fiber's result crosses by value at any thread count: a closure over a Ref
# comes back as a copy, so each await owns its cell.
import spawn

fn cell() : (() -> Unit / Mutable, () -> Int / Mutable) / Mutable = {
  let r = &0
  (() => { r := 5 }, () => @r)
}

fn main() : Int / Spawn + Stdout + Mutable {
  nursery { n ->
    let f = n.spawn(() => cell())
    let (set, _) = n.await(f)
    set()
    let (_, get) = n.await(f)
    println("second await sees #{get()}")
  }
  0
}
