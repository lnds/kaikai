import spawn

fn run_in_child[t](x: t, g: (t) -> Unit / Mutable) : Unit / Spawn + Mutable = nursery { n ->
  let f = n.spawn(() => g(x))
  n.await(f)
}

fn main() : Int / Spawn + Stdout + Mutable = {
  let r = Mutable.ref_make(0)
  run_in_child(r, (c) => Mutable.ref_set(c, Mutable.ref_get(c) + 1))
  Stdout.print("parent sees #{Mutable.ref_get(r)}")
  0
}
