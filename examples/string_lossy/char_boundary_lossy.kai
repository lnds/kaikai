# A boundary is any offset where the decoder starts a character: an
# invalid byte is a character of width 1, a continuation byte inside a
# valid sequence is not a boundary.

fn starts(s: String) : [Int] = string.char_indices(s) |> map(ci => ci.off)

fn has(xs: [Int], i: Int) : Bool = match xs {
  [] -> false
  [x, ...rest] -> if x == i { true } else { has(rest, i) }
}

fn floor_ref(xs: [Int], i: Int, n: Int) : Int =
  if i <= 0 { 0 } else if i >= n or has(xs, i) { i } else { floor_ref(xs, i - 1, n) }

fn ceil_ref(xs: [Int], i: Int, n: Int) : Int =
  if i >= n { n } else if has(xs, i) { i } else { ceil_ref(xs, i + 1, n) }

fn mismatch(s: String, i: Int, n: Int, xs: [Int]) : Int {
  let want = i == 0 or i == n or has(xs, i)
  let ok =
    string.is_char_boundary(s, i) == want
      and string.floor_char_boundary(s, i) == floor_ref(xs, i, n)
      and string.ceil_char_boundary(s, i) == ceil_ref(xs, i, n)
  if ok { 0 } else { 1 }
}

fn mismatch_all(s: String, i: Int, n: Int, xs: [Int]) : Int =
  if i > n { 0 } else { mismatch(s, i, n, xs) + mismatch_all(s, i + 1, n, xs) }

fn bounds(s: String, i: Int, n: Int) : String =
  if i > n {
    ""
  } else {
    let b = if string.is_char_boundary(s, i) { "1" } else { "0" }
    b ++ bounds(s, i + 1, n)
  }

fn report(label: String, s: String) : Unit / Console {
  let n = string.byte_length(s)
  let bad = mismatch_all(s, 0, n, starts(s))
  print("#{label} n=#{n} bounds=#{bounds(s, 0, n)} mismatches=#{bad}")
}

fn main() : Unit / Console {
  print("#{string.byte_length(string.slice("\x89abc", 0, 2))}")
  print("#{string.byte_length(string.slice("a\x89bc", 1, 1))}")
  report("png", "\x89abc")
  report("stray", "a\x89bc")
  report("truncated", "ab\xE2\x82")
  report("badlead", "\xFFx")
  report("overlong", "a\xC0\x80b")
  report("overlong3", "\xE0\x80\x80")
  report("surrogate", "\xED\xA0\x80")
  report("valid", "a\u{e9}\u{20ac}\u{1F600}z")
  report("mixed", "\x89\u{e9}\xE2\x82\u{20ac}\xF0\x9F\x98\xFF\u{1F600}")
  report("empty", "")
}
