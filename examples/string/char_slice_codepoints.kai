# `string.slice` indexes Unicode codepoints, never bytes: a multibyte
# sequence is copied whole or not at all. Out-of-range indices clamp.

fn main() : Unit / Console {
  print(string.char_slice("café", 2, 2))
  print(string.char_slice("café", 0, 4))
  print(string.char_slice("café", 3, 1))
  print(string.char_slice("áé▸", 1, 2))
  print(string.char_slice("aá€中😀z", 2, 3))
  print(string.char_slice("hola", 1, 2))
  # Clamping: short tail, past the end, non-positive len, negative from.
  print(string.char_slice("café", 3, 9))
  print("[#{string.char_slice("café", 9, 2)}]")
  print("[#{string.char_slice("café", 1, 0)}]")
  print(string.char_slice("café", -3, 2))
  print("[#{string.char_slice("", 0, 3)}]")
  # The result is well-formed UTF-8: it round-trips through chars.
  print("#{string.char_count(string.char_slice("aá€中😀z", 1, 4))}")
  print("#{string.byte_length(string.char_slice("aá€中😀z", 1, 4))}")
}
