# `string.byte_slice` indexes bytes and declines a cut that would split
# a codepoint, returning `None` instead of an ill-formed string.
# `is_char_boundary` / `floor_char_boundary` / `ceil_char_boundary` let a
# caller snap an arbitrary byte offset onto a boundary first.

fn show(o: Option[String]) : String = match o {
  Some(s) -> "Some(#{s})"
  None    -> "None"
}

fn main() : Unit / Console {
  let s = "café"
  # "é" spans bytes 3..5, so 4 is the only interior offset.
  print(show(string.byte_slice(s, 0, 3)))
  print(show(string.byte_slice(s, 3, 2)))
  print(show(string.byte_slice(s, 0, 5)))
  print(show(string.byte_slice(s, 0, 4)))
  print(show(string.byte_slice(s, 4, 1)))
  print(show(string.byte_slice(s, 3, 1)))
  print(show(string.byte_slice(s, 0, -1)))
  print(show(string.byte_slice(s, 0, 9)))
  print(show(string.byte_slice("", 0, 0)))

  print("#{string.is_char_boundary(s, 0)} #{string.is_char_boundary(s, 3)} #{string.is_char_boundary(s, 5)}")
  print("#{string.is_char_boundary(s, 4)} #{string.is_char_boundary(s, 6)} #{string.is_char_boundary(s, -1)}")

  # "a😀z": 'a' at 0, the 4-byte 😀 at 1..5, 'z' at 5.
  let w = "a😀z"
  print("#{string.floor_char_boundary(w, 3)} #{string.ceil_char_boundary(w, 3)}")
  print("#{string.floor_char_boundary(w, 1)} #{string.ceil_char_boundary(w, 1)}")
  print("#{string.floor_char_boundary(w, 99)} #{string.ceil_char_boundary(w, -4)}")

  # Truncate-to-N-bytes without splitting: the canonical use.
  print(show(string.byte_slice(w, 0, string.floor_char_boundary(w, 3))))

  # index_of pairs with byte_slice, char_index_of with slice.
  let t = "aá€中z"
  print("#{option.unwrap_or(string.index_of(t, "中"), -1)} #{option.unwrap_or(string.char_index_of(t, "中"), -1)}")
  print(show(string.byte_slice(t, option.unwrap_or(string.index_of(t, "中"), 0), 3)))
  print(string.slice(t, option.unwrap_or(string.char_index_of(t, "中"), 0), 2))
}
