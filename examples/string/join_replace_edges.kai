fn show(s: String) : Unit / Console = print("[#{s}]")

fn main() : Unit / Console {
  show(string.join([], ","))
  show(string.join(["a"], ","))
  show(string.join(["a", "b", "c"], ", "))
  show(string.join(["", "", ""], "-"))
  show(string.join(["é", "😀"], "→"))
  show(string.replace("", "a", "b"))
  show(string.replace("abc", "", "X"))
  show(string.replace("abc", "abc", "X"))
  show(string.replace("abcabc", "abc", ""))
  show(string.replace("aaa", "aa", "b"))
  show(string.replace("xaay", "a", "bb"))
  show(string.replace("ax", "a", "é"))
  show(string.replace("xa", "a", "😀"))
  show(string.replace("hello", "z", "y"))
}
