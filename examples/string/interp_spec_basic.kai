fn main() : Unit / Stdout = {
  let n = 42
  let neg = 0 - 42
  let s = "ab"
  let x = 3.14159
  Stdout.print("[#{n:5}][#{n:05}][#{neg:05}][#{neg:6}][#{n:<5}][#{n:>5}][#{n:^6}]")
  Stdout.print("[#{s:5}][#{s:<5}][#{s:>5}][#{s:^5}][#{s:^6}][#{s:1}]")
  Stdout.print("[#{x:.2}][#{x:.0}][#{x:.4}][#{x:8.2}][#{x:<8.2}][#{x:^8.2}][#{x:08.2}]")
  Stdout.print("[#{0.0 - x:.2}][#{0.0 - x:010.3}][#{0.0 - 0.4:.0}]")
  Stdout.print("[#{2.675:.2}][#{0.5:.0}][#{1.5:.0}][#{2.5:.0}][#{3.5:.0}]")
  Stdout.print("[#{n:2}][#{n:1}][#{n:0}][#{n:00}]")
}
