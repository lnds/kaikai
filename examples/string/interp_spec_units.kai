unit m
unit sec

fn main() : Unit / Stdout = {
  let v: Real<m / sec> = 100.0<m> / 9.58<sec>
  let d: Real<m> = 2.5<m>
  let bare = 2.5
  println("#{v}")
  println("[#{v:.2}][#{d:.1}][#{bare:.1}]")
  let n: Real<m> = -2.5<m>
  println("[#{d:012.2}][#{n:012.2}]")
  println("[#{v:14.2}][#{v:<14.2}][#{v:^14.2}][#{v:>14.2}]")
}
