# `string.to_upper` / `to_lower` fold ASCII letters and pass every
# other codepoint through byte-exact. Regression for the rebuild path
# that rendered non-ASCII chars through Show[Char] interpolation,
# emitting the raw low byte instead of the UTF-8 sequence.

fn main() : Unit / Console {
  print(string.to_upper("aá€ z"))
  print(string.to_lower("Aá€ Z"))
  print(string.to_upper("áé▸"))
  print("#{int_to_string(string.byte_length(string.to_upper("aá€ z")))}")
  print("#{int_to_string(string.char_count(string.to_upper("aá€ z")))}")
}
