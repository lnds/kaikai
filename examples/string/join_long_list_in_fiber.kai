import spawn

fn joined(n: Int) : Int = length(join(list.repeat("x", n), ","))

fn main() : Unit / Console + Spawn {
  println("main: #{joined(100000)}")
  let f = spawn(() => joined(100000))
  println("fiber: #{await(f)}")
  println("empty: [#{join([], ",")}] one: [#{join(["a"], ",")}] three: [#{join(["a", "b", "c"], "-")}]")
}
