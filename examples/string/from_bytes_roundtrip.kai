# `string.from_bytes` is the inverse of `string.bytes`: bytes go out
# and come back verbatim, so a non-ASCII string round-trips byte-exact.
# The two views are distinct types — `bytes` yields `[Byte]`, `chars`
# yields `[Char]` — so a byte list can no longer be fed to `from_chars`
# and double-encoded.

fn show_bytes(bs: [Byte]) : String = match bs {
  []           -> ""
  [b]          -> int_to_string(byte_to_int(b))
  [b, ...rest] -> "#{int_to_string(byte_to_int(b))} #{show_bytes(rest)}"
}

fn main() : Unit / Console {
  print("[#{string.from_bytes([])}]")
  print(string.from_bytes([104u8, 105u8]))

  # café is 5 bytes / 4 codepoints — é is 0xC3 0xA9.
  print(show_bytes(string.bytes("café")))
  print(string.from_bytes(string.bytes("café")))

  # round-trip across the full 1..4-byte width range
  print(string.from_bytes(string.bytes("hello")))
  print(string.from_bytes(string.bytes("áé▸")))
  print(string.from_bytes(string.bytes("aá€中😀z")))

  # byte length and codepoint count survive the round-trip
  print("#{int_to_string(string.byte_length(string.from_bytes(string.bytes("aá€中😀z"))))}")
  print("#{int_to_string(string.char_count(string.from_bytes(string.bytes("aá€中😀z"))))}")

  # bytes and chars disagree on multibyte input, agree on ASCII
  print("#{int_to_string(list.length(string.bytes("áé▸")))} #{int_to_string(list.length(string.chars("áé▸")))}")
  print("#{int_to_string(list.length(string.bytes("abc")))} #{int_to_string(list.length(string.chars("abc")))}")
}
