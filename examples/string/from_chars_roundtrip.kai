# `string.from_chars` is the inverse of `string.chars`: it UTF-8
# encodes each codepoint, so decompose -> transform -> reassemble
# round-trips byte-exact across the full 1..4-byte width range.

fn main() : Unit / Console {
  print("[#{string.from_chars([])}]")
  print(string.from_chars(['a', 'b', 'c']))

  # 2-byte á (U+00E1), 3-byte € (U+20AC), 4-byte 😀 (U+1F600)
  print(string.from_chars([int_to_char(225)]))
  print(string.from_chars([int_to_char(8364)]))
  print(string.from_chars([int_to_char(128512)]))

  # chars |> from_chars round-trip, ascii and multibyte
  print(string.from_chars(string.chars("hello")))
  print(string.from_chars(string.chars("áé▸")))
  print(string.from_chars(string.chars("aá€中😀z")))

  # byte length and codepoint count survive the round-trip
  print("#{int_to_string(string.byte_length(string.from_chars(string.chars("aá€中😀z"))))}")
  print("#{int_to_string(string.char_count(string.from_chars(string.chars("aá€中😀z"))))}")

  # a char-level transform can now reassemble: reverse via chars
  print(string.from_chars(list.reverse(string.chars("áb😀"))))
}
