# `to_int_radix` parses digits of either case in radix 2..36 under the
# sign and overflow rules of `to_int`; `int_to_string_radix` is its
# lowercase inverse. A radix out of range is `None` both ways.

fn show(r: Option[Int]) : String = match r {
  Some(n) -> int_to_string(n)
  None    -> "None"
}

fn render(n: Int, radix: Int) : String = match int_to_string_radix(n, radix) {
  Some(s) -> s
  None    -> "None"
}

fn round_trip(n: Int, radix: Int) : String = match int_to_string_radix(n, radix) {
  Some(s) -> match to_int_radix(s, radix) {
    Some(m) -> if m == n { "ok" } else { "MISMATCH #{s}" }
    None    -> "MISMATCH #{s}"
  }
  None -> "MISMATCH None"
}

fn main() : Unit / Console {
  print(show(to_int_radix("101", 2)))
  print(show(to_int_radix("777", 8)))
  print(show(to_int_radix("ff", 16)))
  print(show(to_int_radix("DeadBeef", 16)))
  print(show(to_int_radix("Zz", 36)))
  print(show(to_int_radix("-1010", 2)))
  print(show(to_int_radix("+7f", 16)))
  print(show(to_int_radix("0", 36)))

  print(show(to_int_radix("2", 2)))
  print(show(to_int_radix("g", 16)))
  print(show(to_int_radix("1 ", 10)))
  print(show(to_int_radix(" 1", 10)))
  print(show(to_int_radix("", 10)))
  print(show(to_int_radix("-", 10)))
  print(show(to_int_radix("10", 1)))
  print(show(to_int_radix("10", 37)))

  print(show(to_int_radix("7fffffffffffffff", 16)))
  print(show(to_int_radix("8000000000000000", 16)))
  print(show(to_int_radix("-8000000000000000", 16)))
  print(show(to_int_radix("-8000000000000001", 16)))

  print(render(5, 2))
  print(render(511, 8))
  print(render(48879, 16))
  print(render(1295, 36))
  print(render(-255, 16))
  print(render(0, 2))
  print(render(-9223372036854775807 - 1, 2))
  print(render(10, 1))
  print(render(10, 37))

  print(round_trip(-9223372036854775807 - 1, 36))
  print(round_trip(9223372036854775807, 2))
  print(round_trip(-123456789, 7))
  print(round_trip(0, 16))
}
