# `string.trim_left` / `string.trim_right` remove whitespace from one
# end only (same set as `trim`: space, tab, newline, carriage return),
# leaving the other end byte-exact — the property indentation-significant
# formats depend on.

fn main() : Unit / Console {
  # one-sided: the other end survives untouched
  print("[#{string.trim_left("  hello  ")}]")
  print("[#{string.trim_right("  hello  ")}]")
  print("[#{string.trim_left("\t\n\r x")}]")
  print("[#{string.trim_right("x \t\n\r")}]")

  # whitespace only on the untouched side is preserved whole
  print("[#{string.trim_left("hello \t")}]")
  print("[#{string.trim_right(" \thello")}]")

  # no whitespace, all whitespace, empty
  print("[#{string.trim_left("hello")}]")
  print("[#{string.trim_right("hello")}]")
  print("[#{string.trim_left("   ")}]")
  print("[#{string.trim_right("   ")}]")
  print("[#{string.trim_left("")}]")
  print("[#{string.trim_right("")}]")

  # multibyte content is untouched; only ASCII whitespace goes
  print("[#{string.trim_left("  áé▸ ")}]")
  print("[#{string.trim_right(" áé▸  ")}]")

  # markdown-shaped: leading indent significant, trailing spaces not
  print("[#{string.trim_right("    - item  ")}]")
}
