# `string.slice(s, from, len)` — byte-indexed substring. The
# `(start, length)` shape, NOT end-exclusive: every call-site in
# `core/string.kai` passes a length, so the wrapper preserves that
# convention rather than inventing a divergent `(start, end)` API.
# ASCII only; `examples/string_offsets` covers the multibyte case.

fn main() : Unit / Console {
  print(string.slice("hola", 0, 2))
  print(string.slice("hola", 1, 2))
  print(string.slice("hola", 2, 2))
  print(string.slice("hola", 0, 4))
  print("[#{string.slice("hola", 0, 0)}]")
}
