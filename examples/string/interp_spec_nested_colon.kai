import collections.map

type Point = { x: Int, y: Int }

fn main() : Unit / Stdout = {
  let p = Point { x: 1, y: 2 }
  let m = %{ "k": 7 }
  let n = 5
  Stdout.print("[#{Point { x: 3, y: 4 }.x}][#{Point { x: 3, y: 4 }.y:3}]")
  Stdout.print("[#{if n > 1 { 1 } else { 2 }}][#{if n > 1 { 1 } else { 2 }:3}]")
  Stdout.print("[#{m["k"]}][#{m["k"]:5}][#{p.x:<3}]")
  Stdout.print("[#{(n):3}][#{(n + 1):<3}]")
  Stdout.print("[#{"in#{n:3}ner"}][#{"in#{n:3}ner":12}]")
  Stdout.print("[#{label(n):>6}]")
  Stdout.print("[#{map_len(%{ "k": 7 }):2}][#{map_len(m)}]")
  let f = (a: Int) => a * 2
  Stdout.print("[#{f(n):4}]")
}

fn label(n: Int) : String = match n {
  5 -> "five"
  _ -> "other"
}

fn map_len(m: Map[String, Int]) : Int = 1
