# The variant walker reads its candidates from a return-tycon index
# rather than the whole env. Two same-name types of DIFFERENT arity
# must stay separated (the arity pin), and the arity sentinel that
# closes a declaration must still be reachable through the index --
# it carries no return tycon of its own, so it is keyed under the
# type it closes. Losing it would let an earlier declaration's
# variants leak into this one's exhaustiveness check.

type Pair[a, b] = PLeft(a) | PRight(b)

type Pair2 = POne | PTwo

fn describe(p: Pair[Int, Bool]) : String = match p {
  PLeft(n)  -> "left #{n}"
  PRight(b) -> "right #{b}"
}

fn describe2(p: Pair2) : String = match p {
  POne -> "one"
  PTwo -> "two"
}

fn main() : Unit / Stdout = {
  println(describe(PLeft(7)))
  println(describe(PRight(true)))
  println(describe2(POne))
  println(describe2(PTwo))
}
