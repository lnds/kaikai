# A bare constructor with no expected type is read on the scope ladder:
# the file's own `Response.Ok` is nearer than the core's `Result.Ok`, so
# an unannotated `let` builds the `Response`. The core one stays one
# annotation away.

pub type Response = Ok(String) | NotFound

fn describe(r: Response) : String = match r {
  Ok(s)    -> s
  NotFound -> "not found"
}

fn main() : Unit / Stdout = {
  let x = Ok("hello")
  let y : Result[Int, String] = Ok(7)
  let n = match y {
    Ok(v)  -> v
    Err(_) -> 0
  }
  println("#{describe(x)} #{n}")
}
