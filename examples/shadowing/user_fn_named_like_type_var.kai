# A top-level `fn` may take a name the prelude uses as an implicitly
# bound type variable (`fn swap(p: Pair[a, b])` binds `a`/`b` without
# declaring them). Such a name lives in the value namespace and must
# not be matched against type positions in another module's signature.

fn a(x: Int) : Int = x + 1

fn b(x: Int) : Int = x * 2

fn c(x: Int) : Int = x - 3

fn e(x: Int) : Int = x + 10

fn p(x: Int) : Int = x + 100

fn u(x: Int) : Int = x + 1000

fn main() : Unit / Stdout {
  Stdout.print("#{a(41)}")
  Stdout.print("#{b(21)}")
  Stdout.print("#{c(45)}")
  Stdout.print("#{e(32)}")
  Stdout.print("#{p(-58)}")
  Stdout.print("#{u(-958)}")
  # The prelude helpers whose signatures bind these names implicitly
  # still resolve to the prelude, not to the local decls above.
  let pair = tuple.swap(Pair { fst: 1, snd: 2 })
  Stdout.print("#{pair.fst}")
}
