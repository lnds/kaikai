# A match-arm binder named like a top-level fn shadows it inside the arm,
# including inside a lambda that reads it: the lambda must capture the
# bound value, never re-resolve the name to the global fn.

type Pair = Pair(Int, Int)

fn scale(n: Int) : Int = n * 100
fn offset(n: Int) : Int = n - 1000

fn show(xs: [Int]) : String = join(map(xs, (x) => int_to_string(x)), ",")

fn by_param(scale: Int) : [Int] = map([1, 2], (x) => x * scale)

fn by_let(p: Int) : [Int] {
  let scale = p
  map([1, 2], (x) => x * scale)
}

fn arm_direct(p: [Int]) : Int = match p {
  [] -> 0
  [scale, ..._] -> scale * 2
}

fn arm_list(p: [Int]) : [Int] = match p {
  [] -> []
  [scale, ..._] -> map([1, 2], (x) => x * scale)
}

fn arm_nested(p: Option[Pair]) : [Int] = match p {
  None -> []
  Some(Pair(scale, offset)) -> map([1, 2], (x) => x * scale + offset)
}

fn arm_as(p: [Int]) : [Int] = match p {
  scale @ [_, ..._] -> map([1, 2], (x) => x * list_length(scale))
  _ -> []
}

fn arm_guard(p: Int) : [Int] = match p {
  scale if scale > 0 -> map([1, 2], (x) => x * scale)
  _ -> []
}

fn arm_nested_lambda(p: [Int]) : [Int] = match p {
  [] -> []
  [scale, ..._] -> map([1, 2], (x) => list_length(map([x], (y) => y * scale)) * scale)
}

fn clause(p: Int) : [Int] {
  case scale -> map([1, 2], (x) => x * scale)
}

# A sibling arm without the binder still reads the global fn.
fn arm_sibling(p: [Int]) : [Int] = match p {
  [scale] -> map([1, 2], (x) => x * scale)
  _ -> map([1, 2], (x) => scale(x))
}

fn main() : Unit / Stdout = {
  Stdout.print("param " ++ show(by_param(4)))
  Stdout.print("let " ++ show(by_let(4)))
  Stdout.print("direct " ++ int_to_string(arm_direct([4])))
  Stdout.print("list " ++ show(arm_list([4])))
  Stdout.print("nested " ++ show(arm_nested(Some(Pair(4, 7)))))
  Stdout.print("as " ++ show(arm_as([9, 9, 9])))
  Stdout.print("guard " ++ show(arm_guard(4)))
  Stdout.print("nested-lambda " ++ show(arm_nested_lambda([4])))
  Stdout.print("clause " ++ show(clause(4)))
  Stdout.print("sibling " ++ show(arm_sibling([4])) ++ " " ++ show(arm_sibling([])))
}
