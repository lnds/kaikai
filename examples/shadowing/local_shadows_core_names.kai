# A local binder reaches itself, whatever core function or protocol
# operation shares its spelling: called directly, through `|>`, as a
# value, and captured by a closure.
fn main() : Unit / Stdout = {
  let max = (xs: [Int]) => 42
  let show = (x: Int) => "local #{x}"
  let length = (x: [Int]) => "local length"
  let reverse = (x: Int) => x + 1000
  let min = (a: Int, b: Int) => a * b
  let pick = max
  let wrap = (n: Int) => show(n + 1)
  Stdout.print("#{max([1, 2])} #{[3] |> max} #{pick([4])}")
  Stdout.print("#{show(3)} #{3 |> show} #{wrap(4)}")
  Stdout.print("#{length([3])} #{reverse(5)} #{2 |> min(7)}")
}
