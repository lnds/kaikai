# A root function named like a core fold terminal is reached by the
# pipe that ends in it, not fused into the core fold.
fn product(z: [Int]) : String = "mine #{list.length(z)}"

fn main() : Unit / Stdout = {
  let piped = ([2, 4] | ((v) => v + 1)) |> product
  let direct = product([2, 4] | ((v) => v + 1))
  Stdout.print("#{piped} #{direct}")
}
