# A local `show` is reached by its own calls, while every `#{...}` in
# its scope, and inside its own body, still stringifies through the
# protocol operation.
fn main() : Unit / Stdout = {
  let show = (x: Int) => "local #{x}"
  Stdout.print(show(3))
  Stdout.print("#{5} and #{show(4)} and #{[1, 2]}")
}
