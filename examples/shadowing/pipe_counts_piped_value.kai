# The piped value is an argument: `[1] |> min(2, [3])` calls the
# three-argument `min` exactly as `min([1], 2, [3])` does.
fn min(a: [Int], v: Int, c: [Int]) : Bool = v > 0

fn main() : Unit / Stdout = {
  let direct = min([1], 2, [3])
  let piped = [1] |> min(2, [3])
  let slot = 2 |> min([1], _, [3])
  Stdout.print("#{direct} #{piped} #{slot}")
}
