# Issue #2023 — a root-file `pub fn` with the SAME bare name as a core
# fn but a DIFFERENT arity must not collide with the core's own C
# symbol under separate compilation. `pub` gives the root decl a module
# tag (`tag_target_decl`), so its mangled symbol is
# `kaiu_<root>__in_range`, distinct from `kaiu_char_unicode__in_range` —
# this must link even though `char_unicode`'s own body calls its
# `in_range` internally.

pub fn in_range(n: Int) : Bool = n > 0 and n < 1000

fn main() : Int {
  println(if in_range(42) { "user in_range: yes" } else { "user in_range: no" })
  println(if is_upper('A') { "core is_upper: yes" } else { "core is_upper: no" })
  0
}
