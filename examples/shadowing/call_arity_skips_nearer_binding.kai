# A call passes over a nearer binding of another arity: the root
# `min/1` answers one-argument calls, `Ord.min` the two-argument ones,
# the core `list.max/1` and `Ord.max/2` share a name the same way, and a
# local `max/3` answers only three-argument calls.
fn min(xs: [Int]) : Int = 100

fn main() : Unit / Stdout = {
  let max = (a: Int, b: Int, c: Int) => a + b + c
  Stdout.print("#{min([1])} #{min(1, 2)} #{[1] |> min} #{3.min(9)}")
  Stdout.print("#{max([3, 9])} #{max(3, 9)} #{add(1, 2)}")
  Stdout.print("#{max(1, 2, 3)} #{max(1, 2)} #{max([4, 5])}")
}
