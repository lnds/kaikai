# Issue #2023 — a root-file `pub fn` with the SAME bare name AND arity
# as a core's internal helper must not shadow it inside the core's own
# body. `char_unicode.is_upper` calls its own `in_range(n, lo, hi)`
# bare; the user's `pub fn in_range(a, b, c)` must stay confined to the
# root and never leak into `is_upper`'s call.

pub fn in_range(a: Int, b: Int, c: Int) : Bool = false

fn main() : Int {
  println(if in_range(1, 0, 100) { "user in_range: yes" } else { "user in_range: no" })
  println(if is_upper('A') { "core is_upper: yes" } else { "core is_upper: no" })
  0
}
