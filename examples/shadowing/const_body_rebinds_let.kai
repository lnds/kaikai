# A constant's body is a body like any other: a `let` that rebinds a
# name it already bound declares a second local, not the first again.

const LIMIT : Int = {
  let x = 2
  let x = x * 10
  x + 1
}

const LABEL : String = {
  let s = "a"
  let s = string_concat(s, "b")
  string_concat(s, "c")
}

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(LIMIT))
  Stdout.print(LABEL)
}
