import encoding.json_bind

type Box = Box(String) | Empty
type Pair2 = Pair2(Int, Int)
type Wrap[T] = Wrap(T)

fn describe(b: Box) : String = match b {
  Box(s) -> s
  Empty  -> "empty"
}

fn apply(f: (String) -> Box, s: String) : Box = f(s)

fn main() : Int / Stdout {
  let boxes = ["a", "b"] | Box
  Stdout.print("#{length(boxes)}")
  let mk = Box
  Stdout.print(describe(mk("late")))
  Stdout.print(describe(apply(Box, "arg")))
  let pairs = [1, 2, 3] | (n => Pair2(n, n))
  let mk2 = Pair2
  match mk2(4, 5) {
    Pair2(a, b) -> Stdout.print("#{a + b}")
  }
  let somes = [1, 2] | Some
  Stdout.print("#{length(somes)}")
  let oks = ["x"] | Ok
  Stdout.print("#{length(oks)}")
  let wraps = [7, 8, 9] | Wrap
  Stdout.print("#{length(wraps)}")
  let strs = ["a", "b"] | json_bind.JStr
  Stdout.print("#{length(strs)}")
  Stdout.print(describe(Empty))
  Stdout.print("#{length(pairs)}")
  0
}
