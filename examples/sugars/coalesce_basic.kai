fn nothing() : Option[Int] = None

fn first_or_fail(o: Option[Int]) : Option[Int] {
  let v = o ?? nothing()!
  Some(v + 1)
}

fn main() : Unit / Console {
  let some: Option[Int] = Some(3)
  let none: Option[Int] = None
  let word: Option[String] = None
  let flag: Option[Bool] = None
  println(show(some ?? 0))
  println(show(none ?? 7))
  println(show(none ?? none ?? 9))
  println(show(none ?? Some(2) ?? 9))
  println(show(none ?? 1 + 2))
  println(show(none ?? 0 == 0))
  println(show(flag ?? false or true))
  println(word ?? "" ++ "!")
  println(show([Some(1), None, Some(5)] | . ?? 0))
  println(show(first_or_fail(None)))
  println(show(first_or_fail(Some(1))))
  println(show(none
    ?? 4))
}
