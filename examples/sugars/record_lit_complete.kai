# Every complete record literal form: named in and out of declaration
# order, positional, punned, spread, and generic.

#[derive(Eq)]
type W = { a: Int, b: String, c: Bool }

type Box[t] = { item: t, tag: String }

fn punned(a: Int, b: String, c: Bool) : W = W { a, b, c }

fn main() : Unit / Stdout {
  let w1 = W { a: 1, b: "x", c: true }
  let w2 = W { c: true, a: 1, b: "x" }
  let w3 = W { 1, "x", true }
  let w4 = punned(1, "x", true)
  let w5 = W { ...w1, b: "y" }
  let bx = Box { tag: "n", item: 7 }
  Stdout.print("#{w1 == w2} #{w2 == w3} #{w3 == w4} #{w1 == w5}")
  Stdout.print("#{w5.b} #{bx.item} #{bx.tag}")
}
