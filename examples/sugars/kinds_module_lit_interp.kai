# A tagged literal passed straight into a call inside `#{...}`. The
# interp body is re-parsed out of its string span after kind resolution
# ran, so its habitant surfaces bare and must be re-qualified against
# the file's kinds — otherwise `minute` never unifies with the
# `Wall$minute` the annotation carries. `Measure` hides this: its
# qualified form IS the bare one.
kind Wall : Module over T with wt

wt minute

fn f(a: Int<minute>) : Int = __detach_unit(a)

unit m

fn g(d: Real<m>) : Real = __strip_unit(d)

pub fn main() : Unit / Console = {
  print("#{f(1<minute>)} #{g(5.0<m>)}")
  let bound = 30<minute>
  print("#{f(bound)}")
  # A nested span re-parses twice; the re-resolution runs over the
  # fully-lifted stream, so the inner literal qualifies too.
  print("outer #{"inner #{f(7<minute>)}"}")
}
