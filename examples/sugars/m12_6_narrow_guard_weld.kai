# A refinement narrowing and a user guard on the same arm: the guard
# order is refinement first, user predicate second, and `kai fmt`
# preserves both spellings instead of welding them into one `and`.

fn classify(x: Int, cap: Int) : String = match x {
  v : Int where >= 0 if v < cap -> "small"
  v : Int where >= 0 -> "big"
  _ -> "negative"
}

fn main() : Unit / Console {
  print(classify(3, 10))
  print(classify(50, 10))
  print(classify(-2, 10))
}
