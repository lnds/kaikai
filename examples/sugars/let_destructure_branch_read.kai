# A destructured `let` binder read on only one path of a short-circuit or
# branch is still released on the path that skips the read.

fn pair() : (String, String) = ("a", "b")

fn main() {
  let (s, t) = pair()
  let both = s == "a" and t == "b"
  let first = if t == "x" { s } else { "z" }
  assert both
  assert first == "z"
  print("let destructure branch read ok")
}
