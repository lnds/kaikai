# An interpolated string pattern matches the string the interpolation
# builds, never its source text.

const MAX : Int = 7

type Tagged = Tagged(Int, String)

fn lit(s: String) : Int = match s {
  "a#{1}" -> 1
  _ -> 0
}

fn by_const(s: String) : Int = match s {
  "id-#{MAX}" -> 1
  _ -> 0
}

fn by_param(s: String, n: Int) : Int = match s {
  "id-#{n}" -> 1
  "alt-#{n + 1}" -> 2
  _ -> 0
}

fn by_let(s: String) : Int = {
  let xs = [1, 2]
  match s {
    "xs=#{xs}" -> 1
    _ -> 0
  }
}

fn nested(o: Option[String], n: Int) : Int = match o {
  Some("in-#{n}") -> 1
  Some(_) -> 2
  None -> 0
}

fn guarded(s: String, n: Int) : Int = match s {
  "g#{n}" if n > 2 -> 1
  "g#{n}" -> 2
  _ -> 0
}

fn own_binder(p: Tagged) : Int = match p {
  Tagged(k, "v#{k}") -> k
  _ -> 0
}

fn clauses(s: String, n: Int) : Int {
  case "c#{n}", 1 -> 1
  case "c#{n}", _ -> 2
  case _, _ -> 0
}

fn main() : Unit / Stdout = {
  Stdout.print("lit: #{lit("a1")} #{lit("a\x23{1}")}")
  Stdout.print("const: #{by_const("id-7")} #{by_const("id-8")}")
  Stdout.print("param: #{by_param("id-3", 3)} #{by_param("alt-4", 3)} #{by_param("id-4", 3)}")
  Stdout.print("let: #{by_let("xs=[1, 2]")} #{by_let("xs=\x23{xs}")}")
  Stdout.print("nested: #{nested(Some("in-5"), 5)} #{nested(Some("in-6"), 5)} #{nested(None, 5)}")
  Stdout.print("guarded: #{guarded("g3", 3)} #{guarded("g1", 1)} #{guarded("g3", 1)}")
  Stdout.print("own: #{own_binder(Tagged(3, "v3"))} #{own_binder(Tagged(3, "v4"))}")
  Stdout.print("clauses: #{clauses("c1", 1)} #{clauses("c2", 2)} #{clauses("c2", 3)}")
}
