type R = { files: Option[[String]], res: Result[Int, String], inner: I }
type I = { tag: Option[Int] }

fn pick(r: Result[Int, String]) : Int = r |> unwrap_or(0)

fn main() : Unit / Stdout = {
  let rs = [
    R { files: Some(["a", "b"]), res: Ok(1), inner: I { tag: Some(7) } },
    R { files: None, res: Err("x"), inner: I { tag: None } }
  ]
  let flat = rs || (r => r.files ?? [])
  let mapped = rs | (r => r.res |> unwrap_or(5))
  let kept = rs |? (r => r.inner.tag |> is_some())
  let nested = rs | (r => r.inner.tag ?? 0)
  Stdout.print("#{length(flat)} #{mapped} #{length(kept)} #{nested} #{pick(Ok(3))}")
  rs |! (r => Stdout.print("#{r.files ?? [] |> length}"))
}
