# `[first, second..last]`: the step is `second - first`, its sign gives the
# direction, and the range stops at the last element that does not pass
# `last`.

fn noisy(tag: String, n: Int) : Int / Stdout = {
  Stdout.print(tag)
  n
}

fn main() : Unit / Stdout = {
  Stdout.print(show([2, 4..20]))
  Stdout.print(show([1, 3..10]))
  Stdout.print(show([10, 8..0]))
  Stdout.print(show([10, 7..0]))
  Stdout.print(show([-3, -1..5]))
  Stdout.print(show([1, 3..0]))
  Stdout.print(show([5, 3..9]))
  let a = 3
  let b = 7
  Stdout.print(show([a, b..20]))
  Stdout.print(show([a + 1, b + 1..20]))
  Stdout.print(show([noisy("first", 1), noisy("second", 4)..noisy("last", 12)]))
  Stdout.print(int_to_string([1, 3..99] |> sum()))
  Stdout.print(int_to_string([1, 3..99] |> length()))
  Stdout.print(int_to_string([a, a + 2..99] |> sum()))
  Stdout.print(int_to_string([10, 8..0] |> sum()))
  Stdout.print(int_to_string([10, 8..0] |> length()))
  Stdout.print(int_to_string([10, 8..0] | (x) => x * 2 |> sum()))
  Stdout.print(int_to_string(length([10, 8..0])))
  Stdout.print(int_to_string([10, 7..0] |> reduce(0, (acc, x) => acc * 10 + x)))
  Stdout.print(int_to_string([4, 3..1] | (x) => x + 1 |> product()))
  Stdout.print(int_to_string([1, 3..0] |> length()))
  let squares: Vec[Int] = [9, 6..0] | (x) => x * x
  Stdout.print(int_to_string(vec_length(squares)))
  Stdout.print(int_to_string(squares[0] + squares[1] + squares[3]))
}
