# Negative: a method call in a contract predicate is judged by the row of
# the function it resolves to; `loud` prints, so the predicate is rejected.

fn loud(n: Int) : Bool / Stdout = {
  println("checking")
  n > 0
}

fn make(n: Int) : Int
  requires n.loud()
= n

fn main() : Unit / Stdout = println("#{make(5)}")
