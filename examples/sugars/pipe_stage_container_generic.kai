# A lambda stage written for the whole container is checked against the
# element type, so the mismatch is reported where the body uses it.

fn total[a](xss: [[a]]) : Int = list.sum(xss | list.length)

fn main() : Int / Console = {
  let xss = [[1, 2], [3]]
  let n = xss | (b) => total(b)
  println(show(n))
  0
}
