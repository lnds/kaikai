# A stage that takes the whole container still gets the `|>` hint, and
# the reported parameter type is resolved (no `?t` leaks to the user).

fn total[a](xss: [[a]]) : Int = list.sum(xss | list.length)

fn main() : Int / Console = {
  let xss = [[1, 2], [3]]
  let n = xss | (b) => total(b)
  println(show(n))
  0
}
