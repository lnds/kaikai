# `||` and `|?` stages own their dots like `|` does.

fn main() : Unit / Stdout = {
  let pairs = [1, 2, 3] || [., . * 10]
  println("#{pairs}")
  let big = [1, 5, 9, 12] |? . > 3 and . % 3 == 0
  println("#{big}")
  let lens = ["kai", "rapa", "nui"] |? .length() > 3 | .length() * 2
  println("#{lens}")
}
