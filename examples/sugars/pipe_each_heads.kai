# `|!` dispatches on the head type to its owner's `each`: a lazy stream
# runs its stage, and so do a seq and a map; a filter feeds it.

import stream
import seq
import collections.map

fn never(x: Int) : Nothing = panic("unreachable #{x}")

fn main() : Unit / Stdout = {
  stream.from_list([1, 2, 3]) | (. * 10) |! println("stream #{.}")
  seq.range(1, 4, 1) |! println("seq #{.}")
  map.from([Pair { fst: 1, snd: "one" }, Pair { fst: 2, snd: "two" }]) |! println("map #{.fst}=#{.snd}")
  [1, 2, 3, 4, 5, 6] |? . % 2 == 0 |! println("even #{.}")
  let none: [Int] = []
  none |! never
  [7] |! (x) => println("lambda #{x}")
}
