type Box = { xs: List[Int], name: String }
type Tree = Leaf | Node(List[Tree])

#[derive(Eq, Show, BinSerialize)]
type Bag = { items: List[Int] }

fn total(xs: List[Int]) : Int = list.sum(xs)
fn grid(n: Int) : List[List[Int]] = [[n], [n, n]]
fn flat(g: [List[Int]]) : [Int] = match g {
  []           -> []
  [h, ...rest] -> h ++ flat(rest)
}
fn size(t: Tree) : Int = match t {
  Leaf     -> 1
  Node(ts) -> 1 + list.sum(map(ts, size))
}

fn main() : Unit / Stdout {
  let b = Box { xs: [1, 2, 3], name: "b" }
  let xs : [Int] = b.xs
  let ys : List[Int] = xs
  Stdout.print("#{total(xs)} #{total(b.xs)} #{total(ys)} #{show(flat(grid(2)))} #{size(Node([Leaf, Node([Leaf])]))}")
  let bag = Bag { items: [1, 2] }
  Stdout.print("#{show(bag)} #{bag == Bag { items: [1, 2] }} #{array_length(to_bytes(bag)) > 0}")
}
