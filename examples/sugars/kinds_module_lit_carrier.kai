# A dimensioned numeric literal in an argument slot coins to the
# carrier the parameter declares. `10.50<USD>` synthesises `Real<USD>`
# bottom-up; the declared `Money[Decimal]<USD>` (a transparent alias for
# `Decimal<USD>`) is what pins the carrier, so the argument path must
# consult it the way the annotated-`let` and record-field paths do.
import money
import decimal as dec

fn amount_of(m: Money[Decimal]<USD>) : Decimal = money.amount(m)

pub fn main() : Unit / Console = {
  print(dec.to_string(amount_of(10.50<USD>)))
  let bound : Money[Decimal]<USD> = 3.25<USD>
  print(dec.to_string(amount_of(bound)))
}
