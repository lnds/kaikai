# After an `if` with no `else`, a next line opening with `(`, `{` or
# `-` is a new statement; an `else` on the next line still attaches.

fn show_pair(p: (Int, Int)) : Unit / Stdout = println("pair #{p.fst + p.snd}")
fn show_int(n: Int) : Unit / Stdout = println("int #{n}")

fn pick(c: Bool) : Int = {
  if c { 1 }
  else { 2 }
}

fn main() : Unit / Stdout = {
  let on = true
  if on { println("paren") }
  (1, 2) |> show_pair()
  if on { println("brace") }
  { println("block") }
  if on { println("minus") }
  -1 |> show_int()
  if on { println("nested") }

  [5] |> each((x) => println("#{x}"))
  println("#{pick(true)} #{pick(false)}")
}
