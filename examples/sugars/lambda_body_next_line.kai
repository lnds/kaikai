fn apply(f: (Int) -> Int, x: Int) : Int = f(x)

fn thunk(f: () -> Int) : Int = f()

fn two(f: (Int, Int) -> Int) : Int = f(3, 4)

fn main() : Unit / Console {
  let a = x =>
    x + 1
  let b = (x) =>
    x + 2
  let c = (x: Int) =>
    x + 3
  let d = () =>
    40
  let e = (x: Int, y: Int) =>
    x * y
  let f = (x) =>
    {
      let y = x + 1
      y * 2
    }
  println(show(a(1)))
  println(show(b(1)))
  println(show(c(1)))
  println(show(d()))
  println(show(e(3, 4)))
  println(show(f(1)))
  println(show(apply(x =>
    x + 10, 1)))
  println(show(apply((x) =>
    x + 20, 1)))
  println(show(thunk(() =>
    7)))
  println(show(two((x, y) =>
    x - y)))
  println(show([1, 2, 3] | (x) =>
    x * 2))
  println(show([1, 2, 3] | x =>
    x * 3))
}
