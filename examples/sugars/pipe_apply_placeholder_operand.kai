# A `|>` with a `_` placeholder binds looser than the operator around it,
# so a formatter must keep the parentheses that make it an operand.

fn sub(a: Int, b: Int) : Int = a - b

fn main() : Unit / Stdout {
  let x = (3 |> sub(10, _)) + 1
  let ys = [1, 2] | (. |> sub(100, _))
  println("#{x} #{ys}")
}
