# Tuple sugar in every position the grammar accepts it: expression
# literals, type annotations (param / return / let / alias / nested
# type argument), and patterns (match arm, let destructure, nested,
# block-lambda head). The writer must reproduce each spelling; the
# pipeline must lower each to its Pair/Triple/Quad form.

type Point = (Int, Int)

fn swap(p: (Int, Int)) : (Int, Int) = (p.snd, p.fst)

fn dist2(p: Point) : Int = (p.fst * p.fst) + (p.snd * p.snd)

fn pick(p: (Int, Int)) : Int = match p {
  (a, b) -> a + b
}

fn tag(t: (Int, String, Bool)) : String = match t {
  (n, s, true) -> "#{s}:#{n}"
  (_, s, false) -> s
}

fn spread(q: (Int, Int, Int, Int)) : Int = match q {
  (a, b, c, d) -> ((a + b) + c) + d
}

fn nested(np: ((Int, Int), Int)) : Int = match np {
  ((a, b), c) -> (a + b) + c
}

fn main() {
  let p = (3, 4)
  assert dist2(p) == 25
  let s = swap(p)
  assert (s.fst == 4) and (s.snd == 3)
  assert pick((1, 2)) == 3
  assert tag((7, "x", true)) == "x:7"
  assert tag((7, "y", false)) == "y"
  assert spread((1, 2, 3, 4)) == 10
  assert nested(((1, 2), 3)) == 6
  let (a, b) = swap((10, 20))
  assert (a == 20) and (b == 10)
  let pairs: [(Int, Int)] = [(1, 2), (3, 4)]
  let sums = pairs | { (x, y) -> x + y }
  assert sums == [3, 7]
  let t = (1, 2, 3)
  assert t.trd == 3
  print("tuple surface ok")
}
