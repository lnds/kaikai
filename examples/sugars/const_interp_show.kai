# An interpolated `const` is lifted like any other string: its bodies
# read other consts by identity and print through `Show`.

type Tag = { name: String, n: Int }

impl Show for Tag {
  fn show(t: Tag) : String = "<" ++ t.name ++ ":" ++ int_to_string(t.n) ++ ">"
}

const WHO : Tag = Tag { name: "ann", n: 4 }
const BASE : Int = 40
const GREETING : String = "hi #{WHO}, #{BASE + 2} and #{"nested #{WHO.n}"}"

fn main() : Unit / Stdout {
  Stdout.print(GREETING)
  Stdout.print("#{GREETING}!")
}
