# A scalar-typed field read passed to a boxed borrowed parameter is an owned
# reference the caller releases after the call.

type Hdr = { magic: U32 }

fn first(a: U32, b: U32) : U32 = a

fn main() {
  let x = Hdr { magic: 1 }
  let y = Hdr { magic: 2 }
  let _ = first(x.magic, y.magic)
  print("borrowed slot scalar field arg ok")
}
