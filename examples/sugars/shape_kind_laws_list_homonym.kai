# A user type named `List` is not the core list: its `[a]` payload is a
# field of another type, not the recursive slot, so the law-check
# witnesses are built from its own constructors only.

protocol Sequence[s: Shape] : Functorial {
  map(xs: s[Int], f: (Int) -> Int) : s[Int]
  foldl(xs: s[Int], init: Int, f: (Int, Int) -> Int) : Int
}

type List[a] = Empty | More(a, [a])

fn bump(xs: [Int], f: (Int) -> Int) : [Int] = match xs {
  []           -> []
  [h, ...rest] -> [f(h), ...bump(rest, f)]
}

fn total(xs: [Int], init: Int, f: (Int, Int) -> Int) : Int = match xs {
  []           -> init
  [h, ...rest] -> total(rest, f(init, h), f)
}

impl Sequence for List {
  fn map(xs: List[Int], f: (Int) -> Int) : List[Int] = match xs {
    Empty      -> Empty
    More(h, t) -> More(f(h), bump(t, f))
  }
  fn foldl(xs: List[Int], init: Int, f: (Int, Int) -> Int) : Int = match xs {
    Empty      -> init
    More(h, t) -> total(t, f(init, h), f)
  }
}

pub fn main() : Unit / Console = print("ok")
