# A `var` captured by a non-loop closure lowers to a `Ref` cell, not a slot or
# a `State` handler; the harness greps the emitted C for it.
fn each_sum(n: Int) : Int {
  var c := 0
  [1..n]
    |> each(x => {
      c := c + x
    })
  c
}

fn main() : Unit / Io {
  println(int_to_string(each_sum(4)))
}
