# A var read only through an interpolation is still a plain read: it
# lowers to a stack slot, so the loop that mutates it runs without a
# State handler.
import loop

fn interp_sum(n: Int) : String = {
  var total := 0
  var i := 1
  while { i <= n } {
    total := total + i
    i := i + 1
  }
  "#{total}"
}

fn interp_twice(n: Int) : String = {
  var acc := n
  let before = "before=#{acc}"
  acc := acc * 2
  "#{before} after=#{acc} sum=#{acc + n}"
}

fn interp_shadow(n: Int) : String = {
  var count := n
  count := count + 1
  let label = { let count = "inner"; "#{count}" }
  "#{label} #{count}"
}

fn main() : Unit / Stdout = {
  Stdout.print(interp_sum(1000))
  Stdout.print(interp_twice(21))
  Stdout.print(interp_shadow(41))
}
