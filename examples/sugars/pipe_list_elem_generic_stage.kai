# `|` must unify the stage parameter with the element type, not compare
# shapes: a `[?t]` param over `[[Int]]` unifies with both the element and
# the container, and element-wise wins.

fn my_len[a](xs: [a]) : Int = list.length(xs)

fn main() : Int / Console = {
  let xss = [[1, 2], [3]]
  println(show(xss | (b) => list.length(b)))
  println(show(xss | list.length))
  println(show(xss | (b) => my_len(b)))
  println(show(xss || (b) => list.reverse(b)))
  println(show(xss |? (b) => list.length(b) > 1))
  let os = [Some(1), None, Some(3)]
  println(show(os | (o) => option.unwrap_or(o, 0)))
  0
}
