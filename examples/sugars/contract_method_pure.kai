# A contract predicate may call a method, judged by the row of the
# function the call resolves to: these are all effect-pure.

type Cuenta = { saldo: Int }

fn positivo(n: Int) : Bool = n > 0

fn retirar(c: Cuenta, monto: Int, xs: [Int], nombre: String) : Int
  requires xs.length() > 0
  requires nombre.length() > 0 and monto.positivo()
  requires c.saldo >= monto
= c.saldo - monto

fn main() : Unit / Stdout {
  println("#{retirar(Cuenta { saldo: 100 }, 9, [1], "ana")}")
}
