# A `!` inside an interpolation leaves early without disturbing the
# other parts of the string.

fn half(n: Int) : Option[Int] = if n % 2 == 0 { Some(n / 2) } else { None }

fn say(n: Int) : Option[String] = Some("half of #{n} is #{half(n)!}, twice #{half(n)! * 2}.")

fn main() : Unit / Stdout = {
  Stdout.print("#{say(4)} #{say(3)}")
}
