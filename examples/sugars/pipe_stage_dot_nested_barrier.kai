# The closest stage owns a `.`. An explicit lambda is a barrier: the
# stage inside it owns its own dots. A `|>` inside a stage is not a
# stage, and the left side it applies to is the outer element.

fn add(a: Int, b: Int) : Int = a + b
fn total(xs: [Int]) : Int = match xs {
  []           -> 0
  [h, ...rest] -> h + total(rest)
}

fn main() : Unit / Stdout = {
  let grid = [[1, 2], [3, 4]] | (row: [Int]) => (row | . * 10)
  println("#{grid}")
  let sums = [[1, 2], [3, 4]] | (r: [Int]) => total(r | . + 1)
  println("#{sums}")
  let shifted = [1, 2] | (. |> add(100, _))
  println("#{shifted}")
}
