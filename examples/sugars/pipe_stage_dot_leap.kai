# A `|` stage owns every `.` on its right side, those inside `#{...}`
# included: each year prints with its verdict.

fn is_leap(y: Int) : Bool = y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)

fn main() : Unit / Stdout = {
  let _ = [1900, 1994, 1996, 2000, 2024, 2026] | println("#{.}: #{is_leap(.)}")
}
