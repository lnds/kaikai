# `#{.field}` and `#{.fun(v)}` in a stage read the stage's element, and
# a `.` in a call argument inside the stage is the element too.

type Person = { name: String, age: Int }

fn older(p: Person, by: Int) : Int = p.age + by
fn add(a: Int, b: Int) : Int = a + b

fn main() : Unit / Stdout = {
  let people = [Person { name: "ana", age: 30 }, Person { name: "bo", age: 41 }]
  let _ = people | println("#{.name} is #{.age}, in 5 years #{older(., 5)}")
  let _ = people | println("""#{.name}
  next year #{add(.age, 1)}""")
  println("#{[1, 2, 3] | add(., 10)}")
  println("#{[1, 2] | "<#{"[#{.}]"}>"}")
  println("#{[[1], [2, 3]] | (r: [Int]) => "#{r | "<#{.}>"}"}")
}
