# `|!` runs its stage for its effect on every element and returns `Unit`,
# so it closes the body of a `Unit` function.

fn is_leap(y: Int) : Bool = y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)

fn main() : Unit / Stdout = {
  [1900, 1994, 1996, 2000, 2024, 2026] |! println("#{.}: #{is_leap(.)}")
}
