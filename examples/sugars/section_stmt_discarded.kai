# A postfix `.f()` never continues from the next line: on its own line
# it is a point-free section, and one whose value is dropped is
# rejected instead of silently not calling `f`.

fn after(u: Unit) : Unit / Stdout = println("after")

fn main() : Unit / Stdout = {
  if true { println("a") }
  .after()
  println("end")
}
