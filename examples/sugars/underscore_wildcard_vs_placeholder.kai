# The two legitimate `_` positions, which rejecting `_` as an
# expression must leave untouched: the pattern wildcard (match arms,
# constructor sub-patterns, list spread) and the `|>` argument
# placeholder, which the pipe rewrite substitutes while parsing.
# `_name` is a separate form — an ordinary binder marked unused.

type Shape = Circle(Int) | Square(Int) | Tri(Int, Int)

fn sub(a: Int, b: Int) : Int = a - b

fn kind(s: Shape) : String = match s {
  Circle(_) -> "circle"
  Tri(_, _) -> "tri"
  _ -> "other"
}

fn head_or(xs: [Int], d: Int) : Int = match xs {
  [h, ..._] -> h
  _ -> d
}

fn main() : Unit / Stdout {
  let _unused = 99
  let piped = 5 |> sub(7, _)
  Stdout.print(kind(Circle(1)))
  Stdout.print(kind(Square(2)))
  Stdout.print("#{head_or([4, 5], 0)} #{head_or([], 7)} #{piped}")
}
