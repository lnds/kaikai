# A habitant qualified by the kind's introducer word (`cur.USD`) and by
# the kind name (`Currency.USD`): both resolve to the same habitant and
# `kai fmt` keeps each spelling as written.

kind Currency : AbelianGroup with cur

unit USD
cur USD

fn hold(x: Real<cur.USD>) : Real<Currency.USD> = x

pub fn main() : Unit / Console = {
  let a = hold(10.0<Currency.USD>)
  print("introducer ok")
}
