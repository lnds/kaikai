# An aliased import inside a non-root module: the `#{...}` body must
# resolve `a` through this file's segment scope, and key `a.MAX` to
# alpha, not to this module's own MAX.
import alpha as a

pub const MAX : Int = 300

pub fn gamma_alias_max() : String = "#{a.MAX}"
pub fn gamma_alias_max_direct() : Int = a.MAX
pub fn gamma_own_max() : String = "#{MAX}"
