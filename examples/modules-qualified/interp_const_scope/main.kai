# A const read inside `#{...}` resolves exactly like the same read
# outside it. The interp lift re-parses each span long after the
# scoping passes ran, so the re-parsed sub-tree must inherit its
# surroundings: the const collision table, the reading decl's home,
# and the file's segment module table (import aliases included).

import alpha
import beta
import gamma as g

const rate : Int = 99

fn main() : Unit / Stdout = {
  Stdout.print("#{alpha.MAX}")
  Stdout.print("#{beta.MAX}")
  Stdout.print("#{alpha.rate}")
  Stdout.print("#{beta.rate}")
  Stdout.print("#{g.MAX}")
  Stdout.print(beta.beta_bare_max())
  Stdout.print(beta.beta_bare_rate())
  Stdout.print(g.gamma_alias_max())
  Stdout.print("#{g.gamma_alias_max_direct()}")
  Stdout.print(g.gamma_own_max())
  Stdout.print("#{rate}")
  let rate = 5
  Stdout.print("#{rate}")
}
