# A pub homonym of `palette.Shade` with an incompatible signature.
# Its own impl resolves here; `screen`'s impl must not.
pub protocol Shade {
  shade(x: Self) : Int
}

pub type Icon = { k: Int }

impl Shade for Icon {
  fn shade(x: Icon) : Int = x.k + 10
}

pub fn icon_shade() : Int = shade(Icon { k: 5 })
