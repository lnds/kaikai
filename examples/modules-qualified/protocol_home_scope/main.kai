# A protocol name belongs to the module that declares it. Three
# modules and the root each declare a same-named protocol with
# DIFFERENT signatures; every impl below validates against its own
# module's declaration, and each call dispatches to its own impl.
import canvas
import gauge
import palette
import screen
import hud

# The root's own homonym — a third `Draw` signature. Root
# declarations resolve first for root impls.
protocol Draw {
  draw(x: Self) : Bool
}

type Dot = { z: Int }

impl Draw for Dot {
  fn draw(x: Dot) : Bool = x.z > 0
}

fn main() : Unit / Stdout = {
  Stdout.print(canvas.render())
  Stdout.print("#{gauge.size()}")
  Stdout.print(screen.paint())
  Stdout.print("#{hud.icon_shade()}")
  Stdout.print("#{draw(Dot { z: 3 })}")
}
