# The same protocol name as `canvas`'s, never importing it, with an
# incompatible signature. Declared later in the stream: under
# name-only keying this impl was validated against `canvas.Draw` and
# rejected with a type from a module this file never mentions.
protocol Draw {
  draw(x: Self) : Int
}

pub type Box = { w: Int }

impl Draw for Box {
  fn draw(x: Box) : Int = x.w
}

pub fn size() : Int = draw(Box { w: 7 })
