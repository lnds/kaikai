# A private protocol whose name `gauge` also declares — with a
# DIFFERENT signature (String vs Int return). Each impl below must
# validate against its own module's declaration; with identical
# signatures the collision would be invisible.
protocol Draw {
  draw(x: Self) : String
}

pub type Circle = { r: Int }

impl Draw for Circle {
  fn draw(x: Circle) : String = "circle"
}

pub fn render() : String = draw(Circle { r: 1 })
