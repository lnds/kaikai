# Same names as alpha, declared later in the stream — and `tag` with
# a different type, so a cross-module capture fails to type-check,
# not just to run.
const limit : Int = 20
const tag : Int = 7

pub const width : Int = 4
pub const MAX : Int = 200

pub fn beta_limit() : Int = limit
pub fn beta_tag() : Int = tag
