# A const name belongs to the module that declares it. Three modules
# and the root declare overlapping const names — private and pub, in
# both declaration orders, read bare and qualified. Each read resolves
# against its own module's declaration; a local binder still shadows.

import alpha
import beta
import gamma

const limit : Int = 99

fn main() : Unit / Stdout = {
  Stdout.print("#{limit}")
  Stdout.print("#{alpha.alpha_limit()}")
  Stdout.print("#{beta.beta_limit()}")
  Stdout.print("#{alpha.width}")
  Stdout.print("#{beta.width}")
  let amax = alpha.MAX
  let bmax = beta.MAX
  Stdout.print("#{amax}")
  Stdout.print("#{bmax}")
  Stdout.print("#{MAX}")
  Stdout.print(alpha.alpha_tag())
  Stdout.print("#{beta.beta_tag()}")
  Stdout.print("#{gamma.gamma_width()}")
  let limit = 55
  Stdout.print("#{limit}")
}
