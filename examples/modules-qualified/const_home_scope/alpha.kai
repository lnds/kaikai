# Every const name here is also declared by a sibling module (and
# `limit` by the root too). Each read below must resolve to THIS
# module's declaration regardless of declaration order.
const limit : Int = 10
const tag : String = "a"

pub const width : Int = 3
pub const MAX : Int = 100

pub fn alpha_limit() : Int = limit
pub fn alpha_tag() : String = tag
