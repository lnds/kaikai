# A `const` initialiser's `#{...}` bodies are resolved like any other
# expression: a bare const is the reading module's, a qualified one its
# home's, whatever else is spelled the same.

import alpha
import beta

const MAX : Int = 1
const LABEL : String = "root max #{MAX}, alpha's #{alpha.MAX}, beta's #{beta.MAX}"

fn main() : Unit / Stdout = {
  Stdout.print(alpha.LABEL)
  Stdout.print(beta.LABEL)
  Stdout.print(LABEL)
  Stdout.print("#{alpha.LABEL} / #{beta.LABEL}")
}
