# A type name belongs to the module that declares it. Three modules
# each declare `Step` — two privately, one exported — and every use
# below resolves against its own module's declaration.

import parser
import machine
import shared

fn main() : Unit / Stdout = {
  # `machine.Step` reached unqualified: the private `Step` of `parser`
  # (earlier in the import graph) must not capture the name.
  Stdout.print("#{machine.label(machine.resume_with(1))}")

  # The same type written as a qualified path.
  let quit : machine.Step[Int] = Quit
  Stdout.print("#{machine.label(quit)}")

  # Each private alias still resolves inside its own module.
  Stdout.print("#{parser.depth()}")
  Stdout.print("#{shared.width()}")
}
