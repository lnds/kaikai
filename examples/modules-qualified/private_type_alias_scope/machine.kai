# The same name as `parser`'s private alias, exported as a sum. A use
# site here must resolve to this declaration, not the imported one.
pub type Step[m] = Continue(m) | Quit

pub fn resume_with[m](x: m) : Step[m] = Continue(x)

pub fn label(s: Step[Int]) : Int = match s {
  Continue(n) -> n
  Quit        -> 0
}
