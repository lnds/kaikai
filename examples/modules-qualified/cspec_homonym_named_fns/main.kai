# Two modules export a `step`; one higher-order fn is specialised on each.
# The two specs must stay distinct.

import inc_a
import inc_b

fn twice(f: (Int) -> Int, n: Int) : Int = f(n) + f(n + 1)

fn main() : Unit / Stdout {
  let a = twice(inc_a.step, 5)
  let b = twice(inc_b.step, 5)
  Stdout.print("#{a} #{b}")
}
