# A refinement predicate resolves a module-qualified name wherever its
# type is written: an alias, a record field, a parameter, a result, a
# const's annotation, an effect operation, a `let` and a lambda
# parameter, under the module's own name and under an alias.

import lib
import kit as kt
import user

type Small = Int where self < lib.MAX
type Box = { n: Int where self < lib.double(50) }

effect Gauge {
  set(n: Int where self < lib.MAX) : Int
}

const CAP : Int where self < lib.MAX = 7

fn clamp(n: Int where n < kt.EDGE) : Int = n
fn made() : Int where self < lib.MAX = 5
fn small(n: Small) : Int = n

fn gauged() : Int = handle { Gauge.set(3) } with Gauge {
  set(n, resume) -> resume(n + 1)
}

fn nine() : Int = 9

fn main() : Unit / Stdout = {
  let n : Int where self < lib.MAX = 6
  let bump = (x: Int where self < kt.EDGE) => x + 1
  let b = Box { n: 8 }
  Stdout.print("#{small(1)} #{b.n} #{clamp(2)} #{made()} #{CAP}")
  Stdout.print("#{gauged()} #{n} #{bump(7)} #{user.tiny(4)}")
  # A value the predicate rejects is still refused: 9 is not under 5.
  match ensure(nine()) where < lib.LOWER_LIMIT {
    Some(v) -> Stdout.print("kept #{v}")
    None    -> Stdout.print("refused")
  }
}
