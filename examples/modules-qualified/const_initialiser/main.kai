# A const initialiser resolves a module-qualified name the way a
# function body does: functions, constants, constructors, types,
# patterns and effects, under the module's own name and under an alias.
# So does the default of a record field.

import core.string
import encoding.json.{json_decode}
import encoding.json_bind
import core.list as ls
import seq
import lib
import kit as kt
import sel.{pick}
import geo.shapes
import user

const greeting : String = string.join(["hello", "world"], " ")
const backwards : [Int] = ls.reverse([1, 2, 3])

const doubled : Int = lib.double(21)
const limit : Int = lib.lower_limit + lib.MAX
const circle : lib.Shape = lib.Circle(2)
const dot : lib.Shape = lib.Dot
const both : [lib.Shape] = [lib.Circle(1), lib.Dot]
const radius : Int = match lib.mk() {
  lib.Circle(r) -> r
  lib.Dot       -> 0
}
const handled : Int = handle { lib.Emit.put(1); 3 } with lib.Emit {
  put(n, resume) -> resume(())
}

const sharp : Int = kt.sharpen(1)
const sized : Int = kt.kit_size + kt.EDGE
const hammer : kt.Tool = kt.Hammer(3)
const noted : Int = handle { kt.Note.jot(1); 6 } with kt.Note {
  jot(n, resume) -> resume(())
}

const picked : Int = pick(1) + sel.other(2)
const squared : Int = shapes.area(3)

const mapped : [Int] = ls.map([1, 2, 3], (x) => lib.double(x))
const summed : Int = {
  let a = lib.double(2)
  a + lib.lower_limit
}
const piped : Int = 4 |> lib.double

# The const names itself through a qualified call.
const nat : Seq[Int] = lazy [0, ...seq.map(nat, (x) => x + 1)]

pub const exported : Int = lib.triple(5)

#[derive(Json)]
type Job = {
  name: String,
  #[json(default = lib.double(4))] retries: Int,
}

fn read_job(src: String) : String = match json_decode(src) {
  None    -> "bad json"
  Some(v) -> match job_of_json(v, "") {
    Ok(j)  -> "#{j.name} #{j.retries}"
    Err(_) -> "bad job"
  }
}

fn show_shape(s: lib.Shape) : String = match s {
  lib.Circle(r) -> "circle #{r}"
  lib.Dot       -> "dot"
}

fn show_tool(t: kt.Tool) : String = match t {
  kt.Hammer(n) -> "hammer #{n}"
  kt.Saw       -> "saw"
}

fn main() : Unit / Stdout = {
  Stdout.print(greeting)
  Stdout.print("#{backwards}")
  Stdout.print("#{doubled} #{limit}")
  Stdout.print("#{show_shape(circle)} #{show_shape(dot)} #{list_length(both)} #{radius} #{handled}")
  Stdout.print("#{sharp} #{sized} #{show_tool(hammer)} #{noted}")
  Stdout.print("#{picked} #{squared}")
  Stdout.print("#{mapped} #{summed} #{piped}")
  Stdout.print("#{seq.to_list(seq.take(nat, 4))}")
  Stdout.print("#{exported}")
  Stdout.print("#{user.twice} #{twice} #{user.hidden_plus(1)}")
  Stdout.print(read_job("{\"name\":\"nightly\"}"))
}
