# An import alias is scoped to the file that writes it: `helper`
# resolves `c.Val` through its own `import core as c` no matter what
# name the consumer binds `core` to. The load order also matters —
# `core` is already resolved by the time `helper` is loaded, so the
# module table must still gain `helper`'s own binding.

import core
import helper

fn main() {
  print(int_to_string(core.get(helper.bump(core.make(41)))))
  print(int_to_string(core.get(helper.bump(core.make(7)))))
}
