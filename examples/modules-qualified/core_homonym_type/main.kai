import shapes as sh

fn core_or(o: Option[Int], d: Int) : Int = match o {
  Some(n) -> n
  None    -> d
}

fn user_or(o: sh.Option, d: Int) : Int = sh.unwrap_or(o, d)

fn main() {
  println(int_to_string(core_or(Some(3), 0)))
  println(int_to_string(core_or(None, 9)))
  println(int_to_string(user_or(sh.Got(5), 0)))
  println(int_to_string(user_or(sh.Nope, 7)))
  println(int_to_string(sh.count_down(sh.Got(4), 3)))
}
