# A constant's block initialiser is evaluated at each read, wherever the
# read is: a homonym in another module is another constant.

import alpha
import beta

const PAIR : [Int] = {
  let a = alpha.PAIR
  list_append(a, beta.PAIR)
}

fn main() : Unit / Stdout {
  Stdout.print("#{alpha.PAIR}")
  Stdout.print("#{beta.PAIR}")
  Stdout.print("#{PAIR}")
  Stdout.print("#{PAIR} #{alpha.PAIR}")
}
