# A unit-annotated alias body names its types in the alias's module: `Id`
# is `Int` there, whatever `Id` means in the file using the alias.

import shape

unit m

type Id = String

fn tagged(t: Tag<m>) : Tag<m> = t

fn main() : Unit / Stdout {
  let a: Tag<m> = 3<m>
  let name: Id = "x"
  println("#{tagged(a)} #{name}")
}
