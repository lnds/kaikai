# Same clash as alias_consumer_clash, with the consumer binding a
# third name. `k`, `c` and `core` all denote the same file and each
# resolves only in the file that wrote it.

import core as k
import helper

fn main() {
  print(int_to_string(k.get(helper.bump(k.make(41)))))
  print(int_to_string(k.get(helper.bump(k.make(7)))))
}
