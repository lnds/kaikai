# Issue #1879: a record-shaped ctor pattern carries a home slot, so
# `mod.Ctor { f: p }` keeps its qualifier through lowering and is
# validated against the module table like `mod.Ctor(p)` already was.

import geo
import grid

fn describe_geo(p: geo.Point) : String {
  match p {
    geo.Point { x: a, y: b } -> "geo #{int_to_string(a)},#{int_to_string(b)}"
  }
}

fn describe_grid(p: grid.Point) : String {
  match p {
    grid.Point { row: r, col: c } -> "grid #{int_to_string(r)},#{int_to_string(c)}"
  }
}

fn main() {
  print(describe_geo(geo.Point { x: 3, y: 4 }))
  print(describe_grid(grid.Point { row: 7, col: 9 }))
}
