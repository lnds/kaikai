# Issue #1879: the qualifier of a record-shaped ctor pattern is
# validated against the module table, so a module that was never
# imported is a diagnostic instead of a silently dissolved spelling.

import geo

fn main() {
  let p = geo.Point { x: 3, y: 4 }
  match p {
    nosuch.Point { x: a, y: b } -> print("#{int_to_string(a)},#{int_to_string(b)}")
  }
}
