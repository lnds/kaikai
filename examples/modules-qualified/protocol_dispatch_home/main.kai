# A protocol's dispatch identity belongs to the module that declares
# it. Three contested pairs: identical shapes over the same type-head
# name (alpha/beta), the same op name at different arity and return
# type (gamma/delta), and identical shapes over distinct type heads
# called from the root (epsilon/zeta — receiver-type disambiguation
# across homonymous protocols).
import alpha
import beta
import gamma
import delta
import epsilon
import zeta

fn main() : Unit / Stdout = {
  Stdout.print("#{alpha.go()}")
  Stdout.print("#{beta.go()}")
  Stdout.print("#{gamma.use_it()}")
  Stdout.print(delta.use_it())
  Stdout.print("#{size(epsilon.mk(4))}")
  Stdout.print("#{size(zeta.mk(5))}")
}
