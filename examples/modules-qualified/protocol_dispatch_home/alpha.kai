# One half of the issue's exact repro: same protocol shape, same
# local type name as `beta`. The mangled impl symbol and the impl
# table key must not collide with beta's.
pub protocol P {
  op(x: Self) : Int
}

pub type Vec = { a: Int }

impl P for Vec {
  fn op(x: Vec) : Int = x.a + 100
}

pub fn go() : Int = op(Vec { a: 1 })
