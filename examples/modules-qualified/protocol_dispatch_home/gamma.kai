# Homonymous protocols whose shared op name differs in arity AND
# return type. With a name-keyed impl table this shape corrupted the
# rewrite (a 2-arg call could land on the 1-arg impl entry).
pub protocol Q {
  quack(x: Self) : Int
}

pub type Duck = { n: Int }

impl Q for Duck {
  fn quack(x: Duck) : Int = x.n + 1
}

pub fn use_it() : Int = quack(Duck { n: 10 })
