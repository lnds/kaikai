# Contested protocol name whose impls target DISTINCT type heads —
# the receiver-type disambiguation boundary: a foreign caller's bare
# call still lands on the right impl because the heads differ.
pub protocol R {
  size(x: Self) : Int
}

pub type Disk = { gb: Int }

impl R for Disk {
  fn size(x: Disk) : Int = x.gb * 2
}

pub fn mk(n: Int) : Disk = Disk { gb: n }
