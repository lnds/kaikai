# `Q.quack` here takes two arguments and returns String — the
# same op name as gamma's at a different shape.
pub protocol Q {
  quack(x: Self, y: Int) : String
}

pub type Duck = { s: String }

impl Q for Duck {
  fn quack(x: Duck, y: Int) : String = "#{x.s}-#{y}"
}

pub fn use_it() : String = quack(Duck { s: "d" }, 7)
