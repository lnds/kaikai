# A unit name belongs to the module that declares it. Two modules
# export `tick`, two export the alias `span` with different bodies,
# two declare the habitant `hab` under different kinds, and the root
# shadows an exported `tock` with its own private one.

import metric
import imperial
import local
import span_m
import span_ft
import kmetric
import kimperial

unit tock

fn tock_ratio() : Real = 2.5<tock> / 0.5<tock>

fn main() : Unit / Stdout = {
  Stdout.print("#{metric.metric_ratio(metric.metric_scale(metric.metric_mk()))}")
  Stdout.print("#{imperial.imperial_ratio(imperial.imperial_mk())}")
  Stdout.print("#{local.local_ratio()}")
  Stdout.print("#{span_m.span_m_ratio(span_m.span_m_mk())}")
  Stdout.print("#{span_ft.span_ft_ratio(span_ft.span_ft_mk())}")
  Stdout.print("#{kmetric.km_ratio(kmetric.km_mk())}")
  Stdout.print("#{kimperial.ki_ratio(kimperial.ki_mk())}")
  Stdout.print("#{tock_ratio()}")
}
