# Exports units whose names sibling modules also declare. Every use
# of `tick` here must stay this module's atom.
pub unit tick
pub unit tock

pub fn metric_mk() : Real<tick> = 3.0<tick>
pub fn metric_scale(x: Real<tick>) : Real<tick> = x * 2.0
pub fn metric_ratio(x: Real<tick>) : Real = x / 1.0<tick>
