# A habitant name declared by two modules under different user kinds.
# Inside the declaring module the bare name must resolve to its own
# habitant without an ambiguity report; the explicit kind qualifier
# names the same atom.
pub kind Metric : AbelianGroup with metric
pub metric hab

pub fn km_mk() : Real<hab> = 8.0<Metric.hab>

pub fn km_ratio(x: Real<hab>) : Real = x / 1.0<hab>
