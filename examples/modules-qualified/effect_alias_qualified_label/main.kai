# An effect alias names a label through its module, at the head of the
# alias and after a `+`.

import chan

type Lead = chan.Emit + Stdout
type Trail = Stdout + chan.Emit

fn go() : Unit / Lead = {
  chan.Emit.emit("a")
  Stdout.print("b")
}

fn run() : Unit / Trail = go()

fn main() : Unit / Stdout = {
  handle {
    run()
  } with chan.Emit {
    emit(s, resume) -> {
      Stdout.print("emit #{s}")
      resume(())
    }
  }
}
