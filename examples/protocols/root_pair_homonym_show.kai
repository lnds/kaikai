# A root `Pair` next to `core.tuple.Pair`: deriving on the root type is
# not a duplicate of the core impl, and each value dispatches to the
# impl of its own type, including through a core generic impl.
#[derive(Show, Eq)]
type Pair = P(Int, Int)

fn main() : Unit / Stdout = {
  Stdout.print(show(P(1, 2)))
  Stdout.print(show((3, 4)))
  Stdout.print(show([P(5, 6)]))
  Stdout.print(show([(7, 8)]))
  Stdout.print(show(P(1, 2) == P(1, 2)))
  Stdout.print(show(P(1, 2) == P(2, 1)))
}
