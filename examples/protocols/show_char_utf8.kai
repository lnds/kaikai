# Show for Char emits the full UTF-8 encoding of the codepoint, one
# case per encoded width: ASCII (1), Latin-1 (2), BMP (3),
# supplementary (4) — bare and inside a list.
fn main() : Unit / Stdout = {
  Stdout.print("#{'A'}")
  Stdout.print("#{'é'}")
  Stdout.print("#{'—'}")
  Stdout.print("#{'🎉'}")
  Stdout.print("#{['A', 'é', '—', '🎉']}")
}
