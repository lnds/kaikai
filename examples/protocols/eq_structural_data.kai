type Color = Red | Green
type P = { x: Int, c: Color }
type Shape = Circle(Int) | Rect(Int, Int)
type Wrap = { p: P, s: Shape, xs: [P] }
type Box[t] = { v: t }
type Named = { name: String, run: (Int) -> Int }

impl Eq for Named {
  fn eq(a: Named, b: Named) : Bool = a.name == b.name
}

fn same[T: Eq](a: T, b: T) : Bool = a == b

fn main() : Unit / Stdout {
  Stdout.print(show(same(P { x: 1, c: Red }, P { x: 1, c: Red })))
  Stdout.print(show(same(P { x: 1, c: Red }, P { x: 1, c: Green })))
  Stdout.print(show(same(Circle(1), Circle(1))))
  Stdout.print(show(same(Rect(1, 2), Circle(1))))
  let w = Wrap { p: P { x: 1, c: Red }, s: Rect(1, 2), xs: [P { x: 2, c: Green }] }
  Stdout.print(show(same(w, w)))
  Stdout.print(show(same(Box { v: Circle(3) }, Box { v: Circle(3) })))
  Stdout.print(show(same(Some(P { x: 1, c: Red }), Some(P { x: 1, c: Red }))))
  let n1 = Named { name: "a", run: (x: Int) => x }
  let n2 = Named { name: "a", run: (x: Int) => x + 1 }
  Stdout.print(show(same(n1, n2)))
  Stdout.print(show(n1 == n2))
}
