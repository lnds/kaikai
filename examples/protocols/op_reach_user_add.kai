type Money = { cents: Int }

impl Add for Money {
  fn add(self: Money, rhs: Money) : Money = Money { cents: self.cents + rhs.cents }
}

impl Neg for Money {
  fn neg(self: Money) : Money = Money { cents: 0 - self.cents }
}

fn main() : Int = {
  let m = Money { cents: 40 } + Money { cents: 2 }
  print(int_to_string(m.cents))
  print(int_to_string((-m).cents))
  0
}
