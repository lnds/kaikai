# `==` on a compound value calls a field type's `impl Eq`, whether the
# field type is a record or a variant, at any depth.

type Text = { s: String }

impl Eq for Text {
  fn eq(a: Text, b: Text) : Bool = string_length(a.s) == string_length(b.s)
}

type Tag = Tag(String)

impl Eq for Tag {
  fn eq(a: Tag, b: Tag) : Bool = true
}

type Node = N(Text, Int) | M
type Rec = { t: Text, g: Tag, n: Int }
type Outer = { r: Rec, label: String }
type Wrap = W(Node) | Nil
type Box[a] = { v: a }

impl[a : Eq] Eq for Box[a] {
  fn eq(x: Box[a], y: Box[a]) : Bool = true
}

# Same arity as `Text`: a rebuild that reuses a `Text` cell is plain.
type Raw = { s: String }

fn text(s: String) : Text = Text { s: s }
fn rec(s: String, n: Int) : Rec = Rec { t: text(s), g: Tag(s), n: n }
fn bx(n: Int) : Box[Int] = Box { v: n }
fn to_raw(t: Text) : Raw = match t { Text { s } -> Raw { s: s } }
fn bang(t: Text) : Text = match t { Text { s } -> Text { s: s ++ "!" } }

fn show(label: String, b: Bool) : Unit / Console =
  Stdout.print(label ++ (if b { "true" } else { "false" }))

fn main() : Unit / Console = {
  show("record top:         ", text("ab") == text("cd"))
  show("record in ctor:     ", N(text("ab"), 1) == N(text("cd"), 1))
  show("record in ctor !=:  ", N(text("ab"), 1) != N(text("abc"), 1))
  show("record in record:   ", rec("ab", 1) == rec("cd", 1))
  show("record in tuple:    ", (text("ab"), 1) == (text("cd"), 1))
  show("record in list:     ", [text("ab"), text("x")] == [text("cd"), text("y")])
  show("record in option:   ", Some(text("ab")) == Some(text("cd")))
  show("nested twice:       ", Outer { r: rec("ab", 1), label: "o" } == Outer { r: rec("cd", 1), label: "o" })
  show("ctor in ctor:       ", W(N(text("ab"), 2)) == W(N(text("cd"), 2)))
  show("list of records:    ", [rec("ab", 1)] == [rec("cd", 1)])
  show("variant in record:  ", Rec { t: text("ab"), g: Tag("p"), n: 1 } == Rec { t: text("ab"), g: Tag("q"), n: 1 })
  show("generic record:     ", [bx(1)] == [bx(2)])
  let r = rec("ab", 1)
  show("spread update:      ", Rec { ...r, t: text("cd") } == r)
  show("other field differs:", rec("ab", 1) == rec("cd", 2))
  show("field impl differs: ", N(text("ab"), 1) == N(text("abc"), 1))
  show("reused as plain:    ", to_raw(text("ab")) == to_raw(text("cd")))
  show("reused rebuild:     ", N(bang(text("ab")), 1) == N(bang(text("cd")), 1))
}
