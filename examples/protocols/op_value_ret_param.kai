protocol Parse {
  parse(s: String) : Self
}

impl Parse for Int {
  fn parse(s: String) : Int = string_length(s)
}

impl Parse for Bool {
  fn parse(s: String) : Bool = string_length(s) > 2
}

fn apply_all[T](f: (String) -> T, xs: [String]) : [T] = map(xs, f)

fn main() : Int {
  let ns : [Int] = apply_all(parse, ["a", "bcd"])
  let bs : [Bool] = apply_all(parse, ["a", "bcd"])
  let g : (String) -> Int = parse
  print(show(ns))
  print(show(bs))
  print(show(g("xyzw")))
  0
}
