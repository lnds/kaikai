import encoding.json_bind

type Spell = Fire | Ice

impl Json for Spell {
  fn to_json(self: Spell) : JsonValue = JNull
  fn of_json(v: JsonValue, path: String) : Result[Spell, JsonError] = Ok(Fire)
}

fn keep[t](f: (JsonValue, String) -> Result[t, JsonError]) : Int = 0

fn main() : Int {
  keep(of_json)
}
