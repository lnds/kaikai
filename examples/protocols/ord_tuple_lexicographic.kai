fn main() : Unit / Stdout {
  Stdout.print(show((1, "x") < (1, "y")))
  Stdout.print(show((1, "y") < (1, "x")))
  Stdout.print(show((1, "z") < (2, "a")))
  Stdout.print(show((2, "a") >= (2, "a")))
  Stdout.print(show((1, 2, 3) < (1, 2, 4)))
  Stdout.print(show((1, 2, 3) > (1, 2, 3)))
  Stdout.print(show((1, 2, 3, "a") <= (1, 2, 3, "b")))
  Stdout.print(show(sort([(2, "b"), (1, "z"), (2, "a"), (1, "a")])))
  Stdout.print(show(sort([(1, 2, 3), (1, 1, 9), (0, 5, 5), (1, 2, 1)]) |> map((t) => t.fst * 100 + t.snd * 10 + t.trd)))
  Stdout.print(show(sort([Some((1, 2)), None, Some((0, 9))])))
  Stdout.print(show(max((1, "a"), (1, "b"))))
  Stdout.print(show(min((2, 1, 1), (2, 1, 0)).trd))
}
