import encoding.json_bind

type Spell = Fire | Ice

impl Json for Spell {
  fn to_json(self: Spell) : JsonValue = match self {
    Fire -> JStr("fire")
    Ice  -> JStr("ice")
  }
  fn of_json(v: JsonValue, path: String) : Result[Spell, JsonError] = match v {
    JStr("ice") -> Ok(Ice)
    _           -> Ok(Fire)
  }
}

fn decode[t](f: (JsonValue, String) -> Result[t, JsonError], v: JsonValue) : Result[t, JsonError] = f(v, "$")

fn name(s: Spell) : String = match s {
  Fire -> "fire"
  Ice  -> "ice"
}

fn main() : Int {
  let a : Result[Spell, JsonError] = decode(of_json, JStr("ice"))
  let g : (JsonValue, String) -> Result[Spell, JsonError] = of_json
  match a {
    Ok(s)  -> print(name(s))
    Err(_) -> print("err")
  }
  match g(JStr("fire"), "$") {
    Ok(s)  -> print(name(s))
    Err(_) -> print("err")
  }
  0
}
