protocol Named {
  name(x: Self) : String
}

type Tag = Tg(Int)

impl Show for Tag {
  fn show(t: Tag) : String = match t { Tg(n) -> "tag" ++ show(n) }
}

impl Named for Tag {
  fn name(t: Tag) : String = match t { Tg(n) -> "named" ++ show(n) }
}

fn apply[u](h: (u) -> String, y: u) : String = h(y)

fn inner[a](h: (a) -> String, y: a) : String = h(y)

fn outer[b](h: (b) -> String, y: b) : String = inner(h, y)

fn top[c: Show](y: c) : String = outer(show, y)

fn main() : Unit / Stdout = {
  Stdout.print(apply(show, Tg(1)))
  Stdout.print(apply(name, Tg(2)))
  [Tg(3), Tg(4)] |> map(show) |> each((s) => Stdout.print(s))
  [Tg(5)] |> each((t) => Stdout.print(name(t)))
  let f = show
  Stdout.print(f(Tg(6)))
  Stdout.print(top(Tg(7)))
  Stdout.print(top(8))
}
