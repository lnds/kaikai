type Box[t] = Box(t)

type Box_O_Int_C = Other(Int)

impl Show for Box[Int] {
  fn show(x: Box[Int]) : String = "generic"
}

impl Show for Box_O_Int_C {
  fn show(x: Box_O_Int_C) : String = "literal"
}

fn name_it[t: Show](x: t) : String = show(x)

fn main() : Unit / Stdout = Stdout.print("#{name_it(Box(1))} #{name_it(Other(2))}")
