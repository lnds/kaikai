protocol Power {
  pow_int(x: Self, n: Int) : Int
}

impl Power for Int {
  fn pow_int(x: Int, n: Int) : Int = if n == 0 { 1 } else { x * pow_int(x, n - 1) }
}

fn apply2(f: (Int, Int) -> Int, a: Int, b: Int) : Int = f(a, b)

fn main() : Unit / Stdout = {
  let p = pow_int
  Stdout.print("#{apply2(p, 2, 5)}")
}
