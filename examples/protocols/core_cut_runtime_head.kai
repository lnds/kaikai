# A core impl selected only by the runtime head of a value stays in a
# pruned build: through a bound, through `==` and `<` on a compound
# operand, and through `show`, over nested core containers and types
# carrying their own impls.

type Tag = Tag(String)

impl Eq for Tag {
  fn eq(a: Tag, b: Tag) : Bool = true
}

impl Show for Tag {
  fn show(t: Tag) : String = "tag"
}

type Level = { n: Int }

impl Ord for Level {
  fn cmp(a: Level, b: Level) : Int = b.n - a.n
  fn min(a: Level, b: Level) : Level = if b.n < a.n { b } else { a }
  fn max(a: Level, b: Level) : Level = if b.n < a.n { a } else { b }
}

impl Eq for Level {
  fn eq(a: Level, b: Level) : Bool = a.n == b.n
}

fn same[T : Eq](a: T, b: T) : Bool = eq(a, b)

fn order[T : Ord](a: T, b: T) : Int = cmp(a, b)

fn text[T : Show](a: T) : String = show(a)

type Delta = { d: Int }

impl Neg for Delta {
  fn neg(x: Delta) : Delta = Delta { d: 0 - x.d }
}

fn flip[T : Neg](x: T) : T = neg(x)

fn yes(b: Bool) : String = if b { "yes" } else { "no" }

fn main() : Unit / Console = {
  Stdout.print(yes(same([Some((1, "a"))], [Some((1, "a"))])))
  Stdout.print(yes(same([Some((1, "a"))], [Some((1, "b"))])))
  Stdout.print(yes(same(Ok(Tag("x")), Ok(Tag("y")))))
  Stdout.print(yes(same([Level { n: 1 }], [Level { n: 1 }])))
  Stdout.print(yes(same(Some(Level { n: 1 }), Some(Level { n: 2 }))))
  Stdout.print(yes([Some(Tag("x"))] == [Some(Tag("y"))]))
  Stdout.print(yes((Level { n: 1 }, "a") != (Level { n: 2 }, "a")))
  Stdout.print(int_to_string(order(Level { n: 1 }, Level { n: 3 })))
  Stdout.print(int_to_string(order(Some(2), Some(5))))
  Stdout.print(yes([Level { n: 1 }] < [Level { n: 2 }]))
  Stdout.print(yes(Some(Level { n: 1 }) < Some(Level { n: 2 })))
  Stdout.print(text([Some((1, Tag("x")))]))
  Stdout.print(text(Ok(Tag("z"))))
  Stdout.print(show(-100i128 / 7i128))
  Stdout.print(int_to_string(neg(Delta { d: 4 }).d))
  Stdout.print(int_to_string(flip(Delta { d: 5 }).d))
  Stdout.print(int_to_string(-(2 + 1)))
  Stdout.print(show(flip(2.5)))
}
