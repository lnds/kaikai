protocol Describe {
  describe(x: Self) : String
}

type Tag = Tag(String)

impl Describe for Int {
  fn describe(x: Int) : String = "int #{int_to_string(x)}"
}

impl Describe for Tag {
  fn describe(x: Tag) : String = match x {
    Tag(s) -> "tag #{s}"
  }
}

impl[t: Describe] Describe for [t] {
  fn describe(xs: [t]) : String = string_join(map(xs, x => describe(x)), ",")
}

fn through[t: Describe](x: t) : String = describe(x)

fn main() : Unit / Stdout {
  println(through(7))
  println(through(Tag("a")))
  println(through([1, 2, 3]))
  println(through([Tag("x"), Tag("y")]))
}
