# Unary `-` on a type with an `impl Neg` calls it; a primitive number
# negates with no protocol call.

unit m

type V2 = { x: Int, y: Int }

impl Neg for V2 {
  fn neg(self: V2) : V2 = V2 { x: -self.x, y: -self.y }
}

fn flip[t: Neg](v: t) : t = -v

fn main() : Unit / Stdout {
  let v = -V2 { x: 1, y: -2 }
  Stdout.print("#{v.x} #{v.y}")
  let twice = -(-v)
  Stdout.print("#{twice.x} #{twice.y}")

  let w = flip(V2 { x: 3, y: 4 })
  Stdout.print("#{w.x} #{w.y}")
  Stdout.print(int_to_string(flip(5)))
  Stdout.print(real_to_string(flip(2.5)))

  let negate = a => -a
  let u = negate(V2 { x: 7, y: 8 })
  Stdout.print("#{u.x} #{u.y}")

  let d = 3.0<m>
  let e: Real<m> = -d
  Stdout.print(real_to_string(e / 1.0<m>))
  Stdout.print(int_to_string(-7))
  Stdout.print(int32_to_string(-5i32))
}
