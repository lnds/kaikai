# Derives over generic types whose fields are typed by the type's own
# parameters. The derived impl bounds each parameter by the protocol, so
# the payload's impl comes from the use site.

#[derive(Eq, Hash, Ord)]
type Slot[k, v] = Empty | Full(k, v)

#[derive(Ord)]
type Msg[t] = { id: Int, body: t }

fn sign(n: Int) : Int = if n < 0 { -1 } else if n > 0 { 1 } else { 0 }

fn main() : Unit / Stdout {
  let a: Slot[String, Int] = Full("k", 7)
  let b: Slot[String, Int] = Full("k", 8)
  let c: Slot[String, Int] = Full("j", 9)
  let e: Slot[String, Int] = Empty
  Stdout.print("#{eq(a, a)} #{eq(a, b)} #{eq(a, Full("k", 7))} #{eq(e, e)} #{eq(a, e)}")
  Stdout.print("#{hash(a) == hash(Full("k", 7))} #{hash(a) == hash(b)}")
  Stdout.print("#{sign(cmp(a, b))} #{sign(cmp(b, a))} #{sign(cmp(c, a))} #{sign(cmp(a, a))}")
  let m = Msg { id: 1, body: "ab" }
  let n = Msg { id: 1, body: "ac" }
  let o = Msg { id: 0, body: "zz" }
  Stdout.print("#{sign(cmp(m, n))} #{sign(cmp(n, m))} #{sign(cmp(o, m))} #{sign(cmp(m, m))}")
}
