# Derives over generic types. A derived impl for `T[a]` must read as a
# hand-written `impl[a: P] P for T[a]`: its field accesses mean the
# field even when a top-level fn carries the same name, and the type
# arguments reach the payload's own impl.

#[derive(Eq, Show, Hash)]
type Msg[t] = { id: Int, body: t }

#[derive(Show)]
type Slot[k, v] = Empty | Full(k, v)

fn body[a, b](x: a, f: (a) -> b) : b = f(x)

fn id(n: Int) : Int = n

fn main() : Unit / Stdout {
  let a = Msg { id: 1, body: "hi" }
  let b = Msg { id: 1, body: "ho" }
  Stdout.print(show(a))
  Stdout.print(show(Msg { id: 2, body: [3, 4] }))
  Stdout.print("#{eq(a, a)} #{eq(a, b)}")
  Stdout.print("#{hash(a) == hash(Msg { id: 1, body: "hi" })}")
  let s: Slot[String, Int] = Full("k", 7)
  Stdout.print(show(s))
  Stdout.print("#{body(id(5), (n) => n + 1)}")
}
