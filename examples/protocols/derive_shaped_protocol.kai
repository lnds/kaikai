# `#[derive]` picks a generator by what the protocol declares, never by
# what it is called. `Same` declares the operation the core `Eq` does, so
# the generator that derives `Eq` derives it. The derived body calls `eq`
# bare: a field answers through `Same` when its type implements it, and
# through the core protocol otherwise.

protocol Same {
  eq(a: Self, b: Self) : Bool
}

type Tag = { id: Int, note: String }

impl Same for Tag {
  fn eq(a: Tag, b: Tag) : Bool = a.id == b.id
}

#[derive(Same)]
type Item = Leaf(Tag) | Named(String, Int) | Empty

#[derive(Same)]
type Pack = { item: Item, weight: Real }

fn main() : Unit / Stdout = {
  let a = Leaf(Tag { id: 1, note: "a" })
  let b = Leaf(Tag { id: 1, note: "b" })
  let c = Leaf(Tag { id: 2, note: "a" })
  Stdout.print("#{eq(a, b)} #{eq(a, c)}")
  Stdout.print("#{eq(Named("x", 1), Named("x", 1))} #{eq(Named("x", 1), Named("y", 1))}")
  Stdout.print("#{eq(Empty, Empty)} #{eq(Empty, a)}")
  Stdout.print("#{eq(Pack { item: a, weight: 1.5 }, Pack { item: b, weight: 1.5 })}")
  Stdout.print("#{eq(Pack { item: a, weight: 1.5 }, Pack { item: b, weight: 2.5 })}")
}
