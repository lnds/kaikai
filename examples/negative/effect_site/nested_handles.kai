effect E {
  op() : Unit
}

effect G {
  tick() : Unit
}

fn f() : Unit / E {
  E.op()
}

fn main() : Unit / Stdout {
  handle {
    f()
    handle {
      f()
    } with G {
      tick(resume) -> resume(())
    }
  } with E {
    op(resume) -> resume(())
  }
  handle {
    f()
  } with G {
    tick(resume) -> resume(())
  }
}
