# The impl's function-typed parameter differs from the protocol's only in its closed effect row.

effect Log {
  emit(s: String) : Unit
}

effect Tick {
  tick() : Unit
}

protocol Runner {
  go(x: Self, f: () -> Unit / Log) : Unit
}

type Task = Task(Int)

impl Runner for Task {
  fn go(x: Task, f: () -> Unit / Tick) : Unit = ()
}

fn main() : Int = 0
