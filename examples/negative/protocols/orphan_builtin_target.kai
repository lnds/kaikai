# A builtin is declared by no module, so it never makes an impl local.
impl Ord for Bool {
  fn cmp(a: Bool, b: Bool) : Int = if a == b { 0 } else if a { 1 } else { 0 - 1 }
  fn min(a: Bool, b: Bool) : Bool = a and b
  fn max(a: Bool, b: Bool) : Bool = a or b
}

fn main() : Unit / Stdout = Stdout.print("unreachable")
