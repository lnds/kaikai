# Dispatch is static. `once` read as a value runs unspecialised, where
# the receiver has no type and two protocols declare `render`: the call
# is a panic naming them, not a call of whichever was registered last.
import pa
import pb

fn once[a](x: a) : String = render(x)

fn main() : Unit / Stdout = {
  let g = once
  Stdout.print(once(pa.A(1)))
  Stdout.print(g(pb.B(1)))
}
