# A generic impl recurses on its type parameter, instantiated at a type
# with no `Show` impl.

type Pair[t] = Pair(t, t)

type Blob = Blob(Int)

impl[t: Show] Show for Pair[t] {
  fn show(p: Pair[t]) : String = match p {
    Pair(a, b) -> "(" ++ show(a) ++ ", " ++ show(b) ++ ")"
  }
}

fn main() : Unit / Stdout = Stdout.print(show(Pair(Blob(1), Blob(2))))
