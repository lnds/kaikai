# Operator dispatch must check the habitant, not just the carrier: an
# `impl Add[Int<day>]` reached through `+` has to reject an `Int<month>`
# exactly as a direct call to the same impl does. Selecting the impl on
# the carrier alone silently ran `day` arithmetic on a `month` operand.

kind Span : Module over T with sp
sp day
sp month

type Box = { v: Int }

impl Add[Int<day>] for Box {
  fn add(self: Box, rhs: Int<day>) : Box = Box { v: self.v + __detach_unit(rhs) }
}

pub fn main() : Unit / Console = {
  let b = Box { v: 10 }
  let m : Int<month> = 2<month>
  let bad = b + m
  print("never reached")
}
