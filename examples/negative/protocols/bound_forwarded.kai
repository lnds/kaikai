# A bounded generic forwards its parameter to another with the same
# bound; the outer call is instantiated at a type with no `Ord` impl.

type Ticket = Ticket(Int)

fn least[T: Ord](a: T, b: T) : T = if cmp(a, b) < 0 { a } else { b }

fn pick[T: Ord](a: T, b: T) : T = least(a, b)

fn main() : Unit / Stdout = match pick(Ticket(1), Ticket(2)) {
  Ticket(n) -> Stdout.print(int_to_string(n))
}
