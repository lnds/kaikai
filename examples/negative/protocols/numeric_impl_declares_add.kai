# `Numeric` does not declare `add` or `mul`: those belong to the
# operator protocols `Add` and `Mul`.
type Mod7 = { v: Int }

impl Numeric for Mod7 {
  fn add(a: Mod7, b: Mod7) : Mod7 = Mod7 { v: (a.v + b.v) % 7 }
  fn zero() : Mod7 = Mod7 { v: 0 }
  fn one() : Mod7 = Mod7 { v: 1 }
  fn abs(x: Mod7) : Mod7 = x
  fn sign(x: Mod7) : Int = 0
  fn pow_int(b: Mod7, e: Int) : Mod7 = b
  fn clamp(x: Mod7, lo: Mod7, hi: Mod7) : Mod7 = x
}

fn main() : Unit / Stdout = Stdout.print("unreachable")
