# A protocol op with no impl, called inside the argument of a generic
# call: monomorphisation retargets the outer call site, and `--check`
# must still reject the inner dispatch exactly as a build does.

protocol P { foo(x: Self) : Int }

type Box = Box(Int)

fn keep[t](x: t) : t = x

fn main() : Int = keep(foo(Box(1)))
