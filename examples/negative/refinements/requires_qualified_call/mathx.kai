#[doc("Divide, rejecting a zero divisor.")]
pub fn safe_div(a: Int, b: Int) : Int requires b != 0 { a / b }

#[doc("Divide; shares its name with the core `div`.")]
pub fn div(a: Int, b: Int) : Int requires b != 0 { a / b }

#[doc("Scale an integer by a positive factor.")]
pub fn scale(a: Int, k: Int) : Int requires k > 0 { a * k }
