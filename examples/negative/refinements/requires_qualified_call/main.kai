# A module-qualified call, a method call into another module, and a method
# call whose name two modules export are checked against the declaration
# they reach.
import mathx
import mreal

fn main() : Unit / Stdout = {
  Stdout.print("#{mathx.safe_div(10, 0)}")
  Stdout.print("#{mathx.div(10, 0)}")
  Stdout.print("#{10.safe_div(0)}")
  Stdout.print("#{3.scale(0)}")
  Stdout.print("#{2.0.scale(0.0)}")
  Stdout.print("#{3.scale(1).scale(0)}")
}
