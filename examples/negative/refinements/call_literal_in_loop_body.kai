# A literal argument that refutes the callee's refinement is rejected at
# compile time wherever the call is written, a `loop` combinator body
# included: the typer lowers `repeat` / `until` / `while` to intrinsics.
import loop

type Positive = Int where self > 0

fn must(x: Positive) : Int = x

fn main() : Int / Mutable = {
  var i := 0
  repeat(1) {
    let _a = must(0)
    ()
  }
  until { i > 0 } {
    let _b = must(-1)
    i := i + 1
  }
  while { i < 2 } {
    let _c = must(-2)
    i := i + 1
  }
  0
}
