# A top-level `fn` named after a core builtin must be rejected at the
# user's declaration. Both emitters consult the core table before the
# user-fn registry, so the builtin wins and this body never runs —
# marking it `pub` silences the old diagnostic without changing which
# body executes, so the rejection must not be `pub`-conditional.

pub fn print(x: String) : Unit / Stdout = write_stdout("user body")

fn main() : Unit / Stdout = print("hi")
