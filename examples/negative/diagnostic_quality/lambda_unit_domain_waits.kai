# A lambda whose parameter is typed by a unit variable waits for the
# argument that settles the unit, like one typed by a type variable: the
# mismatch is reported inside the lambda, not on the earlier argument.

unit m
unit s

fn apply_to[u: Measure](x: Real<u>, f: (Real<u>) -> Real<u>) : Real<u> = f(x)

fn only_m(v: Real<m>) : Real<m> = v

fn main() : Unit / Stdout = {
  let b = apply_to(2.0<s>, (v) => only_m(v))
  Stdout.print("#{b}")
}
