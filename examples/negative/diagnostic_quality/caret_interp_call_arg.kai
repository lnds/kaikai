# Diagnostic quality: an error inside a `#{...}` interpolation must
# anchor at the position the user actually wrote. The interpolation
# body is re-parsed on its own, so without rebasing its positions the
# caret lands wherever the fragment's own line 1 happens to fall in
# the enclosing file — here, on one of the padding comments below.
#
# The padding matters: it keeps the fragment's origin (line 1) away
# from the real call site, so a regression cannot pass by coincidence.

fn double(x: Int) : Int = x * 2

fn main() : Unit / Stdout = {
  let s = "hello"
  println("#{double(s)}")
}
