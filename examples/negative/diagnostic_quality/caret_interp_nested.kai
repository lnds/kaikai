# Diagnostic quality: an interpolation nested inside another one is
# re-parsed twice, so its position has to compose — the inner body is
# rebased relative to an outer body that was itself already rebased.
# Rebasing before the recursive desugar is what makes that compose.

fn double(x: Int) : Int = x * 2

fn main() : Unit / Stdout = {
  let s = "hello"
  println("outer #{"inner #{double(s)}"}")
}
