# Diagnostic quality: a triple-quoted literal spreads its body over
# several lines, so a part's position cannot be derived from a plain
# character offset — the newlines inside the literal have to move the
# line and reset the column, or the caret lands past the end of the
# line that opens the string.

fn double(x: Int) : Int = x * 2

fn main() : Unit / Stdout = {
  let s = "hello"
  println("""
report
value: #{double(s)}
""")
}
