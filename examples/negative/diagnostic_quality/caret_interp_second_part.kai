# Diagnostic quality: with several interpolations on one line, the
# caret must land in the one that actually failed. Each part's offset
# within the string is what separates them, so a fix that only rebased
# onto the string's own start would put every caret on the first one.

fn double(x: Int) : Int = x * 2

fn main() : Unit / Stdout = {
  let s = "hello"
  println("a=#{double(1)} b=#{double(s)}")
}
