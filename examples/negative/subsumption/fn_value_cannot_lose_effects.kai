# A function named as a value types like its eta-expansion: its closed row
# opens, but a row still never loses a label. `noisy` performs Stderr, which
# the `Stdout`-only slot does not allow.

fn noisy(s: String) : Unit / Stdout + Stderr = println(s)

fn apply_quiet(xs: [String], f: (String) -> Unit / Stdout) : Unit / Stdout = xs |! f(.)

fn main() : Unit / Stdout = apply_quiet(["a"], noisy)
