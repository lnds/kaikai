# The repeat sits in a nested pattern and a list rest: one name, two
# binders, in an arm.
type Wrap = MkWrap([Int], Int)

fn total(w: Wrap) : Int = match w {
  MkWrap([h, ...rest], rest) -> h
  MkWrap(_, n)               -> n
}

fn main() : Unit / Stdout = Stdout.print(int_to_string(total(MkWrap([1, 2], 3))))
