# Negative fixture (patterns): `_` in an ordinary call argument is not
# a placeholder — only a `|>` right-hand side substitutes it. Accepting
# it typed the argument as `Any` and lowered it to zero, so the call
# silently received `0` / `""` / a valid-looking row id.

fn f(a: Int, b: Int) : Int = a + b

fn main() : Unit / Stdout = Stdout.print("#{f(1, _)}")
