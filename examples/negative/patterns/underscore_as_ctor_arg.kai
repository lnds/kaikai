# Negative fixture (patterns): `_` in a constructor argument built the
# value with a zero payload instead of being rejected. A constructor
# call and a constructor pattern look alike, so a grep that finds one
# finds the other — this is the shape that lets a wrong `_` land.

type Wrap = W(String)

fn mk() : Wrap = W(_)

fn main() : Unit / Stdout = match mk() {
  W(s) -> Stdout.print("len=#{s.length()}")
}
