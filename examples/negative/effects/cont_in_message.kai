# A continuation cannot travel in an actor message.

effect Yield { yield(x: Int) : Unit }

type Gen = Done | Next(Int, Cont[Unit, Gen])

fn gen() : Gen = handle { Yield.yield(1); Done } with Yield { yield(x, resume) -> Next(x, resume) }

fn forward(p: Pid[Gen]) : Unit / Actor[Gen] = Actor.send(p, gen())

fn main() : Unit = ()
