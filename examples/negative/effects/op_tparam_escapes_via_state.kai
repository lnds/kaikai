# An inferred handler state cannot take the op's own type parameter:
# each perform chooses its own.
effect Sink {
  put[T](x: T) : Unit
}

fn main() : Unit / Stdout = {
  let got = handle {
    Sink.put("hello")
    Sink.put(7)
  } with Sink([]) {
    put(x, resume) -> resume((), [x, ...state])
    return(r) -> state
  }
  Stdout.print(int_to_string(list_length(got)))
}
