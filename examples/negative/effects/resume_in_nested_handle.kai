# The continuation called inside a `handle` nested in its clause: the
# resumed body would have to run under the inner handler, so a `Tell`
# the body performs would reach it. The clause cannot be split that way.

effect Ask { number() : Int }
effect Tell { say(s: String) : Unit }

fn main() : Unit / Stdout = {
  let c = handle {
    handle { let n = Ask.number(); Tell.say("x"); n + 1 }
    with Ask {
      number(resume) -> handle { resume(20) } with Tell {
        say(s, k) -> { Stdout.print("inner said #{s}"); k(()) }
      }
    }
  } with Tell { say(s, resume) -> { Stdout.print("outer said #{s}"); resume(()) } }
  Stdout.print("c=#{c}")
}
