# A region inside a handler body that reaches a suspension point is
# rejected like any other region that spans a yield.
import spawn

effect Ask {
  ask() : Int
}

fn cooperate() : Unit / Spawn =
  Spawn.yield()

fn main() : Int / Spawn = handle {
  region {
    cooperate()
    Ask.ask()
  }
} with Ask {
  ask(resume) -> resume(1)
}
