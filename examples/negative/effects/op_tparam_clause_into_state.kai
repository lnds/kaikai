# Storing the op's own type parameter into a `[Msg]` state pins it to
# `Msg`, which a perform of another type would break.
type Msg = Ping | Pong

effect Mailbox {
  post[T](msg: T) : Unit
}

fn main() : Unit / Stdout = {
  let got = handle {
    Mailbox.post(Ping)
    Mailbox.post("not a Msg")
  } with Mailbox([Pong]) {
    post(msg, resume) -> resume((), [msg, ...state])
    return(r) -> state
  }
  Stdout.print(int_to_string(list_length(got)))
}
