effect Ask { number() : Int }

# A clause that does not resume produces the handle's value, so it must
# have the handle's type (String here), not the op's return type (Int).
fn main() : Unit / Stdout = {
  let c = handle { let n = Ask.number(); "body #{n}" }
          with Ask { number(resume) -> 7 }
  Stdout.print(c)
}
