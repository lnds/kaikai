effect Pick { pick() : Int }

# A clause's continuation is its last param whatever it is called, and
# binding it to a value lets it escape the clause.
fn main() : Int / Stdout = {
  let r = handle { let x = Pick.pick(); x + 1 }
          with Pick { pick(k) -> { let f = k; f(10) } return(x) -> x }
  Stdout.print("r=#{r}\n"); 0
}
