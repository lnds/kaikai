effect Pick { pick() : Int }

# The one-shot continuation is called in the clause body itself, not from a
# lambda inside it.
fn main() : Int / Stdout = {
  let r = handle { let x = Pick.pick(); x + 1 }
          with Pick { pick(resume) -> { let g = (v: Int) => resume(v); g(10) } return(x) -> x }
  Stdout.print("r=#{r}\n"); 0
}
