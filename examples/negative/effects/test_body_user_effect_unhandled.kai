# A test body absorbs only what the program entry may carry: the
# default-handled effects plus the `Ffi` capability. A user-declared
# effect has no runtime evidence at the runner's synthesised entry,
# so performing it from a test block must stay rejected.

effect Net {
  fetch(url: String) : String
}

test "user effect is rejected" {
  assert Net.fetch("x") == "y"
}
