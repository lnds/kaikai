# `Cont[T, S]` is the continuation of a pure body: one whose body also
# performs `Stdout` is a `Cont[T, S, Stdout]`.

effect Yield { yield(x: Int) : Unit }

type Gen = Done | Next(Int, Cont[Unit, Gen])

fn main() : Unit / Stdout = {
  let g = handle { Stdout.print("start"); Yield.yield(1); Done } with Yield {
    yield(x, resume) -> Next(x, resume)
  }
  match g {
    Done       -> ()
    Next(x, _) -> Stdout.print("#{x}")
  }
}
