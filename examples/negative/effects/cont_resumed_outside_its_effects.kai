# Resuming a generator runs its body on, so `k(v)` performs the body's
# effects: a function stepping a `Gen[Tag]` must handle or declare `Tag`.

effect Yield { yield(x: Int) : Unit }
effect Tag { tag() : Int }

type Gen[e] = Done | Next(Int, Cont[Unit, Gen[e], e])

fn first_two(g: Gen[Tag]) : Int = match g {
  Done       -> 0
  Next(x, k) -> match k(()) {
    Done      -> x
    Next(y, _) -> x + y
  }
}

fn main() : Unit = ()
