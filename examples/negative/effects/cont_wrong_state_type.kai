# A stateful handle's continuation resumes with a value and the next state:
# the state must have the handler's state type.

effect Yield { yield(x: Int) : Unit }

type Gen = Done | Next(Int, Cont[(Unit, Int), Gen])

fn main() : Unit / Stdout = {
  let g = handle { Yield.yield(1); Done } with Yield(0) { yield(x, resume) -> Next(x + state, resume) }
  match g {
    Done       -> ()
    Next(x, k) -> match k((), "one") {
      Done      -> Stdout.print("#{x}")
      Next(_, _) -> ()
    }
  }
}
