# Two labels of one effect that differ only in a function type's row are
# distinct: handling the `Log` one leaves the `Tick` one unhandled.
effect Log { log(msg: String) : Unit }
effect Tick { tick() : Unit }
effect Cell[T] { get() : T }

fn two() : Int / Cell[() -> Unit / Log] + Cell[() -> Unit / Tick] = 0

fn main() : Int =
  handle { two() } with Cell[() -> Unit / Log] {
    get(resume) -> resume(() => ())
  }
