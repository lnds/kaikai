# A continuation belongs to the fiber whose segment it suspended: a thunk
# run on another fiber cannot capture one.

effect Yield { yield(x: Int) : Unit }

type Gen = Done | Next(Int, Cont[Unit, Gen])

fn gen() : Gen = handle { Yield.yield(1); Done } with Yield { yield(x, resume) -> Next(x, resume) }

fn main() : Unit / Stdout + Spawn = match gen() {
  Done       -> ()
  Next(_, k) -> {
    let f = Spawn.spawn(() => { let _ = k(()); 0 })
    Stdout.print("#{Spawn.await(f)}")
  }
}
