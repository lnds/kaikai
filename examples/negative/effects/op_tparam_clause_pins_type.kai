# A clause cannot assume a concrete type for the op's own type
# parameter: `Sink.put("hello")` would reach `n + 1` as a String.
effect Sink {
  put[T](x: T) : Unit
}

fn main() : Unit / Stdout = {
  handle {
    Sink.put("hello")
  } with Sink {
    put(x, resume) -> {
      let n: Int = x
      Stdout.print(int_to_string(n + 1))
      resume(())
    }
    return(r) -> r
  }
}
