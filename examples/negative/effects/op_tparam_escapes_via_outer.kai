# A binding outside the clause cannot take the op's own type
# parameter: the outer code would read it at a type the perform chose.
effect Sink {
  put[T](x: T) : Unit
}

fn main() : Unit / Stdout + Mutable = {
  let cell = &[]
  handle {
    Sink.put("hello")
  } with Sink {
    put(x, resume) -> { cell := [x]; resume(()) }
    return(v) -> v
  }
  match @cell {
    [n] -> Stdout.print(int_to_string(n + 1))
    _   -> ()
  }
}
