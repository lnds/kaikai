# A clause that abandons `resume` yields the handler's result, so it
# cannot return a value of the op's own type parameter.
effect Sink {
  put[T](x: T) : Unit
}

fn main() : Unit / Stdout = {
  let r = handle {
    Sink.put("hello")
    []
  } with Sink {
    put(x, resume) -> [x]
    return(v) -> v
  }
  Stdout.print(int_to_string(list_length(r)))
}
