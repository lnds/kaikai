# A clause `var` read after a non-tail `resume`: that code runs when the
# handle exits, after the var's block is gone.

effect Ask { number() : Int }

fn main() : Unit / Stdout = {
  let c = handle { Ask.number() + 1 } with Ask {
    number(resume) -> {
      var seen := 1
      let r = resume(seen)
      r + seen
    }
  }
  Stdout.print("c=#{c}")
}
