# The region is written inside a loop body and spans a yield on its own.
import spawn
import loop

fn cooperate() : Unit / Spawn =
  Spawn.yield()

fn main() : Int / Spawn = {
  var total := 0
  repeat(1) {
    total := region {
      let scratch = [1, 2, 3]
      cooperate()
      list_length(scratch)
    }
  }
  total
}
