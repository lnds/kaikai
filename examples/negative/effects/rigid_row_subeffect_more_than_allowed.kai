effect Ping { ping() : Unit }
effect Log { log() : Unit }

fn around[a, e](hear: () -> Unit / e, body: () -> a / Ping + e) : a / e = handle {
  body()
} with Ping {
  ping(resume) -> {
    hear()
    resume(())
  }
  return(x) -> x
}

fn watched[e](once: () -> Int / Ping + Log + e) : Int / e =
  around(() => (), () => once())

fn main() : Unit / Stdout = Stdout.print("done")
