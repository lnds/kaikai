# The suspension is written inside a loop body within the region. The
# loop lowers to an intrinsic whose body runs in place, so the region
# still spans the yield.
import spawn
import loop

fn cooperate() : Unit / Spawn =
  Spawn.yield()

fn main() : Int / Spawn = {
  let total = region {
    let scratch = [1, 2, 3]
    repeat(1) { cooperate() }
    list_length(scratch)
  }
  total
}
