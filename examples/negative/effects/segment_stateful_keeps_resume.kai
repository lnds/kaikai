# A stateful handle cannot run its body on a stack segment yet: a clause
# that keeps its continuation as a value is rejected.

effect Yield { yield(x: Int) : Unit }

type Gen = Done | Next(Int, Cont[Unit, Gen])

fn main() : Unit / Stdout = {
  let g = handle { Yield.yield(1); Done } with Yield(0) { yield(x, resume) -> Next(x, resume) }
  match g {
    Done       -> ()
    Next(x, _) -> Stdout.print("#{x}")
  }
}
