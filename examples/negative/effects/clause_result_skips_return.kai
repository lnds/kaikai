effect Ask { number() : Int }

# A clause that does not resume bypasses `return`, so its value must
# already have the handle's type (String), not the body's type (Int).
fn main() : Unit / Stdout = {
  let c = handle { Ask.number() + 1 } with Ask {
    number(resume) -> 5
    return(x)      -> "ret #{x}"
  }
  Stdout.print(c)
}
