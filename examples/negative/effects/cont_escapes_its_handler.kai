# A generator whose body performs `Tag` cannot leave the handle of `Tag`:
# dropping or stepping it outside would run its body without a handler.

effect Yield { yield(x: Int) : Unit }
effect Tag { tag() : Int }

type Gen[e] = Done | Next(Int, Cont[Unit, Gen[e], e])

fn tagged() : Gen[Tag] / Tag =
  handle { Yield.yield(Tag.tag()); Yield.yield(Tag.tag()); Done } with Yield { yield(x, resume) -> Next(x, resume) }

fn escaped() : Gen[Tag] = handle { tagged() } with Tag { tag(resume) -> resume(7) }

fn main() : Unit = ()
