# A handler written inside a lambda is held to the same rule as one written
# in a fn body: every op of the effect needs a clause.

effect Telling {
  tell_of(line: String) : Unit
  entered(phase: Int) : Unit
}

fn run[a](body: () -> a) : a = body()

fn heard() : [String] =
  run(
    () => handle {
      Telling.tell_of("preparing")
    } with Telling([]) {
      tell_of(line, resume) -> resume((), state ++ [line])
      return(_x) -> state
    }
  )

fn main() : Unit / Stdout = Stdout.print("#{heard()}")
