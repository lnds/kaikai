# A handler that leaves ops without a clause is rejected even when nothing
# performs them: inside the `handle`, an op without a clause has no handler.

effect Telling {
  tell_of(line: String) : Unit
  entered(phase: Int) : Unit
  got_through(done: Int, total: Int) : Unit
}

fn heard(body: () -> Unit / Telling) : [String] = handle {
  body()
} with Telling([]) {
  tell_of(line, resume) -> resume((), state ++ [line])
  return(_x) -> state
}

fn phases() : Unit / Telling {
  Telling.tell_of("preparing")
  Telling.tell_of("casting 2 of 6")
}

fn main() : Unit / Stdout = Stdout.print("#{heard(phases)}")
