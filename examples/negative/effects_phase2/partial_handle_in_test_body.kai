# A handler written in a `test` body is held to the same rule as one written
# in a fn body: every op of the effect needs a clause.

effect Telling {
  tell_of(line: String) : Unit
  entered(phase: Int) : Unit
}

test "one op handled" {
  let lines = handle {
    Telling.tell_of("preparing")
  } with Telling([]) {
    tell_of(line, resume) -> resume((), state ++ [line])
    return(_x) -> state
  }
  assert lines == ["preparing"]
}

fn main() : Int = 0
