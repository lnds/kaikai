effect X {
  x() : Int
  z() : Int
  default {
    x(resume) -> {
      let r = handle {
        Y.y()
      } with Y {
        w(resume) -> resume(3)
      }
      resume(r)
    }
  }
}

effect Y {
  y() : Int
  w() : Int
  default {
    y(resume) -> {
      let r = handle {
        X.x()
      } with X {
        z(resume) -> resume(3)
      }
      resume(r)
    }
  }
}

fn main() : Int / Stdout {
  Stdout.print(int_to_string(X.x()))
  0
}
