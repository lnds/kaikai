effect Acc[t] {
  put(x: t) : Unit
  default {
    put(x, resume) -> resume(())
  }
}

effect Y {
  y() : Int
  default {
    y(resume) -> {
      Acc.put(1)
      resume(1)
    }
  }
}

effect Z {
  z() : Int
  default {
    z(resume) -> {
      Acc.put("s")
      resume(2)
    }
  }
}

fn main() : Int = Y.y() + Z.z()
