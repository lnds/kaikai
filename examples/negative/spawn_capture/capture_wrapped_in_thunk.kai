# The carrier is wrapped in a record built INSIDE the thunk, so the
# spawned call's argument type is the wrapper, not the cell. What makes
# this a capture is the free name `r`, not the shape around it —
# classifying by the argument's type would let this through.

import spawn

type Box = { cell: Ref[Int] }

fn bump(b: Box) : Unit / Mutable =
  Mutable.ref_set(b.cell, Mutable.ref_get(b.cell) + 1)

fn main() : Int / Spawn + Stdout + Mutable = {
  let r = Mutable.ref_make(0)
  nursery { n ->
    let f = n.spawn(() => bump(Box { cell: r }))
    n.await(f)
  }
  Stdout.print("wrapped=#{Mutable.ref_get(r)}")
  0
}
