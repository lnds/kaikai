# A capture seen through two spawn boundaries. Each spawn runs its own
# check, and the inner thunk is where the capture actually happens, so
# the name is reported once — from the inner spawn — not once per
# enclosing spawn.

import spawn

fn bump(r: Ref[Int]) : Unit / Mutable =
  Mutable.ref_set(r, Mutable.ref_get(r) + 1)

fn main() : Int / Spawn + Stdout + Mutable = {
  let r = Mutable.ref_make(0)
  nursery { n ->
    let outer = n.spawn(() => {
      nursery { m ->
        let inner = m.spawn(() => bump(r))
        m.await(inner)
      }
    })
    n.await(outer)
  }
  Stdout.print("nested=#{Mutable.ref_get(r)}")
  0
}
