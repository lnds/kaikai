import spawn

fn run_in_fiber(k: () -> Unit / Mutable) : Unit / Spawn + Mutable =
  nursery { n ->
    let f = n.spawn(k)
    n.await(f)
  }

fn main() : Int / Spawn + Stdout + Mutable = {
  let r = Mutable.ref_make(0)
  run_in_fiber(() => Mutable.ref_set(r, 5))
  Stdout.print("r=#{Mutable.ref_get(r)}")
  0
}
