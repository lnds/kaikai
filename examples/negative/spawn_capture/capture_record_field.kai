# The carrier is reached through a field, not spelled at the capture:
# `HashMap` is a record whose buckets are a `Ref`. Rejecting this is
# what distinguishes a check built on the mutation-carrier closure from
# one that enumerates `Array` and `Ref`.

import spawn
import collections.hashmap

fn touch(m: HashMap[String, Int]) : Unit / Mutable = {
  let _ = hashmap.put(m, "k", 99)
  ()
}

fn show_opt(o: Option[Int]) : String = match o {
  Some(x) -> int_to_string(x)
  None    -> "-"
}

fn main() : Int / Spawn + Stdout + Mutable = {
  let m = hashmap.from([Pair { fst: "k", snd: 0 }])
  nursery { n ->
    let f = n.spawn(() => touch(m))
    n.await(f)
  }
  let v = hashmap.get(m, "k")
  Stdout.print("hm=#{show_opt(v)}")
  0
}
