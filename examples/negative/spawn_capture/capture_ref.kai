# A spawned thunk captures a `Ref` owned by the parent fiber. Fibers
# have private heaps, so the child bumps its own copy and the parent
# reads back the value it started with — the mutation is lost with no
# diagnostic unless the capture itself is rejected.

import spawn

fn bump(r: Ref[Int]) : Unit / Mutable = {
  let v = Mutable.ref_get(r)
  Mutable.ref_set(r, v + 1)
}

fn main() : Int / Spawn + Stdout + Mutable = {
  let r = Mutable.ref_make(0)
  nursery { n ->
    let f = n.spawn(() => bump(r))
    n.await(f)
  }
  Stdout.print("ref=#{Mutable.ref_get(r)}")
  0
}
