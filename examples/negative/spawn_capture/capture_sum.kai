# The carrier is a sum: a variant payload owns the `Array`.

import spawn

type Slot = Empty | Held(Array[Int])

fn touch(s: Slot) : Unit / Mutable = match s {
  Held(items) -> { items[0] := 99 }
  Empty       -> ()
}

fn main() : Int / Spawn + Stdout + Mutable = {
  let s = Held(array_make(1, 0))
  nursery { n ->
    let f = n.spawn(() => touch(s))
    n.await(f)
  }
  match s {
    Held(items) -> Stdout.print("items[0]=#{items[0]}")
    Empty       -> Stdout.print("empty")
  }
  0
}
