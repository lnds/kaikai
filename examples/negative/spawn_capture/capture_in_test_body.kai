# A spawned thunk in a `test` body captures a `Ref` owned by the parent
# fiber: the capture is rejected there as in a `fn` body.

import spawn

fn bump(r: Ref[Int]) : Unit / Mutable {
  let v = Mutable.ref_get(r)
  Mutable.ref_set(r, v + 1)
}

test "capture in test body" {
  let r = Mutable.ref_make(0)
  nursery { n ->
    let f = n.spawn(() => bump(r))
    n.await(f)
  }
  assert Mutable.ref_get(r) == 1
}

fn main() : Int = 0
