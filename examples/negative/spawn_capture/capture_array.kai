# The `Array` shape of the same defect: the carrier is the head type
# itself, not a record wrapping one. The child writes its own copy.

import spawn

fn touch(a: Array[Int]) : Unit / Mutable = {
  let _ = array_set(a, 0, 99)
  ()
}

fn main() : Int / Spawn + Stdout + Mutable = {
  let a = array_make(3, 0)
  nursery { n ->
    let f = n.spawn(() => touch(a))
    n.await(f)
  }
  Stdout.print("arr=#{array_get(a, 0)}")
  0
}
