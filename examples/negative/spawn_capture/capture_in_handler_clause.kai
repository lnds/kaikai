import spawn

effect Tick {
  tick() : Int
}

fn touch(a: Array[Int]) : Int / Mutable {
  let _ = array_set(a, 0, 99)
  1
}

fn main() : Int / Spawn + Stdout + Mutable {
  let a = array_make(3, 0)
  nursery { n ->
    let f = n.spawn(
      () => handle {
        Tick.tick()
      } with Tick {
        tick(resume) -> resume(touch(a))
        return(x) -> x
      }
    )
    n.await(f)
  }
  Stdout.print("arr=#{array_get(a, 0)}")
  0
}
