# The carrier is two user records away from the capture: `Store` holds a
# `Shelf`, which holds the record that owns the `Array`.

import spawn

type Cells = { items: Array[Int] }
type Shelf = { cells: Cells }
type Store = { shelf: Shelf }

fn touch(s: Store) : Unit / Mutable {
  s.shelf.cells.items[0] := 99
}

fn main() : Int / Spawn + Stdout + Mutable = {
  let s = Store { shelf: Shelf { cells: Cells { items: array_make(1, 0) } } }
  nursery { n ->
    let f = n.spawn(() => touch(s))
    n.await(f)
  }
  Stdout.print("items[0]=#{s.shelf.cells.items[0]}")
  0
}
