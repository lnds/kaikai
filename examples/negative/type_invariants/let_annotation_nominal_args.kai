# A `let` annotation on a user-declared nominal type must check the
# type ARGUMENTS, not just the head name. A sum type whose variant
# shares the type's own name must not upcast to itself and swallow
# the argument mismatch.

pub type Pair[t, u] = Pair(t, u)

fn main() : Int = {
  let b : Pair[Int, Bool] = Pair(1, true)
  let c : Pair[String, Bool] = b
  match c { Pair(_, _) -> 0 }
}
