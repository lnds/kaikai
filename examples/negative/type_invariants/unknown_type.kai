# Negative fixture (type system): an annotation names a type nothing
# declares. The name itself is rejected, never a mismatch against it,
# and the help names the import when a stdlib module declares a type
# so named.

unit USD

fn main() : Int {
  let c: Frobnicate<USD> = 3.0<USD>
  let d: Decimal<USD> = 4.50<USD>
  0
}
