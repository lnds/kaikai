# Negative fixture (type system): a literal written inside an
# interpolation needs its type's module like one written outside it,
# and the error points at the literal inside the string.

fn main() : Unit / Stdout = {
  Stdout.print("#{128n}")
  Stdout.print("#{0.25d}")
  Stdout.print("#{lazy [1, 2]}")
  Stdout.print("#{-7n}")
  Stdout.print("a#{"b#{9n}"}")
}
