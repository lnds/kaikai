# The signature lists `T` and uses it in a parameter; `b` appears only
# in the return type and nothing binds it. A parameter the source listed
# does not excuse one it did not: the caller still has nothing to
# constrain `b` with.

fn conv[T](x: T) : Option[b] = None

fn main() : Int = match conv(1) {
  Some(n) -> n
  None    -> 0
}
