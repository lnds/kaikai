# A value whose type declares no fields has none to read: each read is
# rejected where it is written, whatever the type.

fn twice(n: Int) : Int = n * 2

fn main() : Unit / Stdout = {
  let xs = [1, 2, 3]
  let n = 7
  let s = "seven"
  Stdout.print("#{xs.size}")
  Stdout.print("#{n.digits}")
  Stdout.print("#{s.width}")
  Stdout.print("#{twice.arity}")
}
