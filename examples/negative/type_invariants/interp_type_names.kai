# Negative fixture (type system): a type name written inside an
# interpolation is checked like one written outside it, and the error
# points at the name inside the string.

fn main() : Unit / Stdout = {
  Stdout.print("#{((x: Nope) => 1)(2)}")
  Stdout.print("#{((x: Decimal) => 1)(2)}")
  Stdout.print("#{Missing { x: 1 }.x}")
  Stdout.print("a#{"b#{match 1 { n: Absent -> n  _ -> 0 }}"}")
}
