# A pattern binder sharing a prelude name is bound correctly but read
# back as the primitive, so the payload arrives empty with no other
# symptom. kaic1 must reject the collision instead of miscompiling it.

type T = Var(String, [String])

fn payload_len(v: T) : Int = match v {
  Var(_n, args) -> list_length(args)
}

fn main() : Int = payload_len(Var("x", ["a", "b", "c"]))
