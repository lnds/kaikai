# A sum whose payload reaches an Array only through a user record, held
# in a generic container, still carries the caller's cell.

type Cells = { items: Array[Int] }
type Slot = Full(Cells) | Vacant
type Rack = { slots: [Slot] }

fn poke(r: Rack) : Unit / Mutable = match r.slots {
  [Full(c), ..._] -> { c.items[0] := 7 }
  _               -> ()
}

fn forward(r: Rack) : Unit = poke(r)

fn main() : Unit / Stdout + Mutable = {
  let c = Cells { items: array_make(1, 0) }
  forward(Rack { slots: [Full(c)] })
  Stdout.print("items[0]=#{c.items[0]}")
}
