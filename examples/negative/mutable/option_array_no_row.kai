# The caller's Array wrapped in an Option is still the caller's Array.

fn set_some(o: Option[Array[Int]]) : Unit / Mutable = match o {
  Some(a) -> { a[0] := 7 }
  None    -> ()
}

fn poke(a: Array[Int]) : Unit = set_some(Some(a))

fn main() : Unit / Stdout + Mutable = {
  let a = array_make(2, 0)
  poke(a)
  Stdout.print("a[0]=#{a[0]}")
}
