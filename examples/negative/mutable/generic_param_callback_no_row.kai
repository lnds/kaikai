# The caller's Array reaches the mutating callback through a generic
# parameter. `g` calls a closure it did not write, so the mutation is
# observable and `g` must declare `Mutable`.

fn g[t](x: t, f: (t) -> Unit / Mutable) : Unit = f(x)

fn poke(a: Array[Int]) : Unit / Mutable = g(a, (arr) => { arr[0] := 7 })

fn main() : Unit / Stdout + Mutable = {
  let a = array_make(2, 0)
  poke(a)
  Stdout.print("a[0]=#{a[0]}")
}
