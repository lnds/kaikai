# A user sum whose variant stores an Array carries the caller's cell.

type Holder = Hold(Array[Int]) | Empty

fn set_held(h: Holder) : Unit / Mutable = match h {
  Hold(a) -> { a[0] := 7 }
  Empty   -> ()
}

fn poke(a: Array[Int]) : Unit = set_held(Hold(a))

fn main() : Unit / Stdout + Mutable = {
  let a = array_make(2, 0)
  poke(a)
  Stdout.print("a[0]=#{a[0]}")
}
