# The caller's Arrays sit inside a list; a mutation reaching them
# through the list is observable.

fn h(xs: [Array[Int]], f: ([Array[Int]]) -> Unit / Mutable) : Unit = f(xs)

fn first_poke(xs: [Array[Int]]) : Unit / Mutable = match xs {
  [a, ..._] -> { a[0] := 7 }
  []        -> ()
}

fn main() : Unit / Stdout + Mutable = {
  let a = array_make(2, 0)
  h([a], first_poke)
  Stdout.print("a[0]=#{a[0]}")
}
