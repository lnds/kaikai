# A record reaching an Array only through two other user records still
# carries the caller's cell: forwarding it to a `/ Mutable` callee is
# observable.

type Cells = { items: Array[Int] }
type Shelf = { cells: Cells }
type Store = { shelf: Shelf }

fn poke(s: Store) : Unit / Mutable {
  s.shelf.cells.items[0] := 7
}

fn forward(s: Store) : Unit {
  poke(s)
}

fn main() : Unit / Stdout + Mutable = {
  let s = Store { shelf: Shelf { cells: Cells { items: array_make(1, 0) } } }
  forward(s)
  Stdout.print("items[0]=#{s.shelf.cells.items[0]}")
}
