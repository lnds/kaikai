# A piped call is the call it spells: `a |> set_first(7)` writes the
# parameter `a`, so the local write beside it cannot mask `Mutable`.

fn set_first(xs: Array[Int], v: Int) : Unit / Mutable = { xs[0] := v }

fn poke(a: Array[Int]) : Unit = {
  let scratch = array_make(1, 0)
  scratch[0] := 1
  a |> set_first(7)
}

fn main() : Unit / Stdout + Mutable = {
  let a = array_make(2, 0)
  poke(a)
  Stdout.print("a[0]=#{a[0]}")
}
