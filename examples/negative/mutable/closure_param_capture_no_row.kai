# A closure parameter mutates an Array it captured from the caller.
# Calling a closure the function did not write is observable, whatever
# arguments it gets.

fn g(n: Int, f: (Int) -> Unit / Mutable) : Unit = f(n)

fn poke(a: Array[Int]) : Unit / Mutable = g(0, (i) => { a[i] := 7 })

fn main() : Unit / Stdout + Mutable = {
  let a = array_make(2, 0)
  poke(a)
  Stdout.print("a[0]=#{a[0]}")
}
