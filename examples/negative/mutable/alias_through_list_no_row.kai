# A call that receives the caller's Arrays inside a list can hand one
# back; the result is not a fresh local cell.

fn head_of(xs: [Array[Int]]) : Array[Int] = match xs {
  [a, ..._] -> a
  []        -> array_make(1, 0)
}

fn poke(xs: [Array[Int]]) : Unit = {
  let a = head_of(xs)
  a[0] := 7
}

fn main() : Unit / Stdout + Mutable = {
  let a = array_make(2, 0)
  poke([a])
  Stdout.print("a[0]=#{a[0]}")
}
