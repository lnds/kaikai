# Both receives read the one `Actor[Request]` mailbox in the row, so the
# second cannot be typed `Reply`: a label that can only be its sibling
# shares the sibling's message type instead of being dropped unchecked.

type Request = Query(String)
type Reply   = Answer(String)

fn f() : String / Actor[Request] = {
  let _first: Request = Actor.receive()
  let second: Reply = Actor.receive()
  match second {
    Answer(s) -> s
  }
}

fn main() : Int / Console = 0
