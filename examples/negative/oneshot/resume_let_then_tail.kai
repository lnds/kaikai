# A clause that binds one `resume` and calls another in tail position:
# two calls on one path of a one-shot continuation, rejected at compile
# time.

effect Counter {
  tick() : Unit
}

fn main() : Int {
  let r = handle {
    Counter.tick()
    0
  } with Counter {
    tick(resume) -> {
      let _ = resume(())
      resume(())
    }
    return(x) -> x
  }
  r
}
