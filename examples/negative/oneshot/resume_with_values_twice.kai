# A clause that resumes twice with different values. The continuation is
# one-shot, so the compiler rejects the second call.

effect Io { ask() : Int }

fn main() : Int {
  handle {
    let a = Io.ask()
    a + 1
  } with Io {
    ask(resume) -> {
      let v = resume(7)
      resume(11)
    }
    return(x) -> x
  }
}
