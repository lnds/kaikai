# A clause that resumes twice on one path. The continuation is one-shot,
# and both calls lie on the same path, so the compiler rejects it.

effect Io { print_io(s: String) : Unit }

fn main() : Int {
  handle {
    Io.print_io("a")
    0
  } with Io {
    print_io(s, resume) -> {
      let _ = resume(())
      resume(())
    }
    return(x) -> x
  }
}
