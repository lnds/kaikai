# Two nested stages that both use `.` are ambiguous: the inner one is
# reported, and the author names one element with a lambda.

fn total(xs: [Int]) : Int = match xs {
  []           -> 0
  [h, ...rest] -> h + total(rest)
}

fn main() : Unit / Stdout = {
  let _ = [[1, 2], [3, 4]] | total(. | . + 1)
}
