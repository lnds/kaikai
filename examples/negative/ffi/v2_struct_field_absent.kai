# An `extern "C" type` declares its fields: reading one it does not
# declare is rejected where it is read.

extern "C" type Color = { r: U8, g: U8, b: U8, a: U8 }

extern "C"("make_gray")
fn make_gray(level: I32) : Color / Ffi

fn main() : Unit / Console + Ffi = {
  let g = make_gray(64)
  print(int_to_string(g.red))
}
