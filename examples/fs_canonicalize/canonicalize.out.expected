root ok 
link ok /real
through link ok /real/a.txt
up ok /real/a.txt
dangling err named=true reason=true
missing err named=true reason=true
dot absolute true
dotdot is parent true
relative parent true
normalize("") = "."
normalize("/") = "/"
normalize("//a//b/") = "/a/b"
normalize("a/./b") = "a/b"
normalize("a/../..") = ".."
normalize("/../a") = "/a"
normalize("a/b/../c") = "a/c"
normalize(".") = "."
normalize("..") = ".."
normalize("../a/..") = ".."
normalize("a/..") = "."
normalize("/a/..") = "/"
normalize("./") = "."
