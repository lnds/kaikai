import fs.file
import fs.path
import os.process
import path

fn sh(script: String) : Unit / Process {
  match process.wait(process.start("sh", ["-c", script])) {
    _ -> ()
  }
}

fn build(root: String) : Unit / Process {
  sh(
    "rm -rf #{root} && mkdir -p #{root}/real/sub && cd #{root} && echo x > real/a.txt && ln -s real link && ln -s nowhere dangling && ln -s .. real/up"
  )
}

fn show(root: String, label: String, r: Result[String, String]) : Unit / Stdout =
  match r {
    Ok(p) -> Stdout.print("#{label} ok #{string.drop_prefix(p, root) |> option.unwrap_or(p)}")
    Err(m) -> Stdout.print(
      "#{label} err named=#{string.contains(m, "/#{label}: ")} reason=#{string.contains(m, "No such file")} code=#{string.contains(m, " (os error ") and string.ends_with(m, ")")}"
    )
  }

fn norm(p: String) : Unit / Stdout = Stdout.print("normalize(\"#{p}\") = \"#{path.normalize(p)}\"")

fn main() : Int / Stdout + File + Process {
  let root0 = "/tmp/kai-fs-canonicalize-fixture"
  build(root0)
  let root = file.canonicalize(root0) |> result.unwrap_or(root0)

  show(root, "root", file.canonicalize(root0))
  show(root, "link", file.canonicalize("#{root0}/link"))
  show(root, "through link", file.canonicalize("#{root0}/link/sub/../a.txt"))
  show(root, "up", file.canonicalize("#{root0}/real/up/link/a.txt"))
  show(root, "dangling", file.canonicalize("#{root0}/dangling"))
  show(root, "missing", file.canonicalize("#{root0}/missing"))

  let here = file.canonicalize(".") |> result.unwrap_or("")
  Stdout.print("dot absolute #{path.is_absolute(here)}")
  Stdout.print("dotdot is parent #{file.canonicalize("..") == Ok(path.dirname(here))}")
  Stdout.print("relative parent #{file.canonicalize("../#{path.basename(here)}") == Ok(here)}")

  norm("")
  norm("/")
  norm("//a//b/")
  norm("a/./b")
  norm("a/../..")
  norm("/../a")
  norm("a/b/../c")
  norm(".")
  norm("..")
  norm("../a/..")
  norm("a/..")
  norm("/a/..")
  norm("./")
  0
}
