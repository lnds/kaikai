fn mk0(k: Int) : R0 = R0 { a: k, b: 0, next: None, rest: [] }
fn get0(r: R0) : Int = r.a
fn pair0(r: R0) : (R0, [R0]) = (r, r.rest)
fn opt0(r: R0) : Option[R0] = Some(r)
