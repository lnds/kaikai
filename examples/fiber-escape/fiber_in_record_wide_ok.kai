fn main() : Unit / Stdout + Spawn + Cancel {
  let h = Holds { s: from(0), r: mk3(1) }
  let j = Job { f: spawn.spawn(() => 5), r: mk5(2), next: None }
  println("#{get49(mk49(7))} #{nth(h.s, 3)} #{spawn.await(j.f)}")
}
