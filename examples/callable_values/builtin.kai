fn apply1(f: (Int) -> Int, a: Int) : Int = f(a)
fn apply2(f: (Int, Int) -> Int, a: Int, b: Int) : Int = f(a, b)
fn len_of(f: (String) -> Int, s: String) : Int = f(s)
fn name_of(f: (Int) -> String, n: Int) : String = f(n)

fn main() : Unit / Stdout {
  # lowered in place
  let x = bit_xor
  Stdout.print("#{x(6, 3)} #{apply2(bit_and, 12, 10)} #{apply1(bit_not, 0)}")
  Stdout.print("#{[0, 5] | bit_not}")
  [1, 2] |> foldl(0, bit_or) |> (n => Stdout.print("#{n}"))
  # backed by a runtime symbol
  let len = string_length
  Stdout.print("#{len("four")} #{len_of(string_length, "seven!!")}")
  Stdout.print("#{["a", "bcd"] | string_length}")
  Stdout.print(name_of(int_to_string, 42))
  [7, 8] | int_to_string |! Stdout.print
}
