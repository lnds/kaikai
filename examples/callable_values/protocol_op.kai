protocol Parse {
  parse(s: String) : Self
}

impl Parse for Int {
  fn parse(s: String) : Int = string_length(s)
}

impl Parse for Bool {
  fn parse(s: String) : Bool = string_length(s) > 2
}

type Color = Red | Green

impl Show for Color {
  fn show(c: Color) : String = match c { Red -> "red"  Green -> "green" }
}

fn apply_show(f: (Color) -> String, c: Color) : String = f(c)
fn parse_all[t](f: (String) -> t, xs: [String]) : [t] = map(xs, f)

fn main() : Unit / Stdout {
  # dispatched on the argument
  [Red, Green] | show |! Stdout.print
  Stdout.print(apply_show(show, Green))
  let sh = show
  Stdout.print(sh(Red))
  # dispatched on the result the context fixes
  let ns : [Int] = parse_all(parse, ["a", "bcd"])
  let bs : [Bool] = ["a", "bcd"] | parse
  let g : (String) -> Int = parse
  Stdout.print("#{ns} #{bs} #{g("xyzw")}")
}
