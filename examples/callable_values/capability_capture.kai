effect Cell {
  get() : Int
  put(n: Int) : Unit
}

fn call1(f: (Int) -> Unit, n: Int) : Unit = f(n)
fn call_get(f: () -> Int) : Int = f()
fn each_int(xs: [Int], f: (Int) -> Unit) : Unit = xs |! f
fn twice(c: Cell) : [Int] = [1, 2] | (n => { c.put(n); c.get() + n })

fn fill(c: Cell) : Int = {
  call1((n) => c.put(n), 1)
  each_int([2, 3], (n) => c.put(n))
  [4, 5] |! (n => c.put(n))
  call_get(() => c.get())
}

fn main() : Unit / Stdout {
  let r = handle {
    let xs = twice(a)
    fill(a) + length(xs)
  } with Cell as a {
    get(resume) -> resume(7)
    put(n, resume) -> { Stdout.print("put #{n}"); resume(()) }
  }
  Stdout.print("r=#{r}")
}
