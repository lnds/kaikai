effect Cell {
  get() : Int
  put(n: Int) : Unit
}

fn each_int(xs: [Int], f: (Int) -> Unit) : Unit = xs |! f
fn each_eff(xs: [Int], f: (Int) -> Unit / e) : Unit / e = xs |! f

fn fill(c: Cell) : Int = {
  [1, 2] |! c.put
  each_int([3], c.put)
  let p = c.put
  p(4)
  let g = c.get
  g()
}

fn main() : Unit / Stdout {
  let r = handle {
    let seen = a.get
    a.put(seen() + 10)
    [20] |! a.put
    each_eff([21], a.put)
    fill(a) + seen()
  } with Cell as a {
    get(resume) -> resume(7)
    put(n, resume) -> { Stdout.print("put #{n}"); resume(()) }
  }
  Stdout.print("r=#{r}")
}
