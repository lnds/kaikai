fn keep(xs: [String]) : [String] =
  xs |> foldl([], (acc, x) => if x == "" { acc } else { acc ++ [x] })

fn glue(xs: [String]) : String =
  xs |> foldl("", (acc, x) => if x == "" { acc } else { acc ++ x })

fn main() : Unit / Stdout {
  Stdout.print("#{length(keep(["a", "", "b"]))}")
  Stdout.print(glue(["a", "", "b"]))
}
