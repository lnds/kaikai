type Box = Box(String)
type Pair = Pair(Int, Int)

fn show_box(b: Box) : String = match b { Box(s) -> s }
fn show_pair(p: Pair) : String = match p { Pair(a, b) -> "#{a},#{b}" }

fn apply1(f: (String) -> Box, s: String) : Box = f(s)
fn apply2(f: (Int, Int) -> Pair, a: Int, b: Int) : Pair = f(a, b)

fn main() : Unit / Stdout {
  ["a", "b"] | Box |! (b => Stdout.print(show_box(b)))
  Stdout.print(show_box(apply1(Box, "user hof")))
  let mk = Pair
  Stdout.print(show_pair(mk(1, 2)))
  Stdout.print(show_pair(apply2(Pair, 3, 4)))
  [5, 6] | Some |! (o => Stdout.print("#{o}"))
}
