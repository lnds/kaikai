effect Log {
  note(s: String) : Unit
  join(a: Int, b: Int) : Int
}

fn each_str(xs: [String], f: (String) -> Unit / e) : Unit / e = xs |! f
fn fold_pair(f: (Int, Int) -> Int / e, a: Int, b: Int) : Int / e = f(a, b)

fn print_all(xs: [String]) : Unit / Stdout = xs |! Stdout.print
fn via_each() : Unit / Stdout = each(["each"], Stdout.print)
fn via_hof() : Unit / Stdout = each_str(["hof"], Stdout.print)
fn via_let() : Unit / Stdout = {
  let p = Stdout.print
  p("let")
}

fn body() : Int / Log {
  ["a", "b"] |! Log.note
  each_str(["c"], Log.note)
  let n = Log.note
  n("d")
  let j = Log.join
  j(1, 2) + fold_pair(Log.join, 3, 4)
}

fn main() : Unit / Stdout {
  print_all(["pipe"])
  via_each()
  via_hof()
  via_let()
  let r = handle { body() } with Log {
    note(s, resume) -> { Stdout.print("note #{s}"); resume(()) }
    join(a, b, resume) -> resume(a + b)
  }
  Stdout.print("r=#{r}")
}
