extern "js"("Math.hypot") fn hypot(a: Real, b: Real) : Real / Js

extern "js"("Number.isFinite") fn is_finite(x: Real) : Bool / Js

extern "js"("parseInt") fn parse_int(s: String) : Int / Js

extern "js"("encodeURIComponent") fn encode(s: String) : String / Js

fn main() : Unit / Stdout + Js {
  Stdout.print("#{hypot(3.0, 4.0)}")
  Stdout.print("#{is_finite(1.5)}")
  Stdout.print("#{parse_int("123") + 1}")
  Stdout.print(encode("á b"))
}
