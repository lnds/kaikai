import web.dom
import web.run

fn main() : Unit / Stdout + Js + Ffi + Clock + Mutable =
  run.run(() => {
    let canvas = Dom.create("canvas")
    Dom.set_attr(canvas, "width", "20")
    Dom.set_attr(canvas, "height", "20")
    let c = Dom.context_2d(canvas)
    Dom.set_fill_style(c, "#ff0000")
    Dom.fill_rect(c, 0, 0, 10, 10)
    let img = Dom.new_image(2, 2)
    Dom.set_pixel(img, 0, 0x00ff00ff)
    Dom.set_pixel(img, 3, 0x0000ffff)
    Dom.put_image_data(c, img, 10, 10)
    let buf = array_make(8, 0u8)
    buf[0] := 255u8
    buf[2] := 255u8
    buf[3] := 255u8
    buf[5] := 255u8
    buf[6] := 255u8
    buf[7] := 255u8
    Dom.put_pixels(c, buf, 2, 1, 0, 15)
    let px = Dom.get_image_data(c, 0, 0, 20, 20)
    Stdout.print("red:   #{Dom.get_pixel(px, 5 * 20 + 5)}")
    Stdout.print("empty: #{Dom.get_pixel(px, 5 * 20 + 15)}")
    Stdout.print("green: #{Dom.get_pixel(px, 10 * 20 + 10)}")
    Stdout.print("blue:  #{Dom.get_pixel(px, 11 * 20 + 11)}")
    Stdout.print("bytes: #{Dom.get_pixel(px, 15 * 20)} #{Dom.get_pixel(px, 15 * 20 + 1)}")
  })
