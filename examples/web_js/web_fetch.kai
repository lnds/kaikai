import encoding.json
import encoding.json_bind
import web.dom
import web.fetch
import web.run

fn describe(v: json_bind.JsonValue) : String {
  let title = json.as_string(json.get(v, "title")) ?? "?"
  let first = json.as_int(json.at(json.get(v, "items"), 0)) ?? 0
  "#{title} #{first}"
}

fn main() : Unit / Stdout + Js + Ffi + Clock =
  run.run(() => {
    match fetch.get_json("fetch_data.json") {
      Ok(v) -> {
        let line = describe(v)
        let body = Dom.query("body") ?? Dom.create("body")
        let p = Dom.create("p")
        Dom.set_text(p, line)
        Dom.append(body, p)
        Stdout.print("rendered: #{line}")
      }
      Err(e) -> Stdout.print("failed: #{e}")
    }
    Stdout.print("missing: #{fetch.status("missing.json")}")
  })
