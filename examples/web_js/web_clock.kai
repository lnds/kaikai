import web.dom
import web.run
import web.timer

fn ticks(n: Int) : Unit / Dom + Stdout {
  if n > 0 {
    let e = Dom.next_event()
    if e.kind == "tick" {
      Stdout.print("tick #{4 - n}")
      ticks(n - 1)
    } else {
      ticks(n)
    }
  } else {
    ()
  }
}

fn main() : Unit / Stdout + Js + Ffi + Clock =
  run.run(() => {
    let t0 = Timer.now_ms()
    Timer.every(30, "tick")
    ticks(3)
    Timer.sleep_ms(20)
    let frame = Timer.animation_frame()
    Stdout.print("clock moved: #{Timer.now_ms() > t0}")
    Stdout.print("frame stamped: #{frame > 0.0}")
  })
