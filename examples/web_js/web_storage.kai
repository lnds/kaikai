import web.run
import web.storage

fn show(label: String, v: Option[String]) : Unit / Stdout =
  match v {
    Some(s) -> Stdout.print("#{label}: #{s}")
    None -> Stdout.print("#{label}: none")
  }

fn main() : Unit / Stdout + Js + Ffi + Clock =
  run.run(() => {
    show("before", Storage.get("kai.test"))
    Storage.set("kai.test", "hello")
    show("after set", Storage.get("kai.test"))
    Storage.remove("kai.test")
    show("after remove", Storage.get("kai.test"))
  })
