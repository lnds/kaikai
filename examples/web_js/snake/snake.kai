import web.dom
import web.run
import web.timer

extern "js"("location.search") fn search() : String / Js

const W : Int = 20

const H : Int = 20

const CELL : Int = 10

type Game = { body: [(Int, Int)], dir: (Int, Int), food: (Int, Int), score: Int, seed: Int }

fn lcg(s: Int) : Int = (s * 1103515245 + 12345) % 2147483648

fn place(seed: Int, body: [(Int, Int)]) : ((Int, Int), Int) {
  let s = lcg(seed)
  let p = (s / 7 % W, s / 131 % H)
  if contains(body, p) { place(s, body) } else { (p, s) }
}

fn fresh() : Game =
  Game { body: [(5, 5), (4, 5), (3, 5)], dir: (1, 0), food: (8, 5), score: 0, seed: 1 }

fn head_of(g: Game) : (Int, Int) = list.head(g.body) ?? ((0, 0))

fn hit(g: Game, p: (Int, Int)) : Bool =
  p.fst < 0 or p.fst >= W or p.snd < 0 or p.snd >= H or contains(g.body, p)

fn step(g: Game) : Option[Game] {
  let h = head_of(g)
  let p = (h.fst + g.dir.fst, h.snd + g.dir.snd)
  if hit(g, p) {
    None
  } else if p == g.food {
    let body = [p, ...g.body]
    let next = place(g.seed, body)
    Some(Game { ...g, body: body, food: next.fst, seed: next.snd, score: g.score + 1 })
  } else {
    Some(Game { ...g, body: [p, ...list.take(g.body, list.length(g.body) - 1)] })
  }
}

fn turn(g: Game, key: String) : Game {
  let d = match key {
    "ArrowUp" -> (0, -1)
    "ArrowDown" -> (0, 1)
    "ArrowLeft" -> (-1, 0)
    "ArrowRight" -> (1, 0)
    _ -> g.dir
  }
  if d.fst + g.dir.fst == 0 and d.snd + g.dir.snd == 0 { g } else { Game { ...g, dir: d } }
}

fn cell(c: Ctx2d, p: (Int, Int), css: String) : Unit / Dom {
  Dom.set_fill_style(c, css)
  Dom.fill_rect(c, p.fst * CELL, p.snd * CELL, CELL, CELL)
}

fn draw(c: Ctx2d, g: Game) : Unit / Dom {
  Dom.clear_rect(c, 0, 0, W * CELL, H * CELL)
  cell(c, g.food, "#d33")
  g.body |> each(p => cell(c, p, "#2a5"))
}

fn report(g: Game) : Unit / Stdout {
  let h = head_of(g)
  Stdout.print("tick head=#{h.fst},#{h.snd} len=#{list.length(g.body)} score=#{g.score}")
}

fn play(c: Ctx2d, g: Game) : Unit / Dom + Stdout {
  let e = Dom.next_event()
  if e.kind == "keydown" {
    play(c, turn(g, e.key))
  } else if e.kind == "tick" {
    match step(g) {
      Some(n) -> {
        draw(c, n)
        report(n)
        play(c, n)
      }
      None -> {
        Stdout.print("game over score=#{g.score}")
        restart(c)
      }
    }
  } else {
    play(c, g)
  }
}

fn restart(c: Ctx2d) : Unit / Dom + Stdout {
  let e = Dom.next_event()
  if e.kind == "keydown" and e.key == "Enter" {
    let g = fresh()
    draw(c, g)
    Stdout.print("start")
    play(c, g)
  } else {
    restart(c)
  }
}

fn tick_ms() : Int / Js = string.to_int(string.drop_prefix(search(), "?ms=") ?? "") ?? 120

fn main() : Unit / Stdout + Js + Ffi + Clock =
  run.run(() => {
    let body = Dom.query("body") ?? Dom.create("body")
    let canvas = Dom.create("canvas")
    Dom.set_attr(canvas, "width", "#{W * CELL}")
    Dom.set_attr(canvas, "height", "#{H * CELL}")
    Dom.set_style(canvas, "border", "1px solid #888")
    Dom.append(body, canvas)
    Dom.listen(body, "keydown")
    Dom.listen(body, "tick")
    Timer.every(tick_ms(), "tick")
    let c = Dom.context_2d(canvas)
    let g = fresh()
    draw(c, g)
    Stdout.print("start")
    play(c, g)
  })
