import web.dom
import web.run

fn count_clicks(label: Node, n: Int) : Unit / Dom + Stdout {
  let e = Dom.next_event()
  if e.kind == "click" {
    let m = n + 1
    Dom.set_text(label, "clicks: #{m}")
    Stdout.print("clicks: #{m}")
    count_clicks(label, m)
  } else {
    count_clicks(label, n)
  }
}

fn main() : Unit / Stdout + Js + Ffi + Clock =
  run.run(() => {
    let body = Dom.query("body") ?? Dom.create("body")
    let button = Dom.create("button")
    Dom.set_attr(button, "id", "counter")
    Dom.set_text(button, "clicks: 0")
    Dom.append(body, button)
    Dom.listen(button, "click")
    Stdout.print("ready")
    count_clicks(button, 0)
  })
