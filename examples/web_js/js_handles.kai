extern "js" opaque Node

extern "js"("document.createElement") fn create(tag: String) : Node / Js

extern "js"(".textContent=") fn set_text(n: Node, s: String) : Unit / Js

extern "js"(".textContent") fn text(n: Node) : String / Js

extern "js"(".appendChild") fn append(parent: Node, child: Node) : Unit / Js

extern "js"("kai.handles") fn live() : Int / Js

fn make(i: Int) : Unit / Js {
  let n = create("div")
  set_text(n, "node #{i}")
}

fn loop(i: Int) : Unit / Js =
  if i < 10000 {
    make(i)
    loop(i + 1)
  } else {
    ()
  }

fn main() : Unit / Stdout + Js {
  let parent = create("section")
  let child = create("p")
  set_text(child, "child")
  append(parent, child)
  Stdout.print(text(child))
  loop(0)
  Stdout.print("live: #{live()}")
}
