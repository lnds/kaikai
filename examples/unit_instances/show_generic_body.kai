unit m
unit s

fn show_it[T: Show](x: T) : String = "<#{x}>"

fn max_of[T: Ord](a: T, b: T) : T = if a > b { a } else { b }

fn main() : Unit / Stdout = {
  println(show_it(1.5))
  println(show_it(1.5<m>))
  println(show_it(2.5<s>))
  println(show_it(3<m>))
  println(show_it(3))
  println(show_it(max_of(1.0, 2.0)))
  println(show_it(max_of(1.0<m>, 2.0<m>)))
}
