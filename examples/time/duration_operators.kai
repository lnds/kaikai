import time

fn show_d(d: Duration) : String = "#{d.secs}s+#{d.nanos}ns"

fn main() : Unit / Stdout = {
  let a = time.nanos_to_duration(1_500_000_000)
  let b = time.nanos_to_duration(700_000_000)
  Stdout.print(show_d(a + b))
  Stdout.print(show_d(b - a))
  Stdout.print(show_d(a * 3))
  Stdout.print(show_d(a / 2))
  Stdout.print(show(a == a))
  Stdout.print(show(a == b))
  Stdout.print(show(b < a))
  Stdout.print(show(a <= b))
  Stdout.print(show_d(time.duration_add(a, b)))
}
