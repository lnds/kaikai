import spawn

fn slow(n: Int, acc: Int) : Int = if n == 0 { acc } else { slow(n - 1, acc + n % 7) }

const BASE : [Int] = [slow(300000, 0), slow(1000, 1), 3]

const NAMES : [String] = ["a", "b", "c"]

const TOTAL : Int = slow(200000, list.length(BASE))

fn read(k: Int, acc: Int) : Int = if k == 0 {
  acc
} else {
  read(k - 1, acc + TOTAL % 997 + list.length(NAMES) + list.length(BASE))
}

fn main() : Unit / Spawn + Stdout {
  let sums = nursery { n ->
    let fibers = [1, 2, 3, 4, 5, 6, 7, 8] | (i => n.spawn(() => read(1000 * i, 0)))
    fibers | (f => n.await(f))
  }
  Stdout.print("#{sums}")
}
