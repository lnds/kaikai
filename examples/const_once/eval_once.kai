fn slow(n: Int, acc: Int) : Int = if n == 0 { acc } else { slow(n - 1, acc + n % 7) }

fn inc(x: Int) : Int = x + 1

const TABLE : Int = slow(1000000, 0)

const PAIR : [Int] = [TABLE, slow(1000, 0)]

const STEPS : [(Int) -> Int] = [inc, y => y * 2]

const MASK : Int = 1 + 2 * 8

fn reads(k: Int, acc: Int) : Int = if k == 0 {
  acc
} else {
  reads(k - 1, acc + TABLE % 3 + list.length(PAIR))
}

fn main() : Unit / Stdout {
  Stdout.print("#{reads(200000, 0)}")
  Stdout.print("#{list.length(STEPS)} #{MASK}")
}
