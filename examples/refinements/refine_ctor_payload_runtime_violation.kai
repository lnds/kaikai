# A constructor has no body to check its payload on entry, so the call
# checks it.
type Pos = Real where self > 0.0
type Reading = Sample(Pos) | Missing

fn neg(x: Real) : Real = 0.0 - x

fn main() : Unit / Stdout {
  let r = Sample(neg(5.0))
  match r {
    Sample(x) -> Stdout.print(real_to_string(x))
    Missing   -> Stdout.print("missing")
  }
}
