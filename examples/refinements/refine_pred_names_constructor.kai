# A predicate that names a constructor is the same predicate wherever its
# type is written: the parameter's and the result's `self != None` are
# one, so `keep` returns what it took with no check of its own, and the
# inline form on `also` is that predicate too.
type Present = Option[Int] where self != None

fn keep(x: Present) : Present = x

fn also(x: Option[Int] where self != None) : Present = x

fn main() : Unit / Stdout = {
  let p : Present = Some(4)
  match also(keep(p)) {
    Some(n) -> Stdout.print("#{n}")
    None    -> Stdout.print("none")
  }
}
