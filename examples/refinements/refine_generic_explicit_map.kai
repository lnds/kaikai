# Mapping through a function that returns the refined type is the
# explicit way into a refined container, by call, method or pipe.
type Pos = Int where self > 0

fn ints() : [Int] = [0 - 1, 2]

fn to_pos(n: Int) : Pos = if n > 0 { n } else { 1 }

fn main() : Unit / Stdout {
  let a: [Pos] = map(ints(), to_pos)
  let b: [Pos] = ints().map((n) => to_pos(n * 3))
  let c: [Pos] = ints() |> map(to_pos)
  let d: [Pos] = a.reverse()
  let e: [Pos] = filter(b, (x) => x > 1)
  Stdout.print(int_to_string(foldl(a, 0, (s, x) => s + x)))
  Stdout.print(int_to_string(list_length(b) + list_length(c) + list_length(d) + list_length(e)))
}
