# The `required:` line prints the predicate as written, whatever
# expression forms it uses: field access, calls, indexing.

type Cuenta = { saldo: Int }

fn cubre(c: Cuenta, monto: Int) : Bool = c.saldo >= monto

fn retirar(c: Cuenta, monto: Int, topes: Array[Int]) : Int
  requires cubre(c, topes[0]) and c.saldo >= monto
= c.saldo - monto

fn main() : Unit / Stdout + Env {
  let n = list.length(Env.args())
  let topes = array.from([50])
  println("#{retirar(Cuenta { saldo: 100 + n }, 101 + n, topes)}")
}
