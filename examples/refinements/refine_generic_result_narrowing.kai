# A `Result[Int, E]` passed where a `Result[Pos, E]` is expected is
# rejected at the call.
type Pos = Int where self > 0

fn parse() : Result[Int, String] = Ok(0 - 1)

fn show_pos(r: Result[Pos, String]) : String = match r {
  Ok(p)  -> int_to_string(p)
  Err(e) -> e
}

fn main() : Unit / Stdout {
  Stdout.print(show_pos(parse()))
}
