# A computed value stored in a refined record field is checked before
# the record is built.
type Pos = Real where self > 0.0
type Account = { owner: String, balance: Pos }

fn neg(x: Real) : Real = 0.0 - x

fn main() : Unit / Stdout {
  let a = Account { owner: "ana", balance: neg(5.0) }
  Stdout.print(real_to_string(a.balance))
}
