# A method call whose arguments satisfy the contract compiles, checked as
# the prefix call it spells.
fn div(a: Int, b: Int) : Int requires b > 5 { a / b }

fn mydiv(a: Int, b: Int) : Int requires b != 0 { a / b }

fn main() : Unit / Stdout = {
  Stdout.print("#{60.div(6)}")
  Stdout.print("#{10.mydiv(2)}")
  Stdout.print("#{10.id_or(1).mydiv(5)}")
}

fn id_or(x: Int, d: Int) : Int = if x == 0 { d } else { x }
