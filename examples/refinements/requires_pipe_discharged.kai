# Pipes, placeholders, constants and method calls that satisfy a contract
# compile: the piped value or the receiver is the first argument, so
# `5 |> first(0)` binds `a` to 5 and `10.div(6)` reaches this `div`.
const TWO : Int = 2

fn div(a: Int, b: Int) : Int requires b > 5 { a / b }

fn half(a: Int, b: Int) : Int requires b != 0 { a / b }

fn first(a: Int, b: Int) : Int requires a != 0 { a + b }

fn main() : Unit / Stdout = {
  Stdout.print("#{10 |> half(2)}")
  Stdout.print("#{2 |> half(10, _)}")
  Stdout.print("#{10 |> half(TWO)}")
  Stdout.print("#{5 |> first(0)}")
  Stdout.print("#{10.div(6)}")
  Stdout.print("#{60 |> div(6)}")
}
