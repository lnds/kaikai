# A value whose type already carries the predicate flows into a refined
# position with no check: `relay` copies a `Pos` field into a `Pos`
# field, and `open` checks its `Pos` parameter once, on entry.
type Pos = Real where self > 0.0
type Account = { owner: String, balance: Pos }

fn open(owner: String, p: Pos) : Account = Account { owner: owner, balance: p }

fn relay(a: Account) : Account = Account { owner: "bob", balance: a.balance }

fn main() : Unit / Stdout {
  Stdout.print(real_to_string(relay(open("ana", 2.0)).balance))
}
