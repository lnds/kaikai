# A checked value is evaluated exactly once, in source order.
type Pos = Real where self > 0.0
type Account = { owner: String, balance: Pos }

fn traced(label: String, x: Real) : Real / Stdout = {
  Stdout.print(label)
  x
}

fn main() : Unit / Stdout {
  let a = Account { owner: { Stdout.print("owner"); "ana" }, balance: traced("balance", 3.0) }
  let xs: [Pos] = [traced("first", 1.0), traced("second", 2.0)]
  Stdout.print(real_to_string(a.balance))
  Stdout.print(int_to_string(list_length(xs)))
}
