# `self` inside a refinement is the value the type constrains, whatever
# the scope around the type calls `self`: a parameter of that name, or a
# local one.
fn area(self: Int, n: Int where self > 0) : Int = self * n

fn main() : Unit / Stdout = {
  let self = 0 - 5
  let k : Int where self > 0 = 7
  Stdout.print("#{area(0 - 2, 3)} #{k + self}")
}
