# Contract clauses are part of the signature and independent of how the
# body is spelled: `= expr` and `{ ... }` both accept `requires` /
# `ensures`, alone or combined, on one line or split across lines.

fn a(n: Int) : Int requires n > 0 = n + 1

fn b(n: Int) : Int requires n > 0 { n + 1 }

fn c(n: Int) : Int ensures result > 0 = n + 1

fn d(n: Int) : Int ensures result > 0 { n + 1 }

fn e(n: Int) : Int requires n > 0 ensures result > 1 = n + 1

fn f(n: Int) : Int requires n > 0 ensures result > 1 { n + 1 }

fn g(n: Int) : Int
  requires n > 0
{
  n + 1
}

fn main() : Unit / Stdout =
  Stdout.print("#{a(1)} #{b(1)} #{c(1)} #{d(1)} #{e(1)} #{f(1)} #{g(1)}")
