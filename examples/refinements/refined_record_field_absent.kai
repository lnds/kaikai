# A field a refined record does not declare is rejected where it is read.

type Span = { lo: Int, hi: Int }

fn ordered(s: Span) : Bool = s.lo <= s.hi

type Ordered = Span where ordered(self)

fn width(s: Ordered) : Int = s.hi - s.low

fn main() : Unit / Stdout = Stdout.print("#{width(Span { lo: 2, hi: 9 })}")
