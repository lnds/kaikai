# An argument that spells another parameter's name is that argument, not
# the parameter: `apart(b, 0)` binds `a` to the caller's `b`, which is 3.
fn apart(a: Int, b: Int) : Int requires a != b { a - b }

fn from_b(b: Int) : Int = apart(b, 0)

fn from_lambda(y: Int) : Int = ((x, y) => apart(x, y))(y, 2)

fn main() : Unit / Stdout = {
  Stdout.print("#{from_b(3)}")
  Stdout.print("#{from_lambda(3)}")
}
