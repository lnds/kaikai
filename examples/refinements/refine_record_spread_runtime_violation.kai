# A field overridden after a spread is checked; the fields copied from
# the spread source already hold their refinement.
type Pos = Real where self > 0.0
type Account = { owner: String, balance: Pos }

fn neg(x: Real) : Real = 0.0 - x

fn main() : Unit / Stdout {
  let a = Account { owner: "ana", balance: 1.0 }
  let b = Account { ...a, balance: neg(5.0) }
  Stdout.print(real_to_string(b.balance))
}
