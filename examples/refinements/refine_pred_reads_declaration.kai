# A refinement's predicate names a function of the file that declares
# the type. A parameter spelled like it, where the type is used, is
# another thing; and a check planted on a binding or a return still
# calls the function.
type Small = Int where small_enough(self)

fn small_enough(n: Int) : Bool = n < 10

fn offset(small_enough: Int, x: Small) : Int = x + small_enough

fn narrow(n: Int) : Small = n

fn main() : Unit / Stdout = {
  let y : Small = narrow(4)
  Stdout.print("#{offset(1, 3)} #{narrow(5)} #{y}")
}
