# A postcondition on the result fails on the final value of a cycle through a closure: the resolver reports it as a non-tail call does.

type Hop = { step: (Hop, Int) -> Int, last: (Int) -> Int }

fn ck_neg(h: Hop, n: Int) : Int
  ensures result >= 0
{
  if n == 0 { h.last(0) } else { h.step(h, n - 1) }
}

fn main() : Unit / Stdout = {
  let h = Hop { step: (self, n) => ck_neg(self, n), last: (n) => n - 1 }
  Stdout.print("#{ck_neg(h, 100000000)}")
}
