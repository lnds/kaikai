# A literal is checked element by element; a generic call keeps the
# refinement its arguments share and drops the one they do not.
type Pos = Int where self > 0
type Neg = Int where self < 0

fn pair[T](a: T, b: T) : [T] = [a, b]

fn main() : Unit / Stdout {
  let xs: [Pos] = [1, 2, 3]
  let rs: [Pos] = list_reverse(xs)
  let o: Option[Pos] = Some(7)
  let p: Pos = 4
  let n: Neg = 0 - 4
  let same: [Pos] = pair(p, p)
  let mixed: [Int] = pair(p, n)
  Stdout.print(int_to_string(list_length(rs) + list_length(same) + list_length(mixed)))
  Stdout.print(match o { Some(v) -> int_to_string(v)  None -> "none" })
}
