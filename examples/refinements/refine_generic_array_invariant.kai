# An array is mutable, so `Array[Pos]` does not widen to `Array[Int]`:
# a write through the wider view would break the narrower one.
type Pos = Int where self > 0

fn main() : Unit / Stdout {
  let p: Pos = 1
  let a: Array[Pos] = array_make(2, p)
  let b: Array[Int] = a
  Stdout.print(int_to_string(array_length(b)))
}
