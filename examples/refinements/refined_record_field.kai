# A refined record is still that record: its fields are read at their
# declared types.

type Span = { lo: Int, hi: Int }

fn ordered(s: Span) : Bool = s.lo <= s.hi

type Ordered = Span where ordered(self)

fn width(s: Ordered) : Int = s.hi - s.lo

fn main() : Unit / Stdout = {
  let s : Ordered = Span { lo: 2, hi: 9 }
  Stdout.print("width=#{width(s)} lo=#{s.lo}")
}
