# A literal payload refuting a constructor's refined field is rejected
# at compile time.
type Pos = Real where self > 0.0
type Reading = Sample(Pos) | Missing

fn main() : Unit / Stdout {
  let r = Sample(-5.0)
  match r {
    Sample(x) -> Stdout.print(real_to_string(x))
    Missing   -> Stdout.print("missing")
  }
}
