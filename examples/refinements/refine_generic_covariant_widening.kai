# Immutable containers widen: a `[Pos]` is an `[Int]`, an `Option[Pos]`
# an `Option[Int]`, and a function on any `Int` stands in for one on
# `Pos`.
type Pos = Int where self > 0

fn total(xs: [Int]) : Int = foldl(xs, 0, (acc, x) => acc + x)

fn double(x: Int) : Int = x * 2

fn twice(f: (Pos) -> Int, x: Pos) : Int = f(x) + f(x)

fn main() : Unit / Stdout {
  let xs: [Pos] = [1, 2, 3]
  let ws: [Int] = xs
  let o: Option[Pos] = Some(4)
  let oi: Option[Int] = o
  let r: Result[Pos, String] = Ok(5)
  let ri: Result[Int, String] = r
  Stdout.print(int_to_string(total(ws) + total(xs)))
  Stdout.print(match oi { Some(v) -> int_to_string(v)  None -> "none" })
  Stdout.print(match ri { Ok(v) -> int_to_string(v)  Err(e) -> e })
  Stdout.print(int_to_string(twice(double, 3)))
}
