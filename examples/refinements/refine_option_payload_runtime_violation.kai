# Under an `Option[Pos]` annotation, a computed `Some` payload is checked.
type Pos = Real where self > 0.0

fn neg(x: Real) : Real = 0.0 - x

fn main() : Unit / Stdout {
  let o: Option[Pos] = Some(neg(1.0))
  match o {
    Some(x) -> Stdout.print(real_to_string(x))
    None    -> Stdout.print("none")
  }
}
