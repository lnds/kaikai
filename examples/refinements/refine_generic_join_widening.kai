# A type variable bound from a `Pos` and a `Neg` takes their join, `Int`;
# the mismatch names the argument that widened it.
type Pos = Int where self > 0
type Neg = Int where self < 0

fn pair[T](a: T, b: T) : [T] = [a, b]

fn main() : Unit / Stdout {
  let p: Pos = 1
  let n: Neg = 0 - 1
  let ys: [Pos] = pair(p, n)
  Stdout.print(int_to_string(list_length(ys)))
}
