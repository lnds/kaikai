# `length` is declared by two cores. Called on the refined value, it is
# the one that takes the refined type, in every copy of the predicate;
# called on a call, the one that takes what that function returns.
type Filled = [Int] where length(self) > 0

type Paired = [Int] where length(reverse(self)) > 1

fn keep(xs: Filled) : Filled = xs

fn both(xs: Paired) : Paired = xs

fn first(xs: Filled) : Int = match xs {
  [x, ..._] -> x
  []        -> 0
}

fn main() : Unit / Stdout = {
  let xs : Filled = [7, 8]
  let ys : Paired = [5, 6]
  Stdout.print("#{first(keep(xs))} #{length(both(ys))}")
}
