# A literal stored in a refined record field is rejected at compile
# time, as it is when bound to a refined `let`.
type Pos = Real where self > 0.0
type Account = { owner: String, balance: Pos }

fn main() : Unit / Stdout {
  let a = Account { owner: "ana", balance: -5.0 }
  Stdout.print(real_to_string(a.balance))
}
