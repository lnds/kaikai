import c1
import c2

# Two clause-block functions in one file whose arms spell the same two
# constructor names against different homes. The clause symbol carries the
# enclosing function on one backend and not the other, so the pair has to
# stay apart in both.
fn one(s: c1.S1) : String {
  case c1.Go(n) -> "1:#{n}"
  case c1.Stop  -> "1:stop"
}

fn two(s: c2.S2) : String {
  case c2.Go(v) -> "2:#{v}"
  case c2.Stop  -> "2:stop"
}

fn main() : Unit / Stdout =
  Stdout.print("#{one(c1.Go(4))} #{two(c2.Go("x"))} #{one(c1.Stop)} #{two(c2.Stop)}")
