import pa
import pb

# Both homes across two axioms, and one axiom carrying both in a single
# signature: the return position respells on the same walk as the
# parameters, and nothing but the qualifier decides which home wins.
axiom from_a(c: pa.Cfg) : Int
axiom from_b(c: pb.Cfg) : Int
axiom both(a: pa.Cfg, b: pb.Cfg) : pa.Cfg

fn main() : Unit / Stdout = Stdout.print("#{pa.mk().v}#{pb.mk().s}")
