# The receiver's type is not known where the operation is written, and
# the rest of the declaration fixes it: a lambda's parameter by the call
# of the lambda, the operation read as a value by what it is applied to.
import pa
import pb

fn main() : Unit / Stdout = {
  let shown = (x) => render(x)
  let f = render
  Stdout.print("#{shown(pa.A(1))} #{f(pb.B(2))} #{map([pb.B(3), pb.B(4)], render)}")
}
