import dbase
import dleft
import dright

# The apex type reaches main through BOTH branches, each of which also
# has its own `Err`/`Failure`/`Clean` with a different payload. The
# existing fixture routes through a fourth module; here the two branch
# values and the apex value meet in one expression, so the join is where
# the homes must stay apart.
fn show(e: dbase.Err) : String = match e {
  dbase.Failure(m) -> "base:#{m}"
  dbase.Clean      -> "base:clean"
}

fn main() : Unit / Stdout = {
  let viaL = show(dleft.lift("x"))
  let viaR = show(dright.lift(true))
  let l = match dleft.own(1)     { dleft.Failure(n) -> "left:#{n}"   dleft.Clean -> "left:clean" }
  let r = match dright.own(false){ dright.Failure(b) -> "right:#{b}" dright.Clean -> "right:clean" }
  Stdout.print("#{viaL} #{viaR} #{l} #{r} #{show(dbase.Clean)}")
}
