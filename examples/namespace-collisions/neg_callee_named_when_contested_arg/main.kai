# The argument-mismatch arrangement: the note that places the mismatch
# names `ca.widen` under its module, since `cb` declares a `widen` too,
# and `solo` plainly, since nothing else declares one.
import ca
import cb

fn main() : Unit / Stdout = {
  let a = ca.widen("one", 2)
  let b = solo("two")
  Stdout.print("#{a + b + cb.widen(1)}")
}
