import guard
import core

# `guard.Cancel` is a user effect; the fiber-local core `Cancel` fires
# beneath it in the same fiber. The qualified handler head selects the
# user's effect, and the core `raise` must reach the core handler, not
# the user's evidence node.
fn main() : Unit / Stdout = {
  let out = handle { guard.stop("x"); "user-cancel #{core.worker()}" } with guard.Cancel {
    abort(why, resume) -> resume(())
    return(x) -> x
  }
  Stdout.print(out)
}
