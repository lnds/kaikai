# Opening `shapes` makes a bare `Decimal` name `shapes.Decimal`: an
# import outranks the carrier every file reads without one. A `d`
# literal is still the stdlib carrier.
import shapes

fn show_d(d: Decimal) : String = match d {
  Tenths(n) -> "t#{n}"
  Whole(n)  -> "w#{n}"
}

fn main() : Unit / Stdout = {
  Stdout.print(show_d(tenths(5)))
  let lit = 2.50d
  Stdout.print(int_to_string(lit.scale))
}
