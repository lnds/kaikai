import ma
import mb

# The constructor sits inside a list or tuple pattern; the element type
# is still fixed by the signature, so the bare spelling is as determined
# as it is at the top of an arm.
pub fn sum_a(xs: [ma.A]) : Int = match xs {
  [] -> 0
  [Tok(a, b), ...rest] -> a + b + sum_a(rest)
}

pub fn cross(a: ma.A, b: mb.B) : Int = match (a, b) { (Tok(x, _), Tok(_, y)) -> x * y }
