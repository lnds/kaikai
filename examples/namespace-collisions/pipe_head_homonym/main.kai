# Both modules export `pub type Source[t]` and a `map` for it. The pipe's
# head is the one `Source` the value was built as, so the dispatch is
# mod_a's `map`, not an ambiguity.
import mod_a
import mod_b

fn main() : Unit / Stdout = {
  let s = MkSrcA(7)
  let r = s | (n) => n + 1
  Stdout.print("#{mod_a.unwrap(r)} #{mod_b.unwrap(MkSrcB(1))}")
}
