# The stdlib module bound under a qualifier: its type and its functions
# go through the qualifier, and a literal still mints against it.
import decimal as dec

fn main() : Unit / Stdout = {
  let a : dec.Decimal = dec.from_int(3)
  let b : dec.Decimal = 2.5
  Stdout.print(dec.to_string(dec.add(a, b)))
}
