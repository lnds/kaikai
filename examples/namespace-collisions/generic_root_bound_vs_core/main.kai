# The generic-root collision with a protocol bound on the type parameter.
protocol Pat {
  pat_len(x: Self) : Int
}
impl Pat for String {
  fn pat_len(x: String) : Int = string.length(x)
}

fn count[P: Pat](s: String, p: P) : Int = string.length(s) + pat_len(p)

fn main() : Unit / Stdout = {
  let n = "ho"
  Stdout.print("#{count("hola", n)}")
}
