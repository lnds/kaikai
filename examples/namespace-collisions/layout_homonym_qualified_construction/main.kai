import la
import lb

# The qualifier on a record literal selects the module's type, and with
# it the byte order of every field.
fn main() : Unit / Stdout = {
  let a = la.Header { magic: 3<be>, port: 8080<be> }
  let b = lb.Header { magic: 4<le>, port: 8443<le> }
  Stdout.print("#{la.port(a)} #{lb.port(b)}")
}
