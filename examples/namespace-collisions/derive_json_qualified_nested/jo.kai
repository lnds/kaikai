import encoding.json.{json_encode, json_decode}
import encoding.json_bind
import ja

# A derived field names its nested record by the declaration its written
# head denotes from this file. `ja.Part` is a type only `ja` declares;
# `Item` is declared here and in `ja`, and each field reaches the impl of
# its own: bare, through the module, under `Option`, in a list and in a
# sum payload.
#[derive(Json)]
pub type Item = { name: String }

#[derive(Json)]
pub type Slot = Full(ja.Part) | Free

#[derive(Json)]
pub type Shelf = { own: Item, first: ja.Item, part: ja.Part, spare: Option[ja.Part], slots: [Slot] }

pub fn sample() : Shelf =
  Shelf { own: Item { name: "top" }, first: ja.Item { id: 1 }, part: ja.Part { code: 2 },
          spare: Some(ja.Part { code: 3 }), slots: [Full(ja.Part { code: 4 }), Free] }

pub fn encode(s: Shelf) : String = json_encode(to_json(s))

pub fn round_trip(text: String) : String = match json_decode(text) {
  None    -> "bad json"
  Some(v) -> match shelf_of_json(v, "") {
    Err(_)   -> "err"
    Ok(back) -> "#{back.own.name} #{back.first.id} #{back.part.code} #{encode(back) == text}"
  }
}
