import sa
import pb

# `unit_of` is an arity-0 operation of `pb.Scalable`. An arity-0 op has
# no receiver to dispatch on, so reaching its dispatcher at runtime is a
# panic. `sa.unit_of` is in scope bare through the import and must claim
# the name before that happens — the same rung a root-file `fn` has.
fn main() : Unit / Stdout = {
  let v = unit_of()
  Stdout.print("v=#{v} i=#{unit_of()}")
}
