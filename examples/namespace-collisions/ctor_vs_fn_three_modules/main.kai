import ca
import cb
import fc

# Three homes for `Make`/`make`: two constructors with divergent payloads
# and one function whose name differs only in case. The case-only pair is
# the arrangement where a case-folding lookup collapses the two.
fn main() : Unit / Stdout = {
  let a = ca.unwrap(ca.Make(3))
  let b = cb.render(cb.Make("x"))
  let c = fc.make(4)
  Stdout.print("#{a} #{b} #{c}")
}
