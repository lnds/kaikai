# A top-level `fn` spelled like a core builtin is the declaration its
# calls reach; the builtin stays reachable under every name the file does
# not declare. Both backends resolve the call the same way.

fn int_to_string(n: Int) : String = "shadowed"

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(5))
  Stdout.print(string_concat("built", "in"))
}
