import pa
import pb

# Only `pa.Box` holds a cell. A `pb.Box` parameter forwarded to a
# `/ Mutable` callee carries none, so the write to the local array stays
# masked and `read` declares no row.
fn stamp(b: pb.Box, out: Array[Int]) : Unit / Mutable {
  out[0] := b.n
}

fn read(b: pb.Box) : Int {
  let out = array_make(1, 0)
  stamp(b, out)
  out[0]
}

fn main() : Unit / Stdout =
  Stdout.print("#{read(pb.mk(7))} #{array_length(pa.fresh().cells)}")
