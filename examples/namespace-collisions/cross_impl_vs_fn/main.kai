# A root fn of the op's arity shadows the protocol op for a method call
# as for a prefix call, so `4.size()` reaches `size(s: String)`, not the
# `Sized` impl, and the receiver does not fit.
protocol Sized {
  size(self: Int) : Int
}

impl Sized for Int {
  fn size(self: Int) : Int = self * 2
}

fn size(s: String) : Int = 99

fn main() : Unit / Stdout = Stdout.print("#{4.size()} #{size("x")}")
