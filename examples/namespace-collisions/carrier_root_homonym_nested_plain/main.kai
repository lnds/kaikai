import pb

# The root's `Box` holds a cell; `pb.Holder` stores `pb`'s `Box`, which
# holds none. The field is read from the module declaring `Holder`, so a
# `pb.Holder` parameter carries nothing and `read` declares no row.
type Box = { cells: Array[Int] }

fn stamp(h: pb.Holder, out: Array[Int]) : Unit / Mutable {
  out[0] := h.box.n
}

fn read(h: pb.Holder) : Int {
  let out = array_make(1, 0)
  stamp(h, out)
  out[0]
}

fn main() : Unit / Stdout = {
  let own = Box { cells: array_make(3, 0) }
  Stdout.print("#{read(pb.mk(7))} #{array_length(own.cells)}")
}
