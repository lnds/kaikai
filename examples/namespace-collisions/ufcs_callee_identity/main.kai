# Every UFCS callee names the declaration the receiver's type picked: one
# of two modules' `describe`, one of two core `length`s, an imported
# `twice`, a private `bump` inside its own module, a root `twice` spelled
# like the imported one, a root `scale`, and a chain. A local binder
# spelled like a root fn still wins.
import ma
import mb

fn twice(s: String) : String = s ++ s

fn scale(x: Int) : Int = x * 3

fn main() : Unit / Stdout = {
  Stdout.print(5.describe())
  Stdout.print("a".describe())
  Stdout.print(int_to_string([1, 2, 3].length()))
  Stdout.print(int_to_string(5.twice()))
  Stdout.print("ab".twice())
  Stdout.print(int_to_string(5.twice().twice()))
  Stdout.print(int_to_string(5.scale()))
  let scale = (x: Int) => x * 10
  Stdout.print(int_to_string(5.scale()))
}
