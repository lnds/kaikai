# Every variant-record ctor is core-minted (tuple lowering); a qualifier on
# this pattern shape has nothing to select, and there is no home slot to
# carry it through lowering, so the spelling is rejected rather than
# dissolved.
fn main() : Unit / Stdout = {
  let p = (1, 2)
  let got = match p {
    nope.Pair { fst: a, snd: b } -> a + b
  }
  Stdout.print(int_to_string(got))
}
