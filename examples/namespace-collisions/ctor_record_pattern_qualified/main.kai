# The qualifier of a record-shaped ctor pattern is validated against
# the module table, so a module that was never imported diagnoses
# instead of being dissolved unread.
fn main() : Unit / Stdout = {
  let p = (1, 2)
  let got = match p {
    nope.Pair { fst: a, snd: b } -> a + b
  }
  Stdout.print(int_to_string(got))
}
