# A user module `core` and its own `Option` beside the builtin one: the
# builtin `Some`/`None` and the module's `core.Option` keep their own
# declarations and identities.
import core

fn first_of(xs: [Int]) : String = match xs {
  [x, ..._] -> match Some(x) {
    Some(n) -> "some #{n}"
    None -> "none"
  }
  [] -> "#{max(xs)}"
}

fn list_head_opt(xs: [Int]) : core.Option = match xs {
  [x, ..._] -> core.wrap(x)
  [] -> core.wrap(0)
}

fn main() : Unit / Stdout = {
  Stdout.print(core.describe(core.wrap(3)))
  Stdout.print(core.describe(list_head_opt([])))
  Stdout.print(first_of([4]))
  Stdout.print(first_of([]))
  Stdout.print("#{max([3, 9])}")
}
