# A root protocol spelled like a core one dispatches to its own impl when
# its op is taken as a value.

protocol Eq {
  eq(x: Self, y: Self) : Bool
}

type C = Red | Blue

impl Eq for C {
  fn eq(a: C, b: C) : Bool = true
}

fn main() : Unit / Stdout = {
  println("#{eq(Red, Blue)}")
  let f = eq
  println("#{f(Red, Blue)}")
}
