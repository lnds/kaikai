# The root declares its own `Tag` and `Blank` and never imports the
# module whose `Shape` it matches on. The scrutinee's type has its own
# constructors, and those are the ones the arms name.
import mod_a

type Local = Tag(String) | Blank

fn label(l: Local) : String = match l {
  Tag(s) -> s
  Blank  -> "blank"
}

fn main() : Unit / Stdout = {
  let far = match mod_a.make(5) {
    Tag(n) -> n * 2
    Blank  -> 0
  }
  let none = match mod_a.make(0) {
    Tag(n) -> n
    Blank  -> -1
  }
  Stdout.print("#{far} #{none} #{label(Tag("own"))} #{label(Blank)}")
}
