import ra
import rb

# One handled body performs BOTH homonymous effects, so the body's row
# carries two entries spelled the same and the two handlers are nested
# around it. A row keyed on the bare name collapses them and the inner
# handler answers both.
fn main() : Unit / Stdout = {
  let n = handle {
    handle {
      let a = ra.run()
      let b = rb.run()
      a + b
    } with ra.Log { write(v, resume) -> resume(Stdout.print("a:#{v}")) }
  } with rb.Log { write(s, resume) -> resume(Stdout.print("b:#{s}")) }
  Stdout.print("#{n}")
}
