import mb

# A second builtin (`Stderr`), and `main` declares both rows bare. The
# core rung has to hold for each one independently.
fn main() : Unit / Stdout + Stderr = {
  handle { mb.warn() } with mb.Stderr { eprint(s, resume) -> resume(()) }
  Stderr.eprint("to-stderr")
  Stdout.print("to-stdout")
}
