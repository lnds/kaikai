import mb

# A second builtin, `Stderr`, shadowed by an import while `Stdout` is
# not: each bare name settles on its own rung of the ladder.
fn main() : Unit / Stdout + effects.Stderr = {
  handle { mb.warn() } with Stderr { eprint(s, resume) -> resume(()) }
  effects.Stderr.eprint("to-stderr")
  Stdout.print("to-stdout")
}
