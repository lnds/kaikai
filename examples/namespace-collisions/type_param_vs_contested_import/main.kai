import pa
import pb

# `T` here is the function's OWN type parameter, bound by `[T]` two
# columns to the left. Rung 1 of the ladder is local scope, so the
# binder settles the name before any import is consulted: the imported
# `pa.T`/`pb.T` are not candidates for this `T` at all.
#
# Today the contested-import check runs first and reports an ambiguity,
# advising `pa.T` — a qualification the user cannot write, because the
# name belongs to their own parameter.
fn ident[T](x: T) : T = x

fn main() : Unit / Stdout = Stdout.print("#{ident(5)}")
