import sink

effect Stdout {
  print(s: String) : Unit
}

# The shadowed builtin is the one this fixture's output goes through. The
# user effect and the prelude one share the effect name AND the op name,
# so a handler that captured both would make `sink.emit` recurse into the
# clause that calls it.
fn go() : Unit / Stdout = {
  Stdout.print("user-a")
  Stdout.print("user-b")
}

fn main() : Unit = {
  handle { go() } with Stdout { print(s, resume) -> resume(sink.emit("wrapped:#{s}")) }
  sink.emit("plain")
}
