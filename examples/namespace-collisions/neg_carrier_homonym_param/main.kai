import pa

# The root's `Box` holds no cell; `pa.Holder` stores `pa`'s `Box`, which
# does. The field is read from the module declaring `Holder`, so
# forwarding a `pa.Holder` parameter to a `/ Mutable` callee is
# observable and `forward` must declare the row.
type Box = { n: Int }

fn forward(h: pa.Holder) : Unit {
  pa.poke(h)
}

fn main() : Unit / Stdout + Mutable = {
  let h = pa.mk()
  let own = Box { n: 1 }
  forward(h)
  Stdout.print("#{h.box.cells[0]} #{own.n}")
}
