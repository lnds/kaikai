import pc
import sc

# The arity-0 op is shadowed by the import while the protocol's OTHER
# op stays reachable: claiming the name must not disable the protocol.
fn main() : Unit / Stdout = {
  let c = bump(pc.Counter(1))
  let n = match c { pc.Counter(v) -> v }
  Stdout.print("s=#{seed()} c=#{n}")
}
