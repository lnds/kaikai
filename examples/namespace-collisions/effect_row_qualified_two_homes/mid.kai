import qa
import qb

# Two homonymous effects told apart in the ROW itself — the position the
# op call and the handler head could already spell. Each signature names
# one home; a row that dropped the qualifier would make these two rows the
# same row.
pub fn one() : Unit / qa.Emit = qa.Emit.put("a")
pub fn two() : Unit / qb.Emit = qb.Emit.put(2)
pub fn both() : Unit / qa.Emit + qb.Emit = { one(); two() }
