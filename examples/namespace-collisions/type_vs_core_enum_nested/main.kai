# A root sum named like a core all-nullary enum, nested as a payload of
# another sum. Its slots must be classified from its own declaration.
type Sig = S(String) | T
type W = W(Sig, Int)

fn f(w: W) : Int = match w {
  W(S(x), k) -> string_length(x) + k
  W(T, k) -> k
}

fn main() : Unit / Stdout = Stdout.print("n=#{f(W(S(int_to_string(12345)), 1))}")
