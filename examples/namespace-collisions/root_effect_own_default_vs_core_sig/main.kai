# The same shadow with an op payload the core op does not take: reaching
# the core default hands it an Int where it reads a String.
effect Log {
  info(ns: Int) : Unit
  default {
    info(ns, resume) -> $extern_handler("kai_default_clock_sleep_ns")
  }
}

fn main() : Unit / Log + Stdout = {
  Log.info(1000)
  Stdout.print("slept")
}
