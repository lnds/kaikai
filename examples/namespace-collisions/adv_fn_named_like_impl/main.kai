import ha

fn apply[a](f: (a) -> String, x: a) : String = f(x)

# `show` taken as a value picks its impl at run time, from the impl
# table. Only impls are rows of that table.
fn main() : Unit / Stdout = {
  let shown = show
  Stdout.print(apply(shown, 5))
  Stdout.print(ha.__pimpl_Show_Int_show(5))
}
