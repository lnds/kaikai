effect Emit {
  put(s: String) : Unit
}

type Holder = { put: String }

# The local named like the effect is a PARAMETER, and the effect is still
# performed in the same function through a helper the parameter does not
# shadow. The existing fixture shadows with a `let` in main; a parameter
# binds before the body is walked at all.
fn wrap(Emit: Holder, s: String) : String = "#{s}/#{Emit.put}"

fn go() : Unit / Emit = {
  Emit.put("op-a")
  Emit.put("op-b")
}

fn main() : Unit / Stdout = {
  let h = Holder { put: "field" }
  handle { go() } with Emit { put(s, resume) -> resume(Stdout.print(wrap(h, s))) }
}
