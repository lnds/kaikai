import va
import vb

# The type and the effect live in different homes. The annotation
# position takes va's type; the operation call has to name vb's effect
# through its home, because bare `Log` in expression position resolves
# to the type and its `write` is then not an operation at all.
fn emit(l: Log) : Unit / vb.Log = vb.Log.write("lvl=#{l.level}")

fn main() : Unit / Stdout = handle {
  emit(va.mk())
} with vb.Log {
  write(s, resume) -> { Stdout.print(s)  resume(()) }
}
