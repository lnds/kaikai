# The expression side: the root declares its own `Tag` and `Blank`, which
# the scope would answer with. Where a type is expected, that type's own
# constructors answer instead, applied and nullary, in a `let` and in the
# branches of an `if`.
import mod_b

type Local = Tag(String) | Blank

fn own(l: Local) : String = match l {
  Tag(s) -> s
  Blank  -> "blank"
}

fn far(flag: Bool) : mod_b.Shape = if flag { Tag(9) } else { Blank }

fn main() : Unit / Stdout = {
  let a : mod_b.Shape = Tag(4)
  let b : mod_b.Shape = Blank
  Stdout.print("#{mod_b.weigh(a)} #{mod_b.weigh(b)} #{mod_b.weigh(far(true))} #{mod_b.weigh(far(false))} #{own(Tag("own"))} #{own(Blank)}")
}
