import hm as h

# `h.Option` and the core `Option` share a spelling; the qualifier alone
# tells them apart in a signature, a tail call and an effect instance.

effect Box[X] {
  peek() : X
}

fn count_core(o: Option[Int], acc: Int) : Int = match o {
  Some(n) -> count_core(if n > 1 { Some(n - 1) } else { None }, acc + 1)
  None    -> acc
}

fn count_mine(o: h.Option[Int], acc: Int) : Int = match o {
  h.Yes(n) -> count_mine(h.mk(n - 1), acc + 1)
  h.No     -> acc
}

fn peek_core() : Option[Int] / Box[Option[Int]] = Box.peek()

fn peek_mine() : h.Option[Int] / Box[h.Option[Int]] = Box.peek()

fn both() : String / Box[Option[Int]] + Box[h.Option[Int]] = {
  let c = match peek_core() { Some(n) -> n  None -> 0 }
  let m = match peek_mine() { h.Yes(n) -> n  h.No -> 0 }
  "core=#{c} mine=#{m}"
}

fn main() : Unit / Stdout = {
  let r = handle {
    handle { both() } with Box[Option[Int]] {
      peek(resume) -> resume(Some(1))
    }
  } with Box[h.Option[Int]] {
    peek(resume) -> resume(h.mk(2))
  }
  Stdout.print("#{count_core(Some(3), 0)} #{count_mine(h.mk(4), 0)} #{r}")
}
