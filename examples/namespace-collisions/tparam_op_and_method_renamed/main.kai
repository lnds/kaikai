# The operation calls its own parameter `b`; the impl method spells the
# same parameter `c`. A parameter is its binder, not its spelling, so the
# signatures agree.
protocol Paired {
  wrap[b](x: Self, other: b) : [b]
}

type Box[a] = { v: a }

impl[a] Paired for Box[a] {
  fn wrap[c](x: Box[a], other: c) : [c] = [other, other]
}

fn main() : Unit / Stdout = {
  let b = Box { v: 2 }
  Stdout.print("#{list_length(wrap(b, "s"))}")
  Stdout.print("#{list_length(wrap(b, 1.5))}")
}
