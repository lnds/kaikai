# Both modules export `pick`; neither is core and the root declares no
# `pick` of its own. Whichever registers last would win a bare call, so
# import order alone would decide which generic runs. There is no order
# to prefer, so the bare call is refused and the qualified form is the
# only way to say which one is meant.
import ra
import rb

fn main() : Unit / Stdout = Stdout.print(pick())
