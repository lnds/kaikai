import ga
import gb

# Both homes allocated inside the same region, so the arena holds two
# distinct types that share a spelling and must not be given one layout.
fn a(c: ga.Cell) : String = ga.show(c)
fn b(c: gb.Cell) : String = gb.show(c)

fn main() : Unit / Stdout = {
  let s = region { "#{a(ga.mk())} #{b(gb.mk())}" }
  Stdout.print(s)
}
