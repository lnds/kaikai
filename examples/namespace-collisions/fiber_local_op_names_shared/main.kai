import actor
import mail

type Msg = Ping | Stop

fn drain() : String / Actor[Msg] = match Actor.receive() {
  Ping -> "ping " ++ drain()
  Stop -> "stop"
}

fn body() : String / Actor[Msg] + Mail = {
  Actor.send(Actor.self(), Ping)
  Actor.send(Actor.self(), Stop)
  mail.post("hello")
  "#{mail.who()} #{mail.fetch()} #{drain()}"
}

fn main() : Unit / Spawn + Stdout = {
  let out = handle { with_mailbox { body() } } with Mail {
    send(m, resume) -> resume(())
    receive(resume) -> resume("mail-recv")
    self(resume) -> resume("mail-self")
    return(x) -> x
  }
  Stdout.print(out)
}
