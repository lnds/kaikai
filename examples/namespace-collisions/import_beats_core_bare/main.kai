import sa

# `one` is exported by the auto-loaded `math/complex` and by `sa`. An
# import is an explicit declaration at the head of the file and the core
# is implicit, so the import takes the name — and, load-bearing, BOTH
# the typer and codegen have to agree on that. They used to disagree:
# the typer picked `sa`, codegen picked `complex`, and the call printed
# a value belonging to neither.
fn main() : Unit / Stdout = {
  let v = one()
  Stdout.print("v=#{v} i=#{one()}")
}
