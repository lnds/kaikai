import ma

pub fn twice(n: Int) : Int = n + 100

pub fn doubled(xs: [Int]) : [Int] = go(xs, ma.twice, [])

pub fn shifted(xs: [Int]) : [Int] = go(xs, twice, [])

fn go(xs: [Int], f: (Int) -> Int, acc: [Int]) : [Int] = match xs {
  []        -> list.reverse(acc)
  [x, ...t] -> go(t, f, [f(x), ...acc])
}
