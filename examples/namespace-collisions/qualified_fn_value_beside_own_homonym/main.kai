# A function another module declares, passed by value from a module that
# declares one with the same name, is that other module's function.
import mb

fn show_all(xs: [Int]) : String = string.join(list.map(xs, (x) => int_to_string(x)), " ")

fn main() : Unit / Stdout = {
  Stdout.print(show_all(mb.doubled([1, 2, 3])))
  Stdout.print(show_all(mb.shifted([1, 2, 3])))
}
