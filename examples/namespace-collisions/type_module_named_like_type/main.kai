import Cfg
import other

# A module and a type share the spelling `Cfg`. The module is the
# qualifier on the left of a `.`; the type is what an annotation names.
# The two positions never compete, so both stay reachable.
fn take(c: other.Cfg) : String = other.show(c)

fn main() : Unit / Stdout = Stdout.print("#{Cfg.hello()} #{take(other.mk())}")
