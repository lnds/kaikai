# A call to another module's function from the body of a function spelled
# the same is not a self-call. Each form reaches the imported declaration:
# qualified, UFCS, a sibling module's homonym in tail position, a generic
# specialisation calling a sibling's homonym, and a protocol method calling
# a module function spelled like its op.
import ma
import mb

fn twice(s: String) : Int = if s == "" { 0 } else { ma.twice(5) }

fn half(s: String) : Int = if s == "" { 0 } else { 8.half() }

type Box = { n: Int }

impl Show for Box {
  fn show(b: Box) : String = ma.show(b.n)
}

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(twice("a")))
  Stdout.print(int_to_string(half("a")))
  Stdout.print(int_to_string(mb.step([1, 2, 3], 4)))
  Stdout.print(mb.label("x", 7))
  let b = Box { n: 3 }
  Stdout.print("#{b}")
}
