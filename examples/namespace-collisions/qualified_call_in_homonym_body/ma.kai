pub fn twice(x: Int) : Int = x * 2

pub fn step(xs: [Int], acc: Int) : Int = match xs {
  [] -> acc
  [x, ...rest] -> step(rest, acc + x)
}

pub fn half(x: Int) : Int = x / 2

pub fn label(n: Int) : String = "ma.label:" ++ int_to_string(n)

pub fn show(n: Int) : String = "ma.show:" ++ int_to_string(n)
