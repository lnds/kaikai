# The core module that mints the tuple ctors is a module like any
# other: qualifying the record-shaped pattern with it selects the
# ctor it exports, so the spelling compiles and matches.
fn main() : Unit / Stdout = {
  let p = (1, 2)
  let got = match p {
    tuple.Pair { fst: a, snd: b } -> a + b
  }
  Stdout.print(int_to_string(got))
}
