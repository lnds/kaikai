import mc

# `mc.go` performs the core `Log`. A root effect of the same name does not
# handle it, so the core effect is left unhandled in `main`.
effect Log {
  info(xs: [String]) : Unit
}

fn main() : Unit / Stdout = {
  handle { mc.go() } with Log {
    info(xs, resume) -> {
      Stdout.print("root got #{list_length(xs)}")
      resume(())
    }
  }
}
