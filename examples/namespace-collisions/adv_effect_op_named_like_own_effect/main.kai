# The op is named like the effect that declares it, so `Track.Track` would
# be the only spelling of the call. The existing pair puts the clash
# across two modules; here the effect and its own op collide in one
# declaration, which is where the uppercase rule has to bite first.
effect Track {
  Track(s: String) : Unit
}

fn main() : Unit / Stdout = Stdout.print("x")
