import pa
import pb

# The parameter appears in the return position as well as the argument.
# The binder is the same rung-1 local wherever it is used, so where the
# name appears must not change whether it is seen.
fn first[T](xs: [T], fallback: T) : T = match xs {
  [] -> fallback
  [x, ...rest] -> x
}

fn main() : Unit / Stdout = Stdout.print("#{first([1, 2], 0)}")
