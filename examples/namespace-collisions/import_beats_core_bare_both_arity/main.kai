import sc

# The same collision where BOTH candidates take an argument. Arity agrees,
# so the mismatch that caught the arity-0 pair is silent here: the typer
# read `sc.conj` while codegen emitted `complex.conj`, and the call handed
# a boxed Int to a function reading a Complex record.
fn main() : Unit / Stdout = Stdout.print("v=#{conj(7)}")
