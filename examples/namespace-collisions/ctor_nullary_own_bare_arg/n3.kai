pub type A3 = Idle | Gone

# The declaring module names its own nullary constructor bare, in an
# argument slot with no annotation to lean on; the two other homes must
# not make it ambiguous here.
pub fn start() : A3 = step(Idle)
fn step(x: A3) : A3 = match x { Idle -> Gone  Gone -> Idle }
pub fn tag(x: A3) : String = match x { Idle -> "idle"  Gone -> "gone" }
