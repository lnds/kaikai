import ka
import kb

# The qualifier on a constant in pattern position selects the module's
# constant; arm order must not decide which LIMIT a pattern names.
fn tag(n: Int) : String = match n {
  ka.LIMIT -> "ka"
  kb.LIMIT -> "kb"
  _ -> "other"
}

fn tag_rev(n: Int) : String = match n {
  kb.LIMIT -> "kb"
  ka.LIMIT -> "ka"
  _ -> "other"
}

fn main() : Unit / Stdout = Stdout.print("#{tag(1)} #{tag(2)} #{tag_rev(1)} #{tag_rev(2)}")
