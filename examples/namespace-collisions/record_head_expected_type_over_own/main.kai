# The root declares its own record `Cell`, which a bare head reaches
# first. Where a type is expected the head is that type's record: the
# annotated literal, the one a function returns and the one passed for
# a parameter build the import's `Cell`, its fields in the slots that
# record declares whatever order they are written in; the arm over an
# import's value matches it, and the unannotated literal stays the
# root's.
import mod_b

type Cell = { hi: Int, lo: Int, x: Int }

fn span(c: mod_b.Cell) : Int = match c {
  Cell { lo: a, hi: b } -> b - a
}

fn unit_cell() : mod_b.Cell = Cell { hi: 4, lo: 0 }

fn main() : Unit / Stdout = {
  let far : mod_b.Cell = Cell { lo: 2, hi: 9 }
  let rev : mod_b.Cell = Cell { hi: 8, lo: 3 }
  let own = Cell { x: 5, lo: 1, hi: 6 }
  let passed = mod_b.show(Cell { hi: 7, lo: 1 })
  Stdout.print("#{mod_b.show(far)} #{mod_b.show(rev)} #{mod_b.show(unit_cell())} #{passed} #{span(rev)} #{own.lo}.#{own.hi}.#{own.x}")
}
