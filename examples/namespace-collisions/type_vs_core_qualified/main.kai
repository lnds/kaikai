import va

# `Option` is a core type loaded without an import. Once `va` exports a
# homonym the bare name has a candidate from the import, and rung 4
# picks it: bare `Option` here is va's, not core's. The core type is
# still reachable — through its constructors, which va does not contest.
fn mine(o: va.Option[Int]) : Int = va.get(o)
fn bare(o: Option[Int]) : Int = match o { Yes(n) -> n  No -> 0 }

fn main() : Unit / Stdout = Stdout.print("#{mine(va.mk())} #{bare(va.Yes(7))}")
