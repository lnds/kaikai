# Root fns spelled like `math.complex` fns are the declarations root calls
# reach; `mk` and `from_real`, which the root does not declare, still reach
# the core. `uniq_name_x` has no homonym at all.

fn add(a: Int, b: Int) : Int = a + b
fn conj(a: Int) : Int = a
fn uniq_name_x(a: Int) : Int = a
fn helper(a: Int) : Int = add(a, conj(uniq_name_x(a)))

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(helper(20)))
  Stdout.print(real_to_string(mk(1.0, 2.0).im + from_real(3.0).re))
}
