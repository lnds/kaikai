import b

#[derive(BinSerialize, Eq)]
pub type Entry = { flag: Bool, r: Real }

#[derive(BinSerialize, Eq)]
pub type Wrap = { e: b.Entry, mine: Entry }

pub fn wrap() : Wrap = Wrap { e: b.mk("zed", 7), mine: Entry { flag: true, r: 2.5 } }

pub fn round() : String = {
  let w = wrap()
  match from_bytes(to_bytes(w), 0) {
    Ok(c) -> { let back: Wrap = c.value
               "#{back.e.name} #{back.e.n} #{back.mine.flag} #{back.mine.r} #{back == w}" }
    Err(m) -> m
  }
}
