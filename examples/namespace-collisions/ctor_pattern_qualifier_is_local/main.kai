import qa

# The qualifier in the arm names a LOCAL binding, not a module. A pattern
# walker that reads the head as `<any ident>.<ctor>` and looks the tail up
# among the imports resolves this to `qa.Go` and never notices.
fn main() : Unit / Stdout = {
  let qb = 3
  let s = match qa.Go(3) {
    qb.Go(v) -> "#{v}"
    qa.Halt  -> "halt"
  }
  Stdout.print(s)
}
