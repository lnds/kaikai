import ta
import tb

# Two modules each declare a type `Item`, and this one file implements a
# protocol for both and derives over a record holding one of each. The
# two impl functions live in one module, and the derive calls each
# field's writer and decoder by the name it was minted under: every one
# of those names has to tell the two `Item`s apart.
protocol Label { label(self: Self) : String }

impl Label for ta.Item { fn label(self: ta.Item) : String = "a-item #{self.id}" }
impl Label for tb.Item { fn label(self: tb.Item) : String = "b-item #{self.name}" }

#[derive(Show, Eq, BinSerialize)]
type Both = { a: ta.Item, b: tb.Item }

fn main() : Unit / Stdout = {
  let p = Both { a: ta.mk(), b: tb.mk() }
  Stdout.print("#{p.a.label()} | #{p.b.label()}")
  Stdout.print("#{p}")
  match from_bytes(to_bytes(p), 0) {
    Ok(c) -> {
      let back: Both = c.value
      Stdout.print("#{back == p} #{back.a.id} #{back.b.name}")
    }
    Err(m) -> Stdout.print(m)
  }
}
