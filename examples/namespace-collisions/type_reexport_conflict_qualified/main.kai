import cb
import cm

# The middle module's own function crosses both types: it takes the
# base's `Cfg` while its own home declares a different one. Its
# viewpoint is its home, so the parameter keeps the base's.
fn mid_own(c: cm.Cfg) : String = cm.show(c)

fn main() : Unit / Stdout =
  Stdout.print("#{cm.via(cb.mk())} #{mid_own(cm.mk())}")
