# The root declares a constructor an imported module also exports. A bare
# use is the reader's own: the nearest scope that declares the name
# answers, and the import is reached by its qualifier.
import mod_a

type Local = Tag(Int)

fn bump(l: Local) : Int = match l {
  Tag(n) -> n + 1
}

fn main() : Unit / Stdout = {
  let t = Tag(41)
  Stdout.print("#{bump(t)} #{mod_a.describe(mod_a.Tag("far"))}")
}
