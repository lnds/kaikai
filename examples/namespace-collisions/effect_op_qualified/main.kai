import ea
import eb

# Two modules declare `Emit` with the same operation. The qualifier
# picks which one each handler closes and which one each call reaches.
fn main() : Unit / Stdout = {
  handle { ea.run() } with ea.Emit { put(s, resume) -> resume(Stdout.print(s)) }
  handle { eb.run() } with eb.Emit { put(s, resume) -> resume(Stdout.print(s)) }
  handle { ea.Emit.put("direct-a") } with ea.Emit { put(s, resume) -> resume(Stdout.print(s)) }
}
