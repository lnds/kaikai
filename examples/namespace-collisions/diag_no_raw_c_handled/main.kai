import ra
import rb

# The homonymous effects are not merely imported here — one of them is
# handled with a clause whose op signature belongs to the OTHER home. If
# the mismatch escapes the typer, what the reader gets is a C compiler
# error about a generated identifier instead of a diagnostic about names.
fn main() : Unit / Stdout = {
  let n = handle { ra.run() } with rb.Log { write(s, resume) -> resume(Stdout.print(s)) }
  Stdout.print("#{n}")
}
