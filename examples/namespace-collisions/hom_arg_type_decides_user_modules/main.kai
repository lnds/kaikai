# Two of the package's own modules export `pick`, with different
# parameter types. No stdlib name is involved: the candidate set is the
# user's. `annotated` knows the argument's type where the call is
# written; `inferred` writes the same call inside a lambda whose
# parameter is only pinned once `map`'s receiver is unified. Both mean
# the `[Int]` overload, so both must reach it.
import pa
import pb

type Bag = { entries: [Int] }

fn annotated(b: Bag) : Bag = Bag { entries: pick(b.entries) }

fn inferred(r: Result[Bag, String]) : Result[Bag, String] =
  r.map(b => Bag { entries: pick(b.entries) })

fn main() : Unit / Stdout = {
  Stdout.print("#{annotated(Bag { entries: [1, 2] }).entries}")
  match inferred(Ok(Bag { entries: [1, 2, 3] })) {
    Ok(b) -> Stdout.print("#{b.entries}")
    Err(e) -> Stdout.print(e)
  }
  let qualified = pb.pick("x")
  Stdout.print("#{qualified}")
}
