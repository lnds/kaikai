# The predicate is written in place, in a file that only imports the
# sum: `None` is still the constructor of the type it refines.
import shade

fn pass(s: shade.Shade where self != None) : (shade.Shade where self != None) = s

fn main() : Unit / Stdout = {
  let t : shade.Shade where self != None = shade.Light
  Stdout.print(shade.name(pass(t)))
}
