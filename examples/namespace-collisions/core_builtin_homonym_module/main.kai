# An imported module privately declares fns spelled like core builtins.
# Its own calls reach them; every other caller, the stdlib's Show impls
# and interpolation among them, still reaches the builtin.
import hm

fn main() : Unit / Stdout = {
  Stdout.print("#{42} #{[1, 2]} #{string.length("abc")}")
  Stdout.print("#{hm.via(5)} #{hm.len("a")}")
}
