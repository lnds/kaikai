# An effect op's signature names a type that two modules both declare.
# Each op must resolve `Payload` to its OWN module's record, so each
# handler reads the field its own module declared.

import ea
import eb

fn main() : Unit / Stdout = {
  let a = handle { ea.run_ea() } with ea.Emit { send(p, resume) -> resume(p.tag) }
  let b = handle { eb.run_eb() } with eb.Relay { pass(p, resume) -> resume(string_length(p.label)) }
  Stdout.print("#{a} #{b}")
}
