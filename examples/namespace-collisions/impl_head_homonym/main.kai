# A type spelled like one the runtime numbers with a fixed head is still
# its own type. `show` passed as a value dispatches at run time by the
# receiver's head: the impls of the root `Signal` and `Option` answer for
# their own values, and the core `Option`'s for its own.

#[derive(Show)]
type Signal = Red | Amber(Int)

#[derive(Show)]
type Option = Maybe(String) | Never

fn main() : Unit / Stdout = {
  Stdout.print(join(map([Red, Amber(7)], show), ","))
  Stdout.print(join(map([Maybe("x"), Never], show), ","))
  Stdout.print(join(map([Some(1), None], show), ","))
}
