import encoding.json
import encoding.json_bind

type Status = Ok | Err | JObj(Int) | JStr(Int) | JNull

#[derive(Json)]
type Point = { x: Int, y: Int }

#[derive(Json)]
type Shape = Dot | Circle(Int)

fn main() : Int {
  println(json_encode(to_json(Point { x: 1, y: 2 })))
  println(json_encode(to_json(Circle(3))))
  0
}

type Pair = { fst: String, snd: Int }
