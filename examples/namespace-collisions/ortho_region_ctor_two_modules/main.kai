import ra
import rb

# Both homes are constructed inside ONE region and one of each escapes as
# the region's value: the region's allocations are freed at its end, so a
# value read after the boundary is where a shared home would show up.
fn main() : Unit / Stdout = {
  let inner = region {
    let a = ra.show(ra.Cellx(5))
    let b = rb.show(rb.Cellx("x"))
    "#{a} #{b}"
  }
  let outer = region { "#{ra.show(ra.Emptyx)} #{rb.show(rb.Emptyx)}" }
  Stdout.print("#{inner} #{outer}")
}
