# `Measure` names the built-in kind in a kind annotation and, in `pass`,
# a type parameter of the function.
unit m

fn pass[measure](x: measure) : measure = x

fn scale[u: Measure](x: Real<u>) : Real<u> = x * 2.0

fn main() : Unit / Stdout = {
  Stdout.print("#{pass(7)}")
  Stdout.print(pass("kind-named"))
  Stdout.print("#{scale(1.5<m>)}")
}
