# A root sum whose constructors are spelled like the core's Some and Ok
# owns its own rows.

type Box = Some(Int, Int) | Ok(String) | Unit2

fn f(b: Box) : String = match b {
  Some(a, c) -> "#{a + c}"
  Ok(s) -> s
  Unit2 -> "u"
}

fn main() : Unit / Stdout = {
  println(f(Some(2, 3)))
  println(f(Ok("x")))
}
