# A qualified call names the module's function even where a local
# binder shares its spelling.
import ma

fn sign(x: Int, neg: Bool) : Int = if neg { ma.neg(x) } else { x }

fn apply_twice(twice: Int) : Int = {
  let f = ma.twice
  f(twice)
}

fn main() : Unit / Stdout = {
  Stdout.print("#{sign(5, true)}")
  Stdout.print("#{sign(5, false)}")
  Stdout.print("#{apply_twice(21)}")
}
