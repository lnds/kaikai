# A qualified call names the declaration its qualifier picks, never the
# spelling's other homes: the root's own `label`, a second module's, a
# generic two modules share, an alias, and a core function whose name
# another core module also exports.
import qa
import qb
import qb as other

fn label(n: Int) : String = "root.label:" ++ int_to_string(n)

fn main() : Unit / Stdout = {
  Stdout.print(label(1))
  Stdout.print(qa.label(2))
  Stdout.print(qb.label(3))
  Stdout.print(other.label(4))
  Stdout.print(int_to_string(list_length(qa.wrap(5))))
  Stdout.print(int_to_string(list_length(qb.wrap("x"))))
  Stdout.print(int_to_string(qa.twice(6)))
  Stdout.print(option.unwrap_or(option.map(Some(7), (x) => x + 1), 0) |> int_to_string)
}
