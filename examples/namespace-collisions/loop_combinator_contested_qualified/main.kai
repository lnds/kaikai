# The same contested combinator written qualified. `loop.repeat` names
# its home outright, so the lowering sees the combinator on the path
# the viewpoint never rewrites, and the `var` stays a stack slot.
import loop

fn reps(n: Int) : Int = {
  var acc := 0
  loop.repeat(n) {
    acc := acc + 3
  }
  acc
}

fn main() : Unit / Stdout = Stdout.print(int_to_string(reps(4)))
