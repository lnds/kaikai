# The reverse import order of `import_visibility_bare_call`: `rb` is
# written before `ra`. `rb` imports only `rc`, so its bare `helper`
# still reaches `rc` — the module a file can see decides the call, not
# the order in which the root file happened to import.
import rb
import ra

fn main() : Unit / Stdout = Stdout.print(rb.call_b())
