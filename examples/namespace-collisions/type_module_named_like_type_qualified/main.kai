import Cfg
import other
import other2

# The module `Cfg` now sits beside two homes that both declare a type
# `Cfg`. The bare type name is contested, so the annotations qualify —
# and the module qualifier `Cfg.` must not be read as one of them.
fn a(c: other.Cfg) : String = other.show(c)
fn b(c: other2.Cfg) : String = other2.show(c)

fn main() : Unit / Stdout =
  Stdout.print("#{Cfg.hello()} #{a(other.mk())} #{b(other2.mk())}")
