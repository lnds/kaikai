import actor
import mail

type Msg = Ping | Stop

fn drain() : String / Actor[Msg] = match Actor.receive() {
  Ping -> "ping " ++ drain()
  Stop -> "stop"
}

fn main() : Unit / Spawn + Stdout = with_mailbox {
  Actor.send(Actor.self(), Ping)
  Actor.send(Actor.self(), Stop)
  Stdout.print("#{mail.send("x")} #{mail.receive()} #{mail.self()} #{drain()}")
}
