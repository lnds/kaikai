import dx
import dy
import dz

# Three homes whose bodies disagree in shape: one field, a sum, two
# fields. A collapsed spelling reads one layout through another here,
# which shows up in the output rather than only in a symbol name.
fn a(c: dx.Cfg) : String = dx.show(c)
fn b(c: dy.Cfg) : String = dy.show(c)
fn c3(c: dz.Cfg) : String = dz.show(c)

fn main() : Unit / Stdout =
  Stdout.print("#{a(dx.mk())} #{b(dy.mk())} #{c3(dz.mk())}")
