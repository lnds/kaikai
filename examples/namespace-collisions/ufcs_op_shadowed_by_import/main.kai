# An imported fn of the call's arity shadows a protocol op for a method
# call exactly as for the prefix call: both reach `rational.div`.
import rational

fn quotient(q: Option[rational.Rational]) : String = match q {
  Some(r) -> rational.to_string(r)
  None    -> "none"
}

fn main() : Unit / Stdout = {
  let r = rational.from_int(6)
  let s = rational.from_int(4)
  Stdout.print(quotient(r.div(s)))
  Stdout.print(quotient(div(r, s)))
}
