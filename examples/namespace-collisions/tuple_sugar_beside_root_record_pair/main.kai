# The root declares a record `Pair` of the core tuple's own shape. Tuple
# sugar names the core `Pair` in every position; the bare name, and a
# record literal spelled with it, name the root's.

type Pair[a, b] = { fst: a, snd: b }

fn make_core() : (Int, Int) = (10, 20)

fn make_mine() : Pair[Int, Int] = Pair { fst: 1, snd: 2 }

fn sum_core(t: (Int, Int)) : Int = {
  let (a, b) = t
  a + b
}

fn sum_mine(p: Pair[Int, Int]) : Int = match p {
  Pair { fst, snd } -> fst * 100 + snd
}

fn main() : Unit / Console = {
  let c = make_core()
  println(int_to_string(c.fst + c.snd))
  println(int_to_string(sum_core(c)))
  let m = make_mine()
  println(int_to_string(m.fst + m.snd))
  println(int_to_string(sum_mine(m)))
}
