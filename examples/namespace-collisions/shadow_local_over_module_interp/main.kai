import pa

type Rec = { node: Int }

# A local binding shadows the module of the same name, and the field
# projection wins — inside `#{...}` as well as outside it. The fragment
# is parsed with no surrounding scope, so the lexical binders have to
# travel with it.
fn from_param(pa: Rec) : String = "p=#{pa.node}"

fn main() : Unit / Stdout = {
  let pa = Rec { node: 5 }
  Stdout.print("f=#{pa.node} #{from_param(Rec { node: 7 })}")
}
