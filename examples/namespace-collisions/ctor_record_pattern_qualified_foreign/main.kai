# The qualifier names a module that is imported but does not export the
# ctor, so the head is diagnosed against that module's exports rather
# than resolved against whichever homonym came first.
import ma
import mb

fn main() : Unit / Stdout = {
  let c = ma.Cell { lo: 1, hi: 2 }
  let got = match c {
    mb.Cell { lo: a, hi: b } -> a + b
  }
  Stdout.print(int_to_string(got))
}
