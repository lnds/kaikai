import pa

# The root's `Box` holds no cell, and `Crate` stores the other one by
# its qualified name. A `Crate` parameter carries `pa.Box`'s cell, so
# `forward` must declare the row.
type Box = { n: Int }
type Crate = { box: pa.Box, tag: Box }

fn poke(c: Crate) : Unit / Mutable = pa.poke(c.box)

fn forward(c: Crate) : Unit {
  poke(c)
}

fn main() : Unit / Stdout + Mutable = {
  let c = Crate { box: pa.mk(), tag: Box { n: 1 } }
  forward(c)
  Stdout.print("#{c.box.cells[0]} #{c.tag.n}")
}
