import ma

# `main`'s bare `/ Stdout` is the builtin. An imported module declaring
# its own `Stdout` must not capture it: the core is a rung of the name
# ladder, above any imported homonym.
fn main() : Unit / Stdout = {
  handle { ma.go() } with ma.Stdout { print(s, resume) -> resume(()) }
  Stdout.print("done")
}
