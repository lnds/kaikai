# `reverse` and `length` are declared by both auto-loaded core modules,
# list and string. Each is written where the parameter is annotated and
# again where the argument's type is only known once the lambda's
# parameter is pinned; both mean the list one. The qualified spellings
# keep reaching the module they name.
import core.list as list
import core.string as string

type Bag = { entries: [Int] }

fn annotated(b: Bag) : Bag = Bag { entries: reverse(b.entries) }

fn inferred(r: Result[Bag, String]) : Result[Bag, String] =
  r.map(b => Bag { entries: reverse(b.entries) })

fn counted(r: Result[Bag, String]) : Result[Int, String] =
  r.map(b => length(b.entries))

fn main() : Unit / Stdout = {
  Stdout.print("#{annotated(Bag { entries: [1, 2, 3] }).entries}")
  match inferred(Ok(Bag { entries: [1, 2, 3] })) {
    Ok(b) -> Stdout.print("#{b.entries}")
    Err(e) -> Stdout.print(e)
  }
  match counted(Ok(Bag { entries: [1, 2, 3, 4] })) {
    Ok(n) -> Stdout.print("#{n}")
    Err(e) -> Stdout.print(e)
  }
  let qualified = list.reverse([7, 8])
  Stdout.print("#{qualified}")
  Stdout.print(string.reverse("abc"))
}
