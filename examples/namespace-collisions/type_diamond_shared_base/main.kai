import dbase
import dleft
import dright

# One type reached through two paths. Uniqueness is over the home, not
# the import, so the two arrivals are one candidate and the type stays
# usable bare — a diamond is not a collision.
fn take(c: Cfg) : String = "#{dleft.left(c)} #{dright.right(c)}"

fn main() : Unit / Stdout = Stdout.print(take(dbase.mk(1)))
