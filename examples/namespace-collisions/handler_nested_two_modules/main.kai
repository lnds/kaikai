import ea
import eb

# Each op reaches the handler of ITS effect: ea.Emit.put skips the
# inner eb.Emit handler and lands on the outer ea.Emit one.
fn main() : Unit / Stdout = {
  handle {
    handle {
      ea.run()
      eb.run()
      ea.run()
    } with eb.Emit { put(s, resume) -> resume(Stdout.print("inner-b:#{s}")) }
  } with ea.Emit { put(s, resume) -> resume(Stdout.print("outer-a:#{s}")) }
}
