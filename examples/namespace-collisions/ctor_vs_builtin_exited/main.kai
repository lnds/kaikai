# A user constructor named like a builtin variant whose slot the runtime
# lays out as a raw Int. The user's `String` payload must not be read
# through the builtin's layout.
type R = Exited(String) | Other

fn f(r: R) : Int = match r {
  Exited(s) -> string_length(s)
  Other -> 0
}

fn main() : Unit / Stdout = Stdout.print("n=#{f(Exited(int_to_string(123456)))}")
