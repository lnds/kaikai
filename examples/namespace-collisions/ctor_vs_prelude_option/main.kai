import mo

# Both of `Option`'s constructors are shadowed at once, `None` included:
# a nullary prelude constructor has no argument to disambiguate it, so
# the home has to come from the qualifier alone.
fn main() : Unit / Stdout = {
  let mine = mo.show(mo.Some("a"))
  let mine2 = mo.show(mo.None)
  let core : Option[Int] = Some(1)
  let empty : Option[Int] = None
  let c = match core { Some(n) -> "core:#{n}"  None -> "core:none" }
  let e = match empty { Some(n) -> "core:#{n}"  None -> "core:none" }
  Stdout.print("#{mine} #{mine2} #{c} #{e}")
}
