import encoding.json.{json_decode}

#[derive(Json)]
pub type Item = { id: Int }

# The synthesised `item_of_json` is this module's; the homonym in jb
# synthesises its own.
pub fn parse(s: String) : String = match json_decode(s) {
  None -> "bad"
  Some(v) -> match item_of_json(v, "") {
    Ok(i) -> "id=#{i.id}"
    Err(_) -> "err"
  }
}
