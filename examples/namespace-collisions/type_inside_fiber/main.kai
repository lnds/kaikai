import spawn
import fa
import fb

# A contested type named inside a spawned body. The fiber gets its own
# frame, so a respelling that rides the enclosing function's home rather
# than the annotation's would diverge here and nowhere else.
fn inside(c: fa.Cfg) : String = fa.show(c)

fn main() : Unit / Stdout + Spawn = {
  nursery { n ->
    let f = n.spawn(() => Stdout.print(inside(fa.mk())))
    n.await(f)
  }
  Stdout.print(fb.show(fb.mk()))
}
