# A module body, not the root: its own constructors answer before the
# ones its import exports, applied and nullary alike.
import mod_a

pub type Local = Tag(Int) | Blank

pub fn weigh(l: Local) : Int = match l {
  Tag(n) -> n
  Blank  -> 0
}

pub fn total() : Int = {
  let a = Tag(7)
  let b = Blank
  weigh(a) + weigh(b)
}
