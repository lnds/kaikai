import actor
import spawn

fn child(parent: Pid[String]) : Unit / Actor[String] + Link = Link.link(parent)

fn run() : String / Actor[String] + Spawn + Link = {
  spawn.set_trap_exit(true)
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { child(me) })
  Actor.receive()
}

pub fn exit_of_child() : String / Spawn + Link = with_mailbox { run() }
