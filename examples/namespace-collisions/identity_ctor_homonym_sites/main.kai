import ma
import mb

# One bare ctor name, three declarations (two user types and the core
# `Ok`): the type at the use site decides, never the spelling.

type Res = Ok(Int) | Bad

fn shape(n: Int) : ma.Shape = ma.Leaf(n)

fn tree(s: String) : mb.Tree = mb.Leaf(s)

fn own(n: Int) : Res = Ok(n)

fn core(n: Int) : Result[Int, String] = Ok(n)

fn show_res(r: Res) : String = match r { Ok(n) -> "own#{n}"  Bad -> "bad" }

fn show_core(r: Result[Int, String]) : String = match r { Ok(n) -> "core#{n}"  Err(e) -> e }

fn main() : Unit / Stdout = {
  let a = match shape(1) { ma.Leaf(n) -> n  ma.Node(n) -> n }
  let b = match tree("t") { mb.Leaf(s) -> s  mb.Stump -> "" }
  Stdout.print("#{a} #{b} #{show_res(own(2))} #{show_core(core(3))}")
}
