# A root type named like a core one. The shadow is the user's to make;
# the core module that declared the name keeps referring to its own, so
# its annotations must not read as private access to the root file.
type Option = Nada | Algo(Int)

fn f(o: Option) : Int =
  match o {
    Nada -> 0
    Algo(n) -> n
  }

fn main() : Unit / Stdout = Stdout.print("#{f(Algo(7))}")
