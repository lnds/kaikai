# Two habitants of two kinds sharing one spelling in one module. The
# annotation position selects Type and the row position selects Effect,
# so neither use needs anything of the user.
type Log = { level: Int }
effect Log { write(s: String) : Unit }

fn mk() : Log = Log { level: 3 }

fn emit(l: Log) : Unit / Log = Log.write("lvl=#{l.level}")

fn main() : Unit / Stdout = handle {
  emit(mk())
} with Log {
  write(s, resume) -> { Stdout.print(s)  resume(()) }
}
