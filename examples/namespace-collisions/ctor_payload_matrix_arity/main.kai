import a0
import a1
import a2
import a3

# The matrix over ARITY rather than payload type: the same name is
# nullary, unary, binary and ternary across four homes. Arity is what a
# resolver reaches for when the qualifier is ignored, so four different
# ones make every wrong home a compile error rather than a silent pass.
fn main() : Unit / Stdout =
  Stdout.print("#{a0.s(a0.Val)} #{a1.s(a1.Val(1))} #{a2.s(a2.Val(2, "x"))} #{a3.s(a3.Val(3, "y", true))}")
