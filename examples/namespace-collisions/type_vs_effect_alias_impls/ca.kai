#[derive(Eq, BinSerialize)]
pub type Tty = { n: Int }

impl Show for Tty { fn show(self: Tty) : String = "tty:#{self.n}" }

#[derive(Show, Eq, BinSerialize)]
pub type Holder = { t: Tty }

pub fn mk() : Tty = Tty { n: 3 }

pub fn round() : String = {
  let h = Holder { t: mk() }
  match from_bytes(to_bytes(h), 0) {
    Ok(c) -> { let back: Holder = c.value
               "#{back} #{back == h}" }
    Err(m) -> m
  }
}
