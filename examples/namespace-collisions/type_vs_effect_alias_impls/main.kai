import ca
import cb

# `ca` declares a record `Tty`; the only other `Tty` is `cb`'s row alias,
# which names no type. A hand-written impl, a derive and the writer a
# second derive calls for a `Tty` field each spell the record: the impl
# the runtime table files and the symbol a derived body calls are one.
fn main() : Unit / Stdout + Stderr = {
  cb.shout("hi")
  Stdout.print("#{[ca.mk()]}")
  Stdout.print(ca.round())
}
