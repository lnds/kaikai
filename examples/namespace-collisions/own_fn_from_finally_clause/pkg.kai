# A `finally` body rides the cleanup thunk, emitted from the same
# ClauseInfo side table as an op clause — no EFn-table rotation to this
# module, so a bare call to the module's own `one` can bind to a stdlib
# `one`.
effect Ask { get_it() : Int }

fn one(n: Int) : Int = n + 100

pub fn direct() : Int = one(1)

pub fn via_finally() : Int / Stdout = handle { Ask.get_it() } with Ask {
  get_it(resume) -> resume(1)
  finally { Stdout.print("#{one(1)}") }
}
