import pa
import pb

# Nesting past one level: a list of functions over the contested type,
# and both homes inside the same compound. The shallow arrangement only
# proves the walk descends once.
fn apply_all(fs: [(pa.Cfg) -> Int], c: pa.Cfg) : Int =
  reduce(fs | (f => f(c)), 0, (x, y) => x + y)

fn mixed(a: [pa.Cfg], b: [pb.Cfg]) : Int = list_length(a) + list_length(b)

fn main() : Unit / Stdout =
  Stdout.print("#{apply_all([(c) => c.v, (c) => c.v], pa.mk())} #{mixed([pa.mk()], [pb.mk()])}")
