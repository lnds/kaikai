import fa
import fb

# The two homes disagree on ARITY, so the first thing that goes wrong for
# either candidate is an argument count. The diagnostic must still name
# the real cause — that `Slot` names two constructors here — rather than
# report only the count against whichever home it happened to pick.
fn main() : Unit / Stdout = {
  let s = Slot(1)
  Stdout.print("x")
}
