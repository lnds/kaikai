import ea
import eb

# An inner handler for one module's `Emit` must not capture a perform
# of the other module's `Emit`, however the two are spelled: the
# evidence stack is keyed by the effect's identity, not its name.
fn main() : Unit / Stdout = {
  let r = handle {
    handle { ea.run_a() } with eb.Emit {
      send(s, resume) -> resume("WRONG")
    }
  } with ea.Emit {
    send(s, resume) -> resume("RIGHT")
  }
  Stdout.print(r)
}
