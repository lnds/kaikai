# The alias is bound first and the module lives under a directory: both
# qualifiers still reach the symbols minted under the module's path.
import lib.shapes as sh
import lib.shapes

fn main() : Unit / Stdout = {
  Stdout.print(sh.label(1))
  Stdout.print(shapes.label(2))
  Stdout.print(int_to_string(list_length(shapes.wrap(3))))
}
