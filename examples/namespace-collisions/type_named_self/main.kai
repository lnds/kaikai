# A type may be called `Self`. Inside a protocol `Self` is the protocol's
# own parameter; everywhere else it is this record.
type Self = { v: Int }

protocol Named {
  name(x: Self) : String
  same(x: Self, y: Self) : Self
}

impl Named for Int {
  fn name(x: Int) : String = "int"
  fn same(x: Int, y: Int) : Int = x + y
}

fn mk(n: Int) : Self = Self { v: n }

fn main() : Unit / Stdout = {
  Stdout.print(name(4))
  Stdout.print("#{same(1, 2)}")
  Stdout.print("#{mk(3).v}")
}
