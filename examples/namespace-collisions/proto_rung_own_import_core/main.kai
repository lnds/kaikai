# A module's own protocol outranks a homonym the core declares, and the
# core never sees a protocol of a module it does not import.

import pa

fn main() : Unit / Stdout = {
  let none: [Int] = []
  Stdout.print("#{pa.own_show()} #{7.show()} #{[1, 2]} #{Some(4)}")
  Stdout.print("#{pa.seed(none)} #{pa.seed([3])} #{list.sum([1, 2, 3])}")
}
