pub protocol Show { show(x: Self) : String }

pub type Tag = Tag(Int)

impl Show for Tag { fn show(x: Tag) : String = match x { Tag(n) -> "tag#{n}" } }

pub protocol Unit1 { one() : Self }

impl Unit1 for Int { fn one() : Int = 7 }

pub fn seed[t : Unit1](xs: [t]) : t = match xs {
  [] -> one()
  [h, ..._] -> h
}

pub fn own_show() : String = show(Tag(3))
