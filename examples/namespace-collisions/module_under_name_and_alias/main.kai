# One module imported under its own name and under an alias: both
# qualifiers reach the symbols the module was emitted under.
import shapes
import shapes as sh

fn main() : Unit / Stdout = {
  Stdout.print(shapes.label(1))
  Stdout.print(sh.label(2))
  Stdout.print(int_to_string(list_length(sh.wrap(3))))
}
