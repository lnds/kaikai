import tx
import ty
import tz

# Three homes for one spelling. Two can be told apart by any rule that
# picks "the other one"; three cannot, so the home has to be carried
# rather than inferred from the pair.
fn a(c: tx.Cfg) : String = tx.show(c)
fn b(c: ty.Cfg) : String = ty.show(c)
fn c3(c: tz.Cfg) : String = tz.show(c)

fn main() : Unit / Stdout =
  Stdout.print("#{a(tx.mk())} #{b(ty.mk())} #{c3(tz.mk())}")
