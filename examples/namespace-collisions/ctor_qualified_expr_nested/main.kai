import ea
import eb

# `Wrap` and `Done` are homonyms in two modules with divergent payloads.
# Each qualified constructor expression is an argument to a call that
# already fixes the other module's type, so the qualifier — not the
# expected type — has to pick the home.
fn main() : Unit / Stdout = {
  let a = ea.score(ea.Wrap(21))
  let b = eb.label(eb.Wrap("hi"))
  let c = ea.score(ea.Done)
  let d = eb.label(eb.Done)
  Stdout.print("#{a} #{b} #{c} #{d}")
}
