# A local binder spelled like the enclosing generic: the spec's
# self-call retarget must not claim it. The monomorphic control is
# `generic_root_vs_core_mono`.
fn shape[t](x: t, g: (t) -> Int) : Int = {
  let shape = g
  shape(x)
}

fn main() : Unit / Stdout = Stdout.print("#{shape(7, (n) => n * 3)}")
