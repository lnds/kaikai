# An imported module declares a type spelled like one the runtime numbers
# with a fixed head. Its impl is registered under the module type's own
# head: `show` passed as a value finds it for the module's values, and the
# core `Result`'s impl still answers for its own.

import lights

fn outcome(n: Int) : Result[Int, String] = if n > 0 { Ok(n) } else { Err("none") }

fn main() : Unit / Stdout = {
  Stdout.print(join(map(lights.cycle(), show), ","))
  Stdout.print(join(map([outcome(2), outcome(0)], show), ","))
}
