import loga
import logb

# Two imported modules each export an effect `Log` whose `write` op takes a
# different argument type. Both coexist: the qualifier names the home of
# each handler and each direct perform, and the module-local performs in
# `use_a`/`use_b` reach their own effect's handler.
fn main() : Unit / Stdout = {
  let a = handle { loga.Log.write(7); loga.use_a() }
          with loga.Log { write(n, resume) -> resume(Stdout.print("a:#{n}")) }
  let b = handle { logb.Log.write("direct"); logb.use_b() }
          with logb.Log { write(s, resume) -> resume(Stdout.print("b:#{s}")) }
  Stdout.print("#{a + b}")
}
