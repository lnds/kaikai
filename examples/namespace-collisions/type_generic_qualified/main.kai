import ga
import gb

# A contested generic head carries type arguments, so the respelling has
# to rewrite the head while recursing into the arguments. The two homes
# disagree on the body — record against sum — which is what makes a
# collapsed head observable rather than merely wrong in name.
fn peek(b: ga.Box[Int]) : Int = b.item
fn pick(b: gb.Box[Int]) : Int = gb.get(b)

fn main() : Unit / Stdout = Stdout.print("#{peek(ga.mk(3))} #{pick(gb.mk())}")
