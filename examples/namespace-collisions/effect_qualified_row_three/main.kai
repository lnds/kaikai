import qa
import qb
import qc

# Three homes, each declaring `/ Emit` in its own module-local row and
# each `put` at a different payload type. The existing pair leaves the
# handler heads adjacent; interleaving them means an outer head is still
# open when the next home's row is closed.
fn main() : Unit / Stdout = {
  handle {
    handle {
      handle { qa.run(); qb.run(); qc.run() }
      with qc.Emit { put(b, resume) -> resume(Stdout.print("qc:#{b}")) }
    } with qb.Emit { put(n, resume) -> resume(Stdout.print("qb:#{n}")) }
  } with qa.Emit { put(s, resume) -> resume(Stdout.print("qa:#{s}")) }
}
