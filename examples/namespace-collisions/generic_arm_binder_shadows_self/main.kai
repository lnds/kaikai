# The shadowing binder arrives from a match arm rather than a `let`,
# and is called, so the retarget walker must extend scope per arm.
fn hold[T](fs: [(T) -> Int], d: T) : Int = match fs {
  []           -> 0
  [hold, ..._] -> hold(d)
}

fn main() : Unit / Stdout =
  Stdout.print("#{hold([(n: Int) => n * 5], 4)}")
