# The module `Box` and the type `Box` are unrelated; they share a spelling.
# A qualifier must be resolved against the module table before the type
# table, or `Box.mk` is read as a constructor of the foreign type.
import Box
import other

fn main() : Unit / Stdout =
  Stdout.print("#{Box.show(Box.mk(3))} #{other.oshow(other.omk("z"))}")
