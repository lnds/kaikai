# Second arrangement of the lambda-body cell: the homonym lives in
# another user module that this one imports, not in stdlib. The lifted
# lambda must still reach this module's `one`.
import other

fn one(n: Int) : Int = n + 100

pub fn via_lambda(xs: [Int]) : [Int] = xs | (x) => one(x)
pub fn via_qualified(xs: [Int]) : [Int] = xs | (x) => other.one(x)
