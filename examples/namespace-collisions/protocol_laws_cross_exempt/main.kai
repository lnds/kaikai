# Two `Sequence : Functorial` protocols. Only `la`'s impl carries the
# `axiom Functorial` exemption, so `kai check` generates law checks for
# this file's impl alone: 6 checks. An exemption keyed by the bare protocol
# name would silence it too (0 checks).
import la

pub protocol Sequence[s: Shape] : Functorial {
  map(xs: s[Int], f: (Int) -> Int) : s[Int]
  foldl(xs: s[Int], init: Int, f: (Int, Int) -> Int) : Int
}

pub type Rope[a] = Knot | Strand(a, Rope[a])

impl Sequence for Rope {
  fn map(xs: Rope[Int], f: (Int) -> Int) : Rope[Int] = match xs {
    Knot         -> Knot
    Strand(h, t) -> Strand(f(h), map(t, f))
  }
  fn foldl(xs: Rope[Int], init: Int, f: (Int, Int) -> Int) : Int = match xs {
    Knot         -> init
    Strand(h, t) -> foldl(t, f(init, h), f)
  }
}

pub fn sum(r: Rope[Int]) : Int = foldl(r, 0, (a, b) => a + b)

fn main() : Unit / Stdout = Stdout.print("#{la.sum(la.Link(1, la.Link(2, la.Nil0)))} #{sum(Strand(3, Knot))}")
