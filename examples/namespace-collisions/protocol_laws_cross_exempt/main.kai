# Two `Sequence : Functorial` protocols. Only `la`'s impl carries the
# `axiom Functorial` exemption, so `kai check` generates law checks for
# `lb`'s impl alone: 6 checks. An exemption keyed by the bare protocol
# name would silence `lb` too (0 checks); one that misses `la` would
# double them (12).
import la
import lb

fn main() : Unit / Stdout = Stdout.print("#{la.sum(la.Link(1, la.Link(2, la.Nil0)))} #{lb.sum(lb.Strand(3, lb.Knot))}")
