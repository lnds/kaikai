import ea
import eb

# eb.Emit is handled only inside the inner block; the trailing eb.run()
# escapes to a scope that handles ea.Emit alone.
fn main() : Unit / Stdout = {
  handle {
    handle { ea.run() } with eb.Emit { put(s, resume) -> resume(Stdout.print("inner-b:#{s}")) }
    eb.run()
  } with ea.Emit { put(s, resume) -> resume(Stdout.print("outer-a:#{s}")) }
}
