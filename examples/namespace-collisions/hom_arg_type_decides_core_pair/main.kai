# `is_empty` and `filter` are declared by more than one auto-loaded core
# module. Both calls sit where the argument's type is only known once
# the lambda's parameter is pinned, and both mean the list one.
type Bag = { entries: [Int] }

fn empty_of(r: Result[Bag, String]) : Result[Bool, String] =
  r.map(b => is_empty(b.entries))

fn evens_of(r: Result[Bag, String]) : Result[[Int], String] =
  r.map(b => filter(b.entries, n => n % 2 == 0))

fn main() : Unit / Stdout = {
  match empty_of(Ok(Bag { entries: [] })) {
    Ok(v)  -> Stdout.print("#{v}")
    Err(e) -> Stdout.print(e)
  }
  match evens_of(Ok(Bag { entries: [1, 2, 3, 4] })) {
    Ok(xs) -> Stdout.print("#{xs}")
    Err(e) -> Stdout.print(e)
  }
}
