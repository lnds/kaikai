import Emit

# The module and the effect it exports carry the SAME name. `Emit.run`
# and `Emit.ping` are module members while `Emit.put` inside the module is
# an op of the effect, and the bare handler head names the effect, not the
# module. The existing pair keeps the two names apart; here one spelling
# serves both and only the position tells them apart.
fn main() : Unit / Stdout = {
  handle { Emit.run() } with Emit { put(s, resume) -> resume(Stdout.print(s)) }
  Stdout.print(Emit.ping())
}
