# `a.Ask` and `b.Ask` are distinct effects. The inner handler answers only
# `a.Ask`, so `b.Ask.ask()` must reach the outer handler; evidence pushed
# under a bare label would let the inner handler capture both.
import a
import b

fn main() : Unit / Stdout = {
  let r = handle {
    handle {
      let inner = a.Ask.ask()
      let outer = b.Ask.ask()
      inner * 10 + outer
    } with a.Ask { ask(resume) -> resume(1) }
  } with b.Ask { ask(resume) -> resume(2) }
  Stdout.print("#{r}")
}
