import l1
import l2
import l3
import l4
import l5
import l6
import l7
import l8

fn main() : Unit / Stdout = {
  let n8 = l8.Node(8)
  let n7 = l7.Node(7)
  let n6 = l6.Node(6)
  let n5 = l5.Node(5)
  let n4 = l4.Node(4)
  let n3 = l3.Node(3)
  let n2 = l2.Node(2)
  let n1 = l1.Node(1)
  Stdout.print("#{l8.s8(n8)} #{l7.s7(n7)} #{l6.s6(n6)} #{l5.s5(n5)} #{l4.s4(n4)} #{l3.s3(n3)} #{l2.s2(n2)} #{l1.s1(n1)}")
  let m8 = match n8 { l8.Node(v) -> v }
  let m5 = match n5 { l5.Node(v) -> v }
  let m1 = match n1 { l1.Node(v) -> v }
  Stdout.print("#{m8}#{m5}#{m1}")
}
