import l1
import l2
import l3
import l4
import l5
import l6
import l7
import l8
import hub

fn main() : Unit / Stdout = {
  let n8 = l8.Node(8)
  let n7 = l7.Node(7)
  let n6 = l6.Node(6)
  let n5 = l5.Node(5)
  let n4 = l4.Node(4)
  let n3 = l3.Node(3)
  let n2 = l2.Node(2)
  let n1 = l1.Node(1)
  Stdout.print("#{hub.s8(n8)} #{hub.s7(n7)} #{hub.s6(n6)} #{hub.s5(n5)} #{hub.s4(n4)} #{hub.s3(n3)} #{hub.s2(n2)} #{hub.s1(n1)}")
  Stdout.print("#{hub.s1(l1.Node(10))} #{hub.s8(l8.Node(80))}")
}
