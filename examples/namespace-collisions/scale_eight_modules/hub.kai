import l1
import l2
import l3
import l4
import l5
import l6
import l7
import l8

pub fn s1(x: l1.L1) : String = match x { Node(n) -> "1:#{n}" }
pub fn s2(x: l2.L2) : String = match x { Node(n) -> "2:#{n}" }
pub fn s3(x: l3.L3) : String = match x { Node(n) -> "3:#{n}" }
pub fn s4(x: l4.L4) : String = match x { Node(n) -> "4:#{n}" }
pub fn s5(x: l5.L5) : String = match x { Node(n) -> "5:#{n}" }
pub fn s6(x: l6.L6) : String = match x { Node(n) -> "6:#{n}" }
pub fn s7(x: l7.L7) : String = match x { Node(n) -> "7:#{n}" }
pub fn s8(x: l8.L8) : String = match x { Node(n) -> "8:#{n}" }
