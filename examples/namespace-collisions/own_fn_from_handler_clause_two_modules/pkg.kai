# Second arrangement of the clause-body cell: the homonym is in another
# user module rather than stdlib.
import other

effect Ask { get_it() : Int }

fn one(n: Int) : Int = n + 100

pub fn via_clause() : Int = handle { Ask.get_it() } with Ask {
  get_it(resume) -> resume(one(1))
}

pub fn via_clause_qualified() : Int = handle { Ask.get_it() } with Ask {
  get_it(resume) -> resume(other.one(1))
}
