import l1
import l3

# Four homes contesting one spelling down a chain, each layer naming the
# one below. Three modules prove the walk carries a home; four prove it
# does not drift as the chain lengthens.
fn top(c: l3.Cfg) : String = l3.show(c)

fn main() : Unit / Stdout =
  Stdout.print("#{l3.down()} #{top(l3.mk())} #{l1.show(l1.mk())}")
