# The root declares a SUM named `Pair`, whose constructor takes a
# payload. A record head `Pair { … }` names a record, and the only
# record of that name is the core's: the literal builds it in every
# form (named in either order, positional, spread) and the pattern
# matches it, while `Pair(…)` stays the root's constructor.
type Pair = Pair(Int, String)

fn label(p: Pair) : String = match p {
  Pair(n, s) -> "#{s}#{n}"
}

fn total(t: (Int, Int)) : Int = match t {
  Pair { fst: a, snd: b } -> a * 10 + b
}

fn main() : Unit / Stdout = {
  let core = Pair { fst: 1, snd: 2 }
  let swapped = tuple.swap(Pair { fst: 3, snd: 4 })
  let reversed = Pair { snd: 6, fst: 5 }
  let positional = Pair { 7, 8 }
  let updated = Pair { ...core, snd: 9 }
  Stdout.print("#{total(core)} #{total(swapped)} #{total(reversed)} #{total(positional)} #{total(updated)} #{label(Pair(7, "own"))}")
}
