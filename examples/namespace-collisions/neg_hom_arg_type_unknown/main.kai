# Both modules export `weigh`, and the lambda's parameter is never
# applied to anything, so its type never settles. That is the genuine
# ambiguity: no rule picks a candidate, and the report names both and
# the qualified form that resolves it.
import ua
import ub

fn main() : Unit / Stdout = {
  let _f = (x) => weigh(x)
  Stdout.print("unreachable")
}
