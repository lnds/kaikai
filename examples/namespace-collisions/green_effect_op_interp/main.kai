import ea
import eb

# Two imported modules each declare an effect `Tick`. A qualified perform
# inside a `#{...}` interpolation must pick its home's effect: the
# fragment is parsed after the decl-level effect scoping ran, so the
# respelling has to be re-applied to it.
fn main() : Unit / Stdout =
  handle {
    handle {
      Stdout.print("#{ea.Tick.tick(1)} #{eb.Tick.tick(2)}")
    } with eb.Tick {
      tick(v, resume) -> resume(v + 200)
    }
  } with ea.Tick {
    tick(v, resume) -> resume(v + 100)
  }
