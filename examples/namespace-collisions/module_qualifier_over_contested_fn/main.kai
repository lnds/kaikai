# `qa` and `qb` both export a function `pick`, and a module is also
# named `pick`. A module qualifier outranks a value of the same
# spelling, so `pick.from(1)` names the module and keeps its qualifier
# rather than resolving as the contested function.
import pick
import qa
import qb

fn main() : Unit / Stdout = {
  Stdout.print(pick.from(1))
  Stdout.print(qa.pick())
  Stdout.print(qb.pick())
}
