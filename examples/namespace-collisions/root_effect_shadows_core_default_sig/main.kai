# The same shadow with ops whose signatures do not match the prelude's.
# Absorbing the label here reaches a clause expecting a String with two
# Ints, which is the shape that corrupts memory rather than misbehaving.
effect Log {
  note(a: Int, b: Int) : Int
}

fn work() : Int / Log = Log.note(7, 9)

fn main() : Int / Log = work()
