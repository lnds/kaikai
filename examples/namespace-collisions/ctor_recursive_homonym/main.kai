import ra
import rb

fn count(c: rb.Chain) : Int = match c {
  rb.Leaf    -> 0
  rb.Link(n) -> 1 + count(n)
}

fn main() : Unit / Stdout = {
  let chain = rb.Link(rb.Link(rb.Leaf))
  let tree = ra.Node2(ra.Leaf, ra.Node2(ra.Leaf, ra.Leaf))
  let leaves = match tree {
    ra.Leaf        -> 0
    ra.Node2(l, r) -> ra.depth(l) + ra.depth(r)
  }
  Stdout.print("#{rb.len(chain)} #{count(chain)} #{ra.depth(tree)} #{leaves} #{rb.len(rb.grow(chain))}")
}
