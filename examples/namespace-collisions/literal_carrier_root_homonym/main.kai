# A root type named like the carrier of decimal literals. A bare
# `Decimal` here is the file's own declaration; a `d` literal is still
# the stdlib carrier, a different type with its own fields.
type Decimal = { digits: String }

fn show_d(d: Decimal) : String = d.digits

fn main() : Unit / Stdout = {
  Stdout.print(show_d(Decimal { digits: "12" }))
  let lit = 2.50d
  Stdout.print(int_to_string(lit.scale))
}
