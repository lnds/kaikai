# `render` is declared by a protocol of `pa` and by one of `pb`. In a
# generic body the receiver is a type parameter, so nothing is chosen
# there: each specialisation is answered by the protocol with an impl for
# its type, whether the operation is called as a method, called bare, or
# handed over as a function.
import pa
import pb

fn once[a](x: a) : String = x.render()

fn twice[a](x: a) : String = "#{render(x)}#{render(x)}"

fn each[a](xs: [a]) : [String] = map(xs, render)

fn main() : Unit / Stdout =
  Stdout.print("#{once(pa.A(1))} #{once(pb.B(2))} #{twice(pa.A(3))} #{twice(pb.B(4))} #{each([pa.A(5)])} #{each([pb.B(6), pb.B(7)])}")
