import oa
import ob

# In `oa` the type and its only constructor share one spelling, and `ob`
# contests that spelling with a record type. The qualifier has to reach
# the type in annotation position and the constructor in expression
# position, from the same `oa.Cfg` text.
fn a(c: oa.Cfg) : Int = oa.get(c)
fn b(c: ob.Cfg) : String = c.v

fn main() : Unit / Stdout = Stdout.print("#{a(oa.Cfg(9))} #{b(ob.mk())}")
