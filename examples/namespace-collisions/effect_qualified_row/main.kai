import qa
import qb

# Each module's `run` declares `/ Emit` in its own row, resolving to its
# own `Emit`; the root closes each with a qualified handler head and the
# two ops keep their distinct signatures (String vs Int).
fn main() : Unit / Stdout = {
  handle { qa.run() } with qa.Emit { put(s, resume) -> resume(Stdout.print("qa:#{s}")) }
  handle { qb.run() } with qb.Emit { put(n, resume) -> resume(Stdout.print("qb:#{n + 1}")) }
}
