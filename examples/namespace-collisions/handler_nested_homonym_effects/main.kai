import na
import nb

# Nesting handlers for two HOMONYMOUS effects, alternating homes down the
# stack. The existing fixture nests one effect twice, where the innermost
# handler is simply the nearest; here the nearest handler for `na.Deep` is
# two levels out, past a `nb.Deep` handler spelled identically.
fn main() : Unit / Stdout = {
  let r = handle {
    handle {
      handle {
        na.ask() * 100 + nb.ask() * 10 + na.ask()
      } with nb.Deep { get(resume) -> resume(2) }
    } with na.Deep { get(resume) -> resume(1) }
  } with nb.Deep { get(resume) -> resume(9) }
  Stdout.print("#{r}")
}
