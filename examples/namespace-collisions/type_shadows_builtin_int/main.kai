import ba

# `ba.Int` is a qualified reference and must select the module's own
# declaration. Today the annotation resolves to it while the record
# literal at the call site collapses to the builtin, so the two halves
# of one call disagree: `expected: (Int) -> Bool` against
# `found: (ba.Int) -> ?t2`.
fn g(x: ba.Int) : Bool = x.wrapped

fn main() : Unit / Stdout = Stdout.print("#{g(ba.Int { wrapped: true })}")
