# `one` is also a stdlib name (math.bigint.one, math.complex.one,
# rational.one), all of arity 0. The bare call below is inside a lifted
# lambda body, which is emitted from a side table rather than from the
# Decl loop — the path that does not rotate the EFn table to this
# module. Without the rotation the call binds to whichever `one` sits
# first in the global table.
pub fn shift(n: Int) : Int = one(n)

fn one(n: Int) : Int = n + 100

pub fn via_lambda(xs: [Int]) : [Int] = xs | (x) => one(x)
