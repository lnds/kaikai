# A call passes over a nearer binding whose arity does not fit and
# reaches the core function that does, whatever wraps the declaration.

pub type Span = { lo: Int, hi: Int }

#[constructor]
pub fn last(lo: Int, hi: Int) : Span = Span { lo: lo, hi: hi }

#[doc("Two-argument max.")]
fn max(a: Int, b: Int) : Int = if a > b { a } else { b }

#[unstable]
pub fn min(a: Int, b: Int) : Int = if a < b { a } else { b }

fn add2(a: Int, b: Int) : Int = a + b

fn main() : Unit / Stdout = {
  let length = (a: Int, b: Int) => a + b
  let reverse: (Int, Int) -> Int = add2
  let show = (a: Int, b: Int) => a * b
  Stdout.print(int_to_string(max(1, 2)) ++ " " ++ int_to_string(min(1, 2)))
  Stdout.print(int_to_string(length(3, 4)) ++ " " ++ int_to_string(reverse(5, 6)) ++ " " ++ int_to_string(show(2, 3)))
  Stdout.print(show(5))
  match max([3, 9, 4]) {
    Some(m) -> Stdout.print(int_to_string(m))
    None    -> Stdout.print("none")
  }
  match min([3, 9, 4]) {
    Some(m) -> Stdout.print(int_to_string(m))
    None    -> Stdout.print("none")
  }
  Stdout.print(int_to_string(length([1, 2, 3])))
  Stdout.print(int_to_string(list_length(reverse([1, 2]))))
  Stdout.print(int_to_string(Span(1, 2).hi))
  match last([7, 8]) {
    Some(m) -> Stdout.print(int_to_string(m))
    None    -> Stdout.print("none")
  }
}
