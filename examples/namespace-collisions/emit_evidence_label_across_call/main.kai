import ea
import eb
import mid

# `ea.Ask` and `eb.Ask` are distinct effects performed on both sides of a
# module call. The existing fixture performs both in one body; here the
# inner handler is closed around a call whose own row names only one of
# them, so evidence pushed under a bare label lets the inner handler
# answer the outer effect too.
fn main() : Unit / Stdout = {
  let r = handle {
    handle {
      mid.both() * 100 + eb.get() * 10 + ea.get()
    } with ea.Ask { ask(resume) -> resume(1) }
  } with eb.Ask { ask(resume) -> resume(2) }
  Stdout.print("#{r}")
}
