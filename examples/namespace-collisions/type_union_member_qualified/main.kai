import ua
import ub

# Two homonymous types are two distinct symbols, so a union over both
# has to be nameable. Every other type position accepts `m.T`; the
# union member is the one that does not, which leaves this union
# unspellable — there is no bare name that means either one.
type Both = ua.Cfg | ub.Cfg

fn describe(u: Both) : String = match u {
  a: ua.Cfg -> "from-a"
  b: ub.Cfg -> "from-b"
}

fn main() : Unit / Stdout = Stdout.print(describe(ua.Alpha))
