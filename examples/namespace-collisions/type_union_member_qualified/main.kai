import ua
import ub

# Two homonymous types are two distinct symbols, so a union over both
# has to be nameable, and qualifying is the only way to tell them
# apart.
type Both = ua.Cfg | ub.Cfg

fn describe(u: Both) : String = match u {
  _a: ua.Cfg -> "from-a"
  _b: ub.Cfg -> "from-b"
}

fn main() : Unit / Stdout = {
  Stdout.print(describe(ua.Alpha))
  Stdout.print(describe(ub.Gamma))
}
