# An operation with no argument is received by its result. `c` and `d`
# say what theirs is; `z` never does, and two protocols declare `blank`.
import pc
import pd

fn main() : Unit / Stdout = {
  let c : pc.C = blank()
  let d : pd.D = blank()
  let z = blank()
  Stdout.print("#{pc.c_text(c)} #{pd.d_text(d)}")
}
