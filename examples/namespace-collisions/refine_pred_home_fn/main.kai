# `Even`'s predicate calls the `ok` its own module declares. The root
# file's `ok` answers nothing of it, wherever `Even` is checked: on a
# parameter, or on a binding.
import m

fn ok(n: Int) : Bool = n > 100

fn take(x: m.Even) : Int = x

fn main() : Unit / Stdout = {
  let e : m.Even = take(4)
  Stdout.print("#{take(8) + m.half(e)} #{ok(7)}")
}
