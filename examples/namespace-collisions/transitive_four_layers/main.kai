import t4

# Four layers deep, each rebinding `Err`/`Failure`/`Clean` at a different
# arity. Main sees only the top; every resolution below it happened in a
# module that had all the lower homes in scope at once.
fn main() : Unit / Stdout = {
  Stdout.print(t4.all())
  Stdout.print(t4.show(t4.mk("z", 9)))
  Stdout.print(t4.show(t4.Clean))
}
