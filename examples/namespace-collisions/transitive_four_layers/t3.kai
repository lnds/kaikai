import t1
import t2

pub type Err = Failure(Bool) | Clean

pub fn mk(b: Bool) : Err = Failure(b)
pub fn show(e: Err) : String = match e { Failure(b) -> "L3:#{b}"  Clean -> "L3:clean" }

# Reaches PAST its neighbour to the bottom layer: the name is bound three
# times between here and there.
pub fn down1() : String = t1.show(t1.mk("b"))
pub fn down2() : String = t2.show(t2.mk(2))
