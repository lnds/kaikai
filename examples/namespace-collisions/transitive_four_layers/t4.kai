import t1
import t2
import t3

pub type Err = Failure(String, Int) | Clean

pub fn mk(m: String, n: Int) : Err = Failure(m, n)
pub fn show(e: Err) : String = match e { Failure(m, n) -> "L4:#{m}#{n}"  Clean -> "L4:clean" }
pub fn all() : String = "#{t3.down1()} #{t3.down2()} #{t2.down()} #{t1.show(t1.Clean)}"
