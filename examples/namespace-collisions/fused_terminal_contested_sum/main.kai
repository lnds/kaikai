# Two imports export a `sum`, and a `map`-pipe chain ends in it. The
# chain's value is a list, which is the argument only mod_a's takes: the
# terminal is that declaration, not the core fold its spelling suggests.
import mod_a
import mod_b

fn main() : Unit / Stdout = {
  let chained = [1..4] | (n) => n * 2 |> sum()
  let ranged = [1..4] |> sum()
  Stdout.print("#{chained} #{ranged} #{sum("text")}")
}
