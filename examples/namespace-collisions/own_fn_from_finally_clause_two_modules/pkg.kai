# Second arrangement of the finally-body cell: the homonym is in another
# user module rather than stdlib.
import other

effect Ask { get_it() : Int }

fn one(n: Int) : Int = n + 100

pub fn via_finally() : Int / Stdout = handle { Ask.get_it() } with Ask {
  get_it(resume) -> resume(1)
  finally { Stdout.print("#{one(1)} #{other.one(1)}") }
}
