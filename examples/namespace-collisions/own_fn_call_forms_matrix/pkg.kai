# Every way a module body can reach its own `one` when stdlib also
# exports that name. The direct, point-free and test forms already
# resolve to the module's fn; the lambda and clause forms are emitted
# from side tables. All five must agree.
effect Ask { get_it() : Int }

fn one(n: Int) : Int = n + 100

pub fn direct(n: Int) : Int = one(n)
pub fn point_free(xs: [Int]) : [Int] = xs | one
pub fn in_lambda(xs: [Int]) : [Int] = xs | (x) => one(x)
pub fn in_clause() : Int = handle { Ask.get_it() } with Ask {
  get_it(resume) -> resume(one(1))
}
