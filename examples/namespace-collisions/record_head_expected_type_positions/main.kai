# The root declares its own `Cell`, which a bare head reaches first.
# Wherever a type is expected the head is that type's record instead:
# a block's tail in a function body, both arms of an `if` and of a
# `match`, a record field, a list element, and an argument on the
# method, pipe, narrowed and operation call paths.
import mod_b
import mod_c

type Cell = { hi: Int, lo: Int, x: Int }

fn tail(n: Int) : mod_b.Cell {
  let k = n + 1
  Cell { hi: k, lo: n }
}

fn branch(up: Bool) : mod_b.Cell = if up { Cell { hi: 9, lo: 8 } } else {
  let z = 0
  Cell { hi: 1, lo: z }
}

fn arm(n: Int) : mod_b.Cell = match n {
  0 -> Cell { hi: 0, lo: 0 }
  _ -> Cell { hi: n, lo: 1 }
}

fn pen() : mod_b.Pen = mod_b.Pen { n: 2, tip: Cell { hi: 5, lo: 4 } }

fn cells() : [mod_b.Cell] = [Cell { hi: 3, lo: 2 }, Cell { hi: 7, lo: 6 }]

fn send() : Unit / mod_b.Sink = mod_b.Sink.put(Cell { hi: 12, lo: 11 })

fn main() : Unit / Stdout = {
  let base = tail(1)
  let method = base.glue(Cell { hi: 4, lo: 3 })
  let piped = base |> mod_b.stretch(Cell { hi: 20, lo: 10 })
  let narrowed = weld(base, Cell { hi: 6, lo: 5 })
  let sent = handle {
    send()
    "sent"
  } with mod_b.Sink {
    put(c, resume) -> resume(())
  }
  Stdout.print("#{mod_b.show(base)} #{mod_b.show(branch(true))} #{mod_b.show(branch(false))} #{mod_b.show(arm(0))} #{mod_b.show(arm(5))}")
  Stdout.print("#{mod_b.show(pen().tip)} #{length(cells())} #{method} #{mod_b.show(piped)} #{narrowed} #{weld(1, 2)} #{sent}")
}
