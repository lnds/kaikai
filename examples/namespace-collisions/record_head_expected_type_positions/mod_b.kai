pub type Cell = { lo: Int, hi: Int }

pub effect Sink { put(c: Cell) : Unit }

pub fn show(c: Cell) : String = "#{c.lo}..#{c.hi}"

pub fn glue(c: Cell, d: Cell) : String = "#{show(c)}+#{show(d)}"

pub fn weld(c: Cell, d: Cell) : String = "#{show(c)}|#{show(d)}"

pub fn stretch(c: Cell, d: Cell) : Cell = Cell { lo: c.lo, hi: d.hi }

pub type Pen = { tip: Cell, n: Int }
