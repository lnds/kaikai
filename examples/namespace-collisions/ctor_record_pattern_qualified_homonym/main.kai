# Two modules declare a homonymous record; each arm's qualifier picks
# the one it means, and the head respells with the declaration its
# scrutinee's type took.
import ma
import mb

fn from_a(c: ma.Cell) : Int = match c {
  ma.Cell { lo: a, hi: b } -> a * 10 + b
}

fn from_b(c: mb.Cell) : Int = match c {
  mb.Cell { left: a, right: b } -> a * 10 + b
}

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(from_a(ma.Cell { lo: 1, hi: 2 })))
  Stdout.print(int_to_string(from_b(mb.Cell { left: 3, right: 4 })))
}
