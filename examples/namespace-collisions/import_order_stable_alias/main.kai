# The homonyms of `neg_import_order_alias_ties`, qualified through their
# aliases. The alias each call names picks the module, so reversing the
# two imports leaves the output alone.
import tb as second
import ta as first

fn main() : Unit / Stdout = {
  Stdout.print("a=#{first.render()}")
  Stdout.print("b=#{second.render()}")
}
