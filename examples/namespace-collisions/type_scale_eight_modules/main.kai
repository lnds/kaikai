import e1
import e2
import e3
import e4
import e5
import e6
import e7
import e8

# Eight homes contesting one spelling. The table that keys types by
# home has to stay correct past the point where a linear scan or a
# small hash would start colliding.
fn t1(c: e1.Cfg) : String = e1.show(c)
fn t2(c: e2.Cfg) : String = e2.show(c)
fn t3(c: e3.Cfg) : String = e3.show(c)
fn t4(c: e4.Cfg) : String = e4.show(c)
fn t5(c: e5.Cfg) : String = e5.show(c)
fn t6(c: e6.Cfg) : String = e6.show(c)
fn t7(c: e7.Cfg) : String = e7.show(c)
fn t8(c: e8.Cfg) : String = e8.show(c)

fn main() : Unit / Stdout =
  Stdout.print("#{t1(e1.mk())} #{t2(e2.mk())} #{t3(e3.mk())} #{t4(e4.mk())} #{t5(e5.mk())} #{t6(e6.mk())} #{t7(e7.mk())} #{t8(e8.mk())} ")
