import la
import lb

# Two imported modules each declare a nominal `Box`. A qualified record
# literal inside a `#{...}` interpolation must be respelled to its home
# (`la.Box` -> `Box__la`) like every other use site: the fragments are
# parsed long after the decl-level type scoping ran, so the respelling
# has to be re-applied to them.
fn main() : Unit / Stdout =
  Stdout.print("#{la.port(la.Box { a: 1 })} #{lb.port(lb.Box { b: 2 })}")
