# Two imports declare `widen` and one declares `solo`. A diagnostic about
# a call names the callee under its module only where the program holds
# a second declaration of the name: `ca.widen`, but plain `solo`.
import ca
import cb

fn main() : Unit / Stdout = {
  let a = ca.widen(1)
  let b = solo(1, 2)
  Stdout.print("#{a + b + cb.widen(1)}")
}
