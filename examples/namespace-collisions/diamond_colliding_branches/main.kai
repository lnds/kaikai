import dbase
import dleft
import dright

fn main() : Unit / Stdout = {
  let r = dright.Failure(true)
  let l = dleft.Failure(1)
  let b = dbase.Failure("x")
  Stdout.print("#{dleft.via("x")} #{dright.rshow(r)} #{dleft.lshow(l)} #{dbase.show(b)}")
  let here = match r { dright.Failure(v) -> "main-right:#{v}" }
  let there = match l { dleft.Failure(v) -> "main-left:#{v}" }
  let base = match b { dbase.Failure(v) -> "main-base:#{v}" }
  Stdout.print("#{here} #{there} #{base}")
}
