import cb
import cm

# The middle module declares its own `Cfg` alongside the one it imports.
# Two homes now offer the name, so the bare form is contested and each
# use names the home it means.
fn a(c: cb.Cfg) : String = cb.show(c)
fn b(c: cm.Cfg) : String = cm.show(c)

fn main() : Unit / Stdout = Stdout.print("#{a(cb.mk())} #{b(cm.mk())}")
