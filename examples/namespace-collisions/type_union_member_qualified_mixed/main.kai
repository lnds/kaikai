import ua

type Local = Solo

# One member qualified, one local and bare. A union has to accept both
# spellings in the same declaration; today the qualified one is what the
# parser refuses.
type Both = ua.Cfg | Local

fn describe(u: Both) : String = match u {
  a: ua.Cfg -> "imported"
  l: Local -> "local"
}

fn main() : Unit / Stdout = Stdout.print(describe(Solo))
