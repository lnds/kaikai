import ua

type Local = Solo | Duo

# One member qualified, one local and bare. A union accepts both
# spellings in the same declaration.
type Both = ua.Cfg | Local

fn describe(u: Both) : String = match u {
  _a: ua.Cfg -> "imported"
  _l: Local -> "local"
}

fn main() : Unit / Stdout = Stdout.print(describe(Solo))
