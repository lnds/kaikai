# `Color` inside `keep` and `pair` is the function's own type parameter:
# the declared enum of the same name is not a candidate there, in the
# signature or in the body's annotations.
type Color = Red | Green

fn keep[color](x: color) : color {
  let y: color = x
  y
}

fn pair[color](x: color, y: color) : [color] = [x, y]

fn paint(c: Color) : String = match c {
  Red   -> "red"
  Green -> "green"
}

fn main() : Unit / Stdout = {
  Stdout.print("#{keep(41) + 1}")
  Stdout.print(keep("kept"))
  Stdout.print("#{list_length(pair(1.5, 2.5))}")
  Stdout.print(paint(keep(Green)))
}
