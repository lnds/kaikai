import spawn
import fa
import fb

# Both homonymous constructors are built inside spawned fibers and their
# values cross back through `await`. A fiber's heap is private and the
# result is copied out, so a shared tag between the two homes is decided
# on one side of the copy and read on the other.
fn main() : Unit / Stdout + Spawn = {
  nursery { n ->
    let one = n.spawn(() => fa.show(fa.Msg(1)))
    let two = n.spawn(() => fb.show(fb.Msg("x")))
    let three = n.spawn(() => fa.show(fa.Done))
    let four = n.spawn(() => fb.show(fb.Done))
    Stdout.print("#{n.await(one)} #{n.await(two)} #{n.await(three)} #{n.await(four)}")
  }
}
