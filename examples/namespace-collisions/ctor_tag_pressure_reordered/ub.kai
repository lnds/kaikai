# The same eight names in the REVERSE order: the ordinal a home assigns a
# name differs between the two, so a tag derived from the name alone maps
# `Aa` here onto `Hh` there.
pub type UB = Hh | Gg | Ff | Ee | Dd | Cc | Bb | Aa

pub fn t(x: UB) : Int = match x {
  Aa -> 0  Bb -> 1  Cc -> 2  Dd -> 3  Ee -> 4  Ff -> 5  Gg -> 6  Hh -> 7
}
