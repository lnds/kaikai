import ha

# A qualified handler head inside `#{...}` where the effect name is NOT
# contested: the qualifier pass never saw the span, so the head reached
# the typer still spelled `ha.Emit`.
fn main() : Unit / Stdout =
  Stdout.print("r=#{handle { ha.body() } with ha.Emit { put(s, resume) -> resume("got-" ++ s) }}")
