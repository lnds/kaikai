# A file that picks from `shapes`, or binds it under a qualifier, does
# not see its `Option`: a bare `Option` is the builtin.
import shapes.{wrap}
import shapes as sh

fn pick(n: Int) : Option[Int] = Some(n)

fn mine(o: sh.Option) : String = match o {
  sh.Nada -> "nada"
  sh.Algo(k) -> "algo #{k}"
}

fn main() : Unit / Stdout = {
  Stdout.print("#{pick(1)}")
  Stdout.print(mine(wrap(2)))
}
