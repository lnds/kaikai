import pa
import pb

# One op takes each home's `Cfg`. The benign arrangement names a single
# home throughout; here the two spellings sit in the same protocol, so a
# respelling keyed by anything but the annotation's own qualifier
# collapses them onto one home.
protocol Pair {
  from_a(self: Self, c: pa.Cfg) : String
  from_b(self: Self, c: pb.Cfg) : String
}

type Wrap = Wrap(Int)

impl Pair for Wrap {
  fn from_a(self: Wrap, c: pa.Cfg) : String = "a#{c.v}"
  fn from_b(self: Wrap, c: pb.Cfg) : String = "b#{c.s}"
}

fn main() : Unit / Stdout =
  Stdout.print("#{Wrap(0).from_a(pa.mk())} #{Wrap(0).from_b(pb.mk())}")
