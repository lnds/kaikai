import sn

# The binder `sn` is introduced by an outer sub-pattern and the module
# qualifier is then used by a NESTED sub-pattern to its right, and again
# in the arm's guard-free body. The existing pair binds at the top level;
# here the shadow is already in scope when the nested head is read.
fn describe(p: sn.Pair) : String = match p {
  sn.Both(sn.Ping(sn), sn.Ping(m)) -> "both=#{sn}/#{m}"
  sn.Both(sn.Ping(sn), sn.Pong)    -> "left=#{sn}"
  sn.Both(sn.Pong, sn.Ping(m))     -> "right=#{m}"
  sn.Both(sn.Pong, sn.Pong)        -> "neither-arm"
  sn.Neither                       -> "neither"
}

fn main() : Unit / Stdout = {
  Stdout.print(describe(sn.Both(sn.Ping(1), sn.Ping(2))))
  Stdout.print(describe(sn.Both(sn.Ping(3), sn.Pong)))
  Stdout.print(describe(sn.Both(sn.Pong, sn.Ping(4))))
  Stdout.print(describe(sn.Neither))
}
