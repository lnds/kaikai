# Top-level fns spelled like core builtins (`map`, `filter`, `each`,
# `reduce`) with boxed parameters, each calling the stdlib function of
# the same name. A call to one reaches the declaration, never the
# builtin's runtime shim, on every backend.

fn map(xs: [String], suffix: String) : [String] =
  if list.length(xs) == 0 { [] } else { list.map(xs, (s) => string_concat(s, suffix)) }

fn filter(xs: [String], keep: String) : [String] = {
  let tmp = ["t#{1}", "u#{2}"]
  let n = list.length(tmp)
  if n > 5 { tmp } else { list.filter(xs, (s) => s != keep) }
}

fn each(xs: [String], sep: String) : String = string.join(xs, sep)

fn reduce(xs: [String], init: String, sep: String) : String =
  list.foldl(xs, init, (acc, s) => acc ++ sep ++ s)

fn main() : Unit / Stdout = {
  Stdout.print(string.join(map(["a", "b"], "!"), ","))
  Stdout.print(string.join(filter(["a", "b", "c"], "b"), ","))
  Stdout.print(each(["x", "y"], "+"))
  Stdout.print(reduce(["p", "q"], "0", "-"))
}
