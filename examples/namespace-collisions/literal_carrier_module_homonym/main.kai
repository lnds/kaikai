# `import decimal` binds the module beside this file, not the stdlib
# one: the bare type, the bare functions and the qualifier are all the
# local module's.
import decimal

fn main() : Unit / Stdout = {
  let d : Decimal = make("42")
  Stdout.print(to_string(d))
  Stdout.print(decimal.to_string(decimal.make("7")))
}
