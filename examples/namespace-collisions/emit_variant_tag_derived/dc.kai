import da
import db

# Each home gets a `Show` that prints a different shape for the same two
# constructor names, so a value routed to the wrong impl is visible in the
# output rather than merely mis-tagged.
impl Show for da.Mark {
  fn show(m: da.Mark) : String = match m { Tok(n) -> "mark<#{n}>"  Blank -> "mark<>" }
}

impl Show for db.Sign {
  fn show(s: db.Sign) : String = match s { Tok(n) -> "sign[#{n}]"  Blank -> "sign[]" }
}
