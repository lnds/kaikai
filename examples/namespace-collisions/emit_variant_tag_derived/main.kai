import da
import db
import dc

# Two homes carry `Show` impls for the same constructor names. The impl is
# selected through the runtime tag, so a shared tag between the homes
# routes one home's value into the other's printer — inside a list too,
# where the element's own tag is the only thing left to dispatch on.
fn main() : Unit / Stdout = {
  Stdout.print("#{da.Tok(1)} #{db.Tok(1)}")
  Stdout.print("#{da.Blank} #{db.Blank}")
  Stdout.print("#{[da.Tok(2), da.Blank]}")
  Stdout.print("#{[db.Tok(2), db.Blank]}")
}
