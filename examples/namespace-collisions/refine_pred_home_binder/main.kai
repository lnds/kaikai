# The predicate of `Low` reads `under` and `LIMIT` of its own module. A
# parameter and a constant of the file that uses `Low` share those
# spellings and are neither.
import m

const LIMIT : Int = 1

fn keep(under: Int, x: m.Low) : Int = x + under + LIMIT

fn main() : Unit / Stdout = Stdout.print("#{keep(1, 5)}")
