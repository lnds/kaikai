import ma
import mb
import mc

# `Foo` exists — in ma and mc, but not in mb. A resolver that falls back
# to "some module exports this name" once the named home comes up empty
# accepts `mb.Foo` and silently picks one of the other two.
fn main() : Unit / Stdout = {
  let good = ma.Foo(1)
  let also = mc.Foo(2)
  let v = mb.Foo(3)
  Stdout.print("x")
}
