# The op call and the handler head accept a module qualifier; the effect
# row of a signature must accept it too, or two homonymous effects can be
# told apart everywhere except the position where the ambiguity shows.
import ea

fn go() : Unit / ea.Emit = ea.Emit.put("x")

fn main() : Unit / Stdout = {
  with ea.Emit {
    put(s) -> { Stdout.print(s); resume(()) }
  } handle { go() }
}
