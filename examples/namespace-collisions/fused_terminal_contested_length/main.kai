# The `length` and `product` arrangement of a contested chain terminal:
# each is the import whose parameter is the chain's list.
import mod_a
import mod_b

fn main() : Unit / Stdout = {
  let counted = [1..4] | (n) => n + 1 |> length()
  let multiplied = [1..4] | (n) => n + 1 |> product()
  Stdout.print("#{counted} #{multiplied} #{length("text")} #{product("text")}")
}
