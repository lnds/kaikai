extern "C" pub type Item = { r: U8, g: U8 }

pub protocol Weigh {
  weigh(x: Self) : Int
}

impl Weigh for Item {
  fn weigh(x: Item) : Int = x.r + x.g
}

pub fn make() : Item = Item { r: 1, g: 2 }

pub fn red(i: Item) : Int = i.r

pub fn weight_all(xs: [Item]) : Int = match xs {
  []           -> 0
  [x, ...rest] -> weigh(x) + weight_all(rest)
}
