# The payload of `Wrap` is its parameter `Color`, whatever type fills it;
# the enum `Color` declared beside it must not decide how the slot is
# stored.
type Color = Red | Green

type Wrap[color] = Wrap(color)

type Held[color] = { item: color, n: Int }

fn unwrap[color](w: Wrap[color]) : color = match w {
  Wrap(x) -> x
}

fn paint(c: Color) : String = match c {
  Red   -> "red"
  Green -> "green"
}

fn main() : Unit / Stdout = {
  Stdout.print("#{unwrap(Wrap(41)) + 1}")
  Stdout.print(unwrap(Wrap("text")))
  Stdout.print(paint(unwrap(Wrap(Green))))
  let h = Held { item: 7, n: 1 }
  Stdout.print("#{h.item + h.n}")
}
