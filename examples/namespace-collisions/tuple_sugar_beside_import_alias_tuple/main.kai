# A module imported under the alias `tuple` declares its own `Pair`. Tuple
# sugar still names the core tuple type: it carries the core declaration's
# identity, not a qualifier the file's aliases could capture.

import foo as tuple

fn swap(t: (Int, Int)) : (Int, Int) = match t {
  (a, b) -> (b, a)
}

fn main() : Unit / Console = {
  let s = swap((1, 2))
  println(int_to_string(s.fst * 10 + s.snd))
  println(int_to_string(tuple.sum(tuple.P(3, 4))))
}
