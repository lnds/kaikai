# A root `Pair` and the core tuple `Pair` share a name and an arity.
# `Box[Pair[Int, Int]]` and `Box[(Int, Int)]` stay two instances in the
# row and at dispatch: an instance key names declarations, not spellings.

type Pair[a, b] = P(a, b)

effect Box[X] {
  peek() : X
}

fn peek_mine() : Pair[Int, Int] / Box[Pair[Int, Int]] = Box.peek()

fn peek_core() : (Int, Int) / Box[(Int, Int)] = Box.peek()

fn both() : String / Box[Pair[Int, Int]] + Box[(Int, Int)] = {
  let c = peek_core()
  let m = match peek_mine() { P(x, y) -> x * 10 + y }
  "core=#{int_to_string(c.fst)},#{int_to_string(c.snd)} mine=#{int_to_string(m)}"
}

fn main() : Unit / Stdout = {
  let r = handle {
    handle { both() } with Box[(Int, Int)] {
      peek(resume) -> resume((1, 2))
    }
  } with Box[Pair[Int, Int]] {
    peek(resume) -> resume(P(3, 4))
  }
  Stdout.print(r)
}
