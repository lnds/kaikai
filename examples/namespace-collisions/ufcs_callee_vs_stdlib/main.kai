# A root fn spelled like a stdlib export takes the receiver its parameter
# admits and carries its own id; the stdlib one keeps the rest.
fn reverse(x: Int) : Int = 0 - x

fn first(xs: [Int]) : String = match xs {
  [h, ..._] -> int_to_string(h)
  _         -> "empty"
}

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(5.reverse()))
  Stdout.print(first([3, 2, 1].reverse()))
}
