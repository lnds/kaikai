import pa
import pb

# Both modules declare `Box` and a `Holder` storing it; only `pa`'s
# reaches a cell. Each `Holder` stores its own module's `Box`, so a
# `pb.Holder` parameter carries nothing and `read` declares no row.
fn stamp(h: pb.Holder, out: Array[Int]) : Unit / Mutable {
  out[0] := h.box.n
}

fn read(h: pb.Holder) : Int {
  let out = array_make(1, 0)
  stamp(h, out)
  out[0]
}

fn main() : Unit / Stdout =
  Stdout.print("#{read(pb.mk(7))} #{array_length(pa.mk().box.cells)}")
