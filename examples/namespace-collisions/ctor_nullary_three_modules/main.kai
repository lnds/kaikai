import n1
import n2
import n3

fn main() : Unit / Stdout = {
  let c = n3.Idle
  let b = n2.Idle
  let a = n1.Idle
  let here = match c { n3.Idle -> "main-c" n3.Gone -> "gone" }
  let there = match b { n2.Idle -> "main-b" n2.Done -> "done" }
  Stdout.print("#{n3.tag(c)} #{n2.tag(b)} #{n1.tag(a)} #{here} #{there} #{n3.tag(n3.start())}")
}
