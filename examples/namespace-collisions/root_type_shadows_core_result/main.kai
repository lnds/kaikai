# The same shadow over a core type whose module is referenced from other
# core modules, so the reference crosses a core-to-core boundary.
type Result = Malo | Bueno(Int)

fn f(r: Result) : Int =
  match r {
    Malo -> 0
    Bueno(n) -> n
  }

fn main() : Unit / Stdout = Stdout.print("#{f(Bueno(9))}")
