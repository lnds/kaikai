# The impl binds `a` and so does its method: two parameters that share a
# spelling. Inside the method its own `a` answers.
protocol Tagged {
  tag(x: Self) : String
}

type Box[a] = { v: a }

impl[a] Tagged for Box[a] {
  fn tag[a](x: Box[a]) : String = "box"
}

fn both[a](x: a, y: a) : [a] = [x, y]

fn main() : Unit / Stdout = {
  Stdout.print(Box { v: 2 } |> tag())
  Stdout.print(Box { v: "s" } |> tag())
  Stdout.print("#{list_length(both(1, 2))}")
}
