type Verdict = Ok(Int) | Err(Int) | Some | None

type BinCursor = { shadow: Int }

#[derive(BinSerialize)]
type Rec = { id: Int, name: String }

#[derive(BinSerialize)]
type Shape = Dot | Circle(Int)

fn main() : Int / Console {
  let bytes = Rec { id: 7, name: "kai" } |> to_bytes()
  match rec_roundtrips(bytes) {
    true -> print("rec ok")
    false -> print("rec bad")
  }
  let sb = Circle(3) |> to_bytes()
  print("shape bytes #{array_length(sb)}")
  0
}

fn rec_roundtrips(b: Array[Byte]) : Bool = match rec_from_bytes(b, 0) {
  Ok(c) -> c.value.id == 7 and c.value.name == "kai"
  Err(_) -> false
}
