import na
import nb

# `na.Alpha` names a type in a signature and a constructor in an
# expression; `nb.Alpha` is a record type of the same name in the other
# home. All three readings sit in one function.
fn take(a: na.Alpha) : String = na.show(a)

fn main() : Unit / Stdout = {
  let a : na.Alpha = na.Alpha(2)
  let r : nb.Alpha = nb.mk(3)
  Stdout.print("#{take(a)} #{take(na.Blank)} #{r.n}")
}
