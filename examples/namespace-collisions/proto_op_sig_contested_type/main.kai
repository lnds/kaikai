import pa
import pb

# The op signature names a contested type. Respelling has to reach the
# protocol declaration and the impl alike, or the two disagree on which
# `Cfg` the operation takes.
protocol Describe {
  describe(self: Self, c: pa.Cfg) : String
}

type Wrap = Wrap(Int)

impl Describe for Wrap {
  fn describe(self: Wrap, c: pa.Cfg) : String = match self { Wrap(n) -> "#{n}:#{c.v}" }
}

fn other(c: pb.Cfg) : String = c.s

fn main() : Unit / Stdout =
  Stdout.print("#{Wrap(7).describe(pa.mk())} #{other(pb.mk())}")
