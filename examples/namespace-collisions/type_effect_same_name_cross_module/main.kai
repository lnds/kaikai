import tm
import em

# The type and the effect carry the same name in DIFFERENT homes. The
# existing pair declares both in one file, where one scope decides; here
# each qualifier has to pick a different name table for the same spelling
# — `tm.Log` in a type position, `em.Log` in a handler head.
fn take(cfg: tm.Log) : Int = tm.level(cfg)

fn main() : Unit / Stdout = {
  let cfg = tm.Log { level: 3 }
  handle { em.run() } with em.Log { write(s, resume) -> resume(Stdout.print("#{s}/#{take(cfg)}")) }
}
