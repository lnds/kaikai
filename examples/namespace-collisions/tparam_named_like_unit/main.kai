# `m` is a declared unit and, inside `twice` and `id_of`, a parameter of
# the function: the parameter answers there, so `twice` takes any unit.
unit m
unit s

fn twice[m: Measure](x: Real<m>) : Real<m> = x + x

fn id_of[m](x: m) : m = x

fn metres(x: Real<m>) : Real<m> = x

fn main() : Unit / Stdout = {
  Stdout.print("#{twice(2.0<s>)}")
  Stdout.print("#{metres(twice(1.5<m>))}")
  Stdout.print(id_of("unit-named"))
}
