# Two modules each declare `type T`. `Box[a.T]` and `Box[b.T]` are two
# instances of one effect, keyed by the declarations their arguments name,
# and each operation reaches the handler of its own instance.

import a
import b

effect Box[X] {
  peek() : X
}

fn peek_a() : a.T / Box[a.T] = Box.peek()

fn peek_b() : b.T / Box[b.T] = Box.peek()

fn both() : String / Box[a.T] + Box[b.T] = "#{b.get(peek_b())}#{int_to_string(a.get(peek_a()))}"

fn main() : Unit / Stdout = {
  let r = handle {
    handle { both() } with Box[b.T] {
      peek(resume) -> resume(b.mk("b="))
    }
  } with Box[a.T] {
    peek(resume) -> resume(a.mk(7))
  }
  Stdout.print(r)
}
