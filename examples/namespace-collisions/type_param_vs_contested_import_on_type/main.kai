import pa
import pb

# Same collision on a type declaration's parameter rather than a
# function's. `[T]` binds `T` for the body that follows, so the field
# type is the parameter and never the imported homonyms.
type Holder[T] = { item: T }

fn put(x: Int) : Holder[Int] = Holder { item: x }

fn main() : Unit / Stdout = Stdout.print("#{put(2).item}")
