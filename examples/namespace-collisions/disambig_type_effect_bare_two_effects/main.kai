import ta
import eb
import ec

# An effect row DOES select the Effect kind, so the imported type is out
# of the running — but two homonymous effects remain. Position narrows
# the candidates without deciding, which is exactly where §1 applies:
# qualify, or get an error.
fn go() : Unit / Slot = { let _ = eb.Slot.read(); () }

fn main() : Unit / Stdout = {
  let cfg = ta.Slot { n: 1 }
  Stdout.print("#{cfg.n}")
}
