import pa
import pb

# The arm spells one sub-pattern, which is `pb.Duo`'s arity, against a
# `pa.PA` scrutinee. The qualifier names the right home; only the arity
# is wrong, so a check that resolves the constructor by shape accepts it.
fn main() : Unit / Stdout = {
  Stdout.print("#{match pb.Duo(1) { pb.Duo(a) -> a  pb.NilB -> 0 }}")
  let s = match pa.Duo(1, 2) {
    pa.Duo(a) -> "#{a}"
    pa.NilA   -> "nil"
  }
  Stdout.print(s)
}
