import ga
import gb

# A region gives the allocations inside it their own arena. The type
# named in there is still the annotation's home, not the region's.
fn inside(c: ga.Cell) : String = ga.show(c)

fn main() : Unit / Stdout = {
  let s = region { inside(ga.mk()) }
  Stdout.print("#{s} #{gb.show(gb.mk())}")
}
