import shapes

type Crate = Box(String) | Empty

fn label(c: Crate) : String = match c {
  Box(s) -> s
  Empty  -> "empty"
}

fn labels(cs: [Crate]) : [String] = map(cs, (c) => match c {
  Box(s) -> s
  Empty  -> "empty"
})

fn main() : Unit / Stdout = {
  let c = Box("tools")
  Stdout.print(label(c))
  Stdout.print(string_join(labels([Box("a"), Empty, Box("b")]), ","))
  Stdout.print(int_to_string(shapes.area(shapes.Box(3, 4))))
}
