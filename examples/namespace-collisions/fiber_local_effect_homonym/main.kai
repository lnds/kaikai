import bus
import pump

# `bus.Actor` is a user effect; the core `Actor[Msg]` mailbox runs
# beneath it in the same fiber. The qualified handler head selects the
# user's effect, and the fiber-local dispatch of the core one is keyed
# by its own home, not by the bare label.
fn main() : Unit / Spawn + Stdout = {
  let out = handle { bus.post("hello"); "#{bus.who()} #{pump.run()}" } with bus.Actor {
    send(m, resume) -> resume(())
    self(resume) -> resume("bus-self")
    return(x) -> x
  }
  Stdout.print(out)
}
