pub type Mark = Tok(Int, Int)

# Structural `==` on a list routes each element to its impl through the
# runtime tag, so a shared tag would send `pb` values to this comparison
# and flip the answers.
impl Eq for Mark {
  fn eq(a: Mark, b: Mark) : Bool = match a { Tok(x, _) -> match b { Tok(y, _) -> x == y } }
}
