# Same name, same arity, same payload: only the emitted tag tells the two
# `Tok` apart. Structural `==` on a list routes each element to its impl
# through the runtime tag, so a shared tag would send `pb` values to
# `pa`'s comparison and flip the last two answers.
import pa
import pb

fn main() : Unit / Stdout = {
  let m1 = pa.Tok(1, 2)
  let m2 = pa.Tok(1, 3)
  let s1 = pb.Tok(1, 2)
  let s2 = pb.Tok(1, 3)
  Stdout.print("#{m1 == m2} #{s1 == s2} #{[m1] == [m2]} #{[s1] == [s2]}")
}
