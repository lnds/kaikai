import pa
import pb

# Structural `==` on a list routes each element to its impl through the
# runtime tag, so a shared tag would send `pb` values to `pa`'s
# comparison and flip the answers.
impl Eq for pa.Mark {
  fn eq(a: pa.Mark, b: pa.Mark) : Bool = match a { Tok(x, _) -> match b { Tok(y, _) -> x == y } }
}

impl Eq for pb.Sign {
  fn eq(a: pb.Sign, b: pb.Sign) : Bool = match a { Tok(_, x) -> match b { Tok(_, y) -> x == y } }
}
