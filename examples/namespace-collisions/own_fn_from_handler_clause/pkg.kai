# A handler clause body is emitted from the ClauseInfo side table, the
# same path as a lifted lambda: no EFn-table rotation to this module, so
# a bare call to the module's own `one` can bind to a stdlib `one`.
effect Ask { get_it() : Int }

fn one(n: Int) : Int = n + 100

pub fn direct() : Int = one(1)

pub fn via_clause() : Int = handle { Ask.get_it() } with Ask {
  get_it(resume) -> resume(one(1))
}
