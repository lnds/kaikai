import la
import lb

# Two modules each declare an effect `Log` carrying its own `default { }`.
# Nothing handles either, so each perform is answered by the default of
# the `Log` its own module declares: called directly, and through a
# function value, whose evidence slot is filled from the default node.
fn main() : Unit / la.Log + lb.Log = {
  la.greet()
  lb.greet()
  let fa = la.greet
  let fb = lb.greet
  fb()
  fa()
}
