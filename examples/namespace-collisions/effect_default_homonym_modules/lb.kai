# Another `Log`, of another shape: its first op is answered on stderr, so
# a perform that reached the other module's default would show on stdout.
pub effect Log {
  note(msg: String) : Unit
  say(msg: String) : Unit
  default {
    note(msg, resume) -> $extern_handler("kai_default_stderr_eprint")
    say(msg, resume)  -> $extern_handler("kai_default_stdout_print")
  }
}

pub fn greet() : Unit / Log = {
  Log.note("lb notes on stderr")
  Log.say("lb says hi")
}
