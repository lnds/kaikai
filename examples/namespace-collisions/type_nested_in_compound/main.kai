import pa
import pb

# A contested name inside a compound type is reached by recursion, not
# by the head: `[pa.Cfg]` and `(pa.Cfg) -> Int` respell through the
# element and parameter, and a walk that stops at the head leaves them
# spelled for whichever home registered last.
fn in_list(xs: [pa.Cfg]) : Int = list_length(xs)
fn in_fn(f: (pa.Cfg) -> Int, c: pa.Cfg) : Int = f(c)
fn other(xs: [pb.Cfg]) : Int = list_length(xs)

fn main() : Unit / Stdout =
  Stdout.print("#{in_list([pa.mk()])} #{in_fn((c) => c.v, pa.mk())} #{other([pb.mk()])}")
