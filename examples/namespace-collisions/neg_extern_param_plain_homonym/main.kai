# A plain record spelled like another module's `extern "C" type` is not
# that type: it has no C layout, so it cannot cross the boundary.

import paint

type Color = { hue: Int, name: String }

extern "C" fn labs(c: Color) : Int / Ffi

fn main() : Int / Ffi = labs(Color { hue: paint.channels(), name: "red" })
