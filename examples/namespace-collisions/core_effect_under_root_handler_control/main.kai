import mc

# The shape of core_effect_under_root_handler with a root effect name no
# core declaration uses.
effect Logx {
  info(xs: [String]) : Unit
}

fn main() : Unit / Stdout = {
  handle { mc.go() } with Logx {
    info(xs, resume) -> {
      Stdout.print("root got #{list_length(xs)}")
      resume(())
    }
  }
}
