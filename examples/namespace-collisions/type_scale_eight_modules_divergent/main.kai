import d1
import d2
import d3
import d4
import d5
import d6
import d7
import d8

# Eight homes whose bodies diverge: four records, four sums. A
# spelling that collapses now produces a layout mismatch rather
# than a merely wrong name, which is what makes the scale visible.
fn t1(c: d1.Cfg) : String = d1.show(c)
fn t2(c: d2.Cfg) : String = d2.show(c)
fn t3(c: d3.Cfg) : String = d3.show(c)
fn t4(c: d4.Cfg) : String = d4.show(c)
fn t5(c: d5.Cfg) : String = d5.show(c)
fn t6(c: d6.Cfg) : String = d6.show(c)
fn t7(c: d7.Cfg) : String = d7.show(c)
fn t8(c: d8.Cfg) : String = d8.show(c)

fn main() : Unit / Stdout =
  Stdout.print("#{t1(d1.mk())} #{t2(d2.mk())} #{t3(d3.mk())} #{t4(d4.mk())} #{t5(d5.mk())} #{t6(d6.mk())} #{t7(d7.mk())} #{t8(d8.mk())} ")
