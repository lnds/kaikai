# The homonyms of `neg_import_order_cannot_decide`, qualified. `rb` is
# imported first and `ra` second, the reverse of that fixture's order:
# each call still reaches the module it names, so the output does not
# depend on which import came first.
import rb
import ra

fn main() : Unit / Stdout = {
  Stdout.print("a=#{ra.pick()}")
  Stdout.print("b=#{rb.pick()}")
}
