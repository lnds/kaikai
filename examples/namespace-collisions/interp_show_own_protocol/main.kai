# `#{...}` calls the core `Show`. A protocol of the reading module that
# declares a `show` of its own answers a `show` the module writes, never
# the interpolation: not in the root file, not in the module `tags`, and
# not inside the very impl that provides that `show`.
import tags

protocol Loud { show(self: Self) : String }

impl Loud for Int { fn show(self: Int) : String = "LOUD #{self}!" }

fn main() : Unit / Stdout = {
  Stdout.print("#{7}")
  Stdout.print(7.show())
  Stdout.print(tags.plain(3))
  Stdout.print(tags.tagged(3))
}
