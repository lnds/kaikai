import pa
import pb

type Box = { n: Int }

# Two modules declare `Render`; the qualifier on each impl head says
# which protocol it supplies, and each module's bounded helper reaches
# only its own.
impl pa.Render for Box { fn render(x: Box) : String = "pa-render#{x.n}" }
impl pb.Render for Box { fn render(x: Box) : String = "pb-render#{x.n}" }

fn main() : Unit / Stdout = Stdout.print("#{pa.via_a(Box { n: 1 })} #{pb.via_b(Box { n: 2 })}")
