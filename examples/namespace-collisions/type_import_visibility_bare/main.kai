import ia
import ib

# Importing a module puts the types it exports in scope bare. Only one
# home offers each name here, so rung 4 settles both without a
# qualifier — visibility, not contest.
fn a(c: Cfg) : String = ia.show(c)
fn b(o: Other) : String = ib.show(o)

fn main() : Unit / Stdout = Stdout.print("#{a(ia.mk())} #{b(ib.mk())}")
