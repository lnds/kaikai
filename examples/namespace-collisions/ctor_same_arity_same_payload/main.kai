# Two homonymous constructors with the SAME arity and the SAME payload
# shape: only the tag separates them, so arity-narrowed lookups cannot
# help — the resolution must come from the home. A first-entry answer
# stamps one homonym's cells with the other's tag, which a list-nested
# match then reads as the wrong variant.
import pa
import pb

fn tally(ms: [pa.Mark], acc: Int) : Int = match ms {
  [] -> acc
  [pa.Tok(a, b), ...rest] -> tally(rest, acc + a + b)
}

fn main() : Unit / Stdout = {
  let xs = [pa.mk(1, 2), pa.mk(3, 4)]
  Stdout.print("#{pa.show(pa.mk(1, 2))} #{pb.show(pb.mk(5, 6))} #{tally(xs, 0)}")
}
