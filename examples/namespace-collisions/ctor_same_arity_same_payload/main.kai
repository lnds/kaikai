# Same arity, same payload: only the home separates the two `Tok`, so
# arity-narrowed lookups cannot help.
import pa
import pb

fn tally(ms: [pa.Mark], acc: Int) : Int = match ms {
  [] -> acc
  [pa.Tok(a, b), ...rest] -> tally(rest, acc + a + b)
}

fn main() : Unit / Stdout = {
  let xs = [pa.Tok(1, 2), pa.Tok(3, 4)]
  let s = pb.Tok(5, 6)
  let here = match s { pb.Tok(a, b) -> "main-pb:#{a},#{b}" }
  Stdout.print("#{pb.show(s)} #{pa.show(pa.Tok(1, 2))} #{tally(xs, 0)} #{here} #{pa.same_first(pa.Tok(1, 2), pa.Tok(1, 9))} #{pb.same_second(pb.Tok(1, 2), pb.Tok(1, 9))}")
}
