import pa
import pb

# Same arity, same payload: only the home separates the two `Tok`, so
# arity-narrowed lookups cannot help; the scrutinee's type must.
pub fn first(m: pa.Mark) : Int = match m { Tok(a, _) -> a }
pub fn second(s: pb.Sign) : Int = match s { Tok(_, b) -> b }

pub fn tally(ms: [pa.Mark], acc: Int) : Int = match ms {
  [] -> acc
  [pa.Tok(a, b), ...rest] -> tally(rest, acc + a + b)
}
