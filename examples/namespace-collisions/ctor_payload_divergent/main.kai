import alpha
import beta

fn main() : Unit / Stdout = {
  let b : beta.BetaBox = beta.Node("aa", "bb")
  let a : alpha.AlphaBox = alpha.Node(7)
  Stdout.print(beta.beta_show(b))
  Stdout.print(alpha.alpha_show(a))
  let here = match b {
    beta.Node(x, y) -> "main-beta:#{x}/#{y}"
  }
  let there = match a {
    alpha.Node(n) -> "main-alpha:#{n}"
  }
  Stdout.print("#{here} #{there}")
}
