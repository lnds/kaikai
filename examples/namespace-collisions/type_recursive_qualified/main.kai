import ra
import rb

# The type refers to itself inside its own body. Respelling the head
# without respelling the recursive occurrences leaves a type whose
# children point at the other home's declaration.
fn total(t: ra.Tree) : Int = ra.sum(t)
fn label(t: rb.Tree) : String = rb.show(t)

fn main() : Unit / Stdout = Stdout.print("#{total(ra.mk())} #{label(rb.mk())}")
