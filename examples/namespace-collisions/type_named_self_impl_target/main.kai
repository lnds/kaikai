# The record `Self` implements a protocol: in the impl `Self` is the
# record, in the protocol it is the parameter the record fills.
type Self = { v: Int }

protocol Named {
  name(x: Self) : String
  same(x: Self, y: Self) : Self
}

impl Named for Self {
  fn name(x: Self) : String = "self #{x.v}"
  fn same(x: Self, y: Self) : Self = Self { v: x.v + y.v }
}

fn mk(n: Int) : Self = Self { v: n }

fn main() : Unit / Stdout = {
  Stdout.print(name(mk(1)))
  Stdout.print(name(same(mk(3), mk(4))))
}
