import pa
import pb

# One `match` whose scrutinee nests a `pa.Go` inside a `pb.Go`: both arms
# and both nesting levels spell the same two names, so a pattern that
# resolved the constructor by position rather than by qualifier would take
# the outer home for the inner slot.
fn describe(o: pb.Outer) : String = match o {
  pb.Go(pa.Go(n)) -> "go-go:#{n}"
  pb.Go(pa.Halt)  -> "go-halt"
  pb.Halt         -> "halt"
}

fn main() : Unit / Stdout = {
  Stdout.print(describe(pb.Go(pa.Go(4))))
  Stdout.print(describe(pb.Go(pa.Halt)))
  Stdout.print(describe(pb.Halt))
}
