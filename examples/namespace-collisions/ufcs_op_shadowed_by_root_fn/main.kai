# A method call on a protocol op name means what the prefix call means: a
# root fn of the call's arity shadows the op, with none the call reaches
# the dispatcher, and an arity no op declares is an ordinary method call.
type Color = Red | Blue

impl Show for Color {
  fn show(c: Color) : String = match c {
    Red  -> "red"
    Blue -> "blue"
  }
}

fn div(a: Int, b: Int) : Int = a * 100 + b

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(10.div(3)))
  Stdout.print(int_to_string(div(10, 3)))
  Stdout.print(Red.show())
  Stdout.print(show(Blue))
  let top = match [3, 1, 2].max() {
    Some(m) -> int_to_string(m)
    None    -> "none"
  }
  Stdout.print(top)
}
