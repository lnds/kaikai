# The shape of type_vs_core_enum_nested with a type name no core
# declaration uses.
type Sigx = S(String) | T
type W = W(Sigx, Int)

fn f(w: W) : Int = match w {
  W(S(x), k) -> string_length(x) + k
  W(T, k) -> k
}

fn main() : Unit / Stdout = Stdout.print("n=#{f(W(S(int_to_string(12345)), 1))}")
