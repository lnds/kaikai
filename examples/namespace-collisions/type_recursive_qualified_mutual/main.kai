import ma
import mb

# Two mutually referring types per home. `Stmt` reaches `Expr` through
# its payload, so a collapsed `Expr` is only observable once the pair
# from one home is used against the pair from the other.
fn a(s: ma.Stmt) : Int = ma.run(s)
fn b(s: mb.Stmt) : String = mb.run(s)

fn main() : Unit / Stdout = Stdout.print("#{a(ma.mk())} #{b(mb.mk())}")
