import rs

# `Ok`/`Err` are core's Result constructors and rs's own, with different
# payload types on both arms. The two live in the same function and the
# same match shapes, so a resolver that lets the prelude win takes the
# qualified construction with it.
fn main() : Unit / Stdout = {
  let mine = rs.show(rs.Ok("a"))
  let mine2 = rs.show(rs.Err(7))
  let core : Result[Int, String] = Ok(1)
  let c = match core { Ok(n) -> "core-ok:#{n}"  Err(e) -> "core-err:#{e}" }
  Stdout.print("#{mine} #{mine2} #{c}")
}
