import pa
import pb

# A type parameter used inside a compound type on a `type` declaration.
# The binder has to reach past the list and the function arrow, not just
# the outermost position, or the contested import captures it there.
type Holder[T] = { items: [T], build: (T) -> T }

fn one(x: Int) : Holder[Int] = Holder { items: [x], build: (v) => v }

fn main() : Unit / Stdout = Stdout.print("#{list_length(one(4).items)}")
