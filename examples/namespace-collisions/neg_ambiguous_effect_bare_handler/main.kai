import ha
import hb

# The bare name is in the HANDLER HEAD, not in a row or an op call: the
# head is where a handler silently claims one home's ops while the body
# performs the other's, so an unqualified head has to be rejected too.
fn main() : Unit / Stdout = {
  handle { ha.run() } with Track { note(s, resume) -> resume(Stdout.print(s)) }
}
