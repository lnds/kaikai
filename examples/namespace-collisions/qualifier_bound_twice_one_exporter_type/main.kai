# Two imports bind `util`, and only the second declares `Box`: the
# qualified type, constructor and pattern all reach it.
import a.util
import b.util

fn twice(b: util.Box) : Int = match b {
  util.Box(n) -> n * 2
}

fn main() : Unit / Stdout = Stdout.print("#{twice(util.Box(3))} #{util.open(util.Box(4))} #{util.unrelated()}")
