import pb

type Cell = { size: Int }

# The binder that shadows the module is introduced by a match arm and by
# a lambda parameter, not by a `let`: every binding position has to
# travel into the span, not just the block-statement one.
fn main() : Unit / Stdout = {
  let pick = (pb: Cell) => "l=#{pb.size}"
  let out = match (Cell { size: 3 }) {
    pb -> "m=#{pb.size}"
  }
  Stdout.print("#{out} #{pick(Cell { size: 4 })}")
}
