# `ma` and `mc` both export `helper`. Each module's bare call resolves
# against what that module itself imports: `ma` declares its own, `mb`
# imports only `mc`. Neither reaches the other, so the pair of results
# does not depend on which import the root file wrote first.
import ma
import mb

fn main() : Unit / Stdout = {
  Stdout.print(ma.call_a())
  Stdout.print(mb.call_b())
}
