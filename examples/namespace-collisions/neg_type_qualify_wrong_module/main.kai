import wa
import wb

# `wb` declares no `Cfg`. The qualifier is explicit, so there is nothing
# to fall back to: naming a type through a module that does not export
# it is an error, not a search of the other imports.
fn lvl(c: wb.Cfg) : Int = c.level

fn main() : Unit / Stdout = Stdout.print("#{lvl(wa.mk())}")
