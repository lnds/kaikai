# `repeat` is exported by `loop`, `core.list` and `core.string`, so the
# viewpoint keys the combinator call to its home. The loop lowering
# reads that keyed form as the combinator it is: the `var` stays a
# stack slot and the call still runs, rather than surviving as an
# ordinary call the lowering no longer recognises.
import loop

fn reps(n: Int) : Int = {
  var acc := 0
  repeat(n) {
    acc := acc + 2
  }
  acc
}

fn main() : Unit / Stdout = Stdout.print(int_to_string(reps(4)))
