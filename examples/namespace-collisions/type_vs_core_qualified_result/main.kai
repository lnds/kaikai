import ra
import rb

# Two user `Result`s against the core one. With two candidates from the
# imports the bare name is contested and refused, so every use here is
# qualified — including the core type, which the qualifier cannot reach
# and which therefore has no spelling left in this file.
fn a(r: ra.Result[Int, String]) : Int = ra.get(r)
fn b(r: rb.Result[Int, String]) : Int = r.tag

fn main() : Unit / Stdout = Stdout.print("#{a(ra.mk())} #{b(rb.mk())}")
