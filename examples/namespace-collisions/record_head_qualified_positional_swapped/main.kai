# `geo.Point` declares `y` then `x`; the root's own `Point` declares them the other way round.
# A qualifier is the choice: the positional and the spread forms of
# `geo.Point` take their fields from `geo`'s declaration, and the bare
# forms from the root's.
import geo

type Point = { x: Int, y: Int }

fn main() : Unit / Stdout = {
  let a = geo.Point { 1, 2 }
  let b = geo.Point { ...a, y: 9 }
  let c = Point { 1, 2 }
  let d = Point { ...c, x: 7 }
  Stdout.print("#{geo.show(a)} #{geo.show(b)} #{c.x},#{c.y} #{d.x},#{d.y}")
}
