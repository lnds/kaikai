import pa
import pb

# An axiom carries a signature and no body, so its parameter types are
# the only place respelling can reach. A contested name here must land
# on the same home the caller's argument came from.
axiom peek(c: pa.Cfg) : Int

fn other(c: pb.Cfg) : String = c.s

fn main() : Unit / Stdout = Stdout.print("#{other(pb.mk())}")
