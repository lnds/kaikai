import wa
import wb

# `wa.Trip` takes three arguments and `wb.Trip` takes two. The call
# supplies two, which is right for the OTHER home: a resolver that falls
# back to any `Trip` it can make fit accepts this silently.
fn main() : Unit / Stdout = {
  let ok = wb.Trip(1, 2)
  let v = wa.Trip(1, 2)
  Stdout.print("x")
}
