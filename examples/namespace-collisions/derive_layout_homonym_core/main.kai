type Verdict = Ok(Int) | Err(Int) | Some | None

type BinCursor = { shadow: Int }

#[derive(Layout)]
type Header = { magic: U32<be>, port: U16<be> }

fn main() : Int / Console {
  let h = Header { magic: 0xCAFEBABE<be>, port: 8080<be> }
  let bytes = h |> to_bytes()
  let short : Array[Byte] = array_make(3, bin_byte(0))
  match header_from_bytes(bytes, 0) {
    Ok(c) -> print("ok #{c.value.port}")
    Err(m) -> print("err #{m}")
  }
  match header_from_bytes(short, 0) {
    Ok(_) -> print("ok")
    Err(m) -> print("err #{m}")
  }
  0
}
