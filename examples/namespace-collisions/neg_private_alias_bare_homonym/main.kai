import ha
import hb

# Both modules declare a private transparent alias `Tag`. Neither is
# part of its module's surface, so a bare reference here is a privacy
# violation whichever home wins — the alias is spelled to its home at
# birth, and only the display spelling reaches this use.
fn wrap(x: Tag) : Int = x

fn main() : Unit / Stdout = Stdout.print("#{wrap(hb.mk()) + ha.mk()}")
