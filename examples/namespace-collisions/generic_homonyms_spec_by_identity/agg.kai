pub protocol Monoid { empty() : Self  combine(a: Self, b: Self) : Self }

impl Monoid for Int {
  fn empty() : Int = 0
  fn combine(a: Int, b: Int) : Int = a + b
}

fn walk[T : Monoid](xs: [T], acc: T) : T = match xs {
  [] -> acc
  [h, ...t] -> walk(t, combine(acc, h))
}

pub fn fold[T : Monoid](xs: [T]) : T = walk(xs, empty())
