pub protocol Prod { one() : Self  times(a: Self, b: Self) : Self }

impl Prod for Int {
  fn one() : Int = 1
  fn times(a: Int, b: Int) : Int = a * b
}

fn walk[T : Prod](xs: [T], acc: T) : T = match xs {
  [] -> acc
  [h, ...t] -> walk(t, times(acc, h))
}

pub fn fold[T : Prod](xs: [T]) : T = walk(xs, one())
