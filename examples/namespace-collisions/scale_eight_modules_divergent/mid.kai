import m1
import m2
import m3
import m4
import m5
import m6
import m7
import m8

# Every construction happens HERE, in a module that imports all eight
# homes, so the qualifier decides against seven live alternatives whose
# payload arities and types all differ.
pub fn build() : String = {
  let a = match m1.Node(1)        { m1.Node(n)    -> "1:#{n}" }
  let b = match m2.Node("x")      { m2.Node(s)    -> "2:#{s}" }
  let c = match m3.Node(true)     { m3.Node(f)    -> "3:#{f}" }
  let d = match m4.Node           { m4.Node -> "4:nil"  m4.Nil4 -> "4:nil4" }
  let e = match m5.Node(5, 6)     { m5.Node(p, q) -> "5:#{p + q}" }
  let f = match m6.Node("y", 7)   { m6.Node(s, q) -> "6:#{s}#{q}" }
  let g = match m7.Node(m1.Node(8)) { m7.Node(m1.Node(n)) -> "7:#{n}" }
  let h = match m8.Tail           { m8.Node(n) -> "8:#{n}"  m8.Tail -> "8:tail" }
  "#{a} #{b} #{c} #{d} #{e} #{f} #{g} #{h}"
}
