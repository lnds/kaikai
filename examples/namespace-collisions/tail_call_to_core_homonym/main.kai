# A tail call to the core function a root function is spelled like is
# not a self-call.

fn filter(xs: [Int], keep: Int) : [Int] = list.filter(xs, (x) => x != keep)

fn length(xs: [Int]) : Int = list.length(xs) * 100

fn main() : Unit / Stdout = Stdout.print("#{filter([1, 2, 1, 3], 1)} #{length([4, 5])}")
