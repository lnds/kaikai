import layer1
import layer2

# layer2 declares its own `Cfg` and also names layer1's. The middle
# module's viewpoint is its own home, so `via1` must keep layer1's type
# even though layer2 contests the spelling.
fn a(c: layer1.Cfg) : String = layer1.show(c)
fn b(c: layer2.Cfg) : String = layer2.show(c)

fn main() : Unit / Stdout =
  Stdout.print("#{layer2.via1()} #{a(layer1.mk(2))} #{b(layer2.mk("x"))}")
