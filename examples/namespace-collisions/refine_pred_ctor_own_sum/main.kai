# `shade.Shade` declares its own `None`. The predicate of `Tinted`
# refines a `Shade`, so its `None` is that sum's constructor, in `shade`
# and in every file a copy of the alias lands in; the core `None` is
# never read for it.
import shade

fn pass(s: shade.Tinted) : shade.Tinted = shade.keep(s)

fn main() : Unit / Stdout = {
  let t : shade.Tinted = shade.Dark
  Stdout.print(shade.name(pass(t)))
}
