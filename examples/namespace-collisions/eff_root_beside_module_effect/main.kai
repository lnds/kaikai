# A root effect and an imported module's effect, both named Emit, keep
# their own handlers.

import ea

effect Emit {
  send(s: String) : String
}

fn mine() : String / Emit = Emit.send("z")

fn main() : Unit / Stdout = {
  let r = handle {
    handle { ea.run_a() ++ mine() } with Emit {
      send(s, resume) -> resume("[root]")
    }
  } with ea.Emit {
    send(s, resume) -> resume("[ea]")
  }
  println(r)
}
