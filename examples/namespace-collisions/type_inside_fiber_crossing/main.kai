import spawn
import fa
import fb

# Both homes crossing the same spawn boundary, and a value of each built
# outside and consumed inside. One home inside a fiber only proves the
# frame carries a spelling; two prove it carries the right one.
fn a(c: fa.Cfg) : String = fa.show(c)
fn b(c: fb.Cfg) : String = fb.show(c)

fn main() : Unit / Stdout + Spawn = {
  let ca = fa.mk()
  let cb = fb.mk()
  nursery { n ->
    let f1 = n.spawn(() => Stdout.print(a(ca)))
    n.await(f1)
    let f2 = n.spawn(() => Stdout.print(b(cb)))
    n.await(f2)
  }
}
