# The binder a `#[derive(Json)]` body mints for each field, read back
# when it rebuilds the record. `zip` is exported by two stdlib modules,
# so treating that read as a bare call would refuse a derive the user
# never wrote — the same shadowing rule as a hand-written `let`.
import encoding.json.{json_decode}

#[derive(Json)]
type Box = { zip: String }

fn main() : Unit / Stdout = Stdout.print(Box { zip: "x" }.zip)
