import ha
import hb
import hc

# `Cfg` exists — twice — but not in `hc`. A homonym in scope must not
# rescue a qualifier that names the wrong home; the wrong-module case
# stays an error even when the bare name would have candidates.
fn lvl(c: hc.Cfg) : Int = c.level

fn main() : Unit / Stdout = Stdout.print("#{lvl(ha.mk())} #{hb.mk().name}")
