# A module's own private helper spelled like a core builtin. The boxed
# call path is the one that used to reach the builtin instead: a consumed
# parameter plus a heap-allocated return wraps the call in a Perceus
# release block, which is why the return type here is not a scalar.

fn read_line(at: Int, raw: String) : Result[Option[String], String] =
  if string_length(raw) == 0 { Ok(None) } else { Ok(Some("mine:#{at}:#{raw}")) }

fn numbered(p: (Int, String)) : Result[Option[String], String] = read_line(p.fst + 1, p.snd)

pub fn describe(raw: String) : String = match numbered((0, raw)) {
  Ok(Some(s)) -> s
  _           -> "none"
}
