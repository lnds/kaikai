import ib
import ia

# Same two modules, imports written in the other order. A bare type name
# that is visible through exactly one import must resolve the same way
# regardless of where that import sits in the list.
fn a(c: Cfg) : String = ia.show(c)
fn b(o: Other) : String = ib.show(o)

fn main() : Unit / Stdout = Stdout.print("#{a(ia.mk())} #{b(ib.mk())}")
