# `Stdout` names a local module and a builtin effect at once. The row and
# the qualifier are different positions: `/ Stdout` is the effect, while
# `Stdout.shout` is the module. Collapsing them onto one table makes the
# effect's own operations unreachable.
import Stdout

fn main() : Unit / Stdout = Stdout.print(Stdout.shout("hi"))
