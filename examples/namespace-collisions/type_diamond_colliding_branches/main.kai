import dbase
import dleft
import dright

# The diamond's left branch declares its OWN `Cfg` beside the shared
# one, so the apex is no longer a single candidate: bare is contested
# and every use has to name its home.
fn a(c: dbase.Cfg) : String = dright.right(c)
fn b(c: dleft.Cfg) : String = dleft.show(c)

fn main() : Unit / Stdout =
  Stdout.print("#{a(dbase.mk(2))} #{b(dleft.mk())} #{dleft.via(dbase.mk(3))}")
