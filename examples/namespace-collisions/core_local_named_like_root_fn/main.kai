# A core body's local closure spelled like a root function compiles as
# the closure, never with the function's convention.

import collections.map

fn f(xs: [String]) : Int = 0

fn get(m: Int) : Int = m * 1000

fn main() : Unit / Stdout = {
  let p = Pair { fst: ["left", "side"], snd: 7 }
  let q = tuple.map_fst(p, (xs) => xs)
  let r = tuple.map_fst(q, (xs) => ["new", ...xs])
  let m = map.put(map.empty(), "k", 3)
  Stdout.print("#{f([])} #{get(2)} #{r.fst} #{q.fst} #{map.get(m, "k")}")
}
