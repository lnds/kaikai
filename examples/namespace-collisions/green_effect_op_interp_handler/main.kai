import ea
import eb

# A handler head inside a `#{...}` interpolation names its effect with a
# qualifier; that head must pick the home of `eb`'s `Dial`, shadowing the
# outer `eb` handler for the fragment's scope.
fn main() : Unit / Stdout =
  handle {
    handle {
      Stdout.print("#{handle { eb.turn(2) } with eb.Dial { dial(v, resume) -> resume(v * 10) }} #{ea.turn(1)} #{eb.turn(3)}")
    } with eb.Dial {
      dial(v, resume) -> resume(v + 200)
    }
  } with ea.Dial {
    dial(v, resume) -> resume(v + 100)
  }
