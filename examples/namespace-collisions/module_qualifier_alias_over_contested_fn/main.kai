# The same rule under an alias: `sa` and `sb` both export `from`, and
# the module bound as `m` also declares one. The alias is a module
# binding, so `m.from(1)` reaches the module it names rather than the
# contested function of the same spelling.
import sel as m
import sa
import sb

fn main() : Unit / Stdout = {
  Stdout.print(m.from(1))
  Stdout.print(sa.from(2))
  Stdout.print(sb.from(3))
}
