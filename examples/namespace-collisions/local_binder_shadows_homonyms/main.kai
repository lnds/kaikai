# Two modules export `tally`, so a bare CALL to it is refused. A local
# named `tally` is not that call: a binder shadows imports rather than
# competing with them, and reading it back is not a contested reference.
# Nothing here is ambiguous, so nothing here is reported.
import la
import lb

fn main() : Unit / Stdout = {
  let tally = "local"
  Stdout.print(tally)
}
