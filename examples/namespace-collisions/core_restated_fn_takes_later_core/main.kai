# `char` and `char_unicode` are both cores and both declare `is_upper`
# over a `Char`. Between cores the core set's own order decides a call:
# the later-listed `char_unicode` stands, which knows `É` is upper case
# where the ASCII `char.is_upper` does not.
fn main() : Unit / Stdout = {
  let wide = is_upper('É')
  let ascii = char.is_upper('É')
  Stdout.print("#{wide} #{ascii} #{is_upper('a')}")
}
