import time

# A root effect spelled like one the runtime installs by default is its
# own effect: both defaults are installed, each under its declaration.
effect Clock {
  tick(msg: String) : Unit
  default {
    tick(msg, resume) -> $extern_handler("kai_default_stdout_print")
  }
}

fn main() : Unit / Clock + time.Clock + Stdout = {
  Clock.tick("root clock")
  time.sleep(time.nanos_dur(1))
  Stdout.print("runtime clock")
}
