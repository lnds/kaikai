import na
import nb

# `Alpha` is a type in one home and a constructor in the other. They
# live in different positions — annotation against expression — so both
# stay reachable; the type must not be captured by the constructor table.
fn width(a: na.Alpha) : Int = a.n

fn main() : Unit / Stdout =
  Stdout.print("#{width(na.amk())} #{nb.bshow(nb.Alpha("z"))}")
