# Issue #1715: a stdlib module's own import alias must survive the
# consumer picking a different name for the same module.
# `decimal_proto` reaches Decimal through `import decimal as dec`,
# `rational_proto` through `import rational as rat`, and
# `math.bigint_proto` through `import math.bigint_convert as bc`.
# Importing those same modules under the plain spelling used to
# displace each alias and fail with `unknown module qualifier`.

import decimal
import decimal_proto
import rational
import rational_proto
import math.bigint
import math.bigint_convert
import math.bigint_proto

fn main() {
  let sum = decimal.from_parts(1, 25, 2) + decimal.from_parts(2, 75, 2)
  print(decimal.to_string(sum))

  let r = rational.from_int(3) + rational.from_int(4)
  print(rational.to_string(r))

  print(bigint_convert.to_string(bigint.add(bigint.from_int(20), bigint.from_int(22))))
}
