fn trunc_raw(x: Real) : Real = int_to_real(real_to_int(x))

fn widen(i: Int) : Real = int_to_real(i) * 0.5

fn edge(x: Real) : Int = real_to_int(x)

fn sum(i: Int, acc: Real) : Real =
  if i == 0 { acc } else { sum(i - 1, acc + trunc_raw(int_to_real(i) * 0.37)) }

fn main() : Unit / Console = {
  let nan = 0.0 / 0.0
  let inf = 1.0 / 0.0
  println(real_to_string(trunc_raw(2.9)))
  println(real_to_string(trunc_raw(-2.9)))
  println(real_to_string(widen(7)))
  println(int_to_string(edge(nan)))
  println(int_to_string(edge(inf)))
  println(int_to_string(edge(-inf)))
  println(int_to_string(edge(1.0e300)))
  println(int_to_string(edge(-1.0e300)))
  println(int_to_string(edge(9.0e18)))
  println(int_to_string(edge(9223372036854775808.0)))
  println(int_to_string(edge(-9223372036854775808.0)))
  println(real_to_string(sum(1000, 0.0)))
}
