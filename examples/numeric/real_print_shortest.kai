# A Real prints as the shortest `%.{p}g` (p from 6) that reads back as the
# same number: zeros, exponent thresholds, subnormals, the extremes, the
# lowest mantissa of a binade, and a spread of 12-17 digit values.

fn show(s: String) : String = match string_to_real(s) {
  Some(r) -> "#{r}"
  None    -> "none"
}

fn main() : Unit / Stdout = {
  let inputs = [
    "0.0", "-0.0", "1.0", "-1.5", "0.1", "0.3", "100.0", "1e5", "123456.0",
    "1234567.0", "1e6", "1e7", "1e15", "1e16", "1e17", "1e21", "1e22", "1e23",
    "1e-4", "1e-5", "9.5e-5", "0.000123456", "999999.5", "4.35", "4.75e21",
    "9007199254740993", "123456789012345678.0", "562949953421312.25",
    "18014398509481988.0", "18014398509481992.0", "3.602879701896398e16",
    "1.7976931348623157e308", "2.2250738585072014e-308",
    "2.2250738585072009e-308", "5e-324", "1e-323", "2.5e-323",
    "4.9406564584124654e-324", "9.5367431640625e-7", "7.1202363472230444e-307",
    "4.5569512622227484e-305", "0.123456789012", "3.14159265358979",
    "2.718281828459045", "1.4142135623730951", "0.1234567890123456",
    "12345.678901234567", "98765.43210987654", "1.2345678901234567e-10",
    "6.02214076e23", "1.602176634e-19", "299792458.00000006",
    "0.30000000000000004", "1.0000000000000002", "123456789.12345678",
    "0.7071067811865476", "1.7320508075688772", "57.29577951308232", "1e300",
    "1.2345678901234567e300", "8.5e-300", "nan", "inf", "-inf"
  ]
  inputs |> list.map(show) |> list.foreach(s => Stdout.print(s))
}
