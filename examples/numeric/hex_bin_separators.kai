# `_` is a digit separator in every integer base, not just decimal. It
# groups long bit-patterns for the reader and carries no value.

fn main() : Unit / Stdout = {
  Stdout.print(show(0xDEAD_BEEF))
  Stdout.print(show(0xFF_FF))
  Stdout.print(show(0b1010_0101))
  Stdout.print(show(0b1111_1111_1111_1111))
  Stdout.print(show(1_000_000))
}
