# A negated literal mints like the literal: the sign rides the carrier
# the annotation names instead of forcing the literal to `Int`.

import decimal as d
import decimal_big as db
import math.bigint

fn main() : Int / Stdout = {
  let a : BigInt = -5
  Stdout.print(bigint.to_string(a))
  let b : BigInt = -123456789012345678901234567890
  Stdout.print(bigint.to_string(b))
  let c : d.Decimal = -1.50
  Stdout.print(d.to_string(c))
  let e : d.Decimal = -7
  Stdout.print(d.to_string(e))
  let f : db.DecimalBig = -2.25
  Stdout.print(db.to_string(f))
  let g : Int32 = -5
  let h : Int128 = -170141183460469231731687303715884105727
  let r : Real = -5
  Stdout.print("#{g} #{h} #{r}")
  0
}
