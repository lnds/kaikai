# Every Decimal / DecimalBig / BigInt spelling mints the exact value its
# source lexeme denotes: exponent and radix forms included.

import decimal
import decimal_big as db
import math.bigint

fn main() : Unit / Console {
  let a = 1500d
  let b = 1.5e3d
  let c: Decimal = 1e5
  let d = 0b101d
  let e = 0b1_1111_1111d
  let f = 1.5e-3d
  let g = 2.50e1d
  let h: Decimal = 0xFF
  let i: Decimal = 2.5E+2
  let j = 0d
  let k = 0e5d
  println(decimal.to_string(a))
  println(decimal.to_string(b))
  println(decimal.to_string(c))
  println(decimal.to_string(d))
  println(decimal.to_string(e))
  println(decimal.to_string(f))
  println(decimal.to_string(g))
  println(decimal.to_string(h))
  println(decimal.to_string(i))
  println(decimal.to_string(j))
  println(decimal.to_string(k))
  let big: db.DecimalBig = 1.5e40
  let wide: db.DecimalBig = 0xFFFFFFFFFFFFFFFFFF
  let n: BigInt = 0xFFFFFFFFFFFFFFFFFFFF
  let m: BigInt =
    0b1_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000
  println(db.to_string(big))
  println(db.to_string(wide))
  println(show(n))
  println(show(m))
  println(show(0xFFn))
  println(show(0b101n))
  println(show(1_000n))
}
