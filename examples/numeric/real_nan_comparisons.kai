# A NaN is unordered with every `Real`, itself included: `!=` is the one
# comparison that holds for it. The same answers come from operands held
# raw, operands read out of a list, and a comparison that feeds a branch.

fn is_nan(r: Real) : Bool = r != r

fn raw(a: Real, b: Real) : String =
  "#{a < b} #{a > b} #{a <= b} #{a >= b} #{a == b} #{a != b}"

fn boxed(xs: [Real], ys: [Real]) : String = match xs, ys {
  [a, ...], [b, ...] -> "#{a < b} #{a > b} #{a <= b} #{a >= b} #{a == b} #{a != b}"
  _, _ -> "empty"
}

fn mark(b: Bool) : String = if b { "T" } else { "F" }

fn branch(a: Real, b: Real) : String = {
  let lt = if a < b { "T" } else { "F" }
  let gt = if a > b { "T" } else { "F" }
  let le = if a <= b { "T" } else { "F" }
  let ge = if a >= b { "T" } else { "F" }
  let eq = if a == b { "T" } else { "F" }
  let ne = if a != b { "T" } else { "F" }
  "#{lt} #{gt} #{le} #{ge} #{eq} #{ne}"
}

fn main() : Unit / Stdout = {
  let zero = 0.0
  let nan = zero / zero
  Stdout.print("#{nan == nan} #{nan != nan} #{is_nan(nan)} #{is_nan(1.5)} #{real_is_nan(nan)}")
  Stdout.print("raw    nan nan: #{raw(nan, nan)}")
  Stdout.print("raw    nan 1.0: #{raw(nan, 1.0)}")
  Stdout.print("raw    1.0 nan: #{raw(1.0, nan)}")
  Stdout.print("raw    1.0 2.0: #{raw(1.0, 2.0)}")
  Stdout.print("boxed  nan nan: #{boxed([nan], [nan])}")
  Stdout.print("boxed  nan 1.0: #{boxed([nan], [1.0])}")
  Stdout.print("boxed  1.0 nan: #{boxed([1.0], [nan])}")
  Stdout.print("boxed  2.0 2.0: #{boxed([2.0], [2.0])}")
  Stdout.print("branch nan nan: #{branch(nan, nan)}")
  Stdout.print("branch nan 1.0: #{branch(nan, 1.0)}")
  Stdout.print("branch 2.0 1.0: #{branch(2.0, 1.0)}")
  Stdout.print("not: #{mark(not (nan == nan))} #{mark(not (nan != nan))} #{mark(not (nan < 1.0))} #{mark(not (nan >= 1.0))}")
}
