# Int min is a legal negative pattern literal; its oversized neighbours are rejected.

fn f(n: Int) : String = match n {
  -9223372036854775808 -> "min"
  9223372036854775807 -> "max"
  0..9 -> "digit"
  _ -> "other"
}

fn main() : Unit / Console {
  println(f((-9223372036854775807) - 1))
  println(f(9223372036854775807))
  println(f(1))
  println(f(100))
}
