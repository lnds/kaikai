import importpkg.lib
import importpkg.other
import importpkg.listy

# An import outranks the builtin of the same name; two imports are told
# apart by the argument's type; a file that imports none still reaches
# the builtin.
fn main() : Unit / Stdout = {
  let twin = reduce(lib.Twin(3), (a, b) => a * b)
  let text = reduce("abc", (a, b) => a + b)
  Stdout.print("#{twin} #{text} #{listy.total([4, 5])}")
}
