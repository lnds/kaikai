import pickpkg.lib.{Twin, reduce, map}

# A selective import names the module's function, so it shadows the
# builtin of the same name in a call, a pipe and a value use alike.
fn main() : Unit / Stdout = {
  let piped = Twin(3) |> reduce((a, b) => a * b)
  let called = map(Twin(5), (x) => x * 10)
  let r = reduce
  Stdout.print("#{piped} #{called} #{r(Twin(7), (a, b) => b - a)}")
}
