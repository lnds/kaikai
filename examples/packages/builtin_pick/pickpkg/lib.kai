#[doc("A package module exporting functions spelled like core builtins.")]

#[doc("A pair of the same number.")]
pub type Twin = Twin(Int)

#[doc("Combines a twin's two halves with `f`.")]
pub fn reduce(t: Twin, f: (Int, Int) -> Int) : Int = match t { Twin(n) -> f(n, n + 1) }

#[doc("The twin's halves, `f` applied to each.")]
pub fn map(t: Twin, f: (Int) -> Int) : [Int] = match t { Twin(n) -> [f(n), f(n + 1)] }
