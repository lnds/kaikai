import spawn

pub fn run_one[e](task: () -> Int / e) : Int / Spawn + e =
  nursery { n ->
    let f = n.spawn(task)
    n.await(f)
  }

pub fn run_both[e](a: () -> Int / e, b: () -> Int / e) : Int / Spawn + e =
  nursery { n ->
    let fa = n.spawn(a)
    let fb = n.spawn(b)
    n.await(fa) + n.await(fb)
  }

pub fn run_cancelled[e](task: () -> Int / e) : Int / Spawn + e =
  nursery { n ->
    let f = n.spawn(task)
    n.cancel(f)
    7
  }
