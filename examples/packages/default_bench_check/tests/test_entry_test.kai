effect Limit {
  cap() : Int
  default {
    cap(resume) -> resume(10)
  }
}

effect Note {
  note(msg: String) : Unit
  default {
    note(msg, resume) -> {
      println("note: #{msg}")
      resume(())
    }
  }
}

test "a test body reaches a kaikai-bodied default" {
  assert Limit.cap() == 10
  Note.note("from test")
}
