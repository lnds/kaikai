effect Greet { greet() : String }

fn with_greet[r, e](body: () -> r / Greet + e) : r / e =
  handle { body() } with Greet { greet(resume) -> resume("hola") }

fn serve[e](hs: [() -> String / Greet + e]) : Unit / Stdout + e = match hs {
  [h, ..._] -> print(with_greet(h))
  []        -> ()
}

fn run[e](f: () -> String / Greet + e) : Unit / Spawn + Stdout + e = {
  let hs = [f]
  Spawn.await(Spawn.spawn(() => serve(hs))) |> ignore
  ()
}

fn main() : Int / Spawn + Stdout = {
  run(() => Greet.greet())
  0
}
