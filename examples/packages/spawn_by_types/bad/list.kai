effect Greet { greet() : String }

fn serve[e](hs: [() -> String / e]) : Unit / Stdout + e = match hs {
  [h, ..._] -> print(h())
  []        -> ()
}

fn run[e](f: () -> String / e) : Unit / Spawn + Stdout + e = {
  let hs = [f]
  Spawn.await(Spawn.spawn(() => serve(hs))) |> ignore
  ()
}

fn main() : Int / Spawn + Stdout = {
  run(() => Greet.greet())
  0
}
