effect Greet { greet() : String }

fn serve[e](o: Option[() -> String / e]) : Unit / Stdout + e = match o {
  Some(h) -> print(h())
  None    -> ()
}

fn run[e](f: () -> String / e) : Unit / Spawn + Stdout + e = {
  let o = Some(f)
  Spawn.await(Spawn.spawn(() => serve(o))) |> ignore
  ()
}

fn main() : Int / Spawn + Stdout = {
  run(() => Greet.greet())
  0
}
