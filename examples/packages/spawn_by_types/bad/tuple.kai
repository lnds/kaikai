effect Greet { greet() : String }

fn serve[e](p: (Int, () -> String / e)) : Unit / Stdout + e = match p {
  (_, h) -> print(h())
}

fn run[e](f: () -> String / e) : Unit / Spawn + Stdout + e = {
  let p = (1, f)
  Spawn.await(Spawn.spawn(() => serve(p))) |> ignore
  ()
}

fn main() : Int / Spawn + Stdout = {
  run(() => Greet.greet())
  0
}
