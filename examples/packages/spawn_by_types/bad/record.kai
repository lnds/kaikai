effect Greet { greet() : String }

type Handlers[e] = { say: () -> String / e }

fn serve[e](h: Handlers[e]) : Unit / Stdout + e = print(h.say())

fn run[e](f: () -> String / e) : Unit / Spawn + Stdout + e = {
  let h = Handlers { say: f }
  Spawn.await(Spawn.spawn(() => serve(h))) |> ignore
  ()
}

fn main() : Int / Spawn + Stdout = {
  run(() => Greet.greet())
  0
}
