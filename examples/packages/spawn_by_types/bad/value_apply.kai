effect Greet { greet() : String }

fn run[e](f: () -> String / e) : Unit / Spawn + Stdout + e = {
  Spawn.await(Spawn.spawn(() => print(f()))) |> ignore
  ()
}

fn apply2[e](g: (() -> String / e) -> Unit / Spawn + Stdout + e, f: () -> String / e) : Unit / Spawn + Stdout + e = g(f)

fn main() : Int / Spawn + Stdout = {
  apply2(run, () => Greet.greet())
  0
}
