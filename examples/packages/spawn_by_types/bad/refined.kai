effect Greet { greet() : String }

type Some1[e] = [() -> String / e] where list.length(self) > 0

fn serve[e](hs: Some1[e]) : Unit / Stdout + e = match hs {
  [h, ..._] -> print(h())
  []        -> ()
}

fn run[e](f: () -> String / e) : Unit / Spawn + Stdout + e = {
  match ensure([f]) where list.length(self) > 0 {
    Some(hs) -> Spawn.await(Spawn.spawn(() => serve(hs))) |> ignore
    None     -> ()
  }
}

fn main() : Int / Spawn + Stdout = {
  run(() => Greet.greet())
  0
}
