extern "C" pub type Rect = { x: F32, y: F32 }

#[doc("Draws a rectangle.")]
extern "C"("fake_draw") pub fn draw(r: Rect) : Unit / Ffi

#[doc("A rectangle built, spread and destructured by the module that declares it.")]
pub fn widen(w: F32) : F32 = {
  let r = Rect { x: 1.0, y: 2.0 }
  let s = Rect { ...r, x: w }
  match s { Rect { x, y } -> x }
}
