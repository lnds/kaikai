#[doc("A capability the library answers inside the childs it spawns.")]
pub effect Greet {
  greet() : String
}

fn answered[r, e](body: () -> r / Greet + e) : r / e =
  handle { body() } with Greet { greet(resume) -> resume("hola") }

#[doc("Runs `f` in a child of its own, with `Greet` answered there.")]
pub fn run[e](f: () -> Unit / Greet + e) : Unit / Spawn + e = {
  let child = Spawn.spawn(() => answered(f))
  Spawn.await(child) |> ignore
}

