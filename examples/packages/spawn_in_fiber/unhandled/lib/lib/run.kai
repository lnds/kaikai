#[doc("A capability the caller must answer itself: the library does not answer it in the fiber.")]
pub effect Greet {
  greet() : String
}

#[doc("Asks for a greeting.")]
pub fn ask() : String / Greet = Greet.greet()

#[doc("Runs `f` in a fiber of its own, handling nothing.")]
pub fn run[e](f: () -> Unit / e) : Unit / Spawn + e = {
  let fiber = Spawn.spawn(() => f())
  Spawn.await(fiber) |> ignore
}
