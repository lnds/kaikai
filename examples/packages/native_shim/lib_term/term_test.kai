# The library's own tests must link its shim: the module's extern
# symbols are referenced by the test binary even when a test body
# never crosses the Ffi boundary.

import term

test "clamp_width bounds" {
  assert term.clamp_width(10) == 20
  assert term.clamp_width(80) == 80
  assert term.clamp_width(999) == 200
}
