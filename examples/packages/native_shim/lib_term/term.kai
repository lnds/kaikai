# A library that binds C through a vendored shim, declared in its
# manifest's [native] table. Consumers build with plain `kai build`;
# the shim travels with the dependency contract.

extern "C" fn tvk_cols() : Int / Ffi

pub fn cols() : Int / Ffi = tvk_cols()

pub fn clamp_width(w: Int) : Int =
  if w < 20 { 20 } else if w > 200 { 200 } else { w }
