#[doc("A package module whose private helper is spelled like a core builtin.")]

#[doc("Numbers each non-empty row through the module's own `read_line`.")]
pub fn describe(rows: [String]) : [String] =
  flat_map(rows |> enumerate |> map(numbered), only_ok)

fn numbered(p: (Int, String)) : Result[Option[String], String] = read_line(p.fst + 1, p.snd)

fn read_line(at: Int, raw: String) : Result[Option[String], String] =
  if string_length(raw) == 0 { Ok(None) } else { Ok(Some("mine:#{at}:#{raw}")) }

fn only_ok(r: Result[Option[String], String]) : [String] = match r {
  Ok(Some(s)) -> [s]
  _           -> []
}
