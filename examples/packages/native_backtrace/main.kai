import probe

effect Yield {
  yield(ok: Bool) : Unit
}

type Gen = Done | Next(Bool, Cont[Unit, Gen, Ffi])

fn on_segment() : Unit / Yield + Ffi = Yield.yield(probe.walks())

fn generate() : Gen / Ffi =
  handle {
    on_segment()
    Done
  } with Yield {
    yield(ok, resume) -> Next(ok, resume)
  }

fn segment_walks(g: Gen) : Bool / Ffi = match g {
  Done -> false
  Next(ok, k) -> {
    k(()) |> ignore
    ok
  }
}

fn main() : Unit / Ffi + Stdout + Spawn + Cancel {
  Stdout.print("main: #{probe.walks()}")
  let fiber = Spawn.spawn(() => probe.walks())
  Stdout.print("fiber: #{Spawn.await(fiber)}")
  Stdout.print("segment: #{segment_walks(generate())}")
  Stdout.print("native stack: #{probe.walks_on_thread_stack()}")
  let worker = Spawn.spawn(() => probe.walks_on_thread_stack())
  Stdout.print("fiber native stack: #{Spawn.await(worker)}")
}
