import loop
import math.bits

fn mix(a: Array[Int], b: Array[Int]) : Int = {
  var total := 0
  var i := 0
  while { i < 3 } {
    let lo = bit_and(a[i], 65535)
    let hi = bit_ushr(a[i], 16)
    var j := 0
    while { j < 3 } {
      let ylo = bit_and(b[j], 65535)
      let cross = hi * ylo + lo * ylo - j
      total := total + cross
      j := j + 1
    }
    i := i + 1
  }
  total
}

fn captured(a: Array[Int]) : Int = {
  let base = bit_and(a[0], 255)
  let add = (x: Int) => x + base
  add(1) + add(2)
}

fn power(n: Int) : Int = {
  let p = 2 ^ n
  let q = p * 3 - 1
  q
}

fn main() : Unit / Stdout = {
  let a = array_make(3, 4294967295)
  let b = array_make(3, 70000)
  println("#{mix(a, b)}")
  println("#{captured(a)}")
  println("#{power(10)}")
}
