# An endless generator of Strings, dropped mid-stream: the element its
# forwarder handed the suspended request is released with the body.

effect Yield { yield(s: String) : Unit }

type Words = Done | Next(String, Cont[Unit, Words])

fn chant(n: Int) : Unit / Yield = {
  Yield.yield("word#{n}")
  chant(n + 1)
}

fn words() : Words =
  handle { chant(1); Done } with Yield { yield(s, resume) -> Next(s, resume) }

fn take(g: Words, n: Int, acc: [String]) : [String] = match g {
  Done -> acc
  Next(w, k) -> if n == 0 { acc } else { take(k(()), n - 1, [w, ...acc]) }
}

fn main() : Unit / Stdout = Stdout.print(join(list_reverse(take(words(), 3, [])), " "))
