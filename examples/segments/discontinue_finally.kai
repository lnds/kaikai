# A segment handle whose clause returns without resuming abandons the body:
# the body unwinds and its `finally` runs once, before the handle returns.

import loop

effect Yield { yield(x: Int) : Unit }

fn main() : Unit / Stdout = {
  let c = handle { Yield.yield(1); Yield.yield(2); Stdout.print("unreachable"); 0 } with Yield {
    yield(x, resume) -> {
      var acc := 0
      var i := 0
      while { i < 2 - x } {
        acc := resume(())
        i := i + 1
      }
      acc + x
    }
    finally { Stdout.print("released") }
  }
  Stdout.print("c=#{c}")
}
