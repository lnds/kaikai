# An endless stateful generator, dropped mid-stream: its state is the list
# of words seen so far, and the handle's `finally` reads it when the
# consumer stops pulling.

effect Yield { yield(s: String) : Unit }

type Words = Done | Next(String, Cont[(Unit, [String]), Words, Stdout])

fn chant(n: Int) : Unit / Yield = {
  Yield.yield("word#{n}")
  chant(n + 1)
}

fn words() : Words / Stdout =
  handle { chant(1); Done } with Yield([]) {
    yield(s, resume) -> Next(s, resume)
    finally { Stdout.print("stopped after #{list_length(state)}") }
  }

fn take(g: Words, n: Int, seen: [String]) : [String] / Stdout = match g {
  Done -> seen
  Next(w, k) -> if n == 0 { seen } else { take(k((), [w, ...seen]), n - 1, [w, ...seen]) }
}

fn main() : Unit / Stdout = {
  let got = take(words(), 3, [])
  Stdout.print(join(list_reverse(got), " "))
}
