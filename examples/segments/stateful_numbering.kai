# The handler numbers what the producer emits; its state is the next
# number. The consumer picks the number after each line with `k((), n)`.
# A skipped line keeps `resume` in a lambda: there `resume(())` is
# `resume((), state)`, the state unchanged.

effect Emit {
  emit(s: String) : Unit
  skip() : Unit
}

type Lines = End | Line(Int, String, Cont[(Unit, Int), Lines]) | Skipped(() -> Lines)

fn poem() : Unit / Emit = {
  Emit.emit("kai")
  Emit.skip()
  Emit.emit("kaikai")
  Emit.emit("hoe")
}

fn numbered() : Lines =
  handle { poem(); End } with Emit(1) {
    emit(s, resume) -> Line(state, s, resume)
    skip(resume)    -> Skipped(() => resume(()))
  }

fn show(ls: Lines) : Unit / Stdout = match ls {
  End            -> Stdout.print("end")
  Line(n, s, k)  -> { Stdout.print("#{n}: #{s}"); show(k((), n * 10)) }
  Skipped(next)  -> { Stdout.print("(skipped)"); show(next()) }
}

fn main() : Unit / Stdout = show(numbered())
