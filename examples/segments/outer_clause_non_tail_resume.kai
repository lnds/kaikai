# A handler outside a segment whose clause resumes before it finishes:
# each clause's tail runs when that handle exits, innermost first, even
# though the op came from the body on the segment.

import loop

effect Yield { yield(x: Int) : Unit }
effect Log { log(s: String) : Unit }

fn body() : Int / Yield + Log = { Log.log("a"); Yield.yield(1); Log.log("b"); Yield.yield(2); 0 }

fn main() : Unit / Stdout = {
  let c = handle {
    handle { body() } with Yield {
      yield(x, resume) -> {
        var acc := 0
        var i := 0
        while { i < 1 } { acc := resume(()); i := i + 1 }
        acc + x
      }
    }
  } with Log { log(s, resume) -> { let r = resume(()); Stdout.print("after #{s}"); r } }
  Stdout.print("c=#{c}")
}
