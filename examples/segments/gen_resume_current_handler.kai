# An effect the producer performs reaches the handler around wherever the
# generator is stepped: each element is tagged by the innermost `Tag`
# handler at the step that produced it, one handle and one call deeper
# each time.

import gen.{Yield, Gen, Done, Next, generate}

effect Tag { tag() : String }

fn tagged(n: Int) : Unit / Yield[String] + Tag =
  if n == 0 { () } else { Yield.yield(Tag.tag()); tagged(n - 1) }

fn show(g: Gen[String, Tag]) : Unit / Stdout + Tag = match g {
  Done       -> Stdout.print("done")
  Next(s, k) -> {
    Stdout.print(s)
    handle { descend(3, k) } with Tag { tag(resume) -> resume("#{Tag.tag()}/in") }
  }
}

fn descend(depth: Int, k: Cont[Unit, Gen[String, Tag], Tag]) : Unit / Stdout + Tag =
  if depth == 0 { show(k(())) } else { descend(depth - 1, k) }

fn main() : Unit / Stdout =
  handle { show(generate { tagged(3) }) } with Tag { tag(resume) -> resume("out") }
