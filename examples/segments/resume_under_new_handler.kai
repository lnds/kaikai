# A body resumed inside a new `Log` handler logs to it: what the body
# performs besides the handled effect reaches the handlers live at the
# resume, not those of its first run.

effect Yield { yield(x: Int) : Unit }
effect Log { log(s: String) : Unit }

fn body() : Int / Yield + Log = { Log.log("a"); Yield.yield(1); Log.log("b"); 0 }

fn main() : Unit / Stdout = {
  let c = handle {
    handle { body() } with Yield {
      yield(x, resume) -> handle { resume(()) } with Log { log(s, r) -> { Stdout.print("inner #{s}"); r(()) } }
    }
  } with Log { log(s, resume) -> { Stdout.print("outer #{s}"); resume(()) } }
  Stdout.print("c=#{c}")
}
