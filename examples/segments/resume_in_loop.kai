# The continuation called inside a loop body: the handle runs its body on
# a stack segment, and the loop resumes it once.

import loop

effect Ask { number() : Int }

fn main() : Unit / Stdout = {
  let c = handle { Ask.number() } with Ask {
    number(resume) -> {
      var i := 0
      var acc := 0
      while { i < 1 } {
        acc := resume(i)
        i := i + 1
      }
      acc
    }
  }
  Stdout.print("c=#{c}")
}
