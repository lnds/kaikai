# A generator: each `yield` hands its value and the continuation out of the
# clause, and the consumer resumes it. The handle runs its body on a stack
# segment; dropping the continuation of an endless generator discontinues it.

effect Yield { yield(x: Int) : Unit }

type Gen = Done | Next(Int, Cont[Unit, Gen])

fn upto(n: Int, lim: Int) : Unit / Yield =
  if n > lim { () } else { Yield.yield(n); upto(n + 1, lim) }

fn count_from(n: Int) : Unit / Yield = {
  Yield.yield(n)
  count_from(n + 1)
}

fn generate(lim: Int) : Gen =
  handle { upto(1, lim); Done } with Yield { yield(x, resume) -> Next(x, resume) }

fn naturals() : Gen =
  handle { count_from(0); Done } with Yield { yield(x, resume) -> Next(x, resume) }

fn sum_all(g: Gen, acc: Int) : Int = match g {
  Done       -> acc
  Next(x, k) -> sum_all(k(()), acc + x)
}

fn take(g: Gen, n: Int) : [Int] =
  if n == 0 { [] } else { match g {
    Done       -> []
    Next(x, k) -> [x, ...take(k(()), n - 1)]
  } }

fn main() : Unit / Stdout = {
  Stdout.print("sum=#{sum_all(generate(100000), 0)}")
  Stdout.print("first=#{take(naturals(), 5)}")
  Stdout.print("empty=#{sum_all(generate(0), 0)}")
}
