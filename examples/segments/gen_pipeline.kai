# The stdlib generator: the same squares-against-fibonacci pipeline as
# build_your_own_generator, written with `gen` and the pipes.

import gen.{Yield, generate, zip_with, take_until, each_indexed, reduce}

fn naturals(from: Int, to: Int) : Unit / Yield[Int] =
  if from >= to { () } else { Yield.yield(from); naturals(from + 1, to) }

fn fibonacci(a: Int, b: Int) : Unit / Yield[Int] = {
  Yield.yield(a)
  fibonacci(b, a + b)
}

fn words() : Unit / Yield[String] = { Yield.yield("ab"); Yield.yield("c") }

fn main() : Unit / Stdout = {
  let squares = generate { naturals(1, 100) } | (x => x * x)
  let fibos = generate { fibonacci(1, 1) }
  squares
    |> zip_with(fibos, (s, f) => s - f)
    |> take_until(d => d < 0)
    |> each_indexed((i, d) => Stdout.print("#{i + 1} #{d}"))
  let evens = generate { naturals(1, 11) } |? (x => x % 2 == 0) |> reduce((a, b) => a + b)
  let pairs = generate { naturals(1, 4) } || (n => generate { naturals(0, n) }) |> reduce((a, b) => a * 10 + b)
  let none = generate { naturals(5, 5) } |> reduce((a, b) => a + b)
  let text = generate { words() } | (w => "<#{w}>") |> reduce((a: String, b: String) => a ++ b)
  Stdout.print("#{evens} #{pairs} #{none} #{text}")
}
