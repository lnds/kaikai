# An endless producer dropped mid-stream while its frame holds a list
# across the `emit` it is suspended in: the frame releases the list with
# the body, whatever the clause calls its continuation.

effect Emit { emit(v: Int) : Unit }

type Stream = Done | Next(Int, Cont[Unit, Stream])

fn stream(body: () -> Unit / Emit) : Stream =
  handle { body(); Done } with Emit { emit(v, k) -> Next(v, k) }

fn count(n: Int, seen: [Int]) : Unit / Emit = {
  Emit.emit(list_length(seen))
  count(n + 1, [n, ...seen])
}

fn take(s: Stream, n: Int, acc: Int) : Int = match s {
  Done       -> acc
  Next(v, k) -> if n == 0 { acc } else { take(k(()), n - 1, acc + v) }
}

fn main() : Unit / Stdout = Stdout.print("#{take(stream { count(0, []) }, 5, 0)}")
