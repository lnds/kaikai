# A producer that reads a file in small chunks and logs each line it
# hands out, paired with line numbers by `zip_with`. Its `File` and `Log`
# reads run whenever the consumer steps it, served by the consumer's
# handlers.

import gen.{Yield, generate, zip_with, each_indexed}

effect Log { log(msg: String) : Unit }

fn numbers(n: Int) : Unit / Yield[Int] = { Yield.yield(n); numbers(n + 1) }

fn emit_lines(h: FileHandle<read>, pending: String) : Unit / Yield[String] + File + Log =
  match File.read_chunk(h, 4) {
    Ok(chunk) -> if string_length(chunk) == 0 { emit_last(pending) } else { emit_parts(h, string_split(pending ++ chunk, "\n")) }
    Err(e)    -> Log.log("read failed: #{e}")
  }

fn emit_parts(h: FileHandle<read>, parts: [String]) : Unit / Yield[String] + File + Log = match parts {
  []              -> emit_lines(h, "")
  [rest]          -> emit_lines(h, rest)
  [line, ...more] -> { emit_last(line); emit_parts(h, more) }
}

fn emit_last(line: String) : Unit / Yield[String] + Log =
  if line == "" { () } else { Log.log("read #{line}"); Yield.yield(line) }

fn lines_of(path: String) : Unit / Yield[String] + File + Log = match File.open_read(path) {
  Ok(h)  -> { emit_lines(h, ""); File.close_file(h) }
  Err(e) -> Log.log("cannot open: #{e}")
}

fn main() : Unit / Stdout + File = {
  let path = "/tmp/kai_segments_file_lines_logged.txt"
  match File.write_file(path, "alpha\nbeta\ngamma\n") {
    Ok(_)  -> ()
    Err(e) -> Stdout.print("cannot write: #{e}")
  }
  handle {
    let numbered = generate { numbers(1) }
    generate { lines_of(path) }
      |> zip_with(numbered, (line, n) => "#{n}: #{line}")
      |> each_indexed((i, s) => Stdout.print(s))
  } with Log { log(msg, resume) -> { Stdout.print("log #{msg}"); resume(()) } }
}
