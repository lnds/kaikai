# A handler inside one generator turns the notes of another into its own
# elements: the inner producer's `Note` reaches a clause that yields to
# the outer generator, which suspends both producers until the consumer
# steps again.

import gen.{Yield, Gen, Done, Next, generate, each_indexed}

effect Note { note(s: String) : Unit }

fn noisy(n: Int) : Unit / Yield[Int] + Note =
  if n == 0 { () } else { Note.note("at #{n}"); Yield.yield(n); noisy(n - 1) }

fn sum_all(g: Gen[Int, Note], acc: Int) : Int / Note = match g {
  Done       -> acc
  Next(x, k) -> sum_all(k(()), acc + x)
}

fn notes() : Unit / Yield[String] = {
  let total = handle { sum_all(generate { noisy(3) }, 0) } with Note {
    note(s, resume) -> { Yield.yield(s); resume(()) }
  }
  Yield.yield("total #{total}")
}

fn main() : Unit / Stdout = generate { notes() } |> each_indexed((i, s) => Stdout.print("#{i} #{s}"))
