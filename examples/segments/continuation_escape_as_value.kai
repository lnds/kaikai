effect Pick { pick() : Int }

# A clause's continuation is its last param whatever it is called; bound
# to a value, it is a `Cont` and the handle runs its body on a segment.
fn main() : Int / Stdout = {
  let r = handle { let x = Pick.pick(); x + 1 }
          with Pick { pick(k) -> { let f = k; f(10) } return(x) -> x }
  Stdout.print("r=#{r}\n"); 0
}
