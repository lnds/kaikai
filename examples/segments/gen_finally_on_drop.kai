# The endless fibonacci producer announces its own end: its handle's
# `finally` prints when the squares-against-fibonacci pipeline stops
# pulling and drops it, so the output ends with that line.

import gen.{Yield, Gen, Done, Next, generate, zip_with, take_until, each_indexed}

fn naturals(from: Int, to: Int) : Unit / Yield[Int] =
  if from >= to { () } else { Yield.yield(from); naturals(from + 1, to) }

fn fibonacci(a: Int, b: Int) : Unit / Yield[Int] = {
  Yield.yield(a)
  fibonacci(b, a + b)
}

fn fibos() : Gen[Int, Stdout] / Stdout =
  handle { fibonacci(1, 1); Done } with Yield[Int] {
    yield(v, resume) -> Next(v, resume)
    finally { Stdout.print("fib stopped") }
  }

fn main() : Unit / Stdout = {
  let squares = generate { naturals(1, 100) } | (x => x * x)
  squares
    |> zip_with(fibos(), (s, f) => s - f)
    |> take_until(d => d < 0)
    |> each_indexed((i, d) => Stdout.print("#{i + 1} #{d}"))
}
