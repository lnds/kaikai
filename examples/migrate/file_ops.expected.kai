import fs.file

fn main() : Unit / Stdout + File {
  let _ = file.write("a.txt", "x")
  let _ = file.append("a.txt", "y")
  let _ = file.read("a.txt")
  let _ = file.rename("a.txt", "c.txt")
  let seen = file.exists("c.txt")
  let _ = file.read_bytes("c.txt")
  let _ = file.write_bytes("b.bin", array_empty())
  let _ = file.delete("c.txt")
  print(seen)
}
