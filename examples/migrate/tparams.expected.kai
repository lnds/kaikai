type Box[t] = { value: t }

type Tag = T(Int)

type Shade = Light | Dark

effect Mailbox[msg] {
  put[item](m: msg, item: item) : Unit
}

fn first[t, u](a: t, b: u) : t = a

fn unbox[t](b: Box[t]) : t = b.value

fn tag[t](x: t) : Tag = T(1)

fn keep[shade](x: shade) : shade = x

fn plain(x: Shade) : Shade = x

fn main() : Unit / Stdout {
  let b = Box { value: 1 }
  Stdout.print("#{unbox(b)} #{first(2, "x")}")
}
