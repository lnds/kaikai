const MAX_N : Int = 3

const BASE_URL : String = "http://x"

fn limit() : Int = MAX_N + 1

fn shout() : String = "n=#{MAX_N} #{BASE_URL}"

fn local_homonym() : Int {
  let retries = 2
  let base_url = "local"
  retries + string_length(base_url)
}

type Cfg = { max_n: Int }

fn field_homonym(c: Cfg) : Int = c.max_n

fn main() : Unit / Stdout {
  Stdout.print("#{limit()} #{shout()} #{local_homonym()} #{field_homonym(Cfg { max_n: MAX_N })}")
}
