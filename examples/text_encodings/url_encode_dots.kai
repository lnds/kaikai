import net.url

fn main() : Unit / Stdout {
  let xs = [
    "", "a", "a b/é", "AZaz09-._~", "!*'();:@&=+$,/?#[]%", "\xFF\x00\xC3", "\xE2\x82\xAC", "~~ ~~"
  ]
  show_enc(xs)
  let base = url.parse("http://h/b/c/d;p?q")
  match base {
    Err(e) -> Stdout.print("base err #{e}")
    Ok(b) -> show_rel(b, [
      "g", "./g", "g/", "/g", "?y", "g?y", "#s", "", ".", "./", "..", "../", "../g", "../..",
      "../../", "../../g", "../../../g", "../../../../g", "/./g", "/../g", "g.", ".g", "g..",
      "..g", "./../g", "./g/.", "g/./h", "g/../h", "g;x=1/./y", "g;x=1/../y",
      "../../../../../a/b/c",
      "a/b/c/./../../g", "mid/content=5/../6", "//x/y/../z", "http:g", "http://a/b/../c/./d/../e",
      "/a/b/c/../../../../d"
    ])
  }
}

fn show_enc(xs: [String]) : Unit / Stdout = match xs {
  [] -> ()
  [s, ...t] -> {
    let e = url.percent_encode(s)
    Stdout.print("enc #{show(s)} -> #{e} -> #{show(url.percent_decode(e))}")
    show_enc(t)
  }
}

fn show_rel(b: url.Url, xs: [String]) : Unit / Stdout = match xs {
  [] -> ()
  [s, ...t] -> {
    match url.parse(s) {
      Err(e) -> Stdout.print("rel #{show(s)} -> parse err #{e}")
      Ok(r) -> match url.resolve(b, r) {
        Ok(u) -> Stdout.print("rel #{show(s)} -> #{url.to_string(u)}")
        Err(e) -> Stdout.print("rel #{show(s)} -> err #{e}")
      }
    }
    show_rel(b, t)
  }
}
