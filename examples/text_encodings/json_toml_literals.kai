import encoding.json
import encoding.toml

fn jrow(s: String) : Unit / Stdout =
  match json.json_decode_report(s) {
    Ok(v) -> Stdout.print("json #{show(s)} -> #{json.json_encode(v)}")
    Err(e) -> Stdout.print("json #{show(s)} -> err #{e.line}:#{e.column}@#{e.offset} #{e.reason}")
  }

fn trow(s: String) : Unit / Stdout =
  match toml.decode_report(s) {
    Ok(v) -> Stdout.print("toml #{show(s)} -> #{toml.encode(v)}")
    Err(e) -> Stdout.print("toml #{show(s)} -> err #{toml.error_message(e)}")
  }

fn jrows(xs: [String]) : Unit / Stdout = match xs {
  [] -> ()
  [s, ...t] -> {
    jrow(s)
    jrows(t)
  }
}

fn trows(xs: [String]) : Unit / Stdout = match xs {
  [] -> ()
  [s, ...t] -> {
    trow(s)
    trows(t)
  }
}

fn main() : Unit / Stdout {
  jrows([
    "true", "false", "null", " [true,false,null] ", "tru", "fals", "nul", "truex", "trUe", "nulll",
    "[true", "t", "", "\"\\ud83d\\ude00\"", "\"\\ud83d\"", "\"\\ud83dx\"", "\"\\ud83d\\u0041\"",
    "\"\\ud83d\\", "\"\\ud83d\\u", "\"\\ud83d\\ude0", "\"\\ude00\"", "\"\\u00e9\"", "\"a\xFFb\"",
    "\"\\ud83d\xC3\xA9\"", "{\"k\":true,\"n\":null}", "[\xFF]"
  ])
  trows([
    "a = true", "a = false", "a = tru", "a = fals", "a = truex", "a=true\nb=false", "a = t",
    "a = f",
    "a = ", "[t]\nx = 1", "[[t]]\nx = 1", "[a.b]\nx = true", "[a.b", "[a.b]]", "[[a.b]", "[[a.b]]",
    "[", "[[", "[a]x", "a = true \xFF", "a = \"\xFF\"", "[\xFF]\nx=1", "a = [true, false]",
    "a = { b = true, c = false }"
  ])
}
