import encoding.base64
import encoding.hex

fn show_opt(o: Option[[Int]]) : String = match o {
  None -> "None"
  Some(bs) -> "Some(#{show(bs)})"
}

fn seq(n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { seq(n - 1, [(n * 37 + 11) % 256, ...acc]) }

fn b64_row(label: String, bs: [Int]) : Unit / Stdout {
  let e = base64.encode(bs)
  let u = base64.encode_url(bs)
  Stdout.print("#{label} #{e} #{u} #{show_opt(base64.decode(e))} #{show_opt(base64.decode_url(u))}")
}

fn dec_rows(xs: [String]) : Unit / Stdout = match xs {
  [] -> ()
  [s, ...t] -> {
    Stdout.print("decode #{show(s)} -> #{show_opt(base64.decode(s))}")
    dec_rows(t)
  }
}

fn hex_rows(xs: [String]) : Unit / Stdout = match xs {
  [] -> ()
  [s, ...t] -> {
    Stdout.print("hex decode #{show(s)} -> #{show_opt(hex.decode(s))}")
    hex_rows(t)
  }
}

fn main() : Unit / Stdout {
  b64_row("empty", [])
  b64_row("1", [0])
  b64_row("2", [255, 254])
  b64_row("3", [251, 255, 191])
  b64_row("4", [1, 2, 3, 4])
  b64_row("5", [250, 251, 252, 253, 254])
  b64_row("6", [255, 255, 255, 255, 255, 255])
  Stdout.print(
    "wild #{base64.encode([256, 511, -1])} #{base64.encode([-256, 300])} #{hex.encode([256, 4095, -1])}"
  )
  b64_row("n20", seq(20, []))
  b64_row("n100", seq(100, []))
  dec_rows([
    "", "=", "====", "Zg", "Zg=", "Zg==", "Zg===", "Zm9v", "Zm9vYg==", "Z", "Z=", "Zm9vY",
    "Zm9v!", "Zm 9v", "Zm=9v", "+/+/", "-_-_", "Zg==Zg==", "\xFF", "\xC3\xA9A", "Zg\xC3\xA9",
    "\xC3\x89AAA", "\xCE\xA3AAA", "\xD9\xA3AAA", "AAA\xEF\xBC\x91", "AAAA\xFF\xFE"
  ])
  Stdout.print(
    "hex #{hex.encode([])} #{hex.encode([0])} #{hex.encode([255, 16, 1, 171])} #{hex.encode(seq(40, []))}"
  )
  hex_rows([
    "", "00", "ff10", "FF10", "aBcD", "f", "abc", "zz", "0g", "\xFF\xFF", "\xC3\xA9", "ff\xC3"
  ])
}
