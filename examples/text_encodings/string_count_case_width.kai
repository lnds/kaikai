import text

fn crow(s: String, n: String) : Unit / Stdout =
  Stdout.print("count #{show(s)} #{show(n)} -> #{string.count(s, n)}")

fn crows(s: String, ns: [String]) : Unit / Stdout = match ns {
  [] -> ()
  [n, ...t] -> {
    crow(s, n)
    crows(s, t)
  }
}

fn case_rows(xs: [String]) : Unit / Stdout = match xs {
  [] -> ()
  [s, ...t] -> {
    let u = string.to_upper_unicode(s)
    let l = string.to_lower_unicode(s)
    Stdout.print("case #{show(s)} -> #{show(u)} #{show(l)} #{string.length(u)} #{string.length(l)}")
    case_rows(t)
  }
}

fn width_rows(xs: [String]) : Unit / Stdout = match xs {
  [] -> ()
  [s, ...t] -> {
    Stdout.print("width #{show(s)} -> #{text.display_width(s)}")
    width_rows(t)
  }
}

fn main() : Unit / Stdout {
  crows("", ["", "a"])
  crows("aaaa", ["a", "aa", "aaa", "aaaa", "aaaaa", "b", ""])
  crows("abcabcabc", ["abc", "bc", "ca", "cab", "x"])
  crows("h\xC3\xA9llo h\xC3\xA9llo", ["\xC3\xA9", "h\xC3\xA9", "\xA9", "\xC3"])
  crows("\xFF\xFF\xFE\xFF", ["\xFF", "\xFF\xFF", "\xFE"])
  crows("a,b,,c,", [",", ",,", "a,", ",c,"])
  case_rows([
    "", "abc", "ABC", "Hello, World!", "\xC3\xA9\xC3\x89", "stra\xC3\x9Fe",
    "\xCE\xB1\xCE\xB2\xCE\xB3", "\xCE\x91\xCE\x92",
    "\xD0\xBF\xD1\x80\xD0\xB8\xD0\xB2\xD0\xB5\xD1\x82", "\xD0\x9F\xD0\xA0", "\xC4\x85\xC4\x84",
    "\xE4\xBD\xA0\xE5\xA5\xBD",
    "\xF0\x9F\x8E\x89a", "\xFF", "a\xFFb", "\xC3", "A\xC3", "\xE2\x82"
  ])
  width_rows([
    "", "hello", "\xE4\xBD\xA0\xE5\xA5\xBD", "\xE2\x96\xB8 Edit", "\xF0\x9F\x8E\x89", "e\xCC\x81",
    "\xF0\x9F\x91\x8D\xF0\x9F\x8F\xBD", "\xF0\x9F\x87\xA8\xF0\x9F\x87\xB1",
    "1\xEF\xB8\x8F\xE2\x83\xA3",
    "\xE2\x9D\xA4\xEF\xB8\x8F", "\xE2\x9D\xA4", "\xFF", "a\xFFb", "\xC3", "\xE4\xBD", "\xF0\x9F",
    "a\xE4\xBD\xA0\xF0\x9F\x91\xA8\xE2\x80\x8D\xF0\x9F\x91\xA9b"
  ])
}
