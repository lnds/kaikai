import fs.file

fn show[t](label: String, r: Result[t, String]) : Unit / Stdout = match r {
  Ok(_) -> Stdout.print("#{label}: ok")
  Err(e) -> match string.split_once(e, " (os error ") {
    Some((head, _)) -> Stdout.print("#{label}: #{head} [code]")
    None -> Stdout.print("#{label}: #{e} [no code]")
  }
}

fn main() : Int / Stdout + File {
  let path = "/tmp/kai-fs-err-chunk-closed"
  match File.open_write(path) {
    Err(e) -> panic(e)
    Ok(w) -> {
      File.close_file(w)
      show("write_chunk", File.write_chunk(w, "x"))
    }
  }
  match File.open_read(path) {
    Err(e) -> panic(e)
    Ok(r) -> {
      File.close_file(r)
      show("read_chunk", File.read_chunk(r, 16))
    }
  }
  0
}
