import fs.file
import os.process

fn sh(script: String) : Unit / Process {
  match process.start("sh", ["-c", script]) {
    Err(_) -> ()
    Ok(child) -> match process.wait(child) {
      _ -> ()
    }
  }
}

fn show(label: String, r: Result[String, String]) : Unit / Stdout = match r {
  Ok(s) -> Stdout.print("#{label}: ok #{string.byte_length(s)} [#{s}]")
  Err(e) -> match string.split_once(e, " (os error ") {
    Some((head, _)) -> Stdout.print("#{label}: #{head} [code]")
    None -> Stdout.print("#{label}: #{e}")
  }
}

fn main() : Int / Stdout + File + Process {
  let root = "/tmp/kai-fs-read-range"
  sh("rm -rf #{root} && mkdir -p #{root}")
  let big = "#{root}/big.txt"
  let small = "#{root}/small.txt"
  let line = "0123456789abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRS\n"
  let body = string.repeat(line, 1600)
  ignore(file.write(big, body))
  ignore(file.write(small, "hello world"))

  let len = string.byte_length(body)
  let tail = ok(file.read_range(big, len - 512, 512))
  Stdout.print("tail matches slice: #{tail == string.slice(body, len - 512, 512)}")
  Stdout.print("tail length: #{string.byte_length(tail)}")
  Stdout.print("tail past end: #{string.byte_length(ok(file.read_range(big, len - 512, 4096)))}")

  show("middle", file.read_range(small, 6, 3))
  show("whole", file.read_range(small, 0, 11))
  show("short read", file.read_range(small, 6, 100))
  show("at eof", file.read_range(small, 11, 5))
  show("past eof", file.read_range(small, 500, 5))
  show("zero length", file.read_range(small, 3, 0))
  show("negative offset", file.read_range(small, -1, 5))
  show("negative length", file.read_range(small, 0, -5))
  show("missing", file.read_range("#{root}/none", 0, 5))
  show("directory", file.read_range(root, 0, 5))

  sh("rm -rf #{root}")
  0
}

fn ok(r: Result[String, String]) : String = match r {
  Ok(s) -> s
  Err(e) -> panic(e)
}
