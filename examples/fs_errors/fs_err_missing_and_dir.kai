import fs.dir
import fs.file
import os.process

fn sh(script: String) : Unit / Process {
  match process.wait(process.start("sh", ["-c", script])) {
    _ -> ()
  }
}

fn payload() : Array[Byte] = match int_to_byte(1) {
  Ok(b) -> array.from([b])
  Err(m) -> panic(m)
}

fn show[t](label: String, r: Result[t, String]) : Unit / Stdout = match r {
  Ok(_) -> Stdout.print("#{label}: ok")
  Err(e) -> Stdout.print("#{label}: #{e}")
}

fn main() : Int / Stdout + File + Process {
  let root = "/tmp/kai-fs-err-missing"
  sh("rm -rf #{root} && mkdir -p #{root}/adir")
  let none = "#{root}/none"
  let adir = "#{root}/adir"

  show("read", file.read(none))
  show("open_read", File.open_read(none))
  show("open_write", File.open_write("#{none}/x"))
  show("read_bytes", file.read_bytes(none))
  show("write_bytes", file.write_bytes("#{none}/x", payload()))
  show("list_entries", dir.list_entries(none))

  show("read dir", file.read(adir))
  show("read_bytes dir", file.read_bytes(adir))
  show("open_write dir", File.open_write(adir))
  show("write_bytes dir", file.write_bytes(adir, payload()))

  sh("rm -rf #{root}")
  0
}
