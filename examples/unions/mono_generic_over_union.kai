# A generic taking a union next to its type variable: the union formal
# binds nothing, and the variable still binds from the other argument.

type U = A | B

fn tag[t](u: U, x: t) : t = match u {
  A -> x
  B -> x
}

fn main() : Int / Stdout {
  Stdout.print(int_to_string(tag(A, 3)))
  Stdout.print(tag(B, "x"))
  0
}
