# A union component named only by a constructor is a nominal type of
# its own: it can annotate a parameter and a return, flow through a
# function unchanged, and lift into its parent.

type U = A | B

fn keep(x: A) : A = x

fn lift(x: A) : U = x

fn pass(u: U) : U = match u {
  a : A -> lift(keep(a))
  b : B -> b
}

fn name(u: U) : String = match u {
  A -> "a"
  B -> "b"
}

fn main() : Int / Stdout {
  Stdout.print(name(pass(A)))
  Stdout.print(name(pass(B)))
  0
}
