fn draw(n: Int, lo: Int, hi: Int, seen_lo: Bool, seen_hi: Bool, bad: Bool) : (Bool, Bool, Bool) / Random =
  if n == 0 { (seen_lo, seen_hi, bad) }
  else {
    let v = Random.int_range(lo, hi)
    draw(n - 1, lo, hi, seen_lo or v == lo, seen_hi or v == hi, bad or v < lo or v > hi)
  }

fn main() : Unit / Stdout + Random = {
  let (seen_lo, seen_hi, bad) = draw(2000, 3, 5, false, false, false)
  Stdout.print("lower bound reachable: #{seen_lo}")
  Stdout.print("upper bound reachable: #{seen_hi}")
  Stdout.print("always in range: #{not bad}")
  Stdout.print("lo == hi: #{Random.int_range(7, 7)}")
  Stdout.print("negative: #{Random.int_range(-2, -2)}")
}
