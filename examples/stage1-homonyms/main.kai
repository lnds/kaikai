# Two modules each declare `scale`. Flattened, both mint one C symbol
# and the second definition collides at link time; keyed on the module
# that declares them, each caller reaches its own — from a function
# body and from inside a lambda, which resolves through its own
# registry rather than the one the walk happened to build first.

import lib.left
import lib.right

fn show(xs: [Int]) : String = string_join(map(xs, int_to_string), ",")

fn main() {
  print(int_to_string(left_scaled(3)))
  print(int_to_string(right_scaled(3)))
  print(show(left_all([1, 2])))
  print(show(right_all([1, 2])))
}
