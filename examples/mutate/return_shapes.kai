type Shape = Dot | Line

fn count(xs: [Int]) : Int = list.length(xs)

fn zero() : Int = 0

fn ratio(a: Int, b: Int) : Real {
  let d = a + b
  1.5
}

fn unit_ratio() : Real = 0.0

fn flag(x: Int) : Bool = x > 3

fn off() : Bool = false

fn name(x: Int) : String = "n#{x}"

fn blank() : String = ""

fn items(x: Int) : [Int] {
  let y = x + 1
  [x, y]
}

fn none() : [Int] = []

fn maybe(x: Int) : Option[Int] = if x > 0 { Some(x) } else { None }

fn nothing() : Option[Int] = None

fn parse(s: String) : Result[Int, String] = if s == "" { Err("empty") } else { Ok(1) }

fn parse_zero() : Result[Int, String] = Ok(0)

fn parse_text(s: String) : Result[String, Int] = Ok(s)

fn parse_blank() : Result[String, Int] = Ok("")

fn shape() : Shape = Dot

fn unit_fn() : Unit = ()

fn untyped(x: Int) = x + 1

fn multi(x: Int) : Int =
  if x > 0 {
    x
  } else {
    0 - x
  }

test "returns are not mutated in tests" {
  assert count([1]) == 1
}

fn kind(s: Shape) : Int = match s {
  Dot -> 1
  Line -> 2
}
