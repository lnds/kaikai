# Mutation-operator fixture: one construct per operator, so the site
# catalogue pins what `kai mutate` finds and where.
#
# The last arm of every `match` is deliberately a catch-all: it must
# NOT appear as a site, because dropping it makes the match
# non-exhaustive and the mutant a compile error rather than a question
# about the suite.

pub fn classify(n: Int) : String = match n {
  0 -> "zero"
  1 -> "one"
  _ -> "many"
}

pub fn bounded(n: Int) : Bool = n >= 0 and n <= 10

pub fn pick(flag: Bool, n: Int) : Int = if flag { n } else { 0 }

pub fn twice(n: Int) : Int = double(n)

fn double(n: Int) : Int = n * 2

fn main() : Unit / Stdout {
  Stdout.print(classify(1))
  Stdout.print("#{bounded(5)}")
  Stdout.print("#{pick(true, 3)}")
  Stdout.print("#{twice(4)}")
}
