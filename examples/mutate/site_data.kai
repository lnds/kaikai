# Site-data fixture for `--mutate-list-json`: every operator, an arm
# deletion inside an impl method, a const, and repeated
# `(operator, original)` pairs within one declaration so the ordinal
# counts past 1.

type Color = Red | Green | Blue

impl Show for Color {
  fn show(c: Color) : String = match c {
    Red -> "red"
    Green -> "green"
    _ -> "blue"
  }
}

const LIMIT: Int = 10

pub fn within(n: Int) : Bool = n >= 0 and n <= LIMIT

pub fn step(n: Int, up: Bool) : Int = if up and n < LIMIT { n + 1 } else { 0 }

pub fn twice(n: Int) : Int = double(double(n))

fn double(n: Int) : Int = n * 2

pub fn clamp(n: Int) : Int = if n < 0 { 0 } else { n }

fn main() : Unit / Stdout {
  Stdout.print(show(Green))
  Stdout.print("#{within(5)}")
  Stdout.print("#{step(3, true)}")
  Stdout.print("#{twice(4)}")
  Stdout.print("#{clamp(0 - 4)}")
}
