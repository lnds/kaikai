# `negate` fixture: one `if` per condition shape.
#
# `not` binds tighter than every binary operator, so a mutant that
# prefixes a bare `not` onto anything but an atom reparses as
# `(not a) == b` and fails to typecheck for a reason that has nothing
# to do with the mutation. Every site here must splice into source the
# typer accepts — a compile-fail in this file is the operator being
# broken, not the suite being weak.

pub fn atom(flag: Bool, n: Int) : Int = if flag { n } else { 0 }

pub fn compare(v: Int, n: Int) : Int = if v == 0 { n } else { 0 }

pub fn connect(a: Int, n: Int) : Int = if a > 0 and a < 10 { n } else { 0 }

pub fn called(v: Int, n: Int) : Int = if is_zero(v) { n } else { 0 }

fn is_zero(v: Int) : Bool = v == 0

fn main() : Unit / Stdout {
  Stdout.print("#{atom(true, 1)}")
  Stdout.print("#{compare(0, 1)}")
  Stdout.print("#{connect(5, 1)}")
  Stdout.print("#{called(0, 1)}")
}
