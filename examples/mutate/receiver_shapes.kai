# Calls that sit under another call or pipe stage: each elidable call
# is one site, however many nodes share its leftmost token.

fn inc(n: Int) : Int = n + 1

fn dbl(n: Int) : Int = n * 2

fn last_of(xs: [Int]) : Option[Int] = last(xs)

pub fn method_receiver(xs: [Int]) : Int = last(xs).unwrap_or(0)

pub fn plain(xs: [Int]) : Option[Int] = last(xs)

pub fn nested_receiver(xs: [Int]) : Int = inc(dbl(xs.length())).abs()

pub fn field_chain(xs: [Int]) : Int = head(xs).unwrap_or(0).abs().abs()

pub fn applied_result(n: Int) : Int = inc(n).max(0)

pub fn has_last(xs: [Int]) : Bool = last(xs).is_some()

pub fn find_then_test(xs: [Int]) : Bool = find(xs, (x) => x > 0).is_some()

fn adder(n: Int) : (Int) -> Int = (m) => n + m

pub fn curried(n: Int) : Int = adder(n)(1)

pub fn pipe_stages(n: Int) : Int = n |> inc |> dbl

pub fn pipe_call(xs: [Int]) : [Int] = xs | inc

pub fn pipe_then_method(n: Int) : Int = (n |> inc).abs()

fn main() : Unit / Console =
  println("#{method_receiver([1])} #{plain([1])} #{nested_receiver([1])} #{field_chain([1])}")
