# An error decided at monomorphisation reaches the collected
# diagnostics: a bound unsatisfied at one instantiation.

protocol Describe {
  describe(x: Self) : String
}

type Cat = Cat(Int)

type Rock = Rock(Int)

impl Describe for Cat {
  fn describe(c: Cat) : String = "cat"
}

fn label[t: Describe](x: t) : String = describe(x)

fn main() : Unit / Stdout {
  Stdout.print(label(Cat(1)))
  Stdout.print(label(Rock(2)))
}
