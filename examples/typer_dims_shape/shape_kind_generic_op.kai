# A `[s: Shape]` function calls a Shape-generic protocol op; the impl is
# resolved per instantiation, so each concrete shape runs its own.
protocol Container[s: Shape] { first(xs: s[Int]) : Int }

protocol Sequence[s: Shape] {
  foldl(xs: s[Int], init: Int, f: (Int, Int) -> Int) : Int
}

type Box[a] = Box(a)
type Chain[a] = Empty | Link(a, Chain[a])

impl Container for Box {
  fn first(xs: Box[Int]) : Int = match xs { Box(v) -> v }
}

impl Container for Chain {
  fn first(xs: Chain[Int]) : Int = match xs {
    Empty      -> 0
    Link(h, _) -> h
  }
}

impl Sequence for Chain {
  fn foldl(xs: Chain[Int], init: Int, f: (Int, Int) -> Int) : Int = match xs {
    Empty      -> init
    Link(h, t) -> foldl(t, f(init, h), f)
  }
}

fn head_of[s: Shape](xs: s[Int]) : Int = first(xs)

fn total[s: Shape](xs: s[Int]) : Int = foldl(xs, 0, (a, b) => a + b)

fn head_twice[s: Shape](xs: s[Int]) : Int = head_of(xs) + head_of(xs)

fn main() : Unit / Stdout = {
  let xs = Link(3, Link(4, Link(5, Empty)))
  Stdout.print(int_to_string(head_of(Box(7))))
  Stdout.print(int_to_string(head_of(xs)))
  Stdout.print(int_to_string(total(xs)))
  Stdout.print(int_to_string(head_twice(xs)))
}
