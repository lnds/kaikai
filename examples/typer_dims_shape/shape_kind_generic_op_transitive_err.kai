protocol Container[s: Shape] { first(xs: s[Int]) : Int }

type Box[a] = Box(a)
type Bare[a] = Bare(a)

impl Container for Box {
  fn first(xs: Box[Int]) : Int = match xs { Box(v) -> v }
}

fn head_of[s: Shape](xs: s[Int]) : Int = first(xs)

fn outer[t: Shape](xs: t[Int]) : Int = head_of(xs) + 1

fn main() : Unit / Stdout = Stdout.print(int_to_string(outer(Bare(7))))
