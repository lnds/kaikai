type Email = String where self |> contains("@")

impl Show for Email {
  fn show(e: Email) : String = "email:" ++ e
}

fn label[a: Show](x: a) : String = show(x)

fn main() : Unit / Stdout = {
  let e : Email = "ana@example.com"
  let same : String where self |> contains("@") = "bob@example.com"
  let other : String where self |> contains("!") = "hey!"
  let plain = "plain"
  Stdout.print(show(e))
  Stdout.print(show(same))
  Stdout.print(show(other))
  Stdout.print(show(plain))
  Stdout.print(label(e))
  Stdout.print(label(plain))
}
