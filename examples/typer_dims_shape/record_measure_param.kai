unit USD
unit EUR

type Money[u: Measure] = { amount: Real<u> }

fn amount_of[u: Measure](m: Money[u]) : Real<u> = m.amount

fn double[u: Measure](m: Money[u]) : Money[u] = Money { amount: m.amount * 2.0 }

fn usd_total(m: Money[USD]) : Real<USD> = m.amount

fn main() : Unit / Stdout = {
  let a : Money[USD] = Money { amount: 2.5<USD> }
  let b = Money { amount: 4.0<EUR> }
  Stdout.print("#{usd_total(a)}")
  Stdout.print("#{amount_of(double(a))}")
  Stdout.print("#{amount_of(b)}")
  Stdout.print("#{double(b).amount}")
}
