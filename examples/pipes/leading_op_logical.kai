# Issue #1585 — leading `and` / `or` continue the previous expression
# across the newline, same as leading pipes.

fn both(a: Bool, b: Bool) : Bool = {
  a
  and b
}

fn either(a: Bool, b: Bool) : Bool = {
  a
  or b
}

fn chained(a: Bool, b: Bool, c: Bool) : Bool = {
  a
  and b
  or c
}

fn main() : Unit / Stdout = {
  Stdout.print("#{both(true, false)} #{either(false, true)} #{chained(true, true, false)}")
}
