fn inc(x: Int) : Int = x + 1

fn main() : Unit / Console {
  let some: Option[Option[Int]] = Some(Some(1))
  println(show(some | (o => o | inc)))
  println(show([[1], [2, 3]] | (o => o | inc)))
  println(show([[1], [2, 3]] | (o => o |? (n => n > 1))))
  println(show([[1], [2, 3]] || (o => o | inc)))
  [[1], [2]] |! (o => o |! (n => println(show(n))))
}
