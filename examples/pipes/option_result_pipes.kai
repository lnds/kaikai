fn inc(x: Int) : Int = x + 1
fn half(x: Int) : Option[Int] = if x % 2 == 0 { Some(x / 2) } else { None }
fn positive(x: Int) : Result[Int, String] = if x > 0 { Ok(x) } else { Err("not positive") }
fn big(x: Int) : Bool = x > 5
fn parse(x: Int) : Option[Int] = Some(x)

fn show_it(n: Int) : Unit / Console = println("got #{n}")

fn main() : Unit / Console {
  let some: Option[Int] = Some(4)
  let none: Option[Int] = None
  let ok: Result[Int, String] = Ok(4)
  let err: Result[Int, String] = Err("boom")

  println(show(some | inc))
  println(show(none | inc))
  println(show(some || half))
  println(show(none || half))
  println(show(Some(3) || half))
  println(show(some |? big))
  println(show(Some(9) |? big))
  println(show(none |? big))

  println(show(ok | inc))
  println(show(err | inc))
  println(show(ok || positive))
  println(show(err || positive))
  println(show(Ok(0) || positive))

  some |! show_it
  none |! show_it
  ok |! show_it
  err |! show_it

  # nested: the outer lambda owns the inner pipe
  let nested: Option[Option[Int]] = Some(Some(1))
  println(show(nested | ((o: Option[Int]) => o | inc)))

  println(show((some | inc) ?? 0))
  println(show((none | inc) ?? 0))
}
