fn twice(x: Int) : Int = x * 2
fn inc(x: Int) : Int = x + 1
fn gt1(x: Int) : Bool = x > 1

fn apply(f: (Int) -> Int, x: Int) : Int = f(x)

fn main() : Unit / Console {
  # a lambda inside parentheses takes the pipes: (h => (h |> twice))
  let a = [1, 2, 3] | (h => h |> twice)
  println(show(a))

  # a lambda passed as an argument takes the pipes up to `,` or `)`
  println(show(apply(x => x |> inc |> twice, 5)))
  println(show(apply((x) => x |> inc, 5)))

  # a bare lambda stage still ends at the next pipe, so a nested body is parenthesised
  let grid = [0..2] | (r) => ([0..2] | (c) => r * 10 + c)
  println(show(grid))

  # `)` closes the lambda before the pipe that follows
  let b = [1..10] |? gt1 | (n => n * 2) |> list_length
  println(show(b))

  let c = foldl([1, 2, 3], Ok([]), (done, x) => done |> and_then(ys => Ok([...ys, x * 2])))
  println(show(c))
}
