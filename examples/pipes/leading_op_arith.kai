# Issue #1585 — leading `+`, `*`, `/`, `^`, `++` continue the previous
# expression across the newline. `-` and `%` are excluded: both can
# start an expression (unary minus, `%{`/`%[` literals), so a leading
# occurrence stays a new statement.

fn main() : Unit / Stdout = {
  let a = 10
    + 2
  let m = a
    * 3
  let d = m
    / 4
  let p = 2
    ^ 3
  let s = "ab"
    ++ "cd"
    ++ "ef"
  let l = [1, 2]
    ++ [3]
  Stdout.print("a=#{a} m=#{m} d=#{d} p=#{p} s=#{s} l=#{l.length()}")
}
