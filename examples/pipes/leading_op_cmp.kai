# Issue #1585 — every comparison operator may lead a continuation line.

fn main() : Unit / Stdout = {
  let a = 12
  let eq = a
    == 12
  let ne = a
    != 0
  let lt = a
    < 99
  let gt = a
    > 1
  let le = a
    <= 12
  let ge = a
    >= 12
  Stdout.print("#{eq} #{ne} #{lt} #{gt} #{le} #{ge}")
}
