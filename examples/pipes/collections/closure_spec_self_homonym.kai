# A fn that applies its functional param and also hands it to a homonym
# (`foldl` calling `list.foldl`) passes it to another fn, not to itself:
# closure specialisation declines it exactly as it declines the same body
# under a name of its own.

fn foldl(xs: [Int], init: Int, f: (Int, Int) -> Int) : Int = {
  let seed = f(init, 1)
  list.foldl(xs, seed, f)
}

fn fold_seeded(xs: [Int], init: Int, f: (Int, Int) -> Int) : Int = {
  let seed = f(init, 1)
  list.foldl(xs, seed, f)
}

fn go(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    let a = foldl([n, 2, 3], 0, (s, x) => s + x * 2)
    let b = fold_seeded([n, 2, 3], 0, (s, x) => s + x * 2)
    go(n - 1, acc + a - b + a)
  }

fn main() : Unit / Stdout = Stdout.print("#{go(1000, 0)}")
