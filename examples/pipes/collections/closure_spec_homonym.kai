# A closure argument that shares its name with another declaration must
# specialise to the one the resolver chose.
import closure_spec_homonym.walk

fn helper[t](x: t) : t = x

fn step(x: Int) : Int = x * 10

fn combine(a: Int, b: Int) : Int = a - b

fn pair_op(f: (Int, Int) -> Int, a: Int, b: Int) : Int = f(a, b)

fn main() : Unit / Stdout = {
  let combine = (a, b) => a * b
  Stdout.print("#{walk.map_all([1, 2], helper)}")
  Stdout.print("#{walk.map_all([1, 2], step)} #{walk.map_then_step([1, 2], step)}")
  Stdout.print("#{pair_op(combine, 3, 4)}")
}
