# A higher-order fn called again from inside the closure it was given
# keeps that inner call on the original fn: only a self-call passing the
# functional param itself folds into the specialisation.

fn fold(xs: [Int], init: Int, f: (Int, Int) -> Int) : Int = match xs {
  [] -> init
  [h, ...t] -> fold(t, f(init, h), f)
}

fn main() : Unit / Stdout = {
  Stdout.print("#{fold([1], 0, (acc, x) => fold([6], 0, (a, b) => x))}")
  Stdout.print("#{fold([1, 2, 3], 0, (acc, x) => acc + fold([x, x], 0, (a, b) => a + b + x))}")
  Stdout.print("#{foldl([1], 0, (acc, x) => foldl([6], 0, (a, b) => x))}")
}
