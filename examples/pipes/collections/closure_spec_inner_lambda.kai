# One higher-order fn called twice, each time with its own closure, where
# the fn hands a lambda capturing that closure to another higher-order fn.
# Each call keeps its own closure: the inner lambda of every
# specialisation is a different closure, though all sit at one position.

import collections.map

fn size(m: Map[String, Int]) : Int = list_length(map.to_pairs(m))

fn total(m: Map[String, Int]) : Int = map.fold(m, 0, (acc, e) => acc + e.snd)

fn abc() : Map[String, Int] =
  map.from([Pair { fst: "a", snd: 1 }, Pair { fst: "b", snd: 2 }, Pair { fst: "c", snd: 3 }])

fn is_big(e: Pair[String, Int]) : Bool = e.snd >= 2

fn is_any(e: Pair[String, Int]) : Bool = e.snd >= 0

fn fold_ints(xs: [Int], init: [Int], f: ([Int], Int) -> [Int]) : [Int] = match xs {
  [] -> init
  [h, ...t] -> fold_ints(t, f(init, h), f)
}

fn keep(xs: [Int], p: (Int) -> Bool) : [Int] =
  fold_ints(xs, [], (acc, x) => if p(x) { [x, ...acc] } else { acc })

fn main() : Unit / Stdout = {
  let big = map.filter(abc(), (e: Pair[String, Int]) => e.snd >= 2)
  let every = map.filter(abc(), (e: Pair[String, Int]) => e.snd >= 0)
  Stdout.print("filter lambda: #{size(big)} #{size(every)}")

  let big_fn = map.filter(abc(), is_big)
  let every_fn = map.filter(abc(), is_any)
  Stdout.print("filter named: #{size(big_fn)} #{size(every_fn)}")

  let ten = map.map(abc(), (e: Pair[String, Int]) => Pair { fst: e.fst, snd: e.snd * 10 })
  let hundred = map.map(abc(), (e: Pair[String, Int]) => Pair { fst: e.fst, snd: e.snd * 100 })
  Stdout.print("map: #{total(ten)} #{total(hundred)}")

  let fm_big = map.flat_map(abc(), (e: Pair[String, Int]) => if e.snd >= 2 { map.from([e]) } else { map.empty() })
  let fm_every = map.flat_map(abc(), (e: Pair[String, Int]) => map.from([e]))
  Stdout.print("flat_map: #{size(fm_big)} #{size(fm_every)}")

  let kept_big = keep([1, 2, 3], (x) => x >= 2)
  let kept_every = keep([1, 2, 3], (x) => x >= 0)
  Stdout.print("hand fold: #{list_length(kept_big)} #{list_length(kept_every)}")

  let xs = [1, 2, 3]
  let list_big = xs |? (x) => x >= 2
  let list_every = xs |? (x) => x >= 0
  Stdout.print("list: #{list_length(list_big)} #{list_length(list_every)}")
}
