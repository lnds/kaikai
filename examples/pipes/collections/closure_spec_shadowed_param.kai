# A closure argument specialised into a higher-order fn replaces the
# functional param only where the param is visible: a lambda param, a
# block binder or a match arm binder of the same name hides it.

fn by_lambda(z: (Int) -> Int) : Int = ((z) => 4 + z)(9)

fn by_let(z: (Int) -> Int) : Int = {
  let a = z(1)
  let z = 30
  a + z
}

fn by_arm(z: (Int) -> Int, o: Option[Int]) : Int = match o {
  Some(z) -> z + 100
  None -> z(5)
}

fn main() : Unit / Stdout = {
  Stdout.print("#{by_lambda((n) => n)}")
  Stdout.print("#{by_let((n) => n + 1)}")
  Stdout.print("#{by_arm((n) => n * 2, Some(7))} #{by_arm((n) => n * 2, None)}")
}
