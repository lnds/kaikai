import collections.vec

fn main() : Unit / Stdout = {
  let v: Vec[Int] = vec.from_list([1, 2, 3, 4])
  let doubled = v | (x => x * 2)
  let big = doubled |? (x => x > 4)
  let spread = big || (x => vec.from_list([x, x + 1]))
  Stdout.print(int_to_string(vec.length(spread)))
  spread |! (x => Stdout.print(int_to_string(x)))
}
