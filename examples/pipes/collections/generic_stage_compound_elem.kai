# Unannotated stages applying a generic function to a compound element:
# the pipe unifies the stage parameter with the element type instead of
# comparing shapes against the container.

import collections.map
import collections.stack

fn pair_dup[a, b](p: Pair[a, b]) : Pair[a, a] = Pair { fst: p.fst, snd: p.fst }

fn main() : Int / Console = {
  let ms = [map.from([Pair { fst: 1, snd: "a" }]),
            map.from([Pair { fst: 2, snd: "b" }, Pair { fst: 3, snd: "c" }])]
  println(show(ms | (m) => map.size(m)))
  let sts = [stack.from_list([1]), stack.from_list([2, 3])]
  println(show(sts | (s) => stack.size(s)))
  let m = map.from([Pair { fst: 1, snd: 10 }, Pair { fst: 2, snd: 20 }])
  println(show(map.size(m | (p) => pair_dup(p))))
  0
}
