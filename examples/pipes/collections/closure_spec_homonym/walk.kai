fn step(x: Int) : Int = x + 1

#[doc("Scales by a hundred; a monomorphic homonym of the root's generic `helper`.")]
pub fn helper(x: Int) : Int = x * 100

#[doc("Applies `f` to every element.")]
pub fn map_all(xs: [Int], f: (Int) -> Int) : [Int] = match xs {
  [] -> []
  [h, ...t] -> [f(h), ...map_all(t, f)]
}

#[doc("Applies `f`, then this module's private `step`, to every element.")]
pub fn map_then_step(xs: [Int], f: (Int) -> Int) : [Int] = map_all(map_all(xs, f), step)
