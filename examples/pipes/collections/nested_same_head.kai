# A collection's own combinators traversing elements of that same
# collection type (`Stack[Stack[Int]]`, `Queue[Queue[Int]]`). The
# combinator's spec and the `list.*` spec it delegates to share the
# closure, so their specialisations must stay distinct per module.

import collections.stack
import collections.queue

fn show_ints(xs: [Int]) : String = match xs {
  []           -> ""
  [x]          -> int_to_string(x)
  [x, ...rest] -> int_to_string(x) ++ "," ++ show_ints(rest)
}

fn main() : Unit / Stdout = {
  let ss = stack.from_list([stack.from_list([1, 2]), stack.from_list([3])])
  let sizes = stack.map(ss, (s: Stack[Int]) => stack.size(s))
  Stdout.print("stack sizes: " ++ show_ints(stack.to_list(sizes)))

  let qq = queue.from_list([queue.from_list([1]), queue.from_list([2, 3])])
  let qsizes = queue.map(qq, (q: Queue[Int]) => queue.size(q))
  Stdout.print("queue sizes: " ++ show_ints(queue.to_list(qsizes)))

  let piped = ss | (s: Stack[Int]) => stack.size(s)
  Stdout.print("piped sizes: " ++ show_ints(stack.to_list(piped)))
}
