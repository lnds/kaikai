# Every callee shape an apply pipe can name runs as the direct call it
# spells: the piped value is the first argument, evaluated before the rest.

type Cfg = { op: (Int) -> Int }

fn sub(a: Int, b: Int) : Int = a - b
fn inc(x: Int) : Int = x + 1
fn apply_to(x: Int, f: (Int) -> Int) : Int = f(x)

fn tick(tag: String, v: Int) : Int / Stdout = {
  Stdout.print(tag)
  v
}

fn main() : Unit / Stdout = {
  let add = (a: Int, b: Int) => a + b
  let cfg = Cfg { op: (n) => n * 3 }
  Stdout.print("bare=#{5 |> inc}")
  Stdout.print("args=#{5 |> sub(7)}")
  Stdout.print("qualified=#{[1, 2, 3] |> list.reverse}")
  Stdout.print("lambda=#{5 |> (n => n + 10)}")
  Stdout.print("local=#{3 |> add(4)}")
  Stdout.print("ctor=#{5 |> Some}")
  Stdout.print("field=#{4 |> cfg.op}")
  let trailing = 5 |> apply_to { n -> n * 7 }
  Stdout.print("trailing=#{trailing}")
  Stdout.print("order=#{tick("lhs", 9) |> sub(tick("arg", 2))}")
}
