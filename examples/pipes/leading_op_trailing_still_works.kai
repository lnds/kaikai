# Issue #1585 — the trailing form (operator at end of line) keeps
# working for every operator the leading form now covers.

fn main() : Unit / Stdout = {
  let a = 10 +
    2
  let m = a *
    3
  let p = 2 ^
    3
  let s = "ab" ++
    "cd"
  let eq = a ==
    12
  let lg = eq and
    true or
    false
  Stdout.print("a=#{a} m=#{m} p=#{p} s=#{s} lg=#{lg}")
}
