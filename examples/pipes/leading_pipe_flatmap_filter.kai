# All four pipes may lead a continuation line: `||` and `|?` get the
# same newline-skip as `|>` and `|`.

fn single(x: Int) : [Int] = [x, x]
fn gt1(x: Int) : Bool = x > 1

fn main() : Unit / Console {
  let c = [1, 2]
    || single
  let d = [1, 2, 3]
    |? gt1
  print(int_to_string(c.length()))
  print(int_to_string(d.length()))
}
