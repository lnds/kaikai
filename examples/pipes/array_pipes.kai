fn double(x: Int) : Int = x * 2
fn gt1(x: Int) : Bool = x > 1
fn twice(x: Int) : Array[Int] = array.from([x, x])

fn main() : Unit / Stdout = {
  let a = array.from([1, 2, 3])
  a |! println("#{.}")
  (a | double) |> array.to_list |! println("#{.}")
  (a |? gt1) |> array.to_list |! println("#{.}")
  (array.from([1, 2]) || twice) |> array.to_list |! println("#{.}")
  array.from([]) |! println("never #{.}")
}
