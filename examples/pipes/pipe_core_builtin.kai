# A core builtin named bare as a map pipe's function, alongside the
# user-fn and lambda forms that already worked. All three build the same
# closure over the pipe's function, so they must agree on both backends.

fn twice(x: Int) : Int = x * 2

fn main() : Unit / Stdout = {
  Stdout.print("#{bytes("ab") | byte_to_int}")
  Stdout.print("#{[1, 2, 3] | int_to_string}")
  Stdout.print("#{[65, 66] | int_to_char}")
  Stdout.print("#{[1.0, 4.0] | real_sqrt}")
  Stdout.print("#{[1, 2] | twice}")
  Stdout.print("#{bytes("ab") | (b => byte_to_int(b))}")
}
