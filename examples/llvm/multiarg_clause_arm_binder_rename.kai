# A match-arm binder re-bound under the same name in a sibling arm's
# nested match stays scoped to that arm. The multi-arg clause-block
# desugar produces exactly this shape when a binder column precedes the
# discriminating one.

type Spell = Arm | Compare | Equiv

fn binder_first(id: Int, s: Spell) : String {
  case n, Arm -> "arm #{n}"
  case n, Compare -> "compare #{n}"
  case n, Equiv -> "equiv #{n}"
}

fn binder_first_two(id: Int, s: Spell) : String {
  case n, Arm -> "arm #{n}"
  case n, _ -> "rest #{n}"
}

fn literal_mixed(id: Int, s: Spell) : String {
  case 0, Arm -> "zero arm"
  case 0, Compare -> "zero compare"
  case m, Arm -> "arm #{m}"
  case m, Compare -> "compare #{m}"
  case m, Equiv -> "equiv #{m}"
}

fn sum_first(s: Spell, id: Int) : String {
  case Arm, n -> "arm #{n}"
  case Compare, n -> "compare #{n}"
  case Equiv, n -> "equiv #{n}"
}

fn both_sums(a: Spell, b: Spell) : String {
  case Arm, Arm -> "aa"
  case Arm, _ -> "a_"
  case _, Arm -> "_a"
  case _, _ -> "__"
}

fn nested_default(a: Int, b: Spell) : String = match a {
  n -> match b {
    Arm -> "arm #{n}"
    _ -> match a {
      n -> "other #{n + 1}"
    }
  }
}

fn nested_exhaustive(a: Int, b: Spell) : String = match a {
  n -> match b {
    Arm -> "arm #{n}"
    Compare -> match a {
      n -> "compare #{n + 1}"
    }
    Equiv -> "equiv #{n}"
  }
}

fn after_match(a: Int, b: Spell) : String {
  let n = a
  let r = match b {
    Arm -> match a + 10 {
      n -> "inner #{n}"
    }
    _ -> "none"
  }
  "#{r} outer #{n}"
}

fn main() : Unit / Stdout = {
  Stdout.print(binder_first(3, Arm))
  Stdout.print(binder_first(4, Compare))
  Stdout.print(binder_first(5, Equiv))
  Stdout.print(binder_first_two(3, Arm))
  Stdout.print(binder_first_two(3, Equiv))
  Stdout.print(literal_mixed(0, Arm))
  Stdout.print(literal_mixed(0, Compare))
  Stdout.print(literal_mixed(0, Equiv))
  Stdout.print(literal_mixed(7, Arm))
  Stdout.print(literal_mixed(7, Compare))
  Stdout.print(sum_first(Arm, 3))
  Stdout.print(sum_first(Equiv, 3))
  Stdout.print(both_sums(Arm, Arm))
  Stdout.print(both_sums(Arm, Compare))
  Stdout.print(both_sums(Compare, Arm))
  Stdout.print(both_sums(Compare, Equiv))
  Stdout.print(nested_default(3, Arm))
  Stdout.print(nested_default(3, Compare))
  Stdout.print(nested_exhaustive(3, Arm))
  Stdout.print(nested_exhaustive(3, Compare))
  Stdout.print(nested_exhaustive(3, Equiv))
  Stdout.print(after_match(3, Arm))
}
