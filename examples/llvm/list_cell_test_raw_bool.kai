fn describe(xs: [Int]) : String = match xs {
  []              -> "empty"
  [x]             -> "one #{x}"
  [x, y]          -> "two #{x} #{y}"
  [x, y, ...rest] -> "many #{x} #{y} #{length(rest)}"
}

fn count(xs: [Int], acc: Int) : Int = match xs {
  []        -> acc
  [_, ...t] -> count(t, acc + 1)
}

fn main() : Unit / Stdout = {
  println(describe([]))
  println(describe([7]))
  println(describe([7, 8]))
  println(describe(upto(5, [])))
  println("#{count(upto(1000, []), 0)}")
  println("#{count([], 0)}")
}

fn upto(n: Int, acc: [Int]) : [Int] = if n == 0 { acc } else { upto(n - 1, [n, ...acc]) }
