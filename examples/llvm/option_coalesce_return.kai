type Pair = Pair(Int, Int)

fn some_mod(i: Int) : Option[Int] = if i % 3 == 0 { None } else { Some(i % 7) }

fn some_word(i: Int) : Option[String] = if i % 2 == 0 { Some("w#{i}") } else { None }

fn some_real(i: Int) : Option[Real] = if i > 2 { Some(1.5) } else { None }

fn some_pair(i: Int) : Option[Pair] = if i > 1 { Some(Pair(i, i + 1)) } else { None }

fn sum_ints(i: Int, acc: Int) : Int =
  if i == 0 { acc } else { sum_ints(i - 1, acc + (some_mod(i) ?? 100)) }

fn pair_sum(p: Pair) : Int = match p {
  Pair(a, b) -> a + b
}

fn main() : Unit / Console {
  println(show(sum_ints(1000, 0)))
  println(show(some_mod(3) ?? 1))
  println(show(some_mod(4) ?? 1))
  println(some_word(2) ?? "none")
  println(some_word(3) ?? "none")
  println(show(some_real(1) ?? 0.5))
  println(show(some_real(5) ?? 0.5))
  println(show(pair_sum(some_pair(1) ?? Pair(0, 0))))
  println(show(pair_sum(some_pair(4) ?? Pair(0, 0))))
  println(show(some_mod(5) ?? some_mod(3) ?? 9))
  println(show(some_mod(3) ?? some_mod(6) ?? 9))
}
