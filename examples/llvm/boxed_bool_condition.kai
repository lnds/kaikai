# Branches on Bools that arrive boxed: through a list, an Option, a closure
# result, a record field and a generic identity, plus `and`/`or`/`not` over them.

type Flag = { name: String, on: Bool }

fn id[t](x: t) : t = x

fn pick(b: Bool) : String = if b { "yes" } else { "no" }

fn count_true(bs: [Bool], acc: Int) : Int = match bs {
  [] -> acc
  [b, ...rest] -> count_true(rest, if b { acc + 1 } else { acc })
}

fn first_or(o: Option[Bool], d: Bool) : Bool = match o {
  Some(b) -> b
  None -> d
}

fn main() : Unit / Stdout {
  let bs = [true, false, 3 > 2, "a" == "b", not false]
  Stdout.print("count=#{count_true(bs, 0)}")
  let f = n => n % 2 == 0
  Stdout.print("even4=#{pick(f(4))} even5=#{pick(f(5))}")
  Stdout.print("some=#{pick(first_or(Some(false), true))} none=#{pick(first_or(None, true))}")
  let fl = Flag { name: "x", on: id(true) }
  Stdout.print("#{fl.name}=#{pick(fl.on)}")
  let a = id(true)
  let b = id(false)
  Stdout.print("and=#{pick(a and b)} or=#{pick(a or b)} not=#{pick(not b)}")
}
