import spawn

pub fn pmap[A, B, e](xs: [A], f: (A) -> B / e) : [B] / Spawn + Cancel + e {
  nursery { n ->
    xs | (x) => n.spawn { f(x) } | n.await
  }
}

fn say(x: Int) : Int / Stdout = { println("#{x}"); x }

fn main() : Int / Spawn + Cancel + Stdout = {
  let a = pmap([1, 2, 3], (x) => x * 2)
  let b = pmap([4], say)
  list.length(a) + list.length(b) - 4
}
