import spawn

effect Fail {
  fail(msg: String) : Nothing
}

pub fn pmap[A, B, e](xs: [A], f: (A) -> B / e) : [B] / Spawn + Cancel + e {
  nursery { n ->
    xs | (x) => n.spawn { f(x) } | n.await
  }
}

fn bad(x: Int) : Int / Fail = Fail.fail("boom")

fn main() : Int / Spawn + Cancel = {
  let r = handle { pmap([1, 2], bad) } with Fail {
    fail(m, resume) -> [0]
  }
  list.length(r)
}
