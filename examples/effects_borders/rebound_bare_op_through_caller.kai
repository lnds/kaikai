effect Logger {
  log(m: String) : Unit
}

fn work() : Unit / Logger + Stdout = {
  handle { Logger.log("bare") } with Logger as lg {
    log(m, resume) -> { println("inner #{m}"); resume(()) }
  }
}

fn main() : Unit / Stdout = {
  handle { work() } with Logger {
    log(m, resume) -> { println("outer #{m}"); resume(()) }
  }
}
