effect Cell { get() : Int  set(n: Int) : Unit }

fn bump(c: Cell) = c.set(c.get() + 1)

fn twice() : Int = {
  handle {
    bump(inner)
    inner.get()
  } with Cell as inner {
    get(resume) -> resume(7)
    set(n, resume) -> resume(())
  }
}

fn main() : Int / Stdout = { print("#{twice()}"); 0 }
