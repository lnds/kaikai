effect Tick {
  tick() : Unit
}

fn run(f: () -> Int / e) : Int = handle {
  f()
} with Tick {
  tick(resume) -> resume(())
}

fn a(n: Int) : Int = run(() => b(n))

fn b(n: Int) : Int = if n <= 0 {
  0
} else {
  Tick.tick()
  a(n - 1) + 1
}

pub fn pure_caller() : Int = a(3)

fn main() : Int / Stdout {
  print("#{pure_caller()}")
  0
}
