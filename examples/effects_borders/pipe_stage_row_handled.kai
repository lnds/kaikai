effect Tool {
  a() : Int
}

fn inc(x: Int) : Int / Tool = x + Tool.a()

fn declared() : Int / Tool {
  let xs = [1, 2] | inc
  list_length(xs) + Tool.a()
}

fn main() : Int {
  let n = handle {
    [1, 2] | (x => x + Tool.a())
  } with Tool {
    a(resume) -> resume(10)
  }
  let m = handle {
    declared()
  } with Tool {
    a(resume) -> resume(1)
  }
  println("#{list_length(n)} #{m}")
  0
}
