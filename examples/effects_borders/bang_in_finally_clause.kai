effect Base {
  base() : Int
}

fn find(n: Int) : Option[Int] = if n > 0 { Some(n) } else { None }

fn run(k: Int) : Option[Int] {
  let r = handle {
    Base.base() + 1
  } with Base {
    base(resume) -> resume(10)
    finally {
      let y = find(k)!
      ()
    }
  }
  Some(r)
}

fn main() : Int / Stdout {
  Stdout.print(int_to_string(run(5) ?? 0))
  0
}
