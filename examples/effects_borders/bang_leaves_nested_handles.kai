effect Base {
  base() : Int
}

effect Tick {
  tick() : Int
}

fn find(n: Int) : Option[Int] = if n > 0 { Some(n) } else { None }

fn validate(n: Int) : Result[Int, String] = if n > 0 { Ok(n) } else { Err("bad") }

fn nested(k: Int) : Option[Int] {
  let r = handle {
    handle {
      let x = find(Base.base() - k)!
      x + Tick.tick()
    } with Tick {
      tick(resume) -> resume(1)
    }
  } with Base {
    base(resume) -> resume(40)
  }
  Some(r)
}

fn results(k: Int) : Result[Int, String] {
  let r = handle {
    let x = validate(Base.base() - k)!
    x + 1
  } with Base {
    base(resume) -> resume(40)
  }
  Ok(r)
}

fn show(o: Option[Int]) : String = match o {
  Some(n) -> "some #{int_to_string(n)}"
  None -> "none"
}

fn show_r(o: Result[Int, String]) : String = match o {
  Ok(n) -> "ok #{int_to_string(n)}"
  Err(e) -> "err #{e}"
}

fn main() : Int / Stdout {
  let v = handle {
    Stdout.print(show(nested(100)))
    Stdout.print(show(nested(1)))
    Stdout.print(show_r(results(100)))
    Stdout.print(show_r(results(1)))
    Base.base()
  } with Base {
    base(resume) -> resume(7)
  }
  Stdout.print(int_to_string(v))
  0
}
