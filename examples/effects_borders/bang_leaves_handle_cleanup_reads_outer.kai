effect Base {
  base() : Int
  note() : Int
}

fn find(n: Int) : Option[Int] = if n > 0 { Some(n) } else { None }

fn run(k: Int) : Option[Int] / Stdout {
  let tag = "run-#{int_to_string(k)}"
  let r = handle {
    let x = find(Base.base() - k)!
    x + 1
  } with Base {
    finally {
      Stdout.print("closed #{tag}")
    }
    base(resume) -> resume(40)
    note(resume) -> resume(0)
  }
  Some(r)
}

fn viaReturn(k: Int) : Option[Int] / Stdout {
  let tag = "ret-#{int_to_string(k)}"
  let r = handle {
    Base.base()
  } with Base {
    finally {
      Stdout.print("closed #{tag}")
    }
    base(resume) -> resume(40)
    note(resume) -> resume(0)
    return(v) -> find(v - k)!
  }
  Some(r)
}

fn show(o: Option[Int]) : String = match o {
  Some(n) -> "some #{int_to_string(n)}"
  None -> "none"
}

fn main() : Int / Stdout {
  Stdout.print(show(run(100)))
  Stdout.print(show(run(1)))
  Stdout.print(show(viaReturn(100)))
  Stdout.print(show(viaReturn(1)))
  0
}
