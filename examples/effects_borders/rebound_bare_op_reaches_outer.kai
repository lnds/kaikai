effect Logger {
  log(m: String) : Unit
}

fn work() : Unit / Logger + Stdout = {
  handle { Logger.log("through caller") } with Logger as lg {
    log(m, resume) -> { println("inner #{m}"); resume(()) }
  }
}

fn main() : Unit / Stdout = {
  handle {
    handle {
      Logger.log("bare")
      lg.log("named")
      let f = () => Logger.log("lambda")
      f()
    } with Logger as lg {
      log(m, resume) -> { println("inner #{m}"); resume(()) }
    }
    work()
  } with Logger {
    log(m, resume) -> { println("outer #{m}"); resume(()) }
  }
}
