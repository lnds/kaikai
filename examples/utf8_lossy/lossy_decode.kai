fn cps(s: String) : [Int] = string.chars(s) |> map((c) => char_to_int(c))

fn row(label: String, s: String) : Unit / Console =
  print("#{label} count=#{string.char_count(s)} cps=#{show(cps(s))}")

fn main() : Unit / Console {
  row("stray", "a\x80b")
  row("stray-hi", "a\xFFb\xF8")
  row("trunc2", "a\xC3")
  row("trunc3", "a\xE2\x82")
  row("trunc4", "a\xF0\x9F\x98")
  row("overlong2", "\xC0\x80")
  row("overlong3", "\xE0\x80\x80")
  row("overlong4", "\xF0\x80\x80\x80")
  row("surrogate", "\xED\xA0\x80")
  row("too-big", "\xF4\x90\x80\x80")
  row("bad-cont", "\xE2\x28\xA1")
  row("valid", "a\xC3\xA9\xE2\x82\xAC\xF0\x9F\x98\x80")
  print(show(string.byte_length(string.char_slice("a\x80\xC3\xA9\xFF", 1, 3))))
  print(show(string.char_index_of("a\x80b", "b")))
}
