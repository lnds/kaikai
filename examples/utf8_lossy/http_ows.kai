import net.http

fn main() : Unit / Console {
  match http.parse_response("HTTP/1.1 200 OK\r\nX-A: \t\xC2\xA0v\xC2\x85 \t\r\nX-B:  plain \r\n\r\nbody") {
    Ok(r) -> {
      print(show(http.header_lookup(r.headers, "X-A") == Some("\xC2\xA0v\xC2\x85")))
      print(show(http.header_lookup(r.headers, "X-B") == Some("plain")))
    }
    Err(e) -> print("err #{e}")
  }
  print(show(http.dechunk_body("\xC2\xA05\r\nhello\r\n0\r\n\r\n")))
  print(show(http.dechunk_body(" 5 \r\nhello\r\n0\r\n\r\n")))
}
