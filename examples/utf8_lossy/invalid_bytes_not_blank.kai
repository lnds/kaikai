fn main() : Unit / Console {
  print(show(string.is_blank("\x85")))
  print(show(string.is_blank("\xA0")))
  print(show(string.is_blank("\xC9")))
  print(show(string.is_blank("\x85\xC9")))
  print(show(string.trim("\x85x") == "\x85x"))
  print(show(string.trim("\xA0 x \xA0") == "\xA0 x \xA0"))
  print(show(string.trim("\xC2\xA0\xA0") == "\xA0"))
  print(show(string.is_blank("\xC2\xA0 \xC2\x85")))
  print(show(string.trim("\xC2\xA0ab\xE2\x80\x83") == "ab"))
}
