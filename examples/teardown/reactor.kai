# Leaves work for the runtime's shutdown: a timer heap and a ready batch, the
# buffered exit of a child nobody waits for, and a userdata table.
import ffi
import spawn
import time

fn nap(i: Int) : Int / Clock {
  sleep(millis(1 + i % 5))
  i
}

fn sleepers(n: Int) : Int / Spawn + Clock =
  nursery { s ->
    let fs = [1..n] | (i => s.spawn(() => nap(i)))
    fs | (f => s.await(f)) |> sum()
  }

fn handles(n: Int, sum: Int) : Int / Ffi =
  if n == 0 {
    sum
  } else {
    let h = retain_userdata(n)
    let v: Int = take_userdata(h)
    release_userdata(h)
    handles(n - 1, sum + v)
  }

fn main() : Unit / Spawn + Clock + Process + Stdout + Ffi {
  let slept = sleepers(200)
  let started = match Process.start("/bin/sh", ["-c", "exit 0"]) {
    Ok(_) -> "started"
    Err(m) -> m
  }
  sleep(millis(100))
  Stdout.print("#{slept}, #{started}, #{handles(2000, 0)}")
}
