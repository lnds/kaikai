# Leaves work for the runtime's shutdown: fibers on pooled stacks, handlers
# and a stack segment inside them, a monitor left on main, and a cell pool.
import actor
import spawn

effect Tick {
  tick(n: Int) : Int
}

fn count(n: Int, acc: Int) : Int / Tick =
  if n == 0 { acc } else { count(n - 1, acc + Tick.tick(n)) }

fn after(n: Int) : Int =
  handle {
    count(n, 0)
  } with Tick {
    tick(k, resume) -> resume(k) + 1
  }

fn watcher(parent: Pid[String]) : Unit / Actor[String] + Monitor {
  let _ref = Monitor.monitor(parent)
  Actor.send(parent, "watching")
}

fn actors(n: Int, acks: Int) : Int / Actor[String] + Spawn + Monitor =
  if n == 0 {
    acks
  } else {
    let me = Actor.self()
    let _w = spawn_actor(() => watcher(me))
    let _a = Actor.receive()
    actors(n - 1, acks + 1)
  }

fn fibers(n: Int) : Int / Spawn =
  nursery { s ->
    let fs = [1..n] | (i => s.spawn(() => after(i % 8)))
    fs | (f => s.await(f)) |> sum()
  }

fn main() : Unit / Spawn + Stdout + Monitor {
  let acks = with_mailbox { actors(64, 0) }
  let sum = fibers(256)
  let own = after(16)
  Stdout.print("#{acks} actors, #{sum}, #{own}")
}
