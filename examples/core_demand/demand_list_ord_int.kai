# `<` on lists reaches the element order through the runtime table.

fn main() : Unit / Stdout = {
  println("#{[1] < [2]}")
  println("#{[1, 2] < [1, 3]}")
  println("#{[1, 2] <= [1, 2]}")
  println("#{[2] > [1, 9]}")
  println("#{[1] >= [2]}")
  println("#{[] < [1]}")
  println("#{[[1], [2]] > [[1], [1, 0]]}")
  println("#{[(1, "a")] < [(1, "b")]}")
  println("#{[Some(1)] < [Some(2)]}")
}
