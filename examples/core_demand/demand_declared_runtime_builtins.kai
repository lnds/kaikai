fn main() : Unit / Stdout = {
  let xs = [1, 2, 3, 4, 5, 6]
  print(int_to_string(reduce(xs, 0, (a, x) => a + x)))
  each(filter(map(xs, (x) => x * 3), (x) => x % 2 == 0), (x) => print(int_to_string(x)))
  print(int_to_string(list_length(flat_map(xs, (x) => [x, x]))))
  let apply = reduce
  print(int_to_string(apply(xs, 10, (a, x) => a - x)))
  let v = vec_make(3, 7)
  print(int_to_string(vec_length(vec_tail_from(v, 1))))
  print(show(array_same(array_empty(), array_empty())))
  write_stdout("done\n")
}
