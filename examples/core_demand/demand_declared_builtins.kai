import fs.file

fn show_all(xs: [String]) : Unit / Stdout = {
  Stdout.print(string_join(xs, ","))
}

fn pick(r: Result[Byte, String]) : Byte = match r {
  Ok(b)  -> b
  Err(e) -> panic(e)
}

fn main() : Unit / Stdout + File = {
  let ns = [3, 1, 2]
  show_all(list_reverse(ns) | int_to_string)
  Stdout.print(int_to_string(list_length(list_append(ns, [9]))))
  Stdout.print(real_to_string(real_pow(2.0, 10.0)))
  Stdout.print(int_to_string(byte_to_int(byte_add(pick(int_to_byte(250)), pick(int_to_byte(10))))))
  Stdout.print(uint64_to_string(int_to_uint64(42)))
  Stdout.print(string_slice("declared", 2, 3))
  Stdout.print(int_to_string(string_length(string_concat("ab", "cd"))))
  match string_to_int("77") { Some(n) -> Stdout.print(int_to_string(n))  None -> Stdout.print("none") }
  Stdout.print(int_to_string(char_to_int(int_to_char(65))))
  Stdout.print(show(file.exists("/definitely/not/here")))
  let up = string_concat_all(["a", "b", "c"]) |> string_reverse
  Stdout.print(up)
  let conv = int128_to_string
  Stdout.print(conv(int_to_int128(5)))
  Stdout.print(twice_str(string_reverse, "kai"))
  show_with(int_to_string, 12)
}

fn twice_str(f: (String) -> String, s: String) : String = f(f(s))

fn show_with(f: (Int) -> String, n: Int) : Unit / Stdout = Stdout.print(f(n))
