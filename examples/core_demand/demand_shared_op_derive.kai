# A derived protocol shares its operation name with the core `Eq`: a field of a
# core type answers through the core impl, which no source text names.

protocol Same {
  eq(a: Self, b: Self) : Bool
}

#[derive(Same)]
type Item = Named(String, Int) | Empty

fn main() : Unit / Stdout = {
  Stdout.print("#{eq(Named("x", 1), Named("x", 1))} #{eq(Named("x", 1), Named("y", 1))} #{eq(Empty, Empty)}")
}
