# `yield` is an operation of two effects. A core handler for one of them is
# reached only through the typed program, and the collision check must see it.

import gen.{Yield, generate, reduce}

fn naturals(from: Int, to: Int) : Unit / Yield[Int] =
  if from >= to { () } else { Yield.yield(from); naturals(from + 1, to) }

fn main() : Unit / Stdout = {
  let total = generate { naturals(1, 5) } |> reduce((a, b) => a + b)
  Stdout.print("#{total}")
}
