#[derive(Show, Eq)]
type Row = { id: Int, ratio: Real, name: String, tags: [Int] }

fn main() : Unit / Stdout = {
  let r = Row { id: 1, ratio: 2.5, name: "kai", tags: [3, 4] }
  Stdout.print(show(r))
  Stdout.print(show(r == r))
  Stdout.print(show(int_to_uint64(9)))
  Stdout.print(show(int_to_int128(5)))
}
