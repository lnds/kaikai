fn apply_to(h: ([Int], (Int) -> Int) -> [Int], xs: [Int]) : [Int] = h(xs, (x) => x + 1)

fn keep(p: ([Int], (Int) -> Bool) -> [Int], xs: [Int]) : [Int] = p(xs, (x) => x > 2)

fn main() : Unit / Stdout = {
  let xs = [1, 2, 3, 4]
  let f = map
  print(show(f(xs, (x) => x * 2)))
  print(show(apply_to(map, xs)))
  print(show(keep(filter, xs)))
  let g = each
  g(xs, (x) => print(show(x)))
  let h = flat_map
  print(show(h(xs, (x) => [x, x])))
  let om: (Option[Int], (Int) -> Int) -> Option[Int] = map
  print(show(om(Some(4), (x) => x + 10)))
}
