# A root `Pair` and the core one share a name: a core function typed on demand
# must read its own annotations, not the program's.

type Pair[a, b] = P(a, b)

fn mine() : Pair[Int, Int] = P(1, 2)

fn first_of_mine(p: Pair[Int, Int]) : Int = match p {
  P(a, _) -> a
}

fn first_of_core(xs: [Int]) : Int = match list.enumerate(xs) {
  [e, ..._] -> e.fst
  [] -> 0
}

fn main() : Unit / Stdout = Stdout.print("#{first_of_mine(mine())} #{first_of_core([7, 8])}")
