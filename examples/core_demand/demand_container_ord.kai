#[derive(Eq, Ord)]
type P = { a: Int, b: Int }

#[derive(Eq, Ord)]
type S = A(Int) | B(Int, Int)

#[derive(Eq, Ord)]
type L = { xs: [Int] }

fn main() : Unit / Stdout = {
  println("#{(1, 2) < (1, 3)}")
  println("#{Some(1) < Some(2)}")
  println("#{P { a: 1, b: 2 } < P { a: 1, b: 3 }}")
  println("#{A(1) < B(0, 0)}")
  println("#{B(1, 2) < B(1, 3)}")
  println("#{L { xs: [1] } < L { xs: [2] }}")
  println("#{Some([1]) < Some([2])}")
  println("#{([1], 2) < ([1], 3)}")
  println("#{Some(1.5) < Some(2.5)}")
  println("#{(1.5, 2) < (1.5, 3)}")
}
