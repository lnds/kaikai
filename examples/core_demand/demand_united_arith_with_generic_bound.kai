unit USD

fn gap[t : Sub](a: t, b: t) : t = a - b
fn flip[t : Neg](a: t) : t = -a
fn quot[t : Div](a: t, b: t) : t = a / b

fn main() : Unit / Stdout {
  println("#{gap(5.0, 2.0)}")
  println("#{flip(3.0)}")
  println("#{quot(6.0, 3.0)}")
  println("#{5.0<USD> - 2.0<USD>}")
  println("#{-(3.0<USD>)}")
  println("#{6.0<USD> / 3.0<USD>}")
}
