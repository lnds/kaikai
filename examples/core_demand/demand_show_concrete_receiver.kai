# `show` at settled receiver types asks only for the impls that serve them.

type Point = { x: Int, y: Int }

impl Show for Point {
  fn show(p: Point) : String = "(#{p.x}, #{p.y})"
}

fn main() : Unit / Stdout = {
  Stdout.print(show(7i32))
  Stdout.print(show("s"))
  Stdout.print(show(Point { x: 1, y: 2 }))
}
