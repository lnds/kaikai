# A bounded generic instantiated at Int: the bound names an impl no call selects,
# so the typed scan never asks for it and the registry must still hold it.

fn twice[T: Add](x: T) : T = x + x

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(twice(21)))
  Stdout.print(show(twice(1.5)))
}
