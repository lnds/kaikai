# `==` on a record compares its fields by the runtime, and a field whose type
# an imported module gives an `Eq` impl is compared through that impl.

import time

type Slot = { wait: time.Duration, n: Int }

fn main() : Unit / Stdout = {
  let a = Slot { wait: time.millis(5), n: 1 }
  let b = Slot { wait: time.millis(5), n: 1 }
  let c = Slot { wait: time.millis(6), n: 1 }
  Stdout.print("#{a == b} #{a == c}")
}
