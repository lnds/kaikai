# The bodies of core impls are held aside and completed only for the impls the
# program reaches: tuple ordering, equality and hashing.

fn main() : Unit / Stdout {
  let a = (1, "x", 5)
  let b = (1, "y", 4)
  let q = min((2, 1, 0, 9), (2, 1, 0, 8))
  Stdout.print(if cmp(a, b) < 0 { "lt" } else { "ge" })
  Stdout.print("#{max((1, 2), (1, 3))}")
  Stdout.print("#{q.frt}")
  Stdout.print("#{a == b}")
  Stdout.print("#{hash((1, 2, 3))}")
}
