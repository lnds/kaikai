# Under a pipe or redirection none of the standard streams is a
# terminal, so the default `is_tty` handlers must answer false on
# all three fds. The true case needs a real terminal and is not
# reproducible under a test harness.
fn main() : Unit / Stdout + Stderr + Stdin = {
  Stdout.print("stdout tty: #{Stdout.is_tty()}")
  Stdout.print("stderr tty: #{Stderr.is_tty()}")
  Stdout.print("stdin tty: #{Stdin.is_tty()}")
}
