effect Tick {
  tick() : Unit
}

type Box[e] = { f: () -> Int / e }

fn main() : Int / Stdout {
  let b = Box {
    f: () => {
      Tick.tick()
      1
    }
  }
  let run = () => handle {
    let g = b.f
    g()
  } with Tick {
    tick(resume) -> resume(())
    return(x) -> x
  }
  Stdout.print(int_to_string(run()))
  let g = b.f
  g()
}
