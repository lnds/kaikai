# Several fibers accept on one shared listener while as many clients connect,
# round after round. A fiber that fails a socket op reports 0 and the round
# sum drops below the fiber count.

import spawn
import net.tcp

fn serve_one(l: Listener) : Int / NetTcp {
  match NetTcp.accept(l) {
    Err(_) -> 0
    Ok(srv) ->
      match NetTcp.recv(srv, 16) {
        Err(_) -> {
          NetTcp.close(srv)
          0
        }
        Ok(_) ->
          match NetTcp.send(srv, [75]) {
            Err(_) -> {
              NetTcp.close(srv)
              0
            }
            Ok(_) -> {
              NetTcp.close(srv)
              1
            }
          }
      }
  }
}

fn client_one(port: Int) : Int / NetTcp {
  match NetTcp.connect("127.0.0.1", port) {
    Err(_) -> 0
    Ok(c) ->
      match NetTcp.send(c, [80]) {
        Err(_) -> {
          NetTcp.close(c)
          0
        }
        Ok(_) ->
          match NetTcp.recv(c, 16) {
            Err(_) -> {
              NetTcp.close(c)
              0
            }
            Ok(_) -> {
              NetTcp.close(c)
              1
            }
          }
      }
  }
}

fn round(l: Listener, port: Int) : Int / NetTcp + Spawn {
  nursery { n ->
    let s1 = n.spawn(() => serve_one(l))
    let s2 = n.spawn(() => serve_one(l))
    let s3 = n.spawn(() => serve_one(l))
    let s4 = n.spawn(() => serve_one(l))
    let c1 = n.spawn(() => client_one(port))
    let c2 = n.spawn(() => client_one(port))
    let c3 = n.spawn(() => client_one(port))
    let c4 = n.spawn(() => client_one(port))
    n.await(s1) + n.await(s2) + n.await(s3) + n.await(s4) +
      n.await(c1) + n.await(c2) + n.await(c3) + n.await(c4)
  }
}

fn rounds(l: Listener, port: Int, left: Int, ok: Int) : Int / NetTcp + Spawn {
  if left == 0 { ok } else { rounds(l, port, left - 1, ok + round(l, port)) }
}

fn main() : Int / NetTcp + Spawn + Stdout {
  match NetTcp.listen("127.0.0.1", 0) {
    Err(e) -> {
      Stdout.print(string_concat("listen FAIL: ", e))
      1
    }
    Ok(l) -> {
      let total = rounds(l, local_port(l), 150, 0)
      Stdout.print(string_concat("completed ", int_to_string(total)))
      if total == 1200 { 0 } else { 1 }
    }
  }
}
