# Effect rows as a type-constructor parameter, stored in a data value —
# the `stdlib/stream.kai` carrier shape. The row-kind slot resolves
# through a row carrier, so the field's `/ e` and the head's `e` slot
# share one row variable and the handler discharges the stored effect.
#
# Covers the carriers that hold a row: single-constructor variant,
# multi-constructor sum, a type nesting another row carrier, and a
# recursive type whose row travels through its own occurrence.
#
# The trap `Pair` pins: a tparam counts as row-kind only when the type
# itself mentions it after a `/`. Passing it on as a type argument
# (`Box[t, e]`) alone leaves the slot ordinary-kind, and the type then
# fails to unify at a generic call site.

effect Log { say(s: String) : Unit }

# single-constructor variant — the Stream shape
pub type Box[t, e] = Box((t) -> Bool / e)

fn call[t, e](b: Box[t, e], x: t) : Bool / e = match b { Box(f) -> f(x) }

# multi-constructor sum: only one arm carries the row
pub type Src[t, e] = Pure(t) | Eff(() -> t / e)

fn force[t, e](s: Src[t, e]) : t / e = match s {
  Pure(v) -> v
  Eff(f)  -> f()
}

# nests another row carrier; the trailing `/ e` field is what keeps the
# `e` slot row-kind
pub type Pair[t, e] = Pair(Box[t, e], () -> Unit / e)

fn both[t, e](p: Pair[t, e], x: t) : Bool / e = match p {
  Pair(a, done) -> if call(a, x) { { done(); true } } else { false }
}

# recursive occurrence carrying the same row
pub type Rec[t, e] = Done(t) | More(() -> Rec[t, e] / e)

fn drive[t, e](r: Rec[t, e]) : t / e = match r {
  Done(v) -> v
  More(k) -> drive(k())
}

fn main() : Int = {
  let mk = (tag: String) => Box((n: Int) => { Log.say(tag); n > 0 })
  let p : Pair[Int, Log] = Pair(mk("box-a"), () => Log.say("box-done"))
  let s : Src[Int, Log] = Eff(() => { Log.say("src"); 2 })
  let r : Rec[Int, Log] = More(() => { Log.say("rec"); Done(5) })

  let total = handle {
    let ok = both(p, 1)
    let v = force(s) + drive(r)
    if ok { v } else { 0 }
  } with Log {
    say(m, resume) -> { print(m); resume(()) }
  }

  print("row_in_ordinary_type #{total}")
  0
}
