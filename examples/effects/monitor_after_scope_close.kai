# A monitor placed after the helper's with_mailbox closed waits for the
# fiber behind the pid to end; the scope closing is not its death.

import actor
import spawn

type Note = Hello(Pid[Note])

fn helper(boss: Pid[Note]) : Unit / Spawn + Console + Cancel = {
  with_mailbox {
    Actor.send(boss, Hello(Actor.self()))
  }
  Spawn.yield()
  Stdout.print("helper: scope closed, fiber still running")
  Cancel.raise()
}

fn watch(p: Pid[Note]) : Unit / Monitor + Console = {
  with_mailbox {
    let _ = Monitor.monitor(p)
    let dead = Actor.receive()
    let _ = dead
    Stdout.print("supervisor: helper ended")
  }
}

fn main() : Int / Spawn + Cancel + Monitor + Console = {
  with_mailbox {
    let me = Actor.self()
    let _ = spawn.spawn(() => helper(me))
    match Actor.receive() {
      Hello(p) -> watch(p)
    }
    0
  }
}
