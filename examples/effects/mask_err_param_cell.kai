fn stash(a: Array[Int], r: Ref[Array[Int]]) : Unit / Mutable = Mutable.ref_set(r, a)

fn go(r: Ref[Array[Int]]) : Unit {
  let a = array_make(2, 0)
  stash(a, r)
}

fn main() : Unit / Mutable + Console = {
  let r = Mutable.ref_make(array_make(1, 0))
  go(r)
  print(int_to_string(Mutable.ref_get(r)[0]))
}
