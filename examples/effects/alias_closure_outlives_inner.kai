# A closure captures the cell its `var` named where it was written. An
# inner `var` of the same name, live while the closure runs or gone before
# it does, changes neither a closure made before it nor one made after it.

fn main() : Unit / Stdout = {
  var n := 1
  let bump = () => { n := n + 10 }
  let inner = {
    var n := 100
    bump()
    let within = () => { n := n + 1 }
    within()
    n
  }
  let after = () => n * 2
  bump()
  Stdout.print(int_to_string(inner))
  Stdout.print(int_to_string(n))
  Stdout.print(int_to_string(after()))
}
