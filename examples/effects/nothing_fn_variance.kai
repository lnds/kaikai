effect Abort {
  abort() : Nothing
}

fn plain(x: Int) : Int = x + 1

fn diverge() : Nothing / Abort = Abort.abort()

fn on_nothing(g: (Nothing) -> Int) : Int = 7

fn on_int(g: () -> Int / Abort) : Int / Abort = g()

fn cond(b: Bool) : Int / Abort = if b { 1 } else { diverge() }

fn pick_if(b: Bool) : () -> Int / Abort = if b { () => diverge() } else { () => 5 }

fn pick_match(n: Int) : () -> Int / Abort =
  match n {
    0 -> () => diverge()
    _ -> () => 5
  }

fn main() : Unit / Stdout {
  let a = on_nothing(plain)
  let b : Int = handle { on_int(diverge) } with Abort { abort(resume) -> -1 }
  let c : Int = handle { cond(false) } with Abort { abort(resume) -> -2 }
  let d : Int = handle { pick_if(false)() } with Abort { abort(resume) -> -3 }
  let e : Int = handle { pick_match(1)() } with Abort { abort(resume) -> -4 }
  let f = if b == -1 { () => diverge() } else { () => 5 }
  let g = match e { 0 -> () => diverge()  _ -> () => 5 }
  let h : Int = handle { f() + g() } with Abort { abort(resume) -> -5 }
  let k = if b == 0 { () => diverge() } else { () => 5 }
  let m = match b { 0 -> () => diverge()  _ -> () => 6 }
  let kv : Int = handle { k() } with Abort { abort(resume) -> -6 }
  let mv : Int = handle { m() } with Abort { abort(resume) -> -7 }
  println("h=" ++ int_to_string(h) ++ " k=" ++ int_to_string(kv) ++ " m=" ++ int_to_string(mv))
  println("a=" ++ int_to_string(a) ++ " b=" ++ int_to_string(b) ++ " c=" ++ int_to_string(c) ++ " d=" ++ int_to_string(d) ++ " e=" ++ int_to_string(e))
}
