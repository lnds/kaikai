# An actor still parked in `receive` when `main` returns is cancelled and
# joined: its cleanup runs before the program exits, and the exit code is 0.

import actor
import time

effect Lease {
  renew() : Unit
}

fn serve() : Unit / Actor[String] + Stdout = handle {
  let said = Actor.receive()
  Stdout.print("served #{said}")
  let _ = Actor.receive()
} with Lease {
  finally { Stdout.print("server released") }
  renew(resume) -> resume(())
}

fn run() : Unit / Actor[String] + Spawn + Stdout + Clock = {
  let pid = spawn_actor(() => serve())
  Actor.send(pid, "ping")
  sleep(millis(50))
}

fn main() : Int / Spawn + Stdout + Clock = {
  with_mailbox { run() }
  Stdout.print("main returning")
  0
}
