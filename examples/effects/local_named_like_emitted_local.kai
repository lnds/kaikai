# Each binder is its own local however it is spelled: a name ending in a
# number, a name shadowed in one block, the same name in a lambda, a match
# arm and a handler clause, and names spelled like the locals the compiler
# makes for a handler's state and continuation.

effect Ask {
  ask() : Int
}

type Shape = Dot | Box(Int, Int)

fn spelled(x: Int, x_0: Int, x_1: Int) : Int = {
  let x_2 = x + x_0
  let x = x_2 * x_1
  let x = x + 1
  let x_3 = x
  x_3 + x_0
}

fn nested(x: Int) : Int = {
  let f = (x) => x * 2
  let y = match Box(x, f(x)) {
    Dot       -> 0
    Box(x, y) -> x + y
  }
  let x = y + x
  handle { Ask.ask() + x } with Ask { ask(resume) -> resume(x) }
}

fn implicit(state_i: Int, resume_i: Int) : Int = {
  var state := state_i
  let k = handle { Ask.ask() } with Ask {
    ask(resume) -> {
      let resume_i = resume_i + 1
      resume(resume_i)
    }
  }
  state := state + k
  let self = state
  self * 2
}

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(spelled(2, 3, 4)))
  Stdout.print(int_to_string(nested(5)))
  Stdout.print(int_to_string(implicit(10, 6)))
}
