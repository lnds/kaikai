# Tier 1 escape canary: a `Box[Beep]` reaching a `Box[Log]` parameter.
# The row-kind slot used to be bound as a generalised row variable, so
# every call site instantiated it fresh and any two rows unified — the
# unhandled `Beep` then surfaced at runtime. It is a compile error.
pub type Box[e] = Box(() -> Unit / e)

effect Log { say(s: String) : Unit }
effect Beep { bop() : Unit }

fn run_it(b: Box[Log]) : Unit / Log = match b { Box(f) -> f() }

fn main() : Int = {
  let b : Box[Beep] = Box(() => Beep.bop())
  handle { run_it(b) } with Log { say(s, resume) -> { print(s); resume(()) } }
  0
}
