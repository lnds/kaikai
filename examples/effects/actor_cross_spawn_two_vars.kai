import actor

fn take[t]() : t / Actor[t] = Actor.receive()

fn start[m, n](f: (m) -> Unit, g: (n) -> Unit) : Unit / Spawn + Actor[n] {
  let _ = spawn_actor(() => {
    let x: m = take()
    f(x)
    let y: n = take()
    g(y)
  })
}

fn main() : Int / Spawn = with_mailbox {
  start((a: Int) => (), (b: String) => ())
  0
}
