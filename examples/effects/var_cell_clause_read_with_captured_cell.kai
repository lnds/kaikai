# A handler-clause `var` is read from its clauses by id, so another cell
# elsewhere in the program — here one a closure captures, which keeps its
# own State handler — is no second instance the read could bind.

effect Stack {
  push(x: Int) : Unit
  pop()        : Int
}

fn run() : Int / Stack = {
  Stack.push(1)
  Stack.push(2)
  Stack.pop()
}

fn stacked() : Int =
  handle { run() } with Stack {
    var xs := []
    push(x, resume) -> {
      xs := [x, ...xs]
      resume(())
    }
    pop(resume) -> match xs {
      []           -> resume(-1)
      [y, ...rest] -> {
        xs := rest
        resume(y)
      }
    }
  }

fn main() : Int / Stdout = {
  var k := 1
  let f = (a) => a + k
  Stdout.print("r=#{f(stacked())}")
  0
}
