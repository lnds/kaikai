# `Child` is also a core type. The annotation reaches the effect this file
# declares, so every `Child` parameter is a capability and carries no RC.
type Point = { x: Int, y: Int }

effect Child {
  get() : Int
  put(tag: String, n: Int) : Unit
  rec(p: Point) : Int
}

fn send(e: Child) : Unit = e.put("via-cap", e.rec(Point { x: 1, y: 2 }))

fn add(c1: Child, c2: Child, dst: Child) : Unit =
  dst.put("sum", c1.get() + c2.get())

fn main() : Unit / Stdout = {
  handle {
    handle {
      handle {
        add(a, b, c)
        send(c)
      } with Child(0) as c {
        get(resume)         -> resume(state)
        put(tag, n, resume) -> { Stdout.print("#{tag}=#{n}") resume(()) }
        rec(p, resume)      -> resume(p.x + p.y)
      }
    } with Child(2) as b {
      get(resume)         -> resume(state)
      put(tag, n, resume) -> resume(())
      rec(p, resume)      -> resume(0)
    }
  } with Child(1) as a {
    get(resume)         -> resume(state)
    put(tag, n, resume) -> resume(())
    rec(p, resume)      -> resume(0)
  }
}
