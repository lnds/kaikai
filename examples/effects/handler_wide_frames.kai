# A handler whose clauses capture more locals than any fixed frame would hold,
# and an effect with more operations than a fixed evidence blob would hold.

effect Ask {
  ask() : Int
  tell(n: Int) : Int
}

effect Many {
  op0() : Int
  op1() : Int
  op2() : Int
  op3() : Int
  op4() : Int
  op5() : Int
  op6() : Int
  op7() : Int
  op8() : Int
  op9() : Int
  op10() : Int
  op11() : Int
  op12() : Int
  op13() : Int
  op14() : Int
  op15() : Int
  op16() : Int
  op17() : Int
}

fn captures() : Int {
  let v0 = 1
  let v1 = 2
  let v2 = 3
  let v3 = 4
  let v4 = 5
  let v5 = 6
  let v6 = 7
  let v7 = 8
  let v8 = 9
  let v9 = 10
  let v10 = 11
  let v11 = 12
  let v12 = 13
  let v13 = 14
  let v14 = 15
  let v15 = 16
  let v16 = 17
  let v17 = 18
  let v18 = 19
  let v19 = 20
  handle {
    Ask.tell(Ask.ask())
  } with Ask {
    ask(resume) -> resume(v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9)
    tell(n, resume) -> resume(n + v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19)
  }
}

fn many() : Int = handle {
  Many.op0() + Many.op1() + Many.op2() + Many.op3() + Many.op4() + Many.op5() + Many.op6() + Many.op7() + Many.op8() + Many.op9() + Many.op10() + Many.op11() + Many.op12() + Many.op13() + Many.op14() + Many.op15() + Many.op16() + Many.op17()
} with Many {
  op0(resume) -> resume(0)
  op1(resume) -> resume(1)
  op2(resume) -> resume(4)
  op3(resume) -> resume(9)
  op4(resume) -> resume(16)
  op5(resume) -> resume(25)
  op6(resume) -> resume(36)
  op7(resume) -> resume(49)
  op8(resume) -> resume(64)
  op9(resume) -> resume(81)
  op10(resume) -> resume(100)
  op11(resume) -> resume(121)
  op12(resume) -> resume(144)
  op13(resume) -> resume(169)
  op14(resume) -> resume(196)
  op15(resume) -> resume(225)
  op16(resume) -> resume(256)
  op17(resume) -> resume(289)
}

fn main() : Unit / Stdout {
  Stdout.print(int_to_string(captures()))
  Stdout.print(int_to_string(many()))
}
