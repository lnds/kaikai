# A subscribed signal that lands BEFORE Signal.await() must be held
# and consumed by the await, not dropped. The harness
# (tests/sigharness.c) signals the instant it sees "ready"; this
# fixture then burns compute before awaiting, so the signal arrives
# while no fiber is parked on the waiter slot. At KAI_THREADS>1 a
# reactor thread drains the self-pipe during that window — a runtime
# that discards the drained signo strands the await forever.

fn name_of(s: Sig) : String / Console = match s {
  SigInt  -> "SigInt"
  SigTerm -> "SigTerm"
  SigHup  -> "SigHup"
  SigUsr1 -> "SigUsr1"
  SigUsr2 -> "SigUsr2"
}

fn burn(i: Int, acc: Int) : Int =
  if i == 0 { acc } else { burn(i - 1, acc + i) }

fn main() : Int / Signal + Console = {
  Signal.on(SigTerm)
  Stdout.print("ready")
  let x = burn(20000000, 0)
  let s = Signal.await()
  Stdout.print("got " ++ name_of(s))
  Signal.off(SigTerm)
  if x > 0 { 0 } else { 1 }
}
