# A clause that does not resume leaves through match arms Perceus reuses
# in place. On a unique cell the arm moves the matched children into its
# binders while the match still holds the cell for the unwinder, and each
# operand computed first waits on the later ones: the abandon must release
# every one of them exactly once, on a unique cell and on a shared one.

effect Vet {
  vet(n: Int) : Int
}

type Tree = Leaf | Node(Tree, String, Tree)

fn mk(s: String) : String = string_concat(s, "!")

fn strs() : [String] = [mk("a"), mk("bb"), mk("ccc"), mk("dddd")]

fn grow(n: Int) : Tree = if n == 0 { Leaf } else { Node(grow(n - 1), mk("v"), grow(n - 1)) }

fn tagv(v: String, at: Int) : String / Vet = if Vet.vet(at) >= 0 { v ++ "?" } else { v }

fn tag(xs: [String], at: Int) : [String] / Vet = map_indexed(xs, (i, s) => tagv(s, i - at))

fn zips(xs: [String], ys: [String], at: Int) : [String] / Vet =
  zip_with(xs, ys, (a, b) => tagv(string_concat(a, b), string_length(a) - at))

fn mapt(t: Tree, at: Int) : Tree / Vet = match t {
  Leaf -> Leaf
  Node(l, v, r) -> Node(mapt(l, at + 1), tagv(v, at), mapt(r, at + 1))
}

fn rotate(t: Tree, at: Int) : Tree / Vet = match t {
  Node(Node(a, x, b), y, c) -> Node(a, tagv(x, at), Node(b, y, c))
  _ -> t
}

fn count(t: Tree) : Int = match t {
  Leaf -> 0
  Node(l, _, r) -> count(l) + 1 + count(r)
}

fn run(body: () -> Int / Vet) : Int = handle { body() } with Vet {
  vet(n, resume) -> if n > 0 { 0 - 1 } else { resume(n) }
}

fn spun(at: Int) : Int / Vet = {
  let t = rotate(grow(2), at)
  count(t)
}

fn main() : Unit / Stdout = {
  Stdout.print("map_indexed #{run(() => list_length(tag(strs(), 1)))} #{run(() => list_length(tag(strs(), 9)))}")
  let xs = strs()
  Stdout.print("map_indexed shared #{run(() => list_length(tag(xs, 1)))} #{list_length(xs)}")
  Stdout.print("zip_with #{run(() => list_length(zips(strs(), strs(), 2)))} #{run(() => list_length(zips(strs(), strs(), 9)))}")
  Stdout.print("variant #{run(() => count(mapt(grow(3), 0 - 1)))} #{run(() => count(mapt(grow(3), 0 - 9)))}")
  let t = grow(3)
  Stdout.print("variant shared #{run(() => count(mapt(t, 0 - 1)))} #{count(t)}")
  Stdout.print("rotation #{run(() => spun(1))} #{run(() => spun(0))}")
}
