# A binder spelled with a leading `_` that the arm reads holds a
# reference like any other, and so does the anonymous rest of a list
# pattern: a handler that abandons the arm releases both. The per-run
# growth of the reference ledger pins it.

effect Abort {
  fail(msg: String) : Int
}

fn risky(xs: [String]) : Int / Abort = match xs {
  [_first, ..._] -> {
    let n = Abort.fail("stop")
    n + string_length(_first)
  }
  _ -> 0
}

fn build(n: Int) : [String] =
  [string_concat("item-", int_to_string(n)), string_concat("tail-", int_to_string(n))]

fn run(n: Int) : Int = handle { risky(build(n)) } with Abort { fail(msg, resume) -> 0 - 1 }

fn main() : Unit / Stdout = Stdout.print(int_to_string(run(7) + run(8)))
