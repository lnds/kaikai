# A handler clause captures the instance its alias named where the clause
# was written: under two handles binding one alias name, under an alias
# spelled like a parameter, and for a `let` spelled like a binder of
# another block.

effect Cell {
  peek() : Int
}

effect Ask {
  ask() : Int
}

fn under(a: Int) : Int = {
  let got = handle {
    handle { Ask.ask() } with Ask { ask(resume) -> resume(a.peek() * 10) }
  } with Cell as a {
    peek(resume) -> resume(3)
  }
  got + a
}

fn pick(flag: Bool) : Int = {
  let low = if flag {
    let n = 3
    handle { Ask.ask() } with Ask { ask(resume) -> resume(n) }
  } else { 0 }
  let n = 40
  low + handle { Ask.ask() } with Ask { ask(resume) -> resume(n) }
}

fn main() : Unit / Stdout = {
  let r = handle {
    let inner = handle {
      handle { Ask.ask() + a.peek() } with Ask { ask(resume) -> resume(a.peek() * 10) }
    } with Cell as a {
      peek(resume) -> resume(1)
    }
    let outer = handle { Ask.ask() } with Ask { ask(resume) -> resume(a.peek() * 1000) }
    inner + outer
  } with Cell as a {
    peek(resume) -> resume(2)
  }
  Stdout.print(int_to_string(r))
  Stdout.print(int_to_string(under(4)))
  Stdout.print(int_to_string(pick(true)))
}
