effect Tool {
  a() : Int
  b() : Int
  default {
    a(resume) -> resume(1)
  }
}

effect X {
  x() : Int
  z() : Int
  default {
    x(resume) -> resume(0)
  }
}

fn main() : Int / Stdout {
  let r = handle {
    X.z() + Tool.a()
  } with X {
    z(resume) -> resume(3)
  }
  Stdout.print(int_to_string(r))
  0
}
