# A pid outlives its mailbox scope but still names the fiber behind it: a
# link placed after the helper's with_mailbox closed reports how the fiber
# itself ended, not the scope.

import actor
import spawn

type Note = Hello(Pid[Note])

fn helper(boss: Pid[Note]) : Unit / Spawn + Console + Cancel = {
  with_mailbox {
    Actor.send(boss, Hello(Actor.self()))
  }
  Spawn.yield()
  Stdout.print("helper: scope closed, fiber still running")
  Cancel.raise()
}

fn watch(p: Pid[Note]) : Unit / Link + Console = {
  with_mailbox {
    Link.link(p)
    Stdout.print("supervisor got: " ++ Actor.receive())
  }
}

fn main() : Int / Spawn + Cancel + Link + Console = {
  with_mailbox {
    spawn.set_trap_exit(true)
    let me = Actor.self()
    let _ = spawn.spawn(() => helper(me))
    match Actor.receive() {
      Hello(p) -> watch(p)
    }
    0
  }
}
