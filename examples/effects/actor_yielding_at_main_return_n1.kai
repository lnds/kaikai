# An actor busy in a loop that yields, never parked in `receive`, is
# cancelled at a yield when `main` returns; its cleanup runs and the program
# exits with 0.

import actor
import spawn

effect Lease {
  renew() : Unit
}

fn spin() : Unit / Spawn = {
  Spawn.yield()
  spin()
}

fn busy(boss: Pid[String]) : Unit / Actor[String] + Spawn + Stdout = handle {
  Actor.send(boss, "started")
  spin()
} with Lease {
  finally { Stdout.print("spinner released") }
  renew(resume) -> resume(())
}

fn run() : Unit / Actor[String] + Spawn + Stdout = {
  let boss = Actor.self()
  let _ = spawn_actor(() => busy(boss))
  let _ = Actor.receive()
}

fn main() : Int / Spawn + Stdout = {
  with_mailbox { run() }
  Stdout.print("main returning")
  0
}
