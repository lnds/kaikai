# The write side of `collision_value_corruption`: `remaining - 1` inside
# the `tick` clause, under a State[[Int]] runner, updates the var's own
# Int cell, never the runner's list.
effect Tick { tick() : Unit }

fn with_list[R, e](body: () -> R / e) : R / e = {
  handle { body() } with State[[Int]]([]) {
    get(resume) -> resume(state)
    set(v, resume) -> resume((), v)
    return(x) -> x
  }
}

fn main() : Unit / Stdout = {
  var remaining := 10
  with_list() {
    handle { Tick.tick() } with Tick {
      tick(resume) -> {
        remaining := remaining - 1
        resume(())
      }
    }
  }
  Stdout.print("remaining=#{int_to_string(remaining)}")
}
