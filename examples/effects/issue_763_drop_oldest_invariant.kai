# Bounded(2, DropOldest) sheds the OLDEST entry, and the survivors
# are the newest `cap` sends in send order.
#
# The overflow is forced by construction rather than by scheduler
# luck: the mailbox belongs to the fiber doing the sending, so no
# consumer can drain a slot concurrently and lower the queue below
# its bound. Six sends into two slots must leave exactly [msg5, msg6]
# whatever the thread count.

import actor

fn drain_two() : Unit / Actor[String] + Console = {
  Stdout.print("kept " ++ Actor.receive())
  Stdout.print("kept " ++ Actor.receive())
}

fn overflow_own_mailbox() : Unit / Actor[String] + Console = {
  let me = Actor.self()
  Actor.send(me, "msg1")
  Actor.send(me, "msg2")
  Actor.send(me, "msg3")
  Actor.send(me, "msg4")
  Actor.send(me, "msg5")
  Actor.send(me, "msg6")
  drain_two()
}

fn main() : Int / Console = {
  with_mailbox_policy(Bounded(2, DropOldest), () => overflow_own_mailbox())
  0
}
