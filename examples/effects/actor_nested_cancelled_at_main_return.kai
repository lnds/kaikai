# An actor spawned by another actor belongs to the program's root scope:
# when `main` returns both are cancelled and joined, and the inner actor's
# cleanup runs.

import actor

effect Lease {
  renew() : Unit
}

fn inner(boss: Pid[String]) : Unit / Actor[String] + Stdout = handle {
  Actor.send(boss, "inner ready")
  let _ = Actor.receive()
} with Lease {
  finally { Stdout.print("inner released") }
  renew(resume) -> resume(())
}

fn outer(boss: Pid[String]) : Unit / Actor[String] + Spawn + Stdout = {
  let _ = spawn_actor(() => inner(boss))
  let _ = Actor.receive()
}

fn run() : Unit / Actor[String] + Spawn + Stdout = {
  let boss = Actor.self()
  let _ = spawn_actor(() => outer(boss))
  Stdout.print(Actor.receive())
}

fn main() : Int / Spawn + Stdout = {
  with_mailbox { run() }
  Stdout.print("main returning")
  0
}
