import other

# `state` in a stateful handler's clause is the handler's slot: a private
# function of another module is not a binding the clause can reach.
effect Tally { add(n: Int) : Unit }

fn main() : Unit / Stdout = {
  let total = handle {
    Tally.add(2)
    Tally.add(3)
    other.bump(0)
  } with Tally(0) {
    add(n, resume) -> resume((), state + n)
    return(x) -> state + x
  }
  Stdout.print("#{total}")
}
