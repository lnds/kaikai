# The three thunk shapes the spawn-capture check must keep accepting.
# It rejects a CAPTURED mutation carrier; each of these either builds
# its carrier inside the child or captures no carrier at all, so
# tightening the check until one of them fails is a regression.

import spawn

fn touch(a: Array[Int]) : Int / Mutable = {
  let _ = array_set(a, 0, 7)
  array_get(a, 0)
}

fn compute(x: Int) : Int = x * 2

fn main() : Int / Spawn + Stdout + Mutable = {
  let r = Mutable.ref_make(21)
  # Read before the spawn: the thunk captures the Int, not the cell.
  let snapshot = Mutable.ref_get(r)
  nursery { n ->
    # Built inside the thunk: the child owns it, nothing is shared.
    let f1 = n.spawn(() => { let a = array_make(3, 0)  touch(a) })
    let f2 = n.spawn(() => compute(snapshot))
    let f3 = n.spawn(() => 5)
    Stdout.print("local=#{n.await(f1)} snapshot=#{n.await(f2)} none=#{n.await(f3)}")
  }
  0
}
