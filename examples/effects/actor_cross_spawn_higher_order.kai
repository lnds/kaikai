import actor
import spawn

type Resp = Answer(Int)

fn fork[e](f: () -> Unit / e) : Unit / Spawn + e {
  nursery { n ->
    let h = n.spawn(f)
    n.await(h)
  }
}

fn main() : Unit / Spawn + Stdout = with_mailbox {
  let yo = Actor.self()
  fork(() => Actor.send(yo, Answer(7)))
  match Actor.receive() {
    Answer(x) -> Stdout.print("recibí #{x}")
  }
}
