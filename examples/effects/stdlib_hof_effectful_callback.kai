# Collection HOFs beyond the map/filter/fold/each quartet carry an open
# effect row, so a callback that performs an effect type-checks in
# `find`/`any`/`count`/`take_while`/`partition` the same as in `filter`.

import core.list
import core.option
import core.tuple
import collections.map

effect Audit {
  note(s: String) : Unit
}

fn traced_gt(x: Int, bound: Int) : Bool / Audit = {
  Audit.note("check #{x}")
  x > bound
}

fn main() : Int / Stdout = {
  let xs = [1, 2, 3, 4, 5]

  let seen = handle {
    let found = list.find(xs, (x) => traced_gt(x, 3))
    let hits  = list.count(xs, (x) => traced_gt(x, 2))
    let some  = list.any(xs, (x) => traced_gt(x, 4))
    let every = list.all(xs, (x) => traced_gt(x, 0))
    let pre   = list.take_while(xs, (x) => traced_gt(2, x))
    let parts = list.partition(xs, (x) => traced_gt(x, 2))
    let best  = list.max_by(xs, (x) => { Audit.note("key #{x}"); x })
    let idx   = list.index_of(xs, (x) => traced_gt(x, 1))
    let opt   = option.map(Some(7), (x) => { Audit.note("opt #{x}"); x + 1 })
    let pair  = tuple.map_fst(Pair { fst: 1, snd: 2 }, (x) => { Audit.note("fst"); x + 1 })
    let m     = map.update(map.put(map.empty(), "k", 1), "k", 0,
                           (v) => { Audit.note("upd"); v + 1 })

    Stdout.print("find=#{option.unwrap_or(found, 0)} count=#{hits} any=#{some} all=#{every}")
    Stdout.print("take_while=#{list.length(pre)} partition=#{list.length(parts.fst)}")
    Stdout.print("max_by=#{option.unwrap_or(best, 0)} index_of=#{option.unwrap_or(idx, 0)}")
    Stdout.print("opt=#{option.unwrap_or(opt, 0)} fst=#{pair.fst} upd=#{option.unwrap_or(map.get(m, "k"), 0)}")
    0
  } with Audit {
    note(s, resume) -> resume(())
    return(x)       -> x
  }

  seen
}
