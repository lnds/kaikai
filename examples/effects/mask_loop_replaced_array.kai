import loop

fn sub_one(a: Array[Int], b: Array[Int]) : Array[Int] = {
  let out = array_make(1, 0)
  out[0] := a[0] - b[0]
  out
}

fn drain(num: Array[Int], den: Array[Int]) : Int {
  var rem := array_make(1, num[0])
  var n := 0
  while { rem[0] >= den[0] } {
    rem := sub_one(rem, den)
    n := n + 1
  }
  n
}

fn main() : Unit / Console = {
  let num = array_make(1, 7)
  let den = array_make(1, 2)
  print(int_to_string(drain(num, den)))
}
