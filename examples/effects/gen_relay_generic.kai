import gen

fn repeat(x: a, n: Int) : Unit / Yield[a] =
  if n == 0 { () } else {
    Yield.yield(x)
    repeat(x, n - 1)
  }

fn relay(g: Gen[a, e]) : Unit / Yield[a] + e = match g {
  Done       -> ()
  Next(p, k) -> {
    Yield.yield(p)
    relay(k(()))
  }
}

fn outer[e](x: a) : Gen[a, e] / e = gen.generate(() => relay(gen.generate(() => repeat(x, 3))))

fn main() : Unit / Stdout =
  gen.each_indexed(outer(7), (_i, p) => Stdout.print("#{p}"))
