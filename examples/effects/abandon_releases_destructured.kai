# Names a pattern binds hold a reference of their own: a destructuring
# `let` and a record arm release theirs when a clause abandons the body,
# and so does a closure called through a local or a computed callee.

effect Vet {
  vet(n: Int) : Int
}

fn mk(s: String) : String = string_concat(s, "!")

fn pair(s: String) : (String, String) = (mk(s), mk(s))

fn keep3(a: String, b: Int, c: String) : Int = string_length(a) + b + string_length(c)

fn adder() : (String, Int) -> Int = (a, b) => string_length(a) + b

fn destructured(i: Int) : Int / Vet = {
  let (a, b) = pair("x")
  let n = Vet.vet(i)
  string_length(a) + string_length(b) + n
}

fn record_arm(i: Int) : Int / Vet = match pair("y") {
  (a, b) -> string_length(a) + Vet.vet(i) + string_length(b)
}

fn read_twice(i: Int) : Int / Vet = {
  let a = mk("z")
  keep3(a, Vet.vet(i), a)
}

fn through_local(i: Int) : Int / Vet = {
  let f = adder()
  f(mk("w"), Vet.vet(i))
}

fn computed_callee(i: Int) : Int / Vet = adder()(mk("v"), Vet.vet(i))

fn run(body: () -> Int / Vet) : Int = handle { body() } with Vet {
  vet(n, resume) -> if n < 0 { 0 - 1 } else { resume(n) }
}

fn main() : Unit / Stdout = {
  Stdout.print("destructured #{run(() => destructured(0 - 1))} #{run(() => destructured(1))}")
  Stdout.print("record_arm #{run(() => record_arm(0 - 1))} #{run(() => record_arm(1))}")
  Stdout.print("read_twice #{run(() => read_twice(0 - 1))} #{run(() => read_twice(1))}")
  Stdout.print("through_local #{run(() => through_local(0 - 1))} #{run(() => through_local(1))}")
  Stdout.print("computed_callee #{run(() => computed_callee(0 - 1))} #{run(() => computed_callee(1))}")
}
