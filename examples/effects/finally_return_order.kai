# The scope exit runs before the result is transformed: on a normal exit
# `finally` runs, then `return`; on an abandon `finally` runs during the
# unwind and `return` does not run at all.

effect Ask { number() : Int }

fn main() : Unit / Stdout = {
  let c = handle { let n = Ask.number(); Stdout.print("body n=#{n}"); n } with Ask {
    finally        { Stdout.print("finally") }
    number(resume) -> resume(1)
    return(x)      -> { Stdout.print("return x=#{x}"); x + 1 }
  }
  Stdout.print("c=#{c}")
  let d = handle { let n = Ask.number(); Stdout.print("unreached"); n } with Ask {
    finally        { Stdout.print("finally on abandon") }
    number(resume) -> 7
    return(x)      -> { Stdout.print("unreached return"); x + 1 }
  }
  Stdout.print("d=#{d}")
}
