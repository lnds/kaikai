effect Audit {
  record(msg: String) : Unit
  default {
    record(msg, resume) -> {
      Stdout.print("audit #{msg}")
      resume(())
    }
  }
}

effect Shout {
  shout(msg: String) : Unit
  default {
    shout(msg, resume) -> {
      Audit.record(msg)
      resume(())
    }
  }
}

fn main() : Int / Stdout {
  Shout.shout("hello")
  0
}
