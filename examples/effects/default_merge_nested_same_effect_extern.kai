effect Say {
  say(msg: String) : Unit
  other() : Unit
  default {
    say(msg, resume) -> $extern_handler("kai_default_stdout_print")
    other(resume) -> resume(())
  }
}

fn main() : Unit / Stdout {
  handle {
    handle {
      Say.say("inner default runs")
    } with Say {
      other(resume) -> resume(())
    }
  } with Say {
    say(msg, resume) -> {
      println("outer user clause: #{msg}")
      resume(())
    }
    other(resume) -> resume(())
  }
}
