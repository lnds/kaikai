effect Ask {
  ask(n: Int) : Int
  note(s: String) : Unit
  default {
    ask(n, resume) -> resume(n + 100)
    note(s, resume) -> {
      Stdout.print("default note #{s}")
      resume(())
    }
  }
}

fn inner() : Int / Ask {
  Ask.note("x")
  Ask.ask(1)
}

fn main() : Int / Stdout {
  let r = handle {
    handle {
      inner()
    } with Ask {
      note(s, resume) -> {
        let v = Ask.ask(5)
        Stdout.print("escaped #{int_to_string(v)}")
        resume(())
      }
    }
  } with Ask {
    ask(n, resume) -> resume(n * 1000)
    note(s, resume) -> resume(())
  }
  Stdout.print("r=#{int_to_string(r)}")
  0
}
