# A cancelled fiber still releases the closure it was spawned with,
# and with it everything the closure captured.

import spawn
import time

fn spin(i: Int) : Int / Cancel + Clock =
  if i > 200 { i } else { Clock.sleep_ns(1000000); spin(i + 1) }

fn main() : Int / Stdout + Spawn + Clock = {
  let tag = "fiber-#{7}"
  let loud = string_concat(tag, "!")
  nursery { n ->
    let a = n.spawn(() => spin(0) + string_length(tag))
    let b = n.spawn(() => spin(0) + string_length(loud))
    Clock.sleep_ns(5000000)
    n.cancel(a)
    n.cancel(b)
  }
  Stdout.print("cancelled #{tag}")
  0
}
