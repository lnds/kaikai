# A linked peer that cancels cancels a main parked in `await`.

import actor
import spawn
import time

fn child(parent: Pid[String]) : Unit / Actor[String] + Link + Cancel = {
  Link.link(parent)
  Cancel.raise()
}

fn slow() : Int / Clock + Stdout = {
  sleep(millis(100))
  Stdout.print("worker done")
  7
}

fn wait_for_peer() : Unit / Actor[String] + Spawn + Console + Link + Cancel + Clock = {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { child(me) })
  nursery { n ->
    let w = n.spawn(slow)
    Stdout.print("awaited " ++ show(n.await(w)))
  }
}

fn main() : Int / Spawn + Console + Link + Cancel + Clock = {
  with_mailbox {
    handle {
      wait_for_peer()
    } with Cancel {
      raise(resume) -> Stdout.print("main cancelled")
    }
  }
  0
}
