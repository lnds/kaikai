# A spawned actor that only sends never reads its own mailbox, so its
# message type is never fixed, annotated or not, and its sends type.

import actor

fn count_to(sink: Pid[Int], n: Int) : Unit / Actor[Unit] =
  if n > 0 {
    count_to(sink, n - 1)
    Actor.send(sink, n)
  } else { () }

fn main() : Unit / Spawn + Stdout = with_mailbox {
  let me = Actor.self()
  let _ = spawn_actor(() => count_to(me, 3))
  let a = Actor.receive()
  let b = Actor.receive()
  let c = Actor.receive()
  let _ = spawn_actor(() => Actor.send(me, 10))
  let d = Actor.receive()
  Stdout.print("#{a + b + c + d}")
}
