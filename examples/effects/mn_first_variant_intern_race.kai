# M:N interned variants — a variant whose payload is all immortal atoms is
# one shared cell, installed by whichever thread constructs it first.
#
# Nothing on the main fiber builds any `Pair` before the workers start, so
# every scheduler thread reaches the first construction of each combination
# at once and must agree on a single cell per key.

import spawn

type Color = Red | Green | Blue
type Pair = Pair(Color, Color)
type Wrap = Wrap(Pair)

fn color(i: Int) : Color = match i % 3 {
  0 -> Red
  1 -> Green
  _ -> Blue
}

fn weight(c: Color) : Int = match c {
  Red   -> 1
  Green -> 10
  Blue  -> 100
}

fn pair_weight(p: Pair) : Int = match p {
  Pair(a, b) -> weight(a) * 3 + weight(b)
}

fn wrap_weight(w: Wrap) : Int = match w {
  Wrap(p) -> pair_weight(p) + 1
}

fn build(i: Int, acc: Int) : Int =
  if i >= 300 { acc }
  else {
    let p = Pair(color(i), color(i / 3))
    build(i + 1, acc + wrap_weight(Wrap(p)))
  }

fn main() : Unit / Spawn + Stdout {
  let sums = nursery { n ->
    let fibers = [1, 2, 3, 4, 5, 6, 7, 8] | (i => n.spawn(() => build(i - i, 0)))
    fibers | (f => n.await(f))
  }
  Stdout.print(show(sums))
}
