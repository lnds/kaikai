# A thunk handed to `spawn` through a parameter stays legal while its row
# has no `Mutable`: it captures nothing the child could mutate as a copy.

import spawn

fn run_in_fiber(k: () -> Int) : Int / Spawn =
  nursery { n ->
    let f = n.spawn(k)
    n.await(f)
  }

fn main() : Int / Spawn + Stdout = {
  let base = 20
  Stdout.print("via param=#{run_in_fiber(() => base + 1)}")
  0
}
