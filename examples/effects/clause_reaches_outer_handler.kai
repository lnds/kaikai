effect Em { em(v: Int) : Unit }

fn src() : Unit / Em = { Em.em(1); Em.em(2) }

fn plus1(body: () -> Unit / Em) : () -> Unit / Em =
  () => handle { body() } with Em {
    em(x, resume) -> { Em.em(x + 1); resume(()) }
  }

fn first_only(body: () -> Unit / Em) : () -> Unit / Em =
  () => handle { body() } with Em {
    em(x, _resume) -> Em.em(x * 100)
  }

fn wrapped(body: () -> Unit / Em) : () -> Unit / Em =
  () => handle { body() } with Em {
    em(x, resume) -> {
      handle { Em.em(x) } with Em {
        em(y, r) -> { Em.em(y + 1000); r(()) }
      }
      resume(())
    }
  }

fn show_all(label: String, body: () -> Unit / Em) : Unit / Stdout = {
  Stdout.print(label)
  handle { body() } with Em {
    em(x, resume) -> { Stdout.print("got #{x}"); resume(()) }
  }
}

fn main() : Unit / Stdout = {
  show_all("two stages", plus1(plus1(src)))
  show_all("three stages", plus1(plus1(plus1(src))))
  show_all("abort in the middle", plus1(first_only(plus1(src))))
  show_all("handler inside a clause", wrapped(src))
  show_all("stacked with a nested handle", plus1(wrapped(plus1(src))))
}
