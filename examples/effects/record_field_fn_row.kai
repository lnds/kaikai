# A record field of function type keeps its declared effect row: an
# effectful closure can be stored, and calling it raises that row.

type Hook = { run: (Int) -> Unit / Stdout }

type Counter = { bump: (Array[Int]) -> Unit / Mutable }

fn fire(h: Hook) : Unit / Stdout = h.run(1)

fn main() : Unit / Stdout + Mutable = {
  fire(Hook { run: (n) => Stdout.print("n=#{n}") })
  let c = Counter { bump: (xs) => { xs[0] := xs[0] + 1 } }
  let a = array_make(1, 41)
  c.bump(a)
  Stdout.print(int_to_string(a[0]))
}
