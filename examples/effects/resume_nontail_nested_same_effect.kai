# The tail of a non-tail `resume` runs outside its handle, so performing
# the same effect there reaches the next handler out, not this one.

effect Ask { number() : Int }

fn main() : Unit / Stdout = {
  let c = handle {
    handle { Ask.number() + 1 } with Ask {
      number(resume) -> {
        let r = resume(10)
        r + Ask.number()
      }
    }
  } with Ask { number(resume) -> resume(1000) }
  Stdout.print("c=#{c}")
}
