effect Base {
  base() : Int
  default {
    base(resume) -> resume(40)
  }
}

fn find(n: Int) : Option[Int] = if n > 0 { Some(n) } else { None }

fn run(k: Int) : Option[Int] {
  let first = find(k)!
  let r = handle {
    let x = find(Base.base() - k)!
    x + first
  } with Base {
    base(resume) -> resume(40)
  }
  Some(r)
}

fn show(o: Option[Int]) : String = match o {
  Some(n) -> "some #{int_to_string(n)}"
  None -> "none"
}

fn main() : Int / Stdout {
  Stdout.print(show(run(1)))
  Stdout.print(show(run(0)))
  0
}
