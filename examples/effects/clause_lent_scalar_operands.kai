# A handler clause reads its op arguments and its state straight into raw
# arithmetic, comparisons and negation, and boxes only what escapes. An Int
# past the immediate range and a Real are heap cells, so every read of one
# must leave its box to the clause's own release.

effect Acc {
  add(x: Int) : Unit
  above(x: Int) : Bool
  flip(x: Int) : Int
  label(x: Int) : String
  pair(x: Int) : [Int]
  shadow(x: Int) : Int
}

effect Gauge {
  scale(r: Real) : Real
}

fn drive(i: Int, n: Int, acc: Int) : Int / Acc =
  if i == n { acc }
  else {
    let big = 9000000000000000000 + i
    Acc.add(big)
    let hit = if Acc.above(big) { 1 } else { 0 }
    let xs = Acc.pair(big)
    drive(i + 1, n, (acc + hit + Acc.flip(big) % 1000 + xs.length() + Acc.shadow(big)) % 1000000007)
  }

fn measure(i: Int, n: Int, acc: Real) : Real / Gauge =
  if i == n { acc } else { measure(i + 1, n, acc + Gauge.scale(1.5)) }

# `state` here is the enclosing parameter, not the handler state, which
# the clauses reach as `log`.
fn with_outer_state(state: Int) : Int =
  handle { drive(0, 10, 0) } with Acc(3) {
    add(x, resume)    -> resume((), (log + x - state) % 1000000007)
    above(x, resume)  -> resume(x - state > log)
    flip(x, resume)   -> resume(x - state)
    label(x, resume)  -> resume("#{x}")
    pair(x, resume)   -> resume([x - state])
    shadow(x, resume) -> resume(x % 10)
    return(v)         -> v + log
  }

fn main() : Int / Stdout = {
  let r = handle { drive(0, 50, 0) } with Acc(1) {
    add(x, resume)    -> resume((), (state * 31 + x) % 1000000007)
    above(x, resume)  -> resume(x > state)
    flip(x, resume)   -> resume(-x + state)
    label(x, resume)  -> resume("#{x}/#{x % 7}")
    pair(x, resume)   -> resume([x, x + 1])
    shadow(x, resume) -> {
      let x = int_to_string(x % 100)
      resume(x.length())
    }
    return(v)         -> (v + state) % 1000000007
  }
  let tagged = handle { Acc.label(9000000000000000123) } with Acc(0) {
    add(x, resume)    -> resume((), x)
    above(x, resume)  -> resume(x < 0)
    flip(x, resume)   -> resume(x)
    label(x, resume)  -> resume("#{x}/#{x % 7}")
    pair(x, resume)   -> resume([x])
    shadow(x, resume) -> resume(x)
  }
  let g = handle { measure(0, 20, 0.0) } with Gauge(0.25) {
    scale(r, resume) -> resume(r * state, state + r / 4.0)
    return(v)        -> v + state
  }
  let outer = with_outer_state(7000000000000000000)
  Stdout.print("r=#{r} tagged=#{tagged} outer=#{outer} g=#{g}")
  0
}
