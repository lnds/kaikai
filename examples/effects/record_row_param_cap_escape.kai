# A capability bound by `as` cannot escape its `handle` inside a record
# field's closure.

effect Cell { get() : Int }

type Probe[e] = { read: () -> Int / e }

fn leak() : Probe[Cell] = {
  handle {
    Probe { read: () => a.get() }
  } with Cell as a { get(resume) -> resume(1) }
}

fn main() : Int = 0
