# An alias spelled like an enclosing `let` shadows it inside the handle
# and leaves it untouched outside: a raw Int and a boxed String each keep
# their own value.

effect Cell {
  get() : Int
}

fn main() : Unit / Stdout = {
  let a = 7
  let s = "seven"
  let got = handle { a.get() } with Cell as a { get(resume) -> resume(2) }
  let len = handle { s.get() } with Cell as s { get(resume) -> resume(5) }
  Stdout.print(int_to_string(got + a * 10))
  Stdout.print("#{s} #{len}")
}
