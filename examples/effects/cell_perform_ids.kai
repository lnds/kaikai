# Every cell perform names the core `State`/`Reader` it handles: a cell
# nested in another's scope, one declared over handler clauses, and a
# Reader read naked inside a lambda.

effect Stack {
  push(x: Int) : Unit
  pop()        : Int
}

fn nested() : Int = {
  var a := 1
  let inner = {
    var b := 10
    b := b + a
    b
  }
  a := a + inner
  a
}

fn run() : Int / Stack = {
  Stack.push(4)
  Stack.push(5)
  Stack.pop()
}

fn stacked() : Int =
  handle { run() } with Stack {
    var xs := []
    push(x, resume) -> {
      xs := [x, ...xs]
      resume(())
    }
    pop(resume) -> match xs {
      []           -> resume(0)
      [y, ...rest] -> {
        xs := rest
        resume(y)
      }
    }
  }

fn reads() : Int = handle {
  let f = () => env + 1
  f() + env
} with Reader[Int](42) as env {
  ask(resume) -> resume(state)
  return(x)   -> x
}

fn main() = {
  print(int_to_string(nested()))
  print(int_to_string(stacked()))
  print(int_to_string(reads()))
}
