# An alias spelled like a parameter is in scope for its handle only: after
# the handle the name is the parameter again, with the parameter's value.

effect Cell {
  get() : Int
}

fn scale(a: Int) : Int = {
  let got = handle { a.get() } with Cell as a { get(resume) -> resume(2) }
  got + a * 10
}

fn main() : Unit / Stdout = Stdout.print(int_to_string(scale(4)))
