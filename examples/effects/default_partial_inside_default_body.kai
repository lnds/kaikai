effect Tool {
  a() : Int
  b() : Int
  default {
    a(resume) -> resume(1)
  }
}

effect X {
  x() : Int
  z() : Int
  default {
    x(resume) -> resume(0)
  }
}

effect Y {
  y() : Int
  default {
    y(resume) -> {
      let r = handle {
        X.z() + Tool.a()
      } with X {
        z(resume) -> resume(3)
      }
      resume(r)
    }
  }
}

fn main() : Int / Stdout {
  Stdout.print(int_to_string(Y.y()))
  0
}
