# An observable Array write reached through `|>` still requires
# `Mutable` in the caller's row.

fn set_first(xs: Array[Int], v: Int) : Unit / Mutable = { xs[0] := v }

fn poke(a: Array[Int]) : Unit = a |> set_first(7)

fn main() : Unit / Mutable + Stdout = {
  let a = array_make(3, 0)
  poke(a)
  Stdout.print(int_to_string(a[0]))
}
