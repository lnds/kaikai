# A core Array[Byte] writer mutates only its first argument. Filling a
# locally built array from a parameter, or from a parameter's field, is not
# observable to the caller, so these codecs declare no `Mutable`.

type Buf = { bytes: Array[Byte], len: Int }

fn concat(a: Array[Byte], b: Array[Byte]) : Array[Byte] = {
  let la  = array_length(a)
  let dst = array_make(la + array_length(b), 0u8)
  let _   = bytes_blit(dst, 0, a, 0, la)
  bytes_blit(dst, la, b, 0, array_length(b))
}

fn buf_bytes(b: Buf) : Array[Byte] = {
  let out = array_make(b.len, 0u8)
  bytes_blit(out, 0, b.bytes, 0, b.len)
}

fn encode(n: Int, s: String) : Array[Byte] = {
  let buf = array_make(8 + string_length(s), 0u8)
  let _   = bytes_put_le(buf, 0, n, 8)
  bytes_put_string(buf, 8, s)
}

fn dump_loop(bs: Array[Byte], i: Int, acc: String) : String =
  if i >= array_length(bs) { acc }
  else { dump_loop(bs, i + 1, "#{acc}#{byte_to_int(bs[i])},") }

fn main() : Unit / Console = {
  let both = concat(encode(-2, "ab"), encode(300, ""))
  print(dump_loop(both, 0, ""))
  print(dump_loop(buf_bytes(Buf { bytes: encode(7, "z"), len: 3 }), 0, ""))
}
