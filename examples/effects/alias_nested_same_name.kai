# Two nested handles bind the same alias name. After the inner one ends,
# the name is the outer instance again.

effect Cell {
  get() : Int
}

fn main() : Unit / Stdout = {
  let r = handle {
    let inner = handle { a.get() } with Cell as a { get(resume) -> resume(1) }
    inner + a.get() * 10
  } with Cell as a {
    get(resume) -> resume(2)
  }
  Stdout.print(int_to_string(r))
}
