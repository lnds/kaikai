effect St[s] {
  get() : s
  put(v: s) : Unit
  default {
    put(v, resume) -> {
      Stdout.print("put")
      resume(())
    }
  }
}

effect Y {
  y() : Int
  default {
    y(resume) -> {
      St.put(5)
      resume(1)
    }
  }
}

fn main() : Int / Stdout {
  Stdout.print(int_to_string(Y.y()))
  0
}
