# Senders on other threads race the close of the mailbox they target: each
# send lands before the close or is dropped, and every sender runs to the
# end. The output is the same at any KAI_THREADS.

import actor

type Msg = | Ping | Done

fn chatter(target: Pid[Msg], supervisor: Pid[Msg], n: Int) : Unit / Actor[Msg] =
  if n <= 0 { Actor.send(supervisor, Done) }
  else { Actor.send(target, Ping); chatter(target, supervisor, n - 1) }

fn spawn_n(target: Pid[Msg], supervisor: Pid[Msg], n: Int) : Unit / Spawn =
  if n <= 0 { () }
  else {
    let _ = spawn_actor(() => chatter(target, supervisor, 200))
    spawn_n(target, supervisor, n - 1)
  }

fn await_done(n: Int) : Unit / Actor[Msg] =
  if n <= 0 { () } else { let _ = Actor.receive(); await_done(n - 1) }

fn main() : Unit / Spawn + Stdout = {
  with_mailbox {
    let supervisor = Actor.self()
    with_mailbox { spawn_n(Actor.self(), supervisor, 16) }
    await_done(16)
  }
  Stdout.print("16 senders finished after the mailbox they targeted closed")
}
