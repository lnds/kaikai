effect Ask {
  ask() : Int
}

fn body() : Int / Ask = Ask.ask() + 1

fn main() : Int / Stdout {
  let r = handle {
    body()
  } with Ask {
    ask(resume) -> {
      let a = resume(10)
      let resume = (x: Int) => x * 100
      a + resume(2)
    }
    return(x) -> x
  }
  Stdout.print("r=#{int_to_string(r)}")
  0
}
