effect Tick {
  tick() : Int
}

effect Tock {
  tock() : Int
}

fn both() : Int =
  handle {
    handle {
      Tick.tick() + Tock.tock()
    } with Tock {
      tock(resume) -> resume(20)
    }
  } with Tick {
    tick(resume) -> resume(1)
  }

fn main() : Int / Stdout {
  print("#{both()}")
  0
}
