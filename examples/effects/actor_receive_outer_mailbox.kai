# Two nested mailboxes give one row two `Actor` instances. A receive typed
# `Reply` reads the outer `Reply` mailbox even though the `Request` one is
# installed inside it: an op reaches the handler of the instance it was
# typed at, not the innermost `Actor`.

import actor

type Request = Query(Int)
type Reply   = Answer(Int)

fn recv_req() : Request / Actor[Request] = Actor.receive()

fn recv_reply() : Reply / Actor[Reply] = Actor.receive()

fn both() : String / Actor[Request] + Actor[Reply] = {
  let a = match recv_reply() { Answer(n) -> n }
  let q = match recv_req() { Query(n) -> n }
  let b: Reply = Actor.receive()
  let c = match b { Answer(n) -> n }
  "reply=#{a} request=#{q} direct=#{c}"
}

fn main() : Unit / Stdout = with_mailbox {
  let me: Pid[Reply] = Actor.self()
  Actor.send(me, Answer(1))
  Actor.send(me, Answer(3))
  let s = with_mailbox {
    let srv: Pid[Request] = Actor.self()
    Actor.send(srv, Query(2))
    both()
  }
  Stdout.print(s)
}
