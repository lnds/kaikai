import actor
import spawn

type Resp = Answer(Int)

fn esperar() : Int / Actor[Resp] = match Actor.receive() {
  Answer(x) -> x
}

fn main() : Unit / Spawn + Stdout = with_mailbox {
  nursery { n ->
    let f = n.spawn(
      () => with_mailbox {
        let yo = Actor.self()
        Actor.send(yo, Answer(41))
        esperar() + 1
      }
    )
    Stdout.print("got #{n.await(f)}")
  }
}
