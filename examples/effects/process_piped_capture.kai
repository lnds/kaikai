# Issue #1591 — capture a child's stdout through a pipe.
# `pipe_from` attaches a pipe to the child's stdout only; `read_all`
# drains it to EOF; `wait` reaps. The parent prints nothing before
# the fork (see process_basic.kai on the fork/stdio-buffer trap).
import os.process

fn main() : Int / Process + Stdout =
  match process.pipe_from("/bin/echo", ["hello", "pipes"]) {
    Err(e) -> { Stdout.print(string_concat("start FAIL: ", e)); 1 }
    Ok(c)  -> match process.read_all(c) {
      Err(e)  -> { Stdout.print(string_concat("read FAIL: ", e)); 1 }
      Ok(out) -> match process.wait(c) {
        Err(e)        -> { Stdout.print(string_concat("wait FAIL: ", e)); 1 }
        Ok(Exited(0)) ->
          if out == "hello pipes\n" { Stdout.print("capture ok"); 0 }
          else { Stdout.print(string_concat("capture MISMATCH: ", out)); 1 }
        Ok(_)         -> { Stdout.print("wait FAIL: abnormal exit"); 1 }
      }
    }
  }
