# A fiber parked in `Actor.send` on a full Bounded(_, BlockSender) mailbox
# is woken by a cancel: no receiver may ever free the slot. It unwinds
# through its handlers before the receiver ends.

import actor
import spawn
import time

effect Lease {
  renew() : Unit
}

fn idle() : Unit / Actor[String] + Clock + Stdout = {
  sleep(millis(300))
  Stdout.print("receiver ended")
}

fn flood(target: Pid[String]) : Int / Actor[String] + Stdout = handle {
  Actor.send(target, "one")
  Actor.send(target, "two")
  Stdout.print("sender not parked")
  7
} with Lease {
  finally { Stdout.print("sender released") }
  renew(resume) -> resume(())
}

fn main() : Int / Spawn + Stdout + Clock = {
  let recv = spawn_actor_policy(Bounded(1, BlockSender), () => idle())
  nursery { n ->
    let w = n.spawn(() => with_mailbox { flood(recv) })
    sleep(millis(50))
    Stdout.print("cancelling")
    n.cancel(w)
  }
  sleep(millis(400))
  0
}
