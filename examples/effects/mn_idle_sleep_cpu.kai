# A program that only sleeps leaves every M:N worker idle: they must block,
# not poll. tools/run-mn-idle-cpu.sh bounds the CPU time this run burns.

import spawn
import time

fn nap(ms: Int) : Int / Clock = {
  sleep(millis(ms))
  ms
}

fn main() : Unit / Spawn + Clock + Stdout = {
  let naps = nursery { n ->
    let fibers = [200, 400, 600] | (ms => n.spawn(() => nap(ms)))
    fibers | (f => n.await(f))
  }
  sleep(millis(400))
  Stdout.print("napped #{naps.length()} fibers")
}
