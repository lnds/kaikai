type Point = { x: Int, y: Int }
type Shape = Tag(String) | Empty

effect Sink {
  rec(p: Point) : Int
  var_(v: Shape) : Int
  list(xs: [Int]) : Int
}

fn feed(s: Sink) : Int =
  s.rec(Point { x: 1, y: 2 }) + s.var_(Tag("dozen")) + s.list([4, 5])

fn main() : Unit / Stdout = {
  let n = handle { feed(s) } with Sink as s {
    rec(p, resume)   -> resume(p.x + p.y)
    var_(v, resume)  -> resume(match v { Tag(t) -> string_length(t) * 2 Empty -> 0 })
    list(xs, resume) -> resume(match xs { [a, b] -> a + b _ -> 0 })
  }
  Stdout.print("n=#{n}")
}
