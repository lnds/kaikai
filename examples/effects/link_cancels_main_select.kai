# A linked peer that cancels cancels a main parked in `select`.

import actor
import spawn
import time

fn child(parent: Pid[String]) : Unit / Actor[String] + Link + Cancel = {
  Link.link(parent)
  Cancel.raise()
}

fn slow() : Int / Clock + Cancel = {
  sleep(seconds(60))
  1
}

fn wait_for_peer() : Unit / Actor[String] + Spawn + Console + Link + Cancel + Clock = {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { child(me) })
  let winner = nursery { n ->
    let a = n.spawn(slow)
    let b = n.spawn(slow)
    n.select([a, b])
  }
  Stdout.print("selected " ++ show(winner))
}

fn main() : Int / Spawn + Console + Link + Cancel + Clock = {
  with_mailbox {
    handle {
      wait_for_peer()
    } with Cancel {
      raise(resume) -> Stdout.print("main cancelled")
    }
  }
  0
}
