# Monitoring an actor that has already ended reports it at once. The
# nursery joins the worker before the supervisor sees its pid, so the
# monitor lands on a fiber that is gone and a mailbox never closed.

import actor
import spawn

fn worker() : Unit / Actor[Nothing] + Cancel = {
  Cancel.raise()
}

fn main() : Int / Spawn + Cancel + Monitor + Console = {
  var joined := None
  handle {
    nursery { joined := Some(spawn_actor(worker)) }
  } with Cancel {
    raise(resume) -> ()
  }
  match joined {
    Some(gone) -> with_mailbox {
      let _ = Monitor.monitor(gone)
      let dead = Actor.receive()
      let _ = dead
      Stdout.print("ended actor reported")
      0
    }
    None -> 1
  }
}
