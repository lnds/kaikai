import spawn
import time

fn child(i: Int) : Int / Clock = { Clock.sleep_ns(1000000); i * 2 }

fn main() : Int / Stdout + Spawn + Clock = {
  Clock.sleep_ns(2000000)
  println("slept")
  let a = Spawn.spawn(() => child(1))
  let b = Spawn.spawn(() => child(2))
  println("sum #{Spawn.await(a) + Spawn.await(b)}")
  0
}
