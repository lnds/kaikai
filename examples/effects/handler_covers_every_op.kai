# A handler covers every op of its effect; an op whose `default { }` bridges
# to the runtime (`Stdout.is_tty`) needs no clause.

effect Telling {
  tell_of(line: String) : Unit
  entered(phase: Int) : Unit
  got_through(done: Int, total: Int) : Unit
}

fn heard(body: () -> Unit / Telling) : [String] = handle {
  body()
} with Telling([]) {
  tell_of(line, resume) -> resume((), state ++ [line])
  entered(phase, resume) -> resume((), state ++ ["entered #{phase}"])
  got_through(done, total, resume) -> resume((), state ++ ["#{done} of #{total}"])
  return(_x) -> state
}

fn phases() : Unit / Telling {
  Telling.entered(1)
  Telling.tell_of("preparing")
  Telling.got_through(2, 6)
}

fn quiet() : Int = handle {
  7
} with Stdout {
  print(_s, resume) -> resume(())
}

fn main() : Unit / Stdout = {
  Stdout.print("#{heard(phases)}")
  Stdout.print("quiet=#{quiet()}")
}
