import actor
import spawn

type Job = Work(Int)

fn my_actor[m, e](body: () -> Unit / Actor[m] + e) : Unit / Spawn + e {
  nursery { n ->
    let f = n.spawn(() => with_mailbox(body))
    n.await(f)
  }
}

fn worker() : Unit / Actor[Job] + Stdout {
  Actor.send(Actor.self(), Work(21))
  match Actor.receive() {
    Work(x) -> Stdout.print("work #{x * 2}")
  }
}

fn main() : Unit / Spawn + Stdout = my_actor(worker)
