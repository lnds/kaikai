# Operands evaluate left to right on every form with several operands,
# whatever C compiler builds the program: each operand logs its tag, and
# the golden is the order the tags must appear in.
#
# The C backend cannot leave this to C: call arguments and initializer
# lists have unspecified evaluation order there, and gcc on x86_64
# evaluates call arguments right to left. A callee expression runs
# before its arguments.

effect Log {
  say(s: String) : Unit
  join(a: String, b: String) : Unit
}

type Point = { x: Int, y: Int }

type Two = Two(Int, Int)

type BinOp = (Int, Int) -> Int

fn t(tag: String, n: Int) : Int / Log {
  Log.say(tag)
  n
}

fn s(tag: String) : String / Log {
  Log.say(tag)
  tag
}

fn add3(a: Int, b: Int, c: Int) : Int = a + b + c

fn raw_sum(n: Int) : Int / Log = t("raw.l", n) * t("raw.r", n)

fn pick(tag: String) : BinOp / Log {
  Log.say(tag)
  (x: Int, y: Int) => x - y
}

fn main() : Int {
  let total = handle {
    let binop = t("binop.l", 1) + t("binop.r", 2)
    let chain = t("chain.1", 3) * t("chain.2", 4) - t("chain.3", 5)
    let cat = s("concat.l") ++ s("concat.r")
    let same = s("streq.l") == s("streq.r")
    let call = add3(t("call.1", 1), t("call.2", 2), t("call.3", 3))
    let piped = t("pipe.1", 1) |> add3(t("pipe.2", 2), t("pipe.3", 3))
    let cl = (x: Int, y: Int) => x - y
    let applied = cl(t("apply.1", 9), t("apply.2", 4))
    let two = Two(t("variant.1", 1), t("variant.2", 2))
    let pt = Point { x: t("record.x", 1), y: t("record.y", 2) }
    let tup = (t("tuple.1", 1), t("tuple.2", 2))
    let xs = [t("list.1", 1), t("list.2", 2), t("list.3", 3)]
    let str = "#{t("interp.1", 1)}/#{t("interp.2", 2)}"
    Log.join(s("op.1"), s("op.2"))
    let lt = t("lt.l", 1) < t("lt.r", 2)
    let both = t("and.l", 1) > 0 and t("and.r", 1) > 0
    let rs = raw_sum(3)
    let picked = pick("callee.f")(t("callee.1", 5), t("callee.2", 1))
    let st = handle {
      State.get()
    } with State[Int](0) {
      get(resume) -> resume(t("resume.value", 1), t("resume.state", 2))
      set(v, resume) -> resume((), v)
      return(x) -> x
    }
    let n_two = match two {
      Two(a, b) -> a + b
    }
    let n_tup = match tup {
      (a, b) -> a + b
    }
    print("#{binop} #{chain} #{cat} #{same} #{call} #{piped} #{applied}")
    print(
      "#{n_two} #{pt.x + pt.y} #{n_tup} #{length(xs)} #{str} #{lt} #{both} #{rs} #{picked} #{st}"
    )
    0
  } with Log {
    say(m, resume) -> {
      print(m)
      resume(())
    }
    join(a, b, resume) -> {
      print("join #{a} #{b}")
      resume(())
    }
  }
  total
}
