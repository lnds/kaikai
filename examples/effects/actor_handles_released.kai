# A mailbox's Pid box and a spawned actor's thunk are freed once the last
# handle drops, so a thousand actors leave nothing behind. Every actor here
# finishes before main returns: one still queued at exit never runs, and the
# ledger counts what it holds.
import actor

fn idle() : Unit / Actor[String] = ()

fn ack(parent: Pid[String]) : Unit / Actor[String] = Actor.send(parent, "ack")

fn mailboxes(n: Int) : Unit / Spawn =
  if n == 0 { () } else {
    with_mailbox { idle() }
    mailboxes(n - 1)
  }

fn spawned(n: Int, acks: Int) : Int / Actor[String] + Spawn =
  if n == 0 { acks } else {
    let me = Actor.self()
    let _k = spawn_actor(() => ack(me))
    let _a = Actor.receive()
    spawned(n - 1, acks + 1)
  }

fn main() : Unit / Spawn + Console = {
  mailboxes(1000)
  let acks = with_mailbox { spawned(1000, 0) }
  println("#{acks} actors acked")
}
