# A record's function-typed field binds the record's row-kind tparam the
# way a sum constructor's field does: `Hook[Stdout]` holds a printing
# closure, reading the field is pure, and applying it raises the row.

effect Log { say(s: String) : Unit }

type Hook[e] = { name: String, run: (Int) -> Unit / e }

type Tap[t, e] = { seed: t, emit: (t) -> Unit / e }

fn fire(h: Hook[Stdout], n: Int) : Unit / Stdout = h.run(n)

fn fire_all(h: Hook[Stdout], xs: [Int]) : Unit / Stdout = xs |> each(h.run)

fn by_pattern(h: Hook[Stdout]) : Unit / Stdout = match h {
  { name, run } -> { Stdout.print("pattern #{name}") run(7) }
}

fn call[e](h: Hook[e], n: Int) : Unit / e = h.run(n)

fn pick[e](h: Hook[e]) : (Int) -> Unit / e = h.run

fn drip[t, e](p: Tap[t, e]) : Unit / e = p.emit(p.seed)

fn both(a: Hook[Stdout], b: Hook[Log]) : Unit / Stdout + Log = { a.run(10) b.run(11) }

fn main() : Unit / Stdout = {
  let h = Hook { name: "a", run: (n) => Stdout.print("run #{n}") }
  fire(h, 1)
  fire_all(h, [2, 3])
  by_pattern(h)
  let renamed = Hook { ...h, name: "b" }
  fire(renamed, 4)
  let replaced = Hook { ...h, run: (n) => Stdout.print("replaced #{n}") }
  fire(replaced, 5)
  let logged = Hook { ...h, run: (n) => Log.say("logged #{n}") }
  handle {
    call(logged, 6)
    pick(logged)(7)
    both(h, logged)
  } with Log { say(s, resume) -> { Stdout.print(s) resume(()) } }
  let later = (k) => { let f = k.run f(12) }
  later(h)
  let tap = Tap { seed: "x", emit: (s) => Stdout.print("tap #{s}") }
  drip(tap)
  drip(Tap { ...tap, seed: "y" })
  drip(Tap { seed: 8, emit: (n) => Stdout.print("int tap #{n}") })
}
