# Linking to an actor that has already ended reports its exit at once,
# with the reason it ended for. Each nursery joins its worker before the
# supervisor sees the pid, so both links land on peers that are gone.

import actor
import spawn

fn crasher() : Unit / Actor[Nothing] + Cancel = {
  Cancel.raise()
}

fn finisher() : Unit / Actor[Nothing] = ()

fn main() : Int / Spawn + Cancel + Link + Console = {
  var crashed := None
  handle {
    nursery { crashed := Some(spawn_actor(crasher)) }
  } with Cancel {
    raise(resume) -> ()
  }
  var finished := None
  nursery { finished := Some(spawn_actor(finisher)) }
  with_mailbox {
    spawn.set_trap_exit(true)
    match crashed {
      Some(p) -> Link.link(p)
      None -> ()
    }
    match finished {
      Some(p) -> Link.link(p)
      None -> ()
    }
    let a = Actor.receive()
    let b = Actor.receive()
    Stdout.print("crashed peer: " ++ a)
    Stdout.print("finished peer: " ++ b)
    0
  }
}
