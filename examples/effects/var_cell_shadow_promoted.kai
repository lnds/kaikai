fn sibling(flag: Bool) : Int =
  if flag {
    var i := 1
    i := i + 1
    i
  } else {
    var i := 10
    i := i + 5
    i
  }

fn main() : Int / Stdout = {
  var c := 1
  c := c + 1
  let outer = c
  let inner = {
    var c := 10
    c := c + outer
    c
  }
  Stdout.print("outer=#{c} inner=#{inner} sib=#{sibling(true)},#{sibling(false)}")
  0
}
