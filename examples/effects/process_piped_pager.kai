# Issue #1591 — the pager shape: only the child's stdin is piped, its
# stdout inherits the parent's (a real pager needs the terminal).
# `wait` is pclose-shaped: it closes the still-open write end, so the
# child sees EOF without an explicit `close_stdin` — cat drains, echoes
# to the shared stdout, and exits. The parent prints only after `wait`,
# so the golden's ordering is deterministic.
import os.process

fn feed(c: Child) : Int / Process =
  match process.write_stdin(c, "page one\n") {
    Err(_) -> 1
    Ok(_)  -> match process.write_stdin(c, "page two\n") {
      Err(_) -> 1
      Ok(_)  -> 0
    }
  }

fn main() : Int / Process + Stdout =
  match process.pipe_to("/bin/cat", []) {
    Err(e) -> { Stdout.print(string_concat("start FAIL: ", e)); 1 }
    Ok(c)  ->
      if feed(c) != 0 { Stdout.print("write FAIL"); 1 }
      else {
        match process.wait(c) {
          Err(e)        -> { Stdout.print(string_concat("wait FAIL: ", e)); 1 }
          Ok(Exited(0)) -> { Stdout.print("pager ok"); 0 }
          Ok(_)         -> { Stdout.print("wait FAIL: abnormal exit"); 1 }
        }
      }
  }
