# A `handle` inside a function whose row declares the same effect absorbs the
# ops performed in its body, and the calls made there: the lexically nearest
# handler wins over the caller's evidence. A function that declares the effect
# and installs no handler still forwards to its caller.

effect Emit {
  say(line: String) : Unit
}

fn quiet_stdout() : Int / Stdout = handle {
  Stdout.print("dropped by quiet_stdout")
  7
} with Stdout {
  print(_s, resume) -> resume(())
}

fn quiet_emit() : Int / Emit = handle {
  Emit.say("dropped by quiet_emit")
  5
} with Emit {
  say(_s, resume) -> resume(())
}

fn loud() : Int / Emit = {
  Emit.say("forwarded by loud")
  3
}

fn quiet_call() : Int / Emit = handle {
  loud()
} with Emit {
  say(_s, resume) -> resume(())
}

fn main() : Unit / Stdout = {
  Stdout.print("quiet_stdout=#{quiet_stdout()}")
  handle {
    let total = quiet_emit() + loud() + quiet_call()
    Stdout.print("total=#{total}")
  } with Emit {
    say(s, resume) -> resume(Stdout.print("outer heard: " ++ s))
  }
}
