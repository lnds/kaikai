# A clause runs on top of the perform site's handlers, so a same-name
# `var` cell live in the handled callee sits above the clause's own `xs`.
# The clause reads and writes its `xs` by id and never touches `run`'s.

effect Stack {
  push(x: Int) : Unit
  size()       : Int
}

fn run() : Int / Stack = {
  var xs := [100]
  let g = () => xs
  Stack.push(1)
  Stack.push(2)
  let n = Stack.size()
  n * 1000 + list_length(g())
}

fn main() : Int / Stdout = {
  let r = handle { run() } with Stack {
    var xs := []
    push(x, resume) -> {
      xs := [x, ...xs]
      resume(())
    }
    size(resume) -> resume(list_length(xs))
  }
  Stdout.print("r=#{r}")
  0
}
