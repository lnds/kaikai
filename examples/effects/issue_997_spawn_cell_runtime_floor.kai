# A `var` captured by a closure that the spawned task rebinds to a fresh local
# (`let g = reader`): the compile-time escape check is syntactic and does not
# see the alias. The var is a `Ref` cell, so the child fiber runs on its own
# copy of the captured closure: the program finishes, never a segfault.
import spawn

fn main() : Int / Spawn {
  var counter := 0
  let reader = () => {
    let _ = counter
    ()
  }
  nursery { n ->
    let f = n.spawn(() => {
      let g = reader
      g()
      ()
    })
    ()
  }
  0
}
