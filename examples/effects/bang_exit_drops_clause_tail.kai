effect Step {
  step(n: Int) : Int
}

effect Tick {
  tick() : Int
}

fn find(n: Int) : Option[Int] = if n > 0 { Some(n) } else { None }

fn direct(k: Int) : Option[Int] {
  let r = handle { find(Step.step(5) - k)! } with Step {
    step(n, resume) -> {
      let r = resume(n + 1)
      Stdout.print("after #{int_to_string(r)}")
      r
    }
    return(x) -> {
      Stdout.print("return #{int_to_string(x)}")
      x
    }
  }
  Some(r)
}

fn nested(k: Int) : Option[Int] {
  let r = handle { handle { find(Step.step(5) - k + Tick.tick())! } with Tick { tick(resume) -> resume(0) } } with Step {
    step(n, resume) -> {
      let r = resume(n + 1)
      Stdout.print("after #{int_to_string(r)}")
      r
    }
    return(x) -> {
      Stdout.print("return #{int_to_string(x)}")
      x
    }
  }
  Some(r)
}

fn show(o: Option[Int]) : String = match o {
  Some(n) -> "some #{int_to_string(n)}"
  None -> "none"
}

fn main() : Int / Stdout {
  Stdout.print(show(direct(100)))
  Stdout.print(show(direct(1)))
  Stdout.print(show(nested(100)))
  Stdout.print(show(nested(1)))
  0
}
