effect Base {
  base() : Int
  default {
    base(resume) -> resume(40)
    return(x) -> {
      Stdout.print("return #{int_to_string(x)}")
      x
    }
  }
}

fn find(n: Int) : Option[Int] = if n > 0 { Some(n) } else { None }

fn inherited(k: Int) : Option[Int] / Stdout {
  let r = handle {
    let x = find(Base.base() - k)!
    x + 1
  } with Base {
  }
  Some(r)
}

fn written(k: Int) : Option[Int] / Stdout {
  let r = handle {
    let x = find(Base.base() - k)!
    x + 1
  } with Base {
    base(resume) -> resume(40)
    return(x) -> {
      Stdout.print("return #{int_to_string(x)}")
      x
    }
  }
  Some(r)
}

fn show(o: Option[Int]) : String = match o {
  Some(n) -> "some #{int_to_string(n)}"
  None -> "none"
}

fn main() : Int / Stdout {
  Stdout.print(show(inherited(1)))
  Stdout.print(show(inherited(100)))
  Stdout.print(show(written(1)))
  Stdout.print(show(written(100)))
  0
}
