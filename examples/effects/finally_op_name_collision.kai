# `initially` / `finally` are contextual, recognised by SHAPE: the
# lifecycle clause is `finally { ... }` with no parameters, while an op
# clause always carries at least `resume`. So an effect may still declare
# and handle an op of its own called `finally`, and a handler may carry
# both in the same block without either shadowing the other.

effect Tx {
  finally(x: Int) : Unit
}

fn main() : Int / Stdout = {
  let r = handle {
    Tx.finally(3)
    9
  } with Tx {
    initially { 5 }
    finally   { Stdout.print("lifecycle #{int_to_string(state)}") }
    finally(v, resume) -> { Stdout.print("op #{int_to_string(v)}"); resume(()) }
    return(x)          -> x
  }
  Stdout.print("r=#{int_to_string(r)}")
  0
}
