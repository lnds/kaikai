# Case C — the same reach, one fiber down. A spawned fiber holds the
# `with Cancel` around its own nursery; its child crashes. The handler
# runs inside that fiber, so the fiber terminates DONE and the outer
# nursery sees no failure to propagate.

import spawn

fn intermediate() : Unit / Stdout + Spawn + Cancel =
  handle {
    nursery { inner ->
      let f = inner.spawn(() => Cancel.raise())
      inner.await(f)
    }
  } with Cancel {
    raise(resume) -> println("intermediate fiber caught the re-raise")
  }

fn main() : Unit / Stdout + Spawn + Cancel {
  nursery { outer ->
    let g = outer.spawn(() => intermediate())
    outer.await(g)
  }
  println("main finished")
}
