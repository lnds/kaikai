# A mock `Actor` handler sees every send whatever its message type: it
# can count them without inspecting the payload.

import actor

type Job = Work(Int)

fn chatty(jobs: Pid[Job], log: Pid[String]) : Unit / Actor[Job] = {
  Actor.send(jobs, Work(1))
  Actor.send(log, "sent one")
  Actor.send(jobs, Work(2))
}

fn count_sends(body: () -> Unit / Actor[Job]) : Int =
  handle { body() } with Actor[Job](0) {
    self(resume)                -> panic("the counting mailbox has no Pid")
    send(pid, msg, resume)      -> resume((), state + 1)
    receive(resume)             -> resume(Work(0), state)
    receive_timeout(ns, resume) -> resume(None, state)
    return(r)                   -> state
  }

fn main() : Unit / Stdout = {
  let n = with_mailbox {
    let me: Pid[String] = Actor.self()
    let jobs = with_mailbox { Actor.self() }
    count_sends(() => chatty(jobs, me))
  }
  Stdout.print("sends: #{n}")
}
