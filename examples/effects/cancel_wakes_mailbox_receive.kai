# A fiber parked in `Actor.receive()` on an empty mailbox is woken by a
# cancel: no message will ever do it. It unwinds through its handlers
# and the nursery ends. Every way a cancel is requested is covered:
# `n.cancel`, a sibling failing in the same nursery, and losing a
# `select`.

import actor
import spawn
import time

effect Lease {
  renew() : Unit
}

fn serve(who: String) : Int / Actor[String] + Stdout = handle {
  let said = Actor.receive()
  Stdout.print("#{who} received #{said}")
  7
} with Lease {
  finally { Stdout.print("#{who} released") }
  renew(resume) -> resume(())
}

fn fails() : Int / Cancel + Clock = {
  sleep(millis(50))
  Cancel.raise()
}

fn cancelled_by_handle() : Int / Spawn + Stdout + Clock = nursery { n ->
  let w = n.spawn(() => with_mailbox { serve("worker") })
  sleep(millis(50))
  Stdout.print("cancelling")
  n.cancel(w)
  0
}

fn cancelled_by_sibling() : Int / Spawn + Stdout + Clock = handle {
  nursery { n ->
    let _ = n.spawn(() => with_mailbox { serve("sibling") })
    let _ = n.spawn(() => fails())
    0
  }
} with Cancel {
  raise(resume) -> { Stdout.print("nursery failed"); 1 }
}

fn quick() : Int / Clock = {
  sleep(millis(50))
  3
}

fn cancelled_by_select() : Int / Spawn + Stdout + Clock = nursery { n ->
  let slow = n.spawn(() => with_mailbox { serve("loser") })
  let fast = n.spawn(() => quick())
  n.select([slow, fast])
}

fn main() : Int / Spawn + Stdout + Clock = {
  let a = cancelled_by_handle()
  Stdout.print("joined #{int_to_string(a)}")
  let b = cancelled_by_sibling()
  Stdout.print("joined #{int_to_string(b)}")
  let c = cancelled_by_select()
  Stdout.print("joined #{int_to_string(c)}")
  0
}
