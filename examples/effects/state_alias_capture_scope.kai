# A stateful handler's clause reads `state` and `log` as its own state,
# unless a binding around the handler is spelled so: then the clause
# captures that binding, and the read is the capture. Which one a read
# means is the binder's identity; the two share only a spelling.

effect Tick { tick() : Int }

# The clause captures the enclosing `state` (a String) and `log` (an
# Int); neither is the handler's Int state.
fn outer_bindings() : String / Stdout = {
  let state = "outer"
  let log = 40
  let n = handle {
    Tick.tick() + Tick.tick()
  } with Tick(1) {
    tick(resume) -> { Stdout.print("clause sees #{state}/#{int_to_string(log)}"); resume(log + 1) }
  }
  "#{state}:#{int_to_string(n)}"
}

# The inner handler's clause reads its own `state`; the outer handler's
# clause reads the outer one. Each handle has a state of its own.
fn nested_states() : Int = {
  handle {
    let inner = handle {
      Tick.tick()
    } with Tick(5) {
      tick(resume) -> resume(state * 2)
    }
    inner + Tick.tick()
  } with Tick(100) {
    tick(resume) -> resume(state + 1)
  }
}

fn main() : Int / Stdout = {
  Stdout.print(outer_bindings())
  Stdout.print(int_to_string(nested_states()))
  0
}
