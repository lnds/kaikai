# A handler clause borrows the enclosing binders it reads, as a lambda
# does: every op call reads them, and the enclosing scope releases each
# once, whether the clause reads it once, twice, through an index, or
# hands it to a callee that keeps it.

effect Res { acquire() : Int }

effect Log { note(s: String) : Unit }

fn read_by_index() : Int / Mutable = {
  let xs = array_make(3, 7)
  handle {
    Res.acquire() + Res.acquire()
  } with Res {
    acquire(resume) -> resume(xs[0])
  }
}

fn read_in_body_and_clause(label: String) : Int = {
  let n = handle {
    Res.acquire() + string_length(label)
  } with Res {
    acquire(resume) -> resume(string_length(label) + string_length(label))
  }
  n + string_length(label)
}

fn kept_by_callee(word: String) : [String] = {
  let out = handle {
    Res.acquire()
    Res.acquire()
  } with Res {
    acquire(resume) -> {
      let kept = [word, word]
      resume(list.length(kept))
    }
  }
  [word, int_to_string(out)]
}

fn read_by_cleanup(tag: String) : Int = {
  let r = handle {
    handle {
      Res.acquire()
    } with Res {
      acquire(resume) -> resume(string_length(tag))
      finally         { Log.note(tag) }
    }
  } with Log {
    note(s, resume) -> resume(())
  }
  r
}

fn handle_in_clause(outer: String) : Int = handle {
  Res.acquire()
} with Res {
  acquire(resume) -> {
    let inner = handle {
      Log.note(outer)
      string_length(outer)
    } with Log {
      note(s, resume) -> resume(())
    }
    resume(inner + string_length(outer))
  }
}

fn mixed(n: Int, r: Real, xs: [Int]) : Int = handle {
  Res.acquire() + n
} with Res {
  acquire(resume) -> resume(n + real_to_int(r) + list.length(xs) + list.length(xs))
}

fn main() : Unit / Stdout + Mutable = {
  let ys = [1, 2, 3]
  Stdout.print("read_by_index: #{read_by_index()}")
  Stdout.print("read_in_body_and_clause: #{read_in_body_and_clause("abc#{1}")}")
  Stdout.print("kept_by_callee: #{string_join(kept_by_callee("w#{2}"), ",")}")
  Stdout.print("read_by_cleanup: #{read_by_cleanup("t#{3}")}")
  Stdout.print("handle_in_clause: #{handle_in_clause("o#{4}")}")
  Stdout.print("mixed: #{mixed(4, 2.5, ys)} #{list.length(ys)}")
}
