# A handler that discards its continuation releases what the skipped frames own.

effect Failure {
  fail(msg: String) : Nothing
}

effect Tick {
  tick() : Unit
}

fn len(xs: [Int]) : Int = match xs {
  [] -> 0
  [_, ...t] -> 1 + len(t)
}

fn walk(xs: [Int], n: Int) : Int / Failure = match xs {
  [] -> n
  [h, ...t] -> {
    if h == 3 { Failure.fail("three") } else { () }
    walk(t, n + h)
  }
}

fn walk_after(xs: [Int]) : Int / Failure = match xs {
  [] -> 0
  [h, ...t] -> {
    let r = walk_after(t)
    if h == 1 { Failure.fail("one") } else { () }
    r + h + len(t)
  }
}

fn peek(xs: [Int]) : Int / Failure = match xs {
  []       -> Failure.fail("empty")
  [h, ..._] -> h
}

fn lent(xs: [Int]) : Int / Failure = peek(xs)

fn rows(xss: [[Int]], n: Int) : Int / Failure = match xss {
  [] -> n
  [row, ...rest] -> {
    if len(row) == 2 { Failure.fail("pair") } else { () }
    rows(rest, n + len(row))
  }
}

fn call_through(f: () -> Int / Failure, ys: [Int]) : Int / Failure = {
  let r = f()
  r + len(ys)
}

fn same_frame(xs: [Int]) : Int / Failure = {
  let r = handle {
    Failure.fail("inner")
    len(xs)
  } with Failure {
    fail(_m, _k) -> 7
  }
  r
}

fn stateful_skip() : Int / Failure = {
  handle {
    Tick.tick()
    Failure.fail("past")
  } with Tick([1, 2, 3]) {
    tick(resume) -> resume((), [9, ...state])
    return(x) -> x + len(log)
  }
}

fn guard(g: () -> Int / Failure) : Int = handle { g() } with Failure {
  fail(_m, _k) -> 0
}

fn main() : Unit / Stdout = {
  let a = guard(() => walk([1, 2, 3, 4], 0))
  let b = guard(() => walk_after([5, 1, 2]))
  let c = guard(() => call_through(() => Failure.fail("cl"), [1, 2]))
  let d = guard(() => same_frame([4, 5, 6]))
  let e = guard(() => stateful_skip())
  let f = guard(() => lent([]))
  let g = guard(() => rows([[1], [2, 3], [4]], 0))
  println("#{a} #{b} #{c} #{d} #{e} #{f} #{g}")
}
