# A user `Actor[Msg]` handler with its clauses in its own order does not
# reach into `spawn_actor`: the child runs every op on its real mailbox.

import actor
import time

type Msg = Tick(Int) | Done

fn child(parent: Pid[Msg]) : Unit / Actor[Msg] = {
  Actor.send(Actor.self(), Tick(41))
  let n = match Actor.receive() {
    Tick(k) -> k
    Done    -> 0
  }
  match receive_timeout(millis(1)) {
    None    -> Actor.send(parent, Tick(n + 1))
    Some(_) -> Actor.send(parent, Done)
  }
}

fn main() : Int / Spawn + Stdout = with_mailbox {
  let me = Actor.self()
  let scripted = handle {
    let _ = spawn_actor(() => child(me))
    Actor.receive()
  } with Actor[Msg] {
    receive_timeout(ns, resume) -> resume(Some(Done))
    receive(resume)             -> resume(Tick(0))
    send(pid, msg, resume)      -> resume(())
    self(resume)                -> panic("the scripted mailbox has no Pid")
  }
  match scripted {
    Tick(n) -> Stdout.print("scripted receive #{n}")
    Done    -> Stdout.print("scripted done")
  }
  match Actor.receive() {
    Tick(n) -> Stdout.print("child replied #{n}")
    Done    -> Stdout.print("child saw a stray message")
  }
  0
}
