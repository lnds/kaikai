effect Say {
  say(s: String) : Unit
  loud(s: String) : Unit
  default {
    loud(s, resume) -> {
      Stdout.print("LOUD #{s}")
      resume(())
    }
  }
}

fn main() : Int / Stdout {
  handle {
    a.say("one")
    a.loud("two")
  } with Say as a {
    say(s, resume) -> {
      Stdout.print("say #{s}")
      resume(())
    }
  }
  0
}
