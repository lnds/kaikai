effect Stop {
  stop(code: Int) : Int
  other() : Unit
  default {
    stop(code, resume) -> code * 2
    other(resume) -> resume(())
  }
}

fn main() : Unit / Stdout {
  let out = handle {
    let v = Stop.stop(21)
    println("not reached #{v}")
    v
  } with Stop {
    other(resume) -> resume(())
  }
  println("handle result #{out}")
}
