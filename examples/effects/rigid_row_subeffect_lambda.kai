effect Ping { ping() : Unit }

fn around[a, e](hear: () -> Unit / e, body: () -> a / Ping + e) : a / e = handle {
  body()
} with Ping {
  ping(resume) -> {
    hear()
    resume(())
  }
  return(x) -> x
}

fn watched[e](once: () -> Int / Ping + e) : Int / e {
  var heard := false
  let code = around(() => { heard := true }, () => once())
  if heard { code + 1 } else { code }
}

fn main() : Int / Stdout {
  let n = watched(() => {
    Ping.ping()
    41
  })
  Stdout.print("#{n}")
  0
}
