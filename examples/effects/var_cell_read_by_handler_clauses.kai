# Vars declared in a handler body are read by its clauses through unaliased
# State performs from other fns, so their cells must stay dispatched.

effect Stack {
  push(x: Int) : Unit
  pop()        : Int
}

fn run() : Unit / Stack + Console = {
  Stack.push(10)
  Stack.push(20)
  let a = Stack.pop()
  println("popped: #{int_to_string(a)}")
}

fn main() : Unit / Console = {
  handle { run() } with Stack {
    var xs := []
    var n := 0
    push(x, resume) -> {
      xs := [x, ...xs]
      n := n + 1
      resume(())
    }
    pop(resume) -> match xs {
      []           -> resume(0)
      [x, ...rest] -> {
        xs := rest
        resume(x)
      }
    }
  }
}
