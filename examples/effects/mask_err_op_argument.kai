effect Sink {
  put(a: Array[Int]) : Unit
}

fn go() : Unit / Sink {
  let a = array_make(2, 0)
  Sink.put(a)
  a[0] := 9
}

fn main() : Unit / Mutable + Console = {
  let cell = Mutable.ref_make(array_make(2, 0))
  handle { go() } with Sink {
    put(a, resume) -> {
      Mutable.ref_set(cell, a)
      resume(())
    }
  }
  print(int_to_string(Mutable.ref_get(cell)[0]))
}
