# Labels that differ only in a function type's row stay distinct, and a
# handler whose row matches a label discharges exactly that one.
effect Log { log(msg: String) : Unit }
effect Tick { tick() : Unit }
effect Cell[T] { get() : T }

fn two() : Int / Cell[() -> Unit / Log] + Cell[() -> Unit / Tick] = 2

fn main() : Unit / Stdout = {
  let n = handle {
    handle { two() } with Cell[() -> Unit / Log] {
      get(resume) -> resume(() => ())
    }
  } with Cell[() -> Unit / Tick] {
    get(resume) -> resume(() => ())
  }
  Stdout.print(int_to_string(n))
}
