# An op written on a row alias must reach the component that declares it,
# carrying that effect's identity. `Chat` declares no ops of its own, so
# `Chat.say` is `Loud.say`; `Wide` nests `Chat`, so `Wide.say` is too.
# Before the resolver settled this, the alias-written perform reached KIR
# with `sym_none()` while the directly written one carried its id — the
# same effect, the same op, two different answers in one function.

pub effect Loud {
  say(s: String) : Unit
}

pub effect Quiet {
  hush() : Unit
}

pub type Chat = Loud + Quiet

fn spoken() : Unit / Chat = {
  Chat.say("via alias")
  Loud.say("written direct")
}

fn main() : Unit / Stdout = {
  handle {
    handle { spoken() } with Quiet {
      hush(resume) -> resume(())
    }
  } with Loud {
    say(s, resume) -> resume(())
  }
  Stdout.print("ok")
}
