import actor
import spawn

type Job = Work(Int)

type Note = Say(Int)

fn my_actor[m, e](body: () -> Unit / Actor[m] + e) : Unit / Spawn + e {
  nursery { n ->
    let f = n.spawn(() => with_mailbox(body))
    n.await(f)
  }
}

fn worker(log: Pid[Note]) : Unit / Actor[Job] + Actor[Note] {
  Actor.send(log, Say(1))
}

fn main() : Unit / Spawn = with_mailbox {
  let _jobs: Pid[Job] = Actor.self()
  with_mailbox {
    let log: Pid[Note] = Actor.self()
    my_actor(() => worker(log))
  }
}
