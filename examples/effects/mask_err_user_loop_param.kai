fn times(n: Int, body: () -> Unit / e) : Unit / e =
  if n > 0 { body(); times(n - 1, body) } else { () }

fn fill(p: Array[Int]) : Unit {
  var i := 0
  times(3) {
    p[i] := i + 1
    i := i + 1
  }
}

fn main() : Unit / Mutable + Console = {
  let a = array_make(3, 0)
  fill(a)
  print(int_to_string(a[2]))
}
