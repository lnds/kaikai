# A core Array[Byte] writer's first argument is the array it mutates. When
# that array is a parameter the write is observable to the caller, so the
# row must declare `Mutable`, even though the source is local.

fn fill(dst: Array[Byte]) : Array[Byte] {
  let src = array_make(2, 7u8)
  bytes_blit(dst, 0, src, 0, 2)
}

fn main() : Unit / Mutable + Console = {
  let a = array_make(2, 0u8)
  let _ = fill(a)
  print(int_to_string(byte_to_int(a[0])))
}
