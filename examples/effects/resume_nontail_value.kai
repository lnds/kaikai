# `resume(v)` in non-tail position runs the rest of the body with the op
# returning `v` and evaluates to the handle's result; the clause's own
# value then becomes the handle's result.

effect Ask { number() : Int }

fn main() : Unit / Stdout = {
  let c = handle { let n = Ask.number(); Stdout.print("body got n=#{n}"); n + 1 }
          with Ask { number(resume) -> { let r = resume(20); Stdout.print("resume returned r=#{r}"); r * 2 } }
  Stdout.print("c=#{c}")
}
