# issue #1564 — a scalar cell written inside a handle body must keep the
# write when a clause abandons `resume` and the op site longjmps back to
# the install site. The cell-promotion pass used to rewrite such a cell to
# a raw local, which is indeterminate on the second return of the setjmp.
# Covers the three promotable scalar classes plus the resume contrast:
# only the discard path ever lost the write.

effect Fault { boom(m: String) : Int }

fn discarded_int() : Int = {
  let a = array_make(1, 0)
  let _r = handle {
    array_set(a, 0, 1)
    Fault.boom("x")
  } with Fault {
    boom(_m, _resume) -> -1
    return(x)         -> x
  }
  a[0]
}

fn discarded_real() : Real = {
  let a = array_make(1, 0.5)
  let _r = handle {
    array_set(a, 0, 2.5)
    Fault.boom("x")
  } with Fault {
    boom(_m, _resume) -> -1
    return(x)         -> x
  }
  a[0]
}

fn discarded_bool() : Bool = {
  let a = array_make(1, false)
  let _r = handle {
    array_set(a, 0, true)
    Fault.boom("x")
  } with Fault {
    boom(_m, _resume) -> -1
    return(x)         -> x
  }
  a[0]
}

fn resumed_int() : Int = {
  let a = array_make(1, 0)
  let _r = handle {
    array_set(a, 0, 1)
    Fault.boom("x")
  } with Fault {
    boom(_m, resume) -> resume(-1)
    return(x)        -> x
  }
  a[0]
}

fn main() : Unit / Stdout {
  Stdout.print("discarded_int=#{int_to_string(discarded_int())}")
  Stdout.print("discarded_real=#{real_to_string(discarded_real())}")
  Stdout.print("discarded_bool=#{show(discarded_bool())}")
  Stdout.print("resumed_int=#{int_to_string(resumed_int())}")
}
