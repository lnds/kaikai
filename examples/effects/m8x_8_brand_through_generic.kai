# Brand attribution survives a round-trip through a generic helper.
# `id` returns its own parameter unchanged, so it is brand-transparent:
# the fiber `f` spawned in `n1` keeps `n1`'s brand across `id(f)`, and
# the sibling-nursery breach at `n2.await(g)` is still rejected. Before
# brand-transparency summaries the helper stripped the brand and this
# program compiled clean.

import spawn

fn task() : Int = 7

fn id[T](x: T) : T = x

fn main() : Int / Console + Spawn {
  let r = nursery { n1 ->
    let f = n1.spawn(task)
    let g = id(f)
    nursery { n2 ->
      n2.await(g)
    }
  }
  Stdout.print(int_to_string(r))
  0
}
