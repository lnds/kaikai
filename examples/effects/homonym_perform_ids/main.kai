# Two modules each declare `effect Log`. A contested effect is spelled
# `Log__<home>` before the resolver runs, a name the symbol table does not
# hold, so a perform of either reached KIR without an identity and every
# later pass told the two apart by that spelling alone. Each perform must
# carry the id of the `Log` its own module declares.
import ra
import rb

fn main() : Unit / Stdout = {
  let a = handle { ra.run() } with ra.Log { tally(n, resume) -> resume(n + 100) }
  let b = handle { rb.run() } with rb.Log {
    total(resume) -> resume(7)
    tally(n, resume) -> resume(n + 40)
  }
  Stdout.print("#{a} #{b}")
}
