# M:N constructor metadata — a tag's name and slot mask are recorded by
# whichever thread constructs it first.
#
# Nothing on the main fiber builds a `SeqCons` before the workers start, so
# every scheduler thread reaches the first construction of that tag at once.

import seq
import spawn

fn total(lo: Int, hi: Int) : Int = foldl(lazy [lo..hi], 0, (acc, x) => acc + x)

fn main() : Unit / Spawn + Stdout {
  let sums = nursery { n ->
    let fibers = [1, 101, 201, 301, 401, 501, 601, 701] | (lo => n.spawn(() => total(lo, lo + 99)))
    fibers | (f => n.await(f))
  }
  Stdout.print(show(sums))
}
