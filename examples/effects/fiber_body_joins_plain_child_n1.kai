# A plain fiber spawned by another fiber outside any nursery is joined when
# the parent's body ends: awaiting the parent returns only after the child.

import spawn
import time

fn worker() : Unit / Clock + Stdout = {
  sleep(millis(50))
  Stdout.print("child done")
}

fn parent() : Unit / Spawn + Clock + Stdout = {
  let _ = Spawn.spawn(() => worker())
  Stdout.print("parent returning")
}

fn main() : Int / Spawn + Clock + Stdout = {
  let p = Spawn.spawn(() => parent())
  Spawn.await(p)
  Stdout.print("parent awaited")
  0
}
