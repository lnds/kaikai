# A fiber-local builtin performed in a handler clause costs the same with 64 unrelated handlers between the clause and the perform.

import time

effect Tick {
  tick() : Unit
}

effect Other {
  other() : Unit
}

fn burst(n: Int) : Unit / Spawn =
  if n == 0 { () } else { Spawn.scope_enter(); Spawn.scope_exit(); burst(n - 1) }

fn nest(depth: Int) : Unit / Tick =
  if depth == 0 { Tick.tick() }
  else {
    handle { nest(depth - 1) } with Other {
      other(resume) -> resume(())
      return(x)     -> x
    }
  }

fn run(depth: Int, n: Int) : Unit / Spawn =
  handle { nest(depth) } with Tick {
    tick(resume) -> { burst(n); resume(()) }
    return(x)    -> x
  }

fn timed(depth: Int, n: Int) : Int / Spawn + Clock = {
  let start = monotonic()
  run(depth, n)
  duration_to_nanos(elapsed_since(start, monotonic()))
}

fn main() : Int / Stdout + Spawn + Clock = {
  # The depth is capped by the wasm stack, not by the property.
  let flat = timed(0, 4000000)
  let deep = timed(64, 4000000)
  # 10 ms of slack keeps a loaded runner from flaking on a near-zero flat run.
  let ok = deep < flat * 2 + 10000000
  Stdout.print(if ok { "depth-independent" } else { "FAIL flat=#{flat} deep=#{deep}" })
  if ok { 0 } else { 1 }
}
