# A clause body's `let state` shadows the handler state only after it.

effect Gauge { scale(r: Real) : Real }
fn main() : Int / Stdout = {
  let g = handle { Gauge.scale(1.5) } with Gauge(0.25) {
    scale(r, resume) -> {
      let s = state
      let state = 2
      resume(r * s + int_to_real(state), s + r)
    }
    return(v) -> v + state
  }
  Stdout.print("g=#{g}")
  0
}
