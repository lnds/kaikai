# A server actor that loops on `receive` forever does not hang the program:
# `main` returning cancels it and the exit code is 0.

import actor
import time

effect Lease {
  renew() : Unit
}

fn loop_serve() : Unit / Actor[Int] + Stdout = {
  let m = Actor.receive()
  Stdout.print("got #{int_to_string(m)}")
  loop_serve()
}

fn serve() : Unit / Actor[Int] + Stdout = handle {
  loop_serve()
} with Lease {
  finally { Stdout.print("server stopped") }
  renew(resume) -> resume(())
}

fn run() : Unit / Actor[Int] + Spawn + Stdout + Clock = {
  let pid = spawn_actor(() => serve())
  Actor.send(pid, 1)
  Actor.send(pid, 2)
  sleep(millis(50))
}

fn main() : Int / Spawn + Stdout + Clock = {
  with_mailbox { run() }
  Stdout.print("main returning")
  0
}
