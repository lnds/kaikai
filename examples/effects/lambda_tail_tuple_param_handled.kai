effect Other {
  other() : Unit
}

pub fn f() : Int = {
  let run = (p) => {
    let (g, x) = p
    g() + x
  }
  handle { run((() => { Other.other(); 1 }, 2)) } with Other {
    other(resume) -> resume(())
    return(r) -> r * 10
  }
}

fn main() : Int / Stdout = {
  Stdout.print(int_to_string(f()))
  0
}
