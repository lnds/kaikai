import gen

fn naturals(n: Int) : Unit / Yield[Int] = {
  Yield.yield(n)
  naturals(n + 1)
}

fn relay(g: Gen[Int, e]) : Unit / Yield[Int] + e = match g {
  Done       -> ()
  Next(p, k) -> {
    Yield.yield(p)
    relay(k(()))
  }
}

fn outer() : Gen[Int, e] / e = {
  let inner = gen.generate(() => naturals(2))
  gen.generate(() => relay(inner))
}

fn main() : Unit / Stdout = {
  let upto = gen.take_until(outer(), (p) => p >= 5)
  gen.each_indexed(upto, (_i, p) => Stdout.print("#{p}"))
}
