# A return clause's `state` is the handler state, not a `let state` the
# enclosing function binds after the handle.

effect Gauge { scale(r: Real) : Real }
fn main() : Int / Stdout = {
  let g = handle { Gauge.scale(1.5) } with Gauge(0.25) {
    scale(r, resume) -> resume(r * state, state + r)
    return(v)        -> v + state
  }
  let state = 7
  Stdout.print("g=#{g} s=#{state}")
  0
}
