# A clause that does not resume jumps past every frame between the
# perform and its handle. What those frames computed before the perform
# and had not yet handed on — a binder a later operand consumes, a value
# an earlier operand built, a literal — is released on the way.

effect Vet {
  vet(n: Int) : Int
}

type Two = Two(String, Int)

type Rec = { a: String, b: Int }

fn mk(s: String) : String = string_concat(s, "!")

fn keep2(a: String, b: Int) : Int = string_length(a) + b

fn two_len(t: Two) : Int = match t {
  Two(s, n) -> string_length(s) + n
}

fn total(xs: [Int]) : Int / Vet = match xs {
  [] -> 0
  [x, ...rest] -> Vet.vet(x) + total(rest)
}

fn label(i: Int) : String / Vet = "body #{Vet.vet(i)}"

fn shapes(i: Int) : Int / Vet = {
  let arg = keep2(mk("a"), Vet.vet(i))
  let cat = string_length(mk("b") ++ int_to_string(Vet.vet(i)))
  let lst = list_length([mk("c"), int_to_string(Vet.vet(i))])
  let r = Rec { a: mk("d"), b: Vet.vet(i) }
  let ctor = two_len(Two(mk("e"), Vet.vet(i)))
  let piped = mk("f") |> keep2(Vet.vet(i))
  let eq = if mk("g") == int_to_string(Vet.vet(i)) { 1 } else { 2 }
  arg + cat + lst + string_length(r.a) + r.b + ctor + piped + eq
}

fn spine(xs: [Int]) : [String] / Vet = match xs {
  [] -> []
  [x, ...rest] -> [mk("h"), int_to_string(Vet.vet(x)), ...spine(rest)]
}

fn run(body: () -> Int / Vet) : Int = handle { body() } with Vet {
  vet(n, resume) -> if n < 0 { 0 - 1 } else { resume(n) }
}

fn run_s(body: () -> String / Vet) : String = handle { body() } with Vet {
  vet(n, resume) -> if n < 0 { "no" } else { resume(n) }
}

fn main() : Unit / Stdout = {
  Stdout.print("total #{run(() => total([-2, 3]))} #{run(() => total([2, 3]))}")
  Stdout.print("label #{run_s(() => label(0 - 1))} #{run_s(() => label(4))}")
  Stdout.print("shapes #{run(() => shapes(0 - 1))} #{run(() => shapes(1))}")
  Stdout.print("spine #{run(() => list_length(spine([1, 2, -3, 4])))} #{run(() => list_length(spine([1, 2])))}")
}
