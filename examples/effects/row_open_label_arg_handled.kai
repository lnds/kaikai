# A label's type argument may carry an open row. Binding the row-variable
# sentinel is a no-op, so the handle discharges the label instead of trapping.
effect Log { log(msg: String) : Unit }
effect Cell[T] { get() : T }

fn open_label[e]() : Int / Cell[() -> Unit / Log + e] = 7

fn closed_label() : Int / Cell[() -> Unit / Log] = 5

fn main() : Int / Stdout = {
  let a = handle { open_label() } with Cell[() -> Unit / Log] {
    get(resume) -> resume(() => ())
  }
  let b = handle { closed_label() } with Cell[() -> Unit / Log] {
    get(resume) -> resume(() => ())
  }
  Stdout.print("row_open_label_arg_handled #{a} #{b} ok")
  0
}
