# A server actor started by a plain fiber outlives that fiber: the fiber is
# awaited and gone when the server speaks to main, and the server is
# cancelled when main returns.

import actor
import spawn
import time

effect Lease {
  renew() : Unit
}

fn serve(boss: Pid[String]) : Unit / Actor[String] + Clock + Stdout = handle {
  sleep(millis(50))
  Actor.send(boss, "hello from the server")
  let _ = Actor.receive()
} with Lease {
  finally { Stdout.print("server stopped") }
  renew(resume) -> resume(())
}

fn start(boss: Pid[String]) : Unit / Spawn + Clock + Stdout = with_mailbox {
  let _ = spawn_actor(() => serve(boss))
  ()
}

fn run() : Unit / Actor[String] + Spawn + Clock + Stdout = {
  let boss = Actor.self()
  Spawn.await(Spawn.spawn(() => start(boss)))
  Stdout.print("starter done")
  Stdout.print(Actor.receive())
}

fn main() : Int / Spawn + Clock + Stdout = {
  with_mailbox { run() }
  Stdout.print("main returning")
  0
}
