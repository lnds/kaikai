import actor
import spawn

type Resp = Answer(Int)

fn avisar(p: Pid[Resp]) : Unit / Actor[Resp] = Actor.send(p, Answer(7))

fn main() : Unit / Spawn + Stdout = with_mailbox {
  let yo = Actor.self()
  nursery { n ->
    let f = n.spawn(() => with_mailbox { avisar(yo) })
    n.await(f)
  }
  match Actor.receive() {
    Answer(x) -> Stdout.print("recibí #{x}")
  }
}
