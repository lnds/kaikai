# A handler that resumes, then logs: each log line is written after the
# rest of the body has run, so they come out in reverse order, after the
# body's own output.

effect Trace { note(msg: String) : Unit }

fn work() : Int / Trace + Stdout = {
  Trace.note("first")
  Stdout.print("working")
  Trace.note("second")
  42
}

fn main() : Unit / Stdout = {
  let r = handle { work() } with Trace {
    note(msg, resume) -> {
      let v = resume(())
      Stdout.print("after #{msg}")
      v
    }
  }
  Stdout.print("r=#{r}")
}
