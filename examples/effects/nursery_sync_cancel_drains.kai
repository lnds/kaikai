# A `Cancel.raise()` inside a nursery body, caught by a handler outside it,
# cancels and joins the nursery's children before the handler's value is
# produced.

import spawn
import time

fn slow() : Int / Clock + Cancel = {
  sleep(seconds(60))
  1
}

fn body() : Int / Spawn + Console + Cancel + Clock = nursery { n ->
  let _a = n.spawn(slow)
  let _b = n.spawn(slow)
  sleep(millis(10))
  Cancel.raise()
}

fn main() : Int / Spawn + Console + Cancel + Clock = {
  handle {
    let r = body()
    Stdout.print(show(r))
  } with Cancel {
    raise(resume) -> Stdout.print("cancelled")
  }
  0
}
