effect Tick {
  tick() : Unit
}

effect Other {
  other() : Unit
}

fn inner() : Int {
  let run = g => handle {
    g()
  } with Tick {
    tick(resume) -> resume(())
    return(x) -> x
  }
  run(() => {
    Other.other()
    1
  })
}

pub fn f() : Int = handle {
  inner()
} with Other {
  other(resume) -> resume(())
  return(x) -> x + 41
}

fn main() : Int / Stdout {
  Stdout.print(int_to_string(f()))
  0
}
