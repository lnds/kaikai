# A row-kind slot of a nominal type carries a concrete effect. The slot
# must stay rigid: `Box[Log]` accepts only a `Box[Log]`, exactly as the
# bare arrow `() -> Unit / Log` does. The sibling `.err.expected`
# fixtures pin the rejection of `Box[Beep]` and of a non-effect name.
pub type Box[e] = Box(() -> Unit / e)

effect Log { say(s: String) : Unit }

fn run_it(b: Box[Log]) : Unit / Log = match b { Box(f) -> f() }

fn main() : Int = {
  let b : Box[Log] = Box(() => Log.say("boxed"))
  handle { run_it(b) } with Log { say(s, resume) -> { print(s); resume(()) } }
  0
}
