import actor

type Msg = Tick(Int) | Stop

fn on_tick(f: (Int) -> Unit, n: Int) : Int / Actor[Msg] = 1 + serve(f)

fn serve(f: (Int) -> Unit) : Int / Actor[Msg] = match Actor.receive() {
  Tick(k) -> on_tick(f, k)
  Stop    -> 0
}

fn feed(me: Pid[Msg], i: Int, n: Int) : Unit / Actor[Msg] =
  if i >= n { Actor.send(me, Stop) } else { Actor.send(me, Tick(i)); feed(me, i + 1, n) }

fn main() : Unit / Spawn + Stdout = with_mailbox {
  feed(Actor.self(), 0, 1000)
  println("#{serve(k => ())}")
}
