# A builder that comes back from a fold has no provable local provenance,
# so appending to it keeps `Mutable` on the row. The error must point at
# that append, and name the fold as the call the builder came back from.
import string_builder as sb
import core.list

pub fn ok(xs: [String]) : String {
  let b = list.foldl(xs, sb.new(), (acc, x) => sb.append(acc, x))
  sb.build(b)
}

pub fn bad(xs: [String]) : String {
  let b = list.foldl(xs, sb.new(), (acc, x) => sb.append(acc, x))
  let c = sb.append(b, "!")
  sb.build(c)
}

fn main() : Unit / Stdout = { println(ok(["a"])); println(bad(["a"])) }
