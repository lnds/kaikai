# A handler clause parameter's annotation is checked against the op's
# declared type. Two positions must keep compiling: an annotation that
# agrees with a concrete op parameter, and one naming the effect's type
# parameter on a generic slot — the effect declaration remains the
# source of truth for the binding either way.

effect Sink {
  put(s: String) : Unit
}

effect St[T] {
  get() : T
  set(v : T) : Unit
}

fn emit() : Unit / Sink = Sink.put("ok")

fn main() : Unit / Stdout = {
  handle {
    emit()
  } with Sink {
    put(s: String, resume) -> { Stdout.print(s); resume(()) }
    return(x) -> x
  }
  let n = handle {
    St.set(St.get() + 2)
    St.get()
  } with St[Int](40) {
    get(resume)       -> resume(state)
    set(v: T, resume) -> resume((), v)
    return(x)         -> x
  }
  Stdout.print("#{n}")
}
