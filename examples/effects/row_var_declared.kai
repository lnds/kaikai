# A row variable the body performs is accepted once the signature
# declares it: directly, through a lambda, through a core combinator,
# next to a concrete label, and in a lambda whose parameter's row is
# fixed only by the expected type.

effect Log { say(s: String) : Unit }

type Box[e] = Box((Int) -> Unit / e)

type Hook[e] = { run: (Int) -> Unit / e }

fn open_box[e](b: Box[e]) : Unit / e = match b { Box(f) -> f(1) }

fn fire[e](h: Hook[e]) : Unit / e = h.run(2)

fn later[e](f: (Int) -> Unit / e) : () -> Unit / e = () => f(3)

fn each_of[e](xs: [Int], f: (Int) -> Unit / e) : Unit / e = xs |> each((x) => f(x))

fn noisy[e](f: (Int) -> Unit / e) : Unit / Stdout + e = {
  Stdout.print("noisy")
  f(6)
}

fn tagged(n: Int) : ((Int) -> Unit / Stdout) -> Unit / Stdout =
  (emit) => {
    Stdout.print("tag")
    emit(n)
  }

fn main() : Unit / Stdout = {
  open_box(Box((n) => Stdout.print("box #{n}")))
  fire(Hook { run: (n) => Stdout.print("hook #{n}") })
  later((n) => Stdout.print("later #{n}"))()
  each_of([4, 5], (n) => Stdout.print("each #{n}"))
  noisy((n) => Stdout.print("noisy #{n}"))
  tagged(7)((n) => Stdout.print("tagged #{n}"))
  handle { fire(Hook { run: (n) => Log.say("log #{n}") }) }
  with Log { say(s, resume) -> { Stdout.print(s) resume(()) } }
}
