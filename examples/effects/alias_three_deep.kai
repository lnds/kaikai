# Three nested handles bind one alias name. Each level reads its own
# instance, before and after the level below it ran.

effect Cell {
  get() : Int
}

fn main() : Unit / Stdout = {
  let r = handle {
    let top = a.get()
    let two = handle {
      let mid = a.get()
      let one = handle { a.get() } with Cell as a { get(resume) -> resume(1) }
      one + mid * 10 + a.get() * 100
    } with Cell as a {
      get(resume) -> resume(2)
    }
    two + top * 1000 + a.get() * 10000
  } with Cell as a {
    get(resume) -> resume(3)
  }
  Stdout.print(int_to_string(r))
}
