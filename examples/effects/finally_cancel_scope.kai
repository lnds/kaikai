# Cancellation runs the cleanup of scopes it unwinds. The guarded scope
# installs no `Cancel` handler — the fiber unwinds straight to its
# trampoline — which before `finally` meant the resource was never
# released. The scheduler's cancel path now drains the evidence chain,
# so the cleanup runs on the way out.
#
# Cancellation is cooperative: `work` yields through `Clock.sleep_ns`,
# which is where the injected `Cancel.raise()` is delivered.

import spawn
import time

effect Bracket {
  unused() : Unit
}

fn work(i: Int) : Int / Cancel + Clock =
  if i > 200 { i } else { Clock.sleep_ns(5000000); work(i + 1) }

fn main() : Int / Stdout + Spawn + Clock = {
  nursery { n ->
    let f = n.spawn(() => {
      let r = handle {
        work(0)
      } with Bracket {
        initially { 1 }
        finally   { Stdout.print("released") }
        unused(resume) -> resume(())
        return(x)      -> x
      }
      r
    })
    Clock.sleep_ns(30000000)
    n.cancel(f)
  }
  Stdout.print("cancel done")
  0
}
