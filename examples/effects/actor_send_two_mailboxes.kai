# A send needs no instance matching the destination's message type:
# the recorder's only instance is its own mailbox's.

import actor

type Event = Seen(Int)

type Cmd = Note(Int) | Halt

fn recorder(log: Pid[String]) : Unit / Actor[Cmd] {
  match Actor.receive() {
    Note(n) -> {
      Actor.send(log, "note #{n}")
      recorder(log)
    }
    Halt -> Actor.send(log, "halt")
  }
}

fn main() : Unit / Spawn + Stdout = with_mailbox {
  let me: Pid[String] = Actor.self()
  let rec = with_mailbox {
    spawn_actor(() => recorder(me))
  }
  Actor.send(rec, Note(1))
  Actor.send(rec, Note(2))
  Actor.send(rec, Halt)
  Stdout.print(Actor.receive())
  Stdout.print(Actor.receive())
  Stdout.print(Actor.receive())
}
