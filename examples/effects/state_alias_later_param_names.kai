# Binders named like a clause param (`r`) and the return param (`v`),
# bound after the handle, stay apart from the clause's.

effect Gauge { scale(r: Real) : Real }
fn main() : Int / Stdout = {
  let g = handle { Gauge.scale(1.5) } with Gauge(0.25) {
    scale(r, resume) -> resume(r * state, state + r)
    return(v)        -> v + state
  }
  let r = 3
  let v = "after"
  Stdout.print("g=#{g} r=#{r} v=#{v}")
  0
}
