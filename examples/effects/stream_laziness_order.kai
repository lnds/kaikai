import stream

effect Trace { note(s: String) : Unit }

fn each_traced(label: String, xs: [Int]) : Unit / stream.Emit[Int] + Trace = match xs {
  [] -> ()
  [x, ...rest] -> {
    Trace.note("#{label} produce #{x}")
    stream.Emit.emit(x)
    each_traced(label, rest)
  }
}

fn traced(label: String, xs: [Int]) : stream.Stream[Int, Trace] =
  stream.Stream(() => each_traced(label, xs))

fn note_each(x: Int) : Unit / Trace = Trace.note("each #{x}")

fn interleave() : Unit / Trace =
  traced("a", [1, 2, 3]) |> stream.each(note_each)

fn take_stops() : Unit / Trace =
  traced("b", [1, 2, 3, 4, 5]) |> stream.take(2) |> stream.each(note_each)

fn chain() : Int / Trace =
  traced("c", [1, 2, 3, 4, 5, 6])
    |> stream.map((x) => x * 10)
    |> stream.filter((x) => x > 10)
    |> stream.take(2)
    |> stream.foldl(0, (a, x) => a + x)

fn inner(x: Int) : stream.Stream[Int, Trace] = traced("inner#{x}", [x, x + 10, x + 20])

fn nested() : Unit / Trace =
  traced("d", [1, 2, 3]) |> stream.flat_map(inner) |> stream.take(4) |> stream.each(note_each)

fn run_unit(body: () -> Unit / Trace) : Unit / Stdout =
  handle { body() } with Trace {
    note(s, resume) -> { Stdout.print(s); resume(()) }
  }

fn run_int(body: () -> Int / Trace) : Int / Stdout =
  handle { body() } with Trace {
    note(s, resume) -> { Stdout.print(s); resume(()) }
  }

fn main() : Unit / Stdout = {
  Stdout.print("-- interleave")
  run_unit(interleave)
  Stdout.print("-- take stops the producer")
  run_unit(take_stops)
  Stdout.print("-- map, filter, take")
  Stdout.print("total=#{run_int(chain)}")
  Stdout.print("-- flat_map inner stops with take")
  run_unit(nested)
}
