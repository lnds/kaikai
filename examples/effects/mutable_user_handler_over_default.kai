# A user `handle { } with Mutable { }` wins over the base default
# installed under `main`. Its `array_get` reads the NEXT slot, still the
# sentinel 999, so `n == 999` holds only if the user clause ran; the base
# default would read the 7 the user `array_set` clause stored. The clause
# returns no literal sentinel because it serves every element type.

fn main() : Int {
  let n = handle {
    let xs = Mutable.array_make(3, 999)
    let _ = Mutable.array_set(xs, 0, 7)
    Mutable.array_get(xs, 0)
  } with Mutable {
    array_make(n, init, resume)    -> resume(array_make(n, init))
    array_length(a, resume)        -> resume(array_length(a))
    array_get(a, i, resume)        -> resume(array_get(a, i + 1))
    array_set(a, i, v, resume)     -> resume(array_set(a, i, v))
    array_grow(a, n, init, resume) -> resume(array_grow(a, n, init))
    return(x)                       -> x
  }
  assert n == 999
  0
}
