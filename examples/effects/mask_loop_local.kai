import loop

fn put(a: Array[Int], i: Int) : Unit / Mutable = {
  a[i] := i * i
}

fn squares(n: Int) : Int {
  let p = array_make(n, 0)
  var i := 0
  while { i < n } {
    put(p, i)
    i := i + 1
  }
  var j := 0
  repeat(n) {
    p[j] := p[j] + 1
    j := j + 1
  }
  p[n - 1]
}

fn main() : Unit / Console = print(int_to_string(squares(4)))
