# A fiber parked in `receive_timeout` is woken by the send that reaches its
# mailbox. Each round pings an echo actor and waits for the pong with a
# deadline far beyond any honest delay, so a wait that runs out is a lost
# wake-up, and the pong it slept through is still in the mailbox.
#
# The first lost wake-up ends the rally: a failing run costs one deadline and
# a healthy one never waits, so the printed line does not depend on timing.

import actor
import time

type Ask = | Ping(Pid[Pong]) | Stop
type Pong = | Pong

fn echo() : Unit / Actor[Ask] = match Actor.receive() {
  Ping(from) -> {
    Actor.send(from, Pong)
    echo()
  }
  Stop -> ()
}

# Pings answered before the first wait that ran out.
fn rally(to: Pid[Ask], me: Pid[Pong], left: Int, answered: Int) : Int / Actor[Pong] =
  if left <= 0 {
    answered
  } else {
    Actor.send(to, Ping(me))
    let got : Option[Pong] = receive_timeout(seconds(5))
    match got {
      Some(_) -> rally(to, me, left - 1, answered + 1)
      None -> answered
    }
  }

fn leftover(count: Int) : Int / Actor[Pong] {
  let got : Option[Pong] = receive_timeout(millis(50))
  match got {
    Some(_) -> leftover(count + 1)
    None -> count
  }
}

fn main() : Unit / Stdout + Spawn = with_mailbox(() => {
  let me : Pid[Pong] = Actor.self()
  let to = spawn_actor(() => echo())
  let answered = rally(to, me, 20000, 0)
  Actor.send(to, Stop)
  Stdout.print("#{answered} of 20000 pings answered in time, #{leftover(0)} pongs left in the mailbox")
})
