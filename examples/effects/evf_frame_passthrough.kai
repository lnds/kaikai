# A call whose evidence frame is the caller's own, slot for slot, passes the
# caller's frame instead of copying it into a fresh array per call.

effect Log {
  log(s: String) : Unit
}

fn walk(n: Int) : Int / Log + Stdout = {
  if n == 0 {
    0
  } else {
    Log.log("at #{n}")
    1 + walk(n - 1)
  }
}

fn main() : Unit / Stdout = {
  let total = handle {
    walk(3)
  } with Log {
    log(s, resume) -> { Stdout.print(s); resume(()) }
    return(x)      -> x
  }
  Stdout.print("total #{total}")
}
