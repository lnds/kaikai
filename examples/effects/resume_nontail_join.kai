# `resume` on one branch of an `if` whose value the clause goes on to
# use: the code after the `if` is shared by the path that resumes (it
# runs at the handle's exit) and the one that does not (it runs at once,
# and its value is the handle's).

effect Ask { number(i: Int) : Int }

fn run(i: Int) : String =
  handle { let n = Ask.number(i); "body #{n}" } with Ask {
    number(i, resume) -> {
      let r = if i > 0 { resume(i * 2) } else { "no resume" }
      "clause: #{r}"
    }
  }

fn main() : Unit / Stdout = {
  Stdout.print(run(5))
  Stdout.print(run(0))
}
