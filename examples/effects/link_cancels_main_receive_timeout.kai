# A linked peer that cancels wakes the main fiber out of `receive_timeout`.

import actor
import spawn
import time

fn child(parent: Pid[String]) : Unit / Actor[String] + Link + Cancel = {
  Link.link(parent)
  Cancel.raise()
}

fn wait_for_peer() : Unit / Actor[String] + Spawn + Console + Link + Cancel + Clock = {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { child(me) })
  match receive_timeout(seconds(60)) {
    Some(m) -> Stdout.print("got: " ++ m)
    None -> Stdout.print("timed out")
  }
}

fn main() : Int / Spawn + Console + Link + Cancel + Clock = {
  with_mailbox {
    handle {
      wait_for_peer()
    } with Cancel {
      raise(resume) -> Stdout.print("main cancelled")
    }
  }
  0
}
