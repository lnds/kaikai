# Two `state` binders in one body respell the enclosing one; a stateful
# handler's clauses still read it, not the handler's state slot.

effect Res { acquire() : Int }

fn shadowed_twice() : Int = {
  let first = {
    let state = 40
    state + 1
  }
  let state = 7
  handle {
    Res.acquire()
  } with Res(5) {
    acquire(resume) -> resume(state + 100)
    return(x)       -> x + state + first
  }
}

fn alias_beside_sibling_binder() : Int = {
  let first = {
    let state = 40
    state + 1
  }
  handle {
    Res.acquire()
  } with Res(5) {
    acquire(resume) -> resume(state + 100)
    return(x)       -> x + first
  }
}

fn main() : Unit / Stdout = {
  Stdout.print("shadowed_twice: #{shadowed_twice()}")
  Stdout.print("alias_beside_sibling_binder: #{alias_beside_sibling_binder()}")
}
