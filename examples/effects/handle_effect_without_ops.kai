# An effect with no operations is a declaration all the same: its
# handler is a bracket, whose only business is `initially` / `finally`
# and `return`.

effect Group {}

effect Scope {}

fn bracketed() : Int / Stdout = handle {
  Stdout.print("body")
  20
} with Scope {
  initially { Stdout.print("enter"); 1 }
  finally   { Stdout.print("leave") }
  return(x) -> x + state
}

fn grouped() : Int / Group + Stdout = {
  Stdout.print("grouped")
  5
}

fn main() : Int / Stdout = {
  let plain = handle {
    Stdout.print("in")
    21
  } with Group {
    return(x) -> x * 2
  }
  Stdout.print("plain=#{int_to_string(plain)}")
  Stdout.print("bracketed=#{int_to_string(bracketed())}")
  let bare = handle { grouped() } with Group {}
  Stdout.print("bare=#{int_to_string(bare)}")
  0
}
