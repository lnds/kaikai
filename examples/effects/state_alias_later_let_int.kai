# Same as state_alias_later_let, with an Int state and an Int later binder.

effect Count { bump(n: Int) : Int }
fn main() : Int / Stdout = {
  let g = handle { Count.bump(2) + Count.bump(3) } with Count(10) {
    bump(n, resume) -> resume(n + state, state + n)
    return(v)       -> v * 100 + state
  }
  let state = 7
  Stdout.print("g=#{g} s=#{state}")
  0
}
