# An actor still parked in `receive` when `main` returns is cancelled and
# joined: its cleanup runs before the program exits, and the exit code is 0.

import actor

effect Lease {
  renew() : Unit
}

fn serve(boss: Pid[String]) : Unit / Actor[String] + Stdout = handle {
  let said = Actor.receive()
  Stdout.print("served #{said}")
  Actor.send(boss, "ack")
  let _ = Actor.receive()
} with Lease {
  finally { Stdout.print("server released") }
  renew(resume) -> resume(())
}

fn run() : Unit / Actor[String] + Spawn + Stdout = {
  let boss = Actor.self()
  let pid = spawn_actor(() => serve(boss))
  Actor.send(pid, "ping")
  let _ = Actor.receive()
}

fn main() : Int / Spawn + Stdout = {
  with_mailbox { run() }
  Stdout.print("main returning")
  0
}
