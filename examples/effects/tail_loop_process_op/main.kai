# A tail loop over a `Process` operation in an imported module, on a spawned
# fiber: it must run in constant stack.

import spawn
import os.process as proc
import prober

fn main() : Int / Stdout + Spawn + Process {
  let child = proc.start("/bin/sh", ["-c", "sleep 30"])
  let alive = nursery { spawn.await(spawn.spawn(() => prober.probe(child, 200000, 0))) }
  let _k = proc.kill(child, 9)
  let _w = proc.wait(child)
  Stdout.print(int_to_string(alive))
  0
}
