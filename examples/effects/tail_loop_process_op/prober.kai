import os.process as proc

#[doc("Probe `child` with signal 0 up to `n` times, counting the turns it answered.")]
pub fn probe(child: Child, n: Int, alive: Int) : Int / Process =
  if n == 0 { alive }
  else {
    match proc.kill(child, 0) {
      Ok(_)  -> probe(child, n - 1, alive + 1)
      Err(_) -> alive
    }
  }
