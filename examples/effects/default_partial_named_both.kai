effect Tool {
  a() : Int
  b() : Int
  default {
    a(resume) -> resume(1)
  }
}

fn apply(f: () -> Int / e) : Int / e = f()

fn hb() : Int / Tool = Tool.b()

fn main() : Int / Stdout {
  let r = handle {
    t.b() + Tool.a()
  } with Tool as t {
    a(resume) -> resume(5)
    b(resume) -> resume(6)
  }
  Stdout.print(int_to_string(r))
  0
}
