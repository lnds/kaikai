# A stateful handler's non-tail `resume(v, s)`: the body continues with
# the new state, and the clause's tail still sees `state` as it was when
# the clause was entered.

effect Counter { bump() : Int }

fn main() : Unit / Stdout = {
  let c = handle { let a = Counter.bump(); let b = Counter.bump(); a * 10 + b } with Counter(1) {
    bump(resume) -> {
      let r = resume(state, state + 1)
      Stdout.print("tail: entered with state=#{state}, got #{r}")
      r + state * 1000
    }
    return(x) -> x + state * 100
  }
  Stdout.print("c=#{c}")
}
