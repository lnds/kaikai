# The runtime dispatches a user `Cancel` clause when a nursery exits on a
# cancelled child; the clause is called through its own function type.

import spawn

fn child() : Unit / Cancel = Cancel.raise()

fn main() : Int / Spawn + Cancel + Console = {
  handle {
    nursery {
      let _ = spawn.spawn(child)
      ()
    }
  } with Cancel {
    raise(_k) -> Stdout.print("cancel handled")
  }
  0
}
