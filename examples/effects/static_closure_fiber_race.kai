import spawn

fn inc(x: Int) : Int = x + 1
fn dbl(x: Int) : Int = x * 2
fn neg(x: Int) : Int = 0 - x

fn work(n: Int) : Int = {
  let a = [n, n + 1, n + 2] |> map(inc) |> map(dbl)
  let b = a |> map(neg) |> map((x) => x + 1)
  foldl(b, 0, (acc, x) => acc + x)
}

fn one(i: Int) : Int / Spawn = {
  let f = spawn.spawn(() => work(i))
  spawn.await(f)
}

fn sum_to(i: Int, acc: Int) : Int / Spawn =
  if i == 0 { acc } else { sum_to(i - 1, acc + one(i)) }

fn main() : Int / Console + Spawn {
  Stdout.print(int_to_string(sum_to(300, 0)))
  0
}
