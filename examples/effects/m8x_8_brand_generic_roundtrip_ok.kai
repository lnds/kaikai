# The positive side of brand transparency: a fiber round-tripped
# through a generic helper and consumed by its OWN nursery keeps
# working. Following the brand across `id` must not turn a legitimate
# same-nursery await into a false mismatch.

import spawn

fn task() : Int = 7

fn id[T](x: T) : T = x

fn main() : Int / Console + Spawn {
  let r = nursery { n ->
    let f = n.spawn(task)
    let g = id(f)
    n.await(g)
  }
  Stdout.print(int_to_string(r))
  0
}
