# `mc` declares no `Log`, so its head and its perform name the core one.
pub fn go() : Unit / Stdout = {
  handle { Log.info("from-core-log") } with Log {
    debug(msg, resume) -> resume(())
    info(msg, resume)  -> { Stdout.print("core got #{msg}"); resume(()) }
    warn(msg, resume)  -> resume(())
    error(msg, resume) -> resume(())
  }
}
