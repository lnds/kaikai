# A producer holds a resource while a consumer's handler abandons the
# continuation. The producer cannot handle the fault itself without
# shadowing the consumer's policy, so before `finally` its release was
# unreachable: the discard longjmps clean over its frame.
#
# `initially` acquires into the handler state and `finally` releases it,
# so acquisition and release live in the one construct that guarantees
# both. Counts must balance on the abort path.

effect Res {
  acquire() : Int
  release(h: Int) : Unit
}

effect Fault {
  boom(m: String) : Int
}

effect Bracket {
  unused() : Unit
}

fn work() : Int / Bracket + Fault = Fault.boom("x")

fn main() : Int / Stdout = {
  let rec = array_make(2, 0)
  let r = handle {
    handle {
      handle {
        work()
      } with Bracket {
        initially { rec[0] := rec[0] + 1; Res.acquire() }
        finally   { rec[1] := rec[1] + 1; Res.release(state) }
        unused(resume) -> resume(())
        return(x)      -> x
      }
    } with Fault {
      boom(_m, _resume) -> -1
      return(x)         -> x
    }
  } with Res {
    acquire(resume)     -> resume(42)
    release(_h, resume) -> resume(())
    return(x)           -> x
  }
  Stdout.print("bracket r=#{int_to_string(r)} opened=#{int_to_string(rec[0])} closed=#{int_to_string(rec[1])}")
  0
}
