# A clause's tail that performs an outer effect whose clause abandons:
# the outer handle's value is the abandoned one, and the inner handle's
# remaining tails never run.

effect Ask { number() : Int }
effect Bail { bail(why: String) : Int }

fn inner() : Int / Bail = handle { let a = Ask.number(); let b = Ask.number(); a + b } with Ask {
  number(resume) -> {
    let r = resume(1)
    if r > 1 { Bail.bail("tail saw #{r}") } else { r }
  }
}

fn main() : Unit / Stdout = {
  let s = handle { let n = inner(); "inner gave #{n}" } with Bail { bail(why, resume) -> "bailed: #{why}" }
  Stdout.print(s)
}
