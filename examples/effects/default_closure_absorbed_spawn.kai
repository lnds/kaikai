import spawn

effect Note {
  note(msg: String) : Unit
  default {
    note(msg, resume) -> {
      Stdout.print("note: #{msg}")
      resume(())
    }
  }
}

fn worker() : Unit / Note {
  Note.note("from child")
}

fn main() : Int / Spawn {
  handle {
    nursery { n ->
      let f = n.spawn(worker)
      n.await(f)
    }
    0
  } with Note {
    note(msg, resume) -> resume(())
  }
}
