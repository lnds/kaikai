# A loop cell, one captured by a closure, and the cells stdlib streams and
# bigints keep name the core `State`.

import loop
import stream
import math.bigint

fn count(n: Int) : Int = {
  var i := 0
  var acc := 0
  while { i < n } {
    acc := acc + i
    i := i + 1
  }
  acc
}

fn captured() : Int = {
  var c := 0
  let add = (x) => { c := c + x }
  add(3)
  add(4)
  c
}

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(count(10)))
  Stdout.print(int_to_string(captured()))
  Stdout.print(int_to_string(stream.from_list([1, 2, 3, 4]) |> stream.take(2) |> stream.count))
  Stdout.print(bigint.to_string(bigint.mul(bigint.from_int(3000000000), bigint.from_int(3000000000))))
}
