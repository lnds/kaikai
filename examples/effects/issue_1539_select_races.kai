# Issue #1539 fixture — Spawn.select races instead of returning the head.
#
# Pre-fix: `select` scanned once for an already-DONE fiber and, finding
# none, parked on the HEAD of the list. Completion order was ignored, so
# the documented `race` / `with_timeout` patterns waited on whichever
# fiber happened to be written first.
#
# The head here sleeps for a minute and the second candidate returns at
# once, so the two behaviours are distinguishable rather than merely
# differently-timed: the old code blocks on the sleeper for 60s, the new
# code returns 7 immediately and cancels the loser. The sleeper is
# cancellable (it parks on the reactor timer), which is what lets the
# nursery join it at scope exit instead of hanging.

import time
import spawn

fn slow() : Int / Clock + Cancel = {
  time.sleep(time.seconds(60))
  1
}

fn quick() : Int / Clock + Cancel = 7

fn main() : Int / Spawn + Clock + Cancel + Stdout = {
  Stdout.print("select start")
  let winner = nursery { n ->
    let a = n.spawn(slow)
    let b = n.spawn(quick)
    n.select([a, b])
  }
  Stdout.print(int_to_string(winner))
  Stdout.print("select end")
  0
}
