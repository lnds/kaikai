effect Other {
  other() : Unit
}

type Box[e] = { f: () -> Int / e }

pub fn f() : Int {
  let run = r => {
    let g = r.f
    g()
  }
  handle {
    run(
      Box {
        f: () => {
          Other.other()
          1
        }
      }
    )
  } with Other {
    other(resume) -> resume(())
    return(r) -> r * 10
  }
}

fn main() : Int / Stdout {
  Stdout.print(int_to_string(f()))
  0
}
