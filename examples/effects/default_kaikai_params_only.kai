effect Scale {
  scaled(base: Int, factor: Int) : Int
  default {
    scaled(base, factor, resume) -> {
      let r = base * factor
      if r > 100 { resume(100) } else { resume(r) }
    }
  }
}

fn main() : Unit / Scale + Stdout {
  println("small #{Scale.scaled(3, 4)}")
  println("clamped #{Scale.scaled(30, 40)}")
}
