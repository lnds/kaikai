import collections.map

effect Repo {
  save(key: Int) : Unit
  del(key: Int) : Bool
}

fn run[r, e](body: () -> r / Repo + e) : r / e {
  var store: Map[Int, Int] := map.empty()
  handle {
    body()
  } with Repo {
    save(key, resume) -> {
      store.set(map.put(store, key, 0))
      resume(())
    }
    del(key, resume) -> {
      store.set(map.remove(store, key))
      resume(true)
    }
    return(x) -> x
  }
}

fn main() : Unit / Stdout {
  let b = run(() => { Repo.save(1); Repo.del(1) })
  Stdout.print("#{b}")
}
