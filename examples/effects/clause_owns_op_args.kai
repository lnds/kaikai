# Each op argument reaches its clause owned: one the clause never reads,
# reads twice, or only captures in a lambda is still released once.

effect Io { put(s: String) : Unit }

fn unread() : Int = handle {
  Io.put("u#{1}")
  1
} with Io {
  put(s, resume) -> resume(())
}

fn read_twice() : Int = handle {
  Io.put("t#{2}")
  2
} with Io {
  put(s, resume) -> {
    let n = string_length(s) + string_length(s)
    resume(())
  }
}

fn captured(k: Int) : Int = {
  let f = (j: Int) => handle {
    Io.put("c#{j}")
    j
  } with Io {
    put(s, resume) -> {
      let g = () => string_length(s)
      resume(())
    }
  }
  f(k)
}

fn aborted() : Int = handle {
  Io.put("a#{4}")
  0
} with Io {
  put(_s, _resume) -> 4
}

fn main() : Unit / Stdout = {
  Stdout.print("#{unread()} #{read_twice()} #{captured(3)} #{aborted()}")
}
