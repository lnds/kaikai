# The runtime's `each` and `reduce` call back into kaikai from C. A
# callback whose clause abandons leaves through their frames, which
# release the list, the closure and the accumulator they hold.

effect Vet {
  vet(n: Int) : Int
}

fn mk(s: String) : String = string_concat(s, "!")

fn visit(xs: [String], at: Int) : Int / Vet = {
  var seen := 0
  each(xs, (s) => { seen := seen + string_length(s) + Vet.vet(string_length(s) - at) })
  seen
}

fn fold(xs: [String], at: Int) : String / Vet =
  reduce(xs, mk("acc"), (acc, s) => if Vet.vet(string_length(s) - at) > 0 { acc ++ s } else { acc })

fn run(body: () -> Int / Vet) : Int = handle { body() } with Vet {
  vet(n, resume) -> if n < 0 { 0 - 1 } else { resume(n) }
}

fn run_s(body: () -> String / Vet) : String = handle { body() } with Vet {
  vet(n, resume) -> if n < 0 { "no" } else { resume(n) }
}

fn main() : Unit / Stdout = {
  let xs = [mk("a"), mk("bb"), mk("ccc")]
  Stdout.print("each #{run(() => visit(xs, 3))} #{run(() => visit(xs, 0))}")
  Stdout.print("reduce #{run_s(() => fold(xs, 3))} #{run_s(() => fold(xs, 0))}")
}
