# A clause that does not resume makes its own value the handle's
# result: the rest of the body and the `return` clause are skipped.

effect Vet { vet(n: Int) : Int }

fn validate(a: Int, b: Int) : String =
  handle { Vet.vet(a) + Vet.vet(b) } with Vet {
    vet(n, resume) -> if n < 0 { "rejected #{n}" } else { resume(n) }
    return(t)      -> "sum #{t}"
  }

fn main() : Unit / Stdout = {
  Stdout.print(validate(1, 2))
  Stdout.print(validate(1, -2))
  Stdout.print(validate(-1, 2))
}
