effect MyLog {
  info(msg: String) : Unit
  warn(msg: String) : Unit
  default {
    info(msg, resume) -> $extern_handler("kai_default_stdout_print")
    warn(msg, resume) -> $extern_handler("kai_default_stdout_print")
  }
}

fn emit() : Unit / MyLog = MyLog.warn("oops")

fn main() : Unit / MyLog + Stdout {
  let r = handle {
    emit()
    42
  } with MyLog {
    info(msg, resume) -> resume(())
  }
  println("result #{r}")
}
