# Case D — a scheduler-delivered cancellation already reached the
# worker's own handler; pinned here so the re-raise fix keeps that path
# intact. The worker parks on a long sleep, so delivery lands at the
# park and the output is deterministic at every KAI_THREADS.

import spawn
import time

fn worker() : Unit / Stdout + Cancel + Clock =
  handle {
    println("worker: parking")
    time.sleep(time.seconds(60))
    println("worker: woke (should not see this)")
  } with Cancel {
    raise(resume) -> println("worker: my Cancel handler ran")
  }

fn canceller(target: Fiber[Unit]) : Unit / Stdout + Clock + Spawn + Cancel = {
  time.sleep(time.millis(100))
  Spawn.cancel(target)
}

fn main() : Unit / Stdout + Spawn + Cancel + Clock {
  nursery { n ->
    let w = n.spawn(() => worker())
    let _ = n.spawn(() => canceller(w))
    n.await(w)
  }
  println("main finished")
}
