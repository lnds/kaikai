# A record's row-kind slot is invariant: `Hook[Stdout]` is not a
# `Hook[Stdout + Log]`.

effect Log { say(s: String) : Unit }

type Hook[e] = { run: (Int) -> Unit / e }

fn wide(h: Hook[Stdout + Log]) : Unit / Stdout + Log = h.run(1)

fn narrow(h: Hook[Stdout]) : Unit / Stdout + Log = wide(h)

fn main() : Unit / Stdout = ()
