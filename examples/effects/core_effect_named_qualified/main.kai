import mc
import ma

# The root's own `Log` shadows the core one, which stays nameable as
# `effects.Log` in a row, a handle head and a perform alike. `ma`'s alias
# names `ma`'s own `Log`, and keeps naming it from here.
effect Log {
  note(n: Int) : Unit
}

fn both() : Unit / Log + effects.Log = {
  Log.note(1)
  mc.go()
  effects.Log.info("qualified perform")
}

fn main() : Unit / Stdout = {
  handle {
    handle { both() } with Log {
      note(n, resume) -> { Stdout.print("root note #{n}"); resume(()) }
    }
  } with effects.Log {
    debug(m, resume) -> resume(())
    info(m, resume)  -> { Stdout.print("core info #{m}"); resume(()) }
    warn(m, resume)  -> resume(())
    error(m, resume) -> resume(())
  }
  handle { ma.go() } with ma.Log {
    note(n, resume) -> { Stdout.print("ma note #{n}"); resume(()) }
  }
}
