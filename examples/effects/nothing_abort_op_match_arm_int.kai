effect Abort {
  abort() : Nothing
}

fn pick(n: Int) : Int / Abort =
  match n {
    0 -> Abort.abort()
    _ -> n * 2
  }

fn main() : Unit / Stdout {
  let a : Int = handle { pick(0) } with Abort { abort(resume) -> -1 }
  let b : Int = handle { pick(4) } with Abort { abort(resume) -> -1 }
  println("a=" ++ int_to_string(a) ++ " b=" ++ int_to_string(b))
}
