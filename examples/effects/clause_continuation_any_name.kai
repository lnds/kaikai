# A clause's continuation is its last param, whatever it is called: a
# call of it resumes the body, and leaving it uncalled abandons it.

effect Ask { ask(q: String) : Int }

effect Count { tick() : Int }

fn named_k() : Int = handle { Ask.ask("ab") + 1 } with Ask {
  ask(q, k) -> k(string_length(q))
}

fn named_cont() : Int = handle { Ask.ask("abc") * 2 } with Ask {
  ask(q, cont) -> cont(string_length(q))
}

fn named_resume() : Int = handle { Ask.ask("abcd") + 100 } with Ask {
  ask(q, resume) -> resume(string_length(q))
}

fn abandoned() : Int = handle { Ask.ask("x") + 1000 } with Ask {
  ask(_q, _k) -> 7
}

fn stateful() : Int = handle {
  Count.tick()
  Count.tick()
  Count.tick()
} with Count(10) {
  tick(next) -> next(state, state + 1)
}

fn in_lambda(n: Int) : Int = {
  let tag = "t#{n}"
  let f = (x: Int) => handle { Ask.ask("q") + x } with Ask {
    ask(q, k) -> k(string_length(q) + string_length(tag) + n)
  }
  f(1)
}

fn main() : Unit / Stdout = {
  Stdout.print("#{named_k()} #{named_cont()} #{named_resume()} #{abandoned()} #{stateful()} #{in_lambda(5)}")
}
