# A generic whose function parameter performs a parametric effect: the
# label's type argument binds from the argument's row.

effect Emit[t] {
  emit(x: t) : Unit
}

fn twice[a](f: (a) -> Unit / Emit[a], x: a) : Unit / Emit[a] = {
  f(x)
  f(x)
}

fn send(n: Int) : Unit / Emit[Int] = Emit.emit(n)

fn main() : Int / Stdout = {
  handle { twice(send, 4) } with Emit[Int] {
    emit(x, resume) -> { Stdout.print("got #{int_to_string(x)}"); resume(()) }
  }
  0
}
