# A sender parked on a full BlockSender mailbox resumes when the receiver's
# scope ends, and its message is dropped.

import actor
import time

fn idle() : Unit / Actor[String] + Clock = sleep(millis(50))

fn main() : Unit / Spawn + Clock + Stdout {
  with_mailbox {
    let target = spawn_actor_policy(Bounded(1, BlockSender), () => idle())
    Actor.send(target, "fills the only slot")
    Actor.send(target, "parks until the receiver ends")
    ()
  }
  Stdout.print("the parked sender resumed after its receiver ended")
}
