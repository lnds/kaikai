# A higher-order function that performs an effect, called with a pure
# top-level stage: the call is specialised on the stage, and the copy still
# performs the effect. A clause that abandons from inside it releases what
# the copy's frames hold.

effect Stop { stop(v: Int) : Unit }

fn walk(xs: [Int], f: (Int) -> Int) : Unit / Stop = match xs {
  []        -> ()
  [h, ...t] -> { Stop.stop(f(h)); walk(t, f) }
}

fn square(x: Int) : Int = x * x

fn first_square(xs: [Int]) : Int =
  handle { walk(xs, square); 0 } with Stop { stop(v, resume) -> v }

fn main() : Unit / Stdout = {
  Stdout.print("#{first_square([3, 4, 5])}")
  Stdout.print("#{first_square([])}")
}
