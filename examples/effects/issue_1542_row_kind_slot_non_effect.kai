# Tier 1 escape canary: a non-effect name in a row-kind slot. `Box[Int]`
# must not satisfy `Box[Log]` — the slot was accepting any type at all
# while it was generalised as a free row variable.
pub type Box[e] = Box(() -> Unit / e)

effect Log { say(s: String) : Unit }

fn run_it(b: Box[Log]) : Unit / Log = match b { Box(f) -> f() }

fn feed(x: Box[Int]) : Unit / Log = run_it(x)

fn main() : Int = 0
