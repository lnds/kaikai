type Bx = Bx(Array[Int])

fn wrapped() : Int = {
  let a = array_make(2, 0)
  a[0] := 4
  let s = Some(a)
  match s { Some(x) -> x[0]  None -> 0 }
}

fn returned() : Option[Array[Int]] = {
  let a = array_make(2, 0)
  a[1] := 6
  Some(a)
}

fn boxed() : Int = {
  let a = array_make(2, 0)
  a[0] := 8
  let b = Bx(a)
  match b { Bx(x) -> x[0] }
}

fn main() : Unit / Stdout = {
  let r = match returned() { Some(x) -> x[1]  None -> 0 }
  println("#{wrapped()} #{r} #{boxed()}")
}
