# One non-local exit can unwind several scopes at once. Each scope's
# `finally` runs, innermost first — the order an unwind visits them —
# and the single jump past both handlers does not skip either.

effect Fault { boom(m: String) : Int }
effect A { nop() : Unit }
effect B { nop() : Unit }

fn main() : Int / Stdout = {
  let r = handle {
    handle {
      handle {
        Fault.boom("x")
      } with A {
        initially { 1 }
        finally   { Stdout.print("inner A") }
        nop(resume) -> resume(())
        return(x)   -> x
      }
    } with B {
      initially { 2 }
      finally   { Stdout.print("outer B") }
      nop(resume) -> resume(())
      return(x)   -> x
    }
  } with Fault {
    boom(_m, _resume) -> -1
    return(x)         -> x
  }
  Stdout.print("r=#{int_to_string(r)}")
  0
}
