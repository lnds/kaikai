import collections.hashmap.{HashMap, empty, put, get}

fn poner(a: Array[Int], i: Int, v: Int) : Unit / Mutable = {
  a[i] := v
}

fn fill_map(m: HashMap[String, Int], k: String, v: Int) : Unit / Mutable =
  put(m, k, v)

fn array_total() : Int {
  let a = array_make(3, 0)
  poner(a, 1, 7)
  poner(a, 2, 5)
  a[1] + a[2]
}

fn map_total() : Int {
  let m = empty()
  fill_map(m, "a", 4)
  match get(m, "a") {
    Some(v) -> v
    None    -> 0
  }
}

fn main() : Unit / Console = {
  print(int_to_string(array_total()))
  print(int_to_string(map_total()))
}
