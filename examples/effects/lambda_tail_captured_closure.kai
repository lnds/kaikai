effect Tick {
  tick() : Unit
}

effect Other {
  other() : Unit
}

pub fn f() : Int {
  let h = () => {
    Other.other()
    1
  }
  let run = () => handle {
    h()
  } with Tick {
    tick(resume) -> resume(())
    return(x) -> x
  }
  run()
}

fn main() : Int / Stdout {
  Stdout.print(int_to_string(f()))
  0
}
