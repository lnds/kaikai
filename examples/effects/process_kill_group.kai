# `kill_group` reaches the grandchild. The child shell backgrounds a
# `sleep` that inherits the stdout pipe, so `read_all` sees EOF only
# once the grandchild is dead too: a kill that stops at the child
# leaves the read blocked until the sleep ends. A child from plain
# `start` shares the caller's group, and `kill_group` on it is an Err
# that signals nobody — the caller survives to print the verdict.
import os.process

fn reaped_by_signal(c: Child, first: String, rest: String) : String / Process =
  match process.wait(c) {
    Ok(Signaled(9)) ->
      if first == "started\n" and rest == "" { "group: grandchild gone, child Signaled(9)" }
      else { "group MISMATCH: first=#{first} rest=#{rest}" }
    Ok(_)  -> "wait FAIL: expected Signaled(9)"
    Err(e) -> "wait FAIL: #{e}"
  }

fn kill_then_drain(c: Child, first: String) : String / Process =
  match process.kill_group(c, 9) {
    Err(e) -> "kill_group FAIL: #{e}"
    Ok(_)  -> match process.read_all(c) {
      Err(e)   -> "drain FAIL: #{e}"
      Ok(rest) -> reaped_by_signal(c, first, rest)
    }
  }

fn check_grandchild() : String / Process =
  match process.start_in_group("/bin/sh", ["-c", "sleep 60 & echo started; wait"], false, true, false) {
    Err(e) -> "start FAIL: #{e}"
    Ok(c)  -> match process.read_stdout(c) {
      Err(e)    -> "read FAIL: #{e}"
      Ok(first) -> kill_then_drain(c, first)
    }
  }

fn check_plain_child() : String / Process = {
  let c = process.start("/bin/sleep", ["60"])
  let r = process.kill_group(c, 9)
  let _k = process.kill(c, 9)
  let _w = process.wait(c)
  match r {
    Err(e) -> "plain: #{e}"
    Ok(_)  -> "plain: kill_group unexpectedly Ok"
  }
}

fn main() : Int / Process + Stdout {
  let group = check_grandchild()
  let plain = check_plain_child()
  Stdout.print(group)
  Stdout.print(plain)
  if group == "group: grandchild gone, child Signaled(9)" { 0 } else { 1 }
}
