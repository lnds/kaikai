# SigWinch end-to-end: a full-screen program learns the terminal was
# resized. The harness (tests/sigharness.c) syncs on the "ready" marker
# and then sends SIGWINCH, so the trap is proven by the variant name
# coming back out — SIGWINCH's default disposition is to ignore it, so
# an unsubscribed program would simply never wake.

fn name_of(s: Sig) : String / Console = match s {
  SigInt   -> "SigInt"
  SigTerm  -> "SigTerm"
  SigHup   -> "SigHup"
  SigUsr1  -> "SigUsr1"
  SigUsr2  -> "SigUsr2"
  SigWinch -> "SigWinch"
}

fn main() : Int / Signal + Console = {
  # Arm before the marker: the harness signals the instant it reads
  # "ready", so subscribing afterwards would race the delivery.
  Signal.on(SigWinch)
  Stdout.print("ready")
  let s = Signal.await()
  Stdout.print("got " ++ name_of(s))
  Signal.off(SigWinch)
  0
}
