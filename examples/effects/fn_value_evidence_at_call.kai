effect Tag {
  tag() : String
}

type Step = { run: (Int) -> Unit / Tag + Stdout }

fn emit_one(n: Int) : Unit / Tag + Stdout = Stdout.print("#{Tag.tag()}:#{n}")

fn call_all(s: Step, xs: [Int]) : Unit / Tag + Stdout = match xs {
  []           -> ()
  [x, ...rest] -> { s.run(x); call_all(s, rest) }
}

fn under(name: String, s: Step) : Unit / Stdout =
  handle { call_all(s, [1, 2]) } with Tag {
    tag(resume) -> resume(name)
  }

fn quiet(s: Step) : Unit =
  handle {
    handle { call_all(s, [3]) } with Tag { tag(resume) -> resume("muted") }
  } with Stdout {
    print(msg, resume) -> resume(())
  }

fn main() : Unit / Stdout = {
  # The closure exists before any handler does; the call site decides.
  let s = Step { run: emit_one }
  let again = Step { run: emit_one }
  under("outer", s)
  handle {
    under("inner", again)
    handle { call_all(s, [4]) } with Tag { tag(resume) -> resume("nested") }
    call_all(s, [5])
  } with Tag { tag(resume) -> resume("late") }
  quiet(s)
  Stdout.print("done")
}
