# A send to a mailbox whose scope has ended is dropped, not fatal: the
# child outlives its parent's with_mailbox and still speaks to it.

import actor
import time

type Msg = | Ping

fn late(parent: Pid[Msg]) : Unit / Actor[Msg] + Clock {
  sleep(millis(50))
  Actor.send(parent, Ping)
}

fn main() : Unit / Spawn + Clock + Stdout {
  with_mailbox {
    let me = Actor.self()
    let _child = spawn_actor(() => late(me))
    ()
  }
  sleep(millis(150))
  Stdout.print("the parent is gone and the program is still here")
}
