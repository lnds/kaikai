fn shout(s: String) : Unit / Stdout = println(s)

fn apply_closed(xs: [String], f: (String) -> Unit / Stdout + Stderr) : Unit / Stdout + Stderr = xs |! f(.)

fn apply_open[e](xs: [String], f: (String) -> Unit / Stdout + Stderr + e) : Unit / Stdout + Stderr + e = xs |! f(.)

fn main() : Unit / Stdout + Stderr {
  apply_closed(["closed"], shout)
  apply_open(["open"], shout)
  apply_closed(["lambda"], (s) => shout(s))
  ["pipe"] |> apply_closed(shout)
}
