# A `main` in an imported module is an ordinary function. `Journal` has a
# default handler, which only the program's entry point may fall back to:
# this `main` takes the effect from whoever calls it.

pub effect Journal {
  note(msg: String) : Unit
  default {
    note(msg, resume) -> $extern_handler("kai_default_stdout_print")
  }
}

pub fn main() : Int / Journal = {
  Journal.note("lib.main ran")
  7
}
