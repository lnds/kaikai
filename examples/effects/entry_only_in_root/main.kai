# The root's handler runs for what `lib.main` performs; the default does not.

import lib

fn main() : Unit / Stdout = {
  let n = handle {
    lib.main()
  } with lib.Journal {
    note(msg, resume) -> {
      Stdout.print("root handler: #{msg}")
      resume(())
    }
  }
  Stdout.print("lib.main returned #{n}")
}
