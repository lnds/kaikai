# Applying a `Hook[Stdout]` field raises `Stdout`: a signature that does
# not declare it is rejected, as for a sum carrying the same row.

type Hook[e] = { run: (Int) -> Unit / e }

fn go(h: Hook[Stdout]) : Unit = h.run(1)

fn main() : Unit / Stdout = go(Hook { run: (n) => Stdout.print("n=#{n}") })
