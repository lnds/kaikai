effect Cell {
  get() : Int
  put(tag: String, n: Int) : Unit
}

fn add(c1: Cell, c2: Cell, dst: Cell) : Unit =
  dst.put("sum", c1.get() + c2.get())

fn main() : Unit / Stdout = {
  handle {
    handle {
      handle {
        add(a, b, c)
      } with Cell(0) as c {
        get(resume)         -> resume(state)
        put(tag, n, resume) -> { Stdout.print("#{tag}=#{n}") resume(()) }
      }
    } with Cell(2) as b {
      get(resume)         -> resume(state)
      put(tag, n, resume) -> resume(())
    }
  } with Cell(1) as a {
    get(resume)         -> resume(state)
    put(tag, n, resume) -> resume(())
  }
}
