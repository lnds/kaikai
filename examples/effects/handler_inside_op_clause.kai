# A handler clause body lifts into its own function, so a handler or a
# lambda nested in it must be found under that function on both backends.

effect Res { acquire() : Int }
effect Tick { tick() : Int }

fn handler_in_clause() : Int = handle {
  Res.acquire()
} with Res {
  acquire(resume) -> {
    let n = handle { Tick.tick() } with Tick { tick(resume) -> resume(1) }
    resume(n + 1)
  }
}

fn lambda_in_clause() : Int = handle {
  Res.acquire()
} with Res {
  acquire(resume) -> {
    let double = (x: Int) => x * 2
    resume(double(21))
  }
}

fn stateful_nested_twice() : Int = handle {
  Res.acquire()
} with Res(10) {
  acquire(resume) -> {
    let n = handle {
      Tick.tick()
    } with Tick {
      tick(resume) -> {
        let m = handle { Res.acquire() } with Res { acquire(resume) -> resume(3) }
        resume(m + 4)
      }
    }
    resume(n + state)
  }
}

fn in_lambda(k: Int) : Int = {
  let run = (base: Int) => handle {
    Res.acquire()
  } with Res {
    acquire(resume) -> {
      let n = handle { Tick.tick() } with Tick { tick(resume) -> resume(base) }
      resume(n + k)
    }
  }
  run(100)
}

# A clause in a function whose evidence frame carries `Tick` still reaches
# `Tick` from its own body, where no frame is in scope.
fn clause_performs_outer() : Int / Tick = handle {
  Res.acquire()
} with Res {
  acquire(resume) -> resume(Tick.tick() + 1)
}

fn main() : Unit / Stdout = {
  Stdout.print("handler_in_clause: #{handler_in_clause()}")
  Stdout.print("lambda_in_clause: #{lambda_in_clause()}")
  Stdout.print("stateful_nested_twice: #{stateful_nested_twice()}")
  Stdout.print("in_lambda: #{in_lambda(5)}")
  let outer = handle { clause_performs_outer() } with Tick { tick(resume) -> resume(40) }
  Stdout.print("clause_performs_outer: #{outer}")
}
