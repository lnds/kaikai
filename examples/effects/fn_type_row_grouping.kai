# A row after a parenthesised arrow type belongs to the enclosing type;
# without the parentheses it would bind to the arrow's own row.

effect Log {
  say(s: String) : Unit
}

type Curried = (Int) -> ((Int) -> Int) / Log

type Maker = { make: (Int) -> ((Int) -> Int) / Log }

fn pick() : ((Int) -> Int) / Log {
  Log.say("pick")
  (x: Int) => x + 1
}

fn positive(n: Int) : (Int where self > 0) / Log {
  Log.say("positive")
  n
}

fn hold[e](f: () -> Int / e) : (() -> Int) / e {
  let v = f()
  () => v
}

fn run(f: Curried, m: Maker) : Int / Log = f(1)(2) + m.make(3)(4)

fn logged(body: () -> Int / Log) : Int / Stdout =
  handle {
    body()
  } with Log {
    say(s, resume) -> {
      Stdout.print(s)
      resume(())
    }
  }

fn main() : Unit / Stdout {
  let add: Curried = (a: Int) => {
    Log.say("add")
    (b: Int) => a + b
  }
  let later: () -> ((Int) -> Int) / Log = () => pick()
  let total = logged(() => pick()(1) + positive(2) + run(add, Maker { make: add }) + later()(5))
  let kept = hold(() => 7)
  Stdout.print("total=#{total} kept=#{kept()}")
}
