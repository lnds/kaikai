# Two effects share an op name but neither is ever backed by a handler or
# a default block: there is no evidence for a perform to divert to, so this
# is dead code, not an op-name collision. Back one sibling and the other's
# perform becomes the collision the neighbouring `collision_*` fixtures pin.
effect LogA { write(n: Int) : Unit }
effect LogB { write(s: String) : Unit }

fn use_a() : Int / LogA = { LogA.write(1); 10 }
fn use_b() : Int / LogB = { LogB.write("hi"); 20 }

fn main() : Unit / Stdout = Stdout.print("ok")
