# An effect alias names labels, and a label may carry type arguments:
# after the first label, at the head, and through another alias.

effect Emit[T] {
  emit(x: T) : Unit
}

type Tail = Stdout + Emit[Option[String]]

type Head = Emit[Int] + Stdout

type Both = Tail + Emit[Int]

fn tail() : Unit / Tail = {
  Emit.emit(Some("tail"))
  Stdout.print("tail done")
}

fn head() : Unit / Head = {
  Emit.emit(7)
  Stdout.print("head done")
}

fn both() : Unit / Both = {
  tail()
  head()
}

fn shown(o: Option[String]) : String = match o {
  Some(s) -> s
  None    -> "none"
}

fn main() : Int / Stdout = {
  handle {
    handle { both() } with Emit[Int] {
      emit(x, resume) -> { Stdout.print("int #{int_to_string(x)}"); resume(()) }
    }
  } with Emit[Option[String]] {
    emit(x, resume) -> { Stdout.print("opt #{shown(x)}"); resume(()) }
  }
  0
}
