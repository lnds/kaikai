effect Audit {
  record(msg: String) : Unit
  default {
    record(msg, resume) -> {
      println("root audit: #{msg}")
      resume(())
    }
  }
}

effect Shout {
  shout(msg: String) : Unit
  quiet(msg: String) : Unit
  default {
    shout(msg, resume) -> {
      Audit.record(msg)
      resume(())
    }
    quiet(msg, resume) -> resume(())
  }
}

fn main() : Unit / Audit + Stdout {
  handle {
    handle {
      Shout.shout("hello")
    } with Shout {
      quiet(msg, resume) -> resume(())
    }
  } with Audit {
    record(msg, resume) -> {
      println("captured audit: #{msg}")
      resume(())
    }
  }
}
