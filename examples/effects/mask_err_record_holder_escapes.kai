effect Sink {
  put(s: S) : Unit
}
type S = { a: Array[Int] }

fn go() : Unit / Sink {
  let a = array_make(2, 0)
  let s = S { a: a }
  Sink.put(s)
  a[0] := 9
}

fn main() : Unit / Mutable + Console = {
  let cell = Mutable.ref_make(array_make(2, 0))
  handle { go() } with Sink {
    put(s, resume) -> {
      Mutable.ref_set(cell, s.a)
      resume(())
    }
  }
  print(int_to_string(Mutable.ref_get(cell)[0]))
}
