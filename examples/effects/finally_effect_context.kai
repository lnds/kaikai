# Pins the evidence-context rule: a `finally` that performs an effect
# runs against the handlers that were live when its handler was
# INSTALLED, not those at the jump site.
#
# `Audit` is handled outermost. The discard longjmps from inside the
# `Bracket` scope out to the `Fault` handler, tearing down every frame
# between them — so a cleanup that dispatched from the jump site would
# walk dead evidence. Running it at the installation point makes
# `Audit.note` resolve to the live outer handler instead.

effect Fault {
  boom(m: String) : Int
}

effect Audit {
  note(s: String) : Unit
}

effect Bracket {
  unused() : Unit
}

fn work() : Int / Bracket + Fault = Fault.boom("x")

fn main() : Int / Stdout = {
  let r = handle {
    handle {
      handle {
        work()
      } with Bracket {
        initially { 7 }
        finally   { Audit.note("released #{int_to_string(state)}") }
        unused(resume) -> resume(())
        return(x)      -> x
      }
    } with Fault {
      boom(_m, _resume) -> -1
      return(x)         -> x
    }
  } with Audit {
    note(s, resume) -> { Stdout.print("audit: #{s}"); resume(()) }
    return(x)       -> x
  }
  Stdout.print("ctx r=#{int_to_string(r)}")
  0
}
