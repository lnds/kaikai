effect E {
  e1() : Int
  e2() : Int
  default {
    e2(resume) -> {
      let r = handle {
        F.f1() + F.f2()
      } with F {
        f2(resume) -> resume(5)
      }
      resume(r)
    }
  }
}

effect F {
  f1() : Int
  f2() : Int
  default {
    f1(resume) -> resume(10)
    f2(resume) -> {
      let r = handle {
        E.e1()
      } with E {
        e1(resume) -> resume(7)
        e2(resume) -> resume(8)
      }
      resume(r)
    }
  }
}

fn main() : Int / Stdout {
  let r = handle {
    E.e2()
  } with E {
    e1(resume) -> resume(0)
  }
  Stdout.print(int_to_string(r))
  0
}
