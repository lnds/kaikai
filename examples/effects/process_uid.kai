# Process.uid is the effective uid of the running process: the uid a
# Unix-socket server reads of this same process connecting to itself,
# and an op a handler can answer in its place.

import net.unix
import os.process

fn peer_of(l: Listener, path: String) : Result[Int, String] / NetUnix =
  match NetUnix.connect(path) {
    Err(e) -> Err(e)
    Ok(c)  -> {
      let seen = match NetUnix.accept(l) {
        Err(e) -> Err(e)
        Ok(s)  -> {
          let uid = NetUnix.peer_uid(s)
          NetUnix.close(s)
          uid
        }
      }
      NetUnix.close(c)
      seen
    }
  }

fn peer_of_self(path: String) : Result[Int, String] / NetUnix =
  match listen(path, owner_only) {
    Err(e) -> Err(e)
    Ok(l)  -> {
      let seen = peer_of(l, path)
      NetUnix.close_listener(l)
      seen
    }
  }

fn as_user(uid: Int) : Int =
  handle { process.uid() } with Process { uid(resume) -> resume(uid) }

fn verdict(label: String, ok: Bool) : Int / Stdout =
  if ok { Stdout.print("#{label}: ok"); 0 }
  else  { Stdout.print("#{label}: FAIL"); 1 }

fn main() : Int / NetUnix + Process + Random + Stdout = {
  let me = process.uid()
  let peer = peer_of_self("/tmp/kai-uid-#{Random.int_range(0, 1000000000)}.sock")
  let real = verdict("uid is not negative", me >= 0)
  let same = verdict("uid is the same on a second call", Process.uid() == me)
  let seen = verdict("uid is what peer_uid reads of this process", peer == Ok(me))
  let over = verdict("a handler answers uid in the runtime's place", as_user(me + 4242) == me + 4242)
  real + same + seen + over
}
