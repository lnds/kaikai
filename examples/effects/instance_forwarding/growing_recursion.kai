# A recursion whose instance grows without end still compiles and terminates.

effect Box[t] {
  get() : t
}

fn seeded[a, e](body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  handle {
    body()
  } with Box[Option[a]] {
    get(resume) -> resume(match w {
      [x, ..._] -> Some(x)
      [] -> None
    })
  }

fn grow[a, e](n: Int, w: [a], body: () -> String / Box[Option[a]] + e) : String / e =
  if n == 0 { seeded(body, w) } else { grow(n - 1, [w], () => "leaf") }

fn main() : Unit / Console {
  println(grow(0, ["w"], () => "top"))
  println(grow(3, ["w"], () => "top"))
}
