# A handler reached through a forwarder answers only its own instance.

effect Box[t] {
  get() : t
}

fn with_box[t, r, e](init: t, body: () -> r / Box[t] + e) : r / e =
  handle {
    body()
  } with Box[t] {
    get(resume) -> resume(init)
  }

fn seeded[a, e](body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  handle {
    body()
  } with Box[Option[a]] {
    get(resume) -> resume(match w {
      [x, ..._] -> Some(x)
      [] -> None
    })
  }

fn ask_int() : String / Box[Option[Int]] {
  let a: Option[Int] = Box.get()
  match a {
    Some(n) -> "int #{n + 1}"
    None -> "int none"
  }
}

fn flipped[a, e](w: [a], body: () -> String / Box[Option[a]] + e) : String / e =
  seeded(body, w)

fn app() : String / Box[Option[Int]] = flipped(["w"], ask_int)

fn app_lambda() : String / Box[Option[Int]] {
  let w: [String] = []
  seeded(() => ask_int(), w)
}

fn main() : Unit / Console {
  let n: Option[Int] = Some(7)
  println(with_box(n, app))
  println(with_box(n, app_lambda))
}
