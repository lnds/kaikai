# The instance follows the type argument through any number of calls.

effect Box[t] {
  get() : t
}

fn with_box[t, r, e](init: t, body: () -> r / Box[t] + e) : r / e =
  handle {
    body()
  } with Box[t] {
    get(resume) -> resume(init)
  }

fn seeded[a, e](body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  handle {
    body()
  } with Box[Option[a]] {
    get(resume) -> resume(match w {
      [x, ..._] -> Some(x)
      [] -> None
    })
  }

fn ask_int() : String / Box[Option[Int]] {
  let a: Option[Int] = Box.get()
  match a {
    Some(n) -> "int #{n + 1}"
    None -> "int none"
  }
}

fn forward[a, e](body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  seeded(body, w)

fn twice[b, e](body: () -> String / Box[Option[b]] + e, w: [b]) : String / e =
  forward(body, w)

fn thrice[c, e](body: () -> String / Box[Option[c]] + e, w: [c]) : String / e =
  twice(body, w)

fn nested[a, e](body: () -> String / Box[Option[a]] + e, w: [a]) : String / e {
  let go = () => seeded(body, w)
  go()
}

fn again[a, e](n: Int, body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  if n == 0 { seeded(body, w) } else { again(n - 1, body, w) }

fn ping[a, e](n: Int, body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  if n == 0 { seeded(body, w) } else { pong(n - 1, body, w) }

fn pong[a, e](n: Int, body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  ping(n, body, w)

fn app() : Unit / Console + Box[Option[Int]] {
  println(forward(ask_int, ["w"]))
  println(thrice(ask_int, ["w"]))
  println(nested(ask_int, ["w"]))
  println(again(3, ask_int, ["w"]))
  println(ping(3, ask_int, ["w"]))
  println(thrice(ask_int, [1]))
}

fn main() : Unit / Console {
  let n: Option[Int] = Some(7)
  with_box(n, app)
}
