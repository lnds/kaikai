pub effect Box[t] {
  get() : t
}

#[doc("Run `body` with a `Box` that answers from the head of `w`.")]
pub fn seeded[a, e](body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  handle {
    body()
  } with Box[Option[a]] {
    get(resume) -> resume(match w {
      [x, ..._] -> Some(x)
      [] -> None
    })
  }

#[doc("`seeded` behind one more call.")]
pub fn forward[a, e](body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  seeded(body, w)
