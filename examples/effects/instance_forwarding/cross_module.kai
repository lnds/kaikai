# The instance follows the type argument across module boundaries.

import boxes.{Box, seeded, forward}

fn with_box[t, r, e](init: t, body: () -> r / Box[t] + e) : r / e =
  handle {
    body()
  } with Box[t] {
    get(resume) -> resume(init)
  }

fn ask_int() : String / Box[Option[Int]] {
  let a: Option[Int] = Box.get()
  match a {
    Some(n) -> "int #{n + 1}"
    None -> "int none"
  }
}

fn outer[b, e](w: [b], body: () -> String / Box[Option[b]] + e) : String / e =
  forward(body, w)

fn app() : Unit / Console + Box[Option[Int]] {
  println(forward(ask_int, ["w"]))
  println(outer(["w"], ask_int))
  let f = seeded
  println(f(ask_int, ["w"]))
}

fn main() : Unit / Console {
  let n: Option[Int] = Some(7)
  with_box(n, app)
}
