# An instance named by an implicit type parameter is specialised like a declared one.

effect Box[t] {
  get() : t
}

fn with_box[t, r, e](init: t, body: () -> r / Box[t] + e) : r / e =
  handle {
    body()
  } with Box[t] {
    get(resume) -> resume(init)
  }

fn seeded(body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  handle {
    body()
  } with Box[Option[a]] {
    get(resume) -> resume(match w {
      [x, ..._] -> Some(x)
      [] -> None
    })
  }

fn ask_int() : String / Box[Option[Int]] {
  let a: Option[Int] = Box.get()
  match a {
    Some(n) -> "int #{n + 1}"
    None -> "int none"
  }
}

fn forward(body: () -> String / Box[Option[a]] + e, w: [a]) : String / e = seeded(body, w)

fn app() : Unit / Console + Box[Option[Int]] {
  println(seeded(ask_int, ["w"]))
  println(forward(ask_int, ["w"]))
}

fn main() : Unit / Console {
  let n: Option[Int] = Some(7)
  with_box(n, app)
}
