# A generic handed over as a value keeps the instance it was referenced at.

effect Box[t] {
  get() : t
}

fn with_box[t, r, e](init: t, body: () -> r / Box[t] + e) : r / e =
  handle {
    body()
  } with Box[t] {
    get(resume) -> resume(init)
  }

fn seeded[a, e](body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  handle {
    body()
  } with Box[Option[a]] {
    get(resume) -> resume(match w {
      [x, ..._] -> Some(x)
      [] -> None
    })
  }

fn ask_int() : String / Box[Option[Int]] {
  let a: Option[Int] = Box.get()
  match a {
    Some(n) -> "int #{n + 1}"
    None -> "int none"
  }
}

fn apply2[x, y, r, e](f: (x, y) -> r / e, a: x, b: y) : r / e = f(a, b)

fn bound() : String / Box[Option[Int]] {
  let f = seeded
  f(ask_int, ["w"])
}

fn passed() : String / Box[Option[Int]] = apply2(seeded, ask_int, ["w"])

fn bound_generic[a, e](body: () -> String / Box[Option[a]] + e, w: [a]) : String / e {
  let f = seeded
  f(body, w)
}

fn passed_generic[a, e](body: () -> String / Box[Option[a]] + e, w: [a]) : String / e =
  apply2(seeded, body, w)

fn app() : Unit / Console + Box[Option[Int]] {
  println(bound())
  println(passed())
  println(bound_generic(ask_int, ["w"]))
  println(passed_generic(ask_int, ["w"]))
  println(apply2(passed_generic, ask_int, ["w"]))
}

fn main() : Unit / Console {
  let n: Option[Int] = Some(7)
  with_box(n, app)
}
