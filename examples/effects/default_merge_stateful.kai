effect Tick {
  tick() : Int
  bump() : Unit
  default {
    tick(resume) -> resume(7)
  }
}

fn work() : Int / Tick {
  Tick.bump()
  Tick.bump()
  Tick.tick()
}

fn main() : Int / Stdout {
  let r = handle {
    work()
  } with Tick(0) {
    bump(resume) -> resume((), state + 1)
    return(x) -> x + state
  }
  Stdout.print("r=#{int_to_string(r)}")
  0
}
