# Two handlers of one effect list their clauses in different orders; each
# perform must reach the clause for its own op under either handler.

effect Pair {
  first() : Int
  second() : Int
}

fn probe() : Unit / Pair + Stdout = {
  let a = Pair.first()
  let b = Pair.second()
  Stdout.print("first=#{a} second=#{b}")
}

fn main() : Int / Stdout = {
  handle { probe() } with Pair {
    first(resume)  -> resume(1)
    second(resume) -> resume(2)
  }
  handle { probe() } with Pair {
    second(resume) -> resume(20)
    first(resume)  -> resume(10)
  }
  0
}
