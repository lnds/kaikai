# A linked peer that ends cancels a fiber parked in `receive`: the
# cancel wakes it instead of leaving it parked.

import actor
import spawn

fn child(parent: Pid[String]) : Unit / Actor[String] + Link + Cancel = {
  Link.link(parent)
  Cancel.raise()
}

fn supervisor() : Unit / Actor[String] + Spawn + Console + Link + Cancel = {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { child(me) })
  Stdout.print("got: " ++ Actor.receive())
}

fn main() : Int / Console + Spawn + Link + Cancel = {
  handle {
    nursery { let _ = spawn.spawn(() => with_mailbox { supervisor() }) }
  } with Cancel {
    raise(resume) -> ()
  }
  Stdout.print("done")
  0
}
