# A call spelled with `|>` raises the callee's row on the caller, like
# an ordinary call. `bare`, `called` and `extra` declare no row but pipe
# into a `Stdout` function, so each is rejected.

fn say(n: Int) : Unit / Stdout = Stdout.print("n=#{n}")
fn say2(n: Int, m: Int) : Unit / Stdout = Stdout.print("n=#{n} m=#{m}")

fn bare(n: Int) : Unit = n |> say
fn called(n: Int) : Unit = n |> say()
fn extra(n: Int) : Unit = n |> say2(2)

fn main() : Unit / Stdout = {
  bare(1)
  called(2)
  extra(3)
}
