effect St[s] {
  get() : s
  put(v: s) : Unit
  default {
    put(v, resume) -> {
      Stdout.print("put")
      resume(())
    }
  }
}

fn main() : Int / Stdout {
  let r = handle {
    St.put(1)
    St.get()
  } with St[Int] {
    get(resume) -> resume(41)
  }
  Stdout.print(int_to_string(r))
  0
}
