# An enclosing `state` that only a handler's clauses read is a used
# binding, and a closure around the handler captures it.

effect Res { acquire() : Int }

fn read_in_return() : Int / Mutable = {
  let state = array_make(1, 0)
  handle {
    Res.acquire()
  } with Res(5) {
    acquire(resume) -> resume(11)
    return(x)       -> x + state[0]
  }
}

fn read_in_stateless_return() : Int = {
  let state = 30
  handle {
    Res.acquire()
  } with Res {
    acquire(resume) -> resume(1)
    return(x)       -> x + state
  }
}

fn captured_by_lambda_in_return() : Int / Mutable = {
  let state = array_make(1, 100)
  let run = (u: Int) => handle {
    Res.acquire()
  } with Res(5) {
    acquire(resume) -> resume(11)
    return(x)       -> x + state[0] + u
  }
  run(0)
}

fn captured_by_lambda_in_op_clause() : Int / Mutable = {
  let state = array_make(1, 200)
  let run = (u: Int) => handle {
    Res.acquire()
  } with Res(5) {
    acquire(resume) -> resume(state[0] + u)
  }
  run(1)
}

fn main() : Unit / Stdout + Mutable = {
  let state = array_make(1, 7)
  let in_main = handle {
    Res.acquire()
  } with Res(5) {
    acquire(resume) -> resume(11)
    return(x)       -> x + state[0]
  }
  Stdout.print("read_in_main_return: #{in_main}")
  Stdout.print("read_in_return: #{read_in_return()}")
  Stdout.print("read_in_stateless_return: #{read_in_stateless_return()}")
  Stdout.print("captured_by_lambda_in_return: #{captured_by_lambda_in_return()}")
  Stdout.print("captured_by_lambda_in_op_clause: #{captured_by_lambda_in_op_clause()}")
}
