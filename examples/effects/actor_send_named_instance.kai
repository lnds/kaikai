# `m.send` on a named `Actor[Reply]` instance takes its message type
# from each call, so one instance sends `String` and `Int` alike.

import actor

type Reply = | Ack

fn forward_all(m: Actor[Reply], words: Pid[String], nums: Pid[Int]) : Unit = {
  m.send(words, "hello")
  m.send(nums, 42)
}

fn main() : Unit / Spawn + Stdout = with_mailbox {
  let words: Pid[String] = Actor.self()
  let nums = spawn_actor(() => {
    let n: Int = Actor.receive()
    Actor.send(words, "got #{n}")
  })
  let acked = handle {
    forward_all(m, words, nums)
    true
  } with Actor[Reply](0) as m {
    self(resume)                -> panic("the forwarding mailbox has no Pid")
    send(pid, msg, resume)      -> { Actor.send(pid, msg); resume((), state + 1) }
    receive(resume)             -> resume(Ack, state)
    receive_timeout(ns, resume) -> resume(None, state)
    return(r)                   -> state == 2
  }
  Stdout.print(Actor.receive())
  Stdout.print(Actor.receive())
  Stdout.print("forwarded: #{acked}")
}
