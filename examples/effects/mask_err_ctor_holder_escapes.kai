effect Sink {
  put(o: Option[Array[Int]]) : Unit
}

fn go() : Unit / Sink {
  let a = array_make(2, 0)
  let s = Some(a)
  Sink.put(s)
  a[0] := 9
}

fn main() : Unit / Mutable + Console = {
  let cell = Mutable.ref_make(array_make(2, 0))
  handle { go() } with Sink {
    put(o, resume) -> {
      match o { Some(x) -> Mutable.ref_set(cell, x)  None -> () }
      resume(())
    }
  }
  print(int_to_string(Mutable.ref_get(cell)[0]))
}
