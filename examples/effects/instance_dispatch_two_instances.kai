# One row carrying two instances of a user effect, `Box[Int] + Box[String]`:
# each op reaches the handler of the instance it was typed at, through a
# helper whose row names one instance, through a perform pinned by its
# result type, and through a generic installer specialised per instance.

effect Box[T] {
  peek() : T
}

fn peek_int() : Int / Box[Int] = Box.peek()

fn peek_str() : String / Box[String] = Box.peek()

fn via_helpers() : String / Box[Int] + Box[String] = "#{peek_str()}#{peek_int()}"

fn via_annotation() : String / Box[Int] + Box[String] = {
  let n: Int = Box.peek()
  let s: String = Box.peek()
  "#{s}#{n}"
}

fn with_box[T, R, e](v: T, body: () -> R / Box[T] + e) : R / e =
  handle { body() } with Box[T] {
    peek(resume) -> resume(v)
  }

fn main() : Unit / Stdout = {
  let lexical = handle {
    handle { via_helpers() } with Box[String] {
      peek(resume) -> resume("s=")
    }
  } with Box[Int] {
    peek(resume) -> resume(7)
  }
  Stdout.print(lexical)
  let installed = with_box(8) {
    with_box("t=") { via_annotation() }
  }
  Stdout.print(installed)
}
