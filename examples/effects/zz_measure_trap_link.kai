import actor
import spawn

type Msg = Go | Stop

fn panicking_worker(parent: Pid[String]) : Unit / Actor[Msg] + Link {
  Link.link(parent)
  panic("boom")
}

fn trap_overseer() : Int / Actor[String] + Spawn + Link {
  let _ = set_trap_exit(true)
  let me = Actor.self()
  let _ = spawn_actor(() => panicking_worker(me))
  if Actor.receive() == "Trapped: boom" { 1 } else { 0 }
}

fn one() : Int / Spawn + Link + Cancel =
  nursery { k ->
    let f = k.spawn(() => with_mailbox { trap_overseer() })
    k.await(f)
  }

fn rounds(n: Int, acc: Int) : Int / Spawn + Link + Cancel =
  if n > 0 {
    let got = one()
    rounds(n - 1, acc + got)
  } else {
    acc
  }

fn main() : Unit / Spawn + Link + Cancel + Stdout {
  Stdout.print("trapped panics: #{rounds(100, 0)}")
}
