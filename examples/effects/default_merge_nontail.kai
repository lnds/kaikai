effect Step {
  step(n: Int) : Int
  default {
    step(n, resume) -> {
      let r = resume(n + 1)
      Stdout.print("after resume #{int_to_string(r)}")
      r
    }
  }
}

fn work() : Int / Step = Step.step(1) + Step.step(10)

fn main() : Int / Stdout {
  let r = handle {
    work()
  } with Step {
  }
  Stdout.print("got #{int_to_string(r)}")
  0
}
