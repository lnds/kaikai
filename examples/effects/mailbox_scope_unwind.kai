# A mailbox scope frees its mailbox however it ends: normally, under a
# handler that discards its continuation, and when its fiber is cancelled.
import actor
import spawn

effect Abort {
  abort() : Nothing
}

fn discarded() : Int = handle {
  with_mailbox { Abort.abort() }
} with Abort {
  abort(_k) -> 0
}

fn cancelled_actor() : Unit / Actor[Int] + Cancel = {
  let _ = Actor.self()
  Cancel.raise()
}

fn main() : Int / Spawn + Cancel + Console = {
  let a = with_mailbox { 1 }
  let b = discarded()
  handle {
    nursery {
      let _ = spawn_actor(cancelled_actor)
      ()
    }
  } with Cancel {
    raise(_k) -> ()
  }
  Stdout.print("normal=#{int_to_string(a)} discarded=#{int_to_string(b)}")
  0
}
