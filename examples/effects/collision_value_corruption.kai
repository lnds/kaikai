# A `var remaining` read inside the `tick` clause of an unrelated effect,
# while a State[[Int]] runner is live on the stack above it, reads its own
# cell: the clause carries the cell's handler id, so the read never binds
# the runner's State by op name.
effect Tick { tick() : Unit }

fn with_list[R, e](body: () -> R / e) : R / e = {
  handle { body() } with State[[Int]]([]) {
    get(resume)    -> resume(state)
    set(v, resume) -> resume((), v)
    return(x)      -> x
  }
}

fn main() : Unit / Stdout = {
  var remaining := 10
  with_list() {
    handle { Tick.tick() } with Tick {
      tick(resume) -> {
        Stdout.print("r=#{int_to_string(remaining)}")
        resume(())
      }
    }
  }
}
