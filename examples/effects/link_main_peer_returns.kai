# A linked peer that returns normally cancels a main that does not trap exits.

import actor
import spawn

fn child(parent: Pid[String]) : Unit / Actor[String] + Link = {
  Link.link(parent)
}

fn wait_for_peer() : Unit / Actor[String] + Spawn + Console + Link = {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { child(me) })
  Stdout.print("got: " ++ Actor.receive())
}

fn main() : Int / Spawn + Console + Link + Cancel = {
  with_mailbox {
    handle {
      wait_for_peer()
    } with Cancel {
      raise(resume) -> Stdout.print("main cancelled")
    }
  }
  0
}
