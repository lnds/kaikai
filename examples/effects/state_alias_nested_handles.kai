# Nested stateful handles each read their own `state` in their return
# clause, and a later `let state` of a third type reads neither.

effect Inner { tick() : Int }
effect Outer { scale(r: Real) : Real }
fn main() : Int / Stdout = {
  let g = handle {
    let i = handle { Inner.tick() + Inner.tick() } with Inner(5) {
      tick(resume) -> resume(state, state + 1)
      return(v)    -> v * 10 + state
    }
    Outer.scale(int_to_real(i))
  } with Outer(0.5) {
    scale(r, resume) -> resume(r * state, state + r)
    return(v)        -> v + state
  }
  let state = "outer"
  Stdout.print("g=#{g} s=#{state}")
  0
}
