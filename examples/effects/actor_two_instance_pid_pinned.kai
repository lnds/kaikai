import actor

type Req = Ask(Int, Pid[Resp]) | Stop

type Resp = Answer(Int)

fn serve() : Unit / Actor[Req] {
  match Actor.receive() {
    Ask(n, from) -> {
      Actor.send(from, Answer(n * 2))
      serve()
    }
    Stop -> ()
  }
}

fn ask(srv: Pid[Req]) : Unit / Actor[Resp] + Stdout {
  Actor.send(srv, Ask(21, Actor.self()))
  match Actor.receive() {
    Answer(v) -> println("answer #{v}")
  }
  Actor.send(srv, Stop)
}

fn main() : Int / Spawn + Stdout = with_mailbox {
  let srv: Pid[Req] = spawn_actor(() => serve())
  ask(srv)
  0
}
