effect Acc[t] {
  put(x: t) : Unit
  other() : Unit
  default {
    put(x, resume) -> {
      Stdout.print("put")
      resume(())
    }
  }
}

effect Y {
  y() : Int
  default {
    y(resume) -> {
      Acc.put(7)
      resume(1)
    }
  }
}

fn main() : Int / Stdout {
  Stdout.print(int_to_string(Y.y()))
  0
}
