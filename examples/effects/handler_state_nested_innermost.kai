effect Cell { get() : Int }
effect Other { poke() : Int }

fn main() : Unit / Stdout = {
  let r = handle {
    Other.poke()
  } with Other(100) {
    poke(resume) -> {
      let inner = handle { Cell.get() } with Cell(10) {
        get(resume2) -> resume2(state + 1)
      }
      resume(inner + state)
    }
  }
  Stdout.print(int_to_string(r))
}
