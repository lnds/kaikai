# Header, fold, footer: the footer appends to the builder the fold
# returned. The error must point at the footer, not at the append inside
# the fold's lambda, where `Mutable` first entered the row.
import string_builder as sb
import core.list

fn table(rows: [String]) : String {
  let head = sb.append(sb.new(), "rows:")
  let body = list.foldl(rows, head, (acc, r) => sb.append(acc, r))
  sb.build(sb.append(body, "end"))
}

fn main() : Unit / Stdout = println(table(["a", "b"]))
