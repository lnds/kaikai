# Actor.receive() parks on an empty mailbox; a sender wakes it.
#
# main installs a String mailbox via with_mailbox. It spawns a worker that
# installs its OWN mailbox (a capability does not cross a spawn) and sends two
# messages to main's Pid; main then calls Actor.receive() on its own (currently
# empty) mailbox. Receiving on the empty mailbox parks main on the per-mailbox
# recv_waiter chain; the worker's first send wakes it.
#
# Pinned to KAI_THREADS=1 (sibling .env). Nothing orders the worker's
# "done" against main's two receives, so above one thread the two fibers
# print in either order and only the golden's line SEQUENCE varies — the
# messages themselves are unaffected. The one-thread rotation is what makes
# the golden byte-exact; the parking behaviour under test is not.

import spawn
import actor

fn worker(target: Pid[String]) : Unit / Actor[String] + Console = {
  Stdout.print("worker: sending hello")
  Actor.send(target, "hello")
  Stdout.print("worker: sending world")
  Actor.send(target, "world")
  Stdout.print("worker: done")
}

fn run() : Unit / Actor[String] + Spawn + Console = {
  let me = Actor.self()
  # The worker installs its own Actor handler (with_mailbox): a capability does
  # not cross a spawn, so the worker's Actor row is satisfied inside its own
  # fiber. Its sends still target `me` — a Pid value captured before the spawn.
  let f = spawn.spawn(() => with_mailbox { worker(me) })
  Stdout.print("main: receive 1 = " ++ Actor.receive())
  Stdout.print("main: receive 2 = " ++ Actor.receive())
  spawn.await(f)
}

fn main() : Int / Console + Spawn = {
  with_mailbox { run() }
  0
}
