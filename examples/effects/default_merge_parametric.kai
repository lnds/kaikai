effect Cell[t] {
  put(v: t) : Unit
  size() : Int
  default {
    size(resume) -> resume(3)
  }
}

fn work() : Int / Cell[String] {
  Cell.put("a")
  Cell.size()
}

fn main() : Int / Stdout {
  let r = handle {
    work()
  } with Cell[String] {
    put(v, resume) -> {
      Stdout.print("put #{v}")
      resume(())
    }
  }
  Stdout.print("r=#{int_to_string(r)}")
  0
}
