# `resume` returns the handle's type, after `return`: here the op yields
# an Int, `return` turns the body's Int into a String, and the clause
# receives and extends that String.

effect Ask { number() : Int }

fn main() : Unit / Stdout = {
  let s = handle { Ask.number() + 1 } with Ask {
    number(resume) -> {
      let r = resume(20)
      "clause saw [#{r}]"
    }
    return(x) -> "ret #{x}"
  }
  Stdout.print(s)
}
