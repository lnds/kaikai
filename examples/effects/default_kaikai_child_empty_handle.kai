import spawn

effect Greet {
  hello(name: String) : Unit
  default {
    hello(name, resume) -> {
      println("hello #{name}")
      resume(())
    }
  }
}

fn worker() : Unit / Stdout = handle {
  Greet.hello("fiber")
} with Greet {
}

fn main() : Int / Spawn + Stdout {
  nursery { n ->
    let f = n.spawn(worker)
    n.await(f)
  }
  0
}
