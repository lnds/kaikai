type Box = { arr: Array[Int] }
type Slot = Full(Array[Int]) | Empty

fn fill(a: Array[Int]) : Array[Int] / Mutable = {
  a[0] := 7
  a
}

fn wrap(a: Array[Int]) : Box / Mutable = {
  a[0] := 8
  Box { arr: a }
}

fn slot(a: Array[Int]) : Slot / Mutable = {
  a[0] := 9
  Full(a)
}

fn through_return() : Int {
  let a = array_make(2, 0)
  let b = fill(a)
  b[1] := 3
  a[0] + b[1]
}

fn through_record() : Int {
  let b = wrap(array_make(2, 0))
  b.arr[0] + b.arr[1]
}

fn through_sum() : Int = match slot(array_make(2, 0)) {
  Full(a) -> a[0] + a[1]
  Empty   -> 0
}

fn main() : Unit / Console = {
  print(int_to_string(through_return()))
  print(int_to_string(through_record()))
  print(int_to_string(through_sum()))
}
