# A cancel delivered inside `receive_timeout` leaves the mailbox waiter
# chain and releases the pid: a second `receive_timeout` from the Cancel
# clause on the same mailbox times out normally.

import actor
import spawn
import time

fn serve() : Int / Actor[String] + Stdout + Clock = {
  let first = handle {
    receive_timeout(seconds(60))
  } with Cancel {
    raise(resume) -> { Stdout.print("cancelled"); receive_timeout(millis(20)) }
  }
  match first {
    None -> 1
    Some(_) -> 0
  }
}

fn main() : Int / Spawn + Stdout + Clock = {
  let r = nursery { n ->
    let w = n.spawn(() => with_mailbox { serve() })
    sleep(millis(50))
    n.cancel(w)
    0
  }
  Stdout.print("joined")
  r
}
