# Closing a nested mailbox hands the fiber back its outer one, so a
# monitor placed afterwards still delivers into the outer mailbox.

import actor

fn worker() : Unit / Actor[Nothing] = ()

fn main() : Int / Spawn + Monitor + Console = {
  with_mailbox {
    let _ = with_mailbox { 0 }
    let w = spawn_actor(worker)
    let _ = Monitor.monitor(w)
    let dead = Actor.receive()
    let _ = dead
    Stdout.print("outer mailbox still receives")
    0
  }
}
