import actor

type Msg = Tick(Int) | Stop

fn on_tick(f: (Int) -> Unit / Stdout, n: Int) : Unit / Actor[Msg] + Stdout = { f(n); serve(f) }

fn serve(f: (Int) -> Unit / Stdout) : Unit / Actor[Msg] + Stdout = match Actor.receive() {
  Tick(k) -> if k >= 0 { on_tick(f, k) } else { () }
  Stop    -> ()
}

fn feed(me: Pid[Msg], i: Int, n: Int) : Unit / Actor[Msg] + Stdout =
  if i >= n { Actor.send(me, Stop) } else { Actor.send(me, Tick(i)); feed(me, i + 1, n) }

fn main() : Unit / Spawn + Stdout = with_mailbox {
  feed(Actor.self(), 0, 2000000)
  serve(k => ())
  println("done")
}
