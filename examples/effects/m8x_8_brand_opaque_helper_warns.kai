# Where brand tracking ends, it says so. `stash` does not return its
# parameter unchanged, so the brand cannot be followed past the call.
# Rather than dropping the guarantee silently, the checker warns and
# names the nursery the fiber came from. The program is legal — the
# await below is same-nursery — so this compiles and runs.

import spawn

fn task() : Int = 7

fn stash[T](x: T) : [T] = [x]

fn main() : Int / Console + Spawn {
  let r = nursery { n ->
    let f = n.spawn(task)
    let boxed = stash(f)
    n.await(f) + length(boxed)
  }
  Stdout.print(int_to_string(r))
  0
}
