# Where the code after a non-tail `resume` runs. On a normal exit: the
# body, `finally`, `return`, then the clause's tail. On an abandon: the
# unwind runs `finally`, and the tail gets the abandoned value as is.

effect Ask {
  number() : Int
  stop() : Int
}

fn main() : Unit / Stdout = {
  let c = handle { let n = Ask.number(); Stdout.print("body n=#{n}"); n } with Ask {
    finally        { Stdout.print("finally") }
    number(resume) -> { let r = resume(1); Stdout.print("tail r=#{r}"); r * 10 }
    stop(resume)   -> 0
    return(x)      -> { Stdout.print("return x=#{x}"); x + 1 }
  }
  Stdout.print("c=#{c}")
  let d = handle { let n = Ask.number(); let m = Ask.stop(); n + m } with Ask {
    finally        { Stdout.print("finally on abandon") }
    number(resume) -> { let r = resume(1); Stdout.print("tail r=#{r}"); r * 10 }
    stop(resume)   -> 7
    return(x)      -> { Stdout.print("unreached return"); x }
  }
  Stdout.print("d=#{d}")
}
