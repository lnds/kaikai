# `pipe_errs` pipes the child's stdout and stderr as two separate
# streams; the older starters keep stderr inherited, so `read_stderr`
# on their children is an Err. The parent prints nothing before the
# forks (see process_basic.kai on the fork/stdio-buffer trap).
import os.process

fn drain_err(c: Child, acc: String) : Result[String, String] / Process =
  match process.read_stderr(c) {
    Err(e) -> Err(e)
    Ok(s)  ->
      if string_length(s) == 0 { Ok(acc) }
      else { drain_err(c, string_concat(acc, s)) }
  }

fn check_split() : String / Process =
  match process.pipe_errs("/bin/sh", ["-c", "echo out; echo boom >&2; exit 3"]) {
    Err(e) -> "start FAIL: #{e}"
    Ok(c)  -> match process.read_all(c) {
      Err(e)  -> "stdout FAIL: #{e}"
      Ok(out) -> match drain_err(c, "") {
        Err(e)  -> "stderr FAIL: #{e}"
        Ok(err) -> match process.wait(c) {
          Ok(Exited(3)) ->
            if out == "out\n" and err == "boom\n" { "split ok: out, boom, Exited(3)" }
            else { "split MISMATCH: stdout=#{out} stderr=#{err}" }
          Ok(_)  -> "wait FAIL: expected Exited(3)"
          Err(e) -> "wait FAIL: #{e}"
        }
      }
    }
  }

fn check_inherited() : String / Process =
  match process.pipe_from("/bin/echo", ["inherited"]) {
    Err(e) -> "start FAIL: #{e}"
    Ok(c)  -> {
      let r = process.read_stderr(c)
      let _o = process.read_all(c)
      let _w = process.wait(c)
      match r {
        Err(e) -> "pipe_from: #{e}"
        Ok(_)  -> "pipe_from: stderr unexpectedly piped"
      }
    }
  }

fn main() : Int / Process + Stdout {
  let split = check_split()
  let inherited = check_inherited()
  Stdout.print(split)
  Stdout.print(inherited)
  if split == "split ok: out, boom, Exited(3)" { 0 } else { 1 }
}
