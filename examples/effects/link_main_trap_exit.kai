# A main that traps exits receives each peer's end as a message instead of
# being cancelled: cancellation, normal return and a runtime trap.

import actor
import spawn

fn cancels(parent: Pid[String]) : Unit / Actor[String] + Link + Cancel = {
  Link.link(parent)
  Cancel.raise()
}

fn returns(parent: Pid[String]) : Unit / Actor[String] + Link = {
  Link.link(parent)
}

fn traps(parent: Pid[String]) : Unit / Actor[String] + Link = {
  Link.link(parent)
  panic("boom")
}

fn main() : Int / Spawn + Console + Link + Cancel = {
  with_mailbox {
    spawn.set_trap_exit(true)
    let me = Actor.self()
    let _ = spawn.spawn(() => with_mailbox { cancels(me) })
    Stdout.print("cancel: " ++ Actor.receive())
    let _ = spawn.spawn(() => with_mailbox { returns(me) })
    Stdout.print("return: " ++ Actor.receive())
    let _ = spawn.spawn(() => with_mailbox { traps(me) })
    Stdout.print("trap: " ++ Actor.receive())
    0
  }
}
