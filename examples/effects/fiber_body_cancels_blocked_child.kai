# An actor parked in `receive` with a plain child blocked forever: `main`
# returning cancels the actor, the cancel reaches the child, both unwind.

import actor

effect Lease {
  renew() : Unit
}

fn stuck(boss: Pid[String]) : Unit / Actor[String] + Stdout = handle {
  Actor.send(boss, "child ready")
  let _ = Actor.receive()
} with Lease {
  finally { Stdout.print("child released") }
  renew(resume) -> resume(())
}

fn server(boss: Pid[String]) : Unit / Actor[String] + Spawn + Stdout = handle {
  let _ = Spawn.spawn(() => with_mailbox { stuck(boss) })
  let _ = Actor.receive()
} with Lease {
  finally { Stdout.print("server released") }
  renew(resume) -> resume(())
}

fn run() : Unit / Actor[String] + Spawn + Stdout = {
  let boss = Actor.self()
  let _ = spawn_actor(() => server(boss))
  Stdout.print(Actor.receive())
}

fn main() : Int / Spawn + Stdout = {
  with_mailbox { run() }
  Stdout.print("main returning")
  0
}
