# issue #1565 — a stateful handler's magic aliases (`state`, `log`) must
# not capture an enclosing binding of the same name. Both clause bodies
# and the return clause see the enclosing `log` / `state` arrays here,
# not the handler's Int state slot.

effect Res { acquire() : Int }

fn shadowed_log() : Int / Stdout + Mutable = {
  let log = array_make(1, 0)
  let r = handle {
    Res.acquire()
  } with Res(3) {
    acquire(resume) -> resume(7)
    return(x)       -> { array_set(log, 0, 9); x }
  }
  Stdout.print("log: r=#{int_to_string(r)} log0=#{int_to_string(log[0])}")
  r
}

fn shadowed_state() : Int / Stdout + Mutable = {
  let state = array_make(1, 0)
  let r = handle {
    Res.acquire()
  } with Res(5) {
    acquire(resume) -> { array_set(state, 0, 4); resume(11) }
    return(x)       -> x + state[0]
  }
  Stdout.print("state: r=#{int_to_string(r)}")
  r
}

# No enclosing binding shadows the aliases here, so both still name the
# handler's state slot.
fn aliases_live() : Int / Stdout = {
  let r = handle {
    Res.acquire()
  } with Res(6) {
    acquire(resume) -> resume(state)
    return(x)       -> x + log
  }
  Stdout.print("live: r=#{int_to_string(r)}")
  r
}

# A `finally` thunk sees the same aliases as a clause, and the same
# precedence rule: the enclosing `log` array is what it writes to.
fn shadowed_in_finally() : Int / Stdout + Mutable = {
  let log = array_make(1, 0)
  let r = handle {
    Res.acquire()
  } with Res(2) {
    finally { array_set(log, 0, 8); () }
    acquire(resume) -> resume(3)
    return(x)       -> x
  }
  Stdout.print("finally: r=#{int_to_string(r)} log0=#{int_to_string(log[0])}")
  r
}

fn main() : Int / Stdout + Mutable = {
  let a = shadowed_log()
  let b = shadowed_state()
  let c = aliases_live()
  let d = shadowed_in_finally()
  Stdout.print("sum=#{int_to_string(a + b + c + d)}")
  0
}
