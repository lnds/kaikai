# A tail loop in an imported module, on a spawned fiber, that calls an
# effectful function each turn: it must run in constant stack.

import spawn
import ticker

fn main() : Int / Stdout + Spawn {
  let v = nursery {
    spawn.await(spawn.spawn(() => handle { ticker.spin(1000000, 0) } with ticker.Tick { next(n, resume) -> resume(n) }))
  }
  Stdout.print(int_to_string(v))
  0
}
