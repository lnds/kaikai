#[doc("One tick of work, handled by the caller.")]
pub effect Tick {
  next(n: Int) : Int
}

# Recursive so the call in `spin` stays a call and passes an evidence frame.
#[doc("Perform one tick after `k` nested calls.")]
pub fn depth(k: Int) : Int / Tick = if k == 0 { Tick.next(1) } else { depth(k - 1) }

#[doc("Tail loop of `n` turns, each calling a function that performs `Tick`.")]
pub fn spin(n: Int, acc: Int) : Int / Tick =
  if n == 0 { acc } else { spin(n - 1, acc + depth(1)) }
