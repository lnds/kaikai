import loop

fn shadowed() : Int = {
  var x := 1
  x := x + 10
  let inner = {
    var x := 100
    x := x + 1
    x
  }
  x + inner
}

fn param_shadow(x: Int) : Int = {
  var y := x
  let f = (x) => x + 1
  y := f(y)
  y
}

fn var_and_reader() : Int = handle {
  var n := 5
  n := n + env
  n + env
} with Reader[Int](42) as env {
  ask(resume) -> resume(state)
  return(x)   -> x
}

fn applied_closure() : Int = {
  var acc := 0
  let bump = (k) => { acc := acc + k }
  bump(3)
  bump(4)
  acc
}

fn written_in_loop() : Int = {
  var i := 0
  var sum := 0
  while { i < 5 } {
    sum := sum + i
    i := i + 1
  }
  sum
}

fn main() = {
  println(int_to_string(shadowed()))
  println(int_to_string(param_shadow(7)))
  println(int_to_string(var_and_reader()))
  println(int_to_string(applied_closure()))
  println(int_to_string(written_in_loop()))
}
