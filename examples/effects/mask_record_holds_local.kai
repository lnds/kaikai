type S = { a: Array[Byte] }

fn in_record(n: Int) : Int = {
  let a = array_make(n, bin_byte(0))
  a[0] := bin_byte(7)
  let s = S { a: a }
  0
}

fn in_tuple(n: Int) : Int = {
  let a = array_make(n, bin_byte(0))
  a[0] := bin_byte(7)
  let t = (a, 1)
  match t { (_, n2) -> n2 }
}

fn in_list(n: Int) : Int = {
  let a = array_make(n, bin_byte(0))
  a[0] := bin_byte(7)
  let xs = [a]
  list_length(xs)
}

fn read_back(n: Int) : Int = {
  let a = array_make(n, bin_byte(0))
  let s = S { a: a }
  a[1] := bin_byte(5)
  byte_to_int(s.a[1])
}

fn main() : Unit / Stdout =
  println("#{in_record(3)} #{in_tuple(3)} #{in_list(3)} #{read_back(3)}")
