# The ref `Monitor.monitor` hands back owns its own reference to the pid:
# dropping it, demonitoring with it, and receiving the down notice each
# release one reference, never the caller's.

import actor
import spawn

type Note = Ready(Pid[Note])

fn worker(boss: Pid[Note]) : Unit / Spawn + Console + Cancel = {
  with_mailbox {
    Actor.send(boss, Ready(Actor.self()))
  }
  Spawn.yield()
}

fn watch(p: Pid[Note]) : Unit / Monitor + Console = {
  with_mailbox {
    let r = Monitor.monitor(p)
    Monitor.demonitor(r)
    let _ = Monitor.monitor(p)
    let _ = Actor.receive()
    Stdout.print("down received")
  }
}

fn main() : Int / Spawn + Cancel + Monitor + Console = {
  with_mailbox {
    let me = Actor.self()
    let _ = spawn.spawn(() => worker(me))
    match Actor.receive() {
      Ready(p) -> watch(p)
    }
    Stdout.print("monitor ref released")
    0
  }
}
