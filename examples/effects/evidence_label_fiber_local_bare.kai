# The scheduler decides where a cancellation is delivered by comparing
# the evidence label against the literal "Cancel", so the fiber-local
# family must reach it unqualified even though every other effect's
# label carries its declaring module.

fn guarded() : Int / Cancel = 7

fn main() : Unit / Stdout = {
  let r = handle { guarded() } with Cancel { raise(resume) -> 99 }
  Stdout.print("cancel handler reachable: #{r}")
}
