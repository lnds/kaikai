# Case A — a `with Cancel` enclosing a nursery in the root fiber runs
# when a child crashes. The nursery's re-raise walks the handler stack
# like a direct `Cancel.raise()`, so the handler is reachable and the
# program continues past the handle instead of taking the runtime's
# no-survivors banner and exit 1.

import spawn

fn main() : Unit / Stdout + Spawn + Cancel {
  handle {
    nursery { n ->
      let r = n.spawn(() => Cancel.raise())
      n.await(r)
    }
  } with Cancel {
    raise(resume) -> println("main caught the re-raise")
  }
  println("main continues after the nursery")
}
