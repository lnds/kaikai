import actor

type Req = Ask(Int, Pid[Resp]) | Stop
type Resp = Answer(Int)

fn serve() : Unit / Actor[Req] + Actor[Resp] {
  match Actor.receive() {
    Ask(n, from) -> {
      Actor.send(from, Answer(n * 2))
      serve()
    }
    Stop -> ()
  }
}

fn exchange(body: () -> Unit / Actor[Req] + Actor[Resp]) : Unit / Spawn + Actor[Resp] + Stdout {
  let srv = spawn_actor(body)
  Actor.send(srv, Ask(21, Actor.self()))
  match Actor.receive() {
    Answer(v) -> println("answer #{v}")
  }
  Actor.send(srv, Stop)
}

fn main() : Int / Spawn + Stdout = with_mailbox {
  let body: () -> Unit / Actor[Req] + Actor[Resp] = () => serve()
  exchange(body)
  0
}
