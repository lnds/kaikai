# A perform of a scalar op feeds raw arithmetic, comparisons and negation
# in an effectful fn with raw parameters. Heap-boxed results (an Int past
# the immediate range, a Real) must be released at the border.

effect Src {
  big(k: Int) : Int
  ratio() : Real
  small(x: Int) : Int
}

fn mix(i: Int, acc: Int) : Int / Src =
  (acc + Src.big(i) - Src.small(i) * 3) % 1000000007

fn scaled(x: Real) : Real / Src = Src.ratio() * x + 0.5

fn above(i: Int, lim: Int) : Bool / Src = Src.small(i) > lim

fn neg(i: Int) : Int / Src = -Src.big(i)

fn run(i: Int, n: Int, acc: Int, hits: Int) : Int / Src =
  if i == n { acc + hits }
  else if above(i, 50) { run(i + 1, n, mix(i, acc), hits + 1) }
  else { run(i + 1, n, mix(i, acc), hits) }

fn main() : Int / Stdout = {
  let out = handle {
    let r = run(0, 100, 0, 0)
    let s = scaled(4.0)
    let m = neg(7)
    "run=#{r} scaled=#{s} neg=#{m}"
  } with Src {
    big(k, resume)   -> resume(9000000000000000000 + k)
    ratio(resume)    -> resume(2.25)
    small(x, resume) -> resume(x + 1)
  }
  Stdout.print(out)
  0
}
