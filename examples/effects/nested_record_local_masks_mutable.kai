# A record reaching an Array through two other user records, built
# locally and mutated through a `/ Mutable` callee, masks `Mutable` at
# the boundary: `build` declares no row.

type Cells = { items: Array[Int] }
type Shelf = { cells: Cells }
type Store = { shelf: Shelf }

fn poke(s: Store, v: Int) : Unit / Mutable {
  s.shelf.cells.items[0] := v
}

fn build(v: Int) : Store {
  let s = Store { shelf: Shelf { cells: Cells { items: array_make(1, 0) } } }
  poke(s, v)
  s
}

fn main() : Unit / Console = {
  let s = build(9)
  print(int_to_string(s.shelf.cells.items[0]))
}
