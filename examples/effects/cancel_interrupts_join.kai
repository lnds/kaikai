# A fiber parked in `n.await` or in a nursery join is woken by a cancel.
# A join cancels the scope's children and waits for them before the
# fiber unwinds; an await leaves the child's awaiter chain.

import spawn
import time

effect Lease {
  renew() : Unit
}

fn slow(who: String) : Int / Stdout + Clock = handle {
  sleep(seconds(60))
  7
} with Lease {
  finally { Stdout.print("#{who} released") }
  renew(resume) -> resume(())
}

fn joiner() : Int / Spawn + Stdout + Clock = handle {
  nursery { n ->
    let _ = n.spawn(() => slow("join child"))
    0
  }
} with Lease {
  finally { Stdout.print("joiner released") }
  renew(resume) -> resume(())
}

fn awaiter() : Int / Spawn + Stdout + Clock = handle {
  nursery { n ->
    let c = n.spawn(() => slow("await child"))
    n.await(c)
  }
} with Lease {
  finally { Stdout.print("awaiter released") }
  renew(resume) -> resume(())
}

fn main() : Int / Spawn + Stdout + Clock = nursery { n ->
  let j = n.spawn(() => joiner())
  let a = n.spawn(() => awaiter())
  sleep(millis(50))
  n.cancel(j)
  sleep(millis(50))
  n.cancel(a)
  sleep(millis(50))
  Stdout.print("done")
  0
}
