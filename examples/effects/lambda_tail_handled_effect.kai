effect Tick {
  tick() : Unit
}

effect Other {
  other() : Unit
}

pub fn f() : Int {
  let run = g => handle {
    g()
  } with Tick {
    tick(resume) -> resume(())
    return(x) -> x
  }
  handle {
    run(() => {
      Other.other()
      1
    })
  } with Other {
    other(resume) -> resume(())
    return(x) -> x + 41
  }
}

fn main() : Int / Stdout {
  Stdout.print(int_to_string(f()))
  0
}
