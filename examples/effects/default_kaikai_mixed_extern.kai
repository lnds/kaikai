effect Say {
  raw(msg: String) : Unit
  loud(msg: String) : Unit
  default {
    raw(msg, resume) -> $extern_handler("kai_default_stdout_print")
    loud(msg, resume) -> {
      println("LOUD: #{msg}")
      resume(())
    }
  }
}

fn main() : Unit / Say + Stdout {
  Say.raw("plain")
  Say.loud("shout")
  Say.raw("again")
}
