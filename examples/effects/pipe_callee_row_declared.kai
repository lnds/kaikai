# Every pipe form type-checks when the caller declares the callee's row.

fn say(n: Int) : Unit / Stdout = Stdout.print("n=#{n}")
fn say2(n: Int, m: Int) : Unit / Stdout = Stdout.print("n=#{n} m=#{m}")

fn bare(n: Int) : Unit / Stdout = n |> say
fn called(n: Int) : Unit / Stdout = n |> say()
fn extra(n: Int) : Unit / Stdout = n |> say2(2)
fn under(n: Int) : Unit / Stdout = n |> say2(2, _)

fn main() : Unit / Stdout = {
  bare(1)
  called(2)
  extra(3)
  under(4)
}
