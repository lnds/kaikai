# Two actors rally one message back and forth, so at N>1 workers keep going
# idle and waking. A healthy rally must never be reported as a deadlock:
# tools/run-mn-deadlock-banner.sh repeats it and requires a clean exit.

import actor

type Ball = Hit(Pid[Ball], Int)

fn ponger() : Unit / Actor[Ball] = match Actor.receive() {
  Hit(from, n) -> {
    Actor.send(from, Hit(Actor.self(), n))
    if n > 0 { ponger() } else { () }
  }
}

fn rally(other: Pid[Ball], n: Int, hits: Int) : Int / Actor[Ball] =
  if n < 0 { hits }
  else {
    Actor.send(other, Hit(Actor.self(), n))
    match Actor.receive() {
      Hit(_, _) -> rally(other, n - 1, hits + 1)
    }
  }

fn main() : Unit / Spawn + Stdout = with_mailbox {
  let p = spawn_actor(() => ponger())
  Stdout.print("rally returned #{rally(p, 20000, 0)} hits")
}
