# issue #1682 — every native symbol family minted from a user identifier at
# once: a named fn taken as a value (closure thunk), a raw protocol impl
# (boxed adapter), and a handler with an op clause plus `finally`
# (handler/clause/cleanup). All must land in the user namespace, never the
# runtime's. `tools/test-native-namespace.sh` checks the symbol table; this
# fixture checks the program still behaves once they move.

effect Greeter {
  greet(s: String) : String
}

protocol Shown {
  show_it(x: Self) : String
}

type Wrap = W(Int)

impl Shown for Wrap {
  fn show_it(w: Wrap) : String = match w { W(n) -> int_to_string(n) }
}

fn twice(f: (Int) -> Int, n: Int) : Int = f(f(n))

fn bump(n: Int) : Int = n + 1

fn main() : Int / Stdout = {
  let r = handle {
    Greeter.greet("kai")
  } with Greeter {
    greet(s, resume) -> resume(string_concat("hi ", s))
    finally { Stdout.print("cleanup") }
  }
  Stdout.print(r)
  Stdout.print(int_to_string(twice(bump, 1)))
  Stdout.print(show_it(W(7)))
  0
}
