# A fiber-local builtin op costs the same under 64 nested handlers as under none.

import time

effect Tick {
  tick() : Unit
}

fn spin(n: Int) : Unit / Spawn =
  if n == 0 { () } else { Spawn.scope_enter(); Spawn.scope_exit(); spin(n - 1) }

fn nested(depth: Int, n: Int) : Unit / Spawn =
  if depth == 0 { spin(n) }
  else {
    handle { nested(depth - 1, n) } with Tick {
      tick(resume) -> resume(())
      return(x)    -> x
    }
  }

fn timed(depth: Int, n: Int) : Int / Spawn + Clock = {
  let start = monotonic()
  nested(depth, n)
  duration_to_nanos(elapsed_since(start, monotonic()))
}

fn main() : Int / Stdout + Spawn + Clock = {
  # The depth is capped by the wasm stack, not by the property.
  let n = 4000000
  let flat = timed(0, n)
  let deep = timed(64, n)
  # 10 ms of slack keeps a loaded runner from flaking on a near-zero flat run.
  let ok = deep < flat * 2 + 10000000
  Stdout.print(if ok { "depth-independent" } else { "FAIL flat=#{flat} deep=#{deep}" })
  if ok { 0 } else { 1 }
}
