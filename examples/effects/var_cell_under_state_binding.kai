# A `var` reads and writes its own cell even when the enclosing scope
# binds `state` or `log`, the names a user-written stateful handler
# exposes its slot under.

import loop

fn interpolated() : Unit / Stdout = {
  let state = 5
  var a := 2
  a := a + 1
  Stdout.print("interpolated: a=#{a} state=#{state}")
}

fn looped() : Unit / Stdout = {
  let state = 100
  let log = 7
  var i := 0
  var total := 0
  while { i < 4 } {
    total := total + i
    i := i + 1
  }
  Stdout.print("looped: i=#{i} total=#{total} state=#{state} log=#{log}")
}

fn in_lambda() : Unit / Stdout = {
  let state = 40
  let bump = (n: Int) => {
    var acc := n
    acc := acc + state
    "#{acc}"
  }
  Stdout.print("in_lambda: #{bump(2)} state=#{state}")
}

fn main() : Unit / Stdout = {
  interpolated()
  looped()
  in_lambda()
}
