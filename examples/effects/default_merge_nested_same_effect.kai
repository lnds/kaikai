effect Tick {
  tick() : Int
  other() : Unit
  default {
    tick(resume) -> resume(1)
    other(resume) -> resume(())
  }
}

fn main() : Unit / Stdout {
  let r = handle {
    handle {
      Tick.tick()
    } with Tick {
      other(resume) -> resume(())
    }
  } with Tick {
    tick(resume) -> resume(2)
    other(resume) -> resume(())
  }
  println("inner default wins: #{r}")
}
