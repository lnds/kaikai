# A client with an `Actor[Reply]` mailbox sends a `Request` to a
# `Pid[Request]`: sending needs the destination's pid, not a mailbox of
# its type.

import actor

type Request = Query(String, Pid[Reply]) | Stop
type Reply   = Answer(String)

fn server() : Unit / Actor[Request] = match Actor.receive() {
  Query(q, reply_to) -> {
    Actor.send(reply_to, Answer("re: #{q}"))
    server()
  }
  Stop -> ()
}

fn ask(server: Pid[Request], q: String) : String / Actor[Reply] = {
  Actor.send(server, Query(q, Actor.self()))
  match Actor.receive() {
    Answer(a) -> a
  }
}

fn main() : Unit / Spawn + Stdout = with_mailbox {
  let srv = spawn_actor(() => server())
  Stdout.print(ask(srv, "one"))
  Stdout.print(ask(srv, "two"))
  Actor.send(srv, Stop)
}
