# A clause whose continuation is not called `resume`, called on one path
# and dropped on the other: the body's frame holds a list across the
# perform, and the path that drops the continuation releases it. A clause
# that calls its continuation on every path keeps the body running.

effect Pick { pick(n: Int) : Int }

effect Choose { choose(n: Int) : Int }

effect Step { step(n: Int) : Int }

fn picking(seen: [Int], n: Int) : Int / Pick = {
  let v = Pick.pick(n)
  picking([v, ...seen], n + 1)
}

fn choosing(seen: [Int], n: Int) : Int / Choose = {
  let v = Choose.choose(n)
  choosing([v, ...seen], n + 1)
}

fn stepping(seen: [Int], n: Int, stop: Int) : Int / Step =
  if n == stop { list_length(seen) } else {
    let v = Step.step(n)
    stepping([v, ...seen], n + 1, stop)
  }

fn by_if() : Int = handle { picking([], 0) } with Pick {
  pick(n, k) -> if n < 4 { k(n * 2) } else { 100 + n }
}

fn by_match() : Int = handle { choosing([], 0) } with Choose {
  choose(n, next) -> match n {
    6 -> 200
    _ -> next(n + 1)
  }
}

fn on_every_path() : Int = handle { stepping([], 0, 5) } with Step {
  step(n, go) -> if n % 2 == 0 { go(n) } else { go(0 - n) }
}

fn main() : Unit / Stdout = Stdout.print("#{by_if()} #{by_match()} #{on_every_path()}")
