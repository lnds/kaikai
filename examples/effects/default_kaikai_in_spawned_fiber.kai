import spawn

effect Greet {
  hello(name: String) : Unit
  default {
    hello(name, resume) -> {
      println("hello #{name}")
      resume(())
    }
  }
}

fn worker() : Unit / Greet + Console {
  Greet.hello("fiber")
}

fn main() : Int / Spawn + Greet + Console {
  nursery { n ->
    let f = n.spawn(worker)
    n.await(f)
  }
  0
}
