# Applying a record's function field raises the record's row variable:
# `go` declares no row, so `e` must not pass through it.

pub type Hook[e] = { run: (Int) -> Unit / e }

pub fn go[e](h: Hook[e]) : Unit = h.run(1)

fn main() : Unit / Stdout = go(Hook { run: (n) => Stdout.print("leaked #{n}") })
