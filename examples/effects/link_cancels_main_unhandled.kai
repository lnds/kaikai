# With no Cancel handler, a cancelled main ends the program with status 0.

import actor
import spawn

fn child(parent: Pid[String]) : Unit / Actor[String] + Link + Cancel = {
  Link.link(parent)
  Cancel.raise()
}

fn main() : Unit / Stdout + Spawn + Cancel + Link = {
  with_mailbox {
    Stdout.print("waiting")
    let me = Actor.self()
    let _ = spawn.spawn(() => with_mailbox { child(me) })
    Stdout.print("got: " ++ Actor.receive())
  }
}
