import gen

fn naturals(n: Int) : Unit / Yield[Int] = {
  Yield.yield(n)
  naturals(n + 1)
}

fn relay(g: Gen[Int, e]) : Unit / Yield[String] + e = match g {
  Done       -> ()
  Next(_, k) -> relay(k(()))
}

fn outer() : Gen[String, e] / e = gen.generate(() => relay(gen.generate(() => naturals(2))))

fn main() : Unit / Stdout = Stdout.print("unreachable")
