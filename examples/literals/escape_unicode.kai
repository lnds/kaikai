# `\u{...}` in string and char literals: the codepoint, UTF-8 encoded.
#
# The escape from issue #1720 is `\u{1b}` (ESC, for ANSI colour codes):
# it must be ONE byte, not the five characters `u{1b}`.

fn code_at(s: String, i: Int) : Int =
  match char_at(s, i) {
    None    -> 0 - 1
    Some(c) -> char_to_int(c)
  }

fn main() : Int / Console = {
  # ESC — one byte, value 27.
  print(int_to_string(string_length("\u{1b}")))   # 1
  print(int_to_string(code_at("\u{1b}", 0)))      # 27

  # Uppercase hex and leading zeros name the same codepoint.
  print(int_to_string(code_at("\u{1B}", 0)))      # 27
  print(int_to_string(code_at("\u{00001b}", 0)))  # 27

  # Two-byte UTF-8: U+00E9 'é' is 0xC3 0xA9.
  print(int_to_string(string_length("\u{e9}")))   # 2
  print(int_to_string(code_at("\u{e9}", 0)))      # 195
  print(int_to_string(code_at("\u{e9}", 1)))      # 169

  # Three-byte UTF-8: U+2603 SNOWMAN is 0xE2 0x98 0x83.
  print(int_to_string(string_length("\u{2603}")))  # 3
  print(int_to_string(code_at("\u{2603}", 0)))     # 226

  # Four-byte UTF-8: U+1F600 is 0xF0 0x9F 0x98 0x80.
  print(int_to_string(string_length("\u{1F600}"))) # 4
  print(int_to_string(code_at("\u{1F600}", 0)))    # 240

  # Boundaries: the last codepoint, and NUL via `\u{0}`.
  print(int_to_string(string_length("\u{10FFFF}")))  # 4
  print(int_to_string(string_length("a\u{0}b")))     # 3

  # `\xHH` is a BYTE, `\u{...}` a CODEPOINT: same number, different
  # length once the value needs more than one UTF-8 byte.
  print(int_to_string(string_length("\xe9")))     # 1
  print(int_to_string(string_length("\u{e9}")))   # 2

  # In a char literal `\u{...}` names the scalar value, not the bytes.
  print(int_to_string(char_to_int('\u{2603}')))   # 9731
  print(int_to_string(char_to_int('\u{1b}')))     # 27
  print(int_to_string(char_to_int('\x41')))       # 65
  0
}
