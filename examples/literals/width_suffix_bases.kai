# A fixed-width suffix attaches on every integer base, not just decimal,
# and digit separators inside a hex/binary literal decode to the same
# value as the unseparated spelling.

fn main() : Unit / Stdout = {
  Stdout.print("#{42i32} #{42u32} #{42u64} #{42i128}")
  Stdout.print("#{0xFFi32} #{0xFFu32} #{0xFFu64} #{0xFFi128}")
  Stdout.print("#{0b1010i32} #{0b1010u32} #{0b1010u64} #{0b1010i128}")
  Stdout.print("#{0XFFi32} #{0B1010u32}")
  Stdout.print("#{0xDEAD_BEEFu64} #{0b1010_1010u32} #{0xFF_FFi32}")
  Stdout.print("#{0xFF_FF == 0xFFFF} #{0b1010_1010 == 0b10101010}")
  Stdout.print("#{0xFFu8 == 255u8} #{0b1010u8 == 10u8}")
  # An i128 above 2^63 keeps its textual span through both backends, so
  # the hex spelling must agree with the decimal one at full width.
  Stdout.print("#{0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFi128 == 170141183460469231731687303715884105727i128}")
}
