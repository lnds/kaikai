# A Real literal keeps every digit the source wrote, at each extreme of the
# range, as a value and as a pattern. `real_bits` reads the number without
# going through how a Real prints.

type Shape = Circle(Real) | Square(Real)

fn classify(x: Real) : String = match x {
  1234567.891 -> "exact"
  1234570.0   -> "rounded"
  _           -> "other"
}

fn radius(s: Shape) : String = match s {
  Circle(9007200000000000.0) -> "six digits"
  Circle(9007199254740993.0) -> "exact"
  Circle(_)                  -> "other"
  Square(_)                  -> "square"
}

fn main() : Unit / Stdout = {
  let a = 1234567.891
  let b = 1234570.0
  Stdout.print("a == b: #{a == b}")
  Stdout.print("a - 1234567.0 > 0.89: #{a - 1234567.0 > 0.89}")
  Stdout.print("tail: #{real_to_int(9007199254740994.0 - 9007199254740000.0)}")
  Stdout.print("max finite: #{real_bits(1.7976931348623157e308)}")
  Stdout.print("min subnormal: #{real_bits(5.0e-324)}")
  Stdout.print("subnormal past six digits: #{real_bits(1.234567e-310)}")
  Stdout.print("min normal: #{real_bits(2.2250738585072014e-308)}")
  Stdout.print("above 2^53: #{real_bits(9007199254740993.0)}")
  Stdout.print("negative: #{real_bits(-1234567.891)}")
  Stdout.print("negative zero: #{real_bits(-0.0)}")
  Stdout.print("classify: #{classify(1234567.891)} #{classify(1234570.0)} #{classify(1234567.89)}")
  Stdout.print("radius: #{radius(Circle(9007199254740993.0))} #{radius(Circle(9007200000000000.0))} #{radius(Square(1.0))}")
}
