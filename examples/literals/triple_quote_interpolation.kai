# Triple-quote literals interpolate `#{...}` and are byte-exact: the
# newline after the opening delimiter is kept and nothing is dedented,
# so `"""\nAB"""` has length 3.

fn main() : Unit / Console {
  let n = 7
  let t = """x=#{n}
second"""
  print(t)
  print(int_to_string(t.length()))
  let s = """
AB"""
  print(int_to_string(s.length()))
}
