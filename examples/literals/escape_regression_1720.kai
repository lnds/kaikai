# Reversion guard for issue #1720.
#
# Before the fix, `"\u{1b}"` compiled clean and yielded the five
# characters `u{1b}` (native), or failed inside the generated C with
# "universal character name refers to a control character" (C backend):
# the two backends disagreed. `\q` silently became `q`. Both symptoms
# came from the same cause — no kaikai escape table, so the C compiler's
# rules leaked in through the emitter.
#
# The `\q` half is covered by escape_unknown.kai (it must not compile at
# all); this file guards the half that must compile and be correct.

fn main() : Int / Console = {
  # The exact literal from the issue: one byte, not five characters.
  print(int_to_string(string_length("\u{1b}")))

  # The issue's repro line, minus the escape that is now rejected.
  print("a\tb|\x41|")

  # An ANSI colour sequence — the use case that surfaced the bug.
  let red = "\u{1b}[31m"
  print(int_to_string(string_length(red)))
  0
}
