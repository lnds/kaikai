# A range below the top level of a pattern tests its bound like a top-level
# one: inside a variant, a tuple, a record, a list cell and an as-pattern,
# with negative and Char bounds, several ranges in one arm, beside a user
# guard that relies on the bound, and in a `case` block.

type Pt = { x: Int, y: Int }

fn opt(o: Option[Int]) : String = match o {
  Some(1..4) -> "small"
  Some(-3..-1) -> "negative"
  Some(_) -> "other"
  None -> "none"
}

fn pair(t: (Int, Int)) : String = match t {
  (0..1, 5) -> "low-five"
  (0..1, 2..3) -> "low-low"
  _ -> "other"
}

fn point(p: Pt) : String = match p {
  { x: 0..2, y } if 10 / (3 - p.x) > y -> "near"
  { x: 0..2, y: _ } -> "near-far"
  _ -> "far"
}

fn head(xs: [Char]) : String = match xs {
  ['a'..'z', ...] -> "lower"
  [whole @ 'A'..'Z'] -> "upper #{whole}"
  _ -> "other"
}

fn both(n: Int, o: Option[Int]) : String {
  case 0, Some(5..9) -> "zero-high"
  case _, Some(5..9) -> "high"
  case _, _ -> "rest"
}

fn main() : Unit / Stdout {
  Stdout.print("#{opt(Some(0))} #{opt(Some(2))} #{opt(Some(-2))} #{opt(Some(7))} #{opt(None)}")
  Stdout.print("#{pair((5, 5))} #{pair((1, 5))} #{pair((0, 3))} #{pair((0, 4))}")
  Stdout.print("#{point(Pt { x: 2, y: 9 })} #{point(Pt { x: 2, y: 20 })} #{point(Pt { x: 3, y: 1 })}")
  Stdout.print("#{head(['q'])} #{head(['Q'])} #{head(['Q', 'r'])} #{head([])}")
  Stdout.print("#{both(0, Some(6))} #{both(1, Some(6))} #{both(0, Some(4))}")
}
