# A guard on any arm forces the boxed if-chain, and a single bare read
# of the catch-all binder keeps its raw unbox seed — the arm bind must
# declare the raw `kair_` form alongside the boxed alias or the body
# reads an undeclared identifier.

fn pick(i: Int) : String =
  match i {
    k if k % 3 == 0 -> "Fizz"
    m               -> int_to_string(m)
  }

fn classify(r: Real) : String =
  match r {
    x if x > 10.0 -> "big"
    y             -> real_to_string(y)
  }

fn main() : Int / Console {
  print(pick(7))
  print(pick(9))
  print(classify(2.5))
  print(classify(12.5))
  0
}
