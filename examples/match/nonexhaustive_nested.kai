# A guard, a literal or a nested pattern narrows what an arm covers: arms
# naming every constructor can still miss a value.

type Color = Red | Green | Blue

type P = { x: Int, y: Int }

fn guarded(o: Option[Int]) : Int = match o {
  Some(x) if x > 0 -> x
  None             -> 0
}

fn literal_slot(o: Option[Int]) : Int = match o {
  Some(0) -> 1
  None    -> 0
}

fn nested_ctor(o: Option[Option[Color]]) : Int = match o {
  Some(Some(Red)) -> 1
  Some(None)      -> 2
  None            -> 3
}

fn tuple_pairs(p: (Color, Color)) : Int = match p {
  (Red, _)       -> 1
  (_, Red)       -> 2
  (Green, Green) -> 3
}

fn record_field(p: P) : Int = match p {
  { x: 0, y } -> y
}

fn list_elem(xs: [Option[Int]]) : Int = match xs {
  []              -> 0
  [Some(x), ..._] -> x
}

fn list_length_gap(xs: [Int]) : Int = match xs {
  []           -> 0
  [_]          -> 1
  [_, 1, ..._] -> 2
}

fn main() {
  Stdout.print("#{guarded(None)} #{literal_slot(None)} #{nested_ctor(None)}")
  Stdout.print("#{tuple_pairs((Red, Red))} #{record_field(P { x: 0, y: 1 })}")
  Stdout.print("#{list_elem([])} #{list_length_gap([])}")
}
