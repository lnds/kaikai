# An `if` with no `else` ends an arm body at its `}`; the next line
# starts a new arm even when its pattern opens with `[`.

fn walk(xs: [Int]) : Unit / Stdout = match xs {
  [x, ...rest] ->
    if x > 0 { println("#{x}") }
  [] -> ()
}

fn count(xs: [Int], acc: Int) : Int = match xs {
  [x, ...rest] -> {
    if x > 0 { count(rest, acc + 1) } else { count(rest, acc) }
  }
  [] -> acc
}

fn main() {
  walk([1, 2])
  walk([])
  println("#{count([1, -2, 3], 0)}")
}
