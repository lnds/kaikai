# Arms whose literals, guards and nested patterns together cover every value
# compile without a catch-all.

type Color = Red | Green | Blue

type P = { x: Int, y: Int }

fn bools(o: Option[Bool]) : Int = match o {
  Some(true)  -> 1
  Some(false) -> 2
  None        -> 0
}

fn guard_then_total(o: Option[Int]) : Int = match o {
  Some(x) if x > 0 -> x
  Some(_)          -> 0
  None             -> 0 - 1
}

fn tuple_all(p: (Color, Color)) : Int = match p {
  (Red, _)       -> 1
  (_, Red)       -> 2
  (Green, Green) -> 3
  (Blue, Blue)   -> 4
  (Green, Blue)  -> 5
  (Blue, Green)  -> 6
}

fn nested(o: Option[Option[Color]]) : Int = match o {
  Some(Some(Red)) -> 1
  Some(Some(_))   -> 2
  Some(None)      -> 3
  None            -> 4
}

fn record_split(p: P) : Int = match p {
  { x: 0, y } -> y
  { x, y: _ } -> x
}

fn lists(xs: [Option[Int]]) : Int = match xs {
  []                -> 0
  [None, ..._]      -> 1
  [Some(x), ...t]   -> x + length(t)
}

fn main() {
  Stdout.print("#{bools(Some(false))} #{guard_then_total(Some(0 - 3))} #{tuple_all((Blue, Green))}")
  Stdout.print("#{nested(Some(Some(Blue)))} #{record_split(P { x: 0, y: 7 })} #{lists([Some(5), None])}")
}
