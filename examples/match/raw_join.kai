type Shape = Circle(Int) | Square(Int) | Dot

fn id_int(x: Int) : Int = x

fn int_lit(n: Int) : Int = match n {
  1 -> 10
  2 -> 20
  _ -> 0
}

fn int_lit_if(n: Int) : Int = if n == 1 { 10 } else if n == 2 { 20 } else { 0 }

fn bool_lit(n: Int) : Bool = match n {
  1 -> true
  2 -> false
  _ -> true
}

fn bool_lit_if(n: Int) : Bool = if n == 1 { true } else if n == 2 { false } else { true }

fn char_lit(n: Int) : Char = match n {
  1 -> 'a'
  2 -> 'b'
  _ -> 'c'
}

fn char_lit_if(n: Int) : Char = if n == 1 { 'a' } else if n == 2 { 'b' } else { 'c' }

fn real_lit(n: Int) : Real = match n {
  1 -> 1.5
  2 -> 2.5
  _ -> 0.0
}

fn real_lit_if(n: Int) : Real = if n == 1 { 1.5 } else if n == 2 { 2.5 } else { 0.0 }

fn int_ctor(s: Shape) : Int = match s {
  Circle(r) -> r
  Square(w) -> w + 1
  Dot -> 0
}

fn int_ctor_if(s: Shape) : Int = match s {
  Circle(r) -> id_int(r)
  Square(w) -> id_int(w) + 1
  Dot -> 0
}

fn bool_ctor(s: Shape) : Bool = match s {
  Circle(r) -> r > 2
  Square(w) -> w == 3
  Dot -> false
}

fn bool_ctor_if(s: Shape) : Bool = match s {
  Circle(r) -> if r > 2 { true } else { false }
  Square(w) -> if w == 3 { true } else { false }
  Dot -> false
}

fn real_ctor(s: Shape) : Real = match s {
  Circle(r) -> int_to_real(r) * 2.0
  Square(w) -> int_to_real(w)
  Dot -> 0.5
}

fn real_ctor_if(s: Shape) : Real = match s {
  Circle(r) -> int_to_real(r) + int_to_real(r)
  Square(w) -> int_to_real(w)
  Dot -> 0.5
}

fn int_guard(n: Int) : Int = match n {
  k if k > 5 -> k * 2
  k if k < 0 -> 0 - k
  _ -> 1
}

fn int_guard_if(n: Int) : Int = if n > 5 { n * 2 } else if n < 0 { 0 - n } else { 1 }

fn char_guard(c: Char) : Char = match c {
  x if x == 'a' -> 'z'
  _ -> c
}

fn char_guard_if(c: Char) : Char = if c == 'a' { 'z' } else { c }

fn int_nested(a: Int, b: Int) : Int = match a {
  0 -> match b {
    0 -> 1
    _ -> 2
  }
  1 -> 3
  _ -> match b {
    5 -> 4
    _ -> 5
  }
}

fn int_nested_if(a: Int, b: Int) : Int =
  if a == 0 {
    if b == 0 { 1 } else { 2 }
  } else if a == 1 {
    3
  } else {
    if b == 5 { 4 } else { 5 }
  }

fn bool_nested(a: Int, b: Int) : Bool = match a {
  0 -> match b {
    0 -> true
    _ -> false
  }
  _ -> b == 3
}

fn bool_nested_if(a: Int, b: Int) : Bool =
  if a == 0 { if b == 0 { true } else { false } } else { b == 3 }

fn int_call(n: Int) : Int = match n {
  1 -> id_int(7)
  2 -> id_int(n) + id_int(n)
  _ -> 0
}

fn int_call_if(n: Int) : Int = if n == 1 { id_int(7) } else if n == 2 { 4 } else { 0 }

fn is_pos(n: Int) : Bool = n > 0

fn bool_call(n: Int) : Bool = match n {
  0 -> false
  _ -> is_pos(n)
}

fn bool_call_if(n: Int) : Bool = if n == 0 { false } else { is_pos(n) }

fn let_bound(n: Int) : Int {
  let v = match n {
    1 -> 100
    _ -> 200
  }
  let w = match v {
    100 -> true
    _ -> false
  }
  if w { v + 1 } else { v + 2 }
}

fn nested_a(p: (Int, Int)) : Int {
  let (a, b) = p
  int_nested(a, b)
}

fn nested_b(p: (Int, Int)) : Int {
  let (a, b) = p
  int_nested_if(a, b)
}

fn bnested_a(p: (Int, Int)) : Bool {
  let (a, b) = p
  bool_nested(a, b)
}

fn bnested_b(p: (Int, Int)) : Bool {
  let (a, b) = p
  bool_nested_if(a, b)
}

fn ints() : [Int] = [-3, 0, 1, 2, 3, 5, 6, 9]

fn shapes() : [Shape] = [Circle(1), Circle(4), Square(2), Square(3), Dot]

fn main() : Int / Console {
  println(show(map(ints(), int_lit) == map(ints(), int_lit_if)))
  println(show(map(ints(), bool_lit) == map(ints(), bool_lit_if)))
  println(show(map(ints(), char_lit) == map(ints(), char_lit_if)))
  println(show(map(ints(), real_lit) == map(ints(), real_lit_if)))
  println(show(map(shapes(), int_ctor) == map(shapes(), int_ctor_if)))
  println(show(map(shapes(), bool_ctor) == map(shapes(), bool_ctor_if)))
  println(show(map(shapes(), real_ctor) == map(shapes(), real_ctor_if)))
  println(show(map(ints(), int_guard) == map(ints(), int_guard_if)))
  let cs = ['a', 'b', 'z']
  println(show(map(cs, char_guard) == map(cs, char_guard_if)))
  let pairs = [(0, 0), (0, 1), (1, 9), (2, 5), (2, 6)]
  println(show(map(pairs, nested_a) == map(pairs, nested_b)))
  println(show(map(pairs, bnested_a) == map(pairs, bnested_b)))
  println(show(map(ints(), int_call) == map(ints(), int_call_if)))
  println(show(map(ints(), bool_call) == map(ints(), bool_call_if)))
  println(show(map(ints(), int_ctor_dummy)))
  println(show(map(ints(), let_bound)))
  println(show(map(shapes(), int_ctor)))
  println(show(map(ints(), bool_lit)))
  println(show(map(ints(), char_lit)))
  println(show(map(ints(), real_lit)))
  0
}

fn int_ctor_dummy(n: Int) : Int = int_lit(n) + int_call(n)
