fn by_match(n: Int) : Int = match n {
  -3 -> 10
  0 -> 11
  40 -> 12
  91 -> 12
  123 -> 13
  _ -> 0
}

fn by_if(n: Int) : Int =
  if n == -3 { 10 } else if n == 0 { 11 } else if n == 40 or n == 91 { 12 } else if n == 123 { 13 } else { 0 }

fn char_match(c: Char) : Int = match c {
  'a' -> 1
  '(' -> 2
  'é' -> 3
  _ -> 0
}

fn char_if(c: Char) : Int =
  if c == 'a' { 1 } else if c == '(' { 2 } else if c == 'é' { 3 } else { 0 }

fn byte_match(b: Byte) : Int = match b {
  0u8 -> 1
  65u8 -> 2
  255u8 -> 3
  _ -> 0
}

fn byte_if(b: Byte) : Int =
  if b == 0u8 { 1 } else if b == 65u8 { 2 } else if b == 255u8 { 3 } else { 0 }

fn bool_match(b: Bool) : Int = match b {
  true -> 1
  false -> 2
}

fn str_match(s: String) : Int = match s {
  "" -> 1
  "foo" -> 2
  "bar" -> 3
  _ -> 0
}

fn str_if(s: String) : Int =
  if s == "" { 1 } else if s == "foo" { 2 } else if s == "bar" { 3 } else { 0 }

fn real_match(r: Real) : Int = match r {
  0.0 -> 1
  1.5 -> 2
  _ -> 0
}

fn real_if(r: Real) : Int = if r == 0.0 { 1 } else if r == 1.5 { 2 } else { 0 }

fn tuple_match(p: (Int, Int)) : Int = match p {
  (0, 0) -> 1
  (-1, y) -> y
  (x, 7) -> x
  _ -> 0
}

fn tuple_if(p: (Int, Int)) : Int = {
  let (a, b) = p
  if a == 0 and b == 0 { 1 } else if a == -1 { b } else if b == 7 { a } else { 0 }
}

fn opt_match(o: Option[Int]) : Int = match o {
  Some(5) -> 1
  Some(-5) -> 2
  Some(n) -> n
  None -> 0
}

fn opt_if(o: Option[Int]) : Int = match o {
  Some(n) -> if n == 5 { 1 } else if n == -5 { 2 } else { n }
  None -> 0
}

fn check_int(i: Int, acc: Int) : Int =
  if i > 130 { acc } else { check_int(i + 1, acc + (if by_match(i - 5) == by_if(i - 5) { 0 } else { 1 })) }

fn main() : Int / Console {
  println(show(check_int(0, 0)))
  let cs = ['a', '(', 'é', 'z']
  println(show(map(cs, char_match) == map(cs, char_if)))
  let bs = [0u8, 65u8, 255u8, 7u8]
  println(show(map(bs, byte_match) == map(bs, byte_if)))
  println(show(bool_match(true) + bool_match(false)))
  let ss = ["", "foo", "bar", "baz"]
  println(show(map(ss, str_match) == map(ss, str_if)))
  let rs = [0.0, 1.5, 2.0]
  println(show(map(rs, real_match) == map(rs, real_if)))
  let ps = [(0, 0), (-1, 4), (3, 7), (1, 1)]
  println(show(map(ps, tuple_match) == map(ps, tuple_if)))
  println(show(map(ps, tuple_match)))
  let os = [Some(5), Some(-5), Some(9), None]
  println(show(map(os, opt_match) == map(os, opt_if)))
  println(show(map(os, opt_match)))
  0
}
