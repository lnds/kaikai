# A multi-column arm is lowered once, in a scope holding only its own
# binders: a lambda or a handler in it captures what that arm binds, and
# a name it reads is never one an earlier arm bound.

effect Tally { add(n: Int) : Unit }

fn sorted(xs: [Int]) : Result[[Int], String] = Ok(xs)

# A lambda captures the binder of a clause that an earlier clause destructures.
fn of_list(name: String, xs: [Int]) : Result[Int, String] {
  case "head", [] -> Err("`head` of an empty list")
  case "head", [x, ...] -> Ok(x)
  case "last", xs -> last(xs) |> ok_or("`last` of an empty list")
  case "count", xs -> sorted(xs) | ys => length(ys) + length(xs)
  case name, _ -> Err(name)
}

# A lambda captures a `let` of the arm.
fn scaled(kind: Int, xs: [Int]) : [Int] = match kind, xs {
  0, [] -> []
  1, [x, ...rest] -> [x, ...rest]
  k, ys -> {
    let by = k * 10
    map(ys, y => y * by)
  }
}

# A handler sits in an arm that earlier arms fall through to.
fn tallied(a: Int, b: Int) : Int = match a, b {
  0, 0 -> 0
  1, k -> handle { Tally.add(k); 7 } with Tally(0) {
    add(n, resume) -> resume((), state + n + k)
    return(x) -> state + x + k
  }
  _, _ -> -1
}

# The second arm reads the parameter `x`, not the first arm's binder.
fn outer_name(a: Int, b: Int, x: Int) : Int = match a, b {
  x, 0 -> x
  _, _ -> x
}

# Two refutable columns bind, and the guard reads one column's binder
# while the body reads the other's.
fn pick(a: Option[Int], b: Option[Int]) : Int {
  case Some(x), Some(y) when y > 10 -> x
  case Some(x), Some(y) -> x + y
  case None, Some(y) -> y
  case _, _ -> 0
}

fn main() : Unit / Stdout = {
  Stdout.print(show(of_list("count", [1, 2])))
  Stdout.print(show(of_list("head", [])))
  Stdout.print(show(of_list("last", [4, 5])))
  Stdout.print(show(of_list("nope", [1])))
  Stdout.print(show(scaled(3, [1, 2])))
  Stdout.print(show(scaled(1, [1, 2])))
  Stdout.print("#{tallied(1, 5)} #{tallied(1, 0)} #{tallied(2, 2)}")
  Stdout.print("#{outer_name(1, 5, 99)} #{outer_name(1, 0, 99)}")
  Stdout.print("#{pick(Some(1), Some(20))} #{pick(Some(1), Some(2))} #{pick(None, Some(4))} #{pick(Some(1), None)}")
}
