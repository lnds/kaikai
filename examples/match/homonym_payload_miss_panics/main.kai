# Two modules declare `Circle`: the coverage check cannot tell from the name
# which type the nested pattern belongs to, so it accepts the match, and a
# value no arm matches panics at run time.

import ma
import mb

fn radius(o: Option[ma.Shape]) : Int = match o {
  Some(Circle(r)) -> r
  None            -> 0
}

fn main() {
  Stdout.print("#{radius(Some(ma.Circle(3)))} #{radius(None)}")
  Stdout.print("#{radius(Some(ma.Sq))}")
}
