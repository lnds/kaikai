type LocalId = LocalId(Int)
type SymId = SymId(Int)
type Donor = Donor(SymId, [LocalId])
type EK = ELocal(LocalId) | EInt(Int) | EOther(String, Int)
type Cx = { donor: Option[Donor], n: Int }

fn sym_raw(s: SymId) : Int = match s { SymId(i) -> i }
fn local_raw(l: LocalId) : Int = match l { LocalId(i) -> i }
fn local_eq(a: LocalId, b: LocalId) : Bool = local_raw(a) != 0 and local_raw(a) == local_raw(b)

fn nth(bs: [LocalId], i: Int) : LocalId = match bs {
  []           -> LocalId(0)
  [b, ...rest] -> if i == 0 { b } else { nth(rest, i - 1) }
}

fn is_donor_identity(ctor: SymId, a: EK, i: Int, cx: Cx) : Bool =
  match cx.donor {
    None -> false
    Some(Donor(dctor, binders)) ->
      if sym_raw(ctor) < 0 or sym_raw(dctor) != sym_raw(ctor) { false }
      else { match a {
        ELocal(l) -> local_eq(l, nth(binders, i))
        _         -> false
      } }
  }

fn main() {
  let cx = Cx { donor: Some(Donor(SymId(5), [LocalId(7), LocalId(9)])), n: 1 }
  print(if is_donor_identity(SymId(5), ELocal(LocalId(9)), 1, cx) { "yes" } else { "no" })
  print(if is_donor_identity(SymId(5), ELocal(LocalId(8)), 1, cx) { "yes" } else { "no" })
  print(if is_donor_identity(SymId(5), EInt(3), 0, cx) { "yes" } else { "no" })
}
