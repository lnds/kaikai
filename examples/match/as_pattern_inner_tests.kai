type P = { a: Int, b: Int }

type Bx = { p: P, n: Int }

type T = Pair(Int, Int) | Other

fn rec_as(bx: Bx) : Int = match bx {
  whole @ { p: { a: 0, b }, n } -> whole.n + b + n
  _ -> 0
}

fn rec_plain(bx: Bx) : Int = match bx {
  { p: { a: 0, b }, n } -> b + n
  _ -> 0
}

fn tup_as(xs: (Int, Int)) : Int = match xs {
  w @ (0, b) -> b
  _ -> 0
}

fn var_as(t: T) : Int = match t {
  whole @ Pair(0, b) -> b
  _ -> 0
}

fn rebind(bx: Bx) : Int = match bx {
  whole @ { p: { a: 0, b }, n } -> whole.n + b + n
  { p: { a, b }, n: _ } -> a + b
}

fn str_as(t: (String, Int)) : Int = match t {
  w @ ("x", n) -> n
  _ -> 0
}

fn nested_as(t: (Int, (Int, Int))) : Int = match t {
  outer @ (1, inner @ (0, b)) -> match outer {
    (k, _) -> b + k
  }
  _ -> 0
}

fn lit_as(n: Int) : Int = match n {
  z @ 0 -> z + 10
  m -> m
}

fn main() : Unit / Stdout {
  let hit = Bx { p: P { a: 0, b: 2 }, n: 3 }
  let miss = Bx { p: P { a: 1, b: 2 }, n: 3 }
  Stdout.print("rec_as: #{rec_as(miss)} #{rec_as(hit)}")
  Stdout.print("rec_plain: #{rec_plain(miss)} #{rec_plain(hit)}")
  Stdout.print("tup_as: #{tup_as((1, 2))} #{tup_as((0, 2))}")
  Stdout.print("var_as: #{var_as(Pair(1, 2))} #{var_as(Pair(0, 2))}")
  Stdout.print("rebind: #{rebind(miss)} #{rebind(hit)}")
  Stdout.print("str_as: #{str_as(("y", 5))} #{str_as(("x", 5))}")
  Stdout.print("nested_as: #{nested_as((1, (1, 4)))} #{nested_as((1, (0, 4)))}")
  Stdout.print("lit_as: #{lit_as(5)} #{lit_as(0)}")
}
