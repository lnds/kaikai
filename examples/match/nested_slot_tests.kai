# Every refutable sub-pattern of an arm is tested, at any depth: a tuple or
# record in a variant slot, a guarded record arm, a list in a slot.

type P = { x: Int, y: Int }

type Sum = Ca(Int) | Cb([Int])

type Wrap = Box(Option[[Int]]) | Bare

type Two = Two(Int, [Int])

fn tuple_slot(o: Option[(Int, Int)]) : Int = match o {
  Some((0, y)) -> y
  Some((x, _)) -> x
  None         -> 0
}

fn record_slot(o: Option[P]) : Int = match o {
  Some({ x: 0, y }) -> 200 + y
  Some({ x, y })    -> x + y
  None              -> 0
}

fn guarded_record(p: P) : Int = match p {
  { x: 0, y } if y > 0 -> 1
  { x, y: _ } if x > 0 -> 2
  _                    -> 3
}

fn guarded_list_slot(o: Option[[Int]]) : Int = match o {
  Some([x]) if x > 0 -> x
  Some(_)            -> 0
  None               -> 0 - 1
}

fn list_in_sub_variant(w: Wrap) : Int = match w {
  Box(Some([a, b])) -> a + b
  Box(_)            -> 0
  Bare              -> 0 - 1
}

fn list_beside_slot(t: Two) : Int = match t {
  Two(0, [h, ..._]) -> h
  Two(n, [])        -> n
  Two(n, _)         -> 0 - n
}

fn guarded_variant_list(s: Sum) : Int = match s {
  Ca(a) if a > 5   -> 1
  Ca(a)            -> a
  Cb([h, ...t])    -> h + length(t)
  Cb(a)            -> length(a)
}

fn main() {
  Stdout.print("#{tuple_slot(Some((5, 7)))} #{tuple_slot(Some((0, 7)))} #{tuple_slot(None)}")
  Stdout.print("#{record_slot(Some(P { x: 0, y: 9 }))} #{record_slot(Some(P { x: 2, y: 9 }))}")
  Stdout.print("#{guarded_record(P { x: 5, y: 7 })} #{guarded_record(P { x: 0, y: 7 })} #{guarded_record(P { x: 0 - 1, y: 7 })}")
  Stdout.print("#{guarded_list_slot(Some([4]))} #{guarded_list_slot(Some([0 - 4]))} #{guarded_list_slot(Some([1, 2]))} #{guarded_list_slot(None)}")
  Stdout.print("#{list_in_sub_variant(Box(Some([3, 4])))} #{list_in_sub_variant(Box(Some([3])))} #{list_in_sub_variant(Box(None))} #{list_in_sub_variant(Bare)}")
  Stdout.print("#{list_beside_slot(Two(0, [8, 9]))} #{list_beside_slot(Two(0, []))} #{list_beside_slot(Two(5, [1]))} #{list_beside_slot(Two(5, []))}")
  Stdout.print("#{guarded_variant_list(Cb([1, 2]))} #{guarded_variant_list(Cb([]))} #{guarded_variant_list(Ca(7))} #{guarded_variant_list(Ca(3))}")
}
