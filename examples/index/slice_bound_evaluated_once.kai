# Each part of a Vec slice runs once, in source order.
fn coll(xs: Vec[Int]) : Vec[Int] / Stdout = {
  Stdout.print("coll")
  xs
}

fn lo() : Int / Stdout = {
  Stdout.print("lo")
  1
}

fn hi() : Int / Stdout = {
  Stdout.print("hi")
  2
}

fn main() : Unit / Stdout = {
  let xs: Vec[Int] = [10, 20, 30, 40]
  let ys = coll(xs)[lo()..hi()]
  Stdout.print(int_to_string(vec_length(ys)))
  Stdout.print(int_to_string(ys[0]))
}
