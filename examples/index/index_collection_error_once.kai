# A diagnostic inside an indexed collection is reported once, whichever
# getter the collection's type selects.
import collections.map

fn cells(a: Int) : Array[Int] = array_make(2, a)
fn same_map(m: Map[String, Int]) : Map[String, Int] = m
fn same_vec(v: Vec[Int], n: Int) : Vec[Int] = v

fn main() : Unit / Stdout = {
  let xs: Vec[Int] = [10, 20]
  let a = cells(1, 2)[string_length(5)]
  let m = same_map(%{ "a": string_length(5) })["a"]
  let v = same_vec(xs, true)[0]
  let n = match m { Some(k) -> k  None -> 0 }
  Stdout.print(int_to_string(a + n + v))
}
