# A derived `to_bytes` writes a record's fields one after another into one
# buffer; a field whose writer traps unwinds through the derived code
# while the buffer is in flight. Native releases none of it yet
# (in-flight values have no pad): the growth baseline pins what each
# trapped worker keeps.

import actor
import spawn

type Boom = | Boom

impl BinSerialize for Boom {
  fn to_bytes(self: Boom) : Array[Byte] = panic("boom to_bytes")
  fn from_bytes(buf: Array[Byte], pos: Int) : Result[BinCursor[Boom], String] = panic("boom from_bytes")
}

#[derive(BinSerialize)]
type Rec = { name: String, tags: [String], boom: Boom }

fn work(k: Int) : Int = {
  let r = Rec { name: "w#{k}", tags: ["a", "b"], boom: Boom }
  array_length(to_bytes(r))
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = work(k)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 30)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
