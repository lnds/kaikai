# A pattern binder bound inside a lambda body: every read in the closure
# dups, so the arm releases the binder's own reference on exit.

fn step(i: Int) : Int = {
  let t = (k: Int) => {
    let xs = [k, 2, 3]
    match xs {
      [_, ...rest] -> rest
      []           -> []
    }
  }
  list_length(t(i))
}

fn loop(i: Int, n: Int, acc: Int) : Int = if i >= n { acc } else { loop(i + 1, n, acc + step(i)) }

fn main() : Unit / Stdout = Stdout.print("s=#{loop(0, 1000, 0)}")
