# An op argument built by the unboxed primitive-payload ctor path, matched
# on inside the handler clause with a binder named `k` — the same name the
# native clause reserves for its continuation register. The payload bind must
# not clobber the continuation: the resume used to dispatch on the tagged int
# (k=3 -> 0x7) and segfault.
type Shape = Dot(Int) | Empty

effect Sink { var_(v: Shape) : Int }

fn feed() : Int / Sink = Sink.var_(Dot(3))

fn feed_empty() : Int / Sink = Sink.var_(Empty)

fn main() : Unit / Stdout = {
  let n = handle { feed() } with Sink {
    var_(v, resume) -> resume(match v { Dot(k) -> k Empty -> 0 })
  }
  let m = handle { feed_empty() } with Sink {
    var_(v, resume) -> resume(match v { Dot(k) -> k Empty -> 0 })
  }
  Stdout.print("n=#{n} m=#{m}")
}
