# A specialised callee's argument runs exactly once, whether the closure
# ignores its parameter, reads it on one branch only, or reads it twice.

fn noisy(n: Int) : Int / Stdout = {
  Stdout.print("eval #{n}")
  n
}

fn ap(f: (Int) -> Int, n: Int) : Int / Stdout = f(noisy(n))

fn main() : Unit / Stdout {
  Stdout.print("#{ap((_x) => 7, 1)}")
  Stdout.print("#{ap((x) => if 1 > 2 { x } else { 0 }, 2)}")
  Stdout.print("#{ap((x) => x + x, 3)}")
}
