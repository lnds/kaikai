# A handler whose state is a vector, rewritten through `resume`.

effect Cell { put(i: Int) : Unit }

fn drive(i: Int) : Unit / Cell =
  if i >= 20000 { () }
  else {
    Cell.put(i)
    drive(i + 1)
  }

fn main() : Unit / Stdout = {
  let v = handle {
    drive(0)
    ()
  } with Cell(vec_make(20000, 0)) {
    put(i, resume) -> resume((), vec_set(state, i, i))
    return(_u)     -> state
  }
  Stdout.print(int_to_string(vec_get(v, 19999)))
}
