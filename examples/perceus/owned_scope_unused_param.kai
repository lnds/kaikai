# A `pub` fn owns its params. One the body never reads is released by
# the entry drop; the owned-in-scope move over a top-level match must
# not also plant a branch drop for it in every arm, or it is released
# twice. `keep` is the legitimate case: read in one arm, dropped in the
# others.

pub type Tag = { name: String, weight: Int }

pub type Shape = Dot | Seg(Int) | Box(Int, Int)

pub fn pick(n: Int, unused: String) : Int =
  match n {
    0 -> 1
    _ -> n * 2
  }

pub fn measure(s: Shape, note: Tag, keep: String) : String =
  match s {
    Dot -> keep
    Seg(k) -> {
      let d = k + 1
      "seg #{d}"
    }
    Box(w, h) -> "box #{w * h}"
  }

fn main() : Unit / Stdout = {
  let a = pick(0, "a-#{a_seed()}")
  let b = pick(4, "b-#{a_seed()}")
  let t = Tag { name: "t-#{a_seed()}", weight: 3 }
  let m1 = measure(Dot, t, "dot-#{a}")
  let m2 = measure(Seg(b), Tag { name: "u-#{a_seed()}", weight: 4 }, "k-#{b}")
  let m3 = measure(Box(2, 3), Tag { name: "v-#{a_seed()}", weight: 6 }, "k-#{a}")
  Stdout.print("#{a} #{b} #{m1} #{m2} #{m3}")
}

fn a_seed() : Int = 7
