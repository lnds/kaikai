# A match arm whose binder is dup'd into one argument and borrowed by
# another call, in an arm that ends in a self-tail-call, owes that binder's
# own reference a release on the goto path. The goto skips every exit, so
# the release has to run after the call's last argument is evaluated.
#
# `walk` is the bare-call arm; `walk_block` reaches the same call through a
# block body; `walk_even`/`walk_odd` fuse into one loop whose tag parameter
# is only inspected. Each element holds a Node with a Node child, two cells
# a step.

type Color = Red | Black
type Tree = Leaf | Node(Color, Tree, Int, Tree)

fn left(t: Tree) : Tree = match t {
  Node(_, a, _, _) -> a
  Leaf             -> Leaf
}

fn size(t: Tree) : Int = match t {
  Node(_, a, _, b) -> 1 + size(a) + size(b)
  Leaf             -> 0
}

fn red_int(t: Tree) : Int = match t {
  Node(Red, _, _, _) -> 10
  _                  -> 0
}

fn mk(n: Int, acc: [Tree]) : [Tree] =
  if n == 0 { acc } else { mk(n - 1, [Node(Red, Node(Black, Leaf, n, Leaf), n, Leaf), ...acc]) }

fn walk(xs: [Tree], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> walk(t, acc + size(left(h)) + red_int(h))
}

fn walk_block(xs: [Tree], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> {
    let seen = acc + 1
    walk_block(t, seen + size(left(h)) + red_int(h))
  }
}

fn walk_even(xs: [Tree], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> walk_odd(t, acc + size(left(h)) + red_int(h))
}

fn walk_odd(xs: [Tree], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> walk_even(t, acc + red_int(h) + red_int(h))
}

fn repeat(i: Int, s: Int) : Int =
  if i == 0 { s }
  else { repeat(i - 1, s + walk(mk(30, []), 0) + walk_block(mk(30, []), 0) + walk_even(mk(30, []), 0)) }

fn main() : Unit / Stdout = Stdout.print("sum=#{repeat(100, 0)}")
