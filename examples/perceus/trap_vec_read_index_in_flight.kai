# The index of a fused Vec read traps while the vec it reads is an owned
# temporary in flight: the landing pad releases it. C has no pads: the
# growth baseline pins what each trapped worker keeps there.

import actor
import spawn

type Flag = { on: Bool, n: Int }

fn flags(v: Vec[Flag], k: Int, n: Int) : Vec[Flag] =
  if k > n { v } else { flags(vec_push(v, Flag { on: k % 2 == 0, n: k }), k + 1, n) }

fn rows(k: Int) : Vec[Vec[Flag]] = vec_push(vec_empty(), flags(vec_empty(), 1, k))

fn bit(b: Bool) : Int = if b { 1 } else { 0 }

fn wild(k: Int) : Int = if k >= 0 { panic("wild index") } else { k }

fn run_case(k: Int) : Int = match k % 3 {
  0 -> bit(vec_get(vec_get(rows(3), 0), wild(k)).on)
  1 -> vec_get(vec_get(rows(3), 0), wild(k)).n
  _ -> bit(vec_get(flags(vec_empty(), 1, 3), wild(k)).on)
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = run_case(k)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 30)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
