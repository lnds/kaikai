# A TCO loop whose param is handed to a callee that DISCARDS it: the callee
# takes no ownership, so the goto owes the drop before it rebinds the slot.
type Env = { entries: [String] }

fn fresh(e: Env, p: String) : Env = Env { entries: [p] }

fn build(e: Env, i: Int, n: Int) : Env =
  if i >= n { e } else { build(fresh(e, "p"), i + 1, n) }

fn main() : Unit / Stdout = {
  let e = build(Env { entries: [] }, 0, 200000)
  Stdout.print("n=#{list_length(e.entries)}")
}
