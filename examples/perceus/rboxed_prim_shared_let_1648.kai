# // skip-backend-parity — compile-only fixture: llvm_backend_tag is a
# compiler-internal prim with no kaix_ forwarder in the user-program
# native link; the Makefile assertion inspects the emitted C, never runs it.
# A prim whose C forwarder returns an RC-managed String (llvm_backend_tag)
# bound to a shared let, consumed by the condition of an if-valued let and
# reused in a later branch — the shape that dangles if the binder is
# misclassified as a non-RC handle and exempted from Perceus. Not run:
# the Makefile assertion compiles this with BOTH emitters and checks the
# consuming reads carry their dups in the emitted C.
type Cfg = { tag: String }

fn main() {
  let ntag = llvm_backend_tag()
  let nsel = if ntag != "" { "go" } else { "" }
  if nsel != "" {
    let cfg = Cfg { tag: ntag }
    print(cfg.tag)
  }
}
