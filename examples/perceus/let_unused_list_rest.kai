# A never-read list rest in a destructuring `let`, named or anonymous, still
# holds the tail it was bound to; the block must release it.

fn named(xs: [String]) : Int = {
  let [a, ...r] = xs
  a.length()
}

fn anon(xs: [String]) : Int = {
  let [a, b, ..._] = xs
  a.length() + b.length()
}

fn silenced(xs: [String]) : Int = {
  let [a, ..._r] = xs
  a.length()
}

fn go(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    let xs = [string_concat("x", "y"), string_concat("z", "w"), string_concat("u", "v")]
    go(n - 1, acc + named(xs) + anon(xs) + silenced(xs))
  }

fn main() : Unit / Stdout = Stdout.print("#{go(100, 0)}")
