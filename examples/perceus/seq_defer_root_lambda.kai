# `defer` is declared by the runtime and takes a function. A lambda that
# captures nothing, handed to it from the root file, must still reach it
# as an argument: there is no body to specialise the lambda into.

import seq

fn main() : Unit / Stdout = {
  let none = defer(() => SeqEnd)
  let one = defer(() => SeqCons(1, defer(() => SeqEnd)))
  Stdout.print("#{to_list(none)} #{to_list(one)}")
}
