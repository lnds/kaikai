# A match binder read from an Int slot and written back into an Int slot of
# a modulo-cons step, with values above 2^62, outside the range an Int is
# held unboxed in. A binder read boxed leaves one box behind per step. The
# offsets fold reads every slot back, so a lost write shows as a wrong sum.

type Color = Red | Black
type Tree = Leaf | Node(Color, Tree, Int, Tree)

fn base() : Int = 4611686018427387904

fn left(t: Tree) : Tree = match t {
  Node(_, a, _, _) -> a
  Leaf             -> Leaf
}

fn size(t: Tree) : Int = match t {
  Node(_, a, _, b) -> 1 + size(a) + size(b)
  Leaf             -> 0
}

fn offsets(t: Tree) : Int = match t {
  Node(_, a, k, b) -> k - base() + offsets(a) + offsets(b)
  Leaf             -> 0
}

fn red_int(t: Tree) : Int = match t {
  Node(Red, _, _, _) -> 10
  _                  -> 0
}

fn fresh(k: Int) : Tree = Node(Red, Node(Red, Leaf, k, Leaf), k, Leaf)

fn ins(t: Tree, k: Int) : Tree = match t {
  Node(c, l, kx, r) -> {
    let z = red_int(l)
    Node(c, left(l), kx, ins(r, k + z))
  }
  Leaf -> fresh(k)
}

fn build(i: Int, n: Int, t: Tree) : Tree = if i >= n { t } else { build(i + 1, n, ins(t, base() + i)) }

fn main() : Unit / Stdout = {
  let a = build(0, 200, Leaf)
  Stdout.print("size=#{size(a)} offsets=#{offsets(a)}")
}
