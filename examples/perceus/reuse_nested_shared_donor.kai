# Nested-rotation reuse over a donor that stays LIVE after the match: the
# rotated result and the original tree are both used afterwards. The
# shared branch must leave the donor's inner cell untouched (no drop) and
# dup the grand-children it embeds — otherwise the donor's later drop
# cascade walks a freed inner cell. The sums assert both trees keep their
# keys; the RC soundness is asserted by the ASAN + no-cell-pool gate.

type Color = Red | Black
type Tree = Leaf | Node(Color, Tree, Int, Tree)

fn rotate(t: Tree) : Tree = match t {
  Node(_, Node(Red, a, ak, b), k, r) ->
    Node(Red, Node(Black, a, ak, b), k, r)
  _ -> t
}

fn sum(t: Tree) : Int = match t {
  Leaf -> 0
  Node(_, l, k, r) -> k + sum(l) + sum(r)
}

fn main() : Int / Console = {
  let inner = Node(Red, Leaf, 1, Leaf)
  let t = Node(Black, inner, 2, Leaf)
  let out = rotate(t)
  print(int_to_string(sum(t)))
  print(int_to_string(sum(out)))
  0
}
