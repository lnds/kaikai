# An arm binder a nested lambda captures and the arm's tail reads again is
# paid once at the arm's exit: every read of it dups, so the birth reference
# is orphaned unless the exit drops it.

type Box = Box(String)

fn run(f: () -> Int) : Int = f()

fn consume(b: Box) : Int = match b { Box(s) -> string_length(s) }

fn pick(n: Int) : Option[Int] = if n > 0 { Some(n) } else { None }

fn go(o: Option[Box]) : Int = match o {
  None -> 0
  Some(c) -> {
    let g = run(() => consume(c))
    match pick(g) {
      None    -> consume(c)
      Some(_) -> consume(c) + 1
    }
  }
}

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(go(Some(Box("hello")))))
}
