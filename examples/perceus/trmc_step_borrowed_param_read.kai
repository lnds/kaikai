# A modulo-cons step re-passes an owned param that a helper only inspects.
# The helper borrows it, so the step still releases the slot's old value.

type Key = K(Int)
type Tree = Leaf | Node(Tree, Key, Tree)

fn below(a: Key, b: Key) : Bool = match a { K(x) -> match b { K(y) -> x < y } }

fn ins(t: Tree, k: Key) : Tree = match t {
  Node(l, kx, r) -> if below(k, kx) { Node(ins(l, k), kx, r) } else if below(kx, k) { Node(l, kx, ins(r, k)) } else { Node(l, k, r) }
  Leaf -> Node(Leaf, k, Leaf)
}

fn size(t: Tree) : Int = match t { Leaf -> 0  Node(l, _, r) -> size(l) + 1 + size(r) }

fn fill(i: Int, n: Int, t: Tree) : Tree = if i == n { t } else { fill(i + 1, n, ins(t, K((i * 7919) % 1000))) }

fn main() : Unit / Console = Stdout.print("size: " ++ int_to_string(size(fill(0, 1000, Leaf))))
