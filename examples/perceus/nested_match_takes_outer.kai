# An arm whose body matches on the result of its own recursive call takes its
# scrutinee apart as it starts, so the child it recurses into stays unique and
# is rebuilt in place: rotations both ways and a leaf answer, on unique and on
# shared trees.

type T = N(T, Int, T) | L

fn ins(t: T, k: Int) : T = match t {
  N(l, x, r) ->
    if k < x {
      match ins(l, k) {
        N(a, y, b) -> if y % 3 == 0 { N(a, y, N(b, x, r)) } else { N(N(a, y, b), x, r) }
        L -> N(L, x, r)
      }
    } else {
      match ins(r, k) {
        N(a, y, b) -> N(N(l, x, a), y, b)
        L -> N(L, x, L)
      }
    }
  L -> N(L, k, L)
}

fn size(t: T) : Int = match t {
  N(l, _, r) -> size(l) + 1 + size(r)
  L -> 0
}

fn height(t: T) : Int = match t {
  N(l, _, r) -> 1 + max(height(l), height(r))
  L -> 0
}

fn sig(t: T, acc: Int) : Int = match t {
  N(l, x, r) -> sig(r, (sig(l, acc) * 7 + x) % 1000003)
  L -> acc
}

fn fill(t: T, s: Int, n: Int) : T =
  if n <= 0 { t } else { fill(ins(t, s % 997), (s * 31 + 17) % 10007, n - 1) }

fn main() : Unit / Stdout {
  let u = fill(L, 5, 400)
  Stdout.print("unique: #{size(u)} #{height(u)} #{sig(u, 0)}")
  let base = fill(L, 11, 200)
  let grown = fill(base, 3, 100)
  Stdout.print(
    "shared: #{height(base)} #{sig(base, 0)} #{height(grown)} #{sig(grown, 0)} #{height(base)}"
  )
}
