fn count_x(s: String, i: Int, n: Int) : Int {
  let b = string.string_byte_at_int(s, i)
  if b < 0 { n } else if b == 120 { count_x(s, i + 1, n + 1) } else { count_x(s, i + 1, n) }
}

fn sum_len(s: String, i: Int, acc: Int) : Int =
  if i >= 1000 { acc } else { sum_len(s, i + 1, acc + string.string_length(s)) }

fn main() : Unit / Stdout = {
  let s = string.repeat("ax-", 4000)
  let t = string.repeat("é", 3)
  Stdout.print("#{count_x(s, 0, 0)}")
  Stdout.print("#{string.string_byte_at_int(s, 0 - 1)} #{string.string_byte_at_int(s, 12000)} #{string.string_byte_at_int(s, 11999)}")
  Stdout.print("#{string.string_byte_at_int(t, 0)} #{string.string_byte_at_int(t, 1)} #{string.string_byte_at_int(t, 6)}")
  Stdout.print("#{sum_len(s, 0, 0)} #{string.string_length(s)} #{string.string_length(t)} #{string.string_length("")}")
  Stdout.print("#{count_x(s, 0, 0) + string.string_length(s)}")
}
