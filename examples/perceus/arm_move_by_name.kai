# Two arms bind `l`. The first earns the move of `l` into its rebuild; the
# second must not inherit it: there `keep(l)` consumes and `is_red(l)` only
# borrows, so its `l` keeps a dup and its own exit release.

type Color = Red | Black
type Tree = Leaf | Node(Color, Tree, Int, Tree)

fn is_red(t: Tree) : Bool = match t {
  Node(Red, _, _, _) -> true
  _                  -> false
}

fn keep(t: Tree) : Tree = Node(Black, t, 1, Leaf)

fn size(t: Tree) : Int = match t {
  Node(_, a, _, b) -> 1 + size(a) + size(b)
  Leaf             -> 0
}

fn step(t: Tree) : Tree = match t {
  Node(Red, l, k, r)   -> Node(Black, l, k, r)
  Node(Black, l, k, r) -> Node(Black, keep(l), k + (if is_red(l) { 10 } else { 0 }), r)
  Leaf                 -> Leaf
}

fn go(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc }
  else { go(i + 1, n, acc + size(step(Node(Black, Node(Red, Leaf, i, Leaf), 2, Leaf)))) }

fn main() : Unit / Stdout = Stdout.print("sum=#{go(0, 1000, 0)}")
