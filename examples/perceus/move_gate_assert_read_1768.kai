# A param whose read in one arm sits inside an assert CONDITION while a
# sibling arm consumes it. The consuming-slots walker must scan the
# assert (it always evaluates) instead of skipping the statement; the
# skip-set move stays balanced because the callee takes ownership.
type Sel = SelA | SelB
type Box = { tag: String, n: Int }

fn peek(b: Box) : Int = b.n

fn taker(b: Box) : Int = match b {
  Box { tag: t, n: n } -> n + string_length(t)
}

fn route(sel: Sel, p: Box) : Int =
  match sel {
    SelA -> taker(p)
    SelB -> {
      assert peek(p) > 0
      7
    }
  }

fn spin(k: Int, acc: Int) : Int =
  if k == 0 { acc }
  else { spin(k - 1, acc + route(SelB, Box { tag: "b_#{k}", n: k }) + route(SelA, Box { tag: "a_#{k}", n: k })) }

fn main() : Unit / Stdout = {
  let total = spin(2000, 0)
  Stdout.print("total=#{total}")
}
