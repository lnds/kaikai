# An operand of a fused Vec write traps while the vec the write consumes is
# an owned temporary in flight: the landing pad releases it. One shape per
# case: a field, the index or the value of a record or scalar `vec_set` /
# `vec_push`, boxed and bare-word; the last case is a write the compiler
# does not fuse. C has no pads: the growth baseline pins what each trapped
# worker keeps there.

import actor
import spawn

type Flag = { on: Bool, n: Int }
type Point = { x: Int, y: Int }

fn flags(v: Vec[Flag], k: Int, n: Int) : Vec[Flag] =
  if k > n { v } else { flags(vec_push(v, Flag { on: k % 2 == 0, n: k }), k + 1, n) }

fn points(v: Vec[Point], k: Int, n: Int) : Vec[Point] =
  if k > n { v } else { points(vec_push(v, Point { x: k, y: k }), k + 1, n) }

fn ints(v: Vec[Int], k: Int, n: Int) : Vec[Int] =
  if k > n { v } else { ints(vec_push(v, k), k + 1, n) }

fn strs(v: Vec[String], k: Int, n: Int) : Vec[String] =
  if k > n { v } else { strs(vec_push(v, "s" ++ int_to_string(k)), k + 1, n) }

fn wild(k: Int) : Int = if k >= 0 { panic("wild operand") } else { k }

fn run_case(k: Int) : Int = match k % 10 {
  0 -> vec_length(vec_set(flags(vec_empty(), 1, 3), 0, Flag { on: true, n: wild(k) }))
  1 -> vec_length(vec_push(flags(vec_empty(), 1, 3), Flag { on: true, n: wild(k) }))
  2 -> vec_length(vec_set(flags(vec_empty(), 1, 3), wild(k), Flag { on: true, n: 1 }))
  3 -> vec_length(vec_set(points(vec_empty(), 1, 3), 0, Point { x: 1, y: wild(k) }))
  4 -> vec_length(vec_push(points(vec_empty(), 1, 3), Point { x: 1, y: wild(k) }))
  5 -> vec_length(vec_set(points(vec_empty(), 1, 3), wild(k), Point { x: 1, y: 2 }))
  6 -> vec_length(vec_set(ints(vec_empty(), 1, 3), 0, wild(k)))
  7 -> vec_length(vec_push(ints(vec_empty(), 1, 3), wild(k)))
  8 -> vec_length(vec_set(ints(vec_empty(), 1, 3), wild(k), 7))
  _ -> vec_length(vec_set(strs(vec_empty(), 1, 3), wild(k), "x"))
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = run_case(k)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 30)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
