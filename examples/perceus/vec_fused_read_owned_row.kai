# A field read out of a row that is itself the result of a read: the row is
# an owned temporary no binder holds, and the read releases it. Covers the
# boxed fusion (Bool, Char, Byte columns; every column on the C backend),
# the bare-word one (Int, Real), a row that is a slice, and element types
# the fusion does not take (String, record and Option fields).

type Flag = { on: Bool, n: Int }
type Glyph = { c: Char, b: Byte, w: Real }
type Named = { name: String, id: Int }
type Inner = { k: Int, s: String }
type Outer = { inner: Inner, tag: Int }
type Maybe = { opt: Option[Int], n: Int }

fn flags(v: Vec[Flag], k: Int, n: Int) : Vec[Flag] =
  if k > n { v } else { flags(vec_push(v, Flag { on: k % 2 == 0, n: k }), k + 1, n) }

fn glyphs(v: Vec[Glyph], k: Int, n: Int) : Vec[Glyph] =
  if k > n { v } else { glyphs(vec_push(v, Glyph { c: int_to_char(64 + k), b: 7u8, w: int_to_real(k) }), k + 1, n) }

fn nameds(v: Vec[Named], k: Int, n: Int) : Vec[Named] =
  if k > n { v } else { nameds(vec_push(v, Named { name: "n" ++ int_to_string(k), id: k }), k + 1, n) }

fn outers(v: Vec[Outer], k: Int, n: Int) : Vec[Outer] =
  if k > n { v } else { outers(vec_push(v, Outer { inner: Inner { k: k, s: "s" ++ int_to_string(k) }, tag: k }), k + 1, n) }

fn maybes(v: Vec[Maybe], k: Int, n: Int) : Vec[Maybe] =
  if k > n { v } else { maybes(vec_push(v, Maybe { opt: Some(k), n: k }), k + 1, n) }

fn on_at(rows: Vec[Vec[Flag]], i: Int, j: Int) : Bool = vec_get(vec_get(rows, i), j).on
fn n_at(rows: Vec[Vec[Flag]], i: Int, j: Int) : Int = vec_get(vec_get(rows, i), j).n
fn c_at(rows: Vec[Vec[Glyph]], i: Int, j: Int) : Char = vec_get(vec_get(rows, i), j).c
fn b_at(rows: Vec[Vec[Glyph]], i: Int, j: Int) : Byte = vec_get(vec_get(rows, i), j).b
fn w_at(rows: Vec[Vec[Glyph]], i: Int, j: Int) : Real = vec_get(vec_get(rows, i), j).w
fn name_at(rows: Vec[Vec[Named]], i: Int, j: Int) : String = vec_get(vec_get(rows, i), j).name
fn inner_at(rows: Vec[Vec[Outer]], i: Int, j: Int) : Inner = vec_get(vec_get(rows, i), j).inner
fn opt_at(rows: Vec[Vec[Maybe]], i: Int, j: Int) : Option[Int] = vec_get(vec_get(rows, i), j).opt

fn count_on(rows: Vec[Vec[Flag]], i: Int, j: Int, acc: Int) : Int =
  if i >= vec_length(rows) { acc }
  else if j >= 4 { count_on(rows, i + 1, 0, acc) }
  else { count_on(rows, i, j + 1, if on_at(rows, i, j) { acc + 1 } else { acc }) }

fn main() : Int / Stdout = {
  let fr = vec_push(vec_push(vec_empty(), flags(vec_empty(), 1, 4)), flags(vec_empty(), 5, 8))
  if on_at(fr, 0, 1) { Stdout.print("on") } else { Stdout.print("off") }
  if on_at(fr, 1, 0) { Stdout.print("on") } else { Stdout.print("off") }
  Stdout.print(int_to_string(n_at(fr, 1, 3)))
  Stdout.print(int_to_string(count_on(fr, 0, 0, 0)))

  let gr = vec_push(vec_push(vec_empty(), glyphs(vec_empty(), 1, 4)), glyphs(vec_empty(), 5, 8))
  Stdout.print(int_to_string(char_to_int(c_at(gr, 0, 0))))
  Stdout.print(int_to_string(char_to_int(c_at(gr, 1, 1))))
  Stdout.print(int_to_string(byte_to_int(b_at(gr, 1, 2))))
  Stdout.print(real_to_string(w_at(gr, 1, 3)))

  # A row that is a view of another vec.
  let sr = vec_push(vec_empty(), vec_slice(flags(vec_empty(), 1, 8), 2, 4))
  if on_at(sr, 0, 1) { Stdout.print("on") } else { Stdout.print("off") }
  Stdout.print(int_to_string(n_at(sr, 0, 3)))

  let nr = vec_push(vec_push(vec_empty(), nameds(vec_empty(), 1, 4)), nameds(vec_empty(), 5, 8))
  Stdout.print(name_at(nr, 0, 2) ++ name_at(nr, 1, 2))
  let orr = vec_push(vec_push(vec_empty(), outers(vec_empty(), 1, 4)), outers(vec_empty(), 5, 8))
  Stdout.print(inner_at(orr, 0, 2).s ++ inner_at(orr, 1, 2).s)
  let mr = vec_push(vec_push(vec_empty(), maybes(vec_empty(), 1, 4)), maybes(vec_empty(), 5, 8))
  match opt_at(mr, 1, 1) { Some(k) -> Stdout.print(int_to_string(k))  None -> Stdout.print("none") }
  0
}
