# A derived `to_json` encodes a record's fields one after another; a field
# whose encoder traps unwinds through the derived code while the fields
# already encoded are in flight. Native releases none of those yet
# (in-flight values have no pad): the growth baseline pins what each
# trapped worker keeps.

import actor
import spawn
import encoding.json.{json_encode}

type Boom = | Boom

impl Json for Boom {
  fn to_json(self: Boom) : JsonValue = panic("boom to_json")
  fn of_json(v: JsonValue, path: String) : Result[Boom, JsonError] = panic("boom of_json")
}

#[derive(Json)]
type Rec = { name: String, tags: [String], boom: Boom }

fn work(k: Int) : Int = {
  let r = Rec { name: "w#{k}", tags: ["a", "b"], boom: Boom }
  string_length(json_encode(to_json(r)))
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = work(k)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 30)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
