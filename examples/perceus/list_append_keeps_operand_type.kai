type Box = { items: [Int] }

effect Tick { tick() : Int }

fn grow(xs: [Int]) : [Int] = xs ++ [1]

fn main() {
  let b = Box { items: [2] }
  println("#{b.items ++ [3]}")
  println("#{[1, 2] |> grow}")
  let r = handle { Tick.tick() } with Tick {
    tick(resume) -> resume(0)
    return(x) -> [x] ++ [x + 1]
  }
  println("#{r}")
  let f = (xs: [Int]) => xs ++ xs
  println("#{f([7])}")
  let g = (xs: [Int]) => match xs { [] -> [0] ++ [] _ -> xs ++ [9] }
  println("#{g([])} #{g([4])}")
}
