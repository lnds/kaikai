# A `var` captured by a closure keeps its meaning: the closure sees the latest
# value, its writes are seen after it returns, closures nest, and a handler clause writes across `resume`.

effect Tick {
  tick() : Unit
}

fn each_of[a, e](xs: [a], f: (a) -> Unit / e) : Unit / e = match xs {
  [] -> ()
  [h, ...t] -> {
    f(h)
    each_of(t, f)
  }
}

fn latest() : Int {
  var x := 1
  let read = () => x
  x := 5
  read()
}

fn written_after() : Int {
  var n := 0
  each_of([1, 2, 3], i => {
    n := n + i
  })
  n
}

fn nested() : Int {
  var s := 0
  each_of([1, 2], i => {
    each_of([10, 20], j => {
      s := s + i * j
    })
  })
  s
}

fn in_clause() : Int {
  var seen := 0
  handle {
    Tick.tick()
    Tick.tick()
    Tick.tick()
  } with Tick {
    tick(resume) -> {
      seen := seen + 1
      resume(())
    }
    return(x) -> x
  }
  seen
}

fn main() {
  println(int_to_string(latest()))
  println(int_to_string(written_after()))
  println(int_to_string(nested()))
  println(int_to_string(in_clause()))
}
