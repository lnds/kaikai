# A root-file impl method is an ordinary callee: a borrowed binder passed
# to a slot the method consumes takes a reference of its own, so the
# caller's value and the stored one both stay live.

type Box = { n: Int, tag: String }

protocol Keep {
  keep(x: Self, acc: [Self]) : [Self]
}

impl Keep for Box {
  fn keep(x: Box, acc: [Box]) : [Box] = [x, ...acc]
}

fn via_impl(^b: Box) : [Box] = keep(b, [])

fn main() : Unit / Stdout = {
  let b = Box { n: 7, tag: string_concat("bo", "x") }
  let kept = via_impl(b)
  Stdout.print("#{b.n} #{b.tag}")
  match kept {
    [k, ..._] -> Stdout.print("#{k.n} #{k.tag}")
    []        -> Stdout.print("empty")
  }
}
