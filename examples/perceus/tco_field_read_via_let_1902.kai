# The field read bound to a block-let first — the let binder is not the
# trigger; the callee still releases, so no goto drop.
type Env = { entries: [String] }

fn env_prepend(e: Env, p: String) : Env = {
  let old = e.entries
  Env { entries: [p, ...old] }
}

fn build(e: Env, i: Int, n: Int) : Env =
  if i >= n { e } else { build(env_prepend(e, "p"), i + 1, n) }

fn main() : Unit / Stdout = {
  let e = build(Env { entries: [] }, 0, 200000)
  Stdout.print("n=#{list_length(e.entries)}")
}
