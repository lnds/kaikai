effect Em { em(v: String) : Unit }

fn src() : Unit / Em = {
  Em.em("a#{1}")
  Em.em("b#{2}")
}

fn relay(body: () -> Unit / Em) : () -> Unit / Em =
  () => handle { body() } with Em {
    em(x, resume) -> { Em.em(x); resume(()) }
  }

fn first(body: () -> Unit / Em) : String =
  handle { body(); "none" } with Em {
    em(x, _resume) -> x
  }

fn main() : Unit / Stdout = {
  Stdout.print(first(relay(src)))
  Stdout.print(first(relay(relay(src))))
}
