# A pure lambda passed to a higher-order fn that calls it at two sites
# holds a lambda of its own. Specialising the callee on it would paste the
# inner lambda twice under one identity: C rejects the duplicate, native
# keeps one copy for both sites.

fn app2(b: Bool, v: (Int) -> Int) : Int = if b { v(1) } else { v(2) }

fn main() : Unit / Stdout = {
  let a = app2(true, (v) => ((n) => n + 1)(v))
  let n = app2(true, (v) => ((n) => n + v)(10))
  let m = app2(false, (v) => ((n) => n + v)(10))
  Stdout.print("#{a} #{n} #{m}")
}
