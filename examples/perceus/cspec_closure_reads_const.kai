# A closure pasted into a specialised callee reads a constant the callee
# hides behind a binder of the same name: a parameter, a `let`, a list
# pattern's tail.

const k0 : Int = 11
const t : Int = 10

fn add_k0(n: Int) : Int = n + k0

fn tag(n: Int) : String = "#{n}/#{k0}"

fn under_param(k0: [Int], v: (Int) -> Int) : Int = v(length(k0))

fn under_let(v: (Int) -> Int, x: Int) : Int = {
  let k0 = x * 100
  v(x) + k0
}

fn label(v: (Int) -> String, k0: Int) : String = v(k0 + 1)

fn main() : Unit / Stdout {
  Stdout.print("#{under_param([1, 2, 3], (w) => w + k0)}")
  Stdout.print("#{under_param([1, 2, 3], add_k0)}")
  Stdout.print("#{under_let((n) => n + k0, 1)}")
  Stdout.print("#{map([1, 2, 3], (x) => x + t)}")
  Stdout.print(label(tag, 1))
}
