# A mutually recursive tail group fuses into one function whose slots hold a
# member's owned params in one state and nothing in the other.

fn ping(n: Int, acc: String, tag: String) : String =
  if n == 0 { acc ++ tag } else { pong(n - 1, acc ++ "a", tag ++ "b") }

fn pong(n: Int, acc: String, tag: String) : String =
  if n == 0 { acc } else { ping(n - 1, acc ++ "c", tag) }

fn main() : Unit / Stdout = {
  Stdout.print(ping(5, "", "t"))
  Stdout.print(pong(4, "x", "y"))
}
