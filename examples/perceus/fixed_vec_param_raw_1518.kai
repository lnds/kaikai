# A concrete fixed-width `Vec[t]<n>` PARAMETER read in RAW position. The
# sibling fixture covers the boxed reads; here every read is an ARITHMETIC
# OPERAND, which lowers through the raw path instead. The base is boxed
# either way — raw position changes what the loaded word becomes, never
# where it lives — so both must reach the element through the runtime.
# The values are what is under test: a GEP into the absent inline
# aggregate compiles fine and returns a word out of the `KaiValue` header.

fn sum2(v: Vec[Int]<3>) : Int = v[0] + v[1]

fn sum3(v: Vec[Int]<3>) : Int = v[0] + v[1] + v[2]

# one read, still raw: a single operand is as boxed as two
fn bump(v: Vec[Int]<3>) : Int = v[0] + 1

fn scale(v: Vec[Real]<2>) : Real = v[0] * v[1]

# a dynamic index through a boxed base, gated against the static length
fn twice_at(v: Vec[Int]<3>, i: Int) : Int = v[i] + v[i]

# a concrete parameter forwarded, then re-read raw in the same body
fn fwd(v: Vec[Int]<3>) : Int = sum3(v) + v[0]

fn nested(v: Vec[Int]<3>) : Int = sum3(v) + sum2(v)

# the generic form reads the same slot through the same runtime call
fn sum2g[n: Dim](v: Vec[Int]<n>) : Int = v[0] + v[1]

fn main() : Unit / Console = {
  let ints : Vec[Int]<3> = [10, 20, 30]
  let reals : Vec[Real]<2> = [1.5, 2.0]
  print(int_to_string(sum2(ints)))
  print(int_to_string(sum3(ints)))
  print(int_to_string(bump(ints)))
  print(real_to_string(scale(reals)))
  print(int_to_string(twice_at(ints, 1)))
  print(int_to_string(fwd(ints)))
  print(int_to_string(nested(ints)))
  print(int_to_string(sum2g(ints)))
  # an inline literal read in raw position stays inline: no border crossed
  print(int_to_string(ints[0] + ints[2]))
}
