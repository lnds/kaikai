# A range of Chars walks code points and is built as the list it denotes,
# so every list consumer reads it as it reads any `[Char]`.

fn first_or(xs: [Char], d: Char) : Char = match xs {
  [] -> d
  [h, ..._] -> h
}

fn count(xs: [Char], n: Int) : Int = match xs {
  [] -> n
  [_, ...t] -> count(t, n + 1)
}

fn between(lo: Char, hi: Char) : [Char] = [lo..hi]

fn every(lo: Char, next: Char, hi: Char) : [Char] = [lo, next..hi]

fn stride_count(lo: Char, next: Char, hi: Char) : Int = [lo, next..hi] |> length()

fn main() : Unit / Stdout = {
  Stdout.print(from_chars(['a'..'e']))
  Stdout.print(int_to_string(length(['e'..'a'])))
  Stdout.print(from_chars(['a', 'c'..'k']))
  Stdout.print(from_chars(['k', 'i'..'a']))
  Stdout.print(from_chars(between('x', 'z')))
  Stdout.print(from_chars(every('a', 'd', 'm')))
  Stdout.print(from_chars(every('z', 'x', 'r')))
  Stdout.print(from_chars(reverse(['a'..'e'])))
  Stdout.print(from_chars(['a'..'c'] ++ ['x'..'z']))
  Stdout.print(int_to_string(length(['a'..'z'])))
  Stdout.print(int_to_string(['a'..'z'] |> length()))
  Stdout.print(int_to_string(count(['α'..'ω'], 0)))
  Stdout.print(int_to_string(stride_count('a', 'd', 'm')))
  Stdout.print(int_to_string(stride_count('z', 'x', 'r')))
  Stdout.print(from_chars([first_or(['q'..'t'], '?'), first_or(['t'..'q'], '?')]))
  Stdout.print(from_chars(['a'..'e'] | char.to_upper))
  Stdout.print(int_to_string(['a'..'e'] | (c) => char_to_int(c) |> sum()))
  Stdout.print(from_chars(filter(['a'..'j'], (c) => char_to_int(c) % 2 == 0)))
  Stdout.print(if ['a'..'c'] == ['a', 'b', 'c'] { "eq-ok" } else { "eq-bad" })
  Stdout.print(show(['a'..'c']))
  let from_start = (c) => ['a'..c]
  Stdout.print(from_chars(from_start('d')))
  let to_end = (c) => [c..'d']
  Stdout.print(from_chars(to_end('b')))
  let caps: Vec[Char] = ['a'..'e'] | char.to_upper
  Stdout.print(from_chars([caps[0], caps[4]]))
}
