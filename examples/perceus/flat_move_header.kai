# A flat rebuild of read-only args moves into its unique scrutinee, keeping the
# header when it rebuilds the same constructor and retagging it when not; a
# shared scrutinee pays the children it embeds on its own branch. Unique and
# shared trees, a binder read twice, a nullary argument.

type Color = Red | Black

type T = Node(Color, T, Int, T) | Twin(Color, T, Int, T) | Leaf

fn paint(t: T) : T = match t {
  Node(_, l, x, r) -> Node(Black, l, x, r)
  Twin(c, l, x, r) -> Node(c, r, x, l)
  Leaf -> Leaf
}

fn swap(t: T) : T = match t {
  Node(c, l, x, r) -> Twin(c, l, x, r)
  Twin(_, l, x, r) -> Node(Red, l, x, r)
  Leaf -> Leaf
}

fn twice(t: T) : T = match t {
  Node(c, l, x, _) -> Node(c, l, x, l)
  Twin(_, _, x, r) -> Twin(Black, Leaf, x, r)
  Leaf -> Leaf
}

fn ins(t: T, k: Int) : T = match t {
  Node(c, l, x, r) -> if k < x { Node(c, ins(l, k), x, r) } else { Node(c, l, x, ins(r, k)) }
  Twin(c, l, x, r) -> if k < x { Twin(c, ins(l, k), x, r) } else { Twin(c, l, x, ins(r, k)) }
  Leaf -> if k % 3 == 0 { Twin(Red, Leaf, k, Leaf) } else { Node(Red, Leaf, k, Leaf) }
}

fn walk(t: T, n: Int) : T = if n <= 0 { t } else { walk(paint(swap(t)), n - 1) }

fn sig(t: T, acc: Int) : Int = match t {
  Node(Red, l, x, r) -> sig(r, (sig(l, acc) * 3 + x) % 1000003)
  Node(Black, l, x, r) -> sig(r, (sig(l, acc) * 7 + x) % 1000003)
  Twin(Red, l, x, r) -> sig(r, (sig(l, acc) * 11 + x) % 1000003)
  Twin(Black, l, x, r) -> sig(r, (sig(l, acc) * 13 + x) % 1000003)
  Leaf -> acc
}

fn fill(t: T, s: Int, n: Int) : T =
  if n <= 0 { t } else { fill(ins(t, s % 997), (s * 31 + 17) % 10007, n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("unique: #{sig(walk(fill(Leaf, 5, 300), 7), 0)} #{sig(twice(fill(Leaf, 7, 50)), 0)}")
  let base = fill(Leaf, 11, 200)
  let moved = walk(base, 5)
  Stdout.print(
    "shared: #{sig(base, 0)} #{sig(moved, 0)} #{sig(paint(base), 0)} #{sig(twice(base), 0)} #{sig(base, 0)}"
  )
}
