# A lambda in a mutual group captures the local that shadows a
# parameter, not the parameter.
fn ping(n: Int, x: Int) : Int =
  if n == 0 { x } else {
    let x = x + 100
    let add = (k: Int) => k + x
    pong(n - 1, add(1))
  }

fn pong(m: Int, acc: Int) : Int = ping(m, acc)

fn main() : Unit / Stdout = Stdout.print(int_to_string(ping(2, 0)))
