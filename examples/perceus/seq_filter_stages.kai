# A filter stage is read in place. Stages stacked on one another merge
# into one, so two thousand of them are read from a spawned fiber's small
# stack; a stage two readers hold keeps the step it computed; and a
# source two stages share is walked once.

import seq
import spawn

fn without(s: Seq[Int], n: Int) : Seq[Int] =
  if n == 0 { s } else { without(filter(s, (x) => x != n), n - 1) }

fn stacked(n: Int) : Int = nth(without(from(1), n), 0)

fn sieve(s: Seq[Int]) : Seq[Int] = match s {
  [] -> lazy []
  [p, ...xs] -> lazy [p, ...sieve(xs |? (x => x % p != 0))]
}

fn main() : Unit / Stdout + Spawn = {
  Stdout.print("#{stacked(2000)}")
  let deep = nursery { n ->
    let f = n.spawn(() => stacked(2000) + nth(sieve(lazy [2..]), 999))
    n.await(f)
  }
  Stdout.print("#{deep}")

  let evens = filter(from(1), (x) => x % 2 == 0)
  Stdout.print("#{to_list(take(evens, 3))} #{to_list(take(evens, 3))} #{nth(evens, 4)}")

  let src = from(1) | (x) => x * 3
  let a = filter(src, (x) => x % 2 == 0)
  let b = filter(src, (x) => x % 2 != 0)
  Stdout.print("#{to_list(take(a, 3))} #{to_list(take(b, 3))} #{to_list(take(a, 4))}")

  Stdout.print("#{to_list(filter(range(1, 10, 1), (x) => x > 100))}")
  Stdout.print("#{to_list(filter(lazy [1.5, 2.5, 3.5], (r) => r > 2.0))}")
  Stdout.print("#{to_list(filter(lazy ["a", "bb", "ccc"], (w) => string_length(w) != 2))}")
  Stdout.print("#{to_list(take(lazy [1..] |? (x => x % 3 == 0) |? (x => x % 2 == 0) | (x => x + 1), 3))}")
}
