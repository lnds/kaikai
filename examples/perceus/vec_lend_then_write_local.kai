# A local vector lent and then written in a straight line: each `let`
# below reads the vector it is about to write, and every write still
# lands in place. The gate requires zero copies.

fn chain(n: Int) : Int = {
  let a = vec_make(n, 3)
  let b = vec_set(a, 0, vec_get(a, 0) + vec_get(a, 1))
  let c = vec_set(b, 1, vec_length(b))
  let x = vec_get(c, 2)
  let d = vec_set(c, 2, x * x)
  vec_get(d, 0) + vec_get(d, 1) + vec_get(d, 2)
}

# The lend sits in the condition, the write in one branch only.
fn settle(n: Int, flip: Bool) : Int = {
  let a = vec_make(n, 7)
  let b = if vec_get(a, 0) > 0 and flip { vec_set(a, 0, vec_get(a, 1) + 1) } else { a }
  vec_get(b, 0)
}

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(chain(10)))
  Stdout.print(int_to_string(settle(4, true)))
  Stdout.print(int_to_string(settle(4, false)))
}
