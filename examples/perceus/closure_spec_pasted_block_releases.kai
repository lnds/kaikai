effect Em { em(v: String) : Unit }

type S = S(() -> Unit / Em)

fn run(s: S) : Unit / Em = match s { S(b) -> b() }

fn feed(xs: [String]) : Unit / Em = match xs {
  []        -> ()
  [h, ...t] -> { Em.em(h); feed(t) }
}

fn from(xs: [String]) : S = S(() => feed(xs))

fn pair(w: String) : S = from([w, "#{w}!"])

fn count(s: S) : Int =
  handle { run(s) } with Em(0) {
    em(_x, resume) -> resume((), state + 1)
    return(_u) -> state
  }

fn flat(s: S, f: (String) -> S) : S =
  S(() => handle { run(s) } with Em {
    em(x, resume) -> { run(f(x)); resume(()) }
  })

fn main() : Unit / Stdout =
  Stdout.print("#{count(flat(from(["a", "b", "c", "d"]), pair))}")
