# An owned match over a flat constructor pattern takes its cell apart as the
# arm starts: a sole owner hands its children to the binders and frees the
# shell alone; a shared cell gives each binder a reference of its own. Every
# shape below must release exactly what it owns on both paths.

type Colour = Red | Green

type Node
  = Leaf(String)
  | Pair(String, String)
  | Tagged(Colour, String, Int)
  | Wide(String, Real, String)

fn word(k: Int) : String = "w#{k}"

# A pointer slot no binder takes is released with the shell.
fn first(n: Node) : String = match n {
  Leaf(s)         -> s
  Pair(a, _)      -> a
  Tagged(_, s, _) -> s
  Wide(a, _, b)   -> "#{a}#{b}"
}

# The cell outlives the first match: its binders are dup'd, not moved.
fn twice(n: Node) : String = "#{first(n)}/#{first(n)}"

# The arm only inspects its binders and releases them itself.
fn size(n: Node) : Int = match n {
  Leaf(s)         -> string_length(s)
  Pair(a, b)      -> string_length(a) + string_length(b)
  Tagged(_, s, k) -> string_length(s) + k
  Wide(a, r, b)   -> string_length(a) + string_length(b) + real_to_int(r)
}

# An enum binder and a scalar binder hold no reference.
fn label(n: Node) : String = match n {
  Tagged(c, s, k) -> match c {
    Red   -> "red #{s} #{k}"
    Green -> "green #{s} #{k}"
  }
  _ -> "plain"
}

# A guard may reject the arm: the cell stays whole for the next one.
fn pick(n: Node) : String = match n {
  Pair(a, b) if string_length(a) > 2 -> b
  Pair(a, _)                         -> a
  _                                  -> "other"
}

fn run(k: Int, acc: Int) : Int = if k == 0 { acc } else {
  let a = size(Pair(word(k), word(k + 1)))
  let b = string_length(twice(Wide(word(k), 2.0, word(k))))
  let c = string_length(label(Tagged(if k % 2 == 0 { Red } else { Green }, word(k), k)))
  let d = string_length(pick(Pair(word(k), word(k * 100))))
  let e = size(Tagged(Green, word(k), 1)) + size(Wide(word(k), 3.0, word(k))) + size(Leaf(word(k)))
  run(k - 1, acc + a + b + c + d + e)
}

fn main() : Unit / Stdout = {
  Stdout.print(first(Pair("left", "right")))
  Stdout.print(twice(Tagged(Red, "t", 7)))
  Stdout.print(label(Tagged(Green, "g", 3)))
  Stdout.print(pick(Pair("long", "second")))
  Stdout.print(pick(Leaf("x")))
  Stdout.print(int_to_string(run(50, 0)))
}
