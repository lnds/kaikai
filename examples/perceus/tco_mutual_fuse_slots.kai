# A mutual tail-call group whose members take different parameters: the
# fused entry passes an absent value in the slots a member does not take,
# and the arms that never read it must leave the ledger balanced.
fn walk(xs: [String], seed: [String], n: Int, acc: Int) : Int =
  match xs {
    [] -> if n == 0 { acc } else { count("x" ++ int_to_string(n), seed, n - 1, acc) }
    [h, ...t] -> walk(t, seed, n, acc + string_length(h))
  }

fn count(s: String, seed: [String], n: Int, acc: Int) : Int =
  walk(seed, seed, n, acc + string_length(s))

fn main() : Unit / Stdout = {
  let seed = ["a", "bb"]
  Stdout.print("acc=#{walk(seed, seed, 200000, 0)}")
}
