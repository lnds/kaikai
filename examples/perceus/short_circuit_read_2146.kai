# An arm binder whose only read sits behind a short circuit, or in a
# guard, must be released on every path, whether or not the read runs.
# Covers `and` and `or` in an `if` condition, in a call argument and
# nested in each other, the arm's own guard, a nested guard that falls
# through to a later arm, a guard behind a refutable pattern, and a
# self-recursive `and` whose recursion is the skipped operand.

type Px = Px(String, Int) | NoPx

fn and_cond(p: Px) : Int = match p {
  Px(s, k) -> if k > 0 and string_length(s) > 2 { 1 } else { 7 }
  NoPx     -> 0
}

fn b2i(b: Bool) : Int = if b { 1 } else { 0 }

fn or_arg(p: Px) : Int = match p {
  Px(s, k) -> b2i(k == 0 or string_length(s) > 3) + k
  NoPx     -> 0
}

fn nested_sc(p: Px) : Int = match p {
  Px(s, k) -> if k == 1 or (k == 2 and string_length(s) > 2) { 1 } else { 3 }
  NoPx     -> 0
}

fn guard_own(p: Px) : Int = match p {
  Px(s, k) if k > 0 and string_length(s) > 2 -> 1
  Px(_, _)                                     -> 7
  NoPx                                         -> 0
}

fn guard_fall(p: Px) : Int = match p {
  Px(s, k) -> match k {
    0                        -> 7
    _ if string_length(s) > 3 -> 1
    _                        -> 2
  }
  NoPx -> 0
}

fn guard_refutable(p: Px) : Int = match p {
  Px(s, k) -> match k {
    0                        -> 7
    1 if string_length(s) > 3 -> 1
    _                        -> 2
  }
  NoPx -> 0
}

fn mk(i: Int, n: Int, m: Int, acc: [String]) : [String] =
  if i >= n { acc } else { mk(i + 1, n, m, [int_to_string(i % m), ...acc]) }

fn all_short(xs: [String]) : Bool = match xs {
  []        -> true
  [h, ...t] -> string_length(h) < 3 and all_short(t)
}

fn px(i: Int) : Px = Px(int_to_string(i * 7919), i % 3)

fn go(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc }
  else {
    let p = px(i)
    let a = and_cond(px(i)) + or_arg(px(i)) + nested_sc(px(i))
    let b = guard_own(px(i)) + guard_fall(px(i)) + guard_refutable(p)
    let c = if all_short(mk(0, 50 + i % 60, 1000, [])) { 1 } else { 0 }
    go(i + 1, n, acc + a + b + c)
  }

fn main() : Unit / Stdout = Stdout.print("total=#{go(0, 3000, 0)} deep=#{all_short(mk(0, 5000, 100, []))}")
