# Tuple destructured by `let`, the vector component then written.

fn fill(p: (Vec[Int], Int), i: Int) : (Vec[Int], Int) =
  if i >= 20000 { p }
  else {
    let (v, n) = p
    fill((vec_set(v, i, i), n + 1), i + 1)
  }

fn main() : Unit / Stdout = {
  let (v, n) = fill((vec_make(20000, 0), 0), 0)
  Stdout.print(int_to_string(vec_get(v, 19999) + n))
}
