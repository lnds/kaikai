# A match whose value is an Int or a Real joins its arms at a raw slot, on
# every decision path: variant, list, literal, record and guarded arms, a match
# nested in arithmetic, and a deep self-tail loop that must stay a loop.

type T = N(T, Int, T) | L

type P = { x: Int, y: Int }

fn mk(n: Int) : T = if n <= 0 { L } else { N(mk(n - 1), n, mk(n / 2)) }

fn size(t: T) : Int = match t {
  N(l, _, r) -> size(l) + 1 + size(r)
  L -> 0
}

fn weight(t: T) : Real = match t {
  N(l, k, r) -> weight(l) + int_to_real(k) * 0.5 + weight(r)
  L -> 0.25
}

fn total(xs: [Int]) : Int = match xs {
  [] -> 0
  [h, ...rest] -> h + total(rest)
}

fn digit(n: Int) : Int = match n {
  0 -> 10
  1 -> 20
  _ -> n * 3
}

fn corner(p: P) : Int = match p {
  { x: 0, y } -> y
  { x, y: 0 } -> x * 2
  { x, y } -> x + y
}

fn sign(n: Int) : Int = match n {
  k if k < 0 -> 0 - 1
  0 -> 0
  _ -> 1
}

fn nested(t: T, k: Int) : Int = 2 * (match t {
  N(_, x, _) -> x + k
  L -> k
}) + 1

fn count(n: Int, acc: Int) : Int = match n {
  0 -> acc
  _ -> count(n - 1, acc + n % 7)
}

fn main() : Unit / Stdout {
  let t = mk(10)
  Stdout.print("size: #{size(t)}")
  Stdout.print("weight: #{weight(t)}")
  Stdout.print("total: #{total([1, 2, 3, 4])}")
  Stdout.print("digit: #{digit(0)} #{digit(1)} #{digit(5)}")
  let a = corner(P { x: 0, y: 4 })
  let b = corner(P { x: 3, y: 0 })
  let c = corner(P { x: 2, y: 5 })
  Stdout.print("corner: #{a} #{b} #{c}")
  Stdout.print("sign: #{sign(0 - 4)} #{sign(0)} #{sign(9)}")
  Stdout.print("nested: #{nested(t, 3)} #{nested(L, 3)}")
  Stdout.print("count: #{count(1000000, 0)}")
}
