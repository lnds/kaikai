# A catch-all binder over an owned scrutinee (a call result) in a literal or
# a record match is returned by the arm: it must outlive the scrutinee's drop.
type Site = { site_id: String }
type Job = { site: Site, tests: [String] }
type Plan = { jobs: [Job], budget: Int }

fn tail_after_slash(p: String) : String = match index_of(p, "/") {
  None -> p
  Some(i) -> tail_after_slash(slice(p, i + 1, length(p)))
}

fn last_segment(p: String) : String = match tail_after_slash(p) {
  "" -> "EMPTY"
  other -> other
}

fn build(ids: [String]) : Plan =
  Plan { jobs: ids | (id) => Job { site: Site { site_id: id }, tests: ["t"] }, budget: 5 }

fn capped(ids: [String]) : Plan = match build(ids) {
  Plan { jobs: _, budget: 0 } -> Plan { jobs: [], budget: 0 }
  other -> other
}

fn chosen(ready: Plan) : [String] = ready.jobs | (c) => c.site.site_id

fn main() : Unit / Console = {
  println("[#{last_segment("/tmp/demo")}]")
  println(string_join(chosen(build(["a", "b", "c"])), ","))
  println(string_join(chosen(capped(["a", "b", "c"])), ","))
}
