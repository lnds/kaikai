# Chars below 128 are immortal cached cells. A variant whose slots are all
# such Chars must still get a real cell per construction: interning it
# would keep one immortal entry per distinct payload (128^n of them) and
# saturate the table.

type Px = Px(Char, Char, Char, Char) | NoPx

fn ch(n: Int) : Char = int_to_char(n % 128)

fn px_of(i: Int) : Px = Px(ch(i), ch(i / 128), ch(i / 16384), ch(7))

fn chan(p: Px) : Int = match p {
  Px(r, g, b, a) -> char_to_int(r) + char_to_int(g) + char_to_int(b) + char_to_int(a)
  NoPx           -> 0
}

fn px_sum(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else { px_sum(i + 1, n, acc + chan(px_of(i))) }

fn opt_of(i: Int) : Option[Char] = if i % 3 == 0 { None } else { Some(ch(i)) }

fn opt_sum(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else {
    let v = match opt_of(i) {
      Some(c) -> char_to_int(c)
      None    -> 0
    }
    opt_sum(i + 1, n, acc + v)
  }

fn main() : Unit / Stdout = {
  Stdout.print("px=#{px_sum(0, 70000, 0)}")
  Stdout.print("opt=#{opt_sum(0, 70000, 0)}")
}
