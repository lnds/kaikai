# A trap inside a shared cell's thunk leaves through the frame that was
# evaluating the cell: the cell gets its thunk back and that frame's
# reference is released, so a worker that dies there retains nothing of
# the sequence beyond what its own frames held.

import actor
import spawn
import seq

fn cell(k: Int, d: Int) : Seq[Int] = defer(() => SeqCons(100 / d, defer(() => SeqCons(k, defer(() => SeqEnd)))))

fn work(k: Int) : Int = {
  let s = cell(k, k - k)
  let a = nth(s, 0)
  a + nth(s, 1)
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = work(k)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 30)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
