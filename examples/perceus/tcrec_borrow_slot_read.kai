# A self-tail-call whose param is also read in a borrowed slot (`dst[j]`)
# still releases that param on every back-edge.

fn chain(ps: [Int], dst: Array[[Int]], cap: Int) : Unit / Mutable = match ps {
  []        -> ()
  [p, ...r] -> {
    let j = p % cap
    dst[j] := [p, ...dst[j]]
    chain(r, dst, cap)
  }
}

fn chain_let(ps: [Int], dst: Array[[Int]], cap: Int) : Unit / Mutable = match ps {
  []        -> ()
  [p, ...r] -> {
    let j = p % cap
    let old = dst[j]
    dst[j] := [p, ...old]
    chain_let(r, dst, cap)
  }
}

fn upto(i: Int, n: Int) : [Int] = if i >= n { [] } else { [i, ...upto(i + 1, n)] }

fn run(n: Int) : Int = {
  let a = array_make(4, [])
  let b = array_make(4, [])
  chain(upto(0, n), a, 4)
  chain_let(upto(0, n), b, 4)
  list_length(a[0]) + list_length(b[3])
}

fn main() : Unit / Stdout = Stdout.print("#{run(100)}")
