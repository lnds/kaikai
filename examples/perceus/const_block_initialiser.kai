# A constant has no storage: each read evaluates the initialiser and owns
# the value. An initialiser with locals of its own pays for them like a
# function body, however many times a local is read.

const TWO : String = {
  let a = [1, 2, 3]
  "two #{a} #{a}"
}

const DOUBLED : [Int] = {
  let a = [1, 2, 3]
  list_append(a, a)
}

const BASE : [Int] = {
  let a = [1, 2]
  [0, ...a]
}

const TWICE : [Int] = {
  let b = BASE
  list_append(b, b)
}

const PICK : String = {
  let xs = ["a", "b"]
  match xs {
    [h, ..._] -> h ++ h
    [] -> "none"
  }
}

const MAPPED : [Int] = {
  let k = [10, 20]
  map([1, 2, 3], x => x + list_length(k) + list_length(k))
}

const UNREAD : [Int] = {
  let a = [7]
  let b = [8]
  b
}

const N : Int = {
  let a = 5
  a + 1
}

const S : String = {
  let a = "in"
  a ++ a
}

# A reader's local is none of the constant's, whatever both are named.
fn shadow_int() : Int {
  let a = 100
  let y = N
  a + y
}

fn shadow_str() : String {
  let a = "out"
  let s = S
  a ++ s ++ a
}

fn main() : Unit / Stdout {
  Stdout.print(TWO)
  Stdout.print("#{DOUBLED}")
  Stdout.print("#{TWICE} #{BASE}")
  Stdout.print("#{PICK} #{MAPPED}")
  Stdout.print("#{UNREAD} #{N + N} #{S}#{S}")
  Stdout.print("#{shadow_int()} #{shadow_str()}")
  Stdout.print("#{TWO} #{list_length(DOUBLED)} #{list_length(TWICE)}")
}
