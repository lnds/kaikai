# Gap 4 shape: a param read once inside a string interpolation and once
# in a consuming call on the same path. The branch-aware skip gate counts
# paths with an engine blind to interpolations (EStr -> 0), so the param
# enters the skip set and BOTH reads transfer ownership raw — the interp
# read frees the value, the later call reads freed memory.
type Pack = MkPack(String, Int)

fn label_of(p: Pack) : String = match p {
  MkPack(s, _) -> s
}

fn weight_of(p: Pack) : Int = match p {
  MkPack(_, n) -> n
}

fn gap4_go(p: Pack) : Int / Stdout = {
  let msg = "pack: #{label_of(p)}"
  let n = weight_of(p)
  Stdout.print(msg)
  n
}

fn main() : Unit / Stdout = {
  let total = gap4_go(MkPack("alpha_#{1 + 1}", 7))
  Stdout.print("total=#{total}")
}
