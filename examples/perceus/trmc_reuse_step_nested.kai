# A TRMC fn whose rebuilds Perceus turns into in-place reuse. `Shape`'s
# rebuild sits under a nested match, so the fn takes the TRMC loop; `Dim`'s
# rebuild becomes a reuse of its own cell, and that reuse is still a step:
# the reused cell is the new hole and the step's dropmask pays what the
# arm owes. The nested arm leaves the enclosing arm's reuse token alone.

type Ty = Base | Var(Int) | Shape(Int, Ty) | Dim(Ty, Int)

fn lookup(k: Int) : Option[Int] = if k > 0 { Some(k * 10) } else { None }

fn canon(t: Ty) : Ty = match t {
  Shape(sv, a) -> match lookup(sv) {
    Some(b) -> Shape(b, canon(a))
    None    -> Shape(sv, canon(a))
  }
  Dim(a, u) -> Dim(canon(a), u)
  _         -> t
}

fn sum(t: Ty) : Int = match t {
  Base         -> 0
  Var(n)       -> n
  Shape(sv, a) -> sv + sum(a)
  Dim(a, u)    -> u + sum(a)
}

fn round(i: Int) : Int =
  sum(canon(Dim(Shape(i % 5, Dim(Var(i), 7)), 3))) + sum(canon(Dim(Var(i), 7)))

fn go(i: Int, acc: Int) : Int = if i == 0 { acc } else { go(i - 1, acc + round(i)) }

fn main() : Unit / Console = print(int_to_string(go(100, 0)))
