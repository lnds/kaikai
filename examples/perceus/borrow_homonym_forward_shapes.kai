# Neighbours of the forwarded-homonym shape. `count` and `index_of` share their
# names with borrowing `list` functions; `pass`, `eat` and `head` share
# none. Each binding is read again after the call, so a missing dup frees
# it early and an extra one leaks or double-frees.

fn eq(hay: String, needle: String) : Bool = string_slice(hay, 0, 4) == needle

fn peek(hay: String, needle: String) : Int = string_length(hay)

fn mk() : String = string_concat("ab", "cd")

# Homonym forwarding a built string to a consumer.
fn count(hay: String, needle: String) : Bool = eq(hay, needle)

# Homonym forwarding to a callee that never reads the value.
fn index_of(hay: String, needle: String) : Int = peek(hay, needle)

fn head(b: [Int]) : Int =
  match b {
    []        -> 0
    [h, ..._] -> h
  }

fn eat(a: [Int], b: [Int]) : Int = head(b)

fn pass(a: [Int], b: [Int]) : Int = eat(a, b)

fn main() : Int / Stdout {
  let built = mk()
  print("count=#{count("abcdyyy", built)} len=#{string_length(built)}")
  let lit = "abcd"
  print("index_of=#{index_of("abcdyyy", lit)} len=#{string_length(lit)}")
  print("direct=#{eq("abcdyyy", lit)} len=#{string_length(lit)}")
  let xs = [7, 8, 9]
  print("pass=#{pass([1, 2], xs)} head=#{head(xs)}")
  0
}
