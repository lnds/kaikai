# fixture: test
# A test body takes the same Perceus rewrite as a fn body: its locals are
# borrowed, moved and reused in place, and none leaks.
import loop

type P = { a: Int, b: Int }

fn build(n: Int, acc: [P]) : [P] = if n == 0 { acc } else { build(n - 1, [P { a: n, b: 0 }, ...acc]) }

fn total(xs: [P], s: Int) : Int = match xs {
  []           -> s
  [p, ...rest] -> total(rest, s + p.a)
}

test "update loop in a test body" {
  let xs = build(1000, [])
  var cur := xs
  var i := 0
  while { i < 200 } {
    cur := match cur {
      []           -> []
      [p, ...rest] -> [P { a: p.a + 1, b: p.b }, ...rest]
    }
    i := i + 1
  }
  assert total(cur, 0) == 500700
}

bench "update loop in a bench body" {
  let xs = build(100, [])
  var cur := xs
  var i := 0
  while { i < 20 } {
    cur := match cur {
      []           -> []
      [p, ...rest] -> [P { a: p.a + 1, b: p.b }, ...rest]
    }
    i := i + 1
  }
  total(cur, 0)
}
