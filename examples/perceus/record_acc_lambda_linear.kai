# A record accumulator threaded through a fold lambda is handed on, not
# dup'd: the lambda's own binders are not captures, so the Vec inside the
# record keeps one reference at every write.

type Acc = { buf: Vec[Int], n: Int }

fn put(a: Acc, i: Int) : Acc = Acc { buf: vec_set(a.buf, i, i), n: a.n + 1 }

fn fill(n: Int) : Acc =
  list.foldl([0..n - 1], Acc { buf: vec_make(n, 0), n: 0 }, (acc, i) => {
    let a1 = put(acc, i)
    let a2 = put(a1, i)
    a2
  })

fn rebuild(n: Int) : Vec[Int] =
  list.foldl([0..n - 1], vec_make(n, 0), (acc, i) => {
    let w = vec_set(acc, i, 1)
    let x = vec_set(w, i, 2)
    x
  })

fn main() : Unit / Stdout = {
  let n = 100000
  let a = fill(n)
  Stdout.print(int_to_string(a.n + vec_get(a.buf, n - 1)))
  Stdout.print(int_to_string(vec_get(rebuild(n), n - 1)))
}
