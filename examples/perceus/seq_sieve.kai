# The unbounded prime sieve over lazy cells: one filter stage per prime
# found, each a cell holding a closure. Every cell read through `primes`
# is computed once; the walk to the thousandth prime releases nothing
# early, since `primes` is still read afterwards.

import seq

fn sieve(xs: Seq[Int]) : Seq[Int] = defer(() => match force(xs) {
  SeqEnd           -> SeqEnd
  SeqCons(p, rest) -> SeqCons(p, sieve(rest |? (x) => x % p != 0))
})

fn main() : Unit / Stdout = {
  let primes = sieve(from(2))
  primes |> take_while((p) => p <= 97) |> each((p) => Stdout.print("#{p}"))
  Stdout.print("#{primes |> nth(999)}")
  Stdout.print("#{primes |> nth(999)}")
}
