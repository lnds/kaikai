# A variant reuse arm that rebuilds its donor through a nested pattern binds
# every binder beneath the deconstructed inner cells.

type Blk = Blk([Int], Option[Int], Int, Int)
type D = Eff(String, Option[Blk], Int) | Other

fn bump(x: Int) : Int = x + 1

fn g(d: D) : D = match d {
  Eff(n, Some(Blk(cs, ret, bl, bc)), l) -> Eff(n, Some(Blk(map(cs, bump), ret, bl, bc)), l)
  _ -> d
}

fn total(d: D) : Int = match d {
  Eff(_, Some(Blk(cs, _, _, _)), _) -> list.sum(cs)
  _ -> 0
}

fn main() : Unit / Stdout = Stdout.print("#{total(g(Eff("e", Some(Blk([1, 2], None, 0, 0)), 0)))}")
