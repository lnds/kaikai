# Tuple and nested record patterns, with a guard that never reads the vector.

type In = { buf: Vec[Int], k: Int }
type Out = { inner: In, n: Int }

fn fill_tuple(p: (Vec[Int], Int)) : (Vec[Int], Int) = match p {
  (v, n) -> if n >= 20000 { (v, n) } else { fill_tuple((vec_set(v, n, n), n + 1)) }
}

fn fill_nested(o: Out) : Out = match o {
  Out { inner: In { buf, k }, n } ->
    if n >= 20000 { o_of(buf, k, n) }
    else { fill_nested(Out { inner: In { buf: vec_set(buf, n, n), k: k }, n: n + 1 }) }
}

fn o_of(buf: Vec[Int], k: Int, n: Int) : Out = Out { inner: In { buf: buf, k: k }, n: n }

fn fill_guard(o: In, i: Int) : In = match o {
  In { buf, k } if i < 20000 -> fill_guard(In { buf: vec_set(buf, i, i + k), k: k }, i + 1)
  In { buf, k } -> In { buf: buf, k: k }
}

fn main() : Unit / Stdout = {
  let (a, _) = fill_tuple((vec_make(20000, 0), 0))
  let b = fill_nested(Out { inner: In { buf: vec_make(20000, 0), k: 1 }, n: 0 })
  let c = fill_guard(In { buf: vec_make(20000, 0), k: 2 }, 0)
  Stdout.print(int_to_string(vec_get(a, 19999) + vec_get(b.inner.buf, 19999) + vec_get(c.buf, 19999)))
}
