# An arm binder projected in an `if` condition and handed to a call in both
# branches. The positionally last read moves the birth ref; the first
# branch's read must not keep a dup nobody releases.
type Delim = { count: Int, closes: Bool, opens: Bool }

type Tok = TI(Int) | TD(Delim)

type Em = { frames: [Delim], base: [Int] }

fn take(em: Em, d: Delim) : Em =
  if d.count == 0 { em } else { Em { frames: [d, ...em.frames], base: em.base } }

fn run(toks: [Tok], em: Em) : Em = match toks {
  []            -> em
  [TI(x), ...t] -> run(t, Em { frames: em.frames, base: [x, ...em.base] })
  [TD(d), ...t] -> run(t, if d.closes { take(em, d) } else { take(em, d) })
}

fn build(n: Int, acc: [Tok]) : [Tok] =
  if n == 0 { acc }
  else { build(n - 1, [TD(Delim { count: 1, closes: n > 1000, opens: false }), TI(n), ...acc]) }

fn main() : Unit / Stdout = {
  let e = run(build(2000, []), Em { frames: [], base: [] })
  Stdout.print("frames=#{list.length(e.frames)} base=#{list.length(e.base)}")
}
