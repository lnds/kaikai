# Int wrapping discipline across the full operator family. Every line
# overflows (or shifts at/past the width) and must print the exact
# two's-complement wrap on both backends, with no UB under
# `-fsanitize=undefined`:
#   - bit_shl: shifted-out bits drop (uint64 compute); count masked & 63
#   - bit_shr / bit_ushr / bit_test / bit_set / bit_clear / bit_toggle:
#     count masked & 63; bit 63 reachable
#   - unary minus: -Int.MIN wraps to Int.MIN
#   - `^`: an overflowing power wraps like `*`, on the raw unrolled
#     path (literal exponent) and the boxed helper (variable exponent)

fn main() = {
  let big = 5840696475078001361
  print_int(bit_shl(big, 1))
  print_int(bit_shl(1, 64))
  print_int(bit_shl(-1, 63))
  print_int(bit_shr(-8, 1))
  print_int(bit_shr(-1, 64))
  print_int(bit_ushr(-1, 4))
  print_int(bit_ushr(big, 14))
  print_int(bit_set(0, 63))
  print_int(bit_clear(-1, 63))
  print_int(bit_toggle(0, 63))
  if bit_test(bit_set(0, 63), 63) { print_int(1) } else { print_int(0) }
  let min = -9223372036854775807 - 1
  print_int(-min)
  let b = 3
  print_int(b ^ 41)
  let e = 41
  print_int(b ^ e)
  0
}

fn print_int(n: Int) : Unit / Stdout = Stdout.print(int_to_string(n))
