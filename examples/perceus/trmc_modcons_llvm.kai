# TRMC for the builtin cons, held to value parity across backends.
# `map_inc` lowers to a constructor-context loop; `dup_each`'s nested
# `[h, ...[h, ...dup_each(t)]]` is not a single modulo-cons site and stays
# ordinary recursion. A wrong hole plug or loop-param rebind prints a
# different row on one backend.

fn map_inc(xs: [Int]) : [Int] =
  match xs {
    [] -> []
    [h, ...t] -> [h + 1, ...map_inc(t)]
  }

fn dup_each(xs: [Int]) : [Int] =
  match xs {
    [] -> []
    [h, ...t] -> [h, ...[h, ...dup_each(t)]]
  }

fn show(xs: [Int]) : Unit / Stdout =
  match xs {
    [] -> Stdout.print("end")
    [h, ...t] -> { Stdout.print(int_to_string(h)); show(t) }
  }

fn main() : Int / Stdout = {
  show(map_inc([10, 20, 30]))
  show(dup_each([1, 2]))
  0
}
