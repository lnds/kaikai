# Every constant whose type holds a sequence is read through one value:
# one written without a lambda, one holding a step, one holding a record
# with a sequence in a field, and two that are defined through each
# other.

import seq

type Named = { label: String, items: Seq[Int] }

const NATS : Seq[Int] = from(1)

const FIRST : SeqStep[Int] = force(NATS)

const TENS : Named = Named { label: "tens", items: NATS | (x) => x * 10 }

const EVENS : Seq[Int] = defer(() => SeqCons(0, ODDS | (x) => x + 1))

const ODDS : Seq[Int] = EVENS | (x) => x + 1

fn head_of(s: SeqStep[Int]) : Int = match s {
  SeqEnd        -> 0
  SeqCons(x, _) -> x
}

fn main() : Unit / Stdout = {
  Stdout.print("#{nth(NATS, 4)} #{nth(NATS, 9)} #{head_of(FIRST)}")
  Stdout.print("#{TENS.label} #{to_list(take(TENS.items, 3))}")
  Stdout.print("#{nth(EVENS, 2000)} #{nth(ODDS, 2000)}")
}
