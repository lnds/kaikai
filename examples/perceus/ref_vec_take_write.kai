# A `Vec` in a `Ref` written from its own read: the read leaves with the
# cell's reference and the store refills the cell, so every write is in
# place. The gate reads the `vec_inplace` / `vec_cow` counters.

import collections.vec

fn fill(r: Ref[Vec[Int]], i: Int, n: Int) : Unit / Mutable =
  if i == n {
    ()
  } else {
    r := vec.set(@r, i, i)
    fill(r, i + 1, n)
  }

fn each_of[a, e](xs: [a], f: (a) -> Unit / e) : Unit / e = match xs {
  [] -> ()
  [h, ...t] -> {
    f(h)
    each_of(t, f)
  }
}

fn range(i: Int, n: Int) : [Int] = if i == n { [] } else { [i, ...range(i + 1, n)] }

fn sum(v: Vec[Int], i: Int, acc: Int) : Int =
  if i == vec.length(v) { acc } else { sum(v, i + 1, acc + vec.get(v, i)) }

fn main() {
  let n = 100
  let a = &vec.make(n, 0)
  fill(a, 0, n)
  println(int_to_string(sum(@a, 0, 0)))

  let b = &vec.make(n, 0)
  each_of(range(0, n), i => {
    b := vec.set(@b, i, i * 2)
  })
  println(int_to_string(sum(@b, 0, 0)))
}
