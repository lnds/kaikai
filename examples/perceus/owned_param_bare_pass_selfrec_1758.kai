# Issue #1758 shape: a self-recursive fn whose owned String param is (a)
# consumed by the `==` in an if CONDITION sitting in a non-recursive tail
# arm and (b) re-threaded through the self-call in a sibling arm. The
# borrow-discounted path count is 1 and the flat count is 2, so the param
# is a borrow-move-last candidate — every read transfers raw while the
# exit drop stays for the base arms. The if condition evaluates on the
# base path too: its consuming read plus the exit drop releases one ref
# twice, and the caller (which donated a dup and kept its own ref) frees
# a dead value.
type Stamp = SMod(Option[String]) | SPlain(Int)

fn home_of(ds: [Stamp], target_mod: String) : Option[String] =
  match ds {
    [] -> None
    [d, ...rest] -> match d {
      SMod(mo) -> match mo {
        Some(m) -> if m == target_mod { None } else { Some(m) }
        None -> None
      }
      _ -> home_of(rest, target_mod)
    }
  }

fn tag_of(o: Option[String]) : String = match o {
  Some(s) -> s
  None -> "root"
}

# The caller keeps its own ref across the call (dup at the call site,
# re-thread through its own self-recursion) — the #1758 lower_impls shape.
fn walk(ds: [[Stamp]], target_mod: String, acc: [String]) : [String] =
  match ds {
    [] -> list_reverse(acc)
    [g, ...rest] -> {
      let from = home_of(g, target_mod)
      let key = tag_of(from)
      walk(rest, target_mod, [key, ...acc])
    }
  }

fn main() : Unit / Stdout = {
  # Interpolation keeps the param off any static-literal exemption.
  let tm = "mod_#{1 + 2}"
  let groups = [
    [SPlain(1), SMod(Some("alpha"))],
    [SMod(Some("mod_3"))],
    [SPlain(2), SPlain(3), SMod(Some("beta"))],
    [SMod(None)]
  ]
  let r = walk(groups, tm, [])
  Stdout.print("seen=#{string_join(r, ",")} tm=#{tm}")
}
