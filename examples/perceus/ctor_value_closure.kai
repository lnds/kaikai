type Box = Box(String) | Empty
type Pair2 = Pair2(Int, Int)

fn size(b: Box) : Int = match b {
  Box(s) -> string_length(s)
  Empty  -> 0
}

fn total(bs: [Box], acc: Int) : Int = match bs {
  []           -> acc
  [b, ...rest] -> total(rest, acc + size(b))
}

fn build(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc }
  else {
    let f = Box
    let g = Pair2
    let p = g(i, 1)
    let k = match p { Pair2(a, b) -> a + b }
    build(i + 1, n, acc + size(f(int_to_string(i))) + k)
  }

fn main() : Unit / Stdout {
  let xs = [0..1999] | (i) => int_to_string(i)
  let boxed = xs | Box
  let pairs = [0..1999] | Some
  let tag = "k"
  let capturing = xs | (s => Box(string_concat(tag, s)))
  Stdout.print("#{total(boxed, 0)} #{length(pairs)} #{total(capturing, 0)} #{build(0, 2000, 0)}")
}
