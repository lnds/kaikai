# An out-of-range read traps inside the argument of the write that takes
# the same vector: the read only borrowed it, so the frame still owns it
# and the landing pad releases it. One case reads a bare-word element, the
# other a boxed one. C has no pads: the growth baseline pins what each
# trapped worker keeps there.

import actor
import spawn

fn ints(v: Vec[Int], k: Int, n: Int) : Vec[Int] =
  if k > n { v } else { ints(vec_push(v, k), k + 1, n) }

fn strs(v: Vec[String], k: Int, n: Int) : Vec[String] =
  if k > n { v } else { strs(vec_push(v, "s" ++ int_to_string(k)), k + 1, n) }

fn bump(v: Vec[Int], k: Int) : Vec[Int] = vec_set(v, 0, vec_get(v, 9 + k) + 1)

fn shout(v: Vec[String], k: Int) : Vec[String] = vec_set(v, 0, vec_get(v, 9 + k) ++ "!")

fn run_case(k: Int) : Int = match k % 2 {
  0 -> vec_length(bump(ints(vec_empty(), 1, 3), k))
  _ -> vec_length(shout(strs(vec_empty(), 1, 3), k))
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = run_case(k)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 30)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
