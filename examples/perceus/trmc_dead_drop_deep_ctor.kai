# The constructor form of a dead-drop filter: the skipping branch drops
# the arm's `l` and the other rebuilds `Node(l, v, sift(r, unused))`. The
# rebuild must still lower to a modulo-cons step; a 1M-deep spine
# overflows the stack if it recurses. Skips are rare, so the depth under
# test is the rebuild's.

type Tree = Leaf | Node(Tree, Int, Tree)

fn sift(t: Tree, unused: String) : Tree = match t {
  Leaf          -> Leaf
  Node(l, v, r) -> if v % 10000 != 0 { Node(l, v, sift(r, unused)) } else { sift(r, unused) }
}

fn spine(n: Int, acc: Tree) : Tree =
  if n == 0 { acc } else { spine(n - 1, Node(Leaf, n, acc)) }

fn walk(t: Tree, acc: Int) : Int = match t {
  Leaf          -> acc
  Node(_, v, r) -> walk(r, acc + v)
}

fn main() : Unit / Stdout =
  Stdout.print("#{walk(sift(spine(1000000, Leaf), "tag"), 0)}")
