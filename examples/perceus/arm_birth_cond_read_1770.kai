# A cons-arm binder whose reads all sit in the tail of a goto-tail arm:
# a field projection and a call in the if condition whose callee only
# inspects its argument (borrowed slot). Neither read pays the bind's
# birth ref, and the goto skips every exit that could release it — the
# arm-drop pass must close each self-call leaf with a distributed drop,
# or one record plus its string leak per iteration.
type Pair = { a: Int, b: String }

fn eats(p: Pair) : Bool = match p { Pair { a: x, b: _ } -> x > 2 }

fn walk(xs: [Pair], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> {
    let w = h.a
    if eats(h) { walk(t, acc + w + 1) } else { walk(t, acc + w) }
  }
}

fn build(n: Int, acc: [Pair]) : [Pair] =
  if n == 0 { acc } else { build(n - 1, [Pair { a: n, b: "p_#{n}" }, ...acc]) }

fn main() : Unit / Stdout = {
  let total = walk(build(3000, []), 0)
  Stdout.print("total=#{total}")
}
