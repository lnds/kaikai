# Issue #1681 — a borrow-move param consumed in a base tail's match
# SCRUTINEE must keep its dup, or the exit wrap releases the ref twice.
#
# `pick` re-threads `digits` through its self-tail-call, so the borrow-move
# selection makes every read raw (no dup). That is sound only while each
# base tail leaves `digits` alone: the exit wrap still drops it there. The
# tail-scan that enforces this walked a match's ARMS but skipped its
# SCRUTINEE, so `match list.nth(digits, i) { ... }` — the one place the base
# tail consumes `digits` — went unseen. The raw read handed the birth ref to
# `nth`, the exit drop released it again, and the freed cons cell came back
# from the allocator as part of an unrelated list: `nth` then returned a
# Char where an Int was due and the runtime's `+` guard aborted.
#
# The recycled cell is what makes this visible without a sanitizer. The
# golden pins both consequences: the lookup result, and the survival of the
# list the caller still holds.

import core.list

fn pick(letters: [Char], digits: [Int], c: Char, i: Int) : Int =
  match list.nth(letters, i) {
    None    -> 0
    Some(l) -> if l == c { match list.nth(digits, i) { Some(d) -> d None -> 0 } }
               else { pick(letters, digits, c, i + 1) }
  }

fn main() : Int / Stdout = {
  let ds = [7, 8, 9]
  let got = pick(['A', 'B', 'C'], ds, 'C', 0)
  Stdout.print(int_to_string(got))
  Stdout.print(int_to_string(list.length(ds)))
  0
}
