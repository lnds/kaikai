# A TRMC fn's base case still owes the owned params it never hands on. A
# modulo-cons step pays them through its dropmask; the apply leaf that ends
# the recursion must pay them itself, or each call keeps one reference.
#
# `stars` is the stdlib `list.repeat` shape (the base case drops the element),
# `keep` filters with a String it only reads, and `upto` builds an Int list
# under an `if` whose base case leaves its String unread.

import core.list

fn keep(xs: [Int], s: String) : [Int] = match xs {
  []        -> []
  [h, ...t] -> if h > string_length(s) { [h, ...keep(t, s)] } else { keep(t, s) }
}

fn upto(s: String, i: Int, n: Int) : [Int] =
  if i >= n { [] } else { [i + string_length(s), ...upto(s, i + 1, n)] }

fn round(i: Int) : Int = {
  let s = string_concat("ab", int_to_string(i))
  let stars = list.repeat(string_concat("*", s), i % 3)
  list_length(stars) + list_length(keep([1, 5, 9], s)) + list_length(upto(s, 0, i % 4))
}

fn go(n: Int, acc: Int) : Int = if n == 0 { acc } else { go(n - 1, acc + round(n)) }

fn main() : Unit / Stdout = Stdout.print("#{go(300, 0)}")
