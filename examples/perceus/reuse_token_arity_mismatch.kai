# Reuse tokens that cannot host the rebuild, and Bool matches read through a join.
#
# Each arm consumes a node of one arity and rebuilds a node of another, so
# the arm's reuse token never fits: the rebuild must free it and allocate.
# Converting a list that is still alive forces the shared path, where no
# token exists at all.

type Chain = One(Int, Chain) | Two(Int, Int, Chain) | End

fn widen(c: Chain) : Chain = match c {
  One(x, rest) -> Two(x, x * 2, widen(rest))
  Two(x, y, rest) -> One(x + y, widen(rest))
  End -> End
}

fn is_two(c: Chain) : Bool = match c {
  Two(_, _, _) -> true
  _ -> false
}

fn twos(c: Chain, acc: Int) : Int = match c {
  End -> acc
  One(_, rest) -> twos(rest, acc)
  Two(_, _, rest) -> twos(rest, if is_two(c) { acc + 1 } else { acc })
}

fn total(c: Chain, acc: Int) : Int = match c {
  End -> acc
  One(x, rest) -> total(rest, acc + x)
  Two(x, y, rest) -> total(rest, acc + x * 3 + y)
}

fn build(n: Int, acc: Chain) : Chain =
  if n <= 0 {
    acc
  } else if n % 3 == 0 {
    build(n - 1, Two(n, n + 1, acc))
  } else {
    build(n - 1, One(n, acc))
  }

fn report(name: String, c: Chain) : Unit / Stdout =
  Stdout.print("#{name}: twos=#{twos(c, 0)} total=#{total(c, 0)}")

fn main() : Unit / Stdout {
  let base = build(300, End)
  let wide = widen(base)
  report("base", base)
  report("wide", wide)
  report("back", widen(widen(wide)))
}
