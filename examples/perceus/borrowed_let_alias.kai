# A `let` that binds a borrowed param holds no reference of its own unless
# the binding takes one: the caller still owns the value. Releasing the
# alias, or moving it into a consumer, frees the caller's list, and the
# caller's next read sees freed memory. The ledger stays balanced when
# that happens, so the guard is the printed length: each caller's list
# must still read `len=3` after it was lent twice.

fn mk() : [Int] = [1, 2, 3]

fn unread_alias(^xs: [Int]) : Int = {
  let _ys = xs
  7
}

fn read_alias(^xs: [Int]) : Int = {
  let ys = xs
  list_length(ys)
}

fn branch_alias(^xs: [Int], flag: Bool) : Int = {
  let _ys = if flag { xs } else { mk() }
  7
}

# The inner `xs` shadows the borrowed param and owns its own list.
fn shadowed(^xs: [Int]) : Int = {
  let xs = mk()
  let ys = xs
  list_length(ys)
}

fn no_alias(^xs: [Int]) : Int = 7

fn lend_unread() : String = {
  let p = mk()
  let a = unread_alias(p) + unread_alias(p)
  "#{a} len=#{list_length(p)}"
}

fn lend_read() : String = {
  let p = mk()
  let a = read_alias(p) + read_alias(p)
  "#{a} len=#{list_length(p)}"
}

fn lend_branch() : String = {
  let p = mk()
  let a = branch_alias(p, true) + branch_alias(p, false)
  "#{a} len=#{list_length(p)}"
}

fn lend_shadowed() : String = {
  let p = mk()
  let a = shadowed(p) + shadowed(p)
  "#{a} len=#{list_length(p)}"
}

fn lend_control() : String = {
  let p = mk()
  let a = no_alias(p) + no_alias(p)
  "#{a} len=#{list_length(p)}"
}

fn main() : Unit / Stdout = {
  Stdout.print(lend_unread())
  Stdout.print(lend_read())
  Stdout.print(lend_branch())
  Stdout.print(lend_shadowed())
  Stdout.print(lend_control())
}
