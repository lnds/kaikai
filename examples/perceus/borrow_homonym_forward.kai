# `find` shares its name with `list.find`, which borrows its argument at
# position 1. The caller must still pass `sep` owned: this `find` forwards
# it to `eq`, which consumes it, and `sep` is read again afterwards.

fn eq(hay: String, needle: String) : Bool = string_slice(hay, 0, 4) == needle

fn find(hay: String, needle: String) : Bool = eq(hay, needle)

fn main() : Int / Stdout {
  let sep = "abcd"
  print("eq=#{find("abcdyyy", sep)}")
  print("len=#{string_length(sep)}")
  0
}
