# A failing `!` returns early: what the function still owns past it is
# released on that path too, wherever the `!` sits.

type Box = Box(String, [Int])

effect Tick {
  tick(n: Int) : Int
}

effect Stop {
  stop(msg: String) : Nothing
}

fn parse(s: String) : Result[Int, String] =
  if string_length(s) > 0 { Ok(string_length(s)) } else { Err("empty") }

fn total(a: String, b: String) : Result[Int, String] {
  let x = parse(a)!
  let y = parse(b)!
  Ok(x + y)
}

fn pick(flag: Bool, a: String, b: String) : Result[Int, String] {
  let n = if flag { 0 } else { parse(a)! }
  Ok(n + string_length(b))
}

fn join2(xs: [String], s: String) : String = "#{list_length(xs)}#{s}"

fn shaped(a: String, b: String) : Result[String, String] = Ok(join2([a, b], "#{parse(a)!}"))

fn mk(s: String) : Box = Box("b#{s}", [1, 2])

fn in_arm(t: String, s: String) : Result[Int, String] = match mk(t) {
  Box(name, xs) -> {
    let n = parse(s)!
    Ok(n + string_length(name) + list_length(xs))
  }
}

fn lead(xs: [String], s: String) : Result[Int, String] = match xs {
  [] -> Ok(0)
  [h, ...t] -> {
    let n = parse(s)!
    Ok(n + string_length(h) + list_length(t) + list_length(xs))
  }
}

fn walk(xs: [String], s: String) : Result[Int, String] / Tick = match xs {
  [] -> Ok(0)
  [h, ...t] -> {
    let k = Tick.tick(string_length(h))
    let n = parse(s)!
    Ok(n + k + list_length(t))
  }
}

fn spin(i: Int, acc: Int) : Int / Tick =
  if i == 0 {
    acc
  } else {
    let r = match walk(["w#{i}", "z"], "") {
      Ok(v) -> v
      Err(e) -> string_length(e)
    }
    spin(i - 1, acc + r)
  }

fn run(i: Int) : Int / Stop {
  let held = ["h#{i}"]
  let n = handle {
    spin(3, 0)
  } with Tick {
    tick(n, resume) -> resume(n + 1)
  }
  Stop.stop("s#{n}#{list_length(held)}")
}

fn score(r: Result[Int, String]) : Int = match r {
  Ok(v) -> v
  Err(e) -> string_length(e)
}

fn str_score(r: Result[String, String]) : Int = match r {
  Ok(v) -> string_length(v)
  Err(e) -> string_length(e)
}

fn rounds(i: Int, acc: Int) : Int =
  if i == 0 {
    acc
  } else {
    let s = "v#{i}"
    let a = score(total("", s)) + score(total(s, "")) + score(pick(false, "", s))
    let b = str_score(shaped("", s)) + str_score(shaped(s, s))
    let c = score(in_arm(s, "")) + score(lead([s, "b"], ""))
    let d = handle {
      run(i)
    } with Stop {
      stop(m, resume) -> string_length(m)
    }
    rounds(i - 1, acc + a + b + c + d)
  }

fn main() : Unit / Stdout = Stdout.print("#{rounds(20, 0)}")
