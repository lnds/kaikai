# A specialised callee's argument is pasted into a closure that binds the
# argument's own name: a pattern, a `let`, a nested lambda's parameter.

fn opt(n: Int) : Option[Int] = if n > 0 { Some(n * 10) } else { None }

fn ap(f: (Int) -> Int, x: Int) : Int = f(x)

fn main() : Unit / Stdout {
  Stdout.print("#{map([1, 2, 3], (o) => match opt(o) { Some(h) -> h + o  None -> o })}")
  Stdout.print("#{ap((n) => { let x = 5; n + x }, 1)}")
  Stdout.print("#{ap((n) => sum(map([1, 2], (x) => x + n)), 10)}")
}
