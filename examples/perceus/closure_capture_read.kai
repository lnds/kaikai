# A lambda body borrows its captures: the closure owns them and releases
# them when it dies. A capture read that retains a reference leaks the
# captured value, and everything it owns, once per invocation.

fn read_once(k: Int) : Int = {
  let a = array_make(4, int_to_real(k) + 0.5)
  let f = (i: Int) => i + array_length(a)
  f(1) + f(2)
}

fn read_in_fold(k: Int) : Int = {
  let s = string_concat("cap", int_to_string(k))
  let xs = [int_to_real(k), 2.5, 3.5]
  list.foldl([1, 2, 3, 4], 0, (acc, i) => acc + i * string_length(s) + list_length(xs) + list_length(xs))
}

fn filled(k: Int) : Int = {
  let a = array.from([int_to_real(k), 1.5, 2.5, 3.5])
  real_to_int(a[0] + a[3]) + array_length(a)
}

fn make_reader(k: Int) : (Int) -> Int = {
  let s = string_concat("r", int_to_string(k))
  (i) => i + string_length(s)
}

fn make_getter(k: Int) : () -> String = {
  let s = string_concat("g", int_to_string(k))
  () => s
}

fn escaped(k: Int) : Int = {
  let r = make_reader(k)
  let g = make_getter(k)
  r(k) + r(k + 1) + string_length(g()) + string_length(g())
}

fn step(k: Int) : Int = read_once(k) + read_in_fold(k) + filled(k) + escaped(k)

fn loop(i: Int, n: Int, acc: Int) : Int = if i >= n { acc } else { loop(i + 1, n, acc + step(i)) }

fn main() : Unit / Stdout = Stdout.print("total=#{loop(0, 20000, 0)}")
