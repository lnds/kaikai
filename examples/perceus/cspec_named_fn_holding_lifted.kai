# A named fn passed to a higher-order fn that applies it twice holds a
# lambda, or a handler, of its own. Specialising the callee on it would
# paste what it lifts twice under one symbol: C rejects the duplicate,
# native calls one copy at both sites.

effect Ask {
  ask() : Int
}

fn twice(x: (Int) -> Int, y: Int) : Int = x(x(y))

fn scaled(n: Int) : Int = (if n == 4 { (z: Int) => z } else { (z) => z + n * 100 })(n)

fn asked(n: Int) : Int = handle { Ask.ask() + n } with Ask { ask(resume) -> resume(n * 100) }

fn main() : Unit / Stdout = Stdout.print("#{twice(scaled, 11)} #{twice(asked, 11)}")
