fn pick(start: [Int], f: ([Int]) -> Option[[Int]]) : [Int] =
  match f(start) {
    Some(taken) if length(taken) < length(start) -> taken
    _ -> start
  }

fn main() {
  let grows = record => Some(record ++ [1])
  println("#{pick([4, 4], grows)}")

  let annotated = (record: [Int]) => Some(record ++ [1])
  println("#{pick([4, 4], annotated)}")

  println("#{pick([4, 4], xs => Some(xs ++ [1]))}")

  let same = (record: [Int]) => Some(record)
  println("#{pick([4, 4], same)}")

  let shrinks = record => Some(record ++ [])
  println("#{pick([4, 4], shrinks)}")
}
