# A recognised variant rebuild that keeps a child in its own slot across a
# ctor change (typed payload path). The kept spine must not gain a ref per
# reuse: the donor's claim on the aliased slot is paid when the reuse fires.
type M = MVal(Int, [Int]) | MErr(Int, [Int])

fn bump(r: M) : M = match r {
  MVal(v, xs) -> MErr(v + 1, xs)
  MErr(e, ys) -> MVal(e + 1, ys)
}

fn spin(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    match bump(MErr(7, [5, 6])) {
      MVal(v, _) -> spin(n - 1, acc + v)
      MErr(_, _) -> spin(n - 1, acc)
    }
  }

fn main() : Unit / Stdout = {
  Stdout.print("s=#{spin(2000, 0)}")
}
