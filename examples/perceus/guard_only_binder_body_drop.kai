# A binder read only by its arm's guard is moved there: no alternative of
# the body may release it again. Heap strings from `string.split`, so a
# second release frees a cell the list still holds.

fn sizes(m: String) : Option[(Int, Int)] =
  match string.split(m, "\n") {
    [f, b, pl] if f == "fmt" -> match (string.to_int(b), string.to_int(pl)) {
      (Some(x), Some(y)) -> Some((x, y))
      _ -> None
    }
    _ -> None
  }

fn pick(m: String) : Int =
  match string.split(m, "\n") {
    [f, b, pl] if f == "fmt" -> if string.length(b) > 1 { string.length(pl) } else { 0 }
    _ -> -1
  }

fn total(m: String) : Int =
  match string.split(m, "\n") {
    [f, b, pl] if f == "fmt" -> string.length(b) + string.length(pl)
    _ -> 0
  }

fn line(i: Int) : String = "fmt\n#{i}\n-#{i}"

fn run(i: Int, n: Int, acc: Int) : Int =
  if i == n { acc }
  else {
    let s = match sizes(line(i)) {
      Some((x, y)) -> x + y
      None -> 1
    }
    run(i + 1, n, acc + s + pick(line(i)) + total(line(i)) + total("no\n#{i}\n1"))
  }

fn main() : Unit / Stdout = {
  Stdout.print("#{sizes("fmt\n10\n-1")} #{sizes("fmt\nx\n-1")} #{sizes("no\n10\n-1")}")
  Stdout.print("#{pick("fmt\n10\n-1")} #{pick("fmt\n1\n-1")} #{pick("x")}")
  Stdout.print("acc=#{run(0, 300, 0)}")
}
