# A binder on an Int payload slot is declared raw; every later read in its
# scope must find it raw, whether a `let`, an arm, or an as-pattern bound it.

type One = One(Int)
type Tok = Tok(Int, Int)
type Mix = Mix(Int, Real, Bool, String, Int)
type Pair = Pair(Tok, Int)
type W = { t: Tok, k: Int }

fn apply(f: (Int) -> Int, v: Int) : Int = f(v)

fn one() : Int = {
  let One(a) = One(7)
  a + 1
}

fn mixed() : String = {
  let Mix(i, r, b, s, j) = Mix(4, 1.5, true, "hi", 9)
  "#{i} #{r} #{b} #{s} #{i + j}"
}

fn nested() : Int = {
  let Pair(Tok(a, b), c) = Pair(Tok(2, 3), 5)
  a * b + c
}

fn in_lambda() : Int = apply((v) => {
  let Tok(p, q) = Tok(v, 10)
  p + q
}, 5)

fn in_arm(o: Option[Int]) : Int = match o {
  Some(n) -> {
    let Tok(x, y) = Tok(n, n)
    x * y
  }
  None -> 0
}

fn wild() : Int = {
  let Tok(_, y) = Tok(1, 8)
  let Tok(_u, _) = Tok(3, 4)
  let Tok(unused, w) = Tok(6, 2)
  y + w
}

fn shadow_boxed() : String = {
  let x = 100
  let Tok(x, y) = Tok(x + 1, 2)
  let r = x * y
  let x = "s"
  "#{r}#{x}"
}

fn shadow_raw() : Int = {
  let x = 1
  let Tok(x, y) = Tok(x + 10, 2)
  x * y
}

fn captured() : Int = {
  let Tok(x, y) = Tok(3, 4)
  apply((v) => v + x * y, 1)
}

fn as_slot(t: Tok) : Int = match t {
  Tok(n @ 2, y) -> n + y
  Tok(a, b) -> a - b
}

fn sum_toks(xs: [Tok], acc: Int) : Int = match xs {
  [] -> acc
  [h, ...rest] -> {
    let Tok(x, y) = h
    sum_toks(rest, acc + x * y)
  }
}

fn list_let(xs: [Tok]) : Int = {
  let [Tok(a, b), ..._r] = xs
  a + b
}

fn rec_let(w: W) : Int = {
  let W { t: Tok(a, b), k: k } = w
  a * b + k
}

fn each_pair(xs: [(Int, Int)], f: ((Int, Int)) -> Int) : Int = match xs {
  [] -> 0
  [h, ...t] -> f(h) + each_pair(t, f)
}

fn tuple_param() : Int = each_pair([(1, 2), (3, 4)]) { (a, b) ->
  let Tok(p, q) = Tok(a, b)
  p * q
}

fn main() : Unit / Stdout = {
  let Tok(x, y) = Tok(2, 3)
  Stdout.print("#{x * y}")
  Stdout.print("#{one()}")
  Stdout.print(mixed())
  Stdout.print("#{nested()}")
  Stdout.print("#{in_lambda()}")
  Stdout.print("#{in_arm(Some(6))} #{in_arm(None)}")
  Stdout.print("#{wild()}")
  Stdout.print(shadow_boxed())
  Stdout.print("#{shadow_raw()}")
  Stdout.print("#{captured()}")
  Stdout.print("#{as_slot(Tok(2, 5))} #{as_slot(Tok(9, 4))}")
  Stdout.print("#{sum_toks([Tok(1, 2), Tok(3, 4)], 0)}")
  Stdout.print("#{list_let([Tok(5, 6)])}")
  Stdout.print("#{rec_let(W { t: Tok(2, 7), k: 1 })}")
  Stdout.print("#{tuple_param()}")
  Stdout.print("#{x} #{y}")
}
