# A generic `==` or `<` on a user type reaches the impl through the
# dispatch table, which hands it every argument owned; an impl that only
# inspects its parameters borrows them, so the table entry releases them.

type Key = Calm(Int) | Wild

impl Eq for Key {
  fn eq(a: Key, b: Key) : Bool = match a {
    Calm(n) -> match b { Calm(m) -> n == m  Wild -> false }
    Wild -> match b { Wild -> true  Calm(_) -> false }
  }
}

impl Ord for Key {
  fn cmp(a: Key, b: Key) : Int = match a {
    Calm(n) -> match b { Calm(m) -> n - m  Wild -> 0 - 1 }
    Wild -> match b { Wild -> 0  Calm(_) -> 1 }
  }
  fn min(a: Key, b: Key) : Key = if cmp(a, b) <= 0 { a } else { b }
  fn max(a: Key, b: Key) : Key = if cmp(a, b) >= 0 { a } else { b }
}

fn same(a: k, b: k) : Bool = a == b

fn below(a: k, b: k) : Bool = a < b

fn count(i: Int, n: Int, acc: Int) : Int = if i == n { acc } else {
  let eqs = if same(Calm(i), Calm(i)) { 1 } else { 0 }
  let lts = if below(Calm(i), Wild) { 1 } else { 0 }
  count(i + 1, n, acc + eqs + lts)
}

fn main() : Unit / Console = Stdout.print("matches: " ++ int_to_string(count(0, 100, 0)))
