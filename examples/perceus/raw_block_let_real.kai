# A `let` whose value is a block the unbox pass left raw — here the arm a
# fixed-vec match collapses to — binds a raw scalar on both backends. Boxed
# at the binding while its reads stay raw, each round would keep one box.

fn spread(r: Vec[Real]<3>) : Real = {
  let t = match r {
    [a, b, c] -> a + b + c
  }
  t * 2.0
}

fn go(i: Int, acc: Real) : Real =
  if i == 0 { acc } else { go(i - 1, acc + spread([1.5, 2.5, 3.5])) }

fn main() : Unit / Console = print(real_to_string(go(100, 0.0)))
