# A modulo-cons step jumps out of every enclosing match: it must release
# what their exits would have, the scrutinee cells and the binders the
# step does not move. Covers a step inside a nested match, a step under
# an `if` and under a guard, a value leaf that stops the spine early, and
# a nested arm that recurses without a step.

type Px = Px(String, Int) | NoPx

fn mk_px(i: Int, n: Int, acc: [Px]) : [Px] =
  if i >= n { acc } else { mk_px(i + 1, n, [if i % 5 == 0 { NoPx } else { Px(int_to_string(i), i % 3) }, ...acc]) }

fn keep(xs: [Px]) : [Int] = match xs {
  []           -> []
  [p, ...rest] -> match p {
    Px(s, k) -> [string_length(s) + k, ...keep(rest)]
    NoPx     -> keep(rest)
  }
}

fn mk(i: Int, n: Int, acc: [String]) : [String] =
  if i >= n { acc } else { mk(i + 1, n, [int_to_string(i % 150), ...acc]) }

fn take_short(xs: [String]) : [Int] = match xs {
  []        -> []
  [h, ...t] -> if string_length(h) < 3 { [string_length(h), ...take_short(t)] } else { [] }
}

fn evens(xs: [Int]) : [Int] = match xs {
  []                      -> []
  [h, ...t] if h % 2 == 0 -> [h, ...evens(t)]
  [_, ...t]               -> evens(t)
}

fn ints(i: Int, n: Int, acc: [Int]) : [Int] = if i >= n { acc } else { ints(i + 1, n, [i, ...acc]) }

fn sum(xs: [Int], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> sum(t, acc + h)
}

fn go(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc }
  else {
    let a = sum(keep(mk_px(0, 60 + i % 9, [])), 0)
    let b = sum(take_short(mk(0, 40 + i % 130, [])), 0)
    let c = sum(evens(ints(0, 30 + i % 7, [])), 0)
    go(i + 1, n, acc + a + b + c)
  }

fn main() : Unit / Stdout = Stdout.print("total=#{go(0, 1500, 0)} n=#{sum(keep(mk_px(0, 30000, [])), 0)}")
