# Gap 3 shape: a cons-arm binder whose LAST use is a field projection
# inside the self-call's args. The last-use gate leaves EField
# unconstrained, so the binder joins the move-last set; the field read
# transfers nothing, orphaning the slot ref — one record per iteration.
type Item = { w: Int, tag: String }

fn probe(i: Item) : Bool = i.w > 0

fn walk(xs: [Item], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> if probe(h) { walk(t, acc + h.w) } else { walk(t, acc) }
}

fn build(n: Int, acc: [Item]) : [Item] =
  if n == 0 { acc } else { build(n - 1, [Item { w: n, tag: "it_#{n}" }, ...acc]) }

fn main() : Unit / Stdout = {
  let items = build(5000, [])
  let total = walk(items, 0)
  Stdout.print("total=#{total}")
}
