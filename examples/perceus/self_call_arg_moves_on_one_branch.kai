# A binder moved into an accumulator on one branch of an `if` that is an
# argument of a self tail call. The branch that keeps the accumulator
# releases the binder; the one that conses it hands it on.

type P = P(String, [Int])

fn big(vs: [Int]) : Bool = match vs {
  [] -> false
  [h, ...t] -> h > 5 or big(t)
}

fn vs_of(p: P) : [Int] = match p {
  P(_, vs) -> vs
}

fn small(xs: [P], acc: [P]) : [P] = match xs {
  [] -> acc
  [c, ...rest] -> small(rest, if big(vs_of(c)) { acc } else { [c, ...acc] })
}

fn named(xs: [P], acc: [P]) : [P] = match xs {
  [] -> acc
  [c, ...rest] -> match c {
    P(n, vs) -> named(rest, if n == "q" or big(vs) { acc } else { [c, ...acc] })
  }
}

fn show(ps: [P]) : String = join(
  map(
    ps,
    p => match p {
      P(n, vs) -> "#{n}:#{vs}"
    }
  ),
  " "
)

fn main() : Unit / Stdout {
  let ps = [P("a", [1, 2]), P("b", [9]), P("q", [3]), P("d", [4, 7])]
  Stdout.print(show(small(ps, [])))
  Stdout.print(show(named(ps, [])))
  match named([P("a", [1, 2])], []) {
    [P(n, vs)] -> Stdout.print("#{n} #{vs}")
    _ -> Stdout.print("other")
  }
}
