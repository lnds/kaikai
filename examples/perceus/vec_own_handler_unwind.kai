# An operand that can leave the clause never finds the handler state taken.

effect Cell { put(i: Int) : Unit }
effect Boom { boom() : Int }

fn set3(v: Vec[Int], i: Int, x: Int) : Vec[Int] = vec_set(v, i, x)
fn pick(x: Int, v: Vec[Int], i: Int) : Vec[Int] = vec_set(v, i, x)

fn risky() : Int / Boom = Boom.boom()

fn drive(i: Int) : Unit / Cell =
  if i >= 6 { () }
  else {
    Cell.put(i)
    drive(i + 1)
  }

# `risky()` is evaluated after the state is read: the clause dups, and the
# unwind finds the state in place.
fn after_read() : Int / Boom =
  handle {
    drive(0)
    0
  } with Cell(vec_make(8, 0)) {
    put(i, resume) -> resume((), set3(state, i, risky()))
    return(_u)     -> vec_get(state, 0)
  }

# `risky()` is evaluated before the state is read: the state may be taken.
fn before_read() : Int / Boom =
  handle {
    drive(0)
    0
  } with Cell(vec_make(8, 0)) {
    put(i, resume) -> resume((), pick(risky(), state, i))
    return(_u)     -> vec_get(state, 0)
  }

fn main() : Unit / Stdout = {
  let a = handle { after_read() } with Boom { boom(_r) -> 40 return(x) -> x }
  let b = handle { before_read() } with Boom { boom(_r) -> 2 return(x) -> x }
  let c = handle { after_read() } with Boom { boom(r) -> r(1) return(x) -> x }
  let d = handle { before_read() } with Boom { boom(r) -> r(5) return(x) -> x }
  Stdout.print(int_to_string(a + b + c * 100 + d * 1000))
}
