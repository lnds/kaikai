# A lambda piped into a user HOF's borrowed slot is materialised as a
# closure the callee never consumes; the caller drops it after the call.
# Each shape runs once per wave so a missed drop scales with executions.

import core.list

fn range_from(n: Int, acc: [Int]) : [Int] =
  if n <= 0 { acc } else { range_from(n - 1, [n, ...acc]) }

fn wave(n: Int, k: Int) : Int = {
  let xs = range_from(n, [])
  let plain = xs |> foldl(0, (acc, x) => acc + x)
  let captured = xs |> foldl(0, (acc, x) => acc + x + k)
  let qualified = xs |> list.foldl(0, (acc, x) => acc + x * k)
  plain + captured + qualified
}

fn waves(w: Int, acc: Int) : Int =
  if w <= 0 { acc } else { waves(w - 1, acc + wave(20, w)) }

fn main() : Unit / Stdout = {
  Stdout.print("total=#{waves(1000, 0)}")
}
