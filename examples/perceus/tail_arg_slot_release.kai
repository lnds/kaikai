# An argument of a self tail call waits in a slot while the binders the
# jump leaves behind are dropped. A boxed scalar parked there for a raw
# parameter is read back by the jump, which must release its box.

type Box = { w: Real, path: String }

fn pick(n: Int) : String = if n % 2 == 0 { "" } else { "box" }

fn open_box(path: String) : Result[Box, String] =
  if string_length(path) > 0 { Ok(Box { w: 3.5, path: path }) } else { Err("no") }

fn reals(n: Int, acc: [Real]) : [Real] =
  if n == 0 { acc } else { reals(n - 1, [int_to_real(n) + 0.5, ...acc]) }

fn loop_real(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = pick(n)
    loop_real(n - 1, acc + int_to_real(string_length(p)) + int_to_real(string_length(p)))
  }
}

fn loop_two_slots(a: Real, n: Int, b: Real) : Real {
  if n == 0 { a + b } else {
    let p = pick(n)
    loop_two_slots(a + int_to_real(string_length(p)) + int_to_real(string_length(p)), n - 1,
                   b + int_to_real(string_length(p)) + int_to_real(string_length(p)))
  }
}

fn loop_int32(n: Int, acc: Int32) : Int32 {
  if n == 0 { acc } else {
    let p = pick(n)
    loop_int32(n - 1, acc + int_to_int32(string_length(p)) + int_to_int32(string_length(p)))
  }
}

fn loop_uint32(n: Int, acc: UInt32) : UInt32 {
  if n == 0 { acc } else {
    let p = pick(n)
    loop_uint32(n - 1, acc + int_to_uint32(string_length(p)) + int_to_uint32(string_length(p)))
  }
}

fn loop_int128(n: Int, acc: Int128) : Int128 {
  if n == 0 { acc } else {
    let p = pick(n)
    loop_int128(n - 1, acc + int_to_int128(string_length(p)) + int_to_int128(string_length(p)))
  }
}

fn loop_call(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = pick(n)
    loop_call(n - 1, int_to_real(string_length(p) + string_length(p)))
  }
}

fn loop_if(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = pick(n)
    loop_if(n - 1, if string_length(p) > 0 { acc + int_to_real(string_length(p)) } else { acc + 0.5 })
  }
}

fn loop_match(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = pick(n)
    loop_match(n - 1, match open_box(string_concat(p, p)) {
      Err(_) -> acc + 0.5
      Ok(b)  -> acc + b.w
    })
  }
}

fn loop_binder(xs: [Real], acc: Real) : Real = match xs {
  []           -> acc
  [v, ...rest] -> {
    let p = pick(string_length(real_to_string(acc)))
    if string_length(p) > 100 { acc } else { loop_binder(rest, v) }
  }
}

fn loop_record(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let b = Box { w: 1.5, path: pick(n) }
    loop_record(n - 1, acc + int_to_real(string_length(b.path)) + int_to_real(string_length(b.path)))
  }
}

fn loop_list(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let xs = [pick(n), pick(n + 1)]
    loop_list(n - 1, acc + int_to_real(list_length(xs)) + int_to_real(list_length(xs)))
  }
}

fn loop_arms(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    match open_box(pick(n)) {
      Err(e) -> loop_arms(n - 1, acc + int_to_real(string_length(e)) + int_to_real(string_length(e)))
      Ok(b)  -> loop_arms(n - 1, acc + b.w + int_to_real(string_length(b.path)))
    }
  }
}

fn loop_branches(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = pick(n)
    if string_length(p) > 0 { loop_branches(n - 1, acc + int_to_real(string_length(p)) + int_to_real(string_length(p))) }
    else { loop_branches(n - 1, acc + int_to_real(string_length(p)) + int_to_real(string_length(p)) + 1.0) }
  }
}

fn main() {
  print(real_to_string(loop_real(200, 0.0)))
  print(real_to_string(loop_two_slots(0.0, 200, 0.0)))
  print(int_to_string(int32_to_int(loop_int32(200, 0i32))))
  print(int_to_string(uint32_to_int(loop_uint32(200, 0u32))))
  print(int_to_string(int128_to_int(loop_int128(200, 0i128))))
  print(real_to_string(loop_call(200, 0.0)))
  print(real_to_string(loop_if(200, 0.0)))
  print(real_to_string(loop_match(200, 0.0)))
  print(real_to_string(loop_binder(reals(200, []), 0.0)))
  print(real_to_string(loop_record(200, 0.0)))
  print(real_to_string(loop_list(200, 0.0)))
  print(real_to_string(loop_arms(200, 0.0)))
  print(real_to_string(loop_branches(200, 0.0)))
}
