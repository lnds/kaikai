# A borrowed raw Int param as match scrutinee: borrow inference wraps
# `match sel` in `__perceus_borrow(sel)`, and the literal-arm fast path
# must strip the wrap instead of emitting it as a call (the wrap is
# RC-transparent on an unboxed scalar).

type Box = { tag: String, n: Int }

fn peek(b: Box) : Int = b.n

fn route(sel: Int, p: Box) : Int =
  match sel {
    0 -> 0
    _ -> {
      assert peek(p) > 0
      7
    }
  }

fn spin(k: Int, acc: Int) : Int =
  if k == 0 { acc }
  else { spin(k - 1, acc + route(1, Box { tag: "b_#{k}", n: k })) }

fn main() : Unit / Stdout = {
  let total = spin(5000, 0)
  Stdout.print("total=#{total}")
}
