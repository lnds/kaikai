type W16
  = W16(
    Int,
    Real,
    Bool,
    String,
    String,
    String,
    String,
    String,
    String,
    String,
    String,
    String,
    String,
    Bool,
    Real,
    Int
  )

fn w16_first(w: W16) : Int = match w {
  W16(a, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> a
}

fn w16_last(w: W16) : Int = match w {
  W16(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, z) -> z + 1
}

fn w16_real(w: W16) : Real = match w {
  W16(_, r, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> r
}

fn w16_bool(w: W16) : Bool = match w {
  W16(_, _, b, _, _, _, _, _, _, _, _, _, _, _, _, _) -> b
}

fn w16_tail_real(w: W16) : Real = match w {
  W16(_, _, _, _, _, _, _, _, _, _, _, _, _, _, r, _) -> r
}

fn w16_tail_bool(w: W16) : Bool = match w {
  W16(_, _, _, _, _, _, _, _, _, _, _, _, _, b, _, _) -> b
}

fn w16_let(w: W16) : Int {
  let W16(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, z) = w
  z * 2
}

fn w16_mk(a: Int, z: Int) : W16 =
  W16(a, 1.5, true, "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10", "s11", "s12", false, 14.5, z)

fn sum_last_w16(ws: [W16]) : Int = match ws {
  [] -> 0
  [w, ...rest] -> w16_last(w) + sum_last_w16(rest)
}

