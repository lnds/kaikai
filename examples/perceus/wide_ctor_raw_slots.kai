fn main() : Unit / Console {
  let w16 = w16_mk(41, 99)
  println(int_to_string(w16_first(w16)))
  println(int_to_string(w16_last(w16)))
  println(int_to_string(w16_let(w16)))
  println(real_to_string(w16_real(w16)))
  println(bs(w16_bool(w16)))
  println(real_to_string(w16_tail_real(w16)))
  println(bs(w16_tail_bool(w16)))
  println(int_to_string(sum_last_w16([w16_mk(1, 2), w16_mk(3, 4), w16])))
  let w17 = w17_mk(41, 99)
  println(int_to_string(w17_first(w17)))
  println(int_to_string(w17_last(w17)))
  println(int_to_string(w17_let(w17)))
  println(real_to_string(w17_real(w17)))
  println(bs(w17_bool(w17)))
  println(real_to_string(w17_tail_real(w17)))
  println(bs(w17_tail_bool(w17)))
  println(int_to_string(sum_last_w17([w17_mk(1, 2), w17_mk(3, 4), w17])))
  let w40 = w40_mk(41, 99)
  println(int_to_string(w40_first(w40)))
  println(int_to_string(w40_last(w40)))
  println(int_to_string(w40_let(w40)))
  println(real_to_string(w40_real(w40)))
  println(bs(w40_bool(w40)))
  println(real_to_string(w40_tail_real(w40)))
  println(bs(w40_tail_bool(w40)))
  println(int_to_string(sum_last_w40([w40_mk(1, 2), w40_mk(3, 4), w40])))
}

fn bs(b: Bool) : String = if b { "true" } else { "false" }
