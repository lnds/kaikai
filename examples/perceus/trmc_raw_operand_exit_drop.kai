# A TRMC step whose arm binder is read twice, the last read landing in a raw
# argument of the self-call. The binder's exit drop must run after that
# read even though no boxed operand follows it, or every step keeps one
# child alive.

type Color = Red | Black
type Tree = Leaf | Node(Color, Tree, Int, Tree)

fn left(t: Tree) : Tree = match t {
  Node(_, a, _, _) -> a
  Leaf             -> Leaf
}

fn red_int(t: Tree) : Int = match t {
  Node(Red, _, _, _) -> 10
  _                  -> 0
}

fn size(t: Tree) : Int = match t {
  Node(_, a, _, b) -> 1 + size(a) + size(b)
  Leaf             -> 0
}

fn keys(t: Tree) : Int = match t {
  Node(_, a, k, b) -> k + keys(a) + keys(b)
  Leaf             -> 0
}

fn fresh(k: Int) : Tree = Node(Red, Node(Red, Leaf, k, Leaf), k, Leaf)

fn ins(t: Tree, k: Int) : Tree = match t {
  Node(c, l, kx, r) -> Node(c, left(l), kx, ins(r, k + red_int(l)))
  Leaf              -> fresh(k)
}

fn build(i: Int, n: Int, t: Tree) : Tree = if i >= n { t } else { build(i + 1, n, ins(t, i)) }

fn main() : Unit / Stdout = {
  let a = build(0, 200, Leaf)
  Stdout.print("size=#{size(a)} keys=#{keys(a)}")
}
