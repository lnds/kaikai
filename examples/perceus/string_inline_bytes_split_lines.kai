fn show(xs: [String]) : String =
  "#{list.length(xs)}:" ++ string.join(list.map(xs, x => "<" ++ x ++ ">"), "|")

fn main() : Int / Stdout {
  let long15 = "123456789012345"
  let long16 = "1234567890123456"
  Stdout.print(show(string.lines("a\r\nb\r\n")))
  Stdout.print(show(string.lines("a\nb")))
  Stdout.print(show(string.lines("")))
  Stdout.print(show(string.lines("\n")))
  Stdout.print(show(string.lines("\n\n")))
  Stdout.print(show(string.lines("a\n\nb\n")))
  Stdout.print(show(string.lines("héllo\nwörld ✓\n")))
  Stdout.print(show(string.lines(long15 ++ "\n" ++ long16 ++ "\n" ++ long15)))
  Stdout.print(show(string.split("a,b,,c", ",")))
  Stdout.print(show(string.split(long16 ++ "," ++ long15 ++ "," ++ "é", ",")))
  let kept = list.map(string.lines(string.repeat("ab\n", 1000)), x => x ++ x)
  Stdout.print("#{list.length(kept)} #{list.head(kept)}")
  0
}
