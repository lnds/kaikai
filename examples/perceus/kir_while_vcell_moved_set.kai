# Var cells read inside interpolations keep their State handlers past
# desugar; after the loop fuses into `main` each canonical pair, whose
# set clause moves `v`, must still rewrite to a `__vcell_` register.

import loop

fn main() : Int / Stdout = {
  var best := 0
  var best_n := 0
  var i := 1
  while { i < 2000 } {
    let s = (i * 7919) % 1009
    if s > best { best := s; best_n := i }
    i := i + 1
  }
  Stdout.print("best=#{int_to_string(best)} at=#{int_to_string(best_n)}")
  0
}
