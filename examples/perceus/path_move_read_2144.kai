# A binder read on several alternatives, at most once on any path, moves
# at each read; an alternative that reaches none of its reads releases it
# on entry. Covers a self-recursive search whose value leaf returns before
# either recursive read, reads spread over `if` and `match` alternatives, a
# binder returned as the value on one path, and two variant binders each
# read on one side only.

type T = Leaf(Int) | Node(T, T)

fn mk(i: Int, n: Int, acc: [String]) : [String] =
  if i >= n { acc } else { mk(i + 1, n, [int_to_string(i), ...acc]) }

fn find(xs: [String], acc: Int) : Int = match xs {
  []           -> acc
  [h, ...rest] -> if string_length(h) > 4 { acc } else if acc > 5 { find(rest, acc + 2) } else { find(rest, acc + 1) }
}

fn cnt(xs: [String]) : Int = match xs {
  []        -> 0
  [_, ...t] -> 1 + cnt(t)
}

fn pick(xs: [String], i: Int) : Int = match xs {
  []           -> 0
  [h, ...rest] -> if i % 3 == 0 { string_length(h) } else if i % 3 == 1 { find(rest, 0) } else { cnt(rest) }
}

fn arms(xs: [String], k: Int) : Int = match xs {
  []        -> 0
  [_, ...t] -> match k % 4 {
    0 -> cnt(t)
    1 -> 5
    2 -> cnt(t) + 1
    _ -> 9
  }
}

fn skip_short(xs: [String]) : [String] = match xs {
  []        -> []
  [h, ...t] -> if string_length(h) > 1 { t } else { skip_short(t) }
}

fn walk(xs: [String], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> if h == "7" { acc * 1000 } else if string_length(h) == 1 { walk(t, acc + 1) } else { walk(t, acc + 2) }
}

fn build(d: Int) : T = if d == 0 { Leaf(1) } else { Node(build(d - 1), build(d - 1)) }

fn sum(t: T) : Int = match t {
  Leaf(v)    -> v
  Node(l, r) -> sum(l) + sum(r)
}

fn side(t: T, k: Int) : Int = match t {
  Leaf(v)    -> v
  Node(l, r) -> if k % 2 == 0 { sum(l) } else { sum(r) + 1 }
}

fn go(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc }
  else {
    let a = find(mk(0, 40 + i % 7, []), 0) + find(mk(0, 9, []), 0)
    let b = pick(mk(0, 12, []), i) + arms(mk(0, 6, []), i)
    let c = cnt(skip_short(mk(0, 30, []))) + walk(mk(0, 20, []), 0)
    go(i + 1, n, acc + a + b + c + side(build(4), i))
  }

fn main() : Unit / Stdout = Stdout.print("total=#{go(0, 2000, 0)}")
