# A param whose only read sits inside a handler CLAUSE of an EHandle arm.
# The owned-scope move gate's consuming-slots walker does not look inside
# EHandle, so the param is moved (all reads raw); the clause runs once per
# op invocation, consuming the same birth ref twice.
type Box = MkBox(String)

effect Tick {
  tick() : Int
}

fn burn(b: Box) : Int = match b {
  MkBox(s) -> string_length(s)
}

fn drive(sel: Int, p: Box) : Int =
  match sel {
    0 -> 0
    _ -> handle {
      let a = Tick.tick()
      let b = Tick.tick()
      a + b
    } with Tick {
      tick(resume) -> resume(burn(p))
    }
  }

fn main() : Unit / Stdout = {
  let total = drive(1, MkBox("hello_#{1 + 1}"))
  Stdout.print("total=#{total}")
}
