# Binders projected out of a record or tuple field own one reference each.
# Every shape below drops or moves such a binder while the caller still holds
# the list it came from.

type Bag = { items: [Int], tag: Int }

fn prefix_if(big: [Int], small: [Int]) : Bool = match (big, small) {
  (_, [])                  -> true
  ([], _)                  -> false
  ([x, ...xs], [y, ...ys]) -> if x == y { prefix_if(xs, ys) } else { false }
}

fn contains_run(big: [Int], small: [Int]) : Bool = match big {
  []        -> is_empty(small)
  [_, ...t] -> if prefix_if(big, small) { true } else { contains_run(t, small) }
}

fn opt_len(o: Option[[Int]], k: Int) : Int = match (o, k) {
  (Some(xs), 0) -> length(xs)
  (Some(xs), _) -> if k > 5 { length(xs) } else { 0 }
  (None, _)     -> 0
}

fn bag_rest(b: Bag) : [Int] = match b {
  { items: [_, ...t], tag: 0 } -> t
  { items, tag: _ }            -> items
}

fn main() : Unit / Stdout = {
  let big = [1, 2, 3, 4, 5]
  Stdout.print("c1=#{contains_run([3, 4, 5], [3, 4, 5])} c2=#{contains_run([2, 3, 4, 5], [3, 4, 5])}")
  let o = Some(big)
  Stdout.print("opt=#{opt_len(o, 0) + opt_len(o, 1) + opt_len(o, 9)} len=#{length(big)}")
  let b = Bag { items: big, tag: 0 }
  Stdout.print("bag=#{length(bag_rest(b))} #{length(bag_rest(Bag { items: big, tag: 1 }))} len=#{length(b.items)}")
}
