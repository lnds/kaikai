# A protocol op the native backend dispatches at run time (`Hash.hash` on a
# HashMap key) hands the dispatch shim its protocol and op names as boxed
# strings. The shim owns them like any call argument and releases them once
# the impl resolves; each lookup here would otherwise keep two strings.

import collections.hashmap.{HashMap, empty, put, get}

fn hits(i: Int) : Int {
  let m = empty()
  put(m, "k#{i}", i)
  put(m, "x", 1)
  match get(m, "k#{i}") {
    Some(v) -> v
    None    -> 0
  }
}

fn go(i: Int, acc: Int) : Int = if i == 0 { acc } else { go(i - 1, acc + hits(i)) }

fn main() : Unit / Console = print(int_to_string(go(100, 0)))
