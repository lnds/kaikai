# Fused map stages whose stage is a computed closure, not a lambda or a
# name. Each composed application must stay its own call site, or the
# native unwinder releases the fused element while a call still holds it.

fn mapped(n: (Int) -> Int) : [Int] =
  [9, 2] | ((y) => y + 1) | (if n(1) > 0 { (k) => k + 1 } else { n })

fn summed(n: (Int) -> Int) : Int =
  [9, 2] | ((y) => y + 1) | (if n(2) > 0 { n } else { n }) |> sum()

fn folded(n: (Int) -> Int) : Int =
  [9, 2] | (if n(1) > 0 { n } else { n }) | ((y) => y + 1) | (if n(2) > 0 { n } else { n })
    |> foldl(0, (a, b) => a + b)

fn main() : Unit / Stdout = {
  let add4 = (n) => n + 4
  Stdout.print("#{mapped(add4)} #{summed(add4)} #{folded(add4)}")
}
