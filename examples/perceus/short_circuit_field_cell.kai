# Tuple arm binders under a side's list pattern, read once behind `and` or
# `or`, or in one `if` branch. The path that skips the read releases them.
# The caller keeps both lists alive across calls, so an over-release frees
# cells it still reads.

fn len(l: [Int]) : Int = match l {
  []        -> 0
  [_, ...r] -> 1 + len(r)
}

fn prefix_and(big: [Int], small: [Int]) : Bool = match (big, small) {
  (_, [])                  -> true
  ([], _)                  -> false
  ([x, ...xs], [y, ...ys]) -> x == y and prefix_and(xs, ys)
}

fn differs_or(big: [Int], small: [Int]) : Bool = match (big, small) {
  (_, [])                  -> false
  ([], _)                  -> true
  ([x, ...xs], [y, ...ys]) -> x != y or differs_or(xs, ys)
}

fn prefix_if(big: [Int], small: [Int]) : Bool = match (big, small) {
  (_, [])                  -> true
  ([], _)                  -> false
  ([x, ...xs], [y, ...ys]) -> if x == y { prefix_if(xs, ys) } else { false }
}

fn runs(big: [Int], small: [Int], acc: Int) : Int = match big {
  []        -> acc
  [_, ...t] -> {
    let a = if prefix_and(big, small) { 1 } else { 0 }
    let o = if differs_or(big, small) { 0 } else { 10 }
    let i = if prefix_if(big, small) { 100 } else { 0 }
    runs(t, small, acc + a + o + i)
  }
}

fn main() : Unit / Stdout = {
  let big = [1, 2, 3, 1, 2, 3, 4, 1, 2]
  let small = [1, 2, 3]
  Stdout.print("runs=#{runs(big, small, 0)} big=#{len(big)} small=#{len(small)}")
}
