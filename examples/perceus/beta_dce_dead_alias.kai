# A dead alias (`let z = w`) of a closure that is still called later. Its
# drop releases the closure reference the alias held, never the captures
# the closure still reads.

type Rec = { x: Int, y: Bool, z: Int, w: Bool }
type Sum = Ca(Int, Int, [Int]) | Cb(Int, Bool) | Cc(Rec) | Cd(Rec)
const k1 : Int = 19
fn h_bool(b: Bool) : Int = if b { 1 } else { 2 }
fn h_list(xs: [Int]) : Int = foldl(xs, 7, (acc, x) => ((acc * 31 + (x % 1000003)) % 1000000007))
fn h_rec(r: Rec) : Int = ((((((((7 * 31 + (r.x % 1000003)) % 1000000007) * 31 + h_bool(r.y)) % 1000000007) * 31 + (r.z % 1000003)) % 1000000007) * 31 + h_bool(r.w)) % 1000000007)
fn h_sum(s: Sum) : Int = match s {
  Ca(a, b, c) -> ((((((1 * 31 + (a % 1000003)) % 1000000007) * 31 + (b % 1000003)) % 1000000007) * 31 + h_list(c)) % 1000000007)
  Cb(a, b) -> ((((2 * 31 + (a % 1000003)) % 1000000007) * 31 + h_bool(b)) % 1000000007)
  Cc(a) -> ((3 * 31 + h_rec(a)) % 1000000007)
  Cd(a) -> ((4 * 31 + h_rec(a)) % 1000000007)
}
fn f1(xs: [Int], acc: Int) : Int = match xs {
  [] -> acc
  [h, ...t] -> f1(t, (((w) => w)(((if true { xs } else { [2..5] }) |> sum)) % 100003))
}
fn main() : Unit / Stdout = {
  let k0 = Rec { x: ((sum([3, 4, 7]) % 98) * (((n) => (n + 1))(k1) % 8)), y: ((if false { let acc = false; true } else { let acc = Ca(4, 8, [5]); true }) and true), z: (Rec { x: k1, y: true, z: 9, w: true }).x, w: (Cd(Rec { x: 1, y: true, z: 9, w: false }) != Cd(Rec { x: 0, y: false, z: 6, w: false })) }
  let y = (if (count([7], ((x) => true)) != (match Cd(Rec { x: 7, y: true, z: 11, w: false }) { Ca(a, b, c) -> { b }; Cb(a, b) -> { let w = k0; a }; Cc(a) -> { k1 }; Cd(a) -> { k1 } })) { let acc = Cc(Rec { x: 0, y: false, z: 10, w: true }); Rec { x: (0 - 1), y: false, z: 11, w: true } } else { (if (2 != 5) { Rec { x: k1, y: true, z: 6, w: true } } else { k0 }) })
  let w = ((k1) => { let x = Rec { ...y, x: (match head([(0 - 5)]) { Some(h) -> h; None -> k1 }) }; ((y) => y)(count([10], ((n) => false))) })
  let y = (((if false { [1, (0 - 1), 10] } else { [1] }) |> list.reverse) | ((k1) => { (Rec { x: k1, y: true, z: 10, w: true }).x }))
  let x = ((((match y { [] -> { k1 }; [h, ...t] -> { let z = w; k1 } }) % 7) ^ ((if false { let v = k0; (0 - 10) } else { let acc = w; k1 }) % 4)) / 4)
  let y = w(((k1 / (0 - 8)) + (Rec { x: 6, y: true, z: 7, w: true }).z))
  Stdout.print("#{x} #{y}")
}
