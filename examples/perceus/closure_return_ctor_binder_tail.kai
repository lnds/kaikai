# A binder from a constructor nested in a list pattern, returned (never
# read or compared) by a lambda built in the arguments of a self tail call.

#[derive(Eq, Show)]
type Rec = { a: Int, b: Int }

type Msg = Wire(Rec) | Skip

fn drain(acc: [Rec], msgs: [Msg]) : [Rec] = match msgs {
  [] -> acc
  [Skip, ...rest] -> drain(acc, rest)
  [Wire(v), ...rest] -> drain(map(acc, l => v), rest)
}

fn main() : Unit / Stdout {
  let all = [Rec { a: 0, b: 1 }, Rec { a: 1, b: 1 }]
  Stdout.print("left: #{drain(all, [Wire(Rec { a: 0, b: 1 }), Skip])}")
}
