# A modulo-cons arm whose binder is dup'd into one ctor slot and borrowed by
# another call owes that binder's own reference an exit drop. The TRMC step
# replaces the arm's return with a back-edge, so the drop has to run inside
# the step, after its last read.
#
# `ins` descends the right spine on every call; each fresh node's left child
# is a Node the step reads twice (`left(l)`, `red_int(l)`). `ins_same` keeps
# `l` in its own slot, the shape where a reused cell already holds the value.
# `ins_edge` ends the descent through an apply leaf with the same reads.
# `grow_all` keeps every version alive so `ins` also steps over shared cells.

type Color = Red | Black
type Tree = Leaf | Node(Color, Tree, Int, Tree)

fn left(t: Tree) : Tree = match t {
  Node(_, a, _, _) -> a
  Leaf             -> Leaf
}

fn red_int(t: Tree) : Int = match t {
  Node(Red, _, _, _) -> 10
  _                  -> 0
}

fn is_leaf(t: Tree) : Bool = match t {
  Leaf -> true
  _    -> false
}

fn size(t: Tree) : Int = match t {
  Node(_, a, _, b) -> 1 + size(a) + size(b)
  Leaf             -> 0
}

fn keys(t: Tree) : Int = match t {
  Node(_, a, k, b) -> k + keys(a) + keys(b)
  Leaf             -> 0
}

fn fresh(k: Int) : Tree = Node(Red, Node(Red, Leaf, k, Leaf), k, Leaf)

fn ins(t: Tree, k: Int) : Tree = match t {
  Node(c, l, kx, r) -> Node(c, left(l), kx + red_int(l), ins(r, k))
  Leaf              -> fresh(k)
}

fn ins_same(t: Tree, k: Int) : Tree = match t {
  Node(c, l, kx, r) -> Node(c, l, kx + red_int(l), ins_same(r, k))
  Leaf              -> fresh(k)
}

fn ins_edge(t: Tree, k: Int) : Tree = match t {
  Node(c, l, kx, r) ->
    if is_leaf(r) { Node(c, left(l), kx + red_int(l), fresh(k)) }
    else { Node(c, left(l), kx + red_int(l), ins_edge(r, k)) }
  Leaf -> fresh(k)
}

fn grow(which: Int, i: Int, n: Int, t: Tree) : Tree =
  if i >= n { t }
  else if which == 0 { grow(which, i + 1, n, ins(t, i)) }
  else if which == 1 { grow(which, i + 1, n, ins_same(t, i)) }
  else { grow(which, i + 1, n, ins_edge(t, i)) }

fn grow_all(i: Int, n: Int, t: Tree, kept: [Tree]) : [Tree] =
  if i >= n { [t, ...kept] } else { grow_all(i + 1, n, ins(t, i), [t, ...kept]) }

fn total(ts: [Tree], acc: Int) : Int = match ts {
  []        -> acc
  [x, ...r] -> total(r, acc + keys(x) + red_int(x))
}

fn report(name: String, t: Tree) : Unit / Stdout =
  Stdout.print("#{name}: size=#{size(t)} keys=#{keys(t)}")

fn main() : Unit / Stdout = {
  report("ins", grow(0, 0, 200, Leaf))
  report("ins_same", grow(1, 0, 200, Leaf))
  report("ins_edge", grow(2, 0, 200, Leaf))
  Stdout.print("shared: total=#{total(grow_all(0, 60, Leaf, []), 0)}")
}
