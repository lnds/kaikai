type V = VInt(Int) | VArr([V])

type St = { s: String, i: Int }

type Mode = MElem | MValue(V) | MClose

fn is_at(s: String, i: Int, c: Char) : Bool = match char_at(s, i) {
  None -> false
  Some(x) -> x == c
}

fn jump(st: St, n: Int) : St = St { ...st, i: st.i + n }

fn parse_value(st: St) : Option[Pair[St, V]] = match char_at(st.s, st.i) {
  None -> None
  Some(c) -> if c == '[' { parse_array(jump(st, 1)) }
         else if char.is_digit(c) { Some(Pair { fst: jump(st, 1), snd: VInt(1) }) }
         else { None }
}

fn parse_array(st: St) : Option[Pair[St, V]] = arr_loop(st, [], [], MElem)

fn arr_loop(st: St, stack: [[V]], acc: [V], mode: Mode) : Option[Pair[St, V]] = match mode {
  MElem -> {
    if is_at(st.s, st.i, ']') { arr_loop(jump(st, 1), stack, acc, MClose) }
    else if is_at(st.s, st.i, '[') { arr_loop(jump(st, 1), [acc, ...stack], [], MElem) }
    else { match parse_value(st) {
      None -> None
      Some(p) -> arr_loop(p.fst, stack, acc, MValue(p.snd))
    } }
  }
  MValue(v) -> {
    let more = [v, ...acc]
    if is_at(st.s, st.i, ']') { arr_loop(jump(st, 1), stack, more, MClose) }
    else if is_at(st.s, st.i, ',') { arr_loop(jump(st, 1), stack, more, MElem) }
    else { None }
  }
  MClose -> {
    let arr = VArr(list_reverse(acc))
    match stack {
      [] -> Some(Pair { fst: st, snd: arr })
      [parent, ...outer] -> arr_loop(st, outer, parent, MValue(arr))
    }
  }
}

fn show_v(v: V) : String = match v {
  VInt(n) -> "#{n}"
  VArr(xs) -> "[" ++ string_join(list.map(xs, show_v), ",") ++ "]"
}

fn try(src: String) : Unit / Stdout = match parse_value(St { s: src, i: 0 }) {
  Some(p) -> println(show_v(p.snd))
  None -> println("none")
}

fn main() : Unit / Stdout {
  try("[[]]")
  try("[[1]]")
  try("[1,[2]]")
  try("[[1,2],[3]]")
  try("[1x")
}
