# A record rebuilt around a written vector field: the parent is dead after
# the projection, so the field arrives unique at the write. 20000 writes,
# zero copies.

type St = { buf: Vec[Int], n: Int }

fn fill(s: St, i: Int) : St =
  if i >= 20000 { s }
  else { fill(St { buf: vec_set(s.buf, i, i), n: s.n + 1 }, i + 1) }

fn main() : Unit / Stdout = {
  let s = fill(St { buf: vec_make(20000, 0), n: 0 }, 0)
  Stdout.print(int_to_string(vec_get(s.buf, 19999) + s.n))
}
