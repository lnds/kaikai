# A let binder read in several statements moves into its last reader when
# that read is an owned call argument; a borrowed slot, a scrutinee or a read
# in one branch keeps the binder until the block ends. Unique and shared trees.

type T = N(T, Int, T) | L

fn mk(n: Int) : T = if n <= 0 { L } else { N(mk(n - 1), n, mk(n / 3)) }

fn size(t: T) : Int = match t {
  N(l, _, r) -> size(l) + 1 + size(r)
  L -> 0
}

fn sum(t: T) : Int = match t {
  N(l, x, r) -> sum(l) + x + sum(r)
  L -> 0
}

fn left(t: T) : T = match t {
  N(l, _, _) -> l
  L -> L
}

fn moved_last(n: Int) : Int {
  let t = mk(n)
  let a = size(t)
  let b = sum(t)
  a * 1000 + b
}

fn scrutinee_first(n: Int) : Int {
  let t = mk(n)
  let k = match t {
    N(l, _, _) -> size(l)
    L -> 0
  }
  let b = sum(t)
  k * 1000 + b
}

fn branch_last(n: Int, c: Bool) : Int {
  let t = mk(n)
  let a = size(t)
  let b = if c { sum(t) } else { 7 }
  a * 1000 + b
}

fn nested_last(n: Int) : Int {
  let t = mk(n)
  let a = size(t)
  let b = size(left(t))
  a * 1000 + b
}

fn tail_last(n: Int) : Int {
  let t = mk(n)
  let a = size(t)
  a * 1000 + size(left(t))
}

fn borrowed_tail(n: Int) : Int {
  let t = mk(n)
  let a = size(left(t))
  a * 1000 + sum(t)
}

fn shared_last(t: T) : Int {
  let u = t
  let a = size(u)
  let b = sum(u)
  a * 1000 + b + size(t)
}

fn main() : Unit / Stdout {
  Stdout.print("moved: #{moved_last(9)}")
  Stdout.print("scrutinee: #{scrutinee_first(9)}")
  Stdout.print("branch: #{branch_last(9, true)} #{branch_last(9, false)}")
  Stdout.print("nested: #{nested_last(9)}")
  Stdout.print("tail: #{tail_last(9)} #{borrowed_tail(9)}")
  let keep = mk(8)
  Stdout.print("shared: #{shared_last(keep)} #{size(keep)}")
}
