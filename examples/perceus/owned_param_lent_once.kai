# An owned param whose only read lands in a borrowed slot of another fn is
# still owned by the caller: the borrowing callee never releases it, so the
# caller must, after the call. Covers the read in tail, statement and `let`
# position, on one or both branches, on the base path of a self-tail loop, and
# behind a short-circuit `and` ahead of a later move of the same param.

fn nonempty(s: [Int]) : Int = match s {
  [] -> 0
  _  -> 1
}

fn cons0(s: [Int]) : [Int] = [0, ...s]

fn tail_read(s: [Int]) : Int = nonempty(s)

fn stmt_read(s: [Int]) : Int = {
  nonempty(s)
  2
}

fn let_read(s: [Int]) : Int = {
  let a = nonempty(s)
  a + 1
}

fn both_branches(s: [Int], b: Bool) : Int = if b { nonempty(s) } else { nonempty(s) }

fn one_branch(s: [Int], b: Bool) : Int = if b { nonempty(s) } else { nonempty(cons0(s)) }

fn base_path(s: [Int], n: Int) : Int = if n == 0 { nonempty(s) } else { base_path(s, n - 1) }

fn is_nonempty(s: [Int]) : Bool = match s {
  [] -> false
  _  -> true
}

fn kept(s: [Int]) : Int = nonempty(cons0(s))

fn short_circuit(s: [Int], k: Int) : Int =
  if k == 1 and is_nonempty(s) { kept(s) }
  else if k == 2 and is_nonempty(s) { kept(s) + 10 }
  else { kept(s) + 20 }

fn main() : Unit / Console = {
  println("#{tail_read([1, 2])} #{stmt_read([1, 2])} #{let_read([1, 2])}")
  println("#{both_branches([1], true)} #{both_branches([2], false)}")
  println("#{one_branch([1], true)} #{one_branch([2], false)}")
  println("#{base_path([1, 2, 3], 4)}")
  println("#{short_circuit(cons0([1]), 1)} #{short_circuit(cons0([1]), 2)} #{short_circuit(cons0([1]), 3)}")
}
