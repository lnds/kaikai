# A modulo-cons filter whose skipping branch is a bare self-call: the skip
# continues the loop with the accumulator open, so a 1M-deep input that
# skips every third element runs in constant stack. Covers the builtin
# cons and a user constructor.

type Tree = Leaf | Node(Tree, Int, Tree)

fn keep(xs: [Int], k: Int) : [Int] = match xs {
  []        -> []
  [h, ...t] -> if h % k != 0 { [h, ...keep(t, k)] } else { keep(t, k) }
}

fn sift(t: Tree, unused: String) : Tree = match t {
  Leaf          -> Leaf
  Node(l, v, r) -> if v % 3 != 0 { Node(l, v, sift(r, unused)) } else { sift(r, unused) }
}

fn build(n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { build(n - 1, [n, ...acc]) }

fn spine(n: Int, acc: Tree) : Tree =
  if n == 0 { acc } else { spine(n - 1, Node(Leaf, n, acc)) }

fn total(xs: [Int], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> total(t, acc + h)
}

fn walk(t: Tree, acc: Int) : Int = match t {
  Leaf          -> acc
  Node(_, v, r) -> walk(r, acc + v)
}

fn main() : Unit / Stdout = {
  let n = 1000000
  Stdout.print("#{total(keep(build(n, []), 3), 0)} #{walk(sift(spine(n, Leaf), "tag"), 0)}")
}
