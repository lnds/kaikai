# Companion to block_let_unused_alias: the never-read alias in other
# positions, spelled with the `_` prefix that silences the unused warning,
# plus the shapes where the aliased name stays live and the exit drop must
# NOT fire (a drop there would double-free).

fn mk() : [Int] = [1, 2, 3]

fn first(xs: [Int]) : Int =
  match xs {
    []        -> 0
    [h, ..._] -> h
  }

fn inner_block_alias() : Int = {
  let xs = mk()
  let n = {
    let _ys = xs
    7
  }
  n
}

fn alias_of_param(xs: [Int]) : Int = {
  let _ys = xs
  7
}

fn alias_chain() : Int = {
  let xs = mk()
  let ys = xs
  let _zs = ys
  7
}

fn original_read_after() : Int = {
  let xs = mk()
  let _ys = xs
  first(xs) + first(xs)
}

fn alias_of_param_read_after(xs: [Int]) : Int = {
  let _ys = xs
  first(xs)
}

fn branch_alias(flag: Bool) : Int = {
  let xs = mk()
  if flag {
    let _ys = xs
    7
  } else {
    first(xs)
  }
}

fn main() : Unit / Stdout = {
  let p = mk()
  let unread = "#{inner_block_alias()} #{alias_of_param(p)} #{alias_chain()}"
  let live = "#{original_read_after()} #{alias_of_param_read_after(p)} #{branch_alias(true)} #{branch_alias(false)}"
  Stdout.print("#{unread} | #{live} | #{first(p)}")
}
