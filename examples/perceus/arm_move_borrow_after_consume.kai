# `left(l)` consumes `l` and may free it; `is_red(l)` reads it afterwards in
# a borrowed slot. Moving every read of `l` would hand the borrow a freed
# cell, so `l` keeps its dup even though the arm otherwise earns the move.

type Color = Red | Black
type Tree = Leaf | Node(Color, Tree, Int, Tree)

fn is_red(t: Tree) : Bool = match t {
  Node(Red, _, _, _) -> true
  _                  -> false
}

fn left(t: Tree) : Tree = match t {
  Node(_, a, _, _) -> a
  Leaf             -> Leaf
}

fn size(t: Tree) : Int = match t {
  Node(_, a, _, b) -> 1 + size(a) + size(b)
  Leaf             -> 0
}

fn ins(t: Tree, k: Int) : Tree = match t {
  Node(c, l, kx, r) -> Node(c, left(l), kx + (if is_red(l) { 10 } else { 0 }), ins(r, k))
  Leaf              -> Node(Red, Node(Red, Leaf, k, Leaf), k, Leaf)
}

fn build(i: Int, n: Int, t: Tree) : Tree = if i >= n { t } else { build(i + 1, n, ins(t, i)) }

fn main() : Unit / Stdout = Stdout.print("size=#{size(build(0, 200, Leaf))}")
