# `n` is read once, behind an `and`, in an arm whose leaves are self-calls.
# Its read dups and the goto releases it on every path; no arm drop may pay
# it too, or the branch payer takes that drop for its single read.

type EFn = EFn(String, Int, Option[String])

fn is_root(e: EFn) : Bool = match e {
  EFn(_, _, None) -> true
  _               -> false
}

fn same_mo(e: EFn, m: String) : Bool = match e {
  EFn(_, _, Some(x)) -> x == m
  _                  -> false
}

fn has(xs: [String], n: String) : Bool = match xs {
  []        -> false
  [h, ...t] -> if h == n { true } else { has(t, n) }
}

fn filt(fns: [EFn], m: String, shadowed: [String], acc: [EFn]) : [EFn] = match fns {
  [] -> list_reverse(acc)
  [h, ...rest] -> match h {
    EFn(n, _, _) ->
      if not is_root(h) and same_mo(h, m) { filt(rest, m, shadowed, acc) }
      else if is_root(h) and has(shadowed, n) { filt(rest, m, shadowed, acc) }
      else { filt(rest, m, shadowed, [h, ...acc]) }
  }
}

fn mk(i: Int, acc: [EFn]) : [EFn] =
  if i == 0 { acc }
  else { mk(i - 1, [EFn(int_to_string(i % 5), i, if i % 2 == 0 { None } else { Some("a") }), ...acc]) }

fn go(i: Int, n: Int, t: Int) : Int =
  if i >= n { t } else { go(i + 1, n, t + list_length(filt(mk(40, []), "a", ["1", "2"], []))) }

fn main() : Unit / Stdout = Stdout.print("n=#{go(0, 100, 0)}")
