# A `region { }` inside a handler body is still a region: the marker is
# unwrapped and the block runs in its arena.
effect Ask {
  ask() : Int
}

fn main() : Unit / Console = {
  let r = handle {
    let n = Ask.ask()
    n + region { list.length([1, 2]) }
  } with Ask {
    ask(resume) -> resume(40)
  }
  println("#{r}")
}
