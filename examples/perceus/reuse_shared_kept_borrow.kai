# A reuse rebuild that keeps an arm binder in its own slot and also passes
# it to a borrowing call takes one reference for the slot on the shared
# path: the borrow takes none.
#
# `grow_all` keeps every version, so each `ins_same` descends a spine it
# shares with the older trees.

type Color = Red | Black
type Tree = Leaf | Node(Color, Tree, Int, Tree)

fn red_int(t: Tree) : Int = match t {
  Node(Red, _, _, _) -> 10
  _                  -> 0
}

fn keysum(t: Tree) : Int = match t {
  Node(_, a, k, b) -> k + keysum(a) + keysum(b)
  Leaf             -> 0
}

fn fresh(k: Int) : Tree = Node(Red, Node(Red, Leaf, k, Leaf), k, Leaf)

fn ins_same(t: Tree, k: Int) : Tree = match t {
  Node(c, l, kx, r) -> Node(c, l, kx + red_int(l), ins_same(r, k))
  Leaf              -> fresh(k)
}

fn grow_all(i: Int, n: Int, t: Tree, kept: [Tree]) : [Tree] =
  if i >= n { [t, ...kept] } else { grow_all(i + 1, n, ins_same(t, i), [t, ...kept]) }

fn sum_all(ts: [Tree], acc: Int) : Int = match ts {
  []        -> acc
  [t, ...r] -> sum_all(r, acc + keysum(t))
}

fn main() : Unit / Stdout = Stdout.print("sum=#{sum_all(grow_all(0, 60, Leaf, []), 0)}")
