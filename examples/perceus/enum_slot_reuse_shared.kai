# Enum slots across reuse rebuilds, with the tree both unique and shared.
#
# `Color` is all-nullary, so a node stores it as an immediate tag. The
# rotations below rebuild nodes in place (unique) or fresh (shared); in both
# branches the color written must be the literal tag and the old color slot
# must need no reference-count settlement. Inserting into a tree that is
# still alive forces the shared branch.

type Color = Red | Black

type Tree = Leaf | Node(Color, Tree, Int, Tree)

fn is_red(t: Tree) : Bool = match t {
  Node(Red, _, _, _) -> true
  _ -> false
}

fn balance_left(l: Tree, k: Int, r: Tree) : Tree = match l {
  Node(_, Node(Red, a, x, b), y, c) -> Node(Red, Node(Black, a, x, b), y, Node(Black, c, k, r))
  Node(_, a, x, Node(Red, b, y, c)) -> Node(Red, Node(Black, a, x, b), y, Node(Black, c, k, r))
  Node(_, a, x, b) -> Node(Black, Node(Red, a, x, b), k, r)
  Leaf -> Leaf
}

fn balance_right(l: Tree, k: Int, r: Tree) : Tree = match r {
  Node(_, Node(Red, a, x, b), y, c) -> Node(Red, Node(Black, l, k, a), x, Node(Black, b, y, c))
  Node(_, a, x, Node(Red, b, y, c)) -> Node(Red, Node(Black, l, k, a), x, Node(Black, b, y, c))
  Node(_, a, x, b) -> Node(Black, l, k, Node(Red, a, x, b))
  Leaf -> Leaf
}

fn ins(t: Tree, k: Int) : Tree = match t {
  Node(Red, l, x, r) ->
    if k < x {
      Node(Red, ins(l, k), x, r)
    } else if k > x {
      Node(Red, l, x, ins(r, k))
    } else {
      t
    }
  Node(Black, l, x, r) ->
    if k < x {
      if is_red(l) { balance_left(ins(l, k), x, r) } else { Node(Black, ins(l, k), x, r) }
    } else if k > x {
      if is_red(r) { balance_right(l, x, ins(r, k)) } else { Node(Black, l, x, ins(r, k)) }
    } else {
      t
    }
  Leaf -> Node(Red, Leaf, k, Leaf)
}

fn insert(t: Tree, k: Int) : Tree = match ins(t, k) {
  Node(_, l, x, r) -> Node(Black, l, x, r)
  Leaf -> Leaf
}

fn fill(t: Tree, off: Int, seed: Int, n: Int) : Tree =
  if n <= 0 { t } else { fill(insert(t, off + seed % 500), off, (seed * 37 + 11) % 1009, n - 1) }

fn size(t: Tree) : Int = match t {
  Leaf -> 0
  Node(_, l, _, r) -> 1 + size(l) + size(r)
}

fn reds(t: Tree) : Int = match t {
  Leaf -> 0
  Node(Red, l, _, r) -> 1 + reds(l) + reds(r)
  Node(Black, l, _, r) -> reds(l) + reds(r)
}

# Black height when every path agrees and no red node has a red child; -1 otherwise.
fn black_height(t: Tree) : Int = match t {
  Leaf -> 1
  Node(c, l, _, r) -> {
    let hl = black_height(l)
    let hr = black_height(r)
    let red_child = is_red(l) or is_red(r)
    if hl < 0 or hl != hr or (c == Red and red_child) {
      0 - 1
    } else if c == Black {
      hl + 1
    } else {
      hl
    }
  }
}

fn keys(t: Tree, acc: Int) : Int = match t {
  Leaf -> acc
  Node(_, l, x, r) -> keys(r, keys(l, acc) * 3 % 1000003 + x)
}

fn report(name: String, t: Tree) : Unit / Stdout =
  Stdout.print("#{name}: size=#{size(t)} reds=#{reds(t)} bh=#{black_height(t)} keys=#{keys(t, 0)}")

fn main() : Unit / Stdout {
  let base = fill(Leaf, 0, 7, 200)
  let left = fill(base, 250, 3, 150)
  let right = fill(base, 1000, 5, 150)
  report("base", base)
  report("left", left)
  report("right", right)
  report("grown", fill(left, 2000, 9, 300))
}
