# A binder from a plain list pattern, compared inside a lambda built in the
# arguments of a self tail call. No constructor is involved: the binder is
# the list element itself.

fn drain(acc: [[Int]], msgs: [[Int]]) : [[Int]] = match msgs {
  [] -> acc
  [v, ...rest] -> drain(filter(acc, l => l != v), rest)
}

fn main() : Unit / Stdout {
  let all = [[0], [1, 1]]
  Stdout.print("left: #{drain(all, [[0], [0]])}")
}
