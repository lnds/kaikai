# A nullary constructor is a constant immortal cell: building, matching,
# joining, storing, sending, comparing and showing one behave as before.

import spawn

#[derive(Eq, Show)]
type At = AtEven | AtOdd | AtEnd

#[derive(Eq, Show)]
type Tok = Word(String) | Blank | Eof

#[derive(Eq, Show)]
type Cell = { at: At, tok: Tok }

fn at(i: Int, n: Int) : At = if i >= n { AtEnd } else if i % 2 == 0 { AtEven } else { AtOdd }

fn walk(i: Int, n: Int, acc: Int) : Int = match at(i, n) {
  AtEnd -> acc
  AtEven -> walk(i + 1, n, acc + 1)
  AtOdd -> walk(i + 1, n, acc + 2)
}

fn classify(i: Int) : Tok =
  if i == 0 { Eof } else if i % 3 == 0 { Blank } else { Word("w#{i}") }

fn weight(t: Tok) : Int = match t {
  Word(s) -> string_length(s)
  Blank -> 10
  Eof -> 100
}

fn rename(t: Tok) : Tok = match t {
  Blank -> Eof
  Eof -> Blank
  other -> other
}

fn sum_toks(i: Int, acc: Int) : Int =
  if i > 9 { acc } else { sum_toks(i + 1, acc + weight(classify(i))) }

fn main() : Unit / Stdout + Spawn {
  Stdout.print("#{walk(0, 1000, 0)}")
  Stdout.print("#{sum_toks(0, 0)}")
  let toks = [0, 1, 3, 4, 6] | classify
  Stdout.print("#{toks}")
  Stdout.print("#{toks | rename}")
  let cells = [0, 1, 2] | (i => Cell { at: at(i, 2), tok: classify(i) })
  Stdout.print("#{cells}")
  Stdout.print("#{AtEven == at(0, 5)} #{AtEven == AtOdd} #{Blank == classify(3)} #{Eof != Blank}")
  Stdout.print("#{show(AtEnd)} #{show(Blank)}")
  let got = nursery { n ->
    let a = n.spawn(() => at(7, 5))
    let b = n.spawn(() => rename(Blank))
    let c = n.spawn(() => Cell { at: AtOdd, tok: Eof })
    (n.await(a), n.await(b), n.await(c))
  }
  Stdout.print("#{got}")
}
