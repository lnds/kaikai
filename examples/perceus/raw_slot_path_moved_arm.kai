# An arm binder read once on its path, moved into an unboxed parameter of
# a self tail call beside a boxed parameter, is released after the call.

fn step(acc: Int128, d: Int) : Option[Int128] =
  if d > 9 { None } else { Some(acc + int_to_int128(d)) }

fn sum_digits(s: String, i: Int, n: Int, acc: Int128) : Option[Int128] =
  if i >= n { Some(acc) }
  else {
    match step(acc, i) {
      None      -> None
      Some(nxt) -> sum_digits(s, i + 1, n, nxt)
    }
  }

fn main() : Unit / Stdout = match sum_digits("digits", 0, 8, int_to_int128(0)) {
  Some(v) -> Stdout.print(show(v))
  None    -> Stdout.print("none")
}
