# KAI_MAX_HEAP caps live bytes: building and dropping a 64 KiB string
# 50 000 times moves ~6 GB through the allocator but never holds more than
# a few hundred KiB, so a 64m cap must not trip.

fn grow(s: String, k: Int) : String =
  if k == 0 { s }
  else { grow(s ++ s, k - 1) }

fn churn(n: Int, acc: Int) : Int =
  if n == 0 { acc }
  else {
    let s = grow("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", 10)
    churn(n - 1, acc + string.length(s))
  }

fn main() : Int / Stdout = {
  Stdout.print("total=#{int_to_string(churn(50000, 0))}\n")
  0
}
