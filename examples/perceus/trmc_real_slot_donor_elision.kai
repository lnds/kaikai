# A TRMC spine step that rebuilds into the arm-top reuse token elides the
# store of any slot whose value is already in the donated shell. A Real slot
# is the one kind whose arm binder owns a box (`kai_real(slot.r)`), and that
# elided store was its only consumer — so the elision must release it or the
# rebuild orphans one Real per spine node.
#
# `push_max` descends the whole spine on the final below-min push: 20,000
# TRMC rebuilds, each re-placing `rx` at its own position of the same ctor.
# The live structure at exit is 20,001 cells plus their Reals; `leaked` above
# that is one orphaned box per node. The keys fold reads every Int slot back,
# so a rebuild that lost a slot shows up as a wrong sum, not only a count.

type Chain = End | Cell(Chain, Real, Int)

fn push_max(c: Chain, k: Int, r: Real) : Chain = match c {
  End -> Cell(End, r, k)
  Cell(rest, rx, kx) ->
    if k > kx { Cell(Cell(rest, rx, kx), r, k) }
    else      { Cell(push_max(rest, k, r), rx, kx) }
}

fn build(c: Chain, i: Int, n: Int) : Chain =
  if i >= n { c }
  else { build(push_max(c, i + 1, int_to_real(i + 1) * 0.5), i + 1, n) }

fn depth(c: Chain, acc: Int) : Int = match c {
  End -> acc
  Cell(rest, _, _) -> depth(rest, acc + 1)
}

fn sum_keys(c: Chain, acc: Int) : Int = match c {
  End -> acc
  Cell(rest, _, k) -> sum_keys(rest, acc + k)
}

fn main() = {
  let c = push_max(build(End, 0, 20000), 0, 0.125)
  println("depth: " ++ int_to_string(depth(c, 0)))
  println("keys: " ++ int_to_string(sum_keys(c, 0)))
}
