# A block-`let` binder whose only read sits inside the operand of `!`.
# The emitter's use scanner had no arm for the propagation node, so the
# catch-all hid that read: the binder looked unread, took the inline
# "fresh alloc, never used" decref right after its `let`, and was freed
# while the call it feeds still owned it. The next allocation recycled
# the cell, so an unrelated later value came back corrupted.

type Msg = { wekufe: String, duration_ms: Int }

fn validate(m: Msg) : Result[Msg, String] = Ok(m)

fn decode() : Result[Msg, String] = {
  let m = Msg { wekufe: "w", duration_ms: 52 }
  let v = validate(m)!
  Ok(v)
}

fn main() : Unit / Stdout = {
  Stdout.print(match decode() {
    Ok(m) -> "decoded #{m.wekufe} #{m.duration_ms}"
    Err(e) -> e
  })
}
