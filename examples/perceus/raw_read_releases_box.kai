# A boxed Int or Real binder whose payload is only copied out (a raw
# comparison, a raw slot) still owns its box: the read borrows it, so the
# binder is released at exit. Shown list elements reach `show(x: Int)` the
# same way. The values sit outside the small-int range.

type Box = Box(Int)
type R = { x: Int, y: Real }

fn big(i: Int) : Int = 4611686018427387904 + i

fn raw_i(v: Int) : Int = v + 1

fn raw_r(v: Real) : Int = if v > 0.0 { 1 } else { 0 }

fn compared(v: Int) : Int = {
  let f = (k: Int) => k + 1
  if v > 0 { f(1) } else { 0 }
}

fn effectful(v: Int) : Int / Stdout = if v > 0 { 1 } else { 0 }

fn slotted(v: Int, w: Real) : Int = {
  let f = (k: Int) => k + 1
  f(raw_i(v)) + raw_r(w)
}

fn armed(b: Box) : Int = match b {
  Box(v) -> compared(v)
}

fn round(i: Int) : Int / Stdout = {
  let r = R { x: big(i), y: 2.5 }
  let v = big(i)
  compared(big(i)) + effectful(big(i)) + compared(r.x) + compared(v) + compared(v)
    + slotted(big(i), r.y) + armed(Box(big(i))) + compared(4611686018427387999)
    + string_length("#{[big(i), big(i + 1)]}")
}

fn rounds(i: Int, total: Int) : Int / Stdout = if i == 0 { total } else { rounds(i - 1, total + round(i)) }

fn main() : Unit / Stdout = Stdout.print("#{rounds(100, 0)}")
