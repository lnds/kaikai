# `x!` hands the payload on and releases the `Some` / `Ok` box it came in,
# whether the operand is a fresh value or a binder read again later.

type R = R(String, [Int])

fn first(xs: [R]) : Option[R] = match xs {
  [] -> None
  [h, ...t] -> Some(h)
}

fn parse(s: String) : Result[Int, String] =
  if string_length(s) > 0 { Ok(string_length(s)) } else { Err("empty") }

fn names(xs: [R]) : Option[String] {
  let r = first(xs)!
  let n = match r {
    R(name, _) -> name
  }
  Some(n)
}

fn total(a: String, b: String) : Result[Int, String] {
  let x = parse(a)!
  let y = parse(b)!
  Ok(x + y)
}

fn again(o: Option[String]) : Option[Int] {
  let s = o!
  let t = o!
  Some(string_length(s) + string_length(t))
}

fn rounds(i: Int, acc: Int) : Int =
  if i == 0 {
    acc
  } else {
    let rs = [R("r#{i}", [i]), R("s", [])]
    let a = match names(rs) {
      Some(n) -> string_length(n)
      None -> 0
    }
    let b = match total("ab#{i}", "c") {
      Ok(v) -> v
      Err(_) -> 0
    }
    let c = match again(Some("x#{i}")) {
      Some(v) -> v
      None -> 0
    }
    rounds(i - 1, acc + a + b + c)
  }

fn main() : Unit / Stdout = Stdout.print("#{rounds(20, 0)}")
