# A fused Vec access that traps out of range pays the references it owns
# before it unwinds: the vec a read or a write consumes, the row a nested
# read was handed, and the field values a write carries. Each of the 30
# workers traps in one shape.

import actor
import spawn

type Flag = { on: Bool, n: Int }
type Glyph = { c: Char, w: Real }
type Point = { x: Int, y: Int }

fn flags(v: Vec[Flag], k: Int, n: Int) : Vec[Flag] =
  if k > n { v } else { flags(vec_push(v, Flag { on: k % 2 == 0, n: k }), k + 1, n) }

fn glyphs(v: Vec[Glyph], k: Int, n: Int) : Vec[Glyph] =
  if k > n { v } else { glyphs(vec_push(v, Glyph { c: int_to_char(64 + k), w: int_to_real(k) + 0.5 }), k + 1, n) }

fn points(v: Vec[Point], k: Int, n: Int) : Vec[Point] =
  if k > n { v } else { points(vec_push(v, Point { x: k, y: k }), k + 1, n) }

fn rows(k: Int) : Vec[Vec[Flag]] = vec_push(vec_empty(), flags(vec_empty(), 1, k))

fn bit(b: Bool) : Int = if b { 1 } else { 0 }

fn run_case(k: Int) : Int = match k % 7 {
  0 -> bit(vec_get(flags(vec_empty(), 1, 3), 3).on)
  1 -> char_to_int(vec_get(glyphs(vec_empty(), 1, 3), 0 - 1).c)
  2 -> bit(vec_get(vec_get(rows(3), 0), 7).on)
  3 -> vec_get(vec_get(rows(3), 0), 7).n
  4 -> vec_length(vec_set(flags(vec_empty(), 1, 3), 3, Flag { on: true, n: k }))
  5 -> vec_length(vec_set(glyphs(vec_empty(), 1, 3), 9, Glyph { c: 'z', w: int_to_real(k) + 0.25 }))
  _ -> vec_length(vec_set(points(vec_empty(), 1, 3), 0 - 4, Point { x: k, y: k }))
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = run_case(k)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 30)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
