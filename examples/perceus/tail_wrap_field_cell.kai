# Tuple arm binders read only through borrows in a block's tail, where the
# tail is no self-tail-call, so their release runs after the tail's value.
# `xs` and `ys` sit under a tuple side's list pattern. The caller keeps both
# lists alive, so an over-release frees cells it still reads.

fn count(l: [Int]) : Int = match l {
  []        -> 0
  [_, ...r] -> 1 + count(r)
}

fn total(l: [Int]) : Int = match l {
  []        -> 0
  [x, ...r] -> x + total(r)
}

fn score(a: [Int], b: [Int]) : Int = match (a, b) {
  ([x, ...xs], [y, ...ys]) -> {
    let z = x + y
    z + count(xs) + total(xs) + count(ys) + total(ys)
  }
  _ -> 0
}

fn run(i: Int, n: Int, a: [Int], b: [Int], acc: Int) : Int =
  if i >= n { acc } else { run(i + 1, n, a, b, acc + score(a, b)) }

fn main() : Unit / Stdout = {
  let a = [1, 2, 3, 4, 5]
  let b = [10, 20, 30]
  let s = run(0, 50, a, b, 0)
  Stdout.print("s=#{s} a=#{total(a)} b=#{total(b)} len=#{count(a)}")
}
