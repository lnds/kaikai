# A string the runtime builds from run-time data (an environment value, a
# socket path, a resolved host) is an ordinary heap string. Interned like a
# literal it would be pinned for good, one cell per distinct value; each
# round here reads back a value it has not seen before.

fn round(i: Int) : Int / Env = {
  let _ = Env.set_var("KAI_RUNTIME_DATA_STR", "value-#{i}")
  match Env.get("KAI_RUNTIME_DATA_STR") {
    Some(v) -> string_length(v)
    None    -> 0
  }
}

fn go(i: Int, acc: Int) : Int / Env = if i == 0 { acc } else { go(i - 1, acc + round(i)) }

fn main() : Unit / Env + Stdout = Stdout.print("#{go(100, 0)}")
