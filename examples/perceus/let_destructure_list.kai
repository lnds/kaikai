# A list pattern binds its elements wherever it appears: at the top of a
# `let`, and with a destructuring head under a record field.

type H = H(String, String)
type Tok = Tok(Int, Int)
type R = { f: [Tok], k: Int }

fn ints(xs: [Int]) : Int = {
  let [a, b, ...r] = xs
  a * 10 + b + r.length()
}

fn strs(xs: [H]) : String = {
  let [H(a, b), ...rest] = xs
  "#{a}#{b}#{rest.length()}"
}

fn exact(xs: [Tok]) : Int = {
  let [Tok(a, b)] = xs
  a - b
}

fn field_head(r: R) : Int = match r {
  R { f: [Tok(a, b), ..._], k: k } -> a + b + k
  _ -> 0
}

fn main() : Unit / Stdout = {
  Stdout.print("#{ints([4, 2, 9])}")
  Stdout.print(strs([H("x", "y"), H("p", "q")]))
  Stdout.print("#{exact([Tok(9, 4)])}")
  Stdout.print("#{field_head(R { f: [Tok(1, 2)], k: 3 })}")
}
