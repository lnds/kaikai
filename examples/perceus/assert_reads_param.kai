# A parameter read inside an `assert` or a `requires` counts as a use of
# it: each function is called twice with the same value, which a callee
# that consumed a parameter its caller lent would free on the first call.

type Box = { n: Int, xs: Array[Int] }

fn assert_index(c: Array[Int]) : Int = {
  assert(c[0] >= 0)
  1
}

fn assert_field(c: Box) : Int = {
  assert(c.n >= 0)
  2
}

fn assert_nested(c: Box) : Int = {
  assert(c.xs[0] >= 0)
  3
}

fn requires_index(c: Array[Int]) : Int
  requires c[0] >= 0
= 4

fn requires_field(c: Box) : Int
  requires c.n >= 0
= 5

fn requires_nested(c: Box) : Int
  requires c.xs[0] >= 0
= 6

fn main() : Unit / Stdout {
  let a = array.from([5])
  let b = Box { n: 5, xs: array.from([5]) }
  println("#{assert_index(a)} #{assert_index(a)}")
  println("#{assert_field(b)} #{assert_field(b)}")
  println("#{assert_nested(b)} #{assert_nested(b)}")
  println("#{requires_index(a)} #{requires_index(a)}")
  println("#{requires_field(b)} #{requires_field(b)}")
  println("#{requires_nested(b)} #{requires_nested(b)}")
  println("#{a[0]} #{b.xs[0]}")
}
