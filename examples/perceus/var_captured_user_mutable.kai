# A user `Mutable` handler around a captured `var` does not see the var's
# reads and writes: the var is its own cell.

import collections.vec

fn each_of[a, e](xs: [a], f: (a) -> Unit / e) : Unit / e = match xs {
  [] -> ()
  [h, ...t] -> {
    f(h)
    each_of(t, f)
  }
}

fn work() : Int {
  var v := vec.make(3, 0)
  each_of([0, 1, 2], i => {
    v := vec.set(v, i, i + 1)
  })
  vec.get(v, 2)
}

fn main() {
  let r = handle {
    work()
  } with Mutable {
    ref_make(init, resume) -> {
      println("make")
      resume(Mutable.ref_make(init))
    }
    ref_get(c, resume) -> {
      println("get")
      resume(Mutable.ref_get(c))
    }
    ref_set(c, v, resume) -> {
      println("set")
      resume(Mutable.ref_set(c, v))
    }
    return(x) -> x
  }
  println(int_to_string(r))
}
