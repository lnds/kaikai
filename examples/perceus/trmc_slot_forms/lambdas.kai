fn thunks(n: Int) : [() -> Int] = if n == 0 { [] } else { [() => n, ...thunks(n - 1)] }

fn boxed(xs: [String]) : [() -> String] =
  match xs {
    [] -> []
    [h, ...t] -> [() => h, ...boxed(t)]
  }

fn labels(n: Int, acc: [String]) : [String] = if n == 0 { acc } else { labels(n - 1, [int_to_string(n), ...acc]) }

fn sum_thunks(fs: [() -> Int], acc: Int) : Int =
  match fs {
    [] -> acc
    [f, ...t] -> sum_thunks(t, acc + f())
  }

fn len_thunks(fs: [() -> String], acc: Int) : Int =
  match fs {
    [] -> acc
    [f, ...t] -> len_thunks(t, acc + string_length(f()))
  }

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(sum_thunks(thunks(200000), 0)))
  Stdout.print(int_to_string(len_thunks(boxed(labels(200000, [])), 0)))
}
