effect Ask {
  ask() : Int
}

fn answers(n: Int) : [Int] =
  if n == 0 { [] }
  else { [handle { Ask.ask() + 1 } with Ask { ask(resume) -> resume(n) }, ...answers(n - 1)] }

fn total(xs: [Int], acc: Int) : Int =
  match xs {
    [] -> acc
    [x, ...t] -> total(t, acc + x)
  }

fn main() : Unit / Stdout = Stdout.print(int_to_string(total(answers(200000), 0)))
