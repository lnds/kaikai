type Pair = { a: Int, b: Int }

fn zip_pairs(xs: [Int], ys: [Int]) : [Pair] =
  match (xs, ys) {
    ([x, ...tx], [y, ...ty]) -> [Pair { a: x, b: y }, ...zip_pairs(tx, ty)]
    _ -> []
  }

fn upto(n: Int, acc: [Int]) : [Int] = if n == 0 { acc } else { upto(n - 1, [n, ...acc]) }

fn total(ps: [Pair], acc: Int) : Int =
  match ps {
    [] -> acc
    [p, ...t] -> total(t, acc + p.a + p.b)
  }

fn main() : Unit / Stdout = {
  let xs = upto(200000, [])
  Stdout.print(int_to_string(total(zip_pairs(xs, xs), 0)))
}
