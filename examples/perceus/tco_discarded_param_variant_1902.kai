# The discarding shape over a variant instead of a record — the class is not
# about records.
type Box = B([String])

fn fresh(e: Box, p: String) : Box = B([p])

fn build(e: Box, i: Int, n: Int) : Box =
  if i >= n { e } else { build(fresh(e, "p"), i + 1, n) }

fn main() : Unit / Stdout = {
  let b = build(B([]), 0, 200000)
  Stdout.print("n=#{match b { B(l) -> list_length(l) }}")
}
