# A descent rebuilt as its own constructor keeps the slots it does not change:
# an enum slot, scalar and pointer binders, a binder read twice, and a pointer
# slot matched as a nullary constructor, on unique and on shared trees.

type Color = Red | Black

type T = Node(Color, T, Int, T) | Leaf

fn size(t: T) : Int = match t {
  Node(_, l, _, r) -> size(l) + 1 + size(r)
  Leaf -> 0
}

fn ins(t: T, k: Int) : T = match t {
  Node(c, Leaf, x, r) ->
    if k < x { Node(c, Node(Red, Leaf, k, Leaf), x, r) } else { Node(c, Leaf, x, ins(r, k)) }
  Node(Red, l, x, r) -> if k < x { Node(Red, ins(l, k), x, r) } else { Node(Red, l, x, ins(r, k)) }
  Node(Black, l, x, r) ->
    if size(r) > size(l) + 2 {
      Node(Black, ins(l, k), x, r)
    } else if k < x {
      Node(Black, ins(l, k), x, r)
    } else {
      Node(Black, l, x, ins(r, k))
    }
  Leaf -> Node(if k % 2 == 0 { Red } else { Black }, Leaf, k, Leaf)
}

fn sig(t: T, acc: Int) : Int = match t {
  Node(Red, l, x, r) -> sig(r, (sig(l, acc) * 3 + x) % 1000003)
  Node(Black, l, x, r) -> sig(r, (sig(l, acc) * 7 + x) % 1000003)
  Leaf -> acc
}

fn fill(t: T, s: Int, n: Int) : T =
  if n <= 0 { t } else { fill(ins(t, s % 997), (s * 31 + 17) % 10007, n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("unique: size=#{size(fill(Leaf, 5, 300))} sig=#{sig(fill(Leaf, 5, 300), 0)}")
  let base = fill(Leaf, 11, 200)
  let grown = fill(base, 3, 100)
  Stdout.print("shared: base=#{size(base)} #{sig(base, 0)} grown=#{size(grown)} #{sig(grown, 0)}")
}
