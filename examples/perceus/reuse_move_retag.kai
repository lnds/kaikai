# A unique cell rebuilt in place as a different constructor of the same arity
# takes the new tag; a shared one is copied and keeps the original intact.

type Pair = Fwd(Int, Pair) | Rev(Int, Pair) | Stop

fn flip(p: Pair) : Pair = match p {
  Fwd(x, rest) -> Rev(x + 1, flip(rest))
  Rev(x, rest) -> Fwd(x * 2, flip(rest))
  Stop -> Stop
}

fn build(n: Int, acc: Pair) : Pair =
  if n <= 0 {
    acc
  } else if n % 2 == 0 {
    build(n - 1, Fwd(n, acc))
  } else {
    build(n - 1, Rev(n, acc))
  }

fn sig(p: Pair, acc: Int) : Int = match p {
  Fwd(x, rest) -> sig(rest, (acc * 3 + x) % 1000003)
  Rev(x, rest) -> sig(rest, (acc * 5 + x) % 1000003)
  Stop -> acc
}

fn fwds(p: Pair, acc: Int) : Int = match p {
  Fwd(_, rest) -> fwds(rest, acc + 1)
  Rev(_, rest) -> fwds(rest, acc)
  Stop -> acc
}

fn main() : Unit / Stdout {
  let base = build(40, Stop)
  let shared = flip(base)
  Stdout.print("base: fwds=#{fwds(base, 0)} sig=#{sig(base, 0)}")
  Stdout.print("shared: fwds=#{fwds(shared, 0)} sig=#{sig(shared, 0)}")
  let owned = flip(flip(build(40, Stop)))
  Stdout.print("owned: fwds=#{fwds(owned, 0)} sig=#{sig(owned, 0)}")
}
