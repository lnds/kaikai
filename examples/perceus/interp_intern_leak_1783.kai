# Every string interpolation of a distinct value used to pin one
# immortal cell: the runtime's number-to-string conversions routed
# their transient buffers through the string-intern table, which never
# frees an inserted entry. 2000 unique-value interpolations must run
# with a bounded RC ledger.
fn spin(n: Int, acc: Int) : Int =
  if n == 0 { acc } else { spin(n - 1, acc + string_length("s#{n}")) }

fn main() : Unit / Stdout = {
  Stdout.print("total=#{spin(2000, 0)}")
}
