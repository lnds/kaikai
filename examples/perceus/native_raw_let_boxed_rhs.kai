# A raw Int `let` bound from a boxed rhs (a call, or `+ - *` with a boxed
# operand) releases that box on both backends.

type Cell = { n: Int }

fn big(c: Cell) : Int = c.n * 1000003

fn fold(c: Cell, i: Int, acc: Int) : Int =
  if i == 0 { acc }
  else {
    let a = big(c) + i
    let b = a * 3
    let d = big(c)
    let e = bit_ushr(d, 3)
    fold(c, i - 1, acc + a - b + d + e)
  }

fn main() : Unit / Stdout = {
  let c = Cell { n: 5840696475078 }
  Stdout.print(int_to_string(fold(c, 1000, 0)))
}
