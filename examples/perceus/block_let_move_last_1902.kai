# A block-`let` binder whose initialiser is a `match`, living inside a
# match arm, whose single read lands in a consuming slot. Such a binder
# is not a pattern binder, so it never entered the move-at-last-use set:
# the lone read kept its conservative dup and the birth ref was orphaned,
# leaking one value per iteration. The move set now covers block lets, so
# the read transfers the ref and the loop stays flat.

fn strip(key: String) : Option[String] = {
  let kn = string_length(key)
  if kn <= 3 { None } else { Some(string_slice(key, 3, kn - 3)) }
}

fn walk(es: [Int], acc: [String]) : [String] = {
  match es {
    [] -> acc
    [_x, ...rest] -> {
      let vis = match strip("Foo::Bar") {
        Some(b) -> b
        None -> "zz"
      }
      walk(rest, [vis, ...acc])
    }
  }
}

fn mk(i: Int, acc: [Int]) : [Int] = {
  if i == 0 { acc } else { mk(i - 1, [i, ...acc]) }
}

fn outer(i: Int, es: [Int], n: Int) : Int = {
  if i == 0 { n } else { outer(i - 1, es, n + list_length(walk(es, []))) }
}

fn main() : Unit / Stdout = {
  let es = mk(20, [])
  Stdout.print("n=#{outer(50, es, 0)}")
}
