# A boxed scalar read as a raw value must release its box when nothing else
# holds it: a call or compound result crossing into a raw fn's return, a raw
# operand, or a raw argument. Chars at or above 128, Reals and the fixed-width
# integers are fresh heap cells, so every missed release is one retained cell
# per iteration.

type Px = Px(Char, Char, Char, Char) | NoPx

type P = { x: Real, y: Real }

fn mk(n: Int) : Char = int_to_char(200 + n % 1000)

fn px_of(i: Int) : Px = Px(mk(i), mk(i / 7), mk(i / 49), mk(3))

fn same4(i: Int) : Px = {
  let c = mk(i)
  Px(c, c, c, c)
}

fn flip(p: Px) : Px = match p {
  Px(a, b, c, d) -> Px(d, c, b, a)
  NoPx           -> NoPx
}

fn chan(p: Px) : Int = match p {
  Px(r, g, b, a) -> char_to_int(r) + char_to_int(g) * 3 + char_to_int(b) * 5 + char_to_int(a) * 7
  NoPx           -> 0
}

fn px_sum(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else { px_sum(i + 1, n, acc + chan(px_of(i)) + chan(flip(same4(i)))) }

fn scaled(n: Int) : Real = int_to_real(n) * 1.5

fn narrow(n: Int) : Int32 = int_to_int32(n % 1000)

fn wide(n: Int) : UInt64 = int_to_uint64(n * 3)

fn norm1(p: P) : Real = p.x + p.y

fn get(o: Option[Real]) : Real = match o {
  Some(x) -> x
  None    -> 0.25
}

fn opt(i: Int) : Option[Real] = if i % 2 == 0 { Some(int_to_real(i)) } else { None }

fn apply(f: (Int) -> Real, i: Int) : Real = f(i) + 1.0

fn num_sum(i: Int, n: Int, acc: Real) : Real =
  if i >= n { acc } else {
    let r = scaled(i) + int_to_real(int32_to_int(narrow(i)) + uint64_to_int(wide(i)))
    let s = norm1(P { x: int_to_real(i), y: 0.5 }) + get(opt(i)) + apply((k) => int_to_real(k) * 0.25, i)
    num_sum(i + 1, n, acc + r + s)
  }

fn main() : Unit / Stdout = {
  Stdout.print("px=#{px_sum(0, 50000, 0)}")
  Stdout.print("num=#{real_to_int(num_sum(0, 50000, 0.0))}")
}
