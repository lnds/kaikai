# A local lambda that calls another local lambda it captured. Beta
# reduction pastes the outer body at the call site and sweeps the closure;
# the inner lambda it captured must stay alive through the pasted body even
# though the caller dropped its own reference before the site.

fn plain(k: Int) : Int = {
  let r = (i: Int) => i + 1
  let via = (i: Int) => r(i)
  via(k)
}

fn twice(k: Int) : Int = {
  let r = (i: Int) => i + 1
  let via = (i: Int) => r(i) + r(i + 1)
  via(k)
}

fn captures(k: Int) : Int = {
  let r = (i: Int) => i + k
  let via = (i: Int) => r(i)
  via(k)
}

fn app(f: (Int) -> Int, x: Int) : Int = f(x)

fn passed(k: Int) : Int = {
  let r = (i: Int) => i + 1
  app((i: Int) => r(i), k)
}

fn three(k: Int) : Int = {
  let c = (i: Int) => i + k
  let b = (i: Int) => c(i) * 2
  let a = (i: Int) => b(i) + 1
  a(k)
}

fn used_after(k: Int) : Int = {
  let r = (i: Int) => i + k
  let via = (i: Int) => r(i)
  let x = via(k)
  x + r(1)
}

fn in_arm(o: Option[Int], k: Int) : Int = match o {
  Some(v) -> {
    let r = (i: Int) => i + v
    let via = (i: Int) => r(i)
    via(k)
  }
  None -> 0
}

fn in_loop(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else {
    let r = (j: Int) => j + i
    let via = (j: Int) => r(j)
    in_loop(i + 1, n, acc + via(i))
  }

fn heap(name: String) : String = {
  let tag = "<#{name}>"
  let r = (s: String) => "#{tag}#{s}"
  let via = (s: String) => r(s)
  via(name)
}

fn heap_list(k: Int) : Int = {
  let xs = [k, k + 1, k + 2]
  let r = (i: Int) => i + list_length(xs)
  let via = (i: Int) => r(i)
  via(k) + list_length(xs)
}

fn main() : Unit / Stdout = {
  Stdout.print("plain=#{plain(5)} twice=#{twice(5)} captures=#{captures(5)} passed=#{passed(5)}")
  Stdout.print("three=#{three(5)} used_after=#{used_after(5)} arm=#{in_arm(Some(7), 5)} none=#{in_arm(None, 5)}")
  Stdout.print("loop=#{in_loop(0, 1000, 0)} heap=#{heap("kai")} list=#{heap_list(5)}")
}
