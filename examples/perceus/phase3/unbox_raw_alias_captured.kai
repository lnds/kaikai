# A raw-bound Bool or Char read where a boxed value is wanted (an alias a
# closure captures) is boxed by its own type.

fn main() : Unit / Stdout = {
  let w = true
  let n = w
  let w = 6
  let pick = (x: Int) => if n { w + x } else { 2 }
  Stdout.print("#{pick(1)} #{[1, 2] | ((x) => if n { x } else { 0 })}")
  let c = 'k'
  let d = c
  let label = (x: Int) => "#{d}#{x}"
  Stdout.print(label(3))
}
