# A user `State` handler around a closure that writes a captured `var`
# never sees the var's reads and writes: the var is its own cell.

import collections.vec

fn each_of[a, e](xs: [a], f: (a) -> Unit / e) : Unit / e = match xs {
  [] -> ()
  [h, ...t] -> {
    f(h)
    each_of(t, f)
  }
}

fn work() : Int / State[Int] {
  var v := vec.make(4, 0)
  each_of([0, 1, 2, 3], i => {
    v := vec.set(v, i, i + 1)
  })
  State.set(State.get() + 10)
  vec.get(v, 3)
}

fn main() {
  let r = handle {
    work()
  } with State[Int](5) {
    get(resume) -> {
      println("user get")
      resume(state)
    }
    set(v, resume) -> {
      println("user set")
      resume((), v)
    }
    return(x) -> x
  }
  println(int_to_string(r))
}
