# A binder the arguments of a tail call read twice is released before the
# jump. A mutually recursive group runs as one function that matches on a
# discriminant, so the release must not depend on the function matching
# none of its parameters. An argument that is a raw scalar on one path and
# a box on another must not cost a box on the raw one.

type Box = { w: Real, path: String }

fn pick(n: Int) : String = if n % 2 == 0 { "" } else { "box" }

fn word(n: Int) : String = int_to_string(n % 7)

fn len(s: String) : Real = int_to_real(string_length(s))

fn lit_ping(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = pick(n)
    lit_pong(n - 1, acc + len(p) + len(p))
  }
}

fn lit_pong(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = pick(n)
    lit_ping(n - 1, acc + len(p) + len(p))
  }
}

fn rec_ping(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let b = Box { w: 1.5, path: word(n) }
    rec_pong(n - 1, acc + len(b.path) + len(b.path))
  }
}

fn rec_pong(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let xs = [word(n), word(n + 1)]
    rec_ping(n - 1, acc + int_to_real(list_length(xs)) + int_to_real(list_length(xs)))
  }
}

fn clo_ping(n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let f = (k: Int) => k + n
    clo_pong(n - 1, acc + f(1) + f(2))
  }
}

fn clo_pong(n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let p = word(n)
    clo_ping(n - 1, acc + string_length(p) + string_length(p))
  }
}

fn str_ping(n: Int, acc: String) : String {
  if n == 0 { acc } else {
    let p = word(n)
    str_pong(n - 1, string_concat(acc, int_to_string(string_length(p) + string_length(p))))
  }
}

fn str_pong(n: Int, acc: String) : String {
  if n == 0 { acc } else {
    let p = word(n)
    str_ping(n - 1, string_concat(acc, int_to_string(string_length(p) + string_length(p))))
  }
}

fn tri_a(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = word(n)
    tri_b(n - 1, acc + len(p) + len(p))
  }
}

fn tri_b(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = word(n)
    match string_length(p) {
      0 -> tri_c(n - 1, acc + 0.5)
      _ -> tri_c(n - 1, acc + len(p) + len(p))
    }
  }
}

fn tri_c(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = word(n)
    if n % 3 == 0 { tri_c(n - 1, acc + 0.5) }
    else { tri_a(n - 1, acc + int_to_real(string_length(p)) + int_to_real(string_length(p))) }
  }
}

fn wide_ping(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = word(n)
    wide_pong(acc + len(p) + len(p), string_length(p), n - 1)
  }
}

fn wide_pong(acc: Real, k: Int, n: Int) : Real {
  if n == 0 { acc } else {
    let p = word(n + k)
    wide_ping(n - 1, acc + len(p) + len(p))
  }
}

fn by_tag(tag: Int, n: Int, acc: Real) : Real {
  match tag {
    0 -> if n == 0 { acc } else {
      let p = word(n)
      by_tag(1, n - 1, acc + len(p) + len(p))
    }
    _ -> if n == 0 { acc } else {
      let p = word(n)
      by_tag(0, n - 1, acc + len(p) + len(p) + 1.0)
    }
  }
}

fn main() {
  print(real_to_string(lit_ping(200, 0.0)))
  print(real_to_string(rec_ping(200, 0.0)))
  print(int_to_string(clo_ping(200, 0)))
  print(int_to_string(string_length(str_ping(200, ""))))
  print(real_to_string(tri_a(200, 0.0)))
  print(real_to_string(wide_ping(200, 0.0)))
  print(real_to_string(by_tag(0, 200, 0.0)))
}
