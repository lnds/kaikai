# Control: the discarding callee reached by NON-tail recursion, so no goto.
# The goto is the necessary condition for the retention.
type Env = { entries: [String] }

fn fresh(e: Env, p: String) : Env = Env { entries: [p] }

fn build(e: Env, i: Int, n: Int) : Int =
  if i >= n { 0 } else { 1 + build(fresh(e, "p"), i + 1, n) }

fn main() : Unit / Stdout = {
  Stdout.print("n=#{build(Env { entries: [] }, 0, 20000)}")
}
