# An out-of-range `vec.set` traps in the callee of a taken captured-`var`
# read: the cell holds the placeholder while the frame unwinds, and it must
# drop cleanly. C has no pads: the growth baseline pins what each trapped
# worker keeps there.

import actor
import spawn
import collections.vec

fn each_of[a, e](xs: [a], f: (a) -> Unit / e) : Unit / e = match xs {
  [] -> ()
  [h, ...t] -> {
    f(h)
    each_of(t, f)
  }
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link {
  Link.link(parent)
  var v := vec.make(3, 0)
  each_of([9 + k], i => {
    v := vec.set(v, i, 1)
  })
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n {
  0
} else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 10)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
