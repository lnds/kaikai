# Pattern binders bind BEFORE the guard decides; when the guard is
# false, control falls to the next arm without running the body or any
# of its exits. The rest binder here points into the list being walked,
# so one unpaid bind-incref per iteration pins the entire remaining
# tail in cascade. The guard's own read of `y` pays y's ref whichever
# way the guard goes; the guard-fail drops must cover the rest binder.
type Pair = { a: Int, b: String }

fn walk(xs: [Pair], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> match t {
    [y, ...r] if y.a < 0 -> walk(r, acc + 1)
    _                    -> walk(t, acc + h.a)
  }
}

fn build(n: Int, acc: [Pair]) : [Pair] =
  if n == 0 { acc } else { build(n - 1, [Pair { a: n, b: "p_#{n}" }, ...acc]) }

fn main() : Unit / Stdout = {
  let total = walk(build(3000, []), 0)
  Stdout.print("total=#{total}")
}
