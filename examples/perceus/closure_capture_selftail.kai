# A match-arm binder captured by a closure in the args of a self-tail call.
# The binder's release must run after the args have built the closure; a
# release before them frees the payload the closure is about to capture
# (the native backend has already dropped the scrutinee by then).

#[derive(Eq, Show)]
type Life = { worker: Int, summons: Int }

type Msg = Wire(Life) | Cancel

fn drain(lives: [Life], msgs: [Msg]) : [Life] = match msgs {
  [] -> lives
  [Cancel, ...rest] -> drain(lives, rest)
  [Wire(life), ...rest] -> drain(filter(lives, l => l != life), rest)
}

fn main() : Unit / Stdout {
  let all = [Life { worker: 0, summons: 1 }, Life { worker: 1, summons: 1 }]
  Stdout.print("left: #{drain(all, [Wire(Life { worker: 0, summons: 1 })])}")
}
