# A binder read once, by a move, behind one alternative of an `if` or
# `match`: the alternatives that skip the read must release its birth
# reference on entry, or every evaluation through them leaks one cell.
# Covers arm binders (String, Char and typed Real slots), a block `let`,
# nested alternatives, a missing `else`, and a self-recursive function
# whose value leaf returns before the recursion reads the tail.

type Px = Px(String, Int) | NoPx
type Pc = Pc(Char, Int) | NoPc
type Pr = Pr(Real, Int) | NoPr

fn then_read(p: Px) : Int = match p {
  Px(s, k) -> if k > 0 { string_length(s) } else { 7 }
  NoPx     -> 0
}

fn else_read(p: Px) : Int = match p {
  Px(s, k) -> if k == 0 { 7 } else { string_length(s) }
  NoPx     -> 0
}

fn nested_read(p: Px) : Int = match p {
  Px(s, k) -> if k > 0 { match k { 1 -> 4  _ -> if k > 5 { 5 } else { string_length(s) } } } else { 7 }
  NoPx     -> 0
}

fn no_else(p: Px) : Int = match p {
  Px(s, k) -> {
    if k > 0 { let _n = string_length(s); () }
    4
  }
  NoPx -> 0
}

fn let_read(x: String, k: Int) : Int = {
  let s = string_concat(x, "!")
  if k > 0 { string_length(s) } else { 7 }
}

fn char_read(p: Pc) : Int = match p {
  Pc(r, k) -> if k > 0 { char_to_int(r) } else { 7 }
  NoPc     -> 0
}

fn real_read(p: Pr) : Option[Real] = match p {
  Pr(x, k) -> if k > 0 { Some(x) } else { None }
  NoPr     -> None
}

fn has(xs: [String], x: String) : Bool = match xs {
  []        -> false
  [h, ...t] -> if h == x { true } else { has(t, x) }
}

fn px(i: Int) : Px = Px(int_to_string(i * 7919), i % 3)

fn real_val(o: Option[Real]) : Int = match o {
  Some(x) -> real_to_int(x)
  None    -> 1
}

fn drive(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc }
  else {
    let a = then_read(px(i)) + else_read(px(i)) + nested_read(px(i)) + no_else(px(i))
    let b = let_read(int_to_string(i), i % 3)
    let c = char_read(Pc(int_to_char(65 + i % 20), i % 3))
    let d = real_val(real_read(Pr(int_to_real(i) * 1.5, i % 3)))
    let e = if has([int_to_string(i), "b", "c"], int_to_string(i)) { 1 } else { 0 }
    drive(i + 1, n, acc + a + b + c + d + e)
  }

fn main() : Unit / Stdout = Stdout.print("total=#{drive(0, 3000, 0)}")
