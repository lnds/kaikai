# A `let` bound inside a match arm's block and read once hands its value on
# at that read. The arm's binders are named apart from every other binder of
# the function, so the read table counts the `let`'s one read once.

type Px = Px(String, Int) | NoPx

fn f(p: Px) : Int = match p {
  Px(s0, k) -> {
    let s = string_concat(s0, "a")
    string_length(s) + k
  }
  NoPx -> 0
}

fn go(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else { go(i + 1, n, acc + f(Px(int_to_string(i * 7919), i % 3))) }

fn main() : Unit / Stdout = Stdout.print("r=#{go(0, 3000, 0)}")
