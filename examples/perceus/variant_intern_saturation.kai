# Interned variants nest, so their identities multiply: 17^4 `Px` payloads
# pair into far more `Q` payloads than the intern table holds. Once it is
# full, a construction must cost a bounded probe and return an ordinary
# cell that is freed; the table retains at most its capacity.

# `Cx` keeps `C` boxed: an all-nullary enum travels as an immediate tag and
# never reaches the intern table.
type C = C0 | C1 | C2 | C3 | C4 | C5 | C6 | C7 | C8 | C9 | C10 | C11 | C12 | C13 | C14 | C15 | Cx(Int)

type Px = Px(C, C, C, C) | NoPx

type Q = Q(Px, Px) | NoQ

fn c_of(n: Int) : C = match n % 16 {
  0  -> C0
  1  -> C1
  2  -> C2
  3  -> C3
  4  -> C4
  5  -> C5
  6  -> C6
  7  -> C7
  8  -> C8
  9  -> C9
  10 -> C10
  11 -> C11
  12 -> C12
  13 -> C13
  14 -> C14
  _  -> C15
}

fn c_int(c: C) : Int = match c {
  C0    -> 0
  C1    -> 1
  C2    -> 2
  C3    -> 3
  C4    -> 4
  C5    -> 5
  C6    -> 6
  C7    -> 7
  C8    -> 8
  C9    -> 9
  C10   -> 10
  C11   -> 11
  C12   -> 12
  C13   -> 13
  C14   -> 14
  C15   -> 15
  Cx(k) -> k
}

fn px_of(i: Int) : Px = Px(c_of(i), c_of(i / 16), c_of(i / 256), c_of(i / 4096))

fn q_of(i: Int) : Q = Q(px_of(i), px_of(i / 65536))

fn px_int(p: Px) : Int = match p {
  Px(a, b, c, d) -> c_int(a) + c_int(b) + c_int(c) + c_int(d)
  NoPx           -> 0
}

fn chan(q: Q) : Int = match q {
  Q(a, b) -> px_int(a) + px_int(b)
  NoQ     -> 0
}

fn q_sum(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else { q_sum(i + 1, n, acc + chan(q_of(i))) }

fn main() : Unit / Stdout = Stdout.print("q=#{q_sum(0, 1000000, 0)}")
