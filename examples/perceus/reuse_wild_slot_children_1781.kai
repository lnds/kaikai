# A typed-payload rebuild whose donor has pointer slots the rebuild does
# not re-embed (both binders elided to `_`): the donate path must pay the
# old children's cell claims or every reuse leaks them.

type M = MVal(Int, [Int]) | MErr(Int, [Int])

fn flip(r: M) : M = match r {
  MVal(v, xs) -> MVal(v * 2, xs)
  MErr(e, xs) -> MVal(99, [1])
}

fn spin(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    match flip(MErr(7, [5, 6])) {
      MVal(v, _) -> spin(n - 1, acc + v)
      MErr(_, _) -> spin(n - 1, acc)
    }
  }

fn main() : Unit / Stdout = {
  Stdout.print("s=#{spin(1500, 0)}")
}
