# Sibling arms binding the SAME name must not share last-use analysis:
# the arms are mutually exclusive, so a read in one arm can never occur
# together with a read in the other. A fn-wide use table keyed by name
# marks every such read non-last and dups it. In a call shape the dup
# orphans the binder's extraction ref (one leaked cell per hit); in a
# recognised-rebuild shape the reuse sentinel compensates, and that
# compensation must keep holding once the dup is gone.

type P = Pv(Int) | Pw(Int)

type T = C(P, [Int]) | W([Int], [Int])

fn total(xs: [Int]) : Int = match xs {
  []           -> 0
  [h, ...rest] -> h + total(rest)
}

# Call shape: each colliding binder's single read flows to a consuming
# call, so a spurious dup leaks the extracted list.
fn crush_call(t: T) : Int = match t {
  C(Pv(_), ys) -> total(ys)
  C(Pw(_), ys) -> total(ys) * 2
  W(a, b)      -> total(a) + total(b)
}

# Rebuild shape: both arms are recognised reuse rebuilds of the matched
# cell; the colliding binder feeds a rebuild slot.
fn crush_reuse(t: T) : T = match t {
  C(Pv(_), ys) -> W(ys, [9])
  C(Pw(_), ys) -> W([8], ys)
  W(a, b)      -> C(Pv(total(a)), b)
}

fn spin(n: Int, acc: Int) : Int {
  if n == 0 { acc }
  else {
    let s = crush_call(C(Pv(n), [n, n + 1]))
    let s2 = crush_call(C(Pw(n), [n, n + 2]))
    let r = match crush_reuse(C(Pv(n), [n, n + 3])) {
      W(_, ys2)  -> total(ys2)
      C(_, _)    -> 0
    }
    let r2 = match crush_reuse(C(Pw(n), [n, n + 4])) {
      W(ys3, _)  -> total(ys3)
      C(_, _)    -> 0
    }
    spin(n - 1, acc + s + s2 + r + r2)
  }
}

fn main() : Int / Stdout = {
  Stdout.print("sum=#{int_to_string(spin(2000, 0))}")
  0
}
