# A single consuming read in a guard's short-circuited `and`-RHS: the
# skipped edge must still pay the binder's birth ref, and the taken edge
# must not pay it twice.

fn total(y: [Int]) : Int = match y {
  [h, ...t] -> h + total(t)
  []        -> 0
}

fn build(n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { build(n - 1, [n, ...acc]) }

fn scan(xs: [[Int]], flag: Bool, acc: Int) : Int = match xs {
  [y, ...t] if flag and total(y) > 0 -> scan(t, flag, acc + 1)
  [_, ...t]                          -> scan(t, flag, acc)
  []                                 -> acc
}

fn mk(n: Int, acc: [[Int]]) : [[Int]] =
  if n == 0 { acc } else { mk(n - 1, [build(10, []), ...acc]) }

fn main() : Unit / Stdout = {
  let a = scan(mk(600, []), false, 0)
  let b = scan(mk(600, []), true, 0)
  Stdout.print("a=#{a} b=#{b}")
}
