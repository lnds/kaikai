# A derived `to_json` builds every field at the type's position. With
# `Spawn` in the program, encoding a list of a hand-written impl can
# unwind while encoding a list of strings can only trap: the two calls
# share a site key, and one node must not both bracket and pad `self`,
# called directly or through fused map stages.

import encoding.json
import spawn
import encoding.json_bind

type Spell = Fire | Ice

impl Json for Spell {
  fn to_json(self: Spell) : JsonValue = match self {
    Fire -> JStr("fire")
    Ice -> JStr("ice")
  }
  fn of_json(v: JsonValue, path: String) : Result[Spell, JsonError] = Ok(Fire)
}

#[derive(Json)]
type Sites = { files: [String], spells: [Spell] }

fn main() : Unit / Stdout + Spawn = {
  nursery { n ->
    let _ = n.spawn(() => 1)
    ()
  }
  let one = Sites { files: ["a.kai"], spells: [Fire, Ice] }
  Stdout.print(json_encode(to_json(one)))
  let both = [one, Sites { files: [], spells: [Ice] }] | ((s) => to_json(s)) | ((j) => json_encode(j))
  Stdout.print(string_join(both, ";"))
}
