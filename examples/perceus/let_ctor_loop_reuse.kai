# A `let` over a constructor pattern in a hot loop; the scrutinee may be shared
# (read again after the `let`) or sole-owned (its cell is taken apart).

type Pair = Pair(Int, Int)
type Named = Named(String, Int, String)

fn step(p: Pair, q: Pair) : Pair = {
  let Pair(a, b) = p
  let Pair(c, d) = q
  Pair(b + c, a + d - c)
}

fn run(n: Int, p: Pair, q: Pair) : Pair =
  if n == 0 { p } else { run(n - 1, step(p, q), q) }

fn shared_reuse(p: Pair) : Int = {
  let Pair(a, b) = p
  let Pair(c, d) = p
  a + b + c + d
}

fn shared_ptr(n: Named) : String = {
  let Named(s, k, _) = n
  let Named(_, _, t) = n
  "#{s}#{k}#{t}"
}

fn owned_ptr(i: Int) : String = {
  let Named(s, k, t) = Named("x#{i}", i, "y#{i}")
  "#{t}#{k}#{s}"
}

fn loop_ptr(i: Int, acc: Int) : Int =
  if i == 0 { acc } else {
    let Named(s, k, _) = Named("ab", i, "cd")
    loop_ptr(i - 1, acc + k + string_length(s))
  }

fn main() : Unit / Stdout = {
  let Pair(x, y) = run(1000, Pair(1, 2), Pair(3, 4))
  Stdout.print("#{x} #{y}")
  let p = Pair(5, 6)
  Stdout.print("#{shared_reuse(p)} #{p == Pair(5, 6)}")
  let n = Named("s", 7, "t")
  Stdout.print(shared_ptr(n))
  Stdout.print(owned_ptr(3))
  Stdout.print("#{loop_ptr(100, 0)}")
  let Pair(u, v) = p
  Stdout.print("#{u} #{v}")
}
