# A borrowed traversal binds its children as interior pointers and hands them
# to borrowed recursive calls: the dup and drop of each child cancel, so the
# walk moves no reference count.

type T = N(T, Int, T) | L

fn mk(n: Int) : T = if n <= 0 { L } else { N(mk(n - 1), n, mk(n - 2)) }

fn size(t: T) : Int = match t {
  N(l, _, r) -> size(l) + 1 + size(r)
  L -> 0
}

fn depth(t: T) : Int = match t {
  N(l, _, r) -> 1 + max(depth(l), depth(r))
  L -> 0
}

fn main() : Unit / Stdout {
  let t = mk(18)
  let a = size(t)
  let b = depth(t)
  Stdout.print("size: #{a} depth: #{b} again: #{size(t)}")
}
