import stream

fn words[e]() : stream.Stream[String, e] = stream.from_list(["alpha", "beta", "gamma", "delta"])

fn pair[e](w: String) : stream.Stream[String, e] = stream.from_list([w, "#{w}!"])

fn head_two() : [String] =
  words() |> stream.map((w) => "<#{w}>") |> stream.take(2) |> stream.to_list

fn inner_stop() : [String] =
  words() |> stream.flat_map(pair) |> stream.take(3) |> stream.to_list

fn first_long() : Int =
  words() |> stream.filter((w) => length(w) > 4) |> stream.take(1) |> stream.count

fn file_head(path: String) : [String] / File + stream.ReadFault =
  stream.read_lines(path) |> stream.take(1) |> stream.to_list

fn main() : Unit / Stdout + File = {
  Stdout.print("#{head_two()}")
  Stdout.print("#{inner_stop()}")
  Stdout.print("#{first_long()}")
  let path = "/tmp/kai_stream_early_stop_releases.txt"
  File.write_file(path, "one\ntwo\nthree\n")
  let got = handle { file_head(path) } with stream.ReadFault {
    bad_chunk(msg, resume) -> resume(())
    open_fault(msg, _resume) -> ["open failed"]
  }
  Stdout.print("#{got}")
}
