# A trap leaves a fiber through every frame between it and the fiber pad.
# Each worker holds owned values across pure calls when one of them traps
# (an index out of range, a division by zero, a panic); a supervisor that
# traps exits keeps spawning workers, so whatever a trapped frame keeps
# accumulates once per worker.

import actor
import spawn

fn pick(xs: [Int], i: Int) : Int = {
  let a = array_make(list_length(xs), 0)
  a[i]
}

fn ratio(xs: [Int], d: Int) : Int = list_length(xs) / d

fn insist(xs: [Int]) : Int = if list_length(xs) > 2 { panic("worker gave up") } else { 0 }

fn fault(xs: [Int], k: Int) : Int = match k % 3 {
  0 -> pick(xs, k + 10)
  1 -> ratio(xs, 0)
  _ -> insist(xs)
}

fn work(k: Int) : Int = {
  let xs = [k, k + 1, k + 2]
  let label = "worker " ++ int_to_string(k)
  let n = fault(xs, k)
  n + list_length(xs) + string_length(label)
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = work(k)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 30)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
