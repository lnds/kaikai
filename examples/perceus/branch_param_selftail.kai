# A self-tail-recursive function reads an owned param on one branch of an
# `if` only. The branch that skips the read must release the param before
# its goto, or every iteration keeps the previous value alive.

type Shape = TInt | TShape(Int, Shape) | TList(Shape)

fn depth(s: Shape) : Int = match s {
  TInt         -> 0
  TShape(_, r) -> 1 + depth(r)
  TList(r)     -> 1 + depth(r)
}

fn tag(s: Shape) : Int = match s {
  TShape(i, _) -> i
  _            -> 0 - 1
}

fn nest(i: Int, t: Shape) : Shape = if i == 0 { t } else { nest(i - 1, TShape(i, TInt)) }

fn nest_list(i: Int, t: Shape) : Shape = if i == 0 { t } else { nest_list(i - 1, TList(TShape(i, TInt))) }

fn nest_two(i: Int, t: Shape, u: Shape) : Shape =
  if i == 0 { TShape(depth(t), u) } else { nest_two(i - 1, u, TShape(i, TInt)) }

fn main() : Unit / Stdout = {
  let a = nest(20, TInt)
  let b = nest_list(20, TInt)
  let c = nest_two(20, TInt, TInt)
  Stdout.print("#{depth(a)} #{tag(a)} #{depth(b)} #{depth(c)} #{tag(c)}")
}
