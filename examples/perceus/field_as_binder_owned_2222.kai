# An as-pattern under a tuple field binds both the whole list and its cells.

fn as_len(xs: [Int], k: Int) : Int = match (xs, k) {
  (all @ [_, ...rest], 0) -> length(all) + length(rest)
  (_, _)                  -> 0
}

fn main() : Unit / Stdout = {
  let big = [1, 2, 3, 4, 5]
  Stdout.print("as=#{as_len(big, 0)} #{as_len(big, 1)} len=#{length(big)}")
}
