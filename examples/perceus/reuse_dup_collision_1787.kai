# Two sibling arms bind the SAME name, so the fn-wide use table marks
# every rebuild read non-last and dups it. The reuse paths consume one
# incoming reference per slot and run no arm-exit payer, so the sentinel
# must hand the extraction reference to the slot (unwrap the last dup)
# or every reuse leaks one cell per dup'd binder.
type P = Pv([Int]) | Pw([Int])
type T = C(P, [Int]) | W([Int], [Int])

fn crush(t: T) : T = match t {
  C(Pv(_), ys) -> W(ys, [9])
  C(Pw(_), ys) -> W([8], ys)
  W(a, b)      -> C(Pv(a), b)
}

fn spin(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    match crush(C(Pv([1, 2]), [3])) {
      W(_, _) -> spin(n - 1, acc + 1)
      C(_, _) -> spin(n - 1, acc)
    }
  }

fn main() : Unit / Stdout = {
  Stdout.print("s=#{spin(2000, 0)}")
}
