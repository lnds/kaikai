# A `var` captured by a closure lowers to the `Ref` cell, so a write from its
# own read is in place. The gate reads the `vec_inplace` / `vec_cow` counters.

import collections.vec

fn each_of[a, e](xs: [a], f: (a) -> Unit / e) : Unit / e = match xs {
  [] -> ()
  [h, ...t] -> {
    f(h)
    each_of(t, f)
  }
}

fn range(i: Int, n: Int) : [Int] = if i == n { [] } else { [i, ...range(i + 1, n)] }

fn sum(v: Vec[Int], i: Int, acc: Int) : Int =
  if i == vec.length(v) { acc } else { sum(v, i + 1, acc + vec.get(v, i)) }

fn fill(n: Int) : Vec[Int] {
  var v := vec.make(n, 0)
  each_of(range(0, n), i => {
    v := vec.set(v, i, i)
  })
  v
}

fn push_all(n: Int) : Vec[Int] {
  var v := vec.empty()
  each_of(range(0, n), i => {
    v := vec.push(v, i * 2)
  })
  v
}

fn main() {
  println(int_to_string(sum(fill(100), 0, 0)))
  println(int_to_string(sum(push_all(100), 0, 0)))
}
