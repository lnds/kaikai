# A `return(x)` binder owns the handled result: it is released whether the
# clause reads it raw, reads it twice, never reads it, or hands it on.

effect Res {
  acquire() : Int
}

fn big(i: Int) : Int = 4611686018427387904 + i

fn raw_read(i: Int) : Int = handle {
  Res.acquire()
} with Res {
  acquire(resume) -> resume(big(i))
  return(x)       -> if x > 0 { 1 } else { 0 }
}

fn raw_read_in_lambda(i: Int) : Int = {
  let run = (u: Int) => handle {
    Res.acquire()
  } with Res {
    acquire(resume) -> resume(big(i))
    return(x)       -> if x > 0 { u + 1 } else { u }
  }
  run(i)
}

fn unread(i: Int) : Int = handle {
  Res.acquire()
} with Res {
  acquire(resume) -> resume(big(i))
  return(_x)      -> 7
}

fn read_twice(i: Int) : [Int] = handle {
  [Res.acquire()]
} with Res {
  acquire(resume) -> resume(big(i))
  return(xs)      -> [list_length(xs), ...xs]
}

fn handed_on(i: Int) : [Int] = handle {
  [Res.acquire()]
} with Res {
  acquire(resume) -> resume(big(i))
  return(xs)      -> xs
}

fn sum(i: Int, acc: Int) : Int =
  if i == 0 { acc }
  else {
    let a = raw_read(i) + raw_read_in_lambda(i) - i + unread(i)
    let b = list_length(read_twice(i)) + list_length(handed_on(i))
    sum(i - 1, acc + a + b)
  }

fn main() : Unit / Stdout = Stdout.print("#{sum(100, 0)}")
