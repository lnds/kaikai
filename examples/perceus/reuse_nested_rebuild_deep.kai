# A variant reuse arm whose pattern deconstructs inner cells three levels
# deep, in two slots, over raw and boxed fields. Each deconstructed cell is
# settled once: unique, its children move and its shell is freed; shared,
# the children the rebuild takes gain a reference. A child the rebuild does
# not take is released. Each arm runs on a fresh donor (in-place rewrite)
# and on one that is still live (fresh alloc).

type Leaf = Leaf(String, Int, Real)
type Mid = Mid(Leaf, Int, [Int])
type Top = Top(String, Option[Mid], Int, Option[String]) | Empty

fn step(t: Top) : Top = match t {
  Top(name, Some(Mid(Leaf(tag, n, w), depth, xs)), k, Some(note)) ->
    Top(name, Some(Mid(Leaf(tag, n + 1, w * 2.0), depth, [0, ...xs])), k + 1, Some(note))
  Top(name, Some(Mid(Leaf(_, n, _), _, _unused)), k, _) -> Top(name, None, k + n, None)
  _ -> Empty
}

fn mk(note: Option[String]) : Top =
  Top(string_concat("top", "-a"), Some(Mid(Leaf(string_concat("leaf", "-b"), 1, 1.5), 3, [9])), 0, note)

fn run(t: Top, i: Int) : Top = if i == 0 { t } else { run(step(t), i - 1) }

fn show(^t: Top) : String = match t {
  Top(name, Some(Mid(Leaf(tag, n, w), depth, xs)), k, note) -> {
    let nt = match note { Some(s) -> s None -> "-" }
    "#{name} #{tag} n=#{n} big=#{w > 10.0} d=#{depth} len=#{list_length(xs)} k=#{k} #{nt}"
  }
  Top(name, None, k, _) -> "#{name} cleared k=#{k}"
  Empty -> "empty"
}

fn main() : Unit / Stdout = {
  Stdout.print(show(run(mk(Some(string_concat("no", "te"))), 4)))
  Stdout.print(show(step(mk(None))))
  let live = mk(Some(string_concat("li", "ve")))
  let stepped = step(live)
  Stdout.print(show(stepped))
  Stdout.print(show(live))
  let held = mk(None)
  let cleared = step(held)
  Stdout.print(show(cleared))
  Stdout.print(show(held))
}
