# A sequence that leaves a `region` is copied at the border, cell by
# cell: a step computed inside sits in the arena, and the copy holds
# none of it.

import seq

fn main() : Unit / Stdout = {
  let s = region {
    let inner = defer(() => SeqCons(1, defer(() => SeqCons(2, defer(() => SeqEnd)))))
    let first = nth(inner, 0)
    drop(inner, first - 1)
  }
  Stdout.print("#{to_list(s)}")
}
