# Sugar that reads one local twice at one source position: the range step
# test and its two arms, a `!` in an interpolation, a fixed-vec match.

fn stride(lo: Int, hi: Int, by: Int) : Int = [lo, (lo + by)..hi] |> sum()

fn parse(s: String) : Result[String, String] = Ok(s ++ "!")

fn shaped(a: String, b: String) : Result[String, String] = Ok(a ++ "#{parse(a)!}" ++ b)

fn spread(r: Vec[Real]<3>) : Real = match r {
  [a, b, c] -> a + b + c
}

fn main() : Unit / Stdout {
  Stdout.print("#{stride(1, 10, 3)} #{stride(10, 0, -4)}")
  Stdout.print("#{shaped("x#{stride(1, 2, 1)}", "y")}")
  Stdout.print("#{spread([1.5, 2.5, 3.5])}")
}
