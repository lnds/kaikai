# A block `let` whose name is never read is released by the emitter's
# inline decref, not by a perceus exit drop — but that inline decref only
# fires when the rhs is a fresh allocation. An alias rhs (`let ys = xs`)
# is not fresh, so neither side pays and the aliased structure leaks.
# `read_alias` and `fresh_alias` are the legitimate cases: read, or
# freshly allocated.

fn mk() : [Int] = [1, 2, 3]

fn first(xs: [Int]) : Int =
  match xs {
    []        -> 0
    [h, ..._] -> h
  }

# The shape: `xs` is aliased and then NEITHER name is read. The alias
# suppresses the payer that would have released `xs`, and the alias
# itself takes no incref, so the list is never freed.
fn unused_alias() : Int = {
  let xs = mk()
  let ys = xs
  7
}

# Same binding, read once: the read transfers the ref.
fn read_alias() : Int = {
  let xs = mk()
  let ys = xs
  first(ys)
}

# Same binding, unread, but the rhs allocates: the inline decref pays it.
fn fresh_alias() : Int = {
  let xs = mk()
  let ys = mk()
  7
}

fn main() : Unit / Stdout =
  Stdout.print("#{unused_alias()} #{read_alias()} #{fresh_alias()}")
