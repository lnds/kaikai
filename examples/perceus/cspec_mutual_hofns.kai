# Two higher-order fns that each pass a fresh closed lambda to the other:
# specialisation follows the chain once per origin and keeps every spec.

fn ping(f: (Int) -> Int, n: Int) : Int =
  if n <= 0 { f(0) } else { f(n) + pong((x) => x * 2, n - 1) }

fn pong(g: (Int) -> Int, n: Int) : Int =
  if n <= 0 { g(1) } else { g(n) + ping((x) => x + 3, n - 1) }

fn main() : Unit / Stdout = {
  let a = ping((x) => x + 1, 5)
  let b = pong((x) => x - 1, 4)
  Stdout.print("#{a} #{b}")
}
