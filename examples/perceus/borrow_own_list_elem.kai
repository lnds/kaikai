# A `^` param stored as a list element is owned by the list, so the read
# takes a dup. The caller keeps its list and reads it after every call, so
# a missing dup frees cells it still reads.

fn wrap(^xs: [Int]) : [[Int]] = [xs]

fn sum(l: [Int]) : Int = match l {
  []        -> 0
  [x, ...r] -> x + sum(r)
}

fn sums(ls: [[Int]]) : Int = match ls {
  []        -> 0
  [l, ...r] -> sum(l) + sums(r)
}

fn go(i: Int, n: Int, base: [Int], acc: Int) : Int =
  if i >= n { acc } else { go(i + 1, n, base, acc + sums(wrap(base))) }

fn main() : Unit / Stdout = {
  let base = [1, 2, 3]
  let total = go(0, 100, base, 0)
  Stdout.print("total=#{total} len=#{list_length(base)} sum=#{sum(base)}")
}
