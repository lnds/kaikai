# Writes to a `Ref` that must keep the copy because something evaluated
# after the read can observe the cell. The outputs show the old value was
# still there.

import collections.vec

fn pair_len(v: Vec[Int], n: Int, i: Int, x: Int) : Vec[Int] = vec.set(v, i, n + x)

# An alias of the same cell is read after `@r`.
fn alias(r: Ref[Vec[Int]], q: Ref[Vec[Int]]) : Unit / Mutable {
  r := pair_len(@r, vec.length(@q), 0, vec.get(@q, 1))
}

# A closure that reads the cell is passed to the callee.
fn through_closure[e](r: Ref[Vec[Int]], f: (Int) -> Int / e) : Unit / Mutable + e {
  r := vec.set(@r, 0, f(1))
}

# An effect op runs after the read in the argument list.
fn after_op(r: Ref[Vec[Int]], q: Ref[Int]) : Unit / Mutable {
  r := pair_len(@r, 0, 0, @q)
}

# A second read of the cell sits in the argument list.
fn second_read(r: Ref[Vec[Int]], i: Int) : Unit / Mutable {
  r := vec.set(@r, i, vec.get(@r, i) + i)
}

fn main() {
  let u = &vec.make(3, 1)
  second_read(u, 2)
  println(int_to_string(vec.get(@u, 2)))

  let r = &vec.make(3, 5)
  alias(r, r)
  println(int_to_string(vec.get(@r, 0)))

  let s = &vec.make(3, 5)
  through_closure(s, i => vec.length(@s) + i)
  println(int_to_string(vec.get(@s, 0)))

  let t = &vec.make(3, 5)
  let k = &7
  after_op(t, k)
  println(int_to_string(vec.get(@t, 0)))
}
