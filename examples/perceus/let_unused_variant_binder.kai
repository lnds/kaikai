# A destructuring `let` binder that is never read owns a reference like any
# other binder; a never-read one must not retain its slot per call.

type H = H(String, String)
type M = M(Int, Real)

fn left(p: H) : String = {
  let H(l, r) = p
  l
}

fn int_of(m: M) : Int = {
  let M(i, r) = m
  i
}

fn go(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    let s = left(H(string_concat("a", "b"), string_concat("c", "d")))
    go(n - 1, acc + s.length() + int_of(M(n, 1.5 * 2.0)))
  }

fn main() : Unit / Stdout = Stdout.print("#{go(100, 0)}")
