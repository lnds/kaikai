# A self tail call that passes a borrowed parameter on still releases,
# before the jump, a binder its arguments read twice. The bare read stays
# in its slot, lent again; a borrowed parameter handed to an owned slot
# takes a reference of its own.

type Box = { w: Int, path: String }

fn word(n: Int) : String = int_to_string(n % 7)

fn len(s: String) : Int = string_length(s)

fn mk(n: Int) : [String] = [word(n), word(n + 1)]

fn grow(n: Int, acc: [String]) : [String] = if n == 0 { acc } else { grow(n - 1, [word(n), ...acc]) }

fn list_if(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let p = word(n)
    list_if(xs, n - 1, acc + len(p) + len(p) + list_length(xs))
  }
}

fn list_arm(^xs: [String], n: Int, acc: Int) : Int = match n {
  0 -> acc
  _ -> {
    let p = word(n)
    list_arm(xs, n - 1, acc + len(p) + len(p) + list_length(xs))
  }
}

fn ping(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let p = word(n)
    pong(xs, n - 1, acc + len(p) + len(p) + list_length(xs))
  }
}

fn pong(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let p = word(n)
    ping(xs, n - 1, acc + len(p) + len(p) + list_length(xs))
  }
}

fn str_on(^s: String, n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let p = word(n)
    str_on(s, n - 1, acc + len(p) + len(p) + len(s))
  }
}

fn rec_on(^b: Box, n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let p = word(n)
    rec_on(b, n - 1, acc + len(p) + len(p) + b.w)
  }
}

fn clo_on(^g: (Int) -> Int, n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let p = word(n)
    clo_on(g, n - 1, acc + len(p) + len(p) + g(n))
  }
}

fn swap_on(^xs: [String], ^ys: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let p = word(n)
    swap_on(ys, xs, n - 1, acc + len(p) + len(p) + list_length(xs))
  }
}

fn opt(n: Int) : Option[String] = if n % 3 == 0 { None } else { Some(word(n)) }

fn arm_on(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    match opt(n) {
      Some(p) -> arm_on(xs, n - 1, acc + len(p) + len(p) + list_length(xs))
      None    -> arm_on(xs, n - 1, acc + 1)
    }
  }
}

fn walk(^xs: [String], n: Int, acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> {
    let p = word(n)
    walk(t, n + 1, acc + len(p) + len(p) + len(h))
  }
}

fn into_owned(^xs: [String], ys: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc + list_length(ys) } else {
    let p = word(n)
    let zs = [p, ...ys]
    into_owned(xs, xs, n - 1, acc + len(p) + len(p) + list_length(zs))
  }
}

fn main() {
  let xs = mk(1)
  let ys = grow(200, [])
  let k = string_length(word(4))
  print(int_to_string(list_if(xs, 200, 0)))
  print(int_to_string(list_arm(xs, 200, 0)))
  print(int_to_string(ping(xs, 200, 0)))
  print(int_to_string(str_on(word(3), 200, 0)))
  print(int_to_string(rec_on(Box { w: 2, path: word(3) }, 200, 0)))
  print(int_to_string(clo_on((x: Int) => x + k, 200, 0)))
  print(int_to_string(swap_on(xs, ys, 200, 0)))
  print(int_to_string(arm_on(xs, 200, 0)))
  print(int_to_string(walk(ys, 0, 0)))
  print(int_to_string(into_owned(xs, mk(2), 200, 0)))
  print(int_to_string(list_length(xs) + list_length(ys)))
}
