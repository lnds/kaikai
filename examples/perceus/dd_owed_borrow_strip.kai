# An arm binder a self-tail-call's arguments read only through a borrowing
# index (`a[i]`) owes its drop at the goto: the borrow strip turns those
# dup'd reads into bare ones, which the goto's release ledger would take for
# a move. Covered on a direct goto leaf, under a nested match, and on a
# leaf whose arguments a let-binding's exit drop already hoisted.

type T = Leaf | Node(Array[Int], T)

fn ap(f: () -> Int) : Int = f()

fn direct(t: T, acc: Int) : Int = match t {
  Leaf -> acc
  Node(a, rest) -> direct(rest, acc + a[0] + a[1])
}

fn nested(t: T, acc: Int) : Int = match t {
  Leaf -> acc
  Node(a, rest) -> match rest {
    Leaf -> acc + a[0]
    Node(c, _) -> nested(rest, acc + a[0] + c[1])
  }
}

fn hoisted(t: T, acc: Int) : T = match t {
  Leaf -> if acc > 0 { t } else { Leaf }
  Node(a, rest) -> {
    let b = array.from([acc, 1])
    hoisted(rest, acc + a[0] + a[1] + ap(() => b[1]))
  }
}

fn mk(i: Int, acc: T) : T = if i == 0 { acc } else { mk(i - 1, Node(array.from([i, i + 1]), acc)) }

fn count(t: T) : Int = match t {
  Leaf -> 1
  Node(_, r) -> 1 + count(r)
}

fn main() : Unit / Console {
  let t = mk(50, Leaf)
  println(int_to_string(direct(t, 0)))
  println(int_to_string(nested(t, 0)))
  println(int_to_string(count(hoisted(t, 1))))
}
