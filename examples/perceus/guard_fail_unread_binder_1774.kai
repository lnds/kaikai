# The guard reads only an outer variable, so NO binder of the guarded
# arm is paid by the guard's evaluation: on guard-fail both `y` and the
# implicit rest binder would leak without the guard-fail drops. `y` is
# read in the body, but the body never runs — payment cannot be left to
# it.
type Pair = { a: Int, b: String }

fn walk(xs: [Pair], k: Int, acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> match t {
    [y, ..._] if k < 0 -> walk(t, k, acc + y.a)
    _                  -> walk(t, k, acc + h.a)
  }
}

fn build(n: Int, acc: [Pair]) : [Pair] =
  if n == 0 { acc } else { build(n - 1, [Pair { a: n, b: "p_#{n}" }, ...acc]) }

fn main() : Unit / Stdout = {
  let total = walk(build(3000, []), 5, 0)
  Stdout.print("total=#{total}")
}
