# A reuse arm donates the matched cell and overwrites its slots. A slot the
# rebuild does not take (a wildcard, an unused binder, a deconstructed head)
# has no owner once overwritten: the unique branch releases it and the shared
# branch does not incref it. Each shape runs on a fresh scrutinee (unique,
# in-place rewrite) and on a still-live one (shared, fresh alloc).

type Pair = Pair([Int], [Int])

fn cells(n: Int) : [[Int]] = if n == 0 { [] } else { [[n, n], ...cells(n - 1)] }

fn opts(n: Int) : [Option[[Int]]] = if n == 0 { [] } else { [Some([n, n]), ...opts(n - 1)] }

fn wild_head(xs: [[Int]]) : [[Int]] = match xs {
  [] -> []
  [_, ...t] -> [[7], ...t]
}

fn under_head(xs: [[Int]]) : [[Int]] = match xs {
  [] -> []
  [_h, ...t] -> [[7], ...t]
}

fn unused_head(xs: [[Int]]) : [[Int]] = match xs {
  [] -> []
  [h, ...t] -> [[7], ...t]
}

fn under_rest(xs: [[Int]]) : [[Int]] = match xs {
  [] -> []
  [h, ..._t] -> [h, ...cells(1)]
}

fn read_rest(xs: [[Int]]) : [[Int]] = match xs {
  [] -> []
  [h, ..._t] -> [[7], ..._t]
}

fn nested_head(xs: [Option[[Int]]]) : [Option[[Int]]] = match xs {
  [] -> []
  [Some(x), ...t] -> [Some([7, ...x]), ...t]
  [None, ...t] -> [None, ...t]
}

fn wild_slot(p: Pair) : Pair = match p {
  Pair(_, b) -> Pair([7], b)
}

fn under_slot(p: Pair) : Pair = match p {
  Pair(_a, b) -> Pair([7], b)
}

fn unused_slot(p: Pair) : Pair = match p {
  Pair(a, b) -> Pair([7], b)
}

fn total(^xs: [[Int]], acc: Int) : Int = match xs {
  [] -> acc
  [h, ...t] -> total(t, acc + list_length(h))
}

fn total_opts(^xs: [Option[[Int]]], acc: Int) : Int = match xs {
  [] -> acc
  [Some(x), ...t] -> total_opts(t, acc + list_length(x))
  [None, ...t] -> total_opts(t, acc)
}

fn size(^p: Pair) : Int = match p { Pair(a, b) -> list_length(a) + list_length(b) }

fn lists_round(n: Int) : Int = {
  let base = cells(3)
  let fresh = total(wild_head(cells(3)), 0) + total(under_head(cells(3)), 0) +
              total(unused_head(cells(3)), 0) + total(under_rest(cells(3)), 0) +
              total(read_rest(cells(3)), 0)
  let shared = total(wild_head(base), 0) + total(under_head(base), 0) +
               total(unused_head(base), 0) + total(under_rest(base), 0) +
               total(read_rest(base), 0)
  fresh + shared + total(base, 0) + n
}

fn opts_round() : Int = {
  let base = opts(3)
  total_opts(nested_head(opts(3)), 0) + total_opts(nested_head(base), 0) + total_opts(base, 0)
}

fn pairs_round(n: Int) : Int = {
  let base = Pair([n, n], [n])
  let fresh = size(wild_slot(Pair([n, n], [n]))) + size(under_slot(Pair([n, n], [n]))) +
              size(unused_slot(Pair([n, n], [n])))
  let shared = size(wild_slot(base)) + size(under_slot(base)) + size(unused_slot(base))
  fresh + shared + size(base)
}

fn loop_it(n: Int, acc: Int) : Int =
  if n == 0 { acc } else { loop_it(n - 1, acc + lists_round(0) + opts_round() + pairs_round(n)) }

fn main() : Unit / Stdout =
  Stdout.print("total=#{loop_it(500, 0)}")
