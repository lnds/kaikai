# Under `let name @ pat`, the as-name and each inner binder hold their own
# reference, whichever of them the block reads.

type H = H(String, String)

fn inner_read(p: H) : String = {
  let w @ H(a, _) = p
  a
}

fn both_read(p: H) : String = {
  let w @ H(a, _) = p
  let s = string_concat(a, "-")
  match w { H(_, b) -> string_concat(s, b) }
}

fn whole_read(p: H) : String = {
  let w @ H(a, b) = p
  match w { H(x, _) -> x }
}

fn fresh(n: Int) : H = H(string_concat("a", "#{n}"), string_concat("b", "#{n}"))

fn go(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    go(n - 1, acc + inner_read(fresh(n)).length() + both_read(fresh(n)).length() + whole_read(fresh(n)).length())
  }

fn main() : Unit / Stdout = {
  Stdout.print("#{inner_read(fresh(1))} #{both_read(fresh(2))} #{whole_read(fresh(3))}")
  Stdout.print("#{go(50, 0)}")
}
