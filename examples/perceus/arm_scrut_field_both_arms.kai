# An arm binder projected in a `match` scrutinee, in a guard and in a nested
# condition, then handed to a call in every alternative.
type Delim = { count: Int, closes: Bool, opens: Bool }

type Tok = TI(Int) | TD(Delim)

type Em = { frames: [Delim], base: [Int] }

fn take(em: Em, d: Delim) : Em =
  if d.count == 0 { em } else { Em { frames: [d, ...em.frames], base: em.base } }

fn run(toks: [Tok], em: Em) : Em = match toks {
  []            -> em
  [TI(x), ...t] -> run(t, Em { frames: em.frames, base: [x, ...em.base] })
  [TD(d), ...t] -> run(t, match d.closes {
    true  -> take(em, d)
    false -> take(em, d)
  })
}

fn run_guard(toks: [Tok], em: Em) : Em = match toks {
  []            -> em
  [TI(x), ...t] -> run_guard(t, Em { frames: em.frames, base: [x, ...em.base] })
  [TD(d), ...t] -> run_guard(t, match em.base {
    [] -> take(em, d)
    _ if d.closes -> take(em, d)
    _ -> take(em, d)
  })
}

fn run_nested(toks: [Tok], em: Em) : Em = match toks {
  []            -> em
  [TI(x), ...t] -> run_nested(t, Em { frames: em.frames, base: [x, ...em.base] })
  [TD(d), ...t] -> run_nested(t, if d.closes { if d.opens { take(em, d) } else { take(em, d) } } else { take(em, d) })
}

fn build(n: Int, acc: [Tok]) : [Tok] =
  if n == 0 { acc }
  else { build(n - 1, [TD(Delim { count: 1, closes: n > 1000, opens: n > 500 }), TI(n), ...acc]) }

fn main() : Unit / Stdout = {
  let a = run(build(2000, []), Em { frames: [], base: [] })
  let b = run_guard(build(2000, []), Em { frames: [], base: [] })
  let c = run_nested(build(2000, []), Em { frames: [], base: [] })
  Stdout.print("#{list.length(a.frames)} #{list.length(b.frames)} #{list.length(c.frames)}")
}
