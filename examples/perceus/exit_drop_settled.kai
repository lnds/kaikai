# One match whose arms settle the scrutinee differently: an arm that frees
# the cell up front, an arm that rebuilds it in place, and an arm that keeps
# it, each run on a unique and on a shared tree.

type Tree = Node(Tree, Int, Tree) | Tip

fn shape(t: Tree) : Tree = match t {
  Node(Tip, k, Tip) -> Node(Tip, k + 1, Tip)
  Node(l, k, r) -> if k % 3 == 0 { Node(shape(r), k, shape(l)) } else { Node(shape(l), k * 2, r) }
  Tip -> Tip
}

fn keys(t: Tree) : Int = match t {
  Node(_, k, Tip) -> k
  Node(l, k, r) -> keys(l) + k + keys(r)
  Tip -> 0
}

fn build(n: Int) : Tree = if n <= 0 { Tip } else { Node(build(n - 1), n, build(n / 2)) }

fn main() : Unit / Stdout {
  Stdout.print("unique: #{keys(shape(shape(build(12))))}")
  let t = build(10)
  let s = shape(t)
  Stdout.print("shared: #{keys(t)} #{keys(s)}")
}
