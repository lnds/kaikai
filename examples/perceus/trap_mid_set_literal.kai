# A set literal with a spread inserts its elements one after another at
# the literal's position. Each insert is its own unwind site: an element
# whose comparison traps unwinds through the pad of that insert, which
# releases the sets pending across it and the literal's values in flight.
# C has no pads: the growth baseline pins what each trapped worker keeps there.

import actor
import spawn
import collections.set

type Key = Calm(Int) | Wild

fn rank(x: Key) : Int = match x {
  Calm(n) -> n
  Wild -> panic("wild key")
}

impl Ord for Key {
  fn cmp(a: Key, b: Key) : Int = rank(a) - rank(b)
  fn min(a: Key, b: Key) : Key = if rank(a) <= rank(b) { a } else { b }
  fn max(a: Key, b: Key) : Key = if rank(a) >= rank(b) { a } else { b }
}

impl Eq for Key {
  fn eq(a: Key, b: Key) : Bool = match a {
    Calm(n) -> match b { Calm(m) -> n == m  Wild -> false }
    Wild -> match b { Wild -> true  Calm(_) -> false }
  }
}

fn work(k: Int) : Int = {
  let base = %[ Calm(k), Calm(k + 1) ]
  let more = %[ ...base, Calm(k + 2), Wild ]
  set.size(more) + set.size(base)
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = work(k)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 30)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
