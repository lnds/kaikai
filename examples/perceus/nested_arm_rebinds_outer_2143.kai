# A nested match rebinds the name an enclosing arm already binds. Each
# binder must own its own slot: if they share one, the outer arm's exit
# drop releases the inner binder's value and the outer one leaks.

type Px = Px(String, Int) | NoPx

fn f(p: Px) : Int = match p {
  Px(s, k) -> if k > 0 { string_length(s) } else {
    match Px("q", 1) {
      Px(s, _) -> string_length(s)
      NoPx     -> 0
    }
  }
  NoPx -> 0
}

fn go(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else { go(i + 1, n, acc + f(Px(int_to_string(i * 7919), i % 3))) }

fn main() : Unit / Stdout = Stdout.print("r=#{go(0, 3000, 0)}")
