# A `pub` loop that hands its own `^` slot a value it owns releases that
# value, while its callers still lend the argument; a `pub` loop that only
# passes the parameter on is left as written.

pub type Box = { w: Int, path: String }

fn word(n: Int) : String = int_to_string(n % 7)

fn mk(n: Int) : [String] = [word(n), word(n + 1)]

fn mkopt(n: Int) : Option[[String]] = if n % 5 == 0 { None } else { Some(mk(n)) }

pub fn let_list(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let ys = [word(n), word(n + 1)]
    let_list(ys, n - 1, acc + list_length(xs))
  }
}

pub fn call_arm(^xs: [String], n: Int, acc: Int) : Int = match n {
  0 -> acc
  _ -> call_arm(mk(n), n - 1, acc + list_length(xs))
}

pub fn child_mixed(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    match mkopt(n) {
      Some(ys) -> child_mixed(ys, n - 1, acc + list_length(xs))
      None     -> child_mixed(xs, n - 1, acc + 1)
    }
  }
}

pub fn rec_lit(^b: Box, n: Int, acc: Int) : Int {
  if n == 0 { acc } else { rec_lit(Box { w: n, path: word(n) }, n - 1, acc + b.w) }
}

pub fn str_let(^s: String, n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let t = word(n)
    str_let(t, n - 1, acc + string_length(s))
  }
}

pub fn clo_let(^g: (Int) -> Int, n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let k = string_length(word(n))
    clo_let((x: Int) => x + k, n - 1, acc + g(n))
  }
}

pub fn piped(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else { mk(n) |> piped(n - 1, acc + list_length(xs)) }
}

pub fn generic[t](^xs: [t], fresh: (Int) -> [t], n: Int, acc: Int) : Int {
  if n == 0 { acc } else { generic(fresh(n), fresh, n - 1, acc + list_length(xs)) }
}

pub fn trmc(^xs: [String], n: Int) : [Int] {
  if n == 0 { [] } else { [list_length(xs), ...trmc(mk(n), n - 1)] }
}

pub fn ping(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else { pong(mk(n), n - 1, acc + list_length(xs)) }
}

pub fn pong(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else { ping(xs, n - 1, acc + list_length(xs)) }
}

pub fn pass_on(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else { pass_on(xs, n - 1, acc + list_length(xs)) }
}

fn main() {
  let xs = mk(1)
  print(int_to_string(let_list(xs, 200, 0)))
  print(int_to_string(call_arm(xs, 200, 0)))
  print(int_to_string(child_mixed(xs, 200, 0)))
  print(int_to_string(rec_lit(Box { w: 1, path: word(2) }, 200, 0)))
  print(int_to_string(str_let(word(3), 200, 0)))
  print(int_to_string(clo_let((x: Int) => x, 200, 0)))
  print(int_to_string(piped(xs, 200, 0)))
  print(int_to_string(generic(xs, (k: Int) => mk(k), 200, 0)))
  print(int_to_string(list_length(trmc(xs, 200))))
  print(int_to_string(ping(xs, 200, 0)))
  print(int_to_string(pass_on(xs, 200, 0)))
  print(int_to_string(list_length(xs)))
}
