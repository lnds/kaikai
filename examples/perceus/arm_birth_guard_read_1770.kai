# Same shape as arm_birth_cond_read_1770, with the borrowed-slot read
# moved into an inner match guard. The guard evaluates on the goto path
# of the outer arm's tail, so the outer binder's birth ref is equally
# orphaned there without the distributed leaf drop.
type Pair = { a: Int, b: String }

fn eats(p: Pair) : Bool = match p { Pair { a: x, b: _ } -> x > 2 }

fn walk(xs: [Pair], ks: [Int], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> {
    let w = h.a
    match ks {
      [y, ..._] if eats(h) -> walk(t, ks, acc + w + y)
      _                    -> walk(t, ks, acc + w)
    }
  }
}

fn build(n: Int, acc: [Pair]) : [Pair] =
  if n == 0 { acc } else { build(n - 1, [Pair { a: n, b: "p_#{n}" }, ...acc]) }

fn main() : Unit / Stdout = {
  let total = walk(build(3000, []), [10], 0)
  Stdout.print("total=#{total}")
}
