# A boxed scalar binder whose single read is a raw argument hands its
# reference to a slot that takes only the copied payload, so the caller must
# release it after the call. Chars at or above 128, Reals and the fixed-width
# integers are heap cells: a missed release retains one cell per iteration.

type Px = Px(Char, Char) | NoPx

type W = W(Real, Int) | Z

type N = N(Int32, UInt64, Char) | NoN

fn g(c: Char) : Int = char_to_int(c) + 1

fn gr(x: Real) : Real = x * 1.5

fn gi(a: Int32, b: UInt64) : Int = int32_to_int(a) + uint64_to_int(b)

fn arm_args(p: Px) : Int = match p {
  Px(r, s) -> g(r) + g(s)
  NoPx     -> 0
}

fn let_arg(o: Option[Real]) : Real = {
  let v = match o {
    Some(y) -> y
    None    -> 0.25
  }
  gr(v)
}

fn typed_slot(w: W) : Real = match w {
  W(x, k) -> gr(x) + int_to_real(k)
  Z       -> 0.0
}

fn fixed(n: N) : Int = match n {
  N(a, b, c) -> gi(a, b) + g(c)
  NoN        -> 0
}

fn raw_and_boxed(n: N) : Int = match n {
  N(a, b, c) -> g(c) + char_to_int(c) + gi(a, b)
  NoN        -> 0
}

fn count(c: Char, k: Int, acc: Int) : Int =
  if k <= 0 { acc } else { count(c, k - 1, acc + char_to_int(c) % 7) }

fn self_tail(n: N) : Int = match n {
  N(_, _, c) -> count(c, 3, 0)
  NoN        -> 0
}

fn mkn(i: Int) : N = N(int_to_int32(i % 5000), int_to_uint64(i * 3), int_to_char(300 + i % 700))

fn chars(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else {
    let p = Px(int_to_char(200 + i % 1000), int_to_char(300))
    chars(i + 1, n, acc + arm_args(p) + fixed(mkn(i)) + raw_and_boxed(mkn(i)) + self_tail(mkn(i)))
  }

fn reals(i: Int, n: Int, acc: Real) : Real =
  if i >= n { acc } else {
    reals(i + 1, n, acc + let_arg(Some(int_to_real(i))) + typed_slot(W(int_to_real(i), i % 3)))
  }

fn main() : Unit / Stdout = {
  Stdout.print("chars=#{chars(0, 50000, 0)}")
  Stdout.print("reals=#{real_to_int(reals(0, 50000, 0.0))}")
}
