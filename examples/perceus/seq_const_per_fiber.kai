# Each fiber evaluates a constant for itself and releases it when it
# ends: a sequence never crosses to another fiber, and nothing of it
# outlives the fiber that built it. The spawned fibers build theirs
# first, at once; the main fiber reads its own after them.

import seq
import spawn

const SQUARES : Seq[Int] = from(1) | (x) => x * x

fn pick(i: Int) : Int = nth(SQUARES, i) + nth(SQUARES, i)

fn main() : Unit / Stdout + Spawn = {
  let rs = nursery { n ->
    let fs = [3, 5, 7] | (k => n.spawn(() => pick(k)))
    fs | (f => n.await(f))
  }
  Stdout.print("#{rs} #{pick(9)}")
}
