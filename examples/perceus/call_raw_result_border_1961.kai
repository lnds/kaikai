# The raw↔boxed border at a raw-return call. A fn whose signature returns a
# raw scalar must not box its body's result for the `KRet` to unbox back off,
# and a `let` over such a call must bind the raw register perceus already
# skipped the RC of. Boxing either border mints one cell per evaluation that
# nothing owns and nothing frees.

fn scale_real(x: Real) : Real = x * 1.5

fn chain_real(x: Real) : Real {
  let a = x + 1.0
  let b = a * 2.0
  b - 0.5
}

fn scale_int(n: Int) : Int = n * 3

fn loop_arith(n: Int, acc: Real) : Real {
  if n > 0 { loop_arith(n - 1, scale_real(acc) * 0.5 + 1.0) } else { acc }
}

fn loop_let(n: Int, acc: Real) : Real {
  if n > 0 {
    let r = chain_real(acc)
    loop_let(n - 1, r * 0.25 + 1.0)
  } else { acc }
}

fn loop_int(n: Int, acc: Int) : Int {
  if n > 0 {
    let r = scale_int(n)
    loop_int(n - 1, acc + r % 7)
  } else { acc }
}

fn main() {
  print(real_to_string(loop_arith(1000, 1.0)))
  print(real_to_string(loop_let(1000, 1.0)))
  print(int_to_string(loop_int(1000, 1)))
}
