# A read of a vector that feeds its own write is a lend that ends before
# the write runs, so a uniquely owned vector is still written in place.
# Every loop threads its vector through 100 writes; the gate reads the
# `vec_inplace` / `vec_cow` counters under KAI_TRACE_RC and requires zero
# copies.

# The read sits in the write's own argument.
fn bump_inline(v: Vec[Int], i: Int, n: Int) : Vec[Int] =
  if i >= n { v } else { bump_inline(vec_set(v, i, vec_get(v, i) + 1), i + 1, n) }

# The read is bound first.
fn bump_let(v: Vec[Int], i: Int, n: Int) : Vec[Int] =
  if i >= n { v } else {
    let x = vec_get(v, i)
    bump_let(vec_set(v, i, x + 1), i + 1, n)
  }

# Several reads nested in one expression, the index included.
fn smooth(v: Vec[Int], i: Int, n: Int) : Vec[Int] =
  if i >= n { v }
  else { smooth(vec_set(v, i % vec_length(v), (vec_get(v, i) + vec_get(v, (i + 1) % n)) * 2 - vec_get(v, 0)), i + 1, n) }

# A boxed element: the read hands back its own reference to the element.
fn shout(v: Vec[String], i: Int, n: Int) : Vec[String] =
  if i >= n { v } else { shout(vec_set(v, i, vec_get(v, i) ++ "!"), i + 1, n) }

# The read decides the branch, and both branches hand the vector on.
fn clamp(v: Vec[Int], i: Int, n: Int) : Vec[Int] =
  if i >= n { v }
  else if vec_get(v, i) > 50 { clamp(vec_set(v, i, 50), i + 1, n) }
  else { clamp(vec_set(v, i, vec_get(v, i) * 2), i + 1, n) }

fn fill(v: Vec[Int], i: Int, n: Int) : Vec[Int] =
  if i >= n { v } else { fill(vec_set(v, i, i), i + 1, n) }

fn sum(v: Vec[Int], i: Int, acc: Int) : Int =
  if i >= vec_length(v) { acc } else { sum(v, i + 1, acc + vec_get(v, i)) }

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(sum(bump_inline(vec_make(100, 1), 0, 100), 0, 0)))
  Stdout.print(int_to_string(sum(bump_let(vec_make(100, 1), 0, 100), 0, 0)))
  Stdout.print(int_to_string(sum(smooth(vec_make(100, 1), 0, 100), 0, 0)))
  Stdout.print(vec_get(shout(vec_make(100, "a"), 0, 100), 99))
  Stdout.print(int_to_string(sum(clamp(fill(vec_make(100, 0), 0, 100), 0, 100), 0, 0)))
}
