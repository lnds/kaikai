# A core builtin passed by value is materialised as a fresh closure, like a
# top-level fn name. In a borrowed slot nothing consumes it, so the caller
# releases it after the call; each round here would otherwise keep one
# closure per builtin argument.

fn round(i: Int) : Int = {
  let rows = [["a", int_to_string(i)], ["b"]]
  let flipped = map(rows, list_reverse)
  let texts = map([i, i + 1], int_to_string)
  let flat = flat_map(rows, list_reverse)
  let longest = match max_by(texts, string_length) {
    Some(s) -> string_length(s)
    None    -> 0
  }
  list_length(flipped) + list_length(texts) + list_length(flat) + longest
}

fn go(i: Int, acc: Int) : Int = if i == 0 { acc } else { go(i - 1, acc + round(i)) }

fn main() : Unit / Stdout = Stdout.print("#{go(200, 0)}")
