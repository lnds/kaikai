# A loop that hands a borrowed slot a value it owns releases that value:
# such a slot is owned, inferred or written `^`, while a slot that only
# ever receives what the caller keeps alive stays borrowed.

type Box = { w: Int, path: String }

type T = Leaf | Node(T, String, T)

fn word(n: Int) : String = int_to_string(n % 7)

fn mk(n: Int) : [String] = [word(n), word(n + 1)]

fn mkopt(n: Int) : Option[[String]] = if n % 5 == 0 { None } else { Some(mk(n)) }

fn build(d: Int) : T = if d == 0 { Leaf } else { Node(build(d - 1), word(d), build(d - 1)) }

fn let_list(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let ys = [word(n), word(n + 1)]
    let_list(ys, n - 1, acc + list_length(xs))
  }
}

fn call_arm(^xs: [String], n: Int, acc: Int) : Int = match n {
  0 -> acc
  _ -> call_arm(mk(n), n - 1, acc + list_length(xs))
}

fn child_mixed(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    match mkopt(n) {
      Some(ys) -> child_mixed(ys, n - 1, acc + list_length(xs))
      None     -> child_mixed(xs, n - 1, acc + 1)
    }
  }
}

fn rec_lit(^b: Box, n: Int, acc: Int) : Int {
  if n == 0 { acc } else { rec_lit(Box { w: n, path: word(n) }, n - 1, acc + b.w) }
}

fn str_let(^s: String, n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let t = word(n)
    str_let(t, n - 1, acc + string_length(s))
  }
}

fn clo_let(^g: (Int) -> Int, n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let k = string_length(word(n))
    clo_let((x: Int) => x + k, n - 1, acc + g(n))
  }
}

fn inferred(xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let k = match xs { [] -> 0  _ -> 1 }
    if n % 3 == 0 { inferred(mk(n), n - 1, acc + k) } else { inferred(xs, n - 1, acc + k) }
  }
}

fn ping(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else { pong(mk(n), n - 1, acc + list_length(xs)) }
}

fn pong(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else { ping(xs, n - 1, acc + list_length(xs)) }
}

fn ca(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else { cb(mk(n), n - 1, acc + list_length(xs)) }
}

fn cb(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else { cc(xs, n - 1, acc + list_length(xs)) }
}

fn cc(^xs: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc } else { ca(mk(n), n - 1, acc + list_length(xs)) }
}

fn trmc(^xs: [String], n: Int) : [Int] {
  if n == 0 { [] } else { [list_length(xs), ...trmc(mk(n), n - 1)] }
}

fn swap_owned(^xs: [String], ys: [String], n: Int, acc: Int) : Int {
  if n == 0 { acc + list_length(ys) } else { swap_owned(ys, mk(n), n - 1, acc + list_length(xs)) }
}

fn descent(t: T, n: Int, acc: Int) : Int = match t {
  Leaf          -> acc
  Node(l, _, _) -> descent(l, n + 1, acc + n)
}

fn main() {
  let t = build(8)
  print(int_to_string(let_list(mk(1), 200, 0)))
  print(int_to_string(call_arm(mk(1), 200, 0)))
  print(int_to_string(child_mixed(mk(1), 200, 0)))
  print(int_to_string(rec_lit(Box { w: 1, path: word(2) }, 200, 0)))
  print(int_to_string(str_let(word(3), 200, 0)))
  print(int_to_string(clo_let((x: Int) => x, 200, 0)))
  print(int_to_string(inferred(mk(1), 200, 0)))
  print(int_to_string(ping(mk(1), 200, 0)))
  print(int_to_string(ca(mk(1), 200, 0)))
  print(int_to_string(list_length(trmc(mk(1), 200))))
  print(int_to_string(swap_owned(mk(1), mk(2), 200, 0)))
  print(int_to_string(descent(t, 0, 0) + descent(t, 1, 0)))
}
