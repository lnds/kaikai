# A call's arguments run left to right whichever of them the caller holds
# for a release after the call. Every call below prints 1, 2, 3 in that
# order: the argument in the borrowed slot is a call result, an `if`, a
# `match`, a block, a `++`, a list over a spread, a field read, a record
# literal or a lambda, in first, middle and last position.

type Pt = { x: Int, y: Int }
type Bx = { inner: Pt, n: Int }

fn say(k: Int) : Int / Stdout = {
  Stdout.print("#{k}")
  k
}

fn pt(k: Int) : Pt / Stdout = Pt { x: say(k), y: 0 }
fn bx(k: Int) : Bx / Stdout = Bx { inner: Pt { x: say(k), y: 0 }, n: k }
fn text(k: Int) : String / Stdout = "t#{say(k)}"
fn pick(k: Int) : Result[Int, Int] / Stdout = if say(k) % 2 == 0 { Ok(k) } else { Err(k) }

fn p1(r: Pt, a: Int, b: Int) : Int = a + b
fn p2(a: Int, r: Pt, b: Int) : Int = a + b
fn p3(a: Int, b: Int, r: Pt) : Int = a + b

fn s1(s: String, a: Int, b: Int) : Int = a + b
fn s2(a: Int, s: String, b: Int) : Int = a + b
fn s3(a: Int, b: Int, s: String) : Int = a + b

fn l1(xs: [Int], a: Int, b: Int) : Int = a + b
fn l2(a: Int, xs: [Int], b: Int) : Int = a + b
fn l3(a: Int, b: Int, xs: [Int]) : Int = a + b

fn f1(f: (Int) -> Int, a: Int, b: Int) : Int = a + b
fn f2(a: Int, f: (Int) -> Int, b: Int) : Int = a + b
fn f3(a: Int, b: Int, f: (Int) -> Int) : Int = a + b

fn done(label: String, v: Int) : Unit / Stdout = Stdout.print("#{label} #{v}")

fn calls() : Unit / Stdout = {
  done("call first", p1(pt(1), say(2), say(3)))
  done("call middle", p2(say(1), pt(2), say(3)))
  done("call last", p3(say(1), say(2), pt(3)))
}

fn ifs() : Unit / Stdout = {
  done("if first", p1(if say(1) > 0 { Pt { x: 1, y: 0 } } else { Pt { x: 0, y: 0 } }, say(2), say(3)))
  done("if middle", p2(say(1), if say(2) > 0 { Pt { x: 1, y: 0 } } else { Pt { x: 0, y: 0 } }, say(3)))
  done("if last", p3(say(1), say(2), if say(3) > 0 { Pt { x: 1, y: 0 } } else { Pt { x: 0, y: 0 } }))
}

fn matches() : Unit / Stdout = {
  done("match first", p1(match pick(1) { Ok(k) -> Pt { x: k, y: 0 }  Err(k) -> Pt { x: 0, y: k } }, say(2), say(3)))
  done("match middle", p2(say(1), match pick(2) { Ok(k) -> Pt { x: k, y: 0 }  Err(k) -> Pt { x: 0, y: k } }, say(3)))
  done("match last", p3(say(1), say(2), match pick(3) { Ok(k) -> Pt { x: k, y: 0 }  Err(k) -> Pt { x: 0, y: k } }))
}

fn blocks() : Unit / Stdout = {
  done("block first", p1({ let k = say(1)
                           Pt { x: k, y: k } }, say(2), say(3)))
  done("block middle", p2(say(1), { let k = say(2)
                                    Pt { x: k, y: k } }, say(3)))
  done("block last", p3(say(1), say(2), { let k = say(3)
                                          Pt { x: k, y: k } }))
}

fn concats() : Unit / Stdout = {
  done("concat first", s1(text(1) ++ "x", say(2), say(3)))
  done("concat middle", s2(say(1), text(2) ++ "x", say(3)))
  done("concat last", s3(say(1), say(2), text(3) ++ "x"))
}

fn spreads() : Unit / Stdout = {
  let tail = [7, 8]
  done("spread first", l1([say(1), ...tail], say(2), say(3)))
  done("spread middle", l2(say(1), [say(2), ...tail], say(3)))
  done("spread last", l3(say(1), say(2), [say(3), ...tail]))
}

fn fields() : Unit / Stdout = {
  done("field first", p1(bx(1).inner, say(2), say(3)))
  done("field middle", p2(say(1), bx(2).inner, say(3)))
  done("field last", p3(say(1), say(2), bx(3).inner))
}

fn literals() : Unit / Stdout = {
  done("literal first", p1(Pt { x: say(1), y: 0 }, say(2), say(3)))
  done("literal middle", p2(say(1), Pt { x: say(2), y: 0 }, say(3)))
  done("literal last", p3(say(1), say(2), Pt { x: say(3), y: 0 }))
}

fn lambdas() : Unit / Stdout = {
  done("lambda first", f1((k) => k + 1, say(2), say(3)))
  done("lambda middle", f2(say(1), (k) => k + 1, say(3)))
  done("lambda last", f3(say(1), say(2), (k) => k + 1))
}

fn main() : Unit / Stdout = {
  calls()
  ifs()
  matches()
  blocks()
  concats()
  spreads()
  fields()
  literals()
  lambdas()
}
