# A trap inside a closure the runtime calls back from C crosses C frames
# that have no landing pads. The unwind walks on through them, so the
# kaikai frames above still release what they owned; what the C frames
# held stays behind once per trap.

import actor
import spawn

fn scaled(xs: [Int], k: Int) : [Int] = map(xs, (x) => 100 / (x - k))

fn work(k: Int) : Int = {
  let xs = [1, 2, 3, 4]
  let label = "worker " ++ int_to_string(k)
  let ys = scaled(xs, k % 4 + 1)
  list_length(ys) + list_length(xs) + string_length(label)
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = work(k)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 30)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
