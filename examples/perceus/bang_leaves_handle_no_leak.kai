effect Base {
  base() : Int
}

fn find(n: Int) : Option[[Int]] = if n > 0 { Some([n, n]) } else { None }

fn run(k: Int) : Option[Int] {
  let r = handle {
    let xs = find(Base.base() - k)!
    length(xs) + 1
  } with Base {
    base(resume) -> resume(40)
  }
  Some(r)
}

fn show(o: Option[Int]) : String = match o {
  Some(n) -> "some #{int_to_string(n)}"
  None -> "none"
}

fn main() : Int / Stdout {
  Stdout.print(show(run(1)))
  Stdout.print(show(run(100)))
  Stdout.print(show(run(2)))
  0
}
