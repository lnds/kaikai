# `--dump-last-use` sees reads inside a loop body. A read repeated on
# every iteration cannot be a last use, so it blocks like a closure read.
import loop

fn show(n: Int, m: Int) : Unit / Stdout = {
  repeat(2) { Stdout.print(int_to_string(n)) }
  Stdout.print(int_to_string(m))
}

fn capture(k: Int) : Int = {
  let f = (x) => x + k
  f(1)
}

fn idle(z: Int) : Int = 0

fn main() : Unit / Stdout = show(capture(1), idle(2))
