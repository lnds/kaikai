# Explicitly named zero-use pattern binders in non-recursive matches:
# a named rest binder in a helper fn and a child binder in an inner
# match bound inside a let. Neither arm hosts a self-tail-call, so the
# tcrec goto ledger never sees them — the arm-drop pass must pay each
# birth ref or every call leaks the bound subtree.
type Node = { v: Int, tag: String }

fn first_v(xs: [Node]) : Int = match xs {
  [h, ...rest] -> h.v
  []           -> 0
}

fn probe(xs: [Node]) : Int = {
  let k = match xs {
    [a, ...more] -> a.v
    []           -> 0
  }
  k * 2
}

fn sweep(xs: [Node], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> sweep(t, acc + first_v(t) + probe(t) + h.v - h.v)
}

fn build(n: Int, acc: [Node]) : [Node] =
  if n == 0 { acc } else { build(n - 1, [Node { v: n, tag: "n_#{n}" }, ...acc]) }

fn main() : Unit / Stdout = {
  let total = sweep(build(2000, []), 0)
  Stdout.print("total=#{total}")
}
