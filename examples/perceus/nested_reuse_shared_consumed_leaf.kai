# A nested rebuild over a SHARED scrutinee hands a borrowed leaf to a call
# that consumes it: the leaf's own reference must exist before that call.
type Blk = Blk([String], Option[String], Int, Int)

fn tag(s: String) : String = string_concat(s, "!")

fn tag_opt(o: Option[String]) : Option[String] = match o {
  None -> None
  Some(s) -> Some(tag(s))
}

fn relabel(o: Option[Blk]) : Option[Blk] = match o {
  None -> None
  Some(Blk(cs, ret, l, c)) -> Some(Blk(map(cs, (s) => tag(s)), tag_opt(ret), l, c))
}

fn or_dash(o: Option[String]) : String = match o {
  None -> "-"
  Some(s) -> s
}

fn show(o: Option[Blk]) : String = match o {
  None -> "none"
  Some(Blk(cs, ret, l, c)) ->
    "#{string_join(cs, ",")} #{or_dash(ret)} #{l + c}"
}

fn main() : Unit / Stdout = {
  let b = Some(Blk([string_concat("a", "b"), string_concat("c", "d")], Some(string_concat("e", "f")), 1, 2))
  let r1 = relabel(b)
  let r2 = relabel(b)
  print(show(r1))
  print(show(r2))
  print(show(b))
}
