# Issue #1180 — the PERF half: the idiomatic `[1..n] |> sum()` and
# `[1..n] |> reduce(...)` allocate O(1), not O(n). `sum()` fuses to
# the counting loop (`range_map_sum`, zero-stage terminal fusion);
# `reduce` iterates the lazy range generator inside the prelude. The
# gate is alloc_total < 100 with N = 1M: one materialised range would
# blow it by four orders of magnitude.

# A step that is not a literal is tested where the range is built: a
# positive one runs the counting loop, any other the range value itself.
fn stride_sum(lo: Int, hi: Int, by: Int) : Int = [lo, lo + by..hi] |> sum()

fn stride_length(lo: Int, hi: Int, by: Int) : Int = [lo, lo + by..hi] |> length()

fn stride_doubled(lo: Int, hi: Int, by: Int) : Int = [lo, lo + by..hi] | (x) => x * 2 |> sum()

fn stride_product(lo: Int, hi: Int, by: Int) : Int = [lo, lo + by..hi] | (x) => x + 1 |> product()

fn stride_digits(lo: Int, hi: Int, by: Int) : Int =
  [lo, lo + by..hi] | (x) => x |> foldl(0, (acc, x) => acc * 10 + x)

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string([1..1000000] |> sum()))
  Stdout.print(int_to_string([1..1000000] |> reduce(0, (acc, x) => acc + x)))
  Stdout.print(int_to_string([1, 3..1000001] |> sum()))
  Stdout.print(int_to_string([1..1000000] |> length()))
  let a = 1
  Stdout.print(int_to_string([a, a + 2..1000001] |> sum()))
  Stdout.print(int_to_string(stride_sum(1, 1000001, 2)))
  Stdout.print(int_to_string(stride_length(1, 1000001, 2)))
  Stdout.print(int_to_string(stride_doubled(1, 1000001, 2)))
  Stdout.print(int_to_string(stride_sum(10, 0, -2)))
  Stdout.print(int_to_string(stride_length(10, 0, -2)))
  Stdout.print(int_to_string(stride_doubled(10, 0, -2)))
  Stdout.print(int_to_string(stride_product(4, 1, -1)))
  Stdout.print(int_to_string(stride_digits(10, 0, -3)))
  Stdout.print(int_to_string(stride_digits(1, 7, 3)))
  Stdout.print(int_to_string(stride_length(1, 0, 2)))
  Stdout.print(int_to_string([10, 8..0] |> sum()))
  Stdout.print(int_to_string([10, 8..0] | (x) => x * 2 |> sum()))
}
