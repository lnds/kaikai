# A single-use param whose only (consuming) read sits in the RHS of a
# short-circuiting `and`. The consumed-on-every-path verdict must not
# count a short-circuited position: judging `x` consumed lets the gates
# transfer it raw into `take(x)`, and every `flag == false` call skips
# the read — nothing ever releases the list.
fn take(x: [Int]) : Int = match x {
  [h, ..._] -> h
  []        -> 0
}

fn build(n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { build(n - 1, [n, ...acc]) }

fn g(x: [Int], flag: Bool) : Int =
  if flag and take(x) > 0 { 1 } else { 2 }

fn drive(n: Int, acc: Int) : Int =
  if n == 0 { acc }
  else { drive(n - 1, acc + g(build(20, []), n - (n / 2) * 2 == 0)) }

fn main() : Unit / Stdout = {
  Stdout.print("sum=#{drive(2000, 0)}")
}
