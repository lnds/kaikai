# A sequence defined in terms of itself: `FIBS` names its own cells, so
# each one is computed once and the eightieth is eighty additions away.

import seq

fn sum2(a: Seq[Int], b: Seq[Int]) : Seq[Int] = match a {
  []         -> lazy []
  [x, ...xs] -> match b {
    []         -> lazy []
    [y, ...ys] -> lazy [x + y, ...sum2(xs, ys)]
  }
}

const FIBS : Seq[Int] = lazy [0, 1, ...sum2(FIBS, drop(FIBS, 1))]

fn main() : Unit / Stdout = {
  Stdout.print("#{to_list(take(FIBS, 12))}")
  Stdout.print("#{nth(FIBS, 80)}")
}
