# Borrowed descents whose arm child reaches the loop back-edge. Each walk
# borrows its chain, so a child it passes on must not keep the arm's dup:
# a nested match over the child, a branchy tail, a child also read by a
# borrowing callee, and a guarded arm. `rethread` passes the child of an
# OWNED scrutinee into a borrowed slot, which must keep its reference.

type Chain = End | Cell(Chain, Int, Int)

fn build(c: Chain, i: Int, n: Int) : Chain =
  if i >= n { c } else { build(Cell(c, i + 1, i), i + 1, n) }

fn depth(c: Chain, acc: Int) : Int = match c {
  End              -> acc
  Cell(rest, _, _) -> depth(rest, acc + 1)
}

fn skip2(c: Chain, acc: Int) : Int = match c {
  End -> acc
  Cell(rest, _, _) -> match rest {
    End            -> acc + 1
    Cell(r2, _, _) -> skip2(r2, acc + 2)
  }
}

fn count_big(c: Chain, acc: Int) : Int = match c {
  End              -> acc
  Cell(rest, k, _) -> if k > 500 { count_big(rest, acc + 1) } else { count_big(rest, acc) }
}

fn depth_sum(c: Chain, acc: Int) : Int = match c {
  End -> acc
  Cell(rest, _, _) -> {
    let d = depth(rest, 0)
    depth_sum(rest, acc + d)
  }
}

fn find(c: Chain, k: Int) : Int = match c {
  End                             -> 0 - 1
  Cell(_, kx, vx) if kx == k      -> vx
  Cell(rest, _, _)                -> find(rest, k)
}

fn rethread(t: Chain, u: Chain, acc: Int) : Int = match u {
  End           -> acc + (match t { End -> 0  Cell(_, k, _) -> k })
  Cell(l, _, _) -> rethread(l, l, acc + 1)
}

fn main() = {
  let c = build(End, 0, 1000)
  print("skip2: " ++ int_to_string(skip2(c, 0)))
  print("count_big: " ++ int_to_string(count_big(c, 0)))
  print("depth_sum: " ++ int_to_string(depth_sum(build(End, 0, 300), 0)))
  print("find: " ++ int_to_string(find(c, 3) + find(c, 5000)))
  print("rethread: " ++ int_to_string(rethread(End, c, 0)))
  print("depth after: " ++ int_to_string(depth(c, 0)))
}
