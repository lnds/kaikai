# A Vec reached through a field of a `let`- or arm-bound record, or of a
# lambda param, is written in place: the fields are taken out of the record
# first, so the vector has one reference at the write.

type Buf = { data: Vec[Int], len: Int }

type Slot = Hold(Buf) | Empty

fn put_let(s: Buf, i: Int) : Buf = {
  let t = Buf { data: s.data, len: s.len }
  Buf { data: vec_set(t.data, i, 1), len: t.len + 1 }
}

fn put_arm(o: Slot, i: Int) : Slot = match o {
  Hold(b) -> Hold(Buf { data: vec_set(b.data, i, 2), len: b.len + 1 })
  Empty   -> Empty
}

fn run_let(s: Buf, i: Int, n: Int) : Buf =
  if i >= n { s } else { run_let(put_let(s, i), i + 1, n) }

fn run_arm(o: Slot, i: Int, n: Int) : Slot =
  if i >= n { o } else { run_arm(put_arm(o, i), i + 1, n) }

fn run_lam(n: Int) : Buf =
  list.foldl([0..n - 1], Buf { data: vec_make(n, 0), len: 0 },
             (b, i) => Buf { data: vec_set(b.data, i, 3), len: b.len + 1 })

fn main() : Unit / Stdout = {
  let n = 100000
  let a = run_let(Buf { data: vec_make(n, 0), len: 0 }, 0, n)
  Stdout.print(int_to_string(vec_get(a.data, n - 1) + a.len))
  match run_arm(Hold(Buf { data: vec_make(n, 0), len: 0 }), 0, n) {
    Hold(b) -> Stdout.print(int_to_string(vec_get(b.data, n - 1) + b.len))
    Empty   -> Stdout.print("empty")
  }
  let c = run_lam(n)
  Stdout.print(int_to_string(vec_get(c.data, n - 1) + c.len))
}
