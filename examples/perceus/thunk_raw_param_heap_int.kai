# A function with a raw Int param taken as a value is called through its thunk
# with a boxed argument; the thunk owns that box and must release it.

fn dup_int(n: Int) : [Int] = [n, n]

fn rounds(i: Int, total: Int) : Int =
  if i == 0 {
    total
  } else {
    let big = 4611686018427387904 + i
    let xs = map([big, big + 1], dup_int)
    rounds(i - 1, total + list_length(xs))
  }

fn main() : Unit / Stdout {
  Stdout.print("#{rounds(50, 0)}")
}
