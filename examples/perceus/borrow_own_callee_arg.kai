# A `^` param passed to a callee slot that owns its argument hands over a
# reference, so the read takes a dup. The caller keeps its list and reads
# it after every call, so a missing dup frees cells it still reads.

fn keep(ys: [Int]) : [Int] = ys

fn pass(^xs: [Int]) : [Int] = keep(xs)

fn sum(l: [Int]) : Int = match l {
  []        -> 0
  [x, ...r] -> x + sum(r)
}

fn go(i: Int, n: Int, base: [Int], acc: Int) : Int =
  if i >= n { acc } else { go(i + 1, n, base, acc + sum(pass(base))) }

fn main() : Unit / Stdout = {
  let base = [1, 2, 3]
  let total = go(0, 100, base, 0)
  Stdout.print("total=#{total} len=#{list_length(base)} sum=#{sum(base)}")
}
