# Record pattern destructuring a vector field, then writing it.

type St = { buf: Vec[Int], n: Int }

fn fill(s: St, i: Int) : St =
  if i >= 20000 { s }
  else {
    match s {
      St { buf, n } -> fill(St { buf: vec_set(buf, i, i), n: n + 1 }, i + 1)
    }
  }

fn main() : Unit / Stdout = {
  let s = fill(St { buf: vec_make(20000, 0), n: 0 }, 0)
  Stdout.print(int_to_string(vec_get(s.buf, 19999) + s.n))
}
