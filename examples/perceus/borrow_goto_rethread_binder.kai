# An arm binder of a borrowed parameter's match whose every read lends it to
# a borrowed slot needs no reference of its own: the caller's root keeps it
# alive for the whole call. The arm releases its bind-time reference on
# entry, so the path that recurses normally and the path that re-threads
# the parameter through the goto both leave it balanced.
#
# `count_pos` reads `arg` in a non-tail call on one branch and re-threads it
# on the other; `widest` does the same through a two-binder arm.

type Ty = TInt | TList(Ty) | TShape(Int, Ty) | TPair(Ty, Ty)

fn count_pos(t: Ty) : Int = match t {
  TInt            -> 0
  TList(inner)    -> count_pos(inner)
  TShape(sv, arg) -> if sv > 0 { 1 + count_pos(arg) } else { count_pos(arg) }
  TPair(a, b)     -> count_pos(a) + count_pos(b)
}

fn widest(t: Ty, w: Int) : Int = match t {
  TInt        -> w
  TList(a)    -> widest(a, w)
  TShape(_, a) -> widest(a, w)
  TPair(a, b) -> if w > 3 { w + widest(b, 0) } else { widest(a, w + 1) }
}

fn nest(i: Int, t: Ty) : Ty =
  if i == 0 { t } else { nest(i - 1, TList(TShape(i % 3, TPair(TShape(i, t), TInt)))) }

fn main() : Unit / Stdout = {
  let t = nest(20, TShape(4, TList(TShape(0, TInt))))
  Stdout.print("pos=#{count_pos(t)} widest=#{widest(t, 0)}")
}
