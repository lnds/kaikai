# All-boxed variant rebuilds over both leak edges: the diagonal kept child
# (`BVal(v) -> BErr(v)`, mask==0 path) and the wildcard donor slot the
# rebuild abandons (`BErr(_) -> BVal([7])` — the old child must be dropped
# by the reuse, on both backends).
type B = BVal([Int]) | BErr([Int])

fn flip(r: B) : B = match r {
  BVal(v) -> BErr(v)
  BErr(_) -> BVal([7])
}

fn spin(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    match flip(if n % 2 == 0 { BVal([1, 2]) } else { BErr([3]) }) {
      BVal(_) -> spin(n - 1, acc + 1)
      BErr(_) -> spin(n - 1, acc)
    }
  }

fn main() : Unit / Stdout = {
  Stdout.print("s=#{spin(1500, 0)}")
}
