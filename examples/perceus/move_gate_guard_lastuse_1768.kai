# A cons-arm binder whose lexically-last use sits inside an inner match
# GUARD. A guard can evaluate and its arm still not be chosen, so that
# read must never transfer raw: the last-use gate rejects guard
# positions and the cascade-safety check requires the last use inside
# the self-call's args. If both layers regress, the fallthrough arm's
# scrutinee cascade re-releases the consumed binder.
type Pair = { a: Int, b: String }

fn looks(p: Pair) : Bool = match p { Pair { a: x, b: _ } -> x > 2 }

fn walk(xs: [Pair], ks: [Int], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> {
    let w = h.a
    match ks {
      [y, ..._] if looks(h) -> walk(t, ks, acc + w + y)
      _                     -> walk(t, ks, acc + w)
    }
  }
}

fn build(n: Int, acc: [Pair]) : [Pair] =
  if n == 0 { acc } else { build(n - 1, [Pair { a: n, b: "p_#{n}" }, ...acc]) }

fn main() : Unit / Stdout = {
  let total = walk(build(3000, []), [10], 0)
  Stdout.print("total=#{total}")
}
