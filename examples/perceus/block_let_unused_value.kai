# A never-read block `let` holds the value its rhs produced, whatever the
# rhs's shape, and exactly one side releases it: the emitter inline when
# the rhs is a fresh allocation, perceus at block exit otherwise. The
# shapes below are neither fresh nor a bare name, so they are paid at
# block exit. The last three are the guards: a fresh rhs (paid inline), a
# bare alias, and a `let` that is read. A second payer on any of them
# would double-free.

type Box = { items: [Int], n: Int }

fn mk() : [Int] = [1, 2, 3]

fn mkbox() : Box = Box { items: mk(), n: 3 }

fn first(xs: [Int]) : Int =
  match xs {
    []        -> 0
    [h, ..._] -> h
  }

fn from_if(flag: Bool) : Int = {
  let _ys = if flag { mk() } else { [4] }
  7
}

fn from_if_alias() : Int = {
  let xs = mk()
  let _ys = if true { xs } else { mk() }
  7
}

fn from_match(flag: Bool) : Int = {
  let _ys = match flag {
    true  -> mk()
    false -> [4]
  }
  7
}

fn from_block() : Int = {
  let _ys = {
    let a = mk()
    a
  }
  7
}

fn from_field() : Int = {
  let b = mkbox()
  let _ys = b.items
  7
}

fn from_pipe() : Int = {
  let _ys = mk() |> list_reverse
  7
}

fn fresh_rhs() : Int = {
  let _ys = mk()
  7
}

fn alias_rhs() : Int = {
  let xs = mk()
  let _ys = xs
  7
}

fn read_after() : Int = {
  let ys = if true { mk() } else { [9] }
  first(ys)
}

fn round(i: Int, acc: Int) : Int =
  if i == 0 { acc }
  else {
    let s = from_if(true) + from_if(false) + from_if_alias() + from_match(true) + from_match(false) +
            from_block() + from_field() + from_pipe() +
            fresh_rhs() + alias_rhs() + read_after()
    round(i - 1, acc + s)
  }

fn main() : Unit / Stdout =
  Stdout.print("#{round(20, 0)}")
