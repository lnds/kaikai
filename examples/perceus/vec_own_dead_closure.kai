# A closure captured the vector but is dead before the write.

fn peek(v: Vec[Int], i: Int) : Int = {
  let f = () => vec_get(v, 0) + i
  f()
}

fn fill(v: Vec[Int], i: Int) : Vec[Int] =
  if i >= 20000 { v }
  else {
    let k = peek(v, i)
    fill(vec_set(v, i, k), i + 1)
  }

fn grab(v: Vec[Int], i: Int) : Vec[Int] = {
  let g = () => vec_length(v)
  let n = g()
  vec_set(v, i, n)
}

fn fill2(v: Vec[Int], i: Int) : Vec[Int] =
  if i >= 20000 { v } else { fill2(grab(v, i), i + 1) }

fn main() : Unit / Stdout = {
  let a = fill(vec_make(20000, 0), 0)
  let b = fill2(vec_make(20000, 0), 0)
  Stdout.print(int_to_string(vec_get(a, 19999) + vec_get(b, 19999)))
}
