# A vector held in a constructor field and written from the arm that binds
# it: the match hands the cell back before the arm body runs, so the binder
# is the vector's only owner and the write is in place. Each loop makes 100
# writes; the gate reads the `vec_inplace` / `vec_cow` counters under
# KAI_TRACE_RC and requires zero copies.

type Box = Box(Vec[Int], Int)

# The arm rebuilds the constructor around the written vector.
fn bump(b: Box) : Box = match b {
  Box(v, n) -> Box(vec_set(v, n % 8, n), n + 1)
}

fn bumps(b: Box, k: Int) : Box = if k == 0 { b } else { bumps(bump(b), k - 1) }

# The rebuild is the argument of a tail call.
fn thread(b: Box, k: Int) : Box = if k == 0 { b } else {
  match b {
    Box(v, n) -> thread(Box(vec_set(v, n % 8, n), n + 1), k - 1)
  }
}

# The arm projects the vector out and writes it.
fn poke(o: Option[Vec[Int]], x: Int) : Vec[Int] = match o {
  Some(v) -> vec_set(v, 0, x)
  None    -> vec_empty()
}

fn pokes(v: Vec[Int], k: Int) : Vec[Int] = if k == 0 { v } else { pokes(poke(Some(v), k), k - 1) }

# A guard that passes releases the cell too.
fn poke_big(b: Box, x: Int) : Vec[Int] = match b {
  Box(v, n) if n > 0 -> vec_set(v, 1, x + n)
  Box(v, _)          -> v
}

fn pokes_big(v: Vec[Int], k: Int) : Vec[Int] = if k == 0 { v } else { pokes_big(poke_big(Box(v, k), k), k - 1) }

fn total(b: Box) : Int = match b {
  Box(v, n) -> vec_get(v, 3) + n
}

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(total(bumps(Box(vec_make(8, 0), 0), 100))))
  Stdout.print(int_to_string(total(thread(Box(vec_make(8, 0), 0), 100))))
  Stdout.print(int_to_string(vec_get(pokes(vec_make(8, 0), 100), 0)))
  Stdout.print(int_to_string(vec_get(pokes_big(vec_make(8, 0), 100), 1)))
}
