# Rebuilds whose reuse token is null or cannot host the cell allocate fresh:
# raw Int, Real and enum slots, a TRMC descent, a rebuild at another arity,
# each run on a unique and on a shared tree.

type Mark = Hot | Cold

type T = Node(Mark, T, Int, Real, T) | Pair(Int, T) | Tip

fn ins(t: T, k: Int) : T = match t {
  Node(m, l, x, w, r) ->
    if k < x { Node(m, ins(l, k), x, w + 0.5, r) } else { Node(Cold, l, x, w, ins(r, k)) }
  Pair(x, r) -> if k < x { Node(Hot, Tip, k, 1.0, Pair(x, r)) } else { Pair(x, ins(r, k)) }
  Tip -> if k % 3 == 0 { Pair(k, Tip) } else { Node(Hot, Tip, k, 0.25, Tip) }
}

fn squash(t: T) : T = match t {
  Node(Hot, l, x, _, r) -> Pair(x, squash(r)) |> keep_left(squash(l))
  Node(Cold, l, x, w, r) -> Node(Cold, squash(l), x + 1, w, squash(r))
  Pair(x, r) -> Pair(x * 2, squash(r))
  Tip -> Tip
}

fn keep_left(t: T, l: T) : T = match l {
  Tip -> t
  _ -> Node(Cold, l, 0, 0.0, t)
}

fn sig(t: T, acc: Int) : Int = match t {
  Node(Hot, l, x, w, r) -> sig(r, (sig(l, acc) * 3 + x + real_to_int(w * 4.0)) % 1000003)
  Node(Cold, l, x, w, r) -> sig(r, (sig(l, acc) * 7 + x + real_to_int(w * 4.0)) % 1000003)
  Pair(x, r) -> sig(r, (acc * 5 + x) % 1000003)
  Tip -> acc
}

fn fill(t: T, s: Int, n: Int) : T =
  if n <= 0 { t } else { fill(ins(t, s % 997), (s * 31 + 17) % 10007, n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("unique: #{sig(squash(fill(Tip, 5, 300)), 0)}")
  let base = fill(Tip, 11, 200)
  let grown = fill(base, 3, 100)
  let flat = squash(grown)
  Stdout.print("shared: #{sig(base, 0)} #{sig(grown, 0)} #{sig(flat, 0)} #{sig(grown, 0)}")
}
