# A captured `var` whose old value is still held when it is written: the
# write copies, and the holder keeps the value it read.

import collections.vec

fn each_of[a, e](xs: [a], f: (a) -> Unit / e) : Unit / e = match xs {
  [] -> ()
  [h, ...t] -> {
    f(h)
    each_of(t, f)
  }
}

fn main() {
  var v := vec.make(4, 0)
  each_of([0, 1, 2, 3], i => {
    let before = v
    v := vec.set(v, i, i + 1)
    println(int_to_string(vec.get(before, i)))
  })
  println(int_to_string(vec.get(v, 0) + vec.get(v, 3)))
}
