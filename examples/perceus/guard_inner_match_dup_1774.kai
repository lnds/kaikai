# A match INSIDE a guard: its arms bind and dup-read their own binders,
# so the arm-drop planner must recurse into guard expressions — a
# multi-use binder in the inner match needs its pre-tail drop exactly as
# it would in a body position. Without the recursion the inner binder's
# birth ref is never paid and one string leaks per iteration.
type Pair = { a: Int, b: String }

fn walk(xs: [Pair], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] if match h { Pair { a: _, b: s } -> string_length(s) + string_length(s) > 0 } ->
    walk(t, acc + h.a)
  [_, ...t] -> walk(t, acc)
}

fn build(n: Int, acc: [Pair]) : [Pair] =
  if n == 0 { acc } else { build(n - 1, [Pair { a: n, b: "p_#{n}" }, ...acc]) }

fn main() : Unit / Stdout = {
  let total = walk(build(3000, []), 0)
  Stdout.print("total=#{total}")
}
