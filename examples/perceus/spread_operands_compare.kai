# Two blocks evaluated as operands of one expression each bind the same
# name (a spread's result). The first operand's value must not be read
# back from that name after the second block rebinds it.

type Rec = { x: Int, ys: [Int], zs: [Int] }

fn main() : Unit / Stdout = {
  let z = Rec { x: 5, ys: [1, 2], zs: [3] }
  let v = 2
  let same = Rec { ...z, x: v } == Rec { ...z, x: 0 - 10 }
  Stdout.print("#{same} #{z.x}")
}
