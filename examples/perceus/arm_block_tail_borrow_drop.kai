# A match arm with a block body whose tail reads a binder only through dups
# and borrows owes that binder's own reference a release after the tail's
# value. The tail is no self-tail-call, so no goto path can take the drop.
#
# `ins` reaches its recursion through `ins_via`, which keeps it a plain
# call; `ins_trmc` recurses directly, so the modulo-cons rewrite takes the
# arm and has to carry the release into each step.

type Color = Red | Black
type Tree = Leaf | Node(Color, Tree, Int, Tree)

fn left(t: Tree) : Tree = match t {
  Node(_, a, _, _) -> a
  Leaf             -> Leaf
}

fn size(t: Tree) : Int = match t {
  Node(_, a, _, b) -> 1 + size(a) + size(b)
  Leaf             -> 0
}

fn keysum(t: Tree) : Int = match t {
  Node(_, a, k, b) -> k + keysum(a) + keysum(b)
  Leaf             -> 0
}

fn red_int(t: Tree) : Int = match t {
  Node(Red, _, _, _) -> 10
  _                  -> 0
}

fn fresh(k: Int) : Tree = Node(Red, Node(Red, Leaf, k, Leaf), k, Leaf)

fn ins(t: Tree, k: Int) : Tree = match t {
  Node(c, l, kx, r) -> {
    let z = kx + 1
    Node(c, left(l), z + red_int(l), ins_via(r, k))
  }
  Leaf -> fresh(k)
}

fn ins_via(t: Tree, k: Int) : Tree = ins(t, k)

fn ins_trmc(t: Tree, k: Int) : Tree = match t {
  Node(c, l, kx, r) -> {
    let z = kx + 1
    Node(c, left(l), z + red_int(l), ins_trmc(r, k))
  }
  Leaf -> fresh(k)
}

fn build(i: Int, n: Int, t: Tree) : Tree = if i >= n { t } else { build(i + 1, n, ins(t, i)) }

fn build_trmc(i: Int, n: Int, t: Tree) : Tree = if i >= n { t } else { build_trmc(i + 1, n, ins_trmc(t, i)) }

fn main() : Unit / Stdout = {
  let a = build(0, 60, Leaf)
  let b = build_trmc(0, 60, Leaf)
  Stdout.print("size=#{size(a)} keys=#{keysum(a)} size_trmc=#{size(b)} keys_trmc=#{keysum(b)}")
}
