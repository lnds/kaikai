# A guarded arm whose body steps a modulo-cons spine never steals its
# scrutinee's shell: the guard may reject after the shell was taken.

type T = Leaf | Node(Int, T, T)

fn ins(t: T, k: Int, lim: Int) : T = match t {
  Leaf -> Node(k, Leaf, Leaf)
  Node(x, l, r) if x < lim -> Node(x, ins(l, k, lim), r)
  Node(x, l, r) -> Node(x, l, ins(r, k, lim))
}

fn size(t: T) : Int = match t {
  Leaf -> 0
  Node(_, l, r) -> 1 + size(l) + size(r)
}

fn total(t: T) : Int = match t {
  Leaf -> 0
  Node(x, l, r) -> x + total(l) + total(r)
}

fn build(i: Int, t: T, lim: Int) : T =
  if i == 0 { t } else { build(i - 1, ins(t, (i * 7) % 13, lim), lim) }

fn main() : Unit / Stdout = {
  let a = build(60, Leaf, 6)
  let b = ins(a, 3, 6)
  let c = ins(a, 11, 6)
  Stdout.print("#{size(a)} #{total(a)}")
  Stdout.print("#{size(b)} #{total(b)}")
  Stdout.print("#{size(c)} #{total(c)}")
}
