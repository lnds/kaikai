# A recognised record rebuild that keeps a child in ITS OWN field. The
# arm extracts the binder with an incref; re-embedding it in the same
# field hits the runtime alias guard (old == new skips the old-field
# decref), so the donor's claim on the kept child must be paid via the
# kept-binder mask or every reuse leaks the child's spine.
type R = { ks: [Int], n: Int }

fn tick(r: R) : R = match r {
  { ks: ks0, n: n0 } -> R { ks: ks0, n: n0 + 1 }
}

fn spin(i: Int, acc: Int) : Int =
  if i == 0 { acc } else {
    match tick(R { ks: [4, 5], n: 0 }) {
      { ks: _, n: n1 } -> spin(i - 1, acc + n1)
    }
  }

fn main() : Unit / Stdout = {
  Stdout.print("s=#{spin(2000, 0)}")
}
