# A fixed vec that crosses into a parameter arrives as a heap `Vec`, and the
# read that ends its last use must release it.
#
# `pick` reads a concrete `Vec[Int]<3>` param once, `head` reads a generic
# `Vec[Int]<n>` through the unit coercion the typer wraps it in, and
# `sum_loop` returns a raw `Real` from a self-tail loop whose exit drops
# bind the result before releasing the vec.

fn pick(v: Vec[Int]<3>) : Int = v[1]

fn head[n: Dim](v: Vec[Int]<n>) : Int = v[0]

fn sum_loop(v: Vec[Real], i: Int, n: Int, acc: Real) : Real =
  if i >= n { acc } else { sum_loop(v, i + 1, n, acc + vec_get(v, i)) }

fn round(k: Int) : Int = {
  let ints : Vec[Int]<3> = [k, 2, 3]
  let reals : Vec[Real] = [1.5, 2.5, int_to_real(k)]
  pick(ints) + head(ints) + real_to_int(sum_loop(reals, 0, 3, 0.0))
}

fn go(k: Int, acc: Int) : Int = if k == 0 { acc } else { go(k - 1, acc + round(k)) }

fn main() : Unit / Stdout = Stdout.print("#{go(300, 0)}")
