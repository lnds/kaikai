# A boxed Real returned by an applied lambda is released once it is read raw.

fn sum_with(f: (Int) -> Real, i: Int, n: Int, acc: Real) : Real =
  if i >= n { acc } else { sum_with(f, i + 1, n, acc + f(i) + f(i)) }

fn main() : Unit / Stdout = {
  let v : Vec[Real]<2> = [1.5, 2.5] | (x => x + 1.0)
  let h = sum_with((x) => int_to_real(x) * 0.5, 0, 100, 0.0)
  Stdout.print(real_to_string(h + v[0] + v[1]))
}
