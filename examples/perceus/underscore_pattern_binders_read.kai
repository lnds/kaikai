# An `_`-prefixed pattern binder only silences the unused warning: read, it
# is bound like any other, in every pattern shape; unread, it is a wildcard.
type Pair = H(String, String)
type Rec = { a: String, b: Int }

fn list_read(xs: [String]) : String = match xs {
  [_h, ..._t] -> "#{_h}+#{int_to_string(list_length(_t))}"
  [] -> "empty"
}

fn list_unread(xs: [String]) : Int = match xs {
  [h, ..._t] -> string_length(h)
  [] -> 0
}

fn variant_read(p: Pair) : String = match p {
  H(_x, _y) -> string_concat(_x, _y)
}

fn record_read(r: Rec) : String = match r {
  { a: _a, b: _b } -> "#{_a}#{int_to_string(_b)}"
}

fn guard_read(xs: [String]) : String = match xs {
  [_h, ...] if string_length(_h) > 2 -> _h
  _ -> "short"
}

fn some_read(o: Option[String]) : String = match o {
  Some(_v) -> _v
  None -> "none"
}

fn main() : Unit / Stdout = {
  let names = ["ana", "bo", "cy"]
  Stdout.print(list_read(names))
  Stdout.print(int_to_string(list_unread(names)))
  Stdout.print(variant_read(H("ab", "cd")))
  Stdout.print(record_read(Rec { a: "k", b: 7 }))
  Stdout.print(guard_read(names))
  Stdout.print(guard_read(["x"]))
  Stdout.print(some_read(Some("yes")))
}
