# The value an `if`, a `match`, a block or an operator yields straight into a
# borrowed parameter slot is held by no binder: the caller releases it after
# the call, whichever tail produced it. A tail that reads a borrowed binder
# yields a reference of its own, so that release never reaches the binder's
# owner.

type Pt = { x: Int, y: Int }
type Sh = Circle(Int) | Sq(Int, Int)

fn pick(i: Int) : Result[Int, Int] = if i % 2 == 0 { Ok(i) } else { Err(i) }
fn mk(i: Int) : Pt = Pt { x: i, y: i + 1 }
fn mk_l(i: Int) : [Int] = [i, i + 1]

fn ignore(r: Pt) : Int = 1

fn origin(r: Pt) : Int = match r {
  { x: 0, y: _ } -> 0
  _              -> 1
}

fn sides(a: Int, s: Sh, b: Int) : Int = match s {
  Circle(_) -> a
  Sq(_, _)  -> b
}

fn blank(a: Int, b: Int, ^s: String) : Int = if string_length(s) == 0 { a } else { b }

fn empty(xs: [Int]) : Int = match xs {
  [] -> 1
  _  -> 0
}

fn unused(f: (Int) -> Int) : Int = 2

# Every tail builds a fresh value.
fn fresh(i: Int) : Int = {
  let a = ignore(match pick(i) { Ok(_) -> mk(i)  Err(_) -> Pt { x: i, y: 0 } })
  let b = origin(if i % 3 == 0 { Pt { x: 0, y: i } } else { mk(i) })
  let c = sides(3, { let k = i + 1
                     if k % 2 == 0 { Circle(k) } else { Sq(k, k) } }, 4)
  let d = blank(5, 6, if i % 2 == 0 { "" } else { "n#{i}" })
  let e = empty(match pick(i) { Ok(k) -> [k, i]  Err(_) -> [] })
  let f = unused(if i % 2 == 0 { (k) => k + i } else { (k) => k * i })
  let g = array_length(if i % 2 == 0 { array_make(3, i) } else { array_make(4, i) })
  a + b + c + d + e + f + g
}

# An operator's result and a list built over a spread are fresh too.
fn built(xs: [Int], s: String, i: Int) : Int =
  empty([i, ...xs]) + empty(xs ++ [i]) + blank(1, 2, s ++ "x")

# A tail reads a binder: borrowed, owned and read once, owned and read
# again, bound by an arm.
fn lent(^p: Pt, i: Int) : Int = origin(if i % 2 == 0 { p } else { Pt { x: 0, y: i } })

fn moved(p: Pt, i: Int) : Int = ignore(match pick(i) { Ok(_) -> p  Err(_) -> mk(i) })

fn shared(p: Pt, i: Int) : Int = ignore(if i % 2 == 0 { p } else { mk(i) }) + p.y

fn unwrapped(o: Option[Pt], i: Int) : Int = match o {
  Some(q) -> origin(if i % 2 == 0 { q } else { mk(i) })
  None    -> 0
}

# A `^` parameter read where the runtime consumes its operand keeps the
# caller's reference: a field base, an operand of `++` or `==`, an indexed
# array, an interpolation hole, a record-update base, a scrutinee, a prim's
# argument, the value `!` unwraps.
fn mk_s(i: Int) : String = "s#{i}"
fn mk_a(i: Int) : Array[Int] = array_make(2, i)
fn mk_o(i: Int) : Option[Pt] = Some(mk(i))

fn unwrap(o: Option[Int]) : Int = match o {
  Some(k) -> k
  None    -> 0
}

fn fx(^r: Pt) : Int = r.x + r.y
fn fcat(^s: String) : Int = string_length(s ++ "x") + string_length("x" ++ s)
fn feq(^s: String) : Int = if s == "s2" { 1 } else { 0 }
fn fidx(^a: Array[Int]) : Int = a[0] + a[1]
fn fhole(^s: String, ^r: Pt) : Int = string_length("a#{s}b#{r.x}")
fn fupd(^r: Pt, i: Int) : Int = origin(Pt { ...r, x: i })
fn fscr(^r: Pt) : Int = match r { { x, y } -> x + y }
fn fprim(^s: String) : Int = string_length(s)
fn fbang(^o: Option[Pt]) : Option[Int] = Some(o!.x)

fn from_call(i: Int) : Int =
  fx(mk(i)) + fcat(mk_s(i)) + feq(mk_s(i)) + fidx(mk_a(i)) + fhole(mk_s(i), mk(i)) + fupd(mk(i), i) +
  fscr(mk(i)) + fprim(mk_s(i)) + unwrap(fbang(mk_o(i)))

# Each value is read again after the borrowing calls.
fn from_let(i: Int) : Int = {
  let p = mk(i)
  let s = mk_s(i)
  let a = mk_a(i)
  let o = mk_o(i)
  let v = fx(p) + fcat(s) + feq(s) + fidx(a) + fhole(s, p) + fupd(p, i) + fscr(p) + fprim(s) + unwrap(fbang(o))
  v + origin(p) + string_length(s) + array_length(a) + unwrap(fbang(o))
}

fn from_yield(i: Int) : Int =
  fx(if i % 2 == 0 { mk(i) } else { Pt { x: 1, y: i } }) +
  fcat(match pick(i) { Ok(_) -> mk_s(i)  Err(_) -> "e" }) +
  feq({ let k = i + 1
        mk_s(k) }) +
  fidx(if i % 2 == 0 { mk_a(i) } else { array_make(2, 0) }) +
  fhole(match pick(i) { Ok(_) -> mk_s(i)  Err(_) -> "e" }, if i % 3 == 0 { mk(i) } else { Pt { x: 1, y: i } }) +
  fupd({ let k = i + 1
         mk(k) }, i) +
  fscr(match pick(i) { Ok(_) -> mk(i)  Err(_) -> Pt { x: 1, y: i } }) +
  fprim(if i % 2 == 0 { mk_s(i) } else { "e" }) +
  unwrap(fbang(if i % 2 == 0 { mk_o(i) } else { Some(Pt { x: 1, y: i }) }))

fn go(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else {
    let p = mk(i)
    let v = fresh(i) + built(mk_l(i), "s#{i}", i) + lent(p, i) + moved(mk(i), i) + shared(mk(i), i) +
            unwrapped(Some(mk(i)), i) + p.x + from_call(i) + from_let(i) + from_yield(i)
    go(i + 1, n, acc + v % 11)
  }

fn main() : Unit / Stdout = Stdout.print("#{go(0, 200, 0)}")
