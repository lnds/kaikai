# A cell read while its own thunk runs has no step to give: the rest of
# `LOOP` skips past the cell that is computing it, and the read panics
# instead of recursing.

import seq

const LOOP : Seq[Int] = lazy [1, ...drop(LOOP, 5)]

fn main() : Unit / Stdout = {
  Stdout.print("#{nth(LOOP, 0)}")
  Stdout.print("#{nth(LOOP, 3)}")
}
