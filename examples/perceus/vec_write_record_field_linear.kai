# A Vec reached through a record field is written in place: the fields the
# body reads are taken out of the record first, so the vector has one
# reference at the write and n writes cost O(n).

type Buf = { data: Vec[Int], len: Int }

fn put(s: Buf, i: Int) : Buf = Buf { data: vec_set(s.data, i, 1), len: s.len + 1 }

fn run(s: Buf, i: Int, n: Int) : Buf =
  if i >= n { s } else { run(put(s, i), i + 1, n) }

fn main() : Unit / Stdout = {
  let n = 500000
  let s = run(Buf { data: vec_make(n, 0), len: 0 }, 0, n)
  Stdout.print(int_to_string(vec_get(s.data, n - 1) + s.len))
}
