# A cell read twice runs its thunk once. Each level adds a sequence to
# itself, so the forty levels cost forty thunk runs per element when a
# cell keeps its step, and 2^40 when every read recomputes it.

import seq

fn add(a: Seq[Int], b: Seq[Int]) : Seq[Int] = defer(() => match force(a) {
  SeqEnd         -> SeqEnd
  SeqCons(x, xs) -> match force(b) {
    SeqEnd         -> SeqEnd
    SeqCons(y, ys) -> SeqCons(x + y, add(xs, ys))
  }
})

fn doubled(s: Seq[Int], levels: Int) : Seq[Int] =
  if levels == 0 { s } else { doubled(add(s, s), levels - 1) }

fn main() : Unit / Stdout = {
  let s = doubled(from(1), 40)
  Stdout.print("#{to_list(take(s, 3))}")
  Stdout.print("#{nth(s, 2)}")
}
