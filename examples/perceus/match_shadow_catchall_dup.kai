# A nested `match` whose catch-all binder shadows the outer one must dup
# the register the arm actually bound, not the outer binder's.
#
# The alias set an arm structurally dups is collected by SURFACE name, but
# a shadowing catch-all is alpha-renamed to a fresh `.tN` at its bind site.
# Dup'ing the surface name increfs the OUTER register instead — and on the
# path taken here that register was never stored, so the load is undefined
# and LLVM is free to fold the inner tag switch away with the branch that
# guarded it. The constructor arm then matched EVERY variant and bound raw
# payload bits: `VNum(n)` capturing a `VNull` (0) or a `VStr` (its pointer).
#
# Only the native backend reaches this path, and only above -O0 — the C
# oracle is correct throughout, so parity is the gate.

type Shape
  = SNone
  | SNum(Int)
  | SText(String)

fn shape_name(s: Shape) : String = match s {
  SNone     -> "none"
  SNum(_)   -> "num"
  SText(_)  -> "text"
}

# Both catch-alls are named `other` and both are USED: the inner bind is
# renamed, the dup must follow it.
fn describe(tag: Shape, val: Shape) : String = match tag {
  SText(_) -> match val {
    SNum(n) -> "num #{n}"
    other   -> "no num: #{shape_name(other)}"
  }
  other -> "no tag: #{shape_name(other)}"
}

fn main() : Unit / Stdout = {
  Stdout.print(describe(SText("k"), SNone))
  Stdout.print(describe(SText("k"), SText("7")))
  Stdout.print(describe(SText("k"), SNum(42)))
  Stdout.print(describe(SNum(1), SNone))
}
