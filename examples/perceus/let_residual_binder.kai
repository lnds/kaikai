# A destructuring `let` binder read more than once, or only inside a lambda,
# keeps its bind-time reference until the block ends; the block pays it.

type H = H(String, String)

fn twice(p: H) : String = {
  let H(x, y) = p
  let a = string_concat(x, y)
  string_concat(a, x)
}

fn captured(p: H) : String = {
  let H(x, y) = p
  let g = () => y
  x
}

fn in_lambda(p: H) : String = {
  let f = (q: H) => {
    let H(x, y) = q
    x
  }
  f(p)
}

fn fresh() : H = H(string_concat("a", "b"), string_concat("c", "d"))

fn go(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    go(n - 1, acc + twice(fresh()).length() + captured(fresh()).length() + in_lambda(fresh()).length())
  }

fn main() : Unit / Stdout = Stdout.print("#{go(100, 0)}")
