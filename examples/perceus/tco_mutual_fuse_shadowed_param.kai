# A local reusing a parameter's name in a fused group shadows the
# parameter: `let acc = acc + 1` and the arm's `Some(x)` each read their
# own binding, not the parameter.
fn ping(n: Int, x: Int) : Int =
  if n == 0 { x } else {
    match Some(n * 10) {
      Some(x) -> pong(n - 1, x)
      None -> 0
    }
  }

fn pong(m: Int, acc: Int) : Int = {
  let acc = acc + 1
  ping(m, acc)
}

fn main() : Unit / Stdout = Stdout.print(int_to_string(ping(3, 0)))
