# A stateful handler owns its state: `resume(v, ns)` releases the state
# it replaces, and the handle releases its final state after the return
# clause, on the dispatched path and on a var cell rewritten to a register.

import loop

effect Box {
  put(s: String) : Unit
  take() : String
}

effect Tell {
  tell(s: String) : Unit
}

fn boxed(n: Int) : String / Box = {
  var i := 0
  while { i < n } {
    Box.put("v#{int_to_string(i)}")
    i := i + 1
  }
  Box.take()
}

fn in_box(n: Int) : String = handle { boxed(n) } with Box("start#{int_to_string(n)}") {
  put(s, resume) -> resume((), s)
  take(resume)   -> resume(state)
}

fn told(n: Int) : Unit / Tell = {
  var i := 0
  while { i < n } {
    Tell.tell("t#{int_to_string(i)}")
    i := i + 1
  }
}

fn heard(n: Int) : [String] = handle { told(n) } with Tell([]) {
  tell(s, resume) -> resume((), [s, ...state])
  return(_x)      -> state
}

fn main() : Unit / Stdout = {
  var last := ""
  var best := ""
  var i := 1
  while { i < 300 } {
    let s = "v#{int_to_string(i)}"
    if i % 7 == 0 { last := s; best := "#{last}!" }
    i := i + 1
  }
  Stdout.print("last=#{last} best=#{best}")
  Stdout.print(in_box(50))
  Stdout.print("heard=#{list_length(heard(40))}")
}
