# A match whose arms name every constructor still sends a value whose
# sub-pattern fails to the later catch-all arm.

type S = A(Int) | B(Int) | C

fn pick(s: S) : String = match s {
  A(0) -> "a0"
  B(n) -> "b#{n}"
  C -> "c"
  _ -> "other"
}

fn tag(s: S) : Int = match s {
  A(n) -> n
  B(n) -> 0 - n
  C -> 99
}

fn main() : Unit / Stdout {
  Stdout.print("#{pick(A(0))} #{pick(A(5))} #{pick(B(2))} #{pick(C)}")
  Stdout.print("#{tag(A(3))} #{tag(B(4))} #{tag(C)}")
}
