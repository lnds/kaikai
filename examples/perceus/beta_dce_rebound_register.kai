# Two sibling scopes bind the same register name: a spread's result in one
# arm and a closure in a later statement's arm. Dropping the dead binder of
# the spread must not release that closure's captures.

type Rec = { x: Int, y: [Int], z: Bool }
type Sum = Ca(Int, Bool) | Cb(Int) | Cc([Int])
const k0 : Int = 2
const k1 : Int = 4
fn h_bool(b: Bool) : Int = if b { 1 } else { 2 }
fn h_list(xs: [Int]) : Int = foldl(xs, 7, (acc, x) => ((acc * 31 + (x % 1000003)) % 1000000007))
fn h_sum(s: Sum) : Int = match s {
  Ca(a, b) -> ((((1 * 31 + (a % 1000003)) % 1000000007) * 31 + h_bool(b)) % 1000000007)
  Cb(a) -> ((2 * 31 + (a % 1000003)) % 1000000007)
  Cc(a) -> ((3 * 31 + h_list(a)) % 1000000007)
}
fn f0(xs: [Int], v: Sum) : [Int] = match xs {
  [] -> []
  [h, ...t] -> [(length(xs) % 100003), ...f0(t, v)]
}
fn f2(xs: [Int], v: Bool) : [Int] = match xs {
  [] -> []
  [h, ...t] -> [((foldl(([k0, 3, 8] |> list.reverse), ((if true { h } else { h }) + ((h % 7) ^ (h % 4))), (acc, x) => ((foldl(f0([1, (0 - 11)], Cc([6, 5])), length(xs), (acc, x) => (h % 10007)) |> ((v) => v)) % 10007)) |> ((v) => v)) % 100003), ...f2(t, v)]
}
fn main() : Unit / Stdout = {
  let y = (if all(take(([11, 3] || ((x) => [x, k0])), 8), ((x) => (match Cb(4) { Ca(a, b) -> { let k1 = a; b }; Cb(a) -> { let z = Cc([0..5]); false }; Cc([h, ...t]) -> { true }; Cc(a) -> { false } }))) { Cc([2..3]) } else { Cc(([3, 4] |? ((k1) => { true }))) })
  let acc = (Rec { x: k1, y: [k0, k0, 5], z: (if false { let z = 1; false } else { true }) }).x
  let z = (match Cc(([2, 8, 9] | ((n) => (n + 2)))) { Ca(a, b) -> { drop(([(0 - 4)] | ((n) => (n + 5))), 1) }; Cb(a) -> { (f2([9], true) | ((v) => (match head([6, 3, (0 - 2)]) { Some(h) -> k1; None -> k0 })) |? ((z) => { let acc = [k1, z, acc]; true })) }; Cc(a) -> { let x = Rec { x: (9 / 4), y: take(([0..5] || ((x) => [x, 6])), 3), z: true }; (match reverse(a) { [] -> { (if false { let k1 = k1; a } else { a }) }; [h, ...t] if (k1 < h) -> { let z = Rec { ...x, x: 2 }; (match Ca(11, true) { Ca(a, b) -> { [(0 - 8), 11, 6] }; Cb(0) -> { a }; Cb(a) -> { t }; Cc(a) if true -> { a }; Cc(a) -> { a } }) }; [h, ...t] -> { ([1..5] | ((n) => (n + 1))) } }) } })
  let z = (if false { (match Cb(10) { Ca(a, b) -> { let x = (z |> take(3)); ((v) => { v }) }; Cb(a) -> { ((x) => 1) }; Cc(a) -> { let k0 = k0; ((acc) => { let z = y; k0 }) } }) } else { ((n) => (n + 6)) })
  Stdout.print("#{z(1)} #{acc}")
}
