# String, real and fixed-width literals are heap cells the register that
# binds them owns; each is released exactly once on every path.

fn tag(flag: Bool) : String = {
  let s = "tag"
  let t = "-end"
  if flag { s ++ t } else { t }
}

fn scale(x: Real) : Real = {
  let k = 2.5
  let r = x * k
  if x > 0.0 { r } else { k }
}

fn widen(n: Int32) : Int32 = {
  let one: Int32 = 1
  if n > one { n } else { one }
}

fn wide(flag: Bool) : UInt64 = {
  let big: UInt64 = 9000000000
  let small: UInt64 = 7
  if flag { big } else { small }
}

fn main() : Int / Console = {
  let five: Int32 = 5
  println(tag(true))
  println(tag(false))
  println(int_to_string(real_to_int(scale(3.0))))
  println(show(widen(five)))
  println(show(wide(true)))
  println(show(wide(false)))
  0
}
