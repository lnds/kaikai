# A self-recursive fn whose owned String param is (a) consumed by an
# `==` sitting under a BINOP tail in a non-recursive arm and (b)
# re-threaded through the self-call in the sibling arm. The binop tail
# is one of the walker forms with no self-call carve-out: the gate must
# scan the whole node, see the consuming read, and reject the
# borrow-move-last derivation — the exit drop on the base path is not
# the only release there. If the binop arm ever stops rejecting, every
# read transfers raw and the base path releases one ref twice.
type Stamp = SMod(Option[String]) | SPlain(Int)

fn score(ds: [Stamp], target_mod: String) : Int =
  match ds {
    [] -> 0
    [d, ...rest] -> match d {
      SMod(mo) -> match mo {
        Some(m) -> (if m == target_mod { 1 } else { 0 }) + 10
        None -> 0
      }
      _ -> score(rest, target_mod)
    }
  }

# The caller keeps its own ref across the call (dup at the call site,
# re-thread through its own self-recursion) — the #1758 lower_impls shape.
fn walk(ds: [[Stamp]], target_mod: String, acc: Int) : Int =
  match ds {
    [] -> acc
    [g, ...rest] -> walk(rest, target_mod, acc + score(g, target_mod))
  }

fn main() : Unit / Stdout = {
  # Interpolation keeps the param off any static-literal exemption.
  let tm = "mod_#{1 + 2}"
  let groups = [
    [SPlain(1), SMod(Some("alpha"))],
    [SMod(Some("mod_3"))],
    [SPlain(2), SPlain(3), SMod(Some("beta"))],
    [SMod(None)]
  ]
  let r = walk(groups, tm, 0)
  Stdout.print("r=#{r} tm=#{tm}")
}
