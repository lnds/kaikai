# A destructuring `let` owns its value: each binder takes its own reference
# and the value is released. A shape that keeps the value alive retains one
# cell per call, which the loop turns into growth.

type Pair = H(String, String)
type Nest = N(Pair, String)
type Rec = { a: String, b: String }

fn let_variant(p: Pair) : String = {
  let H(l, r) = p
  string_concat(r, l)
}

fn let_nested(n: Nest) : String = {
  let N(H(a, b), c) = n
  string_concat(string_concat(a, b), c)
}

fn let_record(x: Rec) : String = {
  let { a, b } = x
  string_concat(b, a)
}

fn let_tuple(t: (String, String)) : String = {
  let (a, b) = t
  string_concat(b, a)
}

fn let_one(p: Pair) : String = {
  let H(l, _) = p
  l
}

fn step(i: Int) : Int = {
  let s = "#{i}"
  let v = let_variant(H(s, "r"))
  let n = let_nested(N(H(s, "b"), "c"))
  let r = let_record(Rec { a: s, b: "b" })
  let t = let_tuple((s, "b"))
  let o = let_one(H(s, "r"))
  string_length(v) + string_length(n) + string_length(r) + string_length(t) + string_length(o)
}

fn run(i: Int, n: Int, acc: Int) : Int = if i >= n { acc } else { run(i + 1, n, acc + step(i)) }

fn main() : Unit / Stdout = {
  let p = H("left", "right")
  Stdout.print(let_variant(p))
  Stdout.print(let_one(p))
  Stdout.print("total=#{run(0, 100, 0)}")
}
