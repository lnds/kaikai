# A rebuild that takes the caller's donated shell is pasted into the caller,
# taking the shell from the caller's arm token: paths that rebuild into it,
# paths that hand back their argument and leave it unused, a rotation, on
# unique and on shared trees.

type Color = Red | Black

type T = Node(Color, T, Int, T) | Leaf

fn lift(l: T, k: Int, r: T) : T = match l {
  Node(Red, Node(Red, a, x, b), y, c) -> Node(Red, Node(Black, a, x, b), y, Node(Black, c, k, r))
  Node(Red, a, x, b) ->
    if x % 4 == 0 { Node(Black, a, x, b) } else { Node(Black, Node(Red, a, x, b), k, r) }
  Node(Black, _, _, _) -> l
  Leaf -> Node(Red, Leaf, k, r)
}

fn ins(t: T, k: Int) : T = match t {
  Node(c, l, x, r) -> if k < x { lift(ins(l, k), x, r) } else { Node(c, l, x, ins(r, k)) }
  Leaf -> Node(Red, Leaf, k, Leaf)
}

fn size(t: T) : Int = match t {
  Node(_, l, _, r) -> size(l) + 1 + size(r)
  Leaf -> 0
}

fn sig(t: T, acc: Int) : Int = match t {
  Node(Red, l, x, r) -> sig(r, (sig(l, acc) * 3 + x) % 1000003)
  Node(Black, l, x, r) -> sig(r, (sig(l, acc) * 7 + x) % 1000003)
  Leaf -> acc
}

fn fill(t: T, s: Int, n: Int) : T =
  if n <= 0 { t } else { fill(ins(t, s % 997), (s * 31 + 17) % 10007, n - 1) }

fn main() : Unit / Stdout {
  let u = fill(Leaf, 5, 400)
  Stdout.print("unique: #{size(u)} #{sig(u, 0)}")
  let base = fill(Leaf, 11, 200)
  let grown = fill(base, 3, 100)
  Stdout.print(
    "shared: #{size(base)} #{sig(base, 0)} #{size(grown)} #{sig(grown, 0)} #{sig(base, 0)}"
  )
}
