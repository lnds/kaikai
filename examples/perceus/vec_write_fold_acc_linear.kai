# A Vec threaded through a fold lambda is written in place: the closure
# hands its accumulator on instead of dup'ing it, so n writes cost O(n).

fn fill(n: Int) : Vec[Int] =
  list.foldl([0..n - 1], vec_make(n, 0), (acc, i) => {
    let w = vec_set(acc, i, i * 2)
    w
  })

fn bump(n: Int) : Vec[Int] =
  list.foldl([0..n - 1], vec_make(n, 0), (acc, i) => vec_set(acc, i, vec_get(acc, i) + 1))

fn main() : Unit / Stdout = {
  let n = 500000
  let a = fill(n)
  let b = bump(n)
  Stdout.print(int_to_string(vec_get(a, n - 1)))
  Stdout.print(int_to_string(vec_get(b, n - 1)))
}
