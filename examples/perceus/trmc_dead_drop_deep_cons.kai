# A filter whose arm drops its head on the skipping branch and rebuilds
# `[h, ...keep(t, s)]` on the other must still lower the rebuild to a
# modulo-cons step. A 1M-deep input overflows the stack if it recurses.

fn keep(xs: [Int], s: String) : [Int] = match xs {
  []        -> []
  [h, ...t] -> if h > string_length(s) { [h, ...keep(t, s)] } else { keep(t, s) }
}

fn build(n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { build(n - 1, [n, ...acc]) }

fn last(xs: [Int], d: Int) : Int = match xs {
  []        -> d
  [h, ...t] -> last(t, h)
}

fn count(xs: [Int], acc: Int) : Int = match xs {
  []        -> acc
  [_, ...t] -> count(t, acc + 1)
}

fn main() : Unit / Stdout = {
  let kept = keep(build(1000000, []), "abc")
  Stdout.print("#{last(kept, 0)} #{count(keep(build(1000000, []), "abcdef"), 0)}")
}
