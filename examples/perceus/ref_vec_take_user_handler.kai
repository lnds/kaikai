# A user `Mutable` handler observes `@r` and `r :=` around a write of a
# `Ref` from its own read: the take is skipped while it is installed.

import collections.vec

fn bump(r: Ref[Vec[Int]], i: Int) : Unit / Mutable {
  r := vec.set(@r, i, i)
}

fn main() {
  let r = &vec.make(3, 0)
  handle {
    bump(r, 1)
  } with Mutable {
    ref_get(c, resume) -> {
      println("get")
      resume(Mutable.ref_get(c))
    }
    ref_set(c, v, resume) -> {
      println("set")
      resume(Mutable.ref_set(c, v))
    }
    return(x) -> x
  }
  println(int_to_string(vec.get(@r, 1)))
}
