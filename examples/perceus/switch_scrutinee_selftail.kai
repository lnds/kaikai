# A self-tail call inside a `match` over integral literals whose scrutinee
# reads a list-arm binder. The scrutinee consumes the binder, so the goto
# must not release it again: a second release frees the element while the
# list still holds it, and the next walk reads freed memory.

type Slot = Boxed | Raw

type Param = { name: String, slot: Slot, mark: Char, weight: Int }

fn slot_tag(s: Slot) : Int = match s {
  Boxed -> 0
  Raw -> 1
}

fn is_raw(p: Param) : Bool = match p.slot {
  Boxed -> false
  Raw -> true
}

fn mark_of(p: Param) : Char = p.mark

fn weight_of(p: Param) : Int = p.weight

fn any_raw(ps: [Param]) : Bool = match ps {
  [] -> false
  [p, ...rest] -> match slot_tag(p.slot) {
    0 -> any_raw(rest)
    _ -> true
  }
}

fn skip_marked(ps: [Param]) : Int = match ps {
  [] -> 0
  [p, ...rest] -> match mark_of(p) {
    'x' -> skip_marked(rest)
    _ -> list_length(rest) + 1
  }
}

fn total_weight(ps: [Param], acc: Int) : Int = match ps {
  [] -> acc
  [p, ...rest] -> match weight_of(p) {
    0 -> total_weight(rest, acc)
    n -> total_weight(rest, acc + n)
  }
}

fn first_raw(ps: [Param]) : String = match ps {
  [] -> "none"
  [p, ...rest] -> match is_raw(p) {
    false -> first_raw(rest)
    true -> "found"
  }
}

fn names(ps: [Param]) : String = match ps {
  [] -> ""
  [p, ...rest] -> "#{p.name} #{names(rest)}"
}

fn main() : Unit / Stdout {
  let ps = [
    Param { name: "a", slot: Boxed, mark: 'x', weight: 0 },
    Param { name: "b", slot: Boxed, mark: 'x', weight: 2 },
    Param { name: "c", slot: Raw, mark: 'y', weight: 3 }
  ]
  Stdout.print("any_raw: #{any_raw(ps)} #{any_raw(ps)}")
  Stdout.print("skip_marked: #{skip_marked(ps)} #{skip_marked(ps)}")
  Stdout.print("total_weight: #{total_weight(ps, 0)} #{total_weight(ps, 0)}")
  Stdout.print("first_raw: #{first_raw(ps)} #{first_raw(ps)}")
  Stdout.print("names: #{names(ps)}")
}
