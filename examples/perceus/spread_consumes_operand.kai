# A list spread consumes its operand like a ctor slot, in either position.
# An owned operand moves in, whether a param, a call result or a let-bound
# local; a `^` param is dup'd first, so the caller's list survives every
# call with its values intact.

fn prepend(xs: [Int], p: Int) : [Int] = [p, ...xs]

fn mk(n: Int) : [Int] = if n == 0 { [] } else { [n, ...mk(n - 1)] }

fn wrap(n: Int) : [Int] = [0, ...mk(n)]

fn via_let(n: Int) : [Int] = {
  let xs = mk(n)
  [1, ...xs]
}

fn around(xs: [Int], ys: [Int]) : [Int] = [...xs, 7, ...ys]

fn lend(^xs: [Int], p: Int) : [Int] = [p, ...xs]

fn lend_around(^xs: [Int], ^ys: [Int]) : [Int] = [...xs, 9, ...ys]

fn lend_pick(^xs: [Int], ^ys: [Int], c: Bool) : [Int] = [0, ...if c { xs } else { ys }]

fn lend_reuse(^xs: [Int], zs: [Int]) : [Int] = match zs {
  [] -> []
  [h, ...r] -> [h + list_length(r), ...xs]
}

fn build(xs: [Int], i: Int) : [Int] = if i == 0 { xs } else { build(prepend(xs, i), i - 1) }

fn sum(^xs: [Int], acc: Int) : Int = match xs {
  [] -> acc
  [h, ...t] -> sum(t, acc + h)
}

fn round(^base: [Int], ^other: [Int], i: Int) : Int =
  sum(wrap(20), 0) + sum(via_let(10), 0) + sum(around([i, i], [i]), 0) +
  sum(lend(base, i), 0) + sum(lend_around(base, other), 0) +
  sum(lend_pick(base, other, i % 2 == 0), 0) + sum(lend_reuse(base, [i, i]), 0)

fn loop_it(^base: [Int], ^other: [Int], i: Int, acc: Int) : Int =
  if i == 0 { acc } else { loop_it(base, other, i - 1, acc + round(base, other, i)) }

fn main() : Unit / Stdout = {
  let base = [1, 2, 3]
  let other = [4, 5]
  let built = build([], 1000)
  let total = loop_it(base, other, 1000, 0)
  Stdout.print("built=#{list_length(built)} sum=#{sum(built, 0)} total=#{total} base=#{sum(base, 0)} other=#{sum(other, 0)}")
}
