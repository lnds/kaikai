# A literal passed straight into a borrowed parameter slot is a fresh owned
# value nobody else holds: the caller releases it after the call.

type Q = { a: Int, r: Real }

fn size(s: String) : Int = match s {
  "" -> 0
  _  -> 1
}

fn cls(q: Q) : Int = match q {
  { a: 1, r: _ } -> 1
  _              -> 2
}

fn heads(xs: [String]) : Int = match xs {
  [h, ..._] -> size(h)
  []        -> 0
}

fn main() : Unit / Stdout =
  Stdout.print("s=#{size("abc")} q=#{cls(Q { a: 1, r: 0.5 })} l=#{heads(["x", "y"])}")
