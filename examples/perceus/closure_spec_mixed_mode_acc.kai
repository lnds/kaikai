# A specialised closure whose bound-once accumulator is declared raw
# (`int64_t kair_<n>`) but read by a BOXED consumer. `if a > b` routes the
# accumulator through `kai_op_gt`, which takes `KaiValue *`, while `a + b`
# would keep it raw end to end. Both spellings must resolve to the one
# declaration: the raw binder boxes on demand at the boxed use rather than
# naming a `kaiv_` local that was never declared.

fn main() : Int / Stdout = {
  let xs = [3, 1, 4, 1, 5]
  let m = foldr(xs, 0, (a, b) => if a > b { a } else { b })
  Stdout.print("max=#{int_to_string(m)}")
  0
}
