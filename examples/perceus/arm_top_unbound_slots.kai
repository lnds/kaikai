# An arm-top reuse arm binds names nested inside a slot, and a stolen
# unique shell releases every pointer child no binder took (`_`, a nested
# pattern) — the C backend once bound neither.

type In = Leaf(String) | Empty
type St = Ok2 | Loose(String) | Deep(In)
type Rep = R(String, St, Int)
type Row = { name: String, st: St, n: Int }
type Lst = E | N(String, St, Lst)

fn depth1(rs: [Rep]) : [String] = match rs {
  [] -> []
  [r, ...rest] -> match r {
    R(name, Loose(why), n) -> ["#{name}:#{why}@#{n}", ...depth1(rest)]
    _ -> depth1(rest)
  }
}

fn depth2(rs: [Rep]) : [String] = match rs {
  [] -> []
  [r, ...rest] -> match r {
    R(name, Deep(Leaf(why)), n) -> ["#{name}:#{why}@#{n}", ...depth2(rest)]
    _ -> depth2(rest)
  }
}

fn rows(rs: [Row]) : [String] = match rs {
  [] -> []
  [r, ...rest] -> match r {
    { name: name, st: Loose(why), n: n } -> ["#{name}:#{why}@#{n}", ...rows(rest)]
    _ -> rows(rest)
  }
}

fn heads(ss: [St]) : [String] = match ss {
  [] -> []
  [Loose(why), ...rest] -> [why, ...heads(rest)]
  [_, ...rest] -> heads(rest)
}

fn mk(i: Int, acc: Lst) : Lst =
  if i == 0 { acc }
  else { mk(i - 1, N("n#{i}", if i % 2 == 0 { Loose("w#{i}") } else { Deep(Leaf("d#{i}")) }, acc)) }

fn tagged(l: Lst) : [String] = match l {
  E -> []
  N(name, Loose(why), tl) -> ["#{name}:#{why}", ...tagged(tl)]
  N(name, _, tl) -> [name, ...tagged(tl)]
}

fn main() : Unit / Stdout = {
  let reps = [R("a", Loose("x"), 1), R("b", Ok2, 2), R("c", Deep(Leaf("y")), 3)]
  Stdout.print(string_join(depth1(reps), ","))
  Stdout.print(string_join(depth2(reps), ","))
  Stdout.print(string_join(rows([Row { name: "r", st: Loose("z"), n: 4 }, Row { name: "s", st: Ok2, n: 5 }]), ","))
  Stdout.print(string_join(heads([Loose("p"), Ok2, Loose("q")]), ","))
  Stdout.print(int_to_string(list_length(tagged(mk(2000, E)))))
}
