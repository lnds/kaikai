# The root file's `reverse_loop` borrows its list; `list.reverse_loop`,
# which `list.reverse` calls by its bare name, consumes it. The core body
# must keep reading its own module's convention.

fn reverse_loop(^xs: [Int], out: [Int]) : [Int] = out

fn main() : Int / Stdout {
  let ys = [1, 2, 3]
  print("rev=#{list.reverse(ys)}")
  print("mine=#{reverse_loop(ys, [9])}")
  print("len=#{list_length(ys)}")
  0
}
