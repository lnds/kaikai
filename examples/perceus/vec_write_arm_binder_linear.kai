# An arm binder read and then written is unique at the write: the read
# is a lend, the write hands the binder on, so n writes cost O(n).

type Box = Box(Vec[Int], Int)

fn bump(b: Box, i: Int) : Box = match b {
  Box(v, k) -> Box(vec_set(v, i, vec_get(v, i) + 1), k)
}

fn bump_let(b: Box, i: Int) : Box = match b {
  Box(v, k) -> {
    let x = vec_get(v, i) + 1
    Box(vec_set(v, i, x), k + 1)
  }
}

fn run(b: Box, i: Int, n: Int) : Box =
  if i >= n { b } else { run(bump_let(bump(b, i), i), i + 1, n) }

fn main() : Unit / Stdout = {
  let n = 500000
  match run(Box(vec_make(n, 0), 0), 0, n) {
    Box(v, k) -> {
      Stdout.print(int_to_string(vec_get(v, n - 1)))
      Stdout.print(int_to_string(k))
    }
  }
}
