# A variant reuse arm whose pattern deconstructs a one-level nested
# sub-ctor but whose rebuild is FLAT. The C helper pays the old slots
# 1:1 (inner cell included); the native move overwrite pays none, so
# the native lowering must keep the fresh-alloc path for this shape —
# the match-exit cascade reclaims donor + inner + originals.
type P = Pv([Int]) | Pw([Int])
type T = C(P, [Int]) | W([Int], [Int])

fn crush(t: T) : T = match t {
  C(Pv(_), ys) -> W(ys, [9])
  C(Pw(_), zs) -> W([8], zs)
  W(a, b)      -> C(Pv(a), b)
}

fn spin(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    match crush(C(Pv([1, 2]), [3])) {
      W(_, _) -> spin(n - 1, acc + 1)
      C(_, _) -> spin(n - 1, acc)
    }
  }

fn main() : Unit / Stdout = {
  Stdout.print("s=#{spin(2000, 0)}")
}
