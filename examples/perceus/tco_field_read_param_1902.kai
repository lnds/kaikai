# The callee FIELD-READS the param instead of discarding it: its own receiver
# decref already releases the ref, so the goto must not drop again.
type Env = { entries: [String] }

fn env_prepend(e: Env, p: String) : Env = Env { entries: [p, ...e.entries] }

fn build(e: Env, i: Int, n: Int) : Env =
  if i >= n { e } else { build(env_prepend(e, "p"), i + 1, n) }

fn main() : Unit / Stdout = {
  let e = build(Env { entries: [] }, 0, 200000)
  Stdout.print("n=#{list_length(e.entries)}")
}
