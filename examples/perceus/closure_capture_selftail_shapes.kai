# Shapes around a closure-captured arm binder on a self-tail path. The
# capture never consumes the binder, so each goto path releases it after
# the args; a leaf that also moves the binder pays through that move.
# `no_rec`, `let_copy` and `not_tail` are the neighbours that never
# released the binder before the args.

#[derive(Eq, Show)]
type Life = { worker: Int, summons: Int }

type Msg = Wire(Life) | Cancel

fn by_field(lives: [Life], msgs: [Msg]) : [Life] = match msgs {
  [] -> lives
  [Cancel, ...rest] -> by_field(lives, rest)
  [Wire(life), ...rest] -> by_field(filter(lives, l => l.worker != life.worker), rest)
}

fn in_block(lives: [Life], msgs: [Msg]) : [Life] = match msgs {
  [] -> lives
  [Cancel, ...rest] -> in_block(lives, rest)
  [Wire(life), ...rest] -> {
    let keep = filter(lives, l => l != life)
    in_block(filter(keep, l => l.summons >= life.summons), rest)
  }
}

fn moved_too(lives: [Life], msgs: [Msg]) : [Life] = match msgs {
  [] -> lives
  [Cancel, ...rest] -> moved_too(lives, rest)
  [Wire(life), ...rest] -> moved_too([life, ...filter(lives, l => l != life)], rest)
}

fn one_path(lives: [Life], msgs: [Msg]) : [Life] = match msgs {
  [] -> lives
  [Cancel, ...rest] -> one_path(lives, rest)
  [Wire(life), ...rest] ->
    if life.summons > 0 { one_path(filter(lives, l => l != life), rest) }
    else { one_path(lives, rest) }
}

fn no_rec(lives: [Life], msgs: [Msg]) : [Life] = match msgs {
  [] -> lives
  [Cancel, ...rest] -> no_rec(lives, rest)
  [Wire(life), ..._rest] -> filter(lives, l => l != life)
}

fn let_copy(lives: [Life], msgs: [Msg]) : [Life] = match msgs {
  [] -> lives
  [Cancel, ...rest] -> let_copy(lives, rest)
  [Wire(life), ...rest] -> {
    let gone = life
    let_copy(filter(lives, l => l != gone), rest)
  }
}

fn not_tail(lives: [Life], msgs: [Msg]) : [Life] = match msgs {
  [] -> lives
  [Cancel, ...rest] -> not_tail(lives, rest)
  [Wire(life), ...rest] -> list_append(not_tail(filter(lives, l => l != life), rest), [])
}

fn workers(lives: [Life]) : [Int] = lives |> map((l) => l.worker)

# Fresh per call: a shared list keeps its payloads alive past the scrutinee
# drop and would hide an early release.
fn msgs() : [Msg] = [Wire(Life { worker: 0, summons: 1 }), Cancel, Wire(Life { worker: 2, summons: 1 })]

fn main() : Unit / Stdout {
  let all = [Life { worker: 0, summons: 1 }, Life { worker: 1, summons: 2 },
             Life { worker: 2, summons: 1 }]
  Stdout.print("by_field: #{workers(by_field(all, msgs()))}")
  Stdout.print("in_block: #{workers(in_block(all, msgs()))}")
  Stdout.print("moved_too: #{workers(moved_too(all, msgs()))}")
  Stdout.print("one_path: #{workers(one_path(all, msgs()))}")
  Stdout.print("no_rec: #{workers(no_rec(all, msgs()))}")
  Stdout.print("let_copy: #{workers(let_copy(all, msgs()))}")
  Stdout.print("not_tail: #{workers(not_tail(all, msgs()))}")
}
