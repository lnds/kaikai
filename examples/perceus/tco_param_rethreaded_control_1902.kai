# Control: the param is re-threaded unchanged and field-read once at the end —
# no per-iteration rebuild, nothing to drop.
type Env = { entries: [String] }

fn get(e: Env) : [String] = e.entries

fn build(e: Env, i: Int, n: Int) : Int =
  if i >= n { list_length(get(e)) } else { build(e, i + 1, n) }

fn main() : Unit / Stdout = {
  Stdout.print("n=#{build(Env { entries: [] }, 0, 200000)}")
}
