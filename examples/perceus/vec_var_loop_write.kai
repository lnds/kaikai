# A `var` holding a vector, updated in a `while` loop: the slot hands its
# value to the write that refills it, so every write is in place. Each
# loop makes 100 writes; the gate reads the `vec_inplace` / `vec_cow`
# counters under KAI_TRACE_RC and requires zero copies.

import loop

# The write reads nothing.
fn fill(n: Int) : Vec[Int] = {
  var v := vec_make(n, 0)
  var i := 0
  while { i < n } {
    v := vec_set(v, i, i)
    i := i + 1
  }
  v
}

# The write's own argument reads the vector first.
fn bump(n: Int) : Vec[Int] = {
  var v := vec_make(n, 1)
  var i := 0
  while { i < n } {
    v := vec_set(v, i, vec_get(v, i) + i)
    i := i + 1
  }
  v
}

# The read is bound before the write.
fn double(n: Int) : Vec[Int] = {
  var v := vec_make(n, 3)
  var i := 0
  while { i < n } {
    let x = vec_get(v, i)
    v := vec_set(v, i, x * 2)
    i := i + 1
  }
  v
}

# A boxed element, appended.
fn names(n: Int) : Vec[String] = {
  var v := vec_empty()
  var i := 0
  while { i < n } {
    v := vec_push(v, "n" ++ int_to_string(i))
    i := i + 1
  }
  v
}

# Only one branch writes; the other leaves the slot as it was.
fn evens(n: Int) : Vec[Int] = {
  var v := vec_make(n, 0)
  var i := 0
  while { i < n } {
    v := if i % 2 == 0 { vec_set(v, i, 1) } else { v }
    i := i + 1
  }
  v
}

# The slot lives in a closure's own frame.
fn rows(xs: [Int]) : [Vec[Int]] = map(xs, (x) => {
  var v := vec_make(4, 0)
  var i := 0
  while { i < 4 } {
    v := vec_set(v, i, x + i)
    i := i + 1
  }
  v
})

fn sums(vs: [Vec[Int]], acc: Int) : Int = match vs {
  []           -> acc
  [v, ...rest] -> sums(rest, acc + sum(v, 0, 0))
}

fn sum(v: Vec[Int], i: Int, acc: Int) : Int =
  if i >= vec_length(v) { acc } else { sum(v, i + 1, acc + vec_get(v, i)) }

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(sum(fill(100), 0, 0)))
  Stdout.print(int_to_string(sum(bump(100), 0, 0)))
  Stdout.print(int_to_string(sum(double(100), 0, 0)))
  Stdout.print(vec_get(names(100), 99))
  Stdout.print(int_to_string(sum(evens(100), 0, 0)))
  Stdout.print(int_to_string(sums(rows([1, 2, 3, 4, 5]), 0)))
}
