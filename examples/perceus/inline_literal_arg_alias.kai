# Inlining a call whose argument is a literal keeps the parameter one value:
# the arm binder aliasing it stays an alias, so nothing leaks per call.
fn or_empty(s: String) : String = match s {
  "" -> "EMPTY"
  other -> other
}

fn main() : Unit / Console = {
  println("[#{or_empty("demo")}]")
  println("[#{or_empty("")}]")
}
