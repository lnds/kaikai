# A read that runs after the write must still see the old vector, so the
# write copies: one copy per function below, never an in-place write over
# a vector something still reads.

fn late_read(v: Vec[Int]) : Int = {
  let w = vec_set(v, 0, 9)
  vec_get(v, 0) * 10 + vec_get(w, 0)
}

fn first_plus(a: Vec[Int], x: Int) : Int = vec_get(a, 0) + x

# The write is an earlier argument than the read.
fn late_sibling(v: Vec[Int]) : Int = first_plus(vec_set(v, 0, 9), vec_get(v, 0))

# One path reads after the write, the other does not.
fn late_branch(v: Vec[Int], again: Bool) : Int = {
  let w = vec_set(v, 0, vec_get(v, 0) + 8)
  if again { vec_get(v, 0) * 10 + vec_get(w, 0) } else { vec_get(w, 0) }
}

fn main() : Unit / Stdout = {
  Stdout.print(int_to_string(late_read(vec_make(4, 1))))
  Stdout.print(int_to_string(late_sibling(vec_make(4, 1))))
  Stdout.print(int_to_string(late_branch(vec_make(4, 1), true)))
  Stdout.print(int_to_string(late_branch(vec_make(4, 1), false)))
}
