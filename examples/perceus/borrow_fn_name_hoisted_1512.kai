# A top-level fn NAME passed by value into a borrowed slot, from several
# declarations at once. The strip consults the known-fn-name set to decide
# the `kai_closure` materialisation; that set is built once per pass and
# threaded to every decl, so a decl reached late must see exactly the set an
# early one saw. A per-decl rebuild and a threaded value are indistinguishable
# on a single-decl fixture — the point here is that MANY decls consume it,
# with the named fns declared both before and after their consumers.

fn apply_twice(n: Int, ^f: (Int) -> Int) : Int = f(f(n))

fn bump(x: Int) : Int = x + 1

fn use_early(n: Int) : Int = apply_twice(n, bump)

fn use_mid(n: Int) : Int = apply_twice(apply_twice(n, bump), later)

fn use_late(n: Int) : Int = apply_twice(n, later)

fn later(x: Int) : Int = x + 2

fn main() : Int / Stdout = {
  let r = use_early(0) + use_mid(0) + use_late(0)
  Stdout.print(int_to_string(r))
  0
}
