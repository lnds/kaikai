# A field read passed where the callee only borrows is a fresh reference the
# caller still owes. A walk over a record-linked tree must not keep one per
# level, whether the descent is a tail call, a plain call, or another fn.

type Box = { inner: Nest, tag: Int }
type Nest = End | More(Box)

fn build(n: Int, acc: Nest) : Nest =
  if n == 0 { acc } else { build(n - 1, More(Box { inner: acc, tag: n })) }

fn depth_tail(t: Nest, acc: Int) : Int = match t {
  End -> acc
  More(b) -> depth_tail(b.inner, acc + 1)
}

fn depth_plain(t: Nest) : Int = match t {
  End -> 0
  More(b) -> 1 + depth_plain(b.inner)
}

fn is_more(t: Nest) : Int = match t {
  End -> 0
  More(_) -> 1
}

fn peek(b: Box) : Int = is_more(b.inner) + is_more(b.inner)

fn measure(n: Int) : Int = {
  let t = build(n, End)
  depth_tail(t, 0) + depth_tail(t, 0) + depth_plain(t) + peek(Box { inner: t, tag: 0 })
}

fn main() : Unit / Stdout = Stdout.print("#{measure(50)}")
