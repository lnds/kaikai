# An interpolated read of a name that shadows a parameter reads the
# shadowing binding.
fn ping(n: Int, s: String) : String =
  if n == 0 { s } else {
    let s = "#{s}+"
    pong(n - 1, "#{s}")
  }

fn pong(m: Int, acc: String) : String = ping(m, acc)

fn main() : Unit / Stdout = Stdout.print(ping(3, "x"))
