# A guard whose bare read consumes the binder on BOTH guard edges: the
# zero-use-in-body payer must not fire on top of it (a second payment is
# a double free the cell pool masks; ASAN catches it).

fn total(y: [Int]) : Int = match y {
  [h, ...t] -> h + total(t)
  []        -> 0
}

fn build(n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { build(n - 1, [n, ...acc]) }

fn scan(xs: [[Int]], acc: Int) : Int = match xs {
  [y, ...t] if total(y) > 5 -> scan(t, acc + 1)
  [_, ...t]                 -> scan(t, acc)
  []                        -> acc
}

fn mk(n: Int, acc: [[Int]]) : [[Int]] =
  if n == 0 { acc } else { mk(n - 1, [build(10, []), ...acc]) }

fn main() : Unit / Stdout = {
  Stdout.print("a=#{scan(mk(600, []), 0)}")
}
