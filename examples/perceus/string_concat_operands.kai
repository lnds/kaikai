# `++` on Strings consumes both operands on either backend: a literal, a
# fresh result and a local read for the last time.

fn label(n: Int) : String = "n=" ++ int_to_string(n)

fn main() = {
  let lit = "a" ++ "b"
  let t = int_to_string(42)
  let mixed = t ++ "!"
  print(lit ++ " " ++ mixed ++ " " ++ label(7))
}
