# A variant reuse arm with a flat rebuild over a pattern that deconstructs
# inner cells: one or two levels deep, in one or two slots. The rebuild takes
# a boxed binder from beneath a cell, reads one only through a borrowing
# call, or keeps none. Each arm runs on a fresh donor, on a live donor, and
# on a fresh donor whose inner cell is still live elsewhere.

type In = In(String, [Int])
type W = W(String, Option[In], Int) | Gone
type Pair = Pair(Option[String], Option[In], Int)

fn take_tag(w: W) : W = match w {
  W(_, Some(In(tag, xs)), k) -> W(tag, None, k + list_length(xs))
  _ -> Gone
}

fn clear(p: Pair) : Pair = match p {
  Pair(Some(s), Some(In(t, _)), k) -> Pair(None, None, k + string_length(s) + string_length(t))
  _ -> Pair(None, None, 0)
}

fn unwrap(p: Pair) : Pair = match p {
  Pair(Some(s), other, k) -> Pair(None, other, k + string_length(s))
  _ -> Pair(None, None, 0)
}

fn mk_in(s: String) : In = In(string_concat(s, "-in"), [1, 2, 3])

fn mk_w(s: String) : W = W(string_concat(s, "-w"), Some(mk_in(s)), 0)

fn mk_pair(s: String) : Pair = Pair(Some(string_concat(s, "-p")), Some(mk_in(s)), 0)

fn show_in(^i: In) : String = match i {
  In(t, xs) -> "#{t}/#{list_length(xs)}"
}

fn show_opt(^o: Option[In]) : String = match o {
  Some(i) -> show_in(i)
  None -> "-"
}

fn show_w(^w: W) : String = match w {
  W(a, o, k) -> "W #{a} #{show_opt(o)} #{k}"
  Gone -> "gone"
}

fn show_pair(^p: Pair) : String = match p {
  Pair(s, o, k) -> {
    let ss = match s { Some(x) -> x None -> "-" }
    "Pair #{ss} #{show_opt(o)} #{k}"
  }
}

fn main() : Unit / Stdout = {
  Stdout.print(show_w(take_tag(mk_w("a"))))
  let live_w = mk_w("b")
  Stdout.print(show_w(take_tag(live_w)))
  Stdout.print(show_w(live_w))
  let inner = Some(mk_in("c"))
  Stdout.print(show_w(take_tag(W(string_concat("c", "-w"), inner, 1))))
  Stdout.print(show_opt(inner))

  Stdout.print(show_pair(clear(mk_pair("d"))))
  let live_p = mk_pair("e")
  Stdout.print(show_pair(clear(live_p)))
  Stdout.print(show_pair(live_p))
  let deep = mk_in("f")
  Stdout.print(show_pair(clear(Pair(Some(string_concat("f", "-p")), Some(deep), 2))))
  Stdout.print(show_in(deep))

  Stdout.print(show_pair(unwrap(mk_pair("g"))))
  let live_u = mk_pair("h")
  Stdout.print(show_pair(unwrap(live_u)))
  Stdout.print(show_pair(live_u))
  let tag = Some(string_concat("i", "-p"))
  Stdout.print(show_pair(unwrap(Pair(tag, Some(mk_in("i")), 3))))
  Stdout.print(match tag { Some(x) -> x None -> "-" })
}
