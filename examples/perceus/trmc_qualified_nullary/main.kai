import tr

fn depth_left(t: tr.Tree, acc: Int) : Int = match t {
  tr.Leaf -> acc
  tr.Node(l, _, _) -> depth_left(l, acc + 1)
}

fn build(n: Int) : tr.Tree =
  if n <= 0 { tr.Leaf }
  else { tr.Node(build(n - 1), n, tr.Leaf) }

fn main() : Unit / Stdout = Stdout.print(int_to_string(depth_left(build(1000000), 0)))
