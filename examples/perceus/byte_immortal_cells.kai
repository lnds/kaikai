# Every Byte is an immortal cached cell, so minting bytes costs the
# ledger nothing. A variant whose slots are all Bytes must still get a
# real cell per construction: interning it would keep one immortal
# entry per distinct payload (256^n of them) and saturate the table.

type Px = Px(Byte, Byte, Byte, Byte) | NoPx

fn mk(n: Int) : Byte = match int_to_byte(n % 256) {
  Ok(b)  -> b
  Err(m) -> panic(m)
}

fn px_of(i: Int) : Px = Px(mk(i), mk(i / 256), mk(i / 65536), mk(7))

fn chan(p: Px) : Int = match p {
  Px(r, g, b, a) -> byte_to_int(r) + byte_to_int(g) + byte_to_int(b) + byte_to_int(a)
  NoPx           -> 0
}

fn px_sum(i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else { px_sum(i + 1, n, acc + chan(px_of(i))) }

fn bytes_of(i: Int, n: Int, acc: [Byte]) : [Byte] =
  if i >= n { acc } else { bytes_of(i + 1, n, [mk(i * 7), ...acc]) }

fn arr_sum(a: Array[Byte], i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else { arr_sum(a, i + 1, n, acc + byte_to_int(a[i])) }

fn main() : Unit / Stdout = {
  Stdout.print("px=#{px_sum(0, 70000, 0)}")
  let a = array.from(bytes_of(0, 5000, []))
  Stdout.print("arr=#{arr_sum(a, 0, array_length(a), 0)}")
  Stdout.print("wrap=#{byte_to_int(mk(300))} eq=#{byte_to_int(mk(300)) == byte_to_int(mk(44))}")
}
