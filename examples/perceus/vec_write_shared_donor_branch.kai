# A donor shared at the rebuild takes the fresh-alloc branch: the binder read
# through a lending builtin must not be counted as a taken use.

type Box = Box(Vec[Int], Int)

fn bump(b: Box, i: Int) : Box = match b {
  Box(v, k) -> Box(vec_set(v, i, vec_get(v, i) + 1), k)
}

fn main() : Unit / Stdout = {
  let b = Box(vec_make(4, 0), 0)
  let c = bump(b, 1)
  let d = bump(b, 2)
  match (c, d) {
    (Box(v, _), Box(w, _)) -> Stdout.print(int_to_string(vec_get(v, 1) + vec_get(w, 2)))
  }
}
