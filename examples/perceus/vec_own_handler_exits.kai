# A handler state taken into `resume` survives every way out of its clauses.

effect Cell { put(i: Int) : Unit  peek() : Int  stop() : Unit }

fn step(v: Vec[Int], i: Int) : Vec[Int] = vec_set(v, i, i + 1)

fn drive(i: Int) : Unit / Cell =
  if i >= 10 { Cell.stop() }
  else {
    Cell.put(i)
    if i == 5 { Cell.peek() |> ignore }
    drive(i + 1)
  }

fn main() : Unit / Stdout = {
  let v = handle {
    drive(0)
    ()
  } with Cell(vec_make(10, 0)) {
    put(i, resume) -> resume((), step(state, i))
    peek(resume)   -> resume(vec_get(state, 3), state)
    stop(_resume)  -> state
    return(_u)     -> vec_make(1, 99)
  }
  Stdout.print(int_to_string(vec_get(v, 9) + vec_get(v, 5) + vec_length(v)))
}
