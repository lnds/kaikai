# The piped value fills the callee's first slot, so a borrowed first
# parameter must not shift the ownership of the arguments written after
# it: `ys` is passed owned and read again, `xs` is only lent.

fn measure(^xs: [Int], ys: [Int]) : Int = length(xs) * 10 + length(ys)

fn wave(n: Int) : Int = {
  let xs = [n, n, n]
  let ys = [n, n]
  let r = xs |> measure(ys)
  r + length(ys) + length(xs)
}

fn waves(w: Int, acc: Int) : Int =
  if w <= 0 { acc } else { waves(w - 1, acc + wave(w)) }

fn main() : Unit / Stdout = {
  Stdout.print("total=#{waves(1000, 0)}")
}
