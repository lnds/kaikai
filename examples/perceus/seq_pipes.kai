# `|`, `||` and `|?` dispatch on a `Seq` by type, and the stages stay
# lazy: every pipeline below starts from an endless sequence and reads
# only the cells its sink asks for.

import seq

fn up_to(n: Int) : Seq[Int] = range(1, n, 1)

fn main() : Unit / Stdout = {
  let squares = from(1) | (x) => x * x
  Stdout.print("#{to_list(take(squares, 5))}")
  let evens = from(1) |? (x) => x % 2 == 0
  Stdout.print("#{to_list(take(evens, 5))}")
  let runs = from(1) || (n) => up_to(n)
  Stdout.print("#{to_list(take(runs, 10))}")
  let chained = from(1) |? (x) => x % 3 == 0 | (x) => x + 1 |> drop(2) |> take(4)
  Stdout.print("#{to_list(chained)}")
  Stdout.print("#{to_list(take_while(from_step(10, -3), (x) => x > 0))}")
  Stdout.print("#{to_list(range(10, 1, -4))}")
  Stdout.print("#{to_list(range(5, 1, 1))}")
  Stdout.print("#{foldl(take(from(1), 100), 0, (a, x) => a + x)}")
  Stdout.print("#{to_list(delay(() => up_to(3)))}")
  let skipped = from(1) || (n) => if n % 1000 == 0 { up_to(1) } else { up_to(0) }
  Stdout.print("#{to_list(take(skipped, 3))}")
}
