# An out-of-range `vec.set` traps in the callee of a taken `Ref` read: the
# cell holds the placeholder while the frame unwinds, and it must drop
# cleanly. C has no pads: the growth baseline pins what each trapped
# worker keeps there.

import actor
import spawn
import collections.vec

fn bad(r: Ref[Vec[Int]], k: Int) : Unit / Mutable {
  r := vec.set(@r, 9 + k, 1)
}

fn worker(parent: Pid[String], k: Int) : Unit / Actor[String] + Link + Mutable {
  Link.link(parent)
  let r = &vec.make(3, 0)
  bad(r, k)
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n {
  0
} else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link {
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 10)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
