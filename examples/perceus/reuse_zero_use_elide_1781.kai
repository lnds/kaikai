# A zero-use pattern binder is elided to `_`, so the bare ctor rebuild
# stays visible to the reuse recogniser: `BErr(e) -> BVal(...)` reuses
# the matched cell in place AND stays ledger-balanced.

type B = BVal([Int]) | BErr([Int])

fn flip(r: B) : B = match r {
  BVal(v) -> BErr(v)
  BErr(e) -> BVal([7])
}

fn spin(n: Int, acc: Int) : Int =
  if n == 0 { acc } else {
    match flip(BErr([1, 2])) {
      BVal(_) -> spin(n - 1, acc + 1)
      BErr(_) -> spin(n - 1, acc)
    }
  }

fn main() : Unit / Stdout = {
  Stdout.print("s=#{spin(1500, 0)}")
}
