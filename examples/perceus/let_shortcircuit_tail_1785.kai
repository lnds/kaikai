# A block-let binder whose single consuming read sits in the block
# tail's short-circuited `and`-RHS: with the RHS skipped on every call,
# the post-tail drop must pay the binding's birth ref.

fn total(y: [Int]) : Int = match y {
  [h, ...t] -> h + total(t)
  []        -> 0
}

fn build(n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { build(n - 1, [n, ...acc]) }

fn probe(flag: Bool) : Int = {
  let v = build(10, [])
  if flag and total(v) > 0 { 1 } else { 0 }
}

fn loop_it(n: Int, acc: Int) : Int =
  if n == 0 { acc } else { loop_it(n - 1, acc + probe(false)) }

fn main() : Unit / Stdout = {
  Stdout.print("r=#{loop_it(300, 0)}")
}
