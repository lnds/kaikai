# A fn that shares its name with the core fn it calls is not calling itself.

fn filter(xs: [String], keep: String) : [String] = {
  let tmp = ["t#{1}", "u#{2}"]
  let n = list.length(tmp)
  if n > 5 { tmp } else { list.filter(xs, (s) => s != keep) }
}

fn map(xs: [String], suffix: String) : [String] =
  if list.length(xs) == 0 { [] } else { list.map(xs, (s) => string_concat(s, suffix)) }

fn reverse(xs: [String], extra: String) : [String] = match xs {
  [] -> [extra]
  [h, ...t] -> {
    let e2 = string_concat(extra, h)
    list.reverse([e2, ...t])
  }
}

fn count[T](xs: [T], acc: Int) : Int = match xs {
  [] -> acc
  [_, ...t] -> count(t, acc + 1)
}

fn drop_even(xs: [String], acc: [String]) : [String] = match xs {
  [] -> list.reverse(acc)
  [h, ...t] -> drop_odd(t, [h, ...acc])
}

fn drop_odd(xs: [String], acc: [String]) : [String] = match xs {
  [] -> list.reverse(acc)
  [_, ...t] -> drop_even(t, acc)
}

fn main() : Unit / Stdout = {
  let xs = ["a#{1}", "b#{2}", "c#{3}", "d#{4}"]
  Stdout.print(string_join(filter(xs, "b2"), ","))
  Stdout.print(string_join(map(xs, "!"), ","))
  Stdout.print(string_join(reverse(xs, "z#{9}"), ","))
  Stdout.print("#{count(xs, 0)} #{count([1, 2], 0)}")
  Stdout.print(string_join(drop_even(xs, []), ","))
  Stdout.print(string_join(xs, ","))
}
