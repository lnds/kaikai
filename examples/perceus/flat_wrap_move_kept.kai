# A flat arm whose rebuild nests a cell of the scrutinee's arity moves that
# cell into the scrutinee, keeping the slots it repeats, and builds the outer
# cell from the caller's donated shell: same and other constructors, a changed
# key, a dropped child, on unique and on shared trees.

type Color = Red | Black

type T = Node(Color, T, Int, T) | Twin(Color, T, Int, T) | Tip

fn wrap(l: T, k: Int, r: T) : T = match l {
  Node(Black, Node(Red, a, x, b), y, c) -> Node(Red, Node(Black, a, x, b), y, Node(Black, c, k, r))
  Node(Red, a, x, b) -> Node(Black, Twin(Red, a, x, b), k, r)
  Node(_, a, x, b) -> Node(Red, Node(Black, a, k, b), x, r)
  Twin(c, a, x, _) -> Twin(Black, Node(c, a, x, Tip), k, r)
  Tip -> Node(Black, Tip, k, r)
}

fn ins(t: T, k: Int) : T = match t {
  Node(c, l, x, r) -> if k < x { wrap(ins(l, k), x, r) } else { Node(c, l, x, ins(r, k)) }
  Twin(c, l, x, r) -> if k < x { Twin(c, ins(l, k), x, r) } else { wrap(ins(r, k), x, l) }
  Tip -> Node(Red, Tip, k, Tip)
}

fn top(t: T) : T = match t {
  Node(_, l, x, r) -> Node(Black, l, x, r)
  Twin(_, l, x, r) -> Twin(Red, l, x, r)
  Tip -> Tip
}

fn sig(t: T, acc: Int) : Int = match t {
  Node(Red, l, x, r) -> sig(r, (sig(l, acc) * 3 + x) % 1000003)
  Node(Black, l, x, r) -> sig(r, (sig(l, acc) * 7 + x) % 1000003)
  Twin(Red, l, x, r) -> sig(r, (sig(l, acc) * 11 + x) % 1000003)
  Twin(Black, l, x, r) -> sig(r, (sig(l, acc) * 13 + x) % 1000003)
  Tip -> acc
}

fn fill(t: T, s: Int, n: Int) : T =
  if n <= 0 { t } else { fill(top(ins(t, s % 997)), (s * 31 + 17) % 10007, n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("unique: #{sig(fill(Tip, 5, 300), 0)}")
  let base = fill(Tip, 11, 200)
  let grown = fill(base, 3, 100)
  Stdout.print("shared: #{sig(base, 0)} #{sig(grown, 0)} #{sig(fill(grown, 7, 50), 0)} #{sig(grown, 0)}")
}
