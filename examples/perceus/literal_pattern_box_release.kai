# Literal patterns whose literal is a boxed value. The test compares without
# consuming either side, so the String or Real it materialises for the
# comparison must be released: over a whole value, a Real ctor slot, a record
# field, a list head, and a String ctor slot, on the arms that miss as well
# as the one that matches.

type P = P(Int, Real)
type S = S(String, Int)
type Q = { a: Int, r: Real }

fn real_whole(x: Real) : Int = match x {
  0.5 -> 1
  _   -> 2
}

fn str_whole(s: String) : Int = match s {
  "a" -> 1
  "b" -> 2
  _   -> 3
}

fn real_slot(p: P) : Int = match p {
  P(7, _)   -> 1
  P(_, 0.5) -> 2
  _         -> 3
}

fn real_field(q: Q) : Int = match q {
  { a: _, r: 0.5 } -> 1
  _                -> 2
}

fn real_head(xs: [Real]) : Int = match xs {
  [0.5, ..._] -> 1
  _           -> 2
}

fn str_slot(p: S) : Int = match p {
  S("a", _) -> 1
  _         -> 2
}

fn main() = {
  let s = "a" ++ int_to_string(1)
  let zz = "zz"
  let hit = S("a", 1)
  let miss = S(s, 1)
  let q_hit = Q { a: 1, r: 0.5 }
  let q_miss = Q { a: 1, r: 2.0 }
  let xs = [0.5, 1.0]
  let ys = [2.0]
  print("real_whole: " ++ int_to_string(real_whole(0.5) + real_whole(1.5)))
  print("str_whole: " ++ int_to_string(str_whole(s) + str_whole(zz)))
  print("real_slot: " ++ int_to_string(real_slot(P(7, 0.5)) + real_slot(P(1, 0.5)) + real_slot(P(1, 2.0))))
  print("real_field: " ++ int_to_string(real_field(q_hit) + real_field(q_miss)))
  print("real_head: " ++ int_to_string(real_head(xs) + real_head(ys)))
  print("str_slot: " ++ int_to_string(str_slot(hit) + str_slot(miss)))
}
