# A single consuming read in a self-call argument's short-circuited
# `and`-RHS: with the RHS skipped on every iteration, each element's
# birth ref still needs a payer.

fn total(y: [Int]) : Int = match y {
  [h, ...t] -> h + total(t)
  []        -> 0
}

fn build(n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { build(n - 1, [n, ...acc]) }

fn count_all(xs: [[Int]], acc: Int, flag: Bool) : Int = match xs {
  []        -> acc
  [h, ...t] -> count_all(t, acc + 1, flag and total(h) > 0)
}

fn mk(n: Int, acc: [[Int]]) : [[Int]] =
  if n == 0 { acc } else { mk(n - 1, [build(3, []), ...acc]) }

fn main() : Unit / Stdout = {
  let c = count_all(mk(600, []), 0, false)
  Stdout.print("c=#{c}")
}
