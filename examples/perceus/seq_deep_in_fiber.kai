# A chain of stages deeper than a spawned fiber's stack holds. Each stage
# reads the one before it from inside its own thunk, so the read nests
# one activation per stage and carries on over as many stack segments as
# the chain needs. A trap that deep leaves through every one of them.

import actor
import spawn
import seq

fn deepen(s: Seq[Int], n: Int) : Seq[Int] = if n == 0 { s } else { deepen(s | (x) => x + 1, n - 1) }

fn bump(s: Seq[Int]) : Seq[Int] = match s {
  []           -> lazy []
  [x, ...rest] -> lazy [x + 1, ...bump(rest)]
}

fn stack(s: Seq[Int], n: Int) : Seq[Int] = if n == 0 { s } else { stack(bump(s), n - 1) }

# Every stage is held twice, by the stage above it and by `held`: a
# filter stage that is shared does not merge into the one above it.
fn filters(s: Seq[Int], n: Int, held: [Seq[Int]]) : [Seq[Int]] =
  if n == 0 { [s, ...held] }
  else { filters(s |? (x) => x % 7 != 0, n - 1, [s, ...held]) }

fn through_shared(n: Int) : Int = {
  let all = filters(lazy [1..], n, [])
  let top = match all {
    [t, ..._] -> nth(t, 5)
    []        -> 0
  }
  top + length(all)
}

fn twice(depth: Int) : Int = {
  let s = deepen(lazy [0..], depth)
  nth(s, 1) + nth(s, 1)
}

fn worker(parent: Pid[String], d: Int) : Unit / Actor[String] + Link = {
  Link.link(parent)
  let _ = nth(deepen(lazy [100 / d], 400), 0)
  ()
}

fn supervise(k: Int, n: Int) : Int / Actor[String] + Spawn + Link = if k == n { 0 } else {
  let me = Actor.self()
  let _ = spawn.spawn(() => with_mailbox { worker(me, k - k) })
  let _ = Actor.receive()
  1 + supervise(k + 1, n)
}

fn main() : Int / Console + Spawn + Link = {
  let rs = nursery { n ->
    let mapped = n.spawn(() => twice(3000))
    let tails = n.spawn(() => nth(stack(lazy [0..], 2000), 5))
    let filtered = n.spawn(() => through_shared(2000))
    [n.await(mapped), n.await(tails), n.await(filtered)]
  }
  Stdout.print("#{rs}")
  let trapped = with_mailbox {
    let _ = spawn.set_trap_exit(true)
    supervise(0, 2)
  }
  Stdout.print("trapped workers: " ++ int_to_string(trapped))
  0
}
