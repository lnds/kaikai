# A `match` whose arms are all raw scalars leaves its binder raw, so nothing
# tracks a box behind it: the binder must take the scalar itself. The binder
# is a `let`, the slot a fn's result waits in across its exit drops, or the
# slot an argument of a self tail call waits in.

type Box = { w: Real, path: String }

fn open_box(path: String) : Result[Box, String] =
  if string_length(path) > 0 { Ok(Box { w: 3.5, path: path }) } else { Err("no") }

fn pick(n: Int) : String = if n % 2 == 0 { "" } else { "box" }

fn weigh(b: Box, path: String) : Real = b.w + int_to_real(string_length(path))

fn far(b: Box, path: String) : Int = 4611686018427387000 + string_length(b.path) + string_length(path)

fn narrow(b: Box, path: String) : Int32 = int_to_int32(string_length(b.path) + string_length(path))

fn wide(b: Box, path: String) : Int128 = int_to_int128(string_length(b.path) + string_length(path))

fn tail_real(path: String) : Real = match open_box(path) {
  Err(_) -> 1.5
  Ok(b)  -> weigh(b, path)
}

fn tail_far(path: String) : Int = match open_box(path) {
  Err(_) -> -4611686018427387999
  Ok(b)  -> far(b, path)
}

fn tail_narrow(path: String) : Int32 = match open_box(path) {
  Err(_) -> 7i32
  Ok(b)  -> narrow(b, path)
}

fn tail_wide(path: String) : Int128 = match open_box(path) {
  Err(_) -> 7i128
  Ok(b)  -> wide(b, path)
}

fn let_real(path: String) : Real {
  let v = match open_box(path) {
    Err(_) -> 1.5
    Ok(b)  -> weigh(b, path)
  }
  v * 2.0
}

fn let_far(path: String) : Int {
  let v = match open_box(path) {
    Err(_) -> -4611686018427387999
    Ok(b)  -> far(b, path)
  }
  if v > 0 { 1 } else { 0 }
}

fn far_hit(path: String) : Int = if tail_far(path) > 0 { 1 } else { 0 }

fn narrow_hit(path: String) : Int = int32_to_int(tail_narrow(path))

fn wide_hit(path: String) : Int = int128_to_int(tail_wide(path))

fn loop_tails(n: Int, acc: Real) : Real {
  if n == 0 { acc } else { loop_tails(n - 1, acc + tail_real(pick(n))) }
}

fn loop_ints(n: Int, acc: Int) : Int {
  if n == 0 { acc } else {
    let p = pick(n)
    loop_ints(n - 1, acc + far_hit(p) + narrow_hit(p) + wide_hit(p) + let_far(p))
  }
}

fn loop_lets(n: Int, acc: Real) : Real {
  if n == 0 { acc } else { loop_lets(n - 1, acc + let_real(pick(n))) }
}

fn loop_body(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = pick(n)
    let v = match open_box(p) {
      Err(_) -> 0.5
      Ok(b)  -> weigh(b, p)
    }
    loop_body(n - 1, acc + v)
  }
}

fn loop_arms(n: Int, acc: Real) : Real {
  if n == 0 { acc } else {
    let p = pick(n)
    match open_box(p) {
      Err(_) -> loop_arms(n - 1, acc + 0.5)
      Ok(b)  -> loop_arms(n - 1, acc + weigh(b, p))
    }
  }
}

fn main() {
  print(real_to_string(loop_tails(200, 0.0)))
  print(int_to_string(loop_ints(200, 0)))
  print(real_to_string(loop_lets(200, 0.0)))
  print(real_to_string(loop_body(200, 0.0)))
  print(real_to_string(loop_arms(200, 0.0)))
}
