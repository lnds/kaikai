# A `..._` rest pattern desugars to a synthesized `__list_rest_*__`
# binder: bound and increfed (double-underscore names are compiler-
# internal, never elided), but with zero uses. In a match whose arm is
# not a self-tail-call there is no goto ledger to pay the birth ref, so
# the unreleased ref pins the entire remaining tail per call unless the
# arm-drop pass plants a payer.
type Pair = { a: Int, b: String }

fn peek(t: [Pair]) : Int = match t {
  [y, ..._] -> y.a + y.a
  _         -> 0
}

fn walk(xs: [Pair], acc: Int) : Int = match xs {
  []        -> acc
  [h, ...t] -> {
    let w = peek(t)
    walk(t, acc + h.a + w - w)
  }
}

fn build(n: Int, acc: [Pair]) : [Pair] =
  if n == 0 { acc } else { build(n - 1, [Pair { a: n, b: "p_#{n}" }, ...acc]) }

fn main() : Unit / Stdout = {
  let total = walk(build(3000, []), 0)
  Stdout.print("total=#{total}")
}
