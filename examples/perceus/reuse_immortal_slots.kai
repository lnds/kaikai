# A reuse target whose slots are all immortal must not be interned: an
# interned cell has a saturated refcount, never passes the uniqueness check,
# and the reuse arm allocates instead of rewriting in place. Both backends
# must report the same ledger here.

type T = Node(T, T) | Leaf

fn build(d: Int) : T = if d == 0 { Leaf } else { Node(build(d - 1), build(d - 1)) }

fn mirror(t: T) : T = match t {
  Node(l, r) -> Node(mirror(r), mirror(l))
  Leaf       -> Leaf
}

fn count(t: T) : Int = match t {
  Node(l, r) -> 1 + count(l) + count(r)
  Leaf       -> 0
}

fn mirror_n(t: T, n: Int) : T = if n == 0 { t } else { mirror_n(mirror(t), n - 1) }

fn keep(o: Option[Unit]) : Option[Unit] = match o {
  Some(u) -> Some(u)
  None    -> None
}

fn keep_n(o: Option[Unit], n: Int) : Option[Unit] = if n == 0 { o } else { keep_n(keep(o), n - 1) }

fn main() : Unit / Console = {
  println("#{count(mirror_n(build(6), 5))}")
  match keep_n(Some(()), 1000) {
    Some(_) -> println("some")
    None    -> println("none")
  }
}
