# A callee that sends its function argument to an actor does not launder the capture.

effect Cell { put(n: Int) : Unit }

fn tell(f: (Int) -> Unit, p: Pid[(Int) -> Unit]) : Unit / Actor[Int] = Actor.send(p, f)

fn mk(c: Cell, p: Pid[(Int) -> Unit]) : Unit / Actor[Int] = tell((n) => c.put(n), p)

fn main() : Unit = ()
