# A pure higher-order function that returns its argument does not launder the capture.

effect Cell { put(n: Int) : Unit }

type Box = { put: (Int) -> Unit }

fn wrap(f: (Int) -> Unit) : Box = Box { put: f }

fn mk(c: Cell) : Box = wrap((n) => c.put(n))

fn main() : Unit = {
  let b = handle { mk(a) } with Cell as a { put(n, resume) -> resume(()) }
  b.put(1)
}
