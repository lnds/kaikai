# A callee that spawns its function argument does not launder the capture.

import spawn

effect Cell { put(n: Int) : Unit }

fn run(f: (Int) -> Unit) : Int / Spawn =
  nursery { n ->
    let h = n.spawn(() => f(1))
    n.await(h)
    0
  }

fn mk(c: Cell) : Int / Spawn = run((n) => c.put(n))

fn main() : Unit = ()
