effect Cell { put(n: Int) : Unit  get() : Int }

fn call1(f: (Int) -> Unit / e, x: Int) : Unit / e = f(x)

fn bump(c: Cell) : Unit = call1((n) => c.put(n), 1)

fn each_put(c: Cell, xs: [Int]) : Unit = xs |> each((x) => c.put(x))

fn nested(c: Cell) : Unit = call1((n) => call1((m) => c.put(n + m), 1), 2)

fn main() : Unit / Stdout = {
  let total = handle {
    bump(a)
    each_put(a, [4, 5])
    nested(a)
    a.get()
  } with Cell as a {
    put(n, resume) -> resume(())
    get(resume)    -> resume(42)
  }
  Stdout.print("total=#{total}")
}
