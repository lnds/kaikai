# A closure over a capability parameter cannot escape inside a record.

effect Cell { put(n: Int) : Unit }

type Box = { put: (Int) -> Unit }

fn mk(c: Cell) : Box = Box { put: (n) => c.put(n) }

fn main() : Unit = {
  let b = handle { mk(a) } with Cell as a { put(n, resume) -> resume(()) }
  b.put(1)
}
