# A callee that stores its function argument in an array the caller keeps does not launder the capture.

effect Cell { put(n: Int) : Unit }

fn stash(f: (Int) -> Unit, box: Array[(Int) -> Unit]) : Unit / Mutable = { box[0] := f }

fn mk(c: Cell, box: Array[(Int) -> Unit]) : Unit / Mutable = stash((n) => c.put(n), box)

fn main() : Unit = ()
