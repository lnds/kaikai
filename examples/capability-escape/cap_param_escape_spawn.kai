# A closure over a capability parameter cannot be handed to a fiber that outlives the handler.

import spawn

effect Cell { put(n: Int) : Unit }

fn start(c: Cell) : Int / Spawn =
  nursery { n ->
    let f = n.spawn(() => c.put(1))
    n.await(f)
    0
  }

fn main() : Int / Spawn = handle { start(a) } with Cell as a { put(n, resume) -> resume(()) }
