import os.process
import os.env
import os.args

fn code_free(e: String) : String = match string.split_once(e, " (os error ") {
  Some((head, _)) -> "#{head} [code]"
  None -> e
}

fn main() : Int / Stdout + Process + Env {
  if list.contains(args.argv(), "child") { child() } else { parent() }
}

fn child() : Int / Process + Env {
  ignore(process.start("no-such-command-xyz", ["a"]))
  ignore(process.start_piped("no-such-command-xyz", ["a"]))
  ignore(process.start_in_group("no-such-command-xyz", ["a"], false, false, false))
  0
}

fn parent() : Int / Stdout + Process + Env {
  match process.start("no-such-command-xyz", ["a"]) {
    Ok(_) -> Stdout.print("start: unexpectedly ok")
    Err(e) -> Stdout.print("start: #{code_free(e)}")
  }
  match process.start_piped("no-such-command-xyz", ["a"]) {
    Ok(_) -> Stdout.print("start_piped: unexpectedly ok")
    Err(e) -> Stdout.print("start_piped: #{code_free(e)}")
  }
  match process.start_in_group("no-such-command-xyz", ["a"], false, false, false) {
    Ok(_) -> Stdout.print("start_group: unexpectedly ok")
    Err(e) -> Stdout.print("start_group: #{code_free(e)}")
  }
  match process.start("/bin/sh", ["-c", "exit 0"]) {
    Err(e) -> Stdout.print("spawn FAIL: #{e}")
    Ok(c) -> {
      ignore(process.wait(c))
      match process.kill(c, 0) {
        Ok(_) -> Stdout.print("kill: ok")
        Err(e) -> match string.drop_prefix(e, "pid #{c.pid}: ") {
          Some(rest) -> Stdout.print("kill: subject ok: #{code_free(rest)}")
          None -> Stdout.print("kill: subject WRONG #{e}")
        }
      }
    }
  }
  match env.set("A=B", "x") {
    Ok(_) -> Stdout.print("set: ok")
    Err(e) -> Stdout.print("set: #{code_free(e)}")
  }
  match process.pipe_errs(args.program_name(), ["child"]) {
    Err(e) -> Stdout.print("self FAIL: #{e}")
    Ok(c) -> {
      ignore(process.read_stdout(c))
      let err = process.read_stderr(c)
      ignore(process.wait(c))
      match err {
        Ok(text) -> Stdout.print("failed exec stderr bytes: #{string.byte_length(text)}")
        Err(e) -> Stdout.print("stderr FAIL: #{e}")
      }
    }
  }
  0
}
