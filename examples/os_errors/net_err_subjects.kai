import net.tcp
import net.dns
import net.udp

fn show[t](label: String, subject: String, r: Result[t, String]) : Unit / Stdout = match r {
  Ok(_) -> Stdout.print("#{label}: ok")
  Err(e) -> match string.split_once(e, ": ") {
    None -> Stdout.print("#{label}: no subject [#{e}]")
    Some((who, rest)) -> {
      let tag = if who == subject { "subject ok" } else { "subject WRONG #{who}" }
      match string.split_once(rest, " (os error ") {
        Some((head, _)) -> Stdout.print("#{label}: #{tag}: #{head} [code]")
        None -> Stdout.print("#{label}: #{tag}: no code")
      }
    }
  }
}

fn main() : Int / Stdout + NetTcp + NetUdp + NetDns {
  show("connect refused", "127.0.0.1:1", NetTcp.connect("127.0.0.1", 1))
  match NetTcp.listen("127.0.0.1", 0) {
    Err(e) -> Stdout.print("listen FAIL: #{e}")
    Ok(l) -> {
      let p = tcp.local_port(l)
      show("listen in use", "127.0.0.1:#{p}", NetTcp.listen("127.0.0.1", p))
    }
  }
  match NetUdp.bind("203.0.113.1", 9) {
    Ok(_) -> Stdout.print("udp bind: ok")
    Err(e) -> Stdout.print(
      "udp bind: subject ok=#{string.starts_with(e, "203.0.113.1:9: ")} code=#{string.contains(e, " (os error ")}"
    )
  }
  match NetDns.resolve("nonexistent.invalid") {
    Ok(_) -> Stdout.print("resolve: ok")
    Err(e) -> Stdout.print(
      "resolve: subject ok=#{string.starts_with(e, "nonexistent.invalid: ")} no code=#{not string.contains(e, "(os error")}"
    )
  }
  0
}
