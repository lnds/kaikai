import money

unit m

type Len = Real<m>
type Metre = Real
type Count = Int
type Tag = { id: Int }

fn id_dim[u: Measure](x: Real<u>) : Real<u> = x

fn tagged(t: Tag<m>) : Tag<m> = t

fn main() : Unit / Stdout {
  let a: Int<m> = 3<m>
  let b: Real<m> = 1.5<m>
  let c: Len = 2.0<m>
  let d: Metre<m> = 4.0<m>
  let e: Count<m> = 5<m>
  let s: money.Money[String]<USD> = money.of("ten")
  println(money.amount(s))
  println("#{a} #{b} #{id_dim(c)} #{d} #{e}")
}
