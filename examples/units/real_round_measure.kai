import math.real

unit m

unit s

fn apply(f: (Real) -> Real, x: Real) : Real = f(x)

fn main() : Unit / Stdout = {
  let v: Real<m/s> = 100.0<m> / 9.58<s>
  println("#{real.round_to(v, 2)}")
  println("#{real.trunc(3.7<m>)} #{real.floor(-3.2<m>)} #{real.ceil(3.2<m>)}")
  println("#{real.round(2.5<m>)} #{real.round_half_even(2.5<m>)} #{real.round_half_even(3.5<m>)}")
  println("#{real.trunc(-3.7)} #{real.floor(-3.2)} #{real.ceil(3.2)} #{real.round(-2.5)} #{real.round_half_even(2.5)}")
  println("#{apply(real.floor, 4.9)} #{apply(real.round, 4.5)}")
  println("#{real.round_to(3.14159, 3)} #{real.round_to(3.6, 0)} #{real.round_to(1234.0, -2)} #{real.round_to(1250.0<m>, -2)}")
}
