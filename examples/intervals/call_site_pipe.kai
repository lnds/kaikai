# The elision report sees a pipe, a placeholder, an applied lambda and a
# constant argument as the call each one spells.
const TWO : Int = 2

fn half(a: Int, b: Int) : Int requires b != 0 { a / b }

fn main() : Int = {
  let p = 10 |> half(2)
  let h = 2 |> half(10, _)
  let l = 2 |> (x => half(10, x))
  let c = half(10, TWO)
  p + h + l + c
}
