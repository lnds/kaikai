fn grow(s: String, k: Int) : String =
  if k == 0 { s }
  else { grow(s ++ s, k - 1) }

fn show_split(s: String, sep: String) : String = {
  let parts = string_split(s, sep)
  "#{list_length(parts)}:[" ++ string_join(parts, "|") ++ "]"
}

fn contains_str(s: String, sub: String) : String =
  if string_contains(s, sub) { "y" } else { "n" }

fn main() : Unit / Stdout = {
  let long_a = grow("a", 16)
  let hay = long_a ++ "b" ++ long_a
  Stdout.print(contains_str(hay, "ab") ++ contains_str(hay, "ba") ++ contains_str(hay, "aab"))
  Stdout.print(contains_str(hay, "abb") ++ contains_str(hay, "c") ++ contains_str(long_a, "ab"))
  Stdout.print(contains_str(hay, "") ++ contains_str("", "") ++ contains_str("", "a"))
  Stdout.print(contains_str("abc", "abcd") ++ contains_str("abc", "abc") ++ contains_str("abc", "c"))
  Stdout.print(contains_str("aaab", "aab") ++ contains_str("aaab", "aaab") ++ contains_str("ababac", "abac"))
  Stdout.print(contains_str("héllo wörld", "ö") ++ contains_str("héllo", "l\u{e9}"))
  Stdout.print(show_split("a,b,c", ","))
  Stdout.print(show_split(",a,,b,", ","))
  Stdout.print(show_split("", ","))
  Stdout.print(show_split("abc", ""))
  Stdout.print(show_split("abc", "abcd"))
  Stdout.print(show_split("abc", "abc"))
  Stdout.print(show_split("aaaa", "aa"))
  Stdout.print(show_split("aaaaa", "aa"))
  Stdout.print(show_split("ababab", "bab"))
  Stdout.print(show_split("one<>two<>three", "<>"))
  Stdout.print(show_split("<>x<>", "<>"))
  Stdout.print(show_split("日本語、日本", "、"))
  Stdout.print("#{list_length(string_split(hay, "b"))}")
  Stdout.print("#{list_length(string_split(hay, "ab"))}")
  Stdout.print("#{list_length(string_split(hay, "aa"))}")
}
