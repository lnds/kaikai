# Machine-readable reporting: a mix of passing and failing blocks, so
# `--json` is pinned on both statuses and `--only` has a subset to pick.
# A block prints to stdout as well — the report must not interleave with
# it, or a consumer cannot parse the stream.

fn triple(n: Int) : Int = n * 3

test "triples" {
  assert triple(3) == 9
}

test "prints while passing" {
  Stdout.print("chatter from a test body")
  assert triple(0) == 0
}

test "this one fails" {
  assert triple(2) == 7
}

test "escapes: \"quoted\" and a tab\there" {
  assert triple(1) == 3
}
