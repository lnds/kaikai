import spawn

fn boom() : Int / Cancel = Cancel.raise()

fn child_cancel() : Int / Spawn + Cancel {
  nursery { n ->
    let r = n.spawn(() => Cancel.raise())
    n.await(r)
  }
}

test "crash" {
  assert boom() == 1
}

test "nursery re-raises a child's cancellation" {
  assert child_cancel() == 1
}

test "after" {
  assert 1 == 2
}

test "passes" {
  assert 1 == 1
}
