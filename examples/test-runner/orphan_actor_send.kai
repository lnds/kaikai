# An actor that outlives the mailbox it answers to must not end the test
# binary when it speaks: the next test still runs and the suite reports.

import actor
import time

type Msg = | Ping

fn late(parent: Pid[Msg]) : Unit / Actor[Msg] + Clock {
  sleep(millis(50))
  Actor.send(parent, Ping)
}

test "an actor outlives the mailbox it answers to" {
  with_mailbox {
    let me = Actor.self()
    let _child = spawn_actor(() => late(me))
    ()
  }
  assert true
}

test "the suite keeps running after the orphan speaks" {
  sleep(millis(150))
  assert 1 + 1 == 2
}
