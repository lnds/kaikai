pub fn add(x: Int, y: Int) : Int = x + y

pub fn classify(n: Int) : String =
  match n {
    0 -> "zero"
    _ if n < 0 -> "negative"
    _ -> "positive"
  }

pub fn total(xs: [Int]) : Int {
  let doubled = xs | (x => x * 2)
  doubled |> list.foldl(0, (a, b) => add(a, b))
}

pub fn unused() : Int = 42
