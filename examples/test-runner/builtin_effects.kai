# A `test` body has no row of its own and absorbs every default-handled
# builtin effect. Each block performs one directly, or through a helper
# whose row names it; none may crash or report the effect unhandled.

fn round_trip(path: String, text: String) : String / File = {
  match File.write_file(path, text) {
    Err(e) -> e
    Ok(_) -> match File.read_file(path) {
      Ok(s) -> s
      Err(e) -> e
    }
  }
}

test "Stdout" {
  Stdout.print("stdout from a test body")
  assert true
}

test "Stderr" {
  Stderr.eprint("stderr from a test body")
  assert true
}

test "File through a helper" {
  assert round_trip("issue_2022_test_body.tmp", "hola") == "hola"
}

test "Env" {
  assert Env.get("KAI_ISSUE_2022_UNSET") == None
}

test "File directly" {
  assert File.read_file("issue_2022_no_such_file.tmp") != Ok("")
}
