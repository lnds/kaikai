# A failed assertion leaves its test body while the body still owns a list
# and a string; the native backend releases both on the way out.

fn tally(xs: [Int], s: String) : Int = list_length(xs) + string_length(s)

test "fails holding values 0" {
  let xs = [0, 1, 2]
  let s = "case " ++ int_to_string(0)
  assert list_length(xs) == 10
  assert tally(xs, s) > 0
}

test "fails holding values 1" {
  let xs = [1, 2, 3]
  let s = "case " ++ int_to_string(1)
  assert list_length(xs) == 11
  assert tally(xs, s) > 0
}

