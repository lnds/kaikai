# Builtins lowered in place are usable as values: bound, passed to a
# higher-order function, or stored in a record.

type Ops = { combine: (Int, Int) -> Int, flip: (Int) -> Int }

fn apply2(f: (Int, Int) -> Int, a: Int, b: Int) : Int = f(a, b)

fn main() : Unit / Stdout = {
  let x = bit_xor
  let a = bit_and
  let o = bit_or
  let n = bit_not
  let sh = bit_shl
  let t = bit_test
  println("xor=#{[1, 2] |> foldl(0, x)} and=#{apply2(a, 12, 10)} or=#{[1, 2, 4] |> foldl(0, o)}")
  println("not=#{[0, 5] |> map(n)} shl=#{apply2(sh, 1, 4)} test=#{t(5, 2)}")
  let ops = Ops { combine: bit_xor, flip: bit_not }
  println("rec=#{(ops.combine)(6, 3)} #{(ops.flip)(0)}")
}
