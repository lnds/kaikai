# A handler clause that reads a scalar bound outside the `handle`. The op
# clause compiles to a separate function that receives its captures through a
# boxed env slot, so a captured binding must stay boxed even when its other
# uses are raw arithmetic.

effect EI { geti() : Int }
effect ER { getr() : Real }
effect EM { ask() : String }

fn cap_int(seed: Int) : Int = {
  let base = seed * 2 + 1
  let doubled = base + base
  let got = handle { EI.geti() + 10 } with EI {
    geti(resume) -> resume(base + 100)
    return(x)    -> x
  }
  got + doubled + base
}

fn cap_real() : Real = {
  let f = 1.5
  let r = handle { ER.getr() } with ER {
    getr(resume) -> resume(f * 2.0)
    return(x)    -> x
  }
  r + f
}

fn cap_mixed(flag: Bool, msg: String) : String = {
  let n = 40 + 2
  let ok = flag
  handle { EM.ask() } with EM {
    ask(resume) -> if ok { resume("#{msg}-#{n}") } else { resume("no") }
    return(x)   -> x
  }
}

fn main() : Unit / Stdout = {
  Stdout.print("int=#{cap_int(3)}")
  Stdout.print("real=#{cap_real()}")
  Stdout.print("mixed=#{cap_mixed(true, "hi")}")
  Stdout.print("mixed_off=#{cap_mixed(false, "hi")}")
}
