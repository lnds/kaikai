# Functions whose only exit is a self tail call: the body never produces a
# value, so the native backend must not return a placeholder of the wrong
# type. Raw returns (Int, Bool, Real) and boxed ones (String, Unit, a record),
# plus mutual recursion, all compile; `count` runs and leaves via `exit`.
type P = { x: Int, y: Int }

fn spin_i(n: Int) : Int = spin_i(n + 1)
fn spin_b(n: Int) : Bool = spin_b(n + 1)
fn spin_r(n: Real) : Real = spin_r(n + 1.0)
fn spin_s(s: String) : String = spin_s(s ++ "a")
fn spin_u(n: Int) : Unit = spin_u(n + 1)
fn spin_p(p: P) : P = spin_p(P { x: p.x + 1, y: p.y })
fn mut_a(n: Int) : Int = mut_b(n + 1)
fn mut_b(n: Int) : Int = mut_a(n + 1)

fn count(n: Int) : Int / Process = {
  if n == 1000000 { exit(42) } else { () }
  count(n + 1)
}

fn main() : Unit / Process = {
  let _ = count(0)
  ()
}
