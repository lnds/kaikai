# A match arm combining a list pattern with a guard. The guard chain hands
# its fail label to the list cell walk directly: head/tail/rest bind as the
# walk tests, a failing guard falls through to the next arm, and an element
# literal must still be tested — shape alone must not select the arm.

fn sum(xs: [Int]) : Int = match xs {
  []        -> 0
  [h, ...t] -> h + sum(t)
}

fn describe(xs: [Int]) : String = match xs {
  [x, ...t] if x > 10 -> "big #{x} rest_sum #{sum(t)}"
  [x, ..._] if x < 0  -> "neg #{x}"
  [x, ..._]           -> "small #{x}"
  []                  -> "empty"
}

fn zeros(xs: [Int], lim: Int) : String = match xs {
  [0, ...t] if sum(t) > lim -> "zero-heavy"
  [0, ..._]                 -> "zero-light"
  [x, ...t] if x == sum(t)  -> "balanced"
  [_, ..._]                 -> "other"
  []                        -> "empty"
}

fn pair_kind(xs: [Int]) : String = match xs {
  [a, b] if a == b         -> "twins"
  all @ [a, ..._] if a > 0 -> "pos sum #{sum(all)}"
  _                        -> "misc"
}

fn main() : Unit / Stdout = {
  Stdout.print(describe([20, 1, 2]))
  Stdout.print(describe([2, 1]))
  Stdout.print(describe([-5]))
  Stdout.print(describe([]))
  Stdout.print(zeros([0, 1, 2], 2))
  Stdout.print(zeros([0, 1], 5))
  Stdout.print(zeros([3, 1, 2], 9))
  Stdout.print(zeros([4, 1], 0))
  Stdout.print(zeros([], 0))
  Stdout.print(pair_kind([2, 2]))
  Stdout.print(pair_kind([1, 2, 3]))
  Stdout.print(pair_kind([-1]))
  Stdout.print(pair_kind([]))
}
