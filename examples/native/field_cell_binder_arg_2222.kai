# A cell binder projected out of a tuple field is passed on as an argument
# while the caller still holds the list; the list must survive intact.

fn prefix(big: [Int], small: [Int]) : Bool = match (big, small) {
  (_, [])                  -> true
  ([], _)                  -> false
  ([x, ...xs], [y, ...ys]) -> x == y and prefix(xs, ys)
}

fn run(big: [Int], small: [Int], n: Int, acc: Int) : Int =
  if n == 0 { acc } else { run(big, small, n - 1, if prefix(big, small) { acc + 1 } else { acc }) }

fn main() : Unit / Stdout = {
  let big = [1, 2, 3, 4, 5]
  Stdout.print("hits=#{run(big, [1, 2, 9], 20000, 0)} again=#{run(big, [1, 2], 10, 0)} len=#{length(big)}")
}
