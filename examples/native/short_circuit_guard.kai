# `and` / `or` must short-circuit: the guard on the left decides whether the
# right runs at all. Lowering them to a strict prim materialises both operands,
# so `f != 0 and n % f == 0` divides by zero on the very path the guard exists
# to prevent — a trap the C backend hid behind its `?:` and native did not.

fn get(i: Int) : Int = if i == 0 { 0 } else { 3 }

fn safe_mod(n: Int, f: Int) : Bool = f != 0 and n % f == 0

fn safe_div(n: Int, f: Int) : Bool = f == 0 or n / f > 0

fn main() : Unit / Stdout = {
  let zero = get(0)
  let three = get(1)
  Stdout.print("and_guard=#{safe_mod(6, zero)}")
  Stdout.print("and_taken=#{safe_mod(6, three)}")
  Stdout.print("or_guard=#{safe_div(6, zero)}")
  Stdout.print("or_taken=#{safe_div(6, three)}")
}
