# A raw comparison dispatches on its OPERAND type, not its result type: the
# result is always Bool, so routing by it collapses every family into one.
# Bool and Char operands live in an i32 register like Byte; reading them at
# the Real slot emits `kaix_real_field` over an i32 and LLVM rejects the
# module. The C oracle cannot see this class — its `(a == b)` is generic over
# scalars, so the native path is the only one that must enumerate the
# families. The Int / Real / Byte cases are here to pin the rungs that
# already worked against a regression that "fixes" Bool by widening the
# Real fallback.
#
# A comparison reaches the raw path only when both operands are raw, which a
# raw param mask supplies — hence `chk(x == y)` rather than a bare `x == y`,
# whose result crosses the box border before the call.

fn chk(ok: Bool) : Bool = ok

fn bool_eq(x: Bool, y: Bool) : Bool = chk(x == y)
fn bool_ne(x: Bool, y: Bool) : Bool = chk(x != y)

fn char_eq(x: Char, y: Char) : Bool = chk(x == y)
fn char_lt(x: Char, y: Char) : Bool = chk(x < y)
fn char_ge(x: Char, y: Char) : Bool = chk(x >= y)

fn int_eq(x: Int, y: Int) : Bool = chk(x == y)
fn int_lt(x: Int, y: Int) : Bool = chk(x < y)
fn real_eq(x: Real, y: Real) : Bool = chk(x == y)
fn u8_eq(x: Byte, y: Byte) : Bool = chk(x == y)

fn main() : Unit / Stdout = {
  Stdout.print("bool_eq=#{bool_eq(true, true)} #{bool_eq(true, false)}")
  Stdout.print("bool_ne=#{bool_ne(true, false)} #{bool_ne(false, false)}")
  Stdout.print("char_eq=#{char_eq('a', 'a')} #{char_eq('a', 'b')}")
  Stdout.print("char_lt=#{char_lt('a', 'b')} #{char_lt('b', 'a')} #{char_lt('a', 'a')}")
  Stdout.print("char_ge=#{char_ge('b', 'a')} #{char_ge('a', 'b')}")
  # Above ASCII the codepoint still orders exactly: a signed i32 compare is
  # only correct because no codepoint sets the sign bit.
  Stdout.print("char_wide=#{char_lt('A', 'a')} #{char_lt('a', 'ñ')} #{char_eq('ñ', 'ñ')}")
  Stdout.print("int=#{int_eq(1, 1)} #{int_lt(1, 2)} #{int_lt(2, 1)}")
  Stdout.print("real=#{real_eq(1.5, 1.5)} #{real_eq(1.5, 2.5)}")
  Stdout.print("byte=#{u8_eq(1u8, 1u8)} #{u8_eq(1u8, 2u8)}")
  # The same comparison inline in an interpolation: literal operands are raw
  # from the start, with no call to carry them there.
  Stdout.print("inline=#{true == true} #{'a' == 'a'} #{'a' < 'b'}")
}
