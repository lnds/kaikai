# A root type spelled like a core type keeps its own row in the runtime
# impl table. `show` passed as a value dispatches at run time by the
# receiver's head tag, so the core `Pair`'s impl must not answer for it.

type Pair = P(Int, Int)

impl Show for Pair {
  fn show(p: Pair) : String = match p {
    P(a, b) -> "P<#{a}|#{b}>"
  }
}

fn main() : Unit / Stdout = {
  Stdout.print(join(map([P(1, 2), P(3, 4)], show), ","))
  Stdout.print(show((5, 6)))
  Stdout.print(show(P(7, 8)))
}
