# `not` on the raw path is a LOGICAL negation, not a bitwise complement.
# The raw-Bool register is an i32 holding 0/1, so `~x` yields -2 for true
# and -1 for false — both nonzero, so every consumer reads them as true and
# `not` silently becomes the identity. The C oracle cannot see this class:
# its `!x` is one generic operator that already normalises to 0/1.
#
# `not` reaches the raw path only from a slot that accepts a raw scalar — a
# call argument at a raw param, or inline in an interpolation. Through a
# `let` binder it crosses the box border first and takes the boxed helper,
# so the `let` rows pin the path that already worked.

fn say(b: Bool) : String = "#{b}"
fn pair(b: Bool, n: Int) : String = "#{b} #{n}"
fn flip(b: Bool) : String = say(not b)
fn neg(b: Bool) : Bool = not b
fn both(a: Bool, b: Bool) : String = "#{not a} #{not b}"

fn main() : Unit / Stdout = {
  Stdout.print("arg=#{say(not true)} #{say(not false)}")
  Stdout.print("arg_paren=#{say((not true))}")
  Stdout.print("arg_multi=#{pair(not true, 1)}")
  Stdout.print("interp=#{not true} #{not false}")
  # `not` over a raw PARAM, not a literal: the operand arrives in the i32
  # register rather than as a constant the builder could fold.
  Stdout.print("param=#{flip(true)} #{flip(false)}")
  Stdout.print("param_interp=#{both(true, false)}")
  # Double negation must return the original, which a bitwise `~` cannot.
  Stdout.print("double=#{say(not (not true))} #{say(not (not false))}")
  # `not` composed with a raw comparison: both operands stay raw throughout.
  Stdout.print("over_cmp=#{say(not (1 == 1))} #{say(not (1 == 2))}")
  # The boxed path: a `let` binder and a boxed-returning fn.
  let x = not true
  Stdout.print("let=#{say(x)} #{neg(true)} #{neg(false)}")
}
