# Builtins taken as values close over their runtime thunk, including one
# whose C entry is spelled differently from its name.

fn call0(f: () -> String) : String = f()

fn main() : Unit / Stdout = {
  let named = call0(core_program_name) == call0(program_name)
  let lens = map(["a", "bb"], string_length)
  Stdout.print("named=#{named} lens=#{lens}")
}
