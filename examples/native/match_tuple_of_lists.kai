# A `match` over a tuple of lists. The tuple sugar makes the scrutinee a
# `Pair`, so each side is a record FIELD whose pattern is a list — the field
# must carry its own length test, and its element/rest names must bind.
#
# Two invariants meet here. The decision tree reads the field BORROWED, since
# the value is shared across the arm chain, so the length test may look but
# not bind; the binds come later off an owning read. Getting that backwards
# hands Perceus references it never acquired, and the arm segfaults on drop.

fn prefix(big: [Int], small: [Int]) : Bool = match (big, small) {
  (_, [])                  -> true
  ([], _)                  -> false
  ([x, ...xs], [y, ...ys]) -> x == y and prefix(xs, ys)
}

fn contains_run(big: [Int], small: [Int]) : Bool = match big {
  []        -> is_empty(small)
  [_, ...t] -> prefix(big, small) or contains_run(t, small)
}

fn label(c: Char, s: [String]) : String = match (s, [c]) {
  ([h, ..._], ['a'])    -> h
  ([_, second, ..._], _) -> second
  ([_], _)              -> "short"
  ([], _)               -> "empty"
}

fn main() : Unit / Stdout = {
  Stdout.print("empty_small=#{prefix([1, 2], [])}")
  Stdout.print("empty_big=#{prefix([], [1])}")
  Stdout.print("prefix=#{prefix([1, 2, 3], [1, 2])}")
  Stdout.print("mismatch=#{prefix([1, 2], [9])}")
  Stdout.print("sublist=#{contains_run([0, 1, 2, 3, 4, 5], [3, 4, 5])}")
  Stdout.print("superlist=#{contains_run([0, 1, 2], [0, 1, 2, 3])}")
  Stdout.print("label_a=#{label('a', ["one", "two"])}")
  Stdout.print("label_b=#{label('b', ["one", "two"])}")
  Stdout.print("label_empty=#{label('a', [])}")
}
