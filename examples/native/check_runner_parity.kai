# `kai check` must print the same per-block lines, summary, and exit code
# on the native backend as on the C oracle: generation draws in the same
# order, so a counterexample names the same iteration, the same inputs,
# and the same shrunk form. The String blocks pass the generated value to
# decref-aware consumers (`string_length`, `!=`) — the body borrows it
# while the runner re-evaluates it across iterations and shrink attempts.

fn double(n: Int) : Int = n * 2

fn main() : Int = 0

check "double of double is times 4" with n: Int {
  double(double(n)) == n * 4
}

check "a string equals itself" with s: String {
  s == s and string_length(s) >= 0
}

check "every int is below 40" with n: Int {
  n < 40
}

check "strings stay short" with s: String {
  s != "" and string_length(s) < 6
}

check "lists and ints together" with a: Int, xs: [String] {
  list_reverse(xs) == xs or a > 100
}
