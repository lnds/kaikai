# A group member sharing a name with an imported function.
#
# The retarget matches a callee by module as well as name: `factorial`
# here is the group's member, while `int.factorial` names the stdlib
# function and must keep calling it. Matching on the bare name alone
# would rewrite the qualified call into the fused entry and silently
# return the wrong answer.

import math.int

fn factorial(n: Int) : Int = if n == 0 { 0 } else { alt(n - 1) }
fn alt(n: Int) : Int = if n == 0 { int.factorial(4) } else { factorial(n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("#{alt(0)} #{factorial(3)} #{alt(3)}")
}
