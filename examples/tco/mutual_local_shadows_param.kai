# A member whose body binds a local named after another member's
# parameter.
#
# The fused entry binds parameter names no source can spell, so
# substituting a member's parameters into them cannot capture a local.
# Reusing one member's parameter names would let `let x` here swallow
# the other member's reads.

fn aa(x: Int) : Int = if x == 0 { 7 } else { bb(x - 1) }

fn bb(y: Int) : Int = {
  let x = 500
  if y == 0 { x } else { aa(y - 1) }
}

fn main() : Unit / Stdout {
  Stdout.print("#{aa(3)} #{bb(3)} #{bb(0)} #{aa(0)}")
}
