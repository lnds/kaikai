# `count` and `walk` take different parameters: the fused entry gives the
# lead its own slots in order and lets `walk` share every slot whose type
# matches, so the fused prototype pins how many slots there are and where.
fn walk(xs: [String], seed: [String], n: Int, acc: Int) : Int =
  match xs {
    [] -> if n == 0 { acc } else { count("x" ++ int_to_string(n), seed, n - 1, acc) }
    [h, ...t] -> walk(t, seed, n, acc + string_length(h))
  }

fn count(s: String, seed: [String], n: Int, acc: Int) : Int =
  walk(seed, seed, n, acc + string_length(s))

fn main() : Unit / Stdout = {
  let seed = ["a", "bb"]
  Stdout.print("acc=#{walk(seed, seed, 3, 0)}")
}
