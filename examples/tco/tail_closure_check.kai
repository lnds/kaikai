# A postcondition that reads only the result is checked once on the final value, by the resolver, so a cycle through a closure under it runs in constant stack.

type Hop = { step: (Hop, Int) -> Int }

fn ck_a(h: Hop, n: Int) : Int
  ensures result >= 0
{
  if n == 0 { 0 } else { h.step(h, n - 1) }
}

fn main() : Unit / Stdout = {
  let h = Hop { step: (self, n) => ck_a(self, n) }
  Stdout.print("#{ck_a(h, 100000000)}")
}
