# Two fused groups with several tail successors per member, tail calls
# that leave a group for a plain function, and a caller outside both.
# The groups' order and each group's member order fix the fused names
# and tags.

fn out(n: Int) : Int = n * 10
fn entry(n: Int) : Int = if n < 0 { 0 } else { p2(n) }

fn p0(n: Int) : Int = if n <= 0 { 0 } else if n % 3 == 0 { p2(n - 1) } else if n % 3 == 1 { p1(n - 1) } else { out(n) }
fn p1(n: Int) : Int = if n <= 0 { 1 } else if n % 2 == 0 { p0(n - 1) } else { p3(n - 1) }
fn q0(n: Int) : Int = if n <= 0 { 5 } else if n % 2 == 0 { q1(n - 1) } else { out(n) }
fn p2(n: Int) : Int = if n <= 0 { 2 } else if n % 5 == 0 { out(n) } else { p3(n - 1) }
fn p3(n: Int) : Int = if n <= 0 { 3 } else if n % 2 == 0 { p1(n - 1) } else { p0(n - 1) }
fn q1(n: Int) : Int = if n <= 0 { 6 } else { q0(n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("#{entry(1000003)} #{p1(41)} #{q0(1000000)} #{q1(9)}")
}
