# Mutual tail recursion across a three-function cycle.
#
# The cycle `a -> b -> c -> a` exercises the strongly-connected
# component of the tail-call graph beyond the two-member case: all
# three fuse into one loop, and each member keeps its own base case.

fn a(n: Int) : Int = if n == 0 { 0 } else { b(n - 1) }
fn b(n: Int) : Int = if n == 0 { 1 } else { c(n - 1) }
fn c(n: Int) : Int = if n == 0 { 2 } else { a(n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("#{a(10000000)}")
}
