# Members that name their parameters in opposite order.
#
# The fused entry binds one parameter list, so each member's body is
# rewritten to read it positionally. A member whose names are the
# other's, swapped, is the case that catches a substitution applying
# pairwise instead of positionally.

fn ida(a: Int, b: Int) : Int = if a == 0 { b } else { vuelta(b, a - 1) }
fn vuelta(b: Int, a: Int) : Int = if a == 0 { b } else { ida(a - 1, b) }

fn main() : Unit / Stdout {
  Stdout.print("#{ida(3, 9)} #{vuelta(9, 3)} #{ida(0, 4)}")
}
