# A closure is called in tail position from inside a region: the arena is freed before the jump, so the region stack does not grow with the cycle.

type Hop = { step: (Hop, Int) -> Int }

fn rg_a(h: Hop, n: Int) : Int =
  if n == 0 { 0 } else {
    region {
      let xs = [n, n + 1]
      h.step(h, n - 1 + list_length(xs) - 2)
    }
  }

fn main() : Unit / Stdout = {
  let h = Hop { step: (self, n) => rg_a(self, n) }
  Stdout.print("#{rg_a(h, 100000000)}")
}
