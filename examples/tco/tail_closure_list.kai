# A closure taken out of a list is called in tail position and calls back into the function that holds the list.

fn run(fs: [(Int) -> Int], n: Int) : Int = match fs {
  []           -> n
  [f, ...rest] -> f(n)
}

fn count(n: Int) : Int = if n == 0 { 0 } else { run([count], n - 1) }

fn main() : Unit / Stdout = {
  Stdout.print("#{count(20000000)}")
}
