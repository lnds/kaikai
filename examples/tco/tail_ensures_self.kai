# A postcondition checks the result after the call returns, so the self call
# under it is not a tail call: the depth stays small.

fn te_count(n: Int, acc: Int) : Int
  ensures result >= 0
{
  if n == 0 { acc } else { te_count(n - 1, acc + 1) }
}

fn main() : Unit / Stdout {
  Stdout.print("#{te_count(10000, 0)}")
}
