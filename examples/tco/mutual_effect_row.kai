# Mutual tail recursion through an effect row.
#
# Both members declare the same row, which is what makes the group
# fusable; the fused entry carries that row and the cycle still runs in
# constant stack.

fn eco_par(n: Int) : Unit / Stdout =
  if n == 0 { Stdout.print("par") } else { eco_impar(n - 1) }

fn eco_impar(n: Int) : Unit / Stdout =
  if n == 0 { Stdout.print("impar") } else { eco_par(n - 1) }

fn main() : Unit / Stdout {
  eco_par(100001)
}
