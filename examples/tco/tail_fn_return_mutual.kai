# Mutual tail recursion in functions that return a function.

fn tf_even(n: Int) : (Int) -> Int =
  if n == 0 { (k) => k } else { tf_odd(n - 1) }

fn tf_odd(n: Int) : (Int) -> Int =
  if n == 0 { (k) => k + 1 } else { tf_even(n - 1) }

fn main() : Unit / Stdout {
  let f = tf_even(1000000)
  Stdout.print("#{f(10)}")
}
