# The group's members stay callable from outside and as values.
#
# Fusing replaces each member's body with a forward to the fused entry,
# so a caller outside the cycle and a member passed as a function value
# both keep working.

fn par(n: Int) : Bool = if n == 0 { true } else { impar(n - 1) }
fn impar(n: Int) : Bool = if n == 0 { false } else { par(n - 1) }

fn apply_to(f: (Int) -> Bool, n: Int) : Bool = f(n)

fn main() : Unit / Stdout {
  Stdout.print("#{par(4)} #{impar(4)} #{apply_to(par, 3)} #{apply_to(impar, 3)}")
}
