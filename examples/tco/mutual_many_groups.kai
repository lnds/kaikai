# Several tail-call cycles in one program, with non-members around them.
#
# `feed` tail-calls into the first cycle without being part of it, the
# three-cycle carries a chord (`q -> s`), and the last cycle's members
# are declared out of index order relative to the functions that reach
# them. Every cycle must still fuse into its own loop.
#
# Pass criteria: all four results at N=10_000_000 on BOTH backends.

fn feed(n: Int) : Int = ping(n)

fn ping(n: Int) : Int = if n == 0 { 10 } else { pong(n - 1) }
fn pong(n: Int) : Int = if n == 0 { 11 } else { ping(n - 1) }

fn q(n: Int) : Int = if n == 0 { 20 } else if n % 5 == 0 { s(n - 1) } else { r(n - 1) }
fn r(n: Int) : Int = if n == 0 { 21 } else { s(n - 1) }
fn s(n: Int) : Int = if n == 0 { 22 } else { q(n - 1) }

fn lone(n: Int) : Int = if n == 0 { 30 } else { lone(n - 1) }

fn to_z(n: Int) : Int = z(n)
fn z(n: Int) : Int = if n == 0 { 40 } else { y(n - 1) }
fn y(n: Int) : Int = if n == 0 { 41 } else { z(n - 1) }

fn main() : Unit / Stdout {
  let n = 10000000
  Stdout.print("#{feed(n)} #{q(n)} #{lone(n)} #{to_z(n + 1)}")
}
