# A self-tail call whose args capture a match-arm binder in a closure stays
# a goto: a million iterations only fit the fiber stack in constant space.

#[derive(Eq, Show)]
type Life = { worker: Int, summons: Int }

type Msg = Wire(Life) | Cancel

fn drain(lives: [Life], msgs: [Msg]) : [Life] = match msgs {
  [] -> lives
  [Cancel, ...rest] -> drain(lives, rest)
  [Wire(life), ...rest] -> drain(filter(lives, l => l != life), rest)
}

fn main() : Unit / Stdout {
  let all = [Life { worker: 0, summons: 1 }, Life { worker: 1, summons: 1 }]
  let msgs = [1..1000000] |> map((i) => Wire(Life { worker: i + 1, summons: 1 }))
  Stdout.print("left: #{drain(all, [Wire(Life { worker: 0, summons: 1 }), ...msgs])}")
}
