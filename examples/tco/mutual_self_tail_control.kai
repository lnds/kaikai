# Control for the mutual-recursion fusion: a plain self-tail call.
#
# A function that only calls itself is a one-member component, which the
# fusion leaves alone so the existing self-tail goto-loop still handles
# it. Guards the fusion against regressing the path it builds on.

fn baja(n: Int) : Bool = if n == 0 { true } else { baja(n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("#{baja(10000000)}")
}
