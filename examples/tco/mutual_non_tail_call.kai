# A cycle whose calls are NOT in tail position.
#
# `1 + g(n - 1)` leaves work after the call, so the pair is not a
# tail-call cycle and must not be fused: the arithmetic has to happen
# on the way back out.

fn f(n: Int) : Int = if n == 0 { 0 } else { 1 + g(n - 1) }
fn g(n: Int) : Int = if n == 0 { 0 } else { 1 + f(n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("#{f(10)} #{g(7)}")
}
