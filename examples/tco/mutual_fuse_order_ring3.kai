# The fused group's member order is its tag order and names the fused
# function after its first member. For the ring `f0 -> f2 -> f1 -> f0`
# that order is `f1, f2, f0`, so the loop is `__kai_fused_f1`.

fn f0(n: Int) : Int = if n == 0 { 0 } else { f2(n - 1) }
fn f1(n: Int) : Int = if n == 0 { 1 } else { f0(n - 1) }
fn f2(n: Int) : Int = if n == 0 { 2 } else { f1(n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("#{f0(10000000)} #{f1(7)} #{f2(5)}")
}
