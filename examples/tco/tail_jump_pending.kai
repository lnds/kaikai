# The jump releases the matched list before it leaves, so the cycle runs in constant stack without leaking.

protocol Hop {
  hop_a(x: Self, xs: [Int]) : Int
  hop_b(x: Self, xs: [Int]) : Int
}

impl Hop for Int {
  fn hop_a(x: Int, xs: [Int]) : Int = match xs {
    [] -> x
    [h, ...t] -> hop_b(x + h, t)
  }
  fn hop_b(x: Int, xs: [Int]) : Int = match xs {
    [] -> x
    [h, ...t] -> hop_a(x + h, t)
  }
}

fn mk(n: Int, acc: [Int]) : [Int] = if n == 0 { acc } else { mk(n - 1, [n, ...acc]) }

fn main() : Unit / Stdout {
  Stdout.print("#{hop_a(0, mk(2000000, []))}")
}
