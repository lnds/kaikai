# A param whose single read is the self-call's own arg transfers into the
# next iteration, so the goto must not drop it: an extra drop of `xs` would
# double-free the head cell on the first iteration. `depth` is read twice,
# so its goto-block drop is expected.

fn id_walk(xs: [Int], depth: Int) : Int {
  if depth == 0 { 0 }
  else { id_walk(xs, depth - 1) }
}

fn make_range_loop(n: Int, acc: [Int]) : [Int] {
  if n <= 0 { acc }
  else { make_range_loop(n - 1, [n, ...acc]) }
}

fn main() {
  let xs = make_range_loop(100, [])
  let r = id_walk(xs, 1_000)
  print("id_walk = #{int_to_string(r)}")
}
