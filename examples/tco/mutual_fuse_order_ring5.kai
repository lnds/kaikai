# A five-member ring whose tail calls jump across declaration order:
# `g0 -> g3 -> g1 -> g4 -> g2 -> g0`. The member order of the fused loop
# fixes each member's tag.

fn g0(n: Int) : Int = if n == 0 { 0 } else { g3(n - 1) }
fn g1(n: Int) : Int = if n == 0 { 1 } else { g4(n - 1) }
fn g2(n: Int) : Int = if n == 0 { 2 } else { g0(n - 1) }
fn g3(n: Int) : Int = if n == 0 { 3 } else { g1(n - 1) }
fn g4(n: Int) : Int = if n == 0 { 4 } else { g2(n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("#{g0(10000001)} #{g2(13)} #{g4(8)}")
}
