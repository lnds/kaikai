# A cycle through a function-typed parameter runs in constant stack: the call through the closure is a guaranteed tail call.

fn tc_a(n: Int, f: (Int) -> Int) : Int =
  if n == 0 { 0 } else { f(n - 1) }

fn tc_b(n: Int) : Int = tc_a(n, tc_b)

fn main() : Unit / Stdout {
  Stdout.print("#{tc_b(100000000)}")
}
