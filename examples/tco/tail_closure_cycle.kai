# A cycle through a function-typed parameter calls the closure by an indirect
# call, which is not a guaranteed tail call: the depth stays small.

fn tc_a(n: Int, f: (Int) -> Int) : Int =
  if n == 0 { 0 } else { f(n - 1) }

fn tc_b(n: Int) : Int = tc_a(n, tc_b)

fn main() : Unit / Stdout {
  Stdout.print("#{tc_b(10000)}")
}
