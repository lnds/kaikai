# Mutual tail recursion over a unit-polymorphic pair runs in constant stack.

unit m

fn tm_even[u: Measure](n: Int, x: Real<u>) : Bool =
  if n == 0 { true } else { tm_odd(n - 1, x) }

fn tm_odd[u: Measure](n: Int, x: Real<u>) : Bool =
  if n == 0 { false } else { tm_even(n - 1, x) }

fn main() : Unit / Stdout {
  Stdout.print("#{tm_even(1000000, 1.0<m>)}")
}
