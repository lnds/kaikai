# Mutual tail recursion: a two-function cycle in tail position.
#
# Each call is the tail of its branch, so the pair forms a tail-call
# cycle with no single function to jump back to. The fusion pass folds
# the group into one self-recursive function, which the self-tail
# rewrite then turns into a goto-loop.
#
# Pass criteria: prints `true` at N=10_000_000 on BOTH backends. Before
# the fusion the native backend overflowed the fiber stack here while
# the C backend survived on clang's sibling-call optimisation.

fn es_par(n: Int) : Bool =
  if n == 0 { true } else { es_impar(n - 1) }

fn es_impar(n: Int) : Bool =
  if n == 0 { false } else { es_par(n - 1) }

fn main() : Unit / Stdout {
  Stdout.print("#{es_par(10000000)}")
}
