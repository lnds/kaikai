# `ping` and `pong` take their parameters in opposite orders, so one of them
# lands in the slots backwards: its fused call must still evaluate the
# arguments left to right.
fn say(tag: String, v: Int) : Int / Stdout = {
  Stdout.print(tag)
  v
}

fn says(tag: String, s: String) : String / Stdout = {
  Stdout.print(tag)
  s
}

fn ping(n: Int, s: String) : Int / Stdout =
  if n == 0 { 0 } else { pong(says("first " ++ int_to_string(n), s), say("second " ++ int_to_string(n), n - 1)) }

fn pong(s: String, n: Int) : Int / Stdout =
  ping(say("third " ++ int_to_string(n), n), says("fourth " ++ int_to_string(n), s))

fn main() : Unit / Stdout = {
  let _ = ping(2, "x")
  ()
}
