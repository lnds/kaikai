# Cycles through a closure whose results are a Real, a Char, a Bool, a String and a Unit: each result is boxed at the stub.

type RealHop = { step: (RealHop, Int) -> Real }
type CharHop = { step: (CharHop, Int) -> Char }
type BoolHop = { step: (BoolHop, Int) -> Bool }
type StrHop = { step: (StrHop, Int) -> String }
type UnitHop = { step: (UnitHop, Int) -> Unit }

fn rs_real(h: RealHop, n: Int) : Real = if n == 0 { 1.5 } else { h.step(h, n - 1) }
fn rs_char(h: CharHop, n: Int) : Char = if n == 0 { 'x' } else { h.step(h, n - 1) }
fn rs_bool(h: BoolHop, n: Int) : Bool = if n == 0 { true } else { h.step(h, n - 1) }
fn rs_str(h: StrHop, n: Int) : String = if n == 0 { "done" } else { h.step(h, n - 1) }
fn rs_unit(h: UnitHop, n: Int) : Unit = if n == 0 { () } else { h.step(h, n - 1) }

fn main() : Unit / Stdout = {
  let r = RealHop { step: (self, n) => rs_real(self, n) }
  let c = CharHop { step: (self, n) => rs_char(self, n) }
  let b = BoolHop { step: (self, n) => rs_bool(self, n) }
  let s = StrHop { step: (self, n) => rs_str(self, n) }
  let u = UnitHop { step: (self, n) => rs_unit(self, n) }
  Stdout.print("#{rs_real(r, 20000000)} #{rs_char(c, 20000000)} #{rs_bool(b, 20000000)} #{rs_str(s, 20000000)} #{rs_unit(u, 20000000)}")
}
