# One generic and two of its specialisations. Each spec names the generic's
# declaration plus its own instance, so each classifies by its own signature:
# the generic stays boxed, the Int spec is all raw, the String spec only in
# its Bool.
fn pick[a](x: a, y: a, first: Bool) : a = if first { x } else { y }

fn main() : Unit / Stdout = {
  let n = pick(1, 2, true)
  let s = pick("a", "b", false)
  Stdout.print("#{n} #{s}")
}
