# The root declares its own `Pair` and `Triple`. Tuple sugar and the
# qualified `tuple.Pair` still name the core tuple types, in annotations,
# patterns and literals alike; the bare names name the root's.

type Pair = H(String, String)
type Triple = T3(Int)

fn swap(t: (String, String)) : (String, String) = {
  let (a, b) = t
  (b, a)
}

fn second(t: tuple.Pair[String, String]) : String = t.snd

fn total(t: (Int, Int, Int)) : Int = match t {
  (a, b, c) -> a + b + c
}

fn joined(p: Pair) : String = match p {
  H(l, r) -> string_concat(l, r)
}

fn units(t: Triple) : Int = match t {
  T3(n) -> n
}

fn main() : Unit / Console = {
  let s = swap(("a", "b"))
  println(s.fst)
  println(second(s))
  println(int_to_string(total((1, 2, 3))))
  println(joined(H("x", "y")))
  println(int_to_string(units(T3(7))))
}
