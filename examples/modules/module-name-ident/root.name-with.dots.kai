# A root file whose basename is not a C identifier. The module name the
# file contributes is minted into every `pub` symbol (`kaiu_<mod>__<fn>`),
# so the dots and the dash must be sanitised where the name is derived.
pub fn answer() : Int = 42

pub type Wrapped = W(Int)

pub fn unwrap(w: Wrapped) : Int = match w { W(n) -> n }

fn main() : Unit / Console = {
  print(int_to_string(answer()))
  print(int_to_string(unwrap(W(7))))
}
