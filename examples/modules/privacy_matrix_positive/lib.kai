# Positive matrix: pub symbols of every category, plus internal use
# of module-private helpers behind a pub wrapper.
pub type Color = Red | Green
pub type Pt = { x: Int, y: Int }
pub type Len = Int
pub const LIMIT : Int = 9
pub protocol Area {
  area(x: Self) : Int
}
impl Area for Pt {
  fn area(p: Pt) : Int = p.x * p.y
}
pub fn make_pt() : Pt = Pt { x: 2, y: 3 }
fn helper() : Int = 40
pub fn via_helper() : Int = helper()
