# Positive: pub fn/const/type/ctor/protocol usable from the importer
# — bare and qualified, in signatures, bodies, patterns and
# annotations — and a root decl may shadow a foreign private name.
import lib

effect Log {
  note(s: String) : Unit
}

fn hidden() : Int = 5
fn f(c: Color, p: Pt, l: Len) : Int / Log = {
  Log.note("hi")
  match c { Red -> p.x + l Green -> area(p) }
}

fn main() : Unit / Stdout = {
  let p : Pt = make_pt()
  let r = handle { f(Green, p, LIMIT) } with Log {
    note(s, resume) -> resume(())
    return(x) -> x
  }
  Stdout.print("#{r + lib.via_helper() + lib.LIMIT + hidden()}")
}
