# Negative: row annotation, handle head and qualified op call
# against a non-pub effect of `lib`.
import lib

fn in_row() : Int / Hidden = Hidden.op(1)
fn handled() : Int = handle { 3 } with Hidden {
  op(x, resume) -> resume(x)
  return(x) -> x
}

fn main() : Unit / Stdout {
  Stdout.print("should-not-compile")
}
