# Negative: impl of a foreign non-pub protocol, bare call of its op,
# and a tparam bound naming it.
import lib

type Mine = { v: Int }
impl Sneaky for Mine {
  fn peek2(x: Mine) : Int = x.v
}
fn op_call() : Int = peek(make())
fn bounded[T: Sneaky](x: T) : Int = 0

fn main() : Unit / Stdout {
  Stdout.print("should-not-compile")
}
