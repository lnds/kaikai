pub type Bag[a] = { items: [a] }

pub fn bag(xs: [a]) : Bag[a] = Bag { items: xs }

pub fn map[a, b, e](b: Bag[a], ^f: (a) -> b / e) : Bag[b] / e = Bag { items: b.items | f }

pub fn flat_map[a, b, e](b: Bag[a], ^f: (a) -> Bag[b] / e) : Bag[b] / e =
  Bag { items: b.items || (x => f(x).items) }

pub fn filter[a, e](b: Bag[a], ^p: (a) -> Bool / e) : Bag[a] / e = Bag { items: b.items |? p }

pub fn each[a, e](b: Bag[a], ^f: (a) -> Unit / e) : Unit / e = b.items |! f

pub fn size(b: Bag[a]) : Int = list_length(b.items)
