# The module declaring a `priv` field reads it through every pattern form.

pub type Wallet = { owner: String, priv pin: Int }

pub type Holder = Hold(Wallet) | Empty

pub fn make(owner: String, pin: Int) : Wallet = Wallet { owner: owner, pin: pin }

pub fn pin_pun(w: Wallet) : Int = match w {
  { owner: _, pin } -> pin
}

pub fn pin_prefixed(w: Wallet) : Int = match w {
  Wallet { owner: _, pin: p } -> p
}

pub fn pin_is_seven(w: Wallet) : Bool = match w {
  { owner: _, pin: 7 } -> true
  _ -> false
}

pub fn pin_let(w: Wallet) : Int = {
  let { owner: _, pin: p } = w
  p
}

pub fn pin_nested(h: Holder) : Int = match h {
  Hold({ owner: _, pin: p }) -> p
  Empty -> 0
}

pub fn pin_as(w: Wallet) : Int = match w {
  _whole @ { owner: _, pin: p } -> p
}

pub fn repinned(w: Wallet, pin: Int) : Wallet = Wallet { ...w, pin: pin }
