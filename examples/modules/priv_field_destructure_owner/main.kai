# A public field of an imported record stays readable by pattern, and the
# root module reads its own `priv` field.

import lib

type Local = { name: String, priv code: Int }

fn local_code(l: Local) : Int = match l {
  { name: _, code } -> code
}

fn main() : Unit / Stdout = {
  let w = lib.make("ana", 7)
  let { owner } = w
  Stdout.print(owner)
  Stdout.print("#{lib.pin_pun(w)} #{lib.pin_prefixed(w)} #{lib.pin_let(w)} #{lib.pin_as(w)}")
  Stdout.print("#{lib.pin_is_seven(w)} #{lib.pin_nested(lib.Hold(w))}")
  Stdout.print("#{lib.pin_let(lib.repinned(w, 9))}")
  Stdout.print("#{local_code(Local { name: "x", code: 3 })}")
}
