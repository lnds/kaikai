# `Node` is also declared by `main`, with a different arity. `make` builds
# through a TRMC step and `inc` through a reuse rebuild; both must resolve
# this module's `Node`.

pub type Tree = Leaf | Node(Tree, Int, Tree)

pub fn make(n: Int) : Tree = if n <= 0 { Leaf } else { Node(Leaf, n, make(n - 1)) }

pub fn inc(t: Tree) : Tree = match t {
  Node(l, k, r) -> Node(l, k + 1000, r)
  Leaf          -> Leaf
}

pub fn total(t: Tree) : Int = match t {
  Node(l, k, r) -> k + total(l) + total(r)
  Leaf          -> 0
}
