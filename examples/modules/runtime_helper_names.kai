# User functions may be named after internal runtime helpers. The C
# backend emits user symbols into their own `kaiu_` namespace, so a name
# like `apply` (the conventional event-sourcing fold) no longer redeclares
# the runtime's `kai_apply` with a different signature.
#
# The returned values matter, not just that the backend accepts the names:
# a namespace bug that routed a call to the runtime helper would still
# compile and then return the wrong thing.

fn apply(s: Int, n: Int) : Int = s + n

fn arena_alloc(n: Int) : Int = n * 2

fn bench_now_ns(n: Int) : Int = n + 10

fn int(n: Int) : Int = n - 1

fn bool(n: Int) : Int = n * 3

fn closure(n: Int) : Int = n + 100

fn cons(a: Int, b: Int) : Int = a * b

fn to_string(n: Int) : Int = n + 7

fn main() : Unit / Console = {
  println(int_to_string(apply(10, 5)))
  println(int_to_string(arena_alloc(11)))
  println(int_to_string(bench_now_ns(32)))
  println(int_to_string(int(44)))
  println(int_to_string(bool(17)))
  println(int_to_string(closure(6)))
  println(int_to_string(cons(8, 9)))
  println(int_to_string(to_string(80)))
}
