# Every private helper here is reached only indirectly: through a protocol
# impl the runtime table dispatches to, a handler clause, a return clause, a
# `finally` clause, a lambda, or a fn passed as a value.

#[doc("A tile shown through its `Show` impl.")]
pub type Tile = Square(Int)

fn side_label(n: Int) : String = "tile #{n}"

impl Show for Tile {
  fn show(x: Tile) : String = match x { Square(n) -> side_label(n) }
}

#[doc("Counts bumps.")]
pub effect Tally {
  bump(n: Int) : Unit
}

fn clause_weight(n: Int) : Int = n * 10

fn final_offset(x: Int) : Int = x + 1000

fn closing_note() : String = "tally closed"

#[doc("Prints each bump's weight, then returns the body's value offset by the return clause.")]
pub fn tally_total() : Int / Console = handle {
  Tally.bump(1)
  Tally.bump(2)
  0
} with Tally {
  finally { print(closing_note()) }
  bump(n, resume) -> { print(int_to_string(clause_weight(n))); resume(()) }
  return(x)       -> final_offset(x)
}

fn scale_by(x: Int, k: Int) : Int = x * k

#[doc("A closure multiplying by `k`.")]
pub fn scaler(k: Int) : (Int) -> Int = (x) => scale_by(x, k)

fn double_it(x: Int) : Int = x * 2

fn apply_twice(f: (Int) -> Int, x: Int) : Int = f(f(x))

#[doc("`x` doubled twice through a fn value.")]
pub fn quadruple(x: Int) : Int = apply_twice(double_it, x)

#[doc("Never called: an import the program does not reach.")]
pub fn unused_entry() : Int = scale_by(3, 4)

#[doc("`x` cubed; only a test block calls it.")]
pub fn cube(x: Int) : Int = x * x * x
