import reachlib

# `show` as a value dispatches through the runtime impl table, the only path
# to the `Show` impl for `Tile`.
fn apply_show(f: (Tile) -> String, t: Tile) : String = f(t)

fn main() : Unit / Console = {
  print(apply_show(show, Square(4)))
  print(int_to_string(tally_total()))
  let triple = scaler(3)
  print(int_to_string(triple(7)))
  print(int_to_string(quadruple(5)))
}

test "an import reached only from a test block" {
  assert(cube(3) == 27)
}
