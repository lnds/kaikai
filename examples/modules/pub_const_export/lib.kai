# A `pub const` is part of the module's public surface, so an
# importing module reaches it both qualified (`lib.VERSION`) and
# unqualified, in value position and in match-pattern position.
#
# `lower_limit` is lowercase on purpose: an uppercase qualified name
# collapses to a bare ctor-style read, while a lowercase one takes the
# module-call path, which must inline the const body instead of
# minting a thunk symbol that nothing defines.

pub const VERSION : String = "0.1.0"
pub const MAX_RETRIES : Int = 3
pub const lower_limit : Int = 5

const INTERNAL_SEED : Int = 7

pub fn seeded(n: Int) : Int = n + INTERNAL_SEED
