import lib

fn classify(n: Int) : String = match n {
  MAX_RETRIES -> "at limit"
  _           -> "under limit"
}

fn main() : Unit / Console {
  print(lib.VERSION)
  print(int_to_string(lib.MAX_RETRIES))
  print(int_to_string(MAX_RETRIES))
  print(classify(3))
  print(classify(1))
  print(int_to_string(seeded(1)))
  print(int_to_string(lib.lower_limit))
  print(int_to_string(lower_limit))
}
