import p
import q

# Text inside a string loads nothing: `e` is spelled only in `p`'s own
# string and `d` only in `q`'s, so both are plainly unused. `q` calls
# `k.twice` in an interpolation and imports `k` nowhere, so `p`'s `k`
# is load-bearing.
fn main() : Unit / Stdout = Stdout.print("#{p.f()} #{q.g()}")
