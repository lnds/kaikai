# A derive's expansion refers to names the file never spells: here the
# JSON constructors `encoding.json_bind` brings. That import is used,
# in this file and in `shapes`. `spare` is mentioned by nothing, typed
# or derived, and is still reported.

import encoding.json_bind
import shapes
import spare

#[derive(Json)]
pub type Point = { x: Int, y: Int }

fn main() : Int / Stdout = {
  Stdout.print("area #{int_to_string(area(Box { w: 3, h: 4 }))}")
  0
}
