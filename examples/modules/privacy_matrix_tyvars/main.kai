# A habitant named like a signature-bound type variable must not be
# picked up by privacy resolution: `a`, `b`, `e` here collide with the
# implicit tyvars used throughout stdlib signatures, and the local
# `pub fn` reuses `a` as its own implicit tyvar. Lowercase unit names
# stay fully functional (`m`, `s` under `Real<...>`).

unit a

effect b {
  ping(x: Int) : Int
}

kind K : AbelianGroup with kk
kk e

unit m
unit s

pub fn first_or(xs: [a], d: a) : a = match xs {
  [] -> d
  [x, ..._] -> x
}

fn speed(d: Real<m>, t: Real<s>) : Real<m/s> = d / t

fn main() {
  println("#{first_or([7], 0)}")
  println("#{first_or([], 3)}")
  if speed(10.0<m>, 2.0<s>) == 5.0<m/s> { println("units-ok") }
  else { println("units-bad") }
}
