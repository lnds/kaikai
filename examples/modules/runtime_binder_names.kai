# Local binders may be named after internal runtime helpers. The C
# backend emits every user-named local (params, `let`/`var`, match
# binders, lambda params, captures) into the `kaiv_` namespace, so a
# parameter like `unit` no longer shadows the runtime's `kai_unit`
# where the emitter needs to call it.
#
# Values are checked, not just acceptance: a namespace bug that read
# the wrong symbol could still compile and return the wrong thing.

fn label(unit: String, units: [String]) : String = match units {
  []        -> "#{unit}"
  [u, ..._] -> "#{unit} #{u}"
}

fn pick(free_value: [Int]) : Int = match free_value {
  []                        -> 0
  [op_eq]                   -> op_eq
  [op_truthy, ...sched_yield] -> op_truthy + list_length(sched_yield)
}

fn scaled(page_size: Int, heap_limit: Int) : Int = {
  let decref = page_size * 2
  let f = (ptr_reuse) => ptr_reuse + heap_limit
  var arena_init := decref
  arena_init := arena_init + f(3)
  arena_init
}

fn tally(set_args: [Int], monitor_add: Int) : Int = match set_args {
  []                  -> monitor_add
  [check_begin, ...prof_push] -> tally(prof_push, monitor_add + check_begin)
}

fn main() : Unit / Console = {
  println(label("m", ["kg", "s"]))
  println(int_to_string(pick([])))
  println(int_to_string(pick([42])))
  println(int_to_string(pick([7, 1, 2, 3])))
  println(int_to_string(scaled(8, 100)))
  println(int_to_string(tally([1, 2, 3], 10)))
}
