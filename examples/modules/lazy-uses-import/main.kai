import seq

# The literal is this file's only use of the module: no word here spells
# a name the module exports, and the import is still not reported.
fn opening(n: Int) : Int = {
  let cells = lazy [n, n + 1..]
  match cells {
    []        -> 0
    [x, ..._] -> x
  }
}

fn main() : Unit / Stdout = Stdout.print(int_to_string(opening(5)))
