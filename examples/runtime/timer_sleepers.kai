import spawn
import time

# Many fibers parked on a timer at once; the count is rewritten by
# tools/test-timer-heap.sh to time how parking scales.

fn main() : Int / Spawn + Clock + Stdout {
  let results = nursery { n ->
    let fibers = [1..10000]
      | (i => n.spawn(() => {
        sleep(millis(100))
        1
      }))
    fibers | (f => n.await(f))
  }
  Stdout.print("done tasks=#{int_to_string(length(results))}")
  0
}
