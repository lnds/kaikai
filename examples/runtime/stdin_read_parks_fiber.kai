import actor
import spawn

fn main() : Int / Stdin + Stdout + Spawn = with_mailbox {
  nursery { n ->
    let here = Actor.self()
    let printer = n.spawn(
      () => with_mailbox {
        Actor.send(here, Actor.self())
        echoed()
      }
    )
    let to = Actor.receive()
    pass_on(to)
    n.await(printer)
  }
}

fn echoed() : Int / Actor[String] + Stdout {
  let line = Actor.receive()
  if line == "" {
    0
  } else {
    Stdout.print("got #{line}")
    echoed()
  }
}

fn pass_on(to: Pid[String]) : Unit / Stdin + Actor[Pid[String]] = match Stdin.read_line() {
  None -> Actor.send(to, "")
  Some(line) -> {
    Actor.send(to, line)
    pass_on(to)
  }
}
