# An actor that never starts holds a variant tree its closure captured;
# the exit report settles it after main returns, so the slabs must outlive it.
import actor

type Tree = Leaf | Node(Tree, Int, Tree)

fn build(n: Int) : Tree = if n == 0 { Leaf } else { Node(build(n - 1), n, Leaf) }

fn size(t: Tree) : Int = match t {
  Leaf -> 0
  Node(l, _, r) -> 1 + size(l) + size(r)
}

fn idle(t: Tree) : Unit / Actor[String] = {
  let _n = size(t)
  ()
}

fn main() : Unit / Spawn = with_mailbox {
  let t = build(100)
  let _k = spawn_actor(() => idle(t))
  ()
}
