# A non-tail recursion 3 000 000 deep in `main`, past the fixed
# `KAI_MAIN_STACK_SIZE` budget: the guard page must report it at every
# thread count. `scratch` stays live across the call so the C optimiser
# cannot fold the recursion into a loop.

fn deep(n: Int) : Int = {
  if n == 0 {
    0
  } else {
    let scratch = array_make(4, n)
    let r = deep(n - 1)
    r + array_get(scratch, 0)
  }
}

fn main() : Unit / Stdout = Stdout.print(int_to_string(deep(3000000)))
