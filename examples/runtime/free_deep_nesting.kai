# Dropping a structure 1 000 000 levels deep, alternating variant, list and
# record cells, must reclaim it without recursing once per level: the free
# of each cell defers its children instead of descending into them.

type Box = { inner: Nest, tag: Int }
type Nest = End | More([Box])

fn build(n: Int, acc: Nest) : Nest =
  if n == 0 { acc } else { build(n - 1, More([Box { inner: acc, tag: n }])) }

fn top_tag(t: Nest) : Int = match t {
  End -> 0
  More(bs) -> match bs { [b] -> b.tag  _ -> 0 }
}

fn measure(n: Int) : Int = {
  let t = build(n, End)
  top_tag(t)
}

fn main() : Unit / Stdout = Stdout.print(int_to_string(measure(1000000)))
