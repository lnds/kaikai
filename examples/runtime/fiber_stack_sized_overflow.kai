# A non-tail recursion 50 000 000 deep on a spawned fiber, past its stack
# budget: the guard page must report it at every thread count.

import spawn

fn deep(n: Int) : Int = {
  if n == 0 {
    0
  } else {
    let scratch = array_make(4, n)
    let r = deep(n - 1)
    r + array_get(scratch, 0)
  }
}

fn worker() : Int = deep(50000000)

fn main() : Int / Spawn + Stdout = {
  Stdout.print(int_to_string(spawn.await(spawn.spawn(worker))))
  0
}
