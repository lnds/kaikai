# A main that spawns short-lived actors and fibers for as long as it runs
# holds only the live ones: the root scope drops each finished child, so peak
# memory stays flat (bounded by `make test-root-reaps-children`).
import actor
import spawn

fn ack(parent: Pid[String]) : Unit / Actor[String] = Actor.send(parent, "ack")

fn actors(n: Int, acks: Int) : Int / Actor[String] + Spawn =
  if n == 0 { acks } else {
    let me = Actor.self()
    let _k = spawn_actor(() => ack(me))
    let _a = Actor.receive()
    actors(n - 1, acks + 1)
  }

fn fibers(n: Int, sum: Int) : Int / Spawn =
  if n == 0 { sum } else {
    let f = spawn.spawn(() => 1)
    fibers(n - 1, sum + spawn.await(f))
  }

fn main() : Unit / Spawn + Console = {
  let acks = with_mailbox { actors(30000, 0) }
  let done = fibers(30000, 0)
  println("#{acks} actors acked, #{done} fibers done")
}
