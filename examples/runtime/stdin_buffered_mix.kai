fn show(tag: String, o: Option[String]) : Unit / Stdout = match o {
  Some(l) -> Stdout.print("#{tag} [#{l}] #{string_length(l)}")
  None -> Stdout.print("#{tag} EOF")
}

fn main() : Unit / Stdin + Stdout = {
  show("line", Stdin.read_line())
  Stdout.print("bytes [#{Stdin.read_bytes(5)}]")
  show("line", Stdin.read_line())
  show("line", Stdin.read_line())
  Stdout.print("bytes [#{Stdin.read_bytes(2)}]")
  show("line", Stdin.read_line())
  show("line", Stdin.read_line())
  show("line", Stdin.read_line())
  Stdout.print("bytes [#{Stdin.read_bytes(4)}]")
}
