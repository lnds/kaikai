# A `Handle` threaded through functions with an effect row. Those keep the
# boxed calling convention, so the handle rides a `KaiValue *` slot that
# Perceus dups and drops like any boxed value. The handle is a C pointer its
# owner frees, never RC: an RC op on it rewrites the buffer's first word
# (the element array), and reading an element back then faults.

fn fresh(tag: String) : Handle / Stdout {
  Stdout.print("new #{tag}")
  llvm_buf_new()
}

fn fill(b: Handle, x: Handle, n: Int) : Unit / Stdout =
  if n == 0 {
    Stdout.print("filled")
  } else {
    llvm_buf_push(b, x)
    fill(b, x, n - 1)
  }

fn report(tag: String, b: Handle) : Unit / Stdout = Stdout.print("#{tag} len #{llvm_buf_len(b)}")

fn main() : Unit / Stdout {
  let b = fresh("outer")
  let x = fresh("elem")
  llvm_buf_push(x, b)
  fill(b, x, 5)
  report("outer", b)
  report("outer", b)
  report("last elem", llvm_buf_get(b, 4))
  report("first elem", llvm_buf_get(b, 0))
  llvm_buf_free(x)
  llvm_buf_free(b)
  Stdout.print("done")
}
