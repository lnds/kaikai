# `main`'s Int return IS the process exit status; the Makefile target
# asserts the observed status is 3.
#
# The print before the return also pins the flush guarantee: returning
# the status keeps libc's full exit path, unlike `os.process.exit`,
# which calls `_exit(2)` and drops buffered stdio.

fn main() : Int / Stdout = {
  Stdout.print("before exit")
  3
}
