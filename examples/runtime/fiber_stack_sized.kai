# A non-tail recursion 20 000 deep completes on a spawned fiber and inside a
# handle that keeps its continuation, both past the old 64 KiB stack.
# `scratch` stays live across the call so the C optimiser cannot fold the
# recursion into a loop.

import spawn

effect Yield { yield(x: Int) : Unit }

type Gen = Done(Int) | Next(Int, Cont[Unit, Gen])

fn deep(n: Int) : Int = {
  if n == 0 {
    0
  } else {
    let scratch = array_make(4, n)
    let r = deep(n - 1)
    r + array_get(scratch, 0)
  }
}

fn body() : Gen / Yield = {
  Yield.yield(1)
  Done(deep(20000))
}

fn generate() : Gen =
  handle { body() } with Yield { yield(x, resume) -> Next(x, resume) }

fn drain(g: Gen, acc: Int) : Int = match g {
  Done(v) -> acc + v
  Next(x, k) -> drain(k(()), acc + x)
}

fn fiber_deep() : Int = deep(20000)

fn fiber_handle() : Int = drain(generate(), 0)

fn main() : Int / Spawn + Stdout = {
  let a = spawn.spawn(fiber_deep)
  let b = spawn.spawn(fiber_handle)
  Stdout.print(int_to_string(spawn.await(a)))
  Stdout.print(int_to_string(spawn.await(b)))
  Stdout.print(int_to_string(drain(generate(), 0)))
  0
}
