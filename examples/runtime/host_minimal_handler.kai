# Runs unchanged on a host with no facility: handlers that resume in tail
# position, resume once before more work, or never resume switch no stack.

effect Ask {
  ask() : Int
}

effect Stop {
  stop(code: Int) : Nothing
}

fn twice() : Int / Ask = Ask.ask() + Ask.ask()

fn guarded(n: Int) : Int / Stop = if n > 2 { Stop.stop(n) } else { n }

fn main() : Unit / Stdout = {
  let tail = handle { twice() } with Ask {
    ask(resume) -> resume(21)
  }
  Stdout.print("tail=#{tail}")
  let after = handle { Ask.ask() } with Ask {
    ask(resume) -> resume(10) + 100
  }
  Stdout.print("after=#{after}")
  let never = handle { guarded(1) + guarded(7) } with Stop {
    stop(code, resume) -> 0 - code
  }
  Stdout.print("never=#{never}")
}
