# A non-tail recursion 200 000 deep in `main`: past an 8 MB stack, within
# the fixed main-stack budget at every thread count.
# `scratch` stays live across the call so the C optimiser cannot fold the
# recursion into a loop.

fn deep(n: Int) : Int = {
  if n == 0 {
    0
  } else {
    let scratch = array_make(4, n)
    let r = deep(n - 1)
    r + array_get(scratch, 0)
  }
}

fn main() : Unit / Stdout = Stdout.print(int_to_string(deep(200000)))
