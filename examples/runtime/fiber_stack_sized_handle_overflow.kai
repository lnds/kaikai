# The same past the budget inside a handle that keeps its continuation.

effect Yield { yield(x: Int) : Unit }

type Gen = Done(Int) | Next(Int, Cont[Unit, Gen])

fn deep(n: Int) : Int = {
  if n == 0 {
    0
  } else {
    let scratch = array_make(4, n)
    let r = deep(n - 1)
    r + array_get(scratch, 0)
  }
}

fn body() : Gen / Yield = {
  Yield.yield(1)
  Done(deep(50000000))
}

fn drain(g: Gen, acc: Int) : Int = match g {
  Done(v) -> acc + v
  Next(x, k) -> drain(k(()), acc + x)
}

fn main() : Unit / Stdout =
  Stdout.print(int_to_string(drain(handle { body() } with Yield { yield(x, resume) -> Next(x, resume) }, 0)))
