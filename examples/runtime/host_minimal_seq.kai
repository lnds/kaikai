# Runs unchanged on a host with no facility: a lazy sieve over an endless
# range reads its cells on the stack it was called on.

import seq

fn sieve(xs: Seq[Int]) : Seq[Int] = match xs {
  []           -> lazy []
  [p, ...rest] -> lazy [p, ...sieve(rest |? (x) => x % p != 0)]
}

fn main() : Unit / Stdout = {
  let primes = sieve(lazy [2..])
  Stdout.print(show(to_list(take(primes, 15))))
  Stdout.print(int_to_string(primes |> nth(99)))
}
