# On a host with no child processes a start stops the program and says so.

fn main() : Int / Process + Stdout = {
  Stdout.print("before")
  let child = Process.start("/bin/echo", ["hello"])
  match Process.wait(child) {
    Ok(_)  -> Stdout.print("reaped")
    Err(e) -> Stdout.print("lost: #{e}")
  }
  0
}
