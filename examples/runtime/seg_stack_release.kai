import gen

# The prime sieve as nested generators: every prime keeps one more suspended
# stack segment alive, and the whole chain is released at the end.

fn naturals(n: Int) : Unit / Yield[Int] {
  Yield.yield(n)
  naturals(n + 1)
}

fn sieve(g: Gen[Int, e]) : Unit / Yield[Int] + e = match g {
  Done -> ()
  Next(p, k) -> {
    Yield.yield(p)
    sieve(gen.filter(k(()), x => x % p != 0))
  }
}

fn primes() : Gen[Int, e] / e = gen.generate(() => sieve(gen.generate(() => naturals(2))))

fn main() : Unit / Stdout {
  let upto = gen.take_until(primes(), p => p >= 17389)
  match gen.reduce(upto, (_a, b) => b) {
    Some(last) -> Stdout.print("last prime: #{last}")
    None -> Stdout.print("no primes")
  }
}
