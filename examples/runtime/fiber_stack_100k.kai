# 100 000 fibers alive at once, each reserving its full stack: address space only.

import spawn

fn work(i: Int) : Int / Spawn = {
  spawn.yield()
  spawn.yield()
  i
}

fn sum(fs: [Fiber[Int]], acc: Int) : Int / Spawn = match fs {
  [] -> acc
  [f, ...rest] -> sum(rest, acc + Spawn.await(f))
}

fn main() : Int / Spawn + Stdout = {
  nursery { n ->
    let fs = [1..100000] | (i => n.spawn(() => work(i)))
    Stdout.print(int_to_string(sum(fs, 0)))
  }
  0
}
