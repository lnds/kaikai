# Constructor values nested 24 deep: the C emitter emits each argument once,
# so compiling this takes milliseconds, not time exponential in the depth.
type Chain = Leaf(String) | Link(String, Chain)

fn length(c: Chain) : Int = match c {
  Leaf(_)    -> 1
  Link(_, r) -> 1 + length(r)
}

fn main() : Unit / Stdout = {
  let v = Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(7))))))))))))))))))))))))
  match v {
    Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(x)))))))))))))))))))))))) -> Stdout.print(int_to_string(x))
    _ -> Stdout.print("none")
  }
  Stdout.print(int_to_string(length(Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Link("a", Leaf("z"))))))))))))))))))))))))))))
}
