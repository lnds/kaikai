# A bit operation passed as a function value, and over operands that are not raw.

fn apply2(f: (Int, Int) -> Int, a: Int, b: Int) : Int = f(a, b)

fn fold_with(f: (Int, Int) -> Int, xs: [Int], acc: Int) : Int = match xs {
  [] -> acc
  [x, ...rest] -> fold_with(f, rest, f(acc, x))
}

fn main() : Int / Stdout {
  Stdout.print("#{apply2(bit_xor, 255, 15)}")
  Stdout.print("#{apply2(bit_and, 255, 15)}")
  Stdout.print("#{apply2(bit_or, 240, 15)}")
  Stdout.print("#{apply2(bit_shl, 1, 65)}")
  Stdout.print("#{apply2(bit_shr, -8, 1)}")
  Stdout.print("#{apply2(bit_ushr, -1, 60)}")
  Stdout.print("#{fold_with(bit_xor, [1, 2, 4, 8, 16], 0)}")
  Stdout.print("#{fold_with(bit_or, [1, 2, 4, 8, 16], 0)}")
  let xs = [3, 5, 6]
  let ys = map(xs, x => bit_xor(x, 1))
  Stdout.print("#{ys}")
  let zs = map(xs, x => bit_count(bit_shl(x, 62)))
  Stdout.print("#{zs}")
  0
}
