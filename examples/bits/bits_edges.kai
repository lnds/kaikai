# Every math.bits operation over raw Int operands, edge cases included:
# shift counts at and past the width and negative, arithmetic vs logical
# right shift, INT64 extremes.

fn bit_int(a: Int, n: Int) : Int = if bit_test(a, n) { 1 } else { 0 }

fn shifts(a: Int, n: Int) : String =
  "#{a} #{n} #{bit_shl(a, n)} #{bit_shr(a, n)} #{bit_ushr(a, n)} #{bit_set(a, n)} #{bit_clear(a, n)} #{bit_toggle(a, n)} #{bit_int(a, n)}"

fn unary(a: Int) : String = "#{a} #{bit_not(a)} #{bit_count(a)}"

fn pair(a: Int, b: Int) : String = "#{a} #{b} #{bit_and(a, b)} #{bit_or(a, b)} #{bit_xor(a, b)}"

type Ops
  = Ops(
    (Int, Int) -> Int,
    (Int, Int) -> Int,
    (Int, Int) -> Int,
    (Int, Int) -> Int,
    (Int, Int) -> Int,
    (Int, Int) -> Int,
    (Int, Int) -> Bool
  )

fn ops() : Ops = Ops(bit_shl, bit_shr, bit_ushr, bit_set, bit_clear, bit_toggle, bit_test)

fn shifts_boxed(o: Ops, a: Int, n: Int) : String = match o {
  Ops(shl, shr, ushr, set, clear, toggle, tst) ->
    "#{a} #{n} #{shl(a, n)} #{shr(a, n)} #{ushr(a, n)} #{set(a, n)} #{clear(a, n)} #{toggle(a, n)} #{if tst(a, n) { 1 } else { 0 }}"
}

fn pair_boxed(
  f_and: (Int, Int) -> Int,
  f_or: (Int, Int) -> Int,
  f_xor: (Int, Int) -> Int,
  a: Int,
  b: Int
) : String = "#{a} #{b} #{f_and(a, b)} #{f_or(a, b)} #{f_xor(a, b)}"

fn unary_boxed(f_not: (Int) -> Int, f_count: (Int) -> Int, a: Int) : String =
  "#{a} #{f_not(a)} #{f_count(a)}"

fn all_counts_boxed(a: Int, ns: [Int]) : Int / Stdout = match ns {
  [] -> 0
  [n, ...rest] -> {
    Stdout.print(shifts_boxed(ops(), a, n))
    all_counts_boxed(a, rest)
  }
}

fn all_pairs_boxed(a: Int, bs: [Int]) : Int / Stdout = match bs {
  [] -> 0
  [b, ...rest] -> {
    Stdout.print(pair_boxed(bit_and, bit_or, bit_xor, a, b))
    all_pairs_boxed(a, rest)
  }
}

fn all_counts(a: Int, ns: [Int]) : Int / Stdout = match ns {
  [] -> 0
  [n, ...rest] -> {
    Stdout.print(shifts(a, n))
    all_counts(a, rest)
  }
}

fn all_pairs(a: Int, bs: [Int]) : Int / Stdout = match bs {
  [] -> 0
  [b, ...rest] -> {
    Stdout.print(pair(a, b))
    all_pairs(a, rest)
  }
}

fn each(xs: [Int], f: (Int) -> Int / Stdout) : Int / Stdout = match xs {
  [] -> 0
  [x, ...rest] -> {
    f(x)
    each(rest, f)
  }
}

fn counts() : [Int] = [0, 1, 3, 63, 64, 65, 67, -1, -61, 130]

fn values() : [Int] = [
  0,
  1,
  -1,
  5,
  -8,
  9223372036854775807,
  (-9223372036854775807) - 1,
  1311768467463790320
]

fn main() : Int / Stdout {
  each(values(), a => {
    Stdout.print(unary(a))
    0
  })
  each(values(), a => all_pairs(a, values()))
  each(values(), a => all_counts(a, counts()))
  each(values(), a => {
    Stdout.print(unary_boxed(bit_not, bit_count, a))
    0
  })
  each(values(), a => all_pairs_boxed(a, values()))
  each(values(), a => all_counts_boxed(a, counts()))
  0
}
