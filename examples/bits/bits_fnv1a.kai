# 64-bit FNV-1a: xor then multiply, the shape that must stay raw end to end.

fn fnv(bytes: [Int], h: Int) : Int = match bytes {
  [] -> h
  [b, ...rest] -> fnv(rest, bit_xor(h, b) * 1099511628211)
}

fn loop(i: Int, h: Int) : Int =
  if i == 0 { h } else { loop(i - 1, bit_xor(h, i % 256) * 1099511628211) }

fn main() : Int / Stdout {
  let basis = -3750763034362895579
  Stdout.print("#{fnv([], basis)}")
  Stdout.print("#{fnv([97], basis)}")
  Stdout.print("#{fnv([104, 101, 108, 108, 111], basis)}")
  Stdout.print("#{loop(1000, basis)}")
  0
}
