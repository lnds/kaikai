# list_concat_literal_to_spread must NOT fire on:
#   1. genuine concatenation of two list values — what `++` is for;
#   2. a computed left operand — only a literal has a spread rewrite;
#   3. an empty left literal — `[] ++ xs` is just `xs` (the runtime
#      shares the right operand); dropping the concat is the fix,
#      not a spread;
#   4. a literal on the RIGHT (`xs ++ [y]`) — no spelling avoids
#      that copy;
#   5. string concatenation.
# The expected linter output for this file is empty.

fn concat_lists(xs: [Int], ys: [Int]) : [Int] = xs ++ ys

fn wrap(x: Int) : [Int] = [x]

fn computed_left(x: Int, t: [Int]) : [Int] = wrap(x) ++ t

fn empty_left(xs: [Int]) : [Int] = [] ++ xs

fn append_right(xs: [Int], y: Int) : [Int] = xs ++ [y]

fn greet(s: String) : String = "hi " ++ s

fn len(xs: [Int]) : Int = match xs {
  [_, ...rest] -> 1 + len(rest)
  []           -> 0
}

fn main() : Int =
  len(concat_lists([1], [2])) + len(computed_left(3, [4])) +
  len(empty_left([5])) + len(append_right([6], 7)) - 6 +
  (if greet("kai") == "hi kai" { 0 } else { 1 })
