# No non_tail_list_recursion: a search whose self-call is one branch of `or`
# beside another recursing branch has nothing to accumulate.

pub fn matches(p: [Char], cs: [Char]) : Bool = match p {
  [] -> cs == []
  ['*', ...rest] -> matches(rest, cs)
    or (match cs {
      [] -> false
      [_, ...more] -> matches(p, more)
    })
  [c, ...rest] -> match cs {
    [d, ...more] if c == '?' or c == d -> matches(rest, more)
    _ -> false
  }
}

fn main() : Int = 0
