# list_concat_literal_to_spread: a list literal on the left of `++`
# builds an intermediate list and then concatenates; the spread form
# emits the cons directly.

fn prepend_one(t: [Int]) : [Int] = [1] ++ t

fn prepend_two(t: [Int]) : [Int] = [1, 2] ++ t

fn head_or(xs: [Int], d: Int) : Int = match xs {
  [h, ...rest] -> h
  []           -> d
}

fn main() : Int = head_or(prepend_one([9]), 0) + head_or(prepend_two([9]), 0) - 2
