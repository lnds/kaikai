# No non_tail_list_recursion: tail calls, trees, and lists that are not
# the tail of a destructured parameter.

pub fn join_acc(xs: [String], sep: String, acc: [String]) : [String] = match xs {
  []           -> list_reverse(acc)
  [x, ...rest] -> join_acc(rest, sep, [x, sep, ...acc])
}

pub fn count(xs: [Int], n: Int) : Int = match xs {
  []           -> n
  [_, ...rest] -> if n > 100 { n } else { count(rest, n + 1) }
}

pub type Tree = Leaf | Node(Tree, Int, Tree)

pub fn tree_sum(t: Tree) : Int = match t {
  Leaf          -> 0
  Node(l, v, r) -> tree_sum(l) + v + tree_sum(r)
}

pub fn other(xs: [Int]) : Int = list_length(xs)

pub fn len_other(xs: [Int]) : Int = match xs {
  []           -> 0
  [_, ...rest] -> 1 + other(rest)
}

pub fn fresh(xs: [Int], ys: [Int]) : Int = match xs {
  []           -> 0
  [x, ..._]    -> x + fresh(ys, ys)
}

fn main() : Int = 0
