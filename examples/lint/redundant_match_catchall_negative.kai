# redundant_match_catchall must NOT fire on:
#   1. a match that destructures (a constructor / literal pattern) — it
#      does real work no `let` expresses;
#   2. a single-arm match whose arm is GUARDED — the guard is a real
#      branch the direct form would drop;
#   3. a multi-arm match — clearly not a single catch-all;
#   4. a clause-block function, whatever its clauses bind — a parameter
#      that is only passed along still needs a pattern in every clause,
#      and there is no `match` in the source;
#   5. a multi-scrutinee match with a column that only binds.
# The expected linter output for this file is empty.

fn describe(xs: [Int]) : Int = match xs {
  []         -> 0
  [x, ..._]  -> x
}

fn guarded(n: Int) : Int = match n {
  x if x > 0 -> x
  _          -> 0
}

fn classify(n: Int) : Int = match n {
  0 -> 10
  _ -> 20
}

type Event = Up | Down

fn step(n: Int, e: Event) : Int {
  case n, Up -> n + 1
  case n, Down -> n - 1
}

fn pick(n: Int, e: Event) : Int {
  case _, Up -> 1
  case n, Down -> n
}

fn only(e: Event) : Int {
  case _ -> 1
}

fn both(n: Int, e: Event) : Int = match n, e {
  n, Up   -> n
  _, Down -> 0
}

fn main() : Int {
  assert describe([1, 2]) + guarded(1) + classify(0) == 12
  assert step(1, Up) + pick(2, Down) + only(Up) + both(3, Up) == 8
  0
}
