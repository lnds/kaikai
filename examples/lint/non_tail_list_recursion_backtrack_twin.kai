# non_tail_list_recursion still fires on a spread after two heads, and on an
# operand whose sibling does not recurse.

pub fn dup(xs: [Int]) : [Int] = match xs {
  [] -> []
  [x, ...rest] -> [x, x, ...dup(rest)]
}

pub fn all_pos(xs: [Int]) : Bool = match xs {
  [] -> true
  [x, ...rest] -> all_pos(rest) and x > 0
}

fn main() : Int = 0
