# discard_pure_value fires on every dropped value whose type is neither
# Unit nor Nothing, effectful or not.

fn a_pure_int() : Int = 41 + 1

fn parse(s: String) : Result[Int, String] / Stdout = {
  println(s)
  Ok(1)
}

fn show(n: Int) : Unit / Stdout = println("#{n}")

fn main() : Unit / Stdout = {
  a_pure_int()
  parse("1")
  [1, 2] | show
  ()
}
