# discard_pure_value stays silent on an indexed write (its call returns
# the array), a call returning Nothing, `let _ =`, `|> ignore`, and the
# block tail. The expected linter output for this file is empty.

pub effect Failure {
  fail(msg: String) : Nothing
}

fn parse(s: String) : Result[Int, String] / Stdout = {
  println(s)
  Ok(1)
}

fn show(n: Int) : Unit / Stdout = println("#{n}")

fn bail() : Int / Failure = {
  Failure.fail("bad")
  0
}

fn run(a: Array[Int]) : Int / Stdout + Mutable = {
  a[0] := 5
  let _ = parse("1")
  parse("2") |> ignore
  [1, 2] | show |> ignore
  [1, 2] |! show
  a[0]
}

fn main() : Unit / Stdout + Mutable = {
  let r = handle { bail() } with Failure {
    fail(msg, resume) -> msg |> length()
    return(x) -> x
  }
  println("#{r + run(array.from([1, 2]))}")
}
