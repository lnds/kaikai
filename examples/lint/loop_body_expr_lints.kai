# Expression lints reach code written inside a `loop` combinator body:
# the typer lowers `until` / `while` / `repeat` to intrinsics, and each
# finding below sits in such a body.

import loop

fn f(n: Int) : Int = n + 1

fn main() : Unit / Mutable = {
  var b := false
  var i := 0
  repeat(2) {
    b := if 1 > 0 { true } else { false }
    f(2)
    ()
  }
  until { i > 2 } {
    f(3)
    i := i + 1
  }
  while { i < 5 } {
    b := if i > 3 { true } else { false }
    i := i + 1
  }
  ()
}
