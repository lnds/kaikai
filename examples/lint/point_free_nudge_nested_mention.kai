# point_free_nudge sees the parameter mentioned anywhere in a method
# argument, including inside a match or a block: a section cannot bind
# it, so those lambdas are not nudged. The plain chain inside the
# `repeat` body still is.

import loop

fn main() : Unit / Stdout = {
  let xs = ["ab", "cc"]
  let d = xs |? (s) => s.starts_with(match s { "cc" -> "c"  _ -> "z" })
  let e = xs |? (s) => s.starts_with({
    let k = string_slice(s, 1, 1)
    k
  })
  println(string_join(d, ","))
  println(string_join(e, ","))
  repeat(1) {
    let a = xs |? (s) => s.starts_with("a")
    println(string_join(a, ","))
  }
}
