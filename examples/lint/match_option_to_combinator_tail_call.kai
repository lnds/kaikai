pub fn digits(s: String, i: Int, acc: Int) : Option[Int] =
  match char_at(s, i) {
    None    -> Some(acc)
    Some(c) -> if char.is_digit(c) { digits(s, i + 1, acc * 10 + 1) } else { None }
  }

pub fn pair_up(o: Option[Int], n: Int) : Option[Int] =
  match o {
    None    -> None
    Some(x) -> match char_at("ab", n) {
      None    -> None
      Some(_) -> pair_up(Some(x), n + 1)
    }
  }

fn main() : Int = 0
