# dead_code_unused_priv must NOT fire on a private function whose only
# callers are `check`, `test` or `bench` blocks. `never_called` is the
# control: referenced nowhere, it is still reported.

fn double(n: Int) : Int = n * 2

fn halve(n: Int) : Int = n / 2

fn square(n: Int) : Int = n * n

fn never_called(n: Int) : Int = n + 1

check "double is even" with n: Int {
  double(n) % 2 == 0
}

test "halve of four is two" {
  assert(halve(4) == 2)
}

bench "square" {
  square(7)
}

fn main() : Int = 0
