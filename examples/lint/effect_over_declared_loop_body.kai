# effect_over_declared reads effects demanded inside a `loop` combinator
# body: the typer lowers `until` / `while` / `repeat` to intrinsics.
# `Stdout` is used only inside the `repeat` and must not be reported;
# `Stderr` is used nowhere and still is.

import loop

pub fn shout(n: Int) : Unit / Stdout + Stderr = repeat(n) { println("hi") }

fn main() : Unit / Stdout + Stderr = shout(2)
