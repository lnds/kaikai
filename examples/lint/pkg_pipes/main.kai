# Package-mode lint must dispatch both pipe heads a build dispatches:
# the built-in `List` and a user `pub type` whose module exports the
# canonical `map`. Linting builds its own head-owner cache, so a gap
# there rejects idiomatic code the build accepts. Expected: no output.

import box

fn bump(x: Int) : Int = x + 1

fn main() : Unit / Console {
  let b = Box(20) | bump
  print(int_to_string(unwrap(b)))
  print(join(["a", "b"] | int_to_string_id, ","))
}

fn int_to_string_id(s: String) : String = s
