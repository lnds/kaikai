# point_free_nudge: a unary lambda whose body is a field chain over its
# parameter reads cleaner as a leading-dot section.

type Addr = { city: String }
type Person = { name: String, addr: Addr }

fn names(ps: [Person]) : [String] = ps | (c) => c.name

fn cities(ps: [Person]) : [String] = ps | (c) => c.addr.city

fn main() : Int {
  let ps = [Person { name: "a", addr: Addr { city: "x" } }]
  assert (names(ps) |> length()) + (cities(ps) |> length()) == 2
  0
}
