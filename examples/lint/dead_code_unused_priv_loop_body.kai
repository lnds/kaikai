# dead_code_unused_priv must NOT fire on a private function whose only
# call site is the body of a `loop` combinator: the typer lowers
# `until` / `while` / `repeat` to intrinsics, and each body below is the
# sole reference to its helper. The expected linter output is empty.

import loop

fn step(n: Int) : Int = n + 1

fn done(n: Int) : Bool = n > 3

fn bump(n: Int) : Int = n + 2

fn below(n: Int) : Bool = n < 3

fn tick(n: Int) : Int = n * 2

fn main() : Unit / Mutable + Stdout = {
  var i := 0
  until { done(i) } { i := step(i) }
  while { below(i) } { i := bump(i) }
  repeat(2, () => { i := tick(i) })
  println(int_to_string(i))
}
