# dead_code_unused_priv runs on the lowered AST, where every `impl` and
# `#[derive]` method has already become a top-level `__pimpl_*` fn. Those
# are not private functions the user wrote, so they must not be flagged:
# neither remedy the message proposes — remove it, or export it — exists
# for a function the compiler synthesised.
#
# A user-written private fn that really is dead still fires, and so does
# one that merely *looks* synthesised: the exemption is "the source did
# not declare this name at top level", not a name-prefix match.

#[derive(Eq, Show, Ord)]
pub type Color = Red | Green | Blue

#[derive(Eq, Show)]
pub type Point = { x: Int, y: Int }

protocol Greet { greet(x: Self) : String }

impl Greet for Color { fn greet(x: Color) : String = "hi" }

fn __pimpl_Eq_Ghost_eq(a: Int, b: Int) : Bool = a == b

fn really_dead(n: Int) : Int = n * 2

pub fn describe(c: Color) : String = if c == Red { show(c) } else { greet(c) }

fn main() : Int = if describe(Red) == "" { 1 } else { 0 }
