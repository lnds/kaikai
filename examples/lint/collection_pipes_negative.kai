# The collection pipes `|`, `||` and `|?` dispatch on the built-in
# `List` head, which no module declares as a `pub type` — the linter
# builds no module table, so it must seed that head itself or every
# pipe is rejected with "no module declaring type `List` is in scope"
# on code the build accepts. The expected linter output is empty.

fn shout(s: String) : String = "#{s}!"

fn dup(s: String) : [String] = [s, s]

fn keep(s: String) : Bool = s != "b"

fn size(xs: [String]) : Int = xs.length()

fn main() : Unit = {
  println(join(["a", "b"] | shout, ","))
  println(join(["a", "b"] || dup, ","))
  println(join(["a", "b"] |? keep, ","))
  println(int_to_string(["a", "b"] |> size))
}
