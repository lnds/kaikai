# non_tail_list_recursion fires when a fn recurses on the tail of a list
# parameter it destructured and the call is not the last thing it does.

pub fn join_loop(xs: [String], sep: String) : [String] = match xs {
  []           -> []
  [x, ...rest] -> [sep, x, ...join_loop(rest, sep)]
}

pub fn sum(xs: [Int]) : Int = match xs {
  []           -> 0
  [x, ...rest] -> x + sum(rest)
}

pub fn double(n: Int) : Int = n * 2

pub fn total(xs: [Int]) : Int = match xs {
  []           -> 0
  [_, ...rest] -> total(rest) |> double
}

pub type Chain = End | Link(Int, Chain)

pub fn bump(c: Chain) : Chain = c

pub fn wrapped(xs: [Int]) : Chain = match xs {
  []           -> End
  [x, ...rest] -> Link(x, bump(wrapped(rest)))
}

pub type Pair = { head: Int, tail: Int }

pub fn map_eff[e](xs: [Int], f: (Int) -> Int / e) : [Int] / e = match xs {
  []           -> []
  [x, ...rest] -> [f(x), ...map_eff(rest, f)]
}

pub fn pair_up(xs: [Int]) : Pair = match xs {
  []           -> Pair { head: 0, tail: 0 }
  [x, ...rest] -> Pair { head: x, tail: pair_up(rest).tail }
}

fn main() : Int = 0
