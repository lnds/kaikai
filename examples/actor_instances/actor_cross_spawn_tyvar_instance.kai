# The child's own mailbox covers its instance only: the parent's, at another
# type variable, still crosses the spawn.

import actor
import spawn.{spawn, await}

fn take[t]() : Option[t] / Actor[Option[t]] = Actor.receive()

fn relay[a, b](v: Option[a]) : Option[b] / Spawn + Cancel + Actor[Option[b]] =
  await(
    spawn(
      () => with_mailbox {
        let me: Pid[Option[a]] = Actor.self()
        Actor.send(me, v)
        let got: Option[b] = take()
        got
      }
    )
  )

fn main() : Unit = ()
