# Two labels of one effect naming the same type variable inside a larger type
# are one instance, so the handler around them discharges all of them.

import actor
import spawn.{spawn, await}

pub type Msg = Job((Int) -> Unit / Actor[Msg])

type Both[a, b] = Both(a, b)

effect Box[t] {
  put(x: t) : Unit
  get() : t
}

fn with_box[t, r, e](init: t, body: () -> r / Box[t] + e) : r / e =
  handle {
    body()
  } with Box[t] {
    put(x, resume) -> resume(())
    get(resume) -> resume(init)
  }

fn serve(n: Int) : Unit / Actor[Msg] = match Actor.receive() {
  Job(run) -> run(n)
}

fn ask[a](to: Pid[Msg], work: (Int) -> Result[a, String]) : Result[a, String] / Spawn + Cancel =
  await(
    spawn(
      () => with_mailbox {
        let me: Pid[Result[a, String]] = Actor.self()
        Actor.send(to, Job(n => Actor.send(me, work(n))))
        Actor.receive()
      }
    )
  )

fn echo_pair[a, b](x: a, y: b) : Both[a, b] / Spawn + Cancel =
  await(
    spawn(
      () => await(
        spawn(
          () => with_mailbox {
            let me: Pid[Both[a, b]] = Actor.self()
            Actor.send(me, Both(x, y))
            Actor.receive()
          }
        )
      )
    )
  )

fn count_after[a](xs: [a]) : Int / Spawn + Cancel =
  await(
    spawn(
      () => with_mailbox {
        let me: Pid[[a]] = Actor.self()
        Actor.send(me, xs)
        let got: [a] = Actor.receive()
        list_length(got)
      }
    )
  )

fn unbox[a](v: Result[a, String]) : Result[a, String] =
  with_box(v) {
    let x: Result[a, String] = Box.get()
    Box.put(x)
    Box.get()
  }

fn show(r: Result[Int, String]) : String = match r {
  Ok(n) -> "ok #{n}"
  Err(m) -> "err #{m}"
}

fn main() : Unit / Console + Spawn + Cancel {
  let worker: Pid[Msg] = spawn_actor(() => serve(21))
  println(show(ask(worker, n => Ok(n * 2))))
  match echo_pair(7, "seven") {
    Both(n, s) -> println("#{n} #{s}")
  }
  println("#{count_after([1, 2, 3])}")
  println(show(unbox(Ok(5))))
}
