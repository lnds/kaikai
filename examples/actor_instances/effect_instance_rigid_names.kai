# Diagnostics name a declared type parameter as the source does; two rigid
# instances stay apart.

pub effect Box[t] {
  get() : t
}

fn crossed[elem, other]() : Option[elem] / Box[Option[other]] {
  let x: Option[elem] = Box.get()
  x
}

fn not_an_int[item](xs: [item]) : Int = xs

fn main() : Unit = ()
