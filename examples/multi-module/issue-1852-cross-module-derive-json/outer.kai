import encoding.json.{json_decode}
import inner

#[derive(Json)]
pub type Outer = { i: inner.Inner, ls: [inner.Inner] }

#[doc("Decode `s` into an `Outer` and summarise what the nested fields read back as.")]
pub fn decode_outer(s: String) : String = match json_decode(s) {
  None -> "bad json"
  Some(v) -> match outer_of_json(v, "") {
    Err(_) -> "err"
    Ok(o) -> match o.ls {
      [a, b] -> "ok n=#{o.i.n} a=#{a.n} b=#{b.n}"
      _      -> "bad ls"
    }
  }
}
