# A module is allowed to declare `map` / `filter` / `each`: a qualified
# call resolves to the module's body, not to the builtin, so there is no
# shadowing to reject. Only an unqualified declaration in the program's
# own root file loses to the builtin.

import seq

fn main() : Unit / Console = {
  println(int_to_string(seq.map(20, (x) => x + 1)))
  println(int_to_string(seq.filter(16, (x) => x > 10)))
  println(int_to_string(seq.each(41)))
}
