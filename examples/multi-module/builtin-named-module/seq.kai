#[doc("A module may declare operations named after core builtins; callers reach them qualified, so the builtin is not in the way.")]

#[doc("Applies `f` to `n` — named after the `map` builtin on purpose.")]
pub fn map(n: Int, f: (Int) -> Int) : Int = f(n)

#[doc("Doubles `n` when it passes `p`, else returns it unchanged — named after the `filter` builtin on purpose.")]
pub fn filter(n: Int, p: (Int) -> Bool) : Int = if p(n) { n * 2 } else { n }

#[doc("Adds one to `n` — named after the `each` builtin on purpose.")]
pub fn each(n: Int) : Int = n + 1
