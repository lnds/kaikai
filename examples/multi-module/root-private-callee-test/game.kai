import ent as e

pub fn step(bs: [e.Bullet]) : Int =
  match bs {
    [] -> 0
    _  -> advance(bs)
  }

fn advance(bs: [e.Bullet]) : Int = count(bs) + 1

fn count(bs: [e.Bullet]) : Int = bs |> length()

test "a public fn calls a private fn that calls another" {
  assert step([]) == 0
  assert step([e.Bullet { x: 1, y: 2 }]) == 2
}
