import shape

impl Show for shape.Shape {
  fn show(s: shape.Shape) : String = match s {
    shape.Sq(n) -> "Sq(" ++ int_to_string(n) ++ ")"
  }
}

impl[T: Show] Show for shape.Pair[T] {
  fn show(p: shape.Pair[T]) : String = match p {
    shape.Pair(a, b) -> "(" ++ show(a) ++ ", " ++ show(b) ++ ")"
  }
}
