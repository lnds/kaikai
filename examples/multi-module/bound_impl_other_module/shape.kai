pub type Shape = Sq(Int)

pub type Pair[t] = Pair(t, t)

pub fn render[t: Show](x: t) : String = show(x)

impl Show for Shape {
  fn show(s: Shape) : String = match s {
    Sq(n) -> "Sq(" ++ int_to_string(n) ++ ")"
  }
}

impl[t: Show] Show for Pair[t] {
  fn show(p: Pair[t]) : String = match p {
    Pair(a, b) -> "(" ++ show(a) ++ ", " ++ show(b) ++ ")"
  }
}
