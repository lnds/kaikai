# An impl of a CORE protocol for another module's type is legal when the
# head of a protocol argument is declared here.

import level

type Delta = Delta(Int)

impl Add[Delta] for level.Level {
  fn add(self: level.Level, rhs: Delta) : level.Level = match self {
    level.Level(n) -> match rhs { Delta(d) -> level.Level(n + d) }
  }
}

fn main() : Unit / Stdout = match level.Level(1) + Delta(2) {
  level.Level(n) -> Stdout.print(int_to_string(n))
}
