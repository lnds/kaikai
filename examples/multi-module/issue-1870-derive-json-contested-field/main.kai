# `Item` is declared by both imports, so the bare name is contested.
# The selective import decides which one this file means — including
# inside the derive-wrapped record, whose nested decoder call is
# mangled from the resolved home.
import encoding.json.{json_decode, json_encode}
import parts.{Item}
import labels

#[derive(Json)]
pub type Crate = { one: Item, rest: [Item] }

fn decode_crate(src: String) : String = match json_decode(src) {
  None -> "bad json"
  Some(v) -> match crate_of_json(v, "") {
    Ok(c)  -> "crate #{c.one.id}/#{list_length(c.rest)}"
    Err(e) -> json_error_show(e)
  }
}

fn main() : Unit / Console = {
  let c = Crate { one: Item { id: 7 }, rest: [Item { id: 8 }, Item { id: 9 }] }
  let s = json_encode(to_json(c))
  print(s)
  print(decode_crate(s))
  print(labels.label().text)
}
