fn lit() : Vec[Int] = [10, 20, 30]

fn blank(n: Int) : Vec[Bool] = [1..n] | ((i) => false)

fn squares(n: Int) : Vec[Int] = [1..n] | ((i) => i * i)

fn doubled(xs: [Int]) : Vec[Int] = xs | ((x) => x * 2)

fn tail_lit(n: Int) : Vec[Int] {
  let k = n + 1
  [k, k + 1]
}

fn tail_pipe(n: Int) : Vec[Int] {
  let k = n
  [1..k] | ((i) => i + k)
}

fn main() : Unit / Stdout = {
  println("#{vec_length(lit())} #{vec_get(lit(), 2)}")
  println("#{vec_length(blank(3))}")
  println("#{vec_get(squares(4), 3)}")
  println("#{vec_get(doubled([1, 2, 3]), 2)}")
  println("#{vec_get(tail_lit(1), 1)}")
  println("#{vec_get(tail_pipe(3), 2)}")
}
