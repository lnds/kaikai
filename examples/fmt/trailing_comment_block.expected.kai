# A comment closing a block body documents that body: it stays inside
# the braces, where its author put it, and never drifts onto whatever
# the formatter emits next.
fn cierre_simple() : Int {
  let x = 1
  x
  # cierre de cierre_simple
}

# Inside a match arm the drift is worse: between the arms every
# convention reads the comment as documenting the next one.
fn por_caso(n: Int) : Int =
  match n {
    0 -> {
      let x = 1
      x
      # solo el caso cero
    }
    _ -> 2
  }

# A blank the author left above the closing comment survives with it.
fn con_blanco() : Int {
  let y = 2
  y

  # explicacion separada del cuerpo
}

# A lone statement still owns the comment that closes its block.
fn una_sola() : Int {
  1
  # cierre de una_sola
}

# A comment with code below it inside the same block does not move.
fn no_se_mueve() : Int {
  let z = 3
  # sobre el retorno
  z
}

fn despues() : Int = 0
