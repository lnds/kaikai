# The eight desugar families whose spellings the parser once erased:
# collection literals, BigInt literals, Ref sugar, record spread /
# positional / punning, pipe and point-free placeholders, row holes,
# multi-arg match, and `case`-block bodies.

type Point = { x: Int, y: Int }

fn colls() : Int {
  let m = %{ "a": 1, "b": 2 }
  let m2 = %{ ...m, "c": 3 }
  let s = %[ 1, 2, 3 ]
  let s2 = %[ ...s, 4 ]
  let e = %{}
  let es = %[]
  0
}

fn big() : Int {
  let b = 123456789012345678901234567890n
  0
}

fn refs() : Int {
  let c = &0
  let p = Point { x: @c, y: 4 }
  (@c) + p.y
}

fn records(src: Point) : Point {
  let x = 1
  let y = 2
  let a = Point { ...src, x: 10 }
  let b = Point { 5, 6 }
  let c = Point { x, y }
  a
}

fn pipes(xs: [Int]) : Int {
  let a = 5 |> three(1, _, 9)
  let n = count(xs, . > 2)
  a + n
}

fn three(a: Int, b: Int, c: Int) : Int = a + b + c

fn count(xs: [Int], p: (Int) -> Bool) : Int = match xs {
  [] -> 0
  [h, ...t] -> if p(h) { 1 + count(t, p) } else { count(t, p) }
}

fn holey() : Unit / ?e = Stdout.print("hole")

fn classify2(a: Int, b: Int) : String = match a, b {
  0, 0 -> "both-zero"
  0, _ if b > 3 -> "first-zero-big"
  _, _ -> "other"
}

fn pick(a: Int, b: Int) : String {
  case x, y when x > y -> "first"
  case _, _ -> "rest"
}
