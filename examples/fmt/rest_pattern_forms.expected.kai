# The three rest-binder spellings round-trip verbatim: bare `...`,
# uniform-with-wildcard `..._`, and the named `...t`.

fn head_or(xs: [Int], d: Int) : Int = match xs {
  [] -> d
  [h, ..._] -> h
}

fn first_or(xs: [Int], d: Int) : Int = match xs {
  [] -> d
  [h, ...] -> h
}

fn rest_len(xs: [Int]) : Int = match xs {
  [] -> 0
  [_, ...t] -> 1 + rest_len(t)
}

fn main() : Int = (head_or([1], 0) + first_or([2], 0)) + rest_len([1, 2])
