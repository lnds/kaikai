type Point = (Int,Int)

fn swap(p: (Int,Int)) : (Int, Int) = ( p.snd , p.fst )

fn pick(p: (Int, Int)) : Int = match p {
  (a,b) -> a + b
}

fn tri(t: (Int,String,Bool)) : String = match t {
  (n, s, true) -> s
  ( _ , s, false ) -> s
}

fn nested(np: ((Int, Int), Int)) : Int = match np {
  ((a,b), c) -> (a + b) + c
}

fn main() {
  let t = (1,2,3)
  let q = (1, 2, 3, 4,)
  let (a, b) = (t.fst, q.frt)
  let pairs: [(Int, Int)] = [(1,2), (3, 4)]
  let sums = pairs | { (x,y) -> x + y }
  print("#{a + b}")
}
