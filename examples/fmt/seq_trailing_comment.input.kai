# A trailing comment on the last line of a multi-line item stays with
# that item; it does not become a leading comment of the next.
fn configs() : [Cfg] = [
  Cfg {
    host: "a"
  }, # first
  # second, leading
  Cfg {
    host: "b"
  }
]

fn total() : Int = combine(
  build(
    1,
    2
  ), # after the multi-line argument
  other(3), # after the single-line argument
  last(4)
)

# In a packed list the comment closes its row; the next row is not
# swallowed into it.
fn primes() : [Int] = [
  2, 3, 5, # first row
  7, 11, 13 # second row
]
