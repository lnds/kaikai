# `:=` writes round-trip verbatim in every LHS shape: scalar cell,
# indexed, and field path. None of them may surface the `.set` desugar.

type Cell = { slot: Ref[Int] }

fn bump() : Int {
  var acc := 0
  acc := acc + 1
  acc := acc * 2
  acc
}

fn poke(c: Cell) : Unit / Mutable {
  c.slot := 42
}

fn fill() : Unit / Mutable {
  let arr = array_make(3, 0)
  arr[0] := 7
}

fn main() : Int = bump()
