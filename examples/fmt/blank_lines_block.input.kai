# Blank lines inside a body: a run collapses to one, a blank opening or
# closing the block goes, and the ones between the steps survive.
fn resumen(a: Int, b: Int) : Int {

  let suma = a + b


  let doble = suma * 2



  let total = doble + b

  total

}

fn sin_blancos(x: Int) : Int {
  let y = x + 1
  y
}
