fn pick(k: Int) : String =
  match k {
    0 -> "zero"
    _ -> match k {
      0 -> "zero"
      _ -> match k {
        0 -> "zero"
        _ -> match k {
          0 -> "zero"
          _ -> match k {
            0 -> "zero"
            _ -> match k {
              0 -> "zero"
              _ -> match k {
                0 -> "zero"
                _ -> match k {
                  0 -> "zero"
                  _ -> match k {
                    0 -> "zero"
                    _ -> match k {
                      0 -> "zero"
                      _ -> match k {
                        0 -> "zero"
                        _ -> match k {
                          0 -> "zero"
                          _ -> match k {
                            0 -> "zero"
                            _ -> match k {
                              0 -> "zero"
                              _ -> match k {
                                0 -> "zero"
                                _ -> match k {
                                  0 -> "zero"
                                  _ -> "deep"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

fn main() : Unit / Stdout = Stdout.print(pick(0))
