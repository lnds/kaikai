# A trailing comment stays attached to the variant it followed, even
# when only some variants carry one.
pub type Style
  = Plain
  | Fg(Int)  # 256-color foreground
  | FgBold(Int)  # foreground + bold
  | Dim
  | Selected(Int)  # a selected row: colored background, dark fg

# The first variant sits on the `=` line in the input and moves onto
# its own line in the canonical form; its comment moves with it.
pub type T
  = A  # comment about A
  | B

# A leading comment block between variants documents the variant below
# it, not the one above.
pub type Shape
  = Circle(Int)
  # a rectangle, given width and height
  | Rect(Int, Int)
  | Point  # the degenerate case

fn main() : Unit / Stdout = println("variant comments")
