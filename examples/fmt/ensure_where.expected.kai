# `ensure(value) where pred` is a surface form: the writer must not
# leak its block desugar, in either the full-predicate or the
# leading-comparator (elided `self`) spelling.

fn from_int_port(n: Int) : Option[Int] = ensure(n) where (1 <= self) and (self <= 65535)

fn from_int_nonneg(n: Int) : Option[Int] = ensure(n) where >= 0

fn main() : Int = 0
