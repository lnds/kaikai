# A trailing comment stays on the line it annotates, wherever it sits.

import loop   # the trailing-block loops

const grid_len : Int = 768   # cols * rows

pub const limit : Int = 3   # public

const wrapped : Int =
  1 + 2   # on the wrapped value

type Cell = { alive: Bool,   # state
  age: Int }   # generations

fn classify(n: Int) : Int = match n {
  0 -> 0   # empty
  _ -> 1   # occupied
}

fn main() : Unit / Mutable + Stdout = {
  var i := 0
  until { i > limit } {
    i := i + 1 + classify(i)   # step
    println(int_to_string(i))   # show
  }
  ()
}

const last : Int = 9   # the final decl
