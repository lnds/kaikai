# An inline `if` that overflows its head line hangs below `=` when it
# fits there whole.
fn pick(alpha_value: Int, beta_value: Int, gamma_value: Int) : Int =
  if alpha_value > beta_value { alpha_value + gamma_value } else { beta_value + gamma_value }

# One that fits nowhere on a line takes the block form.
fn describe(alpha_value: Int, beta_value: Int) : String = if alpha_value > beta_value {
  "the first value is the larger of the two"
} else {
  "the second value is at least as large as the first"
}

fn describe_stmt(alpha_value: Int, beta_value: Int) : Unit / Stdout {
  if alpha_value > beta_value {
    Stdout.print("the first value is the larger of the two")
  } else {
    Stdout.print("the second")
  }
}
