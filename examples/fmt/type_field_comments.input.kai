# A record whose fields carry comments expands to one field per line
# so each comment stays with its own field instead of being pushed
# past the closing brace.
pub type M = {
  a: Int,      # field a
  b: Int
}

# Mixed leading blocks and trailing comments, both anchored per field.
pub type Config = {
  # where the output goes; empty means stdout
  path: String,
  verbose: Bool,     # chattier diagnostics
  retries: Int       # how many times to re-attempt on failure
}

# A record with no field comments keeps the canonical single-line form.
pub type P = { x: Int, y: Int }

fn main() : Unit / Stdout = println("field comments")
