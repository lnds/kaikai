# A `requires` clause subsumed by — but not identical to — the
# parameter's own refinement stays in the text. Whether the clause is
# redundant for checking is a typer conclusion; it must not change
# what `kai fmt` emits.

import regexp.{matches}

fn shout(s: String where matches ~r/^[a-z]+$/) : String requires matches(s, ~r/^[a-z0-9]+$/) = s

fn echo(s: String where matches ~r/^[a-c]+$/) : String requires matches(s, ~r/^[a-z]+$/) = s

fn same(s: String where matches ~r/^[a-z]+$/) : String requires matches(s, ~r/^[a-z]+$/) = s

fn trivial(a: Int) : Int requires true = a

fn main() : Int = 0
