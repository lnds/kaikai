effect Log {
  say(s: String) : Unit
}

effect Tick {
  tick() : Unit
}

type Curried = (Int) -> ((Int) -> Int) / Log

type Maker = { make: (Int) -> ((Int) -> Int) / Log }

type Plain = (Int) -> Int

axiom mk() : ((Int) -> Int) / Log

fn pick() : ((Int) -> Int) / Log {
  Log.say("pick")
  (x: Int) => x + 1
}

fn both() : ((Int) -> Int / Tick) / Log {
  Log.say("both")
  (x: Int) => x
}

fn positive(n: Int) : (Int where self > 0) / Log {
  Log.say("positive")
  n
}

fn apply(f: (Int) -> (Int where self > 0) / Log) : Int / Log = f(1)

fn keep(f: ((Int) -> Int) where true) : Int = f(1)

fn hold[e](f: () -> Int / e) : (() -> Int) / e {
  let v = f()
  () => v
}

fn same(f: (Int) -> Int) : (Int) -> Int = f

fn main() : Int {
  let _later: () -> ((Int) -> Int) / Log = () => pick()
  hold(() => keep(same((a: Int) => a)))()
}
