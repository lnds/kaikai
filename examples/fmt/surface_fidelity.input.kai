# Surface-fidelity matrix: forms the parser moves or normalises on
# the way into the AST. Each must survive `kai fmt` — a form that
# only lives in a side-table or dissolves into its lowering gets
# silently rewritten, and this golden is the net that catches it.

#[doc("Sums a list; the bound is the documented API surface.")]
pub fn total[T : Numeric](xs: [T], acc: T) : T {
  match xs {
    [] -> acc
    [h, ...t] -> total(t, acc + h)
  }
}

fn shown[T: Show + Eq](x: T, y: T) : Bool = x == y

fn scale[u: Measure](x: Real<u>) : Real<u> = x

type NonNeg = Int where self >= 0

fn bump(n: Int) : Int requires n > 0 ensures result > 1 = n + 1

fn run(f: () -> Int) : Int = f()

fn both(a: () -> Int, b: () -> Int) : Int = a() + b()

fn apply1(f: (Int) -> Int, n: Int) : Int = f(n)

fn splat(f: ((Int, Int)) -> Int) : Int = f((3, 4))

fn rest_shapes(xs: [Int]) : Int {
  match xs {
    [] -> 0
    [x, ..._] -> x
  }
}

fn main() : Unit / Stdout {
  let a = run { 1 + 1 }
  let b = both { 1 } { 2 }
  let c = run { -> 9 }
  let d = apply1({ x -> x + 1 }, 3)
  let e = splat { (l, r) -> l + r }
  let f = run {
    let t = 2
    t + t
  }
  let xs = [1, 2, 3] | { n -> n * 2 }
  let h = (x: Int) => x * 2
  var i := 0
  i := i + 1
  println("#{a + b + c + d + e + f + h(i)} #{xs} #{total([1], 0)} #{shown(1, 1)} #{bump(rest_shapes([1]))}")
}
