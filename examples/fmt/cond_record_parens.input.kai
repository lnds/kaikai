# A record literal opening an if-condition or match-scrutinee keeps
# its delimiting parentheses: without them the `{` of the literal is
# read as the start of the block.

type Cfg = { v: Int }

type Pair2 = { fst: Int, snd: Int }

fn pick(a: Int, b: Int) : Int {
  if (Cfg { v: a }.v == 2) {
    1
  } else {
    match (Pair2 { fst: a, snd: b }) {
      { fst: 0, snd } -> snd
      { fst, snd: _ } -> fst
    }
  }
}

fn main() : Int = pick(2, 3)
