# A blank line inside a body is the author's paragraph break: it marks
# the steps of a function and the writer keeps it, exactly as it keeps
# the blank lines between top-level declarations.
fn resumen(a: Int, b: Int) : Int {
  let suma = a + b
  let producto = a * b

  let doble = suma * 2

  let total = doble + producto

  total
}

fn etapas(xs: [Int]) : [Int] {
  let dobles = xs | (x => x * 2)

  # A comment keeps the blank the author left above it.
  let filtrados = dobles |? (x => x > 4)

  filtrados
}
