# Declarations the writer already breaks structurally: the corpus
# control for "wide decl bodies", not for the `=` body collapse.
type Token
  = Word(String)
  | Number(Int)
  | Symbol(Char)
  | Space
  | Newline
  | Eof

type Options = { verbose: Bool, colour: Bool, width: Int, tabs: Int, name: String }
