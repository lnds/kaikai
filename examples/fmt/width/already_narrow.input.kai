# CONTROL — everything fits with room to spare, and the file is already
# a fixed point of the writer. A width-aware writer must leave it byte
# for byte as it is: no line here needs breaking, so any new break is
# the writer inventing work.
type Point = { x: Int, y: Int }

fn origin() : Point = Point { x: 0, y: 0 }

fn shift(p: Point, dx: Int, dy: Int) : Point = Point { x: p.x + dx, y: p.y + dy }

fn norm1(p: Point) : Int = abs(p.x) + abs(p.y)
