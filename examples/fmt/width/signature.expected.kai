# A signature whose parameter list does not fit beside the name.
type Conn = { id: Int, host: String }

fn connect(
  host: String,
  port: Int,
  user: String,
  password: String,
  timeout_ms: Int
) : Conn / Stdout {
  Stdout.print(host)
  Conn { id: port + timeout_ms, host: string_concat(user, password) }
}
