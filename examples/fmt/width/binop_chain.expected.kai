# An operator chain the author wrapped with leading operators, the
# continuation form `kai info syntax` documents.
fn score(base: Int, bonus: Int, penalty: Int, streak: Int) : Int {
  let total = (((base * 10) + (bonus * 3)) + (penalty * 7)) + (streak * streak)
  total
}

fn eligible(age: Int, active: Bool, verified: Bool, strikes: Int) : Bool {
  let ok = (((age >= 18) and active) and verified) and (strikes == 0)
  ok
}
