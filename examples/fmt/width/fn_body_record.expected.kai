# An `=` body the author put on its own line so the record literal fits.
type Cfg = { host: String, port: Int, retries: Int, verbose: Bool }

fn build(host: String, port: Int, retries: Int, verbose: Bool) : Cfg = Cfg { host: host, port: port, retries: retries, verbose: verbose }

fn defaults() : Cfg = Cfg { host: "localhost", port: 8080, retries: 3, verbose: false }
