# A sum body asks the width the same three questions a record body
# asks: a variant carrying a comment, a break the author wrote, or a
# one-line form that does not fit each take a line per variant.
type Color = Rojo | Verde | Azul

type Error = NoDefinida(String)

type Token
  = Word(String)
  | Number(Int)
  | Symbol(Char)

type Shape = Circle(Real) | Square(Real) | Rect(Real, Real) | Triangle(Real, Real, Real) | Point
