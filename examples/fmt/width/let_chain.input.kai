# Statement bodies: each `let` right-hand side is a call that overflows.
fn summarize(rows: [String], sep: String, label: String) : String {
  let joined = string_join(rows, sep)
  let header = string_concat_all([label, " count=", int_to_string(list_length(rows)), " separator=", sep])
  let footer = string_concat_all([label, " bytes=", int_to_string(string_length(joined))])
  string_join([header, joined, footer], "\n")
}
