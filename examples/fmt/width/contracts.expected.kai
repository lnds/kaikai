# Contract clauses are a group with a break point before each clause.
# A run that fits stays on the signature line; one that does not takes
# a line per clause, and the `=` opens at the margin below them so no
# clause line ends on a dangling opener.
type Cuenta = { titular: String, saldo: Int }

fn abonar(n: Int) : Int requires n > 0 ensures result > n = n + 1

fn retirar(cuenta: Cuenta, monto: Int, comision_fija: Int) : Cuenta
  requires monto > 0
  requires comision_fija >= 0
  requires cuenta.saldo >= monto + comision_fija
  ensures result.saldo == cuenta.saldo - monto - comision_fija
=
  Cuenta { ...cuenta, saldo: cuenta.saldo - monto - comision_fija }

fn transferir(origen: Cuenta, destino: Cuenta, monto: Int) : Cuenta
  requires monto > 0
  requires origen.saldo >= monto
  ensures result.saldo == destino.saldo + monto
{
  Cuenta { ...destino, saldo: destino.saldo + monto }
}
