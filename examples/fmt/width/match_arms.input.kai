# Arm bodies long enough to need their own line.
type Token = Word(String) | Number(Int) | Symbol(Char) | Space

fn describe(t: Token, label: String) : String = match t {
  Word(w)   -> string_concat_all([label, " word(", w, ") of length ", int_to_string(string_length(w))])
  Number(n) -> string_concat("number ", int_to_string(n))
  Symbol(c) -> string_concat("symbol ", char_to_string(c))
  Space     -> "space"
}
