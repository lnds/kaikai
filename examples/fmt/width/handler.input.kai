# Handler clause bodies past the budget.
effect Logger {
  log(s: String) : Unit
}

fn run(name: String, label: String) : Int / Stdout = handle {
  Logger.log(name)
  0
} with Logger {
  log(s, resume) -> {
    Stdout.print(
      string_concat_all(["[log] ", label, " ", s, " (", int_to_string(string_length(s)), ")"])
    )
    resume(())
  }
  return(x) -> x
}
