# A comment closing a block body is authorial attachment, not layout:
# the writer keeps it under the statement it follows and inside the
# braces it was written in, whatever the width budget does around it.
fn precio_total(unidades: Int, unitario: Int, descuento: Int) : Int {
  let bruto = unidades * unitario
  let neto = bruto - bruto * descuento / 100
  neto
  # Mezclar unidades incompatibles seria un error de compilacion.
}

fn clasificar(n: Int, umbral: Int, etiqueta: String) : String =
  match n {
    0 -> {
      let vacio = string_concat(etiqueta, ": sin elementos que reportar")
      vacio
      # Solo el caso cero: el resto cae en la rama general.
    }
    _ -> {
      let muchos = string_concat(etiqueta, ": por encima del umbral fijado")
      if n > umbral { muchos } else { etiqueta }
    }
  }
