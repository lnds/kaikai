# A record literal holding record literals.
type Addr = { street: String, city: String, country: String }

type Person = { name: String, age: Int, home: Addr, work: Addr }

fn sample() : Person =
  Person {
    name: "ana",
    age: 34,
    home: Addr { street: "Te Pito", city: "Hanga Roa", country: "CL" },
    work: Addr { street: "Atamu Tekena", city: "Hanga Roa", country: "CL" }
  }
