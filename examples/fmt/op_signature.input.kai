# Effect and protocol operation signatures break on width like a
# function signature: one parameter per line, the return type riding
# the closer.
effect Store {
  put_many(
    key: String,
    value: String,
    another: String,
    more: Int,
    still_more: Bool,
    last: Int
  ) : Unit
  get(key: String) : Option[String]
}

protocol Renderable {
  render_with_options(
    x: Self,
    width: Int,
    height: Int,
    background: String,
    foreground: String
  ) : String
  name(x: Self) : String
}

# A parameter list the author broke stays broken.
protocol Sized {
  size(
    x: Self
  ) : Int
}

# A type alias body hangs below `=` when it fits there, and its type
# arguments break one per line when it does not.
type Table =
  HashMap[String, Result[Option[[String]], HashMap[String, Result[Option[[String]], Int]]]]

type Wide = HashMap[
  String,
  Result[Option[[String]], HashMap[String, Result[Option[[String]], HashMap[String, Int]]]]
]

type Pair = (
  String,
  Int
)

fn lookup(a: Int) : HashMap[
  String,
  Result[Option[[String]], HashMap[String, Result[Option[[String]], Int]]]
] = todo!("lookup")
