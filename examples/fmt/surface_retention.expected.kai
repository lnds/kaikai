# Spellings the parser once discarded or fused: the `as` keyword form,
# the `mod.` pattern qualifier, the `initially { }` clause vs `(init)`,
# an arm narrowing welded with a user guard, and the `<...>` interior.

kind Currency : AbelianGroup with cur

unit USD

cur USD

effect Counter {
  tick() : Int
}

fn hold(x: Real<cur.USD>) : Real< Currency.USD > = x

fn classify(x: Int, cap: Int) : String = match x {
  v : Int where >= 0 if v < cap -> "small"
  v : Int where >= 0 -> "big"
  _ -> "negative"
}

fn describe(s: BillStatus) : String {
  match s {
    billing.Pending -> "pending"
    billing.Paid -> "paid"
  }
}

fn heads(xs: [Int]) : Int {
  match xs {
    list as [first, ..._] -> first + list_length(list)
    legacy @ [] -> list_length(legacy)
  }
}

fn run_both() : Int {
  let a = handle {
    tick()
  } with Counter {
    initially {
      10
    }
    tick(resume) -> resume(1)
  }
  let b = handle {
    tick()
  } with Counter(0) {
    tick(resume) -> resume(2)
  }
  a + b
}
