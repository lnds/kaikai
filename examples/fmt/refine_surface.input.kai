import regexp

import regexp.{matches}

type Slug = String where matches ~r/^[a-z][a-z0-9-]{0,30}$/

type Pos = Int where >= 0

type Port = Int where (1 <= self) and (self <= 65535)

type Even = Int where (self % 2) == 0

fn explicit(s: String, p: Regex) : Bool = matches(s, p)

fn hand(p: String) : Regex = regexp.compile_or_panic(p)

fn sigil() : Regex = ~r/^[0-9]+$/

fn main() : Unit = ()
