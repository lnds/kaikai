# Contract clauses before a block body print on their own lines with
# the `{` opening the body below them — the collapsed one-line shape
# does not re-parse.

fn divide(a: Int, b: Int) : Int
  requires b != 0
  ensures (result * b) == a
{
  a / b
}

fn clamp(a: Int) : Int
  requires a > 0
  requires a < 100
{
  a + 1
}

fn main() : Int = divide(10, 2) + clamp(5)
