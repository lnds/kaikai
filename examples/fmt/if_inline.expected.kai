# An `if` the author wrote on one line stays on one line when it fits.
fn abs(x: Int) : Int = if x > 0 { x } else { 0 - x }

fn sign(x: Int) : Int = if x > 0 { 1 } else if x < 0 { 0 - 1 } else { 0 }

fn report(x: Int) : Unit / Stdout {
  let label = if x > 10 { "big" } else { "small" }
  if x > 100 { Stdout.print("huge") } else { Stdout.print(label) }
  var n := 0
  if x > 0 { n := x }
  Stdout.print(int_to_string(n))
}

fn count(xs: [Int], p: (Int) -> Bool) : Int = match xs {
  [] -> 0
  [h, ...t] -> if p(h) { 1 + count(t, p) } else { count(t, p) }
}

# An `if` the author broke stays broken, whatever its width.
fn abs_block(x: Int) : Int =
  if x > 0 {
    x
  } else {
    0 - x
  }

fn abs_else_below(x: Int) : Int = if x > 0 {
  x
} else {
  0 - x
}

# A branch holding more than one statement is never joined.
fn abs_logged(x: Int) : Int / Stdout =
  if x > 0 {
    Stdout.print("pos")
    x
  } else {
    0 - x
  }
