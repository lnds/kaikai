# Kind-annotated and bounded type parameters round-trip in every
# position: protocol head, fn head, impl head (bounds).

protocol Container[s: Shape] {
  first(xs: s[Int]) : Int
}

fn area_of[u: Measure](w: Real<u>, h: Real<u>) : Real<u^2> = w * h

type Wrap[T] = { inner: T }

impl[T: Show + Eq] Show for Wrap[T] {
  fn show(w: Wrap[T]) : String = "Wrap"
}

impl[T: Show] Eq for Wrap[T] {
  fn eq(a: Wrap[T], b: Wrap[T]) : Bool = show(a.inner) == show(b.inner)
}

fn main() : Int = 0
