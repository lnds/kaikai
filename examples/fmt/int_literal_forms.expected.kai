fn main() : Int {
  let hex = 0xFF
  let hex_upper = 0XAB
  let bin = 0b1010
  let bin_upper = 0B1101
  let dec_sep = 1_000_000
  let hex_sep = 0xDEAD_BEEF
  let bin_sep = 0b1010_0101
  let mask = 0xFFFFFFFFFFFFFFFF
  let signed_max = 0x7FFFFFFFFFFFFFFF
  let plain = 42
  ((((((((hex + hex_upper) + bin) + bin_upper) + dec_sep) + hex_sep) + bin_sep) + mask) + signed_max) + plain
}
