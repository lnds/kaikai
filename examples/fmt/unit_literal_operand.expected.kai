unit m

unit s

unit USD

fn total(price: Real<USD>) : Real<USD> = price + 2.00<USD> - 0.50<USD>

fn accel(t: Real<s>) : Real<m/s> = 9.81<m/s^2> * t

fn span(w: Real<m>) : Real<m^2> = w * 3.0<m> + 1.0<m^2>

fn over(price: Real<USD>) : Bool = price > 10.00<USD>

fn under(price: Real<USD>) : Bool = 5.00<USD> < price

fn drop(x: Real<m>) : Real<m> = (-1.0<m>) + x
