# Every construct `kai fmt --help` claims to format. One fixture per
# name in that list, so a regression that reintroduces a refusal — or
# a help text that starts promising one — fails here.

unit Widget

effect Counter {
  bump(n: Int) : Int
}

protocol Sized[a] {
  size_of(x: a) : Int
}

impl Sized[Int] for Int {
  fn size_of(x: Int) : Int = 8
}

axiom trusted(x: Int) : Int

type Positive = Int where self > 0

pub fn run[m, e](x: m, f: (m) -> m / Ffi + e) : m / Ffi + e = f(x)

fn tally(start: Int) : Int / Counter = Counter.bump(start)

fn weigh(w: Real<Widget>) : Real<Widget> = w

fn handled() : Int = handle {
  tally(1)
} with Counter {
  bump(n, resume) -> resume(n + 1)
  return(x) -> x
}

fn counted() : Unit / Mutable {
  var xs: [Int] := [1, 2, 3]
  xs[0] := 42
}
