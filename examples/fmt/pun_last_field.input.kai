type Session = { first_field_name: Int, second_field_name: Int, third_field_name: Int }

fn with_third(s: Session, third_field_name: Int) : Session = Session {
  first_field_name: s.first_field_name,
  second_field_name: s.second_field_name,
  third_field_name
}

fn main() : Unit / Stdout = println(
  "#{with_third(Session { first_field_name: 1, second_field_name: 2, third_field_name: 3 }, 9).third_field_name}"
)
