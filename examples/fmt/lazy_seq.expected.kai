import seq

fn sieve(xs: Seq[Int]) : Seq[Int] = match xs {
  [] -> lazy []
  [p, ...rest] -> lazy [p, ...sieve(rest |? (x => x % p != 0))]
}

fn main() : Unit / Stdout {
  let nat = lazy [0..]
  let fives = lazy [0, 5..]
  let few = lazy [1..9]
  let odd = lazy [1, 3..9]
  let abc = lazy [1, 2, 3]
  Stdout.print(show(to_list(take(sieve(lazy [2..]), 3))))
}
