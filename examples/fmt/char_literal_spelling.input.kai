# A char literal keeps the spelling the source gave it.
fn classify(c: Char) : String = match c {
  'é' -> "e acute"
  '\u{e9}' -> "e acute, escaped"
  '\x41' -> "A, escaped"
  '🎉' -> "party"
  '\n' -> "newline"
  '\'' -> "quote"
  _ -> "other"
}

fn main() : Unit / Stdout = {
  let cs = ['é', '\u{2603}', 'ñ', 'A', '\t']
  Stdout.print("héllo — #{classify('é')} #{cs}")
}
