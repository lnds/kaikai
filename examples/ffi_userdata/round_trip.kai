import ffi

type Cfg = { name: String, retries: Int }

pub fn main() : Unit / Stdout + Ffi = {
  let h = retain_userdata(Cfg { name: "db", retries: 3 })
  let a = take_userdata(h)
  let b = take_userdata(h)
  Stdout.print("#{a.name} #{a.retries} #{b.retries}")
  release_userdata(h)
  let g = retain_userdata(7)
  Stdout.print("#{take_userdata(g)}")
  release_userdata(g)
}
