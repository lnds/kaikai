import ffi

pub fn main() : Unit / Stdout + Ffi = {
  let a = retain_userdata(1)
  let b = retain_userdata(2)
  Stdout.print("two live")
  release_userdata(a)
  let c = retain_userdata(3)
  let d = retain_userdata(4)
  let e = retain_userdata(5)
  Stdout.print("never")
  release_userdata(b)
  release_userdata(c)
  release_userdata(d)
  release_userdata(e)
}
