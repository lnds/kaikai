type IdentityError = AccountNotFound | KycExpired
type AuthError = InsufficientBalance | OverDailyLimit
type QueryErr = IdentityError | AuthError

protocol Same {
  same(a: Self, b: Self) : Bool
}

impl Same for IdentityError {
  fn same(a: IdentityError, b: IdentityError) : Bool = true
}

impl Same for AuthError {
  fn same(a: AuthError, b: AuthError) : Bool = true
}

fn main() : Unit / Stdout = {
  let q : QueryErr = AccountNotFound
  let r : QueryErr = KycExpired
  Stdout.print("#{same(q, r)}")
}
