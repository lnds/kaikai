type IdentityError = AccountNotFound | KycExpired
type AuthError = InsufficientBalance | OverDailyLimit
type QueryErr = IdentityError | AuthError

impl Show for IdentityError {
  fn show(e: IdentityError) : String = "identity"
}

impl Show for AuthError {
  fn show(e: AuthError) : String = "auth"
}

fn main() : Unit / Stdout = {
  let own : IdentityError = AccountNotFound
  let wide : QueryErr = own
  Stdout.print(show(own))
  Stdout.print(show(wide))
  let other : AuthError = OverDailyLimit
  let wide2 : QueryErr = other
  Stdout.print(show(other))
  Stdout.print(show(wide2))
}
