type IdentityError = AccountNotFound | KycExpired
type AuthError = InsufficientBalance | OverDailyLimit
type QueryErr = IdentityError | AuthError

protocol Describe {
  describe(x: Self, n: Int) : String
}

impl Show for IdentityError {
  fn show(e: IdentityError) : String = match e {
    AccountNotFound -> "account not found"
    KycExpired      -> "kyc expired"
  }
}

impl Show for AuthError {
  fn show(e: AuthError) : String = match e {
    InsufficientBalance -> "insufficient balance"
    OverDailyLimit      -> "over daily limit"
  }
}

impl Describe for IdentityError {
  fn describe(e: IdentityError, n: Int) : String = "identity #{n}"
}

impl Describe for AuthError {
  fn describe(e: AuthError, n: Int) : String = "auth #{n}"
}

fn render(e: QueryErr) : String = show(e)

fn main() : Unit / Stdout = {
  Stdout.print(render(KycExpired))
  Stdout.print(render(OverDailyLimit))
  let errs : [QueryErr] = [AccountNotFound, InsufficientBalance]
  match errs {
    [a, b] -> Stdout.print("#{a} / #{b}")
    _      -> ()
  }
  let q : QueryErr = OverDailyLimit
  Stdout.print(describe(q, 1 + 2))
}
