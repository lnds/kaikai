# Locals named like a core builtin (`args`) and like a top-level fn
# (`scale`), read inside a lambda. The lambda must capture the locals;
# a capture set that skips global names leaves the lambda reading the
# global instead, and the list-match on `args` sees a closure.

fn total(xs: [Int]) : Int {
  match xs {
    [] -> 0
    [h, ...rest] -> h + total(rest)
  }
}

fn scale(n: Int) : Int = n * 100

fn heads(args: [Int]) : [Int] {
  let k = 3
  map([1, 2], (x) => match args {
    [] -> x
    [h, ..._] -> x * k + h
  })
}

fn shifted(args: [Int], scale: Int) : [Int] =
  map([1, 2], (x) => x * scale + total(args))

fn arm_scaled(p: [Int]) : [Int] = match p {
  [] -> []
  [scale, ..._] -> map([1, 2], (x) => x * scale)
}

fn show(xs: [Int]) : String = string_join(map(xs, int_to_string), ",")

fn main() {
  print(show(heads([5, 6])))
  print(show(shifted([7, 8, 9], 2)))
  print(show(arm_scaled([4])))
  print(int_to_string(scale(1)))
}
