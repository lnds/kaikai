# FizzBuzz.
#
# Sum types + pattern match. kaikai is expression-oriented: `if`,
# `match`, and blocks all return a value. A `match` arm can carry a
# guard (`_ if n % 15 == 0 ->`), and `[1..15]` is a range literal.
#
#   $ kai run examples/quickstart/02_fizzbuzz.kai
#   1
#   2
#   Fizz
#   4
#   Buzz
#   ...
#   FizzBuzz

type Tag
  = Both
  | Fizz
  | Buzz
  | Other(Int)

fn classify(n: Int) : Tag = match n {
  _ if n % 15 == 0 -> Both
  _ if n % 3 == 0  -> Fizz
  _ if n % 5 == 0  -> Buzz
  _                -> Other(n)
}

fn label(c: Tag) : String = match c {
  Both     -> "FizzBuzz"
  Fizz     -> "Fizz"
  Buzz     -> "Buzz"
  Other(n) -> "#{n}"
}

fn main() {
  list.foreach([1..15], (n) => println(label(classify(n))))
}
