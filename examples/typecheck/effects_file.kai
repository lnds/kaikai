effect Logger {
  log(s: String) : Unit
}

fn greet(name: String) : Unit / Logger = Logger.log(name)

fn hello() : Unit / Stdout = println("hi")

fn shout(s: String) : Unit / Console = println(s)

fn each_log[a, e](xs: [a], f: (a) -> Unit / e) : Unit / Logger + e = match xs {
  [] -> ()
  [x, ...rest] -> { f(x) Logger.log("step") each_log(rest, f) }
}

fn twice(x: Int) : Int = x * 2

fn main() : Unit / Stdout = {
  hello()
  handle { greet("kai") } with Logger {
    log(s, resume) -> resume(Stdout.print(s))
  }
}
