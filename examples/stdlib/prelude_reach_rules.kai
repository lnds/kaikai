# Each line reaches core functions only through a rule pruning must
# know: method sugar, a fused map pipe over a range, a range applied to
# a fold terminal, the flat-map and filter pipes, operators on types with
# a derived or hand-written protocol impl, and interpolation through Show.

#[derive(Show, Eq, Ord)]
type Point = { x: Int, y: Int }

type ModInt = { value: Int }

impl Rem for ModInt {
  fn rem(self: ModInt, rhs: ModInt) : ModInt = ModInt { value: self.value % rhs.value }
}

fn twice(n: Int) : [Int] = [n, n]

fn main() : Unit / Stdout = {
  let xs = [3, 1, 2]
  Stdout.print("length=#{xs.length()} first=#{xs.head().unwrap_or(0)}")
  Stdout.print("sum=#{[1..10] | (n => n * 2) |> sum} plain=#{[1..10] |> sum()}")
  Stdout.print("flat=#{([1, 2] || twice).length()} kept=#{([1, 2, 3] |? (n => n > 1)).length()}")
  let p = Point { x: 3, y: 4 }
  let q = Point { x: 3, y: 5 }
  Stdout.print("eq=#{p == q} lt=#{p < q} p=#{p}")
  let m = ModInt { value: 23 } % ModInt { value: 5 }
  Stdout.print("rem=#{m.value}")
}
