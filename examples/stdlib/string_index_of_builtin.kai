# `string.index_of` searches through the core-declared builtin
# `string_find`: byte offsets, `Some(0)` for an empty needle.

fn show(r: Option[Int]) : String = match r {
  Some(i) -> int_to_string(i)
  None    -> "none"
}

fn main() : Unit / Stdout = {
  print(show(string.index_of("hello", "")))
  print(show(string.index_of("hello", "h")))
  print(show(string.index_of("hello", "llo")))
  print(show(string.index_of("hello", "o")))
  print(show(string.index_of("hello", "hello!")))
  print(show(string.index_of("hello", "x")))
  print(show(string.index_of("", "")))
  print(show(string.index_of("", "a")))
  print(show(string.index_of("aaab", "aab")))
  print(show(string.index_of("áéí", "í")))
  print(show(string.char_index_of("áéí", "í")))
  print(show(string.index_of(string.repeat("ab", 1000), "ba")))
}
