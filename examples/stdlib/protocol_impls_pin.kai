# Observable `Eq`/`Ord`/`Show` of the stdlib record types: `==`, ordering
# through the protocol, and generic dispatch must agree on every pair.

import date
import time
import math.bigint as bi
import rational as q

fn same[T: Eq](a: T, b: T) : Bool = a == b

fn order[T: Ord](a: T, b: T) : Int = {
  if a < b { -1 } else if a > b { 1 } else { 0 }
}

fn row(label: String, v: Bool) : Unit / Stdout =
  Stdout.print(label ++ ": " ++ show(v))

fn main() : Unit / Stdout = {
  let p1 = date.period_months(1)
  let p2 = date.period_months(2)
  let p3 = date.period_days(1)
  row("period eq", p1 == p1)
  row("period ne", p1 == p2)
  row("period ne-field", p1 == p3)
  row("period generic", same(p2, date.period_months(2)))
  row("period neq op", p1 != p3)

  let d1 = time.seconds(1)
  let d2 = time.millis(1500)
  let d3 = time.nanos_dur(-1)
  let d4 = time.seconds(1)
  row("dur eq", d1 == d4)
  row("dur ne", d1 == d2)
  row("dur generic", same(d1, d4))
  Stdout.print("dur cmp " ++ show(order(d1, d2)) ++ " " ++ show(order(d2, d1)) ++ " " ++ show(order(d1, d4)) ++ " " ++ show(order(d3, d1)))
  row("dur lt", d1 < d2)
  row("dur ge", d2 >= d1)
  row("dur min", min(d1, d2) == d1)
  row("dur max", max(d1, d2) == d2)

  let a = q.make(bi.from_int(1), bi.from_int(2))
  let b = q.make(bi.from_int(2), bi.from_int(4))
  let c = q.make(bi.from_int(1), bi.from_int(3))
  Stdout.print("rat show " ++ show(a) ++ " " ++ show(c) ++ " " ++ show(q.from_int(3)))
  row("rat eq-canon", a == b)
  row("rat ne", a == c)
  row("rat generic", same(a, b))
  Stdout.print("rat cmp " ++ show(order(a, c)) ++ " " ++ show(order(c, a)) ++ " " ++ show(order(a, b)))
  row("rat min", min(a, c) == c)
  row("rat max", max(a, c) == a)
}
