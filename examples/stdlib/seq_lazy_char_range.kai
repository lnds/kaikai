# A `lazy` range walks `Char`s as a list range does, by code point, with
# or without an end.

import seq

fn letters(s: Seq[Char]) : String = from_chars(to_list(s))

fn main() : Unit / Stdout = {
  Stdout.print(letters(lazy ['a'..'e']))
  Stdout.print(letters(lazy ['a', 'c'..'k']))
  Stdout.print(letters(lazy ['k', 'i'..'a']))
  Stdout.print(letters(lazy ['e'..'a']))
  Stdout.print(letters(take(lazy ['a'..], 4)))
  Stdout.print(letters(take(lazy ['a', 'c'..], 4)))
  Stdout.print(letters(take(lazy ['z', 'y'..], 4)))
  let lo = 'p'
  let next = 's'
  Stdout.print(letters(lazy [lo..'t']))
  Stdout.print(letters(lazy [lo, next..'z']))
  Stdout.print(letters(take(lazy [lo, next..], 3)))
  let upto = (c) => lazy [c..'d']
  Stdout.print(letters(upto('b')))
  Stdout.print(letters(lazy ['α'..'ε']))
  Stdout.print(letters(lazy ['a'..] | char.to_upper |> take(3)))
  Stdout.print(show(to_list(lazy ['a'..'c'])))
}
