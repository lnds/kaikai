import encoding.json
import encoding.json_bind.{JsonValue, JNull, JBool, JNum, JReal, JStr, JArr, JObj}

fn kv(k: String, v: JsonValue) : Pair[String, JsonValue] = Pair { fst: k, snd: v }

fn nest(n: Int, inner: JsonValue) : JsonValue =
  if n == 0 { inner } else { nest(n - 1, JArr([JObj([kv("k", inner)])])) }

fn sample() : JsonValue = JObj([
  kv("empty_arr", JArr([])),
  kv("empty_obj", JObj([])),
  kv("scalars", JArr([JNull, JBool(true), JBool(false), JNum(0 - 7), JReal(1.5), JReal(2.0)])),
  kv(
    "nested",
    JObj([
      kv("a", JArr([JNum(1), JArr([]), JArr([JNum(2), JObj([])])])),
      kv("b", JObj([kv("c", JNull)]))
    ])
  ),
  kv("esc \"key\"", JStr("q\" b\\ s/ \u{8} \u{c} \n \r \t \u{1} \u{1f} \u{7f}")),
  kv("utf8", JStr("ñ 日本 😀"))
])

fn main() : Unit / Stdout {
  Stdout.print(json_encode(sample()))
  Stdout.print(json_encode_pretty(sample(), 2))
  Stdout.print(json_encode_pretty(sample(), 4))
  Stdout.print(json_encode_pretty(JArr([]), 2))
  Stdout.print(json_encode_pretty(JNum(3), 2))
  Stdout.print(json_encode_pretty(nest(40, JNum(1)), 2))
  Stdout.print(json_encode(nest(40, JNum(1))))
}
