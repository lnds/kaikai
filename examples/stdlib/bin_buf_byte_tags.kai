# Pins `bin_buf_byte`: the edge tags land as single bytes, a run longer
# than the initial buffer survives the growth, a derived sum round-trips
# through its tag, and a tag outside a byte traps instead of wrapping
# into a valid one.

import actor
import spawn

#[derive(BinSerialize)]
type Shape = Dot | Seg(Int) | Tri(Int, Int)

fn put_all(b: BinBuf, tags: [Int]) : BinBuf / Mutable = match tags {
  [] -> b
  [t, ...rest] -> put_all(bin_buf_byte(b, t), rest)
}

fn tags_of(tags: [Int]) : Array[Byte] = bin_buf_bytes(put_all(bin_buf_new(), tags))

fn show_bytes(bs: Array[Byte], i: Int, acc: String) : String =
  if i >= array_length(bs) { acc }
  else { show_bytes(bs, i + 1, "#{acc} #{byte_to_int(bs[i])}") }

fn upto(i: Int, n: Int, acc: [Int]) : [Int] =
  if i < 0 { acc } else if i >= n { upto(n - 1, n, acc) } else { upto(i - 1, n, [i * 3 % 256, ...acc]) }

fn sum_bytes(bs: Array[Byte], i: Int, acc: Int) : Int =
  if i >= array_length(bs) { acc } else { sum_bytes(bs, i + 1, acc + byte_to_int(bs[i])) }

fn roundtrip(s: Shape) : String = {
  let bs = to_bytes(s)
  match shape_from_bytes(bs, 0) {
    Ok(c)  -> if show_bytes(to_bytes(c.value), 0, "") == show_bytes(bs, 0, "") { "ok tag #{byte_to_int(bs[0])}" }
              else { "MISMATCH" }
    Err(m) -> "ERR #{m}"
  }
}

fn child(parent: Pid[String], tag: Int) : Unit / Actor[String] + Link + Console + Mutable = {
  Link.link(parent)
  let bs = tags_of([tag])
  Stdout.print("UNREACHABLE: tag #{tag} wrote #{array_length(bs)} byte")
}

fn supervise(me: Pid[String], tags: [Int]) : Unit / Actor[String] + Spawn + Console + Link + Mutable = match tags {
  [] -> ()
  [t, ...rest] -> {
    let _ = spawn.spawn(() => with_mailbox { child(me, t) })
    Stdout.print("tag #{t}: #{Actor.receive()}")
    supervise(me, rest)
  }
}

fn supervisor() : Unit / Actor[String] + Spawn + Console + Link + Mutable = {
  let _ = spawn.set_trap_exit(true)
  supervise(Actor.self(), [256, -1])
}

fn main() : Int / Console + Spawn + Link + Mutable = {
  Stdout.print("edges:#{show_bytes(tags_of([0, 1, 127, 128, 255]), 0, "")}")
  let long = tags_of(upto(99, 100, []))
  Stdout.print("grown: len #{array_length(long)} sum #{sum_bytes(long, 0, 0)} last #{byte_to_int(long[99])}")
  Stdout.print("Dot #{roundtrip(Dot)}")
  Stdout.print("Seg #{roundtrip(Seg(-7))}")
  Stdout.print("Tri #{roundtrip(Tri(1, 2))}")
  with_mailbox { supervisor() }
  0
}
