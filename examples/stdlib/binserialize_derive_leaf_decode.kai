# Pins the derived decoders' primitive leaves (Int, Bool, String, Char,
# Real) in record fields and sum payloads: each round-trips, and each
# malformed input fails with the message the BinSerialize impls give.

#[derive(BinSerialize)]
type Leaves = { i: Int, b: Bool, s: String, c: Char, r: Real }

#[derive(BinSerialize)]
type Tagged = TNone | TInt(Int) | TMix(Bool, String, Char, Int) | TNest(Leaves)

fn show_leaves(x: Leaves) : String = "i=#{x.i} b=#{x.b} s=#{x.s} c=#{x.c} r=#{x.r}"

fn show_tagged(t: Tagged) : String = match t {
  TNone            -> "TNone"
  TInt(n)          -> "TInt(#{n})"
  TMix(b, s, c, n) -> "TMix(#{b}, #{s}, #{c}, #{n})"
  TNest(x)         -> "TNest(#{show_leaves(x)})"
}

fn prefix(bs: Array[Byte], n: Int) : Array[Byte] = {
  let out = array_make(n, 0u8)
  bytes_blit(out, 0, bs, 0, n)
}

fn patched(bs: Array[Byte], at: Int, b: Byte) : Array[Byte] = {
  let out = array_make(array_length(bs), 0u8)
  let _ = bytes_blit(out, 0, bs, 0, array_length(bs))
  out[at] := b
  out
}

fn leaves(label: String, bs: Array[Byte]) : Unit / Stdout = match leaves_from_bytes(bs, 0) {
  Ok(c)  -> Stdout.print("#{label}: #{show_leaves(c.value)} pos=#{c.pos}/#{array_length(bs)}")
  Err(m) -> Stdout.print("#{label}: Err(#{m})")
}

fn tagged(label: String, bs: Array[Byte]) : Unit / Stdout = match tagged_from_bytes(bs, 0) {
  Ok(c)  -> Stdout.print("#{label}: #{show_tagged(c.value)} pos=#{c.pos}/#{array_length(bs)}")
  Err(m) -> Stdout.print("#{label}: Err(#{m})")
}

fn cut_message(bs: Array[Byte], n: Int) : String = match tagged_from_bytes(prefix(bs, n), 0) {
  Ok(_)  -> "Ok"
  Err(m) -> m
}

# One line per run of cut lengths that fail with the same message.
fn cuts(bs: Array[Byte], n: Int, from: Int, last: String) : Unit / Stdout =
  if n > array_length(bs) { () }
  else {
    let m = if n == array_length(bs) { "" } else { cut_message(bs, n) }
    if m == last { cuts(bs, n + 1, from, last) }
    else {
      if last != "" { Stdout.print("  cut #{from}..#{n - 1}: #{last}") }
      cuts(bs, n + 1, n, m)
    }
  }

fn main() : Unit / Stdout = {
  let x = Leaves { i: -42, b: true, s: "héllo", c: 'é', r: 1.5 }
  let xs = to_bytes(x)
  leaves("leaves", xs)
  leaves("bool byte 2", patched(xs, 8, 2u8))
  leaves("string length past end", patched(xs, 9, 200u8))
  leaves("real not decimal", patched(xs, array_length(xs) - 1, 120u8))

  let ts = [TNone, TInt(7), TMix(false, "", 'z', 3), TNest(x)]
  let _ = list.map(ts, (t) => tagged("tagged", to_bytes(t)))
  tagged("empty", prefix(xs, 0))
  tagged("tag out of range", patched(to_bytes(TInt(7)), 0, 9u8))
  tagged("mix bool byte 7", patched(to_bytes(TMix(false, "", 'z', 3)), 1, 7u8))

  Stdout.print("cuts of TMix:")
  cuts(to_bytes(TMix(true, "ab", 'q', 5)), 0, 0, "")
  Stdout.print("cuts of TNest:")
  cuts(to_bytes(TNest(x)), 0, 0, "")
}
