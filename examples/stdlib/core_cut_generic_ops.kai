# An operator on an `Int` field of a generic record selects no impl, so a
# pruned build of a queue and a stack keeps neither the `Complex` arithmetic
# impls nor the structural `Eq` impls.

import collections.queue as q
import collections.stack as s

fn main() : Unit / Console = {
  let a = q.push(q.push(q.empty(), 1), 2)
  let b = s.push(s.push(s.empty(), 1), 2)
  let ra = match q.pop(a) { Some(p) -> q.size(p.snd)  None -> 0 }
  let rb = match s.pop(b) { Some(p) -> s.size(p.snd)  None -> 0 }
  Stdout.print(int_to_string(ra + rb))
  Stdout.print(if q.is_empty(a) or s.is_empty(b) { "empty" } else { "full" })
}
