# A call to a bounded generic in a const initialiser reaches the
# generic's specialisation, as the same call in a function body does:
# under a bare and a qualified name, inside a `let` and a lambda, and in
# a const of an imported module.

import core.list
import const_generic_call_lib

const xs : [Int] = [1, 2, 3]

const bare : Int = sum(xs)
const qualified : Int = list.sum(xs)
const reals : Real = list.sum([1.5, 2.25])
const product : Int = list.product([2, 3, 4])
const piped : Int = xs |> list.sum
const in_let : Int = {
  let t : Int = list.sum(xs)
  t + 1
}
const in_lambda : [Int] = list.map([[1, 2], [3]], (ys) => list.sum(ys))

fn in_body() : Int = list.sum(xs)

fn main() : Unit / Stdout = {
  Stdout.print("#{bare} #{qualified} #{in_body()}")
  Stdout.print("#{reals} #{product} #{piped}")
  Stdout.print("#{in_let} #{in_lambda}")
  Stdout.print("#{const_generic_call_lib.total} #{total}")
}
