import encoding.utf8

fn b(xs: [Int]) : String = string.from_bytes(
  list.map(
    xs,
    (n: Int) => match int_to_byte(n) {
      Ok(x) -> x
      Err(m) -> panic(m)
    }
  )
)

fn flag(x: Bool) : String = if x { "T" } else { "F" }

fn agree(label: String, s: String) : Unit / Stdout {
  let a = utf8.is_valid_string(s)
  let r = utf8.is_valid(string.bytes(s))
  print("#{label} #{flag(a)} #{flag(a == r)}")
}

fn prefixes() : String =
  [
    string.starts_with("hello", ""),
    string.starts_with("", ""),
    string.starts_with("", "a"),
    string.starts_with("ab", "abc"),
    string.starts_with("abc", "ab"),
    string.starts_with("abc", "bc"),
    string.starts_with("éa", "é"),
    string.starts_with("éa", b([0xC3]))
  ]
    | flag
    |> string.join("")

fn suffixes() : String =
  [
    string.ends_with("hello", ""),
    string.ends_with("", ""),
    string.ends_with("", "a"),
    string.ends_with("bc", "abc"),
    string.ends_with("abc", "bc"),
    string.ends_with("abc", "ab"),
    string.ends_with("aé", "é"),
    string.ends_with("aé", b([0xA9]))
  ]
    | flag
    |> string.join("")

fn round_trip(s: String) : Unit / Stdout {
  let arr = string.to_byte_array(s)
  let back = bytes_get_string(arr, 0, array_length(arr))
  print(
    "#{array_length(arr)} #{string.byte_length(s)} #{flag(back == s)} #{flag(list.length(string.bytes(s)) == array_length(arr))}"
  )
}

fn main() : Unit / Stdout {
  print(prefixes())
  print(suffixes())

  round_trip("")
  round_trip("hello")
  round_trip("héllo wörld")
  round_trip("日本語")
  round_trip("😀 emoji")

  agree("empty", "")
  agree("ascii", "plain text")
  agree("multi", "é日😀")
  agree("lone-cont", b([0x61, 0x80]))
  agree("lead-C0", b([0xC0, 0x80]))
  agree("lead-C1", b([0xC1, 0xBF]))
  agree("overlong3", b([0xE0, 0x80, 0x80]))
  agree("overlong4", b([0xF0, 0x80, 0x80, 0x80]))
  agree("surrogate-lo", b([0xED, 0xA0, 0x80]))
  agree("surrogate-hi", b([0xED, 0xBF, 0xBF]))
  agree("above-max", b([0xF4, 0x90, 0x80, 0x80]))
  agree("lead-F5", b([0xF5, 0x80, 0x80, 0x80]))
  agree("lead-FF", b([0xFF]))
  agree("trunc2", b([0x61, 0xC3]))
  agree("trunc3", b([0xE2, 0x82]))
  agree("trunc4", b([0xF0, 0x9F, 0x98]))
  agree("bad-cont", b([0xE2, 0x28, 0xA1]))
  agree("max-ok", b([0xF4, 0x8F, 0xBF, 0xBF]))
  agree("ED-ok", b([0xED, 0x9F, 0xBF]))
}
