# Reading a directory must be a plain Err on every platform. fopen
# accepts directories, and on Linux ext4 sizing the stream via
# fseek/ftell reports a huge htree EOF sentinel — a naive
# size-then-read turns that into an out-of-memory abort.

import fs.file

fn main() : Unit / Stdout + File = {
  match read_file("/") {
    Ok(_)  -> Stdout.print("read_file: unexpected Ok")
    Err(e) -> Stdout.print(e)
  }
  match file.read_bytes("/") {
    Ok(_)  -> Stdout.print("read_bytes: unexpected Ok")
    Err(e) -> Stdout.print(e)
  }
}
