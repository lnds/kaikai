# A user type named like a core one keeps its effect-row slot to itself:
# the core `Pair[a, b]` that `tuple.swap` / `map_snd` / `map_pair` speak
# of has no row slot, whatever a user `Pair[t, e]` declares.
pub type Pair[t, e] = Pair(Int, () -> Unit / e)

fn main() : Unit / Stdout = {
  let p = tuple.map_snd(tuple.swap(Pair { fst: 1, snd: 2 }), (x) => x + 10)
  let q = tuple.map_pair(p, (x) => x * 3, (y) => y - 1)
  let mine : Pair[Int, Stdout] = Pair(7, () => Stdout.print("mine"))
  match mine { Pair(n, done) -> { done(); Stdout.print("#{p.fst} #{p.snd} #{q.fst} #{q.snd} #{n}") } }
}
