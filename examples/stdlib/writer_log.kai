# with_writer returns the told values in order; large logs stay linear.

import writer

fn tell_range(i: Int, n: Int) : Unit / Writer[Int] =
  if i >= n { () } else { Writer.tell(i); tell_range(i + 1, n) }

fn main() : Unit / Stdout = {
  Stdout.print("none: #{writer.with_writer(() => tell_range(0, 0))}")
  Stdout.print("three: #{writer.with_writer(() => tell_range(0, 3))}")
  let log = writer.with_writer(() => tell_range(0, 100000))
  Stdout.print("large: #{list_length(log)} first=#{list.head(log)} last=#{list.last(log)}")
}
