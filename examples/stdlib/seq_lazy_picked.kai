# The literal names the module's declarations by identity: a function
# of this file called `defer` is not the one a cell is built with.

import seq.{Seq, to_list}

fn defer(n: Int) : Int = n + 1

fn main() : Unit / Stdout = {
  let s : Seq[Int] = lazy [defer(1), 2, 3]
  let firsts = [5, 6, 7] |> take(2)
  Stdout.print(show(to_list(s)))
  Stdout.print(show(firsts))
}
