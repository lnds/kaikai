# The hand-written `Eq`/`Ord`/`Hash`/`Show` impls that stay hand-written
# because their semantics are not field order: scale-independent decimals,
# cross-multiplied rationals, magnitude-aware big integers.

import math.bigint as bi
import decimal_big as db
import rational as q

fn same[t: Eq](a: t, b: t) : Bool = a == b

fn order[t: Ord](a: t, b: t) : Int = {
  if a < b { -1 } else if a > b { 1 } else { 0 }
}

fn row(label: String, v: Bool) : Unit / Stdout =
  Stdout.print(label ++ ": " ++ show(v))

fn big(s: String) : bi.BigInt = match bi.from_string(s) {
  Some(v) -> v
  None    -> bi.zero()
}

fn dec(s: String) : db.DecimalBig = match db.parse(s) {
  Some(v) -> v
  None    -> db.zero()
}

fn main() : Unit / Stdout = {
  let d15 = dec("1.5")
  let d150 = dec("1.50")
  let d2 = dec("2")
  let dn = dec("-1.5")
  row("dec eq-scale", d15 == d150)
  row("dec generic", same(d15, d150))
  row("dec ne", d15 == d2)
  Stdout.print("dec cmp " ++ show(order(d15, d150)) ++ " " ++ show(order(d15, d2)) ++ " " ++ show(order(d2, d15)) ++ " " ++ show(order(dn, d15)) ++ " " ++ show(order(d15, dn)))
  row("dec min", min(d15, d2) == d15)
  row("dec max", max(d15, d2) == d2)
  row("dec min-neg", min(dn, d15) == dn)
  row("dec max-neg", max(dn, d15) == d15)
  Stdout.print("dec show " ++ show(d15) ++ " " ++ show(d150) ++ " " ++ show(dn) ++ " " ++ show(d2))

  let r1 = q.make(big("-1"), big("2"))
  let r2 = q.make(big("1"), big("3"))
  let r3 = q.make(big("-2"), big("4"))
  let r4 = q.make(big("7"), big("1"))
  Stdout.print("rat show " ++ show(r1) ++ " " ++ show(r2) ++ " " ++ show(r3) ++ " " ++ show(r4))
  Stdout.print("rat cmp " ++ show(order(r1, r2)) ++ " " ++ show(order(r2, r1)) ++ " " ++ show(order(r1, r3)) ++ " " ++ show(order(r4, r2)) ++ " " ++ show(order(r2, r4)))
  row("rat eq", r1 == r3)
  row("rat ne", r1 == r2)
  row("rat fn eq", q.eq(r1, r3))
  row("rat fn eq-num", q.eq(r1, q.make(big("-1"), big("3"))))
  row("rat fn eq-den", q.eq(q.make(big("1"), big("2")), q.make(big("2"), big("2"))))
  row("rat fn eq-above", q.eq(r4, q.from_int(6)))
  row("rat min", min(r1, r2) == r1)
  row("rat max", max(r1, r2) == r2)
  row("rat min-eq", min(r1, r3) == r3)
  row("rat max-eq", max(r1, r3) == r1)

  let b0 = big("0")
  let bs = big("123")
  let bn = big("-123")
  let bl = big("123456789012345678901234567890")
  let bl2 = big("123456789012345678901234567890")
  let bnl = big("-123456789012345678901234567890")
  Stdout.print("big show " ++ show(bs) ++ " " ++ show(bn) ++ " " ++ show(bl) ++ " " ++ show(bnl))
  row("big eq", bl == bl2)
  row("big eq-small", bs == big("123"))
  row("big ne-sign", bs == bn)
  row("big ne-mag", bl == bs)
  row("big generic", same(bl, bl2))
  Stdout.print("big cmp " ++ show(order(bs, bl)) ++ " " ++ show(order(bl, bs)) ++ " " ++ show(order(bnl, bn)) ++ " " ++ show(order(bn, bnl)) ++ " " ++ show(order(bl, bl2)) ++ " " ++ show(order(bn, bs)) ++ " " ++ show(order(b0, bs)) ++ " " ++ show(order(bnl, bl)))
  row("big min", min(bs, bl) == bs)
  row("big max", max(bs, bl) == bl)
  row("big min-neg", min(bnl, bl) == bnl)
  row("big max-neg", max(bnl, bn) == bn)
  row("hash eq", hash(bl) == hash(bl2))
  row("hash ne", hash(bl) == hash(bs))
  row("hash sign", hash(bs) == hash(bn))
  row("hash small", hash(bs) == hash(big("123")))
  Stdout.print("hash small value " ++ show(hash(bs)) ++ " " ++ show(hash(bn)) ++ " " ++ show(hash(b0)))
  Stdout.print("hash big value " ++ show(hash(bl)) ++ " " ++ show(hash(bnl)))
}
