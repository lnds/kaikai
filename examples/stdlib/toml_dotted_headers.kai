# Dotted and quoted table headers nest; a table or key defined twice
# rejects the document.

import encoding.toml

fn diagnose(src: String) : String = match toml.decode_report(src) {
  Ok(v)  -> string_concat("ok: ", toml.encode(v))
  Err(e) -> toml.error_message(e)
}

fn show(label: String, src: String) : Unit / Stdout =
  Stdout.print("#{label}: #{diagnose(src)}")

fn native_of(src: String, module: String) : String =
  match toml.decode(src) {
    Some(TTbl(root)) -> match toml.pairs_get(root, "native") {
      Some(TTbl(native)) -> match toml.pairs_get(native, module) {
        Some(v) -> toml.encode(v)
        None    -> "absent"
      }
      _ -> "no [native]"
    }
    _ -> "rejected"
  }

const MANIFEST : String = """name = "kohau"

[native]
include = ["c"]

[native.sqlite]
sources = ["c/sqlite_shim.c"]

[ native . "db.pg" ]
libs = ["pq"]
"""

fn main() : Unit / Stdout = {
  Stdout.print("sqlite: #{native_of(MANIFEST, "sqlite")}")
  Stdout.print("db.pg: #{native_of(MANIFEST, "db.pg")}")
  Stdout.print("db: #{native_of(MANIFEST, "db")}")

  show("implicit_then_defined", """[a.b]
x = 1

[a]
y = 2
""")

  show("array_sub_tables", """[[fruit]]
name = "apple"

[fruit.physical]
color = "red"

[[fruit]]
name = "banana"

[fruit.physical]
color = "yellow"
""")

  show("table_twice", """[a]
x = 1

[a]
y = 2
""")

  show("dotted_twice", """[native.sqlite]
libs = ["sqlite3"]

[native.sqlite]
libs = ["sqlite3"]
""")

  show("key_twice", """[a]
x = 1
x = 2
""")

  show("header_over_value", """[a]
b = 1

[a.b]
c = 2
""")

  show("table_then_array", """[a]
x = 1

[[a]]
y = 2
""")

  show("empty_segment", """[a.]
x = 1
""")
}
