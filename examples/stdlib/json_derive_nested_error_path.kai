# A failure under nested records reports the same path as a decode that
# threads the full path down: keys that start with `[`, an empty key, an
# index under a field, and a hand-written impl that appends to `path`.

import encoding.json_bind

#[derive(Json)]
type Leaf = { v: Int }

#[derive(Json)]
type Mid = {
  #[json(rename = "[x")] odd: Leaf,
  #[json(rename = "")] blank: Leaf,
  rows: [Leaf],
  opt: Option[Leaf]
}

#[derive(Json)]
type Top = { mid: Mid }

type Hand = { n: Int }

impl Json for Hand {
  fn to_json(self: Hand) : JsonValue = JNull
  fn of_json(v: JsonValue, path: String) : Result[Hand, JsonError] =
    Err(JsonError { path: string_concat(path, ".x"), expected: "e", found: "f" })
}

#[derive(Json)]
type Holder = { h: Hand }

fn leaf(ok: Bool) : JsonValue =
  JObj([Pair { fst: "v", snd: if ok { JNum(1) } else { JStr("s") } }])

fn mid(odd: Bool, blank: Bool, row: Bool, opt: Bool) : JsonValue =
  JObj([Pair { fst: "[x", snd: leaf(odd) },
        Pair { fst: "", snd: leaf(blank) },
        Pair { fst: "rows", snd: JArr([leaf(true), leaf(row)]) },
        Pair { fst: "opt", snd: leaf(opt) }])

fn top(m: JsonValue) : JsonValue = JObj([Pair { fst: "mid", snd: m }])

fn expect_path(name: String, got: String, want: String) : Unit / Console =
  print("#{name}: #{if got == want { "ok" } else { "MISMATCH" }} [#{got}]")

fn path_of(r: Result[Top, JsonError]) : String = match r {
  Ok(_)  -> "decoded"
  Err(e) -> e.path
}

fn main() : Unit / Console = {
  let mid_p = json_path_field("", "mid")
  expect_path("odd", path_of(top_of_json(top(mid(false, true, true, true)), "")),
        json_path_field(json_path_field(mid_p, "[x"), "v"))
  expect_path("blank", path_of(top_of_json(top(mid(true, false, true, true)), "")),
        json_path_field(json_path_field(mid_p, ""), "v"))
  expect_path("row", path_of(top_of_json(top(mid(true, true, false, true)), "")),
        json_path_field(json_path_index(json_path_field(mid_p, "rows"), 1), "v"))
  expect_path("opt", path_of(top_of_json(top(mid(true, true, true, false)), "")),
        json_path_field(json_path_field(mid_p, "opt"), "v"))
  expect_path("based", path_of(top_of_json(top(mid(false, true, true, true)), "doc")),
        json_path_field(json_path_field(json_path_field("doc", "mid"), "[x"), "v"))
  expect_path("ok", path_of(top_of_json(top(mid(true, true, true, true)), "")), "decoded")
  match holder_of_json(JObj([Pair { fst: "h", snd: JNull }]), "") {
    Ok(_)  -> print("hand: decoded")
    Err(e) -> expect_path("hand", e.path, string_concat(json_path_field("", "h"), ".x"))
  }
}
