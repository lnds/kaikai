# `Period` arithmetic and the two answers to "how far apart".
#
# Periods add componentwise, which is exact. Applying one to a date
# clamps, which is not — so the algebra lives on `Period` and the
# clamping lives in `shift`, where a caller can see it.

import date

fn verify(label: String, ok: Bool) : Unit / Stdout =
  Stdout.print(label ++ ": " ++ (if ok { "ok" } else { "FAIL" }))

fn at(y: Int, m: Int, d: Int) : Date = match date.make(y, m, d) {
  Some(x) -> x
  None    -> date.from_epoch_days(0)
}

fn main() : Unit / Stdout = {
  let a = date.period_months(1)
  let b = date.period_days(1)
  let c = date.period_months(2)

  verify("period assoc",   (a + b) + c == a + (b + c))
  verify("period commut",  a + b == b + a)
  verify("period neutral", a + date.period_zero() == a)
  verify("period inverse", a + date.period_months(0 - 1) == date.period_zero())
  verify("period sub",     (a + b) - b == a)

  # 13 months carries into a year; days never merge with months.
  let n = date.period_normalise(date.period_months(13) + date.period_days(40))
  verify("normalise carries", n.years == 1 and n.months == 1 and n.days == 40)

  let ene31 = at(2026, 1, 31)

  # Order is fixed: months, then days. From the 31st the month step
  # clamps to the 28th, and the day is added to that.
  verify("shift m+d", date.eq(ene31 + (a + b), at(2026, 3, 1)))
  verify("shift m",   date.eq(ene31 + a, at(2026, 2, 28)))

  # The 30th is where the order shows: months-then-days reaches
  # 03-01, days-then-months reaches 02-28. A shift that applied the
  # parts the other way round would land on the second.
  verify("order months first",
    date.eq(at(2026, 1, 30) + (a + b), at(2026, 3, 1)))

  # The clamp is reported rather than hidden.
  verify("clamps",     date.shift_clamps(ene31, a))
  verify("no clamp",   not date.shift_clamps(at(2026, 1, 15), a))
  verify("exact none", match date.shift_exact(ene31, a) { None -> true Some(_) -> false })
  verify("exact some",
    match date.shift_exact(at(2026, 1, 15), a) {
      Some(x) -> date.eq(x, at(2026, 2, 15))
      None    -> false
    })

  # Leap year: the same shift lands on the 29th.
  verify("leap clamp", date.eq(at(2024, 1, 31) + a, at(2024, 2, 29)))

  # Two true answers to the same distance, neither derivable from the
  # other without a base date.
  let p = date.between(ene31, at(2026, 3, 1))
  verify("between m+d", p.years == 0 and p.months == 1 and p.days == 1)
  verify("diff days",   date.diff_days(at(2026, 3, 1), ene31) == 29)

  # A month counts as whole when the end day-of-month reaches the start's.
  let q = date.between(at(2025, 1, 15), at(2026, 3, 18))
  verify("between ymd", q.years == 1 and q.months == 2 and q.days == 3)

  let r = date.between(at(2026, 1, 20), at(2026, 3, 10))
  verify("between partial", r.years == 0 and r.months == 1 and r.days == 18)

  # Applying a period is not reversible where it clamps.
  verify("clamp is lossy",
    not date.eq(ene31 + a + date.period_months(0 - 1), ene31))
}
