import math.real

fn main() : Unit / Stdout = {
  Stdout.print(real.to_fixed(3.14159, 2))
  Stdout.print(real.to_fixed(2.5, 0))
  Stdout.print(real.to_fixed(3.5, 0))
  Stdout.print(real.to_fixed(0.125, 2))
  Stdout.print(real.to_fixed(0.0 - 1.005, 2))
  Stdout.print(real.to_fixed(7.0, 3))
  Stdout.print(real.to_fixed(0.0 - 0.001, 2))
  Stdout.print(real.to_fixed(1234.5678, 1))
}
