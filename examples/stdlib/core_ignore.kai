# `ignore` discards a value mid-block and closes a `Unit` body as its tail.

fn show(n: Int) : Unit / Stdout = println("#{n}")

fn parse(s: String) : Result[Int, String] / Stdout = {
  println("parse #{s}")
  Ok(s |> length())
}

fn main() : Unit / Stdout = {
  parse("ab") |> ignore
  ignore(42)
  [1, 2] | show |> ignore
  [3, 4] | show |> ignore
}
