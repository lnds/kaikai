# show of large lists, maps and sets, and size inside a loop, stay linear.

import collections.map
import collections.set

fn indices(n: Int, i: Int, acc: [Int]) : [Int] =
  if i >= n { acc } else { indices(n, i + 1, [i, ...acc]) }

fn grow_map(m: Map[Int, Int], i: Int, n: Int, seen: Int) : Int =
  if i >= n { seen } else { grow_map(map.put(m, i, i), i + 1, n, seen + map.size(m)) }

fn grow_set(s: Set[Int], i: Int, n: Int, seen: Int) : Int =
  if i >= n { seen } else { grow_set(set.insert(s, i), i + 1, n, seen + set.size(s)) }

fn no_map() : Map[Int, Int] = map.empty()

fn no_set() : Set[Int] = set.empty()

fn main() : Unit / Stdout = {
  Stdout.print("list: " ++ int_to_string(string_length(show(indices(200000, 0, [])))))
  Stdout.print("map: " ++ int_to_string(string_length(show(map.from(list.map(indices(100000, 0, []), (i) => Pair { fst: i, snd: i }))))))
  Stdout.print("set: " ++ int_to_string(string_length(show(set.from(indices(100000, 0, []))))))
  Stdout.print("map size: " ++ int_to_string(grow_map(no_map(), 0, 40000, 0)))
  Stdout.print("set size: " ++ int_to_string(grow_set(no_set(), 0, 40000, 0)))
}
