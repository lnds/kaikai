# `lazy [...]` builds a `Seq`: elements, a spread as the rest, and
# ranges with or without an end. Nothing in the bracket runs until its
# cell is read.

import seq

fn show_first(s: Seq[Int], n: Int) : String = show(to_list(take(s, n)))

fn main() : Unit / Stdout = {
  let none : Seq[Int] = lazy []
  Stdout.print(show(to_list(none)))
  Stdout.print(show(to_list(lazy [1, 2, 3])))
  Stdout.print(show(to_list(lazy [0, ...lazy [1, 2]])))
  Stdout.print(show(to_list(lazy [...lazy [7, 8]])))
  Stdout.print(show_first(lazy [2..], 5))
  Stdout.print(show_first(lazy [0, 5..], 4))
  Stdout.print(show_first(lazy [10, 7..], 5))
  Stdout.print(show(to_list(lazy [1..5])))
  Stdout.print(show(to_list(lazy [2, 4..11])))
  Stdout.print(show(to_list(lazy [9, 6..0])))
  Stdout.print(show(to_list(lazy [5..1])))
  let a = 3
  let b = 7
  Stdout.print(show_first(lazy [a..], 3))
  Stdout.print(show_first(lazy [a, b..], 3))
  Stdout.print(show(to_list(lazy [a, a + 4..20])))
  Stdout.print(show(to_list(lazy [a + 1, b + 1..20])))
  Stdout.print(show_first(lazy [1, panic("the second cell is never read")], 1))
  Stdout.print(show_first(lazy [1, ...todo!("nor is the rest")], 1))
  Stdout.print(show(to_list(lazy [(x: Int) => x + 1, (x: Int) => x * 2] | (f) => f(10))))
  Stdout.print(show(to_list(lazy [1..] | (x) => x * x |? (x) => x % 2 == 1 |> take(4))))
  Stdout.print(int_to_string(lazy [1..100] |> foldl(0, (acc, x) => acc + x)))
}
