# Pins the BinSerialize wire bytes across every encoder shape: the scalar
# codecs, derived records and sums (nested lists, options, recursion),
# Layout, and the bin_* combinators called directly. An encoder rewrite
# must leave every byte of this output unchanged.

#[derive(BinSerialize)]
type Item = { id: Int, name: String, tag: Char, score: Real, on: Bool }

#[derive(BinSerialize)]
type Doc = { title: String, items: [Item], rows: [[Int]], names: Option[[String]], maybe: [Option[String]], empty: [Int] }

#[derive(BinSerialize)]
type Shape = Dot | Line([Int]) | Mesh(Option[Int], [String]) | Box(Item)

#[derive(BinSerialize)]
type BTree = Leaf(Int) | Branch(BTree, BTree)

#[derive(BinSerialize)]
type Unit0 = {}

#[derive(Layout)]
type Header = { magic: U32<be>, port: U16<be>, flags: U16<le>, seq: U64<le>, b: U8<be> }

fn dump_loop(bs: Array[Byte], i: Int, acc: String) : String =
  if i >= array_length(bs) { acc }
  else { dump_loop(bs, i + 1, "#{acc}#{byte_to_int(bs[i])},") }

fn dump(label: String, bs: Array[Byte]) : Unit / Stdout =
  print("#{label} #{array_length(bs)}: #{dump_loop(bs, 0, "")}")

fn main() : Int {
  let it1 = Item { id: -42, name: "héllo", tag: 'Z', score: 3.25, on: true }
  let it2 = Item { id: 1234567890123, name: "", tag: 'a', score: -0.5, on: false }
  dump("int0", to_bytes(0))
  dump("intneg", to_bytes(-1))
  dump("intbig", to_bytes(9007199254740993))
  dump("bool", to_bytes(true))
  dump("str", to_bytes("kaikai rapa nui"))
  dump("real", to_bytes(2.5))
  dump("item1", to_bytes(it1))
  dump("item2", to_bytes(it2))
  dump("doc", to_bytes(Doc { title: "t", items: [it1, it2, it1], rows: [[1, 2], [], [3]], names: Some(["a", "bc"]), maybe: [None, Some("x"), None], empty: [] }))
  dump("docnone", to_bytes(Doc { title: "", items: [], rows: [], names: None, maybe: [], empty: [] }))
  dump("dot", to_bytes(Dot))
  dump("line", to_bytes(Line([7, -7, 0])))
  dump("mesh", to_bytes(Mesh(Some(9), ["p", "qq", ""])))
  dump("meshnone", to_bytes(Mesh(None, [])))
  dump("box", to_bytes(Box(it2)))
  dump("tree", to_bytes(Branch(Leaf(1), Branch(Branch(Leaf(2), Leaf(3)), Leaf(-4)))))
  dump("unit0", to_bytes(Unit0 {}))
  let h = Header { magic: 0xCAFEBABE<be>, port: 8080<be>, flags: 513<le>, seq: 72623859790382856<le>, b: 255<be> }
  dump("layout", h.to_bytes())
  dump("putbe", bin_put_uint_be(to_bytes(true), 305419896, 4))
  dump("putle", bin_put_uint_le(to_bytes(false), -2, 8))
  dump("putw0", bin_put_uint_le(to_bytes(7), 5, 0))
  dump("cat_ee", array_concat_bytes(array_make(0, bin_byte(0)), array_make(0, bin_byte(0))))
  dump("cat_ex", array_concat_bytes(array_make(0, bin_byte(0)), to_bytes("ab")))
  dump("cat_xe", array_concat_bytes(to_bytes("ab"), array_make(0, bin_byte(0))))
  dump("cat_xx", array_concat_bytes(to_bytes(3), to_bytes("ab")))
  dump("listint", bin_list_to_bytes([1, 2, 3, 300, -300], (x) => to_bytes(x)))
  dump("listempty", bin_list_to_bytes([], (x) => to_bytes(x + 1)))
  dump("optnone", bin_option_to_bytes(None, (x) => to_bytes(x + 1)))
  dump("optsome", bin_option_to_bytes(Some("zz"), (s) => to_bytes(s)))
  0
}
