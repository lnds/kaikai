# hex and base64 encoding, chunked-body decoding and draining a child's
# output: edge cases and large inputs.

import encoding.hex
import encoding.base64
import net.http
import os.process

fn bytes(n: Int, i: Int, acc: [Int]) : [Int] =
  if i >= n { acc } else { bytes(n, i + 1, [(i * 7 + 3) % 256, ...acc]) }

fn chunks(n: Int, i: Int, acc: [String]) : [String] =
  if i >= n { acc } else { chunks(n, i + 1, ["4\r\nabcd\r\n", ...acc]) }

fn drained(cmd: String, args: [String]) : String / Process = match process.start_piped(cmd, args) {
  Err(e) -> "start failed: #{e}"
  Ok(c)  -> match process.read_all(c) {
    Ok(s)  -> "#{string_length(s)} bytes"
    Err(e) -> "read failed: #{e}"
  }
}

fn main() : Unit / Stdout + Process = {
  Stdout.print("hex: [#{hex.encode([])}] [#{hex.encode([0])}] [#{hex.encode([255, 16, 171])}]")
  Stdout.print("hex round trip: #{hex.decode(hex.encode(bytes(1000, 0, []))) == Some(bytes(1000, 0, []))}")
  Stdout.print("base64: [#{base64.encode([])}] [#{base64.encode([77])}] [#{base64.encode([77, 97])}] [#{base64.encode([77, 97, 110])}] [#{base64.encode([77, 97, 110, 77])}]")
  Stdout.print("base64 url: [#{base64.encode_url([251, 255, 254])}] [#{base64.encode([251, 255, 254])}]")
  Stdout.print("base64 round trip: #{base64.decode(base64.encode(bytes(1001, 0, []))) == Some(bytes(1001, 0, []))}")
  Stdout.print("dechunk: [#{http.dechunk_body("5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n")}]")
  Stdout.print("dechunk no terminator: [#{http.dechunk_body("3\r\nabc\r\n")}]")
  Stdout.print("dechunk empty: [#{http.dechunk_body("0\r\n\r\n")}] [#{http.dechunk_body("")}]")
  Stdout.print("dechunk hex size: [#{http.dechunk_body("A\r\n0123456789\r\n0\r\n\r\n")}]")
  Stdout.print("drain empty: #{drained("true", [])}")
  Stdout.print("drain small: #{drained("printf", ["abc"])}")
  Stdout.print("drain large: #{drained("head", ["-c", "5000000", "/dev/zero"])}")
}
