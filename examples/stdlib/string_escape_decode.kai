# Regression fixture for byte-exact string-literal escape decoding.
#
# Both backends decode through the compiler's shared escape table
# (compiler/escapes.kai): the C backend emits already-decoded bytes via
# `kai_str_from_bytes`, and the native backend hands the same bytes to
# LLVM. The parity harness diffs the two, so a divergence in either
# direction fails here.
#
# kaikai accepts `\n \t \r \0 \\ \" \'`, `\xHH` (exactly two hex digits,
# one byte) and `\u{H..H}` (a codepoint, UTF-8 encoded). C99's octal and
# `\a \b \f \v \?` are rejected at compile time — see
# examples/errors/escape_*.kai for those.

fn code_at(s: String, i: Int) : Int =
  match char_at(s, i) {
    None    -> 0 - 1
    Some(c) -> char_to_int(c)
  }

fn main() : Int / Console = {
  # Simple escapes — each one byte, exact code point.
  print(int_to_string(code_at("\t", 0)))   # 9   tab
  print(int_to_string(code_at("\n", 0)))   # 10  newline
  print(int_to_string(code_at("\r", 0)))   # 13  carriage return

  # Hex escapes — `\xHH` decodes to the byte, not the literal digits.
  print(int_to_string(code_at("\x41", 0)))   # 65  'A'
  print(int_to_string(code_at("\x7e", 0)))   # 126 '~'
  print(int_to_string(code_at("\xff", 0)))   # 255 0xFF

  # The bytes the retired `\a \b \f \v` used to name are still writable.
  print(int_to_string(code_at("\x07", 0)))   # 7   bell
  print(int_to_string(code_at("\x08", 0)))   # 8   backspace
  print(int_to_string(code_at("\x0B", 0)))   # 11  vertical tab
  print(int_to_string(code_at("\x0C", 0)))   # 12  form feed

  # `\xHH` is exactly two digits, so a following hex digit is a literal
  # byte: `"\x411"` is 'A' then '1', not the C-style `\x411`.
  print(int_to_string(string_length("\x411")))   # 2
  print(int_to_string(code_at("\x411", 1)))      # 49  '1'

  # `\0` is NUL and never consumes following digits — `"\012"` is NUL,
  # '1', '2' (three bytes), not the C octal escape for newline.
  print(int_to_string(string_length("\012")))    # 3
  print(int_to_string(code_at("\012", 1)))       # 49  '1'

  # Lengths: a hex escape is ONE byte; `\x41\x42` is "AB" (len 2).
  print(int_to_string(string_length("\x41\x42")))   # 2

  # The byte-table slice path the JSON `\u` decoder depends on: a table
  # of bytes 0x01..0x05, slice index 4 must be the fifth byte (0x05).
  print(int_to_string(code_at(string_slice("\x01\x02\x03\x04\x05", 4, 1), 0)))  # 5
  0
}
