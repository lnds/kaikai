# Overflow discipline for `string.to_int` / `string.to_real`.
#
# Both parse through C's strto* family, which saturates on overflow and
# signals it only through errno. A saturating parser is worse than a
# failing one: the caller believes the parse succeeded and carries
# MAX_INT downstream as if it were the input.
#
# The boundary cases matter in both directions. The exact extremes are
# representable and must keep returning Some; one past them must be
# None. For reals only overflow is rejected — underflow to a subnormal
# or to zero is what IEEE 754 defines, not a parse failure.

fn ri(label: String, o: Option[Int]) : Unit / Stdout =
  match o {
    Some(v) -> Stdout.print(label ++ " => Some(" ++ int_to_string(v) ++ ")")
    None    -> Stdout.print(label ++ " => None")
  }

fn rr(label: String, o: Option[Real]) : Unit / Stdout =
  match o {
    Some(v) -> Stdout.print(label ++ " => Some(" ++ real_to_string(v) ++ ")")
    None    -> Stdout.print(label ++ " => None")
  }

fn main() = {
  # The exact extremes are representable: a fix that rejects these
  # breaks correct code.
  ri("int max      ", string_to_int("9223372036854775807"))
  ri("int min      ", string_to_int("-9223372036854775808"))
  ri("int zero     ", string_to_int("0"))
  ri("int negative ", string_to_int("-42"))

  # One past each extreme, and far past, saturate in C.
  ri("int max+1    ", string_to_int("9223372036854775808"))
  ri("int min-1    ", string_to_int("-9223372036854775809"))
  ri("int huge     ", string_to_int("99999999999999999999999"))
  ri("int huge neg ", string_to_int("-99999999999999999999999"))

  # Shapes that were already rejected before overflow was handled.
  ri("int junk     ", string_to_int("abc"))
  ri("int empty    ", string_to_int(""))
  ri("int trailing ", string_to_int("12abc"))
  ri("int sign only", string_to_int("-"))
  ri("int spaced   ", string_to_int(" 12 "))

  # Reals: ordinary values and both infinities-by-overflow.
  rr("real ok      ", string_to_real("1.5"))
  rr("real negative", string_to_real("-2.25"))
  rr("real overflow", string_to_real("1e400"))
  rr("real neg ovf ", string_to_real("-1e400"))

  # Underflow keeps the magnitude the type can represent, so it stays
  # Some. A subnormal is a legitimate value, not garbage.
  rr("real subnorm ", string_to_real("1e-320"))
  rr("real underflw", string_to_real("1e-400"))

  rr("real junk    ", string_to_real("abc"))
  rr("real empty   ", string_to_real(""))

  0
}
