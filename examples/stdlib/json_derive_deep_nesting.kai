# A deeply nested document decodes without a path that grows with depth,
# and a failure at the bottom still reports the full path text.

import encoding.json_bind

#[derive(Json)]
type Chain = { v: Int, next: Option[Chain] }

#[derive(Json)]
type Tree = { kids: [Tree] }

fn chain_json(n: Int, acc: JsonValue) : JsonValue =
  if n == 0 { acc }
  else { chain_json(n - 1, JObj([Pair { fst: "v", snd: JNum(n) }, Pair { fst: "next", snd: acc }])) }

fn tree_json(n: Int, acc: JsonValue) : JsonValue =
  if n == 0 { acc }
  else { tree_json(n - 1, JObj([Pair { fst: "kids", snd: JArr([acc]) }])) }

fn chain_len(c: Chain, acc: Int) : Int = match c.next {
  None    -> acc + 1
  Some(n) -> chain_len(n, acc + 1)
}

fn tree_len(t: Tree, acc: Int) : Int = match t.kids {
  []       -> acc + 1
  [k, ..._] -> tree_len(k, acc + 1)
}

fn expected_chain_path(n: Int, acc: String) : String =
  if n == 0 { json_path_field(acc, "v") }
  else { expected_chain_path(n - 1, json_path_field(acc, "next")) }

fn expected_tree_path(n: Int, acc: String) : String =
  if n == 0 { json_path_field(acc, "kids") }
  else { expected_tree_path(n - 1, json_path_index(json_path_field(acc, "kids"), 0)) }

fn main() : Unit / Console = {
  let depth = 5000
  let ok = chain_json(depth, JObj([Pair { fst: "v", snd: JNum(0) }]))
  match chain_of_json(ok, "") {
    Ok(c)  -> print("chain ok #{chain_len(c, 0)}")
    Err(e) -> print(json_error_show(e))
  }
  let bad = chain_json(depth, JObj([Pair { fst: "v", snd: JStr("x") }]))
  match chain_of_json(bad, "") {
    Ok(_)  -> print("chain decoded")
    Err(e) -> print("chain error path matches: #{e.path == expected_chain_path(depth, "")}")
  }
  match tree_of_json(tree_json(depth, JObj([Pair { fst: "kids", snd: JArr([]) }])), "") {
    Ok(t)  -> print("tree ok #{tree_len(t, 0)}")
    Err(e) -> print(json_error_show(e))
  }
  match tree_of_json(tree_json(depth, JObj([Pair { fst: "kids", snd: JStr("x") }])), "") {
    Ok(_)  -> print("tree decoded")
    Err(e) -> print("tree error path matches: #{e.path == expected_tree_path(depth, "")}")
  }
}
