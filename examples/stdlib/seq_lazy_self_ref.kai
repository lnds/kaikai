# A sequence defined in terms of itself: each cell is built from cells
# before it, read through the function that defines it. Every call of
# that function builds its own cells, so the spread, read only when its
# cell is, is what keeps the definition from running forever.

import seq

fn zip_add(a: Seq[Int], b: Seq[Int]) : Seq[Int] = match a {
  []         -> lazy []
  [x, ...xs] -> match b {
    []         -> lazy []
    [y, ...ys] -> lazy [x + y, ...zip_add(xs, ys)]
  }
}

fn fibs() : Seq[Int] = lazy [0, 1, ...zip_add(fibs(), drop(fibs(), 1))]

fn merge(a: Seq[Int], b: Seq[Int]) : Seq[Int] = match a {
  []         -> b
  [x, ...xs] -> match b {
    []         -> a
    [y, ...ys] ->
      if x < y { lazy [x, ...merge(xs, b)] }
      else if y < x { lazy [y, ...merge(a, ys)] }
      else { lazy [x, ...merge(xs, ys)] }
  }
}

fn hamming() : Seq[Int] =
  lazy [1, ...merge(hamming() | (x) => x * 2, merge(hamming() | (x) => x * 3, hamming() | (x) => x * 5))]

fn main() : Unit / Stdout = {
  Stdout.print(show(to_list(take(fibs(), 15))))
  Stdout.print(show(to_list(take(hamming(), 15))))
}
