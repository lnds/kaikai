# `Eq` for `Map` and `Set` must not depend on construction history.
#
# Both carriers are AVL trees, so the same bindings reached in a
# different insertion order land in a different node structure — from
# four keys up for `Map`, where the rebalancing rotations start to
# differ. `Set` additionally stores a per-member sequence number, so
# its trees diverge from three elements. A structural comparison
# reports equal contents as unequal in both cases; equality walks the
# in-order traversal instead.
#
# The negative cases matter as much as the positive ones: an equality
# that ignores structure is easy to make trivially true.

import collections.map
import collections.set

fn verify(label: String, ok: Bool) : Unit / Stdout =
  Stdout.print(label ++ ": " ++ (if ok { "ok" } else { "FAIL" }))

fn main() : Unit / Stdout = {
  let m3 = %{"a": 1, "b": 2, "c": 3}
  let m4 = %{"a": 1, "b": 2, "c": 3, "d": 4}
  let m5 = %{"a": 1, "b": 2, "c": 3, "d": 4, "e": 5}

  verify("map 3 reversed", m3 == %{"c": 3, "b": 2, "a": 1})
  verify("map 4 reversed", m4 == %{"d": 4, "c": 3, "b": 2, "a": 1})
  verify("map 5 reversed", m5 == %{"e": 5, "d": 4, "c": 3, "b": 2, "a": 1})
  verify("map 5 shuffled", m5 == %{"c": 3, "a": 1, "e": 5, "b": 2, "d": 4})

  verify("map value differs", not (m4 == %{"a": 1, "b": 2, "c": 3, "d": 9}))
  verify("map key differs",   not (m4 == %{"a": 1, "b": 2, "c": 3, "z": 4}))
  verify("map size differs",  not (m4 == m5))
  verify("map empty",         map.empty() == map.empty())

  let s3 = set.from([1, 2, 3])
  let s4 = set.from([1, 2, 3, 4])

  verify("set 3 reversed",  s3 == set.from([3, 2, 1]))
  verify("set 4 reversed",  s4 == set.from([4, 3, 2, 1]))
  verify("set dup insert",  s3 == set.insert(set.from([1, 2, 3]), 2))
  verify("set member differs", not (s3 == set.from([1, 2, 9])))
  verify("set size differs",   not (s3 == s4))

  # `Show` renders the literal spelling, in key order for `Map` and
  # insertion order for `Set` (matching `to_list`).
  Stdout.print("show map:  #{m4}")
  Stdout.print("show set:  #{set.from([3, 1, 2])}")
  Stdout.print("show pair: #{(1, "x")}")
  Stdout.print("show nest: #{%{"k": [1, 2]}}")
}
