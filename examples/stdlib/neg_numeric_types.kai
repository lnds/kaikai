# Unary `-` on the stdlib's signed numeric types calls each one's `Neg`.

import math.bigint
import math.complex
import decimal
import decimal_big
import rational
import date
import money

fn flip[t: Neg](v: t) : t = -v

fn show_period(p: Period) : String =
  "#{p.years}y #{p.months}m #{p.days}d"

fn main() : Unit / Stdout {
  let x = 128n
  Stdout.print(bigint.to_string(-128n))
  Stdout.print(bigint.to_string(-x))
  Stdout.print(bigint.to_string(-(-x)))
  Stdout.print(bigint.to_string(-0n))
  Stdout.print(bigint.to_string(-340282366920938463463374607431768211456n))
  Stdout.print(bigint.to_string(x + (-x)))
  Stdout.print(bigint.to_string(flip(5n)))

  let negate = a => -a
  Stdout.print(bigint.to_string(negate(9n)))

  let z = -complex.mk(1.5, -2.0)
  Stdout.print("#{z.re} #{z.im}")

  # Each part negates as a `Real` does, so a zero part becomes -0.
  let zero_re = -complex.mk(0.0, 1.0)
  Stdout.print("#{zero_re.re} #{zero_re.im}")

  let price: decimal.Decimal = 19.99d
  Stdout.print(decimal.to_string(-price))

  let wide = decimal_big.from_int(7)
  Stdout.print(decimal_big.to_string(-wide))

  Stdout.print(rational.to_string(-rational.from_int(3)))
  Stdout.print(show_period(-date.period_months(2)))

  let cash: Money[decimal.Decimal]<USD> = 10.50<USD>
  Stdout.print(money.to_string(-cash))
  Stdout.print(money.to_string(flip(cash)))

  let refund = m => -m
  Stdout.print(money.to_string(refund(cash)))
}
