# file.read / file.write / file.append report I/O failure as Err instead of aborting.

import fs.file

fn show_err(label: String, r: Result[a, String]) : Unit / Stdout =
  match r {
    Ok(_)  -> Stdout.print("#{label}: FAIL: Ok")
    Err(_) -> Stdout.print("#{label}: Err ok")
  }

fn main() : Unit / Stdout + File = {
  let missing = "/tmp/kaikai-fs-file-result/missing/none.txt"
  show_err("read missing", file.read(missing))
  show_err("write unwritable", file.write(missing, "x"))
  show_err("append unwritable", file.append(missing, "x"))
}
