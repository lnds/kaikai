# An ordering operator on a compound value reaches a record's `impl Ord`
# through a list, an `Option` or the key of an ordered map.

import collections.map

#[derive(Eq, Ord, Show)]
type Ver = { major: Int, minor: Int }

# Orders backwards, so a structural read of its field would be wrong.
type Prio = { n: Int }

impl Ord for Prio {
  fn cmp(a: Prio, b: Prio) : Int = b.n - a.n
  fn min(a: Prio, b: Prio) : Prio = if b.n - a.n < 0 { a } else { b }
  fn max(a: Prio, b: Prio) : Prio = if b.n - a.n > 0 { a } else { b }
}

fn ver(major: Int, minor: Int) : Ver = Ver { major: major, minor: minor }
fn prio(n: Int) : Prio = Prio { n: n }

fn main() : Unit / Stdout = {
  Stdout.print("list <: #{[ver(1, 2)] < [ver(1, 3)]} #{[ver(1, 3)] < [ver(1, 2)]} #{[ver(1, 2)] < [ver(1, 2)]}")
  Stdout.print("list >=: #{[ver(1, 3)] >= [ver(1, 2)]} #{[ver(1, 2)] >= [ver(1, 3)]} #{[ver(1, 2)] >= [ver(1, 2)]}")
  Stdout.print("list >, <=: #{[ver(2, 0)] > [ver(1, 9)]} #{[ver(2, 0)] <= [ver(1, 9)]}")
  Stdout.print("longer list: #{[ver(1, 2)] < [ver(1, 2), ver(0, 0)]} #{[ver(1, 2), ver(0, 0)] < [ver(1, 2)]}")
  Stdout.print("option in a list: #{[Some(ver(1, 2))] < [Some(ver(1, 3))]} #{[None] < [Some(ver(0, 0))]} #{[Some(ver(1, 3))] < [Some(ver(1, 2))]}")
  Stdout.print("result in a list: #{[Ok(ver(1, 2))] < [Ok(ver(1, 3))]} #{[Ok(ver(9, 9))] < [Err(ver(0, 0))]}")
  Stdout.print("list in a list: #{[[ver(1, 2)]] < [[ver(1, 3)]]} #{[[ver(1, 3)]] < [[ver(1, 2)]]}")
  Stdout.print("cmp: #{cmp([ver(1, 2)], [ver(1, 3)])} #{cmp([Some(ver(1, 3))], [Some(ver(1, 2))])} #{cmp([ver(1, 2)], [ver(1, 2)])}")
  Stdout.print("min, max: #{min([ver(1, 2)], [ver(1, 3)])} #{max([ver(1, 2)], [ver(1, 3)])}")
  Stdout.print("own impl in a list: #{[prio(1)] < [prio(2)]} #{[prio(2)] < [prio(1)]} #{[Some(prio(2))] < [Some(prio(1))]}")

  let tree = map.put(map.put(map.put(map.empty(), ver(2, 0), "b"), ver(1, 2), "a"), ver(2, 0), "c")
  Stdout.print("map key: #{map.size(tree)} #{map.keys(tree)} #{map.get(tree, ver(2, 0))} #{map.get(tree, ver(9, 9))}")
}
