# A recursive `Option` field round-trips, and a field named like a
# parameter of the generated reader (`v`, `path`) does not shadow it.

import encoding.json.{json_decode, json_encode}
import encoding.json_bind

#[derive(Json)]
type Node = { v: Int, path: String, next: Option[Node] }

fn chain(n: Int) : Node =
  Node { v: n, path: "p#{n}", next: if n == 0 { None } else { Some(chain(n - 1)) } }

fn sum(n: Node, acc: Int) : Int = match n.next {
  None    -> acc + n.v
  Some(m) -> sum(m, acc + n.v)
}

fn main() : Unit / Console = {
  let s = json_encode(to_json(chain(2)))
  print(s)
  match json_decode(s) {
    None -> print("bad json")
    Some(j) -> match node_of_json(j, "") {
      Ok(n)  -> print("sum=#{sum(n, 0)} head=#{n.path}")
      Err(e) -> print(json_error_show(e))
    }
  }
}
