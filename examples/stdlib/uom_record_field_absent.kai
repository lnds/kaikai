# A record under a unit is still that record: a field it does not declare
# is rejected where it is read.

import decimal

unit USD

type Wallet = { name: String, balance: Decimal<USD> }

fn main() : Unit / Stdout = {
  let w = Wallet { name: "alice", balance: 99.99<USD> }
  let bal : Decimal<USD> = w.balance
  Stdout.print("cents=#{bal.cents}")
}
