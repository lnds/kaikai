# A protocol operation with no argument takes its type from where it
# sits: an annotation, a result, an arm, a list element, a record field,
# an operand, the argument of a generic function, a lambda's result.

type Wrap[t] = { v: t }

fn second[t](a: t, b: t) : t = b

fn annotated[t : Numeric + Add](x: t) : t = {
  let z : t = zero()
  add(x, z)
}
fn result[t : Numeric](x: t) : t = zero()
fn after_block[t : Numeric](x: t) : t = {
  let _y = x
  zero()
}
fn match_arm[t : Numeric](x: t, b: Bool) : t = match b {
  true  -> x
  false -> zero()
}
fn if_arm[t : Numeric](x: t, b: Bool) : t = if b { x } else { zero() }
fn element[t : Numeric](x: t) : [t] = [x, zero()]
fn field[t : Numeric](x: t) : Wrap[t] = Wrap { v: zero() }
fn operand[t : Numeric + Add](x: t) : t = x + zero()
fn generic_arg[t : Numeric](x: t) : t = second(x, zero())
fn lambda_result[t : Numeric](x: t) : t = {
  let f = () => zero()
  second(x, f())
}

fn main() : Unit / Stdout = {
  Stdout.print("#{annotated(21)} #{result(21)} #{after_block(21)}")
  Stdout.print("#{match_arm(21, false)} #{if_arm(21, false)} #{element(21)}")
  Stdout.print("#{field(21).v} #{operand(21)} #{generic_arg(21)} #{lambda_result(21)}")
  Stdout.print("#{annotated(1.5)} #{element(1.5)}")
}
