# find, find_all, replace and split over a grid of patterns and inputs,
# captures included.

import regexp

fn span(m: regexp.Match) : String = {
  let gs = list.map(m.groups, (g) => "#{g.group_id}:#{g.start},#{g.end}")
  "#{m.start}-#{m.end}[#{string.join(gs, ";")}]"
}

fn found(m: Option[regexp.Match]) : String = match m {
  Some(x) -> span(x)
  None    -> "none"
}

fn probe(pat: String, input: String) : Unit / Stdout = match regexp.compile(pat) {
  Err(e) -> Stdout.print("#{pat} | #{e}")
  Ok(re) -> {
    let all = list.map(regexp.find_all(re, input), (m) => "#{m.start}-#{m.end}")
    Stdout.print("#{pat} | #{input} | #{found(regexp.find(re, input))} | #{string.join(all, ",")} | #{regexp.replace(re, input, "<$0|$1|$2>")} | #{string.join(regexp.split(re, input), "/")}")
  }
}

fn main() : Unit / Stdout = {
  let pats = ["a", "a+b", "a*", "(a|b)*c", "(a)(b)?", "^a", "a$", "^$", "", "x*", "(a*)*",
    "(a|ab)(c|bcd)(d*)", "[a-c]+", "[^a-c]+", "\\d+", "\\w+\\s", "a{2,3}", "a{2}", "a{2,}",
    "(?:ab)+", "(a+)(b+)", "(a|b|ab)*", ".", ".*", "a.c", "(foo|foobar)(bar)?", "x?y?z?",
    "(^a|b$)", "ab|cd|ef", "(a)|(b)", "((a)(b))+", "[a-z]+@[a-z]+", "(a|b)+?", "a(", "[a", "a{3,2}",
    "(a?){3}a{3}", "b*a", "(b|c)*$", "^(a|b)*$", "\\s+", "(\\w)(\\w)\\2"]
  let inputs = ["", "a", "abc", "aab", "aabaab", "xaaby", "abcd", "foobar", "foobarbar", "abab",
    "ccc", "aaa bbb", "a1 b22 c333", "ab\ncd", "bbbb", "bob@example", "aaaaaa"]
  list.foreach(pats, (p) => list.foreach(inputs, (i) => probe(p, i)))
}
