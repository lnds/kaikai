# A recursive type whose cycle runs through a direct nested constructor
# (no list or `Option`) round-trips at a depth far past what a fiber's own
# stack holds.

import spawn
import encoding.json.{json_decode, json_encode}
import encoding.json_bind

#[derive(Json)]
type Chain = { v: Int, next: Link }

#[derive(Json)]
type Link = End | More(Chain)

fn link(n: Int, acc: Link) : Link =
  if n == 0 { acc } else { link(n - 1, More(Chain { v: n, next: acc })) }

fn len(l: Link, acc: Int) : Int = match l {
  End      -> acc
  More(c)  -> len(c.next, acc + 1)
}

fn run(n: Int) : String = {
  let s = json_encode(to_json(link(n, End)))
  match json_decode(s) {
    None    -> "bad json"
    Some(j) -> match link_of_json(j, "") {
      Ok(l)  -> "bytes=#{string_length(s)} len=#{len(l, 0)}"
      Err(e) -> json_error_show(e)
    }
  }
}

fn main() : Unit / Spawn + Console = {
  let f = spawn.spawn(() => run(100000))
  print("fiber: #{spawn.await(f)}")
}
