# Encoding, chunk decoding and draining large outputs stays linear.

import encoding.hex
import encoding.base64
import net.http
import os.process

fn bytes(n: Int, i: Int, acc: [Int]) : [Int] =
  if i >= n { acc } else { bytes(n, i + 1, [i % 256, ...acc]) }

fn chunks(n: Int, i: Int, acc: [String]) : [String] =
  if i >= n { acc } else { chunks(n, i + 1, ["4\r\nabcd\r\n", ...acc]) }

fn main() : Unit / Stdout + Process = {
  Stdout.print("hex: #{string_length(hex.encode(bytes(400000, 0, [])))}")
  Stdout.print("base64: #{string_length(base64.encode(bytes(800000, 0, [])))}")
  Stdout.print("dechunk: #{string_length(http.dechunk_body(string_concat_all(chunks(400000, 0, [])) ++ "0\r\n\r\n"))}")
  match process.start_piped("head", ["-c", "33554432", "/dev/zero"]) {
    Err(e) -> Stdout.print("start failed: #{e}")
    Ok(c)  -> match process.read_all(c) {
      Ok(s)  -> Stdout.print("drain: #{string_length(s)}")
      Err(e) -> Stdout.print("read failed: #{e}")
    }
  }
}
