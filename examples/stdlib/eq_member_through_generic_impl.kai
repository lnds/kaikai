# `==` on a compound value reaches a member held by an `Option`, a
# `Result` or a generic type with its own `impl Eq`. The member compares
# by its impl when its type has one and member by member when it has
# none, exactly as it does outside that holder.

#[derive(Eq, Show)]
type Inner = { kind: String }

#[derive(Eq, Show)]
type Outer = { error: Option[Inner] }

#[derive(Eq)]
type Tree = Leaf(Inner) | Node(Option[Inner])

unit m

#[derive(Eq)]
type Span = { len: Real<m> }

type Plain = { n: Int }
type Shape = Dot | Line(Int)
type Holder = { at: Option[Plain], shape: Result[Shape, String] }

type Len = { s: String }

impl Eq for Len {
  fn eq(a: Len, b: Len) : Bool = string_length(a.s) == string_length(b.s)
}

type Box[t] = Box(t)

impl[t : Eq] Eq for Box[t] {
  fn eq(a: Box[t], b: Box[t]) : Bool = match a {
    Box(x) -> match b { Box(y) -> eq(x, y) }
  }
}

fn inner(s: String) : Inner = Inner { kind: s }
fn outer(s: String) : Outer = Outer { error: Some(inner(s)) }
fn plain(n: Int) : Plain = Plain { n: n }
fn holder(n: Int) : Holder = Holder { at: Some(plain(n)), shape: Ok(Line(n)) }
fn span(x: Real<m>) : Span = Span { len: x }
fn ok(s: String) : Result[Inner, String] = Ok(inner(s))
fn err(s: String) : Result[Int, Inner] = Err(inner(s))
fn zipped(n: Int) : [Option[(Int, String)]] = map(zip([n], ["k"]), (p) => Some(p))

# `same` holds two equal values, `differ` two different ones.
fn row(label: String, same: Bool, differ: Bool, ne_same: Bool, ne_differ: Bool) : Unit / Stdout =
  Stdout.print("#{label}: #{same} #{differ} #{ne_same} #{ne_differ}")

fn main() : Unit / Stdout = {
  row("record with an option field, in a list",
      [outer("x")] == [outer("x")], [outer("x")] == [outer("y")],
      [outer("x")] != [outer("x")], [outer("x")] != [outer("y")])
  row("option of a record, in a list",
      [Some(inner("x"))] == [Some(inner("x"))], [Some(inner("x"))] == [Some(inner("y"))],
      [Some(inner("x"))] != [Some(inner("x"))], [Some(inner("x"))] != [Some(inner("y"))])
  row("option against none, in a list",
      [Some(inner("x")), None] == [Some(inner("x")), None], [Some(inner("x"))] == [None],
      [Some(inner("x")), None] != [Some(inner("x")), None], [Some(inner("x"))] != [None])
  row("ok of a record, in a list",
      [ok("x")] == [ok("x")], [ok("x")] == [ok("y")],
      [ok("x")] != [ok("x")], [ok("x")] != [ok("y")])
  row("err of a record, in a list",
      [err("x")] == [err("x")], [err("x")] == [err("y")],
      [err("x")] != [err("x")], [err("x")] != [err("y")])
  row("option of an option, in a list",
      [Some(Some(inner("x")))] == [Some(Some(inner("x")))], [Some(Some(inner("x")))] == [Some(Some(inner("y")))],
      [Some(Some(inner("x")))] != [Some(Some(inner("x")))], [Some(Some(inner("x")))] != [Some(Some(inner("y")))])
  row("option of a list, in a list",
      [Some([inner("x")])] == [Some([inner("x")])], [Some([inner("x")])] == [Some([inner("y")])],
      [Some([inner("x")])] != [Some([inner("x")])], [Some([inner("x")])] != [Some([inner("y")])])
  row("option of a tuple, in a list",
      [Some((inner("x"), 1))] == [Some((inner("x"), 1))], [Some((inner("x"), 1))] == [Some((inner("y"), 1))],
      [Some((inner("x"), 1))] != [Some((inner("x"), 1))], [Some((inner("x"), 1))] != [Some((inner("y"), 1))])
  row("option of a zipped tuple, in a list",
      zipped(1) == zipped(1), zipped(1) == zipped(2),
      zipped(1) != zipped(1), zipped(1) != zipped(2))
  row("option of a record, in a tuple in a list",
      [(Some(inner("x")), 1)] == [(Some(inner("x")), 1)], [(Some(inner("x")), 1)] == [(Some(inner("y")), 1)],
      [(Some(inner("x")), 1)] != [(Some(inner("x")), 1)], [(Some(inner("x")), 1)] != [(Some(inner("y")), 1)])
  row("sum with a record payload, in a list",
      [Node(Some(inner("x"))), Leaf(inner("x"))] == [Node(Some(inner("x"))), Leaf(inner("x"))],
      [Node(Some(inner("x")))] == [Node(Some(inner("y")))],
      [Node(Some(inner("x"))), Leaf(inner("x"))] != [Node(Some(inner("x"))), Leaf(inner("x"))],
      [Node(Some(inner("x")))] != [Node(Some(inner("y")))])
  row("generic impl over a record, in a list",
      [Box(inner("x"))] == [Box(inner("x"))], [Box(inner("x"))] == [Box(inner("y"))],
      [Box(inner("x"))] != [Box(inner("x"))], [Box(inner("x"))] != [Box(inner("y"))])
  row("option of a generic impl, in a list",
      [Some(Box(inner("x")))] == [Some(Box(inner("x")))], [Some(Box(inner("x")))] == [Some(Box(inner("y")))],
      [Some(Box(inner("x")))] != [Some(Box(inner("x")))], [Some(Box(inner("x")))] != [Some(Box(inner("y")))])
  row("option of a record with a unit field, in a list",
      [Some(span(1.5<m>))] == [Some(span(1.5<m>))], [Some(span(1.5<m>))] == [Some(span(2.5<m>))],
      [Some(span(1.5<m>))] != [Some(span(1.5<m>))], [Some(span(1.5<m>))] != [Some(span(2.5<m>))])
  row("option of a record with its own impl, in a list",
      [Some(Len { s: "ab" })] == [Some(Len { s: "cd" })], [Some(Len { s: "ab" })] == [Some(Len { s: "abc" })],
      [Some(Len { s: "ab" })] != [Some(Len { s: "cd" })], [Some(Len { s: "ab" })] != [Some(Len { s: "abc" })])
  row("plain record holding an option and a result",
      holder(1) == holder(1), holder(1) == holder(2),
      holder(1) != holder(1), holder(1) != holder(2))
  row("option of a plain record, in a list",
      [Some(plain(1))] == [Some(plain(1))], [Some(plain(1))] == [Some(plain(2))],
      [Some(plain(1))] != [Some(plain(1))], [Some(plain(1))] != [Some(plain(2))])
  row("option of a plain sum, in a list",
      [Some(Line(1))] == [Some(Line(1))], [Some(Line(1))] == [Some(Dot)],
      [Some(Line(1))] != [Some(Line(1))], [Some(Line(1))] != [Some(Dot)])
  row("generic impl over a plain record, in a list",
      [Box(plain(1))] == [Box(plain(1))], [Box(plain(1))] == [Box(plain(2))],
      [Box(plain(1))] != [Box(plain(1))], [Box(plain(1))] != [Box(plain(2))])
}
