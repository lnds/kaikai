import encoding.json.{json_decode, json_encode}
import encoding.json_bind

fn bytes_of(s: String, i: Int, acc: String) : String =
  if i >= string_length(s) { acc }
  else { match char_at(s, i) {
    None    -> acc
    Some(c) -> bytes_of(s, i + 1, acc ++ " " ++ int_to_string(char_to_int(c)))
  } }

fn probe(label: String, text: String) : Unit / Stdout = {
  match json_decode(text) {
    None            -> Stdout.print(label ++ ": None")
    Some(JStr(s))   -> {
      Stdout.print(label ++ ": len " ++ int_to_string(string_length(s)) ++ ":" ++ bytes_of(s, 0, ""))
      Stdout.print(label ++ ": enc " ++ json_encode(JStr(s)))
    }
    Some(_)         -> Stdout.print(label ++ ": not a string")
  }
}

fn main() : Unit / Stdout = {
  probe("empty", "\"\"")
  probe("plain", "\"hello\"")
  probe("only_escapes", "\"\\n\\t\\r\\\"\\\\\\/\\b\\f\"")
  probe("mixed", "\"ab\\ncd\\\"ef\\\\gh\"")
  probe("leading", "\"\\nabc\"")
  probe("trailing", "\"abc\\n\"")
  probe("bmp", "\"x\\u00e9y\\u20acz\"")
  probe("only_unicode", "\"\\u0041\\u00e9\\u20ac\"")
  probe("surrogate", "\"a\\ud83d\\ude00b\"")
  probe("raw_utf8", "\"é€😀\"")
  probe("control", "\"\\u0001\\u001f\"")
  probe("lone_low", "\"\\udc00\"")
  probe("lone_high", "\"\\ud83dx\"")
  probe("unterminated", "\"abc")
  probe("bad_escape", "\"\\q\"")
  Stdout.print(json_encode(JStr("")))
  Stdout.print(json_encode(JStr("\n\"\\\t\r\x01é")))
}
