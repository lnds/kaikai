type Point = { x: Int, label: String }

type Shape = Dot | Line(Int, Int) | Named(String, Point)

fn point(x: Int, s: String) : Point = Point { x: x, label: s }

fn gen_eq[a](p: a, q: a) : Bool = p == q

fn gen_lt[a](p: a, q: a) : Bool = p < q

fn main() {
  let xs = [Some(point(1, "a")), None, Some(point(2, "b"))]
  let ys = [Some(point(1, "a")), None, Some(point(2, "b"))]
  let zs = [Some(point(1, "a")), None, Some(point(2, "c"))]
  println("list of options of records eq: #{xs == ys}")
  println("list of options of records ne: #{xs != zs}")
  let s1 = [Named("n", point(3, "p")), Line(1, 2), Dot]
  let s2 = [Named("n", point(3, "p")), Line(1, 2), Dot]
  let s3 = [Named("n", point(3, "q")), Line(1, 2), Dot]
  println("sums with payloads eq: #{s1 == s2}")
  println("sums with payloads ne: #{s1 == s3}")
  println("tuples eq: #{(1, "a", [2, 3]) == (1, "a", [2, 3])}")
  println("tuples ne: #{(1, "a", [2, 3]) == (1, "a", [2, 4])}")
  println("generic eq: #{gen_eq(xs, ys)} #{gen_eq(Some(1), None)}")
  println("option lt: #{Some(1) < Some(2)} #{None < Some(0)}")
  println("list lt: #{[1, 2, 3] < [1, 2, 4]} #{[2] < [1, 5]}")
  println("string lt: #{"abc" < "abd"} #{"b" < "a"}")
  println("generic lt: #{gen_lt([1, 2], [1, 3])} #{gen_lt(Some("b"), Some("a"))}")
  println("max/min: #{max(3, 7)} #{min("b", "a")}")
}
