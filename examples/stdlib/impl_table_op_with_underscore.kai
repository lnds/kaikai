# A dispatcher taken as a value picks its impl at run time, through the
# impl table. The table's rows are the impl methods the protocol
# lowering recorded: an operation whose name holds a `_` (`pow_int`) is
# filed under its own name and its impl's type, like any other.
import math.numeric

fn apply2[a](f: (a, Int) -> a, x: a, n: Int) : a = f(x, n)

fn main() : Unit / Stdout = {
  let power = pow_int
  Stdout.print("#{apply2(power, 2, 5)}")
  Stdout.print("#{apply2(pow_int, 1.5, 2)}")
}
