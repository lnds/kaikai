import crypto.hash.{sha256, sha512}
import crypto.legacy
import encoding.hex

fn rep(b: Int, n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { rep(b, n - 1, [b, ...acc]) }

fn all(n: Int) : Unit / Stdout {
  let m = rep(97, n, [])
  Stdout.print("#{n} sha256 " ++ hex.encode(sha256(m)))
  Stdout.print("#{n} sha512 " ++ hex.encode(sha512(m)))
  Stdout.print("#{n} sha1 " ++ hex.encode(legacy.sha1(m)))
  Stdout.print("#{n} md5 " ++ hex.encode(legacy.md5(m)))
}

fn main() : Unit / Stdout {
  [0, 3, 55, 56, 63, 64, 111, 112, 127, 128, 1000, 1000000] |! all(.)
}
