# Pins the BinSerialize decoders at their edges: the Int extremes, Strings
# with bytes >= 128, NUL and ill-formed UTF-8, empty lists and Strings, and
# a buffer cut one byte short at each length prefix and payload.

#[derive(BinSerialize)]
type Rec = { n: Int, s: String, xs: [Int], o: Option[String], r: Real }

fn show_rec(r: Rec) : String = {
  let o = match r.o { Some(t) -> "Some(#{string.byte_length(t)})"  None -> "None" }
  "n=#{r.n} s=#{string.byte_length(r.s)}b #{string.bytes(r.s) | byte_to_int} xs=#{r.xs} o=#{o} r=#{r.r}"
}

fn prefix(bs: Array[Byte], n: Int) : Array[Byte] = {
  let out = array_make(n, 0u8)
  bytes_blit(out, 0, bs, 0, n)
}

fn decode(label: String, bs: Array[Byte]) : Unit / Stdout = match rec_from_bytes(bs, 0) {
  Ok(c)  -> Stdout.print("#{label}: #{show_rec(c.value)} pos=#{c.pos}/#{array_length(bs)}")
  Err(m) -> Stdout.print("#{label}: Err(#{m})")
}

# Every cut short of the full encoding must fail, never read past the end.
fn cuts(bs: Array[Byte], n: Int, fails: Int) : Int =
  if n >= array_length(bs) { fails }
  else {
    let f = match rec_from_bytes(prefix(bs, n), 0) { Ok(_) -> 0  Err(_) -> 1 }
    cuts(bs, n + 1, fails + f)
  }

fn main() : Unit / Stdout = {
  let imin = -9223372036854775807 - 1
  let raw = string.from_bytes([255u8, 0u8, 195u8, 104u8])
  let recs = [
    Rec { n: imin, s: "", xs: [], o: None, r: 0.0 },
    Rec { n: 9223372036854775807, s: "héllo", xs: [-1, 0, 256], o: Some(""), r: -2.5 },
    Rec { n: -1, s: raw, xs: [imin], o: Some(raw), r: 0.001 }
  ]
  let _ = list.map(recs, (r) => {
    let bs = to_bytes(r)
    decode("rec", bs)
    Stdout.print("  cuts failing: #{cuts(bs, 0, 0)}/#{array_length(bs)}")
  })
  Stdout.print("int_from_bytes min: #{match int_from_bytes(to_bytes(imin), 0) { Ok(c) -> c.value == imin  Err(_) -> false }}")
  Stdout.print("int_from_bytes short: #{match int_from_bytes(prefix(to_bytes(imin), 7), 0) { Ok(_) -> "Ok"  Err(m) -> m }}")
}
