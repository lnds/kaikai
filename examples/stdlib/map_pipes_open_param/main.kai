# A Map pipe stage whose body does not pin its parameter still takes the
# entry: the element type comes from the head's combinator, not from the
# map's first type argument (the key). Each combinator is called once.

import collections.map

fn show(ps: [Pair[String, Int]]) : String = match ps {
  []           -> ""
  [p]          -> p.fst ++ "=" ++ int_to_string(p.snd)
  [p, ...rest] -> p.fst ++ "=" ++ int_to_string(p.snd) ++ "," ++ show(rest)
}

fn main() : Unit / Stdout = {
  let counts: Map[String, Int] = map.from([
    Pair { fst: "a", snd: 1 },
    Pair { fst: "b", snd: 2 }
  ])
  let every = counts |? (entry) => true
  let same  = every | (entry) => entry
  Stdout.print("same: " ++ show(map.to_pairs(same)))
}
