# A binop in a generic body reaches the operator's protocol once
# monomorphisation makes its operand concrete: `Mod7` takes its own
# impls (its `Ord` is reversed on purpose), `Int` and `Real` keep the
# primitive operators.
type Mod7 = { v: Int }

fn m(n: Int) : Mod7 = Mod7 { v: ((n % 7) + 7) % 7 }

impl Add for Mod7 { fn add(self: Mod7, rhs: Mod7) : Mod7 = m(self.v + rhs.v) }
impl Sub for Mod7 { fn sub(self: Mod7, rhs: Mod7) : Mod7 = m(self.v - rhs.v) }
impl Mul for Mod7 { fn mul(self: Mod7, rhs: Mod7) : Mod7 = m(self.v * rhs.v) }
impl Div for Mod7 { fn div(self: Mod7, rhs: Mod7) : Mod7 = m(self.v / rhs.v) }
impl Rem for Mod7 { fn rem(self: Mod7, rhs: Mod7) : Mod7 = m(self.v % rhs.v) }
impl Eq for Mod7 { fn eq(a: Mod7, b: Mod7) : Bool = a.v == b.v }
impl Ord for Mod7 {
  fn cmp(a: Mod7, b: Mod7) : Int = b.v - a.v
  fn min(a: Mod7, b: Mod7) : Mod7 = if b.v - a.v < 0 { b } else { a }
  fn max(a: Mod7, b: Mod7) : Mod7 = if b.v - a.v < 0 { a } else { b }
}

fn plus[T : Add](a: T, b: T) : T = a + b
fn minus[T : Sub](a: T, b: T) : T = a - b
fn times[T : Mul](a: T, b: T) : T = a * b
fn over[T : Div](a: T, b: T) : T = a / b
fn modulo[T : Rem](a: T, b: T) : T = a % b
fn same[T : Eq](a: T, b: T) : Bool = a == b
fn differ[T : Eq](a: T, b: T) : Bool = a != b
fn less[T : Ord](a: T, b: T) : Bool = a < b
fn atmost[T : Ord](a: T, b: T) : Bool = a <= b

fn main() : Unit / Stdout = {
  let a = m(3)
  let b = m(5)
  Stdout.print("#{plus(a, b).v} #{minus(a, b).v} #{times(a, b).v} #{over(b, a).v} #{modulo(b, a).v}")
  Stdout.print("#{same(a, m(10))} #{differ(a, b)} #{less(a, b)} #{atmost(b, a)}")
  let x = "x"
  Stdout.print("#{plus(3, 5)} #{times(2.5, 2.0)} #{less(3, 5)} #{same(x, x)}")
}
