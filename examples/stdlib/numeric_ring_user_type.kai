# A user ring is `Numeric + Add + Mul`: `zero` and `one` come from
# `Numeric`, `+` and `*` from the operator protocols, so `list.sum`,
# `list.product` and the range folds work over it.
type Mod7 = { v: Int }

impl Numeric for Mod7 {
  fn zero() : Mod7 = Mod7 { v: 0 }
  fn one() : Mod7 = Mod7 { v: 1 }
  fn abs(x: Mod7) : Mod7 = x
  fn sign(x: Mod7) : Int = if x.v == 0 { 0 } else { 1 }
  fn pow_int(b: Mod7, e: Int) : Mod7 = if e <= 0 { Mod7 { v: 1 } } else { b * pow_int(b, e - 1) }
  fn clamp(x: Mod7, lo: Mod7, hi: Mod7) : Mod7 = x
}

impl Add for Mod7 {
  fn add(self: Mod7, rhs: Mod7) : Mod7 = Mod7 { v: (self.v + rhs.v) % 7 }
}

impl Mul for Mod7 {
  fn mul(self: Mod7, rhs: Mod7) : Mod7 = Mod7 { v: (self.v * rhs.v) % 7 }
}

fn m(n: Int) : Mod7 = Mod7 { v: n % 7 }

fn main() : Unit / Stdout = {
  let xs = [m(3), m(5), m(6)]
  Stdout.print("#{list.sum(xs).v} #{list.product(xs).v}")
  Stdout.print("#{list.sum([1, 2, 3])} #{list.product([1.5, 2.0])}")
  Stdout.print("#{range_map_sum(1, 4, m).v} #{range_map_product(1, 4, m).v}")
  Stdout.print("#{pow_int(m(3), 3).v}")
}
