# Every function here writes only cells it built itself, so none of
# them declares `Mutable`: the writes are invisible to the caller.

fn set_first(xs: Array[Int], v: Int) : Unit / Mutable = { xs[0] := v }

# A generic list folded into a local Array through a lambda.
fn fill_from[a](xs: [a], seed: a) : Array[a] = {
  let out = array_make(list_length(xs), seed)
  let _ = list.foldl(xs, 0, (i, x) => {
    out[i] := x
    i + 1
  })
  out
}

# A local lambda writing a local Array.
fn via_local_lambda() : Array[Int] = {
  let out = array_make(3, 0)
  let set = (i, v) => { out[i] := v }
  set(0, 4)
  set(2, 6)
  out
}

# A local name for a top-level writer, applied to a local buffer.
fn via_writer_alias(n: Int) : Array[Byte] = {
  let put = bytes_put_le
  let buf = array_make(4, 0u8)
  put(buf, 0, n, 4)
}

# A local Array piped into a writer.
fn via_pipe() : Array[Int] = {
  let out = array_make(2, 0)
  out |> set_first(9)
  out
}

# A value holding an Array still encodes purely: the derived writer
# mutates only its buffer, never the value it reads.
type Raw = { bytes: Array[Byte] }

impl BinSerialize for Raw {
  fn to_bytes(self: Raw) : Array[Byte] = self.bytes
  fn from_bytes(buf: Array[Byte], pos: Int) : Result[BinCursor[Raw], String] =
    Ok(BinCursor { value: Raw { bytes: buf }, pos: array_length(buf) })
}

#[derive(BinSerialize)]
type Blob = { tag: Int, raw: Raw }

fn show_ints(xs: Array[Int], i: Int, acc: String) : String =
  if i >= array_length(xs) { acc }
  else { show_ints(xs, i + 1, "#{acc}#{xs[i]} ") }

fn main() : Unit / Stdout = {
  let names = fill_from(["a", "b", "c"], "")
  Stdout.print("fill_from #{names[0]}#{names[1]}#{names[2]}")
  Stdout.print("via_local_lambda #{show_ints(via_local_lambda(), 0, "")}")
  Stdout.print("via_writer_alias #{bytes_get_le(via_writer_alias(258), 0, 4)}")
  Stdout.print("via_pipe #{show_ints(via_pipe(), 0, "")}")
  let b = Blob { tag: 7, raw: Raw { bytes: via_writer_alias(513) } }
  Stdout.print("to_bytes #{array_length(b.to_bytes())}")
}
