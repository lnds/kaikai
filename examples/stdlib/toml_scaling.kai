# Decoding and encoding large documents stays linear in their size.

import encoding.toml

fn indices(n: Int, i: Int, acc: [Int]) : [Int] =
  if i >= n { acc } else { indices(n, i + 1, [i, ...acc]) }

fn lines(n: Int, f: (Int) -> String) : String =
  string_concat_all(list.map(indices(n, 0, []), f))

fn table_count(src: String) : Int = match toml.decode(src) {
  Some(TTbl(ps)) -> list_length(ps)
  _              -> -1
}

fn first_length(src: String, key: String) : Int = match toml.decode(src) {
  Some(TTbl(ps)) -> match toml.pairs_get(ps, key) {
    Some(TArr(xs)) -> list_length(xs)
    Some(TStr(s))  -> string_length(s)
    _              -> -1
  }
  _ -> -1
}

fn main() : Unit / Stdout = {
  Stdout.print("keys: " ++ int_to_string(table_count(lines(30000, (i) => "k#{i} = #{i}\n"))))
  Stdout.print("tables: " ++ int_to_string(table_count(lines(30000, (i) => "[t#{i}]\nx = 1\n"))))
  Stdout.print("array: " ++ int_to_string(first_length("a = [" ++ string.join(list.map(indices(60000, 0, []), (i) => "#{i}"), ", ") ++ "]\n", "a")))
  Stdout.print("aot: " ++ int_to_string(first_length(lines(30000, (i) => "[[p]]\nn = #{i}\n"), "p")))
  Stdout.print("string: " ++ int_to_string(first_length("s = \"" ++ string.repeat("ab\\n", 200000) ++ "\"\n", "s")))
  let doc = TTbl(list.map(indices(30000, 0, []), (i) => Pair { fst: "k#{i}", snd: TInt(i) }))
  Stdout.print("encoded keys: " ++ int_to_string(string_length(toml.encode(doc))))
  let text = TTbl([Pair { fst: "s", snd: TStr(string.repeat("a\n", 200000)) }])
  Stdout.print("encoded string: " ++ int_to_string(string_length(toml.encode(text))))
  let arr = TTbl([Pair { fst: "a", snd: TArr(list.map(indices(60000, 0, []), (i) => TInt(i))) }])
  Stdout.print("encoded array: " ++ int_to_string(string_length(toml.encode(arr))))
}
