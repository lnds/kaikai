# A derive whose fields need more than one combinator lambda: the
# lifted lambdas are keyed by source position, so every synthesised one
# must land at a distinct column or the second redefines the first.

import encoding.json.{json_decode, json_encode}

#[derive(Json)]
type Leaf = { n: Int }

#[derive(Json)]
type Nest = { opt: Option[Leaf], many: [Leaf], deep: [[Leaf]] }

#[derive(Json)]
type Pick = Single([Leaf]) | Double([Leaf], Option[Leaf])

fn decode_nest(src: String) : String = match json_decode(src) {
  None -> "bad json"
  Some(v) -> match nest_of_json(v, "") {
    Ok(n)  -> "nest #{list_length(n.many)}/#{list_length(n.deep)}"
    Err(e) -> json_error_show(e)
  }
}

fn decode_pick(src: String) : String = match json_decode(src) {
  None -> "bad json"
  Some(v) -> match pick_of_json(v, "") {
    Ok(Single(xs))    -> "single #{list_length(xs)}"
    Ok(Double(xs, o)) -> match o {
      Some(l) -> "double #{list_length(xs)}/#{l.n}"
      None    -> "double #{list_length(xs)}/none"
    }
    Err(e) -> json_error_show(e)
  }
}

fn main() : Unit / Console = {
  let n = Nest { opt: Some(Leaf { n: 1 }), many: [Leaf { n: 2 }],
                 deep: [[Leaf { n: 3 }], [Leaf { n: 4 }, Leaf { n: 5 }]] }
  let ns = json_encode(to_json(n))
  print(ns)
  print(decode_nest(ns))

  let p = Double([Leaf { n: 6 }], Some(Leaf { n: 7 }))
  let ps = json_encode(to_json(p))
  print(ps)
  print(decode_pick(ps))
}
