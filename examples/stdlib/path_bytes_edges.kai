import path

fn main() : Int / Stdout {
  Stdout.print(
    "[#{path.basename("")}][#{path.basename("/")}][#{path.basename("a/b/é日.kai")}][#{path.basename("/é")}]"
  )
  Stdout.print("[#{path.dirname("")}][#{path.dirname("/é")}][#{path.dirname("ü/ñ/x")}]")
  Stdout.print("[#{path.ext("é.日")}][#{path.ext("a.b/c")}][#{path.ext("noext")}]")
  Stdout.print(
    "[#{path.join("a//", "//é")}][#{path.join("é/", "x")}][#{path.join("", "x")}][#{path.join("a", "")}]"
  )
  0
}
