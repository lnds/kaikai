# `#[derive(Json)]` on a sum type: the adjacently-tagged
# `{"tag": "<Variant>", "value": <payload>}` envelope. A nullary variant
# writes `value: null`, a single-payload variant its lone encoding, a
# multi-payload variant a JSON array. Decode reads the tag, routes to the
# variant, and decodes `value` against that variant's payload; an unknown
# tag is a located `JsonError`. Composition holds in both directions: a
# sum nested in a record and a record nested in a sum variant.

import encoding.json.{json_decode, json_encode}

#[derive(Json)]
type Shape = Empty | Circle(Real) | Rect(Real, Real)

#[derive(Json)]
type Point = { x: Int, y: Int }

#[derive(Json)]
type Node = Leaf | At(Point) | Seg(Point, Point)

#[derive(Json)]
type Scene = { name: String, node: Node }

fn show_shape(sh: Shape) : String = match sh {
  Empty      -> "empty"
  Circle(r)  -> "circle #{r}"
  Rect(w, h) -> "rect #{w}x#{h}"
}

fn roundtrip_shape(sh: Shape) : String / Console = {
  let s = json_encode(to_json(sh))
  match json_decode(s) {
    None    -> "bad json"
    Some(v) -> match shape_of_json(v, "") {
      Ok(sh2) -> "#{s} -> #{show_shape(sh2)}"
      Err(e)  -> "#{s} -> ERR #{json_error_show(e)}"
    }
  }
}

fn show_node(n: Node) : String = match n {
  Leaf      -> "leaf"
  At(p)     -> "at #{p.x},#{p.y}"
  Seg(a, b) -> "seg #{a.x},#{a.y}-#{b.x},#{b.y}"
}

fn main() : Unit / Console = {
  # Each variant shape round-trips.
  print(roundtrip_shape(Empty))
  print(roundtrip_shape(Circle(1.5)))
  print(roundtrip_shape(Rect(2.5, 3.5)))

  # A record inside a sum variant, and a sum inside a record.
  let sc = Scene { name: "s", node: Seg(Point { x: 0, y: 0 }, Point { x: 3, y: 4 }) }
  let enc = json_encode(to_json(sc))
  print(enc)
  match json_decode(enc) {
    None    -> print("bad json")
    Some(v) -> match scene_of_json(v, "") {
      Ok(sc2) -> print("#{sc2.name}: #{show_node(sc2.node)}")
      Err(e)  -> print("ERR #{json_error_show(e)}")
    }
  }

  # An unknown tag is a located error naming the accepted variants.
  match json_decode("{\"tag\": \"Triangle\", \"value\": null}") {
    None    -> print("bad json")
    Some(v) -> match shape_of_json(v, "root") {
      Ok(_)  -> print("unexpected ok")
      Err(e) -> print("unknown -> #{json_error_show(e)}")
    }
  }

  # A malformed payload is located at `value`.
  match json_decode("{\"tag\": \"Circle\", \"value\": \"nope\"}") {
    None    -> print("bad json")
    Some(v) -> match shape_of_json(v, "root") {
      Ok(_)  -> print("unexpected ok")
      Err(e) -> print("bad payload -> #{json_error_show(e)}")
    }
  }
}
