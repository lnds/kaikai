# A Real keeps every bit through `to_bytes` / `from_bytes`, by the impl and
# by a derived codec, and a payload spelled as the short decimal still reads.
# The NaN here is the one the text `nan` names; a sign or payload may not survive.

#[derive(BinSerialize)]
type Box = { v: Real }

fn back(bs: Array[Byte]) : Option[Real] = match box_from_bytes(bs, 0) {
  Ok(c)  -> Some(c.value.v)
  Err(_) -> None
}

fn same(x: Real, got: Option[Real]) : Bool = match got {
  Some(y) -> real_bits(x) == real_bits(y)
  None    -> false
}

fn row(label: String, x: Real) : Unit / Stdout = {
  let direct = to_bytes(x)
  let derived = to_bytes(Box { v: x })
  Stdout.print("#{label}: #{bin_string_at(direct, 0)} impl=#{same(x, back(direct))} derive=#{same(x, back(derived))}")
}

fn named(label: String, text: String) : Unit / Stdout = match string_to_real(text) {
  Some(x) -> row(label, x)
  None    -> Stdout.print("#{label}: unreadable")
}

# A String's wire form is that of a Real written as the same text.
fn short(text: String, want: Real) : Unit / Stdout =
  Stdout.print("short #{text}: reads=#{same(want, back(to_bytes(text)))}")

fn main() : Unit / Stdout = {
  row("tenth", 0.1)
  row("third", 1.0 / 3.0)
  row("pi", 3.141592653589793)
  row("negative", -2.718281828459045)
  row("seven digits", 1234567.0)
  row("past 2^53", 9007199254740993.0)
  row("max finite", 1.7976931348623157e308)
  row("min normal", 2.2250738585072014e-308)
  row("min subnormal", 4.9e-324)
  row("short decimal", 1.5)
  row("short exponent", 1.0e22)
  row("zero", 0.0)
  row("negative zero", -0.0)
  named("infinity", "inf")
  named("negative infinity", "-inf")
  named("nan", "nan")
  short("0.333333", 0.333333)
  short("1.79769e+308", 1.79769e308)
  short("4.94066e-324", 4.9e-324)
  short("-0", -0.0)
}
