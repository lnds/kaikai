# Generic core functions instantiated at types only this program declares:
# a build that links a cached core object must still emit these instances.

#[derive(Show, Eq)]
type Point = { x: Int, y: Int }

type Acc = { n: Int, sum: Int }

fn main() : Unit / Stdout = {
  let ps = [Point { x: 3, y: 1 }, Point { x: 1, y: 2 }, Point { x: 2, y: 3 }, Point { x: 1, y: 2 }]
  let sorted = sort_by(ps, (a, b) => a.x - b.x)
  Stdout.print("sorted=#{map(sorted, (p) => p.x)}")
  Stdout.print("rev=#{map(reverse(ps), (p) => p.y)}")
  Stdout.print("found=#{map_or_zero(find(ps, (p) => p.y == 3))}")
  Stdout.print("max=#{map_or_zero(max_by(ps, (p) => p.y))}")
  Stdout.print("uniq=#{list_len(uniq(ps))}")
  let acc = foldl(ps, Acc { n: 0, sum: 0 }, (a, p) => Acc { n: a.n + 1, sum: a.sum + p.x * p.y })
  Stdout.print("acc=#{acc.n},#{acc.sum}")
  let pairs = zip(ps, ["a", "b", "c"])
  Stdout.print("zip=#{list_len(pairs)}")
  let lifted = option.map(Some(Point { x: 7, y: 8 }), (p) => Acc { n: p.x, sum: p.y })
  Stdout.print("lifted=#{option.unwrap_or(option.map(lifted, (a) => a.n + a.sum), 0)}")
}

fn map_or_zero(o: Option[Point]) : Int = match o {
  Some(p) -> p.x * 10 + p.y
  None -> 0
}

fn list_len(xs: [a]) : Int = foldl(xs, 0, (n, _x) => n + 1)
