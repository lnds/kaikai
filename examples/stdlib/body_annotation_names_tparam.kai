# An annotation inside a generic body names the fn's own type parameter,
# so each instantiation gets its own specialisation.
fn collect[t](n: Int, x: t) : [t] = {
  let acc: [t] = []
  fill(n, x, acc)
}

fn fill[t](n: Int, x: t, acc: [t]) : [t] = if n == 0 { acc } else { fill(n - 1, x, [x, ...acc]) }

fn main() : Unit / Stdout = {
  let xs = collect(3, 7)
  let ys = collect(2, "ab")
  let sep = "-"
  Stdout.print("#{list.sum(xs)} #{string.join(ys, sep)}")
}
