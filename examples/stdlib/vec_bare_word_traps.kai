# Pins the traps of the bare-word Vec paths: an index one past the end,
# a negative index and an index into an empty vec trap with the range
# message instead of touching memory, on a read and on a write, inside a
# loop and outside one. Each case runs in its own fiber under a
# trap-exit supervisor, which reports the trap and moves on.

import actor
import spawn

type Point = { x: Int, y: Int }

fn points(v: Vec[Point], k: Int, n: Int) : Vec[Point] =
  if k > n { v } else { points(vec_push(v, Point { x: k, y: k }), k + 1, n) }

fn ints(v: Vec[Int], k: Int, n: Int) : Vec[Int] =
  if k > n { v } else { ints(vec_push(v, k), k + 1, n) }

fn reals(v: Vec[Real], k: Int, n: Int) : Vec[Real] =
  if k > n { v } else { reals(vec_push(v, int_to_real(k)), k + 1, n) }

fn sum_x(v: Vec[Point], i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else { sum_x(v, i + 1, n, acc + vec_get(v, i).x) }

fn sum(v: Vec[Int], i: Int, n: Int, acc: Int) : Int =
  if i >= n { acc } else { sum(v, i + 1, n, acc + vec_get(v, i)) }

# Every case targets a three-element vec, or an empty one.
fn run_case(k: Int) : Int = match k {
  0 -> sum_x(points(vec_empty(), 1, 3), 0, 4, 0)
  1 -> sum(ints(vec_empty(), 1, 3), 0, 4, 0)
  2 -> vec_get(points(vec_empty(), 1, 3), 0 - 1).y
  3 -> vec_get(ints(vec_empty(), 1, 3), 3) + 1
  4 -> real_to_int(vec_get(reals(vec_empty(), 1, 3), 5) + 0.5)
  5 -> sum(vec_empty(), 0, 1, 0)
  6 -> sum_x(vec_empty(), 0, 1, 0)
  7 -> vec_length(vec_set(points(vec_empty(), 1, 3), 3, Point { x: 0, y: 0 }))
  8 -> vec_length(vec_set(ints(vec_empty(), 1, 3), 0 - 2, 7))
  _ -> vec_length(vec_set(reals(vec_empty(), 1, 3), 4, 1.5))
}

fn child(parent: Pid[String], k: Int) : Unit / Actor[String] + Link + Console = {
  Link.link(parent)
  let n = run_case(k)
  Stdout.print("UNREACHABLE: case #{k} returned #{n}")
}

fn supervise(me: Pid[String], k: Int) : Unit / Actor[String] + Spawn + Console + Link =
  if k > 9 { () }
  else {
    let _ = spawn.spawn(() => with_mailbox { child(me, k) })
    Stdout.print("case #{k}: #{Actor.receive()}")
    supervise(me, k + 1)
  }

fn supervisor() : Unit / Actor[String] + Spawn + Console + Link = {
  let _ = spawn.set_trap_exit(true)
  supervise(Actor.self(), 0)
}

fn main() : Int / Console + Spawn + Link = {
  with_mailbox { supervisor() }
  0
}
