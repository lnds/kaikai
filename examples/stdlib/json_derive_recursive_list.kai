# A recursive `[T]` field round-trips through a fiber at a nesting depth
# well inside the fiber stack budget.

import spawn
import encoding.json.{json_decode, json_encode}
import encoding.json_bind

#[derive(Json)]
type Tree = { kids: [Tree] }

fn build(n: Int) : Tree =
  if n == 0 { Tree { kids: [] } } else { Tree { kids: [build(n - 1), Tree { kids: [] }] } }

fn depth(t: Tree, acc: Int) : Int = match t.kids {
  []       -> acc
  [k, ...] -> depth(k, acc + 1)
}

fn run(n: Int) : String / Console = {
  let s = json_encode(to_json(build(n)))
  match json_decode(s) {
    None    -> "bad json"
    Some(j) -> match tree_of_json(j, "") {
      Ok(t)  -> "bytes=#{string_length(s)} depth=#{depth(t, 0)}"
      Err(e) -> json_error_show(e)
    }
  }
}

fn main() : Unit / Spawn + Console = {
  let f = spawn.spawn(() => run(50))
  print("fiber: #{spawn.await(f)}")
}
