# A tuple is `Hash` component-wise, so a type holding one derives `Hash`
# and equal values hash equal.

#[derive(Eq, Hash)]
type Cell = { at: (Int, Int), tag: (String, Char, Bool) }

#[derive(Eq, Hash)]
type Key = K((Int, String)) | Keys([(Int, Int, Int, Int)])

fn main() : Int / Stdout {
  let c1 = Cell { at: (2, 3), tag: ("x", 'y', true) }
  let c2 = Cell { at: (2, 3), tag: ("x", 'y', true) }
  let c3 = Cell { at: (3, 2), tag: ("x", 'y', true) }
  Stdout.print("cell: #{hash(c1) == hash(c2)} #{hash(c1) == hash(c3)} #{c1 == c2} #{c1 == c3}")
  Stdout.print(
    "key: #{hash(K((1, "a"))) == hash(K((1, "a")))} #{hash(K((1, "a"))) == hash(K((1, "b")))}"
  )
  Stdout.print(
    "keys: #{hash(Keys([(1, 2, 3, 4)])) == hash(Keys([(1, 2, 3, 4)]))} #{hash(Keys([(1, 2, 3, 4)])) == hash(Keys([(4, 3, 2, 1)]))}"
  )
  Stdout.print("pair: #{hash((1, 2))} #{hash((2, 1))}")
  Stdout.print(
    "nested: #{hash(((1, 2), "k")) == hash(((1, 2), "k"))} #{hash((Some((1, 2)), 3)) == hash((Some((1, 2)), 3))}"
  )
  0
}
