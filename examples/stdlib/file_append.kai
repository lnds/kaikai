# file.append adds only the new bytes at the end; many appends stay linear.

import fs.file

fn append_lines(path: String, i: Int, n: Int) : Unit / File =
  if i >= n { () } else { file.append(path, "line #{i}\n"); append_lines(path, i + 1, n) }

fn main() : Unit / Stdout + File = {
  let path = "/tmp/kai_file_append_fixture.txt"
  let _ = file_delete(path)
  file.append(path, "created")
  Stdout.print("created: [#{file.read(path)}]")
  file.append(path, "")
  file.append(path, " é中")
  file.append(path, "\nsecond")
  Stdout.print("grown: [#{file.read(path)}]")
  file.write(path, "reset")
  file.append(path, "+tail")
  Stdout.print("after write: [#{file.read(path)}]")
  file.write(path, "")
  append_lines(path, 0, 60000)
  let text = file.read(path)
  let lines = string.split(text, "\n")
  Stdout.print("many: bytes=#{string_length(text)} lines=#{list_length(lines) - 1} first=#{list.head(lines)} last=#{list.last(list.take(lines, 60000))}")
  let _ = file_delete(path)
}
