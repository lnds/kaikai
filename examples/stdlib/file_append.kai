# file.append adds only the new bytes at the end; many appends stay linear.

import fs.file

fn append_lines(path: String, i: Int, n: Int) : Unit / File =
  if i >= n { () } else { file.append(path, "line #{i}\n") |> ignore; append_lines(path, i + 1, n) }

fn main() : Unit / Stdout + File = {
  let path = "/tmp/kai_file_append_fixture.txt"
  let _ = file.delete(path)
  file.append(path, "created") |> ignore
  Stdout.print("created: [#{file.read(path) |> unwrap_or("")}]")
  file.append(path, "") |> ignore
  file.append(path, " é中") |> ignore
  file.append(path, "\nsecond") |> ignore
  Stdout.print("grown: [#{file.read(path) |> unwrap_or("")}]")
  file.write(path, "reset") |> ignore
  file.append(path, "+tail") |> ignore
  Stdout.print("after write: [#{file.read(path) |> unwrap_or("")}]")
  file.write(path, "") |> ignore
  append_lines(path, 0, 60000)
  let text = file.read(path) |> unwrap_or("")
  let lines = string.split(text, "\n")
  Stdout.print("many: bytes=#{string_length(text)} lines=#{list_length(lines) - 1} first=#{list.head(lines)} last=#{list.last(list.take(lines, 60000))}")
  let _ = file.delete(path)
}
