# A `Ref` the function creates masks `Mutable` for the function, not for
# a cell that reads it: a sequence stored back into the `Ref` it reads
# would hold itself.

import seq

fn main() : Unit / Stdout = {
  let r = &(lazy [0])
  let s = lazy [1, ...@r]
  r := s
  Stdout.print(show(to_list(take(s, 3))))
}
