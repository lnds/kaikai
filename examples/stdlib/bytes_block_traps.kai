# Pins the range traps of the Array[Byte] block builtins: a range one past
# the end, a negative offset, and a width outside 0..8 trap instead of
# touching memory. Each case runs in its own fiber under a trap-exit
# supervisor, which reports the trap and moves on to the next case.

import actor
import spawn

# Every case targets an 8-byte buffer.
fn run_case(k: Int, b: Array[Byte]) : Int / Mutable = match k {
  0 -> array_length(bytes_put_le(b, 1, 7, 8))
  1 -> bytes_get_le(b, 1, 8)
  2 -> array_length(bytes_put_le(b, 9, 7, 0))
  3 -> bytes_get_le(b, 9, 0)
  4 -> bytes_get_le(b, 0, 9)
  5 -> array_length(bytes_blit(b, 5, b, 0, 4))
  6 -> array_length(bytes_blit(b, 0, b, 5, 4))
  7 -> array_length(bytes_blit(b, -1, b, 0, 1))
  8 -> array_length(bytes_put_string(b, 6, "abc"))
  _ -> string_length(bytes_get_string(b, 5, 4))
}

fn child(parent: Pid[String], k: Int) : Unit / Actor[String] + Link + Console + Mutable = {
  Link.link(parent)
  let n = run_case(k, array_make(8, 0u8))
  Stdout.print("UNREACHABLE: case #{k} returned #{n}")
}

fn supervise(me: Pid[String], k: Int) : Unit / Actor[String] + Spawn + Console + Link + Mutable =
  if k > 9 { () }
  else {
    let _ = spawn.spawn(() => with_mailbox { child(me, k) })
    Stdout.print("case #{k}: #{Actor.receive()}")
    supervise(me, k + 1)
  }

fn supervisor() : Unit / Actor[String] + Spawn + Console + Link + Mutable = {
  let _ = spawn.set_trap_exit(true)
  supervise(Actor.self(), 0)
}

fn main() : Int / Console + Spawn + Link + Mutable = {
  with_mailbox { supervisor() }
  0
}
