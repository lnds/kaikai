# `string.last_index_of` searches backwards through the core-declared
# builtin `string_rfind`: byte offsets, overlaps allowed.

fn show(r: Option[Int]) : String = match r {
  Some(i) -> int_to_string(i)
  None -> "none"
}

fn main() : Unit / Stdout {
  print(show(string.last_index_of("aaa", "aa")))
  print(show(string.last_index_of("hello", "")))
  print(show(string.last_index_of("", "")))
  print(show(string.last_index_of("", "a")))
  print(show(string.last_index_of("hello", "x")))
  print(show(string.last_index_of("hello", "hello!")))
  print(show(string.last_index_of("hello", "h")))
  print(show(string.last_index_of("hello", "hello")))
  print(show(string.last_index_of("hello", "o")))
  print(show(string.last_index_of("a/b/c", "/")))
  print(show(string.last_index_of("é/é/x", "/")))
  print(show(string.last_index_of("é/é/x", "é")))
  print(show(string.char_last_index_of("é/é/x", "/")))
  print(show(string.char_last_index_of("é/é/x", "é")))
  print(show(string.char_last_index_of("abc", "z")))
  print(show(string.last_index_of(string.repeat("dir/", 16) ++ "f.json", "/")))
}
