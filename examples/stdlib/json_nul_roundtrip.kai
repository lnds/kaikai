import encoding.json
import encoding.json_bind.{JsonValue, JStr}

fn roundtrip(text: String) : String = {
  match json_decode(json_encode(JStr(text))) {
    Some(JStr(s)) -> "#{length(s)} #{s == text}"
    _ -> "not decoded"
  }
}

fn main() : Unit / Stdout {
  Stdout.print(roundtrip("\u{0}ab"))
  Stdout.print(roundtrip("a\u{0}b"))
  Stdout.print(roundtrip("ab\u{0}"))
  Stdout.print(roundtrip("\u{0}"))
  Stdout.print(roundtrip("a\u{1}b\u{1f}c"))
  Stdout.print(match json_decode("\"a\\u0000b\"") {
    Some(JStr(s)) -> "#{length(s)} #{s == "a\u{0}b"}"
    _ -> "not decoded"
  })
}
