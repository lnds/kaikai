import net.http
import net.tcp
import spawn

const ROUNDS : Int = 1

const BODY_LEN : Int = 24576

fn body_loop(i: Int, n: Int, acc: [String]) : [String] =
  if i == n {
    list_reverse(acc)
  } else {
    body_loop(i + 1, n, [int_to_byte_string(i % 256), ...acc])
  }

fn make_body(n: Int) : String = string_concat_all(body_loop(0, n, []))

fn serve_once(l: Listener) : Int / NetTcp + Cancel =
  match NetTcp.accept(l) {
    Err(_) -> 1
    Ok(c) -> {
      let rc = match http.read_request(c, 1048576) {
        Err(_) -> 1
        Ok(req) -> {
          let resp = Response { status: 200, headers: [], body: req.body }
          let _ = NetTcp.send(c, http.string_to_bytes(http.serialize_response(resp)))
          0
        }
      }
      NetTcp.close(c)
      rc
    }
  }

fn round(l: Listener, body: String) : Bool / NetTcp + Cancel + Spawn =
  nursery { n ->
    let srv = n.spawn(() => serve_once(l))
    let r = http.post("http://127.0.0.1:#{l.port}/echo", body)
    let rc = n.await(srv)
    rc == 0 and r.status == 200 and r.body == body
  }

fn rounds(l: Listener, body: String, i: Int) : Int / NetTcp + Cancel + Spawn =
  if i == ROUNDS { 0 } else if round(l, body) { rounds(l, body, i + 1) } else { 1 }

fn main() : Int / NetTcp + Cancel + Spawn + Stdout =
  match NetTcp.listen("127.0.0.1", 0) {
    Err(e) -> {
      Stdout.print("listen FAIL: #{e}")
      1
    }
    Ok(l) -> {
      let body = make_body(BODY_LEN)
      let rc = rounds(l, body, 0)
      Stdout.print(if rc == 0 { "round-trip ok #{string_length(body)}" } else { "round-trip FAIL" })
      rc
    }
  }
