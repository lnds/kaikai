# A mixed `Real`/`Complex` operation is typed as what its impl returns:
# with the `Real` on the left the result is still a `Complex`, usable
# wherever one is expected.

import math.complex

fn show_c(label: String, z: complex.Complex) : Unit / Stdout =
  Stdout.print("#{label}: #{real_to_string(z.re)} #{real_to_string(z.im)}")

fn main() : Unit / Stdout = {
  let z = complex.mk(1.0, 2.0)
  show_c("2.0 + z", 2.0 + z)
  show_c("z + 2.0", z + 2.0)
  show_c("2.0 - z", 2.0 - z)
  show_c("z - 2.0", z - 2.0)
  show_c("2.0 * z", 2.0 * z)
  show_c("z * 2.0", z * 2.0)
  show_c("z / 2.0", z / 2.0)
  let w = 2.0 + z
  Stdout.print("re of a sum: #{real_to_string(w.re + 1.0)}")
}
