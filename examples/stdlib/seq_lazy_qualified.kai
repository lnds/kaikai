# The module bound to a qualifier serves the literal and its patterns,
# and leaves the bare names to the lists.

import seq as sq

fn sieve(xs: sq.Seq[Int]) : sq.Seq[Int] = match xs {
  []           -> lazy []
  [p, ...rest] -> lazy [p, ...sieve(rest |? (x) => x % p != 0)]
}

fn main() : Unit / Stdout = {
  let firsts = [5, 6, 7] |> take(2)
  Stdout.print(show(sq.to_list(sq.take(sieve(lazy [2..]), 5))))
  Stdout.print(show(firsts))
}
