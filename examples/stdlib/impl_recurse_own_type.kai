# An impl that recurses on its own type at an inner instantiation calls
# that instantiation's spec, not itself: `Option[Option[Int]]` reaches
# `Option[Int]` and then `Int`.

protocol Depth {
  depth(x: Self) : Int
}

impl Depth for Int {
  fn depth(x: Int) : Int = 0
}

type Box[T] = Box(T)

impl[T: Depth] Depth for Box[T] {
  fn depth(b: Box[T]) : Int = match b {
    Box(inner) -> 1 + depth(inner)
  }
}

impl[T: Depth] Depth for Option[T] {
  fn depth(o: Option[T]) : Int = match o {
    None -> 1
    Some(x) -> depth(x)
  }
}

fn main() : Int / Stdout {
  Stdout.print("box: #{depth(Box(Box(Box(7))))}")
  Stdout.print("option: #{depth(Some(Some(Box(3))))} #{depth(Box(Some(Box(3))))}")
  Stdout.print(
    "eq option: #{eq(Some(Some(1)), Some(Some(1)))} #{eq(Some(Some(1)), Some(Some(2)))} #{eq(Some(Some(1)), Some(None))}"
  )
  Stdout.print("eq result: #{eq(Ok(Ok(1)), Ok(Ok(1)))} #{eq(Ok(Err("a")), Ok(Err("b")))}")
  Stdout.print("hash option: #{hash(Some(Some(5))) == hash(Some(Some(5)))}")
  0
}
