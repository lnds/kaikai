# Queue and Stack keep their element count, so size is O(1) after every
# operation.

import collections.queue
import collections.stack

fn fill_queue(q: Queue[Int], i: Int, n: Int, seen: Int) : Int =
  if i >= n { seen } else { fill_queue(queue.push(q, i), i + 1, n, seen + queue.size(q)) }

fn fill_stack(s: Stack[Int], i: Int, n: Int, seen: Int) : Int =
  if i >= n { seen } else { fill_stack(stack.push(s, i), i + 1, n, seen + stack.size(s)) }

fn no_queue() : Queue[Int] = queue.empty()

fn no_stack() : Stack[Int] = stack.empty()

fn main() : Unit / Stdout = {
  let q = queue.from_list([1, 2, 3])
  Stdout.print("queue: #{queue.size(q)} #{queue.size(queue.push(q, 4))} #{queue.is_empty(q)} #{queue.is_empty(no_queue())}")
  match queue.pop(queue.push(q, 4)) {
    Some(p) -> Stdout.print("queue pop: #{p.fst} #{queue.size(p.snd)} #{queue.to_list(p.snd)}")
    None    -> Stdout.print("queue pop: none")
  }
  Stdout.print("queue pipes: #{queue.size(queue.map(q, (x) => x + 1))} #{queue.size(queue.filter(q, (x) => x > 1))} #{queue.size(queue.flat_map(q, (x) => queue.from_list([x, x])))}")
  let s = stack.from_list([1, 2, 3])
  Stdout.print("stack: #{stack.size(s)} #{stack.size(stack.push(s, 4))} #{stack.is_empty(s)} #{stack.is_empty(no_stack())}")
  match stack.pop(s) {
    Some(p) -> Stdout.print("stack pop: #{p.fst} #{stack.size(p.snd)} #{stack.to_list(p.snd)}")
    None    -> Stdout.print("stack pop: none")
  }
  Stdout.print("stack pipes: #{stack.size(stack.map(s, (x) => x + 1))} #{stack.size(stack.filter(s, (x) => x > 1))} #{stack.size(stack.flat_map(s, (x) => stack.from_list([x, x])))}")
  Stdout.print("queue size loop: #{fill_queue(no_queue(), 0, 40000, 0)}")
  Stdout.print("stack size loop: #{fill_stack(no_stack(), 0, 40000, 0)}")
}
