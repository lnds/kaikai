# A constant's initialiser calls a module's function through its
# qualifier, in the open and inside an interpolation alike.

import decimal

const PRICE : String = decimal.to_string(19.99d)
const LABEL : String = "price #{decimal.to_string(0.5d)}"

fn main() : Unit / Stdout = {
  Stdout.print(PRICE)
  Stdout.print(LABEL)
}
