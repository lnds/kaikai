# A derived `impl Eq` compares each member by that member's own impl,
# whether the holder is compared directly, inside a list or inside an
# `Option`: equal values built differently stay equal.

import collections.set
import decimal_big
import math.bigint

#[derive(Eq)]
type Bag = Bag(Set[Int]) | NoBag

#[derive(Eq)]
type Shelf = { items: Set[Int] }

#[derive(Eq)]
type Price = Price(DecimalBig) | Free

#[derive(Eq)]
type Quote = { amount: DecimalBig }

#[derive(Eq)]
type Serial = Serial(BigInt) | Unnumbered

#[derive(Eq)]
type Ticket = { number: BigInt }

fn dec(raw: Int, scale: Int) : DecimalBig = decimal_big.from_parts(bigint.from_int(raw), scale)
fn big(tail: String) : BigInt = bigint.from_literal("12345678901234567890123456789" ++ tail)

fn row(label: String, bare: Bool, bare_no: Bool, listed: Bool, listed_no: Bool, opt: Bool, opt_no: Bool) : Unit / Stdout =
  Stdout.print("#{label}: #{bare} #{bare_no} #{listed} #{listed_no} #{opt} #{opt_no}")

fn main() : Unit / Stdout = {
  let s1 = set.from([1, 2, 3])
  let s2 = set.from([3, 2, 1])
  let s3 = set.from([1, 2])
  row("sum over a set", Bag(s1) == Bag(s2), Bag(s1) == Bag(s3),
      [Bag(s1)] == [Bag(s2)], [Bag(s1)] == [Bag(s3)],
      Some(Bag(s1)) == Some(Bag(s2)), Some(Bag(s1)) == Some(Bag(s3)))
  row("record over a set", Shelf { items: s1 } == Shelf { items: s2 }, Shelf { items: s1 } == Shelf { items: s3 },
      [Shelf { items: s1 }] == [Shelf { items: s2 }], [Shelf { items: s1 }] == [Shelf { items: s3 }],
      Some(Shelf { items: s1 }) == Some(Shelf { items: s2 }), Some(Shelf { items: s1 }) == Some(Shelf { items: s3 }))
  row("sum over a decimal", Price(dec(15, 1)) == Price(dec(150, 2)), Price(dec(15, 1)) == Price(dec(16, 1)),
      [Price(dec(15, 1))] == [Price(dec(150, 2))], [Price(dec(15, 1))] == [Price(dec(16, 1))],
      Some(Price(dec(15, 1))) == Some(Price(dec(150, 2))), Some(Price(dec(15, 1))) == Some(Price(dec(16, 1))))
  row("record over a decimal", Quote { amount: dec(15, 1) } == Quote { amount: dec(150, 2) },
      Quote { amount: dec(15, 1) } == Quote { amount: dec(16, 1) },
      [Quote { amount: dec(15, 1) }] == [Quote { amount: dec(150, 2) }],
      [Quote { amount: dec(15, 1) }] == [Quote { amount: dec(16, 1) }],
      Some(Quote { amount: dec(15, 1) }) == Some(Quote { amount: dec(150, 2) }),
      Some(Quote { amount: dec(15, 1) }) == Some(Quote { amount: dec(16, 1) }))
  row("sum over a big integer", Serial(big("0")) == Serial(big("0")), Serial(big("0")) == Serial(big("1")),
      [Serial(big("0"))] == [Serial(big("0"))], [Serial(big("0"))] == [Serial(big("1"))],
      Some(Serial(big("0"))) == Some(Serial(big("0"))), Some(Serial(big("0"))) == Some(Serial(big("1"))))
  row("record over a big integer", Ticket { number: big("0") } == Ticket { number: big("0") },
      Ticket { number: big("0") } == Ticket { number: big("1") },
      [Ticket { number: big("0") }] == [Ticket { number: big("0") }],
      [Ticket { number: big("0") }] == [Ticket { number: big("1") }],
      Some(Ticket { number: big("0") }) == Some(Ticket { number: big("0") }),
      Some(Ticket { number: big("0") }) == Some(Ticket { number: big("1") }))
}
