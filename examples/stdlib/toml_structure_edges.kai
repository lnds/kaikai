# Decode and encode edge cases: header nesting, repeats, arrays of
# tables, inline tables, strings and arrays.

import encoding.toml

fn diagnose(src: String) : String = match toml.decode_report(src) {
  Ok(v)  -> string_concat("ok: ", toml.encode(v))
  Err(e) -> toml.error_message(e)
}

fn show(label: String, src: String) : Unit / Stdout =
  Stdout.print("#{label}: #{diagnose(src)}")

fn main() : Unit / Stdout = {
  show("nested_headers", "[a.b]\nx = 1\n[a.c]\ny = 2\n[a]\nz = 3\n")
  show("parent_after_child", "[a.b.c]\nx = 1\n[a.b]\ny = 2\n[a]\nz = 3\n")
  show("repeat_table", "[a]\nx = 1\n[a]\ny = 2\n")
  show("repeat_key", "[a]\nx = 1\nx = 2\n")
  show("root_repeat_key", "x = 1\ny = 2\nx = 3\n")
  show("key_then_table", "a = 1\n[a]\nx = 1\n")
  show("table_then_key", "[a]\nx = 1\n[b]\n[a.x]\ny = 1\n")
  show("aot_basic", "[[p]]\nn = 1\n[[p]]\nn = 2\n[[p]]\nn = 3\n")
  show("aot_enter_last", "[[p]]\nn = 1\n[p.q]\nr = 1\n[[p]]\nn = 2\n[p.q]\nr = 2\n")
  show("aot_nested", "[[p]]\nn = 1\n[[p.s]]\nm = 1\n[[p.s]]\nm = 2\n[[p]]\nn = 2\n[[p.s]]\nm = 3\n")
  show("aot_defined_reset", "[[p]]\n[p.q]\n[[p]]\n[p.q]\n[p.q]\n")
  show("aot_over_table", "[p]\nx = 1\n[[p]]\n")
  show("aot_over_key", "p = 1\n[[p]]\n")
  show("table_over_aot", "[[p]]\nn = 1\n[p]\nx = 1\n")
  show("aot_after_literal", "p = [{ a = 1 }]\n[[p]]\nb = 2\n")
  show("aot_after_empty", "p = []\n[[p]]\nb = 2\n")
  show("aot_after_scalars", "p = [1, 2]\n[[p]]\nb = 2\n")
  show("enter_literal_array", "p = [{ a = 1 }, { a = 2 }]\n[p.q]\nb = 2\n")
  show("enter_mixed_array", "p = [1, { a = 1 }]\n[p.q]\nb = 2\n")
  show("enter_scalar_array", "p = [1, 2]\n[p.q]\nb = 2\n")
  show("enter_empty_array", "p = []\n[p.q]\nb = 2\n")
  show("extend_inline", "t = { a = 1 }\n[t]\nb = 2\n")
  show("extend_inline_repeat", "t = { a = 1 }\n[t]\n[t]\n")
  show("inline_dup_key", "t = { a = 1, a = 2 }\n")
  show("extend_inline_dup_key", "t = { a = 1, a = 2 }\n[t]\nb = 1\n")
  show("enter_literal_dup_key", "p = [{ a = 1, a = 2 }]\n[p.q]\nb = 1\n")
  show("inline_pairs", "t = { a = 1, b = \"x\", c = true, d = 1.5 }\n")
  show("quoted_segments", "[a.\"b.c\"]\nx = 1\n[a.\"b.c\".d]\ny = 2\n")
  show("strings", "s = \"a\\\"b\\\\c\\nd\\te\\rf\"\nt = \"plain\"\nu = \"\"\n")
  show("bad_escape", "s = \"a\\qb\"\n")
  show("unterminated", "s = \"abc\n")
  show("arrays", "a = [1, 2, 3]\nb = [\"x\", \"y\",]\nc = [\n  1, # one\n  2,\n]\nd = [[1, 2], [3]]\ne = []\n")
  show("array_mixed", "a = [1, \"x\", true, 1.5, { k = 1 }]\n")
  show("array_unclosed", "a = [1, 2\n")
  show("key_order", "z = 1\n[b]\ny = 1\nx = 2\n[a]\nq = 1\n")
  show("empty", "")
  show("comments", "# c\nx = 1 # tail\n\n# d\n[a] # h\ny = 2\n")
}
