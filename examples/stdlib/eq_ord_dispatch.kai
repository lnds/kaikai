# == and the orderings on Int, Real, lists, options and a generic caller.

fn same[T : Eq](a: T, b: T) : Bool = a == b

fn lower[T : Ord](a: T, b: T) : Bool = a < b

fn main() : Unit / Stdout = {
  Stdout.print("int: #{1 == 1} #{1 != 2} #{1 < 2} #{2 <= 2} #{3 > 2} #{2 >= 3}")
  Stdout.print("real: #{1.5 == 1.5} #{1.5 < 2.5} #{2.5 >= 2.5}")
  Stdout.print("list: #{[1, 2] == [1, 2]} #{[1, 2] == [1, 3]} #{[Some(1)] == [Some(1)]}")
  Stdout.print("generic: #{same(3, 3)} #{same("a", "b")} #{same([1], [1])} #{lower(1, 2)} #{lower(2.5, 1.5)} #{lower("a", "b")}")
}
