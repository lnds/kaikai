# `toml.decode_report` names the line and key the parse stopped on,
# instead of rejecting the file without saying where.

import encoding.toml

fn diagnose(src: String) : String = match toml.decode_report(src) {
  Ok(v)  -> string_concat("ok: ", toml.encode(v))
  Err(e) -> toml.error_message(e)
}

fn show(label: String, src: String) : Unit / Stdout =
  Stdout.print("#{label}: #{diagnose(src)}")

fn main() : Unit / Stdout = {
  show("floats_ok", """[run]
workers = 8

[score]
threshold = 0.8
""")

  show("bad_value", """[run]
workers = 8

[score]
threshold = 1970-01-01
""")

  show("bad_separator", """[run]
budget = 1_000
""")

  show("bad_header", """[run
workers = 8
""")

  show("stray_line", """[run]
workers = 8
??? = 1
""")
}
