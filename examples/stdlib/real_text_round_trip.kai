# A Real's text reads back as the same number: `real_to_string`, an
# interpolation, `Serialize`, and JSON. Six digits stay six when they
# already name the number.

import encoding.json.{as_real, json_decode, json_encode}
import encoding.json_bind

fn same(x: Real, got: Option[Real]) : Bool = match got {
  Some(y) -> real_bits(x) == real_bits(y)
  None    -> false
}

fn by_serialize(x: Real) : Option[Real] = {
  let back : Result[Real, String] = from_string(to_string(x))
  match back {
    Ok(y)  -> Some(y)
    Err(_) -> None
  }
}

fn by_json(x: Real) : Option[Real] = match json_decode(json_encode(JReal(x))) {
  Some(v) -> as_real(v)
  None    -> None
}

fn row(label: String, x: Real) : Unit / Stdout =
  Stdout.print("#{label}: #{x} text=#{same(x, string_to_real(real_to_string(x)))} serialize=#{same(x, by_serialize(x))} json=#{same(x, by_json(x))}")

# No JSON column: `-0` decodes as an integer, and JSON has no infinity.
fn bare(label: String, x: Real) : Unit / Stdout =
  Stdout.print("#{label}: #{x} text=#{same(x, string_to_real(real_to_string(x)))} serialize=#{same(x, by_serialize(x))}")

fn named(label: String, text: String) : Unit / Stdout = match string_to_real(text) {
  Some(x) -> bare(label, x)
  None    -> Stdout.print("#{label}: unreadable")
}

fn main() : Unit / Stdout = {
  row("tenth", 0.1)
  row("sum", 0.1 + 0.2)
  row("third", 1.0 / 3.0)
  row("pi", 3.141592653589793)
  row("negative", -2.718281828459045)
  row("seven digits", 1234567.0)
  row("nine and a fraction", 123456789.125)
  row("past 2^53", 9007199254740993.0)
  row("max finite", 1.7976931348623157e308)
  row("min normal", 2.2250738585072014e-308)
  row("min subnormal", 4.9e-324)
  row("short decimal", 1.5)
  row("short integer", 100000.0)
  row("short exponent", 1.0e22)
  row("zero", 0.0)
  bare("negative zero", -0.0)
  named("infinity", "inf")
  named("negative infinity", "-inf")
  named("nan", "nan")
}
