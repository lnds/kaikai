# The unbounded sieve: every prime found adds a filter stage to the
# sequence behind it, and only the cells a consumer reads are built.

import seq

fn sieve(xs: Seq[Int]) : Seq[Int] = match xs {
  []           -> lazy []
  [p, ...rest] -> lazy [p, ...sieve(rest |? (x) => x % p != 0)]
}

fn main() : Unit / Stdout = {
  let primes = sieve(lazy [2..])
  primes |> take_while((p) => p <= 97) |> each((p) => Stdout.print("#{p}"))
  Stdout.print(int_to_string(primes |> nth(999)))
}
