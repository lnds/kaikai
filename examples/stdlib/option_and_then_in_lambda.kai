# A method call is chosen by its receiver's type. Inside a lambda that
# leaves its parameter untyped, the parameter takes the type the callee
# expects before the body is walked, so `.and_then` on an `Option` there
# is `option.and_then`, never the `result` one.

fn cut(o: Option[String]) : Option[String] = o.and_then(
  text => index_of(text, "(").and_then(at => {
    let name = trim(slice(text, 0, at))
    if is_empty(name) { None } else { Some(name) }
  })
)

# The same body under an annotated parameter.
fn before(text: String) : Option[String] = index_of(text, "(").and_then(at => {
  let name = trim(slice(text, 0, at))
  if is_empty(name) { None } else { Some(name) }
})

# The receiver is the parameter itself.
fn bump(oo: Option[Option[Int]]) : Option[Int] = oo.and_then(o => o.and_then(n => Some(n + 1)))

fn main() : Unit / Console {
  println("#{cut(Some("f(x)"))} #{cut(Some("(x)"))} #{cut(None)}")
  println("#{before("f(x)")} #{before("fx")}")
  println("#{bump(Some(Some(1)))} #{bump(Some(None))}")
}
