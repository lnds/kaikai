import encoding.json.{json_decode, json_encode}
import encoding.json_bind

fn decoded_length(text: String) : Int =
  match json_decode(text) {
    Some(JStr(s)) -> string_length(s)
    _             -> -1
  }

fn main() : Unit / Stdout = {
  let plain = repeat("a", 2000000)
  Stdout.print("plain: " ++ int_to_string(decoded_length("\"" ++ plain ++ "\"")))
  let escaped = repeat("a\\n\\t", 500000)
  Stdout.print("escaped: " ++ int_to_string(decoded_length("\"" ++ escaped ++ "\"")))
  let unicode = repeat("\\u00e9\\ud83d\\ude00", 200000)
  Stdout.print("unicode: " ++ int_to_string(decoded_length("\"" ++ unicode ++ "\"")))
  let round = json_encode(JStr(repeat("a\n", 500000)))
  Stdout.print("encoded: " ++ int_to_string(string_length(round)))
  Stdout.print("round trip: " ++ int_to_string(decoded_length(round)))
}
