# TOML floats: the forms `toml.decode` accepts, and the round-trip
# back through `toml.encode`.

import encoding.toml

fn render(src: String) : String = match toml.decode(src) {
  Some(v) -> toml.encode(v)
  None    -> "None"
}

fn show(label: String, src: String) : Unit / Stdout =
  Stdout.print("#{label}: #{render(src)}")

fn main() : Unit / Stdout = {
  show("frac", "threshold = 0.8\n")
  show("negative", "delta = -0.01\n")
  show("plus", "gain = +2.5\n")
  show("integral", "ratio = 1.0\n")
  show("exp", "big = 1e6\n")
  show("exp_plus", "huge = 5e+22\n")
  show("exp_neg", "planck = 6.626e-34\n")
  show("frac_exp", "mixed = -2.5E2\n")
  show("in_array", "ws = [0.5, 1.5, 2]\n")
  show("inline", "score = { threshold = 0.8, hard = false }\n")

  # A float next to the other value kinds, across two tables.
  show("mixed_doc", """[run]
workers = 8
spells = ["arm", "compare"]

[score]
threshold = 0.80
ratchet = true
""")

  # Not in the subset: a bare `.`, a bare exponent, digit separators,
  # `inf` / `nan`.
  show("no_int_part", "x = .5\n")
  show("no_frac_part", "x = 1.\n")
  show("no_exp_digits", "x = 1e\n")
  show("separator", "x = 1_000.5\n")
  show("inf", "x = inf\n")
  show("nan", "x = nan\n")
}
