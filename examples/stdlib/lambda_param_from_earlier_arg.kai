# A call settles its earlier arguments before a later lambda argument is
# walked, so the lambda's parameters are typed by what was passed ahead
# of it, and a method on one of them is chosen by that type.

fn bump(oo: Option[Option[Int]]) : Option[Int] = option.and_then(oo, o => o.and_then(n => Some(n + 1)))

fn bump_section(oo: Option[Option[Int]]) : Option[Int] = option.and_then(oo, .and_then(n => Some(n + 1)))

fn chain[a, b](o: Option[a], f: (a) -> Option[b]) : Option[b] = option.and_then(o, f)

fn bump_own(oo: Option[Option[Int]]) : Option[Int] = chain(oo, o => o.and_then(n => Some(n + 1)))

# The accumulator is typed by the initial value, an argument in the middle.
fn total(xs: [Int]) : Option[Int] = xs.reduce(Some(0), (acc, x) => acc.and_then(n => Some(n + x)))

fn total_call(xs: [Int]) : Option[Int] = reduce(xs, Some(0), (acc, x) => acc.and_then(n => Some(n + x)))

fn total_piped(xs: [Int]) : Option[Int] = xs |> reduce(Some(0), (acc, x) => acc.and_then(n => Some(n + x)))

fn main() : Unit / Console {
  println("#{bump(Some(Some(1)))} #{bump(Some(None))} #{bump_section(Some(Some(2)))} #{bump_own(Some(Some(3)))}")
  println("#{total([1, 2, 3])} #{total_call([4, 5])} #{total_piped([])}")
}
