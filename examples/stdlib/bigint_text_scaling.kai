# Parsing, rendering and multiplying large BigInts above the sizes where
# the divide-and-conquer paths take over from the schoolbook loops.

import math.bigint

fn main() : Unit / Stdout = {
  let digits = string.repeat("1234567890", 7000)
  match bigint.from_string(digits) {
    None    -> Stdout.print("parse failed")
    Some(x) -> {
      let text = bigint.to_string(x)
      Stdout.print("digits: #{string_length(text)} #{text == digits}")
      let sq = bigint.mul(x, x)
      let one = bigint.one()
      let lhs = bigint.mul(bigint.add(x, one), bigint.add(x, one))
      let rhs = bigint.add(bigint.add(sq, bigint.add(x, x)), one)
      Stdout.print("square: #{bigint.compare(lhs, rhs) == 0}")
      match bigint.divmod(sq, x) {
        None    -> Stdout.print("divmod failed")
        Some(p) -> Stdout.print("quotient: #{bigint.compare(p.fst, x) == 0} #{bigint.is_zero(p.snd)}")
      }
    }
  }
  let lit = bigint.from_literal(string.repeat("9_876_543_21", 4000))
  Stdout.print("literal: #{string_length(bigint.to_string(lit))}")
}
