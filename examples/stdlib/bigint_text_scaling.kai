# Parsing and rendering large BigInts: quadratic in the digit count by
# construction, but with small per-limb work.

import math.bigint

fn main() : Unit / Stdout = {
  let digits = string.repeat("1234567890", 3000)
  match bigint.from_string(digits) {
    None    -> Stdout.print("parse failed")
    Some(x) -> {
      let text = bigint.to_string(x)
      Stdout.print("digits: #{string_length(text)} #{text == digits}")
    }
  }
  let lit = bigint.from_literal(string.repeat("9_876_543_21", 2500))
  Stdout.print("literal: #{string_length(bigint.to_string(lit))}")
}
