fn show(xs: [String]) : String =
  "#{list.length(xs)}:" ++ string.join(list.map(xs, x => "[#{x}]"), "")

fn main() : Int / Stdout {
  Stdout.print(show(string.lines("")))
  Stdout.print(show(string.lines("\n")))
  Stdout.print(show(string.lines("\n\n")))
  Stdout.print(show(string.lines("abc")))
  Stdout.print(show(string.lines("abc\n")))
  Stdout.print(show(string.lines("a\n\nb\n\n")))
  Stdout.print(show(string.lines("a\r\nb\r\n")))
  Stdout.print(show(string.lines("héé\nñ日本\n")))
  Stdout.print(show(string.split("", "\n")))
  Stdout.print(show(string.split("abc", "\n")))
  Stdout.print(show(string.split("a\n", "\n")))
  Stdout.print(show(string.split("é\nü", "\n")))
  Stdout.print(
    "#{string.is_blank("")} #{string.is_blank(" \t\r\n")} #{string.is_blank(" x ")} #{string.is_blank("é")} #{string.is_blank(" \u{a0}")}"
  )
  Stdout.print(
    "[#{string.trim("")}][#{string.trim(" \t\r\nab c\n ")}][#{string.trim("   ")}][#{string.trim("  é日 ")}]"
  )
  Stdout.print(
    "[#{string.trim_left(" \n x ")}][#{string.trim_right(" x \r\n")}][#{string.trim_right("é")}]"
  )
  0
}
