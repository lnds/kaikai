# Searching, replacing, splitting and compiling large inputs stays linear.

import regexp

fn compiled(pat: String) : regexp.Regex = regexp.compile_or_panic(pat)

fn count(re: regexp.Regex, s: String) : Int = list_length(regexp.find_all(re, s))

fn hit(m: Option[regexp.Match]) : Int = match m {
  Some(_) -> 1
  None    -> 0
}

fn words(n: Int, i: Int, acc: [String]) : [String] =
  if i >= n { acc } else { words(n, i + 1, ["w", ...acc]) }

fn main() : Unit / Stdout = {
  let text = string.repeat("xaab", 60000)
  Stdout.print("find_all: " ++ int_to_string(count(compiled("a+b"), text)))
  Stdout.print("replace: " ++ int_to_string(string_length(regexp.replace(compiled("a+b"), text, "Z"))))
  Stdout.print("replace group: " ++ int_to_string(string_length(regexp.replace(compiled("(a+)b"), text, "<$1>"))))
  Stdout.print("split: " ++ int_to_string(list_length(regexp.split(compiled("b"), text))))
  Stdout.print("no match: " ++ int_to_string(hit(regexp.find(compiled("a+c"), string.repeat("a", 30000)))))
  Stdout.print("no match star: " ++ int_to_string(hit(regexp.find(compiled("(a|b)*c"), string.repeat("ab", 5000)))))
  Stdout.print("match at end: " ++ int_to_string(hit(regexp.find(compiled("(a|b)*c"), string.repeat("ab", 100000) ++ "c"))))
  Stdout.print("compile literal: " ++ int_to_string(hit(regexp.find(compiled(string.repeat("a", 20000)), "x"))))
  Stdout.print("compile alternation: " ++ int_to_string(hit(regexp.find(compiled(string.join(words(8000, 0, []), "|")), "w"))))
  Stdout.print("compile class: " ++ int_to_string(hit(regexp.find(compiled("[" ++ string.repeat("ab", 8000) ++ "]"), "b"))))
  Stdout.print("many branches: " ++ int_to_string(hit(regexp.find(compiled("(" ++ string.join(words(1500, 0, []), "|") ++ ")+y"), string.repeat("w", 50) ++ "y"))))
}
