# The habitant guard on operator dispatch must stay exact: the matching
# unit still resolves, for a `Module` atom and for a `Measure` unit, and
# through every arithmetic operator that reaches an impl.

kind Span : Module over T with sp
sp day
sp month

unit metre

type Box = { v: Int }
type Rod = { len: Real }

impl Add[Int<day>] for Box {
  fn add(self: Box, rhs: Int<day>) : Box = Box { v: self.v + __detach_unit(rhs) }
}

impl Sub[Int<day>] for Box {
  fn sub(self: Box, rhs: Int<day>) : Box = Box { v: self.v - __detach_unit(rhs) }
}

impl Add[Real<metre>] for Rod {
  fn add(self: Rod, rhs: Real<metre>) : Rod = Rod { len: self.len + __detach_unit(rhs) }
}

pub fn main() : Unit / Console = {
  let b = Box { v: 10 }
  let d : Int<day> = 2<day>
  let grown = b + d
  let shrunk = grown - d
  let rod = Rod { len: 1.5 }
  let longer = rod + 0.5<metre>
  print("#{grown.v} #{shrunk.v} #{longer.len}")
}
