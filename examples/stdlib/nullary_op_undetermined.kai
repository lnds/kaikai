# The right operand of `add` is the protocol's own parameter, so it
# fixes no type for a `zero()` written there, and neither does a `let`
# with no annotation: each is rejected rather than left to fail at run
# time.

fn as_argument[T : Numeric + Add](x: T) : T = add(x, zero())

fn through_let(x: Int) : Int = {
  let z = zero()
  add(x, z)
}

fn main() : Unit / Stdout = Stdout.print("#{as_argument(21)} #{through_let(21)}")
