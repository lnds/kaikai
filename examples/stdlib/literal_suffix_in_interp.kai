# A suffixed literal inside an interpolation reads like one outside it.

import math.bigint
import decimal
import seq

const PRICE : String = "#{decimal.to_string(19.99d)}"

fn main() : Unit / Stdout = {
  Stdout.print("#{128n} #{-128n}")
  Stdout.print("#{decimal.to_string(-0.25d)} #{PRICE}")
  Stdout.print("#{to_list(lazy [1, 2])}")
  Stdout.print("a#{"b#{99n}"}")
}
