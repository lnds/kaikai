# Decimal text of BigInt: parsing and rendering at the nine-digit chunk
# boundaries, signs, separators and malformed input.

import math.bigint

fn parse(s: String) : String = match bigint.from_string(s) {
  Some(x) -> bigint.to_string(x)
  None    -> "none"
}

fn literal(s: String) : String = bigint.to_string(bigint.from_literal(s))

fn main() : Unit / Stdout = {
  list.foreach(["0", "-0", "+0", "7", "-7", "+7", "000", "000123", "123456789", "1234567890", "-123456789012345678",
      "999999999", "1000000000", "999999999999999999", "1000000000000000000", "9223372036854775807",
      "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551616",
      "123456789012345678901234567890123456789", "100000000000000000000000000000000000000",
      "", "-", "+", "12a", "a12", "1 2", "12_3", "1234567890x", "--1", "+-1"],
    (s) => Stdout.print("parse [#{s}] = #{parse(s)}"))
  list.foreach(["0", "123", "1_000", "1_000_000_000_000", "12345678901234567890", "1__2", "_1", "1_", "12x34", "x", "",
      "00000000000000000001", "123456789_123456789_123456789"],
    (s) => Stdout.print("literal [#{s}] = #{literal(s)}"))
  let big = bigint.from_literal("123456789012345678901234567890")
  Stdout.print("neg: #{bigint.to_string(bigint.neg(big))}")
  Stdout.print("mul: #{bigint.to_string(bigint.mul(big, big))}")
  Stdout.print("sub: #{bigint.to_string(bigint.sub(big, bigint.from_literal("123456789012345678901234567891")))}")
  Stdout.print("round trip: #{parse(bigint.to_string(bigint.mul(big, bigint.mul(big, big))))}")
}
