# show of lists, maps and sets, and the O(1) size of maps and sets.

import collections.map
import collections.set

fn no_map() : Map[Int, Int] = map.empty()

fn no_set() : Set[Int] = set.empty()

fn main() : Unit / Stdout = {
  Stdout.print(show([1, 2, 3]))
  Stdout.print(show(["a", "b"]))
  Stdout.print(show([[1], [], [2, 3]]))
  Stdout.print(show([Some(1), None]))
  Stdout.print(show(map.from([Pair { fst: 2, snd: "b" }, Pair { fst: 1, snd: "a" }])))
  Stdout.print(show(no_map()))
  Stdout.print(show(set.from([3, 1, 2, 3])))
  Stdout.print(show(set.from(["", "a", "b"])))
  Stdout.print(show(no_set()))
  let m = map.from([Pair { fst: 1, snd: 1 }, Pair { fst: 2, snd: 2 }, Pair { fst: 3, snd: 3 }])
  Stdout.print("size: #{map.size(m)} #{map.size(map.put(m, 2, 9))} #{map.size(map.put(m, 4, 4))} #{map.size(map.remove(m, 1))} #{map.size(map.remove(m, 9))} #{map.size(no_map())}")
  let s = set.from([1, 2, 3])
  Stdout.print("set size: #{set.size(s)} #{set.size(set.insert(s, 2))} #{set.size(set.insert(s, 7))} #{set.size(set.remove(s, 1))} #{set.size(set.union(s, set.from([3, 4])))}")
}
