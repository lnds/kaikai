import spawn
import uuid

fn distinct3(a: String, b: String, c: String) : Bool = a != b and b != c and a != c

fn distinct3_int(a: Int, b: Int, c: Int) : Bool = a != b and b != c and a != c

fn main() : Unit / Spawn + Random + SecureRandom + Stdout = {
  let m = uuid.v4()
  let rm = Random.int_range(0, 1000000000000)
  nursery { n ->
    let a = n.spawn(() => uuid.v4())
    let b = n.spawn(() => uuid.v4())
    let ra = n.spawn(() => Random.int_range(0, 1000000000000))
    let rb = n.spawn(() => Random.int_range(0, 1000000000000))
    println("uuids distinct: #{distinct3(m, n.await(a), n.await(b))}")
    println("random draws distinct: #{distinct3_int(rm, n.await(ra), n.await(rb))}")
  }
}
