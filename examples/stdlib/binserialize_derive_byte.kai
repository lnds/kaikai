# `#[derive(BinSerialize)]` for a `Byte` field, which encodes as one raw
# byte, alone and inside lists and options.

#[derive(BinSerialize)]
type Frame = { flag: Byte, raw: [Byte], opt: Option[Byte], names: [String] }

fn byte(n: Int) : Byte = match int_to_byte(n) {
  Ok(b)  -> b
  Err(_) -> panic("byte out of range")
}

fn show_byte(b: Byte) : String = int_to_string(byte_to_int(b))

fn main() : Int {
  let f = Frame { flag: byte(200), raw: [byte(1), byte(255)], opt: Some(byte(5)), names: ["a", "bc"] }
  let bs = to_bytes(f)
  print(int_to_string(array_length(bs)))
  match frame_from_bytes(bs, 0) {
    Err(m) -> print(m)
    Ok(c) -> {
      print(show_byte(c.value.flag))
      print(int_to_string(list_length(c.value.raw)))
      match c.value.raw {
        [_, b, ..._] -> print(show_byte(b))
        _ -> print("short")
      }
      print(int_to_string(c.pos))
    }
  }
  0
}
