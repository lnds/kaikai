# Recursive `[T]` and `Option[T]` fields encode at 100000 levels and
# round-trip at 3000, inside a fiber whose own stack holds about a hundred:
# the derived code continues over fresh stack segments. Decode stops at 3000
# because the JSON path string it threads grows with depth.

import spawn
import encoding.json.{json_decode, json_encode}
import encoding.json_bind

#[derive(Json)]
type Tree = { kids: [Tree] }

#[derive(Json)]
type Chain = { v: Int, next: Option[Chain] }

fn link(n: Int, acc: Chain) : Chain =
  if n == 0 { acc } else { link(n - 1, Chain { v: n, next: Some(acc) }) }

fn chain_len(c: Chain, acc: Int) : Int = match c.next {
  None    -> acc
  Some(m) -> chain_len(m, acc + 1)
}

fn run_chain(n: Int) : String = {
  let s = json_encode(to_json(link(n, Chain { v: 0, next: None })))
  match json_decode(s) {
    None    -> "bad json"
    Some(j) -> match chain_of_json(j, "") {
      Ok(c)  -> "bytes=#{string_length(s)} len=#{chain_len(c, 0)}"
      Err(e) -> json_error_show(e)
    }
  }
}

fn build(n: Int, acc: Tree) : Tree =
  if n == 0 { acc } else { build(n - 1, Tree { kids: [acc] }) }

fn depth(t: Tree, acc: Int) : Int = match t.kids {
  []       -> acc
  [k, ...] -> depth(k, acc + 1)
}

fn encode_only(n: Int) : String =
  "bytes=#{string_length(json_encode(to_json(build(n, Tree { kids: [] }))))}"

fn run(n: Int) : String / Console = {
  let s = json_encode(to_json(build(n, Tree { kids: [] })))
  match json_decode(s) {
    None    -> "bad json"
    Some(j) -> match tree_of_json(j, "") {
      Ok(t)  -> "bytes=#{string_length(s)} depth=#{depth(t, 0)}"
      Err(e) -> json_error_show(e)
    }
  }
}

fn main() : Unit / Spawn + Console = {
  let e = spawn.spawn(() => encode_only(100000))
  print("fiber: #{spawn.await(e)}")
  let f = spawn.spawn(() => run(3000))
  print("fiber: #{spawn.await(f)}")
  let g = spawn.spawn(() => run_chain(3000))
  print("fiber: #{spawn.await(g)}")
}
