# `to_bytes` / `from_bytes` are operations of both BinSerialize and Layout,
# which share one dispatcher. Calling them on primitives must keep the
# BinSerialize impls a pruned build would otherwise drop.

fn main() : Unit / Stdout = {
  let bs = to_bytes(5)
  let sb = to_bytes("ab")
  let back : Result[BinCursor[Int], String] = from_bytes(bs, 0)
  let n = match back {
    Ok(c) -> c.value
    Err(_) -> -1
  }
  Stdout.print("#{array_length(bs)} #{array_length(sb)} #{n}")
}
