sqlite: sources = ["c/sqlite_shim.c"]

db.pg: libs = ["pq"]

db: absent
implicit_then_defined: ok: [a]
b = { x = 1 }
y = 2


array_sub_tables: ok: [[fruit]]
name = "apple"
physical = { color = "red" }

[[fruit]]
name = "banana"
physical = { color = "yellow" }


table_twice: line 4: malformed, repeated or conflicting table header
dotted_twice: line 4: malformed, repeated or conflicting table header
key_twice: line 3: key x: unsupported or malformed value, or a repeated key
header_over_value: line 4: malformed, repeated or conflicting table header
table_then_array: line 4: malformed, repeated or conflicting table header
empty_segment: line 1: malformed, repeated or conflicting table header
