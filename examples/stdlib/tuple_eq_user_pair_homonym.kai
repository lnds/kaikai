# A user type named `Pair` derives its own `Eq` beside the tuple's impl;
# each `==` dispatches to its own type.

#[derive(Eq, Show)]
type Pair = P(Int, Int)

fn main() : Int / Stdout {
  Stdout.print("user: #{P(1, 2) == P(1, 2)} #{P(1, 2) == P(1, 3)}")
  Stdout.print("tuple: #{(1, "a") == (1, "a")} #{(1, "a") == (2, "a")}")
  0
}
