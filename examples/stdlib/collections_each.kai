# `each` on every strict collection: it visits the elements in the order
# `map` does, and the effects of `f` flow out to the caller's handler.

import gen.{Yield, generate}
import collections.vec
import collections.map
import collections.set
import collections.hashmap
import collections.hashset
import collections.stack
import collections.queue

effect Visit {
  see(s: String) : Unit
}

fn trace[e](body: () -> Unit / Visit + e) : String / e =
  handle { body(); "" } with Visit {
    see(s, resume) -> {
      let rest = resume(())
      if rest == "" { s } else { s ++ " " ++ rest }
    }
  }

fn see_int(x: Int) : Unit / Visit = Visit.see(int_to_string(x))

fn see_pair(p: Pair[Int, String]) : Unit / Visit = Visit.see("#{p.fst}=#{p.snd}")

fn report(name: String, each_order: String, map_order: String) : Unit / Stdout =
  Stdout.print("#{name}: #{each_order} | same as map: #{each_order == map_order}")

fn report_unordered(name: String, each_order: String, map_order: String) : Unit / Stdout =
  Stdout.print("#{name}: #{string.split(each_order, " ") |> list.length()} visits | same as map: #{each_order == map_order}")

fn naturals(from: Int, to: Int) : Unit / Yield[Int] =
  if from >= to { () } else { Yield.yield(from); naturals(from + 1, to) }

fn main() : Unit / Stdout + Mutable = {
  report("gen",
    trace(() => gen.each(generate { naturals(1, 4) }, see_int)),
    trace(() => gen.each(gen.map(generate { naturals(1, 4) }, (x) => { see_int(x); x }), (_x) => ())))

  let v = vec.from_list([10, 20, 30])
  report("vec",
    trace(() => vec.each(v, see_int)),
    trace(() => { let _out = vec.map(v, (x) => { see_int(x); x }); () }))

  let m = map.from([Pair { fst: 3, snd: "c" }, Pair { fst: 1, snd: "a" }, Pair { fst: 2, snd: "b" }])
  report("map",
    trace(() => map.each(m, see_pair)),
    trace(() => { let _out = map.map(m, (p) => { see_pair(p); p }); () }))

  let s = set.from([3, 1, 2, 1])
  report("set",
    trace(() => set.each(s, see_int)),
    trace(() => { let _out = set.map(s, (x) => { see_int(x); x }); () }))

  let hm = hashmap.from([Pair { fst: 7, snd: "x" }, Pair { fst: 21, snd: "y" }, Pair { fst: 4, snd: "z" }])
  report_unordered("hashmap",
    trace(() => hashmap.each(hm, see_pair)),
    trace(() => { let _out = hashmap.map(hm, (p) => { see_pair(p); p }); () }))

  let hs = hashset.from([5, 17, 33, 2])
  report_unordered("hashset",
    trace(() => hashset.each(hs, see_int)),
    trace(() => { let _out = hashset.map(hs, (x) => { see_int(x); x }); () }))

  let st = stack.push(stack.push(stack.push(stack.empty(), 1), 2), 3)
  report("stack",
    trace(() => stack.each(st, see_int)),
    trace(() => { let _out = stack.map(st, (x) => { see_int(x); x }); () }))

  let q = queue.push(queue.push(queue.from_list([1, 2]), 3), 4)
  report("queue",
    trace(() => queue.each(q, see_int)),
    trace(() => { let _out = queue.map(q, (x) => { see_int(x); x }); () }))
}
