# The list patterns `[]` and `[first, ...rest]` read one cell of a `Seq`.

import seq

fn first_or(s: Seq[Int], d: Int) : Int = match s {
  [x, ..._] -> x
  _         -> d
}

fn describe(s: Seq[Int]) : String = match s {
  []                  -> "empty"
  [x, ..._] if x > 10 -> "starts big, at #{x}"
  other               -> "starts small, #{list_length(to_list(take(other, 3)))} read"
}

fn sum_first(s: Seq[Int], n: Int, acc: Int) : Int =
  if n == 0 { acc } else { match s {
    []           -> acc
    [x, ...rest] -> sum_first(rest, n - 1, acc + x)
  } }

fn pairs(s: Seq[Int]) : Seq[Int] = match s {
  []           -> lazy []
  [x, ...rest] -> match rest {
    []         -> lazy [x]
    [y, ...ys] -> lazy [x + y, ...pairs(ys)]
  }
}

fn main() : Unit / Stdout = {
  Stdout.print("#{first_or(lazy [7, 8], 0)} #{first_or(lazy [], 5)}")
  Stdout.print(describe(lazy []))
  Stdout.print(describe(lazy [11]))
  Stdout.print(describe(lazy [1, 2]))
  Stdout.print(int_to_string(sum_first(lazy [1..], 100, 0)))
  Stdout.print(show(to_list(pairs(lazy [1..7]))))
}
