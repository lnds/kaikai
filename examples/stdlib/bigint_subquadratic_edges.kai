# Karatsuba multiplication and recursive division against independent
# references: a chunked schoolbook product, and exact `q * b + r` inputs
# whose quotient and remainder are known up front.

import math.bigint

fn big(s: String) : BigInt = bigint.from_literal(s)

fn same(a: BigInt, b: BigInt) : Bool = bigint.compare(a, b) == 0

fn digits(n: Int, seed: String) : String =
  "1" ++ string_slice(string.repeat(seed, n / string_length(seed) + 1), 0, n - 1)

fn pow(base: BigInt, e: Int) : BigInt =
  if e == 0 { bigint.one() }
  else {
    let h = pow(base, e / 2)
    let sq = bigint.mul(h, h)
    if e % 2 == 1 { bigint.mul(sq, base) } else { sq }
  }

# Product by 90-digit chunks of `b`: every partial product has a short
# operand, so it never reaches the Karatsuba path.
fn chunked_mul(a: BigInt, b: String) : BigInt = chunked_from(a, b, string_length(b), 0, bigint.zero())

fn chunked_from(a: BigInt, b: String, hi: Int, shift: Int, acc: BigInt) : BigInt =
  if hi <= 0 { acc }
  else {
    let lo = if hi > 90 { hi - 90 } else { 0 }
    let chunk = big(string_slice(b, lo, hi - lo))
    let term = big(bigint.to_string(bigint.mul(a, chunk)) ++ string.repeat("0", shift))
    chunked_from(a, b, lo, shift + 90, bigint.add(acc, term))
  }

fn mul_case(na: Int, nb: Int) : Unit / Stdout = {
  let a = digits(na, "98765432101234567")
  let b = digits(nb, "31415926535897932")
  Stdout.print("mul #{na}x#{nb} #{same(bigint.mul(big(a), big(b)), chunked_mul(big(a), b))}")
}

fn div_case(nb: Int, nq: Int, rem_kind: Int) : Unit / Stdout = {
  let b = big(digits(nb, "27182818284590452"))
  let q = big(digits(nq, "16180339887498948"))
  let r = if rem_kind == 0 or nb == 1 { bigint.zero() } else if rem_kind == 1 { bigint.one() } else { bigint.sub(b, bigint.one()) }
  let a = bigint.add(bigint.mul(b, q), r)
  let nq_ = bigint.neg(q)
  let nr = bigint.neg(r)
  let nb_ = bigint.neg(b)
  let pp = match bigint.divmod(a, b) { Some(p) -> same(p.fst, q) and same(p.snd, r) None -> false }
  let np = match bigint.divmod(bigint.neg(a), b) { Some(p) -> same(p.fst, nq_) and same(p.snd, nr) None -> false }
  let pn = match bigint.divmod(a, nb_) { Some(p) -> same(p.fst, nq_) and same(p.snd, r) None -> false }
  let nn = match bigint.divmod(bigint.neg(a), nb_) { Some(p) -> same(p.fst, q) and same(p.snd, nr) None -> false }
  Stdout.print("divmod b=#{nb} q=#{nq} r=#{rem_kind} #{pp and np and pn and nn}")
}

fn factorial(n: Int) : BigInt =
  if n <= 1 { bigint.one() } else { bigint.mul(bigint.from_int(n), factorial(n - 1)) }

fn div_cases(nb: Int) : Unit / Stdout =
  list.foreach([1, 10, 150, 1000, 2500], (nq) => list.foreach([0, 1, 2], (kind) => div_case(nb, nq, kind)))

fn limb_case(k: Int) : Unit / Stdout = {
  let p = pow(bigint.from_int(2), 32 * k)
  let one = bigint.one()
  let sq_minus = bigint.sub(bigint.mul(p, p), one)
  let lo = bigint.sub(p, one)
  let hi = bigint.add(p, one)
  let prod = same(bigint.mul(lo, hi), sq_minus)
  let d1 = match bigint.divmod(sq_minus, lo) { Some(r) -> same(r.fst, hi) and bigint.is_zero(r.snd) None -> false }
  let d2 = match bigint.divmod(bigint.mul(p, p), hi) { Some(r) -> same(r.fst, lo) and same(r.snd, one) None -> false }
  Stdout.print("limbs #{k} #{prod and d1 and d2}")
}

fn main() : Unit / Stdout = {
  list.foreach([[30, 30], [231, 231], [240, 240], [250, 250], [300, 300], [700, 100], [3000, 3000], [3000, 500], [5000, 4000]],
    (p) => mul_case(list.nth(p, 0) ?? 0, list.nth(p, 1) ?? 0))
  list.foreach([1, 9, 10, 20, 150, 160, 170, 400, 2000], div_cases)
  list.foreach([1, 2, 15, 16, 17, 23, 24, 25, 31, 32, 33, 48, 49, 64], limb_case)
  Stdout.print("2^256 = #{bigint.to_string(pow(bigint.from_int(2), 256))}")
  Stdout.print("30! = #{bigint.to_string(factorial(30))}")
  Stdout.print("zero: #{bigint.to_string(bigint.mul(big(digits(500, "7")), bigint.zero()))}")
  Stdout.print("neg: #{bigint.to_string(bigint.mul(bigint.neg(big(digits(40, "7"))), big(digits(40, "3"))))}")
}
