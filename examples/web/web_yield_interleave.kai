# fixture: threads=1
import spawn

fn worker(name: String) : Unit / Spawn + Stdout {
  Stdout.print("#{name}0")
  spawn.yield()
  Stdout.print("#{name}1")
  spawn.yield()
  Stdout.print("#{name}2")
}

fn main() : Unit / Spawn + Stdout {
  let fa = spawn.spawn(() => worker("A"))
  let fb = spawn.spawn(() => worker("B"))
  spawn.await(fa)
  spawn.await(fb)
}
