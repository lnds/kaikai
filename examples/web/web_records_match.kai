type Shape = Circle(Real) | Rect(Real, Real)

fn area(s: Shape) : Real = match s {
  Circle(r)  -> 3.0 * r * r
  Rect(w, h) -> w * h
}

fn main() : Unit / Stdout = {
  let shapes = [Circle(2.0), Rect(3.0, 4.5)]
  shapes | area |> each((a) => Stdout.print("area=#{a}"))
  let words = ["rapa", "nui"] | ((w) => w ++ "!")
  Stdout.print(show(words))
}
