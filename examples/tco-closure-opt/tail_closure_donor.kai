# A function that rebuilds a tree cell in place of its donor calls a closure back in tail position: the reuse token is released at the bounce, and the cycle runs in constant stack.

type Color = Red | Black
type RBTree = RBLeaf | RBNode(Color, RBTree, Int, Int, RBTree)
type Hop = { step: (Hop, RBTree, Int) -> RBTree }

fn dn_a(h: Hop, l: RBTree, n: Int) : RBTree =
  match l {
    RBNode(_, RBNode(Red, lx, kx, vx, rx), ky, vy, ry) ->
      RBNode(Red, RBNode(Black, lx, kx, vx, rx), ky, vy, RBNode(Black, ry, n, n, RBLeaf))
    RBNode(c, lx, kx, vx, rx) ->
      if n == 0 { l } else { h.step(h, RBNode(c, lx, kx + 1, vx, rx), n - 1) }
    RBLeaf -> RBLeaf
  }

fn key(t: RBTree) : Int = match t {
  RBLeaf                -> 0
  RBNode(_, _, k, _, _) -> k
}

fn main() : Unit / Stdout = {
  let h = Hop { step: (self, t, n) => dn_a(self, t, n) }
  let t = RBNode(Black, RBLeaf, 0, 0, RBLeaf)
  Stdout.print("#{key(dn_a(h, t, 100000000))}")
}
