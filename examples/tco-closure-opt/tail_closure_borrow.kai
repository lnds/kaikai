# A function tail calls one that borrows a list it built, and that one calls a closure back in tail position: the borrowed list is released by the callee, and the cycle runs in constant stack.

type Hop = { step: (Hop, Int) -> Int }

fn bw_len(xs: [Int]) : Int = match xs {
  []           -> 0
  [_, ...rest] -> 1 + bw_len(rest)
}

fn bw_read(h: Hop, ^xs: [Int], n: Int) : Int =
  if n == 0 { 0 } else { h.step(h, n - 1 + bw_len(xs) - 3) }

fn bw_enter(h: Hop, n: Int) : Int = bw_read(h, [n, n, n], n)

fn main() : Unit / Stdout = {
  let h = Hop { step: (self, n) => bw_enter(self, n) }
  Stdout.print("#{bw_enter(h, 100000000)}")
}
