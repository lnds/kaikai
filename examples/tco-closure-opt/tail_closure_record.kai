# A closure stored in a record is called in tail position, and the closure calls back into the function: the cycle runs in constant stack.

type Hop = { step: (Hop, Int, Int) -> Int }

fn spin(h: Hop, n: Int, acc: Int) : Int =
  if n == 0 { acc } else { h.step(h, n - 1, acc + 1) }

fn main() : Unit / Stdout = {
  let h = Hop { step: (self, n, acc) => spin(self, n, acc) }
  Stdout.print("#{spin(h, 20000000, 0)}")
}
