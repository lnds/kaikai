# Closures of one, two and three parameters in one cycle: every hop is a call in tail position through a closure of another arity.

fn tri(n: Int, a: (Int) -> Int, b: (Int, Int) -> Int, c: (Int, Int, Int) -> Int) : Int =
  if n == 0 { 0 }
  else if n % 3 == 0 { a(n - 1) }
  else if n % 3 == 1 { b(n - 1, 1) }
  else { c(n - 1, 1, 2) }

fn go(n: Int) : Int = tri(n, go, (m, k) => go(m + k - 1), (m, k, j) => go(m + k + j - 3))

fn main() : Unit / Stdout = {
  Stdout.print("#{go(30000000)}")
}
