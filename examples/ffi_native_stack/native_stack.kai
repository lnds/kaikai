# `#[native_stack]` runs the C call on the thread's own stack: from main, from a
# spawned fiber and from a stack segment, the helper finds its stack pointer
# inside the thread's bounds.

import spawn

#[native_stack]
extern "C"("stack_check") fn native_check(tag: Int) : Int / Ffi

type Gen[e] = Done(Int) | Next(Int, Cont[Unit, Gen[e], e])

effect Yield {
  yield(x: Int) : Unit
}

fn segment_body() : Int / Yield + Ffi {
  Yield.yield(1)
  native_check(3)
}

fn generate() : Gen[Ffi] / Ffi =
  handle {
    Done(segment_body())
  } with Yield {
    yield(x, resume) -> Next(x, resume)
  }

fn drain(g: Gen[Ffi]) : Int / Ffi = match g {
  Done(v) -> v
  Next(_, k) -> drain(k(()))
}

pub fn main() : Unit / Stdout + Ffi + Spawn {
  Stdout.print("main: #{native_check(1)}")
  let spawned = nursery { s ->
    let f = s.spawn(() => native_check(2))
    s.await(f)
  }
  Stdout.print("fiber: #{spawned}")
  Stdout.print("segment: #{drain(generate())}")
}
