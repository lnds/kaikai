# A trap inside a callback ends the process during a `#[native_stack]` call:
# its own message prints first, then the native-stack context.

extern "C" fn kai_cb(x: Int) : Int {
  let arr = array_make(3, 0)
  arr[x]
}

#[native_stack]
extern "C" fn call_cb(x: Int) : Int / Ffi

pub fn main() : Unit / Stdout + Ffi = Stdout.print("unreachable: #{call_cb(7)}")
