# A callback that raises Cancel, handled outside the call by a clause that
# does not resume, panics: the jump would leave the native stack call.

extern "C" fn kai_cb(x: Int) : Int / Cancel = {
  Cancel.raise()
  x
}

#[native_stack]
extern "C" fn call_cb(x: Int) : Int / Ffi

pub fn main() : Unit / Stdout + Ffi + Cancel = {
  let r = handle { call_cb(1) } with Cancel { raise(resume) -> 42 }
  Stdout.print("unreachable: #{r}")
}
