# A callback that suspends the fiber during a `#[native_stack]` call panics.

import time

extern "C" fn kai_cb(x: Int) : Int / Clock {
  sleep(millis(1))
  x
}

#[native_stack]
extern "C" fn call_cb(x: Int) : Int / Ffi

pub fn main() : Unit / Stdout + Ffi = Stdout.print("unreachable: #{call_cb(1)}")
