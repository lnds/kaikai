# fixture: target=wasm32-wasi

import actor
import spawn
import time

fn nap(label: String, ms: Int) : String / Stdout + Clock = {
  sleep(millis(ms))
  Stdout.print("woke #{label}")
  label
}

fn echo() : Unit / Actor[String] + Stdout = {
  match Actor.receive() {
    msg -> Stdout.print("actor got #{msg}")
  }
}

fn main() : Int / Spawn + Stdout + Clock = {
  let order = nursery { n ->
    let slow = n.spawn(() => nap("slow", 80))
    let fast = n.spawn(() => nap("fast", 10))
    [n.await(slow), n.await(fast)]
  }
  Stdout.print("joined #{order |> length()}")
  with_mailbox {
    let me = Actor.self()
    Actor.send(me, "ping")
    echo()
  }
  0
}
