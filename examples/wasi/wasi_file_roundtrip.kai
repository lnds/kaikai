# fixture: target=wasm32-wasi

import fs.file
import fs.dir

fn main() : Int / Stdout + File = {
  let d = "/tmp/kai_wasi_roundtrip"
  let _ = dir.remove_dir(d)
  let _ = dir.create_dir(d)
  file.write("#{d}/a.txt", "alpha\n") |> ignore
  file.append("#{d}/a.txt", "beta\n") |> ignore
  file.write("#{d}/b.txt", "gamma\n") |> ignore
  Stdout.print(file.read("#{d}/a.txt") |> unwrap_or(""))
  Stdout.print("exists a: #{file.exists("#{d}/a.txt")}")
  Stdout.print("exists c: #{file.exists("#{d}/c.txt")}")
  Stdout.print("listed: #{string.join(dir.list_dir(d) |> list.sort(), ",")}")
  let _ = file.delete("#{d}/a.txt")
  Stdout.print("exists a after delete: #{file.exists("#{d}/a.txt")}")
  let _ = file.delete("#{d}/b.txt")
  let _ = dir.remove_dir(d)
  0
}
