# kaic1 loads `lib.left` and `lib.right` through the import graph. The
# two lambdas sit at the same (line, column) in their own files: lambda
# identity is keyed on that position, so a shared line range makes the
# second one reuse the first one's captures and both lists come out the
# same.

import lib.left
import lib.right

fn show(xs: [Int]) : String = string_join(map(xs, int_to_string), ",")

fn main() {
  print(show(left_apply([1, 2, 3], 10)))
  print(show(right_apply([1, 2, 3], 10)))
}
