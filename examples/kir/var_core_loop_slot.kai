# A `var` mutated only inside the core's `while` is a stack slot: the loop
# runs its lambdas in place, so the cell never escapes and no handler is made.

import loop

fn count(n: Int) : Int = {
  var i := 0
  var acc := 0
  while { i < n } {
    acc := acc + i
    i := i + 1
  }
  acc
}

fn main() : Int / Console = {
  Stdout.print(int_to_string(count(5)))
  0
}
