# KIR fixture: binders of sibling arms that share a spelling. A derived
# `show` binds every arm's payload under one generated name; each arm
# after the first takes a register of its own, since a register is an
# alloca keyed by its name and the first arm's is still live.

#[derive(Show)]
type Shape = Circle(String) | Square(String)

fn main() : Int / Stdout = {
  Stdout.print(show(Circle("r")))
  Stdout.print(show(Square("s")))
  0
}
