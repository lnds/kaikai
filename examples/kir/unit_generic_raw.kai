# KIR fixture: a unit-generic fn over `Real<u>` instantiates box-free.
unit m

fn half(x: Real) : Real = x * 0.5

fn scale[u: Measure](x: Real<u>) : Real<u> = __attach_unit(half(__strip_unit(x)))

fn twice[u: Measure](x: Real<u>) : Real<u> = x + x

fn main() : Unit / Console = {
  let a : Real = scale(3.0)
  let b : Real<m> = scale(3.0<m>)
  let c : Real<m> = twice(1.5<m>)
  Stdout.print(real_to_string(__strip_unit(a) + __strip_unit(b) + __strip_unit(c)))
}
