# Each pipe lowers to the KIR of the call it spells: the `_piped` and
# `_direct` bodies below are identical.

fn add(acc: Int, x: Int) : Int = acc + x
fn double(x: Int) : Int = x * 2
fn pos(x: Int) : Bool = x > 0
fn twin(x: Int) : [Int] = [x, x]

fn fold_piped(xs: [Int]) : Int = xs |> foldl(0, add)
fn fold_direct(xs: [Int]) : Int = foldl(xs, 0, add)
fn map_piped(xs: [Int]) : [Int] = xs | double
fn map_direct(xs: [Int]) : [Int] = list.map(xs, double)
fn filter_piped(xs: [Int]) : [Int] = xs |? pos
fn filter_direct(xs: [Int]) : [Int] = list.filter(xs, pos)
fn flat_piped(xs: [Int]) : [Int] = xs || twin
fn flat_direct(xs: [Int]) : [Int] = list.flat_map(xs, twin)

fn main() : Unit / Stdout = {
  let xs = [1, -2, 3]
  Stdout.print("#{fold_piped(xs)} #{fold_direct(xs)}")
  Stdout.print("#{map_piped(xs)} #{map_direct(xs)}")
  Stdout.print("#{filter_piped(xs)} #{filter_direct(xs)}")
  Stdout.print("#{flat_piped(xs)} #{flat_direct(xs)}")
}
