fn trunc_raw(x_0: f64) : f64 {
  entry:
    .t0: i64 = prim fptosi(x_0)
    .t1: f64 = prim sitofp(.t0)
    ret .t1
}

fn widen(i_0: i64) : f64 {
  entry:
    .t0: f64 = prim sitofp(i_0)
    .t1: f64 = prim f*(.t0, 0.5)
    ret .t1
}

fn sum(i_0: i64, acc_1: f64) : f64 {
  entry:
    .t0: i1 = prim i==(i_0, 0)
    .t1: f64 = 0
    condbr .t0 ? L0 : L1
  L0:
    .t1 <- acc_1
    br L2
  L1:
    .t2: i64 = prim i-(i_0, 1)
    .t3: f64 = prim sitofp(i_0)
    .t4: f64 = prim f*(.t3, 0.37)
    .t5: f64 = trunc_raw(.t4)
    .t6: f64 = prim f+(acc_1, .t5)
    tcrec-goto _kai_sum_entry {p0 <- .t2, p1 <- .t6} dropmask=0
  L3:
    .t1 <- ()
    br L2
  L2:
    .t7: f64 = prim real.unbox(.t1)
    drop .t1
    ret .t7
}

