# KIR fixture: a Real literal is written as the text that reads back to its
# bits: six digits, sixteen, a subnormal, negated.
fn short() : Real = 1.5

fn long() : Real = 3.141592653589793

fn subnormal() : Real = 1.234567e-310

fn negative() : Real = -1234567.891

fn main() : Unit / Console = {
  Stdout.print("#{real_bits(short() + long() + subnormal() + negative())}")
}
