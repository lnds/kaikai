# A local named like the core's `while` shadows it: the call is the local's,
# keeps its lambdas, and the `var` they capture is a handler.

import loop

fn spin(pred: () -> Bool / e, body: () -> Unit / e) : Unit / e =
  if pred() { body(); spin(pred, body) } else { () }

fn count(n: Int) : Int = {
  let while = spin
  var i := 0
  var acc := 0
  while { i < n } {
    acc := acc + i
    i := i + 1
  }
  acc
}

fn main() : Int / Console = {
  Stdout.print(int_to_string(count(5)))
  0
}
