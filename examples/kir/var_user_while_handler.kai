# A `while` the program declares is not the core's: the call keeps its
# lambdas, which capture the `var`, so the cell is a `State` handler.

fn while(pred: () -> Bool / e, body: () -> Unit / e) : Unit / e =
  if pred() { body(); while(pred, body) } else { () }

fn count(n: Int) : Int = {
  var i := 0
  var acc := 0
  while { i < n } {
    acc := acc + i
    i := i + 1
  }
  acc
}

fn main() : Int / Console = {
  Stdout.print(int_to_string(count(5)))
  0
}
