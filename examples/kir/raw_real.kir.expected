fn chain(seed_0: f64) : f64 {
  entry:
    .t0: f64 = prim f+(seed_0, 1)
    a_1: f64 = .t0
    .t1: f64 = prim f*(a_1, 7)
    b_2: f64 = .t1
    .t2: f64 = prim f-(b_2, a_1)
    c_3: f64 = .t2
    .t3: i1 = prim f<(a_1, b_2)
    big_4: i1 = .t3
    .t4: f64 = 0
    condbr big_4 ? L0 : L1
  L0:
    .t5: f64 = prim f+(a_1, b_2)
    .t6: f64 = prim f+(.t5, c_3)
    .t4 <- .t6
    br L2
  L1:
    .t7: f64 = prim f-(a_1, b_2)
    .t4 <- .t7
    br L2
  L2:
    .t8: f64 = prim real.unbox(.t4)
    drop .t4
    ret .t8
}

fn main() : box {
  entry:
    .t0: f64 = chain(3)
    r_0: f64 = .t0
    .t1: box = prim real.box(r_0)
    .t2: box = kaix_core_real_to_string(.t1)
    .t3: box = perform Stdout.print(.t2)
    ret .t3
}

