import stream as S

#[must_use("the fault is lost unless it is checked")]
type Checked = Checked(Int)

fn parse(n: Int) : Result[Int, String] = if n > 0 { Ok(n) } else { Err("bad") }

fn tag(n: Int) : Checked = Checked(n)

fn main() {
  parse(1)
  S.from_list([1, 2])
  tag(3)
  parse(2) |> ignore
  let _ = parse(3)
  let _kept = parse(4)
  match parse(5) {
    Ok(_) -> ()
    Err(_) -> ()
  }
  Stdout.print("done")
}
