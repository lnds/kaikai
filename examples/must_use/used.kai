import stream as S

fn parse(n: Int) : Result[Int, String] = if n > 0 { Ok(n) } else { Err("bad") }

fn pass(n: Int) : Result[Int, String] {
  Stdout.print("pass")
  parse(n)
}

fn main() {
  parse(1) |> ignore
  S.from_list([1, 2]) |> ignore
  let _ = parse(3)
  let _kept = parse(4)
  let r = pass(5)
  match r {
    Ok(v) -> Stdout.print("#{v}")
    Err(e) -> Stdout.print(e)
  }
}
