fn main() : Int / Stdout = {
  let s = "añb=c"
  let at = string.index_of(s, "=") ?? 0
  Stdout.print(string.slice(s, 0, at))
  Stdout.print(string.slice(s, at + 1, string.length(s) - at - 1))
  Stdout.print(string.slice("café", 3, 9))
  Stdout.print("[#{string.slice("café", 9, 2)}]")
  Stdout.print("[#{string.slice("café", 1, 0)}]")
  Stdout.print(string.slice("café", -3, 3))
  0
}
