# Without a leading bar a bare right-hand side is an alias, and stays
# one. `Meters` is interchangeable with `Int`, which is the behaviour
# the one-member sum form must not disturb.

type Meters = Int
type Distance = Meters

fn add(a: Distance, b: Meters) : Int = a + b

fn main() : Int / Stdout {
  Stdout.print(int_to_string(add(3, 4)))
  0
}
