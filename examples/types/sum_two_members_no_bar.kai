# Two or more members are written without a leading bar. The bar form
# exists for the one-member case; this fixture guards that enabling it
# did not disturb the ordinary spelling.

type Color = Red | Green

fn name_of(c: Color) : String {
  match c {
    Red   -> "red"
    Green -> "green"
  }
}

fn main() : Int / Stdout {
  Stdout.print(name_of(Red))
  Stdout.print(name_of(Green))
  0
}
