# A lone variant that carries a payload already reads as a sum on its
# parentheses, so the leading bar is optional there and the formatter
# drops it. The bar is load-bearing only for a lone NULLARY variant,
# where its absence is the alias spelling.

type Wrap = | Only(String)

fn unwrap(w: Wrap) : String {
  match w {
    Only(s) -> s
  }
}

fn main() : Int / Stdout {
  Stdout.print(unwrap(Only("wrapped")))
  0
}
