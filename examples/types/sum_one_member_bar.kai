# A leading bar declares a sum outright, which is what lets a sum with
# a single nullary variant exist: without the bar, `= X` is the alias
# spelling and the constructor `X` never exists. The variant is both
# constructed and matched here — a fixture that only declares the type
# cannot tell a one-member sum from an alias, since the alias is
# perfectly usable in type position.

type Evidence = | IdenticalBytecode

fn describe(e: Evidence) : String {
  match e {
    IdenticalBytecode -> "identical"
  }
}

fn main() : Int / Stdout {
  Stdout.print(describe(IdenticalBytecode))
  0
}
