# Using an alias's right-hand side as a constructor is the mistake the
# one-member sum form exists to prevent, so the diagnostic names the
# form instead of guessing at a misspelling.

type Evidence = IdenticalBytecode

fn main() : Int / Stdout {
  match IdenticalBytecode {
    IdenticalBytecode -> Stdout.print("never")
  }
  0
}
