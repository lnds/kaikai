# fixture: target=wasm32-wasi

import time

fn main() : Int / Stdout + Clock + Random + SecureRandom = {
  let a = time.monotonic()
  time.sleep(time.millis(30))
  let b = time.monotonic()
  let ms = time.duration_to_nanos(time.elapsed_since(a, b)) / 1_000_000
  Stdout.print("slept at least 25ms: #{ms >= 25}")
  Stdout.print("wall after 2020: #{time.now().secs > 1577836800}")
  let r = Random.int_range(0, 99)
  let s = SecureRandom.int_range(0, 99)
  Stdout.print("random in range: #{r >= 0 and r <= 99 and s >= 0 and s <= 99}")
  0
}
