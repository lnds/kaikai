import encoding.toml
import deplib
import helper

fn positive(x: Int) : Bool = if x > 0 { true } else { false }

fn main() : Unit / Stdout = match toml.decode("a = 1\n") {
  Some(_) ->
    Stdout.print("#{positive(deplib.or_zero(Some(1)))} #{helper.prepend(deplib.prepend([]))}")
  None -> Stdout.print("not read")
}
