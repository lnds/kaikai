pub type Msg = Ping | Pong

effect Cell {
  get() : Int
  set(n: Int) : Unit
}

fn fresh[r, e](init: Int, body: () -> r / Cell + e) : r / e {
  handle {
    body()
  } with State[Int](init) {
    get(resume) -> resume(state)
    set(v, resume) -> resume((), v)
    return(x) -> x
  }
}

pub fn run() : Int / Stdout {
  fresh(0) {
    Cell.set(Cell.get() + 5)
    0
  }
}
