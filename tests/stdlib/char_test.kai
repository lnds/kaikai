fn check_ascii(n: Int) : Unit {
  if n < 128 {
    let c = int_to_char(n)
    let digit = string_contains("0123456789", "#{c}")
    let lower = string_contains("abcdefghijklmnopqrstuvwxyz", "#{c}")
    let upper = string_contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "#{c}")
    assert char.is_digit(c) == digit
    assert char.is_lower(c) == lower
    assert char.is_upper(c) == upper
    assert char.is_alpha(c) == (lower or upper or n == 95)
    assert char.is_alnum(c) == (lower or upper or digit or n == 95)
    assert char.is_space(c) == (n == 32 or n == 9)
    assert char.to_lower(c) == int_to_char(if upper { n + 32 } else { n })
    assert char.to_upper(c) == int_to_char(if lower { n - 32 } else { n })
    check_ascii(n + 1)
  }
}

test "every ASCII codepoint obeys the character classes and case mappings" {
  check_ascii(0)
}

fn check_non_ascii(cs: [Char]) : Unit = match cs {
  [] -> ()
  [c, ...rest] -> {
    assert not char.is_digit(c)
    assert not char.is_lower(c)
    assert not char.is_upper(c)
    assert not char.is_alpha(c)
    assert not char.is_alnum(c)
    assert not char.is_space(c)
    assert char.to_lower(c) == c
    assert char.to_upper(c) == c
    check_non_ascii(rest)
  }
}

test "ASCII helpers leave non-ASCII letters digits whitespace and emoji untouched" {
  check_non_ascii([
    '\u{e9}',
    '\u{c9}',
    '\u{3b1}',
    '\u{410}',
    '\u{4e2d}',
    '\u{1f600}',
    '\u{ff19}',
    int_to_char(160),
    int_to_char(8195)
  ])
}
