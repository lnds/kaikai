import net.http
import os.args

fn main() : Int / Env + NetTcp + Cancel + Stdout {
  let argv = args.argv()
  match argv {
    [url, method, ..._] -> {
      let req = Request {
        method: method,
        url: url,
        body: "payload",
        headers: [
          HttpHeader { name: "Authorization", value: "secret-a" },
          HttpHeader { name: "aUtHoRiZaTiOn", value: "secret-b" },
          HttpHeader { name: "COOKIE", value: "session=secret" },
          HttpHeader { name: "Cookie2", value: "legacy=secret" },
          HttpHeader { name: "Proxy-Authorization", value: "proxy-secret" },
          HttpHeader { name: "Host", value: "stale.example" },
          HttpHeader { name: "X-Trace", value: "keep-me" }
        ]
      }
      match http.follow(req, http.default_redirect_policy()) {
        Ok(resp) -> {
          assert resp.status == 200
          Stdout.print(resp.body)
          0
        }
        Err(msg) -> {
          Stdout.print(msg)
          1
        }
      }
    }
    _ -> 1
  }
}
