import encoding.utf8

fn byte_of(n: Int) : Byte = match int_to_byte(n) {
  Ok(b)  -> b
  Err(_) -> 0u8
}

fn bs(xs: [Int]) : [Byte] = xs | byte_of

fn bad_at(xs: [Int], off: Int) : Bool = utf8.decode(bs(xs)) == Err(off)

fn good(xs: [Int], s: String) : Bool =
  utf8.decode(bs(xs)) == Ok(s) and utf8.is_valid(bs(xs)) and utf8.decode_lossy(bs(xs)) == s

fn lossy(xs: [Int]) : String = utf8.decode_lossy(bs(xs))

fn fffd(n: Int) : String = if n == 0 { "" } else { "\u{FFFD}" ++ fffd(n - 1) }

fn repeat_int(x: Int, n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { repeat_int(x, n - 1, [x, ...acc]) }

test "decode the documented example" {
  assert utf8.decode(bs([0x68, 0xC3, 0x28])) == Err(1)
  assert utf8.decode(bs([0x68, 0xC3, 0xA9])) == Ok("h\u{E9}")
}

test "decode empty input" {
  assert utf8.decode([]) == Ok("")
  assert utf8.is_valid([])
  assert utf8.decode_lossy([]) == ""
  assert utf8.encode("") == []
}

test "decode the first and last sequence of each width" {
  assert good([0x00], "\u{0}")
  assert good([0x7F], "\u{7F}")
  assert good([0xC2, 0x80], "\u{80}")
  assert good([0xDF, 0xBF], "\u{7FF}")
  assert good([0xE0, 0xA0, 0x80], "\u{800}")
  assert good([0xEF, 0xBF, 0xBF], "\u{FFFF}")
  assert good([0xF0, 0x90, 0x80, 0x80], "\u{10000}")
  assert good([0xF4, 0x8F, 0xBF, 0xBF], "\u{10FFFF}")
}

test "decode the codepoints around the surrogate gap" {
  assert good([0xED, 0x9F, 0xBF], "\u{D7FF}")
  assert good([0xEE, 0x80, 0x80], "\u{E000}")
  assert good([0xEF, 0xBF, 0xBD], "\u{FFFD}")
}

test "decode mixed widths and report the offset past multibyte text" {
  assert good([0x61, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80, 0x7A], "a\u{E9}\u{20AC}\u{1F600}z")
  assert bad_at([0x61, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80, 0xFF], 10)
}

test "decode rejects a lone continuation byte" {
  assert bad_at([0x80], 0)
  assert bad_at([0xBF], 0)
  assert bad_at([0x41, 0x80], 1)
  assert bad_at([0x41, 0xBF, 0x42], 1)
  assert bad_at([0x80, 0xBF, 0x80, 0xBF], 0)
}

test "decode rejects bytes that never occur in UTF-8" {
  assert bad_at([0xC0], 0)
  assert bad_at([0xC1], 0)
  assert bad_at([0xF5, 0x80, 0x80, 0x80], 0)
  assert bad_at([0xF7, 0xBF, 0xBF, 0xBF], 0)
  assert bad_at([0xF8, 0x88, 0x80, 0x80, 0x80], 0)
  assert bad_at([0xFC, 0x84, 0x80, 0x80, 0x80, 0x80], 0)
  assert bad_at([0xFE], 0)
  assert bad_at([0xFF], 0)
  assert bad_at([0x61, 0xFE, 0xFF], 1)
}

test "decode rejects a lead byte followed by a non-continuation" {
  assert bad_at([0xC2, 0x20], 0)
  assert bad_at([0xDF, 0x41], 0)
  assert bad_at([0xE1, 0x20, 0x80], 0)
  assert bad_at([0xE1, 0x80, 0x20], 0)
  assert bad_at([0xF1, 0x20, 0x80, 0x80], 0)
  assert bad_at([0xF1, 0x80, 0x80, 0x20], 0)
  assert bad_at([0x41, 0xC3, 0x28], 1)
}

test "decode rejects truncated sequences at the end of input" {
  assert bad_at([0xC2], 0)
  assert bad_at([0xE2, 0x82], 0)
  assert bad_at([0xF0, 0x9F, 0x98], 0)
  assert bad_at([0xF4], 0)
  assert bad_at([0x68, 0x69, 0xE2, 0x82], 2)
  assert bad_at([0x68, 0xF0], 1)
}

test "decode rejects overlong forms" {
  assert bad_at([0xC0, 0x80], 0)
  assert bad_at([0xC0, 0xAF], 0)
  assert bad_at([0xC1, 0xBF], 0)
  assert bad_at([0xE0, 0x80, 0x80], 0)
  assert bad_at([0xE0, 0x80, 0xAF], 0)
  assert bad_at([0xE0, 0x9F, 0xBF], 0)
  assert bad_at([0xF0, 0x80, 0x80, 0x80], 0)
  assert bad_at([0xF0, 0x80, 0x80, 0xAF], 0)
  assert bad_at([0xF0, 0x8F, 0xBF, 0xBF], 0)
  assert bad_at([0x2F, 0xC0, 0xAE], 1)
}

test "decode rejects UTF-16 surrogates" {
  assert bad_at([0xED, 0xA0, 0x80], 0)
  assert bad_at([0xED, 0xAD, 0xBF], 0)
  assert bad_at([0xED, 0xAE, 0x80], 0)
  assert bad_at([0xED, 0xAF, 0xBF], 0)
  assert bad_at([0xED, 0xB0, 0x80], 0)
  assert bad_at([0xED, 0xBF, 0xBF], 0)
  assert bad_at([0xED, 0xA0, 0x80, 0xED, 0xB0, 0x80], 0)
}

test "decode rejects codepoints above U+10FFFF" {
  assert bad_at([0xF4, 0x90, 0x80, 0x80], 0)
  assert bad_at([0xF4, 0xBF, 0xBF, 0xBF], 0)
  assert bad_at([0xF5, 0x80, 0x80, 0x80], 0)
}

test "decode reports only the first bad sequence" {
  assert bad_at([0x61, 0x80, 0xFF, 0xC0], 1)
  assert bad_at([0xC3, 0xA9, 0xC3, 0xA9, 0xC3], 4)
}

test "is_valid agrees with decode" {
  assert utf8.is_valid(bs([0x68, 0xC3, 0xA9]))
  assert not utf8.is_valid(bs([0x68, 0xC3, 0x28]))
  assert not utf8.is_valid(bs([0xED, 0xA0, 0x80]))
  assert not utf8.is_valid(bs([0xC0, 0xAF]))
  assert not utf8.is_valid(bs([0xE2, 0x82]))
}

test "decode_lossy replaces each maximal ill-formed subpart" {
  assert lossy([0x61, 0xF1, 0x80, 0x80, 0xE1, 0x80, 0xC2, 0x62]) == "a" ++ fffd(3) ++ "b"
  assert lossy([0x68, 0xC3, 0x28]) == "h\u{FFFD}("
  assert lossy([0x80]) == fffd(1)
  assert lossy([0x80, 0xBF]) == fffd(2)
  assert lossy([0xFE, 0xFF]) == fffd(2)
}

test "decode_lossy on truncated sequences yields one replacement" {
  assert lossy([0xE2, 0x82]) == fffd(1)
  assert lossy([0xF0, 0x90, 0x80]) == fffd(1)
  assert lossy([0xF4, 0x8F]) == fffd(1)
  assert lossy([0x61, 0xE2, 0x82]) == "a" ++ fffd(1)
}

test "decode_lossy on overlongs, surrogates and out-of-range" {
  assert lossy([0xC0, 0xAF]) == fffd(2)
  assert lossy([0xE0, 0x80, 0xAF]) == fffd(3)
  assert lossy([0xF0, 0x80, 0x80, 0xAF]) == fffd(4)
  assert lossy([0xE0, 0x9F, 0xBF]) == fffd(3)
  assert lossy([0xED, 0xA0, 0x80]) == fffd(3)
  assert lossy([0xED, 0xBF, 0xBF]) == fffd(3)
  assert lossy([0xF4, 0x90, 0x80, 0x80]) == fffd(4)
  assert lossy([0xF5, 0x80, 0x80, 0x80]) == fffd(4)
}

test "decode_lossy resumes at the byte that broke the sequence" {
  assert lossy([0xE2, 0x82, 0x41]) == fffd(1) ++ "A"
  assert lossy([0xF0, 0x9F, 0xC3, 0xA9]) == fffd(1) ++ "\u{E9}"
  assert lossy([0xC3, 0xC3, 0xA9]) == fffd(1) ++ "\u{E9}"
  assert lossy([0xE2, 0xE2, 0x82, 0xAC]) == fffd(1) ++ "\u{20AC}"
}

test "decode_lossy replaces invalid bytes that follow a multibyte sequence" {
  assert lossy([0xC3, 0xA9, 0xFF]) == "\u{E9}" ++ fffd(1)
  assert lossy([0xE2, 0x82, 0xAC, 0x80]) == "\u{20AC}" ++ fffd(1)
  assert lossy([0xF0, 0x9F, 0x98, 0x80, 0xC0, 0xAF, 0x41]) == "\u{1F600}" ++ fffd(2) ++ "A"
}

test "decode_lossy keeps valid text untouched" {
  assert lossy([0x61, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80]) == "a\u{E9}\u{20AC}\u{1F600}"
}

test "encode is string.bytes and round-trips through decode" {
  let samples = ["", "a", "h\u{E9}llo", "\u{20AC}", "\u{1F600}", "a\u{7FF}\u{800}\u{FFFF}\u{10000}\u{10FFFF}z", "\u{0}"]
  samples |! (s) => {
    assert utf8.encode(s) == string.bytes(s)
    assert utf8.decode(utf8.encode(s)) == Ok(s)
    assert utf8.is_valid(utf8.encode(s))
  }
}

test "encode emits the UTF-8 width of each codepoint" {
  assert utf8.encode("\u{E9}") == bs([0xC3, 0xA9])
  assert utf8.encode("\u{20AC}") == bs([0xE2, 0x82, 0xAC])
  assert utf8.encode("\u{1F600}") == bs([0xF0, 0x9F, 0x98, 0x80])
}

test "decode a long valid input and a long input broken at the end" {
  let unit = [0xE2, 0x82, 0xAC, 0x61]
  let n = 500
  let body = repeat_int(0x61, n, [])
  assert utf8.decode(bs(body)) |> is_ok
  let tail_bad = body ++ [0xE2, 0x82]
  assert bad_at(tail_bad, n)
  assert utf8.decode_lossy(bs(tail_bad)) == string.from_bytes(bs(body)) ++ fffd(1)
  assert utf8.is_valid(bs(unit ++ unit))
}

fn is_ok[a, e](r: Result[a, e]) : Bool = match r {
  Ok(_)  -> true
  Err(_) -> false
}
