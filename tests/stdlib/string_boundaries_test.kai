fn check_slice_lengths(s: String, start: Int, count: Int) : Unit {
  if count <= string.char_count(s) + 2 {
    let safe_start = if start < 0 { 0 } else { start }
    let safe_count = if count < 0 { 0 } else { count }
    let expected = string.from_chars(list.take(list.drop(string.chars(s), safe_start), safe_count))
    assert string.slice(s, start, count) == expected
    check_slice_lengths(s, start, count + 1)
  }
}

fn check_slice_starts(s: String, start: Int) : Unit {
  if start <= string.char_count(s) + 2 {
    check_slice_lengths(s, start, -2)
    check_slice_starts(s, start + 1)
  }
}

test "slice clamping agrees with the list-of-codepoints model around both ends" {
  check_slice_starts("", -2)
  check_slice_starts("a", -2)
  check_slice_starts("é€😀", -2)
  check_slice_starts("aé€😀z", -2)
}

fn check_padding(s: String, width: Int) : Unit {
  if width <= string.byte_length(s) + 2 {
    let count = if width > string.byte_length(s) { width - string.byte_length(s) } else { 0 }
    let fill = string.from_chars(list.repeat('x', count))
    assert string.pad_left(s, width, 'x') == string.concat(fill, s)
    assert string.pad_right(s, width, 'x') == string.concat(s, fill)
    check_padding(s, width + 1)
  }
}

test "padding equality and neighbouring widths preserve the byte-width contract" {
  check_padding("", -2)
  check_padding("abc", -2)
  check_padding("é€😀", -2)
}

fn check_whitespace(s: String, n: Int) : Unit {
  if n <= 4 {
    let ws = string.repeat(s, n)
    assert string.trim(ws) == ""
    assert string.trim_left(ws) == ""
    assert string.trim_right(ws) == ""
    assert string.is_blank(ws)
    assert string.trim(string.concat(ws, string.concat("é", ws))) == "é"
    check_whitespace(s, n + 1)
  }
}

test "empty and all-whitespace inputs reach both trim edges and the blank sentinel" {
  assert string.trim("a") == "a"
  assert string.trim_right("a") == "a"
  assert string.trim(" a ") == "a"
  assert string.trim_right("a \t\r\n") == "a"
  check_whitespace(" ", 0)
  check_whitespace("\t", 0)
  check_whitespace("\r", 0)
  check_whitespace("\n", 0)
  check_whitespace("\t \r\n", 0)
}

fn check_widths(s: String, off: Int) : Unit {
  if off < string.byte_length(s) {
    let width = string_cp_len(s, off)
    assert width >= 1 and width <= 4
    assert char_at(s, off) != None
    check_widths(s, off + 1)
  }
}

fn check_octets(n: Int) : Unit {
  if n < 256 {
    match int_to_byte(n) {
      Err(_) -> {
        assert false
      }
      Ok(b) -> {
        let s = string.from_bytes([b])
        assert string_cp_len(s, 0) == 1
        assert char_at(s, 0) == Some(int_to_char(n))
      }
    }
    check_octets(n + 1)
  }
}

test "in-range UTF-8 widths stay positive including every malformed single octet" {
  check_widths("aé€😀", 0)
  check_widths(string.from_bytes([192u8, 128u8, 255u8, 240u8]), 0)
  check_octets(0)
}

fn check_edges(s: String) : Unit {
  let n = string.byte_length(s)
  assert char_at(s, -1) == None
  assert char_at(s, n) == None
  assert string_byte_at_int(s, n) == (-1)
  assert string.floor_char_boundary(s, 0) == 0
  assert string.ceil_char_boundary(s, 0) == 0
  assert string.floor_char_boundary(s, n) == n
  assert string.ceil_char_boundary(s, n) == n
}

test "boundary clamps handle endpoints and malformed leading bytes" {
  check_edges("")
  check_edges("aé€😀")
  let malformed = string.from_bytes([128u8, 191u8, 192u8, 255u8])
  check_edges(malformed)
  assert string.floor_char_boundary(malformed, 1) == 0
  assert string.ceil_char_boundary(malformed, 1) == 2
  assert string.floor_char_boundary(malformed, 2) == 2
}
