import encoding.json
import encoding.json_bind

fn dec(s: String) : Option[JsonValue] = json.json_decode(s)

fn enc(v: JsonValue) : String = json.json_encode(v)

fn pair(k: String, v: JsonValue) : Pair[String, JsonValue] = Pair { fst: k, snd: v }

fn rejects(s: String) : Bool = match dec(s) {
  None    -> true
  Some(_) -> false
}

fn nest_arr(n: Int, inner: JsonValue) : JsonValue =
  if n == 0 { inner } else { nest_arr(n - 1, JArr([inner])) }

fn nest_obj(n: Int, inner: JsonValue) : JsonValue =
  if n == 0 { inner } else { nest_obj(n - 1, JObj([pair("k", inner)])) }

fn repeat_str(s: String, n: Int, acc: String) : String =
  if n == 0 { acc } else { repeat_str(s, n - 1, acc ++ s) }

test "decode literals" {
  assert dec("null") == Some(JNull)
  assert dec("true") == Some(JBool(true))
  assert dec("false") == Some(JBool(false))
}

test "decode rejects malformed literals" {
  assert rejects("nul")
  assert rejects("nulll")
  assert rejects("tru")
  assert rejects("truee")
  assert rejects("fals")
  assert rejects("True")
  assert rejects("NULL")
  assert rejects("undefined")
}

test "decode integers" {
  assert dec("0") == Some(JNum(0))
  assert dec("7") == Some(JNum(7))
  assert dec("123") == Some(JNum(123))
  assert dec("-42") == Some(JNum(0 - 42))
  assert dec("-0") == Some(JNum(0))
  assert dec("9223372036854775807") == Some(JNum(9223372036854775807))
  assert dec("-9223372036854775807") == Some(JNum(0 - 9223372036854775807))
}

test "decode integer limits" {
  assert rejects("9223372036854775808")
  assert rejects("99999999999999999999")
  assert dec("-9223372036854775808") == Some(JNum(0 - 9223372036854775807 - 1))
}

test "decode rejects leading zeros" {
  assert rejects("01")
  assert rejects("00")
  assert rejects("-01")
  assert rejects("[01]")
  assert rejects("1.5e01x")
  assert dec("0.5") == Some(JReal(0.5))
  assert dec("-0.5") == Some(JReal(0.0 - 0.5))
  assert dec("0e0") == Some(JReal(0.0))
  assert dec("[0,1]") == Some(JArr([JNum(0), JNum(1)]))
}

test "decode reals" {
  assert dec("1.5") == Some(JReal(1.5))
  assert dec("-1.5") == Some(JReal(0.0 - 1.5))
  assert dec("1e2") == Some(JReal(100.0))
  assert dec("1E2") == Some(JReal(100.0))
  assert dec("1e+2") == Some(JReal(100.0))
  assert dec("1E+2") == Some(JReal(100.0))
  assert dec("25e-1") == Some(JReal(2.5))
  assert dec("1.25e1") == Some(JReal(12.5))
  assert dec("-1.5e-3") == Some(JReal(0.0 - 0.0015))
  assert dec("0.0") == Some(JReal(0.0))
}

test "decode rejects malformed numbers" {
  assert rejects("-")
  assert rejects("+1")
  assert rejects(".5")
  assert rejects("-.5")
  assert rejects("1.")
  assert rejects("1.e5")
  assert rejects("1e")
  assert rejects("1e+")
  assert rejects("1e-")
  assert rejects("1.5e")
  assert rejects("--1")
  assert rejects("1-")
  assert rejects("0x10")
  assert rejects("1_000")
  assert rejects("NaN")
  assert rejects("Infinity")
  assert rejects("-Infinity")
  assert rejects("1 2")
}

test "decode strings" {
  assert dec("\"\"") == Some(JStr(""))
  assert dec("\"hi\"") == Some(JStr("hi"))
  assert dec("\"a b\"") == Some(JStr("a b"))
  assert dec("\"a\\tb\"") == Some(JStr("a\tb"))
}

test "decode every simple escape" {
  assert dec("\"\\\"\"") == Some(JStr("\""))
  assert dec("\"\\\\\"") == Some(JStr("\\"))
  assert dec("\"\\/\"") == Some(JStr("/"))
  assert dec("\"\\b\"") == Some(JStr("\x08"))
  assert dec("\"\\f\"") == Some(JStr("\x0C"))
  assert dec("\"\\n\"") == Some(JStr("\n"))
  assert dec("\"\\r\"") == Some(JStr("\r"))
  assert dec("\"\\t\"") == Some(JStr("\t"))
}

test "decode rejects invalid escapes" {
  assert rejects("\"\\x\"")
  assert rejects("\"\\a\"")
  assert rejects("\"\\0\"")
  assert rejects("\"\\'\"")
  assert rejects("\"\\U0041\"")
  assert rejects("\"abc\\")
  assert rejects("\"\\")
}

test "decode rejects unterminated and unquoted strings" {
  assert rejects("\"abc")
  assert rejects("\"")
  assert rejects("\"abc\\\"")
  assert rejects("abc")
  assert rejects("'abc'")
}

test "decode unicode escapes across the byte-width boundaries" {
  assert dec("\"\\u0041\"") == Some(JStr("A"))
  assert dec("\"\\u007f\"") == Some(JStr("\x7f"))
  assert dec("\"\\u0080\"") == Some(JStr("\u{80}"))
  assert dec("\"\\u00e9\"") == Some(JStr("é"))
  assert dec("\"\\u00E9\"") == Some(JStr("é"))
  assert dec("\"\\u07ff\"") == Some(JStr("\u{7ff}"))
  assert dec("\"\\u0800\"") == Some(JStr("\u{800}"))
  assert dec("\"\\u20ac\"") == Some(JStr("€"))
  assert dec("\"\\ud7ff\"") == Some(JStr("\u{d7ff}"))
  assert dec("\"\\ue000\"") == Some(JStr("\u{e000}"))
  assert dec("\"\\uffff\"") == Some(JStr("\u{ffff}"))
}

test "decode hex digit boundaries" {
  assert dec("\"\\u000A\"") == Some(JStr("\n"))
  assert dec("\"\\u000a\"") == Some(JStr("\n"))
  assert dec("\"\\u000F\"") == Some(JStr("\x0f"))
  assert dec("\"\\u000f\"") == Some(JStr("\x0f"))
  assert dec("\"\\u0009\"") == Some(JStr("\t"))
  assert dec("\"\\u0030\"") == Some(JStr("0"))
  assert rejects("\"\\u000G\"")
  assert rejects("\"\\u000@\"")
  assert rejects("\"\\u000`\"")
  assert rejects("\"\\u000:\"")
  assert rejects("\"\\u000/\"")
}

test "encode escapes object keys past the depth switch" {
  let v = nest_arr(40, JObj([pair("a\"b", JNum(1)), pair("c\n", JNum(2))]))
  assert enc(v) == repeat_str("[", 40, "") ++ "{\"a\\\"b\":1,\"c\\n\":2}" ++ repeat_str("]", 40, "")
}

test "decode unicode escape of NUL keeps the byte" {
  match dec("\"a\\u0000b\"") {
    Some(JStr(s)) -> {
      assert string_length(s) == 3
      assert string_byte_at_int(s, 0) == 97
      assert string_byte_at_int(s, 1) == 0
      assert string_byte_at_int(s, 2) == 98
    }
    _ -> { assert false }
  }
}

test "decode surrogate pairs" {
  assert dec("\"\\uD83D\\uDE00\"") == Some(JStr("😀"))
  assert dec("\"\\ud83d\\ude00\"") == Some(JStr("😀"))
  assert dec("\"\\uD800\\uDC00\"") == Some(JStr("\u{10000}"))
  assert dec("\"\\uDBFF\\uDFFF\"") == Some(JStr("\u{10ffff}"))
  assert dec("\"x\\uD83D\\uDE00y\"") == Some(JStr("x😀y"))
  assert dec("\"\\uD83D\\uDE00\\uD83D\\uDE01\"") == Some(JStr("😀😁"))
}

test "decode rejects lone and mismatched surrogates" {
  assert rejects("\"\\uD83D\"")
  assert rejects("\"\\uDE00\"")
  assert rejects("\"\\uD83Dx\"")
  assert rejects("\"\\uD83D\\u0041\"")
  assert rejects("\"\\uD83D\\uD83D\"")
  assert rejects("\"\\uD83D\\n\"")
  assert rejects("\"\\uD83D\\uDE0\"")
  assert rejects("\"\\uD83D\\uDE")
  assert rejects("\"\\uDBFF\"")
  assert rejects("\"\\uDC00\"")
  assert rejects("\"\\uDFFF\"")
}

test "decode rejects bad hex digits" {
  assert rejects("\"\\u\"")
  assert rejects("\"\\u0\"")
  assert rejects("\"\\u00\"")
  assert rejects("\"\\u004\"")
  assert rejects("\"\\u00G1\"")
  assert rejects("\"\\u00g1\"")
  assert rejects("\"\\u 041\"")
  assert rejects("\"\\u-041\"")
  assert rejects("\"\\u004")
}

test "decode rejects raw control characters in strings" {
  assert rejects("\"a\nb\"")
  assert rejects("\"a\tb\"")
  assert rejects("\"a\rb\"")
  assert rejects("\"\x01\"")
  assert rejects("\"\x1f\"")
  assert rejects("{\"a\nb\":1}")
  assert dec("\" \"") == Some(JStr(" "))
  assert dec("\"\x7f\"") == Some(JStr("\x7f"))
  assert dec("\"\\n\\t\"") == Some(JStr("\n\t"))
  assert dec("[\n\"a\"\n]") == Some(JArr([JStr("a")]))
}

test "decode keeps raw UTF-8" {
  assert dec("\"héllo\"") == Some(JStr("héllo"))
  assert dec("\"日本語\"") == Some(JStr("日本語"))
  assert dec("\"😀\"") == Some(JStr("😀"))
}

test "decode arrays" {
  assert dec("[]") == Some(JArr([]))
  assert dec("[ ]") == Some(JArr([]))
  assert dec("[1]") == Some(JArr([JNum(1)]))
  assert dec("[1,2,3]") == Some(JArr([JNum(1), JNum(2), JNum(3)]))
  assert dec("[ 1 , 2 ]") == Some(JArr([JNum(1), JNum(2)]))
  assert dec("[null,true,\"a\",1.5,[],{}]")
    == Some(JArr([JNull, JBool(true), JStr("a"), JReal(1.5), JArr([]), JObj([])]))
  assert dec("[[1],[2,[3]]]")
    == Some(JArr([JArr([JNum(1)]), JArr([JNum(2), JArr([JNum(3)])])]))
}

test "decode rejects malformed arrays" {
  assert rejects("[")
  assert rejects("]")
  assert rejects("[1")
  assert rejects("[1,")
  assert rejects("[1,]")
  assert rejects("[,1]")
  assert rejects("[,]")
  assert rejects("[1 2]")
  assert rejects("[1;2]")
  assert rejects("[1}")
  assert rejects("[[1]")
  assert rejects("[1]]")
  assert rejects("[\"a\":1]")
}

test "decode objects" {
  assert dec("{}") == Some(JObj([]))
  assert dec("{ }") == Some(JObj([]))
  assert dec("{\"a\":1}") == Some(JObj([pair("a", JNum(1))]))
  assert dec("{ \"a\" : 1 , \"b\" : 2 }") == Some(JObj([pair("a", JNum(1)), pair("b", JNum(2))]))
  assert dec("{\"b\":1,\"a\":2}") == Some(JObj([pair("b", JNum(1)), pair("a", JNum(2))]))
  assert dec("{\"a\":1,\"a\":2}") == Some(JObj([pair("a", JNum(1)), pair("a", JNum(2))]))
  assert dec("{\"\":null}") == Some(JObj([pair("", JNull)]))
  assert dec("{\"a\\nb\":1}") == Some(JObj([pair("a\nb", JNum(1))]))
  assert dec("{\"a\":{\"b\":[1,{\"c\":null}]}}")
    == Some(JObj([pair("a", JObj([pair("b", JArr([JNum(1), JObj([pair("c", JNull)])]))]))]))
}

test "decode rejects malformed objects" {
  assert rejects("{")
  assert rejects("}")
  assert rejects("{\"a\"")
  assert rejects("{\"a\":")
  assert rejects("{\"a\":1")
  assert rejects("{\"a\":1,")
  assert rejects("{\"a\":1,}")
  assert rejects("{,}")
  assert rejects("{a:1}")
  assert rejects("{1:1}")
  assert rejects("{\"a\"}")
  assert rejects("{\"a\" 1}")
  assert rejects("{\"a\"=1}")
  assert rejects("{\"a\":1 \"b\":2}")
  assert rejects("{\"a\":}")
  assert rejects("{\"a\":1]")
  assert rejects("{\"a\":1}}")
  assert rejects("{'a':1}")
  assert rejects("{\"a\":1,\"b\"}")
  assert rejects("{\"a\":1,2}")
  assert rejects("{\"a\":\"\\x\"}")
}

test "decode whitespace" {
  assert dec(" null") == Some(JNull)
  assert dec("null ") == Some(JNull)
  assert dec(" \t\r\nnull \t\r\n") == Some(JNull)
  assert dec("\t[\n1\r,\t2\n]\r\n") == Some(JArr([JNum(1), JNum(2)]))
  assert dec("{\n\t\"a\"\r:\n1\n}") == Some(JObj([pair("a", JNum(1))]))
  assert rejects("\x0bnull")
  assert rejects("\x0cnull")
  assert rejects("\u{a0}null")
}

test "decode rejects empty input and trailing garbage" {
  assert rejects("")
  assert rejects(" ")
  assert rejects("\n\t")
  assert rejects("null x")
  assert rejects("nullx")
  assert rejects("1 2")
  assert rejects("{} {}")
  assert rejects("[] []")
  assert rejects("\"a\" \"b\"")
  assert rejects("true,")
  assert rejects("1,2")
}

test "decode a deeply nested array without exhausting the stack" {
  let deep = nest_arr(50000, JNull)
  assert enc(dec(enc(deep)) |> option.unwrap_or(JNull)) == enc(deep)
}

test "decode a deeply nested object without exhausting the stack" {
  let deep = nest_obj(50000, JNull)
  assert enc(dec(enc(deep)) |> option.unwrap_or(JNull)) == enc(deep)
}

test "decode rejects unbalanced deep nesting" {
  assert rejects(repeat_str("[", 50000, ""))
  assert rejects(repeat_str("[", 50000, "") ++ repeat_str("]", 49999, ""))
  assert rejects(repeat_str("{\"a\":", 1000, "1"))
}

test "decode a large flat array" {
  let big = repeat_str("1,", 20000, "") ++ "2"
  match dec("[" ++ big ++ "]") {
    Some(JArr(xs)) -> { assert list_length(xs) == 20001 }
    _ -> { assert false }
  }
}

test "decode a long string" {
  let body = repeat_str("ab\\n", 20000, "")
  match dec("\"" ++ body ++ "\"") {
    Some(JStr(s)) -> { assert string_length(s) == 60000 }
    _ -> { assert false }
  }
}

test "encode scalars" {
  assert enc(JNull) == "null"
  assert enc(JBool(true)) == "true"
  assert enc(JBool(false)) == "false"
  assert enc(JNum(0)) == "0"
  assert enc(JNum(42)) == "42"
  assert enc(JNum(0 - 7)) == "-7"
  assert enc(JNum(9223372036854775807)) == "9223372036854775807"
  assert enc(JReal(1.5)) == "1.5"
  assert enc(JReal(0.0 - 2.25)) == "-2.25"
}

test "encode keeps a real a real across a round-trip" {
  assert enc(JReal(1.0)) == "1.0"
  assert enc(JReal(0.0)) == "0.0"
  assert enc(JReal(100000.0)) == "100000.0"
  assert enc(JReal(0.0 - 3.0)) == "-3.0"
  assert enc(JReal(1.5e20)) == "1.5e+20"
  assert dec(enc(JReal(1.0))) == Some(JReal(1.0))
  assert dec(enc(JReal(100000.0))) == Some(JReal(100000.0))
  assert dec(enc(JReal(1.0e22))) == Some(JReal(1.0e22))
  assert dec(enc(JReal(1.5e-7))) == Some(JReal(1.5e-7))
  assert dec(enc(JArr([JReal(2.0), JNum(2)]))) == Some(JArr([JReal(2.0), JNum(2)]))
  assert enc(nest_arr(40, JReal(2.0))) == repeat_str("[", 40, "") ++ "2.0" ++ repeat_str("]", 40, "")
}

test "encode strings escape the required characters" {
  assert enc(JStr("")) == "\"\""
  assert enc(JStr("hi")) == "\"hi\""
  assert enc(JStr("a\"b")) == "\"a\\\"b\""
  assert enc(JStr("a\\b")) == "\"a\\\\b\""
  assert enc(JStr("a\nb")) == "\"a\\nb\""
  assert enc(JStr("a\rb")) == "\"a\\rb\""
  assert enc(JStr("a\tb")) == "\"a\\tb\""
  assert enc(JStr("a/b")) == "\"a/b\""
}

test "encode control characters as lowercase u00XX" {
  assert enc(JStr("\x01")) == "\"\\u0001\""
  assert enc(JStr("\x08")) == "\"\\u0008\""
  assert enc(JStr("\x0c")) == "\"\\u000c\""
  assert enc(JStr("\x0b")) == "\"\\u000b\""
  assert enc(JStr("\x1f")) == "\"\\u001f\""
  assert enc(JStr("\x10")) == "\"\\u0010\""
  assert enc(JStr("\x1a")) == "\"\\u001a\""
  assert enc(JStr("\u{0}")) == "\"\\u0000\""
}

test "encode leaves characters at and above the control boundary verbatim" {
  assert enc(JStr(" ")) == "\"" ++ " " ++ "\""
  assert enc(JStr("\x7f")) == "\"\x7f\""
  assert enc(JStr("é")) == "\"é\""
  assert enc(JStr("日本語")) == "\"日本語\""
  assert enc(JStr("😀")) == "\"😀\""
}

test "encode mixes escaped and verbatim runs" {
  assert enc(JStr("a\"b\\c\nd")) == "\"a\\\"b\\\\c\\nd\""
  assert enc(JStr("\"\"")) == "\"\\\"\\\"\""
  assert enc(JStr("\n\n")) == "\"\\n\\n\""
  assert enc(JStr("xyz\n")) == "\"xyz\\n\""
  assert enc(JStr("\nxyz")) == "\"\\nxyz\""
}

test "encode arrays" {
  assert enc(JArr([])) == "[]"
  assert enc(JArr([JNum(1)])) == "[1]"
  assert enc(JArr([JNum(1), JNum(2), JNum(3)])) == "[1,2,3]"
  assert enc(JArr([JNull, JBool(true), JStr("a"), JArr([]), JObj([])])) == "[null,true,\"a\",[],{}]"
  assert enc(JArr([JArr([JNum(1)]), JArr([JNum(2)])])) == "[[1],[2]]"
}

test "encode objects keep member order and escape keys" {
  assert enc(JObj([])) == "{}"
  assert enc(JObj([pair("a", JNum(1))])) == "{\"a\":1}"
  assert enc(JObj([pair("b", JNum(1)), pair("a", JNum(2))])) == "{\"b\":1,\"a\":2}"
  assert enc(JObj([pair("a", JNum(1)), pair("a", JNum(2))])) == "{\"a\":1,\"a\":2}"
  assert enc(JObj([pair("", JNull)])) == "{\"\":null}"
  assert enc(JObj([pair("a\"b\n", JNull)])) == "{\"a\\\"b\\n\":null}"
  assert enc(JObj([pair("a", JObj([pair("b", JArr([JNum(1), JObj([pair("c", JNull)])]))]))]))
    == "{\"a\":{\"b\":[1,{\"c\":null}]}}"
}

fn deep_text_arr(n: Int) : String = repeat_str("[", n, "") ++ "0" ++ repeat_str("]", n, "")

test "encode agrees on both sides of the depth switch" {
  assert enc(nest_arr(30, JNum(0))) == deep_text_arr(30)
  assert enc(nest_arr(31, JNum(0))) == deep_text_arr(31)
  assert enc(nest_arr(32, JNum(0))) == deep_text_arr(32)
  assert enc(nest_arr(33, JNum(0))) == deep_text_arr(33)
  assert enc(nest_arr(200, JNum(0))) == deep_text_arr(200)
}

test "encode objects and commas past the depth switch" {
  let leaf = JArr([JNum(1), JStr("a\n"), JObj([pair("x", JNull), pair("y", JBool(false))]), JObj([]), JArr([])])
  let want = "[1,\"a\\n\",{\"x\":null,\"y\":false},{},[]]"
  assert enc(nest_arr(40, leaf)) == repeat_str("[", 40, "") ++ want ++ repeat_str("]", 40, "")
  let wrapped = JObj([pair("p", nest_arr(40, leaf)), pair("q", JNum(2))])
  assert enc(wrapped) == "{\"p\":" ++ repeat_str("[", 40, "") ++ want ++ repeat_str("]", 40, "") ++ ",\"q\":2}"
  assert enc(nest_obj(40, JNull)) == repeat_str("{\"k\":", 40, "") ++ "null" ++ repeat_str("}", 40, "")
}

test "encode of a deeply nested value does not exhaust the stack" {
  assert string_length(enc(nest_arr(100000, JNull))) == 200004
}

test "encode then decode round-trips" {
  let v = JObj([
    pair("name", JStr("Eric \"E\"\n\t\\ é 😀 \x01")),
    pair("n", JNum(0 - 12)),
    pair("tags", JArr([JStr("kai"), JStr(""), JNull, JBool(false)])),
    pair("o", JObj([pair("", JArr([])), pair("z", JObj([]))]))
  ])
  assert dec(enc(v)) == Some(v)
  assert enc(dec(enc(v)) |> option.unwrap_or(JNull)) == enc(v)
}

test "get looks up object members" {
  let o = JObj([pair("a", JNum(1)), pair("b", JStr("x")), pair("n", JNull), pair("a", JNum(9))])
  assert json.get(o, "a") == Some(JNum(1))
  assert json.get(o, "b") == Some(JStr("x"))
  assert json.get(o, "missing") == None
  assert json.get(o, "") == None
  assert json.get(JObj([]), "a") == None
}

test "get tells a present null from a missing key" {
  let o = JObj([pair("n", JNull)])
  assert json.get(o, "n") == Some(JNull)
  assert json.get(o, "m") == None
}

test "get on a non-object is none" {
  assert json.get(JNull, "a") == None
  assert json.get(JNum(1), "a") == None
  assert json.get(JStr("a"), "a") == None
  assert json.get(JArr([JNum(1)]), "a") == None
}

test "at indexes array elements" {
  let a = JArr([JNum(10), JNull, JNum(30)])
  assert json.at(a, 0) == Some(JNum(10))
  assert json.at(a, 1) == Some(JNull)
  assert json.at(a, 2) == Some(JNum(30))
  assert json.at(a, 3) == None
  assert json.at(a, 0 - 1) == None
  assert json.at(JArr([]), 0) == None
}

test "at on a non-array is none" {
  assert json.at(JNull, 0) == None
  assert json.at(JNum(1), 0) == None
  assert json.at(JObj([pair("0", JNum(1))]), 0) == None
}

fn b_of(doc: JsonValue, k: String, i: Int) : Option[Int] =
  json.get(doc, k)
    || (x) => json.at(x, i)
    || (x) => json.get(x, "b")
    || (x) => json.as_int(x)

test "drilling chains never fail on a mismatch" {
  let doc = dec("{\"a\":[{\"b\":7}]}") |> option.unwrap_or(JNull)
  assert b_of(doc, "a", 0) == Some(7)
  assert b_of(doc, "a", 5) == None
  assert b_of(doc, "x", 0) == None
}

test "as_string accepts only strings" {
  assert json.as_string(JStr("x")) == Some("x")
  assert json.as_string(JStr("")) == Some("")
  assert json.as_string(JNum(1)) == None
  assert json.as_string(JNull) == None
  assert json.as_string(JBool(true)) == None
  assert json.as_string(JArr([])) == None
  assert json.as_string(JObj([])) == None
}

test "as_int accepts only integers" {
  assert json.as_int(JNum(3)) == Some(3)
  assert json.as_int(JNum(0 - 3)) == Some(0 - 3)
  assert json.as_int(JReal(3.0)) == None
  assert json.as_int(JStr("3")) == None
  assert json.as_int(JNull) == None
  assert json.as_int(JBool(true)) == None
}

test "as_real widens integers" {
  assert json.as_real(JReal(1.5)) == Some(1.5)
  assert json.as_real(JNum(2)) == Some(2.0)
  assert json.as_real(JNum(0 - 2)) == Some(0.0 - 2.0)
  assert json.as_real(JStr("1.5")) == None
  assert json.as_real(JNull) == None
  assert json.as_real(JBool(false)) == None
}

test "as_bool accepts only booleans" {
  assert json.as_bool(JBool(true)) == Some(true)
  assert json.as_bool(JBool(false)) == Some(false)
  assert json.as_bool(JNum(1)) == None
  assert json.as_bool(JNum(0)) == None
  assert json.as_bool(JStr("true")) == None
  assert json.as_bool(JNull) == None
}

test "bind error rendering and paths" {
  let e = JsonError { path: "user.age", expected: "Int", found: "String" }
  assert json_bind.json_error_show(e) == "user.age: expected Int, got String"
  let r = JsonError { path: "", expected: "Object", found: "Array" }
  assert json_bind.json_error_show(r) == "expected Object, got Array"
  assert json_bind.json_path_field("", "a") == "a"
  assert json_bind.json_path_field("a", "b") == "a.b"
  assert json_bind.json_path_index("items", 2) == "items[2]"
  assert json_bind.json_path_index("", 0) == "[0]"
  assert json_bind.json_path_child("") == ""
  assert json_bind.json_path_child("x") == "\x01"
}

test "bind nested result locates a failure under the placeholder" {
  let inner = Err(JsonError { path: "\x01.zip", expected: "String", found: "Number" })
  match json_bind.json_nested_result(inner, "address") {
    Err(e) -> {
      assert e.path == "address.zip"
      assert e.expected == "String"
      assert e.found == "Number"
    }
    Ok(_) -> { assert false }
  }
  let plain = Err(JsonError { path: "z", expected: "String", found: "Number" })
  match json_bind.json_nested_result(plain, "address") {
    Err(e) -> { assert e.path == "z" }
    Ok(_) -> { assert false }
  }
  match json_bind.json_nested_result(Ok(1), "address") {
    Ok(n) -> { assert n == 1 }
    Err(_) -> { assert false }
  }
}

test "bind shape names" {
  assert json_bind.json_shape_name(JNull) == "absent"
  assert json_bind.json_shape_name(JBool(true)) == "Bool"
  assert json_bind.json_shape_name(JNum(1)) == "Number"
  assert json_bind.json_shape_name(JReal(1.0)) == "Number"
  assert json_bind.json_shape_name(JStr("")) == "String"
  assert json_bind.json_shape_name(JArr([])) == "Array"
  assert json_bind.json_shape_name(JObj([])) == "Object"
}

fn err_of[a](r: Result[a, JsonError]) : Option[JsonError] = match r {
  Err(e) -> Some(e)
  Ok(_)  -> None
}

fn is_ok[a](r: Result[a, JsonError]) : Bool = match r {
  Ok(_)  -> true
  Err(_) -> false
}

test "bind object and field" {
  assert is_ok(json_bind.json_bind_object(JObj([]), "p"))
  match err_of(json_bind.json_bind_object(JArr([]), "p")) {
    Some(e) -> {
      assert e.path == "p"
      assert e.expected == "Object"
      assert e.found == "Array"
    }
    None -> { assert false }
  }
  let o = JObj([pair("a", JNum(1)), pair("a", JNum(2))])
  assert json_bind.json_bind_field(o, "a") == JNum(1)
  assert json_bind.json_bind_field(o, "b") == JNull
  assert json_bind.json_bind_field(JNum(1), "a") == JNull
}

test "bind leaf readers" {
  assert json_bind.json_bind_string(JStr("s"), "p") == Ok("s")
  assert json_bind.json_bind_int(JNum(4), "p") == Ok(4)
  assert json_bind.json_bind_real(JReal(1.5), "p") == Ok(1.5)
  assert json_bind.json_bind_real(JNum(2), "p") == Ok(2.0)
  assert json_bind.json_bind_bool(JBool(true), "p") == Ok(true)
}

test "bind leaf readers report expected and found" {
  match err_of(json_bind.json_bind_string(JNum(1), "a.b")) {
    Some(e) -> {
      assert e.path == "a.b"
      assert e.expected == "String"
      assert e.found == "Number"
    }
    None -> { assert false }
  }
  match err_of(json_bind.json_bind_int(JReal(1.0), "p")) {
    Some(e) -> {
      assert e.expected == "Int"
      assert e.found == "Number"
    }
    None -> { assert false }
  }
  match err_of(json_bind.json_bind_real(JStr("x"), "p")) {
    Some(e) -> {
      assert e.expected == "Real"
      assert e.found == "String"
    }
    None -> { assert false }
  }
  match err_of(json_bind.json_bind_bool(JNull, "p")) {
    Some(e) -> {
      assert e.expected == "Bool"
      assert e.found == "absent"
    }
    None -> { assert false }
  }
}

test "bind optional readers" {
  assert json_bind.json_bind_opt_string(JNull, "p") == Ok(None)
  assert json_bind.json_bind_opt_string(JStr("s"), "p") == Ok(Some("s"))
  assert json_bind.json_bind_opt_int(JNull, "p") == Ok(None)
  assert json_bind.json_bind_opt_int(JNum(3), "p") == Ok(Some(3))
  assert json_bind.json_bind_opt_real(JNull, "p") == Ok(None)
  assert json_bind.json_bind_opt_real(JNum(3), "p") == Ok(Some(3.0))
  assert json_bind.json_bind_opt_bool(JNull, "p") == Ok(None)
  assert json_bind.json_bind_opt_bool(JBool(false), "p") == Ok(Some(false))
  assert not is_ok(json_bind.json_bind_opt_string(JNum(1), "p"))
  assert not is_ok(json_bind.json_bind_opt_int(JStr("1"), "p"))
  assert not is_ok(json_bind.json_bind_opt_real(JBool(true), "p"))
  assert not is_ok(json_bind.json_bind_opt_bool(JNum(1), "p"))
}

test "bind lists decode element-wise and locate failures by index" {
  let ints = JArr([JNum(1), JNum(2), JNum(3)])
  assert json_bind.json_bind_list(ints, "xs", json_bind.json_bind_int) == Ok([1, 2, 3])
  assert json_bind.json_bind_list(JArr([]), "xs", json_bind.json_bind_int) == Ok([])
  let bad = JArr([JNum(1), JStr("x"), JNum(3)])
  match err_of(json_bind.json_bind_list(bad, "xs", json_bind.json_bind_int)) {
    Some(e) -> {
      assert e.path == "xs[1]"
      assert e.expected == "Int"
      assert e.found == "String"
    }
    None -> { assert false }
  }
  match err_of(json_bind.json_bind_list(JNum(1), "xs", json_bind.json_bind_int)) {
    Some(e) -> {
      assert e.path == "xs"
      assert e.expected == "Array"
      assert e.found == "Number"
    }
    None -> { assert false }
  }
}

test "bind optional lists and generic optionals" {
  assert json_bind.json_bind_opt_list(JNull, "p", json_bind.json_bind_int) == Ok(None)
  assert json_bind.json_bind_opt_list(JArr([JNum(1)]), "p", json_bind.json_bind_int) == Ok(Some([1]))
  assert not is_ok(json_bind.json_bind_opt_list(JNum(1), "p", json_bind.json_bind_int))
  assert json_bind.json_bind_opt(JNull, "p", json_bind.json_bind_int) == Ok(None)
  assert json_bind.json_bind_opt(JNum(5), "p", json_bind.json_bind_int) == Ok(Some(5))
  assert not is_ok(json_bind.json_bind_opt(JStr("5"), "p", json_bind.json_bind_int))
}

test "bind tagged-sum helpers" {
  let t = json_bind.json_bind_unknown_tag("v", "Zed", "A, B")
  assert t.path == "v.tag"
  assert t.expected == "one of A, B"
  assert t.found == "Zed"
  let arr = JArr([JNum(10), JNum(20)])
  assert json_bind.json_bind_tuple_elem(arr, 0, 2, "v.value") == Ok(JNum(10))
  assert json_bind.json_bind_tuple_elem(arr, 1, 2, "v.value") == Ok(JNum(20))
  match err_of(json_bind.json_bind_tuple_elem(arr, 0, 3, "v.value")) {
    Some(e) -> {
      assert e.path == "v.value"
      assert e.expected == "Array of 3"
      assert e.found == "Array"
    }
    None -> { assert false }
  }
  match err_of(json_bind.json_bind_tuple_elem(JNum(1), 0, 2, "v.value")) {
    Some(e) -> {
      assert e.expected == "Array of 2"
      assert e.found == "Number"
    }
    None -> { assert false }
  }
  match err_of(json_bind.json_bind_tuple_elem(arr, 5, 2, "v.value")) {
    Some(e) -> {
      assert e.path == "v.value[5]"
      assert e.expected == "element"
      assert e.found == "absent"
    }
    None -> { assert false }
  }
}

test "bind encode helpers" {
  assert json_bind.json_of_opt(None, (n: Int) => JNum(n)) == JNull
  assert json_bind.json_of_opt(Some(4), (n: Int) => JNum(n)) == JNum(4)
  assert json_bind.json_of_list([], (n: Int) => JNum(n)) == JArr([])
  assert json_bind.json_of_list([1, 2, 3], (n: Int) => JNum(n)) == JArr([JNum(1), JNum(2), JNum(3)])
}
