import net.url

fn show_opt(o: Option[String]) : String = match o {
  Some(x) -> "<" ++ x ++ ">"
  None    -> "-"
}

fn show_port(o: Option[Int]) : String = match o {
  Some(p) -> int_to_string(p)
  None    -> "-"
}

# scheme userinfo host port path query fragment
fn fields(s: String) : String = match url.parse(s) {
  Err(e) -> "ERR " ++ e
  Ok(u)  -> string.join([show_opt(u.scheme), show_opt(u.userinfo), show_opt(u.host),
                         show_port(u.port), "<" ++ u.path ++ ">", show_opt(u.query),
                         show_opt(u.fragment)], " ")
}

fn round_trip(s: String) : String = match url.parse(s) {
  Err(e) -> "ERR " ++ e
  Ok(u)  -> url.to_string(u)
}

fn resolve_str(base: String, r: String) : String = match url.parse(base) {
  Err(e) -> "BASE " ++ e
  Ok(b)  -> match url.parse(r) {
    Err(e) -> "REF " ++ e
    Ok(x)  -> match url.resolve(b, x) {
      Err(e) -> "ERR " ++ e
      Ok(u)  -> url.to_string(u)
    }
  }
}

fn decoded(s: String) : String = match url.percent_decode(s) {
  Ok(d)  -> d
  Err(e) -> "ERR " ++ e
}

fn same_resolution(base: String, r: String, want: String) : Bool =
  resolve_str(base, r) == want

# ---- parse: structure ---------------------------------------------

test "parse splits every component" {
  assert fields("http://u:p@h:8080/a/b?q=1#f") == "<http> <u:p> <h> 8080 </a/b> <q=1> <f>"
  assert fields("http://h") == "<http> - <h> - <> - -"
  assert fields("http://h/") == "<http> - <h> - </> - -"
  assert fields("http://h?q") == "<http> - <h> - <> <q> -"
  assert fields("http://h#f") == "<http> - <h> - <> - <f>"
  assert fields("http://h/a?b?c#d?e") == "<http> - <h> - </a> <b?c> <d?e>"
}

test "parse distinguishes absent from empty" {
  assert fields("") == "- - - - <> - -"
  assert fields("?") == "- - - - <> <> -"
  assert fields("#") == "- - - - <> - <>"
  assert fields("?#") == "- - - - <> <> <>"
  assert fields("//") == "- - <> - <> - -"
  assert fields("http://@h/") == "<http> <> <h> - </> - -"
  assert fields("http://h:/x") == "<http> - <h> - </x> - -"
  assert fields("file:///etc/hosts") == "<file> - <> - </etc/hosts> - -"
  assert fields("http:") == "<http> - - - <> - -"
}

test "parse reads non-hierarchical and relative references" {
  assert fields("mailto:a@b.c") == "<mailto> - - - <a@b.c> - -"
  assert fields("urn:isbn:0451450523") == "<urn> - - - <isbn:0451450523> - -"
  assert fields("a:b") == "<a> - - - <b> - -"
  assert fields("/a:b") == "- - - - </a:b> - -"
  assert fields("//h/p") == "- - <h> - </p> - -"
  assert fields("../g?y#s") == "- - - - <../g> <y> <s>"
  assert fields("g;x=1") == "- - - - <g;x=1> - -"
  assert fields("a+b-c.d:e") == "<a+b-c.d> - - - <e> - -"
}

test "parse keeps components verbatim" {
  assert fields("HTTP://EXAMPLE.com/%7e%7E") == "<HTTP> - <EXAMPLE.com> - </%7e%7E> - -"
  assert fields("http://h/a/../b/./c") == "<http> - <h> - </a/../b/./c> - -"
  assert fields("http://h/?a=%20&b=c%2Fd") == "<http> - <h> - </> <a=%20&b=c%2Fd> -"
}

test "parse handles ports" {
  assert fields("http://h:0/") == "<http> - <h> 0 </> - -"
  assert fields("http://h:80/") == "<http> - <h> 80 </> - -"
  assert fields("http://h:65535/") == "<http> - <h> 65535 </> - -"
  assert fields("http://h:000080/") == "<http> - <h> 80 </> - -"
  assert fields("http://h:99999/") == "ERR parse: value out of range in port at offset 9"
  assert fields("http://h:65536/") == "ERR parse: value out of range in port at offset 9"
  assert fields("http://h:1234567890/") == "ERR parse: value out of range in port at offset 9"
  assert fields("http://h:12a/") == "ERR parse: invalid character in port at offset 11"
  assert fields("http://h:-1/") == "ERR parse: invalid character in port at offset 9"
  assert fields("http://h:8:9/") == "ERR parse: invalid character in port at offset 10"
}

test "parse handles IP literals" {
  assert fields("http://[::1]/") == "<http> - <[::1]> - </> - -"
  assert fields("http://[::1]:8080/x") == "<http> - <[::1]> 8080 </x> - -"
  assert fields("http://[2001:db8::7]") == "<http> - <[2001:db8::7]> - <> - -"
  assert fields("http://[::ffff:1.2.3.4]/") == "<http> - <[::ffff:1.2.3.4]> - </> - -"
  assert fields("http://[v1.fe80::a]/") == "<http> - <[v1.fe80::a]> - </> - -"
  assert fields("http://[V1.fe80::a]/") == "<http> - <[V1.fe80::a]> - </> - -"
  assert fields("http://[v1.a b]/") == "ERR parse: invalid character in IP literal at offset 12"
  assert fields("http://u@[::1]:1/") == "<http> <u> <[::1]> 1 </> - -"
  assert fields("http://[::1/") == "ERR parse: unterminated IP literal at offset 7"
  assert fields("http://[]/") == "ERR parse: empty IP literal at offset 8"
  assert fields("http://[::1]x/") == "ERR parse: invalid character after IP literal at offset 12"
  assert fields("http://[zz::1]/") == "ERR parse: invalid character in IP literal at offset 8"
  assert fields("http://[abc]/") == "ERR parse: malformed IP literal at offset 8"
  assert fields("http://[v1x]/") == "ERR parse: malformed IP literal at offset 8"
  assert fields("http://[::1]:x/") == "ERR parse: invalid character in port at offset 13"
}

test "parse reports the offset of every malformed component" {
  assert fields(":x") == "ERR parse: empty scheme at offset 0"
  assert fields("1http://x") == "ERR parse: invalid character in scheme at offset 0"
  assert fields("ht tp://x") == "ERR parse: invalid character in scheme at offset 2"
  assert fields("ht_p://x") == "ERR parse: invalid character in scheme at offset 2"
  assert fields("http://ex ample/") == "ERR parse: invalid character in host at offset 9"
  assert fields("http://u@v@h/") == "ERR parse: invalid character in host at offset 10"
  assert fields("http://us er@h/") == "ERR parse: invalid character in userinfo at offset 9"
  assert fields("http://h/a b") == "ERR parse: invalid character in path at offset 10"
  assert fields("http://h/a[0]") == "ERR parse: invalid character in path at offset 10"
  assert fields("a?b c") == "ERR parse: invalid character in query at offset 3"
  assert fields("a#b#c") == "ERR parse: invalid character in fragment at offset 3"
  assert fields("a#b c") == "ERR parse: invalid character in fragment at offset 3"
  assert fields("a?b[") == "ERR parse: invalid character in query at offset 3"
}

test "parse validates percent escapes per component" {
  assert fields("http://h/%zz") == "ERR parse: bad percent escape in path at offset 9"
  assert fields("http://h/a%4") == "ERR parse: bad percent escape in path at offset 10"
  assert fields("http://h/a%") == "ERR parse: bad percent escape in path at offset 10"
  assert fields("a?%g0") == "ERR parse: bad percent escape in query at offset 2"
  assert fields("a#%") == "ERR parse: bad percent escape in fragment at offset 2"
  assert fields("http://h%/") == "ERR parse: bad percent escape in host at offset 8"
  assert fields("http://u%x@h/") == "ERR parse: bad percent escape in userinfo at offset 8"
  assert fields("http://h/%41%7a%7A") == "<http> - <h> - </%41%7a%7A> - -"
}

test "parse rejects non-ASCII bytes with a byte offset" {
  assert fields("http://h/é") == "ERR parse: invalid character in path at offset 9"
  assert fields("http://hé/") == "ERR parse: invalid character in host at offset 8"
  assert fields("a?é") == "ERR parse: invalid character in query at offset 2"
}

test "parse accepts every unreserved and sub-delim character in a path" {
  assert fields("/abcXYZ019-._~!$&'()*+,;=:@") == "- - - - </abcXYZ019-._~!$&'()*+,;=:@> - -"
  assert fields("/\\") == "ERR parse: invalid character in path at offset 1"
  assert fields("/\"") == "ERR parse: invalid character in path at offset 1"
  assert fields("/<") == "ERR parse: invalid character in path at offset 1"
  assert fields("/^") == "ERR parse: invalid character in path at offset 1"
  assert fields("/{") == "ERR parse: invalid character in path at offset 1"
  assert fields("/|") == "ERR parse: invalid character in path at offset 1"
}

# ---- to_string ----------------------------------------------------

test "to_string round-trips accepted input" {
  let cases = [
    "http://u:p@h:8080/a/b?q=1#f", "http://h", "http://h/", "http://h?q", "http://h#f",
    "", "?", "#", "?#", "//", "//h", "//h/p", "file:///etc/hosts", "http:", "mailto:a@b.c",
    "urn:isbn:0451450523", "a:b", "/a:b", "../g?y#s", "HTTP://EXAMPLE.com/%7e",
    "http://[::1]:8080/x", "http://[v1.fe80::a]/", "http://@h/", "http://u@h/",
    "http://h/a?b?c#d?e", "g;x=1/../y", "foo://info.example.com?fred",
    "ftp://ftp.is.co.za/rfc/rfc1808.txt", "ldap://[2001:db8::7]/c=GB?objectClass?one",
    "tel:+1-816-555-1212", "telnet://192.0.2.16:80/", "news:comp.infosystems.www.servers.unix"
  ]
  assert list.all(cases, (c) => round_trip(c) == c)
}

test "to_string drops an empty port and nothing else" {
  assert round_trip("http://h:/x") == "http://h/x"
  assert round_trip("http://h:80/x") == "http://h:80/x"
  assert round_trip("http://h:000080/x") == "http://h:80/x"
}

test "to_string prints a hand-built Url" {
  let u = Url { scheme: Some("https"), userinfo: Some("me"), host: Some("example.org"),
                port: Some(8443), path: "/p", query: Some("a=b"), fragment: Some("top") }
  assert url.to_string(u) == "https://me@example.org:8443/p?a=b#top"
  let rel = Url { scheme: None, userinfo: None, host: None, port: None,
                  path: "x/y", query: Some(""), fragment: Some("") }
  assert url.to_string(rel) == "x/y?#"
  let bare = Url { scheme: None, userinfo: None, host: Some(""), port: None,
                   path: "", query: None, fragment: None }
  assert url.to_string(bare) == "//"
}

# ---- resolve: RFC 3986 section 5.4 --------------------------------

test "resolve passes the normal examples of RFC 3986 5.4.1" {
  let base = "http://a/b/c/d;p?q"
  assert resolve_str(base, "g:h") == "g:h"
  assert resolve_str(base, "g") == "http://a/b/c/g"
  assert resolve_str(base, "./g") == "http://a/b/c/g"
  assert resolve_str(base, "g/") == "http://a/b/c/g/"
  assert resolve_str(base, "/g") == "http://a/g"
  assert resolve_str(base, "//g") == "http://g"
  assert resolve_str(base, "?y") == "http://a/b/c/d;p?y"
  assert resolve_str(base, "g?y") == "http://a/b/c/g?y"
  assert resolve_str(base, "#s") == "http://a/b/c/d;p?q#s"
  assert resolve_str(base, "g#s") == "http://a/b/c/g#s"
  assert resolve_str(base, "g?y#s") == "http://a/b/c/g?y#s"
  assert resolve_str(base, ";x") == "http://a/b/c/;x"
  assert resolve_str(base, "g;x") == "http://a/b/c/g;x"
  assert resolve_str(base, "g;x?y#s") == "http://a/b/c/g;x?y#s"
  assert resolve_str(base, "") == "http://a/b/c/d;p?q"
  assert resolve_str(base, ".") == "http://a/b/c/"
  assert resolve_str(base, "./") == "http://a/b/c/"
  assert resolve_str(base, "..") == "http://a/b/"
  assert resolve_str(base, "../") == "http://a/b/"
  assert resolve_str(base, "../g") == "http://a/b/g"
  assert resolve_str(base, "../..") == "http://a/"
  assert resolve_str(base, "../../") == "http://a/"
  assert resolve_str(base, "../../g") == "http://a/g"
}

test "resolve passes the abnormal examples of RFC 3986 5.4.2" {
  let base = "http://a/b/c/d;p?q"
  assert resolve_str(base, "../../../g") == "http://a/g"
  assert resolve_str(base, "../../../../g") == "http://a/g"
  assert resolve_str(base, "/./g") == "http://a/g"
  assert resolve_str(base, "/../g") == "http://a/g"
  assert resolve_str(base, "g.") == "http://a/b/c/g."
  assert resolve_str(base, ".g") == "http://a/b/c/.g"
  assert resolve_str(base, "g..") == "http://a/b/c/g.."
  assert resolve_str(base, "..g") == "http://a/b/c/..g"
  assert resolve_str(base, "./../g") == "http://a/b/g"
  assert resolve_str(base, "./g/.") == "http://a/b/c/g/"
  assert resolve_str(base, "g/./h") == "http://a/b/c/g/h"
  assert resolve_str(base, "g/../h") == "http://a/b/c/h"
  assert resolve_str(base, "g;x=1/./y") == "http://a/b/c/g;x=1/y"
  assert resolve_str(base, "g;x=1/../y") == "http://a/b/c/y"
  assert resolve_str(base, "g?y/./x") == "http://a/b/c/g?y/./x"
  assert resolve_str(base, "g?y/../x") == "http://a/b/c/g?y/../x"
  assert resolve_str(base, "g#s/./x") == "http://a/b/c/g#s/./x"
  assert resolve_str(base, "g#s/../x") == "http://a/b/c/g#s/../x"
  assert resolve_str(base, "http:g") == "http:g"
}

test "resolve handles bases without a path or without an authority" {
  assert resolve_str("http://a", "g") == "http://a/g"
  assert resolve_str("http://a", "../g") == "http://a/g"
  assert resolve_str("http://a", "?y") == "http://a?y"
  assert resolve_str("http://a", "") == "http://a"
  assert resolve_str("foo:bar/baz", "q") == "foo:bar/q"
  assert resolve_str("foo:bar", "q") == "foo:q"
  assert resolve_str("mailto:x", "?y") == "mailto:x?y"
}

test "resolve distinguishes an empty query or fragment from an absent one" {
  assert resolve_str("http://a/b?q#f", "?") == "http://a/b?"
  assert resolve_str("http://a/b?q#f", "#") == "http://a/b?q#"
  assert resolve_str("http://a/b?q#f", "") == "http://a/b?q"
  assert resolve_str("http://a/b?q#f", "c") == "http://a/c"
  assert resolve_str("http://a/b?q#f", "c#") == "http://a/c#"
}

test "resolve normalises dots in references that carry their own authority" {
  assert resolve_str("http://a/b", "//g/x/./y/../z") == "http://g/x/z"
  assert resolve_str("http://a/b", "https://h/a/../b/./c") == "https://h/b/c"
  assert resolve_str("http://a/b", "https://h?q") == "https://h?q"
  assert resolve_str("http://a/b", "//u@h:1/p") == "http://u@h:1/p"
}

test "resolve removes dot segments from references that keep their own path" {
  let base = "http://a/b/c/d;p?q"
  assert resolve_str(base, "g:../h") == "g:h"
  assert resolve_str(base, "g:./h") == "g:h"
  assert resolve_str(base, "g:../../h") == "g:h"
  assert resolve_str(base, "g:.") == "g:"
  assert resolve_str(base, "g:..") == "g:"
  assert resolve_str(base, "g:/a/./b/../c") == "g:/a/c"
  assert resolve_str(base, "g:/a/b/.") == "g:/a/b/"
  assert resolve_str(base, "g:/a/b/..") == "g:/a/"
  assert resolve_str(base, "g:/a/..") == "g:/"
  assert resolve_str(base, "g:/..") == "g:/"
  assert resolve_str(base, "g:a/b/c/../../d") == "g:a/d"
  assert resolve_str(base, "g:a//b/../c") == "g:a//c"
}

test "resolve refuses a relative base" {
  assert resolve_str("a/b", "c") == "ERR resolve: base has no scheme"
  assert resolve_str("//h/p", "c") == "ERR resolve: base has no scheme"
  assert resolve_str("a/b", "http://x/y") == "ERR resolve: base has no scheme"
}

# ---- percent-coding -----------------------------------------------

test "percent_encode keeps only unreserved bytes" {
  assert url.percent_encode("") == ""
  assert url.percent_encode("abcXYZ019-._~") == "abcXYZ019-._~"
  assert url.percent_encode(" ") == "%20"
  assert url.percent_encode("a b/é") == "a%20b%2F%C3%A9"
  assert url.percent_encode("%") == "%25"
  assert url.percent_encode("!#$&'()*+,/:;=?@[]") == "%21%23%24%26%27%28%29%2A%2B%2C%2F%3A%3B%3D%3F%40%5B%5D"
  assert url.percent_encode("\n\t") == "%0A%09"
  assert url.percent_encode("😀") == "%F0%9F%98%80"
  assert url.percent_encode("日本") == "%E6%97%A5%E6%9C%AC"
  assert url.percent_encode(int_to_byte_string(255)) == "%FF"
  assert url.percent_encode(int_to_byte_string(127)) == "%7F"
  assert url.percent_encode("@AZ[`az{") == "%40AZ%5B%60az%7B"
  assert url.percent_encode("/09:") == "%2F09%3A"
  assert url.percent_encode(",-.") == "%2C-."
  assert url.percent_encode("^_`") == "%5E_%60"
  assert url.percent_encode("}~") == "%7D~"
}

test "percent_decode accepts both hex cases and leaves the rest" {
  assert decoded("") == ""
  assert decoded("plain") == "plain"
  assert decoded("%41") == "A"
  assert decoded("%41%42%43") == "ABC"
  assert decoded("%c3%A9") == "é"
  assert decoded("%C3%a9") == "é"
  assert decoded("a+b") == "a+b"
  assert decoded("a%20b") == "a b"
  assert decoded("x%2Fy%2fz") == "x/y/z"
  assert decoded("%F0%9F%98%80") == "😀"
  assert decoded("é%41é") == "éAé"
  assert decoded("%25") == "%"
  assert decoded("%2541") == "%41"
  assert decoded("%0a") == "\n"
  assert decoded("%FF") == int_to_byte_string(255)
  assert decoded("%7e%7E") == "~~"
  assert decoded("%af%AF") == int_to_byte_string(175) ++ int_to_byte_string(175)
}

test "percent_decode reports the offset of a bad escape" {
  assert decoded("%") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%2") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("ab%") == "ERR percent_decode: bad escape at offset 2"
  assert decoded("ab%4") == "ERR percent_decode: bad escape at offset 2"
  assert decoded("%zz") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("a%4g") == "ERR percent_decode: bad escape at offset 1"
  assert decoded("a%g4") == "ERR percent_decode: bad escape at offset 1"
  assert decoded("%%41") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%41%") == "ERR percent_decode: bad escape at offset 3"
  assert decoded("é%x") == "ERR percent_decode: bad escape at offset 2"
}

test "percent_decode treats only 0-9 A-F a-f as hex digits" {
  assert decoded("%3:") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%:3") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%/0") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%@0") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%G0") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%W0") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%[0") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%_0") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%`0") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%g0") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%0g") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%0/") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%0:") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%0@") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%0`") == "ERR percent_decode: bad escape at offset 0"
  assert decoded("%09%0a%0A%0f%0F") == "\t\n\n" ++ int_to_byte_string(15) ++ int_to_byte_string(15)
  assert fields("a?%3:") == "ERR parse: bad percent escape in query at offset 2"
  assert fields("a?%`0") == "ERR parse: bad percent escape in query at offset 2"
}

test "percent_decode inverts percent_encode" {
  let cases = ["", "a", "a b", "a b/é", "100%", "😀 + 日本", "~._-", "a=b&c=d", "\n\t\r"]
  assert list.all(cases, (c) => decoded(url.percent_encode(c)) == c)
}

# ---- query strings ------------------------------------------------

test "query_pairs splits and decodes" {
  assert url.query_pairs("") == []
  assert url.query_pairs("a=1") == [("a", "1")]
  assert url.query_pairs("a=1&b=2") == [("a", "1"), ("b", "2")]
  assert url.query_pairs("a") == [("a", "")]
  assert url.query_pairs("a=") == [("a", "")]
  assert url.query_pairs("=v") == [("", "v")]
  assert url.query_pairs("a=1&&b") == [("a", "1"), ("b", "")]
  assert url.query_pairs("&") == []
  assert url.query_pairs("a=b=c") == [("a", "b=c")]
  assert url.query_pairs("k%20x=v%26w") == [("k x", "v&w")]
  assert url.query_pairs("a+b=c+d") == [("a+b", "c+d")]
  assert url.query_pairs("ü=%C3%BC") == [("ü", "ü")]
  assert url.query_pairs("a=1&a=2") == [("a", "1"), ("a", "2")]
}

test "query_pairs keeps a malformed component verbatim" {
  assert url.query_pairs("a=%zz") == [("a", "%zz")]
  assert url.query_pairs("%zz=1&b=%41") == [("%zz", "1"), ("b", "A")]
  assert url.query_pairs("a=%4") == [("a", "%4")]
}

test "query_string encodes and joins" {
  assert url.query_string([]) == ""
  assert url.query_string([("a", "1")]) == "a=1"
  assert url.query_string([("a b", "c&d"), ("e", "")]) == "a%20b=c%26d&e="
  assert url.query_string([("a", "1"), ("a", "2")]) == "a=1&a=2"
  assert url.query_string([("=", "=")]) == "%3D=%3D"
  assert url.query_string([("é", "😀")]) == "%C3%A9=%F0%9F%98%80"
}

test "query_string inverts query_pairs" {
  let cases = [[("a", "1"), ("b", "2")], [("k x", "v&w=z")], [("é", "😀"), ("", "")], [("a", "%41")]]
  assert list.all(cases, (c) => url.query_pairs(url.query_string(c)) == c)
}
