# kai 0.119 generates printable ASCII for Char/String. Map generated Int
# lists through a palette to also exercise UTF-8 widths, case exceptions,
# whitespace, and scalar boundaries. Checks return Bool for shrinking.
fn pick_char(pool: [Char], n: Int) : Char {
  let size = list.length(pool)
  let index = (n % size + size) % size
  match list.nth(pool, index) {
    Some(c) -> c
    None -> panic("nonempty property palette")
  }
}

fn text_char(n: Int) : Char = pick_char(
  [
    '\u{0}', ' ', '\t', '\r', '\n', 'A', 'z', '0', '_',
    '\u{7f}', '\u{80}', '\u{a0}', '\u{e9}', '\u{df}', '\u{130}', '\u{131}', '\u{138}', '\u{149}',
    '\u{141}', '\u{142}', '\u{178}', '\u{ff}', '\u{17f}', '\u{3a3}', '\u{3c2}', '\u{3c3}',
    '\u{401}', '\u{44f}',
    '\u{7ff}', '\u{800}', '\u{2003}', '\u{d7ff}', '\u{e000}',
    '\u{ffff}', '\u{10000}', '\u{1f600}', '\u{10ffff}'
  ],
  n
)

fn upper_pair(n: Int) : Char = pick_char(string.chars("AZÀÞĀĲŁŊŹŸΣЁЯ"), n)

fn lower_pair(n: Int) : Char = pick_char(string.chars("azàþāĳłŋźÿσёя"), n)

check "ASCII classification agrees with independent character sets" with n: Int, high: Bool {
  let base = (n % 64 + 64) % 64
  let c = int_to_char(if high { base + 64 } else { base })
  let s = string.from_chars([c])
  char.is_digit(c) == string_contains("0123456789", s)
    and char.is_lower(c) == string_contains("abcdefghijklmnopqrstuvwxyz", s)
    and char.is_upper(c) == string_contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", s)
    and char.is_alpha(c)
      == string_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", s)
    and char.is_alnum(c)
      == string_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789", s)
    and char.is_space(c) == string_contains(" \t", s)
}

check "ASCII case normalization is idempotent and stable under opposite folding" with c: Char {
  let lower = char.to_lower(c)
  let upper = char.to_upper(c)
  char.to_lower(lower) == lower
    and char.to_upper(upper) == upper
    and char.to_lower(upper) == lower
    and char.to_upper(lower) == upper
}

check "Unicode case normalization is idempotent and classifies changed results" with n: Int {
  let c = text_char(n)
  let lower = char_unicode.to_lower(c)
  let upper = char_unicode.to_upper(c)
  char_unicode.to_lower(lower) == lower
    and char_unicode.to_upper(upper) == upper
    and (not (char_unicode.is_lower(c) and char_unicode.is_upper(c)))
    and (lower == c or char_unicode.is_lower(lower))
    and (upper == c or char_unicode.is_upper(upper))
}

check "generated sequences of reference Unicode pairs fold to their partners" with ns: [Int] {
  let upper = string.from_chars(list.map(ns, upper_pair))
  let lower = string.from_chars(list.map(ns, lower_pair))
  string.to_lower_unicode(upper) == lower and string.to_upper_unicode(lower) == upper
}

check "UTF-8 construction preserves generated codepoints and round-trips bytes" with ns: [Int] {
  let cs = list.map(ns, text_char)
  let s = string.from_chars(cs)
  string.chars(s) == cs
    and string.char_count(s) == list.length(cs)
    and string.from_bytes(string.bytes(s)) == s
}

check "string reversal follows the codepoint-list model and is an involution" with ns: [Int] {
  let cs = list.map(ns, text_char)
  let s = string.from_chars(cs)
  string.chars(string.reverse(s)) == list.reverse(cs)
    and string.reverse(string.reverse(s)) == s
}

check "codepoint slices agree with drop and take for generated bounds" with ns: [Int], start: Int, count: Int {
  let cs = list.map(ns, text_char)
  let s = string.from_chars(cs)
  let safe_start = if start < 0 { 0 } else { start }
  let safe_count = if count < 0 { 0 } else { count }
  string.slice(s, start, count)
    == string.from_chars(list.take(list.drop(cs, safe_start), safe_count))
}

check "byte boundary snapping brackets offsets and is idempotent" with ns: [Int], offset: Int {
  let s = string.from_chars(list.map(ns, text_char))
  let size = string.byte_length(s) + 1
  let off = (offset % size + size) % size
  let floor = string.floor_char_boundary(s, off)
  let ceil = string.ceil_char_boundary(s, off)
  floor <= off
    and off <= ceil
    and string.is_char_boundary(s, floor)
    and string.is_char_boundary(s, ceil)
    and string.floor_char_boundary(s, floor) == floor
    and string.ceil_char_boundary(s, ceil) == ceil
    and string.byte_slice(s, 0, floor) != None
    and string.byte_slice(s, ceil, string.byte_length(s) - ceil) != None
}

check "trim is idempotent and ignores added ASCII whitespace at both ends" with ns: [Int] {
  let s = string.from_chars(list.map(ns, text_char))
  let trimmed = string.trim(s)
  string.trim(trimmed) == trimmed
    and string.trim(string.concat(" \t\r\n", string.concat(s, "\n\r\t "))) == trimmed
    and string.trim_left(string.trim_left(s)) == string.trim_left(s)
    and string.trim_right(string.trim_right(s)) == string.trim_right(s)
}

check "concatenation adds lengths and preserves removable prefixes and suffixes" with left: [Int], right: [Int] {
  let a = string.from_chars(list.map(left, text_char))
  let b = string.from_chars(list.map(right, text_char))
  let joined = string.concat(a, b)
  string.byte_length(joined) == string.byte_length(a) + string.byte_length(b)
    and string.char_count(joined) == string.char_count(a) + string.char_count(b)
    and string.drop_prefix(joined, a) == Some(b)
    and string.drop_suffix(joined, b) == Some(a)
}

check "ASCII string casing follows character casing without changing codepoint count" with ns: [Int] {
  let cs = list.map(ns, text_char)
  let s = string.from_chars(cs)
  string.to_lower(s) == string.from_chars(list.map(cs, char.to_lower))
    and string.to_upper(s) == string.from_chars(list.map(cs, char.to_upper))
    and string.char_count(string.to_lower(s)) == list.length(cs)
    and string.char_count(string.to_upper(s)) == list.length(cs)
}

check "Unicode string casing follows character casing and is idempotent" with ns: [Int] {
  let cs = list.map(ns, text_char)
  let s = string.from_chars(cs)
  let lower = string.to_lower_unicode(s)
  let upper = string.to_upper_unicode(s)
  lower == string.from_chars(list.map(cs, char_unicode.to_lower))
    and upper == string.from_chars(list.map(cs, char_unicode.to_upper))
    and string.to_lower_unicode(lower) == lower
    and string.to_upper_unicode(upper) == upper
    and string.char_count(lower) == list.length(cs)
    and string.char_count(upper) == list.length(cs)
}
