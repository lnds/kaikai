import crypto.legacy
import encoding.base64
import encoding.hex

fn ascii_loop(s: String, i: Int, acc: [Int]) : [Int] =
  if i >= string.length(s) { list_reverse(acc) }
  else { match char_at(s, i) {
    None    -> list_reverse(acc)
    Some(c) -> ascii_loop(s, i + 1, [char_to_int(c), ...acc])
  } }

fn ascii(s: String) : [Int] = ascii_loop(s, 0, [])

fn repeat_loop(b: Int, n: Int, acc: [Int]) : [Int] =
  if n == 0 { acc } else { repeat_loop(b, n - 1, [b, ...acc]) }

fn repeat_byte(b: Int, n: Int) : [Int] = repeat_loop(b, n, [])

fn count_up(i: Int, n: Int, acc_rev: [Int]) : [Int] =
  if i >= n { list_reverse(acc_rev) } else { count_up(i + 1, n, [i, ...acc_rev]) }

fn sha1_hex(bs: [Int]) : String = hex.encode(legacy.sha1(bs))
fn md5_hex(bs: [Int]) : String = hex.encode(legacy.md5(bs))

test "md5 RFC 1321 appendix A.5 suite" {
  assert md5_hex(ascii("")) == "d41d8cd98f00b204e9800998ecf8427e"
  assert md5_hex(ascii("a")) == "0cc175b9c0f1b6a831c399e269772661"
  assert md5_hex(ascii("abc")) == "900150983cd24fb0d6963f7d28e17f72"
  assert md5_hex(ascii("message digest")) == "f96b697d7cb7938d525a2f31aaf161d0"
  assert md5_hex(ascii("abcdefghijklmnopqrstuvwxyz")) == "c3fcd3d76192e4007dfb496cca67e13b"
  assert md5_hex(ascii("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789")) == "d174ab98d277d9f5a5611c2c9f419d9f"
  assert md5_hex(ascii("12345678901234567890123456789012345678901234567890123456789012345678901234567890")) == "57edf4a22be3c955ac49da2e2107b67a"
}

test "sha1 RFC 3174 vectors" {
  assert sha1_hex(ascii("abc")) == "a9993e364706816aba3e25717850c26c9cd0d89d"
  assert sha1_hex(ascii("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")) == "84983e441c3bd26ebaae4aa1f95129e5e54670f1"
}

test "multi-block input of several KB" {
  assert sha1_hex(repeat_byte(97, 4000)) == "38e4f3c0c14b64b1e112b7f4dc370fd962ad31de"
  assert md5_hex(repeat_byte(97, 4000)) == "26f660b6b2f6e012af97444eefeb0c07"
}

test "empty input" {
  assert sha1_hex([]) == "da39a3ee5e6b4b0d3255bfef95601890afd80709"
  assert md5_hex([]) == "d41d8cd98f00b204e9800998ecf8427e"
}

test "digest lengths" {
  assert list_length(legacy.sha1([])) == 20
  assert list_length(legacy.md5([])) == 16
  assert list_length(legacy.sha1(repeat_byte(255, 300))) == 20
  assert list_length(legacy.md5(repeat_byte(255, 300))) == 16
}

test "padding boundaries around the 55/56/64 byte block edges" {
  assert sha1_hex(repeat_byte(97, 55)) == "c1c8bbdc22796e28c0e15163d20899b65621d65a"
  assert md5_hex(repeat_byte(97, 55)) == "ef1772b6dff9a122358552954ad0df65"
  assert sha1_hex(repeat_byte(97, 56)) == "c2db330f6083854c99d4b5bfb6e8f29f201be699"
  assert md5_hex(repeat_byte(97, 56)) == "3b0c8ac703f828b04c6c197006d17218"
  assert sha1_hex(repeat_byte(97, 63)) == "03f09f5b158a7a8cdad920bddc29b81c18a551f5"
  assert md5_hex(repeat_byte(97, 63)) == "b06521f39153d618550606be297466d5"
  assert sha1_hex(repeat_byte(97, 64)) == "0098ba824b5c16427bd7a1122a5a442a25ec644d"
  assert md5_hex(repeat_byte(97, 64)) == "014842d480b571495a4a0363793f7367"
  assert sha1_hex(repeat_byte(97, 65)) == "11655326c708d70319be2610e8a57d9a5b959d3b"
  assert md5_hex(repeat_byte(97, 65)) == "c743a45e0d2e6a95cb859adae0248435"
  assert sha1_hex(repeat_byte(97, 119)) == "ee971065aaa017e0632a8ca6c77bb3bf8b1dfc56"
  assert md5_hex(repeat_byte(97, 119)) == "8a7bd0732ed6a28ce75f6dabc90e1613"
  assert sha1_hex(repeat_byte(97, 120)) == "f34c1488385346a55709ba056ddd08280dd4c6d6"
  assert md5_hex(repeat_byte(97, 120)) == "5f61c0ccad4cac44c75ff505e1f1e537"
  assert sha1_hex(repeat_byte(97, 128)) == "ad5b3fdbcb526778c2839d2f151ea753995e26a0"
  assert md5_hex(repeat_byte(97, 128)) == "e510683b3f5ffe4093d021808bc6ff70"
  assert sha1_hex(repeat_byte(97, 200)) == "e61cfffe0d9195a525fc6cf06ca2d77119c24a40"
  assert md5_hex(repeat_byte(97, 200)) == "887f30b43b2867f4a9accceee7d16e6c"
}

test "every byte value and zero bytes" {
  assert sha1_hex(count_up(0, 256, [])) == "4916d6bdb7f78e6803698cab32d1586ea457dfc8"
  assert md5_hex(count_up(0, 256, [])) == "e2c865db4162bed963bfaa9ef6ac18f0"
  assert sha1_hex(repeat_byte(0, 64)) == "c8d7d0ef0eedfa82d2ea1aa592845b9a6d4b02b7"
  assert md5_hex(repeat_byte(0, 64)) == "3b5d3c7d207e37dceeedd301e35e2e58"
}

test "multibyte UTF-8 input as bytes" {
  let bs = [97, 195, 169, 226, 130, 172, 240, 159, 152, 128]
  assert sha1_hex(bs) == "c34fe9a321b8b68578a5071df16b21bfe90eb017"
  assert md5_hex(bs) == "46ba30e027faf1efae749d8202717200"
}

test "digests differ per input" {
  assert legacy.sha1(ascii("abc")) != legacy.sha1(ascii("abd"))
  assert legacy.md5(ascii("abc")) != legacy.md5(ascii("abd"))
}

test "RFC 6455 section 1.3 websocket accept key" {
  let key = "dGhlIHNhbXBsZSBub25jZQ=="
  let guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
  assert base64.encode(legacy.sha1(ascii(key ++ guid))) == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
}
