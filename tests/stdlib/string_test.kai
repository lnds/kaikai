test "empty strings retain the identity of each view" {
  assert string.length("") == 0
  assert string.byte_length("") == 0
  assert string.char_count("") == 0
  assert string.is_empty("")
  assert not string.is_empty(" ")
  assert string.chars("") == []
  assert string.bytes("") == []
  assert string.char_indices("") == []
  assert string.from_chars([]) == ""
  assert string.from_bytes([]) == ""
}

test "UTF-8 views have independent byte and codepoint oracles" {
  let s = "aé€😀"
  assert string.length(s) == 10
  assert string.byte_length(s) == 10
  assert string.char_count(s) == 4
  assert string.chars(s) == ['a', '\u{e9}', '\u{20ac}', '\u{1f600}']
  assert string.bytes(s) == [97u8, 195u8, 169u8, 226u8, 130u8, 172u8, 240u8, 159u8, 152u8, 128u8]
  assert string.from_chars(['\u{e9}', '\u{20ac}', '\u{1f600}']) == "é€😀"
  assert string.from_bytes([195u8, 169u8]) == "é"
  assert string.char_indices(s)
    == [
      string.CharIndex { off: 0, cp: 'a' },
      string.CharIndex { off: 1, cp: '\u{e9}' },
      string.CharIndex { off: 3, cp: '\u{20ac}' },
      string.CharIndex { off: 6, cp: '\u{1f600}' }
    ]
}

test "UTF-8 encoding changes width at the exact scalar boundaries" {
  assert string.bytes(string.from_chars([int_to_char(0x7F)])) == [127u8]
  assert string.bytes(string.from_chars([int_to_char(0x80)])) == [194u8, 128u8]
  assert string.bytes(string.from_chars([int_to_char(0x7FF)])) == [223u8, 191u8]
  assert string.bytes(string.from_chars([int_to_char(0x800)])) == [224u8, 160u8, 128u8]
  assert string.bytes(string.from_chars([int_to_char(0xFFFF)])) == [239u8, 191u8, 191u8]
  assert string.bytes(string.from_chars([int_to_char(0x10000)])) == [240u8, 144u8, 128u8, 128u8]
  assert string.bytes(string.from_chars([int_to_char(0x10FFFF)])) == [244u8, 143u8, 191u8, 191u8]
  assert string.chars(string.from_bytes([194u8, 128u8])) == [int_to_char(0x80)]
  assert string.chars(string.from_bytes([224u8, 160u8, 128u8])) == [int_to_char(0x800)]
  assert string.chars(string.from_bytes([240u8, 144u8, 128u8, 128u8])) == [int_to_char(0x10000)]
}

test "raw bytes are preserved and continuation classification has exact bounds" {
  let raw = string.from_bytes([0u8, 127u8, 128u8, 191u8, 192u8, 255u8])
  assert string.bytes(raw) == [0u8, 127u8, 128u8, 191u8, 192u8, 255u8]
  assert string.byte_length(raw) == 6
  assert string.is_char_boundary(raw, 0)
  assert string.is_char_boundary(raw, 1)
  assert not string.is_char_boundary(raw, 2)
  assert not string.is_char_boundary(raw, 3)
  assert string.is_char_boundary(raw, 4)
  assert string.is_char_boundary(raw, 5)
  assert string.is_char_boundary(raw, 6)
  let continuation = string.from_bytes([128u8, 97u8])
  assert string.floor_char_boundary(continuation, 0) == 0
  assert string.ceil_char_boundary(continuation, 0) == 0
}

test "substring indexing and clamping are in codepoints" {
  assert string.slice("café", 2, 2) == "fé"
  assert string.slice("aé€😀z", 1, 3) == "é€😀"
  assert string.slice("aé€😀z", 4, 99) == "z"
  assert string.slice("aé€😀z", -2, 2) == "aé"
  assert string.slice("aé€😀z", 5, 1) == ""
  assert string.slice("aé€😀z", 99, 1) == ""
  assert string.slice("aé€😀z", 1, -1) == ""
  assert string.slice("aé€😀z", 1, 0) == ""
  assert string.slice("", 0, 1) == ""
}

fn check_boundaries(i: Int, floors: [Int], ceils: [Int]) : Unit = match floors {
  [] -> {
    assert ceils == []
  }
  [lo, ...ls] -> match ceils {
    [] -> {
      assert false
    }
    [hi, ...hs] -> {
      assert string.floor_char_boundary("aé€😀", i) == lo
      assert string.ceil_char_boundary("aé€😀", i) == hi
      assert string.is_char_boundary("aé€😀", i) == (lo == hi)
      check_boundaries(i + 1, ls, hs)
    }
  }
}

test "every byte offset across UTF-8 widths has the right boundaries" {
  check_boundaries(0, [0, 1, 1, 3, 3, 3, 6, 6, 6, 6, 10], [0, 1, 3, 3, 6, 6, 6, 10, 10, 10, 10])
  assert not string.is_char_boundary("aé€😀", -1)
  assert not string.is_char_boundary("aé€😀", 11)
  assert string.floor_char_boundary("aé€😀", -1) == 0
  assert string.ceil_char_boundary("aé€😀", -1) == 0
  assert string.floor_char_boundary("aé€😀", 11) == 10
  assert string.ceil_char_boundary("aé€😀", 11) == 10
  assert string.is_char_boundary("", 0)
  assert string.floor_char_boundary("", 3) == 0
  assert string.ceil_char_boundary("", 3) == 0
}

test "byte slices reject invalid endpoints and preserve empty boundary slices" {
  assert string.byte_slice("aé€😀", 1, 9) == Some("é€😀")
  assert string.byte_slice("aé€😀", 2, 1) == None
  assert string.byte_slice("aé€😀", 1, 1) == None
  assert string.byte_slice("aé€😀", -1, 1) == None
  assert string.byte_slice("aé€😀", 10, 1) == None
  assert string.byte_slice("aé€😀", 11, 0) == None
  assert string.byte_slice("aé€😀", 0, -1) == None
  assert string.byte_slice("aé€😀", 10, 0) == Some("")
  assert string.byte_slice("aé€😀", 2, 0) == None
  assert string.byte_slice("", 0, 0) == Some("")
}

test "prefix and suffix removal distinguish missing from empty" {
  assert string.starts_with("éclair", "é")
  assert not string.starts_with("é", "éclair")
  assert string.ends_with("café", "fé")
  assert not string.ends_with("fé", "café")
  assert string.starts_with("", "")
  assert string.ends_with("", "")
  assert string.drop_prefix("éclair", "é") == Some("clair")
  assert string.drop_suffix("café", "fé") == Some("ca")
  assert string.drop_prefix("é", "é") == Some("")
  assert string.drop_suffix("é", "é") == Some("")
  assert string.drop_prefix("é", "") == Some("é")
  assert string.drop_suffix("é", "") == Some("é")
  assert string.drop_prefix("é", "x") == None
  assert string.drop_suffix("é", "x") == None
}

test "search results distinguish byte offsets from codepoint indices" {
  assert string.index_of("é€😀é", "😀") == Some(5)
  assert string.char_index_of("é€😀é", "😀") == Some(2)
  assert string.index_of("é€😀é", "é") == Some(0)
  assert string.char_index_of("é€😀é", "é") == Some(0)
  assert string.index_of("é", "éé") == None
  assert string.char_index_of("é", "x") == None
  assert string.index_of("", "") == Some(0)
  assert string.char_index_of("", "") == Some(0)
}

test "trimming preserves internal whitespace and non-ASCII spaces" {
  assert string.trim(" \t\ré x\n ") == "é x"
  assert string.trim_left(" \té \n") == "é \n"
  assert string.trim_right(" \té \n") == " \té"
  assert string.trim(" é ") == " é "
  assert string.trim("\t\r\n ") == ""
  assert string.trim_left("") == ""
  assert string.trim_right("") == ""
  assert string.is_blank("\r\n\t ")
  assert string.is_blank("")
  assert not string.is_blank(" ")
  assert not string.is_blank(" \té")
}

test "each whitespace kind is trimmed independently on each side" {
  assert string.trim_left(" é") == "é"
  assert string.trim_left("\té") == "é"
  assert string.trim_left("\né") == "é"
  assert string.trim_left("\ré") == "é"
  assert string.trim_right("é ") == "é"
  assert string.trim_right("é\t") == "é"
  assert string.trim_right("é\n") == "é"
  assert string.trim_right("é\r") == "é"
  assert string.is_blank("\r")
  assert string.is_blank("\n")
  assert string.is_blank("\t")
  assert string.is_blank(" ")
}

test "split replace and lines preserve separators and trailing empties by contract" {
  assert string.split("é::😀::", "::") == ["é", "😀", ""]
  assert string.split("::é", "::") == ["", "é"]
  assert string.split("é", "x") == ["é"]
  assert string.replace("é-é-é", "é", "😀") == "😀-😀-😀"
  assert string.replace("é", "", "x") == "é"
  assert string.replace("aaaa", "aa", "b") == "bb"
  assert string.lines("a\n\n") == ["a", ""]
  assert string.lines("\n") == [""]
  assert string.lines("") == []
}

test "construction and numeric conversion honour empty and invalid inputs" {
  assert string.concat("é", "😀") == "é😀"
  assert string.join(["é", "", "😀"], "|") == "é||😀"
  assert string.join([], "|") == ""
  assert string.repeat("é", 3) == "ééé"
  assert string.repeat("é", -1) == ""
  assert string.pad_left("é", 4, '0') == "00é"
  assert string.pad_right("é", 4, '0') == "é00"
  assert string.pad_left("é", 1, '0') == "é"
  assert string.pad_right("é", 2, '0') == "é"
  assert string.to_int("-42") == Some(-42)
  assert string.to_int("42x") == None
  assert string.to_int("") == None
}

test "reversal and ASCII case conversion preserve multibyte characters" {
  assert string.reverse("aé€😀") == "😀€éa"
  assert string.reverse("") == ""
  assert string.reverse("é") == "é"
  assert string.to_upper("aéß😀z") == "Aéß😀Z"
  assert string.to_lower("AÉΣ😀Z") == "aÉΣ😀z"
  assert string.to_upper("") == ""
  assert string.to_lower("") == ""
}

test "Unicode string case conversion composes corrected character mappings" {
  assert string.to_lower_unicode("ŁİŸΣЁ") == "łiÿσё"
  assert string.to_upper_unicode("łıſÿςё") == "ŁISŸΣЁ"
  assert string.to_upper_unicode("ßĸŉ😀") == "ßĸŉ😀"
  assert string.to_lower_unicode("") == ""
  assert string.to_upper_unicode("") == ""
}
