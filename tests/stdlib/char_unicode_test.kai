fn check_pairs(uppers: [Char], lowers: [Char]) : Unit = match uppers {
  [] -> {
    assert lowers == []
  }
  [u, ...us] -> match lowers {
    [] -> {
      assert false
    }
    [l, ...ls] -> {
      assert char_unicode.is_upper(u)
      assert not char_unicode.is_lower(u)
      assert char_unicode.is_lower(l)
      assert not char_unicode.is_upper(l)
      assert char_unicode.to_lower(u) == l
      assert char_unicode.to_upper(l) == u
      assert char_unicode.to_upper(u) == u
      assert char_unicode.to_lower(l) == l
      check_pairs(us, ls)
    }
  }
}

test "every regular pair in the supported ASCII Latin-1 Greek and Cyrillic ranges" {
  check_pairs(
    string.chars("ABCDEFGHIJKLMNOPQRSTUVWXYZ"),
    string.chars("abcdefghijklmnopqrstuvwxyz")
  )
  check_pairs(
    string.chars("ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝÞ"),
    string.chars("àáâãäåæçèéêëìíîïðñòóôõöøùúûüýþ")
  )
  check_pairs(
    string.chars("ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩ"),
    string.chars("αβγδεζηθικλμνξοπρστυφχψω")
  )
  check_pairs(
    string.chars("ЀЁЂЃЄЅІЇЈЉЊЋЌЍЎЏ"),
    string.chars("ѐёђѓєѕіїјљњћќѝўџ")
  )
  check_pairs(
    string.chars("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"),
    string.chars("абвгдежзийклмнопрстуфхцчшщъыьэюя")
  )
}

test "Latin Extended-A switches pair parity and covers its final letters" {
  check_pairs(
    string.chars(
      "ĀĂĄĆĈĊČĎĐĒĔĖĘĚĜĞĠĢĤĦĨĪĬĮĲĴĶĹĻĽĿŁŃŅŇŊŌŎŐŒŔŖŘŚŜŞŠŢŤŦŨŪŬŮŰŲŴŶŹŻŽ"
    ),
    string.chars(
      "āăąćĉċčďđēĕėęěĝğġģĥħĩīĭįĳĵķĺļľŀłńņňŋōŏőœŕŗřśŝşšţťŧũūŭůűųŵŷźżž"
    )
  )
}

test "Latin Extended-A simple mappings do not invent neighbouring letters" {
  assert char_unicode.to_lower('\u{130}') == 'i'
  assert char_unicode.to_upper('\u{131}') == 'I'
  assert char_unicode.to_upper('\u{138}') == '\u{138}'
  assert char_unicode.to_lower('\u{138}') == '\u{138}'
  assert char_unicode.to_upper('\u{149}') == '\u{149}'
  assert char_unicode.to_lower('\u{149}') == '\u{149}'
  assert char_unicode.to_upper('\u{17f}') == 'S'
  assert char_unicode.to_lower('\u{17f}') == '\u{17f}'
  assert char_unicode.is_upper('\u{130}')
  assert not char_unicode.is_lower('\u{130}')
  assert char_unicode.is_lower('\u{131}')
  assert char_unicode.is_lower('\u{138}')
  assert not char_unicode.is_upper('\u{138}')
  assert char_unicode.is_lower('\u{149}')
  assert char_unicode.is_lower('\u{17f}')
}

test "y diaeresis crosses the Latin-1 and Extended-A blocks" {
  check_pairs(['\u{178}'], ['\u{ff}'])
}

test "sharp s and final sigma have asymmetric case mappings" {
  assert char_unicode.is_lower('\u{df}')
  assert not char_unicode.is_upper('\u{df}')
  assert char_unicode.to_upper('\u{df}') == '\u{df}'
  assert char_unicode.to_lower('\u{df}') == '\u{df}'
  assert char_unicode.is_lower('\u{3c2}')
  assert not char_unicode.is_upper('\u{3c2}')
  assert char_unicode.to_upper('\u{3c2}') == '\u{3a3}'
  assert char_unicode.to_lower('\u{3a3}') == '\u{3c3}'
  assert char_unicode.to_lower('\u{3c2}') == '\u{3c2}'
}

fn check_unchanged(cs: [Char]) : Unit = match cs {
  [] -> ()
  [c, ...rest] -> {
    assert not char_unicode.is_lower(c)
    assert not char_unicode.is_upper(c)
    assert char_unicode.to_lower(c) == c
    assert char_unicode.to_upper(c) == c
    check_unchanged(rest)
  }
}

test "range neighbours symbols unassigned Greek and other scripts pass through" {
  check_unchanged([
    '@',
    '[',
    '`',
    '{',
    '\u{d7}',
    '\u{f7}',
    '\u{4e2d}',
    '\u{1f600}',
    int_to_char(0xBF),
    int_to_char(0x390),
    int_to_char(0x3A2),
    int_to_char(0x3AA),
    int_to_char(0x3B0),
    int_to_char(0x3CA),
    int_to_char(0x3FF),
    int_to_char(0x460)
  ])
}
