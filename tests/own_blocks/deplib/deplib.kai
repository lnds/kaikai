import leaf

pub fn two() : Int = leaf.one() + leaf.one()

test "deplib: two" {
  assert two() == 2
}

bench "deplib: two" {
  two()
}

check "deplib: two" with n: Int {
  n + two() == two() + n
}

pub protocol DepSeq[s: Shape] : Functorial {
  map(xs: s[Int], f: (Int) -> Int) : s[Int]
  foldl(xs: s[Int], init: Int, f: (Int, Int) -> Int) : Int
}

pub type Stack[a] = Bottom | Push(a, Stack[a])

impl DepSeq for Stack {
  fn map(xs: Stack[Int], f: (Int) -> Int) : Stack[Int] = match xs {
    Bottom     -> Bottom
    Push(h, t) -> Push(f(h), map(t, f))
  }
  fn foldl(xs: Stack[Int], init: Int, f: (Int, Int) -> Int) : Int = match xs {
    Bottom     -> init
    Push(h, t) -> foldl(t, f(init, h), f)
  }
}
