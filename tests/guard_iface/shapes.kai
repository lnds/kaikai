import math.real

pub type Shape = Circle(Int) | Square(Int)

pub type Point = { x: Int, y: Int }

pub effect Log {
  log(s: String) : Unit
}

pub protocol Area {
  area(x: Self) : Int
}

impl Area for Shape {
  fn area(s: Shape) : Int = match s {
    Circle(r) -> 3 * r * r
    Square(a) -> a * a
  }
}

#[derive(Eq)]
pub type Tag = Red | Blue

pub const LIMIT : Int = 10

unit cm

pub fn grow(p: Point) : Point = Point { x: p.x + 1, y: p.y }

pub fn note(s: String) : Unit / Log = Log.log(s)

pub fn first[a](xs: [a]) : Option[a] = match xs {
  [h, ..._] -> Some(h)
  [] -> None
}

pub fn safe_div(a: Int, b: Int) : Int
  requires b != 0
{
  a / b
}

pub fn label(t: Tag) : String = match t {
  Red -> "red"
  Blue -> "blue"
}

pub fn half_turn() : Real = real.real_pi
