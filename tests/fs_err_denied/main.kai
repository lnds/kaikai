import fs.dir
import fs.file
import os.process

fn sh(script: String) : Unit / Process {
  match process.wait(process.start("sh", ["-c", script])) {
    _ -> ()
  }
}

fn payload() : Array[Byte] = match int_to_byte(1) {
  Ok(b) -> array.from([b])
  Err(m) -> panic(m)
}

fn show[t](label: String, r: Result[t, String]) : Unit / Stdout = match r {
  Ok(_) -> Stdout.print("#{label}: ok")
  Err(e) -> Stdout.print("#{label}: #{e}")
}

fn main() : Int / Stdout + File + Process {
  let root = "/tmp/kai-fs-err-denied"
  sh("rm -rf #{root} && mkdir -p #{root}/locked && touch #{root}/unreadable.txt && chmod 000 #{root}/locked #{root}/unreadable.txt")
  let locked = "#{root}/locked"
  let unreadable = "#{root}/unreadable.txt"

  show("read", file.read(unreadable))
  show("open_read", File.open_read(unreadable))
  show("open_write", File.open_write(unreadable))
  show("read_bytes", file.read_bytes(unreadable))
  show("write_bytes", file.write_bytes(unreadable, payload()))
  show("list_entries", dir.list_entries(locked))

  sh("chmod 755 #{locked} && chmod 644 #{unreadable} && rm -rf #{root}")
  0
}
