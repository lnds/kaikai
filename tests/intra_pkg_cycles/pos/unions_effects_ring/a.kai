import b
import c

pub type AErr = AFail(Int) | AIdle
pub type AnyErr = AErr | BErr | CErr

pub effect ALog {
  note_a(n: Int) : Unit
}

pub fn fa(n: Int) : Int / ALog + BLog + CLog = {
  ALog.note_a(n)
  if n <= 0 { 0 } else { 1 + fb(n - 1) }
}

pub fn describe(e: AnyErr) : Int = match e {
  x : AErr -> match x { AFail(k) -> k  AIdle -> 0 }
  x : BErr -> match x { BFail(k) -> 10 + k  BIdle -> 10 }
  x : CErr -> match x { CFail(k) -> 20 + k  CIdle -> 20 }
}
