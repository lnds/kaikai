import tree

pub type Forest = Kids(KList)
pub type KList = Nil | Cons(Tree, KList)

pub fn count_forest(f: Forest) : Int = match f { Kids(l) -> count_list(l) }
fn count_list(l: KList) : Int = match l { Nil -> 0  Cons(t, r) -> count(t) + count_list(r) }

pub fn leaf_count(t: Tree) : Int = match t { Node(_, Kids(Nil)) -> 1  Node(_, f) -> count_forest(f) }
pub fn mk(n: Int) : Tree = Node(n, Kids(Nil))
