type P = P(Int, [Int])

fn keep(xs: [P], acc: [P]) : [P] = match xs {
  [] -> acc
  [c, ...rest] -> keep(rest, if heavy(c) { acc } else { [c, ...acc] })
}

fn heavy(p: P) : Bool = match p {
  P(k, _) -> k % 3 == 0
}

fn build(n: Int, acc: [P]) : [P] = if n == 0 { acc } else { build(n - 1, [P(n, [n]), ...acc]) }

fn rounds(i: Int, total: Int) : Int =
  if i == 0 { total } else { rounds(i - 1, total + list_length(keep(build(20000, []), []))) }

fn main() : Unit / Stdout = Stdout.print("#{rounds(300, 0)}")
