# Allocation-heavy TRMC workload: every round rebuilds a 50K-cell user
# variant, converts it to a list and filters it, so the run is dominated by
# the allocator's per-cell path rather than by arithmetic.

type Lst = LNil | LCons(Int, Lst)

fn mk(n : Int, acc : Lst) : Lst =
  if n == 0 { acc } else { mk(n - 1, LCons(n, acc)) }

fn mapv(l : Lst) : Lst =
  match l {
    LNil -> LNil
    LCons(h, t) -> LCons(h + 1, mapv(t))
  }

fn tolist(l : Lst) : [Int] =
  match l {
    LNil -> []
    LCons(h, t) -> [h, ...tolist(t)]
  }

fn keep_even(xs : [Int]) : [Int] =
  match xs {
    [] -> []
    [h, ...t] -> if h % 2 == 0 { [h, ...keep_even(t)] } else { keep_even(t) }
  }

fn sum(xs : [Int], a : Int) : Int =
  match xs {
    [] -> a
    [h, ...t] -> sum(t, a + h)
  }

fn rounds(l : Lst, k : Int, acc : Int) : Int =
  if k == 0 { acc } else { rounds(l, k - 1, acc + sum(keep_even(tolist(mapv(l))), 0)) }

fn main() : Unit {
  let l = mk(50000, LNil)
  exit(rounds(l, 80, 0) % 256)
}
